fn short a:int b:int -> int { a b + }

fn apply callback:fn[int -> int] value:int -> int { value callback exec }

fn make_compiler_with_tables
    store:SymbolStore
    ops:List[Op]
    function:Option[Function]
    string_table:List[str]
    constants_table:List[str]
-> BytecodeCompiler {
    "body" print
}
