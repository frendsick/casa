import "../../lib/std.casa" as std
pub enum Payload[T] { Empty Single ( i64 ) Pair(i64 str) Nested (std::Option[std::List[T]]) }
enum Shape {
# Payload variants.
Circle (i64) # Radius.
Rectangle(i64 i64)
Point
}
fn radius shape:Shape -> i64 {
shape match Shape::Circle (value) => value Shape::Rectangle(width height) => {width height +} Shape::Point => 0 end
}
1 Shape::Circle = shape
if shape Shape::Circle (value) is then value drop fi
