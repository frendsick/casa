import "std"

# Decode one scalar without replacing malformed input.
pub fn decode value:i64 -> i64 { value }

# Related notes stay together.
# This type stores a scalar.
struct Scalar {
    # Preserve the scalar value.
    value: i64
}

# Scalar methods.
impl Scalar {
    # Return the stored value.
    fn get self:Scalar -> i64 { self.value }
}

# Scalar variants.
enum Kind {
    Scalar
    Empty
}

# Scalar interface.
trait Readable {
    # Return the scalar value.
    fn get self:self -> i64
}

# Native input.
extern fn read -> i64

# Read the value.
fn run {
    # Set the initial value.
    1 = value # Keep this trailing comment.

    # Print the value.
    value print
}
