fn read value:Option[i64] -> i64 {
    if value Option::Some(number) is else
        0 return
    fi
    number
}

fn total values:$List[Option[i64]] -> i64 {
    0 = sum
    for value in values.iter do
        if value Option::Some(number) is else
            continue
        fi # skip missing values
        number copy += sum
    done
    sum
}

fn pair left:Option[i64] right:Option[i64] -> i64 {
    if
        left Option::Some(first) is
        right Option::Some(second) is &&
    else
        # both values are required
        0 return
    fi
    first second +
}

fn nested flag:bool value:Option[i64] -> i64 {
    if flag then
        if value Option::Some(number) is else
            1 return
        fi
        number return
    fi
    0
}
