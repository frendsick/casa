fn fits pair:Pair -> i64 {
    pair match
        Pair {
            left: first_xxxxxxxxxxxxxxxxxxxxxxxxxx right: second_yyyyyyyyyyyyyyyyyyyyyyyyy
        } => {
            first_xxxxxxxxxxxxxxxxxxxxxxxxxx
        }
    end
}

fn too_wide pair:Pair -> i64 {
    pair match
        Pair {
            left: first_xxxxxxxxxxxxxxxxxxxxxxxxxx right: second_yyyyyyyyyyyyyyyyyyyyyyyyyz
        } => {
            first_xxxxxxxxxxxxxxxxxxxxxxxxxx
        }
    end
}

fn expression_body pair:Pair -> i64 {
    pair match
        Pair {
            left: left
        } => left
        Pair {
            left: first_xxxxxxxxxxxxxxxxxxxxxxxxxx right: second_yyyyyyyyyyyyyyyyyyyyyyyyy
        } => first_xxxxxxxxxxxxxxxxxxxxxxxxxx
    end
}

fn nested_arm value:Wrapper -> i64 {
    value match
        Wrapper::Item(item) => item match
            Item {
                value: value
            } => value
        end
    end
}

fn commented pair:Pair -> i64 {
    pair match
        Pair {
            # The left side.
            left: left
        } => left
    end
}

fn struct_literal_body item:Item -> Pair {
    item match
        Item::A => Pair {
            left: 1 right: 2
        }
        Item::B => Pair {
            left: first_xxxxxxxxxxxxxxxxxxxxxxxxxx right: second_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
        }
        Item::C => {
            Pair { left: 3 right: 3 }
        }
        _ => Pair { left: 0 right: 0 }
    end
}
