pub inline fn twice value:i64 -> i64
{
value 2 *
}
inline unsafe fn read address:ptr -> u8 { unsafe { address load8 } }
unsafe inline fn alternate value:i64 -> i64 { value }
struct Counter { value:i64 }
impl Counter {
pub inline fn get self:$Counter -> i64 { self.value }
}
trait Number {
fn number self:$self -> i64
inline fn increment self:$self -> i64 { self.number 1 + }
}
inline fn operation_with_a_long_name_and_several_arguments first_argument:i64 second_argument:i64 third_argument:i64 -> i64 { first_argument second_argument + third_argument + }
