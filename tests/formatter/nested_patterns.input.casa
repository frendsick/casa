fn read value:Option[Result[i64 i64]] -> i64 { value match Option::Some(Result::Ok(number)) | Option::Some(Result::Error(number)) if number 0 > => number Option::Some(_) | Option::None => 0 end }
if value Option::Some(Pair{left: Result::Ok(number) right: _}) is then number print fi
fn bitwise left:i64 right:i64 -> i64 { true match true => left right | false => 0 end }
fn literal_bitwise flags:i64 -> i64 { true match true => { flags 1 | } false => 0 end }
