import "../../lib/std.casa" as std

pub struct Access {
    pub x:     i64
    long_name: std::Option[i64]
}

pub fn make_public_value
    first_parameter:i64
    second_parameter:i64
    third_parameter:i64
    fourth_parameter:i64
    fifth_parameter:i64
-> i64 {
    first_parameter
}

impl Access {
    pub fn get self:$Access -> i64 { self.x }
}
# SAFETY: The caller provides one readable byte at `address`.
pub unsafe fn read_byte address:ptr -> u8 {
    unsafe { address load8 }
}
