import "std"
import "../../compiler/products.casa" as products
import "../../compiler/lexer.casa" as lexer
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

fn analyze code:str -> products::AnalysisSnapshot {
    "" lexer::absolute_normalize_path = base
    code.to_str "raylib_test.casa".to_str products::SourceUnit
    base swap products::CompilationInput::new = input
    "lib".to_str input.library_paths.push
    input products::analyze.unwrap
}

fn rejects code:str message:str {
    code analyze = result
    result.get_report.get_diagnostics message message helpers::assert_error_contains
}

fn test_resource_contracts {
    "raylib_resource_contracts" test::test_start
    "import \"raylib\" fn close_early window:raylib::Window { window.split = drawing = context window drop context.should_close drop drawing drop }"
    "Cannot move owner `window` while it is borrowed" swap rejects
    "import \"raylib\" fn close_texture window:raylib::Window image:raylib::Image { window.split = drawing = context context image raylib::Texture::new = texture window drop texture drop drawing drop }"
    "Cannot move owner `window` while it is borrowed" swap rejects
    "import \"raylib\" fn overlap drawing:mut$raylib::Drawing texture:$raylib::Texture { texture drawing.begin = first texture drawing.begin = second first drop second drop }"
    "Cannot borrow `drawing` exclusively while it is borrowed" swap rejects
    "import \"raylib\" fn unload_early drawing:mut$raylib::Drawing texture:raylib::Texture { texture drawing.begin = frame texture drop frame drop }"
    "Cannot move owner `texture` while it is borrowed" swap rejects
    "import \"raylib\" unsafe { raylib::CloseWindow }"
    "private" swap rejects
    "import \"raylib\" raylib::Image { } drop"
    "private" swap rejects
    "import \"raylib\" true raylib::Context drop"
    "private" swap rejects
    "import \"raylib\" false raylib::Drawing drop"
    "private" swap rejects
    "import \"raylib\" fn read texture:$raylib::Texture { texture.native drop }"
    "private" swap rejects
}
test_resource_contracts
test::test_summary
