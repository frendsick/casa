import "std" as std
import "../../lib/test.casa" as test
import "../../lib/os.casa" as os
import "helpers.casa" as helpers

pub const TEXT_HEAP_PROBE_SIZE 497
pub const TEXT_STRESS_ITERATIONS 100
pub const TEXT_TEST_PATH "/tmp/casa_owned_text_reclamation.txt"
pub const BORROWED_OPTION_HEAP_PROBE_SIZE 16
pub const OWNED_STORAGE_HEAP_PROBE_SIZE 613
pub const OWNED_STORAGE_STRESS_ITERATIONS 20
pub const OWNED_STORAGE_WARMUP_ITERATIONS 3

pub struct Tracked {
    pub drops: ptr
}

pub struct EmptyShell {
}

pub struct CopyShell {
    pub value: i64
}

pub struct TrackedShell {
    pub value: Tracked
}

pub struct NestedText {
    pub value: std::String
}

pub struct BorrowShell[T] {
    pub value: $T
}

pub enum CopyChoice {
    Value (i64)
}

pub enum TrackedChoice {
    Value (Tracked)
}

pub enum NestedTextChoice {
    Value (NestedText)
}

impl Tracked {
    pub fn new drops:ptr -> Tracked { drops Tracked }

    pub fn drop self:mut$Tracked {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

pub fn reset drops:ptr {
    unsafe { 0 drops store64 }
}

pub fn count drops:ptr -> i64 {
    unsafe { drops load64 (i64) }
}

pub fn test_list_reclaims_owned_elements {
    "list_reclaims_owned_elements" test::test_start
    unsafe { 8 alloc = drops }
    drops reset

    std::List[Tracked]::new = items
    0 (u64) = index
    while index 20 > do
        drops Tracked::new items.push
        1 += index
    done
    "growth keeps elements live" 0 drops count test::assert_eq

    5 items.remove.unwrap drop
    "remove transfers one owner" 1 drops count test::assert_eq
    drops Tracked::new 0 items.set
    "set destroys the replaced owner" 2 drops count test::assert_eq
    items drop
    "list destruction releases every owner" 21 drops count test::assert_eq

    unsafe { drops free }
}

pub fn test_map_reclaims_owned_values {
    "map_reclaims_owned_values" test::test_start
    unsafe { 8 alloc = drops }
    drops reset

    std::Map[i64 Tracked]::new = entries
    0 = key
    while key 20 > do
        drops Tracked::new key entries.set
        1 += key
    done
    "resize keeps values live" 0 drops count test::assert_eq

    drops Tracked::new 3 entries.set
    "replacement destroys the old value" 1 drops count test::assert_eq
    4 entries.remove.unwrap drop
    "remove transfers one owner" 2 drops count test::assert_eq
    entries drop
    "map destruction releases every owner" 21 drops count test::assert_eq

    unsafe { drops free }
}

pub fn test_static_aggregate_shells_reuse_storage {
    "static_aggregate_shells_reuse_storage" test::test_start

    EmptyShell = first_empty
    unsafe { first_empty (ptr) } = first_empty_address
    first_empty drop
    EmptyShell = second_empty
    unsafe { second_empty (ptr) } = second_empty_address
    "empty struct shell" first_empty_address second_empty_address == test::assert_true

    1 CopyShell = first_struct
    unsafe { first_struct (ptr) } = first_struct_address
    first_struct drop
    2 CopyShell = second_struct
    unsafe { second_struct (ptr) } = second_struct_address
    "Copy-only struct shell" first_struct_address second_struct_address == test::assert_true

    1 CopyChoice::Value = first_enum
    unsafe { first_enum (ptr) } = first_enum_address
    first_enum drop
    2 CopyChoice::Value = second_enum
    unsafe { second_enum (ptr) } = second_enum_address
    "Copy-only enum shell" first_enum_address second_enum_address == test::assert_true

    [1, 2, 3] = first_array
    unsafe { first_array (ptr) } = first_array_address
    first_array drop
    [4, 5, 6] = second_array
    unsafe { second_array (ptr) } = second_array_address
    "Copy-only array shell" first_array_address second_array_address == test::assert_true
}

pub fn test_aggregate_payloads_drop_once {
    "aggregate_payloads_drop_once" test::test_start
    unsafe { 8 alloc = drops }
    drops reset

    drops Tracked::new TrackedShell drop
    drops Tracked::new TrackedChoice::Value drop
    drops Tracked::new = first
    drops Tracked::new = second
    [first, second] drop
    "struct, enum, and array payloads" 4 drops count test::assert_eq

    unsafe { drops free }
}

pub fn discard_borrow_shell [T] shell:BorrowShell[T] { shell drop }

pub fn test_generic_borrow_shell_needs_no_drop_hook {
    "generic_borrow_shell_needs_no_drop_hook" test::test_start
    42 = owner
    owner BorrowShell discard_borrow_shell
    "borrow remains live" 42 owner test::assert_eq
}

pub fn test_failed_metadata_lookup_reclaims_buffer {
    "failed_metadata_lookup_reclaims_buffer" test::test_start
    unsafe { 144 alloc = available_buffer }
    unsafe { available_buffer free }
    "/tmp/casa_missing_metadata_buffer_file" file::stat drop
    unsafe { 144 alloc = reused_buffer }
    "early return releases stat buffer" available_buffer reused_buffer == test::assert_true
    unsafe { reused_buffer free }
}

pub fn exercise_cstr_temporary {
    if "a\0b".as_cstr.is_none then
        return
    fi
}

pub fn exercise_lambda_temporary {
    { "lambda".as_cstr.is_none } exec drop
}

pub fn compare_borrowed_strings first:$std::String second:$std::String -> bool {
    first.as_str second.as_str ==
}

pub fn borrowed_string_length value:$std::String -> u64 { value.as_str.length }

pub fn exercise_owned_storage_reclamation {
    "nested".to_str NestedText NestedTextChoice::Value drop
    "comparison".to_str "comparison" == drop
    "borrow chain"
        .to_str
        .as_str
        .length drop
    "right".to_str "left".to_str compare_borrowed_strings drop
    "exec".to_str &borrowed_string_length exec drop

    std::List[std::String]::new = values
    "collection".to_str values.push
    values drop

    "closure".to_str = captured
    move { captured.as_str.length } exec drop
    exercise_lambda_temporary

    std::List[std::String]::new = command
    "/bin/true".to_str command.push
    command std::run_command drop
}

pub fn test_owned_storage_stays_bounded {
    "owned_storage_stays_bounded" test::test_start

    unsafe { BORROWED_OPTION_HEAP_PROBE_SIZE alloc = available_option }
    unsafe { available_option free }
    exercise_cstr_temporary
    unsafe { BORROWED_OPTION_HEAP_PROBE_SIZE alloc = reused_option }
    "borrowed Option temporary is reclaimed" available_option reused_option == test::assert_true
    unsafe { reused_option free }

    0 (u64) = warmup_iteration
    while warmup_iteration OWNED_STORAGE_WARMUP_ITERATIONS > do
        exercise_owned_storage_reclamation
        1 += warmup_iteration
    done
    unsafe { OWNED_STORAGE_HEAP_PROBE_SIZE alloc = first_marker }
    0 (u64) = iteration
    while iteration OWNED_STORAGE_STRESS_ITERATIONS > do
        exercise_owned_storage_reclamation
        1 += iteration
    done
    unsafe { OWNED_STORAGE_HEAP_PROBE_SIZE alloc = second_marker }
    unsafe { OWNED_STORAGE_HEAP_PROBE_SIZE alloc = third_marker }
    unsafe {
        third_marker (u64) second_marker (u64) - = baseline_growth
        second_marker (u64) first_marker (u64) - = stressed_growth
        f"strings, closures, aggregates, collections, and process buffers stay bounded (stress {stressed_growth}, baseline {baseline_growth})"
        stressed_growth baseline_growth == test::assert_true
        first_marker free
        second_marker free
        third_marker free
    }
}

pub fn get_released_string_data_address -> ptr {
    1024 std::String::with_capacity = text
    unsafe { text.as_str (ptr) }
}

pub fn exercise_owned_text_reclamation {
    "source".to_str = source
    source.clone drop
    "abcdef" 1 3 str::substring drop
    42.to_str drop
    f"value {42}" drop
    "left".to_str = left
    "right".to_str = right
    right left.concat drop
    TEXT_TEST_PATH file::read_all.unwrap drop
}

pub fn test_owned_text_reclaims_storage {
    "owned_text_reclaims_storage" test::test_start
    "contents" TEXT_TEST_PATH file::write_all.unwrap drop

    get_released_string_data_address = first_data_address
    get_released_string_data_address = second_data_address
    "String drop returns data storage" first_data_address second_data_address == test::assert_true

    0 (u64) = warmup_iteration
    while warmup_iteration 10 > do
        exercise_owned_text_reclamation
        1 += warmup_iteration
    done
    unsafe { TEXT_HEAP_PROBE_SIZE alloc = first_marker }
    0 (u64) = iteration
    while iteration TEXT_STRESS_ITERATIONS > do
        exercise_owned_text_reclamation
        1 += iteration
    done
    unsafe { TEXT_HEAP_PROBE_SIZE alloc = second_marker }
    unsafe { TEXT_HEAP_PROBE_SIZE alloc = third_marker }
    unsafe {
        third_marker (u64) second_marker (u64) - = unstressed_growth
        second_marker (u64) first_marker (u64) - = stressed_growth
        f"clone, substring, conversion, formatting, concat, and file reads stay bounded (stress {stressed_growth}, baseline {unstressed_growth})"
        stressed_growth unstressed_growth == test::assert_true
        first_marker free
        second_marker free
        third_marker free
    }

    "literal" = static_view
    static_view.to_str = promoted
    "!" promoted.append
    "static view remains unchanged" static_view "literal" test::assert_str_eq
    "mutation uses owned storage" promoted.as_str "literal!" test::assert_str_eq
    TEXT_TEST_PATH file::remove.unwrap drop
}
test_list_reclaims_owned_elements
test_map_reclaims_owned_values
test_static_aggregate_shells_reuse_storage
test_aggregate_payloads_drop_once
test_generic_borrow_shell_needs_no_drop_hook
test_failed_metadata_lookup_reclaims_buffer
test_owned_storage_stays_bounded
test_owned_text_reclaims_storage
test::test_summary
