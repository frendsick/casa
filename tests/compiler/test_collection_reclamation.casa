import "std"
import "../../lib/os.casa"
import "helpers.casa"

const TEXT_HEAP_PROBE_SIZE 497
const TEXT_STRESS_ITERATIONS 100
const TEXT_TEST_PATH "/tmp/casa_owned_text_reclamation.txt"

struct Tracked {
    drops: ptr
}

struct EmptyShell {
}

struct CopyShell {
    value: i64
}

struct TrackedShell {
    value: Tracked
}

struct BorrowShell[T] {
    value: $T
}

enum CopyChoice {
    Value (i64)
}

enum TrackedChoice {
    Value (Tracked)
}

impl Tracked {
    fn new drops:ptr -> Tracked { drops Tracked }

    fn drop self:mut$Tracked {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

fn reset drops:ptr {
    unsafe { 0 drops store64 }
}

fn count drops:ptr -> i64 {
    unsafe { drops load64 (i64) }
}

fn test_list_reclaims_owned_elements {
    "list_reclaims_owned_elements" test_start
    unsafe { 8 alloc = drops }
    drops reset

    List[Tracked]::new = items
    0 (u64) = index
    while index 20 > do
        drops Tracked::new items.push
        1 += index
    done
    "growth keeps elements live" 0 drops count assert_eq

    5 items.remove.unwrap drop
    "remove transfers one owner" 1 drops count assert_eq
    drops Tracked::new 0 items.set
    "set destroys the replaced owner" 2 drops count assert_eq
    items drop
    "list destruction releases every owner" 21 drops count assert_eq

    unsafe { drops free }
}

fn test_map_reclaims_owned_values {
    "map_reclaims_owned_values" test_start
    unsafe { 8 alloc = drops }
    drops reset

    Map[i64 Tracked]::new = entries
    0 = key
    while key 20 > do
        drops Tracked::new key entries.set
        1 += key
    done
    "resize keeps values live" 0 drops count assert_eq

    drops Tracked::new 3 entries.set
    "replacement destroys the old value" 1 drops count assert_eq
    4 entries.remove.unwrap drop
    "remove transfers one owner" 2 drops count assert_eq
    entries drop
    "map destruction releases every owner" 21 drops count assert_eq

    unsafe { drops free }
}

fn test_static_aggregate_shells_reuse_storage {
    "static_aggregate_shells_reuse_storage" test_start

    EmptyShell = first_empty
    unsafe { first_empty (ptr) } = first_empty_address
    first_empty drop
    EmptyShell = second_empty
    unsafe { second_empty (ptr) } = second_empty_address
    "empty struct shell" first_empty_address second_empty_address == assert_true

    1 CopyShell = first_struct
    unsafe { first_struct (ptr) } = first_struct_address
    first_struct drop
    2 CopyShell = second_struct
    unsafe { second_struct (ptr) } = second_struct_address
    "Copy-only struct shell" first_struct_address second_struct_address == assert_true

    1 CopyChoice::Value = first_enum
    unsafe { first_enum (ptr) } = first_enum_address
    first_enum drop
    2 CopyChoice::Value = second_enum
    unsafe { second_enum (ptr) } = second_enum_address
    "Copy-only enum shell" first_enum_address second_enum_address == assert_true

    [1, 2, 3] = first_array
    unsafe { first_array (ptr) } = first_array_address
    first_array drop
    [4, 5, 6] = second_array
    unsafe { second_array (ptr) } = second_array_address
    "Copy-only array shell" first_array_address second_array_address == assert_true
}

fn test_aggregate_payloads_drop_once {
    "aggregate_payloads_drop_once" test_start
    unsafe { 8 alloc = drops }
    drops reset

    drops Tracked::new TrackedShell drop
    drops Tracked::new TrackedChoice::Value drop
    drops Tracked::new = first
    drops Tracked::new = second
    [first, second] drop
    "struct, enum, and array payloads" 4 drops count assert_eq

    unsafe { drops free }
}

fn discard_borrow_shell [T] shell:BorrowShell[T] { shell drop }

fn test_generic_borrow_shell_needs_no_drop_hook {
    "generic_borrow_shell_needs_no_drop_hook" test_start
    42 = owner
    owner BorrowShell discard_borrow_shell
    "borrow remains live" 42 owner assert_eq
}

fn get_released_string_data_address -> ptr {
    1024 String::with_capacity = text
    unsafe { text.as_str (ptr) }
}

fn exercise_owned_text_reclamation {
    "source".to_str = source
    source.clone drop
    "abcdef" 1 3 str::substring drop
    42.to_str drop
    f"value {42}" drop
    "left".to_str = left
    "right".to_str = right
    right left.concat drop
    TEXT_TEST_PATH file::read_all.unwrap drop
}

fn test_owned_text_reclaims_storage {
    "owned_text_reclaims_storage" test_start
    "contents" TEXT_TEST_PATH file::write_all.unwrap drop

    get_released_string_data_address = first_data_address
    get_released_string_data_address = second_data_address
    "String drop returns data storage" first_data_address second_data_address == assert_true

    0 (u64) = warmup_iteration
    while warmup_iteration 10 > do
        exercise_owned_text_reclamation
        1 += warmup_iteration
    done
    unsafe { TEXT_HEAP_PROBE_SIZE alloc = first_marker }
    0 (u64) = iteration
    while iteration TEXT_STRESS_ITERATIONS > do
        exercise_owned_text_reclamation
        1 += iteration
    done
    unsafe { TEXT_HEAP_PROBE_SIZE alloc = second_marker }
    unsafe { TEXT_HEAP_PROBE_SIZE alloc = third_marker }
    unsafe {
        third_marker (u64) second_marker (u64) - = unstressed_growth
        second_marker (u64) first_marker (u64) - = stressed_growth
        f"clone, substring, conversion, formatting, concat, and file reads stay bounded (stress {stressed_growth}, baseline {unstressed_growth})"
        stressed_growth unstressed_growth == assert_true
        first_marker free
        second_marker free
        third_marker free
    }

    "literal" = static_view
    static_view.to_str = promoted
    "!" promoted.append
    "static view remains unchanged" static_view "literal" assert_str_eq
    "mutation uses owned storage" promoted.as_str "literal!" assert_str_eq
    TEXT_TEST_PATH file::remove.unwrap drop
}
test_list_reclaims_owned_elements
test_map_reclaims_owned_values
test_static_aggregate_shells_reuse_storage
test_aggregate_payloads_drop_once
test_generic_borrow_shell_needs_no_drop_hook
test_owned_text_reclaims_storage
test_summary
