import "std" as std
import "../../lib/test.casa" as test

fn increment value:u64 -> u64 { value 1 + }

fn is_nonzero value:u64 -> bool { value 0 != }

fn increment_twice value:u64 -> u64 {
    2 += value
    value
}

fn sum_five_values -> i64 { 1 2 3 4 5 + + + + }

fn duplicate_fourth_value -> i64 { 1 2 3 4 dup + + + + }

fn copy_third_value -> i64 { 1 2 3 4 over + + + + }

fn sum_local_reads -> u64 {
    7 = local: u64
    local
    11 = local: u64
    local +
}

fn sum_memory_reads buffer:$std::RawBuffer -> u64 {
    unsafe {
        3 buffer.data store64
        buffer.data load64
        9 buffer.data store64
        buffer.data load64 +
    }
}

fn convert_full_stack bits:u32 -> u64 { 1 2 3 bits f32::from_bits.to_bits u64::from + + + }

fn widen_negative_on_stack value:i8 -> i64 { 1 2 3 value i64::from + + + }

fn wrap_full_stack value:u64 -> u64 { 1 2 3 1 value.wrapping_add + + + }

fn branch_full_stack choose:bool -> i64 {
    1 2 3
    if choose then
        4
    else
        5
    fi
    + + +
}
"native call lowering" test::test_start
"direct checked call" 42 41 increment test::assert_eq
"direct leaf call" 41 is_nonzero test::assert_true
"indirect leaf call" 41 &is_nonzero exec test::assert_true
"indirect checked call" 42 41 &increment exec test::assert_eq
41 = captured: u64
{ captured is_nonzero } = closure
"captured caller" closure exec test::assert_true
"reassigned parameter" 43 41 increment_twice test::assert_eq
"scalar register stack" test::test_start
"subtraction order" 12 20 3 - 5 - test::assert_eq
"comparison order" 7 3 > test::assert_true
"duplicate stays independent" 5 5 dup 2 * swap - test::assert_eq
"fifth value spills in order" 15 sum_five_values test::assert_eq
"duplicate at full capacity" 14 duplicate_fourth_value test::assert_eq
"over at full capacity" 13 copy_third_value test::assert_eq
"rotate order" 0 1 2 3 rot - - test::assert_eq
"local write preserves an earlier read" 18 sum_local_reads test::assert_eq
8 std::RawBuffer::new = bytes
"store preserves an earlier load" 12 bytes sum_memory_reads test::assert_eq
"bit conversions preserve payload and stack order" 4290847563 4290847557 convert_full_stack test::assert_eq
"widening preserves negative values and stack order" 5 -1 widen_negative_on_stack test::assert_eq
"wrapping keeps other cached values" 6 18446744073709551615 wrap_full_stack test::assert_eq
"taken branch preserves other cached values" 10 true branch_full_stack test::assert_eq
"untaken branch preserves other cached values" 11 false branch_full_stack test::assert_eq
test::test_summary
