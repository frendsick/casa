import "../../compiler/typechecker.casa"
import "helpers.casa"

# ============================================================================
# Helpers
# ============================================================================

fn parse_typecheck code:$str diagnostics:mut$Diagnostics {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option[Function]::None ops type_check_ops_for_test drop
}

# ============================================================================
# While scoping: variable declared inside while is not visible after done
# ============================================================================

fn test_while_scope_var_not_visible_after_done {
    Diagnostics::new = diagnostics
    "while_scope_var_not_visible_after_done" test_start
    diagnostics "fn f {\n    while false do\n        1 = x\n    done\n    x\n}\nf\n" parse_typecheck
    diagnostics "has scope error" assert_has_errors
    diagnostics "undefined name kind" ErrorKind::UndefinedName assert_error_kind
}

# ============================================================================
# While scoping: variable declared inside while is visible within the block
# ============================================================================

fn test_while_scope_var_visible_inside {
    Diagnostics::new = diagnostics
    "while_scope_var_visible_inside" test_start
    diagnostics "fn f {\n    while false do\n        1 = x\n        x drop\n    done\n}\nf\n" parse_typecheck
    diagnostics "no errors inside while" assert_no_errors
}

# ============================================================================
# For scoping: iteration variable not visible after done
# ============================================================================

fn test_for_scope_iter_var_not_visible_after_done {
    Diagnostics::new = diagnostics
    "for_scope_iter_var_not_visible_after_done" test_start
    diagnostics "[1, 2, 3] = items\n    for item in items.iter do\n        item drop\n    done\n    item\n" parse_typecheck
    diagnostics "has scope error for iter var" assert_has_errors
    diagnostics "undefined name kind" ErrorKind::UndefinedName assert_error_kind
}

# ============================================================================
# Mutation: outer variable can be mutated inside while block
# ============================================================================

fn test_while_outer_var_mutation {
    Diagnostics::new = diagnostics
    "while_outer_var_mutation" test_start
    diagnostics "fn f -> i64 {\n    0 = counter\n    while false do\n        1 += counter\n    done\n    counter\n}\nf drop\n" parse_typecheck
    diagnostics "no errors mutating outer var" assert_no_errors
}

# ============================================================================
# Sibling scopes: same var name reused in successive while blocks
# ============================================================================

fn test_while_sibling_scope_reuse {
    Diagnostics::new = diagnostics
    "while_sibling_scope_reuse" test_start
    diagnostics "fn f {\n    while false do\n        1 = tmp\n        tmp drop\n    done\n    while false do\n        2 = tmp\n        tmp drop\n    done\n}\nf\n" parse_typecheck
    diagnostics "no errors with sibling while reuse" assert_no_errors
}

# ============================================================================
# Reassignment: name reused at outer scope after a while block stays visible
# ============================================================================

fn test_while_outer_var_reassigned_after_done {
    Diagnostics::new = diagnostics
    "while_outer_var_reassigned_after_done" test_start
    diagnostics "fn f {\n    while false do\n        1 = x\n        x drop\n    done\n    2 = x\n    x drop\n}\nf\n" parse_typecheck
    diagnostics "no errors reassigning name after while block" assert_no_errors
}

# ============================================================================
# Global bypass: global variable inside while is accessible after done
# ============================================================================

fn test_while_global_accessible_after_done {
    Diagnostics::new = diagnostics
    "while_global_accessible_after_done" test_start
    diagnostics "0 = COUNTER\nfn f {\n    global COUNTER\n    while false do\n        1 = COUNTER\n    done\n    COUNTER drop\n}\nf\n" parse_typecheck
    diagnostics "no errors for global after while" assert_no_errors
}

# ============================================================================
# If scoping: variable declared inside an if branch is not visible after fi
# ============================================================================

fn test_if_scope_var_not_visible_after_fi {
    Diagnostics::new = diagnostics
    "if_scope_var_not_visible_after_fi" test_start
    diagnostics "fn f {\n    if false then\n        1 = x\n    fi\n    x\n}\nf\n" parse_typecheck
    diagnostics "has scope error" assert_has_errors
    diagnostics "undefined name kind" ErrorKind::UndefinedName assert_error_kind
}

# ============================================================================
# If is-binding: bound name is visible inside its then branch
# ============================================================================

fn test_if_is_binding_visible_in_then {
    Diagnostics::new = diagnostics
    "if_is_binding_visible_in_then" test_start
    diagnostics "enum E { Some (i64) None }\nfn f e:E {\n    if e E::Some(v) is then v drop fi\n}\n42 E::Some f\n" parse_typecheck
    diagnostics "no errors using is-binding in then" assert_no_errors
}

# ============================================================================
# If is-binding: bound name keeps its type when captured by a f-string lambda
# ============================================================================

fn test_if_is_binding_visible_in_fstring_capture {
    Diagnostics::new = diagnostics
    "if_is_binding_visible_in_fstring_capture" test_start
    diagnostics "enum E { Some (str) None }\nfn f e:E {\n    if e E::Some(v) is then f\"{v}\" drop fi\n}\n\"ok\" E::Some f\n" parse_typecheck
    diagnostics "no errors capturing is-binding in f-string" assert_no_errors
}

# ============================================================================
# If is-binding: bound name is NOT visible after fi
# ============================================================================

fn test_if_is_binding_not_visible_after_fi {
    Diagnostics::new = diagnostics
    "if_is_binding_not_visible_after_fi" test_start
    diagnostics "enum E { Some (i64) None }\nfn f e:E {\n    if e E::Some(v) is then v drop fi\n    v drop\n}\n42 E::Some f\n" parse_typecheck
    diagnostics "is-binding out of scope after fi" assert_has_errors
    diagnostics "undefined name kind" ErrorKind::UndefinedName assert_error_kind
}

# ============================================================================
# If is-binding: bound name is NOT visible in the else branch
# ============================================================================

fn test_if_is_binding_not_visible_in_else {
    Diagnostics::new = diagnostics
    "if_is_binding_not_visible_in_else" test_start
    diagnostics "enum E { Some (i64) None }\nfn f e:E {\n    if e E::Some(v) is then v drop else v drop fi\n}\n42 E::Some f\n" parse_typecheck
    diagnostics "is-binding out of scope in else" assert_has_errors
    diagnostics "undefined name kind" ErrorKind::UndefinedName assert_error_kind
}

# ============================================================================
# Elif independence: each branch carries its own is-bindings
# ============================================================================

fn test_if_elif_independent_bindings {
    Diagnostics::new = diagnostics
    "if_elif_independent_bindings" test_start
    diagnostics "enum E { Some (i64) None }\nfn f a:E b:E {\n    if a E::Some(v) is then v drop\n    elif b E::Some(w) is then w drop\n    fi\n}\n42 E::Some 7 E::Some f\n" parse_typecheck
    diagnostics "no errors with independent elif bindings" assert_no_errors
}

# ============================================================================
# Elif independence: a sibling branch cannot see the if-branch binding
# ============================================================================

fn test_if_elif_cannot_see_if_binding {
    Diagnostics::new = diagnostics
    "if_elif_cannot_see_if_binding" test_start
    diagnostics "enum E { Some (i64) None }\nfn f a:E b:E {\n    if a E::Some(v) is then v drop\n    elif b E::None is then v drop\n    fi\n}\n42 E::Some E::None f\n" parse_typecheck
    diagnostics "if-branch binding not visible in elif" assert_has_errors
    diagnostics "undefined name kind" ErrorKind::UndefinedName assert_error_kind
}

# ============================================================================
# Outer mutation: `= x` inside a branch mutates the outer variable
# ============================================================================

fn test_if_outer_var_mutation_in_branch {
    Diagnostics::new = diagnostics
    "if_outer_var_mutation_in_branch" test_start
    diagnostics "fn f -> i64 {\n    0 = x\n    if true then 5 = x fi\n    x\n}\nf drop\n" parse_typecheck
    diagnostics "no errors mutating outer var in branch" assert_no_errors
}

# ============================================================================
# Block-local: a new `= y` inside a branch is not visible after fi
# ============================================================================

fn test_if_block_local_new_var {
    Diagnostics::new = diagnostics
    "if_block_local_new_var" test_start
    diagnostics "fn f {\n    if true then 5 = y fi\n    y drop\n}\nf\n" parse_typecheck
    diagnostics "block-local new var out of scope after fi" assert_has_errors
    diagnostics "undefined name kind" ErrorKind::UndefinedName assert_error_kind
}

# ============================================================================
# Shadow error: an is-binding may not shadow an accessible outer variable
# ============================================================================

fn test_if_is_binding_shadow_error {
    Diagnostics::new = diagnostics
    "if_is_binding_shadow_error" test_start
    diagnostics "enum E { Some (i64) None }\nfn f e:E {\n    42 = v\n    if e E::Some(v) is then v drop fi\n}\n42 E::Some f\n" parse_typecheck
    diagnostics "shadowing is-binding is an error" assert_has_errors
    diagnostics "duplicate name kind" ErrorKind::DuplicateName assert_error_kind
}

# ============================================================================
# If scoping: sibling block locals may reuse a name with different types
# ============================================================================

fn test_if_sibling_block_local_type_reuse {
    Diagnostics::new = diagnostics
    "if_sibling_block_local_type_reuse" test_start
    diagnostics "fn f flag:bool {\n    if flag then\n        \"branch\" = tmp\n        tmp drop\n    else\n        1 = tmp\n        tmp drop\n    fi\n}\ntrue f\n" parse_typecheck
    diagnostics "no errors reusing block-local name with different type" assert_no_errors
}

# ============================================================================
# If scoping: outer-scope reassignment after block may reuse a block-local name
# ============================================================================

fn test_if_outer_scope_redeclare_after_block {
    Diagnostics::new = diagnostics
    "if_outer_scope_redeclare_after_block" test_start
    diagnostics "fn f {\n    if true then\n        \"branch\" = tmp\n        tmp drop\n    fi\n    1 = tmp\n    tmp drop\n}\nf\n" parse_typecheck
    diagnostics "no errors reusing name after block scope ends" assert_no_errors
}

# ============================================================================
# If scoping: predeclared locals assigned in branches stay visible after fi
# ============================================================================

fn test_if_predeclared_var_assigned_in_branches_visible_after_fi {
    Diagnostics::new = diagnostics
    "if_predeclared_var_assigned_in_branches_visible_after_fi" test_start
    diagnostics "fn f flag:bool {\n    \"\" = label\n    if flag then\n        \"left\" = label\n    else\n        \"right\" = label\n    fi\n    label drop\n}\ntrue f\n" parse_typecheck
    diagnostics "no errors using predeclared branch-assigned var after fi" assert_no_errors
}

# ============================================================================
# `is` bindings outside if/elif conditions are rejected
# ============================================================================

fn test_standalone_is_binding_rejected {
    Diagnostics::new = diagnostics
    "standalone_is_binding_rejected" test_start
    diagnostics "enum E { Some (i64) None }\nfn f e:E {\n    e E::Some(v) is drop\n    v drop\n}\n42 E::Some f\n" parse_typecheck
    diagnostics "standalone is-binding has scope error" assert_has_errors
    diagnostics "invalid scope kind" ErrorKind::InvalidScope assert_error_kind
}

# ============================================================================
# Match scoping: an arm binding is visible inside its arm body
# ============================================================================

fn test_match_arm_binding_visible {
    Diagnostics::new = diagnostics
    "match_arm_binding_visible" test_start
    diagnostics "enum E { Some (i64) None }\nfn f e:E {\n    e match\n        E::Some(v) => { v drop }\n        E::None => { }\n    end\n}\n42 E::Some f\n" parse_typecheck
    diagnostics "no errors using arm binding in arm" assert_no_errors
}

# ============================================================================
# Match scoping: arm binding keeps its type when captured by a f-string lambda
# ============================================================================

fn test_match_arm_binding_visible_in_fstring_capture {
    Diagnostics::new = diagnostics
    "match_arm_binding_visible_in_fstring_capture" test_start
    diagnostics "enum E { Some (str) None }\nfn f e:E {\n    e match\n        E::Some(v) => { f\"{v}\" drop }\n        E::None => { }\n    end\n}\n\"ok\" E::Some f\n" parse_typecheck
    diagnostics "no errors capturing arm binding in f-string" assert_no_errors
}

# ============================================================================
# Match scoping: an arm binding is not visible in another arm
# ============================================================================

fn test_match_arm_binding_not_in_other_arm {
    Diagnostics::new = diagnostics
    "match_arm_binding_not_in_other_arm" test_start
    diagnostics "enum E { Some (i64) None }\nfn f a:E {\n    a match\n        E::Some(v) => { v drop }\n        E::None => { v drop }\n    end\n}\n42 E::Some f\n" parse_typecheck
    diagnostics "arm binding not visible in sibling arm" assert_has_errors
    diagnostics "undefined name kind" ErrorKind::UndefinedName assert_error_kind
}

# ============================================================================
# Match scoping: an arm binding may not shadow an accessible outer variable
# ============================================================================

fn test_match_arm_binding_shadow_error {
    Diagnostics::new = diagnostics
    "match_arm_binding_shadow_error" test_start
    diagnostics "enum E { Some (i64) None }\nfn f e:E {\n    42 = v\n    e match\n        E::Some(v) => { v drop }\n        E::None => { }\n    end\n}\n42 E::Some f\n" parse_typecheck
    diagnostics "shadowing arm binding is an error" assert_has_errors
    diagnostics "duplicate name kind" ErrorKind::DuplicateName assert_error_kind
}

# ============================================================================
# Match scoping: `= x` inside an arm mutates the outer variable
# ============================================================================

fn test_match_arm_outer_var_mutation {
    Diagnostics::new = diagnostics
    "match_arm_outer_var_mutation" test_start
    diagnostics "enum E { Some (i64) None }\nfn f e:E -> i64 {\n    0 = acc\n    e match\n        E::Some(n) => { n = acc }\n        E::None => { }\n    end\n    acc\n}\n42 E::Some f drop\n" parse_typecheck
    diagnostics "no errors mutating outer var in arm" assert_no_errors
}

# ============================================================================
# Match scoping: a new `= z` inside an arm is not visible after end
# ============================================================================

fn test_match_arm_block_local_new_var {
    Diagnostics::new = diagnostics
    "match_arm_block_local_new_var" test_start
    diagnostics "enum E { Some (i64) None }\nfn f e:E {\n    e match\n        E::Some(n) => { n drop 99 = zz zz drop }\n        E::None => { }\n    end\n    zz drop\n}\n42 E::Some f\n" parse_typecheck
    diagnostics "block-local arm var out of scope after end" assert_has_errors
    diagnostics "undefined name kind" ErrorKind::UndefinedName assert_error_kind
}

# ============================================================================
# Match scoping: sibling arm locals may reuse a name with different types
# ============================================================================

fn test_match_sibling_block_local_type_reuse {
    Diagnostics::new = diagnostics
    "match_sibling_block_local_type_reuse" test_start
    diagnostics "enum E { A B }\nfn f e:E {\n    e match\n        E::A => { \"arm\" = tmp tmp drop }\n        E::B => { 1 = tmp tmp drop }\n    end\n}\nE::A f\n" parse_typecheck
    diagnostics "no errors reusing arm-local name with different type" assert_no_errors
}

# ============================================================================
# Match scoping: a guard cannot see a prior arm binding
# ============================================================================

fn test_match_guard_cannot_see_prior_arm_binding {
    Diagnostics::new = diagnostics
    "match_guard_cannot_see_prior_arm_binding" test_start
    diagnostics "enum E { Some (i64) None }\nfn f e:E {\n    e match\n        E::Some(v) => { v drop }\n        E::None if 0 v > => { }\n        _ => { }\n    end\n}\nE::None f\n" parse_typecheck
    diagnostics "prior arm binding not visible in guard" assert_has_errors
    diagnostics "undefined name kind" ErrorKind::UndefinedName assert_error_kind
}

# ============================================================================
# Nested blocks: explicit assignment mutates an accessible block binding
# ============================================================================

fn test_nested_block_outer_mutation {
    Diagnostics::new = diagnostics
    "nested_block_outer_mutation" test_start
    diagnostics "fn f -> i64 {\n    if true then\n        1 = value\n        if true then 2 = value fi\n        value\n    else\n        0\n    fi\n}\nf drop\n" parse_typecheck
    diagnostics "nested assignment keeps outer block binding" assert_no_errors
}

# ============================================================================
# Match guards: a nested checker sees the current arm snapshot
# ============================================================================

fn test_match_guard_sees_current_binding {
    Diagnostics::new = diagnostics
    "match_guard_sees_current_binding" test_start
    diagnostics "enum E { Some (i64) None }\nfn f e:E {\n    e match\n        E::Some(v) if v 0 > => { v drop }\n        E::None => { }\n        _ => { }\n    end\n}\n1 E::Some f\n" parse_typecheck
    diagnostics "guard sees current arm binding" assert_no_errors
}

# ============================================================================
# Explicit globals: a same-named default local still obeys block lifetime
# ============================================================================

fn test_block_local_shadows_global_and_expires {
    Diagnostics::new = diagnostics
    "block_local_shadows_global_and_expires" test_start
    diagnostics "0 = SHARED\nfn f {\n    if true then\n        \"local\" = SHARED\n        SHARED drop\n    fi\n    SHARED drop\n}\nf\n" parse_typecheck
    diagnostics "default local expires instead of resolving as global" assert_has_errors
    diagnostics "undefined name kind" ErrorKind::UndefinedName assert_error_kind
}

fn test_implicit_binding_rejects_local_that_shadows_global {
    Diagnostics::new = diagnostics
    "implicit_binding_rejects_local_that_shadows_global" test_start
    diagnostics "0 = value\nenum E { Some (i64) None }\nfn f e:E {\n    1 = value\n    if e E::Some(value) is then value drop fi\n}\n1 E::Some f\n" parse_typecheck
    diagnostics "binding cannot shadow the accessible local" assert_has_errors
    diagnostics "duplicate name kind" ErrorKind::DuplicateName assert_error_kind
}

fn test_implicit_binding_may_share_global_spelling {
    Diagnostics::new = diagnostics
    "implicit_binding_may_share_global_spelling" test_start
    diagnostics "0 = value\nenum E { Some (i64) None }\nfn f e:E {\n    if e E::Some(value) is then value drop fi\n}\n1 E::Some f\n" parse_typecheck
    diagnostics "global spelling remains available to a local binding" assert_no_errors
}

# ============================================================================
# Field-path assignment: only the root binding participates in scope lookup
# ============================================================================

fn test_block_field_path_assignment {
    Diagnostics::new = diagnostics
    "block_field_path_assignment" test_start
    diagnostics "struct Box { value: i64 }\nfn f box:Box -> i64 {\n    if true then 2 = box.value fi\n    box.value\n}\n1 Box f drop\n" parse_typecheck
    diagnostics "field assignment preserves root scope" assert_no_errors
}

# ============================================================================
# Closures: block-local binding Types remain available while the frame is active
# ============================================================================

fn test_block_local_closure_capture {
    Diagnostics::new = diagnostics
    "block_local_closure_capture" test_start
    diagnostics "fn f {\n    if true then\n        1 = value\n        { value } = get_value\n        get_value exec drop\n    fi\n}\nf\n" parse_typecheck
    diagnostics "closure captures active block binding" assert_no_errors
}

