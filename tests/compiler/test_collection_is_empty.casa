import "std"
import "helpers.casa"

"collection is_empty" test_start
[] (array[i64 0]) = empty_array
"empty array" empty_array.is_empty assert_true
"nonempty array" [1].is_empty ! assert_true
List[i64]::new = empty_list
"empty list" empty_list.is_empty assert_true
1 empty_list.push
"nonempty list" empty_list.is_empty ! assert_true
0 0 empty_list.slice = empty_slice
"empty slice" empty_slice.is_empty assert_true
1 0 empty_list.slice = nonempty_slice
"nonempty slice" nonempty_slice.is_empty ! assert_true
"empty string" "".is_empty assert_true
"nonempty string" "Casa".is_empty ! assert_true
Map[str i64]::new = empty_map
"empty map" empty_map.is_empty assert_true
1 "one" empty_map.set = nonempty_map
"nonempty map" nonempty_map.is_empty ! assert_true
Set[str]::new = empty_set
"empty set" empty_set.is_empty assert_true
"one" empty_set.add = nonempty_set
"nonempty set" nonempty_set.is_empty ! assert_true
test_summary
