import "std" as std
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

"collection is_empty" test::test_start
[] = empty_array: array[i64 0]
"empty array" empty_array.is_empty test::assert_true
"nonempty array" [1].is_empty ! test::assert_true
std::List[i64]::new = empty_list
"empty list" empty_list.is_empty test::assert_true
"empty list has no backing allocation" empty_list.as_ptr ptr::null == test::assert_true
std::List[i64]::new empty_list.append
"empty append keeps storage lazy" empty_list.as_ptr ptr::null == test::assert_true
1 empty_list.push
"nonempty list" empty_list.is_empty ! test::assert_true
0 0 empty_list.slice = empty_slice
"empty slice" empty_slice.is_empty test::assert_true
1 0 empty_list.slice = nonempty_slice
"nonempty slice" nonempty_slice.is_empty ! test::assert_true
"empty string" "".is_empty test::assert_true
"nonempty string" "Casa".is_empty ! test::assert_true
std::Map[str i64]::new = empty_map
"empty map" empty_map.is_empty test::assert_true
"empty map lookup" "one" empty_map.get.is_none test::assert_true
"empty map mutable lookup" "one" empty_map.get_mut.is_none test::assert_true
"empty map removal" "one" empty_map.remove.is_none test::assert_true
1 "one" empty_map.set
"nonempty map" empty_map.is_empty ! test::assert_true
std::Set[str]::new = empty_set
"empty set" empty_set.is_empty test::assert_true
"one" empty_set.add
"nonempty set" empty_set.is_empty ! test::assert_true
std::List[i64]::new = inserted
0 42 inserted.insert
"first insertion" 42 0 inserted.get test::assert_eq
std::List[i64]::new = appended
[7, 8, 9] std::List::from_array appended.append
"first append length" 3 appended.length test::assert_eq
"first append value" 9 2 appended.get test::assert_eq
std::Map[std::String i64]::new = strings
"empty string-key lookup" "key" strings.get_str.is_none test::assert_true
"empty string-key mutable lookup" "key" strings.get_mut_str.is_none test::assert_true
"empty string-key removal" "key" strings.remove_str.is_none test::assert_true
11 "key" strings.set_str
"first string-key insertion" 11 "key" strings.get_copy_str.unwrap test::assert_eq
test::test_summary
