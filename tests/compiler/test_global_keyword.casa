import "../../compiler/typechecker.casa"
import "helpers.casa"

# ============================================================================
# Helpers
# ============================================================================

fn parse_snippet code:$str diagnostics:mut$Diagnostics {
    diagnostics code parse_resolve_test_source drop
}

fn parse_resolve_snippet code:$str diagnostics:mut$Diagnostics {
    diagnostics code parse_resolve_test_source drop
}

fn parse_resolve_typecheck code:$str diagnostics:mut$Diagnostics {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option[Function]::None ops type_check_ops_for_test drop
}

# ============================================================================
# Parse: `global X` in a function body produces no errors
# ============================================================================

fn test_global_decl_parses {
    Diagnostics::new = diagnostics
    "global_decl_parses" test_start
    diagnostics "0 = LOG_LEVEL\nfn set_level level:i64 {\n    global LOG_LEVEL\n    level = LOG_LEVEL\n}\n" parse_snippet
    diagnostics "no parse errors" assert_no_errors
}

# ============================================================================
# Resolve: `global X` in a function resolves without errors
# ============================================================================

fn test_global_decl_resolves {
    Diagnostics::new = diagnostics
    "global_decl_resolves" test_start
    diagnostics "0 = LOG_LEVEL\nfn set_level level:i64 {\n    global LOG_LEVEL\n    level = LOG_LEVEL\n}\n" parse_resolve_snippet
    diagnostics "no resolve errors" assert_no_errors
}

# ============================================================================
# Error: `global` at top level is INVALID_SCOPE
# ============================================================================

fn test_global_at_top_level_errors {
    Diagnostics::new = diagnostics
    "global_at_top_level_errors" test_start
    diagnostics "0 = X\nglobal X\n" parse_snippet
    diagnostics "has INVALID_SCOPE error" ErrorKind::InvalidScope assert_error_kind
}

# ============================================================================
# Error: `global` in a lambda is an error
# ============================================================================

fn test_global_in_lambda_errors {
    Diagnostics::new = diagnostics
    "global_in_lambda_errors" test_start
    diagnostics "0 = X\nfn foo {\n    { global X\n    1 = X } exec\n}\n" parse_snippet
    diagnostics "has error for global in lambda" assert_has_errors
}

# ============================================================================
# Error: `global X` after body statements is an error
# ============================================================================

fn test_global_after_body_errors {
    Diagnostics::new = diagnostics
    "global_after_body_errors" test_start
    diagnostics "0 = X\nfn foo {\n    0 = local_var\n    global X\n}\n" parse_snippet
    diagnostics "has error for global after body" assert_has_errors
}

# ============================================================================
# Error: `global NONEXISTENT` produces an error (nonexistent global)
# ============================================================================

fn test_global_nonexistent_errors {
    Diagnostics::new = diagnostics
    "global_nonexistent_errors" test_start
    diagnostics "fn foo {\n    global NONEXISTENT\n    0 = NONEXISTENT\n}\nfoo\n" parse_resolve_typecheck
    diagnostics "has error for nonexistent global" assert_has_errors
}

# ============================================================================
# Isolation: lib fn with `= value` compiles cleanly when user has global value
# ============================================================================

fn test_isolation_no_type_error {
    Diagnostics::new = diagnostics
    "isolation_no_type_error" test_start
    diagnostics "\"hello\" = value\nfn process_value {\n    42 = value\n    value 1 + drop\n}\nprocess_value\n" parse_resolve_typecheck
    diagnostics "no type mismatch after fix" assert_no_errors
}

# ============================================================================
# Run all tests
# ============================================================================
test_global_decl_parses
test_global_decl_resolves
test_global_at_top_level_errors
test_global_in_lambda_errors
test_global_after_body_errors
test_global_nonexistent_errors
test_isolation_no_type_error
test_summary
