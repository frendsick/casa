import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

global TEST_LIMIT 41
global TEST_TEXT { "immutable".to_str }
global TEST_BRANCH_VALUE { if true then 1 else 2 fi }
global TEST_VALUES { [1, 2] }

pub fn replace_first values:mut$array[i64 2] {
    # SAFETY: The array contains an initialized i64 at its first address.
    unsafe { 99 values ptr::from_ref store64 }
}

# ============================================================================
# Helpers
# ============================================================================

pub fn parse_snippet code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_source drop
}

pub fn parse_resolve_snippet code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_source drop
}

pub fn parse_resolve_typecheck code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test drop
}

# ============================================================================
# Mutable globals and hidden root-local capture
# ============================================================================

pub fn test_mutable_global_decl_errors {
    error::Diagnostics::new = diagnostics
    "mutable_global_decl_errors" test::test_start
    diagnostics "fn set_level level:i64 {\n    global LOG_LEVEL\n    level = LOG_LEVEL\n}\n" parse_snippet
    diagnostics "mutable global error" common::ErrorKind::InvalidScope helpers::assert_error_kind
}

pub fn test_named_function_root_local_read_errors {
    error::Diagnostics::new = diagnostics
    "named_function_root_local_read_errors" test::test_start
    diagnostics "41 = state\nfn read_state -> i64 { state }\n" parse_resolve_snippet
    diagnostics "root capture error" "cannot capture root local `state`" helpers::assert_error_contains
}

pub fn test_named_function_root_local_mutation_errors {
    "named_function_root_local_mutation_errors" test::test_start
    error::Diagnostics::new = increment_diagnostics
    increment_diagnostics "0 = state\nfn increment { 1 += state }\n" parse_resolve_snippet
    increment_diagnostics "root increment error" "cannot capture root local `state`" helpers::assert_error_contains

    error::Diagnostics::new = decrement_diagnostics
    decrement_diagnostics "0 = state\nfn decrement { 1 -= state }\n" parse_resolve_snippet
    decrement_diagnostics "root decrement error" "cannot capture root local `state`" helpers::assert_error_contains

    error::Diagnostics::new = field_diagnostics
    field_diagnostics
    "struct State { value: i64 }\n0 State = state\nfn update { 1 = state.value }\n"
    parse_resolve_snippet
    field_diagnostics "root field mutation error" "cannot capture root local `state`" helpers::assert_error_contains
}

pub fn test_named_function_array_root_local_read_errors {
    error::Diagnostics::new = diagnostics
    "named_function_array_root_local_read_errors" test::test_start
    diagnostics "1 = state\nfn read_state { [state] drop }\n" parse_resolve_snippet
    diagnostics "array root capture error" "cannot capture root local `state`" helpers::assert_error_contains
}

pub fn test_named_function_nested_closure_root_local_read_errors {
    error::Diagnostics::new = diagnostics
    "named_function_nested_closure_root_local_read_errors" test::test_start
    diagnostics "41 = state\nfn read_state -> i64 { { state } exec }\n" parse_resolve_snippet
    diagnostics "nested closure root capture error" "cannot capture root local `state`" helpers::assert_error_contains
}

pub fn test_explicit_root_state_parameter_typechecks {
    error::Diagnostics::new = diagnostics
    "explicit_root_state_parameter_typechecks" test::test_start
    diagnostics
    "struct State { value: i64 }\nfn increment state:mut$State { 1 += state.value }\n0 State = state\nstate increment\nstate drop\n"
    parse_resolve_typecheck
    diagnostics "explicit state parameter" helpers::assert_no_errors
}

pub fn test_root_closure_capture_typechecks {
    error::Diagnostics::new = diagnostics
    "root_closure_capture_typechecks" test::test_start
    diagnostics "0 = state\n{ 1 += state } exec\nstate drop\n" parse_resolve_typecheck
    diagnostics "root closure capture" helpers::assert_no_errors
}

pub fn test_nested_root_closure_capture_typechecks {
    error::Diagnostics::new = diagnostics
    "nested_root_closure_capture_typechecks" test::test_start
    diagnostics "0 = state\n{ { 1 += state } exec } exec\nstate drop\n" parse_resolve_typecheck
    diagnostics "nested root closure capture" helpers::assert_no_errors
}

# ============================================================================
# Root `global` declarations initialize one immutable value
# ============================================================================

pub fn test_global_at_top_level_initializes {
    error::Diagnostics::new = diagnostics
    "global_at_top_level_initializes" test::test_start
    diagnostics "global X 1\nglobal Y { X 1 + }\nY drop\n" parse_resolve_typecheck
    diagnostics "immutable globals typecheck" helpers::assert_no_errors
    "Copy global read" 42 TEST_LIMIT 1 + test::assert_eq
    "non-Copy global read" "immutable" TEST_TEXT.as_str test::assert_str_eq
    "initializer control flow" 1 TEST_BRANCH_VALUE test::assert_eq
    "initializer temporary local" 2 TEST_VALUES.length test::assert_eq
    TEST_VALUES = copied
    copied replace_first
    "Copy global remains unchanged" 1 0 TEST_VALUES.nth.clone test::assert_eq
    "Copy of global changes independently" 99 0 copied.nth.clone test::assert_eq
    copied drop
    { TEST_VALUES } exec = captured_copy
    captured_copy replace_first
    "captured Copy global remains unchanged" 1 0 TEST_VALUES.nth.clone test::assert_eq
    "captured global copy changes independently" 99 0 captured_copy.nth.clone test::assert_eq
    captured_copy drop
}

pub fn test_global_initializer_requires_one_value {
    error::Diagnostics::new = diagnostics
    "global_initializer_requires_one_value" test::test_start
    diagnostics "global BAD { 1 2 }\n" parse_resolve_typecheck
    diagnostics "initializer arity error" common::ErrorKind::SignatureMismatch helpers::assert_error_kind
}

pub fn test_global_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_forward_read_errors" test::test_start
    diagnostics "global SAFE 1\nglobal FIRST { SECOND }\nglobal SECOND 2\n" parse_resolve_snippet
    diagnostics "forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_executed_lambda_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_executed_lambda_forward_read_errors" test::test_start
    diagnostics "global FIRST { { SECOND } dup exec swap drop }\nglobal SECOND 2\n" parse_resolve_snippet
    diagnostics "lambda forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_default_method_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_default_method_forward_read_errors" test::test_start
    diagnostics
    "trait Step { fn bumped self:self -> i64 { self drop SECOND } } impl i64: Step { } global FIRST { 1 .bumped } global SECOND 2"
    parse_resolve_snippet
    diagnostics "default method forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

