pub fn test_global_recursive_callable_argument_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_recursive_callable_argument_forward_read_errors" test::test_start
    diagnostics
    "fn safe -> i64 { 1 } fn late -> i64 { SECOND } fn recurse callback:fn[-> i64] -> i64 { true if then &late recurse else callback exec fi } global FIRST { &safe recurse } global SECOND 2"
    parse_resolve_snippet
    diagnostics "recursive callable argument forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_callable_reassignment_replaces_dependency {
    error::Diagnostics::new = diagnostics
    "global_callable_reassignment_replaces_dependency" test::test_start
    diagnostics
    "fn late -> i64 { SECOND } fn safe -> i64 { 1 } global FIRST { &late = callback &safe = callback callback exec } global SECOND 2"
    parse_resolve_snippet
    diagnostics "overwritten callable is not retained" helpers::assert_no_errors
}

