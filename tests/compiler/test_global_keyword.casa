import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

# ============================================================================
# Helpers
# ============================================================================

pub fn parse_snippet code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_source drop
}

pub fn parse_resolve_snippet code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_source drop
}

pub fn parse_resolve_typecheck code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_parts = source_bodies = store = ops
    source_bodies diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test drop
}

pub fn test_removed_global_diagnostic {
    "removed_global_diagnostic" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "global LIMIT 10\n" parse_snippet
    diagnostics "removed global is syntax error" common::ErrorKind::Syntax helpers::assert_error_kind
    diagnostics "migration advice" "`global` was removed" helpers::assert_error_contains
}

pub fn test_removed_public_global_diagnostic {
    "removed_public_global_diagnostic" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "pub global LIMIT 10\n" parse_snippet
    diagnostics "removed public global is syntax error" common::ErrorKind::Syntax helpers::assert_error_kind
}

pub fn test_removed_global_without_initializer_diagnostic {
    "removed_global_without_initializer_diagnostic" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "global X\n" parse_snippet
    diagnostics "missing initializer still gives migration advice" "`global` was removed" helpers::assert_error_contains

    error::Diagnostics::new = public_diagnostics
    public_diagnostics "pub global X\n" parse_snippet
    public_diagnostics "public declaration gives migration advice" "`global` was removed" helpers::assert_error_contains
}

pub fn test_removed_nested_global_diagnostic {
    "removed_nested_global_diagnostic" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "fn f { global X }\n" parse_snippet
    diagnostics "nested declaration gives migration advice" "`global` was removed" helpers::assert_error_contains
}

pub fn test_named_function_root_local_read_errors {
    error::Diagnostics::new = diagnostics
    "named_function_root_local_read_errors" test::test_start
    diagnostics "41 = state\nfn read_state -> i64 { state }\n" parse_resolve_snippet
    diagnostics "root capture error" "cannot capture root local `state`" helpers::assert_error_contains
}

pub fn test_named_function_root_local_mutation_errors {
    "named_function_root_local_mutation_errors" test::test_start
    error::Diagnostics::new = increment_diagnostics
    increment_diagnostics "0 = state\nfn increment { 1 += state }\n" parse_resolve_snippet
    increment_diagnostics "root increment error" "cannot capture root local `state`" helpers::assert_error_contains

    error::Diagnostics::new = decrement_diagnostics
    decrement_diagnostics "0 = state\nfn decrement { 1 -= state }\n" parse_resolve_snippet
    decrement_diagnostics "root decrement error" "cannot capture root local `state`" helpers::assert_error_contains

    error::Diagnostics::new = field_diagnostics
    field_diagnostics
    "struct State { value: i64 }\n0 State = state\nfn update { 1 = state.value }\n"
    parse_resolve_snippet
    field_diagnostics "root field mutation error" "cannot capture root local `state`" helpers::assert_error_contains
}

pub fn test_named_function_array_root_local_read_errors {
    error::Diagnostics::new = diagnostics
    "named_function_array_root_local_read_errors" test::test_start
    diagnostics "1 = state\nfn read_state { [state] drop }\n" parse_resolve_snippet
    diagnostics "array root capture error" "cannot capture root local `state`" helpers::assert_error_contains
}

pub fn test_named_function_nested_closure_root_local_read_errors {
    error::Diagnostics::new = diagnostics
    "named_function_nested_closure_root_local_read_errors" test::test_start
    diagnostics "41 = state\nfn read_state -> i64 { { state } exec }\n" parse_resolve_snippet
    diagnostics "nested closure root capture error" "cannot capture root local `state`" helpers::assert_error_contains
}

pub fn test_explicit_root_state_parameter_typechecks {
    error::Diagnostics::new = diagnostics
    "explicit_root_state_parameter_typechecks" test::test_start
    diagnostics
    "struct State { value: i64 }\nfn increment state:mut$State { 1 += state.value }\n0 State = state\nstate increment\nstate drop\n"
    parse_resolve_typecheck
    diagnostics "explicit state parameter" helpers::assert_no_errors
}

pub fn test_root_closure_capture_typechecks {
    error::Diagnostics::new = diagnostics
    "root_closure_capture_typechecks" test::test_start
    diagnostics "0 = state\n{ 1 += state } exec\nstate drop\n" parse_resolve_typecheck
    diagnostics "root closure capture" helpers::assert_no_errors
}

pub fn test_nested_root_closure_capture_typechecks {
    error::Diagnostics::new = diagnostics
    "nested_root_closure_capture_typechecks" test::test_start
    diagnostics "0 = state\n{ { 1 += state } exec } exec\nstate drop\n" parse_resolve_typecheck
    diagnostics "nested root closure capture" helpers::assert_no_errors
}

pub fn test_isolation_no_type_error {
    error::Diagnostics::new = diagnostics
    "isolation_no_type_error" test::test_start
    diagnostics "\"hello\" = value\nfn process_value {\n    42 = value\n    value 1 + drop\n}\nprocess_value\n" parse_resolve_typecheck
    diagnostics "no type mismatch after fix" helpers::assert_no_errors
}
test_removed_global_diagnostic
test_removed_public_global_diagnostic
test_removed_global_without_initializer_diagnostic
test_removed_nested_global_diagnostic
test_named_function_root_local_read_errors
test_named_function_root_local_mutation_errors
test_named_function_array_root_local_read_errors
test_named_function_nested_closure_root_local_read_errors
test_explicit_root_state_parameter_typechecks
test_root_closure_capture_typechecks
test_nested_root_closure_capture_typechecks
test_isolation_no_type_error
test::test_summary
