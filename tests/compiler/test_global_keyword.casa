import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

global TEST_LIMIT 41
global TEST_TEXT { "immutable".to_str }
global TEST_BRANCH_VALUE { if true then 1 else 2 fi }
global TEST_VALUES { [1, 2] }

# ============================================================================
# Helpers
# ============================================================================

pub fn parse_snippet code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_source drop
}

pub fn parse_resolve_snippet code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_source drop
}

pub fn parse_resolve_typecheck code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test drop
}

# ============================================================================
# Parse: `global X` in a function body produces no errors
# ============================================================================

pub fn test_global_decl_parses {
    error::Diagnostics::new = diagnostics
    "global_decl_parses" test::test_start
    diagnostics "0 = LOG_LEVEL\nfn set_level level:i64 {\n    global LOG_LEVEL\n    level = LOG_LEVEL\n}\n" parse_snippet
    diagnostics "no parse errors" helpers::assert_no_errors
}

# ============================================================================
# Resolve: `global X` in a function resolves without errors
# ============================================================================

pub fn test_global_decl_resolves {
    error::Diagnostics::new = diagnostics
    "global_decl_resolves" test::test_start
    diagnostics "0 = LOG_LEVEL\nfn set_level level:i64 {\n    global LOG_LEVEL\n    level = LOG_LEVEL\n}\n" parse_resolve_snippet
    diagnostics "no resolve errors" helpers::assert_no_errors
}

# ============================================================================
# Root `global` declarations initialize one immutable value
# ============================================================================

pub fn test_global_at_top_level_initializes {
    error::Diagnostics::new = diagnostics
    "global_at_top_level_initializes" test::test_start
    diagnostics "global X 1\nglobal Y { X 1 + }\nY drop\n" parse_resolve_typecheck
    diagnostics "immutable globals typecheck" helpers::assert_no_errors
    "Copy global read" 42 TEST_LIMIT 1 + test::assert_eq
    "non-Copy global read" "immutable" TEST_TEXT.as_str test::assert_str_eq
    "initializer control flow" 1 TEST_BRANCH_VALUE test::assert_eq
    "initializer temporary local" 2 TEST_VALUES.length test::assert_eq
}

pub fn test_global_initializer_requires_one_value {
    error::Diagnostics::new = diagnostics
    "global_initializer_requires_one_value" test::test_start
    diagnostics "global BAD { 1 2 }\n" parse_resolve_typecheck
    diagnostics "initializer arity error" common::ErrorKind::SignatureMismatch helpers::assert_error_kind
}

pub fn test_global_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_forward_read_errors" test::test_start
    diagnostics "global FIRST { SECOND }\nglobal SECOND 2\n" parse_resolve_snippet
    diagnostics "forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_executed_lambda_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_executed_lambda_forward_read_errors" test::test_start
    diagnostics "global FIRST { { SECOND } dup exec swap drop }\nglobal SECOND 2\n" parse_resolve_snippet
    diagnostics "lambda forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_default_method_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_default_method_forward_read_errors" test::test_start
    diagnostics
    "trait Step { fn bumped self:self -> i64 { self drop SECOND } } impl i64: Step { } global FIRST { 1 .bumped } global SECOND 2"
    parse_resolve_snippet
    diagnostics "default method forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_branch_callable_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_branch_callable_forward_read_errors" test::test_start
    diagnostics
    "global FIRST { true if then { SECOND } else { 1 } fi exec } global SECOND 2"
    parse_resolve_snippet
    diagnostics "branch callable forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_assigned_callable_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_assigned_callable_forward_read_errors" test::test_start
    diagnostics
    "fn late -> i64 { SECOND } global FIRST { &late = callback callback exec } global SECOND 2"
    parse_resolve_snippet
    diagnostics "assigned callable forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_callable_argument_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_callable_argument_forward_read_errors" test::test_start
    diagnostics
    "fn apply callback:fn[-> i64] -> i64 { callback exec } fn read_later -> i64 { SECOND } global FIRST { &read_later apply } global SECOND 2"
    parse_resolve_snippet
    diagnostics "callable argument forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_callable_return_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_callable_return_forward_read_errors" test::test_start
    diagnostics
    "fn late -> i64 { SECOND } fn choose -> fn[-> i64] { &late } global FIRST { choose exec } global SECOND 2"
    parse_resolve_snippet
    diagnostics "callable return forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_indirect_callable_return_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_indirect_callable_return_forward_read_errors" test::test_start
    diagnostics
    "fn late -> i64 { SECOND } fn choose -> fn[-> i64] { &late } global FIRST { &choose exec exec } global SECOND 2"
    parse_resolve_snippet
    diagnostics "indirect callable return forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_recursive_callable_argument_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_recursive_callable_argument_forward_read_errors" test::test_start
    diagnostics
    "fn safe -> i64 { 1 } fn late -> i64 { SECOND } fn recurse callback:fn[-> i64] -> i64 { true if &late recurse else callback exec fi } global FIRST { &safe recurse } global SECOND 2"
    parse_resolve_snippet
    diagnostics "recursive callable argument forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_method_callable_return_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_method_callable_return_forward_read_errors" test::test_start
    diagnostics
    "fn late -> i64 { SECOND } impl i64 { fn choose self:i64 -> fn[-> i64] { self drop &late } } global FIRST { 1 .choose exec } global SECOND 2"
    parse_resolve_snippet
    diagnostics "method callable return forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_default_method_callable_argument_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_default_method_callable_argument_forward_read_errors" test::test_start
    diagnostics
    "fn late -> i64 { SECOND } trait Apply { fn apply self:self callback:fn[-> i64] -> i64 { self drop callback exec } } impl i64: Apply { } global FIRST { &late 1 .apply } global SECOND 2"
    parse_resolve_snippet
    diagnostics "default method callable argument forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_global_default_method_callable_return_forward_read_errors {
    error::Diagnostics::new = diagnostics
    "global_default_method_callable_return_forward_read_errors" test::test_start
    diagnostics
    "fn late -> i64 { SECOND } trait Pick[T] { fn choose self:self -> T { self drop &late } } impl i64: Pick[fn[-> i64]] { } global FIRST { 1 .choose exec } global SECOND 2"
    parse_resolve_snippet
    diagnostics "default method callable return forward read error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

pub fn test_local_cannot_shadow_immutable_global {
    error::Diagnostics::new = diagnostics
    "local_cannot_shadow_immutable_global" test::test_start
    diagnostics "global LIMIT 1\nfn invalid { 2 = LIMIT }\n" parse_resolve_snippet
    diagnostics "local shadow error" common::ErrorKind::InvalidVariable helpers::assert_error_kind
}

# ============================================================================
# Error: `global` in a lambda is an error
# ============================================================================

pub fn test_global_in_lambda_errors {
    error::Diagnostics::new = diagnostics
    "global_in_lambda_errors" test::test_start
    diagnostics "0 = X\nfn foo {\n    { global X\n    1 = X } exec\n}\n" parse_snippet
    diagnostics "has error for global in lambda" helpers::assert_has_errors
}

# ============================================================================
# Error: `global X` after body statements is an error
# ============================================================================

pub fn test_global_after_body_errors {
    error::Diagnostics::new = diagnostics
    "global_after_body_errors" test::test_start
    diagnostics "0 = X\nfn foo {\n    0 = local_var\n    global X\n}\n" parse_snippet
    diagnostics "has error for global after body" helpers::assert_has_errors
}

# ============================================================================
# Error: `global NONEXISTENT` produces an error (nonexistent global)
# ============================================================================

pub fn test_global_nonexistent_errors {
    error::Diagnostics::new = diagnostics
    "global_nonexistent_errors" test::test_start
    diagnostics "fn foo {\n    global NONEXISTENT\n    0 = NONEXISTENT\n}\nfoo\n" parse_resolve_typecheck
    diagnostics "has error for nonexistent global" helpers::assert_has_errors
}

# ============================================================================
# Isolation: lib fn with `= value` compiles cleanly when user has global value
# ============================================================================

pub fn test_isolation_no_type_error {
    error::Diagnostics::new = diagnostics
    "isolation_no_type_error" test::test_start
    diagnostics "\"hello\" = value\nfn process_value {\n    42 = value\n    value 1 + drop\n}\nprocess_value\n" parse_resolve_typecheck
    diagnostics "no type mismatch after fix" helpers::assert_no_errors
}

