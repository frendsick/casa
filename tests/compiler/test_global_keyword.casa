import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

# ============================================================================
# Helpers
# ============================================================================

pub fn parse_snippet code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_source drop
}

pub fn parse_resolve_snippet code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_source drop
}

pub fn parse_resolve_typecheck code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test drop
}

# ============================================================================
# Parse: `global X` in a function body produces no errors
# ============================================================================

pub fn test_global_decl_parses {
    error::Diagnostics::new = diagnostics
    "global_decl_parses" test::test_start
    diagnostics "0 = LOG_LEVEL\nfn set_level level:i64 {\n    global LOG_LEVEL\n    level = LOG_LEVEL\n}\n" parse_snippet
    diagnostics "no parse errors" helpers::assert_no_errors
}

# ============================================================================
# Resolve: `global X` in a function resolves without errors
# ============================================================================

pub fn test_global_decl_resolves {
    error::Diagnostics::new = diagnostics
    "global_decl_resolves" test::test_start
    diagnostics "0 = LOG_LEVEL\nfn set_level level:i64 {\n    global LOG_LEVEL\n    level = LOG_LEVEL\n}\n" parse_resolve_snippet
    diagnostics "no resolve errors" helpers::assert_no_errors
}

# ============================================================================
# Error: `global` at top level is INVALID_SCOPE
# ============================================================================

pub fn test_global_at_top_level_errors {
    error::Diagnostics::new = diagnostics
    "global_at_top_level_errors" test::test_start
    diagnostics "0 = X\nglobal X\n" parse_snippet
    diagnostics "has INVALID_SCOPE error" common::ErrorKind::InvalidScope helpers::assert_error_kind
}

# ============================================================================
# Error: `global` in a lambda is an error
# ============================================================================

pub fn test_global_in_lambda_errors {
    error::Diagnostics::new = diagnostics
    "global_in_lambda_errors" test::test_start
    diagnostics "0 = X\nfn foo {\n    { global X\n    1 = X } exec\n}\n" parse_snippet
    diagnostics "has error for global in lambda" helpers::assert_has_errors
}

# ============================================================================
# Error: `global X` after body statements is an error
# ============================================================================

pub fn test_global_after_body_errors {
    error::Diagnostics::new = diagnostics
    "global_after_body_errors" test::test_start
    diagnostics "0 = X\nfn foo {\n    0 = local_var\n    global X\n}\n" parse_snippet
    diagnostics "has error for global after body" helpers::assert_has_errors
}

# ============================================================================
# Error: `global NONEXISTENT` produces an error (nonexistent global)
# ============================================================================

pub fn test_global_nonexistent_errors {
    error::Diagnostics::new = diagnostics
    "global_nonexistent_errors" test::test_start
    diagnostics "fn foo {\n    global NONEXISTENT\n    0 = NONEXISTENT\n}\nfoo\n" parse_resolve_typecheck
    diagnostics "has error for nonexistent global" helpers::assert_has_errors
}

# ============================================================================
# Isolation: lib fn with `= value` compiles cleanly when user has global value
# ============================================================================

pub fn test_isolation_no_type_error {
    error::Diagnostics::new = diagnostics
    "isolation_no_type_error" test::test_start
    diagnostics "\"hello\" = value\nfn process_value {\n    42 = value\n    value 1 + drop\n}\nprocess_value\n" parse_resolve_typecheck
    diagnostics "no type mismatch after fix" helpers::assert_no_errors
}

# ============================================================================
# Run all tests
# ============================================================================
test_global_decl_parses
test_global_decl_resolves
test_global_at_top_level_errors
test_global_in_lambda_errors
test_global_after_body_errors
test_global_nonexistent_errors
test_isolation_no_type_error
test::test_summary
