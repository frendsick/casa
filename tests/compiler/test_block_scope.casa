import "../../compiler/common.casa" as common
import "../../compiler/block_scope.casa" as block_scope
import "../../lib/std.casa" as std
import "../../lib/test.casa" as test

pub fn test_binding_lifetimes {
    "binding_lifetimes" test::test_start
    block_scope::BlockScope::new = scope
    common::TypePool::new = types
    false "outer" scope.assign
    "new binding has unknown type" types "outer" scope
        .lookup
        .unwrap
        .is_unknown test::assert_true
    types common::make_i64_type "outer" scope.set_type drop

    scope.enter
    false "inner" scope.assign
    types common::make_str_type "inner" scope.set_type drop
    types "outer" scope.lookup.unwrap = outer_type
    types "inner" scope.lookup.unwrap = inner_type
    "outer type" "i64" outer_type.format test::assert_str_eq
    "inner type" "str" inner_type.format test::assert_str_eq
    scope.exit

    types "outer" scope.lookup.unwrap = accessible_outer_type
    "outer remains accessible" "i64" accessible_outer_type.format test::assert_str_eq
    "inner expires" "inner" scope.is_expired test::assert_true
}

pub fn test_binding_policy {
    "binding_policy" test::test_start
    block_scope::BlockScope::new = scope
    common::TypePool::new = types
    false "outer" scope.assign
    scope.enter
    "local shadow rejected" "outer" scope.bind ! test::assert_true
    "global spelling allowed" "global_name" scope.bind test::assert_true

    false "local" scope.assign
    types common::make_i64_type "local" scope.set_type drop
    scope.exit
    scope.enter
    false "local" scope.assign
    types common::make_str_type "local" scope.set_type drop
    types "local" scope.lookup.unwrap = sibling_type
    "sibling type independent" "str" sibling_type.format test::assert_str_eq
}

pub fn test_snapshot_is_independent {
    "snapshot_is_independent" test::test_start
    block_scope::BlockScope::new = scope
    common::TypePool::new = types
    false "outer" scope.assign
    types common::make_i64_type "outer" scope.set_type drop
    scope.enter
    false "inner" scope.assign
    types common::make_str_type "inner" scope.set_type drop
    scope.snapshot = snapshot

    types common::make_bool_type "outer" scope.set_type drop
    scope.exit
    types "outer" snapshot.lookup.unwrap = snapshot_outer_type
    types "inner" snapshot.lookup.unwrap = snapshot_inner_type
    "snapshot keeps function type" "i64" snapshot_outer_type.format test::assert_str_eq
    "snapshot keeps active frame" "str" snapshot_inner_type.format test::assert_str_eq
}

pub fn test_type_identities {
    "type_identities" test::test_start
    common::TypePool::new = types
    "array[i64 2]" common::parse_type_str = first_type
    first_type types.intern = first
    "same structural type reuses its identity" first first_type.clone types.intern test::assert_eq
    "constant bindings distinguish identities"
    "array[i64 3]" common::parse_type_str types.intern first != test::assert_true

    "fn[i64 -> str]" common::parse_type_str types.intern = callable
    "function return types distinguish identities"
    "fn[i64 -> bool]" common::parse_type_str types.intern callable != test::assert_true

    "fixture names have equal hashes" "Ab" std::str_hash "BA" std::str_hash test::assert_eq
    "Ab" common::parse_type_str types.intern = first_collision
    "BA" common::parse_type_str types.intern = second_collision
    "hash collisions do not alias types" first_collision second_collision != test::assert_true
    "collision keeps first type" "Ab" first_collision types.get.format test::assert_str_eq
    "collision keeps second type" "BA" second_collision types.get.format test::assert_str_eq

    common::TypePool::new = snapshot
    first_type snapshot.intern = snapshot_first
    types drop
    "independent pool owns its types" "array[i64 2]" snapshot_first snapshot.get.format test::assert_str_eq
}
test_binding_lifetimes
test_binding_policy
test_snapshot_is_independent
test_type_identities
test::test_summary
