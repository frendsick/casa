import "../../compiler/block_scope.casa"
import "../../lib/test.casa"

fn test_binding_lifetimes {
    "binding_lifetimes" test_start
    BlockScope::new = scope
    false "outer" scope.assign
    TYPE_I64_T "outer" scope.set_type drop

    scope.enter
    false "inner" scope.assign
    TYPE_STR_T "inner" scope.set_type drop
    "outer" scope.lookup.unwrap = outer_type
    "inner" scope.lookup.unwrap = inner_type
    "outer type" "i64" outer_type.format assert_str_eq
    "inner type" "str" inner_type.format assert_str_eq
    scope.exit

    "outer" scope.lookup.unwrap = accessible_outer_type
    "outer remains accessible" "i64" accessible_outer_type.format assert_str_eq
    "inner expires" "inner" scope.is_expired assert_true
}

fn test_binding_policy {
    "binding_policy" test_start
    BlockScope::new = scope
    false "outer" scope.assign
    scope.enter
    "local shadow rejected" "outer" scope.bind ! assert_true
    "global spelling allowed" "global_name" scope.bind assert_true

    false "local" scope.assign
    TYPE_I64_T "local" scope.set_type drop
    scope.exit
    scope.enter
    false "local" scope.assign
    TYPE_STR_T "local" scope.set_type drop
    "local" scope.lookup.unwrap = sibling_type
    "sibling type independent" "str" sibling_type.format assert_str_eq
}

fn test_snapshot_is_independent {
    "snapshot_is_independent" test_start
    BlockScope::new = scope
    false "outer" scope.assign
    TYPE_I64_T "outer" scope.set_type drop
    scope.enter
    false "inner" scope.assign
    TYPE_STR_T "inner" scope.set_type drop
    scope.snapshot = snapshot

    TYPE_BOOL_T "outer" scope.set_type drop
    scope.exit
    "outer" snapshot.lookup.unwrap = snapshot_outer_type
    "inner" snapshot.lookup.unwrap = snapshot_inner_type
    "snapshot keeps function type" "i64" snapshot_outer_type.format assert_str_eq
    "snapshot keeps active frame" "str" snapshot_inner_type.format assert_str_eq
}
test_binding_lifetimes
test_binding_policy
test_snapshot_is_independent
test_summary
