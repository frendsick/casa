import "std" as std
import "../../lib/test.casa" as test
import "fixtures/field_replacement.casa" as field_replacement
import "helpers.casa" as helpers

pub const DESTRUCTION_LOG_SIZE 64
pub const DESTRUCTION_INDEX_SIZE 8
pub const RECURSIVE_OWNER_DEPTH 128

# Exceeds the return-stack depth of call-recursive destruction.
pub const DEEP_RECURSIVE_OWNER_DEPTH 1000000

pub struct Resource {
    pub id:    i64
    pub log:   ptr
    pub index: ptr
}

impl Resource {
    pub fn drop self:mut$Resource {
        unsafe { self.id u64::try_from.unwrap self.log self.index load64 8 * + store64 }
        unsafe { self.index load64 1 + self.index store64 }
    }
}

pub struct Wrapper {
    pub child: Resource
    pub log:   ptr
    pub index: ptr
}

pub struct ResourcePair {
    pub kept:    Resource
    pub omitted: Resource
}

pub struct ResourceBox[T] {
    pub value: T
}

pub struct ConcreteGenericHolder {
    pub value: ResourceBox[Resource]
}

pub struct LoggedBox[T] {
    pub value: T
    pub log:   ptr
    pub index: ptr
}

impl[T] LoggedBox[T] {
    pub fn drop self:mut$LoggedBox[T] {
        unsafe { 9 self.log self.index load64 8 * + store64 }
        unsafe { self.index load64 1 + self.index store64 }
    }
}

pub fn implicit_box_cleanup box:ResourceBox[LoggedBox[Resource]] {}

pub fn explicit_box_cleanup box:ResourceBox[LoggedBox[Resource]] { box drop }

pub fn test_shared_cleanup_dependencies {
    "shared_cleanup_dependencies" test::test_start
    32 std::RawBuffer::new = log
    8 std::RawBuffer::new = index
    index.data reset
    LoggedBox {
        value: index.data log.data 31 resource
        log: log.data
        index: index.data
    } ResourceBox implicit_box_cleanup
    LoggedBox {
        value: index.data log.data 32 resource
        log: log.data
        index: index.data
    } ResourceBox explicit_box_cleanup
    unsafe { "both sites retain hook and field cleanup" 4 index.data load64 test::assert_eq }
    log.data 0 9 assert_entry
    log.data 1 31 assert_entry
    log.data 2 9 assert_entry
    log.data 3 32 assert_entry
}

pub enum CopyTag derives std::Eq std::Copy {
    First
    Second
}

pub struct PlainFields {
    pub count: i64
    pub tag:   CopyTag
    pub value: $i64
}

pub enum ResourceTree {
    Leaf(Resource)
    Branch(Resource ResourceTree ResourceTree)
}

pub enum ResourceChoice {
    Selected(Resource)
    Other(Resource)
}

pub struct ResourceNode {
    pub item: Resource
    pub next: std::Option[ResourceNode]
}

pub struct ResourceLeft {
    pub item: Resource
    pub next: std::Option[ResourceRight]
}

pub struct ResourceRight {
    pub next: std::Option[ResourceLeft]
    pub item: Resource
}

pub struct ResourceFanout {
    pub item:     Resource
    pub children: array[std::Option[ResourceFanout] 2]
}

pub struct ResourceHolder {
    pub item:  Resource
    pub inner: ResourceInner
}

pub struct ResourceInner {
    pub next: std::Option[ResourceHolder]
    pub item: Resource
}

pub struct CleanupNode {
    pub id:    i64
    pub log:   ptr
    pub index: ptr
    pub next:  std::Option[CleanupNode]
}

impl CleanupNode {
    pub fn drop self:mut$CleanupNode {
        unsafe { self.id u64::try_from.unwrap self.log self.index load64 8 * + store64 }
        unsafe { self.index load64 1 + self.index store64 }
        self.index self.log self.id 100 + resource ResourceTree::Leaf drop
    }
}

pub enum CountedChain {
    End
    Link(SpecializedResource[i64] CountedChain)
}

pub enum CountedTree {
    Leaf(SpecializedResource[i64])
    Branch(SpecializedResource[i64] CountedTree CountedTree)
}

pub struct SpecializedResource[T] {
    pub value: T
    pub count: ptr
}

impl SpecializedResource[i64] {
    pub fn drop self:mut$SpecializedResource[i64] {
        unsafe { self.count load64 1 + self.count store64 }
    }
}

impl Wrapper {
    pub fn drop self:mut$Wrapper {
        unsafe { 9 self.log self.index load64 8 * + store64 }
        unsafe { self.index load64 1 + self.index store64 }
    }
}

pub fn resource id:i64 log:ptr index:ptr -> Resource {
    Resource { id: id log: log index: index }
}

pub fn assert_entry expected:i64 position:u64 log:ptr {
    unsafe { "destruction order" expected log position 8 * + load64 i64::try_from.unwrap test::assert_eq }
}

pub fn reset index:ptr {
    unsafe { 0 index store64 }
}

pub fn scope_cleanup log:ptr index:ptr {
    index log 1 resource = first
    index log 2 resource = second
}

pub fn early_cleanup log:ptr index:ptr {
    index log 3 resource = first
    index log 4 resource = second
    return
}

pub fn break_cleanup log:ptr index:ptr {
    while true do
        index log 5 resource = item
        break
    done
}

pub fn continue_cleanup log:ptr index:ptr {
    false = finished
    while finished ! do
        index log 6 resource = item
        true = finished
        continue
    done
}

pub fn parameter_cleanup item:Resource {}

pub fn drop_generic[T] item:T { item drop }

pub fn return_cleanup log:ptr index:ptr -> Resource {
    index log 7 resource = item
    item
}

pub fn replacement_cleanup log:ptr index:ptr {
    index log 8 resource = item
    index log 9 resource = item
}

pub fn loop_replacement_cleanup log:ptr index:ptr {
    index log 1 resource = outer
    0 = iteration
    while 3 iteration > do
        index log iteration 2 * 2 + resource = outer
        index log iteration 2 * 3 + resource = local
        1 += iteration
    done
}

pub fn test_loop_replacement_cleanup {
    "loop_replacement_cleanup" test::test_start
    DESTRUCTION_LOG_SIZE std::RawBuffer::new = log
    DESTRUCTION_INDEX_SIZE std::RawBuffer::new = index
    index.data reset
    index.data log.data loop_replacement_cleanup
    unsafe { "loop destroys seven owners once" 7 index.data load64 test::assert_eq }
    log.data 0 1 assert_entry
    log.data 1 3 assert_entry
    log.data 2 2 assert_entry
    log.data 3 5 assert_entry
    log.data 4 4 assert_entry
    log.data 5 7 assert_entry
    log.data 6 6 assert_entry
}

pub fn test_explicit_drop_and_field_order {
    "explicit_drop_and_field_order" test::test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    Wrapper {
        child: index log 1 resource
        log: log
        index: index
    } drop

    unsafe { "hook and child count" 2 index load64 test::assert_eq }
    log 0 9 assert_entry
    log 1 1 assert_entry
}

pub fn test_scope_return_break_and_replacement_cleanup {
    "scope_return_break_and_replacement_cleanup" test::test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }

    index reset
    index log scope_cleanup
    unsafe { "scope count" 2 index load64 test::assert_eq }
    log 0 2 assert_entry
    log 1 1 assert_entry

    index reset
    index log early_cleanup
    unsafe { "return count" 2 index load64 test::assert_eq }
    log 0 4 assert_entry
    log 1 3 assert_entry

    index reset
    index log break_cleanup
    unsafe { "break count" 1 index load64 test::assert_eq }
    log 0 5 assert_entry

    index reset
    index log continue_cleanup
    unsafe { "continue count" 1 index load64 test::assert_eq }
    log 0 6 assert_entry

    index reset
    index log 7 resource parameter_cleanup
    unsafe { "parameter count" 1 index load64 test::assert_eq }
    log 0 7 assert_entry

    index reset
    index log return_cleanup drop
    unsafe { "return owner count" 1 index load64 test::assert_eq }
    log 0 7 assert_entry

    index reset
    index log replacement_cleanup
    unsafe { "replacement count" 2 index load64 test::assert_eq }
    log 0 8 assert_entry
    log 1 9 assert_entry
}

pub fn test_pattern_omission_cleanup {
    "pattern_omission_cleanup" test::test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    ResourcePair {
        kept: index log 8 resource
        omitted: index log 9 resource
    } match
        ResourcePair { kept: kept } => {
            kept drop
        }
    end

    unsafe { "pattern count" 2 index load64 test::assert_eq }
    log 0 9 assert_entry
    log 1 8 assert_entry
}

pub fn consume_resource_choice choice:ResourceChoice {
    if choice ResourceChoice::Selected(item) is then
        item drop
    fi
}

pub fn consume_temporary_resource_choice selected:bool log:ptr index:ptr {
    if selected then
        if index log 12 resource ResourceChoice::Selected ResourceChoice::Selected(item) is then
            item drop
        fi
    else
        if index log 13 resource ResourceChoice::Other ResourceChoice::Selected(item) is then
            item drop
        fi
    fi
}

pub fn test_if_is_conditional_cleanup {
    "if_is_conditional_cleanup" test::test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }

    index reset
    index log 10 resource ResourceChoice::Selected consume_resource_choice
    unsafe { "matched owner count" 1 index load64 test::assert_eq }
    log 0 10 assert_entry

    index reset
    index log 11 resource ResourceChoice::Other consume_resource_choice
    unsafe { "unmatched owner count" 1 index load64 test::assert_eq }
    log 0 11 assert_entry

    index reset
    index log true consume_temporary_resource_choice
    unsafe { "matched temporary count" 1 index load64 test::assert_eq }
    log 0 12 assert_entry

    index reset
    index log false consume_temporary_resource_choice
    unsafe { "unmatched temporary count" 1 index load64 test::assert_eq }
    log 0 13 assert_entry
}

pub fn test_generic_cleanup {
    "generic_cleanup" test::test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    index log 10 resource drop_generic

    unsafe { "generic count" 1 index load64 test::assert_eq }
    log 0 10 assert_entry
}

pub fn test_concrete_generic_drop_hook {
    "concrete_generic_drop_hook" test::test_start
    unsafe { DESTRUCTION_INDEX_SIZE alloc = count }
    unsafe { 0 count store64 }
    SpecializedResource { value: 1 count: count } drop
    unsafe { "concrete drop hook count" 1 count load64 test::assert_eq }
}

pub fn test_owned_field_replacement_destroys_displaced_values {
    "owned_field_replacement_destroys_displaced_values" test::test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    index log 2 resource index log 1 resource ResourcePair = pair
    index log 3 resource = pair.kept
    unsafe { "replacement destroys old field" 1 index load64 test::assert_eq }
    log 0 1 assert_entry
    pair drop
    unsafe { "replacement remains owned" 3 index load64 test::assert_eq }
    log 1 2 assert_entry
    log 2 3 assert_entry

    index log 4 resource ResourceBox ConcreteGenericHolder = nested
    index log 5 resource ResourceBox = nested.value
    unsafe { "nested generic replacement" 4 index load64 test::assert_eq }
    log 3 4 assert_entry
    nested drop
    unsafe { "nested generic final owner" 5 index load64 test::assert_eq }
    log 4 5 assert_entry

    index log 6 resource field_replacement::Holder = imported
    index log 7 resource = imported.value
    unsafe { "imported replacement" 6 index load64 test::assert_eq }
    log 5 6 assert_entry
    imported drop
    unsafe { "imported final owner" 7 index load64 test::assert_eq }
    log 6 7 assert_entry
}

struct InlineValue {
    value: u16
    flag:  bool
}

struct MixedFields {
    first:  Resource
    inline: InlineValue
    last:   Resource
}

impl MixedFields {
    fn drop self:mut$MixedFields {
        unsafe {
            self.inline.value u64::from self.first.log self.first.index load64 8 * + store64
            self.first.index load64 1 + self.first.index store64
        }
    }
}

pub fn test_inline_fields_preserve_cleanup_order {
    "inline_fields_preserve_cleanup_order" test::test_start
    64 std::RawBuffer::new = log
    8 std::RawBuffer::new = index
    index.data reset
    MixedFields {
        first: index.data log.data 1 resource
        inline: InlineValue { value: 9 flag: true }
        last: index.data log.data 2 resource
    } = owner
    false 8 InlineValue = owner.inline
    index.data log.data 3 resource = owner.last
    unsafe { "replacement cleanup runs once" 1 index.data load64 test::assert_eq }
    log.data 0 2 assert_entry
    owner drop
    unsafe { "hook and reverse fields run once" 4 index.data load64 test::assert_eq }
    log.data 1 8 assert_entry
    log.data 2 3 assert_entry
    log.data 3 1 assert_entry
}

pub fn test_plain_field_replacement_keeps_existing_behavior {
    "plain_field_replacement_keeps_existing_behavior" test::test_start
    1 = first
    2 = second
    first CopyTag::First 10 PlainFields = fields

    20 = fields.count
    CopyTag::Second = fields.tag
    second = fields.value

    "scalar field" 20 fields.count test::assert_eq
    "Copy field" CopyTag::Second fields.tag == test::assert_true
    "borrowed field" 2 fields.value test::assert_eq
}

pub fn test_recursive_owner_cleanup {
    "recursive_owner_cleanup" test::test_start
    unsafe { RECURSIVE_OWNER_DEPTH u64::try_from.unwrap size_of[u64] * alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    index log 2 resource ResourceTree::Leaf = left
    index log 3 resource ResourceTree::Leaf = right
    right left index log 1 resource ResourceTree::Branch drop

    unsafe { "recursive owner count" 3 index load64 test::assert_eq }
    log 0 3 assert_entry
    log 1 2 assert_entry
    log 2 1 assert_entry

    index reset
    std::Option[ResourceNode]::None = next
    0 = depth
    while depth RECURSIVE_OWNER_DEPTH < do
        next index log depth resource ResourceNode std::Option::Some = next
        1 += depth
    done
    next drop

    unsafe { "deep recursive owner count" RECURSIVE_OWNER_DEPTH index load64 test::assert_eq }
    RECURSIVE_OWNER_DEPTH 1 - = last_id
    last_id u64::try_from.unwrap = last_position
    log 0 0 assert_entry
    log last_position last_id assert_entry
}

pub fn fanout_leaf id:i64 log:ptr index:ptr -> std::Option[ResourceFanout] {
    std::Option[ResourceFanout]::None = first
    std::Option[ResourceFanout]::None = second
    [first, second] index log id resource ResourceFanout std::Option::Some
}

pub fn test_recursive_layouts_keep_cleanup_order {
    "recursive_layouts_keep_cleanup_order" test::test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }

    # Mutually recursive structs keep each struct's reverse field order.
    index reset
    std::Option[ResourceRight]::None = no_right
    no_right index log 3 resource ResourceLeft std::Option::Some = left
    index log 2 resource left ResourceRight std::Option::Some = right
    right index log 1 resource ResourceLeft drop
    unsafe { "mutual recursion count" 3 index load64 test::assert_eq }
    log 0 2 assert_entry
    log 1 3 assert_entry
    log 2 1 assert_entry

    # Array elements in a cycle are destroyed in reverse index order.
    index reset
    index log 5 fanout_leaf = fifth
    index log 4 fanout_leaf = fourth
    [fourth, fifth] index log 2 resource ResourceFanout std::Option::Some = second
    index log 3 fanout_leaf = third
    [second, third] index log 1 resource ResourceFanout drop
    unsafe { "array cycle count" 5 index load64 test::assert_eq }
    log 0 3 assert_entry
    log 1 5 assert_entry
    log 2 4 assert_entry
    log 3 2 assert_entry
    log 4 1 assert_entry

    # An inline field can be a cycle member.
    index reset
    std::Option[ResourceHolder]::None = no_holder
    index log 4 resource no_holder ResourceInner = deepest
    deepest index log 3 resource ResourceHolder std::Option::Some = holder
    index log 2 resource holder ResourceInner = inner
    inner index log 1 resource ResourceHolder drop
    unsafe { "inline cycle count" 4 index load64 test::assert_eq }
    log 0 2 assert_entry
    log 1 4 assert_entry
    log 2 3 assert_entry
    log 3 1 assert_entry

    # Destruction that a cleanup method starts finishes before the method returns.
    index reset
    std::Option[CleanupNode]::None = no_node
    no_node index log 2 CleanupNode std::Option::Some = node
    node index log 1 CleanupNode drop
    unsafe { "cleanup method count" 4 index load64 test::assert_eq }
    log 0 1 assert_entry
    log 1 101 assert_entry
    log 2 2 assert_entry
    log 3 102 assert_entry
}

pub fn deep_counted_chain count:ptr -> CountedChain {
    CountedChain::End = chain
    0 = depth
    while depth DEEP_RECURSIVE_OWNER_DEPTH < do
        chain count 7 SpecializedResource CountedChain::Link = chain
        1 += depth
    done
    chain
}

pub fn deep_scope_cleanup count:ptr { count deep_counted_chain = chain }

pub fn test_deep_recursive_owner_cleanup {
    "deep_recursive_owner_cleanup" test::test_start
    unsafe { DESTRUCTION_INDEX_SIZE alloc = count }

    count reset
    count deep_scope_cleanup
    unsafe { "deep scope exit count" DEEP_RECURSIVE_OWNER_DEPTH count load64 test::assert_eq }

    count reset
    count deep_counted_chain drop
    unsafe { "deep explicit drop count" DEEP_RECURSIVE_OWNER_DEPTH count load64 test::assert_eq }

    # A deep left spine also destroys every right leaf.
    count reset
    count 0 SpecializedResource CountedTree::Leaf = tree
    0 = depth
    while depth DEEP_RECURSIVE_OWNER_DEPTH < do
        count 0 SpecializedResource CountedTree::Leaf tree count 0 SpecializedResource CountedTree::Branch = tree
        1 += depth
    done
    tree drop
    DEEP_RECURSIVE_OWNER_DEPTH 2 * 1 + u64::try_from.unwrap = tree_count
    unsafe { "deep branching count" tree_count count load64 test::assert_eq }
}

pub fn array_literal_cleanup log:ptr index:ptr {
    index log 1 resource = first
    index log 2 resource = second
    [first, second] = owned: array[Resource 2]
}

pub fn generic_array_cleanup[const N:u64] owned:array[Resource N] {}

pub fn test_array_literal_owns_its_elements {
    "array_literal_owns_its_elements" test::test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    index log array_literal_cleanup

    # Each element is destroyed exactly once: moving into the literal ends the
    # element bindings, so only the array destroys them.
    unsafe { "array element count" 2 index load64 test::assert_eq }
    log 0 2 assert_entry
    log 1 1 assert_entry
}

pub fn test_generic_array_owns_its_elements {
    "generic_array_owns_its_elements" test::test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    index log 1 resource = first
    index log 2 resource = second
    [first, second] generic_array_cleanup

    unsafe { "generic array element count" 2 index load64 test::assert_eq }
    log 0 2 assert_entry
    log 1 1 assert_entry
}

# Reads every element through the borrowed receiver. `nth` and `iter` both
# hand out borrows, so the array stays the only owner and no hook runs here.
pub fn read_borrowed_elements items:$array[Resource 2] -> i64 {
    0 = total: i64
    0 items.nth.id += total
    for item in items.iter do
        item.id += total
    done
    total
}

pub fn borrowed_element_cleanup log:ptr index:ptr -> i64 {
    index log 1 resource = first
    index log 2 resource = second
    [first, second] = owned: array[Resource 2]
    owned read_borrowed_elements = total
    unsafe { "no hook during borrowed access" 0 index load64 test::assert_eq }
    total
}

pub fn test_borrowed_element_access_runs_drop_once {
    "borrowed_element_access_runs_drop_once" test::test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    index log borrowed_element_cleanup = total
    "borrowed element sum" 4 total test::assert_eq

    # The array destroys each element exactly once after the reads.
    unsafe { "borrowed element count" 2 index load64 test::assert_eq }
    log 0 2 assert_entry
    log 1 1 assert_entry
}

pub fn update_borrowed_pattern pair:mut$ResourcePair {
    pair match
        ResourcePair { kept: kept } => 10 = kept.id
    end
}

pub fn test_borrowed_pattern_keeps_owner {
    "borrowed_pattern_keeps_owner" test::test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    ResourcePair {
        kept: index log 8 resource
        omitted: index log 9 resource
    } = pair
    pair update_borrowed_pattern

    unsafe { "borrowed pattern count" 0 index load64 test::assert_eq }
    pair drop
    unsafe { "borrowed pattern final count" 2 index load64 test::assert_eq }
    log 0 9 assert_entry
    log 1 10 assert_entry
}

# Both exits transfer the result before destroying the remaining local owners.
pub fn return_branch_owner log:ptr index:ptr early:bool -> Resource {
    index log 1 resource = outer
    if early then
        index log 2 resource = local
        index log 3 resource = result
        result return
    else
        index log 4 resource = local
    fi
    index log 5 resource
}

pub fn return_match_owner log:ptr index:ptr tag:CopyTag -> Resource {
    index log 6 resource = outer
    tag match
        CopyTag::First => {
            index log 7 resource = local
            index log 8 resource = result
            result
        }
        CopyTag::Second => {
            index log 9 resource = local
            index log 10 resource = result
            result
        }
    end
}

pub fn test_branch_result_cleanup_order {
    "branch_result_cleanup_order" test::test_start
    DESTRUCTION_LOG_SIZE std::RawBuffer::new = log
    DESTRUCTION_INDEX_SIZE std::RawBuffer::new = index

    index.data reset
    true index.data log.data return_branch_owner = early
    unsafe { "early return cleans two locals" 2 index.data load64 test::assert_eq }
    log.data 0 2 assert_entry
    log.data 1 1 assert_entry
    early drop
    unsafe { "early result destroyed once" 3 index.data load64 test::assert_eq }
    log.data 2 3 assert_entry

    index.data reset
    false index.data log.data return_branch_owner = continued
    unsafe { "continuing branch cleans two locals" 2 index.data load64 test::assert_eq }
    log.data 0 4 assert_entry
    log.data 1 1 assert_entry
    continued drop
    unsafe { "continuing result destroyed once" 3 index.data load64 test::assert_eq }
    log.data 2 5 assert_entry

    index.data reset
    CopyTag::First index.data log.data return_match_owner = first
    unsafe { "first arm cleans two locals" 2 index.data load64 test::assert_eq }
    log.data 0 7 assert_entry
    log.data 1 6 assert_entry
    first drop
    unsafe { "first result destroyed once" 3 index.data load64 test::assert_eq }
    log.data 2 8 assert_entry

    index.data reset
    CopyTag::Second index.data log.data return_match_owner = second
    unsafe { "second arm cleans two locals" 2 index.data load64 test::assert_eq }
    log.data 0 9 assert_entry
    log.data 1 6 assert_entry
    second drop
    unsafe { "second result destroyed once" 3 index.data load64 test::assert_eq }
    log.data 2 10 assert_entry
}

pub fn run_tests {
    test_loop_replacement_cleanup
    test_branch_result_cleanup_order
    test_explicit_drop_and_field_order
    test_scope_return_break_and_replacement_cleanup
    test_pattern_omission_cleanup
    test_if_is_conditional_cleanup
    test_generic_cleanup
    test_concrete_generic_drop_hook
    test_shared_cleanup_dependencies
    test_owned_field_replacement_destroys_displaced_values
    test_inline_fields_preserve_cleanup_order
    test_plain_field_replacement_keeps_existing_behavior
    test_recursive_owner_cleanup
    test_recursive_layouts_keep_cleanup_order
    test_deep_recursive_owner_cleanup
    test_array_literal_owns_its_elements
    test_generic_array_owns_its_elements
    test_borrowed_pattern_keeps_owner
    test_borrowed_element_access_runs_drop_once
    test::test_summary
}
run_tests
