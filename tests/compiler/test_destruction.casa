import "std"
import "helpers.casa"

const DESTRUCTION_LOG_SIZE 64
const DESTRUCTION_INDEX_SIZE 8

struct Resource {
    id:    i64
    log:   ptr
    index: ptr
}

impl Resource {
    fn drop self:mut$Resource {
        unsafe { self.id (u64) self.log self.index load64 8 * + store64 }
        unsafe { self.index load64 1 + self.index store64 }
    }
}

struct Wrapper {
    child: Resource
    log:   ptr
    index: ptr
}

struct ResourcePair {
    kept:    Resource
    omitted: Resource
}

impl Wrapper {
    fn drop self:mut$Wrapper {
        unsafe { 9 self.log self.index load64 8 * + store64 }
        unsafe { self.index load64 1 + self.index store64 }
    }
}

fn resource id:i64 log:ptr index:ptr -> Resource {
    Resource { id: id log: log index: index }
}

fn assert_entry expected:i64 position:u64 log:ptr {
    unsafe { "destruction order" expected log position 8 * + load64 (i64) assert_eq }
}

fn reset index:ptr {
    unsafe { 0 index store64 }
}

fn scope_cleanup log:ptr index:ptr {
    index log 1 resource = first
    index log 2 resource = second
}

fn early_cleanup log:ptr index:ptr {
    index log 3 resource = first
    index log 4 resource = second
    return
}

fn break_cleanup log:ptr index:ptr {
    while true do
        index log 5 resource = item
        break
    done
}

fn continue_cleanup log:ptr index:ptr {
    false = finished
    while finished ! do
        index log 6 resource = item
        true = finished
        continue
    done
}

fn parameter_cleanup item:Resource { }

fn generic_cleanup [T] item:T { item drop }

fn return_cleanup log:ptr index:ptr -> Resource {
    index log 7 resource = item
    item
}

fn replacement_cleanup log:ptr index:ptr {
    index log 8 resource = item
    index log 9 resource = item
}

fn test_explicit_drop_and_field_order {
    "explicit_drop_and_field_order" test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    Wrapper {
        child: index log 1 resource
        log: log
        index: index
    } drop

    unsafe { "hook and child count" 2 index load64 assert_eq }
    log 0 9 assert_entry
    log 1 1 assert_entry
}

fn test_scope_return_break_and_replacement_cleanup {
    "scope_return_break_and_replacement_cleanup" test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }

    index reset
    index log scope_cleanup
    unsafe { "scope count" 2 index load64 assert_eq }
    log 0 2 assert_entry
    log 1 1 assert_entry

    index reset
    index log early_cleanup
    unsafe { "return count" 2 index load64 assert_eq }
    log 0 4 assert_entry
    log 1 3 assert_entry

    index reset
    index log break_cleanup
    unsafe { "break count" 1 index load64 assert_eq }
    log 0 5 assert_entry

    index reset
    index log continue_cleanup
    unsafe { "continue count" 1 index load64 assert_eq }
    log 0 6 assert_entry

    index reset
    index log 7 resource parameter_cleanup
    unsafe { "parameter count" 1 index load64 assert_eq }
    log 0 7 assert_entry

    index reset
    index log return_cleanup drop
    unsafe { "return owner count" 1 index load64 assert_eq }
    log 0 7 assert_entry

    index reset
    index log replacement_cleanup
    unsafe { "replacement count" 2 index load64 assert_eq }
    log 0 8 assert_entry
    log 1 9 assert_entry
}

fn test_pattern_omission_cleanup {
    "pattern_omission_cleanup" test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    ResourcePair {
        kept: index log 8 resource
        omitted: index log 9 resource
    } match
        ResourcePair { kept: kept } => {
            kept drop
        }
    end

    unsafe { "pattern count" 2 index load64 assert_eq }
    log 0 9 assert_entry
    log 1 8 assert_entry
}

fn test_generic_cleanup {
    "generic_cleanup" test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    index log 10 resource generic_cleanup

    unsafe { "generic count" 1 index load64 assert_eq }
    log 0 10 assert_entry
}

fn array_literal_cleanup log:ptr index:ptr {
    index log 1 resource = first
    index log 2 resource = second
    [first, second] = owned: array[Resource 2]
}

fn generic_array_cleanup [const N:u64] owned:array[Resource N] { }

fn test_array_literal_owns_its_elements {
    "array_literal_owns_its_elements" test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    index log array_literal_cleanup

    # Each element is destroyed exactly once: moving into the literal ends the
    # element bindings, so only the array destroys them.
    unsafe { "array element count" 2 index load64 assert_eq }
    log 0 2 assert_entry
    log 1 1 assert_entry
}

fn test_generic_array_owns_its_elements {
    "generic_array_owns_its_elements" test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    index log 1 resource = first
    index log 2 resource = second
    [first, second] generic_array_cleanup

    unsafe { "generic array element count" 2 index load64 assert_eq }
    log 0 2 assert_entry
    log 1 1 assert_entry
}
# Reads every element through the borrowed receiver. `nth` and `iter` both
# hand out borrows, so the array stays the only owner and no hook runs here.

fn read_borrowed_elements items:$array[Resource 2] -> i64 {
    0 (i64) = total
    0 items.nth.id += total
    for item in items.iter do
        item.id += total
    done
    total
}

fn borrowed_element_cleanup log:ptr index:ptr -> i64 {
    index log 1 resource = first
    index log 2 resource = second
    [first, second] = owned: array[Resource 2]
    owned read_borrowed_elements = total
    unsafe { "no hook during borrowed access" 0 index load64 assert_eq }
    total
}

fn test_borrowed_element_access_runs_drop_once {
    "borrowed_element_access_runs_drop_once" test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    index log borrowed_element_cleanup = total
    "borrowed element sum" 4 total assert_eq

    # The array destroys each element exactly once after the reads.
    unsafe { "borrowed element count" 2 index load64 assert_eq }
    log 0 2 assert_entry
    log 1 1 assert_entry
}

fn update_borrowed_pattern pair:mut$ResourcePair {
    pair match
        ResourcePair { kept: kept } => 10 = kept.id
    end
}

fn test_borrowed_pattern_keeps_owner {
    "borrowed_pattern_keeps_owner" test_start
    unsafe { DESTRUCTION_LOG_SIZE alloc = log }
    unsafe { DESTRUCTION_INDEX_SIZE alloc = index }
    index reset

    ResourcePair {
        kept: index log 8 resource
        omitted: index log 9 resource
    } = pair
    pair update_borrowed_pattern

    unsafe { "borrowed pattern count" 0 index load64 assert_eq }
    pair drop
    unsafe { "borrowed pattern final count" 2 index load64 assert_eq }
    log 0 9 assert_entry
    log 1 10 assert_entry
}
test_explicit_drop_and_field_order
test_scope_return_break_and_replacement_cleanup
test_pattern_omission_cleanup
test_generic_cleanup
test_array_literal_owns_its_elements
test_generic_array_owns_its_elements
test_borrowed_pattern_keeps_owner
test_borrowed_element_access_runs_drop_once
test_summary
