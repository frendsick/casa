import "std"
import "../../lib/test.casa"

const HEAP_PROBE_SIZE 497
const STRESS_ITERATION_COUNT 1000

fn convert_character_to_i64 character:char -> i64 { character.codepoint i64::from }

fn exhaust_string_iterator {
    for character in "abc".iter do
        character drop
    done
}

fn test_string_iterator_storage_is_bounded {
    "string_iterator_storage_is_bounded" test_start
    exhaust_string_iterator
    # This otherwise-unused exact small-allocation bin makes marker addresses track heap growth.
    unsafe { HEAP_PROBE_SIZE alloc = first_marker }

    0 (u64) = iteration
    while iteration STRESS_ITERATION_COUNT > do
        exhaust_string_iterator
        1 += iteration
    done

    unsafe { HEAP_PROBE_SIZE alloc = second_marker }
    unsafe { HEAP_PROBE_SIZE alloc = third_marker }
    unsafe {
        third_marker (u64) second_marker (u64) - = unstressed_growth
        second_marker (u64) first_marker (u64) - = stressed_growth
        "repeated iteration keeps heap growth bounded"
        stressed_growth unstressed_growth == assert_true
        first_marker free
        second_marker free
        third_marker free
    }
}

fn test_string_iteration_behavior {
    "string_iteration_behavior" test_start
    "abc".iter = characters
    "direct first" 'a' characters.next.unwrap assert_eq
    "direct second" 'b' characters.next.unwrap assert_eq
    "direct third" 'c' characters.next.unwrap assert_eq
    "direct exhausted" characters.next.is_none assert_true

    0 = codepoint_sum
    for character in "abc".iter do
        character convert_character_to_i64 += codepoint_sum
    done
    'a' convert_character_to_i64
    'b' convert_character_to_i64 +
    'c' convert_character_to_i64 + = expected_sum
    "for loop" expected_sum codepoint_sum assert_eq

    &convert_character_to_i64 "abc"
        .iter
        .map
        .collect = codepoints: List[i64]
    "combinator length" 3 codepoints.length assert_eq
    "combinator first" 'a' convert_character_to_i64 0 codepoints.get copy assert_eq
    "combinator last" 'c' convert_character_to_i64 2 codepoints.get copy assert_eq

    "ä😀".iter = unicode_characters
    "Unicode first" 'ä' unicode_characters.next.unwrap assert_eq
    "Unicode second" '😀' unicode_characters.next.unwrap assert_eq
    "Unicode exhausted" unicode_characters.next.is_none assert_true
}
test_string_iterator_storage_is_bounded
test_string_iteration_behavior
test_summary
