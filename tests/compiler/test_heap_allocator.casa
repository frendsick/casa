import "std" as std
import "../../lib/test.casa" as test

pub fn test_large_block_splitting_and_coalescing {
    "large_block_splitting_and_coalescing" test::test_start
    unsafe {
        4096 alloc = original
        original 1032 + = expected_large_remainder
        original 4088 + = expected_small_remainder
        original free
        1024 alloc = first
        3064 alloc = second
        "split reuses the original block" original first == test::assert_true
        "split remainder is reusable" expected_large_remainder second == test::assert_true
        17 first 1016 + store64
        29 second 3056 + store64
        "split allocations do not overlap" 17 first 1016 + load64 test::assert_eq
        second free
        first free
        4096 alloc = restored
        "free merges with the next block" original restored == test::assert_true
        restored free

        1024 alloc = left
        1024 alloc = middle
        1024 alloc = right
        1000 alloc = guard
        43 guard store64
        left free
        right free
        middle free
        3088 alloc = merged
        "free merges both neighbors" original merged == test::assert_true
        59 merged 3080 + store64
        "coalescing preserves live neighbors" 43 guard load64 test::assert_eq
        merged free
        guard free

        4080 alloc = large
        8 alloc = small
        "minimum remainder uses its small bin" expected_small_remainder small == test::assert_true
        71 large 4072 + store64
        83 small store64
        "small remainder does not overlap" 71 large 4072 + load64 test::assert_eq
        large free
        small free

        8192 alloc = almost
        almost free
        8184 alloc = unsplit
        "header-only remainder stays in the allocation" almost unsplit == test::assert_true
        unsplit free
        8192 alloc = whole
        "unsplit block retains its capacity" almost whole == test::assert_true
        whole free
    }
}
test_large_block_splitting_and_coalescing
test::test_summary
