import "std" as std
import "../../lib/test.casa" as test

pub fn test_large_block_splitting_and_coalescing {
    "large_block_splitting_and_coalescing" test::test_start
    unsafe {
        4096 alloc = original
        original 1032 + = expected_large_remainder
        original 3576 + = expected_minimum_remainder
        original free
        1024 alloc = first
        3064 alloc = second
        "split reuses the original block" original first == test::assert_true
        "split remainder is reusable" expected_large_remainder second == test::assert_true
        17 first 1016 + store64
        29 second 3056 + store64
        "split allocations do not overlap" 17 first 1016 + load64 test::assert_eq
        second free
        first free
        4096 alloc = restored
        "free merges with the next block" original restored == test::assert_true
        restored free

        1024 alloc = left
        1024 alloc = middle
        1024 alloc = right
        1000 alloc = guard
        43 guard store64
        left free
        right free
        middle free
        3088 alloc = merged
        "free merges both neighbors" original merged == test::assert_true
        59 merged 3080 + store64
        "coalescing preserves live neighbors" 43 guard load64 test::assert_eq
        merged free
        guard free

        3576 alloc = almost_whole
        "small-size remainder stays in the allocation" original almost_whole == test::assert_true
        almost_whole free
        # The separator keeps the next free block from merging with the original.
        4096 alloc = separator
        "small-size remainder keeps the block capacity" original separator == test::assert_true

        8192 alloc = almost
        almost free
        8184 alloc = unsplit
        "header-only remainder stays in the allocation" almost unsplit == test::assert_true
        unsplit free
        8192 alloc = whole
        "unsplit block retains its capacity" almost whole == test::assert_true
        whole free
        separator free

        3568 alloc = large
        520 alloc = minimum_remainder
        "minimum large remainder is reusable" expected_minimum_remainder minimum_remainder == test::assert_true
        71 large 3560 + store64
        83 minimum_remainder store64
        "minimum large remainder does not overlap" 71 large 3560 + load64 test::assert_eq
        minimum_remainder free
        large free
    }
}

pub fn test_small_block_reuse_stays_local {
    "small_block_reuse_stays_local" test::test_start
    unsafe {
        # The blocks span several small pages.
        6000 = count: u64
        count 2 / = half
        count 8 * alloc = blocks
        for index in count 0 std::Range::new do
            16 alloc blocks index 8 * + ptr::write[ptr]
        done
        # Alternate between the halves so the last freed blocks are far apart.
        for index in half 0 std::Range::new do
            blocks index 8 * + ptr::read[ptr] free
            blocks index half + 8 * + ptr::read[ptr] free
        done

        100 = reused_count: u64
        for index in reused_count 0 std::Range::new do
            16 alloc blocks index 8 * + ptr::write[ptr]
        done
        blocks load64 = lowest
        lowest = highest
        for index in reused_count 0 std::Range::new do
            blocks index 8 * + load64 = address
            if address lowest < then
                address = lowest
            fi
            if address highest > then
                address = highest
            fi
        done
        # Reuse takes freed blocks from one 64 KiB small page.
        "reused small blocks stay within one page" highest lowest - 65536 < test::assert_true
        for index in reused_count 0 std::Range::new do
            blocks index 8 * + ptr::read[ptr] free
        done
        blocks free
    }
}
test_large_block_splitting_and_coalescing
test_small_block_reuse_stays_local
test::test_summary
