# Compiler-specific test helpers.
#
# Wraps compiler globals (TEST_MODE, ERRORS, WARNINGS, SOURCE_CACHE)
# so test files can toggle test mode, inspect diagnostics, and reset
# state between test cases.
#
# Usage:
#   enable_test_mode
#   clear_global_state
#   "some source" parse_resolve_test_source = result
#   1 "expected one error" assert_error_count
#   "msg" "should contain msg" assert_error_contains
import "../../compiler/common.casa"
import "../../compiler/error.casa"
import "../../compiler/lexer.casa"
import "../../compiler/syntax.casa"
import "../../lib/test.casa"

Diagnostics::new = LAST_PARSE_DIAGNOSTICS
Diagnostics::new = LAST_TYPECHECK_DIAGNOSTICS

fn enable_test_mode {
    global TEST_MODE
    true = TEST_MODE
}

fn disable_test_mode {
    global TEST_MODE
    false = TEST_MODE
}

fn clear_errors {
    global ERRORS
    global LAST_TYPECHECK_DIAGNOSTICS
    List::new(List[CasaError]) = ERRORS
    Diagnostics::new = LAST_TYPECHECK_DIAGNOSTICS
}

fn clear_warnings {
    global WARNINGS
    List::new(List[CasaWarning]) = WARNINGS
}

fn assert_has_errors message:str {
    message LAST_TYPECHECK_DIAGNOSTICS.has_errors LAST_PARSE_DIAGNOSTICS.has_errors || 0 ERRORS.length != || assert_true
}

fn assert_no_errors message:str {
    message LAST_TYPECHECK_DIAGNOSTICS.has_errors ! LAST_PARSE_DIAGNOSTICS.has_errors ! && 0 ERRORS.length == && assert_true
}

fn assert_error_count expected:int message:str {
    0 = parse_error_count
    for diagnostic in LAST_PARSE_DIAGNOSTICS.entries.iter do
        if diagnostic Diagnostic::Error(_) is then 1 += parse_error_count fi
    done
    message expected ERRORS.length parse_error_count + LAST_TYPECHECK_DIAGNOSTICS.error_count + assert_eq
}

fn assert_error_contains needle:str message:str {
    false = error_found
    for error in ERRORS.iter do
        error CasaError::message = error_message
        error_message needle str::find = match_pos
        if 0 match_pos >= then
            true = error_found
        fi
    done
    if needle LAST_PARSE_DIAGNOSTICS diagnostics_error_contains then true = error_found fi
    if needle LAST_TYPECHECK_DIAGNOSTICS diagnostics_error_contains then true = error_found fi
    message error_found assert_true
}

fn assert_error_kind expected_kind:ErrorKind message:str {
    false = kind_found
    for error in ERRORS.iter do
        if expected_kind error CasaError::kind == then
            true = kind_found
        fi
    done
    if expected_kind LAST_PARSE_DIAGNOSTICS diagnostics_has_error_kind then true = kind_found fi
    if expected_kind LAST_TYPECHECK_DIAGNOSTICS diagnostics_has_error_kind then true = kind_found fi
    message kind_found assert_true
}

fn typecheck_error_contains needle:str -> bool {
    needle LAST_TYPECHECK_DIAGNOSTICS diagnostics_error_contains
}

fn diagnostics_error_contains diagnostics:Diagnostics needle:str -> bool {
    for diagnostic in diagnostics.entries.iter do
        if diagnostic Diagnostic::Error(error) is then
            if 0 error.message needle str::find >= then true return fi
        fi
    done
    false
}

fn diagnostics_has_error_kind diagnostics:Diagnostics expected_kind:ErrorKind -> bool {
    for diagnostic in diagnostics.entries.iter do
        if diagnostic Diagnostic::Error(error) is then
            if expected_kind error.kind == then true return fi
        fi
    done
    false
}

fn assert_warning_count expected:int message:str {
    message expected WARNINGS.length assert_eq
}

fn clear_global_state {
    global SOURCE_CACHE
    global ERRORS
    global WARNINGS
    global LAST_PARSE_DIAGNOSTICS
    global LAST_TYPECHECK_DIAGNOSTICS
    Map::new(Map[str str]) = SOURCE_CACHE
    List::new(List[CasaError]) = ERRORS
    List::new(List[CasaWarning]) = WARNINGS
    Diagnostics::new = LAST_PARSE_DIAGNOSTICS
    Diagnostics::new = LAST_TYPECHECK_DIAGNOSTICS
}

fn type_check_ops_for_test
    ops:List[Op]
    function_opt:Option[Function]
    store:SymbolStore
-> StackEffect {
    global LAST_TYPECHECK_DIAGNOSTICS
    Diagnostics::new = LAST_TYPECHECK_DIAGNOSTICS
    LAST_TYPECHECK_DIAGNOSTICS store function_opt ops check_ops
}

fn type_check_functions_for_test store:SymbolStore {
    global LAST_TYPECHECK_DIAGNOSTICS
    LAST_TYPECHECK_DIAGNOSTICS store check_functions
}

fn type_satisfies_trait_for_test
    type_name:Type
    trait_name:str
    function_opt:Option[Function]
    store:SymbolStore
-> bool {
    global LAST_TYPECHECK_DIAGNOSTICS
    Diagnostics::new = LAST_TYPECHECK_DIAGNOSTICS
    LAST_TYPECHECK_DIAGNOSTICS store function_opt trait_name type_name type_satisfies_trait
}

fn parse_resolve_test_source code:str -> ParseResolveResult {
    global LAST_PARSE_DIAGNOSTICS
    "test" code lex_source = lex_result
    lex_result.tokens = tokens
    SourceStore::new lex_result.diagnostics List::new(List[str]) tokens parse_and_resolve = result
    result.diagnostics = LAST_PARSE_DIAGNOSTICS
    result
}
