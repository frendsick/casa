# Compiler-specific test helpers.
#
# Threads diagnostics through direct parser and typechecker unit-test calls.
#
# Usage:
#   Diagnostics::new = diagnostics
#   diagnostics "some source" parse_resolve_test_source = result
#   diagnostics "expected one error" 1 assert_error_count
#   diagnostics "should contain msg" "msg" assert_error_contains
import "../../compiler/common.casa"
import "../../compiler/error.casa"
import "../../compiler/lexer.casa"
import "../../compiler/syntax.casa"
import "../../compiler/bytecode.casa"
import "../../lib/test.casa"

fn compile_test_program ops:$List[Op] store:$SymbolStore -> Program {
    ops store compile_bytecode.unwrap
}

fn assert_has_errors [M:Display] message:$M diagnostics:$Diagnostics {
    message diagnostics.has_errors assert_true
}

fn assert_no_errors [M:Display] message:$M diagnostics:$Diagnostics {
    message diagnostics.has_errors ! assert_true
}

fn assert_error_count [M:Display] expected:u64 message:$M diagnostics:$Diagnostics {
    message expected diagnostics.error_count == assert_true
}

fn assert_error_contains [M:Display] needle:$str message:$M diagnostics:$Diagnostics {
    message needle diagnostics diagnostics_error_contains assert_true
}

fn assert_error_kind [M:Display] expected_kind:ErrorKind message:$M diagnostics:$Diagnostics {
    message expected_kind diagnostics diagnostics_has_error_kind assert_true
}

fn typecheck_error_contains needle:$str diagnostics:$Diagnostics -> bool {
    needle diagnostics diagnostics_error_contains
}

fn diagnostics_error_contains diagnostics:$Diagnostics needle:$str -> bool {
    for diagnostic in diagnostics.entries.iter do
        if diagnostic Diagnostic::Error(error) is then
            if 0 error.message.as_str needle str::find >= then
                true return
            fi
            if error.expected Option::Some(expected) is then
                if 0 expected.as_str needle str::find >= then
                    true return
                fi
            fi
            if error.got Option::Some(got) is then
                if 0 got.as_str needle str::find >= then
                    true return
                fi
            fi
        fi
    done
    false
}

fn diagnostics_has_error_kind diagnostics:$Diagnostics expected_kind:ErrorKind -> bool {
    for diagnostic in diagnostics.entries.iter do
        if diagnostic Diagnostic::Error(error) is then
            if expected_kind error.kind == then
                true return
            fi
        fi
    done
    false
}

fn type_check_ops_for_test
    ops:mut$List[Op]
    function_opt:$Option[Function]
    store:$SymbolStore
    diagnostics:mut$Diagnostics
-> StackEffect {
    function_opt.clone = mutable_function_opt
    store.clone_for_selective_import = mutable_store
    diagnostics mutable_store mutable_function_opt ops check_ops
}

fn type_check_functions_for_test store:mut$SymbolStore diagnostics:mut$Diagnostics {
    diagnostics store check_functions
}

fn type_satisfies_trait_for_test
    type_name:$Type
    trait_name:$str
    function_opt:$Option[Function]
    store:$SymbolStore
    diagnostics:mut$Diagnostics
-> bool {
    function_opt.clone = mutable_function_opt
    store.clone_for_selective_import = mutable_store
    diagnostics mutable_store mutable_function_opt trait_name parse_type_str type_name
    type_satisfies_trait
}

fn parse_resolve_test_source code:$str diagnostics:mut$Diagnostics -> ParseResolveResult {
    "test" code.clone lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    SourceStore::new lex_diagnostics List[String]::new tokens parse_and_resolve = result
    result.diagnostics.clone diagnostics.merge
    result
}

fn parse_resolve_test_parts code:$str diagnostics:mut$Diagnostics -> List[Op] SymbolStore {
    diagnostics code parse_resolve_test_source = result
    result.into_parts = parse_diagnostics = store = ops
    parse_diagnostics drop
    ops.unwrap
    store
}

fn typecheck_test_source code:$str diagnostics:mut$Diagnostics -> TypecheckResult {
    diagnostics code parse_resolve_test_parts = store = ops
    store ops type_check
}
