# Compiler-specific test helpers.
#
# Threads diagnostics through direct parser and typechecker unit-test calls.
#
# Usage:
#   Diagnostics::new = diagnostics
#   diagnostics "some source" parse_resolve_test_source = result
#   diagnostics "expected one error" 1 assert_error_count
#   diagnostics "should contain msg" "msg" assert_error_contains
import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../compiler/syntax.casa" as syntax
import "../../compiler/bytecode.casa" as bytecode
import "../../compiler/typechecker.casa" as typechecker
import "../../lib/test.casa" as test

pub fn compile_test_program
    ops:$std::List[common::Op]
    store:$common::SymbolStore
-> common::Program {
    store.clone_for_typecheck = checked_store
    ops common::clone_ops = checked_ops
    error::Diagnostics::new
    checked_ops
    common::empty_stack_effect
    checked_store
    typechecker::TypecheckResult = result
    result bytecode::compile_typechecked.unwrap
}

pub fn assert_has_errors [M:std::Display] message:$M diagnostics:$error::Diagnostics {
    message diagnostics.has_errors test::assert_true
}

pub fn assert_no_errors [M:std::Display] message:$M diagnostics:$error::Diagnostics {
    message diagnostics.has_errors ! test::assert_true
}

pub fn assert_error_count [M:std::Display] expected:u64 message:$M diagnostics:$error::Diagnostics {
    message expected diagnostics.error_count == test::assert_true
}

pub fn assert_error_contains[M:std::Display]
    needle:$str
    message:$M
    diagnostics:$error::Diagnostics
{
    message needle diagnostics diagnostics_error_contains test::assert_true
}

pub fn assert_error_kind[M:std::Display]
    expected_kind:common::ErrorKind
    message:$M
    diagnostics:$error::Diagnostics
{
    message expected_kind diagnostics diagnostics_has_error_kind test::assert_true
}

pub fn typecheck_error_contains needle:$str diagnostics:$error::Diagnostics -> bool {
    needle diagnostics diagnostics_error_contains
}

pub fn diagnostics_error_contains diagnostics:$error::Diagnostics needle:$str -> bool {
    for diagnostic in diagnostics.entries.iter do
        if diagnostic error::Diagnostic::Error(error) is then
            if 0 error.message.as_str needle str::find >= then
                true return
            fi
            if error.expected std::Option::Some(expected) is then
                if 0 expected.as_str needle str::find >= then
                    true return
                fi
            fi
            if error.got std::Option::Some(got) is then
                if 0 got.as_str needle str::find >= then
                    true return
                fi
            fi
        fi
    done
    false
}

pub fn diagnostics_has_error_kind
    diagnostics:$error::Diagnostics
    expected_kind:common::ErrorKind
-> bool {
    for diagnostic in diagnostics.entries.iter do
        if diagnostic error::Diagnostic::Error(error) is then
            if expected_kind error.kind == then
                true return
            fi
        fi
    done
    false
}

pub fn store_has_function_suffix store:$common::SymbolStore suffix:$str -> bool {
    store.get_function_names = names
    for name in names.iter do
        if name.as_str suffix str::ends_with then
            true return
        fi
    done
    false
}

pub fn store_function_suffix_is_resolved store:$common::SymbolStore suffix:$str -> bool {
    store.get_function_names = names
    for name in names.iter do
        if name.as_str suffix str::ends_with then
            name.as_str store
                .get_function
                .unwrap
                .is_resolved return
        fi
    done
    false
}

pub fn store_has_global_suffix store:$common::SymbolStore suffix:$str -> bool {
    for name in store.immutable_globals.iter do
        if name.as_str suffix str::ends_with then
            true return
        fi
    done
    false
}

pub fn type_check_ops_for_test
    ops:mut$std::List[common::Op]
    function_opt:$std::Option[common::Function]
    store:$common::SymbolStore
    diagnostics:mut$error::Diagnostics
-> common::StackEffect {
    function_opt.clone = mutable_function_opt
    store.clone_for_typecheck = mutable_store
    diagnostics mutable_store mutable_function_opt ops typechecker::check_ops
}

pub fn type_check_functions_for_test
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
{
    diagnostics store typechecker::check_functions
}

pub fn type_satisfies_trait_for_test
    type_name:$common::Type
    trait_name:$str
    function_opt:$std::Option[common::Function]
    store:$common::SymbolStore
    diagnostics:mut$error::Diagnostics
-> bool {
    function_opt.clone = mutable_function_opt
    store.clone_for_typecheck = mutable_store
    diagnostics mutable_store mutable_function_opt trait_name common::parse_type_str type_name
    typechecker::type_satisfies_trait
}

pub fn parse_resolve_test_source
    code:$str
    diagnostics:mut$error::Diagnostics
-> syntax::ParseResolveResult {
    "test" code.clone lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    lexer::SourceStore::new = sources
    code "test" sources.add
    sources lex_diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve = result
    result.diagnostics.clone diagnostics.merge
    result
}

pub fn parse_resolve_test_parts
    code:$str
    diagnostics:mut$error::Diagnostics
-> std::List[common::Op] common::SymbolStore {
    diagnostics code parse_resolve_test_source = result
    result.into_parts = parse_diagnostics = store = ops
    parse_diagnostics drop
    ops.unwrap
    store
}

pub fn typecheck_test_source
    code:$str
    diagnostics:mut$error::Diagnostics
-> typechecker::TypecheckResult {
    diagnostics code parse_resolve_test_parts = store = ops
    store ops typechecker::type_check
}
