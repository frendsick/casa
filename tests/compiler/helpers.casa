# Compiler-specific test helpers.
#
# Threads diagnostics through direct parser and typechecker unit-test calls.
#
# Usage:
#   Diagnostics::new = diagnostics
#   diagnostics "some source" parse_resolve_test_source = result
#   diagnostics "expected one error" 1 assert_error_count
#   diagnostics "should contain msg" "msg" assert_error_contains
import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../compiler/source_builder.casa" as syntax
import "../../compiler/products.casa" as products
import "../../compiler/typechecker.casa" as typechecker
import "../../compiler/source_body.casa" as source_body
import "../../lib/test.casa" as test

# End-to-end tests enter through the same product as the CLI.
pub fn compile_test_source code:$str diagnostics:mut$error::Diagnostics -> std::String {
    "" lexer::absolute_normalize_path = base
    code.to_str "test.casa".to_str products::SourceUnit base swap products::CompilationInput::new
    products::Target::LinuxX86_64 swap products::assembly.unwrap = result
    result
        .get_report
        .get_diagnostics
        .clone diagnostics.merge
    result match
        products::AssemblyResult::Produced(_ assembly) => assembly.get_text.clone
        products::AssemblyResult::Rejected(_) => "Expected valid assembly in test" panic
    end
}

pub fn assert_has_errors [M:std::Display] message:$M diagnostics:$error::Diagnostics {
    message diagnostics.has_errors test::assert_true
}

pub fn assert_no_errors [M:std::Display] message:$M diagnostics:$error::Diagnostics {
    message diagnostics.has_errors ! test::assert_true
}

pub fn assert_error_count [M:std::Display] expected:u64 message:$M diagnostics:$error::Diagnostics {
    message expected diagnostics.error_count == test::assert_true
}

pub fn assert_error_contains[M:std::Display]
    needle:$str
    message:$M
    diagnostics:$error::Diagnostics
{
    message needle diagnostics diagnostics_error_contains test::assert_true
}

pub fn assert_error_not_contains[M:std::Display]
    needle:$str
    message:$M
    diagnostics:$error::Diagnostics
{
    message needle diagnostics diagnostics_error_contains ! test::assert_true
}

pub fn assert_error_note_count[M:std::Display]
    expected:u64
    message:$M
    diagnostics:$error::Diagnostics
{
    for diagnostic in diagnostics.entries.iter do
        if diagnostic error::Diagnostic::Error(error) is then
            message expected error.notes.length == test::assert_true
            return
        fi
    done
    message false test::assert_true
}

pub fn assert_error_note_contains[M:std::Display]
    needle:$str
    message:$M
    diagnostics:$error::Diagnostics
{
    for diagnostic in diagnostics.entries.iter do
        if diagnostic error::Diagnostic::Error(error) is then
            for note in error.notes.iter do
                if 0 note.message.as_str needle str::find <= then
                    message true test::assert_true
                    return
                fi
            done
        fi
    done
    message false test::assert_true
}

fn error_note_location
    diagnostics:$error::Diagnostics
    needle:$str
-> std::Option[common::Location] {
    for diagnostic in diagnostics.entries.iter do
        if diagnostic error::Diagnostic::Error(error) is then
            for note in error.notes.iter do
                if 0 note.message.as_str needle str::find <= then
                    note.location.clone std::Option::Some return
                fi
            done
        fi
    done
    std::Option[common::Location]::None
}

pub fn assert_error_note_before[M:std::Display]
    limit:u64
    needle:$str
    message:$M
    diagnostics:$error::Diagnostics
{
    if needle diagnostics error_note_location std::Option::Some(location) is then
        message limit location.span.offset > test::assert_true
        return
    fi
    message false test::assert_true
}

pub fn assert_error_note_after[M:std::Display]
    limit:u64
    needle:$str
    message:$M
    diagnostics:$error::Diagnostics
{
    if needle diagnostics error_note_location std::Option::Some(location) is then
        message limit location.span.offset < test::assert_true
        return
    fi
    message false test::assert_true
}

pub fn assert_error_kind[M:std::Display]
    expected_kind:common::ErrorKind
    message:$M
    diagnostics:$error::Diagnostics
{
    message expected_kind diagnostics diagnostics_has_error_kind test::assert_true
}

pub fn typecheck_error_contains needle:$str diagnostics:$error::Diagnostics -> bool {
    needle diagnostics diagnostics_error_contains
}

pub fn diagnostics_error_contains diagnostics:$error::Diagnostics needle:$str -> bool {
    for diagnostic in diagnostics.entries.iter do
        if diagnostic error::Diagnostic::Error(error) is then
            if 0 error.message.as_str needle str::find <= then
                true return
            fi
            if error.expected std::Option::Some(expected) is then
                if 0 expected.as_str needle str::find <= then
                    true return
                fi
            fi
            if error.got std::Option::Some(got) is then
                if 0 got.as_str needle str::find <= then
                    true return
                fi
            fi
        fi
    done
    false
}

pub fn diagnostics_has_error_kind
    diagnostics:$error::Diagnostics
    expected_kind:common::ErrorKind
-> bool {
    for diagnostic in diagnostics.entries.iter do
        if diagnostic error::Diagnostic::Error(error) is then
            if expected_kind error.kind swap == then
                true return
            fi
        fi
    done
    false
}

pub fn store_has_function_suffix store:$common::SymbolStore suffix:$str -> bool {
    store.get_function_names = names
    for name in names.iter do
        if name.as_str suffix str::ends_with then
            true return
        fi
    done
    false
}

pub fn type_check_ops_for_test
    ops:mut$std::List[common::Op]
    function_opt:$std::Option[common::Function]
    store:$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    source_bodies:$std::Map[std::String source_body::SourceBody]
-> common::StackEffect {
    function_opt.clone = mutable_function_opt
    store.clone_for_typecheck = mutable_store
    false source_bodies diagnostics mutable_store mutable_function_opt ops typechecker::check_ops
}

pub fn type_satisfies_trait_for_test
    type_name:$common::Type
    trait_name:$str
    function_opt:$std::Option[common::Function]
    store:$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    source_bodies:$std::Map[std::String source_body::SourceBody]
-> bool {
    function_opt.clone = mutable_function_opt
    store.clone_for_typecheck = mutable_store
    source_bodies diagnostics mutable_store mutable_function_opt trait_name common::parse_type_str type_name
    typechecker::type_satisfies_trait
}

# Parser unit tests inspect an owned projection of resolved source, never checked work state.
pub struct ParsedTestSource {
    pub ops:           std::Option[std::List[common::Op]]
    pub store:         common::SymbolStore
    pub source_bodies: std::Map[std::String source_body::SourceBody]
    pub diagnostics:   error::Diagnostics
}

impl ParsedTestSource {
    pub fn into_parts
        self:ParsedTestSource
    -> std::Option[std::List[common::Op]] common::SymbolStore std::Map[std::String source_body::SourceBody] error::Diagnostics {
        self match
            ParsedTestSource { ops: ops store: store source_bodies: bodies diagnostics: diagnostics } => ops store bodies diagnostics
        end
    }
}

pub fn project_test_source parsed:syntax::ParseResolveResult -> ParsedTestSource {
    parsed.into_parts = diagnostics = source
    source match
        std::Option::Some(program) => {
            program.into_parts = bodies = root = store
            diagnostics bodies store root.lower_operations std::Option::Some ParsedTestSource
        }
        std::Option::None => diagnostics std::Map[std::String source_body::SourceBody]::new common::symbol_store_new std::Option[std::List[common::Op]]::None ParsedTestSource
    end
}

pub fn type_check_parts
    operations:std::List[common::Op]
    store:common::SymbolStore
    source_bodies:std::Map[std::String source_body::SourceBody]
-> typechecker::TypecheckResult {
    source_bodies operations source_body::consume_source_body store
    source_body::SourceProgram::new typechecker::type_check
}

pub fn parse_resolve_test_source code:$str diagnostics:mut$error::Diagnostics -> ParsedTestSource {
    "test" code.clone lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    lexer::SourceStore::new = sources
    code "test" sources.add
    sources lex_diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve project_test_source = result
    result.diagnostics.clone diagnostics.merge
    result
}

pub fn parse_resolve_test_parts
    code:$str
    diagnostics:mut$error::Diagnostics
-> std::List[common::Op] common::SymbolStore std::Map[std::String source_body::SourceBody] {
    diagnostics code parse_resolve_test_source = result
    result.into_parts = parse_diagnostics = source_bodies = store = ops
    parse_diagnostics drop
    ops.unwrap
    store
    source_bodies
}

pub fn typecheck_test_source
    code:$str
    diagnostics:mut$error::Diagnostics
-> typechecker::TypecheckResult {
    "test" code.clone lexer::lex_source.into_parts = lex_diagnostics = tokens
    lexer::SourceStore::new = sources
    code "test" sources.add
    sources lex_diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve.into_parts
    = parse_diagnostics = source
    parse_diagnostics.clone diagnostics.merge
    source.unwrap typechecker::type_check = checked
    parse_diagnostics checked.with_source_diagnostics = checked
    checked
}

# Assertions about selected code must not match the always-included runtime.
pub fn generated_assembly assembly:$std::String -> std::String {
    assembly.as_str ".equ CASA_RETURN_STACK_SIZE," str::find u64::try_from.unwrap = length
    assembly.as_str 0 length str::substring
}
