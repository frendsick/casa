import "std" as std
import "../../lib/test.casa" as test

struct Counter {
    value: i64
}

fn increment counter:mut$Counter { 1 += counter.value }

fn decrement counter:mut$Counter { 1 -= counter.value }

fn set_counter counter:mut$Counter value:i64 { value = counter.value }

fn local_value -> i64 {
    99 = value
    value
}
0 Counter = counter
counter increment
counter increment
"explicit state increments" 2 counter.value test::assert_eq
counter decrement
"explicit state decrements" 1 counter.value test::assert_eq
42 counter set_counter
"explicit state assignment" 42 counter.value test::assert_eq
42 = value
"named function local" 99 local_value test::assert_eq
"root local unchanged" 42 value test::assert_eq
[1, 2, 3, 4, 5, 6, 7, 8, 9] = numbers: array[u8 9]
77 = after_array
"root scalar after inline array" 77 after_array test::assert_eq
"root array retained" 9 8 numbers.nth.clone u64::from test::assert_eq
test::test_summary
