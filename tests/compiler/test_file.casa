import "../../lib/std.casa" as std
import "../../lib/os.casa" as os

pub fn fe_fail message:$str {
    f"FAIL: {message}\n".as_str std::eprint
    1 std::exit
}

pub fn fe_assert_true condition:bool message:$str {
    if condition ! then
        message fe_fail
    fi
}

pub fn fe_assert_false condition:bool message:$str {
    if condition then
        message fe_fail
    fi
}

pub fn run_file_tests {
    # file::exists returns true for an existing file
    "contents" std::Bytes::from_str "/tmp/casa_file_exists_test.txt".as_cstr.unwrap file::write_all drop
    "existing path" "/tmp/casa_file_exists_test.txt".as_cstr.unwrap file::exists fe_assert_true
    "/tmp/casa_file_exists_test.txt".as_cstr.unwrap file::remove drop
    # file::exists returns false for a missing path (no process abort)
    "missing path" "/tmp/casa_file_exists_definitely_not_a_real_path.xyz".as_cstr.unwrap file::exists fe_assert_false
    # file::read_all returns Ok with the file content
    "hello world" std::Bytes::from_str "/tmp/casa_read_all_ok.txt".as_cstr.unwrap file::write_all drop
    "/tmp/casa_read_all_ok.txt".as_cstr.unwrap file::read_all = read_ok_result
    "read_all ok on existing" read_ok_result.is_ok fe_assert_true
    "read_all content matches" "hello world" read_ok_result
        .unwrap
        .to_str
        .unwrap
        .as_str str::eq fe_assert_true
    "/tmp/casa_read_all_ok.txt".as_cstr.unwrap file::remove drop
    # file::read_all returns Error(NotFound) for a missing file
    "/tmp/casa_read_all_definitely_not_a_real_path.xyz".as_cstr.unwrap file::read_all = read_missing_result
    "read_all error on missing" read_missing_result.is_error fe_assert_true
    "read_all error is NotFound" "not found" read_missing_result
        .unwrap_error
        .to_str
        .as_str str::eq fe_assert_true
    # Raw file bytes remain available even when they are not valid UTF-8.
    std::Bytes::new = raw_content
    0 raw_content.push
    255 raw_content.push
    raw_content "/tmp/casa_read_all_invalid_utf8.bin".as_cstr.unwrap file::write_all.unwrap drop
    "/tmp/casa_read_all_invalid_utf8.bin".as_cstr.unwrap file::read_all.unwrap = raw_bytes
    "raw byte length" 2 raw_bytes.length == fe_assert_true
    "raw NUL value" 0 0 raw_bytes.get.unwrap == fe_assert_true
    "raw non-UTF-8 value" 255 1 raw_bytes.get.unwrap == fe_assert_true
    "raw bytes reject invalid UTF-8" raw_bytes.to_str.is_error fe_assert_true
    "/tmp/casa_read_all_invalid_utf8.bin".as_cstr.unwrap file::remove drop
    # Large byte buffers exercise write completion across the full content.
    std::Bytes::new = large_content
    0 = large_index: u64
    while large_index 98305 > do
        large_index 251 % u8::try_from.unwrap large_content.push
        1 += large_index
    done
    "large byte fixture length" 98305 large_content.length == fe_assert_true
    large_content "/tmp/casa_write_all_large.bin".as_cstr.unwrap file::write_all.unwrap drop
    "/tmp/casa_write_all_large.bin".as_cstr.unwrap file::read_all.unwrap = large_read
    "large byte write is complete" large_content large_read == fe_assert_true
    "/tmp/casa_write_all_large.bin".as_cstr.unwrap file::remove drop
    # file::write_all returns Ok(true) for a writable path
    "data" std::Bytes::from_str "/tmp/casa_write_all_ok.txt".as_cstr.unwrap file::write_all = write_ok_result
    "write_all ok on writable path" write_ok_result.is_ok fe_assert_true
    "write_all returns true" write_ok_result.unwrap fe_assert_true
    "/tmp/casa_write_all_ok.txt".as_cstr.unwrap file::remove drop
    # file::write_all returns Error(NotFound) when target dir does not exist
    "data" std::Bytes::from_str "/tmp/casa_no_such_dir_xyz/file.txt".as_cstr.unwrap file::write_all = write_bad_result
    "write_all error on missing dir" write_bad_result.is_error fe_assert_true
    "write_all error is NotFound" "not found" write_bad_result
        .unwrap_error
        .to_str
        .as_str str::eq fe_assert_true
    # file::remove returns Ok(true) for an existing file
    "data" std::Bytes::from_str "/tmp/casa_remove_ok.txt".as_cstr.unwrap file::write_all drop
    "/tmp/casa_remove_ok.txt".as_cstr.unwrap file::remove = remove_ok_result
    "remove ok on existing" remove_ok_result.is_ok fe_assert_true
    "remove returns true" remove_ok_result.unwrap fe_assert_true
    # file::remove returns Error(NotFound) for a missing file
    "/tmp/casa_remove_definitely_not_a_real_path.xyz".as_cstr.unwrap file::remove = remove_bad_result
    "remove error on missing" remove_bad_result.is_error fe_assert_true
    "remove error is NotFound" "not found" remove_bad_result
        .unwrap_error
        .to_str
        .as_str str::eq fe_assert_true
}

pub fn test_non_utf8_directory_entry_round_trip {
    "/tmp/casa_non_utf8_path_test" = directory
    493 directory.as_cstr.unwrap dir::create.unwrap drop

    directory std::Bytes::from_str = raw_path
    '/'.codepoint u8::try_from.unwrap raw_path.push
    255 raw_path.push
    "round trip" std::Bytes::from_str = content
    content raw_path.as_cstr.unwrap file::write_all.unwrap drop

    directory.as_cstr.unwrap dir::list.unwrap = entries
    "one raw directory entry" 1 entries.length == fe_assert_true
    0 entries.get = entry
    std::Bytes::new = expected_entry
    255 expected_entry.push
    "directory preserves raw entry" expected_entry entry == fe_assert_true

    directory std::Bytes::from_str = listed_path
    '/'.codepoint u8::try_from.unwrap listed_path.push
    entry listed_path.append
    listed_path.as_cstr.unwrap file::read_all.unwrap = read_content
    "listed path reads original bytes" content read_content == fe_assert_true

    listed_path.as_cstr.unwrap file::remove.unwrap drop
    directory.as_cstr.unwrap dir::remove.unwrap drop
}
run_file_tests
test_non_utf8_directory_entry_round_trip
