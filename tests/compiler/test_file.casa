import "../../lib/std.casa" as std
import "../../lib/os.casa" as os
import "temp_paths.casa" as temp_paths

pub const DIRECTORY_MODE 448 # 0700

pub fn fe_fail message:$str {
    f"FAIL: {message}\n".as_str std::eprint
    1 std::process::exit
}

pub fn fe_assert_true condition:bool message:$str {
    if condition ! then
        message fe_fail
    fi
}

pub fn fe_assert_false condition:bool message:$str {
    if condition then
        message fe_fail
    fi
}

pub fn run_file_tests {
    # os::file::exists returns true for an existing file
    "casa_file_exists_test.txt" temp_paths::path = exists_path_owner
    exists_path_owner.as_str = exists_path
    "contents" std::Bytes::from_str exists_path.as_cstr.unwrap os::file::write_all drop
    "existing path" exists_path.as_cstr.unwrap os::file::exists fe_assert_true
    exists_path.as_cstr.unwrap os::file::remove drop
    # os::file::exists returns false for a missing path (no process abort)
    "missing path" "/tmp/casa_file_exists_definitely_not_a_real_path.xyz".as_cstr.unwrap os::file::exists fe_assert_false
    # os::file::read_all returns Ok with the file content
    "casa_read_all_ok.txt" temp_paths::path = read_ok_path_owner
    read_ok_path_owner.as_str = read_ok_path
    "hello world" std::Bytes::from_str read_ok_path.as_cstr.unwrap os::file::write_all drop
    read_ok_path.as_cstr.unwrap os::file::read_all = read_ok_result
    "read_all ok on existing" read_ok_result.is_ok fe_assert_true
    "read_all content matches" "hello world" read_ok_result
        .unwrap
        .to_str
        .unwrap
        .as_str str::eq fe_assert_true
    read_ok_path.as_cstr.unwrap os::file::remove drop
    # os::file::read_all returns Error(NotFound) for a missing file
    "/tmp/casa_read_all_definitely_not_a_real_path.xyz".as_cstr.unwrap os::file::read_all = read_missing_result
    "read_all error on missing" read_missing_result.is_error fe_assert_true
    "read_all error is NotFound" "not found" read_missing_result
        .unwrap_error
        .to_str
        .as_str str::eq fe_assert_true
    # Raw file bytes remain available even when they are not valid UTF-8.
    std::Bytes::new = raw_content
    0 raw_content.push
    255 raw_content.push
    "casa_read_all_invalid_utf8.bin" temp_paths::path = invalid_utf8_path_owner
    invalid_utf8_path_owner.as_str = invalid_utf8_path
    raw_content invalid_utf8_path.as_cstr.unwrap os::file::write_all.unwrap drop
    invalid_utf8_path.as_cstr.unwrap os::file::read_all.unwrap = raw_bytes
    "raw byte length" 2 raw_bytes.length == fe_assert_true
    "raw NUL value" 0 0 raw_bytes.get.unwrap == fe_assert_true
    "raw non-UTF-8 value" 255 1 raw_bytes.get.unwrap == fe_assert_true
    "raw bytes reject invalid UTF-8" raw_bytes.to_str.is_error fe_assert_true
    invalid_utf8_path.as_cstr.unwrap os::file::remove drop
    # Large byte buffers exercise write completion across the full content.
    std::Bytes::new = large_content
    0 = large_index: u64
    while large_index 98305 < do
        large_index 251 % u8::try_from.unwrap large_content.push
        1 += large_index
    done
    "large byte fixture length" 98305 large_content.length == fe_assert_true
    "casa_write_all_large.bin" temp_paths::path = large_path_owner
    large_path_owner.as_str = large_path
    large_content large_path.as_cstr.unwrap os::file::write_all.unwrap drop
    large_path.as_cstr.unwrap os::file::read_all.unwrap = large_read
    "large byte write is complete" large_content large_read == fe_assert_true
    large_path.as_cstr.unwrap os::file::remove drop
    # os::file::write_all returns Ok(Unit::Value) for a writable path
    "casa_write_all_ok.txt" temp_paths::path = write_ok_path_owner
    write_ok_path_owner.as_str = write_ok_path
    "data" std::Bytes::from_str write_ok_path.as_cstr.unwrap os::file::write_all = write_ok_result
    "write_all ok on writable path" write_ok_result.is_ok fe_assert_true
    "write_all returns Unit" write_ok_result.unwrap std::Unit::Value is fe_assert_true
    write_ok_path.as_cstr.unwrap os::file::remove drop
    # os::file::write_all returns Error(NotFound) when target dir does not exist
    "data" std::Bytes::from_str "/tmp/casa_no_such_dir_xyz/file.txt".as_cstr.unwrap os::file::write_all = write_bad_result
    "write_all error on missing dir" write_bad_result.is_error fe_assert_true
    "write_all error is NotFound" "not found" write_bad_result
        .unwrap_error
        .to_str
        .as_str str::eq fe_assert_true
    # os::file::remove returns Ok(Unit::Value) for an existing file
    "casa_remove_ok.txt" temp_paths::path = remove_ok_path_owner
    remove_ok_path_owner.as_str = remove_ok_path
    "data" std::Bytes::from_str remove_ok_path.as_cstr.unwrap os::file::write_all drop
    remove_ok_path.as_cstr.unwrap os::file::remove = remove_ok_result
    "remove ok on existing" remove_ok_result.is_ok fe_assert_true
    "remove returns Unit" remove_ok_result.unwrap std::Unit::Value is fe_assert_true
    # os::file::remove returns Error(NotFound) for a missing file
    "/tmp/casa_remove_definitely_not_a_real_path.xyz".as_cstr.unwrap os::file::remove = remove_bad_result
    "remove error on missing" remove_bad_result.is_error fe_assert_true
    "remove error is NotFound" "not found" remove_bad_result
        .unwrap_error
        .to_str
        .as_str str::eq fe_assert_true
}

pub fn test_write_text {
    "casa_write_text.txt" temp_paths::path = path_owner
    path_owner.as_str = path
    "literal text" path.as_cstr.unwrap os::file::write_text.unwrap drop
    "literal text round trips" "literal text" path.as_cstr.unwrap os::file::read_all
        .unwrap
        .to_str
        .unwrap
        .as_str str::eq fe_assert_true

    "héllo\0世界".to_str = content
    "text writer returns Unit" content.as_str path.as_cstr.unwrap os::file::write_text.unwrap
    std::Unit::Value is fe_assert_true
    "UTF-8 and embedded NUL round trip" content.as_str path.as_cstr.unwrap os::file::read_all
        .unwrap
        .to_str
        .unwrap
        .as_str str::eq fe_assert_true
    "borrowed owner stays readable" "héllo\0世界" content.as_str str::eq fe_assert_true

    "" path.as_cstr.unwrap os::file::write_text.unwrap drop
    "empty text truncates file" 0 path.as_cstr.unwrap os::file::stat.unwrap.size == fe_assert_true
    path.as_cstr.unwrap os::file::remove.unwrap drop
    "" path.as_cstr.unwrap os::file::write_text.unwrap drop
    "empty text creates file" path.as_cstr.unwrap os::file::exists fe_assert_true

    20000 "abc\0é" str::repeat = large_content
    large_content.as_str path.as_cstr.unwrap os::file::write_text.unwrap drop
    "text write spans chunks" large_content.as_str path.as_cstr.unwrap os::file::read_all
        .unwrap
        .to_str
        .unwrap
        .as_str str::eq fe_assert_true
    path.as_cstr.unwrap os::file::remove.unwrap drop

    "missing text path retains NotFound" "text" "/tmp/casa_no_such_dir_xyz/text.txt".as_cstr.unwrap
    os::file::write_text.unwrap_error os::IoError::NotFound is fe_assert_true
    "directory text path retains IsDirectory" "text" "/tmp".as_cstr.unwrap
    os::file::write_text.unwrap_error os::IoError::IsDirectory is fe_assert_true
    "/proc/self/fd".as_cstr.unwrap os::dir::list.unwrap.length = descriptors_before
    "text" "/dev/full".as_cstr.unwrap os::file::write_text.unwrap_error = write_error
    "text write retains ENOSPC" write_error.to_str.as_str "errno 28" str::eq fe_assert_true
    "text write failure closes descriptor" descriptors_before
    "/proc/self/fd".as_cstr.unwrap os::dir::list.unwrap.length == fe_assert_true
}

pub fn test_read_all_streams {
    "/proc/self/cmdline".as_cstr.unwrap os::file::stat.unwrap = virtual_stat
    "virtual file reports zero size" 0 virtual_stat.size == fe_assert_true
    "/proc/self/cmdline".as_cstr.unwrap os::file::read_all.unwrap = command_line
    "virtual file has content" 0 command_line.length < fe_assert_true

    8 std::RawBuffer::new = pipe_fds
    # SAFETY: pipe2 writes two 32-bit file descriptors into the eight-byte buffer.
    unsafe { 0 pipe_fds.data 293 syscall2 = pipe_result }
    "pipe opens" 0 pipe_result == fe_assert_true
    # SAFETY: successful pipe2 initialized both descriptor slots.
    unsafe {
        pipe_fds.data load32 i64::from = read_fd
        pipe_fds.data 4 + load32 i64::from = write_fd
    }
    "pipe content" std::Bytes::from_str = pipe_content
    "pipe write completes" 12 pipe_content write_fd os::file::write == fe_assert_true
    write_fd os::file::close drop
    f"/proc/self/fd/{read_fd}" = pipe_path
    pipe_path
        .as_str
        .as_cstr
        .unwrap os::file::read_all.unwrap = pipe_read
    "non-seekable file reads through EOF" pipe_content pipe_read == fe_assert_true
    read_fd os::file::close drop

    "directory read retains IsDirectory" "/tmp".as_cstr.unwrap os::file::read_all.unwrap_error
    os::IoError::IsDirectory is fe_assert_true
    "casa_read_all_empty.txt" temp_paths::path = empty_path_owner
    empty_path_owner.as_str = empty_path
    std::Bytes::new empty_path.as_cstr.unwrap os::file::write_all.unwrap drop
    "empty file reads empty bytes" 0 empty_path.as_cstr.unwrap os::file::read_all.unwrap.length == fe_assert_true
    empty_path.as_cstr.unwrap os::file::remove.unwrap drop
}

pub fn test_non_utf8_directory_entry_round_trip {
    "casa_non_utf8_path_test" temp_paths::path = directory_owner
    directory_owner.as_str = directory
    493 directory.as_cstr.unwrap os::dir::create.unwrap drop

    directory std::Bytes::from_str = raw_path
    '/'.codepoint u8::try_from.unwrap raw_path.push
    255 raw_path.push
    "round trip" std::Bytes::from_str = content
    content raw_path.as_cstr.unwrap os::file::write_all.unwrap drop

    directory.as_cstr.unwrap os::dir::list.unwrap = entries
    "one raw directory entry" 1 entries.length == fe_assert_true
    0 entries.get = entry
    std::Bytes::new = expected_entry
    255 expected_entry.push
    "directory preserves raw entry" expected_entry entry == fe_assert_true

    directory std::Bytes::from_str = listed_path
    '/'.codepoint u8::try_from.unwrap listed_path.push
    entry listed_path.append
    listed_path.as_cstr.unwrap os::file::read_all.unwrap = read_content
    "listed path reads original bytes" content read_content == fe_assert_true

    listed_path.as_cstr.unwrap os::file::remove.unwrap drop
    directory.as_cstr.unwrap os::dir::remove.unwrap drop
}

pub fn test_directory_unit_results {
    "casa_directory_unit_test" temp_paths::path = directory_owner
    directory_owner.as_str = directory
    "create returns Unit" DIRECTORY_MODE directory.as_cstr.unwrap os::dir::create.unwrap
    std::Unit::Value is fe_assert_true
    "create retains AlreadyExists" DIRECTORY_MODE directory.as_cstr.unwrap os::dir::create.unwrap_error
    os::IoError::AlreadyExists is fe_assert_true

    os::dir::current.unwrap = previous
    "change returns Unit" directory.as_cstr.unwrap os::dir::change.unwrap
    std::Unit::Value is fe_assert_true
    "change updates the directory" directory os::dir::current
        .unwrap
        .to_str
        .unwrap
        .as_str str::eq fe_assert_true
    previous.as_cstr.unwrap os::dir::change.unwrap drop

    "remove directory returns Unit" directory.as_cstr.unwrap os::dir::remove.unwrap
    std::Unit::Value is fe_assert_true
    "remove directory retains NotFound" directory.as_cstr.unwrap os::dir::remove.unwrap_error
    os::IoError::NotFound is fe_assert_true
    "change retains NotFound" directory.as_cstr.unwrap os::dir::change.unwrap_error
    os::IoError::NotFound is fe_assert_true
}

pub fn test_file_stat_owner_mode_bits {
    # Owner read, write, and execute with group read (0740).
    os::FileStat { size: 0 mode: 0x1E0 mtime: 0 atime: 0 ctime: 0 } = owner_all
    "0740 is owner readable" owner_all.is_owner_readable fe_assert_true
    "0740 is owner writable" owner_all.is_owner_writable fe_assert_true
    "0740 is owner executable" owner_all.is_owner_executable fe_assert_true
    # Group and world read without any owner bit (0044).
    os::FileStat { size: 0 mode: 0x24 mtime: 0 atime: 0 ctime: 0 } = others_only
    "0044 is not owner readable" others_only.is_owner_readable ! fe_assert_true
    "0044 is not owner writable" others_only.is_owner_writable ! fe_assert_true
    "0044 is not owner executable" others_only.is_owner_executable ! fe_assert_true
}
run_file_tests
test_write_text
test_read_all_streams
test_non_utf8_directory_entry_round_trip
test_directory_unit_results
test_file_stat_owner_mode_bits
