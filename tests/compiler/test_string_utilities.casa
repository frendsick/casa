import "std" as std
import "../../lib/test.casa" as test

# Byte indexing
"at reads bytes rather than Unicode scalars" test::test_start
"first UTF-8 byte" 195 0 "ä"
    .at
    .unwrap
    .codepoint test::assert_eq
"second UTF-8 byte" 164 1 "ä"
    .at
    .unwrap
    .codepoint test::assert_eq
"embedded NUL" 0 1 "a\0b"
    .at
    .unwrap
    .codepoint test::assert_eq
"empty text" 0 "".at.is_none test::assert_true
"index equals length" 3 "abc".at.is_none test::assert_true
"index past length" 4 "abc".at.is_none test::assert_true
18446744073709551615 = maximum_index: u64
"maximum index" maximum_index "abc".at.is_none test::assert_true
"ä\0".to_str = indexed_owned
"owned first byte" 195 0 indexed_owned
    .at
    .unwrap
    .codepoint test::assert_eq
"owned continuation byte" 164 1 indexed_owned
    .at
    .unwrap
    .codepoint test::assert_eq
"owned NUL byte" 0 2 indexed_owned
    .at
    .unwrap
    .codepoint test::assert_eq
"owned index equals length" 3 indexed_owned.at.is_none test::assert_true
"owned index past length" 4 indexed_owned.at.is_none test::assert_true
"owned maximum index" maximum_index indexed_owned.at.is_none test::assert_true
"".to_str = empty_owned
"empty owned text" 0 empty_owned.at.is_none test::assert_true
"index failure preserves owner" "ä\0" indexed_owned.as_str test::assert_str_eq
"empty text has a C view" "".as_cstr.is_some test::assert_true

# Replacement and splitting
"replace terminates and preserves source" test::test_start
"aaaa" = replacement_source
"adjacent matches" "bb" replacement_source "b" "aa" str::replace.unwrap.as_str test::assert_str_eq
"source unchanged" "aaaa" replacement_source test::assert_str_eq
"no match" "abc" "abc" "x" "z" str::replace.unwrap.as_str test::assert_str_eq
"empty input" "" "" "x" "z" str::replace.unwrap.as_str test::assert_str_eq
"Unicode matches" "界x界" "äxä" "界" "ä" str::replace.unwrap.as_str test::assert_str_eq
"remove matches" "ac" "abc" "" "b" str::replace.unwrap.as_str test::assert_str_eq
"replacement is not rescanned" "aa" "a" "aa" "a" str::replace.unwrap.as_str test::assert_str_eq
"split preserves empty fields" test::test_start
",a,," "," str::split.unwrap = split_fields
"count" 4 split_fields.length test::assert_eq
"leading empty" "" 0 split_fields.get.as_str test::assert_str_eq
"nonempty field" "a" 1 split_fields.get.as_str test::assert_str_eq
"middle empty" "" 2 split_fields.get.as_str test::assert_str_eq
"trailing empty" "" 3 split_fields.get.as_str test::assert_str_eq
"empty input" 1 "" "," str::split.unwrap.length test::assert_eq
"no delimiter match" "abc" 0 "abc" "," str::split
    .unwrap
    .get
    .as_str test::assert_str_eq
"empty search returns None" test::test_start
"nonempty input" "abc" "replacement" "" str::replace.is_none test::assert_true
"empty input" "" "replacement" "" str::replace.is_none test::assert_true
"empty search and replacement" "abc" "" "" str::replace.is_none test::assert_true
"empty delimiter returns None" test::test_start
"nonempty input" "abc" "" str::split.is_none test::assert_true
"empty input" "" "" str::split.is_none test::assert_true

# to_upper
"to_upper basic" test::test_start
"result" "HELLO" "hello".to_upper.as_str test::assert_str_eq
"to_upper mixed" test::test_start
"result" "HELLO WORLD" "hElLo wOrLd".to_upper.as_str test::assert_str_eq
"to_upper already upper" test::test_start
"result" "ABC" "ABC".to_upper.as_str test::assert_str_eq
"to_upper non-alpha" test::test_start
"result" "123!@#" "123!@#".to_upper.as_str test::assert_str_eq
"to_upper empty" test::test_start
"result" "" "".to_upper.as_str test::assert_str_eq

# to_lower
"to_lower basic" test::test_start
"result" "hello" "HELLO".to_lower.as_str test::assert_str_eq
"to_lower mixed" test::test_start
"result" "hello world" "hElLo wOrLd".to_lower.as_str test::assert_str_eq
"to_lower already lower" test::test_start
"result" "abc" "abc".to_lower.as_str test::assert_str_eq
"to_lower non-alpha" test::test_start
"result" "123!@#" "123!@#".to_lower.as_str test::assert_str_eq
"to_lower empty" test::test_start
"result" "" "".to_lower.as_str test::assert_str_eq

# repeat
"repeat basic" test::test_start
"result" "abcabc" 2 "abc".repeat.as_str test::assert_str_eq
"repeat 0" test::test_start
"result" "" 0 "abc".repeat.as_str test::assert_str_eq
"repeat 1" test::test_start
"result" "abc" 1 "abc".repeat.as_str test::assert_str_eq
"repeat many" test::test_start
"result" "xxxxx" 5 "x".repeat.as_str test::assert_str_eq
"repeat empty" test::test_start
"result" "" 3 "".repeat.as_str test::assert_str_eq
"repeat Unicode" test::test_start
"result" "ä😀ä😀" 2 "ä😀".repeat.as_str test::assert_str_eq

# reverse
"reverse basic" test::test_start
"result" "olleh" "hello".reverse.as_str test::assert_str_eq
"reverse single" test::test_start
"result" "a" "a".reverse.as_str test::assert_str_eq
"reverse empty" test::test_start
"result" "" "".reverse.as_str test::assert_str_eq
"reverse palindrome" test::test_start
"result" "aba" "aba".reverse.as_str test::assert_str_eq
"reverse spaces" test::test_start
"result" "cba 321" "123 abc".reverse.as_str test::assert_str_eq
"reverse Unicode" test::test_start
"aä😀".reverse = unicode_reversed
"length" 7 unicode_reversed.length i64::try_from.unwrap test::assert_eq
"result" "😀äa" unicode_reversed.as_str test::assert_str_eq
"substring Unicode boundaries" test::test_start
"result" "😀" "ä😀z" 2 4 str::substring.as_str test::assert_str_eq

# owned String
"String from str copies bytes" test::test_start
for source in ["", "ascii", "ä😀", "a\0b"].iter do
    source std::String::from_str = owned
    "content" source owned.as_str test::assert_str_eq
    "capacity" source.length owned.capacity <= test::assert_true
done
"owned String" test::test_start
std::String::new = text
"empty" text.is_empty test::assert_true
"ab" text.append
'ä' text.push
"append and push" "abä" text.as_str test::assert_str_eq
64 text.reserve
"reserve grows capacity" 68 text.capacity <= test::assert_true
text.clone = cloned_text
text.clear
"clear" "" text.as_str test::assert_str_eq
"clone owns independent text" "abä" cloned_text.as_str test::assert_str_eq
"owned String collection" test::test_start
std::List[std::String]::new = owned_words
"first" owned_words.push_str
"second" owned_words.push_str
0 = observed_length
for word in owned_words.iter do
    word.length i64::try_from.unwrap += observed_length
done
"borrowed iteration" 11 observed_length test::assert_eq
0 owned_words.remove.unwrap = removed_word
"owned removal" "first" removed_word.as_str test::assert_str_eq
owned_words.clone = cloned_words
"explicit collection clone" "second" 0 cloned_words.get.as_str test::assert_str_eq
"C string boundary" test::test_start
"plain text has a C view" "plain".as_cstr.is_some test::assert_true
"interior NUL is rejected" "a\0b".as_cstr.is_none test::assert_true
"valid C bytes convert" "plain" "plain"
    .as_cstr
    .unwrap
    .to_str
    .unwrap
    .as_str test::assert_str_eq
3 std::RawBuffer::new = foreign_bytes
unsafe {
    255 foreign_bytes.data store8
    0 foreign_bytes.data 1 + store8
    foreign_bytes.data ptr::as_ref[cstr] = invalid_cstr
}
"invalid C bytes are rejected" invalid_cstr.to_str.is_error test::assert_true

# to_int
"to_int basic" test::test_start
"is_some" "42".to_int.is_some test::assert_true
"value" 42 "42".to_int.unwrap test::assert_eq
"to_int zero" test::test_start
"is_some" "0".to_int.is_some test::assert_true
"value" 0 "0".to_int.unwrap test::assert_eq
"to_int negative" test::test_start
"is_some" "-7".to_int.is_some test::assert_true
"value" -7 "-7".to_int.unwrap test::assert_eq
"to_int empty" test::test_start
"is_none" "".to_int.is_none test::assert_true
"to_int invalid" test::test_start
"is_none" "abc".to_int.is_none test::assert_true
"to_int mixed" test::test_start
"is_none" "12abc".to_int.is_none test::assert_true
"to_int bare minus" test::test_start
"is_none" "-".to_int.is_none test::assert_true
"to_int large" test::test_start
"value" 12345 "12345".to_int.unwrap test::assert_eq
"to_int full range" test::test_start
"maximum" 9223372036854775807 "9223372036854775807".to_int.unwrap test::assert_eq
"minimum" -9223372036854775808 "-9223372036854775808".to_int.unwrap test::assert_eq
"negative zero" 0 "-0".to_int.unwrap test::assert_eq
"leading zeros" 42 "00042".to_int.unwrap test::assert_eq
for
    invalid in [
        "9223372036854775808",
        "-9223372036854775809",
        "18446744073709551616",
        "+1",
        " 1",
        "1 ",
    ].iter
do
    "invalid or overflowing integer" invalid.to_int.is_none test::assert_true
done

# Integer helpers
"i64 abs is recoverable" test::test_start
"negative" 7 -7.abs.unwrap test::assert_eq
"positive" 7 7.abs.unwrap test::assert_eq
"zero" 0 0.abs.unwrap test::assert_eq
"maximum" 9223372036854775807 9223372036854775807.abs.unwrap test::assert_eq
"negative maximum" 9223372036854775807 -9223372036854775807.abs.unwrap test::assert_eq
"minimum has no positive counterpart" -9223372036854775808.abs.is_none test::assert_true
"i64 pow and clamp boundaries" test::test_start
"zero exponent" 1 0 0.pow.unwrap test::assert_eq
"positive exponent" 8 3 2.pow.unwrap test::assert_eq
"negative base" -8 3 -2.pow.unwrap test::assert_eq
"equal clamp bounds" 4 4 4 10.clamp.unwrap test::assert_eq
"below range" 3 7 3 1.clamp.unwrap test::assert_eq
"inside range" 5 7 3 5.clamp.unwrap test::assert_eq
"above range" 7 7 3 9.clamp.unwrap test::assert_eq
"i64 pow failures and limits" test::test_start
"negative exponent" -1 2.pow.is_none test::assert_true
"minimum exponent" -9223372036854775808 2.pow.is_none test::assert_true
"maximum to first power" 9223372036854775807 1 9223372036854775807.pow.unwrap test::assert_eq
"minimum to first power" -9223372036854775808 1 -9223372036854775808.pow.unwrap test::assert_eq
"largest positive power of two" 4611686018427387904 62 2.pow.unwrap test::assert_eq
"minimum power of negative two" -9223372036854775808 63 -2.pow.unwrap test::assert_eq
"positive overflow" 63 2.pow.is_none test::assert_true
"negative overflow" 64 -2.pow.is_none test::assert_true
"minimum squared" 2 -9223372036854775808.pow.is_none test::assert_true
"zero base" 0 3 0.pow.unwrap test::assert_eq
"negative unit base" 1 4 -1.pow.unwrap test::assert_eq
"i64 clamp is recoverable" test::test_start
"inverted bounds" 1 10 5.clamp.is_none test::assert_true
"full range" 0 9223372036854775807 -9223372036854775808 0.clamp.unwrap test::assert_eq
"minimum bound" -9223372036854775808 0 -9223372036854775808 -9223372036854775808.clamp.unwrap test::assert_eq
"maximum bound" 9223372036854775807 9223372036854775807 0 9223372036854775807.clamp.unwrap test::assert_eq

# join
"join basic" test::test_start
["hello", "world"] std::List::from_array = words
"result" "hello, world" ", " words.join.as_str test::assert_str_eq
"join empty sep" test::test_start
"result" "helloworld" "" words.join.as_str test::assert_str_eq
"join single" test::test_start
["only"] std::List::from_array = single
"result" "only" ", " single.join.as_str test::assert_str_eq
"join empty list" test::test_start
std::List[str]::new = empty_list
"result" "" ", " empty_list.join.as_str test::assert_str_eq
"join three" test::test_start
["a", "b", "c"] std::List::from_array = three
"result" "a-b-c" "-" three.join.as_str test::assert_str_eq

fn assert_equal_forms left:$str right:$str expected:bool {
    left.to_str = owned_left
    right.to_str = owned_right
    "borrowed strings" expected left right == == test::assert_true
    "owned strings" expected owned_left owned_right == == test::assert_true
    "owned and borrowed" expected owned_left right == == test::assert_true
    "borrowed and owned" expected left owned_right == == test::assert_true
}

fn test_equality_word_boundaries {
    "string equality word boundaries" test::test_start
    0 = length: u64
    while 18 length > do
        "abcdefghijklmnopq" 0 length str::substring = text
        true text.as_str text.as_str assert_equal_forms
        if 0 length < then
            "abcdefghijklmnopq" 0 length 1 - str::substring = changed
            "x" changed.append
            false changed.as_str text.as_str assert_equal_forms
            false text.as_str changed.as_str assert_equal_forms
        fi
        1 += length
    done
    false "abcdefghijklmnopq" "abcdefghXjklmnopq" assert_equal_forms
    false "a" "" assert_equal_forms
}
test_equality_word_boundaries
test::test_summary
