import "std" as std
import "../../lib/argparse.casa" as argparse

pub fn ap_fail message:$str {
    f"FAIL: {message}\n".as_str std::eprint
    1 process::exit
}

pub fn ap_assert_true condition:bool message:$str {
    if condition ! then
        message ap_fail
    fi
}

pub fn ap_assert_eq actual:u64 expected:u64 message:$str {
    if expected actual != then
        f"{message} (expected {expected}, got {actual})".as_str ap_fail
    fi
}

pub fn ap_assert_str_eq actual:$std::String expected:$str message:$str {
    if expected actual.as_str != then
        f"{message} (expected '{expected}', got '{actual}')".as_str ap_fail
    fi
}

pub fn build_usage_from_shared_parser parser:$argparse::ArgParser -> std::String {
    parser.build_usage_line
}

pub fn check_option_from_shared_parser parser:$argparse::ArgParser -> bool {
    "--library-path" parser.find_def.is_some
}

pub fn parse_from_shared_parser parser:$argparse::ArgParser -> argparse::ParsedArgs {
    parser.parse_args
}
# add_terminal_flag registers a TerminalFlag-kind ArgDef
argparse::ArgParser::new = terminal_parser
"show version" "--version" "-v" "version" terminal_parser.add_terminal_flag
"terminal definitions length" 1 terminal_parser.definitions.length ap_assert_eq
0 terminal_parser.definitions.get = terminal_def
if terminal_def argparse::ArgDef::TerminalFlag(terminal_payload) is then
    "terminal name" "version" terminal_payload.name ap_assert_str_eq
    "terminal short_flag" "-v" terminal_payload.short_flag ap_assert_str_eq
    "terminal long_flag" "--version" terminal_payload.long_flag ap_assert_str_eq
    "terminal help_text" "show version" terminal_payload.help_text ap_assert_str_eq
else
    "kind is TerminalFlag" ap_fail
fi
# add_multi_option registers a MultiOption-kind ArgDef
argparse::ArgParser::new = parser
"library path" "--library-path" "-L" "library_path" parser.add_multi_option
"definitions length" 1 parser.definitions.length ap_assert_eq
0 parser.definitions.get = registered_def
if registered_def argparse::ArgDef::MultiOption(registered_payload) is then
    "name" "library_path" registered_payload.name ap_assert_str_eq
    "short_flag" "-L" registered_payload.short_flag ap_assert_str_eq
    "long_flag" "--library-path" registered_payload.long_flag ap_assert_str_eq
    "help_text" "library path" registered_payload.help_text ap_assert_str_eq
else
    "kind is MultiOption" ap_fail
fi
# parse_args with no argv yields empty get_multi list
argparse::ArgParser::new = parser2
"library path" "--library-path" "-L" "library_path" parser2.add_multi_option
parser2.parse_args = parsed_no_args
"get_multi some" "library_path" parsed_no_args.get_multi.is_some ap_assert_true
"get_multi empty list" 0 "library_path" parsed_no_args
    .get_multi
    .unwrap
    .length ap_assert_eq
"get_multi none for unregistered" "missing" parsed_no_args.get_multi.is_none ap_assert_true
# build_flag_column for MultiOption renders like Option (flag + metavar)
argparse::ArgParser::new = parser3
"library path" "--library-path" "-L" "library_path" parser3.add_multi_option
0 parser3.definitions.get = multi_def
"flag column" "-L, --library-path LIBRARY_PATH" multi_def argparse::build_flag_column ap_assert_str_eq
# append_usage_optional for MultiOption renders ` [-L LIBRARY_PATH]`
std::String::new = usage_sb
multi_def usage_sb argparse::append_usage_optional
"usage optional" " [-L LIBRARY_PATH]" usage_sb ap_assert_str_eq
# Read-only ArgParser operations accept shared receivers.
parser3 build_usage_from_shared_parser = usage_line
"shared usage" 0 usage_line.length > ap_assert_true
"shared find_def" parser3 check_option_from_shared_parser ap_assert_true
parser3 parse_from_shared_parser = parsed_shared
"shared parse_args" "library_path" parsed_shared.get_multi.is_some ap_assert_true
