pub fn test_emit_fn_with_body {
    "emit_fn_with_body" test::test_start
    std::List[common::InstValue]::new = bytecode
    "adder".to_str common::InstValue::FnCall bytecode.push

    std::List[common::InstValue]::new = fn_bytecode
    2 common::InstValue::LocalsInit fn_bytecode.push
    0 common::InstValue::LocalGet fn_bytecode.push
    1 common::InstValue::LocalGet fn_bytecode.push
    common::InstValue::Add fn_bytecode.push
    2 common::InstValue::LocalsUninit fn_bytecode.push
    common::InstValue::FnReturn fn_bytecode.push

    std::Map[std::String std::List[common::InstValue]]::new = functions
    fn_bytecode "adder".to_str functions.set

    0 std::List[common::StaticStruct]::new std::List[common::StaticArray]::new std::List[std::String]::new functions bytecode
    std::Map[std::String common::NativeCallPlan]::new common::Program = program
    program emitter::emit = result
    "has fn label" result "fn_adder:" assert_contains
    "has locals init" result "movq %rax, 0(%rdi)" assert_contains
    "has add in body" result "addq %r9, %r8" assert_contains
    "has fn return" result "pushq (%r14)\n    ret" assert_contains
}

pub fn test_emit_forwarding_frame {
    "emit_forwarding_frame" test::test_start
    for address_taken_ref in [false, true].iter do
        address_taken_ref copy = address_taken
        std::List[common::InstValue]::new = body
        1 common::InstValue::LocalsInit body.push
        7 common::InstValue::Label body.push
        0 common::InstValue::LocalSet body.push
        0 common::InstValue::LocalGet body.push
        if address_taken then
            0 common::InstValue::LocalAddress body.push
            common::InstValue::Drop body.push
        fi
        common::InstValue::Load64 body.push
        1 common::InstValue::LocalsUninit body.push
        common::InstValue::FnReturn body.push
        make_empty_program = program
        body "forward_load".to_str program.functions.set
        "forward_load".to_str common::InstValue::FnCall program.bytecode.push
        "forward_load".to_str common::InstValue::FnPushStatic program.bytecode.push
        program emitter::emit = result
        "capacity check survives" result "return_stack+1048568(%rip)" assert_contains
        "load survives" result "movq (%r11), %r11" assert_contains
        "return survives" result "pushq (%r14)\n    ret" assert_contains
        "only addressable frame needs storage" address_taken
        0 result.as_str "movq %rax, 0(%rdi)" str::find >= == test::assert_true
        "only addressable parameter is spilled" address_taken
        0 result.as_str "popq %r11\n    movq %r11, -8(%r14)" str::find >= == test::assert_true
        "callable symbol survives" result "fn_forward_load:" assert_contains
        "function reference survives" result "leaq closure_forward_load(%rip)" assert_contains
        "only addressable helper needs a direct call" address_taken
        0 result.as_str "call fn_forward_load" str::find >= == test::assert_true
        if address_taken ! then
            "expanded call checks original call and local capacity" result
            "return_stack+1048560(%rip)" assert_contains
        fi
    done
}

