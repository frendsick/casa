    std::Map[std::String std::List[common::InstValue]]::new
    bytecode
    std::Map[std::String common::NativeCallPlan]::new
    common::Program = program

    program emitter::emit = result
    "read allocation uses static size" result "movq $16, %rdi" assert_contains
    "copies use static size" result "movq $16, %rcx" assert_contains
    "read has no representation operand" 0 result.as_str "popq %r8" str::find < test::assert_true
    "read has no direct-size branches" 0 result.as_str ".Ltyped_read_" str::find < test::assert_true
    "write has no direct-size branches" 0 result.as_str ".Ltyped_write_" str::find < test::assert_true
}

