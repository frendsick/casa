pub fn test_emit_local_ops {
    "emit_local_ops" test::test_start
    std::List[common::InstValue]::new = bytecode
    3 common::InstValue::LocalsInit bytecode.push
    0 common::InstValue::LocalGet bytecode.push
    1 common::InstValue::LocalSet bytecode.push
    3 common::InstValue::LocalsUninit bytecode.push

    0 std::List[common::StaticStruct]::new std::List[common::StaticArray]::new std::List[std::String]::new
    std::Map[std::String std::List[common::InstValue]]::new
    bytecode
    std::Map[std::String common::NativeCallPlan]::new
    common::Program = program

    program emitter::emit = result
    3 common::WORD_SIZE * = reservation_size
    "zeros third local" result "movq %rax, 16(%rdi)" assert_contains
    f"addq ${reservation_size}, %r14" = reservation
    "has locals init add" result reservation.as_str assert_contains
    emitter::RETURN_STACK_SIZE reservation_size - = maximum_offset
    f"leaq return_stack+{maximum_offset}(%rip), %rcx" = check
    "checks complete locals range" result check.as_str assert_contains
    "has local get offset" result "movq -8(%r14), %r8" assert_contains
    "has local set offset" result "movq %r8, -16(%r14)" assert_contains
    "has locals uninit" result "subq $24, %r14" assert_contains
}

