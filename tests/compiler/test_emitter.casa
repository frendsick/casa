import "std" as std
import "../../compiler/error.casa" as error
import "../../compiler/runtime.casa" as runtime
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

fn assert_assembly source:$str expected:$str {
    error::Diagnostics::new = diagnostics
    diagnostics source helpers::assemble_test_source = assembly
    source diagnostics.has_errors ! test::assert_true
    expected assembly.as_str expected str::contains test::assert_true
}

fn test_scalar_selection {
    "scalar_selection" test::test_start
    "movabsq $4294967296" "4294967296 print" assert_assembly
    "movabsq $-42" "-42 print" assert_assembly
    "call encode_char" "'a' print" assert_assembly
    ".Lpb_false_" "true print" assert_assembly
    "call print_str" "\"hello\" print" assert_assembly
    "addq" "2 1 + print" assert_assembly
    "subq" "2 1 - print" assert_assembly
    "imulq" "2 1 * print" assert_assembly
    "idivq" "2 1 / print" assert_assembly
    "idivq" "2 1 % print" assert_assembly
    "shlq" "1 2 << print" assert_assembly
    "sarq" "8 1 >> print" assert_assembly
    "andq" "2 1 & print" assert_assembly
    "orq" "2 1 | print" assert_assembly
    "xorq" "2 1 ^ print" assert_assembly
    "notq" "2 ~ print" assert_assembly
    "setl" "2 1 < print" assert_assembly
    "setle" "2 1 <= print" assert_assembly
    "setg" "2 1 > print" assert_assembly
    "setge" "2 1 >= print" assert_assembly
    "sete" "2 1 == print" assert_assembly
    "setne" "2 1 != print" assert_assembly
    "call .Lscalar_fn_1" "fn twice value:i64 -> i64 { value 2 * } 21 twice print" assert_assembly
}

fn test_literals_and_runtime {
    "literals_and_runtime" test::test_start
    ".asciz \"hello\"" "\"hello\" print" assert_assembly
    ".asciz \"a\\nb\\tc\\\\d\\\"e\"" "\"a\\nb\\tc\\\\d\\\"e\" print" assert_assembly
    ".asciz \"\\0001\"" "\"\\01\" print" assert_assembly
    "return_stack_overflow:" "" assert_assembly
    "heap_alloc:" "" assert_assembly
    "syscall" "unsafe { 39 syscall0 drop }" assert_assembly
    "__argc(%rip)" "argc print" assert_assembly
    "__argv(%rip)" "argv drop" assert_assembly
    "static_array_0:\n.quad 1" "[1, 2, 3] drop" assert_assembly
    "movq %rax, 16(%rdi)" "extern fn opaque\nfn locals { 1 = a 2 = b 3 = c unsafe { opaque } a print b print c print } locals" assert_assembly
}

fn test_runtime_heap_growth {
    "runtime_heap_growth" test::test_start
    unsafe {
        runtime::HEAP_GROWTH_SIZE 1 + u64::try_from.unwrap = allocation_size
        allocation_size alloc = large_allocation
        123 large_allocation store8
        45 large_allocation allocation_size 1 - + store8
        8 alloc = next_chunk_allocation
        67 next_chunk_allocation store8

        "large allocation start" large_allocation load8 123 == test::assert_true
        "large allocation end" large_allocation allocation_size 1 - + load8 45 == test::assert_true
        "next chunk" next_chunk_allocation load8 67 == test::assert_true

        large_allocation free
        next_chunk_allocation free
    }
}

fn test_float_round_uses_sse2 {
    "float_round_uses_sse2" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "import \"lib/std.casa\" as std\n1.5 = single:f32 single.floor drop 2.5.round drop" helpers::assemble_test_source helpers::program_assembly = generated
    "f32 uses SSE2 conversion" generated.as_str "cvttss2siq" str::contains test::assert_true
    "f64 uses SSE2 conversion" generated.as_str "cvttsd2siq" str::contains test::assert_true
    "f32 avoids SSE4.1" generated.as_str "roundss" str::contains ! test::assert_true
    "f64 avoids SSE4.1" generated.as_str "roundsd" str::contains ! test::assert_true
}

fn test_frame_initialization_boundary {
    "frame_initialization_boundary" test::test_start
    for count_ref in [32, 33].iter do
        count_ref copy = count
        "extern fn opaque\nfn frame { ".to_str = source
        0 = index
        while count index < do
            f"{index} = value{index} " = binding binding.as_str source.append
            1 += index
        done
        "unsafe { opaque } " source.append
        0 = index
        while count index < do
            f"value{index} print " = use use.as_str source.append
            1 += index
        done
        "} frame" source.append
        error::Diagnostics::new = diagnostics
        diagnostics source.as_str helpers::assemble_test_source helpers::program_assembly = generated
        f"addq ${count 8 *}, %r14" = reservation
        "reserves complete frame" generated.as_str reservation.as_str str::contains test::assert_true
        "only large frame uses repeated stores" 33 count == generated.as_str "rep stosq" str::contains == test::assert_true
        if 32 count == then
            "small frame zeros last slot" generated.as_str "movq %rax, 248(%rdi)" str::contains test::assert_true
        fi
    done
}

fn test_forwarding_frame {
    "forwarding_frame" test::test_start
    for extra_use_ref in [false, true].iter do
        extra_use_ref copy = extra_use
        if extra_use then "storage ptr::from_ref drop " else "" fi = extra_use_source
        "fn forward storage:ptr -> u64 { ".to_str = source
        extra_use_source source.append
        "unsafe { storage load64 } } unsafe { 8 alloc } forward print &forward drop" source.append
        error::Diagnostics::new = diagnostics
        diagnostics source.as_str helpers::assemble_test_source helpers::program_assembly = generated
        "forwarded load remains" generated.as_str "movq (%r11), %r11" str::contains test::assert_true
        "callable symbol remains" generated.as_str "fn_forward:" str::contains test::assert_true
        "function reference remains" generated.as_str "leaq closure_forward(%rip)" str::contains test::assert_true
        "only reused parameter is spilled" extra_use generated.as_str "popq %r11\n    movq %r11, -8(%r14)" str::contains == test::assert_true
        "only reused helper requires direct call" extra_use generated.as_str "call fn_forward" str::contains == test::assert_true
    done
}

fn test_oversized_return_stack_reservation {
    "oversized_return_stack_reservation" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "fn oversized input:$array[i64 131073] { input copy = local local drop } &oversized drop" helpers::assemble_test_source = assembly
    "source checks" diagnostics.has_errors ! test::assert_true
    "oversized" assembly helpers::function_assembly = generated
    "oversized frame jumps directly to overflow" generated.as_str "jmp return_stack_overflow" str::contains test::assert_true
    "oversized frame does not advance stack" generated.as_str "addq $1048584, %r14" str::contains ! test::assert_true
}
test_scalar_selection
test_literals_and_runtime
test_runtime_heap_growth
test_float_round_uses_sse2
test_frame_initialization_boundary
test_forwarding_frame
test_oversized_return_stack_reservation
test::test_summary
