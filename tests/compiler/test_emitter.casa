pub fn test_emit_float_round_uses_sse2 {
    "emit_float_round_uses_sse2" test::test_start
    std::List[common::InstValue]::new = bytecode
    common::BuiltinType::F32 "__float_floor".to_str common::FloatRound
    common::InstValue::FloatRound bytecode.push
    common::BuiltinType::F64 "__float_round".to_str common::FloatRound
    common::InstValue::FloatRound bytecode.push

    0 std::List[common::StaticStruct]::new std::List[common::StaticArray]::new
    std::List[std::String]::new
    std::Map[std::String std::List[common::InstValue]]::new
    bytecode
    std::Map[std::String common::NativeCallPlan]::new
    common::Program emitter::emit = result

    "f32 uses SSE2 conversion" result "cvttss2siq" assert_contains
    "f64 uses SSE2 conversion" result "cvttsd2siq" assert_contains
    "does not use SSE4.1 roundss" 0 result.as_str "roundss" str::find < test::assert_true
    "does not use SSE4.1 roundsd" 0 result.as_str "roundsd" str::find < test::assert_true
}

