    bytecode
    std::Map[std::String common::NativeCallPlan]::new
    common::Program = program

    program emitter::emit = result
    "refills three operands" result "popq %r11\n    popq %r10\n    popq %r9" assert_contains
    "rotates cached operands" result
    "movq %r9, %rax\n    movq %r10, %r9\n    movq %r11, %r10\n    movq %rax, %r11" assert_contains
    "flushes in stack order" result "pushq %r9\n    pushq %r10\n    pushq %r11" assert_contains
}

