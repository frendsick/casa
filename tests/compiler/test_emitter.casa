# ---------------------------------------------------------------------------
# Locals init uses direct stores for small frames
# ---------------------------------------------------------------------------

pub fn test_emit_locals_direct_stores {
    "emit_locals_direct_stores" test::test_start
    std::List[common::InstValue]::new = bytecode
    32 common::InstValue::LocalsInit bytecode.push
    32 common::InstValue::LocalsUninit bytecode.push

    0 std::List[common::StaticStruct]::new std::List[common::StaticArray]::new std::List[std::String]::new
    std::Map[std::String std::List[common::InstValue]]::new
    bytecode
    std::Map[std::String common::NativeCallPlan]::new
    common::Program = program

    program emitter::emit = result
    32 common::WORD_SIZE * = byte_count
    emitter::RETURN_STACK_SIZE byte_count - = maximum_offset
    f"return_stack+{maximum_offset}(%rip)" = capacity_check
    "checks frame capacity" result capacity_check.as_str assert_contains
    f"addq ${byte_count}, %r14" = reservation
    "reserves frame" result reservation.as_str assert_contains
    "zeros first slot" result "movq %rax, 0(%rdi)" assert_contains
    f"movq %rax, {byte_count common::WORD_SIZE -}(%rdi)" = last_store
    "zeros last slot" result last_store.as_str assert_contains
    f"leaq {byte_count}(%rdi), %rdi" = advance
    "advances destination" result advance.as_str assert_contains
    "clears count register" result "movq $0, %rcx" assert_contains
    "does not use rep stosq" 0 result.as_str "rep stosq" str::find < test::assert_true
}

