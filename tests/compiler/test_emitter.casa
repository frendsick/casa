pub fn test_emit_fn_return {
    "emit_fn_return" test::test_start
    # In a non-global context, fn_return restores the native return address.
    std::List[common::InstValue]::new = bytecode
    common::InstValue::FnReturn bytecode.push

    std::List[common::InstValue]::new = fn_bytecode
    common::InstValue::FnReturn fn_bytecode.push

    std::Map[std::String std::List[common::InstValue]]::new = functions
    fn_bytecode "test_fn".to_str functions.set

    0 std::List[common::StaticStruct]::new std::List[common::StaticArray]::new std::List[std::String]::new functions bytecode
    std::Map[std::String common::NativeCallPlan]::new common::Program = program
    program emitter::emit = result
    "returns through the CPU return predictor" result "pushq (%r14)\n    ret" assert_contains
}

pub fn test_emit_fn_exec {
    "emit_fn_exec" test::test_start
    make_empty_program emitter::Emitter::new = emitter
    false common::InstValue::FnExec emitter.emit_control_flow
    emitter.into_asm = result
    emitter::RETURN_STACK_SIZE common::WORD_SIZE - = maximum_offset
    f"leaq return_stack+{maximum_offset}(%rip), %rcx\n    cmpq %rcx, %r14\n    ja return_stack_overflow\n    addq ${common::WORD_SIZE}, %r14" = check
    "checks closure return address" result check.as_str assert_contains
    "has callq *%rax" result "callq *%rax" assert_contains
}

pub fn test_emit_closure_drop {
    "emit_closure_drop" test::test_start
    make_empty_program emitter::Emitter::new = emitter
    false common::InstValue::ClosureDrop emitter.emit_control_flow
    emitter.into_asm = result
    emitter::RETURN_STACK_SIZE common::WORD_SIZE - = maximum_offset
    f"leaq return_stack+{maximum_offset}(%rip), %rcx\n    cmpq %rcx, %r14\n    ja return_stack_overflow\n    addq ${common::WORD_SIZE}, %r14" = check
    "checks destruction return address" result check.as_str assert_contains
    "has destruction call" result "callq *%rdx" assert_contains
}

