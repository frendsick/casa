# ---------------------------------------------------------------------------
# Memory operations (remaining)
# ---------------------------------------------------------------------------

pub fn test_emit_heap_alloc {
    "emit_heap_alloc" test::test_start
    std::List[common::InstValue]::new = bytecode
    common::InstValue::HeapAlloc bytecode.push
    common::InstValue::HeapFree bytecode.push

    0 std::List[common::StaticStruct]::new std::List[common::StaticArray]::new std::List[std::String]::new
    std::Map[std::String std::List[common::InstValue]]::new
    bytecode
    std::Map[std::String common::NativeCallPlan]::new
    common::Program = program

    program emitter::emit = result
    "calls allocator" result "call heap_alloc" assert_contains
    "calls deallocator" result "call heap_free" assert_contains
    "zero allocation returns null" result ".Lheap_alloc_null:" assert_contains
    "allocation reports failure" result ".Lheap_alloc_oom:" assert_contains
    "allocation checks size overflow" result "jc .Lheap_alloc_oom" assert_contains
    "allocation rounds to alignment" result "andq $-8, %rax" assert_contains
    "allocation maps new chunks" result ".Lheap_alloc_map:" assert_contains
    "allocation checks mmap failure" result "cmpq $-4095, %rax" assert_contains
    "small allocations use exact bins" result "leaq small_free_lists(%rip), %r9" assert_contains
    "free reuses storage" result "movq %rax, free_list(%rip)" assert_contains
}

pub fn test_runtime_heap_growth {
    "runtime_heap_growth" test::test_start
    unsafe {
        emitter::HEAP_GROWTH_SIZE 1 + u64::try_from.unwrap = allocation_size
        allocation_size alloc = large_allocation
        123 large_allocation store8
        45 large_allocation allocation_size 1 - + store8
        8 alloc = next_chunk_allocation
        67 next_chunk_allocation store8

        "large allocation start" large_allocation load8 123 == test::assert_true
        "large allocation end" large_allocation allocation_size 1 - + load8 45 == test::assert_true
        "next chunk" next_chunk_allocation load8 67 == test::assert_true

        large_allocation free
        next_chunk_allocation free
    }
}

