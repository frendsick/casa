pub fn test_emit_helpers_present {
    "emit_helpers_present" test::test_start
    make_empty_program emitter::emit = result
    "has print_int" result "print_int:" assert_contains
    "has print_str" result "print_str:" assert_contains
    "has str_concat" result "str_concat:" assert_contains
    "has write_all" result "write_all:" assert_contains
    "retries interrupted writes" result "cmpq $-4, %rax" assert_contains
    "advances after partial writes" result "addq %rax, %rsi" assert_contains
    "fails on write errors" result ".Lwrite_all_fail:" assert_contains
}

pub fn test_emit_oversized_return_stack_reservation {
    "emit_oversized_return_stack_reservation" test::test_start
    make_empty_program emitter::Emitter::new = emitter
    emitter::RETURN_STACK_SIZE u64::try_from.unwrap 1 + emitter.emit_return_stack_reservation
    emitter.into_asm = result
    "rejects reservation larger than the stack" result "jmp return_stack_overflow" assert_contains
}

