pub fn test_emit_fn_call {
    "emit_fn_call" test::test_start
    std::List[common::InstValue]::new = bytecode
    "my_func".to_str common::InstValue::FnCall bytecode.push

    std::List[common::InstValue]::new = fn_bytecode

    std::Map[std::String std::List[common::InstValue]]::new = functions
    fn_bytecode "my_func".to_str functions.set

    0 std::List[common::StaticStruct]::new std::List[common::StaticArray]::new std::List[std::String]::new functions bytecode
    std::Map[std::String common::NativeCallPlan]::new common::Program = program
    program emitter::emit = result
    "has call fn_my_func" result "call fn_my_func" assert_contains
    "callee stores its return address" result "fn_my_func:\n    popq -8(%r14)" assert_contains
    f"ja return_stack_overflow\n    addq ${common::WORD_SIZE}, %r14\n    call fn_my_func" = check
    "checks return address before call" result check.as_str assert_contains
}

