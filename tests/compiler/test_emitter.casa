import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/emitter.casa" as emitter
import "../../compiler/runtime.casa" as runtime
import "../../lib/test.casa" as test
import "helpers" as helpers

fn compile code:$str -> std::String {
    error::Diagnostics::new = diagnostics
    diagnostics code helpers::compile_test_source helpers::generated_assembly
}

pub fn assert_contains needle:$str haystack:$std::String msg:$str {
    haystack.as_str needle str::find = position
    if 0 position < then
        msg false test::assert_true
    else
        msg true test::assert_true
    fi
}

pub fn test_sanitize_name {
    "sanitize_name" test::test_start
    "simple name" "foo" "foo" emitter::sanitize_name.as_str test::assert_str_eq
    "double colon" "Foo__bar" "Foo::bar" emitter::sanitize_name.as_str test::assert_str_eq
    "multiple" "A__B__C" "A::B::C" emitter::sanitize_name.as_str test::assert_str_eq
    "no colons" "hello_world" "hello_world" emitter::sanitize_name.as_str test::assert_str_eq
    "single colon preserved" "a:b" "a:b" emitter::sanitize_name.as_str test::assert_str_eq
}

pub fn test_escape_string {
    "escape_string" test::test_start
    "plain" "hello" "hello" emitter::escape_string.as_str test::assert_str_eq
    "newline" "a\\nb" "a\nb" emitter::escape_string.as_str test::assert_str_eq
    "tab" "a\\tb" "a\tb" emitter::escape_string.as_str test::assert_str_eq
    "backslash" "\\\\" "\\" emitter::escape_string.as_str test::assert_str_eq
    "quote" "\\\"" "\"" emitter::escape_string.as_str test::assert_str_eq
    std::String::new = nul_then_digit
    '\0' nul_then_digit.push
    '1' nul_then_digit.push
    "NUL before octal digit" "\\0001" nul_then_digit.as_str
    emitter::escape_string.as_str test::assert_str_eq
}

pub fn test_emitted_nul_before_octal_digits {
    "emitted_nul_before_octal_digits" test::test_start
    "\00\01\02\03\04\05\06\07" = value
    "literal length" 16 value.length == test::assert_true
    0 = index: u64
    while index 8 > do
        f"NUL byte {index}" '\0' index 2 * value.at == test::assert_true
        index u32::try_from.unwrap '0'.codepoint + char::from_codepoint.unwrap = digit
        f"octal digit {index}" digit index 2 * 1 + value.at == test::assert_true
        1 += index
    done
}

pub fn test_runtime_heap_growth {
    "runtime_heap_growth" test::test_start
    unsafe {
        runtime::HEAP_GROWTH_SIZE 1 + u64::try_from.unwrap = allocation_size
        allocation_size alloc = large_allocation
        123 large_allocation store8
        45 large_allocation allocation_size 1 - + store8
        8 alloc = next_chunk_allocation
        67 next_chunk_allocation store8

        "large allocation start" large_allocation load8 123 == test::assert_true
        "large allocation end" large_allocation allocation_size 1 - + load8 45 == test::assert_true
        "next chunk" next_chunk_allocation load8 67 == test::assert_true

        large_allocation free
        next_chunk_allocation free
    }
}

fn test_selected_target_contracts {
    "selected target contracts" test::test_start
    "fn leaf value:u64 -> bool { value 0 != } unsafe { argc drop } 41 leaf drop &leaf drop" compile = assembly
    "native entry" assembly "_start:" assert_contains
    "root arguments" assembly "movq %rax, __argc(%rip)" assert_contains
    "leaf symbol" assembly "fn_leaf:" assert_contains
    "static closure" assembly "closure_leaf: .quad fn_leaf" assert_contains
    "forwarding frame keeps capacity check" assembly "return_stack+1048568(%rip)" assert_contains
    "expanded call keeps original frame check" assembly "return_stack+1048560(%rip)" assert_contains
    "direct leaf call is expanded" 0 assembly.as_str "call fn_leaf" str::find < test::assert_true
    "native return" assembly "pushq (%r14)\n    ret" assert_contains
}

fn test_selected_float_rounding {
    "selected float rounding" test::test_start
    "1.5 = single:f32 single.__float_floor drop 2.5 = double:f64 double.__float_round drop" compile = assembly
    "f32 SSE2 conversion" assembly "cvttss2siq" assert_contains
    "f64 SSE2 conversion" assembly "cvttsd2siq" assert_contains
    "no SSE4.1 roundss" 0 assembly.as_str "roundss" str::find < test::assert_true
    "no SSE4.1 roundsd" 0 assembly.as_str "roundsd" str::find < test::assert_true
}

fn test_selected_indirect_copies {
    "selected indirect copies" test::test_start
    "struct Pair { x:i64 y:i64 } unsafe { 16 alloc = memory 2 1 Pair memory ptr::write[Pair] memory ptr::read[Pair] drop memory free }" compile = assembly
    "read allocation has static size" assembly "movq $16, %rdi" assert_contains
    "copy has static size" assembly "movq $16, %rcx" assert_contains
    "no representation dispatch" 0 assembly.as_str ".Ltyped_read_" str::find < test::assert_true
    "no store-size dispatch" 0 assembly.as_str ".Ltyped_write_" str::find < test::assert_true
}

fn test_selected_frames {
    "selected frames" test::test_start
    "fn small x:i64 -> i64 { x 1 + } 1 small drop" compile = small
    "small frame uses direct stores" small "movq %rax, 0(%rdi)" assert_contains
    "checked arithmetic keeps frame" small "call fn_small" assert_contains
    std::String::new = source
    "fn large { " source.append
    0 = index: u64
    while index 33 > do
        f"{index} = local_{index} " = binding
        binding.as_str source.append
        1 += index
    done
    "local_0 drop } large" source.append
    source.as_str compile = large
    "large frame uses repeated stores" large "movq $33, %rcx" assert_contains
    "large frame initialization" large "rep stosq" assert_contains
}

fn test_oversized_frame {
    "oversized frame" test::test_start
    "fn large values:array[u8 1048577] { values drop } &large drop" compile = assembly
    "single oversized reservation fails immediately" assembly "jmp return_stack_overflow" assert_contains
}

fn test_transparent_leaf_bodies {
    "transparent leaf bodies" test::test_start
    "struct Value { number:u64 } fn grouped value:u64 -> bool { unsafe { value 0 != } } fn access value:$Value -> u64 { value.number } fn ignore value:$Value { value drop } 1 grouped drop 7 Value = value value access drop value ignore" compile = assembly
    "grouped leaf expands" 0 assembly.as_str "call fn_grouped" str::find < test::assert_true
    "borrowed drop leaf expands" 0 assembly.as_str "call fn_ignore" str::find < test::assert_true
    "accessor leaf expands" 0 assembly.as_str "call fn_Value__number" str::find < test::assert_true
}
test_sanitize_name
test_escape_string
test_emitted_nul_before_octal_digits
test_runtime_heap_growth
test_selected_target_contracts
test_selected_float_rounding
test_selected_indirect_copies
test_selected_frames
test_oversized_frame
test_transparent_leaf_bodies
test::test_summary
