pub fn test_emit_swap {
    "emit_swap" test::test_start
    std::List[common::InstValue]::new = bytecode
    common::InstValue::Swap bytecode.push

    0 std::List[common::StaticStruct]::new std::List[common::StaticArray]::new std::List[std::String]::new
    std::Map[std::String std::List[common::InstValue]]::new
    bytecode
    std::Map[std::String common::NativeCallPlan]::new
    common::Program = program

    program emitter::emit = result
    "refills operands in stack order" result "popq %r11\n    popq %r10" assert_contains
    "swaps cached operands" result
    "movq %r11, %rax\n    movq %r10, %r11\n    movq %rax, %r10" assert_contains
    "flushes bottom before top" result "pushq %r10\n    pushq %r11" assert_contains
}

