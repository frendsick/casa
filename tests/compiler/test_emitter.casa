# Helper: check that a string contains a substring

pub fn assert_contains needle:$str haystack:$std::String msg:$str {
    haystack.as_str needle str::find = position
    if 0 position < then
        msg false test::assert_true
    else
        msg true test::assert_true
    fi
}
# Helper: build a minimal program with no bytecode

pub fn make_empty_program -> common::Program {
    0
    std::List[common::StaticStruct]::new
    std::List[common::StaticArray]::new
    std::List[std::String]::new
    std::Map[std::String std::List[common::InstValue]]::new
    std::List[common::InstValue]::new
    std::Map[std::String common::NativeCallPlan]::new
    common::Program
}
# Helper: build a program with given bytecode and strings

pub fn test_sanitize_name {
    "sanitize_name" test::test_start
    "simple name" "foo" "foo" emitter::sanitize_name.as_str test::assert_str_eq
    "double colon" "Foo__bar" "Foo::bar" emitter::sanitize_name.as_str test::assert_str_eq
    "multiple" "A__B__C" "A::B::C" emitter::sanitize_name.as_str test::assert_str_eq
    "no colons" "hello_world" "hello_world" emitter::sanitize_name.as_str test::assert_str_eq
    "single colon preserved" "a:b" "a:b" emitter::sanitize_name.as_str test::assert_str_eq
}

pub fn test_escape_string {
    "escape_string" test::test_start
    "plain" "hello" "hello" emitter::escape_string.as_str test::assert_str_eq
    "newline" "a\\nb" "a\nb" emitter::escape_string.as_str test::assert_str_eq
    "tab" "a\\tb" "a\tb" emitter::escape_string.as_str test::assert_str_eq
    "backslash" "\\\\" "\\" emitter::escape_string.as_str test::assert_str_eq
    "quote" "\\\"" "\"" emitter::escape_string.as_str test::assert_str_eq
    std::String::new = nul_then_digit
    '\0' nul_then_digit.push
    '1' nul_then_digit.push
    "NUL before octal digit" "\\0001" nul_then_digit.as_str
    emitter::escape_string.as_str test::assert_str_eq
}

pub fn test_emitted_nul_before_octal_digits {
    "emitted_nul_before_octal_digits" test::test_start
    "\00\01\02\03\04\05\06\07" = value
    "literal length" 16 value.length == test::assert_true
    0 = index: u64
    while index 8 > do
        f"NUL byte {index}" '\0' index 2 * value.at == test::assert_true
        index u32::try_from.unwrap '0'.codepoint + char::from_codepoint.unwrap = digit
        f"octal digit {index}" digit index 2 * 1 + value.at == test::assert_true
        1 += index
    done
}

pub fn test_emit_bss {
    "emit_bss" test::test_start
    2 = constants: u64
    constants
    std::List[common::StaticStruct]::new
    std::List[common::StaticArray]::new
    std::List[std::String]::new
    std::Map[std::String std::List[common::InstValue]]::new
    std::List[common::InstValue]::new
    std::Map[std::String common::NativeCallPlan]::new
    common::Program = program

    program emitter::Emitter::new = emitter
    emitter.emit_bss
    emitter.into_asm = result

    "has bss section" result ".section .bss" assert_contains
    "omits runtime global storage" 0 result.as_str "globals:" str::find < test::assert_true
    "has constants" result "constants: .skip 16" assert_contains
    "has return stack" result "return_stack: .skip 1048576" assert_contains
    "omits fixed heap" 0 result.as_str "heap: .skip" str::find < test::assert_true
    "has heap chunks" result "heap_chunks: .skip 8" assert_contains
    "has heap_ptr" result "heap_ptr: .skip 8" assert_contains
    "has heap end" result "heap_end: .skip 8" assert_contains
    "has free list" result "free_list: .skip 8" assert_contains
    "has small free lists" result "small_free_lists: .skip 512" assert_contains
    "has argc" result "__argc: .skip 8" assert_contains
    "has argv" result "__argv: .skip 8" assert_contains
    "has print_buf" result "print_buf: .skip 32" assert_contains
}

pub fn test_emit_data {
    "emit_data" test::test_start
    std::List[std::String]::new = strings
    "hello" strings.push_str
    "world" strings.push_str

    0
    std::List[common::StaticStruct]::new
    std::List[common::StaticArray]::new
    strings
    std::Map[std::String std::List[common::InstValue]]::new
    std::List[common::InstValue]::new
    std::Map[std::String common::NativeCallPlan]::new
    common::Program = program

    program emitter::Emitter::new = emitter
    emitter.emit_data
    emitter.into_asm = result

    "has data section" result ".section .data" assert_contains
    "has str_0 label" result "str_0:" assert_contains
    "has str_1 label" result "str_1:" assert_contains
    "has quad 5 for hello" result ".quad 5" assert_contains
    "has hello ascii" result ".asciz \"hello\"" assert_contains
    "has quad 5 for world" result ".quad 5" assert_contains
    "has bool_true" result "bool_true:" assert_contains
    "has bool_false" result "bool_false:" assert_contains
}

