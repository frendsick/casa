import "std" as std

# The 384 KiB argument is passed in memory.
extern struct Large derives std::Copy {
    words: array[u64 49152]
}

extern fn casa_extern_take_large value:Large

const FRAME_WORDS 1024

# Each frame holds about 16 KiB. At this depth about 175 KiB of return stack
# remain, so the argument copy would start below the 64 KiB guard region.
const OVERFLOW_DEPTH 26

fn take_large memory:ptr {
    unsafe { memory ptr::read[Large] casa_extern_take_large }
    "large argument passed\n" print
}

fn take_large_after_frames memory:ptr depth:i64 values:array[u64 FRAME_WORDS] {
    if depth 0 > then
        values depth 1 - memory take_large_after_frames
    else
        memory take_large
    fi
}
unsafe {
    393216 alloc = memory
    8192 alloc ptr::read[array[u64 FRAME_WORDS]] = values
    values 0 memory take_large_after_frames
    values OVERFLOW_DEPTH memory take_large_after_frames
}
