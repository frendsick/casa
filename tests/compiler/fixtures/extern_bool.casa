import "std" as std

extern fn casa_bool_parameter_is_false value:bool -> bool

extern fn casa_bool_parameter_is_true value:bool -> bool

extern fn casa_bool_dirty_false -> bool

extern fn casa_bool_loop_next -> bool

if unsafe { false casa_bool_parameter_is_false } then
    0 drop
else
    1 std::exit
fi
if unsafe { true casa_bool_parameter_is_true } then
    0 drop
else
    1 std::exit
fi
if unsafe { casa_bool_dirty_false } then
    1 std::exit
fi
0 = iterations
while unsafe { casa_bool_loop_next } do
    1 += iterations
done
if 1 iterations == then
    0 drop
else
    1 std::exit
fi
"extern bool ok\n" print
