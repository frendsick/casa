import "../../../lib/std.casa" as std

pub const SELECTIVE_BASE 40

pub fn selective_inc x:i64 -> i64 { x 2 + }

pub struct InternalBox {
    value: i64
}

impl InternalBox {
    pub fn leaked -> i64 { 99 }
}

pub fn selected_value -> i64 { 1 InternalBox drop SELECTIVE_BASE selective_inc }

pub fn hidden_value -> i64 { 0 }

pub struct SelectiveBox {
    pub value: i64
}

impl SelectiveBox {
    pub fn double self:$SelectiveBox -> i64 { self SelectiveBox::value 2 * }
}

pub fn make_box -> SelectiveBox { 5 SelectiveBox }

pub enum SelectiveColor {
    Red
    Green
}

impl SelectiveColor {
    pub fn code self:SelectiveColor -> i64 {
        self match
            SelectiveColor::Red => 1
            SelectiveColor::Green => 2
        end
    }
}
1 std::exit
