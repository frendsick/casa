# Move a generated texture with the mouse. Resource owners clean up on scope exit.
import "raylib"
import "std"

const WINDOW_WIDTH 800
const WINDOW_HEIGHT 450
const TARGET_FPS 60
const IMAGE_WIDTH 64
const IMAGE_HEIGHT 48

fn draw_demo context:$raylib::Context drawing:mut$raylib::Drawing -> std::Option[bool] {
    raylib::Color { r: 80 g: 80 b: 80 a: 255 } = dark_gray
    raylib::Color { r: 245 g: 245 b: 245 a: 255 } = ray_white
    ray_white IMAGE_HEIGHT IMAGE_WIDTH raylib::Image::new ? = image
    context image raylib::Texture::new = upload
    drop
    upload ? = texture
    TARGET_FPS context.set_target_fps

    while context.should_close ! do
        context.mouse_position = position
        texture drawing.begin = frame
        dark_gray frame.clear
        ray_white position frame.draw_texture
    done
    true std::Option::Some
}

fn main {
    "Casa raylib example".as_cstr.unwrap = title
    if title WINDOW_HEIGHT WINDOW_WIDTH raylib::Window::new std::Option::Some(window) is then
        window.split = drawing = context
        if drawing context draw_demo std::Option::None is then
            "Could not create the image or texture.\n" print
        fi
    else
        "Could not open the window.\n" print
    fi
}
main
