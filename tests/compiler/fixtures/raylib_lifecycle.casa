import "raylib"
import "std"
import "../../../lib/test.casa" as test

extern fn FixtureNextImageFormat format:i32

fn finish_early drawing:mut$raylib::Drawing texture:$raylib::Texture {
    texture drawing.begin = frame
    return
}

fn exercise window:mut$raylib::Window {
    window.split = drawing = context
    raylib::Color { r: 245 g: 245 b: 245 a: 255 } = white
    white 48 64 raylib::Image::new.unwrap = unused
    unused drop
    white 48 64 raylib::Image::new.unwrap = image
    context image raylib::Texture::new = upload = image
    upload.unwrap = texture
    white 48 65 raylib::Image::new.unwrap = wrong_width
    "reject mismatched width" wrong_width texture.update_from ! test::assert_true
    white 49 64 raylib::Image::new.unwrap = wrong_height
    "reject mismatched height" wrong_height texture.update_from ! test::assert_true
    unsafe { 8 FixtureNextImageFormat }
    white 48 64 raylib::Image::new.unwrap = wrong_format
    "reject mismatched format" wrong_format texture.update_from ! test::assert_true
    raylib::Color { r: 80 g: 80 b: 80 a: 255 } image.clear
    "negative x" white 0 -1 image.set_pixel ! test::assert_true
    "negative y" white -1 0 image.set_pixel ! test::assert_true
    "x past edge" white 0 64 image.set_pixel ! test::assert_true
    "y past edge" white 48 0 image.set_pixel ! test::assert_true
    "last valid pixel" white 47 63 image.set_pixel test::assert_true
    "update edited image" image texture.update_from test::assert_true
    texture drawing.begin = frame
    white 8.0 raylib::Vector2 { x: 0.0 y: 0.0 } frame.draw_texture_scaled
    frame drop
    texture drawing finish_early
}

fn open_dynamic_title -> raylib::Window {
    "Casa raylib example".to_str = title
    title
        .as_str
        .as_cstr
        .unwrap 450 800 raylib::Window::new.unwrap
}

fn main {
    "Casa raylib example".as_cstr.unwrap = title
    "zero window width" title 450 0 raylib::Window::new.is_none test::assert_true
    "negative window height" title -1 800 raylib::Window::new.is_none test::assert_true
    raylib::Color { r: 245 g: 245 b: 245 a: 255 } = white
    "zero image width" white 48 0 raylib::Image::new.is_none test::assert_true
    "negative image height" white -1 64 raylib::Image::new.is_none test::assert_true
    "image size overflow" white 2147483647 2147483647 raylib::Image::new.is_none test::assert_true
    open_dynamic_title = window
    "second window rejected" title 450 800 raylib::Window::new.is_none test::assert_true
    window exercise
    window drop
    "".as_cstr.unwrap 450 800 raylib::Window::new.unwrap = reopened
    reopened exercise
}
main
