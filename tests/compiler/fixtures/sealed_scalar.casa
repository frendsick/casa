fn factorial value:i64 -> i64 {
    if 1 value <= then
        1 return
    fi
    value 1 - factorial value *
}

fn choose value:i64 -> i64 {
    9 = local
    if 0 value < then
        local return
    elif 0 value == then
        7 return
    else
        value 2 +
    fi
}

fn sum_five -> i64 { 1 2 3 4 5 + + + + }

fn duplicate_full -> i64 { 1 2 3 4 dup + + + + }

fn over_full -> i64 { 1 2 3 4 over + + + + }

fn signed value:i8 -> i8 { value 2 + }

fn unsigned value:u64 -> bool { 5 value > }

