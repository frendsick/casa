import "std"
import "io"
import "test"

io::StdinReader::new = reader
"fresh reader" reader.has_buffered_input test::assert_false
"first byte" 97 reader io::stdin_read_byte test::assert_eq
"second byte remains buffered" reader.has_buffered_input test::assert_true
"second byte" 98 reader io::stdin_read_byte test::assert_eq
"buffer exhausted" reader.has_buffered_input test::assert_false
"end of input" -1 reader io::stdin_read_byte test::assert_eq
"end of input stays empty" reader.has_buffered_input test::assert_false
