import "std" as std

pub struct Counter {
    pub value: i64
    secret:    i64
}

impl Counter {
    pub fn new value:i64 -> Counter { 3 value Counter }

    pub fn total self:$Counter -> i64 { self.secret self.value + }

    fn hidden self:$Counter -> i64 { self.secret }
}

fn hidden -> i64 { 99 }

pub fn answer -> i64 { 42 }

# Imported top-level program bodies must not run.
1 std::exit
