import "std" as std

global OFFSET 2
pub global PUBLIC_VALUE { OFFSET 40 + }

pub struct Counter {
    pub value: i64
    secret:    i64
}

pub struct PublicPair {
    pub left:  i64
    pub right: i64
}

pub struct SecretBox[T] {
    pub value: T
    secret:    i64
}

pub extern struct NativeToken {
    secret: u64
}

impl Counter {
    pub fn new value:i64 -> Counter { 3 value Counter }

    pub fn total self:$Counter -> i64 { self.secret self.value + }

    fn hidden self:$Counter -> i64 { self.secret }
}

fn hidden -> i64 { 99 }

pub fn answer -> i64 { PUBLIC_VALUE }

# Imported top-level program bodies must not run.
1 process::exit
