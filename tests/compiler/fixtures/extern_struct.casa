import "std" as std
import "extern_struct_types.casa" as fixture

pub extern struct Packet {
    pub tag:     u8
    pub tiny:    fixture::Tiny
    pub samples: array[u16 3]
    pub weight:  f32
    pub address: ptr
    pub active:  bool
}

extern fn casa_extern_struct_is_initial value:$Packet -> bool

extern fn casa_extern_struct_has_casa_mutation value:$Packet -> bool

extern fn casa_extern_struct_mutate value:mut$Packet

extern fn casa_extern_struct_has_native_mutation value:$Packet -> bool

false ptr::null 1.5 [10, 20, 30] true 513 fixture::Tiny 7 Packet = packet
if packet.tiny.is_set ! then
    1 process::exit
fi
if unsafe { packet casa_extern_struct_is_initial } ! then
    1 process::exit
fi
8 = packet.tag
514 = packet.tiny.value
false = packet.tiny.flag
if packet.tiny.is_set then
    1 process::exit
fi
2.5 = packet.weight
true = packet.active
if unsafe { packet casa_extern_struct_has_casa_mutation } ! then
    1 process::exit
fi
unsafe { packet casa_extern_struct_mutate }
if packet.tag 9 != then
    1 process::exit
fi
if packet.tiny.value 1025 != then
    1 process::exit
fi
if packet.tiny.flag ! then
    1 process::exit
fi
if packet.weight 3.5 != then
    1 process::exit
fi
if packet.active then
    1 process::exit
fi
if unsafe { packet casa_extern_struct_has_native_mutation } ! then
    1 process::exit
fi
"extern struct ok\n" print
