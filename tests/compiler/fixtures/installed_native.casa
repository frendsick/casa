# Compile with -l m, without Casa library sources beside the compiler.
extern fn sqrt value:f64 -> f64

# Force allocator growth beyond its normal 64 MiB chunk.
const LARGE_ALLOCATION_BYTES 67108865
unsafe {
    16 alloc = first
    first free
    16 alloc = reused
    reused free
    0 alloc free
    ptr::null free
    LARGE_ALLOCATION_BYTES alloc = large
    large free
    81.0 = value: f64
    value sqrt 9.0 == print
}
":" print
42 print
"\n" print
