import "../../compiler/bytecode.casa" as bytecode
import "../../compiler/emitter.casa" as emitter
import "helpers.casa" as helpers

# ============================================================================
# Helpers
# ============================================================================

pub fn parse_gs code:$str diagnostics:mut$error::Diagnostics -> common::SymbolStore {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    ops drop
    store
}

pub fn resolve_gs code:$str diagnostics:mut$error::Diagnostics -> std::List[common::Op] {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    store drop
    ops
}

pub fn tc_gs code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

pub fn compile_gs code:$str diagnostics:mut$error::Diagnostics -> common::Program {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test drop
    store ops helpers::compile_test_program
}

pub fn emit_gs code:$str diagnostics:mut$error::Diagnostics -> std::String {
    diagnostics code compile_gs emitter::emit
}

pub fn assert_contains needle:$str haystack:$str msg:$str {
    haystack needle str::find = position
    if 0 position < then
        msg false test::assert_true
    else
        msg true test::assert_true
    fi
}

# ============================================================================
# Parser tests
# ============================================================================

pub fn test_parse_generic_struct {
    error::Diagnostics::new = diagnostics
    "parse_generic_struct" test::test_start
    diagnostics "struct Box[T] { value: T }" parse_gs = store
    "registered" "Box" store
        .structs
        .get_str
        .is_some test::assert_true
    "Box" store
        .structs
        .get_str
        .unwrap = box_struct
    "type vars count" 1 box_struct common::CasaStruct::type_vars.length test::assert_eq
    "type var T" "T" 0 box_struct common::CasaStruct::type_vars.get test::assert_str_eq
    "member name" "value" 0 box_struct common::CasaStruct::members.get common::Member::name test::assert_str_eq
    "member type is structural" "T".to_str common::Type::TypeVar 0 box_struct common::CasaStruct::members.get common::Member::typ.eq test::assert_true
}

pub fn test_parse_generic_struct_multiple_type_vars {
    error::Diagnostics::new = diagnostics
    "parse_generic_struct_multiple_type_vars" test::test_start
    diagnostics "struct Pair[A B] { first: A second: B }" parse_gs = store
    "Pair" store
        .structs
        .get_str
        .unwrap = pair_struct
    "type vars count" 2 pair_struct common::CasaStruct::type_vars.length test::assert_eq
    "type var A" "A" 0 pair_struct common::CasaStruct::type_vars.get test::assert_str_eq
    "type var B" "B" 1 pair_struct common::CasaStruct::type_vars.get test::assert_str_eq
}

pub fn test_parse_struct_rejects_trait_bounds {
    error::Diagnostics::new = diagnostics
    "parse_struct_rejects_trait_bounds" test::test_start
    diagnostics "trait Hashable { fn hash i64 -> i64 }\nstruct Set[K: Hashable] { data: K }" parse_gs drop
    diagnostics "has errors" helpers::assert_has_errors
}

pub fn test_parse_generic_struct_generates_getter {
    error::Diagnostics::new = diagnostics
    "parse_generic_struct_generates_getter" test::test_start
    diagnostics "struct Box[T] { value: T }" parse_gs = store
    "getter exists" "Box::value" store.get_function.is_some test::assert_true
    "Box::value" store.get_function.unwrap = getter
    0 getter common::Function::stack_effect common::StackEffect::parameters.get common::Parameter::typ = receiver_type: $common::Type
    "getter receiver is shared" receiver_type.is_shared_borrow test::assert_true
    if receiver_type.borrow_target.unwrap common::Type::Generic(receiver) is then
        "getter receiver base" "Box" receiver.base test::assert_str_eq
        "getter receiver type var" "T".to_str common::Type::TypeVar 0 receiver
            .params
            .get
            .eq test::assert_true
    else
        "getter receiver is generic" false test::assert_true
    fi
    "getter return type" "T".to_str common::Type::TypeVar 0 getter common::Function::stack_effect common::StackEffect::return_types.get.eq test::assert_true
}

pub fn test_parse_fixed_array_getter_borrows_field_storage {
    error::Diagnostics::new = diagnostics
    "parse_fixed_array_getter_borrows_field_storage" test::test_start
    diagnostics "struct Box { values: array[u8 3] }" parse_gs = store
    "Box::values" store.get_function.unwrap = getter
    "getter defers fixed array projection" 2 getter
        .ops
        .get
        .value common::OpValue::StructMemberProject is test::assert_true
}

pub fn test_parse_generic_struct_generates_setter {
    error::Diagnostics::new = diagnostics
    "parse_generic_struct_generates_setter" test::test_start
    diagnostics "struct Box[T] { value: T }" parse_gs = store
    "setter exists" "Box::set_value" store.get_function.is_some test::assert_true
    "Box::set_value" store.get_function.unwrap = setter
    0 setter common::Function::stack_effect common::StackEffect::parameters.get common::Parameter::typ = receiver_type: $common::Type
    "setter receiver is exclusive" receiver_type.is_exclusive_borrow test::assert_true
    if receiver_type.borrow_target.unwrap common::Type::Generic(receiver) is then
        "setter receiver base" "Box" receiver.base test::assert_str_eq
        "setter receiver type var" "T".to_str common::Type::TypeVar 0 receiver
            .params
            .get
            .eq test::assert_true
    else
        "setter receiver is generic" false test::assert_true
    fi
    "setter value type" "T".to_str common::Type::TypeVar 1 setter common::Function::stack_effect common::StackEffect::parameters.get common::Parameter::typ.eq test::assert_true
}

