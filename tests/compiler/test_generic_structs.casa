# ============================================================================
# Resolver test
# ============================================================================

pub fn test_resolve_generic_struct_new {
    error::Diagnostics::new = diagnostics
    "resolve_generic_struct_new" test::test_start
    diagnostics "struct Box[T] { value: T }\n42 Box" resolve_gs = ops
    false std::List[std::String]::new std::List[std::String]::new common::empty_location std::List[common::Member]::new "".to_str common::CasaStruct drop
    ops find_struct_new_ops = struct_new_ops
    "has struct new op" 1 struct_new_ops.length test::assert_eq
}

pub fn find_struct_new_ops ops:std::List[common::Op] -> std::List[common::Op] {
    std::List[common::Op]::new = result
    0 = index: u64
    while index ops.length > do
        index ops.get = op
        if op.value common::OpValue::StructNew is then
            op.clone result.push
        fi
        1 += index
    done
    result
}

