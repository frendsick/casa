# ============================================================================
# Resolver test
# ============================================================================

fn test_resolve_generic_struct_new {
    Diagnostics::new = diagnostics
    "resolve_generic_struct_new" test_start
    diagnostics "struct Box[T] { value: T }\n42 Box" resolve_gs = ops
    List::new(List[str]) empty_location List::new(List[Member]) "" CasaStruct OpValue::StructNew ops find_ops_by_kind = struct_new_ops
    "has struct new op" 1 struct_new_ops.length assert_eq
}

fn find_ops_by_kind ops:List[Op] kind:OpValue -> List[Op] {
    List::new(List[Op]) = result
    0 (u64) = index
    while index ops.length > do
        index ops.get = op
        if op.value kind == then
            op result.push
        fi
        1 += index
    done
    result
}

