    Diagnostics::new = diagnostics
    "typecheck_generic_struct_infers_type" test_start
    diagnostics "struct Box[T] { value: T }\n42 Box" tc_gs = sig
    "returns Box[i64]" "Box[i64]" 0 sig StackEffect::return_types.get.format assert_str_eq
}

