pub fn test_parse_impl_with_type_params {
    error::Diagnostics::new = diagnostics
    "parse_impl_with_type_params" test::test_start
    diagnostics "trait Hashable { fn hash i64 -> i64 }\nstruct Box[K] { data: K }\nimpl[K: Hashable] Box[K] {\n    fn get self:Box[K] -> K { self Box::data }\n}\n" parse_gs = store
    "method exists" "Box::get" store.get_function.is_some test::assert_true
}

pub fn test_parse_impl_with_nested_receiver_type {
    error::Diagnostics::new = diagnostics
    "parse_impl_with_nested_receiver_type" test::test_start
    diagnostics "struct Box[T] { value: T }\nstruct Wrapper[T] { value: T }\nimpl[T] Wrapper[Box[T]] { fn get self:Wrapper[Box[T]] -> Box[T] { self .value } }" parse_gs = store
    "nested receiver method exists" "Wrapper::get" store.get_function.is_some test::assert_true
}

pub fn test_concrete_impl_methods_use_exact_receivers {
    error::Diagnostics::new = diagnostics
    "concrete_impl_methods_use_exact_receivers" test::test_start
    "struct Box[T] { value: T }\nimpl Box[i64] { fn tag self:Box[i64] -> i64 { self drop 1 } }\nimpl Box[bool] { fn tag self:Box[bool] -> bool { self drop true } }"
    = source
    diagnostics source parse_gs = store
    diagnostics "concrete impls parse" helpers::assert_no_errors
    "i64 method exists" "Box[i64]::tag" store.get_function.is_some test::assert_true
    "bool method exists" "Box[bool]::tag" store.get_function.is_some test::assert_true

    error::Diagnostics::new = typecheck_diagnostics
    typecheck_diagnostics
    source.as_str
    "\nfn i64_tag -> fn[Box[i64] -> i64] { &Box[i64]::tag }\n1 Box Box[i64]::tag drop true Box Box[bool]::tag drop i64_tag drop"
    str::concat.as_str tc_gs drop
    typecheck_diagnostics "concrete methods resolve by call and reference" helpers::assert_no_errors

    error::Diagnostics::new = precedence_diagnostics
    precedence_diagnostics
    "struct PrecedenceBox[T] { value: T } impl[T] PrecedenceBox[T] { fn pick self:PrecedenceBox[T] -> i64 { self drop 1 } } impl PrecedenceBox[i64] { fn pick self:PrecedenceBox[i64] -> bool { self drop true } } 1 PrecedenceBox PrecedenceBox[i64]::pick"
    tc_gs = precedence_effect
    precedence_diagnostics "qualified exact method typechecks" helpers::assert_no_errors
    "qualified call prefers exact method" common::make_bool_type 0 precedence_effect
        .return_types
        .get
        .eq test::assert_true
}

pub fn test_concrete_trait_impls_use_exact_receivers {
    error::Diagnostics::new = diagnostics
    "concrete_trait_impls_use_exact_receivers" test::test_start
    "trait Tagged { fn tag self:self -> i64 } struct Box[T] { value: T } impl Box[i64]: Tagged { fn tag self:Box[i64] -> i64 { self drop 1 } fn extra self:Box[i64] -> i64 { self drop 3 } } impl Box[bool]: Tagged { fn tag self:Box[bool] -> i64 { self drop 2 } fn extra self:Box[bool] -> i64 { self drop 4 } }"
    = source
    diagnostics source parse_gs = store
    diagnostics "concrete trait impls parse" helpers::assert_no_errors
    "i64 trait method exists" "Box[i64]::Tagged::tag" store.get_function.is_some test::assert_true
    "bool trait method exists" "Box[bool]::Tagged::tag" store.get_function.is_some test::assert_true
    "i64 extra method alias exists" "Box[i64]::extra" store.get_function.is_some test::assert_true
    "bool extra method alias exists" "Box[bool]::extra" store.get_function.is_some test::assert_true

    error::Diagnostics::new = typecheck_diagnostics
    typecheck_diagnostics
    f"{source} 1 Box .tag drop true Box .tag drop 1 Box .extra drop true Box .extra drop".as_str
    tc_gs drop
    typecheck_diagnostics "concrete trait methods dispatch" helpers::assert_no_errors
}

