import "../../compiler/typechecker.casa"
import "../../compiler/bytecode.casa"
import "../../compiler/emitter.casa"
import "helpers.casa"

# ============================================================================
# Helpers
# ============================================================================

fn parse_gs code:str diagnostics:Diagnostics -> ParseResolveResult {
    diagnostics code parse_resolve_test_source
}

fn resolve_gs code:str diagnostics:Diagnostics -> List[Op] {
    diagnostics code parse_resolve_test_source ParseResolveResult::ops.unwrap
}

fn tc_gs code:str diagnostics:Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option::None(Option[Function]) ops type_check_ops_for_test
}

fn compile_gs code:str diagnostics:Diagnostics -> Program {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option::None(Option[Function]) ops type_check_ops_for_test drop
    store ops compile_test_program
}

fn emit_gs code:str diagnostics:Diagnostics -> str {
    diagnostics code compile_gs emit
}

fn assert_contains needle:str haystack:str msg:str {
    haystack needle str::find = position
    if 0 position < then
        msg false assert_true
    else
        msg true assert_true
    fi
}

# ============================================================================
# Parser tests
# ============================================================================

fn test_parse_generic_struct {
    Diagnostics::new = diagnostics
    "parse_generic_struct" test_start
    diagnostics "struct Box[T] { value: T }" parse_gs = result
    result ParseResolveResult::store = store
    "registered" "Box" store.structs.get.is_some assert_true
    "Box" store.structs.get.unwrap = box_struct
    "type vars count" 1 box_struct CasaStruct::type_vars.length assert_eq
    "type var T" "T" 0 box_struct CasaStruct::type_vars.get assert_str_eq
    "member name" "value" 0 box_struct CasaStruct::members.get Member::name assert_str_eq
    "member type is structural" "T" Type::TypeVar 0 box_struct CasaStruct::members.get Member::typ.eq assert_true
}

fn test_parse_generic_struct_multiple_type_vars {
    Diagnostics::new = diagnostics
    "parse_generic_struct_multiple_type_vars" test_start
    diagnostics "struct Pair[A B] { first: A second: B }" parse_gs = result
    result ParseResolveResult::store = store
    "Pair" store.structs.get.unwrap = pair_struct
    "type vars count" 2 pair_struct CasaStruct::type_vars.length assert_eq
    "type var A" "A" 0 pair_struct CasaStruct::type_vars.get assert_str_eq
    "type var B" "B" 1 pair_struct CasaStruct::type_vars.get assert_str_eq
}

fn test_parse_struct_rejects_trait_bounds {
    Diagnostics::new = diagnostics
    "parse_struct_rejects_trait_bounds" test_start
    diagnostics "trait Hashable { fn hash i64 -> i64 }\nstruct Set[K: Hashable] { data: K }" parse_gs drop
    diagnostics "has errors" assert_has_errors
}

fn test_parse_generic_struct_generates_getter {
    Diagnostics::new = diagnostics
    "parse_generic_struct_generates_getter" test_start
    diagnostics "struct Box[T] { value: T }" parse_gs = result
    result ParseResolveResult::store = store
    "getter exists" "Box::value" store.functions.get.is_some assert_true
    "Box::value" store.functions.get.unwrap = getter
    0 getter Function::stack_effect StackEffect::parameters.get Parameter::typ = receiver_type
    if receiver_type Type::Generic(receiver) is then
        "getter receiver base" "Box" receiver.base assert_str_eq
        "getter receiver type var" "T" Type::TypeVar 0 receiver.params.get.eq assert_true
    else
        "getter receiver is generic" false assert_true
    fi
    "getter return type" "T" Type::TypeVar 0 getter Function::stack_effect StackEffect::return_types.get.eq assert_true
}

fn test_parse_generic_struct_generates_setter {
    Diagnostics::new = diagnostics
    "parse_generic_struct_generates_setter" test_start
    diagnostics "struct Box[T] { value: T }" parse_gs = result
    result ParseResolveResult::store = store
    "setter exists" "Box::set_value" store.functions.get.is_some assert_true
    "Box::set_value" store.functions.get.unwrap = setter
    0 setter Function::stack_effect StackEffect::parameters.get Parameter::typ = receiver_type
    if receiver_type Type::Generic(receiver) is then
        "setter receiver base" "Box" receiver.base assert_str_eq
        "setter receiver type var" "T" Type::TypeVar 0 receiver.params.get.eq assert_true
    else
        "setter receiver is generic" false assert_true
    fi
    "setter value type" "T" Type::TypeVar 1 setter Function::stack_effect StackEffect::parameters.get Parameter::typ.eq assert_true
}

fn test_parse_nongeneric_struct_has_empty_type_vars {
    Diagnostics::new = diagnostics
    "parse_nongeneric_struct_has_empty_type_vars" test_start
    diagnostics "struct Point { x: i64 y: i64 }" parse_gs = result
    result ParseResolveResult::store = store
    "Point" store.structs.get.unwrap = point_struct
    "no type vars" 0 point_struct CasaStruct::type_vars.length assert_eq
}

fn test_parse_impl_with_type_params {
    Diagnostics::new = diagnostics
    "parse_impl_with_type_params" test_start
    diagnostics "trait Hashable { fn hash i64 -> i64 }\nstruct Box[K] { data: K }\nimpl[K: Hashable] Box[K] {\n    fn get self:Box[K] -> K { self Box::data }\n}\n" parse_gs = result
    result ParseResolveResult::store = store
    "method exists" "Box::get" store.functions.get.is_some assert_true
}

fn test_parse_impl_with_nested_receiver_type {
    Diagnostics::new = diagnostics
    "parse_impl_with_nested_receiver_type" test_start
    diagnostics "struct Box[T] { value: T }\nstruct Wrapper[T] { value: T }\nimpl[T] Wrapper[Box[T]] { fn get self:Wrapper[Box[T]] -> Box[T] { self .value } }" parse_gs = result
    result ParseResolveResult::store = store
    "nested receiver method exists" "Wrapper::get" store.functions.get.is_some assert_true
}

