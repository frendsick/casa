import "std"
import "../../lib/test.casa" as test

const MAX_INDEX: u64 0xFFFFFFFFFFFFFFFF

struct Item {
    value: i64
    drops: ptr
}

impl Item {
    fn drop self:mut$Item {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

fn drop_count drops:ptr -> i64 {
    unsafe { drops load64 i64::try_from.unwrap }
}

fn test_invalid_indices {
    "list_mutation_invalid_indices" test::test_start
    std::List[i64]::new = empty
    [0, 1, MAX_INDEX] = empty_indices: array[u64 3]
    for index in empty_indices.iter do
        "empty set returns item" 10 10 index copy empty.set.unwrap_error test::assert_eq
        "empty replace returns item" 20 20 index copy empty.replace.unwrap_error test::assert_eq
        if 0 index copy != then
            "empty insert returns item" 30 index copy 30 empty.insert.unwrap_error test::assert_eq
        fi
        "invalid operations keep list empty" 0 empty.length test::assert_eq
    done

    [10, 20] std::List::from_array = values
    [2, 3, MAX_INDEX] = indices: array[u64 3]
    values.as_ptr = original_storage
    for index in indices.iter do
        "set returns rejected item" 30 30 index copy values.set.unwrap_error test::assert_eq
        "replace returns rejected item" 40 40 index copy values.replace.unwrap_error test::assert_eq
        if 2 index copy != then
            "insert returns rejected item" 50 index copy 50 values.insert.unwrap_error test::assert_eq
        fi
        "failed mutation preserves storage" original_storage values.as_ptr == test::assert_true
        "failed mutation preserves length" 2 values.length test::assert_eq
        "failed mutation preserves first element" 10 0 values.get test::assert_eq
        "failed mutation preserves last element" 20 1 values.get test::assert_eq
    done
}

fn test_successful_mutations {
    "list_mutation_success" test::test_start
    std::List[i64]::new = values
    0 20 values.insert.unwrap drop
    0 10 values.insert.unwrap drop
    1 15 values.insert.unwrap drop
    values.length 30 values.insert.unwrap drop
    "insertion length" 4 values.length test::assert_eq
    "insert at front" 10 0 values.get test::assert_eq
    "insert in middle" 15 1 values.get test::assert_eq
    "shifted element" 20 2 values.get test::assert_eq
    "insert at end" 30 3 values.get test::assert_eq
    11 0 values.set.unwrap drop
    31 3 values.set.unwrap drop
    "set first" 11 0 values.get test::assert_eq
    "set last" 31 3 values.get test::assert_eq
    "replace returns previous first" 11 12 0 values.replace.unwrap test::assert_eq
    "replace returns previous last" 31 32 3 values.replace.unwrap test::assert_eq
    "replace first" 12 0 values.get test::assert_eq
    "replace last" 32 3 values.get test::assert_eq
    "set and replace preserve length" 4 values.length test::assert_eq
}

fn test_owned_items {
    "list_mutation_owned_items" test::test_start
    unsafe { 8 alloc = drops 0 drops store64 }
    std::List[Item]::new = values
    drops 10 Item values.push

    drops 20 Item 1 values.set.unwrap_error = rejected_set
    drops 30 Item MAX_INDEX values.replace.unwrap_error = rejected_replace
    2 drops 40 Item values.insert.unwrap_error = rejected_insert
    "errors preserve all owners" 0 drops drop_count test::assert_eq
    "rejected set value" 20 rejected_set.value test::assert_eq
    "rejected replace value" 30 rejected_replace.value test::assert_eq
    "rejected insert value" 40 rejected_insert.value test::assert_eq
    "failed updates preserve existing item" 10 0 values.get.value test::assert_eq
    rejected_set drop
    rejected_replace drop
    rejected_insert drop
    "caller destroys rejected items once" 3 drops drop_count test::assert_eq

    drops 50 Item 0 values.set.unwrap drop
    "set destroys previous item once" 4 drops drop_count test::assert_eq
    drops 60 Item 0 values.replace.unwrap = previous
    "replace transfers previous owner" 4 drops drop_count test::assert_eq
    "replace returns previous value" 50 previous.value test::assert_eq
    previous drop
    "caller destroys previous item once" 5 drops drop_count test::assert_eq

    for index in 12 1 std::Range::new do
        values.length drops index i64::try_from.unwrap Item values.insert.unwrap drop
    done
    0 drops 70 Item values.insert.unwrap drop
    6 drops 80 Item values.insert.unwrap drop
    "growth and shifts preserve owners" 5 drops drop_count test::assert_eq
    "front insertion after growth" 70 0 values.get.value test::assert_eq
    "middle insertion after growth" 80 6 values.get.value test::assert_eq
    "original item survives shifts" 60 1 values.get.value test::assert_eq
    "last item survives shifts" 11 13 values.get.value test::assert_eq
    values drop
    "list destroys remaining owners once" 19 drops drop_count test::assert_eq
    unsafe { drops free }
}
test_invalid_indices
test_successful_mutations
test_owned_items
test::test_summary
