fn test_malformed_utf8_source_rejected {
    "malformed_utf8_source_rejected" test_start
    String::new = builder
    unsafe { 255 (u8) builder.push_byte_unchecked }
    "test" builder.as_str lex_source = result
    "malformed UTF-8" result.diagnostics.has_errors assert_true
}

# ============================================================================
# Fat arrow delimiter
# ============================================================================

fn test_fat_arrow_delimiter {
    "fat_arrow_delimiter" test_start
    "test" "=>" lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "kind" TokenKind::Delimiter 0 tokens.get Token::kind == assert_true
    "value" "=>" 0 tokens.get Token::value.as_str assert_str_eq
}

fn test_fat_arrow_in_match {
    "fat_arrow_in_match" test_start
    "test" "Up => 1" lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "Up kind" TokenKind::Identifier 0 tokens.get Token::kind == assert_true
    "arrow kind" TokenKind::Delimiter 1 tokens.get Token::kind == assert_true
    "arrow value" "=>" 1 tokens.get Token::value.as_str assert_str_eq
    "1 kind" TokenKind::Literal 2 tokens.get Token::kind == assert_true
}

