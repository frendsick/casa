pub fn test_lex_result_success {
    "lex_result_success" test::test_start
    "test" "42" lexer::lex_source = result
    "usable tokens" 2 result.tokens.length test::assert_eq
    "no diagnostics" result.diagnostics.has_errors ! test::assert_true
}

pub fn test_lex_result_recoverable_error {
    "lex_result_recoverable_error" test::test_start
    "test" "\"bad\\q\"" lexer::lex_source = result
    "usable tokens" 1 result.tokens.length > test::assert_true
    "has diagnostics" result.diagnostics.has_errors test::assert_true
}

pub fn test_lex_file_reports_io_error {
    "lex_file_reports_io_error" test::test_start
    lexer::SourceStore::new = sources
    sources "/tmp/casa_missing_256.casa" lexer::lex_file = result
    "io error" result.is_error test::assert_true
}

pub fn test_source_store_prefers_normalized_override {
    "source_store_prefers_normalized_override" test::test_start
    lexer::SourceStore::new = sources
    "/tmp/casa_source_store_override.casa" = path
    "99" path.clone file::write_all drop
    "42" "/tmp/unused/../casa_source_store_override.casa" sources.add
    sources path lexer::lex_file = result
    path.clone file::remove drop
    "override read" result.is_ok test::assert_true
    "override token" "42" 0 result
        .unwrap
        .tokens
        .get common::Token::value.as_str test::assert_str_eq
}

pub fn test_source_store_missing_lookup_is_explicit {
    "source_store_missing_lookup_is_explicit" test::test_start
    lexer::SourceStore::new = sources
    "missing source" "/tmp/casa_missing_source.casa" sources.get.is_none test::assert_true
}

pub fn test_source_store_lookup_borrows_source {
    "source_store_lookup_borrows_source" test::test_start
    lexer::SourceStore::new = sources
    "42" "borrowed.casa" sources.add
    "borrowed.casa" sources.get = source: std::Option[$std::String]
    "borrowed source" "42" source.unwrap.as_str test::assert_str_eq
}

pub fn test_import_lexical_diagnostics_are_merged {
    "import_lexical_diagnostics_are_merged" test::test_start
    lexer::SourceStore::new = sources
    "\"bad\\q\"" "/tmp/casa_import_256.casa" sources.add
    "root" "import \"/tmp/casa_import_256.casa\"" lexer::lex_source = root
    root.into_parts = diagnostics = tokens
    sources diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve = result
    "import diagnostic" result.diagnostics.has_errors test::assert_true
}

