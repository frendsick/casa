fn test_hashtag_comment_skips {
    "hashtag_comment_skips" test_start
    "test" "# this is a comment" lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "count" 1 tokens.length assert_eq
    "eof kind" TokenKind::Eof 0 tokens.get Token::kind == assert_true
}

