fn test_unicode_literals {
    "unicode_literals" test_start
    "test" "\"hé😀\" 'é' '\\u{1F600}' \"\\u{1F600}\"" lex_source = result
    "valid Unicode literals" result.diagnostics.has_errors ! assert_true
    "direct string" "\"hé😀\"" 0 result.tokens.get Token::value.as_str assert_str_eq
    "direct char" "'é'" 1 result.tokens.get Token::value.as_str assert_str_eq
    "escaped char" "'😀'" 2 result.tokens.get Token::value.as_str assert_str_eq
    "escaped string" "\"😀\"" 3 result.tokens.get Token::value.as_str assert_str_eq
}

fn test_invalid_unicode_escapes {
    "invalid_unicode_escapes" test_start
    "test" "'\\u{D800}'" lex_source = surrogate
    "surrogate" surrogate.diagnostics.has_errors assert_true
    "test" "'\\u{110000}'" lex_source = too_large
    "above maximum" too_large.diagnostics.has_errors assert_true
    "test" "'\\u{}'" lex_source = empty
    "empty" empty.diagnostics.has_errors assert_true
    "test" "'\\u{1234567}'" lex_source = too_many_digits
    "too many digits" too_many_digits.diagnostics.has_errors assert_true
}

fn test_non_ascii_hex_escape_rejected {
    "non_ascii_hex_escape_rejected" test_start
    "test" "\"\\x80\"" lex_source = result
    "non-ASCII hex" result.diagnostics.has_errors assert_true
}

fn test_multiple_scalar_char_rejected {
    "multiple_scalar_char_rejected" test_start
    "test" "'ab'" lex_source = result
    "multiple scalars" result.diagnostics.has_errors assert_true
