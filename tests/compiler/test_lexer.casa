import "../../compiler/common.casa"
import "../../compiler/error.casa"
import "../../compiler/lexer.casa"
import "../../compiler/syntax.casa"
import "../../lib/os.casa"
import "../../lib/test.casa"

fn test_integer_literal {
    "integer_literal" test_start
    "test" "42" lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "token count" 2 tokens.length assert_eq
    "value" "42" 0 tokens.get Token::value.as_str assert_str_eq
    "kind" TokenKind::Literal 0 tokens.get Token::kind == assert_true
}

fn test_keywords {
    "keywords" test_start
    "test" "fn if while" lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "fn kind" TokenKind::Keyword 0 tokens.get Token::kind == assert_true
    "fn value" "fn" 0 tokens.get Token::value.as_str assert_str_eq
    "if kind" TokenKind::Keyword 1 tokens.get Token::kind == assert_true
    "while kind" TokenKind::Keyword 2 tokens.get Token::kind == assert_true
}

fn test_operators {
    "operators" test_start
    "test" "1 2 +" lex_source = lex_result
