pub fn test_unicode_literals {
    "unicode_literals" test::test_start
    "test" "\"hé😀\" 'é' '\\u{1F600}' \"\\u{1F600}\"" lexer::lex_source = result
    "valid Unicode literals" result.diagnostics.has_errors ! test::assert_true
    "direct string" "\"hé😀\"" 0 result.tokens.get common::Token::value.as_str test::assert_str_eq
    "direct char" "'é'" 1 result.tokens.get common::Token::value.as_str test::assert_str_eq
    "escaped char" "'😀'" 2 result.tokens.get common::Token::value.as_str test::assert_str_eq
    "escaped string" "\"😀\"" 3 result.tokens.get common::Token::value.as_str test::assert_str_eq
}

pub fn test_invalid_unicode_escapes {
    "invalid_unicode_escapes" test::test_start
    "test" "'\\u{D800}'" lexer::lex_source = surrogate
    "surrogate" surrogate.diagnostics.has_errors test::assert_true
    "test" "'\\u{110000}'" lexer::lex_source = too_large
    "above maximum" too_large.diagnostics.has_errors test::assert_true
    "test" "'\\u{}'" lexer::lex_source = empty
    "empty" empty.diagnostics.has_errors test::assert_true
    "test" "'\\u{1234567}'" lexer::lex_source = too_many_digits
    "too many digits" too_many_digits.diagnostics.has_errors test::assert_true
}

pub fn test_non_ascii_hex_escape_rejected {
    "non_ascii_hex_escape_rejected" test::test_start
    "test" "\"\\x80\"" lexer::lex_source = result
    "non-ASCII hex" result.diagnostics.has_errors test::assert_true
}

pub fn test_multiple_scalar_char_rejected {
    "multiple_scalar_char_rejected" test::test_start
    "test" "'ab'" lexer::lex_source = result
    "multiple scalars" result.diagnostics.has_errors test::assert_true
}

pub fn test_malformed_utf8_source_rejected {
    "malformed_utf8_source_rejected" test::test_start
    std::String::new = builder
    unsafe { 255 (u8) builder.push_byte_unchecked }
    "test" builder.as_str lexer::lex_source = result
    "malformed UTF-8" result.diagnostics.has_errors test::assert_true
}

