    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "Up kind" common::TokenKind::Identifier 0 tokens.get common::Token::kind == test::assert_true
    "arrow kind" common::TokenKind::Delimiter 1 tokens.get common::Token::kind == test::assert_true
    "arrow value" "=>" 1 tokens.get common::Token::value.as_str test::assert_str_eq
    "1 kind" common::TokenKind::Literal 2 tokens.get common::Token::kind == test::assert_true
}

