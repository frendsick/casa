import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../compiler/syntax.casa" as syntax
import "../../lib/os.casa" as os
import "../../lib/test.casa" as test

pub fn test_integer_literal {
    "integer_literal" test::test_start
    "test" "42" lexer::lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "token count" 2 tokens.length test::assert_eq
    "value" "42" 0 tokens.get common::Token::value.as_str test::assert_str_eq
    "kind" common::TokenKind::Literal 0 tokens.get common::Token::kind == test::assert_true
}

pub fn test_keywords {
    "keywords" test::test_start
    "test" "fn if while" lexer::lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "fn kind" common::TokenKind::Keyword 0 tokens.get common::Token::kind == test::assert_true
    "fn value" "fn" 0 tokens.get common::Token::value.as_str test::assert_str_eq
    "if kind" common::TokenKind::Keyword 1 tokens.get common::Token::kind == test::assert_true
    "while kind" common::TokenKind::Keyword 2 tokens.get common::Token::kind == test::assert_true
}

