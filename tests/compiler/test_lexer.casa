# Hex escape sequences
# ============================================================================

pub fn test_string_hex_escape_printable {
    "string_hex_escape_printable" test::test_start
    "test" "\"\\x41\"" lexer::lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "kind" common::TokenKind::Literal 0 tokens.get common::Token::kind == test::assert_true
    "value" "\"A\"" 0 tokens.get common::Token::value.as_str test::assert_str_eq
}

pub fn test_string_hex_escape_non_printable {
    "string_hex_escape_non_printable" test::test_start
    "test" "\"\\x1b\"" lexer::lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "kind" common::TokenKind::Literal 0 tokens.get common::Token::kind == test::assert_true
    "length" 3 0 tokens.get common::Token::value.as_str.length test::assert_eq
    "byte" 27 1 0 tokens.get common::Token::value
        .as_str
        .at
        .codepoint i64::from test::assert_eq
}

pub fn test_string_hex_escape_mixed {
    "string_hex_escape_mixed" test::test_start
    "test" "\"\\x1b[H\"" lexer::lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "kind" common::TokenKind::Literal 0 tokens.get common::Token::kind == test::assert_true
    "length" 5 0 tokens.get common::Token::value.as_str.length test::assert_eq
    "esc byte" 27 1 0 tokens.get common::Token::value
        .as_str
        .at
        .codepoint i64::from test::assert_eq
    "bracket" '['.codepoint i64::from 2 0 tokens.get common::Token::value
        .as_str
        .at
        .codepoint i64::from test::assert_eq
    "H" 'H'.codepoint i64::from 3 0 tokens.get common::Token::value
        .as_str
        .at
        .codepoint i64::from test::assert_eq
}

