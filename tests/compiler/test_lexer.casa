# ============================================================================
# Hex escape sequences
# ============================================================================

fn test_string_hex_escape_printable {
    "string_hex_escape_printable" test_start
    "test" "\"\\x41\"" lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "kind" TokenKind::Literal 0 tokens.get Token::kind == assert_true
    "value" "\"A\"" 0 tokens.get Token::value.as_str assert_str_eq
}

fn test_string_hex_escape_non_printable {
    "string_hex_escape_non_printable" test_start
    "test" "\"\\x1b\"" lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "kind" TokenKind::Literal 0 tokens.get Token::kind == assert_true
    "length" 3 0 tokens.get Token::value.as_str.length assert_eq
    "byte" 27 1 0 tokens.get Token::value
        .as_str
        .at
        .codepoint i64::from assert_eq
}

fn test_string_hex_escape_mixed {
    "string_hex_escape_mixed" test_start
    "test" "\"\\x1b[H\"" lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    diagnostics drop
    "kind" TokenKind::Literal 0 tokens.get Token::kind == assert_true
    "length" 5 0 tokens.get Token::value.as_str.length assert_eq
    "esc byte" 27 1 0 tokens.get Token::value
        .as_str
        .at
        .codepoint i64::from assert_eq
    "bracket" '['.codepoint i64::from 2 0 tokens.get Token::value
        .as_str
        .at
        .codepoint i64::from assert_eq
    "H" 'H'.codepoint i64::from 3 0 tokens.get Token::value
        .as_str
        .at
        .codepoint i64::from assert_eq
}

