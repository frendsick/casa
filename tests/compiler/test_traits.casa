pub fn test_default_ambiguity_requires_qualification_or_override {
    error::Diagnostics::new = ambiguous_diagnostics
    "default_ambiguity_requires_qualification_or_override" test::test_start
    ambiguous_diagnostics "trait First { fn value self:self -> i64 { self drop 1 } }\ntrait Second { fn value self:self -> i64 { self drop 2 } }\nstruct Item { raw: i64 }\nimpl Item: First + Second { }\n1 Item .value drop\n" trait_test_full_typecheck
    ambiguous_diagnostics "unqualified defaults are ambiguous" helpers::assert_has_errors
    ambiguous_diagnostics "ambiguity diagnostic" "trait-qualified call" helpers::assert_error_contains

    error::Diagnostics::new = qualified_diagnostics
    qualified_diagnostics "trait First { fn value self:self -> i64 { self drop 1 } }\ntrait Second { fn value self:self -> i64 { self drop 2 } }\nstruct Item { raw: i64 }\nimpl Item: First + Second { }\n1 Item First::value drop\n1 Item Second::value drop\n" trait_test_full_typecheck
    qualified_diagnostics "qualified defaults accepted" helpers::assert_no_errors

    error::Diagnostics::new = override_diagnostics
    override_diagnostics "trait First { fn value self:self -> i64 { self drop 1 } }\ntrait Second { fn value self:self -> i64 { self drop 2 } }\ntrait Both: First + Second { }\nstruct Item { raw: i64 }\nimpl Item: Both { fn value self:Item -> i64 { self.raw } }\n1 Item .value drop\n" trait_test_full_typecheck
    override_diagnostics "explicit override resolves inherited defaults" helpers::assert_no_errors
}

pub fn test_generic_trait_implementations_are_qualified {
    error::Diagnostics::new = diagnostics
    "generic_trait_implementations_are_qualified" test::test_start
    diagnostics "trait Convert[T] { fn convert self:self -> T fn converted self:self -> T { self.convert } }\nstruct Token { value: i64 }\nimpl Token: Convert[i64] { fn convert self:Token -> i64 { self.value } }\nimpl Token: Convert[str] { fn convert self:Token -> str { self drop \"ok\" } }\n1 Token Convert[i64]::convert drop\n1 Token Convert[str]::convert drop\n1 Token Convert[i64]::converted drop\n1 Token Convert[str]::converted drop\n&Token::Convert[i64]::convert drop\n" trait_test_full_typecheck
    diagnostics "qualified calls and reference accepted" helpers::assert_no_errors

    error::Diagnostics::new = ambiguous_diagnostics
    ambiguous_diagnostics "trait Convert[T] { fn convert self:self -> T }\nstruct Token { value: i64 }\nimpl Token: Convert[i64] { fn convert self:Token -> i64 { self.value } }\nimpl Token: Convert[str] { fn convert self:Token -> str { self drop \"ok\" } }\n1 Token .convert drop\n" trait_test_full_typecheck
    ambiguous_diagnostics "unqualified generic implementations rejected" helpers::assert_has_errors
    ambiguous_diagnostics "generic ambiguity lists both implementations" "Convert[i64], Convert[str]" helpers::assert_error_contains
}

pub fn test_language_trait_contracts_are_validated {
    error::Diagnostics::new = ordinary_diagnostics
    error::Diagnostics::new = missing_diagnostics
    "language_trait_contracts_are_validated" test::test_start
    ordinary_diagnostics "trait Eq { fn eq self:self other:self -> bool }\n" trait_test_resolve drop
    ordinary_diagnostics "ordinary Eq trait is not language-defined" helpers::assert_no_errors

    missing_diagnostics "trait __casa_std__Eq { fn eq self:self other:self -> bool }\n" trait_test_resolve drop
    missing_diagnostics "missing operator method rejected" helpers::assert_has_errors
    missing_diagnostics "missing operator method identified" "missing required `ne` operator method" helpers::assert_error_contains

    error::Diagnostics::new = incompatible_diagnostics
    incompatible_diagnostics "trait __casa_std__Display { fn to_str self:self -> i64 }\n" trait_test_resolve drop
    incompatible_diagnostics "incompatible formatting method rejected" helpers::assert_has_errors
    incompatible_diagnostics "incompatible formatting method identified" "incompatible `to_str` formatting method" helpers::assert_error_contains

    error::Diagnostics::new = extra_diagnostics
    extra_diagnostics "trait __casa_std__Display { fn to_str self:self -> __casa_std__String fn debug self:self -> str }\n" trait_test_resolve drop
    extra_diagnostics "extra requirement rejected" helpers::assert_has_errors
    extra_diagnostics "extra requirement identified" "cannot add bodyless `debug` requirement" helpers::assert_error_contains

    error::Diagnostics::new = inherited_diagnostics
    inherited_diagnostics "trait Equality { fn eq self:self other:self -> bool fn ne self:self other:self -> bool { other self.eq ! } }\ntrait __casa_std__Eq: Equality { }\n" trait_test_resolve drop
    inherited_diagnostics "inherited minimum methods accepted" helpers::assert_no_errors

    error::Diagnostics::new = partial_order_diagnostics
    partial_order_diagnostics "trait __casa_std__PartialOrd { fn eq self:$self other:$self -> bool fn ne self:$self other:$self -> bool { other self.eq ! } fn partial_cmp self:$self other:$self -> bool fn lt self:$self other:$self -> bool { false } fn le self:$self other:$self -> bool { false } fn gt self:$self other:$self -> bool { false } fn ge self:$self other:$self -> bool { false } }\n" trait_test_resolve drop
    partial_order_diagnostics "invalid partial comparison result rejected" helpers::assert_has_errors
    partial_order_diagnostics "partial_cmp diagnostic" "incompatible `partial_cmp` comparison method" helpers::assert_error_contains
}

