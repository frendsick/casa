pub fn test_multiple_trait_bounds_parse_and_deduplicate_requirements {
    error::Diagnostics::new = diagnostics
    "multiple_trait_bounds_parse_and_deduplicate_requirements" test::test_start
    diagnostics "trait First { fn value self:self -> i64 }\ntrait Second { fn value self:self -> i64 }\nfn read[T: First + Second + First] value:T -> i64 { value .value }\n" trait_test_parse drop
    "read" TRAIT_TEST_STORE.get_function.unwrap = function
    "T" function
        .stack_effect
        .trait_bounds
        .get_str
        .unwrap = bounds
    "duplicate bound removed" 2 bounds.length test::assert_eq
    0 = hidden_count
    for
        parameter in function
            .stack_effect
            .parameters
            .iter
    do
        if parameter.name.as_str "__trait_" str::starts_with then
            1 += hidden_count
        fi
    done
    "bounds add no hidden parameters" 0 hidden_count test::assert_eq
    diagnostics "compatible bounds accepted" helpers::assert_no_errors

    error::Diagnostics::new = generic_diagnostics
    generic_diagnostics "trait First { fn convert[A] self:self value:A -> A }\ntrait Second { fn convert[B] self:self value:B -> B }\nfn convert[T: First + Second, V] receiver:T value:V -> V { value receiver .convert }\n" trait_test_parse drop
    generic_diagnostics "alpha-equivalent method requirements accepted" helpers::assert_no_errors

    error::Diagnostics::new = call_diagnostics
    call_diagnostics "trait First { fn value self:self -> i64 }\ntrait Second { fn value self:self -> i64 }\nstruct Both { raw: i64 }\nimpl Both: First + Second { fn value self:Both -> i64 { self.raw } }\nfn read[T: First + Second] value:T -> i64 { value .value }\n1 Both read drop\n" trait_test_full_typecheck
    call_diagnostics "shared requirement uses one implementation" helpers::assert_no_errors
}

pub fn test_incompatible_trait_bounds_raise {
    error::Diagnostics::new = diagnostics
    "incompatible_trait_bounds_raise" test::test_start
    diagnostics "trait Numeric { fn value self:self -> i64 }\ntrait Textual { fn value self:self -> str }\nfn read[T: Numeric + Textual] value:T { value drop }\n" trait_test_parse drop
    diagnostics "incompatible bounds rejected" helpers::assert_has_errors
    diagnostics "trait requirement mismatch" common::ErrorKind::TraitSignatureMismatch helpers::assert_error_kind
}

