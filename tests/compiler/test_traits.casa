    Diagnostics::new = diagnostics
    "trait_fn_ptr_wraps_generic_layout_arguments" test_start
    diagnostics "trait Duplicate { fn duplicate self:$self -> self }\nstruct Wrapper[T] { value: T }\nimpl i64: Duplicate { fn duplicate self:$i64 -> i64 { self copy } }\nimpl[T: Duplicate] Wrapper[T]: Duplicate { fn duplicate self:$Wrapper[T] -> Wrapper[T] { unsafe { self (ptr) ptr::read[T] } T::duplicate Wrapper } }\nfn duplicate_value[T: Duplicate] value:$T -> T { value T::duplicate }\n42 Wrapper = wrapped\nwrapped duplicate_value drop\n" trait_test_typecheck drop
    diagnostics "no errors" assert_no_errors
    false = found_adapter
    for
        function_name in TRAIT_TEST_STORE
            .functions
            .keys
            .iter
    do
        if function_name "__layout_adapter_" str::starts_with then
            true = found_adapter
            break
        fi
    done
    "layout adapter generated" found_adapter assert_true
}

fn test_generic_trait_bound_default_method_uses_structural_arg {
    Diagnostics::new = diagnostics
    "generic_trait_bound_default_method_uses_structural_arg" test_start
    diagnostics "trait Carrier[T] { fn raw self:self -> T fn keep self:self value:T -> T { self drop value } }\nstruct Counter { val: i64 }\nimpl Counter: Carrier[i64] { fn raw self:Counter -> i64 { self Counter::val } }\nfn use_carrier[I: Carrier[i64]] i:I -> i64 { i .raw }\n7 42 Counter .keep drop\n" trait_test_typecheck drop
    "I" "use_carrier" TRAIT_TEST_STORE
        .functions
        .get
        .unwrap Function::stack_effect StackEffect::trait_bounds.get.unwrap = bounds
    0 bounds.get = bound
    "structural default argument" "i64" 0 bound TraitBound::type_args.get.format assert_str_eq
    diagnostics "default method resolves" assert_no_errors
}

