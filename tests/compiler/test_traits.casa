fn test_type_var_with_matching_bound_satisfies {
    Diagnostics::new = diagnostics
    "type_var_with_matching_bound_satisfies" test_start
    diagnostics HASHABLE_TRAIT trait_test_parse drop
    # Build a StackEffect with K bounded by Hashable
    Map[str List[TraitBound]]::new = bounds
    List[TraitBound]::new = k_bounds
    List[Type]::new "Hashable" TraitBound k_bounds.push
    k_bounds "K" bounds.set
    Set[str]::new = type_vars
    "K" type_vars.add
    # Construct StackEffect: parameters, return_types, type_vars, trait_bounds
    Map[str BuiltinType]::new bounds type_vars List[Type]::new List[Parameter]::new StackEffect = sig
    sig empty_location List[Op]::new "test_fn" Function::with_stack_effect = func
    func Option::Some = func_opt
    "satisfies" diagnostics TRAIT_TEST_STORE func_opt "Hashable" "K" parse_type_str type_satisfies_trait_for_test assert_true
}

