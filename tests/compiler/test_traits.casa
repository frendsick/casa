    "tbtest" TRAIT_TEST_STORE.get_function.unwrap = func
    "K in vars" "K" func common::Function::stack_effect common::StackEffect::type_vars.has_str test::assert_true
    "V in vars" "V" func common::Function::stack_effect common::StackEffect::type_vars.has_str test::assert_true
    "K" func
        .stack_effect
        .trait_bounds
        .get_str
        .unwrap = bounds
    "K bound" "Hashable" 0 bounds.get.name test::assert_str_eq
    "V no bound" "V" func common::Function::stack_effect common::StackEffect::trait_bounds.get_str.is_none test::assert_true
}

