# ============================================================================
# Trait ref resolution (K::hash, &K::hash)
# ============================================================================

fn test_k_coloncolon_method_resolved_as_trait_method_call {
    Diagnostics::new = diagnostics
    "k_coloncolon_method_resolved_as_trait_method_call" test_start
    diagnostics HASHABLE_TRAIT "struct MyType { val: i64 }\nimpl MyType {\n    fn hash self:MyType -> i64 { self MyType::val }\n    fn eq self:MyType other:MyType -> bool { self MyType::val other MyType::val == }\n}\nfn get_hash[K: Hashable] k:K -> i64 { k K::hash }\n42 MyType = m\nm get_hash drop\n" str::concat trait_test_typecheck drop
    "get_hash" TRAIT_TEST_STORE.functions.get.unwrap = func
    # K::hash resolves to a dedicated trait method call carrying the hidden var.
    false = found_trait_call
    0 (u64) = index
    while index func Function::ops.length > do
        index func Function::ops.get = current_op
        if
        current_op.value OpValue::TraitMethodCall is
        "__trait_K_hash" current_op op_str_value == &&
        then
            true = found_trait_call
        fi
        1 += index
    done
    "found trait method call" found_trait_call assert_true
}

fn test_ampersand_k_coloncolon_method_resolved_as_push_variable {
    Diagnostics::new = diagnostics
    "ampersand_k_coloncolon_method_resolved_as_push_variable" test_start
    diagnostics HASHABLE_TRAIT "struct MyType { val: i64 }\nimpl MyType {\n    fn hash self:MyType -> i64 { self MyType::val }\n    fn eq self:MyType other:MyType -> bool { self MyType::val other MyType::val == }\n}\nfn get_hash_fn[K: Hashable] -> fn[K -> i64] { &K::hash }\n42 MyType = m\nm get_hash_fn drop\n" str::concat trait_test_typecheck drop
    "get_hash_fn" TRAIT_TEST_STORE.functions.get.unwrap = func
    # &K::hash resolves to OpPushVar as a fn ref.
    false = found_push_var
    0 (u64) = index
    while index func Function::ops.length > do
        index func Function::ops.get = current_op
        if
        current_op.value OpValue::PushVar is
        "__trait_K_hash" current_op op_str_value == &&
        then
            true = found_push_var
        fi
        1 += index
    done
    "found push_var" found_push_var assert_true
}

