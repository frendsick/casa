pub fn test_generic_trait_bound_multiple_structural_args {
    error::Diagnostics::new = diagnostics
    "generic_trait_bound_multiple_structural_args" test::test_start
    diagnostics "trait Pair[A B] { fn first self:self -> A }\nfn uses[I: Pair[Map[str i64], List[str]]] i:I -> i64 { 0 }\n" trait_test_parse drop
    "I" "uses" TRAIT_TEST_STORE.get_function.unwrap common::Function::stack_effect common::StackEffect::trait_bounds.get_str.unwrap = bounds
    0 bounds.get = bound
    "argument count" 2 bound common::TraitBound::type_args.length test::assert_eq
    "first argument" "Map[str i64]" 0 bound common::TraitBound::type_args.get.format test::assert_str_eq
    "second argument" "List[str]" 1 bound common::TraitBound::type_args.get.format test::assert_str_eq
    "format" "Pair[Map[str i64] List[str]]" bound common::trait_bound_to_str test::assert_str_eq
    std::List[common::Type]::new = same_arguments
    "Map[str i64]" common::parse_type_str same_arguments.push
    "List[str]" common::parse_type_str same_arguments.push
    same_arguments "Pair".to_str common::TraitBound = same_bound
    "structural equality" same_bound bound common::trait_bound_eq test::assert_true
}

