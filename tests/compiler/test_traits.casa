# ============================================================================
# Trait ref resolution (K::hash, &K::hash)
# ============================================================================

pub fn test_k_coloncolon_method_resolved_as_trait_method_call {
    error::Diagnostics::new = diagnostics
    "k_coloncolon_method_resolved_as_trait_method_call" test::test_start
    diagnostics HASHABLE_TRAIT "struct MyType { val: i64 }\nimpl MyType: Hashable {\n    fn hash self:MyType -> i64 { self MyType::val }\n    fn eq self:MyType other:MyType -> bool { self MyType::val other MyType::val == }\n}\nfn get_hash[K: Hashable] k:K -> i64 { k K::hash }\n42 MyType = m\nm get_hash drop\n" str::concat.as_str trait_test_typecheck drop
    "get_hash" TRAIT_TEST_STORE.get_function.unwrap = func
    # K::hash keeps the checked trait contract until specialization.
    false = found_trait_call
    0 (u64) = index
    while index func common::Function::ops.length > do
        index func common::Function::ops.get = current_op
        if current_op.value common::OpValue::TraitMethodCall(call) is then
            if "hash" call.method_name == then
                true = found_trait_call
            fi
        fi
        1 += index
    done
    "found trait method call" found_trait_call test::assert_true
}

pub fn test_ampersand_k_coloncolon_method_resolved_as_trait_method_ref {
    error::Diagnostics::new = diagnostics
    "ampersand_k_coloncolon_method_resolved_as_trait_method_ref" test::test_start
    diagnostics HASHABLE_TRAIT "struct MyType { val: i64 }\nimpl MyType: Hashable {\n    fn hash self:MyType -> i64 { self MyType::val }\n    fn eq self:MyType other:MyType -> bool { self MyType::val other MyType::val == }\n}\nfn get_hash_fn[K: Hashable] -> fn[K -> i64] { &K::hash }\n42 MyType = m\nm get_hash_fn drop\n" str::concat.as_str trait_test_typecheck drop
    "get_hash_fn" TRAIT_TEST_STORE.get_function.unwrap = func
    false = found_trait_ref
    0 (u64) = index
    while index func common::Function::ops.length > do
        index func common::Function::ops.get = current_op
        if current_op.value common::OpValue::TraitMethodRef(call) is then
            if "hash" call.method_name == then
                true = found_trait_ref
            fi
        fi
        1 += index
    done
    "found trait method reference" found_trait_ref test::assert_true
}

