fn test_trait_inheritance_cycles_raise {
    Diagnostics::new = direct_diagnostics
    "trait_inheritance_cycles_raise" test_start
    direct_diagnostics "trait Loop: Loop { }\n" trait_test_resolve drop
    direct_diagnostics "direct cycle rejected" assert_has_errors
    direct_diagnostics "direct cycle diagnostic" "Trait inheritance cycle" assert_error_contains

    Diagnostics::new = indirect_diagnostics
    indirect_diagnostics "trait First: Second { }\ntrait Second: First { }\n" trait_test_resolve drop
    indirect_diagnostics "indirect cycle rejected" assert_has_errors
    indirect_diagnostics "indirect cycle diagnostic" "Trait inheritance cycle" assert_error_contains
}

