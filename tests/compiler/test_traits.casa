    diagnostics "incompatible inherited methods rejected" assert_has_errors
    diagnostics "method conflict diagnostic" ErrorKind::TraitSignatureMismatch assert_error_kind
}

fn test_diamond_default_is_deduplicated {
    Diagnostics::new = diagnostics
    "diamond_default_is_deduplicated" test_start
    diagnostics "trait Root { fn value self:self -> i64 { self drop 1 } }\ntrait Left: Root { }\ntrait Right: Root { }\ntrait Diamond: Left + Right { }\nstruct Item { raw: i64 }\nimpl Item: Diamond { }\n1 Item .value drop\n" trait_test_full_typecheck
    diagnostics "diamond default accepted once" assert_no_errors
}

fn test_default_ambiguity_requires_qualification_or_override {
    Diagnostics::new = ambiguous_diagnostics
    "default_ambiguity_requires_qualification_or_override" test_start
    ambiguous_diagnostics "trait First { fn value self:self -> i64 { self drop 1 } }\ntrait Second { fn value self:self -> i64 { self drop 2 } }\nstruct Item { raw: i64 }\nimpl Item: First + Second { }\n1 Item .value drop\n" trait_test_full_typecheck
    ambiguous_diagnostics "unqualified defaults are ambiguous" assert_has_errors
    ambiguous_diagnostics "ambiguity diagnostic" "trait-qualified call" assert_error_contains

    Diagnostics::new = qualified_diagnostics
    qualified_diagnostics "trait First { fn value self:self -> i64 { self drop 1 } }\ntrait Second { fn value self:self -> i64 { self drop 2 } }\nstruct Item { raw: i64 }\nimpl Item: First + Second { }\n1 Item First::value drop\n1 Item Second::value drop\n" trait_test_full_typecheck
    qualified_diagnostics "qualified defaults accepted" assert_no_errors

    Diagnostics::new = override_diagnostics
    override_diagnostics "trait First { fn value self:self -> i64 { self drop 1 } }\ntrait Second { fn value self:self -> i64 { self drop 2 } }\ntrait Both: First + Second { }\nstruct Item { raw: i64 }\nimpl Item: Both { fn value self:Item -> i64 { self.raw } }\n1 Item .value drop\n" trait_test_full_typecheck
    override_diagnostics "explicit override resolves inherited defaults" assert_no_errors
}

fn test_generic_trait_implementations_are_qualified {
    Diagnostics::new = diagnostics
    "generic_trait_implementations_are_qualified" test_start
    diagnostics "trait Convert[T] { fn convert self:self -> T fn converted self:self -> T { self.convert } }\nstruct Token { value: i64 }\nimpl Token: Convert[i64] { fn convert self:Token -> i64 { self.value } }\nimpl Token: Convert[str] { fn convert self:Token -> str { self drop \"ok\" } }\n1 Token Convert[i64]::convert drop\n1 Token Convert[str]::convert drop\n1 Token Convert[i64]::converted drop\n1 Token Convert[str]::converted drop\n&Token::Convert[i64]::convert drop\n" trait_test_full_typecheck
    diagnostics "qualified calls and reference accepted" assert_no_errors

    Diagnostics::new = ambiguous_diagnostics
    ambiguous_diagnostics "trait Convert[T] { fn convert self:self -> T }\nstruct Token { value: i64 }\nimpl Token: Convert[i64] { fn convert self:Token -> i64 { self.value } }\nimpl Token: Convert[str] { fn convert self:Token -> str { self drop \"ok\" } }\n1 Token .convert drop\n" trait_test_full_typecheck
    ambiguous_diagnostics "unqualified generic implementations rejected" assert_has_errors
    ambiguous_diagnostics "generic ambiguity lists both implementations" "Convert[i64], Convert[str]" assert_error_contains
}

fn test_language_trait_contracts_are_validated {
    Diagnostics::new = missing_diagnostics
    "language_trait_contracts_are_validated" test_start
    missing_diagnostics "trait Eq { fn eq self:self other:self -> bool }\n" trait_test_resolve drop
    missing_diagnostics "missing operator method rejected" assert_has_errors
    missing_diagnostics "missing operator method identified" "missing required `ne` operator method" assert_error_contains

    Diagnostics::new = incompatible_diagnostics
    incompatible_diagnostics "trait Display { fn to_str self:self -> i64 }\n" trait_test_resolve drop
    incompatible_diagnostics "incompatible formatting method rejected" assert_has_errors
    incompatible_diagnostics "incompatible formatting method identified" "incompatible `to_str` formatting method" assert_error_contains

    Diagnostics::new = extra_diagnostics
    extra_diagnostics "trait Display { fn to_str self:self -> str fn debug self:self -> str }\n" trait_test_resolve drop
    extra_diagnostics "extra requirement rejected" assert_has_errors
    extra_diagnostics "extra requirement identified" "cannot add bodyless `debug` requirement" assert_error_contains

    Diagnostics::new = inherited_diagnostics
    inherited_diagnostics "trait Equality { fn eq self:self other:self -> bool fn ne self:self other:self -> bool { other self.eq ! } }\ntrait Eq: Equality { }\n" trait_test_resolve drop
    inherited_diagnostics "inherited minimum methods accepted" assert_no_errors
}

