import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../compiler/syntax.casa" as syntax
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

# ============================================================================
# Constants
# ============================================================================
"trait Hashable { fn hash self:self -> i64  fn eq self:self other:self -> bool { self drop other drop false } }\n" = HASHABLE_TRAIT
common::symbol_store_new = TRAIT_TEST_STORE

# ============================================================================
# Helpers
# ============================================================================

pub fn trait_test_parse code:$str diagnostics:mut$error::Diagnostics -> std::List[common::Op] {
    global TRAIT_TEST_STORE
    diagnostics code helpers::parse_resolve_test_source = result
    result.into_parts = parse_diagnostics = store = ops
    parse_diagnostics drop
    store = TRAIT_TEST_STORE
    ops match
        std::Option::Some(parsed_ops) => parsed_ops
        std::Option::None => std::List[common::Op]::new
    end
}

pub fn trait_test_resolve code:$str diagnostics:mut$error::Diagnostics -> std::List[common::Op] {
    diagnostics code trait_test_parse
}

pub fn trait_test_typecheck code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    global TRAIT_TEST_STORE
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops typechecker::check_ops = effect
    store = TRAIT_TEST_STORE
    effect
}

pub fn trait_test_full_typecheck code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    store ops typechecker::type_check = checked
    checked.diagnostics.clone diagnostics.merge
}

pub fn trait_test_parse_modules
    root_source:$str
    dependency_source:$str
    diagnostics:mut$error::Diagnostics
-> syntax::ParseResolveResult {
    "/tmp/casa_trait_dependency_326.casa" = dependency_path
    lexer::SourceStore::new = sources
    dependency_source dependency_path sources.add
    "/tmp/casa_trait_root_326.casa" root_source.clone lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    sources lex_diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve
    = result
    result.diagnostics.clone diagnostics.merge
    result
}

