pub fn test_trait_specialization_needs_no_layout_adapter {
    error::Diagnostics::new = diagnostics
    "trait_specialization_needs_no_layout_adapter" test::test_start
    diagnostics "trait Duplicate { fn duplicate self:$self -> self }\nstruct Wrapper[T] { value: T }\nimpl i64: Duplicate { fn duplicate self:$i64 -> i64 { self copy } }\nimpl[T: Duplicate] Wrapper[T]: Duplicate { fn duplicate self:$Wrapper[T] -> Wrapper[T] { unsafe { self (ptr) ptr::read[T] } T::duplicate Wrapper } }\nfn duplicate_value[T: Duplicate] value:$T -> T { value T::duplicate }\n42 Wrapper = wrapped\nwrapped duplicate_value drop\n" trait_test_typecheck drop
    diagnostics "no errors" helpers::assert_no_errors
    false = found_adapter
    for function_name in TRAIT_TEST_STORE.get_function_names.iter do
        if function_name.as_str "__layout_adapter_" str::starts_with then
            true = found_adapter
            break
        fi
    done
    "layout adapter not generated" found_adapter ! test::assert_true
}

