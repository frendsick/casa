# ============================================================================
# Hidden params for trait bounds
# ============================================================================

fn test_trait_hidden_params_prepended {
    Diagnostics::new = diagnostics
    "trait_hidden_params_prepended" test_start
    diagnostics "trait Hashable { fn hash self:self -> i64 }\nfn tbtest[K: Hashable] K -> i64 { .hash }" trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE.functions.get.unwrap = func
    0 = hidden_count
    0 (u64) = index
    while index func Function::stack_effect StackEffect::parameters.length > do
        index func Function::stack_effect StackEffect::parameters.get Parameter::name = param_name
        if param_name "__trait_" str::starts_with then
            1 += hidden_count
        fi
        1 += index
    done
    "one hidden param" 1 hidden_count assert_eq
}

fn test_trait_hidden_param_name {
    Diagnostics::new = diagnostics
    "trait_hidden_param_name" test_start
    diagnostics "trait Hashable { fn hash self:self -> i64 }\nfn tbtest[K: Hashable] K -> i64 { .hash }" trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE.functions.get.unwrap = func
    false = found
    0 (u64) = index
    while index func Function::stack_effect StackEffect::parameters.length > do
        if "__trait_K_hash" index func Function::stack_effect StackEffect::parameters.get Parameter::name == then
            true = found
        fi
        1 += index
    done
    "found __trait_K_hash" found assert_true
}

fn test_trait_hidden_param_type {
    Diagnostics::new = diagnostics
    "trait_hidden_param_type" test_start
    diagnostics "trait Hashable { fn hash self:self -> i64 }\nfn tbtest[K: Hashable] K -> i64 { .hash }" trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE.functions.get.unwrap = func
    0 (u64) = index
    while index func Function::stack_effect StackEffect::parameters.length > do
        index func Function::stack_effect StackEffect::parameters.get = param
        if "__trait_K_hash" param Parameter::name == then
            "type" "fn[K -> i64]" param Parameter::typ.format assert_str_eq
        fi
        1 += index
    done
}

fn test_trait_two_methods_hidden_params {
    Diagnostics::new = diagnostics
    "trait_two_methods_hidden_params" test_start
    diagnostics HASHABLE_TRAIT "fn tbtest[K: Hashable] K -> i64 { .hash }" str::concat trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE.functions.get.unwrap = func
    0 = hidden_count
    false = has_hash
    false = has_eq
    0 (u64) = index
    while index func Function::stack_effect StackEffect::parameters.length > do
        index func Function::stack_effect StackEffect::parameters.get Parameter::name = param_name
        if param_name "__trait_" str::starts_with then
            1 += hidden_count
            if "__trait_K_hash" param_name == then true = has_hash fi
            if "__trait_K_eq" param_name == then true = has_eq fi
        fi
        1 += index
    done
    "two hidden params" 2 hidden_count assert_eq
    "has hash" has_hash assert_true
    "has eq" has_eq assert_true
}

fn test_trait_hidden_params_correct_types {
    Diagnostics::new = diagnostics
    "trait_hidden_params_correct_types" test_start
    diagnostics HASHABLE_TRAIT "fn tbtest[K: Hashable] K -> i64 { .hash }" str::concat trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE.functions.get.unwrap = func
    0 (u64) = index
    while index func Function::stack_effect StackEffect::parameters.length > do
        index func Function::stack_effect StackEffect::parameters.get = param
        if "__trait_K_hash" param Parameter::name == then
            "hash type" "fn[K -> i64]" param Parameter::typ.format assert_str_eq
        fi
        if "__trait_K_eq" param Parameter::name == then
            "eq type" "fn[K K -> bool]" param Parameter::typ.format assert_str_eq
        fi
        1 += index
    done
}

fn test_trait_hidden_params_creates_variables {
    Diagnostics::new = diagnostics
    "trait_hidden_params_creates_variables" test_start
    diagnostics "trait Hashable { fn hash self:self -> i64 }\nfn tbtest[K: Hashable] K -> i64 { .hash }" trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE.functions.get.unwrap = func
    false = found
    0 (u64) = index
    while index func Function::variables.length > do
        if "__trait_K_hash" index func Function::variables.get Variable::name == then
            true = found
