pub fn test_trait_bound_call_is_deferred_then_specialized {
    error::Diagnostics::new = diagnostics
    "trait_bound_call_is_deferred_then_specialized" test::test_start
    diagnostics
    "trait Hashable { fn hash self:self -> i64 }\nstruct Item { value: i64 }\nimpl Item: Hashable { fn hash self:Item -> i64 { self.value } }\nfn hash_value[T: Hashable] value:T -> i64 { value T::hash }\n1 Item hash_value drop"
    helpers::parse_resolve_test_parts = store = operations
    store operations typechecker::type_check = checked
    checked.diagnostics.clone diagnostics.merge
    diagnostics "typechecks" helpers::assert_no_errors

    "hash_value" checked
        .store
        .get_function
        .unwrap = source
    false = source_has_deferred
    for source_op in source.ops.iter do
        if source_op.value common::OpValue::TraitMethodCall is then
            true = source_has_deferred
        fi
    done
    "checked source keeps deferred call" source_has_deferred test::assert_true

    false = found_specialization
    false = found_direct_call
    for
        function_name in checked
            .store
            .get_function_names
            .iter
    do
        if function_name.as_str "hash_value__mono_" str::starts_with then
            true = found_specialization
            function_name.as_str checked
                .store
                .get_function
                .unwrap = specialization
            for specialized_op in specialization.ops.iter do
                "specialization has no deferred call"
                specialized_op.value common::OpValue::TraitMethodCall is ! test::assert_true
                if specialized_op.value common::OpValue::FnCall is then
                    true = found_direct_call
                fi
            done
        fi
    done
    "concrete specialization exists" found_specialization test::assert_true
    "trait method is a direct call" found_direct_call test::assert_true
}

pub fn test_distinct_generic_uses_create_two_specializations {
    error::Diagnostics::new = diagnostics
    "distinct_generic_uses_create_two_specializations" test::test_start
    diagnostics
    "fn identity[T] value:T -> T { value }\n1 identity drop\n\"text\" identity drop"
    helpers::parse_resolve_test_parts = store = operations
    store operations typechecker::type_check = checked
    checked.diagnostics.clone diagnostics.merge
    diagnostics "typechecks" helpers::assert_no_errors
    0 = specialization_count
    for
        function_name in checked
            .store
            .get_function_names
            .iter
    do
        if function_name.as_str "identity__mono_" str::starts_with then
            1 += specialization_count
        fi
    done
    "two specializations" 2 specialization_count test::assert_eq
}

pub fn test_generic_function_reference_specializes {
    error::Diagnostics::new = diagnostics
    "generic_function_reference_specializes" test::test_start
    diagnostics
    "fn identity[T] value:T -> T { value }\n&identity[i64] drop"
    helpers::parse_resolve_test_parts = store = operations
    store operations typechecker::type_check = checked
    checked.diagnostics.clone diagnostics.merge
    diagnostics "typechecks" helpers::assert_no_errors
    false = found_specialized_reference
    for op in checked.ops.iter do
        if op.value common::OpValue::FnPush(function_name) is then
            if function_name.as_str "identity__mono_" str::starts_with then
                true = found_specialized_reference
            fi
        fi
    done
    "reference names a concrete specialization" found_specialized_reference test::assert_true
}

