pub fn test_all_multiple_bounds_are_enforced {
    error::Diagnostics::new = diagnostics
    "all_multiple_bounds_are_enforced" test::test_start
    diagnostics "trait HasValue { fn value self:self -> i64 }\ntrait Named { fn name self:self -> str }\nstruct Partial { value: i64 }\nimpl Partial: HasValue { fn value self:Partial -> i64 { self.value } fn name self:Partial -> str { self drop \"partial\" } }\nfn use[T: HasValue + Named] value:T -> i64 { value .value }\n1 Partial use drop\n" trait_test_typecheck drop
    diagnostics "missing second implementation rejected" helpers::assert_has_errors
    diagnostics "bound failure" common::ErrorKind::TypeMismatch helpers::assert_error_kind

    error::Diagnostics::new = valid_diagnostics
    valid_diagnostics "trait HasValue { fn value self:self -> i64 }\ntrait Named { fn name self:self -> str }\nstruct Complete { raw: i64 }\nimpl Complete: HasValue + Named { fn value self:Complete -> i64 { self.raw } fn name self:Complete -> str { self drop \"complete\" } }\nfn use[T: HasValue + Named] value:T -> str { value .name }\n1 Complete use drop\n" trait_test_full_typecheck
    valid_diagnostics "all declared implementations accepted" helpers::assert_no_errors
}

pub fn test_invalid_trait_impl_is_diagnosed_without_use {
    error::Diagnostics::new = diagnostics
    "invalid_trait_impl_is_diagnosed_without_use" test::test_start
    diagnostics "trait Named { fn name self:self -> str }\nstruct Broken { value: i64 }\nimpl Broken: Named { }\n" trait_test_full_typecheck
    diagnostics "invalid declaration rejected" helpers::assert_has_errors
    diagnostics "trait implementation requirement error" common::ErrorKind::TraitSignatureMismatch helpers::assert_error_kind

    error::Diagnostics::new = generic_diagnostics
    generic_diagnostics "trait Carrier[T] { fn get self:self -> T }\nstruct Box[T] { value: T }\nimpl[T] Box[T]: Carrier[T] { fn get[U] self:Box[U] -> str { self drop \"wrong\" } }\n" trait_test_full_typecheck
    generic_diagnostics "invalid generic declaration rejected" helpers::assert_has_errors
    generic_diagnostics "generic trait implementation requirement error" common::ErrorKind::TraitSignatureMismatch helpers::assert_error_kind

    error::Diagnostics::new = specialized_diagnostics
    specialized_diagnostics "trait Carrier[T] { fn get self:self -> T }\nstruct Box[T] { value: T }\nimpl[T] Box[T]: Carrier[T] { fn get self:Box[i64] -> i64 { self.value } }\n" trait_test_full_typecheck
    specialized_diagnostics "specialized method cannot satisfy generic declaration" helpers::assert_has_errors
    specialized_diagnostics "specialized trait implementation requirement error" common::ErrorKind::TraitSignatureMismatch helpers::assert_error_kind
}

pub fn test_duplicate_and_overlapping_trait_impls_raise {
    error::Diagnostics::new = duplicate_diagnostics
    "duplicate_and_overlapping_trait_impls_raise" test::test_start
    duplicate_diagnostics "trait Marker { }\nstruct Item { value: i64 }\nimpl Item: Marker { }\nimpl Item: Marker { }\n" trait_test_parse drop
    duplicate_diagnostics "duplicate trait implementation rejected" helpers::assert_has_errors
    duplicate_diagnostics "duplicate error" common::ErrorKind::DuplicateName helpers::assert_error_kind

    error::Diagnostics::new = overlap_diagnostics
    overlap_diagnostics "trait Marker[T] { }\nstruct Box[T] { value: T }\nimpl[T] Box[T]: Marker[T] { }\nimpl Box[i64]: Marker[i64] { }\n" trait_test_parse drop
    overlap_diagnostics "overlapping trait implementation rejected" helpers::assert_has_errors
    overlap_diagnostics "overlap error" common::ErrorKind::DuplicateName helpers::assert_error_kind

    error::Diagnostics::new = distinct_diagnostics
    distinct_diagnostics "trait Marker[T] { }\nstruct Item { value: i64 }\nimpl Item: Marker[i64] { }\nimpl Item: Marker[str] { }\n" trait_test_parse drop
    distinct_diagnostics "distinct trait instantiations accepted" helpers::assert_no_errors
    "i64 instantiation" distinct_diagnostics TRAIT_TEST_STORE std::Option[common::Function]::None "Marker[i64]" "Item" common::parse_type_str helpers::type_satisfies_trait_for_test test::assert_true
    "str instantiation" distinct_diagnostics TRAIT_TEST_STORE std::Option[common::Function]::None "Marker[str]" "Item" common::parse_type_str helpers::type_satisfies_trait_for_test test::assert_true

    error::Diagnostics::new = disjoint_diagnostics
    disjoint_diagnostics "trait Marker[T] { }\nstruct Pair[A B] { first: A second: B }\nimpl[T] Pair[T T]: Marker[i64] { }\nimpl Pair[i64 str]: Marker[i64] { }\n" trait_test_parse drop
    disjoint_diagnostics "generic patterns with no shared instantiation accepted" helpers::assert_no_errors

    error::Diagnostics::new = type_variable_diagnostics
    type_variable_diagnostics "trait Marker { }\nimpl[T] T: Marker { }\n" trait_test_parse drop
    type_variable_diagnostics "type-variable trait implementation rejected" helpers::assert_has_errors
    type_variable_diagnostics "type-variable target identified" "A trait implementation cannot target a type variable." helpers::assert_error_contains
    type_variable_diagnostics "type-variable error" common::ErrorKind::InvalidScope helpers::assert_error_kind
}

pub fn test_trait_impl_orphan_rule {
    error::Diagnostics::new = orphan_diagnostics
    "trait_impl_orphan_rule" test::test_start
    orphan_diagnostics "pub trait Remote { }\npub struct Foreign { pub value: i64 }\n" "import \"/tmp/casa_trait_dependency_326.casa\" as dependency\nimpl dependency::Foreign: dependency::Remote { }\n" trait_test_parse_modules drop
