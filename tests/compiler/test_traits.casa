fn test_multiple_trait_bounds_parse_and_deduplicate_requirements {
    Diagnostics::new = diagnostics
    "multiple_trait_bounds_parse_and_deduplicate_requirements" test_start
    diagnostics "trait First { fn value self:self -> i64 }\ntrait Second { fn value self:self -> i64 }\nfn read[T: First + Second + First] value:T -> i64 { value .value }\n" trait_test_parse drop
    "read" TRAIT_TEST_STORE
        .functions
        .get
        .unwrap = function
    "T" function
        .stack_effect
        .trait_bounds
        .get
        .unwrap = bounds
    "duplicate bound removed" 2 bounds.length assert_eq
    0 = hidden_count
    for
        parameter in function
            .stack_effect
            .parameters
            .iter
    do
        if parameter.name "__trait_" str::starts_with then
            1 += hidden_count
        fi
    done
    "compatible method requirement deduplicated" 1 hidden_count assert_eq
    diagnostics "compatible bounds accepted" assert_no_errors

    Diagnostics::new = generic_diagnostics
    generic_diagnostics "trait First { fn convert[A] self:self value:A -> A }\ntrait Second { fn convert[B] self:self value:B -> B }\nfn convert[T: First + Second, V] receiver:T value:V -> V { value receiver .convert }\n" trait_test_parse drop
    generic_diagnostics "alpha-equivalent method requirements accepted" assert_no_errors

    Diagnostics::new = call_diagnostics
    call_diagnostics "trait First { fn value self:self -> i64 }\ntrait Second { fn value self:self -> i64 }\nstruct Both { raw: i64 }\nimpl Both: First + Second { fn value self:Both -> i64 { self.raw } }\nfn read[T: First + Second] value:T -> i64 { value .value }\n1 Both read drop\n" trait_test_full_typecheck
    call_diagnostics "shared requirement uses one implementation" assert_no_errors
}

fn test_incompatible_trait_bounds_raise {
    Diagnostics::new = diagnostics
    "incompatible_trait_bounds_raise" test_start
    diagnostics "trait Numeric { fn value self:self -> i64 }\ntrait Textual { fn value self:self -> str }\nfn read[T: Numeric + Textual] value:T { value drop }\n" trait_test_parse drop
    diagnostics "incompatible bounds rejected" assert_has_errors
    diagnostics "trait requirement mismatch" ErrorKind::TraitSignatureMismatch assert_error_kind
}

# ============================================================================
# Hidden params for trait bounds
# ============================================================================

fn test_trait_hidden_params_prepended {
    Diagnostics::new = diagnostics
    "trait_hidden_params_prepended" test_start
    diagnostics "trait Hashable { fn hash self:self -> i64 }\nfn tbtest[K: Hashable] K -> i64 { .hash }" trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE
        .functions
        .get
        .unwrap = func
    0 = hidden_count
    0 (u64) = index
    while index func Function::stack_effect StackEffect::parameters.length > do
        index func Function::stack_effect StackEffect::parameters.get Parameter::name = param_name: $str
        if param_name "__trait_" str::starts_with then
            1 += hidden_count
        fi
        1 += index
    done
    "one hidden param" 1 hidden_count assert_eq
}

fn test_trait_hidden_param_name {
    Diagnostics::new = diagnostics
    "trait_hidden_param_name" test_start
    diagnostics "trait Hashable { fn hash self:self -> i64 }\nfn tbtest[K: Hashable] K -> i64 { .hash }" trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE
        .functions
        .get
        .unwrap = func
    false = found
    0 (u64) = index
    while index func Function::stack_effect StackEffect::parameters.length > do
        if
            "__trait_K_hash" index func Function::stack_effect StackEffect::parameters.get Parameter::name ==
        then
            true = found
        fi
        1 += index
    done
    "found __trait_K_hash" found assert_true
}

