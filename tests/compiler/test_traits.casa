import "../../compiler/typechecker.casa"
import "helpers.casa"

# ============================================================================
# Constants
# ============================================================================
"trait Hashable { fn hash self:self -> i64  fn eq self:self other:self -> bool { self drop other drop false } }\n" = HASHABLE_TRAIT
symbol_store_new = TRAIT_TEST_STORE

# ============================================================================
# Helpers
# ============================================================================

fn trait_test_parse code:$str diagnostics:mut$Diagnostics -> List[Op] {
    global TRAIT_TEST_STORE
    diagnostics code parse_resolve_test_source = result
    result.into_parts = parse_diagnostics = store = ops
    parse_diagnostics drop
    store = TRAIT_TEST_STORE
    ops match
        Option::Some(parsed_ops) => parsed_ops
        Option::None => List[Op]::new
    end
}

fn trait_test_resolve code:$str diagnostics:mut$Diagnostics -> List[Op] {
    diagnostics code trait_test_parse
}

fn trait_test_typecheck code:$str diagnostics:mut$Diagnostics -> StackEffect {
    global TRAIT_TEST_STORE
    diagnostics code parse_resolve_test_parts = store = ops
    store = TRAIT_TEST_STORE
    diagnostics TRAIT_TEST_STORE Option[Function]::None ops type_check_ops_for_test
}

fn trait_test_full_typecheck code:$str diagnostics:mut$Diagnostics {
    diagnostics code parse_resolve_test_parts = store = ops
    store ops type_check = checked
    checked.diagnostics.clone diagnostics.merge
}

fn trait_test_parse_modules
    root_source:$str
    dependency_source:$str
    diagnostics:mut$Diagnostics
-> ParseResolveResult {
    "/tmp/casa_trait_dependency_326.casa" = dependency_path
    SourceStore::new = sources
    dependency_source dependency_path sources.add
    "/tmp/casa_trait_root_326.casa" root_source.clone lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    sources lex_diagnostics List[str]::new tokens parse_and_resolve
    = result
    result.diagnostics.clone diagnostics.merge
    result
}

