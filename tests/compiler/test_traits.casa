# ============================================================================
# Type parameter extraction
# ============================================================================

pub fn type_param_formats source:str -> std::Option[std::List[std::String]] {
    source common::parse_type_str.type_params = params_opt
    if params_opt.is_none then
        std::Option[std::List[std::String]]::None return
    fi
    std::List[std::String]::new = result
    for param in params_opt.unwrap.iter do
        param.format result.push
    done
    result std::Option::Some
}

pub fn test_egp_single_param {
    "egp_single_param" test::test_start
    "array[i64 3]" type_param_formats = result
    "is_some" result.is_some test::assert_true
    result.unwrap = values
    "count" 2 values.length test::assert_eq
    "element" "i64" 0 values.get test::assert_str_eq
    "length" "3" 1 values.get test::assert_str_eq
}

