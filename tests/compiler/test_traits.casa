pub fn test_type_var_with_matching_bound_satisfies {
    error::Diagnostics::new = diagnostics
    "type_var_with_matching_bound_satisfies" test::test_start
    diagnostics HASHABLE_TRAIT trait_test_parse drop
    # Build a StackEffect with K bounded by Hashable
    std::Map[std::String std::List[common::TraitBound]]::new = bounds
    std::List[common::TraitBound]::new = k_bounds
    std::List[common::Type]::new "Hashable".to_str common::TraitBound k_bounds.push
    k_bounds "K" bounds.set_str
    std::Set[std::String]::new = type_vars
    "K" type_vars.add_str
    # Construct StackEffect: parameters, return_types, type_vars, trait_bounds
    std::Map[std::String common::BuiltinType]::new bounds type_vars std::List[common::Type]::new std::List[common::Parameter]::new common::StackEffect = sig
    sig common::empty_location std::List[common::Op]::new "test_fn".to_str common::Function::with_stack_effect = func
    func std::Option::Some = func_opt
    "satisfies" diagnostics TRAIT_TEST_STORE func_opt "Hashable" "K" common::parse_type_str helpers::type_satisfies_trait_for_test test::assert_true
}

