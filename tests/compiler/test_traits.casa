import "../../compiler/typechecker.casa"
import "helpers.casa"

# ============================================================================
# Constants
# ============================================================================
"trait Hashable { fn hash self:self -> i64  fn eq self:self other:self -> bool }\n" = HASHABLE_TRAIT
symbol_store_new = TRAIT_TEST_STORE

# ============================================================================
# Helpers
# ============================================================================

fn trait_test_parse code:str diagnostics:Diagnostics -> List[Op] {
    global TRAIT_TEST_STORE
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::store = TRAIT_TEST_STORE
    if result.ops Option::Some(ops) is then ops else List[Op]::new fi
}

fn trait_test_resolve code:str diagnostics:Diagnostics -> List[Op] {
    global TRAIT_TEST_STORE
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::store = TRAIT_TEST_STORE
    if result.ops Option::Some(ops) is then ops else List[Op]::new fi
}

fn trait_test_typecheck code:str diagnostics:Diagnostics -> StackEffect {
    global TRAIT_TEST_STORE
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = TRAIT_TEST_STORE
    diagnostics TRAIT_TEST_STORE Option[Function]::None ops type_check_ops_for_test
}

