fn test_trait_bound_basic {
    Diagnostics::new = diagnostics
    "trait_bound_basic" test_start
    diagnostics "trait Hashable { fn hash self:self -> i64 }\nfn tbtest[K: Hashable] K -> i64 { .hash }" trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE
        .functions
        .get
        .unwrap = func
    "K in type_vars" "K" func Function::stack_effect StackEffect::type_vars.has assert_true
    "K" func
        .stack_effect
        .trait_bounds
        .get
        .unwrap = bounds
    "one bound" 1 bounds.length assert_eq
    0 bounds.get = bound
    "K bound" "Hashable" bound.name assert_str_eq
    "bare bound args" 0 bound.type_args.length assert_eq
}

fn test_trait_bound_with_unbounded_var {
    Diagnostics::new = diagnostics
    "trait_bound_with_unbounded_var" test_start
    diagnostics "trait Hashable { fn hash self:self -> i64 }\nfn tbtest[K: Hashable, V] K V -> i64 { drop .hash }" trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE
        .functions
        .get
        .unwrap = func
    "K in vars" "K" func Function::stack_effect StackEffect::type_vars.has assert_true
    "V in vars" "V" func Function::stack_effect StackEffect::type_vars.has assert_true
    "K" func
        .stack_effect
        .trait_bounds
        .get
        .unwrap = bounds
    "K bound" "Hashable" 0 bounds.get.name assert_str_eq
    "V no bound" "V" func Function::stack_effect StackEffect::trait_bounds.get.is_none assert_true
}

