    "found variable" found assert_true
}

fn test_trait_hidden_params_creates_assign_ops {
    Diagnostics::new = diagnostics
    "trait_hidden_params_creates_assign_ops" test_start
    diagnostics "trait Hashable { fn hash self:self -> i64 }\nfn tbtest[K: Hashable] K -> i64 { .hash }" trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE.functions.get.unwrap = func
    false = found
    0 (u64) = index
    while index func Function::ops.length > do
        index func Function::ops.get = current_op
        if
        current_op.value OpValue::AssignVar is
        "__trait_K_hash" current_op op_str_value == &&
        then
            true = found
        fi
        1 += index
    done
    "found assign op" found assert_true
}

