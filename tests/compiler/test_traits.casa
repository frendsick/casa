pub fn test_trait_bound_basic {
    error::Diagnostics::new = diagnostics
    "trait_bound_basic" test::test_start
    diagnostics "trait Hashable { fn hash self:self -> i64 }\nfn tbtest[K: Hashable] K -> i64 { .hash }" trait_test_parse drop
    "tbtest" TRAIT_TEST_STORE.get_function.unwrap = func
    "K in type_vars" "K" func common::Function::stack_effect common::StackEffect::type_vars.has_str test::assert_true
    "K" func
        .stack_effect
        .trait_bounds
        .get_str
        .unwrap = bounds
    "one bound" 1 bounds.length test::assert_eq
    0 bounds.get = bound
    "K bound" "Hashable" bound.name test::assert_str_eq
    "bare bound args" 0 bound.type_args.length test::assert_eq
}

pub fn test_trait_bound_with_unbounded_var {
    error::Diagnostics::new = diagnostics
    "trait_bound_with_unbounded_var" test::test_start
