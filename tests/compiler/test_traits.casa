    "declared marker implementation" diagnostics TRAIT_TEST_STORE Option[Function]::None "Marker" "Marked" parse_type_str type_satisfies_trait_for_test assert_true
}

fn test_all_multiple_bounds_are_enforced {
    Diagnostics::new = diagnostics
    "all_multiple_bounds_are_enforced" test_start
    diagnostics "trait HasValue { fn value self:self -> i64 }\ntrait Named { fn name self:self -> str }\nstruct Partial { value: i64 }\nimpl Partial: HasValue { fn value self:Partial -> i64 { self.value } fn name self:Partial -> str { self drop \"partial\" } }\nfn use[T: HasValue + Named] value:T -> i64 { value .value }\n1 Partial use drop\n" trait_test_typecheck drop
    diagnostics "missing second implementation rejected" assert_has_errors
    diagnostics "bound failure" ErrorKind::TypeMismatch assert_error_kind

    Diagnostics::new = valid_diagnostics
    valid_diagnostics "trait HasValue { fn value self:self -> i64 }\ntrait Named { fn name self:self -> str }\nstruct Complete { raw: i64 }\nimpl Complete: HasValue + Named { fn value self:Complete -> i64 { self.raw } fn name self:Complete -> str { self drop \"complete\" } }\nfn use[T: HasValue + Named] value:T -> str { value .name }\n1 Complete use drop\n" trait_test_full_typecheck
    valid_diagnostics "all declared implementations accepted" assert_no_errors
}

fn test_invalid_trait_impl_is_diagnosed_without_use {
    Diagnostics::new = diagnostics
    "invalid_trait_impl_is_diagnosed_without_use" test_start
    diagnostics "trait Named { fn name self:self -> str }\nstruct Broken { value: i64 }\nimpl Broken: Named { }\n" trait_test_full_typecheck
    diagnostics "invalid declaration rejected" assert_has_errors
    diagnostics "trait implementation requirement error" ErrorKind::TraitSignatureMismatch assert_error_kind

    Diagnostics::new = generic_diagnostics
    generic_diagnostics "trait Carrier[T] { fn get self:self -> T }\nstruct Box[T] { value: T }\nimpl[T] Box[T]: Carrier[T] { fn get[U] self:Box[U] -> str { self drop \"wrong\" } }\n" trait_test_full_typecheck
    generic_diagnostics "invalid generic declaration rejected" assert_has_errors
    generic_diagnostics "generic trait implementation requirement error" ErrorKind::TraitSignatureMismatch assert_error_kind

    Diagnostics::new = specialized_diagnostics
    specialized_diagnostics "trait Carrier[T] { fn get self:self -> T }\nstruct Box[T] { value: T }\nimpl[T] Box[T]: Carrier[T] { fn get self:Box[i64] -> i64 { self.value } }\n" trait_test_full_typecheck
    specialized_diagnostics "specialized method cannot satisfy generic declaration" assert_has_errors
    specialized_diagnostics "specialized trait implementation requirement error" ErrorKind::TraitSignatureMismatch assert_error_kind
}

fn test_duplicate_and_overlapping_trait_impls_raise {
    Diagnostics::new = duplicate_diagnostics
    "duplicate_and_overlapping_trait_impls_raise" test_start
    duplicate_diagnostics "trait Marker { }\nstruct Item { value: i64 }\nimpl Item: Marker { }\nimpl Item: Marker { }\n" trait_test_parse drop
    duplicate_diagnostics "duplicate trait implementation rejected" assert_has_errors
    duplicate_diagnostics "duplicate error" ErrorKind::DuplicateName assert_error_kind

    Diagnostics::new = overlap_diagnostics
    overlap_diagnostics "trait Marker[T] { }\nstruct Box[T] { value: T }\nimpl[T] Box[T]: Marker[T] { }\nimpl Box[i64]: Marker[i64] { }\n" trait_test_parse drop
    overlap_diagnostics "overlapping trait implementation rejected" assert_has_errors
    overlap_diagnostics "overlap error" ErrorKind::DuplicateName assert_error_kind

    Diagnostics::new = distinct_diagnostics
    distinct_diagnostics "trait Marker[T] { }\nstruct Item { value: i64 }\nimpl Item: Marker[i64] { }\nimpl Item: Marker[str] { }\n" trait_test_parse drop
    distinct_diagnostics "distinct trait instantiations accepted" assert_no_errors
    "i64 instantiation" distinct_diagnostics TRAIT_TEST_STORE Option[Function]::None "Marker[i64]" "Item" parse_type_str type_satisfies_trait_for_test assert_true
    "str instantiation" distinct_diagnostics TRAIT_TEST_STORE Option[Function]::None "Marker[str]" "Item" parse_type_str type_satisfies_trait_for_test assert_true

    Diagnostics::new = disjoint_diagnostics
    disjoint_diagnostics "trait Marker[T] { }\nstruct Pair[A B] { first: A second: B }\nimpl[T] Pair[T T]: Marker[i64] { }\nimpl Pair[i64 str]: Marker[i64] { }\n" trait_test_parse drop
    disjoint_diagnostics "generic patterns with no shared instantiation accepted" assert_no_errors

    Diagnostics::new = type_variable_diagnostics
    type_variable_diagnostics "trait Marker { }\nimpl[T] T: Marker { }\n" trait_test_parse drop
    type_variable_diagnostics "type-variable trait implementation rejected" assert_has_errors
    type_variable_diagnostics "type-variable target identified" "A trait implementation cannot target a type variable." assert_error_contains
    type_variable_diagnostics "type-variable error" ErrorKind::InvalidScope assert_error_kind
}

