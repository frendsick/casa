# ============================================================================
# Helper: create ops list and type check it
# ============================================================================

pub struct TypecheckProbe {
    pub stack:             typechecker::TypedStack
    pub branch_count:      u64
    pub has_errors:        bool
    pub has_display_error: bool
}

pub fn tc_check ops:mut$std::List[common::Op] -> TypecheckProbe {
    error::Diagnostics::new = helper_diagnostics
    common::symbol_store_new = helper_store
    helper_diagnostics helper_store typechecker::TypeChecker::new = helper_tc
    0 (u64) = helper_i
    while helper_i ops.length > do
        helper_i ops.get.clone = helper_op
        helper_op common::Op::value common::clone_op_value = helper_kind

        # Literals
        if helper_kind common::OpValue::PushInt is then
            common::make_i64_type helper_tc.stack_push_type
        elif helper_kind common::OpValue::PushStr is then
            common::make_str_type helper_tc.stack_push_type
        elif helper_kind common::OpValue::PushBool is then
            common::make_bool_type helper_tc.stack_push_type
        elif helper_kind common::OpValue::PushChar is then
            common::make_char_type helper_tc.stack_push_type
            # Arithmetic
        elif
            helper_kind common::OpValue::Add is
            helper_kind common::OpValue::Sub is ||
            helper_kind common::OpValue::Mul is ||
            helper_kind common::OpValue::Div is ||
            helper_kind common::OpValue::Mod is ||
        then
            helper_op helper_tc.check_integer_operation
            # Comparison
        elif
            helper_kind common::OpValue::Eq is
            helper_kind common::OpValue::Ne is ||
            helper_kind common::OpValue::Lt is ||
            helper_kind common::OpValue::Le is ||
            helper_kind common::OpValue::Gt is ||
            helper_kind common::OpValue::Ge is ||
        then
            1 += helper_i
            std::Option[common::Function]::None helper_i ops helper_op helper_tc.check_comparison = helper_i
            helper_op helper_i 1 - ops.set
            continue
            # Boolean
        elif
            helper_kind common::OpValue::And is
            helper_kind common::OpValue::Or is ||
            helper_kind common::OpValue::Not is ||
        then
            helper_op helper_tc.check_boolean
            # Bitwise
        elif
            helper_kind common::OpValue::BitAnd is
            helper_kind common::OpValue::BitOr is ||
            helper_kind common::OpValue::BitXor is ||
            helper_kind common::OpValue::BitNot is ||
            helper_kind common::OpValue::Shl is ||
            helper_kind common::OpValue::Shr is ||
        then
            helper_op helper_tc.check_bitwise
            # Stack ops
        elif
            helper_kind common::OpValue::Drop is
            helper_kind common::OpValue::Dup is ||
            helper_kind common::OpValue::Swap is ||
            helper_kind common::OpValue::Over is ||
            helper_kind common::OpValue::Rot is ||
        then
            helper_op helper_tc.check_stack_ops
            # Memory
        elif
            helper_kind common::OpValue::Load8 is
            helper_kind common::OpValue::Load16 is ||
            helper_kind common::OpValue::Load32 is ||
            helper_kind common::OpValue::Load64 is ||
            helper_kind common::OpValue::Store8 is ||
            helper_kind common::OpValue::Store16 is ||
            helper_kind common::OpValue::Store32 is ||
            helper_kind common::OpValue::Store64 is ||
            helper_kind common::OpValue::HeapAlloc is ||
        then
            std::Option[common::Function]::None helper_op helper_tc.check_memory
            # Print
        elif helper_kind common::OpValue::Print is then
            1 += helper_i
            std::Option[common::Function]::None helper_i ops helper_op helper_tc.check_io = helper_i
            helper_op helper_i 1 - ops.set
            continue
            # Typeof
        elif helper_kind common::OpValue::Typeof is then
            helper_op helper_tc.check_typeof
            # Type cast
        elif helper_kind common::OpValue::TypeCast(cast_type) is then
            helper_tc.stack_pop_type drop
            cast_type helper_tc.stack_push_type
            # Syscalls
        elif
            helper_kind common::OpValue::Syscall0 is
            helper_kind common::OpValue::Syscall1 is ||
            helper_kind common::OpValue::Syscall2 is ||
            helper_kind common::OpValue::Syscall3 is ||
            helper_kind common::OpValue::Syscall4 is ||
            helper_kind common::OpValue::Syscall5 is ||
            helper_kind common::OpValue::Syscall6 is ||
        then
            std::Option[common::Function]::None helper_op helper_tc.check_syscalls
            # Argc / Argv
        elif helper_kind common::OpValue::Argc is then
            common::make_i64_type helper_tc.stack_push_type
        elif helper_kind common::OpValue::Argv is then
            common::make_ptr_type helper_tc.stack_push_type
            # Branch ops — routed to real handlers so tests can exercise the
            # BranchFrame sum type and the if/while/match branch algebra.
        elif
            helper_kind common::OpValue::IfStart is
            helper_kind common::OpValue::IfCondition is ||
            helper_kind common::OpValue::IfElif is ||
            helper_kind common::OpValue::IfElse is ||
            helper_kind common::OpValue::IfEnd is ||
        then
            helper_op helper_tc.check_if_block
        elif
            helper_kind common::OpValue::WhileStart is
            helper_kind common::OpValue::WhileCondition is ||
            helper_kind common::OpValue::WhileBreak is ||
            helper_kind common::OpValue::WhileContinue is ||
            helper_kind common::OpValue::WhileEnd is ||
        then
            helper_op helper_tc.check_while_block
        fi

        helper_op helper_i ops.set
        1 += helper_i
    done
    "Display" helper_tc.diagnostics helpers::diagnostics_error_contains
    helper_tc.diagnostics.has_errors
    helper_tc.branched_stacks.length
    helper_tc.stack.snapshot
    TypecheckProbe
}

pub fn make_test_stack_effect param_type:$str return_type:$str -> common::StackEffect {
    std::List[common::Parameter]::new = params
    param_type common::parse_type_str common::Parameter::new params.push
    std::List[common::Type]::new = returns
    return_type common::parse_type_str returns.push
    returns params common::StackEffect::new
}

# ============================================================================
# Tests: Push i64 effects
# ============================================================================

pub fn test_push_int_stack {
    "push_int_stack" test::test_start
    std::List[common::Op]::new = ops
    common::empty_location 42 common::make_integer_op_value common::Op::new ops.push
    ops tc_check = result_tc
    "stack has one item" 1 result_tc
        .stack
        .get_types
        .length test::assert_eq
    "type is i64" "i64" 0 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
}

# ============================================================================
# Tests: Add pops two ints, pushes i64
# ============================================================================

pub fn test_add_stack_effect {
    "add_stack_effect" test::test_start
    std::List[common::Op]::new = ops
    common::empty_location 10 common::make_integer_op_value common::Op::new ops.push
    common::empty_location 20 common::make_integer_op_value common::Op::new ops.push
    common::empty_location common::OpValue::Add common::Op::new ops.push
    ops tc_check = result_tc
    "stack has one item after add" 1 result_tc
        .stack
        .get_types
        .length test::assert_eq
    "result type is i64" "i64" 0 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
}

# ============================================================================
# Tests: Sub/Mul/Div/Mod stack effects
# ============================================================================

pub fn test_arithmetic_ops {
    "arithmetic_ops" test::test_start

    # Sub
    std::List[common::Op]::new = ops_sub
    common::empty_location 5 common::make_integer_op_value common::Op::new ops_sub.push
    common::empty_location 3 common::make_integer_op_value common::Op::new ops_sub.push
    common::empty_location common::OpValue::Sub common::Op::new ops_sub.push
    ops_sub tc_check = tc_sub
    "sub result" 1 tc_sub
        .stack
        .get_types
        .length test::assert_eq
    "sub type" "i64" 0 tc_sub
        .stack
        .get_types
        .get
        .format test::assert_str_eq

    # Mul
    std::List[common::Op]::new = ops_mul
    common::empty_location 2 common::make_integer_op_value common::Op::new ops_mul.push
    common::empty_location 3 common::make_integer_op_value common::Op::new ops_mul.push
    common::empty_location common::OpValue::Mul common::Op::new ops_mul.push
    ops_mul tc_check = tc_mul
    "mul type" "i64" 0 tc_mul
        .stack
        .get_types
        .get
        .format test::assert_str_eq

    # Div
    std::List[common::Op]::new = ops_div
    common::empty_location 10 common::make_integer_op_value common::Op::new ops_div.push
    common::empty_location 2 common::make_integer_op_value common::Op::new ops_div.push
    common::empty_location common::OpValue::Div common::Op::new ops_div.push
    ops_div tc_check = tc_div
    "div type" "i64" 0 tc_div
        .stack
        .get_types
        .get
        .format test::assert_str_eq

    # Mod
    std::List[common::Op]::new = ops_mod
    common::empty_location 10 common::make_integer_op_value common::Op::new ops_mod.push
    common::empty_location 3 common::make_integer_op_value common::Op::new ops_mod.push
    common::empty_location common::OpValue::Mod common::Op::new ops_mod.push
    ops_mod tc_check = tc_mod
    "mod type" "i64" 0 tc_mod
        .stack
        .get_types
        .get
        .format test::assert_str_eq
}

