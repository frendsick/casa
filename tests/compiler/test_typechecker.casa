        .length assert_eq
    "result type is i64" "i64" 0 result_tc
        .stack
        .get_types
        .get
        .format assert_str_eq
}

# ============================================================================
# Tests: Sub/Mul/Div/Mod stack effects
# ============================================================================

fn test_arithmetic_ops {
    "arithmetic_ops" test_start

    # Sub
    List[Op]::new = ops_sub
    empty_location 5 make_integer_op_value Op::new ops_sub.push
    empty_location 3 make_integer_op_value Op::new ops_sub.push
    empty_location OpValue::Sub Op::new ops_sub.push
    ops_sub tc_check = tc_sub
    "sub result" 1 tc_sub
        .stack
        .get_types
        .length assert_eq
    "sub type" "i64" 0 tc_sub
        .stack
        .get_types
        .get
        .format assert_str_eq

    # Mul
    List[Op]::new = ops_mul
    empty_location 2 make_integer_op_value Op::new ops_mul.push
    empty_location 3 make_integer_op_value Op::new ops_mul.push
    empty_location OpValue::Mul Op::new ops_mul.push
    ops_mul tc_check = tc_mul
    "mul type" "i64" 0 tc_mul
        .stack
        .get_types
        .get
        .format assert_str_eq

    # Div
    List[Op]::new = ops_div
    empty_location 10 make_integer_op_value Op::new ops_div.push
    empty_location 2 make_integer_op_value Op::new ops_div.push
    empty_location OpValue::Div Op::new ops_div.push
    ops_div tc_check = tc_div
    "div type" "i64" 0 tc_div
        .stack
        .get_types
        .get
        .format assert_str_eq

    # Mod
    List[Op]::new = ops_mod
    empty_location 10 make_integer_op_value Op::new ops_mod.push
    empty_location 3 make_integer_op_value Op::new ops_mod.push
    empty_location OpValue::Mod Op::new ops_mod.push
    ops_mod tc_check = tc_mod
    "mod type" "i64" 0 tc_mod
        .stack
        .get_types
        .get
        .format assert_str_eq
}

