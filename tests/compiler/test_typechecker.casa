# OpFnReturn inside a branch restores stack from the frame's `before` snapshot.

fn test_branch_return_inside_if_restores_stack {
    "branch_return_inside_if_restores_stack" test_start
    Diagnostics::new = diagnostics
    symbol_store_new = store
    diagnostics store TypeChecker::new = tc
    # Seed the stack with a single `i64`.
    TYPE_I64_T tc.stack_push_type
    # Begin an `if true then` block.
    List[Op]::new = begin_ops
    empty_location OpValue::IfStart Op::new begin_ops.push
    empty_location 1 OpValue::PushBool Op::new begin_ops.push
    empty_location OpValue::IfCondition Op::new begin_ops.push
    0 (u64) = br_i
    while br_i begin_ops.length > do
        br_i begin_ops.get_mut = br_op
        br_op Op::value clone_op_value = br_kind
        if
            OpValue::IfStart br_kind ==
            OpValue::IfCondition br_kind == ||
        then
            br_op tc.check_if_block
        elif 0 OpValue::PushBool br_kind == then
            TYPE_BOOL_T tc.stack_push_type
        fi
        1 += br_i
    done
    # Body modifies the stack by pushing an extra `str`.
    TYPE_STR_T tc.stack_push_type
    "stack grew inside branch" 2 tc
        .stack
        .get_types
        .length assert_eq
    # Simulate OpFnReturn: first visit snapshots stack into return_types, then
    # restores stack from the top frame's before snapshot.
    "has_return_types starts false" tc.has_return_types assert_false
    tc.stack tc.return_types.restore
    true = tc.has_return_types
    tc.branched_stacks.length 1 - tc.branched_stacks.get = ret_frame
    if ret_frame BranchFrame::BranchIf(ret_if_ctx) is then
        ret_if_ctx IfContext::before tc.stack.restore
    fi
    "stack restored to pre-branch state" 1 tc
        .stack
        .get_types
        .length assert_eq
    "restored type is i64" "i64" 0 tc
        .stack
        .get_types
        .get
        .format assert_str_eq
    "return_types snapshot captured full state" 2 tc
        .return_types
        .get_types
        .length assert_eq
}

fn test_imported_fstring_uses_global_type {
    Diagnostics::new = diagnostics
    "imported_fstring_uses_global_type" test_start
    SourceStore::new = sources
    "trait Display { fn to_str self:self -> str } impl i64: Display { fn to_str n:i64 -> str { \"42\" } } 65536 = IMPORTED_SIZE fn render -> str { f\"{IMPORTED_SIZE}\" }"
    "/tmp/casa_import_global_type_258.casa"
    sources.add
    "fn unrelated -> i64 { 1 }" "/tmp/casa_import_after_global_258.casa" sources.add
    "root" "import \"/tmp/casa_import_global_type_258.casa\" import \"/tmp/casa_import_after_global_258.casa\"" lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    sources lex_diagnostics List[str]::new tokens parse_and_resolve = result
    result.into_parts = parse_diagnostics = store = result_ops
    parse_diagnostics diagnostics.merge
    result_ops match
        Option::Some(ops) => {
            diagnostics store Option::None ops check_ops drop
            diagnostics store type_check_functions_for_test
            diagnostics "imported capture keeps global type" assert_no_errors
        }
        Option::None => "parse succeeds" false assert_true
    end
}

fn test_fstring_capture_uses_inferred_global_type {
    Diagnostics::new = diagnostics
    "fstring_capture_uses_inferred_global_type" test_start
    diagnostics "0 = count fn render -> str { f\"{count}\" }" parse_resolve_test_parts = store = ops
    diagnostics store Option::None ops check_ops drop
    diagnostics store type_check_functions_for_test
    false = found_conversion
    for pair in store.functions.iter do
        for
            op in pair
                .second
                .ops
                .iter
        do
            if op.value OpValue::PrimitiveToStr is then
                true = found_conversion
            fi
        done
    done
    "captured i64 is converted to str" found_conversion assert_true
    diagnostics "captured global keeps inferred type" assert_no_errors
}

# ============================================================================
# Tests: explicit typecheck phase result
# ============================================================================

fn typecheck_source code:$str diagnostics:mut$Diagnostics -> TypecheckResult {
    diagnostics code parse_resolve_test_parts = store = ops
    store ops type_check
}

fn test_typecheck_result_exposes_phase_outputs {
    Diagnostics::new = diagnostics
    "typecheck_result_exposes_phase_outputs" test_start
    diagnostics "42 = answer answer print" typecheck_source = result
    "no diagnostics" 0 result
        .diagnostics
        .entries
        .length assert_eq
    "global stack is empty" 0 result
        .global_stack_effect
        .return_types
        .length assert_eq
    "ops returned" 4 result.ops.length assert_eq
    "print resolved" 3 result
        .ops
        .get
        .value OpValue::PrintInt is assert_true
    "updated store returned" "i64" "answer" result
        .store
        .variables
        .get
        .unwrap
        .typ
        .format assert_str_eq
}

fn test_typecheck_collects_independent_errors {
    Diagnostics::new = diagnostics
    "typecheck_collects_independent_errors" test_start
    diagnostics "\"first\" 1 * true 2 *" typecheck_source = result
    "two independent errors" 2 result.diagnostics.error_count assert_eq
    "bytecode blocked" result.diagnostics.has_errors assert_true
}

fn test_typecheck_missing_sentinel_suppresses_cascade {
    Diagnostics::new = diagnostics
    "typecheck_missing_sentinel_suppresses_cascade" test_start
    diagnostics "fn broken -> i64 { 1 * }" typecheck_source = result
    "one underflow error" 1 result.diagnostics.error_count assert_eq
}

fn test_typecheck_unknown_sentinel_suppresses_display_cascade {
    "typecheck_unknown_sentinel_suppresses_display_cascade" test_start
    Diagnostics::new = diagnostics
    symbol_store_new = store
    diagnostics store TypeChecker::new = checker
    TYPE_UNKNOWN_T checker.stack_push_type
    List[Op]::new = ops
    empty_location OpValue::Print Op::new = print_op
    print_op ops.push
    Option[Function]::None 1 ops 0 ops.get_mut checker.check_io drop
    TYPE_UNKNOWN_T checker.stack_push_type
    List[Op]::new = fstring_ops
    empty_location OpValue::FstringToStr Op::new = fstring_op
    fstring_op fstring_ops.push
    Option[Function]::None 1 fstring_ops 0 fstring_ops.get_mut checker.check_fstring_to_str drop
    "unknown types add no display errors" 0 checker.diagnostics.error_count assert_eq
}

fn test_typechecker_preserves_warning_error_order {
    "typechecker_preserves_warning_error_order" test_start
    Diagnostics::new = diagnostics
    symbol_store_new = store
    diagnostics store TypeChecker::new = checker
    empty_location "completed warning" WarningKind::UnusedParameter CasaWarning checker.diagnostics.push_warning
    List[Op]::new = ops
    empty_location "bad" OpValue::PushStr Op::new ops.push
    empty_location 1 make_integer_op_value Op::new ops.push
    empty_location OpValue::Mul Op::new ops.push
    Option[Function]::None ops checker.run_type_check_ops
    "warning and error retained" 2 checker
        .diagnostics
        .entries
        .length assert_eq
    "warning remains first" 0 checker
        .diagnostics
        .entries
        .get Diagnostic::Warning is assert_true
    "error remains second" 1 checker
        .diagnostics
        .entries
        .get Diagnostic::Error is assert_true
}

