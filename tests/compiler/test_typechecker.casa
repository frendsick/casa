    common::empty_location 0 common::OpValue::PushBool common::Op::new ops_and.push
    common::empty_location common::OpValue::And common::Op::new ops_and.push
    ops_and tc_check = tc_and
    "and result" "bool" 0 tc_and
        .stack
        .get_types
        .get
        .format test::assert_str_eq

    # OR
    std::List[common::Op]::new = ops_or
    common::empty_location 1 common::OpValue::PushBool common::Op::new ops_or.push
    common::empty_location 0 common::OpValue::PushBool common::Op::new ops_or.push
    common::empty_location common::OpValue::Or common::Op::new ops_or.push
    ops_or tc_check = tc_or
    "or result" "bool" 0 tc_or
        .stack
        .get_types
        .get
        .format test::assert_str_eq

    # NOT
    std::List[common::Op]::new = ops_not
    common::empty_location 1 common::OpValue::PushBool common::Op::new ops_not.push
    common::empty_location common::OpValue::Not common::Op::new ops_not.push
    ops_not tc_check = tc_not
    "not result" "bool" 0 tc_not
        .stack
        .get_types
        .get
        .format test::assert_str_eq
}

