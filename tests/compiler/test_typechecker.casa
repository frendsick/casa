# ============================================================================
# Helper: full pipeline typecheck
# ============================================================================

pub fn tc_string code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

# ============================================================================
# Tests via full pipeline (lex -> parse -> resolve -> typecheck)
# Each tc_string call uses significant heap, so we batch assertions.
# ============================================================================

pub fn test_tc_pipeline_literals {
    error::Diagnostics::new = diagnostics
    "tc_pipeline_literals" test::test_start
    diagnostics "42" tc_string = effect1
    "i64 count" 1 effect1 common::StackEffect::return_types.length test::assert_eq
    "i64 type" "i64" 0 effect1 common::StackEffect::return_types.get.format test::assert_str_eq
    diagnostics "true" tc_string = effect2
    "bool" "bool" 0 effect2 common::StackEffect::return_types.get.format test::assert_str_eq
    diagnostics "\"hello\"" tc_string = effect3
    "str" "str" 0 effect3 common::StackEffect::return_types.get.format test::assert_str_eq
    diagnostics "'a'" tc_string = effect4
    "char" "char" 0 effect4 common::StackEffect::return_types.get.format test::assert_str_eq
}

