# ============================================================================
# Tests: Push different literal types
# ============================================================================

pub fn test_push_literals {
    "push_literals" test::test_start
    std::List[common::Op]::new = ops
    common::empty_location 42 common::make_integer_op_value common::Op::new ops.push
    common::empty_location "hi".to_str common::OpValue::PushStr common::Op::new ops.push
    common::empty_location 1 common::OpValue::PushBool common::Op::new ops.push
    common::empty_location 65 common::OpValue::PushChar common::Op::new ops.push
    ops tc_check = result_tc
    "four items on stack" 4 result_tc
        .stack
        .get_types
        .length test::assert_eq
    "i64" "i64" 0 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
    "str" "str" 1 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
    "bool" "bool" 2 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
    "char" "char" 3 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
}

# ============================================================================
# Tests: Print resolves to typed variant
# ============================================================================

pub fn test_print_dispatch {
    "print_dispatch" test::test_start

    # print str -> OpPrintStr
    std::List[common::Op]::new = ops_str
    common::empty_location "hello".to_str common::OpValue::PushStr common::Op::new ops_str.push
    common::empty_location common::OpValue::Print common::Op::new ops_str.push
    ops_str tc_check drop
    "print str resolved" 1 ops_str.get.value common::OpValue::PrintStr is test::assert_true

    # print i64 -> OpPrintInt
    std::List[common::Op]::new = ops_int
    common::empty_location 42 common::make_integer_op_value common::Op::new ops_int.push
    common::empty_location common::OpValue::Print common::Op::new ops_int.push
    ops_int tc_check drop
    "print i64 resolved" 1 ops_int.get.value common::OpValue::PrintInt is test::assert_true

    # print bool -> OpPrintBool
    std::List[common::Op]::new = ops_bool
    common::empty_location 1 common::OpValue::PushBool common::Op::new ops_bool.push
    common::empty_location common::OpValue::Print common::Op::new ops_bool.push
    ops_bool tc_check drop
    "print bool resolved" 1 ops_bool.get.value common::OpValue::PrintBool is test::assert_true
}

