    diagnostics store std::Option::None ops typechecker::check_ops drop
    diagnostics store helpers::type_check_functions_for_test
    false = found_conversion
    for function_name in store.get_function_names.iter do
        function_name.as_str store.get_function.unwrap = function
        for op in function.ops.iter do
            if op.value common::OpValue::PrimitiveToStr is then
                true = found_conversion
            fi
        done
    done
    "captured i64 is converted to str" found_conversion test::assert_true
    diagnostics "captured global keeps inferred type" helpers::assert_no_errors
}

