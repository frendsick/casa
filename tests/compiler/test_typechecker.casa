pub fn test_raw_borrow_return_origins {
    "raw_borrow_return_origins" test::test_start
    error::Diagnostics::new = shared_diagnostics
    shared_diagnostics
    "fn ignore value:$u8 { } fn view address:ptr anchor:$u8 -> $u8 { anchor drop unsafe { address ptr::as_ref[u8] } } 0 (u8) unsafe { 0 (ptr) } view ignore"
    tc_string drop
    shared_diagnostics "shared raw borrow uses borrowed input" helpers::assert_no_errors

    error::Diagnostics::new = missing_diagnostics
    missing_diagnostics
    "fn ignore value:$u8 { } fn view address:ptr -> $u8 { unsafe { address ptr::as_ref[u8] } } unsafe { 0 (ptr) } view ignore"
    tc_string drop
    missing_diagnostics "raw borrow without input"
    "Borrowed return has no live input origin" helpers::assert_error_contains

    error::Diagnostics::new = exclusive_diagnostics
    exclusive_diagnostics
    "fn ignore value:mut$u8 { } fn view address:ptr anchor:mut$u8 -> mut$u8 { anchor drop unsafe { address ptr::as_mut[u8] } } 0 (u8) = anchor anchor unsafe { 0 (ptr) } view ignore"
    tc_string drop
    exclusive_diagnostics "exclusive raw borrow uses exclusive input" helpers::assert_no_errors

    error::Diagnostics::new = shared_only_diagnostics
    shared_only_diagnostics
    "fn ignore value:mut$u8 { } fn view address:ptr anchor:$u8 -> mut$u8 { anchor drop unsafe { address ptr::as_mut[u8] } } 0 (u8) unsafe { 0 (ptr) } view ignore"
    tc_string drop
    shared_only_diagnostics "exclusive raw borrow rejects shared input"
    "Borrowed return has no live input origin" helpers::assert_error_contains
}

pub fn test_borrowed_copy_returns {
    "borrowed_copy_returns" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "fn use value:$u8 { } fn direct value:$u8 -> $u8 { value } fn early value:$u8 -> $u8 { value return } 0 (u8) direct use 0 (u8) early use"
    tc_string drop
    diagnostics "borrowed Copy values can leave a function" helpers::assert_no_errors
}

pub fn test_generic_callback_capabilities {
    "generic_callback_capabilities" test::test_start

    error::Diagnostics::new = owned_diagnostics
    owned_diagnostics
    "fn apply_owned[T] value:T callback:fn[T] { value callback exec } fn take_shared value:$i64 { } 0 (i64) = value &take_shared value apply_owned"
    tc_string drop
    owned_diagnostics "owned callback preserves capability" helpers::assert_has_errors

    error::Diagnostics::new = shared_diagnostics
    shared_diagnostics
    "fn apply_shared[T] value:T callback:fn[$T] { value callback exec } fn take_owned value:i64 { } 0 (i64) = value &take_owned value apply_shared"
    tc_string drop
    shared_diagnostics "shared callback preserves capability" helpers::assert_has_errors

    error::Diagnostics::new = unresolved_diagnostics
    unresolved_diagnostics
    "fn apply_unresolved[T] value:T callback:fn[$T] { value callback exec } { 0 (i64) apply_unresolved } drop"
    tc_string drop
    unresolved_diagnostics "unresolved callback is rejected" helpers::assert_has_errors
    unresolved_diagnostics "unresolved callback guidance"
    "Add explicit callback parameter types" helpers::assert_error_contains

    error::Diagnostics::new = exclusive_diagnostics
    exclusive_diagnostics
    "fn apply_exclusive[T] value:T callback:fn[mut$T] { value callback exec } fn take_shared value:$i64 { } 0 (i64) = value &take_shared value apply_exclusive"
    tc_string drop
    exclusive_diagnostics "exclusive callback preserves capability" helpers::assert_has_errors

    error::Diagnostics::new = compatible_diagnostics
    compatible_diagnostics
    "fn apply_owned_ok[T] value:T callback:fn[T] { value callback exec } fn take_owned_ok value:i64 { } fn apply_shared_ok[T] value:T callback:fn[$T] { value callback exec } fn take_shared_ok value:$i64 { } fn apply_exclusive_ok[T] value:T callback:fn[mut$T] { value callback exec } fn take_exclusive_ok value:mut$i64 { } 0 (i64) = owned &take_owned_ok owned apply_owned_ok 0 (i64) = shared &take_shared_ok shared apply_shared_ok 0 (i64) = exclusive &take_exclusive_ok exclusive apply_exclusive_ok"
    tc_string drop
    compatible_diagnostics "compatible callbacks keep their capabilities" helpers::assert_no_errors
}

pub fn test_contextual_lambda_parameters {
    "contextual_lambda_parameters" test::test_start
    4 (i64) = threshold
    { threshold < } 5 (i64) std::Option::Some.filter drop
    { copy threshold < } 5 (i64) std::Option::Some.filter drop
    error::Diagnostics::new = diagnostics
    diagnostics
    "fn apply_shared[T] value:T callback:fn[$T -> bool] -> bool { value callback exec } fn apply_callback_first[T] callback:fn[$T -> bool] value:T -> bool { value callback exec } 4 (i64) = threshold { threshold < } 5 (i64) apply_shared drop 5 (i64) { threshold < } apply_callback_first drop { copy threshold < } 5 (i64) apply_shared drop fn fold[T] left:T right:T callback:fn[T T -> T] -> T { right left callback exec } { + } 1 (i64) 2 (i64) fold drop { 1 + } = increment 2 increment exec drop"
    tc_string drop
    diagnostics "resolved callback types seed lambda parameters" helpers::assert_no_errors
}

