# ============================================================================
# Tests: stack_effect_type_matches
# ============================================================================

pub fn test_types_match {
    "stack_effect_type_matches" test::test_start
    "same types" "i64" common::parse_type_str "i64" common::parse_type_str common::stack_effect_type_matches test::assert_true
    "TYPE_UNKNOWN matches i64" "i64" common::parse_type_str common::make_unknown_type common::stack_effect_type_matches test::assert_true
    "i64 matches TYPE_UNKNOWN" common::make_unknown_type "i64" common::parse_type_str common::stack_effect_type_matches test::assert_true
    "different types" "str" common::parse_type_str "i64" common::parse_type_str common::stack_effect_type_matches ! test::assert_true
    "fn base matches fn type" "fn[i64 -> i64]" common::parse_type_str "fn" common::parse_type_str common::stack_effect_type_matches test::assert_true
    "bare generic rejects parameterized" "List[i64]" common::parse_type_str "List" common::parse_type_str common::stack_effect_type_matches ! test::assert_true
}

# ============================================================================
# Tests: unify_type_t
# ============================================================================

pub fn test_unify_type {
    "unify_type_t" test::test_start
    common::symbol_store_new = store
    "same" "i64" store "i64" common::parse_type_str "i64" common::parse_type_str semantics::unify_type_t.unwrap.format test::assert_str_eq
    "unknown + i64" "i64" store "i64" common::parse_type_str common::make_unknown_type semantics::unify_type_t.unwrap.format test::assert_str_eq
    "i64 + unknown" "i64" store common::make_unknown_type "i64" common::parse_type_str semantics::unify_type_t.unwrap.format test::assert_str_eq
    "incompatible" store "str" common::parse_type_str "i64" common::parse_type_str semantics::unify_type_t.is_none test::assert_true
}

# ============================================================================
# Tests: stacks_compatible
# ============================================================================

pub fn test_stacks_compatible {
    error::Diagnostics::new = diagnostics
    "stacks_compatible" test::test_start
    common::symbol_store_new = store
    std::List[common::Type]::new = stack_a
    "i64" common::parse_type_str stack_a.push
    "str" common::parse_type_str stack_a.push
    std::List[common::Type]::new = stack_b
    "i64" common::parse_type_str stack_b.push
    "str" common::parse_type_str stack_b.push
    store stack_b stack_a typechecker::stacks_compatible = result
    "compatible stacks" 2 result.length test::assert_eq

    std::List[common::Type]::new = stack_c
    "i64" common::parse_type_str stack_c.push
    std::List[common::Type]::new = stack_d
    "i64" common::parse_type_str stack_d.push
    "str" common::parse_type_str stack_d.push
    store stack_d stack_c typechecker::stacks_compatible = result2
    "incompatible lengths" 0 result2.length test::assert_eq
}

