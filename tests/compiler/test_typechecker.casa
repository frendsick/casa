# OpFnReturn inside a branch restores stack from the frame's `before` snapshot.

pub fn test_branch_return_inside_if_restores_stack {
    "branch_return_inside_if_restores_stack" test::test_start
    error::Diagnostics::new = diagnostics
    common::symbol_store_new = store
    diagnostics store typechecker::TypeChecker::new = tc
    # Seed the stack with a single `i64`.
    common::make_i64_type tc.stack_push_type
    # Begin an `if true then` block.
    std::List[common::Op]::new = begin_ops
    common::empty_location common::OpValue::IfStart common::Op::new begin_ops.push
    common::empty_location 1 common::OpValue::PushBool common::Op::new begin_ops.push
    common::empty_location common::OpValue::IfCondition common::Op::new begin_ops.push
    0 (u64) = br_i
    while br_i begin_ops.length > do
        br_i begin_ops.get_mut = br_op
        br_op common::Op::value common::clone_op_value = br_kind
        if
            br_kind common::OpValue::IfStart is
            br_kind common::OpValue::IfCondition is ||
        then
            br_op tc.check_if_block
        elif br_kind common::OpValue::PushBool is then
            common::make_bool_type tc.stack_push_type
        fi
        1 += br_i
    done
    # Body modifies the stack by pushing an extra `str`.
    common::make_str_type tc.stack_push_type
    "stack grew inside branch" 2 tc
        .stack
        .get_types
        .length test::assert_eq
    # Simulate OpFnReturn: first visit snapshots stack into return_types, then
    # restores stack from the top frame's before snapshot.
    "has_return_types starts false" tc.has_return_types test::assert_false
    tc.stack tc.return_types.restore
    true = tc.has_return_types
    tc.branched_stacks.length 1 - tc.branched_stacks.get = ret_frame
    if ret_frame typechecker::BranchFrame::BranchIf(ret_if_ctx) is then
        ret_if_ctx typechecker::IfContext::before tc.stack.restore
    fi
    "stack restored to pre-branch state" 1 tc
        .stack
        .get_types
        .length test::assert_eq
    "restored type is i64" "i64" 0 tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
    "return_types snapshot captured full state" 2 tc
        .return_types
        .get_types
        .length test::assert_eq
}

pub fn test_fstring_capture_uses_inferred_global_type {
    error::Diagnostics::new = diagnostics
    "fstring_capture_uses_inferred_global_type" test::test_start
