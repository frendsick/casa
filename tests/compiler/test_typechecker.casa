# ============================================================================
# Tests: All comparison operators produce bool
# ============================================================================

pub fn test_all_comparison_ops {
    "all_comparison_ops" test::test_start

    # Eq
    std::List[common::Op]::new = ops_eq
    common::empty_location 1 common::make_integer_op_value common::Op::new ops_eq.push
    common::empty_location 1 common::make_integer_op_value common::Op::new ops_eq.push
    common::empty_location common::OpValue::Eq common::Op::new ops_eq.push
    ops_eq tc_check = tc_eq
    "eq is bool" "bool" 0 tc_eq
        .stack
        .get_types
        .get
        .format test::assert_str_eq

    # Ne
    std::List[common::Op]::new = ops_ne
    common::empty_location 1 common::make_integer_op_value common::Op::new ops_ne.push
    common::empty_location 2 common::make_integer_op_value common::Op::new ops_ne.push
    common::empty_location common::OpValue::Ne common::Op::new ops_ne.push
    ops_ne tc_check = tc_ne
    "ne is bool" "bool" 0 tc_ne
        .stack
        .get_types
        .get
        .format test::assert_str_eq

    # Le
    std::List[common::Op]::new = ops_le
    common::empty_location 1 common::make_integer_op_value common::Op::new ops_le.push
    common::empty_location 2 common::make_integer_op_value common::Op::new ops_le.push
    common::empty_location common::OpValue::Le common::Op::new ops_le.push
    ops_le tc_check = tc_le
    "le is bool" "bool" 0 tc_le
        .stack
        .get_types
        .get
        .format test::assert_str_eq

    # Ge
    std::List[common::Op]::new = ops_ge
    common::empty_location 1 common::make_integer_op_value common::Op::new ops_ge.push
    common::empty_location 2 common::make_integer_op_value common::Op::new ops_ge.push
    common::empty_location common::OpValue::Ge common::Op::new ops_ge.push
    ops_ge tc_check = tc_ge
    "ge is bool" "bool" 0 tc_ge
        .stack
        .get_types
        .get
        .format test::assert_str_eq

    # Gt
    std::List[common::Op]::new = ops_gt
    common::empty_location 5 common::make_integer_op_value common::Op::new ops_gt.push
    common::empty_location 2 common::make_integer_op_value common::Op::new ops_gt.push
    common::empty_location common::OpValue::Gt common::Op::new ops_gt.push
    ops_gt tc_check = tc_gt
    "gt is bool" "bool" 0 tc_gt
        .stack
        .get_types
        .get
        .format test::assert_str_eq
}

