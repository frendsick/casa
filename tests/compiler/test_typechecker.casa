# ============================================================================
# Tests: ROT stack effect
# ============================================================================

fn test_rot_stack_effect {
    "rot_stack_effect" test_start
    List[Op]::new = ops
    empty_location 42 make_integer_op_value Op::new ops.push
    empty_location "hello" OpValue::PushStr Op::new ops.push
    empty_location 1 OpValue::PushBool Op::new ops.push
    empty_location OpValue::Rot Op::new ops.push
    ops tc_check = result_tc
    "stack after rot" 3 result_tc
        .stack
        .get_types
        .length assert_eq
    # ROT: pop t1(bool), t2(str), t3(i64) -> push t2(str), t1(bool), t3(i64)
    "bottom is str" "str" 0 result_tc
        .stack
        .get_types
        .get
        .format assert_str_eq
    "middle is bool" "bool" 1 result_tc
        .stack
        .get_types
        .get
        .format assert_str_eq
    "top is i64" "i64" 2 result_tc
        .stack
        .get_types
        .get
        .format assert_str_eq
}

