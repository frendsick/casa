# ============================================================================
# Tests: Additional types_match cases
# ============================================================================

pub fn test_types_match_extended {
    "types_match_extended" test::test_start
    "both unknown" common::make_unknown_type common::clone_type common::make_unknown_type common::clone_type common::stack_effect_type_matches test::assert_true
    "str str" "str" common::parse_type_str "str" common::parse_type_str common::stack_effect_type_matches test::assert_true
    "bool bool" "bool" common::parse_type_str "bool" common::parse_type_str common::stack_effect_type_matches test::assert_true
    "ptr ptr" "ptr" common::parse_type_str "ptr" common::parse_type_str common::stack_effect_type_matches test::assert_true
    "i64 vs str" "i64" common::parse_type_str "str" common::parse_type_str common::stack_effect_type_matches ! test::assert_true
    "i64 vs bool" "i64" common::parse_type_str "bool" common::parse_type_str common::stack_effect_type_matches ! test::assert_true
}

# ============================================================================
# Tests: stacks_compatible with TYPE_UNKNOWN sentinel
# ============================================================================

pub fn test_stacks_compatible_with_unknown {
    "stacks_compatible_with_unknown" test::test_start
    common::symbol_store_new = store
    std::List[common::Type]::new = stack_a
    "i64" common::parse_type_str stack_a.push
    std::List[common::Type]::new = stack_b
    common::TYPE_UNKNOWN common::parse_type_str stack_b.push
    store stack_b stack_a typechecker::stacks_compatible = result
    "TYPE_UNKNOWN matches i64" 1 result.length test::assert_eq
}

pub fn test_stacks_compatible_empty {
    "stacks_compatible_empty" test::test_start
    common::symbol_store_new = store
    std::List[common::Type]::new = stack_a
    std::List[common::Type]::new = stack_b
    store stack_b stack_a typechecker::stacks_compatible = result
    "empty stacks compatible" 0 result.length test::assert_eq
}

