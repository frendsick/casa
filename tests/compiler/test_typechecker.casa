    diagnostics store helpers::type_check_functions_for_test
}

pub fn test_error_syscall_non_word_bound_type_var {
    error::Diagnostics::new = diagnostics
    "error_syscall_non_word_bound_type_var" test::test_start
    diagnostics "trait __casa_std__Word { } trait NotWord { } fn fail_syscall[T: NotWord] arg:T -> i64 { arg 1 syscall1 } 42 fail_syscall drop" tc_full
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "mentions Word" "Word" helpers::assert_error_contains
}

pub fn test_syscall_word_bound_explicit_passes {
    error::Diagnostics::new = diagnostics
    "syscall_word_bound_explicit_passes" test::test_start
    diagnostics "trait __casa_std__Word { } impl i64: __casa_std__Word { } fn ok_syscall[T: __casa_std__Word] arg:T -> i64 { unsafe { arg 1 syscall1 } } 42 ok_syscall drop" tc_full
    diagnostics "no errors" helpers::assert_no_errors
}

pub fn test_syscall_unbound_type_var_passes {
    error::Diagnostics::new = diagnostics
    "syscall_unbound_type_var_passes" test::test_start
    diagnostics "trait __casa_std__Word { } fn deferred_syscall[T] arg:T -> i64 { unsafe { arg 1 syscall1 } } 42 deferred_syscall drop" tc_full
    diagnostics "no errors" helpers::assert_no_errors
}

pub fn test_store64_rejects_generic_word_without_conversion {
    error::Diagnostics::new = diagnostics
    "store64_rejects_generic_word_without_conversion" test::test_start
    diagnostics "trait __casa_std__Word { } impl i64: __casa_std__Word { } fn store[T: __casa_std__Word] destination:ptr value:T -> None { unsafe { value destination store64 } } unsafe { 42 8 alloc store }" tc_full
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "requires u64" "Expected `u64`, got `T`" helpers::assert_error_contains
}

pub fn test_store64_explicit_conversion_passes {
    error::Diagnostics::new = diagnostics
    "store64_explicit_conversion_passes" test::test_start
    diagnostics "trait __casa_std__Word { } impl i64: __casa_std__Word { } fn store[T: __casa_std__Word] destination:ptr value:T -> None { unsafe { value (u64) destination store64 } } unsafe { 42 8 alloc store }" tc_full
    diagnostics "no errors" helpers::assert_no_errors
}

# ============================================================================
# Tests: Syscall op-level stack effects
# ============================================================================

pub fn test_syscall_op_level {
    "syscall_op_level" test::test_start

    # syscall0: pops 1 (syscall number), pushes i64
    std::List[common::Op]::new = ops0
    common::empty_location 60 common::make_integer_op_value common::Op::new ops0.push
    common::empty_location common::OpValue::Syscall0 common::Op::new ops0.push
    ops0 tc_check = tc0
    "syscall0 result" 1 tc0
        .stack
        .get_types
        .length test::assert_eq
    "syscall0 type" "i64" 0 tc0
        .stack
        .get_types
        .get
        .format test::assert_str_eq

    # syscall1: pops 2 (1 arg + syscall number), pushes i64
    std::List[common::Op]::new = ops1
    common::empty_location 0 common::make_integer_op_value common::Op::new ops1.push
    common::empty_location 60 common::make_integer_op_value common::Op::new ops1.push
    common::empty_location common::OpValue::Syscall1 common::Op::new ops1.push
    ops1 tc_check = tc1
    "syscall1 result" 1 tc1
        .stack
        .get_types
        .length test::assert_eq
    "syscall1 type" "i64" 0 tc1
        .stack
        .get_types
        .get
        .format test::assert_str_eq

    # syscall3: pops 4 (3 args + syscall number), pushes i64
    std::List[common::Op]::new = ops3
    common::empty_location 0 common::make_integer_op_value common::Op::new ops3.push
    common::empty_location 0 common::make_integer_op_value common::Op::new ops3.push
    common::empty_location 0 common::make_integer_op_value common::Op::new ops3.push
    common::empty_location 1 common::make_integer_op_value common::Op::new ops3.push
    common::empty_location common::OpValue::Syscall3 common::Op::new ops3.push
    ops3 tc_check = tc3
    "syscall3 result" 1 tc3
        .stack
        .get_types
        .length test::assert_eq
    "syscall3 type" "i64" 0 tc3
        .stack
        .get_types
        .get
        .format test::assert_str_eq
}

