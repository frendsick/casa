# ============================================================================
# Tests: Dup preserves various types
# ============================================================================

pub fn test_dup_preserves_str {
    "dup_preserves_str" test::test_start
    std::List[common::Op]::new = ops
    common::empty_location "hello".to_str common::OpValue::PushStr common::Op::new ops.push
    common::empty_location common::OpValue::Dup common::Op::new ops.push
    ops tc_check = result_tc
    "dup str count" 2 result_tc
        .stack
        .get_types
        .length test::assert_eq
    "dup str first" "str" 0 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
    "dup str second" "str" 1 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
}

pub fn test_dup_preserves_bool {
    "dup_preserves_bool" test::test_start
    std::List[common::Op]::new = ops
    common::empty_location 1 common::OpValue::PushBool common::Op::new ops.push
    common::empty_location common::OpValue::Dup common::Op::new ops.push
    ops tc_check = result_tc
    "dup bool count" 2 result_tc
        .stack
        .get_types
        .length test::assert_eq
    "dup bool first" "bool" 0 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
    "dup bool second" "bool" 1 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
}

