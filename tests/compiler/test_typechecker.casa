# ============================================================================
# Tests: stack_effect_type_matches
# ============================================================================

fn test_types_match {
    "stack_effect_type_matches" test_start
    "same types" "i64" parse_type_str "i64" parse_type_str stack_effect_type_matches assert_true
    "TYPE_UNKNOWN matches i64" "i64" parse_type_str TYPE_UNKNOWN_T stack_effect_type_matches assert_true
    "i64 matches TYPE_UNKNOWN" TYPE_UNKNOWN_T "i64" parse_type_str stack_effect_type_matches assert_true
    "different types" "str" parse_type_str "i64" parse_type_str stack_effect_type_matches ! assert_true
    "fn base matches fn type" "fn[i64 -> i64]" parse_type_str "fn" parse_type_str stack_effect_type_matches assert_true
    "bare generic rejects parameterized" "List[i64]" parse_type_str "List" parse_type_str stack_effect_type_matches ! assert_true
}

# ============================================================================
# Tests: unify_type_t
# ============================================================================

fn test_unify_type {
    "unify_type_t" test_start
    symbol_store_new = store
    "same" "i64" store "i64" parse_type_str "i64" parse_type_str unify_type_t.unwrap.format assert_str_eq
    "unknown + i64" "i64" store "i64" parse_type_str TYPE_UNKNOWN_T unify_type_t.unwrap.format assert_str_eq
    "i64 + unknown" "i64" store TYPE_UNKNOWN_T "i64" parse_type_str unify_type_t.unwrap.format assert_str_eq
    "incompatible" store "str" parse_type_str "i64" parse_type_str unify_type_t.is_none assert_true
}

# ============================================================================
# Tests: stacks_compatible
# ============================================================================

fn test_stacks_compatible {
    Diagnostics::new = diagnostics
    "stacks_compatible" test_start
    symbol_store_new = store
    List[Type]::new = stack_a
    "i64" parse_type_str stack_a.push
    "str" parse_type_str stack_a.push
    List[Type]::new = stack_b
    "i64" parse_type_str stack_b.push
    "str" parse_type_str stack_b.push
    store stack_b stack_a stacks_compatible = result
    "compatible stacks" 2 result.length assert_eq

    List[Type]::new = stack_c
    "i64" parse_type_str stack_c.push
    List[Type]::new = stack_d
    "i64" parse_type_str stack_d.push
    "str" parse_type_str stack_d.push
    store stack_d stack_c stacks_compatible = result2
    "incompatible lengths" 0 result2.length assert_eq
}

# ============================================================================
# Tests: Full diagnostics type_check_ops_for_test via parsing
# ============================================================================

fn test_typecheck_simple_expression {
    Diagnostics::new = diagnostics
    "typecheck_simple_expression" test_start
    diagnostics "10 20 +" parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops type_check_ops_for_test = sig
    "params" 0 sig StackEffect::parameters.length assert_eq
    "returns" 1 sig StackEffect::return_types.length assert_eq
    "return type" "i64" 0 sig StackEffect::return_types.get.format assert_str_eq
}

# ============================================================================
# Helper: full pipeline typecheck
# ============================================================================

fn tc_string code:$str diagnostics:mut$Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops type_check_ops_for_test
}

# ============================================================================
# Tests via full pipeline (lex -> parse -> resolve -> typecheck)
# Each tc_string call uses significant heap, so we batch assertions.
# ============================================================================

fn test_tc_pipeline_literals {
    Diagnostics::new = diagnostics
    "tc_pipeline_literals" test_start
    diagnostics "42" tc_string = effect1
    "i64 count" 1 effect1 StackEffect::return_types.length assert_eq
    "i64 type" "i64" 0 effect1 StackEffect::return_types.get.format assert_str_eq
    diagnostics "true" tc_string = effect2
    "bool" "bool" 0 effect2 StackEffect::return_types.get.format assert_str_eq
    diagnostics "\"hello\"" tc_string = effect3
    "str" "str" 0 effect3 StackEffect::return_types.get.format assert_str_eq
    diagnostics "'a'" tc_string = effect4
    "char" "char" 0 effect4 StackEffect::return_types.get.format assert_str_eq
}

fn test_tc_pipeline_arithmetic {
    Diagnostics::new = diagnostics
    "tc_pipeline_arithmetic" test_start
    diagnostics "1 2 +" tc_string = sa
    "add" "i64" 0 sa StackEffect::return_types.get.format assert_str_eq
    diagnostics "1 2 -" tc_string = ss
    "sub" "i64" 0 ss StackEffect::return_types.get.format assert_str_eq
    diagnostics "1 2 *" tc_string = sm
    "mul" "i64" 0 sm StackEffect::return_types.get.format assert_str_eq
}

fn test_tc_pipeline_comparison {
    Diagnostics::new = diagnostics
    "tc_pipeline_comparison" test_start
    diagnostics "1 2 ==" tc_string = sc
    "eq" "bool" 0 sc StackEffect::return_types.get.format assert_str_eq
    diagnostics "1 2 <" tc_string = sl
    "lt" "bool" 0 sl StackEffect::return_types.get.format assert_str_eq
