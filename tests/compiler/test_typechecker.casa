# ============================================================================
# Tests: Error - function stack effect mismatch
# ============================================================================

pub fn test_error_fn_stack_effect_mismatch {
    error::Diagnostics::new = diagnostics
    "error_fn_stack_effect_mismatch" test::test_start
    # Build a function with declared stack effect "i64 -> str" but body returns i64
    "str" "i64" make_test_stack_effect = bad_stack_effect
    std::List[common::Op]::new = bad_ops
    common::empty_location 1 common::OpValue::PushBool common::Op::new bad_ops.push
    # RPN: stack effect, location, ops, name, Function::with_stack_effect
    bad_stack_effect common::empty_location bad_ops common::clone_ops "bad_fn".to_str common::Function::with_stack_effect = bad_fn
    diagnostics common::symbol_store_new bad_fn std::Option::Some bad_ops helpers::type_check_ops_for_test drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "stack effect mismatch" common::ErrorKind::SignatureMismatch helpers::assert_error_kind
}

