# ============================================================================
# Tests: Branch frame machinery (RFC #81)
# ============================================================================
# An `if true then fi` block with an empty body leaves the stack unchanged
# and pops the BranchIf frame cleanly.

pub fn test_branch_if_empty_body {
    "branch_if_empty_body" test::test_start
    std::List[common::Op]::new = ops
    common::empty_location common::OpValue::IfStart common::Op::new ops.push
    common::empty_location 1 common::OpValue::PushBool common::Op::new ops.push
    common::empty_location common::OpValue::IfCondition common::Op::new ops.push
    common::empty_location common::OpValue::IfEnd common::Op::new ops.push
    ops tc_check = result_tc
    "stack empty after empty if" 0 result_tc
        .stack
        .get_types
        .length test::assert_eq
    "frame stack empty" 0 result_tc.branch_count test::assert_eq
}
# `if cond then push_int else push_int fi` unifies to a single `i64` on the stack.

pub fn test_branch_if_else_agree_int {
    "branch_if_else_agree_int" test::test_start
    std::List[common::Op]::new = ops
    common::empty_location common::OpValue::IfStart common::Op::new ops.push
    common::empty_location 1 common::OpValue::PushBool common::Op::new ops.push
    common::empty_location common::OpValue::IfCondition common::Op::new ops.push
    common::empty_location 10 common::make_integer_op_value common::Op::new ops.push
    common::empty_location common::OpValue::IfElse common::Op::new ops.push
    common::empty_location 20 common::make_integer_op_value common::Op::new ops.push
    common::empty_location common::OpValue::IfEnd common::Op::new ops.push
    ops tc_check = result_tc
    "stack has one item" 1 result_tc
        .stack
        .get_types
        .length test::assert_eq
    "unified type is i64" "i64" 0 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
    "frame stack empty" 0 result_tc.branch_count test::assert_eq
}
# OpIfEnd must pop the BranchFrame from branched_stacks.

pub fn test_branch_if_end_pops_frame {
    "branch_if_end_pops_frame" test::test_start
    std::List[common::Op]::new = ops
    common::empty_location common::OpValue::IfStart common::Op::new ops.push
    common::empty_location 1 common::OpValue::PushBool common::Op::new ops.push
    common::empty_location common::OpValue::IfCondition common::Op::new ops.push
    ops tc_check = result_tc
    "frame pushed on OpIfStart" 1 result_tc.branch_count test::assert_eq
    common::empty_location common::OpValue::IfEnd common::Op::new ops.push
    ops tc_check = closed_tc
    "frame popped on OpIfEnd" 0 closed_tc.branch_count test::assert_eq
}
# A `while cond do done` with an empty body pushes and pops a BranchWhile frame.

pub fn test_branch_while_empty_body {
    "branch_while_empty_body" test::test_start
    std::List[common::Op]::new = ops
    common::empty_location common::OpValue::WhileStart common::Op::new ops.push
    common::empty_location 0 common::OpValue::PushBool common::Op::new ops.push
    common::empty_location common::OpValue::WhileCondition common::Op::new ops.push
    common::empty_location common::OpValue::WhileEnd common::Op::new ops.push
    ops tc_check = result_tc
    "stack empty" 0 result_tc
        .stack
        .get_types
        .length test::assert_eq
    "frame stack empty" 0 result_tc.branch_count test::assert_eq
}
# Direct exercise of the BranchFrame sum type: confirm that the top frame
# destructures to the right variant and that mutation through the binding
# persists on the frame stored in branched_stacks.

pub fn test_branch_frame_kind_dispatch {
    "branch_frame_kind_dispatch" test::test_start
    error::Diagnostics::new = diagnostics
    common::symbol_store_new = store
    diagnostics store typechecker::TypeChecker::new = tc
    std::List[common::Op]::new = ops
    common::empty_location common::OpValue::IfStart common::Op::new ops.push
    0 (u64) = bd_i
    while bd_i ops.length > do
        bd_i ops.get_mut tc.check_if_block
        1 += bd_i
    done
    "pushed BranchIf frame" 1 tc.branched_stacks.length test::assert_eq
    tc.branched_stacks.length 1 - tc.branched_stacks.get_mut = top_frame
    false = is_if
    false = is_while
    false = is_match
    if top_frame typechecker::BranchFrame::BranchIf(bd_if_ctx) is then
        true = is_if
        # Mutate through the destructure binding — mutation must persist.
        true bd_if_ctx typechecker::IfContext::set_default_present
    fi
    if top_frame typechecker::BranchFrame::BranchWhile(bd_while_ctx) is then
        true = is_while
    fi
    if top_frame typechecker::BranchFrame::BranchMatch(bd_match_ctx) is then
        true = is_match
    fi
    "top frame is BranchIf" is_if test::assert_true
    "top frame is not BranchWhile" is_while test::assert_false
    "top frame is not BranchMatch" is_match test::assert_false
    # Re-destructure to verify mutation persisted.
    tc.branched_stacks.length 1 - tc.branched_stacks.get = top_frame2
    false = default_present_after
    if top_frame2 typechecker::BranchFrame::BranchIf(bd_if_ctx2) is then
        bd_if_ctx2 typechecker::IfContext::default_present = default_present_after
    fi
    "mutation persists through binding" default_present_after test::assert_true
}

