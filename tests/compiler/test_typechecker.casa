# ============================================================================
# Tests: Word-bound syscalls and exact-width stores
# ============================================================================

fn tc_full code:$str diagnostics:mut$Diagnostics {
    diagnostics code parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops type_check_ops_for_test drop
    diagnostics store type_check_functions_for_test
}

fn test_error_syscall_non_word_bound_type_var {
    Diagnostics::new = diagnostics
    "error_syscall_non_word_bound_type_var" test_start
    diagnostics "trait Word { } trait NotWord { } fn fail_syscall[T: NotWord] arg:T -> i64 { arg 1 syscall1 } 42 fail_syscall drop" tc_full
    diagnostics "has errors" assert_has_errors
    diagnostics "mentions Word" "Word" assert_error_contains
}

fn test_syscall_word_bound_explicit_passes {
    Diagnostics::new = diagnostics
    "syscall_word_bound_explicit_passes" test_start
    diagnostics "trait Word { } impl i64: Word { } fn ok_syscall[T: Word] arg:T -> i64 { unsafe { arg 1 syscall1 } } 42 ok_syscall drop" tc_full
    diagnostics "no errors" assert_no_errors
}

fn test_syscall_unbound_type_var_passes {
    Diagnostics::new = diagnostics
    "syscall_unbound_type_var_passes" test_start
    diagnostics "trait Word { } fn deferred_syscall[T] arg:T -> i64 { unsafe { arg 1 syscall1 } } 42 deferred_syscall drop" tc_full
    diagnostics "no errors" assert_no_errors
}

fn test_store64_rejects_generic_word_without_conversion {
    Diagnostics::new = diagnostics
    "store64_rejects_generic_word_without_conversion" test_start
    diagnostics "trait Word { } impl i64: Word { } fn store[T: Word] destination:ptr value:T -> None { unsafe { value destination store64 } } unsafe { 42 8 alloc store }" tc_full
    diagnostics "has errors" assert_has_errors
    diagnostics "requires u64" "Expected `u64`, got `T`" assert_error_contains
}

fn test_store64_explicit_conversion_passes {
    Diagnostics::new = diagnostics
    "store64_explicit_conversion_passes" test_start
    diagnostics "trait Word { } impl i64: Word { } fn store[T: Word] destination:ptr value:T -> None { unsafe { value (u64) destination store64 } } unsafe { 42 8 alloc store }" tc_full
    diagnostics "no errors" assert_no_errors
}

# ============================================================================
# Tests: Syscall op-level stack effects
# ============================================================================

fn test_syscall_op_level {
    "syscall_op_level" test_start

    # syscall0: pops 1 (syscall number), pushes i64
    List[Op]::new = ops0
    empty_location 60 make_integer_op_value Op::new ops0.push
    empty_location OpValue::Syscall0 Op::new ops0.push
    ops0 tc_check = tc0
    "syscall0 result" 1 tc0
        .stack
        .get_types
        .length assert_eq
    "syscall0 type" "i64" 0 tc0
        .stack
        .get_types
        .get
        .format assert_str_eq

    # syscall1: pops 2 (1 arg + syscall number), pushes i64
    List[Op]::new = ops1
    empty_location 0 make_integer_op_value Op::new ops1.push
    empty_location 60 make_integer_op_value Op::new ops1.push
    empty_location OpValue::Syscall1 Op::new ops1.push
    ops1 tc_check = tc1
    "syscall1 result" 1 tc1
        .stack
        .get_types
        .length assert_eq
    "syscall1 type" "i64" 0 tc1
        .stack
        .get_types
        .get
        .format assert_str_eq

    # syscall3: pops 4 (3 args + syscall number), pushes i64
    List[Op]::new = ops3
    empty_location 0 make_integer_op_value Op::new ops3.push
    empty_location 0 make_integer_op_value Op::new ops3.push
    empty_location 0 make_integer_op_value Op::new ops3.push
    empty_location 1 make_integer_op_value Op::new ops3.push
    empty_location OpValue::Syscall3 Op::new ops3.push
    ops3 tc_check = tc3
    "syscall3 result" 1 tc3
        .stack
        .get_types
        .length assert_eq
    "syscall3 type" "i64" 0 tc3
        .stack
        .get_types
        .get
        .format assert_str_eq
}

