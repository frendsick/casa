import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/typechecker.casa" as typechecker
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

pub fn typecheck_source
    code:$str
    diagnostics:mut$error::Diagnostics
-> typechecker::TypecheckResult {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    store ops typechecker::type_check
}

pub fn test_fstring_capture_uses_inferred_parameter_type {
    error::Diagnostics::new = diagnostics
    "fstring_capture_uses_inferred_parameter_type" test::test_start
    diagnostics "struct __casa_std__String { data: str } fn render count:i64 -> __casa_std__String { f\"{count}\" } 0 render drop" typecheck_source = result
    false = found_conversion
    for
        function_name in result
            .store
            .get_function_names
            .iter
    do
        function_name.as_str result
            .store
            .get_function
            .unwrap = function
        for op in function.ops.iter do
            if op.value common::OpValue::PrimitiveToStr is then
                true = found_conversion
            fi
        done
    done
    "captured i64 is converted to str" found_conversion test::assert_true
    result.diagnostics.clone diagnostics.merge
    diagnostics "captured parameter keeps inferred type" helpers::assert_no_errors
}

pub fn test_typecheck_result_exposes_phase_outputs {
    error::Diagnostics::new = diagnostics
    "typecheck_result_exposes_phase_outputs" test::test_start
    diagnostics "42 = answer answer print" typecheck_source = result
    "no diagnostics" 0 result
        .diagnostics
        .entries
        .length test::assert_eq
    "global stack is empty" 0 result
        .global_stack_effect
        .return_types
        .length test::assert_eq
    "ops returned" 4 result.ops.length test::assert_eq
    "print resolved" 3 result
        .ops
        .get
        .value common::OpValue::PrintInt is test::assert_true
    "updated store returned" "i64" "answer" result
        .store
        .variables
        .get_str
        .unwrap
        .typ
        .format test::assert_str_eq
}

pub fn test_non_returning_paths_propagate_through_direct_calls {
    "non_returning_paths_propagate_through_direct_calls" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "enum Maybe { Some(i64) None } fn fatal message:$str { message panic } fn stop { \"stopped\" fatal } fn never value:i64 -> i64 { value drop stop } fn choose flag:bool -> i64 { if flag then stop else 42 fi } fn inferred { if true then stop else 42 fi } fn unwrap value:Maybe -> i64 { value match Maybe::Some(inner) => inner Maybe::None => \"missing\" panic end } fn call_indirect callback:fn[i64 -> i64] -> i64 { 1 callback exec } true choose drop inferred drop 1 Maybe::Some unwrap drop &never call_indirect drop"
    typecheck_source = result
    result.diagnostics.clone diagnostics.merge
    diagnostics "terminating branch is excluded from the join" helpers::assert_no_errors
    "fatal is non-returning" "fatal" result
        .store
        .get_function
        .unwrap
        .is_non_returning test::assert_true
    "direct wrapper is non-returning" "stop" result
        .store
        .get_function
        .unwrap
        .is_non_returning test::assert_true
    "function with a continuing branch returns" "choose" result
        .store
        .get_function
        .unwrap
        .is_non_returning ! test::assert_true
    "inferred join keeps the continuing result" "i64" 0 "inferred" result
        .store
        .get_function
        .unwrap
        .stack_effect
        .return_types
        .get
        .format test::assert_str_eq
    "match excludes its terminating arm" "i64" 0 "unwrap" result
        .store
        .get_function
        .unwrap
        .stack_effect
        .return_types
        .get
        .format test::assert_str_eq
    "indirect calls are assumed to return" "call_indirect" result
        .store
        .get_function
        .unwrap
        .is_non_returning ! test::assert_true
}

pub fn test_non_returning_function_satisfies_declared_output {
    "non_returning_function_satisfies_declared_output" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "fn impossible -> i64 { \"stopped\" panic } impossible" typecheck_source = result
    result.diagnostics.clone diagnostics.merge
    diagnostics "non-returning function needs no invented output" helpers::assert_no_errors
    "function is non-returning" "impossible" result
        .store
        .get_function
        .unwrap
        .is_non_returning test::assert_true
}

pub fn test_non_returning_structural_inputs {
    "non_returning_structural_inputs" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "fn if_condition { if \"if condition\" panic then 1 drop fi } fn while_condition { while \"while condition\" panic do done } fn match_subject { \"match subject\" panic match _ => { } end } fn match_guard -> i64 { true match true if \"match guard\" panic => 1 _ => 2 end }"
    typecheck_source = result
    result.diagnostics.clone diagnostics.merge
    diagnostics "structural inputs can terminate" helpers::assert_no_errors
    "if condition terminates" "if_condition" result
        .store
        .get_function
        .unwrap
        .is_non_returning test::assert_true
    "while condition terminates" "while_condition" result
        .store
        .get_function
        .unwrap
        .is_non_returning test::assert_true
    "match subject terminates" "match_subject" result
        .store
        .get_function
        .unwrap
        .is_non_returning test::assert_true
    "match guard needs no boolean result" "match_guard" result
        .store
        .get_function
        .unwrap
        .is_non_returning ! test::assert_true
}

pub fn test_monomorphization_restores_recursive_body {
    "monomorphization_restores_recursive_body" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "fn recurse -> i64 { recurse } recurse drop" typecheck_source = result
    result.diagnostics.clone diagnostics.merge
    diagnostics "recursive function typechecks" helpers::assert_no_errors
    "recurse" result
        .store
        .get_function
        .unwrap = recurse
    "recursive body restored" 1 recurse.ops.length test::assert_eq
    "recursive call preserved" 0 recurse
        .ops
        .get
        .value common::OpValue::FnCall is test::assert_true
}

pub fn test_typecheck_collects_independent_errors {
    error::Diagnostics::new = diagnostics
    "typecheck_collects_independent_errors" test::test_start
    diagnostics "\"first\" 1 * true 2 *" typecheck_source = result
    "two independent errors" 2 result.diagnostics.error_count test::assert_eq
    "bytecode blocked" result.diagnostics.has_errors test::assert_true
}

pub fn test_typecheck_missing_sentinel_suppresses_cascade {
    error::Diagnostics::new = diagnostics
    "typecheck_missing_sentinel_suppresses_cascade" test::test_start
    diagnostics "fn broken -> i64 { 1 * }" typecheck_source = result
    "one underflow error" 1 result.diagnostics.error_count test::assert_eq
}

pub fn test_typecheck_unknown_sentinel_suppresses_display_cascade {
    "typecheck_unknown_sentinel_suppresses_display_cascade" test::test_start
    common::symbol_store_new = store
    std::List[common::Op]::new = ops
    common::empty_location "missing".to_str common::OpValue::PushVar common::Op::new ops.push
    common::empty_location common::OpValue::Print common::Op::new ops.push
    store ops typechecker::type_check = result
    "undefined variable is the only error" 1 result.diagnostics.error_count test::assert_eq
    "unknown value adds no display error" "Display" result.diagnostics helpers::diagnostics_error_contains ! test::assert_true
}

pub fn test_typechecker_preserves_warning_error_order {
    "typechecker_preserves_warning_error_order" test::test_start
    error::Diagnostics::new = diagnostics
    common::empty_location "completed warning".to_str common::WarningKind::UnusedParameter error::CasaWarning diagnostics.push_warning
    common::symbol_store_new = store
    std::List[common::Op]::new = ops
    common::empty_location "bad".to_str common::OpValue::PushStr common::Op::new ops.push
    common::empty_location 1 common::make_integer_op_value common::Op::new ops.push
    common::empty_location common::OpValue::Mul common::Op::new ops.push
    false diagnostics store std::Option[common::Function]::None ops typechecker::check_ops drop
    "warning and error retained" 2 diagnostics.entries.length test::assert_eq
    "warning remains first" 0 diagnostics.entries.get error::Diagnostic::Warning is test::assert_true
    "error remains second" 1 diagnostics.entries.get error::Diagnostic::Error is test::assert_true
}
test_fstring_capture_uses_inferred_parameter_type
test_typecheck_result_exposes_phase_outputs
test_non_returning_paths_propagate_through_direct_calls
test_non_returning_function_satisfies_declared_output
test_non_returning_structural_inputs
test_monomorphization_restores_recursive_body
test_typecheck_collects_independent_errors
test_typecheck_missing_sentinel_suppresses_cascade
test_typecheck_unknown_sentinel_suppresses_display_cascade
test_typechecker_preserves_warning_error_order
test::test_summary
