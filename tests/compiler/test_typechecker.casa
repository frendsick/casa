# ============================================================================
# Tests: All comparison operators produce bool
# ============================================================================

fn test_all_comparison_ops {
    "all_comparison_ops" test_start

    # Eq
    List[Op]::new = ops_eq
    empty_location 1 make_integer_op_value Op::new ops_eq.push
    empty_location 1 make_integer_op_value Op::new ops_eq.push
    empty_location OpValue::Eq Op::new ops_eq.push
    ops_eq tc_check = tc_eq
    "eq is bool" "bool" 0 tc_eq
        .stack
        .get_types
        .get
        .format assert_str_eq

    # Ne
    List[Op]::new = ops_ne
    empty_location 1 make_integer_op_value Op::new ops_ne.push
    empty_location 2 make_integer_op_value Op::new ops_ne.push
    empty_location OpValue::Ne Op::new ops_ne.push
    ops_ne tc_check = tc_ne
    "ne is bool" "bool" 0 tc_ne
        .stack
        .get_types
        .get
        .format assert_str_eq

    # Le
    List[Op]::new = ops_le
    empty_location 1 make_integer_op_value Op::new ops_le.push
    empty_location 2 make_integer_op_value Op::new ops_le.push
    empty_location OpValue::Le Op::new ops_le.push
    ops_le tc_check = tc_le
    "le is bool" "bool" 0 tc_le
        .stack
        .get_types
        .get
        .format assert_str_eq

    # Ge
    List[Op]::new = ops_ge
    empty_location 1 make_integer_op_value Op::new ops_ge.push
    empty_location 2 make_integer_op_value Op::new ops_ge.push
    empty_location OpValue::Ge Op::new ops_ge.push
    ops_ge tc_check = tc_ge
    "ge is bool" "bool" 0 tc_ge
        .stack
        .get_types
        .get
        .format assert_str_eq

    # Gt
    List[Op]::new = ops_gt
    empty_location 5 make_integer_op_value Op::new ops_gt.push
    empty_location 2 make_integer_op_value Op::new ops_gt.push
    empty_location OpValue::Gt Op::new ops_gt.push
    ops_gt tc_check = tc_gt
    "gt is bool" "bool" 0 tc_gt
        .stack
        .get_types
        .get
        .format assert_str_eq
}

