# ============================================================================
# Tests: ROT stack effect
# ============================================================================

pub fn test_rot_stack_effect {
    "rot_stack_effect" test::test_start
    std::List[common::Op]::new = ops
    common::empty_location 42 common::make_integer_op_value common::Op::new ops.push
    common::empty_location "hello".to_str common::OpValue::PushStr common::Op::new ops.push
    common::empty_location 1 common::OpValue::PushBool common::Op::new ops.push
    common::empty_location common::OpValue::Rot common::Op::new ops.push
    ops tc_check = result_tc
    "stack after rot" 3 result_tc
        .stack
        .get_types
        .length test::assert_eq
    # ROT: pop t1(bool), t2(str), t3(i64) -> push t2(str), t1(bool), t3(i64)
    "bottom is str" "str" 0 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
    "middle is bool" "bool" 1 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
    "top is i64" "i64" 2 result_tc
        .stack
        .get_types
        .get
        .format test::assert_str_eq
}

