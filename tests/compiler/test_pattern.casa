# ============================================================================
# Helpers for building match-arm ops for tests
# ============================================================================

pub fn make_enum_arm enum_name:str variant_name:str -> common::Op {
    std::Option::None variant_name.to_str enum_name.to_str common::EnumVariant::new = variant
    std::List[common::Op]::new variant common::PatternValue::EnumVariant common::MatchArm::new = arm
    common::empty_location arm common::OpValue::MatchArm common::Op::new
}

pub fn make_struct_arm struct_name:str -> common::Op {
    std::Map[std::String std::String]::new = bindings
    bindings struct_name.to_str common::StructPattern = struct_pat
    std::List[common::Op]::new struct_pat common::PatternValue::Struct common::MatchArm::new = arm
    common::empty_location arm common::OpValue::MatchArm common::Op::new
}

pub fn make_literal_arm raw:str -> common::Op {
    raw.to_str 0 common::IntegerLiteral::from_int common::LiteralValue::Int common::LiteralPattern = literal_pat
    std::List[common::Op]::new literal_pat common::PatternValue::Literal common::MatchArm::new = arm
    common::empty_location arm common::OpValue::MatchArm common::Op::new
}

# ============================================================================
# pattern_is_wildcard primitive
# ============================================================================

pub fn test_pattern_is_wildcard_underscore_variant {
    "pattern_is_wildcard_underscore" test::test_start
    "_" "" make_enum_arm = op
    "wildcard" op pattern::pattern_is_wildcard test::assert_true
}

pub fn test_pattern_is_wildcard_named_variant {
    "pattern_is_wildcard_named" test::test_start
    "Up" "Dir" make_enum_arm = op
    "not wildcard" op pattern::pattern_is_wildcard test::assert_false
}

pub fn test_pattern_is_wildcard_literal {
    "pattern_is_wildcard_literal" test::test_start
    "42" make_literal_arm = op
    "literal not wildcard" op pattern::pattern_is_wildcard test::assert_false
}

pub fn test_pattern_is_wildcard_struct {
    "pattern_is_wildcard_struct" test::test_start
    "Point" make_struct_arm = op
    "struct not wildcard" op pattern::pattern_is_wildcard test::assert_false
}

