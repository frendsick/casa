pub fn test_pattern_covered_key_wildcard_matches_underscore {
    "pattern_covered_key_wildcard" test::test_start
    "_" "" make_enum_arm = op
    "covered" "__covered:_" op pattern::pattern_covered_key test::assert_str_eq
}

# ============================================================================
# pattern_bindings primitive
# ============================================================================

pub fn test_pattern_bindings_enum_empty {
    "pattern_bindings_enum_empty" test::test_start
    "Up" "Dir" make_enum_arm = op
    "count" 0 op pattern::pattern_bindings.length test::assert_eq
}

pub fn test_pattern_bindings_enum_with_payload {
    "pattern_bindings_enum_with_payload" test::test_start
    std::Option::None "Some".to_str "Option".to_str common::EnumVariant::new = variant
    std::List[std::String]::new = binds
    "x".to_str binds.push
    binds variant common::EnumVariant::set_bindings
    std::List[common::Op]::new variant common::PatternValue::EnumVariant common::MatchArm::new = arm
    common::empty_location arm common::OpValue::MatchArm common::Op::new = op
    op pattern::pattern_bindings = out
    "count" 1 out.length test::assert_eq
    "name" "x" 0 out.get test::assert_str_eq
}

pub fn test_pattern_bindings_struct_fields {
    "pattern_bindings_struct_fields" test::test_start
    std::Map[std::String std::String]::new = bindings
    "y".to_str "row".to_str bindings.set
    "x".to_str "col".to_str bindings.set
    bindings "Point".to_str common::StructPattern = struct_pat
    std::List[common::Op]::new struct_pat common::PatternValue::Struct common::MatchArm::new = arm
    common::empty_location arm common::OpValue::MatchArm common::Op::new = op
    op pattern::pattern_bindings = out
    "count" 2 out.length test::assert_eq
}

pub fn test_pattern_bindings_literal_empty {
    "pattern_bindings_literal_empty" test::test_start
    "42" make_literal_arm = op
    "count" 0 op pattern::pattern_bindings.length test::assert_eq
}

# ============================================================================
# Integration: exercise full parse -> resolve -> typecheck through the
# pattern module's entry points.
# ============================================================================

pub fn test_mixed_match_parses_and_typechecks {
    error::Diagnostics::new = diagnostics
    "mixed_match_parses_and_typechecks" test::test_start
    diagnostics "1 match 1 => \"one\" 2 => \"two\" _ => \"other\" end" helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option::None ops helpers::type_check_ops_for_test drop
    diagnostics "mixed-kind match typechecks" helpers::assert_no_errors
}

pub fn test_duplicate_literal_arm_detected {
    error::Diagnostics::new = diagnostics
    "duplicate_literal_arm_detected" test::test_start
    diagnostics "1 match 1 => \"a\" 1 => \"b\" _ => \"c\" end" helpers::parse_resolve_test_parts = dup_store = dup_ops
    diagnostics dup_store std::Option::None dup_ops helpers::type_check_ops_for_test drop
    diagnostics "duplicate arm flagged" "Duplicate match arm" helpers::assert_error_contains
}

# ============================================================================
# Guard clauses (match arms with an `if` condition).
# ============================================================================

pub fn test_guard_parser_collects_ops {
    error::Diagnostics::new = diagnostics
    "guard_parser_collects_ops" test::test_start
    diagnostics "0 match _ if 0 1 == => \"y\" _ => \"n\" end" helpers::parse_resolve_test_parts = store = ops
    store drop
    0 (u64) = arm_index
    0 = guarded_count
    0 = unguarded_count
    while arm_index ops.length > do
        arm_index ops.get = arm_op
        if arm_op.value common::OpValue::MatchArm is then
            if arm_op pattern::pattern_is_guarded then
                1 += guarded_count
            else
                1 += unguarded_count
            fi
        fi
        1 += arm_index
    done
    "one guarded" 1 guarded_count test::assert_eq
    "one unguarded" 1 unguarded_count test::assert_eq
}

pub fn test_guard_excluded_from_covered_key {
    "guard_excluded_from_covered_key" test::test_start
    "42" make_literal_arm = unguarded
    "covered when unguarded" "__covered:42" unguarded pattern::pattern_covered_key test::assert_str_eq
    "42".to_str 0 common::IntegerLiteral::from_int common::LiteralValue::Int common::LiteralPattern = literal_pat
    std::List[common::Op]::new = guard_ops
    common::empty_location 1 common::OpValue::PushBool common::Op::new guard_ops.push
    guard_ops literal_pat common::PatternValue::Literal common::MatchArm::new = arm
    common::empty_location arm common::OpValue::MatchArm common::Op::new = guarded
    "is guarded" guarded pattern::pattern_is_guarded test::assert_true
    "empty key when guarded" "" guarded pattern::pattern_covered_key test::assert_str_eq
}

pub fn test_guard_allows_shadow_literal_arm {
    error::Diagnostics::new = diagnostics
    "guard_allows_shadow_literal_arm" test::test_start
    diagnostics "1 match 1 if 0 1 == => \"a\" 1 => \"b\" _ => \"c\" end" helpers::parse_resolve_test_parts = sg_store = sg_ops
    diagnostics sg_store std::Option::None sg_ops helpers::type_check_ops_for_test drop
    diagnostics "guarded arm does not collide" helpers::assert_no_errors
}

pub fn test_guard_non_bool_rejected {
    error::Diagnostics::new = diagnostics
    "guard_non_bool_rejected" test::test_start
    diagnostics "1 match 1 if 42 => \"a\" _ => \"b\" end" helpers::parse_resolve_test_parts = nb_store = nb_ops
    diagnostics nb_store std::Option::None nb_ops helpers::type_check_ops_for_test drop
    diagnostics "non-bool guard flagged" "Guard expression must leave a single `bool`" helpers::assert_error_contains
}

pub fn test_guard_non_exhaustive_without_fallback {
    error::Diagnostics::new = diagnostics
    "guard_non_exhaustive_without_fallback" test::test_start
    diagnostics "1 match 1 if 0 1 == => \"a\" end" helpers::parse_resolve_test_parts = ne_store = ne_ops
    diagnostics ne_store std::Option::None ne_ops helpers::type_check_ops_for_test drop
    diagnostics "guard alone non-exhaustive" "Non-exhaustive match" helpers::assert_error_contains
}
