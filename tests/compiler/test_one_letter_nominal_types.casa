import "../../lib/std.casa"
import "../../lib/test.casa"

enum E {
    Number(i64)
    Empty
}

struct S {
    value: i64
}

fn enum_value value:E -> i64 {
    value match
        E::Number(number) => { number }
        E::Empty => { 0 }
    end
}

fn struct_value value:S -> i64 { value.value }

fn identity[T] value:T -> T { value }

"one-letter enum is nominal" 42 42 E::Number enum_value assert_eq
"one-letter struct is nominal" 7 7 S struct_value assert_eq
"declared type parameter stays generic" 9 9 identity assert_eq
test_summary
