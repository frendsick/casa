import "../../lib/std.casa" as std
import "../../lib/test.casa" as test

pub enum E {
    Number (i64)
    Empty
}

pub struct S {
    pub value: i64
}

pub fn enum_value value:E -> i64 {
    value match
        E::Number(number) => {
            number
        }
        E::Empty => {
            0
        }
    end
}

pub fn struct_value value:S -> i64 { value.value }

pub fn identity [T] value:T -> T { value }

"one-letter enum is nominal" 42 42 E::Number enum_value test::assert_eq
"one-letter struct is nominal" 7 7 S struct_value test::assert_eq
"declared type parameter stays generic" 9 9 identity test::assert_eq
test::test_summary
