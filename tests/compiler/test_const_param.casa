import "std" as std
import "../../compiler/bytecode.casa" as bytecode
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

# Typecheck a whole source: top-level ops first, then every function body.

pub fn tc_const code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test drop
    diagnostics store helpers::type_check_functions_for_test
}
# A const parameter is parsed, recorded on the stack effect, and left in the
# signature as a symbolic constant rather than a type variable (ADR-0152).

pub fn test_const_param_signature {
    error::Diagnostics::new = diagnostics
    "const_param_signature" test::test_start
    diagnostics "fn length [T const N:u64] self:$array[T N] -> u64 { N }" helpers::parse_resolve_test_parts = store = ops
    ops drop
    "length registered" "length" store
        .functions
        .get_str
        .is_some test::assert_true
    "length" store
        .functions
        .get_str
        .unwrap = length_fn
    length_fn.stack_effect = effect: $common::StackEffect
    "N recorded as const param" "N" effect.const_params.has_str test::assert_true
    "N is a u64 constant" "u64" "N" effect
        .const_params
        .get_str
        .unwrap
        .format test::assert_str_eq
    "N is not a type variable" "N" effect.type_vars.has_str ! test::assert_true
    "self keeps symbolic N" "$array[T N]" effect typechecker::method_receiver_type.unwrap.format test::assert_str_eq
    "only the source parameter remains" 1 effect.parameters.length test::assert_eq
    "source parameter stays first" "self" 0 effect
        .parameters
        .get
        .name test::assert_str_eq
}
# The parameter is usable as a u64 value in its body, and concrete constant
# arguments (including 0) bind it without error.

pub fn test_const_param_body_and_binding {
    error::Diagnostics::new = diagnostics
    "const_param_body_and_binding" test::test_start
    diagnostics "fn length [T const N:u64] self:$array[T N] -> u64 { N }\nfn empty self:$array[i64 0] -> u64 { self length }\nfn three self:$array[i64 3] -> u64 { self length }" tc_const
    diagnostics "no errors" helpers::assert_no_errors
}
# A type in constant position is rejected with a diagnostic that names it.

pub fn test_const_param_rejects_non_constant {
    error::Diagnostics::new = diagnostics
    "const_param_rejects_non_constant" test::test_start
    diagnostics "fn length [T const N:u64] self:$array[T N] -> u64 { N }\nfn probe self:$array[i64 count] -> u64 { self length }" tc_const
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "names the argument" "count" helpers::assert_error_contains
}
# An integer constant argument is contextual: it fits any integer width whose
# range contains it, and a value that overflows is rejected with a diagnostic
# that names the argument and the width (ADR-0153).

pub fn test_const_param_integer_widths {
    error::Diagnostics::new = diagnostics
    "const_param_integer_widths" test::test_start
    diagnostics "fn take_u8 [T const N:u8] self:$array[T N] -> u8 { N }\nfn fits self:$array[i64 3] -> u8 { self take_u8 }" tc_const
    diagnostics "u8 argument that fits" helpers::assert_no_errors

    error::Diagnostics::new = overflow
    overflow "fn take_u8 [T const N:u8] self:$array[T N] -> u8 { N }\nfn probe self:$array[i64 300] -> u8 { self take_u8 }" tc_const
    overflow "u8 argument out of range" helpers::assert_has_errors
    overflow "names the argument" "300" helpers::assert_error_contains
    overflow "names the width" "u8" helpers::assert_error_contains
}
# `bool` and `char` are usable constant parameter types, and distinct values are
# distinct instantiations that do not unify (ADR-0153).

pub fn test_const_param_bool_and_char {
    error::Diagnostics::new = diagnostics
    "const_param_bool_and_char" test::test_start
    diagnostics "fn take_bool [T const B:bool] self:$array[T B] -> bool { B }\nfn as_true self:$array[i64 true] -> bool { self take_bool }\nfn take_char [T const C:char] self:$array[T C] -> char { C }\nfn as_a self:$array[i64 'a'] -> char { self take_char }" tc_const
    diagnostics "bool and char arguments" helpers::assert_no_errors

    error::Diagnostics::new = mismatch
    mismatch "fn take_bool [T const B:bool] self:$array[T B] -> bool { B }\nfn wants_true self:$array[i64 true] -> bool { self take_bool }\nfn probe self:$array[i64 false] -> bool { self wants_true }" tc_const
    mismatch "distinct bool instantiations do not unify" helpers::assert_has_errors
}
# Float and `str` constant parameters are rejected at the declaration with a
# diagnostic that names the type (ADR-0153).

pub fn test_const_param_rejects_float_and_str {
    error::Diagnostics::new = diagnostics
    "const_param_rejects_float_and_str" test::test_start
    diagnostics "fn f [const X:f64] self:$array[i64 X] -> u64 { 0 }" helpers::parse_resolve_test_source drop
    diagnostics "float const parameter" helpers::assert_has_errors
    diagnostics "names the type" "f64" helpers::assert_error_contains

    error::Diagnostics::new = str_diags
    str_diags "fn g [const S:str] self:$array[i64 S] -> u64 { 0 }" helpers::parse_resolve_test_source drop
    str_diags "str const parameter" helpers::assert_has_errors
    str_diags "names the type" "str" helpers::assert_error_contains
}

pub fn test_const_only_return_resolves_at_call_site {
    error::Diagnostics::new = diagnostics
    "const_only_return_resolves_at_call_site" test::test_start
    diagnostics
    "fn identity [const N:u64] values:array[i64 N] -> array[i64 N] { values }\nfn length [const N:u64] values:$array[i64 N] -> u64 { N }\n[1, 2, 3] identity length drop"
    helpers::parse_resolve_test_parts = store = operations
    store operations typechecker::type_check = checked
    checked.diagnostics.clone diagnostics.merge
    "const-only return compiles with concrete N"
    checked bytecode::compile_typechecked.is_ok test::assert_true
}

pub fn test_const_length_rejects_fixed_literal {
    error::Diagnostics::new = diagnostics
    "const_length_rejects_fixed_literal" test::test_start
    diagnostics
    "fn wrong [const N:u64] values:$array[i64 N] -> array[i64 N] { values drop [1, 2] }"
    tc_const
    diagnostics "fixed literal cannot satisfy arbitrary N" helpers::assert_has_errors
}
test_const_param_signature
test_const_param_body_and_binding
test_const_param_rejects_non_constant
test_const_param_integer_widths
test_const_param_bool_and_char
test_const_param_rejects_float_and_str
test_const_only_return_resolves_at_call_site
test_const_length_rejects_fixed_literal
test::test_summary
