import "../../compiler/typechecker.casa"
import "helpers.casa"

# Typecheck a whole source: top-level ops first, then every function body.

fn tc_const code:$str diagnostics:mut$Diagnostics {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option[Function]::None ops type_check_ops_for_test drop
    diagnostics store type_check_functions_for_test
}
# A const parameter is parsed, recorded on the stack effect, and left in the
# signature as a symbolic constant rather than a type variable (ADR-0152).

fn test_const_param_signature {
    Diagnostics::new = diagnostics
    "const_param_signature" test_start
    diagnostics "fn length [T const N:u64] self:$array[T N] -> u64 { N }" parse_resolve_test_source = result
    result ParseResolveResult::store = store
    "length registered" "length" store.functions.get.is_some assert_true
    "length" store.functions.get.unwrap = length_fn
    length_fn Function::stack_effect = effect
    "N recorded as const param" "N" effect StackEffect::const_params.has assert_true
    "N is a u64 constant" "u64" "N" effect StackEffect::const_params.get.unwrap.format assert_str_eq
    "N is not a type variable" "N" effect StackEffect::type_vars.has ! assert_true
    "self keeps symbolic N" "$array[T N]" 0 effect StackEffect::parameters.get Parameter::typ.format assert_str_eq
}
# The parameter is usable as a u64 value in its body, and concrete constant
# arguments (including 0) bind it without error.

fn test_const_param_body_and_binding {
    Diagnostics::new = diagnostics
    "const_param_body_and_binding" test_start
    diagnostics "fn length [T const N:u64] self:$array[T N] -> u64 { N }\nfn empty self:$array[i64 0] -> u64 { self length }\nfn three self:$array[i64 3] -> u64 { self length }" tc_const
    diagnostics "no errors" assert_no_errors
}
# A type in constant position is rejected with a diagnostic that names it.

fn test_const_param_rejects_non_constant {
    Diagnostics::new = diagnostics
    "const_param_rejects_non_constant" test_start
    diagnostics "fn length [T const N:u64] self:$array[T N] -> u64 { N }\nfn probe self:$array[i64 count] -> u64 { self length }" tc_const
    diagnostics "has errors" assert_has_errors
    diagnostics "names the argument" "count" assert_error_contains
}
test_const_param_signature
test_const_param_body_and_binding
test_const_param_rejects_non_constant
test_summary
