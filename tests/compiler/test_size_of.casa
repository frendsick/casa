import "std"

0 = passed
0 = failed

fn assert_size actual:u64 expected:u64 name:$str {
    if expected actual == then
        1 += passed
    else
        f"[FAIL] {name}: expected {expected}, got {actual}\n" eprint
        1 += failed
    fi
}

struct Marker {
}

struct Padded {
    small: u8
    large: u64
}

struct ArrayField {
    tag:    u8
    values: array[u16 3]
}

"i8" 1 size_of [i8] assert_size
"u16" 2 size_of [u16] assert_size
"char" 4 size_of [char] assert_size
"pointer" 8 size_of [ptr] assert_size
"array elements" 3 size_of [array[u8 3]] assert_size
"array stride" 24 size_of [array[i64 3]] assert_size
"zero-length array" 1 size_of [array[i64 0]] assert_size
"empty struct" 1 size_of [Marker] assert_size
"struct padding" 16 size_of [Padded] assert_size
"inline array field" 8 size_of [ArrayField] assert_size
f"{passed} passed, {failed} failed\n" print
if 0 failed > then 1 exit fi
