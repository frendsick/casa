import "std"

0 = test_pass_count
0 = test_fail_count

fn assert_size actual:u64 expected:u64 name:$str {
    if expected actual == then
        1 += test_pass_count
    else
        f"[FAIL] {name}: expected {expected}, got {actual}\n".as_str eprint
        1 += test_fail_count
    fi
}

struct Marker {
}

struct Padded {
    small: u8
    large: u64
}

enum Choice {
    Empty
    Values (u8 u64)
}

fn generic_size [T] value:$T -> u64 {
    value drop
    size_of[T]
}
"u8" 1 size_of[u8] assert_size
"u16" 2 size_of[u16] assert_size
"u32" 4 size_of[u32] assert_size
"u64" 8 size_of[u64] assert_size
"char" 4 size_of[char] assert_size
"empty struct" 1 size_of[Marker] assert_size
"struct padding" 16 size_of[Padded] assert_size
"enum payload padding" 24 size_of[Choice] assert_size
"compact array" 3 size_of[array[u8 3]] assert_size
"empty array" 1 size_of[array[u8 0]] assert_size
"empty array stride" 2 size_of[array[array[u8 0] 2]] assert_size
"aggregate array" 32 size_of[array[Padded 2]] assert_size
"list representation" 24 size_of[List[i64]] assert_size
2 (u64) 1 (u8) Padded = padded
"generic type" 16 padded generic_size assert_size
padded drop
f"{test_pass_count} passed, {test_fail_count} failed\n" print
if 0 test_fail_count > then
    1 exit
fi
