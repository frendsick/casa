import "std" as std
import "../../lib/test.casa" as test

pub struct Marker {
}

pub struct Padded {
    pub small: u8
    pub large: u64
}

pub struct ArrayField {
    pub prefix: u8
    pub values: array[u8 3]
    pub suffix: u8
}

pub enum Choice {
    Empty
    Values (u8 u64)
}

pub fn generic_size [T] value:$T -> u64 {
    value drop
    size_of[T]
}
"u8" 1 size_of[u8] test::assert_eq
"u16" 2 size_of[u16] test::assert_eq
"u32" 4 size_of[u32] test::assert_eq
"u64" 8 size_of[u64] test::assert_eq
"char" 4 size_of[char] test::assert_eq
"empty struct" 1 size_of[Marker] test::assert_eq
"struct padding" 16 size_of[Padded] test::assert_eq
"fixed array field layout" 5 size_of[ArrayField] test::assert_eq
"enum payload padding" 24 size_of[Choice] test::assert_eq
"compact array" 3 size_of[array[u8 3]] test::assert_eq
"empty array" 1 size_of[array[u8 0]] test::assert_eq
"empty array stride" 2 size_of[array[array[u8 0] 2]] test::assert_eq
"aggregate array" 32 size_of[array[Padded 2]] test::assert_eq
"list representation" 24 size_of[std::List[i64]] test::assert_eq
2 1 Padded = padded
"generic type" 16 padded generic_size test::assert_eq
padded drop
test::test_summary
