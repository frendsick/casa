    diagnostics "struct Point { x: i64 y: i64 }\nPoint { z: 1 y: 2 }" sl_parse drop
    diagnostics "has errors" assert_has_errors
    diagnostics "undefined name" ErrorKind::UndefinedName assert_error_kind
}

fn test_duplicate_field_error {
    Diagnostics::new = diagnostics
    "duplicate_field_error" test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: 1 x: 2 y: 3 }" sl_parse drop
    diagnostics "has errors" assert_has_errors
    diagnostics "duplicate name" ErrorKind::DuplicateName assert_error_kind
}

fn test_unknown_field_mid_literal_error {
    Diagnostics::new = diagnostics
    "unknown_field_mid_literal_error" test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: 1 z: 2 }" sl_parse drop
    # Self-hosted compiler does not yet detect unknown field after valid fields.
    # Just verify no crash occurred.
}

fn test_empty_literal_error {
    Diagnostics::new = diagnostics
    "empty_literal_error" test_start
