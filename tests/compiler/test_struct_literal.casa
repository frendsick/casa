import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "../../compiler/bytecode.casa" as bytecode
import "helpers.casa" as helpers

# ============================================================================
# Constants
# ============================================================================
"struct Point { x: i64 y: i64 }\n" = POINT_STRUCT
"struct Person { name: str age: i64 }\n" = PERSON_STRUCT
"struct Box[T] { value: T }\n" = BOX_STRUCT

# ============================================================================
# Helpers
# ============================================================================

pub fn sl_parse code:$str diagnostics:mut$error::Diagnostics -> std::List[common::Op] {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    store drop
    ops
}

pub fn sl_typecheck code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

pub fn sl_compile code:$str diagnostics:mut$error::Diagnostics -> common::Program {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test drop
    store ops helpers::compile_test_program
}

pub fn sl_is_struct_literal value:$common::OpValue -> bool {
    value common::OpValue::StructLiteral is
}

pub fn sl_is_match_arm value:$common::OpValue -> bool { value common::OpValue::MatchArm is }

pub fn sl_count_ops ops:$std::List[common::Op] predicate:fn[$common::OpValue -> bool] -> i64 {
    0 = count
    for sl_op in ops.iter do
        if sl_op.value predicate exec then
            1 += count
        fi
    done
    count
}

pub fn sl_count_insts bytecode:$std::List[common::InstValue] kind:common::InstValue -> i64 {
    0 = count
    0 (u64) = index
    while index bytecode.length > do
        if kind index bytecode.get == then
            1 += count
        fi
        1 += index
    done
    count
}

pub fn sl_has_inst_kind bytecode:$std::List[common::InstValue] kind:common::InstValue -> bool {
    0 kind bytecode sl_count_insts !=
}

# ============================================================================
# Parser: struct literal construction
# ============================================================================

pub fn test_basic_struct_literal {
    error::Diagnostics::new = diagnostics
    "basic_struct_literal" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: 1 y: 2 }" sl_parse = ops
    "has struct literal op" 1 &sl_is_struct_literal ops sl_count_ops == test::assert_true
    # Check the StructLiteral value
    0 (u64) = index
    while index ops.length > do
        if index ops.get.value common::OpValue::StructLiteral(literal) is then
            "struct name" "Point" literal common::StructLiteral::struct_name test::assert_str_eq
            "field count" 2 literal common::StructLiteral::field_order.length test::assert_eq
            "field 0" "x" 0 literal common::StructLiteral::field_order.get test::assert_str_eq
            "field 1" "y" 1 literal common::StructLiteral::field_order.get test::assert_str_eq
        fi
        1 += index
    done
}

pub fn test_reverse_field_order {
    error::Diagnostics::new = diagnostics
    "reverse_field_order" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { y: 2 x: 1 }" sl_parse = ops
    0 (u64) = index
    while index ops.length > do
        if index ops.get.value common::OpValue::StructLiteral(literal) is then
            "field 0" "y" 0 literal common::StructLiteral::field_order.get test::assert_str_eq
            "field 1" "x" 1 literal common::StructLiteral::field_order.get test::assert_str_eq
        fi
        1 += index
    done
}

pub fn test_struct_match_pattern {
    error::Diagnostics::new = diagnostics
    "struct_match_pattern" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    Point { x: px y: py } => px py +\nend" sl_parse = ops
    "has match arm" 0 &sl_is_match_arm ops sl_count_ops != test::assert_true
    0 (u64) = index
    while index ops.length > do
        if index ops.get.value common::OpValue::MatchArm is then
            if index ops.get common::pattern_value_of common::PatternValue::Struct(pattern) is then
                "struct name" "Point" pattern.struct_name test::assert_str_eq
                "binding x" "px" "x" pattern
                    .bindings
                    .get_str
                    .unwrap test::assert_str_eq
                "binding y" "py" "y" pattern
                    .bindings
                    .get_str
                    .unwrap test::assert_str_eq
            fi
        fi
        1 += index
    done
}

pub fn test_partial_binding {
    error::Diagnostics::new = diagnostics
    "partial_binding" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    Point { x: px } => px\nend" sl_parse = ops
    0 (u64) = index
    while index ops.length > do
        if index ops.get.value common::OpValue::MatchArm is then
            if index ops.get common::pattern_value_of common::PatternValue::Struct(pattern) is then
                "binding x" "px" "x" pattern
                    .bindings
                    .get_str
                    .unwrap test::assert_str_eq
                "no y binding" "y" pattern
                    .bindings
                    .get_str
                    .is_none test::assert_true
            fi
        fi
        1 += index
    done
}

pub fn test_field_value_with_expression {
    error::Diagnostics::new = diagnostics
    "field_value_with_expression" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: 1 2 + y: 3 }" sl_parse = ops
    "has struct literal op" 1 &sl_is_struct_literal ops sl_count_ops == test::assert_true
}

