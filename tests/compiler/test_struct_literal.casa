# ============================================================================
# Typechecker: struct literal
# ============================================================================

fn test_struct_literal_type_correct {
    Diagnostics::new = diagnostics
    "struct_literal_type_correct" test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: 1 y: 2 }" sl_typecheck = sig
    "returns Point" "Point" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_struct_literal_reverse_order_type {
    Diagnostics::new = diagnostics
    "struct_literal_reverse_order_type" test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { y: 2 x: 1 }" sl_typecheck = sig
    "returns Point" "Point" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_field_type_mismatch_error {
    Diagnostics::new = diagnostics
    "field_type_mismatch_error" test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: \"hello\" y: 2 }" sl_typecheck drop
    diagnostics "has errors" assert_has_errors
    diagnostics "type mismatch" ErrorKind::TypeMismatch assert_error_kind
}

fn test_struct_match_exhaustive {
    Diagnostics::new = diagnostics
    "struct_match_exhaustive" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    Point { x: px y: py } => px py +\nend\ndrop" sl_typecheck drop
    "passes" true assert_true
}

fn test_struct_match_wildcard_exhaustive {
    Diagnostics::new = diagnostics
    "struct_match_wildcard_exhaustive" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    _ => 0\nend\ndrop" sl_typecheck drop
    "passes" true assert_true
}

fn test_struct_match_binding_types {
    Diagnostics::new = diagnostics
    "struct_match_binding_types" test_start
    diagnostics "struct Person { name: str age: i64 }\n18 \"Alice\" Person = p\np match\n    Person { name: n age: a } => n a\nend" sl_typecheck = sig
    "returns str structurally" TYPE_STR_T 0 sig StackEffect::return_types.get.eq assert_true
    "returns i64 structurally" TYPE_I64_T 1 sig StackEffect::return_types.get.eq assert_true
}

fn test_struct_match_partial_binding {
    Diagnostics::new = diagnostics
    "struct_match_partial_binding" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    Point { x: px } => px\nend" sl_typecheck = sig
    "returns i64" "i64" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_generic_struct_literal {
    Diagnostics::new = diagnostics
    "generic_struct_literal" test_start
    # NOTE: Self-hosted compiler does not yet resolve type parameters in struct
    # literals (returns "Box" instead of "Box[i64]"). Test verifies no crash and
    # that a Box-prefixed type is returned.
    diagnostics "struct Box[T] { value: T }\nBox { value: 42 }" sl_typecheck = sig
    "returns Box type" 0 0 sig StackEffect::return_types.get.format "Box" str::find >= assert_true
}

fn test_generic_struct_literal_str {
    Diagnostics::new = diagnostics
    "generic_struct_literal_str" test_start
    # NOTE: Same limitation as test_generic_struct_literal above.
    diagnostics "struct Box[T] { value: T }\nBox { value: \"hello\" }" sl_typecheck = sig
    "returns Box type" 0 0 sig StackEffect::return_types.get.format "Box" str::find >= assert_true
}

fn test_stack_based_construction_still_works {
    Diagnostics::new = diagnostics
    "stack_based_construction_still_works" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point" sl_typecheck = sig
    "returns Point" "Point" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_stack_and_literal_coexist {
    Diagnostics::new = diagnostics
    "stack_and_literal_coexist" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p1\nPoint { x: 3 y: 4 } = p2\np1.x p2.x +" sl_typecheck = sig
    "returns i64" "i64" 0 sig StackEffect::return_types.get.format assert_str_eq
}

# ============================================================================
# Bytecode: struct literal
# ============================================================================

fn test_compile_struct_literal {
    Diagnostics::new = diagnostics
    "compile_struct_literal" test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: 1 y: 2 } = p\np.x drop" sl_compile = prog
    "has HEAP_ALLOC" InstValue::HeapAlloc prog Program::bytecode sl_has_inst_kind assert_true
    "has STORE64" InstValue::Store64 prog Program::bytecode sl_has_inst_kind assert_true
}

fn test_compile_struct_literal_reverse_order {
    Diagnostics::new = diagnostics
    "compile_struct_literal_reverse_order" test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { y: 99 x: 42 } = p\np.x drop" sl_compile = prog
    "has HEAP_ALLOC" InstValue::HeapAlloc prog Program::bytecode sl_has_inst_kind assert_true
    "has STORE64" InstValue::Store64 prog Program::bytecode sl_has_inst_kind assert_true
}

fn test_compile_struct_match {
    Diagnostics::new = diagnostics
    "compile_struct_match" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    Point { x: px y: py } => px py +\nend\ndrop" sl_compile drop
    "compiles" true assert_true
}

