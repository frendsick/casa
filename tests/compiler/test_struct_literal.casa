import "../../compiler/typechecker.casa"
import "../../compiler/bytecode.casa"
import "helpers.casa"

# ============================================================================
# Constants
# ============================================================================
"struct Point { x: i64 y: i64 }\n" = POINT_STRUCT
"struct Person { name: str age: i64 }\n" = PERSON_STRUCT
"struct Box[T] { value: T }\n" = BOX_STRUCT

# ============================================================================
# Helpers
# ============================================================================

fn sl_parse code:str diagnostics:Diagnostics -> List[Op] {
    diagnostics code parse_resolve_test_source ParseResolveResult::ops.unwrap
}

fn sl_typecheck code:str diagnostics:Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option[Function]::None ops type_check_ops_for_test
}

fn sl_compile code:str diagnostics:Diagnostics -> Program {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option[Function]::None ops type_check_ops_for_test drop
    store ops compile_test_program
}

fn sl_is_struct_literal value:OpValue -> bool { value OpValue::StructLiteral is }

fn sl_is_match_arm value:OpValue -> bool { value OpValue::MatchArm is }

fn sl_count_ops ops:List[Op] predicate:fn[OpValue -> bool] -> i64 {
    0 = count
    for sl_op in ops.iter do
        if sl_op.value predicate exec then
            1 += count
        fi
    done
    count
}

fn sl_count_insts bytecode:List[InstValue] kind:InstValue -> i64 {
    0 = count
    0 (u64) = index
    while index bytecode.length > do
        if kind index bytecode.get == then
            1 += count
        fi
        1 += index
    done
    count
}

fn sl_has_inst_kind bytecode:List[InstValue] kind:InstValue -> bool {
    0 kind bytecode sl_count_insts !=
}

# ============================================================================
# Parser: struct literal construction
# ============================================================================

fn test_basic_struct_literal {
    Diagnostics::new = diagnostics
    "basic_struct_literal" test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: 1 y: 2 }" sl_parse = ops
    "has struct literal op" 1 &sl_is_struct_literal ops sl_count_ops == assert_true
    # Check the StructLiteral value
    0 (u64) = index
    while index ops.length > do
        if index ops.get.value OpValue::StructLiteral(literal) is then
            "struct name" "Point" literal StructLiteral::struct_name assert_str_eq
            "field count" 2 literal StructLiteral::field_order.length assert_eq
            "field 0" "x" 0 literal StructLiteral::field_order.get assert_str_eq
            "field 1" "y" 1 literal StructLiteral::field_order.get assert_str_eq
        fi
        1 += index
    done
}

fn test_reverse_field_order {
    Diagnostics::new = diagnostics
    "reverse_field_order" test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { y: 2 x: 1 }" sl_parse = ops
    0 (u64) = index
    while index ops.length > do
        if index ops.get.value OpValue::StructLiteral(literal) is then
            "field 0" "y" 0 literal StructLiteral::field_order.get assert_str_eq
            "field 1" "x" 1 literal StructLiteral::field_order.get assert_str_eq
        fi
        1 += index
    done
}

fn test_struct_match_pattern {
    Diagnostics::new = diagnostics
    "struct_match_pattern" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    Point { x: px y: py } => px py +\nend" sl_parse = ops
    "has match arm" 0 &sl_is_match_arm ops sl_count_ops != assert_true
    0 (u64) = index
    while index ops.length > do
        if index ops.get.value OpValue::MatchArm is then
            if index ops.get pattern_value_of PatternValue::Struct(pattern) is then
                "struct name" "Point" pattern.struct_name assert_str_eq
                "binding x" "px" "x" pattern.bindings.get.unwrap assert_str_eq
                "binding y" "py" "y" pattern.bindings.get.unwrap assert_str_eq
            fi
        fi
        1 += index
    done
}

fn test_partial_binding {
    Diagnostics::new = diagnostics
    "partial_binding" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    Point { x: px } => px\nend" sl_parse = ops
    0 (u64) = index
    while index ops.length > do
        if index ops.get.value OpValue::MatchArm is then
            if index ops.get pattern_value_of PatternValue::Struct(pattern) is then
                "binding x" "px" "x" pattern.bindings.get.unwrap assert_str_eq
                "no y binding" "y" pattern.bindings.get.is_none assert_true
            fi
        fi
        1 += index
    done
}

fn test_field_value_with_expression {
    Diagnostics::new = diagnostics
    "field_value_with_expression" test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: 1 2 + y: 3 }" sl_parse = ops
    "has struct literal op" 1 &sl_is_struct_literal ops sl_count_ops == assert_true
}

