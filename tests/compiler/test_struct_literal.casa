pub fn test_struct_literal_type_correct {
    error::Diagnostics::new = diagnostics
    "struct_literal_type_correct" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: 1 y: 2 }" sl_typecheck = sig
    "returns Point" "Point" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_struct_literal_reverse_order_type {
    error::Diagnostics::new = diagnostics
    "struct_literal_reverse_order_type" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { y: 2 x: 1 }" sl_typecheck = sig
    "returns Point" "Point" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_field_type_mismatch_error {
    error::Diagnostics::new = diagnostics
    "field_type_mismatch_error" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: \"hello\" y: 2 }" sl_typecheck drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "type mismatch" common::ErrorKind::TypeMismatch helpers::assert_error_kind
}

pub fn test_struct_match_exhaustive {
    error::Diagnostics::new = diagnostics
    "struct_match_exhaustive" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    Point { x: px y: py } => px py +\nend\ndrop" sl_typecheck drop
    "passes" true test::assert_true
}

pub fn test_struct_match_wildcard_exhaustive {
    error::Diagnostics::new = diagnostics
    "struct_match_wildcard_exhaustive" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    _ => 0\nend\ndrop" sl_typecheck drop
    "passes" true test::assert_true
}

pub fn test_struct_match_binding_types {
    error::Diagnostics::new = diagnostics
    "struct_match_binding_types" test::test_start
    diagnostics "struct Person { name: str age: i64 }\n18 \"Alice\" Person match\n    Person { name: n age: a } => n a\nend" sl_typecheck = sig
    "returns str structurally" common::make_str_type 0 sig common::StackEffect::return_types.get.eq test::assert_true
    "returns i64 structurally" common::make_i64_type 1 sig common::StackEffect::return_types.get.eq test::assert_true
}

pub fn test_struct_match_partial_binding {
    error::Diagnostics::new = diagnostics
    "struct_match_partial_binding" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    Point { x: px } => px\nend" sl_typecheck = sig
    "returns i64" "i64" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_generic_struct_literal {
    error::Diagnostics::new = diagnostics
    "generic_struct_literal" test::test_start
    # NOTE: Self-hosted compiler does not yet resolve type parameters in struct
    # literals (returns "Box" instead of "Box[i64]"). Test verifies no crash and
    # that a Box-prefixed type is returned.
    diagnostics "struct Box[T] { value: T }\nBox { value: 42 }" sl_typecheck = sig
    "returns Box type" 0 0 sig common::StackEffect::return_types
        .get
        .format
        .as_str "Box" str::find >= test::assert_true
}

pub fn test_generic_struct_literal_str {
    error::Diagnostics::new = diagnostics
    "generic_struct_literal_str" test::test_start
    # NOTE: Same limitation as test_generic_struct_literal above.
    diagnostics "struct Box[T] { value: T }\nBox { value: \"hello\" }" sl_typecheck = sig
    "returns Box type" 0 0 sig common::StackEffect::return_types
        .get
        .format
        .as_str "Box" str::find >= test::assert_true
}

pub fn test_stack_based_construction_still_works {
    error::Diagnostics::new = diagnostics
    "stack_based_construction_still_works" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point" sl_typecheck = sig
    "returns Point" "Point" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_stack_and_literal_coexist {
    error::Diagnostics::new = diagnostics
    "stack_and_literal_coexist" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p1\nPoint { x: 3 y: 4 } = p2\np1.x p2.x +" sl_typecheck = sig
    "returns i64" "i64" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

# ============================================================================
# Bytecode: struct literal
# ============================================================================

pub fn test_compile_struct_literal {
    error::Diagnostics::new = diagnostics
    "compile_struct_literal" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: 1 y: 2 } = p\np.x drop" sl_compile = prog
    "has HEAP_ALLOC" common::InstValue::HeapAlloc prog common::Program::bytecode sl_has_inst_kind test::assert_true
    "has STORE64" common::InstValue::Store64 prog common::Program::bytecode sl_has_inst_kind test::assert_true
}

pub fn test_compile_struct_literal_reverse_order {
    error::Diagnostics::new = diagnostics
    "compile_struct_literal_reverse_order" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { y: 99 x: 42 } = p\np.x drop" sl_compile = prog
    "has HEAP_ALLOC" common::InstValue::HeapAlloc prog common::Program::bytecode sl_has_inst_kind test::assert_true
    "has STORE64" common::InstValue::Store64 prog common::Program::bytecode sl_has_inst_kind test::assert_true
}

pub fn test_compile_struct_match {
    error::Diagnostics::new = diagnostics
    "compile_struct_match" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n1 2 Point = p\np match\n    Point { x: px y: py } => px py +\nend\ndrop" sl_compile drop
    "compiles" true test::assert_true
}

