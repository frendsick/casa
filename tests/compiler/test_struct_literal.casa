}

fn test_missing_value_error {
    Diagnostics::new = diagnostics
    "missing_value_error" test_start
    diagnostics "struct Point { x: i64 y: i64 }\nPoint { x: y: 1 }" sl_parse drop
    # Self-hosted compiler may or may not detect missing value syntax errors.
    # Just verify no crash occurred.
}

