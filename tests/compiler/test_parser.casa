# ============================================================================
# Function definition tests
# ============================================================================

pub fn test_parse_function_def {
    "parse_function_def" test::test_start
    "test" "fn add a:i64 b:i64 -> i64 { a b + }" lexer::lex_source = lex_result
    lex_result parser_test_resolve_parts = store = ops
    "fn registered" "add" store.get_function.is_some test::assert_true
    "add" store.get_function.unwrap = add_fn
    "fn name" "add" add_fn common::Function::name test::assert_str_eq
    "param count" 2 add_fn common::Function::stack_effect common::StackEffect::parameters.length test::assert_eq
    "return count" 1 add_fn common::Function::stack_effect common::StackEffect::return_types.length test::assert_eq
    "return type" "i64" 0 add_fn common::Function::stack_effect common::StackEffect::return_types.get.format test::assert_str_eq
}

# ============================================================================
# Enum definition tests
# ============================================================================

pub fn test_parse_enum_def {
    "parse_enum_def" test::test_start
    "test" "enum Color { Red Green Blue }" lexer::lex_source = lex_result
    lex_result parser_test_resolve_parts = store = ops
    "enum registered" "Color" store
        .enums
        .get_str
        .is_some test::assert_true
    "Color" store
        .enums
        .get_str
        .unwrap = color_enum
    "variant count" 3 color_enum common::CasaEnum::variants.length test::assert_eq
    "variant 0" "Red" 0 color_enum common::CasaEnum::variants.get test::assert_str_eq
    "variant 1" "Green" 1 color_enum common::CasaEnum::variants.get test::assert_str_eq
    "variant 2" "Blue" 2 color_enum common::CasaEnum::variants.get test::assert_str_eq
}

# ============================================================================
# Struct definition tests
# ============================================================================

pub fn test_parse_struct_def {
    "parse_struct_def" test::test_start
    "test" "struct Point { x: i64 y: i64 }" lexer::lex_source = lex_result
    lex_result parser_test_resolve_parts = store = ops
    "struct registered" "Point" store
        .structs
        .get_str
        .is_some test::assert_true
    "Point" store
        .structs
        .get_str
        .unwrap = point_struct
    "member count" 2 point_struct common::CasaStruct::members.length test::assert_eq
    "member 0 name" "x" 0 point_struct common::CasaStruct::members.get common::Member::name test::assert_str_eq
    "member 0 type" "i64" 0 point_struct common::CasaStruct::members.get common::Member::typ.format test::assert_str_eq
    "getter registered" "Point::x" store.get_function.is_some test::assert_true
    "setter registered" "Point::set_x" store.get_function.is_some test::assert_true
}

# ============================================================================
# If/while construct tests
# ============================================================================

pub fn test_parse_if_construct {
    "parse_if_construct" test::test_start
    "test" "if true then 42 else 0 fi" lexer::lex_source = lex_result
    lex_result parser_test_resolve = ops
    "if" 0 ops.get.value common::OpValue::IfStart is test::assert_true
    "true" 1 ops.get.value common::OpValue::PushBool is test::assert_true
    "then" 2 ops.get.value common::OpValue::IfCondition is test::assert_true
    "42" 3 ops.get.value common::OpValue::PushInt is test::assert_true
    "else" 4 ops.get.value common::OpValue::IfElse is test::assert_true
    "0" 5 ops.get.value common::OpValue::PushInt is test::assert_true
    "fi" 6 ops.get.value common::OpValue::IfEnd is test::assert_true
}

pub fn test_parse_while_construct {
    "parse_while_construct" test::test_start
    "test" "while true do break done" lexer::lex_source = lex_result
    lex_result parser_test_resolve = ops
    "while" 0 ops.get.value common::OpValue::WhileStart is test::assert_true
    "true" 1 ops.get.value common::OpValue::PushBool is test::assert_true
    "do" 2 ops.get.value common::OpValue::WhileCondition is test::assert_true
    "break" 3 ops.get.value common::OpValue::WhileBreak is test::assert_true
    "done" 4 ops.get.value common::OpValue::WhileEnd is test::assert_true
}

