}

pub fn test_import_diagnostics_preserve_encounter_order {
    "import_diagnostics_preserve_encounter_order" test::test_start
    lexer::SourceStore::new = sources
    "\"bad\\q\"" "/tmp/casa_import_order_258.casa" sources.add
    "root" "import \"/tmp/casa_import_order_258.casa\" as imported" lexer::lex_source = lex_result
    common::empty_location "root first".to_str common::ErrorKind::Syntax error::CasaError::new lex_result.diagnostics.push_error
    sources lex_result resolve_lex_result = result
    "two diagnostics" 2 result
        .diagnostics
        .entries
        .length test::assert_eq
    0 result
        .diagnostics
        .entries
        .get = first
    1 result
        .diagnostics
        .entries
        .get = second
    if first error::Diagnostic::Error(first_error) is then
        "root diagnostic first" "root first" first_error.message test::assert_str_eq
    else
        "first diagnostic is error" false test::assert_true
    fi
    if second error::Diagnostic::Error(second_error) is then
        "import diagnostic second" "Invalid escape sequence" second_error.message test::assert_str_eq
    else
        "second diagnostic is error" false test::assert_true
    fi
}

pub fn assert_import_failure imported_source:str root_source:str path:str message:$str {
    lexer::SourceStore::new = sources
    imported_source path sources.add
    "root" root_source lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    f"{message} has no output" result.ops.is_none test::assert_true
    f"{message} has one diagnostic" 1 result
        .diagnostics
        .entries
        .length test::assert_eq
}

pub fn test_full_and_selective_import_failures_are_explicit {
    "full_and_selective_import_failures_are_explicit" test::test_start
    "full lexical failure"
    "/tmp/casa_full_lexical_failure_258.casa"
    "import \"/tmp/casa_full_lexical_failure_258.casa\" as imported"
    "\"bad\\q\""
    assert_import_failure
    "full parser failure"
    "/tmp/casa_full_parser_failure_258.casa"
    "import \"/tmp/casa_full_parser_failure_258.casa\" as imported"
    "end 42"
    assert_import_failure
    "full resolution failure"
    "/tmp/casa_full_resolution_failure_258.casa"
    "import \"/tmp/casa_full_resolution_failure_258.casa\" as imported"
    "missing_imported"
    assert_import_failure
    "selective lexical failure"
    "/tmp/casa_selective_lexical_failure_258.casa"
    "import \"/tmp/casa_selective_lexical_failure_258.casa\" as imported { exported }"
    "\"bad\\q\""
    assert_import_failure
    "selective parser failure"
    "/tmp/casa_selective_parser_failure_258.casa"
    "import \"/tmp/casa_selective_parser_failure_258.casa\" as imported { exported }"
    "end 42"
    assert_import_failure
    "selective resolution failure"
    "/tmp/casa_selective_resolution_failure_258.casa"
    "import \"/tmp/casa_selective_resolution_failure_258.casa\" as imported { exported }"
    "pub fn exported { missing_imported }"
    assert_import_failure
}

pub fn test_import_diagnostic_precedes_later_root_diagnostic {
    "import_diagnostic_precedes_later_root_diagnostic" test::test_start
    lexer::SourceStore::new = sources
    "\"bad\\q\"" "/tmp/casa_import_encounter_order_258.casa" sources.add
    "root" "end import \"/tmp/casa_import_encounter_order_258.casa\" as imported \"root\\q\"" lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "three diagnostics" 3 result
        .diagnostics
        .entries
        .length test::assert_eq
    1 result
        .diagnostics
        .entries
        .get = imported_diagnostic
    if imported_diagnostic error::Diagnostic::Error(imported_error) is then
        "import diagnostic stays at encounter" "/tmp/casa_import_encounter_order_258.casa" imported_error.location.file test::assert_str_eq
    else
        "import diagnostic is error" false test::assert_true
    fi
}

pub fn test_failed_import_does_not_mutate_importer_symbols {
    "failed_import_does_not_mutate_importer_symbols" test::test_start
    lexer::SourceStore::new = sources
    "base missing_imported" "/tmp/casa_import_isolation_258.casa" sources.add
    "root" "fn base -> i64 { 1 } import \"/tmp/casa_import_isolation_258.casa\" as imported" lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    std::Map[std::String syntax::ImportedModule]::new = import_cache
    import_cache sources lex_diagnostics common::symbol_store_new syntax::Parser::new = parser
    tokens parser syntax::parse_ops = ops
    std::Set[std::String]::new ops parser syntax::resolve_identifiers_global drop
    "import failed" parser.state.has_usable_output ! test::assert_true
    "base" parser
        .store
        .functions
        .get_str = base_opt
    if base_opt std::Option::Some(base_function) is then
        "base function remains unused" base_function.is_used ! test::assert_true
    else
        "base function exists" false test::assert_true
    fi
    "failed import symbol omitted" "missing_imported" parser
        .store
        .functions
        .has_str ! test::assert_true
}

pub fn test_import_parser_failure_suppresses_nested_cascade {
    "import_parser_failure_suppresses_nested_cascade" test::test_start
    lexer::SourceStore::new = sources
    "missing_nested" "/tmp/casa_import_parser_nested_258.casa" sources.add
    "end import \"/tmp/casa_import_parser_nested_258.casa\" as nested"
    "/tmp/casa_import_parser_parent_258.casa"
    sources.add
    "root" "import \"/tmp/casa_import_parser_parent_258.casa\" as parent" lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "parser failure has no output" result.ops.is_none test::assert_true
    "nested import was not expanded" 1 result
        .diagnostics
        .entries
        .length test::assert_eq
}

pub fn test_selective_import_failure_stops_later_expansion {
    "selective_import_failure_stops_later_expansion" test::test_start
    lexer::SourceStore::new = sources
    "pub fn selected -> i64 { 1 }" "/tmp/casa_selective_stop_first_258.casa" sources.add
    "missing_later" "/tmp/casa_selective_stop_later_258.casa" sources.add
    "root"
    "import \"/tmp/casa_selective_stop_first_258.casa\" as first { missing } import \"/tmp/casa_selective_stop_later_258.casa\" as later"
    lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "selective import failed" result.ops.is_none test::assert_true
    "later import was not expanded" 1 result
        .diagnostics
        .entries
        .length test::assert_eq
}

pub fn test_uninhabited_recursive_declarations_report_each_cycle_member {
    "uninhabited_recursive_declarations_report_each_cycle_member" test::test_start
    "test"
    "struct Direct { next: Direct } struct Left { right: Right } struct Right { left: Left } enum Endless { More(Endless) }"
    lexer::lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "one diagnostic per uninhabited declaration" 4 result.diagnostics.error_count test::assert_eq
}

pub fn test_recursive_declarations_accept_finite_base_cases {
    "recursive_declarations_accept_finite_base_cases" test::test_start
    "test"
    "enum Chain { End More(Chain) } struct EmptyTail { tail: array[EmptyTail 0] }"
    lexer::lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "enum leaves and empty arrays are finite base cases" result.diagnostics.has_errors ! test::assert_true
}

