pub fn test_parse_result_returns_ordered_diagnostics {
    "parse_result_returns_ordered_diagnostics" test::test_start
    "test" "missing" lexer::lex_source = lex_result
    common::empty_location "lexical first".to_str common::ErrorKind::Syntax error::CasaError::new lex_result.diagnostics.push_error
    lex_result resolve_test_lex_result = result
    result.diagnostics.entries = entries: $std::List[error::Diagnostic]
    "diagnostic count" 2 entries.length test::assert_eq
    0 entries.get = first
    entries.length 1 - entries.get = last
    if first error::Diagnostic::Error(first_error) is then
        "first diagnostic is lexical" "lexical first" first_error error::CasaError::message test::assert_str_eq
    else
        "first diagnostic is error" false test::assert_true
    fi
    if last error::Diagnostic::Error(last_error) is then
        "parser diagnostic follows" "Identifier `missing` is not defined" last_error error::CasaError::message test::assert_str_eq
    else
        "last diagnostic is error" false test::assert_true
    fi
}

pub fn test_parse_result_keeps_output_after_structural_recovery {
    "parse_result_keeps_output_after_structural_recovery" test::test_start
    "test" "end 42" lexer::lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "has diagnostic" result.diagnostics.has_errors test::assert_true
    "has usable output" result.ops.is_some test::assert_true
}

pub fn assert_structural_recovery source:str message:$str {
    "test" source lexer::lex_source = lex_result
    lex_result resolve_test_lex_result = result
    f"{message} diagnostic" result.diagnostics.has_errors test::assert_true
    f"{message} output" result.ops.is_some test::assert_true
    result.into_parts = diagnostics = store = result_ops
    diagnostics drop
    store drop
    result_ops.unwrap = ops
    f"{message} excludes failed ops" 1 ops.length test::assert_eq
    f"{message} resumed after delimiter" 42 ops.length 1 - ops.get common::op_int_value test::assert_eq
}

pub fn test_parse_result_recovers_at_supported_delimiters {
    "parse_result_recovers_at_supported_delimiters" test::test_start
    "close brace" ". } 42" assert_structural_recovery
    "fi" ". fi 42" assert_structural_recovery
    "done" ". done 42" assert_structural_recovery
    "end" ". end 42" assert_structural_recovery
    "top-level declaration" ". fn recovered { 1 } 42" assert_structural_recovery
}

