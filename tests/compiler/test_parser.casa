    "count" 2 ops.length test::assert_eq
    "push kind" 0 ops.get.value common::OpValue::PushInt is test::assert_true
    "assign kind" 1 ops.get.value common::OpValue::AssignVar is test::assert_true
    "assign name" "foo" 1 ops.get common::op_str_value test::assert_str_eq
}

