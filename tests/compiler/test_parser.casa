    "/tmp/casa_cycle_a_332.casa"
    sources.add
    "import \"/tmp/casa_cycle_a_332.casa\" as cycle_a"
    "/tmp/casa_cycle_b_332.casa"
    sources.add
    "root"
    "import \"/tmp/casa_cycle_a_332.casa\" as cycle_a"
    lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "cycle has no usable output" result.ops.is_none test::assert_true
    "one cycle diagnostic" 1 result.diagnostics.error_count test::assert_eq
    0 result
        .diagnostics
        .entries
        .get = diagnostic
    if diagnostic error::Diagnostic::Error(import_error) is then
        "complete cycle path"
        "Module import cycle: /tmp/casa_cycle_a_332.casa -> /tmp/casa_cycle_b_332.casa -> /tmp/casa_cycle_a_332.casa"
        import_error.message
        test::assert_str_eq
    else
        "cycle diagnostic is error" false test::assert_true
    fi
}

pub fn test_diamond_import_initializers_are_unique {
    "diamond_import_initializers_are_unique" test::test_start
    lexer::SourceStore::new = sources
    "pub global BASE 40 pub global COUNTED { BASE }"
    "/tmp/casa_init_base_344.casa"
    sources.add
    "import \"/tmp/casa_init_base_344.casa\" as base pub global LEFT { base::COUNTED 1 + }"
    "/tmp/casa_init_left_344.casa"
    sources.add
    "import \"/tmp/casa_init_base_344.casa\" as base pub global RIGHT { base::COUNTED 2 + }"
    "/tmp/casa_init_right_344.casa"
    sources.add
    "root"
    "import \"/tmp/casa_init_left_344.casa\" as left import \"/tmp/casa_init_right_344.casa\" as right"
    lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "diamond import has no diagnostics" result.diagnostics.has_errors ! test::assert_true
    0 = initializer_count: u64
    0 = base_initializer_count: u64
    if result.ops std::Option::Some(ops) is then
        for op in ops.iter do
            if op.value common::OpValue::InitGlobal is then
                1 += initializer_count
                if
                    op
                        .location
                        .file
                        .as_str "/tmp/casa_init_base_344.casa" ==
                then
                    1 += base_initializer_count
                fi
            fi
        done
    fi
    "four unique initializers" 4 initializer_count test::assert_eq
    "base initializers included once" 2 base_initializer_count test::assert_eq
}

