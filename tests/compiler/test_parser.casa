# ============================================================================
# Function definition tests
# ============================================================================

fn test_parse_function_def {
    "parse_function_def" test_start
    "test" "fn add a:i64 b:i64 -> i64 { a b + }" lex_source = lex_result
    lex_result.tokens = tokens: $List[Token]
    tokens parser_test_parse = ops
    # parse_ops should register the function in PARSER_TEST_STORE.functions
    "fn registered" "add" PARSER_TEST_STORE
        .functions
        .get_str
        .is_some assert_true
    "add" PARSER_TEST_STORE
        .functions
        .get_str
        .unwrap = add_fn
    "fn name" "add" add_fn Function::name assert_str_eq
    "param count" 2 add_fn Function::stack_effect StackEffect::parameters.length assert_eq
    "return count" 1 add_fn Function::stack_effect StackEffect::return_types.length assert_eq
    "return type" "i64" 0 add_fn Function::stack_effect StackEffect::return_types.get.format assert_str_eq
}

# ============================================================================
# Enum definition tests
# ============================================================================

fn test_parse_enum_def {
    "parse_enum_def" test_start
    "test" "enum Color { Red Green Blue }" lex_source = lex_result
    lex_result.tokens = tokens: $List[Token]
    tokens parser_test_parse = ops
    "enum registered" "Color" PARSER_TEST_STORE
        .enums
        .get_str
        .is_some assert_true
    "Color" PARSER_TEST_STORE
        .enums
        .get_str
        .unwrap = color_enum
    "variant count" 3 color_enum CasaEnum::variants.length assert_eq
    "variant 0" "Red" 0 color_enum CasaEnum::variants.get assert_str_eq
    "variant 1" "Green" 1 color_enum CasaEnum::variants.get assert_str_eq
    "variant 2" "Blue" 2 color_enum CasaEnum::variants.get assert_str_eq
}

# ============================================================================
# Struct definition tests
# ============================================================================

fn test_parse_struct_def {
    "parse_struct_def" test_start
    "test" "struct Point { x: i64 y: i64 }" lex_source = lex_result
    lex_result.tokens = tokens: $List[Token]
    tokens parser_test_parse = ops
    "struct registered" "Point" PARSER_TEST_STORE
        .structs
        .get_str
        .is_some assert_true
    "Point" PARSER_TEST_STORE
        .structs
        .get_str
        .unwrap = point_struct
    "member count" 2 point_struct CasaStruct::members.length assert_eq
    "member 0 name" "x" 0 point_struct CasaStruct::members.get Member::name assert_str_eq
    "member 0 type" "i64" 0 point_struct CasaStruct::members.get Member::typ.format assert_str_eq
    "getter registered" "Point::x" PARSER_TEST_STORE
        .functions
        .get_str
        .is_some assert_true
    "setter registered" "Point::set_x" PARSER_TEST_STORE
        .functions
        .get_str
        .is_some assert_true
}

# ============================================================================
# If/while construct tests
# ============================================================================

fn test_parse_if_construct {
    "parse_if_construct" test_start
    "test" "if true then 42 else 0 fi" lex_source = lex_result
    lex_result.tokens = tokens: $List[Token]
    tokens parser_test_parse = ops
    "if" 0 ops.get.value OpValue::IfStart is assert_true
    "true" 1 ops.get.value OpValue::PushBool is assert_true
    "then" 2 ops.get.value OpValue::IfCondition is assert_true
    "42" 3 ops.get.value OpValue::PushInt is assert_true
    "else" 4 ops.get.value OpValue::IfElse is assert_true
    "0" 5 ops.get.value OpValue::PushInt is assert_true
    "fi" 6 ops.get.value OpValue::IfEnd is assert_true
}

fn test_parse_while_construct {
    "parse_while_construct" test_start
    "test" "while true do break done" lex_source = lex_result
    lex_result.tokens = tokens: $List[Token]
    tokens parser_test_parse = ops
    "while" 0 ops.get.value OpValue::WhileStart is assert_true
    "true" 1 ops.get.value OpValue::PushBool is assert_true
    "do" 2 ops.get.value OpValue::WhileCondition is assert_true
    "break" 3 ops.get.value OpValue::WhileBreak is assert_true
    "done" 4 ops.get.value OpValue::WhileEnd is assert_true
}

