    else
        "import diagnostic is error" false assert_true
    fi
}

fn test_failed_import_does_not_mutate_importer_symbols {
    "failed_import_does_not_mutate_importer_symbols" test_start
    SourceStore::new = sources
    "base missing_imported" "/tmp/casa_import_isolation_258.casa" sources.add
    "root" "fn base -> i64 { 1 } import \"/tmp/casa_import_isolation_258.casa\"" lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    sources lex_diagnostics symbol_store_new Parser::new = parser
    tokens parser parse_ops = ops
    Set[String]::new ops parser resolve_identifiers_global drop
    "import failed" parser.state.has_usable_output ! assert_true
    "base" parser
        .store
        .functions
        .get_str = base_opt
    if base_opt Option::Some(base_function) is then
        "base function remains unused" base_function.is_used ! assert_true
    else
        "base function exists" false assert_true
    fi
    "failed import symbol omitted" "missing_imported" parser
        .store
        .functions
        .has_str ! assert_true
}

