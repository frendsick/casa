    std::Map[std::String syntax::ImportedModule]::new = import_cache
    import_cache lexer::SourceStore::new error::Diagnostics::new common::symbol_store_new syntax::Parser::new = parser
    paths = parser.search_paths
    "resolved"
    "lib/argparse.casa" parser_test_absolute
    common::empty_location "argparse" "examples/argparse.casa" parser syntax::resolve_import
    test::assert_str_eq
}

