pub fn test_selective_import_reuses_module_analysis {
    "selective_import_reuses_module_analysis" test::test_start
    lexer::SourceStore::new = sources
    "pub fn first -> i64 { 1 } pub fn second -> i64 { 2 }" "/tmp/casa_selective_reuse_258.casa" sources.add
    "root" "import \"/tmp/casa_selective_reuse_258.casa\" as values { first } import \"/tmp/casa_selective_reuse_258.casa\" as values { second } __casa_values__first __casa_values__second" lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    std::Map[std::String syntax::ImportedModule]::new = import_cache
    import_cache sources lex_diagnostics common::symbol_store_new syntax::Parser::new = parser
    tokens parser syntax::parse_ops = ops
    std::Set[std::String]::new ops parser syntax::resolve_identifiers_global drop
    "selective import reuse has no diagnostics" parser
        .state
        .diagnostics
        .has_errors ! test::assert_true
    "module analyzed once" 1 parser.selective_import_cache.length test::assert_eq
    "first symbol committed" "__casa_values__first" parser
        .store
        .functions
        .has_str test::assert_true
    "second symbol committed" "__casa_values__second" parser
        .store
        .functions
        .has_str test::assert_true

    lexer::SourceStore::new = mixed_sources
    "pub fn selected -> i64 { 1 } pub fn hidden -> i64 { 2 }" "/tmp/casa_selective_then_full_258.casa" mixed_sources.add
    "root" "import \"/tmp/casa_selective_then_full_258.casa\" as mixed { selected } import \"/tmp/casa_selective_then_full_258.casa\" as mixed __casa_mixed__hidden" lexer::lex_source = mixed_lex_result
    mixed_lex_result.into_parts = mixed_diagnostics = mixed_tokens
    std::Map[std::String syntax::ImportedModule]::new = mixed_import_cache
    mixed_import_cache mixed_sources mixed_diagnostics common::symbol_store_new syntax::Parser::new = mixed_parser
    mixed_tokens mixed_parser syntax::parse_ops = mixed_ops
    std::Set[std::String]::new mixed_ops mixed_parser syntax::resolve_identifiers_global drop
    "mixed import has no diagnostics" mixed_parser
        .state
        .diagnostics
        .has_errors ! test::assert_true
    "full import reuses cached analysis" 1 mixed_parser.selective_import_cache.length test::assert_eq
    "full import exposes namespaced symbol" "__casa_mixed__hidden" mixed_parser
        .store
        .functions
        .has_str test::assert_true
}

pub fn test_failed_nested_import_discards_symbols_and_stops_resolution {
    "failed_nested_import_discards_symbols_and_stops_resolution" test::test_start
