    "count" 4 ops.length test::assert_eq
    "push 1" 0 ops.get.value common::OpValue::PushInt is test::assert_true
    "push 2" 1 ops.get.value common::OpValue::PushInt is test::assert_true
    "add" 2 ops.get.value common::OpValue::Add is test::assert_true
    "assign" 3 ops.get.value common::OpValue::AssignVar is test::assert_true
