pub fn test_parse_explicit_generic_associated_item {
    "parse_explicit_generic_associated_item" test::test_start
    "test" "List[i64]::new" lexer::lex_source = lex_result
    lex_result.tokens parser_test_parse = ops
    "single op" 1 ops.length test::assert_eq
    "associated identifier" 0 ops.get.value common::OpValue::Identifier is test::assert_true
    if 0 ops.get.type_hint std::Option::Some(type_hint) is then
        "explicit type" "List[i64]" type_hint.format test::assert_str_eq
    else
        "explicit type hint" false test::assert_true
    fi
}

