pub fn test_parse_result_resolves_function_bodies {
    "parse_result_resolves_function_bodies" test::test_start
    "test"
    "trait Keep { fn keep self:self -> self { self } } fn identity[T] value:T -> T { value }"
    lexer::lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "function bodies resolve" result.diagnostics.has_errors ! test::assert_true

    "identity" result
        .store
        .get_function
        .unwrap = identity
    "function marked resolved" identity.is_resolved test::assert_true
    "function variable resolved" identity.ops.length 1 - identity
        .ops
        .get
        .value
    common::OpValue::PushVar is test::assert_true

    "Keep" result
        .store
        .traits
        .get_str
        .unwrap = keep_trait
    0 keep_trait.methods.get = keep_method
    "default marked resolved" keep_method.default_is_resolved test::assert_true
    "default variable retained" 1 keep_method.default_variables.length test::assert_eq
    "default variable resolved" 0 keep_method
        .default_ops
        .get
        .value common::OpValue::PushVar is
    test::assert_true
}

