import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../compiler/syntax.casa" as syntax
import "../../lib/test.casa" as test

common::symbol_store_new = PARSER_TEST_STORE

pub fn resolve_lex_result
    lex_result:lexer::LexResult
    sources:mut$lexer::SourceStore
-> syntax::ParseResolveResult {
    lex_result.into_parts = diagnostics = tokens
    sources diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve
}

pub fn resolve_test_lex_result lex_result:lexer::LexResult -> syntax::ParseResolveResult {
    lexer::SourceStore::new = sources
    sources lex_result resolve_lex_result
}

pub fn parser_test_parse tokens:$std::List[common::Token] -> std::List[common::Op] {
    global PARSER_TEST_STORE
    std::Map[std::String syntax::ImportedModule]::new = import_cache
    import_cache lexer::SourceStore::new error::Diagnostics::new common::symbol_store_new syntax::Parser::new = parser
    tokens.clone parser syntax::parse_ops = ops
    parser.into_parts = state = included_files = store
    state drop
    included_files drop
    store = PARSER_TEST_STORE
    ops
}

# ============================================================================
# Literal parsing tests
# ============================================================================

pub fn test_parse_integer {
    "parse_integer" test::test_start
    "test" "42" lexer::lex_source = lex_result
    lex_result.tokens = tokens: $std::List[common::Token]
    tokens parser_test_parse = ops
    "count" 1 ops.length test::assert_eq
    "kind" 0 ops.get.value common::OpValue::PushInt is test::assert_true
    "value" 42 0 ops.get common::op_int_value test::assert_eq
}

pub fn test_parse_negative_integer {
    "parse_negative_integer" test::test_start
    "test" "-7" lexer::lex_source = lex_result
    lex_result.tokens = tokens: $std::List[common::Token]
    tokens parser_test_parse = ops
    "count" 1 ops.length test::assert_eq
    "kind" 0 ops.get.value common::OpValue::PushInt is test::assert_true
    "value" 0 7 - 0 ops.get common::op_int_value test::assert_eq
}

