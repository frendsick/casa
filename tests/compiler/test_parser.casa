pub fn test_resolve_import_canonicalizes_relative_and_absolute_paths {
    "resolve_import_canonicalizes_relative_and_absolute_paths" test::test_start
    std::Map[std::String syntax::ImportedModule]::new = import_cache
    import_cache lexer::SourceStore::new error::Diagnostics::new common::symbol_store_new syntax::Parser::new = parser
    "lib/std.casa" parser_test_absolute = absolute
    common::empty_location "lib/std.casa" "casa.casa" parser syntax::resolve_import = relative_result
    common::empty_location absolute.as_str "casa.casa" parser syntax::resolve_import = absolute_result
    "same file" absolute_result relative_result test::assert_str_eq
}

