fn test_parse_explicit_generic_associated_item {
    "parse_explicit_generic_associated_item" test_start
    "test" "List[i64]::new" lex_source = lex_result
    lex_result.tokens parser_test_parse = ops
    "single op" 1 ops.length assert_eq
    "associated identifier" 0 ops.get.value OpValue::Identifier is assert_true
    if 0 ops.get.type_hint Option::Some(type_hint) is then
        "explicit type" "List[i64]" type_hint.format assert_str_eq
    else
        "explicit type hint" false assert_true
    fi
}

