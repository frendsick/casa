pub fn test_parse_string_with_escapes {
    "parse_string_with_escapes" test::test_start
    "test" "\"hello\\nworld\"" lexer::lex_source = lex_result
    lex_result parser_test_resolve = ops
    "count" 1 ops.length test::assert_eq
    "kind" 0 ops.get.value common::OpValue::PushStr is test::assert_true
    "value" "hello\nworld" 0 ops.get common::op_str_value test::assert_str_eq
}

pub fn test_parse_result_returns_ordered_diagnostics {
    "parse_result_returns_ordered_diagnostics" test::test_start
    "test" "missing" lexer::lex_source = lex_result
    common::empty_location "lexical first".to_str common::ErrorKind::Syntax error::CasaError::new lex_result.diagnostics.push_error
    lex_result resolve_test_lex_result = result
    "source failure stops resolution" result.ops.is_none test::assert_true
    "lexical diagnostic retained" 1 result
        .diagnostics
        .entries
        .length test::assert_eq
    if
        0 result
            .diagnostics
            .entries
            .get error::Diagnostic::Error(first_error) is
    then
        "first diagnostic is lexical" "lexical first" first_error.message test::assert_str_eq
    else
        "first diagnostic is error" false test::assert_true
    fi
}

pub fn test_parse_result_rejects_invalid_root_syntax {
    "parse_result_rejects_invalid_root_syntax" test::test_start
    "test" "end 42" lexer::lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "has diagnostic" result.diagnostics.has_errors test::assert_true
    "invalid root has no output" result.ops.is_none test::assert_true
}

pub fn assert_invalid_root source:str message:$str {
    "test" source lexer::lex_source = lex_result
    lex_result resolve_test_lex_result = result
    f"{message} diagnostic" result.diagnostics.has_errors test::assert_true
    f"{message} rejected before resolution" result.ops.is_none test::assert_true
    f"{message} publishes no declarations" 0 result.store.count_functions test::assert_eq
}

pub fn test_parse_result_rejects_damaged_root_constructs {
    "parse_result_rejects_damaged_root_constructs" test::test_start
    "close brace" ". } 42" assert_invalid_root
    "fi" ". fi 42" assert_invalid_root
    "done" ". done 42" assert_invalid_root
    "end" ". end 42" assert_invalid_root
    "top-level declaration" ". fn recovered { 1 } 42" assert_invalid_root
}

pub fn test_parse_result_rejects_ambiguous_end_of_input {
    "parse_result_rejects_ambiguous_end_of_input" test::test_start
    "test" "fn foo {" lexer::lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "has diagnostic" result.diagnostics.has_errors test::assert_true
    "has no usable output" result.ops.is_none test::assert_true
}

pub fn test_parse_result_discards_failed_declaration_state {
    "parse_result_discards_failed_declaration_state" test::test_start
    "test" "fn 42 { 1 } 2" lexer::lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "has diagnostic" result.diagnostics.has_errors test::assert_true
    "has no usable output" result.ops.is_none test::assert_true
    "has clean function store" 0 result.store.count_functions test::assert_eq
}

pub fn test_parse_result_discards_nested_store_mutation {
    "parse_result_discards_nested_store_mutation" test::test_start
    "test" "[1] = items for item in items.iter do { 1 } . fi 42 done" lexer::lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "has diagnostic" result.diagnostics.has_errors test::assert_true
    "complete prefix remains available" result.ops.is_some test::assert_true
    "abandoned body publishes no functions" 0 result.store.count_functions test::assert_eq
}

pub fn test_full_import_namespaces_symbols_and_skips_top_level_ops {
    "full_import_namespaces_symbols_and_skips_top_level_ops" test::test_start
    lexer::SourceStore::new = sources
    "65536 = IMPORTED_SIZE pub fn imported_value -> i64 { 42 }" "/tmp/casa_import_success_258.casa" sources.add
    "root" "import \"/tmp/casa_import_success_258.casa\" as imported imported::imported_value" lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "full import has no diagnostics" result.diagnostics.has_errors ! test::assert_true
    "imported function committed" "__imported_value" result.store helpers::store_has_function_suffix test::assert_true
    "imported function stays resolved" "__imported_value" result.store helpers::store_function_suffix_is_resolved test::assert_true
    false = has_imported_assignment
    if result.ops std::Option::Some(imported_ops) is then
        for op in imported_ops.iter do
            if op.value common::OpValue::AssignVar(name) is then
                if name "IMPORTED_SIZE" == then
                    true = has_imported_assignment
                fi
            fi
        done
    else
        "has usable output" false test::assert_true
    fi
    "imported top-level op skipped" has_imported_assignment ! test::assert_true
}

pub fn test_import_cycle_reports_complete_path {
    "import_cycle_reports_complete_path" test::test_start
    lexer::SourceStore::new = sources
    "import \"/tmp/casa_cycle_b_332.casa\" as cycle_b"
    "/tmp/casa_cycle_a_332.casa"
    sources.add
    "import \"/tmp/casa_cycle_a_332.casa\" as cycle_a"
    "/tmp/casa_cycle_b_332.casa"
    sources.add
    "root"
    "import \"/tmp/casa_cycle_a_332.casa\" as cycle_a"
    lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "cycle has no usable output" result.ops.is_none test::assert_true
    "one cycle diagnostic" 1 result.diagnostics.error_count test::assert_eq
    0 result
        .diagnostics
        .entries
        .get = diagnostic
    if diagnostic error::Diagnostic::Error(import_error) is then
        "complete cycle path"
        "Module import cycle: /tmp/casa_cycle_a_332.casa -> /tmp/casa_cycle_b_332.casa -> /tmp/casa_cycle_a_332.casa"
        import_error.message
        test::assert_str_eq
    else
        "cycle diagnostic is error" false test::assert_true
    fi
}

pub fn test_diamond_import_roots_are_excluded {
    "diamond_import_roots_are_excluded" test::test_start
    lexer::SourceStore::new = sources
    "pub const BASE 40 \"imported root ran\" panic" "/tmp/casa_init_base_344.casa" sources.add
    "import \"/tmp/casa_init_base_344.casa\" as base pub const LEFT { base::BASE 1 + } \"imported root ran\" panic"
    "/tmp/casa_init_left_344.casa" sources.add
    "import \"/tmp/casa_init_base_344.casa\" as base pub const RIGHT { base::BASE 2 + } \"imported root ran\" panic"
    "/tmp/casa_init_right_344.casa" sources.add
    "root"
    "import \"/tmp/casa_init_left_344.casa\" as left import \"/tmp/casa_init_right_344.casa\" as right"
    lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "diamond import has no diagnostics" result.diagnostics.has_errors ! test::assert_true
    if result.ops std::Option::Some(ops) is then
        "imported roots do not enter root ops" 0 ops.length test::assert_eq
    else
        "imported root has usable output" false test::assert_true
    fi
}

pub fn test_repeated_alias_import_roots_are_excluded {
    "repeated_alias_import_roots_are_excluded" test::test_start
    lexer::SourceStore::new = sources
    "pub const VALUE 7 \"imported root ran\" panic" "/tmp/casa_init_alias_344.casa" sources.add
    "root"
    "import \"/tmp/casa_init_alias_344.casa\" as first import \"/tmp/casa_init_alias_344.casa\" as second first::VALUE second::VALUE + drop"
    lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "alias imports have no diagnostics" result.diagnostics.has_errors ! test::assert_true
    if result.ops std::Option::Some(ops) is then
        "only root expressions execute" 4 ops.length test::assert_eq
    else
        "alias import has usable output" false test::assert_true
    fi
}

pub fn test_failed_nested_import_discards_symbols_and_stops_resolution {
    "failed_nested_import_discards_symbols_and_stops_resolution" test::test_start
    lexer::SourceStore::new = sources
    "missing_imported" "/tmp/casa_nested_failure_258.casa" sources.add
    "pub fn leaked -> i64 { 1 } import \"/tmp/casa_nested_failure_258.casa\" as nested" "/tmp/casa_parent_failure_258.casa" sources.add
    "root" "fn root_symbol -> i64 { 2 } import \"/tmp/casa_parent_failure_258.casa\" as parent missing_root" lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "failed import has no usable output" result.ops.is_none test::assert_true
    "failed import leaves no symbols" 0 result.store.count_functions test::assert_eq
    "only imported error emitted" 1 result
        .diagnostics
        .entries
        .length test::assert_eq
    0 result
        .diagnostics
        .entries
        .get = diagnostic
    if diagnostic error::Diagnostic::Error(error) is then
        "imported error kept" "Identifier `missing_imported` is not defined" error.message test::assert_str_eq
    else
        "imported diagnostic is error" false test::assert_true
    fi
}

pub fn test_import_diagnostics_preserve_encounter_order {
    "import_diagnostics_preserve_encounter_order" test::test_start
    lexer::SourceStore::new = sources
    "first_missing second_missing" "/tmp/casa_import_order_258.casa" sources.add
    "root" "import \"/tmp/casa_import_order_258.casa\" as imported" lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "two diagnostics" 2 result
        .diagnostics
        .entries
        .length test::assert_eq
    if
        0 result
            .diagnostics
            .entries
            .get error::Diagnostic::Error(first_error) is
    then
        "first encounter" "Identifier `first_missing` is not defined" first_error.message test::assert_str_eq
    else
        "first diagnostic is error" false test::assert_true
    fi
    if
        1 result
            .diagnostics
            .entries
            .get error::Diagnostic::Error(second_error) is
    then
        "second encounter" "Identifier `second_missing` is not defined" second_error.message test::assert_str_eq
    else
        "second diagnostic is error" false test::assert_true
    fi
}

pub fn assert_import_failure imported_source:str root_source:str path:str message:$str {
    lexer::SourceStore::new = sources
    imported_source path sources.add
    "root" root_source lexer::lex_source = lex_result
    sources lex_result resolve_lex_result = result
    f"{message} has no output" result.ops.is_none test::assert_true
    f"{message} has one diagnostic" 1 result
        .diagnostics
        .entries
        .length test::assert_eq
}

pub fn test_full_import_failures_are_explicit {
    "full_import_failures_are_explicit" test::test_start
    "full lexical failure"
    "/tmp/casa_full_lexical_failure_258.casa"
    "import \"/tmp/casa_full_lexical_failure_258.casa\" as imported"
    "\"bad\\q\""
    assert_import_failure
    "full parser failure"
    "/tmp/casa_full_parser_failure_258.casa"
    "import \"/tmp/casa_full_parser_failure_258.casa\" as imported"
    "end 42"
    assert_import_failure
    "full resolution failure"
    "/tmp/casa_full_resolution_failure_258.casa"
    "import \"/tmp/casa_full_resolution_failure_258.casa\" as imported"
    "missing_imported"
    assert_import_failure
}

pub fn test_import_diagnostic_precedes_later_root_diagnostic {
    "import_diagnostic_precedes_later_root_diagnostic" test::test_start
    lexer::SourceStore::new = sources
