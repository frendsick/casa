fn test_parse_string_with_escapes {
    "parse_string_with_escapes" test_start
    "test" "\"hello\\nworld\"" lex_source = lex_result
    lex_result.tokens = tokens: $List[Token]
    tokens parser_test_parse = ops
    "count" 1 ops.length assert_eq
    "kind" 0 ops.get.value OpValue::PushStr is assert_true
    "value" "hello\nworld" 0 ops.get op_str_value assert_str_eq
}

fn test_parse_result_returns_ordered_diagnostics {
    "parse_result_returns_ordered_diagnostics" test_start
    "test" "missing" lex_source = lex_result
    empty_location "lexical first".to_str ErrorKind::Syntax CasaError::new lex_result.diagnostics.push_error
    lex_result resolve_test_lex_result = result
    result.diagnostics.entries = entries: $List[Diagnostic]
    "diagnostic count" 2 entries.length assert_eq
    0 entries.get = first
    entries.length 1 - entries.get = last
    if first Diagnostic::Error(first_error) is then
        "first diagnostic is lexical" "lexical first" first_error CasaError::message assert_str_eq
    else
        "first diagnostic is error" false assert_true
    fi
    if last Diagnostic::Error(last_error) is then
        "parser diagnostic follows" "Identifier `missing` is not defined" last_error CasaError::message assert_str_eq
    else
        "last diagnostic is error" false assert_true
    fi
}

fn test_parse_result_keeps_output_after_structural_recovery {
    "parse_result_keeps_output_after_structural_recovery" test_start
    "test" "end 42" lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "has diagnostic" result.diagnostics.has_errors assert_true
    "has usable output" result.ops.is_some assert_true
}

fn assert_structural_recovery source:str message:$str {
    "test" source lex_source = lex_result
    lex_result resolve_test_lex_result = result
    f"{message} diagnostic" result.diagnostics.has_errors assert_true
    f"{message} output" result.ops.is_some assert_true
    result.into_parts = diagnostics = store = result_ops
    diagnostics drop
    store drop
    result_ops.unwrap = ops
    f"{message} excludes failed ops" 1 ops.length assert_eq
    f"{message} resumed after delimiter" 42 ops.length 1 - ops.get op_int_value assert_eq
}

fn test_parse_result_recovers_at_supported_delimiters {
    "parse_result_recovers_at_supported_delimiters" test_start
    "close brace" ". } 42" assert_structural_recovery
    "fi" ". fi 42" assert_structural_recovery
    "done" ". done 42" assert_structural_recovery
    "end" ". end 42" assert_structural_recovery
    "top-level declaration" ". fn recovered { 1 } 42" assert_structural_recovery
}

fn test_parse_result_rejects_ambiguous_end_of_input {
    "parse_result_rejects_ambiguous_end_of_input" test_start
    "test" "fn foo {" lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "has diagnostic" result.diagnostics.has_errors assert_true
    "has no usable output" result.ops.is_none assert_true
}

fn test_parse_result_discards_failed_declaration_state {
    "parse_result_discards_failed_declaration_state" test_start
    "test" "fn 42 { 1 } 2" lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "has diagnostic" result.diagnostics.has_errors assert_true
    "has no usable output" result.ops.is_none assert_true
    "has clean function store" 0 result
        .store
        .functions
        .length assert_eq
}

fn test_parse_result_discards_nested_store_mutation {
    "parse_result_discards_nested_store_mutation" test_start
    "test" "[1] = items for item in items.iter do { 1 } . fi 42 done" lex_source = lex_result
    lex_result resolve_test_lex_result = result
    "has diagnostic" result.diagnostics.has_errors assert_true
    "has no usable output" result.ops.is_none assert_true
    "has clean function store" 0 result
        .store
        .functions
        .length assert_eq
}

fn test_full_import_merges_symbols_after_success {
    "full_import_merges_symbols_after_success" test_start
    SourceStore::new = sources
    "65536 = IMPORTED_SIZE fn imported_value -> i64 { 42 }" "/tmp/casa_import_success_258.casa" sources.add
    "root" "import \"/tmp/casa_import_success_258.casa\" imported_value" lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "no diagnostics" result.diagnostics.has_errors ! assert_true
    "imported function committed" "imported_value" result
        .store
        .functions
        .has_str assert_true
    false = has_imported_assignment
    if result.ops Option::Some(imported_ops) is then
        for op in imported_ops.iter do
            if op.value OpValue::AssignVar(name) is then
                if name "IMPORTED_SIZE" == then
                    true = has_imported_assignment
                fi
            fi
        done
    else
        "has usable output" false assert_true
    fi
    "imported global op committed" has_imported_assignment assert_true
}

fn test_selective_import_commits_only_selected_symbols {
    "selective_import_commits_only_selected_symbols" test_start
    SourceStore::new = sources
    "fn selected -> i64 { 1 } fn hidden -> i64 { 2 }" "/tmp/casa_selective_success_258.casa" sources.add
    "root" "import \"/tmp/casa_selective_success_258.casa\" { selected } selected" lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "no diagnostics" result.diagnostics.has_errors ! assert_true
    "selected function committed" "selected" result
        .store
        .functions
        .has_str assert_true
    "unselected function omitted" "hidden" result
        .store
        .functions
        .has_str ! assert_true
}

fn test_selective_import_reuses_module_analysis {
    "selective_import_reuses_module_analysis" test_start
    SourceStore::new = sources
    "fn first -> i64 { 1 } fn second -> i64 { 2 }" "/tmp/casa_selective_reuse_258.casa" sources.add
    "root" "import \"/tmp/casa_selective_reuse_258.casa\" { first } import \"/tmp/casa_selective_reuse_258.casa\" { second } first second" lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    sources lex_diagnostics symbol_store_new Parser::new = parser
    tokens parser parse_ops = ops
    Set[String]::new ops parser resolve_identifiers_global drop
    "no diagnostics" parser
        .state
        .diagnostics
        .has_errors ! assert_true
    "module analyzed once" 1 parser.selective_import_cache.length assert_eq
    "first symbol committed" "first" parser
        .store
        .functions
        .has_str assert_true
    "second symbol committed" "second" parser
        .store
        .functions
        .has_str assert_true

    SourceStore::new = mixed_sources
    "fn selected -> i64 { 1 } fn hidden -> i64 { 2 }" "/tmp/casa_selective_then_full_258.casa" mixed_sources.add
    "root" "import \"/tmp/casa_selective_then_full_258.casa\" { selected } import \"/tmp/casa_selective_then_full_258.casa\" hidden" lex_source = mixed_lex_result
    mixed_lex_result.into_parts = mixed_diagnostics = mixed_tokens
    mixed_sources mixed_diagnostics symbol_store_new Parser::new = mixed_parser
    mixed_tokens mixed_parser parse_ops = mixed_ops
    Set[String]::new mixed_ops mixed_parser resolve_identifiers_global drop
    "mixed import has no diagnostics" mixed_parser
        .state
        .diagnostics
        .has_errors ! assert_true
    "full import consumes cached analysis" 0 mixed_parser.selective_import_cache.length assert_eq
    "full import exposes hidden symbol" "hidden" mixed_parser
        .store
        .functions
        .has_str assert_true
}

fn test_failed_nested_import_discards_symbols_and_stops_resolution {
    "failed_nested_import_discards_symbols_and_stops_resolution" test_start
    SourceStore::new = sources
    "missing_imported" "/tmp/casa_nested_failure_258.casa" sources.add
    "fn leaked -> i64 { 1 } import \"/tmp/casa_nested_failure_258.casa\"" "/tmp/casa_parent_failure_258.casa" sources.add
    "root" "fn root_symbol -> i64 { 2 } import \"/tmp/casa_parent_failure_258.casa\" missing_root" lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "failed import has no usable output" result.ops.is_none assert_true
    "failed import leaves no symbols" 0 result
        .store
        .functions
        .length assert_eq
    "only imported error emitted" 1 result
        .diagnostics
        .entries
        .length assert_eq
    0 result
        .diagnostics
        .entries
        .get = diagnostic
    if diagnostic Diagnostic::Error(error) is then
        "imported error kept" "Identifier `missing_imported` is not defined" error.message assert_str_eq
    else
        "imported diagnostic is error" false assert_true
    fi
}

fn test_selective_import_failure_is_transactional {
    "selective_import_failure_is_transactional" test_start
    SourceStore::new = sources
    "fn selected -> i64 { 1 }" "/tmp/casa_selective_failure_258.casa" sources.add
    "root" "import \"/tmp/casa_selective_failure_258.casa\" { selected missing }" lex_source = lex_result
    sources lex_result resolve_lex_result = result
    "failed selective import has no usable output" result.ops.is_none assert_true
    "selected symbol was not partially committed" 0 result
        .store
        .functions
        .length assert_eq
}

fn test_import_diagnostics_preserve_encounter_order {
    "import_diagnostics_preserve_encounter_order" test_start
    SourceStore::new = sources
    "\"bad\\q\"" "/tmp/casa_import_order_258.casa" sources.add
    "root" "import \"/tmp/casa_import_order_258.casa\"" lex_source = lex_result
    empty_location "root first".to_str ErrorKind::Syntax CasaError::new lex_result.diagnostics.push_error
    sources lex_result resolve_lex_result = result
    "two diagnostics" 2 result
        .diagnostics
        .entries
        .length assert_eq
    0 result
        .diagnostics
        .entries
        .get = first
    1 result
        .diagnostics
        .entries
        .get = second
    if first Diagnostic::Error(first_error) is then
        "root diagnostic first" "root first" first_error.message assert_str_eq
    else
        "first diagnostic is error" false assert_true
    fi
    if second Diagnostic::Error(second_error) is then
        "import diagnostic second" "Invalid escape sequence" second_error.message assert_str_eq
    else
        "second diagnostic is error" false assert_true
    fi
}

fn assert_import_failure imported_source:str root_source:str path:str message:$str {
    SourceStore::new = sources
    imported_source path sources.add
    "root" root_source lex_source = lex_result
    sources lex_result resolve_lex_result = result
    f"{message} has no output" result.ops.is_none assert_true
    f"{message} has one diagnostic" 1 result
        .diagnostics
        .entries
        .length assert_eq
}

fn test_full_and_selective_import_failures_are_explicit {
    "full_and_selective_import_failures_are_explicit" test_start
    "full lexical failure"
    "/tmp/casa_full_lexical_failure_258.casa"
    "import \"/tmp/casa_full_lexical_failure_258.casa\""
    "\"bad\\q\""
    assert_import_failure
    "full parser failure"
    "/tmp/casa_full_parser_failure_258.casa"
    "import \"/tmp/casa_full_parser_failure_258.casa\""
    "end 42"
    assert_import_failure
    "full resolution failure"
    "/tmp/casa_full_resolution_failure_258.casa"
    "import \"/tmp/casa_full_resolution_failure_258.casa\""
    "missing_imported"
    assert_import_failure
    "selective lexical failure"
    "/tmp/casa_selective_lexical_failure_258.casa"
    "import \"/tmp/casa_selective_lexical_failure_258.casa\" { exported }"
    "\"bad\\q\""
    assert_import_failure
    "selective parser failure"
    "/tmp/casa_selective_parser_failure_258.casa"
    "import \"/tmp/casa_selective_parser_failure_258.casa\" { exported }"
    "end 42"
    assert_import_failure
    "selective resolution failure"
    "/tmp/casa_selective_resolution_failure_258.casa"
    "import \"/tmp/casa_selective_resolution_failure_258.casa\" { exported }"
    "fn exported { missing_imported }"
    assert_import_failure
}

fn test_import_diagnostic_precedes_later_root_diagnostic {
