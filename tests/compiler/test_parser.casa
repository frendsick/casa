import "../../compiler/common.casa"
import "../../compiler/error.casa"
import "../../compiler/lexer.casa"
import "../../compiler/syntax.casa"
import "../../lib/test.casa"

symbol_store_new = PARSER_TEST_STORE

fn resolve_lex_result lex_result:LexResult sources:mut$SourceStore -> ParseResolveResult {
    lex_result.into_parts = diagnostics = tokens
    sources diagnostics List[String]::new tokens parse_and_resolve
}

fn resolve_test_lex_result lex_result:LexResult -> ParseResolveResult {
    SourceStore::new = sources
    sources lex_result resolve_lex_result
}

fn parser_test_parse tokens:$List[Token] -> List[Op] {
    global PARSER_TEST_STORE
    SourceStore::new Diagnostics::new symbol_store_new Parser::new = parser
    tokens.clone parser parse_ops = ops
    parser.into_parts = state = included_files = store
    state drop
    included_files drop
    store = PARSER_TEST_STORE
    ops
}

# ============================================================================
# Literal parsing tests
# ============================================================================

fn test_parse_integer {
    "parse_integer" test_start
    "test" "42" lex_source = lex_result
    lex_result.tokens = tokens: $List[Token]
    tokens parser_test_parse = ops
    "count" 1 ops.length assert_eq
    "kind" 0 ops.get.value OpValue::PushInt is assert_true
    "value" 42 0 ops.get op_int_value assert_eq
}

fn test_parse_negative_integer {
    "parse_negative_integer" test_start
    "test" "-7" lex_source = lex_result
    lex_result.tokens = tokens: $List[Token]
    tokens parser_test_parse = ops
    "count" 1 ops.length assert_eq
    "kind" 0 ops.get.value OpValue::PushInt is assert_true
    "value" 0 7 - 0 ops.get op_int_value assert_eq
}

