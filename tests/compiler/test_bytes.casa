import "std" as std
import "../../lib/test.casa" as test

fn assert_memcpy_range
    source:$std::RawBuffer
    destination:mut$std::RawBuffer
    source_offset:u64
    destination_offset:u64
    count:u64
{
    unsafe {
        0 = index: u64
        while 80 index < do
            255 destination.data index + store8
            1 += index
        done
        count source.data source_offset + destination.data destination_offset + std::memcpy
        0 = index: u64
        while 80 index < do
            255 = expected: u64
            if destination_offset index >= destination_offset count + index < && then
                source_offset index destination_offset - + = expected
            fi
            "copied range and surrounding bytes" expected
            destination.data index + load8 u64::from test::assert_eq
            1 += index
        done
    }
}

pub fn test_memcpy_ranges {
    "memcpy_ranges" test::test_start
    80 std::RawBuffer::new = source
    80 std::RawBuffer::new = destination
    unsafe {
        0 ptr::null ptr::null std::memcpy
        0 = index: u64
        while 80 index < do
            index u8::try_from.unwrap source.data index + store8
            1 += index
        done
    }
    0 = source_offset: u64
    while 8 source_offset < do
        0 = destination_offset: u64
        while 8 destination_offset < do
            0 = count: u64
            while 65 count <= do
                count destination_offset source_offset destination source assert_memcpy_range
                1 += count
            done
            1 += destination_offset
        done
        1 += source_offset
    done
}

pub fn test_bytes_storage_and_mutation {
    "bytes_storage_and_mutation" test::test_start
    std::Bytes::new = bytes
    1 bytes.push
    2 bytes.push
    3 bytes.push
    "length" 3 bytes.length test::assert_eq
    "indexed read" 2 1 bytes.get.unwrap u64::from test::assert_eq
    "out-of-range read" 3 bytes.get.is_none test::assert_true
    std::Bytes::new = suffix
    4 suffix.push
    5 suffix.push
    suffix bytes.append
    "append length" 5 bytes.length test::assert_eq
    "append preserves source" 2 suffix.length test::assert_eq
    "append value" 5 4 bytes.get.unwrap u64::from test::assert_eq

    0 = sum: u64
    for byte in bytes.iter do
        byte u64::from += sum
    done
    "iteration copies bytes" 15 sum test::assert_eq

    bytes.clone = cloned
    6 cloned.push
    "clone is independent" 5 bytes.length test::assert_eq
    "clone can mutate" 6 cloned.length test::assert_eq

    6 bytes.push
    7 bytes.push
    8 bytes.push
    9 bytes.push
    "growth length" 9 bytes.length test::assert_eq
    "capacity grows" 9 bytes.capacity >= test::assert_true
    "growth preserves values" 9 8 bytes.get.unwrap u64::from test::assert_eq
}

pub fn test_bytes_construction_c_view_and_identity {
    "bytes_construction_c_view_and_identity" test::test_start
    "Hä" std::Bytes::from_str = text_bytes
    "from_str byte length" 3 text_bytes.length test::assert_eq
    "from_str copies UTF-8 bytes" 164 2 text_bytes.get.unwrap u64::from test::assert_eq
    "C view accepts bytes without NUL" text_bytes.as_cstr.is_some test::assert_true
    "C view preserves bytes" text_bytes text_bytes
        .as_cstr
        .unwrap
        .to_bytes == test::assert_true

    text_bytes.clone = same
    "equal bytes compare equal" same text_bytes == test::assert_true
    "equal bytes hash equally" same.hash text_bytes.hash == test::assert_true
    1 same.push
    "different bytes compare unequal" same text_bytes != test::assert_true

    std::Bytes::new = interior_nul
    65 interior_nul.push
    0 interior_nul.push
    66 interior_nul.push
    "C view rejects interior NUL" interior_nul.as_cstr.is_none test::assert_true

    std::List[std::Bytes]::new = values
    "copied" values.push_str
    "push_str appends bytes" "copied" std::Bytes::from_str 0 values.get == test::assert_true
}

pub fn test_bytes_raw_copy {
    "bytes_raw_copy" test::test_start
    std::Bytes::new = bytes
    bytes.to_raw_buffer drop
    0 = index: u64
    while 257 index < do
        index 256 % u8::try_from.unwrap bytes.push
        1 += index
    done
    bytes.to_raw_buffer = buffer
    bytes drop
    0 = index: u64
    while 257 index < do
        unsafe { buffer.data index + load8 } = byte
        "raw copy outlives source" index 256 % byte u64::from test::assert_eq
        1 += index
    done
}

pub fn test_bytes_utf8_conversion {
    "bytes_utf8_conversion" test::test_start
    std::Bytes::new = valid
    72 valid.push
    195 valid.push
    164 valid.push
    240 valid.push
    159 valid.push
    152 valid.push
    128 valid.push
    valid.to_str match
        std::Result::Ok(text) => {
            "valid UTF-8" "Hä😀" text.as_str test::assert_str_eq
        }
        std::Result::Error(_) => {
            "valid UTF-8 converts" false test::assert_true
        }
    end
    "conversion borrows source" 7 valid.length test::assert_eq

    std::Bytes::new = bad_continuation
    195 bad_continuation.push
    40 bad_continuation.push
    "invalid continuation" bad_continuation.to_str.is_error test::assert_true

    std::Bytes::new = overlong
    192 overlong.push
    175 overlong.push
    "overlong encoding" overlong.to_str.is_error test::assert_true

    std::Bytes::new = surrogate
    237 surrogate.push
    160 surrogate.push
    128 surrogate.push
    "surrogate encoding" surrogate.to_str.is_error test::assert_true

    std::Bytes::new = out_of_range
    244 out_of_range.push
    144 out_of_range.push
    128 out_of_range.push
    128 out_of_range.push
    "out-of-range scalar" out_of_range.to_str.is_error test::assert_true

    std::Bytes::new = truncated
    240 truncated.push
    159 truncated.push
    "truncated encoding" truncated.to_str.is_error test::assert_true

    0 = prefix_length: u64
    while 17 prefix_length <= do
        "abcdefghijklmnopq" 0 prefix_length str::substring = prefix
        prefix.as_str std::Bytes::from_str = boundary
        195 boundary.push
        164 boundary.push
        "Unicode across word boundary" boundary.to_str.is_ok test::assert_true
        255 boundary.push
        boundary.to_str match
            std::Result::Error(error) => {
                "invalid byte after word boundary" prefix_length 2 + error.index test::assert_eq
            }
            std::Result::Ok(_) => "invalid byte rejected" false test::assert_true
        end
        1 += prefix_length
    done
}

pub fn test_process_args_are_bytes {
    "process_args_are_bytes" test::test_start
    std::process::args = arguments
    "argument count" argc arguments.length test::assert_eq
    "program name is valid test text" 0 arguments
        .get
        .to_str
        .is_ok test::assert_true
}

pub fn test_run_command_forwards_non_utf8_argument {
    "run_command_forwards_non_utf8_argument" test::test_start
    std::List[std::Bytes]::new = command
    "/usr/bin/test" command.push_str
    std::Bytes::new = non_utf8
    255 non_utf8.push
    non_utf8.clone command.push
    "=" command.push_str
    non_utf8 command.push
    "non-UTF-8 process argument" 0 command std::run_command test::assert_eq
}
test_memcpy_ranges
test_bytes_storage_and_mutation
test_bytes_construction_c_view_and_identity
test_bytes_raw_copy
test_bytes_utf8_conversion
test_process_args_are_bytes
test_run_command_forwards_non_utf8_argument
test::test_summary
