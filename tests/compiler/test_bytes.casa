import "std"
import "../../lib/test.casa"

fn test_bytes_storage_and_mutation {
    "bytes_storage_and_mutation" test_start
    Bytes::new = bytes
    1 bytes.push
    2 bytes.push
    3 bytes.push
    "length" 3 bytes.length assert_eq
    "indexed read" 2 (u64) 1 bytes.get.unwrap (u64) assert_eq
    "out-of-range read" 3 bytes.get.is_none assert_true
    "byte-dense storage" 2 (u64) unsafe { bytes.data 1 + load8 } (u64) assert_eq

    Bytes::new = suffix
    4 suffix.push
    5 suffix.push
    suffix bytes.append
    "append length" 5 bytes.length assert_eq
    "append preserves source" 2 suffix.length assert_eq
    "append value" 5 (u64) 4 bytes.get.unwrap (u64) assert_eq

    0 (u64) = sum
    for byte in bytes.iter do
        byte (u64) += sum
    done
    "iteration copies bytes" 15 (u64) sum assert_eq

    bytes.clone = cloned
    6 cloned.push
    "clone is independent" 5 bytes.length assert_eq
    "clone can mutate" 6 cloned.length assert_eq

    6 bytes.push
    7 bytes.push
    8 bytes.push
    9 bytes.push
    "growth length" 9 bytes.length assert_eq
    "capacity grows" 9 bytes.capacity >= assert_true
    "growth preserves values" 9 (u64) 8 bytes.get.unwrap (u64) assert_eq
}

fn test_bytes_utf8_conversion {
    "bytes_utf8_conversion" test_start
    Bytes::new = valid
    72 valid.push
    195 valid.push
    164 valid.push
    240 valid.push
    159 valid.push
    152 valid.push
    128 valid.push
    valid.to_str match
        Result::Ok(text) => {
            "valid UTF-8" "Hä😀" text.as_str assert_str_eq
        }
        Result::Error(_) => {
            "valid UTF-8 converts" false assert_true
        }
    end
    "conversion borrows source" 7 valid.length assert_eq

    Bytes::new = bad_continuation
    195 bad_continuation.push
    40 bad_continuation.push
    "invalid continuation" bad_continuation.to_str.is_error assert_true

    Bytes::new = overlong
    192 overlong.push
    175 overlong.push
    "overlong encoding" overlong.to_str.is_error assert_true

    Bytes::new = surrogate
    237 surrogate.push
    160 surrogate.push
    128 surrogate.push
    "surrogate encoding" surrogate.to_str.is_error assert_true

    Bytes::new = out_of_range
    244 out_of_range.push
    144 out_of_range.push
    128 out_of_range.push
    128 out_of_range.push
    "out-of-range scalar" out_of_range.to_str.is_error assert_true

    Bytes::new = truncated
    240 truncated.push
    159 truncated.push
    "truncated encoding" truncated.to_str.is_error assert_true
}
test_bytes_storage_and_mutation
test_bytes_utf8_conversion
test_summary
