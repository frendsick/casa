import "std"
import "../../lib/test.casa"

struct Tracked {
    drops: ptr
}

impl Tracked {
    fn drop self:mut$Tracked {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

enum Flow {
    Stop (Tracked)
    Continue (Tracked)
}

impl Flow {
    fn is_ok self:$Flow -> bool {
        unsafe { self (ptr) load64 1 == }
    }

    fn unwrap self:mut$Flow -> Tracked {
        if self.is_ok ! then
            "unexpected Stop\n" eprint
            1 exit
        fi
        unsafe { self (ptr) 8 + load64 (Tracked) }
    }

    fn propagate self:mut$Flow -> Flow {
        unsafe { self (ptr) 8 + load64 (Tracked) Flow::Stop }
    }
}

fn continue_tracked value:Tracked -> Flow { value Flow::Continue ? Flow::Continue }

fn stop_tracked value:Tracked fallback:Tracked -> Flow {
    value Flow::Stop ? drop fallback Flow::Continue
}

fn destroy_continued drops:ptr { drops Tracked continue_tracked drop }

fn destroy_stopped drops:ptr { drops Tracked drops Tracked stop_tracked drop }

unsafe { 8 alloc = drops }
unsafe { 0 drops store64 }
drops destroy_continued
unsafe { "custom success payload is destroyed once" 1 drops load64 assert_eq }
drops destroy_stopped
unsafe { "custom failure and unused owner are destroyed once" 3 drops load64 assert_eq }
unsafe { drops free }
