import "std" as std
import "../../lib/test.casa" as test

pub struct Tracked {
    pub drops: ptr
}

impl Tracked {
    pub fn drop self:mut$Tracked {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

pub fn keep_tracked value:Tracked -> Tracked { value }

pub fn accept_tracked value:$Tracked -> bool { true }

pub fn reject_tracked value:$Tracked -> bool { false }

pub fn some_tracked value:Tracked -> std::Option[Tracked] { value std::Option::Some }

pub fn ok_tracked value:Tracked -> std::Result[Tracked Tracked] { value std::Result::Ok }

pub fn destroy_extracted drops:ptr {
    drops Tracked std::Option::Some = option
    "Option observers keep the owner available" option.is_some option.is_none ! && option.is_ok && test::assert_true
    option.unwrap drop

    drops Tracked std::Result::Ok = success: std::Result[Tracked Tracked]
    "Result observers keep the owner available" success.is_ok success.is_error ! && test::assert_true
    success.unwrap drop

    drops Tracked std::Result::Error = failure: std::Result[Tracked Tracked]
    failure.unwrap_error drop
}

pub fn destroy_fallbacks drops:ptr {
    drops Tracked = option_default
    drops Tracked std::Option::Some = option
    option_default option.unwrap_or drop

    { drops Tracked std::Option::Some } std::Option[Tracked]::None.or_else.unwrap drop

    drops Tracked = result_default
    drops Tracked std::Result::Error = failure: std::Result[Tracked Tracked]
    result_default failure.unwrap_or drop
}

pub fn destroy_mapped drops:ptr {
    &keep_tracked drops Tracked std::Option::Some.map.unwrap drop

    drops Tracked std::Result::Ok = success: std::Result[Tracked Tracked]
    &keep_tracked success.map.unwrap drop

    drops Tracked std::Result::Error = failure: std::Result[Tracked Tracked]
    &keep_tracked failure.map_error.unwrap_error drop
}

pub fn destroy_filtered drops:ptr {
    &accept_tracked drops Tracked std::Option::Some.filter.unwrap drop
    &reject_tracked drops Tracked std::Option::Some.filter drop
}

pub fn destroy_chained_and_recovered drops:ptr {
    &some_tracked drops Tracked std::Option::Some.and_then.unwrap drop

    drops Tracked std::Result::Ok = success: std::Result[Tracked Tracked]
    &ok_tracked success.and_then.unwrap drop

    drops Tracked std::Result::Error = failure: std::Result[Tracked Tracked]
    &ok_tracked failure.or_else.unwrap drop
}

pub enum Flow {
    Stop (Tracked)
    Continue (Tracked)
}

impl Flow {
    pub fn is_ok self:$Flow -> bool {
        unsafe { self ptr::from_ref load64 1 == }
    }

    pub fn unwrap self:mut$Flow -> Tracked {
        if self.is_ok ! then
            "unexpected Stop\n" std::eprint
            1 process::exit
        fi
        unsafe { self ptr::from_ref 8 + ptr::read[ptr] ptr::from_raw[Tracked] }
    }

    pub fn propagate self:mut$Flow -> Flow {
        unsafe { self ptr::from_ref 8 + ptr::read[ptr] ptr::from_raw[Tracked] Flow::Stop }
    }
}

pub fn continue_tracked value:Tracked -> Flow { value Flow::Continue ? Flow::Continue }

pub fn stop_tracked value:Tracked fallback:Tracked -> Flow {
    value Flow::Stop ? drop fallback Flow::Continue
}

pub fn destroy_continued drops:ptr { drops Tracked continue_tracked drop }

pub fn destroy_stopped drops:ptr { drops Tracked drops Tracked stop_tracked drop }

unsafe { 8 alloc = drops }
unsafe { 0 drops store64 }
drops destroy_continued
unsafe { "custom success payload is destroyed once" 1 drops load64 test::assert_eq }
drops destroy_stopped
unsafe { "custom failure and unused owner are destroyed once" 3 drops load64 test::assert_eq }
unsafe { 0 drops store64 }
drops destroy_extracted
unsafe { "extracted payloads are destroyed once" 3 drops load64 test::assert_eq }
unsafe { 0 drops store64 }
drops destroy_fallbacks
unsafe { "fallback payloads are destroyed once" 5 drops load64 test::assert_eq }
unsafe { 0 drops store64 }
drops destroy_mapped
unsafe { "mapped payloads are destroyed once" 3 drops load64 test::assert_eq }
unsafe { 0 drops store64 }
drops destroy_filtered
unsafe { "filtered payloads are destroyed once" 2 drops load64 test::assert_eq }
unsafe { 0 drops store64 }
drops destroy_chained_and_recovered
unsafe { "chained and recovered payloads are destroyed once" 3 drops load64 test::assert_eq }
unsafe { drops free }
