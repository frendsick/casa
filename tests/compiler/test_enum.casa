pub fn test_match_exhaustive_passes {
    error::Diagnostics::new = diagnostics
    "match_exhaustive_passes" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Color::Red => 1\n    Color::Green => 2\n    Color::Blue => 3\nend\ndrop\n" tc_enum_parts = store = effect
    "passes" true test::assert_true
}

pub fn test_match_as_expression {
    error::Diagnostics::new = diagnostics
    "match_as_expression" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Color::Red => 10\n    Color::Green => 20\n    Color::Blue => 30\nend\n" tc_enum = sig
    "returns i64" "i64" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_match_as_expression_str {
    error::Diagnostics::new = diagnostics
    "match_as_expression_str" test::test_start
