# ============================================================================
# Identifier resolution
# ============================================================================

pub fn test_resolve_enum_variant {
    error::Diagnostics::new = diagnostics
    "resolve_enum_variant" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red" resolve_enum = ops
    "has variant op" 0 &is_push_enum_variant ops count_ops != test::assert_true
}

pub fn test_resolve_enum_variant_ordinal_first {
    error::Diagnostics::new = diagnostics
    "resolve_enum_variant_ordinal_first" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red" resolve_enum = ops
    0 = index: u64
    while index ops.length > do
        if index ops.get.value common::OpValue::PushEnumVariant(variant) is then
            "ordinal 0" 0 variant common::EnumVariant::ordinal.clone.unwrap test::assert_eq
            "enum name" "Color" variant common::EnumVariant::enum_name test::assert_str_eq
            "variant name" "Red" variant common::EnumVariant::variant_name test::assert_str_eq
        fi
        1 += index
    done
}

pub fn test_resolve_enum_variant_ordinal_second {
    error::Diagnostics::new = diagnostics
    "resolve_enum_variant_ordinal_second" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Green" resolve_enum = ops
    0 = index: u64
    while index ops.length > do
        if index ops.get.value common::OpValue::PushEnumVariant(variant) is then
            "ordinal 1" 1 variant common::EnumVariant::ordinal.clone.unwrap test::assert_eq
            "variant name" "Green" variant common::EnumVariant::variant_name test::assert_str_eq
        fi
        1 += index
    done
}

pub fn test_resolve_enum_variant_ordinal_third {
    error::Diagnostics::new = diagnostics
    "resolve_enum_variant_ordinal_third" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Blue" resolve_enum = ops
    0 = index: u64
    while index ops.length > do
        if index ops.get.value common::OpValue::PushEnumVariant(variant) is then
            "ordinal 2" 2 variant common::EnumVariant::ordinal.clone.unwrap test::assert_eq
            "variant name" "Blue" variant common::EnumVariant::variant_name test::assert_str_eq
        fi
        1 += index
    done
}

pub fn test_resolve_multiple_variants {
    error::Diagnostics::new = diagnostics
    "resolve_multiple_variants" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red Color::Green Color::Blue\n" resolve_enum = ops
    "three variants" 3 &is_push_enum_variant ops count_ops == test::assert_true
}

pub fn test_resolve_undefined_enum_raises {
    error::Diagnostics::new = diagnostics
    "resolve_undefined_enum_raises" test::test_start
