pub fn test_borrowed_match_exhaustiveness {
    error::Diagnostics::new = shared_enum_diagnostics
    "borrowed_match_exhaustiveness" test::test_start
    shared_enum_diagnostics "enum Color { Red Green Blue }\nfn match_color color:$Color {\n    color match\n        Color::Red => 1 drop\n        Color::Green => 2 drop\n    end\n}\n" typecheck_enum_source
    shared_enum_diagnostics "shared enum" "Non-exhaustive match" helpers::assert_error_contains

    error::Diagnostics::new = exclusive_enum_diagnostics
    exclusive_enum_diagnostics "enum Color { Red Green Blue }\nfn match_color color:mut$Color {\n    color match\n        Color::Red => 1 drop\n        Color::Green => 2 drop\n    end\n}\n" typecheck_enum_source
    exclusive_enum_diagnostics "exclusive enum" "Non-exhaustive match" helpers::assert_error_contains

    error::Diagnostics::new = struct_diagnostics
    struct_diagnostics "struct Point { x: i64 }\nfn match_point point:$Point {\n    point match\n        true => 1 drop\n    end\n}\n" typecheck_enum_source
    struct_diagnostics "shared struct" "Non-exhaustive match on struct `Point`" helpers::assert_error_contains

    error::Diagnostics::new = literal_diagnostics
    literal_diagnostics "fn match_bool value:$bool {\n    value match\n        true => 1 drop\n    end\n}\n" typecheck_enum_source
    literal_diagnostics "shared bool" "Non-exhaustive match on `bool`" helpers::assert_error_contains

    error::Diagnostics::new = exhaustive_diagnostics
    exhaustive_diagnostics "enum Color { Red Green Blue }\nfn match_color color:$Color {\n    color match\n        Color::Red => 1 drop\n        Color::Green => 2 drop\n        Color::Blue => 3 drop\n    end\n}\n" typecheck_enum_source
    exhaustive_diagnostics "exhaustive borrowed enum" helpers::assert_no_errors
}

