    "returns Color" "Color" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_enum_print {
    error::Diagnostics::new = diagnostics
    "enum_print" test::test_start
    diagnostics "trait __casa_std__Display { fn to_str self:self -> __casa_std__String }\nenum Color { Red Green Blue }\nimpl Color { fn to_str c:Color -> __casa_std__String { \"red\" } }\nColor::Red print" tc_enum = sig
    "no returns" 0 sig common::StackEffect::return_types.length test::assert_eq
}

