pub fn test_match_destructuring_binding_types {
    error::Diagnostics::new = diagnostics
    "match_destructuring_binding_types" test::test_start
    diagnostics "enum Option[T] { None Some(T) }\n42 Option::Some match\n    Option::Some(value) => value\n    Option::None => 0\nend\n" tc_enum = sig
    "returns i64 structurally" common::make_i64_type 0 sig common::StackEffect::return_types.get.eq test::assert_true
