pub fn test_match_nested_generic_binding_type {
    error::Diagnostics::new = diagnostics
    "match_nested_generic_binding_type" test::test_start
    diagnostics "enum Box[T] { Value(List[T]) }\nfn unwrap box:Box[i64] -> List[i64] {\n    box match\n        Box::Value(value) => value\n    end\n}\n" tc_enum_parts = store = effect
    diagnostics "nested payload typechecks" helpers::assert_no_errors
    "unwrap" store.get_function.unwrap = unwrap_function
    std::List[common::Type]::new = list_params
    common::make_i64_type.clone list_params.push
    list_params "List".to_str common::GenericType common::Type::Generic = expected
    "returns List[i64] structurally" expected 0 unwrap_function
        .stack_effect
        .return_types
        .get
        .eq test::assert_true
}

