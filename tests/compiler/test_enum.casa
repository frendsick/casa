    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_wildcard_only_match {
    error::Diagnostics::new = diagnostics
    "wildcard_only_match" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    _ => 42\nend\n" tc_enum = sig
    "returns i64 structurally" common::make_i64_type 0 sig common::StackEffect::return_types.get.eq test::assert_true
}

