    "Result" store
        .enums
        .get_str
        .unwrap = result
    "type var count" 2 result common::CasaEnum::type_vars.length test::assert_eq
    "type var T" "T" 0 result common::CasaEnum::type_vars.get test::assert_str_eq
    "type var E" "E" 1 result common::CasaEnum::type_vars.get test::assert_str_eq
}

