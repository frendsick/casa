import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "../../compiler/bytecode.casa" as bytecode
import "../../compiler/emitter.casa" as emitter
import "helpers.casa" as helpers

# ============================================================================
# Constants
# ============================================================================
const COLOR_ENUM "enum Color { Red Green Blue }\n"
const DIRECTION_ENUM "enum Direction { North South East West }\n"
const SHAPE_ENUM "enum Shape { Circle(i64) Rectangle(i64 i64) Point }\n"
const OPTION_ENUM "enum Option[T] { None Some(T) }\n"
const RESULT_ENUM "enum Result[T E] { Error(E) Ok(T) }\n"
const EQ_TRAITS "trait __casa_std__PartialEq { fn eq self:$self other:$self -> bool fn ne self:$self other:$self -> bool { other self.eq ! } }\ntrait __casa_std__Eq: __casa_std__PartialEq { }\n"

# ============================================================================
# Helpers
# ============================================================================

pub fn test_parse_code_parts
    code:$str
    diagnostics:mut$error::Diagnostics
-> std::List[common::Op] common::SymbolStore {
    diagnostics code helpers::parse_resolve_test_parts
}

pub fn test_parse_code code:$str diagnostics:mut$error::Diagnostics -> std::List[common::Op] {
    diagnostics code test_parse_code_parts = store = ops
    store drop
    ops
}

pub fn resolve_enum_parts
    code:$str
    diagnostics:mut$error::Diagnostics
-> std::List[common::Op] common::SymbolStore {
    diagnostics code helpers::parse_resolve_test_parts
}

pub fn resolve_enum code:$str diagnostics:mut$error::Diagnostics -> std::List[common::Op] {
    diagnostics code resolve_enum_parts = store = ops
    store drop
    ops
}

pub fn tc_enum_parts
    code:$str
    diagnostics:mut$error::Diagnostics
-> common::StackEffect common::SymbolStore {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops typechecker::check_ops = effect
    effect
    store
}

pub fn tc_enum code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code tc_enum_parts = store = effect
    store drop
    effect
}

pub fn typecheck_enum_source code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::typecheck_test_source = checked
    checked.diagnostics.clone diagnostics.merge
}

pub fn compile_enum code:$str diagnostics:mut$error::Diagnostics -> common::Program {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops typechecker::check_ops drop
    store ops helpers::compile_test_program
}

pub fn is_push_enum_variant value:$common::OpValue -> bool {
    value common::OpValue::PushEnumVariant is
}

pub fn is_match_start value:$common::OpValue -> bool { value common::OpValue::MatchStart is }

pub fn is_match_arm value:$common::OpValue -> bool { value common::OpValue::MatchArm is }

pub fn is_match_end value:$common::OpValue -> bool { value common::OpValue::MatchEnd is }

pub fn count_ops ops:$std::List[common::Op] predicate:fn[$common::OpValue -> bool] -> i64 {
    0 = count
    for cop in ops.iter do
        if cop.value predicate exec then
            1 += count
        fi
    done
    count
}

pub fn count_insts
    bytecode:$std::List[common::InstValue]
    predicate:fn[$common::InstValue
-> bool] -> i64 {
    0 = count
    0 = index: u64
    while index bytecode.length > do
        if index bytecode.get predicate exec then
            1 += count
        fi
        1 += index
    done
    count
}

pub fn has_inst_kind
    bytecode:$std::List[common::InstValue]
    predicate:fn[$common::InstValue
-> bool] -> bool {
    0 predicate bytecode count_insts !=
}

pub fn is_dup_inst value:$common::InstValue -> bool { value common::InstValue::Dup is }

pub fn is_eq_inst value:$common::InstValue -> bool { value common::InstValue::Eq is }

pub fn is_jump_ne_inst value:$common::InstValue -> bool { value common::InstValue::JumpNe is }

pub fn is_print_int_inst value:$common::InstValue -> bool { value common::InstValue::PrintInt is }

pub fn matches_print_string_instruction value:$common::InstValue -> bool {
    value common::InstValue::PrintString is
}

pub fn is_heap_alloc_inst value:$common::InstValue -> bool { value common::InstValue::HeapAlloc is }

pub fn is_store64_inst value:$common::InstValue -> bool { value common::InstValue::Store64 is }

pub fn is_load64_inst value:$common::InstValue -> bool { value common::InstValue::Load64 is }

pub fn has_push_value bytecode:$std::List[common::InstValue] value:i64 -> bool {
    false = found
    0 = index: u64
    while index bytecode.length > do
        if
            index bytecode.get common::InstValue::Push(push_value) is
            value push_value == &&
        then
            true = found
        fi
        1 += index
    done
    found
}

# ============================================================================
# Enum declaration parsing
# ============================================================================

pub fn test_test_parse_code_registers_globally {
    error::Diagnostics::new = diagnostics
    "test_parse_code_registers_globally" test::test_start
    diagnostics "enum Color { Red Green Blue }" test_parse_code_parts = store = ops
    "registered" "Color" store
        .enums
        .get_str
        .is_some test::assert_true
}

pub fn test_test_parse_code_name {
    error::Diagnostics::new = diagnostics
    "test_parse_code_name" test::test_start
    diagnostics "enum Color { Red Green Blue }" test_parse_code_parts = store = ops
    "name" "Color" "Color" store
        .enums
        .get_str
        .unwrap common::CasaEnum::name test::assert_str_eq
}

pub fn test_test_parse_code_variant_count {
    error::Diagnostics::new = diagnostics
    "test_parse_code_variant_count" test::test_start
    diagnostics "enum Color { Red Green Blue }" test_parse_code_parts = store = ops
    "count" 3 "Color" store
        .enums
        .get_str
        .unwrap common::CasaEnum::variants.length test::assert_eq
}

pub fn test_test_parse_code_variant_names {
    error::Diagnostics::new = diagnostics
    "test_parse_code_variant_names" test::test_start
    diagnostics "enum Color { Red Green Blue }" test_parse_code_parts = store = ops
    "Color" store
        .enums
        .get_str
        .unwrap = color
    "Red" "Red" 0 color common::CasaEnum::variants.get test::assert_str_eq
    "Green" "Green" 1 color common::CasaEnum::variants.get test::assert_str_eq
    "Blue" "Blue" 2 color common::CasaEnum::variants.get test::assert_str_eq
}

pub fn test_test_parse_code_has_location {
    error::Diagnostics::new = diagnostics
    "test_parse_code_has_location" test::test_start
    diagnostics "enum Color { Red Green Blue }" test_parse_code_parts = store = ops
    "has file" "" "Color" store
        .enums
        .get_str
        .unwrap common::CasaEnum::location common::Location::file != test::assert_true
}

pub fn test_test_parse_code_single_variant {
    error::Diagnostics::new = diagnostics
    "test_parse_code_single_variant" test::test_start
    diagnostics "enum Unit { Only }" test_parse_code_parts = store = ops
    "count" 1 "Unit" store
        .enums
        .get_str
        .unwrap common::CasaEnum::variants.length test::assert_eq
    "name" "Only" 0 "Unit" store
        .enums
        .get_str
        .unwrap common::CasaEnum::variants.get test::assert_str_eq
}

pub fn test_test_parse_code_many_variants {
    error::Diagnostics::new = diagnostics
    "test_parse_code_many_variants" test::test_start
    diagnostics "enum Direction { North South East West }" test_parse_code_parts = store = ops
    "count" 4 "Direction" store
        .enums
