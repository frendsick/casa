pub fn test_test_parse_code_with_inner_types {
    error::Diagnostics::new = diagnostics
    "test_parse_code_with_inner_types" test::test_start
    diagnostics SHAPE_ENUM test_parse_code_parts = store = ops
    "Shape" store
        .enums
        .get_str
        .unwrap = shape
    "Circle types" 1 "Circle" shape common::CasaEnum::variant_types
        .get_str
        .unwrap
        .length test::assert_eq
    "Circle type" "i64" 0 "Circle" shape common::CasaEnum::variant_types
        .get_str
        .unwrap
        .get
        .format test::assert_str_eq
    "Rectangle types" 2 "Rectangle" shape common::CasaEnum::variant_types
        .get_str
        .unwrap
        .length test::assert_eq
    "Point types" 0 "Point" shape common::CasaEnum::variant_types
        .get_str
        .unwrap
        .length test::assert_eq
}

