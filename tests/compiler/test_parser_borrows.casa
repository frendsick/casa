import "std" as std
import "../../lib/parser.casa" as parser
import "../../lib/test.casa" as test

pub fn observe_cursor cursor:$parser::Cursor -> bool {
    cursor.is_eof !
    "abc" cursor.starts_with &&
}

pub fn consume_text cursor:mut$parser::Cursor text:$str -> bool { text cursor.take_string.is_ok }

pub fn parse_shared_text text:$str -> i64 { text parser::str_to_int }

pub fn test_shared_cursor_observations {
    "shared_cursor_observations" test::test_start
    "abc" parser::Cursor::new = cursor
    "shared cursor observations" cursor observe_cursor test::assert_true
    "shared peek" cursor.peek.is_some test::assert_true
    "peek at offset" 2 cursor.peek_at.is_some test::assert_true
    "save reads position" 0 cursor.save test::assert_eq
    "shared string parameter" "abc" cursor consume_text test::assert_true
    "shared string helper" 42 "42" parse_shared_text test::assert_eq
}
test_shared_cursor_observations
"parse_int accepts full range and leaves suffix" test::test_start
"-9223372036854775808!" parser::Cursor::new = minimum_cursor
"minimum" -9223372036854775808 minimum_cursor parser::parse_int.unwrap test::assert_eq
"suffix" '!' minimum_cursor.peek.unwrap test::assert_eq
"9223372036854775807" parser::Cursor::new = maximum_cursor
"maximum" 9223372036854775807 maximum_cursor parser::parse_int.unwrap test::assert_eq
"at EOF" maximum_cursor.is_eof test::assert_true
"parse_int restores position on failure" test::test_start
for
    token in ["9223372036854775808", "-9223372036854775809", "18446744073709551616", "-", ""].iter
do
    f"x{token}" = source
    source.as_str parser::Cursor::new = cursor
    1 cursor.skip
    cursor parser::parse_int = result
    "failure" result.is_error test::assert_true
    "position restored" 1 cursor.save test::assert_eq
    "error position" 1 result.unwrap_error.pos test::assert_eq
done
test::test_summary
