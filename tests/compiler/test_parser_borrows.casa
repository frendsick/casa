import "std" as std
import "../../lib/parser.casa" as parser
import "../../lib/test.casa" as test

pub fn observe_cursor cursor:$parser::Cursor -> bool {
    cursor.is_eof !
    "abc" cursor.starts_with &&
}

pub fn consume_text cursor:mut$parser::Cursor text:$str -> bool { text cursor.take_string.is_ok }

pub fn parse_shared_text text:$str -> i64 { text parser::str_to_int }

pub fn test_shared_cursor_observations {
    "shared_cursor_observations" test::test_start
    "abc" parser::Cursor::new = cursor
    "shared cursor observations" cursor observe_cursor test::assert_true
    "shared peek" cursor.peek.is_some test::assert_true
    "peek at offset" 2 cursor.peek_at.is_some test::assert_true
    "save reads position" 0 cursor.save test::assert_eq
    "shared string parameter" "abc" cursor consume_text test::assert_true
    "shared string helper" 42 "42" parse_shared_text test::assert_eq
}
test_shared_cursor_observations
"cursor lookups beyond EOF" test::test_start
"abc" parser::Cursor::new = end_cursor
1 end_cursor.skip
"large relative offset is absent" 18446744073709551615 end_cursor.peek_at.is_none test::assert_true
4 end_cursor.restore
"past end is EOF" end_cursor.is_eof test::assert_true
"past end has no prefix" "" end_cursor.starts_with ! test::assert_true
"past end has no character" 0 end_cursor.peek_at.is_none test::assert_true
"past end takes empty text" "" &char::is_alpha end_cursor.take_while.as_str test::assert_str_eq
3 end_cursor.restore
"empty prefix matches at EOF" "" end_cursor.starts_with test::assert_true
"parse_int accepts full range and leaves suffix" test::test_start
"-9223372036854775808!" parser::Cursor::new = minimum_cursor
"minimum" -9223372036854775808 minimum_cursor parser::parse_int.unwrap test::assert_eq
"suffix" '!' minimum_cursor.peek.unwrap test::assert_eq
"9223372036854775807" parser::Cursor::new = maximum_cursor
"maximum" 9223372036854775807 maximum_cursor parser::parse_int.unwrap test::assert_eq
"at EOF" maximum_cursor.is_eof test::assert_true
"parse_int restores position on failure" test::test_start
for
    token in ["9223372036854775808", "-9223372036854775809", "18446744073709551616", "-", ""].iter
do
    f"x{token}" = source
    source.as_str parser::Cursor::new = cursor
    1 cursor.skip
    cursor parser::parse_int = result
    "failure" result.is_error test::assert_true
    "position restored" 1 cursor.save test::assert_eq
    "error position" 1 result.unwrap_error.pos test::assert_eq
done

pub fn assert_literal_failure
    source:$str
    parse:fn[mut$parser::Cursor -> std::Result[std::String parser::ParseError]]
    expected_message:$str
    expected_position:u64
{
    source parser::Cursor::new = cursor
    1 cursor.skip
    cursor parse exec.unwrap_error = error
    "literal rollback" 1 cursor.pos test::assert_eq
    "literal error position" expected_position error.pos test::assert_eq
    "literal error message" expected_message error.message test::assert_str_eq
}

pub fn parse_character cursor:mut$parser::Cursor -> std::Result[std::String parser::ParseError] {
    { = character std::String::new = text character text.push text } cursor parser::parse_char_literal.map
}
1 "unexpected character" &parser::parse_quoted_string "x?" assert_literal_failure
1 "unterminated string" &parser::parse_quoted_string "x\"abc" assert_literal_failure
4 "unknown escape sequence" &parser::parse_quoted_string "x\"\\q\"" assert_literal_failure
3 "unexpected EOF in escape" &parser::parse_quoted_string "x\"\\" assert_literal_failure
1 "unexpected character" &parse_character "x?" assert_literal_failure
1 "unterminated char literal" &parse_character "x'" assert_literal_failure
3 "unexpected EOF" &parse_character "x'a" assert_literal_failure
4 "unknown escape sequence" &parse_character "x'\\q'" assert_literal_failure
"x\"a\\nb\"!" parser::Cursor::new = quoted_cursor
1 quoted_cursor.skip
"quoted string contents" "a\nb" quoted_cursor parser::parse_quoted_string.unwrap.as_str test::assert_str_eq
"quoted suffix" '!' quoted_cursor.peek.unwrap test::assert_eq
"x'\\n'!" parser::Cursor::new = char_cursor
1 char_cursor.skip
"character contents" '\n' char_cursor parser::parse_char_literal.unwrap test::assert_eq
"character suffix" '!' char_cursor.peek.unwrap test::assert_eq
test::test_summary
