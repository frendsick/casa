import "../../lib/parser.casa"
import "../../lib/test.casa"

fn observe_cursor cursor:$Cursor -> bool {
    cursor.is_eof !
    "abc" cursor.starts_with &&
}

fn consume_text cursor:mut$Cursor text:$str -> bool { text cursor.take_string.is_ok }

fn parse_shared_text text:$str -> i64 { text str_to_int }

fn test_shared_cursor_observations {
    "shared_cursor_observations" test_start
    "abc" Cursor::new = cursor
    "shared cursor observations" cursor observe_cursor assert_true
    "shared peek" cursor.peek.is_some assert_true
    "peek at offset" 2 cursor.peek_at.is_some assert_true
    "save reads position" 0 cursor.save assert_eq
    "shared string parameter" "abc" cursor consume_text assert_true
    "shared string helper" 42 "42" parse_shared_text assert_eq
}
test_shared_cursor_observations
test_summary
