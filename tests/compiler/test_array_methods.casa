fn test_lambda_type {
    Diagnostics::new = diagnostics
    "lambda_type" test_start
    diagnostics "{ 2 * }" tc_am = sig
    "returns fn" 1 sig StackEffect::return_types.length assert_eq
}

fn test_lambda_compiles {
    Diagnostics::new = diagnostics
    "lambda_compiles" test_start
    diagnostics "{ 2 * } drop" compile_am = prog
    "has bytecode" 0 prog Program::bytecode.length != assert_true
}

fn test_lambda_emits {
    Diagnostics::new = diagnostics
    "lambda_emits" test_start
    diagnostics "{ 2 * } drop" emit_am = asm
    "has _start" asm "_start:" assert_contains
}

# ============================================================================
# Function type tests
# ============================================================================

fn test_fn_push_type {
    Diagnostics::new = diagnostics
    "fn_push_type" test_start
    diagnostics "fn double x:i64 -> i64 { x 2 * }\n{ 2 * }" tc_am = sig
    "has fn type" 1 sig StackEffect::return_types.length assert_eq
}

fn test_fn_call_compiles {
    Diagnostics::new = diagnostics
    "fn_call_compiles" test_start
    diagnostics "fn double x:i64 -> i64 { x 2 * }\n42 double" tc_am = sig
    "returns i64" "i64" 0 sig StackEffect::return_types.get.format assert_str_eq
}

# ============================================================================
# Array with lambda pipeline
# ============================================================================

fn test_array_and_lambda_compiles {
    Diagnostics::new = diagnostics
    "array_and_lambda_compiles" test_start
    diagnostics "[1, 2, 3] = arr { 2 * } = mapper arr drop mapper drop" compile_am = prog
    "has bytecode" 0 prog Program::bytecode.length != assert_true
}

fn test_array_and_lambda_emits {
    Diagnostics::new = diagnostics
    "array_and_lambda_emits" test_start
    diagnostics "[1, 2, 3] = arr { 2 * } = mapper arr drop mapper drop" emit_am = asm
    "has _start" asm "_start:" assert_contains
}

