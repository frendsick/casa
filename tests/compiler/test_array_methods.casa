import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "../../compiler/bytecode.casa" as bytecode
import "../../compiler/emitter.casa" as emitter
import "helpers.casa" as helpers

# ============================================================================
# Array method tests
#
# These test that array operations compile through the self-hosted pipeline.
# Since the test pipeline uses lex_source (in-memory), we cannot include
# lib/std.casa inline. Instead, we test the underlying primitives that
# array methods use: array literals, method calls, lambdas, and fn types.
# ============================================================================

pub fn tc_am code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

pub fn compile_am code:$str diagnostics:mut$error::Diagnostics -> common::Program {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test drop
    store ops helpers::compile_test_program
}

pub fn emit_am code:$str diagnostics:mut$error::Diagnostics -> std::String {
    diagnostics code compile_am emitter::emit
}

pub fn assert_lacks needle:$str haystack:$std::String message:$str {
    haystack.as_str needle str::find = position
    if 0 position < then
        message true test::assert_true
    else
        message false test::assert_true
    fi
}

pub fn assert_contains needle:$str haystack:$std::String msg:$str {
    haystack.as_str needle str::find = position
    if 0 position < then
        msg false test::assert_true
    else
        msg true test::assert_true
    fi
}

# ============================================================================
# Array literal tests
# ============================================================================

pub fn test_array_literal_type {
    error::Diagnostics::new = diagnostics
    "array_literal_type" test::test_start
    diagnostics "[1, 2, 3]" tc_am = sig
    "returns array" 1 sig common::StackEffect::return_types.length test::assert_eq
}

pub fn test_array_literal_compiles {
    error::Diagnostics::new = diagnostics
    "array_literal_compiles" test::test_start
    diagnostics "[1, 2, 3] drop" compile_am = prog
    "has bytecode" 0 prog common::Program::bytecode.length != test::assert_true
}

pub fn test_array_literal_emits {
    error::Diagnostics::new = diagnostics
    "array_literal_emits" test::test_start
    diagnostics "[1, 2, 3] drop" emit_am = asm
    "has _start" asm "_start:" assert_contains
}

pub fn test_int_array_literal_emits_static {
    error::Diagnostics::new = diagnostics
    "int_array_literal_emits_static" test::test_start
    diagnostics "[1, 2, 3] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
    # The array is its element storage: no data pointer, no stored length.
    "has no header" asm "static_array_0 + 16" assert_lacks
    "starts with first element" asm "static_array_0:\n.quad 1" assert_contains
    "loads static addr" asm "leaq static_array_0(%rip)" assert_contains
}

pub fn test_str_array_literal_emits_static {
    error::Diagnostics::new = diagnostics
    "str_array_literal_emits_static" test::test_start
    diagnostics "[\"hello\", \"world\"] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
    "has no header" asm "static_array_0 + 16" assert_lacks
    "starts with first element" asm "static_array_0:\n.quad str_" assert_contains
}

pub fn test_non_literal_array_heap_allocates {
    error::Diagnostics::new = diagnostics
    "non_literal_array_heap_allocates" test::test_start
    diagnostics "42 = x [x] drop" compile_am = prog
    false = has_static
    false = has_heap
    for inst in prog common::Program::bytecode.iter do
        if inst common::InstValue::PushStaticArray is then
            true = has_static
        fi
        if inst common::InstValue::HeapAlloc is then
            true = has_heap
        fi
    done
    "no static array" has_static ! test::assert_true
    "uses heap alloc" has_heap test::assert_true
}

pub fn test_enum_variant_array_type {
    error::Diagnostics::new = diagnostics
    "enum_variant_array_type" test::test_start
    diagnostics "enum Color { Red Green Blue }\n[Color::Red, Color::Green] drop" tc_am = sig
    "no stack effect" 0 sig common::StackEffect::return_types.length test::assert_eq
}

pub fn test_enum_variant_array_compiles {
    error::Diagnostics::new = diagnostics
    "enum_variant_array_compiles" test::test_start
    diagnostics "enum Color { Red Green Blue }\n[Color::Red, Color::Blue] drop" compile_am = prog
    "has bytecode" 0 prog common::Program::bytecode.length != test::assert_true
}

pub fn test_enum_variant_array_emits {
    error::Diagnostics::new = diagnostics
    "enum_variant_array_emits" test::test_start
    diagnostics "enum Color { Red Green Blue }\n[Color::Red, Color::Blue] drop" emit_am = asm
    "has _start" asm "_start:" assert_contains
}

pub fn test_constant_array_emits_static {
    error::Diagnostics::new = diagnostics
    "constant_array_emits_static" test::test_start
    diagnostics "const X 10\nconst Y 20\n[X, Y] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
}

pub fn test_char_array_uses_dense_storage {
    error::Diagnostics::new = diagnostics
    "char_array_uses_dense_storage" test::test_start
    diagnostics "['a', 'b', 'c'] drop" emit_am = asm
    "char has no word-sized static array" asm "static_array_0:" assert_lacks
}

pub fn test_bool_array_uses_dense_storage {
    error::Diagnostics::new = diagnostics
    "bool_array_uses_dense_storage" test::test_start
    diagnostics "[true, false] drop" emit_am = asm
    "bool has no word-sized static array" asm "static_array_0:" assert_lacks
}

# ============================================================================
# Nested array tests
# ============================================================================

pub fn test_nested_array_type {
    error::Diagnostics::new = diagnostics
    "nested_array_type" test::test_start
    diagnostics "[[1, 2], [3, 4]] drop" tc_am = sig
    "no stack effect" 0 sig common::StackEffect::return_types.length test::assert_eq
}

pub fn test_nested_array_uses_dense_outer_storage {
    error::Diagnostics::new = diagnostics
    "nested_array_uses_dense_outer_storage" test::test_start
    diagnostics "[[1, 2], [3, 4]] drop" emit_am = asm
    "inner array 0" asm "static_array_0:" assert_contains
    "inner array 1" asm "static_array_1:" assert_contains
    "outer array is not word-sized static storage" asm "static_array_2:" assert_lacks
}

pub fn test_lambda_in_array_type {
    error::Diagnostics::new = diagnostics
    "lambda_in_array_type" test::test_start
    diagnostics "[{ 1 + }] drop" tc_am = sig
    "no stack effect" 0 sig common::StackEffect::return_types.length test::assert_eq
}

pub fn test_struct_in_array_type {
    error::Diagnostics::new = diagnostics
    "struct_in_array_type" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n[Point { x: 1, y: 2 }] drop" tc_am = sig
    "no stack effect" 0 sig common::StackEffect::return_types.length test::assert_eq
}

pub fn test_struct_in_array_with_var {
    error::Diagnostics::new = diagnostics
    "struct_in_array_with_var" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n42 = v [Point { x: v, y: 2 }] drop" tc_am = sig
    "no stack effect" 0 sig common::StackEffect::return_types.length test::assert_eq
}

pub fn test_enum_variant_array_emits_static {
    error::Diagnostics::new = diagnostics
    "enum_variant_array_emits_static" test::test_start
    diagnostics "enum Color { Red Green Blue }\n[Color::Red, Color::Blue] drop" emit_am = asm
    "has static array" asm "static_array_0:" assert_contains
}

pub fn test_struct_array_uses_dense_storage {
    error::Diagnostics::new = diagnostics
    "struct_array_uses_dense_storage" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n[Point { x: 1, y: 2 }] drop" emit_am = asm
    "has no static array" asm "static_array_0:" assert_lacks
    "has no static struct" asm "static_struct_0:" assert_lacks
}

pub fn test_struct_array_multi_uses_dense_storage {
    error::Diagnostics::new = diagnostics
    "struct_array_multi_uses_dense_storage" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n[Point { x: 1, y: 2 }, Point { x: 3, y: 4 }] drop" emit_am = asm
    "has no static_struct_0" asm "static_struct_0:" assert_lacks
    "has no static_struct_1" asm "static_struct_1:" assert_lacks
}

pub fn test_struct_array_field_reorder_uses_dense_storage {
    error::Diagnostics::new = diagnostics
    "struct_array_field_reorder_uses_dense_storage" test::test_start
    diagnostics "struct Pair { a: i64 b: i64 }\n[Pair { b: 20, a: 10 }] drop" emit_am = asm
    "has no static struct" asm "static_struct_0:" assert_lacks
    "has no word-sized field block" asm ".quad 10\n.quad 20" assert_lacks
}

pub fn test_struct_array_string_field_uses_dense_storage {
    error::Diagnostics::new = diagnostics
    "struct_array_string_field_uses_dense_storage" test::test_start
    diagnostics "struct Named { name: str val: i64 }\n[Named { name: \"hello\", val: 42 }] drop" emit_am = asm
    "has no static struct" asm "static_struct_0:" assert_lacks
    "has string ref" asm "str_" assert_contains
}

pub fn test_struct_array_non_literal_uses_heap {
    error::Diagnostics::new = diagnostics
    "struct_array_non_literal_uses_heap" test::test_start
    diagnostics "struct Point { x: i64 y: i64 }\n42 = n\n[Point { x: n, y: 2 }] drop" compile_am = prog
    false = has_static
    false = has_heap
    for inst in prog common::Program::bytecode.iter do
        if inst common::InstValue::PushStaticArray is then
            true = has_static
        fi
        if inst common::InstValue::HeapAlloc is then
            true = has_heap
        fi
    done
    "no static array" has_static ! test::assert_true
    "uses heap alloc" has_heap test::assert_true
}

pub fn test_fn_ptr_in_array_type {
    error::Diagnostics::new = diagnostics
    "fn_ptr_in_array_type" test::test_start
    diagnostics "fn double x:i64 -> i64 { x 2 * }\n[double] drop" tc_am = sig
    "no stack effect" 0 sig common::StackEffect::return_types.length test::assert_eq
}

pub fn test_fn_ptr_array_emits_static {
    error::Diagnostics::new = diagnostics
    "fn_ptr_array_emits_static" test::test_start
    diagnostics "fn double x:i64 -> i64 { x 2 * }\n[double] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
}

