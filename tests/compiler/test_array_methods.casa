import "../../compiler/typechecker.casa"
import "../../compiler/bytecode.casa"
import "../../compiler/emitter.casa"
import "helpers.casa"

# ============================================================================
# Array method tests
#
# These test that array operations compile through the self-hosted pipeline.
# Since the test pipeline uses lex_source (in-memory), we cannot include
# lib/std.casa inline. Instead, we test the underlying primitives that
# array methods use: array literals, method calls, lambdas, and fn types.
# ============================================================================

fn tc_am code:str diagnostics:Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option[Function]::None ops type_check_ops_for_test
}

fn compile_am code:str diagnostics:Diagnostics -> Program {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option[Function]::None ops type_check_ops_for_test drop
    store ops compile_test_program
}

fn emit_am code:str diagnostics:Diagnostics -> str {
    diagnostics code compile_am emit
}

fn assert_contains needle:str haystack:str msg:str {
    haystack needle str::find = position
    if 0 position < then
        msg false assert_true
    else
        msg true assert_true
    fi
}

# ============================================================================
# Array literal tests
# ============================================================================

fn test_array_literal_type {
    Diagnostics::new = diagnostics
    "array_literal_type" test_start
    diagnostics "[1, 2, 3]" tc_am = sig
    "returns array" 1 sig StackEffect::return_types.length assert_eq
}

fn test_array_literal_compiles {
    Diagnostics::new = diagnostics
    "array_literal_compiles" test_start
    diagnostics "[1, 2, 3] drop" compile_am = prog
    "has bytecode" 0 prog Program::bytecode.length != assert_true
}

fn test_array_literal_emits {
    Diagnostics::new = diagnostics
    "array_literal_emits" test_start
    diagnostics "[1, 2, 3] drop" emit_am = asm
    "has _start" asm "_start:" assert_contains
}

fn test_int_array_literal_emits_static {
    Diagnostics::new = diagnostics
    "int_array_literal_emits_static" test_start
    diagnostics "[1, 2, 3] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
    "has data_ptr" asm "static_array_0 + 16" assert_contains
    "has length 3" asm ".quad 3" assert_contains
    "loads static addr" asm "leaq static_array_0(%rip)" assert_contains
}

fn test_str_array_literal_emits_static {
    Diagnostics::new = diagnostics
    "str_array_literal_emits_static" test_start
    diagnostics "[\"hello\", \"world\"] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
    "has length 2" asm ".quad 2" assert_contains
    "has str ref" asm ".quad str_" assert_contains
}

fn test_empty_array_literal_emits_static {
    Diagnostics::new = diagnostics
    "empty_array_literal_emits_static" test_start
    diagnostics "[] (array[i64]) drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
    "has length 0" asm ".quad 0" assert_contains
}

fn test_non_literal_array_heap_allocates {
    Diagnostics::new = diagnostics
    "non_literal_array_heap_allocates" test_start
    diagnostics "42 = x [x] drop" compile_am = prog
    false = has_static
    false = has_heap
    for inst in prog Program::bytecode.iter do
        if inst InstValue::PushStaticArray is then true = has_static fi
        if inst InstValue::HeapAlloc is then true = has_heap fi
    done
    "no static array" has_static ! assert_true
    "uses heap alloc" has_heap assert_true
}

fn test_enum_variant_array_type {
    Diagnostics::new = diagnostics
    "enum_variant_array_type" test_start
    diagnostics "enum Color { Red Green Blue }\n[Color::Red, Color::Green] drop" tc_am = sig
    "no stack effect" 0 sig StackEffect::return_types.length assert_eq
}

fn test_enum_variant_array_compiles {
    Diagnostics::new = diagnostics
    "enum_variant_array_compiles" test_start
    diagnostics "enum Color { Red Green Blue }\n[Color::Red, Color::Blue] drop" compile_am = prog
    "has bytecode" 0 prog Program::bytecode.length != assert_true
}

fn test_enum_variant_array_emits {
    Diagnostics::new = diagnostics
    "enum_variant_array_emits" test_start
    diagnostics "enum Color { Red Green Blue }\n[Color::Red, Color::Blue] drop" emit_am = asm
    "has _start" asm "_start:" assert_contains
}

fn test_constant_array_emits_static {
    Diagnostics::new = diagnostics
    "constant_array_emits_static" test_start
    diagnostics "const X 10\nconst Y 20\n[X, Y] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
}

fn test_char_array_emits_static {
    Diagnostics::new = diagnostics
    "char_array_emits_static" test_start
    diagnostics "['a', 'b', 'c'] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
}

fn test_bool_array_emits_static {
    Diagnostics::new = diagnostics
    "bool_array_emits_static" test_start
    diagnostics "[true, false] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
}

# ============================================================================
# Nested array tests
# ============================================================================

fn test_nested_array_type {
    Diagnostics::new = diagnostics
    "nested_array_type" test_start
    diagnostics "[[1, 2], [3, 4]] drop" tc_am = sig
    "no stack effect" 0 sig StackEffect::return_types.length assert_eq
}

fn test_nested_array_emits_static {
    Diagnostics::new = diagnostics
    "nested_array_emits_static" test_start
    diagnostics "[[1, 2], [3, 4]] drop" emit_am = asm
    "inner array 0" asm "static_array_0:" assert_contains
    "inner array 1" asm "static_array_1:" assert_contains
    "outer array" asm "static_array_2:" assert_contains
}

fn test_lambda_in_array_type {
    Diagnostics::new = diagnostics
    "lambda_in_array_type" test_start
    diagnostics "[{ 1 + }] drop" tc_am = sig
    "no stack effect" 0 sig StackEffect::return_types.length assert_eq
}

fn test_struct_in_array_type {
    Diagnostics::new = diagnostics
    "struct_in_array_type" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n[Point { x: 1, y: 2 }] drop" tc_am = sig
    "no stack effect" 0 sig StackEffect::return_types.length assert_eq
}

fn test_struct_in_array_with_var {
    Diagnostics::new = diagnostics
    "struct_in_array_with_var" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n42 = v [Point { x: v, y: 2 }] drop" tc_am = sig
    "no stack effect" 0 sig StackEffect::return_types.length assert_eq
}

fn test_enum_variant_array_emits_static {
    Diagnostics::new = diagnostics
    "enum_variant_array_emits_static" test_start
    diagnostics "enum Color { Red Green Blue }\n[Color::Red, Color::Blue] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
}

fn test_struct_array_emits_static {
    Diagnostics::new = diagnostics
    "struct_array_emits_static" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n[Point { x: 1, y: 2 }] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
    "has static_struct label" asm "static_struct_0:" assert_contains
}

fn test_struct_array_multi_emits_static {
    Diagnostics::new = diagnostics
    "struct_array_multi_emits_static" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n[Point { x: 1, y: 2 }, Point { x: 3, y: 4 }] drop" emit_am = asm
    "has static_struct_0" asm "static_struct_0:" assert_contains
    "has static_struct_1" asm "static_struct_1:" assert_contains
}

fn test_struct_array_field_reorder_emits_static {
    Diagnostics::new = diagnostics
    "struct_array_field_reorder_emits_static" test_start
    diagnostics "struct Pair { a: i64 b: i64 }\n[Pair { b: 20, a: 10 }] drop" emit_am = asm
    "has static_struct" asm "static_struct_0:" assert_contains
    "field a first" asm ".quad 10\n.quad 20" assert_contains
}

fn test_struct_array_string_field_emits_static {
    Diagnostics::new = diagnostics
    "struct_array_string_field_emits_static" test_start
    diagnostics "struct Named { name: str val: i64 }\n[Named { name: \"hello\", val: 42 }] drop" emit_am = asm
    "has static_struct" asm "static_struct_0:" assert_contains
    "has string ref" asm "str_" assert_contains
}

fn test_struct_array_non_literal_uses_heap {
    Diagnostics::new = diagnostics
    "struct_array_non_literal_uses_heap" test_start
    diagnostics "struct Point { x: i64 y: i64 }\n42 = n\n[Point { x: n, y: 2 }] drop" compile_am = prog
    false = has_static
    false = has_heap
    for inst in prog Program::bytecode.iter do
        if inst InstValue::PushStaticArray is then true = has_static fi
        if inst InstValue::HeapAlloc is then true = has_heap fi
    done
    "no static array" has_static ! assert_true
    "uses heap alloc" has_heap assert_true
}

fn test_fn_ptr_in_array_type {
    Diagnostics::new = diagnostics
    "fn_ptr_in_array_type" test_start
    diagnostics "fn double x:i64 -> i64 { x 2 * }\n[double] drop" tc_am = sig
    "no stack effect" 0 sig StackEffect::return_types.length assert_eq
}

fn test_fn_ptr_array_emits_static {
    Diagnostics::new = diagnostics
    "fn_ptr_array_emits_static" test_start
    diagnostics "fn double x:i64 -> i64 { x 2 * }\n[double] drop" emit_am = asm
    "has static_array label" asm "static_array_0:" assert_contains
}

