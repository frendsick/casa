pub fn test_fn_call_compiles {
    error::Diagnostics::new = diagnostics
    "fn_call_compiles" test::test_start
    diagnostics "fn double x:i64 -> i64 { x 2 * }\n42 double" tc_am = sig
    "returns i64" "i64" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

