import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/products.casa" as products
import "../../lib/test.casa" as test

fn assert_loop_exit_diagnostic diagnostics:$error::Diagnostics keyword:$str offset:u64 {
    f"`{keyword}` is only valid inside a loop" = message
    for diagnostic in diagnostics.entries.iter do
        if diagnostic error::Diagnostic::Error(failure) is then
            if failure.message.as_str message.as_str == then
                "loop exit diagnostic kind" common::ErrorKind::InvalidScope failure.kind test::assert_eq
                "loop exit keyword offset" offset failure
                    .location
                    .span
                    .offset test::assert_eq
                "loop exit keyword length" keyword.length failure
                    .location
                    .span
                    .length test::assert_eq
                return
            fi
        fi
    done
    message false test::assert_true
}

pub fn test_loop_exits_require_enclosing_loop {
    "loop_exits_require_enclosing_loop" test::test_start
    for
        source in [
            "break",
            "continue",
            "fn f { break } f",
            "fn f { continue } f",
            "if true then break fi",
            "if true then continue fi",
            "true match true => break false => end",
            "true match true => continue false => end",
            "if true else break fi",
            "if true else continue fi",
            "fn f [T] value:T { value drop break } 1 f",
            "fn f [T] value:T { value drop continue } 1 f",
            "while false do { break } exec done",
            "while false do { continue } exec done",
            "fn f { break } while false do f done",
            "fn f { continue } while false do f done",
            "fn f { return break } f",
            "fn f { return continue } f",
        ].iter
    do
        if source "continue" str::contains then "continue" else "break" fi = keyword
        source keyword str::find.unwrap = offset
        "/tmp/casa_loop_exits".to_str source.to_str "test.casa".to_str products::SourceUnit products::CompilationInput::new = input
        products::Target::LinuxX86_64 input products::assembly.unwrap match
            products::AssemblyResult::Rejected(report) => offset keyword report.get_diagnostics assert_loop_exit_diagnostic
            products::AssemblyResult::Produced(report assembly) => source false test::assert_true
        end
    done
}

pub fn test_nested_loop_exit_targets {
    "nested_loop_exit_targets" test::test_start
    0 = outer
    0 = total
    while outer 3 < do
        1 += outer
        0 = inner
        while inner 5 < do
            1 += inner
            if inner 2 == then
                continue
            fi
            if inner 4 == then
                break
            fi
            inner += total
        done
    done
    "inner exits preserve the outer loop" 12 total test::assert_eq
}

pub fn run_tests {
    test_loop_exits_require_enclosing_loop
    test_nested_loop_exit_targets
    test::test_summary
}
run_tests
