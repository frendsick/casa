import "std" as std

0 = test_pass_count
0 = test_fail_count
"" = test_current_name

pub fn test_start name:str { name = test_current_name }

pub fn assert_true condition:bool message:$str {
    if condition then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message}\n".as_str std::eprint
        1 += test_fail_count
    fi
}

pub fn assert_eq actual:i64 expected:i64 message:$str {
    if expected actual == then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message} (expected {expected}, got {actual})\n".as_str std::eprint
        1 += test_fail_count
    fi
}

pub fn assert_u64_eq actual:u64 expected:u64 message:$str {
    if expected actual == then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message} (expected {expected}, got {actual})\n".as_str std::eprint
        1 += test_fail_count
    fi
}

pub fn test_summary {
    f"{test_pass_count} passed, {test_fail_count} failed\n" print
    if 0 test_fail_count > then
        1 std::exit
    fi
}

pub struct WideValue {
    pub small: u8
    pub large: u64
}

# ============================================================================
# Map::iter tests
# ============================================================================
# --- empty map ---
"iter empty map" test_start
std::Map[str i64]::new = empty
empty.iter.collect = empty_result: std::List[std::Pair[$str $i64]]
"length" 0 empty_result.length assert_u64_eq
# --- basic iteration ---
"iter basic" test_start
std::Map[str i64]::new = m
1 "a" m.set
2 "b" m.set
3 "c" m.set
m.iter.collect = pairs: std::List[std::Pair[$str $i64]]
"length" 3 pairs.length assert_u64_eq
# --- verify all entries present via get ---
"iter entries match get" test_start
0 = idx: u64
while idx pairs.length > do
    idx pairs.get = stored_pair
    stored_pair.first = key
    stored_pair.second = val
    key m.get.unwrap = expected
    f"value for key at {idx}".as_str expected copy val copy assert_eq
    1 += idx
done
# --- for loop works ---
"for loop" test_start
0 = total
for iter_pair in m.iter do
    iter_pair.second += total
done
"sum" 6 total assert_eq
# --- keys via iter ---
"keys" test_start
m.keys = key_list
"keys length" 3 key_list.length assert_u64_eq
# --- values via iter ---
"values" test_start
m.values = val_list
"values length" 3 val_list.length assert_u64_eq
0 = val_sum
0 = vi: u64
while vi val_list.length > do
    vi val_list.get += val_sum
    1 += vi
done
"values sum" 6 val_sum assert_eq
# --- iter with take ---
"iter take" test_start
2 m
    .iter
    .take
    .collect = taken: std::List[std::Pair[$str $i64]]
"taken length" 2 taken.length assert_u64_eq
# --- iter count ---
"iter count" test_start
"count" 3 m.iter.count assert_u64_eq
# --- single entry map ---
"single entry" test_start
std::Map[i64 i64]::new = m1
42 1 m1.set
m1.iter.collect = single_pairs: std::List[std::Pair[$i64 $i64]]
"length" 1 single_pairs.length assert_u64_eq
0 single_pairs.get = sp
"key" 1 sp.first assert_eq
"value" 42 sp.second assert_eq
# --- iter after delete ---
"iter after delete" test_start
std::Map[str i64]::new = md
1 "x" md.set
2 "y" md.set
3 "z" md.set
"y" md.delete
md.iter.collect = del_pairs: std::List[std::Pair[$str $i64]]
"length after delete" 2 del_pairs.length assert_u64_eq
0 = del_sum
for deleted_pair in md.iter do
    deleted_pair.second += del_sum
done
"sum after delete" 4 del_sum assert_eq
# --- multiple iterations of same map ---
"multiple iterations" test_start
"first count" 3 m.iter.count assert_u64_eq
"second count" 3 m.iter.count assert_u64_eq
# --- large map ---
"large map" test_start
std::Map[i64 i64]::new = big
0 = i
while i 100 > do
    i i big.set
    1 += i
done
big.iter.collect = big_pairs: std::List[std::Pair[$i64 $i64]]
"large length" 100 big_pairs.length assert_u64_eq
# --- multiword values use their inline size ---
"multiword values" test_start
std::Map[i64 WideValue]::new = wide
123 9 WideValue 1 wide.set
456 7 WideValue 2 wide.set
1 wide.get.unwrap = first_wide
"first small field" 9 first_wide.small i64::from assert_eq
"first large field" 123 first_wide.large i64::try_from.unwrap assert_eq
2 wide.remove.unwrap = removed_wide
"removed small field" 7 removed_wide.small i64::from assert_eq
"removed large field" 456 removed_wide.large i64::try_from.unwrap assert_eq
removed_wide drop
"length after wide remove" 1 wide.length assert_u64_eq
test_summary
