import "std" as std
import "../../lib/test.casa" as test

pub struct WideValue {
    pub small: u8
    pub large: u64
}

pub struct CollidingKey {
    pub value: i64
}

impl CollidingKey: std::Hashable {
    pub fn eq self:$CollidingKey other:$CollidingKey -> bool { other.value self.value == }
    pub fn hash self:$CollidingKey -> i64 { self drop 0 }
}

# Map::iter tests
# empty map
"iter empty map" test::test_start
std::Map[str i64]::new = empty
empty.iter.collect = empty_result: std::List[std::Pair[$str $i64]]
"length" 0 empty_result.length test::assert_eq

# basic iteration
"iter basic" test::test_start
std::Map[str i64]::new = m
1 "a" m.set
2 "b" m.set
3 "c" m.set
m.iter.collect = pairs: std::List[std::Pair[$str $i64]]
"length" 3 pairs.length test::assert_eq

# verify all entries present via get
"iter entries match get" test::test_start
0 = idx: u64
while idx pairs.length < do
    idx pairs.get = stored_pair
    stored_pair.first = key
    stored_pair.second = val
    key m.get.unwrap = expected
    f"value for key at {idx}".as_str expected copy val copy test::assert_eq
    1 += idx
done

# for loop works
"for loop" test::test_start
0 = total
for iter_pair in m.iter do
    iter_pair.second += total
done
"sum" 6 total test::assert_eq

# keys via iter
"keys" test::test_start
m.keys = key_list
"keys length" 3 key_list.length test::assert_eq

# values via iter
"values" test::test_start
m.values = val_list
"values length" 3 val_list.length test::assert_eq
0 = val_sum
0 = vi: u64
while vi val_list.length < do
    vi val_list.get += val_sum
    1 += vi
done
"values sum" 6 val_sum test::assert_eq

# iter with take
"iter take" test::test_start
2 m
    .iter
    .take
    .collect = taken: std::List[std::Pair[$str $i64]]
"taken length" 2 taken.length test::assert_eq

# iter count
"iter count" test::test_start
"count" 3 m.iter.count test::assert_eq

# single entry map
"single entry" test::test_start
std::Map[i64 i64]::new = m1
42 1 m1.set
m1.iter.collect = single_pairs: std::List[std::Pair[$i64 $i64]]
"length" 1 single_pairs.length test::assert_eq
0 single_pairs.get = sp
"key" 1 sp.first test::assert_eq
"value" 42 sp.second test::assert_eq

# iter after delete
"iter after delete" test::test_start
std::Map[str i64]::new = md
1 "x" md.set
2 "y" md.set
3 "z" md.set
"y" md.delete
md.iter.collect = del_pairs: std::List[std::Pair[$str $i64]]
"length after delete" 2 del_pairs.length test::assert_eq
0 = del_sum
for deleted_pair in md.iter do
    deleted_pair.second += del_sum
done
"sum after delete" 4 del_sum test::assert_eq

# multiple iterations of same map
"multiple iterations" test::test_start
"first count" 3 m.iter.count test::assert_eq
"second count" 3 m.iter.count test::assert_eq

# large map
"large map" test::test_start
std::Map[i64 i64]::new = big
0 = i
while i 100 < do
    i i big.set
    1 += i
done
big.iter.collect = big_pairs: std::List[std::Pair[$i64 $i64]]
"large length" 100 big_pairs.length test::assert_eq

# multiword values use their inline size
"multiword values" test::test_start
std::Map[i64 WideValue]::new = wide
123 9 WideValue 1 wide.set
456 7 WideValue 2 wide.set
1 wide.get.unwrap = first_wide
"first small field" 9 first_wide.small i64::from test::assert_eq
"first large field" 123 first_wide.large i64::try_from.unwrap test::assert_eq
2 wide.remove.unwrap = removed_wide
"removed small field" 7 removed_wide.small i64::from test::assert_eq
"removed large field" 456 removed_wide.large i64::try_from.unwrap test::assert_eq
removed_wide drop
"length after wide remove" 1 wide.length test::assert_eq

# hash collisions preserve distinct keys
"hash collisions" test::test_start
std::Map[CollidingKey i64]::new = colliding
10 1 CollidingKey colliding.set
20 -1 CollidingKey colliding.set
"distinct colliding keys" 2 colliding.length test::assert_eq
"positive key value" 10 1 CollidingKey colliding.get.unwrap test::assert_eq
"negative key value" 20 -1 CollidingKey colliding.get.unwrap test::assert_eq
11 1 CollidingKey colliding.set
"replace only equal key" 11 1 CollidingKey colliding.get.unwrap test::assert_eq
"colliding key unchanged" 20 -1 CollidingKey colliding.remove.unwrap test::assert_eq
"remaining colliding key" 11 1 CollidingKey colliding.get.unwrap test::assert_eq
"owned and borrowed Unicode keys" test::test_start
std::Map[std::String i64]::new = unicode_keys
"ä😀\0z".to_str = unicode_key
"owned and borrowed hashes agree" unicode_key.as_str.hash unicode_key.hash test::assert_eq
10 unicode_key.clone unicode_keys.set
"borrowed lookup" 10 "ä😀\0z" unicode_keys.get_str.unwrap test::assert_eq
20 "ä😀\0z" unicode_keys.set_str
"borrowed replacement" 20 unicode_key unicode_keys.get.unwrap test::assert_eq
30 "ä😀" unicode_keys.set_str
"NUL does not truncate a key" 2 unicode_keys.length test::assert_eq
"borrowed removal" 20 "ä😀\0z" unicode_keys.remove_str.unwrap test::assert_eq
"other Unicode key remains" 30 "ä😀" unicode_keys.get_str.unwrap test::assert_eq
40 "prefix ä😀\0tail" unicode_keys.set_str
"ASCII prefix before Unicode" 40 "prefix ä😀\0tail" unicode_keys.get_str.unwrap test::assert_eq
50 "ASCII\0tail" unicode_keys.set_str
"ASCII key includes NUL" 50 "ASCII\0tail" unicode_keys.get_str.unwrap test::assert_eq
60 "" unicode_keys.set_str
"empty key" 60 "" unicode_keys.get_str.unwrap test::assert_eq
0 = key_length: u64
while 17 key_length >= do
    "abcdefgh\0ijklmnop" 0 key_length str::substring = boundary_key
    key_length i64::try_from.unwrap boundary_key.clone unicode_keys.set
    "word and tail lookup" key_length i64::try_from.unwrap boundary_key.as_str unicode_keys.get_str.unwrap test::assert_eq
    "word and tail hashes agree" boundary_key.hash boundary_key.as_str.hash test::assert_eq
    1 += key_length
done
test::test_summary
