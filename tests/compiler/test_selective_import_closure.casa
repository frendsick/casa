fn test_nested_semantics_work_through_real_selective_import {
    "nested_semantics_work_through_real_selective_import" test_start
    SourceStore::new = sources
    "enum Maybe[T] { Some(T) None } fn identity[T] value:T -> T { value } fn helper value:int -> int { value } impl int { fn picked self:int -> int { self } } fn root -> int { [1] = values 0 = total while total 1 < do 1 += total done true if then 1 identity Maybe::Some match Maybe::Some(value) if value 0 > => { value helper .picked } Maybe::Some(_) => 0 Maybe::None => 0 end else 0 fi }"
    "/tmp/casa_selective_nested_semantics_302.casa"
    sources.add
    "root"
    "import \"/tmp/casa_selective_nested_semantics_302.casa\" { root } root drop"
    lex_source = lex_result
    sources
    lex_result.diagnostics
    List::new(List[str])
    lex_result.tokens
    parse_and_resolve = result
    result.diagnostics "nested semantic import resolves" assert_no_errors
    "generic helper included" "identity" result.store.functions.has assert_true
    "callable helper included" "helper" result.store.functions.has assert_true
    "pattern receiver included" "int::picked" result.store.functions.has assert_true
    result.store result.ops.unwrap type_check = typecheck_result
    typecheck_result.diagnostics "nested semantic import typechecks" assert_no_errors
}
