}

pub fn test_public_exact_method_precedes_private_generic_method {
    "public_exact_method_precedes_private_generic_method" test::test_start
    lexer::SourceStore::new = sources
    "pub struct Box[T] { value: T } impl[T] Box[T] { fn pick self:Box[T] -> i64 { self drop 1 } } impl Box[i64] { pub fn pick self:Box[i64] -> bool { self drop true } }"
    "/tmp/casa_public_exact_private_generic_method.casa"
    sources.add
    "Box"
    "import \"/tmp/casa_public_exact_private_generic_method.casa\" as dep 1 dep::Box dep::Box[i64]::pick = result:bool result drop &dep::Box[i64]::pick drop"
    lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    sources lex_diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve = result
    result.into_parts = diagnostics = store = ops
    diagnostics "public exact method resolves before private generic method"
    helpers::assert_no_errors
    store ops.unwrap typechecker::type_check = typecheck_result
    typecheck_result.diagnostics "public exact method typechecks before private generic method"
    helpers::assert_no_errors
}

