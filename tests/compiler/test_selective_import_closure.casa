pub fn test_tracks_receiver_types_through_dependent_operations {
    "tracks_receiver_types_through_dependent_operations" test::test_start
    std::List[std::String]::new = requested
    "root" requested.push_str

    "impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn consume i64 { drop } fn root -> i64 { true 1 &consume exec .picked }"
    = execute_source
    requested execute_source compute_test_closure get_closure_declarations
    get_declaration_names = execute_names
    "bool::picked" execute_names assert_closure_has
    "consumed argument method omitted"
    "i64::picked" execute_names common::string_list_contains !
    test::assert_true

    "trait Carrier[T] { fn get self:self -> T } impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root[I: Carrier[i64]] item:I -> i64 { item .get .picked }"
    = generic_trait_source
    requested generic_trait_source compute_test_closure get_closure_declarations
    get_declaration_names = generic_trait_names
    "i64::picked" generic_trait_names assert_closure_has
    "unsubstituted method omitted"
    "bool::picked" generic_trait_names common::string_list_contains !
    test::assert_true

    "impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root -> i64 { 1 true print .picked }"
    = print_source
    requested print_source compute_test_closure get_closure_declarations
    get_declaration_names = print_names
    "i64::picked" print_names assert_closure_has
    "printed receiver method omitted" "bool::picked" print_names common::string_list_contains ! test::assert_true

    "trait __casa_std__Display { fn render self:self -> str { self drop \"default\" } fn to_str self:self -> __casa_std__String { self .render } } struct Box { value: i64 } impl Box: __casa_std__Display { fn render self:Box -> str { self drop \"box\" } } fn root { 1 Box print }"
    = display_source
    requested display_source compute_test_closure get_closure_declarations
    get_declaration_names = display_names
    common::STD_DISPLAY_TRAIT display_names assert_closure_has

    "fn id[T] T -> T { } impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root -> i64 { 1 id .picked }"
    = generic_call_source
    requested generic_call_source compute_test_closure get_closure_declarations
    get_declaration_names = generic_call_names
    "i64::picked" generic_call_names assert_closure_has
    "unbound generic method omitted"
    "bool::picked" generic_call_names common::string_list_contains !
    test::assert_true

    "impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root -> i64 { 1 = value value .picked }"
    = assignment_source
    requested assignment_source compute_test_closure get_closure_declarations
    get_declaration_names = assignment_names
    "i64::picked" assignment_names assert_closure_has
    "uninferred local method omitted"
    "bool::picked" assignment_names common::string_list_contains !
    test::assert_true

    "trait __casa_std__PartialEq { fn eq self:self other:self -> bool fn ne self:self other:self -> bool { other self.eq ! } } struct Box { value: i64 } impl Box: __casa_std__PartialEq { fn eq self:Box other:Box -> bool { self drop other drop true } } fn root -> bool { 1 Box 2 Box == }"
    = comparison_source
    requested comparison_source compute_test_closure get_closure_declarations
    get_declaration_names = comparison_names
    common::STD_PARTIAL_EQ_TRAIT comparison_names assert_closure_has

    "fn make { 1 } impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root -> i64 { make .picked }"
    = inferred_call_source
    requested inferred_call_source compute_test_closure get_closure_declarations
    get_declaration_names = inferred_call_names
    "i64::picked" inferred_call_names assert_closure_has

    "trait Carrier[T] { fn raw self:self -> T fn get self:self -> T { self .raw } } struct Box { value: i64 } impl Box: Carrier[i64] { fn raw self:Box -> i64 { self Box::value } } impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root -> i64 { 1 Box .get .picked }"
    = default_generic_source
    requested default_generic_source compute_test_closure get_closure_declarations
    get_declaration_names = default_generic_names
    "i64::picked" default_generic_names assert_closure_has

    "impl[T const N:u64] array[T N] { fn first self:array[T N] -> T { 0 self.nth } } impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root -> i64 { [1] .first .picked }"
    = generic_array_source
    requested generic_array_source compute_test_closure get_closure_declarations
    get_declaration_names = generic_array_names
    "i64::picked" generic_array_names assert_closure_has

    "impl i64 { fn acceptable self:i64 -> bool { self drop true } } impl bool { fn acceptable self:bool -> bool { self } } fn root -> i64 { 1 = value true match _ if value .acceptable => 1 _ => 0 end }"
    = guard_source
    requested guard_source compute_test_closure get_closure_declarations
    get_declaration_names = guard_names
    "i64::acceptable" guard_names assert_closure_has
    "wrong guard method omitted"
    "bool::acceptable" guard_names common::string_list_contains !
    test::assert_true

    "fn consume { drop } impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root -> i64 { true 1 consume .picked }"
    = inferred_parameter_source
    requested inferred_parameter_source compute_test_closure get_closure_declarations
    get_declaration_names = inferred_parameter_names
    "bool::picked" inferred_parameter_names assert_closure_has
    "consumed inferred argument omitted"
    "i64::picked" inferred_parameter_names common::string_list_contains !
    test::assert_true

    "trait Hashable { fn hash self:self -> i64 fn eq self:self other:self -> bool { self drop other drop false } } impl i64: Hashable { fn hash self:i64 -> i64 { self } fn eq self:i64 other:i64 -> bool { self other == } } fn use_hash[K: Hashable] K -> i64 { .hash } fn root -> i64 { 1 use_hash }"
    = dictionary_source
    requested dictionary_source compute_test_closure get_closure_declarations
    get_declaration_names = dictionary_names
    "i64::Hashable::hash" dictionary_names assert_closure_has
    "i64::Hashable::eq" dictionary_names assert_closure_has

    "enum E { Some(i64) None } impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root -> i64 { 1 E::Some match E::Some(value) => { value .picked } E::None => 0 end }"
    = match_binding_source
    requested match_binding_source compute_test_closure get_closure_declarations
    get_declaration_names = match_binding_names
    "i64::picked" match_binding_names assert_closure_has

    "enum E { Some(i64) None } impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root value:E -> i64 { if value E::Some(inner) is then inner .picked else 0 fi }"
    = is_binding_source
    requested is_binding_source compute_test_closure get_closure_declarations
    get_declaration_names = is_binding_names
    "i64::picked" is_binding_names assert_closure_has

    "trait Carrier[T] { fn get self:self -> T } impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root[K: Carrier[i64]] item:K -> i64 { item K::get .picked }"
    = qualified_bound_source
    requested qualified_bound_source compute_test_closure get_closure_declarations
    get_declaration_names = qualified_bound_names
    "i64::picked" qualified_bound_names assert_closure_has
}

pub fn test_unifies_generic_branch_results_before_dispatch {
    "unifies_generic_branch_results_before_dispatch" test::test_start
    std::List[std::String]::new = requested
    "root" requested.push_str
    requested
    "impl[T const N:u64] array[T N] { fn first self:array[T N] -> T { 0 self.nth } } impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 0 } } fn root value:bool -> i64 { if value then [2] else [1] fi .first .picked }"
    compute_test_closure get_closure_declarations get_declaration_names = names
    "i64::picked" names assert_closure_has
    "wrong receiver omitted" "bool::picked" names common::string_list_contains ! test::assert_true

    requested
    "impl[T const N:u64] array[T N] { fn first self:array[T N] -> T { 0 self.nth } } impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 0 } } fn root condition:bool -> i64 { [0] = value if condition then [2] = value else [1] = value fi value .first .picked }"
    compute_test_closure get_closure_declarations get_declaration_names = assignment_names
    "i64::picked" assignment_names assert_closure_has
    "wrong assignment receiver omitted"
    "bool::picked" assignment_names common::string_list_contains !
    test::assert_true
}

pub fn test_closures_capture_parameters {
    "closures_capture_parameters" test::test_start
    std::List[std::String]::new = requested
    "outer" requested.push_str
    requested
    "1 = VALUE fn outer VALUE:i64 -> fn[-> i64] { { VALUE } }"
    compute_test_closure get_closure_declarations drop
    requested
    "struct Box { value: i64 } 1 Box = VALUE fn outer VALUE:Box -> fn[-> i64] { { 2 = VALUE.value 0 } }"
    compute_test_closure get_closure_declarations drop
}

pub fn test_selective_method_import_works_end_to_end {
    "selective_method_import_works_end_to_end" test::test_start
    lexer::SourceStore::new = sources
    "global STATE 1 impl bool { fn bumped self:bool -> i64 { STATE } } impl i64 { fn bumped self:i64 -> i64 { self 1 + } } pub fn root -> i64 { 1 .bumped }"
    "/tmp/casa_selective_method_closure_272.casa"
    sources.add
    "root"
    "import \"/tmp/casa_selective_method_closure_272.casa\" as module { root } root drop"
    lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    sources lex_diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve = result
    result.into_parts = parse_diagnostics = store = ops
    parse_diagnostics "selective method import resolves" helpers::assert_no_errors
    "selected method included" "i64::bumped" store.has_function test::assert_true
    "unused method omitted" "bool::bumped" store.has_function ! test::assert_true
    store ops.unwrap typechecker::type_check = typecheck_result
    typecheck_result.diagnostics "selective method import typechecks" helpers::assert_no_errors
}

