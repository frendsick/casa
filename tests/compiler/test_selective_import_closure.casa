pub fn test_nested_semantics_work_through_real_selective_import {
    "nested_semantics_work_through_real_selective_import" test::test_start
    lexer::SourceStore::new = sources
    "enum Maybe[T] { Some(T) None } fn identity[T] value:T -> T { value } fn helper value:i64 -> i64 { value } impl i64 { fn picked self:i64 -> i64 { self } } pub fn root -> i64 { [1] = values 0 = total while total 1 < do 1 += total done true if then 1 identity Maybe::Some match Maybe::Some(value) if value 0 > => { value helper .picked } Maybe::Some(_) => 0 Maybe::None => 0 end else 0 fi }"
    "/tmp/casa_selective_nested_semantics_302.casa"
    sources.add
    "root"
    "import \"/tmp/casa_selective_nested_semantics_302.casa\" as module { root } root drop"
    lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    sources lex_diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve = result
    result.into_parts = parse_diagnostics = store = ops
    parse_diagnostics "nested semantic import resolves" helpers::assert_no_errors
    "generic helper included" "__identity" store helpers::store_has_function_suffix test::assert_true
    "callable helper included" "__helper" store helpers::store_has_function_suffix test::assert_true
    "pattern receiver included" "i64::picked" store.has_function test::assert_true
    store ops.unwrap typechecker::type_check = typecheck_result
    typecheck_result.diagnostics "nested semantic import typechecks" helpers::assert_no_errors
}
