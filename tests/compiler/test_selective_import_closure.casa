import "std" as std
import "../../compiler/selective_import.casa" as selective_import
import "../../compiler/typechecker.casa" as typechecker
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../compiler/syntax.casa" as syntax
import "helpers.casa" as helpers
import "../../lib/test.casa" as test

pub fn compute_test_closure
    source:$str
    requested:$std::List[std::String]
-> std::Result[selective_import::SelectiveImportClosure error::Diagnostics] {
    error::Diagnostics::new = diagnostics
    diagnostics source helpers::parse_resolve_test_parts = store = ops
    diagnostics "source parses" helpers::assert_no_errors
    ops drop
    common::empty_location requested.clone store selective_import::compute_selective_import_closure
}

pub fn get_closure_declarations
    result:std::Result[selective_import::SelectiveImportClosure error::Diagnostics]
-> std::List[selective_import::SelectiveImportDeclaration] {
    result match
        std::Result::Ok(closure) => closure.into_declarations
        std::Result::Error(_) => {
            "closure succeeds" false test::assert_true
            std::List[selective_import::SelectiveImportDeclaration]::new
        }
    end
}

pub fn get_declaration_names
    declarations:$std::List[selective_import::SelectiveImportDeclaration]
-> std::List[std::String] {
    std::List[std::String]::new = names
    for declaration in declarations.iter do
        declaration.get_name names.push
    done
    names
}

pub fn assert_closure_has names:$std::List[std::String] name:$str {
    f"closure contains {name}" name names common::string_list_contains test::assert_true
}

pub fn test_collects_symbol_and_type_dependencies {
    "collects_symbol_and_type_dependencies" test::test_start
    "const EXPLICIT 9\ntrait Base { }\ntrait Carrier[T]: Base { fn carry self:self -> T }\nstruct Leaf { value: i64 }\nimpl Leaf { fn double self:Leaf -> i64 { self Leaf::value 2 * } }\nstruct Box[T] { value: T }\nenum Choice { Pick(Leaf) }\nimpl Choice { fn code self:Choice -> i64 { self drop 1 } }\nfn leaf -> Leaf { 1 Leaf }\nfn referenced -> fn[-> Leaf] { &leaf }\nfn root[I: Carrier[Box[Leaf]]] item:I { item drop referenced drop 1 Leaf Choice::Pick drop }" = source
    std::List[std::String]::new = requested
    "root" requested.push_str
    "EXPLICIT" requested.push_str
    requested source compute_test_closure get_closure_declarations get_declaration_names = names

    "root" names assert_closure_has
    "referenced" names assert_closure_has
    "leaf" names assert_closure_has
    "EXPLICIT" names assert_closure_has
    "Base" names assert_closure_has
    "Carrier" names assert_closure_has
    "Leaf" names assert_closure_has
    "Leaf::double" names assert_closure_has
    "Box" names assert_closure_has
    "Choice" names assert_closure_has
    "Choice::code" names assert_closure_has
}

pub fn test_cycles_are_unique_and_dependency_ordered {
    "cycles_are_unique_and_dependency_ordered" test::test_start
    std::List[std::String]::new = requested
    "left" requested.push_str
    requested "fn left { right } fn right { left }" compute_test_closure
    get_closure_declarations get_declaration_names = names
    "unique declarations" 2 names.length test::assert_eq
    "dependency first" "right" 0 names.get test::assert_str_eq
    "requested root last" "left" 1 names.get test::assert_str_eq
}

pub fn test_multiple_roots_share_dependencies_in_order {
    "multiple_roots_share_dependencies_in_order" test::test_start
    std::List[std::String]::new = requested
    "left" requested.push_str
    "right" requested.push_str
    requested "fn shared { } fn left { shared } fn right { shared }" compute_test_closure
    get_closure_declarations get_declaration_names = names
    "unique declarations" 3 names.length test::assert_eq
    "shared dependency first" "shared" 0 names.get test::assert_str_eq
    "first root second" "left" 1 names.get test::assert_str_eq
    "second root last" "right" 2 names.get test::assert_str_eq
}

pub fn test_mixed_dependency_kinds_preserve_encounter_order {
    "mixed_dependency_kinds_preserve_encounter_order" test::test_start
    std::List[std::String]::new = requested
    "root" requested.push_str
    requested
    "fn helper -> i64 { 1 } struct Box { value: i64 } fn root { helper drop 1 Box drop }"
    compute_test_closure get_closure_declarations get_declaration_names = names
    "helper before later type"
    "Box" names common::string_list_index "helper" names common::string_list_index <
    test::assert_true
}

pub fn test_late_conflict_leaves_destination_unchanged {
    "late_conflict_leaves_destination_unchanged" test::test_start
    error::Diagnostics::new = source_diagnostics
    source_diagnostics
    "fn imported_fn { } const IMPORTED_CONST 1 struct ImportedStruct { value: i64 } enum ImportedEnum { One } trait ExistingTrait { }"
    helpers::parse_resolve_test_source = source
    source_diagnostics "source parses" helpers::assert_no_errors
    source.into_parts = parse_diagnostics = source_store = source_ops
    parse_diagnostics drop
    source_ops drop

    error::Diagnostics::new = destination_diagnostics
    destination_diagnostics "trait ExistingTrait { }" helpers::parse_resolve_test_source = destination
    destination_diagnostics "destination parses" helpers::assert_no_errors

    std::List[std::String]::new = requested
    "imported_fn" requested.push_str
    "IMPORTED_CONST" requested.push_str
    "ImportedStruct" requested.push_str
    "ImportedEnum" requested.push_str
    "ExistingTrait" requested.push_str
    common::empty_location requested destination.store source_store
    selective_import::merge_selective_import_closure = merge_result

    if merge_result std::Result::Error(diagnostics) is then
        diagnostics "late conflict count" 1 helpers::assert_error_count
        diagnostics "trait conflict" "existing trait" helpers::assert_error_contains
    else
        "late conflict fails" false test::assert_true
    fi
    "no function copied" 0 destination.store.count_functions test::assert_eq
    "no constant copied" 0 destination
        .store
        .constants
        .length test::assert_eq
    "no struct copied" 0 destination
        .store
        .structs
        .length test::assert_eq
    "no enum copied" 0 destination
        .store
        .enums
        .length test::assert_eq
    "existing trait retained" 1 destination
        .store
        .traits
        .length test::assert_eq
}

pub fn test_failures_return_diagnostics_without_a_partial_closure {
    "failures_return_diagnostics_without_a_partial_closure" test::test_start
    std::List[std::String]::new = requested
    "read_state" requested.push_str

    requested "global STATE 1 fn read_state -> i64 { STATE }" compute_test_closure
    get_closure_declarations get_declaration_names = immutable_names
    "immutable global dependency" "STATE" immutable_names common::string_list_contains test::assert_true

    std::List[std::String]::new = missing
    "missing" missing.push_str
    missing "fn present { }" compute_test_closure = missing_result
    if missing_result std::Result::Error(diagnostics) is then
        diagnostics "missing diagnostic count" 1 helpers::assert_error_count
        diagnostics "missing symbol" "not found in selective import" helpers::assert_error_contains
    else
        "missing symbol fails" false test::assert_true
    fi
}

pub fn test_collects_unqualified_method_dependencies {
    "collects_unqualified_method_dependencies" test::test_start
    std::List[std::String]::new = requested
    "root" requested.push_str
    requested
    "global STATE 1 impl bool { fn bumped self:bool -> i64 { STATE } } impl i64 { fn bumped self:i64 -> i64 { self 1 + } } pub fn root -> i64 { 1 .bumped }"
    compute_test_closure get_closure_declarations get_declaration_names = names
    "i64::bumped" names assert_closure_has
    "unused same-named method omitted" "bool::bumped" names common::string_list_contains ! test::assert_true
}

pub fn test_collects_concrete_generic_methods_with_type {
    "collects_concrete_generic_methods_with_type" test::test_start
    "pub struct Box[T] { value: T } impl Box[i64] { pub fn tag self:Box[i64] -> i64 { self drop 1 } } impl Box[bool] { pub fn tag self:Box[bool] -> bool { self drop true } }"
    = source
    std::List[std::String]::new = requested
    "Box" requested.push_str
    requested source
    compute_test_closure get_closure_declarations get_declaration_names = names
    "Box[i64]::tag" names assert_closure_has
    "Box[bool]::tag" names assert_closure_has

    lexer::SourceStore::new = sources
    source "/tmp/casa_selective_concrete_generic_methods.casa" sources.add
    "Box"
    "import \"/tmp/casa_selective_concrete_generic_methods.casa\" as module { Box } 1 Box .tag drop true Box .tag drop"
    lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    sources lex_diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve = result
    result.into_parts = parse_diagnostics = store = ops
    parse_diagnostics "concrete methods resolve after import" helpers::assert_no_errors
    store ops.unwrap typechecker::type_check = typecheck_result
    typecheck_result.diagnostics "concrete methods typecheck after import" helpers::assert_no_errors
}

pub fn test_concrete_generic_private_method_stays_private {
    "concrete_generic_private_method_stays_private" test::test_start
    lexer::SourceStore::new = sources
    "pub struct Box[T] { value: T } impl Box[i64] { fn secret self:Box[i64] -> i64 { self drop 1 } }"
    "/tmp/casa_selective_concrete_private_method.casa"
    sources.add
    "Box"
    "import \"/tmp/casa_selective_concrete_private_method.casa\" as module { Box } 1 Box .secret drop"
    lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    sources lex_diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve = result
    result.into_parts = parse_diagnostics = store = ops
    parse_diagnostics "private concrete method resolves" helpers::assert_no_errors
    store ops.unwrap typechecker::type_check = typecheck_result
    typecheck_result.diagnostics "private concrete method rejected" "private"
    helpers::assert_error_contains

    lexer::SourceStore::new = reference_sources
    "pub struct Box[T] { value: T } impl Box[i64] { fn secret self:Box[i64] -> i64 { self drop 1 } }"
    "/tmp/casa_selective_concrete_private_method.casa"
    reference_sources.add
    "Box"
    "import \"/tmp/casa_selective_concrete_private_method.casa\" as module { Box } &Box[i64]::secret drop"
    lexer::lex_source = reference_lex_result
    reference_lex_result.into_parts = reference_lex_diagnostics = reference_tokens
    reference_sources reference_lex_diagnostics std::List[std::String]::new reference_tokens
    syntax::parse_and_resolve
    = reference_result
    reference_result.into_parts = reference_diagnostics = reference_store = reference_ops
    reference_store drop
    reference_ops drop
    reference_diagnostics "private concrete reference rejected" "private"
    helpers::assert_error_contains

    lexer::SourceStore::new = trait_reference_sources
    "pub trait Tagged { fn secret self:self -> i64 } pub struct Box[T] { value: T } impl Box[i64]: Tagged { fn secret self:Box[i64] -> i64 { self drop 1 } }"
    "/tmp/casa_selective_concrete_private_trait_method.casa"
    trait_reference_sources.add
    "Box"
    "Tagged"
    "import \"/tmp/casa_selective_concrete_private_trait_method.casa\" as module { Box Tagged } &Box[i64]::Tagged::secret drop"
    lexer::lex_source = trait_reference_lex_result
    trait_reference_lex_result.into_parts = trait_reference_lex_diagnostics = trait_reference_tokens
    trait_reference_sources trait_reference_lex_diagnostics std::List[std::String]::new
    trait_reference_tokens syntax::parse_and_resolve
    = trait_reference_result
    trait_reference_result.into_parts
    = trait_reference_diagnostics = trait_reference_store = trait_reference_ops
    trait_reference_store drop
    trait_reference_ops drop
    trait_reference_diagnostics "private concrete trait reference rejected" "private"
    helpers::assert_error_contains
}

pub fn test_module_qualified_concrete_method_reference {
    "module_qualified_concrete_method_reference" test::test_start
    lexer::SourceStore::new = sources
    "pub struct Box[T] { value: T } impl Box[i64] { pub fn tag self:Box[i64] -> i64 { self drop 1 } }"
    "/tmp/casa_module_qualified_concrete_method.casa"
