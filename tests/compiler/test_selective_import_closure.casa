pub fn test_tracks_receiver_types_through_stack_operations {
    "tracks_receiver_types_through_stack_operations" test::test_start
    "impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root i64 -> i64 { .picked }"
    = source
    std::List[std::String]::new = requested
    "root" requested.push_str
    requested source compute_test_closure get_closure_declarations get_declaration_names = names
    "i64::picked" names assert_closure_has
    "other method omitted" "bool::picked" names common::string_list_contains ! test::assert_true

    "impl i64 { fn picked self:i64 -> i64 { self } } impl bool { fn picked self:bool -> i64 { self drop 1 } } fn root -> i64 { 1 true swap .picked }"
    = swap_source
    requested swap_source compute_test_closure get_closure_declarations
    get_declaration_names = swap_names
    "i64::picked" swap_names assert_closure_has
    "pre-swap receiver omitted" "bool::picked" swap_names common::string_list_contains ! test::assert_true

    "impl array { fn picked self:array[i64 2] -> i64 { self drop 1 } } fn root -> i64 { [1, 2] .picked }"
    = array_source
    requested array_source compute_test_closure get_closure_declarations
    get_declaration_names = array_names
    "array::picked" array_names assert_closure_has
}

