import "std" as std
import "../../lib/test.casa" as test

# ============================================================================
# List.contains
# ============================================================================
"contains finds present element" test::test_start
"b" ["a", "b", "c"].contains = found
"should find 'b' in list" found test::assert_true
"contains returns false for absent element" test::test_start
"z" ["a", "b", "c"].contains = not_found
"should not find 'z' in list" not_found test::assert_false
"contains on empty list" test::test_start
"a" std::List[str]::new.contains = empty_result
"should return false for empty list" empty_result test::assert_false
"List contains finds present element" test::test_start
std::List[str]::new = items
"x" items.push
"y" items.push
"z" items.push
"y" items.contains = list_found
"should find 'y' in List" list_found test::assert_true
"List contains returns false for absent element" test::test_start
"w" items.contains = list_not_found
"should not find 'w' in List" list_not_found test::assert_false
"List contains on empty list" test::test_start
"a" std::List[str]::new.contains = list_empty
"should return false for empty List" list_empty test::assert_false
"contains finds first element" test::test_start
"a" ["a", "b", "c"].contains = first
"should find first element" first test::assert_true
"contains finds last element" test::test_start
"c" ["a", "b", "c"].contains = last
"should find last element" last test::assert_true
test::test_summary
