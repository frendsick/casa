import "../../compiler/typechecker.casa"
import "helpers.casa"

# ============================================================================
# Constants
# ============================================================================
"trait Eq {\n    fn eq self:self other:self -> bool\n\n    fn ne self:self other:self -> bool {\n        other self.eq !\n    }\n}\n\ntrait Ord {\n    fn lt self:self other:self -> bool\n\n    fn le self:self other:self -> bool {\n        self other.lt !\n    }\n\n    fn gt self:self other:self -> bool {\n        self other.lt\n    }\n\n    fn ge self:self other:self -> bool {\n        other self.lt !\n    }\n}\n" = EQ_ORD_TRAITS

# ============================================================================
# Helpers
# ============================================================================

fn compare_test_typecheck code:$str diagnostics:mut$Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops type_check_ops_for_test
}

fn compare_test_typecheck_ops code:$str diagnostics:mut$Diagnostics -> List[Op] {
    diagnostics code parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops type_check_ops_for_test drop
    ops
}

fn compare_test_typecheck_error code:$str diagnostics:mut$Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops type_check_ops_for_test
}

# ============================================================================
# Primitives: bytecode equality keeps working without trait declarations
# ============================================================================

fn test_eq_primitive_int_passes {
    Diagnostics::new = diagnostics
    "eq_primitive_int_passes" test_start
    diagnostics "1 2 == drop" compare_test_typecheck drop
    diagnostics "no errors for i64 ==" assert_no_errors
}

fn test_lt_primitive_int_passes {
    Diagnostics::new = diagnostics
    "lt_primitive_int_passes" test_start
    diagnostics "1 2 < drop" compare_test_typecheck drop
    diagnostics "no errors for i64 <" assert_no_errors
}

# ============================================================================
# Enums: tag comparison keeps working
# ============================================================================

fn test_enum_with_eq_compares {
    Diagnostics::new = diagnostics
    "enum_with_eq_compares" test_start
    diagnostics EQ_ORD_TRAITS "enum Color { Red Green Blue }\nimpl Color { fn eq self:Color other:Color -> bool { self other == } }\nColor::Red Color::Green == drop\n" str::concat.as_str compare_test_typecheck drop
    diagnostics "no errors for enum with impl Eq ==" assert_no_errors
}

# ============================================================================
# User struct: == lowers to MethodCall when impl Eq exists
# ============================================================================

fn test_user_struct_with_eq_lowers_to_method_call {
    Diagnostics::new = diagnostics
    "user_struct_with_eq_lowers_to_method_call" test_start
    diagnostics EQ_ORD_TRAITS "struct Tag { val: i64 }\nimpl Tag: Eq { fn eq self:Tag other:Tag -> bool { self.val other.val == } }\n1 Tag = a\n2 Tag = b\na b == drop\n" str::concat.as_str compare_test_typecheck_ops = ops
    diagnostics "no errors for struct with impl Eq" assert_no_errors
    0 (u64) = i
    0 = fn_call_count
    while i ops.length > do
        if i ops.get.value OpValue::FnCall(callee) is then
            if "Tag::Eq::eq" callee == then
                1 += fn_call_count
            fi
        fi
        1 += i
    done
    "exactly one Tag::eq call" 1 fn_call_count assert_eq
}

# ============================================================================
# User struct without impl Eq: == fails with Eq-bound error
# ============================================================================

fn test_user_struct_without_eq_fails {
    Diagnostics::new = diagnostics
    "user_struct_without_eq_fails" test_start
    diagnostics EQ_ORD_TRAITS "struct NoEq { val: i64 }\n1 NoEq = a\n2 NoEq = b\na b == drop\n" str::concat.as_str compare_test_typecheck_error drop
    diagnostics "has errors" assert_has_errors
    diagnostics "error mentions Eq trait" "Eq" assert_error_contains
    diagnostics "missing trait method error kind" ErrorKind::MissingTraitMethod assert_error_kind
}

# ============================================================================
# User struct with impl Eq but no impl Ord: < fails with Ord-bound error
# ============================================================================

fn test_user_struct_with_eq_but_no_ord_fails_lt {
    Diagnostics::new = diagnostics
    "user_struct_with_eq_but_no_ord_fails_lt" test_start
    diagnostics EQ_ORD_TRAITS "struct Tag { val: i64 }\nimpl Tag: Eq { fn eq self:Tag other:Tag -> bool { self.val other.val == } }\n1 Tag = a\n2 Tag = b\na b < drop\n" str::concat.as_str compare_test_typecheck_error drop
    diagnostics "has errors" assert_has_errors
    diagnostics "error mentions Ord trait" "Ord" assert_error_contains
    diagnostics "missing trait method error kind" ErrorKind::MissingTraitMethod assert_error_kind
}

# ============================================================================
# Same-type rule preserved: comparing different types still fails
# ============================================================================

fn test_eq_different_types_fails {
    Diagnostics::new = diagnostics
    "eq_different_types_fails" test_start
    diagnostics "42 \"hello\" == drop" compare_test_typecheck_error drop
    diagnostics "has errors" assert_has_errors
    diagnostics "type mismatch error kind" ErrorKind::TypeMismatch assert_error_kind
}

# ============================================================================
# Run all tests
# ============================================================================
test_eq_primitive_int_passes
test_lt_primitive_int_passes
test_enum_with_eq_compares
test_user_struct_with_eq_lowers_to_method_call
test_user_struct_without_eq_fails
test_user_struct_with_eq_but_no_ord_fails_lt
test_eq_different_types_fails
test_summary
