import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

# ============================================================================
# Constants
# ============================================================================
"enum __casa_std__Ordering derives __casa_std__Eq { Less Equal Greater }\nenum __casa_std__Option[T] { None Some(T) }\n\ntrait __casa_std__PartialEq {\n    fn eq self:$self other:$self -> bool\n\n    fn ne self:$self other:$self -> bool {\n        other self.eq !\n    }\n}\n\ntrait __casa_std__Eq: __casa_std__PartialEq { }\n\ntrait __casa_std__PartialOrd: __casa_std__PartialEq {\n    fn partial_cmp self:$self other:$self -> __casa_std__Option[__casa_std__Ordering]\n\n    fn lt self:$self other:$self -> bool {\n        other self.partial_cmp = result\n        if result __casa_std__Option::Some(ordering) is then\n            ordering __casa_std__Ordering::Less ==\n        else\n            false\n        fi\n    }\n\n    fn le self:$self other:$self -> bool {\n        other self.partial_cmp = result\n        if result __casa_std__Option::Some(ordering) is then\n            ordering __casa_std__Ordering::Greater !=\n        else\n            false\n        fi\n    }\n\n    fn gt self:$self other:$self -> bool {\n        other self.partial_cmp = result\n        if result __casa_std__Option::Some(ordering) is then\n            ordering __casa_std__Ordering::Greater ==\n        else\n            false\n        fi\n    }\n\n    fn ge self:$self other:$self -> bool {\n        other self.partial_cmp = result\n        if result __casa_std__Option::Some(ordering) is then\n            ordering __casa_std__Ordering::Less !=\n        else\n            false\n        fi\n    }\n}\n\ntrait __casa_std__Ord: __casa_std__PartialOrd + __casa_std__Eq {\n    fn cmp self:$self other:$self -> __casa_std__Ordering\n\n    fn partial_cmp self:$self other:$self -> __casa_std__Option[__casa_std__Ordering] {\n        other self.cmp __casa_std__Option::Some\n    }\n}\n" = COMPARISON_TRAITS

# ============================================================================
# Helpers
# ============================================================================

pub fn compare_test_typecheck code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

pub fn compare_test_typecheck_ops
    code:$str
    diagnostics:mut$error::Diagnostics
-> std::List[common::Op] {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test drop
    ops
}

pub fn compare_test_typecheck_error
    code:$str
    diagnostics:mut$error::Diagnostics
-> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

# ============================================================================
# Primitives: bytecode equality keeps working without trait declarations
# ============================================================================

pub fn test_eq_primitive_int_passes {
    error::Diagnostics::new = diagnostics
    "eq_primitive_int_passes" test::test_start
    diagnostics "1 2 == drop" compare_test_typecheck drop
    diagnostics "no errors for i64 ==" helpers::assert_no_errors
}

pub fn test_lt_primitive_int_passes {
    error::Diagnostics::new = diagnostics
    "lt_primitive_int_passes" test::test_start
    diagnostics "1 2 < drop" compare_test_typecheck drop
    diagnostics "no errors for i64 <" helpers::assert_no_errors
}

# ============================================================================
# Enums: derived equality lowers through the trait method
# ============================================================================

pub fn test_enum_with_eq_compares {
    error::Diagnostics::new = diagnostics
    "enum_with_eq_compares" test::test_start
    diagnostics COMPARISON_TRAITS "enum Color derives __casa_std__Eq { Red Green Blue }\nColor::Red Color::Green == drop\n" str::concat.as_str compare_test_typecheck drop
    diagnostics "no errors for enum with derived Eq ==" helpers::assert_no_errors
}

# ============================================================================
# User struct: == lowers to MethodCall when impl Eq exists
# ============================================================================

pub fn test_user_struct_with_eq_lowers_to_method_call {
    error::Diagnostics::new = diagnostics
    "user_struct_with_eq_lowers_to_method_call" test::test_start
    diagnostics COMPARISON_TRAITS "struct Tag { val: i64 }\nimpl Tag: __casa_std__Eq { fn eq self:$Tag other:$Tag -> bool { self.val other.val == } }\n1 Tag = a\n2 Tag = b\na b == drop\n" str::concat.as_str compare_test_typecheck_ops = ops
    diagnostics "no errors for struct with impl Eq" helpers::assert_no_errors
    0 (u64) = i
    0 = fn_call_count
    while i ops.length > do
        if i ops.get.value common::OpValue::FnCall(callee) is then
            if "Tag::__casa_std__Eq::eq" callee == then
                1 += fn_call_count
            fi
        fi
        1 += i
    done
    "exactly one Tag::eq call" 1 fn_call_count test::assert_eq
}

# ============================================================================
# User struct without impl Eq: == fails with Eq-bound error
# ============================================================================

pub fn test_user_struct_without_eq_fails {
    error::Diagnostics::new = diagnostics
    "user_struct_without_eq_fails" test::test_start
    diagnostics COMPARISON_TRAITS "struct NoEq { val: i64 }\n1 NoEq = a\n2 NoEq = b\na b == drop\n" str::concat.as_str compare_test_typecheck_error drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "error mentions PartialEq trait" "PartialEq" helpers::assert_error_contains
    diagnostics "missing trait method error kind" common::ErrorKind::MissingTraitMethod helpers::assert_error_kind
}

# ============================================================================
# User struct with impl Eq but no impl PartialOrd: < fails
# ============================================================================

pub fn test_user_struct_with_eq_but_no_ord_fails_lt {
    error::Diagnostics::new = diagnostics
    "user_struct_with_eq_but_no_ord_fails_lt" test::test_start
    diagnostics COMPARISON_TRAITS "struct Tag { val: i64 }\nimpl Tag: __casa_std__Eq { fn eq self:$Tag other:$Tag -> bool { self.val other.val == } }\n1 Tag = a\n2 Tag = b\na b < drop\n" str::concat.as_str compare_test_typecheck_error drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "error mentions PartialOrd trait" "PartialOrd" helpers::assert_error_contains
    diagnostics "missing trait method error kind" common::ErrorKind::MissingTraitMethod helpers::assert_error_kind
}

pub fn test_partial_comparison_traits_drive_operators {
    error::Diagnostics::new = diagnostics
    "partial_comparison_traits_drive_operators" test::test_start
    diagnostics COMPARISON_TRAITS "struct Reading { value: i64 }\nimpl Reading: __casa_std__PartialOrd {\n    fn eq self:$Reading other:$Reading -> bool { self.value other.value == }\n    fn partial_cmp self:$Reading other:$Reading -> __casa_std__Option[__casa_std__Ordering] {\n        if other.value self.value < then __casa_std__Ordering::Less\n        elif other.value self.value > then __casa_std__Ordering::Greater\n        else __casa_std__Ordering::Equal fi __casa_std__Option::Some\n    }\n}\n1 Reading = a\n2 Reading = b\na b != drop\na b < drop\n" str::concat.as_str compare_test_typecheck drop
    diagnostics "partial traits support equality and ordering operators" helpers::assert_no_errors
}

pub fn test_ord_supplies_partial_contracts {
    error::Diagnostics::new = diagnostics
    "ord_supplies_partial_contracts" test::test_start
    diagnostics COMPARISON_TRAITS "struct Reading { value: i64 }\nimpl Reading: __casa_std__Ord {\n    fn eq self:$Reading other:$Reading -> bool { self.value other.value == }\n    fn cmp self:$Reading other:$Reading -> __casa_std__Ordering {\n        if other.value self.value < then __casa_std__Ordering::Less\n        elif other.value self.value > then __casa_std__Ordering::Greater\n        else __casa_std__Ordering::Equal fi\n    }\n}\n1 Reading = a\n2 Reading = b\na b == drop\na b >= drop\n" str::concat.as_str compare_test_typecheck drop
    diagnostics "Ord supplies inherited partial contracts" helpers::assert_no_errors
}

pub fn test_ne_operator_uses_ne_method {
    error::Diagnostics::new = diagnostics
    "ne_operator_uses_ne_method" test::test_start
    diagnostics COMPARISON_TRAITS "struct Tag { val: i64 }\nimpl Tag: __casa_std__PartialEq {\n    fn eq self:$Tag other:$Tag -> bool { self drop other drop false }\n    fn ne self:$Tag other:$Tag -> bool { self drop other drop true }\n}\n1 Tag = a\n2 Tag = b\na b != drop\n" str::concat.as_str compare_test_typecheck_ops = ops
    diagnostics "custom ne is accepted" helpers::assert_no_errors
    0 (u64) = i
    false = found_ne
    while i ops.length > do
        if i ops.get.value common::OpValue::FnCall(callee) is then
            if "Tag::__casa_std__PartialEq::ne" callee == then
                true = found_ne
            fi
        fi
        1 += i
    done
    "!= calls PartialEq.ne" found_ne test::assert_true
}

# ============================================================================
# Same-type rule preserved: comparing different types still fails
# ============================================================================

pub fn test_eq_different_types_fails {
    error::Diagnostics::new = diagnostics
    "eq_different_types_fails" test::test_start
    diagnostics "42 \"hello\" == drop" compare_test_typecheck_error drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "type mismatch error kind" common::ErrorKind::TypeMismatch helpers::assert_error_kind
}

pub fn test_standard_comparison_methods {
    "standard_comparison_methods" test::test_start
    "f64 partial_cmp orders values" 2.0 1.0.partial_cmp.unwrap std::Ordering::Less == test::assert_true
    "f64 partial_cmp rejects NaN" 1.0 f64::nan.partial_cmp.is_none test::assert_true
    "integer cmp is total" 2 (i32) 1 (i32).cmp std::Ordering::Less == test::assert_true
}

# ============================================================================
# Run all tests
# ============================================================================
test_eq_primitive_int_passes
test_lt_primitive_int_passes
test_enum_with_eq_compares
test_user_struct_with_eq_lowers_to_method_call
test_user_struct_without_eq_fails
test_user_struct_with_eq_but_no_ord_fails_lt
test_partial_comparison_traits_drive_operators
test_ord_supplies_partial_contracts
test_ne_operator_uses_ne_method
test_eq_different_types_fails
test_standard_comparison_methods
test::test_summary
