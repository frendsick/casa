import "../../compiler/typechecker.casa"
import "helpers.casa"

# ============================================================================
# Constants
# ============================================================================
"enum Ordering { Less Equal Greater }\nenum Option[T] { None Some(T) }\n\ntrait PartialEq {\n    fn eq self:$self other:$self -> bool\n\n    fn ne self:$self other:$self -> bool {\n        other self.eq !\n    }\n}\n\ntrait Eq: PartialEq { }\n\ntrait PartialOrd: PartialEq {\n    fn partial_cmp self:$self other:$self -> Option[Ordering]\n\n    fn lt self:$self other:$self -> bool {\n        other self.partial_cmp = result\n        if result Option::Some(ordering) is then\n            ordering Ordering::Less ==\n        else\n            false\n        fi\n    }\n\n    fn le self:$self other:$self -> bool {\n        other self.partial_cmp = result\n        if result Option::Some(ordering) is then\n            ordering Ordering::Greater !=\n        else\n            false\n        fi\n    }\n\n    fn gt self:$self other:$self -> bool {\n        other self.partial_cmp = result\n        if result Option::Some(ordering) is then\n            ordering Ordering::Greater ==\n        else\n            false\n        fi\n    }\n\n    fn ge self:$self other:$self -> bool {\n        other self.partial_cmp = result\n        if result Option::Some(ordering) is then\n            ordering Ordering::Less !=\n        else\n            false\n        fi\n    }\n}\n\ntrait Ord: PartialOrd + Eq {\n    fn cmp self:$self other:$self -> Ordering\n\n    fn partial_cmp self:$self other:$self -> Option[Ordering] {\n        other self.cmp Option::Some\n    }\n}\n" = COMPARISON_TRAITS

# ============================================================================
# Helpers
# ============================================================================

fn compare_test_typecheck code:$str diagnostics:mut$Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops type_check_ops_for_test
}

fn compare_test_typecheck_ops code:$str diagnostics:mut$Diagnostics -> List[Op] {
    diagnostics code parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops type_check_ops_for_test drop
    ops
}

fn compare_test_typecheck_error code:$str diagnostics:mut$Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops type_check_ops_for_test
}

# ============================================================================
# Primitives: bytecode equality keeps working without trait declarations
# ============================================================================

fn test_eq_primitive_int_passes {
    Diagnostics::new = diagnostics
    "eq_primitive_int_passes" test_start
    diagnostics "1 2 == drop" compare_test_typecheck drop
    diagnostics "no errors for i64 ==" assert_no_errors
}

fn test_lt_primitive_int_passes {
    Diagnostics::new = diagnostics
    "lt_primitive_int_passes" test_start
    diagnostics "1 2 < drop" compare_test_typecheck drop
    diagnostics "no errors for i64 <" assert_no_errors
}

# ============================================================================
# Enums: tag comparison keeps working
# ============================================================================

fn test_enum_with_eq_compares {
    Diagnostics::new = diagnostics
    "enum_with_eq_compares" test_start
    diagnostics COMPARISON_TRAITS "enum Color { Red Green Blue }\nimpl Color { fn eq self:Color other:Color -> bool { self other == } }\nColor::Red Color::Green == drop\n" str::concat.as_str compare_test_typecheck drop
    diagnostics "no errors for enum with impl Eq ==" assert_no_errors
}

# ============================================================================
# User struct: == lowers to MethodCall when impl Eq exists
# ============================================================================

fn test_user_struct_with_eq_lowers_to_method_call {
    Diagnostics::new = diagnostics
    "user_struct_with_eq_lowers_to_method_call" test_start
    diagnostics COMPARISON_TRAITS "struct Tag { val: i64 }\nimpl Tag: Eq { fn eq self:$Tag other:$Tag -> bool { self.val other.val == } }\n1 Tag = a\n2 Tag = b\na b == drop\n" str::concat.as_str compare_test_typecheck_ops = ops
    diagnostics "no errors for struct with impl Eq" assert_no_errors
    0 (u64) = i
    0 = fn_call_count
    while i ops.length > do
        if i ops.get.value OpValue::FnCall(callee) is then
            if "Tag::Eq::eq" callee == then
                1 += fn_call_count
            fi
        fi
        1 += i
    done
    "exactly one Tag::eq call" 1 fn_call_count assert_eq
}

# ============================================================================
# User struct without impl Eq: == fails with Eq-bound error
# ============================================================================

fn test_user_struct_without_eq_fails {
    Diagnostics::new = diagnostics
    "user_struct_without_eq_fails" test_start
    diagnostics COMPARISON_TRAITS "struct NoEq { val: i64 }\n1 NoEq = a\n2 NoEq = b\na b == drop\n" str::concat.as_str compare_test_typecheck_error drop
    diagnostics "has errors" assert_has_errors
    diagnostics "error mentions PartialEq trait" "PartialEq" assert_error_contains
    diagnostics "missing trait method error kind" ErrorKind::MissingTraitMethod assert_error_kind
}

# ============================================================================
# User struct with impl Eq but no impl PartialOrd: < fails
# ============================================================================

fn test_user_struct_with_eq_but_no_ord_fails_lt {
    Diagnostics::new = diagnostics
    "user_struct_with_eq_but_no_ord_fails_lt" test_start
    diagnostics COMPARISON_TRAITS "struct Tag { val: i64 }\nimpl Tag: Eq { fn eq self:$Tag other:$Tag -> bool { self.val other.val == } }\n1 Tag = a\n2 Tag = b\na b < drop\n" str::concat.as_str compare_test_typecheck_error drop
    diagnostics "has errors" assert_has_errors
    diagnostics "error mentions PartialOrd trait" "PartialOrd" assert_error_contains
    diagnostics "missing trait method error kind" ErrorKind::MissingTraitMethod assert_error_kind
}

fn test_partial_comparison_traits_drive_operators {
    Diagnostics::new = diagnostics
    "partial_comparison_traits_drive_operators" test_start
    diagnostics COMPARISON_TRAITS "struct Reading { value: i64 }\nimpl Reading: PartialOrd {\n    fn eq self:$Reading other:$Reading -> bool { self.value other.value == }\n    fn partial_cmp self:$Reading other:$Reading -> Option[Ordering] {\n        if other.value self.value < then Ordering::Less\n        elif other.value self.value > then Ordering::Greater\n        else Ordering::Equal fi Option::Some\n    }\n}\n1 Reading = a\n2 Reading = b\na b != drop\na b < drop\n" str::concat.as_str compare_test_typecheck drop
    diagnostics "partial traits support equality and ordering operators" assert_no_errors
}

fn test_ord_supplies_partial_contracts {
    Diagnostics::new = diagnostics
    "ord_supplies_partial_contracts" test_start
    diagnostics COMPARISON_TRAITS "struct Reading { value: i64 }\nimpl Reading: Ord {\n    fn eq self:$Reading other:$Reading -> bool { self.value other.value == }\n    fn cmp self:$Reading other:$Reading -> Ordering {\n        if other.value self.value < then Ordering::Less\n        elif other.value self.value > then Ordering::Greater\n        else Ordering::Equal fi\n    }\n}\n1 Reading = a\n2 Reading = b\na b == drop\na b >= drop\n" str::concat.as_str compare_test_typecheck drop
    diagnostics "Ord supplies inherited partial contracts" assert_no_errors
}

fn test_ne_operator_uses_ne_method {
    Diagnostics::new = diagnostics
    "ne_operator_uses_ne_method" test_start
    diagnostics COMPARISON_TRAITS "struct Tag { val: i64 }\nimpl Tag: PartialEq {\n    fn eq self:$Tag other:$Tag -> bool { self drop other drop false }\n    fn ne self:$Tag other:$Tag -> bool { self drop other drop true }\n}\n1 Tag = a\n2 Tag = b\na b != drop\n" str::concat.as_str compare_test_typecheck_ops = ops
    diagnostics "custom ne is accepted" assert_no_errors
    0 (u64) = i
    false = found_ne
    while i ops.length > do
        if i ops.get.value OpValue::FnCall(callee) is then
            if "Tag::PartialEq::ne" callee == then
                true = found_ne
            fi
        fi
        1 += i
    done
    "!= calls PartialEq.ne" found_ne assert_true
}

# ============================================================================
# Same-type rule preserved: comparing different types still fails
# ============================================================================

fn test_eq_different_types_fails {
    Diagnostics::new = diagnostics
    "eq_different_types_fails" test_start
    diagnostics "42 \"hello\" == drop" compare_test_typecheck_error drop
    diagnostics "has errors" assert_has_errors
    diagnostics "type mismatch error kind" ErrorKind::TypeMismatch assert_error_kind
}

fn test_standard_comparison_methods {
    "standard_comparison_methods" test_start
    "f64 partial_cmp orders values" 2.0 1.0.partial_cmp.unwrap Ordering::Less == assert_true
    "f64 partial_cmp rejects NaN" 1.0 f64::nan.partial_cmp.is_none assert_true
    "integer cmp is total" 2 (i32) 1 (i32).cmp Ordering::Less == assert_true
}

# ============================================================================
# Run all tests
# ============================================================================
test_eq_primitive_int_passes
test_lt_primitive_int_passes
test_enum_with_eq_compares
test_user_struct_with_eq_lowers_to_method_call
test_user_struct_without_eq_fails
test_user_struct_with_eq_but_no_ord_fails_lt
test_partial_comparison_traits_drive_operators
test_ord_supplies_partial_contracts
test_ne_operator_uses_ne_method
test_eq_different_types_fails
test_standard_comparison_methods
test_summary
