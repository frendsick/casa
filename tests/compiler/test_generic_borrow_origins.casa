import "std" as std
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

const PRELUDE "import \"lib/std.casa\" as std struct Slot[T] { value:std::Option[T] } fn wrap[T] item:T -> Slot[T] { item std::Option::Some Slot } fn put[T] slot:mut$Slot[T] item:T { item std::Option::Some = slot.value } impl Slot[T] { fn put self:mut$Slot[T] item:T { item std::Option::Some = self.value } } "

fn accepts source:$str {
    error::Diagnostics::new = diagnostics
    PRELUDE source str::concat = code
    diagnostics code.as_str helpers::typecheck_test_source = checked
    checked.get_diagnostics.clone diagnostics.merge
    if diagnostics.has_errors then
        for entry in diagnostics.entries.iter do
            if entry error::Diagnostic::Error(failure) is then
                failure.message.as_str std::println
            fi
        done
    fi
    diagnostics source helpers::assert_no_errors
}

fn rejects source:$str message:$str {
    error::Diagnostics::new = diagnostics
    PRELUDE source str::concat = code
    diagnostics code.as_str helpers::typecheck_test_source = checked
    checked.get_diagnostics.clone diagnostics.merge
    if message diagnostics helpers::diagnostics_error_contains ! then
        for entry in diagnostics.entries.iter do
            if entry error::Diagnostic::Error(failure) is then
                failure.message.as_str std::println
            fi
        done
    fi
    diagnostics source message helpers::assert_error_contains
}

fn test_mutable_alias_origins {
    "mutable_alias_origins" test::test_start
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text slot = alias:mut$Slot[$str] text.as_str alias put alias drop text drop if slot.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text slot = alias:mut$Slot[$str] text.as_str std::Option::Some = alias.value alias drop text drop if slot.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text slot = alias:mut$Slot[$str] alias = nested:mut$Slot[$str] text.as_str nested put nested drop alias drop text drop if slot.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text slot = alias:mut$Slot[$str] text.as_str alias put text drop if alias.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn borrow[T] slot:mut$Slot[T] -> mut$Slot[T] { slot } std::Option[$str]::None Slot = slot \"hello\".to_str = text slot borrow = alias text.as_str alias put text drop if alias.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn borrow[T] slot:mut$Slot[T] -> mut$Slot[T] { slot } std::Option[$str]::None Slot = slot \"hello\".to_str = text slot borrow = alias alias = nested:mut$Slot[$str] text.as_str std::Option::Some = nested.value nested drop text drop if alias.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text slot = alias:mut$Slot[$str] text.as_str alias put if alias.value std::Option::Some(value) is then value print fi alias drop slot drop text drop" accepts
    "fn borrow[T] slot:mut$Slot[T] -> mut$Slot[T] { slot } std::Option[$str]::None Slot = slot \"hello\".to_str = text slot borrow = alias text.as_str alias put if alias.value std::Option::Some(value) is then value print fi alias drop slot drop text drop" accepts
}

fn test_stack_storage_origins {
    "stack_storage_origins" test::test_start
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text slot text.as_str slot put = saved text drop if saved.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text slot text.as_str std::Option::Some = slot.value = saved text drop if saved.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn put_return[T] slot:mut$Slot[T] item:T -> mut$Slot[T] { slot item slot put } std::Option[$str]::None Slot = slot \"hello\".to_str = text text.as_str slot put_return = alias text drop if alias.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn put_return[T] slot:mut$Slot[T] item:T -> mut$Slot[T] { slot item slot put return } std::Option[$str]::None Slot = slot \"hello\".to_str = text text.as_str slot put_return = alias text drop if alias.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text slot if true then text.as_str slot put fi = saved text drop if saved.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "impl[T] Slot[T] { fn drop self:mut$Slot[T] { self.value drop } } std::Option[$str]::None Slot = slot \"hello\".to_str = text slot text.as_str slot put = saved text drop"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text slot text.as_str slot put = saved if saved.value std::Option::Some(value) is then value print fi saved drop text drop" accepts
    "fn put_return[T] slot:mut$Slot[T] item:T -> mut$Slot[T] { slot item slot put } std::Option[$str]::None Slot = slot \"hello\".to_str = text text.as_str slot put_return = alias if alias.value std::Option::Some(value) is then value print fi alias drop slot drop text drop" accepts
    "struct Snapshot derives std::Copy { value:$str } \"first\".to_str = first \"second\".to_str = second first.as_str Snapshot = current current second.as_str = current.value = saved current drop second drop saved.value print" accepts
    "std::Option[$str]::None Slot = left std::Option[$str]::None Slot = right \"hello\".to_str = text right text.as_str left put = saved left drop text drop saved.value drop" accepts
}

pub fn run_tests {
    test_mutable_alias_origins
    test_stack_storage_origins
    "generic_borrow_origins" test::test_start
    "\"hello\".to_str = text text.as_str wrap = slot if slot.value std::Option::Some(view) is then view print fi slot drop text drop" accepts
    "\"hello\".to_str = text text.as_str wrap = slot text drop if slot.value std::Option::Some(view) is then view print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "\"hello\".to_str = text text.as_str = view view wrap = slot text drop if slot.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn local -> Slot[$str] { \"hello\".to_str = text text.as_str wrap }"
    "Borrowed return escapes local owner `text`" swap rejects
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text text.as_str slot put text drop if slot.value std::Option::Some(view) is then view print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text text.as_str slot.put text drop if slot.value std::Option::Some(view) is then view print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn local slot:mut$Slot[$str] { \"hello\".to_str = text text.as_str slot put }"
    "Stored borrow escapes local owner `text`" swap rejects
    "fn select[T] slot:mut$Slot[T] kept:T unused:T { unused drop kept slot put } \"hello\".to_str = text \"other\".to_str = other std::Option[$str]::None Slot = slot other.as_str text.as_str slot select other drop if slot.value std::Option::Some(view) is then view print fi slot drop text drop" accepts
    "struct Context[T] { slot:mut$Slot[T] } fn through[T] context:Context[T] item:T { item context.slot put } std::Option[$str]::None Slot = slot \"hello\".to_str = text text.as_str slot Context through text drop if slot.value std::Option::Some(view) is then view print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "struct Context[T] { slot:mut$Slot[T] } fn through[T] context:mut$Context[T] item:T { item context.slot put } std::Option[$str]::None Slot = slot slot Context = context \"hello\".to_str = text text.as_str context through context drop text drop if slot.value std::Option::Some(view) is then view print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "\"hello\".to_str = text text.as_str std::Shared::new = shared text drop shared.get print"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "\"hello\".to_str = text text.as_str std::Shared::new = shared shared.clone = duplicate shared drop text drop duplicate.get print"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "\"hello\".to_str = text std::List[$str]::new = values text.as_str values.push text drop values print"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "\"hello\".to_str = text std::Map[std::String $str]::new = values text.as_str \"key\".to_str values.set text drop values print"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "std::List[i64]::new = values 1 = value value values.push value print values print" accepts
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text text.as_str = view { view slot put } = writer writer exec writer drop text drop if slot.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "std::Option[$str]::None Slot = slot \"hello\".to_str = text text.as_str = view { view slot put } = writer:fn[->] writer exec writer drop text drop if slot.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn invoke writer:$fn[$str ->] text:$str { text writer exec } std::Option[$str]::None Slot = slot { = value:$str value slot put } = writer \"hello\" writer invoke"
    "Cannot store invocation borrow" swap rejects
    "for value in \"hello\".iter do value drop done" accepts
    "[3, 1, 2] std::List::from_array = values { = right:$i64 = left:$i64 left right < } values.sort_by values print" accepts
    "fn recursive[T] slot:mut$Slot[T] item:T stop:bool { if stop then item slot put else true item slot recursive fi } \"hello\".to_str = text std::Option[$str]::None Slot = slot false text.as_str slot recursive text drop if slot.value std::Option::Some(view) is then view print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn first[T] slot:mut$Slot[T] item:T stop:bool { if stop then item slot put else true item slot second fi } fn second[T] slot:mut$Slot[T] item:T stop:bool { stop item slot first } \"hello\".to_str = text std::Option[$str]::None Slot = slot false text.as_str slot first text drop if slot.value std::Option::Some(view) is then view print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn recursive slot:mut$Slot[$str] item:$str stop:bool { if stop then item slot put else std::Option[$str]::None Slot = local_slot \"hello\".to_str = local true local.as_str local_slot recursive local drop if local_slot.value std::Option::Some(view) is then view print fi fi }"
    "Cannot move owner `local` while it is borrowed" swap rejects
    "fn first slot:mut$Slot[$str] item:$str stop:bool { if stop then item slot put else slot second fi } fn second slot:mut$Slot[$str] { \"hello\".to_str = local true local.as_str slot first }"
    "Stored borrow escapes local owner `local`" swap rejects
    "struct State { value:i64 } struct Context { state:mut$State map:std::Map[std::String std::String] } fn visit self:mut$Context { for pair in self.map.iter do pair.second.as_str print done }" accepts
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } fn view owner:$Owner -> $Owner { owner } 0 Owner = first first view = saved true = write move { if write then 1 Owner = local local view = saved false = write else saved.value drop fi } = callback callback exec callback exec"
    "Stored borrow escapes local owner `local`" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Holder { callback:fn[->] } trait Store { fn store self:mut$self callback:$fn[->] } impl Holder:Store { fn store self:mut$Holder callback:$fn[->] { { callback exec } = self.callback } } fn forward[T:Store] target:mut$T callback:$fn[->] { callback target.store } fn noop { } &noop Holder = holder 1 Owner = owner move { owner.value drop } = callback callback holder forward callback drop holder.callback exec"
    "Cannot move owner `callback` while it is borrowed" swap rejects
    "fn first[T] slot:mut$Slot[T] item:T mode:i64 { if mode 0 == then 1 item slot second elif mode 1 == then 2 item slot third else item slot put fi } fn second[T] slot:mut$Slot[T] item:T mode:i64 { mode item slot first } fn third[T] slot:mut$Slot[T] item:T mode:i64 { mode item slot second } \"hello\".to_str = text std::Option[$str]::None Slot = slot 2 text.as_str slot third text drop if slot.value std::Option::Some(view) is then view print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn inner[T] slot:mut$Slot[T] item:T stop:bool { if stop then item slot put else true item slot inner fi } fn bridge[T] slot:mut$Slot[T] item:T { false item slot inner } fn outer[T] slot:mut$Slot[T] item:T stop:bool { if stop then item slot bridge else true item slot outer fi } \"hello\".to_str = text std::Option[$str]::None Slot = slot false text.as_str slot outer text drop if slot.value std::Option::Some(view) is then view print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn second[T] slot:mut$Slot[T] item:T stop:bool { stop item slot first } fn first[T] slot:mut$Slot[T] item:T stop:bool { if stop then item slot put else true item slot second fi } \"hello\".to_str = text std::Option[$str]::None Slot = slot false text.as_str slot first if slot.value std::Option::Some(view) is then view print fi slot drop text drop" accepts
    "fn invoke callback:fn[->] { callback exec } fn forward callback:fn[->] { callback = alias alias invoke } \"hello\".to_str = text std::Option[$str]::None Slot = slot text.as_str = view { view slot put } forward text drop if slot.value std::Option::Some(value) is then value print fi"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "fn invoke callback:$fn[->] { callback exec } fn observe slot:mut$Slot[$str] item:$str { { item print slot.value drop } = callback callback invoke } std::Option[$str]::None Slot = slot \"hello\".to_str = text text.as_str slot observe text drop slot.value drop" accepts
    "fn invoke callback:$fn[->] stop:bool { if stop then callback exec else true callback forward fi } fn forward callback:$fn[->] stop:bool { stop callback invoke } fn observe slot:mut$Slot[$str] { \"hello\".to_str = text { text.as_str print slot.value drop } = callback false callback invoke } std::Option[$str]::None Slot = slot slot observe slot.value drop" accepts
    "fn invoke callback:$fn[->] stop:bool { if stop then callback exec else true callback forward fi } fn forward callback:$fn[->] stop:bool { stop callback invoke } \"hello\".to_str = text text.as_str = view std::Option[$str]::None Slot = slot { view slot put } = callback false callback invoke callback drop text drop slot.value drop"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "struct Outer { values:std::List[i64] } fn append outer:Outer -> Outer { 1 outer.values.push outer } std::List[i64]::new Outer append = outer std::List[Outer]::new = all outer all.push all drop" accepts
    "struct Outer[T] { values:std::List[T] } fn append[T] outer:mut$Outer[T] item:T { item outer.values.push } std::List[$str]::new Outer = outer \"hello\".to_str = text text.as_str outer append text drop outer.values print"
    "Cannot move owner `text` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner {} } struct Store { values:std::Map[std::String Owner] } struct Context { store:$Store } fn get self:$Context name:$str -> std::Result[$Owner std::String] { name self.store.values.get_str match std::Option::Some(declaration) => declaration std::Result[$Owner std::String]::Ok std::Option::None => \"missing\".to_str std::Result::Error end }" accepts
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Holder { value:$Owner } fn view owner:$Owner -> $Owner { owner } fn put holder:mut$Holder value:$Owner { value = holder.value } 0 Owner = first 1 Owner = second first view Holder = holder second view = value struct Context { callback:$fn[->] } fn run context:Context { context.callback exec } { value holder put } = writer writer Context run writer drop second drop holder.value.value drop"
    "Cannot move owner `second` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Holder { value:$Owner } fn view owner:$Owner -> $Owner { owner } fn put holder:mut$Holder value:$Owner { value = holder.value } 0 Owner = first 1 Owner = second first view Holder = holder second view = value struct Context { callback:$fn[->] } fn run context:$Context { context.callback exec } { value holder put } = writer writer Context = context context run context drop writer drop second drop holder.value.value drop"
    "Cannot move owner `second` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner {} } 1 Owner = owner owner &wrap[$Owner] exec = slot owner drop slot.value drop"
    "Cannot move owner `owner` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner {} } 1 Owner = owner std::List[mut$Owner]::new = values owner values.push owner drop values.pop.value drop"
    "Cannot move owner `owner` while it is borrowed" swap rejects
    "struct Mixed[T] { item:T saved:std::Option[$str] } fn invalid[T] item:T count:i64 { Mixed { item:item saved:std::Option[$str]::None } = holder \"first\".to_str = text while count 0 > do \"next\".to_str = text if holder.saved std::Option::Some(view) is then view print fi text.as_str std::Option::Some = holder.saved 1 -= count done holder drop text drop }"
    "Loop back-edge changes loans for `holder`" swap rejects
    "struct Mixed[T] { item:T saved:std::Option[$str] } fn invalid[T] item:T text:mut$std::String count:i64 { Mixed { item:item saved:std::Option[$str]::None } = holder while count 0 > do \"next\" text.append if holder.saved std::Option::Some(view) is then view print fi text.as_str std::Option::Some = holder.saved 1 -= count done holder drop }"
    "Loop back-edge changes loans for `holder`" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Holder { value:$Owner } struct Outer { holder:Holder } fn view owner:$Owner -> $Owner { owner } fn put holder:mut$Holder value:$Owner { value = holder.value } fn through outer:mut$Outer value:$Owner { outer.holder = alias:mut$Holder value alias put } 0 Owner = first 1 Owner = second first view Holder Outer = outer second view outer through second drop outer.holder.value.value drop"
    "Cannot move owner `second` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Holder { value:$Owner } struct Outer { holder:Holder } fn view owner:$Owner -> $Owner { owner } fn put holder:mut$Holder value:$Owner { value = holder.value } fn field outer:$Outer -> $Owner { outer.holder.value } 0 Owner = first first view Holder Outer = outer outer field = alias outer drop first drop alias.value drop"
    "Cannot move owner `first` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Container { payload:$Owner } struct Iter { next_fn:fn[->$Container] } fn view owner:$Owner -> $Owner { owner } fn next iterator:mut$Iter -> $Container { iterator.next_fn exec } fn make source:$Container -> Iter { { source } Iter } 0 Owner = owner owner view Container = source source make = iterator iterator = alias:mut$Iter alias next = result alias drop iterator drop source drop result.payload.value drop"
    "Cannot move owner `source` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Container { payload:$Owner } struct Iter { next_fn:fn[->$Container] } fn view owner:$Owner -> $Owner { owner } fn next iterator:mut$Iter -> $Container { iterator.next_fn exec } fn make source:$Container -> Iter { { source } Iter } 0 Owner = owner owner view Container = source source make = iterator iterator = alias:mut$Iter alias next = result alias drop iterator drop result.payload.value drop" accepts
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner {} } 1 Owner = owner std::List[$Owner]::new = values owner values.push owner drop values.pop.value drop"
    "Cannot move owner `owner` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner {} } 1 Owner = owner std::Option[$Owner]::None Slot = slot owner slot put owner drop slot.value drop"
    "Cannot move owner `owner` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner {} } fn local -> std::List[$Owner] { std::List[$Owner]::new = values 1 Owner values.push values }"
    "Borrowed return escapes local owner `$borrowed_temporary_" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner {} } std::List[$Owner]::new = values 1 Owner values.push values.pop.value drop values drop" accepts
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Raw[T] { address:ptr } struct Wrapper[T] { inner:Raw[T] } fn view owner:$Owner -> $Owner { owner } fn make_raw[T] value:T -> Wrapper[T] { unsafe { size_of[T] alloc = address value address ptr::write[T] address Raw Wrapper } } fn get[T] raw:$Raw[T] -> T { unsafe { raw.address ptr::read[T] } } 1 Owner = owner owner view make_raw = wrapped owner drop wrapped.inner get.value drop"
    "Cannot move owner `owner` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner {} } struct Raw { address:ptr } struct Wrapper[T] { sidecar:T inner:Raw } fn view owner:$Owner -> $Owner { owner } fn make_raw[T] first:T second:T -> Wrapper[T] { unsafe { size_of[T] alloc = address first address ptr::write[T] address Raw second Wrapper } } fn get[T] raw:$Raw -> T { unsafe { raw.address ptr::read[T] } } 1 Owner = first 2 Owner = second second view first view make_raw = wrapped first drop wrapped.inner &get[$Owner] exec.value drop"
    "Cannot move owner `first` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner {} } struct Raw[T] { address:ptr } fn view owner:$Owner -> $Owner { owner } fn from_raw[T] address:ptr witness:T -> Raw[T] { witness drop address Raw } fn get[T] raw:$Raw[T] -> T { unsafe { raw.address ptr::read[T] } } 1 Owner = owner owner view = value unsafe { size_of[$Owner] alloc = address value address ptr::write[$Owner] } value address from_raw = raw owner drop raw get.value drop"
    "Cannot move owner `owner` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Raw[T] { address:ptr } fn view owner:$Owner -> $Owner { owner } fn store_return raw:Raw[$Owner] value:$Owner -> Raw[$Owner] { 0 match _ if unsafe { value raw.address ptr::write[$Owner] } true => raw _ => raw end } fn get[T] raw:$Raw[T] -> T { unsafe { raw.address ptr::read[T] } } 1 Owner = owner unsafe { size_of[$Owner] alloc Raw } = raw:Raw[$Owner] owner view raw store_return = stored owner drop stored get.value drop"
    "Cannot move owner `owner` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Holder { value:$Owner } fn view owner:$Owner -> $Owner { owner } fn put holder:mut$Holder value:$Owner { 0 match _ if value = holder.value true => _ => end } 0 Owner = first 1 Owner = second first view Holder = holder second view holder put second drop holder.value.value drop"
    "Cannot move owner `second` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Holder { value:$Owner } fn view owner:$Owner -> $Owner { owner } fn make first:$Owner second:$Owner -> Holder { first Holder = holder 0 match _ if second = holder.value true => _ => end holder } 0 Owner = first 1 Owner = second second view first view make = holder second drop holder.value.value drop"
    "Cannot move owner `second` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Holder { value:$Owner } fn view owner:$Owner -> $Owner { owner } 0 Owner = first 1 Owner = second first view Holder = holder 0 match _ if second view = holder.value false => _ => second drop holder.value.value drop end"
    "Cannot move owner `second` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } struct Raw[P T] { address:P } fn view owner:$Owner -> $Owner { owner } fn raw_wrap[P T] pointer:P witness:T -> Raw[P T] { witness drop pointer Raw } fn get raw:$Raw[ptr $Owner] -> $Owner { unsafe { raw.address ptr::read[$Owner] } } 1 Owner = owner unsafe { size_of[$Owner] alloc = address owner view address ptr::write[$Owner] owner view address raw_wrap = stored owner drop stored get.value drop }"
    "Cannot move owner `owner` while it is borrowed" swap rejects
    "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } fn view owner:$Owner -> $Owner { owner } fn choose first:$Owner second:$Owner -> $Owner { 0 match _ if second return => first _ => first end } 0 Owner = first 1 Owner = second second view first view choose = chosen second drop chosen.value drop"
    "Cannot move owner `second` while it is borrowed" swap rejects
    test::test_summary
}
run_tests
