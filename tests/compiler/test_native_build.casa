import "std" as std
import "os" as os
import "../../compiler/build.casa" as build
import "../../compiler/products.casa" as products
import "../../lib/test.casa" as test

fn make_source -> products::AssemblySource {
    products::Target::LinuxX86_64
    ".section .text\n.globl _start\n_start:\n movq $60, %rax\n xorq %rdi, %rdi\n syscall\n".to_str
    products::AssemblySource::new
}

fn test_native_failures {
    "native_failures" test::test_start
    make_source = source
    std::List[std::String]::new = libraries
    "/tmp/casa_native_build_test" = output
    "/does/not/exist/native-cc".to_str build::NativeDriver = missing
    false libraries output source missing.compile_binary match
        std::Result::Error(failure) => {
            if failure build::BuildFailure::Launch(error) is then
                "missing tool reports not found" error os::IoError::NotFound is test::assert_true
            else
                "missing tool reports launch failure" false test::assert_true
            fi
        }
        std::Result::Ok(_) => "missing tool fails" false test::assert_true
    end
    "failed build cleans assembly" "/tmp/casa_native_build_test.s".as_cstr.unwrap
    file::exists ! test::assert_true
    "/bin/false".to_str build::NativeDriver = failing
    true libraries output source failing.compile_binary match
        std::Result::Error(failure) => {
            if failure build::BuildFailure::Exit(status) is then
                "nonzero status is retained" 1 status test::assert_eq
            else
                "nonzero tool reports exit failure" false test::assert_true
            fi
        }
        std::Result::Ok(_) => "failing tool fails" false test::assert_true
    end
    "/tmp/casa_native_build_test.s".as_cstr.unwrap file::read_all
        .unwrap
        .to_str
        .unwrap = retained
    "failed build keeps complete assembly" source.get_text.as_str retained.as_str test::assert_str_eq
    "/tmp/casa_native_build_test.s".as_cstr.unwrap file::remove.unwrap drop
    false libraries "/does/not/exist/output" source build::NativeDriver::new.compile_binary match
        std::Result::Error(failure) => {
            if failure build::BuildFailure::Write(path error) is then
                "write failure names assembly" "/does/not/exist/output.s" path.as_str test::assert_str_eq
                "write failure retains errno" error os::IoError::NotFound is test::assert_true
            else
                "output failure reports write error" false test::assert_true
            fi
        }
        std::Result::Ok(_) => "unwritable output fails" false test::assert_true
    end
    products::Target::LinuxX86_64 "invalid assembly\n".to_str products::AssemblySource::new = invalid
    false libraries output invalid build::NativeDriver::new.compile_binary match
        std::Result::Error(failure) => {
            if failure build::BuildFailure::Exit(status) is then
                "assembler failure reaches caller" 0 status != test::assert_true
            else
                "assembler failure reports exit error" false test::assert_true
            fi
        }
        std::Result::Ok(_) => "invalid assembly fails" false test::assert_true
    end
    # The adapter returns all failures, so the caller remains alive to build again.
    false libraries output source build::NativeDriver::new.compile_binary.unwrap drop
    "successful build cleans assembly" "/tmp/casa_native_build_test.s".as_cstr.unwrap
    file::exists ! test::assert_true
    std::List[std::Bytes]::new = arguments
    output arguments.push_str
    "recovery binary runs" 0 arguments std::run_command test::assert_eq
    output.as_cstr.unwrap file::remove.unwrap drop
}
test_native_failures
test::test_summary
