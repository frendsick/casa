import "fixtures/module_visibility_lib.casa" as sample
import "fixtures/module_import_left.casa" as left
import "fixtures/module_import_right.casa" as right
import "../../lib/test.casa" as test

pub fn test_public_module_surface {
    "public_module_surface" test::test_start
    "public function" 42 sample::answer test::assert_eq
    "public constant" 42 sample::PUBLIC_VALUE test::assert_eq
    4 sample::Counter::new = counter
    "public field" 4 counter.value test::assert_eq
    "public method uses private state" 7 counter.total test::assert_eq
    counter match
        sample::Counter { value: value } => "public field pattern" 4 value test::assert_eq
    end
    "private field pattern inside its module" 7 4 sample::Counter::new.into_total test::assert_eq
    2 1 sample::PublicPair = pair
    "public positional constructor" 1 pair.left test::assert_eq
    "public positional constructor field order" 2 pair.right test::assert_eq
    "left constant resolves through dependency" 41 left::LEFT test::assert_eq
    "right constant resolves through dependency" 42 right::RIGHT test::assert_eq
    "diamond dependency remains available" 40 left::base_value test::assert_eq
}
test_public_module_surface
test::test_summary
