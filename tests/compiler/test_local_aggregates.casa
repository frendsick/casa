import "std" as std
import "../../lib/test.casa" as test

struct Pair {
    pub x: i64
    pub y: i64
}

enum Choice {
    Some(i64)
    None
}

struct Tracked {
    pub log: ptr
    pub id:  u64
}

impl Tracked {
    fn drop self:mut$Tracked {
        unsafe { self.log load64 10 * self.id + self.log store64 }
    }
}

enum OwnedChoice {
    Item(Tracked)
    Empty
}

struct Group {
    pub first:  Tracked
    pub second: Tracked
}

# These names used to make the local and heap destructor keys collide.
struct Value {
    pub inner: Tracked
}

struct local_Value {
    pub inner: Tracked
}

struct Other {
    pub inner: Tracked
}

struct local_Other {
    pub inner: Tracked
}

impl Value {
    fn drop self:mut$Value {
        unsafe { self.inner.log load64 10 * 4 + self.inner.log store64 }
    }
}

impl local_Value {
    fn drop self:mut$local_Value {
        unsafe { self.inner.log load64 10 * 5 + self.inner.log store64 }
    }
}

impl Other {
    fn drop self:mut$Other {
        unsafe { self.inner.log load64 10 * 4 + self.inner.log store64 }
    }
}

impl local_Other {
    fn drop self:mut$local_Other {
        unsafe { self.inner.log load64 10 * 5 + self.inner.log store64 }
    }
}

fn sum value:i64 -> i64 { value value Pair = pair pair.x pair.y + }

fn early flag:bool log:ptr -> i64 {
    1 log Tracked = first
    2 log Tracked = second
    if flag then
        41 return
    fi
    42
}

fn loop_cleanup log:ptr {
    0 = index: u64
    while 3 index > do
        index 1 + log Tracked = value
        1 += index
        if 1 index == then
            continue
        fi
        if 3 index == then
            break
        fi
    done
}
"local aggregate mutation and destruction" test::test_start
"non-Copy aggregate fields" 42 21 sum test::assert_eq
20 10 Pair = first
40 30 Pair = second
11 = first.x
"local mutation is independent" 30 second.x test::assert_eq
"local mutation updates its owner" 11 first.x test::assert_eq
first drop
"explicit drop preserves another owner" 40 second.y test::assert_eq
Pair { x: 7 y: 9 } = literal
"literal initializes first field" 7 literal.x test::assert_eq
"literal initializes second field" 9 literal.y test::assert_eq
Pair { y: 19 x: 17 } = reversed
"reversed literal initializes first field" 17 reversed.x test::assert_eq
"reversed literal initializes second field" 19 reversed.y test::assert_eq
42 Choice::Some = choice
"local payload enum tag" choice Choice::Some is test::assert_true
unsafe { 8 alloc } = log_pointer
unsafe { 0 log_pointer store64 }
"early return value" 41 log_pointer true early test::assert_eq
"early return cleanup is LIFO" 21 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
"ordinary return value" 42 log_pointer false early test::assert_eq
"ordinary return cleanup is LIFO" 21 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
log_pointer loop_cleanup
"continue and break clean each iteration" 123 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
2 log_pointer Tracked 1 log_pointer Tracked Group = group
group drop
"local container destroys owned fields in reverse order" 21 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
3 log_pointer Tracked OwnedChoice::Item = owned_choice
"owned enum tag" owned_choice OwnedChoice::Item is test::assert_true
owned_choice drop
"local enum destroys owned payload" 3 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
1 log_pointer Tracked Value = value
value drop
2 log_pointer Tracked local_Value drop
"local destructor registered before heap destructor" 4152 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
2 log_pointer Tracked local_Other drop
1 log_pointer Tracked Other = other
other drop
"heap destructor registered before local destructor" 5241 unsafe { log_pointer load64 } test::assert_eq
unsafe { log_pointer free }
test::test_summary
