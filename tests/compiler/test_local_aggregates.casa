import "std" as std
import "../../lib/test.casa" as test

struct Pair {
    pub x: i64
    pub y: i64
}

enum Choice {
    Some(i64)
    None
}

struct Tracked {
    pub log: ptr
    pub id:  u64
}

impl Tracked {
    fn drop self:mut$Tracked {
        unsafe { self.log load64 10 * self.id + self.log store64 }
    }
}

enum OwnedChoice {
    Item(Tracked)
    Empty
}

struct Group {
    pub first:  Tracked
    pub second: Tracked
}

# These names used to make the local and heap destructor keys collide.
struct Value {
    pub inner: Tracked
}

struct local_Value {
    pub inner: Tracked
}

struct Other {
    pub inner: Tracked
}

struct local_Other {
    pub inner: Tracked
}

impl Value {
    fn drop self:mut$Value {
        unsafe { self.inner.log load64 10 * 4 + self.inner.log store64 }
    }
}

impl local_Value {
    fn drop self:mut$local_Value {
        unsafe { self.inner.log load64 10 * 5 + self.inner.log store64 }
    }
}

impl Other {
    fn drop self:mut$Other {
        unsafe { self.inner.log load64 10 * 4 + self.inner.log store64 }
    }
}

impl local_Other {
    fn drop self:mut$local_Other {
        unsafe { self.inner.log load64 10 * 5 + self.inner.log store64 }
    }
}

fn sum value:i64 -> i64 { value value Pair = pair pair.x pair.y + }

fn early flag:bool log:ptr -> i64 {
    1 log Tracked = first
    2 log Tracked = second
    if flag then
        41 return
    fi
    42
}

fn loop_cleanup log:ptr {
    0 = index: u64
    while 3 index > do
        index 1 + log Tracked = value
        1 += index
        if 1 index == then
            continue
        fi
        if 3 index == then
            break
        fi
    done
}

struct Observed {
    pub value: i64
    padding:   i64
}

impl Observed {
    fn drop self:mut$Observed {}
}

struct ObservingOwner {
    pub child: Observed
    log:       ptr
}

impl ObservingOwner {
    fn drop self:mut$ObservingOwner {
        unsafe {
            88 99 Observed ptr::into_raw = replacement
            self.child.value u64::try_from.unwrap self.log store64
            1 += self.child.value
            replacement ptr::from_raw[Observed] drop
        }
    }
}

fn test_moved_field_remains_live_for_hook log:ptr {
    "moved field remains live for its container cleanup" test::test_start
    log 22 11 Observed ObservingOwner = owner
    owner match
        ObservingOwner { child: moved } => {
            "hook reads the original field" 11 unsafe { log load64 } test::assert_eq
            "hook mutation reaches the moved field" 12 moved.value test::assert_eq
        }
    end
}

fn make_tracked log:ptr id:u64 -> Tracked { id log Tracked }

fn forward[T] value:T -> T { value }

fn make_pair log:ptr early:bool -> Tracked i64 Tracked {
    1 log make_tracked = first
    if early then
        first 42 2 log make_tracked return
    fi
    first 43 3 log make_tracked
}

fn consume_pair second:Tracked value:i64 first:Tracked -> i64 { value }

fn choose_tracked log:ptr flag:bool -> OwnedChoice {
    if flag then
        4 log make_tracked OwnedChoice::Item
    else
        OwnedChoice::Empty
    fi
}

fn consume_choice value:OwnedChoice {
    value match
        OwnedChoice::Item(item) => item forward drop
        OwnedChoice::Empty => {}
    end
}

fn test_call_transfers log:ptr {
    "returned and consumed aggregate owners" test::test_start
    unsafe { 0 log store64 }
    "early multi-result call" 42 true log make_pair consume_pair test::assert_eq
    "multi-result owners destroyed once in parameter order" 12 unsafe { log load64 } test::assert_eq
    unsafe { 0 log store64 }
    "indirect multi-result call" 43 false log &make_pair exec consume_pair test::assert_eq
    "indirect return retains both owners" 13 unsafe { log load64 } test::assert_eq
    unsafe { 0 log store64 }
    true log choose_tracked forward consume_choice
    false log choose_tracked forward consume_choice
    "returned enum transfers its payload once" 4 unsafe { log load64 } test::assert_eq
    unsafe { 0 log store64 }
    0 = index: u64
    while index 3 < do
        index 1 + log make_tracked forward = value
        1 += index
        if index 1 == then
            continue
        fi
        if index 3 == then
            break
        fi
        value drop
    done
    "returned loop owners retain cleanup order" 123 unsafe { log load64 } test::assert_eq
}
"local aggregate mutation and destruction" test::test_start
"non-Copy aggregate fields" 42 21 sum test::assert_eq
20 10 Pair = first
40 30 Pair = second
11 = first.x
"local mutation is independent" 30 second.x test::assert_eq
"local mutation updates its owner" 11 first.x test::assert_eq
first drop
"explicit drop preserves another owner" 40 second.y test::assert_eq
Pair { x: 7 y: 9 } = literal
"literal initializes first field" 7 literal.x test::assert_eq
"literal initializes second field" 9 literal.y test::assert_eq
Pair { y: 19 x: 17 } = reversed
"reversed literal initializes first field" 17 reversed.x test::assert_eq
"reversed literal initializes second field" 19 reversed.y test::assert_eq
42 Choice::Some = choice
"local payload enum tag" choice Choice::Some is test::assert_true
unsafe { 8 alloc } = log_pointer
unsafe { 0 log_pointer store64 }
"early return value" 41 log_pointer true early test::assert_eq
"early return cleanup is LIFO" 21 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
"ordinary return value" 42 log_pointer false early test::assert_eq
"ordinary return cleanup is LIFO" 21 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
log_pointer loop_cleanup
"continue and break clean each iteration" 123 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
2 log_pointer Tracked 1 log_pointer Tracked Group = group
group drop
"local container destroys owned fields in reverse order" 21 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
3 log_pointer Tracked OwnedChoice::Item = owned_choice
"owned enum tag" owned_choice OwnedChoice::Item is test::assert_true
owned_choice drop
"local enum destroys owned payload" 3 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
1 log_pointer Tracked Value = value
value drop
2 log_pointer Tracked local_Value = captured_value
move { captured_value.inner.id drop } = value_callback
value_callback drop
"local destructor registered before heap destructor" 4152 unsafe { log_pointer load64 } test::assert_eq
unsafe { 0 log_pointer store64 }
2 log_pointer Tracked local_Other = captured_other
move { captured_other.inner.id drop } = other_callback
other_callback drop
1 log_pointer Tracked Other = other
other drop
"heap destructor registered before local destructor" 5241 unsafe { log_pointer load64 } test::assert_eq
log_pointer test_call_transfers
log_pointer test_moved_field_remains_live_for_hook
unsafe { log_pointer free }
test::test_summary
