import "std" as std
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

const OWNERS "struct Owner { value:i64 } impl Owner { fn drop self:mut$Owner { } } fn inspect value:$Owner { } fn change value:mut$Owner { } "

fn accepts source:$str {
    error::Diagnostics::new = diagnostics
    OWNERS source str::concat = code
    diagnostics code.as_str helpers::typecheck_test_source = checked
    checked.get_diagnostics.clone diagnostics.merge
    if diagnostics.has_errors then
        for entry in diagnostics.entries.iter do
            if entry error::Diagnostic::Error(failure) is then
                failure.message.as_str std::println
            fi
        done
    fi
    diagnostics source helpers::assert_no_errors
}

fn rejects source:$str message:$str {
    error::Diagnostics::new = diagnostics
    OWNERS source str::concat = code
    diagnostics code.as_str helpers::typecheck_test_source = checked
    checked.get_diagnostics.clone diagnostics.merge
    if message diagnostics helpers::diagnostics_error_contains ! then
        for entry in diagnostics.entries.iter do
            if entry error::Diagnostic::Error(failure) is then
                failure.message.as_str std::println
            fi
        done
    fi
    diagnostics source message helpers::assert_error_contains
}
