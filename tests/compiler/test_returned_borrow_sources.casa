for
    prefix in ["", "fn check_first left:$Owner right:$Owner { right left true second drop }"].iter
do
    f"{prefix} fn first stop:bool left:$Owner right:$Owner -> $Owner \{ if stop then left else right left true second fi \} fn second stop:bool left:$Owner right:$Owner -> $Owner \{ right left stop first \} fn use left:Owner right:Owner \{ right left true first = view right drop view inspect \}"
    = source
    "Cannot move owner `right` while it is borrowed" source.as_str rejects
done
