import "std" as std
import "../../lib/test.casa" as test

pub fn check_bounds {
    "half-open range starts at zero" test::test_start
    3 0 std::Range::new = values
    "inclusive start" 0 values.next.unwrap test::assert_eq
    "next value" 1 values.next.unwrap test::assert_eq
    "last value" 2 values.next.unwrap test::assert_eq
    "exclusive stop" values.next.is_none test::assert_true
    "exhaustion is permanent" values.next.is_none test::assert_true

    "singleton" test::test_start
    5 4 std::Range::new = singleton
    "one value" 4 singleton.next.unwrap test::assert_eq
    "then exhausted" singleton.next.is_none test::assert_true

    "empty ranges" test::test_start
    0 0 std::Range::new = equal
    "equal bounds" equal.next.is_none test::assert_true
    "equal stays empty" equal.next.is_none test::assert_true
    3 4 std::Range::new = reversed
    "reversed bounds" reversed.next.is_none test::assert_true
    "reversed stays empty" reversed.next.is_none test::assert_true
    0 = visits
    for value in 0 1 std::Range::new do
        1 += visits
    done
    "empty loop has no body calls" 0 visits test::assert_eq
}

pub fn check_integer_limits {
    "integer limits" test::test_start
    18446744073709551615 18446744073709551614 std::Range::new = upper
    "last representable yield" 18446744073709551614 upper.next.unwrap test::assert_eq
    "upper limit stops without wrapping" upper.next.is_none test::assert_true
    "upper limit remains exhausted" upper.next.is_none test::assert_true
    1 0 std::Range::new = lower
    "minimum is a valid start" 0 lower.next.unwrap test::assert_eq
    "minimum singleton stops" lower.next.is_none test::assert_true
    18446744073709551615 0 std::Range::new = full
    "widest bounds do not require subtraction" 0 full.next.unwrap test::assert_eq
    "widest range advances" 1 full.next.unwrap test::assert_eq
    0 18446744073709551615 std::Range::new = reversed
    "widest reversed range is empty" reversed.next.is_none test::assert_true
    18446744073709551615 18446744073709551615 std::Range::new = equal
    "maximum equal bounds are empty" equal.next.is_none test::assert_true

    9223372036854775809 9223372036854775807 std::Range::new = high_bit
    "signed maximum is a valid yield" 9223372036854775807 high_bit.next.unwrap test::assert_eq
    "values above signed maximum are unsigned" 9223372036854775808 high_bit.next.unwrap test::assert_eq
    "high-bit range stops" high_bit.next.is_none test::assert_true
}

pub fn stop_early values:mut$std::Range -> u64 {
    0 = sum: u64
    for value in values do
        if value 1 == then
            continue
        fi
        value += sum
        if value 2 == then
            break
        fi
    done
    sum
}

pub fn check_iteration {
    "borrowed cursor resumes after break" test::test_start
    5 0 std::Range::new = values
    "continue skips one value" 2 values stop_early test::assert_eq
    "break consumes its value" 3 values.next.unwrap test::assert_eq
    "terminal consumes the remainder" 1 values.count test::assert_eq
    "terminal leaves cursor exhausted" values.next.is_none test::assert_true

    "nested loops" test::test_start
    0 = sum: u64
    for row in 3 1 std::Range::new do
        for column in 2 0 std::Range::new do
            row 10 * column + += sum
        done
    done
    "independent cursors" 62 sum test::assert_eq

    "range composes with Iterable defaults" test::test_start
    { 10 * } { copy 2 % 0 == } 6 0 std::Range::new
        .filter
        .map
        .collect = transformed: std::List[u64]
    "filtered count" 3 transformed.length test::assert_eq
    "first mapped value" 0 0 transformed.get test::assert_eq
    "last mapped value" 40 2 transformed.get test::assert_eq
}

pub fn check_collection_indices {
    "range uses collection lengths and indices directly" test::test_start
    [10, 20, 30] std::List::from_array = values
    0 = total
    for index in values.length 0 std::Range::new do
        index values.get copy += total
    done
    "every element is visited" 60 total test::assert_eq
}
check_bounds
check_collection_indices
check_integer_limits
check_iteration
test::test_summary
