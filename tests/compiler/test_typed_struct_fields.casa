import "../../compiler/common.casa"
import "../../compiler/error.casa"
import "../../compiler/lexer.casa"
import "../../compiler/syntax.casa"
import "../../lib/test.casa"

# Regression test for issue #128: structs as direct fields of other structs.

struct Tail {
    value: i64
}

struct Node {
    value: i64
    next:  Tail
}

struct Owner {
    name: str
    node: Node
}

fn make_tail value:i64 -> Tail { value Tail }

fn make_node value:i64 next:Tail -> Node { next value Node }

fn make_owner name:str node:Node -> Owner { node name Owner }

fn make_value_setter node:mut$Node -> fn[i64] {
    { = node.value }
}

fn test_direct_typed_field_read {
    "direct_typed_field_read" test_start
    7 make_tail 42 make_node = node
    "value reads back" 42 node Node::value assert_eq
    "next value reads back" 7 node Node::next Tail::value assert_eq
}

fn test_direct_typed_field_assignment {
    "direct_typed_field_assignment" test_start
    2 make_tail 1 make_node = node
    3 make_tail = node.next
    "node value" 1 node Node::value assert_eq
    "replaced next value" 3 node Node::next Tail::value assert_eq
}

fn test_cross_struct_field_read {
    "cross_struct_field_read" test_start
    7 make_tail 99 make_node = inner
    inner "owner" make_owner = owner
    "name" "owner" owner Owner::name assert_str_eq
    "inner.value via owner" 99 owner Owner::node Node::value assert_eq
}

fn test_nested_field_assignment {
    "nested_field_assignment" test_start
    3 make_tail 4 make_node = inner
    inner "owner" make_owner = owner
    7 = owner.node.value
    1 += owner.node.value
    2 -= owner.node.value
    "nested field value" 6 owner Owner::node Node::value assert_eq
}

fn test_captured_field_assignment {
    "captured_field_assignment" test_start
    2 make_tail 3 make_node = node
    node make_value_setter = setter
    8 setter exec
    "captured field value" 8 node Node::value assert_eq
}
test_direct_typed_field_read
test_direct_typed_field_assignment
test_cross_struct_field_read
test_nested_field_assignment
test_captured_field_assignment
test_summary
