import "../../lib/test.casa" as test

trait Answer {
    fn value self:$self -> i64 { self drop 42 }
}

trait Ab {
    fn value self:$self -> i64 { self drop 1 }
}

trait BA {
    fn value self:$self -> i64 { self drop 2 }
}

trait Empty {
    fn noop self:$self { }
}

struct Item {
    raw: i64
}

impl Item: Answer + Ab + BA + Empty { }

# This legal source name matched the former generated Answer default key.
impl Item {
    fn value__default_6384194068_6952067658837 self:$Item -> i64 { self drop 7 }
}
"default recipe identities" test::test_start
"source name does not replace default" 42 1 Item Answer::value test::assert_eq
"first trait default" 1 1 Item Ab::value test::assert_eq
"second trait default" 2 1 Item BA::value test::assert_eq
1 Item Empty::noop
test::test_summary
