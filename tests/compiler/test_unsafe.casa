import "../../compiler/typechecker.casa"
import "helpers.casa"

fn check_unsafe_source code:$str diagnostics:mut$Diagnostics {
    diagnostics code parse_resolve_test_source = result
    if result.ops Option::Some(ops) is then
        result.store = store
        diagnostics store Option[Function]::None ops type_check_ops_for_test drop
    fi
}

fn test_raw_operations_require_unsafe_blocks {
    "raw_operations_require_unsafe_blocks" test_start

    Diagnostics::new = allocation_diagnostics
    allocation_diagnostics "8 alloc drop" check_unsafe_source
    allocation_diagnostics "allocation boundary" "Unsafe operation `alloc`" assert_error_contains

    Diagnostics::new = load_diagnostics
    load_diagnostics "0 (ptr) load8 drop" check_unsafe_source
    load_diagnostics "load boundary" "Unsafe operation `load8`" assert_error_contains

    Diagnostics::new = cast_diagnostics
    cast_diagnostics "0 (ptr) drop" check_unsafe_source
    cast_diagnostics "pointer cast boundary" "Unsafe operation `pointer cast`" assert_error_contains

    Diagnostics::new = pointer_diagnostics
    pointer_diagnostics "0 (ptr) 1 + drop" check_unsafe_source
    pointer_diagnostics "pointer arithmetic boundary" "Unsafe operation `+`" assert_error_contains

    Diagnostics::new = syscall_diagnostics
    syscall_diagnostics "39 syscall0 drop" check_unsafe_source
    syscall_diagnostics "syscall boundary" "Unsafe operation `syscall0`" assert_error_contains
}

fn test_unsafe_block_allows_raw_operations {
    "unsafe_block_allows_raw_operations" test_start
    Diagnostics::new = diagnostics
    diagnostics "unsafe { unsafe { 1 drop } 8 alloc drop }" check_unsafe_source
    diagnostics "unsafe block" assert_no_errors
}

fn test_safe_wrapper_can_contain_unsafe_block {
    "safe_wrapper_can_contain_unsafe_block" test_start
    Diagnostics::new = diagnostics
    diagnostics "fn allocate -> ptr { unsafe { 8 alloc } } allocate drop" check_unsafe_source
    diagnostics "safe wrapper" assert_no_errors
}

fn test_unsafe_function_call_requires_unsafe_block {
    "unsafe_function_call_requires_unsafe_block" test_start
    "unsafe fn raw_allocate -> ptr { unsafe { 8 alloc } } " = declaration

    Diagnostics::new = safe_diagnostics
    safe_diagnostics f"{declaration} raw_allocate drop" check_unsafe_source
    safe_diagnostics "unsafe call" "Unsafe operation `raw_allocate`" assert_error_contains

    Diagnostics::new = unsafe_diagnostics
    unsafe_diagnostics declaration "unsafe { raw_allocate drop }" str::concat check_unsafe_source
    unsafe_diagnostics "unsafe call in block" assert_no_errors
}

fn test_unsafe_function_body_still_requires_block {
    "unsafe_function_body_still_requires_block" test_start
    Diagnostics::new = diagnostics
    diagnostics "unsafe fn raw_allocate -> ptr { 8 alloc } unsafe { raw_allocate drop }" check_unsafe_source
    diagnostics "unsafe function body" "Unsafe operation `alloc`" assert_error_contains
}

fn test_unsafe_function_cannot_be_referenced {
    "unsafe_function_cannot_be_referenced" test_start
    Diagnostics::new = diagnostics
    diagnostics "unsafe fn raw_allocate -> ptr { unsafe { 8 alloc } } &raw_allocate drop" check_unsafe_source
    diagnostics "unsafe reference" "Unsafe function `raw_allocate` cannot be referenced" assert_error_contains
}

fn test_unsafe_method_call_requires_unsafe_block {
    "unsafe_method_call_requires_unsafe_block" test_start
    "struct Raw { address: ptr } impl Raw { unsafe fn read self:Raw -> i64 { unsafe { self.address load64 } } } " = declaration

    Diagnostics::new = safe_diagnostics
    safe_diagnostics f"{declaration} 0 (ptr) Raw .read drop" check_unsafe_source
    safe_diagnostics "unsafe method call" "Unsafe operation `Raw::read`" assert_error_contains

    Diagnostics::new = unsafe_diagnostics
    unsafe_diagnostics declaration "unsafe { 0 (ptr) Raw .read drop }" str::concat check_unsafe_source
    unsafe_diagnostics "unsafe method in block" assert_no_errors
}

fn test_unchecked_codepoint_requires_unsafe_block {
    "unchecked_codepoint_requires_unsafe_block" test_start

    Diagnostics::new = safe_diagnostics
    safe_diagnostics "65 (u32) char::from_codepoint_unchecked drop" check_unsafe_source
    safe_diagnostics "unchecked codepoint" "Unsafe operation `char::from_codepoint_unchecked`" assert_error_contains

    Diagnostics::new = unsafe_diagnostics
    unsafe_diagnostics "unsafe { 65 (u32) char::from_codepoint_unchecked drop }" check_unsafe_source
    unsafe_diagnostics "unchecked codepoint in block" assert_no_errors
}
test_raw_operations_require_unsafe_blocks
test_unsafe_block_allows_raw_operations
test_safe_wrapper_can_contain_unsafe_block
test_unsafe_function_call_requires_unsafe_block
test_unsafe_function_body_still_requires_block
test_unsafe_function_cannot_be_referenced
test_unsafe_method_call_requires_unsafe_block
test_unchecked_codepoint_requires_unsafe_block
test_summary
