import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

pub fn check_unsafe_source code:$str diagnostics:mut$error::Diagnostics {
    diagnostics code helpers::parse_resolve_test_source = result
    result.into_parts = parse_diagnostics = store = ops
    parse_diagnostics drop
    if ops std::Option::Some(operations) is then
        operations common::clone_ops = mutable_operations
        diagnostics store std::Option[common::Function]::None mutable_operations helpers::type_check_ops_for_test drop
    fi
}

pub fn test_raw_operations_require_unsafe_blocks {
    "raw_operations_require_unsafe_blocks" test::test_start

    error::Diagnostics::new = allocation_diagnostics
    allocation_diagnostics "8 alloc drop" check_unsafe_source
    allocation_diagnostics "allocation boundary" "Unsafe operation `alloc`" helpers::assert_error_contains

    error::Diagnostics::new = free_diagnostics
    free_diagnostics "ptr::null free" check_unsafe_source
    free_diagnostics "free boundary" "Unsafe operation `free`" helpers::assert_error_contains

    error::Diagnostics::new = load_diagnostics
    load_diagnostics "ptr::null load8 drop" check_unsafe_source
    load_diagnostics "load boundary" "Unsafe operation `load8`" helpers::assert_error_contains

    error::Diagnostics::new = pointer_diagnostics
    pointer_diagnostics "ptr::null 1 + drop" check_unsafe_source
    pointer_diagnostics "pointer arithmetic boundary" "Unsafe operation `+`" helpers::assert_error_contains

    error::Diagnostics::new = transfer_diagnostics
    transfer_diagnostics "struct Owner { value: i64 } 1 Owner ptr::into_raw drop" check_unsafe_source
    transfer_diagnostics "ownership transfer boundary" "Unsafe operation `ptr::into_raw`" helpers::assert_error_contains

    error::Diagnostics::new = syscall_diagnostics
    syscall_diagnostics "39 syscall0 drop" check_unsafe_source
    syscall_diagnostics "syscall boundary" "Unsafe operation `syscall0`" helpers::assert_error_contains
}

pub fn test_raw_allocation_contract {
    "raw_allocation_contract" test::test_start
    unsafe {
        0 alloc = null_pointer
        "zero allocation is null" null_pointer ptr::null == test::assert_true
        null_pointer free
        null_pointer free

        16 alloc = allocation
        "positive allocation is non-null" allocation ptr::null != test::assert_true
        "allocation is 8-byte aligned" allocation ptr::from_ref load64 8 % 0 == test::assert_true
        allocation free
        16 alloc = reused
        "free makes storage reusable" allocation reused == test::assert_true
        reused free
    }
}

pub fn test_raw_memory_contract {
    "raw_memory_contract" test::test_start
    unsafe {
        9 alloc = bytes
        16909060 = word: u32
        word bytes 1 + store32

        bytes 1 + load32 = loaded_word: u32
        "unaligned load round-trips" loaded_word word == test::assert_true
        "little-endian byte 0" bytes 1 + load8 4 == test::assert_true
        "little-endian byte 1" bytes 2 + load8 3 == test::assert_true
        "little-endian byte 2" bytes 3 + load8 2 == test::assert_true
        "little-endian byte 3" bytes 4 + load8 1 == test::assert_true
        "pointer subtraction uses byte offsets" bytes 4 + 4 - bytes == test::assert_true
        bytes free
    }
}

pub fn test_pointer_arithmetic_requires_u64_offsets {
    "pointer_arithmetic_requires_u64_offsets" test::test_start

    error::Diagnostics::new = valid_diagnostics
    valid_diagnostics
    "unsafe { 8 alloc = address 1 = offset:u64 address offset + drop address offset + offset - drop address free }"
    check_unsafe_source
    valid_diagnostics "u64 offsets" helpers::assert_no_errors

    error::Diagnostics::new = signed_diagnostics
    signed_diagnostics
    "unsafe { 8 alloc = address 1 = offset:i64 address offset + drop address free }"
    check_unsafe_source
    signed_diagnostics "signed offset rejected" helpers::assert_has_errors
    signed_diagnostics "signed offset diagnostic" "Expected `u64`, got `i64`" helpers::assert_error_contains
}

pub fn test_unsafe_block_allows_raw_operations {
    "unsafe_block_allows_raw_operations" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "unsafe { unsafe { 1 drop } 8 alloc drop }" check_unsafe_source
    diagnostics "unsafe block" helpers::assert_no_errors
}

pub fn test_safe_wrapper_can_contain_unsafe_block {
    "safe_wrapper_can_contain_unsafe_block" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "fn allocate -> ptr { unsafe { 8 alloc } } allocate drop" check_unsafe_source
    diagnostics "safe wrapper" helpers::assert_no_errors
}

pub fn test_unsafe_function_call_requires_unsafe_block {
    "unsafe_function_call_requires_unsafe_block" test::test_start
    "unsafe fn raw_allocate -> ptr { unsafe { 8 alloc } } " = declaration

    error::Diagnostics::new = safe_diagnostics
    safe_diagnostics f"{declaration} raw_allocate drop".as_str check_unsafe_source
    safe_diagnostics "unsafe call" "Unsafe operation `raw_allocate`" helpers::assert_error_contains

    error::Diagnostics::new = unsafe_diagnostics
    unsafe_diagnostics declaration "unsafe { raw_allocate drop }" str::concat.as_str check_unsafe_source
    unsafe_diagnostics "unsafe call in block" helpers::assert_no_errors
}

pub fn test_unsafe_function_body_still_requires_block {
    "unsafe_function_body_still_requires_block" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "unsafe fn raw_allocate -> ptr { 8 alloc } unsafe { raw_allocate drop }" check_unsafe_source
    diagnostics "unsafe function body" "Unsafe operation `alloc`" helpers::assert_error_contains
}

pub fn test_unsafe_function_cannot_be_referenced {
    "unsafe_function_cannot_be_referenced" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "unsafe fn raw_allocate -> ptr { unsafe { 8 alloc } } &raw_allocate drop" check_unsafe_source
    diagnostics "unsafe reference" "Unsafe function `raw_allocate` cannot be referenced" helpers::assert_error_contains
}

pub fn test_unsafe_method_call_requires_unsafe_block {
    "unsafe_method_call_requires_unsafe_block" test::test_start
    "struct Raw { address: ptr } impl Raw { unsafe fn read self:Raw -> u64 { unsafe { self.address load64 } } } " = declaration

    error::Diagnostics::new = safe_diagnostics
    safe_diagnostics f"{declaration} ptr::null Raw .read drop".as_str check_unsafe_source
    safe_diagnostics "unsafe method call" "Unsafe operation `Raw::read`" helpers::assert_error_contains

    error::Diagnostics::new = unsafe_diagnostics
    unsafe_diagnostics declaration "unsafe { ptr::null Raw .read drop }" str::concat.as_str check_unsafe_source
    unsafe_diagnostics "unsafe method in block" helpers::assert_no_errors
}

pub fn test_unchecked_codepoint_requires_unsafe_block {
    "unchecked_codepoint_requires_unsafe_block" test::test_start

    error::Diagnostics::new = safe_diagnostics
    safe_diagnostics "65 char::from_codepoint_unchecked drop" check_unsafe_source
    safe_diagnostics "unchecked codepoint" "Unsafe operation `char::from_codepoint_unchecked`" helpers::assert_error_contains

    error::Diagnostics::new = unsafe_diagnostics
    unsafe_diagnostics "unsafe { 65 char::from_codepoint_unchecked drop }" check_unsafe_source
    unsafe_diagnostics "unchecked codepoint in block" helpers::assert_no_errors
}
test_raw_operations_require_unsafe_blocks
test_raw_allocation_contract
test_raw_memory_contract
test_pointer_arithmetic_requires_u64_offsets
test_unsafe_block_allows_raw_operations
test_safe_wrapper_can_contain_unsafe_block
test_unsafe_function_call_requires_unsafe_block
test_unsafe_function_body_still_requires_block
test_unsafe_function_cannot_be_referenced
test_unsafe_method_call_requires_unsafe_block
test_unchecked_codepoint_requires_unsafe_block
test::test_summary
