import "../../workspace.casa" as workspace
import "../../lib/std.casa" as std
import "../../lib/test.casa" as test

fn make_workspace -> workspace::Workspace {
    workspace::Workspace::new = state
    "/tmp/casa-workspace".to_str state.folders.push
    "pub fn greet { }\ngreet\n".to_str "/tmp/casa-workspace/shared.casa".to_str state.overrides.set
    "import \"shared.casa\" as shared\nshared::greet\n".to_str "/tmp/casa-workspace/first.casa".to_str state.overrides.set
    "import \"shared.casa\" as shared\nshared::greet\n".to_str "/tmp/casa-workspace/second.casa".to_str state.overrides.set
    state
}

fn test_workspace_queries {
    "workspace_queries" test::test_start
    make_workspace = state
    true 7 "/tmp/casa-workspace/shared.casa" state.find_references.unwrap = result
    "shared declaration and three uses" 4 result.ranges.length test::assert_eq
    # The virtual folder is unreadable, so discovery must not claim completeness.
    "missing folder incomplete" result.complete ! test::assert_true
    "incomplete rename refused" "hello" result state.validate_rename ! test::assert_true
}

fn test_local_rename {
    "workspace_local_rename" test::test_start
    workspace::Workspace::new = state
    "/tmp".to_str state.folders.push
    "fn run { 1 = count count drop }\n".to_str "/tmp/workspace-local.casa".to_str state.overrides.set
    true 13 "/tmp/workspace-local.casa" state.find_references.unwrap = result
    "local references complete without discovery" result.complete test::assert_true
    "local declaration and use" 2 result.ranges.length test::assert_eq
    "local rename accepted" "total" result state.validate_rename test::assert_true
    "invalid rename refused" "one two" result state.validate_rename ! test::assert_true
    "qualified rename refused" "one::two" result state.validate_rename ! test::assert_true
    "keyword rename refused" "if" result state.validate_rename ! test::assert_true
    1 += state.generation
    "generation change refused" "total" result state.validate_rename ! test::assert_true
}
test_workspace_queries
test_local_rename
test::test_summary
