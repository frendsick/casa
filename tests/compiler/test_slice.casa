import "std"
import "helpers.casa"

fn make_values -> List[i64] {
    [10, 20, 30, 40] List::from_array
}

fn test_slice_range {
    "slice_range" test_start
    make_values = values
    4 1 values.slice = middle
    "runtime length" 3 middle.length assert_eq
    "first value" 20 0 middle.nth.clone assert_eq
    "last value" 40 2 middle.nth.clone assert_eq

    0 = total
    for value in middle.iter do
        value += total
    done
    "iteration" 90 total assert_eq
}

fn test_whole_list_view {
    "whole_list_view" test_start
    make_values = values
    values.as_slice = view
    "whole length" 4 view.length assert_eq
    "whole value" 30 2 view.nth.clone assert_eq
}

fn test_slices_share_the_source {
    "slices_share_the_source" test_start
    make_values = values
    2 0 values.slice = first
    4 2 values.slice = second
    "first view" 20 1 first.nth.clone assert_eq
    "second view" 30 0 second.nth.clone assert_eq
}
test_slice_range
test_whole_list_view
test_slices_share_the_source
test_summary
