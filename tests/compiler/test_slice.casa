import "std" as std
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

pub fn make_values -> std::List[i64] {
    [10, 20, 30, 40] std::List::from_array
}

pub fn test_slice_range {
    "slice_range" test::test_start
    make_values = values
    4 1 values.slice = middle
    "runtime length" 3 middle.length test::assert_eq
    "first value" 20 0 middle.nth.clone test::assert_eq
    "last value" 40 2 middle.nth.clone test::assert_eq

    0 = total
    for value in middle.iter do
        value copy += total
    done
    "iteration" 90 total test::assert_eq
}

pub fn test_whole_list_view {
    "whole_list_view" test::test_start
    make_values = values
    values.as_slice = view
    "whole length" 4 view.length test::assert_eq
    "whole value" 30 2 view.nth.clone test::assert_eq
}

pub fn test_slices_share_the_source {
    "slices_share_the_source" test::test_start
    make_values = values
    2 0 values.slice = first
    4 2 values.slice = second
    "first view" 20 1 first.nth.clone test::assert_eq
    "second view" 30 0 second.nth.clone test::assert_eq
}

pub fn test_array_literal_repeated_ownership {
    "array_literal_repeated_ownership" test::test_start
    make_values drop
    make_values = values
    "second evaluation" 30 2 values.get.clone test::assert_eq
}

fn sum values:$std::Slice[i64] -> i64 {
    0 = total
    for value in values.iter do
        value copy += total
    done
    total
}

fn sum_bytes values:$std::Slice[u8] -> u64 {
    0 = total: u64
    for value in values.iter do
        value copy u64::from += total
    done
    total
}

fn return_array_view [T const N:u64] values:$array[T N] -> std::Slice[T] { values.as_slice }

struct Views {
    first:  std::Slice[i64]
    second: std::Slice[i64]
}

fn return_views values:$array[i64 4] -> Views { 4 2 values.slice 2 0 values.slice Views }

pub fn test_storage_sources {
    "storage_sources" test::test_start
    [10, 20, 30, 40] = values
    values return_array_view = array_view
    make_values = list
    list.as_slice = list_view
    "array API" 100 array_view sum test::assert_eq
    "list API" 100 list_view sum test::assert_eq
    3 1 array_view.slice = middle
    "nested range" 50 middle sum test::assert_eq
    2 1 middle.slice = last
    "nested index" 30 0 last.nth copy test::assert_eq
    values return_views = views
    "returned first" 30 views.first sum test::assert_eq
    "returned second" 70 views.second sum test::assert_eq
    "abc" std::Bytes::from_str = bytes
    bytes.as_slice = byte_view
    "bytes length" 3 byte_view.length test::assert_eq
    "bytes value" 98 1 byte_view.nth copy test::assert_eq
    3 1 bytes.slice = byte_tail
    "bytes range" 99 1 byte_tail.nth copy test::assert_eq
    "bytes API" 294 byte_view sum_bytes test::assert_eq
    [97, 98, 99] = byte_array: array[u8 3]
    byte_array.as_slice = byte_array_view
    "byte array API" 294 byte_array_view sum_bytes test::assert_eq
    byte_array std::List::from_array = byte_list
    byte_list.as_slice = byte_list_view
    "byte list API" 294 byte_list_view sum_bytes test::assert_eq
}

pub fn test_empty_views {
    "empty_views" test::test_start
    [] = values: array[i64 0]
    values.as_slice = array_view
    "empty array" array_view.is_empty test::assert_true
    "empty array iteration" 0 array_view sum test::assert_eq
    std::List[i64]::new = list
    list.as_slice = list_view
    "empty list" list_view.is_empty test::assert_true
    "empty list iteration" 0 list_view sum test::assert_eq
    std::Bytes::new = bytes
    bytes.as_slice = byte_view
    "empty bytes" byte_view.is_empty test::assert_true
    "empty byte iteration" 0 byte_view.iter.count test::assert_eq
    [1, 2] = pair
    2 2 pair.slice = empty_end
    "empty end range" empty_end.is_empty test::assert_true
    0 0 empty_end.slice = nested
    "empty nested range" 0 nested sum test::assert_eq
    make_values = nonempty
    4 4 nonempty.slice = list_end
    "empty list end" list_end.is_empty test::assert_true
    "ab" std::Bytes::from_str = nonempty_bytes
    2 2 nonempty_bytes.slice = bytes_end
    "empty bytes end" bytes_end.is_empty test::assert_true
}

struct Tracked {
    drops: ptr
    value: i64
}

impl Tracked {
    fn drop self:mut$Tracked {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

pub fn test_view_does_not_destroy_elements {
    "view_does_not_destroy_elements" test::test_start
    unsafe { 8 alloc = drops 0 drops store64 }
    10 drops Tracked = first
    20 drops Tracked = second
    [first, second] = values
    values.as_slice = view
    0 = total
    for value in view.iter do
        value.value += total
    done
    "non-Copy elements" 30 total test::assert_eq
    view copy = copied
    "copied view of non-Copy elements" 20 1 copied.nth.value test::assert_eq
    copied drop
    "borrowed storage" 0 values.nth ptr::from_ref 0 view.nth ptr::from_ref == test::assert_true
    view drop
    "view drop" 0 unsafe { drops load64 } test::assert_eq
    values drop
    "array drop" 2 unsafe { drops load64 } test::assert_eq
    30 drops Tracked = third
    [third] std::List::from_array = list
    list.as_slice = list_view
    "list element" 30 0 list_view.nth.value test::assert_eq
    list_view drop
    "list view drop" 2 unsafe { drops load64 } test::assert_eq
    list drop
    "list drop" 3 unsafe { drops load64 } test::assert_eq
    unsafe { drops free }
}
test_slice_range
test_whole_list_view
test_slices_share_the_source
test_array_literal_repeated_ownership
test_storage_sources
test_empty_views
test_view_does_not_destroy_elements
test::test_summary
