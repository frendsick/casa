import "../../examples/game_of_life/grid.casa" as life
import "../../lib/test.casa" as test
import "std"

fn test_blinker {
    "game_of_life_blinker" test::test_start
    5 5 life::Grid::new.unwrap = grid
    true 2 1 grid.set
    true 2 2 grid.set
    true 2 3 grid.set
    grid.advance
    "birth above" 1 2 grid.alive test::assert_true
    "survival" 2 2 grid.alive test::assert_true
    "birth below" 3 2 grid.alive test::assert_true
    "underpopulation" 2 1 grid.alive ! test::assert_true
    "underpopulation" 2 3 grid.alive ! test::assert_true
    grid.advance
    "oscillator left" 2 1 grid.alive test::assert_true
    "oscillator middle" 2 2 grid.alive test::assert_true
    "oscillator right" 2 3 grid.alive test::assert_true
}

fn test_wrapping {
    "game_of_life_wrapping" test::test_start
    5 5 life::Grid::new.unwrap = grid
    true 4 4 grid.set
    true 4 0 grid.set
    true 0 4 grid.set
    grid.advance
    "birth across both edges" 0 0 grid.alive test::assert_true
    "corner survives" 4 4 grid.alive test::assert_true
    "top edge survives" 4 0 grid.alive test::assert_true
    "left edge survives" 0 4 grid.alive test::assert_true
    grid.advance
    "wrapped block remains stable" 0 0 grid.alive test::assert_true
}

fn test_bounds {
    "game_of_life_bounds" test::test_start
    "zero width" 1 0 life::Grid::new.is_none test::assert_true
    "negative height" -1 1 life::Grid::new.is_none test::assert_true
    1 1 life::Grid::new.unwrap = grid
    true -1 0 grid.set
    true 0 -1 grid.set
    true 0 1 grid.set
    true 1 0 grid.set
    "outside writes ignored" 0 0 grid.alive ! test::assert_true
    "outside reads dead" 0 1 grid.alive ! test::assert_true
    true 0 0 grid.set
    grid.advance
    "one-cell torus has eight live neighbors" 0 0 grid.alive ! test::assert_true
}
test_blinker
test_wrapping
test_bounds
test::test_summary
