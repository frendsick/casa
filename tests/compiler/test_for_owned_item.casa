import "std"
import "../../lib/test.casa"

fn make_items -> Iter[str] {
    false = yielded
    move {
        if yielded then
            Option[str]::None return
        fi
        true = yielded
        "owned".clone Option::Some
    } Iter
}

"top-level for owns item" test_start
for item in make_items do
    item drop
done
"owned item moved" true assert_true
test_summary
