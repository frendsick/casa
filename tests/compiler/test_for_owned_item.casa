import "std" as std
import "../../lib/test.casa" as test

pub fn make_items -> std::Iter[str] {
    false = yielded
    move {
        if yielded then
            std::Option[str]::None return
        fi
        true = yielded
        "owned".clone std::Option::Some
    } std::Iter
}

pub enum SizedItems {
    Small (array[i64 2])
    Large (array[i64 4])
}

fn read_scoped_array items:SizedItems -> i64 {
    items match
        SizedItems::Small(values) => {
            1 values.nth copy
        }
        SizedItems::Large(values) => {
            3 values.nth copy
        }
    end
}

fn capture_scoped_array items:SizedItems -> i64 {
    items match
        SizedItems::Small(values) => {
            {
                1 values.nth copy
            } exec
        }
        SizedItems::Large(values) => {
            {
                3 values.nth copy
            } exec
        }
    end
}
"scoped aggregate bindings" test::test_start
"small array" 22 [11, 22] SizedItems::Small read_scoped_array test::assert_eq
"large array" 44 [11, 22, 33, 44] SizedItems::Large read_scoped_array test::assert_eq
"small capture" 22 [11, 22] SizedItems::Small capture_scoped_array test::assert_eq
"large capture" 44 [11, 22, 33, 44] SizedItems::Large capture_scoped_array test::assert_eq
"top-level for owns item" test::test_start
for item in make_items do
    item drop
done
"owned item moved" true test::assert_true

struct Cursor {
    remaining: i64
    drops:     ptr
}

impl Cursor {
    fn next self:mut$Cursor -> std::Option[i64] {
        if 0 self.remaining == then
            std::Option::None return
        fi
        1 -= self.remaining
        self.remaining std::Option::Some
    }

    fn drop self:mut$Cursor {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

fn test_iterator_scope drops:ptr {
    for value in Cursor { remaining: 2 drops: drops } do
        break
    done
    "break ends iterator scope" 1 unsafe { drops load64 } test::assert_eq
    for value in Cursor { remaining: 2 drops: drops } do
        continue
    done
    "exhaustion ends iterator scope" 2 unsafe { drops load64 } test::assert_eq
}
"for owns custom inherent cursor" test::test_start
unsafe { 8 alloc = drops 0 drops store64 }
drops test_iterator_scope
"no duplicate cleanup at return" 2 unsafe { drops load64 } test::assert_eq
unsafe { drops free }
test::test_summary
