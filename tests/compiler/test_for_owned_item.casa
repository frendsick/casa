import "std" as std
import "../../lib/test.casa" as test

pub fn make_items -> std::Iter[str] {
    false = yielded
    move {
        if yielded then
            std::Option[str]::None return
        fi
        true = yielded
        "owned".clone std::Option::Some
    } std::Iter
}
"top-level for owns item" test::test_start
for item in make_items do
    item drop
done
"owned item moved" true test::assert_true
test::test_summary
