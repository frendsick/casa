import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "../../compiler/semantics.casa" as semantics
import "helpers.casa" as helpers

# ============================================================================
# Helper: lex + parse + resolve + typecheck a source string
# ============================================================================

pub fn tc_um code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

# ============================================================================
# `print` underflow names the trait expectation as a value, not the trait
# itself.
# ============================================================================

pub fn test_print_underflow_message_names_value_with_trait {
    error::Diagnostics::new = diagnostics
    "print_underflow_message_names_value_with_trait" test::test_start
    diagnostics "fn foo { print }\nfoo\n" tc_um drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "stack underflow kind" common::ErrorKind::StackUnderflow helpers::assert_error_kind
    diagnostics "names value with trait" "value with trait `Display`" helpers::assert_error_contains
}

# ============================================================================
# `rot` underflow names the slot index of the missing argument.
# ============================================================================

pub fn test_rot_underflow_message_names_argument_slot {
    error::Diagnostics::new = diagnostics
    "rot_underflow_message_names_argument_slot" test::test_start
    diagnostics "fn foo { rot }\nfoo\n" tc_um drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "stack underflow kind" common::ErrorKind::StackUnderflow helpers::assert_error_kind
    diagnostics "names argument slot" "argument 1 of `rot`" helpers::assert_error_contains
}

# ============================================================================
# `drop` underflow uses the singular "value for" phrasing.
# ============================================================================

pub fn test_drop_underflow_message_uses_singular_phrase {
    error::Diagnostics::new = diagnostics
    "drop_underflow_message_uses_singular_phrase" test::test_start
    diagnostics "fn foo { drop }\nfoo\n" tc_um drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "stack underflow kind" common::ErrorKind::StackUnderflow helpers::assert_error_kind
    diagnostics "names value for drop" "value for `drop`" helpers::assert_error_contains
}

# ============================================================================
# Cascade slots show as `<missing>`, never the internal `<error>` token.
# ============================================================================

pub fn test_cascade_slot_renders_as_missing_token {
    error::Diagnostics::new = diagnostics
    "cascade_slot_renders_as_missing_token" test::test_start
    diagnostics "fn two_generics[T] a:T b:T {}\nfn foo { print 2 two_generics }\nfoo\n" tc_um drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "renders missing token" "<missing>" helpers::assert_error_contains
}

pub fn assert_parameter_underflow code:$str expected:$str {
    # Preserve parameter descriptions and their original call-site locations.
    error::Diagnostics::new = diagnostics
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics "context source parses" helpers::assert_no_errors
    "caller" store
        .get_function
        .unwrap
        .ops = caller_ops: $std::List[common::Op]
    caller_ops.length 1 - caller_ops
        .get
        .location
        .clone = expected_location
    ops drop
    store semantics::SemanticSession::new = session
    "caller" store.get_function.unwrap = caller
    session caller semantics::continue_function_semantics = checked_diagnostics
    checked_diagnostics "parameter underflow" common::ErrorKind::StackUnderflow helpers::assert_error_kind
    for
        diagnostic in checked_diagnostics
            .entries
            .iter
    do
        if diagnostic error::Diagnostic::Error(error) is then
            if error.kind common::ErrorKind::StackUnderflow != then
                continue
            fi
            "parameter context text" expected error.message.as_str test::assert_str_eq
            "call-site file" expected_location.file error.location.file test::assert_str_eq
            "call-site offset" expected_location.span.offset error
                .location
                .span
                .offset test::assert_eq
            "call-site length" expected_location.span.length error
                .location
                .span
                .length test::assert_eq
        fi
    done
}

pub fn test_parameter_underflow_preserves_context {
    "parameter_underflow_preserves_context" test::test_start
    "Stack underflow: expected `i64` but stack is empty"
    "fn internal__take first:i64 second:i64 { } fn caller { 1 internal__take } caller"
    assert_parameter_underflow
    "Stack underflow: expected parameter `second` of `internal__take` but stack is empty"
    "fn internal__take[T] first:T second:T { } fn caller { 1 internal__take } caller"
    assert_parameter_underflow
    "Stack underflow: expected parameter 2 of `internal__take` but stack is empty"
    "fn internal__take[T] T T { drop drop } fn caller { 1 internal__take } caller"
    assert_parameter_underflow
}

# ============================================================================
# Run all tests
# ============================================================================
test_print_underflow_message_names_value_with_trait
test_rot_underflow_message_names_argument_slot
test_drop_underflow_message_uses_singular_phrase
test_cascade_slot_renders_as_missing_token
test_parameter_underflow_preserves_context
test::test_summary
