import "../../compiler/typechecker.casa"
import "helpers.casa"

# ============================================================================
# Helper: lex + parse + resolve + typecheck a source string
# ============================================================================

fn tc_um code:str diagnostics:Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option[Function]::None ops type_check_ops_for_test
}

# ============================================================================
# `print` underflow names the trait expectation as a value, not the trait
# itself.
# ============================================================================

fn test_print_underflow_message_names_value_with_trait {
    Diagnostics::new = diagnostics
    "print_underflow_message_names_value_with_trait" test_start
    diagnostics "fn foo { print }\nfoo\n" tc_um drop
    diagnostics "has errors" assert_has_errors
    diagnostics "stack underflow kind" ErrorKind::StackUnderflow assert_error_kind
    diagnostics "names value with trait" "value with trait `Display`" assert_error_contains
}

# ============================================================================
# `rot` underflow names the slot index of the missing argument.
# ============================================================================

fn test_rot_underflow_message_names_argument_slot {
    Diagnostics::new = diagnostics
    "rot_underflow_message_names_argument_slot" test_start
    diagnostics "fn foo { rot }\nfoo\n" tc_um drop
    diagnostics "has errors" assert_has_errors
    diagnostics "stack underflow kind" ErrorKind::StackUnderflow assert_error_kind
    diagnostics "names argument slot" "argument 1 of `rot`" assert_error_contains
}

# ============================================================================
# `drop` underflow uses the singular "value for" phrasing.
# ============================================================================

fn test_drop_underflow_message_uses_singular_phrase {
    Diagnostics::new = diagnostics
    "drop_underflow_message_uses_singular_phrase" test_start
    diagnostics "fn foo { drop }\nfoo\n" tc_um drop
    diagnostics "has errors" assert_has_errors
    diagnostics "stack underflow kind" ErrorKind::StackUnderflow assert_error_kind
    diagnostics "names value for drop" "value for `drop`" assert_error_contains
}

# ============================================================================
# Cascade slots show as `<missing>`, never the internal `<error>` token.
# ============================================================================

fn test_cascade_slot_renders_as_missing_token {
    Diagnostics::new = diagnostics
    "cascade_slot_renders_as_missing_token" test_start
    diagnostics "fn two_generics[T] a:T b:T {}\nfn foo { print 2 two_generics }\nfoo\n" tc_um drop
    diagnostics "has errors" assert_has_errors
    diagnostics "renders missing token" "<missing>" assert_error_contains
}

# ============================================================================
# Run all tests
# ============================================================================
test_print_underflow_message_names_value_with_trait
test_rot_underflow_message_names_argument_slot
test_drop_underflow_message_uses_singular_phrase
test_cascade_slot_renders_as_missing_token
test_summary
