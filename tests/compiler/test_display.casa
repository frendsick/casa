# ============================================================================
# Typechecker: print routes primitives to existing specialized ops
# ============================================================================

pub fn test_print_int_dispatches_to_print_int {
    error::Diagnostics::new = diagnostics
    "print_int_dispatches_to_print_int" test::test_start
    diagnostics "42 print\n" display_test_typecheck_ops = ops
    diagnostics "no errors for i64 print" helpers::assert_no_errors
    "i64 print resolves to PrintInt" 1 ops.get.value common::OpValue::PrintInt is test::assert_true
}

pub fn test_print_str_dispatches_to_print_str {
    error::Diagnostics::new = diagnostics
    "print_str_dispatches_to_print_str" test::test_start
    diagnostics "\"hi\" print\n" display_test_typecheck_ops = ops
    diagnostics "no errors for str print" helpers::assert_no_errors
    "str print resolves to PrintStr" 1 ops.get.value common::OpValue::PrintStr is test::assert_true
}

# ============================================================================
# Typechecker: print on user struct with Display lowers to a method call
# ============================================================================

pub fn test_print_struct_with_display_lowers_to_method_call {
    error::Diagnostics::new = diagnostics
    "print_struct_with_display_lowers_to_method_call" test::test_start
    diagnostics DISPLAY_TRAIT "struct Tag { val: i64 }\nimpl Tag: __casa_std__Display { fn to_str self:$Tag -> __casa_std__String { \"tag\".to_str } }\n1 Tag = t\nt print\n" str::concat.as_str display_test_typecheck_ops = ops
    diagnostics "no errors for Display struct print" helpers::assert_no_errors
    0 = lower_index: u64
    0 = fn_call_count
    0 = print_string_count
    while lower_index ops.length > do
        lower_index ops.get.value = lower_value: $common::OpValue
        if lower_value common::OpValue::FnCall(callee) is then
            if "Tag::__casa_std__Display::to_str" callee == then
                1 += fn_call_count
            fi
        fi
        if lower_value common::OpValue::PrintString is then
            1 += print_string_count
        fi
        1 += lower_index
    done
    "exactly one Tag::to_str call" 1 fn_call_count test::assert_eq
    "exactly one PrintString after lowering" 1 print_string_count test::assert_eq
}

# ============================================================================
# Typechecker: print on user struct without Display raises a clear error
# ============================================================================

pub fn test_print_struct_without_display_raises {
    error::Diagnostics::new = diagnostics
    "print_struct_without_display_raises" test::test_start
    diagnostics DISPLAY_TRAIT "struct NoDisplay { val: i64 }\n1 NoDisplay = n\nn print\n" str::concat.as_str display_test_typecheck_error drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "error mentions Display trait" "Display" helpers::assert_error_contains
    diagnostics "missing trait method error kind" common::ErrorKind::MissingTraitMethod helpers::assert_error_kind
}

