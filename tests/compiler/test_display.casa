import "../../compiler/typechecker.casa"
import "helpers.casa"

# ============================================================================
# Constants
# ============================================================================
"trait Display { fn to_str self:self -> str }\n" = DISPLAY_TRAIT
symbol_store_new = DISPLAY_TEST_STORE

# ============================================================================
# Helpers
# ============================================================================

fn display_test_resolve code:$str diagnostics:mut$Diagnostics -> List[Op] {
    global DISPLAY_TEST_STORE
    diagnostics code parse_resolve_test_parts = store = ops
    store = DISPLAY_TEST_STORE
    ops
}

fn display_test_typecheck code:$str diagnostics:mut$Diagnostics -> StackEffect {
    global DISPLAY_TEST_STORE
    diagnostics code parse_resolve_test_parts = store = ops
    store = DISPLAY_TEST_STORE
    diagnostics DISPLAY_TEST_STORE Option[Function]::None ops type_check_ops_for_test
}

fn display_test_typecheck_ops code:$str diagnostics:mut$Diagnostics -> List[Op] {
    global DISPLAY_TEST_STORE
    diagnostics code parse_resolve_test_parts = store = ops
    store = DISPLAY_TEST_STORE
    diagnostics DISPLAY_TEST_STORE Option[Function]::None ops type_check_ops_for_test drop
    ops
}

fn display_test_typecheck_error code:$str diagnostics:mut$Diagnostics -> StackEffect {
    global DISPLAY_TEST_STORE
    diagnostics code parse_resolve_test_parts = store = ops
    store = DISPLAY_TEST_STORE
    diagnostics DISPLAY_TEST_STORE Option[Function]::None ops type_check_ops_for_test
}

fn count_fstring_conversions store:$SymbolStore -> i64 {
    0 = count
    for pair in store.functions.iter do
        for
            op in pair
                .second
                .ops
                .iter
        do
            if op.value OpValue::FstringToStr is then
                1 += count
            fi
        done
    done
    count
}

# ============================================================================
# Parser: OpFstringToStr is emitted for each expression part
# ============================================================================

fn test_parser_emits_fstring_to_str {
    Diagnostics::new = diagnostics
    "parser_emits_fstring_to_str" test_start
    diagnostics "\"x\" = name\nf\"hi {name}\" drop\n" display_test_resolve = ops
    ops drop
    DISPLAY_TEST_STORE count_fstring_conversions = found_count
    "one OpFstringToStr per expression" 1 found_count assert_eq
}

fn test_parser_emits_fstring_to_str_multiple {
    Diagnostics::new = diagnostics
    "parser_emits_fstring_to_str_multiple" test_start
    diagnostics "\"a\" = a\n\"b\" = b\nf\"{a} and {b}\" drop\n" display_test_resolve = ops
    ops drop
    DISPLAY_TEST_STORE count_fstring_conversions = found_count
    "two OpFstringToStr ops for two expressions" 2 found_count assert_eq
}

fn test_parser_no_fstring_to_str_without_expressions {
    Diagnostics::new = diagnostics
    "parser_no_fstring_to_str_without_expressions" test_start
    diagnostics "f\"plain text\" drop\n" display_test_resolve = ops
    ops drop
    DISPLAY_TEST_STORE count_fstring_conversions = found_count
    "no OpFstringToStr for plain f-string" 0 found_count assert_eq
}

# ============================================================================
# Typechecker: f-strings with str expressions pass through unchanged
# ============================================================================

fn test_fstring_str_expression_typechecks {
    Diagnostics::new = diagnostics
    "fstring_str_expression_typechecks" test_start
    diagnostics DISPLAY_TRAIT "\"world\" = greeting\nf\"hello {greeting}\" drop\n" str::concat display_test_typecheck drop
    diagnostics "no errors for str expression" assert_no_errors
}

# ============================================================================
# Typechecker: f-strings with Display-implementing types auto-convert
# ============================================================================

fn test_fstring_int_with_display {
    Diagnostics::new = diagnostics
    "fstring_int_with_display" test_start
    diagnostics DISPLAY_TRAIT "impl i64: Display { fn to_str n:i64 -> str { \"42\" } }\n42 = n\nf\"value {n}\" drop\n" str::concat display_test_typecheck drop
    diagnostics "no errors for i64 with Display" assert_no_errors
}

fn test_fstring_custom_struct_with_display {
    Diagnostics::new = diagnostics
    "fstring_custom_struct_with_display" test_start
    diagnostics DISPLAY_TRAIT "struct Point { x: i64 }\nimpl Point: Display { fn to_str self:Point -> str { \"Point\" } }\n1 Point = p\nf\"value {p}\" drop\n" str::concat display_test_typecheck drop
    diagnostics "no errors for custom struct with Display" assert_no_errors
}

# ============================================================================
# Typechecker: types without Display produce the dedicated f-string error
# ============================================================================

fn test_fstring_missing_display_raises {
    Diagnostics::new = diagnostics
    "fstring_missing_display_raises" test_start
    diagnostics DISPLAY_TRAIT "struct NoDisplay { val: i64 }\n1 NoDisplay = n\nf\"value {n}\" drop\n" str::concat display_test_typecheck_error drop
    diagnostics "has errors" assert_has_errors
    diagnostics "error contains custom f-string message" "cannot be used in f-string" assert_error_contains
    diagnostics "error mentions Display trait" "Display" assert_error_contains
    diagnostics "missing trait method error kind" ErrorKind::MissingTraitMethod assert_error_kind
}

fn test_fstring_primitive_without_display_trait_passes {
    Diagnostics::new = diagnostics
    "fstring_primitive_without_display_trait_passes" test_start
    diagnostics "42 = n\nf\"value {n}\" drop\n" display_test_typecheck_error drop
    diagnostics "primitive f-string does not require Display" assert_no_errors
}

# ============================================================================
# diagnostics type_satisfies_trait_for_test: generic base fallback
# ============================================================================

fn test_type_satisfies_trait_generic_base_fallback {
    Diagnostics::new = diagnostics
    "type_satisfies_trait_generic_base_fallback" test_start
    diagnostics DISPLAY_TRAIT "enum Box[T] { Boxed(T) }\nimpl[T] Box[T]: Display { fn to_str self:Box[T] -> str { \"boxed\" } }\n" str::concat display_test_resolve drop
    Option[Function]::None = no_fn
    "Box[i64] satisfies Display via base" diagnostics DISPLAY_TEST_STORE no_fn "Display" "Box[i64]" parse_type_str type_satisfies_trait_for_test assert_true
    "Box[str] satisfies Display via base" diagnostics DISPLAY_TEST_STORE no_fn "Display" "Box[str]" parse_type_str type_satisfies_trait_for_test assert_true
}

fn test_type_satisfies_trait_no_fallback_method {
    Diagnostics::new = diagnostics
    "type_satisfies_trait_no_fallback_method" test_start
    diagnostics DISPLAY_TRAIT "enum Bag[T] { Empty Full(T) }\n" str::concat display_test_resolve drop
    Option[Function]::None = no_fn
    "Bag[i64] does not satisfy without to_str" diagnostics DISPLAY_TEST_STORE no_fn "Display" "Bag[i64]" parse_type_str type_satisfies_trait_for_test ! assert_true
}

# ============================================================================
# check_push_var: trait method calls simulate the exec
# ============================================================================

fn test_trait_method_call_pushes_return_type {
    Diagnostics::new = diagnostics
    "trait_method_call_pushes_return_type" test_start
    diagnostics DISPLAY_TRAIT "struct Tag { val: i64 }\nimpl Tag: Display { fn to_str self:Tag -> str { \"tag\" } }\nfn show[T: Display] x:T -> str { x T::to_str }\n1 Tag = t\nt show drop\n" str::concat display_test_typecheck drop
    "show" DISPLAY_TEST_STORE
        .functions
        .get
        .unwrap = func
    "stack effect has str return type" "str" 0 func Function::stack_effect StackEffect::return_types.get.format assert_str_eq
    diagnostics "no errors" assert_no_errors
}

# ============================================================================
# inject_trait_fn_ptrs: multi-type-parameter ordering (the Result[T E] bug)
# ============================================================================

fn test_multi_trait_bound_ordering {
    Diagnostics::new = diagnostics
    "multi_trait_bound_ordering" test_start
    diagnostics DISPLAY_TRAIT "fn either[A: Display, B: Display] a:A b:B -> str { a A::to_str }\nimpl i64: Display { fn to_str n:i64 -> str { \"i\" } }\nimpl bool: Display { fn to_str b:bool -> str { \"b\" } }\n1 true either drop\n" str::concat display_test_typecheck drop
    diagnostics "no errors for multi-bound call" assert_no_errors
}

# ============================================================================
# Integration: explicit .to_str inside an f-string still works (identity path)
# ============================================================================

fn test_fstring_explicit_to_str_still_works {
    Diagnostics::new = diagnostics
    "fstring_explicit_to_str_still_works" test_start
    diagnostics DISPLAY_TRAIT "impl i64 { fn to_str n:i64 -> str { \"n\" } }\n42 = n\nf\"value {n .to_str}\" drop\n" str::concat display_test_typecheck drop
    diagnostics "no errors with explicit .to_str" assert_no_errors
}

# ============================================================================
# Integration: nested f-strings with mixed primitive types
# ============================================================================

fn test_fstring_mixed_types {
    Diagnostics::new = diagnostics
    "fstring_mixed_types" test_start
    diagnostics DISPLAY_TRAIT "impl i64: Display { fn to_str n:i64 -> str { \"i\" } }\nimpl bool: Display { fn to_str b:bool -> str { \"b\" } }\n42 = n\ntrue = flag\nf\"n={n} flag={flag}\" drop\n" str::concat display_test_typecheck drop
    diagnostics "no errors for mixed primitive f-string" assert_no_errors
}

# ============================================================================
# Typechecker: print routes primitives to existing specialized ops
# ============================================================================

fn test_print_int_dispatches_to_print_int {
    Diagnostics::new = diagnostics
    "print_int_dispatches_to_print_int" test_start
    diagnostics "42 print\n" display_test_typecheck_ops = ops
    diagnostics "no errors for i64 print" assert_no_errors
    "i64 print resolves to PrintInt" 1 ops.get.value OpValue::PrintInt is assert_true
}

fn test_print_str_dispatches_to_print_str {
    Diagnostics::new = diagnostics
    "print_str_dispatches_to_print_str" test_start
    diagnostics "\"hi\" print\n" display_test_typecheck_ops = ops
    diagnostics "no errors for str print" assert_no_errors
    "str print resolves to PrintStr" 1 ops.get.value OpValue::PrintStr is assert_true
}

# ============================================================================
# Typechecker: print on user struct with Display lowers to a method call
# ============================================================================

fn test_print_struct_with_display_lowers_to_method_call {
    Diagnostics::new = diagnostics
    "print_struct_with_display_lowers_to_method_call" test_start
    diagnostics DISPLAY_TRAIT "struct Tag { val: i64 }\nimpl Tag: Display { fn to_str self:Tag -> str { \"tag\" } }\n1 Tag = t\nt print\n" str::concat display_test_typecheck_ops = ops
    diagnostics "no errors for Display struct print" assert_no_errors
    0 (u64) = lower_index
    0 = fn_call_count
    0 = print_str_count
    while lower_index ops.length > do
        lower_index ops.get.value = lower_value: $OpValue
        if lower_value OpValue::FnCall(callee) is then
            if "Tag::Display::to_str" callee == then
                1 += fn_call_count
            fi
        fi
        if lower_value OpValue::PrintStr is then
            1 += print_str_count
        fi
        1 += lower_index
    done
    "exactly one Tag::to_str call" 1 fn_call_count assert_eq
    "exactly one PrintStr after lowering" 1 print_str_count assert_eq
}

# ============================================================================
# Typechecker: print on user struct without Display raises a clear error
# ============================================================================

fn test_print_struct_without_display_raises {
    Diagnostics::new = diagnostics
    "print_struct_without_display_raises" test_start
    diagnostics DISPLAY_TRAIT "struct NoDisplay { val: i64 }\n1 NoDisplay = n\nn print\n" str::concat display_test_typecheck_error drop
    diagnostics "has errors" assert_has_errors
    diagnostics "error mentions Display trait" "Display" assert_error_contains
    diagnostics "missing trait method error kind" ErrorKind::MissingTraitMethod assert_error_kind
}

