import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

# ============================================================================
# Constants
# ============================================================================
const DISPLAY_TRAIT "struct __casa_std__String { data: str }\nimpl str { fn to_str self:$str -> __casa_std__String { self copy __casa_std__String } }\ntrait __casa_std__Clone { fn clone self:$self -> self }\nimpl str: __casa_std__Clone { fn clone self:$str -> str { \"\" } }\ntrait __casa_std__Display { fn to_str self:$self -> __casa_std__String }\n"

# ============================================================================
# Helpers
# ============================================================================

pub fn display_test_resolve_parts
    code:$str
    diagnostics:mut$error::Diagnostics
-> std::List[common::Op] common::SymbolStore {
    diagnostics code helpers::parse_resolve_test_parts
}

pub fn display_test_typecheck_parts
    code:$str
    diagnostics:mut$error::Diagnostics
-> common::StackEffect common::SymbolStore {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops typechecker::check_ops = effect
    effect
    store
}

pub fn display_test_typecheck code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code display_test_typecheck_parts = store = effect
    store drop
    effect
}

pub fn display_test_typecheck_ops
    code:$str
    diagnostics:mut$error::Diagnostics
-> std::List[common::Op] {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops typechecker::check_ops drop
    ops
}

pub fn display_test_typecheck_error
    code:$str
    diagnostics:mut$error::Diagnostics
-> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops typechecker::check_ops = effect
    effect
}

pub fn count_fstring_conversions store:$common::SymbolStore -> i64 {
    0 = count
    for function_name in store.get_function_names.iter do
        function_name.as_str store.get_function.unwrap = function
        for op in function.ops.iter do
            if op.value common::OpValue::FstringToStr is then
                1 += count
            fi
        done
    done
    count
}

# ============================================================================
# Parser: OpFstringToStr is emitted for each expression part
# ============================================================================

pub fn test_parser_emits_fstring_to_str {
    error::Diagnostics::new = diagnostics
    "parser_emits_fstring_to_str" test::test_start
    diagnostics "\"x\" = name\nf\"hi {name}\" drop\n" display_test_resolve_parts = store = ops
    store count_fstring_conversions = found_count
    "one OpFstringToStr per expression" 1 found_count test::assert_eq
}

pub fn test_parser_emits_fstring_to_str_multiple {
    error::Diagnostics::new = diagnostics
    "parser_emits_fstring_to_str_multiple" test::test_start
    diagnostics "\"a\" = a\n\"b\" = b\nf\"{a} and {b}\" drop\n" display_test_resolve_parts = store = ops
    store count_fstring_conversions = found_count
    "two OpFstringToStr ops for two expressions" 2 found_count test::assert_eq
}

pub fn test_parser_no_fstring_to_str_without_expressions {
    error::Diagnostics::new = diagnostics
    "parser_no_fstring_to_str_without_expressions" test::test_start
    diagnostics "f\"plain text\" drop\n" display_test_resolve_parts = store = ops
    store count_fstring_conversions = found_count
    "no OpFstringToStr for plain f-string" 0 found_count test::assert_eq
}

# ============================================================================
# Typechecker: f-strings with str expressions pass through unchanged
# ============================================================================

pub fn test_fstring_str_expression_typechecks {
    error::Diagnostics::new = diagnostics
    "fstring_str_expression_typechecks" test::test_start
    diagnostics DISPLAY_TRAIT "\"world\" = greeting\nf\"hello {greeting}\" drop\n" str::concat.as_str display_test_typecheck drop
    diagnostics "no errors for str expression" helpers::assert_no_errors
}

# ============================================================================
# Typechecker: f-strings with Display-implementing types auto-convert
# ============================================================================

pub fn test_fstring_int_with_display {
    error::Diagnostics::new = diagnostics
    "fstring_int_with_display" test::test_start
    diagnostics DISPLAY_TRAIT "impl i64: __casa_std__Display { fn to_str n:$i64 -> __casa_std__String { \"42\".to_str } }\n42 = n\nf\"value {n}\" drop\n" str::concat.as_str display_test_typecheck drop
    diagnostics "no errors for i64 with Display" helpers::assert_no_errors
}

pub fn test_fstring_custom_struct_with_display {
    error::Diagnostics::new = diagnostics
    "fstring_custom_struct_with_display" test::test_start
    diagnostics DISPLAY_TRAIT "struct Point { x: i64 }\nimpl Point: __casa_std__Display { fn to_str self:$Point -> __casa_std__String { \"Point\".to_str } }\n1 Point = p\nf\"value {p}\" drop\n" str::concat.as_str display_test_typecheck drop
    diagnostics "no errors for custom struct with Display" helpers::assert_no_errors
}

# ============================================================================
# Typechecker: types without Display produce the dedicated f-string error
# ============================================================================

pub fn test_fstring_missing_display_raises {
    error::Diagnostics::new = diagnostics
    "fstring_missing_display_raises" test::test_start
    diagnostics DISPLAY_TRAIT "struct NoDisplay { val: i64 }\n1 NoDisplay = n\nf\"value {n}\" drop\n" str::concat.as_str display_test_typecheck_error drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "error contains custom f-string message" "cannot be used in f-string" helpers::assert_error_contains
    diagnostics "error mentions Display trait" "Display" helpers::assert_error_contains
    diagnostics "missing trait method error kind" common::ErrorKind::MissingTraitMethod helpers::assert_error_kind
}

pub fn test_fstring_primitive_without_display_trait_passes {
    error::Diagnostics::new = diagnostics
    "fstring_primitive_without_display_trait_passes" test::test_start
    diagnostics "struct __casa_std__String { data: str }\nimpl str { fn to_str self:$str -> __casa_std__String { self copy __casa_std__String } }\n42 = n\nf\"value {n}\" drop\n" display_test_typecheck_error drop
    diagnostics "primitive f-string does not require Display" helpers::assert_no_errors
}

# ============================================================================
# diagnostics type_satisfies_trait_for_test: generic base fallback
# ============================================================================

pub fn test_type_satisfies_trait_generic_base_fallback {
    error::Diagnostics::new = diagnostics
    "type_satisfies_trait_generic_base_fallback" test::test_start
    diagnostics DISPLAY_TRAIT "enum Box[T] { Boxed(T) }\nimpl[T] Box[T]: __casa_std__Display { fn to_str self:$Box[T] -> __casa_std__String { \"boxed\".to_str } }\n" str::concat.as_str display_test_resolve_parts = store = ops
    std::Option[common::Function]::None = no_fn
    "Box[i64] satisfies Display via base" diagnostics store no_fn common::STD_DISPLAY_TRAIT "Box[i64]" common::parse_type_str helpers::type_satisfies_trait_for_test test::assert_true
    "Box[str] satisfies Display via base" diagnostics store no_fn common::STD_DISPLAY_TRAIT "Box[str]" common::parse_type_str helpers::type_satisfies_trait_for_test test::assert_true
}

pub fn test_type_satisfies_trait_no_fallback_method {
    error::Diagnostics::new = diagnostics
    "type_satisfies_trait_no_fallback_method" test::test_start
    diagnostics DISPLAY_TRAIT "enum Bag[T] { Empty Full(T) }\n" str::concat.as_str display_test_resolve_parts = store = ops
    std::Option[common::Function]::None = no_fn
    "Bag[i64] does not satisfy without to_str" diagnostics store no_fn common::STD_DISPLAY_TRAIT "Bag[i64]" common::parse_type_str helpers::type_satisfies_trait_for_test ! test::assert_true
}

# ============================================================================
# check_push_var: trait method calls simulate the exec
# ============================================================================

pub fn test_trait_method_call_pushes_return_type {
    error::Diagnostics::new = diagnostics
    "trait_method_call_pushes_return_type" test::test_start
    diagnostics DISPLAY_TRAIT "struct Tag { val: i64 }\nimpl Tag: __casa_std__Display { fn to_str self:$Tag -> __casa_std__String { \"tag\".to_str } }\nfn show[T: __casa_std__Display] x:T -> __casa_std__String { x T::to_str }\n1 Tag show drop\n" str::concat.as_str display_test_typecheck_parts = store = effect
    "show" store.get_function.unwrap = func
    "stack effect has String return type" common::STD_STRING_TYPE 0 func common::Function::stack_effect common::StackEffect::return_types
        .get
        .format
        .as_str test::assert_str_eq
    diagnostics "no errors" helpers::assert_no_errors
}

# ============================================================================
# Generic specialization: multi-type-parameter ordering (the Result[T E] bug)
# ============================================================================

pub fn test_multi_trait_bound_ordering {
    error::Diagnostics::new = diagnostics
    "multi_trait_bound_ordering" test::test_start
    diagnostics DISPLAY_TRAIT "fn either[A: __casa_std__Display, B: __casa_std__Display] a:A b:B -> __casa_std__String { a A::to_str }\nimpl i64: __casa_std__Display { fn to_str n:$i64 -> __casa_std__String { \"i\".to_str } }\nimpl bool: __casa_std__Display { fn to_str b:$bool -> __casa_std__String { \"b\".to_str } }\n1 true either drop\n" str::concat.as_str display_test_typecheck drop
    diagnostics "no errors for multi-bound call" helpers::assert_no_errors
}

# ============================================================================
