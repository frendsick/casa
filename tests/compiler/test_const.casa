import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../compiler/syntax.casa" as syntax
import "../../lib/test.casa" as test

pub const MAX_SIZE 100
pub const GREETING "hello"
pub const DEBUG false
pub const ENABLED true
pub const NEWLINE '\n'

pub fn test_const_int {
    "const_int" test::test_start
    "value" 100 MAX_SIZE test::assert_eq
}

pub fn test_const_str {
    "const_str" test::test_start
    "value" "hello" GREETING test::assert_str_eq
}

pub fn test_const_bool_false {
    "const_bool_false" test::test_start
    "value" DEBUG ! test::assert_true
}

pub fn test_const_bool_true {
    "const_bool_true" test::test_start
    "value" ENABLED test::assert_true
}

pub fn test_const_char {
    "const_char" test::test_start
    "value" '\n'.codepoint i64::from NEWLINE.codepoint i64::from test::assert_eq
}

pub fn test_const_in_expression {
    "const_in_expression" test::test_start
    "value" 200 MAX_SIZE 2 * test::assert_eq
}
pub const fn double x: i64 -> i64 { x 2 * }
pub const fn add x: i64 y: i64 -> i64 { x y + }
pub const fn add_base x: i64 -> i64 { x MAX_SIZE + }
pub const DOUBLED { MAX_SIZE double }
pub const SUM { 3 4 add }
pub const BASED { 5 add_base }
pub const fn quad x: i64 -> i64 { x double double }
pub const QUAD_VAL { 3 quad }

pub fn test_const_fn_runtime {
    "const_fn_runtime" test::test_start
    "value" 10 5 double test::assert_eq
}

pub fn test_const_block_expr {
    "const_block_expr" test::test_start
    "value" 200 DOUBLED test::assert_eq
}

pub fn test_const_fn_multi_params {
    "const_fn_multi_params" test::test_start
    "add_runtime" 7 3 4 add test::assert_eq
    "add_const" 7 SUM test::assert_eq
}

pub fn test_const_fn_uses_constant {
    "const_fn_uses_constant" test::test_start
    "value" 105 BASED test::assert_eq
}

pub fn test_const_fn_calls_const_fn {
    "const_fn_calls_const_fn" test::test_start
    "runtime" 12 3 quad test::assert_eq
    "const" 12 QUAD_VAL test::assert_eq
}

pub fn test_const_fn_folding {
    "const_fn_folding" test::test_start
    "folded_add" 7 3 4 add test::assert_eq
    "folded_double" 10 5 double test::assert_eq
    "folded_chain" 20 5 double double test::assert_eq
}
test_const_int
test_const_str
test_const_bool_false
test_const_bool_true
test_const_char
test_const_in_expression
test_const_fn_runtime
test_const_block_expr
test_const_fn_multi_params
test_const_fn_uses_constant
test_const_fn_calls_const_fn
test_const_fn_folding
test::test_summary
