import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../compiler/source_builder.casa" as syntax
import "../../lib/test.casa" as test
import "../../lib/std.casa" as std
import "helpers.casa" as helpers

pub const MAX_SIZE 100
pub const GREETING "hello"
pub const DEBUG false
pub const ENABLED true
pub const NEWLINE '\n'

pub fn test_const_int {
    "const_int" test::test_start
    "value" 100 MAX_SIZE test::assert_eq
}

pub fn test_const_str {
    "const_str" test::test_start
    "value" "hello" GREETING test::assert_str_eq
}

pub fn test_const_bool_false {
    "const_bool_false" test::test_start
    "value" DEBUG ! test::assert_true
}

pub fn test_const_bool_true {
    "const_bool_true" test::test_start
    "value" ENABLED test::assert_true
}

pub fn test_const_char {
    "const_char" test::test_start
    "value" '\n'.codepoint i64::from NEWLINE.codepoint i64::from test::assert_eq
}

pub fn test_const_in_expression {
    "const_in_expression" test::test_start
    "value" 200 MAX_SIZE 2 * test::assert_eq
}
pub const DOUBLED: i64 { MAX_SIZE 2 * }
pub const SUM { 3 4 + }
pub const DIFFERENCE { 10 3 - }
pub const GREATER { 0 1 < }
pub const SHIFTED: u8 { 255 1 >> }
pub const FLOAT_PRODUCT: f32 { 0.1 2.0 * }
pub const STACK_DUP { 4 dup + }
pub const STACK_DROP { 4 9 drop }
pub const STACK_SWAP { 10 3 swap - }
pub const STACK_OVER { 10 3 over + + }
pub const STACK_ROT { 10 3 2 rot - - }
pub const ALIAS DOUBLED
pub const SMALL: u8 { 120 1 + }
pub const MAX_U64: u64 18446744073709551615
pub const MAX_U64_MINUS_ONE: u64 { MAX_U64 1 - }
pub const MIN_I64: i64 -9223372036854775808
pub const WRAPPED_SHIFT: u8 { 128 1 << }
pub const SIGNED_SHIFT: i8 { -2 1 >> }
pub const BITWISE: u8 { 12 10 & 3 | 1 ^ }
pub const REMAINDER { 10 3 % }
pub const INTEGER_NOT { 0 ! }
pub const BOOLEAN_RESULT { true false || true && ! }
pub const FLOAT_DIRECT: f32 1.000000059604644775390626
pub const FLOAT_SUBNORMAL: f32 1.401298464324817e-45
pub const FLOAT_SUBNORMAL_SUM: f32 { FLOAT_SUBNORMAL FLOAT_SUBNORMAL + }
pub const FLOAT_NEGATIVE_ZERO: f32 { -0.0 1.0 * }
pub const FLOAT_INFINITY: f64 { 1.0 0.0 / }
pub const FLOAT_NAN: f64 { 0.0 0.0 / }
pub const NAN_UNORDERED { FLOAT_NAN 0.0 < }
pub const NAN_UNEQUAL { FLOAT_NAN FLOAT_NAN != }
pub const SIGNED_LOW: i64 -3
pub const SIGNED_HIGH: i64 9
pub const UNSIGNED_LOW: u8 3
pub const UNSIGNED_HIGH: u8 9
pub const FLOAT32_LOW: f32 1.5
pub const FLOAT32_HIGH: f32 9.0
pub const FLOAT64_LOW: f64 1.5
pub const FLOAT64_HIGH: f64 9.0
pub const SIGNED_ORDER {
    SIGNED_HIGH SIGNED_LOW > SIGNED_HIGH SIGNED_LOW >= &&
    SIGNED_LOW SIGNED_HIGH < && SIGNED_LOW SIGNED_HIGH <= &&
}
pub const UNSIGNED_ORDER {
    UNSIGNED_HIGH UNSIGNED_LOW > UNSIGNED_HIGH UNSIGNED_LOW >= &&
    UNSIGNED_LOW UNSIGNED_HIGH < && UNSIGNED_LOW UNSIGNED_HIGH <= &&
}
pub const FLOAT32_ORDER {
    FLOAT32_HIGH FLOAT32_LOW > FLOAT32_HIGH FLOAT32_LOW >= &&
    FLOAT32_LOW FLOAT32_HIGH < && FLOAT32_LOW FLOAT32_HIGH <= &&
}
pub const FLOAT64_ORDER {
    FLOAT64_HIGH FLOAT64_LOW > FLOAT64_HIGH FLOAT64_LOW >= &&
    FLOAT64_LOW FLOAT64_HIGH < && FLOAT64_LOW FLOAT64_HIGH <= &&
}
pub const SIGNED_QUOTIENT { 10 2 / }
pub const UNSIGNED_QUOTIENT: u8 { UNSIGNED_HIGH UNSIGNED_LOW / }
pub const FLOAT32_QUOTIENT: f32 { 10.0 2.0 / }
pub const FLOAT64_QUOTIENT: f64 { 10.0 2.0 / }
pub const LEFT_SHIFT: u8 { 3 2 << }
pub const RIGHT_SHIFT: u8 { 32 2 >> }

fn accept_small_array values:array[u8 1] { values drop }

pub fn test_typed_constant_values {
    "typed_constant_values" test::test_start
    "typed integer" 200 DOUBLED test::assert_eq
    "alias keeps width" 200 ALIAS test::assert_eq
    "float rounds to f32" FLOAT_PRODUCT 0.2 == test::assert_true
    "shift keeps width" 127 SHIFTED i64::from test::assert_eq
}

pub fn test_const_block_expr {
    "const_block_expr" test::test_start
    "value" 200 DOUBLED test::assert_eq
    "addition" 7 SUM test::assert_eq
    "subtraction order" 7 DIFFERENCE test::assert_eq
    "comparison order" GREATER test::assert_true
}

pub fn test_const_operand_order {
    "const_operand_order" test::test_start
    "signed comparisons" SIGNED_ORDER test::assert_true
    "unsigned comparisons" UNSIGNED_ORDER test::assert_true
    "f32 comparisons" FLOAT32_ORDER test::assert_true
    "f64 comparisons" FLOAT64_ORDER test::assert_true
    "signed division" 5 SIGNED_QUOTIENT test::assert_eq
    "unsigned division" 3 UNSIGNED_QUOTIENT i64::from test::assert_eq
    "f32 division" FLOAT32_QUOTIENT 5.0 == test::assert_true
    "f64 division" FLOAT64_QUOTIENT 5.0 == test::assert_true
    "left shift" 12 LEFT_SHIFT i64::from test::assert_eq
    "right shift" 8 RIGHT_SHIFT i64::from test::assert_eq
}

pub fn test_const_stack_intrinsics {
    "const_stack_intrinsics" test::test_start
    "dup" 8 STACK_DUP test::assert_eq
    "drop" 4 STACK_DROP test::assert_eq
    "swap" -7 STACK_SWAP test::assert_eq
    "over" 23 STACK_OVER test::assert_eq
    "rot" 11 STACK_ROT test::assert_eq
}

pub fn test_const_numeric_boundaries {
    "const_numeric_boundaries" test::test_start
    [SMALL] accept_small_array
    "u64 maximum" 18446744073709551614 MAX_U64_MINUS_ONE == test::assert_true
    "i64 minimum" -9223372036854775808 MIN_I64 test::assert_eq
    "narrow left shift discards high bit" 0 WRAPPED_SHIFT i64::from test::assert_eq
    "signed right shift keeps sign" -1 SIGNED_SHIFT i64::from test::assert_eq
    "bitwise operations" 10 BITWISE i64::from test::assert_eq
    "remainder" 1 REMAINDER test::assert_eq
    "integer not tests zero" INTEGER_NOT test::assert_true
    "boolean operators" BOOLEAN_RESULT test::assert_false
}

pub fn test_const_float_edges {
    "const_float_edges" test::test_start
    "f32 literal rounds directly" 1065353217 FLOAT_DIRECT.to_bits == test::assert_true
    "f32 subnormal" 1 FLOAT_SUBNORMAL.to_bits == test::assert_true
    "f32 result rounds at width" 2 FLOAT_SUBNORMAL_SUM.to_bits == test::assert_true
    "negative zero" 2147483648 FLOAT_NEGATIVE_ZERO.to_bits == test::assert_true
    "division may produce infinity" FLOAT_INFINITY.is_infinite test::assert_true
    "division may produce NaN" FLOAT_NAN.is_nan test::assert_true
    "NaN ordered comparison" NAN_UNORDERED test::assert_false
    "NaN compares unequal to itself" NAN_UNEQUAL test::assert_true
}

pub fn test_const_failures {
    "const_failures" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "const BAD { 1 0 / } const NEXT { BAD 1 + }"
    helpers::parse_resolve_test_source
    drop
    diagnostics "zero divisor is attributed" "1 0 /" helpers::assert_error_contains
    diagnostics "dependent value is unavailable" "BAD` is unavailable" helpers::assert_error_contains

    error::Diagnostics::new = independent_diagnostics
    independent_diagnostics
    "const BAD { 1 0 / }\nconst GOOD { 4 dup + }\nGOOD print"
    helpers::parse_resolve_test_source = independent_result
    "later constant survives an earlier error" "GOOD" independent_result
        .store
        .constants
        .has_str test::assert_true
    "failed constant stays unavailable" "BAD" independent_result
        .store
        .constants
        .has_str ! test::assert_true

    error::Diagnostics::new = body_diagnostics
    body_diagnostics "const BAD { 1 0 / }\nBAD print" helpers::parse_resolve_test_source drop
    body_diagnostics "body use names failed declaration" "Constant `BAD` is unavailable" helpers::assert_error_contains

    error::Diagnostics::new = type_diagnostics
    type_diagnostics "const BAD { 1 0 / }\nfn use x:array[i64 BAD] { x drop }" helpers::parse_resolve_test_source drop
    type_diagnostics "type argument names failed declaration" "Constant `BAD` is unavailable" helpers::assert_error_contains

    error::Diagnostics::new = stack_diagnostics
    stack_diagnostics "const BAD { 1 2 }" helpers::parse_resolve_test_source drop
    stack_diagnostics "surplus values are rejected" "exactly one value" helpers::assert_error_contains

    error::Diagnostics::new = empty_stack
    empty_stack "const BAD { }" helpers::parse_resolve_test_source drop
    empty_stack "empty final stack" "exactly one value" helpers::assert_error_contains

    error::Diagnostics::new = underflow
    underflow "const BAD { 1 + }" helpers::parse_resolve_test_source drop
    underflow "stack underflow" "Stack underflow" helpers::assert_error_contains

    error::Diagnostics::new = intrinsic_underflow
    intrinsic_underflow "const BAD { dup }" helpers::parse_resolve_test_source drop
    intrinsic_underflow "stack intrinsic underflow" "Stack underflow at `dup`" helpers::assert_error_contains

    error::Diagnostics::new = width_mismatch
    width_mismatch "const N:u8 3\nconst BAD { 1 2 + N + }" helpers::parse_resolve_test_source drop
    width_mismatch "width mismatch" "different widths" helpers::assert_error_contains

    error::Diagnostics::new = narrow_overflow
    narrow_overflow "const BAD:u8 { 255 1 + }" helpers::parse_resolve_test_source drop
    narrow_overflow "narrow integer overflow" "255 1 +" helpers::assert_error_contains

    error::Diagnostics::new = signed_division
    signed_division "const BAD:i64 { -9223372036854775808 -1 / }" helpers::parse_resolve_test_source drop
    signed_division "signed minimum division" "-9223372036854775808 -1 /" helpers::assert_error_contains
}

# A failed term stops execution before later names are resolved. Each following
# declaration still gets its own evaluation and failed declarations keep an identity.
fn test_const_execution_failure_order {
    "const_execution_failure_order" test::test_start
    for
        expression in [
            "dup MISSING",
            "drop MISSING",
            "1 swap MISSING",
            "1 over MISSING",
            "1 2 rot MISSING",
            "1 + MISSING",
            "1 0 / MISSING",
            "MISSING 1 0 /",
            "1 copy MISSING",
        ].iter
    do
        f"const BAD \{ {expression} \}\nconst GOOD \{ 4 dup + \}\nconst DEPENDENT BAD" = source
        error::Diagnostics::new = diagnostics
        diagnostics source.as_str helpers::parse_resolve_test_source = parsed
        diagnostics "one error per failed declaration" 2 helpers::assert_error_count
        "independent constant commits" "GOOD" parsed
            .store
            .constants
            .has_str test::assert_true
        "failed initializer has no value" "BAD" parsed
            .store
            .constants
            .has_str test::assert_false
        "failed initializer identity retained" "BAD" parsed
            .store
            .failed_constants
            .has_str test::assert_true
        0 diagnostics.entries.get = first
        if first error::Diagnostic::Error(failure) is then
            if "MISSING 1 0 /" expression == then
                "reference failure precedes arithmetic" "Unknown constant `MISSING`"
                failure.message.as_str test::assert_str_eq
            else
                "later reference is not resolved" failure.message.as_str "MISSING" str::contains test::assert_false
            fi
        fi
        1 diagnostics.entries.get = second
        if second error::Diagnostic::Error(failure) is then
            "dependent error follows initializer failure" "Constant `BAD` is unavailable"
            failure.message.as_str test::assert_str_eq
        fi
    done
}

fn test_const_nonconstant_declarations {
    "const_nonconstant_declarations" test::test_start
    for
        source in [
            "fn value -> i64 { 42 }\nconst ANSWER value",
            "const ANSWER value\nfn value -> i64 { 42 }",
            "struct value { field:i64 }\nconst ANSWER value",
            "const ANSWER { value }\nstruct value { field:i64 }",
            "enum value { Item }\nconst ANSWER value",
            "const ANSWER { value }\nenum value { Item }",
            "trait value { fn get self:Self -> i64 }\nconst ANSWER value",
            "const ANSWER { value }\ntrait value { fn get self:Self -> i64 }",
        ].iter
    do
        error::Diagnostics::new = diagnostics
        diagnostics source helpers::parse_resolve_test_source drop
        diagnostics "one initializer error" 1 helpers::assert_error_count
        diagnostics "declaration is not a constant" "`value` is not a constant" helpers::assert_error_contains
        diagnostics "non-constant type error" common::ErrorKind::TypeMismatch helpers::assert_error_kind
        for diagnostic in diagnostics.entries.iter do
            if diagnostic error::Diagnostic::Error(failure) is then
                failure.location.span = span: $common::Span
                source span.offset span.length str::substring = reference
                "initializer reference location" "value" reference.as_str test::assert_str_eq
            fi
        done
    done
}

fn test_const_unsupported_terms {
    "const_unsupported_terms" test::test_start
    for expression in ["{ 2 }", "VALUE[1]", "VALUE {}", "1 = local", "1 copy", "size_of[i64]"].iter do
        std::String::new = source
        "const VALUE 3\nconst BAD { " source.append
        expression source.append
        " }\nconst GOOD { VALUE 2 - }" source.append
        error::Diagnostics::new = diagnostics
        diagnostics source.as_str helpers::parse_resolve_test_source = parsed
        diagnostics "unsupported expression" "Unsupported" helpers::assert_error_contains
        "failed declaration has no value" "BAD" parsed
            .store
            .constants
            .has_str ! test::assert_true
        "later declaration still evaluates" "GOOD" parsed
            .store
            .constants
            .has_str test::assert_true
    done
}

fn test_const_header_and_body_lookups {
    "const_header_and_body_lookups" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "struct Buffer { data:array[u8 LENGTH] }\nenum Payload { Bytes(array[u8 LENGTH]) }\ntrait Reader { fn read self:$Self -> array[u8 LENGTH] }\nfn identity data:array[u8 LENGTH] -> array[u8 LENGTH] { data }\nconst LENGTH:u64 { 4 2 - }\nfn use { [1, 2] = data:array[u8 LENGTH] data identity drop size_of[Buffer] drop }"
    helpers::parse_resolve_test_source drop
    diagnostics "headers and bodies borrow completed constants" helpers::assert_no_errors
}

fn test_const_annotation_lookup {
    "const_annotation_lookup" test::test_start
    error::Diagnostics::new = shadowed
    shadowed "const i64 3\nconst VALUE:i64 1" helpers::parse_resolve_test_source = first
    shadowed "named constant takes precedence" "primitive value type" helpers::assert_error_contains
    "invalid annotation has no value" "VALUE" first
        .store
        .constants
        .has_str ! test::assert_true

    error::Diagnostics::new = failed
    "const i64 { 1 0 / }\nconst VALUE:i64 1\nconst GOOD:u8 2" = source
    failed source helpers::parse_resolve_test_source = second
    failed "annotation names failed constant" "Constant `i64` is unavailable" helpers::assert_error_contains
    "failed annotation has no value" "VALUE" second
        .store
        .constants
        .has_str ! test::assert_true
    "independent annotation succeeds" "GOOD" second
        .store
        .constants
        .has_str test::assert_true
    for diagnostic in failed.entries.iter do
        if diagnostic error::Diagnostic::Error(failure) is then
            if failure.kind common::ErrorKind::UndefinedName swap == then
                failure.location.span = span: $common::Span
                source span.offset span.length str::substring = reference
                "annotation dependency location" "i64" reference test::assert_str_eq
            fi
        fi
    done
}
