import "std" as std
import "../../lib/test.casa" as test

struct Item {
    value: i64
    drops: ptr
}

impl Item {
    fn drop self:mut$Item {
        unsafe { self.drops load64 10 * self.value u64::try_from.unwrap + self.drops store64 }
    }
}

fn next_value callback:$fn[-> std::Option[i64]] -> std::Option[i64] { callback exec }

fn counter initial:i64 -> fn[-> std::Option[i64]] {
    move {
        if initial 0 == then
            std::Option::None return
        fi
        initial = result
        1 -= initial
        result std::Option::Some
    }
}

fn select_item value:Item accept:bool -> std::Option[Item] {
    if accept then
        value std::Option::Some return
    fi
    std::Option::None
}

fn iterator values:$std::List[Item] -> std::Iter[$Item] { values.iter }

fn test_independent_capture_states {
    "calls preserve separate capture states" test::test_start
    2 counter = first
    7 counter = second
    "first invocation" 2 first next_value.unwrap test::assert_eq
    "second environment" 7 second next_value.unwrap test::assert_eq
    "first environment resumes" 1 first next_value.unwrap test::assert_eq
    "second environment resumes" 6 second next_value.unwrap test::assert_eq
    "early return ends only this invocation" first next_value.is_none test::assert_true
    "exhausted closure remains repeatable" first next_value.is_none test::assert_true
}

fn test_payload_cleanup drops:ptr {
    "aggregate returns preserve owned cleanup" test::test_start
    unsafe { 0 drops store64 }
    true Item { value: 1 drops: drops } select_item match
        std::Option::Some(value) => {
            value drop
        }
        std::Option::None => {
        }
    end
    false Item { value: 2 drops: drops } select_item match
        std::Option::Some(value) => {
            value drop
        }
        std::Option::None => {
        }
    end
    true Item { value: 3 drops: drops } select_item drop
    "transferred, rejected and unconsumed payloads drop once in order" 123 unsafe { drops load64 } test::assert_eq
}

fn test_retained_shared_yields drops:ptr {
    "returned iterator yields outlive cursor storage" test::test_start
    unsafe { 0 drops store64 }
    [Item { value: 4 drops: drops }, Item { value: 5 drops: drops }] std::List::from_array = values
    values iterator = cursor
    cursor.next.unwrap = first
    cursor.next.unwrap = second
    cursor drop
    "first yield remains live" 4 first.value test::assert_eq
    "second yield remains live" 5 second.value test::assert_eq
    "cursor owns no elements" 0 unsafe { drops load64 } test::assert_eq
    values drop
    "list destroys its elements in reverse order" 54 unsafe { drops load64 } test::assert_eq
}

pub fn run_tests {
    test_independent_capture_states
    unsafe { 8 alloc = drops }
    drops test_payload_cleanup
    drops test_retained_shared_yields
    unsafe { drops free }
    test::test_summary
}
run_tests
