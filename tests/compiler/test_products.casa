import "std" as std
import "../../compiler/products.casa" as products
import "../../compiler/build.casa" as build
import "../../compiler/document.casa" as document
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../lib/os.casa" as os

fn make_input source:$str -> products::CompilationInput {
    "/tmp/casa_products".to_str source.to_str "main.casa".to_str products::SourceUnit
    products::CompilationInput::new
}

fn make_override_input value:$str -> products::CompilationInput {
    "import \"dependency\" as dependency\ndependency::value print" make_input = input
    f"pub fn value -> i64 \{ {value} \}" "lib/dependency.casa".to_str input.source_overrides.set
    "lib".to_str input.library_paths.push
    "unused".to_str "unused.casa".to_str input.source_overrides.set
    input
}

fn test_override_identity {
    "override_identity" test::test_start
    "42" make_override_input = input
    "pub fn value -> i64 { 42 }".to_str "./lib/dependency.casa".to_str input.source_overrides.set
    "ignored root override".to_str "./main.casa".to_str input.source_overrides.set
    input products::analyze.unwrap = snapshot
    "identical override aliases coalesce" snapshot
        .get_report
        .get_diagnostics
        .has_errors ! test::assert_true
    "42" make_override_input = conflict
    "pub fn value -> i64 { 7 }".to_str "./lib/dependency.casa".to_str conflict.source_overrides.set
    conflict products::analyze match
        std::Result::Error(failure) => {
            "input conflict" products::CompilerPhase::Input failure.get_phase test::assert_eq
            "first alias attributed" failure.get_message.as_str "lib/dependency.casa" str::contains test::assert_true
            "second alias attributed" failure.get_message.as_str "./lib/dependency.casa" str::contains test::assert_true
        }
        std::Result::Ok(unexpected) => "conflicting aliases rejected" false test::assert_true
    end
}

fn test_independent_requests {
    "independent_requests" test::test_start
    "41" make_override_input products::analyze.unwrap = first
    "42" make_override_input products::analyze.unwrap = second
    "first accepted" first
        .get_report
        .get_diagnostics
        .has_errors ! test::assert_true
    "second accepted" second
        .get_report
        .get_diagnostics
        .has_errors ! test::assert_true
    "first override" "pub fn value -> i64 { 41 }" "/tmp/casa_products/lib/dependency.casa"
    first
        .get_report
        .get_sources
        .get
        .unwrap test::assert_str_eq
    first drop
    "second survives first release" "pub fn value -> i64 { 42 }" "/tmp/casa_products/lib/dependency.casa"
    second
        .get_report
        .get_sources
        .get
        .unwrap test::assert_str_eq
    "unused override released" "/tmp/casa_products/unused.casa"
    second
        .get_report
        .get_sources
        .get
        .is_none test::assert_true
    "editor facts retained" 0 second.get_semantic_tokens.length > test::assert_true
}

fn test_rejected_source {
    "rejected_source" test::test_start
    products::Target::LinuxX86_64 "\"bad\" 1 *" make_input products::assembly.unwrap = result
    result match
        products::AssemblyResult::Rejected(report) => {
            "source error" report.get_diagnostics.has_errors test::assert_true
            "exact rejected text" "\"bad\" 1 *" "/tmp/casa_products/main.casa"
            report
                .get_sources
                .get
                .unwrap test::assert_str_eq
        }
        products::AssemblyResult::Produced(unexpected_report unexpected_source) => "rejection has no assembly" false test::assert_true
    end
}

fn test_complete_prefix_facts_do_not_enable_assembly {
    "complete_prefix_facts_do_not_enable_assembly" test::test_start
    for
        suffix in [
            "fn broken { fn escaped -> i64 { 99 }",
            "fn broken { \"unterminated",
            "const answer",
            "global answer",
        ].iter
    do
        "fn answer -> i64 { 42 } " = prefix
        prefix suffix str::concat = source
        source.as_str make_input products::analyze.unwrap = snapshot
        "source error retained" snapshot
            .get_report
            .get_diagnostics
            .has_errors test::assert_true
        "complete declaration facts retained" 0 snapshot.get_semantic_tokens.length > test::assert_true
        prefix.length = damaged_start
        for token in snapshot.get_semantic_tokens.iter do
            if
                token.kind document::DocumentTokenKind::Function == token.kind document::DocumentTokenKind::Variable == ||
            then
                "damaged declaration publishes no symbol facts" damaged_start token.location.offset < test::assert_true
            fi
        done
        products::Target::LinuxX86_64 source.as_str make_input products::assembly.unwrap match
            products::AssemblyResult::Rejected(report) => "source error rejects assembly" report.get_diagnostics.has_errors test::assert_true
            products::AssemblyResult::Produced(unexpected_report unexpected_source) => "partial facts cannot produce assembly" false test::assert_true
        end
    done
}

fn test_internal_module_names_are_not_source_bindings {
    "internal_module_names_are_not_source_bindings" test::test_start
    for
        body in [
            "__casa_module_0__answer drop",
            "__casa_module_1__answer drop",
            "__casa_std__answer drop",
            "fn invalid value:__casa_module_0__Secret { value drop }",
            "fn invalid value:__casa_std__Secret { value drop }",
        ].iter
    do
        f"import \"dependency.casa\" as dependency import \"std.casa\" as standard {body}".as_str make_input = input
        "import \"child.casa\" as child pub fn answer -> i64 { 41 } struct Secret { }".to_str "dependency.casa".to_str input.source_overrides.set
        "pub fn answer -> i64 { 42 }".to_str "child.casa".to_str input.source_overrides.set
        "pub fn answer -> i64 { 43 } struct Secret { }".to_str "std.casa".to_str input.source_overrides.set
        products::Target::LinuxX86_64 input products::assembly.unwrap match
            products::AssemblyResult::Rejected(report) => "internal identity is not a source binding" report.get_diagnostics.has_errors test::assert_true
            products::AssemblyResult::Produced(unexpected_report unexpected_source) => "internal identity access must fail" false test::assert_true
        end
    done
}

fn test_import_rejection_report {
    "import_rejection_report" test::test_start
    "import \"dependency\" as dependency\nmissing_root" make_input = input
    "missing_import".to_str "dependency.casa".to_str input.source_overrides.set
    products::Target::LinuxX86_64 input products::assembly.unwrap = result
    "import error retained" result
        .get_report
        .get_diagnostics
        .has_errors test::assert_true
    "exact imported rejection" "missing_import" "/tmp/casa_products/dependency.casa"
    result
        .get_report
        .get_sources
        .get
        .unwrap test::assert_str_eq
    "first diagnostic is imported" "/tmp/casa_products/dependency.casa"
    0 result
        .get_report
        .get_diagnostics
        .entries
        .get
        .get_location
        .file test::assert_str_eq
    "root source retained" "import \"dependency\" as dependency\nmissing_root"
    "/tmp/casa_products/main.casa" result
        .get_report
        .get_sources
        .get
        .unwrap test::assert_str_eq
}

fn test_syntax_product {
    "syntax_product" test::test_start
    "# comment\nimport \"missing\" as missing\n42 print\n".to_str
    "syntax.casa".to_str products::SourceUnit products::syntax.unwrap = valid
    "root syntax ignores missing import" valid.get_facts.is_some test::assert_true
    "lossless tokens" 0 valid.get_tokens.length > test::assert_true
    "fn broken {".to_str "syntax.casa".to_str products::SourceUnit products::syntax.unwrap = rejected
    "rejected syntax has no facts" rejected.get_facts.is_none test::assert_true
    "syntax diagnostics" rejected
        .get_report
        .get_diagnostics
        .has_errors test::assert_true
    "syntax rejection keeps source" "fn broken {" "syntax.casa"
    rejected
        .get_report
        .get_sources
        .get
        .unwrap test::assert_str_eq
}

fn test_invalid_utf8_report {
    "invalid_utf8_report" test::test_start
    std::Bytes::new = bytes
    255 bytes.push
    bytes "/tmp/casa_products_invalid.casa".as_cstr.unwrap file::write_all.unwrap drop
    products::Target::LinuxX86_64
    "import \"/tmp/casa_products_invalid.casa\" as invalid" make_input
    products::assembly.unwrap = result
    "/tmp/casa_products_invalid.casa".as_cstr.unwrap file::remove.unwrap drop
    "invalid UTF-8 rejected" result
        .get_report
        .get_diagnostics
        .has_errors test::assert_true
    "/tmp/casa_products_invalid.casa" result
        .get_report
        .get_sources
        .get_bytes
        .unwrap = retained
    "exact rejected bytes" bytes retained == test::assert_true
    "no invented UTF-8 text" "/tmp/casa_products_invalid.casa"
    result
        .get_report
        .get_sources
        .get
        .is_none test::assert_true
}

fn test_failed_request_report {
    "failed_request_report" test::test_start
    "42 print" make_input = input
    "relative".to_str = input.base_directory
    products::Target::LinuxX86_64 input products::assembly match
        std::Result::Error(failure) => {
            "failure phase" products::CompilerPhase::Input failure.get_phase == test::assert_true
            "failure retains source" "42 print" "main.casa"
            failure
                .get_report
                .get_sources
                .get
                .unwrap test::assert_str_eq
        }
        std::Result::Ok(_) => "relative base fails" false test::assert_true
    end
}

fn test_assembly_product {
    "assembly_product" test::test_start
    products::Target::LinuxX86_64 "42" make_override_input products::assembly.unwrap match
        products::AssemblyResult::Produced(report source) => {
            "assembly target" products::Target::LinuxX86_64 source.get_target == test::assert_true
            "assembly entry" source.get_text.as_str "_start:" str::contains test::assert_true
            "assembly keeps used source" "/tmp/casa_products/lib/dependency.casa"
            report
                .get_sources
                .get
                .is_some test::assert_true
            std::List[std::String]::new false "/tmp/casa_products_test"
            source.get_text.as_str build::compile_binary
            std::List[std::Bytes]::new = run
            "/bin/sh" run.push_str
            "-c" run.push_str
            "test \"$(/tmp/casa_products_test)\" = 42" run.push_str
            "native output is 42" 0 run std::run_command test::assert_eq
            "/tmp/casa_products_test".as_cstr.unwrap file::remove.unwrap drop
        }
        products::AssemblyResult::Rejected(_) => "scalar source accepted" false test::assert_true
    end
}

fn test_scalar_checked_facts {
    "scalar_checked_facts" test::test_start
    "fn need value:i64 -> i64 { value } fn broken { true need drop } fn healthy -> i64 { 41 } healthy print"
    = source
    source make_input products::analyze.unwrap = snapshot
    "bad scalar input rejected" snapshot
        .get_report
        .get_diagnostics
        .has_errors test::assert_true
    source "true need" str::find u64::try_from.unwrap 5 + = failed_offset
    source "drop }" str::find u64::try_from.unwrap = dependent_offset
    source "healthy print" str::find u64::try_from.unwrap = independent_offset
    false = found_independent
    for token in snapshot.get_semantic_tokens.iter do
        "failed call has no verified token" failed_offset token.location.offset != test::assert_true
        if dependent_offset token.location.offset == then
            "dependent operation retains only lexical category" token.kind document::DocumentTokenKind::Macro == test::assert_true
        fi
        if independent_offset token.location.offset == then
            true = found_independent
        fi
    done
    "independent function call retained" found_independent test::assert_true
    "dependent operation has no verified hover"
    dependent_offset "/tmp/casa_products/main.casa" snapshot.get_index.find_hover document::PointAnswer::Known is ! test::assert_true
    products::Target::LinuxX86_64 source make_input products::assembly.unwrap match
        products::AssemblyResult::Rejected(report) => "source diagnostic retained" report.get_diagnostics.has_errors test::assert_true
        products::AssemblyResult::Produced(_) => "failed decision cannot produce assembly" false test::assert_true
    end
}

fn test_resolver_rejections_have_no_facts {
    "resolver_rejections_have_no_facts" test::test_start
    for
        source in [
            "const VALUE 42\n1 = VALUE",
            "const VALUE 42\n1 += VALUE",
            "const VALUE 42\n1 -= VALUE",
        ].iter
    do
        source make_input products::analyze.unwrap = snapshot
        "resolver error retained" snapshot
            .get_report
            .get_diagnostics
            .has_errors test::assert_true
        source.length 5 - = rejected_offset
        for token in snapshot.get_semantic_tokens.iter do
            "rejected assignment is not verified" rejected_offset token.location.offset != test::assert_true
        done
        products::Target::LinuxX86_64 source make_input products::assembly.unwrap match
            products::AssemblyResult::Rejected(_) => {
            }
            products::AssemblyResult::Produced(_) => "resolver rejection cannot produce assembly" false test::assert_true
        end
    done
}

fn test_rejected_function_has_no_caller_facts {
    "rejected_function_has_no_caller_facts" test::test_start
    for
        source in [
            "const VALUE 42\nfn broken -> i64 { 1 = VALUE }\nbroken print",
            "const VALUE 42\nfn broken -> i64 { 1 = VALUE }\n&broken exec print",
        ].iter
    do
        source make_input products::analyze.unwrap = snapshot
        "resolver error retained" snapshot
            .get_report
            .get_diagnostics
            .has_errors test::assert_true
        source "}\n" str::find u64::try_from.unwrap 2 + = caller_offset
        for token in snapshot.get_semantic_tokens.iter do
            if token.kind document::DocumentTokenKind::Function == then
                "rejected callee cannot verify caller facts" caller_offset token.location.offset < test::assert_true
            fi
        done
    done
}

fn test_deferred_rejections_have_no_facts {
    "deferred_rejections_have_no_facts" test::test_start
    for
        source in [
            "fn need x:u8 { x drop } 256 need",
            "fn bad { good true 1 + drop } fn good { bad } if true then bad else good fi",
            "[256] = values:array[u8 1] values drop",
        ].iter
    do
        source make_input products::analyze.unwrap = snapshot
        "deferred source error retained" snapshot
            .get_report
            .get_diagnostics
            .has_errors test::assert_true
        for token in snapshot.get_semantic_tokens.iter do
            source token.location.offset source.length token.location.offset - str::substring = remaining
            if source "[" str::starts_with then
                source "[" str::find u64::try_from.unwrap = nested_offset
                "nested rejected literal has no semantic hover"
                nested_offset 1 + "/tmp/casa_products/main.casa" snapshot.get_index.find_hover document::PointAnswer::Known is ! test::assert_true
            fi
            if remaining.as_str "256 need" == then
                "invalid literal has no semantic hover"
                token.location.offset "/tmp/casa_products/main.casa" snapshot.get_index.find_hover document::PointAnswer::Known is ! test::assert_true
            fi
            "invalid literal consumer is not verified" remaining.as_str "need" != test::assert_true
            "recursive rejected call is not verified" remaining.as_str "bad } if true then bad else good fi" != test::assert_true
            "recursive dependent is not verified" remaining.as_str "good fi" != test::assert_true
        done
    done
}

fn test_scalar_independent_regions {
    "scalar_independent_regions" test::test_start
    for
        source in [
            "fn good -> i64 { 41 } fn need x:i64 { x drop } fn broken flag:bool { if flag then true need else good drop fi }",
            "fn good -> i64 { 41 } fn broken -> bool { good drop }",
            "fn good -> i64 { 41 } fn need x:u8 { x drop } fn broken flag:bool { if flag then 256 need else good drop fi }",
        ].iter
    do
        source make_input products::analyze.unwrap = snapshot
        "rejected body reported" snapshot
            .get_report
            .get_diagnostics
            .has_errors test::assert_true
        source "good drop" str::find u64::try_from.unwrap = independent_offset
        false = found_independent
        for token in snapshot.get_semantic_tokens.iter do
            if independent_offset token.location.offset == then
                true = found_independent
            fi
        done
        "verified independent call retained" found_independent test::assert_true
    done
}

fn test_constant_failure_keeps_independent_facts {
    "constant_failure_keeps_independent_facts" test::test_start
    "const BAD { 1 0 / }\nfn good -> i64 { 41 }\ngood print" = source
    source make_input products::analyze.unwrap = snapshot
    "constant error reported" snapshot
        .get_report
        .get_diagnostics
        .has_errors test::assert_true
    source "good print" str::find u64::try_from.unwrap = independent_offset
    false = found_independent
    for token in snapshot.get_semantic_tokens.iter do
        if independent_offset token.location.offset == then
            true = found_independent
        fi
    done
    "verified call retained" found_independent test::assert_true
    products::Target::LinuxX86_64 source make_input products::assembly.unwrap match
        products::AssemblyResult::Rejected(report) => "failed constant rejects assembly" report.get_diagnostics.has_errors test::assert_true
        products::AssemblyResult::Produced(_) => "failed constant rejects assembly" false test::assert_true
    end
}

fn test_private_failed_import_report {
    "private_failed_import_report" test::test_start
    "import \"dependency.casa\" as dep\nconst NEXT { dep::BAD 1 + }" make_input = input
    "const BAD { 1 0 / }".to_str "dependency.casa".to_str input.source_overrides.set
    input products::analyze.unwrap = snapshot
    false = found_source_error
    false = found_private_error
    for
        diagnostic in snapshot
            .get_report
            .get_diagnostics
            .entries
            .iter
    do
        if diagnostic error::Diagnostic::Error(source_error) is then
            if source_error.message.as_str "1 0 /" str::contains then
                true = found_source_error
            fi
            if source_error.message.as_str "private" str::contains then
                true = found_private_error
            fi
        fi
    done
    "imported source error retained" found_source_error test::assert_true
    "private access error retained" found_private_error test::assert_true
    "imported error is first" "/tmp/casa_products/dependency.casa"
    0 snapshot
        .get_report
        .get_diagnostics
        .entries
        .get
        .get_location
        .file test::assert_str_eq
    "privacy error follows" "/tmp/casa_products/main.casa"
    1 snapshot
        .get_report
        .get_diagnostics
        .entries
        .get
        .get_location
        .file test::assert_str_eq
}

fn test_scalar_branch_execution {
    "scalar_branch_execution" test::test_start
    "fn subtract right:i64 left:i64 -> i64 { left right - } impl i64 { fn twice self:i64 -> i64 { self 2 * } } fn choose flag:bool -> i64 { if flag then 20 3 subtract .twice else 4 fi 8 + } true choose print false choose print"
    make_input products::Target::LinuxX86_64 swap products::assembly.unwrap match
        products::AssemblyResult::Produced(report source) => {
            "scalar branch accepted" report.get_diagnostics.has_errors ! test::assert_true
            std::List[std::String]::new false "/tmp/casa_scalar_branch_test"
            source.get_text.as_str build::compile_binary
            std::List[std::Bytes]::new = run
            "/bin/sh" run.push_str
            "-c" run.push_str
            "test \"$(/tmp/casa_scalar_branch_test)\" = 4212" run.push_str
            "both continuing branches execute" 0 run std::run_command test::assert_eq
            "/tmp/casa_scalar_branch_test".as_cstr.unwrap file::remove.unwrap drop
        }
        products::AssemblyResult::Rejected(_) => "scalar branch accepted" false test::assert_true
    end
}
test_scalar_checked_facts
test_resolver_rejections_have_no_facts
test_rejected_function_has_no_caller_facts
test_deferred_rejections_have_no_facts
test_scalar_independent_regions
test_constant_failure_keeps_independent_facts
test_private_failed_import_report
test_scalar_branch_execution
test_independent_requests
test_rejected_source
test_complete_prefix_facts_do_not_enable_assembly
test_internal_module_names_are_not_source_bindings
test_import_rejection_report
test_syntax_product
test_invalid_utf8_report
test_failed_request_report
test_assembly_product
test_override_identity
test::test_summary
