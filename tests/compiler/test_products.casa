fn test_control_flow_execution {
    "control_flow_execution" test::test_start
    "struct Owner { value: i64 } impl Owner { fn drop self:mut$Owner { self.value print } } fn pick flag:bool -> Owner { flag match true => { 11 Owner = chosen chosen } false => { 12 Owner = chosen chosen return } end } fn inferred { if true then 5 return else 6 return fi } fn inferred_owner { 13 Owner = result result return } fn read item:$Owner { item.value print } fn borrow input:$i64 -> $i64 { input } fn make input:$i64 -> fn[-> $i64] { move { input borrow } } fn reader item:$Owner -> fn[-> i64] { { item.value } } fn recursive_reader a:$Owner b:$Owner flag:bool -> fn[-> i64] { if flag then false a b recursive_reader return fi move { a.value } } fn choose input:$Owner count:i64 -> $Owner { if 0 count == then input return fi count 1 - input choose } 0 while 3 over < do 1 + done print true pick drop false pick drop 0 = count while 3 count < do count 1 + Owner = local 1 += count count match 1 => continue 2 => { 9 Owner = inner break } _ => { } end done while 7 Owner = probe false do done 41 Owner = owner owner reader = callback callback exec print callback exec print callback drop 2 owner choose.value print owner drop 1 Owner = first 2 Owner = second true second first recursive_reader = callback2 callback2 exec print callback2 drop second drop first drop 0 = iteration while 2 iteration < do iteration 1 + Owner read 1 += iteration done 99 print inferred print inferred_owner drop true = flag { if flag then 7 return else 8 return fi } exec print { if flag then 42 return fi 1 = tiny:u8 tiny } exec print 1 = value value make exec copy print 0 = condition_count 1 Owner while drop 2 Owner = condition_owner condition_owner 1 condition_count < do condition_owner read 1 += condition_count done drop struct Ref { value:$i64 } fn contents input:$i64 -> fn[-> $i64] { input Ref = wrapped move { wrapped.value } } fn contents_branch input:$i64 -> fn[-> $i64] { input Ref = wrapped move { if true then 1 drop fi wrapped.value } } fn contents_loop input:$i64 -> fn[-> $i64] { input Ref = wrapped move { while false do done wrapped.value } } 42 = external external contents = direct direct exec = a direct drop a copy print external contents_branch = branched branched exec = b branched drop b copy print external contents_loop = looped looped exec = c looped drop c copy print"
    make_input products::Target::LinuxX86_64 swap products::assembly.unwrap match
        products::AssemblyResult::Produced(report source) => {
            "valid control flow accepted" report.get_diagnostics.has_errors ! test::assert_true
            false std::List[std::String]::new "/tmp/casa_control_flow_test"
            source build::NativeDriver::new.compile_binary.unwrap drop
            std::List[std::Bytes]::new = run
            "/bin/sh" run.push_str
            "-c" run.push_str
            "test \"$(/tmp/casa_control_flow_test)\" = 3111219274141414122111229951374211222424242" run.push_str
            "loop exits, match transfers, and borrowed callbacks execute" 0 run std::run_command test::assert_eq
            "/tmp/casa_control_flow_test".as_cstr.unwrap file::remove.unwrap drop
        }
        products::AssemblyResult::Rejected(_) => "valid control flow accepted" false test::assert_true
    end
}

fn test_target_extern_rejection {
    "target extern rejection" test::test_start
    for
        fields in [
            "values:array[u64 2305843009213693952]",
            "first:array[u8 18446744073709551615] second:u8",
            "first:array[u8 18446744073709551615] second:u64",
            "first:u64 second:array[u8 18446744073709551607]",
        ].iter
    do
        f"pub extern struct Huge \{ {fields} \}\npub extern fn make -> Huge" = dependency
        "import \"native\" as native\nunsafe { native::make drop }" = root
        root make_input = analysis_input
        dependency.clone "native.casa".to_str analysis_input.source_overrides.set
        analysis_input products::analyze.unwrap = snapshot
        "analysis needs no target layout" snapshot
            .get_report
            .get_diagnostics
            .has_errors ! test::assert_true
        "analysis retains editor facts" 0 snapshot.get_semantic_tokens.length > test::assert_true

        root make_input = assembly_input
        dependency.clone "native.casa".to_str assembly_input.source_overrides.set
        products::Target::LinuxX86_64 assembly_input products::assembly.unwrap match
            products::AssemblyResult::Rejected(report) => {
                "one target diagnostic" 1 report.count_diagnostics test::assert_eq
                0 report.get_presentation = diagnostic
                "target restriction" diagnostic.message.as_str "Linux x86-64 ABI layout" str::contains test::assert_true
                0 report
                    .get_diagnostics
                    .entries
                    .get
                    .get_location = location
                "imported declaration location" "/tmp/casa_products/native.casa" location.file.as_str test::assert_str_eq
                "declaration source retained" dependency.as_str location.file.as_str report
                    .get_sources
                    .get
                    .unwrap test::assert_str_eq
                "root source retained" root "/tmp/casa_products/main.casa" report
                    .get_sources
                    .get
                    .unwrap test::assert_str_eq
            }
            products::AssemblyResult::Produced(unexpected_report unexpected_source) => "target rejection publishes no assembly" false test::assert_true
        end
    done
}

fn make_declaration_input -> products::CompilationInput {
    "import \"types\" as peer\nstruct Holder { pub values:array[u8 COUNT] next:Later }\nstruct Later { number:i64 }\nenum Choice[T] { Empty Value(T) }\ntrait Child: peer::Base { fn twice self:$self -> i64 { self.value self.value + } }\nimpl Later: Child { fn value self:$Later -> i64 { self.number } }\nconst COUNT 2\n3 Later = item item.twice print\n7 = tag:u8 peer::Native { tag: tag value: 8 } = native native.value print\n1 = first:u8 2 = second:u8 Holder { values: [first, second] next: 9 Later } = holder holder.next.number print\n10 Choice::Value = choice choice match Choice::Value(number) => number print Choice::Empty => {} end\nsize_of[peer::Native] print"
    make_input = input
    "pub extern struct Native { pub tag:u8 pub value:i64 } pub trait Base { fn value self:$self -> i64 }".to_str
    "types.casa".to_str input.source_overrides.set
    input
}

fn test_parsed_declaration_products {
    "parsed_declaration_products" test::test_start
    make_declaration_input products::analyze.unwrap = snapshot
    "declarations accepted in analysis" snapshot
        .get_report
        .get_diagnostics
        .has_errors ! test::assert_true
    products::Target::LinuxX86_64 make_declaration_input products::assembly.unwrap match
        products::AssemblyResult::Produced(report source) => {
            "declarations accepted in assembly" report.get_diagnostics.has_errors ! test::assert_true
            false std::List[std::String]::new "/tmp/casa_parsed_declarations_test"
            source build::NativeDriver::new.compile_binary.unwrap drop
            std::List[std::Bytes]::new = run
            "/bin/sh" run.push_str
            "-c" run.push_str
            "test \"$(/tmp/casa_parsed_declarations_test)\" = 6891016" run.push_str
            "fields, defaults, variants, and extern layout execute" 0 run std::run_command test::assert_eq
            "/tmp/casa_parsed_declarations_test".as_cstr.unwrap file::remove.unwrap drop
        }
        products::AssemblyResult::Rejected(_) => "declarations accepted in assembly" false test::assert_true
    end
}

fn assert_declaration_diagnostics report:$products::Report expected:$std::List[str] {
    "declaration diagnostic count" expected.length report.count_diagnostics test::assert_eq
    for message in expected.iter.enumerate do
        message.first u64::try_from.unwrap report.get_presentation = diagnostic
        "declaration diagnostic encounter order" message.second diagnostic.message.as_str test::assert_str_eq
    done
}

fn assert_declaration_rejected source:$str expected:$std::List[str] {
    source make_input products::analyze.unwrap = snapshot
    expected snapshot.get_report assert_declaration_diagnostics
    products::Target::LinuxX86_64 source make_input products::assembly.unwrap match
        products::AssemblyResult::Rejected(report) => expected report assert_declaration_diagnostics
        products::AssemblyResult::Produced(_) => "invalid declaration rejects assembly" false test::assert_true
    end
}

fn test_parsed_declaration_diagnostics {
    "parsed_declaration_diagnostics" test::test_start
    [
        "Trait `Missing` is not defined",
        "Constant `BAD` cannot be a type argument: only integer, bool, and char values are allowed",
    ] std::List::from_array = bound_errors
    bound_errors "const BAD 1.0 enum Example[T: Missing[BAD]] { Value }" assert_declaration_rejected
    ["Unexpected token in trait method parameter list"] std::List::from_array = parameter_errors
    for
        source in [
            "trait Example { fn method 1 }",
            "trait Example { fn method true }",
            "trait Example { fn method 'x' }",
        ].iter
    do
        parameter_errors source assert_declaration_rejected
    done
    ["Expected type parameter identifier in trait"] std::List::from_array = trait_parameter_errors
    for
        source in [
            "trait Example[const A:u64, B] {}",
            "trait Example[A # name\n:Missing, B] {}",
        ].iter
    do
        trait_parameter_errors source assert_declaration_rejected
        source make_input products::analyze.unwrap = snapshot
        0 snapshot
            .get_report
            .get_diagnostics
            .entries
            .get
            .get_location = location
        if source "const" str::contains then
            source "const" str::find
        else
            source ":" str::find
        fi u64::try_from.unwrap = offset
        "first unsupported generic token" offset location.span.offset test::assert_eq
    done
    [
        "Expected type parameter identifier in trait method",
    ] std::List::from_array = method_parameter_errors
    method_parameter_errors "trait Example { fn method[const A:u64, B] }" assert_declaration_rejected
    method_parameter_errors "trait Example { fn method[A:Missing, B] }" assert_declaration_rejected
    ["Expected type name"] std::List::from_array = separator_errors
    separator_errors "struct Example { value:array[,] }" assert_declaration_rejected
    [
        "Constant `BAD` cannot be a type argument: only integer, bool, and char values are allowed",
        "Expected type name",
        "Expected type name",
    ] std::List::from_array = type_errors
    for
        source in [
            "const BAD 1.0 struct Example { value:array[BAD,1,2] }",
            "const BAD 1.0 enum Example { Value(array[BAD,1,2]) }",
            "const BAD 1.0 trait Example { fn method value:array[BAD,1,2] }",
        ].iter
    do
        type_errors source assert_declaration_rejected
    done
}
