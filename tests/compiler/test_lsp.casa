# ============================================================================
# Test: compute_semantic_tokens
# ============================================================================

fn collect_document_token_kinds tokens:$List[DocumentToken] -> List[DocumentTokenKind] {
    List[DocumentTokenKind]::new = kinds
    for token in tokens.iter do
        token.kind kinds.push
    done
    kinds
}

fn has_document_token_kind kinds:$List[DocumentTokenKind] target:DocumentTokenKind -> bool {
    for kind in kinds.iter do
        if kind target == then true return fi
    done
    false
}

fn count_document_token_kind kinds:$List[DocumentTokenKind] target:DocumentTokenKind -> i64 {
    0 = count
    for kind in kinds.iter do
        if kind target == then 1 += count fi
    done
    count
}

fn test_compute_semantic_tokens_adapts_query_tokens {
    "compute_semantic_tokens_adapts_query_tokens" test_start
    "42 print" lsp_test_state = state
    state compute_semantic_tokens = tokens
    "first is number" TOKEN_NUMBER 0 tokens.get.token_type assert_eq
    "second is macro" TOKEN_MACRO 1 tokens.get.token_type assert_eq
}

