pub fn test_compute_rename_groups_multi_file_references {
    "compute_rename_groups_multi_file_references" test::test_start
    "/tmp/lsp_rename_peer.casa" = peer_path
    "pub fn shared { 0 print }\nshared" = peer_source
    lsp_empty_documents peer_source peer_path lsp::compile_document.into_parts = peer_diagnostics = peer
    peer_diagnostics drop
    std::Map[std::String document::AnalyzedDocument]::new = open_documents
    peer peer_path.to_str open_documents.set
    open_documents f"import \"{peer_path}\" as peer\npeer::shared".as_str LSP_TEST_FILE lsp::compile_document.into_parts
    = state_diagnostics = state
    state_diagnostics drop
    "renamed" 6 1 state lsp::compute_rename = edits
    if edits std::Option::Some(edit_map) is then
        "has root edits" lsp_test_uri edit_map.has test::assert_true
        "has peer edits" peer_path lsp::path_to_uri edit_map.has test::assert_true
    else
        "is some" false test::assert_true
    fi
}

# ============================================================================
# Test: compute_semantic_tokens
# ============================================================================

pub fn collect_document_token_kinds
    tokens:$std::List[document::DocumentToken]
-> std::List[document::DocumentTokenKind] {
    std::List[document::DocumentTokenKind]::new = kinds
    for token in tokens.iter do
        token.kind copy kinds.push
    done
    kinds
}

pub fn has_document_token_kind
    kinds:$std::List[document::DocumentTokenKind]
    target:document::DocumentTokenKind
-> bool {
    for kind in kinds.iter do
        if kind target == then
            true return
        fi
    done
    false
}

pub fn count_document_token_kind
    kinds:$std::List[document::DocumentTokenKind]
    target:document::DocumentTokenKind
-> i64 {
    0 = count
    for kind in kinds.iter do
        if kind target == then
            1 += count
        fi
    done
    count
}

pub fn test_compute_semantic_tokens_adapts_query_tokens {
    "compute_semantic_tokens_adapts_query_tokens" test::test_start
    "42 print" lsp_test_state = state
    state lsp::compute_semantic_tokens = tokens
    "first is number" lsp::TOKEN_NUMBER 0 tokens.get.token_type test::assert_eq
    "second is macro" lsp::TOKEN_MACRO 1 tokens.get.token_type test::assert_eq
}

pub fn test_analyzed_document_semantic_tokens_classify_int_literal {
    "analyzed_document_semantic_tokens_classify_int_literal" test::test_start
    "42 print" lsp_test_state = state
    state.find_semantic_tokens = tokens
    "first is number" 0 tokens.get.kind document::DocumentTokenKind::Number == test::assert_true
}

pub fn test_analyzed_document_semantic_tokens_classify_operations {
    "analyzed_document_semantic_tokens_classify_operations" test::test_start
    "1 2 + print\n\"text\" print" lsp_test_state.find_semantic_tokens collect_document_token_kinds = kinds
    "has number" document::DocumentTokenKind::Number kinds has_document_token_kind test::assert_true
    "has string" document::DocumentTokenKind::String kinds has_document_token_kind test::assert_true
    "has operator" document::DocumentTokenKind::Operator kinds has_document_token_kind test::assert_true
    "has macro" document::DocumentTokenKind::Macro kinds has_document_token_kind test::assert_true
}

pub fn test_analyzed_document_semantic_tokens_classify_function_and_keyword {
    "analyzed_document_semantic_tokens_classify_function_and_keyword" test::test_start
    "fn greet { 42 print }\ngreet" lsp_test_state.find_semantic_tokens collect_document_token_kinds = kinds
    "has function" document::DocumentTokenKind::Function kinds has_document_token_kind test::assert_true
    "has keyword" document::DocumentTokenKind::Keyword kinds has_document_token_kind test::assert_true
    "has function literal" document::DocumentTokenKind::Number kinds has_document_token_kind test::assert_true
    "has function intrinsic" document::DocumentTokenKind::Macro kinds has_document_token_kind test::assert_true
}

pub fn test_analyzed_document_semantic_tokens_classify_declarations {
    "analyzed_document_semantic_tokens_classify_declarations" test::test_start
    "enum Color { Red }\nstruct Point {\n    x: i64\n}" lsp_test_state.find_semantic_tokens = tokens
    tokens collect_document_token_kinds = kinds
    "first is enum keyword" document::DocumentTokenKind::Keyword 0 tokens.get.kind == test::assert_true
    "enum keyword offset" 0 0 tokens
        .get
        .location
        .offset test::assert_eq
    "has type" document::DocumentTokenKind::Type kinds has_document_token_kind test::assert_true
    "has struct" document::DocumentTokenKind::Struct kinds has_document_token_kind test::assert_true
}

pub fn test_analyzed_document_semantic_tokens_split_qualified_name {
    "analyzed_document_semantic_tokens_split_qualified_name" test::test_start
    "enum Color { Red }\nColor::Red print" lsp_test_state.find_semantic_tokens = tokens
    false = found_type
    false = found_member
    for token in tokens.iter do
        if token.location.offset 19 == token.kind document::DocumentTokenKind::Type == && then
            "type length" 5 token.location.length test::assert_eq
            true = found_type
        fi
        if token.location.offset 26 == token.kind document::DocumentTokenKind::EnumMember == && then
            "member length" 3 token.location.length test::assert_eq
            true = found_member
        fi
    done
    "found qualified type" found_type test::assert_true
    "found qualified member" found_member test::assert_true
}

pub fn test_analyzed_document_semantic_tokens_filter_imported_sources {
    "analyzed_document_semantic_tokens_filter_imported_sources" test::test_start
    "/tmp/lsp_semantic_dependency.casa" = dependency_path
    f"import \"{dependency_path}\" as dependency_module\ndependency_module::dependency" = source
    source.clone LSP_TEST_FILE.to_str analysis::AnalysisInput::new = input
    "pub fn dependency { 1 print }".to_str dependency_path.to_str input.source_overrides.set
    input analysis::analyze = analysis
    LSP_TEST_FILE.to_str source analysis document::AnalyzedDocument::new.find_semantic_tokens = tokens
    "has root call" 0 tokens.length > test::assert_true
    for token in tokens.iter do
        "root token" LSP_TEST_FILE token.location.file test::assert_str_eq
    done
}

pub fn test_analyzed_document_semantic_tokens_skip_internal_declarations {
    "analyzed_document_semantic_tokens_skip_internal_declarations" test::test_start
    "fn apply func:fn[i64 -> i64] x:i64 -> i64 { x func exec }\n{ 2 * } 5 apply print"
