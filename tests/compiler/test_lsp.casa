    "/tmp/lsp_semantic_dependency.casa" = dependency_path
    f"import \"{dependency_path}\"\ndependency" = source
    source.clone LSP_TEST_FILE AnalysisInput::new = input
    "fn dependency { 1 print }" dependency_path input.source_overrides.set = input.source_overrides
    input analyze = analysis
    LSP_TEST_FILE source analysis AnalyzedDocument::new.find_semantic_tokens = tokens
    "has root call" 0 tokens.length > assert_true
    for token in tokens.iter do
        "root token" LSP_TEST_FILE token.location.file assert_str_eq
    done
}

fn test_analyzed_document_semantic_tokens_skip_internal_declarations {
    "analyzed_document_semantic_tokens_skip_internal_declarations" test_start
    "fn apply func:fn[i64 -> i64] x:i64 -> i64 { x func exec }\n{ 2 * } 5 apply print"
