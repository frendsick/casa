import "std" as std
import "../../compiler/analysis.casa" as analysis
import "../../compiler/document.casa" as document
import "../../lib/io.casa" as io
import "../../lib/json.casa" as json
import "../../compiler/common.casa" as common
import "../../compiler/lexer.casa" as lexer
import "../../lsp.casa" as lsp
import "../../lib/test.casa" as test

pub const LSP_TEST_FILE "/tmp/lsp_test.casa"

pub fn lsp_empty_documents -> std::Map[std::String document::AnalyzedDocument] {
    std::Map[std::String document::AnalyzedDocument]::new
}

pub fn lsp_test_state source:$str -> document::AnalyzedDocument {
    lsp_empty_documents source LSP_TEST_FILE lsp::compile_document.into_parts = diagnostics = document
    diagnostics drop
    document
}

pub fn lsp_test_uri -> std::String { LSP_TEST_FILE lsp::path_to_uri }

pub fn test_lsp_state_reclaims_reader_buffer {
    "lsp_state_reclaims_reader_buffer" test::test_start
    lsp::LspState::new = state
    unsafe { state
        .reader
        .buffer
        .data } = reader_buffer
    state drop
    unsafe { io::IO_BUFFER_SIZE alloc = reused_buffer }
    "reader buffer is released with state" reader_buffer reused_buffer == test::assert_true
    unsafe { reused_buffer free }
}

pub fn make_lsp_range source:$str offset:u64 length:u64 -> lsp::LspRange {
    lexer::SourceStore::new = sources
    source LSP_TEST_FILE sources.add
    length offset LSP_TEST_FILE.to_str common::Location::new sources lsp::convert_location_to_lsp_range
}

# ============================================================================
# Test: LSP range conversion
# ============================================================================

pub fn test_lsp_range_single_line_start {
    "lsp_range_single_line_start" test::test_start
    5 0 "hello world" make_lsp_range = range
    "start_line" 0 range lsp::LspRange::start_line test::assert_eq
    "start_col" 0 range lsp::LspRange::start_col test::assert_eq
    "end_line" 0 range lsp::LspRange::end_line test::assert_eq
    "end_col" 5 range lsp::LspRange::end_col test::assert_eq
}

pub fn test_lsp_range_multiline_second_line {
    "lsp_range_multiline_second_line" test::test_start
    6 6 "first\nsecond" make_lsp_range = range
    "start_line" 1 range lsp::LspRange::start_line test::assert_eq
    "start_col" 0 range lsp::LspRange::start_col test::assert_eq
    "end_line" 1 range lsp::LspRange::end_line test::assert_eq
    "end_col" 6 range lsp::LspRange::end_col test::assert_eq
}

pub fn test_lsp_range_zero_length_uses_minimum_of_one {
    "lsp_range_zero_length_uses_minimum_of_one" test::test_start
    0 1 "abc" make_lsp_range = range
    "start_line" 0 range lsp::LspRange::start_line test::assert_eq
    "start_col" 1 range lsp::LspRange::start_col test::assert_eq
    "end_line" 0 range lsp::LspRange::end_line test::assert_eq
    "end_col" 2 range lsp::LspRange::end_col test::assert_eq
}

pub fn test_lsp_range_mid_line_offset {
    "lsp_range_mid_line_offset" test::test_start
    5 6 "hello world" make_lsp_range = range
    "start_line" 0 range lsp::LspRange::start_line test::assert_eq
    "start_col" 6 range lsp::LspRange::start_col test::assert_eq
    "end_line" 0 range lsp::LspRange::end_line test::assert_eq
    "end_col" 11 range lsp::LspRange::end_col test::assert_eq
}

# ============================================================================
# Test: extract_library_paths
# ============================================================================

pub fn lsp_make_library_paths_message path_values:std::List[json::JsonValue] -> json::JsonValue {
    json::json_object
    "libraryPaths".to_str path_values json::JsonValue::JsonArray json::json_set
    json::JsonValue::JsonObject = init_options_value
    json::json_object
    "initializationOptions".to_str init_options_value json::json_set
    json::JsonValue::JsonObject = params_value
    json::json_object
    "params".to_str params_value json::json_set
    json::JsonValue::JsonObject
}

pub fn test_extract_library_paths_returns_string_entries {
    "extract_library_paths_returns_string_entries" test::test_start
    std::List[json::JsonValue]::new = path_values
    "/abs/lib1".to_str json::JsonValue::JsonString path_values.push
    "/abs/lib2".to_str json::JsonValue::JsonString path_values.push
    path_values lsp_make_library_paths_message lsp::extract_library_paths = result
    "length 2" 2 result.length test::assert_eq
    "first path" "/abs/lib1" 0 result.get test::assert_str_eq
    "second path" "/abs/lib2" 1 result.get test::assert_str_eq
}

pub fn test_extract_library_paths_empty_when_params_missing {
    "extract_library_paths_empty_when_params_missing" test::test_start
    json::json_object json::JsonValue::JsonObject lsp::extract_library_paths = result
    "empty" 0 result.length test::assert_eq
}

pub fn test_extract_library_paths_empty_when_init_options_missing {
    "extract_library_paths_empty_when_init_options_missing" test::test_start
    json::json_object
    "params".to_str json::json_object json::JsonValue::JsonObject json::json_set
    json::JsonValue::JsonObject lsp::extract_library_paths = result
    "empty" 0 result.length test::assert_eq
}

pub fn test_extract_library_paths_skips_non_string_entries {
    "extract_library_paths_skips_non_string_entries" test::test_start
    std::List[json::JsonValue]::new = path_values
    "/keep".to_str json::JsonValue::JsonString path_values.push
    42 json::JsonValue::JsonInt path_values.push
    "/also_keep".to_str json::JsonValue::JsonString path_values.push
    path_values lsp_make_library_paths_message lsp::extract_library_paths = result
    "length 2" 2 result.length test::assert_eq
    "first kept" "/keep" 0 result.get test::assert_str_eq
    "second kept" "/also_keep" 1 result.get test::assert_str_eq
}

pub fn test_compile_document_unresolved_module_does_not_crash {
    "compile_document_unresolved_module_does_not_crash" test::test_start
    lsp_empty_documents "import \"this_module_does_not_exist\"\n42 print" LSP_TEST_FILE lsp::compile_document.into_parts
    = diagnostics = state
    "failed import has no ops" 0 state.ops.length test::assert_eq
    "has errors" 0 diagnostics.length > test::assert_true
}

# ============================================================================
# Test: ingest_document
# ============================================================================

pub fn test_ingest_document_valid_code_produces_no_diagnostics {
    "ingest_document_valid_code_produces_no_diagnostics" test::test_start
    lsp_empty_documents "42 print" lsp_test_uri.as_str lsp::ingest_document_into = documents = diagnostics
    documents drop
    "no diagnostics" 0 diagnostics.length test::assert_eq
}

pub fn test_ingest_document_invalid_code_produces_error_diagnostics {
    "ingest_document_invalid_code_produces_error_diagnostics" test::test_start
    lsp_empty_documents "42 \"hello\" +" lsp_test_uri.as_str lsp::ingest_document_into = documents = diagnostics
    documents drop
    "has diagnostics" 0 diagnostics.length > test::assert_true
    "first is error severity" lsp::DIAGNOSTIC_ERROR 0 diagnostics.get lsp::LspDiagnostic::severity test::assert_eq
}

pub fn test_ingest_document_returns_updated_open_documents {
    "ingest_document_returns_updated_open_documents" test::test_start
    lsp_empty_documents "42 print" lsp_test_uri.as_str lsp::ingest_document_into = documents = diagnostics
    diagnostics drop
    "uri stored" lsp_test_uri documents.has test::assert_true
    lsp_test_uri documents.get.unwrap = state
    "source matches" "42 print" state.source test::assert_str_eq
}

pub fn test_ingest_document_mutates_server_state {
    "ingest_document_mutates_server_state" test::test_start
    lsp::LspState::new = state
    state "42 print" lsp_test_uri.as_str lsp::ingest_document = diagnostics
    "no diagnostics" 0 diagnostics.length test::assert_eq
    "uri stored" lsp_test_uri state.open_documents.has test::assert_true
}

pub fn test_ingest_document_replaces_previous_state {
    "ingest_document_replaces_previous_state" test::test_start
    lsp::LspState::new = state
    state "42 print" lsp_test_uri.as_str lsp::ingest_document drop
    state "fn latest { 1 print }" lsp_test_uri.as_str lsp::ingest_document = diagnostics
    "replacement has no diagnostics" 0 diagnostics.length test::assert_eq
    "one document retained" 1 state.open_documents.length test::assert_eq
    "latest source retained" "fn latest { 1 print }" lsp_test_uri state
        .open_documents
        .get
        .unwrap
        .source test::assert_str_eq
}

# ============================================================================
# Test: compile_document
# ============================================================================

pub fn test_compile_document_returns_document {
    "compile_document_returns_document" test::test_start
    "fn greet { 42 print }\ngreet" lsp_test_state = state
    "valid document has ops" 0 state.ops.length > test::assert_true
    "has greet function" "greet" state.functions.has_str test::assert_true
    "source matches" "fn greet { 42 print }\ngreet" state.source test::assert_str_eq
    "file_path matches" LSP_TEST_FILE state.file_path test::assert_str_eq
}

pub fn test_compile_document_partial_failure_still_returns_ops {
    "compile_document_partial_failure_still_returns_ops" test::test_start
    lsp_empty_documents "42 print \"hello\" 1 *" LSP_TEST_FILE lsp::compile_document.into_parts
    = diagnostics = state
    "partial failure has ops" 0 state.ops.length > test::assert_true
    "partial failure has diagnostics" 0 diagnostics.length > test::assert_true
    "completed op remains resolved" 1 state
        .ops
        .get
        .value common::OpValue::PrintInt is test::assert_true
    "source matches" "42 print \"hello\" 1 *" state.source test::assert_str_eq
}

pub fn test_compile_document_ambiguous_parse_skips_later_phases {
    "compile_document_ambiguous_parse_skips_later_phases" test::test_start
    "fn broken { 42 \"hello\" +" lsp_test_state = state
    "has no ops" 0 state.ops.length test::assert_eq
}

pub fn test_compile_document_populates_structs {
    "compile_document_populates_structs" test::test_start
    "struct Point {\n    x: i64\n    y: i64\n}" lsp_test_state = state
    "has Point struct" "Point" state.structs.has_str test::assert_true
}

pub fn test_compile_document_populates_enums {
    "compile_document_populates_enums" test::test_start
    "enum Color { Red Green Blue }" lsp_test_state = state
    "has Color enum" "Color" state.enums.has_str test::assert_true
}

pub fn test_compile_document_drains_errors_into_result {
    "compile_document_drains_errors_into_result" test::test_start
    lsp_empty_documents "42 \"hello\" +" LSP_TEST_FILE lsp::compile_document = result
    "result has errors" 0 result.diagnostics.length > test::assert_true
}

pub fn test_compile_document_two_calls_isolated {
    "compile_document_two_calls_isolated" test::test_start
    lsp_empty_documents "42 \"hello\" +" LSP_TEST_FILE lsp::compile_document = first_result
    "first has errors" 0 first_result.diagnostics.length > test::assert_true
    lsp_empty_documents "42 print" LSP_TEST_FILE lsp::compile_document = second_result
    "second has no errors" 0 second_result.diagnostics.length test::assert_eq
    "first result still has errors after second call" 0 first_result.diagnostics.length > test::assert_true
}

pub fn test_compile_document_source_store_keyed_by_file_path {
    "compile_document_source_store_keyed_by_file_path" test::test_start
    "42 print" = main_source
    lsp_empty_documents main_source LSP_TEST_FILE lsp::compile_document = result
    "main source matches" main_source LSP_TEST_FILE result
        .document
        .sources
        .get
        .unwrap test::assert_str_eq
}

pub fn test_compile_document_seeds_open_docs_into_source_store {
    "compile_document_seeds_open_docs_into_source_store" test::test_start
    "/tmp/lsp_peer.casa" = peer_path
    "fn peer_helper { 0 print }" = peer_source
    lsp_empty_documents peer_source peer_path lsp::compile_document.into_parts = peer_diagnostics = peer_state
    peer_diagnostics drop
    std::Map[std::String document::AnalyzedDocument]::new = open_docs
    peer_state peer_path.to_str open_docs.set
    open_docs "42 print" LSP_TEST_FILE lsp::compile_document = result
    "peer source matches" peer_source peer_path result
        .document
        .sources
        .get
        .unwrap test::assert_str_eq
}

# ============================================================================
# Test: AnalyzedDocument::find_symbol_at
# ============================================================================

pub fn test_analyzed_document_find_symbol_at_finds_global_op {
    "analyzed_document_find_symbol_at_finds_global_op" test::test_start
    "42 print" lsp_test_state = state
    0 0 lsp::convert_lsp_position state.find_symbol_at = result
    if result std::Option::Some(found) is then
        "kind is push i64" found.op.value common::OpValue::PushInt is test::assert_true
        "no containing function" found.containing_function.is_none test::assert_true
    else
        "is some" false test::assert_true
    fi
}

pub fn test_analyzed_document_find_symbol_at_finds_function_op {
    "analyzed_document_find_symbol_at_finds_function_op" test::test_start
    "fn greet {\n    42 print\n}\ngreet" lsp_test_state = state
    4 1 lsp::convert_lsp_position state.find_symbol_at = result
    if result std::Option::Some(found) is then
        "kind is push i64" found.op.value common::OpValue::PushInt is test::assert_true
        if found.containing_function std::Option::Some(function) is then
            "function is greet" "greet" function.name test::assert_str_eq
        else
            "has containing function" false test::assert_true
        fi
    else
        "is some" false test::assert_true
    fi
}

pub fn test_analyzed_document_find_symbol_at_returns_none_for_empty_position {
    "analyzed_document_find_symbol_at_returns_none_for_empty_position" test::test_start
    "42 print" lsp_test_state = state
    50 0 lsp::convert_lsp_position state.find_symbol_at = result
    "is none" result.is_none test::assert_true
}

