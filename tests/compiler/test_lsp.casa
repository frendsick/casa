# ============================================================================
# Helper: build a synthetic Function with a single self:T parameter
# ============================================================================

fn make_synthetic_method name:str self_type:str ret_type:Type -> Function {
    List::new(List[Parameter]) = params
    self_type parse_type_str Parameter::new params.push
    List::new(List[Type]) = returns
    ret_type returns.push
    returns params StackEffect::new = sig
    sig empty_location List::new(List[Op]) name Function::with_stack_effect
}

fn lsp_make_synthetic_void name:str self_type:str -> Function {
    List::new(List[Parameter]) = params
    self_type parse_type_str Parameter::new params.push
    List::new(List[Type]) = returns
    returns params StackEffect::new = sig
    sig empty_location List::new(List[Op]) name Function::with_stack_effect
}
# Inject int:: synthetic methods into an AnalyzedDocument's functions map.
# Returns a new AnalyzedDocument with the updated functions map.

fn lsp_inject_int_methods state:AnalyzedDocument -> AnalyzedDocument {
    state.functions = fns
    TYPE_INT_T "int" "int::hash" make_synthetic_method "int::hash" fns.set = fns
    TYPE_INT_T "int" "int::eq" make_synthetic_method "int::eq" fns.set = fns
    state.file_path
    state.source
    state.sources
    state.variables
    state.enums
    state.structs
    fns
    state.ops
    AnalyzedDocument
}

