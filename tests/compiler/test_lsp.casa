fn test_compile_document_drains_errors_into_result {
    "compile_document_drains_errors_into_result" test_start
    lsp_empty_documents "42 \"hello\" +" LSP_TEST_FILE compile_document = result
    "result has errors" result.analysis.diagnostics.has_errors assert_true
}

fn test_compile_document_two_calls_isolated {
    "compile_document_two_calls_isolated" test_start
    lsp_empty_documents "42 \"hello\" +" LSP_TEST_FILE compile_document = first_result
    "first has errors" first_result.analysis.diagnostics.has_errors assert_true
    lsp_empty_documents "42 print" LSP_TEST_FILE compile_document = second_result
    "second has no errors" second_result.analysis.diagnostics.has_errors ! assert_true
    "first result still has errors after second call" first_result.analysis.diagnostics.has_errors assert_true
}

fn test_compile_document_source_store_keyed_by_file_path {
    "compile_document_source_store_keyed_by_file_path" test_start
    "42 print" = main_source
    lsp_empty_documents main_source LSP_TEST_FILE compile_document = result
    "main source matches" main_source LSP_TEST_FILE result.analysis.sources.get.unwrap assert_str_eq
}

fn test_compile_document_seeds_open_docs_into_source_store {
    "compile_document_seeds_open_docs_into_source_store" test_start
    "/tmp/lsp_peer.casa" = peer_path
    "fn peer_helper { 0 print }" = peer_source
    lsp_empty_documents peer_source peer_path compile_document.document = peer_state
    Map[str AnalyzedDocument]::new = open_docs
    peer_state peer_path open_docs.set = open_docs
    open_docs "42 print" LSP_TEST_FILE compile_document = result
    "peer source matches" peer_source peer_path result.analysis.sources.get.unwrap assert_str_eq
}

# ============================================================================
# Test: AnalyzedDocument::find_symbol_at
# ============================================================================

fn test_analyzed_document_find_symbol_at_finds_global_op {
    "analyzed_document_find_symbol_at_finds_global_op" test_start
    "42 print" lsp_test_state = state
    0 0 convert_lsp_position state.find_symbol_at = result
    if result Option::Some(found) is then
        "kind is push i64" found.op.value OpValue::PushInt is assert_true
        "no containing function" found.containing_function.is_none assert_true
    else
        "is some" false assert_true
    fi
}

fn test_analyzed_document_find_symbol_at_finds_function_op {
    "analyzed_document_find_symbol_at_finds_function_op" test_start
    "fn greet {\n    42 print\n}\ngreet" lsp_test_state = state
    4 1 convert_lsp_position state.find_symbol_at = result
    if result Option::Some(found) is then
        "kind is push i64" found.op.value OpValue::PushInt is assert_true
        if found.containing_function Option::Some(function) is then
            "function is greet" "greet" function.name assert_str_eq
        else
            "has containing function" false assert_true
        fi
    else
        "is some" false assert_true
    fi
}

fn test_analyzed_document_find_symbol_at_returns_none_for_empty_position {
    "analyzed_document_find_symbol_at_returns_none_for_empty_position" test_start
    "42 print" lsp_test_state = state
    50 0 convert_lsp_position state.find_symbol_at = result
    "is none" result.is_none assert_true
}

