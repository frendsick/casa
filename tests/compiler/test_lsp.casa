pub fn test_compute_completion_excludes_lambda_functions {
    "compute_completion_excludes_lambda_functions" test::test_start
    "fn apply func:fn[i64 -> i64] x:i64 -> i64 {\n    x func exec\n}\n{ 2 * } 5 apply print" lsp_test_state = state
    "" 0 3 state lsp::compute_completion = items
    "has apply" "apply" items lsp_completion_has test::assert_true
    # No lambda__ should appear
    0 = lambda_count
    0 = lambda_index: u64
    while lambda_index items.length > do
        if lambda_index items.get lsp::CompletionItem::label.as_str "lambda__" str::starts_with then
            1 += lambda_count
        fi
        1 += lambda_index
    done
    "no lambda" 0 lambda_count test::assert_eq
}

