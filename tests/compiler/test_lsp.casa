# ============================================================================
# Test: find_variable_definition with reassignment
# ============================================================================

fn test_analyzed_document_definition_returns_last_assignment_before_usage {
    "analyzed_document_definition_returns_last_assignment_before_usage" test_start
    "1 = x\n2 = x\nx print" = source
    source lsp_test_state = state
    0 2 state.find_definition_at = location
    if location Option::Some(definition) is then
        "offset is second assignment" 10 definition.offset assert_eq
    else
        "is some" false assert_true
    fi
}

fn test_analyzed_document_definition_returns_first_assignment_before_reassignment {
    "analyzed_document_definition_returns_first_assignment_before_reassignment" test_start
    "1 = x\nx print\n2 = x" = source
    source lsp_test_state = state
    0 1 state.find_definition_at = location
    if location Option::Some(definition) is then
        "offset is first assignment" 4 definition.offset assert_eq
    else
        "is some" false assert_true
    fi
}

fn test_analyzed_document_definition_finds_reassigned_local_variable {
    "analyzed_document_definition_finds_reassigned_local_variable" test_start
    "fn foo {\n    1 = x\n    2 = x\n    x print\n}\nfoo" = source
    source lsp_test_state = state
    4 3 state.find_definition_at = location
    if location Option::Some(definition) is then
        "offset is second assignment" source "x\n    x print" str::find definition.offset assert_eq
    else
        "is some" false assert_true
    fi
}

