pub fn test_analyzed_document_semantic_tokens_classify_control_flow {
    "analyzed_document_semantic_tokens_classify_control_flow" test::test_start
    "true if 42 then 0 fi print\n0 = i\ni 10 < while i 1 + = i do done"
    lsp_test_state.find_semantic_tokens collect_document_token_kinds = kinds
    "has control-flow keywords" 6 document::DocumentTokenKind::Keyword kinds count_document_token_kind >= test::assert_true
    "has operators" document::DocumentTokenKind::Operator kinds has_document_token_kind test::assert_true
}

