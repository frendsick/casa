    state.find_semantic_tokens = tokens
    "first is number" 0 tokens.get.kind DocumentTokenKind::Number == assert_true
}

fn test_analyzed_document_semantic_tokens_classify_operations {
    "analyzed_document_semantic_tokens_classify_operations" test_start
    "1 2 + print\n\"text\" print" lsp_test_state.find_semantic_tokens collect_document_token_kinds = kinds
    "has number" DocumentTokenKind::Number kinds has_document_token_kind assert_true
    "has string" DocumentTokenKind::String kinds has_document_token_kind assert_true
    "has operator" DocumentTokenKind::Operator kinds has_document_token_kind assert_true
    "has macro" DocumentTokenKind::Macro kinds has_document_token_kind assert_true
}

