pub fn test_analyzed_document_completion_methods_for_generic_type_uses_base {
    "analyzed_document_completion_methods_for_generic_type_uses_base" test::test_start
    "0 print" make_std_test_document = state
    std::List[common::Type]::new = parameters
    common::make_i64_type.clone parameters.push
    parameters "__casa_std__List".to_str common::GenericType common::Type::Generic = list_type
    list_type state.find_methods_for_type = candidates
    "has get" "get" candidates query_completion_has test::assert_true
}

pub fn test_analyzed_document_completion_uses_concrete_generic_methods {
    "analyzed_document_completion_uses_concrete_generic_methods" test::test_start
    "struct Box[T] { value: T }\nimpl[T] Box[T] { fn generic self:Box[T] -> i64 { self drop 0 } }\nimpl Box[i64] { fn specialized self:Box[i64] -> bool { self drop true } }\nfn use box:Box[i64] { box drop }"
    = source
    source.as_str make_std_test_document = state
    std::List[common::Type]::new = parameters
    common::make_i64_type.clone parameters.push
    parameters "Box".to_str common::GenericType common::Type::Generic = box_type
    "exact method indexed" "Box[i64]::specialized" state.lookup_function.is_some test::assert_true
    box_type state.find_methods_for_type = candidates
    "has concrete method" "specialized" candidates query_completion_has test::assert_true
    "has generic method" "generic" candidates query_completion_has test::assert_true

    std::List[std::String]::new = chain
    "box" chain.push_str
    "specialized" chain.push_str
    source.as_str "box drop" str::find u64::try_from.unwrap = offset
    offset chain state.resolve_completion_chain_type = chain_type
    "chain resolves concrete return type" common::make_bool_type chain_type.unwrap.eq test::assert_true

    source.as_str "\nBox[i64]::" str::concat.as_str make_std_test_document = qualified_state
    ":" 10 5 lsp::convert_lsp_position qualified_state.find_completion_candidates
    = qualified_candidates
    "qualified completion has concrete method" "specialized" qualified_candidates query_completion_has
    test::assert_true
}

pub fn test_analyzed_document_completion_enum_variants_after_double_colon {
    "analyzed_document_completion_enum_variants_after_double_colon" test::test_start
    "enum Color { Red Green Blue }\nColor::" make_std_test_document = state
    ":" 7 2 lsp::convert_lsp_position state.find_completion_candidates = candidates
    "has Red" "Red" candidates query_completion_has test::assert_true
    "has Green" "Green" candidates query_completion_has test::assert_true
    "has Blue" "Blue" candidates query_completion_has test::assert_true
}

pub fn test_analyzed_document_completion_methods_after_double_colon {
    "analyzed_document_completion_methods_after_double_colon" test::test_start
    "69 = num\ni64::" make_std_test_document = state
    ":" 5 2 lsp::convert_lsp_position state.find_completion_candidates = candidates
    "has hash" "hash" candidates query_completion_has test::assert_true
}

pub fn test_analyzed_document_completion_single_colon_returns_empty {
    "analyzed_document_completion_single_colon_returns_empty" test::test_start
    "69 = num:" make_std_test_document = state
    ":" 9 1 lsp::convert_lsp_position state.find_completion_candidates = candidates
    "is empty" 0 candidates.length test::assert_eq
}

pub fn test_analyzed_document_completion_chain {
    "analyzed_document_completion_chain" test::test_start
    "69 = test\ntest.hash.eq" make_std_test_document = state
    "." 10 2 lsp::convert_lsp_position state.find_completion_candidates = candidates
    "has hash" "hash" candidates query_completion_has test::assert_true
    "has eq" "eq" candidates query_completion_has test::assert_true
}

pub fn test_analyzed_document_completion_chain_void_method_returns_empty {
    "analyzed_document_completion_chain_void_method_returns_empty" test::test_start
    "std::List[i64]::new = items\nitems.push.get" make_std_test_document = state
    "." 11 2 lsp::convert_lsp_position state.find_completion_candidates = candidates
    "is empty" 0 candidates.length test::assert_eq
}

pub fn test_analyzed_document_completion_chain_missing_method_returns_empty {
    "analyzed_document_completion_chain_missing_method_returns_empty" test::test_start
    "69 = test\ntest.missing.hash" make_std_test_document = state
    "." 13 2 lsp::convert_lsp_position state.find_completion_candidates = candidates
    "is empty" 0 candidates.length test::assert_eq
}

# ============================================================================
# Test: compute_definition for enum variants
# ============================================================================

pub fn test_compute_definition_enum_variant_member {
    "compute_definition_enum_variant_member" test::test_start
    "enum Color { Red Green Blue }\nColor::Blue print" lsp_test_state = state
    7 1 state lsp::compute_definition = result
    "is some" result.is_some test::assert_true
    result.unwrap = location
    "line is 0" 0 location lsp::LspLocation::range lsp::LspRange::start_line test::assert_eq
    "col is 23" 23 location lsp::LspLocation::range lsp::LspRange::start_col test::assert_eq
}

pub fn test_compute_definition_enum_variant_type {
    "compute_definition_enum_variant_type" test::test_start
    "enum Color { Red Green Blue }\nColor::Blue print" lsp_test_state = state
    0 1 state lsp::compute_definition = result
    "is some" result.is_some test::assert_true
    result.unwrap = location
    "line is 0" 0 location lsp::LspLocation::range lsp::LspRange::start_line test::assert_eq
    "col is 5" 5 location lsp::LspLocation::range lsp::LspRange::start_col test::assert_eq
}

