# ============================================================================
# Test: compute_references
# ============================================================================

impl document::DocumentSymbol {
    pub fn assert_has_distinct_owner
        self:$document::DocumentSymbol
        other:$document::DocumentSymbol
    {
        if self.owner std::Option::Some(self_owner) is then
            if other.owner std::Option::Some(other_owner) is then
                "different owners" self_owner.name other_owner.name != test::assert_true
            else
                "other owner is some" false test::assert_true
            fi
        else
            "owner is some" false test::assert_true
        fi
    }
}

pub fn assert_document_reference_count
    references:std::Option[std::List[document::DocumentLocation]]
    expected:u64
    message:$str
{
    if references std::Option::Some(locations) is then
        message expected locations.length test::assert_eq
    else
        message false test::assert_true
    fi
}

pub fn test_analyzed_document_symbol_identity_separates_local_owners {
    "analyzed_document_symbol_identity_separates_local_owners" test::test_start
    "fn first {\n    1 = value\n    value print\n}\nfn second {\n    2 = value\n    value print\n}" lsp_test_state = state
    4 2 lsp::convert_lsp_position state.find_symbol_identity_at = first_symbol
    4 6 lsp::convert_lsp_position state.find_symbol_identity_at = second_symbol
    if first_symbol std::Option::Some(first) is then
        if second_symbol std::Option::Some(second) is then
            "same spelling" first.name second.name test::assert_str_eq
            second first.assert_has_distinct_owner
        else
            "second is some" false test::assert_true
        fi
    else
        "first is some" false test::assert_true
    fi
}

