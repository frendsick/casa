    "analyzed_document_semantic_tokens_classify_function_and_keyword" test_start
    "fn greet { 42 print }\ngreet" lsp_test_state.find_semantic_tokens collect_document_token_kinds = kinds
    "has function" DocumentTokenKind::Function kinds has_document_token_kind assert_true
    "has keyword" DocumentTokenKind::Keyword kinds has_document_token_kind assert_true
    "has function literal" DocumentTokenKind::Number kinds has_document_token_kind assert_true
    "has function intrinsic" DocumentTokenKind::Macro kinds has_document_token_kind assert_true
}

fn test_analyzed_document_semantic_tokens_classify_declarations {
    "analyzed_document_semantic_tokens_classify_declarations" test_start
    "enum Color { Red }\nstruct Point {\n    x: i64\n}" lsp_test_state.find_semantic_tokens = tokens
    tokens collect_document_token_kinds = kinds
    "first is enum keyword" DocumentTokenKind::Keyword 0 tokens.get.kind == assert_true
    "enum keyword offset" 0 0 tokens.get.location.offset assert_eq
    "has type" DocumentTokenKind::Type kinds has_document_token_kind assert_true
    "has struct" DocumentTokenKind::Struct kinds has_document_token_kind assert_true
}

fn test_analyzed_document_semantic_tokens_split_qualified_name {
    "analyzed_document_semantic_tokens_split_qualified_name" test_start
    "enum Color { Red }\nColor::Red print" lsp_test_state.find_semantic_tokens = tokens
    false = found_type
    false = found_member
    for token in tokens.iter do
        if token.location.offset 19 == token.kind DocumentTokenKind::Type == && then
            "type length" 5 token.location.length assert_eq
            true = found_type
        fi
        if token.location.offset 26 == token.kind DocumentTokenKind::EnumMember == && then
            "member length" 3 token.location.length assert_eq
            true = found_member
        fi
    done
    "found qualified type" found_type assert_true
    "found qualified member" found_member assert_true
}

