    4 2 convert_lsp_position state.find_symbol_identity_at = first_symbol
    4 6 convert_lsp_position state.find_symbol_identity_at = second_symbol
    if first_symbol Option::Some(first) is then
        if second_symbol Option::Some(second) is then
            "same spelling" first.name second.name assert_str_eq
            second first.assert_has_distinct_owner
        else
            "second is some" false assert_true
        fi
    else
        "first is some" false assert_true
    fi
}

