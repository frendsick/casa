# ============================================================================
# Test: compute_references
# ============================================================================

impl DocumentSymbol {
    fn assert_has_distinct_owner self:$DocumentSymbol other:$DocumentSymbol {
        if self.owner Option::Some(self_owner) is then
            if other.owner Option::Some(other_owner) is then
                "different owners" self_owner.name other_owner.name != assert_true
            else
                "other owner is some" false assert_true
            fi
        else
            "owner is some" false assert_true
        fi
    }
}

fn assert_document_reference_count
    references:Option[List[DocumentLocation]]
    expected:u64
    message:$str
{
    if references Option::Some(locations) is then
        message expected locations.length assert_eq
    else
        message false assert_true
    fi
}

fn test_analyzed_document_symbol_identity_separates_local_owners {
    "analyzed_document_symbol_identity_separates_local_owners" test_start
