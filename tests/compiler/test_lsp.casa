# ============================================================================
# Helper: search the items list for a label
# ============================================================================

pub fn lsp_completion_has items:$std::List[lsp::CompletionItem] label:$str -> bool {
    0 = index: u64
    while index items.length > do
        if index items.get lsp::CompletionItem::label label == then
            true return
        fi
        1 += index
    done
    false
}

pub fn lsp_completion_first_kind items:$std::List[lsp::CompletionItem] label:$str -> i64 {
    0 = index: u64
    while index items.length > do
        index items.get = item
        if item lsp::CompletionItem::label label == then
            item lsp::CompletionItem::kind return
        fi
        1 += index
    done
    0 1 -
}

pub fn query_completion_has candidates:$std::List[document::CompletionCandidate] name:$str -> bool {
    for candidate in candidates.iter do
        if candidate lsp::format_completion_candidate.label name == then
            true return
        fi
    done
    false
}

