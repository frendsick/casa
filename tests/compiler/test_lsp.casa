# ============================================================================

pub fn test_convert_document_hover_to_lsp_adds_markdown_and_range {
    "convert_document_hover_to_lsp_adds_markdown_and_range" test::test_start
    lexer::SourceStore::new = sources
    "abcde" LSP_TEST_FILE sources.add
    3 2 LSP_TEST_FILE.to_str document::DocumentLocation = location
    location "value: i64".to_str document::DocumentHover sources lsp::convert_document_hover_to_lsp = hover
    "content" "```casa\nvalue: i64\n```" hover.content test::assert_str_eq
    "start line" 0 hover.range.start_line test::assert_eq
    "start column" 2 hover.range.start_col test::assert_eq
    "end line" 0 hover.range.end_line test::assert_eq
    "end column" 5 hover.range.end_col test::assert_eq
}

# ============================================================================
# Test: compute_completion
# ============================================================================

pub fn test_compute_completion_includes_functions {
