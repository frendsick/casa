fn test_compute_completion_includes_keywords {
    "compute_completion_includes_keywords" test_start
    "42 print" lsp_test_state = state
    "" 0 0 state compute_completion = items
    "has fn" "fn" items lsp_completion_has assert_true
    "has if" "if" items lsp_completion_has assert_true
    "has while" "while" items lsp_completion_has assert_true
    "has for" "for" items lsp_completion_has assert_true
    "has in" "in" items lsp_completion_has assert_true
    "has global" "global" items lsp_completion_has assert_true
    "has const" "const" items lsp_completion_has assert_true
}

fn test_compute_completion_includes_intrinsics {
    "compute_completion_includes_intrinsics" test_start
    "42 print" lsp_test_state = state
    "" 0 0 state compute_completion = items
    "has print" "print" items lsp_completion_has assert_true
    "has drop" "drop" items lsp_completion_has assert_true
    "has dup" "dup" items lsp_completion_has assert_true
    "has envp" "envp" items lsp_completion_has assert_true
    "has no placeholder" "unknown" items lsp_completion_has ! assert_true
}

fn test_compute_completion_excludes_lambda_functions {
    "compute_completion_excludes_lambda_functions" test_start
    "fn apply func:fn[i64 -> i64] x:i64 -> i64 {\n    x func exec\n}\n{ 2 * } 5 apply print" lsp_test_state = state
    "" 0 3 state compute_completion = items
    "has apply" "apply" items lsp_completion_has assert_true
    # No lambda__ should appear
    0 = lambda_count
    0 (u64) = lambda_index
    while lambda_index items.length > do
        if lambda_index items.get CompletionItem::label "lambda__" str::starts_with then
            1 += lambda_count
        fi
        1 += lambda_index
    done
    "no lambda" 0 lambda_count assert_eq
}

