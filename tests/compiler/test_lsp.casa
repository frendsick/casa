# ============================================================================
# Test: find_variable_definition with reassignment
# ============================================================================

pub fn test_analyzed_document_definition_returns_last_assignment_before_usage {
    "analyzed_document_definition_returns_last_assignment_before_usage" test::test_start
    "1 = x\n2 = x\nx print" = source
    source lsp_test_state = state
    0 2 lsp::convert_lsp_position state.find_definition_at = location
    if location std::Option::Some(definition) is then
        "offset is second assignment" 10 definition.offset test::assert_eq
    else
        "is some" false test::assert_true
    fi
}

pub fn test_analyzed_document_definition_returns_first_assignment_before_reassignment {
    "analyzed_document_definition_returns_first_assignment_before_reassignment" test::test_start
    "1 = x\nx print\n2 = x" = source
    source lsp_test_state = state
    0 1 lsp::convert_lsp_position state.find_definition_at = location
    if location std::Option::Some(definition) is then
        "offset is first assignment" 4 definition.offset test::assert_eq
    else
        "is some" false test::assert_true
    fi
}

pub fn test_analyzed_document_definition_finds_reassigned_local_variable {
    "analyzed_document_definition_finds_reassigned_local_variable" test::test_start
    "fn foo {\n    1 = x\n    2 = x\n    x print\n}\nfoo" = source
    source lsp_test_state = state
    4 3 lsp::convert_lsp_position state.find_definition_at = location
    if location std::Option::Some(definition) is then
        "offset is second assignment" source "x\n    x print" str::find u64::try_from.unwrap definition.offset test::assert_eq
    else
        "is some" false test::assert_true
    fi
}

