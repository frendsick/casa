pub fn make_std_test_document source:$str -> document::AnalyzedDocument {
    f"import \"std\"\n{source}" = full_source
    full_source.clone LSP_TEST_FILE.to_str analysis::AnalysisInput::new = input
    "lib".to_str input.library_paths.push
    input analysis::analyze = analysis
    LSP_TEST_FILE.to_str full_source.to_str analysis document::AnalyzedDocument::new
}

