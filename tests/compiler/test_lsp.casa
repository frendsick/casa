    4 1 lsp::convert_lsp_position LSP_TEST_FILE state
        .sources
        .convert_position_to_offset
        .unwrap = offset
    offset state.find_containing_function = func
    if func std::Option::Some(function) is then
        "function is greet" "greet" function.name test::assert_str_eq
