    if edits std::Option::Some(edit_map) is then
        lsp_test_uri edit_map.get.unwrap = document_edits
        0 document_edits.get lsp::TextEdit::range = assignment_range: $lsp::LspRange
        "assignment start line" 0 assignment_range lsp::LspRange::start_line test::assert_eq
        "assignment starts at name" 5 assignment_range lsp::LspRange::start_col test::assert_eq
