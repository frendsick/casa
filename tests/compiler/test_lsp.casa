# ============================================================================
# Test: extract_library_paths
# ============================================================================

fn lsp_make_library_paths_message path_values:List[JsonValue] -> JsonValue {
    json_object
    "libraryPaths" path_values JsonValue::JsonArray json_set
    JsonValue::JsonObject = init_options_value
    json_object
    "initializationOptions" init_options_value json_set
    JsonValue::JsonObject = params_value
    json_object
    "params" params_value json_set
    JsonValue::JsonObject
}

fn test_extract_library_paths_returns_string_entries {
    "extract_library_paths_returns_string_entries" test_start
    List::new(List[JsonValue]) = path_values
    "/abs/lib1" JsonValue::JsonString path_values.push
    "/abs/lib2" JsonValue::JsonString path_values.push
    path_values lsp_make_library_paths_message extract_library_paths = result
    "length 2" 2 result.length assert_eq
    "first path" "/abs/lib1" 0 result.get assert_str_eq
    "second path" "/abs/lib2" 1 result.get assert_str_eq
}

fn test_extract_library_paths_empty_when_params_missing {
    "extract_library_paths_empty_when_params_missing" test_start
    json_object JsonValue::JsonObject extract_library_paths = result
    "empty" 0 result.length assert_eq
}

fn test_extract_library_paths_empty_when_init_options_missing {
    "extract_library_paths_empty_when_init_options_missing" test_start
    json_object
    "params" json_object JsonValue::JsonObject json_set
    JsonValue::JsonObject extract_library_paths = result
    "empty" 0 result.length assert_eq
}

fn test_extract_library_paths_skips_non_string_entries {
    "extract_library_paths_skips_non_string_entries" test_start
    List::new(List[JsonValue]) = path_values
    "/keep" JsonValue::JsonString path_values.push
    42 JsonValue::JsonInt path_values.push
    "/also_keep" JsonValue::JsonString path_values.push
    path_values lsp_make_library_paths_message extract_library_paths = result
    "length 2" 2 result.length assert_eq
    "first kept" "/keep" 0 result.get assert_str_eq
    "second kept" "/also_keep" 1 result.get assert_str_eq
}

fn test_compile_document_unresolved_module_does_not_crash {
    global LSP_LIBRARY_PATHS
    "compile_document_unresolved_module_does_not_crash" test_start
    List::new(List[str]) = LSP_LIBRARY_PATHS
    lsp_empty_documents "import \"this_module_does_not_exist\"\n42 print" LSP_TEST_FILE compile_document = result
    result.document = state
    "failed import has no ops" 0 state.ops.length assert_eq
    "has errors" result.analysis.diagnostics.has_errors assert_true
}

# ============================================================================
# Test: ingest_document
# ============================================================================

fn test_ingest_document_valid_code_produces_no_diagnostics {
    "ingest_document_valid_code_produces_no_diagnostics" test_start
    lsp_empty_documents "42 print" lsp_test_uri ingest_document_into = documents = diagnostics
    documents drop
    "no diagnostics" 0 diagnostics.length assert_eq
}

fn test_ingest_document_invalid_code_produces_error_diagnostics {
    "ingest_document_invalid_code_produces_error_diagnostics" test_start
    lsp_empty_documents "42 \"hello\" +" lsp_test_uri ingest_document_into = documents = diagnostics
    documents drop
    "has diagnostics" 0 diagnostics.length > assert_true
    "first is error severity" DIAGNOSTIC_ERROR 0 diagnostics.get LspDiagnostic::severity assert_eq
}

fn test_ingest_document_returns_updated_open_documents {
    "ingest_document_returns_updated_open_documents" test_start
    lsp_empty_documents "42 print" lsp_test_uri ingest_document_into = documents = diagnostics
    diagnostics drop
    "uri stored" lsp_test_uri documents.has assert_true
    lsp_test_uri documents.get.unwrap = state
    "source matches" "42 print" state.source assert_str_eq
}

# ============================================================================
# Test: compile_document
# ============================================================================

fn test_compile_document_returns_document {
    "compile_document_returns_document" test_start
    "fn greet { 42 print }\ngreet" lsp_test_state = state
    "valid document has ops" 0 state.ops.length > assert_true
    "has greet function" "greet" state.functions.has assert_true
    "source matches" "fn greet { 42 print }\ngreet" state.source assert_str_eq
    "file_path matches" LSP_TEST_FILE state.file_path assert_str_eq
}

fn test_compile_document_partial_failure_still_returns_ops {
    "compile_document_partial_failure_still_returns_ops" test_start
    lsp_empty_documents "42 print \"hello\" 1 *" LSP_TEST_FILE compile_document = result
    result.document = state
    "partial failure has ops" 0 state.ops.length > assert_true
    "partial failure has diagnostics" result.analysis.diagnostics.has_errors assert_true
    "completed op remains resolved" 1 state.ops.get.value OpValue::PrintInt is assert_true
    "source matches" "42 print \"hello\" 1 *" state.source assert_str_eq
}

fn test_compile_document_ambiguous_parse_skips_later_phases {
    "compile_document_ambiguous_parse_skips_later_phases" test_start
    "fn broken { 42 \"hello\" +" lsp_test_state = state
    "has no ops" 0 state.ops.length assert_eq
}

fn test_compile_document_populates_structs {
    "compile_document_populates_structs" test_start
    "struct Point {\n    x: int\n    y: int\n}" lsp_test_state = state
    "has Point struct" "Point" state.structs.has assert_true
}

fn test_compile_document_populates_enums {
    "compile_document_populates_enums" test_start
    "enum Color { Red Green Blue }" lsp_test_state = state
    "has Color enum" "Color" state.enums.has assert_true
}

fn test_compile_document_drains_errors_into_result {
    "compile_document_drains_errors_into_result" test_start
    lsp_empty_documents "42 \"hello\" +" LSP_TEST_FILE compile_document = result
    "result has errors" result.analysis.diagnostics.has_errors assert_true
}

fn test_compile_document_two_calls_isolated {
    "compile_document_two_calls_isolated" test_start
    lsp_empty_documents "42 \"hello\" +" LSP_TEST_FILE compile_document = first_result
    "first has errors" first_result.analysis.diagnostics.has_errors assert_true
    lsp_empty_documents "42 print" LSP_TEST_FILE compile_document = second_result
    "second has no errors" second_result.analysis.diagnostics.has_errors ! assert_true
    "first result still has errors after second call" first_result.analysis.diagnostics.has_errors assert_true
}

fn test_compile_document_source_store_keyed_by_file_path {
    "compile_document_source_store_keyed_by_file_path" test_start
    "42 print" = main_source
    lsp_empty_documents main_source LSP_TEST_FILE compile_document = result
    result.analysis.sources.sources = source_map
    "main file retained" LSP_TEST_FILE source_map.has assert_true
    "main source matches" main_source LSP_TEST_FILE source_map.get.unwrap assert_str_eq
}

fn test_compile_document_seeds_open_docs_into_source_store {
    "compile_document_seeds_open_docs_into_source_store" test_start
    "/tmp/lsp_peer.casa" = peer_path
    "fn peer_helper { 0 print }" = peer_source
    List::new(List[Op]) = peer_ops
    Map::new(Map[str Function]) = peer_fns
    Map::new(Map[str CasaStruct]) = peer_structs
    Map::new(Map[str CasaEnum]) = peer_enums
    Map::new(Map[str Variable]) = peer_vars
    peer_path peer_source SourceStore::new peer_vars peer_enums peer_structs peer_fns peer_ops AnalyzedDocument = peer_state
    Map::new(Map[str AnalyzedDocument]) = open_docs
    peer_state peer_path open_docs.set = open_docs
    open_docs "42 print" LSP_TEST_FILE compile_document = result
    result.analysis.sources.sources = source_map
    "peer retained by path" peer_path source_map.has assert_true
    "peer source matches" peer_source peer_path source_map.get.unwrap assert_str_eq
}

# ============================================================================
# Test: AnalyzedDocument::find_symbol_at
# ============================================================================

fn test_analyzed_document_find_symbol_at_finds_global_op {
    "analyzed_document_find_symbol_at_finds_global_op" test_start
    "42 print" lsp_test_state = state
    0 0 state.find_symbol_at = result
    if result Option::Some(found) is then
        "kind is push int" found.op.value OpValue::PushInt is assert_true
        "no containing function" found.containing_function.is_none assert_true
    else
        "is some" false assert_true
    fi
}

fn test_analyzed_document_find_symbol_at_finds_function_op {
    "analyzed_document_find_symbol_at_finds_function_op" test_start
    "fn greet {\n    42 print\n}\ngreet" lsp_test_state = state
    4 1 state.find_symbol_at = result
    if result Option::Some(found) is then
        "kind is push int" found.op.value OpValue::PushInt is assert_true
        if found.containing_function Option::Some(function) is then
            "function is greet" "greet" function.name assert_str_eq
        else
            "has containing function" false assert_true
        fi
    else
        "is some" false assert_true
    fi
}

fn test_analyzed_document_find_symbol_at_returns_none_for_empty_position {
    "analyzed_document_find_symbol_at_returns_none_for_empty_position" test_start
    "42 print" lsp_test_state = state
    50 0 state.find_symbol_at = result
    "is none" result.is_none assert_true
}

