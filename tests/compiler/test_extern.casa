import "std" as std
import "../../compiler/analysis.casa" as analysis
import "../../compiler/bytecode.casa" as bytecode
import "../../compiler/common.casa" as common
import "../../compiler/emitter.casa" as emitter
import "../../compiler/error.casa" as error
import "../../compiler/typechecker.casa" as typechecker
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

pub const COPY_TRAITS "trait __casa_std__Clone { fn clone self:$self -> self } trait __casa_std__Copy: __casa_std__Clone { } "

pub fn assert_contains needle:$str haystack:$std::String message:$str {
    message haystack.as_str needle str::find 0 <= test::assert_true
}

pub fn typecheck_extern_source
    code:$str
    parse_diagnostics:mut$error::Diagnostics
-> typechecker::TypecheckResult {
    parse_diagnostics code helpers::typecheck_test_source
}

pub fn test_extern_declaration_and_call_lowering {
    "extern_declaration_and_call_lowering" test::test_start
    error::Diagnostics::new = parse_diagnostics
    parse_diagnostics
    "extern fn abs value:i32 -> i32\nunsafe { -7 = value:i32 value abs drop }"
    typecheck_extern_source = result
    parse_diagnostics "extern syntax" helpers::assert_no_errors
    result.diagnostics "extern call typechecks" helpers::assert_no_errors

    "abs" result
        .store
        .get_function
        .unwrap = function
    "extern is unsafe" function.is_unsafe test::assert_true
    "extern symbol" "abs" function
        .extern_symbol
        .clone
        .unwrap
        .as_str test::assert_str_eq

    result bytecode::compile_typechecked.unwrap = program
    false = found_call
    for instruction in program.bytecode.iter do
        if instruction common::InstValue::ExternCall(call) is then
            "bytecode symbol" "abs" call.symbol.as_str test::assert_str_eq
            true = found_call
        fi
    done
    "extern bytecode" found_call test::assert_true

    program emitter::emit = assembly
    "first integer argument" assembly "movq 0(%r13), %rdi" assert_contains
    "C symbol call" assembly "call abs" assert_contains
    "i32 return extension" assembly "movslq %eax, %rax" assert_contains
}

pub fn test_extern_abi_type_whitelist {
    "extern_abi_type_whitelist" test::test_start
    error::Diagnostics::new = valid_parse_diagnostics
    valid_parse_diagnostics
    "extern fn accepted a:i8 b:u16 c:i32 d:u64 e:f32 f:f64 p:ptr text:$cstr value:mut$i32 flag:bool -> bool"
    typecheck_extern_source = valid
    valid_parse_diagnostics "valid extern syntax" helpers::assert_no_errors
    valid.diagnostics "valid extern ABI types" helpers::assert_no_errors

    error::Diagnostics::new = invalid_parse_diagnostics
    invalid_parse_diagnostics
    "extern fn bad_str value:str\nextern fn bad_return -> $i32"
    typecheck_extern_source = invalid
    invalid_parse_diagnostics "invalid declarations parse" helpers::assert_no_errors
    invalid.diagnostics "str rejection" "Extern parameter type `str` is not C-ABI safe"
    helpers::assert_error_contains
    invalid.diagnostics "borrowed return rejection" "Extern return type `$i32` is not C-ABI safe"
    helpers::assert_error_contains
}

pub fn test_extern_struct_by_value_rules {
    "extern_struct_by_value_rules" test::test_start
    error::Diagnostics::new = valid_parse_diagnostics
    valid_parse_diagnostics
    "extern struct Resource { handle:ptr }\nextern fn make -> Resource"
    typecheck_extern_source = valid
    valid_parse_diagnostics "extern return syntax" helpers::assert_no_errors
    valid.diagnostics "owned extern return" helpers::assert_no_errors

    error::Diagnostics::new = invalid_parse_diagnostics
    invalid_parse_diagnostics
    "extern struct Resource { handle:ptr }\nextern fn take value:Resource"
    typecheck_extern_source = invalid
    invalid_parse_diagnostics "non-Copy extern syntax" helpers::assert_no_errors
    invalid.diagnostics "non-Copy parameter rejection"
    "Extern parameter type `Resource` must implement `Copy` for by-value passing"
    helpers::assert_error_contains

    error::Diagnostics::new = large_parse_diagnostics
    large_parse_diagnostics
    COPY_TRAITS
    "extern struct Large derives __casa_std__Copy { first:u64 second:u64 third:u64 }\nextern fn take value:Large\nextern fn make -> Large"
    str::concat.as_str
    typecheck_extern_source = large
    large_parse_diagnostics "memory-class syntax" helpers::assert_no_errors
    large.diagnostics "memory-class parameter and return" helpers::assert_no_errors

    error::Diagnostics::new = non_copy_large_parse_diagnostics
    non_copy_large_parse_diagnostics
    "extern struct Large { first:u64 second:u64 third:u64 }\nextern fn take value:Large"
    typecheck_extern_source = non_copy_large
    non_copy_large_parse_diagnostics "non-Copy memory-class syntax" helpers::assert_no_errors
    non_copy_large.diagnostics "non-Copy memory-class parameter rejection"
    "Extern parameter type `Large` must implement `Copy` for by-value passing"
    helpers::assert_error_contains
}

pub fn test_extern_struct_layout_and_borrows {
    "extern_struct_layout_and_borrows" test::test_start
    error::Diagnostics::new = parse_diagnostics
    parse_diagnostics
    "extern struct Tiny { value: u16 flag: bool }\nextern struct Packet { tag: u8 tiny: Tiny samples: array[u16 3] weight: f32 address: ptr active: bool }\nextern struct Batch { prefix: u8 items: array[Tiny 2] suffix: u32 }\nextern fn inspect value:$Packet\nextern fn mutate value:mut$Packet"
    typecheck_extern_source = result
    parse_diagnostics "extern struct syntax" helpers::assert_no_errors
    result.diagnostics "extern struct types" helpers::assert_no_errors

    "Tiny" result
        .store
        .structs
        .get_str
        .unwrap = tiny
    "Packet" result
        .store
        .structs
        .get_str
        .unwrap = packet
    "Batch" result
        .store
        .structs
        .get_str
        .unwrap = batch
    "extern marker" packet.is_extern test::assert_true
    "tiny size" 4 result.store "Tiny" common::parse_type_str common::type_inline_size.unwrap
    test::assert_eq
    "tiny flag offset" 2 result.store 1 tiny common::struct_member_offset.unwrap test::assert_eq
    "packet size" 32 result.store "Packet" common::parse_type_str common::type_inline_size.unwrap
    test::assert_eq
    "packet tag offset" 0 result.store 0 packet common::struct_member_offset.unwrap test::assert_eq
    "packet nested offset" 2 result.store 1 packet common::struct_member_offset.unwrap test::assert_eq
    "packet array offset" 6 result.store 2 packet common::struct_member_offset.unwrap test::assert_eq
    "packet float offset" 12 result.store 3 packet common::struct_member_offset.unwrap test::assert_eq
    "packet pointer offset" 16 result.store 4 packet common::struct_member_offset.unwrap test::assert_eq
    "packet bool offset" 24 result.store 5 packet common::struct_member_offset.unwrap test::assert_eq
    "nested array struct size" 16 result.store "Batch" common::parse_type_str
    common::type_inline_size.unwrap test::assert_eq
    "nested array offset" 2 result.store 1 batch common::struct_member_offset.unwrap test::assert_eq
    "nested array tail field offset" 12 result.store 2 batch common::struct_member_offset.unwrap
    test::assert_eq
}

pub fn test_extern_struct_rejections {
    "extern_struct_rejections" test::test_start
    error::Diagnostics::new = parse_diagnostics
    parse_diagnostics
    "struct Ordinary { value: i32 }\nenum Choice { One }\nextern struct Empty { }\nextern struct Generic[T] { value: T }\nextern struct Invalid { borrowed: $i32 text: str ctext: cstr owned: Ordinary choice: Choice callback: fn[i32 -> i32] zero: array[u8 0] }\nextern struct Valid { value: i32 }\nextern fn by_value value:Valid\nextern fn ordinary_borrow value:$Ordinary\nextern fn borrowed_return -> $Valid\nextern fn alias first:mut$Valid second:$Valid\n1 Valid = valid\nunsafe { valid valid alias }"
    typecheck_extern_source = result
    parse_diagnostics "invalid extern structs parse" helpers::assert_no_errors
    result.diagnostics "empty rejection" "Extern struct `Empty` must contain at least one field"
    helpers::assert_error_contains
    result.diagnostics "generic rejection" "Extern struct `Generic` cannot have type parameters"
    helpers::assert_error_contains
    result.diagnostics "borrowed field rejection"
    "Extern struct field `Invalid.borrowed` type `$i32` is not C-ABI safe"
    helpers::assert_error_contains
    result.diagnostics "ordinary field rejection"
    "Extern struct field `Invalid.owned` type `Ordinary` is not C-ABI safe"
    helpers::assert_error_contains
    result.diagnostics "zero array rejection"
    "Extern struct field `Invalid.zero` type `array[u8 0]` is not C-ABI safe"
    helpers::assert_error_contains
    result.diagnostics "by-value rejection"
    "Extern parameter type `Valid` must implement `Copy` for by-value passing"
    helpers::assert_error_contains
    result.diagnostics "ordinary borrow rejection"
    "Extern parameter type `$Ordinary` is not C-ABI safe" helpers::assert_error_contains
    result.diagnostics "borrowed extern return rejection"
    "Extern return type `$Valid` is not C-ABI safe" helpers::assert_error_contains
    result.diagnostics "extern struct borrows retain alias checks"
    "Cannot borrow `valid` exclusively while it is also borrowed in the same call"
    helpers::assert_error_contains
}

pub fn test_extern_calls_require_unsafe {
    "extern_calls_require_unsafe" test::test_start
    error::Diagnostics::new = call_parse_diagnostics
    call_parse_diagnostics
    "extern fn abs value:i32 -> i32\n-7 = value:i32 value abs drop"
    typecheck_extern_source = call_result
    call_result.diagnostics "unsafe call" "Unsafe operation `abs`" helpers::assert_error_contains

    error::Diagnostics::new = reference_parse_diagnostics
    reference_parse_diagnostics "extern fn abs value:i32 -> i32\n&abs drop"
    typecheck_extern_source = reference_result
    reference_result drop
    reference_parse_diagnostics "unsafe reference" "Unsafe function `abs` cannot be referenced"
    helpers::assert_error_contains
}

pub fn test_extern_declaration_shape_errors {
    "extern_declaration_shape_errors" test::test_start
    error::Diagnostics::new = body_diagnostics
    body_diagnostics "extern fn invalid { 1 drop }" helpers::parse_resolve_test_source drop
    body_diagnostics "body rejection" "Extern function declarations cannot have a body"
    helpers::assert_error_contains

    error::Diagnostics::new = return_diagnostics
    return_diagnostics "extern fn invalid -> i32 i64" helpers::parse_resolve_test_source drop
    return_diagnostics "return arity" "Extern functions can return at most one value"
    helpers::assert_error_contains

    error::Diagnostics::new = multiline_body_diagnostics
    multiline_body_diagnostics "extern fn invalid\n{ 1 drop }" helpers::parse_resolve_test_source drop
    multiline_body_diagnostics "multiline body rejection"
    "Extern function declarations cannot have a body" helpers::assert_error_contains
}

pub fn test_imported_extern_preserves_native_symbol {
    "imported_extern_preserves_native_symbol" test::test_start
    "import \"/tmp/casa_extern_import.casa\" as native\nunsafe { -7 = value:i32 value native::abs drop }".to_str
    "/tmp/casa_extern_root.casa".to_str analysis::AnalysisInput::new = input
    "pub extern fn abs value:i32 -> i32".to_str
    "/tmp/casa_extern_import.casa".to_str input.source_overrides.set
    input analysis::analyze.into_parts = typechecked = sources = diagnostics
    sources drop
    "imported extern analysis" diagnostics.has_errors ! test::assert_true
    typechecked.unwrap bytecode::compile_typechecked.unwrap emitter::emit = assembly
    "native symbol is not namespaced" assembly "call abs" assert_contains
}

pub fn test_imported_extern_struct {
    "imported_extern_struct" test::test_start
    "import \"/tmp/casa_extern_struct_import.casa\" as ffi\nextern fn inspect value:$ffi::Point\n7 ffi::Point = point\nunsafe { point inspect }\npoint.x drop".to_str
    "/tmp/casa_extern_struct_root.casa".to_str analysis::AnalysisInput::new = input
    "pub extern struct Point { pub x: i32 }".to_str
    "/tmp/casa_extern_struct_import.casa".to_str input.source_overrides.set
    input analysis::analyze.into_parts = typechecked = sources = diagnostics
    sources drop
    typechecked drop
    "imported extern struct analysis" diagnostics.has_errors ! test::assert_true
}

pub fn test_extern_register_and_stack_arguments {
    "extern_register_and_stack_arguments" test::test_start
    std::List[common::ExternAbiType]::new = parameters
    0 = integer_index: u64
    while integer_index 7 > do
        common::BuiltinType::I64 common::builtin_type_layout = layout
        layout.size common::BuiltinType::I64 common::ExternAbiPassing::Scalar
        common::ExternAbiType::new parameters.push
        1 += integer_index
    done
    0 = float_index: u64
    while float_index 9 > do
        common::BuiltinType::F64 common::builtin_type_layout = layout
        layout.size common::BuiltinType::F64 common::ExternAbiPassing::Scalar
        common::ExternAbiType::new parameters.push
        1 += float_index
    done
    std::Option[common::ExternAbiType]::None parameters "mixed".to_str common::ExternCall::new
    common::InstValue::ExternCall = extern_call
    std::List[common::InstValue]::new = instructions
    extern_call instructions.push
    0 0
    std::List[common::StaticStruct]::new
    std::List[common::StaticArray]::new
    std::List[std::String]::new
    std::Map[std::String std::List[common::InstValue]]::new
    instructions
    common::Program emitter::emit = assembly

    "sixth integer register" assembly "movq 40(%r13), %r9" assert_contains
    "eighth float register" assembly "movsd 112(%r13), %xmm7" assert_contains
    "later stack argument first" assembly "pushq 120(%r13)" assert_contains
    "earlier stack argument second" assembly "pushq 48(%r13)" assert_contains
}
test_extern_declaration_and_call_lowering
test_extern_abi_type_whitelist
test_extern_struct_by_value_rules
test_extern_struct_layout_and_borrows
test_extern_struct_rejections
test_extern_calls_require_unsafe
test_extern_declaration_shape_errors
test_imported_extern_preserves_native_symbol
test_imported_extern_struct
test_extern_register_and_stack_arguments
test::test_summary
