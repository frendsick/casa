import "std" as std

# These std-only tests carry the few assertions they use.
0 = test_pass_count
0 = test_fail_count
"" = test_current_name

pub fn test_start name:str { name = test_current_name }

pub fn assert_true condition:bool message:$str {
    if condition then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message}\n".as_str std::eprint
        1 += test_fail_count
    fi
}

pub fn assert_u64_eq actual:u64 expected:u64 message:$str {
    if expected actual == then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message} (expected {expected}, got {actual})\n".as_str std::eprint
        1 += test_fail_count
    fi
}

pub fn assert_str_eq actual:$str expected:$str message:$str {
    if expected actual == then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message} (expected {expected}, got {actual})\n".as_str std::eprint
        1 += test_fail_count
    fi
}

pub fn test_summary {
    f"{test_pass_count} passed, {test_fail_count} failed\n" print
    if 0 test_fail_count > then
        1 std::exit
    fi
}
# A function that accepts any length reads the constant from the type, and each
# distinct length is its own instantiation (ADR-0152).

pub fn count_elements [T const N:u64] values:$array[T N] -> u64 {
    0 (u64) = counted
    for value in values.iter do
        value drop
        1 += counted
    done
    counted
}

pub fn read_runtime_index values:$array[i64 3] condition:bool -> i64 {
    if condition then
        3
    else
        0
    fi
    values.nth.clone
}

pub fn make_empty_list -> std::List[i64] {
    [] (array[i64 0]) std::List::from_array
}

pub struct DensePair {
    pub small: u8
    pub large: u64
}

pub fn run_array_length_tests {
    "length comes from the type" test_start
    [10, 20, 30] = three
    "three elements" 3 three.length assert_u64_eq
    "iteration visits every element" 3 three count_elements assert_u64_eq
    three drop
    # A different length is a different type, instantiated on its own.
    [1, 2, 3, 4, 5, 6, 7] = seven
    "a different length is a different instantiation" 7 seven.length assert_u64_eq
    seven drop
    # ADR-0155: an empty array is inhabited, so it constructs, clones, and drops
    # like any other array while holding no elements.
    "zero-length array" test_start
    [] (array[i64 0]) = empty
    "no elements" 0 empty.length assert_u64_eq
    "iteration yields nothing" 0 empty count_elements assert_u64_eq
    empty.clone = empty_copy
    "clone keeps the length" 0 empty_copy.length assert_u64_eq
    empty_copy drop
    empty drop
    "empty array to list" test_start
    [] (array[i64 0]) std::List::from_array = empty_list
    1 empty_list.push
    "push grows zero-capacity list" 1 empty_list.length assert_u64_eq
    empty_list drop
    "empty arrays behave independently" test_start
    make_empty_list = first_empty_list
    make_empty_list = second_empty_list
    1 first_empty_list.push
    2 second_empty_list.push
    "first list mutation" 1 0 first_empty_list.get copy u64::try_from.unwrap assert_u64_eq
    "second list mutation" 2 0 second_empty_list.get copy u64::try_from.unwrap assert_u64_eq
    first_empty_list drop
    second_empty_list drop
    "element access" test_start
    ["a", "b", "c"] = words
    "borrows the element" "b" 1 words.nth assert_str_eq
    "contains an element" "c" words.contains assert_true
    "rejects a missing element" "d" words.contains ! assert_true
    words drop
    "runtime index" test_start
    [10, 20, 30] = numbers
    "runtime branch selects valid index" 10 false numbers read_runtime_index u64::try_from.unwrap assert_u64_eq
    numbers drop
    "dense element storage" test_start
    [1, 2, 255] (array[u8 3]) = compact
    "u8 values use one-byte stride" 2 unsafe { compact (ptr) 1 + load8 } (u64) assert_u64_eq
    "compact access" 255 2 compact.nth.clone (u64) assert_u64_eq
    compact.clone = compact_copy
    "compact clone" 2 1 compact_copy.nth.clone (u64) assert_u64_eq
    compact_copy drop
    compact drop
    123 (u64) 9 (u8) DensePair = first_pair
    456 (u64) 7 (u8) DensePair = second_pair
    [first_pair, second_pair] = pairs
    "multiword first field" 7 1 pairs.nth.small (u64) assert_u64_eq
    "multiword second field" 456 1 pairs.nth.large assert_u64_eq
    pairs drop
    test_summary
}
run_array_length_tests
