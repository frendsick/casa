import "std"

# `lib/test.casa` needs the `Eq` trait (#334), so these tests carry the few
# assertions they use, like the other std-based tests here.
0 = test_pass_count
0 = test_fail_count
"" = test_current_name

fn test_start name:str { name = test_current_name }

fn assert_true condition:bool message:$str {
    if condition then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message}\n" eprint
        1 += test_fail_count
    fi
}

fn assert_u64_eq actual:u64 expected:u64 message:$str {
    if expected actual == then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message} (expected {expected}, got {actual})\n" eprint
        1 += test_fail_count
    fi
}

fn assert_str_eq actual:$str expected:$str message:$str {
    if expected actual == then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message} (expected {expected}, got {actual})\n" eprint
        1 += test_fail_count
    fi
}

fn test_summary {
    f"{test_pass_count} passed, {test_fail_count} failed\n" print
    if 0 test_fail_count > then
        1 exit
    fi
}
# A function that accepts any length reads the constant from the type, and each
# distinct length is its own instantiation (ADR-0152).

fn count_elements [T const N:u64] values:$array[T N] -> u64 {
    0 (u64) = counted
    for value in values.iter do
        value drop
        1 += counted
    done
    counted
}
"length comes from the type" test_start
[10, 20, 30] = three
"three elements" 3 three.length assert_u64_eq
"iteration visits every element" 3 three count_elements assert_u64_eq
three drop
# A different length is a different type, instantiated on its own.
[1, 2, 3, 4, 5, 6, 7] = seven
"a different length is a different instantiation" 7 seven.length assert_u64_eq
seven drop
# ADR-0154: an empty array is inhabited, so it constructs, clones, and drops
# like any other array while holding no elements.
"zero-length array" test_start
[] (array[i64 0]) = empty
"no elements" 0 empty.length assert_u64_eq
"iteration yields nothing" 0 empty count_elements assert_u64_eq
empty.clone = empty_copy
"clone keeps the length" 0 empty_copy.length assert_u64_eq
empty_copy drop
empty drop
"element access" test_start
["a", "b", "c"] = words
"borrows the element" "b" 1 words.nth assert_str_eq
"contains an element" "c" words.contains assert_true
"rejects a missing element" "d" words.contains ! assert_true
words drop
test_summary
