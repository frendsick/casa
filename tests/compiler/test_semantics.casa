import "../../compiler/semantics.casa"
import "helpers.casa"

fn analyze_test_operation
    store:mut$SymbolStore
    function_opt:mut$Option[Function]
    receiver:mut$Option[Type]
    operation:mut$OpValue
-> SemanticFacts {
    store function_opt receiver operation analyze_operation
}

fn test_fixed_stack_effects_are_canonical {
    "fixed_stack_effects_are_canonical" test_start
    symbol_store_new = store
    Option[Function]::None = no_function
    Option[Type]::None = no_receiver

    OpValue::Dup no_receiver no_function store analyze_test_operation = duplicate
    "dup has a fixed effect" duplicate.stack_effect.is_some assert_true
    "dup effect" "T -> T T" duplicate
        .stack_effect
        .clone
        .unwrap stack_effect_to_str assert_str_eq
    "T" duplicate
        .stack_effect
        .clone
        .unwrap
        .trait_bounds
        .get
        .unwrap = duplicate_bounds
    "dup Copy bound" "Copy" 0 duplicate_bounds.get.name assert_str_eq

    OpValue::Store64 no_receiver no_function store analyze_test_operation = store_semantics
    "store64 effect" "ptr u64 -> None" store_semantics
        .stack_effect
        .clone
        .unwrap stack_effect_to_str assert_str_eq
    "store64 has no generic word input" 0 store_semantics.word_parameter_count assert_eq

    OpValue::Store8 no_receiver no_function store analyze_test_operation = store8_semantics
    "store8 effect" "ptr u8 -> None" store8_semantics
        .stack_effect
        .clone
        .unwrap stack_effect_to_str assert_str_eq
    OpValue::Store16 no_receiver no_function store analyze_test_operation = store16_semantics
    "store16 effect" "ptr u16 -> None" store16_semantics
        .stack_effect
        .clone
        .unwrap stack_effect_to_str assert_str_eq
    OpValue::Store32 no_receiver no_function store analyze_test_operation = store32_semantics
    "store32 effect" "ptr u32 -> None" store32_semantics
        .stack_effect
        .clone
        .unwrap stack_effect_to_str assert_str_eq

    OpValue::HeapFree no_receiver no_function store analyze_test_operation = free_semantics
    "free effect" "ptr -> None" free_semantics
        .stack_effect
        .clone
        .unwrap stack_effect_to_str assert_str_eq

    OpValue::Syscall3 no_receiver no_function store analyze_test_operation = syscall_semantics
    "syscall3 arity" 3 syscall_semantics
        .syscall_argument_count
        .clone
        .unwrap assert_eq
    "syscall3 effect" 4 syscall_semantics
        .stack_effect
        .clone
        .unwrap
        .parameters
        .length assert_eq
    "syscall3 result" "i64" 0 syscall_semantics
        .stack_effect
        .clone
        .unwrap
        .return_types
        .get
        .format assert_str_eq
}

fn test_dispatch_and_dependencies_are_canonical {
    "dispatch_and_dependencies_are_canonical" test_start
    Diagnostics::new = diagnostics
    diagnostics
    "trait Display { fn to_str self:self -> str } struct Box { value: i64 } impl Box: Display { fn to_str self:Box -> str { self drop \"box\" } } fn callee -> Box { 1 Box } fn root -> str { callee print }"
    parse_resolve_test_source = parsed
    diagnostics "source parses" assert_no_errors
    "root" parsed
        .store
        .functions
        .get
        .unwrap
        .clone_declaration = root
    "Box" parse_type_str Option::Some = box_receiver
    root Option::Some = root_function

    "callee" OpValue::FnCall Option[Type]::None root_function parsed.store
    analyze_test_operation = call_semantics
    "call dependency" "callee" call_semantics.dependencies string_list_contains assert_true

    OpValue::Print box_receiver root_function parsed.store
    analyze_test_operation = print_semantics
    "print trait dependency" "Display" print_semantics.dependencies string_list_contains assert_true
    "print method dependency" "Box::Display::to_str" print_semantics.dependencies string_list_contains assert_true
    "print resolves through method" print_semantics.method.is_some assert_true
}

fn test_method_kinds_share_targets_and_dependencies {
    "method_kinds_share_targets_and_dependencies" test_start
    Diagnostics::new = diagnostics
    diagnostics
    "trait Step { fn base self:self -> i64 fn bumped self:self -> i64 { self .base 1 + } } struct Box { value: i64 } impl Box: Step { fn base self:Box -> i64 { self Box::value } } fn bounded[T: Step] value:T -> i64 { value .base } fn root -> i64 { 1 Box .bumped }"
    parse_resolve_test_source = parsed
    diagnostics "source parses" assert_no_errors
    "root" parsed
        .store
        .functions
        .get
        .unwrap
        .clone_declaration Option::Some = root
    "bounded" parsed
        .store
        .functions
        .get
        .unwrap
        .clone_declaration Option::Some = bounded

    "base" OpValue::MethodCall "Box" parse_type_str Option::Some root parsed.store
    analyze_test_operation = direct
    "direct method fact" direct.method.is_some assert_true
    "direct target" "Box::Step::base" direct
        .method
        .clone
        .unwrap
        .function_name assert_str_eq
    "direct dependency" "Box::Step::base" direct.dependencies string_list_contains assert_true

    "bumped" OpValue::MethodCall "Box" parse_type_str Option::Some root parsed.store
    analyze_test_operation = default_method
    "default method fact" default_method.method.is_some assert_true
    "default method kind"
    default_method
        .method
        .clone
        .unwrap
        .kind MethodSemanticsKind::DefaultMethod is
    assert_true
    "default trait dependency" "Step" default_method.dependencies string_list_contains assert_true
    "default implementation dependency"
    "Box::Step::base" default_method.dependencies string_list_contains
    assert_true

    "base" OpValue::MethodCall "T" Type::TypeVar Option::Some bounded parsed.store
    analyze_test_operation = bound_method
    "bound method fact" bound_method.method.is_some assert_true
    "bound method kind"
    bound_method
        .method
        .clone
        .unwrap
        .kind MethodSemanticsKind::TraitBound is
    assert_true
    "bound trait dependency" "Step" bound_method.dependencies string_list_contains assert_true
}

fn test_function_semantics_own_control_flow_and_bindings {
    "function_semantics_own_control_flow_and_bindings" test_start
    Diagnostics::new = diagnostics
    diagnostics
    "fn helper value:i64 -> i64 { value } impl i64 { fn picked self:i64 -> i64 { self } } fn root -> i64 { true if then 1 = value value helper .picked else 0 fi }"
    parse_resolve_test_source = parsed
    diagnostics "source parses" assert_no_errors
    "root" parsed
        .store
        .functions
        .get
        .unwrap
        .clone = root
    Map[str StackEffect]::new = inferred_effects
    parsed.store inferred_effects root analyze_function_semantics = semantics
    "call dependency" "helper" semantics.has_symbol_dependency assert_true
    "assignment preserves receiver"
    "i64::picked" semantics.has_symbol_dependency
    assert_true
    "function effect" "None -> i64" semantics.inferred_effect stack_effect_to_str assert_str_eq
}
test_fixed_stack_effects_are_canonical
test_dispatch_and_dependencies_are_canonical
test_method_kinds_share_targets_and_dependencies
test_function_semantics_own_control_flow_and_bindings
test_summary
