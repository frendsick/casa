pub fn analyze_test_operation
    store:mut$common::SymbolStore
    function_opt:mut$std::Option[common::Function]
    receiver:mut$std::Option[common::Type]
    operation:mut$common::OpValue
-> rules::SemanticFacts {
    std::Option[common::Type]::None = receiver_ref
    if receiver std::Option::Some(receiver_type) is then
        receiver_type rules::make_type_borrow_option = receiver_ref
    fi
    store function_opt receiver_ref operation rules::analyze_operation
}

pub fn test_generic_type_unification_keeps_matching_bases {
    "generic_type_unification_keeps_matching_bases" test::test_start
    common::symbol_store_new = store
    std::List[common::Type]::new = unknown_parameters
    common::Type::Unknown unknown_parameters.push
    unknown_parameters "Box".to_str common::GenericType common::Type::Generic = unknown_box
    "Box[i64]" common::parse_type_str = integer_box

    store integer_box unknown_box rules::unify_generic_type_parameters = unified
    "matching generic bases unify" unified.is_some test::assert_true
    "matching generic parameters unify" "Box[i64]" unified.unwrap.format test::assert_str_eq
}

pub fn test_symbolic_stack_join_retains_structure {
    "symbolic_stack_join_retains_structure" test::test_start
    common::symbol_store_new = store
    "Option[T]" common::parse_type_str = unconstrained
    "Option[Pair[K V]]" common::parse_type_str = structured
    store structured unconstrained rules::unify_type_t.unwrap = forward
    store unconstrained structured rules::unify_type_t.unwrap = reverse
    "first branch preserves nested structure" "Option[Pair[K V]]" forward.format test::assert_str_eq
    "second branch preserves nested structure" "Option[Pair[K V]]" reverse.format test::assert_str_eq
}

pub fn test_discarded_empty_constructor_is_concrete {
    "discarded_empty_constructor_is_concrete" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "import \"lib/std.casa\" as std std::Option::None drop" helpers::typecheck_test_source = checked
    "empty constructor resolves" diagnostics.has_errors test::assert_false
    "empty constructor checks" checked.get_diagnostics.has_errors test::assert_false
    "discarded constructor has a concrete body" checked.into_checked_program.is_ok test::assert_true
}

pub fn test_checked_program_owns_structured_bodies {
    "checked_program_owns_structured_bodies" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "fn choose value:i64 -> i64 { if true then value else 0 fi } 42 choose drop"
    helpers::typecheck_test_source.into_checked_program.unwrap = program
    "root owns checked operations" program
        .get_root
        .get_nodes
        .is_empty ! test::assert_true
    "callee owns checked operations" "choose" program
        .find_body
        .unwrap
        .get_nodes
        .is_empty ! test::assert_true
}

pub fn test_checked_body_requires_its_own_storage {
    "checked_body_requires_its_own_storage" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "2 = value fn outer value:i64 { { value drop } exec } 1 outer value drop"
    helpers::typecheck_test_source.into_checked_program.unwrap = program
    "outer" program.find_body.unwrap = body
    "outer" program
        .get_store
        .get_function
        .unwrap = declaration
    std::List[common::Variable]::new = empty
    std::List[std::String]::new = callees
    std::List[common::Type]::new = drops
    declaration.captures declaration.variables program.get_store semantic_body::BodyReferences::new = matching
    "matching storage passes" matching drops callees body.validate_concrete.is_ok test::assert_true
    empty empty program.get_store semantic_body::BodyReferences::new = missing
    "root names cannot replace missing function storage" missing drops callees body.validate_concrete.is_error test::assert_true
    false = checked_capture
    for
        name in program
            .get_store
            .get_function_names
            .iter
    do
        name.as_str program
            .get_store
            .get_function
            .unwrap = function
        if function.captures.is_empty then
            continue
        fi
        true = checked_capture
        empty function.variables program.get_store semantic_body::BodyReferences::new = missing_capture
        "missing capture is rejected" missing_capture drops callees name.as_str program
            .find_body
            .unwrap
            .validate_concrete
            .is_error test::assert_true
    done
    "checked a captured body" checked_capture test::assert_true
}

pub fn test_symbolic_recipe_cannot_pass_concrete_gate {
    "symbolic_recipe_cannot_pass_concrete_gate" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "trait Value { fn value self:self -> i64 } fn answer[T:Value] item:T -> i64 { item.value }"
    helpers::typecheck_test_source = result
    result.get_diagnostics "symbolic recipe checks" helpers::assert_no_errors
    result.into_analysis_parts = verified = bodies = root = store
    "answer" bodies
        .remove_str
        .unwrap
        .into_checked
        .unwrap = recipe
    "answer" store.get_function.unwrap = declaration
    declaration.captures declaration.variables store semantic_body::BodyReferences::new = references
    std::List[std::String]::new = callees
    std::List[common::Type]::new = drops
    "concrete gate rejects symbolic facts" references drops callees recipe.validate_concrete.is_error test::assert_true
}

pub fn test_specialized_lambda_has_concrete_nested_result {
    "specialized_lambda_has_concrete_nested_result" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "import \"lib/std.casa\" as std std::Map[i64 i64]::new = values 2 1 values.set values.iter = iterator iterator.next drop"
    helpers::typecheck_test_source = checked
    diagnostics "iterator source resolves" helpers::assert_no_errors
    checked.get_diagnostics "iterator callback checks" helpers::assert_no_errors
    checked.into_checked_program.unwrap = program
    false = found
    for
        name in program
            .get_store
            .get_function_names
            .iter
    do
        if name.as_str "lambda__iter" str::starts_with name.as_str program.find_body.is_some && then
            true = found
            name.as_str program
                .get_store
                .get_function
                .unwrap = function
            for
                typ in function
                    .stack_effect
                    .return_types
                    .iter
            do
                "iterator callback result is concrete" typ.has_unresolved_type_var ! test::assert_true
            done
        fi
    done
    "checked program retains the iterator callback" found test::assert_true
}

pub fn test_pattern_bindings_follow_subject_capability {
    "pattern_bindings_follow_subject_capability" test::test_start
    "Payload" common::parse_type_str = payload

    false payload.clone "Choice" common::parse_type_str semantics::pattern_binding_type
    = owned_binding
    "owned subject binding" "Payload" owned_binding.format test::assert_str_eq

    false payload.clone "$Choice" common::parse_type_str semantics::pattern_binding_type
    = shared_binding
    "shared subject binding" "$Payload" shared_binding.format test::assert_str_eq

    false payload.clone "mut$Choice" common::parse_type_str semantics::pattern_binding_type
    = exclusive_binding
    "exclusive subject binding" "mut$Payload" exclusive_binding.format test::assert_str_eq

    true payload "$Choice" common::parse_type_str semantics::pattern_binding_type
    = copy_binding
    "Copy payload binding" "Payload" copy_binding.format test::assert_str_eq
}

pub fn test_fixed_stack_effects_are_canonical {
    "fixed_stack_effects_are_canonical" test::test_start
    common::symbol_store_new = store
    std::Option[common::Function]::None = no_function
    std::Option[common::Type]::None = no_receiver

    common::OpValue::Dup no_receiver no_function store analyze_test_operation = duplicate
    "dup has a fixed effect" duplicate.stack_effect.is_some test::assert_true
    "dup effect" "T -> T T" duplicate
        .stack_effect
        .clone
        .unwrap common::stack_effect_to_str test::assert_str_eq
    "T" duplicate
        .stack_effect
        .clone
        .unwrap
        .trait_bounds
        .get_str
        .unwrap = duplicate_bounds
    "dup Copy bound" common::STD_COPY_TRAIT 0 duplicate_bounds.get.name test::assert_str_eq

    common::OpValue::Store64 no_receiver no_function store analyze_test_operation = store_semantics
    "store64 effect" "ptr u64 -> None" store_semantics
        .stack_effect
        .clone
        .unwrap common::stack_effect_to_str test::assert_str_eq
    "store64 has no generic word input" 0 store_semantics.word_parameter_count test::assert_eq

    common::OpValue::Store8 no_receiver no_function store analyze_test_operation = store8_semantics
    "store8 effect" "ptr u8 -> None" store8_semantics
        .stack_effect
        .clone
        .unwrap common::stack_effect_to_str test::assert_str_eq
    common::OpValue::Store16 no_receiver no_function store analyze_test_operation = store16_semantics
    "store16 effect" "ptr u16 -> None" store16_semantics
        .stack_effect
        .clone
        .unwrap common::stack_effect_to_str test::assert_str_eq
    common::OpValue::Store32 no_receiver no_function store analyze_test_operation = store32_semantics
    "store32 effect" "ptr u32 -> None" store32_semantics
        .stack_effect
        .clone
        .unwrap common::stack_effect_to_str test::assert_str_eq

    common::OpValue::HeapFree no_receiver no_function store analyze_test_operation = free_semantics
    "free effect" "ptr -> None" free_semantics
        .stack_effect
        .clone
        .unwrap common::stack_effect_to_str test::assert_str_eq

    common::OpValue::Syscall3 no_receiver no_function store analyze_test_operation = syscall_semantics
    "syscall3 arity" 3 syscall_semantics
        .syscall_argument_count
        .clone
        .unwrap test::assert_eq
    "syscall3 effect" 4 syscall_semantics
        .stack_effect
        .clone
        .unwrap
        .parameters
        .length test::assert_eq
    "syscall3 result" "i64" 0 syscall_semantics
        .stack_effect
        .clone
        .unwrap
        .return_types
        .get
        .format test::assert_str_eq
}

pub fn test_dispatch_and_dependencies_are_canonical {
    "dispatch_and_dependencies_are_canonical" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "trait __casa_std__Display { fn to_str self:self -> __casa_std__String } struct Box { value: i64 } impl Box: __casa_std__Display { fn to_str self:Box -> __casa_std__String { self drop \"box\" } } fn callee -> Box { 1 Box } fn root -> str { callee print }"
    helpers::parse_resolve_test_source = parsed
    diagnostics "source parses" helpers::assert_no_errors
    "root" parsed
        .store
        .get_function
        .unwrap
        .clone = root
    "Box" common::parse_type_str std::Option::Some = box_receiver
    root std::Option::Some = root_function

    "callee".to_str common::OpValue::FnCall std::Option[common::Type]::None root_function parsed.store
    analyze_test_operation = call_semantics
    "call dependency" "callee" call_semantics.dependencies common::string_list_contains test::assert_true

    common::OpValue::Print box_receiver root_function parsed.store
    analyze_test_operation = print_semantics
    "print trait dependency" common::STD_DISPLAY_TRAIT print_semantics.dependencies common::string_list_contains test::assert_true
    "print method dependency" "Box::__casa_std__Display::to_str" print_semantics.dependencies common::string_list_contains test::assert_true
    "print resolves through method" print_semantics.method.is_some test::assert_true
}

pub fn test_method_kinds_share_targets_and_dependencies {
    "method_kinds_share_targets_and_dependencies" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "trait Step { fn base self:self -> i64 fn bumped self:self -> i64 { self .base 1 + } } struct Box { value: i64 } impl Box: Step { fn base self:Box -> i64 { self Box::value } } fn bounded[T: Step] value:T -> i64 { value .base } fn root -> i64 { 1 Box .bumped }"
    helpers::parse_resolve_test_source = parsed
    diagnostics "source parses" helpers::assert_no_errors
    "root" parsed
        .store
        .get_function
        .unwrap
        .clone std::Option::Some = root
    "bounded" parsed
        .store
        .get_function
        .unwrap
        .clone std::Option::Some = bounded

    "base".to_str common::OpValue::MethodCall "Box" common::parse_type_str std::Option::Some root parsed.store
    analyze_test_operation = direct
    "direct method fact" direct.method.is_some test::assert_true
    "direct target" "Box::Step::base" direct
        .method
        .clone
        .unwrap
        .function_name test::assert_str_eq
    "direct dependency" "Box::Step::base" direct.dependencies common::string_list_contains test::assert_true

    common::empty_stack_effect
    "Step" common::parse_type_str std::Option::Some
    "Box" common::parse_type_str
    "base".to_str
    common::DeferredTraitCall::new common::OpValue::TraitMethodCall
    "Box" common::parse_type_str std::Option::Some root parsed.store
    analyze_test_operation = qualified_deferred
    "deferred trait dependency" "Step" qualified_deferred.dependencies common::string_list_contains test::assert_true
    "deferred method dependency"
    "Box::Step::base" qualified_deferred.dependencies common::string_list_contains
    test::assert_true

    "bumped".to_str common::OpValue::MethodCall "Box" common::parse_type_str std::Option::Some root parsed.store
    analyze_test_operation = default_method
    "default method fact" default_method.method.is_some test::assert_true
    "default method kind"
    default_method
        .method
        .clone
        .unwrap
        .kind rules::MethodSemanticsKind::DefaultMethod is
    test::assert_true
    "default trait dependency" "Step" default_method.dependencies common::string_list_contains test::assert_true
    "default implementation dependency"
    "Box::Step::base" default_method.dependencies common::string_list_contains
    test::assert_true

    "base".to_str common::OpValue::MethodCall "T".to_str common::Type::TypeVar std::Option::Some bounded parsed.store
    analyze_test_operation = bound_method
    "bound method fact" bound_method.method.is_some test::assert_true
    "bound method kind"
    bound_method
        .method
        .clone
        .unwrap
        .kind rules::MethodSemanticsKind::TraitBound is
    test::assert_true
    "bound trait dependency" "Step" bound_method.dependencies common::string_list_contains test::assert_true
}

pub fn test_function_semantics_own_control_flow_and_bindings {
    "function_semantics_own_control_flow_and_bindings" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "fn helper value:i64 -> i64 { value } impl i64 { fn picked self:i64 -> i64 { self } } fn root -> i64 { true if then 1 = value value helper .picked else 0 fi }"
    helpers::parse_resolve_test_source = parsed
    diagnostics "source parses" helpers::assert_no_errors
    "root" parsed
        .store
        .get_function
        .unwrap
        .clone = root
    parsed.source_bodies parsed.store root semantics::analyze_function_semantics = semantics
    "call dependency" "helper" semantics.has_symbol_dependency test::assert_true
    "assignment preserves receiver"
    "i64::picked" semantics.has_symbol_dependency
    test::assert_true
    "function effect" "None -> i64" semantics.inferred_effect common::stack_effect_to_str test::assert_str_eq
}

pub fn test_checked_method_reference_dependencies {
    "checked_method_reference_dependencies" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "impl i64 { fn picked self:i64 -> i64 { self } }"
    helpers::parse_resolve_test_source = parsed
    std::List[common::Op]::new = reference_ops
    common::empty_location "reference_root".to_str
    common::Function::new = root
    common::empty_stack_effect std::Option[common::Type]::None common::make_i64_type "picked".to_str
    common::DeferredTraitCall::new common::OpValue::TraitMethodRef
    common::empty_location swap common::Op::new reference_ops.push
    common::empty_location common::OpValue::Drop common::Op::new reference_ops.push
    reference_ops source_body::consume_source_body root.name.clone parsed.source_bodies.set
    parsed.source_bodies parsed.store root semantics::analyze_function_semantics = checked
    checked.diagnostics "method reference checks" helpers::assert_no_errors
    "selected method is a dependency" "i64::picked" checked.has_symbol_dependency test::assert_true
}

pub fn test_generic_callable_body_checked_once {
    "generic_callable_body_checked_once" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "fn answer -> i64 { 42 } fn maker[T] value:T -> fn[-> i64] { value drop &answer } 1 maker exec drop"
    helpers::parse_resolve_test_parts = source_bodies = store = operations
    source_bodies store semantics::SemanticSession::from_store = session
    session operations semantics::analyze_root_semantics = first
    first.diagnostics "first call accepted" helpers::assert_no_errors
    "maker" session
        .find_checked_body
        .unwrap
        .lower_operations = before
    session operations semantics::analyze_root_semantics = second
    second.diagnostics "repeated call accepted" helpers::assert_no_errors
    "maker" session
        .find_checked_body
        .unwrap
        .lower_operations = after
    "source body keeps its checked operation identities"
    0 before.get.id 0 after.get.id test::assert_eq
}

pub fn test_completed_lambda_keeps_checked_stack_effect {
    "completed_lambda_keeps_checked_stack_effect" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "fn invoke[T] callback:fn[-> T] -> T { callback exec } { true } invoke drop"
    helpers::parse_resolve_test_parts = source_bodies = store = operations
    diagnostics "source resolves" helpers::assert_no_errors
    "".to_str = lambda_name
    for operation in operations.iter do
        if operation.value common::OpValue::FnPush(name) is then
            name.clone = lambda_name
        fi
    done
    "source has a lambda" lambda_name.is_empty ! test::assert_true
    source_bodies store semantics::SemanticSession::from_store = session
    session operations semantics::analyze_root_semantics = first
    first.diagnostics "first callback checks" helpers::assert_no_errors
    lambda_name.as_str session.clone_function.unwrap = before
    session operations semantics::analyze_root_semantics = second
    second.diagnostics "repeated callback checks" helpers::assert_no_errors
    lambda_name.as_str session.clone_function.unwrap = after
    "checked lambda returns bool" "None -> bool" after.stack_effect common::stack_effect_to_str test::assert_str_eq
    "callback context preserves checked stack effect"
    before.stack_effect common::stack_effect_to_str after.stack_effect common::stack_effect_to_str test::assert_str_eq
}

pub fn test_callable_return_recursion_terminates {
    "callable_return_recursion_terminates" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "fn recurse -> fn[-> i64] { recurse } fn left -> fn[-> i64] { right } fn right -> fn[-> i64] { left } trait Pick[T] { fn choose self:self -> T { self .choose } } impl i64: Pick[fn[-> i64]] { }"
    helpers::parse_resolve_test_source = parsed
    diagnostics "source parses" helpers::assert_no_errors

    "recurse" parsed
        .store
        .get_function
        .unwrap = recurse
    parsed.source_bodies parsed.store recurse semantics::analyze_function_semantics = direct
    direct.diagnostics.clone diagnostics.merge

    "left" parsed
        .store
        .get_function
        .unwrap = left
    parsed.source_bodies parsed.store left semantics::analyze_function_semantics = mutual
    mutual.diagnostics.clone diagnostics.merge

    std::List[common::Op]::new = default_ops
    common::empty_location "default_root".to_str common::Function::new = default_root
    common::empty_location 1 common::make_integer_op_value common::Op::new default_ops.push
    common::empty_location "choose".to_str common::OpValue::MethodCall common::Op::new default_ops.push
    default_ops source_body::consume_source_body default_root.name.clone parsed.source_bodies.set
    parsed.source_bodies parsed.store default_root semantics::analyze_function_semantics = default_method
    default_method.diagnostics.clone diagnostics.merge
    diagnostics "recursive callable analysis terminates" helpers::assert_no_errors
}

pub fn test_unnamed_effect_parameter_uses_function_variable_name {
    "unnamed_effect_parameter_uses_function_variable_name" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "fn late -> i64 { 1 } fn apply fn[-> i64] -> i64 { = callback callback exec } fn root -> i64 { &late apply }"
    helpers::parse_resolve_test_source = parsed
    diagnostics "source parses" helpers::assert_no_errors
    "root" parsed
        .store
        .get_function
        .unwrap = root
    parsed.source_bodies parsed.store root semantics::analyze_function_semantics = analysis
    false = found_binding
    for fact in analysis.ordered_facts.iter do
        if fact semantics::SemanticDependency::BoundCall(call) is then
            if "apply" call.function_name.as_str == then
                if "callback" call.argument_callables.get_str std::Option::Some(callables) is then
                    "late" callables.has_str = found_binding
                fi
            fi
        fi
    done
    "fallback binding uses declared variable" found_binding test::assert_true
}

fn assert_scoped_binding_type fact:$common::BindingFact {
    if fact common::BindingFact::Definition(binding) is then
        if "value" binding.name.as_str == then
            binding.name common::make_i64_type binding.typ.eq test::assert_true
        else
            "$i64" common::parse_type_str = expected
            binding.name expected binding.typ.eq test::assert_true
        fi
    fi
    "binding has a storage identity" fact.get_name fact.get_storage_name != test::assert_true
}

pub fn test_checked_scoped_binding_types {
    "checked_scoped_binding_types" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "import \"lib/std.casa\" as std enum Choice { Item (i64) } fn root { 1 Choice::Item match Choice::Item(value) => { value drop } end for item in [1, 2].iter do item drop done }"
    helpers::parse_resolve_test_source = parsed
    diagnostics "source resolves" helpers::assert_no_errors
    "root" parsed
        .store
        .get_function
        .unwrap = function
    parsed.source_bodies parsed.store function semantics::analyze_declared_function_semantics = analysis
    analysis.diagnostics "source checks" helpers::assert_no_errors
    0 = found: u64
    0 = definitions: u64
    for operation in analysis.operations.iter do
        if operation.bindings.is_none then
            continue
        fi
        operation
            .bindings
            .clone
            .unwrap = facts
        for binding in facts.iter do
            if "value" binding.get_name.as_str != "item" binding.get_name.as_str != && then
                continue
            fi
            binding assert_scoped_binding_type
            if binding common::BindingFact::Definition(_) is then
                1 += definitions
            fi
            1 += found
        done
    done
    "typed binding definitions" 2 definitions test::assert_eq
    "checked binding definitions and uses" 4 found test::assert_eq
}

pub fn test_semantics_snapshot_isolated_from_source_store {
    "semantics_snapshot_isolated_from_source_store" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "fn root -> i64 { 1 }" helpers::parse_resolve_test_source = parsed
    diagnostics "source parses" helpers::assert_no_errors
    parsed.store.next_op_id = source_next_op_id
    "root" parsed
        .store
        .get_function
        .unwrap = root
    parsed.source_bodies parsed.store semantics::SemanticSession::new = semantic_session
    diagnostics "root" semantic_session.check_declared_function
    diagnostics "root" semantic_session.check_declared_function
    diagnostics "repeated checking uses completed work" helpers::assert_no_errors
    "source literal has no checked hint" 0 "root" parsed
        .source_bodies
        .get_str
        .unwrap
        .lower_operations
        .get
        .type_hint
        .is_none test::assert_true
    "source operation counter is unchanged" source_next_op_id parsed.store.next_op_id test::assert_eq
    "snapshot contains checked literal" 0 "root" semantic_session
        .find_checked_body
        .unwrap
        .lower_operations
        .get
        .type_hint
        .is_some test::assert_true
}

pub fn test_semantics_snapshot_preserves_source_names {
    "semantics_snapshot_preserves_source_names" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "struct internal__Item { value: i64 } struct internal__Box[T] { value: T } fn internal__take value:internal__Box[internal__Item] { } fn root value:$internal__Box[internal__Item] { value internal__take }"
    helpers::parse_resolve_test_source = parsed
    diagnostics "source parses" helpers::assert_no_errors
    common::symbol_store_new = semantic_store
    for
        function_name in parsed
            .store
            .get_function_names
            .iter
    do
        function_name.as_str parsed
            .store
            .get_function
            .unwrap
            .clone semantic_store.set_function
    done
    std::Map[std::String common::SourceBinding]::new = names
    true "internal__".to_str common::SourceBinding "alias".to_str names.set
    "test" names semantic_store.record_source_names
    "internal__Box[internal__Item]" common::parse_type_str = internal_type
    "test" internal_type semantic_store.format_type_for_source = source_type
    "source store has imported name" "alias::Box[alias::Item]" source_type.as_str
    test::assert_str_eq
    "root" semantic_store.get_function.unwrap = root
    parsed.source_bodies semantic_store root semantics::analyze_function_semantics = analysis
    analysis.diagnostics "source-facing operation and parameter"
    "consuming parameter `value` of `alias::take`" helpers::assert_error_contains
    analysis.diagnostics "source-facing owned type" "owned value: alias::Box[alias::Item]"
    helpers::assert_error_contains
    analysis.diagnostics "source-facing borrowed type" "shared access: $alias::Box[alias::Item]"
    helpers::assert_error_contains
    analysis.diagnostics "internal type is hidden" "internal__Box"
    helpers::assert_error_not_contains
}
