import "std" as std
import "../../lib/test.casa" as test

pub struct Point derives std::Eq std::Ord std::Hashable std::Clone {
    pub x: i64
    pub y: i64
}

pub enum Tree derives std::Eq std::Ord std::Hashable std::Clone {
    Leaf (i64)
    Branch (Tree Tree)
}

pub enum Left derives std::Eq std::Ord std::Hashable std::Clone {
    End
    Next (Right)
}

pub enum Right derives std::Eq std::Ord std::Hashable std::Clone {
    End
    Next (Left)
}

pub struct Box[T] derives std::Eq std::Ord std::Hashable std::Clone {
    pub value: T
}

pub struct Resource {
    pub value: std::String
}

pub struct BorrowBox[T] derives std::Clone {
    pub value: $T
}

pub enum BorrowChoice[T] derives std::Clone {
    None
    Some ($T)
}

pub struct ModTen derives std::Eq std::Ord std::Hashable {
    pub value: i64
}

impl ModTen: std::PartialEq {
    pub fn eq self:$ModTen other:$ModTen -> bool { other.value 10 % self.value 10 % == }
}

impl ModTen: std::Ord {
    pub fn cmp self:$ModTen other:$ModTen -> std::Ordering { other.value 10 % self.value 10 %.cmp }
}

impl ModTen: std::Hashable {
    pub fn hash self:$ModTen -> i64 { self.value 10 % std::int_hash }
}

pub struct Shift derives std::Clone {
    pub value: i64
}

impl Shift: std::Clone {
    pub fn clone self:$Shift -> Shift { self.value 1 + Shift }
}

pub struct Key derives std::Ord std::Hashable {
    pub value: i64
}

pub struct QualifiedEqField {
    pub value: i64
}

impl QualifiedEqField {
    pub fn eq self:$QualifiedEqField other:$QualifiedEqField -> bool { false }
}

impl QualifiedEqField: std::PartialEq {
    pub fn eq self:$QualifiedEqField other:$QualifiedEqField -> bool { other.value self.value == }
}

impl QualifiedEqField: std::Eq { }

pub struct QualifiedEqBox derives std::Eq {
    pub value: QualifiedEqField
}

pub struct OperatorDispatch derives std::Eq std::Ord {
    pub value: i64
}

impl OperatorDispatch {
    pub fn eq self:$OperatorDispatch other:$OperatorDispatch -> bool { false }
    pub fn lt self:$OperatorDispatch other:$OperatorDispatch -> bool { false }
}

pub struct DifferentEffectDispatch derives std::Eq {
    pub value: i64
}

impl DifferentEffectDispatch {
    pub fn eq self:$DifferentEffectDispatch -> i64 { self.value }
}

pub enum CustomCopy derives std::Copy {
    Zero
    One
}

impl CustomCopy: std::Clone {
    pub fn clone self:$CustomCopy -> CustomCopy { self drop CustomCopy::One }
}

impl Key: std::Ord {
    pub fn cmp self:$Key other:$Key -> std::Ordering { self.value other.value.cmp }
}

impl Key: std::Hashable {
    pub fn hash self:$Key -> i64 { self.value 1 + std::int_hash }
}

pub struct CloneTrace {
    pub value: i64
    pub log:   ptr
    pub index: ptr
}

impl CloneTrace: std::Clone {
    pub fn clone self:$CloneTrace -> CloneTrace {
        unsafe { self.value (u64) self.log self.index load64 8 * + store64 }
        unsafe { self.index load64 1 + self.index store64 }
        CloneTrace { value: self.value log: self.log index: self.index }
    }
}

pub struct CloneTracePair derives std::Clone {
    pub first:  CloneTrace
    pub second: CloneTrace
}

pub enum CloneTraceChoice derives std::Clone {
    Pair (CloneTrace CloneTrace)
    Mixed (CloneTrace i64)
}

pub fn make_clone_trace value:i64 log:ptr index:ptr -> CloneTrace {
    CloneTrace { value: value log: log index: index }
}

pub fn assert_clone_trace expected:i64 position:u64 log:ptr {
    unsafe { log position 8 * + load64 (i64) = actual }
    f"clone order expected {expected}, got {actual}" expected actual test::assert_eq
}

pub fn test_struct_derivation {
    "struct_derivation" test::test_start
    Point { x: 1 y: 2 } = first
    Point { x: 1 y: 2 } = equal
    Point { x: 1 y: 3 } = later
    "field equality" equal first == test::assert_true
    "lexicographic ordering" later first.cmp std::Ordering::Less == test::assert_true
    "equal hashes" equal.hash first.hash == test::assert_true
    "field order affects hash" Point { x: 2 y: 1 }.hash first.hash != test::assert_true
    "clone reconstructs fields" 2 first.clone.y test::assert_eq
}

pub fn test_recursive_enum_derivation {
    "recursive_enum_derivation" test::test_start
    1 Tree::Leaf = leaf
    leaf.clone leaf.clone Tree::Branch = branch
    branch.clone = cloned
    "recursive equality" cloned branch == test::assert_true
    "recursive inequality" 2 Tree::Leaf leaf.clone Tree::Branch branch != test::assert_true
    "variant ordering" branch leaf.cmp std::Ordering::Less == test::assert_true
    "payload ordering" 2 Tree::Leaf 1 Tree::Leaf.cmp std::Ordering::Less == test::assert_true
    "recursive ordering" cloned branch.cmp std::Ordering::Equal == test::assert_true
    "recursive hash" cloned.hash branch.hash == test::assert_true
}

pub fn test_mutual_and_deep_recursion {
    "mutual_and_deep_recursion" test::test_start
    Left::End Right::Next Left::Next = left
    left.clone = left_clone
    "mutual recursive equality" left_clone left == test::assert_true
    "mutual recursive hash" left_clone.hash left.hash == test::assert_true

    0 Tree::Leaf = node
    0 = index
    while 128 index > do
        node index Tree::Leaf Tree::Branch = node
        1 += index
    done
    node.clone = node_clone
    "deep recursive equality" node_clone node == test::assert_true
    "deep recursive ordering" node_clone node.cmp std::Ordering::Equal == test::assert_true
    "deep recursive hash" node_clone.hash node.hash == test::assert_true

    1 Tree::Leaf = unequal_node
    0 = index
    while 128 index > do
        unequal_node index Tree::Leaf Tree::Branch = unequal_node
        1 += index
    done
    "unequal deep leaf" unequal_node node != test::assert_true
}

pub fn test_generic_derivation {
    "generic_derivation" test::test_start
    7 Box = box
    "generic equality" 7 Box box == test::assert_true
    "generic inequality" 8 Box box != test::assert_true
    "generic operator ordering" 8 Box box < test::assert_true
    "generic ordering" 8 Box box.cmp std::Ordering::Less == test::assert_true
    "generic hash" 7 Box.hash box.hash == test::assert_true
    "generic clone" 7 box.clone.value test::assert_eq
}

pub fn test_borrowed_generic_clone {
    "borrowed_generic_clone" test::test_start
    "value".to_str Resource = resource
    resource BorrowBox = box
    box.clone = cloned_box
    "borrowed struct field" "value" cloned_box
        .value
        .value
        .as_str str::eq test::assert_true

    resource BorrowChoice::Some.clone match
        BorrowChoice::None => "expected borrowed payload" false test::assert_true
        BorrowChoice::Some(value) => {
            "borrowed enum payload" "value" value.value.as_str str::eq test::assert_true
        }
    end
}

pub fn test_explicit_overrides {
    "explicit_overrides" test::test_start
    12 ModTen = first
    2 ModTen = equal
    "custom equality" equal first == test::assert_true
    "custom inequality default" 3 ModTen first.ne test::assert_true
    "custom comparison" equal first.cmp std::Ordering::Equal == test::assert_true
    "custom partial comparison default" 13 ModTen first.partial_cmp.unwrap std::Ordering::Less == test::assert_true
    "custom less-than default" 13 ModTen first.lt test::assert_true
    "custom less-or-equal default" 2 ModTen first.le test::assert_true
    "custom greater-than default" 1 ModTen first.gt test::assert_true
    "custom greater-or-equal default" 2 ModTen first.ge test::assert_true
    "custom hash" equal.hash first.hash == test::assert_true
    "custom clone" 5 4 Shift.clone.value test::assert_eq
    1 Key = key
    "missing equality fallback" 1 Key key == test::assert_true
    "custom ordering with generated equality" 2 Key key.cmp std::Ordering::Greater == test::assert_true
    QualifiedEqField { value: 4 } QualifiedEqBox = qualified
    "generated equality uses PartialEq" QualifiedEqField { value: 4 } QualifiedEqBox qualified == test::assert_true
    "equality operator uses PartialEq" OperatorDispatch { value: 1 } OperatorDispatch { value: 1 } == test::assert_true
    "ordering operator uses PartialOrd" OperatorDispatch { value: 2 } OperatorDispatch { value: 1 } < test::assert_true
    "unrelated inherent equality method is ignored" DifferentEffectDispatch { value: 1 } DifferentEffectDispatch { value: 1 } == test::assert_true
    "Copy preserves explicit Clone" CustomCopy::Zero.clone CustomCopy::One is test::assert_true
}

pub fn test_clone_uses_declaration_order {
    "clone_uses_declaration_order" test::test_start
    unsafe { 16 alloc = log }
    unsafe { 8 alloc = index }

    unsafe { 0 index store64 }
    index log 1 make_clone_trace = first
    index log 2 make_clone_trace = second
    CloneTracePair { first: first second: second }.clone drop
    log 0 1 assert_clone_trace
    log 1 2 assert_clone_trace

    unsafe { 0 index store64 }
    index log 3 make_clone_trace = third
    index log 4 make_clone_trace = fourth
    fourth third CloneTraceChoice::Pair.clone drop
    log 0 3 assert_clone_trace
    log 1 4 assert_clone_trace

    unsafe { 0 index store64 }
    index log 5 make_clone_trace = fifth
    9 fifth CloneTraceChoice::Mixed.clone match
        CloneTraceChoice::Mixed(cloned number) => {
            "heterogeneous payload clone" 5 cloned.value test::assert_eq
            "heterogeneous payload value" 9 number test::assert_eq
        }
        _ => "expected heterogeneous payloads" false test::assert_true
    end
    log 0 5 assert_clone_trace

    unsafe { log free index free }
}
test_struct_derivation
test_recursive_enum_derivation
test_mutual_and_deep_recursion
test_generic_derivation
test_borrowed_generic_clone
test_explicit_overrides
test_clone_uses_declaration_order
test::test_summary
