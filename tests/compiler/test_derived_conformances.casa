import "std" as std
import "../../lib/test.casa" as test

pub struct Point derives std::Eq std::Ord std::Hashable std::Clone {
    pub x: i64
    pub y: i64
}

pub enum Tree derives std::Eq std::Ord std::Hashable std::Clone {
    Leaf (i64)
    Branch (Tree Tree)
}

pub enum Left derives std::Eq std::Ord std::Hashable std::Clone {
    End
    Next (Right)
}

pub enum Right derives std::Eq std::Ord std::Hashable std::Clone {
    End
    Next (Left)
}

pub struct Box[T] derives std::Eq std::Ord std::Hashable std::Clone {
    pub value: T
}

pub struct Resource {
    pub value: std::String
}

pub struct BorrowBox[T] derives std::Clone {
    pub value: $T
}

pub enum BorrowChoice[T] derives std::Clone {
    None
    Some ($T)
}

pub struct ModTen derives std::Eq std::Ord std::Hashable {
    pub value: i64
}

impl ModTen: std::PartialEq {
    pub fn eq self:$ModTen other:$ModTen -> bool { other.value 10 % self.value 10 % == }
}

impl ModTen: std::Ord {
    pub fn cmp self:$ModTen other:$ModTen -> std::Ordering { other.value 10 % self.value 10 %.cmp }
}

impl ModTen: std::Hashable {
    pub fn hash self:$ModTen -> i64 { self.value 10 % std::int_hash }
}

pub struct Shift derives std::Clone {
    pub value: i64
}

impl Shift: std::Clone {
    pub fn clone self:$Shift -> Shift { self.value 1 + Shift }
}

pub struct Key derives std::Ord std::Hashable {
    pub value: i64
}

impl Key: std::Ord {
    pub fn cmp self:$Key other:$Key -> std::Ordering { self.value other.value.cmp }
}

impl Key: std::Hashable {
    pub fn hash self:$Key -> i64 { self.value 1 + std::int_hash }
}

pub fn test_struct_derivation {
    "struct_derivation" test::test_start
    Point { x: 1 y: 2 } = first
    Point { x: 1 y: 2 } = equal
    Point { x: 1 y: 3 } = later
    "field equality" equal first == test::assert_true
    "lexicographic ordering" later first.cmp std::Ordering::Less == test::assert_true
    "equal hashes" equal.hash first.hash == test::assert_true
    "field order affects hash" Point { x: 2 y: 1 }.hash first.hash != test::assert_true
    "clone reconstructs fields" 2 first.clone.y test::assert_eq
}

pub fn test_recursive_enum_derivation {
    "recursive_enum_derivation" test::test_start
    1 Tree::Leaf = leaf
    leaf.clone leaf.clone Tree::Branch = branch
    branch.clone = cloned
    "recursive equality" cloned branch == test::assert_true
    "recursive inequality" 2 Tree::Leaf leaf.clone Tree::Branch branch != test::assert_true
    "variant ordering" branch leaf.cmp std::Ordering::Less == test::assert_true
    "payload ordering" 2 Tree::Leaf 1 Tree::Leaf.cmp std::Ordering::Less == test::assert_true
    "recursive ordering" cloned branch.cmp std::Ordering::Equal == test::assert_true
    "recursive hash" cloned.hash branch.hash == test::assert_true
}

pub fn test_mutual_and_deep_recursion {
    "mutual_and_deep_recursion" test::test_start
    Left::End Right::Next Left::Next = left
    left.clone = left_clone
    "mutual recursive equality" left_clone left == test::assert_true
    "mutual recursive hash" left_clone.hash left.hash == test::assert_true

    0 Tree::Leaf = node
    0 = index
    while 128 index > do
        node index Tree::Leaf Tree::Branch = node
        1 += index
    done
    node.clone = node_clone
    "deep recursive equality" node_clone node == test::assert_true
    "deep recursive ordering" node_clone node.cmp std::Ordering::Equal == test::assert_true
    "deep recursive hash" node_clone.hash node.hash == test::assert_true
}

pub fn test_generic_derivation {
    "generic_derivation" test::test_start
    7 Box = box
    "generic equality" 7 Box box == test::assert_true
    "generic inequality" 8 Box box != test::assert_true
    "generic operator ordering" 8 Box box < test::assert_true
    "generic ordering" 8 Box box.cmp std::Ordering::Less == test::assert_true
    "generic hash" 7 Box.hash box.hash == test::assert_true
    "generic clone" 7 box.clone.value test::assert_eq
}

pub fn test_borrowed_generic_clone {
    "borrowed_generic_clone" test::test_start
    "value".to_str Resource = resource
    resource BorrowBox = box
    box.clone = cloned_box
    "borrowed struct field" "value" cloned_box
        .value
        .value
        .as_str str::eq test::assert_true

    resource BorrowChoice::Some.clone match
        BorrowChoice::None => "expected borrowed payload" false test::assert_true
        BorrowChoice::Some(value) => {
            "borrowed enum payload" "value" value.value.as_str str::eq test::assert_true
        }
    end
}

pub fn test_explicit_overrides {
    "explicit_overrides" test::test_start
    12 ModTen = first
    2 ModTen = equal
    "custom equality" equal first == test::assert_true
    "custom comparison" equal first.cmp std::Ordering::Equal == test::assert_true
    "custom hash" equal.hash first.hash == test::assert_true
    "custom clone" 5 4 Shift.clone.value test::assert_eq
    1 Key = key
    "missing equality fallback" 1 Key key == test::assert_true
    "custom ordering with generated equality" 2 Key key.cmp std::Ordering::Greater == test::assert_true
}
test_struct_derivation
test_recursive_enum_derivation
test_mutual_and_deep_recursion
test_generic_derivation
test_borrowed_generic_clone
test_explicit_overrides
test::test_summary
