import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

# ============================================================================
# Helper: lex + parse + resolve + typecheck a source string
# ============================================================================

pub fn tc_mu code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

# ============================================================================
# Cycle 1: top-level `match` with no subject on the stack errors
# ============================================================================

pub fn test_top_level_match_without_subject_errors {
    error::Diagnostics::new = diagnostics
    "top_level_match_without_subject_errors" test::test_start
    diagnostics "match 1 => \"a\" _ => \"b\" end drop\n" tc_mu drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "stack underflow kind" common::ErrorKind::StackUnderflow helpers::assert_error_kind
}

# ============================================================================
# Cycle 2: error message names the `match` construct
# ============================================================================

pub fn test_match_underflow_message_names_construct {
    error::Diagnostics::new = diagnostics
    "match_underflow_message_names_construct" test::test_start
    diagnostics "match 1 => \"a\" _ => \"b\" end drop\n" tc_mu drop
    diagnostics "mentions match" "`match` requires" helpers::assert_error_contains
}

# ============================================================================
# Cycle 3: `match` inside a function body with empty stack errors
# ============================================================================

pub fn test_match_without_subject_in_declared_fn_body_errors {
    error::Diagnostics::new = diagnostics
    "match_without_subject_in_declared_fn_body_errors" test::test_start
    diagnostics "fn f -> i64 { match 1 => 1 _ => 2 end }\nf drop\n" tc_mu drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "stack underflow kind" common::ErrorKind::StackUnderflow helpers::assert_error_kind
}

# ============================================================================
# Lambda still infers from caller-pushed values; non-lambda functions never do.
# ============================================================================

pub fn test_lambda_match_subject_inferred {
    error::Diagnostics::new = diagnostics
    "lambda_match_subject_inferred" test::test_start
    diagnostics "42 { match 1 => \"a\" _ => \"b\" end drop } exec\n" tc_mu drop
    diagnostics "no errors" helpers::assert_no_errors
}

pub fn test_undeclared_fn_match_subject_errors {
    error::Diagnostics::new = diagnostics
    "undeclared_fn_match_subject_errors" test::test_start
    diagnostics "fn f { match 1 => 1 _ => 2 end drop }\n42 f\n" tc_mu drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "stack underflow kind" common::ErrorKind::StackUnderflow helpers::assert_error_kind
}

# ============================================================================
# Cycle 4: well-formed match still typechecks cleanly (regression guard)
# ============================================================================

pub fn test_well_formed_match_still_passes {
    error::Diagnostics::new = diagnostics
    "well_formed_match_still_passes" test::test_start
    diagnostics "1 match 1 => \"a\" _ => \"b\" end drop\n" tc_mu drop
    diagnostics "no errors" helpers::assert_no_errors
}

# ============================================================================
# Run all tests
# ============================================================================
test_top_level_match_without_subject_errors
test_match_underflow_message_names_construct
test_match_without_subject_in_declared_fn_body_errors
test_lambda_match_subject_inferred
test_undeclared_fn_match_subject_errors
test_well_formed_match_still_passes
test::test_summary
