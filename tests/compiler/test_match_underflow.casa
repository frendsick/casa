import "../../compiler/typechecker.casa"
import "helpers.casa"

# ============================================================================
# Helper: lex + parse + resolve + typecheck a source string
# ============================================================================

fn tc_mu code:str diagnostics:Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option::None(Option[Function]) ops type_check_ops_for_test
}

# ============================================================================
# Cycle 1: top-level `match` with no subject on the stack errors
# ============================================================================

fn test_top_level_match_without_subject_errors {
    Diagnostics::new = diagnostics
    "top_level_match_without_subject_errors" test_start
    diagnostics "match 1 => \"a\" _ => \"b\" end drop\n" tc_mu drop
    diagnostics "has errors" assert_has_errors
    diagnostics "stack underflow kind" ErrorKind::StackUnderflow assert_error_kind
}

# ============================================================================
# Cycle 2: error message names the `match` construct
# ============================================================================

fn test_match_underflow_message_names_construct {
    Diagnostics::new = diagnostics
    "match_underflow_message_names_construct" test_start
    diagnostics "match 1 => \"a\" _ => \"b\" end drop\n" tc_mu drop
    diagnostics "mentions match" "`match` requires" assert_error_contains
}

# ============================================================================
# Cycle 3: `match` inside a function body with empty stack errors
# ============================================================================

fn test_match_without_subject_in_declared_fn_body_errors {
    Diagnostics::new = diagnostics
    "match_without_subject_in_declared_fn_body_errors" test_start
    diagnostics "fn f -> int { match 1 => 1 _ => 2 end }\nf drop\n" tc_mu drop
    diagnostics "has errors" assert_has_errors
    diagnostics "stack underflow kind" ErrorKind::StackUnderflow assert_error_kind
}

# ============================================================================
# Lambda still infers from caller-pushed values; non-lambda functions never do.
# ============================================================================

fn test_lambda_match_subject_inferred {
    Diagnostics::new = diagnostics
    "lambda_match_subject_inferred" test_start
    diagnostics "42 { match 1 => \"a\" _ => \"b\" end drop } exec\n" tc_mu drop
    diagnostics "no errors" assert_no_errors
}

fn test_undeclared_fn_match_subject_errors {
    Diagnostics::new = diagnostics
    "undeclared_fn_match_subject_errors" test_start
    diagnostics "fn f { match 1 => 1 _ => 2 end drop }\n42 f\n" tc_mu drop
    diagnostics "has errors" assert_has_errors
    diagnostics "stack underflow kind" ErrorKind::StackUnderflow assert_error_kind
}

# ============================================================================
# Cycle 4: well-formed match still typechecks cleanly (regression guard)
# ============================================================================

fn test_well_formed_match_still_passes {
    Diagnostics::new = diagnostics
    "well_formed_match_still_passes" test_start
    diagnostics "1 match 1 => \"a\" _ => \"b\" end drop\n" tc_mu drop
    diagnostics "no errors" assert_no_errors
}

# ============================================================================
# Run all tests
# ============================================================================
test_top_level_match_without_subject_errors
test_match_underflow_message_names_construct
test_match_without_subject_in_declared_fn_body_errors
test_lambda_match_subject_inferred
test_undeclared_fn_match_subject_errors
test_well_formed_match_still_passes
test_summary
