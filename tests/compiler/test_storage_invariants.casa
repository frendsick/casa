import "std"
import "../../lib/io.casa" as io
import "../../lib/test.casa" as test
import "../../lib/timer.casa" as timer

"raw buffer ownership transfer" test::test_start
8 std::RawBuffer::new = first
16 std::RawBuffer::new = second
unsafe {
    17 first.data store64
    29 second.data store64
}
second first.swap_with
unsafe {
    "first owns second storage" 29 first.data load64 test::assert_eq
    "second owns first storage" 17 second.data load64 test::assert_eq
}
first.into_raw = address
16 std::RawBuffer::new = guard
"transferred storage remains allocated" address guard.data != test::assert_true
unsafe { 53 guard.data store64 }
unsafe { address std::RawBuffer::from_raw } = adopted
unsafe { "adoption preserves bytes" 29 adopted.data load64 test::assert_eq }
adopted drop
second drop
unsafe { ptr::null std::RawBuffer::from_raw } drop
"checked collection access" test::test_start
std::List[std::String]::new = values
"one".to_str values.push
"two".to_str values.push
"three".to_str values.push
"list length" 3 values.length test::assert_eq
"replace returns previous owner" "two" "new".to_str 1 values.replace test::assert_str_eq
"remove returns owner" "one" 0 values.remove.unwrap test::assert_str_eq
"remaining value" "new" 0 values.get test::assert_str_eq
std::Map[std::String std::String]::new = map
"value".to_str "key".to_str map.set
"map lookup" "value" "key" map.get_str.unwrap test::assert_str_eq
"map removal" "value" "key" map.remove_str.unwrap test::assert_str_eq
"map is empty" map.is_empty test::assert_true
"explicit raw access" test::test_start
[41] std::List::from_array = numbers
unsafe { "list pointer" 41 numbers.as_ptr ptr::as_ref[i64] test::assert_eq }
std::Map[i64 i64]::new = empty_map
unsafe {
    8 alloc = key
    31 key store64
    "raw key borrow" 31 key empty_map.entry_key test::assert_eq
    "raw value borrow" 31 key empty_map.entry_value test::assert_eq
    key free
}
io::StdinReader::new = reader
"reader starts empty" reader.has_buffered_input ! test::assert_true
"reader owns buffer" reader.buffer.data ptr::null != test::assert_true
"shared timer queries" test::test_start
timer::Timer::new = timer
timer.elapsed_ns = first_elapsed
timer.elapsed_ns = second_elapsed
"elapsed time advances" first_elapsed second_elapsed <= test::assert_true
test::test_summary
