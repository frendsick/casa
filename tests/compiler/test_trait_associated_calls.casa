import "std" as std
import "../../lib/test.casa" as test

struct Source {
    number: i64
}

struct Destination {
    number: i64
}

struct Holder[T] {
    value: T
}

enum Choice {
    Number(i64)
}

trait Make {
    fn make value:$Source -> self
}

impl Source: Make {
    fn make value:$Source -> Source { value.number 100 + Source }
}

impl i64: Make {
    fn make value:$Source -> i64 { value.number }
}

impl bool: Make {
    fn make value:$Source -> bool { value.number 5 == }
}

impl Destination: Make {
    fn make value:$Source -> Destination { value.number 1 + Destination }
}

impl Holder[i64]: Make {
    fn make value:$Source -> Holder[i64] { value.number Holder }
}

impl Choice: Make {
    fn make value:$Source -> Choice { value.number Choice::Number }
}

trait Take {
    fn take value:Source -> self
}

impl Source: Take {
    fn take value:Source -> Source { value.number 100 + Source }
}

impl i64: Take {
    fn take value:Source -> i64 { value.number }
}

fn build[T:Make] value:$Source -> T { value T::make }

fn build_reference[T:Make] value:$Source -> T { value &T::make exec }

fn forward[T:Make] value:$Source -> T { value &build[T] exec }

fn consume[T:Take] value:Source -> T { value T::take }

"associated trait calls" test::test_start
5 Source = source
"primitive destination" 5 source &build[i64] exec test::assert_eq
"direct and referenced dispatch agree"
source &build_reference[i64] exec source &build[i64] exec test::assert_eq
"boolean destination" source &build[bool] exec test::assert_true
"struct destination" 6 source &build[Destination] exec.number test::assert_eq
"generic struct destination" 5 source &build[Holder[i64]] exec.value test::assert_eq
"source destination" 105 source &build[Source] exec.number test::assert_eq
"forwarded type parameter" 5 source &forward[i64] exec test::assert_eq
if source &build[Choice] exec Choice::Number(number) is then
    "enum destination" 5 number test::assert_eq
else
    "number variant expected" false test::assert_true
fi
"owned source argument" 5 5 Source &consume[i64] exec test::assert_eq
"borrowed source remains available" 5 source.number test::assert_eq
test::test_summary
