import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

pub fn test_parse_parts_without_source {
    "parse_parts_without_source" test::test_start
    "fn f x:bool { if x then return else return elif x then fi }" = source
    error::Diagnostics::new = diagnostics
    diagnostics source helpers::parse_resolve_test_source = parsed
    "syntax error leaves no operations" parsed.ops.is_none test::assert_true
    error::Diagnostics::new = parts_diagnostics
    parts_diagnostics source helpers::parse_resolve_test_parts = bodies = store = operations
    "no operations for rejected source" operations.is_empty test::assert_true
    "no function bodies for rejected source" bodies.is_empty test::assert_true
    "no declarations for rejected source" store.get_function_names.is_empty test::assert_true
    parts_diagnostics "syntax error retained" common::ErrorKind::Syntax helpers::assert_error_kind
    parts_diagnostics "original error retained" "Unexpected token in expression" helpers::assert_error_contains
    "parse diagnostics retained once" diagnostics.error_count parts_diagnostics.error_count test::assert_eq
}

pub fn test_typecheck_without_source {
    "typecheck_without_source" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "fn f x:bool { if x then return else return elif x then fi }"
    helpers::typecheck_test_source = checked
    diagnostics "syntax error returned to caller" common::ErrorKind::Syntax helpers::assert_error_kind
    checked.get_diagnostics "syntax error retained in result" common::ErrorKind::Syntax helpers::assert_error_kind
    checked.get_diagnostics "original error retained" "Unexpected token in expression" helpers::assert_error_contains
    "diagnostics retained once" diagnostics.error_count checked.get_diagnostics.error_count test::assert_eq
    "invalid source cannot produce a checked program" checked.into_checked_program std::Result::Error is test::assert_true
}

pub fn test_typecheck_helper_preserves_checking {
    "typecheck_helper_preserves_checking" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "42 print" helpers::typecheck_test_source = checked
    diagnostics "valid parse succeeds" helpers::assert_no_errors
    checked.get_diagnostics "valid source checks" helpers::assert_no_errors
    "checked operations retained" 2 checked
        .get_root
        .lower_operations
        .length test::assert_eq
    error::Diagnostics::new = invalid_diagnostics
    invalid_diagnostics "true 1 +" helpers::typecheck_test_source = invalid
    invalid.get_diagnostics "semantic errors retained" helpers::assert_has_errors
    invalid_diagnostics "semantic errors remain in the result" helpers::assert_no_errors
}

pub fn run_tests {
    test_parse_parts_without_source
    test_typecheck_without_source
    test_typecheck_helper_preserves_checking
    test::test_summary
}
run_tests
