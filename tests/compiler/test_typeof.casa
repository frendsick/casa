import "../../compiler/typechecker.casa"
import "../../compiler/bytecode.casa"
import "../../compiler/emitter.casa"
import "helpers.casa"

# ============================================================================
# Helpers
# ============================================================================

fn tc_typeof code:$str diagnostics:mut$Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops type_check_ops_for_test
}

fn compile_typeof code:$str diagnostics:mut$Diagnostics -> Program {
    diagnostics code parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops type_check_ops_for_test drop
    store ops compile_test_program
}

fn emit_typeof code:$str diagnostics:mut$Diagnostics -> String {
    diagnostics code compile_typeof emit
}

fn assert_contains needle:$str haystack:$String msg:$str {
    haystack.as_str needle str::find = pos
    if 0 pos < then
        msg false assert_true
    else
        msg true assert_true
    fi
}

fn has_inst_kind bytecode:$List[InstValue] predicate:fn[$InstValue -> bool] -> bool {
    false = found
    0 (u64) = index
    while index bytecode.length > do
        if index bytecode.get predicate exec then
            true = found
        fi
        1 += index
    done
    found
}

fn is_drop_inst value:$InstValue -> bool { value InstValue::Drop is }

fn is_push_str_inst value:$InstValue -> bool { value InstValue::PushStr is }

fn is_print_str_inst value:$InstValue -> bool { value InstValue::PrintStr is }

fn string_table_contains table:$List[String] needle:$str -> bool {
    false = found
    0 (u64) = index
    while index table.length > do
        if needle index table.get == then
            true = found
        fi
        1 += index
    done
    found
}

# ============================================================================
# Lexer tests
# ============================================================================

fn test_lex_typeof {
    "lex_typeof" test_start
    "test" "typeof" lex_source = lex_result
    lex_result.tokens = tokens: $List[Token]
    "typeof kind" TokenKind::Intrinsic 0 tokens.get Token::kind == assert_true
    "typeof value" "typeof" 0 tokens.get Token::value.as_str assert_str_eq
}

# ============================================================================
# Parser tests
# ============================================================================

fn test_parse_typeof {
    "parse_typeof" test_start
    Diagnostics::new = diagnostics
    diagnostics "42 typeof" parse_resolve_test_parts = store = ops
    store drop
    "typeof kind" 1 ops.get.value OpValue::Typeof is assert_true
}

# ============================================================================
# Typechecker tests
# ============================================================================

fn test_typecheck_typeof_returns_str_for_int {
    Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_int" test_start
    diagnostics "42 typeof" tc_typeof = sig
    "one return" 1 sig StackEffect::return_types.length assert_eq
    "returns str" "str" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_typecheck_typeof_returns_str_for_bool {
    Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_bool" test_start
    diagnostics "true typeof" tc_typeof = sig
    "returns str" "str" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_typecheck_typeof_returns_str_for_str {
    Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_str" test_start
    diagnostics "\"hello\" typeof" tc_typeof = sig
    "returns str" "str" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_typecheck_typeof_returns_str_for_char {
    Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_char" test_start
    diagnostics "'a' typeof" tc_typeof = sig
    "returns str" "str" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_typecheck_typeof_no_params {
    Diagnostics::new = diagnostics
    "typecheck_typeof_no_params" test_start
    diagnostics "42 typeof" tc_typeof = sig
    "no params" 0 sig StackEffect::parameters.length assert_eq
}

fn test_typecheck_typeof_chained {
    Diagnostics::new = diagnostics
    "typecheck_typeof_chained" test_start
    diagnostics "42 typeof drop true typeof" tc_typeof = sig
    "one return" 1 sig StackEffect::return_types.length assert_eq
    "returns str" "str" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_typecheck_typeof_ptr {
    Diagnostics::new = diagnostics
    "typecheck_typeof_ptr" test_start
    diagnostics "10 alloc typeof" tc_typeof = sig
    "returns str" "str" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_typecheck_typeof_array {
    Diagnostics::new = diagnostics
    "typecheck_typeof_array" test_start
    diagnostics "[1, 2, 3] typeof" tc_typeof = sig
    "one return" 1 sig StackEffect::return_types.length assert_eq
    "returns str" "str" 0 sig StackEffect::return_types.get.format assert_str_eq
}

# ============================================================================
# Bytecode tests
# ============================================================================

fn test_bytecode_typeof_int {
    Diagnostics::new = diagnostics
    "bytecode_typeof_int" test_start
    diagnostics "42 typeof" compile_typeof = prog
    "has DROP" &is_drop_inst prog Program::bytecode has_inst_kind assert_true
    "has PUSH_STR" &is_push_str_inst prog Program::bytecode has_inst_kind assert_true
    "has PRINT_STR" &is_print_str_inst prog Program::bytecode has_inst_kind assert_true
    "i64 in strings" "i64" prog Program::strings string_table_contains assert_true
}

fn test_bytecode_typeof_bool {
    Diagnostics::new = diagnostics
    "bytecode_typeof_bool" test_start
    diagnostics "true typeof" compile_typeof = prog
    "bool in strings" "bool" prog Program::strings string_table_contains assert_true
}

fn test_bytecode_typeof_str {
    Diagnostics::new = diagnostics
    "bytecode_typeof_str" test_start
    diagnostics "\"hello\" typeof" compile_typeof = prog
    "str in strings" "str" prog Program::strings string_table_contains assert_true
}

fn test_bytecode_typeof_array {
    Diagnostics::new = diagnostics
    "bytecode_typeof_array" test_start
    diagnostics "[1, 2, 3] typeof" compile_typeof = prog
    "array[i64 3] in strings" "array[i64 3]" prog Program::strings string_table_contains assert_true
}

fn test_bytecode_typeof_instruction_sequence {
    Diagnostics::new = diagnostics
    "bytecode_typeof_instruction_sequence" test_start
    diagnostics "42 typeof" compile_typeof = prog
    # Find DROP -> PUSH_STR -> PRINT_STR sequence
    false = found_seq
    0 (u64) = index
    while index prog Program::bytecode.length 2 - > do
        index prog Program::bytecode.get = inst0_value
        index 1 + prog Program::bytecode.get = inst1_value
        index 2 + prog Program::bytecode.get = inst2_value
        if
            inst0_value InstValue::Drop is
            inst1_value InstValue::PushStr is &&
            inst2_value InstValue::PrintStr is &&
        then
            true = found_seq
        fi
        1 += index
    done
    "DROP -> PUSH_STR -> PRINT_STR sequence" found_seq assert_true
}

# ============================================================================
# Emitter tests
# ============================================================================

fn test_emit_typeof_int {
    Diagnostics::new = diagnostics
    "emit_typeof_int" test_start
    diagnostics "42 typeof" emit_typeof = asm
    "has drop" asm "addq $8, %rsp" assert_contains
    "has print_str" asm "jmp print_str" assert_contains
}

fn test_emit_typeof_bool {
    Diagnostics::new = diagnostics
    "emit_typeof_bool" test_start
    diagnostics "true typeof" emit_typeof = asm
    "has print_str" asm "jmp print_str" assert_contains
}

fn test_emit_typeof_str {
    Diagnostics::new = diagnostics
    "emit_typeof_str" test_start
    diagnostics "\"hello\" typeof" emit_typeof = asm
    "has print_str" asm "jmp print_str" assert_contains
}

