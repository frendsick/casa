import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

# ============================================================================
# Helpers
# ============================================================================

pub fn tc_typeof code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

pub fn emit_typeof code:$str diagnostics:mut$error::Diagnostics -> std::String {
    diagnostics code helpers::assemble_test_source
}

pub fn assert_contains needle:$str haystack:$std::String msg:$str {
    haystack.as_str needle str::find = pos
    if 0 pos < then
        msg false test::assert_true
    else
        msg true test::assert_true
    fi
}

# ============================================================================
# Lexer tests
# ============================================================================

pub fn test_lex_typeof {
    "lex_typeof" test::test_start
    "test" "typeof" lexer::lex_source = lex_result
    lex_result.tokens = tokens: $std::List[common::Token]
    "typeof kind" common::TokenKind::Intrinsic 0 tokens.get common::Token::kind == test::assert_true
    "typeof value" "typeof" 0 tokens.get common::Token::value.as_str test::assert_str_eq
}

# ============================================================================
# Parser tests
# ============================================================================

pub fn test_parse_typeof {
    "parse_typeof" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "42 typeof" helpers::parse_resolve_test_parts = store = ops
    store drop
    "typeof kind" 1 ops.get.value common::OpValue::Typeof is test::assert_true
}

# ============================================================================
# Typechecker tests
# ============================================================================

pub fn test_typecheck_typeof_returns_str_for_int {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_int" test::test_start
    diagnostics "42 typeof" tc_typeof = sig
    "one return" 1 sig common::StackEffect::return_types.length test::assert_eq
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_returns_str_for_bool {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_bool" test::test_start
    diagnostics "true typeof" tc_typeof = sig
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_returns_str_for_str {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_str" test::test_start
    diagnostics "\"hello\" typeof" tc_typeof = sig
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_returns_str_for_char {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_char" test::test_start
    diagnostics "'a' typeof" tc_typeof = sig
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_no_params {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_no_params" test::test_start
    diagnostics "42 typeof" tc_typeof = sig
    "no params" 0 sig common::StackEffect::parameters.length test::assert_eq
}

pub fn test_typecheck_typeof_chained {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_chained" test::test_start
    diagnostics "42 typeof drop true typeof" tc_typeof = sig
    "one return" 1 sig common::StackEffect::return_types.length test::assert_eq
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_ptr {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_ptr" test::test_start
    diagnostics "10 alloc typeof" tc_typeof = sig
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_array {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_array" test::test_start
    diagnostics "[1, 2, 3] typeof" tc_typeof = sig
    "one return" 1 sig common::StackEffect::return_types.length test::assert_eq
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

# ============================================================================
# Bytecode tests
# ============================================================================
# ============================================================================
# Emitter tests
# ============================================================================

pub fn test_emit_typeof_int {
    error::Diagnostics::new = diagnostics
    "emit_typeof_int" test::test_start
    diagnostics "42 typeof print" emit_typeof = asm
    "replaces the discarded value with its type" asm
    ".asciz \"i64\"" assert_contains
    "has print_str" asm "call print_str" assert_contains
}

pub fn test_emit_typeof_bool {
    error::Diagnostics::new = diagnostics
    "emit_typeof_bool" test::test_start
    diagnostics "true typeof print" emit_typeof = asm
    "has print_str" asm "call print_str" assert_contains
}

pub fn test_emit_typeof_str {
    error::Diagnostics::new = diagnostics
    "emit_typeof_str" test::test_start
    diagnostics "\"hello\" typeof print" emit_typeof = asm
    "has print_str" asm "call print_str" assert_contains
}

# ============================================================================
# Run all tests
# ============================================================================
test_lex_typeof
test_parse_typeof
test_typecheck_typeof_returns_str_for_int
test_typecheck_typeof_returns_str_for_bool
test_typecheck_typeof_returns_str_for_str
test_typecheck_typeof_returns_str_for_char
test_typecheck_typeof_no_params
test_typecheck_typeof_chained
test_typecheck_typeof_ptr
test_typecheck_typeof_array
test_emit_typeof_int
test_emit_typeof_bool
test_emit_typeof_str
test::test_summary
