import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "../../compiler/bytecode.casa" as bytecode
import "../../compiler/emitter.casa" as emitter
import "helpers.casa" as helpers

# ============================================================================
# Helpers
# ============================================================================

pub fn tc_typeof code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

pub fn compile_typeof code:$str diagnostics:mut$error::Diagnostics -> common::Program {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test drop
    store ops helpers::compile_test_program
}

pub fn emit_typeof code:$str diagnostics:mut$error::Diagnostics -> std::String {
    diagnostics code compile_typeof emitter::emit
}

pub fn assert_contains needle:$str haystack:$std::String msg:$str {
    haystack.as_str needle str::find = pos
    if 0 pos < then
        msg false test::assert_true
    else
        msg true test::assert_true
    fi
}

pub fn has_inst_kind
    bytecode:$std::List[common::InstValue]
    predicate:fn[$common::InstValue
-> bool] -> bool {
    false = found
    0 = index: u64
    while index bytecode.length > do
        if index bytecode.get predicate exec then
            true = found
        fi
        1 += index
    done
    found
}

pub fn is_drop_inst value:$common::InstValue -> bool { value common::InstValue::Drop is }

pub fn is_push_str_inst value:$common::InstValue -> bool { value common::InstValue::PushStr is }

pub fn is_print_str_inst value:$common::InstValue -> bool { value common::InstValue::PrintStr is }

pub fn string_table_contains table:$std::List[std::String] needle:$str -> bool {
    false = found
    0 = index: u64
    while index table.length > do
        if needle index table.get == then
            true = found
        fi
        1 += index
    done
    found
}

# ============================================================================
# Lexer tests
# ============================================================================

pub fn test_lex_typeof {
    "lex_typeof" test::test_start
    "test" "typeof" lexer::lex_source = lex_result
    lex_result.tokens = tokens: $std::List[common::Token]
    "typeof kind" common::TokenKind::Intrinsic 0 tokens.get common::Token::kind == test::assert_true
    "typeof value" "typeof" 0 tokens.get common::Token::value.as_str test::assert_str_eq
}

# ============================================================================
# Parser tests
# ============================================================================

pub fn test_parse_typeof {
    "parse_typeof" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "42 typeof" helpers::parse_resolve_test_parts = store = ops
    store drop
    "typeof kind" 1 ops.get.value common::OpValue::Typeof is test::assert_true
}

# ============================================================================
# Typechecker tests
# ============================================================================

pub fn test_typecheck_typeof_returns_str_for_int {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_int" test::test_start
    diagnostics "42 typeof" tc_typeof = sig
    "one return" 1 sig common::StackEffect::return_types.length test::assert_eq
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_returns_str_for_bool {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_bool" test::test_start
    diagnostics "true typeof" tc_typeof = sig
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_returns_str_for_str {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_str" test::test_start
    diagnostics "\"hello\" typeof" tc_typeof = sig
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_returns_str_for_char {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_returns_str_for_char" test::test_start
    diagnostics "'a' typeof" tc_typeof = sig
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_no_params {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_no_params" test::test_start
    diagnostics "42 typeof" tc_typeof = sig
    "no params" 0 sig common::StackEffect::parameters.length test::assert_eq
}

pub fn test_typecheck_typeof_chained {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_chained" test::test_start
    diagnostics "42 typeof drop true typeof" tc_typeof = sig
    "one return" 1 sig common::StackEffect::return_types.length test::assert_eq
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_ptr {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_ptr" test::test_start
    diagnostics "10 alloc typeof" tc_typeof = sig
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_typeof_array {
    error::Diagnostics::new = diagnostics
    "typecheck_typeof_array" test::test_start
    diagnostics "[1, 2, 3] typeof" tc_typeof = sig
    "one return" 1 sig common::StackEffect::return_types.length test::assert_eq
    "returns str" "str" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

# ============================================================================
# Bytecode tests
# ============================================================================

pub fn test_bytecode_typeof_int {
    error::Diagnostics::new = diagnostics
    "bytecode_typeof_int" test::test_start
    diagnostics "42 typeof" compile_typeof = prog
    "has DROP" &is_drop_inst prog common::Program::bytecode has_inst_kind test::assert_true
    "has PUSH_STR" &is_push_str_inst prog common::Program::bytecode has_inst_kind test::assert_true
    "has PRINT_STR" &is_print_str_inst prog common::Program::bytecode has_inst_kind test::assert_true
    "i64 in strings" "i64" prog common::Program::strings string_table_contains test::assert_true
}

pub fn test_bytecode_typeof_bool {
    error::Diagnostics::new = diagnostics
    "bytecode_typeof_bool" test::test_start
    diagnostics "true typeof" compile_typeof = prog
    "bool in strings" "bool" prog common::Program::strings string_table_contains test::assert_true
}

pub fn test_bytecode_typeof_str {
    error::Diagnostics::new = diagnostics
    "bytecode_typeof_str" test::test_start
    diagnostics "\"hello\" typeof" compile_typeof = prog
    "str in strings" "str" prog common::Program::strings string_table_contains test::assert_true
}

pub fn test_bytecode_typeof_array {
    error::Diagnostics::new = diagnostics
    "bytecode_typeof_array" test::test_start
    diagnostics "[1, 2, 3] typeof" compile_typeof = prog
    "array[i64 3] in strings" "array[i64 3]" prog common::Program::strings string_table_contains test::assert_true
}

pub fn test_bytecode_typeof_instruction_sequence {
    error::Diagnostics::new = diagnostics
    "bytecode_typeof_instruction_sequence" test::test_start
    diagnostics "42 typeof" compile_typeof = prog
    # Find DROP -> PUSH_STR -> PRINT_STR sequence
    false = found_seq
    0 = index: u64
    while index prog common::Program::bytecode.length 2 - > do
        index prog common::Program::bytecode.get = inst0_value
        index 1 + prog common::Program::bytecode.get = inst1_value
        index 2 + prog common::Program::bytecode.get = inst2_value
        if
            inst0_value common::InstValue::Drop is
            inst1_value common::InstValue::PushStr is &&
            inst2_value common::InstValue::PrintStr is &&
        then
            true = found_seq
        fi
        1 += index
    done
    "DROP -> PUSH_STR -> PRINT_STR sequence" found_seq test::assert_true
}

# ============================================================================
# Emitter tests
# ============================================================================

pub fn test_emit_typeof_int {
    error::Diagnostics::new = diagnostics
    "emit_typeof_int" test::test_start
    diagnostics "42 typeof" emit_typeof = asm
    "has drop" asm "addq $8, %rsp" assert_contains
    "has print_str" asm "jmp print_str" assert_contains
}

pub fn test_emit_typeof_bool {
    error::Diagnostics::new = diagnostics
    "emit_typeof_bool" test::test_start
    diagnostics "true typeof" emit_typeof = asm
    "has print_str" asm "jmp print_str" assert_contains
}

pub fn test_emit_typeof_str {
    error::Diagnostics::new = diagnostics
    "emit_typeof_str" test::test_start
    diagnostics "\"hello\" typeof" emit_typeof = asm
    "has print_str" asm "jmp print_str" assert_contains
}

