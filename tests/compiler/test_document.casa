pub fn test_analyzed_document_hover_returns_enum_facts {
    "analyzed_document_hover_returns_enum_facts" test::test_start
    "enum Color { Red Green Blue }\nColor::Red print" make_analyzed_document = document
    1 2 common::SourcePosition::new document.find_hover_at = type_result
    "type content" "enum Color { Red, Green, Blue }" type_result.unwrap.content test::assert_str_eq
    8 2 common::SourcePosition::new document.find_hover_at = member_result
    "member content" "Color::Red" member_result.unwrap.content test::assert_str_eq
}

pub fn test_analyzed_document_hover_rejects_qualified_separator {
    "analyzed_document_hover_rejects_qualified_separator" test::test_start
    QUALIFIED_POINT_SOURCE make_analyzed_document = document
    8 9 common::SourcePosition::new document.find_hover_at = result
    "is none" result.is_none test::assert_true
}

pub fn test_analyzed_document_hover_returns_none_for_unsupported_element {
    "analyzed_document_hover_returns_none_for_unsupported_element" test::test_start
    "true if then fi" make_analyzed_document = document
    6 1 common::SourcePosition::new document.find_hover_at = result
    "is none" result.is_none test::assert_true
}
test_analyzed_document_hover_returns_function_fact
