    source "good drop" str::find u64::try_from.unwrap = sibling
    sibling DOCUMENT_TEST_FILE snapshot.get_index.find_hover match
        document::PointAnswer::Known(hover) => "independent arm hover" "fn good -> i64" hover.content test::assert_str_eq
        _ => "independent arm remains available" false test::assert_true
    end
    sibling DOCUMENT_TEST_FILE snapshot.get_index.find_definition match
        document::PointAnswer::Known(location) => "independent arm definition" 3 location.offset test::assert_eq
        _ => "independent arm has a definition" false test::assert_true
    end
    source "good print" str::find u64::try_from.unwrap = dependent
    "failed join withholds dependent call"
    dependent DOCUMENT_TEST_FILE snapshot.get_index.find_hover document::PointAnswer::Known is !
    test::assert_true
}

fn test_match_arm_recovery {
    "match_arm_recovery" test::test_start
    "fn good -> i64 { 41 } 0 match 0 => true 1 + drop _ => good drop end good print" assert_match_arm_recovery
    "fn good -> i64 { 41 } fn bad { true 1 + drop } 0 match 0 => bad _ => good drop end good print" assert_match_arm_recovery
    "fn good -> i64 { 41 } fn bad { recover true 1 + drop } fn recover { 0 match 0 => bad _ => good drop end good print } bad" assert_match_arm_recovery
    "fn good -> i64 { 41 } fn need value:u8 { value drop } 0 match 0 => 256 need _ => good drop end good print" assert_match_arm_recovery
    "fn good -> i64 { 41 } 0 match true => {} _ => good drop end good print" assert_match_arm_recovery
    "fn good -> i64 { 41 } 0 match 0 if true 1 + => {} _ => good drop end good print" assert_match_arm_recovery
    "fn good -> i64 { 41 } true 1 + match 0 => {} _ => good drop end" = source
    source make_analyzed_document = invalid_subject
    source "good drop" str::find u64::try_from.unwrap = usage
    "invalid subject withholds arm facts"
    usage DOCUMENT_TEST_FILE invalid_subject.get_index.find_hover document::PointAnswer::Known is !
    test::assert_true
}

fn test_match_binding_after_failed_arm_completion {
    "match_binding_after_failed_arm_completion" test::test_start
    "enum E { A B(i64) C(i64) } 0 E::C match E::A => 1 E::B(x) => {} E::C(value) => value drop end" make_analyzed_document = snapshot
    "incompatible arm stacks reject analysis" snapshot.is_incomplete test::assert_true
    69 79 snapshot.get_index assert_binding_definition
    79 DOCUMENT_TEST_FILE snapshot.get_index.find_hover match
        document::PointAnswer::Known(hover) => "independent pattern type" "value: i64" hover.content test::assert_str_eq
        _ => "independent pattern remains available" false test::assert_true
    end
}

fn test_returned_borrow_source_hovers {
    "returned_borrow_source_hovers" test::test_start
    "struct Item { value:i64 }\nfn first left:$Item right:$Item -> $Item { left }\n&first = callback\ncallback drop" = source
    source make_analyzed_document = snapshot
    for position in [2, 3, 4].iter [4, 10, 1].iter.zip do
        position.first copy u64::try_from.unwrap position.second copy u64::try_from.unwrap common::SourcePosition::new snapshot.find_hover_at match
            std::Option::Some(hover) => {
                f"inferred sources in {hover.content}"
                0 hover.content.as_str "output 1: input 1" str::find <= test::assert_true
            }
            std::Option::None => "source hover exists" false test::assert_true
        end
    done
    "struct Item { value:i64 }\nfn first left:$Item right:$Item -> $Item { left }\n&first = callback:fn[$Item $Item -> $Item]\ncallback drop" make_analyzed_document = erased
    1 4 common::SourcePosition::new erased.find_hover_at match
        std::Option::Some(hover) => {
            "explicit callable hover explains erasure"
            0 hover.content.as_str "conservative (explicit fn contract)" str::find <= test::assert_true
        }
        std::Option::None => "explicit callable hover exists" false test::assert_true
    end
    "struct Item { value:i64 }\nfn first left:$Item right:$Item -> $Item { left }\nfn second left:$Item right:$Item -> $Item { right }\n&first = callback\ncallback drop\n&second = callback\ncallback drop" make_analyzed_document = reassigned
    1 7 common::SourcePosition::new reassigned.find_hover_at match
        std::Option::Some(hover) => {
            "reassigned callable hover uses current sources"
            0 hover.content.as_str "output 1: input 2" str::find <= test::assert_true
        }
        std::Option::None => "reassigned callable hover exists" false test::assert_true
    end
}

