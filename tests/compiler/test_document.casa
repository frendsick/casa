fn assert_triggered_completion
    index:$document::EditorIndex
    file:$str
    offset:u64
    trigger:$str
    expected:$str
{
    trigger offset file index.find_completions match
        document::ListAnswer::Complete(items) => items
        document::ListAnswer::Incomplete(items _) => items
        _ => {
            "triggered completion available" false test::assert_true return
        }
    end = items
    if expected "" == then
        "literal and comment triggers have no candidates" 0 items.length test::assert_eq
    else
        f"source name candidate {expected} at {offset}" expected items has_completion test::assert_true
    fi
}

fn test_completion_triggers_follow_lexical_context {
    "completion_triggers_follow_lexical_context" test::test_start
    "enum Color { Red } struct Item { value:i64 } impl Item { fn read self:$Item -> i64 { self.value } } 1 Item = item\n" = declarations
    for
        suffix in [
            "# Color:: item.\n",
            "\"Color:: item.\" drop",
            "\"escaped \\\" Color:: item.\" drop",
            "\"line one\nColor:: item.\" drop",
            "f\"Color:: item. {item.read} Color:: item.\" drop",
            "\"Color:: item.",
            "f\"Color:: item.",
        ].iter
    do
        declarations suffix str::concat = source
        source.as_str make_analyzed_document = snapshot
        suffix "Color::" str::find u64::try_from.unwrap declarations.length + 7 + = qualified_offset
        suffix "item." str::find u64::try_from.unwrap declarations.length + 5 + = member_offset
        "" ":" qualified_offset DOCUMENT_TEST_FILE snapshot.get_index assert_triggered_completion
        "" "." member_offset DOCUMENT_TEST_FILE snapshot.get_index assert_triggered_completion
    done
    for suffix in ["Color::Red drop", "Color::", "Color::R", "Color:: # comment"].iter do
        declarations suffix str::concat.as_str make_analyzed_document = snapshot
        "Red" ":" declarations.length 7 + DOCUMENT_TEST_FILE snapshot.get_index assert_triggered_completion
    done
    for suffix in ["item.read drop", "item.", "item.r", "f\"{item.read}\" drop"].iter do
        declarations suffix str::concat.as_str make_analyzed_document = snapshot
        suffix "item." str::find u64::try_from.unwrap declarations.length + 5 + = offset
        "read" "." offset DOCUMENT_TEST_FILE snapshot.get_index assert_triggered_completion
    done
}

