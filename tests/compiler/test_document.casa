            "variants available" 0 items.length > test::assert_true
            for item in items.iter do
                "replace only member start" 31 item.replacement.offset test::assert_eq
                "replace only member length" 3 item.replacement.length test::assert_eq
            done
        }
        _ => "qualified completion complete" false test::assert_true
    end
}

fn test_lexical_recovery_and_type_reference_coverage {
    "lexical_recovery_and_type_reference_coverage" test::test_start
    "fn broken { 42 \"unterminated" make_analyzed_document = damaged
    DOCUMENT_TEST_FILE damaged.get_index.find_semantic_tokens match
        document::ListAnswer::Incomplete(items _) => {
            "keyword and number survive" 2 items.length >= test::assert_true
            "keyword category" 0 items.get.kind document::DocumentTokenKind::Keyword == test::assert_true
            "number category" 1 items.get.kind document::DocumentTokenKind::Number == test::assert_true
        }
        _ => "lexical failure has partial tokens" false test::assert_true
    end
    "struct Point { x:i64 } fn take value:Point { value drop }" make_analyzed_document = snapshot
    "unrepresented annotations prevent complete references"
    false 7 DOCUMENT_TEST_FILE snapshot.get_index.find_references document::ReferenceAnswer::Incomplete is test::assert_true
}

fn test_commented_function_declaration {
    "commented_function_declaration" test::test_start
    for source in ["fn # note\nhello { }", "fn\r\nhello { }"].iter do
        source make_analyzed_document = snapshot
        source "hello" str::find u64::try_from.unwrap = offset
        "declaration hover" offset DOCUMENT_TEST_FILE snapshot.get_index.find_hover document::PointAnswer::Known is test::assert_true
        "declaration definition" offset DOCUMENT_TEST_FILE snapshot.get_index.find_definition document::PointAnswer::Known is test::assert_true
    done
}

fn test_binding_identities_and_global_visibility {
    "binding_identities_and_global_visibility" test::test_start
    "fn add x:i64 y:i64 -> i64 { x y + }" make_analyzed_document = parameters
    true 28 DOCUMENT_TEST_FILE parameters.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "only selected parameter" 2 result.ranges.length test::assert_eq
            "parameter declaration range" 7 result.declaration.offset test::assert_eq
            "parameter declaration length" 1 result.declaration.length test::assert_eq
        }
        _ => "parameter references complete" false test::assert_true
    end
    "fn work { true if then 1 = x x drop else 2 = x x drop fi }" make_analyzed_document = branches
    true 29 DOCUMENT_TEST_FILE branches.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "only first branch binding" 2 result.ranges.length test::assert_eq
            "first branch declaration" 27 result.declaration.offset test::assert_eq
        }
        _ => "branch references complete" false test::assert_true
    end
    true 47 DOCUMENT_TEST_FILE branches.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "only second branch binding" 2 result.ranges.length test::assert_eq
            "second branch declaration" 45 result.declaration.offset test::assert_eq
        }
        _ => "second branch references complete" false test::assert_true
    end
    "" 48 DOCUMENT_TEST_FILE branches.get_index.find_completions match
        document::ListAnswer::Complete(items) => "second branch variable visible" "x" items has_completion test::assert_true
        _ => "branch completion complete" false test::assert_true
    end
    "42 = later later drop" make_analyzed_document = globals
    "" 0 DOCUMENT_TEST_FILE globals.get_index.find_completions match
        document::ListAnswer::Complete(items) => "future global hidden" "later" items has_completion ! test::assert_true
        _ => "global completion complete" false test::assert_true
    end
    "" 11 DOCUMENT_TEST_FILE globals.get_index.find_completions match
        document::ListAnswer::Complete(items) => "declared global visible" "later" items has_completion test::assert_true
        _ => "global completion complete" false test::assert_true
    end
}

fn assert_variable_completion_type
    items:$std::List[document::DocumentCompletion]
    name:$str
    typ:$str
{
    for item in items.iter do
        if item.candidate document::CompletionCandidate::Variable(variable) is then
            if variable.name name == then
                "binding completion type" typ variable.typ.format test::assert_str_eq
                return
            fi
        fi
    done
    "variable completion present" false test::assert_true
}

fn test_scoped_variable_types_and_generic_references {
    "scoped_variable_types_and_generic_references" test::test_start
    "fn work { true if then 1 = x x drop else true = x x drop fi }" make_analyzed_document = snapshot
    29 DOCUMENT_TEST_FILE snapshot.get_index.find_hover match
        document::PointAnswer::Known(value) => "first binding type" "x: i64" value.content test::assert_str_eq
        _ => "first hover available" false test::assert_true
    end
    50 DOCUMENT_TEST_FILE snapshot.get_index.find_hover match
        document::PointAnswer::Known(value) => "second binding type" "x: bool" value.content test::assert_str_eq
        _ => "second hover available" false test::assert_true
    end
    "" 50 DOCUMENT_TEST_FILE snapshot.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "bool" "x" items assert_variable_completion_type
        }
        _ => "scoped completion available" false test::assert_true
    end
    "fn identity[T] value:T -> T { value } 1 identity drop true identity drop" make_analyzed_document = generic
    true 3 DOCUMENT_TEST_FILE generic.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => "both specializations share declaration" 3 result.ranges.length test::assert_eq
        _ => "generic references complete" false test::assert_true
    end
}

fn test_capture_definition_and_borrowed_completion {
    "capture_definition_and_borrowed_completion" test::test_start
    "fn outer {\n    1 = value\n    { value print } = closure\n    value print\n}" make_analyzed_document = captured
    31 DOCUMENT_TEST_FILE captured.get_index.find_definition match
        document::PointAnswer::Known(location) => "enclosing binding definition" 19 location.offset test::assert_eq
        _ => "captured definition available" false test::assert_true
    end
    "struct Item { value:i64 } impl Item { fn read self:$Item -> i64 { self.value } fn consume self:Item { self drop } } fn use item:$Item { item.read drop }" make_analyzed_document = borrowed
    "." 141 DOCUMENT_TEST_FILE borrowed.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "shared receiver read available" "read" items has_completion test::assert_true
            "shared receiver cannot consume" "consume" items has_completion ! test::assert_true
        }
        _ => "borrowed completion complete" false test::assert_true
    end
}
