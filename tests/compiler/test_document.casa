fn test_rejected_recursive_call_withholds_dependent_facts {
    "rejected_recursive_call_withholds_dependent_facts" test::test_start
    "fn f -> i64 { g true } fn g -> i64 { f = x x drop true }" make_analyzed_document = snapshot
    "invalid recursive signatures reject analysis" snapshot.is_incomplete test::assert_true
    41 DOCUMENT_TEST_FILE snapshot.get_index.find_hover = hover
    "dependent inferred type is unavailable" hover document::PointAnswer::Unavailable is test::assert_true
    false 41 DOCUMENT_TEST_FILE snapshot.get_index.find_references = references
    "dependent references are unavailable" references document::ReferenceAnswer::Unavailable is test::assert_true
    3 DOCUMENT_TEST_FILE snapshot.get_index.find_hover = declaration
    "written declaration remains available" declaration document::PointAnswer::Known is test::assert_true
}

fn test_reference_ranges_exclude_reference_sigil {
    "reference_ranges_exclude_reference_sigil" test::test_start
    "fn target { } &target drop" make_analyzed_document = snapshot
    false 15 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "one function reference" 1 result.ranges.length test::assert_eq
            "reference starts after ampersand" 15 0 result
                .ranges
                .get
                .offset test::assert_eq
            "only name is replaced" 6 0 result
                .ranges
                .get
                .length test::assert_eq
        }
        _ => "function reference is available" false test::assert_true
    end
}

fn has_completion items:$std::List[document::DocumentCompletion] name:$str -> bool {
    for item in items.iter do
        if item.insertion_text name == then
            true return
        fi
    done
    false
}

