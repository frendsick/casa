fn test_owned_answers_and_recovery {
    "owned_answers_and_recovery" test::test_start
    for
        suffix in [
            "fn broken { true 1 + drop }",
            "fn broken { \"unterminated",
            "fn broken {",
            "import \"missing_editor_dependency\"",
        ].iter
    do
        "fn healthy -> i64 { 42 }\nhealthy drop\n" suffix str::concat.as_str make_analyzed_document = snapshot
        "partial coverage" snapshot.is_incomplete test::assert_true
        25 DOCUMENT_TEST_FILE snapshot.get_index.find_hover = hover
        25 DOCUMENT_TEST_FILE snapshot.get_index.find_definition = definition
        true 25 DOCUMENT_TEST_FILE snapshot.get_index.find_references = references
        "" 0 DOCUMENT_TEST_FILE snapshot.get_index.find_completions = completion
        DOCUMENT_TEST_FILE snapshot.get_index.find_semantic_tokens = tokens
        snapshot drop
        hover match
            document::PointAnswer::Known(value) => "owned hover" "fn healthy -> i64" value.content test::assert_str_eq
            _ => "independent hover retained" false test::assert_true
        end
        definition match
            document::PointAnswer::Known(value) => "owned definition" 3 value.offset test::assert_eq
            _ => "independent definition retained" false test::assert_true
        end
        references match
            document::ReferenceAnswer::Incomplete(result _) => "declaration and call" 2 result.ranges.length test::assert_eq
            _ => "references mark missing coverage" false test::assert_true
        end
        completion match
            document::ListAnswer::Incomplete(items _) => "owned completion" 0 items.length < test::assert_true
            document::ListAnswer::Complete(items) => "owned independent completion" 0 items.length < test::assert_true
            _ => "completion remains available" false test::assert_true
        end
        tokens match
            document::ListAnswer::Incomplete(items _) => "owned tokens" 0 items.length < test::assert_true
            _ => "tokens mark missing coverage" false test::assert_true
        end
    done
}

fn test_query_availability {
    "query_availability" test::test_start
    "fn unused { }\n" make_analyzed_document = snapshot
    "whitespace is absent" 13 DOCUMENT_TEST_FILE snapshot.get_index.find_hover document::PointAnswer::Absent is test::assert_true
    "invalid offset unavailable" 100 DOCUMENT_TEST_FILE snapshot.get_index.find_hover document::PointAnswer::Unavailable is test::assert_true
    "unknown file unavailable" "/not/used.casa" snapshot.get_index.find_semantic_tokens document::ListAnswer::Unavailable is test::assert_true
    false 3 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => "complete empty references" 0 result.ranges.length test::assert_eq
        _ => "unused declaration has complete coverage" false test::assert_true
    end
    "fn healthy { }\nfn bad { true 1 + drop }" make_analyzed_document = damaged
    "failed operation unavailable" 31 DOCUMENT_TEST_FILE damaged.get_index.find_hover document::PointAnswer::Unavailable is test::assert_true
    false 3 DOCUMENT_TEST_FILE damaged.get_index.find_references match
        document::ReferenceAnswer::Incomplete(result _) => "incomplete empty references" 0 result.ranges.length test::assert_eq
        _ => "failed body leaves incomplete coverage" false test::assert_true
    end
}

fn test_unreachable_reference_coverage {
    "unreachable_reference_coverage" test::test_start
    "fn target { } fn owner { return target }" make_analyzed_document = snapshot
    false 3 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "dead source reference remains indexed" 1 result.ranges.length test::assert_eq
            "dead source reference offset" 32 0 result
                .ranges
                .get
                .offset test::assert_eq
        }
        _ => "valid source has complete reference coverage" false test::assert_true
    end
}

