fn test_owned_answers_and_recovery {
    "owned_answers_and_recovery" test::test_start
    for
        suffix in [
            "fn broken { true 1 + drop }",
            "fn broken { \"unterminated",
            "fn broken {",
            "import \"missing_editor_dependency\"",
        ].iter
    do
        "fn healthy -> i64 { 42 }\nhealthy drop\n" suffix str::concat.as_str make_analyzed_document = snapshot
        "partial coverage" snapshot.is_incomplete test::assert_true
        25 DOCUMENT_TEST_FILE snapshot.get_index.find_hover = hover
        25 DOCUMENT_TEST_FILE snapshot.get_index.find_definition = definition
        true 25 DOCUMENT_TEST_FILE snapshot.get_index.find_references = references
        "" 0 DOCUMENT_TEST_FILE snapshot.get_index.find_completions = completion
        DOCUMENT_TEST_FILE snapshot.get_index.find_semantic_tokens = tokens
        snapshot drop
        hover match
            document::PointAnswer::Known(value) => "owned hover" "fn healthy -> i64" value.content test::assert_str_eq
            _ => "independent hover retained" false test::assert_true
        end
        definition match
            document::PointAnswer::Known(value) => "owned definition" 3 value.offset test::assert_eq
            _ => "independent definition retained" false test::assert_true
        end
        references match
            document::ReferenceAnswer::Incomplete(result _) => "declaration and call" 2 result.ranges.length test::assert_eq
            _ => "references mark missing coverage" false test::assert_true
        end
        completion match
            document::ListAnswer::Incomplete(items _) => "owned completion" 0 items.length > test::assert_true
            document::ListAnswer::Complete(items) => "owned independent completion" 0 items.length > test::assert_true
            _ => "completion remains available" false test::assert_true
        end
        tokens match
            document::ListAnswer::Incomplete(items _) => "owned tokens" 0 items.length > test::assert_true
            _ => "tokens mark missing coverage" false test::assert_true
        end
    done
}

fn test_query_availability {
    "query_availability" test::test_start
    "fn unused { }\n" make_analyzed_document = snapshot
    "whitespace is absent" 13 DOCUMENT_TEST_FILE snapshot.get_index.find_hover document::PointAnswer::Absent is test::assert_true
    "invalid offset unavailable" 100 DOCUMENT_TEST_FILE snapshot.get_index.find_hover document::PointAnswer::Unavailable is test::assert_true
    "unknown file unavailable" "/not/used.casa" snapshot.get_index.find_semantic_tokens document::ListAnswer::Unavailable is test::assert_true
    false 3 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => "complete empty references" 0 result.ranges.length test::assert_eq
        _ => "unused declaration has complete coverage" false test::assert_true
    end
    "fn healthy { }\nfn bad { true 1 + drop }" make_analyzed_document = damaged
    "failed operation unavailable" 31 DOCUMENT_TEST_FILE damaged.get_index.find_hover document::PointAnswer::Unavailable is test::assert_true
    false 3 DOCUMENT_TEST_FILE damaged.get_index.find_references match
        document::ReferenceAnswer::Incomplete(result _) => "incomplete empty references" 0 result.ranges.length test::assert_eq
        _ => "failed body leaves incomplete coverage" false test::assert_true
    end
}

fn test_reference_ranges_exclude_reference_sigil {
    "reference_ranges_exclude_reference_sigil" test::test_start
    "fn target { } &target drop" make_analyzed_document = snapshot
    false 15 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "one function reference" 1 result.ranges.length test::assert_eq
            "reference starts after ampersand" 15 0 result
                .ranges
                .get
                .offset test::assert_eq
            "only name is replaced" 6 0 result
                .ranges
                .get
                .length test::assert_eq
        }
        _ => "function reference is available" false test::assert_true
    end
}

fn has_completion items:$std::List[document::DocumentCompletion] name:$str -> bool {
    for item in items.iter do
        if item.insertion_text name == then
            true return
        fi
    done
    false
}

fn test_source_generic_hover {
    "source_generic_hover" test::test_start
    "fn identity[T] value:T -> T { value }\n1 identity drop\ntrue identity drop" make_analyzed_document = snapshot
    3 DOCUMENT_TEST_FILE snapshot.get_index.find_hover match
        document::PointAnswer::Known(hover) => {
            "source declaration spelling" "fn identity value:T -> T" hover.content test::assert_str_eq
        }
        _ => "generic declaration hover" false test::assert_true
    end
}

fn test_scoped_completion_and_replacement {
    "scoped_completion_and_replacement" test::test_start
    "fn work { 1 = first 2 = later first later + drop }" make_analyzed_document = snapshot
    "" 10 DOCUMENT_TEST_FILE snapshot.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "first not declared" "first" items has_completion ! test::assert_true
            "later not declared" "later" items has_completion ! test::assert_true
        }
        _ => "completion before declarations is complete" false test::assert_true
    end
    "" 20 DOCUMENT_TEST_FILE snapshot.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "first is visible" "first" items has_completion test::assert_true
            "later still not declared" "later" items has_completion ! test::assert_true
        }
        _ => "completion between declarations is complete" false test::assert_true
    end
    "" 32 DOCUMENT_TEST_FILE snapshot.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "replacement begins at identifier" 30 0 items
                .get
                .replacement
                .offset test::assert_eq
            "replacement spans identifier" 5 0 items
                .get
                .replacement
                .length test::assert_eq
        }
        _ => "replacement range available" false test::assert_true
    end
}

fn test_reference_metadata_and_variable_declaration {
    "reference_metadata_and_variable_declaration" test::test_start
    "42 = x x drop" make_analyzed_document = snapshot
    false 7 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "declaration excluded" 1 result.ranges.length test::assert_eq
            "use offset" 7 0 result
                .ranges
                .get
                .offset test::assert_eq
            "declaration identity retained" 5 result.declaration.offset test::assert_eq
            "one source in compilation coverage" 1 result.files.length test::assert_eq
            "exact compilation source" DOCUMENT_TEST_FILE 0 result.files.get test::assert_str_eq
        }
        _ => "variable references complete" false test::assert_true
    end
    true 7 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => "declaration included" 2 result.ranges.length test::assert_eq
        _ => "variable references complete" false test::assert_true
    end
}

fn test_query_specific_coverage {
    "query_specific_coverage" test::test_start
    "fn healthy { 42 = x x drop }\nfn bad { true 1 + drop }" make_analyzed_document = snapshot
    "understood keyword is absent" 0 DOCUMENT_TEST_FILE snapshot.get_index.find_hover document::PointAnswer::Absent is test::assert_true
    false 20 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "healthy local coverage complete" 1 result.ranges.length test::assert_eq
            "local rename scope" result.rename_requires_workspace ! test::assert_true
        }
        _ => "unrelated failure does not hide local uses" false test::assert_true
    end
    "import \"/tmp/editor_peer.casa\" as peer\ntrue 1 + drop".to_str DOCUMENT_TEST_FILE.to_str products::SourceUnit
    "" lexer::absolute_normalize_path swap products::CompilationInput::new = input
    "pub fn exported { } fn local { }".to_str "/tmp/editor_peer.casa".to_str input.source_overrides.set
    input products::analyze.unwrap = imported
    "" 0 "/tmp/editor_peer.casa" imported.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "imported file sees its public declaration" "exported" items has_completion test::assert_true
            "imported file sees its private declaration" "local" items has_completion test::assert_true
        }
        _ => "imported completion independently complete" false test::assert_true
    end
    "imported function declaration hover"
    7 "/tmp/editor_peer.casa" imported.get_index.find_hover document::PointAnswer::Known is test::assert_true
    "/tmp/editor_peer.casa" imported.get_index.find_semantic_tokens match
        document::ListAnswer::Complete(_) => {
        }
        _ => "healthy imported token coverage complete" false test::assert_true
    end
}

fn test_qualified_completion_replacement {
