import "std" as std
import "../../compiler/lexer.casa" as lexer
import "../../compiler/products.casa" as products
import "../../compiler/common.casa" as common
import "../../compiler/document.casa" as document
import "../../lib/test.casa" as test

pub const DOCUMENT_TEST_FILE "/tmp/document_test.casa"
pub const QUALIFIED_POINT_SOURCE "struct Point {\n    x: i64\n    y: i64\n}\nimpl Point {\n    fn get_x self:$Point -> i64 { self Point::x }\n}\n1 2 Point = p\np Point::get_x print"

pub fn make_analyzed_document source:$str -> products::AnalysisSnapshot {
    source.to_str DOCUMENT_TEST_FILE.to_str products::SourceUnit
    "" lexer::absolute_normalize_path swap products::CompilationInput::new products::analyze.unwrap
}

pub fn test_analyzed_document_hover_returns_function_fact {
    "analyzed_document_hover_returns_function_fact" test::test_start
    "fn add x:i64 y:i64 -> i64 {\n    x y +\n}\n1 2 add" make_analyzed_document = document
    5 4 common::SourcePosition::new document.find_hover_at = result
    if result std::Option::Some(hover) is then
        "content" "fn add x:i64 y:i64 -> i64" hover.content test::assert_str_eq
        "offset" 44 hover.location.offset test::assert_eq
        "length" 3 hover.location.length test::assert_eq
    else
        "is some" false test::assert_true
    fi
}

