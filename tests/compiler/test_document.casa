    fi
    14 4 common::SourcePosition::new document.find_hover_at = variant_result
    if variant_result std::Option::Some(variant_hover) is then
        "variant content" "Color::Red" variant_hover.content test::assert_str_eq
    else
        "variant is some" false test::assert_true
    fi
}

