pub fn test_analyzed_document_hover_returns_operator_fact {
    "analyzed_document_hover_returns_operator_fact" test::test_start
    "1 2 +" make_analyzed_document = document
    5 1 common::SourcePosition::new document.find_hover_at = result
    "content" "+: T T -> T (same-width integers)" result.unwrap.content test::assert_str_eq
}

pub fn test_analyzed_document_hover_returns_intrinsic_fact {
    "analyzed_document_hover_returns_intrinsic_fact" test::test_start
    "42 dup drop drop" make_analyzed_document = document
    4 1 common::SourcePosition::new document.find_hover_at = result
    "content" "dup: [T: Copy] T -> T T" result.unwrap.content test::assert_str_eq
}

pub fn test_analyzed_document_hover_preserves_stack_effect_facts {
    "analyzed_document_hover_preserves_stack_effect_facts" test::test_start
    "42 drop" make_analyzed_document = drop_document
    4 1 common::SourcePosition::new drop_document.find_hover_at = drop_result
    "drop" "drop: T -> None" drop_result.unwrap.content test::assert_str_eq

    "1 2 swap drop drop" make_analyzed_document = swap_document
    5 1 common::SourcePosition::new swap_document.find_hover_at = swap_result
    "swap" "swap: T1 T2 -> T2 T1" swap_result.unwrap.content test::assert_str_eq

    "1 2 == drop" make_analyzed_document = comparison_document
    5 1 common::SourcePosition::new comparison_document.find_hover_at = comparison_result
    "comparison" "==: [T: PartialEq] T T -> bool" comparison_result.unwrap.content test::assert_str_eq

    "42 print" make_analyzed_document = print_document
    4 1 common::SourcePosition::new print_document.find_hover_at = print_result
    "print" "print: [T: Display] T -> None" print_result.unwrap.content test::assert_str_eq

    "{ 42 print } exec" make_analyzed_document = exec_document
    14 1 common::SourcePosition::new exec_document.find_hover_at = exec_result
    "exec" "exec: fn[...] -> ..." exec_result.unwrap.content test::assert_str_eq
}

