fn assert_hover_at index:$document::EditorIndex file:$str source:$str needle:$str expected:$str {
    source needle str::find u64::try_from.unwrap file index.find_hover match
        document::PointAnswer::Known(hover) => f"hover at `{needle}`" expected hover.content test::assert_str_eq
        _ => f"hover at `{needle}` available" false test::assert_true
    end
}

fn test_aliased_type_hover_uses_source_names {
    "aliased_type_hover_uses_source_names" test::test_start
    "/tmp/editor_aliased_types.casa" = imported_file
    "import \"/tmp/editor_aliased_types.casa\" as shapes\nfn show point:$shapes::Point -> i64 { point = other other.x }\n1 shapes::Point drop\nshapes::Color::Red drop\nunsafe { ptr::null ptr::as_ref[shapes::Point] drop }" = source
    source.to_str DOCUMENT_TEST_FILE.to_str products::SourceUnit
    "" lexer::absolute_normalize_path swap products::CompilationInput::new = input
    "pub struct Point { pub x: i64 }\npub enum Color { Red }" = imported_source
    imported_source.to_str imported_file.to_str input.source_overrides.set
    input products::analyze.unwrap.get_index = index
    "point: $shapes::Point" "point:" source DOCUMENT_TEST_FILE index assert_hover_at
    "= other: $shapes::Point" "other other" source DOCUMENT_TEST_FILE index assert_hover_at
    "other: $shapes::Point" "other.x" source DOCUMENT_TEST_FILE index assert_hover_at
    "struct shapes::Point { x: i64 }" "Point drop" source DOCUMENT_TEST_FILE index assert_hover_at
    "shapes::Color::Red" "Red drop" source DOCUMENT_TEST_FILE index assert_hover_at
    "ptr::as_ref[shapes::Point]: ptr -> $shapes::Point" "as_ref" source DOCUMENT_TEST_FILE index assert_hover_at
    "struct Point { x: i64 }" "Point {" imported_source imported_file index assert_hover_at
    "enum Color { Red }" "Color {" imported_source imported_file index assert_hover_at
}

fn test_scoped_completion_and_replacement {
    "scoped_completion_and_replacement" test::test_start
    "fn work { 1 = first 2 = later first later + drop }" make_analyzed_document = snapshot
    "" 10 DOCUMENT_TEST_FILE snapshot.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "first not declared" "first" items has_completion ! test::assert_true
            "later not declared" "later" items has_completion ! test::assert_true
        }
        _ => "completion before declarations is complete" false test::assert_true
    end
    "" 20 DOCUMENT_TEST_FILE snapshot.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "first is visible" "first" items has_completion test::assert_true
            "later still not declared" "later" items has_completion ! test::assert_true
        }
        _ => "completion between declarations is complete" false test::assert_true
    end
    "" 32 DOCUMENT_TEST_FILE snapshot.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "replacement begins at identifier" 30 0 items
                .get
                .replacement
                .offset test::assert_eq
            "replacement spans identifier" 5 0 items
                .get
                .replacement
                .length test::assert_eq
        }
        _ => "replacement range available" false test::assert_true
    end
}

fn test_condition_binding_completion_starts_at_then {
    "condition_binding_completion_starts_at_then" test::test_start
    "enum E { Some (i64) None }\nfn f e:E -> i64 {\n    if e E::Some(number) is  then number return fi\n    0\n}" make_analyzed_document = snapshot
    "" 73 DOCUMENT_TEST_FILE snapshot.get_index.find_completions match
        document::ListAnswer::Complete(items) => "binding not offered in its own condition" "number" items has_completion ! test::assert_true
        _ => "completion in condition is complete" false test::assert_true
    end
    "" 79 DOCUMENT_TEST_FILE snapshot.get_index.find_completions match
        document::ListAnswer::Complete(items) => "binding offered in then body" "number" items has_completion test::assert_true
        _ => "completion in then body is complete" false test::assert_true
    end
    "enum E { Some (i64) None }\nfn f e:E -> i64 {\n    if e E::Some(number) is else 0 return fi\n    number\n}" make_analyzed_document = early_exit_snapshot
    "" 90 DOCUMENT_TEST_FILE early_exit_snapshot.get_index.find_completions match
        document::ListAnswer::Complete(items) => "early-exit binding offered after fi" "number" items has_completion test::assert_true
        _ => "completion after early-exit condition is complete" false test::assert_true
    end
}

fn test_reference_metadata_and_variable_declaration {
    "reference_metadata_and_variable_declaration" test::test_start
    "42 = x x drop" make_analyzed_document = snapshot
    false 7 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "declaration excluded" 1 result.ranges.length test::assert_eq
            "use offset" 7 0 result
                .ranges
                .get
                .offset test::assert_eq
            "declaration identity retained" 5 result.declaration.offset test::assert_eq
            "one source in compilation coverage" 1 result.files.length test::assert_eq
            "exact compilation source" DOCUMENT_TEST_FILE 0 result.files.get test::assert_str_eq
        }
        _ => "variable references complete" false test::assert_true
    end
    true 7 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => "declaration included" 2 result.ranges.length test::assert_eq
        _ => "variable references complete" false test::assert_true
    end
}

fn test_query_specific_coverage {
    "query_specific_coverage" test::test_start
    "fn healthy { 42 = x x drop }\nfn bad { true 1 + drop }" make_analyzed_document = snapshot
    "understood keyword is absent" 0 DOCUMENT_TEST_FILE snapshot.get_index.find_hover document::PointAnswer::Absent is test::assert_true
    false 20 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "healthy local coverage complete" 1 result.ranges.length test::assert_eq
            "local rename scope" result.rename_requires_workspace ! test::assert_true
        }
        _ => "unrelated failure does not hide local uses" false test::assert_true
    end
    "import \"/tmp/editor_peer.casa\" as peer\ntrue 1 + drop".to_str DOCUMENT_TEST_FILE.to_str products::SourceUnit
    "" lexer::absolute_normalize_path swap products::CompilationInput::new = input
    "pub fn exported { } fn local { }".to_str "/tmp/editor_peer.casa".to_str input.source_overrides.set
    input products::analyze.unwrap = imported
    "" 0 "/tmp/editor_peer.casa" imported.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "imported file sees its public declaration" "exported" items has_completion test::assert_true
            "imported file sees its private declaration" "local" items has_completion test::assert_true
        }
        _ => "imported completion independently complete" false test::assert_true
    end
    "imported function declaration hover"
    7 "/tmp/editor_peer.casa" imported.get_index.find_hover document::PointAnswer::Known is test::assert_true
    "/tmp/editor_peer.casa" imported.get_index.find_semantic_tokens match
        document::ListAnswer::Complete(_) => {}
        _ => "healthy imported token coverage complete" false test::assert_true
    end
}

fn test_qualified_completion_replacement {
