    4 1 common::SourcePosition::new document.find_hover_at = float_result
    "f64 content" "1.5: f64" float_result.unwrap.content test::assert_str_eq
    8 1 common::SourcePosition::new document.find_hover_at = string_result
    "string content" "\"hello\": str" string_result.unwrap.content test::assert_str_eq
}

