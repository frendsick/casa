fn test_rejected_recursive_call_withholds_dependent_facts {
    "rejected_recursive_call_withholds_dependent_facts" test::test_start
    "fn f -> i64 { g true } fn g -> i64 { f = x x drop true }" make_analyzed_document = snapshot
    "invalid recursive signatures reject analysis" snapshot.is_incomplete test::assert_true
    41 DOCUMENT_TEST_FILE snapshot.get_index.find_hover = hover
    "dependent inferred type is unavailable" hover document::PointAnswer::Unavailable is test::assert_true
    false 41 DOCUMENT_TEST_FILE snapshot.get_index.find_references = references
    "dependent references are unavailable" references document::ReferenceAnswer::Unavailable is test::assert_true
    3 DOCUMENT_TEST_FILE snapshot.get_index.find_hover = declaration
    "written declaration remains available" declaration document::PointAnswer::Known is test::assert_true
}

fn test_deferred_ownership_failure_keeps_verified_prefix {
    "deferred_ownership_failure_keeps_verified_prefix" test::test_start
    "41 = healthy healthy drop struct Owner { value:i64 } struct Slot { value:$Owner } fn put slot:mut$Slot item:$Owner { item = slot.value } fn invoke callback:fn[->] { callback exec } fn left stop:bool -> fn[fn[->]] { if stop then &invoke else 1 Owner = initial initial Slot = slot 2 Owner = local local = view:$Owner { view slot put } true right exec local drop slot.value.value drop &invoke fi } fn right stop:bool -> fn[fn[->]] { stop left } true left drop" = source
    source make_analyzed_document = snapshot
    "deferred ownership failure rejects analysis" snapshot.is_incomplete test::assert_true
    13 DOCUMENT_TEST_FILE snapshot.get_index.find_hover match
        document::PointAnswer::Known(hover) => "independent prefix retains its type" "healthy: i64" hover.content test::assert_str_eq
        _ => "independent prefix remains verified" false test::assert_true
    end
    source "slot.value.value" str::find u64::try_from.unwrap = dependent_offset
    dependent_offset DOCUMENT_TEST_FILE snapshot.get_index.find_hover = dependent
    "facts after the ownership failure are unavailable" dependent document::PointAnswer::Unavailable is test::assert_true
}

fn test_reference_ranges_exclude_reference_sigil {
    "reference_ranges_exclude_reference_sigil" test::test_start
    "fn target { } &target drop" make_analyzed_document = snapshot
    false 15 DOCUMENT_TEST_FILE snapshot.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "one function reference" 1 result.ranges.length test::assert_eq
            "reference starts after ampersand" 15 0 result
                .ranges
                .get
                .offset test::assert_eq
            "only name is replaced" 6 0 result
                .ranges
                .get
                .length test::assert_eq
        }
        _ => "function reference is available" false test::assert_true
    end
}

fn has_completion items:$std::List[document::DocumentCompletion] name:$str -> bool {
    for item in items.iter do
        if item.insertion_text name == then
            true return
        fi
    done
    false
}

fn test_source_generic_hover {
    "source_generic_hover" test::test_start
    "fn identity[T] value:T -> T { value }\n1 identity drop\ntrue identity drop" make_analyzed_document = snapshot
    3 DOCUMENT_TEST_FILE snapshot.get_index.find_hover match
        document::PointAnswer::Known(hover) => {
            "source declaration spelling" "fn identity value:T -> T\nBorrow sources (inferred):\n  output 1: input 1" hover.content test::assert_str_eq
        }
        _ => "generic declaration hover" false test::assert_true
