import "../../compiler/document.casa"
import "../../lib/test.casa"

const DOCUMENT_TEST_FILE "/tmp/document_test.casa"
const QUALIFIED_POINT_SOURCE "struct Point {\n    x: i64\n    y: i64\n}\nimpl Point {\n    fn get_x self:Point -> i64 { self Point::x }\n}\n1 2 Point = p\np Point::get_x print"

fn make_analyzed_document source:str -> AnalyzedDocument {
    source DOCUMENT_TEST_FILE AnalysisInput::new analyze = analysis
    DOCUMENT_TEST_FILE source analysis AnalyzedDocument::new
}

fn test_analyzed_document_hover_returns_function_fact {
    "analyzed_document_hover_returns_function_fact" test_start
    "fn add x:i64 y:i64 -> i64 {\n    x y +\n}\n1 2 add" make_analyzed_document = document
    5 4 SourcePosition::new document.find_hover_at = result
    if result Option::Some(hover) is then
        "content" "fn add x:i64 y:i64 -> i64" hover.content assert_str_eq
        "offset" 44 hover.location.offset assert_eq
        "length" 3 hover.location.length assert_eq
    else
        "is some" false assert_true
    fi
}

fn test_analyzed_document_hover_returns_variable_fact {
    "analyzed_document_hover_returns_variable_fact" test_start
    "42 = count\ncount print" make_analyzed_document = document
    1 2 SourcePosition::new document.find_hover_at = result
    if result Option::Some(hover) is then
        "content" "count: i64" hover.content assert_str_eq
    else
        "is some" false assert_true
    fi
}

fn test_analyzed_document_hover_returns_function_declaration_fact {
    "analyzed_document_hover_returns_function_declaration_fact" test_start
    "fn add x:i64 y:i64 -> i64 {\n    x y +\n}" make_analyzed_document = document
    4 1 SourcePosition::new document.find_hover_at = result
    if result Option::Some(hover) is then
        "content" "fn add x:i64 y:i64 -> i64" hover.content assert_str_eq
    else
        "is some" false assert_true
    fi
}

fn test_analyzed_document_hover_returns_type_declaration_facts {
    "analyzed_document_hover_returns_type_declaration_facts" test_start
    "struct Point {\n    x: i64\n}\nenum Color { Red }" make_analyzed_document = document
    8 1 SourcePosition::new document.find_hover_at = struct_result
    if struct_result Option::Some(struct_hover) is then
        "struct content" "struct Point { x: i64 }" struct_hover.content assert_str_eq
    else
        "struct is some" false assert_true
    fi
    6 4 SourcePosition::new document.find_hover_at = enum_result
    if enum_result Option::Some(enum_hover) is then
        "enum content" "enum Color { Red }" enum_hover.content assert_str_eq
    else
        "enum is some" false assert_true
    fi
    14 4 SourcePosition::new document.find_hover_at = variant_result
    if variant_result Option::Some(variant_hover) is then
        "variant content" "Color::Red" variant_hover.content assert_str_eq
    else
        "variant is some" false assert_true
    fi
}

fn test_analyzed_document_hover_returns_literal_fact {
    "analyzed_document_hover_returns_literal_fact" test_start
    "42 1.5 \"hello\" drop drop drop" make_analyzed_document = document
    1 1 SourcePosition::new document.find_hover_at = int_result
    "i64 content" "(i64) 42" int_result.unwrap.content assert_str_eq
    4 1 SourcePosition::new document.find_hover_at = float_result
    "f64 content" "(f64) 1.5" float_result.unwrap.content assert_str_eq
    8 1 SourcePosition::new document.find_hover_at = string_result
    "string content" "(str) \"hello\"" string_result.unwrap.content assert_str_eq
}

fn test_analyzed_document_hover_uses_contextual_literal_type {
    "analyzed_document_hover_uses_contextual_literal_type" test_start
    "1.5 = value:f32" make_analyzed_document = document
    1 1 SourcePosition::new document.find_hover_at = result
    "content" "(f32) 1.5" result.unwrap.content assert_str_eq
}

fn test_analyzed_document_hover_returns_assignment_fact {
    "analyzed_document_hover_returns_assignment_fact" test_start
    "42 = count" make_analyzed_document = document
    6 1 SourcePosition::new document.find_hover_at = result
    "content" "= count: i64" result.unwrap.content assert_str_eq
}

fn test_analyzed_document_hover_returns_struct_fact {
    "analyzed_document_hover_returns_struct_fact" test_start
    "struct Point {\n    x: i64\n    y: i64\n}\n1 2 Point" make_analyzed_document = document
    5 5 SourcePosition::new document.find_hover_at = result
    "content" "struct Point { x: i64, y: i64 }" result.unwrap.content assert_str_eq
}

fn test_analyzed_document_hover_returns_operator_fact {
    "analyzed_document_hover_returns_operator_fact" test_start
    "1 2 +" make_analyzed_document = document
    5 1 SourcePosition::new document.find_hover_at = result
    "content" "+: T T -> T (same-width integers)" result.unwrap.content assert_str_eq
}

fn test_analyzed_document_hover_returns_intrinsic_fact {
    "analyzed_document_hover_returns_intrinsic_fact" test_start
    "42 dup drop drop" make_analyzed_document = document
    4 1 SourcePosition::new document.find_hover_at = result
    "content" "dup: T -> T T" result.unwrap.content assert_str_eq
}

fn test_analyzed_document_hover_preserves_stack_effect_facts {
    "analyzed_document_hover_preserves_stack_effect_facts" test_start
    "42 drop" make_analyzed_document = drop_document
    4 1 SourcePosition::new drop_document.find_hover_at = drop_result
    "drop" "drop: T -> None" drop_result.unwrap.content assert_str_eq

    "1 2 swap drop drop" make_analyzed_document = swap_document
    5 1 SourcePosition::new swap_document.find_hover_at = swap_result
    "swap" "swap: T1 T2 -> T2 T1" swap_result.unwrap.content assert_str_eq

    "1 2 == drop" make_analyzed_document = comparison_document
    5 1 SourcePosition::new comparison_document.find_hover_at = comparison_result
    "comparison" "==: [T: Eq] T T -> bool" comparison_result.unwrap.content assert_str_eq

    "42 print" make_analyzed_document = print_document
    4 1 SourcePosition::new print_document.find_hover_at = print_result
    "print" "print: [T: Display] T -> None" print_result.unwrap.content assert_str_eq

    "{ 42 print } exec" make_analyzed_document = exec_document
    14 1 SourcePosition::new exec_document.find_hover_at = exec_result
    "exec" "exec: fn[...] -> ..." exec_result.unwrap.content assert_str_eq
}

fn test_analyzed_document_hover_returns_qualified_type_fact {
    "analyzed_document_hover_returns_qualified_type_fact" test_start
    QUALIFIED_POINT_SOURCE make_analyzed_document = document
    3 9 SourcePosition::new document.find_hover_at = result
    "content" "struct Point { x: i64, y: i64 }" result.unwrap.content assert_str_eq
}

fn test_analyzed_document_hover_returns_qualified_method_fact {
    "analyzed_document_hover_returns_qualified_method_fact" test_start
    QUALIFIED_POINT_SOURCE make_analyzed_document = document
    10 9 SourcePosition::new document.find_hover_at = result
    "content" "fn Point::get_x self:Point -> i64" result.unwrap.content assert_str_eq
}

fn test_analyzed_document_hover_returns_enum_facts {
    "analyzed_document_hover_returns_enum_facts" test_start
    "enum Color { Red Green Blue }\nColor::Red print" make_analyzed_document = document
    1 2 SourcePosition::new document.find_hover_at = type_result
    "type content" "enum Color { Red, Green, Blue }" type_result.unwrap.content assert_str_eq
    8 2 SourcePosition::new document.find_hover_at = member_result
    "member content" "Color::Red" member_result.unwrap.content assert_str_eq
}

fn test_analyzed_document_hover_rejects_qualified_separator {
    "analyzed_document_hover_rejects_qualified_separator" test_start
    QUALIFIED_POINT_SOURCE make_analyzed_document = document
    8 9 SourcePosition::new document.find_hover_at = result
    "is none" result.is_none assert_true
}

fn test_analyzed_document_hover_returns_none_for_unsupported_element {
    "analyzed_document_hover_returns_none_for_unsupported_element" test_start
    "true if then fi" make_analyzed_document = document
    6 1 SourcePosition::new document.find_hover_at = result
    "is none" result.is_none assert_true
}
test_analyzed_document_hover_returns_function_fact
test_analyzed_document_hover_returns_variable_fact
test_analyzed_document_hover_returns_function_declaration_fact
test_analyzed_document_hover_returns_type_declaration_facts
test_analyzed_document_hover_returns_literal_fact
test_analyzed_document_hover_uses_contextual_literal_type
test_analyzed_document_hover_returns_assignment_fact
test_analyzed_document_hover_returns_struct_fact
test_analyzed_document_hover_returns_operator_fact
test_analyzed_document_hover_returns_intrinsic_fact
test_analyzed_document_hover_preserves_stack_effect_facts
