fn test_lexical_recovery_and_type_reference_coverage {
    "lexical_recovery_and_type_reference_coverage" test::test_start
    "fn broken { 42 \"unterminated" make_analyzed_document = damaged
    DOCUMENT_TEST_FILE damaged.get_index.find_semantic_tokens match
        document::ListAnswer::Incomplete(items _) => {
            "keyword and number survive" 2 items.length >= test::assert_true
            "keyword category" 0 items.get.kind document::DocumentTokenKind::Keyword == test::assert_true
            "number category" 1 items.get.kind document::DocumentTokenKind::Number == test::assert_true
        }
        _ => "lexical failure has partial tokens" false test::assert_true
    end
    "struct Point { x:i64 } fn take value:Point { value drop }" make_analyzed_document = snapshot
    "unrepresented annotations prevent complete references"
    false 7 DOCUMENT_TEST_FILE snapshot.get_index.find_references document::ReferenceAnswer::Incomplete is test::assert_true
}

fn test_commented_function_declaration {
    "commented_function_declaration" test::test_start
    for source in ["fn # note\nhello { }", "fn\r\nhello { }"].iter do
        source make_analyzed_document = snapshot
        source "hello" str::find u64::try_from.unwrap = offset
        "declaration hover" offset DOCUMENT_TEST_FILE snapshot.get_index.find_hover document::PointAnswer::Known is test::assert_true
        "declaration definition" offset DOCUMENT_TEST_FILE snapshot.get_index.find_definition document::PointAnswer::Known is test::assert_true
    done
}

# Check source identity through all parameter queries after analysis has released its bodies.
fn assert_parameter_queries
    index:$document::EditorIndex
    source:$str
    file:$str
    name:$str
    typ:$str
    incomplete:bool
{
    source name str::find u64::try_from.unwrap = declaration_offset
    f"\{ {name}" = body_prefix
    source body_prefix.as_str str::find u64::try_from.unwrap 2 + = usage_offset
    f"{name}: {typ}" = expected_hover
    for offset in [declaration_offset, usage_offset].iter do
        offset copy file index.find_definition match
            document::PointAnswer::Known(location) => {
                "parameter source file" file location.file test::assert_str_eq
                "parameter definition offset" declaration_offset location.offset test::assert_eq
                "parameter definition length" name.length location.length test::assert_eq
            }
            _ => "parameter definition available" false test::assert_true
        end
        offset copy file index.find_hover match
            document::PointAnswer::Known(hover) => {
                "parameter hover" expected_hover hover.content test::assert_str_eq
                "parameter hover offset" offset copy hover.location.offset test::assert_eq
                "parameter hover length" name.length hover.location.length test::assert_eq
            }
            _ => "parameter hover available" false test::assert_true
        end
        true offset copy file index.find_references match
            document::ReferenceAnswer::Complete(result) => {
                "parameter reference coverage" incomplete ! test::assert_true result
            }
            document::ReferenceAnswer::Incomplete(result reason) => {
                "parameter reference coverage" incomplete test::assert_true result
            }
            _ => {
                "parameter references available" false test::assert_true return
            }
        end = references
        "parameter declarations are unique" 2 references.ranges.length test::assert_eq
        "parameter reference declaration file" file references.declaration.file test::assert_str_eq
        "parameter reference declaration offset" declaration_offset references.declaration.offset test::assert_eq
        "parameter reference declaration length" name.length references.declaration.length test::assert_eq
        "parameter use range" usage_offset 1 references
            .ranges
            .get
            .offset test::assert_eq
    done
    false usage_offset file index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "parameter reference coverage" incomplete ! test::assert_true result
        }
        document::ReferenceAnswer::Incomplete(result reason) => {
            "parameter reference coverage" incomplete test::assert_true result
        }
        _ => {
            "parameter uses available" false test::assert_true return
        }
    end = references
    "parameter declaration excluded" 1 references.ranges.length test::assert_eq
    "" usage_offset file index.find_completions match
        document::ListAnswer::Complete(items) => {
            "parameter completion coverage" incomplete ! test::assert_true items
        }
        document::ListAnswer::Incomplete(items reason) => {
            "parameter completion coverage" incomplete test::assert_true items
        }
        _ => {
            "parameter completion available" false test::assert_true return
        }
    end = items
    typ name items assert_variable_completion_type
    for item in items.iter do
        if item.candidate document::CompletionCandidate::Variable(variable) is then
            if variable.name name == then
                "parameter completion replacement" usage_offset item.replacement.offset test::assert_eq
                "parameter completion length" name.length item.replacement.length test::assert_eq
            fi
        fi
    done
}

fn test_retained_parameter_ranges {
    "retained_parameter_ranges" test::test_start
    for
        source in [
            "fn identity value:i64 -> i64 { value }",
            "fn identity # header\nvalue # name\n: # type\ni64 -> i64 { value }",
            "fn identity\r\nvalue\r\n: i64 -> i64 { value }",
            "fn identity value:i64 -> i64 { value }\nfn broken { true 1 + drop }",
        ].iter
    do
        source make_analyzed_document = snapshot
        false "i64" "value" DOCUMENT_TEST_FILE source snapshot.get_index assert_parameter_queries
    done
    "fn identity[T] value:T -> T { value } 1 identity drop true identity drop" = generic_source
    generic_source make_analyzed_document = generic
    true "T" "value" DOCUMENT_TEST_FILE generic_source generic.get_index assert_parameter_queries
    "fn identity[const N:u64] value:array[i64 N] -> array[i64 N] { value } [1] identity drop" = constant_source
    constant_source make_analyzed_document = constant
    false "array[i64 N]" "value" DOCUMENT_TEST_FILE constant_source constant.get_index assert_parameter_queries
    "struct Item { number:i64 } impl Item { fn read self:$Item -> $Item { self } }" = method_source
    method_source make_analyzed_document = method
    false "$Item" "self" DOCUMENT_TEST_FILE method_source method.get_index assert_parameter_queries
    "import \"/tmp/editor_parameters.casa\" as peer\n1 peer::identity drop true peer::identity drop".to_str
    DOCUMENT_TEST_FILE.to_str products::SourceUnit
    "" lexer::absolute_normalize_path swap products::CompilationInput::new = input
    "pub fn identity[T] value:T -> T { value }" = imported_source
    imported_source.to_str "/tmp/editor_parameters.casa".to_str input.source_overrides.set
    input products::analyze.unwrap = imported
    true "T" "value" "/tmp/editor_parameters.casa" imported_source imported.get_index assert_parameter_queries
}

fn test_parameter_declaration_recovery {
    "parameter_declaration_recovery" test::test_start
    "extern fn read value:i64 -> i64" make_analyzed_document = external
    15 DOCUMENT_TEST_FILE external.get_index.find_hover match
        document::PointAnswer::Known(hover) => "extern parameter hover" "value: i64" hover.content test::assert_str_eq
        _ => "extern parameter declaration available" false test::assert_true
    end
    15 DOCUMENT_TEST_FILE external.get_index.find_definition match
        document::PointAnswer::Known(location) => {
            "extern parameter offset" 15 location.offset test::assert_eq
            "extern parameter length" 5 location.length test::assert_eq
        }
        _ => "extern parameter definition available" false test::assert_true
    end
    "fn broken value:i64 { true 1 + drop }" make_analyzed_document = broken_body
    10 DOCUMENT_TEST_FILE broken_body.get_index.find_hover match
        document::PointAnswer::Known(hover) => "written parameter survives body error" "value: i64" hover.content test::assert_str_eq
        _ => "written parameter remains available" false test::assert_true
    end
    "fn broken value: { value }\nfn healthy { }" make_analyzed_document = rejected
    "rejected parameter has no definition" 10 DOCUMENT_TEST_FILE rejected.get_index.find_definition document::PointAnswer::Known is ! test::assert_true
    "rejected parameter has no hover" 10 DOCUMENT_TEST_FILE rejected.get_index.find_hover document::PointAnswer::Known is ! test::assert_true
    "rejected parameter has no identity" true 10 DOCUMENT_TEST_FILE rejected.get_index.find_references document::ReferenceAnswer::Unavailable is test::assert_true
}

fn test_binding_identities_and_global_visibility {
    "binding_identities_and_global_visibility" test::test_start
    "fn add x:i64 y:i64 -> i64 { x y + }" make_analyzed_document = parameters
    true 28 DOCUMENT_TEST_FILE parameters.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "only selected parameter" 2 result.ranges.length test::assert_eq
            "parameter declaration range" 7 result.declaration.offset test::assert_eq
            "parameter declaration length" 1 result.declaration.length test::assert_eq
        }
        _ => "parameter references complete" false test::assert_true
    end
    "fn work { true if then 1 = x x drop else 2 = x x drop fi }" make_analyzed_document = branches
    true 29 DOCUMENT_TEST_FILE branches.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "only first branch binding" 2 result.ranges.length test::assert_eq
            "first branch declaration" 27 result.declaration.offset test::assert_eq
        }
        _ => "branch references complete" false test::assert_true
    end
    true 47 DOCUMENT_TEST_FILE branches.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => {
            "only second branch binding" 2 result.ranges.length test::assert_eq
            "second branch declaration" 45 result.declaration.offset test::assert_eq
        }
        _ => "second branch references complete" false test::assert_true
    end
    "" 48 DOCUMENT_TEST_FILE branches.get_index.find_completions match
        document::ListAnswer::Complete(items) => "second branch variable visible" "x" items has_completion test::assert_true
        _ => "branch completion complete" false test::assert_true
    end
    "42 = later later drop" make_analyzed_document = globals
    "" 0 DOCUMENT_TEST_FILE globals.get_index.find_completions match
        document::ListAnswer::Complete(items) => "future global hidden" "later" items has_completion ! test::assert_true
        _ => "global completion complete" false test::assert_true
    end
    "" 11 DOCUMENT_TEST_FILE globals.get_index.find_completions match
        document::ListAnswer::Complete(items) => "declared global visible" "later" items has_completion test::assert_true
        _ => "global completion complete" false test::assert_true
    end
}

fn assert_variable_completion_type
    items:$std::List[document::DocumentCompletion]
    name:$str
    typ:$str
{
    for item in items.iter do
        if item.candidate document::CompletionCandidate::Variable(variable) is then
            if variable.name name == then
                "binding completion type" typ variable.typ.format test::assert_str_eq
                return
            fi
        fi
    done
    "variable completion present" false test::assert_true
}

fn test_scoped_variable_types_and_generic_references {
    "scoped_variable_types_and_generic_references" test::test_start
    "fn work { true if then 1 = x x drop else true = x x drop fi }" make_analyzed_document = snapshot
    29 DOCUMENT_TEST_FILE snapshot.get_index.find_hover match
        document::PointAnswer::Known(value) => "first binding type" "x: i64" value.content test::assert_str_eq
        _ => "first hover available" false test::assert_true
    end
    50 DOCUMENT_TEST_FILE snapshot.get_index.find_hover match
        document::PointAnswer::Known(value) => "second binding type" "x: bool" value.content test::assert_str_eq
        _ => "second hover available" false test::assert_true
    end
    "" 50 DOCUMENT_TEST_FILE snapshot.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "bool" "x" items assert_variable_completion_type
        }
        _ => "scoped completion available" false test::assert_true
    end
    "fn identity[T] value:T -> T { value } 1 identity drop true identity drop" make_analyzed_document = generic
    true 3 DOCUMENT_TEST_FILE generic.get_index.find_references match
        document::ReferenceAnswer::Complete(result) => "both specializations share declaration" 3 result.ranges.length test::assert_eq
        _ => "generic references complete" false test::assert_true
    end
}

fn test_capture_definition_and_borrowed_completion {
    "capture_definition_and_borrowed_completion" test::test_start
    "fn outer {\n    1 = value\n    { value print } = closure\n    value print\n}" make_analyzed_document = captured
    31 DOCUMENT_TEST_FILE captured.get_index.find_definition match
        document::PointAnswer::Known(location) => "enclosing binding definition" 19 location.offset test::assert_eq
        _ => "captured definition available" false test::assert_true
    end
    "struct Item { value:i64 } impl Item { fn read self:$Item -> i64 { self.value } fn consume self:Item { self drop } } fn use item:$Item { item.read drop }" make_analyzed_document = borrowed
    "." 141 DOCUMENT_TEST_FILE borrowed.get_index.find_completions match
        document::ListAnswer::Complete(items) => {
            "shared receiver read available" "read" items has_completion test::assert_true
            "shared receiver cannot consume" "consume" items has_completion ! test::assert_true
        }
        _ => "borrowed completion complete" false test::assert_true
    end
}
