# Complete references to the `name` declared at `declaration` list it and its one
# use at `usage`, and the use defines back to the declaration.
fn assert_member_use index:$document::EditorIndex name:$str declaration:u64 usage:u64 {
    true declaration DOCUMENT_TEST_FILE index.find_references match
        document::ReferenceAnswer::Complete(result) => result.into_ranges
        _ => {
            f"`{name}` references complete" false test::assert_true return
        }
    end = ranges
    f"`{name}` declaration and use" 2 ranges.length test::assert_eq
    f"`{name}` use offset" usage 1 ranges.get.offset test::assert_eq
    f"`{name}` use length" name.length 1 ranges.get.length test::assert_eq
    usage DOCUMENT_TEST_FILE index.find_definition match
        document::PointAnswer::Known(location) => f"`{name}` use definition" declaration location.offset test::assert_eq
        _ => f"`{name}` use definition available" false test::assert_true
    end
    f"`{name}` use hover" usage DOCUMENT_TEST_FILE index.find_hover document::PointAnswer::Known is test::assert_true
}

fn test_members_after_type_arguments {
    "members_after_type_arguments" test::test_start
    TRAILING_MEMBER_SOURCE make_analyzed_document = snapshot
    "valid member source" snapshot.is_incomplete ! test::assert_true
    snapshot.get_index = index
    TRAILING_MEMBER_SOURCE "new drop" str::find u64::try_from.unwrap = new_use
    new_use TRAILING_MEMBER_SOURCE "new inner" str::find u64::try_from.unwrap "new" index assert_member_use
    TRAILING_MEMBER_SOURCE "Nothing drop" str::find u64::try_from.unwrap
    TRAILING_MEMBER_SOURCE "Nothing Just" str::find u64::try_from.unwrap "Nothing" index assert_member_use
    TRAILING_MEMBER_SOURCE "Boxed[i64]::new" str::find u64::try_from.unwrap = boxed_use
    DOCUMENT_TEST_FILE index.find_semantic_tokens match
        document::ListAnswer::Complete(items) => items
        document::ListAnswer::Incomplete(items _) => items
        _ => {
            "member semantic tokens available" false test::assert_true return
        }
    end = tokens
    false = type_token
    false = member_token
    for token in tokens.iter do
        if token.location.offset boxed_use == token.kind document::DocumentTokenKind::Type == && then
            true = type_token
        fi
        if token.location.offset new_use == token.kind document::DocumentTokenKind::Function == && then
            true = member_token
        fi
    done
    "type token before type arguments" type_token test::assert_true
    "member token after type arguments" member_token test::assert_true
}

fn test_members_with_type_argument_trivia {
    "members_with_type_argument_trivia" test::test_start
    "struct Boxed[T] { inner: T }\nimpl[T] Boxed[T] { fn new inner:T -> Boxed[T] { inner Boxed } }" = declarations
    for
        usage in [
            "Boxed[i64]\n::new",
            "Boxed[i64]:: # comment\nnew",
            "Boxed[ # ] in comment\ni64]::new",
            "Boxed[i64] : # separator comment\n: new",
            "&Boxed[i64]:: # reference comment\nnew exec",
        ].iter
    do
        f"{declarations}\n1 {usage} drop" = source
        source.as_str make_analyzed_document = snapshot
        "valid member trivia" snapshot.is_incomplete ! test::assert_true
        source.as_str "new" str::find u64::try_from.unwrap = declaration
        source.as_str "1 " str::find u64::try_from.unwrap = body_start
        source.as_str body_start source.length body_start - str::substring = body
        body.as_str "new" str::find u64::try_from.unwrap body_start + = use
        use declaration "new" snapshot.get_index assert_member_use
    done
}

# Offsets of `name` as a whole word in `source`, outside the first `excluded` span.
fn find_word_offsets source:$str name:$str excluded:$str -> std::List[u64] {
    source excluded str::find = excluded_start
    std::List[u64]::new = offsets
    0 = offset: u64
    while offset name.length + source.length <= do
        offset = start
        1 += offset
        if source start name.length str::substring name != then
            continue
        fi
        if 0 start != then
            start 1 - source.at.unwrap = before
            if before.is_alpha before.is_digit || '_' before == || then
                continue
            fi
        fi
        start name.length + = end_offset
        if end_offset source.length < then
            end_offset source.at.unwrap = after
            if after.is_alpha after.is_digit || '_' after == || then
                continue
            fi
        fi
        if 0 excluded_start <= then
            excluded_start u64::try_from.unwrap = skipped
            if skipped start <= start skipped excluded.length + < && then
                continue
            fi
        fi
        start offsets.push
    done
    offsets
}

# `ranges` from `first` on name `length` bytes at each of `offsets` in `file`.
fn assert_reference_ranges
    ranges:$std::List[document::DocumentLocation]
    first:u64
    file:$str
    offsets:$std::List[u64]
    length:u64
{
    for index in offsets.length 0 std::Range::new do
        first index + = position
        index offsets.get copy = expected
        if ranges.length position <= then
            f"reference {position} at {expected} exists" false test::assert_true return
        fi
        position ranges.get = range
        f"reference {position} file" file range.file test::assert_str_eq
        f"reference {position} offset" expected range.offset test::assert_eq
        f"reference {position} length" length range.length test::assert_eq
    done
}
