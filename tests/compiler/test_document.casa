# References from `offset` in `file`, with or without complete coverage.
fn collect_reference_ranges
    index:$document::EditorIndex
    file:$str
    offset:u64
-> std::List[document::DocumentLocation] {
    true offset file index.find_references match
        document::ReferenceAnswer::Complete(result) => result.into_ranges
        document::ReferenceAnswer::Incomplete(result _) => result.into_ranges
        document::ReferenceAnswer::Unavailable(_) => std::List[document::DocumentLocation]::new
    end
}
