fn assert_binding_definition index:$document::EditorIndex usage:u64 declaration:u64 {
    usage DOCUMENT_TEST_FILE index.find_definition match
        document::PointAnswer::Known(location) => {
            "binding declaration offset" declaration location.offset test::assert_eq
            "binding declaration length" 5 location.length test::assert_eq
        }
        _ => "checked binding definition available" false test::assert_true
    end
}

fn assert_binding_references index:$document::EditorIndex usage:u64 declaration:u64 count:u64 {
    true usage DOCUMENT_TEST_FILE index.find_references match
        document::ReferenceAnswer::Complete(result) => result
        document::ReferenceAnswer::Incomplete(result _) => result
        _ => {
            "checked binding references available" false test::assert_true return
        }
    end = result
    "binding reference count" count result.ranges.length test::assert_eq
    "binding reference declaration" declaration result.declaration.offset test::assert_eq
}

fn assert_binding_visibility index:$document::EditorIndex offset:u64 visible:bool {
    "" offset DOCUMENT_TEST_FILE index.find_completions match
        document::ListAnswer::Complete(items) => items
        document::ListAnswer::Incomplete(items _) => items
        _ => {
            "checked binding completion available" false test::assert_true return
        }
    end = items
    f"binding lexical visibility at {offset}, expected {visible}" visible "value" items has_completion test::assert_eq
}

