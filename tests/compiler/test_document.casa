pub fn test_analyzed_document_hover_returns_operator_fact {
    "analyzed_document_hover_returns_operator_fact" test::test_start
    "1 2 +" make_analyzed_document = document
    5 1 common::SourcePosition::new document.find_hover_at = result
    "content" "+: T T -> T (same-width integers)" result.unwrap.content test::assert_str_eq

    "3 2 <<" make_analyzed_document = left_shift
    5 1 common::SourcePosition::new left_shift.find_hover_at = left_result
    "left shift consumes count first" "<<: u64 T -> T (integer T)" left_result.unwrap.content test::assert_str_eq
    "12 2 >>" make_analyzed_document = right_shift
    6 1 common::SourcePosition::new right_shift.find_hover_at = right_result
    "right shift consumes count first" ">>: u64 T -> T (integer T)" right_result.unwrap.content test::assert_str_eq
}

