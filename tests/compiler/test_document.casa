# Early-exit bindings stay visible until the end of the enclosing body. A
# binding scoped inside the condition keeps its own visibility.
fn test_checked_early_exit_binding {
    "checked_early_exit_binding" test::test_start
    "enum Choice { Some(i64) None } fn work { if 1 Choice::Some Choice::Some(value) is else return fi value drop } 0 drop" make_analyzed_document = snapshot
    "valid binding source" snapshot.is_incomplete ! test::assert_true
    72 97 snapshot.get_index assert_binding_definition
    2 72 97 snapshot.get_index assert_binding_references
    false 87 snapshot.get_index assert_binding_visibility
    true 97 snapshot.get_index assert_binding_visibility
    true 108 snapshot.get_index assert_binding_visibility
    false 110 snapshot.get_index assert_binding_visibility
    "enum Choice { Some(i64) None } fn work { while true do if 1 Choice::Some Choice::Some(value) is else break fi value drop done 0 drop }" make_analyzed_document = loop_snapshot
    "valid loop binding source" loop_snapshot.is_incomplete ! test::assert_true
    86 110 loop_snapshot.get_index assert_binding_definition
    false 101 loop_snapshot.get_index assert_binding_visibility
    true 110 loop_snapshot.get_index assert_binding_visibility
    false 126 loop_snapshot.get_index assert_binding_visibility
    "fn work a:bool { if if a then 1 = value value drop true else false fi else return fi 2 drop }" make_analyzed_document = nested_snapshot
    "valid nested binding source" nested_snapshot.is_incomplete ! test::assert_true
    true 40 nested_snapshot.get_index assert_binding_visibility
    false 85 nested_snapshot.get_index assert_binding_visibility
}

