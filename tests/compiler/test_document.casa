pub fn test_analyzed_document_hover_marks_unsafe_function {
    "analyzed_document_hover_marks_unsafe_function" test::test_start
    "unsafe fn read -> i64 { 1 }" make_analyzed_document = document
    11 1 common::SourcePosition::new document.find_hover_at = result
    if result std::Option::Some(hover) is then
        "content" "unsafe fn read -> i64" hover.content test::assert_str_eq
    else
        "is some" false test::assert_true
    fi
}

pub fn test_analyzed_document_hover_returns_type_declaration_facts {
    "analyzed_document_hover_returns_type_declaration_facts" test::test_start
    "struct Point {\n    x: i64\n}\nenum Color { Red }" make_analyzed_document = document
    8 1 common::SourcePosition::new document.find_hover_at = struct_result
    if struct_result std::Option::Some(struct_hover) is then
        "struct content" "struct Point { x: i64 }" struct_hover.content test::assert_str_eq
    else
        "struct is some" false test::assert_true
    fi
    6 4 common::SourcePosition::new document.find_hover_at = enum_result
    if enum_result std::Option::Some(enum_hover) is then
        "enum content" "enum Color { Red }" enum_hover.content test::assert_str_eq
    else
        "enum is some" false test::assert_true
    fi
    14 4 common::SourcePosition::new document.find_hover_at = variant_result
    if variant_result std::Option::Some(variant_hover) is then
        "variant content" "Color::Red" variant_hover.content test::assert_str_eq
    else
        "variant is some" false test::assert_true
    fi
}

pub fn test_analyzed_document_hover_returns_literal_fact {
    "analyzed_document_hover_returns_literal_fact" test::test_start
    "42 1.5 \"hello\" drop drop drop" make_analyzed_document = document
    1 1 common::SourcePosition::new document.find_hover_at = int_result
    "i64 content" "42: i64" int_result.unwrap.content test::assert_str_eq
    4 1 common::SourcePosition::new document.find_hover_at = float_result
    "f64 content" "1.5: f64" float_result.unwrap.content test::assert_str_eq
    8 1 common::SourcePosition::new document.find_hover_at = string_result
    "string content" "\"hello\": str" string_result.unwrap.content test::assert_str_eq
}

pub fn test_analyzed_document_hover_uses_contextual_literal_type {
    "analyzed_document_hover_uses_contextual_literal_type" test::test_start
    "1.5 = value:f32" make_analyzed_document = document
    1 1 common::SourcePosition::new document.find_hover_at = result
    "content" "1.5: f32" result.unwrap.content test::assert_str_eq
}

