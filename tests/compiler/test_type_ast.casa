import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../compiler/syntax.casa" as syntax
import "../../lib/test.casa" as test

pub fn assert_round_trip source:$str {
    f"round-trip {source}" source source common::parse_type_str.format test::assert_str_eq
}

pub fn test_round_trip_builtins {
    "Type round-trip builtins" test::test_start
    "i64" assert_round_trip
    "bool" assert_round_trip
    "char" assert_round_trip
    "cstr" assert_round_trip
    "str" assert_round_trip
    "ptr" assert_round_trip
}

pub fn test_round_trip_generics {
    "Type round-trip generics" test::test_start
    "List[i64]" assert_round_trip
    "Option[str]" assert_round_trip
    "Map[str i64]" assert_round_trip
    "List[List[i64]]" assert_round_trip
    "Map[str List[i64]]" assert_round_trip
}

pub fn test_round_trip_typevar {
    "Type round-trip TypeVar" test::test_start
    "T" assert_round_trip
    "K" assert_round_trip
    "V" assert_round_trip
}

pub fn test_round_trip_named {
    "Type round-trip named (no params)" test::test_start
    "Token" assert_round_trip
    "Function" assert_round_trip
    "MyStruct" assert_round_trip
}

pub fn test_round_trip_function {
    "Type round-trip Function" test::test_start
    "fn" assert_round_trip
    "fn[i64 -> i64]" assert_round_trip
    "fn[i64 i64 -> i64]" assert_round_trip
    "fn[i64 -> i64 i64]" assert_round_trip
    "fn[List[i64] -> Option[str]]" assert_round_trip
}

pub fn test_round_trip_const_argument {
    "Type round-trip const argument" test::test_start
    "array[i64 3]" assert_round_trip
    "array[i64 0]" assert_round_trip
    "array[T 0]" assert_round_trip
}

pub fn test_const_argument_distinct {
    "Type const arguments do not unify" test::test_start
    "array[i64 3]" common::parse_type_str = three
    "array[i64 4]" common::parse_type_str = four
    "array[i64 3]" common::parse_type_str = three_again
    "3 differs from 4" three four.eq test::assert_false
    "3 equals 3" three_again three.eq test::assert_true
}

pub fn assert_substitute source:$str expected:$str subs:$std::Map[std::String common::Type] {
    subs source common::parse_type_str.substitute_t.format = result
    f"substitute {source}" expected result test::assert_str_eq
}

pub fn test_substitute_function {
    "Type::substitute on Function" test::test_start
    std::Map[std::String common::Type]::new = subs
    common::make_i64_type.clone "T".to_str subs.set
    subs "fn[i64]" "fn[T]" assert_substitute
    subs "fn[i64 -> str]" "fn[T -> str]" assert_substitute
    subs "fn[i64 i64 -> i64]" "fn[T T -> T]" assert_substitute
    subs "fn[i64 -> U]" "fn[T -> U]" assert_substitute
    subs "fn[List[i64] -> Option[i64]]" "fn[List[T] -> Option[T]]" assert_substitute
}

pub fn test_substitute_borrow_capability {
    "Type::substitute preserves borrow capability" test::test_start
    std::Map[std::String common::Type]::new = shared_substitutions
    "$i64" common::parse_type_str "T".to_str shared_substitutions.set
    shared_substitutions "$i64" "$T" assert_substitute
    shared_substitutions "$i64" "mut$T" assert_substitute

    std::Map[std::String common::Type]::new = exclusive_substitutions
    "mut$i64" common::parse_type_str "T".to_str exclusive_substitutions.set
    exclusive_substitutions "$i64" "$T" assert_substitute
    exclusive_substitutions "mut$i64" "mut$T" assert_substitute
}
test_round_trip_builtins
test_round_trip_generics
test_round_trip_typevar
test_round_trip_named
test_round_trip_function
test_round_trip_const_argument
test_const_argument_distinct
test_substitute_function
test_substitute_borrow_capability
test::test_summary
