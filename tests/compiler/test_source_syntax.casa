import "std" as std
import "../../compiler/syntax.casa" as syntax
import "../../compiler/products.casa" as products
import "../../lib/test.casa" as test

fn assert_valid source:$str {
    source.to_str "test".to_str products::SourceUnit products::syntax.unwrap = result
    source result.get_facts.is_some test::assert_true
    "no diagnostics" result
        .get_report
        .get_diagnostics
        .has_errors ! test::assert_true
}

fn assert_invalid source:$str {
    source.to_str "test".to_str products::SourceUnit products::syntax.unwrap = result
    source result.get_facts.is_none test::assert_true
    "diagnostic retained" result
        .get_report
        .get_diagnostics
        .has_errors test::assert_true
    "tokens retained" 0 result.get_tokens.length < test::assert_true
}

fn test_grammar {
    "grammar_without_declarations" test::test_start
    "import \"missing\" as dependency const alias missing_constant fn use[T:MissingTrait] value:T { value unknown }" assert_valid
    "fn N {} struct S {} N {} S {}" assert_valid
    "Unknown { value: 1 = temporary: i64 temporary nested: Other { field: 2 } }" assert_valid
    "fn use { name { 1 call } [Unknown { field: 1 }, { 2 }] }" assert_valid
    "value match Unknown { field: binding } if binding 0 > => { binding } Other::Case(item) => item end" assert_valid
    "if Unknown::Case(value) is then value else 0 fi" assert_valid
    "fn outer callback:fn[i64 -> i64] -> fn[i64 -> i64] { callback }" assert_valid
    "trait Example { fn required self:$Self -> Unknown fn default self:$Self { self } }" assert_valid
    "extern fn native\n    argument:$Unknown\n-> Unknown\nfn next {}" assert_valid
    "Name [i64] :: new" assert_valid
    "name[1, 2]" assert_valid
    "&function[Type]" assert_valid
    "Name[Type]::member" assert_valid
    "[1, 2,]" assert_valid
    "" assert_valid
    "# only trivia\n" assert_valid
    "struct Holder { callback:fn } fn run callback:fn { callback call } fn other fn { call }" assert_valid
    "fn identity[,T,,U] value:T -> T { value }" assert_valid
    "size_of[Unknown] ptr::read[Unknown] ptr::write[Unknown] ptr::as_ref[Unknown] ptr::as_mut[Unknown] ptr::from_raw[Unknown]" assert_valid
    "const one 1 const alias missing const sum:i64 { one one + }" assert_valid
    "global value 1" assert_invalid
    "pub global value 1" assert_invalid
    "extern enum E { A }" assert_invalid
    "extern fn f {}" assert_invalid
    "extern fn f[Type]" assert_invalid
    "extern fn f -> i64 i64" assert_invalid
    "fn f -> -> i64 { 1 }" assert_invalid
    "fn f -> result:i64 { 1 }" assert_invalid
    "const value +" assert_invalid
    "const value fn f {}" assert_invalid
    "size_of" assert_invalid
    "size_of[]" assert_invalid
    "size_of[i64 i64]" assert_invalid
    "ptr::read" assert_valid
    "ptr::read[]" assert_invalid
    "[Enum::Case(value) is]" assert_invalid
    "[List[i64]::new]" assert_invalid
    "Unknown { field: }" assert_invalid
    "Unknown { first: 1 second: }" assert_invalid
    "fn broken {" assert_invalid
    "if true then 1" assert_invalid
    "while true do 1" assert_invalid
    "[1 2]" assert_invalid
    "[1, 2" assert_invalid
    "value match Case => 1" assert_invalid
    "fn missing_name" assert_invalid
    "fn broken value:" assert_invalid
    "}" assert_invalid
    "const value" assert_invalid
    "import 42" assert_invalid
    "import \"missing\" { Name }" assert_invalid
    "import \"missing\" {}" assert_invalid
    "import \"missing\" as dependency {\n Name\n}" assert_invalid
    "[Name { 1 }]" assert_invalid
}

fn test_parsed_imports {
    "parsed_imports" test::test_start
    "source.casa" "import \"std\"\nimport \"../tool.casa\" as tool" syntax::analyze_syntax.into_parts = diagnostics = facts = tokens
    "valid imports" diagnostics.has_errors ! test::assert_true
    facts.unwrap = syntax_facts
    "source order" 2 syntax_facts.imports.length test::assert_eq
    0 syntax_facts.imports.get = first
    "decoded specifier" "std" first.specifier test::assert_str_eq
    "implicit alias" first.alias.is_none test::assert_true
    1 syntax_facts.imports.get = second
    "path specifier" "../tool.casa" second.specifier test::assert_str_eq
    if second.alias std::Option::Some(alias) is then
        "written alias" "tool" alias test::assert_str_eq
    else
        "written alias retained" false test::assert_true
    fi
    "source attribution" "source.casa" second.location.file test::assert_str_eq
    "path location" 20 second
        .location
        .span
        .offset test::assert_eq
}

fn test_structure {
    "structure_and_spelling" test::test_start
    "test" "Name [i64] :: new" syntax::analyze_syntax.into_parts = first_diagnostics = first_facts = first_tokens
    "test" "Name[i64]::new" syntax::analyze_syntax.into_parts = second_diagnostics = second_facts = second_tokens
    "adjacency changes grammar" second_facts.unwrap first_facts.unwrap syntax::syntax_facts_match ! test::assert_true
    "test" "Name { field: 1 } # note\n" syntax::analyze_syntax.into_parts = original_diagnostics = original = original_tokens
    "test" "Name {\n field: 1\n} # note\n" syntax::analyze_syntax.into_parts = formatted_diagnostics = formatted = formatted_tokens
    "layout keeps structure" formatted.unwrap original.unwrap syntax::syntax_facts_match test::assert_true
    "test" "$module::Type" syntax::analyze_syntax.into_parts = name_diagnostics = name_facts = name_tokens
    name_facts.unwrap = names
    "qualified name segments" 2 names.name_segments.length test::assert_eq
    "first segment starts after borrow" 1 0 names
        .name_segments
        .get
        .start test::assert_eq
    "second segment start" 9 1 names
        .name_segments
        .get
        .start test::assert_eq
    "second segment length" 4 1 names
        .name_segments
        .get
        .length test::assert_eq
    "test" "00042" syntax::analyze_syntax.into_parts = integer_diagnostics = integer_facts = integer_tokens
    "literal spelling" "00042" 0 integer_facts
        .unwrap
        .meaningful_tokens
        .get
        .spelling test::assert_str_eq
}

fn test_parsed_constants {
    "parsed_constants" test::test_start
    "constants.casa" "const ALIAS dependency::VALUE\nconst TOTAL:u8 { # comment\n ALIAS 2 - dup + }\nconst BAD { size_of[i64] }" syntax::analyze_syntax.into_parts = diagnostics = facts = tokens
    "syntax does not resolve or evaluate" diagnostics.has_errors ! test::assert_true
    facts.unwrap = parsed
    if
        0 parsed
            .declarations
            .get
            .constant std::Option::Some(alias) is
    then
        "alias is contextual" alias.block ! test::assert_true
        "alias reference" 0 alias
            .terms
            .get
            .kind syntax::ConstantTermKind::Reference is test::assert_true
        "qualified spelling" "dependency::VALUE" 0 alias
            .terms
            .get
            .spelling test::assert_str_eq
    else
        "alias initializer retained" false test::assert_true
    fi
    if
        1 parsed
            .declarations
            .get
            .constant std::Option::Some(total) is
    then
        "bounded block" total.block test::assert_true
        "trivia is excluded" 5 total.terms.length test::assert_eq
        if total.annotation std::Option::Some(annotation) is then
            if annotation syntax::ConstantAnnotation::Name(name _) is then
                "annotation spelling" "u8" name test::assert_str_eq
            else
                "primitive annotation" false test::assert_true
            fi
        else
            "annotation retained" false test::assert_true
        fi
        "literal term" 1 total
            .terms
            .get
            .kind syntax::ConstantTermKind::Literal is test::assert_true
        "operator term" 2 total
            .terms
            .get
            .kind syntax::ConstantTermKind::Operator is test::assert_true
        "stack term" 3 total
            .terms
            .get
            .kind syntax::ConstantTermKind::StackIntrinsic is test::assert_true
        "term source" "constants.casa" 2 total
            .terms
            .get
            .location
            .file test::assert_str_eq
    else
        "block initializer retained" false test::assert_true
    fi
    if
        2 parsed
            .declarations
            .get
            .constant std::Option::Some(unsupported) is
    then
        "layout query retained for rejection" 0 unsupported
            .terms
            .get
            .kind syntax::ConstantTermKind::Unsupported is test::assert_true
    else
        "unsupported initializer retained" false test::assert_true
    fi
}

fn test_parsed_declaration_headers {
    "parsed_declaration_headers" test::test_start
    "declarations.casa" "import \"missing\" as peer\nextern struct Native { pub tag:peer::Tag bytes:array[u8 LIMIT] }\nstruct Box[T const N:u64] derives peer::Copy { value:T callback:fn[$T -> T] }\nenum Choice[T] { Empty Value(T array[u8 LIMIT]) }\ntrait Mapper[T]: peer::Base[T] + peer::Other { fn required self:mut$self value:T -> T fn map[U] self:$self value:U -> U { value } }"
    syntax::analyze_syntax.into_parts = diagnostics = facts = tokens
    "unresolved declaration syntax accepted" diagnostics.has_errors ! test::assert_true
    facts.unwrap = parsed
    "declarations retained in source order" 4 parsed.declarations.length test::assert_eq
    0 parsed.declarations.get = native
    "extern distinction" native.external test::assert_true
    if native.header std::Option::Some(header) is then
        if header syntax::DeclarationHeader::Aggregate(aggregate) is then
            "field order" 2 aggregate.members.length test::assert_eq
            0 aggregate.members.get = tag
            "field visibility" tag.public test::assert_true
            "field spelling" "tag" tag.name_token tokens.get.value test::assert_str_eq
            if tag.payload std::Option::Some(types) is then
                "qualified type spelling" "peer::Tag" 0 types.get.token tokens.get.value test::assert_str_eq
            fi
            "private field" 1 aggregate
                .members
                .get
                .public ! test::assert_true
        else
            "struct header" false test::assert_true
        fi
    else
        "struct header retained" false test::assert_true
    fi
    if
        1 parsed
            .declarations
            .get
            .header std::Option::Some(header) is
    then
        if header syntax::DeclarationHeader::Aggregate(aggregate) is then
            if aggregate.parameters std::Option::Some(parameters) is then
                "generic parameter order" 2 parameters.parameters.length test::assert_eq
                "constant parameter distinction" 1 parameters
                    .parameters
                    .get
                    .constant
                    .is_some test::assert_true
            else
                "generic parameters retained" false test::assert_true
            fi
            "derive spelling" "peer::Copy" 0 aggregate.derives.get copy tokens.get.value test::assert_str_eq
            if
                1 aggregate
                    .members
                    .get
                    .payload std::Option::Some(types) is
            then
                types
            else
                "callback type retained" false test::assert_true return
            fi = callback_types
            if 0 callback_types.get.arguments std::Option::Some(arguments) is then
                "callback parameters" 1 arguments.parameters.length test::assert_eq
                "callback returns" 1 arguments.returns.length test::assert_eq
            else
                "function type retained" false test::assert_true
            fi
        fi
    fi
    if
        2 parsed
            .declarations
            .get
            .header std::Option::Some(header) is
    then
        if header syntax::DeclarationHeader::Aggregate(aggregate) is then
            "unit variant" 0 aggregate
                .members
                .get
                .payload
                .is_none test::assert_true
            if
                1 aggregate
                    .members
                    .get
                    .payload std::Option::Some(types) is
            then
                "variant payload order" 2 types.length test::assert_eq
                "first payload" "T" 0 types.get.token tokens.get.value test::assert_str_eq
            else
                "variant payload retained" false test::assert_true
            fi
        fi
    fi
    if
        3 parsed
            .declarations
            .get
            .header std::Option::Some(header) is
    then
        if header syntax::DeclarationHeader::Trait(trait_header) is then
            "supertrait order" 2 trait_header.supertraits.length test::assert_eq
            "method order" 2 trait_header.methods.length test::assert_eq
            0 trait_header.methods.get = required
            1 trait_header.methods.get = default
            "requirement has no body" required.body_token.is_none test::assert_true
            "default body retained" default.body_token.is_some test::assert_true
            "receiver capability" "mut$self" 0 required
                .signature
                .parameters
                .get
                .typ
                .token tokens.get.value test::assert_str_eq
            if
                1 default
                    .signature
                    .parameters
                    .get
                    .name_token std::Option::Some(position) is
            then
                position tokens.get = parameter
                "parameter spelling" "value" parameter.value test::assert_str_eq
                "parameter source" "declarations.casa" parameter.location.file test::assert_str_eq
                "parameter range" 5 parameter
                    .location
                    .span
                    .length test::assert_eq
            else
                "named parameter range retained" false test::assert_true
            fi
            if default.body_token std::Option::Some(position) is then
                "default starts at body" "{" position tokens.get.value test::assert_str_eq
            fi
        else
            "trait header" false test::assert_true
        fi
    else
        "trait header retained" false test::assert_true
    fi
}
test_parsed_declaration_headers
test_grammar
test_structure
test_parsed_imports
test_parsed_constants
test::test_summary
