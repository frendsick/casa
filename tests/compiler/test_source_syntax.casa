import "std" as std
import "../../compiler/syntax.casa" as syntax
import "../../lib/test.casa" as test

fn assert_valid source:$str {
    "test" source syntax::analyze_syntax.into_parts = diagnostics = facts = tokens
    source facts.is_some test::assert_true
    "no diagnostics" diagnostics.has_errors ! test::assert_true
}

fn assert_invalid source:$str {
    "test" source syntax::analyze_syntax.into_parts = diagnostics = facts = tokens
    source facts.is_none test::assert_true
    "diagnostic retained" diagnostics.has_errors test::assert_true
    "tokens retained" 0 tokens.length > test::assert_true
}

fn test_grammar {
    "grammar_without_declarations" test::test_start
    "import \"missing\" as dependency const alias missing_constant fn use[T:MissingTrait] value:T { value unknown }" assert_valid
    "fn N {} struct S {} N {} S {}" assert_valid
    "Unknown { value: 1 = temporary: i64 temporary nested: Other { field: 2 } }" assert_valid
    "fn use { name { 1 call } [Unknown { field: 1 }, { 2 }] }" assert_valid
    "value match Unknown { field: binding } if binding 0 > => { binding } Other::Case(item) => item end" assert_valid
    "if Unknown::Case(value) is then value else 0 fi" assert_valid
    "fn outer callback:fn[i64 -> i64] -> fn[i64 -> i64] { callback }" assert_valid
    "trait Example { fn required self:$Self -> Unknown fn default self:$Self { self } }" assert_valid
    "extern fn native\n    argument:$Unknown\n-> Unknown\nfn next {}" assert_valid
    "Name [i64] :: new" assert_valid
    "name[1, 2]" assert_valid
    "&function[Type]" assert_valid
    "Name[Type]::member" assert_valid
    "[1, 2,]" assert_valid
    "" assert_valid
    "# only trivia\n" assert_valid
    "struct Holder { callback:fn } fn run callback:fn { callback call } fn other fn { call }" assert_valid
    "fn identity[,T,,U] value:T -> T { value }" assert_valid
    "size_of[Unknown] ptr::read[Unknown] ptr::write[Unknown] ptr::as_ref[Unknown] ptr::as_mut[Unknown] ptr::from_raw[Unknown]" assert_valid
    "const one 1 const alias missing const sum:i64 { one one + }" assert_valid
    "extern enum E { A }" assert_invalid
    "extern fn f {}" assert_invalid
    "extern fn f[Type]" assert_invalid
    "extern fn f -> i64 i64" assert_invalid
    "fn f -> -> i64 { 1 }" assert_invalid
    "fn f -> result:i64 { 1 }" assert_invalid
    "const value +" assert_invalid
    "const value fn f {}" assert_invalid
    "size_of" assert_invalid
    "size_of[]" assert_invalid
    "size_of[i64 i64]" assert_invalid
    "ptr::read" assert_valid
    "ptr::read[]" assert_invalid
    "[Enum::Case(value) is]" assert_invalid
    "[List[i64]::new]" assert_invalid
    "Unknown { field: }" assert_invalid
    "Unknown { first: 1 second: }" assert_invalid
    "fn broken {" assert_invalid
    "if true then 1" assert_invalid
    "while true do 1" assert_invalid
    "[1 2]" assert_invalid
    "[1, 2" assert_invalid
    "value match Case => 1" assert_invalid
    "fn missing_name" assert_invalid
    "fn broken value:" assert_invalid
    "}" assert_invalid
    "const value" assert_invalid
    "import 42" assert_invalid
    "import \"missing\" { Name }" assert_invalid
    "import \"missing\" {}" assert_invalid
    "import \"missing\" as dependency {\n Name\n}" assert_invalid
    "[Name { 1 }]" assert_invalid
}

fn test_parsed_imports {
    "parsed_imports" test::test_start
    "source.casa" "import \"std\"\nimport \"../tool.casa\" as tool" syntax::analyze_syntax.into_parts = diagnostics = facts = tokens
    "valid imports" diagnostics.has_errors ! test::assert_true
    facts.unwrap = syntax_facts
    "source order" 2 syntax_facts.imports.length test::assert_eq
    0 syntax_facts.imports.get = first
    "decoded specifier" "std" first.specifier test::assert_str_eq
    "implicit alias" first.alias.is_none test::assert_true
    1 syntax_facts.imports.get = second
    "path specifier" "../tool.casa" second.specifier test::assert_str_eq
    if second.alias std::Option::Some(alias) is then
        "written alias" "tool" alias test::assert_str_eq
    else
        "written alias retained" false test::assert_true
    fi
    "source attribution" "source.casa" second.location.file test::assert_str_eq
    "path location" 20 second
        .location
        .span
        .offset test::assert_eq
}

fn test_structure {
    "structure_and_spelling" test::test_start
    "test" "Name [i64] :: new" syntax::analyze_syntax.into_parts = first_diagnostics = first_facts = first_tokens
    "test" "Name[i64]::new" syntax::analyze_syntax.into_parts = second_diagnostics = second_facts = second_tokens
    "adjacency changes grammar" second_facts.unwrap first_facts.unwrap syntax::syntax_facts_match ! test::assert_true
    "test" "Name { field: 1 } # note\n" syntax::analyze_syntax.into_parts = original_diagnostics = original = original_tokens
    "test" "Name {\n field: 1\n} # note\n" syntax::analyze_syntax.into_parts = formatted_diagnostics = formatted = formatted_tokens
    "layout keeps structure" formatted.unwrap original.unwrap syntax::syntax_facts_match test::assert_true
    "test" "$module::Type" syntax::analyze_syntax.into_parts = name_diagnostics = name_facts = name_tokens
    name_facts.unwrap = names
    "qualified name segments" 2 names.name_segments.length test::assert_eq
    "first segment starts after borrow" 1 0 names
        .name_segments
        .get
        .start test::assert_eq
    "second segment start" 9 1 names
        .name_segments
        .get
        .start test::assert_eq
    "second segment length" 4 1 names
        .name_segments
        .get
        .length test::assert_eq
    "test" "00042" syntax::analyze_syntax.into_parts = integer_diagnostics = integer_facts = integer_tokens
    "literal spelling" "00042" 0 integer_facts
        .unwrap
        .meaningful_tokens
        .get
        .spelling test::assert_str_eq
}
test_grammar
test_structure
test_parsed_imports
test::test_summary
