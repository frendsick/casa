import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../compiler/syntax.casa" as syntax
import "../../lib/test.casa" as test

pub fn test_source_store_converts_offsets_and_positions {
    "source_store_converts_offsets_and_positions" test::test_start
    lexer::SourceStore::new = sources
    "positions.casa" = path
    "abc\ndef\n" path sources.add

    0 path sources.convert_offset_to_position.unwrap = first
    "first line" 1 first.line test::assert_eq
    "first column" 1 first.column test::assert_eq

    3 path sources.convert_offset_to_position.unwrap = first_end_position
    "first end line" 1 first_end_position.line test::assert_eq
    "first end column" 4 first_end_position.column test::assert_eq

    4 path sources.convert_offset_to_position.unwrap = middle_start_position
    "middle start line" 2 middle_start_position.line test::assert_eq
    "middle start column" 1 middle_start_position.column test::assert_eq

    5 path sources.convert_offset_to_position.unwrap = middle
    "middle line" 2 middle.line test::assert_eq
    "middle column" 2 middle.column test::assert_eq

    7 path sources.convert_offset_to_position.unwrap = middle_end_position
    "middle end line" 2 middle_end_position.line test::assert_eq
    "middle end column" 4 middle_end_position.column test::assert_eq

    8 path sources.convert_offset_to_position.unwrap = final
    "final line" 3 final.line test::assert_eq
    "final column" 1 final.column test::assert_eq

    4 1 common::SourcePosition::new path sources.convert_position_to_offset.unwrap = first_end
    "first line end" 3 first_end test::assert_eq
    1 2 common::SourcePosition::new path sources.convert_position_to_offset.unwrap = middle_start
    "middle line start" 4 middle_start test::assert_eq
    4 2 common::SourcePosition::new path sources.convert_position_to_offset.unwrap = middle_end
    "middle line end" 7 middle_end test::assert_eq
    1 3 common::SourcePosition::new path sources.convert_position_to_offset.unwrap = final_start
    "final line start" 8 final_start test::assert_eq
}

pub fn test_source_store_converts_empty_source {
    "source_store_converts_empty_source" test::test_start
    lexer::SourceStore::new = sources
    "" "empty.casa" sources.add
    0 "empty.casa" sources.convert_offset_to_position.unwrap = position
    "line" 1 position.line test::assert_eq
    "column" 1 position.column test::assert_eq
    1 1 common::SourcePosition::new "empty.casa" sources.convert_position_to_offset.unwrap = offset
    "offset" 0 offset test::assert_eq
}

pub fn test_error_kind_name {
    "error_kind_name" test::test_start
    "syntax" "SYNTAX".to_str common::ErrorKind::Syntax error::error_kind_name test::assert_str_eq
    "type mismatch" "TYPE_MISMATCH".to_str common::ErrorKind::TypeMismatch error::error_kind_name test::assert_str_eq
    "undefined" "UNDEFINED_NAME".to_str common::ErrorKind::UndefinedName error::error_kind_name test::assert_str_eq
}

pub fn test_format_error_no_location {
    "format_error_no_location" test::test_start
    common::empty_location "bad token".to_str common::ErrorKind::Syntax error::CasaError::new = err
    lexer::SourceStore::new = sources
    err sources.format_error = formatted
    "exact format" "error[SYNTAX]: bad token" formatted test::assert_str_eq
}

pub fn test_format_error_with_location_no_source {
    "format_error_with_location_no_source" test::test_start
    3 0 "test.casa".to_str common::Location::new "not found".to_str common::ErrorKind::UndefinedName error::CasaError::new = err
    lexer::SourceStore::new = sources
    err sources.format_error = formatted
    "has error kind" formatted.as_str "error[UNDEFINED_NAME]" str::find 0 1 - swap > test::assert_true
}

pub fn test_format_error_with_source {
    "format_error_with_source" test::test_start
    lexer::SourceStore::new = sources
    "foo bar baz" "test_src.casa" sources.add
    3 4 "test_src.casa".to_str common::Location::new "`bar` is not defined".to_str common::ErrorKind::UndefinedName error::CasaError::new = err
    err sources.format_error = formatted
    "has error kind" formatted.as_str "error[UNDEFINED_NAME]" str::find 0 1 - swap > test::assert_true
    "has location" formatted.as_str "test_src.casa:1:5" str::find 0 1 - swap > test::assert_true
    "has source line" formatted.as_str "foo bar baz" str::find 0 1 - swap > test::assert_true
    "has carets" formatted.as_str "^^^" str::find 0 1 - swap > test::assert_true
}

pub fn test_format_error_multiline_source {
    "format_error_multiline_source" test::test_start
    lexer::SourceStore::new = sources
    "10 = x\nfoo\n20 = y" "test_multi.casa" sources.add
    3 7 "test_multi.casa".to_str common::Location::new "`foo` is not defined".to_str common::ErrorKind::UndefinedName error::CasaError::new = err
    err sources.format_error = formatted
    "has location" formatted.as_str "test_multi.casa:2:1" str::find 0 1 - swap > test::assert_true
    "has foo" formatted.as_str "foo" str::find 0 1 - swap > test::assert_true
    "has carets" formatted.as_str "^^^" str::find 0 1 - swap > test::assert_true
}

pub fn test_format_error_with_expected_got {
    "format_error_with_expected_got" test::test_start
    "`str`".to_str "`i64`".to_str common::empty_location "Type mismatch".to_str common::ErrorKind::TypeMismatch error::CasaError::with_expected = err
    lexer::SourceStore::new = sources
    err sources.format_error = formatted
    "has expected" formatted.as_str "Expected: `i64`" str::find 0 1 - swap > test::assert_true
    "has got" formatted.as_str "Got: `str`" str::find 0 1 - swap > test::assert_true
}

pub fn test_format_error_with_note {
    "format_error_with_note" test::test_start
    lexer::SourceStore::new = sources
    "\"hello\" 42 +" "test_note.casa" sources.add
    2 8 "test_note.casa".to_str common::Location::new "Type mismatch".to_str common::ErrorKind::TypeMismatch error::CasaError::new = err
    7 0 "test_note.casa".to_str common::Location::new "value of type `str` pushed here".to_str error::CasaNote = note
    note err error::CasaError::notes.push
    err sources.format_error = formatted
    "has Note prefix" formatted.as_str "Note: value of type `str` pushed here" str::find 0 1 - swap > test::assert_true
    "has note location" formatted.as_str "test_note.casa:1:1" str::find 0 1 - swap > test::assert_true
}

pub fn test_format_error_with_multiple_notes {
    "format_error_with_multiple_notes" test::test_start
    lexer::SourceStore::new = sources
    "if true then\n    1 2\nelse\n    3\nfi" "test_notes.casa" sources.add
    2 30 "test_notes.casa".to_str common::Location::new "Branches have incompatible stack effects".to_str common::ErrorKind::StackMismatch error::CasaError::new = err
    2 0 "test_notes.casa".to_str common::Location::new "`if` branch has stack effect `None -> i64 i64`".to_str error::CasaNote = note1
    4 21 "test_notes.casa".to_str common::Location::new "`else` branch has stack effect `None -> i64`".to_str error::CasaNote = note2
    note1 err error::CasaError::notes.push
    note2 err error::CasaError::notes.push
    err sources.format_error = formatted
    "has message" formatted.as_str "Branches have incompatible stack effects" str::find 0 1 - swap > test::assert_true
    "has if note" formatted.as_str "`if` branch has stack effect" str::find 0 1 - swap > test::assert_true
    "has else note" formatted.as_str "`else` branch has stack effect" str::find 0 1 - swap > test::assert_true
    # Check that "Note:" appears at least twice by finding second occurrence
    formatted.as_str "Note:" str::find = first_note_pos
    "has first Note" 0 1 - first_note_pos > test::assert_true
    first_note_pos 5 + u64::try_from.unwrap = after_first_start
    formatted.as_str after_first_start formatted.length after_first_start - str::substring = after_first
    "has second Note" after_first.as_str "Note:" str::find 0 1 - swap > test::assert_true
}

pub fn test_format_error_note_without_source {
    "format_error_note_without_source" test::test_start
    lexer::SourceStore::new = sources
    "foo" "present.casa" sources.add
    3 0 "present.casa".to_str common::Location::new "Type mismatch".to_str common::ErrorKind::TypeMismatch error::CasaError::new = err
    5 0 "missing.casa".to_str common::Location::new "value pushed here".to_str error::CasaNote = note
    note err error::CasaError::notes.push
    err sources.format_error = formatted
    "has Note prefix" formatted.as_str "Note: value pushed here" str::find 0 1 - swap > test::assert_true
    # missing.casa is not in source cache, so its filename should not appear in context
    formatted.as_str "Note: value pushed here" str::find = note_pos
    # The note message is there but no source context for missing.casa
    # Check that "missing.casa" does not appear after the note
    note_pos 23 + u64::try_from.unwrap = after_note_start
    formatted.as_str after_note_start formatted.length after_note_start - str::substring = after_note
    "no missing.casa context" 0 after_note.as_str "missing.casa" str::find < test::assert_true
}

pub fn test_format_source_context_basic {
    "format_source_context_basic" test::test_start
    3 5 1 common::SourcePosition::new "foo bar baz" "ctx.casa" error::format_source_context = ctx
    "has location" ctx.as_str "ctx.casa:1:5" str::find 0 1 - swap > test::assert_true
    "has source" ctx.as_str "foo bar baz" str::find 0 1 - swap > test::assert_true
    "has carets" ctx.as_str "^^^" str::find 0 1 - swap > test::assert_true
}
test_source_store_converts_offsets_and_positions
test_source_store_converts_empty_source
test_error_kind_name
test_format_error_no_location
test_format_error_with_location_no_source
test_format_error_with_source
test_format_error_multiline_source
test_format_error_with_expected_got
test_format_error_with_note
test_format_error_with_multiple_notes
test_format_error_note_without_source
test_format_source_context_basic
test::test_summary
