import "../../compiler/common.casa"
import "../../compiler/error.casa"
import "../../compiler/lexer.casa"
import "../../compiler/syntax.casa"
import "../../lib/test.casa"

fn test_source_store_converts_offsets_and_positions {
    "source_store_converts_offsets_and_positions" test_start
    SourceStore::new = sources
    "positions.casa" = path
    "abc\ndef\n" path sources.add

    0 path sources.convert_offset_to_position.unwrap = first
    "first line" 1 first.line assert_eq
    "first column" 1 first.column assert_eq

    3 path sources.convert_offset_to_position.unwrap = first_end_position
    "first end line" 1 first_end_position.line assert_eq
    "first end column" 4 first_end_position.column assert_eq

    4 path sources.convert_offset_to_position.unwrap = middle_start_position
    "middle start line" 2 middle_start_position.line assert_eq
    "middle start column" 1 middle_start_position.column assert_eq

    5 path sources.convert_offset_to_position.unwrap = middle
    "middle line" 2 middle.line assert_eq
    "middle column" 2 middle.column assert_eq

    7 path sources.convert_offset_to_position.unwrap = middle_end_position
    "middle end line" 2 middle_end_position.line assert_eq
    "middle end column" 4 middle_end_position.column assert_eq

    8 path sources.convert_offset_to_position.unwrap = final
    "final line" 3 final.line assert_eq
    "final column" 1 final.column assert_eq

    4 1 SourcePosition::new path sources.convert_position_to_offset.unwrap = first_end
    "first line end" 3 first_end assert_eq
    1 2 SourcePosition::new path sources.convert_position_to_offset.unwrap = middle_start
    "middle line start" 4 middle_start assert_eq
    4 2 SourcePosition::new path sources.convert_position_to_offset.unwrap = middle_end
    "middle line end" 7 middle_end assert_eq
    1 3 SourcePosition::new path sources.convert_position_to_offset.unwrap = final_start
    "final line start" 8 final_start assert_eq
}

fn test_source_store_converts_empty_source {
    "source_store_converts_empty_source" test_start
    SourceStore::new = sources
    "" "empty.casa" sources.add
    0 "empty.casa" sources.convert_offset_to_position.unwrap = position
    "line" 1 position.line assert_eq
    "column" 1 position.column assert_eq
    1 1 SourcePosition::new "empty.casa" sources.convert_position_to_offset.unwrap = offset
    "offset" 0 offset assert_eq
}

fn test_error_kind_name {
    "error_kind_name" test_start
    "syntax" "SYNTAX" ErrorKind::Syntax error_kind_name assert_str_eq
    "type mismatch" "TYPE_MISMATCH" ErrorKind::TypeMismatch error_kind_name assert_str_eq
    "undefined" "UNDEFINED_NAME" ErrorKind::UndefinedName error_kind_name assert_str_eq
}

fn test_format_error_no_location {
    "format_error_no_location" test_start
    empty_location "bad token" ErrorKind::Syntax CasaError::new = err
    SourceStore::new = sources
    err sources.format_error = formatted
    "exact format" "error[SYNTAX]: bad token" formatted assert_str_eq
}

fn test_format_error_with_location_no_source {
    "format_error_with_location_no_source" test_start
    3 0 "test.casa" Location::new "not found" ErrorKind::UndefinedName CasaError::new = err
    SourceStore::new = sources
    err sources.format_error = formatted
    "has error kind" formatted "error[UNDEFINED_NAME]" str::find 0 1 - swap > assert_true
}

fn test_format_error_with_source {
    "format_error_with_source" test_start
    SourceStore::new = sources
    "foo bar baz" "test_src.casa" sources.add
    3 4 "test_src.casa" Location::new "`bar` is not defined" ErrorKind::UndefinedName CasaError::new = err
    err sources.format_error = formatted
    "has error kind" formatted "error[UNDEFINED_NAME]" str::find 0 1 - swap > assert_true
    "has location" formatted "test_src.casa:1:5" str::find 0 1 - swap > assert_true
    "has source line" formatted "foo bar baz" str::find 0 1 - swap > assert_true
    "has carets" formatted "^^^" str::find 0 1 - swap > assert_true
}

fn test_format_error_multiline_source {
    "format_error_multiline_source" test_start
    SourceStore::new = sources
    "10 = x\nfoo\n20 = y" "test_multi.casa" sources.add
    3 7 "test_multi.casa" Location::new "`foo` is not defined" ErrorKind::UndefinedName CasaError::new = err
    err sources.format_error = formatted
    "has location" formatted "test_multi.casa:2:1" str::find 0 1 - swap > assert_true
    "has foo" formatted "foo" str::find 0 1 - swap > assert_true
    "has carets" formatted "^^^" str::find 0 1 - swap > assert_true
}

fn test_format_error_with_expected_got {
    "format_error_with_expected_got" test_start
    "`str`" "`int`" empty_location "Type mismatch" ErrorKind::TypeMismatch CasaError::with_expected = err
    SourceStore::new = sources
    err sources.format_error = formatted
    "has expected" formatted "Expected: `int`" str::find 0 1 - swap > assert_true
    "has got" formatted "Got: `str`" str::find 0 1 - swap > assert_true
}

fn test_format_error_with_note {
    "format_error_with_note" test_start
    SourceStore::new = sources
    "\"hello\" 42 +" "test_note.casa" sources.add
    2 8 "test_note.casa" Location::new "Type mismatch" ErrorKind::TypeMismatch CasaError::new = err
    7 0 "test_note.casa" Location::new "value of type `str` pushed here" CasaNote = note
    note err CasaError::notes.push
    err sources.format_error = formatted
    "has Note prefix" formatted "Note: value of type `str` pushed here" str::find 0 1 - swap > assert_true
    "has note location" formatted "test_note.casa:1:1" str::find 0 1 - swap > assert_true
}

fn test_format_error_with_multiple_notes {
    "format_error_with_multiple_notes" test_start
    SourceStore::new = sources
    "if true then\n    1 2\nelse\n    3\nfi" "test_notes.casa" sources.add
    2 30 "test_notes.casa" Location::new "Branches have incompatible stack effects" ErrorKind::StackMismatch CasaError::new = err
    2 0 "test_notes.casa" Location::new "`if` branch has stack effect `None -> int int`" CasaNote = note1
    4 21 "test_notes.casa" Location::new "`else` branch has stack effect `None -> int`" CasaNote = note2
    note1 err CasaError::notes.push
    note2 err CasaError::notes.push
    err sources.format_error = formatted
    "has message" formatted "Branches have incompatible stack effects" str::find 0 1 - swap > assert_true
    "has if note" formatted "`if` branch has stack effect" str::find 0 1 - swap > assert_true
    "has else note" formatted "`else` branch has stack effect" str::find 0 1 - swap > assert_true
    # Check that "Note:" appears at least twice by finding second occurrence
    formatted "Note:" str::find = first_note_pos
    "has first Note" 0 1 - first_note_pos > assert_true
    formatted first_note_pos 5 + formatted.length first_note_pos 5 + - str::substring = after_first
    "has second Note" after_first "Note:" str::find 0 1 - swap > assert_true
}

fn test_format_error_note_without_source {
    "format_error_note_without_source" test_start
    SourceStore::new = sources
    "foo" "present.casa" sources.add
    3 0 "present.casa" Location::new "Type mismatch" ErrorKind::TypeMismatch CasaError::new = err
    5 0 "missing.casa" Location::new "value pushed here" CasaNote = note
    note err CasaError::notes.push
    err sources.format_error = formatted
    "has Note prefix" formatted "Note: value pushed here" str::find 0 1 - swap > assert_true
    # missing.casa is not in source cache, so its filename should not appear in context
    formatted "Note: value pushed here" str::find = note_pos
    # The note message is there but no source context for missing.casa
    # Check that "missing.casa" does not appear after the note
    formatted note_pos 23 + formatted.length note_pos 23 + - str::substring = after_note
    "no missing.casa context" 0 after_note "missing.casa" str::find < assert_true
}

fn test_format_source_context_basic {
    "format_source_context_basic" test_start
    3 5 1 SourcePosition::new "foo bar baz" "ctx.casa" format_source_context = ctx
    "has location" ctx "ctx.casa:1:5" str::find 0 1 - swap > assert_true
    "has source" ctx "foo bar baz" str::find 0 1 - swap > assert_true
    "has carets" ctx "^^^" str::find 0 1 - swap > assert_true
}
test_source_store_converts_offsets_and_positions
test_source_store_converts_empty_source
test_error_kind_name
test_format_error_no_location
test_format_error_with_location_no_source
test_format_error_with_source
test_format_error_multiline_source
test_format_error_with_expected_got
test_format_error_with_note
test_format_error_with_multiple_notes
test_format_error_note_without_source
test_format_source_context_basic
test_summary
