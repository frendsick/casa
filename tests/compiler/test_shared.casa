import "std" as std
import "../../lib/test.casa" as test

struct DropProbe {
    drops: ptr
}

impl DropProbe {
    fn drop self:mut$DropProbe {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

fn same[T:std::Eq] left:$T right:$T -> bool { left right == }

pub fn check_lifetimes {
    "shared value lifetimes" test::test_start
    unsafe { 8 alloc = drops 0 drops store64 }
    drops DropProbe std::Shared::new = first
    first.get = view
    first.clone = second
    second drop
    "view survives another handle" drops view.drops == test::assert_true
    "other handle does not destroy value" 0 unsafe { drops load64 } test::assert_eq
    first.clone = third
    first drop
    "remaining handle keeps value" 0 unsafe { drops load64 } test::assert_eq
    third drop
    "last handle destroys value once" 1 unsafe { drops load64 } test::assert_eq
    unsafe { drops free }
}

pub fn check_scalar_values {
    "shared scalar values" test::test_start
    3 = small: i64
    5 = large: i64
    small std::Shared::new = three
    large std::Shared::new = five
    "scalar borrow reads its value" 3 three.get copy test::assert_eq
    "distinct scalars differ" three.get five.get != test::assert_true
}

pub fn check_comparison {
    "shared values compare their contents" test::test_start
    "shared".to_str std::Shared::new = text
    text.clone = clone
    "shared".to_str std::Shared::new = separate
    "other".to_str std::Shared::new = other
    "clones are equal" text clone == test::assert_true
    "separate equal values are equal" text separate == test::assert_true
    "different values are unequal" text other != test::assert_true
    "Eq bound accepts shared values" text separate same test::assert_true
    3 = small: i64
    5 = large: i64
    small std::Shared::new = three
    large std::Shared::new = five
    "less than" three five < test::assert_true
    "greater than or equal" three five >= test::assert_false
    "total ordering" std::Ordering::Greater three five.cmp test::assert_eq
    0.0 0.0 / std::Shared::new = not_a_number
    "partial ordering keeps unordered values" not_a_number not_a_number
        .clone
        .partial_cmp
        .is_none test::assert_true
    "partial equality keeps unordered values" not_a_number not_a_number.clone == test::assert_false
}

pub fn check_hashing_and_display {
    "shared values hash and display their contents" test::test_start
    "key".to_str std::Shared::new = key
    "key".to_str std::Shared::new = equal_key
    "hash uses the value" "key".to_str.hash key.hash test::assert_eq
    std::Set[std::Shared[std::String]]::new = keys
    key keys.add
    "set finds an equal value" equal_key keys.has test::assert_true
    "display uses the value" "key" f"{equal_key}" test::assert_str_eq
}
check_lifetimes
check_scalar_values
check_comparison
check_hashing_and_display
test::test_summary
