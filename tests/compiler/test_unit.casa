import "std" as std
import "../../lib/test.casa" as test

fn identity [T] value:T -> T { value }

fn make_unit -> std::Unit { std::Unit::Value }

fn call_unit callback:fn[-> std::Unit] -> std::Unit { callback exec }

fn consume_unit value:std::Unit -> i64 {
    value match
        std::Unit::Value => 42
    end
}

fn succeed -> std::Result[std::Unit std::String] { std::Unit::Value std::Result::Ok }

fn fail -> std::Result[std::Unit std::String] { "original error".to_str std::Result::Error }

fn propagate value:std::Result[std::Unit std::String] -> std::Result[i64 std::String] {
    value ? drop
    42 std::Result::Ok
}

fn test_unit_values {
    std::Unit::Value = unit
    "Unit supports generic functions" unit unit identity test::assert_eq
    "Unit supports callback results" unit &make_unit call_unit test::assert_eq
    "Unit supports lambda results" unit { std::Unit::Value } call_unit test::assert_eq

    std::Option[std::Unit]::None = absent
    "Unit remains distinct from absence" absent.is_none test::assert_true
    "Unit fits Option" unit unit std::Option::Some.unwrap test::assert_eq

    std::List[std::Unit]::new = values
    unit values.push
    unit values.push
    "Unit occupies each collection element" 2 values.length test::assert_eq
    "Unit survives collection storage" unit 1 values.get copy test::assert_eq

    "Result map consumes Unit" 42 &consume_unit succeed.map.unwrap test::assert_eq
    "Result map produces Unit" unit { drop std::Unit::Value } 42 std::Result[i64 std::String]::Ok.map.unwrap test::assert_eq
    "Question unwraps Unit and continues" 42 succeed propagate.unwrap test::assert_eq
    "Question preserves the original error" "original error" fail propagate.unwrap_error.as_str test::assert_str_eq
    succeed match
        std::Result::Ok(value) => {
            "Unit success can be matched" value std::Unit::Value is test::assert_true
        }
        std::Result::Error(_) => "expected Unit success" false test::assert_true
    end
}
test_unit_values
test::test_summary
