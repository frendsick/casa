import "std" as std

0 = test_pass_count
0 = test_fail_count
0 = drop_count

pub fn assert_i64 actual:i64 expected:i64 name:$str {
    if expected actual == then
        1 += test_pass_count
    else
        f"[FAIL] {name}: expected {expected}, got {actual}\n".as_str std::eprint
        1 += test_fail_count
    fi
}

pub struct Pair {
    pub small: u8
    pub large: u64
}

pub struct Resource {
    pub value: i64
}

pub struct RawOwner {
    pub value: i64
}

impl Resource {
    pub fn drop self:mut$Resource {
        self.value drop
        1 += drop_count
    }
}

pub fn round_trip [T] value:T -> T {
    unsafe { size_of[T] alloc } = storage
    unsafe {
        value storage ptr::write[T]
        storage ptr::read[T]
    }
}

pub fn run_typed_raw_tests {
    unsafe { 32 alloc } = storage
    unsafe { 255 (u8) storage ptr::write[u8] }
    "concrete u8" 255 unsafe { storage ptr::read[u8] } (i64) assert_i64
    unsafe { -2 (i16) storage ptr::write[i16] }
    "concrete signed i16" -2 unsafe { storage ptr::read[i16] } (i64) assert_i64
    unsafe { 4000000000 (u32) storage ptr::write[u32] }
    "concrete u32" 4000000000 unsafe { storage ptr::read[u32] } (i64) assert_i64
    unsafe { -7 (i8) round_trip } = signed_value
    "generic signed i8" -7 signed_value (i64) assert_i64
    123 (u64) 9 (u8) Pair round_trip = pair
    "generic aggregate first field" 9 pair.small (i64) assert_i64
    "generic aggregate second field" 123 pair.large (i64) assert_i64
    pair drop
    42 Resource round_trip drop
    "typed move destroys once" 1 drop_count assert_i64
    99 RawOwner = raw_owner
    raw_owner ptr::from_ref = raw_owner_address
    unsafe { raw_owner_address ptr::as_ref[RawOwner] } = raw_owner_ref
    "from_ref preserves storage" 99 raw_owner_ref.value assert_i64
    raw_owner_ref drop
    unsafe { raw_owner ptr::into_raw ptr::from_raw[RawOwner] } = restored_owner
    "from_raw restores ownership" 99 restored_owner.value assert_i64
    restored_owner drop
    if ptr::null ptr::null == then
        1 += test_pass_count
    else
        1 += test_fail_count
    fi
    f"{test_pass_count} passed, {test_fail_count} failed\n" print
    if 0 test_fail_count > then
        1 std::exit
    fi
}
run_typed_raw_tests
