import "std" as std
import "../../lib/test.casa" as test

pub struct Pair {
    pub small: u8
    pub large: u64
}

pub struct Resource {
    pub drops: ptr
    pub value: i64
}

pub struct LargeMove {
    values: array[u64 10]
}

struct LargeAffine {
    values: array[u64 513]
}

fn forward_large value:LargeAffine -> LargeAffine { value }

fn test_large_affine_call_and_raw_owner {
    "large affine call and raw owner" test::test_start
    unsafe {
        size_of[LargeAffine] alloc = source
        0 = index: u64
        while index 513 < do
            index source index 8 * + store64
            1 += index
        done
        source ptr::read[LargeAffine] = value
        source free
        value forward_large ptr::into_raw = raw_owner
        raw_owner ptr::from_raw[LargeAffine] = restored
        "large returned owner keeps first element" 0 0 restored.values.nth copy test::assert_eq
        "large raw owner keeps final element" 512 512 restored.values.nth copy test::assert_eq
        restored drop
    }
}

pub struct RawOwner {
    pub value: i64
}

struct RefillChild {
    observed: ptr
    value:    u64
}

impl RefillChild {
    fn drop self:mut$RefillChild {
        unsafe { self.value self.observed store64 }
    }
}

struct RefillContainer {
    source: ptr
    child:  RefillChild
}

impl RefillContainer {
    fn drop self:mut$RefillContainer {
        if ptr::null self.source != then
            unsafe {
                99 self.child.observed RefillChild ptr::null RefillContainer
                self.source ptr::write[RefillContainer]
            }
        fi
    }
}

fn test_drop_hook_refills_source {
    "drop hook refills moved source" test::test_start
    unsafe {
        8 alloc = observed
        0 observed store64
        size_of[RefillContainer] alloc = storage
        1 observed RefillChild storage RefillContainer storage ptr::write[RefillContainer]
        storage ptr::read[RefillContainer] drop
        "original child destroyed first" 1 observed load64 test::assert_eq
        storage ptr::read[RefillContainer] drop
        "replacement child destroyed second" 99 observed load64 test::assert_eq
        storage free
        observed free
    }
}

impl Resource {
    pub fn new drops:ptr value:i64 -> Resource { value drops Resource }

    pub fn drop self:mut$Resource {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

pub fn round_trip [T] value:T -> T {
    unsafe { size_of[T] alloc } = storage
    unsafe {
        value storage ptr::write[T]
        storage ptr::read[T]
    }
}

pub fn test_overlapping_moves {
    "overlapping typed moves" test::test_start
    unsafe {
        32 alloc = memory
        memory 8 + = shifted
        123 9 Pair memory ptr::write[Pair]
        memory ptr::read[Pair] shifted ptr::write[Pair]
        shifted ptr::read[Pair] = moved
        "forward overlap first field" 9 moved.small i64::from test::assert_eq
        "forward overlap second field" 123 moved.large i64::try_from.unwrap test::assert_eq
        moved shifted ptr::write[Pair]
        shifted ptr::read[Pair] memory ptr::write[Pair]
        memory ptr::read[Pair] memory ptr::write[Pair]
        memory ptr::read[Pair] = restored
        "backward and identical move" 123 restored.large i64::try_from.unwrap test::assert_eq
        memory free
    }
}

pub fn test_large_overlapping_moves {
    "large overlapping typed moves" test::test_start
    unsafe {
        88 alloc = memory
        memory 8 + = shifted
        [11, 22, 33, 44, 55, 66, 77, 88, 99, 110] LargeMove memory ptr::write[LargeMove]
        memory ptr::read[LargeMove] shifted ptr::write[LargeMove]
        shifted ptr::read[LargeMove] = moved
        "backward copy keeps final word" 110 9 moved.values.nth copy test::assert_eq
        moved shifted ptr::write[LargeMove]
        shifted ptr::read[LargeMove] memory ptr::write[LargeMove]
        memory ptr::read[LargeMove] = restored
        "forward copy keeps first word" 11 0 restored.values.nth copy test::assert_eq
        "forward copy keeps final word" 110 9 restored.values.nth copy test::assert_eq
        memory free
    }
}

enum ScalarChoice derives std::Copy std::Eq {
    First
    Second
    Third
    Fourth
}

struct ScalarReference {
    value: $i32
}

enum ScalarPayload {
    Value($i32)
}

fn check_scalar_value_uses value:$i32 {
    "borrowed arithmetic" 43 value 1 + test::assert_eq
    "borrowed conversion" 42 value i64::from test::assert_eq
    "borrowed interpolation" "42" f"{value}".as_str str::eq test::assert_true
}

fn test_scalar_borrow_consumers {
    "scalar borrow consumers" test::test_start
    # SAFETY: Each typed borrow refers to initialized, aligned storage. No
    # borrow remains live when the allocation is freed.
    unsafe {
        8 alloc = storage
        false storage ptr::write[bool]
        if storage ptr::as_ref[bool] then
            "borrowed false condition" false test::assert_true
        fi
        while storage ptr::as_ref[bool] do
            "borrowed false loop" false test::assert_true
            break
        done
        storage ptr::as_ref[bool] match
            false => {}
            true => "borrowed false pattern" false test::assert_true
        end
        0 storage ptr::write[u64]
        storage ptr::as_ref[u64] match
            0 => {}
            _ => "borrowed integer pattern" false test::assert_true
        end
        ScalarChoice::Third storage ptr::write[ScalarChoice]
        "borrowed enum is" storage ptr::as_ref[ScalarChoice] ScalarChoice::Third is test::assert_true
        storage ptr::as_ref[ScalarChoice] match
            ScalarChoice::First => "wrong first variant" false test::assert_true
            ScalarChoice::Second => "wrong second variant" false test::assert_true
            ScalarChoice::Third => {}
            ScalarChoice::Fourth => "wrong fourth variant" false test::assert_true
        end
        storage free
    }
    42 = value: i32
    value check_scalar_value_uses
    value ScalarReference = positional
    "positional borrowed field" 42 positional.value copy test::assert_eq
    ScalarReference { value: value } = named
    "named borrowed field" 42 named.value copy test::assert_eq
    value ScalarPayload::Value match
        ScalarPayload::Value(borrowed) => "borrowed enum payload" 42 borrowed copy test::assert_eq
    end
}

fn write_scalar [T] value:mut$T replacement:T {
    # SAFETY: value exclusively borrows initialized storage for T.
    unsafe { replacement value ptr::from_ref ptr::write[T] }
}

fn check_scalar_borrow [T:std::Copy + std::PartialEq] original:T replacement:T {
    # SAFETY: The allocation is aligned, initialized before borrowing, and freed
    # after each borrow's last use. Guard words remain outside the scalar storage.
    unsafe {
        24 alloc = allocation
        allocation 8 + = storage
        123 allocation store64
        456 allocation 16 + store64
        original storage ptr::write[T]
        "shared scalar address" storage storage ptr::as_ref[T] ptr::from_ref == test::assert_true
        "exclusive scalar address" storage storage ptr::as_mut[T] ptr::from_ref == test::assert_true
        "shared scalar copy" original storage ptr::as_ref[T] copy == test::assert_true
        "exclusive scalar copy" original storage ptr::as_mut[T] copy == test::assert_true
        replacement storage ptr::as_mut[T] write_scalar
        "scalar mutation" replacement storage ptr::as_ref[T] copy == test::assert_true
        "lower guard" 123 allocation load64 test::assert_eq
        "upper guard" 456 allocation 16 + load64 test::assert_eq
        allocation free
    }
}

fn test_scalar_borrows {
    "scalar borrow addresses and values" test::test_start
    -101 -7 &check_scalar_borrow[i8] exec
    -23456 -300 &check_scalar_borrow[i16] exec
    -123456789 42 &check_scalar_borrow[i32] exec
    -9000000000 -7000000000 &check_scalar_borrow[i64] exec
    129 250 &check_scalar_borrow[u8] exec
    32769 60000 &check_scalar_borrow[u16] exec
    3000000000 4000000000 &check_scalar_borrow[u32] exec
    10000000000000000000 18000000000000000000 &check_scalar_borrow[u64] exec
    -2.25 1.5 &check_scalar_borrow[f32] exec
    -2.25 1.5 &check_scalar_borrow[f64] exec
    false true &check_scalar_borrow[bool] exec
    'z' 'a' &check_scalar_borrow[char] exec
    ptr::null ptr::null &check_scalar_borrow[ptr] exec
    ScalarChoice::Fourth ScalarChoice::First check_scalar_borrow
    test_scalar_borrow_consumers
}

fn read_pointer_suffix values:array[i64 1] address:ptr -> i64 ptr { 0 values.nth copy address }

fn test_pointer_suffixes {
    "arrays and calls after pointer intrinsics" test::test_start
    ptr::null[11]::read_pointer_suffix = null_address = null_value
    "null suffix value" 11 null_value test::assert_eq
    "null suffix address" ptr::null null_address test::assert_eq

    42 RawOwner = owner
    owner ptr::from_ref[22]::read_pointer_suffix = borrowed_address = borrowed_value
    "borrow suffix value" 22 borrowed_value test::assert_eq
    "borrow suffix address" owner ptr::from_ref borrowed_address test::assert_eq

    unsafe { owner ptr::into_raw[33]::read_pointer_suffix } = owned_address = owned_value
    "owner suffix value" 33 owned_value test::assert_eq
    unsafe { owned_address ptr::from_raw[RawOwner] } = restored
    "owner suffix address" 42 restored.value test::assert_eq
}

pub fn run_typed_raw_tests {
    "typed raw storage" test::test_start
    unsafe { 32 alloc } = storage
    unsafe { 255 storage ptr::write[u8] }
    "concrete u8" 255 unsafe { storage ptr::read[u8] } i64::from test::assert_eq
    unsafe { -2 storage ptr::write[i16] }
    "concrete signed i16" -2 unsafe { storage ptr::read[i16] } i64::from test::assert_eq
    unsafe { 4000000000 storage ptr::write[u32] }
    "concrete u32" 4000000000 unsafe { storage ptr::read[u32] } i64::from test::assert_eq
    unsafe { -7 round_trip } = signed_value
    "generic signed i8" -7 signed_value i64::from test::assert_eq
    123 9 Pair round_trip = pair
    "generic aggregate first field" 9 pair.small i64::from test::assert_eq
    "generic aggregate second field" 123 pair.large i64::try_from.unwrap test::assert_eq
    pair drop
    unsafe { 8 alloc = drops }
    unsafe { 0 drops store64 }
    42 drops Resource::new round_trip drop
    unsafe { "typed move destroys once" 1 drops load64 test::assert_eq }
    unsafe { drops free }
    99 RawOwner = raw_owner
    raw_owner ptr::from_ref = raw_owner_address
    unsafe { raw_owner_address ptr::as_ref[RawOwner] } = raw_owner_ref
    "from_ref preserves storage" 99 raw_owner_ref.value test::assert_eq
    raw_owner_ref drop
    unsafe { raw_owner ptr::into_raw ptr::from_raw[RawOwner] } = restored_owner
    "from_raw restores ownership" 99 restored_owner.value test::assert_eq
    restored_owner drop
    "null pointers compare equal" ptr::null ptr::null == test::assert_true
    test_pointer_suffixes
    test_scalar_borrows
    test_drop_hook_refills_source
    test_overlapping_moves
    test_large_affine_call_and_raw_owner
    test_large_overlapping_moves
    test::test_summary
}
run_typed_raw_tests
