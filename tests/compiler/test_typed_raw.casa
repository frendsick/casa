import "std" as std
import "../../lib/test.casa" as test

pub struct Pair {
    pub small: u8
    pub large: u64
}

pub struct Resource {
    pub drops: ptr
    pub value: i64
}

pub struct RawOwner {
    pub value: i64
}

impl Resource {
    pub fn new drops:ptr value:i64 -> Resource { value drops Resource }

    pub fn drop self:mut$Resource {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

pub fn round_trip [T] value:T -> T {
    unsafe { size_of[T] alloc } = storage
    unsafe {
        value storage ptr::write[T]
        storage ptr::read[T]
    }
}

pub fn run_typed_raw_tests {
    "typed raw storage" test::test_start
    unsafe { 32 alloc } = storage
    unsafe { 255 storage ptr::write[u8] }
    "concrete u8" 255 unsafe { storage ptr::read[u8] } i64::from test::assert_eq
    unsafe { -2 storage ptr::write[i16] }
    "concrete signed i16" -2 unsafe { storage ptr::read[i16] } i64::from test::assert_eq
    unsafe { 4000000000 storage ptr::write[u32] }
    "concrete u32" 4000000000 unsafe { storage ptr::read[u32] } i64::from test::assert_eq
    unsafe { -7 round_trip } = signed_value
    "generic signed i8" -7 signed_value i64::from test::assert_eq
    123 9 Pair round_trip = pair
    "generic aggregate first field" 9 pair.small i64::from test::assert_eq
    "generic aggregate second field" 123 pair.large i64::try_from.unwrap test::assert_eq
    pair drop
    unsafe { 8 alloc = drops }
    unsafe { 0 drops store64 }
    42 drops Resource::new round_trip drop
    unsafe { "typed move destroys once" 1 drops load64 test::assert_eq }
    unsafe { drops free }
    99 RawOwner = raw_owner
    raw_owner ptr::from_ref = raw_owner_address
    unsafe { raw_owner_address ptr::as_ref[RawOwner] } = raw_owner_ref
    "from_ref preserves storage" 99 raw_owner_ref.value test::assert_eq
    raw_owner_ref drop
    unsafe { raw_owner ptr::into_raw ptr::from_raw[RawOwner] } = restored_owner
    "from_raw restores ownership" 99 restored_owner.value test::assert_eq
    restored_owner drop
    "null pointers compare equal" ptr::null ptr::null == test::assert_true
    test::test_summary
}
run_typed_raw_tests
