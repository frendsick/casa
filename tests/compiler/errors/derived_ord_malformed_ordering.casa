# expect: Derived `Ord` requires `Ordering` variants `Less`, `Equal`, and `Greater` in that order
pub enum __casa_std__Option[T] {
    None
    Some(T)
}

pub enum __casa_std__Ordering {
    Equal
    Less
    Greater
}

pub trait __casa_std__PartialEq {
    fn eq self:$self other:$self -> bool
    fn ne self:$self other:$self -> bool
}

pub trait __casa_std__Eq: __casa_std__PartialEq { }

pub trait __casa_std__PartialOrd: __casa_std__PartialEq {
    fn partial_cmp self:$self other:$self -> __casa_std__Option[__casa_std__Ordering]
    fn lt self:$self other:$self -> bool
    fn le self:$self other:$self -> bool
    fn gt self:$self other:$self -> bool
    fn ge self:$self other:$self -> bool
}

pub trait __casa_std__Ord: __casa_std__PartialOrd + __casa_std__Eq {
    fn cmp self:$self other:$self -> __casa_std__Ordering
}

pub struct Item derives __casa_std__Ord {
    pub value: i64
}
