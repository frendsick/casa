# expect: Cannot move owner `values` while it is borrowed
import "std"

struct View {
    slice: std::Slice[std::String]
}

fn wrap values:$array[std::String 1] -> View { values.as_slice View }

fn invalid {
    "a".to_str = text
    [text] = values
    values wrap = result
    values drop
    result.slice.length drop
}
