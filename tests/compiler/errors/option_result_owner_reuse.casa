# expect: was already moved
import "std" as std

pub fn reuse_option_owner {
    "owned".to_str std::Option::Some = owner
    owner.unwrap drop
    owner drop
}

pub fn reuse_result_owner {
    "owned".to_str std::Result::Ok = owner: std::Result[std::String str]
    owner.unwrap drop
    owner drop
}
