# expect: Cannot move owner `owner` while it is borrowed
import "std" as std

struct Owner {
    value: str
}

struct View {
    owner: $Owner
}

fn inspect view:$View { view.owner.value.length drop }

fn invalid {
    Owner { value: "owned" } = owner
    owner View = view
    move { view inspect } = observe
    owner drop
    observe drop
}
