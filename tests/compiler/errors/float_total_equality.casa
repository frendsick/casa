# expect: does not satisfy trait `Eq`

trait PartialEq {
    fn eq self:$self other:$self -> bool
    fn ne self:$self other:$self -> bool { other self.eq ! }
}

trait Eq: PartialEq { }

impl f64: PartialEq {
    fn eq self:$f64 other:$f64 -> bool { self other == }
}

fn require_eq [T:Eq] value:T { value drop }

1.0 require_eq
