import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/build.casa" as build
import "../../lib/os.casa" as os
import "../../compiler/error.casa" as error
import "../../compiler/products.casa" as products
import "../../compiler/typechecker.casa" as typechecker
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

fn check source:$str -> typechecker::CheckedProgram {
    error::Diagnostics::new = diagnostics
    diagnostics source helpers::typecheck_test_source = result
    source diagnostics.has_errors ! test::assert_true
    source result.get_diagnostics.has_errors ! test::assert_true
    result.into_checked_program.unwrap
}

fn test_function_modifiers {
    "inline_function_modifiers" test::test_start
    "inline" common::keyword_from_str.unwrap = keyword
    "keyword spelling" "inline" keyword.format_source test::assert_str_eq
    for
        source in [
            "inline fn marked value:i64 -> i64 { value } 42 marked drop",
            "pub inline fn marked value:i64 -> i64 { value } 42 marked drop",
            "inline unsafe fn marked value:i64 -> i64 { value } unsafe { 42 marked drop }",
            "unsafe inline fn marked value:i64 -> i64 { value } unsafe { 42 marked drop }",
            "pub unsafe inline fn marked value:i64 -> i64 { value } unsafe { 42 marked drop }",
        ].iter
    do
        source check = checked
        "marked metadata retained" "marked" checked
            .get_store
            .get_function
            .unwrap
            .is_inline test::assert_true
    done
    "fn plain value:i64 -> i64 { value } 42 plain drop" check = checked
    "unmarked metadata remains false" "plain" checked
        .get_store
        .get_function
        .unwrap
        .is_inline ! test::assert_true
}

fn test_specializations_keep_eligibility {
    "inline_specialization_metadata" test::test_start
    "inline fn identity[T] value:T -> T { value } 42 identity drop true identity drop" check = checked
    "two concrete specializations" 2 checked.get_function_names.length test::assert_eq
    for name in checked.get_function_names.iter do
        "generic specialization retains inline" name.as_str checked
            .get_store
            .get_function
            .unwrap
            .is_inline test::assert_true
    done
    "struct Value { pub value:i64 } impl Value { pub inline fn get self:$Value -> i64 { self.value } } 42 Value = value value.get drop"
    check = method_checked
    "method retains inline" "Value::get" method_checked
        .get_store
        .get_function
        .unwrap
        .is_inline test::assert_true
    "trait Number { fn number self:$self -> i64 inline fn increment self:$self -> i64 { self.number 1 + } } struct Value { pub value:i64 } impl Value:Number { fn number self:$Value -> i64 { self.value } } 41 Value = value value.increment drop"
    check = default_checked
    false = found_default
    for name in default_checked.get_function_names.iter do
        if name.as_str "increment" str::contains then
            "trait default specialization retains inline" name.as_str default_checked
                .get_store
                .get_function
                .unwrap
                .is_inline test::assert_true
            true = found_default
        fi
    done
    "trait default was specialized" found_default test::assert_true
}

fn test_closures_keep_their_own_eligibility {
    "inline_closure_eligibility" test::test_start
    "inline fn make -> fn[i64 -> i64] { { 1 + } } 41 make exec drop" check = generated
    false = found_closure
    for name in generated.get_function_names.iter do
        if name.as_str "lambda__" str::starts_with then
            "generated closure does not inherit inline" name.as_str generated
                .get_store
                .get_function
                .unwrap
                .is_inline ! test::assert_true
            true = found_closure
        fi
    done
    "generated closure remains in checked program" found_closure test::assert_true
    "fn callback value:i64 -> i64 { value 1 + } inline fn apply operation:fn[i64 -> i64] value:i64 -> i64 { value operation exec } 41 &callback apply drop"
    check = passed
    "passed callback does not inherit inline" "callback" passed
        .get_store
        .get_function
        .unwrap
        .is_inline ! test::assert_true
}

fn test_invalid_modifiers {
    "invalid_inline_modifiers" test::test_start
    for
        source in [
            "inline inline fn repeated { }",
            "unsafe unsafe fn repeated { }",
            "extern inline fn native",
            "inline extern fn native",
            "inline struct Value { value:i64 }",
            "trait Required { inline fn required self:$self -> i64 }",
            "inline fn no_body -> i64",
        ].iter
    do
        source.to_str "inline.casa".to_str products::SourceUnit products::syntax.unwrap = result
        source result
            .get_report
            .get_diagnostics
            .has_errors test::assert_true
    done
    error::Diagnostics::new = diagnostics
    diagnostics "inline unsafe fn unsafe_value -> i64 { 42 } unsafe_value drop" helpers::typecheck_test_source = result
    result.get_diagnostics.clone diagnostics.merge
    diagnostics "inline does not weaken unsafe calls" "unsafe" helpers::assert_error_contains
    error::Diagnostics::new = body_diagnostics
    body_diagnostics "inline fn invalid -> i64 { true } invalid drop" helpers::typecheck_test_source = invalid
    "inline bodies are checked normally" invalid.into_checked_program.is_error test::assert_true
}

fn compile source:$str -> std::String {
    error::Diagnostics::new = diagnostics
    diagnostics source helpers::compile_test_source = assembly
    source diagnostics.has_errors ! test::assert_true
    assembly helpers::generated_assembly
}

fn run_source source:$str {
    error::Diagnostics::new = diagnostics
    diagnostics source helpers::compile_test_source = text
    source diagnostics.has_errors ! test::assert_true
    text products::Target::LinuxX86_64 swap products::AssemblySource::new = assembly
    std::List[std::String]::new = libraries
    "/tmp/casa_inline_runtime_test" = path
    false libraries path assembly build::NativeDriver::new.compile_binary.unwrap drop
    std::List[std::Bytes]::new = arguments
    path arguments.push_str
    arguments std::run_command = status
    path.as_cstr.unwrap os::file::remove.unwrap drop
    "inlined program preserves observable behavior" 0 status test::assert_eq
}

fn test_named_expansion {
    "explicit_named_inline_expansion" test::test_start
    "inline fn marked value:i64 -> i64 { if value 0 < then value 1 - return fi value 1 + } fn plain value:i64 -> i64 { if value 0 < then value 1 - return fi value 1 + } 1 marked print 2 marked print 3 plain print"
    compile = assembly
    "marked branch body expands" assembly.as_str "call fn_marked" str::contains ! test::assert_true
    "unmarked branch body keeps its call" assembly.as_str "call fn_plain" str::contains test::assert_true
    "inline fn make -> fn[i64 -> i64] { { = value if value 0 < then value 1 - return fi value 1 + } } 41 make exec drop"
    compile = closure_assembly
    false = found_call
    for line in closure_assembly.as_str "\n" str::split.unwrap.iter do
        if line.as_str "call fn_" str::contains line.as_str "lambda__" str::contains && then
            true = found_call
        fi
    done
    "generated branchful closure keeps its call" found_call test::assert_true
}

fn test_recursive_fallback {
    "inline_recursive_fallback" test::test_start
    "inline fn recursive value:i64 -> i64 { if value 0 == then 0 return fi value 1 - recursive } 2 recursive print"
    compile = direct
    "recursive candidate keeps a call" direct.as_str "call fn_recursive" str::contains test::assert_true
    "inline fn first value:i64 -> i64 { if value 0 == then 0 return fi value 1 - second } inline fn second value:i64 -> i64 { if value 0 == then 0 return fi value 1 - first } 2 first print"
    compile = mutual
    "mutual recursive candidate keeps first call" mutual.as_str "call fn_first" str::contains test::assert_true
    "mutual recursive candidate keeps second call" mutual.as_str "call fn_second" str::contains test::assert_true
}

fn test_expansion_budgets {
    "inline_expansion_budgets" test::test_start
    "inline fn large value:i64 -> i64 { value ".to_str = large
    for _ in 70 0 std::Range::new do
        "1 + " large.append
    done
    "} 0 large print" large.append
    large.as_str compile = large_assembly
    "source budget retains the ordinary call" large_assembly.as_str "call fn_large" str::contains test::assert_true
    "inline fn branch value:i64 -> i64 { if value 0 < then value 1 - return fi value 1 + } fn run -> i64 { 0 ".to_str = repeated
    for _ in 100 0 std::Range::new do
        "branch " repeated.append
    done
    "} if run 100 != then \"expanded caller result\" panic fi" repeated.append
    repeated.as_str compile = repeated_assembly
    "caller expansion budget retains later calls" repeated_assembly.as_str "call fn_branch" str::contains test::assert_true
    repeated.as_str run_source
    "inline fn discard data:array[u8 1024] early:bool { if early then data drop return fi data drop } [".to_str = frame
    for index in 1024 0 std::Range::new do
        if index 0 != then
            "," frame.append
        fi
        "0" frame.append
    done
    "] = data: array[u8 1024] ".to_str frame.append_string
    for _ in 5 0 std::Range::new do
        "true data discard " frame.append
    done
    frame.as_str compile = frame_assembly
    "complete aggregate extent bounds caller frame growth" frame_assembly.as_str "call fn_discard" str::contains test::assert_true
    frame.as_str run_source
    "inline fn many_patterns value:i64 -> i64 { value match ".to_str = patterns
    for index in 80 0 std::Range::new do
        if index 0 != then
            " | " patterns.append
        fi
        index.to_str patterns.append_string
    done
    " => 1 _ => 0 end } 79 many_patterns print" patterns.append
    patterns.as_str compile = pattern_assembly
    "large Or-pattern retains its ordinary call" pattern_assembly.as_str "call fn_many_patterns" str::contains test::assert_true
}

fn test_expanded_runtime {
    "inline_reused_plan_runtime" test::test_start
    for
        source in [
            "import \"lib/std.casa\" as std\n\ninline fn choose value:i64 -> i64 {\n    value 3 * = local\n    if local 0 < then local 1 - return fi\n    local 2 +\n}\nif -2 choose -7 != then \"early scalar return\" panic fi\n0 = total\n0 = index\nwhile index 10 < do\n    index choose += total\n    index 1 + choose += total\n    1 += index\ndone\nif total 340 != then \"reused branch slots and labels\" panic fi\nenum Color { A B C D E }\ninline fn select color:Color -> i64 {\n    color match\n        Color::A => { 10 return }\n        Color::B => { 20 return }\n        Color::C => { 30 return }\n        Color::D => { 40 return }\n        Color::E => { 50 return }\n    end\n}\n0 = sum\n0 = round\nwhile round 3 < do\n    Color::A select += sum\n    Color::B select += sum\n    Color::C select += sum\n    Color::D select += sum\n    Color::E select += sum\n    1 += round\ndone\nif sum 450 != then \"reused jump table labels\" panic fi\n",
            "import \"lib/std.casa\" as std\nstruct Resource { count:ptr }\nimpl Resource {\n    fn drop self:mut$Resource {\n        unsafe { self.count load64 1 + self.count store64 }\n    }\n}\ninline fn visit counter:ptr branch:bool -> i64 {\n    if branch then\n        counter Resource = owner\n        if unsafe { counter load64 } 0 == then 5 return fi\n    fi\n    7\n}\nunsafe { 8 alloc } = counter\nunsafe { 0 counter store64 }\n0 = visit_sum\n0 = visit_index\nwhile visit_index 20 < do\n    visit_index 2 % 0 == counter visit += visit_sum\n    1 += visit_index\ndone\nif visit_sum 138 != then \"early return cleanup result\" panic fi\nif unsafe { counter load64 } 10 != then \"per-invocation cleanup flags\" panic fi\nunsafe { counter free }\n",
            "import \"lib/std.casa\" as std\nstruct Pair derives std::Copy { pub first:i64 pub second:i64 }\ninline fn make_pair early:bool -> Pair {\n    if early then Pair { first: 11 second: 12 } return fi\n    Pair { first: 21 second: 22 }\n}\ntrue make_pair = early_pair\nfalse make_pair = normal_pair\nif early_pair.first 11 != normal_pair.second 22 != || then \"Copy result destinations\" panic fi\ninline fn borrow_pair left:$Pair right:$Pair early:bool -> $Pair {\n    if early then left return fi\n    right\n}\ntrue normal_pair early_pair borrow_pair = first_borrow\nfalse normal_pair early_pair borrow_pair = second_borrow\nif first_borrow.second 12 != second_borrow.first 21 != || then \"borrowed early results\" panic fi\nfn first -> i64 { if true then 11 return fi 0 }\nfn second -> i64 { if true then 22 return fi 0 }\ninline fn invoke callback:$fn[-> i64] -> i64 {\n    if true then callback exec return fi\n    0\n}\n&first = first_callback\n&second = second_callback\nif first_callback invoke 11 != second_callback invoke 22 != || then \"specialized context identity\" panic fi\nfn make start:i64 -> fn[-> i64] { move { 1 += start start } }\n5 make = counter_callback\nif counter_callback invoke 6 != counter_callback invoke 7 != || then \"original capture state survives inline wrapper\" panic fi\n",
            "inline fn generic_choice[T] first:T second:T early:bool -> T {\n    if early then first return fi\n    second\n}\nif true 22 11 generic_choice 11 != false 22 11 generic_choice 22 != || then \"generic inline result\" panic fi\nstruct Value { pub number:i64 }\nimpl Value {\n    pub inline fn method_value self:$Value early:bool -> i64 {\n        if early then self.number return fi\n        self.number 1 +\n    }\n}\ntrait Number {\n    fn number self:$self -> i64\n    inline fn default_value self:$self -> i64 {\n        if self.number 0 < then 0 return fi\n        self.number 2 +\n    }\n}\nimpl Value:Number { fn number self:$Value -> i64 { self.number } }\n7 Value = value\nif true value.method_value 7 != false value.method_value 8 != || then \"inline method result\" panic fi\nif value.default_value 9 != then \"inline default result\" panic fi\n",
        ].iter
    do
        source compile = assembly
        for line in assembly.as_str "\n" str::split.unwrap.iter do
            if line.as_str "call fn_" str::contains then
                "branch helper expands" line.as_str "choose" str::contains ! test::assert_true
                "jump-table helper expands" line.as_str "select" str::contains ! test::assert_true
                "owned cleanup helper expands" line.as_str "visit" str::contains ! test::assert_true
                "Copy result helper expands" line.as_str "make_pair" str::contains ! test::assert_true
                "borrowed result helper expands" line.as_str "borrow_pair" str::contains ! test::assert_true
                "specialized helper expands" line.as_str "invoke" str::contains ! test::assert_true
                "generic helper expands" line.as_str "generic_choice" str::contains ! test::assert_true
                "method helper expands" line.as_str "method_value" str::contains ! test::assert_true
                "trait default helper expands" line.as_str "default_value" str::contains ! test::assert_true
            fi
        done
        source run_source
    done
}

pub fn run_tests {
    test_function_modifiers
    test_specializations_keep_eligibility
    test_closures_keep_their_own_eligibility
    test_invalid_modifiers
    test_named_expansion
    test_recursive_fallback
    test_expansion_budgets
    test_expanded_runtime
    test::test_summary
}
run_tests
