import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

pub const OWNED_CONTEXT_TYPES "trait __casa_std__Clone { fn clone self:$self -> self } trait __casa_std__Copy: __casa_std__Clone { } struct Resource { id: i64 } impl Resource: __casa_std__Clone { fn clone self:$Resource -> Resource { self.id Resource } } enum CopyResource derives __casa_std__Copy { One Two } struct Holder { value: Resource } struct CopyHolder { value: CopyResource } struct Box[T] { value: T } struct BoxHolder { value: Box[Resource] } struct SharedBox { value: $Resource } struct ExclusiveBox { value: mut$Resource } enum Maybe[T] { Some(T) } "
pub const CLEANUP_OBSERVED_BORROW_TYPES "struct BorrowGuard { owner: $Resource } impl BorrowGuard { fn drop self:mut$BorrowGuard { self.owner.id drop } } struct PlainView { owner: $Resource } "

pub fn check_source diagnostics:mut$error::Diagnostics source:$str {
    diagnostics source helpers::typecheck_test_source = checked
    checked.diagnostics.clone diagnostics.merge
}

pub fn test_owned_parameters_reject_borrowed_values {
    "owned_parameters_reject_borrowed_values" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn take value:Resource { } fn invalid_shared holder:$Holder { holder.value take } fn invalid_exclusive holder:mut$Holder { holder.value take }"
    str::concat.as_str diagnostics check_source
    diagnostics "shared and exclusive projections are rejected" 2 helpers::assert_error_count
    diagnostics "borrowed value diagnostic" "Cannot pass borrowed" helpers::assert_error_contains
}

pub fn test_borrowed_aggregate_rejects_owned_borrow_container {
    "borrowed_aggregate_rejects_owned_borrow_container" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn take value:Option[$Resource] { } fn invalid value:$Option[Resource] { value take }"
    str::concat.as_str diagnostics check_source
    diagnostics "borrowed option cannot become an owned option" 1 helpers::assert_error_count
    diagnostics "nested borrow mismatch" "Type mismatch" helpers::assert_error_contains
    diagnostics "does not hide nested mismatch" "Cannot pass borrowed" helpers::assert_error_not_contains
    diagnostics "does not suggest an unusable clone" "clone it first" helpers::assert_error_not_contains
}

