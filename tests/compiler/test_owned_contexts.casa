    diagnostics "Clone bound gets advice" "clone it first" helpers::assert_error_contains
}

pub fn test_live_loan_diagnostic_has_related_locations {
    "live_loan_diagnostic_has_related_locations" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn borrow value:$Resource -> $Resource { value } fn invalid { 1 Resource Holder = owner owner.value borrow = view owner drop view.id drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "one live-loan diagnostic" 1 helpers::assert_error_count
    diagnostics "loan origin and later use" 2 helpers::assert_error_note_count
    diagnostics "loan origin note" "loan starts here" helpers::assert_error_note_contains
    diagnostics
    "loan later-use note"
    "later use of `view` keeps this loan active"
    helpers::assert_error_note_contains
}

pub fn test_control_flow_preserves_loan_origin_location {
    "control_flow_preserves_loan_origin_location" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn borrow value:$Resource -> $Resource { value } fn invalid flag:bool { 1 Resource Holder = owner owner.value borrow = view if flag then 1 drop else 2 drop fi owner drop view.id drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "one joined-flow conflict" 1 helpers::assert_error_count
    diagnostics "joined flow retains both notes" 2 helpers::assert_error_note_count
    diagnostics "joined flow retains loan origin" "loan starts here" helpers::assert_error_note_contains
}

pub fn test_reassigned_borrow_notes_match_conflicting_loan {
    "reassigned_borrow_notes_match_conflicting_loan" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn borrow value:$Resource -> $Resource { value } fn invalid { 1 Resource = owner1 2 Resource = owner2 owner1 borrow = view view owner2 borrow = view owner1 drop view.id drop }"
    str::concat = source
    source.as_str diagnostics check_source
    diagnostics "one reassigned-binding conflict" 1 helpers::assert_error_count
    diagnostics "original loan retains both notes" 2 helpers::assert_error_note_count
    source.as_str "owner2 borrow = view" str::find u64::try_from.unwrap = replacement_offset
    diagnostics
    "loan note predates replacement binding"
    "loan starts here"
    replacement_offset
    helpers::assert_error_note_before
}

pub fn test_dead_same_origin_binding_does_not_replace_loan_note {
    "dead_same_origin_binding_does_not_replace_loan_note" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn borrow value:$Resource -> $Resource { value } fn invalid { 1 Resource = owner1 2 Resource = owner2 owner1 borrow = view view owner1 borrow = view owner1 drop owner2 borrow = view view.id drop drop }"
    str::concat = source
    source.as_str diagnostics check_source
    diagnostics "one same-origin conflict" 1 helpers::assert_error_count
    diagnostics "original stacked loan retains both notes" 2 helpers::assert_error_note_count
    source.as_str "owner1 borrow = view owner1 drop" str::find u64::try_from.unwrap = replacement_offset
    diagnostics
    "dead replacement does not replace stacked-loan note"
    "loan starts here"
    replacement_offset
    helpers::assert_error_note_before
    diagnostics
    "later generation use does not replace stacked-loan use"
    "later use of `view` keeps this loan active"
    replacement_offset
    helpers::assert_error_note_before
}

pub fn test_loop_loan_note_uses_saved_origin {
    "loop_loan_note_uses_saved_origin" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn borrow value:$Resource -> $Resource { value } fn invalid { 1 Resource = owner owner borrow = view while true do owner borrow = view owner drop break done }"
    str::concat = source
    source.as_str diagnostics check_source
    diagnostics "one loop loan conflict" 1 helpers::assert_error_count
    source.as_str "owner borrow = view owner drop" str::find u64::try_from.unwrap = replacement_offset
    diagnostics
    "loop note uses saved outer origin"
    "loan starts here"
    replacement_offset
    helpers::assert_error_note_before
}

pub fn test_lowered_field_assignment_keeps_loan_live {
    "lowered_field_assignment_keeps_loan_live" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "struct Item { value: i64 } struct ItemOwner { item: Item } fn borrow value:mut$Item -> mut$Item { value } fn invalid { 1 Item ItemOwner = owner owner.item borrow = view owner drop 2 = view.value }"
    str::concat.as_str diagnostics check_source
    diagnostics "one lowered-assignment loan conflict" 1 helpers::assert_error_count
    diagnostics "lowered assignment keeps the loan live" "Cannot move owner `owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics "lowered assignment has both notes" 2 helpers::assert_error_note_count
    diagnostics "lowered assignment later use" "later use of `view` keeps this loan active"
    helpers::assert_error_note_contains
}

pub fn test_overlapping_exclusive_arguments_name_parameters {
    "overlapping_exclusive_arguments_name_parameters" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn write_both left:mut$Resource right:mut$Resource { } fn invalid item:Resource { item item write_both }"
    str::concat.as_str diagnostics check_source
    diagnostics "one overlap diagnostic" 1 helpers::assert_error_count
    diagnostics
    "overlap maps arguments to parameters"
    "Cannot borrow `item` exclusively more than once in one call for parameters `left` and `right` of `write_both`"
    helpers::assert_error_contains
}
