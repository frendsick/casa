pub fn test_joined_stack_loan_notes_match_origin {
    "joined_stack_loan_notes_match_origin" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn borrow value:$Resource -> $Resource { value } fn invalid flag:bool { 1 Resource = owner1 2 Resource = owner2 if flag then owner1 borrow = view view else owner2 borrow = view view fi owner2 drop drop }"
    str::concat = source
    source.as_str diagnostics check_source
    diagnostics "one joined-stack conflict" 1 helpers::assert_error_count
    diagnostics "joined stack retains both owner2 notes" 2 helpers::assert_error_note_count
    source.as_str "else owner2" str::find u64::try_from.unwrap = else_offset
    diagnostics
    "joined-stack origin comes from owner2 branch"
    "loan starts here"
    else_offset
    helpers::assert_error_note_after
    diagnostics
    "joined-stack use comes from owner2 branch"
    "later use of `view` keeps this loan active"
    else_offset
    helpers::assert_error_note_after
}

pub fn test_mixed_span_joins_omit_ambiguous_notes {
    "mixed_span_joins_omit_ambiguous_notes" test::test_start
    error::Diagnostics::new = repeated_diagnostics
    OWNED_CONTEXT_TYPES
    "fn borrow value:$Resource -> $Resource { value } fn invalid first:bool second:bool { 1 Resource = owner if first then owner borrow elif second then owner borrow = view view else owner borrow fi owner drop drop }"
    str::concat.as_str repeated_diagnostics check_source
    repeated_diagnostics "one repeated mixed-join conflict" 1 helpers::assert_error_count
    repeated_diagnostics "repeated mixed join has no false note" 0 helpers::assert_error_note_count

    error::Diagnostics::new = distinct_diagnostics
    OWNED_CONTEXT_TYPES
    "fn borrow value:$Resource -> $Resource { value } fn invalid flag:bool { 1 Resource = owner1 2 Resource = owner2 if flag then owner1 borrow = view view else owner2 borrow fi owner2 drop drop }"
    str::concat.as_str distinct_diagnostics check_source
    distinct_diagnostics "one distinct mixed-join conflict" 1 helpers::assert_error_count
    distinct_diagnostics "distinct mixed join has no false note" 0 helpers::assert_error_note_count
}

