pub fn test_generic_return_transfers_cleanup_observed_borrow {
    "generic_return_transfers_cleanup_observed_borrow" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES CLEANUP_OBSERVED_BORROW_TYPES str::concat = declarations
    declarations.as_str
    "struct GenericMixedGuard { plain: PlainView guard: BorrowGuard } struct GenericPair[A B] { first: A second: B } fn forward[T] value:T -> T { value } fn extract[T] value:Maybe[T] -> T { value match Maybe::Some(inner) => inner end } fn choose[T] direct:T wrapped:Maybe[T] -> T { direct drop wrapped match Maybe::Some(inner) => inner end } fn take_first[A B] pair:GenericPair[A B] -> A { pair match GenericPair { first: first second: second } => { second drop first } end } fn extract_guard value:Maybe[BorrowGuard] -> BorrowGuard { value match Maybe::Some(inner) => inner end } fn extract_guard_generic[T] ignored:T value:Maybe[BorrowGuard] -> BorrowGuard { ignored drop value match Maybe::Some(inner) => inner end } fn keep_plain[T] ignored:T view:PlainView -> PlainView { ignored drop view } fn replace_guard[T] ignored:T owner:$Resource -> BorrowGuard { ignored drop owner BorrowGuard } fn invalid { 1 Resource = forward_owner forward_owner BorrowGuard = guard guard forward = moved_guard forward_owner drop moved_guard drop } fn extracted_invalid { 1 Resource = extracted_owner extracted_owner BorrowGuard Maybe::Some extract = moved_guard extracted_owner drop moved_guard drop } fn chosen_nested_invalid { 1 Resource = direct_choice_owner 2 Resource = nested_choice_owner nested_choice_owner BorrowGuard Maybe::Some direct_choice_owner BorrowGuard choose = moved_guard nested_choice_owner drop moved_guard drop direct_choice_owner drop } fn concrete_extracted_invalid { 1 Resource = concrete_extracted_owner concrete_extracted_owner BorrowGuard Maybe::Some extract_guard = moved_guard concrete_extracted_owner drop moved_guard drop } fn generic_concrete_extracted_invalid { 1 Resource = generic_extracted_owner generic_extracted_owner BorrowGuard Maybe::Some 0 extract_guard_generic = moved_guard generic_extracted_owner drop moved_guard drop } fn constructed_invalid { 1 Resource = first_owner 2 Resource = constructed_owner constructed_owner first_owner BorrowGuard replace_guard = replacement constructed_owner drop replacement drop first_owner drop } fn valid { 1 Resource = valid_owner valid_owner BorrowGuard = guard guard forward = moved_guard moved_guard drop valid_owner drop } fn extracted_valid { 1 Resource = valid_extracted_owner valid_extracted_owner BorrowGuard Maybe::Some extract = moved_guard moved_guard drop valid_extracted_owner drop } fn chosen_nested_valid { 1 Resource = valid_direct_choice_owner 2 Resource = valid_nested_choice_owner valid_nested_choice_owner BorrowGuard Maybe::Some valid_direct_choice_owner BorrowGuard choose = moved_guard moved_guard drop valid_nested_choice_owner drop valid_direct_choice_owner drop } fn concrete_extracted_valid { 1 Resource = valid_concrete_extracted_owner valid_concrete_extracted_owner BorrowGuard Maybe::Some extract_guard = moved_guard moved_guard drop valid_concrete_extracted_owner drop } fn generic_concrete_extracted_valid { 1 Resource = valid_generic_extracted_owner valid_generic_extracted_owner BorrowGuard Maybe::Some 0 extract_guard_generic = moved_guard moved_guard drop valid_generic_extracted_owner drop } fn constructed_valid { 1 Resource = valid_first_owner 2 Resource = valid_constructed_owner valid_constructed_owner valid_first_owner BorrowGuard replace_guard = replacement replacement drop valid_constructed_owner drop valid_first_owner drop } fn mixed_valid { 1 Resource = plain_owner 2 Resource = guard_owner guard_owner BorrowGuard plain_owner PlainView GenericMixedGuard forward = mixed plain_owner drop mixed drop guard_owner drop } fn distinct_generic_valid { 1 Resource = distinct_plain_owner 2 Resource = distinct_guard_owner distinct_guard_owner BorrowGuard distinct_plain_owner PlainView GenericPair take_first = view distinct_guard_owner drop view drop distinct_plain_owner drop } fn unrelated_valid { 1 Resource = unrelated_plain_owner 2 Resource = unrelated_guard_owner unrelated_plain_owner PlainView unrelated_guard_owner BorrowGuard keep_plain = view unrelated_guard_owner drop view drop unrelated_plain_owner drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "returns preserve every cleanup-observed origin" 6 helpers::assert_error_count
    diagnostics
    "generic return cleanup loan diagnostic"
    "Cannot move owner `forward_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "generic extraction cleanup loan diagnostic"
    "Cannot move owner `extracted_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "generic mixed-source return cleanup loan diagnostic"
    "Cannot move owner `nested_choice_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "concrete extraction cleanup loan diagnostic"
    "Cannot move owner `concrete_extracted_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "generic concrete extraction cleanup loan diagnostic"
    "Cannot move owner `generic_extracted_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "generic construction cleanup loan diagnostic"
    "Cannot move owner `constructed_owner` while it is borrowed"
    helpers::assert_error_contains
}

pub fn test_generic_callback_return_classifies_cleanup_origins {
    "generic_callback_return_classifies_cleanup_origins" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES CLEANUP_OBSERVED_BORROW_TYPES str::concat = declarations
    declarations.as_str
    "fn repeat[T] value:T callback:fn[T -> T] count:i64 -> T { while count 0 < do value callback exec = value 1 -= count done value } fn repeat_wrapped[T] value:Maybe[T] callback:fn[Maybe[T] -> Maybe[T]] count:i64 -> Maybe[T] { while count 0 < do value callback exec = value 1 -= count done value } fn provide[T] callback:fn[-> T] -> T { callback exec } fn keep[T] value:T callback:fn[T -> i64] -> T { callback drop value } fn cleanup_invalid { 1 Resource = cleanup_owner cleanup_owner PlainView = view move { view.owner BorrowGuard } = callback callback provide = guard cleanup_owner drop guard drop } fn scalar_valid { 1 Resource = scalar_owner scalar_owner PlainView = view move { view.owner.id } = callback callback provide scalar_owner drop drop } fn input_only_valid { 1 Resource = guard_owner 2 Resource = unrelated_owner guard_owner BorrowGuard = guard unrelated_owner PlainView = view move { drop view.owner.id } guard keep = returned unrelated_owner drop returned drop guard_owner drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "callback returns classify the generic cleanup origin" 1 helpers::assert_error_count
    diagnostics
    "callback return cleanup loan diagnostic"
    "Cannot move owner `cleanup_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics "scalar callback return has no loan" "scalar_owner" helpers::assert_error_not_contains
    diagnostics "callback input type has no cleanup loan" "unrelated_owner"
    helpers::assert_error_not_contains
}

pub fn test_moving_closure_transfers_cleanup_observed_borrow {
    "moving_closure_transfers_cleanup_observed_borrow" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES CLEANUP_OBSERVED_BORROW_TYPES str::concat = declarations
    declarations.as_str
    "fn no_op { } fn forward[T] value:T -> T { value } fn forward_closure value:fn[->] -> fn[->] { value } fn make_plain_callback view:PlainView -> fn[->] { view drop &no_op } fn make_guard_callback owner:$Resource -> fn[->] { owner BorrowGuard = guard move { guard.owner.id drop } } fn make_callback_guard provider:fn[-> mut$Resource] -> fn[->] { provider exec BorrowGuard = guard move { guard.owner.id drop } } fn discard callback:fn[->] -> fn[->] { &no_op = callback callback } fn touch[T] value:$T { } fn wrap[T] value:T -> fn[->] { move { value touch } } fn explicit_invalid { 1 Resource = direct_owner direct_owner BorrowGuard = guard move { guard.owner.id drop } = observe direct_owner drop observe drop } fn implicit_invalid { 1 Resource = implicit_owner implicit_owner BorrowGuard = guard move { guard.owner.id drop } = observe implicit_owner drop } fn forwarded_invalid { 1 Resource = forwarded_owner forwarded_owner BorrowGuard = guard move { guard.owner.id drop } = captured captured forward = observe forwarded_owner drop observe drop } fn concrete_forwarded_invalid { 1 Resource = concrete_owner concrete_owner BorrowGuard = guard move { guard.owner.id drop } = captured captured forward_closure = observe concrete_owner drop observe drop } fn constructed_callback_invalid { 1 Resource = constructed_callback_owner constructed_callback_owner make_guard_callback = callback constructed_callback_owner drop callback drop } fn callback_result_invalid { 1 Resource = callback_result_owner callback_result_owner ExclusiveBox = view move { view.value } = provider provider make_callback_guard = callback callback_result_owner drop callback drop } fn generic_capture_invalid { 1 Resource = generic_capture_owner generic_capture_owner BorrowGuard wrap = callback generic_capture_owner drop callback drop } fn exclusive_forwarded_invalid { 1 Resource = exclusive_owner exclusive_owner ExclusiveBox = view move { view.value.id drop } = captured captured forward_closure = observe exclusive_owner.id drop observe exec exclusive_owner drop } fn valid { 1 Resource = valid_owner valid_owner BorrowGuard = guard move { guard.owner.id drop } = observe observe drop valid_owner drop } fn forwarded_valid { 1 Resource = valid_forwarded_owner valid_forwarded_owner BorrowGuard = guard move { guard.owner.id drop } = captured captured forward = observe observe drop valid_forwarded_owner drop } fn concrete_forwarded_valid { 1 Resource = valid_concrete_owner valid_concrete_owner BorrowGuard = guard move { guard.owner.id drop } = captured captured forward_closure = observe observe drop valid_concrete_owner drop } fn plain_callback_valid { 1 Resource = plain_callback_owner plain_callback_owner PlainView make_plain_callback = callback plain_callback_owner drop callback drop } fn replacement_callback_valid { 1 Resource = replacement_owner replacement_owner BorrowGuard = guard move { guard.owner.id drop } discard = callback replacement_owner drop callback drop } fn constructed_callback_valid { 1 Resource = valid_constructed_callback_owner valid_constructed_callback_owner make_guard_callback = callback callback drop valid_constructed_callback_owner drop } fn callback_result_valid { 1 Resource = valid_callback_result_owner valid_callback_result_owner ExclusiveBox = view move { view.value } = provider provider make_callback_guard = callback callback drop valid_callback_result_owner drop } fn generic_capture_valid { 1 Resource = valid_generic_capture_owner valid_generic_capture_owner BorrowGuard wrap = callback callback drop valid_generic_capture_owner drop } fn exclusive_drop_valid { 1 Resource = valid_exclusive_owner valid_exclusive_owner ExclusiveBox = view move { view.value.id drop } = captured captured forward_closure = observe valid_exclusive_owner drop observe drop }"
    str::concat = source
    source.as_str
    "fn unused_shared_capture_valid { 1 Resource = unused_owner { unused_owner.id drop } = callback unused_owner drop callback drop } fn unused_nested_capture_valid { 1 Resource = unused_nested_owner unused_nested_owner PlainView = view move { view.owner.id drop } = callback unused_nested_owner drop callback drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "closure forwarding preserves cleanup and exclusive loans" 8 helpers::assert_error_count
    diagnostics
    "moving closure cleanup loan diagnostic"
    "Cannot move owner `direct_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "implicit moving closure cleanup loan diagnostic"
    "Cannot move owner `implicit_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "generic closure forwarding cleanup loan diagnostic"
    "Cannot move owner `forwarded_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "concrete closure forwarding cleanup loan diagnostic"
    "Cannot move owner `concrete_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "constructed closure return cleanup loan diagnostic"
    "Cannot move owner `constructed_callback_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "callback result cleanup loan diagnostic"
    "Cannot move owner `callback_result_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "generic capture cleanup loan diagnostic"
    "Cannot move owner `generic_capture_owner` while it is borrowed"
    helpers::assert_error_contains
    diagnostics
    "concrete closure forwarding exclusive loan diagnostic"
    "Cannot borrow `exclusive_owner.id` while it is borrowed"
    helpers::assert_error_contains
}

