import "../../compiler/typechecker.casa"
import "helpers.casa"

const OWNED_CONTEXT_TYPES "trait Clone { fn clone self:$self -> self } trait Copy: Clone { } struct Resource { id: i64 } impl Resource: Clone { fn clone self:$Resource -> Resource { self.id Resource } } enum CopyResource derives Copy { One Two } struct Holder { value: Resource } struct CopyHolder { value: CopyResource } struct Box[T] { value: T } struct SharedBox { value: $Resource } struct ExclusiveBox { value: mut$Resource } enum Maybe[T] { Some(T) } "

fn check_source diagnostics:mut$Diagnostics source:$str {
    diagnostics source typecheck_test_source = checked
    checked.diagnostics.clone diagnostics.merge
}

fn test_owned_parameters_reject_borrowed_values {
    "owned_parameters_reject_borrowed_values" test_start
    Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn take value:Resource { } fn invalid_shared holder:$Holder { holder.value take } fn invalid_exclusive holder:mut$Holder { holder.value take }"
    str::concat.as_str diagnostics check_source
    diagnostics "shared and exclusive projections are rejected" 2 assert_error_count
    diagnostics "borrowed value diagnostic" "Cannot move borrowed value" assert_error_contains
}

fn test_generic_owned_parameters_reject_after_resolution {
    "generic_owned_parameters_reject_after_resolution" test_start
    Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn take[T] value:T { } fn invalid holder:$Holder { holder.value take }"
    str::concat.as_str diagnostics check_source
    diagnostics "resolved generic owner is rejected" 1 assert_error_count
    diagnostics "generic owner diagnostic" "Cannot move borrowed value" assert_error_contains
}

fn test_shared_values_reject_exclusive_destinations {
    "shared_values_reject_exclusive_destinations" test_start
    Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn write[T] value:mut$T { } fn invalid direct:$Resource holder:$Holder { direct write holder.value write direct ExclusiveBox drop holder.value ExclusiveBox drop direct Maybe[mut$Resource]::Some drop holder.value Maybe[mut$Resource]::Some drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "calls and aggregates reject direct and projected shared values" 6 assert_error_count
    diagnostics "exclusive destination diagnostic" "Expected `mut$Resource`" assert_error_contains
}

fn test_owned_aggregates_reject_after_resolution {
    "owned_aggregates_reject_after_resolution" test_start
    Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn invalid holder:$Holder { holder.value Box drop Box { value: holder.value } drop holder.value Maybe::Some drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "all generic aggregate forms reject borrowed owners" 3 assert_error_count
    diagnostics "aggregate owner diagnostic" "Cannot move borrowed value" assert_error_contains
}

fn test_owned_returns_reject_borrowed_values {
    "owned_returns_reject_borrowed_values" test_start
    Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn invalid holder:$Holder -> Resource { holder.value }"
    str::concat.as_str diagnostics check_source
    diagnostics "borrowed return is rejected" 1 assert_error_count
    diagnostics "borrowed return diagnostic" "Cannot return a borrowed value as owned" assert_error_contains
}

fn test_owned_casts_reject_borrowed_values {
    "owned_casts_reject_borrowed_values" test_start
    Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn invalid holder:$Holder { holder.value (Resource) drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "borrowed cast is rejected" 1 assert_error_count
    diagnostics "borrowed cast diagnostic" "Cannot move borrowed value" assert_error_contains
}

fn test_borrow_casts_preserve_borrowed_values {
    "borrow_casts_preserve_borrowed_values" test_start
    Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn read value:$Resource { value.id drop } fn valid holder:$Holder { holder.value ($Resource) read }"
    str::concat.as_str diagnostics check_source
    diagnostics "a compatible borrow cast remains borrowed" assert_no_errors
}

fn test_owned_parameters_reject_noncopy_globals {
    "owned_parameters_reject_noncopy_globals" test_start
    Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "1 Resource = VALUE fn take value:Resource { } fn invalid { VALUE take } invalid"
    str::concat.as_str diagnostics check_source
    diagnostics "non-Copy global is rejected" 1 assert_error_count
    diagnostics "global owner diagnostic" "Cannot move borrowed value `VALUE`" assert_error_contains
}

fn test_copy_and_cloned_globals_are_owned {
    "copy_and_cloned_globals_are_owned" test_start
    Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "1 Resource = VALUE CopyResource::Two = COPY_VALUE fn take[T] value:T { } fn valid { VALUE.clone take COPY_VALUE take VALUE.id drop } valid"
    str::concat.as_str diagnostics check_source
    diagnostics "cloned and Copy globals are valid" assert_no_errors
}

fn test_valid_owned_and_borrowed_values {
    "valid_owned_and_borrowed_values" test_start
    Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn take[T] value:T { } fn read[T] value:$T { } fn write[T] value:mut$T { } fn moved { 1 Resource take 2 Resource Box drop Box { value: 3 Resource } drop 4 Resource Maybe::Some drop } fn cloned holder:$Holder { holder.value.clone take } fn copied holder:$CopyHolder { holder.value copy take } fn shared holder:$Holder { holder.value read holder.value SharedBox drop holder.value Maybe[$Resource]::Some drop } fn exclusive holder:mut$Holder { holder.value write holder.value ExclusiveBox drop holder.value Maybe[mut$Resource]::Some drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "moves, clones, copies, and compatible borrows are valid" assert_no_errors
}

fn test_literal_can_bind_to_borrowed_parameter {
    "literal_can_bind_to_borrowed_parameter" test_start
    Diagnostics::new = diagnostics
    "fn read value:$i64 { value drop } fn valid { 1 read }" diagnostics check_source
    diagnostics "a literal resolves to the borrowed target type" assert_no_errors
}

fn test_into_raw_requires_heap_owner {
    "into_raw_requires_heap_owner" test_start
    Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn invalid_borrow holder:$Holder { unsafe { holder ptr::into_raw drop } } fn invalid_scalar { unsafe { 1 ptr::into_raw drop } } fn moved { Box { value: 1 Resource } = owner unsafe { owner ptr::into_raw free } owner drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "borrow, scalar, and reuse are rejected" 4 assert_error_count
    diagnostics "borrowed owner diagnostic" "Cannot move a borrowed value" assert_error_contains
    diagnostics "indirect representation diagnostic" "requires a heap-indirect owner" assert_error_contains
    diagnostics "transfer moves owner" "was already moved" assert_error_contains
}
test_owned_parameters_reject_borrowed_values
test_generic_owned_parameters_reject_after_resolution
test_shared_values_reject_exclusive_destinations
test_owned_aggregates_reject_after_resolution
test_owned_returns_reject_borrowed_values
test_owned_casts_reject_borrowed_values
test_borrow_casts_preserve_borrowed_values
test_owned_parameters_reject_noncopy_globals
test_copy_and_cloned_globals_are_owned
test_valid_owned_and_borrowed_values
test_literal_can_bind_to_borrowed_parameter
test_into_raw_requires_heap_owner
test_summary
