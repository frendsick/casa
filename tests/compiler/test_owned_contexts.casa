pub fn test_shared_values_reject_exclusive_destinations {
    "shared_values_reject_exclusive_destinations" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn write[T] value:mut$T { } fn invalid direct:$Resource holder:$Holder { direct write holder.value write direct ExclusiveBox drop holder.value ExclusiveBox drop direct Maybe[mut$Resource]::Some drop holder.value Maybe[mut$Resource]::Some drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "calls and aggregates reject direct and projected shared values" 6 helpers::assert_error_count
    diagnostics "exclusive destination diagnostic" "Expected `mut$Resource`" helpers::assert_error_contains
}

