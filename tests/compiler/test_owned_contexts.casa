import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

pub const OWNED_CONTEXT_TYPES "trait __casa_std__Clone { fn clone self:$self -> self } trait __casa_std__Copy: __casa_std__Clone { } struct Resource { id: i64 } impl Resource: __casa_std__Clone { fn clone self:$Resource -> Resource { self.id Resource } } enum CopyResource derives __casa_std__Copy { One Two } struct Holder { value: Resource } struct CopyHolder { value: CopyResource } struct Box[T] { value: T } struct BoxHolder { value: Box[Resource] } struct SharedBox { value: $Resource } struct ExclusiveBox { value: mut$Resource } enum Maybe[T] { Some(T) } "

pub fn check_source diagnostics:mut$error::Diagnostics source:$str {
    diagnostics source helpers::typecheck_test_source = checked
    checked.diagnostics.clone diagnostics.merge
}

pub fn test_owned_parameters_reject_borrowed_values {
    "owned_parameters_reject_borrowed_values" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn take value:Resource { } fn invalid_shared holder:$Holder { holder.value take } fn invalid_exclusive holder:mut$Holder { holder.value take }"
    str::concat.as_str diagnostics check_source
    diagnostics "shared and exclusive projections are rejected" 2 helpers::assert_error_count
    diagnostics "borrowed value diagnostic" "Cannot pass borrowed" helpers::assert_error_contains
}

pub fn test_borrowed_aggregate_rejects_owned_borrow_container {
    "borrowed_aggregate_rejects_owned_borrow_container" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn take value:Option[$Resource] { } fn invalid value:$Option[Resource] { value take }"
    str::concat.as_str diagnostics check_source
    diagnostics "borrowed option cannot become an owned option" 1 helpers::assert_error_count
    diagnostics "nested borrow mismatch" "Type mismatch" helpers::assert_error_contains
    diagnostics "does not hide nested mismatch" "Cannot pass borrowed" helpers::assert_error_not_contains
    diagnostics "does not suggest an unusable clone" "clone it first" helpers::assert_error_not_contains
}

pub fn test_generic_owned_parameters_reject_after_resolution {
    "generic_owned_parameters_reject_after_resolution" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn take[T] value:T { } fn invalid holder:$Holder { holder.value take }"
    str::concat.as_str diagnostics check_source
    diagnostics "resolved generic owner is rejected" 1 helpers::assert_error_count
    diagnostics "generic owner diagnostic" "Cannot pass borrowed" helpers::assert_error_contains
}

pub fn test_shared_values_reject_exclusive_destinations {
    "shared_values_reject_exclusive_destinations" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn write[T] value:mut$T { } fn invalid direct:$Resource holder:$Holder { direct write holder.value write direct ExclusiveBox drop holder.value ExclusiveBox drop direct Maybe[mut$Resource]::Some drop holder.value Maybe[mut$Resource]::Some drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "calls and aggregates reject direct and projected shared values" 6 helpers::assert_error_count
    diagnostics "exclusive destination diagnostic" "Expected `mut$Resource`" helpers::assert_error_contains
}

pub fn test_owned_aggregates_reject_after_resolution {
    "owned_aggregates_reject_after_resolution" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn invalid holder:$Holder { holder.value Box drop Box { value: holder.value } drop holder.value Maybe::Some drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "all generic aggregate forms reject borrowed owners" 3 helpers::assert_error_count
    diagnostics "aggregate owner diagnostic" "Cannot move borrowed" helpers::assert_error_contains
}

pub fn test_owned_returns_reject_borrowed_values {
    "owned_returns_reject_borrowed_values" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn invalid holder:$Holder -> Resource { holder.value }"
    str::concat.as_str diagnostics check_source
    diagnostics "borrowed return is rejected" 1 helpers::assert_error_count
    diagnostics "borrowed return diagnostic" "Cannot return a borrowed value as owned" helpers::assert_error_contains
}

pub fn test_pointer_borrows_preserve_borrowed_values {
    "pointer_borrows_preserve_borrowed_values" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn read value:$Resource { value.id drop } fn valid holder:$Holder { unsafe { holder.value ptr::from_ref ptr::as_ref[Resource] read } }"
    str::concat.as_str diagnostics check_source
    diagnostics "a pointer borrow remains borrowed" helpers::assert_no_errors
}

pub fn test_owned_parameters_reject_noncopy_globals {
    "owned_parameters_reject_noncopy_globals" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "global VALUE { 1 Resource } fn take value:Resource { } fn invalid { VALUE take } invalid"
    str::concat.as_str diagnostics check_source
    diagnostics "non-Copy global is rejected" 1 helpers::assert_error_count
    diagnostics "global owner diagnostic" "Cannot pass borrowed `VALUE`" helpers::assert_error_contains
}

pub fn test_copy_and_cloned_globals_are_owned {
    "copy_and_cloned_globals_are_owned" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "global VALUE { 1 Resource } global COPY_VALUE CopyResource::Two fn take[T] value:T { } fn valid { VALUE.clone take COPY_VALUE take VALUE.id drop } valid"
    str::concat.as_str diagnostics check_source
    diagnostics "cloned and Copy globals are valid" helpers::assert_no_errors
}

pub fn test_immutable_global_root_reads_are_shared {
    "immutable_global_root_reads_are_shared" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "global VALUE { 1 Resource } fn write value:mut$Resource { } VALUE write"
    str::concat.as_str diagnostics check_source
    diagnostics "immutable global cannot be borrowed exclusively" 1 helpers::assert_error_count
    diagnostics "shared global diagnostic" "Type mismatch" helpers::assert_error_contains
}

pub fn test_valid_owned_and_borrowed_values {
    "valid_owned_and_borrowed_values" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn take[T] value:T { } fn read[T] value:$T { } fn write[T] value:mut$T { } fn moved { 1 Resource take 2 Resource Box drop Box { value: 3 Resource } drop 4 Resource Maybe::Some drop } fn cloned holder:$Holder { holder.value.clone take } fn copied holder:$CopyHolder { holder.value copy take } fn shared holder:$Holder { holder.value read holder.value SharedBox drop holder.value Maybe[$Resource]::Some drop } fn exclusive holder:mut$Holder { holder.value write holder.value ExclusiveBox drop holder.value Maybe[mut$Resource]::Some drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "moves, clones, copies, and compatible borrows are valid" helpers::assert_no_errors
}

pub fn test_literal_can_bind_to_borrowed_parameter {
    "literal_can_bind_to_borrowed_parameter" test::test_start
    error::Diagnostics::new = diagnostics
    "fn read value:$i64 { value drop } fn valid { 1 read }" diagnostics check_source
    diagnostics "a literal resolves to the borrowed target type" helpers::assert_no_errors
}

pub fn test_into_raw_requires_heap_owner {
    "into_raw_requires_heap_owner" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn invalid_borrow holder:$Holder { unsafe { holder ptr::into_raw drop } } fn invalid_scalar { unsafe { 1 ptr::into_raw drop } } fn moved { Box { value: 1 Resource } = owner unsafe { owner ptr::into_raw free } owner drop }"
    str::concat.as_str diagnostics check_source
    diagnostics "borrow, scalar, and reuse are rejected" 4 helpers::assert_error_count
    diagnostics "borrowed owner diagnostic" "Cannot move borrowed value" helpers::assert_error_contains
    diagnostics "indirect representation diagnostic" "requires a heap-indirect owner" helpers::assert_error_contains
    diagnostics "transfer moves owner" "was already moved" helpers::assert_error_contains
}

pub fn test_raw_owner_conversion_rejects_unresolved_types {
    "raw_owner_conversion_rejects_unresolved_types" test::test_start
    error::Diagnostics::new = diagnostics
    "fn into_raw[T] value:T -> ptr { unsafe { value ptr::into_raw } } fn from_raw[T] value:ptr -> T { unsafe { value ptr::from_raw[T] } }"
    diagnostics check_source
    diagnostics "both generic conversions are rejected" 2 helpers::assert_error_count
    diagnostics "generic representation diagnostic" "Cannot determine representation of `T`" helpers::assert_error_contains
}

pub fn test_borrowed_parameter_diagnostic_shows_contract {
    "borrowed_parameter_diagnostic_shows_contract" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn take value:Resource { } fn invalid holder:$Holder { holder.value take }"
    str::concat.as_str diagnostics check_source
    diagnostics "one ownership diagnostic" 1 helpers::assert_error_count
    diagnostics
    "names operation and parameter"
    "Cannot pass borrowed `holder.value` to consuming parameter `value` of `take`"
    helpers::assert_error_contains
    diagnostics "shows owned contract" "owned value: Resource" helpers::assert_error_contains
    diagnostics "shows shared access" "shared access: $Resource" helpers::assert_error_contains
    diagnostics "Clone value gets advice" "clone it first" helpers::assert_error_contains
}

pub fn test_non_clone_borrowed_parameter_omits_clone_advice {
    "non_clone_borrowed_parameter_omits_clone_advice" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "struct PlainResource { id: i64 } struct PlainHolder { value: PlainResource } fn take_plain value:PlainResource { } fn invalid holder:$PlainHolder { holder.value take_plain }"
    str::concat.as_str diagnostics check_source
    diagnostics "one ownership diagnostic" 1 helpers::assert_error_count
    diagnostics "non-Clone value gets no advice" "clone it first" helpers::assert_error_not_contains
}

pub fn test_shared_receiver_diagnostic_shows_contract_once {
    "shared_receiver_diagnostic_shows_contract_once" test::test_start
    error::Diagnostics::new = diagnostics
    "struct Counter { value: i64 } struct Machine { counter: Counter } impl Counter { fn bump self:mut$Counter { } } fn invalid machine:$Machine { machine.counter.bump }"
    diagnostics check_source
    diagnostics "one receiver diagnostic" 1 helpers::assert_error_count
    diagnostics
    "names receiver and method"
    "Method `bump` needs exclusive access to `Counter`, but `machine.counter` is shared"
    helpers::assert_error_contains
    diagnostics "shows receiver contract" "exclusive receiver: mut$Counter" helpers::assert_error_contains
    diagnostics "shows available receiver" "shared receiver: $Counter" helpers::assert_error_contains
}

pub fn test_trait_bound_receiver_diagnostic_has_no_follow_on {
    "trait_bound_receiver_diagnostic_has_no_follow_on" test::test_start
    error::Diagnostics::new = diagnostics
    "trait Mutate { fn bump self:mut$self } fn invalid[T: Mutate] value:$T { value.bump }"
    diagnostics check_source
    diagnostics "one trait-bound receiver diagnostic" 1 helpers::assert_error_count
    diagnostics
    "trait-bound receiver contract"
    "Method `bump` needs exclusive access to `T`, but `value` is shared"
    helpers::assert_error_contains
    diagnostics "shows required trait-bound receiver" "exclusive receiver: mut$T"
    helpers::assert_error_contains
    diagnostics "shows available trait-bound receiver" "shared receiver: $T"
    helpers::assert_error_contains
}

pub fn test_generic_aggregate_parameter_diagnostic_has_context {
    "generic_aggregate_parameter_diagnostic_has_context" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "fn take_box[T] value:Box[T] { } fn invalid holder:$BoxHolder { holder.value take_box }"
    str::concat.as_str diagnostics check_source
    diagnostics "one aggregate ownership diagnostic" 1 helpers::assert_error_count
    diagnostics
    "names generic operation and parameter"
    "Cannot pass borrowed `holder.value` to consuming parameter `value` of `take_box`"
    helpers::assert_error_contains
    diagnostics "shows aggregate contract" "owned value: Box[Resource]" helpers::assert_error_contains
    diagnostics "shows aggregate access" "shared access: $Box[Resource]" helpers::assert_error_contains
}

pub fn test_incompatible_borrow_reports_type_mismatch {
    "incompatible_borrow_reports_type_mismatch" test::test_start
    error::Diagnostics::new = diagnostics
    OWNED_CONTEXT_TYPES
    "struct Other { id: i64 } fn take_other value:Other { } fn invalid holder:$Holder { holder.value take_other }"
    str::concat.as_str diagnostics check_source
    diagnostics "one type mismatch" 1 helpers::assert_error_count
    diagnostics "reports the incompatible types" "Type mismatch" helpers::assert_error_contains
    diagnostics "does not report ownership" "Cannot pass borrowed" helpers::assert_error_not_contains
    diagnostics "does not suggest an invalid clone" "clone it first" helpers::assert_error_not_contains
}

