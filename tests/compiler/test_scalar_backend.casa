import "../../compiler/lexer.casa" as lexer
import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/backend.casa" as bytecode
import "../../compiler/typechecker.casa" as typechecker
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

fn test_complete_scalar_commit {
    "complete_scalar_commit" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "fn twice value:i64 -> i64 { if 0 value == then 0 return fi value 2 * } 21 twice print" helpers::typecheck_test_source = checked
    checked.into_checked_program.unwrap lexer::SourceStore::new swap bytecode::compile_checked.unwrap = text
    text helpers::generated_assembly = generated
    "native direct call" generated.as_str "call fn_twice" str::contains test::assert_true
    "native frame unwind information" generated.as_str ".cfi_startproc" str::contains test::assert_true
    "runtime included" text.as_str "return_stack_overflow:" str::contains test::assert_true
    "root included" generated.as_str "_start:" str::contains test::assert_true
}

fn test_aggregate_uses_checked_contract {
    "aggregate_uses_checked_contract" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "struct Pair { value:i64 } 42 Pair drop" helpers::typecheck_test_source = checked
    "aggregate produces assembly" checked.into_checked_program.unwrap lexer::SourceStore::new swap bytecode::compile_checked.is_ok test::assert_true
}

fn test_compound_and_wrapping_plans {
    "compound_and_wrapping_plans" test::test_start
    for
        code in [
            "42 = value 1 += value 2 -= value value print",
            "255 = value:u8 1 = delta:u8 delta value.wrapping_add print",
            "2 = value:i8 3 = delta:i8 delta value.wrapping_sub print",
            "128 = value:u8 2 = factor:u8 factor value.wrapping_mul print",
        ].iter
    do
        error::Diagnostics::new = diagnostics
        diagnostics code helpers::typecheck_test_source = checked
        "scalar arithmetic produces assembly" checked.into_checked_program.unwrap lexer::SourceStore::new swap bytecode::compile_checked.is_ok test::assert_true
    done
}

fn test_rejected_source_has_no_backend_input {
    "rejected_source_has_no_backend_input" test::test_start
    for
        code in [
            "true 1 +",
            "fn bad -> i64 { true } bad drop",
            "fn bad flag:bool { flag 1 + drop } true bad",
        ].iter
    do
        error::Diagnostics::new = diagnostics
        diagnostics code helpers::typecheck_test_source = checked
        "source or checking rejects invalid input" diagnostics.has_errors checked.get_diagnostics.has_errors || test::assert_true
        # Parsing diagnostics belong to the analysis owner. Checking failures cannot be sealed.
        if checked.get_diagnostics.has_errors then
            "rejected checking has no checked program" checked.into_checked_program.is_error test::assert_true
        fi
    done
}

# Branches keep these calls out of the existing leaf-template expansion path.
fn call_one value:i64 -> i64 {
    if value 0 == then
        1 return
    fi
    value
}

fn call_two first:i64 second:i64 -> i64 i64 {
    if first 0 == then
        second first return
    fi
    second first
}

fn call_three first:i64 second:i64 third:i64 -> i64 i64 i64 {
    if first 0 == then
        third second first return
    fi
    third second first
}

fn call_four first:i64 second:i64 third:i64 fourth:i64 -> i64 i64 i64 i64 {
    if first 0 == then
        fourth third second first return
    fi
    fourth third second first
}

fn call_five first:i64 second:i64 third:i64 fourth:i64 fifth:i64 -> i64 i64 i64 i64 i64 {
    if first 0 == then
        fifth fourth third second first return
    fi
    fifth fourth third second first
}

fn call_zero -> i64 {
    0 = value
    while value 3 < do
        1 += value
    done
    value
}

fn call_empty first:i64 second:i64 third:i64 fourth:i64 {
    "zero-result first argument" 1 first test::assert_eq
    "zero-result second argument" 2 second test::assert_eq
    "zero-result third argument" 3 third test::assert_eq
    "zero-result fourth argument" 4 fourth test::assert_eq
}

fn call_recursive value:i64 -> i64 {
    if value 0 == then
        1 return
    fi
    value 1 - call_recursive value +
}

fn call_bits narrow:i8 floating:f32 -> i8 f32 {
    if narrow 0 == then
        narrow floating return
    fi
    narrow floating
}

fn test_register_call_values {
    "register_call_values" test::test_start
    "zero arguments" 3 call_zero test::assert_eq
    "one argument and result" 42 42 call_one test::assert_eq
    "recursive call" 16 5 call_recursive test::assert_eq
    101 202 4 3 2 1 call_four = first = second = third = fourth = lower = bottom
    "first argument" 1 first test::assert_eq
    "second argument" 2 second test::assert_eq
    "third argument" 3 third test::assert_eq
    "fourth argument" 4 fourth test::assert_eq
    "lower live value" 202 lower test::assert_eq
    "bottom live value" 101 bottom test::assert_eq
    11 22 33 44 swap rot call_four = first = second = third = fourth
    "permuted first" 22 first test::assert_eq
    "permuted second" 33 second test::assert_eq
    "permuted third" 44 third test::assert_eq
    "permuted fourth" 11 fourth test::assert_eq
    2 0 call_two = first = second
    "early first result" 0 first test::assert_eq
    "early second result" 2 second test::assert_eq
    3 2 1 call_three = first = second = third
    "three results" 6 first second + third + test::assert_eq
    99 4 3 2 1 call_empty = lower
    "zero results keep lower value" 99 lower test::assert_eq
    5 4 3 2 1 call_five = first = second = third = fourth = fifth
    "fallback first argument" 1 first test::assert_eq
    "fallback remaining results" 14 second third + fourth + fifth + test::assert_eq
    0x7FC12345 = bits: u32
    -128 = narrow: i8
    bits f32::from_bits narrow call_bits = floating = returned_narrow
    "narrow representation" narrow returned_narrow test::assert_eq
    "float representation" bits floating.to_bits test::assert_eq
}

struct CallOwner {
    drops: ptr
    value: i64
}

impl CallOwner {
    fn drop self:mut$CallOwner {
        # Exercise allocator calls while an immediate closure's results are live.
        unsafe {
            8 alloc = memory
            123 memory store64
            memory free
            self.drops load64 1 + self.drops store64
        }
    }
}

fn test_register_indirect_calls {
    "register_indirect_calls" test::test_start
    &call_four = function: fn[i64 i64 i64 i64 -> i64 i64 i64 i64]
    99 4 3 2 1 function exec = first = second = third = fourth = lower
    "typed first argument" 1 first test::assert_eq
    "typed other arguments" 9 second third + fourth + test::assert_eq
    "typed lower value" 99 lower test::assert_eq
    &call_five = fallback
    5 4 3 2 1 fallback exec = first = second = third = fourth = fifth
    "typed fallback first" 1 first test::assert_eq
    "typed fallback other results" 14 second third + fourth + fifth + test::assert_eq
    0 = count
    { 1 += count count count 10 + } = next
    next exec = high = low
    "borrowed closure first result" 1 low test::assert_eq
    "borrowed closure second result" 11 high test::assert_eq
    next exec = high = low
    "mutated capture first result" 2 low test::assert_eq
    "mutated capture second result" 12 high test::assert_eq
    next drop
    unsafe { 8 alloc = drops 0 drops store64 }
    7 drops CallOwner = owner
    move { owner.value 2 * owner.value } exec = second = first
    "owned closure first result survives cleanup" 14 first test::assert_eq
    "owned closure second result survives cleanup" 7 second test::assert_eq
    "owned capture destroyed once" 1 unsafe { drops load64 } test::assert_eq
    unsafe { drops free }
}

fn retain_through_calls value:i64 -> i64 {
    value value 1 + value 2 + value 3 +
    call_zero drop
    call_one
    + + +
}

fn retain_through_branches value:i64 -> i64 {
    value 10 + value 20 + swap
    if value 0 < then
        swap 2 * swap
    else
        3 *
    fi
    +
}

fn retain_loop_stack limit:i64 -> i64 {
    0 = index
    100
    while index limit < do
        index +
        1 += index
        if index 2 == then
            continue
        fi
        if index 5 == then
            break
        fi
    done
}

fn retained_locals value:i64 -> i64 {
    value = first
    value 1 + = second
    value 2 + = third
    value 3 + = fourth
    first second + third + fourth + drop
    # The callee formats text, allocates, and releases its temporary owners.
    first format_retained_value
    first second + third + fourth +
}

fn format_retained_value value:i64 {
    f"{value}" = text
    "formatting survives local allocation" "7" text.as_str test::assert_eq
}

fn update_borrowed value:mut$i64 {
    # SAFETY: the exclusive borrow provides one live, writable i64.
    unsafe { value ptr::from_ref = address address load64 5 + address store64 }
}

fn retained_borrowed_local value:i64 -> i64 {
    value = local
    local copy drop
    local update_borrowed
    local local + local +
}

fn call_four_results -> i64 i64 i64 i64 {
    call_zero drop
    11 22 33 44
}

fn test_indirect_preserved_results {
    "indirect_preserved_results" test::test_start
    &call_four_results = function
    100 200 function exec = fourth = third = second = first = lower = bottom
    "fourth result" 44 fourth test::assert_eq
    "third result" 33 third test::assert_eq
    "second result" 22 second test::assert_eq
    "first result" 11 first test::assert_eq
    "preserved value below four results" 200 lower test::assert_eq
    "spilled value below preserved value" 100 bottom test::assert_eq
    1 2 3 4 5 6 = sixth = fifth = fourth = third = second = first
    "pressure keeps bottom order" 1 first test::assert_eq
    "pressure keeps second order" 2 second test::assert_eq
    "pressure keeps third order" 3 third test::assert_eq
    "pressure keeps fourth order" 4 fourth test::assert_eq
    "pressure keeps fifth order" 5 fifth test::assert_eq
    "pressure keeps top order" 6 sixth test::assert_eq
}

fn narrow_array_total values:$array[u8 3] -> u8 {
    0 values array::nth copy
    1 values array::nth copy +
    2 values array::nth copy +
}

fn test_array_memory_boundary {
    "array_memory_boundary" test::test_start
    100 200 [1, 2, 3] = values: array[u8 3]
    values narrow_array_total = total = lower = bottom
    "array values survive the consuming loop" 6 total test::assert_eq
    "array construction preserves lower value" 200 lower test::assert_eq
    "array construction preserves bottom value" 100 bottom test::assert_eq
}

fn test_function_register_values {
    "function_register_values" test::test_start
    "live values below a call" 46 10 retain_through_calls test::assert_eq
    "true join with permuted suffix" 35 -5 retain_through_branches test::assert_eq
    "false join with permuted suffix" 70 5 retain_through_branches test::assert_eq
    "loop back edge and exits" 110 10 retain_loop_stack test::assert_eq
    "callee preserves allocated locals" 34 7 retained_locals test::assert_eq
    "address-taken local observes mutation" 36 7 retained_borrowed_local test::assert_eq
    3 dup dup dup dup dup + + + + + = pressured
    "only oldest values spill under pressure" 18 pressured test::assert_eq
    -64 = signed: i8
    192 = unsigned: u8
    "signed narrow shift" -16 signed 2 >> test::assert_eq
    "unsigned narrow shift" 48 unsigned 2 >> test::assert_eq
    "narrow shift truncates" 0 unsigned 2 << test::assert_eq
    9.0 = first: f32
    3.0 = second: f32
    "f32 arithmetic chain" first second / 2.0 * 2.0 - 4.0 == test::assert_true
    9.0 = wide: f64
    "f64 arithmetic chain" wide 3.0 / 2.0 * 2.0 - 4.0 == test::assert_true
}

struct FieldBox[T] {
    value: T
}

struct NestedBox[T] {
    inner: FieldBox[T]
}

struct CopyPair[T] derives std::Copy std::Clone {
    first:  T
    second: T
}

impl[T] FieldBox[T] {
    fn view self:$FieldBox[T] -> $T { self.value }

    fn update self:mut$FieldBox[T] callback:fn[mut$T] { self.value callback exec }
}

impl[T] NestedBox[T] {
    fn view self:$NestedBox[T] -> $T { self.inner.value }
}

fn pair_second [T] pair:$CopyPair[T] -> $T { pair.second }

struct BoxView[T] {
    box: $FieldBox[T]
}

enum Shade {
    Light
    Dark
}

struct ShadeBox {
    shade: Shade
}

fn pass_box [T] box:$FieldBox[T] -> $FieldBox[T] { box }

fn pass_box_mut [T] box:mut$FieldBox[T] -> mut$FieldBox[T] { box }

fn returned_box_view [T] box:$FieldBox[T] -> $T { box pass_box.value }

fn alias_box_view [T] box:$FieldBox[T] -> $T { box = alias alias.value }

fn borrowed_box_view [T] view:$BoxView[T] -> $T { view.box.value }

fn update_returned_box [T] box:mut$FieldBox[T] callback:fn[mut$T] {
    box pass_box_mut.value callback exec
}

fn update_returned_copy [T:std::Copy] box:mut$FieldBox[T] callback:fn[mut$T] {
    box pass_box_mut.value callback exec
}

fn picked_view [T] pick_first:bool first:$FieldBox[T] second:$FieldBox[T] -> $T {
    if pick_first then
        first.value
    else
        second.value
    fi
}

fn picked_returned_view [T] pick_first:bool first:$FieldBox[T] second:$FieldBox[T] -> $T {
    if pick_first then
        first pass_box.value
    else
        second pass_box.value
    fi
}

fn picked_nested_view [T] pick_first:bool first:$FieldBox[T] second:$NestedBox[T] -> $T {
    if pick_first then
        first.value
    else
        second.inner.value
    fi
}

fn replaced_view [T] pick_second:bool first:$FieldBox[T] second:$FieldBox[T] -> $T {
    first.value if pick_second then drop second.value fi
}

fn matched_view [T] choice:std::Option[i64] first:$FieldBox[T] second:$FieldBox[T] -> $T {
    choice match
        std::Option::Some(_) => first.value
        std::Option::None => second.value
    end
}

fn update_picked[T]
    pick_first:bool
    first:mut$FieldBox[T]
    second:mut$FieldBox[T]
    callback:fn[mut$T]
{
    if pick_first then first.value else second.value fi callback exec
}

fn pass_shade_box box:$ShadeBox -> $ShadeBox { box }

fn returned_shade box:$ShadeBox -> $Shade { box pass_shade_box.shade }

fn test_generic_field_borrows {
    "generic_field_borrows" test::test_start
    3 FieldBox = first 5 FieldBox = second
    first.view = first_view second.view = second_view
    "earlier view keeps its field" 3 first_view copy test::assert_eq
    "later view keeps its field" 5 second_view copy test::assert_eq
    7 FieldBox NestedBox = outer 9 FieldBox NestedBox = other
    outer.view = outer_view other.view = other_view
    "nested view keeps its field" 7 outer_view copy test::assert_eq
    "later nested view keeps its field" 9 other_view copy test::assert_eq
    2 1 CopyPair = pair 4 3 CopyPair = other_pair
    pair pair_second = pair_view other_pair pair_second = other_pair_view
    "Copy aggregate view keeps its field" 2 pair_view copy test::assert_eq
    "later Copy aggregate view keeps its field" 4 other_pair_view copy test::assert_eq
    &update_borrowed first.update
    "exclusive field borrow writes the field" 8 first.value test::assert_eq
}

fn test_receiver_field_borrows {
    "receiver_field_borrows" test::test_start
    3 FieldBox = first 5 FieldBox = second
    first returned_box_view = first_returned second returned_box_view = second_returned
    "call result view keeps its field" 3 first_returned copy test::assert_eq
    "later call result view keeps its field" 5 second_returned copy test::assert_eq
    first alias_box_view = first_alias second alias_box_view = second_alias
    "alias view keeps its field" 3 first_alias copy test::assert_eq
    "later alias view keeps its field" 5 second_alias copy test::assert_eq
    first BoxView = first_box second BoxView = second_box
    first_box borrowed_box_view = first_field second_box borrowed_box_view = second_field
    "borrowed field view keeps its field" 3 first_field copy test::assert_eq
    "later borrowed field view keeps its field" 5 second_field copy test::assert_eq
    &update_borrowed first update_returned_box
    "exclusive call result borrow writes the field" 8 first.value test::assert_eq
    &update_borrowed second update_returned_copy
    "Copy call result borrow writes a copy" 5 second.value test::assert_eq
    Shade::Light ShadeBox = light Shade::Dark ShadeBox = dark
    light returned_shade = light_view dark returned_shade = dark_view
    "concrete call result view keeps its field" light_view Shade::Light is test::assert_true
    "later concrete call result view keeps its field" dark_view Shade::Dark is test::assert_true
}

fn test_joined_field_borrows {
    "joined_field_borrows" test::test_start
    3 FieldBox = first 5 FieldBox = second
    second first true picked_view = first_picked second first false picked_view = second_picked
    "joined view keeps the first field" 3 first_picked copy test::assert_eq
    "joined view keeps the second field" 5 second_picked copy test::assert_eq
    second first true picked_returned_view = first_returned second first false picked_returned_view = second_returned
    "joined call result view keeps the first field" 3 first_returned copy test::assert_eq
    "joined call result view keeps the second field" 5 second_returned copy test::assert_eq
    7 FieldBox NestedBox = nested
    nested first true picked_nested_view = first_nested nested first false picked_nested_view = second_nested
    "joined view keeps the shallow field" 3 first_nested copy test::assert_eq
    "joined view keeps the nested field" 7 second_nested copy test::assert_eq
    second first true replaced_view = replaced second first false replaced_view = kept
    "view replaced without else keeps its field" 5 replaced copy test::assert_eq
    "view kept without else keeps its field" 3 kept copy test::assert_eq
    second first 1 std::Option::Some matched_view = first_matched
    second first std::Option[i64]::None matched_view = second_matched
    "match arm view keeps the first field" 3 first_matched copy test::assert_eq
    "match arm view keeps the second field" 5 second_matched copy test::assert_eq
    &update_borrowed second first false update_picked
    "exclusive joined borrow writes the chosen field" 10 second.value test::assert_eq
    "exclusive joined borrow leaves the other field" 3 first.value test::assert_eq
}

fn test_register_normalization_assembly {
    "register_normalization_assembly" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "fn shift value:u8 -> u8 { value 2 << } 3 shift print" helpers::typecheck_test_source = checked
    checked.into_checked_program.unwrap lexer::SourceStore::new swap bytecode::compile_checked.unwrap = text
    text helpers::generated_assembly = generated
    "narrow shift normalizes a register" generated.as_str "movzbq %al, %r" str::contains test::assert_true
    "narrow shift avoids stack normalization" generated.as_str "movzbq 0(%rbx)" str::contains ! test::assert_true
}

fn negate_borrowed value:$bool -> bool { value ! }

fn test_borrowed_logical_values {
    "borrowed_logical_values" test::test_start
    [false, true] = flags
    "named borrowed false negates to true" false negate_borrowed test::assert_true
    "named borrowed true negates to false" true negate_borrowed test::assert_false
    "borrowed false is false in or" 0 flags.nth 0 flags.nth || test::assert_false
    "borrowed false is false in and" 0 flags.nth 1 flags.nth && test::assert_false
    "borrowed true is true in or" 0 flags.nth 1 flags.nth || test::assert_true
    "borrowed true is true in and" 1 flags.nth 1 flags.nth && test::assert_true
    "borrowed false negates to true" 0 flags.nth ! test::assert_true
    "borrowed true negates to false" 1 flags.nth ! test::assert_false
}

pub fn run_tests {
    test_borrowed_logical_values
    test_array_memory_boundary
    test_indirect_preserved_results
    test_function_register_values
    test_register_normalization_assembly
    test_complete_scalar_commit
    test_aggregate_uses_checked_contract
    test_compound_and_wrapping_plans
    test_rejected_source_has_no_backend_input
    test_register_call_values
    test_register_indirect_calls
    test_generic_field_borrows
    test_receiver_field_borrows
    test_joined_field_borrows
    test::test_summary
}
run_tests
