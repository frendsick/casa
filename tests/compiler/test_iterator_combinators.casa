import "std"

0 = test_pass_count
0 = test_fail_count
"" = test_current_name

fn test_start name:str { name = test_current_name }

fn assert_true condition:bool message:$str {
    if condition then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message}\n" eprint
        1 += test_fail_count
    fi
}

fn assert_false condition:bool message:$str { message condition ! assert_true }

fn assert_eq actual:i64 expected:i64 message:$str {
    if expected actual == then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message} (expected {expected}, got {actual})\n" eprint
        1 += test_fail_count
    fi
}

fn assert_u64_eq actual:u64 expected:u64 message:$str {
    if expected actual == then
        1 += test_pass_count
    else
        f"[FAIL] {test_current_name}: {message} (expected {expected}, got {actual})\n" eprint
        1 += test_fail_count
    fi
}

fn test_summary {
    f"{test_pass_count} passed, {test_fail_count} failed\n" print
    if 0 test_fail_count > then
        1 exit
    fi
}

fn is_even value:$i64 -> bool { value 2 % 0 == }

fn repeat_twice n:i64 -> Iter[i64] {
    0 = count
    {
        if 2 count >= then
            Option::None return
        fi
        1 += count
        n Option::Some
    } Iter
}

fn maybe_repeat n:i64 -> Iter[i64] {
    if 2 n == then
        List[i64]::new.iter return
    fi
    n repeat_twice
}

struct Counter {
    value: i64
    limit: i64
}

impl Counter: Iterable[i64] {
    fn next self:mut$Counter -> Option[i64] {
        if self Counter::limit self Counter::value >= then
            Option[i64]::None return
        fi
        self Counter::value = current
        1 += self.value
        current Option::Some
    }
}

# ============================================================================
# Iterator combinator tests
# ============================================================================

fn run_iterator_combinator_tests {
    # --- take ---
    "take" test_start
3 [1, 2, 3, 4, 5] (array[i64 5])
    .iter
    .take
    .collect = take_result
"length" 3 take_result.length assert_u64_eq
"first" 1 0 take_result.get copy assert_eq
"second" 2 1 take_result.get copy assert_eq
"third" 3 2 take_result.get copy assert_eq
"take 0" test_start
0 [1, 2, 3] (array[i64 3])
    .iter
    .take
    .collect = take0_result
"empty" 0 take0_result.length assert_u64_eq
"take more than length" test_start
10 [1, 2] (array[i64 2])
    .iter
    .take
    .collect = take_more
"clamped" 2 take_more.length assert_u64_eq
# --- skip ---
"skip" test_start
2 [1, 2, 3, 4, 5] (array[i64 5])
    .iter
    .skip
    .collect = skip_result
"length" 3 skip_result.length assert_u64_eq
"first" 3 0 skip_result.get copy assert_eq
"last" 5 2 skip_result.get copy assert_eq
"skip 0" test_start
0 [1, 2, 3] (array[i64 3])
    .iter
    .skip
    .collect = skip0_result
"all kept" 3 skip0_result.length assert_u64_eq
"skip all" test_start
5 [1, 2, 3] (array[i64 3])
    .iter
    .skip
    .collect = skip_all
"empty" 0 skip_all.length assert_u64_eq
# --- take_while ---
"take_while" test_start
{ 4 > } [1, 2, 3, 4, 5] (array[i64 5])
    .iter
    .take_while
    .collect = tw_result
"length" 3 tw_result.length assert_u64_eq
"first" 1 0 tw_result.get copy assert_eq
"last" 3 2 tw_result.get copy assert_eq
"take_while none match" test_start
{ 0 > } [5, 6, 7] (array[i64 3])
    .iter
    .take_while
    .collect = tw_none
"empty" 0 tw_none.length assert_u64_eq
"take_while all match" test_start
{ 10 > } [1, 2, 3] (array[i64 3])
    .iter
    .take_while
    .collect = tw_all
"all" 3 tw_all.length assert_u64_eq
# --- skip_while ---
"skip_while" test_start
{ 3 > } [1, 2, 3, 4, 5] (array[i64 5])
    .iter
    .skip_while
    .collect = sw_result
"length" 3 sw_result.length assert_u64_eq
"first" 3 0 sw_result.get copy assert_eq
"skip_while none match" test_start
{ 0 > } [5, 6, 7] (array[i64 3])
    .iter
    .skip_while
    .collect = sw_none
"all kept" 3 sw_none.length assert_u64_eq
"skip_while all match" test_start
{ 10 > } [1, 2, 3] (array[i64 3])
    .iter
    .skip_while
    .collect = sw_all
"empty" 0 sw_all.length assert_u64_eq
# --- enumerate ---
"enumerate" test_start
[10, 20, 30] (array[i64 3])
    .iter
    .enumerate
    .collect = en_result
"length" 3 en_result.length assert_u64_eq
0 en_result.get = ep0
"idx 0" 0 ep0.first assert_eq
"val 0" 10 ep0.second assert_eq
2 en_result.get = ep2
"idx 2" 2 ep2.first assert_eq
"val 2" 30 ep2.second assert_eq
# --- zip ---
"zip" test_start
[4, 5, 6] (array[i64 3]).iter [1, 2, 3] (array[i64 3])
    .iter
    .zip
    .collect = zip_result
"length" 3 zip_result.length assert_u64_eq
0 zip_result.get = zp0
"first.first" 1 zp0.first assert_eq
"first.second" 4 zp0.second assert_eq
"zip stops at shorter" test_start
[4, 5] (array[i64 2]).iter [1, 2, 3] (array[i64 3])
    .iter
    .zip
    .collect = zip_short
"length" 2 zip_short.length assert_u64_eq
"zip empty" test_start
List[i64]::new.iter [1, 2, 3] (array[i64 3])
    .iter
    .zip
    .collect = zip_empty
"empty" 0 zip_empty.length assert_u64_eq
# --- chain ---
"chain" test_start
[4, 5, 6] (array[i64 3]).iter [1, 2, 3] (array[i64 3])
    .iter
    .chain
    .collect = chain_result
"length" 6 chain_result.length assert_u64_eq
"first" 1 0 chain_result.get copy assert_eq
"fourth" 4 3 chain_result.get copy assert_eq
"last" 6 5 chain_result.get copy assert_eq
"chain empty first" test_start
[4, 5] (array[i64 2]).iter List[i64]::new
    .iter
    .chain
    .collect = chain_ef
"length" 2 chain_ef.length assert_u64_eq
"first" 4 0 chain_ef.get copy assert_eq
    # --- flat_map ---
    "flat_map" test_start
    { repeat_twice } [1, 2, 3] (array[i64 3]).iter.flat_map = fm
fm (Iter[i64]).collect = fm_result
"length" 6 fm_result.length assert_u64_eq
"first" 1 0 fm_result.get assert_eq
"second" 1 1 fm_result.get assert_eq
"third" 2 2 fm_result.get assert_eq
"flat_map with take (lazy)" test_start
3 { repeat_twice } [1, 2, 3] (array[i64 3])
    .iter
    .flat_map
    .take
    .collect = fm_take_result: List[i64]
"length" 3 fm_take_result.length assert_u64_eq
"first" 1 0 fm_take_result.get assert_eq
"second" 1 1 fm_take_result.get assert_eq
"third" 2 2 fm_take_result.get assert_eq
"flat_map empty outer" test_start
{ repeat_twice } List[i64]::new
    .iter
    .flat_map
    .collect = fm_empty_result: List[i64]
"length" 0 fm_empty_result.length assert_u64_eq
"flat_map with empty inner" test_start
{ maybe_repeat } [1, 2, 3] (array[i64 3])
    .iter
    .flat_map
    .collect = fm_skip_result: List[i64]
"length" 4 fm_skip_result.length assert_u64_eq
"first" 1 0 fm_skip_result.get assert_eq
"second" 1 1 fm_skip_result.get assert_eq
"third" 3 2 fm_skip_result.get assert_eq
"fourth" 3 3 fm_skip_result.get assert_eq
"flat_map chained with map" test_start
{ 10 * } { repeat_twice } [1, 2] (array[i64 2])
    .iter
    .flat_map
    .map
    .collect = fm_map_result: List[i64]
"length" 4 fm_map_result.length assert_u64_eq
"first" 10 0 fm_map_result.get assert_eq
"second" 10 1 fm_map_result.get assert_eq
"third" 20 2 fm_map_result.get assert_eq
"fourth" 20 3 fm_map_result.get assert_eq
"flat_map chained with filter" test_start
{ 1 < } { repeat_twice } [1, 2, 3] (array[i64 3])
    .iter
    .flat_map
    .filter
    .collect = fm_filt_result: List[i64]
"length" 4 fm_filt_result.length assert_u64_eq
"first" 2 0 fm_filt_result.get assert_eq
"second" 2 1 fm_filt_result.get assert_eq
"third" 3 2 fm_filt_result.get assert_eq
"fourth" 3 3 fm_filt_result.get assert_eq
# --- custom iterator map/filter chaining ---
"custom iterator chained map" test_start

{ 1 + } { 2 * } Counter { value: 0 limit: 5 }
    .map
    .map
    .collect = counter_mapped: List[i64]
"length" 5 counter_mapped.length assert_u64_eq
"first" 1 0 counter_mapped.get assert_eq
"last" 9 4 counter_mapped.get assert_eq
"custom iterator filter+map" test_start
{ 10 + } &is_even Counter { value: 0 limit: 6 }
    .filter
    .map
    .collect = counter_filtered: List[i64]
"length" 3 counter_filtered.length assert_u64_eq
"first" 10 0 counter_filtered.get assert_eq
"last" 14 2 counter_filtered.get assert_eq
# --- sum ---
"sum" test_start
[1, 2, 3, 4, 5] (array[i64 5]).iter.sum = sum_result
"sum" 15 sum_result assert_eq
"sum empty" test_start
List[i64]::new.iter.sum = sum_empty
"zero" 0 sum_empty assert_eq
# --- reduce ---
"reduce" test_start
{ + } [1, 2, 3, 4, 5] (array[i64 5]).iter.reduce = red_result
"is some" red_result.is_some assert_true
"value" 15 red_result.unwrap assert_eq
"reduce empty" test_start
{ + } List[i64]::new.iter.reduce = red_empty
"is none" red_empty.is_none assert_true
# --- min / max ---
"min" test_start
[3, 1, 4, 1, 5, 9] (array[i64 6]).iter.min = min_result
"is some" min_result.is_some assert_true
"value" 1 min_result.unwrap assert_eq
"max" test_start
[3, 1, 4, 1, 5, 9] (array[i64 6]).iter.max = max_result
"is some" max_result.is_some assert_true
"value" 9 max_result.unwrap assert_eq
"min empty" test_start
List[i64]::new.iter.min = min_e
"is none" min_e.is_none assert_true
"max empty" test_start
List[i64]::new.iter.max = max_e
"is none" max_e.is_none assert_true
# --- min_by / max_by ---
"min_by" test_start
{ < } [3, 1, 4, 1, 5] (array[i64 5]).iter.min_by = minby_result
"is some" minby_result.is_some assert_true
"value" 1 minby_result.unwrap assert_eq
"max_by" test_start
{ < } [3, 1, 4, 1, 5] (array[i64 5]).iter.max_by = maxby_result
"is some" maxby_result.is_some assert_true
"value" 5 maxby_result.unwrap assert_eq
# --- partition ---
"partition" test_start
{ 2 % 0 == } [1, 2, 3, 4, 5, 6] (array[i64 6]).iter.partition = part
part.first = part_yes: $List[i64]
part.second = part_no: $List[i64]
"evens count" 3 part_yes.length assert_u64_eq
"odds count" 3 part_no.length assert_u64_eq
"first even" 2 0 part_yes.get copy assert_eq
"first odd" 1 0 part_no.get copy assert_eq
# --- Chaining combinators ---
"pipeline skip+take" test_start
4 2 [1, 2, 3, 4, 5, 6, 7, 8] (array[i64 8])
    .iter
    .skip
    .take
    .collect = pipe1
"length" 4 pipe1.length assert_u64_eq
"first" 3 0 pipe1.get copy assert_eq
"last" 6 3 pipe1.get copy assert_eq
"pipeline take+enumerate" test_start
2 [10, 20, 30] (array[i64 3]).iter.take = taken_2
taken_2.enumerate.collect = pipe2
"length" 2 pipe2.length assert_u64_eq
0 pipe2.get = pipe2_first
"idx" 0 pipe2_first.first assert_eq
"val" 10 pipe2_first.second assert_eq
    test_summary
}

run_iterator_combinator_tests
