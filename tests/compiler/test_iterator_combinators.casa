import "std" as std
import "../../lib/test.casa" as test

pub fn is_even value:$i64 -> bool { value 2 % 0 == }

pub fn repeat_twice n:i64 -> std::Iter[i64] {
    0 = count
    {
        if 2 count <= then
            std::Option::None return
        fi
        1 += count
        n std::Option::Some
    } std::Iter
}

pub fn empty_iter -> std::Iter[i64] {
    { std::Option[i64]::None } std::Iter
}

pub fn maybe_repeat n:i64 -> std::Iter[i64] {
    if 2 n == then
        empty_iter return
    fi
    n repeat_twice
}

pub struct Counter {
    pub value: i64
    pub limit: i64
}

pub struct Tracked {
    pub drops: ptr
    pub value: i64
}

impl Tracked {
    pub fn drop self:mut$Tracked {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

pub fn checked_fold accumulator:i64 value:$i64 -> std::Result[i64 i64] {
    if value copy 3 == then
        73 std::Result::Error
    else
        value copy accumulator + std::Result::Ok
    fi
}

pub fn checked_visit value:$i64 -> std::Result[std::Unit i64] {
    if value copy 3 == then
        73 std::Result::Error
    else
        std::Unit::Value std::Result::Ok
    fi
}

pub fn owned_fold accumulator:Tracked item:Tracked -> std::Result[Tracked Tracked] {
    if item.value 2 == then
        item std::Result::Error
    else
        accumulator.value item.value + = value
        accumulator.drops = drops
        accumulator drop
        item drop
        Tracked { drops: drops value: value } std::Result::Ok
    fi
}

pub fn owned_visit item:Tracked -> std::Result[std::Unit Tracked] {
    if item.value 2 == then
        item std::Result::Error
    else
        item drop
        std::Unit::Value std::Result::Ok
    fi
}

pub fn tracked_values drops:ptr limit:i64 -> std::Iter[Tracked] {
    move { = value Tracked { drops: drops value: value } } Counter { value: 0 limit: limit }.map
}

impl Counter: std::Iterable[i64] {
    pub fn next self:mut$Counter -> std::Option[i64] {
        if self Counter::limit self Counter::value <= then
            std::Option[i64]::None return
        fi
        self Counter::value = current
        1 += self.value
        current std::Option::Some
    }
}

# Iterator combinator tests
pub fn run_iterator_combinator_tests {
    # take
    "take" test::test_start
    3 [1, 2, 3, 4, 5]
        .iter
        .take
        .collect = take_result
    "length" 3 take_result.length test::assert_eq
    "first" 1 0 take_result.get copy test::assert_eq
    "second" 2 1 take_result.get copy test::assert_eq
    "third" 3 2 take_result.get copy test::assert_eq
    "take 0" test::test_start
    0 [1, 2, 3]
        .iter
        .take
        .collect = take0_result
    "empty" 0 take0_result.length test::assert_eq
    "take more than length" test::test_start
    10 [1, 2]
        .iter
        .take
        .collect = take_more
    "clamped" 2 take_more.length test::assert_eq
    # skip
    "skip" test::test_start
    2 [1, 2, 3, 4, 5]
        .iter
        .skip
        .collect = skip_result
    "length" 3 skip_result.length test::assert_eq
    "first" 3 0 skip_result.get copy test::assert_eq
    "last" 5 2 skip_result.get copy test::assert_eq
    "skip 0" test::test_start
    0 [1, 2, 3]
        .iter
        .skip
        .collect = skip0_result
    "all kept" 3 skip0_result.length test::assert_eq
    "skip all" test::test_start
    5 [1, 2, 3]
        .iter
        .skip
        .collect = skip_all
    "empty" 0 skip_all.length test::assert_eq
    # take_while
    "take_while" test::test_start
    { copy 4 < } [1, 2, 3, 4, 5]
        .iter
        .take_while
        .collect = tw_result
    "length" 3 tw_result.length test::assert_eq
    "first" 1 0 tw_result.get copy test::assert_eq
    "last" 3 2 tw_result.get copy test::assert_eq
    "take_while none match" test::test_start
    { copy 0 < } [5, 6, 7]
        .iter
        .take_while
        .collect = tw_none
    "empty" 0 tw_none.length test::assert_eq
    "take_while all match" test::test_start
    { copy 10 < } [1, 2, 3]
        .iter
        .take_while
        .collect = tw_all
    "all" 3 tw_all.length test::assert_eq
    # skip_while
    "skip_while" test::test_start
    { copy 3 < } [1, 2, 3, 4, 5]
        .iter
        .skip_while
        .collect = sw_result
    "length" 3 sw_result.length test::assert_eq
    "first" 3 0 sw_result.get copy test::assert_eq
    "skip_while none match" test::test_start
    { copy 0 < } [5, 6, 7]
        .iter
        .skip_while
        .collect = sw_none
    "all kept" 3 sw_none.length test::assert_eq
    "skip_while all match" test::test_start
    { copy 10 < } [1, 2, 3]
        .iter
        .skip_while
        .collect = sw_all
    "empty" 0 sw_all.length test::assert_eq
    # enumerate
    "enumerate" test::test_start
    [10, 20, 30]
        .iter
        .enumerate
        .collect = en_result
    "length" 3 en_result.length test::assert_eq
    0 en_result.get = ep0
    "idx 0" 0 ep0.first test::assert_eq
    "val 0" 10 ep0.second test::assert_eq
    2 en_result.get = ep2
    "idx 2" 2 ep2.first test::assert_eq
    "val 2" 30 ep2.second test::assert_eq
    # zip
    "zip" test::test_start
    [4, 5, 6].iter [1, 2, 3]
        .iter
        .zip
        .collect = zip_result
    "length" 3 zip_result.length test::assert_eq
    0 zip_result.get = zp0
    "first.first" 1 zp0.first test::assert_eq
    "first.second" 4 zp0.second test::assert_eq
    "zip stops at shorter" test::test_start
    [4, 5].iter [1, 2, 3]
        .iter
        .zip
        .collect = zip_short
    "length" 2 zip_short.length test::assert_eq
    "zip empty" test::test_start
    std::List[i64]::new.iter [1, 2, 3]
        .iter
        .zip
        .collect = zip_empty
    "empty" 0 zip_empty.length test::assert_eq
    # chain
    "chain" test::test_start
    [4, 5, 6].iter [1, 2, 3]
        .iter
        .chain
        .collect = chain_result
    "length" 6 chain_result.length test::assert_eq
    "first" 1 0 chain_result.get copy test::assert_eq
    "fourth" 4 3 chain_result.get copy test::assert_eq
    "last" 6 5 chain_result.get copy test::assert_eq
    "chain empty first" test::test_start
    [4, 5].iter std::List[i64]::new
        .iter
        .chain
        .collect = chain_ef
    "length" 2 chain_ef.length test::assert_eq
    "first" 4 0 chain_ef.get copy test::assert_eq
    # flat_map
    "flat_map" test::test_start
    { copy repeat_twice } [1, 2, 3].iter.flat_map = fm: std::Iter[i64]
    fm.collect = fm_result
    "length" 6 fm_result.length test::assert_eq
    "first" 1 0 fm_result.get test::assert_eq
    "second" 1 1 fm_result.get test::assert_eq
    "third" 2 2 fm_result.get test::assert_eq
    "flat_map with take (lazy)" test::test_start
    3 { copy repeat_twice } [1, 2, 3]
        .iter
        .flat_map
        .take
        .collect = fm_take_result: std::List[i64]
    "length" 3 fm_take_result.length test::assert_eq
    "first" 1 0 fm_take_result.get test::assert_eq
    "second" 1 1 fm_take_result.get test::assert_eq
    "third" 2 2 fm_take_result.get test::assert_eq
    "flat_map empty outer" test::test_start
    { copy repeat_twice } std::List[i64]::new
        .iter
        .flat_map
        .collect = fm_empty_result: std::List[i64]
    "length" 0 fm_empty_result.length test::assert_eq
    "flat_map with empty inner" test::test_start
    { copy maybe_repeat } [1, 2, 3]
        .iter
        .flat_map
        .collect = fm_skip_result: std::List[i64]
    "length" 4 fm_skip_result.length test::assert_eq
    "first" 1 0 fm_skip_result.get test::assert_eq
    "second" 1 1 fm_skip_result.get test::assert_eq
    "third" 3 2 fm_skip_result.get test::assert_eq
    "fourth" 3 3 fm_skip_result.get test::assert_eq
    "flat_map chained with map" test::test_start
    { 10 * } { copy repeat_twice } [1, 2]
        .iter
        .flat_map
        .map
        .collect = fm_map_result: std::List[i64]
    "length" 4 fm_map_result.length test::assert_eq
    "first" 10 0 fm_map_result.get test::assert_eq
    "second" 10 1 fm_map_result.get test::assert_eq
    "third" 20 2 fm_map_result.get test::assert_eq
    "fourth" 20 3 fm_map_result.get test::assert_eq
    "flat_map chained with filter" test::test_start
    { copy 1 > }
    { copy repeat_twice } [1, 2, 3]
        .iter
        .flat_map
        .filter
        .collect = fm_filt_result: std::List[i64]
    "length" 4 fm_filt_result.length test::assert_eq
    "first" 2 0 fm_filt_result.get test::assert_eq
    "second" 2 1 fm_filt_result.get test::assert_eq
    "third" 3 2 fm_filt_result.get test::assert_eq
    "fourth" 3 3 fm_filt_result.get test::assert_eq
    # custom iterator map/filter chaining
    "custom iterator chained map" test::test_start

    { 1 + } { 2 * } Counter { value: 0 limit: 5 }
        .map
        .map
        .collect = counter_mapped: std::List[i64]
    "length" 5 counter_mapped.length test::assert_eq
    "first" 1 0 counter_mapped.get test::assert_eq
    "last" 9 4 counter_mapped.get test::assert_eq
    "custom iterator filter+map" test::test_start
    { 10 + } &is_even Counter { value: 0 limit: 6 }
        .filter
        .map
        .collect = counter_filtered: std::List[i64]
    "length" 3 counter_filtered.length test::assert_eq
    "first" 10 0 counter_filtered.get test::assert_eq
    "last" 14 2 counter_filtered.get test::assert_eq
    # sum
    "sum" test::test_start
    { copy } [1, 2, 3, 4, 5]
        .iter
        .map
        .sum = sum_result
    "sum" 15 sum_result test::assert_eq
    "sum empty" test::test_start
    { copy } std::List[i64]::new
        .iter
        .map
        .sum = sum_empty
    "zero" 0 sum_empty test::assert_eq
    "fold borrowed values" test::test_start
    [1, 2, 3] std::List::from_array = fold_values
    0 = initial_accumulator: i64
    { = accumulator copy accumulator + } initial_accumulator fold_values.iter.fold = fold_result
    "sum" 6 fold_result test::assert_eq
    # fallible terminals borrow the iterator and leave later elements available
    "try_fold" test::test_start
    [1, 2, 3, 4] std::List::from_array = fallible_values
    fallible_values.iter = fold_iter
    &checked_fold 10 fold_iter.try_fold = fold_error
    "original error" 73 fold_error.unwrap_error test::assert_eq
    "next item remains" 4 fold_iter.next.unwrap copy test::assert_eq
    "source loan remains usable" 4 3 fallible_values.get copy test::assert_eq
    &checked_fold 10 fallible_values.iter.try_fold = repeated_error
    "repeatable named callback" 73 repeated_error.unwrap_error test::assert_eq
    &checked_fold 10 std::List[i64]::new.iter.try_fold = empty_fold
    "empty fold returns the initial accumulator" 10 empty_fold.unwrap test::assert_eq
    &checked_fold 10 [1, 2].iter.try_fold = successful_fold
    "successful fold returns the final accumulator" 13 successful_fold.unwrap test::assert_eq
    "try_for_each" test::test_start
    [1, 2, 3, 4] std::List::from_array = visit_values
    visit_values.iter = visit_iter
    &checked_visit visit_iter.try_for_each = visit_error
    "original error" 73 visit_error.unwrap_error test::assert_eq
    "next item remains" 4 visit_iter.next.unwrap copy test::assert_eq
    "source loan remains usable" 4 3 visit_values.get copy test::assert_eq
    &checked_visit std::List[i64]::new
        .iter
        .try_for_each
        .unwrap = empty_visit
    "empty visit succeeds with Unit" std::Unit::Value empty_visit test::assert_eq
    [1, 2] = successful_visit_values
    &checked_visit successful_visit_values.iter.try_for_each = successful_visit_result
    successful_visit_result.unwrap = successful_visit
    "successful visit returns Unit" std::Unit::Value successful_visit test::assert_eq
    "fallible owned item and accumulator cleanup" test::test_start
    unsafe { 8 alloc = drops }
    unsafe { 0 drops store64 }
    4 drops tracked_values = owned_fold_iter
    &owned_fold Tracked { drops: drops value: 10 } owned_fold_iter.try_fold = owned_fold_error
    unsafe { "consumed items and abandoned accumulators drop once" 5 drops load64 test::assert_eq }
    owned_fold_error.unwrap_error = fold_error_item
    "current item is the error owner" 2 fold_error_item.value test::assert_eq
    fold_error_item drop
    unsafe { "error owner drops once" 6 drops load64 test::assert_eq }
    owned_fold_iter.next.unwrap = remaining_fold_item
    "later item remains available" 3 remaining_fold_item.value test::assert_eq
    remaining_fold_item drop
    unsafe { "later item drops once" 7 drops load64 test::assert_eq }
    unsafe { 0 drops store64 }
    2 drops tracked_values = successful_owned_fold_iter
    &owned_fold Tracked { drops: drops value: 10 } successful_owned_fold_iter.try_fold.unwrap
    = final_accumulator
    "owned fold returns the final accumulator" 11 final_accumulator.value test::assert_eq
    unsafe { "earlier accumulators and items drop once" 4 drops load64 test::assert_eq }
    final_accumulator drop
    unsafe { "final accumulator drops once" 5 drops load64 test::assert_eq }
    unsafe { 0 drops store64 }
    0 drops tracked_values = empty_owned_fold_iter
    &owned_fold Tracked { drops: drops value: 10 } empty_owned_fold_iter.try_fold.unwrap
    = empty_accumulator
    "empty fold keeps its accumulator" 10 empty_accumulator.value test::assert_eq
    empty_accumulator drop
    unsafe { "empty accumulator drops once" 1 drops load64 test::assert_eq }
    unsafe { 0 drops store64 }
    4 drops tracked_values = owned_visit_iter
    &owned_visit owned_visit_iter.try_for_each = owned_visit_error
    unsafe { "successful items drop once" 2 drops load64 test::assert_eq }
    owned_visit_error.unwrap_error = visit_error_item
    "current item is the error owner" 2 visit_error_item.value test::assert_eq
    visit_error_item drop
    unsafe { "error owner drops once" 3 drops load64 test::assert_eq }
    owned_visit_iter.next.unwrap = remaining_visit_item
    "later item remains available" 3 remaining_visit_item.value test::assert_eq
    remaining_visit_item drop
    unsafe { "later item drops once" 4 drops load64 test::assert_eq }
    unsafe { drops free }
    # reduce
    "reduce" test::test_start
    { + } Counter { value: 1 limit: 6 }.reduce = red_result
    "is some" red_result.is_some test::assert_true
    "value" 15 red_result.unwrap test::assert_eq
    "reduce empty" test::test_start
    { + } Counter { value: 0 limit: 0 }.reduce = red_empty
    "is none" red_empty.is_none test::assert_true
    # min / max
    "min" test::test_start
    [3, 1, 4, 1, 5, 9].iter.min = min_result
    "is some" min_result.is_some test::assert_true
    "value" 1 min_result.unwrap test::assert_eq
    "max" test::test_start
    [3, 1, 4, 1, 5, 9].iter.max = max_result
    "is some" max_result.is_some test::assert_true
    "value" 9 max_result.unwrap test::assert_eq
    "min empty" test::test_start
    std::List[i64]::new.iter.min = min_e
    "is none" min_e.is_none test::assert_true
    "max empty" test::test_start
    std::List[i64]::new.iter.max = max_e
    "is none" max_e.is_none test::assert_true
    # min_by / max_by
    "min_by" test::test_start
    { > }
    [3, 1, 4, 1, 5].iter.min_by = minby_result
    "is some" minby_result.is_some test::assert_true
    "value" 1 minby_result.unwrap test::assert_eq
    "max_by" test::test_start
    { > }
    [3, 1, 4, 1, 5].iter.max_by = maxby_result
    "is some" maxby_result.is_some test::assert_true
    "value" 5 maxby_result.unwrap test::assert_eq
    # partition
    "partition" test::test_start
    { copy.codepoint 2 % 0 == }
    "123456".iter.partition = part
    part.first = part_yes: $std::List[char]
    part.second = part_no: $std::List[char]
    "evens count" 3 part_yes.length test::assert_eq
    "odds count" 3 part_no.length test::assert_eq
    "first even" 50 0 part_yes.get copy.codepoint i64::from test::assert_eq
    "first odd" 49 0 part_no.get copy.codepoint i64::from test::assert_eq
    # Chaining combinators
    "pipeline skip+take" test::test_start
    4 2 [1, 2, 3, 4, 5, 6, 7, 8]
        .iter
        .skip
        .take
        .collect = pipe1
    "length" 4 pipe1.length test::assert_eq
    "first" 3 0 pipe1.get copy test::assert_eq
    "last" 6 3 pipe1.get copy test::assert_eq
    "pipeline take+enumerate" test::test_start
    2 [10, 20, 30].iter.take = taken_2
    taken_2.enumerate.collect = pipe2
    "length" 2 pipe2.length test::assert_eq
    0 pipe2.get = pipe2_first
    "idx" 0 pipe2_first.first test::assert_eq
    "val" 10 pipe2_first.second test::assert_eq
    test::test_summary
}
run_iterator_combinator_tests
