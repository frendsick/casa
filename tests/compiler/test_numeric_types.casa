pub fn test_numeric_lowering {
    "numeric_lowering" test::test_start
    error::Diagnostics::new = narrow_diagnostics
    narrow_diagnostics "2 = typed:u8 1 typed + drop" emit_numeric_source = narrow_assembly
    "narrow result normalized" narrow_assembly.as_str "movzbq -8(%rbx), %rax" str::contains test::assert_true

    error::Diagnostics::new = f32_diagnostics
    f32_diagnostics "1.5 = value:f32" emit_numeric_source = f32_assembly
    "f32 literal lowering" f32_assembly.as_str ".float 1.5" str::contains test::assert_true

    error::Diagnostics::new = f64_diagnostics
    f64_diagnostics "1.5 drop" emit_numeric_source = f64_assembly
    "f64 literal lowering" f64_assembly.as_str ".double 1.5" str::contains test::assert_true
}

pub fn test_float_literal_bits {
    "float_literal_bits" test::test_start
    -0.0 = f32_zero: f32
    -0.0 = f64_zero: f64
    1.401298464324817e-45 = f32_subnormal: f32
    4.9406564584124654e-324 = f64_subnormal: f64
    1.0000000596046448 = f32_rounded: f32
    1.0000000000000002 = f64_rounded: f64
    "f32 signed zero" 0x80000000 f32_zero.to_bits == test::assert_true
    "f64 signed zero" 0x8000000000000000 f64_zero.to_bits == test::assert_true
    "f32 smallest subnormal" 1 f32_subnormal.to_bits == test::assert_true
    "f64 smallest subnormal" 1 f64_subnormal.to_bits == test::assert_true
    "f32 rounds directly to its width" 0x3F800001 f32_rounded.to_bits == test::assert_true
    "f64 exact literal" 0x3FF0000000000001 f64_rounded.to_bits == test::assert_true
}

pub fn test_float_arithmetic_and_comparison {
    "float_arithmetic_and_comparison" test::test_start
    1.5 = f32_left: f32
    2.25 = f32_right: f32
    "f32 addition" 3.75 f32_right f32_left + == test::assert_true
    "f32 subtraction" 0.75 f32_right f32_left - == test::assert_true
    "f32 multiplication" 3.375 f32_right f32_left * == test::assert_true
    "f32 division" 1.5 f32_right f32_left / == test::assert_true

    1.5 = f64_left: f64
    2.25 = f64_right: f64
    "f64 addition" 3.75 f64_right f64_left + == test::assert_true
    "f64 ordering" f64_right f64_left > test::assert_true
    0.0 0.0 / = nan: f64
    "NaN is not equal to itself" nan nan != test::assert_true
    "NaN is unordered" nan 1.0 > ! test::assert_true
}

pub fn test_named_numeric_conversions {
    "named_numeric_conversions" test::test_start
    120 = small: i8
    "exact integer widening" 120 small i16::from == test::assert_true
    16777217 = rounded_source: i32
    "explicit integer-to-float rounding" 16777216.0 rounded_source f32::round_from == test::assert_true
    257 = wrapping_source: u16
    "integer wrapping keeps low bits" 1 wrapping_source u8::wrapping_from == test::assert_true
    "float truncation" -3 -3.75 i8::trunc_from == test::assert_true

    0x3FC00000 = bits: u32
    bits f32::from_bits = value
    "f32 bits round trip" bits value.to_bits == test::assert_true
    0x3FF8000000000000 = wide_bits: u64
    wide_bits f64::from_bits = wide_value
    "f64 bits round trip" wide_bits wide_value.to_bits == test::assert_true
    0x7FA12345 = f32_nan_bits: u32
    "f32 NaN payload round trip" f32_nan_bits f32_nan_bits f32::from_bits.to_bits == test::assert_true
    0xFFF8000000000001 = f64_nan_bits: u64
    "f64 NaN payload round trip" f64_nan_bits f64_nan_bits f64::from_bits.to_bits == test::assert_true
}

pub fn test_f32_truncation_bounds {
    "f32_truncation_bounds" test::test_start
    1.75 = fraction: f32
    -1.75 = negative_fraction: f32
    -0.0 = negative_zero: f32
    # Upper bounds use the largest representable source within each integer range.
    -128.0 = i8_minimum: f32
    "i8 minimum" -128 i8_minimum i8::trunc_from == test::assert_true
    127.0 = i8_maximum: f32
    "i8 maximum" 127 i8_maximum i8::trunc_from == test::assert_true
    "i8 fraction" 1 fraction i8::trunc_from == test::assert_true
    "i8 negative zero" 0 negative_zero i8::trunc_from == test::assert_true
    "i8 negative fraction" -1 negative_fraction i8::trunc_from == test::assert_true
    -32768.0 = i16_minimum: f32
    "i16 minimum" -32768 i16_minimum i16::trunc_from == test::assert_true
    32767.0 = i16_maximum: f32
    "i16 maximum" 32767 i16_maximum i16::trunc_from == test::assert_true
    "i16 fraction" 1 fraction i16::trunc_from == test::assert_true
    "i16 negative zero" 0 negative_zero i16::trunc_from == test::assert_true
    "i16 negative fraction" -1 negative_fraction i16::trunc_from == test::assert_true
    -2147483648.0 = i32_minimum: f32
    "i32 minimum" -2147483648 i32_minimum i32::trunc_from == test::assert_true
    2147483520.0 = i32_maximum: f32
    "i32 maximum" 2147483520 i32_maximum i32::trunc_from == test::assert_true
    "i32 fraction" 1 fraction i32::trunc_from == test::assert_true
    "i32 negative zero" 0 negative_zero i32::trunc_from == test::assert_true
    "i32 negative fraction" -1 negative_fraction i32::trunc_from == test::assert_true
    -9223372036854775808.0 = i64_minimum: f32
    "i64 minimum" -9223372036854775808 i64_minimum i64::trunc_from == test::assert_true
    9223371487098961920.0 = i64_maximum: f32
    "i64 maximum" 9223371487098961920 i64_maximum i64::trunc_from == test::assert_true
    "i64 fraction" 1 fraction i64::trunc_from == test::assert_true
    "i64 negative zero" 0 negative_zero i64::trunc_from == test::assert_true
    "i64 negative fraction" -1 negative_fraction i64::trunc_from == test::assert_true
    0.0 = u8_minimum: f32
    "u8 minimum" 0 u8_minimum u8::trunc_from == test::assert_true
    255.0 = u8_maximum: f32
    "u8 maximum" 255 u8_maximum u8::trunc_from == test::assert_true
    "u8 fraction" 1 fraction u8::trunc_from == test::assert_true
    "u8 negative zero" 0 negative_zero u8::trunc_from == test::assert_true
    0.0 = u16_minimum: f32
    "u16 minimum" 0 u16_minimum u16::trunc_from == test::assert_true
    65535.0 = u16_maximum: f32
    "u16 maximum" 65535 u16_maximum u16::trunc_from == test::assert_true
    "u16 fraction" 1 fraction u16::trunc_from == test::assert_true
    "u16 negative zero" 0 negative_zero u16::trunc_from == test::assert_true
    0.0 = u32_minimum: f32
    "u32 minimum" 0 u32_minimum u32::trunc_from == test::assert_true
    4294967040.0 = u32_maximum: f32
    "u32 maximum" 4294967040 u32_maximum u32::trunc_from == test::assert_true
    "u32 fraction" 1 fraction u32::trunc_from == test::assert_true
    "u32 negative zero" 0 negative_zero u32::trunc_from == test::assert_true
    0.0 = u64_minimum: f32
    "u64 minimum" 0 u64_minimum u64::trunc_from == test::assert_true
    18446742974197923840.0 = u64_maximum: f32
    "u64 maximum" 18446742974197923840 u64_maximum u64::trunc_from == test::assert_true
    "u64 fraction" 1 fraction u64::trunc_from == test::assert_true
    "u64 negative zero" 0 negative_zero u64::trunc_from == test::assert_true
}

pub fn test_f64_truncation_bounds {
    "f64_truncation_bounds" test::test_start
    "i8 minimum" -128 -128.0 i8::trunc_from == test::assert_true
    "i8 maximum" 127 127.0 i8::trunc_from == test::assert_true
    "i8 fraction" 1 1.75 i8::trunc_from == test::assert_true
    "i8 negative zero" 0 -0.0 i8::trunc_from == test::assert_true
    "i8 negative fraction" -1 -1.75 i8::trunc_from == test::assert_true
    "i16 minimum" -32768 -32768.0 i16::trunc_from == test::assert_true
    "i16 maximum" 32767 32767.0 i16::trunc_from == test::assert_true
    "i16 fraction" 1 1.75 i16::trunc_from == test::assert_true
    "i16 negative zero" 0 -0.0 i16::trunc_from == test::assert_true
    "i16 negative fraction" -1 -1.75 i16::trunc_from == test::assert_true
    "i32 minimum" -2147483648 -2147483648.0 i32::trunc_from == test::assert_true
    "i32 maximum" 2147483647 2147483647.0 i32::trunc_from == test::assert_true
    "i32 fraction" 1 1.75 i32::trunc_from == test::assert_true
    "i32 negative zero" 0 -0.0 i32::trunc_from == test::assert_true
    "i32 negative fraction" -1 -1.75 i32::trunc_from == test::assert_true
    "i64 minimum" -9223372036854775808 -9223372036854775808.0 i64::trunc_from == test::assert_true
    "i64 maximum" 9223372036854774784 9223372036854774784.0 i64::trunc_from == test::assert_true
    "i64 fraction" 1 1.75 i64::trunc_from == test::assert_true
    "i64 negative zero" 0 -0.0 i64::trunc_from == test::assert_true
    "i64 negative fraction" -1 -1.75 i64::trunc_from == test::assert_true
    "u8 minimum" 0 0.0 u8::trunc_from == test::assert_true
    "u8 maximum" 255 255.0 u8::trunc_from == test::assert_true
    "u8 fraction" 1 1.75 u8::trunc_from == test::assert_true
    "u8 negative zero" 0 -0.0 u8::trunc_from == test::assert_true
    "u16 minimum" 0 0.0 u16::trunc_from == test::assert_true
    "u16 maximum" 65535 65535.0 u16::trunc_from == test::assert_true
    "u16 fraction" 1 1.75 u16::trunc_from == test::assert_true
    "u16 negative zero" 0 -0.0 u16::trunc_from == test::assert_true
    "u32 minimum" 0 0.0 u32::trunc_from == test::assert_true
    "u32 maximum" 4294967295 4294967295.0 u32::trunc_from == test::assert_true
    "u32 fraction" 1 1.75 u32::trunc_from == test::assert_true
    "u32 negative zero" 0 -0.0 u32::trunc_from == test::assert_true
    "u64 minimum" 0 0.0 u64::trunc_from == test::assert_true
    "u64 maximum" 18446744073709549568 18446744073709549568.0 u64::trunc_from == test::assert_true
    "u64 fraction" 1 1.75 u64::trunc_from == test::assert_true
    "u64 negative zero" 0 -0.0 u64::trunc_from == test::assert_true
}

pub fn test_invalid_named_conversion_diagnostic {
    "invalid_named_conversion_diagnostic" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "1 = value:i64 value u8::from" check_numeric_source drop
    diagnostics "narrowing exact conversion rejected" helpers::assert_has_errors
    diagnostics "conversion names its source" "does not accept `i64`" helpers::assert_error_contains
}

pub fn test_checked_numeric_conversions {
    "checked_numeric_conversions" test::test_start
    255 = max_byte: i64
    "integer narrowing succeeds" 255 max_byte u8::try_from.unwrap == test::assert_true
    256 = too_large: i64
    "integer narrowing rejects range" too_large u8::try_from.is_none test::assert_true
    -1 = negative: i64
    "signed to unsigned rejects negative" negative u64::try_from.is_none test::assert_true
    42.0 = whole: f64
    "integral float succeeds" 42 whole i64::try_from.unwrap == test::assert_true
    42.5 = fractional: f64
    "fractional float rejected" fractional i64::try_from.is_none test::assert_true
    "NaN rejected" f64::nan i64::try_from.is_none test::assert_true
    16777216 = exact_float: i32
    "exact integer to f32" 16777216.0 exact_float f32::try_from.unwrap == test::assert_true
    16777217 = rounded_float: i32
    "rounded integer to f32 rejected" rounded_float f32::try_from.is_none test::assert_true
    1.5 = wide: f64
    "exact narrowing float" 1.5 wide f32::try_from.unwrap == test::assert_true
    1.1 = inexact_wide: f64
    "inexact narrowing float rejected" inexact_wide f32::try_from.is_none test::assert_true
}

pub fn test_recoverable_integer_arithmetic {
    "recoverable_integer_arithmetic" test::test_start
    127 = max_i8: i8
    "try_add rejects overflow" 1 max_i8.try_add.is_none test::assert_true
    120 = base_i8: i8
    "try_add succeeds" 127 7 base_i8.try_add.unwrap == test::assert_true
    -128 = min_i8: i8
    "try_sub rejects overflow" 1 min_i8.try_sub.is_none test::assert_true
    4 = factor: i8
    "try_mul succeeds" 8 2 factor.try_mul.unwrap == test::assert_true
    "try_mul rejects overflow" 100 factor.try_mul.is_none test::assert_true
    0 = zero: i8
    "try_div rejects zero" zero factor.try_div.is_none test::assert_true
    -1 = negative_one: i8
    "try_div rejects signed minimum overflow" negative_one min_i8.try_div.is_none test::assert_true
    3 = divisor: i8
    10 = dividend: i8
    "try_mod succeeds" 1 divisor dividend.try_mod.unwrap == test::assert_true
    255 = max_u8: u8
    "unsigned try_add rejects overflow" 1 max_u8.try_add.is_none test::assert_true
    "wrapping add remains explicit" 0 1 max_u8.wrapping_add == test::assert_true
}

pub fn test_captured_compound_assignments {
    "captured_compound_assignments" test::test_start
    125 = count_i8: i8
    {
        2 += count_i8
        "i8 captured addition reaches maximum" 127 count_i8 == test::assert_true
        3 -= count_i8
        "i8 captured subtraction keeps operand order" 124 count_i8 == test::assert_true
    } exec
    32765 = count_i16: i16
    {
        2 += count_i16
        "i16 captured addition reaches maximum" 32767 count_i16 == test::assert_true
        3 -= count_i16
        "i16 captured subtraction keeps operand order" 32764 count_i16 == test::assert_true
    } exec
    2147483645 = count_i32: i32
    {
        2 += count_i32
        "i32 captured addition reaches maximum" 2147483647 count_i32 == test::assert_true
        3 -= count_i32
        "i32 captured subtraction keeps operand order" 2147483644 count_i32 == test::assert_true
    } exec
    9223372036854775805 = count_i64: i64
    {
        2 += count_i64
        "i64 captured addition reaches maximum" 9223372036854775807 count_i64 == test::assert_true
        3 -= count_i64
        "i64 captured subtraction keeps operand order" 9223372036854775804 count_i64 == test::assert_true
    } exec
    253 = count_u8: u8
    {
        2 += count_u8
        "u8 captured addition reaches maximum" 255 count_u8 == test::assert_true
        3 -= count_u8
        "u8 captured subtraction keeps operand order" 252 count_u8 == test::assert_true
    } exec
    65533 = count_u16: u16
    {
        2 += count_u16
        "u16 captured addition reaches maximum" 65535 count_u16 == test::assert_true
        3 -= count_u16
        "u16 captured subtraction keeps operand order" 65532 count_u16 == test::assert_true
    } exec
    4294967293 = count_u32: u32
    {
        2 += count_u32
        "u32 captured addition reaches maximum" 4294967295 count_u32 == test::assert_true
        3 -= count_u32
        "u32 captured subtraction keeps operand order" 4294967292 count_u32 == test::assert_true
    } exec
    18446744073709551613 = count_u64: u64
    {
        2 += count_u64
        "u64 captured addition reaches maximum" 18446744073709551615 count_u64 == test::assert_true
        3 -= count_u64
        "u64 captured subtraction keeps operand order" 18446744073709551612 count_u64 == test::assert_true
    } exec
    -127 = owned: i8
    move {
        1 -= owned
        "owned capture reaches minimum" -128 owned == test::assert_true
        2 += owned
        "owned capture increments negative value" -126 owned == test::assert_true
    } exec
}

pub fn test_character_and_generic_construction {
    "character_and_generic_construction" test::test_start
    "codepoint" 65 'A'.codepoint == test::assert_true
    65 = capital_a: u32
    "valid scalar" 'A' capital_a char::from_codepoint.unwrap == test::assert_true
    0xD800 = surrogate: u32
    "surrogate rejected" surrogate char::from_codepoint.is_none test::assert_true
    0x110000 = too_large: u32
    "large codepoint rejected" too_large char::from_codepoint.is_none test::assert_true
    "Unicode display" "😀" 0x1F600 = emoji: u32 emoji char::from_codepoint.unwrap.to_str test::assert_str_eq

    0 = codepoint: u32
    true = all_scalars_round_trip
    while codepoint 0x110000 < do
        if 0xD800 codepoint <= 0xDFFF codepoint >= && ! then
            codepoint char::from_codepoint = character
            if character.is_none then
                false = all_scalars_round_trip
                break
            fi
            if codepoint character.unwrap.codepoint != then
                false = all_scalars_round_trip
                break
            fi
        fi
        1 += codepoint
    done
    "every scalar round trips" all_scalars_round_trip test::assert_true

    std::List[i64]::new = values
    "explicit generic associated type" 0 values.length == test::assert_true
}

pub fn test_float_helpers {
    "float_helpers" test::test_start
    "f32 NaN" f32::nan.is_nan test::assert_true
    "f32 NaN is not finite" f32::nan.is_finite ! test::assert_true
    "f64 infinity" f64::infinity.is_infinite test::assert_true
    "f64 infinity is not finite" f64::infinity.is_finite ! test::assert_true
    1.5 = finite: f32
    "finite" finite.is_finite test::assert_true
    -1.5 = negative: f32
    "absolute value" 1.5 negative.abs == test::assert_true
    1.75 = floor_value: f32
    "floor" 1.0 floor_value.floor == test::assert_true
    -1.75 = negative_floor_value: f32
    "negative floor" -2.0 negative_floor_value.floor == test::assert_true
    1.25 = ceil_value: f32
    "ceil" 2.0 ceil_value.ceil == test::assert_true
    -1.25 = negative_ceil_value: f32
    "negative ceil" -1.0 negative_ceil_value.ceil == test::assert_true
    -1.75 = trunc_value: f32
    "trunc" -1.0 trunc_value.trunc == test::assert_true
    2.5 = f32_round_down: f32
    "f32 ties to even" 2.0 f32_round_down.round == test::assert_true
    -0.25 = negative_small_f32: f32
    "f32 trunc preserves negative zero" 0x80000000 negative_small_f32.trunc.to_bits ==
    test::assert_true
    "f32 ceil preserves negative zero" 0x80000000 negative_small_f32.ceil.to_bits ==
    test::assert_true
    "f32 round preserves negative zero" 0x80000000 negative_small_f32.round.to_bits ==
    test::assert_true
    2.5 = round_down: f64
    "ties to even down" 2.0 round_down.round == test::assert_true
    3.5 = round_up: f64
    "ties to even up" 4.0 round_up.round == test::assert_true
    -1.75 = f64_value: f64
    "f64 floor" -2.0 f64_value.floor == test::assert_true
    "f64 ceil" -1.0 f64_value.ceil == test::assert_true
    "f64 trunc" -1.0 f64_value.trunc == test::assert_true
    -0.25 = negative_small_f64: f64
    "f64 round preserves negative zero" 0x8000000000000000 negative_small_f64.round.to_bits ==
    test::assert_true
    "large integral f64 unchanged" 4503599627370496.0
    4503599627370496.0.floor == test::assert_true
    "infinity unchanged" f64::infinity f64::infinity.ceil == test::assert_true
    "NaN remains NaN" f64::nan.trunc.is_nan test::assert_true
}

pub fn test_float_parsing {
    "float_parsing" test::test_start
    "f32 decimal" 1.25 "1.25".to_f32.unwrap == test::assert_true
    "f64 exponent" 1500.0 "1.5e3".to_f64.unwrap == test::assert_true
    "negative exponent" 0.015 "1.5e-2".to_f64.unwrap == test::assert_true
    "negative zero bits" 0x80000000 "-0.0"
        .to_f32
        .unwrap
        .to_bits == test::assert_true
    "NaN" "NaN"
        .to_f64
        .unwrap
        .is_nan test::assert_true
    "infinity" "-inf"
        .to_f32
        .unwrap
        .is_infinite test::assert_true
    "positive infinity" "inf".to_f64.unwrap f64::infinity == test::assert_true
    "f32 rounds directly to its target width" 0x3F800001
    "1.000000059604644775390626"
        .to_f32
        .unwrap
        .to_bits == test::assert_true
    "f32 decimal tie rounds to even" 0x3F800002
    "1.000000178813934326171875"
        .to_f32
        .unwrap
        .to_bits == test::assert_true
    "f64 retains significant input past 17 decimal digits" 0x3FF0000000000001
    "1.00000000000000011102230246251565404236316680908203126"
        .to_f64
        .unwrap
        .to_bits == test::assert_true
    "f64 decimal tie rounds to even" 0x3FF0000000000000
    "1.00000000000000011102230246251565404236316680908203125"
        .to_f64
        .unwrap
        .to_bits == test::assert_true
    "large exponent zero" 0.0 "0e10000".to_f64.unwrap == test::assert_true
    "large negative exponent underflows" 0.0 "1e-10000".to_f64.unwrap == test::assert_true
    "malformed decimal" "1.".to_f64.is_none test::assert_true
    "malformed exponent" "1e".to_f32.is_none test::assert_true
    "overflow" "1e10000".to_f64.is_none test::assert_true
}

pub fn test_float_display {
    "float_display" test::test_start
    1.5 = simple: f32
    "simple f32" "1.5" simple.to_str test::assert_str_eq
    -0.0 = negative_zero: f64
    "negative zero" "-0.0" negative_zero.to_str test::assert_str_eq
    "NaN spelling" "NaN" f32::nan.to_str test::assert_str_eq
    "infinity spelling" "inf" f64::infinity.to_str test::assert_str_eq
    "negative infinity spelling" "-inf" f64::neg_infinity.to_str test::assert_str_eq
    0.10000000149011612 = tenth: f32
    "f32 round trip" tenth.to_bits tenth
        .to_str
        .to_f32
        .unwrap
        .to_bits == test::assert_true
    1.2345678901234567 = precise: f64
    "f64 round trip" precise.to_bits precise
        .to_str
        .to_f64
        .unwrap
        .to_bits == test::assert_true
}

