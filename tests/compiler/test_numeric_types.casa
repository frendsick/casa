pub fn test_context_flows_through_generic_parameter {
    error::Diagnostics::new = diagnostics
    "context_flows_through_generic_parameter" test::test_start
    diagnostics "fn same[T] first:T second:T { } 1 = typed:u8 2 typed same" check_numeric_source = effect
    diagnostics "generic literal context" helpers::assert_no_errors
    "call consumes both values" 0 effect.return_types.length == test::assert_true

    error::Diagnostics::new = reversed_diagnostics
    reversed_diagnostics "fn same[T] first:T second:T { } 1 = typed:u8 typed 2 same" check_numeric_source
    drop
    reversed_diagnostics "generic literal context is argument-order independent" helpers::assert_no_errors

    error::Diagnostics::new = default_diagnostics
    default_diagnostics "fn same[T] first:T second:T { } 1 2 same" check_numeric_source drop
    default_diagnostics "unconstrained generic literals use the common default" helpers::assert_no_errors

    error::Diagnostics::new = array_diagnostics
    array_diagnostics
    "fn take[T const N:u64] items:array[T N] value:T { } 1 = typed:u8 typed [255] take"
    check_numeric_source
    drop
    array_diagnostics "generic sibling constrains array literal" helpers::assert_no_errors
}

pub fn test_function_parameters_constrain_literals {
    "function_parameters_constrain_literals" test::test_start
    error::Diagnostics::new = valid_diagnostics
    valid_diagnostics "fn id x:u8 -> u8 { x } 255 id" check_numeric_source = effect
    valid_diagnostics "function parameter context retained" helpers::assert_no_errors
    "function return type" "u8" 0 effect
        .return_types
        .get
        .format test::assert_str_eq

    error::Diagnostics::new = range_diagnostics
    range_diagnostics "fn id x:u8 -> u8 { x } 256 id" check_numeric_source drop
    range_diagnostics "function argument range checked" "outside `u8` range 0..255" helpers::assert_error_contains

    error::Diagnostics::new = generic_diagnostics
    generic_diagnostics "fn id[T] x:T -> T { x } 1 id" check_numeric_source = generic_effect
    generic_diagnostics "generic function defers numeric inference" helpers::assert_no_errors
    "generic function default" "i64" 0 generic_effect
        .return_types
        .get
        .format test::assert_str_eq
}

pub fn test_constants_preserve_numeric_literals {
    "constants_preserve_numeric_literals" test::test_start
    error::Diagnostics::new = integer_diagnostics
    integer_diagnostics
    "const MAX 18446744073709551615 MAX = value:u64 value"
    check_numeric_source = integer_effect
    integer_diagnostics "u64 constant retains exact magnitude" helpers::assert_no_errors
    "u64 constant type" "u64" 0 integer_effect
        .return_types
        .get
        .format test::assert_str_eq

    error::Diagnostics::new = float_diagnostics
    float_diagnostics "const HALF 0.5 HALF = value:f32 value" check_numeric_source = float_effect
    float_diagnostics "floating constant retains literal kind" helpers::assert_no_errors
    "floating constant type" "f32" 0 float_effect
        .return_types
        .get
        .format test::assert_str_eq

    error::Diagnostics::new = block_diagnostics
    block_diagnostics
    "const BAD { 18446744073709551615 1 + } BAD"
    helpers::parse_resolve_test_source
    drop
    block_diagnostics "const arithmetic defaults operands to i64" "outside `i64` range" helpers::assert_error_contains
}

pub fn test_context_flows_through_struct_fields_and_patterns {
    "context_flows_through_struct_fields_and_patterns" test::test_start
    error::Diagnostics::new = struct_diagnostics
    struct_diagnostics "struct Small { value: u8 } Small { value: 255 }" check_numeric_source drop
    struct_diagnostics "struct field constrains literal" helpers::assert_no_errors

    error::Diagnostics::new = struct_range_diagnostics
    struct_range_diagnostics "struct Small { value: u8 } Small { value: 256 }" check_numeric_source drop
    struct_range_diagnostics "struct field range checked" "outside `u8` range 0..255" helpers::assert_error_contains

    error::Diagnostics::new = pattern_diagnostics
    pattern_diagnostics "1 = subject:u8 subject match 1 => 0 _ => 1 end" check_numeric_source drop
    pattern_diagnostics "match subject constrains literal pattern" helpers::assert_no_errors

    error::Diagnostics::new = pattern_range_diagnostics
    pattern_range_diagnostics "1 = subject:u8 subject match 256 => 0 _ => 1 end" check_numeric_source drop
    pattern_range_diagnostics "literal pattern range checked" "outside `u8` range 0..255" helpers::assert_error_contains
}

