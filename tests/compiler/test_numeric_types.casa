import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

pub fn check_numeric_source code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = source_bodies = store = ops
    source_bodies diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

pub fn emit_numeric_source code:$str diagnostics:mut$error::Diagnostics -> std::String {
    diagnostics code helpers::compile_test_source
}

pub fn assert_numeric_type expected:str annotation:str literal:str {
    error::Diagnostics::new = diagnostics
    diagnostics f"{literal} = value:{annotation} value".as_str check_numeric_source = effect
    diagnostics f"{annotation} accepts its literal" helpers::assert_no_errors
    f"{annotation} inferred type" expected 0 effect
        .return_types
        .get
        .format test::assert_str_eq
}

pub fn test_explicit_integer_widths {
    "explicit_integer_widths" test::test_start
    "127" "i8" "i8" assert_numeric_type
    "32767" "i16" "i16" assert_numeric_type
    "2147483647" "i32" "i32" assert_numeric_type
    "9223372036854775807" "i64" "i64" assert_numeric_type
    "255" "u8" "u8" assert_numeric_type
    "65535" "u16" "u16" assert_numeric_type
    "4294967295" "u32" "u32" assert_numeric_type
    "18446744073709551615" "u64" "u64" assert_numeric_type
}

pub fn test_hexadecimal_integer_types {
    "hexadecimal_integer_types" test::test_start
    "0x7f" "i8" "i8" assert_numeric_type
    "-0x80" "i8" "i8" assert_numeric_type
    "0x7FFF" "i16" "i16" assert_numeric_type
    "-0x8000" "i16" "i16" assert_numeric_type
    "0x7fffffff" "i32" "i32" assert_numeric_type
    "-0x80000000" "i32" "i32" assert_numeric_type
    "0x7FFFFFFFFFFFFFFF" "i64" "i64" assert_numeric_type
    "-0x8000000000000000" "i64" "i64" assert_numeric_type
    "0xff" "u8" "u8" assert_numeric_type
    "0xFFFF" "u16" "u16" assert_numeric_type
    "0xFFFFFFFF" "u32" "u32" assert_numeric_type
    "0xFFFFFFFFFFFFFFFF" "u64" "u64" assert_numeric_type
    "0x00000000000000000Ff" "u8" "u8" assert_numeric_type
    "-0x0" "i64" "i64" assert_numeric_type

    error::Diagnostics::new = diagnostics
    diagnostics "0x1e2" check_numeric_source = effect
    diagnostics "hex e digits remain integers" helpers::assert_no_errors
    "hex default" "i64" 0 effect
        .return_types
        .get
        .format test::assert_str_eq
}

pub fn test_hexadecimal_contexts {
    "hexadecimal_contexts" test::test_start
    for
        source in [
            "const MASK 0xFFFFFFFFFFFFFFF8 const SUM: u64 { MASK 0x7 + } SUM drop MASK = mask:u64 mask drop",
            "const NEG -0x80 NEG = small:i8 small drop",
            "fn byte value:u8 -> u8 { value } 0xFF byte drop",
            "struct Byte { value: u8 } Byte { value: 0xff } drop",
            "0xFF = subject:u8 subject match 0xff => 0 _ => 1 end drop",
            "fn size [const N:u64] -> u64 { N } &size[0xFFFFFFFFFFFFFFFF] exec drop",
            "fn signed [const N:i8] -> i8 { N } &signed[-0x80] exec drop",
            "[0x00, 0xff] = bytes:array[u8 0x2] bytes drop",
            "0xFF = typed:u8 typed 0x0 + drop",
        ].iter
    do
        error::Diagnostics::new = diagnostics
        diagnostics source helpers::typecheck_test_source.get_diagnostics.clone diagnostics.merge
        diagnostics source helpers::assert_no_errors
    done
}
const HEX_MASK: u64 0xFFFFFFFFFFFFFFF8
const HEX_SUM: u64 { HEX_MASK 0x7 + }

pub fn hexadecimal_value[const N:u64] -> u64 { N }

pub fn test_hexadecimal_runtime {
    "hexadecimal_runtime" test::test_start
    "default value" 482 0x1e2 test::assert_eq
    "negative value" -128 -0x80 test::assert_eq
    "signed minimum" -9223372036854775808 -0x8000000000000000 test::assert_eq
    0xFFFFFFFFFFFFFFFF = maximum: u64
    "full u64 bits" 18446744073709551615 maximum test::assert_eq
    "constant argument bits" maximum &hexadecimal_value[0xFFFFFFFFFFFFFFFF] exec test::assert_eq
    0x123F = address: u64
    "mask clears low bits" 4664 address HEX_MASK & test::assert_eq
    "constant arithmetic" maximum HEX_SUM test::assert_eq
    [0x00, 0xff] = bytes: array[u8 0x2]
    "array element" 255 1 bytes.nth copy test::assert_eq
    0xFF = subject: u8
    subject match
        0xff => "pattern value" true test::assert_true
        _ => "pattern value" false test::assert_true
    end
}

pub fn test_hexadecimal_range_diagnostics {
    "hexadecimal_range_diagnostics" test::test_start
    for
        source in [
            "0x100 = value:u8",
            "0x80 = value:i8",
            "-0x81 = value:i8",
            "-0x1 = value:u64",
            "0x8000000000000000",
            "0xFFFFFFFFFFFFFFFF",
            "-0x8000000000000001",
            "0x10000000000000000 = value:u64",
            "0x000010000000000000000 = value:u64",
            "const BAD: u8 0x100",
            "fn byte value:u8 { } 0x100 byte",
            "0 = subject:u8 subject match 0x100 => 0 _ => 1 end",
            "fn size [const N:u64] -> u64 { N } &size[0x10000000000000000] exec",
        ].iter
    do
        error::Diagnostics::new = diagnostics
        diagnostics source helpers::typecheck_test_source.get_diagnostics.clone diagnostics.merge
        diagnostics source "range" helpers::assert_error_contains
    done
    error::Diagnostics::new = diagnostics
    diagnostics "fn signed [const N:i8] -> i8 { N } &signed[-0x81] exec"
    helpers::typecheck_test_source.get_diagnostics.clone diagnostics.merge
    diagnostics "signed constant argument width" "does not fit type `i8`" helpers::assert_error_contains
}

