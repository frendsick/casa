    "explicit_float_widths" test::test_start
    "1.5" "f32" "f32" assert_numeric_type
    "1.5e2" "f64" "f64" assert_numeric_type
}

pub fn test_numeric_literal_defaults {
    error::Diagnostics::new = integer_diagnostics
    "numeric_literal_defaults" test::test_start
    integer_diagnostics "1" check_numeric_source = integer_effect
    "integer default" "i64" 0 integer_effect
        .return_types
        .get
        .format test::assert_str_eq

    error::Diagnostics::new = float_diagnostics
    float_diagnostics "1.25" check_numeric_source = float_effect
    "float default" "f64" 0 float_effect
        .return_types
