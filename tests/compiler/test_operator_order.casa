import "std" as std
import "../../lib/test.casa" as test

const CONSTANT_LESS { 10 3 < }
const CONSTANT_LESS_EQUAL { 3 3 <= }
const CONSTANT_GREATER { 10 3 > }
const CONSTANT_GREATER_EQUAL { 3 10 >= }
const CONSTANT_EQUAL { 3 3 == }
const CONSTANT_UNEQUAL { 3 10 != }
const HIGH: u64 18446744073709551615
const CONSTANT_UNSIGNED { HIGH 1 > }
const CONSTANT_FLOAT { 1.5 2.5 < }
const NARROW_FLOAT: f32 1.5
const CONSTANT_NARROW_FLOAT { NARROW_FLOAT 2.5 <= }

fn test_primitives {
    "subtraction" 7 10 3 - test::assert_eq
    "division" 3 10 3 / test::assert_eq
    "remainder" 1 10 3 % test::assert_eq
    "less" 10 3 < test::assert_false
    "less equal" 3 3 <= test::assert_true
    "greater" 10 3 > test::assert_true
    "greater equal" 3 10 >= test::assert_false
    "signed ordering" -10 3 < test::assert_true
    "unsigned ordering" HIGH 1 > test::assert_true
    "character ordering" 'a' 'z' < test::assert_true
    "f64 ordering" 1.5 2.5 < test::assert_true
    "f64 greater" 2.5 1.5 > test::assert_true
    "f32 ordering" NARROW_FLOAT 2.5 < test::assert_true
    "f32 greater equal" NARROW_FLOAT 2.5 >= test::assert_false
    "NaN on left" f64::nan 0.0 < test::assert_false
    "NaN on right" 0.0 f64::nan >= test::assert_false
    "NaN equality" f32::nan f32::nan == test::assert_false
    "NaN inequality" f32::nan f32::nan != test::assert_true
    "shift left" 12 3 2 << test::assert_eq
    "shift right" 3 12 2 >> test::assert_eq
    "bitwise and" 2 3 6 & test::assert_eq
    "bitwise or" 7 3 6 | test::assert_eq
    "bitwise xor" 5 3 6 ^ test::assert_eq
    "text and owned text" "text" "text".to_str == test::assert_true
    "owned text and text" "text".to_str "text" == test::assert_true

    0 = count
    while count 3 < do
        1 += count
    done
    "comparison branch" 3 count test::assert_eq
    "constant less" CONSTANT_LESS test::assert_false
    "constant less equal" CONSTANT_LESS_EQUAL test::assert_true
    "constant greater" CONSTANT_GREATER test::assert_true
    "constant greater equal" CONSTANT_GREATER_EQUAL test::assert_false
    "constant equality" CONSTANT_EQUAL test::assert_true
    "constant inequality" CONSTANT_UNEQUAL test::assert_true
    "constant unsigned" CONSTANT_UNSIGNED test::assert_true
    "constant f64" CONSTANT_FLOAT test::assert_true
    "constant f32" CONSTANT_NARROW_FLOAT test::assert_true
}

# Asymmetric methods expose the receiver and method selected by each operator.
# The owned text also exercises the lifetime of borrowed operand temporaries.
struct Probe {
    value: i64
    text:  std::String
}

impl Probe: std::PartialOrd {
    fn new value:i64 -> Probe { "probe".to_str value Probe }
    fn eq self:$Probe other:$Probe -> bool { self.value 1 == other.value 2 == && }
    fn ne self:$Probe other:$Probe -> bool { self.value 3 == other.value 4 == && }
    fn lt self:$Probe other:$Probe -> bool { self.value 5 == other.value 6 == && }
    fn le self:$Probe other:$Probe -> bool { self.value 7 == other.value 8 == && }
    fn gt self:$Probe other:$Probe -> bool { self.value 9 == other.value 10 == && }
    fn ge self:$Probe other:$Probe -> bool { self.value 11 == other.value 12 == && }
    fn partial_cmp self:$Probe other:$Probe -> std::Option[std::Ordering] {
        self drop other drop std::Option::None
    }
}

fn equal [T:std::PartialEq] left:$T right:$T -> bool { left right == }

fn before [T:std::PartialOrd] left:$T right:$T -> bool { left right < }

fn subtract left:i64 right:i64 -> i64 { left right - }

fn apply_byte callback:fn[u8 -> u8] value:u8 -> u8 { value callback exec }

fn test_dispatch {
    "eq receiver" 1 Probe::new 2 Probe::new == test::assert_true
    "ne receiver and dispatch" 3 Probe::new 4 Probe::new != test::assert_true
    "lt receiver and dispatch" 5 Probe::new 6 Probe::new < test::assert_true
    "le receiver and dispatch" 7 Probe::new 8 Probe::new <= test::assert_true
    "gt receiver and dispatch" 9 Probe::new 10 Probe::new > test::assert_true
    "ge receiver and dispatch" 11 Probe::new 12 Probe::new >= test::assert_true
    1 Probe::new = first
    2 Probe::new = second
    "borrowed operands" first second == test::assert_true
    "named eq receiver" second first.eq test::assert_true
    "generic eq receiver" second first equal test::assert_true
    "operands remain alive" first.text second.text == test::assert_true
    "generic lt receiver" 6 Probe::new 5 Probe::new before test::assert_true
    "named function arguments" 7 3 10 subtract test::assert_eq
    "named ordering method" 2 1.lt test::assert_true
    "swap preserves callback context" 4 { 1 + } 3 swap apply_byte test::assert_eq
    { .value } 0 swap = read: fn[$Probe -> i64]
    drop
    "swap preserves receiver inference" 3 3 Probe::new read exec test::assert_eq
}

fn operand trace:mut$std::List[i64] value:i64 -> i64 { value trace.push value }

fn boolean_operand trace:mut$std::List[i64] value:i64 -> bool {
    value trace.push
    value 1 ==
}

fn test_evaluation {
    std::List[i64]::new = trace
    "source evaluation order" 1 trace operand 2 trace operand < test::assert_true
    "first operand evaluated first" 1 0 trace.get copy test::assert_eq
    "second operand evaluated second" 2 1 trace.get copy test::assert_eq
    "eager and" 0 trace boolean_operand 1 trace boolean_operand && test::assert_false
    "eager or" 1 trace boolean_operand 0 trace boolean_operand || test::assert_true
    "all boolean operands evaluated" 6 trace.length test::assert_eq
    "f-string expression" "true" f"{1 2 <}" test::assert_str_eq
    [1, 2, 3] std::List::from_array = ordered
    2 = limit
    "inferred borrowed predicate" 2 { limit swap < } ordered.bisect test::assert_eq
    "inferred input through swap" 2 { 3 swap < } exec test::assert_false
    "captured value constrains input through swap" 1 { limit swap > } exec test::assert_true
}
test_primitives
test_dispatch
test_evaluation
test::test_summary
