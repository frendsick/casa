pub fn make_test_stack_effect param_type:str return_type:str -> common::StackEffect {
    std::List[common::Parameter]::new = params
    param_type common::parse_type_str common::Parameter::new params.push
    std::List[common::Type]::new = returns
    return_type common::parse_type_str returns.push
    returns params common::StackEffect::new
}

pub fn test_type_base {
    "type_base" test::test_start
    "array[i64 3] has base" "array[i64 3]" common::parse_type_str.base.is_some test::assert_true
    "array[i64 3] base is array" "array" "array[i64 3]" common::parse_type_str.base.unwrap test::assert_str_eq
    "List[str] base is List" "List" "List[str]" common::parse_type_str.base.unwrap test::assert_str_eq
    "Map base" "Map" "Map[str i64]" common::parse_type_str.base.unwrap test::assert_str_eq
    "fn type has no base" "fn[i64 -> i64]" common::parse_type_str.base.is_none test::assert_true
    "i64 has no base" "i64" common::parse_type_str.base.is_none test::assert_true
}

pub fn test_type_params {
    "type_params" test::test_start
    "array[i64 3] element" "i64" 0 "array[i64 3]" common::parse_type_str
        .type_params
        .unwrap
        .get
        .format test::assert_str_eq
    "array[i64 3] length" "3" 1 "array[i64 3]" common::parse_type_str
        .type_params
        .unwrap
        .get
        .format test::assert_str_eq
    "List[str] inner" "str" 0 "List[str]" common::parse_type_str
        .type_params
        .unwrap
        .get
        .format test::assert_str_eq
}

pub fn test_split_type_tokens {
    "split_type_tokens" test::test_start
    "str i64" common::split_type_tokens = result
    "two tokens" 2 result.length test::assert_eq
    "first is str" "str" 0 result.get test::assert_str_eq
    "second is i64" "i64" 1 result.get test::assert_str_eq

    "str List[i64]" common::split_type_tokens = tokens_with_generic
    "two tokens with generic" 2 tokens_with_generic.length test::assert_eq
    "second preserves brackets" "List[i64]" 1 tokens_with_generic.get test::assert_str_eq

    "i64 -> i64" common::split_type_tokens = tokens_with_arrow
    "three tokens with arrow" 3 tokens_with_arrow.length test::assert_eq
    "arrow token" "->" 1 tokens_with_arrow.get test::assert_str_eq
}

pub fn test_type_is_fn {
    "type_is_fn" test::test_start
    "bare fn" "fn" common::parse_type_str.is_fn_type_t test::assert_true
    "parameterized fn" "fn[i64 -> i64]" common::parse_type_str.is_fn_type_t test::assert_true
    "i64 is not fn" "i64" common::parse_type_str.is_fn_type_t ! test::assert_true
}

pub fn test_function_type_stack_effect {
    "function_type_stack_effect" test::test_start
    if "fn[i64 -> i64]" common::parse_type_str common::Type::Function(fn_type) is then
        "param count" 1 fn_type common::FunctionType::parameters.length test::assert_eq
        "return count" 1 fn_type common::FunctionType::return_types.length test::assert_eq
        "param" "i64" 0 fn_type common::FunctionType::parameters.get.format test::assert_str_eq
        "return" "i64" 0 fn_type common::FunctionType::return_types.get.format test::assert_str_eq
    else
        "fn type parsed" false test::assert_true
    fi
    if "fn" common::parse_type_str common::Type::Function(bare_fn) is then
        "bare params" 0 bare_fn common::FunctionType::parameters.length test::assert_eq
        "bare returns" 0 bare_fn common::FunctionType::return_types.length test::assert_eq
    else
        "bare fn parsed" false test::assert_true
    fi
}

pub fn test_keyword_lookup {
    "keyword_lookup" test::test_start
    "fn is keyword" "fn" common::keyword_from_str.is_some test::assert_true
    "fn ordinal" common::KeywordKind::Fn "fn" common::keyword_from_str.unwrap == test::assert_true
    "extern ordinal" common::KeywordKind::Extern "extern" common::keyword_from_str.unwrap == test::assert_true
    "while ordinal" common::KeywordKind::While "while" common::keyword_from_str.unwrap == test::assert_true
    "hello not keyword" "hello" common::keyword_from_str.is_none test::assert_true
}

pub fn test_operator_lookup {
    "operator_lookup" test::test_start
    "plus" common::OperatorKind::Plus "+" common::operator_from_str.unwrap == test::assert_true
    "eq" common::OperatorKind::Eq "==" common::operator_from_str.unwrap == test::assert_true
    "assign" common::OperatorKind::Assign "=" common::operator_from_str.unwrap == test::assert_true
    "abc not operator" "abc" common::operator_from_str.is_none test::assert_true
}

pub fn test_intrinsic_lookup {
    "intrinsic_lookup" test::test_start
    "drop" common::IntrinsicKind::Drop "drop" common::intrinsic_from_str.unwrap == test::assert_true
    "dup" common::IntrinsicKind::Dup "dup" common::intrinsic_from_str.unwrap == test::assert_true
    "panic" common::IntrinsicKind::Panic "panic" common::intrinsic_from_str.unwrap == test::assert_true
    "syscall3" common::IntrinsicKind::Syscall3 "syscall3" common::intrinsic_from_str.unwrap == test::assert_true
    "xyz not intrinsic" "xyz" common::intrinsic_from_str.is_none test::assert_true
}

pub fn test_delimiter_lookup {
    "delimiter_lookup" test::test_start
    "arrow" common::DelimiterKind::Arrow "->" common::delimiter_from_str.unwrap == test::assert_true
    "fat arrow" common::DelimiterKind::FatArrow "=>" common::delimiter_from_str.unwrap == test::assert_true
    "colon" common::DelimiterKind::Colon ":" common::delimiter_from_str.unwrap == test::assert_true
    "dot char" common::DelimiterKind::Dot '.' common::delimiter_from_char.unwrap == test::assert_true
    "open brace char" common::DelimiterKind::OpenBrace '{' common::delimiter_from_char.unwrap == test::assert_true
    0 = code: u32
    while 256 code > do
        code char::from_codepoint.unwrap = character
        "delimiter classifier agrees" character common::delimiter_from_char.is_some
        character common::is_delimiter_char == test::assert_true
        1 += code
    done
    "Unicode is not a delimiter" '😀' common::is_delimiter_char ! test::assert_true
}

pub fn test_stack_effect_to_str {
    "stack_effect_to_str" test::test_start
    std::List[common::Parameter]::new = params
    common::make_i64_type common::Parameter::new params.push
    common::make_str_type common::Parameter::new params.push
    std::List[common::Type]::new = rets
    "bool" common::parse_type_str rets.push
    rets params common::StackEffect::new = sig
    "effect to str" "i64 str -> bool" sig common::stack_effect_to_str test::assert_str_eq
    "empty effect to str" "None -> None" common::empty_stack_effect common::stack_effect_to_str test::assert_str_eq
}

pub fn test_stack_effect_matches {
    "stack_effect_matches" test::test_start
    "bool" "i64" make_test_stack_effect = effect1
    "bool" "i64" make_test_stack_effect = effect2
    "same sigs match" effect2 effect1 common::stack_effect_matches test::assert_true

    "bool" "i64" make_test_stack_effect = effect3
    "bool" "str" make_test_stack_effect = effect4
    "different params don't match" effect4 effect3 common::stack_effect_matches ! test::assert_true

    "bool" common::TYPE_UNKNOWN make_test_stack_effect = effect5
    "bool" "i64" make_test_stack_effect = effect6
    "TYPE_UNKNOWN matches i64" effect6 effect5 common::stack_effect_matches test::assert_true
}

pub fn test_type_is_builtin {
    "type_is_builtin" test::test_start
    "i64 is builtin" "i64" common::parse_type_str.is_builtin_type_t test::assert_true
    "str is builtin" "str" common::parse_type_str.is_builtin_type_t test::assert_true
    "MyStruct not builtin" "MyStruct" common::parse_type_str.is_builtin_type_t ! test::assert_true
}

pub fn test_variable_list_helpers {
    "variable_list_helpers" test::test_start
    std::List[common::Variable]::new = vars
    "x" common::Variable::new vars.push
    "y" common::Variable::new vars.push
    "contains x" "x" vars common::variable_list_contains test::assert_true
    "not contains z" "z" vars common::variable_list_contains ! test::assert_true
    "index of y" 1 "y" vars common::variable_list_index test::assert_eq
    "index of missing" -1 "z" vars common::variable_list_index test::assert_eq
}

pub fn test_build_parameterized_type {
    "build_parameterized_type" test::test_start
    std::List[std::String]::new = params
    "T" params.push_str
    params "List" common::build_parameterized_type = simple_type
    "List[T]" common::parse_type_str = expected_simple
    "simple" expected_simple simple_type.eq test::assert_true

    std::List[std::String]::new = multi_params
    "K" multi_params.push_str
    "V" multi_params.push_str
    multi_params "Map" common::build_parameterized_type = multi_type
    "Map[K V]" common::parse_type_str = expected_multi
    "multi" expected_multi multi_type.eq test::assert_true
}

pub fn test_build_resolved_type {
    "build_resolved_type" test::test_start
    std::List[std::String]::new = type_vars
    "T" type_vars.push_str
    std::Map[std::String common::Type]::new = bindings
    common::make_i64_type.clone "T".to_str bindings.set
    bindings type_vars "Option" common::build_resolved_type = resolved_type
    "Option[i64]" common::parse_type_str = expected_resolved
    "resolved" expected_resolved resolved_type.eq test::assert_true

    # Unresolved type var stays as-is
    std::List[std::String]::new = type_vars2
    "K" type_vars2.push_str
    "V" type_vars2.push_str
    std::Map[std::String common::Type]::new = bindings2
    common::make_str_type.clone "K".to_str bindings2.set
    bindings2 type_vars2 "Map" common::build_resolved_type = partial_type
    "Map[str V]" common::parse_type_str = expected_partial
    "partial" expected_partial partial_type.eq test::assert_true
}

pub fn test_derived_clone_preserves_op_metadata {
    "derived_clone_preserves_op_metadata" test::test_start
    5 7 "source.casa".to_str common::Location::new = location
    std::List[common::Op]::new = nested_ops
    location "nested".to_str common::OpValue::PushStr common::Op::new nested_ops.push
    location nested_ops common::OpValue::ExprGroup common::Op::new = operation
    42 = operation.id
    common::make_i64_type.clone std::Option::Some = operation.type_hint
    common::make_str_type.clone std::Option::Some = operation.deferred_return_hint
    common::make_bool_type.clone "T".to_str operation.call_bindings.set

    operation.clone = cloned
    "operation ID" 42 cloned.id test::assert_eq
    "source file" "source.casa" cloned
        .location
        .file
        .as_str test::assert_str_eq
    "source offset" 7 cloned
        .location
        .span
        .offset test::assert_eq
    "source length" 5 cloned
        .location
        .span
        .length test::assert_eq
    if cloned.type_hint std::Option::Some(type_hint) is then
        "type hint" common::make_i64_type type_hint.eq test::assert_true
    else
        "type hint exists" false test::assert_true
    fi
    if cloned.deferred_return_hint std::Option::Some(deferred_hint) is then
        "deferred hint" common::make_str_type deferred_hint.eq test::assert_true
    else
        "deferred hint exists" false test::assert_true
    fi
    "call binding" common::make_bool_type "T" cloned
        .call_bindings
        .get_str
        .unwrap
        .eq test::assert_true
    if cloned.value common::OpValue::ExprGroup(items) is then
        "nested operation count" 1 items.length test::assert_eq
        if 0 items.get.value common::OpValue::PushStr(text) is then
            "nested operation value" "nested" text.as_str test::assert_str_eq
        else
            "nested operation kind" false test::assert_true
        fi
    else
        "operation kind" false test::assert_true
    fi
}

pub fn test_typecheck_store_clone_preserves_source_names {
    "typecheck_store_clone_preserves_source_names" test::test_start
    common::symbol_store_new = store
    std::Map[std::String common::SourceBinding]::new = names
    true "internal__".to_str common::SourceBinding "alias".to_str names.set
    "module.casa" names store.record_source_names
    store.clone_for_typecheck = cloned
    "fn[$internal__Box[internal__Item] -> mut$internal__Item]" common::parse_type_str = typ
    "module.casa" typ cloned.format_type_for_source = formatted
    "nested source names survive the typecheck clone"
    "fn[$alias::Box[alias::Item] -> mut$alias::Item]"
    formatted.as_str test::assert_str_eq
}

fn test_source_name_lookup_precedence_and_snapshot {
    "source_name_lookup_precedence_and_snapshot" test::test_start
    common::symbol_store_new = store
    std::Map[std::String common::SourceBinding]::new = first_names
    true "internal__".to_str common::SourceBinding "first".to_str first_names.set
    false "internal__Item".to_str common::SourceBinding "Renamed".to_str first_names.set
    "first.casa" first_names store.record_source_names
    std::Map[std::String common::SourceBinding]::new = second_names
    true "internal__".to_str common::SourceBinding "second".to_str second_names.set
    "second.casa" second_names store.record_source_names
    store.clone_for_typecheck = snapshot
    store drop
    0 = pass
    while pass 2 < do
        "exact binding precedes module prefix" "Renamed"
        "first.casa" "internal__Item" snapshot.format_name_for_source.as_str test::assert_str_eq
        "module suffix keeps its source alias" "first::Other"
        "first.casa" "internal__Other" snapshot.format_name_for_source.as_str test::assert_str_eq
        "another file uses its own alias" "second::Item"
        "second.casa" "internal__Item" snapshot.format_name_for_source.as_str test::assert_str_eq
        "default methods use source names" "Renamed"
        "first.casa" "default:internal__Item" snapshot.format_name_for_source.as_str test::assert_str_eq
        "unmapped files keep the name" "internal__Item"
        "unknown.casa" "internal__Item" snapshot.format_name_for_source.as_str test::assert_str_eq
        "unmapped names remain unchanged" "local"
        "first.casa" "local" snapshot.format_name_for_source.as_str test::assert_str_eq
        1 += pass
    done
    "second.casa" "internal__Item" snapshot.format_name_for_source = retained
    snapshot drop
    "formatted names outlive the snapshot" "second::Item" retained.as_str test::assert_str_eq
}

struct SharedProbe {
    drops: ptr
}

impl SharedProbe {
    fn drop self:mut$SharedProbe {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

fn test_shared_backing_lifetimes {
    "shared backing lifetimes" test::test_start
    unsafe { 8 alloc = drops 0 drops store64 }
    drops SharedProbe shared::Shared[SharedProbe]::new = first
    first.get = view
    first.clone = second
    second drop
    "view survives another handle" drops view.drops == test::assert_true
    "other handle does not destroy value" 0 unsafe { drops load64 } test::assert_eq
    view drop
    first drop
    "last handle destroys value once" 1 unsafe { drops load64 } test::assert_eq
    unsafe { drops free }
    4 2 "source.casa".to_str common::Location::new = location
    location.file = file_view
    location.clone = another_location
    another_location drop
    "filename view survives clone drop" "source.casa" file_view.as_str test::assert_str_eq
    9 7 location.with_span = shifted
    "original offset remains unchanged" 2 location.span.offset test::assert_eq
    "new offset is independent" 7 shifted.span.offset test::assert_eq
    "Map[str List[i64]]" common::parse_type_str = typ
    typ.type_params.unwrap = parameters
    typ.clone = another_type
    another_type drop
    "type parameter view survives clone drop" "List[i64]" 1 parameters
        .get
        .format
        .as_str test::assert_str_eq
}

fn test_layout_planner_queries {
    "layout planner queries" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "struct Inner { value:u16 flag:bool } struct Packet { tag:u8 inner:Inner samples:array[u16 3] tail:u64 } struct Generic[T] { tag:u8 inner:Inner value:T } enum Link { End More(Node) } struct Node { value:u8 next:Link } enum Choice { Empty Small(u8) Fields(u8 array[u16 3] u64) } struct Huge { first:u8 values:array[u64 2305843009213693952] last:u64 } enum TooLarge { Fields(u8 array[u64 2305843009213693952] u64) } enum Branch { Empty Children(array[Branch 2]) }"
    helpers::parse_resolve_test_source = source
    diagnostics "layout declarations parse" helpers::assert_no_errors
    source.store common::LayoutPlanner::new = layouts
    "Packet" source
        .store
        .structs
        .get_str
        .unwrap = packet
    "Generic" source
        .store
        .structs
        .get_str
        .unwrap = generic
    "Node" source
        .store
        .structs
        .get_str
        .unwrap = node
    "Choice" source
        .store
        .enums
        .get_str
        .unwrap = choice
    "Huge" source
        .store
        .structs
        .get_str
        .unwrap = huge
    "TooLarge" source
        .store
        .enums
        .get_str
        .unwrap = too_large
    0 = pass
    while pass 2 < do
        # Request the last field first, then revisit earlier offsets.
        "last struct field" 16 3 packet layouts
            .plan_struct_member
            .unwrap
            .offset test::assert_eq
        "inline nested struct" 1 packet layouts
            .plan_struct_member
            .unwrap
            .stores_inline test::assert_true
        "nested struct offset" 2 1 packet layouts
            .plan_struct_member
            .unwrap
            .offset test::assert_eq
        "array offset" 6 2 packet layouts
            .plan_struct_member
            .unwrap
            .offset test::assert_eq
        "array field size" 6 2 packet layouts
            .plan_struct_member
            .unwrap
            .size test::assert_eq
        "field alignment" 8 3 packet layouts
            .plan_struct_member
            .unwrap
            .alignment test::assert_eq
        "first struct field" 0 0 packet layouts
            .plan_struct_member
            .unwrap
            .offset test::assert_eq
        "missing struct field" 4 packet layouts.plan_struct_member.is_none test::assert_true
        "struct size" 24 "Packet" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "array length two" 48 "array[Packet 2]" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "array length three" 72 "array[Packet 3]" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "empty array" 1 "array[Packet 0]" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "borrow size" 8 "$Packet" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "generic field stays indirect" 1 generic layouts
            .plan_struct_member
            .unwrap
            .stores_inline ! test::assert_true
        "generic value offset" 16 2 generic layouts
            .plan_struct_member
            .unwrap
            .offset test::assert_eq
        "first generic specialization" 24 "Generic[u8]" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "second generic specialization" 24 "Generic[Packet]" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "recursive struct size" 16 "Node" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "recursive enum size" 16 "Link" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "recursive array at its own root" 48 "array[Branch 2]" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "nested recursion does not cache a cut point" 24 "Branch" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "recursive field offset" 8 1 node layouts
            .plan_struct_member
            .unwrap
            .offset test::assert_eq
        "recursive field stays indirect" 1 node layouts
            .plan_struct_member
            .unwrap
            .stores_inline ! test::assert_true
        "last enum payload" 16 2 "Fields" choice layouts
            .plan_enum_payload
            .unwrap
            .offset test::assert_eq
        "enum array offset" 10 1 "Fields" choice layouts
            .plan_enum_payload
            .unwrap
            .offset test::assert_eq
        "enum array stays inline" 1 "Fields" choice layouts
            .plan_enum_payload
            .unwrap
            .stores_inline test::assert_true
        "enum first payload" 8 0 "Fields" choice layouts
            .plan_enum_payload
            .unwrap
            .offset test::assert_eq
        "another variant" 8 0 "Small" choice layouts
            .plan_enum_payload
            .unwrap
            .offset test::assert_eq
        "empty variant" 0 "Empty" choice layouts.plan_enum_payload.is_none test::assert_true
        "unknown variant" 0 "Missing" choice layouts.plan_enum_payload.is_none test::assert_true
        "missing payload" 3 "Fields" choice layouts.plan_enum_payload.is_none test::assert_true
        "enum size" 24 "Choice" common::parse_type_str layouts.inline_size.unwrap test::assert_eq
        "overflowed struct size" "Huge" common::parse_type_str layouts.inline_size.is_none test::assert_true
        "overflowed struct field" 1 huge layouts.plan_struct_member.is_none test::assert_true
        "field after overflow" 2 huge layouts.plan_struct_member.is_none test::assert_true
        "valid struct prefix" 0 0 huge layouts
            .plan_struct_member
            .unwrap
            .offset test::assert_eq
        "overflowed enum size" "TooLarge" common::parse_type_str layouts.inline_size.is_none test::assert_true
        "overflowed enum field" 1 "Fields" too_large layouts.plan_enum_payload.is_none test::assert_true
        "payload after overflow" 2 "Fields" too_large layouts.plan_enum_payload.is_none test::assert_true
        "valid enum prefix" 8 0 "Fields" too_large layouts
            .plan_enum_payload
            .unwrap
            .offset test::assert_eq
        1 += pass
    done
}

fn test_layout_planner_request_isolation {
    "layout planner request isolation" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "struct Item { value:u8 tail:u8 }" helpers::parse_resolve_test_source = narrow
    diagnostics "struct Item { value:u64 tail:u64 }" helpers::parse_resolve_test_source = wide
    diagnostics "independent declarations parse" helpers::assert_no_errors
    narrow.store common::LayoutPlanner::new = narrow_layouts
    wide.store common::LayoutPlanner::new = wide_layouts
    "Item" common::parse_type_str = typ
    "Item" narrow
        .store
        .structs
        .get_str
        .unwrap = narrow_item
    "Item" wide
        .store
        .structs
        .get_str
        .unwrap = wide_item
    0 = pass
    while pass 2 < do
        "narrow request size" 2 typ narrow_layouts.inline_size.unwrap test::assert_eq
        "wide request size" 16 typ wide_layouts.inline_size.unwrap test::assert_eq
        "narrow request offset" 1 1 narrow_item narrow_layouts
            .plan_struct_member
            .unwrap
            .offset test::assert_eq
        "wide request offset" 8 1 wide_item wide_layouts
            .plan_struct_member
            .unwrap
            .offset test::assert_eq
        1 += pass
    done
}
