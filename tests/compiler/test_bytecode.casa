pub fn test_compile_if_block {
    "compile_if_block" test::test_start
    "if true then fi" compile_bytecode_source = program
    std::List[common::InstValue]::new = control_flow
    control_flow program.bytecode append_control_flow_instructions
    "control-flow instruction count" 3 control_flow.length test::assert_eq
    "control-flow instruction 0" 0 control_flow.get common::InstValue::Label is test::assert_true
    "control-flow instruction 1" 1 control_flow.get common::InstValue::JumpNe is test::assert_true
    "control-flow instruction 2" 2 control_flow.get common::InstValue::Label is test::assert_true
}

pub fn test_compile_while_block {
    "compile_while_block" test::test_start
    "while false do done" compile_bytecode_source = program
    std::List[common::InstValue]::new = control_flow
    control_flow program.bytecode append_control_flow_instructions
    "control-flow instruction count" 5 control_flow.length test::assert_eq
    "control-flow instruction 0" 0 control_flow.get common::InstValue::Label is test::assert_true
    "control-flow instruction 1" 1 control_flow.get common::InstValue::Label is test::assert_true
    "control-flow instruction 2" 2 control_flow.get common::InstValue::JumpNe is test::assert_true
    "control-flow instruction 3" 3 control_flow.get common::InstValue::Jump is test::assert_true
    "control-flow instruction 4" 4 control_flow.get common::InstValue::Label is test::assert_true
}

pub fn test_deep_control_flow_targets {
    "deep_control_flow_targets" test::test_start
    128 = depth: u64
    std::String::new = source
    0 = index: u64
    while index depth > do
        "if true then " source.append 1 += index
    done
    0 = index: u64
    while index depth > do
        "fi " source.append 1 += index
    done
    source.as_str compile_bytecode_source = program
    std::List[common::InstValue]::new = control_flow
    control_flow program.bytecode append_control_flow_instructions
    "each nested if emits one jump and label" depth 2 * 1 + control_flow.length test::assert_eq
    0 = index: u64
    while index depth > do
        depth 2 * index - index 1 + control_flow assert_jump_ne_targets_label
        1 += index
    done
}

pub fn test_mixed_control_flow_targets {
    "mixed_control_flow_targets" test::test_start
    "enum Choice { A B } fn mixed choice:Choice flag:bool { while flag do if flag then continue else break fi done choice match Choice::A if flag => { } Choice::A => { } Choice::B => { } end } true Choice::A mixed"
    typecheck_bytecode_source = result
    "mixed control flow typechecks" result.get_diagnostics.has_errors ! test::assert_true
    result bytecode::compile_typechecked = compiled
    "mixed control flow compiles" compiled.is_ok test::assert_true
    compiled.unwrap = program
    "mixed" program
        .functions
        .get_str
        .unwrap = instructions
    std::List[common::InstValue]::new = control_flow
    control_flow instructions append_control_flow_instructions
    "mixed control-flow instruction count" 19 control_flow.length test::assert_eq

    0 control_flow label_at drop
    1 control_flow label_at = loop_start
    6 control_flow label_at = if_else
    8 control_flow label_at = if_end
    10 control_flow label_at = loop_end
    14 control_flow label_at = second_arm
    17 control_flow label_at = third_arm
    18 control_flow label_at = match_end

    "while condition reaches loop end" loop_end 2 control_flow assert_jump_ne_at
    "if condition reaches else" if_else 3 control_flow assert_jump_ne_at
    "continue reaches loop start" loop_start 4 control_flow assert_jump_at
    "then branch reaches if end" if_end 5 control_flow assert_jump_at
    "break reaches loop end" loop_end 7 control_flow assert_jump_at
    "while end reaches loop start" loop_start 9 control_flow assert_jump_at
    "first match pattern reaches second arm" second_arm 11 control_flow assert_jump_ne_at
    "guarded match arm reaches second arm" second_arm 12 control_flow assert_jump_ne_at
    "first match arm reaches match end" match_end 13 control_flow assert_jump_at
    "second match pattern reaches third arm" third_arm 15 control_flow assert_jump_ne_at
    "second match arm reaches match end" match_end 16 control_flow assert_jump_at
}

