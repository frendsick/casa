pub fn test_compile_fn_push {
    "compile_fn_push" test::test_start

    # Register a function in the local store.
    common::symbol_store_new = store
    std::List[common::Op]::new = fn_ops
    1 common::make_integer_op_value test_make_op fn_ops.push
    make_test_location fn_ops "adder".to_str common::Function::new = func
    func store.set_function

    std::List[common::Op]::new = ops
    "adder".to_str common::OpValue::FnPush test_make_op ops.push

    store bytecode::BytecodeState::new = state
    ops state bytecode::BytecodeCompiler::new = compiler
    std::List[common::InstValue]::new = bytecode
    bytecode compiler.compile_ops

    # FnPush should emit FN_PUSH instruction with function name
    # Find FN_PUSH instruction in bytecode
    "fn_push has instrs" 0 bytecode.length != test::assert_true
}

