pub fn test_intern_string {
    "intern_string" test::test_start
    std::List[common::Op]::new = ops
    "hello".to_str common::OpValue::PushStr test_make_op ops.push
    "hello".to_str common::OpValue::PushStr test_make_op ops.push
    "world".to_str common::OpValue::PushStr test_make_op ops.push
    "".to_str common::OpValue::PushStr test_make_op ops.push
    "hyvä".to_str common::OpValue::PushStr test_make_op ops.push
    "world".to_str common::OpValue::PushStr test_make_op ops.push

    ops TEST_STORE compile_test_program.unwrap = program

    "table has four entries" 4 program.strings.length test::assert_eq
    "first table entry" "hello" 0 program.strings.get test::assert_str_eq
    "second table entry" "world" 1 program.strings.get test::assert_str_eq
    "empty table entry" "" 2 program.strings.get test::assert_str_eq
    "non-ASCII table entry" "hyvä" 3 program.strings.get test::assert_str_eq
    if 1 program.bytecode.get common::InstValue::PushStr(first) is then
        "first string index" 0 first test::assert_eq
    else
        "first string instruction" false test::assert_true
    fi
    if 2 program.bytecode.get common::InstValue::PushStr(second) is then
        "repeated string index" 0 second test::assert_eq
    else
        "repeated string instruction" false test::assert_true
    fi
    if 6 program.bytecode.get common::InstValue::PushStr(last) is then
        "repeated second string index" 1 last test::assert_eq
    else
        "last string instruction" false test::assert_true
    fi
}

pub fn test_fixed_array_local_slots {
    "fixed_array_local_slots" test::test_start
    "fn checked { [1, 2, 3, 4, 5, 6, 7, 8, 9] = numbers:array[u8 9] numbers drop } checked"
    typecheck_bytecode_source = checked_result
    checked_result bytecode::compile_typechecked.unwrap = program
    "checked" program
        .functions
        .get_str
        .unwrap = instructions
    "function initializes locals" 0 instructions.get common::InstValue::LocalsInit is test::assert_true
    false = found_address
    for instruction in instructions.iter do
        if instruction common::InstValue::LocalAddress(slot) is then
            if 1 slot == then
                true = found_address
            fi
        fi
    done
    "array address uses the last reserved word" found_address test::assert_true
}

pub fn test_fixed_array_copy_uses_local_storage {
    "fixed_array_copy_uses_local_storage" test::test_start
    std::List[common::Op]::new = ops
    "array[i64 2]" common::parse_type_str common::OpValue::Dup test_make_op_with_type_hint
    ops.push
    ops TEST_STORE compile_test_program.unwrap = program
    false = has_allocation
    false = has_copy
    for instruction in program.bytecode.iter do
        if instruction common::InstValue::HeapAlloc is then
            true = has_allocation
        elif instruction common::InstValue::MoveBytes(copy_size) is then
            if 16 copy_size == then
                true = has_copy
            fi
        fi
    done
    "copies inline bytes" has_copy test::assert_true
    "copy does not allocate" has_allocation test::assert_false
}

pub fn test_compile_push_int {
    "compile_push_int" test::test_start

    std::List[common::Op]::new = ops
    42 common::make_integer_op_value test_make_op ops.push

    ops TEST_STORE compile_test_program.unwrap = program

    # Should have: LABEL, PUSH(42)
    "push_int bytecode length" 2 program.bytecode.length test::assert_eq
    "push_int label kind" 0 program.bytecode.get common::InstValue::Label is test::assert_true
    if 1 program.bytecode.get common::InstValue::Push(value) is then
        "push_int value" 42 value test::assert_eq
    else
        "push_int inst kind" false test::assert_true
    fi
}

pub fn typecheck_bytecode_source code:$str -> typechecker::TypecheckResult {
    "test" code.clone lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    lexer::SourceStore::new lex_diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve = result
    result.into_parts = parse_diagnostics = store = ops
    parse_diagnostics drop
    store ops.unwrap typechecker::type_check
}

pub fn does_instruction_match
    actual:$common::InstValue
    expected_instruction:$common::InstValue
-> bool {
    expected_instruction match
        common::InstValue::Drop => actual common::InstValue::Drop is
        common::InstValue::Push(expected) => {
            if actual common::InstValue::Push(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::FnCall(expected) => {
            if actual common::InstValue::FnCall(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::FnReturn => actual common::InstValue::FnReturn is
        common::InstValue::Label(expected) => {
            if actual common::InstValue::Label(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::LocalsInit(expected) => {
            if actual common::InstValue::LocalsInit(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::LocalsUninit(expected) => {
            if actual common::InstValue::LocalsUninit(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::LocalGet(expected) => {
            if actual common::InstValue::LocalGet(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::LocalSet(expected) => {
            if actual common::InstValue::LocalSet(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::GlobalsInit(expected) => {
            if actual common::InstValue::GlobalsInit(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::GlobalGet(expected) => {
            if actual common::InstValue::GlobalGet(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::GlobalSet(expected) => {
            if actual common::InstValue::GlobalSet(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::ConstantLoad(expected) => {
            if actual common::InstValue::ConstantLoad(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::ConstantStore(expected) => {
            if actual common::InstValue::ConstantStore(value) is then
                expected value ==
            else
                false
            fi
        }
        _ => false
    end
}

pub fn does_bytecode_match
    first:$std::List[common::InstValue]
    second:$std::List[common::InstValue]
-> bool {
    if first.length second.length != then
        false return
    fi
    0 = index: u64
    while index first.length > do
        if index second.get index first.get does_instruction_match ! then
            false return
        fi
        1 += index
    done
    true
}

pub fn test_bytecode_comparison_checks_payloads {
    "bytecode_comparison_checks_payloads" test::test_start
    std::List[common::InstValue]::new = first
    std::List[common::InstValue]::new = second
    1 common::InstValue::Push first.push
    2 common::InstValue::Push second.push
    "different instruction payloads differ" second first does_bytecode_match test::assert_false
}

fn append_control_flow_instructions
    source:$std::List[common::InstValue]
    target:mut$std::List[common::InstValue]
{
    for instruction in source.iter do
        instruction match
            common::InstValue::Label(label) => label common::InstValue::Label target.push
            common::InstValue::Jump(label) => label common::InstValue::Jump target.push
            common::InstValue::JumpNe(label) => label common::InstValue::JumpNe target.push
            _ => {
            }
        end
    done
}

fn label_at instructions:$std::List[common::InstValue] index:u64 -> u64 {
    if index instructions.get common::InstValue::Label(label) is then
        label return
    fi
    "expected label instruction" false test::assert_true
    0
}

fn assert_jump_at instructions:$std::List[common::InstValue] index:u64 target:u64 message:$str {
    if index instructions.get common::InstValue::Jump(actual) is then
        message target actual test::assert_eq return
    fi
    message false test::assert_true
}

fn assert_jump_ne_at instructions:$std::List[common::InstValue] index:u64 target:u64 message:$str {
    if index instructions.get common::InstValue::JumpNe(actual) is then
        message target actual test::assert_eq return
    fi
    message false test::assert_true
}

fn assert_jump_ne_targets_label
    instructions:$std::List[common::InstValue]
    jump_index:u64
    label_index:u64
{
    label_index instructions label_at = label
    if jump_index instructions.get common::InstValue::JumpNe(target) is then
        "deep if jump reaches its matching end" label target test::assert_eq return
    fi
    "deep if emits a conditional jump" false test::assert_true
}

pub fn test_invalid_program_stops_before_bytecode {
    "invalid_program_stops_before_bytecode" test::test_start
    "\"bad\" 1 *" typecheck_bytecode_source = result
    "type error returned upstream" result.diagnostics.has_errors test::assert_true
    result bytecode::compile_typechecked = compile_result
    "no program returned" compile_result.is_error test::assert_true
    "bytecode not entered" compile_result
        .unwrap_error
        .message
        .as_str "requires error-free" str::find 0 <= test::assert_true
}

pub fn test_compile_invariant_failure_is_not_diagnostic {
    "compile_invariant_failure_is_not_diagnostic" test::test_start
    std::List[common::Op]::new = ops
    "missing".to_str common::OpValue::PushVar test_make_op ops.push

    ops TEST_STORE compile_test_program = result

    "invariant failure returned" result.is_error test::assert_true
    "missing variable named" result
        .unwrap_error
        .message
        .as_str "missing" str::find 0 <= test::assert_true
}

pub fn test_compile_typechecked_is_repeatable {
    "compile_typechecked_is_repeatable" test::test_start
    "const LIMIT 2\n1 = global_value\nfn used { LIMIT = local_value local_value drop }\nused"
    typecheck_bytecode_source = result
    result.ops.length = input_ops_length
    result
        .diagnostics
        .entries
        .length = diagnostic_count
    result.store.count_functions = function_count
    result
        .store
        .variables
        .length = variable_count
    result
        .store
        .constants
        .length = constant_count
    "used" result
        .store
        .get_function
        .unwrap = input_function
    input_function.ops.length = function_ops_length
    input_function.variables.length = local_count
    input_function.is_typechecked = was_typechecked

    result bytecode::compile_typechecked.unwrap = first_program
    result bytecode::compile_typechecked.unwrap = second_program

    second_program.bytecode first_program.bytecode does_bytecode_match = global_bytecode_matches
    "global bytecode is stable" global_bytecode_matches test::assert_true
    "used" first_program
        .functions
        .get_str
        .unwrap = first_function
    "used" second_program
        .functions
        .get_str
        .unwrap = second_function
    "function bytecode is stable" second_function first_function does_bytecode_match test::assert_true
    "input operations preserved" input_ops_length result.ops.length test::assert_eq
    "input diagnostics preserved" diagnostic_count result
        .diagnostics
        .entries
        .length test::assert_eq
    "input functions preserved" function_count result.store.count_functions test::assert_eq
    "input variables preserved" variable_count result
        .store
        .variables
        .length test::assert_eq
    "input constants preserved" constant_count result
        .store
        .constants
        .length test::assert_eq
    "used" result
        .store
        .get_function
        .unwrap = output_function
    "function operations preserved" function_ops_length output_function.ops.length test::assert_eq
    "function locals preserved" local_count output_function.variables.length test::assert_eq
    "function typecheck preserved" was_typechecked output_function.is_typechecked == test::assert_true
}

pub fn test_compile_functions_once_per_pass {
    "compile_functions_once_per_pass" test::test_start
    common::symbol_store_new = store

    std::List[common::Op]::new = first_ops
    "second".to_str common::OpValue::FnCall test_make_op first_ops.push
    make_test_location first_ops "first".to_str common::Function::new = first
    first store.set_function

    std::List[common::Op]::new = second_ops
    "first".to_str common::OpValue::FnCall test_make_op second_ops.push
    make_test_location second_ops "second".to_str common::Function::new = second
    second store.set_function

    std::List[common::Op]::new = recursive_ops
    "recursive".to_str common::OpValue::FnCall test_make_op recursive_ops.push
    make_test_location recursive_ops "recursive".to_str common::Function::new = recursive
    recursive store.set_function

    std::List[common::Op]::new = unused_ops
    42 common::make_integer_op_value test_make_op unused_ops.push
    make_test_location unused_ops "unused".to_str common::Function::new = unused
    unused store.set_function

    std::List[common::Op]::new = ops
    "first".to_str common::OpValue::FnCall test_make_op ops.push
    "recursive".to_str common::OpValue::FnCall test_make_op ops.push
    ops store compile_test_program.unwrap = program

    "called functions emitted once" 3 program.functions.length test::assert_eq
    "first function emitted" "first" program.functions.has_str test::assert_true
    "second function emitted" "second" program.functions.has_str test::assert_true
    "recursive function emitted" "recursive" program.functions.has_str test::assert_true
    "unused function omitted" "unused" program.functions.has_str test::assert_false
    "front-end functions preserved" 4 store.count_functions test::assert_eq
    "first operations preserved" 1 "first" store
        .get_function
        .unwrap
        .ops
        .length test::assert_eq
    "second operations preserved" 1 "second" store
        .get_function
        .unwrap
        .ops
        .length test::assert_eq
    "recursive operations preserved" 1 "recursive" store
        .get_function
        .unwrap
        .ops
        .length test::assert_eq
}

