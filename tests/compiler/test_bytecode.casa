pub fn test_compile_push_array {
    "compile_push_array" test::test_start

    # Create array items: [1, 2, 3]
    std::List[common::Op]::new = items
    1 common::make_integer_op_value test_make_op items.push
    2 common::make_integer_op_value test_make_op items.push
    3 common::make_integer_op_value test_make_op items.push

    # Create a PushArray op with the items list as value
    std::List[common::Op]::new = ops
    make_test_location items common::OpValue::PushArray common::Op::new ops.push

    TEST_STORE bytecode::BytecodeState::new = state
    ops state bytecode::BytecodeCompiler::new = compiler
    std::List[common::InstValue]::new = bytecode
    bytecode compiler.compile_ops

    0 = has_static_array
    0 = has_alloc
    0 (u64) = i
    while i bytecode.length > do
        i bytecode.get = inst_value
        if inst_value common::InstValue::PushStaticArray is then
            1 = has_static_array
        elif inst_value common::InstValue::HeapAlloc is then
            1 = has_alloc
        fi
        1 += i
    done
    "literal array emits PushStaticArray" 1 has_static_array test::assert_eq
    "literal array has no HeapAlloc" 0 has_alloc test::assert_eq
}

pub fn test_compile_if_elif_else {
    "compile_if_elif_else" test::test_start

    std::List[common::Op]::new = ops
    # if ... then ... elif ... then ... else ... fi
    common::OpValue::IfStart test_make_op ops.push
    common::OpValue::IfCondition test_make_op ops.push
    common::OpValue::IfElif test_make_op ops.push
    common::OpValue::IfCondition test_make_op ops.push
    common::OpValue::IfElse test_make_op ops.push
    common::OpValue::IfEnd test_make_op ops.push

    TEST_STORE bytecode::BytecodeState::new = state
    ops state bytecode::BytecodeCompiler::new = compiler
    std::List[common::InstValue]::new = bytecode
    bytecode compiler.compile_ops

    # Expected bytecode layout:
    # 0: LABEL (fn)
    # 1: JUMP_NE (if condition -> jump to elif label)
    # 2: JUMP (jump to fi from then-block)
    # 3: LABEL (elif label)
    # 4: JUMP_NE (elif condition -> jump to else label)
    # 5: JUMP (jump to fi from elif-block)
    # 6: LABEL (else label)
    # 7: LABEL (fi label)
    "elif bytecode length" 8 bytecode.length test::assert_eq
    "elif fn label" 0 bytecode.get common::InstValue::Label is test::assert_true
    "elif if jump_ne" 1 bytecode.get common::InstValue::JumpNe is test::assert_true
    "elif jump to fi" 2 bytecode.get common::InstValue::Jump is test::assert_true
    "elif label" 3 bytecode.get common::InstValue::Label is test::assert_true
    "elif cond jump_ne" 4 bytecode.get common::InstValue::JumpNe is test::assert_true
    "else jump to fi" 5 bytecode.get common::InstValue::Jump is test::assert_true
    "else label" 6 bytecode.get common::InstValue::Label is test::assert_true
    "fi label" 7 bytecode.get common::InstValue::Label is test::assert_true
}

