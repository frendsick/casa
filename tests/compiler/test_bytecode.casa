pub fn test_compile_push_array {
    "compile_push_array" test::test_start
    "[1, 2, 3] drop" compile_bytecode_source = program
    "static array is stored in program" 1 program.static_arrays.length test::assert_eq
    for instruction in program.bytecode.iter do
        "literal array has no heap allocation" instruction common::InstValue::HeapAlloc is test::assert_false
    done
}

pub fn test_compile_if_elif_else {
    "compile_if_elif_else" test::test_start
    "if true then elif false then else fi" compile_bytecode_source = program
    std::List[common::InstValue]::new = control_flow
    control_flow program.bytecode append_control_flow_instructions
    "control-flow instruction count" 8 control_flow.length test::assert_eq
    "control-flow instruction 0" 0 control_flow.get common::InstValue::Label is test::assert_true
    "control-flow instruction 1" 1 control_flow.get common::InstValue::JumpNe is test::assert_true
    "control-flow instruction 2" 2 control_flow.get common::InstValue::Jump is test::assert_true
    "control-flow instruction 3" 3 control_flow.get common::InstValue::Label is test::assert_true
    "control-flow instruction 4" 4 control_flow.get common::InstValue::JumpNe is test::assert_true
    "control-flow instruction 5" 5 control_flow.get common::InstValue::Jump is test::assert_true
    "control-flow instruction 6" 6 control_flow.get common::InstValue::Label is test::assert_true
    "control-flow instruction 7" 7 control_flow.get common::InstValue::Label is test::assert_true
}

pub fn test_compile_fn_call {
    "compile_fn_call" test::test_start
    "fn greet { } greet" compile_bytecode_source = program
    "named call" "greet".to_str common::InstValue::FnCall program.bytecode assert_instruction_present
}

pub fn test_compile_fn_push {
    "compile_fn_push" test::test_start
    "fn adder -> i64 { 1 } &adder exec drop" compile_bytecode_source = program
    "referenced function emitted" "adder" program.functions.has_str test::assert_true
}

