# ============================================================================
# Test helpers
# ============================================================================

pub fn make_test_location -> common::Location {
    # Location::new file:String offset:i64 length:i64
    # param1=file, param2=offset, param3=length -> length offset file Location::new
    1 0 "test.casa".to_str common::Location::new
}
# Helper to create an op with the unified OpValue payload.

pub fn test_make_op value:common::OpValue -> common::Op { make_test_location value common::Op::new }

pub fn test_make_op_with_type_hint value:common::OpValue type_hint:common::Type -> common::Op {
    make_test_location value common::Op::new = op
    type_hint std::Option::Some = op.type_hint
    op
}

