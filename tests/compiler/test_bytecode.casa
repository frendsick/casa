pub fn test_compile_string_ne {
    "compile_string_ne" test::test_start

    std::List[common::Op]::new = ops
    common::make_str_type common::clone_type common::OpValue::Ne test_make_op_with_type_hint ops.push

    TEST_STORE bytecode::BytecodeState::new = state
    ops state bytecode::BytecodeCompiler::new = compiler
    std::List[common::InstValue]::new = bytecode
