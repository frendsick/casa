pub fn test_compile_if_block {
    "compile_if_block" test::test_start

    std::List[common::Op]::new = ops
    common::OpValue::IfStart test_make_op ops.push
    common::OpValue::IfCondition test_make_op ops.push
    common::OpValue::IfEnd test_make_op ops.push

    "ops has 3 elements" 3 ops.length test::assert_eq
    "op 0 is if_start" 0 ops.get.value common::OpValue::IfStart is test::assert_true
    "op 2 is if_end" 2 ops.get.value common::OpValue::IfEnd is test::assert_true

    ops TEST_STORE compile_test_program.unwrap = program
    program.bytecode = bytecode: $std::List[common::InstValue]

    # Expected: LABEL, JUMP_NE(end_label), LABEL(end_label)
    "if block bytecode length" 3 bytecode.length test::assert_eq
    "if block has label" 0 bytecode.get common::InstValue::Label is test::assert_true
    "if condition jump_ne" 1 bytecode.get common::InstValue::JumpNe is test::assert_true
    "if end label" 2 bytecode.get common::InstValue::Label is test::assert_true
}

pub fn test_compile_while_block {
    "compile_while_block" test::test_start

    std::List[common::Op]::new = ops
    common::OpValue::WhileStart test_make_op ops.push
    common::OpValue::WhileCondition test_make_op ops.push
    common::OpValue::WhileEnd test_make_op ops.push

    ops TEST_STORE compile_test_program.unwrap = program
    program.bytecode = bytecode: $std::List[common::InstValue]

    # Expected: LABEL(fn), LABEL(start), JUMP_NE(end), JUMP(start), LABEL(end)
    "while block bytecode length" 5 bytecode.length test::assert_eq
    "while fn label" 0 bytecode.get common::InstValue::Label is test::assert_true
    "while start label" 1 bytecode.get common::InstValue::Label is test::assert_true
    "while condition jump_ne" 2 bytecode.get common::InstValue::JumpNe is test::assert_true
    "while end jump" 3 bytecode.get common::InstValue::Jump is test::assert_true
    "while end label" 4 bytecode.get common::InstValue::Label is test::assert_true
}

pub fn test_deep_control_flow_targets {
    "deep_control_flow_targets" test::test_start
    128 = depth: u64
    std::List[common::Op]::new = ops
    0 = index: u64
    while index depth > do
        common::OpValue::IfStart test_make_op ops.push
        common::OpValue::IfCondition test_make_op ops.push
        1 += index
    done
    0 = index: u64
    while index depth > do
        common::OpValue::IfEnd test_make_op ops.push
        1 += index
    done

    ops TEST_STORE compile_test_program = result
    "deep nesting compiles" result.is_ok test::assert_true
    result.unwrap = program
    "each nested if emits one jump and label" depth 2 * 1 + program.bytecode.length test::assert_eq
    0 = index: u64
    while index depth > do
        depth 2 * index - index 1 + program.bytecode assert_jump_ne_targets_label
        1 += index
    done
}

pub fn test_mixed_control_flow_targets {
    "mixed_control_flow_targets" test::test_start
    "enum Choice { A B } fn mixed choice:Choice flag:bool { while flag do if flag then continue else break fi done choice match Choice::A if flag => { } Choice::A => { } Choice::B => { } end } true Choice::A mixed"
    typecheck_bytecode_source = result
    "mixed control flow typechecks" result.diagnostics.has_errors ! test::assert_true
    result bytecode::compile_typechecked = compiled
    "mixed control flow compiles" compiled.is_ok test::assert_true
    compiled.unwrap = program
    "mixed" program
        .functions
        .get_str
        .unwrap = instructions
    std::List[common::InstValue]::new = control_flow
    control_flow instructions append_control_flow_instructions
    "mixed control-flow instruction count" 19 control_flow.length test::assert_eq

    0 control_flow label_at drop
    1 control_flow label_at = loop_start
    6 control_flow label_at = if_else
    8 control_flow label_at = if_end
    10 control_flow label_at = loop_end
    14 control_flow label_at = second_arm
    17 control_flow label_at = third_arm
    18 control_flow label_at = match_end

    "while condition reaches loop end" loop_end 2 control_flow assert_jump_ne_at
    "if condition reaches else" if_else 3 control_flow assert_jump_ne_at
    "continue reaches loop start" loop_start 4 control_flow assert_jump_at
    "then branch reaches if end" if_end 5 control_flow assert_jump_at
    "break reaches loop end" loop_end 7 control_flow assert_jump_at
    "while end reaches loop start" loop_start 9 control_flow assert_jump_at
    "first match pattern reaches second arm" second_arm 11 control_flow assert_jump_ne_at
    "guarded match arm reaches second arm" second_arm 12 control_flow assert_jump_ne_at
    "first match arm reaches match end" match_end 13 control_flow assert_jump_at
    "second match pattern reaches third arm" third_arm 15 control_flow assert_jump_ne_at
    "second match arm reaches match end" match_end 16 control_flow assert_jump_at

    std::List[common::Op]::new = invalid_ops
    common::OpValue::IfCondition test_make_op invalid_ops.push
    invalid_ops TEST_STORE compile_test_program = invalid
    "unmatched control flow fails" invalid.is_error test::assert_true
    "unmatched control flow keeps its diagnostic" invalid
        .unwrap_error
        .message
        .as_str "`then` without matching `if`" == test::assert_true

    std::List[common::Op]::new = crossed_ops
    common::OpValue::IfStart test_make_op crossed_ops.push
    common::OpValue::WhileStart test_make_op crossed_ops.push
    common::OpValue::IfEnd test_make_op crossed_ops.push
    common::OpValue::WhileEnd test_make_op crossed_ops.push
    crossed_ops TEST_STORE compile_test_program = crossed
    "crossed control flow fails" crossed.is_error test::assert_true
    "crossed control flow keeps its diagnostic" crossed
        .unwrap_error
        .message
        .as_str "`if` without matching `fi`" == test::assert_true

    std::List[common::Op]::new = nested_invalid_ops
    common::OpValue::IfStart test_make_op nested_invalid_ops.push
    common::OpValue::WhileStart test_make_op nested_invalid_ops.push
    common::OpValue::WhileCondition test_make_op nested_invalid_ops.push
    nested_invalid_ops TEST_STORE compile_test_program = nested_invalid
    "innermost unmatched control flow fails" nested_invalid.is_error test::assert_true
    "innermost unmatched control flow keeps its diagnostic" nested_invalid
        .unwrap_error
        .message
        .as_str "`do` without matching `done`" == test::assert_true
}

