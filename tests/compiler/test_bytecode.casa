pub fn test_op_to_label_identity {
    "op_to_label_identity" test::test_start
    std::List[common::Op]::new = ops
    TEST_STORE bytecode::BytecodeState::new = state
    ops state bytecode::BytecodeCompiler::new = compiler
    common::OpValue::Add test_make_op = op_a
    common::OpValue::Add test_make_op = op_b
    1 = op_a.id
    2 = op_b.id
    op_a compiler.op_to_label = label_a_first
    op_a compiler.op_to_label = label_a_second
    op_b compiler.op_to_label = label_b
    "same op same label" label_a_first label_a_second test::assert_eq
    "different op different label" label_a_first label_b != test::assert_true
}

pub fn test_compile_if_block {
    "compile_if_block" test::test_start

    std::List[common::Op]::new = ops
    common::OpValue::IfStart test_make_op ops.push
    common::OpValue::IfCondition test_make_op ops.push
    common::OpValue::IfEnd test_make_op ops.push

    "ops has 3 elements" 3 ops.length test::assert_eq
    "op 0 is if_start" 0 ops.get.value common::OpValue::IfStart is test::assert_true
    "op 2 is if_end" 2 ops.get.value common::OpValue::IfEnd is test::assert_true

    TEST_STORE bytecode::BytecodeState::new = state
    ops state bytecode::BytecodeCompiler::new = compiler
    std::List[common::InstValue]::new = bytecode
    bytecode compiler.compile_ops

    # Expected: LABEL, JUMP_NE(end_label), LABEL(end_label)
    "if block bytecode length" 3 bytecode.length test::assert_eq
    "if block has label" 0 bytecode.get common::InstValue::Label is test::assert_true
    "if condition jump_ne" 1 bytecode.get common::InstValue::JumpNe is test::assert_true
    "if end label" 2 bytecode.get common::InstValue::Label is test::assert_true
}

