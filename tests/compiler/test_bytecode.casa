pub fn test_intern_string {
    "intern_string" test::test_start
    "\"hello\" drop \"hello\" drop \"world\" drop \"\" drop \"hyvä\" drop \"world\" drop" compile_bytecode_source = program
    "table has four entries" 4 program.strings.length test::assert_eq
    "first table entry" "hello" 0 program.strings.get test::assert_str_eq
    "second table entry" "world" 1 program.strings.get test::assert_str_eq
    "empty table entry" "" 2 program.strings.get test::assert_str_eq
    "non-ASCII table entry" "hyvä" 3 program.strings.get test::assert_str_eq
    "first string" 0 common::InstValue::PushStr program.bytecode assert_instruction_present
    "last repeated string" 1 common::InstValue::PushStr program.bytecode assert_instruction_present
}

pub fn test_fixed_array_local_slots {
    "fixed_array_local_slots" test::test_start
    "fn checked { [1, 2, 3, 4, 5, 6, 7, 8, 9] = numbers:array[u8 9] numbers drop } checked"
    typecheck_bytecode_source = checked_result
    checked_result bytecode::compile_typechecked.unwrap = program
    "checked" program
        .functions
        .get_str
        .unwrap = instructions
    "function initializes locals" 0 instructions.get common::InstValue::LocalsInit is test::assert_true
    false = found_address
    for instruction in instructions.iter do
        if instruction common::InstValue::LocalAddress(slot) is then
            if 1 slot == then
                true = found_address
            fi
        fi
    done
    "array address uses the last reserved word" found_address test::assert_true
}

pub fn test_fixed_array_root_slots {
    "fixed_array_root_slots" test::test_start
    "[1, 2, 3, 4, 5, 6, 7, 8, 9] = a_numbers:array[u8 9]\n42 = z_value\nz_value drop"
    typecheck_bytecode_source = result
    result bytecode::compile_typechecked.unwrap = program
    program.bytecode = instructions: $std::List[common::InstValue]
    if 0 instructions.get common::InstValue::LocalsInit(slots) is then
        "array and scalar reserve at least three words" 3 slots >= test::assert_true
    else
        "root initializes locals" false test::assert_true
    fi
    false = array_address
    false = scalar_set
    for instruction in instructions.iter do
        if instruction common::InstValue::LocalAddress(slot) is then
            if 1 slot == then
                true = array_address
            fi
        fi
        if instruction common::InstValue::LocalSet(slot) is then
            if 2 slot == then
                true = scalar_set
            fi
        fi
    done
    "array uses the second word" array_address test::assert_true
    "later scalar uses a distinct slot" scalar_set test::assert_true
}

pub fn test_fixed_array_copy_uses_local_storage {
    "fixed_array_copy_uses_local_storage" test::test_start
    "[1, 2] = numbers:array[i64 2] numbers dup drop drop" compile_bytecode_source = program
    "copies inline bytes" 16 common::InstValue::MoveBytes program.bytecode assert_instruction_present
    for instruction in program.bytecode.iter do
        "copy does not allocate" instruction common::InstValue::HeapAlloc is test::assert_false
    done
}

pub fn test_typed_raw_aggregate_uses_indirect_copy_instructions {
    "typed_raw_aggregate_uses_indirect_copy_instructions" test::test_start
    "struct Pair { first: i64 second: i64 } fn check { unsafe { 16 alloc } = storage 2 1 Pair = pair unsafe { pair storage ptr::write[Pair] storage ptr::read[Pair] } drop } check"
    typecheck_bytecode_source = result
    "typed raw aggregate typechecks" result.get_diagnostics.has_errors ! test::assert_true
    result bytecode::compile_typechecked.unwrap = program
    false = has_read
    false = has_write
    "check" program
        .functions
        .get_str
        .unwrap = instructions
    for instruction in instructions.iter do
        if instruction common::InstValue::ReadIndirect(size) is then
            "read carries inline size" 16 size test::assert_eq
            true = has_read
        elif instruction common::InstValue::WriteIndirect(size) is then
            "write carries inline size" 16 size test::assert_eq
            true = has_write
        fi
    done
    "has indirect read" has_read test::assert_true
    "has indirect write" has_write test::assert_true
}

