pub fn typecheck_bytecode_source code:$str -> typechecker::TypecheckResult {
    "test" code.clone lexer::lex_source = lex_result
    lex_result.into_parts = lex_diagnostics = tokens
    lexer::SourceStore::new lex_diagnostics std::List[std::String]::new tokens syntax::parse_and_resolve helpers::project_test_source = result
    result.into_parts = parse_diagnostics = source_bodies = store = ops
    source_bodies store std::List[common::Op]::new ops.unwrap_or helpers::type_check_parts = checked
    parse_diagnostics checked.with_source_diagnostics = checked
    checked
}

fn compile_bytecode_source code:$str -> common::Program {
    code typecheck_bytecode_source = checked
    if checked.get_diagnostics.has_errors then
        for
            diagnostic in checked
                .get_diagnostics
                .entries
                .iter
        do
            if diagnostic error::Diagnostic::Error(failure) is then
                failure.message print "\n" print
            fi
        done
        "Bytecode fixture must pass checking\n" panic
    fi
    checked bytecode::compile_typechecked match
        std::Result::Ok(program) => program
        std::Result::Error(failure) => {
            failure.message print "\n" print "Bytecode fixture must compile\n" panic
        }
    end
}

pub fn does_instruction_match
    actual:$common::InstValue
    expected_instruction:$common::InstValue
-> bool {
    expected_instruction match
        common::InstValue::Drop => actual common::InstValue::Drop is
        common::InstValue::Push(expected) => {
            if actual common::InstValue::Push(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::FnCall(expected) => {
            if actual common::InstValue::FnCall(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::FnReturn => actual common::InstValue::FnReturn is
        common::InstValue::Label(expected) => {
            if actual common::InstValue::Label(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::LocalsInit(expected) => {
            if actual common::InstValue::LocalsInit(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::LocalsUninit(expected) => {
            if actual common::InstValue::LocalsUninit(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::LocalGet(expected) => {
            if actual common::InstValue::LocalGet(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::LocalSet(expected) => {
            if actual common::InstValue::LocalSet(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::ConstantLoad(expected) => {
            if actual common::InstValue::ConstantLoad(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::ConstantStore(expected) => {
            if actual common::InstValue::ConstantStore(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::Dup => actual common::InstValue::Dup is
        common::InstValue::Over => actual common::InstValue::Over is
        common::InstValue::Rot => actual common::InstValue::Rot is
        common::InstValue::Swap => actual common::InstValue::Swap is
        common::InstValue::PrintBool => actual common::InstValue::PrintBool is
        common::InstValue::PrintChar => actual common::InstValue::PrintChar is
        common::InstValue::PrintCstr => actual common::InstValue::PrintCstr is
        common::InstValue::PrintInt => actual common::InstValue::PrintInt is
        common::InstValue::PrintStr => actual common::InstValue::PrintStr is
        common::InstValue::HeapAlloc => actual common::InstValue::HeapAlloc is
        common::InstValue::HeapFree => actual common::InstValue::HeapFree is
        common::InstValue::Load8 => actual common::InstValue::Load8 is
        common::InstValue::Load16 => actual common::InstValue::Load16 is
        common::InstValue::Load32 => actual common::InstValue::Load32 is
        common::InstValue::Load64 => actual common::InstValue::Load64 is
        common::InstValue::Store8 => actual common::InstValue::Store8 is
        common::InstValue::Store16 => actual common::InstValue::Store16 is
        common::InstValue::Store32 => actual common::InstValue::Store32 is
        common::InstValue::Store64 => actual common::InstValue::Store64 is
        common::InstValue::And => actual common::InstValue::And is
        common::InstValue::Or => actual common::InstValue::Or is
        common::InstValue::Not => actual common::InstValue::Not is
        common::InstValue::Eq => actual common::InstValue::Eq is
        common::InstValue::Ge => actual common::InstValue::Ge is
        common::InstValue::Gt => actual common::InstValue::Gt is
        common::InstValue::Le => actual common::InstValue::Le is
        common::InstValue::Lt => actual common::InstValue::Lt is
        common::InstValue::Ne => actual common::InstValue::Ne is
        common::InstValue::StrEq => actual common::InstValue::StrEq is
        common::InstValue::BitAnd => actual common::InstValue::BitAnd is
        common::InstValue::BitOr => actual common::InstValue::BitOr is
        common::InstValue::BitXor => actual common::InstValue::BitXor is
        common::InstValue::BitNot => actual common::InstValue::BitNot is
        common::InstValue::FnExec => actual common::InstValue::FnExec is
        common::InstValue::Syscall0 => actual common::InstValue::Syscall0 is
        common::InstValue::Syscall1 => actual common::InstValue::Syscall1 is
        common::InstValue::Syscall2 => actual common::InstValue::Syscall2 is
        common::InstValue::Syscall3 => actual common::InstValue::Syscall3 is
        common::InstValue::Syscall4 => actual common::InstValue::Syscall4 is
        common::InstValue::Syscall5 => actual common::InstValue::Syscall5 is
        common::InstValue::Syscall6 => actual common::InstValue::Syscall6 is
        common::InstValue::PushStr(expected) => {
            if actual common::InstValue::PushStr(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::PushChar(expected) => {
            if actual common::InstValue::PushChar(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::CaptureLoad(expected) => {
            if actual common::InstValue::CaptureLoad(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::FstringConcat(expected) => {
            if actual common::InstValue::FstringConcat(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::MoveBytes(expected) => {
            if actual common::InstValue::MoveBytes(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::CheckedAdd(expected) => {
            if actual common::InstValue::CheckedAdd(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::CheckedSub(expected) => {
            if actual common::InstValue::CheckedSub(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::CheckedMul(expected) => {
            if actual common::InstValue::CheckedMul(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::CheckedDiv(expected) => {
            if actual common::InstValue::CheckedDiv(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::CheckedMod(expected) => {
            if actual common::InstValue::CheckedMod(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::CheckedShl(expected) => {
            if actual common::InstValue::CheckedShl(value) is then
                expected value ==
            else
                false
            fi
        }
        common::InstValue::CheckedShr(expected) => {
            if actual common::InstValue::CheckedShr(value) is then
                expected value ==
            else
                false
            fi
        }
        _ => false
    end
}

fn assert_instruction_present
    instructions:$std::List[common::InstValue]
    expected:$common::InstValue
    message:$str
{
    for instruction in instructions.iter do
        if expected instruction does_instruction_match then
            message true test::assert_true return
        fi
    done
    message false test::assert_true
}

pub fn does_bytecode_match
    first:$std::List[common::InstValue]
    second:$std::List[common::InstValue]
-> bool {
    if first.length second.length != then
        false return
    fi
    0 = index: u64
    while index first.length > do
        if index second.get index first.get does_instruction_match ! then
            false return
        fi
        1 += index
    done
    true
}

pub fn test_bytecode_comparison_checks_payloads {
    "bytecode_comparison_checks_payloads" test::test_start
    std::List[common::InstValue]::new = first
    std::List[common::InstValue]::new = second
    1 common::InstValue::Push first.push
    2 common::InstValue::Push second.push
    "different instruction payloads differ" second first does_bytecode_match test::assert_false
}

fn append_control_flow_instructions
    source:$std::List[common::InstValue]
    target:mut$std::List[common::InstValue]
{
    for instruction in source.iter do
        instruction match
            common::InstValue::Label(label) => label common::InstValue::Label target.push
            common::InstValue::Jump(label) => label common::InstValue::Jump target.push
            common::InstValue::JumpNe(label) => label common::InstValue::JumpNe target.push
            _ => {
            }
        end
    done
}

fn label_at instructions:$std::List[common::InstValue] index:u64 -> u64 {
    if index instructions.get common::InstValue::Label(label) is then
        label return
    fi
    "expected label instruction" false test::assert_true
    0
}

fn assert_jump_at instructions:$std::List[common::InstValue] index:u64 target:u64 message:$str {
    if index instructions.get common::InstValue::Jump(actual) is then
        message target actual test::assert_eq return
    fi
    message false test::assert_true
}

fn assert_jump_ne_at instructions:$std::List[common::InstValue] index:u64 target:u64 message:$str {
    if index instructions.get common::InstValue::JumpNe(actual) is then
        message target actual test::assert_eq return
    fi
    message false test::assert_true
}

fn assert_jump_ne_targets_label
    instructions:$std::List[common::InstValue]
    jump_index:u64
    label_index:u64
{
    label_index instructions label_at = label
    if jump_index instructions.get common::InstValue::JumpNe(target) is then
        "deep if jump reaches its matching end" label target test::assert_eq return
    fi
    "deep if emits a conditional jump" false test::assert_true
}

pub fn test_invalid_program_stops_before_bytecode {
    "invalid_program_stops_before_bytecode" test::test_start
    "\"bad\" 1 *" typecheck_bytecode_source = result
    "type error returned upstream" result.get_diagnostics.has_errors test::assert_true
    result bytecode::compile_typechecked = compile_result
    "no program returned" compile_result.is_error test::assert_true
    "bytecode not entered" compile_result
        .unwrap_error
        .message
        .as_str "requires error-free" str::find 0 <= test::assert_true
}

pub fn test_compile_invariant_failure_is_not_diagnostic {
    "compile_invariant_failure_is_not_diagnostic" test::test_start
    "missing drop" typecheck_bytecode_source = checked
    "missing reference is rejected" checked.get_diagnostics.has_errors test::assert_true
    "rejected input cannot reach bytecode" checked bytecode::compile_typechecked.is_error test::assert_true
}

pub fn test_compile_checked_is_repeatable {
    "compile_checked_is_repeatable" test::test_start
    "const LIMIT 2\n1 = global_value\nfn used { LIMIT = local_value local_value drop }\nused"
    typecheck_bytecode_source.into_checked_program.unwrap = checked
    checked bytecode::compile_checked.unwrap = first_program
    checked bytecode::compile_checked.unwrap = second_program
    "root bytecode is stable" second_program.bytecode first_program.bytecode does_bytecode_match test::assert_true
    "used" first_program
        .functions
        .get_str
        .unwrap = first_function
    "used" second_program
        .functions
        .get_str
        .unwrap = second_function
    "function bytecode is stable" second_function first_function does_bytecode_match test::assert_true
}

pub fn test_compile_functions_once_per_pass {
    "compile_functions_once_per_pass" test::test_start
    "fn first { second } fn second { first } fn recursive { recursive } fn unused { 42 drop } first recursive" compile_bytecode_source = program
    "called functions emitted once" 3 program.functions.length test::assert_eq
    "first function emitted" "first" program.functions.has_str test::assert_true
    "second function emitted" "second" program.functions.has_str test::assert_true
    "recursive function emitted" "recursive" program.functions.has_str test::assert_true
    "unused function omitted" "unused" program.functions.has_str test::assert_false
}

