pub fn test_new_label {
    "new_label" test::test_start
    std::List[common::Op]::new = ops
    TEST_STORE bytecode::BytecodeState::new = state
    ops state bytecode::BytecodeCompiler::new = compiler
    compiler.new_label = first_label
    "first label is 0" 0 first_label test::assert_eq
    compiler.new_label = second_label
    "second label is 1" 1 second_label test::assert_eq
    compiler.new_label = third_label
    "third label is 2" 2 third_label test::assert_eq
}

pub fn test_intern_string {
    "intern_string" test::test_start
    std::List[common::Op]::new = ops
    TEST_STORE bytecode::BytecodeState::new = state
    ops state bytecode::BytecodeCompiler::new = compiler
    "first string index" 0 "hello" compiler.intern_string test::assert_eq
    "same string same index" 0 "hello" compiler.intern_string test::assert_eq
    "second string index" 1 "world" compiler.intern_string test::assert_eq
    "empty string index" 2 "" compiler.intern_string test::assert_eq
    "non-ASCII string index" 3 "hyvä" compiler.intern_string test::assert_eq
    "same second string index" 1 "world" compiler.intern_string test::assert_eq
    "same empty string index" 2 "" compiler.intern_string test::assert_eq
    "same non-ASCII string index" 3 "hyvä" compiler.intern_string test::assert_eq
    "table has four entries" 4 compiler
        .state
        .program
        .strings
        .length test::assert_eq
    "first table entry" "hello" 0 compiler
        .state
        .program
        .strings
        .get test::assert_str_eq
    "second table entry" "world" 1 compiler
        .state
        .program
        .strings
        .get test::assert_str_eq
    "empty table entry" "" 2 compiler
        .state
        .program
        .strings
        .get test::assert_str_eq
    "non-ASCII table entry" "hyvä" 3 compiler
        .state
        .program
        .strings
        .get test::assert_str_eq
}

