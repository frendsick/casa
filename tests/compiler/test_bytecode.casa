import "../../compiler/lexer.casa" as lexer
import "std" as std
import "helpers" as helpers
import "../../compiler/error.casa" as error
import "../../compiler/backend.casa" as bytecode
import "../../compiler/typechecker.casa" as typechecker
import "../../lib/test.casa" as test

fn check code:$str -> typechecker::CheckedProgram {
    error::Diagnostics::new = diagnostics
    diagnostics code helpers::typecheck_test_source = result
    "fixture passes checking" diagnostics.has_errors ! test::assert_true
    result.into_checked_program.unwrap
}

fn assert_contains assembly:$std::String needle:$str {
    assembly helpers::generated_assembly = generated
    needle generated.as_str needle str::contains test::assert_true
}

fn test_reachable_functions_and_repeatability {
    "reachable function worklist" test::test_start
    "fn first { second } fn second { first } fn recursive { recursive } fn unused { 42 drop } first recursive"
    check = checked
    checked lexer::SourceStore::new swap bytecode::compile_checked.unwrap = first
    "fn replacement { 7 drop } replacement" check = replacement
    replacement lexer::SourceStore::new swap bytecode::compile_checked.unwrap drop
    replacement drop
    checked lexer::SourceStore::new swap bytecode::compile_checked.unwrap = second
    "repeatable assembly" first.as_str second.as_str test::assert_str_eq
    "fn_first:" first assert_contains
    "fn_second:" first assert_contains
    "fn_recursive:" first assert_contains
    "unused function omitted" first.as_str "fn_unused:" str::contains ! test::assert_true
}

fn test_structured_aggregate_control_flow {
    "structured aggregate control flow" test::test_start
    "struct Value { n:i64 } fn choose flag:bool -> Value { if flag then 1 Value else 2 Value fi } fn run { 0 = count while count 4 < do if 2 count == then 1 += count continue elif 3 count == then break fi true choose drop 1 += count done } run"
    check lexer::SourceStore::new swap bytecode::compile_checked.unwrap = assembly
    "fn_choose:" assembly assert_contains
    "fn_run:" assembly assert_contains
    "returned aggregate has no backing allocation" assembly helpers::generated_assembly.as_str "call heap_alloc" str::contains ! test::assert_true
}

fn test_storage_plans {
    "aggregate storage plans" test::test_start
    "fn storage { [1, 2, 3, 4, 5, 6, 7, 8, 9] = numbers:array[u8 9] numbers dup drop drop 42 = scalar scalar drop } storage"
    check lexer::SourceStore::new swap bytecode::compile_checked.unwrap = assembly
    # Nine u8 elements occupy nine bytes, regardless of register save slots.
    "movb 8(%rsi), %dl" assembly assert_contains
    assembly helpers::generated_assembly = generated
    "Copy array storage needs no heap allocation" generated.as_str "call heap_alloc" str::contains ! test::assert_true
}

fn assert_local_aggregate code:$str {
    code check lexer::SourceStore::new swap bytecode::compile_checked.unwrap helpers::generated_assembly = generated
    "local aggregate has no backing allocation" generated.as_str "call heap_alloc" str::contains ! test::assert_true
    "local aggregate has no backing free" generated.as_str "call heap_free" str::contains ! test::assert_true
}

fn test_local_aggregate_placement {
    "function-local aggregate storage" test::test_start
    "struct Pair { pub x:i64 pub y:i64 } fn sum value:i64 -> i64 { value value Pair = pair pair.x pair.y + } 21 sum print"
    assert_local_aggregate
    "struct Pair { pub x:i64 pub y:i64 } fn sum -> i64 { Pair { x: 20 y: 22 } = pair 21 = pair.x pair.x pair.y + } sum print"
    assert_local_aggregate
    "struct Value { pub x:i64 } fn run { 42 Value = value value drop } run"
    assert_local_aggregate
    "enum Value { Some(i64) None } fn run -> bool { 42 Value::Some = value value Value::Some is } run print"
    assert_local_aggregate
    "struct Value { pub x:i64 } fn run { 0 = i while 5 i > do i Value = value if 2 i == then 1 += i continue fi if 4 i == then break fi value.x print 1 += i done } run"
    assert_local_aggregate
    "struct Value { pub x:i64 } fn run flag:bool -> i64 { 42 Value = value if flag then value.x return fi value.x } true run print"
    assert_local_aggregate
}

fn test_aggregate_call_storage {
    "aggregate storage across function boundaries" test::test_start
    for
        code in [
            "struct Value { pub x:i64 } fn make -> Value { 42 Value = value value } make drop",
            "struct Value { pub x:i64 } fn take value:Value { value.x print } 42 Value = value value take",
            "struct Value { pub x:i64 } fn read value:$Value -> i64 { value.x } 42 Value = value value read print",
            "struct Value { pub x:i64 } 42 Value = value value = moved moved.x print",
            "struct Value { pub x:i64 } 42 Value = value 43 Value = value value.x print",
            "struct Value { pub x:i64 } fn make flag:bool -> Value { if flag then 42 Value return fi 43 Value } true &make exec drop",
            "enum Value { Some(i64) None } fn make -> Value { 42 Value::Some } fn take value:Value { value match Value::Some(x) => x print Value::None => {} end } make take",
            "struct Value { pub x:i64 } fn make -> Value i64 Value { 1 Value 2 3 Value } make drop drop drop",
            "struct Value { pub x:i64 } unsafe { 42 Value = value value ptr::from_ref load64 print }",
        ].iter
    do
        code assert_local_aggregate
    done
}

fn test_aggregate_storage_size_limit {
    "affine aggregate storage has a per-body size limit" test::test_start
    "extern struct Value { data:array[u64 512] } extern fn make -> Value\nunsafe { make drop }"
    assert_local_aggregate
    "extern struct Value { data:array[u64 513] } extern fn make -> Value\nunsafe { make drop }"
    check lexer::SourceStore::new swap bytecode::compile_checked.unwrap helpers::generated_assembly = generated
    "large affine result retains heap storage" generated.as_str "call heap_alloc" str::contains test::assert_true
    "large affine result releases heap storage" generated.as_str "call heap_free" str::contains test::assert_true
}

fn test_aggregate_heap_destinations {
    "independent aggregate destinations retain heap storage" test::test_start
    for
        code in [
            "enum Chain { Link(Chain) End } Chain::End Chain::Link drop",
            "struct Value { pub x:i64 } 42 Value = value move { value.x } = callback callback exec print",
            "struct Value { pub x:i64 } unsafe { 42 Value = value value ptr::into_raw ptr::from_raw[Value] drop }",
        ].iter
    do
        code check lexer::SourceStore::new swap bytecode::compile_checked.unwrap helpers::generated_assembly = generated
        "independent destination allocates" generated.as_str "call heap_alloc" str::contains test::assert_true
        "independent destination releases its allocation" generated.as_str "call heap_free" str::contains test::assert_true
    done
}

fn test_string_literal_pool {
    "string literal pool" test::test_start
    "\"zeta\" drop \"\" drop \"ä猫\" drop \"a\\0b\" drop \"alpha\" drop \"i64\" drop 42 typeof drop [\"alpha\", \"\", \"ä猫\", \"zeta\", \"a\\0b\", \"i64\"] drop fn repeat { \"zeta\" drop \"\" drop \"ä猫\" drop \"a\\0b\" drop \"alpha\" drop } repeat"
    check = checked
    checked lexer::SourceStore::new swap bytecode::compile_checked.unwrap = assembly
    checked lexer::SourceStore::new swap bytecode::compile_checked.unwrap = repeated
    "repeatable literal pool" assembly.as_str repeated.as_str test::assert_str_eq
    "str_0:\n.quad 4\n.asciz \"zeta\"" assembly assert_contains
    "str_1:\n.quad 0\n.asciz \"\"" assembly assert_contains
    "str_2:\n.quad 5\n.asciz \"\\303\\244\\347\\214\\253\"" assembly assert_contains
    "str_3:\n.quad 3\n.asciz \"a\\000b\"" assembly assert_contains
    "str_4:\n.quad 5\n.asciz \"alpha\"" assembly assert_contains
    "str_5:\n.quad 3\n.asciz \"i64\"" assembly assert_contains
    "no duplicate pool entries" assembly.as_str "str_6:" str::contains ! test::assert_true
    ".quad str_4\n.quad str_1\n.quad str_2\n.quad str_0\n.quad str_3\n.quad str_5" assembly assert_contains
}

fn test_string_literal_pool_growth {
    "string literal pool growth" test::test_start
    std::String::new = source
    0 = index: u64
    while index 128 < do
        f"\"literal-{index}\" drop " source.append_string
        1 += index
    done
    while 0 index < do
        1 -= index
        f"\"literal-{index}\" drop " source.append_string
    done
    source.as_str check lexer::SourceStore::new swap bytecode::compile_checked.unwrap = assembly
    0 = index: u64
    while index 128 < do
        f"literal-{index}" = value
        f"str_{index}:\n.quad {value.length}\n.asciz \"literal-{index}\"" = entry
        entry.as_str assembly assert_contains
        1 += index
    done
    "growth preserves deduplication" assembly.as_str "str_128:" str::contains ! test::assert_true
}

fn test_slice_construction_does_not_allocate {
    "slice allocation" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics
    "import \"lib/std.casa\" as std fn arrays source:$array[i64 3] { source.as_slice drop 3 1 source.slice = view 1 0 view.slice drop } fn lists source:$std::List[i64] { source.as_slice drop 0 0 source.slice = view 0 0 view.slice drop } fn bytes source:$std::Bytes { source.as_slice drop 0 0 source.slice = view 0 0 view.slice drop } &arrays drop &lists drop &bytes drop"
    helpers::compile_test_source = assembly
    "slice source passes checking" diagnostics.has_errors ! test::assert_true
    assembly helpers::generated_assembly = generated
    "view construction and subranges do not allocate" generated.as_str "call heap_alloc_native" str::contains ! test::assert_true
}

fn test_rejected_source_stops_before_selection {
    "rejected source stops before selection" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "missing drop" helpers::typecheck_test_source = result
    result.get_diagnostics.clone diagnostics.merge
    "source diagnostic" diagnostics.has_errors test::assert_true
    "no assembly" result.into_checked_program.is_error test::assert_true
}

pub fn run_tests {
    test_reachable_functions_and_repeatability
    test_structured_aggregate_control_flow
    test_storage_plans
    test_local_aggregate_placement
    test_aggregate_storage_size_limit
    test_aggregate_call_storage
    test_aggregate_heap_destinations
    test_rejected_source_stops_before_selection
    test_slice_construction_does_not_allocate
    test_string_literal_pool
    test_string_literal_pool_growth
    test::test_summary
}
run_tests
