pub fn test_compile_local_variable {
    "compile_local_variable" test::test_start

    # Create a function with a variable
    std::List[common::Op]::new = fn_ops
    "y".to_str common::OpValue::AssignVar test_make_op fn_ops.push
    "y".to_str common::OpValue::PushVar test_make_op fn_ops.push

    # Function::new name:String ops:List[Op] location:Location
    # param1=name, param2=ops, param3=location
    make_test_location fn_ops common::clone_ops "test_fn".to_str common::Function::new = func
    "y" common::Variable::new func common::Function::variables.push

    std::List[common::InstValue]::new = bytecode
    TEST_STORE bytecode::BytecodeState::new = root_state
    fn_ops root_state bytecode::BytecodeCompiler::new = root_compiler
    fn_ops func root_compiler.child = compiler
    bytecode compiler.compile_ops

    # Index 0 is label, 1 is LOCAL_SET, 2 is LOCAL_GET
    if 1 bytecode.get common::InstValue::LocalSet(set_index) is then
        "local assign index" 0 set_index test::assert_eq
    else
        "local assign kind" false test::assert_true
    fi
    if 2 bytecode.get common::InstValue::LocalGet(get_index) is then
        "local push index" 0 get_index test::assert_eq
    else
        "local push kind" false test::assert_true
    fi
}

pub fn test_precomputed_variable_slots {
    "precomputed_variable_slots" test::test_start
    common::symbol_store_new = store
    "global_zero" common::Variable::new "global_zero".to_str store.variables.set
    "shared" common::Variable::new "shared".to_str store.variables.set

    std::List[common::Op]::new = fn_ops
    "shared".to_str common::OpValue::AssignVar test_make_op fn_ops.push
    "local_zero".to_str common::OpValue::PushVar test_make_op fn_ops.push
    "global_zero".to_str common::OpValue::PushVar test_make_op fn_ops.push
    "capture_one".to_str common::OpValue::PushCapture test_make_op fn_ops.push

    make_test_location fn_ops common::clone_ops "slot_test".to_str common::Function::new = function
    "local_zero" common::Variable::new function.variables.push
    "shared" common::Variable::new function.variables.push
    "capture_zero" common::Variable::new function.captures.push
    "capture_one" common::Variable::new function.captures.push
    "capture_one" common::Variable::new function.captures.push

    std::List[common::InstValue]::new = bytecode
    store bytecode::BytecodeState::new = root_state
    fn_ops root_state bytecode::BytecodeCompiler::new = root_compiler
    fn_ops function root_compiler.child = compiler
    bytecode compiler.compile_ops

    if 1 bytecode.get common::InstValue::LocalSet(local_set) is then
        "local shadows global" 1 local_set test::assert_eq
    else
        "shadowed local set kind" false test::assert_true
    fi
    if 2 bytecode.get common::InstValue::LocalGet(local_get) is then
        "first local slot" 0 local_get test::assert_eq
    else
        "local get kind" false test::assert_true
    fi
    if 3 bytecode.get common::InstValue::GlobalGet(global_get) is then
        "first global slot" 0 global_get test::assert_eq
    else
        "global get kind" false test::assert_true
    fi
    if 4 bytecode.get common::InstValue::CaptureLoad(capture_load) is then
        "second capture slot" 1 capture_load test::assert_eq
    else
        "capture load kind" false test::assert_true
    fi
}

