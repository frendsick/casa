pub fn test_precomputed_variable_slots {
    "precomputed_variable_slots" test::test_start
    "fn slots { 1 = first 2 = second { first second + } exec drop } slots" compile_bytecode_source = program
    false = found_capture
    for
        name in program
            .functions
            .keys
            .iter
    do
        if name.as_str "lambda__" str::starts_with then
            name program
                .functions
                .get
                .unwrap = instructions
            "first capture slot" 0 common::InstValue::CaptureLoad instructions assert_instruction_present
            "second capture slot" 1 common::InstValue::CaptureLoad instructions assert_instruction_present
            true = found_capture
        fi
    done
    "checked closure emitted" found_capture test::assert_true
}

