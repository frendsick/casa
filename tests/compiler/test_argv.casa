import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../compiler/lexer.casa" as lexer
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "../../compiler/bytecode.casa" as bytecode
import "../../compiler/emitter.casa" as emitter
import "helpers.casa" as helpers

# ============================================================================
# Helpers
# ============================================================================

pub fn tc_string_argv code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

pub fn compile_string_argv code:$str diagnostics:mut$error::Diagnostics -> common::Program {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test drop
    store ops helpers::compile_test_program
}

pub fn emit_string_argv code:$str diagnostics:mut$error::Diagnostics -> std::String {
    diagnostics code compile_string_argv emitter::emit
}

pub fn assert_contains needle:$str haystack:$std::String msg:$str {
    haystack.as_str needle str::find = pos
    if 0 pos < then
        msg false test::assert_true
    else
        msg true test::assert_true
    fi
}

# ============================================================================
# Lexer tests
# ============================================================================

pub fn test_lex_argc {
    "lex_argc" test::test_start
    "test" "argc" lexer::lex_source = lex_result
    lex_result.tokens = tokens: $std::List[common::Token]
    "argc kind" common::TokenKind::Intrinsic 0 tokens.get common::Token::kind == test::assert_true
    "argc value" "argc" 0 tokens.get common::Token::value.as_str test::assert_str_eq
}

pub fn test_lex_argv {
    "lex_argv" test::test_start
    "test" "argv" lexer::lex_source = lex_result
    lex_result.tokens = tokens: $std::List[common::Token]
    "argv kind" common::TokenKind::Intrinsic 0 tokens.get common::Token::kind == test::assert_true
    "argv value" "argv" 0 tokens.get common::Token::value.as_str test::assert_str_eq
}

# ============================================================================
# Parser tests
# ============================================================================

pub fn test_parse_argc {
    "parse_argc" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "argc" helpers::parse_resolve_test_parts = store = ops
    store drop
    "argc kind" 0 ops.get.value common::OpValue::Argc is test::assert_true
}

pub fn test_parse_argv {
    "parse_argv" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics "argv" helpers::parse_resolve_test_parts = store = ops
    store drop
    "argv kind" 0 ops.get.value common::OpValue::Argv is test::assert_true
}

# ============================================================================
# Typechecker tests
# ============================================================================

pub fn test_typecheck_argc_pushes_int {
    error::Diagnostics::new = diagnostics
    "typecheck_argc_pushes_int" test::test_start
    diagnostics "argc" tc_string_argv = sig
    "return count" 1 sig common::StackEffect::return_types.length test::assert_eq
    "return type" "u64" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_argv_pushes_ptr {
    error::Diagnostics::new = diagnostics
    "typecheck_argv_pushes_ptr" test::test_start
    diagnostics "argv" tc_string_argv = sig
    "return count" 1 sig common::StackEffect::return_types.length test::assert_eq
    "return type" "ptr" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_argc_no_inputs {
    error::Diagnostics::new = diagnostics
    "typecheck_argc_no_inputs" test::test_start
    diagnostics "argc" tc_string_argv = sig
    "no params" 0 sig common::StackEffect::parameters.length test::assert_eq
}

pub fn test_typecheck_argv_no_inputs {
    error::Diagnostics::new = diagnostics
    "typecheck_argv_no_inputs" test::test_start
    diagnostics "argv" tc_string_argv = sig
    "no params" 0 sig common::StackEffect::parameters.length test::assert_eq
}

pub fn test_typecheck_argc_in_arithmetic {
    error::Diagnostics::new = diagnostics
    "typecheck_argc_in_arithmetic" test::test_start
    diagnostics "argc 1 +" tc_string_argv = sig
    "result type" "u64" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

pub fn test_typecheck_argv_with_load {
    error::Diagnostics::new = diagnostics
    "typecheck_argv_with_load" test::test_start
    diagnostics "argv load64" tc_string_argv = sig
    "result type" "u64" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

# ============================================================================
# Bytecode tests
# ============================================================================

pub fn has_inst_kind bytecode:$std::List[common::InstValue] kind:common::InstValue -> bool {
    false = found
    0 (u64) = index
    while index bytecode.length > do
        if kind index bytecode.get == then
            true = found
        fi
        1 += index
    done
    found
}

pub fn test_bytecode_argc {
    error::Diagnostics::new = diagnostics
    "bytecode_argc" test::test_start
    diagnostics "argc" compile_string_argv = prog
    "has ARGC inst" common::InstValue::Argc prog common::Program::bytecode has_inst_kind test::assert_true
}

pub fn test_bytecode_argv {
    error::Diagnostics::new = diagnostics
    "bytecode_argv" test::test_start
    diagnostics "argv" compile_string_argv = prog
    "has ARGV inst" common::InstValue::Argv prog common::Program::bytecode has_inst_kind test::assert_true
}

# ============================================================================
# Emitter tests
# ============================================================================

pub fn test_emit_argc_loads_from_bss {
    error::Diagnostics::new = diagnostics
    "emit_argc_loads_from_bss" test::test_start
    diagnostics "argc" emit_string_argv = asm
    "has __argc ref" asm "__argc(%rip)" assert_contains
}

pub fn test_emit_argv_loads_from_bss {
    error::Diagnostics::new = diagnostics
    "emit_argv_loads_from_bss" test::test_start
    diagnostics "argv" emit_string_argv = asm
    "has __argv ref" asm "__argv(%rip)" assert_contains
}

pub fn test_emit_bss_has_argc_argv_slots {
    error::Diagnostics::new = diagnostics
    "emit_bss_has_argc_argv_slots" test::test_start
    diagnostics "42" emit_string_argv = asm
    "has __argc slot" asm "__argc: .skip 8" assert_contains
    "has __argv slot" asm "__argv: .skip 8" assert_contains
}

pub fn test_emit_start_saves_argc_argv {
    error::Diagnostics::new = diagnostics
    "emit_start_saves_argc_argv" test::test_start
    diagnostics "42" emit_string_argv = asm
    "saves argc" asm "__argc(%rip)" assert_contains
    "saves argv" asm "__argv(%rip)" assert_contains
    "reads stack for argc" asm "movq (%rsp), %rax" assert_contains
    "reads stack for argv" asm "leaq 8(%rsp)" assert_contains
}

