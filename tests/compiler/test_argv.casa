test_lex_argc
test_lex_argv
test_parse_argc
test_parse_argv
test_typecheck_argc_pushes_int
test_typecheck_argv_pushes_ptr
test_typecheck_argc_no_inputs
test_typecheck_argv_no_inputs
test_typecheck_argc_in_arithmetic
test_typecheck_argv_with_load
test_bytecode_argc
test_bytecode_argv
test_emit_argc_loads_from_bss
test_emit_argv_loads_from_bss
test_emit_bss_has_argc_argv_slots
test_emit_start_saves_argc_argv
test::test_summary
