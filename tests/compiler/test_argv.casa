import "../../compiler/typechecker.casa"
import "../../compiler/bytecode.casa"
import "../../compiler/emitter.casa"
import "helpers.casa"

# ============================================================================
# Helpers
# ============================================================================

fn tc_string_argv code:$str diagnostics:mut$Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option[Function]::None ops type_check_ops_for_test
}

fn compile_string_argv code:$str diagnostics:mut$Diagnostics -> Program {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option[Function]::None ops type_check_ops_for_test drop
    store ops compile_test_program
}

fn emit_string_argv code:$str diagnostics:mut$Diagnostics -> str {
    diagnostics code compile_string_argv emit
}

fn assert_contains needle:$str haystack:$str msg:$str {
    haystack needle str::find = pos
    if 0 pos < then
        msg false assert_true
    else
        msg true assert_true
    fi
}

# ============================================================================
# Lexer tests
# ============================================================================

fn test_lex_argc {
    "lex_argc" test_start
    "test" "argc" lex_source = lex_result
    lex_result.tokens = tokens
    "argc kind" TokenKind::Intrinsic 0 tokens.get Token::kind == assert_true
    "argc value" "argc" 0 tokens.get Token::value assert_str_eq
}

fn test_lex_argv {
    "lex_argv" test_start
    "test" "argv" lex_source = lex_result
    lex_result.tokens = tokens
    "argv kind" TokenKind::Intrinsic 0 tokens.get Token::kind == assert_true
    "argv value" "argv" 0 tokens.get Token::value assert_str_eq
}

# ============================================================================
# Parser tests
# ============================================================================

fn test_parse_argc {
    "parse_argc" test_start
    "test" "argc" lex_source = lex_result
    lex_result.tokens = tokens
    SourceStore::new lex_result.diagnostics List[str]::new tokens parse_and_resolve ParseResolveResult::ops.unwrap = ops
    "argc kind" 0 ops.get.value OpValue::Argc is assert_true
}

fn test_parse_argv {
    "parse_argv" test_start
    "test" "argv" lex_source = lex_result
    lex_result.tokens = tokens
    SourceStore::new lex_result.diagnostics List[str]::new tokens parse_and_resolve ParseResolveResult::ops.unwrap = ops
    "argv kind" 0 ops.get.value OpValue::Argv is assert_true
}

# ============================================================================
# Typechecker tests
# ============================================================================

fn test_typecheck_argc_pushes_int {
    Diagnostics::new = diagnostics
    "typecheck_argc_pushes_int" test_start
    diagnostics "argc" tc_string_argv = sig
    "return count" 1 sig StackEffect::return_types.length assert_eq
    "return type" "u64" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_typecheck_argv_pushes_ptr {
    Diagnostics::new = diagnostics
    "typecheck_argv_pushes_ptr" test_start
    diagnostics "argv" tc_string_argv = sig
    "return count" 1 sig StackEffect::return_types.length assert_eq
    "return type" "ptr" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_typecheck_argc_no_inputs {
    Diagnostics::new = diagnostics
    "typecheck_argc_no_inputs" test_start
    diagnostics "argc" tc_string_argv = sig
    "no params" 0 sig StackEffect::parameters.length assert_eq
}

fn test_typecheck_argv_no_inputs {
    Diagnostics::new = diagnostics
    "typecheck_argv_no_inputs" test_start
    diagnostics "argv" tc_string_argv = sig
    "no params" 0 sig StackEffect::parameters.length assert_eq
}

fn test_typecheck_argc_in_arithmetic {
    Diagnostics::new = diagnostics
    "typecheck_argc_in_arithmetic" test_start
    diagnostics "argc 1 +" tc_string_argv = sig
    "result type" "u64" 0 sig StackEffect::return_types.get.format assert_str_eq
}

fn test_typecheck_argv_with_load {
    Diagnostics::new = diagnostics
    "typecheck_argv_with_load" test_start
    diagnostics "argv load64" tc_string_argv = sig
    "result type" "i64" 0 sig StackEffect::return_types.get.format assert_str_eq
}

# ============================================================================
# Bytecode tests
# ============================================================================

fn has_inst_kind bytecode:List[InstValue] kind:InstValue -> bool {
    false = found
    0 (u64) = index
    while index bytecode.length > do
        if kind index bytecode.get == then
            true = found
        fi
        1 += index
    done
    found
}

fn test_bytecode_argc {
    Diagnostics::new = diagnostics
    "bytecode_argc" test_start
    diagnostics "argc" compile_string_argv = prog
    "has ARGC inst" InstValue::Argc prog Program::bytecode has_inst_kind assert_true
}

fn test_bytecode_argv {
    Diagnostics::new = diagnostics
    "bytecode_argv" test_start
    diagnostics "argv" compile_string_argv = prog
    "has ARGV inst" InstValue::Argv prog Program::bytecode has_inst_kind assert_true
}

# ============================================================================
# Emitter tests
# ============================================================================

fn test_emit_argc_loads_from_bss {
    Diagnostics::new = diagnostics
    "emit_argc_loads_from_bss" test_start
    diagnostics "argc" emit_string_argv = asm
    "has __argc ref" asm "__argc(%rip)" assert_contains
}

fn test_emit_argv_loads_from_bss {
    Diagnostics::new = diagnostics
    "emit_argv_loads_from_bss" test_start
    diagnostics "argv" emit_string_argv = asm
    "has __argv ref" asm "__argv(%rip)" assert_contains
}

fn test_emit_bss_has_argc_argv_slots {
    Diagnostics::new = diagnostics
    "emit_bss_has_argc_argv_slots" test_start
    diagnostics "42" emit_string_argv = asm
    "has __argc slot" asm "__argc: .skip 8" assert_contains
    "has __argv slot" asm "__argv: .skip 8" assert_contains
}

fn test_emit_start_saves_argc_argv {
    Diagnostics::new = diagnostics
    "emit_start_saves_argc_argv" test_start
    diagnostics "42" emit_string_argv = asm
    "saves argc" asm "__argc(%rip)" assert_contains
    "saves argv" asm "__argv(%rip)" assert_contains
    "reads stack for argc" asm "movq (%rsp), %rax" assert_contains
    "reads stack for argv" asm "leaq 8(%rsp)" assert_contains
}

# ============================================================================
# Run all tests
# ============================================================================
test_lex_argc
test_lex_argv
test_parse_argc
test_parse_argv
test_typecheck_argc_pushes_int
test_typecheck_argv_pushes_ptr
test_typecheck_argc_no_inputs
test_typecheck_argv_no_inputs
test_typecheck_argc_in_arithmetic
test_typecheck_argv_with_load
test_bytecode_argc
test_bytecode_argv
test_emit_argc_loads_from_bss
test_emit_argv_loads_from_bss
test_emit_bss_has_argc_argv_slots
test_emit_start_saves_argc_argv
test_summary
