import "std" as std
import "../../lib/test.casa" as test

struct Item {
    value: i64
    drops: ptr
}

impl Item {
    fn drop self:mut$Item {
        unsafe { self.drops load64 10 * self.value u64::try_from.unwrap + self.drops store64 }
    }
}

fn items drops:ptr -> std::List[Item] {
    [Item { value: 1 drops: drops }, Item { value: 2 drops: drops }, Item { value: 3 drops: drops }]
    std::List::from_array
}

fn reset drops:ptr {
    unsafe { 0 drops store64 }
}

fn dropped drops:ptr -> u64 {
    unsafe { drops load64 }
}

fn is_two item:$Item -> bool { 2 item.value == }

fn below_two item:$Item -> bool { 2 item.value > }

fn test_mutable drops:ptr {
    "mutable list traversal" test::test_start
    drops reset
    drops items = values
    values.iter_mut = cursor_0
    cursor_0.next.unwrap = first
    4 = first.value
    cursor_0.next.unwrap = second
    5 = second.value
    cursor_0.next.unwrap = third
    6 = third.value
    "exhausted" cursor_0.next.is_none test::assert_true
    "still exhausted" cursor_0.next.is_none test::assert_true
    cursor_0 drop
    "borrowing destroys no elements" 0 drops dropped test::assert_eq
    "first changed" 4 0 values.get_ref.value test::assert_eq
    "second changed" 5 1 values.get_ref.value test::assert_eq
    "third changed" 6 2 values.get_ref.value test::assert_eq
    for element in values.iter_mut do
        1 += element.value
    done
    values drop
    "list remains owner" 765 drops dropped test::assert_eq

    drops reset
    drops items = values
    values.iter_mut = cursor_1
    "any stops at match" &is_two cursor_1.any test::assert_true
    "count drains remainder" 1 cursor_1.count test::assert_eq
    "count exhausted" 0 cursor_1.count test::assert_eq
    cursor_1 drop
    values.iter_mut = cursor_2
    "all stops at failure" &below_two cursor_2.all ! test::assert_true
    "all leaves next element" 3 cursor_2
        .next
        .unwrap
        .value test::assert_eq
    cursor_2 drop
    values.iter_mut = cursor_3
    &is_two cursor_3.find.unwrap = found
    8 = found.value
    "find leaves remainder" 3 cursor_3
        .next
        .unwrap
        .value test::assert_eq
    cursor_3 drop
    values drop
    "terminals preserve ownership" 381 drops dropped test::assert_eq

    std::List[Item]::new = empty
    empty.iter_mut = cursor_4
    "empty next" cursor_4.next.is_none test::assert_true
    "empty all" &is_two cursor_4.all test::assert_true
    "empty any" &is_two cursor_4.any ! test::assert_true
    "empty find" &is_two cursor_4.find.is_none test::assert_true
    "empty count" 0 cursor_4.count test::assert_eq
}

fn exit_return drops:ptr {
    for element in drops items.into_iter do
        return
    done
}

fn exit_question drops:ptr -> std::Option[i64] {
    for element in drops items.into_iter do
        std::Option[i64]::None ? drop
    done
    0 std::Option::Some
}

fn consume_borrowed cursor:mut$std::Iter[Item] {
    for element in cursor do
        break
    done
}

fn consume_value item:Item -> i64 { item.value }

fn fail_fold accumulator:i64 element:Item -> std::Result[i64 i64] {
    if 2 element.value == then
        9 std::Result::Error
    else
        accumulator element.value + std::Result::Ok
    fi
}

fn fail_visit element:Item -> std::Result[std::Unit i64] {
    if 2 element.value == then
        9 std::Result::Error
    else
        std::Unit::Value std::Result::Ok
    fi
}

fn test_consuming drops:ptr {
    "consuming list ownership" test::test_start
    drops reset
    drops items.into_iter = cursor
    cursor.next.unwrap = first
    cursor.next.unwrap = second
    "index order" 1 first.value test::assert_eq
    "second index" 2 second.value test::assert_eq
    cursor drop
    "drop destroys only remainder" 3 drops dropped test::assert_eq
    first drop
    second drop
    "yielded owners outlive cursor" 312 drops dropped test::assert_eq

    drops reset
    drops items.into_iter = cursor
    for element in cursor do
        continue
    done
    "continue visits and destroys all" 123 drops dropped test::assert_eq

    drops reset
    for element in drops items.into_iter do
        break
    done
    "break destroys remainder before next statement" 123 drops dropped test::assert_eq

    drops reset
    for element in 1 drops items.into_iter.take do
        element drop
    done
    "adapter completion destroys remainder" 123 drops dropped test::assert_eq

    drops reset
    drops exit_return
    "return destroys each owner once" 123 drops dropped test::assert_eq
    drops reset
    "question propagates" drops exit_question.is_none test::assert_true
    "question destroys each owner once" 123 drops dropped test::assert_eq

    drops reset
    drops items.into_iter = cursor
    cursor consume_borrowed
    "borrowed loop preserves remainder" 1 drops dropped test::assert_eq
    "borrowed loop resumes" 2 cursor.next.unwrap consume_value test::assert_eq
    cursor drop
    "borrowed iterator cleanup" 123 drops dropped test::assert_eq

    drops reset
    drops items.into_iter = cursor
    "any stops" &is_two cursor.any test::assert_true
    "any consumed prefix" 12 drops dropped test::assert_eq
    "any resumes" 3 cursor.next.unwrap consume_value test::assert_eq
    "exhausted next" cursor.next.is_none test::assert_true
    "repeated exhaustion" cursor.next.is_none test::assert_true
    cursor drop
    "exhaustion destroys no duplicate" 123 drops dropped test::assert_eq

    drops reset
    drops items.into_iter = cursor
    &is_two cursor.find.unwrap = found
    "find match" 2 found.value test::assert_eq
    "find destroys nonmatches" 1 drops dropped test::assert_eq
    found drop
    "find resumes" 3 cursor.next.unwrap consume_value test::assert_eq
    cursor drop
    "find ownership" 123 drops dropped test::assert_eq

    drops reset
    drops items.into_iter = cursor
    "try_fold stops" &fail_fold 0 cursor.try_fold.is_error test::assert_true
    "try_fold resumes" 3 cursor.next.unwrap consume_value test::assert_eq
    cursor drop
    "try_fold cleanup" 123 drops dropped test::assert_eq
    drops reset
    drops items.into_iter = cursor
    "try_for_each stops" &fail_visit cursor.try_for_each.is_error test::assert_true
    "try_for_each resumes" 3 cursor.next.unwrap consume_value test::assert_eq
    cursor drop
    "try_for_each cleanup" 123 drops dropped test::assert_eq

    drops reset
    drops items.into_iter.collect = collected
    "collect transfers ownership" 0 drops dropped test::assert_eq
    "collect preserves order" 2 1 collected.get_ref.value test::assert_eq
    collected drop
    "collected list owns each element" 321 drops dropped test::assert_eq

    std::List[Item]::new.into_iter = empty
    "empty owned next" empty.next.is_none test::assert_true
    "empty owned exhaustion" empty.next.is_none test::assert_true
}
unsafe { 8 alloc = drops }
drops test_mutable
drops test_consuming
unsafe { drops free }
test::test_summary
