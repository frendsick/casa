pub fn test_borrows_do_not_satisfy_copy_or_clone {
    "borrows_do_not_satisfy_copy_or_clone" test::test_start
    error::Diagnostics::new = diagnostics
    diagnostics COPY_TRAITS "enum Item derives __casa_std__Copy { Value }" str::concat.as_str
    helpers::parse_resolve_test_source = result

    diagnostics result.store std::Option[common::Function]::None common::STD_COPY_TRAIT "$Item" common::parse_type_str
    helpers::type_satisfies_trait_for_test = borrow_is_copy
    "shared borrow does not satisfy Copy" borrow_is_copy ! test::assert_true

    diagnostics result.store std::Option[common::Function]::None common::STD_CLONE_TRAIT "$Item" common::parse_type_str
    helpers::type_satisfies_trait_for_test = borrow_is_clone
    "shared borrow does not satisfy Clone" borrow_is_clone ! test::assert_true

    result.store common::STD_CLONE_TRAIT common::parse_type_str "$Item" common::parse_type_str
    semantics::type_has_satisfying_trait_impl = semantic_borrow_is_clone
    "shared borrow fails lower-level Clone constraints" semantic_borrow_is_clone !
    test::assert_true

    diagnostics result.store std::Option[common::Function]::None common::STD_COPY_TRAIT "Item" common::parse_type_str
    helpers::type_satisfies_trait_for_test = item_is_copy
    "owned Copy type still satisfies Copy" item_is_copy test::assert_true

    diagnostics result.store std::Option[common::Function]::None common::STD_CLONE_TRAIT "Item" common::parse_type_str
    helpers::type_satisfies_trait_for_test = item_is_clone
    "owned Copy type still satisfies Clone" item_is_clone test::assert_true
}

pub fn test_named_function_clone {
    "named_function_clone" test::test_start
    12 &identity.clone exec = direct
    "direct function clone" 12 direct test::assert_eq

    error::Diagnostics::new = diagnostics
    COPY_TRAITS "fn cloned[T: __casa_std__Clone] value:T -> T { value.clone } fn identity value:i64 -> i64 { value } &identity cloned drop" str::concat diagnostics check_source
    diagnostics "function Copy works as a Clone supertrait" helpers::assert_no_errors
}

pub fn test_copy_contract_is_methodless {
    "copy_contract_is_methodless" test::test_start
    error::Diagnostics::new = diagnostics
    "trait __casa_std__Copy { fn duplicate self:self -> self }".to_str diagnostics check_source
    diagnostics "methodless contract" "must not declare methods" helpers::assert_error_contains
}

pub fn test_clone_contract_is_infallible_self_to_self {
    "clone_contract_is_infallible_self_to_self" test::test_start
    error::Diagnostics::new = diagnostics
    "trait __casa_std__Clone { fn clone self:self -> Option[self] }".to_str diagnostics check_source
    diagnostics "Clone result contract" "incompatible `clone`" helpers::assert_error_contains
}
