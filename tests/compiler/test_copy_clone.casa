import "std"
import "../../compiler/typechecker.casa"
import "helpers.casa"

const COPY_TRAITS "trait Clone { fn clone self:$self -> self } trait Copy: Clone { } "

struct CopyPoint derives Copy {
    value: i64
}

struct CustomClone {
    value: i64
}

struct CustomCopy derives Copy {
    value: i64
}

impl CustomCopy: Clone {
    fn clone self:$CustomCopy -> CustomCopy { self.value 1 + CustomCopy }
}

struct CopyWrapper derives Copy {
    inner: CustomCopy
}

struct BorrowView derives Copy {
    value: $CustomClone
}

enum CopyChoice derives Copy {
    None
    Some (CustomCopy)
}

enum BorrowChoice derives Copy {
    None
    Some ($CustomClone)
}

impl CustomClone: Clone {
    fn clone self:$CustomClone -> CustomClone { self.value 1 + CustomClone }
}

struct CountedClone {
    value: i64
    count: ptr
}

impl CountedClone: Clone {
    fn clone self:$CountedClone -> CountedClone { self.count self.value CountedClone }
}

impl CountedClone {
    fn drop self:mut$CountedClone {
        unsafe { self.count load64 1 + self.count store64 }
    }
}

fn clone_counted_array count:ptr {
    CountedClone { value: 1 count: count } = first
    CountedClone { value: 2 count: count } = second
    [first, second] = owned: array[CountedClone 2]
    owned.clone = cloned
    "array clone length" 2 cloned.length assert_eq
}

fn identity value:i64 -> i64 { value }

fn clone_shared value:$CustomClone -> CustomClone { value.clone }

fn clone_exclusive value:mut$CustomClone -> CustomClone { value.clone }

fn clone_borrow_view value:$CustomClone -> BorrowView { value BorrowView.clone }

fn clone_borrow_choice value:$CustomClone -> BorrowChoice { value BorrowChoice::Some.clone }

fn check_source diagnostics:mut$Diagnostics source:$str {
    diagnostics source parse_resolve_test_source = result
    if result.ops Option::Some(ops) is then
        result.store ops type_check = checked
        checked.diagnostics diagnostics.merge
    fi
}

fn test_copy_intrinsics_and_fallback_clone {
    "copy_intrinsics_and_fallback_clone" test_start
    7 CopyPoint = point
    point dup = first = second
    "dup first" 7 first.value assert_eq
    "dup second" 7 second.value assert_eq
    "copy" 7 point copy.value assert_eq
    "fallback clone" 7 point.clone.value assert_eq

    8 CustomCopy dup = copied_first = copied_second
    "Copy does not call custom Clone" 8 copied_first.value assert_eq
    "Copy preserves the source value" 8 copied_second.value assert_eq

    8 CustomCopy CopyWrapper.clone.inner = cloned_inner
    "fallback clone composes field Clone" 9 cloned_inner.value assert_eq

    10 CustomCopy CopyChoice::Some.clone = cloned_choice
    cloned_choice match
        CopyChoice::Some(value) => {
            "fallback clone composes payload Clone" 11 value.value assert_eq
        }
        CopyChoice::None => { "expected cloned payload" false assert_true }
    end
}

fn test_standard_owner_clone_composes {
    "standard_owner_clone_composes" test_start
    List[CustomClone]::new = values
    4 CustomClone values.push
    values.clone = cloned_values
    "list clone uses element Clone" 5 0 cloned_values.get.value assert_eq

    6 CustomClone Option::Some.clone.unwrap = cloned_option
    "option clone uses payload Clone" 7 cloned_option.value assert_eq

    [8, 9].clone = cloned_array
    "array clone length" 2 cloned_array.length assert_eq
    "array clone value" 9 1 cloned_array.nth.clone assert_eq

    # Cloning reads elements through borrows, so the source array and its clone
    # destroy two elements each instead of duplicating owners.
    unsafe { 8 alloc = drop_count }
    unsafe { 0 drop_count store64 }
    drop_count clone_counted_array
    unsafe { "array clone destroys each element once" 4 drop_count load64 assert_eq }

    "hello" = original
    original.clone = cloned_text
    "str clone value" original cloned_text str::eq assert_true
    unsafe { "str clone owns distinct storage" original (ptr) cloned_text (ptr) != assert_true }

    Map[i64 CustomClone]::new = values_by_id
    10 CustomClone 1 values_by_id.set = values_by_id
    values_by_id.clone = cloned_map
    "map clone uses value Clone" 11 1 cloned_map.get.unwrap.value assert_eq

    Set[str]::new = names
    "Casa" names.add = names
    names.clone = cloned_names
    "set clone retains values" "Casa" cloned_names.has assert_true
}

fn test_borrow_clone_uses_borrowed_value {
    "borrow_clone_uses_borrowed_value" test_start
    4 CustomClone = value
    "shared borrow clone owns a value" 5 value clone_shared.value assert_eq
    "exclusive borrow clone owns a value" 5 value clone_exclusive.value assert_eq

    value clone_borrow_view = view
    "generated struct Clone preserves a shared borrow" 4 view.value.value assert_eq

    value clone_borrow_choice match
        BorrowChoice::Some(borrowed) => {
            "generated enum Clone preserves a shared borrow" 4 borrowed.value assert_eq
        }
        BorrowChoice::None => { "expected borrowed payload" false assert_true }
    end
}

fn test_non_copy_dup_is_rejected {
    "non_copy_dup_is_rejected" test_start
    Diagnostics::new = diagnostics
    COPY_TRAITS "\"owned\" dup" str::concat diagnostics check_source
    diagnostics "mentions Copy" "does not satisfy trait `Copy`" assert_error_contains
}

fn test_over_checks_the_copied_value {
    "over_checks_the_copied_value" test_start
    Diagnostics::new = diagnostics
    COPY_TRAITS "struct Owner { value: str } \"owned\" Owner 1 over" str::concat diagnostics check_source
    diagnostics "deeper owner rejected" "Type `Owner` does not satisfy trait `Copy`" assert_error_contains

    Diagnostics::new = valid_diagnostics
    COPY_TRAITS "struct Owner { value: str } 1 \"owned\" Owner over" str::concat valid_diagnostics check_source
    valid_diagnostics "non-Copy top value is only moved" assert_no_errors
}

fn test_shared_borrow_duplication_preserves_origins {
    "shared_borrow_duplication_preserves_origins" test_start
    Diagnostics::new = diagnostics
    COPY_TRAITS
    "struct Owner { value: str } fn view owner:$Owner -> $Owner { owner } fn inspect owner:$Owner { } fn invalid owner:Owner { owner view = borrowed borrowed dup drop 1 borrowed over drop drop owner drop }"
    str::concat diagnostics check_source
    diagnostics "duplicated shared borrows retain their origin"
    "Cannot move owner `owner` while it is borrowed" assert_error_contains

    Diagnostics::new = clone_diagnostics
    COPY_TRAITS
    "struct Owner { value: str } struct View derives Copy { value: $Owner } fn make_view owner:$Owner -> View { owner View } fn invalid owner:Owner { owner make_view.clone owner drop drop }"
    str::concat clone_diagnostics check_source
    clone_diagnostics "generated Clone retains a stored borrow origin"
    "Cannot move owner `owner` while it is borrowed" assert_error_contains
}

fn test_affine_owner_reuse_is_rejected {
    "affine_owner_reuse_is_rejected" test_start
    Diagnostics::new = diagnostics
    COPY_TRAITS
    "struct Owner { value: str } fn consume owner:Owner { } fn reuse owner:Owner { owner consume owner consume }"
    str::concat diagnostics check_source
    diagnostics "use after move" "Owner `owner` was already moved" assert_error_contains

    Diagnostics::new = aggregate_diagnostics
    COPY_TRAITS
    "struct Owner { value: str } struct Box { value: Owner } fn move_into_box owner:Owner { owner Box drop owner drop }"
    str::concat aggregate_diagnostics check_source
    aggregate_diagnostics "aggregate consumes owner" "Owner `owner` was already moved"
    assert_error_contains

    Diagnostics::new = return_diagnostics
    COPY_TRAITS
    "struct Owner { value: str } fn duplicate owner:Owner -> Owner Owner { owner owner }"
    str::concat return_diagnostics check_source
    return_diagnostics "return duplication consumes owner" "Owner `owner` was already moved"
    assert_error_contains

    Diagnostics::new = rebind_diagnostics
    COPY_TRAITS
    "struct Owner { value: str } fn rebind owner:Owner -> Owner { owner = owner owner }"
    str::concat rebind_diagnostics check_source
    rebind_diagnostics "self-rebinding preserves the new owner" assert_no_errors
}

fn test_borrowed_calls_preserve_owner {
    "borrowed_calls_preserve_owner" test_start
    Diagnostics::new = diagnostics
    COPY_TRAITS
    "struct Owner { value: i64 } fn inspect owner:$Owner { owner.value drop } fn reuse owner:Owner { owner inspect owner inspect }"
    str::concat diagnostics check_source
    diagnostics "shared calls preserve owner" assert_no_errors
}

fn test_receiver_capabilities {
    "receiver_capabilities" test_start
    COPY_TRAITS
    "struct Item derives Copy { value: i64 } impl Item { fn take self:Item { } fn read self:$Item { } fn write self:mut$Item { } } fn owned item:Item { item.read item.write item.take } fn shared item:$Item { item.read } fn exclusive item:mut$Item { item.read item.write } fn clone_shared item:$Item -> Item { item.clone } fn clone_exclusive item:mut$Item -> Item { item.clone }"
    str::concat = declarations

    Diagnostics::new = valid_diagnostics
    declarations valid_diagnostics check_source
    valid_diagnostics "compatible receivers" assert_no_errors

    Diagnostics::new = shared_mutation_diagnostics
    declarations " fn invalid item:$Item { item.write }" str::concat
    shared_mutation_diagnostics check_source
    shared_mutation_diagnostics "shared receiver cannot mutate" "requires an exclusive receiver"
    assert_error_contains

    Diagnostics::new = merged_shared_diagnostics
    declarations
    " fn invalid item:$Item flag:bool { if flag then item else item fi .write }"
    str::concat merged_shared_diagnostics check_source
    merged_shared_diagnostics "merged shared receiver cannot mutate" "requires an exclusive receiver"
    assert_error_contains

    Diagnostics::new = shared_consume_diagnostics
    declarations " fn invalid item:$Item { item.take }" str::concat
    shared_consume_diagnostics check_source
    shared_consume_diagnostics "shared receiver cannot be consumed" "requires an owned receiver"
    assert_error_contains

    Diagnostics::new = exclusive_consume_diagnostics
    declarations " fn invalid item:mut$Item { item.take }" str::concat
    exclusive_consume_diagnostics check_source
    exclusive_consume_diagnostics "exclusive receiver cannot be consumed" "requires an owned receiver"
    assert_error_contains

    Diagnostics::new = exclusive_copy_diagnostics
    declarations " fn invalid item:mut$Item { item dup drop drop }" str::concat
    exclusive_copy_diagnostics check_source
    exclusive_copy_diagnostics "exclusive borrow is not Copy" "does not satisfy trait `Copy`"
    assert_error_contains
}

fn test_exclusive_call_loans_do_not_alias {
    "exclusive_call_loans_do_not_alias" test_start
    COPY_TRAITS
    "struct Item derives Copy { value: i64 } fn read_both left:$Item right:$Item { } fn write_both left:mut$Item right:mut$Item { } impl Item { fn update self:mut$Item other:$Item { } } fn valid item:Item { item item read_both }"
    str::concat = declarations

    Diagnostics::new = valid_diagnostics
    declarations valid_diagnostics check_source
    valid_diagnostics "shared aliases are allowed" assert_no_errors

    Diagnostics::new = function_diagnostics
    declarations " fn invalid item:Item { item item write_both }" str::concat
    function_diagnostics check_source
    function_diagnostics "exclusive function arguments cannot alias" "Cannot borrow `item` exclusively more than once in one call"
    assert_error_contains

    Diagnostics::new = method_diagnostics
    declarations " fn invalid item:Item { item item.update }" str::concat
    method_diagnostics check_source
    method_diagnostics "mut$self loans the complete receiver" "Cannot borrow `item` exclusively while it is also borrowed in the same call"
    assert_error_contains
}

fn test_returned_borrows_keep_every_input_loaned {
    "returned_borrows_keep_every_input_loaned" test_start
    COPY_TRAITS
    "struct Owner { value: str } fn inspect owner:$Owner { } fn choose flag:bool left:$Owner right:$Owner -> $Owner { if flag then left else right fi }"
    str::concat = declarations

    Diagnostics::new = diagnostics
    declarations
    " fn invalid left:Owner right:Owner { right left true choose = view left drop view inspect right drop }"
    str::concat diagnostics check_source
    diagnostics "opaque result loans every compatible input"
    "Cannot move owner `left` while it is borrowed" assert_error_contains

    Diagnostics::new = released_diagnostics
    declarations
    " fn valid left:Owner right:Owner { right left true choose = view view inspect left drop right drop }"
    str::concat released_diagnostics check_source
    released_diagnostics "loan ends after the returned borrow's last use" assert_no_errors
}

fn test_aggregate_borrows_keep_the_origin_loaned {
    "aggregate_borrows_keep_the_origin_loaned" test_start
    Diagnostics::new = diagnostics
    COPY_TRAITS
    "struct Owner { value: str } struct View[T] { value: T } fn consume view:View[$Owner] { } fn wrap owner:$Owner -> View[$Owner] { owner View } fn invalid owner:Owner { owner wrap = view owner drop view consume }"
    str::concat diagnostics check_source
    diagnostics "generic aggregate retains borrow origin"
    "Cannot move owner `owner` while it is borrowed" assert_error_contains

    Diagnostics::new = pattern_diagnostics
    COPY_TRAITS
    "struct Owner { value: str } enum View[T] { Hold(T) } fn inspect owner:$Owner { } fn wrap owner:$Owner -> View[$Owner] { owner View::Hold } fn invalid owner:Owner { owner wrap match View::Hold(view) => { owner drop view inspect } end }"
    str::concat pattern_diagnostics check_source
    pattern_diagnostics "borrow origin survives aggregate pattern extraction"
    "Cannot move owner `owner` while it is borrowed" assert_error_contains

    Diagnostics::new = array_diagnostics
    COPY_TRAITS
    "struct Owner { value: str } fn consume views:array[$Owner 1] { } fn wrap owner:$Owner -> array[$Owner 1] { [owner] } fn invalid owner:Owner { owner wrap = views owner drop views consume }"
    str::concat array_diagnostics check_source
    array_diagnostics "array literal retains borrow origin"
    "Cannot move owner `owner` while it is borrowed" assert_error_contains
}

fn test_borrowed_return_cannot_escape_a_local_owner {
    "borrowed_return_cannot_escape_a_local_owner" test_start
    Diagnostics::new = diagnostics
    COPY_TRAITS
    "struct Owner { value: str } fn view owner:$Owner -> $Owner { owner } fn invalid -> $Owner { \"local\" Owner = owner owner view }"
    str::concat diagnostics check_source
    diagnostics "borrowed local cannot escape" "Borrowed return escapes local owner `owner`"
    assert_error_contains

    Diagnostics::new = missing_diagnostics
    COPY_TRAITS
    "struct Owner { value: str } fn invalid -> $Owner { unsafe { 0 (ptr) ($Owner) } }"
    str::concat missing_diagnostics check_source
    missing_diagnostics "borrow needs an input origin" "Borrowed return has no live input origin"
    assert_error_contains
}

fn test_branch_joins_require_definite_ownership {
    "branch_joins_require_definite_ownership" test_start
    COPY_TRAITS
    "struct Owner { value: str } fn consume owner:Owner { }"
    str::concat = declarations

    Diagnostics::new = moved_diagnostics
    declarations
    " fn invalid owner:Owner flag:bool { if flag then owner consume fi owner consume }"
    str::concat moved_diagnostics check_source
    moved_diagnostics "move on one continuing path poisons the join"
    "Owner `owner` was already moved" assert_error_contains

    Diagnostics::new = reinit_diagnostics
    declarations
    " fn valid owner:Owner flag:bool { if flag then owner consume \"then\" Owner = owner else owner consume \"else\" Owner = owner fi owner consume }"
    str::concat reinit_diagnostics check_source
    reinit_diagnostics "every path restores ownership" assert_no_errors

    Diagnostics::new = return_diagnostics
    declarations
    " fn valid owner:Owner flag:bool { if flag then owner consume return fi owner consume }"
    str::concat return_diagnostics check_source
    return_diagnostics "returning path is excluded from the join" assert_no_errors
}

fn test_match_joins_exclude_returning_arms {
    "match_joins_exclude_returning_arms" test_start
    COPY_TRAITS
    "struct Owner { value: str } enum Decision { Take Keep } fn consume owner:Owner { }"
    str::concat = declarations

    Diagnostics::new = moved_diagnostics
    declarations
    " fn invalid owner:Owner decision:Decision { decision match Decision::Take => { owner consume } Decision::Keep => { } end owner consume }"
    str::concat moved_diagnostics check_source
    moved_diagnostics "match move on one arm poisons the join"
    "Owner `owner` was already moved" assert_error_contains

    Diagnostics::new = return_diagnostics
    declarations
    " fn valid owner:Owner decision:Decision { decision match Decision::Take => { owner consume return } Decision::Keep => { } end owner consume }"
    str::concat return_diagnostics check_source
    return_diagnostics "returning match arm is excluded" assert_no_errors
}

fn test_loop_back_edges_and_exits_track_ownership {
    "loop_back_edges_and_exits_track_ownership" test_start
    COPY_TRAITS
    "struct Owner { value: str } fn consume owner:Owner { }"
    str::concat = declarations

    Diagnostics::new = back_edge_diagnostics
    declarations " fn invalid owner:Owner { while true do owner consume done }"
    str::concat back_edge_diagnostics check_source
    back_edge_diagnostics "normal back-edge restores ownership"
    "Loop back-edge does not restore ownership of `owner`" assert_error_contains

    Diagnostics::new = continue_diagnostics
    declarations " fn invalid owner:Owner { while true do owner consume continue done }"
    str::concat continue_diagnostics check_source
    continue_diagnostics "continue restores ownership"
    "Loop back-edge does not restore ownership of `owner`" assert_error_contains

    Diagnostics::new = break_diagnostics
    declarations
    " fn invalid owner:Owner flag:bool { while true do if flag then owner consume break fi break done owner consume }"
    str::concat break_diagnostics check_source
    break_diagnostics "break exits merge ownership"
    "Owner `owner` was already moved" assert_error_contains

    Diagnostics::new = reinit_diagnostics
    declarations
    " fn valid owner:Owner { while false do owner consume \"next\" Owner = owner done owner consume }"
    str::concat reinit_diagnostics check_source
    reinit_diagnostics "loop body restores its header state" assert_no_errors
}

fn test_control_flow_joins_merge_possible_loans {
    "control_flow_joins_merge_possible_loans" test_start
    COPY_TRAITS
    "struct Owner { value: str } fn view owner:$Owner -> $Owner { owner } fn inspect owner:$Owner { }"
    str::concat = declarations

    Diagnostics::new = diagnostics
    declarations
    " fn invalid left:Owner right:Owner flag:bool { left view = alias if flag then right view = alias else left view = alias fi right drop alias inspect left drop }"
    str::concat diagnostics check_source
    diagnostics "join retains every possible loan"
    "Cannot move owner `right` while it is borrowed" assert_error_contains

    Diagnostics::new = guard_diagnostics
    declarations
    " enum Decision { Take Keep } fn consume owner:Owner { } fn invalid owner:Owner decision:Decision { decision match Decision::Take if owner consume true => { } Decision::Keep => { } _ => { } end }"
    str::concat guard_diagnostics check_source
    guard_diagnostics "guard move rejected" "Match guard cannot move owner `owner`"
    assert_error_contains
}

fn test_field_sensitive_borrows_and_patterns {
    "field_sensitive_borrows_and_patterns" test_start
    COPY_TRAITS
    "struct Item { value: str } struct Pair { left: Item right: Item } impl Item { fn inspect self:$Item { } fn clear self:mut$Item { } } impl Pair { fn clear self:mut$Pair { } }"
    str::concat = declarations

    Diagnostics::new = direct_diagnostics
    declarations
    " fn valid pair:mut$Pair { pair.left pair.right.clear Item::inspect }"
    str::concat direct_diagnostics check_source
    direct_diagnostics "distinct field loans remain usable" assert_no_errors

    Diagnostics::new = receiver_diagnostics
    declarations
    " fn invalid pair:mut$Pair { pair.left pair.clear Item::inspect }"
    str::concat receiver_diagnostics check_source
    receiver_diagnostics "whole receiver overlaps a field loan"
    "Cannot borrow `pair` exclusively while it is borrowed" assert_error_contains

    Diagnostics::new = same_field_diagnostics
    declarations
    " fn invalid pair:mut$Pair { pair.left pair.left.clear Item::inspect }"
    str::concat same_field_diagnostics check_source
    same_field_diagnostics "same field loans overlap"
    "Cannot borrow `pair.left` exclusively while it is borrowed" assert_error_contains

    Diagnostics::new = nested_field_diagnostics
    COPY_TRAITS
    " struct Value { text: str } struct Item { value: Value } struct Box { item: Item } impl Value { fn clear self:mut$Value { } } impl Item { fn inspect self:$Item { } } fn invalid box:mut$Box { box.item box.item.value.clear Item::inspect }"
    str::concat nested_field_diagnostics check_source
    nested_field_diagnostics "nested field loans overlap their parent"
    "Cannot borrow `box.item.value` while it is borrowed" assert_error_contains

    Diagnostics::new = shared_diagnostics
    declarations
    " fn valid pair:$Pair { pair.left pair.left.inspect Item::inspect }"
    str::concat shared_diagnostics check_source
    shared_diagnostics "shared field loans may coexist" assert_no_errors

    Diagnostics::new = duplicate_diagnostics
    declarations
    " fn invalid pair:mut$Pair -> mut$Item mut$Item { pair.left pair.left }"
    str::concat duplicate_diagnostics check_source
    duplicate_diagnostics "duplicate exclusive outputs overlap"
    "Cannot return overlapping exclusive places `pair.left` and `pair.left`"
    assert_error_contains

    Diagnostics::new = pattern_duplicate_diagnostics
    declarations
    " fn invalid pair:mut$Pair -> mut$Item mut$Item { pair match Pair { left: left } => left left end }"
    str::concat pattern_duplicate_diagnostics check_source
    pattern_duplicate_diagnostics "pattern output origins overlap"
    "Cannot return overlapping exclusive places `pair.left` and `pair.left`"
    assert_error_contains

    Diagnostics::new = split_diagnostics
    declarations
    " fn split pair:mut$Pair -> mut$Item mut$Item { pair.left pair.right } fn valid pair:Pair { pair split = right = left left.clear right.clear pair drop }"
    str::concat split_diagnostics check_source
    split_diagnostics "disjoint exclusive outputs are valid" assert_no_errors

    Diagnostics::new = pattern_diagnostics
    declarations
    " fn first pair:$Pair -> $Item { pair match Pair { left: left } => left end } fn split_pattern pair:mut$Pair -> mut$Item mut$Item { pair match Pair { left: left right: right } => left right end } fn valid pair:Pair { pair first.inspect pair split_pattern = right = left left.clear right.clear pair drop }"
    str::concat pattern_diagnostics check_source
    pattern_diagnostics "borrowed struct match binds a field borrow" assert_no_errors
}

