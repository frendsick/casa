fn test_copy_bound_and_clone_supertrait {
    "copy_bound_and_clone_supertrait" test_start
    Diagnostics::new = diagnostics
    COPY_TRAITS "struct Point derives Copy { value: i64 } fn duplicate[T: Copy] value:T -> T T { value dup } fn cloned[T: Clone] value:T -> T { value.clone } 1 Point duplicate drop cloned drop" str::concat diagnostics check_source
    diagnostics "Copy works as a Clone supertrait" assert_no_errors
}

fn test_borrows_do_not_satisfy_copy_or_clone {
    "borrows_do_not_satisfy_copy_or_clone" test_start
    Diagnostics::new = diagnostics
    diagnostics COPY_TRAITS "struct Item derives Copy { value: i64 }" str::concat
    parse_resolve_test_source = result

    diagnostics result.store Option[Function]::None "Copy" "$Item" parse_type_str
    type_satisfies_trait_for_test = borrow_is_copy
    "shared borrow does not satisfy Copy" borrow_is_copy ! assert_true

    diagnostics result.store Option[Function]::None "Clone" "$Item" parse_type_str
    type_satisfies_trait_for_test = borrow_is_clone
    "shared borrow does not satisfy Clone" borrow_is_clone ! assert_true

    result.store "Clone" parse_type_str "$Item" parse_type_str
    type_has_satisfying_trait_impl = semantic_borrow_is_clone
    "shared borrow fails lower-level Clone constraints" semantic_borrow_is_clone !
    assert_true

    diagnostics result.store Option[Function]::None "Copy" "Item" parse_type_str
    type_satisfies_trait_for_test = item_is_copy
    "owned Copy type still satisfies Copy" item_is_copy assert_true

    diagnostics result.store Option[Function]::None "Clone" "Item" parse_type_str
    type_satisfies_trait_for_test = item_is_clone
    "owned Copy type still satisfies Clone" item_is_clone assert_true
}

fn test_named_function_clone {
    "named_function_clone" test_start
    12 &identity.clone exec = direct
    "direct function clone" 12 direct assert_eq

    Diagnostics::new = diagnostics
    COPY_TRAITS "fn cloned[T: Clone] value:T -> T { value.clone } fn identity value:i64 -> i64 { value } &identity cloned drop" str::concat diagnostics check_source
    diagnostics "function Copy works as a Clone supertrait" assert_no_errors
}

fn test_copy_contract_is_methodless {
    "copy_contract_is_methodless" test_start
    Diagnostics::new = diagnostics
    "trait Copy { fn duplicate self:self -> self }" diagnostics check_source
    diagnostics "methodless contract" "must not declare methods" assert_error_contains
}

fn test_clone_contract_is_infallible_self_to_self {
    "clone_contract_is_infallible_self_to_self" test_start
    Diagnostics::new = diagnostics
    "trait Clone { fn clone self:self -> Option[self] }" diagnostics check_source
    diagnostics "Clone result contract" "incompatible `clone`" assert_error_contains
}
