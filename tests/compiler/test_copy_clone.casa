test_affine_owner_reuse_is_rejected
test_borrowed_calls_preserve_owner
test_receiver_capabilities
test_exclusive_call_loans_do_not_alias
test_returned_borrows_keep_every_input_loaned
test_aggregate_borrows_keep_the_origin_loaned
test_borrowed_return_cannot_escape_a_local_owner
test_stack_reordering_preserves_owner_identity
test_copy_derivation_validates_fields
test_explicit_copy_implementation_is_validated
test_copy_bound_and_clone_supertrait
test_named_function_clone
test_copy_contract_is_methodless
test_clone_contract_is_infallible_self_to_self
