import "../../compiler/analysis.casa"
import "../../lib/os.casa"
import "../../lib/test.casa"

const ANALYSIS_TEST_FILE "/tmp/casa_analysis_test.casa"

fn test_analysis_returns_frontend_outputs {
    "analysis_returns_frontend_outputs" test_start
    "42 print" ANALYSIS_TEST_FILE AnalysisInput::new analyze = result
    "no diagnostics" result.diagnostics.has_errors ! assert_true
    "typechecked output" result.typechecked.is_some assert_true
    "root source retained" "42 print" ANALYSIS_TEST_FILE result.sources.get.unwrap assert_str_eq
}

fn test_analysis_retains_imported_source {
    "analysis_retains_imported_source" test_start
    "/tmp/casa_analysis_imported_source.casa" = imported_file
    "fn dependency {\n    42 print\n}" = imported_source
    imported_source imported_file file::write_all drop
    f"import \"{imported_file}\"\ndependency" ANALYSIS_TEST_FILE AnalysisInput::new analyze = result
    imported_file file::remove drop
    "import compiles" result.diagnostics.has_errors ! assert_true
    "import retained" imported_source imported_file result.sources.get.unwrap assert_str_eq
    20 imported_file result.sources.convert_offset_to_position.unwrap = position
    "imported line" 2 position.line assert_eq
    "imported column" 5 position.column assert_eq
    5 2 SourcePosition::new imported_file result.sources.convert_position_to_offset.unwrap = offset
    "imported offset" 20 offset assert_eq
}

fn test_analysis_uses_in_memory_import_override {
    "analysis_uses_in_memory_import_override" test_start
    "import \"/tmp/casa_analysis_dependency.casa\"\ndependency" ANALYSIS_TEST_FILE AnalysisInput::new = input
    "fn dependency { 42 print }" "/tmp/casa_analysis_dependency.casa" input.source_overrides.set = input.source_overrides
    input analyze = result
    "override compiles" result.diagnostics.has_errors ! assert_true
    "override retained" "fn dependency { 42 print }" "/tmp/casa_analysis_dependency.casa" result.sources.get.unwrap assert_str_eq
}

fn test_sequential_analyses_are_isolated {
    "sequential_analyses_are_isolated" test_start
    "trait Marker { fn mark self:self -> self }\nfn leaked[T: Marker] value:T -> T { value }\n\"bad\" 1 *"
    ANALYSIS_TEST_FILE AnalysisInput::new = first_input
    "first only" "/tmp/casa_analysis_first_only.casa" first_input.source_overrides.set = first_input.source_overrides
    first_input analyze = first
    "first has diagnostics" first.diagnostics.has_errors assert_true
    "first has partial output" first.typechecked.is_some assert_true

    "fn clean[T] value:T -> T { value }\n42 print" ANALYSIS_TEST_FILE AnalysisInput::new analyze = second
    "second has no diagnostics" second.diagnostics.has_errors ! assert_true
    "second has typechecked output" second.typechecked.is_some assert_true
    "first source does not leak" "/tmp/casa_analysis_first_only.casa" second.sources.get.is_none assert_true
    "symbol does not leak" "leaked" second.typechecked.unwrap.store.functions.has ! assert_true
    "clean" second.typechecked.unwrap.store.functions.get.unwrap.stack_effect.trait_bounds = clean_bounds
    "trait bounds do not leak" 0 clean_bounds.length assert_eq
}
test_analysis_returns_frontend_outputs
test_analysis_retains_imported_source
test_analysis_uses_in_memory_import_override
test_sequential_analyses_are_isolated
test_summary
