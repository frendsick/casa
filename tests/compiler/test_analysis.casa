import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/analysis.casa" as analysis
import "../../lib/os.casa" as os
import "../../lib/test.casa" as test

pub const ANALYSIS_TEST_FILE "/tmp/casa_analysis_test.casa"

pub fn test_analysis_returns_frontend_outputs {
    "analysis_returns_frontend_outputs" test::test_start
    "42 print".to_str ANALYSIS_TEST_FILE.to_str analysis::AnalysisInput::new analysis::analyze = result
    "no diagnostics" result.diagnostics.has_errors ! test::assert_true
    "typechecked output" result.typechecked.is_some test::assert_true
    "root source retained" "42 print" ANALYSIS_TEST_FILE result
        .sources
        .get
        .unwrap test::assert_str_eq
}

pub fn test_analysis_retains_imported_source {
    "analysis_retains_imported_source" test::test_start
    "/tmp/casa_analysis_imported_source.casa" = imported_file
    "pub fn dependency {\n    42 print\n}" = imported_source
    imported_source.clone imported_file.clone file::write_all drop
    f"import \"{imported_file}\" as dependency_module\ndependency_module::dependency" ANALYSIS_TEST_FILE.to_str analysis::AnalysisInput::new analysis::analyze = result
    imported_file.clone file::remove drop
    "import compiles" result.diagnostics.has_errors ! test::assert_true
    "import retained" imported_source imported_file result
        .sources
        .get
        .unwrap test::assert_str_eq
    24 imported_file result
        .sources
        .convert_offset_to_position
        .unwrap = position
    "imported line" 2 position.line test::assert_eq
    "imported column" 5 position.column test::assert_eq
    5 2 common::SourcePosition::new imported_file result
        .sources
        .convert_position_to_offset
        .unwrap = offset
    "imported offset" 24 offset test::assert_eq
}

pub fn test_analysis_uses_in_memory_import_override {
    "analysis_uses_in_memory_import_override" test::test_start
    "import \"/tmp/casa_analysis_dependency.casa\" as dependency_module\ndependency_module::dependency".to_str ANALYSIS_TEST_FILE.to_str analysis::AnalysisInput::new = input
    "pub fn dependency { 42 print }".to_str "/tmp/casa_analysis_dependency.casa".to_str input.source_overrides.set
    input analysis::analyze = result
    "override compiles" result.diagnostics.has_errors ! test::assert_true
    "override retained" "pub fn dependency { 42 print }" "/tmp/casa_analysis_dependency.casa" result
        .sources
        .get
        .unwrap test::assert_str_eq
}

pub fn test_analysis_resolves_module_import_from_override {
    "analysis_resolves_module_import_from_override" test::test_start
    "import \"virtual\" as virtual\nvirtual::value".to_str
    "/tmp/casa_analysis_root_548/main.casa".to_str analysis::AnalysisInput::new = input
    "casa_analysis_virtual_548".to_str input.library_paths.push
    "pub fn value { 42 }".to_str
    "casa_analysis_virtual_548/virtual.casa".to_str input.source_overrides.set
    input analysis::analyze = result
    "override compiles" result.diagnostics.has_errors ! test::assert_true
    "override retained" "pub fn value { 42 }" "casa_analysis_virtual_548/virtual.casa" result
        .sources
        .get
        .unwrap test::assert_str_eq
}

pub fn test_sequential_analyses_are_isolated {
    "sequential_analyses_are_isolated" test::test_start
    "trait Marker { fn mark self:self -> self }\nfn leaked[T: Marker] value:T -> T { value }\n\"bad\" 1 *".to_str
    ANALYSIS_TEST_FILE.to_str analysis::AnalysisInput::new = first_input
    "first only".to_str "/tmp/casa_analysis_first_only.casa".to_str first_input.source_overrides.set
    first_input analysis::analyze = first
    "first has diagnostics" first.diagnostics.has_errors test::assert_true
    "first has partial output" first.typechecked.is_some test::assert_true

    "fn clean[T] value:T -> T { value }\n42 print".to_str ANALYSIS_TEST_FILE.to_str analysis::AnalysisInput::new analysis::analyze.into_parts = second_typechecked = second_sources = second_diagnostics
    "second has no diagnostics" second_diagnostics.has_errors ! test::assert_true
    "first source does not leak" "/tmp/casa_analysis_first_only.casa" second_sources.get.is_none test::assert_true
    second_typechecked match
        std::Option::Some(checked) => {
            "symbol does not leak" "leaked" checked
                .store
                .functions
                .has_str ! test::assert_true
            "trait bounds do not leak" 0 "clean" checked
                .store
                .functions
                .get_str
                .unwrap
                .stack_effect
                .trait_bounds
                .length test::assert_eq
        }
        std::Option::None => "second has typechecked output" false test::assert_true
    end
}
test_analysis_returns_frontend_outputs
test_analysis_retains_imported_source
test_analysis_uses_in_memory_import_override
test_analysis_resolves_module_import_from_override
test_sequential_analyses_are_isolated
test::test_summary
