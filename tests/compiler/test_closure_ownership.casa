import "std" as std
import "../../lib/test.casa" as test
import "helpers.casa" as helpers

pub struct Tracked {
    pub drops: ptr
    pub value: i64
}

impl Tracked {
    pub fn new drops:ptr value:i64 -> Tracked { value drops Tracked }

    pub fn read self:$Tracked -> i64 { self.value }

    pub fn drop self:mut$Tracked {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

pub fn drop_count drops:ptr -> i64 {
    unsafe { drops load64 (i64) }
}

pub fn test_borrowed_capture_keeps_owner_live {
    "borrowed_capture_keeps_owner_live" test::test_start
    unsafe { 8 alloc = drops }
    unsafe { 0 drops store64 }
    41 drops Tracked::new = owner
    { owner.read } = read_owner

    "first call" 41 read_owner exec test::assert_eq
    "second call" 41 read_owner exec test::assert_eq
    read_owner drop
    "closure does not destroy borrowed capture" 0 drops drop_count test::assert_eq
    owner drop
    "owner is destroyed once" 1 drops drop_count test::assert_eq
    unsafe { drops free }
}

pub fn test_moving_capture_is_destroyed_with_closure {
    "moving_capture_is_destroyed_with_closure" test::test_start
    unsafe { 8 alloc = drops }
    unsafe { 0 drops store64 }
    42 drops Tracked::new = owner
    move { owner.read } = read_owner

    "first call" 42 read_owner exec test::assert_eq
    "second call" 42 read_owner exec test::assert_eq
    "capture stays live" 0 drops drop_count test::assert_eq
    read_owner drop
    "closure destroys owned capture once" 1 drops drop_count test::assert_eq
    unsafe { drops free }
}

pub fn test_moving_capture_can_be_restored {
    "moving_capture_can_be_restored" test::test_start
    unsafe { 8 alloc = drops }
    unsafe { 0 drops store64 }
    1 drops Tracked::new = owner
    move {
        owner drop
        1 drops Tracked::new = owner
        owner.read
    } = replace_owner

    "first call" 1 replace_owner exec test::assert_eq
    "first replacement" 1 drops drop_count test::assert_eq
    "second call" 1 replace_owner exec test::assert_eq
    "second replacement" 2 drops drop_count test::assert_eq
    replace_owner drop
    "last capture is destroyed" 3 drops drop_count test::assert_eq
    unsafe { drops free }
}

pub fn test_immediate_borrowed_closure_reclaims_record {
    "immediate_borrowed_closure_reclaims_record" test::test_start
    unsafe { 8 alloc = drops }
    unsafe { 0 drops store64 }
    7 drops Tracked::new = owner
    # Two header words plus one captured value and its active flag.
    unsafe { 32 alloc = available_record }
    unsafe { available_record free }
    { owner.read } exec drop
    unsafe { 32 alloc = reused_record }
    "immediate call reclaims closure record" available_record reused_record
    == test::assert_true
    unsafe { reused_record free }
    "immediate call keeps capture live" 0 drops drop_count test::assert_eq
    owner drop
    "capture owner is destroyed once" 1 drops drop_count test::assert_eq
    unsafe { drops free }
}

pub fn test_copy_capture_keeps_mutable_state {
    "copy_capture_keeps_mutable_state" test::test_start
    0 = count
    {
        1 += count
        count
    } = next
    "first call" 1 next exec test::assert_eq
    "second call" 2 next exec test::assert_eq
}
test_borrowed_capture_keeps_owner_live
test_moving_capture_is_destroyed_with_closure
test_moving_capture_can_be_restored
test_immediate_borrowed_closure_reclaims_record
test_copy_capture_keeps_mutable_state
test::test_summary
