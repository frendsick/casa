import "std"
import "helpers.casa"

struct Tracked {
    drops: ptr
    value: i64
}

impl Tracked {
    fn new drops:ptr value:i64 -> Tracked { value drops Tracked }

    fn read self:$Tracked -> i64 { self.value }

    fn drop self:mut$Tracked {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

fn drop_count drops:ptr -> i64 { unsafe { drops load64 (i64) } }

fn test_borrowed_capture_keeps_owner_live {
    "borrowed_capture_keeps_owner_live" test_start
    unsafe { 8 alloc = drops }
    unsafe { 0 drops store64 }
    41 drops Tracked::new = owner
    { owner.read } = read_owner

    "first call" 41 read_owner exec assert_eq
    "second call" 41 read_owner exec assert_eq
    read_owner drop
    "closure does not destroy borrowed capture" 0 drops drop_count assert_eq
    owner drop
    "owner is destroyed once" 1 drops drop_count assert_eq
    unsafe { drops free }
}

fn test_moving_capture_is_destroyed_with_closure {
    "moving_capture_is_destroyed_with_closure" test_start
    unsafe { 8 alloc = drops }
    unsafe { 0 drops store64 }
    42 drops Tracked::new = owner
    move { owner.read } = read_owner

    "first call" 42 read_owner exec assert_eq
    "second call" 42 read_owner exec assert_eq
    "capture stays live" 0 drops drop_count assert_eq
    read_owner drop
    "closure destroys owned capture once" 1 drops drop_count assert_eq
    unsafe { drops free }
}

fn test_moving_capture_can_be_restored {
    "moving_capture_can_be_restored" test_start
    unsafe { 8 alloc = drops }
    unsafe { 0 drops store64 }
    1 drops Tracked::new = owner
    move {
        owner drop
        1 drops Tracked::new = owner
        owner.read
    } = replace_owner

    "first call" 1 replace_owner exec assert_eq
    "first replacement" 1 drops drop_count assert_eq
    "second call" 1 replace_owner exec assert_eq
    "second replacement" 2 drops drop_count assert_eq
    replace_owner drop
    "last capture is destroyed" 3 drops drop_count assert_eq
    unsafe { drops free }
}

fn test_immediate_borrowed_closures_do_not_destroy_capture {
    "immediate_borrowed_closures_do_not_destroy_capture" test_start
    unsafe { 8 alloc = drops }
    unsafe { 0 drops store64 }
    7 drops Tracked::new = owner
    0 (u64) = index
    while index 1000 > do
        { owner.read } exec drop
        1 += index
    done
    "immediate calls keep capture live" 0 drops drop_count assert_eq
    owner drop
    "capture owner is destroyed once" 1 drops drop_count assert_eq
    unsafe { drops free }
}

fn test_copy_capture_keeps_mutable_state {
    "copy_capture_keeps_mutable_state" test_start
    0 = count
    {
        1 += count
        count
    } = next
    "first call" 1 next exec assert_eq
    "second call" 2 next exec assert_eq
}

test_borrowed_capture_keeps_owner_live
test_moving_capture_is_destroyed_with_closure
test_moving_capture_can_be_restored
test_immediate_borrowed_closures_do_not_destroy_capture
test_copy_capture_keeps_mutable_state
test_summary
