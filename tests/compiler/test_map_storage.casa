import "std"
import "../../lib/test.casa" as test

pub struct CollidingKey {
    pub value: i64
    pub hash:  i64
}

impl CollidingKey: std::Hashable {
    pub fn eq self:$CollidingKey other:$CollidingKey -> bool { self.value other.value == }

    pub fn hash self:$CollidingKey -> i64 { self.hash }
}

impl CollidingKey: std::Clone {
    pub fn clone self:$CollidingKey -> CollidingKey { self.hash self.value CollidingKey }
}

pub struct ByteKey {
    value: u8
}

impl ByteKey: std::Hashable {
    pub fn eq self:$ByteKey other:$ByteKey -> bool { self.value other.value == }

    pub fn hash self:$ByteKey -> i64 { self.value i64::from }
}

pub struct EmptyKey {
}

impl EmptyKey: std::Hashable {
    pub fn eq self:$EmptyKey other:$EmptyKey -> bool { self drop other drop true }

    pub fn hash self:$EmptyKey -> i64 { self drop 0 }
}

fn make_key value:i64 -> CollidingKey {
    # Colliding bucket chains include zero, negative, and high-bit-only hashes.
    value 4 % match
        0 => 0
        1 => -1
        2 => -9223372036854775808
        _ => 1
    end
    value CollidingKey
}

fn check_contents entries:$std::Map[CollidingKey i64] expected:$std::List[std::Option[i64]] {
    0 = index: u64
    0 = count: u64
    while index expected.length < do
        index i64::try_from.unwrap make_key = key
        if index expected.get copy std::Option::Some(value) is then
            "lookup survives deletion" value key entries.get_copy.unwrap test::assert_eq
            1 += count
        else
            "removed key stays absent" key entries.has ! test::assert_true
        fi
        1 += index
    done
    "length matches contents" count entries.length test::assert_eq
    "iteration visits every entry" count entries.iter.count test::assert_eq
    "key iteration visits every entry" count entries.iter_keys.count test::assert_eq
    for pair in entries.iter do
        pair.first.value u64::try_from.unwrap expected.get copy.unwrap = value
        "iterator borrows correct value" value pair.second test::assert_eq
    done
}
"colliding entries survive growth and slot reuse" test::test_start
std::Map[CollidingKey i64]::new = entries
std::List[std::Option[i64]]::new = expected
0 = value
while value 64 < do
    value value make_key entries.set
    value std::Option::Some expected.push
    1 += value
done
expected entries check_contents
0 = round
while round 128 < do
    round 13 * 64 % = removed_key
    removed_key u64::try_from.unwrap = removed_index
    removed_index expected.get copy = previous
    if previous std::Option::Some(previous_value) is then
        "removal returns the expected owner" previous_value removed_key make_key entries.remove.unwrap test::assert_eq
    else
        "absent removal" removed_key make_key entries.remove.is_none test::assert_true
    fi
    std::Option[i64]::None removed_index expected.set
    expected entries check_contents

    round 7 * 64 % = inserted_key
    round inserted_key make_key entries.set
    round std::Option::Some inserted_key u64::try_from.unwrap expected.set
    if inserted_key make_key entries.get_mut std::Option::Some(stored) is then
        unsafe { round 1 + u64::wrapping_from stored ptr::from_ref store64 }
    fi
    round 1 + std::Option::Some inserted_key u64::try_from.unwrap expected.set
    expected entries check_contents
    1 += round
done
entries.clone = cloned
entries drop
expected cloned check_contents
"Set growth and removal reuse Map entries" test::test_start
std::Set[CollidingKey]::new = keys
for key in cloned.iter_keys do
    key.clone keys.add
done
"Set length matches Map" cloned.length keys.length test::assert_eq
"Set iteration visits each key" cloned.length keys.iter.count test::assert_eq
for key in cloned.iter_keys do
    "Set contains inserted key" key keys.has test::assert_true
    key keys.remove
done
"all Set keys removed" keys.is_empty test::assert_true
for key in cloned.iter_keys do
    key.clone keys.add
done
"Set reinsertion preserves count" cloned.length keys.length test::assert_eq
cloned drop
"empty inline values" test::test_start
std::Map[EmptyKey std::Unit]::new = units
std::Unit::Value EmptyKey units.set
"unit value lookup" EmptyKey units.has test::assert_true
std::Unit::Value EmptyKey units.set
"unit count" 1 units.length test::assert_eq
"unit removal" EmptyKey units.remove.is_some test::assert_true
"unit map is empty" units.is_empty test::assert_true
"narrow keys and owned values" test::test_start
std::Map[ByteKey std::String]::new = narrow
0 = byte: u8
while byte 96 < do
    byte i64::from.to_str byte ByteKey narrow.set
    1 += byte
done
0 = byte: u8
while byte 96 < do
    "narrow key value" byte i64::from.to_str byte ByteKey narrow.get.unwrap test::assert_str_eq
    "narrow key removal" byte i64::from.to_str byte ByteKey narrow.remove.unwrap test::assert_str_eq
    1 += byte
done
"borrowed String operations reuse removed slots" test::test_start
std::Map[std::String std::String]::new = words
0 = round
while round 3 < do
    0 = index
    while index 64 < do
        f"value{index}" f"key{index}" words.set
        1 += index
    done
    0 = index
    while index 64 < do
        f"key{index}" = key
        "!" key.as_str words
            .get_mut_str
            .unwrap
            .append
        "borrowed lookup after mutation" f"value{index}!" key.as_str words.get_str.unwrap test::assert_str_eq
        "borrowed removal transfers owned text" f"value{index}!" key.as_str words.remove_str.unwrap test::assert_str_eq
        1 += index
    done
    "all String entries removed" words.is_empty test::assert_true
    "empty String iterator" 0 words.iter.count test::assert_eq
    1 += round
done
test::test_summary
