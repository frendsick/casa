# Paths for compiler tests that create real files.
#
# test_compiler.sh sets TMPDIR to a private directory for each run. Direct
# execution uses the caller's TMPDIR or /tmp, so concurrent direct runs without
# a private TMPDIR still share these paths.
import "../../lib/std.casa" as std
import "../../lib/os.casa" as os

pub fn path name:$str -> std::String {
    "TMPDIR" os::env::get match
        std::Option::Some(directory) => directory
            .to_str
            .unwrap
            .as_str name os::path::join
        std::Option::None => "/tmp" name os::path::join
    end
}
