import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

const EVH_COLOR_ENUM "enum Color { Red Green Blue }\n"
const EVH_DIRECTION_ENUM "enum Direction { North South East West }\n"

# ============================================================================
# Helpers
# ============================================================================

pub fn tc_evh code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops helpers::type_check_ops_for_test
}

# ============================================================================
# Bare variant hint tests
# ============================================================================

pub fn test_bare_variant_produces_type_mismatch {
    error::Diagnostics::new = diagnostics
    "bare_variant_produces_type_mismatch" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Green match\n    Color::Red => 1\n    Green => 2\n    Color::Blue => 3\nend\n" tc_evh drop
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "type mismatch" common::ErrorKind::TypeMismatch helpers::assert_error_kind
}

pub fn test_bare_variant_hint_contains_qualified_name {
    error::Diagnostics::new = diagnostics
    "bare_variant_hint_contains_qualified_name" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Green match\n    Color::Red => 1\n    Green => 2\n    Color::Blue => 3\nend\n" tc_evh drop
    diagnostics "has Did you mean" "Did you mean `Color::Green`?" helpers::assert_error_contains
}

pub fn test_bare_variant_first_arm {
    error::Diagnostics::new = diagnostics
    "bare_variant_first_arm" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Red => 1\n    Color::Green => 2\n    Color::Blue => 3\nend\n" tc_evh drop
    diagnostics "has type mismatch" common::ErrorKind::TypeMismatch helpers::assert_error_kind
    diagnostics "has hint" "Did you mean `Color::Red`?" helpers::assert_error_contains
}

pub fn test_bare_variant_last_arm {
    error::Diagnostics::new = diagnostics
    "bare_variant_last_arm" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Color::Red => 1\n    Color::Green => 2\n    Blue => 3\nend\n" tc_evh drop
    diagnostics "has type mismatch" common::ErrorKind::TypeMismatch helpers::assert_error_kind
    diagnostics "has hint" "Did you mean `Color::Blue`?" helpers::assert_error_contains
}

pub fn test_bare_variant_not_in_any_enum_no_hint {
    error::Diagnostics::new = diagnostics
    "bare_variant_not_in_any_enum_no_hint" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Color::Red => 1\n    Foo => 2\n    Color::Blue => 3\nend\n" tc_evh drop
    diagnostics "has errors" helpers::assert_has_errors
    # Should NOT contain "Did you mean" since Foo is not a variant of Color
    "no hint for unknown name" diagnostics "Did you mean" helpers::typecheck_error_contains ! test::assert_true
}

pub fn test_all_bare_variants_errors_on_first {
    error::Diagnostics::new = diagnostics
    "all_bare_variants_errors_on_first" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Red => 1\n    Green => 2\n    Blue => 3\nend\n" tc_evh drop
    diagnostics "has type mismatch" common::ErrorKind::TypeMismatch helpers::assert_error_kind
    diagnostics "has hint for Red" "Did you mean `Color::Red`?" helpers::assert_error_contains
}

pub fn test_bare_variant_from_different_enum_no_hint {
    error::Diagnostics::new = diagnostics
    "bare_variant_from_different_enum_no_hint" test::test_start
    diagnostics "enum Color { Red Green Blue }\nenum Direction { North South East West }\nColor::Red match\n    Color::Red => 1\n    North => 2\n    Color::Blue => 3\nend\n" tc_evh drop
    diagnostics "has errors" helpers::assert_has_errors
    # Should NOT contain "Did you mean" since North is from Direction, not Color
    "no hint for different enum" diagnostics "Did you mean" helpers::typecheck_error_contains ! test::assert_true
}

# ============================================================================
# Qualified variants still work
# ============================================================================

pub fn test_qualified_match_all_arms {
    error::Diagnostics::new = diagnostics
    "qualified_match_all_arms" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Color::Red => 1\n    Color::Green => 2\n    Color::Blue => 3\nend\ndrop\n" tc_evh drop
    "passes" true test::assert_true
}

pub fn test_qualified_match_with_function {
    error::Diagnostics::new = diagnostics
    "qualified_match_with_function" test::test_start
    diagnostics "enum Color { Red Green Blue }\nfn color_val c:Color -> i64 {\n    c match\n        Color::Red => 0\n        Color::Green => 1\n        Color::Blue => 2\n    end\n}\nColor::Green color_val\ndrop\n" tc_evh drop
    "passes" true test::assert_true
}

# ============================================================================
# Wildcard still works
# ============================================================================

pub fn test_wildcard_covers_remaining {
    error::Diagnostics::new = diagnostics
    "wildcard_covers_remaining" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Color::Red => 1\n    _ => 0\nend\ndrop\n" tc_evh drop
    "passes" true test::assert_true
}

pub fn test_wildcard_with_one_explicit_arm {
    error::Diagnostics::new = diagnostics
    "wildcard_with_one_explicit_arm" test::test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Green match\n    Color::Red => 1\n    _ => 0\nend\ndrop\n" tc_evh drop
    "passes" true test::assert_true
}

# ============================================================================
# Run all tests
# ============================================================================
test_bare_variant_produces_type_mismatch
test_bare_variant_hint_contains_qualified_name
test_bare_variant_first_arm
test_bare_variant_last_arm
test_bare_variant_not_in_any_enum_no_hint
test_all_bare_variants_errors_on_first
test_bare_variant_from_different_enum_no_hint
test_qualified_match_all_arms
test_qualified_match_with_function
test_wildcard_covers_remaining
test_wildcard_with_one_explicit_arm
test::test_summary
