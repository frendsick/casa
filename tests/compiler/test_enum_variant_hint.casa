import "../../compiler/typechecker.casa"
import "helpers.casa"

"enum Color { Red Green Blue }\n" = EVH_COLOR_ENUM
"enum Direction { North South East West }\n" = EVH_DIRECTION_ENUM

# ============================================================================
# Helpers
# ============================================================================

fn tc_evh code:str diagnostics:Diagnostics -> StackEffect {
    diagnostics code parse_resolve_test_source = result
    result ParseResolveResult::ops.unwrap = ops
    result ParseResolveResult::store = store
    diagnostics store Option[Function]::None ops type_check_ops_for_test
}

# ============================================================================
# Bare variant hint tests
# ============================================================================

fn test_bare_variant_produces_type_mismatch {
    Diagnostics::new = diagnostics
    "bare_variant_produces_type_mismatch" test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Green match\n    Color::Red => 1\n    Green => 2\n    Color::Blue => 3\nend\n" tc_evh drop
    diagnostics "has errors" assert_has_errors
    diagnostics "type mismatch" ErrorKind::TypeMismatch assert_error_kind
}

fn test_bare_variant_hint_contains_qualified_name {
    Diagnostics::new = diagnostics
    "bare_variant_hint_contains_qualified_name" test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Green match\n    Color::Red => 1\n    Green => 2\n    Color::Blue => 3\nend\n" tc_evh drop
    diagnostics "has Did you mean" "Did you mean `Color::Green`?" assert_error_contains
}

fn test_bare_variant_first_arm {
    Diagnostics::new = diagnostics
    "bare_variant_first_arm" test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Red => 1\n    Color::Green => 2\n    Color::Blue => 3\nend\n" tc_evh drop
    diagnostics "has type mismatch" ErrorKind::TypeMismatch assert_error_kind
    diagnostics "has hint" "Did you mean `Color::Red`?" assert_error_contains
}

fn test_bare_variant_last_arm {
    Diagnostics::new = diagnostics
    "bare_variant_last_arm" test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Color::Red => 1\n    Color::Green => 2\n    Blue => 3\nend\n" tc_evh drop
    diagnostics "has type mismatch" ErrorKind::TypeMismatch assert_error_kind
    diagnostics "has hint" "Did you mean `Color::Blue`?" assert_error_contains
}

fn test_bare_variant_not_in_any_enum_no_hint {
    Diagnostics::new = diagnostics
    "bare_variant_not_in_any_enum_no_hint" test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Color::Red => 1\n    Foo => 2\n    Color::Blue => 3\nend\n" tc_evh drop
    diagnostics "has errors" assert_has_errors
    # Should NOT contain "Did you mean" since Foo is not a variant of Color
    "no hint for unknown name" diagnostics "Did you mean" typecheck_error_contains ! assert_true
}

fn test_all_bare_variants_errors_on_first {
    Diagnostics::new = diagnostics
    "all_bare_variants_errors_on_first" test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Red => 1\n    Green => 2\n    Blue => 3\nend\n" tc_evh drop
    diagnostics "has type mismatch" ErrorKind::TypeMismatch assert_error_kind
    diagnostics "has hint for Red" "Did you mean `Color::Red`?" assert_error_contains
}

fn test_bare_variant_from_different_enum_no_hint {
    Diagnostics::new = diagnostics
    "bare_variant_from_different_enum_no_hint" test_start
    diagnostics "enum Color { Red Green Blue }\nenum Direction { North South East West }\nColor::Red match\n    Color::Red => 1\n    North => 2\n    Color::Blue => 3\nend\n" tc_evh drop
    diagnostics "has errors" assert_has_errors
    # Should NOT contain "Did you mean" since North is from Direction, not Color
    "no hint for different enum" diagnostics "Did you mean" typecheck_error_contains ! assert_true
}

# ============================================================================
# Qualified variants still work
# ============================================================================

fn test_qualified_match_all_arms {
    Diagnostics::new = diagnostics
    "qualified_match_all_arms" test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Color::Red => 1\n    Color::Green => 2\n    Color::Blue => 3\nend\ndrop\n" tc_evh drop
    "passes" true assert_true
}

fn test_qualified_match_with_function {
    Diagnostics::new = diagnostics
    "qualified_match_with_function" test_start
    diagnostics "enum Color { Red Green Blue }\nfn color_val c:Color -> i64 {\n    c match\n        Color::Red => 0\n        Color::Green => 1\n        Color::Blue => 2\n    end\n}\nColor::Green color_val\ndrop\n" tc_evh drop
    "passes" true assert_true
}

# ============================================================================
# Wildcard still works
# ============================================================================

fn test_wildcard_covers_remaining {
    Diagnostics::new = diagnostics
    "wildcard_covers_remaining" test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Red match\n    Color::Red => 1\n    _ => 0\nend\ndrop\n" tc_evh drop
    "passes" true assert_true
}

fn test_wildcard_with_one_explicit_arm {
    Diagnostics::new = diagnostics
    "wildcard_with_one_explicit_arm" test_start
    diagnostics "enum Color { Red Green Blue }\nColor::Green match\n    Color::Red => 1\n    _ => 0\nend\ndrop\n" tc_evh drop
    "passes" true assert_true
}

# ============================================================================
# Run all tests
# ============================================================================
test_bare_variant_produces_type_mismatch
test_bare_variant_hint_contains_qualified_name
test_bare_variant_first_arm
test_bare_variant_last_arm
test_bare_variant_not_in_any_enum_no_hint
test_all_bare_variants_errors_on_first
test_bare_variant_from_different_enum_no_hint
test_qualified_match_all_arms
test_qualified_match_with_function
test_wildcard_covers_remaining
test_wildcard_with_one_explicit_arm
test_summary
