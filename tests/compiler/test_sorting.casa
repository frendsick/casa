import "std" as std
import "../../lib/test.casa" as test

struct Entry {
    key:   i64
    order: i64
}

fn entry_precedes first:$Entry second:$Entry -> bool { first.key second.key < }

# List::reverse
"reverse basic" test::test_start
[1, 2, 3, 4, 5] std::List::from_array = rev_basic
rev_basic.reverse
"length" 5 rev_basic.length test::assert_eq
"first" 5 0 rev_basic.get test::assert_eq
"second" 4 1 rev_basic.get test::assert_eq
"last" 1 4 rev_basic.get test::assert_eq
"reverse empty" test::test_start
std::List[i64]::new = rev_empty
rev_empty.reverse
"length" 0 rev_empty.length test::assert_eq
"reverse single" test::test_start
[42] std::List::from_array = rev_single
rev_single.reverse
"value" 42 0 rev_single.get test::assert_eq
"reverse two" test::test_start
[1, 2] std::List::from_array = rev_two
rev_two.reverse
"first" 2 0 rev_two.get test::assert_eq
"second" 1 1 rev_two.get test::assert_eq
"reverse double" test::test_start
[1, 2, 3] std::List::from_array = rev_double
rev_double.reverse
rev_double.reverse
"first" 1 0 rev_double.get test::assert_eq
"second" 2 1 rev_double.get test::assert_eq
"third" 3 2 rev_double.get test::assert_eq

# List::sort
"sort basic" test::test_start
[5, 3, 1, 4, 2] std::List::from_array = sort_basic
sort_basic.sort
"length" 5 sort_basic.length test::assert_eq
"first" 1 0 sort_basic.get test::assert_eq
"second" 2 1 sort_basic.get test::assert_eq
"third" 3 2 sort_basic.get test::assert_eq
"fourth" 4 3 sort_basic.get test::assert_eq
"fifth" 5 4 sort_basic.get test::assert_eq
"sort empty" test::test_start
std::List[i64]::new = sort_empty
sort_empty.sort
"length" 0 sort_empty.length test::assert_eq
"sort single" test::test_start
[42] std::List::from_array = sort_single
sort_single.sort
"value" 42 0 sort_single.get test::assert_eq
"sort already sorted" test::test_start
[1, 2, 3, 4, 5] std::List::from_array = sort_sorted
sort_sorted.sort
"first" 1 0 sort_sorted.get test::assert_eq
"last" 5 4 sort_sorted.get test::assert_eq
"sort reverse sorted" test::test_start
[5, 4, 3, 2, 1] std::List::from_array = sort_rev
sort_rev.sort
"first" 1 0 sort_rev.get test::assert_eq
"last" 5 4 sort_rev.get test::assert_eq
"sort duplicates" test::test_start
[3, 1, 4, 1, 5, 9, 2, 6, 5, 3] std::List::from_array = sort_dups
sort_dups.sort
"length" 10 sort_dups.length test::assert_eq
"first" 1 0 sort_dups.get test::assert_eq
"second" 1 1 sort_dups.get test::assert_eq
"third" 2 2 sort_dups.get test::assert_eq
"last" 9 9 sort_dups.get test::assert_eq
"sort all same" test::test_start
[7, 7, 7, 7] std::List::from_array = sort_same
sort_same.sort
"first" 7 0 sort_same.get test::assert_eq
"last" 7 3 sort_same.get test::assert_eq
"sort two elements" test::test_start
[2, 1] std::List::from_array = sort_two
sort_two.sort
"first" 1 0 sort_two.get test::assert_eq
"second" 2 1 sort_two.get test::assert_eq

# List::sort_by
"sort_by descending" test::test_start
[5, 3, 1, 4, 2] std::List::from_array = sortby_desc
{ < } sortby_desc.sort_by
"first" 5 0 sortby_desc.get test::assert_eq
"second" 4 1 sortby_desc.get test::assert_eq
"last" 1 4 sortby_desc.get test::assert_eq
"sort_by ascending" test::test_start
[5, 3, 1, 4, 2] std::List::from_array = sortby_asc
{ > } sortby_asc.sort_by
"first" 1 0 sortby_asc.get test::assert_eq
"last" 5 4 sortby_asc.get test::assert_eq
"sort_by empty" test::test_start
std::List[i64]::new = sortby_empty
{ > } sortby_empty.sort_by
"length" 0 sortby_empty.length test::assert_eq
"sort_by single" test::test_start
[42] std::List::from_array = sortby_single
{ > } sortby_single.sort_by
"value" 42 0 sortby_single.get test::assert_eq
"sort_by duplicates" test::test_start
[3, 1, 4, 1, 5] std::List::from_array = sortby_dups
{ > } sortby_dups.sort_by
"first" 1 0 sortby_dups.get test::assert_eq
"second" 1 1 sortby_dups.get test::assert_eq
"last" 5 4 sortby_dups.get test::assert_eq
"sort_by stable" test::test_start
std::List[Entry]::new = stable
[2, 1, 2, 1, 0, 2, 1] std::List::from_array = stable_keys
0 = stable_index: u64
0 = stable_order: i64
while stable_index stable_keys.length < do
    stable_order stable_index stable_keys.get copy Entry stable.push
    1 += stable_index
    1 += stable_order
done
&entry_precedes stable.sort_by
[4, 1, 3, 6, 0, 2, 5] std::List::from_array = stable_expected
0 = stable_check: u64
while stable_check stable_expected.length < do
    "order" stable_check stable.get.order stable_check stable_expected.get test::assert_eq
    1 += stable_check
done
"sort many equal keys" test::test_start
std::List[i64]::new = many_equal
0 = many_index: u64
while 20000 many_index > do
    7 many_equal.push
    1 += many_index
done
many_equal.sort
"length" 20000 many_equal.length test::assert_eq
"last" 7 19999 many_equal.get test::assert_eq
"sort_by_range subrange" test::test_start
[9, 5, 3, 4, 1, 0] std::List::from_array = range_list
{ > } 4 1 range_list.sort_by_range
"before" 9 0 range_list.get test::assert_eq
"low" 1 1 range_list.get test::assert_eq
"middle" 4 3 range_list.get test::assert_eq
"high" 5 4 range_list.get test::assert_eq
"after" 0 5 range_list.get test::assert_eq

# List::swap_at
"swap_at" test::test_start
[10, 20, 30] std::List::from_array = swap_list
0 1 swap_list.swap_at
"first" 20 0 swap_list.get test::assert_eq
"second" 10 1 swap_list.get test::assert_eq
"third" 30 2 swap_list.get test::assert_eq

# List::bisect
"bisect middle" test::test_start
[1, 3, 5, 7, 9] std::List::from_array = bisect_list
{ copy 4 > } bisect_list.bisect = result
"index" 2 result test::assert_eq
"bisect before all" test::test_start
{ copy 0 > } bisect_list.bisect = result
"index" 0 result test::assert_eq
"bisect after all" test::test_start
{ copy 10 > } bisect_list.bisect = result
"index" 5 result test::assert_eq
"bisect exact match" test::test_start
{ copy 5 > } bisect_list.bisect = result
"index" 3 result test::assert_eq
"bisect empty list" test::test_start
std::List[i64]::new = empty_list
{ copy 1 > } empty_list.bisect = result
"index" 0 result test::assert_eq
test::test_summary
