# ============================================================================

pub fn test_tc_annotation_int {
    error::Diagnostics::new = diagnostics
    "tc_annotation_int" test::test_start
    diagnostics "42 = x:i64 x" tc_code = sig
    "return type" "i64" 0 sig common::StackEffect::return_types.get.format test::assert_str_eq
}

