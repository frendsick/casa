pub fn assert_cast_rejected_as_unknown_type
    source:str
    expected_type:str
    diagnostics:mut$error::Diagnostics
{
    global TYPE_ANNOTATION_TEST_STORE
    diagnostics source helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops typechecker::check_ops drop
    store = TYPE_ANNOTATION_TEST_STORE
    diagnostics "has errors" helpers::assert_has_errors
    diagnostics "syntax error" common::ErrorKind::Syntax helpers::assert_error_kind
    diagnostics "type message" f"type `{expected_type}` does not exist".as_str helpers::assert_error_contains
}

pub fn test_tc_reject_unknown_cast {
    error::Diagnostics::new = diagnostics
    "tc_reject_unknown_cast" test::test_start
    diagnostics "foo" "42 (foo)" assert_cast_rejected_as_unknown_type
}

pub fn test_tc_reject_unknown_uppercase_cast {
    error::Diagnostics::new = diagnostics
    "tc_reject_unknown_uppercase_cast" test::test_start
    diagnostics "T" "42 (T)" assert_cast_rejected_as_unknown_type
}

pub fn test_tc_reject_unknown_generic_param_cast {
    error::Diagnostics::new = diagnostics
    "tc_reject_unknown_generic_param_cast" test::test_start
    diagnostics "List[Foo]" "42 (List[Foo])" assert_cast_rejected_as_unknown_type
}

