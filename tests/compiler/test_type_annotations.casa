import "std" as std
import "../../compiler/common.casa" as common
import "../../compiler/error.casa" as error
import "../../lib/test.casa" as test
import "../../compiler/typechecker.casa" as typechecker
import "helpers.casa" as helpers

# ============================================================================
# Constants
# ============================================================================
"enum Option[T] { None Some(T) }\n" = OPTION_ENUM
common::symbol_store_new = TYPE_ANNOTATION_TEST_STORE

# ============================================================================
# Helpers
# ============================================================================

pub fn test_parse code:$str diagnostics:mut$error::Diagnostics -> std::List[common::Op] {
    global TYPE_ANNOTATION_TEST_STORE
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    store = TYPE_ANNOTATION_TEST_STORE
    ops
}

pub fn tc_code code:$str diagnostics:mut$error::Diagnostics -> common::StackEffect {
    global TYPE_ANNOTATION_TEST_STORE
    diagnostics code helpers::parse_resolve_test_parts = store = ops
    diagnostics store std::Option[common::Function]::None ops typechecker::check_ops = effect
    store = TYPE_ANNOTATION_TEST_STORE
    effect
}

pub fn find_assign_ops ops:$std::List[common::Op] -> std::List[common::Op] {
    std::List[common::Op]::new = result
    0 (u64) = index
    while index ops.length > do
        index ops.get = op
        if op.value common::OpValue::AssignVar is then
            op.clone result.push
        fi
        1 += index
    done
    result
}

pub fn find_ops_by_kind ops:$std::List[common::Op] kind:common::OpValue -> std::List[common::Op] {
    std::List[common::Op]::new = result
    0 (u64) = index
    while index ops.length > do
        index ops.get = op
        if op.value kind == then
            op.clone result.push
        fi
        1 += index
    done
    result
}

# ============================================================================
# Parser tests: annotation parsing
# ============================================================================

pub fn test_annotation_int {
    error::Diagnostics::new = diagnostics
    "annotation_int" test::test_start
    diagnostics "42 = x:i64" test_parse = ops
    ops find_assign_ops = assigns
    "count" 1 assigns.length test::assert_eq
    "name" "x" 0 assigns.get common::op_str_value test::assert_str_eq
    "annotation" "i64" common::parse_type_str 0 assigns.get common::Op::type_hint
        .clone
        .unwrap
        .eq test::assert_true
}

pub fn test_annotation_str {
    error::Diagnostics::new = diagnostics
    "annotation_str" test::test_start
    diagnostics "\"hello\" = x:str" test_parse = ops
    ops find_assign_ops = assigns
    "annotation" "str" common::parse_type_str 0 assigns.get common::Op::type_hint
        .clone
        .unwrap
        .eq test::assert_true
}

