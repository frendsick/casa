fn assert_cast_rejected_as_unknown_type source:str expected_type:str diagnostics:mut$Diagnostics {
    global TYPE_ANNOTATION_TEST_STORE
    diagnostics source parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops check_ops drop
    store = TYPE_ANNOTATION_TEST_STORE
    diagnostics "has errors" assert_has_errors
    diagnostics "syntax error" ErrorKind::Syntax assert_error_kind
    diagnostics "type message" f"type `{expected_type}` does not exist".as_str assert_error_contains
}

fn test_tc_reject_unknown_cast {
    Diagnostics::new = diagnostics
    "tc_reject_unknown_cast" test_start
    diagnostics "foo" "42 (foo)" assert_cast_rejected_as_unknown_type
}

