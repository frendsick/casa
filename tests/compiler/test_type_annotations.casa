    "annotation empty" 0 assigns.get common::Op::type_hint.is_none test::assert_true
}

pub fn test_annotation_in_function {
    error::Diagnostics::new = diagnostics
    "annotation_in_function" test::test_start
    diagnostics "fn foo { 42 = x:i64 x drop }" test_parse drop
    "foo" TYPE_ANNOTATION_TEST_STORE.get_function.unwrap = function
    function common::Function::ops find_assign_ops = assigns
    false = found
    0 (u64) = index
    while index assigns.length > do
        index assigns.get = op
        if
            "x" op common::op_str_value ==
            "i64" common::parse_type_str op common::Op::type_hint
                .clone
                .unwrap
                .eq &&
        then
            true = found
        fi
        1 += index
    done
    "found x:i64" found test::assert_true
}

