pub fn test_no_annotation_on_increment {
    error::Diagnostics::new = diagnostics
    "no_annotation_on_increment" test::test_start
    diagnostics "42 = x 1 += x" test_parse = ops
    "".to_str common::OpValue::AssignInc ops find_ops_by_kind = inc_ops
    "count" 1 inc_ops.length test::assert_eq
    "annotation empty" 0 inc_ops.get common::Op::type_hint.is_none test::assert_true
}

pub fn test_no_annotation_on_decrement {
