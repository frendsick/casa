import "../../compiler/typechecker.casa"
import "helpers.casa"

# ============================================================================
# Constants
# ============================================================================
"enum Option[T] { None Some(T) }\n" = OPTION_ENUM
symbol_store_new = TYPE_ANNOTATION_TEST_STORE

# ============================================================================
# Helpers
# ============================================================================

fn test_parse code:$str diagnostics:mut$Diagnostics -> List[Op] {
    global TYPE_ANNOTATION_TEST_STORE
    diagnostics code parse_resolve_test_parts = store = ops
    store = TYPE_ANNOTATION_TEST_STORE
    ops
}

fn tc_code code:$str diagnostics:mut$Diagnostics -> StackEffect {
    global TYPE_ANNOTATION_TEST_STORE
    diagnostics code parse_resolve_test_parts = store = ops
    diagnostics store Option[Function]::None ops check_ops = effect
    store = TYPE_ANNOTATION_TEST_STORE
    effect
}

fn find_assign_ops ops:$List[Op] -> List[Op] {
    List[Op]::new = result
    0 (u64) = index
    while index ops.length > do
        index ops.get = op
        if op.value OpValue::AssignVar is then
            op.clone result.push
        fi
        1 += index
    done
    result
}

fn find_ops_by_kind ops:$List[Op] kind:OpValue -> List[Op] {
    List[Op]::new = result
    0 (u64) = index
    while index ops.length > do
        index ops.get = op
        if op.value kind == then
            op.clone result.push
        fi
        1 += index
    done
    result
}

# ============================================================================
# Parser tests: annotation parsing
# ============================================================================

fn test_annotation_int {
    Diagnostics::new = diagnostics
    "annotation_int" test_start
    diagnostics "42 = x:i64" test_parse = ops
    ops find_assign_ops = assigns
    "count" 1 assigns.length assert_eq
    "name" "x" 0 assigns.get op_str_value assert_str_eq
    "annotation" "i64" parse_type_str 0 assigns.get Op::type_hint
        .clone
        .unwrap
        .eq assert_true
}

fn test_annotation_str {
    Diagnostics::new = diagnostics
    "annotation_str" test_start
    diagnostics "\"hello\" = x:str" test_parse = ops
    ops find_assign_ops = assigns
    "annotation" "str" parse_type_str 0 assigns.get Op::type_hint
        .clone
        .unwrap
        .eq assert_true
}

