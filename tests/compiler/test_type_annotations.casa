fn test_no_annotation {
    Diagnostics::new = diagnostics
    "no_annotation" test_start
    diagnostics "42 = x" test_parse = ops
    ops find_assign_ops = assigns
    "count" 1 assigns.length assert_eq
    "name" "x" 0 assigns.get op_str_value assert_str_eq
    "annotation empty" 0 assigns.get Op::type_hint.is_none assert_true
}

fn test_annotation_in_function {
    Diagnostics::new = diagnostics
    "annotation_in_function" test_start
    diagnostics "fn foo { 42 = x:i64 x drop }" test_parse drop
    "foo" TYPE_ANNOTATION_TEST_STORE
        .functions
        .get_str
        .unwrap = function
    function Function::ops find_assign_ops = assigns
    false = found
    0 (u64) = index
    while index assigns.length > do
        index assigns.get = op
        if
            "x" op op_str_value ==
            "i64" parse_type_str op Op::type_hint
                .clone
                .unwrap
                .eq &&
        then
            true = found
        fi
        1 += index
    done
    "found x:i64" found assert_true
}

