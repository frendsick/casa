import "std"
import "../../lib/test.casa" as test

const MAX_INDEX: u64 0xFFFFFFFFFFFFFFFF

fn test_empty_access {
    "empty_indexed_access" test::test_start
    std::List[i64]::new = values
    [] = array_values: array[i64 0]
    std::Bytes::new = bytes
    values.as_slice = view
    [0, 1, MAX_INDEX] = indices: array[u64 3]
    for index in indices.iter do
        "empty list read" index copy values.get.is_none test::assert_true
        "empty array read" index copy array_values.get.is_none test::assert_true
        "empty view read" index copy view.get.is_none test::assert_true
        "empty byte read" index copy bytes.get.is_none test::assert_true
    done
    "empty list mutable read" 0 values.get_mut.is_none test::assert_true
    "empty list pop" values.pop.is_none test::assert_true
    "equal invalid swap indices" 5 5 values.swap_at.is_none test::assert_true
    "empty swap" 0 0 values.swap_at.is_none test::assert_true
    "empty list unchanged" values.is_empty test::assert_true
}

fn test_read_boundaries {
    "indexed_read_boundaries" test::test_start
    [10, 20] = array_values
    [10, 20] std::List::from_array = values
    "ab" std::Bytes::from_str = bytes
    values.as_slice = view
    "first list element" 10 0 values.get.unwrap test::assert_eq
    "last list element" 20 1 values.get.unwrap test::assert_eq
    "first array element" 10 0 array_values.get.unwrap test::assert_eq
    "last array element" 20 1 array_values.get.unwrap test::assert_eq
    "first view element" 10 0 view.get.unwrap test::assert_eq
    "last view element" 20 1 view.get.unwrap test::assert_eq
    [2, 3, MAX_INDEX] = indices: array[u64 3]
    for index in indices.iter do
        "list missing" index copy values.get.is_none test::assert_true
        "array missing" index copy array_values.get.is_none test::assert_true
        "view missing" index copy view.get.is_none test::assert_true
        "byte missing" index copy bytes.get.is_none test::assert_true
    done
    view drop
    values.as_ptr = storage
    for index in indices.iter do
        "mutable element missing" index copy values.get_mut.is_none test::assert_true
        "invalid equal swap" index copy index copy values.swap_at.is_none test::assert_true
        "invalid first swap" 0 index copy values.swap_at.is_none test::assert_true
        "invalid second swap" index copy 0 values.swap_at.is_none test::assert_true
    done
    "storage unchanged" storage values.as_ptr == test::assert_true
    "length unchanged" 2 values.length test::assert_eq
    "first unchanged" 10 0 values.get.unwrap test::assert_eq
    "last unchanged" 20 1 values.get.unwrap test::assert_eq
    0 values.get_mut.unwrap = first
    unsafe { 11 first ptr::from_ref store64 }
    "mutable read updates element" 11 0 values.get.unwrap test::assert_eq
    "equal valid swap succeeds" 1 1 values.swap_at.is_some test::assert_true
    "swap succeeds" 1 0 values.swap_at.is_some test::assert_true
    "swapped first" 20 0 values.get.unwrap test::assert_eq
    "swapped last" 11 1 values.get.unwrap test::assert_eq
    "pop last" 11 values.pop.unwrap test::assert_eq
    "pop first" 20 values.pop.unwrap test::assert_eq
    "pop exhausted" values.pop.is_none test::assert_true
}

fn test_slice_boundaries {
    "optional_slice_ranges" test::test_start
    [10, 20] = array_values
    [10, 20] std::List::from_array = values
    "ab" std::Bytes::from_str = bytes
    values.as_slice = view
    "whole array" 2 2 0 array_values
        .slice
        .unwrap
        .length test::assert_eq
    "whole list" 2 2 0 values
        .slice
        .unwrap
        .length test::assert_eq
    "whole view" 2 2 0 view
        .slice
        .unwrap
        .length test::assert_eq
    "whole bytes" 2 2 0 bytes
        .slice
        .unwrap
        .length test::assert_eq
    [0, 1, 2] = endpoints: array[u64 3]
    for endpoint in endpoints.iter do
        "empty array range" endpoint copy endpoint copy array_values
            .slice
            .unwrap
            .is_empty test::assert_true
        "empty list range" endpoint copy endpoint copy values
            .slice
            .unwrap
            .is_empty test::assert_true
        "empty view range" endpoint copy endpoint copy view
            .slice
            .unwrap
            .is_empty test::assert_true
        "empty bytes range" endpoint copy endpoint copy bytes
            .slice
            .unwrap
            .is_empty test::assert_true
    done
    [3, MAX_INDEX] = invalid_endpoints: array[u64 2]
    for endpoint in invalid_endpoints.iter do
        "array stop past end" endpoint copy 0 array_values.slice.is_none test::assert_true
        "list stop past end" endpoint copy 0 values.slice.is_none test::assert_true
        "view stop past end" endpoint copy 0 view.slice.is_none test::assert_true
        "bytes stop past end" endpoint copy 0 bytes.slice.is_none test::assert_true
        "array empty past end" endpoint copy endpoint copy array_values.slice.is_none test::assert_true
        "list empty past end" endpoint copy endpoint copy values.slice.is_none test::assert_true
        "view empty past end" endpoint copy endpoint copy view.slice.is_none test::assert_true
        "bytes empty past end" endpoint copy endpoint copy bytes.slice.is_none test::assert_true
    done
    "array reversed range" 0 1 array_values.slice.is_none test::assert_true
    "list reversed range" 0 1 values.slice.is_none test::assert_true
    "view reversed range" 0 1 view.slice.is_none test::assert_true
    "bytes reversed range" 0 1 bytes.slice.is_none test::assert_true
    "empty array range" 0 0 array_values
        .as_slice
        .slice
        .unwrap
        .is_empty test::assert_true
}

struct Item {
    value: i64
    drops: ptr
}

impl Item {
    fn drop self:mut$Item {
        unsafe { self.drops load64 1 + self.drops store64 }
    }
}

fn test_owned_elements {
    "optional_access_preserves_owners" test::test_start
    8 std::RawBuffer::new = counter
    unsafe { 0 counter.data store64 }
    std::List[Item]::new = values
    counter.data 10 Item values.push
    "missing read" 1 values.get.is_none test::assert_true
    "missing mutable read" 1 values.get_mut.is_none test::assert_true
    "failed swap" 1 0 values.swap_at.is_none test::assert_true
    "failed operations preserve owner" 0 unsafe { counter.data load64 } test::assert_eq
    if 0 values.get_mut std::Option::Some(item) is then
        20 = item.value
    fi
    values.pop = removed
    "successful pop empties list" values.is_empty test::assert_true
    values drop
    "pop transfers ownership" 0 unsafe { counter.data load64 } test::assert_eq
    if removed std::Option::Some(item) is then
        "popped owner retains mutation" 20 item.value test::assert_eq
        item drop
    else
        "pop returns an owner" false test::assert_true
    fi
    "popped owner destroyed once" 1 unsafe { counter.data load64 } test::assert_eq
}

fn test_arguments {
    "optional_argument_access" test::test_start
    "program argument exists" 0 std::get_arg.is_some test::assert_true
    "argument at count absent" argc std::get_arg.is_none test::assert_true
    "largest argument absent" MAX_INDEX std::get_arg.is_none test::assert_true
}
test_empty_access
test_read_boundaries
test_slice_boundaries
test_arguments
test_owned_elements
test::test_summary
