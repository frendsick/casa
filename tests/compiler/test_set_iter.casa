import "std"

Set[i64]::new = numbers
2 numbers.add
3 numbers.add
4 numbers.add
0 = total
for number in numbers.iter do
    number += total
done
if 9 total != then
    1 exit
fi
{ 2 * } numbers
    .iter
    .map
    .sum = doubled_total
if 18 doubled_total != then
    1 exit
fi
"2 passed, 0 failed\n" print
