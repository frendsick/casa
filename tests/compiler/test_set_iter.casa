import "std" as std

std::Set[i64]::new = numbers
2 numbers.add
3 numbers.add
4 numbers.add
0 = total
for number in numbers.iter do
    number copy += total
done
if 9 total != then
    1 std::exit
fi
{ copy 2 * } numbers
    .iter
    .map
    .sum = doubled_total
if 18 doubled_total != then
