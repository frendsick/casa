import "std" as std

pub struct CollidingKey derives std::Eq std::Hashable {
    pub value: i64
}

impl CollidingKey: std::Hashable {
    pub fn hash self:$CollidingKey -> i64 { self drop 0 }
}
std::Set[i64]::new = numbers
2 numbers.add
3 numbers.add
4 numbers.add
0 = total
for number in numbers.iter do
    number copy += total
done
if 9 total != then
    1 process::exit
fi
{ copy 2 * } numbers
    .iter
    .map
    .sum = doubled_total
if 18 doubled_total != then
    1 process::exit
fi
std::Set[CollidingKey]::new = colliding
1 CollidingKey colliding.add
-1 CollidingKey colliding.add
if 2 colliding.length != then
    1 process::exit
fi
1 CollidingKey colliding.remove
if -1 CollidingKey colliding.has ! then
