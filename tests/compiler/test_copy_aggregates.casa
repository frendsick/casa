import "std" as std
import "../../lib/test.casa" as test

struct Point derives std::Copy {
    pub x: i64
    pub y: i64
}

struct Box[T] derives std::Copy {
    pub value: T
}

enum Choice[T] derives std::Copy {
    None
    Some(T)
}

fn point x:i64 -> Point { 20 x Point }

fn duplicate [T:std::Copy] value:$T -> T T { value copy dup }

fn identity [T] value:T -> T { value }

fn invoke [T] function:fn[-> T] -> T { function exec }

fn early flag:bool -> Point {
    if flag then
        31 point return
    fi
    32 point
}

fn many -> Point i64 Point { 41 point 99 42 point }

"ordinary Copy values" test::test_start
10 point = original
original = independent
77 = independent.x
"implicit copy is independent" 10 original.x test::assert_eq
original duplicate = second = first
88 = second.y
"dup is independent" 20 first.y test::assert_eq
original 1 over = deeper
"over preserves value" 10 deeper.x test::assert_eq
drop drop
"return preserves body" 31 true early.x test::assert_eq
"ordinary return" 32 false early.x test::assert_eq
many = last = middle = initial
"multiple return first" 41 initial.x test::assert_eq
"multiple return scalar" 99 middle test::assert_eq
"multiple return last" 42 last.x test::assert_eq
{ 51 point } invoke = callable
"callable result" 51 callable.x test::assert_eq
"nested Copy values" test::test_start
original Box = boxed
boxed identity = boxed_copy
91 = boxed_copy.value.x
"generic field copies complete body" 10 boxed.value.x test::assert_eq
boxed Choice::Some = choice
choice duplicate = choice_copy = choice_other
choice_copy match
    Choice::Some(value) => {
        92 = value.value.y
        "nested copy can change" 92 value.value.y test::assert_eq
    }
    Choice::None => "missing copied payload" false test::assert_true
end
choice_other match
    Choice::Some(value) => "nested enum payload remains independent" 20 value.value.y test::assert_eq
    Choice::None => "missing original payload" false test::assert_true
end
"Copy raw storage" test::test_start
unsafe {
    size_of[Box[Point]] alloc = storage
    boxed storage ptr::write[Box[Point]]
    storage ptr::read[Box[Point]] = read
    storage free
    "typed raw round trip" 10 read.value.x test::assert_eq
    boxed ptr::into_raw ptr::from_raw[Box[Point]] = adopted
    "raw ownership round trip" 20 adopted.value.y test::assert_eq
}

struct Holder[T] {
    pub value: T
}

enum Owner[T] {
    Item(T)
}

struct Empty derives std::Copy {
}

struct Narrow derives std::Copy {
    pub small: u8
    pub wide:  i64
}

struct ArrayBox derives std::Copy {
    pub values: array[Point 2]
}

struct View derives std::Copy {
    pub value: $i64
}

fn make_holder -> Holder[Point] { 61 point Holder }

fn make_literal -> Holder[Point] {
    Holder { value: 62 point }
}

fn make_owner -> Owner[Point] { 63 point Owner::Item }

fn make_capture -> fn[-> Point] {
    64 point = value { value }
}

fn clone_owned [T:std::Clone] value:$T -> T { value.clone = result result }

fn shared value:$i64 -> View { value View }

"Copy in affine destinations" test::test_start
make_holder = holder
make_literal = literal
make_owner = owner
99 point drop
"generic owner retains field" 61 holder.value.x test::assert_eq
"generic literal retains field" 62 literal.value.x test::assert_eq
owner match
    Owner::Item(value) => "generic enum retains field" 63 value.x test::assert_eq
end
65 point = replacement
replacement = holder.value
"generic field assignment" 65 holder.value.x test::assert_eq
66 = replacement.x
"generic field assignment is independent" 65 holder.value.x test::assert_eq
std::List[Point]::new = points
original points.push
67 = original.x
"list retains an independent value" 10 0 points.get.x test::assert_eq
make_capture = capture
"returned capture retains value" 64 capture exec.x test::assert_eq
"capture can run again" 64 capture exec.x test::assert_eq
"conditional standard Copy" test::test_start
71 std::Option::Some dup = option_copy = option
"Option clone is unambiguous" 71 option.clone.unwrap test::assert_eq
"Option copy survives consumption" 71 option_copy.unwrap test::assert_eq
72 std::Result[i64 bool]::Ok dup = result_copy = result
"Result copy" 72 result_copy.unwrap test::assert_eq
"Result clone is unambiguous" 72 result.clone.unwrap test::assert_eq
"owned generic clone" 73 73 std::Option::Some clone_owned.unwrap test::assert_eq
"nested generic Copy bound" 74 74 std::Option::Some Box clone_owned.value copy.unwrap test::assert_eq
"complete value layouts" test::test_start
Empty dup drop drop
2 u8::try_from.unwrap 81 swap Narrow dup = narrow_copy = narrow
3 u8::try_from.unwrap = narrow_copy.small
"narrow field copy" 2 u8::try_from.unwrap narrow.small test::assert_eq
"aligned field copy" 81 narrow_copy.wide test::assert_eq
[original, replacement] ArrayBox dup = array_copy = array_original
"array field contains complete values" 66 1 array_copy
    .values
    .nth
    .x test::assert_eq
"array field source remains valid" 67 0 array_original
    .values
    .nth
    .x test::assert_eq
82 = borrowed
borrowed shared dup = view_copy = view
"shared field origins remain usable" 82 view_copy.value test::assert_eq
"shared field original remains usable" 82 view.value test::assert_eq

struct Guarded {
    pub guard: i64
    pub point: Point
}

struct Pair {
    pub x: i64
    pub y: i64
}

struct Tracked {
    pub count: ptr
    pub value: i64
}

impl Tracked {
    fn drop self:mut$Tracked {
        unsafe { self.count load64 1 + self.count store64 }
    }
}

fn capture_owner count:ptr {
    91 count Tracked = owner
    move { owner.value } Box = callback
    "callable field retains capture" 91 callback.value exec test::assert_eq
}
"projected Copy storage belongs to its owner" test::test_start
2 1 Point 16 Guarded = guarded
guarded.point drop
8 9 Pair = pair
"dropping a projection preserves storage" 1 guarded.point.x test::assert_eq
"unrelated allocation remains independent" 9 pair.x test::assert_eq
3 4 Point = guarded.point
"assigning a Copy field preserves its owner" 4 guarded.point.x test::assert_eq
unsafe {
    8 alloc = count
    0 count store64
    count capture_owner
    "callable aggregate remains affine and destroys its capture" 1 count load64 test::assert_eq
    count free
}

struct BorrowView[T] derives std::Copy {
    pub value: $T
}

fn duplicate_view view:$BorrowView[std::String] -> BorrowView[std::String] { view copy }

fn captured_mutation -> fn[-> Point] {
    1 point = value
    move { value = value 77 = value.x value }
}
"shared generic Copy field" test::test_start
"borrowed text".to_str = text
text BorrowView duplicate_view = shared_view
"shared non-Copy referent" 13 shared_view.value.length test::assert_eq
captured_mutation = mutate
"Copy capture mutation persists" 77 mutate exec.x test::assert_eq
"Copy capture remains reusable" 77 mutate exec.x test::assert_eq
test::test_summary
