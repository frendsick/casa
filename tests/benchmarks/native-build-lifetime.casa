import "std" as std
import "os" as os
import "../../compiler/products.casa" as products
import "../../compiler/build.casa" as build

const SIGSTOP 19
const GETPID_SYSCALL 39
const KILL_SYSCALL 62

fn run_builds {
    products::Target::LinuxX86_64
    ".section .text\n.globl _start\n_start:\n movq $60, %rax\n xorq %rdi, %rdi\n syscall\n".to_str
    products::AssemblySource::new = source
    std::List[std::String]::new = libraries
    "/tmp/casa_native_build_lifetime" = output
    "/does/not/exist/native-cc".to_str build::NativeDriver = missing
    if false libraries output source missing.compile_binary std::Result::Error(_) is then
    else
        "Missing native tool succeeded" panic
    fi
    "/bin/false".to_str build::NativeDriver = failing
    if false libraries output source failing.compile_binary std::Result::Error(_) is then
    else
        "Failing native tool succeeded" panic
    fi
    false libraries output source build::NativeDriver::new.compile_binary.unwrap drop
    output.as_cstr.unwrap file::remove.unwrap drop
}

fn stop_for_sample {
    # SAFETY: Signal only the current process. These syscalls pass no pointers.
    unsafe { SIGSTOP GETPID_SYSCALL syscall0 KILL_SYSCALL syscall2 drop }
}
stop_for_sample
0 = iteration
while 30 iteration < do
    run_builds
    stop_for_sample
    1 += iteration
done
