struct Inner {
    value: u16
    flag:  bool
}

struct Nested {
    tag:   u8
    inner: Inner
    tail:  u32
}

fn run iterations:u64 -> u64 {
    0 = checksum: u64
    0 = iteration: u64
    while iterations iteration < do
        Nested { tag: 1 inner: Inner { value: 7 flag: true } tail: 9 } = owner
        if owner.inner.value 7 != owner.inner.flag ! || then
            "initial fields" panic
        fi
        8 = owner.inner.value
        false = owner.inner.flag
        10 = owner.tail
        owner.inner.value u64::from owner.tail u64::from + += checksum
        owner drop
        1 += iteration
    done
    checksum
}
const ITERATIONS: u64 { 5000000 }
if ITERATIONS run ITERATIONS 18 * != then
    "checksum" panic
fi
