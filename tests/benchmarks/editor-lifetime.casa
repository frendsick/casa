import "std" as std
import "../../compiler/products.casa" as products
import "../../compiler/document.casa" as document

fn stop_for_sample {
    # SAFETY: Signal only this process, with no pointer arguments.
    unsafe { 19 39 syscall0 62 syscall2 drop }
}

fn analyze_replacement source:$str -> products::AnalysisSnapshot {
    "/tmp/editor-lifetime".to_str
    source.to_str "root.casa".to_str products::SourceUnit products::CompilationInput::new = input
    "pub fn answer -> i64 { 42 }".to_str "peer.casa".to_str input.source_overrides.set
    "unused".to_str "unused.casa".to_str input.source_overrides.set
    input products::analyze.unwrap
}

fn run_edits {
    "import \"peer.casa\" as peer\npeer::answer print" analyze_replacement = snapshot
    0 = iteration
    while 10 iteration < do
        33 "/tmp/editor-lifetime/root.casa" snapshot.get_index.find_hover = answer
        "fn healthy -> i64 { 42 }\nhealthy print\nfn broken { true 1 + drop }" analyze_replacement = snapshot
        answer match
            document::PointAnswer::Known(hover) => {
                if hover.content.as_str "answer" str::contains ! then
                    "lost owned answer" panic
                fi
            }
            _ => "missing hover" panic
        end
        "import \"peer.casa\" as peer\npeer::answer print" analyze_replacement = snapshot
        1 += iteration
    done
}
stop_for_sample
0 = iteration
while 30 iteration < do
    run_edits
    stop_for_sample
    1 += iteration
done
