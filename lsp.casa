pub fn convert_document_hover_to_lsp
    sources:$lexer::SourceStore
    hover:$document::DocumentHover
-> HoverContent {
    hover.location sources convert_document_location_to_lsp = location
    location.range.clone f"```casa\n{hover.content.as_str}\n```" HoverContent
}

pub fn compute_hover
    state:$document::AnalyzedDocument
    line:i64
    column:i64
-> std::Option[HoverContent] {
    column line convert_lsp_position = position
    if position state.find_hover_at std::Option::Some(hover) is then
        hover state.sources convert_document_hover_to_lsp std::Option::Some
    else
        std::Option[HoverContent]::None
    fi
}

pub fn handle_hover message:$json::JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        json::JsonValue::JsonNull request_id send_response
        return
    fi
    document_opt.unwrap = document

    message extract_position = position
    position LspRange::start_col position LspRange::start_line document compute_hover = hover_opt
    if hover_opt.is_none then
        json::JsonValue::JsonNull request_id send_response
        return
    fi
    hover_opt.unwrap = hover
    json::json_object
    "contents".to_str json::json_object
    "kind".to_str "markdown".to_str json::JsonValue::JsonString json::json_set
    "value".to_str hover HoverContent::content.clone json::JsonValue::JsonString json::json_set
    json::JsonValue::JsonObject json::json_set
    "range".to_str hover HoverContent::range.to_json json::json_set
    json::JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Completion handler
# ============================================================================

pub fn format_completion_candidate candidate:$document::CompletionCandidate -> CompletionItem {
    candidate match
        document::CompletionCandidate::Function(function_name) => {
            "".to_str COMPLETION_FUNCTION function_name.clone std::Option[TextEdit]::None CompletionItem
        }
        document::CompletionCandidate::Variable(variable) => {
            variable.typ.format COMPLETION_VARIABLE variable.name.clone std::Option[TextEdit]::None CompletionItem
        }
        document::CompletionCandidate::Keyword(keyword) => {
            "".to_str COMPLETION_KEYWORD keyword.format_source.to_str std::Option[TextEdit]::None CompletionItem
        }
        document::CompletionCandidate::Intrinsic(intrinsic) => {
            "".to_str COMPLETION_KEYWORD intrinsic.format_source.to_str std::Option[TextEdit]::None CompletionItem
        }
        document::CompletionCandidate::Struct(casa_struct) => {
            std::String::new = member_builder
            0 = member_index: u64
            while member_index casa_struct.members.length > do
                if 0 member_index != then
                    ", " member_builder.append
                fi
                member_index casa_struct.members.get = member
                member.name.as_str member_builder.append
                ": " member_builder.append
                member
                    .typ
                    .format
                    .as_str member_builder.append
                1 += member_index
            done
            member_builder COMPLETION_STRUCT casa_struct.name.clone std::Option[TextEdit]::None CompletionItem
        }
        document::CompletionCandidate::Enum(enum_name) => {
            "".to_str COMPLETION_ENUM enum_name.clone std::Option[TextEdit]::None CompletionItem
        }
        document::CompletionCandidate::EnumVariant(variant_name) => {
            "".to_str COMPLETION_ENUM_MEMBER variant_name.clone std::Option[TextEdit]::None CompletionItem
        }
        document::CompletionCandidate::Method(function_name) => {
            "".to_str COMPLETION_METHOD function_name.as_str "::" str::split.pop std::Option[TextEdit]::None CompletionItem
        }
    end
}

pub fn compute_completion_with_coverage
    state:$document::AnalyzedDocument
    line:i64
    column:i64
    trigger:$str
-> std::List[CompletionItem] bool {
    std::List[CompletionItem]::new = items
    column line convert_lsp_position = position
    std::List[document::DocumentCompletion]::new = candidates
    false = incomplete
    trigger position state.find_completions_at match
        document::ListAnswer::Complete(values) => values = candidates
        document::ListAnswer::Incomplete(values _) => {
            values = candidates true = incomplete
        }
        document::ListAnswer::Unavailable(_) => true = incomplete
    end
    for candidate in candidates.iter do
        candidate.candidate format_completion_candidate = item
        candidate.replacement state.sources convert_document_location_to_lsp.range.clone = range
        if 0 candidate.replacement.length == then
            range.start_line = range.end_line
            range.start_col = range.end_col
        fi
        candidate.insertion_text.clone range TextEdit std::Option::Some = item.edit
        item items.push
    done
    items incomplete
}

pub fn compute_completion
    state:$document::AnalyzedDocument
    line:i64
    column:i64
    trigger:$str
-> std::List[CompletionItem] {
    trigger column line state compute_completion_with_coverage drop
}

pub fn handle_completion message:$json::JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        json::json_object
        "isIncomplete".to_str true json::JsonValue::JsonBool json::json_set
        "items".to_str std::List[json::JsonValue]::new json::JsonValue::JsonArray json::json_set
        json::JsonValue::JsonObject request_id send_response
        return
    fi
    document_opt.unwrap = document

    # Check trigger character
    "params" message json::json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "context" params json::json_get_object = context_opt
    std::String::new = trigger
    if context_opt std::Option::Some(context) is then
        "triggerCharacter" context json::json_get_str = trigger_opt
        if trigger_opt.is_some then
            trigger_opt.unwrap = trigger
        fi
    fi

    message extract_position = position
    trigger.as_str position LspRange::start_col position LspRange::start_line document compute_completion_with_coverage = incomplete = items

    # Build response
    std::List[json::JsonValue]::new = json_items
    0 = item_index: u64
    while item_index items.length > do
        item_index items.get.to_json json_items.push
        1 += item_index
    done
    json::json_object
    "isIncomplete".to_str incomplete json::JsonValue::JsonBool json::json_set
    "items".to_str json_items json::JsonValue::JsonArray json::json_set
    json::JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Find references handler
# ============================================================================

pub fn compute_references_with_coverage
    state:$document::AnalyzedDocument
    line:i64
    column:i64
    include_declaration:bool
-> std::Option[std::List[LspLocation]] bool {
    column line convert_lsp_position = position
    false = incomplete
    include_declaration position state.find_reference_answer_at match
        document::ReferenceAnswer::Complete(result) => result
        document::ReferenceAnswer::Incomplete(result _) => {
            true = incomplete result
        }
        document::ReferenceAnswer::Unavailable(_) => {
            std::Option[std::List[LspLocation]]::None true return
        }
    end = result
    std::List[LspLocation]::new = references
    for range in result.ranges.iter do
        range state.sources convert_document_location_to_lsp references.push
    done
    references std::Option::Some incomplete
}

pub fn compute_references
    state:$document::AnalyzedDocument
    line:i64
    column:i64
    include_declaration:bool
-> std::Option[std::List[LspLocation]] {
    include_declaration column line state compute_references_with_coverage drop
}

pub fn handle_references message:$json::JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    # includeDeclaration
    std::Option[$json::JsonValue]::None = context_opt
    if "params" message json::json_get_object std::Option::Some(params) is then
        "context" params json::json_get_object = context_opt
    fi
    true = include_decl
    if context_opt std::Option::Some(context) is then
        "includeDeclaration" context json::json_get_bool = include_decl_opt
        if include_decl_opt.is_some then
            include_decl_opt.unwrap = include_decl
        fi
    fi

    message extract_position = position
    uri.as_str uri_to_path = path
    position path.as_str state.workspace query_workspace_references = result_opt
    if result_opt.is_none then
        json::JsonValue::JsonNull request_id send_response return
    fi
    result_opt.unwrap = result
    if state.has_pending_input then
        "References cancelled because newer client input is pending." request_id send_request_error return
    fi
    result.complete ! = incomplete
    result make_reference_sources = sources
    std::List[LspLocation]::new = references
    for range in result.ranges.iter do
        if include_decl ! range result.declaration.matches && then
            continue
        fi
        range sources convert_document_location_to_lsp references.push
    done
    references std::Option::Some = refs_opt
    if refs_opt.is_none then
        json::JsonValue::JsonNull request_id send_response
        return
    fi
    if incomplete then
        json::json_object
        "type".to_str 2 json::JsonValue::JsonInt json::json_set
        "message".to_str "Workspace references are incomplete. Some sources or bindings could not be verified.".to_str
        json::JsonValue::JsonString json::json_set
        json::JsonValue::JsonObject "window/showMessage" send_notification
    fi
    refs_opt.unwrap = refs
    std::List[json::JsonValue]::new = json_refs
    0 = ref_index: u64
    while ref_index refs.length > do
        ref_index refs.get.to_json json_refs.push
        1 += ref_index
    done
    json_refs json::JsonValue::JsonArray request_id send_response
}

# ============================================================================
# Rename handler
# ============================================================================

pub fn handle_rename message:$json::JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    "params" message json::json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "newName" params json::json_get_str = new_name_opt
    if new_name_opt.is_none then
        "Expected option value while unwrapping newName params json_get_str" exit_with_lsp_error
    fi
    new_name_opt.unwrap = new_name

    if state.versioned_edits ! then
        "Rename requires client support for versioned document changes." request_id send_request_error return
    fi
    message extract_position = position
    uri.as_str uri_to_path = path
    position path.as_str state.workspace query_workspace_references = result_opt
    if result_opt.is_none then
        "Rename identity is unavailable." request_id send_request_error return
    fi
    result_opt.unwrap = result
    if result state.has_document_versions ! then
        "Rename requires the current version of every affected open document." request_id send_request_error return
    fi
    if new_name.as_str result state.workspace.validate_rename ! then
        "Rename refused: stale or incomplete sources, invalid name, or changed bindings." request_id send_request_error return
    fi
    if state.has_pending_input then
        "Rename cancelled because newer client input is pending." request_id send_request_error return
    fi
    result new_name.as_str state make_workspace_edit request_id send_response
}

pub fn send_request_error id:$json::JsonValue message:$str {
    json::json_object
    "code".to_str -32803 json::JsonValue::JsonInt json::json_set
    "message".to_str message.to_str json::JsonValue::JsonString json::json_set
    json::JsonValue::JsonObject = failure
    json::json_object
    "jsonrpc".to_str "2.0".to_str json::JsonValue::JsonString json::json_set
    "id".to_str id.clone json::json_set
    "error".to_str failure json::json_set
    json::JsonValue::JsonObject json::json_serialize send_json_rpc
}

pub fn query_workspace_references
    state:$workspace::Workspace
    path:$str
    position:$LspRange
-> std::Option[workspace::References] {
    path state.read_source match
        std::Option::Some(source) => source
        _ => std::Option[workspace::References]::None return
    end = source
    position source.as_str offset_from_lsp match
        std::Option::Some(offset) => offset
        _ => std::Option[workspace::References]::None return
    end = offset
    true offset path state.find_references match
        std::Option::Some(result) => result
        _ => std::Option[workspace::References]::None return
    end = result
    if path result.sources.get_str std::Option::Some(analyzed) is then
        if source analyzed == then
            result std::Option::Some return
        fi
    fi
    std::Option[workspace::References]::None
}

fn make_reference_sources result:$workspace::References -> lexer::SourceStore {
    lexer::SourceStore::new = sources
    for entry in result.sources.iter do
        entry.second.as_str entry.first.as_str sources.add
    done
    sources
}

pub fn make_workspace_edit
    state:$LspState
    name:$str
    result:$workspace::References
-> json::JsonValue {
    result make_reference_sources = sources
    std::List[json::JsonValue]::new = changes
    for entry in result.sources.iter do
        std::List[json::JsonValue]::new = edits
        for range in result.ranges.iter do
            if range.file entry.first != then
                continue
            fi
            range sources convert_document_location_to_lsp = location
            name.to_str location.range.clone TextEdit.to_json edits.push
        done
        if edits.is_empty then
            continue
        fi
        json::JsonValue::JsonNull = version
        if entry.first state.versions.get std::Option::Some(current) is then
            current copy json::JsonValue::JsonInt = version
        fi
        json::json_object
        "uri".to_str entry.first.as_str path_to_uri json::JsonValue::JsonString json::json_set
        "version".to_str version json::json_set json::JsonValue::JsonObject = identifier
        json::json_object
        "textDocument".to_str identifier json::json_set
        "edits".to_str edits json::JsonValue::JsonArray json::json_set
        json::JsonValue::JsonObject changes.push
    done
    json::json_object
    "documentChanges".to_str changes json::JsonValue::JsonArray json::json_set
    json::JsonValue::JsonObject
}

# ============================================================================
# Semantic tokens handler
# ============================================================================

pub fn map_document_token_type kind:document::DocumentTokenKind -> i64 {
    kind match
        document::DocumentTokenKind::Function => TOKEN_FUNCTION
        document::DocumentTokenKind::Variable => TOKEN_VARIABLE
        document::DocumentTokenKind::String => TOKEN_STRING
        document::DocumentTokenKind::Number => TOKEN_NUMBER
        document::DocumentTokenKind::Keyword => TOKEN_KEYWORD
        document::DocumentTokenKind::Operator => TOKEN_OPERATOR
        document::DocumentTokenKind::Type => TOKEN_TYPE
        document::DocumentTokenKind::EnumMember => TOKEN_ENUM_MEMBER
        document::DocumentTokenKind::Struct => TOKEN_STRUCT
        document::DocumentTokenKind::Macro => TOKEN_MACRO
    end
}

pub fn compute_semantic_tokens state:$document::AnalyzedDocument -> std::List[SemanticToken] {
    std::List[SemanticToken]::new = tokens
    for document_token in state.find_semantic_tokens.iter do
        document_token.location = location: $document::DocumentLocation
        location state.sources convert_document_location_to_lsp.range.clone = range
        0
        document_token.kind copy map_document_token_type
        location.length
        range.start_col
        range.start_line
        SemanticToken tokens.push
    done
    tokens
}

pub fn handle_semantic_tokens message:$json::JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        json::json_object
        "data".to_str std::List[json::JsonValue]::new json::JsonValue::JsonArray json::json_set
        json::JsonValue::JsonObject request_id send_response
        return
    fi
    document_opt.unwrap = document

    document compute_semantic_tokens = tokens

    # Delta-encode
    std::List[json::JsonValue]::new = encoded_data
    0 = prev_line
    0 = prev_col
    for token in tokens.iter do
        token SemanticToken::line prev_line - = delta_line
        if 0 delta_line == then
            token SemanticToken::col prev_col -
        else
            token SemanticToken::col
        fi
        = delta_col
        delta_line json::JsonValue::JsonInt encoded_data.push
        delta_col json::JsonValue::JsonInt encoded_data.push
        token SemanticToken::length i64::try_from.unwrap json::JsonValue::JsonInt encoded_data.push
        token SemanticToken::token_type json::JsonValue::JsonInt encoded_data.push
        token SemanticToken::modifiers json::JsonValue::JsonInt encoded_data.push
        token SemanticToken::line = prev_line
        token SemanticToken::col = prev_col
    done

    json::json_object
    "data".to_str encoded_data json::JsonValue::JsonArray json::json_set
    json::JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Server initialization and main loop
# ============================================================================

pub fn extract_library_paths message:$json::JsonValue -> std::List[std::String] {
    std::List[std::String]::new = paths
    "params" message json::json_get_object = params_option
    if params_option.is_none then
        paths return
    fi
    params_option.unwrap = params
    "initializationOptions" params json::json_get_object = init_options_option
    if init_options_option.is_none then
        paths return
    fi
    init_options_option.unwrap = init_options
    "libraryPaths" init_options json::json_get_array = library_paths_option
    if library_paths_option.is_none then
        paths return
    fi
    library_paths_option.unwrap = library_paths_array
    for path_value in library_paths_array.iter do
        if path_value json::JsonValue::JsonString(path_string) is then
            path_string.clone paths.push
        fi
    done
    paths
}

fn configure_workspace message:$json::JsonValue state:mut$LspState {
    if "params" message json::json_get_object std::Option::Some(params) is then
        if "workspaceFolders" params json::json_get_array std::Option::Some(folders) is then
            for folder in folders.iter do
                if "uri" folder json::json_get_str std::Option::Some(uri) is then
                    uri.as_str uri_to_path state
                        .workspace
                        .folders
                        .push
                fi
            done
        elif "rootUri" params json::json_get_str std::Option::Some(uri) is then
            uri.as_str uri_to_path state
                .workspace
                .folders
                .push
        fi
        if "initializationOptions" params json::json_get_object std::Option::Some(options) is then
            options state configure_exclusions
        fi
        if "capabilities" params json::json_get_object std::Option::Some(capabilities) is then
            capabilities state configure_edit_capability
        fi
    fi
    1 += state.workspace.generation
}

fn configure_exclusions state:mut$LspState options:$json::JsonValue {
    if "excludePaths" options json::json_get_array std::Option::Some(paths) is then
        for path in paths.iter do
            if path json::JsonValue::JsonString(value) is then
                value.as_str lexer::absolute_normalize_path state
                    .workspace
                    .exclusions
                    .push
            fi
        done
    fi
}

fn configure_edit_capability state:mut$LspState capabilities:$json::JsonValue {
    if "workspace" capabilities json::json_get_object std::Option::Some(workspace) is then
        if "workspaceEdit" workspace json::json_get_object std::Option::Some(edit) is then
            if "documentChanges" edit json::json_get_bool std::Option::Some(supported) is then
                supported copy = state.versioned_edits
            fi
        fi
    fi
}

pub fn handle_initialize message:$json::JsonValue state:mut$LspState {
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    message extract_library_paths = state.library_paths
    state.library_paths.clone = state.workspace.library_paths
    state message configure_workspace

    # Build semantic tokens legend
    std::List[json::JsonValue]::new = token_types
    "function".to_str json::JsonValue::JsonString token_types.push
    "variable".to_str json::JsonValue::JsonString token_types.push
    "string".to_str json::JsonValue::JsonString token_types.push
    "number".to_str json::JsonValue::JsonString token_types.push
    "keyword".to_str json::JsonValue::JsonString token_types.push
    "operator".to_str json::JsonValue::JsonString token_types.push
    "type".to_str json::JsonValue::JsonString token_types.push
    "enumMember".to_str json::JsonValue::JsonString token_types.push
    "struct".to_str json::JsonValue::JsonString token_types.push
    "macro".to_str json::JsonValue::JsonString token_types.push

    # Trigger characters for completion
    std::List[json::JsonValue]::new = triggers
    ".".to_str json::JsonValue::JsonString triggers.push
    ":".to_str json::JsonValue::JsonString triggers.push

    json::json_object
    "serverInfo".to_str json::json_object
    "name".to_str "casa-language-server".to_str json::JsonValue::JsonString json::json_set
    "version".to_str "0.1.0".to_str json::JsonValue::JsonString json::json_set
    json::JsonValue::JsonObject json::json_set
    "capabilities".to_str json::json_object
    "textDocumentSync".to_str 1 json::JsonValue::JsonInt json::json_set
    "definitionProvider".to_str true json::JsonValue::JsonBool json::json_set
    "hoverProvider".to_str true json::JsonValue::JsonBool json::json_set
    "completionProvider".to_str json::json_object
    "triggerCharacters".to_str triggers json::JsonValue::JsonArray json::json_set
    json::JsonValue::JsonObject json::json_set
    "workspace".to_str json::json_object
    "workspaceFolders".to_str json::json_object
    "supported".to_str true json::JsonValue::JsonBool json::json_set
    "changeNotifications".to_str true json::JsonValue::JsonBool json::json_set
    json::JsonValue::JsonObject json::json_set
    json::JsonValue::JsonObject json::json_set
    "referencesProvider".to_str true json::JsonValue::JsonBool json::json_set
    "renameProvider".to_str true json::JsonValue::JsonBool json::json_set
    "semanticTokensProvider".to_str json::json_object
    "legend".to_str json::json_object
    "tokenTypes".to_str token_types json::JsonValue::JsonArray json::json_set
    "tokenModifiers".to_str std::List[json::JsonValue]::new json::JsonValue::JsonArray json::json_set
    json::JsonValue::JsonObject json::json_set
    "full".to_str true json::JsonValue::JsonBool json::json_set
    json::JsonValue::JsonObject json::json_set
    json::JsonValue::JsonObject json::json_set
    json::JsonValue::JsonObject request_id send_response
}

fn change_workspace_folders message:$json::JsonValue state:mut$LspState {
    if "params" message json::json_get_object std::Option::Some(params) is then
        if "event" params json::json_get_object std::Option::Some(event) is then
            event state update_workspace_folders
        fi
    fi
    1 += state.workspace.generation
}

fn update_workspace_folders state:mut$LspState event:$json::JsonValue {
    std::Set[std::String]::new = folders
    for
        folder in state
            .workspace
            .folders
            .iter
    do
        folder.clone folders.add
    done
    if "removed" event json::json_get_array std::Option::Some(removed) is then
        for item in removed.iter do
            if "uri" item json::json_get_str std::Option::Some(uri) is then
                uri.as_str uri_to_path folders.remove
            fi
        done
    fi
    if "added" event json::json_get_array std::Option::Some(added) is then
        for item in added.iter do
            if "uri" item json::json_get_str std::Option::Some(uri) is then
                uri.as_str uri_to_path folders.add
            fi
        done
    fi
    folders.to_list = state.workspace.folders
}

pub fn handle_shutdown message:$json::JsonValue {
    if "id" message json::json_get_value std::Option::Some(request_id) is then
        json::JsonValue::JsonNull request_id send_response
    else
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
}

pub fn handle_exit message:$json::JsonValue { 0 process::exit }

pub fn dispatch_message message:$json::JsonValue state:mut$LspState {
    "method" message json::json_get_str = method_opt
    if method_opt.is_none then
        return
    fi
    method_opt.unwrap = method
    if
        "textDocument/definition" method == "textDocument/hover" method == ||
        "textDocument/completion" method == || "textDocument/semanticTokens/full" method == ||
    then
        message extract_uri.as_str state.refresh_document
    fi

    if "initialize" method == then
        state message handle_initialize
    elif "shutdown" method == then
        message handle_shutdown
    elif "exit" method == then
        message handle_exit
    elif "textDocument/didOpen" method == then
        state message handle_did_open
    elif "textDocument/didChange" method == then
        state message handle_did_change
    elif "textDocument/didClose" method == then
        state message handle_did_close
    elif "workspace/didChangeWorkspaceFolders" method == then
        state message change_workspace_folders
    elif "workspace/didChangeWatchedFiles" method == then
        1 += state.workspace.generation
    elif "textDocument/didSave" method == then
        state message handle_did_save
    elif "textDocument/definition" method == then
        state message handle_definition
    elif "textDocument/hover" method == then
        state message handle_hover
    elif "textDocument/completion" method == then
        state message handle_completion
    elif "textDocument/references" method == then
        state message handle_references
    elif "textDocument/rename" method == then
        state message handle_rename
    elif "textDocument/semanticTokens/full" method == then
        state message handle_semantic_tokens
    fi
}

pub fn main {
    LspState::new = state
    while true do
        state.reader read_message = msg_opt
        if msg_opt.is_none then
            break
        fi
        if msg_opt std::Option::Some(message) is then
            state message dispatch_message
        fi
    done
}
main
