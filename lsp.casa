# Casa Language Server
#
# LSP server implementation for the Casa language, providing diagnostics,
# go-to-definition, hover, completion, references, rename, and semantic tokens.
# Communicates via JSON-RPC over stdin/stdout.
import "lib/std.casa"
import "lib/os.casa"
import "lib/parser.casa"
import "lib/json.casa"
import "lib/io.casa"
import "compiler/common.casa"
import "compiler/error.casa"
import "compiler/lexer.casa"
import "compiler/syntax.casa"
import "compiler/typechecker.casa"
import "compiler/analysis.casa"
import "compiler/document.casa"

# ============================================================================
# LSP structs
# ============================================================================

struct LspRange {
    start_line: i64
    start_col:  i64
    end_line:   i64
    end_col:    i64
}

impl LspRange: Clone {
    fn clone self:$LspRange -> LspRange {
        self.end_col self.end_line self.start_col self.start_line LspRange
    }
}

struct LspLocation {
    uri:   String
    range: LspRange
}

struct LspDiagnostic {
    range:    LspRange
    message:  String
    severity: i64
}

struct CompletionItem {
    label:  String
    kind:   i64
    detail: String
}

struct SemanticToken {
    line:       i64
    col:        i64
    length:     u64
    token_type: i64
    modifiers:  i64
}

struct TextEdit {
    range:    LspRange
    new_text: String
}

struct HoverContent {
    content: String
    range:   LspRange
}

struct CompileResult {
    document:    AnalyzedDocument
    diagnostics: List[LspDiagnostic]
}

struct LspState {
    library_paths:  List[String]
    open_documents: Map[String AnalyzedDocument]
    reader:         StdinReader
}

impl CompileResult {
    fn into_parts self:CompileResult -> AnalyzedDocument List[LspDiagnostic] {
        self match
            CompileResult { document: document diagnostics: diagnostics } => document diagnostics
        end
    }
}

impl LspState {
    fn new -> LspState {
        LspState {
            library_paths: List[String]::new
            open_documents: Map[String AnalyzedDocument]::new
            reader: StdinReader::new
        }
    }
}

impl LspLocation {
    fn into_parts self:LspLocation -> String LspRange {
        self match
            LspLocation { uri: uri range: range } => uri range
        end
    }
}

# ============================================================================
# LSP constants
# ============================================================================
const DIAGNOSTIC_ERROR 1
const DIAGNOSTIC_WARNING 2
const COMPLETION_METHOD 2
const COMPLETION_FUNCTION 3
const COMPLETION_VARIABLE 6
const COMPLETION_ENUM 13
const COMPLETION_KEYWORD 14
const COMPLETION_STRUCT 22
const COMPLETION_ENUM_MEMBER 20
# Semantic token types
const TOKEN_FUNCTION 0
const TOKEN_VARIABLE 1
const TOKEN_STRING 2
const TOKEN_NUMBER 3
const TOKEN_KEYWORD 4
const TOKEN_OPERATOR 5
const TOKEN_TYPE 6
const TOKEN_ENUM_MEMBER 7
const TOKEN_STRUCT 8
const TOKEN_MACRO 9

# ============================================================================
# Coordinate conversion utilities
# ============================================================================

fn convert_lsp_position line:i64 column:i64 -> SourcePosition {
    column 1 + (u64) line 1 + (u64) SourcePosition::new
}

fn convert_location_to_lsp_range sources:$SourceStore location:$Location -> LspRange {
    location.span.length = length
    if 1 length < then
        1 (u64) = length
    fi
    location.span.offset location.file.as_str sources.convert_offset_to_position = start_result
    location.span.offset length + location.file.as_str sources.convert_offset_to_position = end_result
    if start_result Option::Some(start_position) is then
        if end_result Option::Some(end_position) is then
            end_position.column 1 - (i64)
            end_position.line 1 - (i64)
            start_position.column 1 - (i64)
            start_position.line 1 - (i64)
            LspRange return
        fi
    fi
    0 0 0 0 LspRange
}

fn uri_to_path uri:$str -> String {
    # Strip file:// prefix
    if uri "file://" str::starts_with then
        uri 7 uri.length 7 - str::substring
    else
        uri.to_str
    fi
}

fn path_to_uri path:$str -> String { f"file://{path}" }

# ============================================================================
# JSON builders for LSP types
# ============================================================================

impl LspRange {
    fn to_json range:$LspRange -> JsonValue {
        json_object
        "line".to_str range LspRange::start_line JsonValue::JsonInt json_set
        "character".to_str range LspRange::start_col JsonValue::JsonInt json_set
        JsonValue::JsonObject = start_json
        json_object
        "line".to_str range LspRange::end_line JsonValue::JsonInt json_set
        "character".to_str range LspRange::end_col JsonValue::JsonInt json_set
        JsonValue::JsonObject = end_json
        json_object
        "start".to_str start_json json_set
        "end".to_str end_json json_set
        JsonValue::JsonObject
    }
}

impl LspLocation {
    fn to_json loc:$LspLocation -> JsonValue {
        loc LspLocation::range = loc_range: $LspRange
        json_object
        "uri".to_str loc LspLocation::uri.clone JsonValue::JsonString json_set
        "range".to_str loc_range.to_json json_set
        JsonValue::JsonObject
    }
}

impl LspDiagnostic {
    fn to_json diag:$LspDiagnostic -> JsonValue {
        diag LspDiagnostic::range = diag_range: $LspRange
        json_object
        "range".to_str diag_range.to_json json_set
        "message".to_str diag LspDiagnostic::message.clone JsonValue::JsonString json_set
        "severity".to_str diag LspDiagnostic::severity JsonValue::JsonInt json_set
        "source".to_str "casa".to_str JsonValue::JsonString json_set
        JsonValue::JsonObject
    }
}

impl CompletionItem {
    fn to_json item:$CompletionItem -> JsonValue {
        json_object = result_obj
        result_obj "label".to_str item CompletionItem::label.clone JsonValue::JsonString json_set = result_obj
        result_obj "kind".to_str item CompletionItem::kind JsonValue::JsonInt json_set = result_obj
        if "" item CompletionItem::detail != then
            result_obj "detail".to_str item CompletionItem::detail.clone JsonValue::JsonString json_set = result_obj
        fi
        result_obj JsonValue::JsonObject
    }
}

impl TextEdit {
    fn to_json edit:$TextEdit -> JsonValue {
        edit TextEdit::range = edit_range: $LspRange
        json_object
        "range".to_str edit_range.to_json json_set
        "newText".to_str edit TextEdit::new_text.clone JsonValue::JsonString json_set
        JsonValue::JsonObject
    }
}

# ============================================================================
# JSON-RPC protocol layer
# ============================================================================

fn exit_with_lsp_error message:str {
    f"[LSP] {message}\n".as_str eprint
    1 exit
}

fn read_message reader:mut$StdinReader -> Option[JsonValue] {
    Option[i64]::None = content_length
    # Read headers until empty line
    while true do
        reader stdin_read_line = header_line
        if 0 header_line.length == then
            break
        fi
        if header_line.as_str "Content-Length: " str::starts_with then
            header_line.as_str 16 header_line.length 16 - str::substring.as_str str_to_int Option::Some = content_length
        fi
    done
    if content_length.is_none then
        Option[JsonValue]::None
        return
    fi
    content_length.unwrap = length
    length (u64) reader stdin_read_exact = body
    body.as_str Cursor::new = cursor
    cursor json_parse = parse_result
    parse_result match
        Result::Ok(parsed) => parsed Option::Some
        Result::Error(_) => Option[JsonValue]::None
    end
}

fn send_json_rpc body:String {
    body.length = body_length
    f"Content-Length: {body_length}\r\n\r\n{body.as_str}".as_str stdout_write
}

fn send_response id:$JsonValue result:JsonValue {
    json_object
    "jsonrpc".to_str "2.0".to_str JsonValue::JsonString json_set
    "id".to_str id.clone json_set
    "result".to_str result json_set
    JsonValue::JsonObject json_serialize send_json_rpc
}

fn send_notification method:str params:JsonValue {
    json_object
    "jsonrpc".to_str "2.0".to_str JsonValue::JsonString json_set
    "method".to_str method.to_str JsonValue::JsonString json_set
    "params".to_str params json_set
    JsonValue::JsonObject json_serialize send_json_rpc
}

# ============================================================================
# Compilation pipeline
# ============================================================================

fn compile_document_with_paths
    file_path:$str
    source:$str
    open_docs:$Map[String AnalyzedDocument]
    library_paths:$List[String]
-> CompileResult {
    source.to_str file_path.to_str AnalysisInput::new = input
    library_paths.clone = input.library_paths
    open_docs.keys = uris
    for uri in uris.iter do
        uri open_docs.get.unwrap = cached_state
        if cached_state.file_path file_path != then
            cached_state.source.clone cached_state.file_path.clone input.source_overrides.set
        fi
    done
    input analyze = analysis

    file_path analysis diagnostics_from = diagnostics
    file_path.to_str source.to_str analysis AnalyzedDocument::new = state

    diagnostics
    state
    CompileResult
}

fn compile_document
    file_path:$str
    source:$str
    open_docs:$Map[String AnalyzedDocument]
-> CompileResult {
    List[String]::new = library_paths
    library_paths open_docs source file_path compile_document_with_paths
}

fn ingest_document_into
    uri:$str
    source:$str
    open_docs:Map[String AnalyzedDocument]
-> List[LspDiagnostic] Map[String AnalyzedDocument] {
    uri uri_to_path = path
    open_docs source path.as_str compile_document.into_parts = diagnostics = document
    document uri.to_str open_docs.set
    diagnostics
    open_docs
}

fn ingest_document uri:$str source:$str state:mut$LspState -> List[LspDiagnostic] {
    uri uri_to_path = path
    state.library_paths state.open_documents source path.as_str compile_document_with_paths.into_parts
    = diagnostics = document
    document uri.to_str state.open_documents.set
    diagnostics
}

fn diagnostics_from analysis:$AnalysisResult path:$str -> List[LspDiagnostic] {
    List[LspDiagnostic]::new = diagnostics

    for
        diagnostic in analysis
            .diagnostics
            .entries
            .iter
    do
        if diagnostic Diagnostic::Error(error) is then
            if
                "" error CasaError::location Location::file !=
                error CasaError::location Location::file path != &&
            then
                continue
            fi
            error.location.clone = location
            if
                location.file.as_str analysis
                    .sources
                    .get
                    .is_none
            then
                path.to_str = location.file
            fi

            # Build message
            String::new = msg_builder
            error CasaError::message.as_str msg_builder.append
            if error.expected Option::Some(expected) is then
                "\nExpected: " msg_builder.append
                expected.as_str msg_builder.append
            fi
            if error CasaError::got Option::Some(got) is then
                "\n" msg_builder.append
                error CasaError::got_label.as_str msg_builder.append
                ": " msg_builder.append
                got.as_str msg_builder.append
            fi

            DIAGNOSTIC_ERROR
            msg_builder
            location analysis.sources convert_location_to_lsp_range
            LspDiagnostic diagnostics.push
        elif diagnostic Diagnostic::Warning(warning) is then
            if
                "" warning CasaWarning::location Location::file !=
                warning CasaWarning::location Location::file path != &&
            then
                continue
            fi
            warning.location.clone = location
            if
                location.file.as_str analysis
                    .sources
                    .get
                    .is_none
            then
                path.to_str = location.file
            fi
            DIAGNOSTIC_WARNING
            warning CasaWarning::message.clone
            location analysis.sources convert_location_to_lsp_range
            LspDiagnostic diagnostics.push
        fi
    done

    diagnostics
}

fn publish_diagnostics uri:$str diagnostics:List[LspDiagnostic] {
    List[JsonValue]::new = json_array
    0 (u64) = diagnostic_index
    while diagnostic_index diagnostics.length > do
        diagnostic_index diagnostics.get.to_json json_array.push
        1 += diagnostic_index
    done
    json_object
    "uri".to_str uri.to_str JsonValue::JsonString json_set
    "diagnostics".to_str json_array JsonValue::JsonArray json_set
    JsonValue::JsonObject = params
    params "textDocument/publishDiagnostics" send_notification
}

fn convert_document_location_to_lsp sources:$SourceStore location:$DocumentLocation -> LspLocation {
    location.length location.offset location.file.clone Location::new
    sources
    convert_location_to_lsp_range
    location.file.as_str path_to_uri
    LspLocation
}

# ============================================================================
# Diagnostics handler
# ============================================================================

fn extract_uri message:$JsonValue -> String {
    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "textDocument" params json_get_object = text_document_opt
    if text_document_opt.is_none then
        "Expected option value while unwrapping textDocument params json_get_object" exit_with_lsp_error
    fi
    text_document_opt.unwrap = text_document
    if "uri" text_document json_get_str Option::Some(uri) is then
        uri.clone return
    fi
    "Expected option value while unwrapping uri text_document json_get_str" exit_with_lsp_error
    String::new
}

fn extract_position message:$JsonValue -> LspRange {
    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "position" params json_get_object = position_opt
    if position_opt.is_none then
        "Expected option value while unwrapping position params json_get_object" exit_with_lsp_error
    fi
    position_opt.unwrap = position
    "line" position json_get_int = line_opt
    if line_opt.is_none then
        "Expected option value while unwrapping line position json_get_int" exit_with_lsp_error
    fi
    line_opt.unwrap = line
    "character" position json_get_int = character_opt
    if character_opt.is_none then
        "Expected option value while unwrapping character position json_get_int" exit_with_lsp_error
    fi
    character_opt.unwrap = character
    0 0 character line LspRange
}

fn handle_did_open message:$JsonValue state:mut$LspState {
    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "textDocument" params json_get_object = text_document_opt
    if text_document_opt.is_none then
        "Expected option value while unwrapping textDocument params json_get_object" exit_with_lsp_error
    fi
    text_document_opt.unwrap = text_document
    "uri" text_document json_get_str = uri_opt
    if uri_opt.is_none then
        "Expected option value while unwrapping uri text_document json_get_str" exit_with_lsp_error
    fi
    uri_opt.unwrap = uri
    "text" text_document json_get_str = text_opt
    if text_opt.is_none then
        "Expected option value while unwrapping text text_document json_get_str" exit_with_lsp_error
    fi
    text_opt.unwrap = text
    state text.as_str uri.as_str ingest_document = diagnostics
    diagnostics uri.as_str publish_diagnostics
}

fn handle_did_change message:$JsonValue state:mut$LspState {
    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "textDocument" params json_get_object = text_document_opt
    if text_document_opt.is_none then
        "Expected option value while unwrapping textDocument params json_get_object" exit_with_lsp_error
    fi
    text_document_opt.unwrap = text_document
    "uri" text_document json_get_str = uri_opt
    if uri_opt.is_none then
        "Expected option value while unwrapping uri text_document json_get_str" exit_with_lsp_error
    fi
    uri_opt.unwrap = uri
    "contentChanges" params json_get_array = changes_opt
    if changes_opt.is_none then
        "Expected option value while unwrapping contentChanges params json_get_array" exit_with_lsp_error
    fi
    changes_opt.unwrap = changes
    0 changes.get = change
    "text" change json_get_str = text_opt
    if text_opt.is_none then
        "Expected option value while unwrapping text change json_get_str" exit_with_lsp_error
    fi
    text_opt.unwrap = text
    state text.as_str uri.as_str ingest_document = diagnostics
    diagnostics uri.as_str publish_diagnostics
}

fn handle_did_save message:$JsonValue state:mut$LspState {
    message extract_uri = uri
    uri.as_str uri_to_path.as_str file::read_all = read_result
    if read_result Result::Error(read_err) is then
        f"error: handle_did_save read failed for {uri}: {read_err.to_str}".as_str eprintln
        return
    fi
    read_result.unwrap = saved_source
    state saved_source.as_str uri.as_str ingest_document = diagnostics
    diagnostics uri.as_str publish_diagnostics
}

# ============================================================================
# Go-to-definition handler
# ============================================================================

fn compute_definition state:$AnalyzedDocument line:i64 column:i64 -> Option[LspLocation] {
    column line convert_lsp_position = position
    if position state.find_definition_at Option::Some(location) is then
        location state.sources convert_document_location_to_lsp Option::Some
    else
        Option[LspLocation]::None
    fi
}

fn handle_definition message:$JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    document_opt.unwrap = document

    message extract_position = position
    position LspRange::start_col position LspRange::start_line document compute_definition = loc_opt
    if loc_opt Option::Some(loc) is then
        loc.to_json request_id send_response
    else
        JsonValue::JsonNull request_id send_response
    fi
}

# ============================================================================
# Hover handler
# ============================================================================

fn convert_document_hover_to_lsp sources:$SourceStore hover:$DocumentHover -> HoverContent {
    hover.location sources convert_document_location_to_lsp = location
    location.range.clone f"```casa\n{hover.content.as_str}\n```" HoverContent
}

fn compute_hover state:$AnalyzedDocument line:i64 column:i64 -> Option[HoverContent] {
    column line convert_lsp_position = position
    if position state.find_hover_at Option::Some(hover) is then
        hover state.sources convert_document_hover_to_lsp Option::Some
    else
        Option[HoverContent]::None
    fi
}

fn handle_hover message:$JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    document_opt.unwrap = document

    message extract_position = position
    position LspRange::start_col position LspRange::start_line document compute_hover = hover_opt
    if hover_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    hover_opt.unwrap = hover
    json_object
    "contents".to_str json_object
    "kind".to_str "markdown".to_str JsonValue::JsonString json_set
    "value".to_str hover HoverContent::content.clone JsonValue::JsonString json_set
    JsonValue::JsonObject json_set
    "range".to_str hover HoverContent::range.to_json json_set
    JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Completion handler
# ============================================================================

fn format_completion_candidate candidate:$CompletionCandidate -> CompletionItem {
    candidate match
        CompletionCandidate::Function(function_name) => {
            "".to_str COMPLETION_FUNCTION function_name.clone CompletionItem
        }
        CompletionCandidate::Variable(variable) => {
            variable.typ.format COMPLETION_VARIABLE variable.name.clone CompletionItem
        }
        CompletionCandidate::Keyword(keyword) => {
            "".to_str COMPLETION_KEYWORD keyword.format_source.to_str CompletionItem
        }
        CompletionCandidate::Intrinsic(intrinsic) => {
            "".to_str COMPLETION_KEYWORD intrinsic.format_source.to_str CompletionItem
        }
        CompletionCandidate::Struct(casa_struct) => {
            String::new = member_builder
            0 (u64) = member_index
            while member_index casa_struct.members.length > do
                if 0 member_index != then
                    ", " member_builder.append
                fi
                member_index casa_struct.members.get = member
                member.name.as_str member_builder.append
                ": " member_builder.append
                member
                    .typ
                    .format
                    .as_str member_builder.append
                1 += member_index
            done
            member_builder COMPLETION_STRUCT casa_struct.name.clone CompletionItem
        }
        CompletionCandidate::Enum(enum_name) => {
            "".to_str COMPLETION_ENUM enum_name.clone CompletionItem
        }
        CompletionCandidate::EnumVariant(variant_name) => {
            "".to_str COMPLETION_ENUM_MEMBER variant_name.clone CompletionItem
        }
        CompletionCandidate::Method(function_name) => {
            "".to_str COMPLETION_METHOD function_name.as_str "::" str::split.pop CompletionItem
        }
    end
}

fn compute_completion
    state:$AnalyzedDocument
    line:i64
    column:i64
    trigger:$str
-> List[CompletionItem] {
    List[CompletionItem]::new = items
    column line convert_lsp_position = position
    trigger position state.find_completion_candidates = candidates
    for candidate in candidates.iter do
        candidate format_completion_candidate items.push
    done
    items
}

fn handle_completion message:$JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        json_object
        "isIncomplete".to_str false JsonValue::JsonBool json_set
        "items".to_str List[JsonValue]::new JsonValue::JsonArray json_set
        JsonValue::JsonObject request_id send_response
        return
    fi
    document_opt.unwrap = document

    # Check trigger character
    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "context" params json_get_object = context_opt
    String::new = trigger
    if context_opt Option::Some(context) is then
        "triggerCharacter" context json_get_str = trigger_opt
        if trigger_opt.is_some then
            trigger_opt.unwrap = trigger
        fi
    fi

    message extract_position = position
    trigger.as_str position LspRange::start_col position LspRange::start_line document compute_completion = items

    # Build response
    List[JsonValue]::new = json_items
    0 (u64) = item_index
    while item_index items.length > do
        item_index items.get.to_json json_items.push
        1 += item_index
    done
    json_object
    "isIncomplete".to_str false JsonValue::JsonBool json_set
    "items".to_str json_items JsonValue::JsonArray json_set
    JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Find references handler
# ============================================================================

fn compute_references
    state:$AnalyzedDocument
    line:i64
    column:i64
    include_declaration:bool
-> Option[List[LspLocation]] {
    column line convert_lsp_position = position
    if include_declaration position state.find_references_at Option::Some(document_references) is then
        List[LspLocation]::new = references
        for document_reference in document_references.iter do
            document_reference state.sources convert_document_location_to_lsp references.push
        done
        references Option::Some return
    fi
    Option[List[LspLocation]]::None
}

fn handle_references message:$JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    document_opt.unwrap = document

    # includeDeclaration
    Option[$JsonValue]::None = context_opt
    if "params" message json_get_object Option::Some(params) is then
        "context" params json_get_object = context_opt
    fi
    true = include_decl
    if context_opt Option::Some(context) is then
        "includeDeclaration" context json_get_bool = include_decl_opt
        if include_decl_opt.is_some then
            include_decl_opt.unwrap = include_decl
        fi
    fi

    message extract_position = position
    include_decl position LspRange::start_col position LspRange::start_line document compute_references = refs_opt
    if refs_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    refs_opt.unwrap = refs
    List[JsonValue]::new = json_refs
    0 (u64) = ref_index
    while ref_index refs.length > do
        ref_index refs.get.to_json json_refs.push
        1 += ref_index
    done
    json_refs JsonValue::JsonArray request_id send_response
}

# ============================================================================
# Rename handler
# ============================================================================

fn compute_rename
    state:$AnalyzedDocument
    line:i64
    column:i64
    new_name:$str
-> Option[Map[String List[TextEdit]]] {
    column line convert_lsp_position = position
    if true position state.find_references_at Option::Some(document_references) is then
        Map[String List[TextEdit]]::new = edits_map
        for document_reference in document_references.iter do
            document_reference state.sources convert_document_location_to_lsp.into_parts
            = edit_range = reference_uri

            new_name.to_str edit_range TextEdit = edit
            reference_uri edits_map.get_mut = existing_edits
            existing_edits match
                Option::Some(edits) => edit edits.push
                Option::None => {
                    List[TextEdit]::new = document_edits
                    edit document_edits.push
                    document_edits reference_uri edits_map.set
                }
            end
        done
        edits_map Option::Some return
    fi
    Option[Map[String List[TextEdit]]]::None
}

fn handle_rename message:$JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    document_opt.unwrap = document

    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "newName" params json_get_str = new_name_opt
    if new_name_opt.is_none then
        "Expected option value while unwrapping newName params json_get_str" exit_with_lsp_error
    fi
    new_name_opt.unwrap = new_name

    message extract_position = position
    new_name.as_str position LspRange::start_col position LspRange::start_line document compute_rename = edits_opt
    if edits_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    edits_opt.unwrap = edits_map

    # Convert to JSON changes object
    json_object = changes
    edits_map.keys = change_uris
    for change_uri in change_uris.iter do
        change_uri edits_map.get.unwrap = edit_list
        List[JsonValue]::new = edit_json_list
        0 (u64) = edit_index
        while edit_index edit_list.length > do
            edit_index edit_list.get.to_json edit_json_list.push
            1 += edit_index
        done
        changes change_uri.clone edit_json_list JsonValue::JsonArray json_set = changes
    done

    json_object
    "changes".to_str changes JsonValue::JsonObject json_set
    JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Semantic tokens handler
# ============================================================================

fn map_document_token_type kind:DocumentTokenKind -> i64 {
    kind match
        DocumentTokenKind::Function => TOKEN_FUNCTION
        DocumentTokenKind::Variable => TOKEN_VARIABLE
        DocumentTokenKind::String => TOKEN_STRING
        DocumentTokenKind::Number => TOKEN_NUMBER
        DocumentTokenKind::Keyword => TOKEN_KEYWORD
        DocumentTokenKind::Operator => TOKEN_OPERATOR
        DocumentTokenKind::Type => TOKEN_TYPE
        DocumentTokenKind::EnumMember => TOKEN_ENUM_MEMBER
        DocumentTokenKind::Struct => TOKEN_STRUCT
        DocumentTokenKind::Macro => TOKEN_MACRO
    end
}

fn compute_semantic_tokens state:$AnalyzedDocument -> List[SemanticToken] {
    List[SemanticToken]::new = tokens
    for document_token in state.find_semantic_tokens.iter do
        document_token.location = location: $DocumentLocation
        location state.sources convert_document_location_to_lsp.range.clone = range
        0
        document_token.kind copy map_document_token_type
        location.length
        range.start_col
        range.start_line
        SemanticToken tokens.push
    done
    tokens
}

fn handle_semantic_tokens message:$JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        json_object
        "data".to_str List[JsonValue]::new JsonValue::JsonArray json_set
        JsonValue::JsonObject request_id send_response
        return
    fi
    document_opt.unwrap = document

    document compute_semantic_tokens = tokens

    # Delta-encode
    List[JsonValue]::new = encoded_data
    0 = prev_line
    0 = prev_col
    for token in tokens.iter do
        token SemanticToken::line prev_line - = delta_line
        if 0 delta_line == then
            token SemanticToken::col prev_col -
        else
            token SemanticToken::col
        fi
        = delta_col
        delta_line JsonValue::JsonInt encoded_data.push
        delta_col JsonValue::JsonInt encoded_data.push
        token SemanticToken::length(i64) JsonValue::JsonInt encoded_data.push
        token SemanticToken::token_type JsonValue::JsonInt encoded_data.push
        token SemanticToken::modifiers JsonValue::JsonInt encoded_data.push
        token SemanticToken::line = prev_line
        token SemanticToken::col = prev_col
    done

    json_object
    "data".to_str encoded_data JsonValue::JsonArray json_set
    JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Server initialization and main loop
# ============================================================================

fn extract_library_paths message:$JsonValue -> List[String] {
    List[String]::new = paths
    "params" message json_get_object = params_option
    if params_option.is_none then
        paths return
    fi
    params_option.unwrap = params
    "initializationOptions" params json_get_object = init_options_option
    if init_options_option.is_none then
        paths return
    fi
    init_options_option.unwrap = init_options
    "libraryPaths" init_options json_get_array = library_paths_option
    if library_paths_option.is_none then
        paths return
    fi
    library_paths_option.unwrap = library_paths_array
    for path_value in library_paths_array.iter do
        if path_value JsonValue::JsonString(path_string) is then
            path_string.clone paths.push
        fi
    done
    paths
}

fn handle_initialize message:$JsonValue state:mut$LspState {
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    message extract_library_paths = state.library_paths

    # Build semantic tokens legend
    List[JsonValue]::new = token_types
    "function".to_str JsonValue::JsonString token_types.push
    "variable".to_str JsonValue::JsonString token_types.push
    "string".to_str JsonValue::JsonString token_types.push
    "number".to_str JsonValue::JsonString token_types.push
    "keyword".to_str JsonValue::JsonString token_types.push
    "operator".to_str JsonValue::JsonString token_types.push
    "type".to_str JsonValue::JsonString token_types.push
    "enumMember".to_str JsonValue::JsonString token_types.push
    "struct".to_str JsonValue::JsonString token_types.push
    "macro".to_str JsonValue::JsonString token_types.push

    # Trigger characters for completion
    List[JsonValue]::new = triggers
    ".".to_str JsonValue::JsonString triggers.push
    ":".to_str JsonValue::JsonString triggers.push

    json_object
    "serverInfo".to_str json_object
    "name".to_str "casa-language-server".to_str JsonValue::JsonString json_set
    "version".to_str "0.1.0".to_str JsonValue::JsonString json_set
    JsonValue::JsonObject json_set
    "capabilities".to_str json_object
    "textDocumentSync".to_str 1 JsonValue::JsonInt json_set
    "definitionProvider".to_str true JsonValue::JsonBool json_set
    "hoverProvider".to_str true JsonValue::JsonBool json_set
    "completionProvider".to_str json_object
    "triggerCharacters".to_str triggers JsonValue::JsonArray json_set
    JsonValue::JsonObject json_set
    "referencesProvider".to_str true JsonValue::JsonBool json_set
    "renameProvider".to_str true JsonValue::JsonBool json_set
    "semanticTokensProvider".to_str json_object
    "legend".to_str json_object
    "tokenTypes".to_str token_types JsonValue::JsonArray json_set
    "tokenModifiers".to_str List[JsonValue]::new JsonValue::JsonArray json_set
    JsonValue::JsonObject json_set
    "full".to_str true JsonValue::JsonBool json_set
    JsonValue::JsonObject json_set
    JsonValue::JsonObject json_set
    JsonValue::JsonObject request_id send_response
}

fn handle_shutdown message:$JsonValue {
    if "id" message json_get_value Option::Some(request_id) is then
        JsonValue::JsonNull request_id send_response
    else
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
}

fn handle_exit message:$JsonValue { 0 exit }

fn dispatch_message message:$JsonValue state:mut$LspState {
    "method" message json_get_str = method_opt
    if method_opt.is_none then
        return
    fi
    method_opt.unwrap = method

    if "initialize" method == then
        state message handle_initialize
    elif "shutdown" method == then
        message handle_shutdown
    elif "exit" method == then
        message handle_exit
    elif "textDocument/didOpen" method == then
        state message handle_did_open
    elif "textDocument/didChange" method == then
        state message handle_did_change
    elif "textDocument/didSave" method == then
        state message handle_did_save
    elif "textDocument/definition" method == then
        state message handle_definition
    elif "textDocument/hover" method == then
        state message handle_hover
    elif "textDocument/completion" method == then
        state message handle_completion
    elif "textDocument/references" method == then
        state message handle_references
    elif "textDocument/rename" method == then
        state message handle_rename
    elif "textDocument/semanticTokens/full" method == then
        state message handle_semantic_tokens
    fi
}

fn main {
    LspState::new = state
    while true do
        state.reader read_message = msg_opt
        if msg_opt.is_none then
            break
        fi
        if msg_opt Option::Some(message) is then
            state message dispatch_message
        fi
    done
}
main
