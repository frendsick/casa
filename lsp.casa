# Casa Language Server
#
# LSP server implementation for the Casa language, providing diagnostics,
# go-to-definition, hover, completion, references, rename, and semantic tokens.
# Communicates via JSON-RPC over stdin/stdout.
import "lib/std.casa"
import "lib/os.casa"
import "lib/parser.casa"
import "lib/json.casa"
import "lib/io.casa"
import "compiler/common.casa"
import "compiler/error.casa"
import "compiler/lexer.casa"
import "compiler/syntax.casa"
import "compiler/typechecker.casa"
import "compiler/analysis.casa"
import "compiler/document.casa"

# ============================================================================
# LSP structs
# ============================================================================

struct LspRange {
    start_line: int
    start_col:  int
    end_line:   int
    end_col:    int
}

struct LspLocation {
    uri:   str
    range: LspRange
}

struct LspDiagnostic {
    range:    LspRange
    message:  str
    severity: int
}

struct CompletionItem {
    label:  str
    kind:   int
    detail: str
}

struct SemanticToken {
    line:       int
    col:        int
    length:     int
    token_type: int
    modifiers:  int
}

struct TextEdit {
    range:    LspRange
    new_text: str
}

struct HoverContent {
    content: str
    range:   LspRange
}

struct CompileResult {
    document: AnalyzedDocument
    analysis: AnalysisResult
}

# ============================================================================
# LSP constants
# ============================================================================
const DIAGNOSTIC_ERROR 1
const DIAGNOSTIC_WARNING 2
const COMPLETION_METHOD 2
const COMPLETION_FUNCTION 3
const COMPLETION_VARIABLE 6
const COMPLETION_ENUM 13
const COMPLETION_KEYWORD 14
const COMPLETION_STRUCT 22
const COMPLETION_ENUM_MEMBER 20
# Semantic token types
const TOKEN_FUNCTION 0
const TOKEN_VARIABLE 1
const TOKEN_STRING 2
const TOKEN_NUMBER 3
const TOKEN_KEYWORD 4
const TOKEN_OPERATOR 5
const TOKEN_TYPE 6
const TOKEN_ENUM_MEMBER 7
const TOKEN_STRUCT 8
const TOKEN_MACRO 9
List::new(List[str]) = LSP_LIBRARY_PATHS

# ============================================================================
# Global state
# ============================================================================
Map::new(Map[str AnalyzedDocument]) = OPEN_DOCUMENTS
StdinReader::new = STDIN_READER

# ============================================================================
# Coordinate conversion utilities
# ============================================================================

fn offset_to_lsp_range source:str offset:int length:int -> LspRange {
    if 1 length < then 1 = length fi
    offset source offset_to_line_col 1 - = start_line
    offset source offset_to_col 1 - = start_col
    offset length + = end_offset
    end_offset source offset_to_line_col 1 - = end_line
    end_offset source offset_to_col 1 - = end_col
    end_col end_line start_col start_line LspRange
}

fn uri_to_path uri:str -> str {
    # Strip file:// prefix
    if uri "file://" str::starts_with then
        uri 7 uri.length 7 - str::substring
    else
        uri
    fi
}

fn path_to_uri path:str -> str {
    f"file://{path}"
}

# ============================================================================
# JSON builders for LSP types
# ============================================================================

impl LspRange {
    fn to_json range:LspRange -> JsonValue {
        json_object
        "line" range LspRange::start_line JsonValue::JsonInt json_set
        "character" range LspRange::start_col JsonValue::JsonInt json_set
        JsonValue::JsonObject = start_json
        json_object
        "line" range LspRange::end_line JsonValue::JsonInt json_set
        "character" range LspRange::end_col JsonValue::JsonInt json_set
        JsonValue::JsonObject = end_json
        json_object
        "start" start_json json_set
        "end" end_json json_set
        JsonValue::JsonObject
    }
}

impl LspLocation {
    fn to_json loc:LspLocation -> JsonValue {
        loc LspLocation::range = loc_range
        json_object
        "uri" loc LspLocation::uri JsonValue::JsonString json_set
        "range" loc_range.to_json json_set
        JsonValue::JsonObject
    }
}

impl LspDiagnostic {
    fn to_json diag:LspDiagnostic -> JsonValue {
        diag LspDiagnostic::range = diag_range
        json_object
        "range" diag_range.to_json json_set
        "message" diag LspDiagnostic::message JsonValue::JsonString json_set
        "severity" diag LspDiagnostic::severity JsonValue::JsonInt json_set
        "source" "casa" JsonValue::JsonString json_set
        JsonValue::JsonObject
    }
}

impl CompletionItem {
    fn to_json item:CompletionItem -> JsonValue {
        json_object = result_obj
        result_obj "label" item CompletionItem::label JsonValue::JsonString json_set = result_obj
        result_obj "kind" item CompletionItem::kind JsonValue::JsonInt json_set = result_obj
        if "" item CompletionItem::detail != then
            result_obj "detail" item CompletionItem::detail JsonValue::JsonString json_set = result_obj
        fi
        result_obj JsonValue::JsonObject
    }
}

impl TextEdit {
    fn to_json edit:TextEdit -> JsonValue {
        edit TextEdit::range = edit_range
        json_object
        "range" edit_range.to_json json_set
        "newText" edit TextEdit::new_text JsonValue::JsonString json_set
        JsonValue::JsonObject
    }
}

# ============================================================================
# JSON-RPC protocol layer
# ============================================================================

fn exit_with_lsp_error message:str {
    f"[LSP] {message}\n" eprint
    1 exit
}

fn read_message reader:StdinReader -> Option[JsonValue] {
    Option::None(Option[int]) = content_length
    # Read headers until empty line
    while true do
        reader stdin_read_line = header_line
        if 0 header_line.length == then
            break
        fi
        if header_line "Content-Length: " str::starts_with then
            header_line 16 header_line.length 16 - str::substring str_to_int Option::Some = content_length
        fi
    done
    if content_length.is_none then
        Option::None(Option[JsonValue])
        return
    fi
    content_length.unwrap = length
    length reader stdin_read_exact = body
    body Cursor::new = cursor
    cursor json_parse = parse_result
    if parse_result.is_error then
        Option::None(Option[JsonValue])
    elif parse_result Result::Ok(parsed) is then
        parsed Option::Some
    else
        Option::None(Option[JsonValue])
    fi
}

fn send_json_rpc body:str {
    body.length = body_length
    f"Content-Length: {body_length}\r\n\r\n{body}" stdout_write
}

fn send_response id:JsonValue result:JsonValue {
    json_object
    "jsonrpc" "2.0" JsonValue::JsonString json_set
    "id" id json_set
    "result" result json_set
    JsonValue::JsonObject json_serialize send_json_rpc
}

fn send_notification method:str params:JsonValue {
    json_object
    "jsonrpc" "2.0" JsonValue::JsonString json_set
    "method" method JsonValue::JsonString json_set
    "params" params json_set
    JsonValue::JsonObject json_serialize send_json_rpc
}

# ============================================================================
# Compilation pipeline
# ============================================================================

fn compile_document file_path:str source:str open_docs:Map[str AnalyzedDocument] -> CompileResult {
    source file_path AnalysisInput::new = input
    LSP_LIBRARY_PATHS = input.library_paths
    open_docs.keys = uris
    for uri in uris.iter do
        uri open_docs.get.unwrap = cached_state
        if cached_state.file_path file_path != then
            cached_state.source cached_state.file_path input.source_overrides.set = input.source_overrides
        fi
    done
    input analyze = analysis

    file_path source analysis AnalyzedDocument::new = state

    analysis
    state
    CompileResult
}

fn ingest_document_into
    uri:str
    source:str
    open_docs:Map[str AnalyzedDocument]
-> List[LspDiagnostic] Map[str AnalyzedDocument] {
    uri uri_to_path = path
    open_docs source path compile_document = result
    result.document uri open_docs.set = open_docs
    path result diagnostics_from
    open_docs
}

fn ingest_document uri:str source:str -> List[LspDiagnostic] {
    global OPEN_DOCUMENTS
    OPEN_DOCUMENTS source uri ingest_document_into = OPEN_DOCUMENTS = diagnostics
    diagnostics
}

fn diagnostics_from result:CompileResult path:str -> List[LspDiagnostic] {
    result.analysis.diagnostics = compiler_diagnostics
    result.analysis.sources.sources = source_map
    result.document.source = fallback_source

    List::new(List[LspDiagnostic]) = diagnostics

    for diagnostic in compiler_diagnostics.entries.iter do
        if diagnostic Diagnostic::Error(error) is then
            if
            "" error CasaError::location Location::file !=
            error CasaError::location Location::file path != &&
            then
                continue
            fi
            fallback_source = error_source
            error CasaError::location Location::file source_map.get = source_opt
            if source_opt.is_some then
                source_opt.unwrap = error_source
            fi

            # Build message
            StringBuilder::new = msg_builder
            error CasaError::message msg_builder.append
            if error.expected Option::Some(expected) is then
                "\nExpected: " msg_builder.append
                expected msg_builder.append
            fi
            if error CasaError::got Option::Some(got) is then
                "\n" msg_builder.append
                error CasaError::got_label msg_builder.append
                ": " msg_builder.append
                got msg_builder.append
            fi

            DIAGNOSTIC_ERROR
            msg_builder.build
            error CasaError::location Location::span Span::length
            error CasaError::location Location::span Span::offset
            error_source offset_to_lsp_range
            LspDiagnostic diagnostics.push
        elif diagnostic Diagnostic::Warning(warning) is then
            if
            "" warning CasaWarning::location Location::file !=
            warning CasaWarning::location Location::file path != &&
            then
                continue
            fi
            fallback_source = warn_source
            warning CasaWarning::location Location::file source_map.get = warn_source_opt
            if warn_source_opt.is_some then
                warn_source_opt.unwrap = warn_source
            fi
            DIAGNOSTIC_WARNING
            warning CasaWarning::message
            warning CasaWarning::location Location::span Span::length
            warning CasaWarning::location Location::span Span::offset
            warn_source offset_to_lsp_range
            LspDiagnostic diagnostics.push
        fi
    done

    diagnostics
}

fn publish_diagnostics uri:str diagnostics:List[LspDiagnostic] {
    List::new(List[JsonValue]) = json_array
    for diagnostic in diagnostics.iter do
        diagnostic.to_json json_array.push
    done
    json_object
    "uri" uri JsonValue::JsonString json_set
    "diagnostics" json_array JsonValue::JsonArray json_set
    JsonValue::JsonObject = params
    params "textDocument/publishDiagnostics" send_notification
}

fn convert_document_location_to_lsp location:DocumentLocation -> LspLocation {
    location.length location.offset location.source offset_to_lsp_range
    location.file path_to_uri
    LspLocation
}

# ============================================================================
# Diagnostics handler
# ============================================================================

fn extract_uri message:JsonValue -> str {
    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "textDocument" params json_get_object = text_document_opt
    if text_document_opt.is_none then
        "Expected option value while unwrapping textDocument params json_get_object" exit_with_lsp_error
    fi
    text_document_opt.unwrap = text_document
    if "uri" text_document json_get_str Option::Some(uri) is then
        uri return
    fi
    "Expected option value while unwrapping uri text_document json_get_str" exit_with_lsp_error
    ""
}

fn extract_position message:JsonValue -> LspRange {
    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "position" params json_get_object = position_opt
    if position_opt.is_none then
        "Expected option value while unwrapping position params json_get_object" exit_with_lsp_error
    fi
    position_opt.unwrap = position
    "line" position json_get_int = line_opt
    if line_opt.is_none then
        "Expected option value while unwrapping line position json_get_int" exit_with_lsp_error
    fi
    line_opt.unwrap = line
    "character" position json_get_int = character_opt
    if character_opt.is_none then
        "Expected option value while unwrapping character position json_get_int" exit_with_lsp_error
    fi
    character_opt.unwrap = character
    0 0 character line LspRange
}

fn handle_did_open message:JsonValue {
    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "textDocument" params json_get_object = text_document_opt
    if text_document_opt.is_none then
        "Expected option value while unwrapping textDocument params json_get_object" exit_with_lsp_error
    fi
    text_document_opt.unwrap = text_document
    "uri" text_document json_get_str = uri_opt
    if uri_opt.is_none then
        "Expected option value while unwrapping uri text_document json_get_str" exit_with_lsp_error
    fi
    uri_opt.unwrap = uri
    "text" text_document json_get_str = text_opt
    if text_opt.is_none then
        "Expected option value while unwrapping text text_document json_get_str" exit_with_lsp_error
    fi
    text_opt.unwrap = text
    text uri ingest_document = diagnostics
    diagnostics uri publish_diagnostics
}

fn handle_did_change message:JsonValue {
    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "textDocument" params json_get_object = text_document_opt
    if text_document_opt.is_none then
        "Expected option value while unwrapping textDocument params json_get_object" exit_with_lsp_error
    fi
    text_document_opt.unwrap = text_document
    "uri" text_document json_get_str = uri_opt
    if uri_opt.is_none then
        "Expected option value while unwrapping uri text_document json_get_str" exit_with_lsp_error
    fi
    uri_opt.unwrap = uri
    "contentChanges" params json_get_array = changes_opt
    if changes_opt.is_none then
        "Expected option value while unwrapping contentChanges params json_get_array" exit_with_lsp_error
    fi
    changes_opt.unwrap = changes
    0 changes.get = change
    "text" change json_get_str = text_opt
    if text_opt.is_none then
        "Expected option value while unwrapping text change json_get_str" exit_with_lsp_error
    fi
    text_opt.unwrap = text
    text uri ingest_document = diagnostics
    diagnostics uri publish_diagnostics
}

fn handle_did_save message:JsonValue {
    message extract_uri = uri
    uri uri_to_path file::read_all = read_result
    if read_result Result::Error(read_err) is then
        f"error: handle_did_save read failed for {uri}: {read_err.to_str}" eprintln
        return
    fi
    read_result.unwrap = saved_source
    saved_source uri ingest_document = diagnostics
    diagnostics uri publish_diagnostics
}

# ============================================================================
# Go-to-definition handler
# ============================================================================

fn compute_definition state:AnalyzedDocument line:int column:int -> Option[LspLocation] {
    if column line state.find_definition_at Option::Some(location) is then
        location convert_document_location_to_lsp Option::Some
    else
        Option::None(Option[LspLocation])
    fi
}

fn handle_definition message:JsonValue {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri OPEN_DOCUMENTS.get = state_opt
    if state_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    state_opt.unwrap = state

    message extract_position = position
    position LspRange::start_col position LspRange::start_line state compute_definition = loc_opt
    if loc_opt Option::Some(loc) is then
        loc.to_json request_id send_response
    else
        JsonValue::JsonNull request_id send_response
    fi
}

# ============================================================================
# Hover handler
# ============================================================================

fn format_hover symbol:DocumentElement state:AnalyzedDocument -> Option[str] {
    symbol.op = op
    op.value = op_value

    # Function call/push
    if op_value OpValue::FnCall is op_value OpValue::FnPush is || then
        op op_str_value state.lookup_function = fn_opt
        if fn_opt Option::Some(hover_func) is then
            StringBuilder::new = builder
            "fn " builder.append
            hover_func Function::name builder.append
            # Parameters
            if 0 hover_func Function::stack_effect StackEffect::parameters.length != then
                " " builder.append
                0 = param_index
                while param_index hover_func Function::stack_effect StackEffect::parameters.length > do
                    if 0 param_index != then " " builder.append fi
                    param_index hover_func Function::stack_effect StackEffect::parameters.get = param
                    if "" param Parameter::name != then
                        param Parameter::name builder.append
                        ":" builder.append
                    fi
                    param Parameter::typ.format builder.append
                    1 += param_index
                done
            fi
            " -> " builder.append
            if 0 hover_func Function::stack_effect StackEffect::return_types.length != then
                0 = return_index
                while return_index hover_func Function::stack_effect StackEffect::return_types.length > do
                    if 0 return_index != then " " builder.append fi
                    return_index hover_func Function::stack_effect StackEffect::return_types.get.format builder.append
                    1 += return_index
                done
            else
                "None" builder.append
            fi
            builder.build Option::Some
            return
        fi
        Option::None(Option[str])
        return
    fi

    # Variables
    if op_value OpValue::PushVar is op_value OpValue::PushCapture is || then
        op op_str_value = var_name
        symbol state.find_symbol_type = var_type
        if var_type Option::Some(resolved_var_type) is then
            f"{var_name}: {resolved_var_type.format}" Option::Some
        else
            var_name Option::Some
        fi
        return
    fi

    # Struct new
    if op_value OpValue::StructNew(struct_val) is then
        struct_val format_struct_hover Option::Some return
    fi

    # Enum variant
    if op_value OpValue::PushEnumVariant(variant) is then
        f"{variant EnumVariant::enum_name}::{variant EnumVariant::variant_name}" Option::Some
        return
    fi

    # Literals
    if op_value OpValue::PushInt(int_value) is then
        f"(int) {int_value}" Option::Some
        return
    fi
    if op_value OpValue::PushStr(str_value) is then
        f"(str) \"{str_value}\"" Option::Some
        return
    fi
    if op_value OpValue::PushBool(bool_value) is then
        if bool_value 0 != then
            "(bool) true" Option::Some
        else
            "(bool) false" Option::Some
        fi
        return
    fi
    if op_value OpValue::PushChar(char_value) is then
        # Build char string manually
        10 alloc (str) = char_buf
        1 char_buf (ptr) store64
        char_value (char) 0 char_buf.set
        0 (char) 1 char_buf.set
        f"(char) '{char_buf}'" Option::Some
        return
    fi

    # Assignment
    if op_value OpValue::AssignVar(assign_name) is then
        symbol state.find_symbol_type = assign_type
        if assign_type Option::Some(resolved_assign_type) is then
            f"= {assign_name}: {resolved_assign_type.format}" Option::Some
        else
            f"= {assign_name}" Option::Some
        fi
        return
    fi

    # Stack effects
    op_value op_value_stack_effect = effect_opt
    if effect_opt Option::Some(effect) is then
        effect Option::Some
        return
    fi

    Option::None(Option[str])
}

fn format_struct_hover hover_struct:CasaStruct -> str {
    StringBuilder::new = struct_builder
    "struct " struct_builder.append
    hover_struct CasaStruct::name struct_builder.append
    " { " struct_builder.append
    0 = member_index
    while member_index hover_struct CasaStruct::members.length > do
        if 0 member_index != then ", " struct_builder.append fi
        member_index hover_struct CasaStruct::members.get = member
        member Member::name struct_builder.append
        ": " struct_builder.append
        member Member::typ.format struct_builder.append
        1 += member_index
    done
    " }" struct_builder.append
    struct_builder.build
}

fn format_enum_hover hover_enum:CasaEnum -> str {
    StringBuilder::new = enum_builder
    "enum " enum_builder.append
    hover_enum CasaEnum::name enum_builder.append
    " { " enum_builder.append
    0 = variant_index
    while variant_index hover_enum CasaEnum::variants.length > do
        if 0 variant_index != then ", " enum_builder.append fi
        variant_index hover_enum CasaEnum::variants.get enum_builder.append
        1 += variant_index
    done
    " }" enum_builder.append
    enum_builder.build
}

fn format_qualified_member_hover
    symbol:DocumentElement
    state:AnalyzedDocument
    range:LspRange
-> Option[HoverContent] {
    if state symbol format_hover Option::Some(content) is then
        range f"```casa\n{content}\n```" HoverContent Option::Some
    else
        Option::None(Option[HoverContent])
    fi
}

fn get_hover_range symbol:DocumentElement state:AnalyzedDocument -> LspRange {
    symbol.location state.locate convert_document_location_to_lsp = location
    location.range
}

fn format_type_hover name:str state:AnalyzedDocument -> Option[str] {
    if name state.lookup_struct Option::Some(hover_struct) is then
        hover_struct format_struct_hover Option::Some return
    fi
    if name state.lookup_enum Option::Some(hover_enum) is then
        hover_enum format_enum_hover Option::Some return
    fi
    Option::None(Option[str])
}

fn format_general_symbol_hover
    symbol:DocumentElement
    state:AnalyzedDocument
-> Option[HoverContent] {
    if state symbol format_hover Option::Some(content) is then
        state symbol get_hover_range = hover_range
        hover_range f"```casa\n{content}\n```" HoverContent Option::Some
    else
        Option::None(Option[HoverContent])
    fi
}

fn format_qualified_callable_hover
    symbol:DocumentElement
    state:AnalyzedDocument
-> Option[HoverContent] {
    state symbol get_hover_range = range
    symbol.part match
        SymbolPart::TypeName => {
            symbol.op op_str_value "::" str::split = parts
            0 parts.get = type_name
            if state type_name format_type_hover Option::Some(content) is then
                range f"```casa\n{content}\n```" HoverContent Option::Some
            else
                Option::None(Option[HoverContent])
            fi
        }
        SymbolPart::MemberName => range state symbol format_qualified_member_hover
        _ => Option::None(Option[HoverContent])
    end
}

fn format_qualified_enum_hover
    symbol:DocumentElement
    state:AnalyzedDocument
    variant:EnumVariant
-> Option[HoverContent] {
    state symbol get_hover_range = range
    symbol.part match
        SymbolPart::TypeName => {
            if variant.enum_name state.lookup_enum Option::Some(hover_enum) is then
                hover_enum format_enum_hover = content
                range f"```casa\n{content}\n```" HoverContent Option::Some
            else
                Option::None(Option[HoverContent])
            fi
        }
        SymbolPart::MemberName => {
            f"{variant.enum_name}::{variant.variant_name}" = content
            range f"```casa\n{content}\n```" HoverContent Option::Some
        }
        _ => Option::None(Option[HoverContent])
    end
}

fn format_qualified_symbol_hover
    symbol:DocumentElement
    state:AnalyzedDocument
-> Option[HoverContent] {
    symbol.op.value match
        OpValue::FnCall(_) => state symbol format_qualified_callable_hover
        OpValue::FnPush(_) => state symbol format_qualified_callable_hover
        OpValue::PushEnumVariant(variant) => variant state symbol format_qualified_enum_hover
        _ => Option::None(Option[HoverContent])
    end
}

fn compute_symbol_hover symbol:DocumentElement state:AnalyzedDocument -> Option[HoverContent] {
    symbol.part match
        SymbolPart::Whole => state symbol format_general_symbol_hover
        SymbolPart::TypeName => state symbol format_qualified_symbol_hover
        SymbolPart::MemberName => state symbol format_qualified_symbol_hover
        SymbolPart::Separator => Option::None(Option[HoverContent])
    end
}

fn compute_hover state:AnalyzedDocument line:int column:int -> Option[HoverContent] {
    if column line state.find_symbol_at Option::Some(symbol) is then
        state symbol compute_symbol_hover
    else
        Option::None(Option[HoverContent])
    fi
}

fn handle_hover message:JsonValue {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri OPEN_DOCUMENTS.get = state_opt
    if state_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    state_opt.unwrap = state

    message extract_position = position
    position LspRange::start_col position LspRange::start_line state compute_hover = hover_opt
    if hover_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    hover_opt.unwrap = hover
    json_object
    "contents" json_object
    "kind" "markdown" JsonValue::JsonString json_set
    "value" hover HoverContent::content JsonValue::JsonString json_set
    JsonValue::JsonObject json_set
    "range" hover HoverContent::range.to_json json_set
    JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Completion handler
# ============================================================================

fn format_completion_candidate candidate:CompletionCandidate -> CompletionItem {
    candidate match
        CompletionCandidate::Function(function) => {
            "" COMPLETION_FUNCTION function.name CompletionItem
        }
        CompletionCandidate::Variable(variable) => {
            variable.typ.format COMPLETION_VARIABLE variable.name CompletionItem
        }
        CompletionCandidate::Keyword(keyword) => {
            "" COMPLETION_KEYWORD keyword.format_source CompletionItem
        }
        CompletionCandidate::Intrinsic(intrinsic) => {
            "" COMPLETION_KEYWORD intrinsic.format_source CompletionItem
        }
        CompletionCandidate::Struct(casa_struct) => {
            StringBuilder::new = member_builder
            0 = member_index
            while member_index casa_struct.members.length > do
                if 0 member_index != then ", " member_builder.append fi
                member_index casa_struct.members.get = member
                member.name member_builder.append
                ": " member_builder.append
                member.typ.format member_builder.append
                1 += member_index
            done
            member_builder.build COMPLETION_STRUCT casa_struct.name CompletionItem
        }
        CompletionCandidate::Enum(casa_enum) => {
            "" COMPLETION_ENUM casa_enum.name CompletionItem
        }
        CompletionCandidate::EnumVariant(variant_name) => {
            "" COMPLETION_ENUM_MEMBER variant_name CompletionItem
        }
        CompletionCandidate::Method(function) => {
            "" COMPLETION_METHOD function.name "::" str::split.pop CompletionItem
        }
    end
}

fn compute_completion
    state:AnalyzedDocument
    line:int
    column:int
    trigger:str
-> List[CompletionItem] {
    List::new(List[CompletionItem]) = items
    trigger column line state.find_completion_candidates = candidates
    for candidate in candidates.iter do
        candidate format_completion_candidate items.push
    done
    items
}

fn handle_completion message:JsonValue {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri OPEN_DOCUMENTS.get = state_opt
    if state_opt.is_none then
        json_object
        "isIncomplete" false JsonValue::JsonBool json_set
        "items" List::new(List[JsonValue]) JsonValue::JsonArray json_set
        JsonValue::JsonObject request_id send_response
        return
    fi
    state_opt.unwrap = state

    # Check trigger character
    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "context" params json_get_object = context_opt
    "" = trigger
    if context_opt Option::Some(context) is then
        "triggerCharacter" context json_get_str = trigger_opt
        if trigger_opt.is_some then
            trigger_opt.unwrap = trigger
        fi
    fi

    message extract_position = position
    trigger position LspRange::start_col position LspRange::start_line state compute_completion = items

    # Build response
    List::new(List[JsonValue]) = json_items
    for completion_item in items.iter do
        completion_item.to_json json_items.push
    done
    json_object
    "isIncomplete" false JsonValue::JsonBool json_set
    "items" json_items JsonValue::JsonArray json_set
    JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Find references handler
# ============================================================================

fn compute_references
    state:AnalyzedDocument
    line:int
    column:int
    include_declaration:bool
-> Option[List[LspLocation]] {
    if include_declaration column line state.find_references_at Option::Some(document_references) is then
        List::new(List[LspLocation]) = references
        for document_reference in document_references.iter do
            document_reference convert_document_location_to_lsp references.push
        done
        references Option::Some return
    fi
    Option::None(Option[List[LspLocation]])
}

fn handle_references message:JsonValue {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri OPEN_DOCUMENTS.get = state_opt
    if state_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    state_opt.unwrap = state

    # includeDeclaration
    Option::None(Option[JsonValue]) = context_opt
    if "params" message json_get_object Option::Some(params) is then
        "context" params json_get_object = context_opt
    fi
    true = include_decl
    if context_opt Option::Some(context) is then
        "includeDeclaration" context json_get_bool = include_decl_opt
        if include_decl_opt.is_some then
            include_decl_opt.unwrap = include_decl
        fi
    fi

    message extract_position = position
    include_decl position LspRange::start_col position LspRange::start_line state compute_references = refs_opt
    if refs_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    refs_opt.unwrap = refs
    List::new(List[JsonValue]) = json_refs
    for ref_loc in refs.iter do
        ref_loc.to_json json_refs.push
    done
    json_refs JsonValue::JsonArray request_id send_response
}

# ============================================================================
# Rename handler
# ============================================================================

fn compute_rename
    state:AnalyzedDocument
    line:int
    column:int
    new_name:str
-> Option[Map[str List[TextEdit]]] {
    if true column line state.find_references_at Option::Some(document_references) is then
        Map::new(Map[str List[TextEdit]]) = edits_map
        for document_reference in document_references.iter do
            document_reference convert_document_location_to_lsp = reference_location
            reference_location.uri = reference_uri
            reference_location.range = edit_range

            new_name edit_range TextEdit = edit
            reference_uri edits_map.get = existing_edits
            if existing_edits Option::Some(edits) is then
                edit edits.push
            else
                List::new(List[TextEdit]) = document_edits
                edit document_edits.push
                document_edits reference_uri edits_map.set = edits_map
            fi
        done
        edits_map Option::Some return
    fi
    Option::None(Option[Map[str List[TextEdit]]])
}

fn handle_rename message:JsonValue {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri OPEN_DOCUMENTS.get = state_opt
    if state_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    state_opt.unwrap = state

    "params" message json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "newName" params json_get_str = new_name_opt
    if new_name_opt.is_none then
        "Expected option value while unwrapping newName params json_get_str" exit_with_lsp_error
    fi
    new_name_opt.unwrap = new_name

    message extract_position = position
    new_name position LspRange::start_col position LspRange::start_line state compute_rename = edits_opt
    if edits_opt.is_none then
        JsonValue::JsonNull request_id send_response
        return
    fi
    edits_opt.unwrap = edits_map

    # Convert to JSON changes object
    json_object = changes
    edits_map.keys = change_uris
    for change_uri in change_uris.iter do
        change_uri edits_map.get.unwrap = edit_list
        List::new(List[JsonValue]) = edit_json_list
        for edit_item in edit_list.iter do
            edit_item.to_json edit_json_list.push
        done
        changes change_uri edit_json_list JsonValue::JsonArray json_set = changes
    done

    json_object
    "changes" changes JsonValue::JsonObject json_set
    JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Semantic tokens handler
# ============================================================================

fn map_document_token_type kind:DocumentTokenKind -> int {
    kind match
        DocumentTokenKind::Function => TOKEN_FUNCTION
        DocumentTokenKind::Variable => TOKEN_VARIABLE
        DocumentTokenKind::String => TOKEN_STRING
        DocumentTokenKind::Number => TOKEN_NUMBER
        DocumentTokenKind::Keyword => TOKEN_KEYWORD
        DocumentTokenKind::Operator => TOKEN_OPERATOR
        DocumentTokenKind::Type => TOKEN_TYPE
        DocumentTokenKind::EnumMember => TOKEN_ENUM_MEMBER
        DocumentTokenKind::Struct => TOKEN_STRUCT
        DocumentTokenKind::Macro => TOKEN_MACRO
    end
}

fn compute_semantic_tokens state:AnalyzedDocument -> List[SemanticToken] {
    List::new(List[SemanticToken]) = tokens
    for document_token in state.find_semantic_tokens.iter do
        document_token.location = location
        location.offset location.source offset_to_line_col 1 - = line
        location.offset location.source offset_to_col 1 - = column
        0
        document_token.kind map_document_token_type
        location.length
        column
        line
        SemanticToken tokens.push
    done
    tokens
}

fn handle_semantic_tokens message:JsonValue {
    message extract_uri = uri
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri OPEN_DOCUMENTS.get = state_opt
    if state_opt.is_none then
        json_object
        "data" List::new(List[JsonValue]) JsonValue::JsonArray json_set
        JsonValue::JsonObject request_id send_response
        return
    fi
    state_opt.unwrap = state

    state compute_semantic_tokens = tokens

    # Delta-encode
    List::new(List[JsonValue]) = encoded_data
    0 = prev_line
    0 = prev_col
    for token in tokens.iter do
        token SemanticToken::line prev_line - = delta_line
        if 0 delta_line == then
            token SemanticToken::col prev_col -
        else
            token SemanticToken::col
        fi
        = delta_col
        delta_line JsonValue::JsonInt encoded_data.push
        delta_col JsonValue::JsonInt encoded_data.push
        token SemanticToken::length JsonValue::JsonInt encoded_data.push
        token SemanticToken::token_type JsonValue::JsonInt encoded_data.push
        token SemanticToken::modifiers JsonValue::JsonInt encoded_data.push
        token SemanticToken::line = prev_line
        token SemanticToken::col = prev_col
    done

    json_object
    "data" encoded_data JsonValue::JsonArray json_set
    JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Stack effects map initialization
# ============================================================================

fn op_value_stack_effect op_value:OpValue -> Option[str] {
    op_value match
        OpValue::Add => "+: int int -> int" Option::Some
        OpValue::Sub => "-: int int -> int" Option::Some
        OpValue::Mul => "*: int int -> int" Option::Some
        OpValue::Div => "/: int int -> int" Option::Some
        OpValue::Mod => "%: int int -> int" Option::Some
        OpValue::Shl => "<<: int int -> int" Option::Some
        OpValue::Shr => ">>: int int -> int" Option::Some
        OpValue::BitAnd => "&: int int -> int" Option::Some
        OpValue::BitOr => "|: int int -> int" Option::Some
        OpValue::BitXor => "^: int int -> int" Option::Some
        OpValue::BitNot => "~: int -> int" Option::Some
        OpValue::Not => "!: bool -> bool" Option::Some
        OpValue::Eq => "==: [T: Eq] T T -> bool" Option::Some
        OpValue::Ne => "!=: [T: Eq] T T -> bool" Option::Some
        OpValue::Lt => "<: [T: Ord] T T -> bool" Option::Some
        OpValue::Le => "<=: [T: Ord] T T -> bool" Option::Some
        OpValue::Gt => ">: [T: Ord] T T -> bool" Option::Some
        OpValue::Ge => ">=: [T: Ord] T T -> bool" Option::Some
        OpValue::And => "&&: bool bool -> bool" Option::Some
        OpValue::Or => "||: bool bool -> bool" Option::Some
        OpValue::Drop => "drop: T -> None" Option::Some
        OpValue::Dup => "dup: T -> T T" Option::Some
        OpValue::Swap => "swap: T1 T2 -> T2 T1" Option::Some
        OpValue::Over => "over: T1 T2 -> T2 T1 T2" Option::Some
        OpValue::Rot => "rot: T1 T2 T3 -> T3 T1 T2" Option::Some
        OpValue::Print => "print: [T: Display] T -> None" Option::Some
        OpValue::PrintInt => "print: [T: Display] T -> None" Option::Some
        OpValue::PrintStr => "print: [T: Display] T -> None" Option::Some
        OpValue::PrintBool => "print: [T: Display] T -> None" Option::Some
        OpValue::PrintChar => "print: [T: Display] T -> None" Option::Some
        OpValue::PrintCstr => "print: [T: Display] T -> None" Option::Some
        OpValue::FnExec => "exec: fn[...] -> ..." Option::Some
        OpValue::Typeof => "typeof: T -> str" Option::Some
        OpValue::AssignDec(_) => "-=: int -> None" Option::Some
        OpValue::AssignInc(_) => "+=: int -> None" Option::Some
        OpValue::HeapAlloc => "alloc: int -> ptr" Option::Some
        OpValue::Load8 => "load8: ptr -> int" Option::Some
        OpValue::Load16 => "load16: ptr -> int" Option::Some
        OpValue::Load32 => "load32: ptr -> int" Option::Some
        OpValue::Load64 => "load64: ptr -> int" Option::Some
        OpValue::Store8 => "store8[T: Word]: T ptr -> None" Option::Some
        OpValue::Store16 => "store16[T: Word]: T ptr -> None" Option::Some
        OpValue::Store32 => "store32[T: Word]: T ptr -> None" Option::Some
        OpValue::Store64 => "store64[T: Word]: T ptr -> None" Option::Some
        OpValue::Syscall0 => "syscall0: int -> int" Option::Some
        OpValue::Syscall1 => "syscall1[A1: Word]: A1 int -> int" Option::Some
        OpValue::Syscall2 => "syscall2[A1: Word A2: Word]: A1 A2 int -> int" Option::Some
        OpValue::Syscall3 => "syscall3[A1: Word A2: Word A3: Word]: A1 A2 A3 int -> int" Option::Some
        OpValue::Syscall4 => "syscall4[A1: Word A2: Word A3: Word A4: Word]: A1 A2 A3 A4 int -> int" Option::Some
        OpValue::Syscall5 => "syscall5[A1: Word A2: Word A3: Word A4: Word A5: Word]: A1 A2 A3 A4 A5 int -> int" Option::Some
        OpValue::Syscall6 => "syscall6[A1: Word A2: Word A3: Word A4: Word A5: Word A6: Word]: A1 A2 A3 A4 A5 A6 int -> int" Option::Some
        OpValue::Argc => "argc: None -> int" Option::Some
        OpValue::Argv => "argv: None -> ptr" Option::Some
        _ => Option::None(Option[str])
    end
}

# ============================================================================
# Server initialization and main loop
# ============================================================================

fn extract_library_paths message:JsonValue -> List[str] {
    List::new(List[str]) = paths
    "params" message json_get_object = params_option
    if params_option.is_none then paths return fi
    params_option.unwrap = params
    "initializationOptions" params json_get_object = init_options_option
    if init_options_option.is_none then paths return fi
    init_options_option.unwrap = init_options
    "libraryPaths" init_options json_get_array = library_paths_option
    if library_paths_option.is_none then paths return fi
    library_paths_option.unwrap = library_paths_array
    for path_value in library_paths_array.iter do
        if path_value JsonValue::JsonString(path_string) is then
            path_string paths.push
        fi
    done
    paths
}

fn handle_initialize message:JsonValue {
    global LSP_LIBRARY_PATHS
    "id" message json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    message extract_library_paths = LSP_LIBRARY_PATHS

    # Build semantic tokens legend
    List::new(List[JsonValue]) = token_types
    "function" JsonValue::JsonString token_types.push
    "variable" JsonValue::JsonString token_types.push
    "string" JsonValue::JsonString token_types.push
    "number" JsonValue::JsonString token_types.push
    "keyword" JsonValue::JsonString token_types.push
    "operator" JsonValue::JsonString token_types.push
    "type" JsonValue::JsonString token_types.push
    "enumMember" JsonValue::JsonString token_types.push
    "struct" JsonValue::JsonString token_types.push
    "macro" JsonValue::JsonString token_types.push

    # Trigger characters for completion
    List::new(List[JsonValue]) = triggers
    "." JsonValue::JsonString triggers.push
    ":" JsonValue::JsonString triggers.push

    json_object
    "serverInfo" json_object
    "name" "casa-language-server" JsonValue::JsonString json_set
    "version" "0.1.0" JsonValue::JsonString json_set
    JsonValue::JsonObject json_set
    "capabilities" json_object
    "textDocumentSync" 1 JsonValue::JsonInt json_set
    "definitionProvider" true JsonValue::JsonBool json_set
    "hoverProvider" true JsonValue::JsonBool json_set
    "completionProvider" json_object
    "triggerCharacters" triggers JsonValue::JsonArray json_set
    JsonValue::JsonObject json_set
    "referencesProvider" true JsonValue::JsonBool json_set
    "renameProvider" true JsonValue::JsonBool json_set
    "semanticTokensProvider" json_object
    "legend" json_object
    "tokenTypes" token_types JsonValue::JsonArray json_set
    "tokenModifiers" List::new(List[JsonValue]) JsonValue::JsonArray json_set
    JsonValue::JsonObject json_set
    "full" true JsonValue::JsonBool json_set
    JsonValue::JsonObject json_set
    JsonValue::JsonObject json_set
    JsonValue::JsonObject request_id send_response
}

fn handle_shutdown message:JsonValue {
    if "id" message json_get_value Option::Some(request_id) is then
        JsonValue::JsonNull request_id send_response
    else
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
}

fn handle_exit message:JsonValue {
    0 exit
}

fn dispatch_message message:JsonValue {
    "method" message json_get_str = method_opt
    if method_opt.is_none then return fi
    method_opt.unwrap = method

    if "initialize" method == then
        message handle_initialize
    elif "shutdown" method == then
        message handle_shutdown
    elif "exit" method == then
        message handle_exit
    elif "textDocument/didOpen" method == then
        message handle_did_open
    elif "textDocument/didChange" method == then
        message handle_did_change
    elif "textDocument/didSave" method == then
        message handle_did_save
    elif "textDocument/definition" method == then
        message handle_definition
    elif "textDocument/hover" method == then
        message handle_hover
    elif "textDocument/completion" method == then
        message handle_completion
    elif "textDocument/references" method == then
        message handle_references
    elif "textDocument/rename" method == then
        message handle_rename
    elif "textDocument/semanticTokens/full" method == then
        message handle_semantic_tokens
    fi
}

fn main {
    while true do
        STDIN_READER read_message = msg_opt
        if msg_opt.is_none then
            break
        fi
        if msg_opt Option::Some(message) is then
            message dispatch_message
        fi
    done
}
main
