# Casa Language Server
#
# LSP server implementation for the Casa language, providing diagnostics,
# go-to-definition, hover, completion, references, rename, and semantic tokens.
# Communicates via JSON-RPC over stdin/stdout.
import "lib/std.casa" as std
import "lib/os.casa" as os
import "lib/parser.casa" as parser
import "lib/json.casa" as json
import "lib/io.casa" as io
import "compiler/common.casa" as common
import "compiler/error.casa" as error
import "compiler/lexer.casa" as lexer
import "compiler/syntax.casa" as syntax
import "compiler/typechecker.casa" as typechecker
import "compiler/analysis.casa" as analysis
import "compiler/document.casa" as document

# ============================================================================
# LSP structs
# ============================================================================

pub struct LspRange {
    pub start_line: i64
    pub start_col:  i64
    pub end_line:   i64
    pub end_col:    i64
}

impl LspRange: std::Clone {
    pub fn clone self:$LspRange -> LspRange {
        self.end_col self.end_line self.start_col self.start_line LspRange
    }
}

pub struct LspLocation {
    pub uri:   std::String
    pub range: LspRange
}

pub struct LspDiagnostic {
    pub range:    LspRange
    pub message:  std::String
    pub severity: i64
}

pub struct CompletionItem {
    pub label:  std::String
    pub kind:   i64
    pub detail: std::String
}

pub struct SemanticToken {
    pub line:       i64
    pub col:        i64
    pub length:     u64
    pub token_type: i64
    pub modifiers:  i64
}

pub struct TextEdit {
    pub range:    LspRange
    pub new_text: std::String
}

pub struct HoverContent {
    pub content: std::String
    pub range:   LspRange
}

pub struct CompileResult {
    pub document:    document::AnalyzedDocument
    pub diagnostics: std::List[LspDiagnostic]
}

pub struct LspState {
    pub library_paths:  std::List[std::String]
    pub open_documents: std::Map[std::String document::AnalyzedDocument]
    pub reader:         io::StdinReader
}

impl CompileResult {
    pub fn into_parts self:CompileResult -> document::AnalyzedDocument std::List[LspDiagnostic] {
        self match
            CompileResult { document: document diagnostics: diagnostics } => document diagnostics
        end
    }
}

impl LspState {
    pub fn new -> LspState {
        LspState {
            library_paths: std::List[std::String]::new
            open_documents: std::Map[std::String document::AnalyzedDocument]::new
            reader: io::StdinReader::new
        }
    }
}

impl LspLocation {
    pub fn into_parts self:LspLocation -> std::String LspRange {
        self match
            LspLocation { uri: uri range: range } => uri range
        end
    }
}

# ============================================================================
# LSP constants
# ============================================================================
pub const DIAGNOSTIC_ERROR 1
pub const DIAGNOSTIC_WARNING 2
pub const COMPLETION_METHOD 2
pub const COMPLETION_FUNCTION 3
pub const COMPLETION_VARIABLE 6
pub const COMPLETION_ENUM 13
pub const COMPLETION_KEYWORD 14
pub const COMPLETION_STRUCT 22
pub const COMPLETION_ENUM_MEMBER 20
# Semantic token types
pub const TOKEN_FUNCTION 0
pub const TOKEN_VARIABLE 1
pub const TOKEN_STRING 2
pub const TOKEN_NUMBER 3
pub const TOKEN_KEYWORD 4
pub const TOKEN_OPERATOR 5
pub const TOKEN_TYPE 6
pub const TOKEN_ENUM_MEMBER 7
pub const TOKEN_STRUCT 8
pub const TOKEN_MACRO 9

# ============================================================================
# Coordinate conversion utilities
# ============================================================================

pub fn convert_lsp_position line:i64 column:i64 -> common::SourcePosition {
    column 1 + u64::try_from.unwrap line 1 + u64::try_from.unwrap common::SourcePosition::new
}

pub fn convert_location_to_lsp_range
    sources:$lexer::SourceStore
    location:$common::Location
-> LspRange {
    location.span.length = length
    if 1 length < then
        1 = length: u64
    fi
    location.span.offset location.file.as_str sources.convert_offset_to_position = start_result
    location.span.offset length + location.file.as_str sources.convert_offset_to_position = end_result
    if start_result std::Option::Some(start_position) is then
        if end_result std::Option::Some(end_position) is then
            end_position.column 1 - i64::try_from.unwrap
            end_position.line 1 - i64::try_from.unwrap
            start_position.column 1 - i64::try_from.unwrap
            start_position.line 1 - i64::try_from.unwrap
            LspRange return
        fi
    fi
    0 0 0 0 LspRange
}

pub fn uri_to_path uri:$str -> std::String {
    # Strip file:// prefix
    if uri "file://" str::starts_with then
        uri 7 uri.length 7 - str::substring
    else
        uri.to_str
    fi
}

pub fn path_to_uri path:$str -> std::String { f"file://{path}" }

# ============================================================================
# JSON builders for LSP types
# ============================================================================

impl LspRange {
    pub fn to_json range:$LspRange -> json::JsonValue {
        json::json_object
        "line".to_str range LspRange::start_line json::JsonValue::JsonInt json::json_set
        "character".to_str range LspRange::start_col json::JsonValue::JsonInt json::json_set
        json::JsonValue::JsonObject = start_json
        json::json_object
        "line".to_str range LspRange::end_line json::JsonValue::JsonInt json::json_set
        "character".to_str range LspRange::end_col json::JsonValue::JsonInt json::json_set
        json::JsonValue::JsonObject = end_json
        json::json_object
        "start".to_str start_json json::json_set
        "end".to_str end_json json::json_set
        json::JsonValue::JsonObject
    }
}

impl LspLocation {
    pub fn to_json loc:$LspLocation -> json::JsonValue {
        loc LspLocation::range = loc_range: $LspRange
        json::json_object
        "uri".to_str loc LspLocation::uri.clone json::JsonValue::JsonString json::json_set
        "range".to_str loc_range.to_json json::json_set
        json::JsonValue::JsonObject
    }
}

impl LspDiagnostic {
    pub fn to_json diag:$LspDiagnostic -> json::JsonValue {
        diag LspDiagnostic::range = diag_range: $LspRange
        json::json_object
        "range".to_str diag_range.to_json json::json_set
        "message".to_str diag LspDiagnostic::message.clone json::JsonValue::JsonString json::json_set
        "severity".to_str diag LspDiagnostic::severity json::JsonValue::JsonInt json::json_set
        "source".to_str "casa".to_str json::JsonValue::JsonString json::json_set
        json::JsonValue::JsonObject
    }
}

impl CompletionItem {
    pub fn to_json item:$CompletionItem -> json::JsonValue {
        json::json_object = result_obj
        result_obj "label".to_str item CompletionItem::label.clone json::JsonValue::JsonString json::json_set = result_obj
        result_obj "kind".to_str item CompletionItem::kind json::JsonValue::JsonInt json::json_set = result_obj
        if "" item CompletionItem::detail != then
            result_obj "detail".to_str item CompletionItem::detail.clone json::JsonValue::JsonString json::json_set = result_obj
        fi
        result_obj json::JsonValue::JsonObject
    }
}

impl TextEdit {
    pub fn to_json edit:$TextEdit -> json::JsonValue {
        edit TextEdit::range = edit_range: $LspRange
        json::json_object
        "range".to_str edit_range.to_json json::json_set
        "newText".to_str edit TextEdit::new_text.clone json::JsonValue::JsonString json::json_set
        json::JsonValue::JsonObject
    }
}

# ============================================================================
# JSON-RPC protocol layer
# ============================================================================

pub fn exit_with_lsp_error message:str {
    f"[LSP] {message}\n".as_str std::eprint
    1 std::exit
}

pub fn read_message reader:mut$io::StdinReader -> std::Option[json::JsonValue] {
    std::Option[i64]::None = content_length
    # Read headers until empty line
    while true do
        reader io::stdin_read_line.to_str match
            std::Result::Error(_) => std::Option[json::JsonValue]::None return
            std::Result::Ok(value) => value
        end
        = header_line
        if 0 header_line.length != '\r' header_line.length 1 - header_line.at == && then
            header_line.as_str 0 header_line.length 1 - str::substring = header_line
        fi
        if 0 header_line.length == then
            break
        fi
        if header_line.as_str "Content-Length: " str::starts_with then
            header_line.as_str 16 header_line.length 16 - str::substring.as_str parser::str_to_int std::Option::Some = content_length
        fi
    done
    if content_length.is_none then
        std::Option[json::JsonValue]::None
        return
    fi
    content_length.unwrap = length
    length u64::try_from.unwrap reader io::stdin_read_exact.to_str match
        std::Result::Error(_) => std::Option[json::JsonValue]::None return
        std::Result::Ok(value) => value
    end
    = body
    body.as_str parser::Cursor::new = cursor
    cursor json::json_parse = parse_result
    parse_result match
        std::Result::Ok(parsed) => parsed std::Option::Some
        std::Result::Error(_) => std::Option[json::JsonValue]::None
    end
}

pub fn send_json_rpc body:std::String {
    body.length = body_length
    f"Content-Length: {body_length}\r\n\r\n{body.as_str}".as_str io::stdout_write
}

pub fn send_response id:$json::JsonValue result:json::JsonValue {
    json::json_object
    "jsonrpc".to_str "2.0".to_str json::JsonValue::JsonString json::json_set
    "id".to_str id.clone json::json_set
    "result".to_str result json::json_set
    json::JsonValue::JsonObject json::json_serialize send_json_rpc
}

pub fn send_notification method:str params:json::JsonValue {
    json::json_object
    "jsonrpc".to_str "2.0".to_str json::JsonValue::JsonString json::json_set
    "method".to_str method.to_str json::JsonValue::JsonString json::json_set
    "params".to_str params json::json_set
    json::JsonValue::JsonObject json::json_serialize send_json_rpc
}

# ============================================================================
# Compilation pipeline
# ============================================================================

pub fn compile_document_with_paths
    file_path:$str
    source:$str
    open_docs:$std::Map[std::String document::AnalyzedDocument]
    library_paths:$std::List[std::String]
-> CompileResult {
    source.to_str file_path.to_str analysis::AnalysisInput::new = input
    library_paths.clone = input.library_paths
    open_docs.keys = uris
    for uri in uris.iter do
        uri open_docs.get.unwrap = cached_state
        if cached_state.file_path file_path != then
            cached_state.source.clone cached_state.file_path.clone input.source_overrides.set
        fi
    done
    input analysis::analyze = analysis

    file_path analysis diagnostics_from = diagnostics
    file_path.to_str source.to_str analysis document::AnalyzedDocument::new = state

    diagnostics
    state
    CompileResult
}

pub fn compile_document
    file_path:$str
    source:$str
    open_docs:$std::Map[std::String document::AnalyzedDocument]
-> CompileResult {
    std::List[std::String]::new = library_paths
    library_paths open_docs source file_path compile_document_with_paths
}

pub fn ingest_document_into
    uri:$str
    source:$str
    open_docs:std::Map[std::String document::AnalyzedDocument]
-> std::List[LspDiagnostic] std::Map[std::String document::AnalyzedDocument] {
    uri uri_to_path = path
    open_docs source path.as_str compile_document.into_parts = diagnostics = document
    document uri.to_str open_docs.set
    diagnostics
    open_docs
}

pub fn ingest_document uri:$str source:$str state:mut$LspState -> std::List[LspDiagnostic] {
    uri uri_to_path = path
    state.library_paths state.open_documents source path.as_str compile_document_with_paths.into_parts
    = diagnostics = document
    document uri.to_str state.open_documents.set
    diagnostics
}

pub fn diagnostics_from analysis:$analysis::AnalysisResult path:$str -> std::List[LspDiagnostic] {
    std::List[LspDiagnostic]::new = diagnostics

    for
        diagnostic in analysis
            .diagnostics
            .entries
            .iter
    do
        if diagnostic error::Diagnostic::Error(error) is then
            if
                "" error error::CasaError::location common::Location::file !=
                error error::CasaError::location common::Location::file path != &&
            then
                continue
            fi
            error.location.clone = location
            if
                location.file.as_str analysis
                    .sources
                    .get
                    .is_none
            then
                path.to_str = location.file
            fi

            # Build message
            std::String::new = msg_builder
            error error::CasaError::message.as_str msg_builder.append
            if error.expected std::Option::Some(expected) is then
                "\nExpected: " msg_builder.append
                expected.as_str msg_builder.append
            fi
            if error error::CasaError::got std::Option::Some(got) is then
                "\n" msg_builder.append
                error error::CasaError::got_label.as_str msg_builder.append
                ": " msg_builder.append
                got.as_str msg_builder.append
            fi

            DIAGNOSTIC_ERROR
            msg_builder
            location analysis.sources convert_location_to_lsp_range
            LspDiagnostic diagnostics.push
        elif diagnostic error::Diagnostic::Warning(warning) is then
            if
                "" warning error::CasaWarning::location common::Location::file !=
                warning error::CasaWarning::location common::Location::file path != &&
            then
                continue
            fi
            warning.location.clone = location
            if
                location.file.as_str analysis
                    .sources
                    .get
                    .is_none
            then
                path.to_str = location.file
            fi
            DIAGNOSTIC_WARNING
            warning error::CasaWarning::message.clone
            location analysis.sources convert_location_to_lsp_range
            LspDiagnostic diagnostics.push
        fi
    done

    diagnostics
}

pub fn publish_diagnostics uri:$str diagnostics:std::List[LspDiagnostic] {
    std::List[json::JsonValue]::new = json_array
    0 = diagnostic_index: u64
    while diagnostic_index diagnostics.length > do
        diagnostic_index diagnostics.get.to_json json_array.push
        1 += diagnostic_index
    done
    json::json_object
    "uri".to_str uri.to_str json::JsonValue::JsonString json::json_set
    "diagnostics".to_str json_array json::JsonValue::JsonArray json::json_set
    json::JsonValue::JsonObject = params
    params "textDocument/publishDiagnostics" send_notification
}

pub fn convert_document_location_to_lsp
    sources:$lexer::SourceStore
    location:$document::DocumentLocation
-> LspLocation {
    location.length location.offset location.file.clone common::Location::new
    sources
    convert_location_to_lsp_range
    location.file.as_str path_to_uri
    LspLocation
}

# ============================================================================
# Diagnostics handler
# ============================================================================

pub fn extract_uri message:$json::JsonValue -> std::String {
    "params" message json::json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "textDocument" params json::json_get_object = text_document_opt
    if text_document_opt.is_none then
        "Expected option value while unwrapping textDocument params json_get_object" exit_with_lsp_error
    fi
    text_document_opt.unwrap = text_document
    if "uri" text_document json::json_get_str std::Option::Some(uri) is then
        uri.clone return
    fi
    "Expected option value while unwrapping uri text_document json_get_str" exit_with_lsp_error
    std::String::new
}

pub fn extract_position message:$json::JsonValue -> LspRange {
    "params" message json::json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "position" params json::json_get_object = position_opt
    if position_opt.is_none then
        "Expected option value while unwrapping position params json_get_object" exit_with_lsp_error
    fi
    position_opt.unwrap = position
    "line" position json::json_get_int = line_opt
    if line_opt.is_none then
        "Expected option value while unwrapping line position json_get_int" exit_with_lsp_error
    fi
    line_opt.unwrap = line
    "character" position json::json_get_int = character_opt
    if character_opt.is_none then
        "Expected option value while unwrapping character position json_get_int" exit_with_lsp_error
    fi
    character_opt.unwrap = character
    0 0 character line LspRange
}

pub fn handle_did_open message:$json::JsonValue state:mut$LspState {
    "params" message json::json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "textDocument" params json::json_get_object = text_document_opt
    if text_document_opt.is_none then
        "Expected option value while unwrapping textDocument params json_get_object" exit_with_lsp_error
    fi
    text_document_opt.unwrap = text_document
    "uri" text_document json::json_get_str = uri_opt
    if uri_opt.is_none then
        "Expected option value while unwrapping uri text_document json_get_str" exit_with_lsp_error
    fi
    uri_opt.unwrap = uri
    "text" text_document json::json_get_str = text_opt
    if text_opt.is_none then
        "Expected option value while unwrapping text text_document json_get_str" exit_with_lsp_error
    fi
    text_opt.unwrap = text
    state text.as_str uri.as_str ingest_document = diagnostics
    diagnostics uri.as_str publish_diagnostics
}

pub fn handle_did_change message:$json::JsonValue state:mut$LspState {
    "params" message json::json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "textDocument" params json::json_get_object = text_document_opt
    if text_document_opt.is_none then
        "Expected option value while unwrapping textDocument params json_get_object" exit_with_lsp_error
    fi
    text_document_opt.unwrap = text_document
    "uri" text_document json::json_get_str = uri_opt
    if uri_opt.is_none then
        "Expected option value while unwrapping uri text_document json_get_str" exit_with_lsp_error
    fi
    uri_opt.unwrap = uri
    "contentChanges" params json::json_get_array = changes_opt
    if changes_opt.is_none then
        "Expected option value while unwrapping contentChanges params json_get_array" exit_with_lsp_error
    fi
    changes_opt.unwrap = changes
    0 changes.get = change
    "text" change json::json_get_str = text_opt
    if text_opt.is_none then
        "Expected option value while unwrapping text change json_get_str" exit_with_lsp_error
    fi
    text_opt.unwrap = text
    state text.as_str uri.as_str ingest_document = diagnostics
    diagnostics uri.as_str publish_diagnostics
}

pub fn handle_did_save message:$json::JsonValue state:mut$LspState {
    message extract_uri = uri
    uri.as_str uri_to_path = saved_path
    saved_path.as_str.as_cstr = saved_path_cstr
    if saved_path_cstr.is_none then
        f"error: handle_did_save path contains NUL for {uri}".as_str std::eprintln
        return
    fi
    saved_path_cstr.unwrap file::read_all = read_result
    if read_result std::Result::Error(read_err) is then
        f"error: handle_did_save read failed for {uri}: {read_err.to_str}".as_str std::eprintln
        return
    fi
    read_result.unwrap.to_str = saved_source_result
    if saved_source_result std::Result::Error(utf8_error) is then
        f"error: handle_did_save read invalid UTF-8 at byte {utf8_error.index} for {uri}".as_str std::eprintln
        return
    fi
    saved_source_result.unwrap = saved_source
    state saved_source.as_str uri.as_str ingest_document = diagnostics
    diagnostics uri.as_str publish_diagnostics
}

# ============================================================================
# Go-to-definition handler
# ============================================================================

pub fn compute_definition
    state:$document::AnalyzedDocument
    line:i64
    column:i64
-> std::Option[LspLocation] {
    column line convert_lsp_position = position
    if position state.find_definition_at std::Option::Some(location) is then
        location state.sources convert_document_location_to_lsp std::Option::Some
    else
        std::Option[LspLocation]::None
    fi
}

pub fn handle_definition message:$json::JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        json::JsonValue::JsonNull request_id send_response
        return
    fi
    document_opt.unwrap = document

    message extract_position = position
    position LspRange::start_col position LspRange::start_line document compute_definition = loc_opt
    if loc_opt std::Option::Some(loc) is then
        loc.to_json request_id send_response
    else
        json::JsonValue::JsonNull request_id send_response
    fi
}

# ============================================================================
# Hover handler
# ============================================================================

pub fn convert_document_hover_to_lsp
    sources:$lexer::SourceStore
    hover:$document::DocumentHover
-> HoverContent {
    hover.location sources convert_document_location_to_lsp = location
    location.range.clone f"```casa\n{hover.content.as_str}\n```" HoverContent
}

pub fn compute_hover
    state:$document::AnalyzedDocument
    line:i64
    column:i64
-> std::Option[HoverContent] {
    column line convert_lsp_position = position
    if position state.find_hover_at std::Option::Some(hover) is then
        hover state.sources convert_document_hover_to_lsp std::Option::Some
    else
        std::Option[HoverContent]::None
    fi
}

pub fn handle_hover message:$json::JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        json::JsonValue::JsonNull request_id send_response
        return
    fi
    document_opt.unwrap = document

    message extract_position = position
    position LspRange::start_col position LspRange::start_line document compute_hover = hover_opt
    if hover_opt.is_none then
        json::JsonValue::JsonNull request_id send_response
        return
    fi
    hover_opt.unwrap = hover
    json::json_object
    "contents".to_str json::json_object
    "kind".to_str "markdown".to_str json::JsonValue::JsonString json::json_set
    "value".to_str hover HoverContent::content.clone json::JsonValue::JsonString json::json_set
    json::JsonValue::JsonObject json::json_set
    "range".to_str hover HoverContent::range.to_json json::json_set
    json::JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Completion handler
# ============================================================================

pub fn format_completion_candidate candidate:$document::CompletionCandidate -> CompletionItem {
    candidate match
        document::CompletionCandidate::Function(function_name) => {
            "".to_str COMPLETION_FUNCTION function_name.clone CompletionItem
        }
        document::CompletionCandidate::Variable(variable) => {
            variable.typ.format COMPLETION_VARIABLE variable.name.clone CompletionItem
        }
        document::CompletionCandidate::Keyword(keyword) => {
            "".to_str COMPLETION_KEYWORD keyword.format_source.to_str CompletionItem
        }
        document::CompletionCandidate::Intrinsic(intrinsic) => {
            "".to_str COMPLETION_KEYWORD intrinsic.format_source.to_str CompletionItem
        }
        document::CompletionCandidate::Struct(casa_struct) => {
            std::String::new = member_builder
            0 = member_index: u64
            while member_index casa_struct.members.length > do
                if 0 member_index != then
                    ", " member_builder.append
                fi
                member_index casa_struct.members.get = member
                member.name.as_str member_builder.append
                ": " member_builder.append
                member
                    .typ
                    .format
                    .as_str member_builder.append
                1 += member_index
            done
            member_builder COMPLETION_STRUCT casa_struct.name.clone CompletionItem
        }
        document::CompletionCandidate::Enum(enum_name) => {
            "".to_str COMPLETION_ENUM enum_name.clone CompletionItem
        }
        document::CompletionCandidate::EnumVariant(variant_name) => {
            "".to_str COMPLETION_ENUM_MEMBER variant_name.clone CompletionItem
        }
        document::CompletionCandidate::Method(function_name) => {
            "".to_str COMPLETION_METHOD function_name.as_str "::" str::split.pop CompletionItem
        }
    end
}

pub fn compute_completion
    state:$document::AnalyzedDocument
    line:i64
    column:i64
    trigger:$str
-> std::List[CompletionItem] {
    std::List[CompletionItem]::new = items
    column line convert_lsp_position = position
    trigger position state.find_completion_candidates = candidates
    for candidate in candidates.iter do
        candidate format_completion_candidate items.push
    done
    items
}

pub fn handle_completion message:$json::JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        json::json_object
        "isIncomplete".to_str false json::JsonValue::JsonBool json::json_set
        "items".to_str std::List[json::JsonValue]::new json::JsonValue::JsonArray json::json_set
        json::JsonValue::JsonObject request_id send_response
        return
    fi
    document_opt.unwrap = document

    # Check trigger character
    "params" message json::json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "context" params json::json_get_object = context_opt
    std::String::new = trigger
    if context_opt std::Option::Some(context) is then
        "triggerCharacter" context json::json_get_str = trigger_opt
        if trigger_opt.is_some then
            trigger_opt.unwrap = trigger
        fi
    fi

    message extract_position = position
    trigger.as_str position LspRange::start_col position LspRange::start_line document compute_completion = items

    # Build response
    std::List[json::JsonValue]::new = json_items
    0 = item_index: u64
    while item_index items.length > do
        item_index items.get.to_json json_items.push
        1 += item_index
    done
    json::json_object
    "isIncomplete".to_str false json::JsonValue::JsonBool json::json_set
    "items".to_str json_items json::JsonValue::JsonArray json::json_set
    json::JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Find references handler
# ============================================================================

pub fn compute_references
    state:$document::AnalyzedDocument
    line:i64
    column:i64
    include_declaration:bool
-> std::Option[std::List[LspLocation]] {
    column line convert_lsp_position = position
    if
        include_declaration position state.find_references_at std::Option::Some(document_references) is
    then
        std::List[LspLocation]::new = references
        for document_reference in document_references.iter do
            document_reference state.sources convert_document_location_to_lsp references.push
        done
        references std::Option::Some return
    fi
    std::Option[std::List[LspLocation]]::None
}

pub fn handle_references message:$json::JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        json::JsonValue::JsonNull request_id send_response
        return
    fi
    document_opt.unwrap = document

    # includeDeclaration
    std::Option[$json::JsonValue]::None = context_opt
    if "params" message json::json_get_object std::Option::Some(params) is then
        "context" params json::json_get_object = context_opt
    fi
    true = include_decl
    if context_opt std::Option::Some(context) is then
        "includeDeclaration" context json::json_get_bool = include_decl_opt
        if include_decl_opt.is_some then
            include_decl_opt.unwrap = include_decl
        fi
    fi

    message extract_position = position
    include_decl position LspRange::start_col position LspRange::start_line document compute_references = refs_opt
    if refs_opt.is_none then
        json::JsonValue::JsonNull request_id send_response
        return
    fi
    refs_opt.unwrap = refs
    std::List[json::JsonValue]::new = json_refs
    0 = ref_index: u64
    while ref_index refs.length > do
        ref_index refs.get.to_json json_refs.push
        1 += ref_index
    done
    json_refs json::JsonValue::JsonArray request_id send_response
}

# ============================================================================
# Rename handler
# ============================================================================

pub fn compute_rename
    state:$document::AnalyzedDocument
    line:i64
    column:i64
    new_name:$str
-> std::Option[std::Map[std::String std::List[TextEdit]]] {
    column line convert_lsp_position = position
    if true position state.find_references_at std::Option::Some(document_references) is then
        std::Map[std::String std::List[TextEdit]]::new = edits_map
        for document_reference in document_references.iter do
            document_reference state.sources convert_document_location_to_lsp.into_parts
            = edit_range = reference_uri

            new_name.to_str edit_range TextEdit = edit
            reference_uri edits_map.get_mut = existing_edits
            existing_edits match
                std::Option::Some(edits) => edit edits.push
                std::Option::None => {
                    std::List[TextEdit]::new = document_edits
                    edit document_edits.push
                    document_edits reference_uri edits_map.set
                }
            end
        done
        edits_map std::Option::Some return
    fi
    std::Option[std::Map[std::String std::List[TextEdit]]]::None
}

pub fn handle_rename message:$json::JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        json::JsonValue::JsonNull request_id send_response
        return
    fi
    document_opt.unwrap = document

    "params" message json::json_get_object = params_opt
    if params_opt.is_none then
        "Expected option value while unwrapping params message json_get_object" exit_with_lsp_error
    fi
    params_opt.unwrap = params
    "newName" params json::json_get_str = new_name_opt
    if new_name_opt.is_none then
        "Expected option value while unwrapping newName params json_get_str" exit_with_lsp_error
    fi
    new_name_opt.unwrap = new_name

    message extract_position = position
    new_name.as_str position LspRange::start_col position LspRange::start_line document compute_rename = edits_opt
    if edits_opt.is_none then
        json::JsonValue::JsonNull request_id send_response
        return
    fi
    edits_opt.unwrap = edits_map

    # Convert to JSON changes object
    json::json_object = changes
    edits_map.keys = change_uris
    for change_uri in change_uris.iter do
        change_uri edits_map.get.unwrap = edit_list
        std::List[json::JsonValue]::new = edit_json_list
        0 = edit_index: u64
        while edit_index edit_list.length > do
            edit_index edit_list.get.to_json edit_json_list.push
            1 += edit_index
        done
        changes change_uri.clone edit_json_list json::JsonValue::JsonArray json::json_set = changes
    done

    json::json_object
    "changes".to_str changes json::JsonValue::JsonObject json::json_set
    json::JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Semantic tokens handler
# ============================================================================

pub fn map_document_token_type kind:document::DocumentTokenKind -> i64 {
    kind match
        document::DocumentTokenKind::Function => TOKEN_FUNCTION
        document::DocumentTokenKind::Variable => TOKEN_VARIABLE
        document::DocumentTokenKind::String => TOKEN_STRING
        document::DocumentTokenKind::Number => TOKEN_NUMBER
        document::DocumentTokenKind::Keyword => TOKEN_KEYWORD
        document::DocumentTokenKind::Operator => TOKEN_OPERATOR
        document::DocumentTokenKind::Type => TOKEN_TYPE
        document::DocumentTokenKind::EnumMember => TOKEN_ENUM_MEMBER
        document::DocumentTokenKind::Struct => TOKEN_STRUCT
        document::DocumentTokenKind::Macro => TOKEN_MACRO
    end
}

pub fn compute_semantic_tokens state:$document::AnalyzedDocument -> std::List[SemanticToken] {
    std::List[SemanticToken]::new = tokens
    for document_token in state.find_semantic_tokens.iter do
        document_token.location = location: $document::DocumentLocation
        location state.sources convert_document_location_to_lsp.range.clone = range
        0
        document_token.kind copy map_document_token_type
        location.length
        range.start_col
        range.start_line
        SemanticToken tokens.push
    done
    tokens
}

pub fn handle_semantic_tokens message:$json::JsonValue state:$LspState {
    message extract_uri = uri
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    uri.as_str state.open_documents.get_str = document_opt
    if document_opt.is_none then
        json::json_object
        "data".to_str std::List[json::JsonValue]::new json::JsonValue::JsonArray json::json_set
        json::JsonValue::JsonObject request_id send_response
        return
    fi
    document_opt.unwrap = document

    document compute_semantic_tokens = tokens

    # Delta-encode
    std::List[json::JsonValue]::new = encoded_data
    0 = prev_line
    0 = prev_col
    for token in tokens.iter do
        token SemanticToken::line prev_line - = delta_line
        if 0 delta_line == then
            token SemanticToken::col prev_col -
        else
            token SemanticToken::col
        fi
        = delta_col
        delta_line json::JsonValue::JsonInt encoded_data.push
        delta_col json::JsonValue::JsonInt encoded_data.push
        token SemanticToken::length i64::try_from.unwrap json::JsonValue::JsonInt encoded_data.push
        token SemanticToken::token_type json::JsonValue::JsonInt encoded_data.push
        token SemanticToken::modifiers json::JsonValue::JsonInt encoded_data.push
        token SemanticToken::line = prev_line
        token SemanticToken::col = prev_col
    done

    json::json_object
    "data".to_str encoded_data json::JsonValue::JsonArray json::json_set
    json::JsonValue::JsonObject request_id send_response
}

# ============================================================================
# Server initialization and main loop
# ============================================================================

pub fn extract_library_paths message:$json::JsonValue -> std::List[std::String] {
    std::List[std::String]::new = paths
    "params" message json::json_get_object = params_option
    if params_option.is_none then
        paths return
    fi
    params_option.unwrap = params
    "initializationOptions" params json::json_get_object = init_options_option
    if init_options_option.is_none then
        paths return
    fi
    init_options_option.unwrap = init_options
    "libraryPaths" init_options json::json_get_array = library_paths_option
    if library_paths_option.is_none then
        paths return
    fi
    library_paths_option.unwrap = library_paths_array
    for path_value in library_paths_array.iter do
        if path_value json::JsonValue::JsonString(path_string) is then
            path_string.clone paths.push
        fi
    done
    paths
}

pub fn handle_initialize message:$json::JsonValue state:mut$LspState {
    "id" message json::json_get_value = request_id_opt
    if request_id_opt.is_none then
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
    request_id_opt.unwrap = request_id

    message extract_library_paths = state.library_paths

    # Build semantic tokens legend
    std::List[json::JsonValue]::new = token_types
    "function".to_str json::JsonValue::JsonString token_types.push
    "variable".to_str json::JsonValue::JsonString token_types.push
    "string".to_str json::JsonValue::JsonString token_types.push
    "number".to_str json::JsonValue::JsonString token_types.push
    "keyword".to_str json::JsonValue::JsonString token_types.push
    "operator".to_str json::JsonValue::JsonString token_types.push
    "type".to_str json::JsonValue::JsonString token_types.push
    "enumMember".to_str json::JsonValue::JsonString token_types.push
    "struct".to_str json::JsonValue::JsonString token_types.push
    "macro".to_str json::JsonValue::JsonString token_types.push

    # Trigger characters for completion
    std::List[json::JsonValue]::new = triggers
    ".".to_str json::JsonValue::JsonString triggers.push
    ":".to_str json::JsonValue::JsonString triggers.push

    json::json_object
    "serverInfo".to_str json::json_object
    "name".to_str "casa-language-server".to_str json::JsonValue::JsonString json::json_set
    "version".to_str "0.1.0".to_str json::JsonValue::JsonString json::json_set
    json::JsonValue::JsonObject json::json_set
    "capabilities".to_str json::json_object
    "textDocumentSync".to_str 1 json::JsonValue::JsonInt json::json_set
    "definitionProvider".to_str true json::JsonValue::JsonBool json::json_set
    "hoverProvider".to_str true json::JsonValue::JsonBool json::json_set
    "completionProvider".to_str json::json_object
    "triggerCharacters".to_str triggers json::JsonValue::JsonArray json::json_set
    json::JsonValue::JsonObject json::json_set
    "referencesProvider".to_str true json::JsonValue::JsonBool json::json_set
    "renameProvider".to_str true json::JsonValue::JsonBool json::json_set
    "semanticTokensProvider".to_str json::json_object
    "legend".to_str json::json_object
    "tokenTypes".to_str token_types json::JsonValue::JsonArray json::json_set
    "tokenModifiers".to_str std::List[json::JsonValue]::new json::JsonValue::JsonArray json::json_set
    json::JsonValue::JsonObject json::json_set
    "full".to_str true json::JsonValue::JsonBool json::json_set
    json::JsonValue::JsonObject json::json_set
    json::JsonValue::JsonObject json::json_set
    json::JsonValue::JsonObject request_id send_response
}

pub fn handle_shutdown message:$json::JsonValue {
    if "id" message json::json_get_value std::Option::Some(request_id) is then
        json::JsonValue::JsonNull request_id send_response
    else
        "Expected option value while unwrapping id message json_get_value" exit_with_lsp_error
    fi
}

pub fn handle_exit message:$json::JsonValue { 0 std::exit }

pub fn dispatch_message message:$json::JsonValue state:mut$LspState {
    "method" message json::json_get_str = method_opt
    if method_opt.is_none then
        return
    fi
    method_opt.unwrap = method

    if "initialize" method == then
        state message handle_initialize
    elif "shutdown" method == then
        message handle_shutdown
    elif "exit" method == then
        message handle_exit
    elif "textDocument/didOpen" method == then
        state message handle_did_open
    elif "textDocument/didChange" method == then
        state message handle_did_change
    elif "textDocument/didSave" method == then
        state message handle_did_save
    elif "textDocument/definition" method == then
        state message handle_definition
    elif "textDocument/hover" method == then
        state message handle_hover
    elif "textDocument/completion" method == then
        state message handle_completion
    elif "textDocument/references" method == then
        state message handle_references
    elif "textDocument/rename" method == then
        state message handle_rename
    elif "textDocument/semanticTokens/full" method == then
        state message handle_semantic_tokens
    fi
}

pub fn main {
    LspState::new = state
    while true do
        state.reader read_message = msg_opt
        if msg_opt.is_none then
            break
        fi
        if msg_opt std::Option::Some(message) is then
            state message dispatch_message
        fi
    done
}
main
