# Migrate comparison expressions from Casa's former topmost-first operand order.
# Build with: ./casac -L lib tools/migrate_operators.casa -o /tmp/casa-migrate-operators
import "../lib/std.casa" as std
import "../lib/io.casa" as io
import "../compiler/common.casa" as common
import "../compiler/lexer.casa" as lexer

pub fn migrate source:$str -> std::Result[std::String std::String] {
    "<stdin>" source lexer::lex_source = lexed
    if lexed.diagnostics.has_errors then
        "Cannot migrate source with lexical errors".to_str std::Result::Error return
    fi
    std::String::new = output
    0 = start: u64
    for token in lexed.tokens.iter do
        if token.kind common::TokenKind::Operator swap != then
            continue
        fi
        token.value.as_str = operator: $str
        if
            operator "==" == operator "!=" == ||
            operator "<" == || operator "<=" == ||
            operator ">" == || operator ">=" == ||
        then
            source start token
                .location
                .span
                .offset start - str::substring output.append_string
            "swap " output.append
            token
                .location
                .span
                .offset = start
        fi
    done
    source start source.length start - str::substring output.append_string
    output std::Result::Ok
}

fn main {
    io::StdinReader::new = reader
    std::Bytes::new = bytes
    while true do
        reader io::stdin_read_byte = byte
        if 0 byte > then
            break
        fi
        byte u8::try_from.unwrap bytes.push
    done
    bytes.to_str match
        std::Result::Error(error) => {
            f"error: migration input is not valid UTF-8 at byte {error.index}" std::eprintln_string
            bytes io::stdout_write_bytes
            1 std::process::exit
        }
        std::Result::Ok(source) => {
            source.as_str migrate match
                std::Result::Ok(output) => output print
                std::Result::Error(message) => {
                    message std::eprintln_string
                    bytes io::stdout_write_bytes
                    1 std::process::exit
                }
            end
        }
    end
}
main
