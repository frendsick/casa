import "std" as std
import "timer" as timer

const DEPTH 1000

struct Node {
    next: std::Option[Node]
}

fn run {
    std::Option[Node]::None = next
    0 = depth
    while depth DEPTH > do
        next Node std::Option::Some = next
        1 += depth
    done
    timer::Timer::new = destruction
    next drop
    destruction.elapsed_ns print
    "\n" print
}
run
