import "std" as std
import "../../../compiler/analysis.casa" as analysis
import "../../../compiler/bytecode.casa" as bytecode
import "../../../compiler/emitter.casa" as emitter

const SIGSTOP 19
const GETPID_SYSCALL 39
const KILL_SYSCALL 62
const SOURCE "trait Read { fn read self:self -> i64 } struct Item { raw:i64 } impl Item:Read { fn read self:Item -> i64 { self.raw } } fn score[T:Read] item:T -> i64 { item .read } fn run -> i64 { 7 Item = first 8 Item = second first score second score + } run drop"

fn compile_source source:$str expect_errors:bool {
    source.to_str "identity-lifetime.casa".to_str analysis::AnalysisInput::new
    analysis::analyze.into_parts = checked = sources = diagnostics
    if expect_errors diagnostics.has_errors != then
        "Unexpected diagnostics in identity lifetime workload" panic
    fi
    if expect_errors then
        checked drop
    else
        checked.unwrap bytecode::compile_typechecked.unwrap emitter::emit drop
    fi
}

fn run_request {
    false SOURCE compile_source
    SOURCE " fn broken -> i64 { true } broken drop" str::concat = invalid_source
    true invalid_source.as_str compile_source
}

fn stop_for_sample {
    # SAFETY: Signal only the current process. These syscalls pass no pointers.
    unsafe { SIGSTOP GETPID_SYSCALL syscall0 KILL_SYSCALL syscall2 drop }
}
stop_for_sample
0 = iteration
while 30 iteration < do
    run_request
    stop_for_sample
    1 += iteration
done
