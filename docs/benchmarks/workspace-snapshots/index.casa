import "std" as std
import "os" as os
import "../../../compiler/products.casa" as products
import "../../../compiler/lexer.casa" as lexer
import "../../../compiler/document.casa" as document

fn stop_for_sample {
    # SAFETY: Signal only this process, with no pointer arguments.
    unsafe { 19 39 syscall0 62 syscall2 drop }
}

fn query_compiler {
    "casa.casa" lexer::absolute_normalize_path = file
    file
        .as_str
        .as_cstr
        .unwrap file::read_all
        .unwrap
        .to_str
        .unwrap = source
    source.as_str "parse_cli_args" str::find u64::try_from.unwrap = offset
    "/".to_str source file.clone products::SourceUnit products::CompilationInput::new = input
    "lib" lexer::absolute_normalize_path input.library_paths.push
    input products::analyze.unwrap = snapshot
    0 = source_bytes: u64
    for
        entry in snapshot
            .get_report
            .get_sources
            .sources
            .iter
    do
        entry.second.length += source_bytes
    done
    source_bytes print "\n" print
    stop_for_sample
    0 = iteration
    while 100 iteration < do
        false offset file.as_str snapshot.get_index.find_references match
            document::ReferenceAnswer::Complete(answer) => answer.ranges.length drop
            document::ReferenceAnswer::Incomplete(answer _) => answer.ranges.length drop
            _ => "compiler query unavailable" panic
        end
        1 += iteration
    done
    stop_for_sample
}
stop_for_sample
query_compiler
stop_for_sample
