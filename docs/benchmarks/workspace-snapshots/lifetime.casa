import "std" as std
import "os" as os
import "../../../workspace.casa" as workspace

fn stop_for_sample {
    # SAFETY: Signal only this process, with no pointer arguments.
    unsafe { 19 39 syscall0 62 syscall2 drop }
}

fn run_replacements {
    workspace::Workspace::new = state
    "/tmp/casa-714-lifetime-workspace".to_str state.folders.push
    "pub fn greet { }\ngreet".to_str "/tmp/casa-714-lifetime-workspace/shared.casa".to_str state.overrides.set
    "import \"shared.casa\" as peer\npeer::greet".to_str "/tmp/casa-714-lifetime-workspace/first.casa".to_str state.overrides.set
    "import \"shared.casa\" as peer\npeer::greet".to_str "/tmp/casa-714-lifetime-workspace/second.casa".to_str state.overrides.set
    0 = iteration
    while 10 iteration < do
        true 7 "/tmp/casa-714-lifetime-workspace/shared.casa" state.find_references.unwrap = answer
        if "hello" answer state.validate_rename ! then
            "valid rename rejected" panic
        fi
        "fn broken { true 1 + drop }".to_str "/tmp/casa-714-lifetime-workspace/broken.casa".to_str state.overrides.set
        1 += state.generation
        true 7 "/tmp/casa-714-lifetime-workspace/shared.casa" state.find_references.unwrap = rejected
        if "hello" rejected state.validate_rename then
            "incomplete rename accepted" panic
        fi
        if 4 answer.ranges.length != then
            "lost owned ranges" panic
        fi
        "/tmp/casa-714-lifetime-workspace/broken.casa" state.overrides.remove_str drop
        1 += state.generation
        1 += iteration
    done
}
448 "/tmp/casa-714-lifetime-workspace".as_cstr.unwrap dir::create.unwrap drop
stop_for_sample
0 = iteration
while 30 iteration < do
    run_replacements
    stop_for_sample
    1 += iteration
done
"/tmp/casa-714-lifetime-workspace".as_cstr.unwrap dir::remove.unwrap drop
