import "std" as std
import "os" as os
import "timer" as timer
import "../../../workspace.casa" as workspace

const DIRECTORY "/tmp/casa-714-discovery-workspace"
const PRIVATE_DIRECTORY_MODE 448
PRIVATE_DIRECTORY_MODE DIRECTORY.as_cstr.unwrap dir::create.unwrap drop
workspace::Workspace::new = state
DIRECTORY.to_str state.folders.push
for name in ["shared.casa", "first.casa", "second.casa"].iter do
    std::Bytes::new = bytes
    bytes f"{DIRECTORY}/{name}"
        .as_str
        .as_cstr
        .unwrap file::write_all.unwrap drop
done
timer::Timer::new = clock
0 = iteration
while 1000 iteration < do
    state.discover = complete = roots
    if complete ! 3 roots.length != || then
        "discovery failed" panic
    fi
    1 += iteration
done
clock.elapsed_ns print "\n" print
for name in ["shared.casa", "first.casa", "second.casa"].iter do
    f"{DIRECTORY}/{name}"
        .as_str
        .as_cstr
        .unwrap file::remove.unwrap drop
done
DIRECTORY.as_cstr.unwrap dir::remove.unwrap drop
