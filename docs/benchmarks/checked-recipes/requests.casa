import "std" as std
import "os" as os
import "../../../compiler/products.casa" as products

fn print_memory_sample {
    0 0 "/proc/self/statm".as_cstr.unwrap file::open = fd
    256 std::RawBuffer::new = buffer
    256 buffer.data fd file::read = length
    fd file::close drop
    std::Bytes::new = bytes
    0 = i: u64
    while length u64::try_from.unwrap i < do
        # SAFETY: file::read initialized length bytes within the owned buffer.
        unsafe { buffer.data i + load8 } bytes.push
        1 += i
    done
    bytes.to_str.unwrap print
}

fn analyze_request {
    "/tmp/casa_generic_requests".to_str
    "fn identity[T] value:T -> T { value } fn reader[T] input:$T -> fn[-> $T] { move { input } } 42 = owner owner reader identity = callback callback exec copy drop callback drop 43 identity drop".to_str
    "main.casa".to_str products::SourceUnit products::CompilationInput::new
    products::analyze.unwrap = snapshot
    if
        snapshot
            .get_report
            .get_diagnostics
            .has_errors
    then
        "generic request failed" panic
    fi
}
0 = count: u64
while 500 count < do
    analyze_request
    1 += count
    if 0 count 50 % == then
        print_memory_sample
    fi
done
