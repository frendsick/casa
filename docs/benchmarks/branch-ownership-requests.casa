import "../../compiler/products.casa" as products
import "../../lib/std.casa" as std
import "../../lib/os.casa" as os

fn print_memory_sample {
    0 0 "/proc/self/statm".as_cstr.unwrap file::open = fd
    256 std::RawBuffer::new = buffer
    256 buffer.data fd file::read = length
    fd file::close drop
    std::Bytes::new = bytes
    0 = i: u64
    while length u64::try_from.unwrap i < do
        # SAFETY: file::read initialized length bytes within the owned buffer.
        unsafe { buffer.data i + load8 } bytes.push
        1 += i
    done
    bytes.to_str.unwrap print
}

fn analyze_request {
    "/tmp/casa_products".to_str
    "import \"dependency\" as dependency\ndependency::value print".to_str "main.casa".to_str products::SourceUnit
    products::CompilationInput::new = input
    "struct Resource { id: i64 } impl Resource { fn drop self:mut$Resource { } } fn choose flag:bool -> Resource { if flag then 1 Resource = owner owner return else 2 Resource = owner owner fi } fn borrow value:$Resource -> $Resource { value } pub fn value -> i64 { true choose = owner owner borrow = view view.id }".to_str "dependency.casa".to_str input.source_overrides.set
    input products::analyze.unwrap = snapshot
    if
        snapshot
            .get_report
            .get_diagnostics
            .has_errors
    then
        "Ownership request was rejected" panic
    fi
}
0 = count: u64
while 500 count < do
    analyze_request
    1 += count
    if 0 count 50 % == then
        print_memory_sample
    fi
done
