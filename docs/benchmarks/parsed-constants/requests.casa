import "../../../compiler/products.casa" as products
import "../../../lib/std.casa" as std
import "../../../lib/os.casa" as os

fn print_memory_sample {
    0 0 "/proc/self/statm".as_cstr.unwrap file::open = fd
    256 std::RawBuffer::new = buffer
    256 buffer.data fd file::read = length
    fd file::close drop
    std::Bytes::new = bytes
    0 = i: u64
    while length u64::try_from.unwrap i < do
        # SAFETY: file::read initialized length bytes within the owned buffer.
        unsafe { buffer.data i + load8 } bytes.push
        1 += i
    done
    bytes.to_str.unwrap print
}

fn analyze_request failed:bool {
    "const BAD { 1 0 / }\nconst DEPENDENT BAD" = failure
    "const GOOD { dependency::VALUE 1 - }" = success
    if failed then failure else success fi = declarations
    std::String::new = text
    "import \"dependency\" as dependency\nstruct Buffer { data:array[u8 dependency::VALUE] }\n" text.append
    declarations text.append
    "/tmp/casa_constants".to_str text "main.casa".to_str products::SourceUnit
    products::CompilationInput::new = input
    "const PRIVATE 3\npub const VALUE:u64 { PRIVATE 1 - }".to_str "dependency.casa".to_str input.source_overrides.set
    input products::analyze.unwrap = snapshot
    if
        failed snapshot
            .get_report
            .get_diagnostics
            .has_errors !=
    then
        "Unexpected constant analysis result" panic
    fi
}
0 = count: u64
while 500 count < do
    0 count 2 % == analyze_request
    1 += count
    if 0 count 50 % == then
        print_memory_sample
    fi
done
