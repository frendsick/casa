import "std"

const ITERATIONS 20000
const BATCH_SIZE 64

enum Batch {
    Empty
    Values (List[i64])
}

fn make_batch -> Batch {
    List[i64]::new = values
    0 = item
    while item BATCH_SIZE > do
        item values.push
        1 += item
    done
    values Batch::Values
}

fn sum_batch batch:Batch -> i64 {
    batch match
        Batch::Empty => 0
        Batch::Values(values) => {
            0 = total
            0 = index: u64
            while index values.length > do
                index values.get += total
                1 += index
            done
            total
        }
    end
}

fn run -> i64 {
    0 = checksum
    0 = iteration
    while iteration ITERATIONS > do
        make_batch = batch
        { batch sum_batch } = calculate
        calculate exec += checksum
        1 += iteration
    done
    checksum
}
run print
"\n" print
