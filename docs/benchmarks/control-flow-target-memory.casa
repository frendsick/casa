import "std" as std
import "../../compiler/lexer.casa" as lexer
import "../../compiler/products.casa" as products
import "../../lib/timer.casa" as timer

fn benchmark count:u64 {
    std::String::new = source
    0 = index: u64
    while index count > do
        "if true then " source.append
        1 += index
    done
    0 = index: u64
    while index count > do
        "fi " source.append
        1 += index
    done
    timer::Timer::new = elapsed
    source "benchmark.casa".to_str products::SourceUnit
    "" lexer::absolute_normalize_path swap products::CompilationInput::new
    products::Target::LinuxX86_64 swap products::assembly.unwrap drop
    f"{count}: {elapsed}\n" print
}
0 = iteration
while iteration 101 > do
    500 benchmark
    1 += iteration
done
