import "std" as std
import "common" as common
import "bytecode" as bytecode

fn make_location -> common::Location { 1 0 "benchmark.casa".to_str common::Location::new }

fn make_op value:common::OpValue -> common::Op { make_location value common::Op::new }

fn make_nested_ifs count:u64 -> std::List[common::Op] {
    std::List[common::Op]::new = ops
    0 (u64) = index
    while index count > do
        common::OpValue::IfStart make_op ops.push
        common::OpValue::IfCondition make_op ops.push
        1 += index
    done
    0 (u64) = index
    while index count > do
        common::OpValue::IfEnd make_op ops.push
        1 += index
    done
    ops
}
500 make_nested_ifs = ops
0 (u64) = index
while index 101 > do
    ops bytecode::benchmark_control_flow_targets
    1 += index
done
