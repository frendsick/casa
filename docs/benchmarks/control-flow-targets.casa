import "std" as std
import "common" as common
import "error" as error
import "lexer" as lexer
import "syntax" as syntax
import "typechecker" as typechecker
import "analysis" as analysis
import "timer" as timer

common::symbol_store_new = TEST_STORE
import "bytecode" as bytecode

fn make_location -> common::Location { 1 0 "benchmark.casa".to_str common::Location::new }

fn make_op value:common::OpValue -> common::Op { make_location value common::Op::new }

fn make_nested_ifs count:u64 -> std::List[common::Op] {
    std::List[common::Op]::new = ops
    0 (u64) = index
    while index count > do
        common::OpValue::IfStart make_op ops.push
        common::OpValue::IfCondition make_op ops.push
        1 += index
    done
    0 (u64) = index
    while index count > do
        common::OpValue::IfEnd make_op ops.push
        1 += index
    done
    ops
}

fn benchmark count:u64 {
    count make_nested_ifs = ops
    TEST_STORE.clone_for_typecheck = store
    error::Diagnostics::new
    ops
    common::empty_stack_effect
    store
    typechecker::TypecheckResult = result
    timer::Timer::new = elapsed
    result bytecode::compile_typechecked drop
    f"{count}: {elapsed}\n" print
}
500 benchmark
1000 benchmark
2000 benchmark
4000 benchmark
