import "std" as std
import "../../../compiler/lexer.casa" as lexer
import "../../../compiler/products.casa" as products

const SIGSTOP 19
const GETPID_SYSCALL 39
const KILL_SYSCALL 62

fn analyze_source source:$str expect_errors:bool {
    source.to_str "lifetime.casa".to_str products::SourceUnit
    "" lexer::absolute_normalize_path swap products::CompilationInput::new products::analyze.unwrap = result
    if
        expect_errors result
            .get_report
            .get_diagnostics
            .has_errors !=
    then
        "Unexpected diagnostics in lifetime workload" panic
    fi
}

fn run_request {
    false "struct Resource { value: i64 } impl Resource { fn drop self:mut$Resource { } } struct Box[T] { value: T } fn take[T] value:T { } fn first value:Box[Resource] { value take } fn second value:Box[Resource] { } 1 Resource Box first 2 Resource Box second" analyze_source
    true "fn take[T] value:T { } fn broken { take } broken" analyze_source
}

fn stop_for_sample {
    # The parent samples allocator state while this process is stopped.
    # SAFETY: Signal only the current process. These syscalls pass no pointers.
    unsafe { SIGSTOP GETPID_SYSCALL syscall0 KILL_SYSCALL syscall2 drop }
}
stop_for_sample
0 = iteration
while 30 iteration < do
    run_request
    stop_for_sample
    1 += iteration
done
