--- a/lib/std.casa
+++ b/lib/std.casa
@@ -2,9 +2,21 @@
 # for the call duration. The regions do not overlap.
 pub unsafe fn memcpy dst:ptr src:ptr n:u64 {
     0 = i: u64
+    while size_of[u64] n i - >= do
+        # SAFETY: At least eight initialized source bytes and writable destination bytes remain.
+        # Raw integer loads and stores permit unaligned addresses on the x86-64 target.
+        unsafe {
+            src i + load64
+            dst i + store64
+        }
+        size_of[u64] += i
+    done
     while i n > do
-        unsafe { src i + load8 }
-        unsafe { dst i + store8 }
+        # SAFETY: i is inside both caller-provided non-overlapping byte ranges.
+        unsafe {
+            src i + load8
+            dst i + store8
+        }
         1 += i
     done
 }
