@@ -1146,0 +1147,19 @@
+fn trait_name_has_method trait_name:$str method_name:$str store:$common::SymbolStore -> bool {
+    trait_name store.traits.get_str = trait_opt
+    if trait_opt.is_none then
+        false return
+    fi
+    trait_opt.unwrap = trait_def
+    for method in trait_def.methods.iter do
+        if method_name method.name.as_str == then
+            true return
+        fi
+    done
+    for supertrait in trait_def.supertraits.iter do
+        if store method_name supertrait.name.as_str trait_name_has_method then
+            true return
+        fi
+    done
+    false
+}
