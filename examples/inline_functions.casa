# Inline eligibility is optional. Calls preserve the same stack effect and checks.
inline fn clamp value:i64 minimum:i64 maximum:i64 -> i64 {
    if value minimum < then
        minimum return
    fi
    if value maximum > then
        maximum return
    fi
    value
}
10 0 -4 clamp print
"\n" print
10 0 7 clamp print
"\n" print
10 0 15 clamp print
"\n" print
