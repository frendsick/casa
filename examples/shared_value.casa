import "std"

# Several sprites share one immutable palette. The last handle releases it.
struct Palette {
    name: std::String
}

impl Palette {
    fn drop self:mut$Palette { f"released {self.name}\n" print }
}

struct Sprite {
    label:   str
    palette: std::Shared[Palette]
}

impl Sprite {
    fn describe self:$Sprite { f"{self.label} uses {self.palette.get.name}\n" print }
}

fn run {
    "dusk".to_str Palette std::Shared::new = palette
    palette.clone "tree" Sprite = tree
    palette "house" Sprite = house
    tree.describe
    house.describe
    tree drop
    "tree removed\n" print
    house drop
    "house removed\n" print
}
run

# Shared values compare, hash, and display through the shared value.
"apple".to_str std::Shared::new = first
"apple".to_str std::Shared::new = second
std::Set[std::Shared[std::String]]::new = fruits
first fruits.add
f"{second} found: {second fruits.has}\n" print

# A borrowed payload keeps its source alive through every shared handle.
"borrowed palette".to_str = name
name.as_str std::Shared::new = borrowed
borrowed.clone = remaining
borrowed drop
remaining.get print
"\n" print
remaining drop
name drop
