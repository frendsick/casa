# Update and destructure a record.
import "std" as std

pub struct Person {
    pub name: str
    pub age:  i64
}

impl Person {
    pub fn celebrate_birthday self:mut$Person { 1 += self.age }

    pub fn print_description self:$Person {
        self match
            Person { name: name age: age } => f"{name} is now {age}" std::println_string
        end
    }
}
Person { name: "Ada" age: 36 } = person
person.celebrate_birthday
person.print_description
