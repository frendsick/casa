# Update and destructure a record.
import "std"

struct Person {
    name: str
    age:  i64
}

impl Person {
    fn celebrate_birthday self:mut$Person { 1 += self.age }

    fn print_description self:$Person {
        self match
            Person { name: name age: age } => f"{name} is now {age}" println
        end
    }
}
Person { name: "Ada" age: 36 } = person
person.celebrate_birthday
person.print_description
