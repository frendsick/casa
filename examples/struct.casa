# Update and destructure a record with an inline nested field.
import "std" as std

pub struct Age {
    pub years: u16
}

pub struct Person {
    pub name: str
    pub age:  Age
}

impl Person {
    pub fn celebrate_birthday self:mut$Person { 1 += self.age.years }

    pub fn print_description self:$Person {
        self match
            Person { name: name age: age } => f"{name} is now {age.years}" std::println_string
        end
    }
}
Person { name: "Ada" age: Age { years: 36 } } = person
person.celebrate_birthday
person.print_description
