import "std"

Bytes::new = message
72 message.push
195 message.push
164 message.push
240 message.push
159 message.push
152 message.push
128 message.push
message.to_str.unwrap = text
text.as_str println
0 (u64) = sum
for byte in message.iter do
    byte (u64) += sum
done
sum print
"\n" print
255 message.push
if message.to_str.is_error then
    "invalid UTF-8" println
fi
