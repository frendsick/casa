pub struct Trace {
    pub id: i64
}

impl Trace {
    pub fn drop self:mut$Trace { self.id print "\n" print }
}

pub fn run {
    1 Trace = first
    2 Trace = second
    "body\n" print
}
run

pub fn run_array {
    3 Trace = third
    4 Trace = fourth
    # The array literal takes ownership of its elements, so the array alone
    # destroys them when it goes out of scope.
    [third, fourth] = traced: array[Trace 2]
    "array body\n" print
}
run_array
