# Move a generated texture with the mouse through raylib's public C API.
import "std" as std

const WINDOW_WIDTH 800
const WINDOW_HEIGHT 450
const TARGET_FPS 60
const IMAGE_SIZE 64

extern struct Color derives std::Copy {
    r: u8
    g: u8
    b: u8
    a: u8
}

extern struct Vector2 derives std::Copy {
    x: f32
    y: f32
}

extern struct Image derives std::Copy {
    data:    ptr
    width:   i32
    height:  i32
    mipmaps: i32
    format:  i32
}

extern struct Texture2D derives std::Copy {
    id:      u32
    width:   i32
    height:  i32
    mipmaps: i32
    format:  i32
}

extern fn InitWindow width:i32 height:i32 title:$cstr

extern fn CloseWindow

extern fn WindowShouldClose -> bool

extern fn SetTargetFPS fps:i32

extern fn BeginDrawing

extern fn EndDrawing

extern fn ClearBackground color:Color

extern fn GetMousePosition -> Vector2

extern fn GenImageColor width:i32 height:i32 color:Color -> Image

extern fn LoadTextureFromImage image:Image -> Texture2D

extern fn UnloadImage image:Image

extern fn UnloadTexture texture:Texture2D

extern fn DrawTextureV texture:Texture2D position:Vector2 tint:Color

Color { r: 80 g: 80 b: 80 a: 255 } = dark_gray
Color { r: 245 g: 245 b: 245 a: 255 } = ray_white
"Casa raylib example".as_cstr.unwrap = title
# SAFETY: The declarations match raylib's C ABI, and each native resource stays live until release.
unsafe {
    title WINDOW_HEIGHT WINDOW_WIDTH InitWindow
    TARGET_FPS SetTargetFPS

    ray_white IMAGE_SIZE IMAGE_SIZE GenImageColor = image
    image LoadTextureFromImage = texture
    image UnloadImage

    while WindowShouldClose ! do
        GetMousePosition = mouse_position
        BeginDrawing
        dark_gray ClearBackground
        ray_white mouse_position texture DrawTextureV
        EndDrawing
    done

    texture UnloadTexture
    CloseWindow
}
