import "std" as std
import "os" as os

pub fn main {
    "=== dir::current ===" std::println
    dir::current match
        std::Result::Ok(_) => "got cwd: true" std::println
        std::Result::Error(_) => "got cwd: false" std::println
    end

    "=== env::get ===" std::println
    "HOME" env::get.is_some.to_str = has_home
    f"HOME set: {has_home}" std::println_string
    "CASA_NONEXISTENT_VAR_XYZ" env::get.is_some.to_str = has_missing
    f"missing var set: {has_missing}" std::println_string

    "=== dir operations ===" std::println
    "/tmp/casa_os_test" = test_dir
    493 test_dir dir::create match
        std::Result::Ok(_) => "created: true" std::println
        std::Result::Error(e) => f"create error: {e.format}" std::println_string
    end
    test_dir dir::exists.to_str = exists_str
    f"dir exists: {exists_str}" std::println_string

    "hello" test_dir "test.txt" path::join.as_str file::write_all drop

    test_dir dir::list match
        std::Result::Ok(entries) => {
            f"entries: {entries.length}" std::println_string
            for entry in entries.iter do
                entry.to_str.unwrap = entry_text
                f"  {entry_text}" std::println_string
            done
        }
        std::Result::Error(e) => f"list error: {e.format}" std::println_string
    end

    "=== file::stat ===" std::println
    test_dir "test.txt" path::join.as_str file::stat match
        std::Result::Ok(st) => {
            f"size: {st.size}" std::println_string
            f"is_file: {st.is_file.to_str}" std::println_string
            f"is_dir: {st.is_dir.to_str}" std::println_string
        }
        std::Result::Error(e) => f"stat error: {e.format}" std::println_string
    end

    test_dir file::stat match
        std::Result::Ok(st) => {
            f"dir is_dir: {st.is_dir.to_str}" std::println_string
            f"dir is_file: {st.is_file.to_str}" std::println_string
        }
        std::Result::Error(e) => f"stat error: {e.format}" std::println_string
    end

    "=== path utilities ===" std::println
    "usr" "local" path::join = joined
    joined.as_str "bin" path::join = full
    f"join: {full}" std::println_string
    f"dirname: {full.as_str path::dirname}" std::println_string
    f"basename: {full.as_str path::basename}" std::println_string
    "src/main.casa" path::extension = ext
    f"extension: {ext}" std::println_string
    "Makefile" path::extension = no_ext
    f"no extension: '{no_ext}'" std::println_string
    "a/" "/b" path::join = slash_join
    f"slash join: {slash_join}" std::println_string

    "=== process ===" std::println
    std::List[std::String]::new = command
    "/usr/bin/env" command.push_str
    "true" command.push_str
    command std::run_command = exit_code
    f"exit code: {exit_code}" std::println_string

    "=== cleanup ===" std::println
    test_dir "test.txt" path::join.as_str file::remove drop
    test_dir dir::remove match
        std::Result::Ok(_) => "removed: true" std::println
        std::Result::Error(e) => f"remove error: {e.format}" std::println_string
    end
    test_dir dir::exists.to_str = gone_str
    f"dir exists after remove: {gone_str}" std::println_string
}
main
