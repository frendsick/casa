import "std"
import "os"

fn main {
    "=== dir::current ===" println
    dir::current match
        Result::Ok(_) => "got cwd: true" println
        Result::Error(_) => "got cwd: false" println
    end

    "=== env::get ===" println
    "HOME" env::get.is_some.to_str = has_home
    f"HOME set: {has_home}" println_string
    "CASA_NONEXISTENT_VAR_XYZ" env::get.is_some.to_str = has_missing
    f"missing var set: {has_missing}" println_string

    "=== dir operations ===" println
    "/tmp/casa_os_test" = test_dir
    493 test_dir dir::create match
        Result::Ok(_) => "created: true" println
        Result::Error(e) => f"create error: {e.format}" println_string
    end
    test_dir dir::exists.to_str = exists_str
    f"dir exists: {exists_str}" println_string

    "hello" test_dir "test.txt" path::join.as_str file::write_all drop

    test_dir dir::list match
        Result::Ok(entries) => {
            f"entries: {entries.length}" println_string
            for entry in entries.iter do
                f"  {entry}" println_string
            done
        }
        Result::Error(e) => f"list error: {e.format}" println_string
    end

    "=== file::stat ===" println
    test_dir "test.txt" path::join.as_str file::stat match
        Result::Ok(st) => {
            f"size: {st.size}" println_string
            f"is_file: {st.is_file.to_str}" println_string
            f"is_dir: {st.is_dir.to_str}" println_string
        }
        Result::Error(e) => f"stat error: {e.format}" println_string
    end

    test_dir file::stat match
        Result::Ok(st) => {
            f"dir is_dir: {st.is_dir.to_str}" println_string
            f"dir is_file: {st.is_file.to_str}" println_string
        }
        Result::Error(e) => f"stat error: {e.format}" println_string
    end

    "=== path utilities ===" println
    "usr" "local" path::join = joined
    joined.as_str "bin" path::join = full
    f"join: {full}" println_string
    f"dirname: {full.as_str path::dirname}" println_string
    f"basename: {full.as_str path::basename}" println_string
    "src/main.casa" path::extension = ext
    f"extension: {ext}" println_string
    "Makefile" path::extension = no_ext
    f"no extension: '{no_ext}'" println_string
    "a/" "/b" path::join = slash_join
    f"slash join: {slash_join}" println_string

    "=== process ===" println
    List[String]::new = command
    "/usr/bin/env" command.push_str
    "true" command.push_str
    command run_command = exit_code
    f"exit code: {exit_code}" println_string

    "=== cleanup ===" println
    test_dir "test.txt" path::join.as_str file::remove drop
    test_dir dir::remove match
        Result::Ok(_) => "removed: true" println
        Result::Error(e) => f"remove error: {e.format}" println_string
    end
    test_dir dir::exists.to_str = gone_str
    f"dir exists after remove: {gone_str}" println_string
}
main
