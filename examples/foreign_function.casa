import "std" as std

extern fn strlen text:$cstr -> u64

extern struct Division {
    quotient:  i32
    remainder: i32
}

extern fn div numerator:i32 denominator:i32 -> Division

"Casa FFI".as_cstr.unwrap = text
# SAFETY: `text` is a live NUL-terminated string for the duration of `strlen`.
unsafe { text strlen } print
"\n" print
# SAFETY: `div` accepts every denominator except zero, and this denominator is 6.
unsafe { 6 20 div } = division
division.quotient print
"\n" print
division.remainder print
"\n" print
