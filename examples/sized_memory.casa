import "std" as std

# Allocate 32 bytes of memory
unsafe { 32 alloc = buf }
# Store and load a 64-bit value
unsafe { 42 buf store64 }
unsafe { buf load64 print }
"\n" print
# Store and load an 8-bit value at byte offset 8
unsafe { 255 buf 8 + store8 }
unsafe { buf 8 + load8 print }
"\n" print
# Store and load a 16-bit value at byte offset 16
unsafe { 65535 buf 16 + store16 }
unsafe { buf 16 + load16 print }
"\n" print
# Store and load a 32-bit value at byte offset 24
unsafe { 100000 buf 24 + store32 }
unsafe { buf 24 + load32 print }
"\n" print
