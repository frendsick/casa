import "std"

# Allocate space for four 64-bit values.
unsafe { size_of [u64] 4 * alloc = buf }
# Store and load a 64-bit value
unsafe { 42 buf (ptr) store64 }
unsafe { buf (ptr) load64 print }
"\n" print
# Store and load an 8-bit value at byte offset 8
unsafe { 255 buf (ptr) 8 + store8 }
unsafe { buf (ptr) 8 + load8 print }
"\n" print
# Store and load a 16-bit value at byte offset 16
unsafe { 65535 buf (ptr) 16 + store16 }
unsafe { buf (ptr) 16 + load16 print }
"\n" print
# Store and load a 32-bit value at byte offset 24
unsafe { 100000 buf (ptr) 24 + store32 }
unsafe { buf (ptr) 24 + load32 print }
"\n" print
