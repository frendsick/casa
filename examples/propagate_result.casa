import "std"
import "os"

enum Checked {
    Invalid (i64)
    Valid (i64)
}

impl Checked {
    fn is_ok self:$Checked -> bool { self Checked::Valid is }

    fn unwrap self:$Checked -> i64 {
        self match
            Checked::Invalid(value) => value
            Checked::Valid(value) => value
        end
    }

    fn propagate self:$Checked -> Checked {
        self match
            Checked::Invalid(value) => value Checked::Invalid
            Checked::Valid(value) => value Checked::Invalid
        end
    }
}

fn read_and_count_lines path:$str -> Result[u64 IoError] {
    path file::read_all ? "\n" str::split.length Result::Ok
}

fn require_positive value:i64 -> Checked {
    if 0 value > then
        value Checked::Valid
    else
        value Checked::Invalid
    fi
}

fn double_positive value:i64 -> Checked { value require_positive ? 2 * Checked::Valid }

fn main {
    "/tmp/casa_prop_result_test.txt" = path
    "line1\nline2\nline3" path file::write_all drop
    path read_and_count_lines match
        Result::Ok(n) => {
            f"line count: {n}\n" print
        }
        Result::Error(e) => {
            f"error: {e.to_str}\n" print
        }
    end
    "/tmp/casa_no_such_file_xyz.txt" read_and_count_lines match
        Result::Ok(_) => "unexpected ok\n" print
        Result::Error(e) => {
            f"error: {e.to_str}\n" print
        }
    end
    4 double_positive match
        Checked::Valid(value) => {
            f"custom value: {value}\n" print
        }
        Checked::Invalid(value) => {
            f"custom error: {value}\n" print
        }
    end
    -2 double_positive match
        Checked::Valid(value) => {
            f"custom value: {value}\n" print
        }
        Checked::Invalid(value) => {
            f"custom error: {value}\n" print
        }
    end
    path file::remove drop
}
main
