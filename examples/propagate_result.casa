import "std" as std
import "os" as os

pub enum Checked {
    Invalid (i64)
    Valid (i64)
}

impl Checked {
    pub fn is_ok self:$Checked -> bool { self Checked::Valid is }

    pub fn unwrap self:$Checked -> i64 {
        self match
            Checked::Invalid(value) => value
            Checked::Valid(value) => value
        end
    }

    pub fn propagate self:$Checked -> Checked {
        self match
            Checked::Invalid(value) => value Checked::Invalid
            Checked::Valid(value) => value Checked::Invalid
        end
    }
}

pub fn read_and_count_lines path:$str -> std::Result[u64 os::IoError] {
    path file::read_all ? = text
    text.as_str "\n" str::split.length std::Result::Ok
}

pub fn require_positive value:i64 -> Checked {
    if 0 value > then
        value Checked::Valid
    else
        value Checked::Invalid
    fi
}

pub fn double_positive value:i64 -> Checked { value require_positive ? 2 * Checked::Valid }

pub fn main {
    "/tmp/casa_prop_result_test.txt" = path
    "line1\nline2\nline3" path file::write_all drop
    path read_and_count_lines match
        std::Result::Ok(n) => {
            f"line count: {n}\n" print
        }
        std::Result::Error(e) => {
            f"error: {e.to_str}\n" print
        }
    end
    "/tmp/casa_no_such_file_xyz.txt" read_and_count_lines match
        std::Result::Ok(_) => "unexpected ok\n" print
        std::Result::Error(e) => {
            f"error: {e.to_str}\n" print
        }
    end
    4 double_positive match
        Checked::Valid(value) => {
            f"custom value: {value}\n" print
        }
        Checked::Invalid(value) => {
            f"custom error: {value}\n" print
        }
    end
    -2 double_positive match
        Checked::Valid(value) => {
            f"custom value: {value}\n" print
        }
        Checked::Invalid(value) => {
            f"custom error: {value}\n" print
        }
    end
    path file::remove drop
}
main
