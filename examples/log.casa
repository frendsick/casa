# Logging library
# Demonstrates leveled logging to stderr with configurable log levels.
import "log" as log

log::Logger::new = logger
# Default level is Warning. Info and Debug are suppressed.
logger "this info is hidden" log::log_info
logger "this warning is visible" log::log_warning
# Raise the level to Info
log::LogLevel::Info logger.configure
logger "now info is visible" log::log_info
# Print to stdout to confirm the program ran
"done\n" print
