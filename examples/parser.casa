# Parse a small `name = value` assignment.
import "parser" as parser

pub struct Assignment {
    pub name:  String
    pub value: i64
}

pub fn parse_assignment cursor:parser::Cursor -> Result[Assignment parser::ParseError] {
    cursor parser::skip_whitespace
    cursor parser::parse_identifier ? = name
    cursor parser::skip_whitespace
    '=' cursor.expect_char ? drop
    cursor parser::skip_whitespace
    cursor parser::parse_int ? = value
    Assignment { name: name value: value } Result::Ok
}
"workers = 12" parser::Cursor::new parse_assignment.unwrap = assignment
f"{assignment.name}: {assignment.value}" println_string
