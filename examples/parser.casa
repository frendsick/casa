# Parse a small `name = value` assignment.
import "parser"

struct Assignment {
    name:  String
    value: i64
}

fn parse_assignment cursor:Cursor -> Result[Assignment ParseError] {
    cursor skip_whitespace
    cursor parse_identifier ? = name
    cursor skip_whitespace
    '=' cursor.expect_char ? drop
    cursor skip_whitespace
    cursor parse_int ? = value
    Assignment { name: name value: value } Result::Ok
}
"workers = 12" Cursor::new parse_assignment.unwrap = assignment
f"{assignment.name}: {assignment.value}" println_string
