# Classify sensor readings with an enum and guarded patterns.
import "std" as std

pub enum Reading {
    Missing
    Value (i64)
}

pub enum Tree derives std::Eq std::Ord std::Hashable std::Clone {
    Leaf (i64)
    Branch (Tree Tree)
}

pub fn describe reading:Reading -> str {
    reading match
        Reading::Missing => "missing"
        Reading::Value(value) if 100 value > => "high"
        Reading::Value(value) if 0 value > => "normal"
        Reading::Value(_) => "zero or below"
    end
}
Reading::Missing describe std::println
42 Reading::Value describe std::println
140 Reading::Value describe std::println
-5 Reading::Value describe std::println
1 Tree::Leaf = leaf
leaf.clone leaf.clone Tree::Branch = tree
f"recursive clone equal: {tree.clone tree ==}" std::println_string
