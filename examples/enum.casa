# Classify sensor readings with an enum and guarded patterns.
import "std" as std

pub enum Reading {
    Missing
    Value(i64)
}

pub enum Tree derives std::Eq std::Ord std::Hashable std::Clone {
    Leaf(i64)
    Branch(Tree Tree)
}

pub fn describe reading:Reading -> str {
    reading match
        Reading::Missing => "missing"
        Reading::Value(value) if 100 value < => "high"
        Reading::Value(value) if 0 value < => "normal"
        Reading::Value(_) => "zero or below"
    end
}

# Skip readings without a value. The binding stays available after `fi`.
pub fn sum_values readings:$std::List[Reading] -> i64 {
    0 = total
    for reading in readings.iter do
        if reading Reading::Value(value) is else
            continue
        fi
        value += total
    done
    total
}

pub fn describe_tree tree:$Tree -> str {
    tree match
        Tree::Leaf(0) | Tree::Branch(Tree::Leaf(0) Tree::Leaf(0)) => "zero"
        Tree::Branch(Tree::Leaf(_) Tree::Leaf(_)) => "two leaves"
        _ => "other"
    end
}

# The inner constructor supplies the type argument its payload cannot determine.
pub fn read_nested value:std::Option[std::Result[i64 i64]] { value drop }

3 std::Result[i64 i64]::Ok std::Option::Some read_nested
Reading::Missing describe std::println
42 Reading::Value describe std::println
140 Reading::Value describe std::println
-5 Reading::Value describe std::println
std::List[Reading]::new = readings
42 Reading::Value readings.push
Reading::Missing readings.push
-5 Reading::Value readings.push
f"sum of values: {readings sum_values}" std::println_string
1 Tree::Leaf = leaf
leaf.clone leaf.clone Tree::Branch = tree
f"recursive clone equal: {tree.clone tree ==}" std::println_string
tree describe_tree std::println
