# Classify sensor readings with an enum and guarded patterns.
import "std"

enum Reading {
    Missing
    Value (i64)
}

fn describe reading:Reading -> str {
    reading match
        Reading::Missing => "missing"
        Reading::Value(value) if 100 value > => "high"
        Reading::Value(value) if 0 value > => "normal"
        Reading::Value(_) => "zero or below"
    end
}
Reading::Missing describe println
42 Reading::Value describe println
140 Reading::Value describe println
-5 Reading::Value describe println
