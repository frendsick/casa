import "std" as std

const ALIGNMENT_MASK: u64 0xFFFFFFFFFFFFFFF8
0x123F = address: u64
address ALIGNMENT_MASK & = aligned
f"Aligned address: {aligned}\n" print
0xFF = byte: u8
f"Byte: {byte}\n" print
0xFFFFFFFFFFFFFFFF = maximum: u64
f"Maximum u64: {maximum}\n" print
-0x80 = minimum: i8
f"Minimum i8: {minimum}\n" print
