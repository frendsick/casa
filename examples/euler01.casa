# === Multiples of 3 or 5 ===
# Find the sum of all the multiples of 3 or 5 below 1000
const LIMIT_INCLUSIVE 999
pub const LIMIT_EXCLUSIVE: i64 { LIMIT_INCLUSIVE 1 + }
3 = m1
5 = m2
LIMIT_EXCLUSIVE m1 sum_of_multiples = sum_m1
LIMIT_EXCLUSIVE m2 sum_of_multiples = sum_m2
LIMIT_EXCLUSIVE m1 m2 * sum_of_multiples = sum_lcm
sum_m1 sum_m2 + sum_lcm - print "\n" print
# https://www.geeksforgeeks.org/maths/sum-of-n-terms-of-an-ap/
# n * d(n + 1) / 2

pub fn sum_of_multiples multiple:i64 limit:i64 -> i64 {
    limit 1 - multiple / = count
    count multiple *
    count 1 + *
    2 /
}
