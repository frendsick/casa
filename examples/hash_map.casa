# Count repeated words with a map.
import "std"

Map[str i64]::new = counts
for word in ["casa", "stack", "types", "casa", "types", "casa"].iter do
    if word counts.get Option::Some(count) is then
        count 1 +
    else
        1
    fi
    word.clone counts.set = counts
done
for word in ["casa", "stack", "types"].iter do
    word counts.get.unwrap = count
    f"{word}: {count}" println
done
