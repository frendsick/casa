# One generic function works with each type that implements Named.
import "std"

trait Named {
    fn name self:self -> str
}

struct Task {
    title: str
}

impl Task: Named {
    fn name self:Task -> str { self.title }
}

struct Project {
    title: str
}

impl Project: Named {
    fn name self:Project -> str { self.title }
}

fn announce [T:Named] item:T {
    item.name = item_name
    f"Now working on: {item_name}" println
}
Task { title: "documentation" } announce
Project { title: "Casa" } announce
