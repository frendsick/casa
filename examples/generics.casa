# Use generic functions for trait calls and borrowed payloads.
import "std" as std

pub trait Named {
    fn name self:self -> str
}

pub struct Task {
    pub title: str
}

impl Task: Named {
    pub fn name self:Task -> str { self.title.clone }
}

pub struct Project {
    pub title: str
}

impl Project: Named {
    pub fn name self:Project -> str { self.title.clone }
}

pub fn announce [T:Named] item:T {
    item.name = item_name
    f"Now working on: {item_name}" std::println_string
}
Task { title: "documentation" } announce
Project { title: "Casa" } announce

struct Slot[T] {
    value: std::Option[T]
}

fn store [T] slot:mut$Slot[T] item:T -> mut$Slot[T] {
    slot
    item std::Option::Some = slot.value
}
"stored borrow".to_str = text
std::Option[$str]::None Slot = slot
slot = destination: mut$Slot[$str]
text.as_str destination store = filled

# The alias and returned stack value both retain text as a source.
if filled.value std::Option::Some(value) is then
    value std::println
fi
filled drop
destination drop
slot drop
text drop
