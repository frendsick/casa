# One generic function works with each type that implements Named.
import "std" as std

pub trait Named {
    fn name self:self -> str
}

pub struct Task {
    pub title: str
}

impl Task: Named {
    pub fn name self:Task -> str { self.title.clone }
}

pub struct Project {
    pub title: str
}

impl Project: Named {
    pub fn name self:Project -> str { self.title.clone }
}

pub fn announce [T:Named] item:T {
    item.name = item_name
    f"Now working on: {item_name}" std::println_string
}
Task { title: "documentation" } announce
Project { title: "Casa" } announce
