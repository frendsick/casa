# Define an iterator and use it in a for loop.
import "std"

struct Countdown {
    value: i64
}

impl Countdown: Iterable[i64] {
    fn next self:mut$Countdown -> Option[i64] {
        if 0 self.value < then
            Option[i64]::None return
        fi
        self.value = current
        1 -= self.value
        current Option::Some
    }
}
"countdown:" print
for value in Countdown { value: 5 } do
    f" {value}" print
done
"\n" print
