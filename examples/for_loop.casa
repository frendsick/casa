# Define an iterator and use it in a for loop.
import "std" as std

pub struct Countdown {
    pub value: i64
}

impl Countdown: std::Iterable[i64] {
    pub fn next self:mut$Countdown -> std::Option[i64] {
        if 0 self.value < then
            std::Option[i64]::None return
        fi
        self.value = current
        1 -= self.value
        current std::Option::Some
    }
}
"countdown:" print
for value in Countdown { value: 5 } do
    f" {value}" print
done
"\n" print
