import "std" as std

for index in 31 1 std::Range::new do
    index fizzbuzz
done

pub fn fizzbuzz number:i64 {
    number 3 % 0 == = fizz
    number 5 % 0 == = buzz

    if fizz buzz && then
        "FizzBuzz\n" print
    elif fizz then
        "Fizz\n" print
    elif buzz then
        "Buzz\n" print
    else
        number print '\n' print
    fi
}
