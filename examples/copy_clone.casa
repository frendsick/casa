import "std"

struct Point derives Copy {
    x: i64
    y: i64
}

struct Counter {
    value: i64
}

impl Counter: Clone {
    fn clone self:$Counter -> Counter { self.value Counter }
}
2 1 Point = point
point dup = first = second
first.x.to_str println
second.y.to_str println
point copy.x.to_str println
point
    .clone
    .y
    .to_str println
"hello".clone println
10 Counter
    .clone
    .value
    .to_str println
