import "std" as std

pub enum Direction derives std::Copy {
    North
    South
}

pub struct Counter {
    pub value: i64
}

impl Counter: std::Clone {
    pub fn clone self:$Counter -> Counter { self.value Counter }
}
Direction::North = direction
direction dup drop drop
direction copy drop
direction.clone drop
"hello".clone std::println
10 Counter
    .clone
    .value
    .to_str std::println_string
