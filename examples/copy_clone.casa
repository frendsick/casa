import "std"

enum Direction derives Copy {
    North
    South
}

struct Counter {
    value: i64
}

impl Counter: Clone {
    fn clone self:$Counter -> Counter { self.value Counter }
}
Direction::North = direction
direction dup drop drop
direction copy drop
direction.clone drop
"hello".clone println
10 Counter
    .clone
    .value
    .to_str println
