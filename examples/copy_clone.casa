import "std" as std

pub enum Direction derives std::Eq std::Copy {
    North
    South
}

pub struct Counter derives std::Eq std::Ord std::Hashable std::Clone {
    pub value: i64
}

Direction::North = direction
direction dup drop drop
direction copy drop
direction.clone drop
"hello".clone std::println
10 Counter
    .clone
    .value
    .to_str std::println_string

struct Point derives std::Copy {
    pub x: i64
    pub y: i64
}

20 10 Point = original
original = changed
30 = changed.x
original.x.to_str std::println_string
changed.x.to_str std::println_string
42 std::Option::Some dup = option_copy = option
option.unwrap.to_str std::println_string
option_copy.unwrap.to_str std::println_string
