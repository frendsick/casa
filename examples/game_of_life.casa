# Conway's Game of Life with toroidal wrapping. Left mouse draws, right erases.
import "raylib"
import "std"
import "game_of_life/grid.casa" as life

const WINDOW_WIDTH 800
const WINDOW_HEIGHT 600
const CELL_SCALE 8
const CELL_SCALE_FLOAT 8.0
const TARGET_FPS 5
const ALIVE_THRESHOLD 64

fn dark_gray -> raylib::Color {
    raylib::Color { r: 80 g: 80 b: 80 a: 255 }
}

fn white -> raylib::Color {
    raylib::Color { r: 255 g: 255 b: 255 a: 255 }
}

# Preserve the top-left overlap and randomize only newly exposed cells.
fn populate grid:mut$life::Grid previous:$life::Grid context:$raylib::Context {
    0 = y
    while grid.height i64::from y < do
        0 = x
        while grid.width i64::from x < do
            y i32::try_from.unwrap = row
            x i32::try_from.unwrap = column
            if previous.width column < previous.height row < && then
                row column previous.alive
            else
                ALIVE_THRESHOLD context.random_byte <
            fi = alive
            alive row column grid.set
            1 += x
        done
        1 += y
    done
}

fn edit grid:mut$life::Grid context:$raylib::Context {
    raylib::MOUSE_BUTTON_LEFT context.mouse_button_down = create
    raylib::MOUSE_BUTTON_RIGHT context.mouse_button_down = erase
    if create erase || ! then
        return
    fi
    context.mouse_position = mouse
    if 0.0 mouse.x < 0.0 mouse.y < || then
        return
    fi
    if mouse.x CELL_SCALE_FLOAT / i32::try_from std::Option::Some(x) is then
        if mouse.y CELL_SCALE_FLOAT / i32::try_from std::Option::Some(y) is then
            erase ! y x grid.set
        fi
    fi
}

fn paint image:mut$raylib::Image grid:$life::Grid {
    dark_gray image.clear
    0 = y
    while grid.height i64::from y < do
        0 = x
        while grid.width i64::from x < do
            y i32::try_from.unwrap = row
            x i32::try_from.unwrap = column
            if row column grid.alive then
                white row column image.set_pixel drop
            fi
            1 += x
        done
        1 += y
    done
}

struct Simulation {
    grid:    life::Grid
    image:   raylib::Image
    texture: raylib::Texture
}

impl Simulation {
    fn new context:$raylib::Context width:i32 height:i32 -> std::Option[Simulation] {
        if dark_gray height width raylib::Image::new std::Option::Some(image) is then
            if height width life::Grid::new std::Option::Some(grid) is then
                context image raylib::Texture::new = upload = image
                if upload std::Option::Some(texture) is then
                    Simulation { grid: grid image: image texture: texture } std::Option::Some return
                fi
            fi
        fi
        std::Option::None
    }
}

fn simulate context:$raylib::Context drawing:mut$raylib::Drawing -> std::Option[bool] {
    context.set_resizable
    TARGET_FPS context.set_target_fps
    # A one-cell placeholder lets minimized startup retain valid resources.
    1 1 context Simulation::new ? = simulation
    ALIVE_THRESHOLD context.random_byte < 0 0 simulation.grid.set
    true = success
    while context.should_close ! do
        context.screen_width CELL_SCALE / = width
        context.screen_height CELL_SCALE / = height
        if context.is_minimized 0 width <= || 0 height <= || then
            simulation.texture drawing.begin = frame
            dark_gray frame.clear
            continue
        fi
        if width simulation.grid.width != height simulation.grid.height != || then
            if height width context Simulation::new std::Option::Some(replacement) is then
                context simulation.grid replacement.grid populate
                replacement = simulation
            else
                false = success
                break
            fi
        fi
        simulation.grid.advance
        context simulation.grid edit
        simulation.grid simulation.image paint
        if simulation.image simulation.texture.update_from ! then
            false = success
            break
        fi
        simulation.texture drawing.begin = frame
        dark_gray frame.clear
        white CELL_SCALE_FLOAT raylib::Vector2 { x: 0.0 y: 0.0 } frame.draw_texture_scaled
    done
    success std::Option::Some
}

fn run -> bool {
    "Casa Game of Life".as_cstr.unwrap = title
    if title WINDOW_HEIGHT WINDOW_WIDTH raylib::Window::new std::Option::Some(window) is then
        window.split = drawing = context
        if drawing context simulate std::Option::Some(ok) is then
            if ok then
                true return
            fi
        fi
        "Could not create or update the grid graphics.\n" print
    else
        "Could not open the window.\n" print
    fi
    false
}
if run then 0 else 1 fi process::exit
