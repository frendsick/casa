# Conway's Game of Life
# Runs fullscreen in the terminal with toroidal wrapping.
# Adapts to terminal resize. Exit with Ctrl+C.
import "std" as std
import "os" as os

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
pub const SYS_IOCTL 16
pub const SYS_NANOSLEEP 35
pub const TIOCGWINSZ 21523
pub const ALIVE_THRESHOLD 64
pub const FRAME_DELAY_MS 200

# ---------------------------------------------------------------------------
# Terminal helpers
# ---------------------------------------------------------------------------

pub fn write_stdout text:$str { text 1 file::write drop }

# ---------------------------------------------------------------------------
# Random
# ---------------------------------------------------------------------------

pub fn fill_random buffer:ptr size:u64 {
    0 os::O_RDONLY "/dev/urandom" file::open = urandom_fd
    size buffer urandom_fd file::read drop
    urandom_fd file::close drop
}

pub fn randomize_grid grid:ptr size:u64 {
    size grid fill_random
    0 (u64) = index
    while index size > do
        if unsafe { ALIVE_THRESHOLD grid index + load8 < } then
            unsafe { 1 grid index + store8 }
        else
            unsafe { 0 grid index + store8 }
        fi
        1 += index
    done
}

# ---------------------------------------------------------------------------
# Neighbor counting (toroidal wrap)
# ---------------------------------------------------------------------------

pub fn count_neighbors grid:ptr grid_width:i64 grid_height:i64 x:i64 y:i64 -> i64 {
    0 = neighbor_count
    -1 = dy
    while dy 2 > do
        -1 = dx
        while dx 2 > do
            if 0 dx == 0 dy == && then
                1 += dx
                continue
            fi
            y dy + grid_height + grid_height % = ny
            x dx + grid_width + grid_width % = nx
            unsafe { grid ny grid_width * nx + (u64) + load8 (i64) += neighbor_count }
            1 += dx
        done
        1 += dy
    done
    neighbor_count
}

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

pub fn render grid:ptr grid_width:i64 grid_height:i64 {
    std::String::new = frame
    "\x1b[H" frame.append
    0 = render_row
    while render_row grid_height > do
        0 = render_col
        while render_col grid_width > do
            if unsafe { 0 grid render_row grid_width * render_col + (u64) + load8 != } then
                "\u{2588}" frame.append
            else
                " " frame.append
            fi
            1 += render_col
        done
        if render_row grid_height 1 - != then
            "\n" frame.append
        fi
        1 += render_row
    done
    frame.as_str write_stdout
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
# Allocate reusable buffers for ioctl and nanosleep
unsafe { 8 alloc = winsize_buf }
unsafe { 16 alloc = timespec_buf }
unsafe { 0 timespec_buf (ptr) store64 }
unsafe { FRAME_DELAY_MS 1000000 * (u64) timespec_buf (ptr) 8 + store64 }
# Get initial terminal size (exit if stdout is not a terminal)
unsafe { winsize_buf (i64) TIOCGWINSZ 1 SYS_IOCTL syscall3 = ioctl_result }
if 0 ioctl_result < then
    0 std::exit
fi
unsafe { winsize_buf 2 + load16 (i64) = width }
unsafe { winsize_buf load16 (i64) = height }
width height * (u64) = grid_size
# Allocate and initialize grids
unsafe { grid_size alloc = current }
unsafe { grid_size alloc = next_grid }
grid_size current randomize_grid
# Clear screen
"\x1b[2J" write_stdout
# Game loop
while true do
    # Check for terminal resize
    unsafe { winsize_buf (i64) TIOCGWINSZ 1 SYS_IOCTL syscall3 drop }
    unsafe { winsize_buf 2 + load16 (i64) = new_width }
    unsafe { winsize_buf load16 (i64) = new_height }

    if
        new_width width !=
        new_height height != ||
    then
        new_width new_height * (u64) = new_grid_size

        # Allocate fresh buffers
        unsafe { new_grid_size alloc = new_current }
        unsafe { new_grid_size alloc = new_next }

        # Fill new grid with random cells
        new_grid_size new_current randomize_grid

        # Zero the next buffer
        0 (u64) = zero_index
        while zero_index new_grid_size > do
            unsafe { 0 new_next zero_index + store8 }
            1 += zero_index
        done

        # Copy overlapping region from old grid
        if new_width width > then new_width else width fi = copy_width
        if new_height height > then new_height else height fi = copy_height
        0 = copy_row
        while copy_row copy_height > do
            copy_width (u64)
            unsafe { current copy_row width * (u64) + }
            unsafe { new_current copy_row new_width * (u64) + }
            unsafe { std::memcpy }
            1 += copy_row
        done

        new_current = current
        new_next = next_grid
        new_width = width
        new_height = height
        width height * (u64) = grid_size

        # Clear screen after resize
        "\x1b[2J" write_stdout
    fi

    # Render current state
    height width current render

    # Compute next generation
    0 = gen_y
    while gen_y height > do
        0 = gen_x
        while gen_x width > do
            gen_y gen_x height width current count_neighbors = neighbors
            unsafe { current gen_y width * gen_x + (u64) + load8 = cell_alive }

            if 0 cell_alive != then
                if 2 neighbors == 3 neighbors == || then
                    unsafe { 1 next_grid gen_y width * gen_x + (u64) + store8 }
                else
                    unsafe { 0 next_grid gen_y width * gen_x + (u64) + store8 }
                fi
            else
                if 3 neighbors == then
                    unsafe { 1 next_grid gen_y width * gen_x + (u64) + store8 }
                else
                    unsafe { 0 next_grid gen_y width * gen_x + (u64) + store8 }
                fi
            fi
            1 += gen_x
        done
        1 += gen_y
    done

    # Swap buffers
    current = swap_temp
    next_grid = current
    swap_temp = next_grid

    # Sleep
    unsafe { 0 (i64) timespec_buf (i64) SYS_NANOSLEEP syscall2 drop }
done
