import "std"

# Both buffers contain one initialized byte per cell. Dimensions stay positive.
pub struct Grid {
    grid_width:  i32
    grid_height: i32
    current:     std::RawBuffer
    next:        std::RawBuffer
}

impl Grid {
    pub fn new width:i32 height:i32 -> std::Option[Grid] {
        if 0 width >= 0 height >= || then
            std::Option::None return
        fi
        width u64::try_from.unwrap height u64::try_from.unwrap * = size
        size std::RawBuffer::new = current
        size std::RawBuffer::new = next
        0 = index: u64
        while size index > do
            # SAFETY: Each index initializes one byte inside both owned buffers.
            unsafe { 0 current.data index + store8 0 next.data index + store8 }
            1 += index
        done
        Grid { grid_width: width grid_height: height current: current next: next } std::Option::Some
    }

    pub fn width self:$Grid -> i32 { self.grid_width }

    pub fn height self:$Grid -> i32 { self.grid_height }

    pub fn alive self:$Grid x:i32 y:i32 -> bool {
        if 0 x > 0 y > || self.grid_width x <= || self.grid_height y <= || then
            false return
        fi
        y u64::try_from.unwrap self.grid_width u64::try_from.unwrap * x u64::try_from.unwrap + = index
        # SAFETY: Coordinates are in bounds and current is initialized.
        unsafe { 0 self.current.data index + load8 != }
    }

    pub fn set self:mut$Grid x:i32 y:i32 alive:bool {
        if 0 x > 0 y > || self.grid_width x <= || self.grid_height y <= || then
            return
        fi
        y u64::try_from.unwrap self.grid_width u64::try_from.unwrap * x u64::try_from.unwrap + = index
        if alive then 1 else 0 fi = value: u8
        # SAFETY: Coordinates are in bounds and self exclusively owns current.
        unsafe { value self.current.data index + store8 }
    }

    fn count_neighbors self:$Grid x:i32 y:i32 -> i32 {
        0 = count: i32
        -1 = dy: i64
        while 2 dy > do
            -1 = dx: i64
            while 2 dx > do
                if 0 dx == 0 dy == && then
                    1 += dx
                    continue
                fi
                x i64::from dx + self.grid_width i64::from + self.grid_width i64::from % i32::try_from.unwrap = nx
                y i64::from dy + self.grid_height i64::from + self.grid_height i64::from % i32::try_from.unwrap = ny
                if ny nx self.alive then
                    1 += count
                fi
                1 += dx
            done
            1 += dy
        done
        count
    }

    pub fn advance self:mut$Grid {
        0 = y: i64
        while self.grid_height i64::from y > do
            0 = x: i64
            while self.grid_width i64::from x > do
                y i32::try_from.unwrap = row
                x i32::try_from.unwrap = column
                row column self.count_neighbors = neighbors
                3 neighbors == 2 neighbors == row column self.alive && || = alive
                if alive then 1 else 0 fi = value: u8
                y u64::try_from.unwrap self.grid_width u64::try_from.unwrap * x u64::try_from.unwrap + = index
                # SAFETY: Every cell writes its successor into the separate next buffer.
                unsafe { value self.next.data index + store8 }
                1 += x
            done
            1 += y
        done
        # Exchange the two owned allocations without copying cells. Both owners
        # still release one distinct buffer after the swap.
        self.next self.current.swap_with
    }
}
