import "std" as std

struct Message {
    text: std::String
}

impl Message {
    pub fn drop self:mut$Message {
        self.text.as_str print
        " cleaned\n" print
    }
}

fn show message:$Message limit:i64 {
    message.text.as_str print
    ", limit " print
    limit print
    "\n" print
}
"hello".to_str Message = message
"goodbye".to_str Message = second
3 message show
