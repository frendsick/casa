# Build a lazy processing pipeline, then collect and summarize its results.
import "std"

[3, 8, 11, 14, 20, 25] = readings
{ 2 % 0 == } readings.iter.filter = even_readings
{ dup * } even_readings.map.collect = squares: List[i64]
f"even squares: {squares}" println
{ + } 0 squares.iter.fold = total
f"total: {total}" println
# A slice is a borrowed runtime-length view into a list.
3 1 squares.slice = tail
{ + } 0 tail.iter.fold = tail_total
f"tail total: {tail_total}" println
