# Build a lazy processing pipeline, then collect and summarize its results.
import "std" as std

pub fn add_borrowed accumulator:i64 value:$i64 -> i64 { value copy accumulator + }

pub fn checked_add accumulator:i64 value:$i64 -> std::Result[i64 str] {
    if 100 value copy < then
        "square exceeds 100" std::Result::Error
    else
        value copy accumulator + std::Result::Ok
    fi
}

pub fn check_square value:$i64 -> std::Result[std::Unit str] {
    if 100 value copy < then
        "square exceeds 100" std::Result::Error
    else
        std::Unit::Value std::Result::Ok
    fi
}

pub fn total_view values:$std::Slice[i64] -> i64 { &add_borrowed 0 values.iter.fold }

pub fn demonstrate_iterators {
    [3, 8, 11, 14, 20, 25] = readings
    { copy 2 % 0 == } readings.iter.filter = even_readings
    { copy dup * } even_readings.map.collect = squares: std::List[i64]
    f"even squares: {squares}" std::println_string
    &add_borrowed 0 squares.iter.fold = total
    f"total: {total}" std::println_string
    # The same sequence API accepts borrowed views of an array or a list.
    readings.as_slice total_view = readings_total
    f"readings total: {readings_total}" std::println_string
    3 1 squares.slice = tail
    tail total_view = tail_total
    f"tail total: {tail_total}" std::println_string
    &checked_add 0 squares.iter.try_fold match
        std::Result::Ok(sum) => f"checked sum: {sum}" std::println_string
        std::Result::Error(error) => f"checked sum: {error}" std::println_string
    end
    squares.iter = checked_iter
    &check_square checked_iter.try_for_each match
        std::Result::Ok(_) => "all squares passed" std::println
        std::Result::Error(error) => f"check: {error}" std::println_string
    end
    checked_iter.next.unwrap copy = remaining
    f"next unvisited square: {remaining}" std::println_string
}
demonstrate_iterators
