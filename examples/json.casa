import "std"
import "json"

enum Role {
    Reader
    Editor
}

impl Role: json::Serialize + json::Deserialize {
    fn to_json self:$Role -> std::Result[json::JsonValue json::Error] {
        self match
            Role::Reader => "reader".to_json
            Role::Editor => "editor".to_json
        end
    }
    fn from_json value:$json::JsonValue -> std::Result[Role json::Error] {
        value std::String::from_json ? = name
        name.as_str match
            "reader" => Role::Reader std::Result::Ok
            "editor" => Role::Editor std::Result::Ok
            _ => "unknown role" json::Error::InvalidValue std::Result::Error
        end
    }
}

struct User {
    name: std::String
    role: Role
}

impl User: json::Serialize + json::Deserialize {
    fn to_json self:$User -> std::Result[json::JsonValue json::Error] {
        json::json_object = fields
        self.name.to_json ? "name" fields.set_str
        self.role.to_json ? "role" fields.set_str
        fields json::JsonValue::JsonObject std::Result::Ok
    }
    fn from_json value:$json::JsonValue -> std::Result[User json::Error] {
        "name" value.require_field ? std::String::from_json ? = name
        "role" value.require_field ? &Role::from_json exec ? = role
        User { name: name role: role } std::Result::Ok
    }
}
User { name: "Mäkelä".to_str role: Role::Editor } = original
original json::serialize.unwrap = encoded
f"JSON: {encoded}\n" print
encoded.as_str &json::deserialize[User] exec = decoded
decoded.unwrap = user
f"Name: {user.name}\n" print
