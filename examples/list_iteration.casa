# Borrow shared elements, mutate them, then transfer them into an owning iterator.
import "std" as std

struct Reading {
    value: i64
}

[Reading { value: 10 }, Reading { value: 20 }, Reading { value: 30 }]
std::List::from_array = readings
readings.iter = shared: std::ListIter[Reading]
shared.next.unwrap = sample
shared.next drop
shared drop

# A shared yield keeps the list borrowed after the cursor is destroyed.
sample.value drop
for reading in readings.iter_mut do
    1 += reading.value
done
readings.into_iter = remaining
remaining.next.unwrap = first
for reading in remaining do
    reading.value print "\n" print
    break
done

# The first yield remains owned here after the loop destroys the remainder.
first.value print "\n" print
