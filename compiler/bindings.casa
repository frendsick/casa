import "std" as std
import "common" as common

# Resolve storage from checked binding facts without changing source spelling.
impl common::Op {
    pub fn resolve_binding_storage_name self:$common::Op name:$str -> std::String {
        if self.bindings std::Option::Some(facts) is then
            name facts resolve_fact_storage_name return
        fi
        name.to_str
    }
}

pub fn resolve_fact_storage_name facts:$std::List[common::BindingFact] name:$str -> std::String {
    facts.length = index
    while 0 index != do
        1 -= index
        index facts.get = binding
        if name binding.get_name.as_str == then
            binding.get_storage_name.clone return
        fi
    done
    name.to_str
}

fn needs_binding_lowering facts:$std::List[common::BindingFact] -> bool {
    for binding in facts.iter do
        if binding.get_name binding.get_storage_name != then
            true return
        fi
    done
    false
}

fn lower_pattern_storage
    pattern:common::PatternValue
    facts:$std::List[common::BindingFact]
-> common::PatternValue {
    pattern match
        common::PatternValue::EnumVariant(variant) => {
            std::List[std::String]::new = bindings
            for name in variant.bindings.iter do
                name.as_str facts resolve_fact_storage_name bindings.push
            done
            bindings = variant.bindings
            variant common::PatternValue::EnumVariant
        }
        common::PatternValue::Struct(struct_pattern) => {
            std::Map[std::String std::String]::new = bindings
            for pair in struct_pattern.bindings.iter do
                pair.second.as_str facts resolve_fact_storage_name pair.first.clone bindings.set
            done
            bindings = struct_pattern.bindings
            struct_pattern common::PatternValue::Struct
        }
        common::PatternValue::Literal(literal) => literal common::PatternValue::Literal
    end
}

# The backend owns this lowered stream. Rewrite its storage names in place.
pub fn lower_binding_storage operations:mut$std::List[common::Op] {
    0 = index: u64
    while index operations.length > do
        index operations.get_mut lower_operation_storage
        1 += index
    done
}

fn lower_ownership_storage operation:mut$common::Op {
    std::Option[std::String]::None = conditional_move
    operation = source: $common::Op
    if source.ownership std::Option::Some(source_ownership) is then
        if source_ownership.conditional_move std::Option::Some(name) is then
            name.as_str source.resolve_binding_storage_name std::Option::Some = conditional_move
        fi
    fi
    if operation.ownership std::Option::Some(ownership) is then
        0 = index: u64
        while index ownership.assignments.length > do
            index ownership.assignments.get_mut = event
            if event.name event.storage_name != then
                event.storage_name.clone = event.name
            fi
            1 += index
        done
        0 = index: u64
        while index ownership.cleanups.length > do
            index ownership.cleanups.get_mut = event
            if event.name event.storage_name != then
                event.storage_name.clone = event.name
            fi
            1 += index
        done
        conditional_move = ownership.conditional_move
    fi
}

pub fn lower_operation_storage operation:mut$common::Op {
    operation lower_ownership_storage
    operation.value match
        common::OpValue::PushArray(items) => items lower_binding_storage
        common::OpValue::ExprGroup(items) => items lower_binding_storage
        common::OpValue::MatchArm(arm) => arm.guard_ops lower_binding_storage
        _ => {
        }
    end
    if operation.bindings std::Option::Some(facts) is then
        if facts needs_binding_lowering then
            facts operation.value lower_value_storage = replacement
            if replacement std::Option::Some(value) is then
                value = operation.value
            fi
        fi
    fi
}

fn lower_value_storage
    value:$common::OpValue
    facts:$std::List[common::BindingFact]
-> std::Option[common::OpValue] {
    value match
        common::OpValue::PushVar(name) => name.as_str facts resolve_fact_storage_name common::OpValue::PushVar
        common::OpValue::AssignVar(name) => name.as_str facts resolve_fact_storage_name common::OpValue::AssignVar
        common::OpValue::AssignInc(name) => name.as_str facts resolve_fact_storage_name common::OpValue::AssignInc
        common::OpValue::AssignDec(name) => name.as_str facts resolve_fact_storage_name common::OpValue::AssignDec
        common::OpValue::Question(name) => name.as_str facts resolve_fact_storage_name common::OpValue::Question
        common::OpValue::QuestionMove(name) => name.as_str facts resolve_fact_storage_name common::OpValue::QuestionMove
        common::OpValue::BindTemporary(binding) => {
            binding.depth binding.name.as_str facts resolve_fact_storage_name common::TemporaryBinding common::OpValue::BindTemporary
        }
        common::OpValue::IsCheck(variant) => {
            facts variant.clone common::PatternValue::EnumVariant lower_pattern_storage match
                common::PatternValue::EnumVariant(lowered_variant) => lowered_variant common::OpValue::IsCheck
                _ => std::Option[common::OpValue]::None return
            end
        }
        common::OpValue::MatchArm(arm) => {
            arm.clone = lowered_arm
            facts arm.pattern_value.clone lower_pattern_storage = lowered_arm.pattern_value
            lowered_arm common::OpValue::MatchArm
        }
        _ => std::Option[common::OpValue]::None return
    end std::Option::Some
}

fn collect_binding_variable
    binding:$common::CheckedBinding
    variables:mut$std::Map[std::String common::Variable]
    scoped_names:mut$std::Set[std::String]
{
    if binding.name binding.storage_name != then
        binding.name.clone scoped_names.add
    fi
    if binding.typ.is_unknown ! binding.storage_name variables.has ! && then
        binding.typ.clone binding.storage_name.clone common::Variable
        binding.storage_name.clone variables.set
    fi
}

pub fn collect_binding_variables
    facts:$std::List[common::BindingFact]
    variables:mut$std::Map[std::String common::Variable]
    scoped_names:mut$std::Set[std::String]
{
    for fact in facts.iter do
        if fact common::BindingFact::Definition(binding) is then
            scoped_names variables binding collect_binding_variable
        fi
    done
}

pub fn merge_storage_variables
    declarations:$std::List[common::Variable]
    variables:std::Map[std::String common::Variable]
    scoped_names:$std::Set[std::String]
-> std::List[common::Variable] {
    std::List[common::Variable]::new = result
    for declaration in declarations.iter do
        # Unreachable source declarations never acquire checked storage.
        if declaration.typ.is_unknown_placeholder declaration.name variables.has ! && then
            continue
        fi
        if declaration.name scoped_names.has declaration.name variables.has ! && then
            continue
        fi
        declaration.name variables.remove drop
        declaration.clone result.push
    done
    variables.values result.append
    result
}
