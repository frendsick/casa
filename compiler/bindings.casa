import "std" as std
import "common" as common

# Resolve storage from checked binding facts without changing source spelling.
pub fn resolve_fact_storage_name facts:$std::List[common::BindingFact] name:$str -> std::String {
    facts.length = index
    while 0 index != do
        1 -= index
        index facts.get = binding
        if name binding.get_name.as_str == then
            binding.get_storage_name.clone return
        fi
    done
    name.to_str
}

fn collect_binding_variable
    binding:$common::CheckedBinding
    variables:mut$std::Map[std::String common::Variable]
    scoped_names:mut$std::Set[std::String]
{
    if binding.name binding.storage_name swap != then
        binding.name.clone scoped_names.add
    fi
    if binding.typ.is_unknown ! binding.storage_name variables.has ! && then
        binding.typ.clone binding.storage_name.clone common::Variable
        binding.storage_name.clone variables.set
    fi
}

pub fn collect_binding_variables
    facts:$std::List[common::BindingFact]
    variables:mut$std::Map[std::String common::Variable]
    scoped_names:mut$std::Set[std::String]
{
    for fact in facts.iter do
        if fact common::BindingFact::Definition(binding) is then
            scoped_names variables binding collect_binding_variable
        fi
    done
}

pub fn merge_storage_variables
    declarations:$std::List[common::Variable]
    variables:std::Map[std::String common::Variable]
    scoped_names:$std::Set[std::String]
-> std::List[common::Variable] {
    std::List[common::Variable]::new = result
    for declaration in declarations.iter do
        # Unreachable source declarations never acquire checked storage.
        if declaration.typ.is_unknown_placeholder declaration.name variables.has ! && then
            continue
        fi
        if declaration.name scoped_names.has declaration.name variables.has ! && then
            continue
        fi
        declaration.name variables.remove drop
        declaration.clone result.push
    done
    variables.values result.append
    result
}
