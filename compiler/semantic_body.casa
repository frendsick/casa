impl Occurrence {
    pub fn from_operation operation:$common::Op -> Occurrence {
        operation.type_hint.clone = typ
        operation.value match
            common::OpValue::PushInt(_) => common::make_i64_type typ.unwrap_or std::Option::Some = typ
            common::OpValue::PushFloat(_) => common::make_f64_type typ.unwrap_or std::Option::Some = typ
            common::OpValue::PushStr(_) => common::make_str_type std::Option::Some = typ
            common::OpValue::PushBool(_) => common::make_bool_type std::Option::Some = typ
            common::OpValue::PushChar(_) => common::make_char_type std::Option::Some = typ
            _ => {
            }
        end
        operation.value match
            common::OpValue::AssignDec(value) => value.clone OccurrenceValue::AssignDec
            common::OpValue::AssignInc(value) => value.clone OccurrenceValue::AssignInc
            common::OpValue::AssignVar(value) => value.clone OccurrenceValue::AssignVar
            common::OpValue::FnCall(value) => value.clone OccurrenceValue::FnCall
            common::OpValue::FnPush(value) => value.clone OccurrenceValue::FnPush
            common::OpValue::PushCapture(value) => value.clone OccurrenceValue::PushCapture
            common::OpValue::PushVar(value) => value.clone OccurrenceValue::PushVar
            common::OpValue::PushEnumVariant(variant) => variant.variant_name.clone variant.enum_name.clone OccurrenceVariant OccurrenceValue::PushEnumVariant
            common::OpValue::StructNew(shape) => shape.is_extern shape.members.clone shape.location.clone shape.name.clone OccurrenceStruct OccurrenceValue::StructNew
            common::OpValue::PushInt(literal) => literal.raw.clone OccurrenceValue::PushInt
            common::OpValue::PushFloat(value) => value.clone OccurrenceValue::PushFloat
            common::OpValue::PushStr(value) => value.clone OccurrenceValue::PushStr
            common::OpValue::PushBool(value) => value copy OccurrenceValue::PushBool
            common::OpValue::PushChar(value) => value copy OccurrenceValue::PushChar
            common::OpValue::PtrAsRef(value) => value.clone OccurrenceValue::PtrAsRef
            common::OpValue::PtrAsMut(value) => value.clone OccurrenceValue::PtrAsMut
            common::OpValue::PtrFromRaw(value) => value.clone OccurrenceValue::PtrFromRaw
            common::OpValue::SizeOf(_) => OccurrenceValue::SizeOf
            common::OpValue::MethodCall(_) => OccurrenceValue::MethodCall
            common::OpValue::TraitMethodCall(_) => OccurrenceValue::TraitMethodCall
            common::OpValue::TraitMethodRef(_) => OccurrenceValue::TraitMethodRef
            common::OpValue::FnExec => OccurrenceValue::FnExec
            common::OpValue::FnExecOwned => OccurrenceValue::FnExecOwned
            common::OpValue::IfStart => OccurrenceValue::IfStart
            common::OpValue::IfCondition => OccurrenceValue::IfCondition
            common::OpValue::IfElif => OccurrenceValue::IfElif
            common::OpValue::IfElse => OccurrenceValue::IfElse
            common::OpValue::IfEnd => OccurrenceValue::IfEnd
            common::OpValue::WhileStart => OccurrenceValue::WhileStart
            common::OpValue::WhileCondition => OccurrenceValue::WhileCondition
            common::OpValue::WhileEnd => OccurrenceValue::WhileEnd
            common::OpValue::WhileBreak => OccurrenceValue::WhileBreak
            common::OpValue::WhileContinue => OccurrenceValue::WhileContinue
            common::OpValue::MatchStart => OccurrenceValue::MatchStart
            common::OpValue::MatchArm(_) => OccurrenceValue::MatchArm
            common::OpValue::MatchEnd => OccurrenceValue::MatchEnd
            common::OpValue::FnReturn => OccurrenceValue::FnReturn
            common::OpValue::Question(_) => OccurrenceValue::Question
            common::OpValue::UnsafeStart => OccurrenceValue::UnsafeStart
            common::OpValue::Add => OccurrenceValue::Add
            common::OpValue::Sub => OccurrenceValue::Sub
            common::OpValue::Mul => OccurrenceValue::Mul
            common::OpValue::Div => OccurrenceValue::Div
            common::OpValue::Mod => OccurrenceValue::Mod
            common::OpValue::Shl => OccurrenceValue::Shl
            common::OpValue::Shr => OccurrenceValue::Shr
            common::OpValue::BitAnd => OccurrenceValue::BitAnd
            common::OpValue::BitOr => OccurrenceValue::BitOr
            common::OpValue::BitXor => OccurrenceValue::BitXor
            common::OpValue::BitNot => OccurrenceValue::BitNot
            common::OpValue::And => OccurrenceValue::And
            common::OpValue::Or => OccurrenceValue::Or
            common::OpValue::Not => OccurrenceValue::Not
            common::OpValue::Eq => OccurrenceValue::Eq
            common::OpValue::Ne => OccurrenceValue::Ne
            common::OpValue::Lt => OccurrenceValue::Lt
            common::OpValue::Le => OccurrenceValue::Le
            common::OpValue::Gt => OccurrenceValue::Gt
            common::OpValue::Ge => OccurrenceValue::Ge
            common::OpValue::Drop => OccurrenceValue::Drop
            common::OpValue::Dup => OccurrenceValue::Dup
            common::OpValue::Copy => OccurrenceValue::Copy
            common::OpValue::Swap => OccurrenceValue::Swap
            common::OpValue::Over => OccurrenceValue::Over
            common::OpValue::Rot => OccurrenceValue::Rot
            common::OpValue::Print => OccurrenceValue::Print
            common::OpValue::PrintInt => OccurrenceValue::PrintInt
            common::OpValue::PrintStr => OccurrenceValue::PrintStr
            common::OpValue::PrintString => OccurrenceValue::PrintString
            common::OpValue::PrintBool => OccurrenceValue::PrintBool
            common::OpValue::PrintChar => OccurrenceValue::PrintChar
            common::OpValue::HeapAlloc => OccurrenceValue::HeapAlloc
            common::OpValue::HeapFree => OccurrenceValue::HeapFree
            common::OpValue::Load8 => OccurrenceValue::Load8
            common::OpValue::Load16 => OccurrenceValue::Load16
            common::OpValue::Load32 => OccurrenceValue::Load32
            common::OpValue::Load64 => OccurrenceValue::Load64
            common::OpValue::PtrFromRef => OccurrenceValue::PtrFromRef
            common::OpValue::PtrIntoRaw => OccurrenceValue::PtrIntoRaw
            common::OpValue::PtrNull => OccurrenceValue::PtrNull
            common::OpValue::PtrRead(target) => target.clone OccurrenceValue::PtrRead
            common::OpValue::Store8 => OccurrenceValue::Store8
            common::OpValue::Store16 => OccurrenceValue::Store16
            common::OpValue::Store32 => OccurrenceValue::Store32
            common::OpValue::Store64 => OccurrenceValue::Store64
            common::OpValue::PtrWrite(target) => target.clone OccurrenceValue::PtrWrite
            common::OpValue::Syscall0 => OccurrenceValue::Syscall0
            common::OpValue::Syscall1 => OccurrenceValue::Syscall1
            common::OpValue::Syscall2 => OccurrenceValue::Syscall2
            common::OpValue::Syscall3 => OccurrenceValue::Syscall3
            common::OpValue::Syscall4 => OccurrenceValue::Syscall4
            common::OpValue::Syscall5 => OccurrenceValue::Syscall5
            common::OpValue::Syscall6 => OccurrenceValue::Syscall6
            common::OpValue::Typeof => OccurrenceValue::Typeof
            common::OpValue::Argc => OccurrenceValue::Argc
            common::OpValue::Argv => OccurrenceValue::Argv
            _ => OccurrenceValue::Other
        end = value
        typ value operation.location.clone operation.id Occurrence
    }
}

fn collect_occurrences operations:$std::List[common::Op] -> std::List[Occurrence] {
    std::List[Occurrence]::new = facts
    operations facts append_occurrences
    facts
}

fn append_occurrences facts:mut$std::List[Occurrence] operations:$std::List[common::Op] {
    for operation in operations.iter do
        operation.value match
            common::OpValue::ExprGroup(items) => items facts append_occurrences
            common::OpValue::PushArray(items) => items facts append_occurrences
            common::OpValue::MatchArm(arm) => arm.guard_ops facts append_occurrences
            common::OpValue::Unreachable(items) => {
                items facts append_occurrences
                continue
            }
            _ => {
            }
        end
        operation Occurrence::from_operation facts.push
    done
}

impl Occurrence {
    pub fn has_rejected_target self:$Occurrence rejected:$std::Set[std::String] -> bool {
        self.value match
            OccurrenceValue::FnCall(name) => name rejected.has
            OccurrenceValue::FnPush(name) => name rejected.has
            _ => false
        end
    }
}

