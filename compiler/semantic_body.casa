}

pub struct OperationFacts derives std::Clone {
    pub identity: i64
    pub origin:   common::Location
    pub effects:  std::Option[common::OpOwnership]
    pub bindings: std::Option[std::List[common::BindingFact]]
}

pub struct Leaf derives std::Clone {
    pub facts:  OperationFacts
    pub action: Action
}

pub struct Body derives std::Clone {
    nodes: std::List[Node]
}

pub enum Node derives std::Clone {
    Unreachable (Unreachable)
    Leaf (Leaf)
    Conditional (Conditional)
    Loop (Loop)
    Match (Match)
    Region (Region)
    Array (ArrayLiteral)
    Group (Compound)
}

pub struct CallSite derives std::Clone {
    pub call:   Callable
    pub origin: common::Location
}

pub struct Unreachable derives std::Clone {
    pub calls:       std::List[CallSite]
    pub origin:      common::Location
    pub occurrences: std::List[Occurrence]
}

pub struct ArrayLiteral derives std::Clone {
    pub facts: OperationFacts
    pub body:  Body
    pub typ:   common::Type
}

pub struct Branch derives std::Clone {
    pub entry:      OperationFacts
    pub test:       OperationFacts
    pub condition:  Body
    pub consequent: Body
}

pub struct Alternative derives std::Clone {
    pub entry: OperationFacts
    pub body:  Body
}

pub struct Conditional derives std::Clone {
    pub branches:    std::List[Branch]
    pub alternative: std::Option[Alternative]
    pub exit:        OperationFacts
}

pub struct Loop derives std::Clone {
    pub entry:     OperationFacts
    pub test:      OperationFacts
    pub condition: Body
    pub body:      Body
    pub exit:      OperationFacts
}

pub struct Arm derives std::Clone {
    pub entry:        OperationFacts
    pub pattern:      common::PatternValue
    pub subject_type: common::Type
    pub guard:        Body
    pub body:         Body
}

pub struct Match derives std::Clone {
    pub entry:        OperationFacts
    pub subject_type: common::Type
    pub arms:         std::List[Arm]
    pub exit:         OperationFacts
}

pub struct Region derives std::Clone {
    pub entry: OperationFacts
    pub body:  Body
    pub exit:  OperationFacts
}

pub struct Compound derives std::Clone {
    pub facts: OperationFacts
    pub body:  Body
}

impl Unreachable {
    fn new operations:$std::List[common::Op] origin:common::Location -> Unreachable {
        std::List[CallSite]::new = calls
        calls operations collect_unreachable_calls
        operations collect_occurrences origin calls Unreachable
    }
}
# Declaration validation includes calls in dead source, even though emission omits them.
fn collect_unreachable_calls operations:$std::List[common::Op] calls:mut$std::List[CallSite] {
    for operation in operations.iter do
        operation.value match
            common::OpValue::FnCall(name) => {
                operation.location.clone operation.call_bindings.clone name.clone Callable CallSite calls.push
            }
            common::OpValue::FnPush(name) => {
                operation.location.clone operation.call_bindings.clone name.clone Callable CallSite calls.push
            }
            common::OpValue::Unreachable(items) => calls items collect_unreachable_calls
            common::OpValue::PushArray(items) => calls items collect_unreachable_calls
            common::OpValue::ExprGroup(items) => calls items collect_unreachable_calls
            common::OpValue::MatchArm(arm) => calls arm.guard_ops collect_unreachable_calls
            _ => {
            }
        end
    done
}

impl Body {
    pub fn collect_storage_variables
        self:$Body
        declarations:$std::List[common::Variable]
    -> std::List[common::Variable] {
        std::Map[std::String common::Variable]::new = variables
        std::Set[std::String]::new = scoped_names
        {
            = facts: $OperationFacts
            if facts.bindings std::Option::Some(definitions) is then
                scoped_names variables definitions bindings::collect_binding_variables
            fi
        } = visitor
        visitor self.visit_facts
        scoped_names variables declarations bindings::merge_storage_variables
    }

    pub fn visit_facts self:$Body visitor:$fn[$OperationFacts] {
        for node in self.nodes.iter do
            node match
                Node::Unreachable(_) => {
                }
                Node::Leaf(leaf) => leaf.facts visitor exec
                Node::Conditional(conditional) => {
                    for branch in conditional.branches.iter do
                        branch.entry visitor exec
                        visitor branch.condition.visit_facts
                        branch.test visitor exec
                        visitor branch.consequent.visit_facts
                    done
                    if conditional.alternative std::Option::Some(alternative) is then
                        alternative.entry visitor exec
                        visitor alternative.body.visit_facts
                    fi
                    conditional.exit visitor exec
                }
                Node::Loop(loop) => {
                    loop.entry visitor exec
                    visitor loop.condition.visit_facts
                    loop.test visitor exec
                    visitor loop.body.visit_facts
                    loop.exit visitor exec
                }
                Node::Match(match_body) => {
                    match_body.entry visitor exec
                    for arm in match_body.arms.iter do
                        arm.entry visitor exec
                        visitor arm.guard.visit_facts
                        visitor arm.body.visit_facts
                    done
                    match_body.exit visitor exec
                }
                Node::Region(region) => {
                    region.entry visitor exec
                    visitor region.body.visit_facts
                    region.exit visitor exec
                }
                Node::Array(compound) => {
                    compound.facts visitor exec
                    visitor compound.body.visit_facts
                }
                Node::Group(compound) => {
                    compound.facts visitor exec
                    visitor compound.body.visit_facts
                }
            end
        done
    }

    pub fn get_nodes self:$Body -> $std::List[Node] { self.nodes }

    pub fn get_nodes_mut self:mut$Body -> mut$std::List[Node] { self.nodes }

    # Selected callable identities remain available in symbolic recipes and concrete bodies.
    pub fn collect_callees self:$Body callees:mut$std::List[std::String] {
        for node in self.nodes.iter do
            node match
                Node::Unreachable(_) => {
                }
                Node::Leaf(leaf) => {
                    leaf.action match
                        Action::Call(call) => call.name.clone callees.push
                        Action::Closure(call) => call.name.clone callees.push
                        _ => {
                        }
                    end
                }
                Node::Conditional(conditional) => {
                    for branch in conditional.branches.iter do
                        callees branch.condition.collect_callees
                        callees branch.consequent.collect_callees
                    done
                    if conditional.alternative std::Option::Some(alternative) is then
                        callees alternative.body.collect_callees
                    fi
                }
                Node::Loop(loop) => {
                    callees loop.condition.collect_callees
                    callees loop.body.collect_callees
                }
                Node::Match(match_body) => {
                    for arm in match_body.arms.iter do
                        callees arm.guard.collect_callees
                        callees arm.body.collect_callees
                    done
                }
                Node::Region(region) => callees region.body.collect_callees
                Node::Array(compound) => callees compound.body.collect_callees
                Node::Group(compound) => callees compound.body.collect_callees
            end
        done
    }
}

impl common::Op {
    fn into_facts self:common::Op -> OperationFacts {
        self match
            common::Op { id: identity location: origin ownership: effects bindings: facts } => {
                OperationFacts {
                    identity: identity
                    origin: origin
                    effects: effects
                    bindings: facts
                }
            }
        end
    }
}

impl OperationFacts {
    fn resolve_storage_name self:$OperationFacts name:$str -> std::String {
        if self.bindings std::Option::Some(facts) is then
            name facts bindings::resolve_fact_storage_name return
        fi
        name.to_str
    }
}

fn require_type
    hint:std::Option[common::Type]
    origin:$common::Location
-> std::Result[common::Type std::String] {
    hint match
        std::Option::Some(typ) => typ std::Result::Ok
        std::Option::None => f"Checked operation has no established type at {origin.file}:{origin.span.offset}" std::Result::Error
    end
}

fn select_callable
    name:std::String
    substitutions:std::Map[std::String common::Type]
    store:$common::SymbolStore
-> std::Result[Callable std::String] {
    name.as_str store.get_function match
        std::Option::Some(function) => {
            Callable {
                name: name substitutions: substitutions
            }
            std::Result::Ok
        }
        std::Option::None => f"Checked callable `{name}` is missing" std::Result::Error
    end
}

fn select_action
    opcode:common::OpValue
    hint:std::Option[common::Type]
    substitutions:std::Map[std::String common::Type]
    facts:$OperationFacts
    store:$common::SymbolStore
-> std::Result[Action std::String] {
    opcode match
        common::OpValue::Drop => facts.origin hint require_type ? PrimitiveKind::Drop Action::Primitive
        common::OpValue::Dup => facts.origin hint require_type ? PrimitiveKind::Dup Action::Primitive
        common::OpValue::Copy => facts.origin hint require_type ? PrimitiveKind::Copy Action::Primitive
        common::OpValue::Over => facts.origin hint require_type ? PrimitiveKind::Over Action::Primitive
        common::OpValue::Add => facts.origin hint require_type ? PrimitiveKind::Add Action::Primitive
        common::OpValue::Sub => facts.origin hint require_type ? PrimitiveKind::Sub Action::Primitive
        common::OpValue::Mul => facts.origin hint require_type ? PrimitiveKind::Mul Action::Primitive
        common::OpValue::Div => facts.origin hint require_type ? PrimitiveKind::Div Action::Primitive
        common::OpValue::Mod => facts.origin hint require_type ? PrimitiveKind::Mod Action::Primitive
        common::OpValue::WrappingAdd => facts.origin hint require_type ? PrimitiveKind::WrappingAdd Action::Primitive
        common::OpValue::WrappingMul => facts.origin hint require_type ? PrimitiveKind::WrappingMul Action::Primitive
        common::OpValue::WrappingSub => facts.origin hint require_type ? PrimitiveKind::WrappingSub Action::Primitive
        common::OpValue::Shl => facts.origin hint require_type ? PrimitiveKind::Shl Action::Primitive
        common::OpValue::Shr => facts.origin hint require_type ? PrimitiveKind::Shr Action::Primitive
        common::OpValue::BitAnd => facts.origin hint require_type ? PrimitiveKind::BitAnd Action::Primitive
        common::OpValue::BitOr => facts.origin hint require_type ? PrimitiveKind::BitOr Action::Primitive
        common::OpValue::BitXor => facts.origin hint require_type ? PrimitiveKind::BitXor Action::Primitive
        common::OpValue::BitNot => facts.origin hint require_type ? PrimitiveKind::BitNot Action::Primitive
        common::OpValue::Eq => facts.origin hint require_type ? PrimitiveKind::Eq Action::Primitive
        common::OpValue::Ge => facts.origin hint require_type ? PrimitiveKind::Ge Action::Primitive
        common::OpValue::Gt => facts.origin hint require_type ? PrimitiveKind::Gt Action::Primitive
        common::OpValue::Le => facts.origin hint require_type ? PrimitiveKind::Le Action::Primitive
        common::OpValue::Lt => facts.origin hint require_type ? PrimitiveKind::Lt Action::Primitive
        common::OpValue::Ne => facts.origin hint require_type ? PrimitiveKind::Ne Action::Primitive
        common::OpValue::PrintInt => facts.origin hint require_type ? PrimitiveKind::PrintInt Action::Primitive
        common::OpValue::Typeof => facts.origin hint require_type ? PrimitiveKind::Typeof Action::Primitive
        common::OpValue::Rot => IntrinsicKind::Rot Action::Intrinsic
        common::OpValue::Swap => IntrinsicKind::Swap Action::Intrinsic
        common::OpValue::PrintBool => IntrinsicKind::PrintBool Action::Intrinsic
        common::OpValue::PrintChar => IntrinsicKind::PrintChar Action::Intrinsic
        common::OpValue::PrintCstr => IntrinsicKind::PrintCstr Action::Intrinsic
        common::OpValue::PrintStr => IntrinsicKind::PrintStr Action::Intrinsic
        common::OpValue::PrintString => IntrinsicKind::PrintString Action::Intrinsic
        common::OpValue::HeapAlloc => IntrinsicKind::HeapAlloc Action::Intrinsic
        common::OpValue::HeapFree => IntrinsicKind::HeapFree Action::Intrinsic
        common::OpValue::Load8 => IntrinsicKind::Load8 Action::Intrinsic
        common::OpValue::Load16 => IntrinsicKind::Load16 Action::Intrinsic
        common::OpValue::Load32 => IntrinsicKind::Load32 Action::Intrinsic
        common::OpValue::Load64 => IntrinsicKind::Load64 Action::Intrinsic
        common::OpValue::Store8 => IntrinsicKind::Store8 Action::Intrinsic
        common::OpValue::Store16 => IntrinsicKind::Store16 Action::Intrinsic
        common::OpValue::Store32 => IntrinsicKind::Store32 Action::Intrinsic
        common::OpValue::Store64 => IntrinsicKind::Store64 Action::Intrinsic
        common::OpValue::PtrFromRef => IntrinsicKind::PtrFromRef Action::Intrinsic
        common::OpValue::PtrIntoRaw => IntrinsicKind::PtrIntoRaw Action::Intrinsic
        common::OpValue::PtrNull => IntrinsicKind::PtrNull Action::Intrinsic
        common::OpValue::Syscall0 => IntrinsicKind::Syscall0 Action::Intrinsic
        common::OpValue::Syscall1 => IntrinsicKind::Syscall1 Action::Intrinsic
        common::OpValue::Syscall2 => IntrinsicKind::Syscall2 Action::Intrinsic
        common::OpValue::Syscall3 => IntrinsicKind::Syscall3 Action::Intrinsic
        common::OpValue::Syscall4 => IntrinsicKind::Syscall4 Action::Intrinsic
        common::OpValue::Syscall5 => IntrinsicKind::Syscall5 Action::Intrinsic
        common::OpValue::Syscall6 => IntrinsicKind::Syscall6 Action::Intrinsic
        common::OpValue::And => IntrinsicKind::And Action::Intrinsic
        common::OpValue::Or => IntrinsicKind::Or Action::Intrinsic
        common::OpValue::Not => IntrinsicKind::Not Action::Intrinsic
        common::OpValue::FnExec => IntrinsicKind::FnExec Action::Intrinsic
        common::OpValue::FnExecOwned => IntrinsicKind::FnExecOwned Action::Intrinsic
        common::OpValue::FnReturn => IntrinsicKind::FnReturn Action::Intrinsic
        common::OpValue::Panic => IntrinsicKind::Panic Action::Intrinsic
        common::OpValue::OwnerCleanup => IntrinsicKind::OwnerCleanup Action::Intrinsic
        common::OpValue::WhileBreak => IntrinsicKind::WhileBreak Action::Intrinsic
        common::OpValue::WhileContinue => IntrinsicKind::WhileContinue Action::Intrinsic
        common::OpValue::FloatFromDecimal => IntrinsicKind::FloatFromDecimal Action::Intrinsic
        common::OpValue::FloatSignificand => IntrinsicKind::FloatSignificand Action::Intrinsic
        common::OpValue::FstringToStr => IntrinsicKind::FstringToStr Action::Intrinsic
        common::OpValue::Argc => IntrinsicKind::Argc Action::Intrinsic
        common::OpValue::Argv => IntrinsicKind::Argv Action::Intrinsic
        common::OpValue::Envp => IntrinsicKind::Envp Action::Intrinsic
        common::OpValue::SizeOf(value) => value Action::SizeOf
        common::OpValue::PtrAsRef(value) => value Action::PtrAsRef
        common::OpValue::PtrAsMut(value) => value Action::PtrAsMut
        common::OpValue::PtrFromRaw(value) => value Action::PtrFromRaw
        common::OpValue::PtrRead(value) => value Action::PtrRead
        common::OpValue::PtrWrite(value) => value Action::PtrWrite
        common::OpValue::StructMemberProject(value) => facts.origin hint require_type ? value Action::StructMemberProject
        common::OpValue::StructMemberStore(value) => facts.origin hint require_type ? value Action::StructMemberStore
        common::OpValue::DestructionFn(value) => value Action::DestructionFn
        common::OpValue::NumericConvert(value) => value Action::NumericConvert
        common::OpValue::NumericTry(value) => value.target select_numeric_wrapper value Action::NumericTry
        common::OpValue::IntegerTry(value) => value.target select_numeric_wrapper value Action::IntegerTry
        common::OpValue::FloatRound(value) => value Action::FloatRound
        common::OpValue::FstringConcat(value) => value Action::FstringConcat
        common::OpValue::PrimitiveToStr(value) => value Action::PrimitiveToStr
        common::OpValue::PushBool(value) => value Action::Boolean
        common::OpValue::PushChar(value) => value Action::Character
        common::OpValue::PushStr(value) => value Action::String
        common::OpValue::PushInt(value) => facts.origin hint require_type ? value Action::Integer
        common::OpValue::PushFloat(value) => facts.origin hint require_type ? value Action::Float
        common::OpValue::FnCall(name) => store substitutions name select_callable ? Action::Call
        common::OpValue::FnPush(name) => store substitutions name select_callable ? Action::Closure
        common::OpValue::AssignDec(name) => {
            name.as_str facts.resolve_storage_name = storage_name
            facts.origin hint require_type ? storage_name name common::BindingReference BindingKind::AssignDec Action::Binding
        }
        common::OpValue::AssignInc(name) => {
            name.as_str facts.resolve_storage_name = storage_name
            facts.origin hint require_type ? storage_name name common::BindingReference BindingKind::AssignInc Action::Binding
        }
        common::OpValue::AssignVar(name) => {
            name.as_str facts.resolve_storage_name = storage_name
            facts.origin hint require_type ? storage_name name common::BindingReference BindingKind::AssignVar Action::Binding
        }
        common::OpValue::PushCapture(name) => {
            name.as_str facts.resolve_storage_name = storage_name
            facts.origin hint require_type ? storage_name name common::BindingReference BindingKind::PushCapture Action::Binding
        }
        common::OpValue::PushVar(name) => {
            name.as_str facts.resolve_storage_name = storage_name
            facts.origin hint require_type ? storage_name name common::BindingReference BindingKind::PushVar Action::Binding
        }
        common::OpValue::Question(name) => {
            name.as_str facts.resolve_storage_name = storage_name
            facts.origin hint require_type ? storage_name name common::BindingReference BindingKind::Question Action::Binding
        }
        common::OpValue::QuestionMove(name) => {
            name.as_str facts.resolve_storage_name = storage_name
            storage_name name common::BindingReference Action::OwnerMoved
        }
        common::OpValue::BindTemporary(binding) => {
            binding.name.as_str facts.resolve_storage_name = storage_name
            binding.depth storage_name binding.name.clone common::BindingReference Action::Temporary
        }
        common::OpValue::PushEnumVariant(variant) => facts.origin hint require_type ? variant Action::Enum
        common::OpValue::IsCheck(variant) => facts.origin hint require_type ? variant Action::PatternTest
        common::OpValue::StructNew(shape) => facts.origin hint require_type ? shape Action::Struct
        common::OpValue::StructLiteral(shape) => facts.origin hint require_type ? shape Action::StructFields
        common::OpValue::TraitMethodCall(call) => substitutions call ConstrainedCallable Action::ConstrainedCall
        common::OpValue::TraitMethodRef(call) => substitutions call ConstrainedCallable Action::ConstrainedClosure
        _ => "Unresolved source action in checked body".to_str std::Result::Error return
    end
    std::Result::Ok
}

struct BodyCursor {
    operations: mut$std::List[common::Op]
    store:      $common::SymbolStore
}

fn ends_sequence value:$common::OpValue -> bool {
    value common::OpValue::IfCondition is
    value common::OpValue::IfElif is ||
    value common::OpValue::IfElse is ||
    value common::OpValue::IfEnd is ||
    value common::OpValue::WhileCondition is ||
    value common::OpValue::WhileEnd is ||
    value common::OpValue::MatchArm is ||
    value common::OpValue::MatchEnd is ||
    value common::OpValue::UnsafeEnd is ||
}

impl BodyCursor {
    fn read_sequence self:mut$BodyCursor -> std::Result[Body std::String] {
        std::List[Node]::new = nodes
        while self.operations.is_empty ! do
            self.operations.length 1 - self.operations.get = next
            if next.value ends_sequence then
                break
            fi
            self.operations.pop self.read_node ? nodes.push
        done
        nodes Body std::Result::Ok
    }

    fn read_boundary self:mut$BodyCursor -> std::Result[common::Op std::String] {
        if self.operations.is_empty then
            "Incomplete checked body".to_str std::Result::Error return
        fi
        self.operations.pop std::Result::Ok
    }

    fn read_branch self:mut$BodyCursor entry:OperationFacts -> std::Result[Branch std::String] {
        self.read_sequence ? = condition
        self.read_boundary ? = boundary
        if boundary.value common::OpValue::IfCondition is ! then
            "Missing checked branch condition".to_str std::Result::Error return
        fi
        self.read_sequence ? = consequent
        Branch { entry: entry test: boundary.into_facts condition: condition consequent: consequent }
        std::Result::Ok
    }

    fn read_conditional self:mut$BodyCursor entry:OperationFacts -> std::Result[Node std::String] {
        entry self.read_branch ? = branch
        [branch] std::List::from_array = branches
        std::Option[Alternative]::None = alternative
        while true do
            self.read_boundary ? = boundary
            if boundary.value common::OpValue::IfElif is then
                boundary.into_facts self.read_branch ? branches.push
                continue
            fi
            if boundary.value common::OpValue::IfElse is then
                self.read_sequence ? = alternative_body
                Alternative { entry: boundary.into_facts body: alternative_body }
                std::Option::Some = alternative
                self.read_boundary ? = boundary
            fi
            if boundary.value common::OpValue::IfEnd is ! then
                "Missing checked branch exit".to_str std::Result::Error return
            fi
            Conditional { branches: branches alternative: alternative exit: boundary.into_facts }
            Node::Conditional std::Result::Ok return
        done
        "Incomplete checked conditional".to_str std::Result::Error
    }

    fn read_loop self:mut$BodyCursor entry:OperationFacts -> std::Result[Node std::String] {
        self.read_sequence ? = condition
        self.read_boundary ? = boundary
        if boundary.value common::OpValue::WhileCondition is ! then
            "Missing checked loop condition".to_str std::Result::Error return
        fi
        boundary.into_facts = test
        self.read_sequence ? = body
        self.read_boundary ? = boundary
        if boundary.value common::OpValue::WhileEnd is ! then
            "Missing checked loop exit".to_str std::Result::Error return
        fi
        Loop { entry: entry test: test condition: condition body: body exit: boundary.into_facts }
        Node::Loop std::Result::Ok
    }

    fn read_match
        self:mut$BodyCursor
        entry:OperationFacts
        subject_type:common::Type
    -> std::Result[Node std::String] {
        std::List[Arm]::new = arms
        while true do
            self.read_boundary ? = boundary
            if boundary.value common::OpValue::MatchEnd is then
                Match { entry: entry subject_type: subject_type arms: arms exit: boundary.into_facts }
                Node::Match std::Result::Ok return
            fi
            boundary self.read_arm ? arms.push
        done
        "Incomplete checked match".to_str std::Result::Error
    }

    fn read_arm self:mut$BodyCursor operation:common::Op -> std::Result[Arm std::String] {
        operation match
            common::Op { id: identity location: origin ownership: effects bindings: facts type_hint: hint value: value } => {
                OperationFacts {
                    identity: identity origin: origin effects: effects bindings: facts
                } = entry
                value match
                    common::OpValue::MatchArm(arm) => {
                        arm match
                            common::MatchArm {
                                pattern_value: pattern guard_ops: operations
                            } => {
                                entry.origin hint require_type ? = subject_type
                                self.store operations consume_body ? = guard
                                self.read_sequence ? = arm_body
                                Arm {
                                    entry: entry pattern: pattern subject_type: subject_type guard: guard body: arm_body
                                }
                                std::Result::Ok
                            }
                        end
                    }
                    _ => "Missing checked match arm".to_str std::Result::Error
                end
            }
        end
    }

    fn read_region self:mut$BodyCursor entry:OperationFacts -> std::Result[Node std::String] {
        self.read_sequence ? = body
        self.read_boundary ? = boundary
        if boundary.value common::OpValue::UnsafeEnd is ! then
            "Missing checked region exit".to_str std::Result::Error return
        fi
        Region { entry: entry body: body exit: boundary.into_facts } Node::Region std::Result::Ok
    }

    fn read_node self:mut$BodyCursor operation:common::Op -> std::Result[Node std::String] {
        operation match
            common::Op { id: identity location: origin ownership: effects bindings: source_facts type_hint: hint value: value call_bindings: substitutions } => {
                OperationFacts {
                    identity: identity origin: origin effects: effects bindings: source_facts
                } = facts
                # Borrow the tag so the fallback retains its owned leaf payload.
                value = tag: $common::OpValue
                tag match
                    common::OpValue::Unreachable(_) => {
                        if value common::OpValue::Unreachable(items) is then
                            facts.origin.clone items Unreachable::new Node::Unreachable std::Result::Ok return
                        fi
                    }
                    common::OpValue::IfStart => facts self.read_conditional return
                    common::OpValue::WhileStart => facts self.read_loop return
                    common::OpValue::MatchStart => facts.origin hint require_type ? facts self.read_match return
                    common::OpValue::UnsafeStart => facts self.read_region return
                    common::OpValue::PushArray(_) => {
                        if value common::OpValue::PushArray(items) is then
                            facts.origin hint require_type ? = array_type
                            self.store items consume_body ? = body
                            array_type body facts ArrayLiteral Node::Array std::Result::Ok return
                        fi
                    }
                    common::OpValue::ExprGroup(_) => {
                        if value common::OpValue::ExprGroup(items) is then
                            self.store items consume_body ? = body
                            body facts Compound Node::Group std::Result::Ok return
                        fi
                    }
                    _ => {
                    }
                end
                self.store facts substitutions hint value select_action ? = action
                action facts Leaf Node::Leaf std::Result::Ok
            }
        end
    }
}
# This builder is internal to semantic construction. It accepts symbolic recipe terms.
pub fn consume_operations
    operations:mut$std::List[common::Op]
    store:$common::SymbolStore
-> std::Result[Body std::String] {
    operations.reverse
    store operations BodyCursor = cursor
    cursor.read_sequence ? = body
    if cursor.operations.is_empty ! then
        "Unexpected checked body boundary".to_str std::Result::Error return
    fi
    body std::Result::Ok
}

pub fn consume_body
    operations:std::List[common::Op]
    store:$common::SymbolStore
-> std::Result[Body std::String] {
    store operations consume_operations
}

impl OperationFacts {
    pub fn lower
        self:$OperationFacts
        value:common::OpValue
        hint:std::Option[common::Type]
    -> common::Op {
        common::Op { id: self.identity location: self.origin.clone type_hint: hint deferred_return_hint: std::Option[common::Type]::None call_bindings: std::Map[std::String common::Type]::new value: value ownership: self.effects.clone bindings: self.bindings.clone }
    }
}

impl PrimitiveKind {
    fn lower self:$PrimitiveKind -> common::OpValue {
        self match
            PrimitiveKind::Drop => common::OpValue::Drop
            PrimitiveKind::Dup => common::OpValue::Dup
            PrimitiveKind::Copy => common::OpValue::Copy
            PrimitiveKind::Over => common::OpValue::Over
            PrimitiveKind::Add => common::OpValue::Add
            PrimitiveKind::Sub => common::OpValue::Sub
            PrimitiveKind::Mul => common::OpValue::Mul
            PrimitiveKind::Div => common::OpValue::Div
            PrimitiveKind::Mod => common::OpValue::Mod
            PrimitiveKind::WrappingAdd => common::OpValue::WrappingAdd
            PrimitiveKind::WrappingMul => common::OpValue::WrappingMul
            PrimitiveKind::WrappingSub => common::OpValue::WrappingSub
            PrimitiveKind::Shl => common::OpValue::Shl
            PrimitiveKind::Shr => common::OpValue::Shr
            PrimitiveKind::BitAnd => common::OpValue::BitAnd
            PrimitiveKind::BitOr => common::OpValue::BitOr
            PrimitiveKind::BitXor => common::OpValue::BitXor
            PrimitiveKind::BitNot => common::OpValue::BitNot
            PrimitiveKind::Eq => common::OpValue::Eq
            PrimitiveKind::Ge => common::OpValue::Ge
            PrimitiveKind::Gt => common::OpValue::Gt
            PrimitiveKind::Le => common::OpValue::Le
            PrimitiveKind::Lt => common::OpValue::Lt
            PrimitiveKind::Ne => common::OpValue::Ne
            PrimitiveKind::PrintInt => common::OpValue::PrintInt
            PrimitiveKind::Typeof => common::OpValue::Typeof
        end
    }
}

impl IntrinsicKind {
    fn lower self:$IntrinsicKind -> common::OpValue {
        self match
            IntrinsicKind::Rot => common::OpValue::Rot
            IntrinsicKind::Swap => common::OpValue::Swap
            IntrinsicKind::PrintBool => common::OpValue::PrintBool
            IntrinsicKind::PrintChar => common::OpValue::PrintChar
            IntrinsicKind::PrintCstr => common::OpValue::PrintCstr
            IntrinsicKind::PrintStr => common::OpValue::PrintStr
            IntrinsicKind::PrintString => common::OpValue::PrintString
            IntrinsicKind::HeapAlloc => common::OpValue::HeapAlloc
            IntrinsicKind::HeapFree => common::OpValue::HeapFree
            IntrinsicKind::Load8 => common::OpValue::Load8
            IntrinsicKind::Load16 => common::OpValue::Load16
            IntrinsicKind::Load32 => common::OpValue::Load32
            IntrinsicKind::Load64 => common::OpValue::Load64
            IntrinsicKind::Store8 => common::OpValue::Store8
            IntrinsicKind::Store16 => common::OpValue::Store16
            IntrinsicKind::Store32 => common::OpValue::Store32
            IntrinsicKind::Store64 => common::OpValue::Store64
            IntrinsicKind::PtrFromRef => common::OpValue::PtrFromRef
            IntrinsicKind::PtrIntoRaw => common::OpValue::PtrIntoRaw
            IntrinsicKind::PtrNull => common::OpValue::PtrNull
            IntrinsicKind::Syscall0 => common::OpValue::Syscall0
            IntrinsicKind::Syscall1 => common::OpValue::Syscall1
            IntrinsicKind::Syscall2 => common::OpValue::Syscall2
            IntrinsicKind::Syscall3 => common::OpValue::Syscall3
            IntrinsicKind::Syscall4 => common::OpValue::Syscall4
            IntrinsicKind::Syscall5 => common::OpValue::Syscall5
            IntrinsicKind::Syscall6 => common::OpValue::Syscall6
            IntrinsicKind::And => common::OpValue::And
            IntrinsicKind::Or => common::OpValue::Or
            IntrinsicKind::Not => common::OpValue::Not
            IntrinsicKind::FnExec => common::OpValue::FnExec
            IntrinsicKind::FnExecOwned => common::OpValue::FnExecOwned
            IntrinsicKind::FnReturn => common::OpValue::FnReturn
            IntrinsicKind::Panic => common::OpValue::Panic
            IntrinsicKind::OwnerCleanup => common::OpValue::OwnerCleanup
            IntrinsicKind::WhileBreak => common::OpValue::WhileBreak
            IntrinsicKind::WhileContinue => common::OpValue::WhileContinue
            IntrinsicKind::FloatFromDecimal => common::OpValue::FloatFromDecimal
            IntrinsicKind::FloatSignificand => common::OpValue::FloatSignificand
            IntrinsicKind::FstringToStr => common::OpValue::FstringToStr
            IntrinsicKind::Argc => common::OpValue::Argc
            IntrinsicKind::Argv => common::OpValue::Argv
            IntrinsicKind::Envp => common::OpValue::Envp
        end
    }
}

impl BindingKind {
    fn lower self:$BindingKind name:std::String -> common::OpValue {
        self match
            BindingKind::AssignDec => name common::OpValue::AssignDec
            BindingKind::AssignInc => name common::OpValue::AssignInc
            BindingKind::AssignVar => name common::OpValue::AssignVar
            BindingKind::PushCapture => name common::OpValue::PushCapture
            BindingKind::PushVar => name common::OpValue::PushVar
            BindingKind::Question => name common::OpValue::Question
        end
    }
}

impl Leaf {
    pub fn lower self:$Leaf -> common::Op {
        std::Option[common::Type]::None = hint
        self.action match
            Action::Primitive(kind typ) => {
                typ.clone std::Option::Some = hint kind.lower
            }
            Action::Intrinsic(kind) => kind.lower
            Action::Integer(value typ) => {
                typ.clone std::Option::Some = hint value.clone common::OpValue::PushInt
            }
            Action::Float(value typ) => {
                typ.clone std::Option::Some = hint value.clone common::OpValue::PushFloat
            }
            Action::Boolean(value) => value copy common::OpValue::PushBool
            Action::Character(value) => value copy common::OpValue::PushChar
            Action::String(value) => value.clone common::OpValue::PushStr
            Action::Call(call) => call.name.clone common::OpValue::FnCall
            Action::Closure(call) => call.name.clone common::OpValue::FnPush
            Action::Binding(kind binding typ) => {
                typ.clone std::Option::Some = hint binding.name.clone kind.lower
            }
            Action::OwnerMoved(binding) => binding.name.clone common::OpValue::QuestionMove
            Action::Temporary(binding depth) => depth binding.name.clone common::TemporaryBinding common::OpValue::BindTemporary
            Action::Enum(variant typ) => {
                typ.clone std::Option::Some = hint variant.clone common::OpValue::PushEnumVariant
            }
            Action::PatternTest(variant typ) => {
                typ.clone std::Option::Some = hint variant.clone common::OpValue::IsCheck
            }
            Action::Struct(shape typ) => {
                typ.clone std::Option::Some = hint shape.clone common::OpValue::StructNew
            }
            Action::StructFields(shape typ) => {
                typ.clone std::Option::Some = hint shape.clone common::OpValue::StructLiteral
            }
            Action::ConstrainedCall(call) => call.dispatch.clone common::OpValue::TraitMethodCall
            Action::ConstrainedClosure(call) => call.dispatch.clone common::OpValue::TraitMethodRef
            Action::SizeOf(value) => value.clone common::OpValue::SizeOf
            Action::PtrAsRef(value) => value.clone common::OpValue::PtrAsRef
            Action::PtrAsMut(value) => value.clone common::OpValue::PtrAsMut
            Action::PtrFromRaw(value) => value.clone common::OpValue::PtrFromRaw
            Action::PtrRead(value) => value.clone common::OpValue::PtrRead
            Action::PtrWrite(value) => value.clone common::OpValue::PtrWrite
            Action::StructMemberProject(value typ) => {
                typ.clone std::Option::Some = hint value.clone common::OpValue::StructMemberProject
            }
            Action::StructMemberStore(value typ) => {
                typ.clone std::Option::Some = hint value.clone common::OpValue::StructMemberStore
            }
            Action::DestructionFn(value) => value.clone common::OpValue::DestructionFn
            Action::NumericConvert(value) => value.clone common::OpValue::NumericConvert
            Action::NumericTry(value _) => value.clone common::OpValue::NumericTry
            Action::IntegerTry(value _) => value.clone common::OpValue::IntegerTry
            Action::FloatRound(value) => value.clone common::OpValue::FloatRound
            Action::FstringConcat(value) => value copy common::OpValue::FstringConcat
            Action::PrimitiveToStr(value) => value copy common::OpValue::PrimitiveToStr
        end = value
        hint value self.facts.lower = operation
        self.action match
            Action::Call(call) => call.substitutions.clone = operation.call_bindings
            Action::Closure(call) => call.substitutions.clone = operation.call_bindings
            Action::ConstrainedCall(call) => call.substitutions.clone = operation.call_bindings
            Action::ConstrainedClosure(call) => call.substitutions.clone = operation.call_bindings
            _ => {
            }
        end
        operation
    }
}

impl Body {
    fn lower_into self:$Body output:mut$std::List[common::Op] {
        for node in self.nodes.iter do
            output node.lower_into
        done
    }

    pub fn lower_operations self:$Body -> std::List[common::Op] {
        std::List[common::Op]::new = output
        output self.lower_into
        output
    }
}

impl Node {
    fn lower_into self:$Node output:mut$std::List[common::Op] {
        std::Option[common::Type]::None = no_type
        self match
            Node::Unreachable(_) => {
            }
            Node::Leaf(leaf) => leaf.lower output.push
            Node::Conditional(conditional) => {
                true = first
                for branch in conditional.branches.iter do
                    if first then common::OpValue::IfStart else common::OpValue::IfElif fi = kind
                    no_type.clone kind branch.entry.lower output.push
                    output branch.condition.lower_into
                    no_type.clone common::OpValue::IfCondition branch.test.lower output.push
                    output branch.consequent.lower_into
                    false = first
                done
                if conditional.alternative std::Option::Some(alternative) is then
                    no_type.clone common::OpValue::IfElse alternative.entry.lower output.push
                    output alternative.body.lower_into
                fi
                no_type.clone common::OpValue::IfEnd conditional.exit.lower output.push
            }
            Node::Loop(loop) => {
                no_type.clone common::OpValue::WhileStart loop.entry.lower output.push
                output loop.condition.lower_into
                no_type.clone common::OpValue::WhileCondition loop.test.lower output.push
                output loop.body.lower_into
                no_type.clone common::OpValue::WhileEnd loop.exit.lower output.push
            }
            Node::Match(match_body) => {
                match_body.subject_type.clone std::Option::Some common::OpValue::MatchStart match_body.entry.lower output.push
                for arm in match_body.arms.iter do
                    arm.guard.lower_operations arm.pattern.clone common::MatchArm::new common::OpValue::MatchArm = value
                    arm.subject_type.clone std::Option::Some value arm.entry.lower output.push
                    output arm.body.lower_into
                done
                no_type.clone common::OpValue::MatchEnd match_body.exit.lower output.push
            }
            Node::Region(region) => {
                no_type.clone common::OpValue::UnsafeStart region.entry.lower output.push
                output region.body.lower_into
                no_type.clone common::OpValue::UnsafeEnd region.exit.lower output.push
            }
            Node::Array(compound) => {
                compound.typ.clone std::Option::Some compound.body.lower_operations common::OpValue::PushArray compound.facts.lower output.push
            }
            Node::Group(compound) => {
                no_type.clone compound.body.lower_operations common::OpValue::ExprGroup compound.facts.lower output.push
            }
        end
    }
}

impl Body {
    # Project source occurrences without materializing another executable body.
    pub fn visit_occurrences self:$Body visitor:$fn[$Occurrence] {
        for node in self.nodes.iter do
            visitor node.visit_occurrences
        done
    }
}

impl Node {
    fn visit_occurrences self:$Node visitor:$fn[$Occurrence] {
        std::Option[common::Type]::None = no_type
        self match
            Node::Unreachable(source) => {
                for occurrence in source.occurrences.iter do
                    occurrence visitor exec
                done
            }
            Node::Leaf(leaf) => leaf.lower Occurrence::from_operation visitor exec
            Node::Conditional(conditional) => {
                true = first
                for branch in conditional.branches.iter do
                    if first then common::OpValue::IfStart else common::OpValue::IfElif fi = kind
                    no_type.clone kind branch.entry.lower Occurrence::from_operation visitor exec
                    visitor branch.condition.visit_occurrences
                    no_type.clone common::OpValue::IfCondition branch.test.lower Occurrence::from_operation visitor exec
                    visitor branch.consequent.visit_occurrences
                    false = first
                done
                if conditional.alternative std::Option::Some(alternative) is then
                    no_type.clone common::OpValue::IfElse alternative.entry.lower Occurrence::from_operation visitor exec
                    visitor alternative.body.visit_occurrences
                fi
                no_type.clone common::OpValue::IfEnd conditional.exit.lower Occurrence::from_operation visitor exec
            }
            Node::Loop(loop) => {
                no_type.clone common::OpValue::WhileStart loop.entry.lower Occurrence::from_operation visitor exec
                visitor loop.condition.visit_occurrences
                no_type.clone common::OpValue::WhileCondition loop.test.lower Occurrence::from_operation visitor exec
                visitor loop.body.visit_occurrences
                no_type.clone common::OpValue::WhileEnd loop.exit.lower Occurrence::from_operation visitor exec
            }
            Node::Match(match_body) => {
                match_body.subject_type.clone std::Option::Some common::OpValue::MatchStart match_body.entry.lower Occurrence::from_operation visitor exec
                for arm in match_body.arms.iter do
                    std::List[common::Op]::new arm.pattern.clone common::MatchArm::new common::OpValue::MatchArm = value
                    arm.subject_type.clone std::Option::Some value arm.entry.lower Occurrence::from_operation visitor exec
                    visitor arm.guard.visit_occurrences
                    visitor arm.body.visit_occurrences
                done
                no_type.clone common::OpValue::MatchEnd match_body.exit.lower Occurrence::from_operation visitor exec
            }
            Node::Region(region) => {
                no_type.clone common::OpValue::UnsafeStart region.entry.lower Occurrence::from_operation visitor exec
                visitor region.body.visit_occurrences
                no_type.clone common::OpValue::UnsafeEnd region.exit.lower Occurrence::from_operation visitor exec
            }
            Node::Array(compound) => {
                visitor compound.body.visit_occurrences
            }
            Node::Group(compound) => {
                visitor compound.body.visit_occurrences
            }
        end
    }
}

pub fn validate_type typ:$common::Type -> std::Result[bool std::String] {
    if
        typ.has_unresolved_type_var typ.is_unknown_placeholder || typ.is_integer_literal_t || typ.is_float_literal_t ||
    then
        typ.format = type_name
        f"Unfinished semantic type `{type_name}`" std::Result::Error return
    fi
    typ match
        common::Type::Generic(generic) => {
            if generic.base.as_str common::TYPE_MISSING == then
                "Missing semantic type".to_str std::Result::Error return
            fi
            for parameter in generic.params.iter do
                parameter validate_type ? drop
            done
        }
        common::Type::Function(function) => {
            for parameter in function.parameters.iter do
                parameter validate_type ? drop
            done
            for result in function.return_types.iter do
                result validate_type ? drop
            done
        }
        _ => {
        }
    end
    true std::Result::Ok
}

pub fn validate_effect effect:$common::StackEffect -> std::Result[bool std::String] {
    if effect.type_vars.is_empty ! effect.const_params.length 0 != || then
        "Unfinished callable stack effect".to_str std::Result::Error return
    fi
    for parameter in effect.parameters.iter do
        parameter.typ validate_type ? drop
    done
    for result in effect.return_types.iter do
        result validate_type ? drop
    done
    true std::Result::Ok
}

impl common::CasaStruct {
    fn has_checked_field self:$common::CasaStruct name:$str -> bool {
        for member in self.members.iter do
            if name member.name.as_str == then
                true return
            fi
        done
        false
    }
}

impl common::CheckedBinding {
    fn validate self:$common::CheckedBinding -> std::Result[bool std::String] {
        self.typ validate_type match
            std::Result::Ok(_) => true std::Result::Ok
            std::Result::Error(message) => f"{message} for binding `{self.name}`" std::Result::Error
        end
    }
}
# The backend gate supplies the final storage declarations for one concrete body.
pub struct BodyReferences {
    store:    $common::SymbolStore
    locals:   $std::List[common::Variable]
    captures: $std::List[common::Variable]
}

impl BodyReferences {
    pub fn new
        store:$common::SymbolStore
        locals:$std::List[common::Variable]
        captures:$std::List[common::Variable]
    -> BodyReferences {
        captures locals store BodyReferences
    }

    fn require_storage self:$BodyReferences name:$str -> std::Result[bool std::String] {
        if
            name self.locals common::variable_list_contains
            name self.captures common::variable_list_contains ||
        then
            true std::Result::Ok return
        fi
        f"Missing checked storage `{name}`" std::Result::Error
    }

    fn require_capture self:$BodyReferences name:$str -> std::Result[bool std::String] {
        if name self.captures common::variable_list_contains then
            true std::Result::Ok return
        fi
        f"Missing checked capture `{name}`" std::Result::Error
    }

    fn require_closure
        self:$BodyReferences
        call:$Callable
        facts:$OperationFacts
    -> std::Result[bool std::String] {
        call.name.as_str self.store.get_function match
            std::Option::Some(function) => {
                for capture in function.captures.iter do
                    capture.name.as_str facts.resolve_storage_name = storage
                    storage.as_str self.require_storage ? drop
                done
                true std::Result::Ok
            }
            std::Option::None => f"Missing checked closure `{call.name}`" std::Result::Error
        end
    }

    fn require_struct
        self:$BodyReferences
        name:$str
    -> std::Result[$common::CasaStruct std::String] {
        name self
            .store
            .structs
            .get_str match
            std::Option::Some(declaration) => declaration std::Result[$common::CasaStruct std::String]::Ok
            std::Option::None => f"Missing checked struct `{name}`" std::Result::Error
        end
    }

    fn require_member
        self:$BodyReferences
        access:$common::StructMemberAccess
    -> std::Result[bool std::String] {
        access.struct_name.as_str self.require_struct ? = declaration
        if access.member_index declaration.members.length > then
            true std::Result::Ok return
        fi
        f"Invalid checked field index for `{access.struct_name}`" std::Result::Error
    }

    fn require_variant
        self:$BodyReferences
        variant:$common::EnumVariant
    -> std::Result[bool std::String] {
        variant.enum_name.as_str self
            .store
            .enums
            .get_str match
            std::Option::Some(declaration) => declaration
            std::Option::None => f"Missing checked variant `{variant.enum_name}::{variant.variant_name}`" std::Result::Error return
        end = declaration
        variant.ordinal match
            std::Option::Some(ordinal) => ordinal copy
            std::Option::None => f"Missing checked ordinal for `{variant.enum_name}::{variant.variant_name}`" std::Result::Error return
        end = ordinal
        0 = index: i64
        for name in declaration.variants.iter do
            if name variant.variant_name == then
                if ordinal index == then
                    true std::Result::Ok return
                fi
                f"Invalid checked ordinal for `{variant.enum_name}::{variant.variant_name}`" std::Result::Error return
            fi
            1 += index
        done
        f"Missing checked variant `{variant.enum_name}::{variant.variant_name}`" std::Result::Error
    }

    fn require_pattern
        self:$BodyReferences
        pattern:$common::PatternValue
    -> std::Result[bool std::String] {
        pattern match
            common::PatternValue::EnumVariant(variant) => {
                if variant.variant_name.as_str common::MATCH_WILDCARD != then
                    variant self.require_variant ? drop
                fi
            }
            common::PatternValue::Struct(struct_pattern) => {
                struct_pattern.struct_name.as_str self.require_struct ? = declaration
                for
                    field in struct_pattern
                        .bindings
                        .keys
                        .iter
                do
                    if field.as_str declaration.has_checked_field ! then
                        f"Missing checked pattern field `{struct_pattern.struct_name}.{field}`" std::Result::Error return
                    fi
                done
            }
            common::PatternValue::Literal(_) => {
            }
        end
        true std::Result::Ok
    }
}

impl OperationFacts {
    fn validate
        self:$OperationFacts
        drops:mut$std::List[common::Type]
        references:$BodyReferences
    -> std::Result[bool std::String] {
        if self.effects std::Option::Some(effects) is then
            if effects.conditional_move std::Option::Some(name) is then
                name.as_str self.resolve_storage_name.as_str references.require_storage ? drop
            fi
            for event in effects.assignments.iter do
                event.storage_name.as_str references.require_storage ? drop
                event.typ validate_type ? drop
                event.typ.clone drops.push
            done
            for event in effects.cleanups.iter do
                event.storage_name.as_str references.require_storage ? drop
                event.typ validate_type ? drop
                event.typ.clone drops.push
            done
        fi
        if self.bindings std::Option::Some(facts) is then
            for fact in facts.iter do
                fact.get_storage_name.as_str references.require_storage ? drop
                if fact common::BindingFact::Definition(binding) is then
                    binding.validate ? drop
                fi
            done
        fi
        true std::Result::Ok
    }
}

impl Leaf {
    fn validate
        self:$Leaf
        callees:mut$std::List[std::String]
        drops:mut$std::List[common::Type]
        references:$BodyReferences
    -> std::Result[bool std::String] {
        references drops self.facts.validate ? drop
        self.action match
            Action::Primitive(kind typ) => {
                typ validate_type ? drop
                if kind PrimitiveKind::Drop == then
                    typ.clone drops.push
                fi
            }
            Action::Integer(_ typ) => typ validate_type ? drop
            Action::Float(_ typ) => typ validate_type ? drop
            Action::Binding(kind binding typ) => {
                typ validate_type ? drop
                if kind BindingKind::PushCapture == then
                    binding.storage_name.as_str references.require_capture ? drop
                else
                    binding.storage_name.as_str references.require_storage ? drop
                fi
            }
            Action::OwnerMoved(binding) => binding.storage_name.as_str references.require_storage ? drop
            Action::Temporary(binding _) => binding.storage_name.as_str references.require_storage ? drop
            Action::Enum(variant typ) => {
                typ validate_type ? drop variant references.require_variant ? drop
            }
            Action::PatternTest(variant typ) => {
                typ validate_type ? drop variant references.require_variant ? drop
            }
            Action::Struct(declaration typ) => {
                typ validate_type ? drop declaration.name.as_str references.require_struct ? drop
            }
            Action::StructFields(literal typ) => {
                typ validate_type ? drop
                literal.struct_name.as_str references.require_struct ? = declaration
                if literal.field_order.length declaration.members.length != then
                    "Incomplete checked struct literal".to_str std::Result::Error return
                fi
                std::Set[std::String]::new = fields
                for field in literal.field_order.iter do
                    if field fields.has then
                        "Duplicate checked struct field".to_str std::Result::Error return
                    fi
                    if field.as_str declaration.has_checked_field ! then
                        "Missing checked struct field".to_str std::Result::Error return
                    fi
                    field.clone fields.add
                done
            }
            Action::Call(call) => callees call.validate ? drop
            Action::Closure(call) => {
                callees call.validate ? drop
                self.facts call references.require_closure ? drop
            }
            Action::SizeOf(typ) => typ validate_type ? drop
            Action::PtrAsRef(typ) => typ validate_type ? drop
            Action::PtrAsMut(typ) => typ validate_type ? drop
            Action::PtrFromRaw(typ) => typ validate_type ? drop
            Action::PtrRead(typ) => typ validate_type ? drop
            Action::PtrWrite(typ) => typ validate_type ? drop
            Action::StructMemberProject(access typ) => {
                typ validate_type ? drop access references.require_member ? drop
            }
            Action::StructMemberStore(access typ) => {
                typ validate_type ? drop access references.require_member ? drop
            }
            Action::DestructionFn(typ) => {
                typ validate_type ? drop typ.clone drops.push
            }
            Action::NumericTry(conversion wrapper) => {
                conversion.source validate_type ? drop
                wrapper.clone callees.push
            }
            Action::IntegerTry(operation wrapper) => {
                wrapper.clone callees.push
            }
            Action::ConstrainedCall(_) => "Deferred trait dispatch in concrete body".to_str std::Result::Error return
            Action::ConstrainedClosure(_) => "Deferred trait dispatch in concrete body".to_str std::Result::Error return
            _ => {
            }
        end
        true std::Result::Ok
    }
}

impl Callable {
    fn validate self:$Callable callees:mut$std::List[std::String] -> std::Result[bool std::String] {
        for substitution in self.substitutions.iter do
            substitution.second validate_type match
                std::Result::Ok(_) => {
                }
                std::Result::Error(message) => {
                    f"{message} for `{self.name}` substitution `{substitution.first}`" std::Result::Error return
                }
            end
        done
        self.name.clone callees.push
        true std::Result::Ok
    }
}

impl Body {
    pub fn validate_concrete
        self:$Body
        callees:mut$std::List[std::String]
        drops:mut$std::List[common::Type]
        references:$BodyReferences
    -> std::Result[bool std::String] {
        for node in self.nodes.iter do
            references drops callees node.validate_concrete match
                std::Result::Ok(_) => {
                }
                std::Result::Error(message) => {
                    node.get_origin = origin
                    f"{message} at {origin.file}:{origin.span.offset}" std::Result::Error return
                }
            end
        done
        true std::Result::Ok
    }
}

impl Node {
    fn get_origin self:$Node -> common::Location {
        self match
            Node::Unreachable(source) => source.origin.clone
            Node::Leaf(leaf) => leaf
                .facts
                .origin
                .clone
            Node::Conditional(conditional) => 0 conditional
                .branches
                .get
                .entry
                .origin
                .clone
            Node::Loop(loop) => loop
                .entry
                .origin
                .clone
            Node::Match(match_body) => match_body
                .entry
                .origin
                .clone
            Node::Region(region) => region
                .entry
                .origin
                .clone
            Node::Array(compound) => compound
                .facts
                .origin
                .clone
            Node::Group(compound) => compound
                .facts
                .origin
                .clone
        end
    }

    fn validate_concrete
        self:$Node
        callees:mut$std::List[std::String]
        drops:mut$std::List[common::Type]
        references:$BodyReferences
    -> std::Result[bool std::String] {
        self match
            Node::Unreachable(_) => {
            }
            Node::Leaf(leaf) => references drops callees leaf.validate ? drop
            Node::Conditional(conditional) => {
                for branch in conditional.branches.iter do
                    references drops branch.entry.validate ? drop
                    references drops branch.test.validate ? drop
                    references drops callees branch.condition.validate_concrete ? drop
                    references drops callees branch.consequent.validate_concrete ? drop
                done
                if conditional.alternative std::Option::Some(alternative) is then
                    references drops alternative.entry.validate ? drop
                    references drops callees alternative.body.validate_concrete ? drop
                fi
                references drops conditional.exit.validate ? drop
            }
            Node::Loop(loop) => {
                references drops loop.entry.validate ? drop
                references drops loop.test.validate ? drop
                references drops callees loop.condition.validate_concrete ? drop
                references drops callees loop.body.validate_concrete ? drop
                references drops loop.exit.validate ? drop
            }
            Node::Match(match_body) => {
                match_body.subject_type validate_type ? drop
                references drops match_body.entry.validate ? drop
                for arm in match_body.arms.iter do
                    arm.subject_type validate_type ? drop
                    arm.pattern references.require_pattern ? drop
                    references drops arm.entry.validate ? drop
                    references drops callees arm.guard.validate_concrete ? drop
                    references drops callees arm.body.validate_concrete ? drop
                done
                references drops match_body.exit.validate ? drop
            }
            Node::Region(region) => {
                references drops region.entry.validate ? drop
                references drops callees region.body.validate_concrete ? drop
                references drops region.exit.validate ? drop
            }
            Node::Array(compound) => {
                compound.typ validate_type ? drop
                references drops compound.facts.validate ? drop
                references drops callees compound.body.validate_concrete ? drop
            }
            Node::Group(compound) => {
                references drops compound.facts.validate ? drop
                references drops callees compound.body.validate_concrete ? drop
            }
        end
        true std::Result::Ok
    }
}

impl OperationFacts {
    fn settle self:$OperationFacts available:bool verified:mut$std::Set[i64] {
        if available ! then
            self.identity verified.remove
        fi
    }
}

impl Body {
    # Failed recursive targets invalidate dependent facts while preserving the structured body.
    pub fn settle_facts
        self:$Body
        available:bool
        rejected:$std::Set[std::String]
        verified:mut$std::Set[i64]
    -> bool {
        for node in self.nodes.iter do
            available rejected verified node.settle_facts = available
        done
        available
    }
}

impl Node {
    fn settle_facts
        self:$Node
        verified:mut$std::Set[i64]
        rejected:$std::Set[std::String]
        available:bool
    -> bool {
        self match
            Node::Unreachable(source) => {
                for occurrence in source.occurrences.iter do
                    if rejected occurrence.has_rejected_target then
                        false = available
                    fi
                    if available ! then
                        occurrence.identity verified.remove
                    fi
                done
            }
            Node::Leaf(leaf) => {
                leaf.action match
                    Action::Call(call) => {
                        if call.name rejected.has then false = available fi
                    }
                    Action::Closure(call) => {
                        if call.name rejected.has then false = available fi
                    }
                    _ => {
                    }
                end
                verified available leaf.facts.settle
            }
            Node::Conditional(conditional) => {
                available = condition_available
                true = branches_available
                for branch in conditional.branches.iter do
                    verified condition_available branch.entry.settle
                    verified rejected condition_available branch.condition.settle_facts = condition_available
                    verified condition_available branch.test.settle
                    verified rejected condition_available branch.consequent.settle_facts
                    branches_available && = branches_available
                done
                if conditional.alternative std::Option::Some(alternative) is then
                    verified condition_available alternative.entry.settle
                    verified rejected condition_available alternative.body.settle_facts
                    branches_available && = branches_available
                fi
                branches_available condition_available && = available
                verified available conditional.exit.settle
            }
            Node::Loop(loop) => {
                verified available loop.entry.settle
                verified rejected available loop.condition.settle_facts = available
                verified available loop.test.settle
                verified rejected available loop.body.settle_facts = available
                verified available loop.exit.settle
            }
            Node::Match(match_body) => {
                verified available match_body.entry.settle
                for arm in match_body.arms.iter do
                    verified rejected available arm.guard.settle_facts = available
                    verified available arm.entry.settle
                    verified rejected available arm.body.settle_facts = available
                done
                verified available match_body.exit.settle
            }
            Node::Region(region) => {
                verified available region.entry.settle
                verified rejected available region.body.settle_facts = available
                verified available region.exit.settle
            }
            Node::Array(compound) => {
                verified rejected available compound.body.settle_facts = available
                verified available compound.facts.settle
            }
            Node::Group(compound) => {
                verified rejected available compound.body.settle_facts = available
                verified available compound.facts.settle
            }
        end
        available
    }
}

fn substitute_bindings
    substitutions:$std::Map[std::String common::Type]
    bindings:mut$std::Map[std::String common::Type]
-> std::Map[std::String common::Type] {
    std::Map[std::String common::Type]::new = resolved
    for pair in substitutions.iter do
        bindings pair.second.substitute_t pair.first.clone resolved.set
    done
    resolved
}

fn substitute_binding
    kind:BindingKind
    reference:$common::BindingReference
    typ:$common::Type
    bindings:mut$std::Map[std::String common::Type]
-> std::Option[Action] {
    if kind BindingKind::PushVar == kind BindingKind::PushCapture == || then
        if bindings reference.name common::substituted_constant_value std::Option::Some(value) is then
            value match
                common::OpValue::PushInt(literal) => bindings typ.substitute_t literal Action::Integer
                common::OpValue::PushBool(literal) => literal Action::Boolean
                common::OpValue::PushChar(literal) => literal Action::Character
                _ => std::Option[Action]::None return
            end
            std::Option::Some return
        fi
    fi
    bindings typ.substitute_t reference.clone kind Action::Binding std::Option::Some
}

impl Action {
    fn substitute
        self:$Action
        bindings:mut$std::Map[std::String common::Type]
    -> std::Option[Action] {
        self match
            Action::Primitive(kind typ) => bindings typ.substitute_t kind copy Action::Primitive
            Action::Integer(value typ) => bindings typ.substitute_t value.clone Action::Integer
            Action::Float(value typ) => bindings typ.substitute_t value.clone Action::Float
            Action::Call(call) => {
                bindings call.substitutions substitute_bindings call.name.clone Callable Action::Call
            }
            Action::Closure(call) => {
                bindings call.substitutions substitute_bindings call.name.clone Callable Action::Closure
            }
            Action::Binding(kind reference typ) => bindings typ reference kind copy substitute_binding return
            Action::Enum(variant typ) => bindings typ.substitute_t variant.clone Action::Enum
            Action::PatternTest(variant typ) => bindings typ.substitute_t variant.clone Action::PatternTest
            Action::Struct(shape typ) => bindings typ.substitute_t shape.clone Action::Struct
            Action::StructFields(shape typ) => bindings typ.substitute_t shape.clone Action::StructFields
            Action::ConstrainedCall(call) => {
                bindings call.substitutions substitute_bindings bindings call.dispatch.substitute
                ConstrainedCallable Action::ConstrainedCall
            }
            Action::ConstrainedClosure(call) => {
                bindings call.substitutions substitute_bindings bindings call.dispatch.substitute
                ConstrainedCallable Action::ConstrainedClosure
            }
            Action::SizeOf(typ) => bindings typ.substitute_t Action::SizeOf
            Action::PtrAsRef(typ) => bindings typ.substitute_t Action::PtrAsRef
            Action::PtrAsMut(typ) => bindings typ.substitute_t Action::PtrAsMut
            Action::PtrFromRaw(typ) => bindings typ.substitute_t Action::PtrFromRaw
            Action::PtrRead(typ) => bindings typ.substitute_t Action::PtrRead
            Action::PtrWrite(typ) => bindings typ.substitute_t Action::PtrWrite
            Action::DestructionFn(typ) => bindings typ.substitute_t Action::DestructionFn
            Action::StructMemberProject(member typ) => bindings typ.substitute_t member.clone Action::StructMemberProject
            Action::StructMemberStore(member typ) => bindings typ.substitute_t member.clone Action::StructMemberStore
            Action::NumericTry(conversion wrapper) => wrapper.clone conversion.target bindings conversion.source.substitute_t common::NumericTry Action::NumericTry
            _ => std::Option[Action]::None return
        end
        std::Option::Some
    }
}

impl OperationFacts {
    fn substitute
        self:mut$OperationFacts
        bindings:mut$std::Map[std::String common::Type]
        store:mut$common::SymbolStore
    {
        store.next_op_id = self.identity
        1 += store.next_op_id
        if self.effects std::Option::Some(effects) is then
            0 = index: u64
            while index effects.assignments.length > do
                index effects.assignments.get_mut = event
                bindings event.typ.substitute_t = event.typ
                1 += index
            done
            0 = index: u64
            while index effects.cleanups.length > do
                index effects.cleanups.get_mut = event
                bindings event.typ.substitute_t = event.typ
                1 += index
            done
        fi
        if self.bindings std::Option::Some(facts) is then
            0 = index: u64
            while index facts.length > do
                if index facts.get_mut common::BindingFact::Definition(binding) is then
                    bindings binding.typ.substitute_t = binding.typ
                fi
                1 += index
            done
        fi
    }
}

impl Body {
    # Specialization changes recipe facts in the same vocabulary used by checking.
    pub fn substitute
        self:mut$Body
        bindings:mut$std::Map[std::String common::Type]
        store:mut$common::SymbolStore
    {
        0 = index: u64
        while index self.nodes.length > do
            store bindings index self
                .nodes
                .get_mut
                .substitute
            1 += index
        done
    }
}

impl Node {
    fn substitute
        self:mut$Node
        bindings:mut$std::Map[std::String common::Type]
        store:mut$common::SymbolStore
    {
        self match
            Node::Unreachable(_) => {
            }
            Node::Leaf(leaf) => {
                store bindings leaf.facts.substitute
                if bindings leaf.action.substitute std::Option::Some(resolved) is then
                    resolved = leaf.action
                fi
            }
            Node::Conditional(conditional) => {
                0 = index: u64
                while index conditional.branches.length > do
                    index conditional.branches.get_mut = branch
                    store bindings branch.entry.substitute
                    store bindings branch.test.substitute
                    store bindings branch.condition.substitute
                    store bindings branch.consequent.substitute
                    1 += index
                done
                if conditional.alternative std::Option::Some(alternative) is then
                    store bindings alternative.entry.substitute
                    store bindings alternative.body.substitute
                fi
                store bindings conditional.exit.substitute
            }
            Node::Loop(loop) => {
                store bindings loop.entry.substitute
                store bindings loop.test.substitute
                store bindings loop.condition.substitute
                store bindings loop.body.substitute
                store bindings loop.exit.substitute
            }
            Node::Match(match_body) => {
                bindings match_body.subject_type.substitute_t = match_body.subject_type
                store bindings match_body.entry.substitute
                0 = index: u64
                while index match_body.arms.length > do
                    index match_body.arms.get_mut = arm
                    bindings arm.subject_type.substitute_t = arm.subject_type
                    store bindings arm.entry.substitute
                    store bindings arm.guard.substitute
                    store bindings arm.body.substitute
                    1 += index
                done
                store bindings match_body.exit.substitute
            }
            Node::Region(region) => {
                store bindings region.entry.substitute
                store bindings region.body.substitute
                store bindings region.exit.substitute
            }
            Node::Array(compound) => {
                bindings compound.typ.substitute_t = compound.typ
                store bindings compound.facts.substitute
                store bindings compound.body.substitute
            }
            Node::Group(compound) => {
                store bindings compound.facts.substitute
                store bindings compound.body.substitute
            }
        end
    }
}

impl Body {
    pub fn visit_calls self:$Body visitor:$fn[$Callable $common::Location] {
        for node in self.nodes.iter do
            node match
                Node::Unreachable(source) => {
                    for site in source.calls.iter do
                        site.origin site.call visitor exec
                    done
                }
                Node::Leaf(leaf) => {
                    leaf.action match
                        Action::Call(call) => leaf.facts.origin call visitor exec
                        Action::Closure(call) => leaf.facts.origin call visitor exec
                        _ => {
                        }
                    end
                }
                Node::Conditional(conditional) => {
                    for branch in conditional.branches.iter do
                        visitor branch.condition.visit_calls
                        visitor branch.consequent.visit_calls
                    done
                    if conditional.alternative std::Option::Some(alternative) is then
                        visitor alternative.body.visit_calls
                    fi
                }
                Node::Loop(loop) => {
                    visitor loop.condition.visit_calls
                    visitor loop.body.visit_calls
                }
                Node::Match(match_body) => {
                    for arm in match_body.arms.iter do
                        visitor arm.guard.visit_calls
                        visitor arm.body.visit_calls
                    done
                }
                Node::Region(region) => visitor region.body.visit_calls
                Node::Array(compound) => visitor compound.body.visit_calls
                Node::Group(compound) => visitor compound.body.visit_calls
            end
        done
    }
}

impl Body {
    pub fn visit_closures self:mut$Body visitor:$fn[mut$Callable] {
        0 = index: u64
        while index self.nodes.length > do
            index self.nodes.get_mut match
                Node::Unreachable(_) => {
                }
                Node::Leaf(leaf) => {
                    if leaf.action Action::Closure(call) is then call visitor exec fi
                }
                Node::Conditional(conditional) => {
                    0 = branch_index: u64
                    while branch_index conditional.branches.length > do
                        branch_index conditional.branches.get_mut = branch
                        visitor branch.condition.visit_closures
                        visitor branch.consequent.visit_closures
                        1 += branch_index
                    done
                    if conditional.alternative std::Option::Some(alternative) is then
                        visitor alternative.body.visit_closures
                    fi
                }
                Node::Loop(loop) => {
                    visitor loop.condition.visit_closures
                    visitor loop.body.visit_closures
                }
                Node::Match(match_body) => {
                    0 = arm_index: u64
                    while arm_index match_body.arms.length > do
                        arm_index match_body.arms.get_mut = arm
                        visitor arm.guard.visit_closures
                        visitor arm.body.visit_closures
                        1 += arm_index
                    done
                }
                Node::Region(region) => visitor region.body.visit_closures
                Node::Array(compound) => visitor compound.body.visit_closures
                Node::Group(compound) => visitor compound.body.visit_closures
            end
            1 += index
        done
    }
}

fn make_accessor_facts store:mut$common::SymbolStore origin:$common::Location -> OperationFacts {
    store.next_op_id = identity
    1 += store.next_op_id
    std::Option[std::List[common::BindingFact]]::None std::Option[common::OpOwnership]::None
    origin.clone identity OperationFacts
}
# Accessors are declaration forms. Their semantic bodies are built with field types at checking entry.
pub fn make_accessor_body
    accessor:$common::MemberAccessor
    declaration:$common::Function
    store:mut$common::SymbolStore
-> Body {
    if accessor.kind common::MemberAccessKind::Read == then
        0 declaration
            .stack_effect
            .return_types
            .get
            .clone
    else
        1 declaration
            .stack_effect
            .parameters
            .get
            .typ
            .clone
    fi = typ
    std::List[Node]::new = operations
    IntrinsicKind::PtrFromRef Action::Intrinsic declaration.location store make_accessor_facts Leaf Node::Leaf operations.push
    if accessor.kind common::MemberAccessKind::Write == then
        common::make_ptr_type PrimitiveKind::Dup Action::Primitive declaration.location store make_accessor_facts Leaf Node::Leaf operations.push
    fi
    typ.clone accessor.member.clone Action::StructMemberProject declaration.location store make_accessor_facts Leaf Node::Leaf operations.push
    if accessor.kind common::MemberAccessKind::Write == then
        typ.clone PrimitiveKind::Drop Action::Primitive declaration.location store make_accessor_facts Leaf Node::Leaf operations.push
        typ accessor.member.clone Action::StructMemberStore declaration.location store make_accessor_facts Leaf Node::Leaf operations.push
    fi
    std::List[Node]::new = nodes
    declaration.location store make_accessor_facts operations Body declaration.location store make_accessor_facts
    Region Node::Region nodes.push
    nodes Body
}

impl OperationFacts {
    fn visit_types self:$OperationFacts visitor:$fn[$common::Type] {
        if self.effects std::Option::Some(effects) is then
            for event in effects.cleanups.iter do
                event.typ visitor exec
            done
            for event in effects.assignments.iter do
                event.typ visitor exec
            done
        fi
    }
}

impl Body {
    pub fn visit_types self:$Body visitor:$fn[$common::Type] {
        for node in self.nodes.iter do
            visitor node.visit_types
        done
    }
}

impl Node {
    fn visit_types self:$Node visitor:$fn[$common::Type] {
        self match
            Node::Unreachable(_) => {
            }
            Node::Leaf(leaf) => {
                visitor leaf.facts.visit_types
                leaf.action match
                    Action::Primitive(_ typ) => typ visitor exec
                    Action::Integer(_ typ) => typ visitor exec
                    Action::Float(_ typ) => typ visitor exec
                    Action::Binding(kind binding typ) => typ visitor exec
                    Action::Enum(_ typ) => typ visitor exec
                    Action::PatternTest(_ typ) => typ visitor exec
                    Action::Struct(_ typ) => typ visitor exec
                    Action::StructFields(_ typ) => typ visitor exec
                    Action::SizeOf(typ) => typ visitor exec
                    Action::PtrAsRef(typ) => typ visitor exec
                    Action::PtrAsMut(typ) => typ visitor exec
                    Action::PtrFromRaw(typ) => typ visitor exec
                    Action::PtrRead(typ) => typ visitor exec
                    Action::PtrWrite(typ) => typ visitor exec
                    Action::StructMemberProject(_ typ) => typ visitor exec
                    Action::StructMemberStore(_ typ) => typ visitor exec
                    Action::DestructionFn(typ) => typ visitor exec
                    _ => {
                    }
                end
            }
            Node::Conditional(conditional) => {
                for branch in conditional.branches.iter do
                    visitor branch.entry.visit_types
                    visitor branch.test.visit_types
                    visitor branch.condition.visit_types
                    visitor branch.consequent.visit_types
                done
                if conditional.alternative std::Option::Some(alternative) is then
                    visitor alternative.entry.visit_types
                    visitor alternative.body.visit_types
                fi
                visitor conditional.exit.visit_types
            }
            Node::Loop(loop) => {
                visitor loop.entry.visit_types
                visitor loop.test.visit_types
                visitor loop.condition.visit_types
                visitor loop.body.visit_types
                visitor loop.exit.visit_types
            }
            Node::Match(match_body) => {
                visitor match_body.entry.visit_types
                match_body.subject_type visitor exec
                for arm in match_body.arms.iter do
                    visitor arm.entry.visit_types
                    arm.subject_type visitor exec
                    visitor arm.guard.visit_types
                    visitor arm.body.visit_types
                done
                visitor match_body.exit.visit_types
            }
            Node::Region(region) => {
                visitor region.entry.visit_types
                visitor region.body.visit_types
                visitor region.exit.visit_types
            }
            Node::Group(group) => {
                visitor group.facts.visit_types
                visitor group.body.visit_types
            }
            Node::Array(array) => {
                visitor array.facts.visit_types
                array.typ visitor exec
                visitor array.body.visit_types
            }
        end
    }
}

fn select_numeric_wrapper target:$common::BuiltinType -> std::String {
    target.format = target_name
    f"{common::STD_NAMESPACE}__numeric_try_{target_name}"
}
