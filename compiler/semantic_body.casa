    PushFloat (std::String)
    PushStr (std::String)
    PushBool (i64)
    PushChar (i64)
    PtrAsRef (common::Type)
    PtrAsMut (common::Type)
    PtrFromRaw (common::Type)
    SizeOf
    MethodCall
    TraitMethodCall
    TraitMethodRef
    FnExec
    FnExecOwned
    IfStart
    IfCondition
    IfElif
    IfElse
    IfEnd
    WhileStart
    WhileCondition
    WhileEnd
    WhileBreak
    WhileContinue
    MatchStart
    MatchArm
    MatchEnd
    FnReturn
    Question
    UnsafeStart
    Add
    Sub
    Mul
    Div
    Mod
    Shl
    Shr
    BitAnd
    BitOr
    BitXor
    BitNot
    And
    Or
    Not
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
    Drop
    Dup
    Copy
    Swap
    Over
    Rot
    Print
    PrintInt
    PrintStr
    PrintString
    PrintBool
    PrintChar
    HeapAlloc
    HeapFree
    Load8
    Load16
    Load32
    Load64
    PtrFromRef
    PtrIntoRaw
    PtrNull
    PtrRead (common::Type)
    Store8
    Store16
    Store32
    Store64
    PtrWrite (common::Type)
