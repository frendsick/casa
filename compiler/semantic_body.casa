# Checked recipes and concrete bodies share these nodes. Construction moves facts out of checker work.
import "std" as std
import "common" as common
import "bindings" as bindings

# Source occurrences retain query data without executable operands or ownership effects.
pub struct Occurrence derives std::Clone {
    pub identity:  i64
    pub location:  common::Location
    pub value:     OccurrenceValue
    pub type_hint: std::Option[common::Type]
}

pub struct OccurrenceStruct derives std::Clone {
    pub name:      std::String
    pub location:  common::Location
    pub members:   std::List[common::Member]
    pub is_extern: bool
}

pub struct OccurrenceVariant derives std::Clone {
    pub enum_name:    std::String
    pub variant_name: std::String
}

# Operation kinds and source payloads needed by document queries.
