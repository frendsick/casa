# Source binding facts owned by semantic checking, independent of executable bodies.
import "std" as std
import "common" as common

pub struct Binding {
    pub operation:   i64
    pub name:        std::String
    pub declaration: common::Location
    pub owner:       std::Option[common::Location]
    pub visibility:  common::Location
    pub typ:         common::Type
    pub verified:    bool
}

pub struct BindingStore {
    pub declarations: std::List[Binding]
    pub references:   std::Map[i64 u64]
}

impl BindingStore {
    pub fn new -> BindingStore { std::Map[i64 u64]::new std::List[Binding]::new BindingStore }

    pub fn find_reference self:$BindingStore operation:i64 -> std::Option[$Binding] {
        if operation self.references.get std::Option::Some(identity) is then
            identity copy self.declarations.get = binding
            if binding.verified then
                binding std::Option::Some return
            fi
        fi
        std::Option[$Binding]::None
    }
}

impl Binding {
    pub fn close_visibility self:mut$Binding end_offset:u64 {
        if
            self
                .visibility
                .span
                .offset end_offset >=
        then
            self
                .visibility
                .span
                .offset = offset
            end_offset offset - offset self.visibility.with_span = self.visibility
        fi
    }

    pub fn belongs_to self:$Binding function:$common::Function -> bool {
        if self.owner std::Option::Some(owner) is then
            owner function.location.matches return
        fi
        false
    }
}
