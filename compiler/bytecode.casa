                fi
            }
            common::OpValue::WhileCondition => {
                if op_index targets.get_end std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = end_label_2
                    end_label_2 common::InstValue::JumpNe bytecode.push
                else
                    "While condition target is missing during bytecode compilation" self.record_failure
                fi
            }
            common::OpValue::WhileContinue => {
                if op_index targets.get_start std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = continue_target
                    continue_target common::InstValue::Jump bytecode.push
                else
                    "Continue target is missing during bytecode compilation" self.record_failure
                fi
            }
            common::OpValue::WhileEnd => {
                op_index ops.get self.op_to_label = while_label
                if op_index targets.get_start std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = loop_start
                    bytecode op self.compile_owner_cleanups
                    loop_start common::InstValue::Jump bytecode.push
                    while_label common::InstValue::Label bytecode.push
                    bytecode op self.compile_owner_cleanups
                else
                    "While start target is missing during bytecode compilation" self.record_failure
                fi
            }
            common::OpValue::WhileStart => {
                op_index ops.get self.op_to_label = start_label
                start_label common::InstValue::Label bytecode.push
            }
            _ => {
                "compile_while_block received a non-while operation" self.record_failure
            }
        end
    }
}

# ============================================================================
# Compile match block
# ============================================================================
# compile_match_op — per-arm bytecode entry point dispatching on PatternValue.
# Replaces the three former compile_match_arm_* helpers and consolidates
# literal / enum / struct emission behind a single pattern-driven function.

impl BytecodeCompiler {
    fn emit_struct_arm
        compiler:mut$BytecodeCompiler
        store:$common::SymbolStore
        struct_pattern:common::StructPattern
        bytecode:mut$std::List[common::InstValue]
    {
        struct_pattern common::StructPattern::struct_name store.structs.get = casa_struct_opt
        if casa_struct_opt.is_none then
            f"Struct `{struct_pattern.struct_name}` is missing during bytecode compilation" compiler.record_failure_string
            return
        fi
        casa_struct_opt.unwrap = casa_struct
        0 = index: u64
        while index casa_struct common::CasaStruct::members.length > do
            index casa_struct common::CasaStruct::members.get = member
            member common::Member::name.as_str = field_name: $str
            index casa_struct compiler.get_struct_field_plan = plan
            if
                field_name struct_pattern common::StructPattern::bindings.get_str std::Option::Some(var_name) is
            then
                common::InstValue::Dup bytecode.push
                if 0 plan.offset > then
                    plan.offset i64::try_from.unwrap common::InstValue::Push bytecode.push
                    common::InstValue::Add bytecode.push
                fi
                bytecode plan member.typ compiler.emit_field_load
                bytecode var_name.as_str compiler.emit_variable_set
            fi
            1 += index
        done
    }
}

fn emit_int_eq value:$i64 bytecode:mut$std::List[common::InstValue] {
    value copy common::InstValue::Push bytecode.push
    common::InstValue::Eq bytecode.push
}

fn require_variant_ordinal variant:$common::EnumVariant compiler:mut$BytecodeCompiler -> i64 {
    if variant.ordinal std::Option::Some(ordinal) is then
        ordinal return
    fi
    f"Enum variant `{variant.variant_name}` has no ordinal during bytecode compilation" compiler.record_failure_string
    0
}

impl BytecodeCompiler {
    fn emit_literal_arm
        compiler:mut$BytecodeCompiler
        literal_pattern:common::LiteralPattern
        is_last:bool
        next_arm:mut$std::Option[u64]
        bytecode:mut$std::List[common::InstValue]
    {
        if is_last then
            return
        fi
        common::InstValue::Dup bytecode.push
        literal_pattern.value match
            common::LiteralValue::Str(str_value) => {
                str_value.as_str compiler.intern_string = str_index
                str_index common::InstValue::PushStr bytecode.push
                common::InstValue::StrEq bytecode.push
            }
            common::LiteralValue::Int(int_value) => {
                bytecode int_value.value emit_int_eq
            }
            common::LiteralValue::Char(char_value) => {
                bytecode char_value emit_int_eq
            }
            common::LiteralValue::Bool(bool_value) => {
                bytecode if bool_value then 1 else 0 fi emit_int_eq
            }
        end
        if next_arm std::Option::Some(label) is then
            label common::InstValue::JumpNe bytecode.push
        else
            "Match arm has no following label during bytecode compilation" compiler.record_failure
        fi
    }
}

impl BytecodeCompiler {
    fn emit_enum_arm
        compiler:mut$BytecodeCompiler
        variant:$common::EnumVariant
        is_wildcard:bool
        is_last:bool
        next_arm:mut$std::Option[u64]
        bytecode:mut$std::List[common::InstValue]
    {
        if is_wildcard then
            return
        fi
        variant.enum_name.as_str = enum_name: $str
        if
            "" enum_name.as_str != enum_name compiler
                .state
                .store
                .enums
                .has_str &&
        then
            enum_name compiler
                .state
                .store
                .enums
                .get_str
                .unwrap
                .clone = casa_enum
            if casa_enum common::has_inner_values then
                if is_last ! then
                    common::InstValue::Dup bytecode.push
                    common::InstValue::Load64 bytecode.push
