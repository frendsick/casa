# Bytecode compiler: lowers Op tree into a flat List[InstValue].
#
# Translates high-level Ops (produced by the parser/typechecker) into
# low-level instructions suitable for code generation.
import "std"
import "common"
import "error"
import "pattern"
import "typechecker"

# ============================================================================
# BytecodeCompiler struct
# ============================================================================

struct BytecodeFailure {
    message: str
}

impl BytecodeFailure {
    fn new message:str -> BytecodeFailure { message BytecodeFailure }
}

struct BytecodeState {
    store:           $SymbolStore
    program:         Program
    failure:         Option[BytecodeFailure]
    global_slots:    Map[str u64]
    string_indices:  Map[str u64]
    constants_table: List[str]
    label_counter:   u64
    op_label_map:    Map[i64 u64]
}

struct BytecodeCompiler {
    ops:           $List[Op]
    function:      Option[Function]
    local_slots:   Map[str u64]
    capture_slots: Map[str u64]
    locals_count:  u64
    state:         mut$BytecodeState
    owner_flags:   Map[str u64]
}

impl BytecodeState {
    fn new store:$SymbolStore -> BytecodeState {
        Map[i64 u64]::new
        0
        List[str]::new
        Map[str u64]::new
        store.variables index_variable_map
        Option[BytecodeFailure]::None
        0
        0
        List[StaticStruct]::new
        List[StaticArray]::new
        List[str]::new
        Map[str List[InstValue]]::new
        List[InstValue]::new
        Program
        store
        BytecodeState
    }

    fn into_result self:BytecodeState -> Result[Program BytecodeFailure] {
        self match
            BytecodeState { program: program failure: failure } => {
                failure match
                    Option::Some(bytecode_failure) => bytecode_failure Result::Error
                    Option::None => program Result::Ok
                end
            }
        end
    }
}

impl BytecodeCompiler {
    fn new state:mut$BytecodeState ops:$List[Op] -> BytecodeCompiler {
        Map[str u64]::new
        state
        0
        Map[str u64]::new
        Map[str u64]::new
        Option[Function]::None
        ops
        BytecodeCompiler
    }

    fn child self:mut$BytecodeCompiler function:$Function ops:$List[Op] -> BytecodeCompiler {
        Map[str u64]::new
        self.state
        0
        function.captures index_variable_list
        function.variables index_variable_list
        function.clone_declaration Option::Some
        ops
        BytecodeCompiler
    }

    fn record_failure self:mut$BytecodeCompiler message:str {
        if
            self
                .state
                .failure
                .is_none
        then
            message BytecodeFailure::new Option::Some = self.state.failure
        fi
    }

    fn has_failed self:mut$BytecodeCompiler -> bool { self.state.failure.is_some }

    fn aggregate_field_load
        compiler:mut$BytecodeCompiler
        declared_type:$Type
        bytecode:mut$List[InstValue]
    {
        if declared_type.has_unresolved_type_var then
            InstValue::Load64 bytecode.push
            return
        fi
        if compiler.state.store declared_type type_value_representation Option::Some(representation) is then
            if VALUE_REPR_INDIRECT representation == then
                InstValue::Load64 bytecode.push
            else
                bytecode declared_type compiler.emit_typed_load
            fi
        else
            f"Cannot determine field representation of `{declared_type.format}`" compiler.record_failure
        fi
    }

    fn aggregate_field_store
        compiler:mut$BytecodeCompiler
        declared_type:$Type
        bytecode:mut$List[InstValue]
    {
        if declared_type.has_unresolved_type_var then
            InstValue::Store64 bytecode.push
            return
        fi
        if compiler.state.store declared_type type_value_representation Option::Some(representation) is then
            if VALUE_REPR_INDIRECT representation == then
                InstValue::Store64 bytecode.push
            else
                bytecode declared_type compiler.emit_typed_store
            fi
        else
            f"Cannot determine field representation of `{declared_type.format}`" compiler.record_failure
        fi
    }

    fn struct_size compiler:mut$BytecodeCompiler casa_struct:$CasaStruct -> u64 {
        casa_struct.name.clone GenericType::new Type::Generic = struct_type
        if compiler.state.store struct_type type_inline_size Option::Some(size) is then
            size return
        fi
        f"Cannot determine layout of struct `{casa_struct.name}`" compiler.record_failure
        0
    }

    fn struct_offset compiler:mut$BytecodeCompiler casa_struct:$CasaStruct member_index:u64 -> u64 {
        if compiler.state.store member_index casa_struct struct_member_offset Option::Some(offset) is then
            offset return
        fi
        f"Cannot determine member {member_index} layout of struct `{casa_struct.name}`"
        compiler.record_failure
        0
    }

    fn enum_size compiler:mut$BytecodeCompiler casa_enum:$CasaEnum -> u64 {
        casa_enum.name.clone GenericType::new Type::Generic = enum_type
        if compiler.state.store enum_type type_inline_size Option::Some(size) is then
            size return
        fi
        f"Cannot determine layout of enum `{casa_enum.name}`" compiler.record_failure
        0
    }

    fn enum_offset
        compiler:mut$BytecodeCompiler
        casa_enum:$CasaEnum
        variant_name:$str
        payload_index:u64
    -> u64 {
        if
            compiler.state.store payload_index variant_name casa_enum
            enum_payload_offset Option::Some(offset) is
        then
            offset return
        fi
        f"Cannot determine payload {payload_index} layout of `{casa_enum.name}::{variant_name}`"
        compiler.record_failure
        0
    }
}

# ============================================================================
# Label management
# ============================================================================

impl BytecodeState {
    fn new_label self:mut$BytecodeState -> u64 {
        self.label_counter = value
        1 += self.label_counter
        value
    }

    fn op_identity_to_label self:mut$BytecodeState address:i64 -> u64 {
        if address self.op_label_map.get_copy Option::Some(existing) is then
            existing
        else
            self.new_label = label
            label address self.op_label_map.set
            label
        fi
    }
}

impl BytecodeCompiler {
    fn new_label self:mut$BytecodeCompiler -> u64 { self.state.new_label }

    fn op_to_label self:mut$BytecodeCompiler op:$Op -> u64 {
        op op_identity = address
        address self.state.op_identity_to_label
    }
}

# ============================================================================
# String/constant interning
# ============================================================================

fn intern_table table:mut$List[str] value:$str -> u64 {
    # Add value to table if not present, return its index.
    if value table string_list_contains then
        value table string_list_index (u64)
    else
        table.length = table_index
        value.clone table.push
        table_index
    fi
}

impl BytecodeCompiler {
    fn intern_string compiler:mut$BytecodeCompiler value:$str -> u64 {
        if
            value compiler
                .state
                .string_indices
                .get_copy Option::Some(index) is
        then
            index
        else
            compiler
                .state
                .program
                .strings
                .length = index
            index value.clone compiler
                .state
                .string_indices
                .set
            value.clone compiler
                .state
                .program
                .strings
                .push
            index
        fi
    }
}

# ============================================================================
# Variable resolution
# ============================================================================

fn index_variable_list variables:$List[Variable] -> Map[str u64] {
    Map[str u64]::new = slots
    0 (u64) = index
    for variable in variables.iter do
        if variable.name slots.has ! then
            index variable.name.clone slots.set
        fi
        1 += index
    done
    slots
}

fn index_variable_map variables:$Map[str Variable] -> Map[str u64] {
    Map[str u64]::new = slots
    variables.keys = names
    0 (u64) = index
    for name in names.iter do
        index name.clone slots.set
        1 += index
    done
    slots
}

impl BytecodeCompiler {
    fn resolve_variable compiler:mut$BytecodeCompiler variable_name:$str -> ResolvedVariable {
        if variable_name compiler.local_slots.get_copy Option::Some(local_index) is then
            local_index ResolvedVariable::Local return
        fi
        if
            variable_name compiler
                .state
                .global_slots
                .get_copy Option::Some(global_index) is
        then
            global_index ResolvedVariable::Global return
        fi
        if compiler.function Option::Some(function) is then
            f"Variable `{variable_name}` is missing while compiling `{function.name}`"
            compiler.record_failure
        else
            f"Variable `{variable_name}` is missing during bytecode compilation"
            compiler.record_failure
        fi
        0 ResolvedVariable::Local
    }
}

# ============================================================================
# Deterministic destruction
# ============================================================================

impl BytecodeCompiler {
    fn append_hidden_type_parameter_name
        self:mut$BytecodeCompiler
        parameter:$Parameter
        parameter_names:mut$List[str]
        seen:mut$Set[str]
    {
        "" = prefix
        if parameter.name HIDDEN_SIZE_PREFIX str::starts_with then
            HIDDEN_SIZE_PREFIX = prefix
        elif parameter.name HIDDEN_REPR_PREFIX str::starts_with then
            HIDDEN_REPR_PREFIX = prefix
        elif parameter.name HIDDEN_DROP_PREFIX str::starts_with then
            HIDDEN_DROP_PREFIX = prefix
        else
            return
        fi
        prefix parameter.name hidden_layout_parameter_type = parameter_type
        if parameter_type.type_var_name Option::Some(name) is then
            if name seen.has then
                return
            fi
            name.clone seen.add
            name.clone parameter_names.push
        fi
    }

    fn resolve_destruction_type_bindings
        self:mut$BytecodeCompiler
        typ:$Type
        function:$Function
    -> Map[str Type] {
        Map[str Type]::new = bindings
        if typ Type::Generic(generic) is then
            if
                generic.base self
                    .state
                    .store
                    .clone_struct Option::Some(casa_struct) is
            then
                casa_struct.type_vars typ aggregate_type_bindings = bindings
            elif
                generic.base self
                    .state
                    .store
                    .clone_enum Option::Some(casa_enum) is
            then
                casa_enum.type_vars typ aggregate_type_bindings = bindings
            fi
        fi
        if typ Type::Generic(actual_generic) is then
            List[str]::new = parameter_names
            Set[str]::new = seen
            for
                parameter in function
                    .stack_effect
                    .parameters
                    .iter
            do
                seen parameter_names parameter self.append_hidden_type_parameter_name
            done
            0 (u64) = index
            while index parameter_names.length > index actual_generic.params.length > && do
                index actual_generic.params.get clone_type index parameter_names.get.clone bindings.set
                1 += index
            done
        fi
        bindings
    }

    fn compile_drop_hook_layout_arguments
        self:mut$BytecodeCompiler
        typ:$Type
        function:$Function
        op:$Op
        bytecode:mut$List[InstValue]
    {
        function typ self.resolve_destruction_type_bindings = bindings
        function
            .stack_effect
            .parameters
            .length = parameter_index
        while 0 parameter_index != do
            1 -= parameter_index
            parameter_index function
                .stack_effect
                .parameters
                .get = parameter
            parameter.name HIDDEN_SIZE_PREFIX str::starts_with = is_size
            parameter.name HIDDEN_REPR_PREFIX str::starts_with = is_repr
            parameter.name HIDDEN_DROP_PREFIX str::starts_with = is_drop
            if is_size is_repr || is_drop || ! then
                continue
            fi
            if is_size then
                HIDDEN_SIZE_PREFIX parameter.name hidden_layout_parameter_type
            elif is_repr then
                HIDDEN_REPR_PREFIX parameter.name hidden_layout_parameter_type
            else
                HIDDEN_DROP_PREFIX parameter.name hidden_layout_parameter_type
            fi = queried_type
            bindings queried_type.substitute_t = resolved_type
            if resolved_type.has_unresolved_type_var then
                if is_size then
                    resolved_type make_hidden_size_parameter_name
                elif is_repr then
                    resolved_type make_hidden_repr_parameter_name
                else
                    resolved_type make_hidden_drop_parameter_name
                fi = hidden_name
                if hidden_name self.capture_slots.get_copy Option::Some(capture_index) is then
                    capture_index InstValue::CaptureLoad bytecode.push
                else
                    hidden_name self.resolve_variable = hidden_variable
                    bytecode hidden_variable.emit_get
                fi
            elif is_size then
                if self.state.store resolved_type type_inline_size Option::Some(size) is then
                    size i64::try_from.unwrap InstValue::Push bytecode.push
                else
                    f"Cannot determine drop layout of `{resolved_type.format}`" self.record_failure
                fi
            elif
                is_repr self.state.store resolved_type type_value_representation Option::Some(representation) is &&
            then
                representation i64::try_from.unwrap InstValue::Push bytecode.push
            elif is_drop then
                if resolved_type self.destruction_needs_function then
                    op resolved_type self.ensure_destruction_function = drop_name
                    drop_name InstValue::DropFn bytecode.push
                else
                    0 InstValue::Push bytecode.push
                fi
            else
                f"Cannot determine drop representation of `{resolved_type.format}` while invoking `{function.name}` for `{typ.format}`"
                self.record_failure
            fi
        done
    }

    fn compile_drop_hook
        compiler:mut$BytecodeCompiler
        typ:$Type
        op:$Op
        bytecode:mut$List[InstValue]
    {
        f"{typ.match_base}::drop" = function_name
        if
            function_name compiler
                .state
                .store
                .functions
                .get Option::Some(function) is
        then
            function.clone = drop_function
            InstValue::Dup bytecode.push
            bytecode op drop_function typ compiler.compile_drop_hook_layout_arguments
            op drop_function compiler.compile_function
            function_name InstValue::FnCall bytecode.push
        fi
    }

    # Destroy every element of an `array[T N]` value. The array stores nothing
    # but its elements, so the element count comes from the type (ADR-0152).
    fn compile_array_destruction
        compiler:mut$BytecodeCompiler
        element_type:$Type
        length:$ConstType
        op:$Op
        bytecode:mut$List[InstValue]
    {
        compiler.locals_count = array_local
        1 += compiler.locals_count
        compiler.locals_count = index_local
        1 += compiler.locals_count
        array_local InstValue::LocalSet bytecode.push
        if length.is_symbolic then
            length.name compiler.resolve_variable = resolved_length
            bytecode resolved_length.emit_get
        else
            length.value InstValue::Push bytecode.push
        fi
        index_local InstValue::LocalSet bytecode.push

        compiler.new_label = start_label
        compiler.new_label = element_label
        compiler.new_label = end_label
        start_label InstValue::Label bytecode.push
        index_local InstValue::LocalGet bytecode.push
        0 InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        element_label InstValue::JumpNe bytecode.push
        end_label InstValue::Jump bytecode.push
        element_label InstValue::Label bytecode.push
        index_local InstValue::LocalGet bytecode.push
        1 InstValue::Push bytecode.push
        InstValue::Sub bytecode.push
        index_local InstValue::LocalSet bytecode.push
        array_local InstValue::LocalGet bytecode.push
        index_local InstValue::LocalGet bytecode.push
        bytecode element_type compiler.emit_inline_size
        InstValue::Mul bytecode.push
        InstValue::Add bytecode.push
        bytecode element_type compiler.emit_typed_load
        bytecode op element_type compiler.compile_destruction
        start_label InstValue::Jump bytecode.push
        end_label InstValue::Label bytecode.push
        array_local InstValue::LocalGet bytecode.push
        InstValue::HeapFree bytecode.push
    }

    fn compile_struct_fields
        compiler:mut$BytecodeCompiler
        typ:$Type
        casa_struct:$CasaStruct
        skipped:mut$List[str]
        op:$Op
        bytecode:mut$List[InstValue]
    {
        casa_struct.type_vars typ aggregate_type_bindings = substitutions
        casa_struct.members.length = member_index
        while 0 member_index != do
            1 -= member_index
            member_index casa_struct.members.get = member
            if member.name skipped string_list_contains then
                continue
            fi
            substitutions member.typ.substitute_t = member_type
            InstValue::Dup bytecode.push
            member_index casa_struct compiler.struct_offset = offset
            if 0 offset != then
                offset (i64) InstValue::Push bytecode.push
                InstValue::Add bytecode.push
            fi
            bytecode member.typ compiler.aggregate_field_load
            bytecode op member_type compiler.compile_destruction
        done
        InstValue::HeapFree bytecode.push
    }

    fn compile_enum_variant_fields
        compiler:mut$BytecodeCompiler
        typ:$Type
        casa_enum:$CasaEnum
        variant_name:$str
        skipped_count:u64
        op:$Op
        bytecode:mut$List[InstValue]
    {
        casa_enum.type_vars typ aggregate_type_bindings = substitutions
        if variant_name casa_enum.variant_types.get Option::Some(payload_types) is then
            payload_types.length = payload_index
            while skipped_count payload_index > do
                1 -= payload_index
                substitutions payload_index payload_types.get.substitute_t = payload_type
                InstValue::Dup bytecode.push
                payload_index variant_name casa_enum compiler.enum_offset i64::try_from.unwrap
                InstValue::Push bytecode.push
                InstValue::Add bytecode.push
                bytecode payload_index payload_types.get compiler.aggregate_field_load
                bytecode op payload_type compiler.compile_destruction
            done
        fi
        InstValue::HeapFree bytecode.push
    }

    fn compile_enum_fields
        compiler:mut$BytecodeCompiler
        typ:$Type
        casa_enum:$CasaEnum
        op:$Op
        bytecode:mut$List[InstValue]
    {
        compiler.locals_count = enum_local
        1 += compiler.locals_count
        enum_local InstValue::LocalSet bytecode.push
        compiler.new_label = end_label
        0 (u64) = variant_index
        while variant_index casa_enum.variants.length > do
            compiler.new_label = next_label
            enum_local InstValue::LocalGet bytecode.push
            InstValue::Load64 bytecode.push
            variant_index (i64) InstValue::Push bytecode.push
            InstValue::Eq bytecode.push
            next_label InstValue::JumpNe bytecode.push
            enum_local InstValue::LocalGet bytecode.push
            variant_index casa_enum.variants.get = variant_name
            bytecode op 0 variant_name casa_enum typ compiler.compile_enum_variant_fields
            end_label InstValue::Jump bytecode.push
            next_label InstValue::Label bytecode.push
            1 += variant_index
        done
        end_label InstValue::Label bytecode.push
    }

    fn compile_destruction_body
        compiler:mut$BytecodeCompiler
        typ:$Type
        op:$Op
        bytecode:mut$List[InstValue]
    {
        if typ.is_borrow then
            InstValue::Drop bytecode.push return
        fi
        if typ Type::Function(_) is then
            InstValue::ClosureDrop bytecode.push return
        fi
        bytecode op typ compiler.compile_drop_hook
        typ clone_type = destruction_type
        if destruction_type Type::Generic(generic) is then
            if ARRAY_TYPE generic.base == then
                if destruction_type get_array_length_parameter Option::Some(array_length) is then
                    bytecode op array_length 0 generic.params.get compiler.compile_array_destruction
                else
                    InstValue::Drop bytecode.push
                fi
                return
            fi
            if
                generic.base compiler
                    .state
                    .store
                    .clone_struct Option::Some(owned_struct) is
            then
                List[str]::new = skipped
                bytecode op skipped owned_struct typ compiler.compile_struct_fields
                return
            fi
            if
                generic.base compiler
                    .state
                    .store
                    .clone_enum Option::Some(owned_enum) is
            then
                if owned_enum has_inner_values then
                    bytecode op owned_enum typ compiler.compile_enum_fields
                else
                    InstValue::Drop bytecode.push
                fi
                return
            fi
        fi
        if destruction_type.has_unresolved_type_var then
            destruction_type make_hidden_drop_parameter_name = drop_name
            if drop_name compiler.capture_slots.get_copy Option::Some(capture_index) is then
                capture_index InstValue::CaptureLoad bytecode.push
            else
                drop_name compiler.resolve_variable = drop_variable
                bytecode drop_variable.emit_get
            fi
            InstValue::DynamicDrop bytecode.push
            return
        fi
        InstValue::Drop bytecode.push
    }

    fn destruction_needs_function compiler:mut$BytecodeCompiler typ:$Type -> bool {
        compiler.state.store typ type_needs_destruction_in_store
    }

    fn ensure_destruction_function compiler:mut$BytecodeCompiler typ:$Type op:$Op -> str {
        f"__drop_{typ.format}" = function_name
        if
            function_name compiler
                .state
                .program
                .functions
                .has
        then
            function_name return
        fi
        List[InstValue]::new function_name.clone compiler
            .state
            .program
            .functions
            .set

        List[Op]::new = empty_ops
        empty_location empty_ops function_name.clone Function::new = function
        List[Op]::new = destructor_ops
        destructor_ops function compiler.child = destructor
        List[InstValue]::new = body
        body op typ destructor.compile_destruction_body
        if destructor.has_failed then
            function_name return
        fi

        List[InstValue]::new = function_bytecode
        if 0 destructor.locals_count != then
            destructor.locals_count InstValue::LocalsInit function_bytecode.push
        fi
        body function_bytecode.append
        if 0 destructor.locals_count != then
            destructor.locals_count InstValue::LocalsUninit function_bytecode.push
        fi
        InstValue::FnReturn function_bytecode.push
        function_bytecode function_name.clone compiler
            .state
            .program
            .functions
            .set
        function_name
    }

    fn compile_destruction
        compiler:mut$BytecodeCompiler
        typ:$Type
        op:$Op
        bytecode:mut$List[InstValue]
    {
        if typ compiler.destruction_needs_function ! then
            InstValue::Drop bytecode.push
            return
        fi
        if typ.has_unresolved_type_var then
            bytecode op typ compiler.compile_destruction_body
            return
        fi
        if typ get_array_length_parameter Option::Some(array_length) is then
            if array_length.is_symbolic then
                bytecode op typ compiler.compile_destruction_body
                return
            fi
        fi
        op typ compiler.ensure_destruction_function = function_name
        function_name InstValue::FnCall bytecode.push
    }

    fn compile_match_destruction compiler:mut$BytecodeCompiler op:$Op bytecode:mut$List[InstValue] {
        if op.type_hint Option::None is then
            InstValue::Drop bytecode.push return
        fi
        op
            .type_hint
            .clone
            .unwrap = typ
        if typ compiler.destruction_needs_function ! then
            InstValue::Drop bytecode.push
            return
        fi
        bytecode op typ compiler.compile_drop_hook
        if typ Type::Generic(generic) is then
            if
                generic.base compiler
                    .state
                    .store
                    .clone_struct Option::Some(owned_struct) is
            then
                List[str]::new = skipped
                if op pattern_value_of PatternValue::Struct(struct_pattern) is then
                    struct_pattern.bindings.keys = skipped
                fi
                bytecode op skipped owned_struct typ compiler.compile_struct_fields
                return
            fi
            if
                generic.base compiler
                    .state
                    .store
                    .clone_enum Option::Some(owned_enum) is
            then
                if owned_enum has_inner_values ! then
                    InstValue::Drop bytecode.push return
                fi
                if op pattern_value_of PatternValue::EnumVariant(variant) is then
                    if op pattern_is_wildcard then
                        bytecode op owned_enum typ compiler.compile_enum_fields
                    else
                        variant.bindings.length = skipped_count
                        bytecode op skipped_count variant.variant_name owned_enum typ
                        compiler.compile_enum_variant_fields
                    fi
                    return
                fi
            fi
        fi
        InstValue::Drop bytecode.push
    }

    fn owner_flag compiler:mut$BytecodeCompiler name:$str -> u64 {
        if name compiler.owner_flags.get_copy Option::Some(flag) is then
            flag return
        fi
        compiler.locals_count = flag
        1 += compiler.locals_count
        flag name.clone compiler.owner_flags.set
        flag
    }

    fn set_owner_flag
        compiler:mut$BytecodeCompiler
        name:$str
        value:u64
        bytecode:mut$List[InstValue]
    {
        name compiler.owner_flag = flag
        value (i64) InstValue::Push bytecode.push
        flag InstValue::LocalSet bytecode.push
    }

    fn compile_active_owner_cleanup
        compiler:mut$BytecodeCompiler
        event:$OwnerEvent
        op:$Op
        bytecode:mut$List[InstValue]
    {
        event.name compiler.owner_flag = flag
        compiler.new_label = cleanup_label
        compiler.new_label = end_label
        flag InstValue::LocalGet bytecode.push
        0 InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        cleanup_label InstValue::JumpNe bytecode.push
        end_label InstValue::Jump bytecode.push
        cleanup_label InstValue::Label bytecode.push
        event.name compiler.resolve_variable = resolved
        bytecode resolved.emit_get
        bytecode op event.typ compiler.compile_destruction
        bytecode 0 event.name compiler.set_owner_flag
        end_label InstValue::Label bytecode.push
    }

    fn compile_owner_cleanup
        compiler:mut$BytecodeCompiler
        event:$OwnerEvent
        op:$Op
        bytecode:mut$List[InstValue]
    {
        event.name compiler.owner_flag = flag
        compiler.new_label = end_label
        flag InstValue::LocalGet bytecode.push
        event.generation (i64) InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        end_label InstValue::JumpNe bytecode.push
        event.name compiler.resolve_variable = resolved
        bytecode resolved.emit_get
        bytecode op event.typ compiler.compile_destruction
        bytecode 0 event.name compiler.set_owner_flag
        end_label InstValue::Label bytecode.push
    }

    fn compile_owner_cleanups compiler:mut$BytecodeCompiler op:$Op bytecode:mut$List[InstValue] {
        if
            op op_identity compiler
                .state
                .store
                .clone_ownership Option::Some(owned_ownership) is
        then
            for event in owned_ownership.cleanups.iter do
                bytecode op event compiler.compile_owner_cleanup
            done
        fi
    }
}

# ============================================================================
# Block matching (find_matching_label)
# ============================================================================

fn is_block_start_value op_value:$OpValue -> bool {
    op_value OpValue::IfStart is
    op_value OpValue::WhileStart is ||
    op_value OpValue::MatchStart is ||
}

fn is_block_end_value op_value:$OpValue -> bool {
    op_value OpValue::IfEnd is
    op_value OpValue::WhileEnd is ||
    op_value OpValue::MatchEnd is ||
}
# Search for matching block label respecting nesting. `backward` = true scans
# toward index 0, false scans toward ops.length. `boundary_value` is the
# opening/closing variant at which to give up (end variant going forward,
# start variant going backward).

fn find_matching_identity
    ops:$List[Op]
    op_index:u64
    boundary_value:OpValue
    target_values:List[OpValue]
    backward:bool
-> Option[i64] {
    if backward then -1 else 1 fi = step
    0 step - = neg_step
    1 = depth
    op_index (i64) step + = index
    while
            if backward then
                0 index >=
            else
                index ops.length (i64) >
            fi
    do
        index (u64) ops.get = other_op
        if 1 depth <= then
            if other_op.value target_values op_value_list_contains then
                other_op op_identity = address
                address Option::Some return
            fi
        fi
        if other_op.value is_block_start_value then
            step += depth
        elif other_op.value is_block_end_value then
            neg_step += depth
        fi
        if 1 depth < then
            if boundary_value other_op.value == then
                Option::None return
            fi
        fi
        step += index
    done
    Option::None
}

impl BytecodeCompiler {
    fn find_matching_label
        compiler:mut$BytecodeCompiler
        op_index:u64
        boundary_value:OpValue
        target_values:List[OpValue]
        backward:bool
    -> Option[u64] {
        backward target_values boundary_value op_index compiler.ops find_matching_identity
        = identity
        if identity Option::Some(address) is then
            address compiler.state.op_identity_to_label Option::Some return
        fi
        Option::None
    }
}

fn op_value_list_contains items:$List[OpValue] value:$OpValue -> bool {
    for item in items.iter do
        if value item == then
            true return
        fi
    done
    false
}
# find_matching_label needs a sentinel value in target_values, but
# OpValue::MatchArm carries a payload that cannot be constructed bare for
# tag-only equality. This forward scan tracks depth and returns the label
# of the next OpMatchArm or None on OpMatchEnd at depth 0.

fn find_next_match_arm_or_end_identity ops:$List[Op] op_index:u64 -> Option[i64] {
    1 = depth
    op_index 1 + = index
    while index ops.length > do
        index ops.get = other_op
        if 1 depth <= then
            if other_op.value OpValue::MatchArm is then
                other_op op_identity = address
                address Option::Some return
            fi
        fi
        if other_op.value is_block_start_value then
            1 += depth
        elif other_op.value is_block_end_value then
            -1 += depth
        fi
        if 1 depth < then
            if other_op.value OpValue::MatchEnd is then
                Option::None return
            fi
        fi
        1 += index
    done
    Option::None
}

impl BytecodeCompiler {
    fn find_next_match_arm_or_end self:mut$BytecodeCompiler op_index:u64 -> Option[u64] {
        op_index self.ops find_next_match_arm_or_end_identity = identity
        if identity Option::Some(address) is then
            address self.state.op_identity_to_label Option::Some return
        fi
        Option::None
    }
}

impl BytecodeCompiler {
    fn require_matching
        compiler:mut$BytecodeCompiler
        op_index:u64
        boundary_value:OpValue
        target_values:List[OpValue]
        message:str
        backward:bool
    -> u64 {
        backward target_values boundary_value op_index compiler.find_matching_label = result
        if result Option::Some(label) is then
            label return
        fi
        message compiler.record_failure
        0
    }
}

# ============================================================================
# Compile assignment
# ============================================================================

impl OpValue {
    fn produces_integer_result self:$OpValue -> bool {
        self match
            OpValue::Add => true
            OpValue::Sub => true
            OpValue::Mul => true
            OpValue::Div => true
            OpValue::Mod => true
            OpValue::Shl => true
            OpValue::Shr => true
            OpValue::BitAnd => true
            OpValue::BitOr => true
            OpValue::BitXor => true
            OpValue::BitNot => true
            OpValue::AssignInc => true
            OpValue::AssignDec => true
            OpValue::WrappingAdd => true
            OpValue::WrappingSub => true
            OpValue::WrappingMul => true
            _ => false
        end
    }

    fn select_typed_instruction self:$OpValue direct:InstValue builtin:$BuiltinType -> InstValue {
        if builtin.is_float then
            if builtin BuiltinType::F32 == then
                self match
                    OpValue::Add => InstValue::FloatAdd32
                    OpValue::Sub => InstValue::FloatSub32
                    OpValue::Mul => InstValue::FloatMul32
                    OpValue::Div => InstValue::FloatDiv32
                    OpValue::Eq => InstValue::FloatEq32
                    OpValue::Ne => InstValue::FloatNe32
                    OpValue::Lt => InstValue::FloatLt32
                    OpValue::Le => InstValue::FloatLe32
                    OpValue::Gt => InstValue::FloatGt32
                    OpValue::Ge => InstValue::FloatGe32
                    _ => direct
                end
            else
                self match
                    OpValue::Add => InstValue::FloatAdd64
                    OpValue::Sub => InstValue::FloatSub64
                    OpValue::Mul => InstValue::FloatMul64
                    OpValue::Div => InstValue::FloatDiv64
                    OpValue::Eq => InstValue::FloatEq64
                    OpValue::Ne => InstValue::FloatNe64
                    OpValue::Lt => InstValue::FloatLt64
                    OpValue::Le => InstValue::FloatLe64
                    OpValue::Gt => InstValue::FloatGt64
                    OpValue::Ge => InstValue::FloatGe64
                    _ => direct
                end
            fi
            return
        fi
        self match
            OpValue::Add => {
                builtin copy (i64) (BuiltinType) InstValue::CheckedAdd return
            }
            OpValue::Sub => {
                builtin copy (i64) (BuiltinType) InstValue::CheckedSub return
            }
            OpValue::Mul => {
                builtin copy (i64) (BuiltinType) InstValue::CheckedMul return
            }
            OpValue::Div => {
                builtin copy (i64) (BuiltinType) InstValue::CheckedDiv return
            }
            OpValue::Mod => {
                builtin copy (i64) (BuiltinType) InstValue::CheckedMod return
            }
            OpValue::Shl => {
                builtin copy (i64) (BuiltinType) InstValue::CheckedShl return
            }
            OpValue::Shr => {
                builtin copy (i64) (BuiltinType) InstValue::CheckedShr return
            }
            _ => {
            }
        end
        if builtin.is_unsigned ! then
            direct return
        fi
        self match
            OpValue::Div => InstValue::UDiv
            OpValue::Mod => InstValue::UMod
            OpValue::Shr => InstValue::UShr
            OpValue::Lt => InstValue::Ult
            OpValue::Le => InstValue::Ule
            OpValue::Gt => InstValue::Ugt
            OpValue::Ge => InstValue::Uge
            OpValue::PrintInt => InstValue::PrintUint
            _ => direct
        end
    }
}

impl BytecodeCompiler {
    fn emit_integer_normalization
        compiler:mut$BytecodeCompiler
        op:$Op
        bytecode:mut$List[InstValue]
    {
        if op.value.produces_integer_result ! then
            return
        fi
        if op.type_hint Option::Some(type_hint) is then
            if type_hint Type::Builtin(builtin) is then
                if builtin.is_integer ! then
                    return
                fi
                builtin InstValue::NormalizeInt bytecode.push
            fi
        fi
    }

    fn compile_assignment compiler:mut$BytecodeCompiler op:$Op bytecode:mut$List[InstValue] {
        op op_str_value = name
        if name compiler.capture_slots.get_copy Option::Some(capture_index) is then
            false = owns_capture
            TYPE_UNKNOWN_T clone_type = capture_type
            if compiler.function Option::Some(function) is then
                name function.owned_captures string_list_contains = owns_capture
                capture_index function.captures.get Variable::typ clone_type = capture_type
            fi
            if op.value OpValue::AssignVar is then
                if owns_capture then
                    compiler.new_label = inactive_label
                    capture_index InstValue::CaptureFlagLoad bytecode.push
                    0 InstValue::Push bytecode.push
                    InstValue::Ne bytecode.push
                    inactive_label InstValue::JumpNe bytecode.push
                    capture_index InstValue::CaptureLoad bytecode.push
                    bytecode op capture_type compiler.compile_destruction
                    inactive_label InstValue::Label bytecode.push
                fi
                capture_index InstValue::CaptureSet bytecode.push
                if owns_capture then
                    capture_index InstValue::CaptureFlagMark bytecode.push
                fi
                return
            fi
            capture_index InstValue::CaptureLoad bytecode.push
            if op.value OpValue::AssignDec is then
                InstValue::Swap bytecode.push
                InstValue::Sub bytecode.push
            elif op.value OpValue::AssignInc is then
                InstValue::Add bytecode.push
            else
                "compile_assignment received an unsupported capture assignment" compiler.record_failure
                return
            fi
            bytecode op compiler.emit_integer_normalization
            capture_index InstValue::CaptureSet bytecode.push
            return
        fi
        name compiler.resolve_variable = resolved

        op.value match
            OpValue::AssignDec => {
                bytecode resolved.emit_get
                InstValue::Swap bytecode.push
                InstValue::Sub = instruction
                if op.type_hint Option::Some(type_hint) is then
                    if type_hint Type::Builtin(builtin) is then
                        builtin InstValue::CheckedSub = instruction
                    fi
                fi
                instruction bytecode.push
                bytecode op compiler.emit_integer_normalization
                bytecode resolved.emit_set
            }
            OpValue::AssignInc => {
                bytecode resolved.emit_get
                InstValue::Add = instruction
                if op.type_hint Option::Some(type_hint) is then
                    if type_hint Type::Builtin(builtin) is then
                        builtin InstValue::CheckedAdd = instruction
                    fi
                fi
                instruction bytecode.push
                bytecode op compiler.emit_integer_normalization
                bytecode resolved.emit_set
            }
            OpValue::AssignVar => bytecode resolved.emit_set
            OpValue::Question(_) => bytecode resolved.emit_set
            _ => {
                "compile_assignment received a non-assignment operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile if block
# ============================================================================

impl BytecodeCompiler {
    fn compile_if_block
        compiler:mut$BytecodeCompiler
        op:$Op
        op_index:u64
        bytecode:mut$List[InstValue]
    {
        List[OpValue]::new = start_targets
        OpValue::IfStart start_targets.push

        List[OpValue]::new = elif_else_end
        OpValue::IfElif elif_else_end.push
        OpValue::IfElse elif_else_end.push
        OpValue::IfEnd elif_else_end.push

        List[OpValue]::new = end_targets
        OpValue::IfEnd end_targets.push

        List[OpValue]::new = else_targets
        OpValue::IfElse else_targets.push

        op.value match
            OpValue::IfCondition => {
                true "`then` without matching `if`" start_targets OpValue::IfStart op_index compiler.require_matching drop
                false "`then` without matching `fi`" elif_else_end OpValue::IfEnd op_index compiler.require_matching = end_label
                end_label InstValue::JumpNe bytecode.push
            }
            OpValue::IfElif => {
                true "`elif` without parent `if`" start_targets OpValue::IfStart op_index compiler.require_matching drop
                op_index compiler.ops.get compiler.op_to_label = elif_label
                false "`elif` without matching `fi`" end_targets OpValue::IfEnd op_index compiler.require_matching = end_label_2
                bytecode op compiler.compile_owner_cleanups
                end_label_2 InstValue::Jump bytecode.push
                elif_label InstValue::Label bytecode.push
                bytecode op compiler.compile_owner_cleanups
            }
            OpValue::IfElse => {
                true "`else` without parent `if`" start_targets OpValue::IfStart op_index compiler.require_matching drop
                op_index compiler.ops.get compiler.op_to_label = else_label
                false "`else` without matching `fi`" end_targets OpValue::IfEnd op_index compiler.require_matching = end_label_3
                bytecode op compiler.compile_owner_cleanups
                end_label_3 InstValue::Jump bytecode.push
                else_label InstValue::Label bytecode.push
                bytecode op compiler.compile_owner_cleanups
            }
            OpValue::IfEnd => {
                true "`fi` without parent `if`" start_targets OpValue::IfStart op_index compiler.require_matching drop
                op_index compiler.ops.get compiler.op_to_label = fi_label
                bytecode op compiler.compile_owner_cleanups
                fi_label InstValue::Label bytecode.push
                bytecode op compiler.compile_owner_cleanups
            }
            OpValue::IfStart => false "`if` without matching `fi`" end_targets OpValue::IfEnd op_index compiler.require_matching drop
            _ => {
                "compile_if_block received a non-if operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile while block
# ============================================================================

impl BytecodeCompiler {
    fn compile_while_block
        compiler:mut$BytecodeCompiler
        op:$Op
        op_index:u64
        bytecode:mut$List[InstValue]
    {
        List[OpValue]::new = start_targets
        OpValue::WhileStart start_targets.push

        List[OpValue]::new = end_targets
        OpValue::WhileEnd end_targets.push

        op.value match
            OpValue::WhileBreak => {
                true "`break` without parent `while`" start_targets OpValue::WhileStart op_index compiler.require_matching drop
                false "`break` without matching `done`" end_targets OpValue::WhileEnd op_index compiler.require_matching = end_label
                end_label InstValue::Jump bytecode.push
            }
            OpValue::WhileCondition => {
                true "`do` without parent `while`" start_targets OpValue::WhileStart op_index compiler.require_matching drop
                false "`do` without matching `done`" end_targets OpValue::WhileEnd op_index compiler.require_matching = end_label_2
                end_label_2 InstValue::JumpNe bytecode.push
            }
            OpValue::WhileContinue => {
                true "`continue` without parent `while`" start_targets OpValue::WhileStart op_index compiler.require_matching = continue_target
                continue_target InstValue::Jump bytecode.push
            }
            OpValue::WhileEnd => {
                op_index compiler.ops.get compiler.op_to_label = while_label
                true "`done` without parent `while`" start_targets OpValue::WhileStart op_index compiler.require_matching = loop_start
                bytecode op compiler.compile_owner_cleanups
                loop_start InstValue::Jump bytecode.push
                while_label InstValue::Label bytecode.push
                bytecode op compiler.compile_owner_cleanups
            }
            OpValue::WhileStart => {
                op_index compiler.ops.get compiler.op_to_label = start_label
                start_label InstValue::Label bytecode.push
            }
            _ => {
                "compile_while_block received a non-while operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile match block
# ============================================================================
# compile_match_op — per-arm bytecode entry point dispatching on PatternValue.
# Replaces the three former compile_match_arm_* helpers and consolidates
# literal / enum / struct emission behind a single pattern-driven function.

impl BytecodeCompiler {
    fn emit_struct_arm
        compiler:mut$BytecodeCompiler
        struct_pattern:StructPattern
        bytecode:mut$List[InstValue]
    {
        struct_pattern StructPattern::struct_name compiler
            .state
            .store
            .clone_struct = casa_struct_opt
        if casa_struct_opt.is_none then
            f"Struct `{struct_pattern.struct_name}` is missing during bytecode compilation" compiler.record_failure
            return
        fi
        casa_struct_opt.unwrap = casa_struct
        0 (u64) = index
        while index casa_struct CasaStruct::members.length > do
            index casa_struct CasaStruct::members.get = member
            member Member::name = field_name: $str
            index casa_struct compiler.struct_offset = offset
            if field_name struct_pattern StructPattern::bindings.get Option::Some(var_name) is then
                InstValue::Dup bytecode.push
                if 0 offset > then
                    offset (i64) InstValue::Push bytecode.push
                    InstValue::Add bytecode.push
                fi
                bytecode member.typ compiler.aggregate_field_load
                var_name compiler.resolve_variable = resolved
                bytecode resolved.emit_set
            fi
            1 += index
        done
    }
}

fn emit_int_eq value:$i64 bytecode:mut$List[InstValue] {
    value copy InstValue::Push bytecode.push
    InstValue::Eq bytecode.push
}

fn require_variant_ordinal variant:$EnumVariant compiler:mut$BytecodeCompiler -> i64 {
    if variant.ordinal Option::Some(ordinal) is then
        ordinal return
    fi
    f"Enum variant `{variant.variant_name}` has no ordinal during bytecode compilation" compiler.record_failure
    0
}

impl BytecodeCompiler {
    fn emit_literal_arm
        compiler:mut$BytecodeCompiler
        literal_pattern:LiteralPattern
        is_last:bool
        next_arm:mut$Option[u64]
        bytecode:mut$List[InstValue]
    {
        if is_last then
            return
        fi
        InstValue::Dup bytecode.push
        literal_pattern.value match
            LiteralValue::Str(str_value) => {
                str_value compiler.intern_string = str_index
                str_index InstValue::PushStr bytecode.push
                InstValue::StrEq bytecode.push
            }
            LiteralValue::Int(int_value) => {
                bytecode int_value.value emit_int_eq
            }
            LiteralValue::Char(char_value) => {
                bytecode char_value emit_int_eq
            }
            LiteralValue::Bool(bool_value) => {
                bytecode bool_value (i64) emit_int_eq
            }
        end
        if next_arm Option::Some(label) is then
            label InstValue::JumpNe bytecode.push
        else
            "Match arm has no following label during bytecode compilation" compiler.record_failure
        fi
    }
}

impl BytecodeCompiler {
    fn emit_enum_arm
        compiler:mut$BytecodeCompiler
        variant:$EnumVariant
        is_wildcard:bool
        is_last:bool
        next_arm:mut$Option[u64]
        bytecode:mut$List[InstValue]
    {
        if is_wildcard then
            return
        fi
        variant.enum_name = enum_name: $str
        if
            "" enum_name != enum_name compiler
                .state
                .store
                .enums
                .has &&
        then
            enum_name compiler
                .state
                .store
                .enums
                .get
                .unwrap
                .clone = casa_enum
            if casa_enum has_inner_values then
                if is_last ! then
                    InstValue::Dup bytecode.push
                    InstValue::Load64 bytecode.push
                    compiler variant require_variant_ordinal InstValue::Push bytecode.push
                    InstValue::Eq bytecode.push
                    if next_arm Option::Some(label) is then
                        label InstValue::JumpNe bytecode.push
                    else
                        "Match arm has no following label during bytecode compilation" compiler.record_failure
                    fi
                fi
                casa_enum variant bytecode compiler.emit_enum_arm_bindings
                return
            fi
        fi

        if is_last then
            return
        fi
        InstValue::Dup bytecode.push
        compiler variant require_variant_ordinal InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        if next_arm Option::Some(label) is then
            label InstValue::JumpNe bytecode.push
        else
            "Match arm has no following label during bytecode compilation" compiler.record_failure
        fi
    }
}

impl BytecodeCompiler {
    fn emit_enum_arm_bindings
        compiler:mut$BytecodeCompiler
        bytecode:mut$List[InstValue]
        variant:$EnumVariant
        casa_enum:$CasaEnum
    {
        variant.variant_name casa_enum
            .variant_types
            .get
            .unwrap = payload_types
        0 (u64) = index
        while index variant EnumVariant::bindings.length > do
            index variant.variant_name casa_enum compiler.enum_offset = offset
            InstValue::Dup bytecode.push
            offset (i64) InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            bytecode index payload_types.get compiler.aggregate_field_load
            index variant EnumVariant::bindings.get = var_name
            var_name compiler.resolve_variable = resolved
            bytecode resolved.emit_set
            1 += index
        done
    }
}

impl BytecodeCompiler {
    fn compile_match_op
        compiler:mut$BytecodeCompiler
        op:$Op
        is_last:bool
        next_arm:mut$Option[u64]
        bytecode:mut$List[InstValue]
    {
        op pattern_value_of match
            PatternValue::Struct(struct_pattern) => {
                bytecode struct_pattern compiler.emit_struct_arm
            }
            PatternValue::Literal(literal_pattern) => {
                bytecode next_arm is_last literal_pattern compiler.emit_literal_arm
            }
            PatternValue::EnumVariant(variant) => {
                op pattern_is_wildcard = is_wildcard
                bytecode next_arm is_last is_wildcard variant compiler.emit_enum_arm
            }
        end
        if op.value OpValue::MatchArm(arm) is then
            if arm.guard_ops.length 0 != then
                0 (u64) = guard_index
                while guard_index arm.guard_ops.length > do
                    guard_index arm.guard_ops.get = guard_op
                    bytecode guard_index guard_op compiler.compile_op
                    1 += guard_index
                done
                if next_arm Option::Some(label) is then
                    label InstValue::JumpNe bytecode.push
                else
                    "Guarded match arm has no following label during bytecode compilation" compiler.record_failure
                fi
            fi
        fi
        if
            op op_identity compiler
                .state
                .store
                .clone_ownership Option::Some(owned_ownership) is
        then
            for event in owned_ownership.assignments.iter do
                bytecode event.generation event.name.clone compiler.set_owner_flag
            done
        fi
        bytecode op compiler.compile_match_destruction
    }
}

impl BytecodeCompiler {
    fn compile_match_block
        compiler:mut$BytecodeCompiler
        op:$Op
        op_index:u64
        bytecode:mut$List[InstValue]
    {
        if op.value OpValue::MatchArm is then
            List[OpValue]::new = end_targets
            OpValue::MatchEnd end_targets.push

            false "`match` arm without matching `end`" end_targets OpValue::MatchEnd op_index compiler.require_matching = end_label

            op_index compiler.ops.get op_identity compiler
                .state
                .op_label_map
                .get_copy = existing
            existing.is_some ! = is_first

            if is_first ! then
                bytecode op compiler.compile_owner_cleanups
                end_label InstValue::Jump bytecode.push
                if existing Option::Some(label) is then
                    label InstValue::Label bytecode.push
                    bytecode op compiler.compile_owner_cleanups
                else
                    "Match arm label is missing during bytecode compilation" compiler.record_failure
                fi
            fi

            op_index compiler.find_next_match_arm_or_end = next_arm
            next_arm.is_none = is_last

            bytecode next_arm is_last op compiler.compile_match_op
        elif op.value OpValue::MatchEnd is then
            op_index compiler.ops.get compiler.op_to_label = end_match_label
            bytecode op compiler.compile_owner_cleanups
            end_match_label InstValue::Label bytecode.push
            bytecode op compiler.compile_owner_cleanups
        fi
    }
}

# ============================================================================
# Compile struct new
# ============================================================================

impl BytecodeCompiler {
    fn compile_struct_new compiler:mut$BytecodeCompiler op:$Op bytecode:mut$List[InstValue] {
        if op.value OpValue::StructNew(casa_struct) is then
            casa_struct CasaStruct::members.length = count
            casa_struct compiler.struct_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::HeapAlloc bytecode.push
            0 (u64) = index
            while index count > do
                InstValue::Swap bytecode.push
                InstValue::Over bytecode.push
                index casa_struct compiler.struct_offset = offset
                if 0 offset > then
                    offset i64::try_from.unwrap InstValue::Push bytecode.push
                    InstValue::Add bytecode.push
                fi
                index casa_struct.members.get = member
                bytecode member.typ compiler.aggregate_field_store
                1 += index
            done
        fi
    }
}

# ============================================================================
# Compile enum variant
# ============================================================================

impl BytecodeCompiler {
    fn compile_enum_variant
        compiler:mut$BytecodeCompiler
        variant:$EnumVariant
        casa_enum:$CasaEnum
        bytecode:mut$List[InstValue]
    {
        variant.variant_name.clone = variant_name
        variant_name casa_enum CasaEnum::variant_types.get = types_opt
        List[Type]::new = types
        0 (u64) = inner_count
        if types_opt Option::Some(found_types) is then
            for found_type in found_types.iter do
                found_type clone_type types.push
            done
            types.length = inner_count
        fi
        # Store inner values from stack into temp locals
        List[u64]::new = temps
        0 (u64) = index
        while index inner_count > do
            compiler.locals_count = local_index
            1 += compiler.locals_count
            local_index temps.push
            local_index InstValue::LocalSet bytecode.push
            1 += index
        done

        # Allocate heap
        compiler.locals_count = ptr_local
        1 += compiler.locals_count
        casa_enum compiler.enum_size i64::try_from.unwrap InstValue::Push bytecode.push
        InstValue::HeapAlloc bytecode.push
        ptr_local InstValue::LocalSet bytecode.push

        # Store ordinal at offset 0
        compiler variant require_variant_ordinal InstValue::Push bytecode.push
        ptr_local InstValue::LocalGet bytecode.push
        InstValue::Store64 bytecode.push

        # Store inner values at their padded payload offsets.
        # Reversed temp_locals
        0 (u64) = inner_index
        while inner_index inner_count > do
            inner_count 1 - inner_index - = reverse_index
            inner_index variant_name casa_enum compiler.enum_offset = offset
            ptr_local InstValue::LocalGet bytecode.push
            offset (i64) InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            reverse_index temps.get copy = temp_local
            temp_local InstValue::LocalGet bytecode.push
            InstValue::Swap bytecode.push
            bytecode inner_index types.get compiler.aggregate_field_store
            1 += inner_index
        done

        # Push pointer
        ptr_local InstValue::LocalGet bytecode.push
    }
}

# ============================================================================
# Compile is check
# ============================================================================

impl BytecodeCompiler {
    fn compile_is_check compiler:mut$BytecodeCompiler op:$Op bytecode:mut$List[InstValue] {
        if op.value OpValue::IsCheck(variant) is then
            variant.enum_name.clone = enum_name
            enum_name compiler
                .state
                .store
                .clone_enum = casa_enum_opt
            if casa_enum_opt.is_none then
                f"Enum `{enum_name}` is missing during bytecode compilation" compiler.record_failure
                return
            fi
            casa_enum_opt.unwrap = casa_enum

            if casa_enum has_inner_values ! then
                # Plain enum: compare ordinal directly
                compiler variant require_variant_ordinal InstValue::Push bytecode.push
                InstValue::Eq bytecode.push
                return
            fi

            if 0 variant EnumVariant::bindings.length == then
                # Data-carrying enum, no bindings: load ordinal and compare
                InstValue::Load64 bytecode.push
                compiler variant require_variant_ordinal InstValue::Push bytecode.push
                InstValue::Eq bytecode.push
                return
            fi

            # Data-carrying enum with bindings
            compiler.locals_count = temp_ptr
            1 += compiler.locals_count

            compiler.new_label = skip_bindings

            # Save enum pointer
            temp_ptr InstValue::LocalSet bytecode.push

            # Load ordinal and compare
            temp_ptr InstValue::LocalGet bytecode.push
            InstValue::Load64 bytecode.push
            compiler variant require_variant_ordinal InstValue::Push bytecode.push
            InstValue::Eq bytecode.push

            # Duplicate bool
            InstValue::Dup bytecode.push
            skip_bindings InstValue::JumpNe bytecode.push

            # Extract bindings
            variant.variant_name casa_enum
                .variant_types
                .get
                .unwrap = payload_types
            0 (u64) = index
            while index variant EnumVariant::bindings.length > do
                index variant.variant_name casa_enum compiler.enum_offset = offset
                temp_ptr InstValue::LocalGet bytecode.push
                offset (i64) InstValue::Push bytecode.push
                InstValue::Add bytecode.push
                bytecode index payload_types.get compiler.aggregate_field_load
                index variant EnumVariant::bindings.get = var_name
                var_name compiler.resolve_variable = resolved
                bytecode resolved.emit_set
                1 += index
            done

            skip_bindings InstValue::Label bytecode.push
        fi
    }
}

# ============================================================================
# Compile struct literal
# ============================================================================

impl BytecodeCompiler {
    fn compile_struct_literal compiler:mut$BytecodeCompiler op:$Op bytecode:mut$List[InstValue] {
        if op.value OpValue::StructLiteral(literal) is then
            literal.struct_name compiler
                .state
                .store
                .clone_struct = casa_struct_opt
            if casa_struct_opt.is_none then
                f"Struct `{literal.struct_name}` is missing during bytecode compilation" compiler.record_failure
                return
            fi
            casa_struct_opt.unwrap = casa_struct
            casa_struct CasaStruct::members.length = count

            # Store all field values into temp locals (top of stack = last in field_order)
            # Iterate field_order in reverse
            literal StructLiteral::field_order.length = field_index
            Map[str u64]::new = temp_locals
            while 0 field_index != do
                1 -= field_index
                compiler.locals_count = local_index
                1 += compiler.locals_count
                field_index literal StructLiteral::field_order.get = field_name
                local_index field_name.clone temp_locals.set
                local_index InstValue::LocalSet bytecode.push
            done

            # Allocate struct on heap
            casa_struct compiler.struct_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::HeapAlloc bytecode.push

            # Store each field at its correct offset
            0 (u64) = member_index
            while member_index casa_struct CasaStruct::members.length > do
                member_index casa_struct CasaStruct::members.get = member
                member Member::name = member_name: $str
                member_index casa_struct compiler.struct_offset = member_offset
                InstValue::Dup bytecode.push
                if 0 member_offset > then
                    member_offset (i64) InstValue::Push bytecode.push
                    InstValue::Add bytecode.push
                fi
                if member_name temp_locals.get_copy Option::Some(temp_local) is then
                    temp_local copy InstValue::LocalGet bytecode.push
                else
                    f"Struct literal field `{member_name}` has no temporary local during bytecode compilation" compiler.record_failure
                    return
                fi
                InstValue::Swap bytecode.push
                bytecode member.typ compiler.aggregate_field_store
                1 += member_index
            done
        fi
    }
}

# ============================================================================
# Compile push array
# ============================================================================

fn sanitize_fn_name name:$str -> str {
    name "::" str::split = parts
    "__" parts.join
}

impl BytecodeCompiler {
    fn compile_static_array_fns compiler:mut$BytecodeCompiler items:$List[Op] {
        for item in items.iter do
            if item Op::value OpValue::FnPush(fn_name) is then
                fn_name compiler
                    .state
                    .store
                    .functions
                    .get = csa_fn_opt
                if csa_fn_opt Option::Some(csa_fn) is then
                    item csa_fn compiler.compile_function
                else
                    f"Function `{fn_name}` is missing during bytecode compilation" compiler.record_failure
                fi
            fi
        done
    }
}

impl BytecodeCompiler {
    fn compile_static_element compiler:mut$BytecodeCompiler op:$Op -> StaticArrayElement {
        op Op::value match
            OpValue::PushInt(val) => {
                val.value StaticArrayElement::Imm return
            }
            OpValue::PushStr(val) => {
                val compiler.intern_string = str_idx f"str_{str_idx}" StaticArrayElement::Label return
            }
            OpValue::PushBool(val) => {
                val StaticArrayElement::Imm return
            }
            OpValue::PushChar(val) => {
                val StaticArrayElement::Imm return
            }
            OpValue::PushEnumVariant(ev) => {
                compiler ev require_variant_ordinal StaticArrayElement::Imm return
            }
            OpValue::FnPush(fn_name) => {
                fn_name sanitize_fn_name = sanitized_fn
                f"closure_{sanitized_fn}" StaticArrayElement::Label return
            }
            _ => {
                "compile_static_element received a non-static operation" compiler.record_failure
                0 StaticArrayElement::Imm return
            }
        end
        0 StaticArrayElement::Imm
    }
}

impl BytecodeCompiler {
    fn compile_static_struct self:mut$BytecodeCompiler group_ops:$List[Op] -> str {
        if 0 group_ops.length == then
            "Static struct expression group is empty during bytecode compilation" self.record_failure
            "" return
        fi
        group_ops.length 1 - group_ops.get Op::value = last_val: $OpValue
        "" = static_struct_label
        if last_val OpValue::StructLiteral(literal) is then
            literal.struct_name.clone = struct_name
            literal StructLiteral::field_order = field_order: $List[str]
            struct_name self
                .state
                .store
                .clone_struct = casa_struct_opt
            if casa_struct_opt.is_none then
                f"Struct `{struct_name}` is missing during bytecode compilation" self.record_failure
                "" return
            fi
            casa_struct_opt.unwrap = casa_struct

            List[StaticArrayElement]::new = ordered_elems
            0 (u64) = i
            while i field_order.length > do
                i group_ops.get self.compile_static_element ordered_elems.push
                1 += i
            done

            # Reorder to match struct member definition order
            List[StaticArrayElement]::new = fields
            0 (u64) = mi
            while mi casa_struct CasaStruct::members.length > do
                mi casa_struct CasaStruct::members.get Member::name = member_name: $str
                member_name field_order string_list_index = fo_idx
                if 0 fo_idx < then
                    f"Static struct field `{member_name}` is missing during bytecode compilation" self.record_failure
                    "" return
                fi
                fo_idx (u64) ordered_elems.get.clone fields.push
                1 += mi
            done

            self
                .state
                .program
                .static_structs
                .length = struct_index
            fields StaticStruct self
                .state
                .program
                .static_structs
                .push
            f"static_struct_{struct_index}" = static_struct_label
        else
            "compile_static_struct received a non-struct expression group" self.record_failure
        fi
        static_struct_label
    }
}

impl BytecodeCompiler {
    fn compile_static_array
        compiler:mut$BytecodeCompiler
        items:$List[Op]
        bytecode:mut$List[InstValue]
    {
        items compiler.compile_static_array_fns
        List[StaticArrayElement]::new = elements
        for item in items.iter do
            item Op::value match
                OpValue::PushArray(inner_items) => {
                    List[InstValue]::new = discard_bytecode
                    discard_bytecode inner_items compiler.compile_static_array
                    compiler
                        .state
                        .program
                        .static_arrays
                        .length 1 - = inner_idx
                    f"static_array_{inner_idx}" StaticArrayElement::Label elements.push
                }
                OpValue::ExprGroup(group_ops) => {
                    group_ops compiler.compile_static_struct = struct_label
                    struct_label StaticArrayElement::Label elements.push
                }
                _ => {
                    item compiler.compile_static_element elements.push
                }
            end
        done
        compiler
            .state
            .program
            .static_arrays
            .length = array_index
        elements StaticArray compiler
            .state
            .program
            .static_arrays
            .push
        array_index InstValue::PushStaticArray bytecode.push
    }
}

impl BytecodeCompiler {
    fn static_array_element_is_word self:$BytecodeCompiler element_type:$Type -> bool {
        if self.state.store element_type type_inline_size Option::Some(element_size) is then
            if self.state.store element_type type_value_representation Option::Some(representation) is then
                WORD_SIZE element_size ==
                VALUE_REPR_RAW representation ==
                VALUE_REPR_SIGNED representation == || &&
                return
            fi
        fi
        false
    }

    fn can_emit_static_array self:$BytecodeCompiler op:$Op items:$List[Op] -> bool {
        if items.is_empty self.state.store items op_is_static_array_with_store ! || then
            false return
        fi
        if op.type_hint Option::Some(array_type) is then
            if array_type.array_element_type Option::Some(element_type) is then
                element_type resolve_numeric_literal_default = resolved_type
                resolved_type self.static_array_element_is_word return
            fi
            false return
        fi
        # Compiler unit tests may build an already-word-sized static array op
        # directly without running the typechecker.
        true
    }

    fn compile_push_array compiler:mut$BytecodeCompiler op:$Op bytecode:mut$List[InstValue] {
        if op.value OpValue::PushArray(items) is then
            items.length = length

            items op compiler.can_emit_static_array = can_emit_static
            if can_emit_static then
                bytecode items compiler.compile_static_array return
            fi

            TYPE_UNKNOWN_T clone_type = element_type
            if op.type_hint Option::Some(array_type) is then
                if array_type.array_element_type Option::Some(found_element_type) is then
                    found_element_type resolve_numeric_literal_default = element_type
                else
                    "Array literal has no element type during bytecode compilation"
                    compiler.record_failure return
                fi
            else
                "Array literal has no type during bytecode compilation" compiler.record_failure return
            fi

            # Compile items in reverse order
            length = reverse_index
            while 0 reverse_index != do
                1 -= reverse_index
                reverse_index items.get = item
                bytecode reverse_index item compiler.compile_op
            done

            # An array stores only its elements (ADR-0152), so the allocation
            # is exactly the element storage.
            compiler.locals_count = list_local
            1 += compiler.locals_count
            compiler.state.store element_type type_inline_size.unwrap = element_size
            element_size length get_array_storage_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::HeapAlloc bytecode.push
            list_local InstValue::LocalSet bytecode.push

            # Store elements starting at offset 0
            compiler.locals_count = index_local
            1 += compiler.locals_count
            0 InstValue::Push bytecode.push
            index_local InstValue::LocalSet bytecode.push

            compiler.new_label = start_label
            compiler.new_label = end_label

            # while index limit > do
            start_label InstValue::Label bytecode.push
            index_local InstValue::LocalGet bytecode.push
            length element_size * i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Gt bytecode.push
            end_label InstValue::JumpNe bytecode.push

            # list index + typed store
            list_local InstValue::LocalGet bytecode.push
            index_local InstValue::LocalGet bytecode.push
            InstValue::Add bytecode.push
            bytecode element_type compiler.emit_typed_store

            # element_size += index
            index_local InstValue::LocalGet bytecode.push
            element_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            index_local InstValue::LocalSet bytecode.push

            # done
            start_label InstValue::Jump bytecode.push
            end_label InstValue::Label bytecode.push

            # Push array pointer
            list_local InstValue::LocalGet bytecode.push
        fi
    }
}

# ============================================================================
# Compile function call
# ============================================================================

impl BytecodeCompiler {
    fn compile_named_function compiler:mut$BytecodeCompiler name:$str op:$Op -> bool {
        if
            name compiler
                .state
                .program
                .functions
                .has
        then
            true return
        fi
        name compiler
            .state
            .store
            .clone_function match
            Option::Some(function) => {
                op function compiler.compile_function
                compiler.has_failed !
            }
            Option::None => {
                f"Function `{name}` is missing during bytecode compilation" compiler.record_failure
                false
            }
        end
    }

    fn compile_function compiler:mut$BytecodeCompiler function:$Function op:$Op {
        # Compile a function if not already compiled.
        if
            function Function::name compiler
                .state
                .program
                .functions
                .has
        then
            return
        fi
        # Mark as being compiled to prevent infinite recursion on recursive calls
        List[InstValue]::new = function_bytecode
        List[InstValue]::new function Function::name.clone compiler
            .state
            .program
            .functions
            .set
        function.ops function compiler.child = function_compiler
        function_bytecode function_compiler.compile_ops
        if function_compiler.has_failed then
            return
        fi

        # Handle locals
        function_compiler.locals_count = locals_count
        if locals_count 0 < then
            # Build new list with LOCALS_INIT at front
            List[InstValue]::new = final_bytecode
            locals_count InstValue::LocalsInit final_bytecode.push

            function_bytecode.reverse
            while function_bytecode.is_empty ! do
                function_bytecode.pop = instruction
                if instruction InstValue::FnReturn is then
                    locals_count InstValue::LocalsUninit final_bytecode.push
                fi
                instruction final_bytecode.push
            done
            locals_count InstValue::LocalsUninit final_bytecode.push
            InstValue::FnReturn final_bytecode.push
            final_bytecode = function_bytecode
        else
            InstValue::FnReturn function_bytecode.push
        fi

        function_bytecode function Function::name.clone compiler
            .state
            .program
            .functions
            .set
    }
}

impl BytecodeCompiler {
    fn ensure_closure_destruction_function
        compiler:mut$BytecodeCompiler
        lambda:$Function
        op:$Op
    -> str {
        f"__drop_closure_{lambda.name}" = drop_name
        if
            drop_name compiler
                .state
                .program
                .functions
                .has
        then
            drop_name return
        fi
        List[InstValue]::new drop_name.clone compiler
            .state
            .program
            .functions
            .set

        List[InstValue]::new = body
        lambda.ops lambda compiler.child = destructor
        0 (u64) = capture_index
        while capture_index lambda.captures.length > do
            capture_index lambda.captures.get = capture
            if capture.name lambda.owned_captures string_list_contains then
                destructor.new_label = end_label
                capture_index InstValue::CaptureFlagLoad body.push
                0 InstValue::Push body.push
                InstValue::Ne body.push
                end_label InstValue::JumpNe body.push
                capture_index InstValue::CaptureLoad body.push
                body op capture.typ destructor.compile_destruction
                end_label InstValue::Label body.push
            fi
            1 += capture_index
        done
        InstValue::HeapFree body.push
        InstValue::FnReturn body.push
        body drop_name.clone compiler
            .state
            .program
            .functions
            .set
        drop_name
    }

    fn compile_function_ops compiler:mut$BytecodeCompiler op:$Op bytecode:mut$List[InstValue] {
        op op_str_value = name

        op.value match
            OpValue::FnCall => {
                if op name compiler.compile_named_function then
                    name InstValue::FnCall bytecode.push
                fi
            }
            OpValue::FnPush => {
                if op name compiler.compile_named_function ! then
                    return
                fi
                name compiler
                    .state
                    .store
                    .functions
                    .get
                    .unwrap
                    .clone_declaration = lambda
                lambda.captures.clone = captures

                # Zero-capture closures share a single static record so trait
                # dispatch and named-function pushes do not allocate per call.
                if 0 captures.length == then
                    name InstValue::FnPushStatic bytecode.push
                else
                    # Each capture is followed by its ownership flag. The record
                    # header stores the call and destruction functions.
                    for capture in captures.iter do
                        capture Variable::name = capture_name: $str
                        capture_name lambda.owned_captures string_list_contains = owns_capture
                        if capture_name compiler.capture_slots.get_copy Option::Some(capture_index) is then
                            capture_index InstValue::CaptureLoad bytecode.push
                            if owns_capture then
                                capture_index InstValue::CaptureFlagClear bytecode.push
                            fi
                        else
                            capture_name compiler.resolve_variable = capture_resolved
                            bytecode capture_resolved.emit_get
                            if owns_capture then
                                if capture_name compiler.owner_flags.get_copy Option::Some(flag) is then
                                    0 InstValue::Push bytecode.push
                                    flag InstValue::LocalSet bytecode.push
                                fi
                            fi
                        fi
                        if owns_capture then 1 else 0 fi InstValue::Push bytecode.push
                    done
                    name InstValue::FnPush bytecode.push
                    op lambda compiler.ensure_closure_destruction_function = drop_name
                    drop_name InstValue::DropFn bytecode.push
                    captures.length InstValue::ClosureRecord bytecode.push
                fi
            }
            _ => {
                "compile_function_ops received a non-function operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile enum comparison (data-carrying enums)
# ============================================================================

impl BytecodeCompiler {
    fn compile_enum_comparison
        compiler:mut$BytecodeCompiler
        compare_value:InstValue
        bytecode:mut$List[InstValue]
    {
        compiler.locals_count = local_a
        1 += compiler.locals_count
        local_a InstValue::LocalSet bytecode.push
        InstValue::Load64 bytecode.push
        local_a InstValue::LocalGet bytecode.push
        InstValue::Load64 bytecode.push
        compare_value bytecode.push
    }
}

# ============================================================================
# Compile single op
# ============================================================================

impl BytecodeCompiler {
    fn emit_inline_size compiler:mut$BytecodeCompiler target:$Type bytecode:mut$List[InstValue] {
        if target.has_unresolved_type_var then
            target make_hidden_size_parameter_name compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
        elif compiler.state.store target type_inline_size Option::Some(size) is then
            size i64::try_from.unwrap InstValue::Push bytecode.push
        else
            f"Cannot determine inline size of `{target.format}`" compiler.record_failure
        fi
    }

    fn emit_typed_load compiler:mut$BytecodeCompiler target:$Type bytecode:mut$List[InstValue] {
        if target.has_unresolved_type_var then
            target make_hidden_size_parameter_name compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target make_hidden_repr_parameter_name compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            InstValue::ReadTyped bytecode.push
            return
        fi
        if compiler.state.store target type_value_representation Option::Some(representation) is then
            if VALUE_REPR_INDIRECT representation == then
                compiler.state.store target type_inline_size.unwrap i64::try_from.unwrap
                InstValue::Push bytecode.push
                representation i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::ReadTyped bytecode.push
                return
            fi
            if compiler.state.store target type_inline_size Option::Some(size) is then
                if 1 size == then
                    InstValue::Load8 bytecode.push
                elif 2 size == then
                    InstValue::Load16 bytecode.push
                elif 4 size == then
                    InstValue::Load32 bytecode.push
                elif 8 size == then
                    InstValue::Load64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure
                    return
                fi
                if VALUE_REPR_SIGNED representation == then
                    if target Type::Builtin(builtin) is then
                        builtin InstValue::NormalizeInt bytecode.push
                    fi
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure
        fi
    }

    fn emit_typed_borrow compiler:mut$BytecodeCompiler target:$Type bytecode:mut$List[InstValue] {
        if target.has_unresolved_type_var then
            target make_hidden_size_parameter_name compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target make_hidden_repr_parameter_name compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            InstValue::BorrowTyped bytecode.push
            return
        fi
        if compiler.state.store target type_value_representation Option::Some(representation) is then
            if VALUE_REPR_INDIRECT representation != then
                bytecode target compiler.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure
        fi
    }

    fn emit_typed_copy compiler:mut$BytecodeCompiler target:$Type bytecode:mut$List[InstValue] {
        if target.has_unresolved_type_var then
            target make_hidden_size_parameter_name compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target make_hidden_repr_parameter_name compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            InstValue::CopyTyped bytecode.push
            return
        fi
        if compiler.state.store target type_value_representation Option::Some(representation) is then
            if VALUE_REPR_INDIRECT representation == then
                bytecode target compiler.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure
        fi
    }

    fn emit_typed_store compiler:mut$BytecodeCompiler target:$Type bytecode:mut$List[InstValue] {
        if target.has_unresolved_type_var then
            target make_hidden_size_parameter_name compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target make_hidden_repr_parameter_name compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            InstValue::WriteTyped bytecode.push
            return
        fi
        if compiler.state.store target type_value_representation Option::Some(representation) is then
            if compiler.state.store target type_inline_size Option::Some(size) is then
                if VALUE_REPR_INDIRECT representation == then
                    size i64::try_from.unwrap InstValue::Push bytecode.push
                    representation i64::try_from.unwrap InstValue::Push bytecode.push
                    InstValue::WriteTyped bytecode.push
                elif 1 size == then
                    InstValue::Store8 bytecode.push
                elif 2 size == then
                    InstValue::Store16 bytecode.push
                elif 4 size == then
                    InstValue::Store32 bytecode.push
                elif 8 size == then
                    InstValue::Store64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure
        fi
    }
}

impl BytecodeCompiler {
    fn compile_op compiler:mut$BytecodeCompiler op:$Op op_index:u64 bytecode:mut$List[InstValue] {
        if
            op.value OpValue::IfElif is
            op.value OpValue::IfElse is ||
            op.value OpValue::IfEnd is ||
            op.value OpValue::WhileEnd is ||
            op.value OpValue::MatchArm is ||
            op.value OpValue::MatchEnd is || !
        then
            bytecode op compiler.compile_owner_cleanups
        fi
        if op.value OpValue::Drop is then
            if op.type_hint Option::Some(drop_type) is then
                bytecode op drop_type compiler.compile_destruction
            else
                InstValue::Drop bytecode.push
            fi
            return
        fi
        if op.value OpValue::FnExecOwned is then
            compiler.locals_count = closure_local
            1 += compiler.locals_count
            InstValue::Dup bytecode.push
            closure_local InstValue::LocalSet bytecode.push
            InstValue::FnExec bytecode.push
            closure_local InstValue::LocalGet bytecode.push
            InstValue::ClosureDrop bytecode.push
            return
        fi
        op.value direct_op_to_inst = direct_inst_opt
        false = has_type_hint
        "" = type_hint_name
        if op Op::type_hint Option::Some(type_hint) is then
            true = has_type_hint
            type_hint.format = type_hint_name
        fi

        # Check direct op-to-inst mapping first
        direct_inst_opt match
            Option::Some(direct_inst) => {
                # Data-carrying enum comparison
                if
                    op.value OpValue::Eq is
                    op.value OpValue::Ne is ||
                    op.value OpValue::Lt is ||
                    op.value OpValue::Le is ||
                    op.value OpValue::Gt is ||
                    op.value OpValue::Ge is ||
                    has_type_hint &&
                    type_hint_name compiler
                        .state
                        .store
                        .enums
                        .has &&
                then
                    bytecode direct_inst compiler.compile_enum_comparison
                    return
                fi
                # String content comparison
                if
                    op.value OpValue::Eq is
                    op.value OpValue::Ne is ||
                    "str" type_hint_name == &&
                then
                    InstValue::StrEq bytecode.push
                    if op.value OpValue::Ne is then
                        InstValue::Not bytecode.push
                    fi
                    return
                fi
                # Data-carrying enum print
                if
                    op.value OpValue::PrintInt is type_hint_name compiler
                        .state
                        .store
                        .enums
                        .has &&
                then
                    InstValue::Load64 bytecode.push
                    InstValue::PrintInt bytecode.push
                    return
                fi
                type_hint_name parse_builtin = builtin_hint
                if builtin_hint Option::Some(builtin) is then
                    builtin direct_inst op.value.select_typed_instruction bytecode.push
                else
                    direct_inst bytecode.push
                fi
                bytecode op compiler.emit_integer_normalization
                return
            }
            Option::None => {
            }
        end

        # Non-direct ops
        if
            op.value OpValue::WrappingAdd is
            op.value OpValue::WrappingSub is ||
            op.value OpValue::WrappingMul is ||
        then
            InstValue::Swap bytecode.push
            if op.value OpValue::WrappingAdd is then
                InstValue::Add bytecode.push
            elif op.value OpValue::WrappingSub is then
                InstValue::Sub bytecode.push
            else
                InstValue::Mul bytecode.push
            fi
            bytecode op compiler.emit_integer_normalization
        elif op.value OpValue::NumericConvert(conversion) is then
            conversion.target conversion.source conversion.kind NumericConversion InstValue::NumericConvert bytecode.push
        elif op.value OpValue::NumericTry(numeric_try) is then
            if numeric_try.source Type::Builtin is then
                numeric_try.target numeric_try.source clone_type NumericTry InstValue::NumericTry bytecode.push
                f"__numeric_try_{numeric_try.target.format}" = wrapper_name
                if op wrapper_name compiler.compile_named_function then
                    wrapper_name InstValue::FnCall bytecode.push
                fi
            else
                f"Numeric conversion source `{numeric_try.source.format}` was not specialized" compiler.record_failure
            fi
        elif op.value OpValue::IntegerTry(integer_try) is then
            InstValue::Swap bytecode.push
            integer_try.target integer_try.kind IntegerTry InstValue::IntegerTry bytecode.push
            f"__numeric_try_{integer_try.target.format}" = wrapper_name
            if op wrapper_name compiler.compile_named_function then
                wrapper_name InstValue::FnCall bytecode.push
            fi
        elif op.value OpValue::FloatRound(rounding) is then
            rounding.target rounding.method.clone FloatRound InstValue::FloatRound bytecode.push
        elif op.value OpValue::FloatFromDecimal is then
            InstValue::FloatFromDecimal bytecode.push
        elif op.value OpValue::FloatSignificand is then
            InstValue::FloatSignificand bytecode.push
        elif
            op.value OpValue::AssignDec is
            op.value OpValue::AssignInc is ||
            op.value OpValue::AssignVar is ||
            op.value OpValue::Question is ||
        then
            if
                op op_identity compiler
                    .state
                    .store
                    .clone_ownership Option::Some(owned_ownership) is
            then
                for event in owned_ownership.assignments.iter do
                    bytecode op event compiler.compile_active_owner_cleanup
                done
            fi
            bytecode op compiler.compile_assignment
            if
                op op_identity compiler
                    .state
                    .store
                    .clone_ownership Option::Some(owned_ownership) is
            then
                for event in owned_ownership.assignments.iter do
                    bytecode event.generation event.name.clone compiler.set_owner_flag
                done
            fi
        elif op.value OpValue::QuestionMove(hidden_name) is then
            if hidden_name compiler.owner_flags.get_copy Option::Some(flag) is then
                0 InstValue::Push bytecode.push
                flag InstValue::LocalSet bytecode.push
            fi
        elif op.value OpValue::FstringConcat(fstring_count) is then
            fstring_count InstValue::FstringConcat bytecode.push
        elif op.value OpValue::PrimitiveToStr(builtin) is then
            builtin copy InstValue::PrimitiveToStr bytecode.push
        elif op.value OpValue::FstringToStr is then
            # Identity no-op: str expression already left on stack by the preceding lambda.
            # Non-str cases are rewritten to OpMethodCall during type checking.
        elif op.value OpValue::DestructionFn(target) is then
            if target compiler.destruction_needs_function then
                op target compiler.ensure_destruction_function = drop_name
                drop_name InstValue::DropFn bytecode.push
            else
                0 InstValue::Push bytecode.push
            fi
        elif op.value OpValue::FnCall is op.value OpValue::FnPush is || then
            if op.value OpValue::FnPush(fn_push_name) is then
                fn_push_name compiler
                    .state
                    .store
                    .functions
                    .get = function_opt
                if function_opt.is_some then
                    function_opt.unwrap = function_check
                    if function_check Function::has_deferred_methods then
                        0 InstValue::Push bytecode.push
                        return
                    fi
                fi
            fi
            bytecode op compiler.compile_function_ops
        elif op.value OpValue::Identifier(ident_name) is then
            f"Identifier `{ident_name}` reached bytecode compilation unresolved" compiler.record_failure
        elif
            op.value OpValue::IfCondition is
            op.value OpValue::IfElif is ||
            op.value OpValue::IfElse is ||
            op.value OpValue::IfEnd is ||
            op.value OpValue::IfStart is ||
        then
            bytecode op_index op compiler.compile_if_block
        elif op.value OpValue::Copy is then
            if op.type_hint Option::Some(copied_type) is then
                bytecode copied_type compiler.emit_typed_copy
            fi
        elif
            op.value OpValue::ImportFile is
            op.value OpValue::ImportFileSelective is ||
            op.value OpValue::TypeCast is ||
            op.value OpValue::PtrIntoRaw is ||
            op.value OpValue::DeclareGlobal is ||
        then
            # No instruction emitted
        elif op.value OpValue::PushEnumVariant(variant) is then
            if
                variant.enum_name compiler
                    .state
                    .store
                    .clone_enum Option::Some(owned_enum) is
            then
                if owned_enum has_inner_values then
                    bytecode owned_enum variant compiler.compile_enum_variant
                else
                    compiler variant require_variant_ordinal InstValue::Push bytecode.push
                fi
            else
                f"Enum `{variant.enum_name}` is missing during bytecode compilation" compiler.record_failure
            fi
        elif op.value OpValue::IsCheck is then
            bytecode op compiler.compile_is_check
        elif
            op.value OpValue::MatchStart is
            op.value OpValue::MatchArm is ||
            op.value OpValue::MatchEnd is ||
        then
            bytecode op_index op compiler.compile_match_block
        elif
            op.value OpValue::MethodCall is
            op.value OpValue::QualifiedMethodCall is ||
        then
            "Method call reached bytecode compilation before typechecker lowering" compiler.record_failure
        elif op.value OpValue::TraitMethodCall(trait_hidden_var) is then
            trait_hidden_var compiler.resolve_variable = trait_resolved
            bytecode trait_resolved.emit_get
            InstValue::FnExec bytecode.push
        elif op.value OpValue::Print is then
            "Generic print reached bytecode compilation before typechecker lowering" compiler.record_failure
        elif op.value OpValue::Typeof is then
            type_hint_name = type_name
            type_name compiler.intern_string = typeof_index
            InstValue::Drop bytecode.push
            typeof_index InstValue::PushStr bytecode.push
            InstValue::PrintStr bytecode.push
        elif op.value OpValue::SizeOf(target_type) is then
            if compiler.state.store target_type type_inline_size Option::Some(size) is then
                if size i64::try_from Option::Some(signed_size) is then
                    signed_size InstValue::Push bytecode.push
                else
                    f"Inline size of `{target_type.format}` exceeds the supported constant range"
                    compiler.record_failure
                fi
            else
                f"Cannot determine inline size of `{target_type.format}`"
                compiler.record_failure
            fi
        elif op.value OpValue::PtrRead(target_type) is then
            bytecode target_type compiler.emit_typed_load
        elif op.value OpValue::PtrWrite(target_type) is then
            bytecode target_type compiler.emit_typed_store
        elif op.value OpValue::PtrAsRef(target_type) is then
            bytecode target_type compiler.emit_typed_borrow
        elif op.value OpValue::PtrAsMut(target_type) is then
            bytecode target_type compiler.emit_typed_borrow
        elif op.value OpValue::PushArray is then
            bytecode op compiler.compile_push_array
        elif op.value OpValue::ExprGroup(group_ops) is then
            0 (u64) = grp_idx
            while grp_idx group_ops.length > do
                bytecode grp_idx grp_idx group_ops.get compiler.compile_op
                1 += grp_idx
            done
        elif op.value OpValue::PushBool(bool_value) is then
            bool_value InstValue::Push bytecode.push
        elif op.value OpValue::PushChar(char_value) is then
            char_value InstValue::PushChar bytecode.push
        elif op.value OpValue::PushCapture(capture_name) is then
            if compiler.function.is_none then
                f"Capture `{capture_name}` reached global bytecode compilation" compiler.record_failure
            elif capture_name compiler.capture_slots.get_copy Option::Some(capture_index) is then
                capture_index InstValue::CaptureLoad bytecode.push
                if
                    op op_identity compiler
                        .state
                        .store
                        .clone_ownership
                    Option::Some(owned_ownership) is
                then
                    if owned_ownership.moves_owner then
                        capture_index InstValue::CaptureFlagClear bytecode.push
                    fi
                fi
            else
                f"Capture `{capture_name}` is missing during bytecode compilation" compiler.record_failure
            fi
        elif op.value OpValue::PushInt(int_value) is then
            int_value.value InstValue::Push bytecode.push
        elif op.value OpValue::PushFloat(float_value) is then
            if "f32" type_hint_name == then
                float_value.clone InstValue::PushFloat32 bytecode.push
            else
                float_value.clone InstValue::PushFloat64 bytecode.push
            fi
        elif op.value OpValue::PushStr(str_value) is then
            str_value compiler.intern_string = string_index
            string_index InstValue::PushStr bytecode.push
        elif op.value OpValue::PushVar(var_name) is then
            var_name compiler.resolve_variable = var_resolved
            bytecode var_resolved.emit_get
            if
                op op_identity compiler
                    .state
                    .store
                    .clone_ownership Option::Some(owned_ownership) is
            then
                if owned_ownership.moves_owner then
                    if var_name compiler.owner_flags.get_copy Option::Some(flag) is then
                        0 InstValue::Push bytecode.push
                        flag InstValue::LocalSet bytecode.push
                    fi
                fi
            fi
        elif op.value OpValue::StructNew is then
            bytecode op compiler.compile_struct_new
        elif op.value OpValue::StructLiteral is then
            bytecode op compiler.compile_struct_literal
        elif op.value OpValue::OwnerCleanup is then
            # Ownership metadata emitted before operation dispatch.
        elif
            op.value OpValue::WhileBreak is
            op.value OpValue::WhileCondition is ||
            op.value OpValue::WhileContinue is ||
            op.value OpValue::WhileEnd is ||
            op.value OpValue::WhileStart is ||
        then
            bytecode op_index op compiler.compile_while_block
        fi
    }
}

# ============================================================================
# Compile ops list
# ============================================================================

impl BytecodeCompiler {
    fn compile_ops compiler:mut$BytecodeCompiler bytecode:mut$List[InstValue] {
        # Set locals_count from function variables
        if compiler.function Option::Some(function) is then
            function Function::variables.length = var_count
            var_count = compiler.locals_count
        fi

        # Function label
        compiler.new_label = function_label
        function_label InstValue::Label bytecode.push

        0 (u64) = index
        while index compiler.ops.length > compiler.has_failed ! && do
            index compiler.ops.get = op
            bytecode index op compiler.compile_op
            1 += index
        done
    }
}

# ============================================================================
# Main entry: compile_bytecode
# ============================================================================

fn compile_bytecode_into ops:$List[Op] state:mut$BytecodeState {
    List[InstValue]::new = bytecode
    ops state BytecodeCompiler::new = compiler

    # Emit globals init if needed
    if
        0 compiler
            .state
            .store
            .variables
            .length !=
    then
        compiler
            .state
            .store
            .variables
            .length InstValue::GlobalsInit bytecode.push
    fi

    bytecode compiler.compile_ops

    # Handle locals for global scope
    compiler.locals_count = locals_count
    if locals_count 0 < then
        List[InstValue]::new = final_bytecode
        locals_count InstValue::LocalsInit final_bytecode.push
        bytecode final_bytecode.append
        locals_count InstValue::LocalsUninit final_bytecode.push
        final_bytecode = bytecode
    fi

    bytecode = compiler.state.program.bytecode
    compiler
        .state
        .store
        .variables
        .length = compiler.state.program.globals_count
    compiler
        .state
        .constants_table
        .length = compiler.state.program.constants_count
}

fn compile_bytecode store:$SymbolStore ops:$List[Op] -> Result[Program BytecodeFailure] {
    store BytecodeState::new = state
    state ops compile_bytecode_into
    state.into_result
}

fn compile_typechecked result:mut$TypecheckResult -> Result[Program BytecodeFailure] {
    if result.diagnostics.has_errors then
        "Bytecode compilation requires error-free typechecking" BytecodeFailure::new Result::Error
        return
    fi
    result.ops result.store compile_bytecode
}
