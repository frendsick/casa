                }
                common::OpValue::ExprGroup(group_ops) => {
                    group_ops compiler.state.store compiler.compile_static_struct = struct_label
                    struct_label common::StaticArrayElement::Label elements.push
                }
                _ => {
                    item compiler.compile_static_element elements.push
                }
            end
        done
        compiler
            .state
            .program
            .static_arrays
            .length = array_index
        elements common::StaticArray compiler
            .state
            .program
            .static_arrays
            .push
        array_index common::InstValue::PushStaticArray bytecode.push
    }
}

impl BytecodeCompiler {
    fn static_array_element_is_word self:$BytecodeCompiler element_type:$common::Type -> bool {
        if self.state.store element_type common::type_inline_size std::Option::Some(element_size) is then
            if
                self.state.store element_type common::type_value_representation std::Option::Some(representation) is
            then
                common::WORD_SIZE element_size ==
                common::VALUE_REPR_RAW representation ==
                common::VALUE_REPR_SIGNED representation == || &&
                return
            fi
        fi
        false
    }

    fn can_emit_static_array
        self:$BytecodeCompiler
        op:$common::Op
        items:$std::List[common::Op]
    -> bool {
        if items.is_empty self.state.store items common::op_is_static_array_with_store ! || then
            false return
        fi
        if op.type_hint std::Option::Some(array_type) is then
            if array_type.array_element_type std::Option::Some(element_type) is then
                element_type typechecker::resolve_numeric_literal_default = resolved_type
                resolved_type self.static_array_element_is_word return
            fi
            false return
        fi
        # Compiler unit tests may build an already-word-sized static array op
        # directly without running the typechecker.
        true
    }

    fn compile_push_array
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if op.value common::OpValue::PushArray(items) is then
            items.length = length

            items op self.can_emit_static_array = can_emit_static
            if can_emit_static then
                bytecode items self.compile_static_array return
            fi

            common::make_unknown_type.clone = element_type
            if op.type_hint std::Option::Some(array_type) is then
                if array_type.array_element_type std::Option::Some(found_element_type) is then
                    found_element_type typechecker::resolve_numeric_literal_default = element_type
                else
                    "Array literal has no element type during bytecode compilation"
                    self.record_failure return
                fi
            else
                "Array literal has no type during bytecode compilation" self.record_failure return
            fi

            bytecode items self.compile_sequence_reversed

            # An array stores only its elements (ADR-0152), so the allocation
            # is exactly the element storage.
            self.allocate_local = list_local
            self.state.store element_type common::type_inline_size.unwrap = element_size
            element_size length common::get_array_storage_size i64::try_from.unwrap common::InstValue::Push bytecode.push
            common::InstValue::HeapAlloc bytecode.push
            list_local common::InstValue::LocalSet bytecode.push

            # Store elements starting at offset 0
            self.allocate_local = index_local
            0 common::InstValue::Push bytecode.push
            index_local common::InstValue::LocalSet bytecode.push

            self.new_label = start_label
            self.new_label = end_label

            # while index limit > do
            start_label common::InstValue::Label bytecode.push
            index_local common::InstValue::LocalGet bytecode.push
            length element_size * i64::try_from.unwrap common::InstValue::Push bytecode.push
            common::InstValue::Gt bytecode.push
            end_label common::InstValue::JumpNe bytecode.push

            # list index + typed store
            list_local common::InstValue::LocalGet bytecode.push
            index_local common::InstValue::LocalGet bytecode.push
            common::InstValue::Add bytecode.push
            bytecode element_type self.emit_typed_store

            # element_size += index
            index_local common::InstValue::LocalGet bytecode.push
            element_size i64::try_from.unwrap common::InstValue::Push bytecode.push
            common::InstValue::Add bytecode.push
            index_local common::InstValue::LocalSet bytecode.push

            # done
            start_label common::InstValue::Jump bytecode.push
            end_label common::InstValue::Label bytecode.push

            # Push array pointer
            list_local common::InstValue::LocalGet bytecode.push
        fi
    }
}

# ============================================================================
# Compile function call
# ============================================================================

impl BytecodeCompiler {
    fn lower_extern_call
        self:mut$BytecodeCompiler
        function:$common::Function
        symbol:std::String
    -> std::Option[common::ExternCall] {
        std::List[common::ExternAbiType]::new = parameters
        for
            parameter in function
                .stack_effect
                .parameters
                .iter
        do
            if
                self.state.store parameter.typ abi::classify_extern_type
                std::Option::Some(classification) is
            then
                classification.clone parameters.push
            else
                f"Extern parameter `{parameter.typ.format}` has no ABI classification"
                self.record_failure_string
                std::Option[common::ExternCall]::None return
            fi
        done
        std::Option[common::ExternAbiType]::None = return_type
        if
            function
                .stack_effect
                .return_types
                .is_empty !
        then
            0 function
                .stack_effect
                .return_types
                .get = declared_return
            if
                self.state.store declared_return abi::classify_extern_type
                std::Option::Some(classification) is
            then
                classification.clone std::Option::Some = return_type
            else
                f"Extern return `{declared_return.format}` has no ABI classification"
                self.record_failure_string
                std::Option[common::ExternCall]::None return
            fi
        fi
        return_type.clone parameters symbol common::ExternCall::new std::Option::Some
    }

    fn compile_named_function compiler:mut$BytecodeCompiler name:$str op:$common::Op -> bool {
        if
            name compiler
                .state
                .program
                .functions
                .has_str
        then
            true return
        fi
        name compiler
            .state
            .store
            .get_function match
            std::Option::Some(function) => {
                if function.extern_symbol.is_none then
                    op function compiler.compile_function
                fi
                compiler.has_failed !
            }
            std::Option::None => {
                f"Function `{name}` is missing during bytecode compilation" compiler.record_failure_string
                false
            }
        end
    }

    fn compile_function compiler:mut$BytecodeCompiler function:$common::Function op:$common::Op {
        if function.extern_symbol.is_some then
            return
        fi
        # Compile a function if not already compiled.
        if
            function common::Function::name compiler
                .state
                .program
                .functions
                .has
        then
            return
        fi
        # Mark as being compiled to prevent infinite recursion on recursive calls
        std::List[common::InstValue]::new = function_bytecode
        std::List[common::InstValue]::new function common::Function::name.clone compiler
            .state
            .program
            .functions
            .set
        function.ops function compiler.child = function_compiler
        function_bytecode function_compiler.compile_ops
        if function_compiler.has_failed then
            return
        fi

        # Handle locals
        function_compiler.locals_count = locals_count
        if locals_count 0 < then
            # Build new list with LOCALS_INIT at front
            std::List[common::InstValue]::new = final_bytecode
            locals_count common::InstValue::LocalsInit final_bytecode.push

            function_bytecode.reverse
            while function_bytecode.is_empty ! do
                function_bytecode.pop = instruction
                if instruction common::InstValue::FnReturn is then
                    locals_count common::InstValue::LocalsUninit final_bytecode.push
                fi
                instruction final_bytecode.push
            done
            locals_count common::InstValue::LocalsUninit final_bytecode.push
            common::InstValue::FnReturn final_bytecode.push
            final_bytecode = function_bytecode
        else
            common::InstValue::FnReturn function_bytecode.push
        fi

        function_bytecode function common::Function::name.clone compiler
            .state
            .program
            .functions
            .set
    }
}

impl BytecodeCompiler {
    fn ensure_closure_destruction_function
        compiler:mut$BytecodeCompiler
        lambda:$common::Function
        op:$common::Op
    -> std::String {
        f"__drop_closure_{lambda.name}" = drop_name
        if
            drop_name compiler
                .state
                .program
                .functions
                .has
        then
            drop_name return
        fi
        std::List[common::InstValue]::new drop_name.clone compiler
            .state
            .program
            .functions
            .set

        std::List[common::InstValue]::new = body
        lambda.ops lambda compiler.child = destructor
        0 = capture_index: u64
        while capture_index lambda.captures.length > do
            capture_index lambda.captures.get = capture
            if capture.name.as_str lambda.owned_captures common::string_list_contains then
                destructor.new_label = end_label
                capture_index common::InstValue::CaptureFlagLoad body.push
                0 common::InstValue::Push body.push
                common::InstValue::Ne body.push
                end_label common::InstValue::JumpNe body.push
                capture_index common::InstValue::CaptureLoad body.push
                body op capture.typ destructor.compile_destruction
                end_label common::InstValue::Label body.push
            fi
            1 += capture_index
        done
        common::InstValue::HeapFree body.push
        common::InstValue::FnReturn body.push
        body drop_name.clone compiler
            .state
            .program
            .functions
            .set
        drop_name
    }

    fn compile_function_ops
        compiler:mut$BytecodeCompiler
        store:$common::SymbolStore
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        op common::op_str_value = name

        op.value match
            common::OpValue::FnCall => {
                if op name.as_str compiler.compile_named_function then
                    name.as_str store.get_function.unwrap = called_function
                    called_function.extern_symbol match
                        std::Option::Some(symbol) => {
                            symbol.clone called_function compiler.lower_extern_call match
                                std::Option::Some(call) => {
                                    call common::InstValue::ExternCall bytecode.push
                                }
                                std::Option::None => {
                                }
                            end
                        }
                        std::Option::None => name common::InstValue::FnCall bytecode.push
                    end
                fi
            }
            common::OpValue::FnPush => {
                if op name.as_str compiler.compile_named_function ! then
                    return
                fi
                name.as_str store
                    .get_function
                    .unwrap
                    .clone = lambda
                lambda.captures.clone = captures

                # Zero-capture closures share a single static record so trait
                # dispatch and named-function pushes do not allocate per call.
                if 0 captures.length == then
                    name common::InstValue::FnPushStatic bytecode.push
                else
                    # Each capture is followed by its ownership flag. The record
                    # header stores the call and destruction functions.
                    for capture in captures.iter do
                        capture common::Variable::name.as_str = capture_name: $str
                        capture_name.as_str lambda.owned_captures common::string_list_contains = owns_capture
                        owns_capture capture.typ compiler.is_copy_aggregate && = copies_aggregate
                        if capture_name.as_str compiler.capture_slots.get_copy_str std::Option::Some(capture_index) is then
                            capture_index common::InstValue::CaptureLoad bytecode.push
                            if copies_aggregate then
                                bytecode capture.typ compiler.emit_typed_load
                            elif owns_capture then
                                capture_index common::InstValue::CaptureFlagClear bytecode.push
                            fi
                        else
                            bytecode owns_capture copies_aggregate ! && capture_name.as_str
                            compiler.emit_variable_get
                            if copies_aggregate then
                                bytecode capture.typ compiler.emit_typed_load
                            elif owns_capture then
                                if capture_name.as_str compiler.owner_flags.get_copy_str std::Option::Some(flag) is then
                                    0 common::InstValue::Push bytecode.push
                                    flag common::InstValue::LocalSet bytecode.push
                                fi
                            fi
                        fi
                        if owns_capture then 1 else 0 fi common::InstValue::Push bytecode.push
                    done
                    name common::InstValue::FnPush bytecode.push
                    op lambda compiler.ensure_closure_destruction_function = drop_name
                    drop_name common::InstValue::DropFn bytecode.push
                    captures.length common::InstValue::ClosureRecord bytecode.push
                fi
            }
            _ => {
                "compile_function_ops received a non-function operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile enum comparison (data-carrying enums)
# ============================================================================

impl BytecodeCompiler {
    fn compile_enum_comparison
        compiler:mut$BytecodeCompiler
        compare_value:common::InstValue
        bytecode:mut$std::List[common::InstValue]
    {
        compiler.allocate_local = local_a
        local_a common::InstValue::LocalSet bytecode.push
        common::InstValue::Load64 bytecode.push
        local_a common::InstValue::LocalGet bytecode.push
        common::InstValue::Load64 bytecode.push
        compare_value bytecode.push
    }
}

# ============================================================================
# Compile single op
# ============================================================================

impl BytecodeCompiler {
    fn emit_inline_size
        compiler:mut$BytecodeCompiler
        target:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        if compiler.state.store target common::type_inline_size std::Option::Some(size) is then
            size i64::try_from.unwrap common::InstValue::Push bytecode.push
        else
            f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
        fi
    }

    fn emit_typed_load
        compiler:mut$BytecodeCompiler
        target:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation == then
                compiler.state.store target common::type_inline_size.unwrap
                common::InstValue::ReadIndirect bytecode.push
                return
            fi
            if compiler.state.store target common::type_inline_size std::Option::Some(size) is then
                if 1 size == then
                    common::InstValue::Load8 bytecode.push
                elif 2 size == then
                    common::InstValue::Load16 bytecode.push
                elif 4 size == then
                    common::InstValue::Load32 bytecode.push
                elif 8 size == then
                    common::InstValue::Load64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure_string
                    return
                fi
                if common::VALUE_REPR_SIGNED representation == then
                    if target common::Type::Builtin(builtin) is then
                        builtin common::InstValue::NormalizeInt bytecode.push
                    fi
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }

    fn emit_typed_borrow
        compiler:mut$BytecodeCompiler
        target:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        # A cstr borrow is the raw character address itself, not a pointer loaded from it.
        if target common::make_cstr_type.eq then
            return
        fi
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation != then
                bytecode target compiler.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }

    fn emit_typed_copy
        compiler:mut$BytecodeCompiler
        target:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        if target compiler.is_copy_aggregate then
            bytecode target compiler.emit_inline_copy return
        fi
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation == then
                bytecode target compiler.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }

    fn emit_inline_copy
        self:mut$BytecodeCompiler
        target:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        self.state.store target common::type_inline_size.unwrap = size
        size common::WORD_SIZE u64::try_from.unwrap 1 - +
        common::WORD_SIZE u64::try_from.unwrap / = width
        0 = copy_local: u64
        while 0 width != do
            self.allocate_local = copy_local
            1 -= width
        done
        copy_local common::InstValue::LocalAddress bytecode.push
        size common::InstValue::MoveBytes bytecode.push
        copy_local common::InstValue::LocalAddress bytecode.push
    }

    fn emit_copy_aggregate_for_op
        self:mut$BytecodeCompiler
        target:$common::Type
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        op common::op_identity self
            .state
            .store
            .does_op_move_owner = materialize_owner
        if materialize_owner then
            bytecode target self.emit_typed_load
        else
            bytecode target self.emit_inline_copy
        fi
    }

    fn emit_typed_store
        compiler:mut$BytecodeCompiler
        target:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if compiler.state.store target common::type_inline_size std::Option::Some(size) is then
                if common::VALUE_REPR_INDIRECT representation == then
                    size common::InstValue::WriteIndirect bytecode.push
                elif 1 size == then
                    common::InstValue::Store8 bytecode.push
                elif 2 size == then
                    common::InstValue::Store16 bytecode.push
                elif 4 size == then
                    common::InstValue::Store32 bytecode.push
                elif 8 size == then
                    common::InstValue::Store64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure_string
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }
}

impl BytecodeCompiler {
    fn compile_temporary_binding
        compiler:mut$BytecodeCompiler
        op:$common::Op
        binding:$common::TemporaryBinding
        bytecode:mut$std::List[common::InstValue]
    {
        if compiler.function.is_some then
            if binding.name.as_str compiler.local_slots.has_str ! then
                compiler.allocate_local = local
                local binding.name.clone compiler.local_slots.set
            fi
        elif
            binding.name.as_str compiler
                .state
                .global_slots
                .has_str !
        then
            compiler
                .state
                .global_slots
                .length = global_slot
            global_slot binding.name.clone compiler
                .state
                .global_slots
                .set
        fi
        std::List[u64]::new = spilled
        0 = depth: u64
        while depth binding.depth > do
            compiler.allocate_local = local
            local common::InstValue::LocalSet bytecode.push
            local spilled.push
            1 += depth
        done
        op common::op_identity compiler
            .state
            .store
            .clone_owner_assignments = assignments
        for event in assignments.iter do
            bytecode op event compiler.compile_active_owner_cleanup
        done
        bytecode binding.name.as_str compiler.emit_variable_set
        bytecode false binding.name.as_str compiler.emit_variable_get
        while spilled.is_empty ! do
            spilled.pop common::InstValue::LocalGet bytecode.push
        done
        for event in assignments.iter do
            bytecode event.generation event.name.as_str compiler.set_owner_flag
        done
    }

    fn compile_direct_op
        self:mut$BytecodeCompiler
        op:$common::Op
        type_hint_name:$str
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        if op.type_hint std::Option::Some(copied_type) is then
            if copied_type self.is_copy_aggregate then
                if op.value common::OpValue::Dup is then
                    common::InstValue::Dup bytecode.push
                    bytecode op copied_type self.emit_copy_aggregate_for_op
                    true return
                elif op.value common::OpValue::Over is then
                    common::InstValue::Over bytecode.push
                    bytecode op copied_type self.emit_copy_aggregate_for_op
                    true return
                fi
            fi
        fi
        op.value common::direct_op_to_inst = direct_inst_opt
        # Check direct op-to-inst mapping first
        direct_inst_opt match
            std::Option::Some(direct_inst) => {
                # Data-carrying enum comparison
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    op.value common::OpValue::Lt is ||
                    op.value common::OpValue::Le is ||
                    op.value common::OpValue::Gt is ||
                    op.value common::OpValue::Ge is ||
                    op.type_hint.is_some &&
                    type_hint_name.as_str self
                        .state
                        .store
                        .enums
                        .has_str &&
                then
                    bytecode direct_inst self.compile_enum_comparison
                    true return
                fi
                # String content comparison
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    "str" type_hint_name.as_str == &&
                then
                    common::InstValue::StrEq bytecode.push
                    if op.value common::OpValue::Ne is then
                        common::InstValue::Not bytecode.push
                    fi
                    true return
                fi
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    "StringStrEq" type_hint_name.as_str == &&
                then
                    common::InstValue::StringStrEq bytecode.push
                    if op.value common::OpValue::Ne is then
                        common::InstValue::Not bytecode.push
                    fi
                    true return
                fi
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    "StrStringEq" type_hint_name.as_str == &&
                then
                    common::InstValue::StrStringEq bytecode.push
                    if op.value common::OpValue::Ne is then
                        common::InstValue::Not bytecode.push
                    fi
                    true return
                fi
                # Data-carrying enum print
                if
                    op.value common::OpValue::PrintInt is type_hint_name.as_str self
                        .state
                        .store
                        .enums
                        .has_str &&
                then
                    common::InstValue::Load64 bytecode.push
                    common::InstValue::PrintInt bytecode.push
                    true return
                fi
                type_hint_name.as_str common::parse_builtin = builtin_hint
                if builtin_hint std::Option::Some(builtin) is then
                    builtin direct_inst op.value.select_typed_instruction bytecode.push
                else
                    direct_inst bytecode.push
                fi
                bytecode op self.emit_integer_normalization
                true return
            }
            std::Option::None => {
            }
        end
        false
    }

    fn compile_wrapping_numeric_op
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        common::InstValue::Swap bytecode.push
        op.value match
            common::OpValue::WrappingAdd => common::InstValue::Add bytecode.push
            common::OpValue::WrappingSub => common::InstValue::Sub bytecode.push
            common::OpValue::WrappingMul => common::InstValue::Mul bytecode.push
            _ => {
            }
        end
        bytecode op self.emit_integer_normalization
    }

    fn compile_numeric_op
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::WrappingAdd => {
                bytecode op self.compile_wrapping_numeric_op
                true
            }
            common::OpValue::WrappingSub => {
                bytecode op self.compile_wrapping_numeric_op
                true
            }
            common::OpValue::WrappingMul => {
                bytecode op self.compile_wrapping_numeric_op
                true
            }
            common::OpValue::NumericConvert(conversion) => {
                conversion.target conversion.source conversion.kind common::NumericConversion common::InstValue::NumericConvert bytecode.push
                true
            }
            common::OpValue::NumericTry(numeric_try) => {
                if numeric_try.source common::Type::Builtin is then
                    numeric_try.target numeric_try.source.clone common::NumericTry common::InstValue::NumericTry bytecode.push
                    f"{common::STD_NAMESPACE}__numeric_try_{numeric_try.target.format}" = wrapper_name
                    if op wrapper_name.as_str self.compile_named_function then
                        wrapper_name common::InstValue::FnCall bytecode.push
                    fi
                else
                    f"Numeric conversion source `{numeric_try.source.format}` was not specialized" self.record_failure_string
                fi
                true
            }
            common::OpValue::IntegerTry(integer_try) => {
                common::InstValue::Swap bytecode.push
                integer_try.target integer_try.kind common::IntegerTry common::InstValue::IntegerTry bytecode.push
                f"{common::STD_NAMESPACE}__numeric_try_{integer_try.target.format}" = wrapper_name
                if op wrapper_name.as_str self.compile_named_function then
                    wrapper_name common::InstValue::FnCall bytecode.push
                fi
                true
            }
            common::OpValue::FloatRound(rounding) => {
                rounding.target rounding.method.clone common::FloatRound common::InstValue::FloatRound bytecode.push
                true
            }
            common::OpValue::FloatFromDecimal => {
                common::InstValue::FloatFromDecimal bytecode.push
                true
            }
            common::OpValue::FloatSignificand => {
                common::InstValue::FloatSignificand bytecode.push
                true
            }
            _ => false
        end
    }

    fn compile_terminal_op
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::Drop => {
                if op.type_hint std::Option::Some(drop_type) is then
                    bytecode op drop_type self.compile_destruction
                else
                    common::InstValue::Drop bytecode.push
                fi
                true
            }
            common::OpValue::FnExecOwned => {
                self.allocate_local = closure_local
                common::InstValue::Dup bytecode.push
                closure_local common::InstValue::LocalSet bytecode.push
                common::InstValue::FnExec bytecode.push
                closure_local common::InstValue::LocalGet bytecode.push
                common::InstValue::ClosureDrop bytecode.push
                true
            }
            _ => false
        end
    }

    fn compile_owned_assignment
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        op common::op_identity self
            .state
            .store
            .clone_owner_assignments = assignments
        for event in assignments.iter do
            bytecode op event self.compile_active_owner_cleanup
        done
        bytecode op self.compile_assignment
        for event in assignments.iter do
            bytecode event.generation event.name.as_str self.set_owner_flag
        done
    }

    fn compile_stateful_op
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::BindTemporary(binding) => {
                bytecode binding op self.compile_temporary_binding
                true
            }
            common::OpValue::AssignDec(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::AssignInc(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::AssignVar(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::Question(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::QuestionMove(hidden_name) => {
                if hidden_name self.owner_flags.get_copy std::Option::Some(flag) is then
                    0 common::InstValue::Push bytecode.push
                    flag common::InstValue::LocalSet bytecode.push
                fi
                true
            }
            _ => false
        end
    }

    fn compile_callable_op
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::FstringConcat(count) => {
                count common::InstValue::FstringConcat bytecode.push
                true
            }
            common::OpValue::PrimitiveToStr(builtin) => {
                builtin copy common::InstValue::PrimitiveToStr bytecode.push
                true
            }
            common::OpValue::FstringToStr => true
            common::OpValue::DestructionFn(target) => {
                if target self.destruction_needs_function then
                    op target self.ensure_destruction_function = drop_name
                    drop_name common::InstValue::DropFn bytecode.push
                else
                    0 common::InstValue::Push bytecode.push
                fi
                true
            }
            common::OpValue::FnCall(_) => {
                bytecode op self.state.store self.compile_function_ops
                true
            }
            common::OpValue::FnPush(_) => {
                bytecode op self.state.store self.compile_function_ops
                true
            }
            common::OpValue::Identifier(name) => {
                f"Identifier `{name}` reached bytecode compilation unresolved"
                self.record_failure_string
                true
            }
            common::OpValue::Copy => {
                if op.type_hint std::Option::Some(copied_type) is then
                    if copied_type self.is_copy_aggregate then
                        bytecode op copied_type self.emit_copy_aggregate_for_op
                    else
                        bytecode copied_type self.emit_typed_copy
                    fi
                fi
                true
            }
            common::OpValue::MethodCall(_) => {
                "Method call reached bytecode compilation before typechecker lowering"
                self.record_failure
                true
            }
            common::OpValue::QualifiedMethodCall(_) => {
                "Method call reached bytecode compilation before typechecker lowering"
                self.record_failure
                true
            }
            common::OpValue::TraitMethodCall(_) => {
                "Trait operation reached bytecode compilation before monomorphization"
                self.record_failure
                true
            }
            common::OpValue::TraitMethodRef(_) => {
                "Trait operation reached bytecode compilation before monomorphization"
                self.record_failure
                true
            }
            common::OpValue::Print => {
                "Generic print reached bytecode compilation before typechecker lowering"
                self.record_failure
                true
            }
            _ => false
        end
    }

    fn compile_structural_op
        self:mut$BytecodeCompiler
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        type_hint_name:$str
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::IfStart => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfCondition => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfElif => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfElse => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfEnd => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::ImportFile(_) => true
            common::OpValue::ImportFileSelective(_) => true
            common::OpValue::PtrFromRaw(_) => true
            common::OpValue::PtrFromRef => true
            common::OpValue::PtrIntoRaw => true
            common::OpValue::InitGlobal(initializer) => {
                bytecode initializer.ops self.compile_sequence
                bytecode initializer.name.as_str self.emit_variable_set
                true
            }
            common::OpValue::OwnerCleanup => true
            common::OpValue::PushEnumVariant(variant) => {
                if
                    variant.enum_name self
                        .state
                        .store
                        .enums
                        .get std::Option::Some(owned_enum) is
                then
                    if owned_enum common::has_inner_values then
                        bytecode owned_enum variant self.compile_enum_variant
                    else
                        self variant require_variant_ordinal common::InstValue::Push bytecode.push
                    fi
                else
                    f"Enum `{variant.enum_name}` is missing during bytecode compilation"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::IsCheck(_) => {
                bytecode op self.state.store self.compile_is_check
                true
            }
            common::OpValue::MatchStart => {
                bytecode op_index op targets ops self.compile_match_block
                true
            }
            common::OpValue::MatchArm(_) => {
                bytecode op_index op targets ops self.compile_match_block
                true
            }
            common::OpValue::MatchEnd => {
                bytecode op_index op targets ops self.compile_match_block
                true
            }
            common::OpValue::Typeof => {
                type_hint_name self.intern_string = typeof_index
                common::InstValue::Drop bytecode.push
                typeof_index common::InstValue::PushStr bytecode.push
                common::InstValue::PrintStr bytecode.push
                true
            }
            common::OpValue::SizeOf(target_type) => {
                if self.state.store target_type common::type_inline_size std::Option::Some(size) is then
                    if size i64::try_from std::Option::Some(signed_size) is then
                        signed_size common::InstValue::Push bytecode.push
                    else
                        f"Inline size of `{target_type.format}` exceeds the supported constant range"
                        self.record_failure_string
                    fi
                else
                    f"Cannot determine inline size of `{target_type.format}`"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::StructMemberProject(member) => {
                if
                    self.state.store member resolve_struct_field
                    std::Option::Some(field) is
                then
                    if 0 field.storage.offset != then
                        field.storage.offset i64::try_from.unwrap common::InstValue::Push
                        bytecode.push
                        common::InstValue::Add bytecode.push
                    fi
                    bytecode field.storage field.typ self.emit_field_projection
                else
                    f"Cannot determine member {member.member_index} storage of struct `{member.struct_name}`"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::StructMemberStore(member) => {
                if
                    self.state.store member resolve_struct_field
                    std::Option::Some(field) is
                then
                    if 0 field.storage.offset != then
                        field.storage.offset i64::try_from.unwrap common::InstValue::Push
                        bytecode.push
                        common::InstValue::Add bytecode.push
                    fi
                    bytecode field.storage field.typ self.emit_field_store
                else
                    f"Cannot determine member {member.member_index} storage of struct `{member.struct_name}`"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::PtrRead(target_type) => {
                bytecode target_type self.emit_typed_load
                true
            }
            common::OpValue::PtrWrite(target_type) => {
                bytecode target_type self.emit_typed_store
                true
            }
            common::OpValue::PtrAsRef(target_type) => {
                bytecode target_type self.emit_typed_borrow
                true
            }
            common::OpValue::PtrAsMut(target_type) => {
                bytecode target_type self.emit_typed_borrow
                true
            }
            common::OpValue::PtrNull => {
                0 common::InstValue::Push bytecode.push
                true
            }
            common::OpValue::PushArray(_) => {
                bytecode op self.compile_push_array
                true
            }
            common::OpValue::ExprGroup(group_ops) => {
                bytecode group_ops self.compile_sequence
                true
            }
            common::OpValue::StructNew(_) => {
                bytecode op self.compile_struct_new
                true
            }
            common::OpValue::StructLiteral(_) => {
                bytecode op self.state.store self.compile_struct_literal
                true
            }
            common::OpValue::WhileStart => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileCondition => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileBreak => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileContinue => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileEnd => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            _ => false
        end
    }

    fn compile_value_op
        self:mut$BytecodeCompiler
        op:$common::Op
        type_hint_name:$str
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::PushBool(value) => {
                value common::InstValue::Push bytecode.push
                true
            }
            common::OpValue::PushChar(value) => {
                value common::InstValue::PushChar bytecode.push
                true
            }
            common::OpValue::PushCapture(name) => {
                false = is_global_capture
                std::Option[common::Type]::None = copied_aggregate_type
                if self.function.is_none then
                    f"Capture `{name}` reached global bytecode compilation"
                    self.record_failure_string
                elif name self.capture_slots.get_copy std::Option::Some(capture_index) is then
                    if self.function std::Option::Some(function) is then
                        name.as_str function.global_captures common::string_list_contains = is_global_capture
                        capture_index function.captures.get = capture
                        if capture.typ self.is_copy_aggregate then
                            capture.typ.clone std::Option::Some = copied_aggregate_type
                        fi
                    fi
                    capture_index common::InstValue::CaptureLoad bytecode.push
                    if copied_aggregate_type.clone std::Option::Some(copied_type) is then
                        bytecode op copied_type self.emit_copy_aggregate_for_op
                    fi
                    if
                        op common::op_identity self
                            .state
                            .store
                            .does_op_move_owner
                        is_global_capture ! &&
                        copied_aggregate_type.is_none &&
                    then
                        capture_index common::InstValue::CaptureFlagClear bytecode.push
                    fi
                else
                    f"Capture `{name}` is missing during bytecode compilation"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::PushInt(value) => {
                value.value common::InstValue::Push bytecode.push
                true
            }
            common::OpValue::PushFloat(value) => {
                if "f32" type_hint_name == then
                    value.clone common::InstValue::PushFloat32 bytecode.push
                else
                    value.clone common::InstValue::PushFloat64 bytecode.push
                fi
                true
            }
            common::OpValue::PushStr(value) => {
                value.as_str self.intern_string = string_index
                string_index common::InstValue::PushStr bytecode.push
                true
            }
            common::OpValue::PushVar(name) => {
                op common::op_identity self
                    .state
                    .store
                    .does_op_move_owner = moves_owner
                name.as_str self.resolve_variable = resolved
                false = copied_global_aggregate
                if resolved common::ResolvedVariable::Global(_) is then
                    if op.type_hint std::Option::Some(copied_type) is then
                        if copied_type self.is_copy_aggregate then
                            bytecode resolved.emit_get
                            bytecode op copied_type self.emit_copy_aggregate_for_op
                            true = copied_global_aggregate
                        fi
                    fi
                fi
                if copied_global_aggregate ! then
                    bytecode moves_owner name.as_str self.emit_variable_get
                fi
                if moves_owner then
                    if name self.owner_flags.get_copy std::Option::Some(flag) is then
                        0 common::InstValue::Push bytecode.push
                        flag common::InstValue::LocalSet bytecode.push
                    fi
                fi
                true
            }
            _ => false
        end
    }

    fn compile_op
        self:mut$BytecodeCompiler
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        bytecode:mut$std::List[common::InstValue]
    {
        op.value match
            common::OpValue::IfElif => false
            common::OpValue::IfElse => false
            common::OpValue::IfEnd => false
            common::OpValue::WhileEnd => false
            common::OpValue::MatchArm(_) => false
            common::OpValue::MatchEnd => false
            _ => true
        end = compile_cleanups
        if compile_cleanups then
            bytecode op self.compile_owner_cleanups
        fi
        if bytecode op self.compile_terminal_op then
            return
        fi
        "".to_str = type_hint_name
        if op.type_hint std::Option::Some(type_hint) is then
            type_hint.format = type_hint_name
        fi
        if bytecode type_hint_name.as_str op self.compile_direct_op then
            return
        fi
        if bytecode op self.compile_numeric_op then
            return
        fi
        if bytecode op self.compile_stateful_op then
            return
        fi
        if bytecode op self.compile_callable_op then
            return
        fi
        if bytecode type_hint_name.as_str op_index op targets ops self.compile_structural_op then
            return
        fi
        bytecode type_hint_name.as_str op self.compile_value_op drop
    }
}

# ============================================================================
# Compile ops list
# ============================================================================

impl BytecodeCompiler {
    fn compile_sequence
        self:mut$BytecodeCompiler
        ops:$std::List[common::Op]
        bytecode:mut$std::List[common::InstValue]
    {
        ops precompute_control_flow_targets match
            std::Result::Error(failure) => failure std::Option::Some = self.state.failure
            std::Result::Ok(targets) => {
                0 = index: u64
                while index ops.length > self.has_failed ! && do
                    index ops.get = op
                    bytecode index op targets ops self.compile_op
                    1 += index
                done
            }
        end
    }

    fn compile_sequence_reversed
        self:mut$BytecodeCompiler
        ops:$std::List[common::Op]
        bytecode:mut$std::List[common::InstValue]
    {
        ops precompute_control_flow_targets match
            std::Result::Error(failure) => failure std::Option::Some = self.state.failure
            std::Result::Ok(targets) => {
                ops.length = index
                while 0 index != self.has_failed ! && do
                    1 -= index
                    index ops.get = op
                    bytecode index op targets ops self.compile_op
                done
            }
        end
    }

    fn compile_ops self:mut$BytecodeCompiler bytecode:mut$std::List[common::InstValue] {
        # Function label
        self.new_label = function_label
        function_label common::InstValue::Label bytecode.push

        bytecode self.ops self.compile_sequence
    }
}

# ============================================================================
# Main entry: compile_bytecode
# ============================================================================

fn compile_bytecode_into ops:$std::List[common::Op] state:mut$BytecodeState {
    std::List[common::InstValue]::new = bytecode
    ops state BytecodeCompiler::new = compiler

    # Emit globals init if needed
    if
        compiler.state.global_slots global_slot_count = global_count
        0 global_count !=
    then
        global_count common::InstValue::GlobalsInit bytecode.push
    fi

    bytecode compiler.compile_ops

    # Handle locals for global scope
    compiler.locals_count = locals_count
    if locals_count 0 < then
        std::List[common::InstValue]::new = final_bytecode
        locals_count common::InstValue::LocalsInit final_bytecode.push
        bytecode final_bytecode.append
        locals_count common::InstValue::LocalsUninit final_bytecode.push
        final_bytecode = bytecode
    fi

    bytecode = compiler.state.program.bytecode
    compiler.state.global_slots global_slot_count = compiler.state.program.globals_count
    compiler
        .state
        .constants_table
        .length = compiler.state.program.constants_count
}

fn compile_bytecode
    store:$common::SymbolStore
    ops:$std::List[common::Op]
-> std::Result[common::Program BytecodeFailure] {
    store BytecodeState::new = state
    state ops compile_bytecode_into
    state.into_result
}

pub fn compile_typechecked
    result:mut$typechecker::TypecheckResult
-> std::Result[common::Program BytecodeFailure] {
    if result.diagnostics.has_errors then
        "Bytecode compilation requires error-free typechecking".to_str BytecodeFailure::new std::Result::Error
        return
    fi
    result.ops result.store compile_bytecode
}
