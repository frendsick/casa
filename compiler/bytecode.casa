            .unwrap = payload_types
        0 = index: u64
        while index variant common::EnumVariant::bindings.length > do
            index variant.variant_name.as_str casa_enum compiler.get_enum_field_plan = plan
            common::InstValue::Dup bytecode.push
            plan.offset i64::try_from.unwrap common::InstValue::Push bytecode.push
            common::InstValue::Add bytecode.push
            bytecode plan index payload_types.get compiler.emit_field_load
            index variant common::EnumVariant::bindings.get = var_name
            bytecode var_name.as_str compiler.emit_variable_set
            1 += index
        done
    }
}

impl BytecodeCompiler {
    fn compile_match_op
        self:mut$BytecodeCompiler
        op:$common::Op
        next_arm:mut$std::Option[u64]
        bytecode:mut$std::List[common::InstValue]
        is_last:bool
    {
        op common::pattern_value_of match
            common::PatternValue::Struct(struct_pattern) => {
                bytecode struct_pattern self.state.store self.emit_struct_arm
            }
            common::PatternValue::Literal(literal_pattern) => {
                bytecode next_arm is_last literal_pattern self.emit_literal_arm
            }
            common::PatternValue::EnumVariant(variant) => {
                op pattern::pattern_is_wildcard = is_wildcard
                bytecode next_arm is_last is_wildcard variant self.emit_enum_arm
            }
        end
        if op.value common::OpValue::MatchArm(arm) is then
            if arm.guard_ops.length 0 != then
                bytecode arm.guard_ops self.compile_sequence
                if next_arm std::Option::Some(label) is then
                    label common::InstValue::JumpNe bytecode.push
                else
                    "Guarded match arm has no following label during bytecode compilation" self.record_failure
                fi
            fi
        fi
        op common::op_identity self
            .state
            .store
            .clone_owner_assignments = assignments
        for event in assignments.iter do
            bytecode event.generation event.name.as_str self.set_owner_flag
        done
        bytecode op self.state.store self.compile_match_destruction
    }
}

impl BytecodeCompiler {
    fn compile_match_block
        self:mut$BytecodeCompiler
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        bytecode:mut$std::List[common::InstValue]
    {
        if op.value common::OpValue::MatchArm is then
            0 = end_label: u64
            if op_index targets.get_end std::Option::Some(target_index) is then
                target_index ops.get self.op_to_label = end_label
            else
                "Match end target is missing during bytecode compilation" self.record_failure
                return
            fi

            op_index ops.get common::op_identity self
                .state
                .op_label_map
                .get_copy = existing
            existing.is_some ! = is_first

            if is_first ! then
                bytecode op self.compile_owner_cleanups
                end_label common::InstValue::Jump bytecode.push
                if existing std::Option::Some(label) is then
                    label common::InstValue::Label bytecode.push
                    bytecode op self.compile_owner_cleanups
                else
                    "Match arm label is missing during bytecode compilation" self.record_failure
                fi
            fi

            0 = next_index: u64
            if op_index targets.get_next std::Option::Some(found_next_index) is then
                found_next_index = next_index
            else
                "Match arm target is missing during bytecode compilation" self.record_failure
                return
            fi
            next_index ops.get.value common::OpValue::MatchEnd is = is_last
            std::Option[u64]::None = next_arm
            if is_last ! then
                next_index ops.get self.op_to_label std::Option::Some = next_arm
            fi

            is_last bytecode next_arm op self.compile_match_op
        elif op.value common::OpValue::MatchEnd is then
            op_index ops.get self.op_to_label = end_match_label
            bytecode op self.compile_owner_cleanups
            end_match_label common::InstValue::Label bytecode.push
            bytecode op self.compile_owner_cleanups
        fi
    }
}

