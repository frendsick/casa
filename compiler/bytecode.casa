}

# ============================================================================
# Compile match block
# ============================================================================
# compile_match_op — per-arm bytecode entry point dispatching on PatternValue.
# Replaces the three former compile_match_arm_* helpers and consolidates
# literal / enum / struct emission behind a single pattern-driven function.

impl BytecodeCompiler {
    pub fn emit_struct_arm
        compiler:mut$BytecodeCompiler
        store:$common::SymbolStore
        struct_pattern:common::StructPattern
        bytecode:mut$std::List[common::InstValue]
    {
        struct_pattern common::StructPattern::struct_name store.structs.get = casa_struct_opt
        if casa_struct_opt.is_none then
            f"Struct `{struct_pattern.struct_name}` is missing during bytecode compilation" compiler.record_failure_string
            return
        fi
        casa_struct_opt.unwrap = casa_struct
        0 (u64) = index
        while index casa_struct common::CasaStruct::members.length > do
            index casa_struct common::CasaStruct::members.get = member
            member common::Member::name.as_str = field_name: $str
            index casa_struct compiler.struct_offset = offset
            if
                field_name struct_pattern common::StructPattern::bindings.get_str std::Option::Some(var_name) is
            then
                common::InstValue::Dup bytecode.push
                if 0 offset > then
                    offset (i64) common::InstValue::Push bytecode.push
                    common::InstValue::Add bytecode.push
                fi
                bytecode member.typ compiler.aggregate_field_load
                bytecode var_name.as_str compiler.emit_variable_set
            fi
            1 += index
        done
    }
}

pub fn emit_int_eq value:$i64 bytecode:mut$std::List[common::InstValue] {
    value copy common::InstValue::Push bytecode.push
    common::InstValue::Eq bytecode.push
}

pub fn require_variant_ordinal variant:$common::EnumVariant compiler:mut$BytecodeCompiler -> i64 {
    if variant.ordinal std::Option::Some(ordinal) is then
        ordinal return
    fi
    f"Enum variant `{variant.variant_name}` has no ordinal during bytecode compilation" compiler.record_failure_string
    0
}

impl BytecodeCompiler {
    pub fn emit_literal_arm
        compiler:mut$BytecodeCompiler
        literal_pattern:common::LiteralPattern
        is_last:bool
        next_arm:mut$std::Option[u64]
        bytecode:mut$std::List[common::InstValue]
    {
        if is_last then
            return
        fi
        common::InstValue::Dup bytecode.push
        literal_pattern.value match
            common::LiteralValue::Str(str_value) => {
                str_value.as_str compiler.intern_string = str_index
                str_index common::InstValue::PushStr bytecode.push
                common::InstValue::StrEq bytecode.push
            }
            common::LiteralValue::Int(int_value) => {
                bytecode int_value.value emit_int_eq
            }
            common::LiteralValue::Char(char_value) => {
                bytecode char_value emit_int_eq
            }
            common::LiteralValue::Bool(bool_value) => {
                bytecode bool_value (i64) emit_int_eq
            }
        end
        if next_arm std::Option::Some(label) is then
            label common::InstValue::JumpNe bytecode.push
        else
            "Match arm has no following label during bytecode compilation" compiler.record_failure
        fi
    }
}

impl BytecodeCompiler {
    pub fn emit_enum_arm
        compiler:mut$BytecodeCompiler
        variant:$common::EnumVariant
        is_wildcard:bool
        is_last:bool
        next_arm:mut$std::Option[u64]
        bytecode:mut$std::List[common::InstValue]
    {
        if is_wildcard then
            return
        fi
        variant.enum_name.as_str = enum_name: $str
        if
            "" enum_name.as_str != enum_name compiler
                .state
                .store
                .enums
                .has_str &&
        then
            enum_name compiler
                .state
                .store
                .enums
                .get_str
                .unwrap = casa_enum
            if casa_enum common::has_inner_values then
                if is_last ! then
                    common::InstValue::Dup bytecode.push
                    common::InstValue::Load64 bytecode.push
                    compiler variant require_variant_ordinal common::InstValue::Push bytecode.push
                    common::InstValue::Eq bytecode.push
                    if next_arm std::Option::Some(label) is then
                        label common::InstValue::JumpNe bytecode.push
                    else
                        "Match arm has no following label during bytecode compilation" compiler.record_failure
                    fi
                fi
                casa_enum variant bytecode compiler.emit_enum_arm_bindings
                return
            fi
        fi

        if is_last then
            return
        fi
        common::InstValue::Dup bytecode.push
        compiler variant require_variant_ordinal common::InstValue::Push bytecode.push
        common::InstValue::Eq bytecode.push
        if next_arm std::Option::Some(label) is then
            label common::InstValue::JumpNe bytecode.push
        else
            "Match arm has no following label during bytecode compilation" compiler.record_failure
        fi
    }
}

impl BytecodeCompiler {
    pub fn emit_enum_arm_bindings
        compiler:mut$BytecodeCompiler
        bytecode:mut$std::List[common::InstValue]
        variant:$common::EnumVariant
        casa_enum:$common::CasaEnum
    {
        variant.variant_name casa_enum
            .variant_types
            .get
            .unwrap = payload_types
        0 (u64) = index
        while index variant common::EnumVariant::bindings.length > do
            index variant.variant_name.as_str casa_enum compiler.enum_offset = offset
            common::InstValue::Dup bytecode.push
            offset (i64) common::InstValue::Push bytecode.push
            common::InstValue::Add bytecode.push
            bytecode index payload_types.get compiler.aggregate_field_load
            index variant common::EnumVariant::bindings.get = var_name
            bytecode var_name.as_str compiler.emit_variable_set
            1 += index
        done
    }
}

impl BytecodeCompiler {
    pub fn compile_match_op
        compiler:mut$BytecodeCompiler
        op:$common::Op
        is_last:bool
        next_arm:mut$std::Option[u64]
        bytecode:mut$std::List[common::InstValue]
    {
        op common::pattern_value_of match
            common::PatternValue::Struct(struct_pattern) => {
                bytecode struct_pattern compiler.state.store compiler.emit_struct_arm
            }
            common::PatternValue::Literal(literal_pattern) => {
                bytecode next_arm is_last literal_pattern compiler.emit_literal_arm
            }
            common::PatternValue::EnumVariant(variant) => {
                op pattern::pattern_is_wildcard = is_wildcard
                bytecode next_arm is_last is_wildcard variant compiler.emit_enum_arm
            }
        end
        if op.value common::OpValue::MatchArm(arm) is then
            if arm.guard_ops.length 0 != then
                bytecode arm.guard_ops compiler.compile_sequence
                if next_arm std::Option::Some(label) is then
                    label common::InstValue::JumpNe bytecode.push
                else
                    "Guarded match arm has no following label during bytecode compilation" compiler.record_failure
                fi
            fi
        fi
        if
            op common::op_identity compiler
                .state
                .store
                .clone_ownership std::Option::Some(owned_ownership) is
        then
            for event in owned_ownership.assignments.iter do
                bytecode event.generation event.name.as_str compiler.set_owner_flag
            done
        fi
        bytecode op compiler.state.store compiler.compile_match_destruction
    }
}

impl BytecodeCompiler {
    pub fn compile_match_block
        self:mut$BytecodeCompiler
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        bytecode:mut$std::List[common::InstValue]
    {
        if op.value common::OpValue::MatchArm is then
            0 (u64) = end_label
            if op_index targets.get_end std::Option::Some(target_index) is then
                target_index ops.get self.op_to_label = end_label
            else
                "Match end target is missing during bytecode compilation" self.record_failure
                return
            fi

            op_index ops.get common::op_identity self
                .state
                .op_label_map
                .get_copy = existing
            existing.is_some ! = is_first

            if is_first ! then
                bytecode op self.compile_owner_cleanups
                end_label common::InstValue::Jump bytecode.push
                if existing std::Option::Some(label) is then
                    label common::InstValue::Label bytecode.push
                    bytecode op self.compile_owner_cleanups
                else
                    "Match arm label is missing during bytecode compilation" self.record_failure
                fi
            fi

            0 (u64) = next_index
            if op_index targets.get_next std::Option::Some(found_next_index) is then
                found_next_index = next_index
            else
                "Match arm target is missing during bytecode compilation" self.record_failure
                return
            fi
            next_index ops.get.value common::OpValue::MatchEnd is = is_last
            std::Option[u64]::None = next_arm
            if is_last ! then
                next_index ops.get self.op_to_label std::Option::Some = next_arm
            fi

            bytecode next_arm is_last op self.compile_match_op
        elif op.value common::OpValue::MatchEnd is then
            op_index ops.get self.op_to_label = end_match_label
            bytecode op self.compile_owner_cleanups
            end_match_label common::InstValue::Label bytecode.push
            bytecode op self.compile_owner_cleanups
        fi
    }
}

# ============================================================================
# Compile struct new
# ============================================================================

impl BytecodeCompiler {
    pub fn compile_struct_new
        compiler:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if op.value common::OpValue::StructNew(casa_struct) is then
            casa_struct common::CasaStruct::members.length = count
            casa_struct compiler.struct_size i64::try_from.unwrap common::InstValue::Push bytecode.push
            common::InstValue::HeapAlloc bytecode.push
            0 (u64) = index
            while index count > do
                common::InstValue::Swap bytecode.push
                common::InstValue::Over bytecode.push
                index casa_struct compiler.struct_offset = offset
                if 0 offset > then
                    offset i64::try_from.unwrap common::InstValue::Push bytecode.push
                    common::InstValue::Add bytecode.push
                fi
                index casa_struct.members.get = member
                bytecode member.typ compiler.aggregate_field_store
                1 += index
            done
        fi
    }
}

# ============================================================================
# Compile enum variant
# ============================================================================

impl BytecodeCompiler {
    pub fn compile_enum_variant
        compiler:mut$BytecodeCompiler
        variant:$common::EnumVariant
        casa_enum:$common::CasaEnum
        bytecode:mut$std::List[common::InstValue]
    {
        variant.variant_name.clone = variant_name
        variant_name casa_enum common::CasaEnum::variant_types.get = types_opt
        std::List[common::Type]::new = types
        0 (u64) = inner_count
        if types_opt std::Option::Some(found_types) is then
            for found_type in found_types.iter do
                found_type common::clone_type types.push
            done
            types.length = inner_count
        fi
        # Store inner values from stack into temp locals
        std::List[u64]::new = temps
        0 (u64) = index
        while index inner_count > do
            compiler.allocate_local = local_index
            local_index temps.push
            local_index common::InstValue::LocalSet bytecode.push
            1 += index
        done

        # Allocate heap
        compiler.allocate_local = ptr_local
        casa_enum compiler.enum_size i64::try_from.unwrap common::InstValue::Push bytecode.push
        common::InstValue::HeapAlloc bytecode.push
        ptr_local common::InstValue::LocalSet bytecode.push

        # Store ordinal at offset 0
        compiler variant require_variant_ordinal common::InstValue::Push bytecode.push
        ptr_local common::InstValue::LocalGet bytecode.push
        common::InstValue::Store64 bytecode.push

        # Store inner values at their padded payload offsets.
        # Reversed temp_locals
        0 (u64) = inner_index
        while inner_index inner_count > do
            inner_count 1 - inner_index - = reverse_index
            inner_index variant_name.as_str casa_enum compiler.enum_offset = offset
            ptr_local common::InstValue::LocalGet bytecode.push
            offset (i64) common::InstValue::Push bytecode.push
            common::InstValue::Add bytecode.push
            reverse_index temps.get copy = temp_local
            temp_local common::InstValue::LocalGet bytecode.push
            common::InstValue::Swap bytecode.push
            bytecode inner_index types.get compiler.aggregate_field_store
            1 += inner_index
        done

        # Push pointer
        ptr_local common::InstValue::LocalGet bytecode.push
    }
}

# ============================================================================
# Compile is check
# ============================================================================

impl BytecodeCompiler {
    pub fn compile_is_check
        compiler:mut$BytecodeCompiler
        store:$common::SymbolStore
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if op.value common::OpValue::IsCheck(variant) is then
            variant.enum_name.clone = enum_name
            enum_name store.enums.get = casa_enum_opt
            if casa_enum_opt.is_none then
                f"Enum `{enum_name}` is missing during bytecode compilation" compiler.record_failure_string
                return
            fi
            casa_enum_opt.unwrap = casa_enum

            if casa_enum common::has_inner_values ! then
                # Plain enum: compare ordinal directly
                compiler variant require_variant_ordinal common::InstValue::Push bytecode.push
                common::InstValue::Eq bytecode.push
                return
            fi

            if 0 variant common::EnumVariant::bindings.length == then
                # Data-carrying enum, no bindings: load ordinal and compare
                common::InstValue::Load64 bytecode.push
                compiler variant require_variant_ordinal common::InstValue::Push bytecode.push
                common::InstValue::Eq bytecode.push
                return
            fi

            # Data-carrying enum with bindings
            compiler.allocate_local = temp_ptr

            compiler.new_label = skip_bindings

            # Save enum pointer
            temp_ptr common::InstValue::LocalSet bytecode.push

            # Load ordinal and compare
            temp_ptr common::InstValue::LocalGet bytecode.push
            common::InstValue::Load64 bytecode.push
            compiler variant require_variant_ordinal common::InstValue::Push bytecode.push
            common::InstValue::Eq bytecode.push

            # Duplicate bool
            common::InstValue::Dup bytecode.push
            skip_bindings common::InstValue::JumpNe bytecode.push

            # Extract bindings
            variant.variant_name casa_enum
                .variant_types
                .get
                .unwrap = payload_types
            0 (u64) = index
            while index variant common::EnumVariant::bindings.length > do
                index variant.variant_name.as_str casa_enum compiler.enum_offset = offset
                temp_ptr common::InstValue::LocalGet bytecode.push
                offset (i64) common::InstValue::Push bytecode.push
                common::InstValue::Add bytecode.push
                bytecode index payload_types.get compiler.aggregate_field_load
                index variant common::EnumVariant::bindings.get = var_name
                bytecode var_name.as_str compiler.emit_variable_set
                1 += index
            done

            skip_bindings common::InstValue::Label bytecode.push
        fi
    }
}

# ============================================================================
# Compile struct literal
# ============================================================================

impl BytecodeCompiler {
    pub fn compile_struct_literal
        compiler:mut$BytecodeCompiler
        store:$common::SymbolStore
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if op.value common::OpValue::StructLiteral(literal) is then
            literal.struct_name store.structs.get = casa_struct_opt
            if casa_struct_opt.is_none then
                f"Struct `{literal.struct_name}` is missing during bytecode compilation" compiler.record_failure_string
                return
            fi
            casa_struct_opt.unwrap = casa_struct
            casa_struct common::CasaStruct::members.length = count

            # Store all field values into temp locals (top of stack = last in field_order)
            # Iterate field_order in reverse
            literal common::StructLiteral::field_order.length = field_index
            std::Map[std::String u64]::new = temp_locals
            while 0 field_index != do
                1 -= field_index
                compiler.allocate_local = local_index
                field_index literal common::StructLiteral::field_order.get = field_name
                local_index field_name.clone temp_locals.set
                local_index common::InstValue::LocalSet bytecode.push
            done

            # Allocate struct on heap
            casa_struct compiler.struct_size i64::try_from.unwrap common::InstValue::Push bytecode.push
            common::InstValue::HeapAlloc bytecode.push

            # Store each field at its correct offset
            0 (u64) = member_index
            while member_index casa_struct common::CasaStruct::members.length > do
                member_index casa_struct common::CasaStruct::members.get = member
                member common::Member::name.as_str = member_name: $str
                member_index casa_struct compiler.struct_offset = member_offset
                common::InstValue::Dup bytecode.push
                if 0 member_offset > then
                    member_offset (i64) common::InstValue::Push bytecode.push
                    common::InstValue::Add bytecode.push
                fi
                if member_name temp_locals.get_copy_str std::Option::Some(temp_local) is then
                    temp_local copy common::InstValue::LocalGet bytecode.push
                else
                    f"Struct literal field `{member_name}` has no temporary local during bytecode compilation" compiler.record_failure_string
                    return
                fi
                common::InstValue::Swap bytecode.push
                bytecode member.typ compiler.aggregate_field_store
                1 += member_index
            done
        fi
    }
}

# ============================================================================
# Compile push array
# ============================================================================

pub fn sanitize_fn_name name:$str -> std::String {
    name "::" str::split = parts
    "__" parts.join_strings
}

impl BytecodeCompiler {
    pub fn compile_static_array_fns compiler:mut$BytecodeCompiler items:$std::List[common::Op] {
        for item in items.iter do
            if item common::Op::value common::OpValue::FnPush(fn_name) is then
                fn_name compiler
                    .state
                    .store
                    .functions
                    .get = csa_fn_opt
                if csa_fn_opt std::Option::Some(csa_fn) is then
                    item csa_fn compiler.compile_function
                else
                    f"Function `{fn_name}` is missing during bytecode compilation" compiler.record_failure_string
                fi
            fi
        done
    }
}

impl BytecodeCompiler {
    pub fn compile_static_element
        compiler:mut$BytecodeCompiler
        op:$common::Op
    -> common::StaticArrayElement {
        op common::Op::value match
            common::OpValue::PushInt(val) => {
                val.value common::StaticArrayElement::Imm return
            }
            common::OpValue::PushStr(val) => {
                val.as_str compiler.intern_string = str_idx f"str_{str_idx}" common::StaticArrayElement::Label return
            }
            common::OpValue::PushBool(val) => {
                val common::StaticArrayElement::Imm return
            }
            common::OpValue::PushChar(val) => {
                val common::StaticArrayElement::Imm return
            }
            common::OpValue::PushEnumVariant(ev) => {
                compiler ev require_variant_ordinal common::StaticArrayElement::Imm return
            }
            common::OpValue::FnPush(fn_name) => {
                fn_name.as_str sanitize_fn_name = sanitized_fn
                f"closure_{sanitized_fn}" common::StaticArrayElement::Label return
            }
            _ => {
                "compile_static_element received a non-static operation" compiler.record_failure
                0 common::StaticArrayElement::Imm return
            }
        end
        0 common::StaticArrayElement::Imm
    }
}

impl BytecodeCompiler {
    pub fn compile_static_struct
        self:mut$BytecodeCompiler
        store:$common::SymbolStore
        group_ops:$std::List[common::Op]
    -> std::String {
        if 0 group_ops.length == then
            "Static struct expression group is empty during bytecode compilation" self.record_failure
            "".to_str return
        fi
        group_ops.length 1 - group_ops.get common::Op::value = last_val: $common::OpValue
        "".to_str = static_struct_label
        if last_val common::OpValue::StructLiteral(literal) is then
            literal.struct_name.clone = struct_name
            literal common::StructLiteral::field_order = field_order: $std::List[std::String]
            struct_name store.structs.get = casa_struct_opt
            if casa_struct_opt.is_none then
                f"Struct `{struct_name}` is missing during bytecode compilation" self.record_failure_string
                "".to_str return
            fi
            casa_struct_opt.unwrap = casa_struct

            std::List[common::StaticArrayElement]::new = ordered_elems
            0 (u64) = i
            while i field_order.length > do
                i group_ops.get self.compile_static_element ordered_elems.push
                1 += i
            done

            # Reorder to match struct member definition order
            std::List[common::StaticArrayElement]::new = fields
            0 (u64) = mi
            while mi casa_struct common::CasaStruct::members.length > do
                mi casa_struct common::CasaStruct::members.get common::Member::name.as_str = member_name: $str
                member_name field_order common::string_list_index = fo_idx
                if 0 fo_idx < then
                    f"Static struct field `{member_name}` is missing during bytecode compilation" self.record_failure_string
                    "".to_str return
                fi
                fo_idx (u64) ordered_elems.get.clone fields.push
                1 += mi
            done

            self
                .state
                .program
                .static_structs
                .length = struct_index
            fields common::StaticStruct self
                .state
                .program
                .static_structs
                .push
            f"static_struct_{struct_index}" = static_struct_label
        else
            "compile_static_struct received a non-struct expression group" self.record_failure
        fi
        static_struct_label
    }
}

impl BytecodeCompiler {
    pub fn compile_static_array
        compiler:mut$BytecodeCompiler
        items:$std::List[common::Op]
        bytecode:mut$std::List[common::InstValue]
    {
        items compiler.compile_static_array_fns
        std::List[common::StaticArrayElement]::new = elements
        for item in items.iter do
            item common::Op::value match
                common::OpValue::PushArray(inner_items) => {
                    std::List[common::InstValue]::new = discard_bytecode
                    discard_bytecode inner_items compiler.compile_static_array
                    compiler
                        .state
                        .program
                        .static_arrays
                        .length 1 - = inner_idx
                    f"static_array_{inner_idx}" common::StaticArrayElement::Label elements.push
                }
                common::OpValue::ExprGroup(group_ops) => {
                    group_ops compiler.state.store compiler.compile_static_struct = struct_label
                    struct_label common::StaticArrayElement::Label elements.push
                }
                _ => {
                    item compiler.compile_static_element elements.push
                }
            end
        done
        compiler
            .state
            .program
            .static_arrays
            .length = array_index
        elements common::StaticArray compiler
            .state
            .program
            .static_arrays
            .push
        array_index common::InstValue::PushStaticArray bytecode.push
    }
}

impl BytecodeCompiler {
    pub fn static_array_element_is_word self:$BytecodeCompiler element_type:$common::Type -> bool {
        if self.state.store element_type common::type_inline_size std::Option::Some(element_size) is then
            if
                self.state.store element_type common::type_value_representation std::Option::Some(representation) is
            then
                common::WORD_SIZE element_size ==
                common::VALUE_REPR_RAW representation ==
                common::VALUE_REPR_SIGNED representation == || &&
                return
            fi
        fi
        false
    }

    pub fn can_emit_static_array
        self:$BytecodeCompiler
        op:$common::Op
        items:$std::List[common::Op]
    -> bool {
        if items.is_empty self.state.store items common::op_is_static_array_with_store ! || then
            false return
        fi
        if op.type_hint std::Option::Some(array_type) is then
            if array_type.array_element_type std::Option::Some(element_type) is then
                element_type typechecker::resolve_numeric_literal_default = resolved_type
                resolved_type self.static_array_element_is_word return
            fi
            false return
        fi
        # Compiler unit tests may build an already-word-sized static array op
        # directly without running the typechecker.
        true
    }

    pub fn compile_push_array
        compiler:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if op.value common::OpValue::PushArray(items) is then
            items.length = length

            items op compiler.can_emit_static_array = can_emit_static
            if can_emit_static then
                bytecode items compiler.compile_static_array return
            fi

            common::make_unknown_type common::clone_type = element_type
            if op.type_hint std::Option::Some(array_type) is then
                if array_type.array_element_type std::Option::Some(found_element_type) is then
                    found_element_type typechecker::resolve_numeric_literal_default = element_type
                else
                    "Array literal has no element type during bytecode compilation"
                    compiler.record_failure return
                fi
            else
                "Array literal has no type during bytecode compilation" compiler.record_failure return
            fi

            bytecode items compiler.compile_sequence_reversed

            # An array stores only its elements (ADR-0152), so the allocation
            # is exactly the element storage.
            compiler.allocate_local = list_local
            compiler.state.store element_type common::type_inline_size.unwrap = element_size
            element_size length common::get_array_storage_size i64::try_from.unwrap common::InstValue::Push bytecode.push
            common::InstValue::HeapAlloc bytecode.push
            list_local common::InstValue::LocalSet bytecode.push

            # Store elements starting at offset 0
            compiler.allocate_local = index_local
            0 common::InstValue::Push bytecode.push
            index_local common::InstValue::LocalSet bytecode.push

            compiler.new_label = start_label
            compiler.new_label = end_label

            # while index limit > do
            start_label common::InstValue::Label bytecode.push
            index_local common::InstValue::LocalGet bytecode.push
            length element_size * i64::try_from.unwrap common::InstValue::Push bytecode.push
            common::InstValue::Gt bytecode.push
            end_label common::InstValue::JumpNe bytecode.push

            # list index + typed store
            list_local common::InstValue::LocalGet bytecode.push
            index_local common::InstValue::LocalGet bytecode.push
            common::InstValue::Add bytecode.push
            bytecode element_type compiler.emit_typed_store

            # element_size += index
            index_local common::InstValue::LocalGet bytecode.push
            element_size i64::try_from.unwrap common::InstValue::Push bytecode.push
            common::InstValue::Add bytecode.push
            index_local common::InstValue::LocalSet bytecode.push

            # done
            start_label common::InstValue::Jump bytecode.push
            end_label common::InstValue::Label bytecode.push

            # Push array pointer
            list_local common::InstValue::LocalGet bytecode.push
        fi
    }
}

# ============================================================================
# Compile function call
# ============================================================================

impl BytecodeCompiler {
    pub fn compile_named_function compiler:mut$BytecodeCompiler name:$str op:$common::Op -> bool {
        if
            name compiler
                .state
                .program
                .functions
                .has_str
        then
            true return
        fi
        name compiler
            .state
            .store
            .functions
            .get_str match
            std::Option::Some(function) => {
                op function compiler.compile_function
                compiler.has_failed !
            }
            std::Option::None => {
                f"Function `{name}` is missing during bytecode compilation" compiler.record_failure_string
                false
            }
        end
    }

    pub fn compile_function
        compiler:mut$BytecodeCompiler
        function:$common::Function
        op:$common::Op
    {
        # Compile a function if not already compiled.
        if
            function common::Function::name compiler
                .state
                .program
                .functions
                .has
        then
            return
        fi
        # Mark as being compiled to prevent infinite recursion on recursive calls
        std::List[common::InstValue]::new = function_bytecode
        std::List[common::InstValue]::new function common::Function::name.clone compiler
            .state
            .program
            .functions
            .set
        function.ops function compiler.child = function_compiler
        function_bytecode function_compiler.compile_ops
        if function_compiler.has_failed then
            return
        fi

        # Handle locals
        function_compiler.locals_count = locals_count
        if locals_count 0 < then
            # Build new list with LOCALS_INIT at front
            std::List[common::InstValue]::new = final_bytecode
            locals_count common::InstValue::LocalsInit final_bytecode.push

            function_bytecode.reverse
            while function_bytecode.is_empty ! do
                function_bytecode.pop = instruction
                if instruction common::InstValue::FnReturn is then
                    locals_count common::InstValue::LocalsUninit final_bytecode.push
                fi
                instruction final_bytecode.push
            done
            locals_count common::InstValue::LocalsUninit final_bytecode.push
            common::InstValue::FnReturn final_bytecode.push
            final_bytecode = function_bytecode
        else
            common::InstValue::FnReturn function_bytecode.push
        fi

        function_bytecode function common::Function::name.clone compiler
            .state
            .program
            .functions
            .set
    }
}

impl BytecodeCompiler {
    pub fn ensure_closure_destruction_function
        compiler:mut$BytecodeCompiler
        lambda:$common::Function
        op:$common::Op
    -> std::String {
        f"__drop_closure_{lambda.name}" = drop_name
        if
            drop_name compiler
                .state
                .program
                .functions
                .has
        then
            drop_name return
        fi
        std::List[common::InstValue]::new drop_name.clone compiler
            .state
            .program
            .functions
            .set

        std::List[common::InstValue]::new = body
        lambda.ops lambda compiler.child = destructor
        0 (u64) = capture_index
        while capture_index lambda.captures.length > do
            capture_index lambda.captures.get = capture
            if capture.name.as_str lambda.owned_captures common::string_list_contains then
                destructor.new_label = end_label
                capture_index common::InstValue::CaptureFlagLoad body.push
                0 common::InstValue::Push body.push
                common::InstValue::Ne body.push
                end_label common::InstValue::JumpNe body.push
                capture_index common::InstValue::CaptureLoad body.push
                body op capture.typ destructor.compile_destruction
                end_label common::InstValue::Label body.push
            fi
            1 += capture_index
        done
        common::InstValue::HeapFree body.push
        common::InstValue::FnReturn body.push
        body drop_name.clone compiler
            .state
            .program
            .functions
            .set
        drop_name
    }

    pub fn compile_function_ops
        compiler:mut$BytecodeCompiler
        store:$common::SymbolStore
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        op common::op_str_value = name

        op.value match
            common::OpValue::FnCall => {
                if op name.as_str compiler.compile_named_function then
                    name common::InstValue::FnCall bytecode.push
                fi
            }
            common::OpValue::FnPush => {
                if op name.as_str compiler.compile_named_function ! then
                    return
                fi
                name store
                    .functions
                    .get
                    .unwrap = lambda
                lambda.captures.clone = captures

                # Zero-capture closures share a single static record so trait
                # dispatch and named-function pushes do not allocate per call.
                if 0 captures.length == then
                    name common::InstValue::FnPushStatic bytecode.push
                else
                    # Each capture is followed by its ownership flag. The record
                    # header stores the call and destruction functions.
                    for capture in captures.iter do
                        capture common::Variable::name.as_str = capture_name: $str
                        capture_name.as_str lambda.owned_captures common::string_list_contains = owns_capture
                        if capture_name.as_str compiler.capture_slots.get_copy_str std::Option::Some(capture_index) is then
                            capture_index common::InstValue::CaptureLoad bytecode.push
                            if owns_capture then
                                capture_index common::InstValue::CaptureFlagClear bytecode.push
                            fi
                        else
                            bytecode owns_capture capture_name.as_str compiler.emit_variable_get
                            if owns_capture then
                                if capture_name.as_str compiler.owner_flags.get_copy_str std::Option::Some(flag) is then
                                    0 common::InstValue::Push bytecode.push
                                    flag common::InstValue::LocalSet bytecode.push
                                fi
                            fi
                        fi
                        if owns_capture then 1 else 0 fi common::InstValue::Push bytecode.push
                    done
                    name common::InstValue::FnPush bytecode.push
                    op lambda compiler.ensure_closure_destruction_function = drop_name
                    drop_name common::InstValue::DropFn bytecode.push
                    captures.length common::InstValue::ClosureRecord bytecode.push
                fi
            }
            _ => {
                "compile_function_ops received a non-function operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile enum comparison (data-carrying enums)
# ============================================================================

impl BytecodeCompiler {
    pub fn compile_enum_comparison
        compiler:mut$BytecodeCompiler
        compare_value:common::InstValue
        bytecode:mut$std::List[common::InstValue]
    {
        compiler.allocate_local = local_a
        local_a common::InstValue::LocalSet bytecode.push
        common::InstValue::Load64 bytecode.push
        local_a common::InstValue::LocalGet bytecode.push
        common::InstValue::Load64 bytecode.push
        compare_value bytecode.push
    }
}

# ============================================================================
# Compile single op
# ============================================================================

impl BytecodeCompiler {
    pub fn emit_inline_size
        compiler:mut$BytecodeCompiler
        target:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        if target.has_unresolved_type_var then
            target common::make_hidden_size_parameter_name = size_name
            size_name.as_str compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
        elif compiler.state.store target common::type_inline_size std::Option::Some(size) is then
            size i64::try_from.unwrap common::InstValue::Push bytecode.push
        else
            f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
        fi
    }

    pub fn emit_typed_load
        compiler:mut$BytecodeCompiler
        target:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        if target.has_unresolved_type_var then
            target common::make_hidden_size_parameter_name = size_name
            size_name.as_str compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target common::make_hidden_repr_parameter_name = repr_name
            repr_name.as_str compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            common::InstValue::ReadTyped bytecode.push
            return
        fi
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation == then
                compiler.state.store target common::type_inline_size.unwrap i64::try_from.unwrap
                common::InstValue::Push bytecode.push
                representation i64::try_from.unwrap common::InstValue::Push bytecode.push
                common::InstValue::ReadTyped bytecode.push
                return
            fi
            if compiler.state.store target common::type_inline_size std::Option::Some(size) is then
                if 1 size == then
                    common::InstValue::Load8 bytecode.push
                elif 2 size == then
                    common::InstValue::Load16 bytecode.push
                elif 4 size == then
                    common::InstValue::Load32 bytecode.push
                elif 8 size == then
                    common::InstValue::Load64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure_string
                    return
                fi
                if common::VALUE_REPR_SIGNED representation == then
                    if target common::Type::Builtin(builtin) is then
                        builtin common::InstValue::NormalizeInt bytecode.push
                    fi
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }

    pub fn emit_typed_borrow
        compiler:mut$BytecodeCompiler
        target:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        if target.has_unresolved_type_var then
            target common::make_hidden_size_parameter_name = size_name
            size_name.as_str compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target common::make_hidden_repr_parameter_name = repr_name
            repr_name.as_str compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            common::InstValue::BorrowTyped bytecode.push
            return
        fi
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation != then
                bytecode target compiler.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }

    pub fn emit_typed_copy
        compiler:mut$BytecodeCompiler
        target:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        if target.has_unresolved_type_var then
            target common::make_hidden_size_parameter_name = size_name
            size_name.as_str compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target common::make_hidden_repr_parameter_name = repr_name
            repr_name.as_str compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            common::InstValue::CopyTyped bytecode.push
            return
        fi
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation == then
                bytecode target compiler.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }

    pub fn emit_typed_store
        compiler:mut$BytecodeCompiler
        target:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        if target.has_unresolved_type_var then
            target common::make_hidden_size_parameter_name = size_name
            size_name.as_str compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target common::make_hidden_repr_parameter_name = repr_name
            repr_name.as_str compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            common::InstValue::WriteTyped bytecode.push
            return
        fi
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if compiler.state.store target common::type_inline_size std::Option::Some(size) is then
                if common::VALUE_REPR_INDIRECT representation == then
                    size i64::try_from.unwrap common::InstValue::Push bytecode.push
                    representation i64::try_from.unwrap common::InstValue::Push bytecode.push
                    common::InstValue::WriteTyped bytecode.push
                elif 1 size == then
                    common::InstValue::Store8 bytecode.push
                elif 2 size == then
                    common::InstValue::Store16 bytecode.push
                elif 4 size == then
                    common::InstValue::Store32 bytecode.push
                elif 8 size == then
                    common::InstValue::Store64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure_string
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }
}

impl BytecodeCompiler {
    pub fn compile_temporary_binding
        compiler:mut$BytecodeCompiler
        op:$common::Op
        binding:$common::TemporaryBinding
        bytecode:mut$std::List[common::InstValue]
    {
        if compiler.function.is_some then
            if binding.name.as_str compiler.local_slots.has_str ! then
                compiler.allocate_local = local
                local binding.name.clone compiler.local_slots.set
            fi
        elif
            binding.name.as_str compiler
                .state
                .global_slots
                .has_str !
        then
            compiler
                .state
                .global_slots
                .length = global_slot
            global_slot binding.name.clone compiler
                .state
                .global_slots
                .set
        fi
        std::List[u64]::new = spilled
        0 (u64) = depth
        while depth binding.depth > do
            compiler.allocate_local = local
            local common::InstValue::LocalSet bytecode.push
            local spilled.push
            1 += depth
        done
        if
            op common::op_identity compiler
                .state
                .store
                .clone_ownership std::Option::Some(owned_ownership) is
        then
            for event in owned_ownership.assignments.iter do
                bytecode op event compiler.compile_active_owner_cleanup
            done
        fi
        bytecode binding.name.as_str compiler.emit_variable_set
        bytecode false binding.name.as_str compiler.emit_variable_get
        while spilled.is_empty ! do
            spilled.pop common::InstValue::LocalGet bytecode.push
        done
        if
            op common::op_identity compiler
                .state
                .store
                .clone_ownership std::Option::Some(owned_ownership) is
        then
            for event in owned_ownership.assignments.iter do
                bytecode event.generation event.name.as_str compiler.set_owner_flag
            done
        fi
    }

    fn compile_direct_op
        self:mut$BytecodeCompiler
        op:$common::Op
        type_hint_name:$str
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value common::direct_op_to_inst = direct_inst_opt
        # Check direct op-to-inst mapping first
        direct_inst_opt match
            std::Option::Some(direct_inst) => {
                # Data-carrying enum comparison
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    op.value common::OpValue::Lt is ||
                    op.value common::OpValue::Le is ||
                    op.value common::OpValue::Gt is ||
                    op.value common::OpValue::Ge is ||
                    op.type_hint.is_some &&
                    type_hint_name.as_str self
                        .state
                        .store
                        .enums
                        .has_str &&
                then
                    bytecode direct_inst self.compile_enum_comparison
                    true return
                fi
                # String content comparison
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    "str" type_hint_name.as_str == &&
                then
                    common::InstValue::StrEq bytecode.push
                    if op.value common::OpValue::Ne is then
                        common::InstValue::Not bytecode.push
                    fi
                    true return
                fi
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    "StringStrEq" type_hint_name.as_str == &&
                then
                    common::InstValue::StringStrEq bytecode.push
                    if op.value common::OpValue::Ne is then
                        common::InstValue::Not bytecode.push
                    fi
                    true return
                fi
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    "StrStringEq" type_hint_name.as_str == &&
                then
                    common::InstValue::StrStringEq bytecode.push
                    if op.value common::OpValue::Ne is then
                        common::InstValue::Not bytecode.push
                    fi
                    true return
                fi
                # Data-carrying enum print
                if
                    op.value common::OpValue::PrintInt is type_hint_name.as_str self
                        .state
                        .store
                        .enums
                        .has_str &&
                then
                    common::InstValue::Load64 bytecode.push
                    common::InstValue::PrintInt bytecode.push
                    true return
                fi
                type_hint_name.as_str common::parse_builtin = builtin_hint
                if builtin_hint std::Option::Some(builtin) is then
                    builtin direct_inst op.value.select_typed_instruction bytecode.push
                else
                    direct_inst bytecode.push
                fi
                bytecode op self.emit_integer_normalization
                true return
            }
            std::Option::None => {
            }
        end
        false
    }

    fn compile_wrapping_numeric_op
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        common::InstValue::Swap bytecode.push
        op.value match
            common::OpValue::WrappingAdd => common::InstValue::Add bytecode.push
            common::OpValue::WrappingSub => common::InstValue::Sub bytecode.push
            common::OpValue::WrappingMul => common::InstValue::Mul bytecode.push
            _ => {
            }
        end
        bytecode op self.emit_integer_normalization
    }

    fn compile_numeric_op
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::WrappingAdd => {
                bytecode op self.compile_wrapping_numeric_op
                true
            }
            common::OpValue::WrappingSub => {
                bytecode op self.compile_wrapping_numeric_op
                true
            }
            common::OpValue::WrappingMul => {
                bytecode op self.compile_wrapping_numeric_op
                true
            }
            common::OpValue::NumericConvert(conversion) => {
                conversion.target conversion.source conversion.kind common::NumericConversion common::InstValue::NumericConvert bytecode.push
                true
            }
            common::OpValue::NumericTry(numeric_try) => {
                if numeric_try.source common::Type::Builtin is then
                    numeric_try.target numeric_try.source common::clone_type common::NumericTry common::InstValue::NumericTry bytecode.push
                    f"{common::STD_NAMESPACE}__numeric_try_{numeric_try.target.format}" = wrapper_name
                    if op wrapper_name.as_str self.compile_named_function then
                        wrapper_name common::InstValue::FnCall bytecode.push
                    fi
                else
                    f"Numeric conversion source `{numeric_try.source.format}` was not specialized" self.record_failure_string
                fi
                true
            }
            common::OpValue::IntegerTry(integer_try) => {
                common::InstValue::Swap bytecode.push
                integer_try.target integer_try.kind common::IntegerTry common::InstValue::IntegerTry bytecode.push
                f"{common::STD_NAMESPACE}__numeric_try_{integer_try.target.format}" = wrapper_name
                if op wrapper_name.as_str self.compile_named_function then
                    wrapper_name common::InstValue::FnCall bytecode.push
                fi
                true
            }
            common::OpValue::FloatRound(rounding) => {
                rounding.target rounding.method.clone common::FloatRound common::InstValue::FloatRound bytecode.push
                true
            }
            common::OpValue::FloatFromDecimal => {
                common::InstValue::FloatFromDecimal bytecode.push
                true
            }
            common::OpValue::FloatSignificand => {
                common::InstValue::FloatSignificand bytecode.push
                true
            }
            _ => false
        end
    }

    fn compile_terminal_op
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::Drop => {
                if op.type_hint std::Option::Some(drop_type) is then
                    bytecode op drop_type self.compile_destruction
                else
                    common::InstValue::Drop bytecode.push
                fi
                true
            }
            common::OpValue::FnExecOwned => {
                self.allocate_local = closure_local
                common::InstValue::Dup bytecode.push
                closure_local common::InstValue::LocalSet bytecode.push
                common::InstValue::FnExec bytecode.push
                closure_local common::InstValue::LocalGet bytecode.push
                common::InstValue::ClosureDrop bytecode.push
                true
            }
            _ => false
        end
    }

    fn compile_owned_assignment
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if
            op common::op_identity self
                .state
                .store
                .clone_ownership std::Option::Some(owned_ownership) is
        then
            for event in owned_ownership.assignments.iter do
                bytecode op event self.compile_active_owner_cleanup
            done
        fi
        bytecode op self.compile_assignment
        if
            op common::op_identity self
                .state
                .store
                .clone_ownership std::Option::Some(owned_ownership) is
        then
            for event in owned_ownership.assignments.iter do
                bytecode event.generation event.name.as_str self.set_owner_flag
            done
        fi
    }

    fn compile_stateful_op
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::BindTemporary(binding) => {
                bytecode binding op self.compile_temporary_binding
                true
            }
            common::OpValue::AssignDec(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::AssignInc(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::AssignVar(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::Question(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::QuestionMove(hidden_name) => {
                if hidden_name self.owner_flags.get_copy std::Option::Some(flag) is then
                    0 common::InstValue::Push bytecode.push
                    flag common::InstValue::LocalSet bytecode.push
                fi
                true
            }
            _ => false
        end
    }

    fn compile_callable_op
        self:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::FstringConcat(count) => {
                count common::InstValue::FstringConcat bytecode.push
                true
            }
            common::OpValue::PrimitiveToStr(builtin) => {
                builtin copy common::InstValue::PrimitiveToStr bytecode.push
                true
            }
            common::OpValue::FstringToStr => true
            common::OpValue::DestructionFn(target) => {
                if target self.destruction_needs_function then
                    op target self.ensure_destruction_function = drop_name
                    drop_name common::InstValue::DropFn bytecode.push
                else
                    0 common::InstValue::Push bytecode.push
                fi
                true
            }
            common::OpValue::FnCall(_) => {
                bytecode op self.state.store self.compile_function_ops
                true
            }
            common::OpValue::FnPush(function_name) => {
                function_name self
                    .state
                    .store
                    .functions
                    .get = function_opt
                false = has_deferred_methods
                if function_opt std::Option::Some(function) is then
                    function.has_deferred_methods = has_deferred_methods
                fi
                if has_deferred_methods then
                    0 common::InstValue::Push bytecode.push
                else
                    bytecode op self.state.store self.compile_function_ops
                fi
                true
            }
            common::OpValue::Identifier(name) => {
                f"Identifier `{name}` reached bytecode compilation unresolved"
                self.record_failure_string
                true
            }
            common::OpValue::Copy => {
                if op.type_hint std::Option::Some(copied_type) is then
                    bytecode copied_type self.emit_typed_copy
                fi
                true
            }
            common::OpValue::MethodCall(_) => {
                "Method call reached bytecode compilation before typechecker lowering"
                self.record_failure
                true
            }
            common::OpValue::QualifiedMethodCall(_) => {
                "Method call reached bytecode compilation before typechecker lowering"
                self.record_failure
                true
            }
            common::OpValue::TraitMethodCall(_) => {
                "Trait operation reached bytecode compilation before monomorphization"
                self.record_failure
                true
            }
            common::OpValue::TraitMethodRef(_) => {
                "Trait operation reached bytecode compilation before monomorphization"
                self.record_failure
                true
            }
            common::OpValue::Print => {
                "Generic print reached bytecode compilation before typechecker lowering"
                self.record_failure
                true
            }
            _ => false
        end
    }

    fn compile_structural_op
        self:mut$BytecodeCompiler
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        type_hint_name:$str
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::IfStart => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfCondition => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfElif => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfElse => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfEnd => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::ImportFile(_) => true
            common::OpValue::ImportFileSelective(_) => true
            common::OpValue::TypeCast(_) => true
            common::OpValue::PtrIntoRaw => true
            common::OpValue::DeclareGlobal(_) => true
            common::OpValue::InitGlobal(initializer) => {
                bytecode initializer.ops self.compile_sequence
                bytecode initializer.name.as_str self.emit_variable_set
                true
            }
            common::OpValue::OwnerCleanup => true
            common::OpValue::PushEnumVariant(variant) => {
                if
                    variant.enum_name self
                        .state
                        .store
                        .enums
                        .get std::Option::Some(owned_enum) is
                then
                    if owned_enum common::has_inner_values then
                        bytecode owned_enum variant self.compile_enum_variant
                    else
                        self variant require_variant_ordinal common::InstValue::Push bytecode.push
                    fi
                else
                    f"Enum `{variant.enum_name}` is missing during bytecode compilation"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::IsCheck(_) => {
                bytecode op self.state.store self.compile_is_check
                true
            }
            common::OpValue::MatchStart => {
                bytecode op_index op targets ops self.compile_match_block
                true
            }
            common::OpValue::MatchArm(_) => {
                bytecode op_index op targets ops self.compile_match_block
                true
            }
            common::OpValue::MatchEnd => {
                bytecode op_index op targets ops self.compile_match_block
                true
            }
            common::OpValue::Typeof => {
                type_hint_name self.intern_string = typeof_index
                common::InstValue::Drop bytecode.push
                typeof_index common::InstValue::PushStr bytecode.push
                common::InstValue::PrintStr bytecode.push
                true
            }
            common::OpValue::SizeOf(target_type) => {
                if self.state.store target_type common::type_inline_size std::Option::Some(size) is then
                    if size i64::try_from std::Option::Some(signed_size) is then
                        signed_size common::InstValue::Push bytecode.push
                    else
                        f"Inline size of `{target_type.format}` exceeds the supported constant range"
                        self.record_failure_string
                    fi
                else
                    f"Cannot determine inline size of `{target_type.format}`"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::PtrRead(target_type) => {
                bytecode target_type self.emit_typed_load
                true
            }
            common::OpValue::PtrWrite(target_type) => {
                bytecode target_type self.emit_typed_store
                true
            }
            common::OpValue::PtrAsRef(target_type) => {
                bytecode target_type self.emit_typed_borrow
                true
            }
            common::OpValue::PtrAsMut(target_type) => {
                bytecode target_type self.emit_typed_borrow
                true
            }
            common::OpValue::PushArray(_) => {
                bytecode op self.compile_push_array
                true
            }
            common::OpValue::ExprGroup(group_ops) => {
                bytecode group_ops self.compile_sequence
                true
            }
            common::OpValue::StructNew(_) => {
                bytecode op self.compile_struct_new
                true
            }
            common::OpValue::StructLiteral(_) => {
                bytecode op self.state.store self.compile_struct_literal
                true
            }
            common::OpValue::WhileStart => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileCondition => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileBreak => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileContinue => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileEnd => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            _ => false
        end
    }

    fn compile_value_op
        self:mut$BytecodeCompiler
        op:$common::Op
        type_hint_name:$str
        bytecode:mut$std::List[common::InstValue]
    -> bool {
        op.value match
            common::OpValue::PushBool(value) => {
                value common::InstValue::Push bytecode.push
                true
            }
            common::OpValue::PushChar(value) => {
                value common::InstValue::PushChar bytecode.push
                true
            }
            common::OpValue::PushCapture(name) => {
                if self.function.is_none then
                    f"Capture `{name}` reached global bytecode compilation"
                    self.record_failure_string
                elif name self.capture_slots.get_copy std::Option::Some(capture_index) is then
                    capture_index common::InstValue::CaptureLoad bytecode.push
                    if
                        op common::op_identity self
                            .state
                            .store
                            .clone_ownership
                        std::Option::Some(owned_ownership) is
                    then
                        if owned_ownership.moves_owner then
                            capture_index common::InstValue::CaptureFlagClear bytecode.push
                        fi
                    fi
                else
                    f"Capture `{name}` is missing during bytecode compilation"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::PushInt(value) => {
                value.value common::InstValue::Push bytecode.push
                true
            }
            common::OpValue::PushFloat(value) => {
                if "f32" type_hint_name == then
                    value.clone common::InstValue::PushFloat32 bytecode.push
                else
                    value.clone common::InstValue::PushFloat64 bytecode.push
                fi
                true
            }
            common::OpValue::PushStr(value) => {
                value.as_str self.intern_string = string_index
                string_index common::InstValue::PushStr bytecode.push
                true
            }
            common::OpValue::PushVar(name) => {
                false = moves_owner
                if
                    op common::op_identity self
                        .state
                        .store
                        .clone_ownership std::Option::Some(owned_ownership) is
                then
                    owned_ownership.moves_owner = moves_owner
                fi
                bytecode moves_owner name.as_str self.emit_variable_get
                if moves_owner then
                    if name self.owner_flags.get_copy std::Option::Some(flag) is then
                        0 common::InstValue::Push bytecode.push
                        flag common::InstValue::LocalSet bytecode.push
                    fi
                fi
                true
            }
            _ => false
        end
    }

    pub fn compile_op
        self:mut$BytecodeCompiler
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        bytecode:mut$std::List[common::InstValue]
    {
        op.value match
            common::OpValue::IfElif => false
            common::OpValue::IfElse => false
            common::OpValue::IfEnd => false
            common::OpValue::WhileEnd => false
            common::OpValue::MatchArm(_) => false
            common::OpValue::MatchEnd => false
            _ => true
        end = compile_cleanups
        if compile_cleanups then
            bytecode op self.compile_owner_cleanups
        fi
        if bytecode op self.compile_terminal_op then
            return
        fi
        "".to_str = type_hint_name
        if op.type_hint std::Option::Some(type_hint) is then
            type_hint.format = type_hint_name
        fi
        if bytecode type_hint_name.as_str op self.compile_direct_op then
            return
        fi
        if bytecode op self.compile_numeric_op then
            return
        fi
        if bytecode op self.compile_stateful_op then
            return
        fi
        if bytecode op self.compile_callable_op then
            return
        fi
        if bytecode type_hint_name.as_str op_index op targets ops self.compile_structural_op then
            return
        fi
        bytecode type_hint_name.as_str op self.compile_value_op drop
    }
}

# ============================================================================
# Compile ops list
# ============================================================================

impl BytecodeCompiler {
    fn compile_sequence
        self:mut$BytecodeCompiler
        ops:$std::List[common::Op]
        bytecode:mut$std::List[common::InstValue]
    {
        ops precompute_control_flow_targets match
            std::Result::Error(failure) => failure std::Option::Some = self.state.failure
            std::Result::Ok(targets) => {
                0 (u64) = index
                while index ops.length > self.has_failed ! && do
                    index ops.get = op
                    bytecode index op targets ops self.compile_op
                    1 += index
                done
            }
        end
    }

    fn compile_sequence_reversed
        self:mut$BytecodeCompiler
        ops:$std::List[common::Op]
        bytecode:mut$std::List[common::InstValue]
    {
        ops precompute_control_flow_targets match
            std::Result::Error(failure) => failure std::Option::Some = self.state.failure
            std::Result::Ok(targets) => {
                ops.length = index
                while 0 index != self.has_failed ! && do
                    1 -= index
                    index ops.get = op
                    bytecode index op targets ops self.compile_op
                done
            }
        end
    }

    pub fn compile_ops self:mut$BytecodeCompiler bytecode:mut$std::List[common::InstValue] {
        # Function label
        self.new_label = function_label
        function_label common::InstValue::Label bytecode.push

        self.ops common::clone_ops = ops
        bytecode ops self.compile_sequence
    }
}

# ============================================================================
# Main entry: compile_bytecode
# ============================================================================

pub fn compile_bytecode_into ops:$std::List[common::Op] state:mut$BytecodeState {
    std::List[common::InstValue]::new = bytecode
    ops state BytecodeCompiler::new = compiler

    # Emit globals init if needed
    if
        compiler.state.global_slots global_slot_count = global_count
        0 global_count !=
    then
        global_count common::InstValue::GlobalsInit bytecode.push
    fi

    bytecode compiler.compile_ops

    # Handle locals for global scope
    compiler.locals_count = locals_count
    if locals_count 0 < then
        std::List[common::InstValue]::new = final_bytecode
        locals_count common::InstValue::LocalsInit final_bytecode.push
        bytecode final_bytecode.append
        locals_count common::InstValue::LocalsUninit final_bytecode.push
        final_bytecode = bytecode
    fi

    bytecode = compiler.state.program.bytecode
    compiler.state.global_slots global_slot_count = compiler.state.program.globals_count
    compiler
        .state
        .constants_table
        .length = compiler.state.program.constants_count
}

pub fn compile_bytecode
    store:$common::SymbolStore
    ops:$std::List[common::Op]
-> std::Result[common::Program BytecodeFailure] {
    store BytecodeState::new = state
    state ops compile_bytecode_into
    state.into_result
}

pub fn compile_typechecked
    result:mut$typechecker::TypecheckResult
-> std::Result[common::Program BytecodeFailure] {
    if result.diagnostics.has_errors then
        "Bytecode compilation requires error-free typechecking".to_str BytecodeFailure::new std::Result::Error
        return
    fi
    result.ops result.store compile_bytecode
}
