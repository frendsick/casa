}

# ============================================================================
# Compile enum variant
# ============================================================================

impl BytecodeCompiler {
    fn compile_enum_variant
        compiler:mut$BytecodeCompiler
        variant:mut$EnumVariant
        casa_enum:mut$CasaEnum
        bytecode:mut$List[InstValue]
    {
        variant.variant_name = variant_name
        variant_name casa_enum CasaEnum::variant_types.get = types_opt
        List[Type]::new = types
        0 (u64) = inner_count
        if types_opt Option::Some(found_types) is then
            for found_type in found_types.iter do
                found_type clone_type types.push
            done
            types.length = inner_count
        fi
        # Store inner values from stack into temp locals
        List[u64]::new = temps
        0 (u64) = index
        while index inner_count > do
            compiler.locals_count = local_index
            1 += compiler.locals_count
            local_index temps.push
            local_index InstValue::LocalSet bytecode.push
            1 += index
        done

        # Allocate heap
        compiler.locals_count = ptr_local
        1 += compiler.locals_count
        casa_enum compiler.enum_size i64::try_from.unwrap InstValue::Push bytecode.push
        InstValue::HeapAlloc bytecode.push
        ptr_local InstValue::LocalSet bytecode.push

        # Store ordinal at offset 0
        compiler variant require_variant_ordinal InstValue::Push bytecode.push
        ptr_local InstValue::LocalGet bytecode.push
        InstValue::Store64 bytecode.push

        # Store inner values at their padded payload offsets.
        # Reversed temp_locals
        0 (u64) = inner_index
        while inner_index inner_count > do
            inner_count 1 - inner_index - = reverse_index
            inner_index variant_name casa_enum compiler.enum_offset = offset
            ptr_local InstValue::LocalGet bytecode.push
            offset (i64) InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            reverse_index temps.get = temp_local
            temp_local InstValue::LocalGet bytecode.push
            InstValue::Swap bytecode.push
            bytecode inner_index types.get compiler.aggregate_field_store
            1 += inner_index
        done

        # Push pointer
        ptr_local InstValue::LocalGet bytecode.push
    }
}

# ============================================================================
# Compile is check
# ============================================================================

impl BytecodeCompiler {
    fn compile_is_check compiler:mut$BytecodeCompiler op:mut$Op bytecode:mut$List[InstValue] {
        if op.value OpValue::IsCheck(variant) is then
            variant.enum_name.clone = enum_name
            enum_name compiler.store.clone_enum = casa_enum_opt
            if casa_enum_opt.is_none then
                f"Enum `{enum_name}` is missing during bytecode compilation" compiler.record_failure
                return
            fi
            casa_enum_opt.unwrap = casa_enum

            if casa_enum has_inner_values ! then
                # Plain enum: compare ordinal directly
                compiler variant require_variant_ordinal InstValue::Push bytecode.push
                InstValue::Eq bytecode.push
                return
            fi

            if 0 variant EnumVariant::bindings.length == then
                # Data-carrying enum, no bindings: load ordinal and compare
                InstValue::Load64 bytecode.push
                compiler variant require_variant_ordinal InstValue::Push bytecode.push
                InstValue::Eq bytecode.push
                return
            fi

            # Data-carrying enum with bindings
            compiler.locals_count = temp_ptr
            1 += compiler.locals_count

            compiler.new_label = skip_bindings

            # Save enum pointer
            temp_ptr InstValue::LocalSet bytecode.push

            # Load ordinal and compare
            temp_ptr InstValue::LocalGet bytecode.push
            InstValue::Load64 bytecode.push
            compiler variant require_variant_ordinal InstValue::Push bytecode.push
            InstValue::Eq bytecode.push

            # Duplicate bool
            InstValue::Dup bytecode.push
            skip_bindings InstValue::JumpNe bytecode.push

            # Extract bindings
            variant.variant_name casa_enum
                .variant_types
                .get
                .unwrap = payload_types
            0 (u64) = index
            while index variant EnumVariant::bindings.length > do
                index variant.variant_name casa_enum compiler.enum_offset = offset
                temp_ptr InstValue::LocalGet bytecode.push
                offset (i64) InstValue::Push bytecode.push
                InstValue::Add bytecode.push
                bytecode index payload_types.get compiler.aggregate_field_load
                index variant EnumVariant::bindings.get = var_name
                var_name compiler.resolve_variable = resolved
                bytecode resolved.emit_set
                1 += index
            done

            skip_bindings InstValue::Label bytecode.push
        fi
    }
}

# ============================================================================
# Compile struct literal
# ============================================================================

impl BytecodeCompiler {
    fn compile_struct_literal compiler:mut$BytecodeCompiler op:mut$Op bytecode:mut$List[InstValue] {
        if op.value OpValue::StructLiteral(literal) is then
            literal.struct_name compiler.store.clone_struct = casa_struct_opt
            if casa_struct_opt.is_none then
                f"Struct `{literal.struct_name}` is missing during bytecode compilation" compiler.record_failure
                return
            fi
            casa_struct_opt.unwrap = casa_struct
            casa_struct CasaStruct::members.length = count

            # Store all field values into temp locals (top of stack = last in field_order)
            # Iterate field_order in reverse
            literal StructLiteral::field_order.length = field_index
            Map[str u64]::new = temp_locals
            while 0 field_index != do
                1 -= field_index
                compiler.locals_count = local_index
                1 += compiler.locals_count
                field_index literal StructLiteral::field_order.get = field_name
                local_index field_name.clone temp_locals.set
                local_index InstValue::LocalSet bytecode.push
            done

            # Allocate struct on heap
            casa_struct compiler.struct_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::HeapAlloc bytecode.push

            # Store each field at its correct offset
            0 (u64) = member_index
            while member_index casa_struct CasaStruct::members.length > do
                member_index casa_struct CasaStruct::members.get = member
                member Member::name = member_name
                member_index casa_struct compiler.struct_offset = member_offset
                InstValue::Dup bytecode.push
                if 0 member_offset > then
                    member_offset (i64) InstValue::Push bytecode.push
                    InstValue::Add bytecode.push
                fi
                if member_name temp_locals.get Option::Some(temp_local) is then
                    temp_local copy InstValue::LocalGet bytecode.push
                else
                    f"Struct literal field `{member_name}` has no temporary local during bytecode compilation" compiler.record_failure
                    return
                fi
                InstValue::Swap bytecode.push
                bytecode member.typ compiler.aggregate_field_store
                1 += member_index
            done
        fi
    }
}

# ============================================================================
# Compile push array
# ============================================================================

fn sanitize_fn_name name:mut$str -> str {
    name "::" str::split = parts
    "__" parts.join
}

impl BytecodeCompiler {
    fn compile_static_array_fns compiler:mut$BytecodeCompiler items:mut$List[Op] {
        for item in items.iter do
            if item Op::value OpValue::FnPush(fn_name) is then
                fn_name compiler
                    .store
                    .functions
                    .get = csa_fn_opt
                if csa_fn_opt Option::Some(csa_fn) is then
                    item csa_fn compiler.compile_function
                else
                    f"Function `{fn_name}` is missing during bytecode compilation" compiler.record_failure
                fi
            fi
        done
    }
}

impl BytecodeCompiler {
    fn compile_static_element compiler:mut$BytecodeCompiler op:mut$Op -> StaticArrayElement {
        op Op::value match
            OpValue::PushInt(val) => {
                val.value StaticArrayElement::Imm return
            }
            OpValue::PushStr(val) => {
                val compiler.intern_string = str_idx f"str_{str_idx}" StaticArrayElement::Label return
            }
            OpValue::PushBool(val) => {
                val StaticArrayElement::Imm return
            }
            OpValue::PushChar(val) => {
                val StaticArrayElement::Imm return
            }
            OpValue::PushEnumVariant(ev) => {
                compiler ev require_variant_ordinal StaticArrayElement::Imm return
            }
            OpValue::FnPush(fn_name) => {
                fn_name sanitize_fn_name = sanitized_fn
                f"closure_{sanitized_fn}" StaticArrayElement::Label return
            }
            _ => {
                "compile_static_element received a non-static operation" compiler.record_failure
                0 StaticArrayElement::Imm return
            }
        end
        0 StaticArrayElement::Imm
    }
}

impl BytecodeCompiler {
    fn compile_static_struct compiler:mut$BytecodeCompiler group_ops:List[Op] -> str {
        if 0 group_ops.length == then
            "Static struct expression group is empty during bytecode compilation" compiler.record_failure
            "" return
        fi
        group_ops.length 1 - group_ops.get Op::value = last_val
        "" = static_struct_label
        if last_val OpValue::StructLiteral(literal) is then
            literal.struct_name.clone = struct_name
            literal StructLiteral::field_order = field_order
            struct_name compiler.store.clone_struct = casa_struct_opt
            if casa_struct_opt.is_none then
                f"Struct `{struct_name}` is missing during bytecode compilation" compiler.record_failure
                "" return
            fi
            casa_struct_opt.unwrap = casa_struct

            List[StaticArrayElement]::new = ordered_elems
            0 (u64) = i
            while i field_order.length > do
                i group_ops.get compiler.compile_static_element ordered_elems.push
                1 += i
            done

            # Reorder to match struct member definition order
            List[StaticArrayElement]::new = fields
            0 (u64) = mi
            while mi casa_struct CasaStruct::members.length > do
                mi casa_struct CasaStruct::members.get Member::name = member_name
                member_name field_order string_list_index = fo_idx
                if 0 fo_idx < then
                    f"Static struct field `{member_name}` is missing during bytecode compilation" compiler.record_failure
                    "" return
                fi
                fo_idx (u64) ordered_elems.get.clone fields.push
                1 += mi
            done

            compiler.static_structs.length = struct_index
            fields StaticStruct compiler.static_structs.push
            f"static_struct_{struct_index}" = static_struct_label
        else
            "compile_static_struct received a non-struct expression group" compiler.record_failure
        fi
        static_struct_label
    }
}

impl BytecodeCompiler {
    fn compile_static_array
        compiler:mut$BytecodeCompiler
        items:mut$List[Op]
        bytecode:mut$List[InstValue]
    {
        items compiler.compile_static_array_fns
        List[StaticArrayElement]::new = elements
        for item in items.iter do
            item Op::value match
                OpValue::PushArray(inner_items) => {
                    List[InstValue]::new = discard_bytecode
                    discard_bytecode inner_items compiler.compile_static_array
                    compiler.static_arrays.length 1 - = inner_idx
                    f"static_array_{inner_idx}" StaticArrayElement::Label elements.push
                }
                OpValue::ExprGroup(group_ops) => {
                    group_ops compiler.compile_static_struct = struct_label
                    struct_label StaticArrayElement::Label elements.push
                }
                _ => {
                    item compiler.compile_static_element elements.push
                }
            end
        done
        compiler.static_arrays.length = array_index
        elements StaticArray compiler.static_arrays.push
        array_index InstValue::PushStaticArray bytecode.push
    }
}

impl BytecodeCompiler {
    fn compile_push_array compiler:mut$BytecodeCompiler op:mut$Op bytecode:mut$List[InstValue] {
        if op.value OpValue::PushArray(items) is then
            items.length = length

            false = can_emit_static
            if 0 length != compiler.store items op_is_static_array_with_store && then
                if op.type_hint Option::Some(array_type) is then
                    if array_type.array_element_type Option::Some(static_element_type) is then
                        static_element_type resolve_numeric_literal_default = resolved_static_type
                        if compiler.store resolved_static_type type_inline_size Option::Some(static_size) is then
                            if compiler.store resolved_static_type type_value_representation Option::Some(static_repr) is then
                                if
                                    8 static_size ==
                                    VALUE_REPR_RAW static_repr ==
                                    VALUE_REPR_SIGNED static_repr == || &&
                                then
                                    true = can_emit_static
                                fi
                            fi
                        fi
                    fi
                else
                    # Compiler unit tests may build an already-word-sized static
                    # array op directly without running the typechecker.
                    true = can_emit_static
                fi
            fi
            if can_emit_static then
                bytecode items compiler.compile_static_array return
            fi

            TYPE_UNKNOWN_T = element_type
            if op.type_hint Option::Some(array_type) is then
                if array_type.array_element_type Option::Some(found_element_type) is then
                    found_element_type resolve_numeric_literal_default = element_type
                else
                    "Array literal has no element type during bytecode compilation"
                    compiler.record_failure return
                fi
            else
                "Array literal has no type during bytecode compilation" compiler.record_failure return
            fi

            # Compile items in reverse order
            length = reverse_index
            while 0 reverse_index != do
                1 -= reverse_index
                reverse_index items.get = item
                bytecode reverse_index item compiler.compile_op
            done

            # An array stores only its elements (ADR-0152), so the allocation
            # is exactly the element storage.
            compiler.locals_count = list_local
            1 += compiler.locals_count
            compiler.store element_type type_inline_size.unwrap = element_size
            element_size length get_array_storage_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::HeapAlloc bytecode.push
            list_local InstValue::LocalSet bytecode.push

            # Store elements starting at offset 0
            compiler.locals_count = index_local
            1 += compiler.locals_count
            0 InstValue::Push bytecode.push
            index_local InstValue::LocalSet bytecode.push

            compiler.new_label = start_label
            compiler.new_label = end_label

            # while index limit > do
            start_label InstValue::Label bytecode.push
            index_local InstValue::LocalGet bytecode.push
            length element_size * i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Gt bytecode.push
            end_label InstValue::JumpNe bytecode.push

            # list index + typed store
            list_local InstValue::LocalGet bytecode.push
            index_local InstValue::LocalGet bytecode.push
            InstValue::Add bytecode.push
            bytecode element_type compiler.emit_typed_store

            # element_size += index
            index_local InstValue::LocalGet bytecode.push
            element_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            index_local InstValue::LocalSet bytecode.push

            # done
            start_label InstValue::Jump bytecode.push
            end_label InstValue::Label bytecode.push

            # Push array pointer
            list_local InstValue::LocalGet bytecode.push
        fi
    }
}

# ============================================================================
# Compile function call
# ============================================================================

impl BytecodeCompiler {
    fn compile_named_function compiler:mut$BytecodeCompiler name:mut$str op:mut$Op -> bool {
        if name compiler.function_bytecode.has then
            true return
        fi
        name compiler
            .store
            .functions
            .remove = function_opt
        if function_opt.is_none then
            f"Function `{name}` is missing during bytecode compilation" compiler.record_failure
            false return
        fi
        function_opt.unwrap = function
        function.clone_declaration name.clone compiler
            .store
            .functions
            .set
        op function compiler.compile_function
        function name.clone compiler
            .store
            .functions
            .set
        compiler.has_failed !
    }

    fn compile_function compiler:mut$BytecodeCompiler function:mut$Function op:mut$Op {
        # Compile a function if not already compiled.
        if function Function::name compiler.function_bytecode.has then
            return
        fi
        function.take_ops = ops

        # Mark as being compiled to prevent infinite recursion on recursive calls
        List[InstValue]::new = function_bytecode
        List[InstValue]::new function Function::name compiler.function_bytecode.set
        ops function compiler.child = function_compiler
        function_bytecode function_compiler.compile_ops
        function_compiler compiler.absorb_child
        ops function Function::set_ops
        if compiler.has_failed then
            return
        fi

        # Handle locals
        function_compiler.locals_count = locals_count
        if locals_count 0 < then
            # Build new list with LOCALS_INIT at front
            List[InstValue]::new = final_bytecode
            locals_count InstValue::LocalsInit final_bytecode.push

            function_bytecode.reverse
            while function_bytecode.is_empty ! do
                function_bytecode.pop = instruction
                if instruction InstValue::FnReturn is then
                    locals_count InstValue::LocalsUninit final_bytecode.push
                fi
                instruction final_bytecode.push
            done
            locals_count InstValue::LocalsUninit final_bytecode.push
            InstValue::FnReturn final_bytecode.push
            final_bytecode = function_bytecode
        else
            InstValue::FnReturn function_bytecode.push
        fi

        function_bytecode function Function::name compiler.function_bytecode.set
    }
}

impl BytecodeCompiler {
    fn compile_function_ops compiler:mut$BytecodeCompiler op:mut$Op bytecode:mut$List[InstValue] {
        op op_str_value = name

        op.value match
            OpValue::FnCall => {
                if op name compiler.compile_named_function then
                    name InstValue::FnCall bytecode.push
                fi
            }
            OpValue::FnPush => {
                if op name compiler.compile_named_function ! then
                    return
                fi
                name compiler
                    .store
                    .functions
                    .get
                    .unwrap
                    .captures
                    .clone = captures

                # Zero-capture closures share a single static record so trait
                # dispatch and named-function pushes do not allocate per call.
                if 0 captures.length == then
                    name InstValue::FnPushStatic bytecode.push
                else
                    # Captures are pushed before the function pointer so InstClosureRecord
                    # pops fn_ptr first into record[0] and then captures into record[1..].
                    for capture in captures.iter do
                        capture Variable::name = capture_name
                        if capture_name compiler.capture_slots.get Option::Some(capture_index) is then
                            capture_index InstValue::CaptureLoad bytecode.push
                        else
                            capture_name compiler.resolve_variable = capture_resolved
                            bytecode capture_resolved.emit_get
                        fi
                    done
                    name InstValue::FnPush bytecode.push
                    captures.length InstValue::ClosureRecord bytecode.push
                fi
            }
            _ => {
                "compile_function_ops received a non-function operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile enum comparison (data-carrying enums)
# ============================================================================

impl BytecodeCompiler {
    fn compile_enum_comparison
        compiler:mut$BytecodeCompiler
        compare_value:InstValue
        bytecode:mut$List[InstValue]
    {
        compiler.locals_count = local_a
        1 += compiler.locals_count
        local_a InstValue::LocalSet bytecode.push
        InstValue::Load64 bytecode.push
        local_a InstValue::LocalGet bytecode.push
        InstValue::Load64 bytecode.push
        compare_value bytecode.push
    }
}

# ============================================================================
# Compile single op
# ============================================================================

impl BytecodeCompiler {
    fn emit_inline_size compiler:mut$BytecodeCompiler target:$Type bytecode:mut$List[InstValue] {
        if target.has_unresolved_type_var then
            target make_hidden_size_parameter_name compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
        elif compiler.store target type_inline_size Option::Some(size) is then
            size i64::try_from.unwrap InstValue::Push bytecode.push
        else
            f"Cannot determine inline size of `{target.format}`" compiler.record_failure
        fi
    }

    fn emit_typed_load compiler:mut$BytecodeCompiler target:$Type bytecode:mut$List[InstValue] {
        if target.has_unresolved_type_var then
            target make_hidden_size_parameter_name compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target make_hidden_repr_parameter_name compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            InstValue::ReadTyped bytecode.push
            return
        fi
        if compiler.store target type_value_representation Option::Some(representation) is then
            if VALUE_REPR_INDIRECT representation == then
                compiler.store target type_inline_size.unwrap i64::try_from.unwrap
                InstValue::Push bytecode.push
                representation i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::ReadTyped bytecode.push
                return
            fi
            if compiler.store target type_inline_size Option::Some(size) is then
                if 1 size == then
                    InstValue::Load8 bytecode.push
                elif 2 size == then
                    InstValue::Load16 bytecode.push
                elif 4 size == then
                    InstValue::Load32 bytecode.push
                elif 8 size == then
                    InstValue::Load64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure
                    return
                fi
                if VALUE_REPR_SIGNED representation == then
                    if target Type::Builtin(builtin) is then
                        builtin InstValue::NormalizeInt bytecode.push
                    fi
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure
        fi
    }

    fn emit_typed_borrow compiler:mut$BytecodeCompiler target:$Type bytecode:mut$List[InstValue] {
        if target.has_unresolved_type_var then
            target make_hidden_size_parameter_name compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target make_hidden_repr_parameter_name compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            InstValue::BorrowTyped bytecode.push
            return
        fi
        if compiler.store target type_value_representation Option::Some(representation) is then
            if VALUE_REPR_INDIRECT representation != then
                bytecode target compiler.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure
        fi
    }

    fn emit_typed_copy compiler:mut$BytecodeCompiler target:$Type bytecode:mut$List[InstValue] {
        if target.has_unresolved_type_var then
            target make_hidden_size_parameter_name compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target make_hidden_repr_parameter_name compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            InstValue::CopyTyped bytecode.push
            return
        fi
        if compiler.store target type_value_representation Option::Some(representation) is then
            if VALUE_REPR_INDIRECT representation == then
                bytecode target compiler.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure
        fi
    }

    fn emit_typed_store compiler:mut$BytecodeCompiler target:$Type bytecode:mut$List[InstValue] {
        if target.has_unresolved_type_var then
            target make_hidden_size_parameter_name compiler.resolve_variable = size_variable
            bytecode size_variable.emit_get
            target make_hidden_repr_parameter_name compiler.resolve_variable = repr_variable
            bytecode repr_variable.emit_get
            InstValue::WriteTyped bytecode.push
            return
        fi
        if compiler.store target type_value_representation Option::Some(representation) is then
            if compiler.store target type_inline_size Option::Some(size) is then
                if VALUE_REPR_INDIRECT representation == then
                    size i64::try_from.unwrap InstValue::Push bytecode.push
                    representation i64::try_from.unwrap InstValue::Push bytecode.push
                    InstValue::WriteTyped bytecode.push
                elif 1 size == then
                    InstValue::Store8 bytecode.push
                elif 2 size == then
                    InstValue::Store16 bytecode.push
                elif 4 size == then
                    InstValue::Store32 bytecode.push
                elif 8 size == then
                    InstValue::Store64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure
        fi
    }
}

impl BytecodeCompiler {
    fn compile_op
        compiler:mut$BytecodeCompiler
        op:mut$Op
        op_index:u64
        bytecode:mut$List[InstValue]
    {
        op.value = op_value
        if
            op_value OpValue::IfElif is
            op_value OpValue::IfElse is ||
            op_value OpValue::IfEnd is ||
            op_value OpValue::WhileEnd is ||
            op_value OpValue::MatchArm is ||
            op_value OpValue::MatchEnd is || !
        then
            bytecode op compiler.compile_owner_cleanups
        fi
        if op_value OpValue::Drop is then
            if op.type_hint Option::Some(drop_type) is then
                bytecode op drop_type compiler.compile_destruction
            else
                InstValue::Drop bytecode.push
            fi
            return
        fi
        op_value direct_op_to_inst = direct_inst_opt
        false = has_type_hint
        "" = type_hint_name
        if op Op::type_hint Option::Some(type_hint) is then
            true = has_type_hint
            type_hint.format = type_hint_name
        fi

        # Check direct op-to-inst mapping first
        if direct_inst_opt Option::Some(direct_inst) is then
            # Data-carrying enum comparison
            if
                op_value OpValue::Eq is
                op_value OpValue::Ne is ||
                op_value OpValue::Lt is ||
                op_value OpValue::Le is ||
                op_value OpValue::Gt is ||
                op_value OpValue::Ge is ||
                has_type_hint &&
                type_hint_name compiler
                    .store
                    .enums
                    .has &&
            then
                bytecode direct_inst compiler.compile_enum_comparison
                return
            fi
            # String content comparison
            if
                op_value OpValue::Eq is
                op_value OpValue::Ne is ||
                "str" type_hint_name == &&
            then
                InstValue::StrEq bytecode.push
                if op_value OpValue::Ne is then
                    InstValue::Not bytecode.push
                fi
                return
            fi
            # Data-carrying enum print
            if
                op_value OpValue::PrintInt is type_hint_name compiler
                    .store
                    .enums
                    .has &&
            then
                InstValue::Load64 bytecode.push
                InstValue::PrintInt bytecode.push
                return
            fi
            type_hint_name parse_builtin = builtin_hint
            if builtin_hint Option::Some(builtin) is then
                builtin direct_inst op_value.select_typed_instruction bytecode.push
            else
                direct_inst bytecode.push
            fi
            bytecode op compiler.emit_integer_normalization
            return
        fi

        # Non-direct ops
        if
            op_value OpValue::WrappingAdd is
            op_value OpValue::WrappingSub is ||
            op_value OpValue::WrappingMul is ||
        then
            InstValue::Swap bytecode.push
            if op_value OpValue::WrappingAdd is then
                InstValue::Add bytecode.push
            elif op_value OpValue::WrappingSub is then
                InstValue::Sub bytecode.push
            else
                InstValue::Mul bytecode.push
            fi
            bytecode op compiler.emit_integer_normalization
        elif op_value OpValue::NumericConvert(conversion) is then
            conversion InstValue::NumericConvert bytecode.push
        elif op_value OpValue::NumericTry(numeric_try) is then
            if numeric_try.source Type::Builtin is then
                numeric_try InstValue::NumericTry bytecode.push
                f"__numeric_try_{numeric_try.target.format}" = wrapper_name
                if op wrapper_name compiler.compile_named_function then
                    wrapper_name InstValue::FnCall bytecode.push
                fi
            else
                f"Numeric conversion source `{numeric_try.source.format}` was not specialized" compiler.record_failure
            fi
        elif op_value OpValue::IntegerTry(integer_try) is then
            InstValue::Swap bytecode.push
            integer_try InstValue::IntegerTry bytecode.push
            f"__numeric_try_{integer_try.target.format}" = wrapper_name
            if op wrapper_name compiler.compile_named_function then
                wrapper_name InstValue::FnCall bytecode.push
            fi
        elif op_value OpValue::FloatRound(rounding) is then
            rounding InstValue::FloatRound bytecode.push
        elif op_value OpValue::FloatFromDecimal is then
            InstValue::FloatFromDecimal bytecode.push
        elif op_value OpValue::FloatSignificand is then
            InstValue::FloatSignificand bytecode.push
        elif
            op_value OpValue::AssignDec is
            op_value OpValue::AssignInc is ||
            op_value OpValue::AssignVar is ||
            op_value OpValue::Question is ||
        then
            if op op_identity compiler.store.clone_ownership Option::Some(owned_ownership) is then
                for event in owned_ownership.assignments.iter do
                    event.clone = owned_event
                    bytecode op owned_event compiler.compile_active_owner_cleanup
                done
            fi
            bytecode op compiler.compile_assignment
            if op op_identity compiler.store.clone_ownership Option::Some(owned_ownership) is then
                for event in owned_ownership.assignments.iter do
                    bytecode event.generation event.name.clone compiler.set_owner_flag
                done
            fi
        elif op_value OpValue::QuestionMove(hidden_name) is then
            if hidden_name compiler.owner_flags.get Option::Some(flag) is then
                0 InstValue::Push bytecode.push
                flag InstValue::LocalSet bytecode.push
            fi
        elif op_value OpValue::FstringConcat(fstring_count) is then
            fstring_count InstValue::FstringConcat bytecode.push
        elif op_value OpValue::PrimitiveToStr(builtin) is then
            builtin InstValue::PrimitiveToStr bytecode.push
        elif op_value OpValue::FstringToStr is then
            # Identity no-op: str expression already left on stack by the preceding lambda.
            # Non-str cases are rewritten to OpMethodCall during type checking.
        elif op_value OpValue::FnCall is op_value OpValue::FnPush is || then
            if op_value OpValue::FnPush(fn_push_name) is then
                fn_push_name compiler
                    .store
                    .functions
                    .get = function_opt
                if function_opt.is_some then
                    function_opt.unwrap = function_check
                    if function_check Function::has_deferred_methods then
                        0 InstValue::Push bytecode.push
                        return
                    fi
                fi
            fi
            bytecode op compiler.compile_function_ops
        elif op_value OpValue::Identifier(ident_name) is then
            f"Identifier `{ident_name}` reached bytecode compilation unresolved" compiler.record_failure
        elif
            op_value OpValue::IfCondition is
            op_value OpValue::IfElif is ||
            op_value OpValue::IfElse is ||
            op_value OpValue::IfEnd is ||
            op_value OpValue::IfStart is ||
        then
            bytecode op_index op compiler.compile_if_block
        elif op_value OpValue::Copy is then
            if op.type_hint Option::Some(copied_type) is then
                bytecode copied_type compiler.emit_typed_copy
            fi
        elif
            op_value OpValue::ImportFile is
            op_value OpValue::ImportFileSelective is ||
            op_value OpValue::TypeCast is ||
            op_value OpValue::DeclareGlobal is ||
        then
            # No instruction emitted
        elif op_value OpValue::PushEnumVariant(variant) is then
            if variant.enum_name compiler.store.clone_enum Option::Some(owned_enum) is then
                if owned_enum has_inner_values then
                    bytecode owned_enum variant compiler.compile_enum_variant
                else
                    compiler variant require_variant_ordinal InstValue::Push bytecode.push
                fi
            else
                f"Enum `{variant.enum_name}` is missing during bytecode compilation" compiler.record_failure
            fi
        elif op_value OpValue::IsCheck is then
            bytecode op compiler.compile_is_check
        elif
            op_value OpValue::MatchStart is
            op_value OpValue::MatchArm is ||
            op_value OpValue::MatchEnd is ||
        then
            bytecode op_index op compiler.compile_match_block
        elif
            op_value OpValue::MethodCall is
            op_value OpValue::QualifiedMethodCall is ||
        then
            "Method call reached bytecode compilation before typechecker lowering" compiler.record_failure
        elif op_value OpValue::TraitMethodCall(trait_hidden_var) is then
            trait_hidden_var compiler.resolve_variable = trait_resolved
            bytecode trait_resolved.emit_get
            InstValue::FnExec bytecode.push
        elif op_value OpValue::Print is then
            "Generic print reached bytecode compilation before typechecker lowering" compiler.record_failure
        elif op_value OpValue::Typeof is then
            type_hint_name = type_name
            type_name compiler.intern_string = typeof_index
            InstValue::Drop bytecode.push
            typeof_index InstValue::PushStr bytecode.push
            InstValue::PrintStr bytecode.push
        elif op_value OpValue::SizeOf(target_type) is then
            if compiler.store target_type type_inline_size Option::Some(size) is then
                if size i64::try_from Option::Some(signed_size) is then
                    signed_size InstValue::Push bytecode.push
                else
                    f"Inline size of `{target_type.format}` exceeds the supported constant range"
                    compiler.record_failure
                fi
            else
                f"Cannot determine inline size of `{target_type.format}`"
                compiler.record_failure
            fi
        elif op_value OpValue::PtrRead(target_type) is then
            bytecode target_type compiler.emit_typed_load
        elif op_value OpValue::PtrWrite(target_type) is then
            bytecode target_type compiler.emit_typed_store
        elif op_value OpValue::PtrAsRef(target_type) is then
            bytecode target_type compiler.emit_typed_borrow
        elif op_value OpValue::PtrAsMut(target_type) is then
            bytecode target_type compiler.emit_typed_borrow
        elif op_value OpValue::PushArray is then
            bytecode op compiler.compile_push_array
        elif op_value OpValue::ExprGroup(group_ops) is then
            0 (u64) = grp_idx
            while grp_idx group_ops.length > do
                bytecode grp_idx grp_idx group_ops.get compiler.compile_op
                1 += grp_idx
            done
        elif op_value OpValue::PushBool(bool_value) is then
            bool_value InstValue::Push bytecode.push
        elif op_value OpValue::PushChar(char_value) is then
            char_value InstValue::PushChar bytecode.push
        elif op_value OpValue::PushCapture(capture_name) is then
            if compiler.function.is_none then
                f"Capture `{capture_name}` reached global bytecode compilation" compiler.record_failure
            elif capture_name compiler.capture_slots.get Option::Some(capture_index) is then
                capture_index InstValue::CaptureLoad bytecode.push
            else
                f"Capture `{capture_name}` is missing during bytecode compilation" compiler.record_failure
            fi
        elif op_value OpValue::PushInt(int_value) is then
            int_value.value InstValue::Push bytecode.push
        elif op_value OpValue::PushFloat(float_value) is then
            if "f32" type_hint_name == then
                float_value InstValue::PushFloat32 bytecode.push
            else
                float_value InstValue::PushFloat64 bytecode.push
            fi
        elif op_value OpValue::PushStr(str_value) is then
            str_value compiler.intern_string = string_index
            string_index InstValue::PushStr bytecode.push
        elif op_value OpValue::PushVar(var_name) is then
            var_name compiler.resolve_variable = var_resolved
            bytecode var_resolved.emit_get
            if op op_identity compiler.store.clone_ownership Option::Some(owned_ownership) is then
                if owned_ownership.moves_owner then
                    if var_name compiler.owner_flags.get Option::Some(flag) is then
                        0 InstValue::Push bytecode.push
                        flag InstValue::LocalSet bytecode.push
                    fi
                fi
            fi
        elif op_value OpValue::StructNew is then
            bytecode op compiler.compile_struct_new
        elif op_value OpValue::StructLiteral is then
            bytecode op compiler.compile_struct_literal
        elif op_value OpValue::OwnerCleanup is then
            # Ownership metadata emitted before operation dispatch.
        elif
            op_value OpValue::WhileBreak is
            op_value OpValue::WhileCondition is ||
            op_value OpValue::WhileContinue is ||
            op_value OpValue::WhileEnd is ||
            op_value OpValue::WhileStart is ||
        then
            bytecode op_index op compiler.compile_while_block
        fi
    }
}

# ============================================================================
# Compile ops list
# ============================================================================

impl BytecodeCompiler {
    fn compile_ops compiler:mut$BytecodeCompiler bytecode:mut$List[InstValue] {
        # Set locals_count from function variables
        if compiler.function Option::Some(function) is then
            function Function::variables.length = var_count
            var_count = compiler.locals_count
        fi

        # Function label
        compiler.new_label = function_label
        function_label InstValue::Label bytecode.push

        0 (u64) = index
        while index compiler.ops.length > compiler.has_failed ! && do
            index compiler.ops.get = op
            bytecode index op compiler.compile_op
            1 += index
        done
    }
}

# ============================================================================
# Main entry: compile_bytecode
# ============================================================================

fn compile_bytecode store:$SymbolStore ops:mut$List[Op] -> Result[Program BytecodeFailure] {
    List[InstValue]::new = bytecode
    ops store BytecodeCompiler::new = compiler

    # Emit globals init if needed
    if
        0 compiler
            .store
            .variables
            .length !=
    then
        compiler
            .store
            .variables
            .length InstValue::GlobalsInit bytecode.push
    fi

    bytecode compiler.compile_ops

    # Handle locals for global scope
    compiler.locals_count = locals_count
    if locals_count 0 < then
        List[InstValue]::new = final_bytecode
        locals_count InstValue::LocalsInit final_bytecode.push
        bytecode.shallow_copy final_bytecode.append
        locals_count InstValue::LocalsUninit final_bytecode.push
        final_bytecode = bytecode
    fi

    compiler.constants_table.length
    compiler
        .store
        .variables
        .length
    compiler.static_structs
    compiler.static_arrays
    compiler.string_table
    compiler.function_bytecode
    bytecode
    Program = program

    if compiler.failure Option::Some(failure) is then
        failure Result::Error
    else
        program Result::Ok
    fi
}

fn compile_typechecked result:$TypecheckResult -> Result[Program BytecodeFailure] {
    if result.diagnostics.has_errors then
        "Bytecode compilation requires error-free typechecking" BytecodeFailure::new Result::Error
        return
    fi
    result.ops result.store compile_bytecode
}
