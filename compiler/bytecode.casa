            common::OpValue::IfElif => {
                op_index ops.get self.op_to_label = elif_label
                if op_index targets.get_end std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = end_label_2
                    bytecode op self.compile_owner_cleanups
                    end_label_2 common::InstValue::Jump bytecode.push
                    elif_label common::InstValue::Label bytecode.push
                    bytecode op self.compile_owner_cleanups
                else
                    "Elif end target is missing during bytecode compilation" self.record_failure
                fi
            }
            common::OpValue::IfElse => {
                op_index ops.get self.op_to_label = else_label
                if op_index targets.get_end std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = end_label_3
                    bytecode op self.compile_owner_cleanups
                    end_label_3 common::InstValue::Jump bytecode.push
                    else_label common::InstValue::Label bytecode.push
                    bytecode op self.compile_owner_cleanups
                else
                    "Else end target is missing during bytecode compilation" self.record_failure
                fi
            }
            common::OpValue::IfEnd => {
                op_index ops.get self.op_to_label = fi_label
                bytecode op self.compile_owner_cleanups
                fi_label common::InstValue::Label bytecode.push
                bytecode op self.compile_owner_cleanups
            }
            common::OpValue::IfStart => {
            }
            _ => {
                "compile_if_block received a non-if operation" self.record_failure
            }
        end
    }
}

# ============================================================================
