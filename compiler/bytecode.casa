# Bytecode compiler: lowers Op tree into a flat List[InstValue].
#
# Translates high-level Ops (produced by the parser/typechecker) into
# low-level instructions suitable for code generation.
import "std" as std
import "abi" as abi
import "common" as common
import "error" as error
import "pattern" as pattern
import "semantic_rules" as semantics
import "typechecker" as typechecker

# ============================================================================
# BytecodeCompiler struct
# ============================================================================

pub struct BytecodeFailure {
    pub message: std::String
}

impl BytecodeFailure {
    fn new message:std::String -> BytecodeFailure { message BytecodeFailure }
}

enum ControlFlowKind derives std::Copy {
    If
    While
    Match
}

struct ControlFlowTarget {
    block_start: u64
    next_branch: u64
    block_end:   u64
    parent:      u64
}

struct ControlFlowTargets {
    data:   ptr
    length: u64
}

impl ControlFlowTargets {
    fn new length:u64 -> ControlFlowTargets {
        if 0 length == then
            unsafe { length ptr::null ControlFlowTargets } return
        fi
        size_of[ControlFlowTarget] = stride
        # SAFETY: The table owns length target slots, which initialize before use.
        unsafe { length length stride * alloc ControlFlowTargets }
    }

    fn drop self:mut$ControlFlowTargets {
        # SAFETY: The table owns the complete allocation until destruction.
        unsafe { self.data free }
        unsafe { ptr::null = self.data }
        0 = self.length
    }

    fn initialize self:mut$ControlFlowTargets op_index:u64 {
        ControlFlowTarget {
            block_start: self.length
            next_branch: self.length
            block_end: self.length
            parent: self.length
        } = target
        # SAFETY: The prepass initializes each in-bounds target exactly once.
        unsafe {
            target self.data op_index size_of[ControlFlowTarget] * + ptr::write[ControlFlowTarget]
        }
    }

    fn get_ref self:$ControlFlowTargets op_index:u64 -> $ControlFlowTarget {
        # SAFETY: Callers use initialized operation indexes from this sequence.
        unsafe { self.data op_index size_of[ControlFlowTarget] * + ptr::as_ref[ControlFlowTarget] }
    }

    fn get_mut self:mut$ControlFlowTargets op_index:u64 -> mut$ControlFlowTarget {
        # SAFETY: The exclusive table borrow and operation index identify one target.
        unsafe { self.data op_index size_of[ControlFlowTarget] * + ptr::as_mut[ControlFlowTarget] }
    }

    fn set_start self:mut$ControlFlowTargets op_index:u64 start:u64 {
        op_index self.get_mut = target
        start = target.block_start
    }

    fn set_next self:mut$ControlFlowTargets op_index:u64 next:u64 {
        op_index self.get_mut = target
        next = target.next_branch
    }

    fn set_end self:mut$ControlFlowTargets start:u64 end_index:u64 {
        start self.get_mut = target
        end_index = target.block_end
    }

    fn set_parent self:mut$ControlFlowTargets op_index:u64 parent:u64 {
        op_index self.get_mut = target
        parent = target.parent
    }

    fn get_parent self:$ControlFlowTargets op_index:u64 -> u64 { op_index self.get_ref.parent }

    fn get_start self:$ControlFlowTargets op_index:u64 -> std::Option[u64] {
        op_index self.get_ref.block_start = start
        if start self.length != then
            start std::Option::Some
        else
            std::Option[u64]::None
        fi
    }

    fn get_end self:$ControlFlowTargets op_index:u64 -> std::Option[u64] {
        if op_index self.get_start std::Option::Some(start) is then
            start self.get_ref.block_end = end_index
            if end_index self.length != then
                end_index std::Option::Some return
            fi
        fi
        std::Option[u64]::None
    }

    fn get_next self:$ControlFlowTargets op_index:u64 -> std::Option[u64] {
        op_index self.get_ref.next_branch = next
        if next self.length != then
            next std::Option::Some
        else
            std::Option[u64]::None
        fi
    }
}

struct IfTargetFrame {
    start:  u64
    branch: u64
}

struct WhileTargetFrame {
    start:               u64
    first_end_target_op: u64
}

struct MatchTargetFrame {
    start: u64
    arm:   u64
}

fn make_if_target_frames capacity:u64 -> std::List[IfTargetFrame] {
    if 0 capacity == then
        std::List[IfTargetFrame]::new return
    fi
    # SAFETY: The list owns capacity frame slots and publishes no initialized elements yet.
    unsafe {
        capacity 0 capacity size_of[IfTargetFrame] * alloc std::List
        = frames: std::List[IfTargetFrame]
        frames
    }
}

fn make_while_target_frames capacity:u64 -> std::List[WhileTargetFrame] {
    if 0 capacity == then
        std::List[WhileTargetFrame]::new return
    fi
    # SAFETY: The list owns capacity frame slots and publishes no initialized elements yet.
    unsafe {
        capacity 0 capacity size_of[WhileTargetFrame] * alloc std::List
        = frames: std::List[WhileTargetFrame]
        frames
    }
}

fn make_match_target_frames capacity:u64 -> std::List[MatchTargetFrame] {
    if 0 capacity == then
        std::List[MatchTargetFrame]::new return
    fi
    # SAFETY: The list owns capacity frame slots and publishes no initialized elements yet.
    unsafe {
        capacity 0 capacity size_of[MatchTargetFrame] * alloc std::List
        = frames: std::List[MatchTargetFrame]
        frames
    }
}

struct BytecodeState {
    store:           $common::SymbolStore
    program:         common::Program
    failure:         std::Option[BytecodeFailure]
    global_slots:    std::Map[std::String u64]
    constants_table: std::List[std::String]
    label_counter:   u64
    op_label_map:    std::Map[i64 u64]
}

struct BytecodeCompiler {
    ops:           $std::List[common::Op]
    function:      std::Option[common::Function]
    local_slots:   std::Map[std::String u64]
    capture_slots: std::Map[std::String u64]
    locals_count:  u64
    state:         mut$BytecodeState
    owner_flags:   std::Map[std::String u64]
}

struct ResolvedStructField {
    storage: common::FieldStoragePlan
    typ:     common::Type
}

fn resolve_struct_field
    member:$common::StructMemberAccess
    store:$common::SymbolStore
-> std::Option[ResolvedStructField] {
    if member.struct_name store.structs.get std::Option::Some(casa_struct) is then
        if member.member_index casa_struct.members.length > then
            if
                store member.member_index casa_struct common::plan_struct_member_storage
                std::Option::Some(storage) is
            then
                member.member_index casa_struct
                    .members
                    .get
                    .typ
                    .clone = typ
                typ storage.clone ResolvedStructField std::Option::Some return
            fi
        fi
    fi
    std::Option[ResolvedStructField]::None
}

impl BytecodeState {
    fn new store:$common::SymbolStore -> BytecodeState {
        std::Map[i64 u64]::new
        0
        std::List[std::String]::new
        store index_global_variable_map
        std::Option[BytecodeFailure]::None
        0
        0
        std::List[common::StaticStruct]::new
        std::List[common::StaticArray]::new
        std::List[std::String]::new
        std::Map[std::String std::List[common::InstValue]]::new
        std::List[common::InstValue]::new
        common::Program
        store
        BytecodeState
    }

    fn into_result self:BytecodeState -> std::Result[common::Program BytecodeFailure] {
        self match
            BytecodeState { program: program failure: failure } => {
                failure match
                    std::Option::Some(bytecode_failure) => bytecode_failure std::Result::Error
                    std::Option::None => program std::Result::Ok
                end
            }
        end
    }
}

impl BytecodeCompiler {
    fn new state:mut$BytecodeState ops:$std::List[common::Op] -> BytecodeCompiler {
        std::Map[std::String u64]::new
        state
        0
        std::Map[std::String u64]::new
        std::Map[std::String u64]::new
        std::Option[common::Function]::None
        ops
        BytecodeCompiler
    }

    fn child
        self:mut$BytecodeCompiler
        function:$common::Function
        ops:$std::List[common::Op]
    -> BytecodeCompiler {
        self.state.store function.variables index_local_variable_list = locals_count = local_slots
        std::Map[std::String u64]::new
        self.state
        locals_count
        function.captures index_variable_list
        local_slots
        function.clone_declaration std::Option::Some
        ops
        BytecodeCompiler
    }

    fn record_failure_string self:mut$BytecodeCompiler message:std::String {
        if
            self
                .state
                .failure
                .is_none
        then
            message BytecodeFailure::new std::Option::Some = self.state.failure
        fi
    }

    fn record_failure self:mut$BytecodeCompiler message:$str {
        message.to_str self.record_failure_string
    }

    fn has_failed self:mut$BytecodeCompiler -> bool {
        self
            .state
            .failure
            .is_some
    }

    fn emit_field_load
        compiler:mut$BytecodeCompiler
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[common::InstValue]
    {
        if plan.stores_inline then
            bytecode declared_type compiler.emit_typed_load
        else
            common::InstValue::Load64 bytecode.push
        fi
    }

    fn emit_field_projection
        compiler:mut$BytecodeCompiler
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[common::InstValue]
    {
        if plan.stores_inline ! then
            common::InstValue::Load64 bytecode.push
            return
        fi
        if
            compiler.state.store declared_type common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation != then
                bytecode declared_type compiler.emit_typed_load
            fi
        else
            f"Cannot determine field representation of `{declared_type.format}`" compiler.record_failure_string
        fi
    }

    fn emit_field_store
        compiler:mut$BytecodeCompiler
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[common::InstValue]
    {
        if plan.stores_inline then
            bytecode declared_type compiler.emit_typed_store
        else
            common::InstValue::Store64 bytecode.push
        fi
    }

    fn get_struct_field_plan
        compiler:mut$BytecodeCompiler
        casa_struct:$common::CasaStruct
        member_index:u64
    -> common::FieldStoragePlan {
        if
            compiler.state.store member_index casa_struct common::plan_struct_member_storage
            std::Option::Some(plan) is
        then
            plan.clone return
        fi
        f"Cannot determine member {member_index} storage of struct `{casa_struct.name}`"
        compiler.record_failure_string
        false 0 1 0 common::FieldStoragePlan
    }

    fn struct_size compiler:mut$BytecodeCompiler casa_struct:$common::CasaStruct -> u64 {
        casa_struct.name.clone common::GenericType::new common::Type::Generic = struct_type
        if compiler.state.store struct_type common::type_inline_size std::Option::Some(size) is then
            size return
        fi
        f"Cannot determine layout of struct `{casa_struct.name}`" compiler.record_failure_string
        0
    }

    fn get_enum_field_plan
        compiler:mut$BytecodeCompiler
        casa_enum:$common::CasaEnum
        variant_name:$str
        payload_index:u64
    -> common::FieldStoragePlan {
        if
            compiler.state.store payload_index variant_name casa_enum
            common::plan_enum_payload_storage std::Option::Some(plan) is
        then
            plan.clone return
        fi
        f"Cannot determine payload {payload_index} storage of `{casa_enum.name}::{variant_name}`"
        compiler.record_failure_string
        false 0 1 0 common::FieldStoragePlan
    }

    fn enum_size compiler:mut$BytecodeCompiler casa_enum:$common::CasaEnum -> u64 {
        casa_enum.name.clone common::GenericType::new common::Type::Generic = enum_type
        if compiler.state.store enum_type common::type_inline_size std::Option::Some(size) is then
            size return
        fi
        f"Cannot determine layout of enum `{casa_enum.name}`" compiler.record_failure_string
        0
    }
}

# ============================================================================
# Label management
# ============================================================================

impl BytecodeState {
    fn new_label self:mut$BytecodeState -> u64 {
        self.label_counter = value
        1 += self.label_counter
        value
    }

    fn op_identity_to_label self:mut$BytecodeState address:i64 -> u64 {
        if address self.op_label_map.get_copy std::Option::Some(existing) is then
            existing
        else
            self.new_label = label
            label address self.op_label_map.set
            label
        fi
    }
}

impl BytecodeCompiler {
    fn new_label self:mut$BytecodeCompiler -> u64 { self.state.new_label }

    fn op_to_label self:mut$BytecodeCompiler op:$common::Op -> u64 {
        op common::op_identity = address
        address self.state.op_identity_to_label
    }
}

# ============================================================================
# String/constant interning
# ============================================================================

fn intern_table table:mut$std::List[std::String] value:$str -> u64 {
    # Add value to table if not present, return its index.
    if value table common::string_list_contains then
        value table common::string_list_index u64::try_from.unwrap
    else
        table.length = table_index
        value.clone table.push_str
        table_index
    fi
}

impl BytecodeCompiler {
    fn intern_string compiler:mut$BytecodeCompiler value:$str -> u64 {
        value compiler
            .state
            .program
            .strings intern_table
    }
}

# ============================================================================
# Variable resolution
# ============================================================================

fn index_variable_list variables:$std::List[common::Variable] -> std::Map[std::String u64] {
    std::Map[std::String u64]::new = slots
    0 = index: u64
    for variable in variables.iter do
        if variable.name slots.has ! then
            index variable.name.clone slots.set
        fi
        1 += index
    done
    slots
}

fn has_copy_aggregate_storage typ:$common::Type store:$common::SymbolStore -> bool {
    if
        typ common::get_concrete_array_length.is_none
        store typ common::type_is_extern_struct ! &&
    then
        false return
    fi
    common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
    store copy_type typ semantics::type_has_satisfying_trait_impl
}

fn uses_inline_local_storage typ:$common::Type store:$common::SymbolStore -> bool {
    typ common::get_concrete_array_length.is_some store typ has_copy_aggregate_storage ||
}

fn local_variable_slot_width variable:$common::Variable store:$common::SymbolStore -> u64 {
    if store variable.typ uses_inline_local_storage then
        if store variable.typ common::type_inline_size std::Option::Some(size) is then
            size common::WORD_SIZE u64::try_from.unwrap 1 - +
            common::WORD_SIZE u64::try_from.unwrap / return
        fi
    fi
    1
}

fn index_local_variable_list
    variables:$std::List[common::Variable]
    store:$common::SymbolStore
-> std::Map[std::String u64] u64 {
    std::Map[std::String u64]::new = slots
    0 = next_slot: u64
    for variable in variables.iter do
        if variable.name slots.has ! then
            store variable local_variable_slot_width = width
            next_slot width + 1 - variable.name.clone slots.set
            width += next_slot
        fi
    done
    slots next_slot
}

fn index_variable_map
    variables:$std::Map[std::String common::Variable]
-> std::Map[std::String u64] {
    std::Map[std::String u64]::new = slots
    variables.keys = names
    0 = index: u64
    for name in names.iter do
        index name.clone slots.set
        1 += index
    done
    slots
}

fn index_global_variable_map store:$common::SymbolStore -> std::Map[std::String u64] {
    if
        0 store
            .immutable_global_slots
            .keys
            .length ==
    then
        store.variables index_variable_map return
    fi
    std::Map[std::String u64]::new = slots
    std::Map[std::String u64]::new = storage_slots
    0 = next_slot: u64
    for
        name in store
            .variables
            .keys
            .iter
    do
        name.clone = storage_name
        if name.as_str store.immutable_global_slots.get_str std::Option::Some(global_slot) is then
            global_slot.clone = storage_name
        fi
        if storage_name.as_str storage_slots.get_copy_str std::Option::Some(existing) is then
            existing name.clone slots.set
        else
            next_slot storage_name storage_slots.set
            next_slot name.clone slots.set
            1 += next_slot
        fi
    done
    slots
}

fn global_slot_count slots:$std::Map[std::String u64] -> u64 {
    0 = count: u64
    for slot in slots.values.iter do
        if slot copy count <= then
            slot copy 1 + = count
        fi
    done
    count
}

impl BytecodeCompiler {
    fn allocate_local compiler:mut$BytecodeCompiler -> u64 {
        compiler.locals_count = local_index
        1 += compiler.locals_count
        local_index
    }

    fn resolve_variable
        compiler:mut$BytecodeCompiler
        variable_name:$str
    -> common::ResolvedVariable {
        if variable_name compiler.local_slots.get_copy_str std::Option::Some(local_index) is then
            local_index common::ResolvedVariable::Local return
        fi
        if
            variable_name compiler
                .state
                .global_slots
                .get_copy_str std::Option::Some(global_index) is
        then
            global_index common::ResolvedVariable::Global return
        fi
        if compiler.function std::Option::Some(function) is then
            f"Variable `{variable_name}` is missing while compiling `{function.name}`"
            compiler.record_failure_string
        else
            f"Variable `{variable_name}` is missing during bytecode compilation"
            compiler.record_failure_string
        fi
        0 common::ResolvedVariable::Local
    }

    fn find_local_inline_aggregate_type
        self:mut$BytecodeCompiler
        variable_name:$str
    -> std::Option[common::Type] {
        if self.function std::Option::Some(function) is then
            for variable in function.variables.iter do
                if variable.name.as_str variable_name == then
                    if self.state.store variable.typ uses_inline_local_storage then
                        variable.typ.clone std::Option::Some return
                    fi
                fi
            done
        fi
        std::Option[common::Type]::None
    }

    fn emit_variable_get
        compiler:mut$BytecodeCompiler
        variable_name:$str
        move_owned:bool
        bytecode:mut$std::List[common::InstValue]
    {
        variable_name compiler.resolve_variable = resolved
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            if resolved common::ResolvedVariable::Local(local_index) is then
                local_index common::InstValue::LocalAddress bytecode.push
                if move_owned then
                    bytecode aggregate_type compiler.emit_typed_load
                fi
                return
            fi
        fi
        bytecode resolved.emit_get
    }

    fn emit_variable_set
        compiler:mut$BytecodeCompiler
        variable_name:$str
        bytecode:mut$std::List[common::InstValue]
    {
        variable_name compiler.resolve_variable = resolved
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            if resolved common::ResolvedVariable::Local(local_index) is then
                local_index common::InstValue::LocalAddress bytecode.push
                bytecode aggregate_type compiler.emit_typed_store
                return
            fi
        fi
        bytecode resolved.emit_set
    }
}

# ============================================================================
# Deterministic destruction
# ============================================================================

impl BytecodeCompiler {
    fn is_copy_aggregate self:$BytecodeCompiler typ:$common::Type -> bool {
        self.state.store typ has_copy_aggregate_storage
    }

    fn compile_drop_hook
        compiler:mut$BytecodeCompiler
        store:$common::SymbolStore
        typ:$common::Type
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if store typ common::find_drop_function_name std::Option::Some(drop_name) is then
            drop_name.clone = function_name
            function_name.as_str store.get_function.unwrap = function: $common::Function
            if
                0 function
                    .stack_effect
                    .type_vars
                    .length != 0 function
                    .stack_effect
                    .const_params
                    .keys
                    .length != ||
            then
                function typ typechecker::function_receiver_bindings = bindings
                bindings function_name.as_str typechecker::monomorphized_function_name = function_name
            fi
            common::InstValue::Dup bytecode.push
            if op function_name.as_str compiler.compile_named_function then
                function_name common::InstValue::FnCall bytecode.push
            fi
        fi
    }

    # Destroy every element of an `array[T N]` value. The array stores nothing
    # but its elements, so the element count comes from the type (ADR-0152).
    fn compile_array_destruction
        compiler:mut$BytecodeCompiler
        element_type:$common::Type
        length:$common::ConstType
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        compiler.allocate_local = array_local
        compiler.allocate_local = index_local
        array_local common::InstValue::LocalSet bytecode.push
        length.value common::InstValue::Push bytecode.push
        index_local common::InstValue::LocalSet bytecode.push

        compiler.new_label = start_label
        compiler.new_label = element_label
        compiler.new_label = end_label
        start_label common::InstValue::Label bytecode.push
        index_local common::InstValue::LocalGet bytecode.push
        0 common::InstValue::Push bytecode.push
        common::InstValue::Eq bytecode.push
        element_label common::InstValue::JumpNe bytecode.push
        end_label common::InstValue::Jump bytecode.push
        element_label common::InstValue::Label bytecode.push
        index_local common::InstValue::LocalGet bytecode.push
        1 common::InstValue::Push bytecode.push
        common::InstValue::Sub bytecode.push
        index_local common::InstValue::LocalSet bytecode.push
        array_local common::InstValue::LocalGet bytecode.push
        index_local common::InstValue::LocalGet bytecode.push
        bytecode element_type compiler.emit_inline_size
        common::InstValue::Mul bytecode.push
        common::InstValue::Add bytecode.push
        bytecode element_type compiler.emit_typed_load
        bytecode op element_type compiler.compile_destruction
        start_label common::InstValue::Jump bytecode.push
        end_label common::InstValue::Label bytecode.push
        array_local common::InstValue::LocalGet bytecode.push
    }

    fn compile_struct_fields
        compiler:mut$BytecodeCompiler
        typ:$common::Type
        casa_struct:$common::CasaStruct
        skipped:mut$std::List[std::String]
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        casa_struct.type_vars typ common::aggregate_type_bindings = substitutions
        casa_struct.members.length = member_index
        while 0 member_index != do
            1 -= member_index
            member_index casa_struct.members.get = member
            if member.name.as_str skipped common::string_list_contains then
                continue
            fi
            substitutions member.typ.substitute_t = member_type
            common::InstValue::Dup bytecode.push
            member_index casa_struct compiler.get_struct_field_plan = plan
            if 0 plan.offset != then
                plan.offset i64::try_from.unwrap common::InstValue::Push bytecode.push
                common::InstValue::Add bytecode.push
            fi
            bytecode plan member.typ compiler.emit_field_load
            bytecode op member_type compiler.compile_destruction
        done
        common::InstValue::HeapFree bytecode.push
    }

    fn compile_enum_variant_fields
        compiler:mut$BytecodeCompiler
        typ:$common::Type
        casa_enum:$common::CasaEnum
        variant_name:$str
        skipped_count:u64
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        casa_enum.type_vars typ common::aggregate_type_bindings = substitutions
        if variant_name casa_enum.variant_types.get_str std::Option::Some(payload_types) is then
            payload_types.length = payload_index
            while skipped_count payload_index > do
                1 -= payload_index
                substitutions payload_index payload_types.get.substitute_t = payload_type
                common::InstValue::Dup bytecode.push
                payload_index variant_name casa_enum compiler.get_enum_field_plan = plan
                plan.offset i64::try_from.unwrap
                common::InstValue::Push bytecode.push
                common::InstValue::Add bytecode.push
                bytecode plan payload_index payload_types.get compiler.emit_field_load
                bytecode op payload_type compiler.compile_destruction
            done
        fi
        common::InstValue::HeapFree bytecode.push
    }

    fn compile_enum_fields
        compiler:mut$BytecodeCompiler
        typ:$common::Type
        casa_enum:$common::CasaEnum
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        compiler.allocate_local = enum_local
        enum_local common::InstValue::LocalSet bytecode.push
        compiler.new_label = end_label
        0 = variant_index: u64
        while variant_index casa_enum.variants.length > do
            compiler.new_label = next_label
            enum_local common::InstValue::LocalGet bytecode.push
            common::InstValue::Load64 bytecode.push
            variant_index i64::try_from.unwrap common::InstValue::Push bytecode.push
            common::InstValue::Eq bytecode.push
            next_label common::InstValue::JumpNe bytecode.push
            enum_local common::InstValue::LocalGet bytecode.push
            variant_index casa_enum.variants.get = variant_name
            bytecode op 0 variant_name.as_str casa_enum typ compiler.compile_enum_variant_fields
            end_label common::InstValue::Jump bytecode.push
            next_label common::InstValue::Label bytecode.push
            1 += variant_index
        done
        end_label common::InstValue::Label bytecode.push
    }

    fn compile_destruction_body
        compiler:mut$BytecodeCompiler
        typ:$common::Type
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if typ.is_borrow then
            common::InstValue::Drop bytecode.push return
        fi
        if typ common::Type::Function(_) is then
            common::InstValue::ClosureDrop bytecode.push return
        fi
        if typ compiler.is_copy_aggregate then
            common::InstValue::HeapFreeIfAllocated bytecode.push return
        fi
        bytecode op typ compiler.state.store compiler.compile_drop_hook
        typ.clone = destruction_type
        if destruction_type.clone common::Type::Generic(generic) is then
            if common::ARRAY_TYPE generic.base.as_str == then
                if destruction_type common::get_array_length_parameter std::Option::Some(array_length) is then
                    bytecode op array_length 0 generic.params.get compiler.compile_array_destruction
                    common::InstValue::HeapFree bytecode.push
                else
                    common::InstValue::Drop bytecode.push
                fi
                return
            fi
            if
                generic.base compiler
                    .state
                    .store
                    .structs
                    .get std::Option::Some(owned_struct) is
            then
                std::List[std::String]::new = skipped
                bytecode op skipped owned_struct typ compiler.compile_struct_fields
                return
            fi
            if
                generic.base compiler
                    .state
                    .store
                    .enums
                    .get std::Option::Some(owned_enum) is
            then
                if owned_enum common::has_inner_values then
                    bytecode op owned_enum typ compiler.compile_enum_fields
                else
                    common::InstValue::Drop bytecode.push
                fi
                return
            fi
        fi
        common::InstValue::Drop bytecode.push
    }

    fn destruction_needs_function compiler:mut$BytecodeCompiler typ:$common::Type -> bool {
        compiler.state.store typ common::type_needs_destruction_in_store
    }

    fn ensure_destruction_function
        compiler:mut$BytecodeCompiler
        typ:$common::Type
        op:$common::Op
    -> std::String {
        f"__drop_{typ.format}" = function_name
        if
            function_name compiler
                .state
                .program
                .functions
                .has
        then
            function_name return
        fi
        std::List[common::InstValue]::new function_name.clone compiler
            .state
            .program
            .functions
            .set

        std::List[common::Op]::new = empty_ops
        common::empty_location empty_ops function_name.clone common::Function::new = function
        std::List[common::Op]::new = destructor_ops
        destructor_ops function compiler.child = destructor
        std::List[common::InstValue]::new = body
        body op typ destructor.compile_destruction_body
        if destructor.has_failed then
            function_name return
        fi

        std::List[common::InstValue]::new = function_bytecode
        if 0 destructor.locals_count != then
            destructor.locals_count common::InstValue::LocalsInit function_bytecode.push
        fi
        body function_bytecode.append
        if 0 destructor.locals_count != then
            destructor.locals_count common::InstValue::LocalsUninit function_bytecode.push
        fi
        common::InstValue::FnReturn function_bytecode.push
        function_bytecode function_name.clone compiler
            .state
            .program
            .functions
            .set
        function_name
    }

    fn compile_destruction
        compiler:mut$BytecodeCompiler
        typ:$common::Type
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if typ compiler.destruction_needs_function ! then
            common::InstValue::Drop bytecode.push
            return
        fi
        op typ compiler.ensure_destruction_function = function_name
        function_name common::InstValue::FnCall bytecode.push
    }

    fn compile_enum_pattern_destruction
        compiler:mut$BytecodeCompiler
        store:$common::SymbolStore
        op:$common::Op
        variant:$common::EnumVariant
        typ:$common::Type
        bytecode:mut$std::List[common::InstValue]
    {
        if typ compiler.destruction_needs_function ! then
            common::InstValue::Drop bytecode.push
            return
        fi
        bytecode op typ store compiler.compile_drop_hook
        if typ.clone common::Type::Generic(generic) is then
            if generic.base store.enums.get std::Option::Some(owned_enum) is then
                if owned_enum common::has_inner_values then
                    variant.bindings.length = skipped_count
                    bytecode op skipped_count variant.variant_name.as_str owned_enum typ
                    compiler.compile_enum_variant_fields
                    return
                fi
            fi
        fi
        common::InstValue::Drop bytecode.push
    }

    fn compile_match_destruction
        compiler:mut$BytecodeCompiler
        store:$common::SymbolStore
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if op.type_hint std::Option::None is then
            common::InstValue::Drop bytecode.push return
        fi
        op
            .type_hint
            .clone
            .unwrap = typ
        if op common::pattern_value_of common::PatternValue::EnumVariant(variant) is then
            if op pattern::pattern_is_wildcard ! then
                bytecode typ variant op store compiler.compile_enum_pattern_destruction
                return
            fi
        fi
        if typ compiler.destruction_needs_function ! then
            common::InstValue::Drop bytecode.push
            return
        fi
        bytecode op typ store compiler.compile_drop_hook
        if typ.clone common::Type::Generic(generic) is then
            if generic.base store.structs.get std::Option::Some(owned_struct) is then
                std::List[std::String]::new = skipped
                if op common::pattern_value_of common::PatternValue::Struct(struct_pattern) is then
                    struct_pattern.bindings.keys = skipped
                fi
                bytecode op skipped owned_struct typ compiler.compile_struct_fields
                return
            fi
            if generic.base store.enums.get std::Option::Some(owned_enum) is then
                if owned_enum common::has_inner_values ! then
                    common::InstValue::Drop bytecode.push return
                fi
                if op common::pattern_value_of common::PatternValue::EnumVariant(variant) is then
                    bytecode op owned_enum typ compiler.compile_enum_fields
                    return
                fi
            fi
        fi
        common::InstValue::Drop bytecode.push
    }

    fn owner_flag compiler:mut$BytecodeCompiler name:$str -> u64 {
        if name compiler.owner_flags.get_copy_str std::Option::Some(flag) is then
            flag return
        fi
        compiler.allocate_local = flag
        flag name.clone compiler.owner_flags.set_str
        flag
    }

    fn set_owner_flag
        compiler:mut$BytecodeCompiler
        name:$str
        value:u64
        bytecode:mut$std::List[common::InstValue]
    {
        name compiler.owner_flag = flag
        value i64::try_from.unwrap common::InstValue::Push bytecode.push
        flag common::InstValue::LocalSet bytecode.push
    }

    fn compile_variable_destruction
        compiler:mut$BytecodeCompiler
        variable_name:$str
        typ:$common::Type
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            variable_name compiler.resolve_variable = resolved
            if resolved common::ResolvedVariable::Local(local_index) is then
                local_index common::InstValue::LocalAddress bytecode.push
                bytecode op aggregate_type compiler.state.store compiler.compile_drop_hook
                if aggregate_type common::get_array_length_parameter std::Option::Some(array_length) is then
                    if aggregate_type.array_element_type std::Option::Some(element_type) is then
                        bytecode op array_length element_type compiler.compile_array_destruction
                        common::InstValue::Drop bytecode.push
                        return
                    fi
                fi
                common::InstValue::Drop bytecode.push
                return
            fi
        fi
        variable_name compiler.resolve_variable = resolved
        bytecode resolved.emit_get
        bytecode op typ compiler.compile_destruction
    }

    fn compile_active_owner_cleanup
        compiler:mut$BytecodeCompiler
        event:$common::OwnerEvent
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        event.name.as_str compiler.owner_flag = flag
        compiler.new_label = cleanup_label
        compiler.new_label = end_label
        flag common::InstValue::LocalGet bytecode.push
        0 common::InstValue::Push bytecode.push
        common::InstValue::Eq bytecode.push
        cleanup_label common::InstValue::JumpNe bytecode.push
        end_label common::InstValue::Jump bytecode.push
        cleanup_label common::InstValue::Label bytecode.push
        bytecode op event.typ event.name.as_str compiler.compile_variable_destruction
        bytecode 0 event.name.as_str compiler.set_owner_flag
        end_label common::InstValue::Label bytecode.push
    }

    fn compile_owner_cleanup
        compiler:mut$BytecodeCompiler
        event:$common::OwnerEvent
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        event.name.as_str compiler.owner_flag = flag
        compiler.new_label = end_label
        flag common::InstValue::LocalGet bytecode.push
        event.generation i64::try_from.unwrap common::InstValue::Push bytecode.push
        common::InstValue::Eq bytecode.push
        end_label common::InstValue::JumpNe bytecode.push
        bytecode op event.typ event.name.as_str compiler.compile_variable_destruction
        bytecode 0 event.name.as_str compiler.set_owner_flag
        end_label common::InstValue::Label bytecode.push
    }

    fn compile_owner_cleanups
        compiler:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        op common::op_identity compiler
            .state
            .store
            .clone_owner_cleanups = cleanups
        for event in cleanups.iter do
            bytecode op event compiler.compile_owner_cleanup
        done
    }
}

# ============================================================================
# Control-flow targets
# ============================================================================

fn make_control_flow_failure message:$str -> std::Result[ControlFlowTargets BytecodeFailure] {
    message.to_str BytecodeFailure::new std::Result::Error
}

fn make_if_end_failure has_open_if:bool -> std::Result[ControlFlowTargets BytecodeFailure] {
    if has_open_if then
        "`if` without matching `fi`" make_control_flow_failure return
    fi
    "`fi` without parent `if`" make_control_flow_failure
}

fn make_open_while_failure
    ops:$std::List[common::Op]
    frame:$WhileTargetFrame
-> std::Result[ControlFlowTargets BytecodeFailure] {
    if frame.first_end_target_op ops.length != then
        if frame.first_end_target_op ops.get.value common::OpValue::WhileCondition is then
            "`do` without matching `done`" make_control_flow_failure return
        fi
        "`break` without matching `done`" make_control_flow_failure return
    fi
    "`while` without matching `done`" make_control_flow_failure
}

fn is_current_control_flow ops:$std::List[common::Op] op_index:u64 kind:ControlFlowKind -> bool {
    if op_index ops.length == then
        false return
    fi
    kind match
        ControlFlowKind::If => op_index ops.get.value common::OpValue::IfStart is
        ControlFlowKind::While => op_index ops.get.value common::OpValue::WhileStart is
        ControlFlowKind::Match => op_index ops.get.value common::OpValue::MatchStart is
    end
}
# Build the target index once before emitting an operation sequence.
fn precompute_control_flow_targets
    ops:$std::List[common::Op]
-> std::Result[ControlFlowTargets BytecodeFailure] {
    ops.length ControlFlowTargets::new = targets
    ops.length make_if_target_frames = if_frames
    ops.length make_while_target_frames = while_frames
    ops.length make_match_target_frames = match_frames
    ops.length = current_block

    0 = index: u64
    while index ops.length > do
        index targets.initialize
        index ops.get.value match
            common::OpValue::IfStart => {
                ops.length index IfTargetFrame if_frames.push
                current_block index targets.set_parent
                index = current_block
            }
            common::OpValue::IfCondition => {
                if ControlFlowKind::If current_block ops is_current_control_flow ! then
                    "`then` without matching `if`" make_control_flow_failure return
                fi
                if_frames.length 1 - if_frames.get_mut = frame
                frame.start index targets.set_start
                index = frame.branch
            }
            common::OpValue::IfElif => {
                if ControlFlowKind::If current_block ops is_current_control_flow ! then
                    "`elif` without parent `if`" make_control_flow_failure return
                fi
                if_frames.length 1 - if_frames.get_mut = frame
                if frame.branch ops.length != then
                    index frame.branch targets.set_next
                fi
                frame.start index targets.set_start
                index = frame.branch
            }
            common::OpValue::IfElse => {
                if ControlFlowKind::If current_block ops is_current_control_flow ! then
                    "`else` without parent `if`" make_control_flow_failure return
                fi
                if_frames.length 1 - if_frames.get_mut = frame
                if frame.branch ops.length != then
                    index frame.branch targets.set_next
                fi
                frame.start index targets.set_start
                index = frame.branch
            }
            common::OpValue::IfEnd => {
                if ControlFlowKind::If current_block ops is_current_control_flow ! then
                    if_frames.is_empty ! make_if_end_failure return
                fi
                current_block targets.get_parent = current_block
                if_frames.pop = frame
                frame.start index targets.set_start
                index frame.start targets.set_end
                if frame.branch ops.length != then
                    index frame.branch targets.set_next
                fi
            }
            common::OpValue::WhileStart => {
                ops.length index WhileTargetFrame while_frames.push
                current_block index targets.set_parent
                index = current_block
            }
            common::OpValue::WhileCondition => {
                if ControlFlowKind::While current_block ops is_current_control_flow ! then
                    "`do` without parent `while`" make_control_flow_failure return
                fi
                while_frames.length 1 - while_frames.get_mut = frame
                frame.start index targets.set_start
                if frame.first_end_target_op ops.length == then
                    index = frame.first_end_target_op
                fi
            }
            common::OpValue::WhileBreak => {
                if while_frames.is_empty then
                    "`break` without parent `while`" make_control_flow_failure return
                fi
                while_frames.length 1 - while_frames.get_mut = frame
                frame.start index targets.set_start
                if frame.first_end_target_op ops.length == then
                    index = frame.first_end_target_op
                fi
            }
            common::OpValue::WhileContinue => {
                if while_frames.is_empty then
                    "`continue` without parent `while`" make_control_flow_failure return
                fi
                while_frames.length 1 - while_frames.get.start index targets.set_start
            }
            common::OpValue::WhileEnd => {
                if ControlFlowKind::While current_block ops is_current_control_flow ! then
                    "`done` without parent `while`" make_control_flow_failure return
                fi
                current_block targets.get_parent = current_block
                while_frames.pop = frame
                frame.start index targets.set_start
                index frame.start targets.set_end
            }
            common::OpValue::MatchStart => {
                ops.length index MatchTargetFrame match_frames.push
                current_block index targets.set_parent
                index = current_block
            }
            common::OpValue::MatchArm(_) => {
                if ControlFlowKind::Match current_block ops is_current_control_flow ! then
                    "`match` arm without parent `match`" make_control_flow_failure return
                fi
                match_frames.length 1 - match_frames.get_mut = frame
                if frame.arm ops.length != then
                    index frame.arm targets.set_next
                fi
                frame.start index targets.set_start
                index = frame.arm
            }
            common::OpValue::MatchEnd => {
                if ControlFlowKind::Match current_block ops is_current_control_flow ! then
                    "`end` without parent `match`" make_control_flow_failure return
                fi
                current_block targets.get_parent = current_block
                match_frames.pop = frame
                frame.start index targets.set_start
                index frame.start targets.set_end
                if frame.arm ops.length != then
                    index frame.arm targets.set_next
                fi
            }
            _ => {
            }
        end
        1 += index
    done

    if current_block ops.length != then
        current_block ops.get.value match
            common::OpValue::IfStart => {
                "`if` without matching `fi`" make_control_flow_failure return
            }
            common::OpValue::WhileStart => {
                while_frames.length 1 - while_frames.get = frame
                frame ops make_open_while_failure return
            }
            common::OpValue::MatchStart => {
                match_frames.length 1 - match_frames.get = frame
                if frame.arm ops.length != then
                    "`match` arm without matching `end`" make_control_flow_failure return
                fi
                "`match` without matching `end`" make_control_flow_failure return
            }
            _ => "Unrecognized open control-flow block" make_control_flow_failure return
        end
    fi
    targets std::Result::Ok
}

# ============================================================================
# Compile assignment
# ============================================================================

impl common::OpValue {
    fn produces_integer_result self:$common::OpValue -> bool {
        self match
            common::OpValue::Add => true
            common::OpValue::Sub => true
            common::OpValue::Mul => true
            common::OpValue::Div => true
            common::OpValue::Mod => true
            common::OpValue::Shl => true
            common::OpValue::Shr => true
            common::OpValue::BitAnd => true
            common::OpValue::BitOr => true
            common::OpValue::BitXor => true
            common::OpValue::BitNot => true
            common::OpValue::AssignInc => true
            common::OpValue::AssignDec => true
            common::OpValue::WrappingAdd => true
            common::OpValue::WrappingSub => true
            common::OpValue::WrappingMul => true
            _ => false
        end
    }

    fn select_typed_instruction
        self:$common::OpValue
        direct:common::InstValue
        builtin:$common::BuiltinType
    -> common::InstValue {
        if builtin.is_float then
            if builtin common::BuiltinType::F32 == then
                self match
                    common::OpValue::Add => common::InstValue::FloatAdd32
                    common::OpValue::Sub => common::InstValue::FloatSub32
                    common::OpValue::Mul => common::InstValue::FloatMul32
                    common::OpValue::Div => common::InstValue::FloatDiv32
                    common::OpValue::Eq => common::InstValue::FloatEq32
                    common::OpValue::Ne => common::InstValue::FloatNe32
                    common::OpValue::Lt => common::InstValue::FloatLt32
                    common::OpValue::Le => common::InstValue::FloatLe32
                    common::OpValue::Gt => common::InstValue::FloatGt32
                    common::OpValue::Ge => common::InstValue::FloatGe32
                    _ => direct
                end
            else
                self match
                    common::OpValue::Add => common::InstValue::FloatAdd64
                    common::OpValue::Sub => common::InstValue::FloatSub64
                    common::OpValue::Mul => common::InstValue::FloatMul64
                    common::OpValue::Div => common::InstValue::FloatDiv64
                    common::OpValue::Eq => common::InstValue::FloatEq64
                    common::OpValue::Ne => common::InstValue::FloatNe64
                    common::OpValue::Lt => common::InstValue::FloatLt64
                    common::OpValue::Le => common::InstValue::FloatLe64
                    common::OpValue::Gt => common::InstValue::FloatGt64
                    common::OpValue::Ge => common::InstValue::FloatGe64
                    _ => direct
                end
            fi
            return
        fi
        self match
            common::OpValue::Add => {
                builtin copy common::InstValue::CheckedAdd return
            }
            common::OpValue::Sub => {
                builtin copy common::InstValue::CheckedSub return
            }
            common::OpValue::Mul => {
                builtin copy common::InstValue::CheckedMul return
            }
            common::OpValue::Div => {
                builtin copy common::InstValue::CheckedDiv return
            }
            common::OpValue::Mod => {
                builtin copy common::InstValue::CheckedMod return
            }
            common::OpValue::Shl => {
                builtin copy common::InstValue::CheckedShl return
            }
            common::OpValue::Shr => {
                builtin copy common::InstValue::CheckedShr return
            }
            _ => {
            }
        end
        if builtin.is_unsigned ! then
            direct return
        fi
        self match
            common::OpValue::Div => common::InstValue::UDiv
            common::OpValue::Mod => common::InstValue::UMod
            common::OpValue::Shr => common::InstValue::UShr
            common::OpValue::Lt => common::InstValue::Ult
            common::OpValue::Le => common::InstValue::Ule
            common::OpValue::Gt => common::InstValue::Ugt
            common::OpValue::Ge => common::InstValue::Uge
            common::OpValue::PrintInt => common::InstValue::PrintUint
            _ => direct
        end
    }
}

impl BytecodeCompiler {
    fn emit_integer_normalization
        compiler:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        if op.value.produces_integer_result ! then
            return
        fi
        if op.type_hint std::Option::Some(type_hint) is then
            if type_hint common::Type::Builtin(builtin) is then
                if builtin.is_integer ! then
                    return
                fi
                builtin common::InstValue::NormalizeInt bytecode.push
            fi
        fi
    }

    fn compile_assignment
        compiler:mut$BytecodeCompiler
        op:$common::Op
        bytecode:mut$std::List[common::InstValue]
    {
        op common::op_str_value = name
        if name compiler.capture_slots.get_copy std::Option::Some(capture_index) is then
            false = owns_capture
            common::make_unknown_type.clone = capture_type
            if compiler.function std::Option::Some(function) is then
                name.as_str function.owned_captures common::string_list_contains = owns_capture
                capture_index function.captures.get common::Variable::typ.clone = capture_type
            fi
            if op.value common::OpValue::AssignVar is then
                if owns_capture then
                    compiler.new_label = inactive_label
                    capture_index common::InstValue::CaptureFlagLoad bytecode.push
                    0 common::InstValue::Push bytecode.push
                    common::InstValue::Ne bytecode.push
                    inactive_label common::InstValue::JumpNe bytecode.push
                    capture_index common::InstValue::CaptureLoad bytecode.push
                    bytecode op capture_type compiler.compile_destruction
                    inactive_label common::InstValue::Label bytecode.push
                fi
                if owns_capture capture_type compiler.is_copy_aggregate && then
                    common::InstValue::Dup bytecode.push
                    bytecode capture_type compiler.emit_typed_load
                    common::InstValue::Swap bytecode.push
                    common::InstValue::HeapFreeIfAllocated bytecode.push
                fi
                capture_index common::InstValue::CaptureSet bytecode.push
                if owns_capture then
                    capture_index common::InstValue::CaptureFlagMark bytecode.push
                fi
                return
            fi
            capture_index common::InstValue::CaptureLoad bytecode.push
            if op.value common::OpValue::AssignDec is then
                common::InstValue::Swap bytecode.push
                common::InstValue::Sub bytecode.push
            elif op.value common::OpValue::AssignInc is then
                common::InstValue::Add bytecode.push
            else
                "compile_assignment received an unsupported capture assignment" compiler.record_failure
                return
            fi
            bytecode op compiler.emit_integer_normalization
            capture_index common::InstValue::CaptureSet bytecode.push
            return
        fi
        name.as_str compiler.resolve_variable = resolved

        op.value match
            common::OpValue::AssignDec => {
                bytecode resolved.emit_get
                common::InstValue::Swap bytecode.push
                common::InstValue::Sub = instruction
                if op.type_hint std::Option::Some(type_hint) is then
                    if type_hint common::Type::Builtin(builtin) is then
                        builtin common::InstValue::CheckedSub = instruction
                    fi
                fi
                instruction bytecode.push
                bytecode op compiler.emit_integer_normalization
                bytecode resolved.emit_set
            }
            common::OpValue::AssignInc => {
                bytecode resolved.emit_get
                common::InstValue::Add = instruction
                if op.type_hint std::Option::Some(type_hint) is then
                    if type_hint common::Type::Builtin(builtin) is then
                        builtin common::InstValue::CheckedAdd = instruction
                    fi
                fi
                instruction bytecode.push
                bytecode op compiler.emit_integer_normalization
                bytecode resolved.emit_set
            }
            common::OpValue::AssignVar => bytecode name.as_str compiler.emit_variable_set
            common::OpValue::Question(_) => bytecode name.as_str compiler.emit_variable_set
            _ => {
                "compile_assignment received a non-assignment operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile if block
# ============================================================================

impl BytecodeCompiler {
    fn compile_if_block
        self:mut$BytecodeCompiler
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        bytecode:mut$std::List[common::InstValue]
    {
        op.value match
            common::OpValue::IfCondition => {
                if op_index targets.get_next std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = end_label
                    end_label common::InstValue::JumpNe bytecode.push
                else
                    "If condition target is missing during bytecode compilation" self.record_failure
                fi
            }
            common::OpValue::IfElif => {
                op_index ops.get self.op_to_label = elif_label
                if op_index targets.get_end std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = end_label_2
                    bytecode op self.compile_owner_cleanups
                    end_label_2 common::InstValue::Jump bytecode.push
                    elif_label common::InstValue::Label bytecode.push
                    bytecode op self.compile_owner_cleanups
                else
                    "Elif end target is missing during bytecode compilation" self.record_failure
                fi
            }
            common::OpValue::IfElse => {
                op_index ops.get self.op_to_label = else_label
                if op_index targets.get_end std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = end_label_3
                    bytecode op self.compile_owner_cleanups
                    end_label_3 common::InstValue::Jump bytecode.push
                    else_label common::InstValue::Label bytecode.push
