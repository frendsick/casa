# Bytecode compiler: lowers Op tree into a flat List[InstValue].
#
# Translates high-level Ops (produced by the parser/typechecker) into
# low-level instructions suitable for code generation.
import "std"
import "common"
import "error"
import "pattern"
import "typechecker"

# ============================================================================
# BytecodeCompiler struct
# ============================================================================

struct BytecodeFailure {
    message: str
}

impl BytecodeFailure {
    fn new message:str -> BytecodeFailure { message BytecodeFailure }
}

struct BytecodeCompiler {
    ops:               List[Op]
    function:          Option[Function]
    local_slots:       Map[str u64]
    capture_slots:     Map[str u64]
    global_slots:      Map[str u64]
    locals_count:      u64
    string_table:      List[str]
    string_indices:    Map[str u64]
    constants_table:   List[str]
    static_arrays:     List[StaticArray]
    static_structs:    List[StaticStruct]
    store:             SymbolStore
    label_counter:     u64
    op_label_map:      Map[i64 u64]
    function_bytecode: Map[str List[InstValue]]
    owner_flags:       Map[str u64]
    failure:           Option[BytecodeFailure]
}

impl BytecodeCompiler {
    fn new store:$SymbolStore ops:mut$List[Op] -> BytecodeCompiler {
        Option[BytecodeFailure]::None
        Map[str u64]::new
        Map[str List[InstValue]]::new
        Map[i64 u64]::new
        0
        store
        List[StaticStruct]::new
        List[StaticArray]::new
        List[str]::new
        Map[str u64]::new
        List[str]::new
        0
        store.variables index_variable_map
        Map[str u64]::new
        Map[str u64]::new
        Option[Function]::None
        ops
        BytecodeCompiler
    }

    fn child self:mut$BytecodeCompiler function:mut$Function ops:mut$List[Op] -> BytecodeCompiler {
        self.failure
        Map[str u64]::new
        self.function_bytecode
        self.op_label_map
        self.label_counter
        self.store
        self.static_structs
        self.static_arrays
        self.constants_table
        self.string_indices
        self.string_table
        0
        self.global_slots
        function.captures index_variable_list
        function.variables index_variable_list
        function Option::Some
        ops
        BytecodeCompiler
    }

    fn record_failure self:mut$BytecodeCompiler message:str {
        if self.failure.is_none then
            message BytecodeFailure::new Option::Some = self.failure
        fi
    }

    fn has_failed self:mut$BytecodeCompiler -> bool { self.failure.is_some }

    fn absorb_child self:mut$BytecodeCompiler child:mut$BytecodeCompiler {
        child.failure = self.failure
        child.global_slots = self.global_slots
        child.string_table = self.string_table
        child.string_indices = self.string_indices
        child.constants_table = self.constants_table
        child.static_arrays = self.static_arrays
        child.static_structs = self.static_structs
        child.store = self.store
        child.label_counter = self.label_counter
        child.op_label_map = self.op_label_map
        child.function_bytecode = self.function_bytecode
    }

    fn aggregate_field_load
        compiler:mut$BytecodeCompiler
        declared_type:$Type
        bytecode:mut$List[InstValue]
    {
        if declared_type.has_unresolved_type_var then
            InstValue::Load64 bytecode.push
            return
        fi
        if compiler.store declared_type type_value_representation Option::Some(representation) is then
            if VALUE_REPR_INDIRECT representation == then
                InstValue::Load64 bytecode.push
            else
                bytecode declared_type compiler.emit_typed_load
            fi
        else
            f"Cannot determine field representation of `{declared_type.format}`" compiler.record_failure
        fi
    }

    fn aggregate_field_store
        compiler:mut$BytecodeCompiler
        declared_type:$Type
        bytecode:mut$List[InstValue]
    {
        if declared_type.has_unresolved_type_var then
            InstValue::Store64 bytecode.push
            return
        fi
        if compiler.store declared_type type_value_representation Option::Some(representation) is then
            if VALUE_REPR_INDIRECT representation == then
                InstValue::Store64 bytecode.push
            else
                bytecode declared_type compiler.emit_typed_store
            fi
        else
            f"Cannot determine field representation of `{declared_type.format}`" compiler.record_failure
        fi
    }

    fn struct_size compiler:mut$BytecodeCompiler casa_struct:$CasaStruct -> u64 {
        casa_struct.name GenericType::new Type::Generic = struct_type
        if compiler.store struct_type type_inline_size Option::Some(size) is then
            size return
        fi
        f"Cannot determine layout of struct `{casa_struct.name}`" compiler.record_failure
        0
    }

    fn struct_offset compiler:mut$BytecodeCompiler casa_struct:$CasaStruct member_index:u64 -> u64 {
        if compiler.store member_index casa_struct struct_member_offset Option::Some(offset) is then
            offset return
        fi
        f"Cannot determine member {member_index} layout of struct `{casa_struct.name}`"
        compiler.record_failure
        0
    }

    fn enum_size compiler:mut$BytecodeCompiler casa_enum:$CasaEnum -> u64 {
        casa_enum.name GenericType::new Type::Generic = enum_type
        if compiler.store enum_type type_inline_size Option::Some(size) is then
            size return
        fi
        f"Cannot determine layout of enum `{casa_enum.name}`" compiler.record_failure
        0
    }

    fn enum_offset
        compiler:mut$BytecodeCompiler
        casa_enum:$CasaEnum
        variant_name:$str
        payload_index:u64
    -> u64 {
        if
            compiler.store payload_index variant_name casa_enum
            enum_payload_offset Option::Some(offset) is
        then
            offset return
        fi
        f"Cannot determine payload {payload_index} layout of `{casa_enum.name}::{variant_name}`"
        compiler.record_failure
        0
    }
}

# ============================================================================
# Label management
# ============================================================================

impl BytecodeCompiler {
    fn new_label compiler:mut$BytecodeCompiler -> u64 {
        compiler.label_counter = value
        1 += compiler.label_counter
        value
    }
}

impl BytecodeCompiler {
    fn op_to_label compiler:mut$BytecodeCompiler op:mut$Op -> u64 {
        op op_identity = address
        if address compiler.op_label_map.get_copy Option::Some(existing) is then
            existing
        else
            compiler.new_label = label
            label address compiler.op_label_map.set
            label
        fi
    }
}

# ============================================================================
# String/constant interning
# ============================================================================

fn intern_table table:mut$List[str] value:$str -> u64 {
    # Add value to table if not present, return its index.
    if value table string_list_contains then
        value table string_list_index (u64)
    else
        table.length = table_index
        value.clone table.push
        table_index
    fi
}

impl BytecodeCompiler {
    fn intern_string compiler:mut$BytecodeCompiler value:mut$str -> u64 {
        if value compiler.string_indices.get Option::Some(index) is then
            index
        else
            compiler.string_table.length = index
            index value.clone compiler.string_indices.set
            value.clone compiler.string_table.push
            index
        fi
    }
}

# ============================================================================
# Variable resolution
# ============================================================================

fn index_variable_list variables:$List[Variable] -> Map[str u64] {
    Map[str u64]::new = slots
    0 (u64) = index
    for variable in variables.iter do
        if variable.name slots.has ! then
            index variable.name.clone slots.set
        fi
        1 += index
    done
    slots
}

fn index_variable_map variables:$Map[str Variable] -> Map[str u64] {
    Map[str u64]::new = slots
    variables.keys = names
    0 (u64) = index
    for name in names.iter do
        index name.clone slots.set
        1 += index
    done
    slots
}

impl BytecodeCompiler {
    fn resolve_variable compiler:mut$BytecodeCompiler variable_name:mut$str -> ResolvedVariable {
        if variable_name compiler.local_slots.get Option::Some(local_index) is then
            local_index ResolvedVariable::Local return
        fi
        if variable_name compiler.global_slots.get Option::Some(global_index) is then
            global_index ResolvedVariable::Global return
        fi
        f"Variable `{variable_name}` is missing during bytecode compilation" compiler.record_failure
        0 ResolvedVariable::Local
    }
}

# ============================================================================
# Deterministic destruction
# ============================================================================

impl BytecodeCompiler {
    fn compile_drop_hook
        compiler:mut$BytecodeCompiler
        typ:mut$Type
        op:mut$Op
        bytecode:mut$List[InstValue]
    {
        f"{typ.match_base}::drop" = function_name
        if
            function_name compiler
                .store
                .functions
                .get Option::Some(function) is
        then
            InstValue::Dup bytecode.push
            op function compiler.compile_function
            function_name InstValue::FnCall bytecode.push
        fi
    }

    # Destroy every element of an `array[T N]` value. The array stores nothing
    # but its elements, so the element count comes from the type (ADR-0152).
    fn compile_array_destruction
        compiler:mut$BytecodeCompiler
        element_type:mut$Type
        length:$ConstType
        op:mut$Op
        bytecode:mut$List[InstValue]
    {
        compiler.locals_count = array_local
        1 += compiler.locals_count
        compiler.locals_count = index_local
        1 += compiler.locals_count
        array_local InstValue::LocalSet bytecode.push
        if length.is_symbolic then
            length.name compiler.resolve_variable = resolved_length
            bytecode resolved_length.emit_get
        else
            length.value InstValue::Push bytecode.push
        fi
        index_local InstValue::LocalSet bytecode.push

        compiler.new_label = start_label
        compiler.new_label = element_label
        compiler.new_label = end_label
        start_label InstValue::Label bytecode.push
        index_local InstValue::LocalGet bytecode.push
        0 InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        element_label InstValue::JumpNe bytecode.push
        end_label InstValue::Jump bytecode.push
        element_label InstValue::Label bytecode.push
        index_local InstValue::LocalGet bytecode.push
        1 InstValue::Push bytecode.push
        InstValue::Sub bytecode.push
        index_local InstValue::LocalSet bytecode.push
        array_local InstValue::LocalGet bytecode.push
        index_local InstValue::LocalGet bytecode.push
        bytecode element_type compiler.emit_inline_size
        InstValue::Mul bytecode.push
        InstValue::Add bytecode.push
        bytecode element_type compiler.emit_typed_load
        bytecode op element_type compiler.compile_destruction
        start_label InstValue::Jump bytecode.push
        end_label InstValue::Label bytecode.push
    }

    fn compile_struct_fields
        compiler:mut$BytecodeCompiler
        typ:$Type
        casa_struct:mut$CasaStruct
        skipped:mut$List[str]
        op:mut$Op
        bytecode:mut$List[InstValue]
    {
        casa_struct.type_vars typ aggregate_type_bindings = substitutions
        casa_struct.members.length = member_index
        while 0 member_index != do
            1 -= member_index
            member_index casa_struct.members.get = member
            if member.name skipped string_list_contains then
                continue
            fi
            substitutions member.typ.substitute_t = member_type
            InstValue::Dup bytecode.push
            member_index casa_struct compiler.struct_offset = offset
            if 0 offset != then
                offset (i64) InstValue::Push bytecode.push
                InstValue::Add bytecode.push
            fi
            bytecode member.typ compiler.aggregate_field_load
            bytecode op member_type compiler.compile_destruction
        done
        InstValue::Drop bytecode.push
    }

    fn compile_enum_variant_fields
        compiler:mut$BytecodeCompiler
        typ:$Type
        casa_enum:mut$CasaEnum
        variant_name:mut$str
        skipped_count:u64
        op:mut$Op
        bytecode:mut$List[InstValue]
    {
        casa_enum.type_vars typ aggregate_type_bindings = substitutions
        if variant_name casa_enum.variant_types.get Option::Some(payload_types) is then
            payload_types.length = payload_index
            while skipped_count payload_index > do
                1 -= payload_index
                substitutions payload_index payload_types.get.substitute_t = payload_type
                InstValue::Dup bytecode.push
                payload_index variant_name casa_enum compiler.enum_offset i64::try_from.unwrap
                InstValue::Push bytecode.push
                InstValue::Add bytecode.push
                bytecode payload_index payload_types.get compiler.aggregate_field_load
                bytecode op payload_type compiler.compile_destruction
            done
        fi
        InstValue::Drop bytecode.push
    }

    fn compile_enum_fields
        compiler:mut$BytecodeCompiler
        typ:$Type
        casa_enum:mut$CasaEnum
        op:mut$Op
        bytecode:mut$List[InstValue]
    {
        compiler.locals_count = enum_local
        1 += compiler.locals_count
        enum_local InstValue::LocalSet bytecode.push
        compiler.new_label = end_label
        0 (u64) = variant_index
        while variant_index casa_enum.variants.length > do
            compiler.new_label = next_label
            enum_local InstValue::LocalGet bytecode.push
            InstValue::Load64 bytecode.push
            variant_index (i64) InstValue::Push bytecode.push
            InstValue::Eq bytecode.push
            next_label InstValue::JumpNe bytecode.push
            enum_local InstValue::LocalGet bytecode.push
            variant_index casa_enum.variants.get = variant_name
            bytecode op 0 variant_name casa_enum typ compiler.compile_enum_variant_fields
            end_label InstValue::Jump bytecode.push
            next_label InstValue::Label bytecode.push
            1 += variant_index
        done
        end_label InstValue::Label bytecode.push
    }

    fn compile_destruction_body
        compiler:mut$BytecodeCompiler
        typ:mut$Type
        op:mut$Op
        bytecode:mut$List[InstValue]
    {
        if typ.is_borrow then
            InstValue::Drop bytecode.push return
        fi
        bytecode op typ compiler.compile_drop_hook
        typ clone_type = destruction_type
        if destruction_type Type::Generic(generic) is then
            if ARRAY_TYPE generic.base == then
                if destruction_type get_array_length_parameter Option::Some(array_length) is then
                    bytecode op array_length 0 generic.params.get compiler.compile_array_destruction
                else
                    InstValue::Drop bytecode.push
                fi
                return
            fi
            if generic.base compiler.store.clone_struct Option::Some(owned_struct) is then
                List[str]::new = skipped
                bytecode op skipped owned_struct typ compiler.compile_struct_fields
                return
            fi
            if generic.base compiler.store.clone_enum Option::Some(owned_enum) is then
                if owned_enum has_inner_values then
                    bytecode op owned_enum typ compiler.compile_enum_fields
                else
                    InstValue::Drop bytecode.push
                fi
                return
            fi
        fi
        InstValue::Drop bytecode.push
    }

    fn destruction_needs_function compiler:mut$BytecodeCompiler typ:mut$Type -> bool {
        compiler.store typ type_needs_destruction_in_store
    }

    fn ensure_destruction_function compiler:mut$BytecodeCompiler typ:mut$Type op:mut$Op -> str {
        f"__drop_{typ.format}" = function_name
        if function_name compiler.function_bytecode.has then
            function_name return
        fi
        List[InstValue]::new function_name.clone compiler.function_bytecode.set

        List[Op]::new = empty_ops
        empty_location empty_ops function_name.clone Function::new = function
        List[Op]::new = destructor_ops
        destructor_ops function compiler.child = destructor
        List[InstValue]::new = body
        body op typ destructor.compile_destruction_body
        destructor compiler.absorb_child
        if compiler.has_failed then
            function_name return
        fi

        List[InstValue]::new = function_bytecode
        if 0 destructor.locals_count != then
            destructor.locals_count InstValue::LocalsInit function_bytecode.push
        fi
        body.shallow_copy function_bytecode.append
        if 0 destructor.locals_count != then
            destructor.locals_count InstValue::LocalsUninit function_bytecode.push
        fi
        InstValue::FnReturn function_bytecode.push
        function_bytecode function_name.clone compiler.function_bytecode.set
        function_name
    }

    fn compile_destruction
        compiler:mut$BytecodeCompiler
        typ:mut$Type
        op:mut$Op
        bytecode:mut$List[InstValue]
    {
        if typ compiler.destruction_needs_function ! then
            InstValue::Drop bytecode.push
            return
        fi
        if typ get_array_length_parameter Option::Some(array_length) is then
            if array_length.is_symbolic then
                bytecode op typ compiler.compile_destruction_body
                return
            fi
        fi
        op typ compiler.ensure_destruction_function = function_name
        function_name InstValue::FnCall bytecode.push
    }

    fn compile_match_destruction
        compiler:mut$BytecodeCompiler
        op:mut$Op
        bytecode:mut$List[InstValue]
    {
        if op.type_hint Option::None is then
            InstValue::Drop bytecode.push return
        fi
        op.type_hint.unwrap = typ
        if typ compiler.destruction_needs_function ! then
            InstValue::Drop bytecode.push
            return
        fi
        bytecode op typ compiler.compile_drop_hook
        if typ Type::Generic(generic) is then
            if generic.base compiler.store.clone_struct Option::Some(owned_struct) is then
                List[str]::new = skipped
                if op pattern_value_of PatternValue::Struct(struct_pattern) is then
                    struct_pattern.bindings.keys = skipped
                fi
                bytecode op skipped owned_struct typ compiler.compile_struct_fields
                return
            fi
            if generic.base compiler.store.clone_enum Option::Some(owned_enum) is then
                if owned_enum has_inner_values ! then
                    InstValue::Drop bytecode.push return
                fi
                if op pattern_value_of PatternValue::EnumVariant(variant) is then
                    if op pattern_is_wildcard then
                        bytecode op owned_enum typ compiler.compile_enum_fields
                    else
                        variant.bindings.length = skipped_count
                        bytecode op skipped_count variant.variant_name owned_enum typ
                        compiler.compile_enum_variant_fields
                    fi
                    return
                fi
            fi
        fi
        InstValue::Drop bytecode.push
    }

    fn owner_flag compiler:mut$BytecodeCompiler name:mut$str -> u64 {
        if name compiler.owner_flags.get Option::Some(flag) is then
            flag return
        fi
        compiler.locals_count = flag
        1 += compiler.locals_count
        flag name.clone compiler.owner_flags.set
        flag
    }

    fn set_owner_flag
        compiler:mut$BytecodeCompiler
        name:mut$str
        value:u64
        bytecode:mut$List[InstValue]
    {
        name compiler.owner_flag = flag
        value (i64) InstValue::Push bytecode.push
        flag InstValue::LocalSet bytecode.push
    }

    fn compile_active_owner_cleanup
        compiler:mut$BytecodeCompiler
        event:mut$OwnerEvent
        op:mut$Op
        bytecode:mut$List[InstValue]
    {
        event.name compiler.owner_flag = flag
        compiler.new_label = cleanup_label
        compiler.new_label = end_label
        flag InstValue::LocalGet bytecode.push
        0 InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        cleanup_label InstValue::JumpNe bytecode.push
        end_label InstValue::Jump bytecode.push
        cleanup_label InstValue::Label bytecode.push
        event.name compiler.resolve_variable = resolved
        bytecode resolved.emit_get
        bytecode op event.typ compiler.compile_destruction
        bytecode 0 event.name compiler.set_owner_flag
        end_label InstValue::Label bytecode.push
    }

    fn compile_owner_cleanup
        compiler:mut$BytecodeCompiler
        event:mut$OwnerEvent
        op:mut$Op
        bytecode:mut$List[InstValue]
    {
        event.name compiler.owner_flag = flag
        compiler.new_label = end_label
        flag InstValue::LocalGet bytecode.push
        event.generation (i64) InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        end_label InstValue::JumpNe bytecode.push
        event.name compiler.resolve_variable = resolved
        bytecode resolved.emit_get
        bytecode op event.typ compiler.compile_destruction
        bytecode 0 event.name compiler.set_owner_flag
        end_label InstValue::Label bytecode.push
    }

    fn compile_owner_cleanups compiler:mut$BytecodeCompiler op:mut$Op bytecode:mut$List[InstValue] {
        if op op_identity compiler.store.clone_ownership Option::Some(owned_ownership) is then
            for event in owned_ownership.cleanups.iter do
                event.clone = owned_event
                bytecode op owned_event compiler.compile_owner_cleanup
            done
        fi
    }
}

# ============================================================================
# Block matching (find_matching_label)
# ============================================================================

fn is_block_start_value op_value:mut$OpValue -> bool {
    op_value OpValue::IfStart is
    op_value OpValue::WhileStart is ||
    op_value OpValue::MatchStart is ||
}

fn is_block_end_value op_value:mut$OpValue -> bool {
    op_value OpValue::IfEnd is
    op_value OpValue::WhileEnd is ||
    op_value OpValue::MatchEnd is ||
}
# Search for matching block label respecting nesting. `backward` = true scans
# toward index 0, false scans toward ops.length. `boundary_value` is the
# opening/closing variant at which to give up (end variant going forward,
# start variant going backward).

impl BytecodeCompiler {
    fn find_matching_label
        compiler:mut$BytecodeCompiler
        ops:mut$List[Op]
        op_index:u64
        boundary_value:OpValue
        target_values:List[OpValue]
        backward:bool
    -> Option[u64] {
        if backward then -1 else 1 fi = step
        0 step - = neg_step
        1 = depth
        op_index (i64) step + = index
        while
                if backward then
                    0 index >=
                else
                    index ops.length (i64) >
                fi
        do
            index (u64) ops.get = other_op
            other_op.value = other_value
            if 1 depth <= then
                if other_value target_values op_value_list_contains then
                    index (u64) ops.get compiler.op_to_label Option::Some return
                fi
            fi
            if other_value is_block_start_value then
                step += depth
            elif other_value is_block_end_value then
                neg_step += depth
            fi
            if 1 depth < then
                if boundary_value other_value == then
                    Option::None return
                fi
            fi
            step += index
        done
        Option::None
    }
}

fn op_value_list_contains items:mut$List[OpValue] value:mut$OpValue -> bool {
    for item in items.iter do
        if value item == then
            true return
        fi
    done
    false
}
# find_matching_label needs a sentinel value in target_values, but
# OpValue::MatchArm carries a payload that cannot be constructed bare for
# tag-only equality. This forward scan tracks depth and returns the label
# of the next OpMatchArm or None on OpMatchEnd at depth 0.

impl BytecodeCompiler {
    fn find_next_match_arm_or_end
        compiler:mut$BytecodeCompiler
        ops:mut$List[Op]
        op_index:u64
    -> Option[u64] {
        1 = depth
        op_index 1 + = index
        while index ops.length > do
            index ops.get = other_op
            other_op.value = other_value
            if 1 depth <= then
                if other_value OpValue::MatchArm is then
                    index ops.get compiler.op_to_label Option::Some return
                fi
            fi
            if other_value is_block_start_value then
                1 += depth
            elif other_value is_block_end_value then
                -1 += depth
            fi
            if 1 depth < then
                if other_value OpValue::MatchEnd is then
                    Option::None return
                fi
            fi
            1 += index
        done
        Option::None
    }
}

impl BytecodeCompiler {
    fn require_matching
        compiler:mut$BytecodeCompiler
        ops:mut$List[Op]
        op_index:u64
        boundary_value:OpValue
        target_values:List[OpValue]
        message:str
        backward:bool
    -> u64 {
        backward target_values boundary_value op_index ops compiler.find_matching_label = result
        if result Option::Some(label) is then
            label return
        fi
        message compiler.record_failure
        0
    }
}

# ============================================================================
# Compile assignment
# ============================================================================

impl OpValue {
    fn produces_integer_result self:$OpValue -> bool {
        self match
            OpValue::Add => true
            OpValue::Sub => true
            OpValue::Mul => true
            OpValue::Div => true
            OpValue::Mod => true
            OpValue::Shl => true
            OpValue::Shr => true
            OpValue::BitAnd => true
            OpValue::BitOr => true
            OpValue::BitXor => true
            OpValue::BitNot => true
            OpValue::AssignInc => true
            OpValue::AssignDec => true
            OpValue::WrappingAdd => true
            OpValue::WrappingSub => true
            OpValue::WrappingMul => true
            _ => false
        end
    }

    fn select_typed_instruction self:$OpValue direct:InstValue builtin:$BuiltinType -> InstValue {
        if builtin.is_float then
            if builtin BuiltinType::F32 == then
                self match
                    OpValue::Add => InstValue::FloatAdd32
                    OpValue::Sub => InstValue::FloatSub32
                    OpValue::Mul => InstValue::FloatMul32
                    OpValue::Div => InstValue::FloatDiv32
                    OpValue::Eq => InstValue::FloatEq32
                    OpValue::Ne => InstValue::FloatNe32
                    OpValue::Lt => InstValue::FloatLt32
                    OpValue::Le => InstValue::FloatLe32
                    OpValue::Gt => InstValue::FloatGt32
                    OpValue::Ge => InstValue::FloatGe32
                    _ => direct
                end
            else
                self match
                    OpValue::Add => InstValue::FloatAdd64
                    OpValue::Sub => InstValue::FloatSub64
                    OpValue::Mul => InstValue::FloatMul64
                    OpValue::Div => InstValue::FloatDiv64
                    OpValue::Eq => InstValue::FloatEq64
                    OpValue::Ne => InstValue::FloatNe64
                    OpValue::Lt => InstValue::FloatLt64
                    OpValue::Le => InstValue::FloatLe64
                    OpValue::Gt => InstValue::FloatGt64
                    OpValue::Ge => InstValue::FloatGe64
                    _ => direct
                end
            fi
            return
        fi
        self match
            OpValue::Add => {
                builtin (i64) (BuiltinType) InstValue::CheckedAdd return
            }
            OpValue::Sub => {
                builtin (i64) (BuiltinType) InstValue::CheckedSub return
            }
            OpValue::Mul => {
                builtin (i64) (BuiltinType) InstValue::CheckedMul return
            }
            OpValue::Div => {
                builtin (i64) (BuiltinType) InstValue::CheckedDiv return
            }
            OpValue::Mod => {
                builtin (i64) (BuiltinType) InstValue::CheckedMod return
            }
            OpValue::Shl => {
                builtin (i64) (BuiltinType) InstValue::CheckedShl return
            }
            OpValue::Shr => {
                builtin (i64) (BuiltinType) InstValue::CheckedShr return
            }
            _ => {
            }
        end
        if builtin.is_unsigned ! then
            direct return
        fi
        self match
            OpValue::Div => InstValue::UDiv
            OpValue::Mod => InstValue::UMod
            OpValue::Shr => InstValue::UShr
            OpValue::Lt => InstValue::Ult
            OpValue::Le => InstValue::Ule
            OpValue::Gt => InstValue::Ugt
            OpValue::Ge => InstValue::Uge
            OpValue::PrintInt => InstValue::PrintUint
            _ => direct
        end
    }
}

impl BytecodeCompiler {
    fn emit_integer_normalization
        compiler:mut$BytecodeCompiler
        op:mut$Op
        bytecode:mut$List[InstValue]
    {
        if op.value.produces_integer_result ! then
            return
        fi
        if op.type_hint Option::Some(type_hint) is then
            if type_hint Type::Builtin(builtin) is then
                if builtin.is_integer ! then
                    return
                fi
                builtin InstValue::NormalizeInt bytecode.push
            fi
        fi
    }

    fn compile_assignment compiler:mut$BytecodeCompiler op:mut$Op bytecode:mut$List[InstValue] {
        op op_str_value = name
        name compiler.resolve_variable = resolved

        op.value match
            OpValue::AssignDec => {
                bytecode resolved.emit_get
                InstValue::Swap bytecode.push
                InstValue::Sub = instruction
                if op.type_hint Option::Some(type_hint) is then
                    if type_hint Type::Builtin(builtin) is then
                        builtin InstValue::CheckedSub = instruction
                    fi
                fi
                instruction bytecode.push
                bytecode op compiler.emit_integer_normalization
                bytecode resolved.emit_set
            }
            OpValue::AssignInc => {
                bytecode resolved.emit_get
                InstValue::Add = instruction
                if op.type_hint Option::Some(type_hint) is then
                    if type_hint Type::Builtin(builtin) is then
                        builtin InstValue::CheckedAdd = instruction
                    fi
                fi
                instruction bytecode.push
                bytecode op compiler.emit_integer_normalization
                bytecode resolved.emit_set
            }
            OpValue::AssignVar => bytecode resolved.emit_set
            OpValue::Question(_) => bytecode resolved.emit_set
            _ => {
                "compile_assignment received a non-assignment operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile if block
# ============================================================================

impl BytecodeCompiler {
    fn compile_if_block
        compiler:mut$BytecodeCompiler
        op:mut$Op
        op_index:u64
        bytecode:mut$List[InstValue]
    {
        compiler.ops = ops
        List[OpValue]::new = start_targets
        OpValue::IfStart start_targets.push

        List[OpValue]::new = elif_else_end
        OpValue::IfElif elif_else_end.push
        OpValue::IfElse elif_else_end.push
        OpValue::IfEnd elif_else_end.push

        List[OpValue]::new = end_targets
        OpValue::IfEnd end_targets.push

        List[OpValue]::new = else_targets
        OpValue::IfElse else_targets.push

        op.value match
            OpValue::IfCondition => {
                true "`then` without matching `if`" start_targets OpValue::IfStart op_index ops compiler.require_matching drop
                false "`then` without matching `fi`" elif_else_end OpValue::IfEnd op_index ops compiler.require_matching = end_label
                end_label InstValue::JumpNe bytecode.push
            }
            OpValue::IfElif => {
                true "`elif` without parent `if`" start_targets OpValue::IfStart op_index ops compiler.require_matching drop
                op_index compiler.ops.get compiler.op_to_label = elif_label
                false "`elif` without matching `fi`" end_targets OpValue::IfEnd op_index ops compiler.require_matching = end_label_2
                bytecode op compiler.compile_owner_cleanups
                end_label_2 InstValue::Jump bytecode.push
                elif_label InstValue::Label bytecode.push
                bytecode op compiler.compile_owner_cleanups
            }
            OpValue::IfElse => {
                true "`else` without parent `if`" start_targets OpValue::IfStart op_index ops compiler.require_matching drop
                op_index compiler.ops.get compiler.op_to_label = else_label
                false "`else` without matching `fi`" end_targets OpValue::IfEnd op_index ops compiler.require_matching = end_label_3
                bytecode op compiler.compile_owner_cleanups
                end_label_3 InstValue::Jump bytecode.push
                else_label InstValue::Label bytecode.push
                bytecode op compiler.compile_owner_cleanups
            }
            OpValue::IfEnd => {
                true "`fi` without parent `if`" start_targets OpValue::IfStart op_index ops compiler.require_matching drop
                op_index compiler.ops.get compiler.op_to_label = fi_label
                bytecode op compiler.compile_owner_cleanups
                fi_label InstValue::Label bytecode.push
                bytecode op compiler.compile_owner_cleanups
            }
            OpValue::IfStart => false "`if` without matching `fi`" end_targets OpValue::IfEnd op_index ops compiler.require_matching drop
            _ => {
                "compile_if_block received a non-if operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile while block
# ============================================================================

impl BytecodeCompiler {
    fn compile_while_block
        compiler:mut$BytecodeCompiler
        op:mut$Op
        op_index:u64
        bytecode:mut$List[InstValue]
    {
        compiler.ops = ops
        List[OpValue]::new = start_targets
        OpValue::WhileStart start_targets.push

        List[OpValue]::new = end_targets
        OpValue::WhileEnd end_targets.push

        op.value match
            OpValue::WhileBreak => {
                true "`break` without parent `while`" start_targets OpValue::WhileStart op_index ops compiler.require_matching drop
                false "`break` without matching `done`" end_targets OpValue::WhileEnd op_index ops compiler.require_matching = end_label
                end_label InstValue::Jump bytecode.push
            }
            OpValue::WhileCondition => {
                true "`do` without parent `while`" start_targets OpValue::WhileStart op_index ops compiler.require_matching drop
                false "`do` without matching `done`" end_targets OpValue::WhileEnd op_index ops compiler.require_matching = end_label_2
                end_label_2 InstValue::JumpNe bytecode.push
            }
            OpValue::WhileContinue => {
                true "`continue` without parent `while`" start_targets OpValue::WhileStart op_index ops compiler.require_matching = continue_target
                continue_target InstValue::Jump bytecode.push
            }
            OpValue::WhileEnd => {
                op_index compiler.ops.get compiler.op_to_label = while_label
                true "`done` without parent `while`" start_targets OpValue::WhileStart op_index ops compiler.require_matching = loop_start
                bytecode op compiler.compile_owner_cleanups
                loop_start InstValue::Jump bytecode.push
                while_label InstValue::Label bytecode.push
                bytecode op compiler.compile_owner_cleanups
            }
            OpValue::WhileStart => {
                op_index compiler.ops.get compiler.op_to_label = start_label
                start_label InstValue::Label bytecode.push
            }
            _ => {
                "compile_while_block received a non-while operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile match block
# ============================================================================
# compile_match_op — per-arm bytecode entry point dispatching on PatternValue.
# Replaces the three former compile_match_arm_* helpers and consolidates
# literal / enum / struct emission behind a single pattern-driven function.

impl BytecodeCompiler {
    fn emit_struct_arm
        compiler:mut$BytecodeCompiler
        struct_pattern:StructPattern
        bytecode:mut$List[InstValue]
    {
        struct_pattern StructPattern::struct_name compiler.store.clone_struct = casa_struct_opt
        if casa_struct_opt.is_none then
            f"Struct `{struct_pattern.struct_name}` is missing during bytecode compilation" compiler.record_failure
            return
        fi
        casa_struct_opt.unwrap = casa_struct
        0 (u64) = index
        while index casa_struct CasaStruct::members.length > do
            index casa_struct CasaStruct::members.get = member
            member Member::name = field_name
            index casa_struct compiler.struct_offset = offset
            if field_name struct_pattern StructPattern::bindings.get Option::Some(var_name) is then
                InstValue::Dup bytecode.push
                if 0 offset > then
                    offset (i64) InstValue::Push bytecode.push
                    InstValue::Add bytecode.push
                fi
                bytecode member.typ compiler.aggregate_field_load
                var_name compiler.resolve_variable = resolved
                bytecode resolved.emit_set
            fi
            1 += index
        done
    }
}

fn emit_int_eq value:$i64 bytecode:mut$List[InstValue] {
    value InstValue::Push bytecode.push
    InstValue::Eq bytecode.push
}

fn require_variant_ordinal variant:mut$EnumVariant compiler:mut$BytecodeCompiler -> i64 {
    if variant.ordinal Option::Some(ordinal) is then
        ordinal return
    fi
    f"Enum variant `{variant.variant_name}` has no ordinal during bytecode compilation" compiler.record_failure
    0
}

impl BytecodeCompiler {
    fn emit_literal_arm
        compiler:mut$BytecodeCompiler
        literal_pattern:LiteralPattern
        is_last:bool
        next_arm:mut$Option[u64]
        bytecode:mut$List[InstValue]
    {
        if is_last then
            return
        fi
        InstValue::Dup bytecode.push
        literal_pattern.value match
            LiteralValue::Str(str_value) => {
                str_value compiler.intern_string = str_index
                str_index InstValue::PushStr bytecode.push
                InstValue::StrEq bytecode.push
            }
            LiteralValue::Int(int_value) => {
                bytecode int_value.value emit_int_eq
            }
            LiteralValue::Char(char_value) => {
                bytecode char_value emit_int_eq
            }
            LiteralValue::Bool(bool_value) => {
                bytecode bool_value (i64) emit_int_eq
            }
        end
        if next_arm Option::Some(label) is then
            label InstValue::JumpNe bytecode.push
        else
            "Match arm has no following label during bytecode compilation" compiler.record_failure
        fi
    }
}

impl BytecodeCompiler {
    fn emit_enum_arm
        compiler:mut$BytecodeCompiler
        variant:mut$EnumVariant
        is_wildcard:bool
        is_last:bool
        next_arm:mut$Option[u64]
        bytecode:mut$List[InstValue]
    {
        if is_wildcard then
            return
        fi
        variant.enum_name = enum_name
        if
            "" enum_name != enum_name compiler
                .store
                .enums
                .has &&
        then
            enum_name compiler
                .store
                .enums
                .get
                .unwrap
                .clone = casa_enum
            if casa_enum has_inner_values then
                if is_last ! then
                    InstValue::Dup bytecode.push
                    InstValue::Load64 bytecode.push
                    compiler variant require_variant_ordinal InstValue::Push bytecode.push
                    InstValue::Eq bytecode.push
                    if next_arm Option::Some(label) is then
                        label InstValue::JumpNe bytecode.push
                    else
                        "Match arm has no following label during bytecode compilation" compiler.record_failure
                    fi
                fi
                casa_enum variant bytecode compiler.emit_enum_arm_bindings
                return
            fi
        fi

        if is_last then
            return
        fi
        InstValue::Dup bytecode.push
        compiler variant require_variant_ordinal InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        if next_arm Option::Some(label) is then
            label InstValue::JumpNe bytecode.push
        else
            "Match arm has no following label during bytecode compilation" compiler.record_failure
        fi
    }
}

impl BytecodeCompiler {
    fn emit_enum_arm_bindings
        compiler:mut$BytecodeCompiler
        bytecode:mut$List[InstValue]
        variant:mut$EnumVariant
        casa_enum:mut$CasaEnum
    {
        variant.variant_name casa_enum
            .variant_types
            .get
            .unwrap = payload_types
        0 (u64) = index
        while index variant EnumVariant::bindings.length > do
            index variant.variant_name casa_enum compiler.enum_offset = offset
            InstValue::Dup bytecode.push
            offset (i64) InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            bytecode index payload_types.get compiler.aggregate_field_load
            index variant EnumVariant::bindings.get = var_name
            var_name compiler.resolve_variable = resolved
            bytecode resolved.emit_set
            1 += index
        done
    }
}

impl BytecodeCompiler {
    fn compile_match_op
        compiler:mut$BytecodeCompiler
        op:mut$Op
        is_last:bool
        next_arm:mut$Option[u64]
        bytecode:mut$List[InstValue]
    {
        if op.value OpValue::MatchArm(arm) is then
            arm.pattern_value match
                PatternValue::Struct(struct_pattern) => {
                    bytecode struct_pattern compiler.emit_struct_arm
                }
                PatternValue::Literal(literal_pattern) => {
                    bytecode next_arm is_last literal_pattern compiler.emit_literal_arm
                }
                PatternValue::EnumVariant(variant) => {
                    op pattern_is_wildcard = is_wildcard
                    bytecode next_arm is_last is_wildcard variant compiler.emit_enum_arm
                }
            end
            arm.guard_ops = guard_ops
            if guard_ops.length 0 != then
                0 (u64) = guard_index
                while guard_index guard_ops.length > do
                    guard_index guard_ops.get = guard_op
                    bytecode guard_index guard_op compiler.compile_op
                    1 += guard_index
                done
                if next_arm Option::Some(label) is then
                    label InstValue::JumpNe bytecode.push
                else
                    "Guarded match arm has no following label during bytecode compilation" compiler.record_failure
                fi
            fi
            if op op_identity compiler.store.clone_ownership Option::Some(owned_ownership) is then
                for event in owned_ownership.assignments.iter do
                    bytecode event.generation event.name.clone compiler.set_owner_flag
                done
            fi
            bytecode op compiler.compile_match_destruction
        fi
    }
}

impl BytecodeCompiler {
    fn compile_match_block
        compiler:mut$BytecodeCompiler
        op:mut$Op
        op_index:u64
        bytecode:mut$List[InstValue]
    {
        compiler.ops = ops
        op.value = match_value

        if match_value OpValue::MatchArm is then
            List[OpValue]::new = end_targets
            OpValue::MatchEnd end_targets.push

            false "`match` arm without matching `end`" end_targets OpValue::MatchEnd op_index ops compiler.require_matching = end_label

            op_index ops.get op_identity compiler.op_label_map.get_copy = existing
            existing.is_some ! = is_first

            if is_first ! then
                bytecode op compiler.compile_owner_cleanups
                end_label InstValue::Jump bytecode.push
                if existing Option::Some(label) is then
                    label InstValue::Label bytecode.push
                    bytecode op compiler.compile_owner_cleanups
                else
                    "Match arm label is missing during bytecode compilation" compiler.record_failure
                fi
            fi

            op_index ops compiler.find_next_match_arm_or_end = next_arm
            next_arm.is_none = is_last

            bytecode next_arm is_last op compiler.compile_match_op
        elif match_value OpValue::MatchEnd is then
            op_index compiler.ops.get compiler.op_to_label = end_match_label
            bytecode op compiler.compile_owner_cleanups
            end_match_label InstValue::Label bytecode.push
            bytecode op compiler.compile_owner_cleanups
        fi
    }
}

