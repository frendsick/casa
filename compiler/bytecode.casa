impl BytecodeCompiler {
    fn compile_struct_new compiler:mut$BytecodeCompiler op:mut$Op bytecode:mut$List[InstValue] {
        if op.value OpValue::StructNew(casa_struct) is then
            casa_struct CasaStruct::members.length = count
            casa_struct compiler.struct_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::HeapAlloc bytecode.push
            0 (u64) = index
            while index count > do
                InstValue::Swap bytecode.push
                InstValue::Over bytecode.push
                index casa_struct compiler.struct_offset = offset
                if 0 offset > then
                    offset i64::try_from.unwrap InstValue::Push bytecode.push
                    InstValue::Add bytecode.push
