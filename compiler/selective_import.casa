# Selective-import dependency discovery.
import "std"
import "common"
import "error"

enum SelectiveImportDeclaration {
    Function (Function)
    Constant (Constant)
    Struct (CasaStruct)
    Enum (CasaEnum)
    Trait (CasaTrait)
}

struct SelectiveImportTypeStack {
    types:            List[Type]
    parameters:       List[Parameter]
    next_parameter:   int
    branches:         List[SelectiveImportBranch]
    variables:        Map[str Type]
    infer_parameters: bool
}

struct SelectiveImportStackSnapshot {
    types:          List[Type]
    next_parameter: int
    variables:      Map[str Type]
}

enum SelectiveImportBranchKind {
    If
    While
    Match
}

impl StackEffect {
    fn needs_inference self:StackEffect -> bool {
        0 self.parameters.length == 0 self.return_types.length == &&
    }
}

impl GenericType {
    fn bind_arguments self:GenericType actual:Type bindings:Map[str Type] -> Map[str Type] {
        if actual Type::Generic(actual_generic) is then
            if self.base actual_generic.base == then
                for pair in actual_generic.params.iter self.params.iter.zip do
                    bindings pair.second pair.first bind_type_arguments = bindings
                done
            fi
        fi
        bindings
    }
}

impl FunctionType {
    fn bind_arguments self:FunctionType actual:Type bindings:Map[str Type] -> Map[str Type] {
        if actual Type::Function(actual_function) is then
            for pair in actual_function.parameters.iter self.parameters.iter.zip do
                bindings pair.second pair.first bind_type_arguments = bindings
            done
            for pair in actual_function.return_types.iter self.return_types.iter.zip do
                bindings pair.second pair.first bind_type_arguments = bindings
            done
        fi
        bindings
    }
}

struct SelectiveImportBranch {
    kind:         SelectiveImportBranchKind
    before:       Option[SelectiveImportStackSnapshot]
    subject_type: Option[Type]
}

impl SelectiveImportTypeStack {
    fn new function:Function -> SelectiveImportTypeStack {
        Map::new(Map[str Type]) = variables
        for variable in function.variables.iter do
            variable.typ variable.name variables.set = variables
        done
        for capture in function.captures.iter do
            capture.typ capture.name variables.set = variables
        done
        function.stack_effect.needs_inference
        variables
        List::new(List[SelectiveImportBranch])
        0
        function.stack_effect.parameters
        List::new(List[Type])
        SelectiveImportTypeStack
    }

    fn push self:SelectiveImportTypeStack type_value:Type {
        type_value self.types.push
    }

    fn peek self:SelectiveImportTypeStack -> Option[Type] {
        if 0 self.types.length != then
            self.types.length 1 - self.types.get Option::Some return
        fi
        if self.next_parameter self.parameters.length > then
            self.next_parameter self.parameters.get.typ Option::Some return
        fi
        if self.infer_parameters then
            TYPE_UNKNOWN_T Option::Some return
        fi
        Option::None(Option[Type])
    }

    fn pop self:SelectiveImportTypeStack -> Option[Type] {
        if 0 self.types.length != then
            self.types.pop Option::Some return
        fi
        if self.next_parameter self.parameters.length > then
            self.next_parameter self.parameters.get.typ = parameter_type
            1 += self.next_parameter
            parameter_type Option::Some return
        fi
        if self.infer_parameters then
            TYPE_UNKNOWN_T Parameter::new self.parameters.push
            1 += self.next_parameter
            TYPE_UNKNOWN_T Option::Some return
        fi
        Option::None(Option[Type])
    }

    fn drop_count self:SelectiveImportTypeStack count:int {
        0 = index
        while index count > do
            self.pop drop
            1 += index
        done
    }
}

fn bind_type_arguments expected:Type actual:Type bindings:Map[str Type] -> Map[str Type] {
    expected match
        Type::TypeVar(type_variable) => {
            if type_variable bindings.has ! then
                actual type_variable bindings.set = bindings
            fi
            bindings
        }
        Type::Generic(expected_generic) => {
            bindings actual expected_generic.bind_arguments
        }
        Type::Function(expected_function) => {
            bindings actual expected_function.bind_arguments
        }
        _ => bindings
    end
}

impl SelectiveImportTypeStack {
    fn apply_effect_with_bindings
        self:SelectiveImportTypeStack
        effect:StackEffect
    -> Map[str Type] {
        Map::new(Map[str Type]) = bindings
        for parameter in effect.parameters.iter do
            if parameter.name "__trait_" str::starts_with then
                continue
            fi
            if self.pop Option::Some(actual_type) is then
                bindings actual_type parameter.typ bind_type_arguments = bindings
            fi
        done
        for return_type in effect.return_types.iter do
            bindings return_type.substitute_t self.push
        done
        bindings
    }

    fn apply_effect self:SelectiveImportTypeStack effect:StackEffect {
        effect self.apply_effect_with_bindings drop
    }

    fn apply_result self:SelectiveImportTypeStack consumed:int result_type:Type {
        consumed self.drop_count
        result_type self.push
    }

    fn apply_function_pointer self:SelectiveImportTypeStack {
        if self.pop Option::Some(function_pointer_type) is then
            if function_pointer_type Type::Function(function_type) is then
                function_type function_type_to_stack_effect self.apply_effect
            fi
        fi
    }

    fn clone_variables self:SelectiveImportTypeStack -> Map[str Type] {
        Map::new(Map[str Type]) = cloned
        for name in self.variables.keys.iter do
            name self.variables.get.unwrap name cloned.set = cloned
        done
        cloned
    }

    fn snapshot self:SelectiveImportTypeStack -> SelectiveImportStackSnapshot {
        self.clone_variables self.next_parameter self.types.clone SelectiveImportStackSnapshot
    }

    fn restore self:SelectiveImportTypeStack snapshot:SelectiveImportStackSnapshot {
        snapshot.types.clone = self.types
        snapshot.next_parameter = self.next_parameter
        Map::new(Map[str Type]) = self.variables
        for name in snapshot.variables.keys.iter do
            name snapshot.variables.get.unwrap name self.variables.set = self.variables
        done
    }

    fn start_branch
        self:SelectiveImportTypeStack
        subject_type:Option[Type]
        kind:SelectiveImportBranchKind
        capture_now:bool
    {
        Option::None(Option[SelectiveImportStackSnapshot]) = before
        if capture_now then
            self.snapshot Option::Some = before
        fi
        subject_type before kind SelectiveImportBranch = branch
        branch self.branches.push
    }

    fn capture_branch_entry self:SelectiveImportTypeStack {
        if 0 self.branches.length == then
            return
        fi
        self.branches.length 1 - self.branches.get = branch
        if branch.before Option::None is then
            self.snapshot Option::Some = branch.before
        fi
    }

    fn restore_branch_entry self:SelectiveImportTypeStack {
        if 0 self.branches.length == then
            return
        fi
        self.branches.length 1 - self.branches.get = branch
        if branch.before Option::Some(before) is then
            before self.restore
        fi
    }

    fn end_loop self:SelectiveImportTypeStack {
        if 0 self.branches.length == then
            return
        fi
        self.branches.pop = branch
        if branch.kind SelectiveImportBranchKind::While is then
            if branch.before Option::Some(before) is then
                before self.restore
            fi
        fi
    }

    fn end_branch self:SelectiveImportTypeStack {
        if 0 self.branches.length != then
            self.branches.pop drop
        fi
    }

    fn get_branch_subject self:SelectiveImportTypeStack -> Option[Type] {
        if 0 self.branches.length != then
            self.branches.length 1 - self.branches.get.subject_type return
        fi
        Option::None(Option[Type])
    }

    fn get_variable_type self:SelectiveImportTypeStack variable_name:str -> Option[Type] {
        variable_name "." str::split = name_parts
        0 name_parts.get self.variables.get
    }

    fn assign_variable_type
        self:SelectiveImportTypeStack
        variable_name:str
        type_result:Option[Type]
    {
        variable_name "." str::split = name_parts
        if 1 name_parts.length != then
            return
        fi
        if type_result Option::Some(type_value) is then
            type_value variable_name self.variables.set = self.variables
        fi
    }
}

impl SelectiveImportDeclaration {
    fn get_name self:SelectiveImportDeclaration -> str {
        self match
            SelectiveImportDeclaration::Function(function) => function.name
            SelectiveImportDeclaration::Constant(constant) => constant.name
            SelectiveImportDeclaration::Struct(casa_struct) => casa_struct.name
            SelectiveImportDeclaration::Enum(casa_enum) => casa_enum.name
            SelectiveImportDeclaration::Trait(casa_trait) => casa_trait.name
        end
    }

    fn find_conflict_kind self:SelectiveImportDeclaration destination:SymbolStore -> Option[str] {
        self match
            SelectiveImportDeclaration::Function(function) => {
                if function.name destination.functions.has then
                    "function" Option::Some
                else
                    Option::None(Option[str])
                fi
            }
            SelectiveImportDeclaration::Constant(constant) => {
                if constant.name destination.constants.has then
                    "constant" Option::Some
                else
                    Option::None(Option[str])
                fi
            }
            SelectiveImportDeclaration::Struct(casa_struct) => {
                if casa_struct.name destination.structs.has then
                    "struct" Option::Some
                else
                    Option::None(Option[str])
                fi
            }
            SelectiveImportDeclaration::Enum(casa_enum) => {
                if casa_enum.name destination.enums.has then
                    "enum" Option::Some
                else
                    Option::None(Option[str])
                fi
            }
            SelectiveImportDeclaration::Trait(casa_trait) => {
                if casa_trait.name destination.traits.has then
                    "trait" Option::Some
                else
                    Option::None(Option[str])
                fi
            }
        end
    }

    fn add_to self:SelectiveImportDeclaration destination:SymbolStore {
        self match
            SelectiveImportDeclaration::Function(function) => {
                function function.name destination.functions.set drop
            }
            SelectiveImportDeclaration::Constant(constant) => {
                constant constant.name destination.constants.set drop
            }
            SelectiveImportDeclaration::Struct(casa_struct) => {
                casa_struct casa_struct.name destination.structs.set drop
            }
            SelectiveImportDeclaration::Enum(casa_enum) => {
                casa_enum casa_enum.name destination.enums.set drop
            }
            SelectiveImportDeclaration::Trait(casa_trait) => {
                casa_trait casa_trait.name destination.traits.set drop
            }
        end
    }
}

struct SelectiveImportClosureBuilder {
    store:            SymbolStore
    location:         Location
    visited:          Set[str]
    invalid_globals:  Set[str]
    declarations:     List[SelectiveImportDeclaration]
    diagnostics:      Diagnostics
    inferred_effects: Map[str StackEffect]
}

impl SelectiveImportClosureBuilder {
    fn new store:SymbolStore location:Location -> SelectiveImportClosureBuilder {
        Map::new(Map[str StackEffect])
        Diagnostics::new
        List::new(List[SelectiveImportDeclaration])
        Set::new(Set[str])
        Set::new(Set[str])
        location
        store
        SelectiveImportClosureBuilder
    }

    fn collect_type self:SelectiveImportClosureBuilder type_value:Type {
        type_value match
            Type::Generic(generic) => {
                generic.base = base_name
                if
                base_name self.store.structs.has
                base_name self.store.enums.has ||
                base_name self.store.traits.has ||
                then
                    base_name self.collect_symbol
                fi
                for parameter_type in generic.params.iter do
                    parameter_type self.collect_type
                done
            }
            Type::Function(function_type) => {
                for parameter_type in function_type.parameters.iter do
                    parameter_type self.collect_type
                done
                for return_type in function_type.return_types.iter do
                    return_type self.collect_type
                done
            }
            _ => { }
        end
    }

    fn collect_trait_bound self:SelectiveImportClosureBuilder bound:TraitBound {
        if bound.name self.store.traits.has then
            bound.name self.collect_symbol
        fi
        for argument_type in bound.type_args.iter do
            argument_type self.collect_type
        done
    }

    fn collect_stack_effect self:SelectiveImportClosureBuilder effect:StackEffect {
        for parameter in effect.parameters.iter do
            parameter.typ self.collect_type
        done
        for return_type in effect.return_types.iter do
            return_type self.collect_type
        done
        for type_variable in effect.trait_bounds.keys.iter do
            type_variable effect.trait_bounds.get.unwrap self.collect_trait_bound
        done
    }

    fn record_global_dependency
        self:SelectiveImportClosureBuilder
        function:Function
        variable_name:str
        location:Location
        declared_global:bool
    {
        variable_name "." str::split = name_parts
        0 name_parts.get = root_name
        if root_name function.captures variable_list_contains then
            if root_name function self.is_global_capture ! then
                return
            fi
        fi
        if
        root_name self.store.variables.has
        declared_global
        root_name function.variables variable_list_contains ! || &&
        then
            f"{function.name}\n{root_name}" = dependency_key
            if dependency_key self.invalid_globals.has then
                return
            fi
            dependency_key self.invalid_globals.add = self.invalid_globals
            location
            f"Selective import `{function.name}` depends on global variable `{root_name}`"
            ErrorKind::InvalidVariable
            self.diagnostics.record_error
        fi
    }

    fn is_global_capture
        self:SelectiveImportClosureBuilder
        function:Function
        capture_name:str
    -> bool {
        if capture_name self.store.variables.get Option::Some(global_variable) is then
            for capture in function.captures.iter do
                if capture.name capture_name == then
                    capture (ptr) global_variable (ptr) == return
                fi
            done
        fi
        false
    }

    fn collect_pattern_dependencies self:SelectiveImportClosureBuilder pattern:PatternValue {
        pattern match
            PatternValue::Struct(struct_pattern) => {
                if "" struct_pattern.struct_name != then
                    struct_pattern.struct_name self.collect_symbol
                fi
            }
            PatternValue::EnumVariant(variant) => {
                if "" variant.enum_name != then
                    variant.enum_name self.collect_symbol
                fi
            }
            PatternValue::Literal => { }
        end
    }

    fn get_variable_type
        self:SelectiveImportClosureBuilder
        function:Function
        variable_name:str
    -> Option[Type] {
        variable_name "." str::split = name_parts
        0 name_parts.get = root_name
        for variable in function.variables.iter do
            if variable.name root_name == then
                variable.typ Option::Some return
            fi
        done
        for capture in function.captures.iter do
            if capture.name root_name == then
                capture.typ Option::Some return
            fi
        done
        if root_name self.store.variables.get Option::Some(variable) is then
            variable.typ Option::Some return
        fi
        Option::None(Option[Type])
    }

    fn get_function_effect
        self:SelectiveImportClosureBuilder
        function_name:str
    -> Option[StackEffect] {
        if function_name self.inferred_effects.get Option::Some(inferred_effect) is then
            inferred_effect Option::Some return
        fi
        if function_name self.store.functions.get Option::Some(function) is then
            function.stack_effect Option::Some return
        fi
        Option::None(Option[StackEffect])
    }

    fn find_method_function_name
        self:SelectiveImportClosureBuilder
        receiver:Type
        method_name:str
    -> Option[str] {
        f"{receiver.format}::{method_name}" = function_name
        if function_name self.store.functions.has then
            function_name Option::Some return
        fi
        if receiver.base Option::Some(base_name) is then
            f"{base_name}::{method_name}" = function_name
            if function_name self.store.functions.has then
                function_name Option::Some return
            fi
        fi
        Option::None(Option[str])
    }

    fn find_trait_method
        self:SelectiveImportClosureBuilder
        casa_trait:CasaTrait
        method_name:str
    -> Option[TraitMethod] {
        for method in casa_trait.methods.iter do
            if method.name method_name == then
                method Option::Some return
            fi
        done
        for supertrait in casa_trait.supertraits.iter do
            if supertrait.name self.store.traits.get Option::Some(supertrait_def) is then
                method_name supertrait_def self.find_trait_method = method_result
                if method_result.is_some then
                    method_result return
                fi
            fi
        done
        Option::None(Option[TraitMethod])
    }

    fn type_satisfies_trait
        self:SelectiveImportClosureBuilder
        receiver:Type
        casa_trait:CasaTrait
    -> bool {
        for method in casa_trait.methods.iter do
            if
            0 method.default_ops.length ==
            method.name receiver self.find_method_function_name.is_none &&
            then
                false return
            fi
        done
        for supertrait in casa_trait.supertraits.iter do
            if supertrait.name self.store.traits.get Option::Some(supertrait_def) is then
                if supertrait_def receiver self.type_satisfies_trait ! then
                    false return
                fi
            else
                false return
            fi
        done
        true
    }

    fn collect_trait_implementations
        self:SelectiveImportClosureBuilder
        receiver:Type
        casa_trait:CasaTrait
    {
        for method in casa_trait.methods.iter do
            if 0 method.default_ops.length == then
                if
                method.name receiver self.find_method_function_name
                Option::Some(function_name)
                is
                then
                    function_name self.collect_symbol
                fi
            fi
        done
        for supertrait in casa_trait.supertraits.iter do
            if supertrait.name self.store.traits.get Option::Some(supertrait_def) is then
                supertrait_def receiver self.collect_trait_implementations
            fi
        done
    }

    fn infer_trait_substitutions
        self:SelectiveImportClosureBuilder
        receiver:Type
        casa_trait:CasaTrait
    -> Map[str Type] {
        Map::new(Map[str Type]) = substitutions
        for trait_method in casa_trait.methods.iter do
            if 0 trait_method.default_ops.length == then
                substitutions trait_method receiver
                self.infer_trait_method_substitutions = substitutions
            fi
        done
        substitutions
    }

    fn infer_trait_method_substitutions
        self:SelectiveImportClosureBuilder
        receiver:Type
        trait_method:TraitMethod
        substitutions:Map[str Type]
    -> Map[str Type] {
        trait_method.name receiver self.find_method_function_name = function_name_result
        if function_name_result Option::Some(function_name) is then
            if function_name self.store.functions.get Option::Some(function) is then
                receiver trait_method.stack_effect resolve_trait_stack_effect = expected_effect
                for pair in
                function.stack_effect.return_types.iter
                expected_effect.return_types.iter.zip
                do
                    substitutions pair.second pair.first bind_type_arguments = substitutions
                done
            fi
        fi
        substitutions
    }

    fn make_trait_bound_substitutions
        self:SelectiveImportClosureBuilder
        bound:TraitBound
        casa_trait:CasaTrait
    -> Map[str Type] {
        Map::new(Map[str Type]) = substitutions
        if bound.type_args.length casa_trait.type_params.length == then
            for pair in bound.type_args.iter casa_trait.type_params.iter.zip do
                pair.second pair.first substitutions.set = substitutions
            done
        fi
        substitutions
    }

    fn collect_default_method_dependency
        self:SelectiveImportClosureBuilder
        receiver:Type
        method_name:str
    -> Option[StackEffect] {
        for trait_name in self.store.traits.keys.iter do
            trait_name self.store.traits.get.unwrap = casa_trait
            method_name casa_trait self.find_trait_method = method_result
            if method_result Option::Some(method) is then
                if
                0 method.default_ops.length !=
                casa_trait receiver self.type_satisfies_trait &&
                then
                    trait_name self.collect_symbol
                    casa_trait receiver self.collect_trait_implementations
                    casa_trait receiver self.infer_trait_substitutions = substitutions
                    receiver method.stack_effect resolve_trait_stack_effect = resolved_effect
                    substitutions resolved_effect apply_type_subs_to_stack_effect
                    Option::Some return
                fi
            fi
        done
        Option::None(Option[StackEffect])
    }

    fn collect_bound_method_dependency
        self:SelectiveImportClosureBuilder
        bound:TraitBound
        receiver:Type
        method_name:str
    -> Option[StackEffect] {
        if bound.name self.store.traits.get Option::Some(casa_trait) is then
            if method_name casa_trait self.find_trait_method Option::Some(method) is then
                bound.name self.collect_symbol
                casa_trait bound self.make_trait_bound_substitutions = substitutions
                receiver method.stack_effect resolve_trait_stack_effect = resolved_effect
                substitutions resolved_effect apply_type_subs_to_stack_effect Option::Some return
            fi
        fi
        Option::None(Option[StackEffect])
    }

    fn collect_method_dependency
        self:SelectiveImportClosureBuilder
        function:Function
        receiver_type:Option[Type]
        method_name:str
    -> Option[StackEffect] {
        if receiver_type Option::Some(receiver) is then
            if receiver Type::TypeVar(type_variable) is then
                if type_variable function.stack_effect.trait_bounds.get Option::Some(bound) is then
                    method_name receiver bound self.collect_bound_method_dependency return
                fi
                Option::None(Option[StackEffect]) return
            fi
            if
            method_name receiver self.find_method_function_name
            Option::Some(function_name)
            is
            then
                function_name self.collect_symbol
                function_name self.get_function_effect return
            fi
            method_name receiver self.collect_default_method_dependency return
        fi

        f"::{method_name}" = method_suffix
        Option::None(Option[str]) = candidate
        for function_name in self.store.functions.keys.iter do
            if function_name method_suffix str::ends_with then
                if candidate.is_some then
                    Option::None(Option[StackEffect]) return
                fi
                function_name Option::Some = candidate
            fi
        done
        if candidate Option::Some(function_name) is then
            function_name self.collect_symbol
            function_name self.get_function_effect return
        fi
        Option::None(Option[StackEffect])
    }

    fn collect_operation_dependencies self:SelectiveImportClosureBuilder function:Function op:Op {
        if op.type_hint Option::Some(type_hint) is then
            type_hint self.collect_type
        fi
        if op.deferred_return_hint Option::Some(return_hint) is then
            return_hint self.collect_type
        fi

        op.value = operation
        if operation OpValue::FnCall is operation OpValue::FnPush is || then
            op op_str_value self.collect_symbol
        fi
        if operation OpValue::DeclareGlobal(global_name) is then
            true op.location global_name function self.record_global_dependency
        elif
        operation OpValue::PushVar is
        operation OpValue::PushCapture is ||
        operation OpValue::AssignVar is ||
        operation OpValue::AssignInc is ||
        operation OpValue::AssignDec is ||
        then
            false op.location op op_str_value function self.record_global_dependency
        fi

        operation match
            OpValue::StructNew(casa_struct) => { casa_struct.name self.collect_symbol }
            OpValue::StructLiteral(literal) => { literal.struct_name self.collect_symbol }
            OpValue::PushEnumVariant(variant) => { variant.enum_name self.collect_symbol }
            OpValue::IsCheck(variant) => { variant.enum_name self.collect_symbol }
            OpValue::TypeCast(cast_type) => { cast_type self.collect_type }
            OpValue::MatchArm(arm) => {
                arm.pattern_value self.collect_pattern_dependencies
            }
            _ => { }
        end
    }

    fn collect_print_dependency
        self:SelectiveImportClosureBuilder
        function:Function
        receiver_type:Option[Type]
    {
        if receiver_type Option::Some(receiver) is then
            receiver match
                Type::Generic(_) => true
                Type::TypeVar(_) => true
                _ => false
            end = needs_display_method
            if needs_display_method then
                if "Display" self.store.traits.has then
                    "Display" self.collect_symbol
                fi
                "to_str" receiver_type function self.collect_method_dependency drop
            fi
        fi
    }

    fn collect_fstring_dependency
        self:SelectiveImportClosureBuilder
        function:Function
        receiver_type:Option[Type]
    {
        if receiver_type Option::Some(receiver) is then
            if TYPE_STR_T receiver.eq ! then
                if "Display" self.store.traits.has then
                    "Display" self.collect_symbol
                fi
                "to_str" receiver_type function self.collect_method_dependency drop
            fi
        fi
    }

    fn comparison_method_name self:SelectiveImportClosureBuilder operation:OpValue -> str {
        operation match
            OpValue::Eq => "eq"
            OpValue::Ne => "ne"
            OpValue::Lt => "lt"
            OpValue::Le => "le"
            OpValue::Gt => "gt"
            _ => "ge"
        end
    }

    fn comparison_trait_name self:SelectiveImportClosureBuilder operation:OpValue -> str {
        operation match
            OpValue::Eq => "Eq"
            OpValue::Ne => "Eq"
            _ => "Ord"
        end
    }

    fn collect_comparison_method
        self:SelectiveImportClosureBuilder
        function:Function
        receiver_type:Option[Type]
        operation:OpValue
    {
        operation self.comparison_trait_name = trait_name
        if trait_name self.store.traits.has then
            trait_name self.collect_symbol
        fi
        operation self.comparison_method_name
        receiver_type
        function
        self.collect_method_dependency
        drop
    }

    fn collect_comparison_dependency
        self:SelectiveImportClosureBuilder
        function:Function
        receiver_type:Option[Type]
        operation:OpValue
    {
        if receiver_type Option::Some(receiver) is then
            if receiver Type::TypeVar(_) is then
                operation receiver_type function self.collect_comparison_method
                return
            fi
            if receiver Type::Generic(generic) is then
                if generic.base self.store.structs.has then
                    operation receiver_type function self.collect_comparison_method
                fi
            fi
        fi
    }

    fn syscall_argument_count self:SelectiveImportClosureBuilder operation:OpValue -> Option[int] {
        operation match
            OpValue::Syscall0 => 0 Option::Some
            OpValue::Syscall1 => 1 Option::Some
            OpValue::Syscall2 => 2 Option::Some
            OpValue::Syscall3 => 3 Option::Some
            OpValue::Syscall4 => 4 Option::Some
            OpValue::Syscall5 => 5 Option::Some
            OpValue::Syscall6 => 6 Option::Some
            _ => Option::None(Option[int])
        end
    }

    fn construct_struct_type
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        casa_struct:CasaStruct
    -> Type {
        Map::new(Map[str Type]) = bindings
        for member in casa_struct.members.iter do
            if stack.pop Option::Some(actual_type) is then
                bindings actual_type member.typ bind_type_arguments = bindings
            fi
        done
        bindings casa_struct.type_vars casa_struct.name build_resolved_type
    }

    fn construct_struct_literal_type
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        literal:StructLiteral
    -> Type {
        if literal.struct_name self.store.structs.get Option::Some(casa_struct) is then
            Map::new(Map[str Type]) = bindings
            literal.field_order.length 1 - = field_index
            while 0 field_index >= do
                field_index literal.field_order.get = field_name
                stack.pop = actual_type_result
                actual_type_result field_name casa_struct bindings
                self.bind_struct_literal_field = bindings
                field_index 1 - = field_index
            done
            bindings casa_struct.type_vars casa_struct.name build_resolved_type return
        fi
        literal.field_order.length stack.drop_count
        literal.struct_name GenericType::new Type::Generic
    }

    fn bind_struct_literal_field
        self:SelectiveImportClosureBuilder
        bindings:Map[str Type]
        casa_struct:CasaStruct
        field_name:str
        actual_type_result:Option[Type]
    -> Map[str Type] {
        for member in casa_struct.members.iter do
            if field_name member.name == then
                if actual_type_result Option::Some(actual_type) is then
                    bindings actual_type member.typ bind_type_arguments = bindings
                fi
                break
            fi
        done
        bindings
    }

    fn bind_enum_payload
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        expected_types:List[Type]
    -> Map[str Type] {
        Map::new(Map[str Type]) = bindings
        for expected_type in expected_types.iter do
            if stack.pop Option::Some(actual_type) is then
                bindings actual_type expected_type bind_type_arguments = bindings
            fi
        done
        bindings
    }

    fn construct_enum_type
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        variant:EnumVariant
    -> Type {
        if variant.enum_name self.store.enums.get Option::Some(casa_enum) is then
            List::new(List[Type]) = expected_types
            if variant.variant_name casa_enum.variant_types.get Option::Some(variant_types) is then
                variant_types = expected_types
            fi
            expected_types stack self.bind_enum_payload = bindings
            bindings casa_enum.type_vars casa_enum.name build_resolved_type return
        fi
        variant.enum_name GenericType::new Type::Generic
    }

    fn push_variable_type
        self:SelectiveImportClosureBuilder
        function:Function
        stack:SelectiveImportTypeStack
        name:str
    {
        if name stack.get_variable_type Option::Some(variable_type) is then
            variable_type stack.push
            return
        fi
        if name function self.get_variable_type Option::Some(variable_type) is then
            variable_type stack.push
        fi
    }

    fn make_pattern_substitutions
        self:SelectiveImportClosureBuilder
        type_variables:List[str]
        subject_type:Option[Type]
    -> Map[str Type] {
        Map::new(Map[str Type]) = substitutions
        if subject_type Option::Some(subject) is then
            if subject Type::Generic(subject_generic) is then
                for pair in subject_generic.params.iter type_variables.iter.zip do
                    pair.second pair.first substitutions.set = substitutions
                done
            fi
        fi
        substitutions
    }

    fn assign_struct_pattern_field
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        casa_struct:CasaStruct
        substitutions:Map[str Type]
        field_name:str
        bound_name:str
    {
        for member in casa_struct.members.iter do
            if field_name member.name == then
                substitutions member.typ.substitute_t Option::Some
                bound_name
                stack.assign_variable_type
                return
            fi
        done
    }

    fn assign_struct_pattern_bindings
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        subject_type:Option[Type]
        pattern:StructPattern
    {
        if pattern.struct_name self.store.structs.get Option::Some(casa_struct) is then
            subject_type casa_struct.type_vars self.make_pattern_substitutions = substitutions
            for field_name in pattern.bindings.keys.iter do
                if field_name pattern.bindings.get Option::Some(bound_name) is then
                    bound_name field_name substitutions casa_struct stack
                    self.assign_struct_pattern_field
                fi
            done
        fi
    }

    fn assign_enum_pattern_payloads
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        substitutions:Map[str Type]
        payload_types:List[Type]
        binding_names:List[str]
    {
        for pair in binding_names.iter payload_types.iter.zip do
            substitutions pair.first.substitute_t Option::Some
            pair.second
            stack.assign_variable_type
        done
    }

    fn assign_enum_pattern_bindings
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        subject_type:Option[Type]
        variant:EnumVariant
    {
        if variant.enum_name self.store.enums.get Option::Some(casa_enum) is then
            subject_type casa_enum.type_vars self.make_pattern_substitutions = substitutions
            if variant.variant_name casa_enum.variant_types.get Option::Some(payload_types) is then
                variant.bindings payload_types substitutions stack
                self.assign_enum_pattern_payloads
            fi
        fi
    }

    fn assign_pattern_bindings
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        subject_type:Option[Type]
        pattern:PatternValue
    {
        pattern match
            PatternValue::Struct(struct_pattern) => {
                struct_pattern subject_type stack self.assign_struct_pattern_bindings
            }
            PatternValue::EnumVariant(variant) => {
                variant subject_type stack self.assign_enum_pattern_bindings
            }
            PatternValue::Literal => { }
        end
    }

    fn collect_function_bound_implementations
        self:SelectiveImportClosureBuilder
        function:Function
        bindings:Map[str Type]
    {
        for type_variable in function.stack_effect.trait_bounds.keys.iter do
            if type_variable bindings.get Option::Some(receiver) is then
                type_variable function.stack_effect.trait_bounds.get.unwrap = bound
                if bound.name self.store.traits.get Option::Some(casa_trait) is then
                    casa_trait receiver self.collect_trait_implementations
                fi
            fi
        done
    }

    fn apply_function_call
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        function_name:str
    {
        if function_name self.get_function_effect Option::Some(effect) is then
            effect stack.apply_effect_with_bindings = bindings
            if function_name self.store.functions.get Option::Some(function) is then
                bindings function self.collect_function_bound_implementations
            fi
        fi
    }

    fn apply_method_call
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        function:Function
        receiver_type:Option[Type]
        method_name:str
    {
        method_name receiver_type function self.collect_method_dependency = effect_result
        if effect_result Option::Some(effect) is then
            effect stack.apply_effect_with_bindings = bindings
            if receiver_type Option::Some(receiver) is then
                bindings method_name receiver self.collect_method_bound_implementations
            fi
        fi
    }

    fn apply_trait_method_call
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        function:Function
        hidden_name:str
    {
        "__trait_" = hidden_prefix
        hidden_name hidden_prefix.length hidden_name.length hidden_prefix.length - str::substring
        = trait_suffix
        trait_suffix "_" str::find = separator
        if separator 0 >= then
            return
        fi
        trait_suffix 0 separator str::substring = type_variable
        trait_suffix separator 1 + trait_suffix.length separator - 1 - str::substring = method_name
        if type_variable function.stack_effect.trait_bounds.get Option::Some(bound) is then
            method_name type_variable Type::TypeVar bound
            self.collect_bound_method_dependency = effect_result
            if effect_result Option::Some(effect) is then
                effect stack.apply_effect
            fi
        fi
    }

    fn collect_method_bound_implementations
        self:SelectiveImportClosureBuilder
        receiver:Type
        method_name:str
        bindings:Map[str Type]
    {
        if
        method_name receiver self.find_method_function_name
        Option::Some(function_name)
        is
        then
            if function_name self.store.functions.get Option::Some(method_function) is then
                bindings method_function self.collect_function_bound_implementations
            fi
        fi
    }

    fn update_type_stack
        self:SelectiveImportClosureBuilder
        function:Function
        op:Op
        stack:SelectiveImportTypeStack
    {
        op.value = operation
        if
        operation OpValue::Mul is
        operation OpValue::Div is ||
        operation OpValue::Mod is ||
        operation OpValue::BitAnd is ||
        operation OpValue::BitOr is ||
        operation OpValue::BitXor is ||
        then
            TYPE_INT_T 2 stack.apply_result
            return
        fi
        if
        operation OpValue::Add is
        operation OpValue::Sub is ||
        operation OpValue::Shl is ||
        operation OpValue::Shr is ||
        then
            stack.pop drop
            if stack.pop Option::Some(left_type) is then
                left_type stack.push
            fi
            return
        fi
        if
        operation OpValue::And is
        operation OpValue::Or is ||
        then
            TYPE_BOOL_T 2 stack.apply_result
            return
        fi
        if
        operation OpValue::Eq is
        operation OpValue::Ge is ||
        operation OpValue::Gt is ||
        operation OpValue::Le is ||
        operation OpValue::Lt is ||
        operation OpValue::Ne is ||
        then
            operation stack.peek function self.collect_comparison_dependency
            TYPE_BOOL_T 2 stack.apply_result
            return
        fi
        operation self.syscall_argument_count = syscall_argument_count_result
        if syscall_argument_count_result Option::Some(argument_count) is then
            TYPE_INT_T argument_count 1 + stack.apply_result
            return
        fi

        operation match
            OpValue::PushInt(_) => { TYPE_INT_T stack.push }
            OpValue::PushStr(_) => { TYPE_STR_T stack.push }
            OpValue::PushBool(_) => { TYPE_BOOL_T stack.push }
            OpValue::PushChar(_) => { TYPE_CHAR_T stack.push }
            OpValue::PushVar(name) => { name stack function self.push_variable_type }
            OpValue::PushCapture(name) => { name stack function self.push_variable_type }
            OpValue::FnCall(name) => { name stack self.apply_function_call }
            OpValue::FnPush(name) => {
                if name self.get_function_effect Option::Some(effect) is then
                    effect stack_effect_to_function_type stack.push
                fi
            }
            OpValue::FnExec => { stack.apply_function_pointer }
            OpValue::TraitMethodCall(hidden_name) => {
                hidden_name function stack self.apply_trait_method_call
            }
            OpValue::StructNew(casa_struct) => {
                casa_struct stack self.construct_struct_type stack.push
            }
            OpValue::StructLiteral(literal) => {
                literal stack self.construct_struct_literal_type stack.push
            }
            OpValue::PushEnumVariant(variant) => {
                variant stack self.construct_enum_type stack.push
            }
            OpValue::TypeCast(cast_type) => {
                stack.pop drop
                cast_type stack.push
            }
            OpValue::MethodCall(method_name) => {
                method_name stack.peek function stack self.apply_method_call
            }
            OpValue::BitNot => { TYPE_INT_T 1 stack.apply_result }
            OpValue::Not => { TYPE_BOOL_T 1 stack.apply_result }
            OpValue::FstringConcat(count) => { TYPE_STR_T count stack.apply_result }
            OpValue::FstringToStr => {
                stack.peek = receiver_type
                receiver_type function self.collect_fstring_dependency
                if receiver_type Option::Some(receiver) is then
                    if TYPE_STR_T receiver.eq ! then
                        TYPE_STR_T 1 stack.apply_result
                    fi
                fi
            }
            OpValue::Print => {
                stack.peek = receiver_type
                receiver_type function self.collect_print_dependency
                stack.pop drop
            }
            OpValue::PrintBool => { stack.pop drop }
            OpValue::PrintChar => { stack.pop drop }
            OpValue::PrintCstr => { stack.pop drop }
            OpValue::PrintInt => { stack.pop drop }
            OpValue::PrintStr => { stack.pop drop }
            OpValue::Typeof => { TYPE_STR_T 1 stack.apply_result }
            OpValue::Load8 => { TYPE_INT_T 1 stack.apply_result }
            OpValue::Load16 => { TYPE_INT_T 1 stack.apply_result }
            OpValue::Load32 => { TYPE_INT_T 1 stack.apply_result }
            OpValue::Load64 => { TYPE_INT_T 1 stack.apply_result }
            OpValue::Store8 => { 2 stack.drop_count }
            OpValue::Store16 => { 2 stack.drop_count }
            OpValue::Store32 => { 2 stack.drop_count }
            OpValue::Store64 => { 2 stack.drop_count }
            OpValue::HeapAlloc => { TYPE_PTR_T 1 stack.apply_result }
            OpValue::Argc => { TYPE_INT_T stack.push }
            OpValue::Argv => { TYPE_PTR_T stack.push }
            OpValue::Envp => { TYPE_PTR_T stack.push }
            OpValue::IfStart => {
                false
                SelectiveImportBranchKind::If
                Option::None(Option[Type])
                stack.start_branch
            }
            OpValue::IfCondition => {
                stack.pop drop
                stack.capture_branch_entry
            }
            OpValue::IfElif => { stack.restore_branch_entry }
            OpValue::IfElse => { stack.restore_branch_entry }
            OpValue::IfEnd => { stack.end_branch }
            OpValue::WhileStart => {
                true
                SelectiveImportBranchKind::While
                Option::None(Option[Type])
                stack.start_branch
            }
            OpValue::WhileCondition => { stack.pop drop }
            OpValue::WhileEnd => { stack.end_loop }
            OpValue::MatchStart => {
                true
                SelectiveImportBranchKind::Match
                stack.pop
                stack.start_branch
            }
            OpValue::MatchArm(arm) => {
                stack.restore_branch_entry
                arm.pattern_value stack.get_branch_subject stack self.assign_pattern_bindings
                arm.guard_ops function stack self.collect_operations_with_stack
                if 0 arm.guard_ops.length != then
                    stack.pop drop
                fi
            }
            OpValue::MatchEnd => { stack.end_branch }
            OpValue::IsCheck(variant) => {
                variant stack.peek stack self.assign_enum_pattern_bindings
                TYPE_BOOL_T 1 stack.apply_result
            }
            OpValue::Drop => { stack.pop drop }
            OpValue::Dup => {
                if stack.pop Option::Some(type_value) is then
                    type_value stack.push
                    type_value stack.push
                fi
            }
            OpValue::Swap => {
                stack.pop = first
                stack.pop = second
                if first Option::Some(first_type) is then
                    first_type stack.push
                fi
                if second Option::Some(second_type) is then
                    second_type stack.push
                fi
            }
            OpValue::Over => {
                stack.pop = first
                stack.pop = second
                if second Option::Some(second_type) is then
                    second_type stack.push
                fi
                if first Option::Some(first_type) is then
                    first_type stack.push
                fi
                if second Option::Some(second_type) is then
                    second_type stack.push
                fi
            }
            OpValue::Rot => {
                stack.pop = first
                stack.pop = second
                stack.pop = third
                if second Option::Some(second_type) is then
                    second_type stack.push
                fi
                if first Option::Some(first_type) is then
                    first_type stack.push
                fi
                if third Option::Some(third_type) is then
                    third_type stack.push
                fi
            }
            OpValue::AssignVar(name) => { stack.pop name stack.assign_variable_type }
            OpValue::AssignInc(name) => {
                stack.pop drop
                TYPE_INT_T Option::Some name stack.assign_variable_type
            }
            OpValue::AssignDec(name) => {
                stack.pop drop
                TYPE_INT_T Option::Some name stack.assign_variable_type
            }
            OpValue::PushArray(items) => {
                items function stack self.collect_operations_with_stack
                TYPE_UNKNOWN_T stack.peek.unwrap_or = element_type
                items.length stack.drop_count
                List::new(List[Type]) = array_parameters
                element_type array_parameters.push
                array_parameters "array" GenericType Type::Generic stack.push
            }
            OpValue::ExprGroup(items) => { items function stack self.collect_operations_with_stack }
            _ => { }
        end
    }

    fn collect_operations_with_stack
        self:SelectiveImportClosureBuilder
        stack:SelectiveImportTypeStack
        function:Function
        operations:List[Op]
    {
        for op in operations.iter do
            op function self.collect_operation_dependencies
            stack op function self.update_type_stack
        done
    }

    fn collect_operations
        self:SelectiveImportClosureBuilder
        function:Function
        operations:List[Op]
    -> StackEffect {
        function SelectiveImportTypeStack::new = stack
        operations function stack self.collect_operations_with_stack
        stack.types.clone stack.parameters StackEffect::new
    }

    fn collect_function self:SelectiveImportClosureBuilder function:Function {
        function.stack_effect self.collect_stack_effect
        for variable in function.variables.iter do
            variable.typ self.collect_type
        done
        for capture in function.captures.iter do
            capture.typ self.collect_type
        done
        function.ops function self.collect_operations = inferred_effect
        if function.stack_effect.needs_inference then
            inferred_effect function.name self.inferred_effects.set = self.inferred_effects
        fi
        function SelectiveImportDeclaration::Function self.declarations.push
    }

    fn collect_methods self:SelectiveImportClosureBuilder symbol:str {
        f"{symbol}::" = method_prefix
        for function_name in self.store.functions.keys.iter do
            if function_name method_prefix str::starts_with then
                function_name self.collect_symbol
            fi
        done
    }

    fn collect_struct self:SelectiveImportClosureBuilder casa_struct:CasaStruct {
        for member in casa_struct.members.iter do
            member.typ self.collect_type
        done
        casa_struct SelectiveImportDeclaration::Struct self.declarations.push
        casa_struct.name self.collect_methods
    }

    fn collect_enum self:SelectiveImportClosureBuilder casa_enum:CasaEnum {
        for variant_types in casa_enum.variant_types.values.iter do
            for variant_type in variant_types.iter do
                variant_type self.collect_type
            done
        done
        casa_enum SelectiveImportDeclaration::Enum self.declarations.push
        casa_enum.name self.collect_methods
    }

    fn collect_trait self:SelectiveImportClosureBuilder casa_trait:CasaTrait {
        for supertrait in casa_trait.supertraits.iter do
            supertrait self.collect_trait_bound
        done
        for method in casa_trait.methods.iter do
            method.stack_effect self.collect_stack_effect
            f"{casa_trait.name}::{method.name}" = method_name
            method.stack_effect empty_location method.default_ops method_name
            Function::with_stack_effect = default_function
            method.default_ops default_function self.collect_operations drop
        done
        casa_trait SelectiveImportDeclaration::Trait self.declarations.push
    }

    fn collect_symbol self:SelectiveImportClosureBuilder symbol:str {
        if symbol self.visited.has then
            return
        fi
        symbol self.visited.add = self.visited

        if symbol self.store.functions.get Option::Some(function) is then
            function self.collect_function
            return
        fi
        if symbol self.store.constants.get Option::Some(constant) is then
            constant SelectiveImportDeclaration::Constant self.declarations.push
            return
        fi
        if symbol self.store.structs.get Option::Some(casa_struct) is then
            casa_struct self.collect_struct
            return
        fi
        if symbol self.store.enums.get Option::Some(casa_enum) is then
            casa_enum self.collect_enum
            return
        fi
        if symbol self.store.traits.get Option::Some(casa_trait) is then
            casa_trait self.collect_trait
            return
        fi
        if symbol self.store.variables.has then
            self.location
            f"Selective import cannot import global variable `{symbol}`"
            ErrorKind::InvalidVariable
            self.diagnostics.record_error
            return
        fi
        self.location
        f"Symbol `{symbol}` not found in selective import"
        ErrorKind::UndefinedName
        self.diagnostics.record_error
    }

    fn finish
        self:SelectiveImportClosureBuilder
    -> Result[List[SelectiveImportDeclaration] Diagnostics] {
        if self.diagnostics.has_errors then
            self.diagnostics Result::Error
        else
            self.declarations Result::Ok
        fi
    }
}

fn compute_selective_import_closure
    store:SymbolStore
    requested_symbols:List[str]
    location:Location
-> Result[List[SelectiveImportDeclaration] Diagnostics] {
    location store SelectiveImportClosureBuilder::new = builder
    for symbol in requested_symbols.iter do
        symbol builder.collect_symbol
    done
    builder.finish
}

fn merge_selective_import_closure
    source:SymbolStore
    destination:SymbolStore
    requested_symbols:List[str]
    location:Location
-> Result[bool Diagnostics] {
    location requested_symbols source compute_selective_import_closure = closure_result
    if closure_result Result::Error(diagnostics) is then
        diagnostics Result::Error return
    fi
    closure_result.unwrap = declarations

    Diagnostics::new = diagnostics
    for declaration in declarations.iter do
        if destination declaration.find_conflict_kind Option::Some(kind) is then
            declaration.get_name = name
            location
            f"Imported symbol `{name}` conflicts with an existing {kind}"
            ErrorKind::DuplicateName
            diagnostics.record_error
        fi
    done
    if diagnostics.has_errors then
        diagnostics Result::Error return
    fi

    for declaration in declarations.iter do
        destination declaration.add_to
    done
    true Result::Ok
}
