# Selective-import dependency discovery.
import "std"
import "common"
import "error"
import "semantics"

enum SelectiveImportDeclaration {
    Function (Function)
    Constant (Constant)
    Struct (CasaStruct)
    Enum (CasaEnum)
    Trait (CasaTrait)
    TraitImpl (TraitImpl)
}

impl SelectiveImportDeclaration {
    fn get_name self:$SelectiveImportDeclaration -> str {
        self match
            SelectiveImportDeclaration::Function(function) => function.name.clone
            SelectiveImportDeclaration::Constant(constant) => constant.name.clone
            SelectiveImportDeclaration::Struct(casa_struct) => casa_struct.name.clone
            SelectiveImportDeclaration::Enum(casa_enum) => casa_enum.name.clone
            SelectiveImportDeclaration::Trait(casa_trait) => casa_trait.name.clone
            SelectiveImportDeclaration::TraitImpl(trait_impl) => {
                trait_impl trait_impl_key
            }
        end
    }

    fn find_conflict_kind
        self:$SelectiveImportDeclaration
        destination:mut$SymbolStore
    -> Option[str] {
        self match
            SelectiveImportDeclaration::Function(function) => {
                if function.name destination.functions.has then
                    "function" Option::Some
                else
                    Option[str]::None
                fi
            }
            SelectiveImportDeclaration::Constant(constant) => {
                if constant.name destination.constants.has then
                    "constant" Option::Some
                else
                    Option[str]::None
                fi
            }
            SelectiveImportDeclaration::Struct(casa_struct) => {
                if casa_struct.name destination.structs.has then
                    "struct" Option::Some
                else
                    Option[str]::None
                fi
            }
            SelectiveImportDeclaration::Enum(casa_enum) => {
                if casa_enum.name destination.enums.has then
                    "enum" Option::Some
                else
                    Option[str]::None
                fi
            }
            SelectiveImportDeclaration::Trait(casa_trait) => {
                if casa_trait.name destination.traits.has then
                    "trait" Option::Some
                else
                    Option[str]::None
                fi
            }
            SelectiveImportDeclaration::TraitImpl(trait_impl) => {
                trait_impl trait_impl_key = key
                if key destination.trait_impls.get Option::Some(existing) is then
                    if existing.location.file trait_impl.location.file == then
                        Option[str]::None
                    else
                        "trait implementation" Option::Some
                    fi
                else
                    Option[str]::None
                fi
            }
        end
    }

    fn add_to self:SelectiveImportDeclaration destination:mut$SymbolStore {
        self match
            SelectiveImportDeclaration::Function(function) => {
                function.name.clone = name
                function name destination.functions.set drop
            }
            SelectiveImportDeclaration::Constant(constant) => {
                constant.name.clone = name
                constant name destination.constants.set drop
            }
            SelectiveImportDeclaration::Struct(casa_struct) => {
                casa_struct.name.clone = name
                casa_struct name destination.structs.set drop
            }
            SelectiveImportDeclaration::Enum(casa_enum) => {
                casa_enum.name.clone = name
                casa_enum name destination.enums.set drop
            }
            SelectiveImportDeclaration::Trait(casa_trait) => {
                casa_trait.name.clone = name
                casa_trait name destination.traits.set drop
            }
            SelectiveImportDeclaration::TraitImpl(trait_impl) => {
                trait_impl trait_impl_key = key
                trait_impl key destination.trait_impls.set drop
            }
        end
    }
}

struct SelectiveImportClosureBuilder {
    store:            SymbolStore
    location:         Location
    visited:          Set[str]
    invalid_globals:  Set[str]
    declarations:     List[SelectiveImportDeclaration]
    diagnostics:      Diagnostics
    inferred_effects: Map[str StackEffect]
}

impl SelectiveImportClosureBuilder {
    fn new store:SymbolStore location:mut$Location -> SelectiveImportClosureBuilder {
        Map[str StackEffect]::new
        Diagnostics::new
        List[SelectiveImportDeclaration]::new
        Set[str]::new
        Set[str]::new
        location
        store
        SelectiveImportClosureBuilder
    }

    fn collect_type self:mut$SelectiveImportClosureBuilder type_value:$Type {
        type_value match
            Type::Generic(generic) => {
                generic.base = base_name
                if
                    base_name self
                        .store
                        .structs
                        .has
                    base_name self
                        .store
                        .enums
                        .has ||
                    base_name self
                        .store
                        .traits
                        .has ||
                then
                    base_name self.collect_symbol
                fi
                for parameter_type in generic.params.iter do
                    parameter_type self.collect_type
                done
            }
            Type::Function(function_type) => {
                for parameter_type in function_type.parameters.iter do
                    parameter_type self.collect_type
                done
                for return_type in function_type.return_types.iter do
                    return_type self.collect_type
                done
            }
            _ => {
            }
        end
    }

    fn collect_trait_bound self:mut$SelectiveImportClosureBuilder bound:$TraitBound {
        if
            bound.name self
                .store
                .traits
                .has
        then
            bound.name self.collect_symbol
        fi
        for argument_type in bound.type_args.iter do
            argument_type self.collect_type
        done
    }

    fn collect_stack_effect self:mut$SelectiveImportClosureBuilder effect:StackEffect {
        for parameter in effect.parameters.iter do
            parameter.typ self.collect_type
        done
        for return_type in effect.return_types.iter do
            return_type self.collect_type
        done
        for
            type_variable in effect
                .trait_bounds
                .keys
                .iter
        do
            for
                bound in type_variable effect
                    .trait_bounds
                    .get
                    .unwrap
                    .iter
            do
                bound self.collect_trait_bound
            done
        done
    }

    fn record_global_dependency
        self:mut$SelectiveImportClosureBuilder
        function:mut$Function
        variable_name:str
        location:mut$Location
        declared_global:bool
    {
        variable_name "." str::split = name_parts
        0 name_parts.get = root_name
        if root_name function.captures variable_list_contains then
            if root_name function self.is_global_capture ! then
                return
            fi
        fi
        if
            root_name self
                .store
                .variables
                .has
            declared_global
            root_name function.variables variable_list_contains ! || &&
        then
            f"{function.name}\n{root_name}" = dependency_key
            if dependency_key self.invalid_globals.has then
                return
            fi
            dependency_key self.invalid_globals.add = self.invalid_globals
            location
            f"Selective import `{function.name}` depends on global variable `{root_name}`"
            ErrorKind::InvalidVariable
            self.diagnostics.record_error
        fi
    }

    fn is_global_capture
        self:mut$SelectiveImportClosureBuilder
        function:mut$Function
        capture_name:mut$str
    -> bool {
        if
            capture_name self
                .store
                .variables
                .get Option::Some(global_variable) is
        then
            for capture in function.captures.iter do
                if capture.name capture_name == then
                    unsafe { capture (ptr) global_variable (ptr) == return }
                fi
            done
        fi
        false
    }

    fn collect_function_semantics
        self:mut$SelectiveImportClosureBuilder
        function:mut$Function
    -> StackEffect {
        self.store self.inferred_effects function analyze_function_semantics
        = semantics
        for fact in semantics.ordered_facts.iter do
            fact match
                SemanticDependency::Symbol(dependency) => {
                    dependency self.collect_symbol
                }
                SemanticDependency::Type(type_dependency) => {
                    type_dependency self.collect_type
                }
                SemanticDependency::Global(reference) => {
                    reference.declared_global
                    reference.location
                    reference.name
                    function
                    self.record_global_dependency
                }
            end
        done
        semantics.inferred_effect
    }

    fn collect_function self:mut$SelectiveImportClosureBuilder function:mut$Function {
        function.stack_effect self.collect_stack_effect
        for variable in function.variables.iter do
            variable.typ self.collect_type
        done
        for capture in function.captures.iter do
            capture.typ self.collect_type
        done
        function self.collect_function_semantics = inferred_effect
        if function.stack_effect.needs_inference then
            inferred_effect function.name self.inferred_effects.set = self.inferred_effects
        fi
        unsafe { function (ptr) (Function) SelectiveImportDeclaration::Function self.declarations.push }
    }

    fn collect_methods self:mut$SelectiveImportClosureBuilder symbol:mut$str {
        f"{symbol}::" = method_prefix
        for
            function_name in self
                .store
                .functions
                .keys
                .iter
        do
            if function_name method_prefix str::starts_with then
                function_name self.collect_symbol
            fi
        done
    }

    fn collect_struct self:mut$SelectiveImportClosureBuilder casa_struct:mut$CasaStruct {
        for member in casa_struct.members.iter do
            member.typ self.collect_type
        done
        unsafe { casa_struct (ptr) (CasaStruct) SelectiveImportDeclaration::Struct self.declarations.push }
        casa_struct.name self.collect_methods
    }

    fn collect_enum self:mut$SelectiveImportClosureBuilder casa_enum:mut$CasaEnum {
        for
            variant_types in casa_enum
                .variant_types
                .values
                .iter
        do
            for variant_type in variant_types.iter do
                variant_type self.collect_type
            done
        done
        unsafe { casa_enum (ptr) (CasaEnum) SelectiveImportDeclaration::Enum self.declarations.push }
        casa_enum.name self.collect_methods
    }

    fn collect_trait self:mut$SelectiveImportClosureBuilder casa_trait:CasaTrait {
        for supertrait in casa_trait.supertraits.iter do
            supertrait self.collect_trait_bound
        done
        for method in casa_trait.methods.iter do
            method.stack_effect self.collect_stack_effect
            f"{casa_trait.name}::{method.name}" = method_name
            method.stack_effect empty_location method.default_ops method_name
            Function::with_stack_effect = default_function
            default_function self.collect_function_semantics drop
        done
        casa_trait SelectiveImportDeclaration::Trait self.declarations.push
    }

    fn collect_symbol self:mut$SelectiveImportClosureBuilder symbol:mut$str {
        if symbol self.visited.has then
            return
        fi
        symbol self.visited.add = self.visited

        if
            symbol self
                .store
                .functions
                .get Option::Some(function) is
        then
            function self.collect_function
            return
        fi
        if
            symbol self
                .store
                .constants
                .get Option::Some(constant) is
        then
            constant SelectiveImportDeclaration::Constant self.declarations.push
            return
        fi
        if
            symbol self
                .store
                .structs
                .get Option::Some(casa_struct) is
        then
            casa_struct self.collect_struct
            return
        fi
        if
            symbol self
                .store
                .enums
                .get Option::Some(casa_enum) is
        then
            casa_enum self.collect_enum
            return
        fi
        if
            symbol self
                .store
                .traits
                .get Option::Some(casa_trait) is
        then
            casa_trait self.collect_trait
            return
        fi
        if
            symbol self
                .store
                .variables
                .has
        then
            self.location
            f"Selective import cannot import global variable `{symbol}`"
            ErrorKind::InvalidVariable
            self.diagnostics.record_error
            return
        fi
        self.location
        f"Symbol `{symbol}` not found in selective import"
        ErrorKind::UndefinedName
        self.diagnostics.record_error
    }

    fn finish
        self:mut$SelectiveImportClosureBuilder
    -> Result[List[SelectiveImportDeclaration] Diagnostics] {
        self
            .store
            .trait_impls
            .values = trait_impls
        0 (u64) = impl_index
        while impl_index trait_impls.length > do
            impl_index trait_impls.get_ref = trait_impl
            1 += impl_index
            if trait_impl.trait_bound.name self.visited.has ! then
                continue
            fi
            trait_impl.receiver.match_base = receiver_name
            receiver_name self.visited.has = needed
            if needed ! then
                for
                    function_name in trait_impl
                        .methods
                        .values
                        .iter
                do
                    if function_name self.visited.has then
                        true = needed
                    fi
                done
            fi
            if needed ! then
                continue
            fi
            for
                function_name in trait_impl
                    .methods
                    .values
                    .iter
            do
                function_name self.collect_symbol
            done
            impl_index 1 - trait_impls.get SelectiveImportDeclaration::TraitImpl self.declarations.push
        done
        if self.diagnostics.has_errors then
            self.diagnostics Result::Error
        else
            self.declarations Result::Ok
        fi
    }
}

fn compute_selective_import_closure
    store:SymbolStore
    requested_symbols:List[str]
    location:mut$Location
-> Result[List[SelectiveImportDeclaration] Diagnostics] {
    location store SelectiveImportClosureBuilder::new = builder
    for symbol in requested_symbols.iter do
        symbol builder.collect_symbol
    done
    builder.finish
}

fn merge_selective_import_closure
    source:SymbolStore
    destination:mut$SymbolStore
    requested_symbols:List[str]
    location:mut$Location
-> Result[bool Diagnostics] {
    location requested_symbols source compute_selective_import_closure = closure_result
    if closure_result Result::Error(diagnostics) is then
        diagnostics Result::Error return
    fi
    closure_result.unwrap = declarations

    Diagnostics::new = diagnostics
    for declaration in declarations.iter do
        if destination declaration.find_conflict_kind Option::Some(kind) is then
            declaration.get_name = name
            location
            f"Imported symbol `{name}` conflicts with an existing {kind}"
            ErrorKind::DuplicateName
            diagnostics.record_error
        fi
    done
    if diagnostics.has_errors then
        diagnostics Result::Error return
    fi

    0 (u64) = declaration_index
    while declaration_index declarations.length > do
        destination declaration_index declarations.get.add_to
        1 += declaration_index
    done
    true Result::Ok
}
