# Selective-import dependency discovery.
import "std" as std
import "common" as common
import "error" as error
import "semantics" as semantics

pub struct SelectiveGlobal {
    pub variable:     common::Variable
    pub file:         std::String
    pub storage_name: std::String
}

pub enum SelectiveImportDeclaration {
    Function (common::Function)
    Global (SelectiveGlobal)
    Constant (common::Constant)
    Struct (common::CasaStruct)
    Enum (common::CasaEnum)
    Trait (common::CasaTrait)
    TraitImpl (common::TraitImpl)
}

pub struct SelectiveImportClosure {
    declarations:         std::List[SelectiveImportDeclaration]
    public_surface_types: std::Set[std::String]
}

impl SelectiveImportClosure {
    pub fn into_declarations self:SelectiveImportClosure -> std::List[SelectiveImportDeclaration] {
        self match
            SelectiveImportClosure { declarations: declarations public_surface_types: public_surface_types } => {
                public_surface_types drop
                declarations
            }
        end
    }
}

impl SelectiveImportDeclaration {
    pub fn get_name self:$SelectiveImportDeclaration -> std::String {
        self match
            SelectiveImportDeclaration::Function(function) => function.name.clone
            SelectiveImportDeclaration::Global(imported_global) => imported_global
                .variable
                .name
                .clone
            SelectiveImportDeclaration::Constant(constant) => constant.name.clone
            SelectiveImportDeclaration::Struct(casa_struct) => casa_struct.name.clone
            SelectiveImportDeclaration::Enum(casa_enum) => casa_enum.name.clone
            SelectiveImportDeclaration::Trait(casa_trait) => casa_trait.name.clone
            SelectiveImportDeclaration::TraitImpl(trait_impl) => {
                trait_impl common::trait_impl_key
            }
        end
    }

    pub fn find_conflict_kind
        self:$SelectiveImportDeclaration
        destination:mut$common::SymbolStore
    -> std::Option[std::String] {
        self match
            SelectiveImportDeclaration::Function(function) => {
                if function.name destination.functions.has then
                    "function".to_str std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            SelectiveImportDeclaration::Global(imported_global) => {
                if imported_global.variable.name destination.variables.has then
                    "global".to_str std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            SelectiveImportDeclaration::Constant(constant) => {
                if constant.name destination.constants.has then
                    "constant".to_str std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            SelectiveImportDeclaration::Struct(casa_struct) => {
                if casa_struct.name destination.structs.has then
                    "struct".to_str std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            SelectiveImportDeclaration::Enum(casa_enum) => {
                if casa_enum.name destination.enums.has then
                    "enum".to_str std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            SelectiveImportDeclaration::Trait(casa_trait) => {
                if casa_trait.name destination.traits.has then
                    "trait".to_str std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            SelectiveImportDeclaration::TraitImpl(trait_impl) => {
                trait_impl common::trait_impl_key = key
                if key destination.trait_impls.get std::Option::Some(existing) is then
                    if existing.location.file trait_impl.location.file == then
                        std::Option[std::String]::None
                    else
                        "trait implementation".to_str std::Option::Some
                    fi
                else
                    std::Option[std::String]::None
                fi
            }
        end
    }

    pub fn add_to self:SelectiveImportDeclaration destination:mut$common::SymbolStore {
        self match
            SelectiveImportDeclaration::Function(function) => {
                function.name.clone = name
                function name destination.functions.set
            }
            SelectiveImportDeclaration::Global(imported_global) => {
                imported_global
                    .variable
                    .name
                    .clone = name
                imported_global.variable.clone name.clone destination.variables.set
                name.clone destination.immutable_globals.add
                imported_global.file.clone name.clone destination.immutable_global_files.set
                imported_global.storage_name.clone name destination.immutable_global_slots.set
            }
            SelectiveImportDeclaration::Constant(constant) => {
                constant.name.clone = name
                constant name destination.constants.set
            }
            SelectiveImportDeclaration::Struct(casa_struct) => {
                casa_struct.name.clone = name
                casa_struct name destination.structs.set
            }
            SelectiveImportDeclaration::Enum(casa_enum) => {
                casa_enum.name.clone = name
                casa_enum name destination.enums.set
            }
            SelectiveImportDeclaration::Trait(casa_trait) => {
                casa_trait.name.clone = name
                casa_trait name destination.traits.set
            }
            SelectiveImportDeclaration::TraitImpl(trait_impl) => {
                trait_impl common::trait_impl_key = key
                trait_impl key destination.trait_impls.set
            }
        end
    }
}

pub struct SelectiveImportClosureBuilder {
    pub store:                common::SymbolStore
    pub location:             common::Location
    pub visited:              std::Set[std::String]
    pub declarations:         std::List[SelectiveImportDeclaration]
    pub diagnostics:          error::Diagnostics
    pub inferred_effects:     std::Map[std::String common::StackEffect]
    pub inherited_symbols:    std::Set[std::String]
    pub inherited_impls:      std::Set[std::String]
    pub public_surface_types: std::Set[std::String]
    pub global_initializers:  std::List[common::Op]
}

impl SelectiveImportClosureBuilder {
    pub fn new
        store:common::SymbolStore
        location:$common::Location
        inherited_symbols:std::Set[std::String]
        inherited_impls:std::Set[std::String]
    -> SelectiveImportClosureBuilder {
        std::List[common::Op]::new
        std::Set[std::String]::new
        inherited_impls
        inherited_symbols
        std::Map[std::String common::StackEffect]::new
        error::Diagnostics::new
        std::List[SelectiveImportDeclaration]::new
        std::Set[std::String]::new
        location.clone
        store
        SelectiveImportClosureBuilder
    }

    pub fn collect_initializer_dependencies
        self:mut$SelectiveImportClosureBuilder
        ops:$std::List[common::Op]
    {
        self.store self.inferred_effects ops semantics::analyze_global_initializer_semantics
        = initializer_semantics
        for fact in initializer_semantics.ordered_facts.iter do
            fact match
                semantics::SemanticDependency::Symbol(dependency) => {
                    dependency.as_str self.collect_symbol
                }
                semantics::SemanticDependency::Call(dependency) => {
                    if
                        dependency.as_str self
                            .store
                            .functions
                            .has_str
                    then
                        dependency.as_str self.collect_symbol
                    fi
                }
                semantics::SemanticDependency::BoundCall(call) => {
                    call.function_name.as_str self.collect_symbol
                    for
                        callables in call
                            .argument_callables
                            .values
                            .iter
                    do
                        for dependency in callables.iter do
                            dependency.as_str self.collect_symbol
                        done
                    done
                }
                semantics::SemanticDependency::DefaultMethodCall(call) => {
                    call self.collect_default_method_dependencies
                }
                semantics::SemanticDependency::Type(type_dependency) => {
                    type_dependency self.collect_type
                }
                semantics::SemanticDependency::Global(reference) => {
                    reference.name.as_str "." str::split = parts
                    0 parts.get = root_name
                    if
                        root_name.as_str self
                            .store
                            .immutable_globals
                            .has_str
                    then
                        root_name.as_str self.collect_symbol
                    fi
                }
            end
        done
    }

    pub fn collect_default_method_dependencies
        self:mut$SelectiveImportClosureBuilder
        call:$semantics::SemanticDefaultMethodCall
    {
        for
            callables in call
                .argument_callables
                .values
                .iter
        do
            for dependency in callables.iter do
                dependency.as_str self.collect_symbol
            done
        done
        f"default:{call.trait_name}:{call.method_name}" = call_key
        if call_key.as_str self.visited.has_str then
            return
        fi
        call_key self.visited.add
        std::List[common::Op]::new = default_ops
        if
            call.trait_name.as_str self
                .store
                .traits
                .get_str std::Option::Some(casa_trait) is
        then
            for method in casa_trait.methods.iter do
                if method.name.as_str call.method_name.as_str == then
                    method.default_ops common::clone_ops = default_ops
                    break
                fi
            done
        fi
        default_ops self.collect_initializer_dependencies
    }

    pub fn collect_global_initializer self:mut$SelectiveImportClosureBuilder symbol:$str {
        std::List[common::Op]::new = initializer_ops
        for op in self.global_initializers.iter do
            if op.value common::OpValue::InitGlobal(initializer) is then
                if initializer.name.as_str symbol == then
                    initializer.ops common::clone_ops = initializer_ops
                    break
                fi
            fi
        done
        initializer_ops self.collect_initializer_dependencies
    }

    pub fn collect_type self:mut$SelectiveImportClosureBuilder type_value:$common::Type {
        type_value match
            common::Type::Generic(generic) => {
                generic.base.as_str = base_name: $str
                if
                    base_name.as_str self
                        .store
                        .structs
                        .has_str
                    base_name.as_str self
                        .store
                        .enums
                        .has_str ||
                    base_name.as_str self
                        .store
                        .traits
                        .has_str ||
                then
                    base_name.as_str self.collect_symbol
                fi
                for parameter_type in generic.params.iter do
                    parameter_type self.collect_type
                done
            }
            common::Type::Function(function_type) => {
                for parameter_type in function_type.parameters.iter do
                    parameter_type self.collect_type
                done
                for return_type in function_type.return_types.iter do
                    return_type self.collect_type
                done
            }
            _ => {
            }
        end
    }

    pub fn collect_trait_bound self:mut$SelectiveImportClosureBuilder bound:$common::TraitBound {
        if
            bound.name self
                .store
                .traits
                .has
        then
            bound.name.as_str self.collect_symbol
        fi
        for argument_type in bound.type_args.iter do
            argument_type self.collect_type
        done
    }

    pub fn collect_stack_effect self:mut$SelectiveImportClosureBuilder effect:$common::StackEffect {
        for parameter in effect.parameters.iter do
            parameter.typ self.collect_type
        done
        for return_type in effect.return_types.iter do
            return_type self.collect_type
        done
        for
            type_variable in effect
                .trait_bounds
                .keys
                .iter
        do
            for
                bound in type_variable effect
                    .trait_bounds
                    .get
                    .unwrap
                    .iter
            do
                bound self.collect_trait_bound
            done
        done
    }

    pub fn collect_public_function_effect
        self:mut$SelectiveImportClosureBuilder
        function:$common::Function
    {
        if function.name.as_str self.inferred_effects.get_str std::Option::Some(inferred) is then
            inferred self.collect_public_stack_effect
        else
            function.stack_effect self.collect_public_stack_effect
        fi
    }

    pub fn collect_public_type_name self:mut$SelectiveImportClosureBuilder name:$str {
        if name self.public_surface_types.has_str then
            return
        fi
        name.clone self.public_surface_types.add_str

        std::List[common::Type]::new = enum_public_types
        if
            name self
                .store
                .enums
                .get_str std::Option::Some(casa_enum) is
        then
            for pair in casa_enum.variant_types.iter do
                for payload_type in pair.second.iter do
                    payload_type common::clone_type enum_public_types.push
                done
            done
        fi
        for payload_type in enum_public_types.iter do
            payload_type self.collect_public_type
        done

        f"{name}::" = member_prefix
        for
            function_name in self
                .store
                .functions
                .keys
                .iter
        do
            if
                function_name self
                    .store
                    .public_symbols
                    .has
                function_name.as_str member_prefix.as_str str::starts_with &&
            then
                if
                    function_name self
                        .store
                        .functions
                        .get std::Option::Some(function) is
                then
                    function self.collect_public_function_effect
                fi
            fi
        done
    }

    pub fn collect_public_type self:mut$SelectiveImportClosureBuilder type_value:$common::Type {
        type_value match
            common::Type::Generic(generic) => {
                for parameter_type in generic.params.iter do
                    parameter_type self.collect_public_type
                done
                if
                    generic.base.as_str self
                        .store
                        .structs
                        .has_str
                    generic.base.as_str self
                        .store
                        .enums
                        .has_str ||
                then
                    generic.base.as_str self.collect_public_type_name
                fi
            }
            common::Type::Function(function_type) => {
                for parameter_type in function_type.parameters.iter do
                    parameter_type self.collect_public_type
                done
                for return_type in function_type.return_types.iter do
                    return_type self.collect_public_type
                done
            }
            _ => {
            }
        end
    }

    pub fn collect_public_stack_effect
        self:mut$SelectiveImportClosureBuilder
        effect:$common::StackEffect
    {
        for parameter in effect.parameters.iter do
            parameter.typ self.collect_public_type
        done
        for return_type in effect.return_types.iter do
            return_type self.collect_public_type
        done
        for
            type_variable in effect
                .trait_bounds
                .keys
                .iter
        do
            for
                bound in type_variable effect
                    .trait_bounds
                    .get
                    .unwrap
                    .iter
            do
                for argument_type in bound.type_args.iter do
                    argument_type self.collect_public_type
                done
            done
        done
    }

    pub fn collect_public_symbol self:mut$SelectiveImportClosureBuilder symbol:$str {
        if
            symbol self
                .store
                .immutable_globals
                .has_str
            symbol self
                .store
                .variables
                .get_str std::Option::Some(variable) is &&
        then
            variable.typ self.collect_public_type
            return
        fi
        if
            symbol self
                .store
                .functions
                .get_str std::Option::Some(function) is
        then
            function self.collect_public_function_effect
            return
        fi
        if
            symbol self
                .store
                .structs
                .has_str symbol self
                .store
                .enums
                .has_str ||
        then
            symbol self.collect_public_type_name
            return
        fi
        std::List[common::StackEffect]::new = public_effects
        std::List[common::Type]::new = public_bound_types
        if
            symbol self
                .store
                .traits
                .get_str std::Option::Some(casa_trait) is
        then
            for method in casa_trait.methods.iter do
                method.stack_effect.clone public_effects.push
            done
            for supertrait in casa_trait.supertraits.iter do
                for argument_type in supertrait.type_args.iter do
                    argument_type common::clone_type public_bound_types.push
                done
            done
        fi
        for effect in public_effects.iter do
            effect self.collect_public_stack_effect
        done
        for argument_type in public_bound_types.iter do
            argument_type self.collect_public_type
        done
    }

    pub fn collect_global_dependency
        self:mut$SelectiveImportClosureBuilder
        function:mut$common::Function
        variable_name:$str
        location:$common::Location
        declared_global:bool
    {
        variable_name "." str::split = name_parts
        0 name_parts.get = root_name
        if root_name.as_str function.captures common::variable_list_contains then
            if root_name.as_str function.global_captures common::string_list_contains ! then
                return
            fi
        fi
        if
            root_name self
                .store
                .variables
                .has
            declared_global
            root_name.as_str function.variables common::variable_list_contains ! || &&
        then
            if
                root_name.as_str self
                    .store
                    .immutable_globals
                    .has_str
            then
                root_name.as_str self.collect_symbol
            else
                location
                f"Selective import `{function.name}` depends on global variable `{root_name}`"
                common::ErrorKind::InvalidVariable
                self.diagnostics.record_error_string
            fi
        fi
        location drop
    }

    pub fn collect_function_semantics
        self:mut$SelectiveImportClosureBuilder
        function:mut$common::Function
    -> common::StackEffect {
        self.store self.inferred_effects function semantics::analyze_function_semantics
        = semantics
        for fact in semantics.ordered_facts.iter do
            fact match
                semantics::SemanticDependency::Symbol(dependency) => {
                    dependency.as_str self.collect_symbol
                }
                semantics::SemanticDependency::Call(dependency) => {
                    if
                        dependency.as_str self
                            .store
                            .functions
                            .has_str
                    then
                        dependency.as_str self.collect_symbol
                    fi
                }
                semantics::SemanticDependency::BoundCall(call) => {
                    call.function_name.as_str self.collect_symbol
                    for
                        callables in call
                            .argument_callables
                            .values
                            .iter
                    do
                        for dependency in callables.iter do
                            dependency.as_str self.collect_symbol
                        done
                    done
                }
                semantics::SemanticDependency::DefaultMethodCall(call) => {
                    call self.collect_default_method_dependencies
                }
                semantics::SemanticDependency::Type(type_dependency) => {
                    type_dependency self.collect_type
                }
                semantics::SemanticDependency::Global(reference) => {
                    reference.declared_global
                    reference.location
                    reference.name.as_str
                    function
                    self.collect_global_dependency
                }
            end
        done
        semantics.inferred_effect.clone
    }

    pub fn collect_function self:mut$SelectiveImportClosureBuilder function:common::Function {
        function.stack_effect self.collect_stack_effect
        for variable in function.variables.iter do
            variable.typ self.collect_type
        done
        for capture in function.captures.iter do
            capture.typ self.collect_type
        done
        function self.collect_function_semantics = inferred_effect
        if function.stack_effect.needs_inference then
            inferred_effect function.name.clone self.inferred_effects.set
        fi
        function SelectiveImportDeclaration::Function self.declarations.push
    }

    pub fn collect_methods self:mut$SelectiveImportClosureBuilder symbol:$str {
        f"{symbol}::" = method_prefix
        for
            function_name in self
                .store
                .functions
                .keys
                .iter
        do
            if function_name.as_str method_prefix.as_str str::starts_with then
                function_name.as_str self.collect_symbol
            fi
        done
    }

    pub fn collect_struct self:mut$SelectiveImportClosureBuilder casa_struct:common::CasaStruct {
        for member in casa_struct.members.iter do
            member.typ self.collect_type
        done
        casa_struct.name.clone = struct_name
        casa_struct SelectiveImportDeclaration::Struct self.declarations.push
        struct_name.as_str self.collect_methods
    }

    pub fn collect_enum self:mut$SelectiveImportClosureBuilder casa_enum:common::CasaEnum {
        for pair in casa_enum.variant_types.iter do
            for variant_type in pair.second.iter do
                variant_type self.collect_type
            done
        done
        casa_enum.name.clone = enum_name
        casa_enum SelectiveImportDeclaration::Enum self.declarations.push
        enum_name.as_str self.collect_methods
    }

    pub fn collect_trait self:mut$SelectiveImportClosureBuilder casa_trait:common::CasaTrait {
        for supertrait in casa_trait.supertraits.iter do
            supertrait self.collect_trait_bound
        done
        for method in casa_trait.methods.iter do
            method.stack_effect self.collect_stack_effect
            f"{casa_trait.name}::{method.name}" = method_name
            method.stack_effect.clone common::empty_location method.default_ops common::clone_ops method_name
            common::Function::with_stack_effect = default_function
            default_function self.collect_function_semantics drop
        done
        casa_trait SelectiveImportDeclaration::Trait self.declarations.push
    }

    pub fn collect_symbol self:mut$SelectiveImportClosureBuilder symbol:$str {
        if symbol self.visited.has_str then
            return
        fi
        symbol.clone self.visited.add_str
        if symbol self.inherited_symbols.has_str then
            return
        fi

        if
            symbol self
                .store
                .functions
                .get_str std::Option::Some(function) is
        then
            function.clone_for_import self.collect_function
            return
        fi
        if
            symbol self
                .store
                .constants
                .get_str std::Option::Some(constant) is
        then
            constant.clone SelectiveImportDeclaration::Constant self.declarations.push
            return
        fi
        if
            symbol self
                .store
                .structs
                .get_str std::Option::Some(casa_struct) is
        then
            casa_struct.clone self.collect_struct
            return
        fi
        if
            symbol self
                .store
                .enums
                .get_str std::Option::Some(casa_enum) is
        then
            casa_enum.clone self.collect_enum
            return
        fi
        if
            symbol self
                .store
                .traits
                .get_str std::Option::Some(casa_trait) is
        then
            casa_trait.clone self.collect_trait
            return
        fi
        if
            symbol self
                .store
                .variables
                .get_str std::Option::Some(variable) is
        then
            if
                symbol self
                    .store
                    .immutable_globals
                    .has_str
            then
                "".to_str = global_file
                "".to_str = storage_name
                if
                    symbol self
                        .store
                        .immutable_global_files
                        .get_str std::Option::Some(file) is
                then
                    file.clone = global_file
                fi
                if
                    symbol self
                        .store
                        .immutable_global_slots
                        .get_str std::Option::Some(slot) is
                then
                    slot.clone = storage_name
                fi
                storage_name global_file variable.clone SelectiveGlobal
                SelectiveImportDeclaration::Global self.declarations.push
                symbol self.collect_global_initializer
            else
                self.location
                f"Selective import cannot import global variable `{symbol}`"
                common::ErrorKind::InvalidVariable
                self.diagnostics.record_error_string
            fi
            return
        fi
        self.location
        f"Symbol `{symbol}` not found in selective import"
        common::ErrorKind::UndefinedName
        self.diagnostics.record_error_string
    }

    pub fn finish
        self:SelectiveImportClosureBuilder
    -> std::Result[SelectiveImportClosure error::Diagnostics] {
        self
            .store
            .trait_impls
            .values = trait_impls
        0 (u64) = impl_index
        while impl_index trait_impls.length > do
            impl_index trait_impls.get_ref = trait_impl
            1 += impl_index
            if trait_impl common::trait_impl_key self.inherited_impls.has then
                continue
            fi
            if trait_impl.trait_bound.name self.visited.has ! then
                continue
            fi
            trait_impl.receiver.match_base = receiver_name
            receiver_name self.visited.has = needed
            if needed ! then
                for
                    function_name in trait_impl
                        .methods
                        .values
                        .iter
                do
                    if function_name self.visited.has then
                        true = needed
                    fi
                done
            fi
            if needed ! then
                continue
            fi
            for
                function_name in trait_impl
                    .methods
                    .values
                    .iter
            do
                function_name.as_str self.collect_symbol
            done
            impl_index 1 - trait_impls.remove.unwrap SelectiveImportDeclaration::TraitImpl self.declarations.push
        done
        self match
            SelectiveImportClosureBuilder { declarations: declarations diagnostics: diagnostics public_surface_types: public_surface_types } => {
                if diagnostics.has_errors then
                    diagnostics std::Result::Error
                else
                    public_surface_types declarations SelectiveImportClosure std::Result::Ok
                fi
            }
        end
    }
}

pub fn compute_selective_import_closure
    store:common::SymbolStore
    requested_symbols:std::List[std::String]
    location:$common::Location
-> std::Result[SelectiveImportClosure error::Diagnostics] {
    std::Set[std::String]::new std::Set[std::String]::new location store SelectiveImportClosureBuilder::new = builder
    for symbol in requested_symbols.iter do
        symbol.as_str builder.collect_symbol
    done
    for symbol in requested_symbols.iter do
        symbol.as_str builder.collect_public_symbol
    done
    builder.finish
}

pub fn compute_selective_import_closure_with_inherited
    store:common::SymbolStore
    requested_symbols:std::List[std::String]
    location:$common::Location
    inherited_symbols:std::Set[std::String]
    inherited_impls:std::Set[std::String]
    global_initializers:std::List[common::Op]
-> std::Result[SelectiveImportClosure error::Diagnostics] {
    inherited_impls inherited_symbols location store SelectiveImportClosureBuilder::new = builder
    global_initializers = builder.global_initializers
    for symbol in requested_symbols.iter do
        symbol.as_str builder.collect_symbol
    done
    for symbol in requested_symbols.iter do
        symbol.as_str builder.collect_public_symbol
    done
    builder.finish
}

pub fn merge_selective_import_result
    closure_result:std::Result[SelectiveImportClosure error::Diagnostics]
    destination:mut$common::SymbolStore
    location:$common::Location
-> std::Result[std::Set[std::String] error::Diagnostics] {
    std::List[SelectiveImportDeclaration]::new = declarations
    std::Set[std::String]::new = public_surface_types
    closure_result match
        std::Result::Ok(value) => {
            value match
                SelectiveImportClosure {
                    declarations: imported_declarations public_surface_types: imported_surface_types
                } => {
                    imported_declarations = declarations
                    imported_surface_types = public_surface_types
                }
            end
        }
        std::Result::Error(error) => error std::Result::Error return
    end

    error::Diagnostics::new = diagnostics
    std::List[SelectiveImportDeclaration]::new = pending
    declarations.reverse
    while declarations.is_empty ! do
        declarations.pop = declaration
        if destination declaration.find_conflict_kind std::Option::Some(kind) is then
            declaration.get_name = name
            location
            f"Imported symbol `{name}` conflicts with an existing {kind}"
            common::ErrorKind::DuplicateName
            diagnostics.record_error_string
        fi
        declaration pending.push
    done
    if diagnostics.has_errors then
        diagnostics std::Result::Error return
    fi

    while pending.is_empty ! do
        destination pending.pop.add_to
    done
    public_surface_types std::Result::Ok
}

pub fn merge_selective_import_closure
    source:common::SymbolStore
    destination:mut$common::SymbolStore
    requested_symbols:std::List[std::String]
    location:$common::Location
-> std::Result[std::Set[std::String] error::Diagnostics] {
    location requested_symbols source compute_selective_import_closure = closure_result
    location destination closure_result merge_selective_import_result
}

pub fn merge_selective_import_closure_with_inherited
    source:common::SymbolStore
    destination:mut$common::SymbolStore
    requested_symbols:std::List[std::String]
    location:$common::Location
    inherited_symbols:std::Set[std::String]
    inherited_impls:std::Set[std::String]
    global_initializers:std::List[common::Op]
-> std::Result[std::Set[std::String] error::Diagnostics] {
    global_initializers inherited_impls inherited_symbols location requested_symbols source
    compute_selective_import_closure_with_inherited = closure_result
    location destination closure_result merge_selective_import_result
}
