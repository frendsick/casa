# Parser for the Casa programming language.
#
# Converts a token list into an op list.
import "std"
import "os"
import "parser"
import "common"
import "error"
import "lexer"
import "semantics"
import "selective_import"

# ============================================================================
# Structural layout spans (formatter facts)
#
# Data-only source-offset ranges over the structures whose layout `casafmt`
# owns. `start` and `close` are the source byte offsets of the opening and
# closing tokens. Recorded only in syntax-only mode (see `analyze_syntax`); no
# spans are produced during normal compilation.
# ============================================================================

enum SyntaxSpanKind {
    Definition
    DelimitedForm
    StructBody
    EnumBody
    ControlForm
    MatchForm
    MatchArm
    AccessorChain
}

struct SyntaxSpan {
    kind:  SyntaxSpanKind
    start: u64
    close: u64
}

impl SyntaxSpan: Clone {
    fn clone self:$SyntaxSpan -> SyntaxSpan { self.close self.start self.kind SyntaxSpan }
}

# ============================================================================
# Parser struct and parse/resolve result
#
# `Parser` owns parse-private state. Later compiler phases receive only the
# dependencies they use, not the parser object itself.
# ============================================================================

struct ParseState {
    diagnostics:       Diagnostics
    output_usable:     List[bool]
    recovery_required: List[bool]
    store_mutated:     List[bool]
    spans:             List[SyntaxSpan]
    if_starts:         List[u64]
    while_starts:      List[u64]
    accessor_start:    Option[u64]
    accessor_close:    u64
}

impl ParseState {
    fn new diagnostics:mut$Diagnostics -> ParseState {
        List[bool]::new = store_mutated
        false store_mutated.push
        List[bool]::new = recovery_required
        false recovery_required.push
        List[bool]::new = output_usable
        true output_usable.push
        List[SyntaxSpan]::new = spans
        List[u64]::new = if_starts
        List[u64]::new = while_starts
        0 (u64)
        Option[u64]::None
        while_starts if_starts spans store_mutated recovery_required output_usable diagnostics ParseState
    }

    fn record_error self:mut$ParseState kind:ErrorKind message:str location:mut$Location {
        location message kind self.diagnostics.record_error
    }

    fn record_error_expected
        self:mut$ParseState
        kind:ErrorKind
        message:str
        location:$Location
        expected:str
        got:str
    {
        got expected location.clone message kind CasaError::with_expected
        self.diagnostics.push_error
    }

    fn mark_output_unusable self:mut$ParseState { false 0 self.output_usable.set }

    fn has_usable_output self:mut$ParseState -> bool { 0 self.output_usable.get }

    fn request_recovery self:mut$ParseState { true 0 self.recovery_required.set }

    fn take_recovery_request self:mut$ParseState -> bool {
        0 self.recovery_required.get = requested
        false 0 self.recovery_required.set
        requested
    }

    fn reset_store_mutation self:mut$ParseState { false 0 self.store_mutated.set }

    fn mark_store_mutated self:mut$ParseState { true 0 self.store_mutated.set }

    fn store_was_mutated self:mut$ParseState -> bool { 0 self.store_mutated.get }

    # Record one structural layout span.
    fn record_span self:mut$ParseState kind:SyntaxSpanKind start:u64 close:u64 {
        close start kind SyntaxSpan self.spans.push
    }

    # Record simple control forms while the parser consumes their keywords.
    fn record_control_op self:mut$ParseState value:$OpValue offset:u64 {
        if value OpValue::IfStart is then
            offset self.if_starts.push
        elif value OpValue::IfEnd is self.if_starts.is_empty ! && then
            self.if_starts.pop = start
            offset start SyntaxSpanKind::ControlForm self.record_span
        elif value OpValue::WhileStart is then
            offset self.while_starts.push
        elif value OpValue::WhileEnd is self.while_starts.is_empty ! && then
            self.while_starts.pop = start
            offset start SyntaxSpanKind::ControlForm self.record_span
        fi
    }

    fn record_accessor self:mut$ParseState start:u64 close:u64 {
        if self.accessor_start.is_none then
            start Option::Some = self.accessor_start
        fi
        close = self.accessor_close
    }

    fn flush_accessor_chain self:mut$ParseState {
        # The formatter owns compact and expanded accessor layout.
        if self.accessor_start Option::Some(start) is then
            self.accessor_close start SyntaxSpanKind::AccessorChain self.record_span
        fi
        Option[u64]::None = self.accessor_start
        0 = self.accessor_close
    }
}

struct Parser {
    store:          SymbolStore
    included_files: Set[str]
    search_paths:   List[str]
    sources:        SourceStore
    state:          ParseState
    syntax_only:    bool
}

struct ParseResolveResult {
    ops:         Option[List[Op]]
    store:       SymbolStore
    diagnostics: Diagnostics
}

# Data-only facts used to prove that formatting preserves source meaning.

struct SyntaxTokenFact {
    spelling: str
    kind:     TokenKind
}

struct SyntaxCommentFact {
    text:                  str
    preceding_token_count: u64
    attached_to_preceding: bool
}

struct SyntaxFacts {
    meaningful_tokens: List[SyntaxTokenFact]
    comments:          List[SyntaxCommentFact]
    spans:             List[SyntaxSpan]
}

struct SyntaxResult {
    tokens:      List[Token]
    facts:       Option[SyntaxFacts]
    diagnostics: Diagnostics
}

impl Parser {
    fn new store:mut$SymbolStore diagnostics:mut$Diagnostics sources:SourceStore -> Parser {
        false
        diagnostics ParseState::new
        sources
        List[str]::new
        Set[str]::new
        store
        Parser
    }

    fn put_function self:mut$Parser name:str function:Function {
        self.state.mark_store_mutated
        function name self
            .store
            .functions
            .set drop
    }

    fn put_constant self:mut$Parser name:mut$str constant:Constant {
        self.state.mark_store_mutated
        constant name self
            .store
            .constants
            .set drop
    }

    fn put_enum self:mut$Parser name:str casa_enum:CasaEnum {
        self.state.mark_store_mutated
        casa_enum name self
            .store
            .enums
            .set drop
    }

    fn put_struct self:mut$Parser name:mut$str casa_struct:CasaStruct {
        self.state.mark_store_mutated
        casa_struct name self
            .store
            .structs
            .set drop
    }

    fn put_trait self:mut$Parser name:str casa_trait:CasaTrait {
        self.state.mark_store_mutated
        casa_trait name self
            .store
            .traits
            .set drop
    }

    fn put_trait_impl self:mut$Parser name:str trait_impl:TraitImpl {
        self.state.mark_store_mutated
        trait_impl name self
            .store
            .trait_impls
            .set drop
        Map[str bool]::new = self.store.copy_types
    }
}

impl[T] Map[str T] {
    fn merge_missing self:mut$Map[str T] source:$Map[str T] {
        for name in source.keys.iter do
            if name self.has ! then
                name source.get.unwrap name.clone self.set drop
            fi
        done
    }
}

impl SymbolStore {
    fn merge_import self:mut$SymbolStore imported:$SymbolStore {
        Map[str bool]::new = self.copy_types
        for
            name in imported
                .functions
                .keys
                .iter
        do
            name imported
                .functions
                .get
                .unwrap = imported_function
            if name self.functions.get Option::Some(existing_function) is then
                if imported_function.is_used then
                    true = existing_function.is_used
                fi
            fi
        done
        imported.functions self.functions.merge_missing
        imported.variables self.variables.merge_missing
        imported.constants self.constants.merge_missing
        imported.enums self.enums.merge_missing
        imported.structs self.structs.merge_missing
        imported.traits self.traits.merge_missing
        imported.trait_impls self.trait_impls.merge_missing
    }

    fn clone self:$SymbolStore -> SymbolStore {
        symbol_store_new = cloned
        self cloned.merge_import
        for
            name in self
                .functions
                .keys
                .iter
        do
            name self
                .functions
                .get
                .unwrap = function
            function.clone_for_import = cloned_function
            cloned_function name.clone cloned.functions.set drop
        done
        cloned
    }
}

# ============================================================================
# Simple keyword -> OpValue lookup (no-payload variants only)
# ============================================================================

fn keyword_to_op_value keyword_kind:$KeywordKind -> Option[OpValue] {
    keyword_kind match
        KeywordKind::Break => OpValue::WhileBreak Option::Some
        KeywordKind::Continue => OpValue::WhileContinue Option::Some
        KeywordKind::Do => OpValue::WhileCondition Option::Some
        KeywordKind::Done => OpValue::WhileEnd Option::Some
        KeywordKind::Elif => OpValue::IfElif Option::Some
        KeywordKind::Else => OpValue::IfElse Option::Some
        KeywordKind::Fi => OpValue::IfEnd Option::Some
        KeywordKind::If => OpValue::IfStart Option::Some
        KeywordKind::Return => OpValue::FnReturn Option::Some
        KeywordKind::Then => OpValue::IfCondition Option::Some
        KeywordKind::While => OpValue::WhileStart Option::Some
        _ => Option[OpValue]::None
    end
}

# ============================================================================
# Operator -> OpValue lookup
# ============================================================================

fn operator_to_op_value operator_kind:OperatorKind -> Option[OpValue] {
    operator_kind match
        OperatorKind::Plus => OpValue::Add Option::Some
        OperatorKind::Minus => OpValue::Sub Option::Some
        OperatorKind::Mul => OpValue::Mul Option::Some
        OperatorKind::Div => OpValue::Div Option::Some
        OperatorKind::Mod => OpValue::Mod Option::Some
        OperatorKind::Shl => OpValue::Shl Option::Some
        OperatorKind::Shr => OpValue::Shr Option::Some
        OperatorKind::BitAnd => OpValue::BitAnd Option::Some
        OperatorKind::BitOr => OpValue::BitOr Option::Some
        OperatorKind::BitXor => OpValue::BitXor Option::Some
        OperatorKind::BitNot => OpValue::BitNot Option::Some
        OperatorKind::And => OpValue::And Option::Some
        OperatorKind::Or => OpValue::Or Option::Some
        OperatorKind::Not => OpValue::Not Option::Some
        OperatorKind::Eq => OpValue::Eq Option::Some
        OperatorKind::Ge => OpValue::Ge Option::Some
        OperatorKind::Gt => OpValue::Gt Option::Some
        OperatorKind::Le => OpValue::Le Option::Some
        OperatorKind::Lt => OpValue::Lt Option::Some
        OperatorKind::Ne => OpValue::Ne Option::Some
        _ => Option[OpValue]::None
    end
}

fn op_value_to_operator_kind op_value:mut$OpValue -> Option[OperatorKind] {
    op_value match
        OpValue::Add => OperatorKind::Plus Option::Some
        OpValue::Sub => OperatorKind::Minus Option::Some
        OpValue::Mul => OperatorKind::Mul Option::Some
        OpValue::Div => OperatorKind::Div Option::Some
        OpValue::Mod => OperatorKind::Mod Option::Some
        OpValue::Shl => OperatorKind::Shl Option::Some
        OpValue::Shr => OperatorKind::Shr Option::Some
        OpValue::BitAnd => OperatorKind::BitAnd Option::Some
        OpValue::BitOr => OperatorKind::BitOr Option::Some
        OpValue::BitXor => OperatorKind::BitXor Option::Some
        OpValue::BitNot => OperatorKind::BitNot Option::Some
        OpValue::And => OperatorKind::And Option::Some
        OpValue::Or => OperatorKind::Or Option::Some
        OpValue::Not => OperatorKind::Not Option::Some
        OpValue::Eq => OperatorKind::Eq Option::Some
        OpValue::Ge => OperatorKind::Ge Option::Some
        OpValue::Gt => OperatorKind::Gt Option::Some
        OpValue::Le => OperatorKind::Le Option::Some
        OpValue::Lt => OperatorKind::Lt Option::Some
        OpValue::Ne => OperatorKind::Ne Option::Some
        _ => Option[OperatorKind]::None
    end
}

# ============================================================================
# Token cursor
# ============================================================================

struct TokenCursor {
    tokens: List[Token]
    pos:    u64
    state:  ParseState
}

impl TokenCursor {
    fn new tokens:List[Token] state:ParseState -> TokenCursor { state 0 tokens TokenCursor }

    fn pop self:mut$TokenCursor -> Option[Token] {
        if self TokenCursor::tokens.length self TokenCursor::pos >= then
            Option::None return
        fi
        self TokenCursor::pos self TokenCursor::tokens.get = token
        self TokenCursor::pos 1 + self TokenCursor::set_pos
        token Option::Some
    }

    fn peek self:mut$TokenCursor -> Option[Token] {
        if self TokenCursor::tokens.length self TokenCursor::pos >= then
            Option::None return
        fi
        self TokenCursor::pos self TokenCursor::tokens.get Option::Some
    }

    fn is_finished self:mut$TokenCursor -> bool {
        self TokenCursor::tokens.length self TokenCursor::pos >=
    }

    fn advance self:mut$TokenCursor { self TokenCursor::pos 1 + self TokenCursor::set_pos }

    fn retreat self:mut$TokenCursor { self TokenCursor::pos 1 - self TokenCursor::set_pos }

    fn save self:mut$TokenCursor -> u64 { self TokenCursor::pos }

    # Source byte offset of the token just consumed (at pos - 1).
    fn previous_offset self:mut$TokenCursor -> u64 {
        self.pos 1 - self.tokens.get Token::location Location::span Span::offset
    }

    fn restore self:mut$TokenCursor saved:u64 { saved self TokenCursor::set_pos }

    fn recover_at_structure self:mut$TokenCursor -> bool {
        if 0 self.pos > then
            self.pos 1 - self.tokens.get = previous
            if previous is_parser_synchronization_token then
                true return
            fi
        fi
        while self.is_finished ! do
            self.peek.unwrap = token
            if token is_parser_synchronization_token then
                if token is_parser_delimiter then
                    self.advance
                fi
                true return
            fi
            self.advance
        done
        false
    }
}

fn is_parser_synchronization_token token:mut$Token -> bool {
    if token is_parser_delimiter then
        true return
    fi
    token.value = value
    "fn" value ==
    "enum" value == ||
    "struct" value == ||
    "trait" value == ||
    "impl" value == ||
    "import" value == ||
    "const" value == ||
}

fn is_parser_delimiter token:mut$Token -> bool {
    token.value = value
    "}" value == "fi" value == || "done" value == || "end" value == ||
}

# ============================================================================
# expect_token - consume next token, error if mismatch
# ============================================================================

fn fallback_token -> Token { empty_location TokenKind::Eof "" Token::new }

fn expect_token cursor:mut$TokenCursor -> Option[Token] {
    cursor.pop = result_opt
    if result_opt.is_none then
        empty_location "Unexpected end of input" ErrorKind::UnexpectedToken cursor.state.record_error
        cursor.state.mark_output_unusable
        cursor.state.request_recovery
        Option::None return
    fi
    result_opt.unwrap = token
    if TokenKind::Eof token Token::kind == then
        token Token::location "Unexpected end of input" ErrorKind::UnexpectedToken cursor.state.record_error
        cursor.state.mark_output_unusable
        cursor.state.request_recovery
        Option::None return
    fi
    token Option::Some
}

fn expect_token_value cursor:mut$TokenCursor expected:str -> Option[Token] {
    cursor expect_token = token_opt
    if token_opt.is_none then
        Option::None return
    fi
    token_opt.unwrap = token
    if expected token Token::value != then
        cursor.retreat
        f"`{token Token::value}`"
        f"`{expected}`"
        token Token::location
        "Unexpected token"
        ErrorKind::UnexpectedToken
        cursor.state.record_error_expected
        cursor.state.request_recovery
        Option::None return
    fi
    token Option::Some
}

fn expect_token_kind cursor:mut$TokenCursor expected_kind:TokenKind -> Option[Token] {
    cursor expect_token = token_opt
    if token_opt.is_none then
        Option::None return
    fi
    token_opt.unwrap = token
    if expected_kind token Token::kind != then
        cursor.retreat
        token Token::location "Unexpected token" ErrorKind::UnexpectedToken cursor.state.record_error
        cursor.state.request_recovery
        Option::None return
    fi
    token Option::Some
}

# ============================================================================
# expect_delimiter - consume expected delimiter or return None
# ============================================================================

fn expect_delimiter cursor:mut$TokenCursor expected_value:str -> bool {
    cursor.peek = peek_opt
    if peek_opt.is_none then
        false return
    fi
    peek_opt.unwrap = token
    if expected_value token Token::value != then
        false return
    fi
    cursor.advance
    true
}

# ============================================================================
# parse_type - parse a type expression
# ============================================================================

fn apply_borrow_type target:Type prefix:str -> Type {
    if "" prefix == then
        target return
    fi
    List[Type]::new = parameters
    target parameters.push
    parameters prefix GenericType Type::Generic
}
# True if a type-position leaf is a constant argument (integer, `true`/`false`,
# or char literal) rather than a type name (ADR-0153).

fn is_type_argument_literal value:$str -> bool {
    if value try_parse_uint_literal.is_some then
        true return
    fi
    if "true" value == "false" value == || then
        true return
    fi
    value char_literal_codepoint.is_some
}

fn parse_type_ast cursor:mut$TokenCursor -> Type {
    cursor.peek = peek_opt
    if peek_opt.is_none then
        empty_location "Expected type" ErrorKind::UnexpectedToken cursor.state.record_error
        Type::Unknown return
    fi
    peek_opt.unwrap = peek

    "" = borrow_prefix
    "" = base
    if "fn" peek Token::value == then
        cursor.pop drop
        "fn" = base
    else
        fallback_token cursor expect_token.unwrap_or = base_token
        if
            TokenKind::Identifier base_token Token::kind !=
            base_token Token::value is_type_argument_literal ! &&
        then
            base_token Token::location "Expected type name" ErrorKind::UnexpectedToken cursor.state.record_error
        fi
        base_token Token::value = base
    fi
    if base "mut$" str::starts_with then
        EXCLUSIVE_BORROW_TYPE = borrow_prefix
        base.length = base_length
        base 4 base_length 4 - str::substring = base
    elif base "$" str::starts_with then
        SHARED_BORROW_TYPE = borrow_prefix
        base.length = base_length
        base 1 base_length 1 - str::substring = base
    fi
    if base "$" str::starts_with base "mut$" str::starts_with || then
        peek.location "Nested borrow qualifiers are not supported" ErrorKind::Syntax
        cursor.state.record_error
        Type::Unknown return
    fi

    # Char constant (ADR-0153): built here rather than in `parse_type_str`,
    # which cannot decode the codepoint.
    if base char_literal_codepoint Option::Some(char_codepoint) is then
        BuiltinType::Char char_codepoint ConstType::concrete Type::Const return
    fi

    cursor.peek = next_opt
    if next_opt.is_none then
        borrow_prefix base parse_type_str apply_borrow_type return
    fi
    if next_opt Option::Some(next) is then
        if "[" next Token::value != then
            borrow_prefix base parse_type_str apply_borrow_type return
        fi
    fi
    cursor.advance # consume [

    if "fn" base == then
        List[Type]::new = fn_params
        List[Type]::new = fn_returns
        false = past_arrow
        while cursor.is_finished ! do
            cursor.peek = inner_opt
            if inner_opt.is_none then
                break
            fi
            inner_opt.unwrap Token::value = ival
            if "]" ival == then
                cursor.pop drop
                break
            fi
            if "->" ival == then
                cursor.pop drop
                true = past_arrow
                continue
            fi
            cursor parse_type_ast = inner_type
            if past_arrow then
                inner_type fn_returns.push
            else
                inner_type fn_params.push
            fi
        done
        borrow_prefix fn_returns fn_params FunctionType Type::Function apply_borrow_type return
    fi

    List[Type]::new = inner_types
    while true do
        cursor.peek = inner_opt
        if inner_opt Option::Some(inner) is then
            if "]" inner Token::value == then
                cursor.pop drop
                break
            fi
        fi
        cursor parse_type_ast inner_types.push
    done
    if 0 inner_types.length == then
        empty_location f"Expected type parameter inside `{base}[...]`" ErrorKind::UnexpectedToken cursor.state.record_error
    fi
    borrow_prefix inner_types base GenericType Type::Generic apply_borrow_type
}

# ============================================================================
# get_op_type_cast - parse (type) cast
# ============================================================================

fn get_op_type_cast cursor:mut$TokenCursor -> Op {
    fallback_token "(" cursor expect_token_value.unwrap_or = open_token
    cursor parse_type_ast = cast_type
    fallback_token ")" cursor expect_token_value.unwrap_or = close_token

    open_token Token::location Location::span Span::offset = open_offset
    close_token Token::location Location::span Span::offset = close_offset
    close_offset open_offset - 1 + = length
    length open_offset open_token Token::location Location::file Location::new = loc

    loc cast_type OpValue::TypeCast Op::new
}

# ============================================================================
# get_op_literal - convert literal token to push op
# ============================================================================

fn char_literal_codepoint value:$str -> Option[i64] {
    if 3 value.length < then
        Option[i64]::None return
    fi
    if '\'' 0 value.at != '\'' value.length 1 - value.at != || then
        Option[i64]::None return
    fi
    value 1 decode_utf8_scalar = decoded_opt
    if decoded_opt Option::Some(decoded) is then
        if decoded.byte_length 2 + value.length == then
            decoded DecodedUtf8Scalar::codepoint i64::from Option::Some return
        fi
    fi
    Option[i64]::None
}

fn get_op_literal token:mut$Token cursor:mut$TokenCursor -> Op {
    token Token::value = value
    if "true" value == then
        token Token::location 1 OpValue::PushBool Op::new return
    fi
    if "false" value == then
        token Token::location 0 OpValue::PushBool Op::new return
    fi
    # Numeric literal (positive or negative)
    if value is_float_literal then
        token Token::location value OpValue::PushFloat Op::new return
    fi
    if 0 value.at.is_digit value is_negative_integer_literal || then
        value.clone str_to_int = int_value
        token Token::location int_value value IntegerLiteral::new OpValue::PushInt Op::new return
    fi
    value char_literal_codepoint = char_opt
    if char_opt Option::Some(char_value) is then
        token Token::location char_value OpValue::PushChar Op::new return
    fi
    # String literal: "..."
    if '"' 0 value.at == '"' value.length 1 - value.at == && then
        value.length = value_length
        value 1 value_length 2 - str::substring = str_value
        token Token::location str_value OpValue::PushStr Op::new return
    fi
    token Token::location f"Token `{value}` is not a literal" ErrorKind::Syntax cursor.state.record_error
    token Token::location 0 make_integer_op_value Op::new
}

# ============================================================================
# get_op_intrinsic - convert intrinsic token to op
# ============================================================================

fn get_op_intrinsic token:mut$Token cursor:mut$TokenCursor -> Op {
    token Token::value intrinsic_from_str = kind_opt
    if kind_opt.is_none then
        token Token::location f"Token `{token Token::value}` is not an intrinsic" ErrorKind::Syntax cursor.state.record_error
    fi
    kind_opt.unwrap = intrinsic_kind
    intrinsic_kind intrinsic_to_op_value = op_value_opt
    if op_value_opt.is_none then
        token Token::location f"No OpValue for intrinsic `{token Token::value}`" ErrorKind::Syntax cursor.state.record_error
    fi
    if op_value_opt Option::Some(op_value) is then
        token Token::location op_value Op::new return
    fi
    token Token::location 0 make_integer_op_value Op::new
}

# ============================================================================
# get_op_operator - convert operator token to op
# ============================================================================

fn parse_assignment_target cursor:mut$TokenCursor -> Location str {
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = root_token
    root_token Token::value = target
    while "." cursor expect_delimiter do
        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or Token::value = field
        f"{target}.{field}" = target
    done
    root_token Token::location
    target
}

fn get_op_operator token:mut$Token cursor:mut$TokenCursor function_name:mut$str -> Op {
    token Token::value operator_from_str = kind_opt
    if kind_opt.is_none then
        token Token::location f"Token `{token Token::value}` is not an operator" ErrorKind::Syntax cursor.state.record_error
    fi
    kind_opt.unwrap = operator_kind

    # Assignment: = varname
    if OperatorKind::Assign operator_kind == then
        cursor parse_assignment_target = var_name = target_location

        # Optional type annotation: = varname : type
        Option[Type]::None = type_hint
        cursor.peek = colon_opt
        if colon_opt Option::Some(colon) is then
            if ":" colon Token::value == then
                cursor.advance
                cursor parse_type_ast Option::Some = type_hint
            fi
        fi
        target_location var_name OpValue::AssignVar Op::new = assign_op
        if type_hint Option::Some(hint) is then
            hint Option::Some = assign_op.type_hint
        fi
        assign_op
        return
    fi

    # Compound assignment: += varname
    if OperatorKind::AssignInc operator_kind == then
        cursor parse_assignment_target = inc_target = inc_location
        inc_location inc_target OpValue::AssignInc Op::new return
    fi

    # Compound assignment: -= varname
    if OperatorKind::AssignDec operator_kind == then
        cursor parse_assignment_target = dec_target = dec_location
        dec_location dec_target OpValue::AssignDec Op::new return
    fi

    # Simple operator -> OpValue lookup
    operator_kind operator_to_op_value = op_value_opt
    if op_value_opt.is_none then
        token Token::location f"No OpValue for operator `{token Token::value}`" ErrorKind::Syntax cursor.state.record_error
    fi
    if op_value_opt Option::Some(op_value) is then
        token Token::location op_value Op::new return
    fi
    token Token::location 0 make_integer_op_value Op::new
}

# ============================================================================
# Forward declarations (functions that call each other)
# ============================================================================
# token_to_op, parse_block_ops, handle_fstring are mutually recursive
# In Casa, we just define them in order and rely on global function lookup.
# ============================================================================
# get_op_array - parse [item1, item2] array literal
# ============================================================================

fn parse_array_struct_literal
    parser:mut$Parser
    function_name:mut$str
    cursor:mut$TokenCursor
    name_token:mut$Token
    items:mut$List[Op]
{
    function_name cursor name_token parser parse_struct_literal = struct_ops
    name_token Token::location struct_ops OpValue::ExprGroup Op::new items.push
}

fn parse_array_lambda
    parser:mut$Parser
    function_name:mut$str
    cursor:mut$TokenCursor
    brace_token:Token
    items:mut$List[Op]
{
    cursor.retreat
    f"lambda__{function_name}_o{brace_token Token::location Location::span Span::offset}" = arr_lam_name
    arr_lam_name cursor parser parse_block_ops = arr_lam_ops
    brace_token Token::location arr_lam_ops arr_lam_name Function::new = arr_lam_fn
    arr_lam_fn arr_lam_name.clone parser.put_function
    brace_token Token::location arr_lam_name OpValue::FnPush Op::new items.push
}

fn get_op_array parser:mut$Parser function_name:mut$str cursor:mut$TokenCursor -> Op {
    fallback_token "[" cursor expect_token_value.unwrap_or = open_token
    List[Op]::new = items
    while true do
        # Close on `]` (also reached after an optional trailing comma).
        cursor.peek = close_peek
        if close_peek Option::Some(cp) is then
            if "]" cp Token::value == then
                cursor.pop drop
                break
            fi
        fi

        # Parse one item.
        false = parsed_nested
        cursor.peek = next_opt
        if next_opt Option::Some(next) is then
            if "[" next Token::value == then
                cursor function_name parser get_op_array items.push
                true = parsed_nested
            fi
        fi
        if parsed_nested ! then
            cursor.pop = value_opt
            if value_opt.is_none then
                open_token Token::location "Unexpected end of input in array literal" ErrorKind::UnexpectedToken parser.state.record_error
                parser.state.mark_output_unusable
                open_token.location items OpValue::PushArray Op::new return
            fi
            value_opt.unwrap = value_token
            if "{" value_token Token::value == then
                items value_token cursor function_name parser parse_array_lambda
            elif TokenKind::Literal value_token Token::kind == then
                cursor value_token get_op_literal items.push
            elif TokenKind::Identifier value_token Token::kind == then
                cursor.peek = struct_peek_opt
                if struct_peek_opt Option::Some(struct_peek) is then
                    if "{" struct_peek Token::value == then
                        items value_token cursor function_name parser parse_array_struct_literal
                    else
                        value_token Token::location value_token Token::value OpValue::Identifier Op::new items.push
                    fi
                else
                    value_token Token::location value_token Token::value OpValue::Identifier Op::new items.push
                fi
            else
                value_token Token::location "Unexpected token in array literal" ErrorKind::UnexpectedToken parser.state.record_error
            fi
        fi

        # Items MUST be comma-separated. A single trailing comma before `]` is
        # allowed for developer experience; the next iteration closes on `]`.
        cursor.peek = sep_peek
        if sep_peek Option::Some(sp) is then
            if "," sp Token::value == then
                cursor.pop drop
            else
                if "]" sp Token::value == ! then
                    sp Token::location "Expected `,` between array items" ErrorKind::UnexpectedToken parser.state.record_error
                    parser.state.mark_output_unusable
                    break
                fi
            fi
        else
            open_token Token::location "Unexpected end of input in array literal" ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
    done
    if parser.syntax_only then
        cursor.previous_offset
        open_token Token::location Location::span Span::offset
        SyntaxSpanKind::DelimitedForm parser.state.record_span
    fi
    open_token Token::location items OpValue::PushArray Op::new
}

# ============================================================================
# parse_block_ops - parse { ... } delimited block
# ============================================================================

fn parse_block_ops parser:mut$Parser cursor:mut$TokenCursor function_name:mut$str -> List[Op] {
    fallback_token "{" cursor expect_token_value.unwrap_or = open_token
    List[Op]::new = ops
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            open_token Token::location "Unclosed block" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            ops return
        fi
        token_opt.unwrap = token
        if TokenKind::Comment token Token::kind == then
            continue
        fi
        if TokenKind::Newline token Token::kind == then
            continue
        fi
        if "}" token Token::value == then
            ops return
        fi
        if TokenKind::FstringStart token Token::kind == then
            ops function_name cursor token parser handle_fstring
            continue
        fi
        ops function_name cursor token parser token_to_op
    done
    ops
}

# ============================================================================
# handle_fstring - parse f-string tokens into ops
# ============================================================================

fn parse_fstring_expr parser:mut$Parser cursor:mut$TokenCursor function_name:mut$str -> List[Op] {
    List[Op]::new = ops
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            break
        fi
        token_opt.unwrap = token
        if TokenKind::FstringExprEnd token Token::kind == then
            break
        fi
        if TokenKind::FstringStart token Token::kind == then
            ops function_name cursor token parser handle_fstring
            continue
        fi
        ops function_name cursor token parser token_to_op
    done
    if parser.syntax_only then
        parser.state.flush_accessor_chain
    fi
    ops
}

fn handle_fstring
    parser:mut$Parser
    start_token:Token
    cursor:mut$TokenCursor
    function_name:mut$str
    ops:mut$List[Op]
{
    if parser.syntax_only then
        parser.state.flush_accessor_chain
    fi
    0 (u64) = part_count
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            break
        fi
        token_opt.unwrap = token
        if TokenKind::FstringText token Token::kind == then
            token Token::location token Token::value OpValue::PushStr Op::new ops.push
            1 += part_count
        elif TokenKind::FstringExprStart token Token::kind == then
            function_name cursor parser parse_fstring_expr = expr_ops
            f"lambda__{function_name}_o{token Token::location Location::span Span::offset}" = lambda_name
            token Token::location expr_ops lambda_name Function::new = lambda_function
            lambda_function lambda_name.clone parser.put_function
            token Token::location lambda_name OpValue::FnPush Op::new ops.push
            token Token::location OpValue::FnExec Op::new ops.push
            token Token::location OpValue::FstringToStr Op::new ops.push
            1 += part_count
        elif TokenKind::FstringEnd token Token::kind == then
            break
        fi
    done
    if 0 part_count == then
        start_token Token::location "" OpValue::PushStr Op::new ops.push
        1 (u64) = part_count
    fi
    if 1 part_count > then
        start_token Token::location part_count OpValue::FstringConcat Op::new ops.push
    fi
}

# ============================================================================
# get_op_delimiter - convert delimiter token to op
# ============================================================================

fn get_op_delimiter
    parser:mut$Parser
    token:mut$Token
    cursor:mut$TokenCursor
    function_name:mut$str
    ops:mut$List[Op]
{
    token Token::value = value

    # Dot . method
    if "." value == then
        cursor expect_function_name = method_token
        if parser.syntax_only then
            method_token Token::location Location::span Span::offset
            token Token::location Location::span Span::offset
            parser.state.record_accessor
        fi
        method_token Token::location method_token Token::value OpValue::MethodCall Op::new ops.push
        return
    fi

    # Open brace { -> lambda
    if "{" value == then
        cursor.retreat
        f"lambda__{function_name}_o{token Token::location Location::span Span::offset}" = lambda_name
        lambda_name cursor parser parse_block_ops = lambda_ops
        token Token::location lambda_ops lambda_name Function::new = lambda_function
        lambda_function lambda_name.clone parser.put_function
        token Token::location lambda_name OpValue::FnPush Op::new ops.push
        return
    fi

    # Open bracket [ -> array literal
    if "[" value == then
        cursor.retreat
        cursor function_name parser get_op_array ops.push
        return
    fi

    # Open paren ( -> type cast
    if "(" value == then
        cursor.retreat
        cursor get_op_type_cast ops.push
        return
    fi

    # Other delimiters (comma, colon, close brace/bracket/paren, fat arrow, hashtag)
    # are ignored or handled by their enclosing constructs
}

# ============================================================================
# _try_parse_is_check - try parsing Enum::Variant is
# ============================================================================

fn try_parse_is_check token:mut$Token cursor:mut$TokenCursor -> Option[Op] {
    cursor.save = saved_pos
    cursor.peek ? = peek_token

    List[str]::new = bindings

    # Check for bindings: Enum::Variant(a b) is
    if "(" peek_token Token::value == then
        cursor.pop drop # consume (
        while true do
            cursor.peek = inner_opt
            if inner_opt.is_none then
                saved_pos cursor.restore
                Option::None return
            fi
            inner_opt.unwrap = inner
            if ")" inner Token::value == then
                cursor.pop drop # consume )
                if 0 bindings.length == then
                    saved_pos cursor.restore
                    Option::None return
                fi
                break
            fi
            if TokenKind::Identifier inner Token::kind != then
                saved_pos cursor.restore
                Option::None return
            fi
            cursor.pop drop
            inner Token::value bindings.push
        done
    fi

    # Check if next token is `is`
    cursor.peek = is_opt
    if is_opt.is_none then
        saved_pos cursor.restore
        Option::None return
    fi
    if is_opt Option::Some(is_token) is then
        if "is" is_token Token::value != then
            saved_pos cursor.restore
            Option::None return
        fi
    fi
    cursor.pop drop # consume `is`

    # Split token value on ::
    token Token::value "::" str::find = separator
    token Token::value 0 separator (u64) str::substring = enum_name
    token Token::value separator 2 + (u64) token Token::value.length separator (u64) - 2 - str::substring = variant_name

    Option::None variant_name enum_name EnumVariant::new = variant
    bindings variant EnumVariant::set_bindings
    token Token::location variant OpValue::IsCheck Op::new Option::Some
}

# ============================================================================
# _require_global_scope
# ============================================================================

fn require_global_scope function_name:mut$str what:str location:mut$Location parser:mut$Parser {
    if GLOBAL_SCOPE_LABEL function_name != then
        location f"{what} should be defined in the global scope" ErrorKind::InvalidScope parser.state.record_error
    fi
}

# ============================================================================
# parse_type_variables - parse [T, K: Hashable] type variable lists
# ============================================================================

struct ParsedTypeVariables {
    names:        List[str]
    trait_bounds: Map[str List[TraitBound]]
    const_params: Map[str BuiltinType]
}

# Parse the `[arg1 arg2 ...]` type argument list that follows a generic trait
# name in a trait bound (e.g. `I: Iterable[i64]`). The caller has already
# consumed the trait identifier. If the next token is not `[`, returns an
# empty list. Otherwise parses each argument as a Type AST value.

fn parse_bound_type_args cursor:mut$TokenCursor trait_token:mut$Token -> List[Type] {
    List[Type]::new = bound_args
    cursor.peek = bracket_opt
    if bracket_opt.is_none then
        bound_args return
    fi
    if bracket_opt Option::Some(bracket) is then
        if "[" bracket Token::value != then
            bound_args return
        fi
    fi
    cursor.pop drop
    while true do
        cursor.peek = argument_token_option
        if argument_token_option.is_none then
            trait_token Token::location "Unclosed trait bound type argument list" ErrorKind::Syntax cursor.state.record_error
            cursor.state.mark_output_unusable
            bound_args return
        fi
        argument_token_option.unwrap Token::value = argument_value
        if "]" argument_value == then
            cursor.pop drop
            bound_args return
        fi
        if "," argument_value == then
            cursor.pop drop
            continue
        fi
        cursor parse_type_ast bound_args.push
    done
    bound_args
}

fn trait_bound_method_effect
    type_variable:$str
    method:$TraitMethod
    bound:$TraitBound
    casa_trait:$CasaTrait
-> StackEffect {
    casa_trait bound make_bound_substitutions = substitutions
    0 (u64) = method_type_index
    for method_type_variable in method.type_vars.iter do
        f"__method_type_{method_type_index}" Type::TypeVar
        method_type_variable.clone substitutions.set = substitutions
        1 += method_type_index
    done
    type_variable.clone Type::TypeVar method.stack_effect resolve_trait_stack_effect = effect
    substitutions effect apply_type_subs_to_stack_effect
}

fn stack_effect_shapes_equal first:$StackEffect second:$StackEffect -> bool {
    if first.parameters.length second.parameters.length != then
        false return
    fi
    if first.return_types.length second.return_types.length != then
        false return
    fi
    for
        pair in second.parameters.iter first
            .parameters
            .iter
            .zip
    do
        if
            pair.second.typ pair
                .first
                .typ
                .eq !
        then
            false return
        fi
    done
    for
        pair in second.return_types.iter first
            .return_types
            .iter
            .zip
    do
        if pair.second pair.first.eq ! then
            false return
        fi
    done
    true
}

fn bound_is_compatible
    parser:mut$Parser
    type_variable:$str
    existing_bounds:$List[TraitBound]
    candidate:$TraitBound
-> bool {
    candidate.name parser
        .store
        .traits
        .get = candidate_trait_opt
    if candidate_trait_opt.is_none then
        false return
    fi
    candidate_trait_opt.unwrap = candidate_trait
    for candidate_method in candidate_trait parser.store collect_trait_methods.iter do
        candidate_trait candidate candidate_method type_variable trait_bound_method_effect
        = candidate_effect
        for existing_bound in existing_bounds.iter do
            existing_bound.name parser
                .store
                .traits
                .get = existing_trait_opt
            if existing_trait_opt.is_none then
                continue
            fi
            existing_trait_opt.unwrap = existing_trait
            for existing_method in existing_trait parser.store collect_trait_methods.iter do
                if existing_method.name candidate_method.name != then
                    continue
                fi
                existing_trait existing_bound existing_method type_variable trait_bound_method_effect
                = existing_effect
                if candidate_effect existing_effect stack_effect_shapes_equal ! then
                    false return
                fi
            done
        done
    done
    true
}

fn parse_type_variables parser:mut$Parser cursor:mut$TokenCursor -> ParsedTypeVariables {
    fallback_token "[" cursor expect_token_value.unwrap_or drop
    List[str]::new = vars
    Set[str]::new = seen
    Map[str List[TraitBound]]::new = trait_bounds
    Map[str BuiltinType]::new = const_params

    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            empty_location "Expected `]` to close type parameters" ErrorKind::Syntax parser.state.record_error
            parser.state.mark_output_unusable
            const_params trait_bounds vars ParsedTypeVariables return
        fi
        token_opt.unwrap = token
        if "]" token Token::value == then
            if 0 vars.length == then
                token Token::location "Empty type parameter list `[]` is not allowed" ErrorKind::Syntax parser.state.record_error
            fi
            const_params trait_bounds vars ParsedTypeVariables return
        fi
        if "," token Token::value == then
            continue
        fi
        # `const NAME:TYPE` binds a compile-time constant, not a type variable
        # (ADR-0152).
        if "const" token Token::value == then
            const_params seen vars parser cursor parse_const_type_parameter = const_params
            continue
        fi
        if TokenKind::Identifier token Token::kind == then
            if
                token Token::value parser
                    .store
                    .builtins
                    .has
            then
                token Token::location f"Type variable `{token Token::value}` shadows built-in type" ErrorKind::DuplicateName parser.state.record_error
            fi
            if token Token::value seen.has then
                token Token::location f"Duplicate type variable `{token Token::value}`" ErrorKind::DuplicateName parser.state.record_error
            fi
            token Token::value vars.push
            token Token::value seen.add = seen
            # Check for trait bounds: K: Hashable + Display
            cursor.peek = colon_opt
            if colon_opt Option::Some(colon) is then
                if ":" colon Token::value == then
                    cursor.pop drop # consume :
                    List[TraitBound]::new = bounds
                    true = parse_bounds
                    while parse_bounds do
                        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = trait_token
                        trait_token Token::value = bound_trait_name
                        bound_trait_name parser
                            .store
                            .traits
                            .get = bound_trait_def_opt
                        if bound_trait_def_opt.is_none parser.syntax_only ! && then
                            trait_token Token::location f"Trait `{bound_trait_name}` is not defined" ErrorKind::UndefinedName parser.state.record_error
                        fi
                        trait_token cursor parse_bound_type_args = bound_args
                        if bound_trait_def_opt Option::Some(bound_trait_def) is then
                            bound_trait_def CasaTrait::type_params = declared_params
                            if bound_args.length declared_params.length != then
                                trait_token Token::location f"Trait `{bound_trait_name}` expects {declared_params.length} type argument(s), got {bound_args.length}" ErrorKind::Syntax parser.state.record_error
                            fi
                            bound_args bound_trait_name TraitBound = parsed_bound
                            false = duplicate_bound
                            for existing_bound in bounds.iter do
                                if parsed_bound existing_bound trait_bound_eq then
                                    true = duplicate_bound
                                fi
                            done
                            if duplicate_bound ! then
                                if parsed_bound bounds token.value parser bound_is_compatible ! then
                                    trait_token.location f"Bounds on `{token.value}` have incompatible requirements for the same method" ErrorKind::TraitSignatureMismatch parser.state.record_error
                                fi
                                parsed_bound bounds.push
                            fi
                        elif parser.syntax_only then
                            bound_args bound_trait_name TraitBound bounds.push
                        fi
                        cursor.peek = plus_opt
                        if plus_opt Option::Some(plus) is then
                            if "+" plus.value == then
                                cursor.pop drop
                            else
                                false = parse_bounds
                            fi
                        else
                            false = parse_bounds
                        fi
                    done
                    bounds token.value trait_bounds.set = trait_bounds
                fi
            fi
        else
            token Token::location "Unexpected token in type parameters" ErrorKind::UnexpectedToken parser.state.record_error
        fi
    done
    const_params trait_bounds vars ParsedTypeVariables
}
# Parse `const NAME:TYPE` (the `const` keyword already consumed). Adds NAME to
# `vars`/`seen` so it keeps its slot among the type parameters, and maps it to
# its declared type (ADR-0152).

fn parse_const_type_parameter
    cursor:mut$TokenCursor
    parser:mut$Parser
    vars:mut$List[str]
    seen:mut$Set[str]
    const_params:Map[str BuiltinType]
-> Map[str BuiltinType] {
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token
    if
        name_token Token::value parser
            .store
            .builtins
            .has
    then
        name_token Token::location f"Constant parameter `{name_token Token::value}` shadows built-in type" ErrorKind::DuplicateName parser.state.record_error
    fi
    if name_token Token::value seen.has then
        name_token Token::location f"Duplicate type variable `{name_token Token::value}`" ErrorKind::DuplicateName parser.state.record_error
    fi
    name_token Token::value vars.push
    name_token Token::value seen.add drop
    fallback_token ":" cursor expect_token_value.unwrap_or drop
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = type_token
    type_token Token::value parse_builtin = builtin_opt
    if builtin_opt Option::Some(const_builtin) is then
        if const_builtin const_type_parameter_type_allowed ! then
            type_token Token::location f"Constant parameter `{name_token Token::value}` cannot have type `{type_token Token::value}`: only integer, `bool`, and `char` constants are allowed" ErrorKind::Syntax parser.state.record_error
        fi
        const_builtin name_token Token::value const_params.set return
    fi
    type_token Token::location f"Constant parameter `{name_token Token::value}` has unknown type `{type_token Token::value}`" ErrorKind::Syntax parser.state.record_error
    const_params
}
# Builtin types allowed as a constant parameter (ADR-0153): integer widths,
# `bool`, `char`. Float and `str` are rejected — neither can select an
# instantiation (ADR-0012 for floats).

fn const_type_parameter_type_allowed builtin:$BuiltinType -> bool {
    if builtin.is_integer then
        true return
    fi
    builtin BuiltinType::Bool == builtin BuiltinType::Char == ||
}
# Rewrite const-parameter names in a type from type variables to symbolic
# constants (ADR-0152). `parse_type_str` reads a one-letter name as `TypeVar`
# and a longer one as a bare `Generic`, so both forms are handled.

fn rewrite_type_const_params typ:$Type const_params:$Map[str BuiltinType] -> Type {
    typ match
        Type::TypeVar(name) => {
            if name const_params.get Option::Some(type_var_builtin) is then
                type_var_builtin name.clone ConstType::symbolic Type::Const
            else
                typ clone_type
            fi
        }
        Type::Generic(generic) => {
            if 0 generic.params.length == then
                if generic.base const_params.get Option::Some(bare_builtin) is then
                    bare_builtin generic.base.clone ConstType::symbolic Type::Const return
                fi
                typ clone_type return
            fi
            List[Type]::new = new_params
            for param in generic.params.iter do
                const_params param rewrite_type_const_params new_params.push
            done
            new_params generic.base.clone GenericType Type::Generic
        }
        Type::Function(fn_type) => {
            List[Type]::new = new_params
            for param in fn_type.parameters.iter do
                const_params param rewrite_type_const_params new_params.push
            done
            List[Type]::new = new_returns
            for ret in fn_type.return_types.iter do
                const_params ret rewrite_type_const_params new_returns.push
            done
            new_returns new_params FunctionType Type::Function
        }
        _ => {
            typ clone_type
        }
    end
}
# Apply `rewrite_type_const_params` to every parameter and return type of a
# stack effect (ADR-0152).

fn rewrite_stack_effect_constant_parameters
    effect:mut$StackEffect
    constant_parameters:$Map[str BuiltinType]
{
    List[Parameter]::new = new_parameters
    for parameter in effect.parameters.iter do
        constant_parameters parameter.typ rewrite_type_const_params = rewritten_type
        parameter.name rewritten_type Parameter new_parameters.push
    done
    List[Type]::new = new_return_types
    for return_type in effect.return_types.iter do
        constant_parameters return_type rewrite_type_const_params new_return_types.push
    done
    new_parameters effect StackEffect::set_parameters
    new_return_types effect StackEffect::set_return_types
}
# Rewrite constant-parameter names in a body's cast and hint types so they read
# as constants rather than unknown type names (ADR-0152).

fn rewrite_operation_constant_parameters
    operations:mut$List[Op]
    constant_parameters:$Map[str BuiltinType]
{
    if 0 constant_parameters.keys.length == then
        return
    fi
    Map[str Type]::new = substitutions
    for constant_name in constant_parameters.keys.iter do
        constant_name constant_parameters.get.unwrap constant_name.clone ConstType::symbolic Type::Const
        constant_name.clone substitutions.set = substitutions
    done
    substitutions operations substitute_ops_types
}
# Prepend a hidden parameter for every constant type parameter and return the
# assignments that bind each one to its source-level name (ADR-0152). A call
# site pushes the concrete constant, so the body reads it like any other
# parameter. The caller appends the assignments after the hidden trait-pointer
# assignments so the pop order matches the parameter order.

fn inject_constant_parameters
    effect:mut$StackEffect
    variables:mut$List[Variable]
    location:Location
-> List[Op] {
    List[Op]::new = assignments
    effect.const_params = constant_parameters
    if 0 constant_parameters.keys.length == then
        assignments return
    fi
    List[Parameter]::new = new_parameters
    for constant_name in constant_parameters.keys.iter do
        constant_name constant_parameters.get.unwrap Type::Builtin = constant_type
        constant_name make_hidden_const_parameter_name constant_type clone_type Parameter::named new_parameters.push
        constant_type clone_type constant_name.clone Variable variables.push
        location.clone constant_name.clone OpValue::AssignVar Op::new = assignment
        constant_type Option::Some assignment Op::set_type_hint
        assignment assignments.push
    done
    0 (u64) = parameter_index
    while parameter_index effect.parameters.length > do
        parameter_index effect.parameters.get new_parameters.push
        1 += parameter_index
    done
    new_parameters effect StackEffect::set_parameters
    assignments
}

# ============================================================================
# parse_parameters - parse name:type parameter pairs
# ============================================================================
# Given an identifier `token` just popped from `cursor`, produce either a
# named parameter (`name:type`) if the next token is `:`, or an unnamed
# parameter by rewinding and re-parsing as a type expression.

fn parse_parameter_maybe_named cursor:mut$TokenCursor token:mut$Token -> Parameter {
    cursor.peek = next_opt
    if { Token::value ":" == } next_opt.filter.is_some then
        cursor.advance # consume :
        cursor parse_type_ast = param_type
        token Token::value param_type Parameter::named return
    fi
    cursor.retreat
    "" cursor parse_type_ast Parameter::named
}

fn parse_parameters cursor:mut$TokenCursor -> List[Parameter] {
    List[Parameter]::new = params
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            empty_location "Unexpected end of input" ErrorKind::UnexpectedToken cursor.state.record_error
            cursor.state.mark_output_unusable
            params return
        fi
        token_opt.unwrap = token

        # Stop at -> or {
        if "->" token Token::value == "{" token Token::value == || then
            cursor.retreat
            params return
        fi

        # Allow fn keyword as unnamed parameter type
        if "fn" token Token::value == then
            cursor.retreat
            "" cursor parse_type_ast Parameter::named params.push
            continue
        fi

        if TokenKind::Identifier token Token::kind != then
            token Token::location "Unexpected token in parameter list" ErrorKind::UnexpectedToken cursor.state.record_error
        fi

        token cursor parse_parameter_maybe_named params.push
    done
    params
}

# ============================================================================
# parse_return_types - parse return types after ->
# ============================================================================

fn parse_return_types cursor:mut$TokenCursor -> List[Type] {
    List[Type]::new = types
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            empty_location "Unexpected end of input" ErrorKind::UnexpectedToken cursor.state.record_error
            cursor.state.mark_output_unusable
            types return
        fi
        if peek_opt Option::Some(peek) is then
            if "{" peek Token::value == then
                types return
            fi
        fi
        cursor parse_type_ast types.push
    done
    types
}

# ============================================================================
# parse_stack_effect - parse function stack effect
# ============================================================================

fn parse_stack_effect cursor:mut$TokenCursor -> StackEffect {
    cursor parse_parameters = params
    List[Type]::new = returns

    cursor.peek = next_opt
    if next_opt.is_none then
        empty_location "Unexpected end of input" ErrorKind::UnexpectedToken cursor.state.record_error
        cursor.state.mark_output_unusable
        returns params StackEffect::new return
    fi
    if next_opt Option::Some(next) is then
        if "->" next Token::value == then
            cursor.advance # consume ->
            cursor parse_return_types = returns
        fi
    fi
    returns params StackEffect::new
}

# ============================================================================
# build_hidden_trait_methods - shared hidden-param construction
# ============================================================================
#
# Walks the given trait bounds and returns a flat list of (var_name, fn_type)
# pairs describing each hidden `__trait_{type_var}_{method}` parameter that
# must be injected. Used by both parse_function and
# inject_implementation_parameters.
# Bounds whose trait is not registered in the store are silently skipped,
# matching the pre-extraction behavior of both call sites.

fn build_hidden_trait_methods
    parser:mut$Parser
    trait_bounds:mut$Map[str List[TraitBound]]
-> List[HiddenTraitMethod] {
    List[HiddenTraitMethod]::new = result
    trait_bounds.keys = bound_keys
    for bound_type_var in bound_keys.iter do
        Set[str]::new = seen_methods
        for
            bound in bound_type_var trait_bounds
                .get
                .unwrap
                .iter
        do
            bound TraitBound::name parser
                .store
                .traits
                .get = bound_trait_opt
            if bound_trait_opt.is_none then
                continue
            fi
            bound_trait_opt.unwrap = bound_trait
            # Build substitution map from trait's declared type_params to the
            # concrete type_args carried on the bound.
            Map[str Type]::new = bound_subs
            bound_trait CasaTrait::type_params = bhtm_params
            bound TraitBound::type_args = bhtm_args
            if bhtm_params.length bhtm_args.length == then
                for pair in bhtm_args.iter bhtm_params.iter.zip do
                    pair.second clone_type pair.first.clone bound_subs.set = bound_subs
                done
            fi
            for bound_method in bound_trait parser.store collect_trait_methods.iter do
                # Skip default methods — only abstract methods need hidden fn ptrs
                if
                    0 bound_method TraitMethod::default_ops.length ==
                    bound_method.name seen_methods.has ! &&
                then
                    bound_method.name seen_methods.add = seen_methods
                    f"__trait_{bound_type_var}_{bound_method TraitMethod::name}" = hidden_name
                    bound_subs bound_type_var.clone Type::TypeVar bound_method TraitMethod::stack_effect resolve_trait_stack_effect apply_type_subs_to_stack_effect = hidden_stack_effect
                    hidden_stack_effect stack_effect_to_function_type = hidden_type
                    hidden_type hidden_name HiddenTraitMethod result.push
                fi
            done
        done
    done
    result
}

# ============================================================================
# parse_literal_to_constant_value - parse a raw literal string to ConstantValue
# ============================================================================

fn parse_literal_to_constant_value raw:str -> ConstantValue {
    if "true" raw == then
        1 ConstantValue::Bool return
    fi
    if "false" raw == then
        0 ConstantValue::Bool return
    fi
    if '"' 0 raw.at == then
        raw.clone 1 raw.length 2 - str::substring ConstantValue::Str return
    fi
    if raw char_literal_codepoint Option::Some(codepoint) is then
        codepoint ConstantValue::Char return
    fi
    if raw is_float_literal then
        raw ConstantValue::Float return
    fi
    raw.clone str_to_int raw IntegerLiteral::new ConstantValue::Int
}

# ============================================================================
# try_fold_const_fn_call - constant-fold a const fn call with all-literal args
# ============================================================================

fn is_const_fold_literal value:mut$OpValue -> bool {
    value OpValue::PushInt is
    value OpValue::PushFloat is ||
    value OpValue::PushStr is ||
    value OpValue::PushBool is ||
    value OpValue::PushChar is ||
}

fn try_fold_const_fn_call
    store:mut$SymbolStore
    ops:mut$List[Op]
    op_index:u64
    fn_name:$str
    current_op:mut$Op
    diagnostics:mut$Diagnostics
-> u64 {
    fn_name store.functions.get = fold_fn_opt
    if fold_fn_opt.is_none then
        op_index return
    fi
    fold_fn_opt.unwrap = fold_fn
    if fold_fn Function::is_const_fn ! then
        op_index return
    fi
    for
        parameter in fold_fn
            .stack_effect
            .parameters
            .iter
    do
        if parameter.typ.has_unresolved_type_var parameter.typ.has_unresolved || then
            op_index return
        fi
    done
    for
        return_type in fold_fn
            .stack_effect
            .return_types
            .iter
    do
        if return_type.has_unresolved_type_var return_type.has_unresolved || then
            op_index return
        fi
    done
    fold_fn Function::stack_effect StackEffect::parameters.length = fold_param_count
    op_index 1 - = call_idx
    call_idx fold_param_count - = first_arg_idx
    if 0 first_arg_idx > then
        op_index return
    fi
    first_arg_idx = check_idx
    while check_idx call_idx > do
        check_idx ops.get Op::value = check_val
        if check_val is_const_fold_literal ! then
            op_index return
        fi
        1 += check_idx
    done
    List[ConstantValue]::new = fold_stack
    List[str]::new = fold_eval_stack
    first_arg_idx = load_idx
    while load_idx call_idx > do
        load_idx ops.get Op::value = load_val
        if load_val OpValue::PushInt(li) is then
            li ConstantValue::Int fold_stack.push
        elif load_val OpValue::PushFloat(float_literal) is then
            float_literal ConstantValue::Float fold_stack.push
        elif load_val OpValue::PushStr(ls) is then
            ls ConstantValue::Str fold_stack.push
        elif load_val OpValue::PushBool(lb) is then
            lb ConstantValue::Bool fold_stack.push
        elif load_val OpValue::PushChar(lc) is then
            lc ConstantValue::Char fold_stack.push
        fi
        1 += load_idx
    done
    if diagnostics fold_eval_stack current_op Op::location fold_stack fn_name store eval_const_fn ! then
        op_index return
    fi
    fold_stack.pop = fold_result
    fold_result match
        ConstantValue::Int(ri) => {
            ri OpValue::PushInt first_arg_idx ops.get Op::set_value
        }
        ConstantValue::Float(float_result) => {
            float_result OpValue::PushFloat first_arg_idx ops.get Op::set_value
        }
        ConstantValue::Str(rs) => {
            rs OpValue::PushStr first_arg_idx ops.get Op::set_value
        }
        ConstantValue::Bool(rb) => {
            rb OpValue::PushBool first_arg_idx ops.get Op::set_value
        }
        ConstantValue::Char(rc) => {
            rc OpValue::PushChar first_arg_idx ops.get Op::set_value
        }
    end
    if
        1 fold_fn
            .stack_effect
            .return_types
            .length ==
    then
        0 fold_fn
            .stack_effect
            .return_types
            .get Option::Some
        first_arg_idx ops.get Op::set_type_hint
    fi
    first_arg_idx 1 + = shift_dst
    call_idx 1 + = shift_src
    while shift_src ops.length > do
        shift_src ops.get shift_dst ops.set
        1 += shift_src
        1 += shift_dst
    done
    0 (u64) = pop_count
    while pop_count fold_param_count > do
        ops.pop drop
        1 += pop_count
    done
    first_arg_idx 1 +
}

# ============================================================================
# validate_const_fn_body - ensure const fn body has no disallowed ops
# ============================================================================

fn validate_const_fn_body function:mut$Function diagnostics:mut$Diagnostics {
    for op in function Function::ops.iter do
        op Op::value = v
        if v OpValue::IfStart is then
            op Op::location "Control flow (`if`) is not allowed in const fn" ErrorKind::Syntax diagnostics.record_error
        fi
        if v OpValue::WhileStart is then
            op Op::location "Control flow (`while`) is not allowed in const fn" ErrorKind::Syntax diagnostics.record_error
        fi
        if v OpValue::DeclareGlobal is then
            op Op::location "Global access is not allowed in const fn" ErrorKind::Syntax diagnostics.record_error
        fi
    done
}

# ============================================================================
# eval_const_block - compile-time evaluation of const { ... } expressions
# ============================================================================

fn validate_constant_numeric
    value:mut$ConstantValue
    target:mut$Type
    location:mut$Location
    diagnostics:mut$Diagnostics
-> bool {
    value match
        ConstantValue::Int(literal) => {
            if target.is_integer_type_t ! then
                location f"Integer literal `{literal.raw}` requires an integer context, got `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error
                false return
            fi
            if target literal.fits ! then
                target.get_integer_min = minimum
                target.get_integer_max = maximum
                location f"Integer literal `{literal.raw}` is outside `{target.format}` range {minimum}..{maximum}" ErrorKind::TypeMismatch diagnostics.record_error
                false return
            fi
        }
        ConstantValue::Float(literal) => {
            if target.is_float_type_t ! then
                location f"Floating-point literal `{literal}` requires `f32` or `f64` context, got `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error
                false return
            fi
        }
        _ => {
        }
    end
    true
}

fn const_eval_apply_operator
    stack:mut$List[ConstantValue]
    operator_kind:OperatorKind
    location:mut$Location
    diagnostics:mut$Diagnostics
{
    if operator_kind OperatorKind::Not == then
        if 0 stack.length == then
            location "Stack underflow in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
        stack.pop = a_val
        if a_val ConstantValue::Bool(a_bool) is then
            if 0 a_bool != then 0 else 1 fi ConstantValue::Bool stack.push
        elif a_val ConstantValue::Int(a_int) is then
            if diagnostics location TYPE_I64_T a_val validate_constant_numeric ! then
                0 IntegerLiteral::from_int ConstantValue::Int stack.push
                return
            fi
            if 0 a_int.value != then 0 else 1 fi ConstantValue::Bool stack.push
        else
            location "Operator `!` requires bool or i64 operand" ErrorKind::Syntax diagnostics.record_error
        fi
        return
    fi
    if operator_kind OperatorKind::BitNot == then
        if 0 stack.length == then
            location "Stack underflow in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
        stack.pop = bitnot_val
        if bitnot_val ConstantValue::Int(bitnot_int) is then
            if diagnostics location TYPE_I64_T bitnot_val validate_constant_numeric ! then
                0 IntegerLiteral::from_int ConstantValue::Int stack.push
                return
            fi
            bitnot_int.value ~ IntegerLiteral::from_int ConstantValue::Int stack.push
        else
            location "Operator `~` requires i64 operand" ErrorKind::Syntax diagnostics.record_error
        fi
        return
    fi
    if 2 stack.length < then
        location "Stack underflow in const expression" ErrorKind::Syntax diagnostics.record_error
    fi
    stack.pop = b_val
    stack.pop = a_val
    if a_val ConstantValue::Int(a_int) is then
        if b_val ConstantValue::Int(b_int) is then
            if
                diagnostics location TYPE_I64_T a_val validate_constant_numeric !
                diagnostics location TYPE_I64_T b_val validate_constant_numeric ! ||
            then
                0 IntegerLiteral::from_int ConstantValue::Int stack.push
                return
            fi
            if operator_kind OperatorKind::Plus == then
                a_int.value b_int.value + IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Minus == then
                a_int.value b_int.value - IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Mul == then
                a_int.value b_int.value * IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Div == then
                a_int.value b_int.value / IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Mod == then
                a_int.value b_int.value % IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Shl == then
                a_int.value b_int.value (u64) << IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Shr == then
                a_int.value b_int.value (u64) >> IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::BitAnd == then
                a_int.value b_int.value & IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::BitOr == then
                a_int.value b_int.value | IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::BitXor == then
                a_int.value b_int.value ^ IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Eq == then
                if a_int.value b_int.value == then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Ne == then
                if a_int.value b_int.value != then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Lt == then
                if a_int.value b_int.value < then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Le == then
                if a_int.value b_int.value <= then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Gt == then
                if a_int.value b_int.value > then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Ge == then
                if a_int.value b_int.value >= then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            location "Unsupported operator for i64 operands in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
    fi
    if a_val ConstantValue::Bool(a_bool) is then
        if b_val ConstantValue::Bool(b_bool) is then
            if operator_kind OperatorKind::And == then
                if 0 a_bool != 0 b_bool != && then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Or == then
                if 0 a_bool != 0 b_bool != || then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Eq == then
                if a_bool b_bool == then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Ne == then
                if a_bool b_bool != then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            location "Unsupported operator for bool operands in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
    fi
    location "Type mismatch in const expression" ErrorKind::Syntax diagnostics.record_error
}

fn eval_const_fn
    store:mut$SymbolStore
    fn_name:mut$str
    stack:mut$List[ConstantValue]
    location:mut$Location
    eval_stack:mut$List[str]
    diagnostics:mut$Diagnostics
-> bool {
    if fn_name eval_stack string_list_contains then
        location f"Cycle detected in const evaluation: `{fn_name}`" ErrorKind::Syntax diagnostics.record_error
        false return
    fi
    fn_name store.functions.get = fn_opt
    if fn_opt.is_none then
        location f"`{fn_name}` is not a const fn" ErrorKind::Syntax diagnostics.record_error
        false return
    fi
    fn_opt.unwrap = function
    if function Function::is_const_fn ! then
        location f"`{fn_name}` is not a const fn" ErrorKind::Syntax diagnostics.record_error
        false return
    fi
    fn_name.clone eval_stack.push
    function Function::stack_effect StackEffect::parameters.length = param_count
    List[ConstantValue]::new = fn_stack
    Map[str ConstantValue]::new = locals
    if param_count stack.length < then
        location f"Not enough arguments for const fn `{fn_name}`" ErrorKind::Syntax diagnostics.record_error
        false return
    fi
    0 (u64) = pi
    while pi param_count > do
        stack.pop = argument
        pi function
            .stack_effect
            .parameters
            .get
            .typ = parameter_type
        if diagnostics location parameter_type argument validate_constant_numeric ! then
            false return
        fi
        argument fn_stack.push
        1 += pi
    done
    function Function::ops = fn_ops
    0 (u64) = oi
    while oi fn_ops.length > do
        oi fn_ops.get = fn_op
        1 += oi
        fn_op Op::value = op_value
        if op_value OpValue::PushInt(push_int) is then
            push_int ConstantValue::Int fn_stack.push
            continue
        fi
        if op_value OpValue::PushFloat(push_float) is then
            push_float ConstantValue::Float fn_stack.push
            continue
        fi
        if op_value OpValue::PushStr(push_str) is then
            push_str ConstantValue::Str fn_stack.push
            continue
        fi
        if op_value OpValue::PushBool(push_bool) is then
            push_bool ConstantValue::Bool fn_stack.push
            continue
        fi
        if op_value OpValue::PushChar(push_char) is then
            push_char ConstantValue::Char fn_stack.push
            continue
        fi
        op_value op_value_to_operator_kind = eval_op_kind_opt
        if eval_op_kind_opt Option::Some(eval_op_kind) is then
            diagnostics fn_op Op::location eval_op_kind fn_stack const_eval_apply_operator
            continue
        fi
        if op_value OpValue::FnReturn is then
            break
        fi
        if op_value OpValue::FnCall(call_name) is then
            if diagnostics eval_stack fn_op Op::location fn_stack call_name store eval_const_fn ! then
                false return
            fi
            continue
        fi
        if op_value OpValue::AssignVar(assign_name) is then
            if 0 fn_stack.length != then
                fn_stack.pop assign_name locals.set = locals
            fi
            continue
        fi
        if op_value OpValue::PushVar(var_name) is then
            var_name locals.get = local_opt
            if local_opt Option::Some(local) is then
                local fn_stack.push
                continue
            fi
            var_name store.constants.get = inner_const_opt
            if inner_const_opt Option::Some(inner_const) is then
                inner_const Constant::value fn_stack.push
                continue
            fi
            fn_op Op::location f"Cannot use variable `{var_name}` in const fn evaluation" ErrorKind::Syntax diagnostics.record_error
            false return
        fi
        if op_value OpValue::Identifier(ident_name) is then
            ident_name locals.get = local_opt
            if local_opt Option::Some(local) is then
                local fn_stack.push
                continue
            fi
            ident_name store.constants.get = inner_const_opt
            if inner_const_opt Option::Some(inner_const) is then
                inner_const Constant::value fn_stack.push
                continue
            fi
            ident_name store.functions.get = inner_fn_opt
            if inner_fn_opt Option::Some(inner_fn) is then
                if inner_fn Function::is_const_fn then
                    if diagnostics eval_stack fn_op Op::location fn_stack ident_name store eval_const_fn ! then
                        false return
                    fi
                    continue
                fi
            fi
            fn_op Op::location f"Cannot use `{ident_name}` in const fn evaluation" ErrorKind::Syntax diagnostics.record_error
            false return
        fi
        fn_op Op::location "Unsupported operation in const fn" ErrorKind::Syntax diagnostics.record_error
        false return
    done
    eval_stack.pop drop
    if 0 fn_stack.length == then
        location f"Const fn `{fn_name}` produced no value" ErrorKind::Syntax diagnostics.record_error
        false return
    fi
    fn_stack.pop stack.push
    true
}

fn eval_const_block
    parser:mut$Parser
    cursor:mut$TokenCursor
    location:mut$Location
-> ConstantValue {
    fallback_token "{" cursor expect_token_value.unwrap_or drop
    List[ConstantValue]::new = stack
    List[str]::new = eval_stack
    while true do
        cursor.pop = tok_opt
        if tok_opt.is_none then
            location "Unclosed const block expression" ErrorKind::Syntax parser.state.record_error
            parser.state.mark_output_unusable
            0 IntegerLiteral::from_int ConstantValue::Int return
        fi
        tok_opt.unwrap = tok
        if "}" tok Token::value == then
            break
        fi
        if TokenKind::Comment tok Token::kind == then
            continue
        fi
        if TokenKind::Newline tok Token::kind == then
            continue
        fi
        if TokenKind::Literal tok Token::kind == then
            tok Token::value parse_literal_to_constant_value stack.push
            continue
        fi
        if TokenKind::Operator tok Token::kind == then
            tok Token::value operator_from_str = op_kind_opt
            if op_kind_opt Option::Some(op_kind) is then
                parser.state.diagnostics tok Token::location op_kind stack const_eval_apply_operator
            fi
            continue
        fi
        if TokenKind::Identifier tok Token::kind == then
            tok Token::value = ident
            ident parser
                .store
                .constants
                .get = c_opt
            if c_opt Option::Some(casa_const) is then
                casa_const Constant::value stack.push
                continue
            fi
            ident parser
                .store
                .functions
                .get = f_opt
            if f_opt Option::Some(function) is then
                if function Function::is_const_fn then
                    if
                        parser.state.diagnostics eval_stack tok Token::location stack ident parser.store eval_const_fn !
                    then
                        0 IntegerLiteral::from_int ConstantValue::Int return
                    fi
                    continue
                fi
            fi
            tok Token::location f"Cannot use `{ident}` in const block expression" ErrorKind::Syntax parser.state.record_error
        fi
        if TokenKind::Keyword tok Token::kind == then
            tok Token::location "Control flow is not allowed in const block expressions" ErrorKind::Syntax parser.state.record_error
        fi
        tok Token::location f"Unexpected token in const block expression: `{tok Token::value}`" ErrorKind::Syntax parser.state.record_error
    done
    if 0 stack.length == then
        location "Const block expression produced no value" ErrorKind::Syntax parser.state.record_error
        0 IntegerLiteral::from_int ConstantValue::Int return
    fi
    stack.pop
}

# ============================================================================
# parse_function - parse function definition
# ============================================================================

fn expect_function_name cursor:mut$TokenCursor -> Token {
    if cursor.peek Option::Some(token) is then
        if "drop" token.value == then
            cursor.pop.unwrap return
        fi
    fi
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or
}

fn parse_function parser:mut$Parser cursor:mut$TokenCursor -> Function {
    fallback_token "fn" cursor expect_token_value.unwrap_or = fn_token
    cursor expect_function_name = name_token

    # Parse optional type parameters
    List[str]::new = type_vars
    Map[str List[TraitBound]]::new = trait_bounds
    Map[str BuiltinType]::new = const_params
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.trait_bounds = trait_bounds
            parsed_type_variables.const_params = const_params
            # `names` mixes type variables and const parameters; keep only the
            # type variables here (ADR-0152).
            parsed_type_variables.names = all_type_param_names
            for candidate_name in all_type_param_names.iter do
                if candidate_name const_params.has ! then
                    candidate_name.clone type_vars.push
                fi
            done
        fi
    fi

    cursor parse_stack_effect = effect

    # Rewrite signature const params to symbolic constants so unification treats
    # them as constants, not type variables (ADR-0152).
    if 0 const_params.keys.length != then
        const_params effect rewrite_stack_effect_constant_parameters
    fi

    # Add type vars to the stack effect
    if 0 type_vars.length != then
        for type_var in type_vars.iter do
            type_var.clone effect StackEffect::type_vars.add = new_type_vars
            new_type_vars effect StackEffect::set_type_vars
        done
        trait_bounds effect StackEffect::set_trait_bounds
        Set[str]::new = canonical_type_vars
        for canonical_type_var in effect StackEffect::type_vars.iter do
            canonical_type_var.clone canonical_type_vars.add = canonical_type_vars
        done
        canonical_type_vars effect canonicalize_stack_effect_type_vars
    fi
    List[Op]::new = ops
    List[Variable]::new = variables

    const_params effect StackEffect::set_const_params

    # Constant parameters become hidden parameters the call site pushes
    # (ADR-0152). Prepend them before the trait pointers so the assignment
    # order below matches the parameter order.
    name_token Token::location variables effect inject_constant_parameters = constant_assignments

    # Inject hidden __trait_* parameters for trait-bounded type vars
    if 0 effect StackEffect::trait_bounds.keys.length != then
        List[Parameter]::new = hidden_params
        effect StackEffect::trait_bounds parser build_hidden_trait_methods = hidden_methods
        for hidden in hidden_methods.iter do
            hidden HiddenTraitMethod::var_name = hidden_name
            hidden HiddenTraitMethod::fn_type = hidden_type
            hidden_name.clone hidden_type clone_type Parameter::named hidden_params.push
            hidden_type clone_type hidden_name.clone Variable variables.push
            name_token Token::location hidden_name.clone OpValue::AssignVar Op::new = hidden_assign
            hidden_type Option::Some hidden_assign Op::set_type_hint
            hidden_assign ops.push
        done
        # Prepend hidden params to stack effect parameters
        0 (u64) = effect_param_index
        while effect_param_index effect StackEffect::parameters.length > do
            effect_param_index effect StackEffect::parameters.get hidden_params.push
            1 += effect_param_index
        done
        hidden_params effect StackEffect::set_parameters
    fi
    constant_assignments ops.append

    # Register named parameters as variables and generate assign ops
    for parameter in effect.parameters.iter do
        if "" parameter.name != then
            if parameter.name is_hidden_parameter_name ! then
                parameter.typ parameter.name Variable variables.push
                name_token.location parameter.name OpValue::AssignVar Op::new ops.push
            fi
        fi
    done

    name_token Token::value cursor parser parse_block_ops = body_ops
    effect.const_params body_ops rewrite_operation_constant_parameters
    body_ops ops.append

    if parser.syntax_only then
        cursor.previous_offset
        fn_token Token::location Location::span Span::offset
        SyntaxSpanKind::Definition parser.state.record_span
    fi

    effect name_token Token::location ops name_token Token::value Function::with_stack_effect = function
    variables function Function::set_variables
    function
}

# ============================================================================
# parse_enum - parse enum definition
# ============================================================================

fn parse_derived_traits cursor:mut$TokenCursor -> List[str] {
    List[str]::new = derived_traits
    if cursor.peek Option::Some(token) is then
        if "derives" token.value != then
            derived_traits return
        fi
        cursor.pop drop
        while true do
            if cursor.peek Option::Some(derived) is then
                if "{" derived.value == then
                    break
                fi
                fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or
                Token::value derived_traits.push
            else
                break
            fi
        done
    fi
    derived_traits
}

fn parse_enum parser:mut$Parser cursor:mut$TokenCursor -> CasaEnum {
    fallback_token "enum" cursor expect_token_value.unwrap_or drop
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    # Parse optional type parameters
    List[str]::new = type_vars
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value == then
            cursor parser parse_type_variables.names = type_vars
        fi
    fi

    cursor parse_derived_traits = derived_traits

    fallback_token "{" cursor expect_token_value.unwrap_or = enum_open_token
    List[str]::new = variants
    Map[str List[Type]]::new = variant_types
    Map[str Location]::new = variant_locations

    while true do
        fallback_token cursor expect_token.unwrap_or = variant_token
        if "}" variant_token Token::value == then
            if parser.syntax_only then
                variant_token Token::location Location::span Span::offset
                enum_open_token Token::location Location::span Span::offset
                SyntaxSpanKind::EnumBody parser.state.record_span
            fi
            break
        fi
        if TokenKind::Identifier variant_token Token::kind != then
            variant_token Token::location "Expected variant name" ErrorKind::UnexpectedToken parser.state.record_error
        fi
        if variant_token Token::value variants string_list_contains then
            variant_token Token::location f"Duplicate variant `{variant_token Token::value}`" ErrorKind::DuplicateName parser.state.record_error
        fi
        variant_token Token::value variants.push
        variant_token Token::location variant_token Token::value variant_locations.set = variant_locations

        # Parse optional inner types: Variant(type1 type2)
        List[Type]::new = inner_types
        cursor.peek = paren_opt
        if paren_opt Option::Some(paren) is then
            if "(" paren Token::value == then
                cursor.pop drop # consume (
                while true do
                    cursor.peek = inner_opt
                    if inner_opt.is_none then
                        variant_token Token::location "Unexpected end of input in variant inner types" ErrorKind::UnexpectedToken parser.state.record_error
                        parser.state.mark_output_unusable
                        break
                    fi
                    if inner_opt Option::Some(inner) is then
                        if ")" inner Token::value == then
                            cursor.pop drop # consume )
                            break
                        fi
                    fi
                    cursor parse_type_ast inner_types.push
                done
                if 0 inner_types.length == then
                    variant_token Token::location "Variant inner types cannot be empty" ErrorKind::Syntax parser.state.record_error
                fi
            fi
        fi
        inner_types variant_token Token::value variant_types.set = variant_types
    done

    if 0 variants.length == then
        name_token Token::location "Enum must have at least one variant" ErrorKind::Syntax parser.state.record_error
    fi

    if 0 type_vars.length != then
        type_vars string_list_to_set = tv_set
        for variant_name in variants.iter do
            variant_name variant_types.get = vt_opt
            if vt_opt.is_some then
                vt_opt.unwrap = vt_inner
                0 (u64) = vt_index
                while vt_index vt_inner.length > do
                    tv_set vt_index vt_inner.get canonicalize_type_var vt_index vt_inner.set
                    1 += vt_index
                done
            fi
        done
    fi

    variant_locations derived_traits type_vars variant_types name_token Token::location variants name_token Token::value CasaEnum
}

# ============================================================================
# Auto-derive Hashable for payload-free enums (#141). Skips enums with inner
# values and any name the user already defined (silent override).
# ============================================================================

fn synthesize_hashable_for_enum parser:mut$Parser casa_enum:mut$CasaEnum {
    if casa_enum has_inner_values then
        return
    fi
    casa_enum CasaEnum::name = enum_name
    casa_enum CasaEnum::location = location

    f"{enum_name}::hash" = hash_name
    if
        hash_name parser
            .store
            .functions
            .get
            .is_none
    then
        List[Op]::new = hash_ops
        location.clone TYPE_I64_T OpValue::TypeCast Op::new hash_ops.push
        List[Parameter]::new = hash_params
        SHARED_BORROW_TYPE enum_name.clone GenericType::new Type::Generic
        apply_borrow_type Parameter::new hash_params.push
        List[Type]::new = hash_returns
        TYPE_I64_T hash_returns.push
        hash_returns hash_params StackEffect::new = hash_stack_effect
        hash_stack_effect location.clone hash_ops hash_name Function::with_stack_effect = hash_fn
        hash_fn hash_name parser.put_function
    fi

    f"{enum_name}::eq" = eq_name
    if
        eq_name parser
            .store
            .functions
            .get
            .is_none
    then
        List[Op]::new = eq_ops
        location.clone OpValue::Eq Op::new eq_ops.push
        List[Parameter]::new = eq_params
        SHARED_BORROW_TYPE enum_name.clone GenericType::new Type::Generic
        apply_borrow_type Parameter::new eq_params.push
        SHARED_BORROW_TYPE enum_name.clone GenericType::new Type::Generic
        apply_borrow_type Parameter::new eq_params.push
        List[Type]::new = eq_returns
        TYPE_BOOL_T eq_returns.push
        eq_returns eq_params StackEffect::new = eq_stack_effect
        eq_stack_effect location.clone eq_ops eq_name Function::with_stack_effect = eq_fn
        eq_fn eq_name parser.put_function
    fi

    if
        "Hashable" parser
            .store
            .traits
            .has
    then
        enum_name GenericType::new Type::Generic = receiver
        List[Type]::new "Hashable" TraitBound = hashable_bound
        hashable_bound trait_bound_to_type = hashable_type
        if parser.store hashable_type receiver type_has_satisfying_trait_impl ! then
            location
            Map[str str]::new
            Map[str List[TraitBound]]::new
            List[str]::new
            hashable_bound
            receiver
            TraitImpl
            parser register_trait_impl
        fi
    fi
}

fn derive_hashable_for_enums parser:mut$Parser {
    for
        casa_enum in parser
            .store
            .enums
            .values
            .iter
    do
        casa_enum parser synthesize_hashable_for_enum
    done
}

fn register_derived_copy
    parser:mut$Parser
    name:mut$str
    type_vars:mut$List[str]
    required_type_vars:Set[str]
    location:mut$Location
{
    List[Type]::new = arguments
    for type_variable in type_vars.iter do
        type_variable.clone Type::TypeVar arguments.push
    done
    arguments name GenericType Type::Generic = receiver
    List[Type]::new "Copy" TraitBound = copy_bound
    if parser.store copy_bound trait_bound_to_type receiver type_has_satisfying_trait_impl then
        return
    fi
    Map[str List[TraitBound]]::new = trait_bounds
    for type_variable in type_vars.iter do
        if type_variable required_type_vars.has ! then
            continue
        fi
        List[TraitBound]::new = type_bounds
        List[Type]::new "Copy" TraitBound type_bounds.push
        type_bounds type_variable.clone trait_bounds.set = trait_bounds
    done
    location
    Map[str str]::new
    trait_bounds
    type_vars
    copy_bound
    receiver
    TraitImpl
    parser register_trait_impl
}

fn derive_copy_for_aggregates parser:mut$Parser {
    for
        casa_struct in parser
            .store
            .structs
            .values
            .iter
    do
        for derived_trait in casa_struct.derived_traits.iter do
            if "Copy" derived_trait == then
                Set[str]::new = required_type_vars
                for type_variable in casa_struct.type_vars.iter do
                    for member in casa_struct.members.iter do
                        if type_variable member.typ.type_contains_var then
                            type_variable.clone required_type_vars.add = required_type_vars
                            break
                        fi
                    done
                done
                casa_struct.location required_type_vars casa_struct.type_vars casa_struct.name parser
                register_derived_copy
            else
                casa_struct.location f"Derivation for trait `{derived_trait}` is not supported" ErrorKind::InvalidScope parser.state.record_error
            fi
        done
    done
    for
        casa_enum in parser
            .store
            .enums
            .values
            .iter
    do
        for derived_trait in casa_enum.derived_traits.iter do
            if "Copy" derived_trait == then
                Set[str]::new = required_type_vars
                for type_variable in casa_enum.type_vars.iter do
                    for
                        payload_types in casa_enum
                            .variant_types
                            .values
                            .iter
                    do
                        for payload_type in payload_types.iter do
                            if type_variable payload_type.type_contains_var then
                                type_variable.clone required_type_vars.add = required_type_vars
                            fi
                        done
                    done
                done
                casa_enum.location required_type_vars casa_enum.type_vars casa_enum.name parser
                register_derived_copy
            else
                casa_enum.location f"Derivation for trait `{derived_trait}` is not supported" ErrorKind::InvalidScope parser.state.record_error
            fi
        done
    done
}

fn register_builtin_copy_impls parser:mut$Parser {
    if
        "Copy" parser
            .store
            .traits
            .has !
    then
        return
    fi
    for
        builtin_name in parser
            .store
            .builtins
            .iter
    do
        if "str" builtin_name == "array" builtin_name == || then
            continue
        fi
        builtin_name parse_type_str = receiver
        if parser.store "Copy" receiver find_satisfying_trait_type.is_some then
            continue
        fi
        "Copy" parser
            .store
            .traits
            .get
            .unwrap
            .location
        Map[str str]::new
        Map[str List[TraitBound]]::new
        List[str]::new
        List[Type]::new "Copy" TraitBound
        receiver
        TraitImpl
        parser register_trait_impl
    done
}

# ============================================================================
# _create_member_accessor - create getter/setter for struct members
# ============================================================================

fn create_member_accessor
    parser:mut$Parser
    struct_name:str
    member_name:str
    member_type:$Type
    member_index:u64
    location:$Location
    type_vars:$List[str]
{
    member_index WORD_SIZE * = offset

    # Parameterize the struct name when the struct has type vars
    List[Type]::new struct_name.clone GenericType Type::Generic = param_type
    type_vars string_list_to_set = effect_type_vars
    if 0 type_vars.length != then
        type_vars struct_name build_parameterized_type = param_type
    fi

    # Getter
    f"{struct_name}::{member_name}" = getter_name
    List[Op]::new = getter_ops
    location.clone OpValue::UnsafeStart Op::new getter_ops.push
    location.clone TYPE_PTR_T OpValue::TypeCast Op::new getter_ops.push
    location.clone offset (i64) make_integer_op_value Op::new getter_ops.push
    location.clone OpValue::Add Op::new getter_ops.push
    location.clone OpValue::Load64 Op::new getter_ops.push
    location.clone member_type clone_type OpValue::TypeCast Op::new getter_ops.push
    location.clone OpValue::UnsafeEnd Op::new getter_ops.push

    List[Parameter]::new = getter_params
    "" SHARED_BORROW_TYPE param_type clone_type apply_borrow_type Parameter::named getter_params.push
    List[Type]::new = getter_returns
    member_type clone_type getter_returns.push
    getter_returns getter_params StackEffect::new = getter_stack_effect
    effect_type_vars.clone getter_stack_effect StackEffect::set_type_vars
    effect_type_vars getter_stack_effect canonicalize_stack_effect_type_vars
    getter_stack_effect location.clone getter_ops getter_name.clone
    Function::with_stack_effect = getter

    if
        getter_name parser
            .store
            .functions
            .get
            .is_some
    then
        location f"Function `{getter_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
    fi
    getter getter_name parser.put_function

    # Setter
    f"{struct_name}::set_{member_name}" = setter_name
    List[Op]::new = setter_ops
    location.clone OpValue::UnsafeStart Op::new setter_ops.push
    location.clone TYPE_PTR_T OpValue::TypeCast Op::new setter_ops.push
    location.clone offset (i64) make_integer_op_value Op::new setter_ops.push
    location.clone OpValue::Add Op::new setter_ops.push
    location.clone OpValue::Swap Op::new setter_ops.push
    location.clone TYPE_U64_T OpValue::TypeCast Op::new setter_ops.push
    location.clone OpValue::Swap Op::new setter_ops.push
    location.clone OpValue::Store64 Op::new setter_ops.push
    location.clone OpValue::UnsafeEnd Op::new setter_ops.push

    List[Parameter]::new = setter_params
    "" EXCLUSIVE_BORROW_TYPE param_type clone_type apply_borrow_type Parameter::named setter_params.push
    "" member_type clone_type Parameter::named setter_params.push
    List[Type]::new = setter_returns
    setter_returns setter_params StackEffect::new = setter_stack_effect
    effect_type_vars.clone setter_stack_effect StackEffect::set_type_vars
    effect_type_vars setter_stack_effect canonicalize_stack_effect_type_vars
    setter_stack_effect location.clone setter_ops setter_name.clone
    Function::with_stack_effect = setter

    if
        setter_name parser
            .store
            .functions
            .get
            .is_some
    then
        location f"Function `{setter_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
    fi
    setter setter_name parser.put_function
}

# ============================================================================
# parse_struct - parse struct definition
# ============================================================================

fn parse_struct parser:mut$Parser cursor:mut$TokenCursor -> CasaStruct {
    fallback_token "struct" cursor expect_token_value.unwrap_or drop
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    # Parse optional type parameters
    List[str]::new = type_vars
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.names = type_vars
            # Trait bounds are not allowed on struct definitions
            if
                0 parsed_type_variables
                    .trait_bounds
                    .keys
                    .length !=
            then
                name_token Token::location "Trait bounds are not allowed on struct definitions. Use `impl[K: Bound] StructName[K]` instead" ErrorKind::UnexpectedToken parser.state.record_error
            fi
        fi
    fi

    cursor parse_derived_traits = derived_traits

    List[Member]::new = members
    type_vars string_list_to_set = struct_type_vars
    fallback_token "{" cursor expect_token_value.unwrap_or = struct_open_token

    while true do
        fallback_token cursor expect_token.unwrap_or = member_token
        if "}" member_token Token::value == then
            if parser.syntax_only then
                member_token Token::location Location::span Span::offset
                struct_open_token Token::location Location::span Span::offset
                SyntaxSpanKind::StructBody parser.state.record_span
            fi
            break
        fi
        if TokenKind::Identifier member_token Token::kind != then
            member_token Token::location "Expected member name" ErrorKind::UnexpectedToken parser.state.record_error
        fi
        fallback_token ":" cursor expect_token_value.unwrap_or drop
        cursor parse_type_ast = member_type
        if 0 type_vars.length != then
            struct_type_vars member_type canonicalize_type_var = member_type
        fi

        type_vars member_token Token::location members.length member_type member_token Token::value name_token Token::value parser create_member_accessor
        member_type member_token Token::value Member members.push
    done

    derived_traits type_vars name_token Token::location members name_token Token::value CasaStruct
}

# ============================================================================
# parse_trait - parse trait definition
# ============================================================================

fn parse_trait_method_stack_effect cursor:mut$TokenCursor -> StackEffect {
    List[Parameter]::new = params

    # Parse parameters, stopping at ->, fn, or }
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            break
        fi
        peek_opt.unwrap = peek
        if
            "->" peek Token::value ==
            "{" peek Token::value == ||
            "fn" peek Token::value == ||
            "}" peek Token::value == ||
        then
            break
        fi
        cursor.pop drop

        if
            TokenKind::Identifier peek Token::kind !=
            "fn" peek Token::value != &&
        then
            peek Token::location "Unexpected token in trait method parameter list" ErrorKind::UnexpectedToken cursor.state.record_error
        fi

        peek cursor parse_parameter_maybe_named params.push
    done

    List[Type]::new = returns
    cursor.peek = arrow_opt
    if arrow_opt Option::Some(arrow) is then
        if "->" arrow Token::value == then
            cursor.pop drop # consume ->
            while true do
                cursor.peek = return_opt
                if return_opt.is_none then
                    break
                fi
                return_opt.unwrap = return_token
                if
                    "fn" return_token Token::value ==
                    "}" return_token Token::value == ||
                    "{" return_token Token::value == ||
                then
                    break
                fi
                cursor parse_type_ast returns.push
            done
        fi
    fi

    returns params StackEffect::new
}
# Parse a bracket-delimited identifier-only type-parameter list:
# `[T1 T2 ...]`. `context` (e.g. "trait", "trait method") is interpolated
# into error messages. Does *not* accept trait bounds; for those use
# `parse_type_variables`.

fn parse_simple_type_vars cursor:mut$TokenCursor context:str -> List[str] {
    cursor.pop drop # consume [
    List[str]::new = collected
    true = loop_flag
    while loop_flag do
        cursor.peek = token_opt
        if token_opt.is_none then
            empty_location f"Unclosed {context} type parameter list" ErrorKind::UnmatchedBlock cursor.state.record_error
            cursor.state.mark_output_unusable
            false = loop_flag
        else
            token_opt.unwrap = token
            if "]" token Token::value == then
                cursor.pop drop
                false = loop_flag
            elif TokenKind::Identifier token Token::kind != then
                token Token::location f"Expected type parameter identifier in {context}" ErrorKind::UnexpectedToken cursor.state.record_error
                false = loop_flag
            else
                cursor.pop drop
                token Token::value collected.push
            fi
        fi
    done
    collected
}

fn parse_trait parser:mut$Parser cursor:mut$TokenCursor -> CasaTrait {
    fallback_token "trait" cursor expect_token_value.unwrap_or drop
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    List[str]::new = type_params
    cursor.peek = bracket_opt
    if { Token::value "[" == } bracket_opt.filter.is_some then
        "trait" cursor parse_simple_type_vars = type_params
    fi

    List[TraitBound]::new = supertraits
    cursor.peek = colon_opt
    if { Token::value ":" == } colon_opt.filter.is_some then
        cursor.pop drop
        true = parse_super_loop
        while parse_super_loop do
            fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = super_token
            super_token Token::value = super_name
            super_name parser
                .store
                .traits
                .get = super_def_opt
            super_token cursor parse_bound_type_args = super_args
            if super_def_opt Option::Some(super_def) is then
                super_def CasaTrait::type_params = super_params
                if super_args.length super_params.length != then
                    super_token Token::location f"Supertrait `{super_name}` expects {super_params.length} type argument(s), got {super_args.length}" ErrorKind::Syntax parser.state.record_error
                fi
            fi
            super_args super_name TraitBound supertraits.push
            cursor.peek = plus_opt
            if { Token::value "+" == } plus_opt.filter.is_some then
                cursor.pop drop
            else
                false = parse_super_loop
            fi
        done
    fi

    List[TraitMethod]::new = methods
    fallback_token "{" cursor expect_token_value.unwrap_or drop

    true = parse_trait_loop
    while parse_trait_loop do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token Token::location "Unclosed trait block" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            false = parse_trait_loop
        elif next_opt Option::Some(next) is then
            if "}" next Token::value == then
                cursor.pop drop
                false = parse_trait_loop
            elif "fn" next Token::value != then
                next Token::location "Expected method declaration in trait" ErrorKind::UnexpectedToken parser.state.record_error
                false = parse_trait_loop
            else
                next Token::location Location::span Span::offset = trait_fn_offset
                cursor.pop drop # consume fn
                cursor expect_function_name = method_name
                if "drop" method_name Token::value == then
                    method_name Token::location "`drop` is reserved for inherent cleanup methods" ErrorKind::InvalidScope parser.state.record_error
                fi

                # Parse optional method-level type parameters (e.g., fn map[U])
                List[str]::new = method_type_vars
                if cursor.peek Option::Some(mtv_bracket) is then
                    if "[" mtv_bracket Token::value == then
                        "trait method" cursor parse_simple_type_vars = method_type_vars
                    fi
                fi

                cursor parse_trait_method_stack_effect = method_stack_effect

                type_params string_list_to_set = trait_tv_set
                TRAIT_SELF_TYPE trait_tv_set.add = trait_tv_set
                for mtv in method_type_vars.iter do
                    mtv.clone trait_tv_set.add = trait_tv_set
                done
                trait_tv_set method_stack_effect canonicalize_stack_effect_type_vars

                # Parse optional default method body
                List[Op]::new = default_ops
                if cursor.peek Option::Some(body_peek) is then
                    if "{" body_peek Token::value == then
                        f"{name_token Token::value}::{method_name Token::value}" cursor parser parse_block_ops = default_ops
                        if parser.syntax_only then
                            cursor.previous_offset
                            trait_fn_offset
                            SyntaxSpanKind::Definition parser.state.record_span
                        fi
                    fi
                fi

                method_type_vars default_ops method_stack_effect method_name Token::value TraitMethod methods.push
            fi
        else
            false = parse_trait_loop
        fi
    done

    name_token Token::location supertraits methods type_params name_token Token::value CasaTrait
}

# ============================================================================
# parse_impl_block - parse impl Type { fn methods... }
# ============================================================================

fn inject_implementation_parameters
    parser:mut$Parser
    function:mut$Function
    type_vars:$List[str]
    trait_bounds:$Map[str List[TraitBound]]
    constant_parameters:$Map[str BuiltinType]
{
