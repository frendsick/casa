# Parser for the Casa programming language.
#
# Converts a token list into an op list.
import "std"
import "os"
import "parser"
import "common"
import "error"
import "lexer"
import "semantics"
import "selective_import"

# ============================================================================
# Structural layout spans (formatter facts)
#
# Data-only source-offset ranges over the structures whose layout `casafmt`
# owns. `start` and `close` are the source byte offsets of the opening and
# closing tokens. Recorded only in syntax-only mode (see `analyze_syntax`); no
# spans are produced during normal compilation.
# ============================================================================

enum SyntaxSpanKind derives Copy {
    Definition
    DelimitedForm
    StructBody
    EnumBody
    ControlForm
    MatchForm
    MatchArm
    AccessorChain
}

struct SyntaxSpan {
    kind:  SyntaxSpanKind
    start: u64
    close: u64
}

impl SyntaxSpan: Clone {
    fn clone self:$SyntaxSpan -> SyntaxSpan { self.close self.start self.kind SyntaxSpan }
}

# ============================================================================
# Parser struct and parse/resolve result
#
# `Parser` owns parse-private state. Later compiler phases receive only the
# dependencies they use, not the parser object itself.
# ============================================================================

struct ParseState {
    diagnostics:       Diagnostics
    output_usable:     List[bool]
    recovery_required: List[bool]
    store_mutated:     List[bool]
    spans:             List[SyntaxSpan]
    if_starts:         List[u64]
    while_starts:      List[u64]
    accessor_start:    Option[u64]
    accessor_close:    u64
}

impl ParseState {
    fn new diagnostics:Diagnostics -> ParseState {
        List[bool]::new = store_mutated
        false store_mutated.push
        List[bool]::new = recovery_required
        false recovery_required.push
        List[bool]::new = output_usable
        true output_usable.push
        List[SyntaxSpan]::new = spans
        List[u64]::new = if_starts
        List[u64]::new = while_starts
        0 (u64)
        Option[u64]::None
        while_starts if_starts spans store_mutated recovery_required output_usable diagnostics ParseState
    }

    fn record_error self:mut$ParseState kind:ErrorKind message:$str location:$Location {
        location message kind self.diagnostics.record_error
    }

    fn record_error_string self:mut$ParseState kind:ErrorKind message:String location:$Location {
        location message kind self.diagnostics.record_error_string
    }

    fn record_error_expected
        self:mut$ParseState
        kind:ErrorKind
        message:String
        location:$Location
        expected:String
        got:String
    {
        got expected location.clone message kind CasaError::with_expected
        self.diagnostics.push_error
    }

    fn mark_output_unusable self:mut$ParseState { false 0 self.output_usable.set }

    fn has_usable_output self:mut$ParseState -> bool { 0 self.output_usable.get copy }

    fn request_recovery self:mut$ParseState { true 0 self.recovery_required.set }

    fn take_recovery_request self:mut$ParseState -> bool {
        0 self.recovery_required.get copy = requested
        false 0 self.recovery_required.set
        requested
    }

    fn reset_store_mutation self:mut$ParseState { false 0 self.store_mutated.set }

    fn mark_store_mutated self:mut$ParseState { true 0 self.store_mutated.set }

    fn store_was_mutated self:mut$ParseState -> bool { 0 self.store_mutated.get copy }

    fn into_diagnostics self:ParseState -> Diagnostics {
        self match
            ParseState { diagnostics: diagnostics } => diagnostics
        end
    }

    # Record one structural layout span.
    fn record_span self:mut$ParseState kind:SyntaxSpanKind start:u64 close:u64 {
        close start kind SyntaxSpan self.spans.push
    }

    # Record simple control forms while the parser consumes their keywords.
    fn record_control_op self:mut$ParseState value:$OpValue offset:u64 {
        if value OpValue::IfStart is then
            offset self.if_starts.push
        elif value OpValue::IfEnd is self.if_starts.is_empty ! && then
            self.if_starts.pop = start
            offset start SyntaxSpanKind::ControlForm self.record_span
        elif value OpValue::WhileStart is then
            offset self.while_starts.push
        elif value OpValue::WhileEnd is self.while_starts.is_empty ! && then
            self.while_starts.pop = start
            offset start SyntaxSpanKind::ControlForm self.record_span
        fi
    }

    fn record_accessor self:mut$ParseState start:u64 close:u64 {
        if self.accessor_start.is_none then
            start Option::Some = self.accessor_start
        fi
        close = self.accessor_close
    }

    fn flush_accessor_chain self:mut$ParseState {
        # The formatter owns compact and expanded accessor layout.
        if self.accessor_start Option::Some(start) is then
            self.accessor_close start SyntaxSpanKind::AccessorChain self.record_span
        fi
        Option[u64]::None = self.accessor_start
        0 = self.accessor_close
    }
}

struct ImportedModule {
    store:             SymbolStore
    ops:               List[Op]
    included_files:    Set[String]
    inherited_symbols: Set[String]
    inherited_impls:   Set[String]
}

struct Parser {
    store:                  SymbolStore
    included_files:         Set[String]
    selective_import_cache: Map[String ImportedModule]
    search_paths:           List[String]
    sources:                mut$SourceStore
    state:                  ParseState
    syntax_only:            bool
}

struct ParseResolveResult {
    ops:         Option[List[Op]]
    store:       SymbolStore
    diagnostics: Diagnostics
}

impl ParseResolveResult {
    fn into_parts self:ParseResolveResult -> Option[List[Op]] SymbolStore Diagnostics {
        self match
            ParseResolveResult { ops: ops store: store diagnostics: diagnostics } => ops store diagnostics
        end
    }
}
# Data-only facts used to prove that formatting preserves source meaning.

struct SyntaxTokenFact {
    spelling: String
    kind:     TokenKind
}

struct SyntaxCommentFact {
    text:                  String
    preceding_token_count: u64
    attached_to_preceding: bool
}

struct SyntaxFacts {
    meaningful_tokens: List[SyntaxTokenFact]
    comments:          List[SyntaxCommentFact]
    spans:             List[SyntaxSpan]
}

struct SyntaxResult {
    tokens:      List[Token]
    facts:       Option[SyntaxFacts]
    diagnostics: Diagnostics
}

impl SyntaxResult {
    fn into_parts self:SyntaxResult -> List[Token] Option[SyntaxFacts] Diagnostics {
        self match
            SyntaxResult { tokens: tokens facts: facts diagnostics: diagnostics } => tokens facts diagnostics
        end
    }
}

impl Parser {
    fn new store:SymbolStore diagnostics:Diagnostics sources:mut$SourceStore -> Parser {
        false
        diagnostics ParseState::new
        sources
        List[String]::new
        Map[String ImportedModule]::new
        Set[String]::new
        store
        Parser
    }

    fn into_parts self:Parser -> SymbolStore Set[String] ParseState {
        self match
            Parser { store: store included_files: included_files state: state } => store included_files state
        end
    }

    fn into_diagnostics self:Parser -> Diagnostics {
        self.into_parts = state = included_files = store
        state.into_diagnostics
    }

    fn into_result self:Parser ops:Option[List[Op]] -> ParseResolveResult List[String] {
        self.into_parts = state = included_files = store
        included_files.to_list = included_file_list
        state.into_diagnostics store ops ParseResolveResult
        included_file_list
    }

    fn into_failed_result self:Parser -> ParseResolveResult List[String] {
        self.into_parts = state = included_files = store
        store drop
        included_files.to_list = included_file_list
        state.into_diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult
        included_file_list
    }

    fn put_function self:mut$Parser name:String function:Function {
        self.state.mark_store_mutated
        function name self
            .store
            .functions
            .set
    }

    fn put_constant self:mut$Parser name:String constant:Constant {
        self.state.mark_store_mutated
        constant name self
            .store
            .constants
            .set
    }

    fn put_enum self:mut$Parser name:String casa_enum:CasaEnum {
        self.state.mark_store_mutated
        casa_enum name self
            .store
            .enums
            .set
    }

    fn put_struct self:mut$Parser name:String casa_struct:CasaStruct {
        self.state.mark_store_mutated
        casa_struct name self
            .store
            .structs
            .set
    }

    fn put_trait self:mut$Parser name:String casa_trait:CasaTrait {
        self.state.mark_store_mutated
        casa_trait name self
            .store
            .traits
            .set
    }

    fn put_trait_impl self:mut$Parser name:String trait_impl:TraitImpl {
        self.state.mark_store_mutated
        trait_impl name self
            .store
            .trait_impls
            .set
        Map[String bool]::new = self.store.copy_types
    }
}

impl SymbolStore {
    fn declaration_names self:$SymbolStore -> Set[String] {
        Set[String]::new = names
        for
            name in self
                .functions
                .keys
                .iter
        do
            name.clone names.add
        done
        for
            name in self
                .constants
                .keys
                .iter
        do
            name.clone names.add
        done
        for
            name in self
                .structs
                .keys
                .iter
        do
            name.clone names.add
        done
        for
            name in self
                .enums
                .keys
                .iter
        do
            name.clone names.add
        done
        for
            name in self
                .traits
                .keys
                .iter
        do
            name.clone names.add
        done
        names
    }

    fn is_function_unsafe self:$SymbolStore name:$str -> Option[bool] {
        if name self.functions.get_str Option::Some(function) is then
            function.is_unsafe Option::Some
        else
            Option[bool]::None
        fi
    }

    fn get_struct_member_names self:$SymbolStore name:$str -> Option[List[String]] {
        if name self.structs.get_str Option::Some(casa_struct) is then
            List[String]::new = names
            for member in casa_struct.members.iter do
                member.name.clone names.push
            done
            names Option::Some
        else
            Option[List[String]]::None
        fi
    }

    fn count_trait_type_parameters self:$SymbolStore name:$str -> Option[u64] {
        if name self.traits.get_str Option::Some(casa_trait) is then
            casa_trait.type_params.length Option::Some
        else
            Option[u64]::None
        fi
    }

    fn clone_ownership self:$SymbolStore op_id:i64 -> Option[OpOwnership] {
        if op_id self.op_ownership.get Option::Some(value) is then
            value.clone Option::Some
        else
            Option[OpOwnership]::None
        fi
    }

    fn merge_import_metadata self:mut$SymbolStore imported:$SymbolStore {
        for
            name in imported
                .variables
                .keys
                .iter
        do
            if name self.variables.has ! then
                name imported
                    .variables
                    .get
                    .unwrap
                    .clone name.clone self.variables.set
            fi
        done
        for
            name in imported
                .constants
                .keys
                .iter
        do
            if name self.constants.has ! then
                name imported
                    .constants
                    .get
                    .unwrap
                    .clone name.clone self.constants.set
            fi
        done
        for
            name in imported
                .enums
                .keys
                .iter
        do
            if name self.enums.has ! then
                name imported
                    .enums
                    .get
                    .unwrap
                    .clone name.clone self.enums.set
            fi
        done
        for
            name in imported
                .structs
                .keys
                .iter
        do
            if name self.structs.has ! then
                name imported
                    .structs
                    .get
                    .unwrap
                    .clone name.clone self.structs.set
            fi
        done
        for
            name in imported
                .traits
                .keys
                .iter
        do
            if name self.traits.has ! then
                name imported
                    .traits
                    .get
                    .unwrap
                    .clone name.clone self.traits.set
            fi
        done
        for
            name in imported
                .trait_impls
                .keys
                .iter
        do
            if name self.trait_impls.has ! then
                name imported
                    .trait_impls
                    .get
                    .unwrap
                    .clone name.clone self.trait_impls.set
            fi
        done
    }

    fn merge_import self:mut$SymbolStore imported:mut$SymbolStore {
        Map[String bool]::new = self.copy_types
        imported.functions.keys = function_names
        for name in function_names.iter do
            name imported
                .functions
                .remove
                .unwrap = imported_function
            name self.functions.get_mut = existing_function_opt
            existing_function_opt match
                Option::Some(existing_function) => {
                    if imported_function.is_used then
                        true = existing_function.is_used
                    fi
                }
                Option::None => imported_function name.clone self.functions.set
            end
        done
        imported self.merge_import_metadata
    }

    fn clone self:$SymbolStore -> SymbolStore {
        symbol_store_new = cloned
        for
            name in self
                .functions
                .keys
                .iter
        do
            name self
                .functions
                .get
                .unwrap
                .clone_declaration name.clone cloned.functions.set
        done
        self cloned.merge_import_metadata
        cloned
    }

    fn clone_for_selective_import self:$SymbolStore -> SymbolStore {
        symbol_store_new = cloned
        for
            name in self
                .functions
                .keys
                .iter
        do
            name self
                .functions
                .get
                .unwrap
                .clone_for_import name.clone cloned.functions.set
        done
        self cloned.merge_import_metadata
        cloned
    }
}

# ============================================================================
# Simple keyword -> OpValue lookup (no-payload variants only)
# ============================================================================

fn keyword_to_op_value keyword_kind:$KeywordKind -> Option[OpValue] {
    keyword_kind match
        KeywordKind::Break => OpValue::WhileBreak Option::Some
        KeywordKind::Continue => OpValue::WhileContinue Option::Some
        KeywordKind::Do => OpValue::WhileCondition Option::Some
        KeywordKind::Done => OpValue::WhileEnd Option::Some
        KeywordKind::Elif => OpValue::IfElif Option::Some
        KeywordKind::Else => OpValue::IfElse Option::Some
        KeywordKind::Fi => OpValue::IfEnd Option::Some
        KeywordKind::If => OpValue::IfStart Option::Some
        KeywordKind::Return => OpValue::FnReturn Option::Some
        KeywordKind::Then => OpValue::IfCondition Option::Some
        KeywordKind::While => OpValue::WhileStart Option::Some
        _ => Option[OpValue]::None
    end
}

# ============================================================================
# Operator -> OpValue lookup
# ============================================================================

fn operator_to_op_value operator_kind:OperatorKind -> Option[OpValue] {
    operator_kind match
        OperatorKind::Plus => OpValue::Add Option::Some
        OperatorKind::Minus => OpValue::Sub Option::Some
        OperatorKind::Mul => OpValue::Mul Option::Some
        OperatorKind::Div => OpValue::Div Option::Some
        OperatorKind::Mod => OpValue::Mod Option::Some
        OperatorKind::Shl => OpValue::Shl Option::Some
        OperatorKind::Shr => OpValue::Shr Option::Some
        OperatorKind::BitAnd => OpValue::BitAnd Option::Some
        OperatorKind::BitOr => OpValue::BitOr Option::Some
        OperatorKind::BitXor => OpValue::BitXor Option::Some
        OperatorKind::BitNot => OpValue::BitNot Option::Some
        OperatorKind::And => OpValue::And Option::Some
        OperatorKind::Or => OpValue::Or Option::Some
        OperatorKind::Not => OpValue::Not Option::Some
        OperatorKind::Eq => OpValue::Eq Option::Some
        OperatorKind::Ge => OpValue::Ge Option::Some
        OperatorKind::Gt => OpValue::Gt Option::Some
        OperatorKind::Le => OpValue::Le Option::Some
        OperatorKind::Lt => OpValue::Lt Option::Some
        OperatorKind::Ne => OpValue::Ne Option::Some
        _ => Option[OpValue]::None
    end
}

fn op_value_to_operator_kind op_value:$OpValue -> Option[OperatorKind] {
    op_value match
        OpValue::Add => OperatorKind::Plus Option::Some
        OpValue::Sub => OperatorKind::Minus Option::Some
        OpValue::Mul => OperatorKind::Mul Option::Some
        OpValue::Div => OperatorKind::Div Option::Some
        OpValue::Mod => OperatorKind::Mod Option::Some
        OpValue::Shl => OperatorKind::Shl Option::Some
        OpValue::Shr => OperatorKind::Shr Option::Some
        OpValue::BitAnd => OperatorKind::BitAnd Option::Some
        OpValue::BitOr => OperatorKind::BitOr Option::Some
        OpValue::BitXor => OperatorKind::BitXor Option::Some
        OpValue::BitNot => OperatorKind::BitNot Option::Some
        OpValue::And => OperatorKind::And Option::Some
        OpValue::Or => OperatorKind::Or Option::Some
        OpValue::Not => OperatorKind::Not Option::Some
        OpValue::Eq => OperatorKind::Eq Option::Some
        OpValue::Ge => OperatorKind::Ge Option::Some
        OpValue::Gt => OperatorKind::Gt Option::Some
        OpValue::Le => OperatorKind::Le Option::Some
        OpValue::Lt => OperatorKind::Lt Option::Some
        OpValue::Ne => OperatorKind::Ne Option::Some
        _ => Option[OperatorKind]::None
    end
}

# ============================================================================
# Token cursor
# ============================================================================

struct TokenCursor {
    tokens: List[Token]
    pos:    u64
}

impl TokenCursor {
    fn new tokens:List[Token] -> TokenCursor { 0 tokens TokenCursor }

    fn pop self:mut$TokenCursor -> Option[Token] {
        self TokenCursor::pos copy = pos
        if self TokenCursor::tokens.length pos >= then
            Option::None return
        fi
        pos self TokenCursor::tokens.get.clone = token
        pos 1 + self TokenCursor::set_pos
        token Option::Some
    }

    fn peek self:mut$TokenCursor -> Option[Token] {
        self TokenCursor::pos copy = pos
        if self TokenCursor::tokens.length pos >= then
            Option::None return
        fi
        pos self TokenCursor::tokens.get.clone Option::Some
    }

    fn is_finished self:mut$TokenCursor -> bool {
        self TokenCursor::tokens.length self TokenCursor::pos >=
    }

    fn advance self:mut$TokenCursor { self TokenCursor::pos 1 + self TokenCursor::set_pos }

    fn retreat self:mut$TokenCursor { self TokenCursor::pos 1 - self TokenCursor::set_pos }

    fn save self:mut$TokenCursor -> u64 { self TokenCursor::pos }

    # Source byte offset of the token just consumed (at pos - 1).
    fn previous_offset self:mut$TokenCursor -> u64 {
        self.pos 1 - self.tokens.get Token::location Location::span Span::offset
    }

    fn restore self:mut$TokenCursor saved:u64 { saved self TokenCursor::set_pos }

    fn recover_at_structure self:mut$TokenCursor -> bool {
        if 0 self.pos > then
            self.pos 1 - self.tokens.get = previous
            if previous is_parser_synchronization_token then
                true return
            fi
        fi
        while self.is_finished ! do
            self.peek.unwrap = token
            if token is_parser_synchronization_token then
                if token is_parser_delimiter then
                    self.advance
                fi
                true return
            fi
            self.advance
        done
        false
    }
}

fn is_parser_synchronization_token token:$Token -> bool {
    if token is_parser_delimiter then
        true return
    fi
    token.value.as_str = value: $str
    "fn" value ==
    "enum" value == ||
    "struct" value == ||
    "trait" value == ||
    "impl" value == ||
    "import" value == ||
    "const" value == ||
}

fn is_parser_delimiter token:$Token -> bool {
    token.value.as_str = value: $str
    "}" value == "fi" value == || "done" value == || "end" value == ||
}

# ============================================================================
# expect_token - consume next token, error if mismatch
# ============================================================================

fn fallback_token -> Token { empty_location TokenKind::Eof "".to_str Token::new }

fn expect_token cursor:mut$TokenCursor state:mut$ParseState -> Option[Token] {
    cursor.pop = result_opt
    if result_opt.is_none then
        empty_location "Unexpected end of input" ErrorKind::UnexpectedToken state.record_error
        state.mark_output_unusable
        state.request_recovery
        Option::None return
    fi
    result_opt.unwrap = token
    if TokenKind::Eof token Token::kind == then
        token Token::location "Unexpected end of input" ErrorKind::UnexpectedToken state.record_error
        state.mark_output_unusable
        state.request_recovery
        Option::None return
    fi
    token Option::Some
}

fn expect_token_value cursor:mut$TokenCursor expected:str state:mut$ParseState -> Option[Token] {
    state cursor expect_token = token_opt
    if token_opt.is_none then
        Option::None return
    fi
    token_opt.unwrap = token
    if expected token Token::value.as_str != then
        cursor.retreat
        f"`{token Token::value.as_str}`"
        f"`{expected}`"
        token Token::location
        "Unexpected token".to_str
        ErrorKind::UnexpectedToken
        state.record_error_expected
        state.request_recovery
        Option::None return
    fi
    token Option::Some
}

fn expect_token_kind
    cursor:mut$TokenCursor
    expected_kind:TokenKind
    state:mut$ParseState
-> Option[Token] {
    state cursor expect_token = token_opt
    if token_opt.is_none then
        Option::None return
    fi
    token_opt.unwrap = token
    if expected_kind token Token::kind != then
        cursor.retreat
        token Token::location "Unexpected token" ErrorKind::UnexpectedToken state.record_error
        state.request_recovery
        Option::None return
    fi
    token Option::Some
}

# ============================================================================
# expect_delimiter - consume expected delimiter or return None
# ============================================================================

fn expect_delimiter cursor:mut$TokenCursor expected_value:str -> bool {
    cursor.peek = peek_opt
    if peek_opt.is_none then
        false return
    fi
    peek_opt.unwrap = token
    if expected_value token Token::value.as_str != then
        false return
    fi
    cursor.advance
    true
}

# ============================================================================
# parse_type - parse a type expression
# ============================================================================
# True if a type-position leaf is a constant argument (integer, `true`/`false`,
# or char literal) rather than a type name (ADR-0153).

fn is_type_argument_literal value:$str -> bool {
    if value try_parse_uint_literal.is_some then
        true return
    fi
    if "true" value.as_str == "false" value.as_str == || then
        true return
    fi
    value char_literal_codepoint.is_some
}

fn parse_type_ast cursor:mut$TokenCursor state:mut$ParseState -> Type {
    cursor.peek = peek_opt
    if peek_opt.is_none then
        empty_location "Expected type" ErrorKind::UnexpectedToken state.record_error
        Type::Unknown return
    fi
    peek_opt.unwrap = peek

    "" = borrow_prefix
    String::new = base
    if "fn" peek Token::value.as_str == then
        cursor.pop drop
        "fn".to_str = base
    else
        fallback_token state cursor expect_token.unwrap_or = base_token
        if
            TokenKind::Identifier base_token Token::kind !=
            base_token Token::value.as_str is_type_argument_literal ! &&
        then
            base_token Token::location "Expected type name" ErrorKind::UnexpectedToken state.record_error
        fi
        base_token Token::value.clone = base
    fi
    if base.as_str "mut$" str::starts_with then
        EXCLUSIVE_BORROW_TYPE = borrow_prefix
        base.length = base_length
        base.as_str 4 base_length 4 - str::substring = base
    elif base.as_str "$" str::starts_with then
        SHARED_BORROW_TYPE = borrow_prefix
        base.length = base_length
        base.as_str 1 base_length 1 - str::substring = base
    fi
    if base.as_str "$" str::starts_with base.as_str "mut$" str::starts_with || then
        peek.location "Nested borrow qualifiers are not supported" ErrorKind::Syntax
        state.record_error
        Type::Unknown return
    fi

    # Char constant (ADR-0153): built here rather than in `parse_type_str`,
    # which cannot decode the codepoint.
    if base.as_str char_literal_codepoint Option::Some(char_codepoint) is then
        BuiltinType::Char char_codepoint ConstType::concrete Type::Const return
    fi

    cursor.peek = next_opt
    if next_opt.is_none then
        borrow_prefix base.as_str parse_type_str apply_borrow_type return
    fi
    if next_opt Option::Some(next) is then
        if "[" next Token::value.as_str != then
            borrow_prefix base.as_str parse_type_str apply_borrow_type return
        fi
    fi
    cursor.advance # consume [

    if "fn" base.as_str == then
        List[Type]::new = fn_params
        List[Type]::new = fn_returns
        false = past_arrow
        while cursor.is_finished ! do
            cursor.peek = inner_opt
            if inner_opt.is_none then
                break
            fi
            inner_opt.unwrap Token::value.as_str = ival: $str
            if "]" ival.as_str == then
                cursor.pop drop
                break
            fi
            if "->" ival.as_str == then
                cursor.pop drop
                true = past_arrow
                continue
            fi
            state cursor parse_type_ast = inner_type
            if past_arrow then
                inner_type fn_returns.push
            else
                inner_type fn_params.push
            fi
        done
        borrow_prefix fn_returns fn_params FunctionType Type::Function apply_borrow_type return
    fi

    List[Type]::new = inner_types
    while true do
        cursor.peek = inner_opt
        if inner_opt Option::Some(inner) is then
            if "]" inner Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi
        state cursor parse_type_ast inner_types.push
    done
    if 0 inner_types.length == then
        empty_location f"Expected type parameter inside `{base}[...]`" ErrorKind::UnexpectedToken state.record_error_string
    fi
    borrow_prefix inner_types base GenericType Type::Generic apply_borrow_type
}

# ============================================================================
# get_op_type_cast - parse (type) cast
# ============================================================================

fn get_op_type_cast cursor:mut$TokenCursor state:mut$ParseState -> Op {
    fallback_token state "(" cursor expect_token_value.unwrap_or = open_token
    state cursor parse_type_ast = cast_type
    fallback_token state ")" cursor expect_token_value.unwrap_or = close_token

    open_token Token::location Location::span Span::offset = open_offset
    close_token Token::location Location::span Span::offset = close_offset
    close_offset open_offset - 1 + = length
    length open_offset open_token Token::location Location::file.clone Location::new = loc

    loc cast_type OpValue::TypeCast Op::new
}

# ============================================================================
# get_op_literal - convert literal token to push op
# ============================================================================

fn char_literal_codepoint value:$str -> Option[i64] {
    if 3 value.length < then
        Option[i64]::None return
    fi
    if '\'' 0 value.at != '\'' value.length 1 - value.at != || then
        Option[i64]::None return
    fi
    value 1 decode_utf8_scalar = decoded_opt
    if decoded_opt Option::Some(decoded) is then
        if decoded.byte_length 2 + value.length == then
            decoded DecodedUtf8Scalar::codepoint i64::from Option::Some return
        fi
    fi
    Option[i64]::None
}

fn get_op_literal token:$Token cursor:mut$TokenCursor state:mut$ParseState -> Op {
    token Token::value.as_str = value: $str
    if "true" value.as_str == then
        token Token::location 1 OpValue::PushBool Op::new return
    fi
    if "false" value.as_str == then
        token Token::location 0 OpValue::PushBool Op::new return
    fi
    # Numeric literal (positive or negative)
    if value is_float_literal then
        token Token::location value.to_str OpValue::PushFloat Op::new return
    fi
    if 0 value.at.is_digit value is_negative_integer_literal || then
        value str_to_int = int_value
        token Token::location int_value value.to_str IntegerLiteral::new OpValue::PushInt Op::new return
    fi
    value char_literal_codepoint = char_opt
    if char_opt Option::Some(char_value) is then
        token Token::location char_value OpValue::PushChar Op::new return
    fi
    # String literal: "..."
    if '"' 0 value.at == '"' value.length 1 - value.at == && then
        value.length = value_length
        value 1 value_length 2 - str::substring = str_value
        token Token::location str_value OpValue::PushStr Op::new return
    fi
    token Token::location f"Token `{value}` is not a literal" ErrorKind::Syntax state.record_error_string
    token Token::location 0 make_integer_op_value Op::new
}

# ============================================================================
# get_op_intrinsic - convert intrinsic token to op
# ============================================================================

fn get_op_intrinsic token:$Token cursor:mut$TokenCursor state:mut$ParseState -> Op {
    token Token::value.as_str intrinsic_from_str = kind_opt
    if kind_opt Option::Some(kind) is then
        kind copy = intrinsic_kind
        if intrinsic_kind IntrinsicKind::SizeOf == then
            fallback_token state "[" cursor expect_token_value.unwrap_or drop
            state cursor parse_type_ast = target_type
            fallback_token state "]" cursor expect_token_value.unwrap_or drop
            token Token::location target_type OpValue::SizeOf Op::new return
        fi
        intrinsic_kind intrinsic_to_op_value match
            Option::Some(op_value) => token Token::location op_value Op::new return
            Option::None => {
                token Token::location f"No OpValue for intrinsic `{token Token::value.as_str}`" ErrorKind::Syntax state.record_error_string
            }
        end
    else
        token Token::location f"Token `{token Token::value.as_str}` is not an intrinsic" ErrorKind::Syntax state.record_error_string
    fi
    token Token::location 0 make_integer_op_value Op::new
}

# ============================================================================
# get_op_operator - convert operator token to op
# ============================================================================

fn parse_assignment_target cursor:mut$TokenCursor state:mut$ParseState -> Location String {
    fallback_token state TokenKind::Identifier cursor expect_token_kind.unwrap_or = root_token
    root_token Token::value.clone = target
    while "." cursor expect_delimiter do
        fallback_token state TokenKind::Identifier cursor expect_token_kind.unwrap_or Token::value.as_str = field: $str
        f"{target}.{field}" = target
    done
    root_token Token::location.clone
    target
}

fn get_op_operator
    token:$Token
    cursor:mut$TokenCursor
    function_name:$str
    state:mut$ParseState
-> Op {
    token Token::value.as_str operator_from_str = kind_opt
    if kind_opt Option::Some(kind) is then
        kind copy = operator_kind

        # Assignment: = varname
        if OperatorKind::Assign operator_kind == then
            state cursor parse_assignment_target = var_name = target_location

            # Optional type annotation: = varname : type
            Option[Type]::None = type_hint
            cursor.peek = colon_opt
            if colon_opt Option::Some(colon) is then
                if ":" colon Token::value.as_str == then
                    cursor.advance
                    state cursor parse_type_ast Option::Some = type_hint
                fi
            fi
            target_location var_name OpValue::AssignVar Op::new = assign_op
            type_hint = assign_op.type_hint
            assign_op return
        fi

        # Compound assignment: += varname
        if OperatorKind::AssignInc operator_kind == then
            state cursor parse_assignment_target = inc_target = inc_location
            inc_location inc_target OpValue::AssignInc Op::new return
        fi

        # Compound assignment: -= varname
        if OperatorKind::AssignDec operator_kind == then
            state cursor parse_assignment_target = dec_target = dec_location
            dec_location dec_target OpValue::AssignDec Op::new return
        fi

        # Simple operator -> OpValue lookup
        operator_kind operator_to_op_value match
            Option::Some(op_value) => token Token::location op_value Op::new return
            Option::None => {
                token Token::location f"No OpValue for operator `{token Token::value.as_str}`" ErrorKind::Syntax state.record_error_string
            }
        end
    else
        token Token::location f"Token `{token Token::value.as_str}` is not an operator" ErrorKind::Syntax state.record_error_string
    fi
    token Token::location 0 make_integer_op_value Op::new
}

# ============================================================================
# Forward declarations (functions that call each other)
# ============================================================================
# token_to_op, parse_block_ops, handle_fstring are mutually recursive
# In Casa, we just define them in order and rely on global function lookup.
# ============================================================================
# get_op_array - parse [item1, item2] array literal
# ============================================================================

fn parse_array_struct_literal
    parser:mut$Parser
    function_name:$str
    cursor:mut$TokenCursor
    name_token:$Token
    items:mut$List[Op]
{
    function_name cursor name_token parser parse_struct_literal = struct_ops
    name_token Token::location struct_ops OpValue::ExprGroup Op::new items.push
}

fn parse_array_lambda
    parser:mut$Parser
    function_name:$str
    cursor:mut$TokenCursor
    brace_token:Token
    items:mut$List[Op]
{
    cursor.retreat
    f"lambda__{function_name}_o{brace_token Token::location Location::span Span::offset}" = arr_lam_name
    arr_lam_name.as_str cursor parser parse_block_ops = arr_lam_ops
    brace_token Token::location.clone arr_lam_ops arr_lam_name.clone Function::new = arr_lam_fn
    arr_lam_fn arr_lam_name.clone parser.put_function
    brace_token Token::location.clone arr_lam_name OpValue::FnPush Op::new items.push
}

fn get_op_array parser:mut$Parser function_name:$str cursor:mut$TokenCursor -> Op {
    fallback_token parser.state "[" cursor expect_token_value.unwrap_or = open_token
    List[Op]::new = items
    while true do
        # Close on `]` (also reached after an optional trailing comma).
        cursor.peek = close_peek
        if close_peek Option::Some(cp) is then
            if "]" cp Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi

        # Parse one item.
        false = parsed_nested
        cursor.peek = next_opt
        if next_opt Option::Some(next) is then
            if "[" next Token::value.as_str == then
                cursor function_name parser get_op_array items.push
                true = parsed_nested
            fi
        fi
        if parsed_nested ! then
            cursor.pop = value_opt
            if value_opt.is_none then
                open_token Token::location "Unexpected end of input in array literal" ErrorKind::UnexpectedToken parser.state.record_error
                parser.state.mark_output_unusable
                open_token.location items OpValue::PushArray Op::new return
            fi
            value_opt.unwrap = value_token
            if "{" value_token Token::value.as_str == then
                items value_token cursor function_name parser parse_array_lambda
            elif TokenKind::Literal value_token Token::kind == then
                parser.state cursor value_token get_op_literal items.push
            elif TokenKind::Identifier value_token Token::kind == then
                cursor.peek = struct_peek_opt
                if struct_peek_opt Option::Some(struct_peek) is then
                    if "{" struct_peek Token::value.as_str == then
                        items value_token cursor function_name parser parse_array_struct_literal
                    else
                        value_token Token::location value_token Token::value.clone OpValue::Identifier Op::new items.push
                    fi
                else
                    value_token Token::location value_token Token::value.clone OpValue::Identifier Op::new items.push
                fi
            else
                value_token Token::location "Unexpected token in array literal" ErrorKind::UnexpectedToken parser.state.record_error
            fi
        fi

        # Items MUST be comma-separated. A single trailing comma before `]` is
        # allowed for developer experience; the next iteration closes on `]`.
        cursor.peek = sep_peek
        if sep_peek Option::Some(sp) is then
            if "," sp Token::value.as_str == then
                cursor.pop drop
            else
                if "]" sp Token::value.as_str == ! then
                    sp Token::location "Expected `,` between array items" ErrorKind::UnexpectedToken parser.state.record_error
                    parser.state.mark_output_unusable
                    break
                fi
            fi
        else
            open_token Token::location "Unexpected end of input in array literal" ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
    done
    if parser.syntax_only then
        cursor.previous_offset
        open_token Token::location Location::span Span::offset
        SyntaxSpanKind::DelimitedForm parser.state.record_span
    fi
    open_token Token::location items OpValue::PushArray Op::new
}

# ============================================================================
# parse_block_ops - parse { ... } delimited block
# ============================================================================

fn parse_block_ops parser:mut$Parser cursor:mut$TokenCursor function_name:$str -> List[Op] {
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or = open_token
    List[Op]::new = ops
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            open_token Token::location "Unclosed block" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            ops return
        fi
        token_opt.unwrap = token
        if TokenKind::Comment token Token::kind == then
            continue
        fi
        if TokenKind::Newline token Token::kind == then
            continue
        fi
        if "}" token Token::value.as_str == then
            ops return
        fi
        if TokenKind::FstringStart token Token::kind == then
            ops function_name cursor token parser handle_fstring
            continue
        fi
        ops function_name cursor token parser token_to_op
    done
    ops
}

# ============================================================================
# handle_fstring - parse f-string tokens into ops
# ============================================================================

fn parse_fstring_expr parser:mut$Parser cursor:mut$TokenCursor function_name:$str -> List[Op] {
    List[Op]::new = ops
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            break
        fi
        token_opt.unwrap = token
        if TokenKind::FstringExprEnd token Token::kind == then
            break
        fi
        if TokenKind::FstringStart token Token::kind == then
            ops function_name cursor token parser handle_fstring
            continue
        fi
        ops function_name cursor token parser token_to_op
    done
    if parser.syntax_only then
        parser.state.flush_accessor_chain
    fi
    ops
}

fn handle_fstring
    parser:mut$Parser
    start_token:Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$List[Op]
{
    if parser.syntax_only then
        parser.state.flush_accessor_chain
    fi
    0 (u64) = part_count
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            break
        fi
        token_opt.unwrap = token
        if TokenKind::FstringText token Token::kind == then
            token Token::location token Token::value.clone OpValue::PushStr Op::new ops.push
            token Token::location.clone OpValue::FstringToStr Op::new ops.push
            1 += part_count
        elif TokenKind::FstringExprStart token Token::kind == then
            function_name cursor parser parse_fstring_expr = expr_ops
            token Token::location.clone OpValue::FstringToStr Op::new expr_ops.push
            f"lambda__{function_name}_o{token Token::location Location::span Span::offset}" = lambda_name
            token Token::location.clone expr_ops lambda_name.clone Function::new = lambda_function
            true lambda_function Function::set_captures_shared
            lambda_function lambda_name.clone parser.put_function
            token Token::location.clone lambda_name OpValue::FnPush Op::new ops.push
            token Token::location.clone OpValue::FnExec Op::new ops.push
            1 += part_count
        elif TokenKind::FstringEnd token Token::kind == then
            break
        fi
    done
    if 0 part_count == then
        start_token Token::location "".to_str OpValue::PushStr Op::new ops.push
        start_token Token::location.clone OpValue::FstringToStr Op::new ops.push
        1 (u64) = part_count
    fi
    if 1 part_count > then
        start_token Token::location part_count OpValue::FstringConcat Op::new ops.push
    fi
}

# ============================================================================
# get_op_delimiter - convert delimiter token to op
# ============================================================================

fn get_op_delimiter
    parser:mut$Parser
    token:$Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$List[Op]
{
    token Token::value.as_str = value: $str

    # Dot . method
    if "." value.as_str == then
        parser.state cursor expect_function_name = method_token
        if parser.syntax_only then
            method_token Token::location Location::span Span::offset
            token Token::location Location::span Span::offset
            parser.state.record_accessor
        fi
        method_token Token::location method_token Token::value.clone OpValue::MethodCall Op::new ops.push
        return
    fi

    # Open brace { -> lambda
    if "{" value.as_str == then
        cursor.retreat
        f"lambda__{function_name}_o{token Token::location Location::span Span::offset}" = lambda_name
        lambda_name.as_str cursor parser parse_block_ops = lambda_ops
        token Token::location.clone lambda_ops lambda_name.clone Function::new = lambda_function
        lambda_function lambda_name.clone parser.put_function
        token Token::location lambda_name OpValue::FnPush Op::new ops.push
        return
    fi

    # Open bracket [ -> array literal
    if "[" value.as_str == then
        cursor.retreat
        cursor function_name parser get_op_array ops.push
        return
    fi

    # Open paren ( -> type cast
    if "(" value.as_str == then
        cursor.retreat
        parser.state cursor get_op_type_cast ops.push
        return
    fi

    # Other delimiters (comma, colon, close brace/bracket/paren, fat arrow, hashtag)
    # are ignored or handled by their enclosing constructs
}

# ============================================================================
# _try_parse_is_check - try parsing Enum::Variant is
# ============================================================================

fn try_parse_is_check token:$Token cursor:mut$TokenCursor -> Option[Op] {
    cursor.save = saved_pos
    List[String]::new = bindings

    # Check for bindings: Enum::Variant(a b) is
    false = has_bindings
    if cursor.peek Option::Some(peek_token) is then
        "(" peek_token Token::value.as_str == = has_bindings
    else
        Option[Op]::None return
    fi
    if has_bindings then
        cursor.pop drop # consume (
        while true do
            if cursor.peek Option::Some(inner) is then
                if ")" inner Token::value.as_str == then
                    cursor.pop drop # consume )
                    if 0 bindings.length == then
                        saved_pos cursor.restore
                        Option::None return
                    fi
                    break
                fi
                if TokenKind::Identifier inner Token::kind != then
                    saved_pos cursor.restore
                    Option::None return
                fi
                cursor.pop drop
                inner Token::value.clone bindings.push
            else
                saved_pos cursor.restore
                Option::None return
            fi
        done
    fi

    # Check if next token is `is`
    if cursor.peek Option::Some(is_token) is then
        if "is" is_token Token::value.as_str != then
            saved_pos cursor.restore
            Option::None return
        fi
    else
        saved_pos cursor.restore
        Option::None return
    fi
    cursor.pop drop # consume `is`

    # Split token value on ::
    token Token::value.as_str "::" str::find = separator
    token Token::value.as_str 0 separator (u64) str::substring = enum_name
    token Token::value.as_str separator 2 + (u64) token Token::value.as_str.length separator (u64) - 2 - str::substring = variant_name

    Option::None variant_name enum_name EnumVariant::new = variant
    bindings variant EnumVariant::set_bindings
    token Token::location variant OpValue::IsCheck Op::new = parsed_is
    parsed_is Option::Some
}

# ============================================================================
# _require_global_scope
# ============================================================================

fn require_global_scope function_name:$str what:str location:$Location parser:mut$Parser {
    if GLOBAL_SCOPE_LABEL function_name != then
        location f"{what} should be defined in the global scope" ErrorKind::InvalidScope parser.state.record_error_string
    fi
}

# ============================================================================
# parse_type_variables - parse [T, K: Hashable] type variable lists
# ============================================================================

struct ParsedTypeVariables {
    names:        List[String]
    trait_bounds: Map[String List[TraitBound]]
    const_params: Map[String BuiltinType]
}

impl ParsedTypeVariables {
    fn into_parts
        self:ParsedTypeVariables
    -> List[String] Map[String List[TraitBound]] Map[String BuiltinType] {
        self match
            ParsedTypeVariables { names: names trait_bounds: trait_bounds const_params: const_params } => names trait_bounds const_params
        end
    }
}
# Parse the `[arg1 arg2 ...]` type argument list that follows a generic trait
# name in a trait bound (e.g. `I: Iterable[i64]`). The caller has already
# consumed the trait identifier. If the next token is not `[`, returns an
# empty list. Otherwise parses each argument as a Type AST value.

fn parse_bound_type_args
    cursor:mut$TokenCursor
    trait_token:$Token
    state:mut$ParseState
-> List[Type] {
    List[Type]::new = bound_args
    cursor.peek = bracket_opt
    if bracket_opt.is_none then
        bound_args return
    fi
    if bracket_opt Option::Some(bracket) is then
        if "[" bracket Token::value.as_str != then
            bound_args return
        fi
    fi
    cursor.pop drop
    while true do
        cursor.peek = argument_token_option
        if argument_token_option.is_none then
            trait_token Token::location "Unclosed trait bound type argument list" ErrorKind::Syntax state.record_error
            state.mark_output_unusable
            bound_args return
        fi
        argument_token_option.unwrap Token::value.as_str = argument_value: $str
        if "]" argument_value.as_str == then
            cursor.pop drop
            bound_args return
        fi
        if "," argument_value.as_str == then
            cursor.pop drop
            continue
        fi
        state cursor parse_type_ast bound_args.push
    done
    bound_args
}

fn trait_bound_method_effect
    type_variable:$str
    method:$TraitMethod
    bound:$TraitBound
    casa_trait:$CasaTrait
-> StackEffect {
    casa_trait bound make_bound_substitutions = substitutions
    0 (u64) = method_type_index
    for method_type_variable in method.type_vars.iter do
        f"__method_type_{method_type_index}" Type::TypeVar
        method_type_variable.clone substitutions.set
        1 += method_type_index
    done
    type_variable.to_str Type::TypeVar method.stack_effect resolve_trait_stack_effect = effect
    substitutions effect apply_type_subs_to_stack_effect
}

fn stack_effect_shapes_equal first:$StackEffect second:$StackEffect -> bool {
    if first.parameters.length second.parameters.length != then
        false return
    fi
    if first.return_types.length second.return_types.length != then
        false return
    fi
    for
        pair in second.parameters.iter first
            .parameters
            .iter
            .zip
    do
        if
            pair.second.typ pair
                .first
                .typ
                .eq !
        then
            false return
        fi
    done
    for
        pair in second.return_types.iter first
            .return_types
            .iter
            .zip
    do
        if pair.second pair.first.eq ! then
            false return
        fi
    done
    true
}

fn bound_is_compatible
    parser:mut$Parser
    type_variable:$str
    existing_bounds:$List[TraitBound]
    candidate:$TraitBound
-> bool {
    candidate.name parser
        .store
        .traits
        .get = candidate_trait_opt
    if candidate_trait_opt.is_none then
        false return
    fi
    candidate_trait_opt.unwrap = candidate_trait
    candidate_trait parser.store collect_trait_methods = candidate_methods
    for candidate_method in candidate_methods.iter do
        candidate_trait candidate candidate_method type_variable trait_bound_method_effect
        = candidate_effect
        for existing_bound in existing_bounds.iter do
            existing_bound.name parser
                .store
                .traits
                .get = existing_trait_opt
            if existing_trait_opt.is_none then
                continue
            fi
            existing_trait_opt.unwrap = existing_trait
            existing_trait parser.store collect_trait_methods = existing_methods
            for existing_method in existing_methods.iter do
                if existing_method.name candidate_method.name != then
                    continue
                fi
                existing_trait existing_bound existing_method type_variable trait_bound_method_effect
                = existing_effect
                if candidate_effect existing_effect stack_effect_shapes_equal ! then
                    false return
                fi
            done
        done
    done
    true
}

fn parse_type_variables parser:mut$Parser cursor:mut$TokenCursor -> ParsedTypeVariables {
    fallback_token parser.state "[" cursor expect_token_value.unwrap_or drop
    List[String]::new = vars
    Set[String]::new = seen
    Map[String List[TraitBound]]::new = trait_bounds
    Map[String BuiltinType]::new = const_params

    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            empty_location "Expected `]` to close type parameters" ErrorKind::Syntax parser.state.record_error
            parser.state.mark_output_unusable
            const_params trait_bounds vars ParsedTypeVariables return
        fi
        token_opt.unwrap = token
        if "]" token Token::value.as_str == then
            if 0 vars.length == then
                token Token::location "Empty type parameter list `[]` is not allowed" ErrorKind::Syntax parser.state.record_error
            fi
            const_params trait_bounds vars ParsedTypeVariables return
        fi
        if "," token Token::value.as_str == then
            continue
        fi
        # `const NAME:TYPE` binds a compile-time constant, not a type variable
        # (ADR-0152).
        if "const" token Token::value.as_str == then
            const_params seen vars parser cursor parse_const_type_parameter = const_params
            continue
        fi
        if TokenKind::Identifier token Token::kind == then
            if
                token Token::value.as_str parser
                    .store
                    .builtins
                    .has_str
            then
                token Token::location f"Type variable `{token Token::value.as_str}` shadows built-in type" ErrorKind::DuplicateName parser.state.record_error_string
            fi
            if token Token::value.as_str seen.has_str then
                token Token::location f"Duplicate type variable `{token Token::value.as_str}`" ErrorKind::DuplicateName parser.state.record_error_string
            fi
            token Token::value.clone vars.push
            token Token::value.clone seen.add
            # Check for trait bounds: K: Hashable + Display
            cursor.peek = colon_opt
            if colon_opt Option::Some(colon) is then
                if ":" colon Token::value.as_str == then
                    cursor.pop drop # consume :
                    List[TraitBound]::new = bounds
                    true = parse_bounds
                    while parse_bounds do
                        fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = trait_token
                        trait_token Token::value.clone = bound_trait_name
                        bound_trait_name parser
                            .store
                            .traits
                            .get = bound_trait_def_opt
                        if bound_trait_def_opt.is_none parser.syntax_only ! && then
                            trait_token Token::location f"Trait `{bound_trait_name}` is not defined" ErrorKind::UndefinedName parser.state.record_error_string
                        fi
                        parser.state trait_token cursor parse_bound_type_args = bound_args
                        if bound_trait_def_opt Option::Some(bound_trait_def) is then
                            bound_trait_def CasaTrait::type_params = declared_params: $List[String]
                            if bound_args.length declared_params.length != then
                                trait_token Token::location f"Trait `{bound_trait_name}` expects {declared_params.length} type argument(s), got {bound_args.length}" ErrorKind::Syntax parser.state.record_error_string
                            fi
                            bound_args bound_trait_name TraitBound = parsed_bound
                            false = duplicate_bound
                            for existing_bound in bounds.iter do
                                if parsed_bound existing_bound trait_bound_eq then
                                    true = duplicate_bound
                                fi
                            done
                            if duplicate_bound ! then
                                if parsed_bound bounds token.value.as_str parser bound_is_compatible ! then
                                    trait_token.location f"Bounds on `{token.value}` have incompatible requirements for the same method" ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                                fi
                                parsed_bound bounds.push
                            fi
                        elif parser.syntax_only then
                            bound_args bound_trait_name TraitBound bounds.push
                        fi
                        cursor.peek = plus_opt
                        if plus_opt Option::Some(plus) is then
                            if "+" plus.value.as_str == then
                                cursor.pop drop
                            else
                                false = parse_bounds
                            fi
                        else
                            false = parse_bounds
                        fi
                    done
                    bounds token.value.clone trait_bounds.set
                fi
            fi
        else
            token Token::location "Unexpected token in type parameters" ErrorKind::UnexpectedToken parser.state.record_error
        fi
    done
    const_params trait_bounds vars ParsedTypeVariables
}
# Parse `const NAME:TYPE` (the `const` keyword already consumed). Adds NAME to
# `vars`/`seen` so it keeps its slot among the type parameters, and maps it to
# its declared type (ADR-0152).

fn parse_const_type_parameter
    cursor:mut$TokenCursor
    parser:mut$Parser
    vars:mut$List[String]
    seen:mut$Set[String]
    const_params:Map[String BuiltinType]
-> Map[String BuiltinType] {
    fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token
    if
        name_token Token::value.as_str parser
            .store
            .builtins
            .has_str
    then
        name_token Token::location f"Constant parameter `{name_token Token::value.as_str}` shadows built-in type" ErrorKind::DuplicateName parser.state.record_error_string
    fi
    if name_token Token::value.as_str seen.has_str then
        name_token Token::location f"Duplicate type variable `{name_token Token::value.as_str}`" ErrorKind::DuplicateName parser.state.record_error_string
    fi
    name_token Token::value.clone vars.push
    name_token Token::value.clone seen.add
    fallback_token parser.state ":" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = type_token
    type_token Token::value.as_str parse_builtin = builtin_opt
    if builtin_opt Option::Some(const_builtin) is then
        if const_builtin const_type_parameter_type_allowed ! then
            type_token Token::location f"Constant parameter `{name_token Token::value.as_str}` cannot have type `{type_token Token::value.as_str}`: only integer, `bool`, and `char` constants are allowed" ErrorKind::Syntax parser.state.record_error_string
        fi
        const_builtin name_token Token::value.clone const_params.set
        const_params return
    fi
    type_token Token::location f"Constant parameter `{name_token Token::value.as_str}` has unknown type `{type_token Token::value.as_str}`" ErrorKind::Syntax parser.state.record_error_string
    const_params
}
# Builtin types allowed as a constant parameter (ADR-0153): integer widths,
# `bool`, `char`. Float and `str` are rejected — neither can select an
# instantiation (ADR-0012 for floats).

fn const_type_parameter_type_allowed builtin:$BuiltinType -> bool {
    if builtin.is_integer then
        true return
    fi
    builtin BuiltinType::Bool == builtin BuiltinType::Char == ||
}
# Rewrite const-parameter names in a type from type variables to symbolic
# constants (ADR-0152). `parse_type_str` reads a one-letter name as `TypeVar`
# and a longer one as a bare `Generic`, so both forms are handled.

fn rewrite_type_const_params typ:$Type const_params:$Map[String BuiltinType] -> Type {
    typ match
        Type::TypeVar(name) => {
            if name const_params.get_copy Option::Some(type_var_builtin) is then
                type_var_builtin name.clone ConstType::symbolic Type::Const
            else
                typ clone_type
            fi
        }
        Type::Generic(generic) => {
            if 0 generic.params.length == then
                if generic.base const_params.get_copy Option::Some(bare_builtin) is then
                    bare_builtin generic.base.clone ConstType::symbolic Type::Const return
                fi
                typ clone_type return
            fi
            List[Type]::new = new_params
            for param in generic.params.iter do
                const_params param rewrite_type_const_params new_params.push
            done
            new_params generic.base.clone GenericType Type::Generic
        }
        Type::Function(fn_type) => {
            List[Type]::new = new_params
            for param in fn_type.parameters.iter do
                const_params param rewrite_type_const_params new_params.push
            done
            List[Type]::new = new_returns
            for ret in fn_type.return_types.iter do
                const_params ret rewrite_type_const_params new_returns.push
            done
            new_returns new_params FunctionType Type::Function
        }
        _ => {
            typ clone_type
        }
    end
}
# Apply `rewrite_type_const_params` to every parameter and return type of a
# stack effect (ADR-0152).

fn rewrite_stack_effect_constant_parameters
    effect:mut$StackEffect
    constant_parameters:$Map[String BuiltinType]
{
    List[Parameter]::new = new_parameters
    for parameter in effect.parameters.iter do
        constant_parameters parameter.typ rewrite_type_const_params = rewritten_type
        parameter.name.clone rewritten_type Parameter new_parameters.push
    done
    List[Type]::new = new_return_types
    for return_type in effect.return_types.iter do
        constant_parameters return_type rewrite_type_const_params new_return_types.push
    done
    new_parameters effect StackEffect::set_parameters
    new_return_types effect StackEffect::set_return_types
}
# Rewrite constant-parameter names in a body's cast and hint types so they read
# as constants rather than unknown type names (ADR-0152).

fn rewrite_operation_constant_parameters
    operations:mut$List[Op]
    constant_parameters:$Map[String BuiltinType]
{
    if 0 constant_parameters.keys.length == then
        return
    fi
    Map[String Type]::new = substitutions
    for constant_name in constant_parameters.keys.iter do
        constant_name constant_parameters.get.unwrap constant_name.clone ConstType::symbolic Type::Const
        constant_name.clone substitutions.set
    done
    substitutions operations substitute_ops_types
}
# Prepend a hidden parameter for every constant type parameter and return the
# assignments that bind each one to its source-level name (ADR-0152). A call
# site pushes the concrete constant, so the body reads it like any other
# parameter. The caller appends the assignments after the hidden trait-pointer
# assignments so the pop order matches the parameter order.

fn inject_constant_parameters
    effect:mut$StackEffect
    variables:mut$List[Variable]
    location:Location
-> List[Op] {
    List[Op]::new = assignments
    effect.const_params = constant_parameters: $Map[String BuiltinType]
    if 0 constant_parameters.keys.length == then
        assignments return
    fi
    List[Parameter]::new = new_parameters
    for constant_name in constant_parameters.keys.iter do
        constant_name constant_parameters.get.unwrap Type::Builtin = constant_type
        constant_name.as_str make_hidden_const_parameter_name constant_type clone_type Parameter::named new_parameters.push
        constant_type clone_type constant_name.clone Variable variables.push
        location.clone constant_name.clone OpValue::AssignVar Op::new = assignment
        constant_type clone_type Option::Some assignment Op::set_type_hint
        assignment assignments.push
    done
    0 (u64) = parameter_index
    while parameter_index effect.parameters.length > do
        parameter_index effect.parameters.get clone_parameter new_parameters.push
        1 += parameter_index
    done
    new_parameters effect StackEffect::set_parameters
    assignments
}

# ============================================================================
# parse_parameters - parse name:type parameter pairs
# ============================================================================
# Given an identifier `token` just popped from `cursor`, produce either a
# named parameter (`name:type`) if the next token is `:`, or an unnamed
# parameter by rewinding and re-parsing as a type expression.

fn parse_parameter_maybe_named
    cursor:mut$TokenCursor
    token:$Token
    state:mut$ParseState
-> Parameter {
    cursor.peek = next_opt
    if { Token::value.as_str ":" == } next_opt.filter.is_some then
        cursor.advance # consume :
        state cursor parse_type_ast = param_type
        token Token::value.clone param_type Parameter::named return
    fi
    cursor.retreat
    "".to_str state cursor parse_type_ast Parameter::named
}

fn parse_parameters cursor:mut$TokenCursor state:mut$ParseState -> List[Parameter] {
    List[Parameter]::new = params
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            empty_location "Unexpected end of input" ErrorKind::UnexpectedToken state.record_error
            state.mark_output_unusable
            params return
        fi
        token_opt.unwrap = token

        # Stop at -> or {
        if "->" token Token::value.as_str == "{" token Token::value.as_str == || then
            cursor.retreat
            params return
        fi

        # Allow fn keyword as unnamed parameter type
        if "fn" token Token::value.as_str == then
            cursor.retreat
            "".to_str state cursor parse_type_ast Parameter::named params.push
            continue
        fi

        if TokenKind::Identifier token Token::kind != then
            token Token::location "Unexpected token in parameter list" ErrorKind::UnexpectedToken state.record_error
        fi

        state token cursor parse_parameter_maybe_named params.push
    done
    params
}

# ============================================================================
# parse_return_types - parse return types after ->
# ============================================================================

fn parse_return_types cursor:mut$TokenCursor state:mut$ParseState -> List[Type] {
    List[Type]::new = types
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            empty_location "Unexpected end of input" ErrorKind::UnexpectedToken state.record_error
            state.mark_output_unusable
            types return
        fi
        if peek_opt Option::Some(peek) is then
            if "{" peek Token::value.as_str == then
                types return
            fi
        fi
        state cursor parse_type_ast types.push
    done
    types
}

# ============================================================================
# parse_stack_effect - parse function stack effect
# ============================================================================

fn parse_stack_effect cursor:mut$TokenCursor state:mut$ParseState -> StackEffect {
    state cursor parse_parameters = params
    List[Type]::new = returns

    cursor.peek = next_opt
    if next_opt.is_none then
        empty_location "Unexpected end of input" ErrorKind::UnexpectedToken state.record_error
        state.mark_output_unusable
        returns params StackEffect::new return
    fi
    if next_opt Option::Some(next) is then
        if "->" next Token::value.as_str == then
            cursor.advance # consume ->
            state cursor parse_return_types = returns
        fi
    fi
    returns params StackEffect::new
}

# ============================================================================
# build_hidden_trait_methods - shared hidden-param construction
# ============================================================================
#
# Walks the given trait bounds and returns a flat list of (var_name, fn_type)
# pairs describing each hidden `__trait_{type_var}_{method}` parameter that
# must be injected. The language comparison traits include their defaults so
# generic operators can call them before their type arguments are known.
# Used by both parse_function and inject_implementation_parameters.
# Bounds whose trait is not registered in the store are silently skipped,
# matching the pre-extraction behavior of both call sites.

fn build_hidden_trait_methods
    parser:mut$Parser
    trait_bounds:mut$Map[String List[TraitBound]]
-> List[HiddenTraitMethod] {
    List[HiddenTraitMethod]::new = result
    trait_bounds.keys = bound_keys
    for bound_type_var in bound_keys.iter do
        Set[String]::new = seen_methods
        for
            bound in bound_type_var trait_bounds
                .get
                .unwrap
                .iter
        do
            bound TraitBound::name parser
                .store
                .traits
                .get = bound_trait_opt
            if bound_trait_opt.is_none then
                continue
            fi
            bound_trait_opt.unwrap = bound_trait
            bound.name.as_str "PartialEq" ==
            bound.name.as_str "Eq" == ||
            bound.name.as_str "PartialOrd" == ||
            bound.name.as_str "Ord" == || = include_defaults
            # Build substitution map from trait's declared type_params to the
            # concrete type_args carried on the bound.
            Map[String Type]::new = bound_subs
            bound_trait CasaTrait::type_params = bhtm_params: $List[String]
            bound TraitBound::type_args = bhtm_args: $List[Type]
            if bhtm_params.length bhtm_args.length == then
                for pair in bhtm_args.iter bhtm_params.iter.zip do
                    pair.second clone_type pair.first.clone bound_subs.set
                done
            fi
            bound_trait parser.store collect_trait_methods = bound_methods
            for bound_method in bound_methods.iter do
                if
                    0 bound_method TraitMethod::default_ops.length ==
                    include_defaults ||
                    bound_method.name seen_methods.has ! &&
                then
                    bound_method.name.clone seen_methods.add
                    f"__trait_{bound_type_var}_{bound_method TraitMethod::name}" = hidden_name
                    bound_subs bound_type_var.clone Type::TypeVar bound_method TraitMethod::stack_effect resolve_trait_stack_effect apply_type_subs_to_stack_effect = hidden_stack_effect
                    hidden_stack_effect stack_effect_to_function_type = hidden_type
                    hidden_type hidden_name HiddenTraitMethod result.push
                fi
            done
        done
    done
    result
}

# ============================================================================
# parse_literal_to_constant_value - parse a raw literal string to ConstantValue
# ============================================================================

fn parse_literal_to_constant_value raw:$str -> ConstantValue {
    if "true" raw == then
        1 ConstantValue::Bool return
    fi
    if "false" raw == then
        0 ConstantValue::Bool return
    fi
    if '"' 0 raw.at == then
        raw 1 raw.length 2 - str::substring ConstantValue::Str return
    fi
    if raw char_literal_codepoint Option::Some(codepoint) is then
        codepoint ConstantValue::Char return
    fi
    if raw is_float_literal then
        raw.to_str ConstantValue::Float return
    fi
    raw str_to_int raw.to_str IntegerLiteral::new ConstantValue::Int
}

# ============================================================================
# try_fold_const_fn_call - constant-fold a const fn call with all-literal args
# ============================================================================

fn is_const_fold_literal value:$OpValue -> bool {
    value OpValue::PushInt is
    value OpValue::PushFloat is ||
    value OpValue::PushStr is ||
    value OpValue::PushBool is ||
    value OpValue::PushChar is ||
}

fn try_fold_const_fn_call
    store:mut$SymbolStore
    ops:mut$List[Op]
    op_index:u64
    fn_name:$str
    location:$Location
    diagnostics:mut$Diagnostics
-> u64 {
    fn_name store.functions.get_str = fold_fn_opt
    if fold_fn_opt.is_none then
        op_index return
    fi
    fold_fn_opt.unwrap = fold_fn
    if fold_fn Function::is_const_fn ! then
        op_index return
    fi
    for
        parameter in fold_fn
            .stack_effect
            .parameters
            .iter
    do
        if parameter.typ.has_unresolved_type_var parameter.typ.has_unresolved || then
            op_index return
        fi
    done
    for
        return_type in fold_fn
            .stack_effect
            .return_types
            .iter
    do
        if return_type.has_unresolved_type_var return_type.has_unresolved || then
            op_index return
        fi
    done
    fold_fn Function::stack_effect StackEffect::parameters.length = fold_param_count
    op_index 1 - = call_idx
    call_idx fold_param_count - = first_arg_idx
    if 0 first_arg_idx > then
        op_index return
    fi
    first_arg_idx = check_idx
    while check_idx call_idx > do
        check_idx ops.get Op::value clone_op_value = check_val
        if check_val is_const_fold_literal ! then
            op_index return
        fi
        1 += check_idx
    done
    List[ConstantValue]::new = fold_stack
    List[String]::new = fold_eval_stack
    first_arg_idx = load_idx
    while load_idx call_idx > do
        load_idx ops.get Op::value clone_op_value = load_val
        if load_val OpValue::PushInt(li) is then
            li.value li.raw.clone IntegerLiteral::new ConstantValue::Int fold_stack.push
        elif load_val OpValue::PushFloat(float_literal) is then
            float_literal.clone ConstantValue::Float fold_stack.push
        elif load_val OpValue::PushStr(ls) is then
            ls.clone ConstantValue::Str fold_stack.push
        elif load_val OpValue::PushBool(lb) is then
            lb ConstantValue::Bool fold_stack.push
        elif load_val OpValue::PushChar(lc) is then
            lc ConstantValue::Char fold_stack.push
        fi
        1 += load_idx
    done
    fn_name.clone = eval_name
    if diagnostics fold_eval_stack location fold_stack eval_name store eval_const_fn ! then
        op_index return
    fi
    fold_stack.pop = fold_result
    fold_result match
        ConstantValue::Int(ri) => {
            ri OpValue::PushInt first_arg_idx ops.get_mut Op::set_value
        }
        ConstantValue::Float(float_result) => {
            float_result OpValue::PushFloat first_arg_idx ops.get_mut Op::set_value
        }
        ConstantValue::Str(rs) => {
            rs OpValue::PushStr first_arg_idx ops.get_mut Op::set_value
        }
        ConstantValue::Bool(rb) => {
            rb OpValue::PushBool first_arg_idx ops.get_mut Op::set_value
        }
        ConstantValue::Char(rc) => {
            rc OpValue::PushChar first_arg_idx ops.get_mut Op::set_value
        }
    end
    if
        1 fold_fn
            .stack_effect
            .return_types
            .length ==
    then
        0 fold_fn
            .stack_effect
            .return_types
            .get clone_type Option::Some
        first_arg_idx ops.get_mut Op::set_type_hint
    fi
    first_arg_idx 1 + = shift_dst
    call_idx 1 + = shift_src
    while shift_src ops.length > do
        shift_src ops.get clone_op shift_dst ops.set
        1 += shift_src
        1 += shift_dst
    done
    0 (u64) = pop_count
    while pop_count fold_param_count > do
        ops.pop drop
        1 += pop_count
    done
    first_arg_idx 1 +
}

# ============================================================================
# validate_const_fn_body - ensure const fn body has no disallowed ops
# ============================================================================

fn validate_const_fn_body function:mut$Function diagnostics:mut$Diagnostics {
    for op in function Function::ops.iter do
        op Op::value = v: $OpValue
        if v OpValue::IfStart is then
            op Op::location "Control flow (`if`) is not allowed in const fn" ErrorKind::Syntax diagnostics.record_error
        fi
        if v OpValue::WhileStart is then
            op Op::location "Control flow (`while`) is not allowed in const fn" ErrorKind::Syntax diagnostics.record_error
        fi
        if v OpValue::DeclareGlobal is then
            op Op::location "Global access is not allowed in const fn" ErrorKind::Syntax diagnostics.record_error
        fi
    done
}

# ============================================================================
# eval_const_block - compile-time evaluation of const { ... } expressions
# ============================================================================

fn validate_constant_numeric
    value:$ConstantValue
    target:$Type
    location:$Location
    diagnostics:mut$Diagnostics
-> bool {
    value match
        ConstantValue::Int(literal) => {
            if target.is_integer_type_t ! then
                location f"Integer literal `{literal.raw}` requires an integer context, got `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error_string
                false return
            fi
            if target literal.fits ! then
                target.get_integer_min = minimum
                target.get_integer_max = maximum
                location f"Integer literal `{literal.raw}` is outside `{target.format}` range {minimum}..{maximum}" ErrorKind::TypeMismatch diagnostics.record_error_string
                false return
            fi
        }
        ConstantValue::Float(literal) => {
            if target.is_float_type_t ! then
                location f"Floating-point literal `{literal}` requires `f32` or `f64` context, got `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error_string
                false return
            fi
        }
        _ => {
        }
    end
    true
}

fn const_eval_apply_operator
    stack:mut$List[ConstantValue]
    operator_kind:OperatorKind
    location:$Location
    diagnostics:mut$Diagnostics
{
    if operator_kind OperatorKind::Not == then
        if 0 stack.length == then
            location "Stack underflow in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
        stack.pop = a_val
        if a_val ConstantValue::Bool(a_bool) is then
            if 0 a_bool != then 0 else 1 fi ConstantValue::Bool stack.push
        elif a_val ConstantValue::Int(a_int) is then
            if diagnostics location TYPE_I64_T a_val validate_constant_numeric ! then
                0 IntegerLiteral::from_int ConstantValue::Int stack.push
                return
            fi
            if 0 a_int.value != then 0 else 1 fi ConstantValue::Bool stack.push
        else
            location "Operator `!` requires bool or i64 operand" ErrorKind::Syntax diagnostics.record_error
        fi
        return
    fi
    if operator_kind OperatorKind::BitNot == then
        if 0 stack.length == then
            location "Stack underflow in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
        stack.pop = bitnot_val
        if bitnot_val ConstantValue::Int(bitnot_int) is then
            if diagnostics location TYPE_I64_T bitnot_val validate_constant_numeric ! then
                0 IntegerLiteral::from_int ConstantValue::Int stack.push
                return
            fi
            bitnot_int.value ~ IntegerLiteral::from_int ConstantValue::Int stack.push
        else
            location "Operator `~` requires i64 operand" ErrorKind::Syntax diagnostics.record_error
        fi
        return
    fi
    if 2 stack.length < then
        location "Stack underflow in const expression" ErrorKind::Syntax diagnostics.record_error
    fi
    stack.pop = b_val
    stack.pop = a_val
    if a_val ConstantValue::Int(a_int) is then
        if b_val ConstantValue::Int(b_int) is then
            if
                diagnostics location TYPE_I64_T a_val validate_constant_numeric !
                diagnostics location TYPE_I64_T b_val validate_constant_numeric ! ||
            then
                0 IntegerLiteral::from_int ConstantValue::Int stack.push
                return
            fi
            if operator_kind OperatorKind::Plus == then
                a_int.value b_int.value + IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Minus == then
                a_int.value b_int.value - IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Mul == then
                a_int.value b_int.value * IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Div == then
                a_int.value b_int.value / IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Mod == then
                a_int.value b_int.value % IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Shl == then
                a_int.value b_int.value (u64) << IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Shr == then
                a_int.value b_int.value (u64) >> IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::BitAnd == then
                a_int.value b_int.value & IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::BitOr == then
                a_int.value b_int.value | IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::BitXor == then
                a_int.value b_int.value ^ IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Eq == then
                if a_int.value b_int.value == then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Ne == then
                if a_int.value b_int.value != then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Lt == then
                if a_int.value b_int.value < then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Le == then
                if a_int.value b_int.value <= then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Gt == then
                if a_int.value b_int.value > then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Ge == then
                if a_int.value b_int.value >= then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            location "Unsupported operator for i64 operands in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
    fi
    if a_val ConstantValue::Bool(a_bool) is then
        if b_val ConstantValue::Bool(b_bool) is then
            if operator_kind OperatorKind::And == then
                if 0 a_bool != 0 b_bool != && then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Or == then
                if 0 a_bool != 0 b_bool != || then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Eq == then
                if a_bool b_bool == then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Ne == then
                if a_bool b_bool != then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            location "Unsupported operator for bool operands in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
    fi
    location "Type mismatch in const expression" ErrorKind::Syntax diagnostics.record_error
}

fn eval_const_fn
    store:$SymbolStore
    fn_name:$str
    stack:mut$List[ConstantValue]
    location:$Location
    eval_stack:mut$List[String]
    diagnostics:mut$Diagnostics
-> bool {
    if fn_name eval_stack string_list_contains then
        location f"Cycle detected in const evaluation: `{fn_name}`" ErrorKind::Syntax diagnostics.record_error_string
        false return
    fi
    fn_name store.functions.get_str = fn_opt
    if fn_opt.is_none then
        location f"`{fn_name}` is not a const fn" ErrorKind::Syntax diagnostics.record_error_string
        false return
    fi
    fn_opt.unwrap = function: $Function
    if function Function::is_const_fn ! then
        location f"`{fn_name}` is not a const fn" ErrorKind::Syntax diagnostics.record_error_string
        false return
    fi
    fn_name.clone eval_stack.push_str
    function Function::stack_effect StackEffect::parameters.length = param_count
    List[ConstantValue]::new = fn_stack
    Map[String ConstantValue]::new = locals
    if param_count stack.length < then
        location f"Not enough arguments for const fn `{fn_name}`" ErrorKind::Syntax diagnostics.record_error_string
        false return
    fi
    0 (u64) = pi
    while pi param_count > do
        stack.pop = argument
        pi function
            .stack_effect
            .parameters
            .get
            .typ = parameter_type: $Type
        if diagnostics location parameter_type argument validate_constant_numeric ! then
            false return
        fi
        argument fn_stack.push
        1 += pi
    done
    function Function::ops = fn_ops: $List[Op]
    0 (u64) = oi
    while oi fn_ops.length > do
        oi fn_ops.get = fn_op
        1 += oi
        fn_op Op::value clone_op_value = op_value
        if op_value OpValue::PushInt(push_int) is then
            push_int.value push_int.raw.clone IntegerLiteral::new ConstantValue::Int fn_stack.push
            continue
        fi
        if op_value OpValue::PushFloat(push_float) is then
            push_float.clone ConstantValue::Float fn_stack.push
            continue
        fi
        if op_value OpValue::PushStr(push_str) is then
            push_str.clone ConstantValue::Str fn_stack.push
            continue
        fi
        if op_value OpValue::PushBool(push_bool) is then
            push_bool ConstantValue::Bool fn_stack.push
            continue
        fi
        if op_value OpValue::PushChar(push_char) is then
            push_char ConstantValue::Char fn_stack.push
            continue
        fi
        op_value op_value_to_operator_kind = eval_op_kind_opt
        if eval_op_kind_opt Option::Some(eval_op_kind) is then
            diagnostics fn_op Op::location eval_op_kind fn_stack const_eval_apply_operator
            continue
        fi
        if op_value OpValue::FnReturn is then
            break
        fi
        if op_value OpValue::FnCall(call_name) is then
            if diagnostics eval_stack fn_op Op::location fn_stack call_name.as_str store eval_const_fn ! then
                false return
            fi
            continue
        fi
        if op_value OpValue::AssignVar(assign_name) is then
            if 0 fn_stack.length != then
                fn_stack.pop assign_name.clone locals.set
            fi
            continue
        fi
        if op_value OpValue::PushVar(var_name) is then
            var_name.as_str locals.get_str = local_opt
            if local_opt Option::Some(local) is then
                local clone_constant_value fn_stack.push
                continue
            fi
            var_name.as_str store.constants.get_str = inner_const_opt
            if inner_const_opt Option::Some(inner_const) is then
                inner_const Constant::value clone_constant_value fn_stack.push
                continue
            fi
            fn_op Op::location f"Cannot use variable `{var_name}` in const fn evaluation" ErrorKind::Syntax diagnostics.record_error_string
            false return
        fi
        if op_value OpValue::Identifier(ident_name) is then
            ident_name.as_str locals.get_str = local_opt
            if local_opt Option::Some(local) is then
                local clone_constant_value fn_stack.push
                continue
            fi
            ident_name.as_str store.constants.get_str = inner_const_opt
            if inner_const_opt Option::Some(inner_const) is then
                inner_const Constant::value clone_constant_value fn_stack.push
                continue
            fi
            ident_name.as_str store.functions.get_str = inner_fn_opt
            if inner_fn_opt Option::Some(inner_fn) is then
                if inner_fn Function::is_const_fn then
                    if diagnostics eval_stack fn_op Op::location fn_stack ident_name.as_str store eval_const_fn ! then
                        false return
                    fi
                    continue
                fi
            fi
            fn_op Op::location f"Cannot use `{ident_name}` in const fn evaluation" ErrorKind::Syntax diagnostics.record_error_string
            false return
        fi
        fn_op Op::location "Unsupported operation in const fn" ErrorKind::Syntax diagnostics.record_error
        false return
    done
    eval_stack.pop drop
    if 0 fn_stack.length == then
        location f"Const fn `{fn_name}` produced no value" ErrorKind::Syntax diagnostics.record_error_string
        false return
    fi
    fn_stack.pop stack.push
    true
}

fn eval_const_block parser:mut$Parser cursor:mut$TokenCursor location:$Location -> ConstantValue {
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop
    List[ConstantValue]::new = stack
    List[String]::new = eval_stack
    while true do
        cursor.pop = tok_opt
        if tok_opt.is_none then
            location "Unclosed const block expression" ErrorKind::Syntax parser.state.record_error
            parser.state.mark_output_unusable
            0 IntegerLiteral::from_int ConstantValue::Int return
        fi
        tok_opt.unwrap = tok
        if "}" tok Token::value.as_str == then
            break
        fi
        if TokenKind::Comment tok Token::kind == then
            continue
        fi
        if TokenKind::Newline tok Token::kind == then
            continue
        fi
        if TokenKind::Literal tok Token::kind == then
            tok Token::value.as_str parse_literal_to_constant_value stack.push
            continue
        fi
        if TokenKind::Operator tok Token::kind == then
            tok Token::value.as_str operator_from_str = op_kind_opt
            if op_kind_opt Option::Some(op_kind) is then
                parser.state.diagnostics tok Token::location op_kind stack const_eval_apply_operator
            fi
            continue
        fi
        if TokenKind::Identifier tok Token::kind == then
            tok Token::value.as_str = ident: $str
            ident parser
                .store
                .constants
                .get_str = c_opt
            if c_opt Option::Some(casa_const) is then
                casa_const Constant::value clone_constant_value stack.push
                continue
            fi
            ident parser
                .store
                .functions
                .get_str = f_opt
            if f_opt Option::Some(function) is then
                if function Function::is_const_fn then
                    if
                        parser.state.diagnostics eval_stack tok Token::location stack ident parser.store eval_const_fn !
                    then
                        0 IntegerLiteral::from_int ConstantValue::Int return
                    fi
                    continue
                fi
            fi
            tok Token::location f"Cannot use `{ident}` in const block expression" ErrorKind::Syntax parser.state.record_error_string
        fi
        if TokenKind::Keyword tok Token::kind == then
            tok Token::location "Control flow is not allowed in const block expressions" ErrorKind::Syntax parser.state.record_error
        fi
        tok Token::location f"Unexpected token in const block expression: `{tok Token::value.as_str}`" ErrorKind::Syntax parser.state.record_error_string
    done
    if 0 stack.length == then
        location "Const block expression produced no value" ErrorKind::Syntax parser.state.record_error
        0 IntegerLiteral::from_int ConstantValue::Int return
    fi
    stack.pop
}

# ============================================================================
# parse_function - parse function definition
# ============================================================================

fn expect_function_name cursor:mut$TokenCursor state:mut$ParseState -> Token {
    if cursor.peek Option::Some(token) is then
        if "drop" token.value.as_str == then
            cursor.pop.unwrap return
        fi
    fi
    fallback_token state TokenKind::Identifier cursor expect_token_kind.unwrap_or
}

fn parse_function parser:mut$Parser cursor:mut$TokenCursor -> Function {
    fallback_token parser.state "fn" cursor expect_token_value.unwrap_or = fn_token
    parser.state cursor expect_function_name = name_token

    # Parse optional type parameters
    List[String]::new = type_vars
    Map[String List[TraitBound]]::new = trait_bounds
    Map[String BuiltinType]::new = const_params
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value.as_str == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.into_parts = const_params = trait_bounds = all_type_param_names
            # `names` mixes type variables and const parameters; keep only the
            # type variables here (ADR-0152).
            for candidate_name in all_type_param_names.iter do
                if candidate_name const_params.has ! then
                    candidate_name.clone type_vars.push
                fi
            done
        fi
    fi

    parser.state cursor parse_stack_effect = effect

    # Rewrite signature const params to symbolic constants so unification treats
    # them as constants, not type variables (ADR-0152).
    if 0 const_params.keys.length != then
        const_params effect rewrite_stack_effect_constant_parameters
    fi

    # Add type vars to the stack effect
    if 0 type_vars.length != then
        for type_var in type_vars.iter do
            type_var.clone effect StackEffect::type_vars.add
        done
        trait_bounds effect StackEffect::set_trait_bounds
    fi
    type_vars string_list_to_set = function_type_vars
    function_type_vars effect canonicalize_stack_effect_type_vars
    List[Op]::new = ops
    List[Variable]::new = variables

    const_params effect StackEffect::set_const_params

    # Constant parameters become hidden parameters the call site pushes
    # (ADR-0152). Prepend them before the trait pointers so the assignment
    # order below matches the parameter order.
    name_token Token::location.clone variables effect inject_constant_parameters = constant_assignments

    # Inject hidden __trait_* parameters for trait-bounded type vars
    if 0 effect StackEffect::trait_bounds.keys.length != then
        List[Parameter]::new = hidden_params
        effect StackEffect::trait_bounds parser build_hidden_trait_methods = hidden_methods
        for hidden in hidden_methods.iter do
            hidden HiddenTraitMethod::var_name = hidden_name: $String
            hidden HiddenTraitMethod::fn_type = hidden_type: $Type
            hidden_name.clone hidden_type clone_type Parameter::named hidden_params.push
            hidden_type clone_type hidden_name.clone Variable variables.push
            name_token Token::location hidden_name.clone OpValue::AssignVar Op::new = hidden_assign
            hidden_type clone_type Option::Some hidden_assign Op::set_type_hint
            hidden_assign ops.push
        done
        # Prepend hidden params to stack effect parameters
        0 (u64) = effect_param_index
        while effect_param_index effect StackEffect::parameters.length > do
            effect_param_index effect StackEffect::parameters.get clone_parameter hidden_params.push
            1 += effect_param_index
        done
        hidden_params effect StackEffect::set_parameters
    fi
    constant_assignments ops.append

    # Register named parameters as variables and generate assign ops
    for parameter in effect.parameters.iter do
        if "" parameter.name.as_str != then
            if parameter.name.as_str is_hidden_parameter_name ! then
                parameter.typ clone_type parameter.name.clone Variable variables.push
                name_token.location parameter.name.clone OpValue::AssignVar Op::new ops.push
            fi
        fi
    done

    name_token Token::value.as_str cursor parser parse_block_ops = body_ops
    function_type_vars body_ops canonicalize_operation_type_vars
    effect.const_params body_ops rewrite_operation_constant_parameters
    body_ops ops.append

    if parser.syntax_only then
        cursor.previous_offset
        fn_token Token::location Location::span Span::offset
        SyntaxSpanKind::Definition parser.state.record_span
    fi

    effect name_token Token::location.clone ops name_token Token::value.clone Function::with_stack_effect = function
    variables function Function::set_variables
    function
}

# ============================================================================
# parse_enum - parse enum definition
# ============================================================================

fn parse_derived_traits cursor:mut$TokenCursor state:mut$ParseState -> List[String] {
    List[String]::new = derived_traits
    if cursor.peek Option::Some(token) is then
        if "derives" token.value.as_str != then
            derived_traits return
        fi
        cursor.pop drop
        while true do
            if cursor.peek Option::Some(derived) is then
                if "{" derived.value.as_str == then
                    break
                fi
                fallback_token state TokenKind::Identifier cursor expect_token_kind.unwrap_or
                Token::value.clone derived_traits.push
            else
                break
            fi
        done
    fi
    derived_traits
}

fn parse_enum parser:mut$Parser cursor:mut$TokenCursor -> CasaEnum {
    fallback_token parser.state "enum" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    # Parse optional type parameters
    List[String]::new = type_vars
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value.as_str == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.into_parts = parsed_const_params = parsed_bounds = type_vars
            parsed_const_params drop
            parsed_bounds drop
        fi
    fi

    parser.state cursor parse_derived_traits = derived_traits

    fallback_token parser.state "{" cursor expect_token_value.unwrap_or = enum_open_token
    List[String]::new = variants
    Map[String List[Type]]::new = variant_types
    Map[String Location]::new = variant_locations

    while true do
        fallback_token parser.state cursor expect_token.unwrap_or = variant_token
        if "}" variant_token Token::value.as_str == then
            if parser.syntax_only then
                variant_token Token::location Location::span Span::offset
                enum_open_token Token::location Location::span Span::offset
                SyntaxSpanKind::EnumBody parser.state.record_span
            fi
            break
        fi
        if TokenKind::Identifier variant_token Token::kind != then
            variant_token Token::location "Expected variant name" ErrorKind::UnexpectedToken parser.state.record_error
        fi
        if variant_token Token::value.as_str variants string_list_contains then
            variant_token Token::location f"Duplicate variant `{variant_token Token::value.as_str}`" ErrorKind::DuplicateName parser.state.record_error_string
        fi
        variant_token Token::value.clone variants.push
        variant_token Token::location.clone variant_token Token::value.clone variant_locations.set

        # Parse optional inner types: Variant(type1 type2)
        List[Type]::new = inner_types
        cursor.peek = paren_opt
        if paren_opt Option::Some(paren) is then
            if "(" paren Token::value.as_str == then
                cursor.pop drop # consume (
                while true do
                    cursor.peek = inner_opt
                    if inner_opt.is_none then
                        variant_token Token::location "Unexpected end of input in variant inner types" ErrorKind::UnexpectedToken parser.state.record_error
                        parser.state.mark_output_unusable
                        break
                    fi
                    if inner_opt Option::Some(inner) is then
                        if ")" inner Token::value.as_str == then
                            cursor.pop drop # consume )
                            break
                        fi
                    fi
                    parser.state cursor parse_type_ast inner_types.push
                done
                if 0 inner_types.length == then
                    variant_token Token::location "Variant inner types cannot be empty" ErrorKind::Syntax parser.state.record_error
                fi
            fi
        fi
        inner_types variant_token Token::value.clone variant_types.set
    done

    if 0 variants.length == then
        name_token Token::location "Enum must have at least one variant" ErrorKind::Syntax parser.state.record_error
    fi

    type_vars string_list_to_set = tv_set
    for variant_name in variants.iter do
        variant_name variant_types.get_mut = vt_opt
        if vt_opt.is_some then
            vt_opt.unwrap = vt_inner
            0 (u64) = vt_index
            while vt_index vt_inner.length > do
                tv_set vt_index vt_inner.get clone_type canonicalize_type_var vt_index vt_inner.set
                1 += vt_index
            done
        fi
    done

    variant_locations derived_traits type_vars variant_types name_token Token::location.clone variants
    name_token Token::value.clone CasaEnum
}

# ============================================================================
# Auto-derive Hashable for payload-free enums (#141). Skips enums with inner
# values and any name the user already defined (silent override).
# ============================================================================

fn synthesize_hashable_for_enum parser:mut$Parser casa_enum:$CasaEnum {
    if casa_enum has_inner_values then
        return
    fi
    casa_enum CasaEnum::name.clone = enum_name
    casa_enum CasaEnum::location.clone = location

    f"{enum_name}::hash" = hash_name
    if
        hash_name parser
            .store
            .functions
            .get
            .is_none
    then
        List[Op]::new = hash_ops
        location.clone TYPE_I64_T clone_type OpValue::TypeCast Op::new hash_ops.push
        List[Parameter]::new = hash_params
        SHARED_BORROW_TYPE enum_name.clone GenericType::new Type::Generic
        apply_borrow_type Parameter::new hash_params.push
        List[Type]::new = hash_returns
        TYPE_I64_T clone_type hash_returns.push
        hash_returns hash_params StackEffect::new = hash_stack_effect
        hash_stack_effect location.clone hash_ops hash_name.clone Function::with_stack_effect = hash_fn
        hash_fn hash_name parser.put_function
    fi

    f"{enum_name}::eq" = eq_name
    if
        eq_name parser
            .store
            .functions
            .get
            .is_none
    then
        List[Op]::new = eq_ops
        location.clone OpValue::Eq Op::new eq_ops.push
        List[Parameter]::new = eq_params
        SHARED_BORROW_TYPE enum_name.clone GenericType::new Type::Generic
        apply_borrow_type Parameter::new eq_params.push
        SHARED_BORROW_TYPE enum_name.clone GenericType::new Type::Generic
        apply_borrow_type Parameter::new eq_params.push
        List[Type]::new = eq_returns
        TYPE_BOOL_T clone_type eq_returns.push
        eq_returns eq_params StackEffect::new = eq_stack_effect
        eq_stack_effect location.clone eq_ops eq_name.clone Function::with_stack_effect = eq_fn
        eq_fn eq_name parser.put_function
    fi

    if
        "Hashable" parser
            .store
            .traits
            .has_str
    then
        enum_name GenericType::new Type::Generic = receiver
        List[Type]::new "Hashable".to_str TraitBound = hashable_bound
        hashable_bound trait_bound_to_type = hashable_type
        if parser.store hashable_type receiver type_has_satisfying_trait_impl ! then
            location
            Map[String String]::new
            Map[String List[TraitBound]]::new
            List[String]::new
            hashable_bound
            receiver
            TraitImpl
            parser register_trait_impl
        fi
    fi
}

fn derive_hashable_for_enums parser:mut$Parser {
    for
        casa_enum in parser
            .store
            .enums
            .values
            .iter
    do
        casa_enum parser synthesize_hashable_for_enum
    done
}

fn register_derived_copy
    parser:mut$Parser
    name:$str
    type_vars:$List[String]
    required_type_vars:Set[String]
    location:$Location
{
    List[Type]::new = arguments
    for type_variable in type_vars.iter do
        type_variable.clone Type::TypeVar arguments.push
    done
    arguments name.to_str GenericType Type::Generic = receiver
    List[Type]::new "Copy".to_str TraitBound = copy_bound
    if parser.store copy_bound trait_bound_to_type receiver type_has_satisfying_trait_impl then
        return
    fi
    Map[String List[TraitBound]]::new = trait_bounds
    for type_variable in type_vars.iter do
        if type_variable required_type_vars.has ! then
            continue
        fi
        List[TraitBound]::new = type_bounds
        List[Type]::new "Copy".to_str TraitBound type_bounds.push
        type_bounds type_variable.clone trait_bounds.set
    done
    location.clone
    Map[String String]::new
    trait_bounds
    type_vars.clone
    copy_bound
    receiver
    TraitImpl
    parser register_trait_impl
}

fn derive_copy_for_aggregates parser:mut$Parser {
    for
        casa_struct in parser
            .store
            .structs
            .values
            .iter
    do
        for derived_trait in casa_struct.derived_traits.iter do
            if "Copy" derived_trait.as_str == then
                Set[String]::new = required_type_vars
                for type_variable in casa_struct.type_vars.iter do
                    for member in casa_struct.members.iter do
                        if type_variable.as_str member.typ.type_contains_var then
                            type_variable.clone required_type_vars.add
                            break
                        fi
                    done
                done
                casa_struct.location required_type_vars casa_struct.type_vars casa_struct.name.as_str parser
                register_derived_copy
            else
                casa_struct.location f"Derivation for trait `{derived_trait}` is not supported" ErrorKind::InvalidScope parser.state.record_error_string
            fi
        done
    done
    for
        casa_enum in parser
            .store
            .enums
            .values
            .iter
    do
        for derived_trait in casa_enum.derived_traits.iter do
            if "Copy" derived_trait.as_str == then
                Set[String]::new = required_type_vars
                for type_variable in casa_enum.type_vars.iter do
                    for pair in casa_enum.variant_types.iter do
                        for payload_type in pair.second.iter do
                            if type_variable.as_str payload_type.type_contains_var then
                                type_variable.clone required_type_vars.add
                            fi
                        done
                    done
                done
                casa_enum.location required_type_vars casa_enum.type_vars casa_enum.name.as_str parser
                register_derived_copy
            else
                casa_enum.location f"Derivation for trait `{derived_trait}` is not supported" ErrorKind::InvalidScope parser.state.record_error_string
            fi
        done
    done
}

fn register_builtin_copy_impls parser:mut$Parser {
    if
        "Copy" parser
            .store
            .traits
            .has_str !
    then
        return
    fi
    parser
        .store
        .builtins
        .clone = builtin_names
    for builtin_name in builtin_names.iter do
        if "str" builtin_name.as_str == "array" builtin_name.as_str == || then
            continue
        fi
        builtin_name.as_str parse_type_str = receiver
        if parser.store "Copy" receiver find_satisfying_trait_type.is_some then
            continue
        fi
        "Copy" parser
            .store
            .traits
            .get_str
            .unwrap
            .location
            .clone
        Map[String String]::new
        Map[String List[TraitBound]]::new
        List[String]::new
        List[Type]::new "Copy".to_str TraitBound
        receiver
        TraitImpl
        parser register_trait_impl
    done
}

# ============================================================================
# _create_member_accessor - create getter/setter for struct members
# ============================================================================

fn create_member_accessor
    parser:mut$Parser
    struct_name:$str
    member_name:$str
    member_type:$Type
    prior_members:$List[Member]
    location:$Location
    type_vars:$List[String]
{
    if
        parser.store member_type prior_members next_struct_member_offset Option::Some(found_offset) is
    then
        found_offset
    else
        prior_members.length WORD_SIZE *
    fi
    = offset

    false = stores_inline
    if member_type.has_unresolved_type_var ! then
        if parser.store member_type type_value_representation Option::Some(representation) is then
            VALUE_REPR_INDIRECT representation != = stores_inline
        fi
    fi

    # Parameterize the struct name when the struct has type vars
    List[Type]::new struct_name.to_str GenericType Type::Generic = param_type
    type_vars string_list_to_set = effect_type_vars
    if 0 type_vars.length != then
        type_vars struct_name build_parameterized_type = param_type
    fi

    # Getter
    f"{struct_name}::{member_name}" = getter_name
    List[Op]::new = getter_ops
    location.clone OpValue::UnsafeStart Op::new getter_ops.push
    location.clone TYPE_PTR_T clone_type OpValue::TypeCast Op::new getter_ops.push
    location.clone offset (i64) make_integer_op_value Op::new getter_ops.push
    location.clone OpValue::Add Op::new getter_ops.push
    if stores_inline ! then
        location.clone OpValue::Load64 Op::new getter_ops.push
        location.clone member_type clone_type OpValue::TypeCast Op::new getter_ops.push
    else
        location.clone member_type clone_type OpValue::PtrRead Op::new getter_ops.push
    fi
    location.clone OpValue::UnsafeEnd Op::new getter_ops.push

    List[Parameter]::new = getter_params
    "".to_str SHARED_BORROW_TYPE param_type clone_type apply_borrow_type Parameter::named getter_params.push
    List[Type]::new = getter_returns
    member_type clone_type getter_returns.push
    getter_returns getter_params StackEffect::new = getter_stack_effect
    effect_type_vars.clone getter_stack_effect StackEffect::set_type_vars
    effect_type_vars getter_stack_effect canonicalize_stack_effect_type_vars
    getter_stack_effect location.clone getter_ops getter_name.clone
    Function::with_stack_effect = getter
    true getter Function::set_is_typechecked

    if
        getter_name parser
            .store
            .functions
            .get
            .is_some
    then
        location f"Function `{getter_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error_string
    fi
    getter getter_name parser.put_function

    # Setter
    f"{struct_name}::set_{member_name}" = setter_name
    List[Op]::new = setter_ops
    location.clone OpValue::UnsafeStart Op::new setter_ops.push
    location.clone TYPE_PTR_T clone_type OpValue::TypeCast Op::new setter_ops.push
    location.clone offset (i64) make_integer_op_value Op::new setter_ops.push
    location.clone OpValue::Add Op::new setter_ops.push
    if stores_inline ! then
        location.clone OpValue::Swap Op::new setter_ops.push
        location.clone TYPE_U64_T clone_type OpValue::TypeCast Op::new setter_ops.push
        location.clone OpValue::Swap Op::new setter_ops.push
        location.clone OpValue::Store64 Op::new setter_ops.push
    else
        location.clone member_type clone_type OpValue::PtrWrite Op::new setter_ops.push
    fi
    location.clone OpValue::UnsafeEnd Op::new setter_ops.push

    List[Parameter]::new = setter_params
    "".to_str EXCLUSIVE_BORROW_TYPE param_type clone_type apply_borrow_type Parameter::named setter_params.push
    "".to_str member_type clone_type Parameter::named setter_params.push
    List[Type]::new = setter_returns
    setter_returns setter_params StackEffect::new = setter_stack_effect
    effect_type_vars.clone setter_stack_effect StackEffect::set_type_vars
    effect_type_vars setter_stack_effect canonicalize_stack_effect_type_vars
    setter_stack_effect location.clone setter_ops setter_name.clone
    Function::with_stack_effect = setter
    true setter Function::set_is_typechecked

    if
        setter_name parser
            .store
            .functions
            .get
            .is_some
    then
        location f"Function `{setter_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error_string
    fi
    setter setter_name parser.put_function
}

# ============================================================================
# parse_struct - parse struct definition
# ============================================================================

fn parse_struct parser:mut$Parser cursor:mut$TokenCursor -> CasaStruct {
    fallback_token parser.state "struct" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    # Parse optional type parameters
    List[String]::new = type_vars
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value.as_str == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.into_parts = parsed_const_params = parsed_bounds = type_vars
            parsed_const_params drop
            # Trait bounds are not allowed on struct definitions
            if 0 parsed_bounds.keys.length != then
                name_token Token::location "Trait bounds are not allowed on struct definitions. Use `impl[K: Bound] StructName[K]` instead" ErrorKind::UnexpectedToken parser.state.record_error
            fi
        fi
    fi

    parser.state cursor parse_derived_traits = derived_traits

    List[Member]::new = members
    type_vars string_list_to_set = struct_type_vars
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or = struct_open_token

    while true do
        fallback_token parser.state cursor expect_token.unwrap_or = member_token
        if "}" member_token Token::value.as_str == then
            if parser.syntax_only then
                member_token Token::location Location::span Span::offset
                struct_open_token Token::location Location::span Span::offset
                SyntaxSpanKind::StructBody parser.state.record_span
            fi
            break
        fi
        if TokenKind::Identifier member_token Token::kind != then
            member_token Token::location "Expected member name" ErrorKind::UnexpectedToken parser.state.record_error
        fi
        fallback_token parser.state ":" cursor expect_token_value.unwrap_or drop
        parser.state cursor parse_type_ast = member_type
        struct_type_vars member_type canonicalize_type_var = member_type

        type_vars member_token Token::location members member_type member_token Token::value.as_str name_token Token::value.as_str parser create_member_accessor
        member_type member_token Token::value.clone Member members.push
    done

    derived_traits type_vars name_token Token::location.clone members name_token Token::value.clone CasaStruct
}

# ============================================================================
# parse_trait - parse trait definition
# ============================================================================

fn parse_trait_method_stack_effect cursor:mut$TokenCursor state:mut$ParseState -> StackEffect {
    List[Parameter]::new = params

    # Parse parameters, stopping at ->, fn, or }
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            break
        fi
        peek_opt.unwrap = peek
        if
            "->" peek Token::value.as_str ==
            "{" peek Token::value.as_str == ||
            "fn" peek Token::value.as_str == ||
            "}" peek Token::value.as_str == ||
        then
            break
        fi
        cursor.pop drop

        if
            TokenKind::Identifier peek Token::kind !=
            "fn" peek Token::value.as_str != &&
        then
            peek Token::location "Unexpected token in trait method parameter list" ErrorKind::UnexpectedToken state.record_error
        fi

        state peek cursor parse_parameter_maybe_named params.push
    done

    List[Type]::new = returns
    cursor.peek = arrow_opt
    if arrow_opt Option::Some(arrow) is then
        if "->" arrow Token::value.as_str == then
            cursor.pop drop # consume ->
            while true do
                cursor.peek = return_opt
                if return_opt.is_none then
                    break
                fi
                return_opt.unwrap = return_token
                if
                    "fn" return_token Token::value.as_str ==
                    "}" return_token Token::value.as_str == ||
                    "{" return_token Token::value.as_str == ||
                then
                    break
                fi
                state cursor parse_type_ast returns.push
            done
        fi
    fi

    returns params StackEffect::new
}
# Parse a bracket-delimited identifier-only type-parameter list:
# `[T1 T2 ...]`. `context` (e.g. "trait", "trait method") is interpolated
# into error messages. Does *not* accept trait bounds; for those use
# `parse_type_variables`.

fn parse_simple_type_vars cursor:mut$TokenCursor context:str state:mut$ParseState -> List[String] {
    cursor.pop drop # consume [
    List[String]::new = collected
    true = loop_flag
    while loop_flag do
        cursor.peek = token_opt
        if token_opt.is_none then
            empty_location f"Unclosed {context} type parameter list" ErrorKind::UnmatchedBlock state.record_error_string
            state.mark_output_unusable
            false = loop_flag
        else
            token_opt.unwrap = token
            if "]" token Token::value.as_str == then
                cursor.pop drop
                false = loop_flag
            elif TokenKind::Identifier token Token::kind != then
                token Token::location f"Expected type parameter identifier in {context}" ErrorKind::UnexpectedToken state.record_error_string
                false = loop_flag
            else
                cursor.pop drop
                token Token::value.clone collected.push
            fi
        fi
    done
    collected
}

fn parse_trait parser:mut$Parser cursor:mut$TokenCursor -> CasaTrait {
    fallback_token parser.state "trait" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    List[String]::new = type_params
    cursor.peek = bracket_opt
    if { Token::value.as_str "[" == } bracket_opt.filter.is_some then
        parser.state "trait" cursor parse_simple_type_vars = type_params
    fi

    List[TraitBound]::new = supertraits
    cursor.peek = colon_opt
    if { Token::value.as_str ":" == } colon_opt.filter.is_some then
        cursor.pop drop
        true = parse_super_loop
        while parse_super_loop do
            fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = super_token
            super_token Token::value.clone = super_name
            super_name parser
                .store
                .traits
                .get = super_def_opt
            parser.state super_token cursor parse_bound_type_args = super_args
            if super_def_opt Option::Some(super_def) is then
                super_def CasaTrait::type_params = super_params: $List[String]
                if super_args.length super_params.length != then
                    super_token Token::location f"Supertrait `{super_name}` expects {super_params.length} type argument(s), got {super_args.length}" ErrorKind::Syntax parser.state.record_error_string
                fi
            fi
            super_args super_name TraitBound supertraits.push
            cursor.peek = plus_opt
            if { Token::value.as_str "+" == } plus_opt.filter.is_some then
                cursor.pop drop
            else
                false = parse_super_loop
            fi
        done
    fi

    List[TraitMethod]::new = methods
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop

    true = parse_trait_loop
    while parse_trait_loop do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token Token::location "Unclosed trait block" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            false = parse_trait_loop
        elif next_opt Option::Some(next) is then
            if "}" next Token::value.as_str == then
                cursor.pop drop
                false = parse_trait_loop
            elif "fn" next Token::value.as_str != then
                next Token::location "Expected method declaration in trait" ErrorKind::UnexpectedToken parser.state.record_error
                false = parse_trait_loop
            else
                next Token::location Location::span Span::offset = trait_fn_offset
                cursor.pop drop # consume fn
                parser.state cursor expect_function_name = method_name
                if "drop" method_name Token::value.as_str == then
                    method_name Token::location "`drop` is reserved for inherent cleanup methods" ErrorKind::InvalidScope parser.state.record_error
                fi

                # Parse optional method-level type parameters (e.g., fn map[U])
                List[String]::new = method_type_vars
                if cursor.peek Option::Some(mtv_bracket) is then
                    if "[" mtv_bracket Token::value.as_str == then
                        parser.state "trait method" cursor parse_simple_type_vars = method_type_vars
                    fi
                fi

                parser.state cursor parse_trait_method_stack_effect = method_stack_effect

                type_params string_list_to_set = trait_tv_set
                TRAIT_SELF_TYPE trait_tv_set.add_str
                for mtv in method_type_vars.iter do
                    mtv.clone trait_tv_set.add
                done
                trait_tv_set method_stack_effect canonicalize_stack_effect_type_vars

                # Parse optional default method body
                List[Op]::new = default_ops
                if cursor.peek Option::Some(body_peek) is then
                    if "{" body_peek Token::value.as_str == then
                        f"{name_token Token::value.as_str}::{method_name Token::value.as_str}" = default_name
                        default_name.as_str cursor parser parse_block_ops = default_ops
                        trait_tv_set default_ops canonicalize_operation_type_vars
                        if parser.syntax_only then
                            cursor.previous_offset
                            trait_fn_offset
                            SyntaxSpanKind::Definition parser.state.record_span
                        fi
                    fi
                fi

                method_type_vars default_ops method_stack_effect method_name Token::value.clone TraitMethod methods.push
            fi
        else
            false = parse_trait_loop
        fi
    done

    name_token Token::location.clone supertraits methods type_params name_token Token::value.clone CasaTrait
}

# ============================================================================
# parse_impl_block - parse impl Type { fn methods... }
# ============================================================================

fn inject_implementation_parameters
    parser:mut$Parser
    function:mut$Function
    type_vars:$List[String]
    trait_bounds:$Map[String List[TraitBound]]
    constant_parameters:$Map[String BuiltinType]
{
    function.stack_effect clone_stack_effect = effect

    # Merge the impl block's constant parameters (ADR-0152) and rewrite the
    # method declaration and body so their names read as constants, not type
    # variables.
    if 0 constant_parameters.keys.length != then
        constant_parameters effect rewrite_stack_effect_constant_parameters
        constant_parameters function.ops rewrite_operation_constant_parameters
        0 (u64) = variable_index
        while variable_index function.variables.length > do
            variable_index function.variables.get_mut = variable
            constant_parameters variable.typ rewrite_type_const_params = rewritten_variable_type
            rewritten_variable_type variable Variable::set_typ
            1 += variable_index
        done
        for constant_pair in constant_parameters.iter do
            constant_pair.second.clone constant_pair.first.clone effect.const_params.set
        done
    fi

    # Merge type vars into function stack effect
    for type_var in type_vars.iter do
        if type_var effect.type_vars.has ! then
            type_var.clone effect.type_vars.add
        fi
    done
    effect.type_vars.clone = active_impl_type_vars
    active_impl_type_vars effect canonicalize_stack_effect_type_vars
    active_impl_type_vars function.ops canonicalize_operation_type_vars
    0 (u64) = variable_index
    while variable_index function.variables.length > do
        variable_index function.variables.get clone_variable = variable
        active_impl_type_vars variable.typ canonicalize_type_var = variable_type
        variable_type variable Variable::set_typ
        variable variable_index function.variables.set
        1 += variable_index
    done

    # Merge trait bounds
    trait_bounds.keys = bound_keys
    for bound_key in bound_keys.iter do
        if bound_key trait_bounds.get Option::Some(bounds) is then
            bounds.clone bound_key.clone effect.trait_bounds.set
        fi
    done

    # Inject hidden __trait_* parameters
    List[Parameter]::new = hidden_params
    0 (u64) = insert_pos
    effect.trait_bounds parser build_hidden_trait_methods = hidden_methods
    for hidden in hidden_methods.iter do
        hidden HiddenTraitMethod::var_name = hidden_name: $String
        hidden HiddenTraitMethod::fn_type = hidden_type: $Type
        hidden_name.clone hidden_type clone_type Parameter::named hidden_params.push
        hidden_name.as_str Variable::new function.variables.push
        function.location.clone hidden_name.clone OpValue::AssignVar Op::new = assignment_operation
        hidden_type clone_type Option::Some assignment_operation Op::set_type_hint
        insert_pos assignment_operation function.ops.insert
        1 += insert_pos
    done

    # Inject hidden parameters for the implementation's constant parameters.
    function.location.clone function.variables effect inject_constant_parameters = constant_assignments
    while 0 constant_assignments.length != do
        constant_assignments.pop = assignment
        insert_pos assignment function.ops.insert
    done

    # Prepend hidden params to existing stack effect parameters
    if 0 hidden_params.length != then
        0 (u64) = existing_param_index
        while existing_param_index effect.parameters.length > do
            existing_param_index effect.parameters.get clone_parameter hidden_params.push
            1 += existing_param_index
        done
        hidden_params effect StackEffect::set_parameters
    fi
    effect function Function::set_stack_effect
}

fn namespace_trait_impl_type typ:$Type type_vars:$List[String] prefix:str -> Type {
    Map[String Type]::new = substitutions
    for type_variable in type_vars.iter do
        f"{prefix}{type_variable}" Type::TypeVar type_variable.clone substitutions.set
    done
    substitutions typ.substitute_t
}

fn resolve_overlap_type typ:$Type bindings:$Map[String Type] -> Type {
    if typ Type::TypeVar(type_variable) is then
        if type_variable bindings.get Option::Some(bound) is then
            bindings bound resolve_overlap_type return
        fi
    fi
    typ clone_type
}

fn overlap_type_contains type_variable:$str typ:$Type bindings:mut$Map[String Type] -> bool {
    bindings typ resolve_overlap_type = resolved
    if resolved Type::TypeVar(name) is then
        type_variable name.as_str == return
    fi
    if resolved Type::Generic(generic) is then
        for parameter in generic.params.iter do
            if bindings parameter type_variable overlap_type_contains then
                true return
            fi
        done
    elif resolved Type::Function(function_type) is then
        for parameter in function_type.parameters.iter do
            if bindings parameter type_variable overlap_type_contains then
                true return
            fi
        done
        for return_type in function_type.return_types.iter do
            if bindings return_type type_variable overlap_type_contains then
                true return
            fi
        done
    fi
    false
}

fn bind_overlap_type type_variable:$str typ:$Type bindings:mut$Map[String Type] -> bool {
    bindings typ resolve_overlap_type = resolved
    if resolved Type::TypeVar(name) is then
        if type_variable name.as_str == then
            true return
        fi
    fi
    if bindings resolved type_variable overlap_type_contains then
        false return
    fi
    resolved type_variable.clone bindings.set_str
    true
}

fn unify_trait_impl_types first:$Type second:Type bindings:mut$Map[String Type] -> bool {
    bindings first resolve_overlap_type = resolved_first
    bindings second resolve_overlap_type = resolved_second
    if resolved_first Type::TypeVar(first_variable) is then
        bindings resolved_second first_variable.as_str bind_overlap_type return
    fi
    if resolved_second Type::TypeVar(second_variable) is then
        bindings resolved_first second_variable.as_str bind_overlap_type return
    fi
    if resolved_first Type::Generic(first_generic) is then
        if resolved_second Type::Generic(second_generic) is then
            if first_generic.base second_generic.base != then
                false return
            fi
            if first_generic.params.length second_generic.params.length != then
                false return
            fi
            for
                pair in second_generic.params.iter first_generic
                    .params
                    .iter
                    .zip
            do
                if bindings pair.first clone_type pair.second clone_type unify_trait_impl_types ! then
                    false return
                fi
            done
            true return
        fi
        false return
    fi
    if resolved_first Type::Function(first_function) is then
        if resolved_second Type::Function(second_function) is then
            if first_function.parameters.length second_function.parameters.length != then
                false return
            fi
            if first_function.return_types.length second_function.return_types.length != then
                false return
            fi
            for
                pair in second_function.parameters.iter first_function
                    .parameters
                    .iter
                    .zip
            do
                if bindings pair.first clone_type pair.second clone_type unify_trait_impl_types ! then
                    false return
                fi
            done
            for
                pair in second_function.return_types.iter first_function
                    .return_types
                    .iter
                    .zip
            do
                if bindings pair.first clone_type pair.second clone_type unify_trait_impl_types ! then
                    false return
                fi
            done
            true return
        fi
        false return
    fi
    resolved_first resolved_second.eq
}

fn trait_impls_overlap first:$TraitImpl second:$TraitImpl -> bool {
    if first.trait_bound.name second.trait_bound.name != then
        false return
    fi
    if
        first
            .trait_bound
            .type_args
            .length second
            .trait_bound
            .type_args
            .length !=
    then
        false return
    fi
    "left:" first.type_vars first.receiver namespace_trait_impl_type = first_receiver
    "right:" second.type_vars second.receiver namespace_trait_impl_type = second_receiver
    Map[String Type]::new = bindings
    if bindings second_receiver first_receiver unify_trait_impl_types ! then
        false return
    fi
    for
        pair in second
            .trait_bound
            .type_args
            .iter first
            .trait_bound
            .type_args
            .iter
            .zip
    do
        "left:" first.type_vars pair.second namespace_trait_impl_type = first_argument
        "right:" second.type_vars pair.first namespace_trait_impl_type = second_argument
        if bindings second_argument first_argument unify_trait_impl_types ! then
            false return
        fi
    done
    true
}

fn receiver_is_local receiver:$Type location:$Location store:mut$SymbolStore -> bool {
    receiver.match_base = receiver_name
    if receiver_name store.structs.get Option::Some(casa_struct) is then
        casa_struct.location.file location.file == return
    fi
    if receiver_name store.enums.get Option::Some(casa_enum) is then
        casa_enum.location.file location.file == return
    fi
    false
}

fn register_trait_impl parser:mut$Parser trait_impl:TraitImpl {
    for
        pair in parser
            .store
            .trait_impls
            .iter
    do
        pair.second = existing: $TraitImpl
        if trait_impl existing trait_impls_overlap then
            trait_impl.location f"Trait implementation `{trait_impl trait_impl_key}` overlaps an existing implementation in `{existing.location.file}`" ErrorKind::DuplicateName parser.state.record_error_string
            return
        fi
    done
    trait_impl trait_impl_key = key
    trait_impl key parser.put_trait_impl
}

fn normalize_trait_method_effect candidate:$TraitMethodCandidate -> StackEffect {
    Map[String Type]::new = substitutions
    0 (u64) = index
    for
        type_variable in candidate
            .method
            .type_vars
            .iter
    do
        f"method_type_{index}" Type::TypeVar type_variable.clone substitutions.set
        1 += index
    done
    substitutions candidate.effect apply_type_subs_to_stack_effect
}

fn validate_trait_method_compatibility parser:mut$Parser casa_trait:$CasaTrait -> bool {
    casa_trait trait_definition_type = trait_type
    trait_type parser.store collect_trait_method_candidates = candidates
    0 (u64) = first_index
    while first_index candidates.length > do
        first_index candidates.get = first
        first normalize_trait_method_effect = first_effect
        first_index 1 + = second_index
        while second_index candidates.length > do
            second_index candidates.get = second
            if first.method.name second.method.name == then
                second normalize_trait_method_effect = second_effect
                if first_effect second_effect stack_effect_shapes_equal ! then
                    casa_trait.location f"Trait `{casa_trait.name}` inherits incompatible `{first.method.name}` methods from `{first.trait_type.format}` and `{second.trait_type.format}`" ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                    false return
                fi
            fi
            1 += second_index
        done
        1 += first_index
    done
    true
}

fn language_trait_method_kind trait_name:$str method_name:$str -> i64 {
    if
        "PartialEq" trait_name.as_str ==
        "Eq" trait_name.as_str == ||
        "PartialOrd" trait_name.as_str == ||
        "Ord" trait_name.as_str == ||
    then
        if "eq" method_name.as_str == "ne" method_name.as_str == || then
            1 return
        fi
    fi
    if "PartialOrd" trait_name.as_str == "Ord" trait_name.as_str == || then
        if
            "lt" method_name.as_str == "le" method_name.as_str == ||
            "gt" method_name.as_str == || "ge" method_name.as_str == ||
        then
            1 return
        fi
        if "partial_cmp" method_name.as_str == then
            6 return
        fi
    fi
    if "Ord" trait_name.as_str == "cmp" method_name.as_str == && then
        7 return
    fi
    if "Hashable" trait_name.as_str == then
        if "hash" method_name.as_str == then
            2 return
        fi
    elif "Display" trait_name.as_str == "to_str" method_name.as_str == && then
        3 return
    elif "Iterable" trait_name.as_str == "next" method_name.as_str == && then
        4 return
    elif "Clone" trait_name.as_str == "clone" method_name.as_str == && then
        5 return
    fi
    0
}

fn language_trait_method_matches
    candidate:$TraitMethodCandidate
    method_kind:i64
    casa_trait:$CasaTrait
-> bool {
    candidate.effect = effect: $StackEffect
    if 1 method_kind == 6 method_kind == || 7 method_kind == || then
        if 2 effect.parameters.length != then
            false return
        fi
        0 effect
            .parameters
            .get
            .typ clone_type = receiver_type
        if receiver_type.borrow_target Option::Some(target) is then
            target clone_type = receiver_type
        fi
        if receiver_type.is_self_type ! then
            false return
        fi
        1 effect
            .parameters
            .get
            .typ clone_type = other_type
        if other_type.borrow_target Option::Some(target) is then
            target clone_type = other_type
        fi
        if other_type.is_self_type ! then
            false return
        fi
        if 1 effect.return_types.length != then
            false return
        fi
        if 1 method_kind == then
            0 effect.return_types.get TYPE_BOOL_T.eq return
        fi
        "Ordering".to_str GenericType::new Type::Generic = ordering_type
        if 7 method_kind == then
            0 effect.return_types.get ordering_type.eq return
        fi
        List[Type]::new = option_args
        ordering_type option_args.push
        option_args "Option".to_str GenericType Type::Generic = expected
        0 effect.return_types.get expected.eq return
    fi
    if 1 effect.parameters.length != then
        false return
    fi
    0 effect
        .parameters
        .get
        .typ clone_type = receiver_type
    if receiver_type.borrow_target Option::Some(target) is then
        target clone_type = receiver_type
    fi
    if receiver_type.is_self_type ! then
        false return
    fi
    if 1 effect.return_types.length != then
        false return
    fi
    if 2 method_kind == then
        0 effect.return_types.get TYPE_I64_T.eq return
    fi
    if 3 method_kind == then
        0 effect.return_types.get TYPE_STRING_T.eq return
    fi
    if 4 method_kind == then
        if 1 casa_trait.type_params.length != then
            false return
        fi
        List[Type]::new = option_args
        0 casa_trait
            .type_params
            .get
            .clone Type::TypeVar option_args.push
        option_args "Option".to_str GenericType Type::Generic = expected
        0 effect.return_types.get expected.eq return
    fi
    if 5 method_kind == then
        0 effect
            .return_types
            .get
            .is_self_type return
    fi
    false
}

fn language_trait_method_role method_kind:i64 -> str {
    if 1 method_kind == then
        "operator method" return
    fi
    if 2 method_kind == then
        "hashing method" return
    fi
    if 3 method_kind == then
        "formatting method" return
    fi
    if 5 method_kind == then
        "cloning method" return
    fi
    if 6 method_kind == 7 method_kind == || then
        "comparison method" return
    fi
    "trait method"
}

fn validate_language_trait_contract parser:mut$Parser casa_trait:$CasaTrait -> bool {
