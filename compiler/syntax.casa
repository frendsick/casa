    fi
    # Register bindings as variables
    if 0 variant EnumVariant::bindings.length != then
        for rev_var_name in variant EnumVariant::bindings.iter do
            rev_var_name.as_str Variable::new = rev_var
            if GLOBAL_SCOPE_LABEL function Function::name.as_str == then
                rev_var rev_var_name.clone store.variables.set
            else
                if rev_var_name.as_str function Function::variables variable_list_contains ! then
                    rev_var function Function::variables.push
                fi
            fi
        done
    fi
}

impl Parser {
    fn analyze_import
        self:mut$Parser
        import_path:$str
        included_files:mut$Set[String]
        base_store:SymbolStore
    -> Result[ParseResolveResult IoError] {
        self.sources import_path.clone lex_file = import_result
        Diagnostics::new = diagnostics
        List[Token]::new = tokens
        import_result match
            Result::Ok(lex_result) => lex_result.into_parts = diagnostics = tokens
            Result::Error(error) => error Result::Error return
        end
        if diagnostics.has_errors then
            diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult Result::Ok
            return
        fi
        base_store.functions.keys string_list_to_set = existing_functions
        base_store = imported_store
        self.sources diagnostics imported_store Parser::new = import_parser
        self.search_paths.clone = import_parser.search_paths
        included_files.to_list = existing_included_files
        for included_file in existing_included_files.iter do
            included_file.clone import_parser.included_files.add
        done
        tokens import_parser parse_ops = imported_ops
        if
            import_parser
                .state
                .diagnostics
                .has_errors import_parser.state.has_usable_output ! ||
        then
            import_parser.into_diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult Result::Ok
            return
        fi
        existing_functions imported_ops import_parser.finish_resolution = nested_included_files = result
        for included_file in nested_included_files.iter do
            included_file.clone included_files.add
        done
        if result.diagnostics.has_errors then
            result.into_parts = result_diagnostics = result_store = result_ops
            result_diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult Result::Ok
            return
        fi
        result Result::Ok
    }
}

fn expand_imports parser:mut$Parser ops:List[Op] -> List[Op] {
    ops.reverse
    List[Op]::new = expanded
    while ops.is_empty ! do
        ops.pop = current_op
        if current_op.value OpValue::ImportFileSelective(selective_import) is then
            selective_import clone_selective_import = owned_import
            current_op.location owned_import parser handle_selective_import
            if parser.state.has_usable_output ! then
                expanded return
            fi
            continue
        fi

        if current_op.value OpValue::ImportFile(import_path) is then
            import_path.clone = owned_path
            expanded current_op.location owned_path parser handle_full_import
            if parser.state.has_usable_output ! then
                expanded return
            fi
            continue
        fi
        current_op expanded.push
    done
    expanded
}

fn resolve_identifiers_global
    parser:mut$Parser
    ops:List[Op]
    skip_functions:$Set[String]
-> List[Op] {
    ops parser expand_imports = expanded_ops
    if parser.state.has_usable_output ! then
        List[Op]::new return
    fi
    Set[String]::new = no_type_vars
    no_type_vars expanded_ops canonicalize_operation_type_vars
    if parser validate_traits ! then
        List[Op]::new return
    fi
    parser validate_inhabited_aggregates
    parser derive_copy_for_aggregates
    parser register_builtin_copy_impls
    parser validate_drop_methods
    skip_functions parser finalize_trait_impl_methods
    parser synthesize_copy_clone_fallbacks
    parser validate_trait_impls
    if parser.state.has_usable_output ! then
        List[Op]::new return
    fi
    empty_location List[Op]::new GLOBAL_SCOPE_LABEL.to_str Function::new = dummy
    parser.state.diagnostics dummy expanded_ops parser.store resolve_identifiers
    expanded_ops
}

fn resolve_identifiers
    store:mut$SymbolStore
    ops:mut$List[Op]
    function:mut$Function
    diagnostics:mut$Diagnostics
{
    0 (u64) = op_index
    List[CasaError]::new = resolve_errors
    Set[String]::new = declared_globals
    while op_index ops.length > do
        empty_location OpValue::OwnerCleanup Op::new op_index ops.replace = current_op
        1 += op_index

        if current_op.value OpValue::DeclareGlobal(global_name_ref) is then
            global_name_ref.clone = global_name
