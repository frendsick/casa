# Lossless root grammar. Recognition borrows tokens and never resolves declarations.
import "std" as std
import "common" as common
import "error" as error
import "lexer" as lexer

pub enum SyntaxSpanKind derives std::Eq std::Copy {
    Definition
    DelimitedForm
    StructBody
    EnumBody
    ControlForm
    MatchForm
    MatchArm
    AccessorChain
    NameBrace
    Type
    TypeArguments
    Signature
    Declaration
    Import
    Block
    Field
    Pattern
    Assignment
    Name
    Fstring
}

pub struct SyntaxSpan derives std::Clone {
    pub kind:   SyntaxSpanKind
    pub start:  u64
    pub close:  u64
    pub parent: u64
}

pub struct SyntaxTokenFact {
    pub spelling: std::String
    pub kind:     common::TokenKind
}

pub struct SyntaxCommentFact {
    pub text:                  std::String
    pub preceding_token_count: u64
    pub attached_to_preceding: bool
}

# Token positions stay stable when formatting changes source byte offsets.
pub struct SyntaxRelation {
    pub kind:        SyntaxSpanKind
    pub start_token: u64
    pub close_token: u64
    pub parent:      u64
}

# Each qualified source name keeps the exact range of every written segment.
pub struct NameSegment {
    pub token_position: u64
    pub start:          u64
    pub length:         u64
}

# Import discovery consumes these parsed clauses without scanning source tokens.
pub struct ImportSyntax {
    pub first_token: u64
    pub after_token: u64
    pub specifier:   std::String
    pub alias:       std::Option[std::String]
    pub location:    common::Location
}

pub struct DeclarationSyntax {
    pub name:        std::String
    pub location:    common::Location
    pub kind:        std::String
    pub first_token: u64
    pub after_token: u64
    pub external:    bool
}

pub struct SyntaxFacts {
    pub meaningful_tokens: std::List[SyntaxTokenFact]
    pub comments:          std::List[SyntaxCommentFact]
    pub spans:             std::List[SyntaxSpan]
    pub layout_spans:      std::List[SyntaxSpan]
    pub relations:         std::List[SyntaxRelation]
    pub name_segments:     std::List[NameSegment]
    pub imports:           std::List[ImportSyntax]
    pub declarations:      std::List[DeclarationSyntax]
}

pub struct SyntaxResult {
    pub tokens:      std::List[common::Token]
    pub facts:       std::Option[SyntaxFacts]
    pub diagnostics: error::Diagnostics
}

impl SyntaxResult {
    pub fn into_parts
        self:SyntaxResult
    -> std::List[common::Token] std::Option[SyntaxFacts] error::Diagnostics {
        self match
            SyntaxResult { tokens: tokens facts: facts diagnostics: diagnostics } => tokens facts diagnostics
        end
    }
}

pub fn logical_comment_text token:$common::Token -> std::String {
    1 = start: u64
    if 1 token.value.length > then
        if ' ' 1 token.value.at == then
            2 = start: u64
        fi
    fi
    token.value.as_str start token.value.length start - str::substring
}

pub fn find_syntax_token_position offsets:$std::List[u64] target:u64 -> std::Option[u64] {
    0 = low: u64
    offsets.length = high
    while high low < do
        low high low - 2 / + = middle
        middle offsets.get copy = offset
        if target offset == then
            middle std::Option::Some return
        fi
        if target offset < then
            middle 1 + = low
        else
            middle = high
        fi
    done
    std::Option[u64]::None
}

fn record_name_segments
    segments:mut$std::List[NameSegment]
    spelling:$str
    offset:u64
    token_position:u64
{
    0 = segment_start: u64
    if spelling "mut$" str::starts_with then
        4 = segment_start: u64
    elif spelling "$" str::starts_with spelling "&" str::starts_with || then
        1 = segment_start: u64
    fi
    segment_start = cursor
    while spelling.length cursor <= do
        if spelling.length cursor == then
            cursor segment_start - offset segment_start + token_position NameSegment segments.push
            break
        fi
        if ':' cursor spelling.at == then
            cursor segment_start - offset segment_start + token_position NameSegment segments.push
            2 += cursor
            cursor = segment_start
        else
            1 += cursor
        fi
    done
}

pub fn build_syntax_facts
    source:$str
    tokens:$std::List[common::Token]
    spans:std::List[SyntaxSpan]
    imports:std::List[ImportSyntax]
    declarations:std::List[DeclarationSyntax]
-> SyntaxFacts {
    std::List[SyntaxTokenFact]::new = meaningful_tokens
    std::List[SyntaxCommentFact]::new = comments
    std::List[NameSegment]::new = name_segments
    std::List[u64]::new = token_offsets
    0 = meaningful_count: u64
    false = line_has_meaningful_token

    for token in tokens.iter do
        token.kind match
            common::TokenKind::Newline => {
                false = line_has_meaningful_token continue
            }
            common::TokenKind::Comment => {
                token logical_comment_text = text
                line_has_meaningful_token meaningful_count text SyntaxCommentFact comments.push
                continue
            }
            common::TokenKind::Eof => continue
            _ => {
            }
        end
        # Commas carry no operand content: item separators are required by
        # the grammar (a missing one is a parse error the candidate re-parse
        # still catches), and a trailing comma is optional decoration.
        # Exclude them so the formatter may canonicalize delimited-form
        # commas, including adding or dropping the optional trailing comma,
        # without tripping the token-equality safety net.
        "," token.value.as_str == common::TokenKind::Delimiter token.kind == && = is_separator
        if is_separator ! then
            token
                .location
                .span
                .length = length
            token
                .location
                .span
                .offset = offset
            source offset length str::substring = spelling
            if common::TokenKind::Identifier token.kind == then
                meaningful_count offset spelling.as_str name_segments record_name_segments
            fi
            offset token_offsets.push
            token.kind spelling SyntaxTokenFact meaningful_tokens.push
            1 += meaningful_count
            true = line_has_meaningful_token
        fi
    done

    std::List[SyntaxRelation]::new = relations
    for span in spans.iter do
        span.start token_offsets find_syntax_token_position = start_opt
        span.close token_offsets find_syntax_token_position = close_opt
        if start_opt std::Option::Some(start_token) is then
            if close_opt std::Option::Some(close_token) is then
                span.parent close_token copy start_token copy span.kind SyntaxRelation relations.push
            fi
        fi
    done

    std::List[SyntaxSpan]::new = layout_spans
    for span in spans.iter do
        span.kind match
            SyntaxSpanKind::Definition => span.clone layout_spans.push
            SyntaxSpanKind::DelimitedForm => span.clone layout_spans.push
            SyntaxSpanKind::StructBody => span.clone layout_spans.push
            SyntaxSpanKind::EnumBody => span.clone layout_spans.push
            SyntaxSpanKind::ControlForm => span.clone layout_spans.push
            SyntaxSpanKind::MatchForm => span.clone layout_spans.push
            SyntaxSpanKind::MatchArm => span.clone layout_spans.push
            SyntaxSpanKind::AccessorChain => span.clone layout_spans.push
            _ => {
            }
        end
    done
    declarations imports name_segments relations layout_spans spans comments meaningful_tokens SyntaxFacts
}

pub fn syntax_facts_match expected:$SyntaxFacts actual:$SyntaxFacts -> bool {
    if expected.spans.length expected.relations.length != then
        false return
    fi
    if actual.spans.length actual.relations.length != then
        false return
    fi
    if actual.meaningful_tokens.length expected.meaningful_tokens.length != then
        false return
    fi
    if actual.comments.length expected.comments.length != then
        false return
    fi
    if actual.relations.length expected.relations.length != then
        false return
    fi

    0 = index: u64
    while index expected.meaningful_tokens.length > do
        index expected.meaningful_tokens.get = expected_token
        index actual.meaningful_tokens.get = actual_token
        if actual_token.kind expected_token.kind != then
            false return
        fi
        if actual_token.spelling expected_token.spelling != then
            false return
        fi
        1 += index
    done

    0 = index: u64
    while index expected.comments.length > do
        index expected.comments.get = expected_comment
        index actual.comments.get = actual_comment
        if actual_comment.text expected_comment.text != then
            false return
        fi
        if actual_comment.preceding_token_count expected_comment.preceding_token_count != then
            false return
        fi
        if actual_comment.attached_to_preceding expected_comment.attached_to_preceding != then
            false return
        fi
        1 += index
    done
    0 = index: u64
    while index expected.relations.length > do
        index expected.relations.get = expected_relation
        index actual.relations.get = actual_relation
        if actual_relation.parent expected_relation.parent != then
            false return
        fi
        if actual_relation.kind expected_relation.kind != then
            false return
        fi
        if actual_relation.start_token expected_relation.start_token != then
            false return
        fi
        if actual_relation.close_token expected_relation.close_token != then
            false return
        fi
        1 += index
    done
    true
}
# Nodes are stored in source order. Parent zero denotes the root, otherwise it
# is the parent's one-based index. Offsets include the original source trivia.
struct Reader {
    tokens:       $std::List[common::Token]
    source:       $str
    pos:          u64
    previous:     u64
    parent:       u64
    spans:        std::List[SyntaxSpan]
    imports:      std::List[ImportSyntax]
    declarations: std::List[DeclarationSyntax]
    references: std::List[u64]
    type_bindings: std::List[std::String]
    diagnostics:  error::Diagnostics
}

impl Reader {
    fn new tokens:$std::List[common::Token] source:$str diagnostics:error::Diagnostics -> Reader {
        diagnostics std::List[std::String]::new std::List[u64]::new std::List[DeclarationSyntax]::new std::List[ImportSyntax]::new std::List[SyntaxSpan]::new 0 0 0 source tokens Reader
    }

    fn get_token self:$Reader -> $common::Token { self.pos self.tokens.get }
    fn is_at self:$Reader value:$str -> bool { value self.get_token.value.as_str == }
    fn has_failed self:$Reader -> bool { self.diagnostics.has_errors }
    fn is_finished self:$Reader -> bool {
        common::TokenKind::Eof self.get_token.kind == self.has_failed ||
    }

    fn skip_trivia self:mut$Reader {
        while
            common::TokenKind::Comment self.get_token.kind == common::TokenKind::Newline self.get_token.kind == ||
        do
            1 += self.pos
        done
    }

    fn record_qualified_reference self:mut$Reader {
        self.get_token = token
        if common::TokenKind::Identifier token.kind != then
            return
        fi
        token.value.as_str "::" str::find = separator
        if 0 separator < then
            return
        fi
        token.value.as_str common::source_reference_head = qualifier
        if qualifier.as_str self.type_bindings common::string_list_contains ! then
            self.pos self.references.push
        fi
    }

    fn restore_type_bindings self:mut$Reader count:u64 {
        while count self.type_bindings.length > do
            self.type_bindings.pop drop
        done
    }

    fn advance self:mut$Reader {
        if common::TokenKind::Eof self.get_token.kind != then
            self.record_qualified_reference
            self.pos = self.previous
            1 += self.pos
            self.skip_trivia
        fi
    }

    fn get_next_position self:$Reader position:u64 -> u64 {
        position 1 + = next
        while self.tokens.length next < do
            next self.tokens.get = token
            if common::TokenKind::Comment token.kind != common::TokenKind::Newline token.kind != && then
                next return
            fi
            1 += next
        done
        self.tokens.length 1 -
    }

    fn is_next self:$Reader value:$str -> bool {
        value self.pos self.get_next_position self.tokens.get common::Token::value.as_str ==
    }

    fn fail self:mut$Reader message:$str {
        if self.has_failed ! then
            self
                .get_token
                .location
                .clone = location
            location message common::ErrorKind::Syntax self.diagnostics.record_error
        fi
    }

    fn expect self:mut$Reader value:$str {
        if value self.is_at then
            self.advance
        elif common::TokenKind::Eof self.get_token.kind == self.has_failed ! && then
            self
                .get_token
                .location
                .clone = location
            location "Unclosed source construct" common::ErrorKind::UnmatchedBlock self.diagnostics.record_error
        else
            "Unexpected token in source syntax" self.fail
        fi
    }

    fn parse_name self:mut$Reader {
        if common::TokenKind::Identifier self.get_token.kind == then
            self.advance
        else
            "Expected a name" self.fail
        fi
    }

    fn parse_function_name self:mut$Reader {
        if "drop" self.is_at then
            self.advance
        else
            self.parse_name
        fi
    }

    fn begin_node self:mut$Reader kind:SyntaxSpanKind -> u64 {
        self.spans.length = index
        self
            .get_token
            .location
            .span
            .offset = start
        self.parent start start kind SyntaxSpan self.spans.push
        index 1 + = self.parent
        index
    }

    fn finish_node self:mut$Reader index:u64 {
        self.previous self.tokens.get common::Token::location common::Location::span common::Span::offset = close
        index self.spans.get_mut = node
        close = node.close
        node.parent = self.parent
    }

    fn parse_type self:mut$Reader {
        SyntaxSpanKind::Type self.begin_node = node
        if "fn" self.is_at "$fn" self.is_at || "mut$fn" self.is_at || then
            self.advance
            if "[" self.is_at ! then
                node self.finish_node return
            fi
            self.advance
            while self.is_finished ! "]" self.is_at ! && do
                if "->" self.is_at then
                    self.advance
                else
                    self.parse_type
                fi
            done
            "]" self.expect
        elif
            common::TokenKind::Identifier self.get_token.kind == common::TokenKind::Literal self.get_token.kind == ||
        then
            self.advance
            if "[" self.is_at then
                self.parse_type_arguments
            fi
        else
            "Expected a type" self.fail
        fi
        node self.finish_node
    }

    fn parse_type_arguments self:mut$Reader {
        SyntaxSpanKind::TypeArguments self.begin_node = node
        "[" self.expect
        while self.is_finished ! "]" self.is_at ! && do
            self.parse_type
        done
        "]" self.expect
        node self.finish_node
    }

    fn parse_type_operand self:mut$Reader {
        SyntaxSpanKind::TypeArguments self.begin_node = node
        "[" self.expect self.parse_type "]" self.expect
        node self.finish_node
    }

    fn parse_generic_parameters self:mut$Reader {
        if "[" self.is_at ! then
            return
        fi
        SyntaxSpanKind::TypeArguments self.begin_node = node
        self.advance
        while self.is_finished ! "]" self.is_at ! && do
            if "," self.is_at then
                self.advance continue
            fi
            if "const" self.is_at then
                self.advance
            fi
            self.get_token.value.clone self.type_bindings.push
            self.parse_name
            if ":" self.is_at then
                self.advance self.parse_type
                while "+" self.is_at self.has_failed ! && do
                    self.advance self.parse_type
                done
            fi
        done
        "]" self.expect
        node self.finish_node
    }

    fn is_extern_boundary self:$Reader -> bool {
        if "->" self.is_at then
            false return
        fi
        self
            .get_token
            .location
            .span
            .offset = offset
        if 0 offset == self.source.length offset > || then
            false return
        fi
        '\n' offset 1 - self.source.at == '\r' offset 1 - self.source.at == ||
    }

    fn parse_parameter self:mut$Reader {
        if ":" self.is_next then
            self.parse_name ":" self.expect
        fi
        self.parse_type
    }

    # A signature ends at a body, the next trait method, or an extern line.
    fn parse_signature self:mut$Reader external:bool requirement:bool {
        SyntaxSpanKind::Signature self.begin_node = node
        false = past_arrow
        0 = return_count: u64
        while self.is_finished ! "{" self.is_at ! && "}" self.is_at ! && do
            if requirement "fn" self.is_at && "[" self.is_next ! && then
                break
            fi
            if external self.is_extern_boundary && then
                break
            fi
            if "->" self.is_at then
                if past_arrow then
                    "Repeated signature arrow" self.fail
                fi
                true = past_arrow
                self.advance
            elif past_arrow then
                self.parse_type
                1 += return_count
            else
                self.parse_parameter
            fi
        done
        if external 1 return_count > && then
            "Extern functions can return at most one value" self.fail
        fi
        # A signature may be empty. Its enclosing declaration retains the range.
        if node 1 + self.spans.length == then
            self
                .spans
                .pop
                .parent = self.parent
        else
            node self.finish_node
        fi
    }

    fn parse_block self:mut$Reader {
        SyntaxSpanKind::Block self.begin_node = node
        "{" self.expect
        "}" self.parse_sequence
        "}" self.expect
        node self.finish_node
    }

    fn parse_sequence self:mut$Reader close:$str {
        while self.is_finished ! close self.is_at ! && do
            self.parse_expression
        done
    }

    fn record_declaration self:mut$Reader module_scope:bool {
        if module_scope then
            false 0 0 self.previous self
                .tokens
                .get
                .value
                .clone
            self
                .get_token
                .location
                .clone self
                .get_token
                .value
                .clone
            DeclarationSyntax self.declarations.push
        fi
    }

    fn parse_function self:mut$Reader external:bool requirement:bool module_scope:bool {
        self.type_bindings.length = inherited_bindings
        SyntaxSpanKind::Definition self.begin_node = node
        "fn" self.expect
        module_scope self.record_declaration
        self.parse_function_name
        if external "[" self.is_at && then
            "Extern functions cannot have type parameters" self.fail
            node self.finish_node return
        fi
        self.parse_generic_parameters
        requirement external self.parse_signature
        if external "{" self.is_at && then
            "Extern function declarations cannot have a body" self.fail
        fi
        if "{" self.is_at external ! && then
            self.parse_block
        elif external ! requirement ! && then
            "Expected a function body" self.fail
        fi
        inherited_bindings self.restore_type_bindings
        node self.finish_node
    }

    fn parse_enum_payload self:mut$Reader {
        if "(" self.is_at ! then
            return
        fi
        self.advance
        while ")" self.is_at ! self.is_finished ! && do
            self.parse_type
        done
        ")" self.expect
    }

    fn parse_declaration self:mut$Reader module_scope:bool {
        self.type_bindings.length = inherited_bindings
        self.pos = first_token
        self.declarations.length = declaration_index
        SyntaxSpanKind::Declaration self.begin_node = node
        "extern" self.is_at = external
        if external then
            self.advance
            if "fn" self.is_at ! "struct" self.is_at ! && then
                "Expected `fn` or `struct` after `extern`" self.fail
                node self.finish_node return
            fi
        fi
        if "fn" self.is_at then
            module_scope false external self.parse_function
        elif "struct" self.is_at "enum" self.is_at || then
            "enum" self.is_at = enumeration
            self.advance
            module_scope self.record_declaration
            self.parse_name self.parse_generic_parameters
            if "derives" self.is_at then
                self.advance self.parse_name
                while "{" self.is_at ! self.is_finished ! && do
                    self.parse_name
                done
            fi
            if enumeration then
                SyntaxSpanKind::EnumBody
            else
                SyntaxSpanKind::StructBody
            fi self.begin_node = body
            "{" self.expect
            while "}" self.is_at ! self.is_finished ! && do
                SyntaxSpanKind::Field self.begin_node = field
                if "pub" self.is_at then
                    self.advance
                fi
                self.parse_name
                if enumeration then
                    self.parse_enum_payload
                else
                    ":" self.expect self.parse_type
                fi
                field self.finish_node
            done
            "}" self.expect body self.finish_node
        elif "trait" self.is_at "impl" self.is_at || then
            "trait" self.is_at = requirement
            self.advance
            if requirement then
                module_scope self.record_declaration
                self.parse_name self.parse_generic_parameters
            else
                self.parse_generic_parameters self.parse_type
            fi
            if ":" self.is_at then
                self.advance self.parse_type
                while "+" self.is_at self.has_failed ! && do
                    self.advance self.parse_type
                done
            fi
            "{" self.expect
            while "}" self.is_at ! self.is_finished ! && do
                if "pub" self.is_at then
                    self.advance
                fi
                if "unsafe" self.is_at then
                    self.advance
                fi
                false requirement false self.parse_function
            done
            "}" self.expect
        else
            "Expected a declaration" self.fail
        fi
        if module_scope declaration_index self.declarations.length > && then
            declaration_index self.declarations.get_mut = declaration
            first_token = declaration.first_token
            self.pos = declaration.after_token
            external = declaration.external
        fi
        inherited_bindings self.restore_type_bindings
        node self.finish_node
    }

    fn parse_import self:mut$Reader {
        if 0 self.parent != then
            self
                .get_token
                .location
                .clone = location
            location "Import statements are only allowed at global scope" common::ErrorKind::InvalidScope self.diagnostics.record_error
            return
        fi
        self.pos = first_token
        SyntaxSpanKind::Import self.begin_node = node
        self.advance
        self
            .get_token
            .location
            .clone = location
        std::String::new = specifier
        std::Option[std::String]::None = alias
        if
            common::TokenKind::Literal self.get_token.kind == self
                .get_token
                .value
                .as_str "\"" str::starts_with &&
        then
            self
                .get_token
                .value
                .as_str = value
            value 1 value.length 2 - str::substring = specifier
            self.advance
        else
            "Expected an import string" self.fail
        fi
        if "as" self.is_at then
            self.advance
            self
                .get_token
                .value
                .clone std::Option::Some = alias
            self.parse_name
        fi
        if "{" self.is_at then
            if alias.clone std::Option::Some(written) is then
                written.clone
            else
                specifier.clone
            fi = qualifier
            f"Selective imports are no longer supported; remove the selection clause and use `{qualifier}::name`".as_str self.fail
        fi
        location alias specifier self.pos first_token ImportSyntax self.imports.push
        node self.finish_node
    }

    fn parse_array_item self:mut$Reader {
        if "[" self.is_at then
            self.parse_array return
        fi
        if "{" self.is_at then
            self.parse_block return
        fi
        self.get_token.kind match
            common::TokenKind::Literal => self.advance
            common::TokenKind::Identifier => {
                SyntaxSpanKind::Name self.begin_node = node
                self.parse_name
                if "{" self.is_at then
                    node self.spans.get_mut = named
                    SyntaxSpanKind::NameBrace = named.kind
                    self.advance self.parse_fields "}" self.expect
                fi
                node self.finish_node
            }
            _ => "Expected an array item" self.fail
        end
    }

    fn parse_array self:mut$Reader {
        SyntaxSpanKind::DelimitedForm self.begin_node = node
        "[" self.expect
        while "]" self.is_at ! self.is_finished ! && do
            self.parse_array_item
            if "," self.is_at then
                self.advance
            elif "]" self.is_at ! then
                "Expected `,` between array items" self.fail
            fi
        done
        "]" self.expect
        node self.finish_node
    }

    fn parse_fields self:mut$Reader {
        while "}" self.is_at ! self.is_finished ! && do
            SyntaxSpanKind::Field self.begin_node = node
            self.parse_name ":" self.expect
            self.pos = start
            while "}" self.is_at ! self.is_finished ! && do
                if ":" self.is_next common::TokenKind::Identifier self.get_token.kind == && then
                    break
                fi
                self.parse_expression
            done
            if start self.pos == then
                "Missing value for field" self.fail
            fi
            node self.finish_node
        done
    }

    # Brackets after a name also admit an ordinary array. Only the associated
    # member suffix (or a function reference) selects type-argument grammar.
    fn has_associated_suffix self:$Reader -> bool {
        self.pos = cursor
        0 = depth: u64
        while self.tokens.length cursor < do
            cursor self.tokens.get = token
            if "[" token.value.as_str == then
                1 += depth
            fi
            if "]" token.value.as_str == then
                1 -= depth
                if 0 depth == then
                    cursor self.get_next_position = suffix
                    ":" suffix self.tokens.get common::Token::value.as_str ==
                    ":" suffix self.get_next_position self.tokens.get common::Token::value.as_str == && return
                fi
            fi
            if common::TokenKind::Eof token.kind == then
                false return
            fi
            1 += cursor
        done
        false
    }

    # Empty braces deliberately have no declaration-dependent interpretation.
    fn parse_named_expression self:mut$Reader {
        SyntaxSpanKind::Name self.begin_node = node
        self
            .get_token
            .value
            .as_str "&" str::starts_with = reference
        self
            .get_token
            .location
            .span
            .offset self
            .get_token
            .location
            .span
            .length + = name_end
        self.advance
        if
            "[" self.is_at name_end self
                .get_token
                .location
                .span
                .offset == &&
        then
            if reference self.has_associated_suffix || then
                self.parse_type_arguments
                if reference ! ":" self.is_at || then
                    ":" self.expect ":" self.expect self.parse_name
                fi
            fi
        fi
        if "{" self.is_at then
            node self.spans.get_mut = named
            SyntaxSpanKind::NameBrace = named.kind
            self.advance
            if ":" self.is_next common::TokenKind::Identifier self.get_token.kind == && then
                self.parse_fields
            else
                "}" self.parse_sequence
            fi
            "}" self.expect
        elif "(" self.is_at then
            self.advance
            while ")" self.is_at ! self.is_finished ! && do
                self.parse_name
            done
            ")" self.expect "is" self.expect
        elif "is" self.is_at then
            self.advance
        fi
        node self.finish_node
    }

    fn parse_accessor self:mut$Reader {
        SyntaxSpanKind::AccessorChain self.begin_node = node
        while "." self.is_at self.has_failed ! && do
            self.advance self.parse_function_name
        done
        node self.finish_node
    }

    fn parse_control self:mut$Reader {
        SyntaxSpanKind::ControlForm self.begin_node = node
        if "if" self.is_at then
            self.advance "then" self.parse_sequence "then" self.expect
            while self.is_finished ! "fi" self.is_at ! && do
                if "elif" self.is_at then
                    self.advance "then" self.parse_sequence "then" self.expect
                elif "else" self.is_at then
                    self.advance "fi" self.parse_sequence
                else
                    self.parse_expression
                fi
            done
            "fi" self.expect
        else
            if "for" self.is_at then
                self.advance self.parse_name "in" self.expect
            else
                self.advance
            fi
            "do" self.parse_sequence "do" self.expect
            "done" self.parse_sequence "done" self.expect
        fi
        node self.finish_node
    }

    fn parse_pattern self:mut$Reader {
        SyntaxSpanKind::Pattern self.begin_node = node
        if common::TokenKind::Literal self.get_token.kind == then
            self.advance
        else
            self.parse_name
            if "(" self.is_at then
                self.advance
                while ")" self.is_at ! self.is_finished ! && do
                    self.parse_name
                done
                ")" self.expect
            elif "{" self.is_at then
                self.advance
                while "}" self.is_at ! self.is_finished ! && do
                    self.parse_name ":" self.expect self.parse_name
                done
                "}" self.expect
            fi
        fi
        if "if" self.is_at then
            self.advance "=>" self.parse_sequence
        fi
        "=>" self.expect
        node self.finish_node
    }

    fn is_arm_boundary self:$Reader -> bool {
        if
            common::TokenKind::Identifier self.get_token.kind != common::TokenKind::Literal self.get_token.kind != &&
        then
            false return
        fi
        self.pos self.get_next_position = scan
        scan self.tokens.get common::Token::value.as_str = next
        if "=>" next == "if" next == || then
            true return
        fi
        if "(" next != "{" next != && then
            false return
        fi
        1 = depth: u64
        while 0 depth != do
            scan self.get_next_position = scan
            scan self.tokens.get = token
            if common::TokenKind::Eof token.kind == then
                false return
            fi
            if "(" token.value.as_str == "{" token.value.as_str == || then
                1 += depth
            fi
            if ")" token.value.as_str == "}" token.value.as_str == || then
                1 -= depth
            fi
        done
        scan self.get_next_position self.tokens.get common::Token::value.as_str = after
        "=>" after == "if" after == ||
    }

    fn parse_match self:mut$Reader {
        SyntaxSpanKind::MatchForm self.begin_node = node
        self.advance
        while "end" self.is_at ! self.is_finished ! && do
            SyntaxSpanKind::MatchArm self.begin_node = arm
            self.parse_pattern
            if "{" self.is_at then
                self.parse_block
            else
                while "end" self.is_at ! self.is_finished ! && self.is_arm_boundary ! && do
                    self.parse_expression
                done
            fi
            arm self.finish_node
        done
        "end" self.expect node self.finish_node
    }

    fn parse_fstring self:mut$Reader {
        SyntaxSpanKind::Fstring self.begin_node = node
        self.advance
        while common::TokenKind::FstringEnd self.get_token.kind != self.is_finished ! && do
            self.get_token.kind match
                common::TokenKind::FstringText => self.advance
                common::TokenKind::FstringExprStart => {
                    self.advance
                    while common::TokenKind::FstringExprEnd self.get_token.kind != self.is_finished ! && do
                        self.parse_expression
                    done
                    if common::TokenKind::FstringExprEnd self.get_token.kind == then
                        self.advance
                    else
                        "Unclosed interpolation" self.fail
                    fi
                }
                _ => "Unexpected string token" self.fail
            end
        done
        if common::TokenKind::FstringEnd self.get_token.kind == then
            self.advance
        else
            "Unclosed string" self.fail
        fi
        node self.finish_node
    }

    fn parse_constant_initializer self:mut$Reader {
        if "{" self.is_at then
            self.parse_block return
        fi
        self.get_token.kind match
            common::TokenKind::Literal => self.advance
            common::TokenKind::Identifier => self.advance
            _ => "Expected a literal, constant name, or block initializer" self.fail
        end
    }

    fn parse_value_declaration self:mut$Reader {
        0 self.parent == = module_scope
        SyntaxSpanKind::Declaration self.begin_node = node
        "const" self.is_at = constant
        self.advance
        if constant "fn" self.is_at && then
            module_scope self.parse_declaration
        else
            module_scope self.record_declaration
            self.parse_name
            if constant then
                self.parse_constant_initializer
            else
                self.parse_expression
            fi
        fi
        node self.finish_node
    }

    fn parse_expression self:mut$Reader {
        if self.is_finished then
            "Expected an expression" self.fail return
        fi
        if
            "fn" self.is_at "struct" self.is_at || "enum" self.is_at || "trait" self.is_at || "impl" self.is_at || "extern" self.is_at ||
        then
            0 self.parent == self.parse_declaration
        elif "pub" self.is_at then
            self.advance
            if "unsafe" self.is_at "const" self.is_at || "global" self.is_at || then
                self.parse_expression
            else
                0 self.parent == self.parse_declaration
            fi
        elif "import" self.is_at then
            self.parse_import
        elif "const" self.is_at "global" self.is_at || then
            self.parse_value_declaration
        elif "unsafe" self.is_at then
            self.advance
            if "fn" self.is_at then
                0 self.parent == self.parse_declaration
            else
                self.parse_block
            fi
        elif "move" self.is_at then
            self.advance self.parse_block
        elif "if" self.is_at "while" self.is_at || "for" self.is_at || then
            self.parse_control
        elif "match" self.is_at then
            self.parse_match
        elif "{" self.is_at then
            self.parse_block
        elif "[" self.is_at then
            self.parse_array
        elif "." self.is_at then
            self.parse_accessor
        elif "=" self.is_at "+=" self.is_at || "-=" self.is_at || then
            SyntaxSpanKind::Assignment self.begin_node = node
            self.advance self.parse_name
            if "." self.is_at then
                self.parse_accessor
            fi
            if ":" self.is_at then
                self.advance self.parse_type
            fi
            node self.finish_node
        elif
            "size_of" self.is_at "ptr::read" self.is_at || "ptr::write" self.is_at || "ptr::as_ref" self.is_at || "ptr::as_mut" self.is_at || "ptr::from_raw" self.is_at ||
        then
            if "size_of" self.is_at "[" self.is_next || then
                SyntaxSpanKind::Name self.begin_node = node
                self.advance self.parse_type_operand
                node self.finish_node
            else
                self.parse_named_expression
            fi
        elif "(" self.is_at then
            self
                .get_token
                .location
                .clone = location
            location "General casts are not supported; use a named conversion" common::ErrorKind::UnexpectedToken self.diagnostics.record_error
        elif "," self.is_at ":" self.is_at || "=>" self.is_at || "#" self.is_at || then
            self.advance
        elif
            "break" self.is_at "continue" self.is_at || "return" self.is_at || "drop" self.is_at || "copy" self.is_at ||
        then
            self.advance
        else
            self.get_token.kind match
                common::TokenKind::Identifier => self.parse_named_expression
                common::TokenKind::FstringStart => self.parse_fstring
                common::TokenKind::Literal => self.advance
                common::TokenKind::Operator => self.advance
                common::TokenKind::Intrinsic => self.advance
                _ => "Unexpected token in expression" self.fail
            end
        fi
    }
}

pub fn analyze_syntax source:$str file:$str -> SyntaxResult {
    file source lexer::lex_source_fmt.into_parts = diagnostics = tokens
    diagnostics source tokens parse_tokens
}

pub fn parse_tokens
    tokens:std::List[common::Token]
    source:$str
    diagnostics:error::Diagnostics
-> SyntaxResult {
    if diagnostics.has_errors then
        diagnostics std::Option[SyntaxFacts]::None tokens SyntaxResult return
    fi
    diagnostics source tokens Reader::new = reader
    reader.skip_trivia
    while reader.is_finished ! do
        reader.parse_expression
    done
    reader match
        Reader { spans: spans imports: imports declarations: declarations diagnostics: result_diagnostics } => {
            if result_diagnostics.has_errors then
                result_diagnostics std::Option[SyntaxFacts]::None tokens SyntaxResult
            else
                declarations imports spans tokens source build_syntax_facts = facts
                result_diagnostics facts std::Option::Some tokens SyntaxResult
            fi
        }
    end
}

pub struct ModuleSyntax {
    pub imports:      std::List[ImportSyntax]
    pub declarations: std::List[DeclarationSyntax]
    pub references: std::List[u64]
    pub diagnostics:  error::Diagnostics
}

pub fn parse_module tokens:$std::List[common::Token] source:$str -> ModuleSyntax {
    error::Diagnostics::new source tokens Reader::new = reader
    reader.skip_trivia
    while reader.is_finished ! do
        reader.parse_expression
    done
    reader match
        Reader { imports: imports declarations: declarations references: references diagnostics: diagnostics } => {
            diagnostics references declarations imports ModuleSyntax
        }
    end
}
