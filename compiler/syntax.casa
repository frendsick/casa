                    .variables
                    .get
                    .is_none
            then
                current_op Op::location.clone f"`{global_name}` is not a global variable" ErrorKind::UndefinedGlobal CasaError::new resolve_errors.push
            fi
            global_name.clone declared_globals.add
            current_op op_index 1 - ops.set
