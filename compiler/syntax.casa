# Parser for the Casa programming language.
#
# Converts a token list into an op list.
import "std"
import "os"
import "parser"
import "common"
import "error"
import "lexer"
import "semantics"
import "selective_import"

# ============================================================================
# Parser struct and parse/resolve result
#
# `Parser` owns parse-private state. Later compiler phases receive only the
# dependencies they use, not the parser object itself.
# ============================================================================

struct ParseState {
    diagnostics:       Diagnostics
    output_usable:     List[bool]
    recovery_required: List[bool]
    store_mutated:     List[bool]
}

impl ParseState {
    fn new diagnostics:Diagnostics -> ParseState {
        List[bool]::new = store_mutated
        false store_mutated.push
        List[bool]::new = recovery_required
        false recovery_required.push
        List[bool]::new = output_usable
        true output_usable.push
        store_mutated recovery_required output_usable diagnostics ParseState
    }

    fn record_error self:ParseState kind:ErrorKind message:str location:Location {
        location message kind self.diagnostics.record_error
    }

    fn record_error_expected
        self:ParseState
        kind:ErrorKind
        message:str
        location:Location
        expected:str
        got:str
    {
        got expected location message kind CasaError::with_expected self.diagnostics.push_error
    }

    fn mark_output_unusable self:ParseState {
        false 0 self.output_usable.set
    }

    fn has_usable_output self:ParseState -> bool {
        0 self.output_usable.get
    }

    fn request_recovery self:ParseState {
        true 0 self.recovery_required.set
    }

    fn take_recovery_request self:ParseState -> bool {
        0 self.recovery_required.get = requested
        false 0 self.recovery_required.set
        requested
    }

    fn reset_store_mutation self:ParseState {
        false 0 self.store_mutated.set
    }

    fn mark_store_mutated self:ParseState {
        true 0 self.store_mutated.set
    }

    fn store_was_mutated self:ParseState -> bool {
        0 self.store_mutated.get
    }
}

struct Parser {
    store:          SymbolStore
    included_files: Set[str]
    search_paths:   List[str]
    sources:        SourceStore
    state:          ParseState
}

struct ParseResolveResult {
    ops:         Option[List[Op]]
    store:       SymbolStore
    diagnostics: Diagnostics
}

impl Parser {
    fn new store:SymbolStore diagnostics:Diagnostics sources:SourceStore -> Parser {
        diagnostics ParseState::new
        sources
        List[str]::new
        Set[str]::new
        store
        Parser
    }

    fn put_function self:Parser name:str function:Function {
        self.state.mark_store_mutated
        function name self.store.functions.set drop
    }

    fn put_constant self:Parser name:str constant:Constant {
        self.state.mark_store_mutated
        constant name self.store.constants.set drop
    }

    fn put_enum self:Parser name:str casa_enum:CasaEnum {
        self.state.mark_store_mutated
        casa_enum name self.store.enums.set drop
    }

    fn put_struct self:Parser name:str casa_struct:CasaStruct {
        self.state.mark_store_mutated
        casa_struct name self.store.structs.set drop
    }

    fn put_trait self:Parser name:str casa_trait:CasaTrait {
        self.state.mark_store_mutated
        casa_trait name self.store.traits.set drop
    }
}

impl[T] Map[str T] {
    fn merge_missing self:Map[str T] source:Map[str T] {
        for name in source.keys.iter do
            if name self.has ! then
                name source.get.unwrap name self.set drop
            fi
        done
    }
}

impl SymbolStore {
    fn merge_import self:SymbolStore imported:SymbolStore {
        for name in imported.functions.keys.iter do
            name imported.functions.get.unwrap = imported_function
            if name self.functions.get Option::Some(existing_function) is then
                if imported_function.is_used then true = existing_function.is_used fi
            fi
        done
        imported.functions self.functions.merge_missing
        imported.variables self.variables.merge_missing
        imported.constants self.constants.merge_missing
        imported.enums self.enums.merge_missing
        imported.structs self.structs.merge_missing
        imported.traits self.traits.merge_missing
    }

    fn clone self:SymbolStore -> SymbolStore {
        symbol_store_new = cloned
        self cloned.merge_import
        for name in self.functions.keys.iter do
            name self.functions.get.unwrap = function
            function.clone_for_import = cloned_function
            cloned_function name cloned.functions.set drop
        done
        cloned
    }
}

# ============================================================================
# Simple keyword -> OpValue lookup (no-payload variants only)
# ============================================================================

fn keyword_to_op_value keyword_kind:KeywordKind -> Option[OpValue] {
    keyword_kind match
        KeywordKind::Break => OpValue::WhileBreak Option::Some
        KeywordKind::Continue => OpValue::WhileContinue Option::Some
        KeywordKind::Do => OpValue::WhileCondition Option::Some
        KeywordKind::Done => OpValue::WhileEnd Option::Some
        KeywordKind::Elif => OpValue::IfElif Option::Some
        KeywordKind::Else => OpValue::IfElse Option::Some
        KeywordKind::Fi => OpValue::IfEnd Option::Some
        KeywordKind::If => OpValue::IfStart Option::Some
        KeywordKind::Return => OpValue::FnReturn Option::Some
        KeywordKind::Then => OpValue::IfCondition Option::Some
        KeywordKind::While => OpValue::WhileStart Option::Some
        _ => Option[OpValue]::None
    end
}

# ============================================================================
# Operator -> OpValue lookup
# ============================================================================

fn operator_to_op_value operator_kind:OperatorKind -> Option[OpValue] {
    operator_kind match
        OperatorKind::Plus => OpValue::Add Option::Some
        OperatorKind::Minus => OpValue::Sub Option::Some
        OperatorKind::Mul => OpValue::Mul Option::Some
        OperatorKind::Div => OpValue::Div Option::Some
        OperatorKind::Mod => OpValue::Mod Option::Some
        OperatorKind::Shl => OpValue::Shl Option::Some
        OperatorKind::Shr => OpValue::Shr Option::Some
        OperatorKind::BitAnd => OpValue::BitAnd Option::Some
        OperatorKind::BitOr => OpValue::BitOr Option::Some
        OperatorKind::BitXor => OpValue::BitXor Option::Some
        OperatorKind::BitNot => OpValue::BitNot Option::Some
        OperatorKind::And => OpValue::And Option::Some
        OperatorKind::Or => OpValue::Or Option::Some
        OperatorKind::Not => OpValue::Not Option::Some
        OperatorKind::Eq => OpValue::Eq Option::Some
        OperatorKind::Ge => OpValue::Ge Option::Some
        OperatorKind::Gt => OpValue::Gt Option::Some
        OperatorKind::Le => OpValue::Le Option::Some
        OperatorKind::Lt => OpValue::Lt Option::Some
        OperatorKind::Ne => OpValue::Ne Option::Some
        _ => Option[OpValue]::None
    end
}

fn op_value_to_operator_kind op_value:OpValue -> Option[OperatorKind] {
    op_value match
        OpValue::Add => OperatorKind::Plus Option::Some
        OpValue::Sub => OperatorKind::Minus Option::Some
        OpValue::Mul => OperatorKind::Mul Option::Some
        OpValue::Div => OperatorKind::Div Option::Some
        OpValue::Mod => OperatorKind::Mod Option::Some
        OpValue::Shl => OperatorKind::Shl Option::Some
        OpValue::Shr => OperatorKind::Shr Option::Some
        OpValue::BitAnd => OperatorKind::BitAnd Option::Some
        OpValue::BitOr => OperatorKind::BitOr Option::Some
        OpValue::BitXor => OperatorKind::BitXor Option::Some
        OpValue::BitNot => OperatorKind::BitNot Option::Some
        OpValue::And => OperatorKind::And Option::Some
        OpValue::Or => OperatorKind::Or Option::Some
        OpValue::Not => OperatorKind::Not Option::Some
        OpValue::Eq => OperatorKind::Eq Option::Some
        OpValue::Ge => OperatorKind::Ge Option::Some
        OpValue::Gt => OperatorKind::Gt Option::Some
        OpValue::Le => OperatorKind::Le Option::Some
        OpValue::Lt => OperatorKind::Lt Option::Some
        OpValue::Ne => OperatorKind::Ne Option::Some
        _ => Option[OperatorKind]::None
    end
}

# ============================================================================
# Token cursor
# ============================================================================

struct TokenCursor {
    tokens: List[Token]
    pos:    u64
    state:  ParseState
}

impl TokenCursor {
    fn new tokens:List[Token] state:ParseState -> TokenCursor {
        state 0 tokens TokenCursor
    }

    fn pop self:TokenCursor -> Option[Token] {
        if self TokenCursor::tokens.length self TokenCursor::pos >= then
            Option::None return
        fi
        self TokenCursor::pos self TokenCursor::tokens.get = token
        self TokenCursor::pos 1 + self TokenCursor::set_pos
        token Option::Some
    }

    fn peek self:TokenCursor -> Option[Token] {
        if self TokenCursor::tokens.length self TokenCursor::pos >= then
            Option::None return
        fi
        self TokenCursor::pos self TokenCursor::tokens.get Option::Some
    }

    fn is_finished self:TokenCursor -> bool {
        self TokenCursor::tokens.length self TokenCursor::pos >=
    }

    fn advance self:TokenCursor {
        self TokenCursor::pos 1 + self TokenCursor::set_pos
    }

    fn retreat self:TokenCursor {
        self TokenCursor::pos 1 - self TokenCursor::set_pos
    }

    fn save self:TokenCursor -> u64 {
        self TokenCursor::pos
    }

    fn restore self:TokenCursor saved:u64 {
        saved self TokenCursor::set_pos
    }

    fn recover_at_structure self:TokenCursor -> bool {
        if 0 self.pos > then
            self.pos 1 - self.tokens.get = previous
            if previous is_parser_synchronization_token then true return fi
        fi
        while self.is_finished ! do
            self.peek.unwrap = token
            if token is_parser_synchronization_token then
                if token is_parser_delimiter then self.advance fi
                true return
            fi
            self.advance
        done
        false
    }
}

fn is_parser_synchronization_token token:Token -> bool {
    if token is_parser_delimiter then true return fi
    token.value = value
    "fn" value ==
    "enum" value == ||
    "struct" value == ||
    "trait" value == ||
    "impl" value == ||
    "import" value == ||
    "const" value == ||
}

fn is_parser_delimiter token:Token -> bool {
    token.value = value
    "}" value == "fi" value == || "done" value == || "end" value == ||
}

# ============================================================================
# expect_token - consume next token, error if mismatch
# ============================================================================

fn fallback_token -> Token {
    empty_location TokenKind::Eof "" Token::new
}

fn expect_token cursor:TokenCursor -> Option[Token] {
    cursor.pop = result_opt
    if result_opt.is_none then
        empty_location "Unexpected end of input" ErrorKind::UnexpectedToken cursor.state.record_error
        cursor.state.mark_output_unusable
        cursor.state.request_recovery
        Option::None return
    fi
    result_opt.unwrap = token
    if TokenKind::Eof token Token::kind == then
        token Token::location "Unexpected end of input" ErrorKind::UnexpectedToken cursor.state.record_error
        cursor.state.mark_output_unusable
        cursor.state.request_recovery
        Option::None return
    fi
    token Option::Some
}

fn expect_token_value cursor:TokenCursor expected:str -> Option[Token] {
    cursor expect_token = token_opt
    if token_opt.is_none then Option::None return fi
    token_opt.unwrap = token
    if expected token Token::value != then
        cursor.retreat
        f"`{token Token::value}`"
        f"`{expected}`"
        token Token::location
        "Unexpected token"
        ErrorKind::UnexpectedToken
        cursor.state.record_error_expected
        cursor.state.request_recovery
        Option::None return
    fi
    token Option::Some
}

fn expect_token_kind cursor:TokenCursor expected_kind:TokenKind -> Option[Token] {
    cursor expect_token = token_opt
    if token_opt.is_none then Option::None return fi
    token_opt.unwrap = token
    if expected_kind token Token::kind != then
        cursor.retreat
        token Token::location "Unexpected token" ErrorKind::UnexpectedToken cursor.state.record_error
        cursor.state.request_recovery
        Option::None return
    fi
    token Option::Some
}

# ============================================================================
# expect_delimiter - consume expected delimiter or return None
# ============================================================================

fn expect_delimiter cursor:TokenCursor expected_value:str -> bool {
    cursor.peek = peek_opt
    if peek_opt.is_none then false return fi
    peek_opt.unwrap = token
    if expected_value token Token::value != then false return fi
    cursor.advance
    true
}

# ============================================================================
# parse_type - parse a type expression
# ============================================================================

fn parse_type_ast cursor:TokenCursor -> Type {
    cursor.peek = peek_opt
    if peek_opt.is_none then
        empty_location "Expected type" ErrorKind::UnexpectedToken cursor.state.record_error
        Type::Unknown return
    fi
    peek_opt.unwrap = peek

    "" = base
    if "fn" peek Token::value == then
        cursor.pop drop
        "fn" = base
    else
        fallback_token cursor expect_token.unwrap_or = base_token
        if TokenKind::Identifier base_token Token::kind != then
            base_token Token::location "Expected type name" ErrorKind::UnexpectedToken cursor.state.record_error
        fi
        base_token Token::value = base
    fi

    cursor.peek = next_opt
    if next_opt.is_none then base parse_type_str return fi
    if next_opt Option::Some(next) is then
        if "[" next Token::value != then base parse_type_str return fi
    fi
    cursor.advance # consume [

    if "fn" base == then
        List[Type]::new = fn_params
        List[Type]::new = fn_returns
        false = past_arrow
        while cursor.is_finished ! do
            cursor.peek = inner_opt
            if inner_opt.is_none then break fi
            inner_opt.unwrap Token::value = ival
            if "]" ival == then
                cursor.pop drop
                break
            fi
            if "->" ival == then
                cursor.pop drop
                true = past_arrow
                continue
            fi
            cursor parse_type_ast = inner_type
            if past_arrow then
                inner_type fn_returns.push
            else
                inner_type fn_params.push
            fi
        done
        fn_returns fn_params FunctionType Type::Function return
    fi

    List[Type]::new = inner_types
    while true do
        cursor.peek = inner_opt
        if inner_opt Option::Some(inner) is then
            if "]" inner Token::value == then
                cursor.pop drop
                break
            fi
        fi
        cursor parse_type_ast inner_types.push
    done
    if 0 inner_types.length == then
        empty_location f"Expected type parameter inside `{base}[...]`" ErrorKind::UnexpectedToken cursor.state.record_error
    fi
    inner_types base GenericType Type::Generic
}

# ============================================================================
# get_op_type_cast - parse (type) cast
# ============================================================================

fn get_op_type_cast cursor:TokenCursor -> Op {
    fallback_token "(" cursor expect_token_value.unwrap_or = open_token
    cursor parse_type_ast = cast_type
    fallback_token ")" cursor expect_token_value.unwrap_or = close_token

    open_token Token::location Location::span Span::offset = open_offset
    close_token Token::location Location::span Span::offset = close_offset
    close_offset open_offset - 1 + = length
    length open_offset open_token Token::location Location::file Location::new = loc

    loc cast_type OpValue::TypeCast Op::new
}

# ============================================================================
# get_op_literal - convert literal token to push op
# ============================================================================

fn get_op_literal token:Token cursor:TokenCursor -> Op {
    token Token::value = value
    if "true" value == then
        token Token::location 1 OpValue::PushBool Op::new return
    fi
    if "false" value == then
        token Token::location 0 OpValue::PushBool Op::new return
    fi
    # Numeric literal (positive or negative)
    if value is_float_literal then
        token Token::location value OpValue::PushFloat Op::new return
    fi
    if 0 value.at.is_digit value is_negative_integer_literal || then
        value str_to_int = int_value
        token Token::location int_value value IntegerLiteral::new OpValue::PushInt Op::new return
    fi
    # Char literal: 'X'
    if
    '\'' 0 value.at ==
    '\'' value.length 1 - value.at == &&
    3 value.length == &&
    then
        1 value.at (i64) = char_value
        token Token::location char_value OpValue::PushChar Op::new return
    fi
    # String literal: "..."
    if '"' 0 value.at == '"' value.length 1 - value.at == && then
        value 1 value.length 2 - str::substring = str_value
        token Token::location str_value OpValue::PushStr Op::new return
    fi
    token Token::location f"Token `{value}` is not a literal" ErrorKind::Syntax cursor.state.record_error
    token Token::location 0 make_integer_op_value Op::new
}

# ============================================================================
# get_op_intrinsic - convert intrinsic token to op
# ============================================================================

fn get_op_intrinsic token:Token cursor:TokenCursor -> Op {
    token Token::value intrinsic_from_str = kind_opt
    if kind_opt.is_none then
        token Token::location f"Token `{token Token::value}` is not an intrinsic" ErrorKind::Syntax cursor.state.record_error
    fi
    kind_opt.unwrap = intrinsic_kind
    intrinsic_kind intrinsic_to_op_value = op_value_opt
    if op_value_opt.is_none then
        token Token::location f"No OpValue for intrinsic `{token Token::value}`" ErrorKind::Syntax cursor.state.record_error
    fi
    if op_value_opt Option::Some(op_value) is then
        token Token::location op_value Op::new return
    fi
    token Token::location 0 make_integer_op_value Op::new
}

# ============================================================================
# get_op_operator - convert operator token to op
# ============================================================================

fn parse_assignment_target cursor:TokenCursor -> Location str {
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = root_token
    root_token Token::value = target
    while "." cursor expect_delimiter do
        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or Token::value = field
        f"{target}.{field}" = target
    done
    root_token Token::location
    target
}

fn get_op_operator token:Token cursor:TokenCursor function_name:str -> Op {
    token Token::value operator_from_str = kind_opt
    if kind_opt.is_none then
        token Token::location f"Token `{token Token::value}` is not an operator" ErrorKind::Syntax cursor.state.record_error
    fi
    kind_opt.unwrap = operator_kind

    # Assignment: = varname
    if OperatorKind::Assign operator_kind == then
        cursor parse_assignment_target = var_name = target_location

        # Optional type annotation: = varname : type
        Option[Type]::None = type_hint
        cursor.peek = colon_opt
        if colon_opt Option::Some(colon) is then
            if ":" colon Token::value == then
                cursor.advance
                cursor parse_type_ast Option::Some = type_hint
            fi
        fi
        target_location var_name OpValue::AssignVar Op::new = assign_op
        if type_hint Option::Some(hint) is then
            hint Option::Some = assign_op.type_hint
        fi
        assign_op
        return
    fi

    # Compound assignment: += varname
    if OperatorKind::AssignInc operator_kind == then
        cursor parse_assignment_target = inc_target = inc_location
        inc_location inc_target OpValue::AssignInc Op::new return
    fi

    # Compound assignment: -= varname
    if OperatorKind::AssignDec operator_kind == then
        cursor parse_assignment_target = dec_target = dec_location
        dec_location dec_target OpValue::AssignDec Op::new return
    fi

    # Simple operator -> OpValue lookup
    operator_kind operator_to_op_value = op_value_opt
    if op_value_opt.is_none then
        token Token::location f"No OpValue for operator `{token Token::value}`" ErrorKind::Syntax cursor.state.record_error
    fi
    if op_value_opt Option::Some(op_value) is then
        token Token::location op_value Op::new return
    fi
    token Token::location 0 make_integer_op_value Op::new
}

# ============================================================================
# Forward declarations (functions that call each other)
# ============================================================================
# token_to_op, parse_block_ops, handle_fstring are mutually recursive
# In Casa, we just define them in order and rely on global function lookup.
# ============================================================================
# get_op_array - parse [item1, item2] array literal
# ============================================================================

fn parse_array_struct_literal
    parser:Parser
    function_name:str
    cursor:TokenCursor
    name_token:Token
    items:List[Op]
{
    function_name cursor name_token parser parse_struct_literal = struct_ops
    name_token Token::location struct_ops OpValue::ExprGroup Op::new items.push
}

fn parse_array_lambda
    parser:Parser
    function_name:str
    cursor:TokenCursor
    brace_token:Token
    items:List[Op]
{
    cursor.retreat
    f"lambda__{function_name}_o{brace_token Token::location Location::span Span::offset}" = arr_lam_name
    arr_lam_name cursor parser parse_block_ops = arr_lam_ops
    brace_token Token::location arr_lam_ops arr_lam_name Function::new = arr_lam_fn
    arr_lam_fn arr_lam_name parser.put_function
    brace_token Token::location arr_lam_name OpValue::FnPush Op::new items.push
}

fn get_op_array parser:Parser function_name:str cursor:TokenCursor -> Op {
    fallback_token "[" cursor expect_token_value.unwrap_or = open_token
    List[Op]::new = items
    while "]" cursor expect_delimiter ! do
        cursor.peek = next_opt
        if next_opt Option::Some(next) is then
            if "[" next Token::value == then
                cursor function_name parser get_op_array items.push
                "," cursor expect_delimiter drop
                continue
            fi
        fi
        cursor.pop = value_opt
        if value_opt.is_none then
            open_token Token::location "Unexpected end of input in array literal" ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            open_token.location items OpValue::PushArray Op::new return
        fi
        value_opt.unwrap = value_token
        if "{" value_token Token::value == then
            items value_token cursor function_name parser parse_array_lambda
        elif TokenKind::Literal value_token Token::kind == then
            cursor value_token get_op_literal items.push
        elif TokenKind::Identifier value_token Token::kind == then
            cursor.peek = struct_peek_opt
            if struct_peek_opt Option::Some(struct_peek) is then
                if "{" struct_peek Token::value == then
                    items value_token cursor function_name parser parse_array_struct_literal
                else
                    value_token Token::location value_token Token::value OpValue::Identifier Op::new items.push
                fi
            else
                value_token Token::location value_token Token::value OpValue::Identifier Op::new items.push
            fi
        else
            value_token Token::location "Unexpected token in array literal" ErrorKind::UnexpectedToken parser.state.record_error
        fi
        "," cursor expect_delimiter drop
    done
    open_token Token::location items OpValue::PushArray Op::new
}

# ============================================================================
# parse_block_ops - parse { ... } delimited block
# ============================================================================

fn parse_block_ops parser:Parser cursor:TokenCursor function_name:str -> List[Op] {
    fallback_token "{" cursor expect_token_value.unwrap_or = open_token
    List[Op]::new = ops
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            open_token Token::location "Unclosed block" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            ops return
        fi
        token_opt.unwrap = token
        if TokenKind::Comment token Token::kind == then continue fi
        if TokenKind::Newline token Token::kind == then continue fi
        if "}" token Token::value == then
            ops return
        fi
        if TokenKind::FstringStart token Token::kind == then
            ops function_name cursor token parser handle_fstring
            continue
        fi
        ops function_name cursor token parser token_to_op
    done
    ops
}

# ============================================================================
# handle_fstring - parse f-string tokens into ops
# ============================================================================

fn parse_fstring_expr parser:Parser cursor:TokenCursor function_name:str -> List[Op] {
    List[Op]::new = ops
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then break fi
        token_opt.unwrap = token
        if TokenKind::FstringExprEnd token Token::kind == then
            break
        fi
        if TokenKind::FstringStart token Token::kind == then
            ops function_name cursor token parser handle_fstring
            continue
        fi
        ops function_name cursor token parser token_to_op
    done
    ops
}

fn handle_fstring
    parser:Parser
    start_token:Token
    cursor:TokenCursor
    function_name:str
    ops:List[Op]
{
    0 (u64) = part_count
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then break fi
        token_opt.unwrap = token
        if TokenKind::FstringText token Token::kind == then
            token Token::location token Token::value OpValue::PushStr Op::new ops.push
            1 += part_count
        elif TokenKind::FstringExprStart token Token::kind == then
            function_name cursor parser parse_fstring_expr = expr_ops
            f"lambda__{function_name}_o{token Token::location Location::span Span::offset}" = lambda_name
            token Token::location expr_ops lambda_name Function::new = lambda_function
            lambda_function lambda_name parser.put_function
            token Token::location lambda_name OpValue::FnPush Op::new ops.push
            token Token::location OpValue::FnExec Op::new ops.push
            token Token::location OpValue::FstringToStr Op::new ops.push
            1 += part_count
        elif TokenKind::FstringEnd token Token::kind == then
            break
        fi
    done
    if 0 part_count == then
        start_token Token::location "" OpValue::PushStr Op::new ops.push
        1 (u64) = part_count
    fi
    if 1 part_count > then
        start_token Token::location part_count OpValue::FstringConcat Op::new ops.push
    fi
}

# ============================================================================
# get_op_delimiter - convert delimiter token to op
# ============================================================================

fn get_op_delimiter parser:Parser token:Token cursor:TokenCursor function_name:str ops:List[Op] {
    token Token::value = value

    # Dot . method
    if "." value == then
        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = method_token
        method_token Token::location method_token Token::value OpValue::MethodCall Op::new ops.push
        return
    fi

    # Open brace { -> lambda
    if "{" value == then
        cursor.retreat
        f"lambda__{function_name}_o{token Token::location Location::span Span::offset}" = lambda_name
        lambda_name cursor parser parse_block_ops = lambda_ops
        token Token::location lambda_ops lambda_name Function::new = lambda_function
        lambda_function lambda_name parser.put_function
        token Token::location lambda_name OpValue::FnPush Op::new ops.push
        return
    fi

    # Open bracket [ -> array literal
    if "[" value == then
        cursor.retreat
        cursor function_name parser get_op_array ops.push
        return
    fi

    # Open paren ( -> type cast
    if "(" value == then
        cursor.retreat
        cursor get_op_type_cast ops.push
        return
    fi

    # Other delimiters (comma, colon, close brace/bracket/paren, fat arrow, hashtag)
    # are ignored or handled by their enclosing constructs
}

# ============================================================================
# _try_parse_is_check - try parsing Enum::Variant is
# ============================================================================

fn try_parse_is_check token:Token cursor:TokenCursor -> Option[Op] {
    cursor.save = saved_pos
    cursor.peek ? = peek_token

    List[str]::new = bindings

    # Check for bindings: Enum::Variant(a b) is
    if "(" peek_token Token::value == then
        cursor.pop drop # consume (
        while true do
            cursor.peek = inner_opt
            if inner_opt.is_none then
                saved_pos cursor.restore
                Option::None return
            fi
            inner_opt.unwrap = inner
            if ")" inner Token::value == then
                cursor.pop drop # consume )
                if 0 bindings.length == then
                    saved_pos cursor.restore
                    Option::None return
                fi
                break
            fi
            if TokenKind::Identifier inner Token::kind != then
                saved_pos cursor.restore
                Option::None return
            fi
            cursor.pop drop
            inner Token::value bindings.push
        done
    fi

    # Check if next token is `is`
    cursor.peek = is_opt
    if is_opt.is_none then
        saved_pos cursor.restore
        Option::None return
    fi
    if is_opt Option::Some(is_token) is then
        if "is" is_token Token::value != then
            saved_pos cursor.restore
            Option::None return
        fi
    fi
    cursor.pop drop # consume `is`

    # Split token value on ::
    token Token::value "::" str::find = separator
    token Token::value 0 separator (u64) str::substring = enum_name
    token Token::value separator 2 + (u64) token Token::value.length separator (u64) - 2 - str::substring = variant_name

    Option::None variant_name enum_name EnumVariant::new = variant
    bindings variant EnumVariant::set_bindings
    token Token::location variant OpValue::IsCheck Op::new Option::Some
}

# ============================================================================
# _require_global_scope
# ============================================================================

fn require_global_scope function_name:str what:str location:Location parser:Parser {
    if GLOBAL_SCOPE_LABEL function_name != then
        location f"{what} should be defined in the global scope" ErrorKind::InvalidScope parser.state.record_error
    fi
}

# ============================================================================
# parse_type_variables - parse [T, K: Hashable] type variable lists
# ============================================================================

struct ParsedTypeVariables {
    names:        List[str]
    trait_bounds: Map[str TraitBound]
}

# Parse the `[arg1 arg2 ...]` type argument list that follows a generic trait
# name in a trait bound (e.g. `I: Iterable[i64]`). The caller has already
# consumed the trait identifier. If the next token is not `[`, returns an
# empty list. Otherwise parses each argument as a Type AST value.

fn parse_bound_type_args cursor:TokenCursor trait_token:Token -> List[Type] {
    List[Type]::new = bound_args
    cursor.peek = bracket_opt
    if bracket_opt.is_none then bound_args return fi
    if bracket_opt Option::Some(bracket) is then
        if "[" bracket Token::value != then bound_args return fi
    fi
    cursor.pop drop
    while true do
        cursor.peek = argument_token_option
        if argument_token_option.is_none then
            trait_token Token::location "Unclosed trait bound type argument list" ErrorKind::Syntax cursor.state.record_error
            cursor.state.mark_output_unusable
            bound_args return
        fi
        argument_token_option.unwrap Token::value = argument_value
        if "]" argument_value == then
            cursor.pop drop
            bound_args return
        fi
        if "," argument_value == then
            cursor.pop drop
            continue
        fi
        cursor parse_type_ast bound_args.push
    done
    bound_args
}

fn parse_type_variables parser:Parser cursor:TokenCursor -> ParsedTypeVariables {
    fallback_token "[" cursor expect_token_value.unwrap_or drop
    List[str]::new = vars
    Set[str]::new = seen
    Map[str TraitBound]::new = trait_bounds

    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            empty_location "Expected `]` to close type parameters" ErrorKind::Syntax parser.state.record_error
            parser.state.mark_output_unusable
            trait_bounds vars ParsedTypeVariables return
        fi
        token_opt.unwrap = token
        if "]" token Token::value == then
            if 0 vars.length == then
                token Token::location "Empty type parameter list `[]` is not allowed" ErrorKind::Syntax parser.state.record_error
            fi
            trait_bounds vars ParsedTypeVariables return
        fi
        if "," token Token::value == then continue fi
        if TokenKind::Identifier token Token::kind == then
            if token Token::value parser.store.builtins.has then
                token Token::location f"Type variable `{token Token::value}` shadows built-in type" ErrorKind::DuplicateName parser.state.record_error
            fi
            if token Token::value seen.has then
                token Token::location f"Duplicate type variable `{token Token::value}`" ErrorKind::DuplicateName parser.state.record_error
            fi
            token Token::value vars.push
            token Token::value seen.add = seen
            # Check for trait bound: K: Hashable  or  K: Iterable[i64]
            cursor.peek = colon_opt
            if colon_opt Option::Some(colon) is then
                if ":" colon Token::value == then
                    cursor.pop drop # consume :
                    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = trait_token
                    trait_token Token::value = bound_trait_name
                    bound_trait_name parser.store.traits.get = bound_trait_def_opt
                    if bound_trait_def_opt.is_none then
                        trait_token Token::location f"Trait `{bound_trait_name}` is not defined" ErrorKind::UndefinedName parser.state.record_error
                    fi
                    trait_token cursor parse_bound_type_args = bound_args
                    if bound_trait_def_opt Option::Some(bound_trait_def) is then
                        # Arity check against trait's declared type_params
                        bound_trait_def CasaTrait::type_params = declared_params
                        if bound_args.length declared_params.length != then
                            trait_token Token::location f"Trait `{bound_trait_name}` expects {declared_params.length} type argument(s), got {bound_args.length}" ErrorKind::Syntax parser.state.record_error
                        fi
                        bound_args bound_trait_name TraitBound = ptv_bound
                        ptv_bound token Token::value trait_bounds.set = trait_bounds
                    fi
                fi
            fi
        else
            token Token::location "Unexpected token in type parameters" ErrorKind::UnexpectedToken parser.state.record_error
        fi
    done
    trait_bounds vars ParsedTypeVariables
}

# ============================================================================
# parse_parameters - parse name:type parameter pairs
# ============================================================================
# Given an identifier `token` just popped from `cursor`, produce either a
# named parameter (`name:type`) if the next token is `:`, or an unnamed
# parameter by rewinding and re-parsing as a type expression.

fn parse_parameter_maybe_named cursor:TokenCursor token:Token -> Parameter {
    cursor.peek = next_opt
    if { Token::value ":" == } next_opt.filter.is_some then
        cursor.advance # consume :
        cursor parse_type_ast = param_type
        token Token::value param_type Parameter::named return
    fi
    cursor.retreat
    "" cursor parse_type_ast Parameter::named
}

fn parse_parameters cursor:TokenCursor -> List[Parameter] {
    List[Parameter]::new = params
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            empty_location "Unexpected end of input" ErrorKind::UnexpectedToken cursor.state.record_error
            cursor.state.mark_output_unusable
            params return
        fi
        token_opt.unwrap = token

        # Stop at -> or {
        if "->" token Token::value == "{" token Token::value == || then
            cursor.retreat
            params return
        fi

        # Allow fn keyword as unnamed parameter type
        if "fn" token Token::value == then
            cursor.retreat
            "" cursor parse_type_ast Parameter::named params.push
            continue
        fi

        if TokenKind::Identifier token Token::kind != then
            token Token::location "Unexpected token in parameter list" ErrorKind::UnexpectedToken cursor.state.record_error
        fi

        token cursor parse_parameter_maybe_named params.push
    done
    params
}

# ============================================================================
# parse_return_types - parse return types after ->
# ============================================================================

fn parse_return_types cursor:TokenCursor -> List[Type] {
    List[Type]::new = types
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            empty_location "Unexpected end of input" ErrorKind::UnexpectedToken cursor.state.record_error
            cursor.state.mark_output_unusable
            types return
        fi
        if peek_opt Option::Some(peek) is then
            if "{" peek Token::value == then
                types return
            fi
        fi
        cursor parse_type_ast types.push
    done
    types
}

# ============================================================================
# parse_stack_effect - parse function stack effect
# ============================================================================

fn parse_stack_effect cursor:TokenCursor -> StackEffect {
    cursor parse_parameters = params
    List[Type]::new = returns

    cursor.peek = next_opt
    if next_opt.is_none then
        empty_location "Unexpected end of input" ErrorKind::UnexpectedToken cursor.state.record_error
        cursor.state.mark_output_unusable
        returns params StackEffect::new return
    fi
    if next_opt Option::Some(next) is then
        if "->" next Token::value == then
            cursor.advance # consume ->
            cursor parse_return_types = returns
        fi
    fi
    returns params StackEffect::new
}

# ============================================================================
# build_hidden_trait_methods - shared hidden-param construction
# ============================================================================
#
# Walks the given trait bounds and returns a flat list of (var_name, fn_type)
# pairs describing each hidden `__trait_{type_var}_{method}` parameter that
# must be injected. Used by both parse_function and inject_impl_trait_params.
# Bounds whose trait is not registered in the store are silently skipped,
# matching the pre-extraction behavior of both call sites.

fn build_hidden_trait_methods
    parser:Parser
    trait_bounds:Map[str TraitBound]
-> List[HiddenTraitMethod] {
    List[HiddenTraitMethod]::new = result
    trait_bounds.keys = bound_keys
    for bound_type_var in bound_keys.iter do
        bound_type_var trait_bounds.get.unwrap = bound
        bound TraitBound::name parser.store.traits.get = bound_trait_opt
        if bound_trait_opt.is_some then
            bound_trait_opt.unwrap = bound_trait
            # Build substitution map from trait's declared type_params to the
            # concrete type_args carried on the bound.
            Map[str Type]::new = bound_subs
            bound_trait CasaTrait::type_params = bhtm_params
            bound TraitBound::type_args = bhtm_args
            if bhtm_params.length bhtm_args.length == then
                for pair in bhtm_args.iter bhtm_params.iter.zip do
                    pair.second pair.first bound_subs.set = bound_subs
                done
            fi
            for bound_method in bound_trait parser.store collect_trait_methods.iter do
                # Skip default methods — only abstract methods need hidden fn ptrs
                if 0 bound_method TraitMethod::default_ops.length == then
                    f"__trait_{bound_type_var}_{bound_method TraitMethod::name}" = hidden_name
                    bound_subs bound_type_var Type::TypeVar bound_method TraitMethod::stack_effect resolve_trait_stack_effect apply_type_subs_to_stack_effect = hidden_stack_effect
                    hidden_stack_effect stack_effect_to_function_type = hidden_type
                    hidden_type hidden_name HiddenTraitMethod result.push
                fi
            done
        fi
    done
    result
}

# ============================================================================
# parse_literal_to_constant_value - parse a raw literal string to ConstantValue
# ============================================================================

fn parse_literal_to_constant_value raw:str -> ConstantValue {
    if "true" raw == then
        1 ConstantValue::Bool return
    fi
    if "false" raw == then
        0 ConstantValue::Bool return
    fi
    if '"' 0 raw.at == then
        raw 1 raw.length 2 - str::substring ConstantValue::Str return
    fi
    if '\'' 0 raw.at == then
        1 raw.at (i64) ConstantValue::Char return
    fi
    if raw is_float_literal then raw ConstantValue::Float return fi
    raw str_to_int raw IntegerLiteral::new ConstantValue::Int
}

# ============================================================================
# try_fold_const_fn_call - constant-fold a const fn call with all-literal args
# ============================================================================

fn is_const_fold_literal value:OpValue -> bool {
    value OpValue::PushInt is
    value OpValue::PushFloat is ||
    value OpValue::PushStr is ||
    value OpValue::PushBool is ||
    value OpValue::PushChar is ||
}

fn try_fold_const_fn_call
    store:SymbolStore
    ops:List[Op]
    op_index:u64
    fn_name:str
    current_op:Op
    diagnostics:Diagnostics
-> u64 {
    fn_name store.functions.get = fold_fn_opt
    if fold_fn_opt.is_none then op_index return fi
    fold_fn_opt.unwrap = fold_fn
    if fold_fn Function::is_const_fn ! then op_index return fi
    for parameter in fold_fn.stack_effect.parameters.iter do
        if parameter.typ.has_unresolved_type_var parameter.typ.has_unresolved || then
            op_index return
        fi
    done
    for return_type in fold_fn.stack_effect.return_types.iter do
        if return_type.has_unresolved_type_var return_type.has_unresolved || then op_index return fi
    done
    fold_fn Function::stack_effect StackEffect::parameters.length = fold_param_count
    op_index 1 - = call_idx
    call_idx fold_param_count - = first_arg_idx
    if 0 first_arg_idx > then op_index return fi
    first_arg_idx = check_idx
    while check_idx call_idx > do
        check_idx ops.get Op::value = check_val
        if check_val is_const_fold_literal ! then op_index return fi
        1 += check_idx
    done
    List[ConstantValue]::new = fold_stack
    List[str]::new = fold_eval_stack
    first_arg_idx = load_idx
    while load_idx call_idx > do
        load_idx ops.get Op::value = load_val
        if load_val OpValue::PushInt(li) is then
            li ConstantValue::Int fold_stack.push
        elif load_val OpValue::PushFloat(float_literal) is then
            float_literal ConstantValue::Float fold_stack.push
        elif load_val OpValue::PushStr(ls) is then
            ls ConstantValue::Str fold_stack.push
        elif load_val OpValue::PushBool(lb) is then
            lb ConstantValue::Bool fold_stack.push
        elif load_val OpValue::PushChar(lc) is then
            lc ConstantValue::Char fold_stack.push
        fi
        1 += load_idx
    done
    if diagnostics fold_eval_stack current_op Op::location fold_stack fn_name store eval_const_fn ! then
        op_index return
    fi
    fold_stack.pop = fold_result
    fold_result match
        ConstantValue::Int(ri) => { ri OpValue::PushInt first_arg_idx ops.get Op::set_value }
        ConstantValue::Float(float_result) => { float_result OpValue::PushFloat first_arg_idx ops.get Op::set_value }
        ConstantValue::Str(rs) => { rs OpValue::PushStr first_arg_idx ops.get Op::set_value }
        ConstantValue::Bool(rb) => { rb OpValue::PushBool first_arg_idx ops.get Op::set_value }
        ConstantValue::Char(rc) => { rc OpValue::PushChar first_arg_idx ops.get Op::set_value }
    end
    if 1 fold_fn.stack_effect.return_types.length == then
        0 fold_fn.stack_effect.return_types.get Option::Some
        first_arg_idx ops.get Op::set_type_hint
    fi
    first_arg_idx 1 + = shift_dst
    call_idx 1 + = shift_src
    while shift_src ops.length > do
        shift_src ops.get shift_dst ops.set
        1 += shift_src
        1 += shift_dst
    done
    0 (u64) = pop_count
    while pop_count fold_param_count > do
        ops.pop drop
        1 += pop_count
    done
    first_arg_idx 1 +
}

# ============================================================================
# validate_const_fn_body - ensure const fn body has no disallowed ops
# ============================================================================

fn validate_const_fn_body function:Function diagnostics:Diagnostics {
    for op in function Function::ops.iter do
        op Op::value = v
        if v OpValue::IfStart is then
            op Op::location "Control flow (`if`) is not allowed in const fn" ErrorKind::Syntax diagnostics.record_error
        fi
        if v OpValue::WhileStart is then
            op Op::location "Control flow (`while`) is not allowed in const fn" ErrorKind::Syntax diagnostics.record_error
        fi
        if v OpValue::DeclareGlobal is then
            op Op::location "Global access is not allowed in const fn" ErrorKind::Syntax diagnostics.record_error
        fi
    done
}

# ============================================================================
# eval_const_block - compile-time evaluation of const { ... } expressions
# ============================================================================

fn validate_constant_numeric
    value:ConstantValue
    target:Type
    location:Location
    diagnostics:Diagnostics
-> bool {
    value match
        ConstantValue::Int(literal) => {
            if target.is_integer_type_t ! then
                location f"Integer literal `{literal.raw}` requires an integer context, got `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error
                false return
            fi
            if target literal.fits ! then
                target.get_integer_min = minimum
                target.get_integer_max = maximum
                location f"Integer literal `{literal.raw}` is outside `{target.format}` range {minimum}..{maximum}" ErrorKind::TypeMismatch diagnostics.record_error
                false return
            fi
        }
        ConstantValue::Float(literal) => {
            if target.is_float_type_t ! then
                location f"Floating-point literal `{literal}` requires `f32` or `f64` context, got `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error
                false return
            fi
        }
        _ => { }
    end
    true
}

fn const_eval_apply_operator
    stack:List[ConstantValue]
    operator_kind:OperatorKind
    location:Location
    diagnostics:Diagnostics
{
    if operator_kind OperatorKind::Not == then
        if 0 stack.length == then
            location "Stack underflow in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
        stack.pop = a_val
        if a_val ConstantValue::Bool(a_bool) is then
            if 0 a_bool != then 0 else 1 fi ConstantValue::Bool stack.push
        elif a_val ConstantValue::Int(a_int) is then
            if diagnostics location TYPE_I64_T a_val validate_constant_numeric ! then
                0 IntegerLiteral::from_int ConstantValue::Int stack.push
                return
            fi
            if 0 a_int.value != then 0 else 1 fi ConstantValue::Bool stack.push
        else
            location "Operator `!` requires bool or i64 operand" ErrorKind::Syntax diagnostics.record_error
        fi
        return
    fi
    if operator_kind OperatorKind::BitNot == then
        if 0 stack.length == then
            location "Stack underflow in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
        stack.pop = bitnot_val
        if bitnot_val ConstantValue::Int(bitnot_int) is then
            if diagnostics location TYPE_I64_T bitnot_val validate_constant_numeric ! then
                0 IntegerLiteral::from_int ConstantValue::Int stack.push
                return
            fi
            bitnot_int.value ~ IntegerLiteral::from_int ConstantValue::Int stack.push
        else
            location "Operator `~` requires i64 operand" ErrorKind::Syntax diagnostics.record_error
        fi
        return
    fi
    if 2 stack.length < then
        location "Stack underflow in const expression" ErrorKind::Syntax diagnostics.record_error
    fi
    stack.pop = b_val
    stack.pop = a_val
    if a_val ConstantValue::Int(a_int) is then
        if b_val ConstantValue::Int(b_int) is then
            if
            diagnostics location TYPE_I64_T a_val validate_constant_numeric !
            diagnostics location TYPE_I64_T b_val validate_constant_numeric ! ||
            then
                0 IntegerLiteral::from_int ConstantValue::Int stack.push
                return
            fi
            if operator_kind OperatorKind::Plus == then
                a_int.value b_int.value + IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Minus == then
                a_int.value b_int.value - IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Mul == then
                a_int.value b_int.value * IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Div == then
                a_int.value b_int.value / IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Mod == then
                a_int.value b_int.value % IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Shl == then
                a_int.value b_int.value (u64) << IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Shr == then
                a_int.value b_int.value (u64) >> IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::BitAnd == then
                a_int.value b_int.value & IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::BitOr == then
                a_int.value b_int.value | IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::BitXor == then
                a_int.value b_int.value ^ IntegerLiteral::from_int ConstantValue::Int stack.push return
            fi
            if operator_kind OperatorKind::Eq == then
                if a_int.value b_int.value == then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Ne == then
                if a_int.value b_int.value != then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Lt == then
                if a_int.value b_int.value < then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Le == then
                if a_int.value b_int.value <= then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Gt == then
                if a_int.value b_int.value > then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Ge == then
                if a_int.value b_int.value >= then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            location "Unsupported operator for i64 operands in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
    fi
    if a_val ConstantValue::Bool(a_bool) is then
        if b_val ConstantValue::Bool(b_bool) is then
            if operator_kind OperatorKind::And == then
                if 0 a_bool != 0 b_bool != && then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Or == then
                if 0 a_bool != 0 b_bool != || then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Eq == then
                if a_bool b_bool == then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            if operator_kind OperatorKind::Ne == then
                if a_bool b_bool != then 1 else 0 fi ConstantValue::Bool stack.push return
            fi
            location "Unsupported operator for bool operands in const expression" ErrorKind::Syntax diagnostics.record_error
        fi
    fi
    location "Type mismatch in const expression" ErrorKind::Syntax diagnostics.record_error
}

fn eval_const_fn
    store:SymbolStore
    fn_name:str
    stack:List[ConstantValue]
    location:Location
    eval_stack:List[str]
    diagnostics:Diagnostics
-> bool {
    if fn_name eval_stack string_list_contains then
        location f"Cycle detected in const evaluation: `{fn_name}`" ErrorKind::Syntax diagnostics.record_error
        false return
    fi
    fn_name store.functions.get = fn_opt
    if fn_opt.is_none then
        location f"`{fn_name}` is not a const fn" ErrorKind::Syntax diagnostics.record_error
        false return
    fi
    fn_opt.unwrap = function
    if function Function::is_const_fn ! then
        location f"`{fn_name}` is not a const fn" ErrorKind::Syntax diagnostics.record_error
        false return
    fi
    fn_name eval_stack.push
    function Function::stack_effect StackEffect::parameters.length = param_count
    List[ConstantValue]::new = fn_stack
    Map[str ConstantValue]::new = locals
    if param_count stack.length < then
        location f"Not enough arguments for const fn `{fn_name}`" ErrorKind::Syntax diagnostics.record_error
        false return
    fi
    0 (u64) = pi
    while pi param_count > do
        stack.pop = argument
        pi function.stack_effect.parameters.get.typ = parameter_type
        if diagnostics location parameter_type argument validate_constant_numeric ! then
            false return
        fi
        argument fn_stack.push
        1 += pi
    done
    function Function::ops = fn_ops
    0 (u64) = oi
    while oi fn_ops.length > do
        oi fn_ops.get = fn_op
        1 += oi
        fn_op Op::value = op_value
        if op_value OpValue::PushInt(push_int) is then
            push_int ConstantValue::Int fn_stack.push
            continue
        fi
        if op_value OpValue::PushFloat(push_float) is then
            push_float ConstantValue::Float fn_stack.push
            continue
        fi
        if op_value OpValue::PushStr(push_str) is then
            push_str ConstantValue::Str fn_stack.push
            continue
        fi
        if op_value OpValue::PushBool(push_bool) is then
            push_bool ConstantValue::Bool fn_stack.push
            continue
        fi
        if op_value OpValue::PushChar(push_char) is then
            push_char ConstantValue::Char fn_stack.push
            continue
        fi
        op_value op_value_to_operator_kind = eval_op_kind_opt
        if eval_op_kind_opt Option::Some(eval_op_kind) is then
            diagnostics fn_op Op::location eval_op_kind fn_stack const_eval_apply_operator
            continue
        fi
        if op_value OpValue::FnReturn is then
            break
        fi
        if op_value OpValue::FnCall(call_name) is then
            if diagnostics eval_stack fn_op Op::location fn_stack call_name store eval_const_fn ! then
                false return
            fi
            continue
        fi
        if op_value OpValue::AssignVar(assign_name) is then
            if 0 fn_stack.length != then
                fn_stack.pop assign_name locals.set = locals
            fi
            continue
        fi
        if op_value OpValue::PushVar(var_name) is then
            var_name locals.get = local_opt
            if local_opt Option::Some(local) is then
                local fn_stack.push
                continue
            fi
            var_name store.constants.get = inner_const_opt
            if inner_const_opt Option::Some(inner_const) is then
                inner_const Constant::value fn_stack.push
                continue
            fi
            fn_op Op::location f"Cannot use variable `{var_name}` in const fn evaluation" ErrorKind::Syntax diagnostics.record_error
            false return
        fi
        if op_value OpValue::Identifier(ident_name) is then
            ident_name locals.get = local_opt
            if local_opt Option::Some(local) is then
                local fn_stack.push
                continue
            fi
            ident_name store.constants.get = inner_const_opt
            if inner_const_opt Option::Some(inner_const) is then
                inner_const Constant::value fn_stack.push
                continue
            fi
            ident_name store.functions.get = inner_fn_opt
            if inner_fn_opt Option::Some(inner_fn) is then
                if inner_fn Function::is_const_fn then
                    if diagnostics eval_stack fn_op Op::location fn_stack ident_name store eval_const_fn ! then
                        false return
                    fi
                    continue
                fi
            fi
            fn_op Op::location f"Cannot use `{ident_name}` in const fn evaluation" ErrorKind::Syntax diagnostics.record_error
            false return
        fi
        fn_op Op::location "Unsupported operation in const fn" ErrorKind::Syntax diagnostics.record_error
        false return
    done
    eval_stack.pop drop
    if 0 fn_stack.length == then
        location f"Const fn `{fn_name}` produced no value" ErrorKind::Syntax diagnostics.record_error
        false return
    fi
    fn_stack.pop stack.push
    true
}

fn eval_const_block parser:Parser cursor:TokenCursor location:Location -> ConstantValue {
    fallback_token "{" cursor expect_token_value.unwrap_or drop
    List[ConstantValue]::new = stack
    List[str]::new = eval_stack
    while true do
        cursor.pop = tok_opt
        if tok_opt.is_none then
            location "Unclosed const block expression" ErrorKind::Syntax parser.state.record_error
            parser.state.mark_output_unusable
            0 IntegerLiteral::from_int ConstantValue::Int return
        fi
        tok_opt.unwrap = tok
        if "}" tok Token::value == then break fi
        if TokenKind::Comment tok Token::kind == then continue fi
        if TokenKind::Newline tok Token::kind == then continue fi
        if TokenKind::Literal tok Token::kind == then
            tok Token::value parse_literal_to_constant_value stack.push
            continue
        fi
        if TokenKind::Operator tok Token::kind == then
            tok Token::value operator_from_str = op_kind_opt
            if op_kind_opt Option::Some(op_kind) is then
                parser.state.diagnostics tok Token::location op_kind stack const_eval_apply_operator
            fi
            continue
        fi
        if TokenKind::Identifier tok Token::kind == then
            tok Token::value = ident
            ident parser.store.constants.get = c_opt
            if c_opt Option::Some(casa_const) is then
                casa_const Constant::value stack.push
                continue
            fi
            ident parser.store.functions.get = f_opt
            if f_opt Option::Some(function) is then
                if function Function::is_const_fn then
                    if parser.state.diagnostics eval_stack tok Token::location stack ident parser.store eval_const_fn ! then
                        0 IntegerLiteral::from_int ConstantValue::Int return
                    fi
                    continue
                fi
            fi
            tok Token::location f"Cannot use `{ident}` in const block expression" ErrorKind::Syntax parser.state.record_error
        fi
        if TokenKind::Keyword tok Token::kind == then
            tok Token::location "Control flow is not allowed in const block expressions" ErrorKind::Syntax parser.state.record_error
        fi
        tok Token::location f"Unexpected token in const block expression: `{tok Token::value}`" ErrorKind::Syntax parser.state.record_error
    done
    if 0 stack.length == then
        location "Const block expression produced no value" ErrorKind::Syntax parser.state.record_error
        0 IntegerLiteral::from_int ConstantValue::Int return
    fi
    stack.pop
}

# ============================================================================
# parse_function - parse function definition
# ============================================================================

fn parse_function parser:Parser cursor:TokenCursor -> Function {
    fallback_token "fn" cursor expect_token_value.unwrap_or drop
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    # Parse optional type parameters
    List[str]::new = type_vars
    Map[str TraitBound]::new = trait_bounds
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.names = type_vars
            parsed_type_variables.trait_bounds = trait_bounds
        fi
    fi

    cursor parse_stack_effect = effect

    # Add type vars to the stack effect
    if 0 type_vars.length != then
        for type_var in type_vars.iter do
            type_var effect StackEffect::type_vars.add = new_type_vars
            new_type_vars effect StackEffect::set_type_vars
        done
        trait_bounds effect StackEffect::set_trait_bounds
        effect StackEffect::type_vars effect canonicalize_stack_effect_type_vars
    fi
    List[Op]::new = ops
    List[Variable]::new = variables

    # Inject hidden __trait_* parameters for trait-bounded type vars
    if 0 effect StackEffect::trait_bounds.keys.length != then
        List[Parameter]::new = hidden_params
        effect StackEffect::trait_bounds parser build_hidden_trait_methods = hidden_methods
        for hidden in hidden_methods.iter do
            hidden HiddenTraitMethod::var_name = hidden_name
            hidden HiddenTraitMethod::fn_type = hidden_type
            hidden_name hidden_type Parameter::named hidden_params.push
            hidden_type hidden_name Variable variables.push
            name_token Token::location hidden_name OpValue::AssignVar Op::new = hidden_assign
            hidden_type Option::Some hidden_assign Op::set_type_hint
            hidden_assign ops.push
        done
        # Prepend hidden params to stack effect parameters
        for effect_parameter in effect StackEffect::parameters.iter do
            effect_parameter hidden_params.push
        done
        hidden_params effect StackEffect::set_parameters
    fi

    # Register named parameters as variables and generate assign ops
    for param in effect StackEffect::parameters.iter do
        if "" param Parameter::name != then
            if param Parameter::name "__trait_" str::starts_with ! then
                param Parameter::typ param Parameter::name Variable variables.push
                name_token Token::location param Parameter::name OpValue::AssignVar Op::new ops.push
            fi
        fi
    done

    name_token Token::value cursor parser parse_block_ops = body_ops
    for body_op in body_ops.iter do
        body_op ops.push
    done

    effect name_token Token::location ops name_token Token::value Function::with_stack_effect = function
    variables function Function::set_variables
    function
}

# ============================================================================
# parse_enum - parse enum definition
# ============================================================================

fn parse_enum parser:Parser cursor:TokenCursor -> CasaEnum {
    fallback_token "enum" cursor expect_token_value.unwrap_or drop
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    # Parse optional type parameters
    List[str]::new = type_vars
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value == then
            cursor parser parse_type_variables.names = type_vars
        fi
    fi

    fallback_token "{" cursor expect_token_value.unwrap_or drop
    List[str]::new = variants
    Map[str List[Type]]::new = variant_types
    Map[str Location]::new = variant_locations

    while true do
        fallback_token cursor expect_token.unwrap_or = variant_token
        if "}" variant_token Token::value == then break fi
        if TokenKind::Identifier variant_token Token::kind != then
            variant_token Token::location "Expected variant name" ErrorKind::UnexpectedToken parser.state.record_error
        fi
        if variant_token Token::value variants string_list_contains then
            variant_token Token::location f"Duplicate variant `{variant_token Token::value}`" ErrorKind::DuplicateName parser.state.record_error
        fi
        variant_token Token::value variants.push
        variant_token Token::location variant_token Token::value variant_locations.set = variant_locations

        # Parse optional inner types: Variant(type1 type2)
        List[Type]::new = inner_types
        cursor.peek = paren_opt
        if paren_opt Option::Some(paren) is then
            if "(" paren Token::value == then
                cursor.pop drop # consume (
                while true do
                    cursor.peek = inner_opt
                    if inner_opt.is_none then
                        variant_token Token::location "Unexpected end of input in variant inner types" ErrorKind::UnexpectedToken parser.state.record_error
                        parser.state.mark_output_unusable
                        break
                    fi
                    if inner_opt Option::Some(inner) is then
                        if ")" inner Token::value == then
                            cursor.pop drop # consume )
                            break
                        fi
                    fi
                    cursor parse_type_ast inner_types.push
                done
                if 0 inner_types.length == then
                    variant_token Token::location "Variant inner types cannot be empty" ErrorKind::Syntax parser.state.record_error
                fi
            fi
        fi
        inner_types variant_token Token::value variant_types.set = variant_types
    done

    if 0 variants.length == then
        name_token Token::location "Enum must have at least one variant" ErrorKind::Syntax parser.state.record_error
    fi

    if 0 type_vars.length != then
        type_vars string_list_to_set = tv_set
        for variant_name in variants.iter do
            variant_name variant_types.get = vt_opt
            if vt_opt.is_some then
                vt_opt.unwrap = vt_inner
                0 (u64) = vt_index
                while vt_index vt_inner.length > do
                    tv_set vt_index vt_inner.get canonicalize_type_var vt_index vt_inner.set
                    1 += vt_index
                done
            fi
        done
    fi

    variant_locations type_vars variant_types name_token Token::location variants name_token Token::value CasaEnum
}

# ============================================================================
# Auto-derive Hashable for payload-free enums (#141). Skips enums with inner
# values and any name the user already defined (silent override).
# ============================================================================

fn synthesize_hashable_for_enum parser:Parser casa_enum:CasaEnum {
    if casa_enum has_inner_values then return fi
    casa_enum CasaEnum::name = enum_name
    casa_enum CasaEnum::location = location

    f"{enum_name}::hash" = hash_name
    if hash_name parser.store.functions.get.is_none then
        List[Op]::new = hash_ops
        location TYPE_I64_T OpValue::TypeCast Op::new hash_ops.push
        List[Parameter]::new = hash_params
        enum_name GenericType::new Type::Generic Parameter::new hash_params.push
        List[Type]::new = hash_returns
        TYPE_I64_T hash_returns.push
        hash_returns hash_params StackEffect::new = hash_stack_effect
        hash_stack_effect location hash_ops hash_name Function::with_stack_effect = hash_fn
        hash_fn hash_name parser.put_function
    fi

    f"{enum_name}::eq" = eq_name
    if eq_name parser.store.functions.get.is_none then
        List[Op]::new = eq_ops
        location OpValue::Eq Op::new eq_ops.push
        List[Parameter]::new = eq_params
        enum_name GenericType::new Type::Generic Parameter::new eq_params.push
        enum_name GenericType::new Type::Generic Parameter::new eq_params.push
        List[Type]::new = eq_returns
        TYPE_BOOL_T eq_returns.push
        eq_returns eq_params StackEffect::new = eq_stack_effect
        eq_stack_effect location eq_ops eq_name Function::with_stack_effect = eq_fn
        eq_fn eq_name parser.put_function
    fi
}

fn derive_hashable_for_enums parser:Parser {
    for casa_enum in parser.store.enums.values.iter do
        casa_enum parser synthesize_hashable_for_enum
    done
}

# ============================================================================
# _create_member_accessor - create getter/setter for struct members
# ============================================================================

fn create_member_accessor
    parser:Parser
    struct_name:str
    member_name:str
    member_type:Type
    member_index:u64
    location:Location
    type_vars:List[str]
{
    member_index WORD_SIZE * = offset

    # Parameterize the struct name when the struct has type vars
    List[Type]::new struct_name GenericType Type::Generic = param_type
    type_vars string_list_to_set = effect_type_vars
    if 0 type_vars.length != then
        type_vars struct_name build_parameterized_type = param_type
    fi

    # Getter
    f"{struct_name}::{member_name}" = getter_name
    List[Op]::new = getter_ops
    location TYPE_PTR_T OpValue::TypeCast Op::new getter_ops.push
    location offset (i64) make_integer_op_value Op::new getter_ops.push
    location OpValue::Add Op::new getter_ops.push
    location OpValue::Load64 Op::new getter_ops.push
    location member_type OpValue::TypeCast Op::new getter_ops.push

    List[Parameter]::new = getter_params
    "" param_type Parameter::named getter_params.push
    List[Type]::new = getter_returns
    member_type getter_returns.push
    getter_returns getter_params StackEffect::new = getter_stack_effect
    effect_type_vars getter_stack_effect StackEffect::set_type_vars
    effect_type_vars getter_stack_effect canonicalize_stack_effect_type_vars
    getter_stack_effect location getter_ops getter_name Function::with_stack_effect = getter

    if getter_name parser.store.functions.get.is_some then
        location f"Function `{getter_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
    fi
    getter getter_name parser.put_function

    # Setter
    f"{struct_name}::set_{member_name}" = setter_name
    List[Op]::new = setter_ops
    location TYPE_PTR_T OpValue::TypeCast Op::new setter_ops.push
    location offset (i64) make_integer_op_value Op::new setter_ops.push
    location OpValue::Add Op::new setter_ops.push
    location OpValue::Swap Op::new setter_ops.push
    location TYPE_U64_T OpValue::TypeCast Op::new setter_ops.push
    location OpValue::Swap Op::new setter_ops.push
    location OpValue::Store64 Op::new setter_ops.push

    List[Parameter]::new = setter_params
    "" param_type Parameter::named setter_params.push
    "" member_type Parameter::named setter_params.push
    List[Type]::new = setter_returns
    setter_returns setter_params StackEffect::new = setter_stack_effect
    effect_type_vars setter_stack_effect StackEffect::set_type_vars
    effect_type_vars setter_stack_effect canonicalize_stack_effect_type_vars
    setter_stack_effect location setter_ops setter_name Function::with_stack_effect = setter

    if setter_name parser.store.functions.get.is_some then
        location f"Function `{setter_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
    fi
    setter setter_name parser.put_function
}

# ============================================================================
# parse_struct - parse struct definition
# ============================================================================

fn parse_struct parser:Parser cursor:TokenCursor -> CasaStruct {
    fallback_token "struct" cursor expect_token_value.unwrap_or drop
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    # Parse optional type parameters
    List[str]::new = type_vars
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.names = type_vars
            # Trait bounds are not allowed on struct definitions
            if 0 parsed_type_variables.trait_bounds.keys.length != then
                name_token Token::location "Trait bounds are not allowed on struct definitions. Use `impl[K: Bound] StructName[K]` instead" ErrorKind::UnexpectedToken parser.state.record_error
            fi
        fi
    fi

    List[Member]::new = members
    type_vars string_list_to_set = struct_type_vars
    fallback_token "{" cursor expect_token_value.unwrap_or drop

    while true do
        fallback_token cursor expect_token.unwrap_or = member_token
        if "}" member_token Token::value == then break fi
        if TokenKind::Identifier member_token Token::kind != then
            member_token Token::location "Expected member name" ErrorKind::UnexpectedToken parser.state.record_error
        fi
        fallback_token ":" cursor expect_token_value.unwrap_or drop
        cursor parse_type_ast = member_type
        if 0 type_vars.length != then
            struct_type_vars member_type canonicalize_type_var = member_type
        fi

        type_vars member_token Token::location members.length member_type member_token Token::value name_token Token::value parser create_member_accessor
        member_type member_token Token::value Member members.push
    done

    type_vars name_token Token::location members name_token Token::value CasaStruct
}

# ============================================================================
# parse_trait - parse trait definition
# ============================================================================

fn parse_trait_method_stack_effect cursor:TokenCursor -> StackEffect {
    List[Parameter]::new = params

    # Parse parameters, stopping at ->, fn, or }
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then break fi
        peek_opt.unwrap = peek
        if
        "->" peek Token::value ==
        "{" peek Token::value == ||
        "fn" peek Token::value == ||
        "}" peek Token::value == ||
        then
            break
        fi
        cursor.pop drop

        if
        TokenKind::Identifier peek Token::kind !=
        "fn" peek Token::value != &&
        then
            peek Token::location "Unexpected token in trait method parameter list" ErrorKind::UnexpectedToken cursor.state.record_error
        fi

        peek cursor parse_parameter_maybe_named params.push
    done

    List[Type]::new = returns
    cursor.peek = arrow_opt
    if arrow_opt Option::Some(arrow) is then
        if "->" arrow Token::value == then
            cursor.pop drop # consume ->
            while true do
                cursor.peek = return_opt
                if return_opt.is_none then break fi
                return_opt.unwrap = return_token
                if
                "fn" return_token Token::value ==
                "}" return_token Token::value == ||
                "{" return_token Token::value == ||
                then
                    break
                fi
                cursor parse_type_ast returns.push
            done
        fi
    fi

    returns params StackEffect::new
}
# Parse a bracket-delimited identifier-only type-parameter list:
# `[T1 T2 ...]`. `context` (e.g. "trait", "trait method") is interpolated
# into error messages. Does *not* accept trait bounds; for those use
# `parse_type_variables`.

fn parse_simple_type_vars cursor:TokenCursor context:str -> List[str] {
    cursor.pop drop # consume [
    List[str]::new = collected
    true = loop_flag
    while loop_flag do
        cursor.peek = token_opt
        if token_opt.is_none then
            empty_location f"Unclosed {context} type parameter list" ErrorKind::UnmatchedBlock cursor.state.record_error
            cursor.state.mark_output_unusable
            false = loop_flag
        else
            token_opt.unwrap = token
            if "]" token Token::value == then
                cursor.pop drop
                false = loop_flag
            elif TokenKind::Identifier token Token::kind != then
                token Token::location f"Expected type parameter identifier in {context}" ErrorKind::UnexpectedToken cursor.state.record_error
                false = loop_flag
            else
                cursor.pop drop
                token Token::value collected.push
            fi
        fi
    done
    collected
}

fn parse_trait parser:Parser cursor:TokenCursor -> CasaTrait {
    fallback_token "trait" cursor expect_token_value.unwrap_or drop
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    List[str]::new = type_params
    cursor.peek = bracket_opt
    if { Token::value "[" == } bracket_opt.filter.is_some then
        "trait" cursor parse_simple_type_vars = type_params
    fi

    List[TraitBound]::new = supertraits
    cursor.peek = colon_opt
    if { Token::value ":" == } colon_opt.filter.is_some then
        cursor.pop drop
        true = parse_super_loop
        while parse_super_loop do
            fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = super_token
            super_token Token::value = super_name
            super_name parser.store.traits.get = super_def_opt
            if super_def_opt.is_none then
                super_token Token::location f"Supertrait `{super_name}` is not defined" ErrorKind::UndefinedName parser.state.record_error
            fi
            super_token cursor parse_bound_type_args = super_args
            if super_def_opt Option::Some(super_def) is then
                super_def CasaTrait::type_params = super_params
                if super_args.length super_params.length != then
                    super_token Token::location f"Supertrait `{super_name}` expects {super_params.length} type argument(s), got {super_args.length}" ErrorKind::Syntax parser.state.record_error
                fi
            fi
            super_args super_name TraitBound supertraits.push
            cursor.peek = plus_opt
            if { Token::value "+" == } plus_opt.filter.is_some then
                cursor.pop drop
            else
                false = parse_super_loop
            fi
        done
    fi

    List[TraitMethod]::new = methods
    fallback_token "{" cursor expect_token_value.unwrap_or drop

    true = parse_trait_loop
    while parse_trait_loop do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token Token::location "Unclosed trait block" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            false = parse_trait_loop
        elif next_opt Option::Some(next) is then
            if "}" next Token::value == then
                cursor.pop drop
                false = parse_trait_loop
            elif "fn" next Token::value != then
                next Token::location "Expected method declaration in trait" ErrorKind::UnexpectedToken parser.state.record_error
                false = parse_trait_loop
            else
                cursor.pop drop # consume fn
                fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = method_name

                # Parse optional method-level type parameters (e.g., fn map[U])
                List[str]::new = method_type_vars
                if cursor.peek Option::Some(mtv_bracket) is then
                    if "[" mtv_bracket Token::value == then
                        "trait method" cursor parse_simple_type_vars = method_type_vars
                    fi
                fi

                cursor parse_trait_method_stack_effect = method_stack_effect

                type_params string_list_to_set = trait_tv_set
                TRAIT_SELF_TYPE trait_tv_set.add = trait_tv_set
                for mtv in method_type_vars.iter do
                    mtv trait_tv_set.add = trait_tv_set
                done
                trait_tv_set method_stack_effect canonicalize_stack_effect_type_vars

                # Parse optional default method body
                List[Op]::new = default_ops
                if cursor.peek Option::Some(body_peek) is then
                    if "{" body_peek Token::value == then
                        f"{name_token Token::value}::{method_name Token::value}" cursor parser parse_block_ops = default_ops
                    fi
                fi

                method_type_vars default_ops method_stack_effect method_name Token::value TraitMethod methods.push
            fi
        else
            false = parse_trait_loop
        fi
    done

    name_token Token::location supertraits methods type_params name_token Token::value CasaTrait
}

# ============================================================================
# parse_impl_block - parse impl Type { fn methods... }
# ============================================================================

fn inject_impl_trait_params
    parser:Parser
    function:Function
    type_vars:List[str]
    trait_bounds:Map[str TraitBound]
{
    function Function::stack_effect = effect

    # Merge type vars into function stack effect
    for type_var in type_vars.iter do
        if type_var effect StackEffect::type_vars.has ! then
            type_var effect StackEffect::type_vars.add = new_type_vars
            new_type_vars effect StackEffect::set_type_vars
        fi
    done

    # Merge trait bounds
    trait_bounds.keys = bound_keys
    for bound_key in bound_keys.iter do
        if bound_key trait_bounds.get Option::Some(bound) is then
            bound bound_key effect StackEffect::trait_bounds.set = new_bounds
            new_bounds effect StackEffect::set_trait_bounds
        fi
    done

    # Inject hidden __trait_* parameters
    List[Parameter]::new = hidden_params
    0 (u64) = insert_pos
    effect StackEffect::trait_bounds parser build_hidden_trait_methods = hidden_methods
    for hidden in hidden_methods.iter do
        hidden HiddenTraitMethod::var_name = hidden_name
        hidden HiddenTraitMethod::fn_type = hidden_type
        hidden_name hidden_type Parameter::named hidden_params.push
        hidden_name Variable::new function Function::variables.push
        function Function::location hidden_name OpValue::AssignVar Op::new = assign_op
        hidden_type Option::Some assign_op Op::set_type_hint
        insert_pos assign_op function Function::ops.insert
        1 += insert_pos
    done

    # Prepend hidden params to existing stack effect parameters
    if 0 hidden_params.length != then
        for existing_param in effect StackEffect::parameters.iter do
            existing_param hidden_params.push
        done
        hidden_params effect StackEffect::set_parameters
    fi
}

fn parse_impl_block parser:Parser cursor:TokenCursor {
    fallback_token "impl" cursor expect_token_value.unwrap_or drop

    # Parse optional type parameters with trait bounds
    List[str]::new = type_vars
    Map[str TraitBound]::new = trait_bounds
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.names = type_vars
            parsed_type_variables.trait_bounds = trait_bounds
        fi
    fi

    cursor parse_type_ast = impl_type

    # Get base type name (without type params)
    impl_type.match_base = base_type

    fallback_token "{" cursor expect_token_value.unwrap_or drop
    while true do
        cursor.peek = fn_opt
        if fn_opt.is_none then break fi
        if fn_opt Option::Some(fn_token) is then
            if "fn" fn_token Token::value != then break fi
        fi
        cursor parser parse_function = function
        f"{base_type}::{function Function::name}" = fn_name
        fn_name function Function::set_name
        # Merge inherited type vars and trait bounds from impl block
        if 0 type_vars.length != then
            trait_bounds type_vars function parser inject_impl_trait_params
        fi
        if fn_name parser.store.functions.get.is_some then
            function Function::location f"Identifier `{fn_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
        fi
        function fn_name parser.put_function
    done
    fallback_token "}" cursor expect_token_value.unwrap_or drop
}

# ============================================================================
# parse_match_block - parse a full match construct (match ... end)
# ============================================================================

fn is_match_arm_boundary parser:Parser cursor:TokenCursor -> bool {
    cursor TokenCursor::pos = pos
    cursor TokenCursor::tokens = token_list
    if pos 1 + token_list.length < then false return fi
    pos token_list.get = token
    pos 1 + token_list.get = next_token

    # _ => or _ if ...
    if MATCH_WILDCARD token Token::value == then
        if "=>" next_token Token::value == then true return fi
        if "if" next_token Token::value == then true return fi
    fi
    # literal => or literal if ...
    if TokenKind::Literal token Token::kind == then
        if "=>" next_token Token::value == then true return fi
        if "if" next_token Token::value == then true return fi
    fi
    if TokenKind::Identifier token Token::kind != then false return fi
    # Identifier => or Identifier if ...
    if "=>" next_token Token::value == then true return fi
    if "if" next_token Token::value == then true return fi
    # StructName { ... } =>
    if "{" next_token Token::value == token Token::value parser.store.structs.get.is_some && then
        true return
    fi
    # EnumName::Variant(bindings) => or EnumName::Variant(bindings) if ...
    if "(" next_token Token::value == then
        token Token::value "::" str::find = separator
        if 0 separator > then
            pos 2 + = scan_pos
            while scan_pos token_list.length > do
                if ")" scan_pos token_list.get Token::value == then
                    if scan_pos 1 + token_list.length > then
                        scan_pos 1 + token_list.get Token::value = after_paren
                        if "=>" after_paren == then true return fi
                        if "if" after_paren == then true return fi
                    fi
                    break
                fi
                1 += scan_pos
            done
        fi
    fi
    false
}

fn parse_struct_match_pattern parser:Parser name_token:Token cursor:TokenCursor -> StructPattern {
    fallback_token "{" cursor expect_token_value.unwrap_or drop
    name_token Token::value parser.store.structs.get = struct_opt
    if struct_opt.is_none then
        name_token Token::location f"Struct `{name_token Token::value}` is not defined" ErrorKind::UndefinedName parser.state.record_error
    fi
    Map[str str]::new = bindings

    while true do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token Token::location "Unexpected end of input in struct pattern" ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
        if next_opt Option::Some(next) is then
            if "}" next Token::value == then
                cursor.pop drop
                break
            fi
        fi
        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = field_token
        fallback_token ":" cursor expect_token_value.unwrap_or drop
        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = var_token
        var_token Token::value field_token Token::value bindings.set = bindings
    done

    bindings name_token Token::value StructPattern
}
# parse_pattern_terminator — consume the `=>` that separates a match-arm
# pattern from its body. If an `if` keyword appears first the guard
# expression is collected until `=>`. Returns the (possibly empty) list of
# guard ops. The trailing `=>` token is always consumed.
#
# The guard expression may contain a nested `match` block whose arms also
# use `=>`; a match-depth counter skips those nested arrows so only the
# outer arm terminator ends the guard.

fn parse_pattern_terminator parser:Parser cursor:TokenCursor function_name:str -> List[Op] {
    List[Op]::new = guard_ops
    cursor.peek = guard_peek
    if { Token::value "if" == } guard_peek.filter.is_some then
        cursor.pop drop # consume `if`
        0 = match_depth
        while cursor.is_finished ! do
            cursor.peek = next_opt
            if next_opt.is_none then break fi
            next_opt.unwrap Token::value = next_value
            if "=>" next_value == 0 match_depth == && then break fi
            cursor.pop = guard_token_opt
            if guard_token_opt.is_none then break fi
            guard_token_opt.unwrap = guard_token
            if "match" guard_token Token::value == then
                1 += match_depth
            elif "end" guard_token Token::value == 0 match_depth != && then
                1 -= match_depth
            fi
            if TokenKind::FstringStart guard_token Token::kind == then
                guard_ops function_name cursor guard_token parser handle_fstring
                continue
            fi
            guard_ops function_name cursor guard_token parser token_to_op
        done
    fi
    fallback_token "=>" cursor expect_token_value.unwrap_or drop
    guard_ops
}

fn parse_literal_match_pattern token:Token parser:Parser -> LiteralPattern {
    token Token::value = value
    if "true" value == then
        "true" true LiteralValue::Bool LiteralPattern return
    fi
    if "false" value == then
        "false" false LiteralValue::Bool LiteralPattern return
    fi
    if 0 value.at.is_digit value is_negative_integer_literal || then
        value value str_to_int value IntegerLiteral::new LiteralValue::Int LiteralPattern return
    fi
    if
    '\'' 0 value.at ==
    3 value.length == &&
    then
        value 1 value.at (i64) LiteralValue::Char LiteralPattern return
    fi
    if '"' 0 value.at == '"' value.length 1 - value.at == && then
        value value 1 value.length 2 - str::substring LiteralValue::Str LiteralPattern return
    fi
    token Token::location f"Unsupported literal in match arm: `{value}`" ErrorKind::UnexpectedToken parser.state.record_error
    # Unreachable
    "" 0 IntegerLiteral::from_int LiteralValue::Int LiteralPattern
}
# Parse one match-arm pattern (wildcard, literal, struct, bare ident, or
# Enum::Variant) plus its optional guard, append the OpMatchArm to `ops`.

fn parse_match_arm_pattern
    parser:Parser
    arm_token:Token
    cursor:TokenCursor
    function_name:str
    ops:List[Op]
{
    if MATCH_WILDCARD arm_token Token::value == then
        function_name cursor parser parse_pattern_terminator = wildcard_guard_ops
        Option::None MATCH_WILDCARD "" EnumVariant::new = wildcard
        wildcard_guard_ops wildcard PatternValue::EnumVariant MatchArm::new = wildcard_arm
        arm_token Token::location wildcard_arm OpValue::MatchArm Op::new ops.push
    elif TokenKind::Literal arm_token Token::kind == then
        function_name cursor parser parse_pattern_terminator = literal_guard_ops
        parser arm_token parse_literal_match_pattern = literal_pattern
        literal_guard_ops literal_pattern PatternValue::Literal MatchArm::new = literal_arm
        arm_token Token::location literal_arm OpValue::MatchArm Op::new ops.push
    elif TokenKind::Identifier arm_token Token::kind != then
        arm_token Token::location "Expected match pattern or `_`" ErrorKind::UnexpectedToken parser.state.record_error
    elif { Token::value "{" == } cursor.peek.filter.is_some then
        cursor arm_token parser parse_struct_match_pattern = struct_pattern
        function_name cursor parser parse_pattern_terminator = struct_guard_ops
        struct_guard_ops struct_pattern PatternValue::Struct MatchArm::new = struct_arm
        arm_token Token::location struct_arm OpValue::MatchArm Op::new ops.push
    elif arm_token Token::value "::" str::find 0 > then
        function_name cursor parser parse_pattern_terminator = bare_guard_ops
        Option::None arm_token Token::value "" EnumVariant::new = bare_variant
        bare_guard_ops bare_variant PatternValue::EnumVariant MatchArm::new = bare_arm
        arm_token Token::location bare_arm OpValue::MatchArm Op::new ops.push
    else
        arm_token Token::value "::" str::find = separator
        arm_token Token::value 0 separator (u64) str::substring = enum_name
        arm_token Token::value separator 2 + (u64) arm_token Token::value.length separator (u64) - 2 - str::substring = variant_name

        List[str]::new = bindings
        cursor.peek = paren_opt
        if { Token::value "(" == } paren_opt.filter.is_some then
            cursor.pop drop
            while true do
                cursor.peek = inner_opt
                if inner_opt.is_none then
                    arm_token Token::location "Unexpected end of input in match arm bindings" ErrorKind::UnexpectedToken parser.state.record_error
                    parser.state.mark_output_unusable
                    break
                fi
                if inner_opt Option::Some(inner) is then
                    if ")" inner Token::value == then
                        cursor.pop drop
                        break
                    fi
                fi
                fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = binding_token
                binding_token Token::value bindings.push
            done
        fi

        function_name cursor parser parse_pattern_terminator = enum_guard_ops
        Option::None variant_name enum_name EnumVariant::new = variant
        bindings variant EnumVariant::set_bindings
        enum_guard_ops variant PatternValue::EnumVariant MatchArm::new = variant_arm
        arm_token Token::location variant_arm OpValue::MatchArm Op::new ops.push
    fi
}
# Parse a match-arm body (either a `{...}` block or a single-line expression
# up to the next arm boundary / `end`) and append its ops to `ops`.

fn parse_match_arm_body parser:Parser cursor:TokenCursor function_name:str ops:List[Op] {
    cursor.peek = body_peek
    if { Token::value "{" == } body_peek.filter.is_some then
        function_name cursor parser parse_block_ops = block_ops
        for block_op in block_ops.iter do
            block_op ops.push
        done
        return
    fi
    while cursor.is_finished ! do
        if cursor parser is_match_arm_boundary then break fi
        cursor.peek = end_peek
        if { Token::value "end" == } end_peek.filter.is_some then
            break
        fi
        cursor.pop = body_token_opt
        if body_token_opt.is_none then break fi
        body_token_opt.unwrap = body_token
        if TokenKind::FstringStart body_token Token::kind == then
            ops function_name cursor body_token parser handle_fstring
            continue
        fi
        ops function_name cursor body_token parser token_to_op
    done
}

fn parse_match_block parser:Parser token:Token cursor:TokenCursor function_name:str -> List[Op] {
    List[Op]::new = ops
    token Token::location OpValue::MatchStart Op::new ops.push

    while true do
        fallback_token cursor expect_token.unwrap_or = arm_token
        if "end" arm_token Token::value == then
            arm_token Token::location OpValue::MatchEnd Op::new ops.push
            break
        fi
        ops function_name cursor arm_token parser parse_match_arm_pattern
        ops function_name cursor parser parse_match_arm_body
    done
    ops
}

# ============================================================================
# _handle_keyword_import - parse import path
# ============================================================================

fn is_path_specifier spec:str -> bool {
    spec ".casa" str::ends_with
    spec "/" str::contains ||
}

fn dir_of_path path:str -> str {
    Option[u64]::None = last_slash
    0 (u64) = scan
    while scan path.length > do
        if '/' scan path.at == then
            scan Option::Some = last_slash
        fi
        1 += scan
    done
    if last_slash Option::Some(index) is then
        path 0 index 1 + str::substring
        return
    fi
    ""
}

fn resolve_import parser:Parser importing_file:str spec:str location:Location -> str {
    importing_file dir_of_path = source_dir
    importing_file normalize_path = importing_normalized
    # Path-style: keep existing semantics (no existence check).
    if spec is_path_specifier then
        if spec "/" str::starts_with then
            spec
            return
        fi
        f"{source_dir}{spec}" normalize_path
        return
    fi
    # Module-style: probe source dir, then each search path. First hit wins.
    # Skip a same-dir match that resolves to the importing file itself, so an
    # example named `argparse.casa` importing "argparse" still finds the
    # library copy via -L.
    # `searched` accumulates probed dirs for the not-found error message.
    f"{source_dir}{spec}.casa" normalize_path = source_candidate
    if source_candidate file::exists source_candidate importing_normalized != && then
        source_candidate
        return
    fi
    if 0 source_dir.length == then
        "."
    else
        source_dir
    fi
    = first_dir
    f"\n  {first_dir}" = searched
    for base in parser.search_paths.iter do
        f"{searched}\n  {base}" = searched
        f"{base}/{spec}.casa" normalize_path = candidate
        if candidate file::exists then
            candidate
            return
        fi
    done
    location f"module `{spec}` not found, searched:{searched}" ErrorKind::Syntax parser.state.record_error
    parser.state.mark_output_unusable
    ""
}

fn parse_selective_import_symbols cursor:TokenCursor location:Location -> List[str] {
    List[str]::new = symbols
    fallback_token "{" cursor expect_token_value.unwrap_or drop
    while true do
        cursor.pop = symbol_opt
        if symbol_opt.is_none then
            location "Unclosed selective import list" ErrorKind::UnmatchedBlock cursor.state.record_error
            cursor.state.mark_output_unusable
            symbols return
        fi
        symbol_opt.unwrap = symbol_token
        if TokenKind::Comment symbol_token Token::kind == then continue fi
        if TokenKind::Newline symbol_token Token::kind == then continue fi
        if "}" symbol_token Token::value == then
            if 0 symbols.length == then
                symbol_token Token::location "Selective import list cannot be empty" ErrorKind::Syntax cursor.state.record_error
            fi
            symbols return
        fi
        if TokenKind::Identifier symbol_token Token::kind != then
            symbol_token Token::location "Expected identifier in selective import list" ErrorKind::UnexpectedToken cursor.state.record_error
        fi
        symbol_token Token::value symbols.push
    done
    symbols
}

fn handle_keyword_import parser:Parser cursor:TokenCursor -> Op {
    fallback_token TokenKind::Literal cursor expect_token_kind.unwrap_or = path_token
    cursor path_token get_op_literal = literal_op
    if literal_op.value OpValue::PushStr(spec) is then
        path_token Token::location = path_location
        path_location Location::file = importing_file
        path_location spec importing_file parser resolve_import = resolved

        cursor.peek = next_opt
        if { Token::value "{" == } next_opt.filter.is_some then
            path_location cursor parse_selective_import_symbols = symbols
            symbols resolved SelectiveImport = selective
            path_location selective OpValue::ImportFileSelective Op::new return
        fi
        path_location resolved OpValue::ImportFile Op::new return
    fi
    path_token Token::location "Expected string literal for import path" ErrorKind::UnexpectedToken parser.state.record_error
    # Unreachable - parser.state.record_error exits
    path_token Token::location "" OpValue::ImportFile Op::new
}

fn handle_selective_import parser:Parser selective:SelectiveImport location:Location {
    selective.path = import_path
    if 0 import_path.length == then
        return
    fi

    Set[str]::new = included_files
    import_path included_files.add drop
    symbol_store_new included_files import_path parser.analyze_import = import_result
    if import_result Result::Error(read_error) is then
        location f"Cannot read import `{import_path}`: {read_error.to_str}" ErrorKind::Syntax parser.state.diagnostics.record_error_at_encounter
        parser.state.mark_output_unusable
        return
    fi
    import_result.unwrap = imported_result
    location imported_result.diagnostics parser.state.diagnostics.merge_at_encounter
    if imported_result.ops Option::Some(_) is ! then
        parser.state.mark_output_unusable
        return
    fi

    location
    selective.symbols
    parser.store
    imported_result.store
    merge_selective_import_closure = merge_result
    if merge_result Result::Error(merge_diagnostics) is then
        location merge_diagnostics parser.state.diagnostics.merge_at_encounter
        parser.state.mark_output_unusable
        return
    fi
}

# ============================================================================
# handle_question_operator - desugar `?` to method calls
# ============================================================================
#
# The `?` operator is desugared at parse time into method calls on
# `is_ok` and `unwrap`, following the same pattern as `for` loops.
# No compiler knowledge of Result, Option, or any Try trait is needed.
#
# Source `value ?` lowers to roughly:
#
#     dup
#     if .is_ok ! then
#         (FnReturnType)
#         return
#     fi
#     .unwrap
#

fn handle_question_operator parser:Parser token:Token function_name:str ops:List[Op] {
    token Token::location = loc

    loc OpValue::Dup Op::new ops.push
    loc OpValue::IfStart Op::new ops.push
    loc "is_ok" OpValue::MethodCall Op::new ops.push
    loc OpValue::Not Op::new ops.push
    loc OpValue::IfCondition Op::new ops.push

    function_name parser.store.functions.get = fn_opt
    if fn_opt Option::Some(function) is then
        function Function::stack_effect StackEffect::return_types = ret_types
        if 0 ret_types.length != then
            0 ret_types.get = ret_type
            loc ret_type OpValue::TypeCast Op::new ops.push
        fi
    fi

    loc OpValue::FnReturn Op::new ops.push
    loc OpValue::IfEnd Op::new ops.push
    loc "unwrap" OpValue::MethodCall Op::new ops.push
}

# ============================================================================
# handle_keyword_for - parse `for <ident> in <expr> do <body> done`
# ============================================================================
#
# The for-loop is desugared at parse time into a `while` loop over the
# iterator's `next` method. The synthesized ops use only existing op kinds,
# so no new typechecker or bytecode support is required.
#
# Source `for x in <iter> do <body> done` lowers to roughly:
#
#     <iter_expr_ops>
#     = __for_iter_N
#     while
#         __for_iter_N .next
#         = __for_opt_N
#         __for_opt_N .is_some
#     do
#         __for_opt_N .unwrap
#         = x
#         <body_ops>
#     done
#
# The hidden variable names embed the source offset so nested for-loops do
# not collide. Nested `while`/`for` inside the body or the iterable
# expression are detected via depth counting on `while`/`for` openers and
# `done` closers so the enclosing `do`/`done` pair is identified correctly.

fn handle_keyword_for parser:Parser token:Token cursor:TokenCursor function_name:str ops:List[Op] {
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = loop_var_token
    loop_var_token Token::value = loop_var_name
    fallback_token "in" cursor expect_token_value.unwrap_or drop

    token Token::location = for_loc
    for_loc Location::span Span::offset = for_offset
    f"__for_iter_{for_offset}" = hidden_iter_name
    f"__for_opt_{for_offset}" = hidden_opt_name

    # Iterable-expression phase — emit ops until the matching `do`. These ops
    # leave the iterator value on the stack, which the synthesized
    # OpAssignVar below pops into the hidden iterator local.
    0 = nesting_depth
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            for_loc "Unclosed `for` loop" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            return
        fi
        peek_opt.unwrap = peeked_token
        if "do" peeked_token Token::value == 0 nesting_depth == && then
            cursor.pop drop
            break
        fi
        if "while" peeked_token Token::value == then
            1 += nesting_depth
        fi
        if "done" peeked_token Token::value == 0 nesting_depth > && then
            nesting_depth 1 - = nesting_depth
        fi
        cursor.pop drop
        if TokenKind::FstringStart peeked_token Token::kind == then
            ops function_name cursor peeked_token parser handle_fstring
            continue
        fi
        ops function_name cursor peeked_token parser token_to_op
    done

    # Loop preamble: store iterator into hidden local, then open the while
    # loop with the `next`/`is_some` condition.
    for_loc hidden_iter_name OpValue::AssignVar Op::new ops.push
    for_loc OpValue::WhileStart Op::new ops.push
    for_loc hidden_iter_name OpValue::PushVar Op::new ops.push
    for_loc "next" OpValue::MethodCall Op::new ops.push
    for_loc hidden_opt_name OpValue::AssignVar Op::new ops.push
    for_loc hidden_opt_name OpValue::PushVar Op::new ops.push
    for_loc "is_some" OpValue::MethodCall Op::new ops.push
    for_loc OpValue::WhileCondition Op::new ops.push
    for_loc hidden_opt_name OpValue::PushVar Op::new ops.push
    for_loc "unwrap" OpValue::MethodCall Op::new ops.push
    for_loc loop_var_name OpValue::AssignVar Op::new ops.push

    # Body phase — emit ops until the matching `done`, then close the while.
    0 = body_nesting_depth
    while true do
        cursor.peek = body_peek_opt
        if body_peek_opt.is_none then
            for_loc "Unclosed `for` loop body" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            return
        fi
        body_peek_opt.unwrap = body_token
        if "done" body_token Token::value == 0 body_nesting_depth == && then
            cursor.pop drop
            body_token Token::location OpValue::WhileEnd Op::new ops.push
            return
        fi
        if "while" body_token Token::value == then
            1 += body_nesting_depth
        fi
        if "done" body_token Token::value == 0 body_nesting_depth > && then
            body_nesting_depth 1 - = body_nesting_depth
        fi
        cursor.pop drop
        if TokenKind::FstringStart body_token Token::kind == then
            ops function_name cursor body_token parser handle_fstring
            continue
        fi
        ops function_name cursor body_token parser token_to_op
    done
}

# ============================================================================
# get_op_keyword - handle all keywords
# ============================================================================

fn get_op_keyword parser:Parser token:Token cursor:TokenCursor function_name:str ops:List[Op] {
    token Token::value keyword_from_str = keyword_opt
    if keyword_opt.is_none then
        token Token::location f"Token `{token Token::value}` is not a keyword" ErrorKind::Syntax parser.state.record_error
    fi
    keyword_opt.unwrap = keyword

    # Simple keyword -> OpValue lookup
    keyword keyword_to_op_value = simple_opt
    if simple_opt Option::Some(simple) is then
        token Token::location simple Op::new ops.push
        return
    fi

    # end without match
    if KeywordKind::End keyword == then
        token Token::location "`end` without matching `match`" ErrorKind::UnmatchedBlock parser.state.record_error
    fi

    # enum
    if KeywordKind::EnumKw keyword == then
        parser token Token::location "Enums" function_name require_global_scope
        cursor.retreat
        cursor parser parse_enum = casa_enum
        if casa_enum CasaEnum::name parser.store.enums.get.is_some then
            casa_enum CasaEnum::location f"Enum `{casa_enum CasaEnum::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
        fi
        casa_enum casa_enum CasaEnum::name parser.put_enum
        return
    fi

    # fn
    if KeywordKind::Fn keyword == then
        parser token Token::location "Functions" function_name require_global_scope
        cursor.retreat
        cursor parser parse_function = function
        if function Function::name parser.store.functions.get.is_some then
            function Function::location f"Identifier `{function Function::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
        fi
        function function Function::name parser.put_function
        return
    fi

    # impl
    if KeywordKind::Impl keyword == then
        parser token Token::location "Implementation blocks" function_name require_global_scope
        cursor.retreat
        cursor parser parse_impl_block
        return
    fi

    # import
    if KeywordKind::Import keyword == then
        parser token Token::location "Import statements" function_name require_global_scope
        cursor parser handle_keyword_import ops.push
        return
    fi

    # is (standalone is error)
    if KeywordKind::Is keyword == then
        token Token::location "`is` requires a preceding enum variant" ErrorKind::Syntax parser.state.record_error
    fi

    # match
    if KeywordKind::Match keyword == then
        function_name cursor token parser parse_match_block = match_ops
        for match_op in match_ops.iter do
            match_op ops.push
        done
        return
    fi

    # struct
    if KeywordKind::StructKw keyword == then
        parser token Token::location "Structs" function_name require_global_scope
        cursor.retreat
        cursor parser parse_struct = casa_struct
        casa_struct casa_struct CasaStruct::name parser.put_struct
        return
    fi

    # for
    if KeywordKind::For keyword == then
        ops function_name cursor token parser handle_keyword_for
        return
    fi

    # in (standalone is error — only valid inside a for header)
    if KeywordKind::In keyword == then
        token Token::location "`in` is only valid inside a `for` loop header" ErrorKind::Syntax parser.state.record_error
    fi

    # global — compile-time declaration; emits DeclareGlobal op
    if KeywordKind::Global keyword == then
        if GLOBAL_SCOPE_LABEL function_name == then
            token Token::location "`global` declaration is only valid inside a function body" ErrorKind::InvalidScope parser.state.record_error
            return
        fi
        if function_name "lambda__" str::starts_with then
            token Token::location "`global` declaration is not allowed inside a lambda" ErrorKind::InvalidScope parser.state.record_error
            return
        fi
        # Placement check: all ops so far must be DeclareGlobal
        for existing_op in ops.iter do
            if existing_op.value OpValue::DeclareGlobal is ! then
                token Token::location "`global` declaration must appear before any other statement in the function body" ErrorKind::Syntax parser.state.record_error
                return
            fi
        done
        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token
        token Token::location name_token Token::value OpValue::DeclareGlobal Op::new ops.push
        return
    fi

    # const
    if KeywordKind::Const keyword == then
        parser token Token::location "Constants" function_name require_global_scope
        # const fn — compile-time evaluable function
        cursor.peek = const_next_opt
        if const_next_opt Option::Some(const_next) is then
            if "fn" const_next Token::value == then
                cursor parser parse_function = function
                true function Function::set_is_const_fn
                parser.state.diagnostics function validate_const_fn_body
                if function Function::name parser.store.functions.get.is_some then
                    function Function::location f"Identifier `{function Function::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
                fi
                function function Function::name parser.put_function
                return
            fi
        fi
        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = const_name_token
        const_name_token Token::value = const_name
        if const_name parser.store.constants.get.is_some then
            token Token::location f"Constant `{const_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
        fi
        if const_name parser.store.functions.get.is_some then
            token Token::location f"Constant `{const_name}` conflicts with an existing function" ErrorKind::DuplicateName parser.state.record_error
        fi
        if const_name parser.store.variables.get.is_some then
            token Token::location f"Constant `{const_name}` conflicts with an existing variable" ErrorKind::DuplicateName parser.state.record_error
        fi
        if const_name parser.store.structs.get.is_some then
            token Token::location f"Constant `{const_name}` conflicts with an existing struct" ErrorKind::DuplicateName parser.state.record_error
        fi
        if const_name parser.store.enums.get.is_some then
            token Token::location f"Constant `{const_name}` conflicts with an existing enum" ErrorKind::DuplicateName parser.state.record_error
        fi
        cursor.pop = const_value_token_opt
        if const_value_token_opt.is_none then
            token Token::location "Expected a literal value, block expression, or constant name after constant name" ErrorKind::Syntax parser.state.record_error
        fi
        const_value_token_opt.unwrap = const_value_token
        if "{" const_value_token Token::value == then
            cursor.retreat
            token Token::location cursor parser eval_const_block = const_block_val
            token Token::location const_block_val const_name Constant = casa_const
            casa_const const_name parser.put_constant
        elif TokenKind::Literal const_value_token Token::kind == then
            const_value_token Token::value parse_literal_to_constant_value = const_lit_val
            token Token::location const_lit_val const_name Constant = casa_const
            casa_const const_name parser.put_constant
        elif TokenKind::Identifier const_value_token Token::kind == then
            const_value_token Token::value = const_ref_name
            const_ref_name parser.store.constants.get = const_ref_opt
            if const_ref_opt Option::Some(const_ref) is then
                token Token::location const_ref Constant::value const_name Constant = casa_const
                casa_const const_name parser.put_constant
            elif const_ref_name parser.store.functions.get.is_some then
                token Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" ErrorKind::Syntax parser.state.record_error
            elif const_ref_name parser.store.structs.get.is_some then
                token Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" ErrorKind::Syntax parser.state.record_error
            elif const_ref_name parser.store.enums.get.is_some then
                token Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" ErrorKind::Syntax parser.state.record_error
            else
                token Token::location f"Undefined constant `{const_ref_name}` referenced in constant `{const_name}`" ErrorKind::Syntax parser.state.record_error
            fi
        else
            token Token::location f"Expected a literal value, block expression, or constant name for constant `{const_name}`" ErrorKind::Syntax parser.state.record_error
        fi
        return
    fi

    # trait
    if KeywordKind::TraitKw keyword == then
        parser token Token::location "Traits" function_name require_global_scope
        cursor.retreat
        cursor parser parse_trait = casa_trait
        if casa_trait CasaTrait::name parser.store.traits.get.is_some then
            casa_trait CasaTrait::location f"Trait `{casa_trait CasaTrait::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
        fi
        casa_trait casa_trait CasaTrait::name parser.put_trait
        return
    fi
}

# ============================================================================
# _parse_struct_literal - parse StructName { field: value }
# ============================================================================

fn is_struct_field_boundary cursor:TokenCursor member_names:List[str] -> bool {
    cursor TokenCursor::pos = pos
    cursor TokenCursor::tokens = token_list
    if pos 1 + token_list.length < then false return fi
    pos token_list.get = token
    if TokenKind::Identifier token Token::kind != then false return fi
    if token Token::value member_names string_list_contains ! then false return fi
    ":" pos 1 + token_list.get Token::value ==
}

fn parse_struct_field_value
    parser:Parser
    cursor:TokenCursor
    struct_name:str
    member_names:List[str]
    function_name:str
    all_ops:List[Op]
{
    while cursor.is_finished ! do
        cursor.peek = peek_opt
        if peek_opt.is_none then break fi
        if peek_opt Option::Some(peek) is then
            if "}" peek Token::value == then break fi
        fi
        if member_names cursor is_struct_field_boundary then break fi
        cursor.pop = value_opt
        if value_opt.is_none then break fi
        value_opt.unwrap = value_token
        if TokenKind::FstringStart value_token Token::kind == then
            all_ops function_name cursor value_token parser handle_fstring
            continue
        fi
        all_ops function_name cursor value_token parser token_to_op
    done
}

fn parse_struct_literal
    parser:Parser
    name_token:Token
    cursor:TokenCursor
    function_name:str
-> List[Op] {
    fallback_token "{" cursor expect_token_value.unwrap_or drop
    name_token Token::value parser.store.structs.get = casa_struct_opt
    if casa_struct_opt.is_none then
        empty_location "Expected option value while unwrapping name_token Token::value parser.store.structs.get" ErrorKind::Syntax parser.state.record_error
        1 exit
    fi
    casa_struct_opt.unwrap = casa_struct
    List[str]::new = member_names
    for member in casa_struct CasaStruct::members.iter do
        member Member::name member_names.push
    done

    List[str]::new = field_order
    List[Op]::new = all_ops
    Set[str]::new = seen

    while true do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token Token::location "Unexpected end of input in struct literal" ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
        if next_opt Option::Some(next) is then
            if "}" next Token::value == then
                cursor.pop drop
                break
            fi
        fi

        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = field_token
        if field_token Token::value member_names string_list_contains ! then
            field_token Token::location f"Struct `{name_token Token::value}` has no field `{field_token Token::value}`" ErrorKind::UndefinedName parser.state.record_error
        fi
        if field_token Token::value seen.has then
            field_token Token::location f"Duplicate field `{field_token Token::value}` in struct literal" ErrorKind::DuplicateName parser.state.record_error
        fi
        field_token Token::value seen.add = seen
        field_token Token::value field_order.push

        fallback_token ":" cursor expect_token_value.unwrap_or drop

        all_ops.length = ops_before
        all_ops function_name member_names name_token Token::value cursor parser parse_struct_field_value
        if ops_before all_ops.length == then
            field_token Token::location f"Missing value for field `{field_token Token::value}`" ErrorKind::Syntax parser.state.record_error
        fi
    done

    field_order name_token Token::value StructLiteral = literal
    name_token Token::location literal OpValue::StructLiteral Op::new all_ops.push
    all_ops
}

# ============================================================================
# token_to_op - main dispatch: token kind -> handler
# ============================================================================

fn try_parse_explicit_associated_item token:Token cursor:TokenCursor ops:List[Op] -> bool {
    cursor.save = saved_pos
    cursor.peek = open_opt
    if open_opt.is_none then false return fi
    if open_opt Option::Some(open) is then
        if "[" open Token::value != then false return fi
        if
        token Token::location Location::span Span::offset
        token Token::location Location::span Span::length +
        open Token::location Location::span Span::offset !=
        then false return fi
    fi
    cursor.pop drop
    List[Type]::new = type_args
    while true do
        cursor.peek = next_opt
        if next_opt.is_none then saved_pos cursor.restore false return fi
        if next_opt Option::Some(next) is then
            if "]" next Token::value == then
                cursor.pop drop
                break
            fi
        fi
        cursor parse_type_ast type_args.push
    done
    cursor.pop = first_colon
    cursor.pop = second_colon
    cursor.pop = member_opt
    if
    first_colon.is_none second_colon.is_none ||
    member_opt.is_none ||
    then
        saved_pos cursor.restore
        false return
    fi
    if
    first_colon.unwrap Token::value ":" !=
    second_colon.unwrap Token::value ":" != ||
    member_opt.unwrap Token::kind TokenKind::Identifier != ||
    then
        saved_pos cursor.restore
        false return
    fi
    member_opt.unwrap Token::value = member
    token Token::value = base
    token Token::location f"{base}::{member}" OpValue::Identifier Op::new = associated_op
    type_args base GenericType Type::Generic = result_type
    result_type Option::Some associated_op Op::set_type_hint
    associated_op ops.push
    true
}

fn token_to_op parser:Parser token:Token cursor:TokenCursor function_name:str ops:List[Op] {
    token Token::kind = kind

    if TokenKind::Eof kind == then return fi
    if TokenKind::Comment kind == then return fi
    if TokenKind::Newline kind == then return fi

    if TokenKind::Delimiter kind == then
        ops function_name cursor token parser get_op_delimiter
        return
    fi

    if TokenKind::Literal kind == then
        cursor token get_op_literal ops.push
        return
    fi

    if TokenKind::Intrinsic kind == then
        cursor token get_op_intrinsic ops.push
        return
    fi

    if TokenKind::Keyword kind == then
        ops function_name cursor token parser get_op_keyword
        return
    fi

    if TokenKind::Operator kind == then
        if "?" token Token::value == then
            ops function_name token parser handle_question_operator
            return
        fi
        function_name cursor token get_op_operator ops.push
        return
    fi

    if TokenKind::Identifier kind == then
        if ops cursor token try_parse_explicit_associated_item then return fi
        # Check for struct literal: StructName { ... }
        cursor.peek = next_opt
        if next_opt Option::Some(next) is then
            if "{" next Token::value == then
                if token Token::value parser.store.structs.get.is_some then
                    function_name cursor token parser parse_struct_literal = struct_literal_ops
                    for struct_op in struct_literal_ops.iter do
                        struct_op ops.push
                    done
                    return
                fi
            fi
        fi

        # Check for is check: Enum::Variant is
        if token Token::value "::" str::find 0 <= then
            cursor token try_parse_is_check = is_check_opt
            if is_check_opt Option::Some(is_check_op) is then
                is_check_op ops.push
                return
            fi
        fi

        # Plain identifier
        token Token::location token Token::value OpValue::Identifier Op::new ops.push
        return
    fi

    # F-string tokens should be handled by handle_fstring
    if
    TokenKind::FstringStart kind ==
    TokenKind::FstringEnd kind == ||
    TokenKind::FstringExprStart kind == ||
    TokenKind::FstringExprEnd kind == ||
    TokenKind::FstringText kind == ||
    then
        token Token::location "F-string token should be handled by handle_fstring" ErrorKind::Syntax parser.state.record_error
    fi
}

# ============================================================================
# parse_ops - main parse loop
# ============================================================================

fn parse_ops parser:Parser tokens:List[Token] -> List[Op] {
    parser.state tokens TokenCursor::new = cursor
    List[Op]::new = ops
    while cursor.is_finished ! do
        cursor.pop = token_opt
        if token_opt.is_none then break fi
        token_opt.unwrap = token
        if TokenKind::Comment token Token::kind == then continue fi
        if TokenKind::Newline token Token::kind == then continue fi
        parser.state.reset_store_mutation
        ops.length = ops_before
        if TokenKind::FstringStart token Token::kind == then
            ops GLOBAL_SCOPE_LABEL cursor token parser handle_fstring
        else
            ops GLOBAL_SCOPE_LABEL cursor token parser token_to_op
        fi
        if parser.state.take_recovery_request then
            while ops_before ops.length > do ops.pop drop done
            if parser.state.store_was_mutated then parser.state.mark_output_unusable break fi
            if cursor.recover_at_structure ! then parser.state.mark_output_unusable break fi
        fi
    done
    ops
}

impl Parser {
    fn finish_resolution self:Parser ops:List[Op] skip_functions:Set[str] -> ParseResolveResult {
        if self.state.has_usable_output ! then
            self.state.diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult return
        fi
        ops self resolve_identifiers_global = resolved_ops
        if self.state.has_usable_output ! then
            self.state.diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult return
        fi
        self.store.functions.keys = function_names
        for function_name in function_names.iter do
            if function_name skip_functions.has then continue fi
            if function_name "lambda__" str::starts_with then continue fi
            function_name self.store.functions.get.unwrap = function
            self.state.diagnostics function function.ops self.store resolve_identifiers function.set_ops
        done
        self derive_hashable_for_enums
        if self.state.has_usable_output then resolved_ops Option::Some else Option::None fi = result_ops
        self.state.diagnostics self.store result_ops ParseResolveResult
    }
}

fn parse_and_resolve
    tokens:List[Token]
    search_paths:List[str]
    diagnostics:Diagnostics
    sources:SourceStore
-> ParseResolveResult {
    sources diagnostics symbol_store_new Parser::new = parser
    search_paths parser Parser::set_search_paths
    tokens parser parse_ops = ops
    Set[str]::new ops parser.finish_resolution
}

# ============================================================================
# resolve_identifiers - post-parse pass
# ============================================================================

fn gather_captures store:SymbolStore lambda_function:Function function:Function {
    for op in lambda_function Function::ops.iter do
        Option[str]::None = name_opt
        if op.value OpValue::Identifier(identifier_name) is then
            identifier_name Option::Some = name_opt
        elif
        op.value OpValue::AssignVar is
        op.value OpValue::AssignInc is ||
        op.value OpValue::AssignDec is ||
        then
            op op_str_value "." str::split = target_parts
            if target_parts.length 1 < then
                0 target_parts.get Option::Some = name_opt
            fi
        fi
        if name_opt Option::Some(name) is then
            false = captured

            # Check enclosing function variables
            for variable in function Function::variables.iter do
                if name variable Variable::name == then
                    variable lambda_function Function::captures.push
                    true = captured
                    break
                fi
            done

            if captured ! then
                # Check global variables
                name store.variables.get = global_var_opt
                if global_var_opt Option::Some(global_var) is then
                    global_var lambda_function Function::captures.push
                fi
            fi
        fi
    done
}

fn resolve_array_identifiers
    store:SymbolStore
    items:List[Op]
    function:Function
    errors:List[CasaError]
    diagnostics:Diagnostics
{
    for rai_item in items.iter do
        if rai_item.value OpValue::PushArray(inner_items) is then
            diagnostics errors function inner_items store resolve_array_identifiers
        elif rai_item.value OpValue::ExprGroup(group_inner) is then
            diagnostics function group_inner store resolve_identifiers drop
        elif rai_item.value OpValue::Identifier(rai_name) is then
            if rai_name function Function::variables variable_list_contains then
                rai_name OpValue::PushVar rai_item Op::set_value
            elif rai_name function Function::captures variable_list_contains then
                rai_name OpValue::PushCapture rai_item Op::set_value
            elif rai_name store.variables.get.is_some then
                rai_name OpValue::PushVar rai_item Op::set_value
            elif rai_name store.constants.get = rai_const_opt rai_const_opt Option::Some(rai_const) is then
                rai_const Constant::value = rai_const_value
                rai_const_value match
                    ConstantValue::Int(rai_const_int) => { rai_const_int OpValue::PushInt rai_item Op::set_value }
                    ConstantValue::Float(rai_const_float) => { rai_const_float OpValue::PushFloat rai_item Op::set_value }
                    ConstantValue::Str(rai_const_str) => { rai_const_str OpValue::PushStr rai_item Op::set_value }
                    ConstantValue::Bool(rai_const_bool) => { rai_const_bool OpValue::PushBool rai_item Op::set_value }
                    ConstantValue::Char(rai_const_char) => { rai_const_char OpValue::PushChar rai_item Op::set_value }
                end
            elif errors rai_name rai_item store try_resolve_enum_variant_ident then
            elif rai_name store.functions.get Option::Some(rai_fn) is then
                rai_name OpValue::FnPush rai_item Op::set_value
                true rai_fn Function::set_is_used
            else
                rai_item Op::location f"Identifier `{rai_name}` is not defined" ErrorKind::UndefinedName CasaError::new errors.push
            fi
        fi
    done
}

fn resolve_enum_variant
    store:SymbolStore
    variant:EnumVariant
    op:Op
    function:Function
    errors:List[CasaError]
{
    # Resolve enum variant ordinal if still unresolved
    if variant EnumVariant::enum_name.length 0 != variant EnumVariant::ordinal.is_none && then
        variant EnumVariant::enum_name store.enums.get = rev_enum_opt
        if rev_enum_opt.is_none then
            op Op::location f"Enum `{variant EnumVariant::enum_name}` is not defined" ErrorKind::UndefinedName CasaError::new errors.push
        else
            rev_enum_opt.unwrap = rev_enum
            variant EnumVariant::variant_name rev_enum CasaEnum::variants string_list_index = rev_ordinal
            if 0 rev_ordinal < then
                op Op::location f"Variant `{variant EnumVariant::variant_name}` is not defined in enum `{variant EnumVariant::enum_name}`" ErrorKind::UndefinedName CasaError::new errors.push
            else
                rev_ordinal Option::Some variant EnumVariant::set_ordinal
            fi
        fi
    fi
    # Register bindings as variables
    if 0 variant EnumVariant::bindings.length != then
        for rev_var_name in variant EnumVariant::bindings.iter do
            rev_var_name Variable::new = rev_var
            if GLOBAL_SCOPE_LABEL function Function::name == then
                rev_var rev_var_name store.variables.set drop
            else
                if rev_var_name function Function::variables variable_list_contains ! then
                    rev_var function Function::variables.push
                fi
            fi
        done
    fi
}

impl Parser {
    fn analyze_import
        self:Parser
        import_path:str
        included_files:Set[str]
        base_store:SymbolStore
    -> Result[ParseResolveResult IoError] {
        self.sources import_path lex_file = import_result
        if import_result Result::Error(read_error) is then read_error Result::Error return fi
        import_result.unwrap = lex_result
        Diagnostics::new = diagnostics
        lex_result.diagnostics diagnostics.merge
        if diagnostics.has_errors then
            diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult Result::Ok
            return
        fi
        base_store.functions.keys string_list_to_set = existing_functions
        base_store.clone = imported_store
        self.sources diagnostics imported_store Parser::new = import_parser
        self.search_paths = import_parser.search_paths
        included_files = import_parser.included_files
        lex_result.tokens import_parser parse_ops = imported_ops
        if diagnostics.has_errors import_parser.state.has_usable_output ! || then
            diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult Result::Ok
            return
        fi
        existing_functions imported_ops import_parser.finish_resolution = result
        if result.diagnostics.has_errors then
            result.diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult Result::Ok
            return
        fi
        result Result::Ok
    }
}

fn expand_imports parser:Parser ops:List[Op] -> List[Op] {
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get = current_op
        1 += op_index

        if current_op.value OpValue::ImportFileSelective(selective_import) is then
            current_op.location selective_import parser handle_selective_import
            if parser.state.has_usable_output ! then ops return fi
            continue
        fi

        if current_op.value OpValue::ImportFile(import_path) is then
            if 0 import_path.length == then
                continue
            fi
            if import_path parser.included_files.has ! then
                import_path parser.included_files.add drop
                parser.store parser.included_files import_path parser.analyze_import = import_result
                if import_result Result::Error(read_error) is then
                    current_op.location f"Cannot read import `{import_path}`: {read_error.to_str}" ErrorKind::Syntax parser.state.diagnostics.record_error_at_encounter
                    parser.state.mark_output_unusable
                    ops return
                fi
                import_result.unwrap = imported_result
                current_op.location imported_result.diagnostics parser.state.diagnostics.merge_at_encounter
                if imported_result.ops Option::Some(import_ops) is then
                    imported_result.store parser.store.merge_import
                    List[Op]::new = new_ops
                    0 (u64) = name_index
                    while name_index op_index > do
                        name_index ops.get new_ops.push
                        1 += name_index
                    done
                    for inner_op in import_ops.iter do
                        inner_op new_ops.push
                    done
                    for remaining_op in op_index ops.iter.skip do
                        remaining_op new_ops.push
                    done
                    import_ops.length += op_index
                    new_ops = ops
                else
                    parser.state.mark_output_unusable
                    ops return
                fi
            fi
            continue
        fi
    done
    ops
}

fn resolve_identifiers_global parser:Parser ops:List[Op] -> List[Op] {
    ops parser expand_imports = expanded_ops
    if parser.state.has_usable_output ! then List[Op]::new return fi
    empty_location List[Op]::new GLOBAL_SCOPE_LABEL Function::new = dummy
    parser.state.diagnostics dummy expanded_ops parser.store resolve_identifiers
}

fn resolve_identifiers
    store:SymbolStore
    ops:List[Op]
    function:Function
    diagnostics:Diagnostics
-> List[Op] {
    0 (u64) = op_index
    List[CasaError]::new = resolve_errors
    Set[str]::new = declared_globals
    while op_index ops.length > do
        op_index ops.get = current_op
        1 += op_index

        if current_op.value OpValue::DeclareGlobal(global_name) is then
            if global_name store.variables.get.is_none then
                current_op Op::location f"`{global_name}` is not a global variable" ErrorKind::UndefinedGlobal CasaError::new resolve_errors.push
            fi
            global_name declared_globals.add = declared_globals
            continue
        fi

        if current_op.value OpValue::AssignInc(inc_name) is then
            inc_name "." str::split = inc_parts
            0 inc_parts.get = inc_root
            if inc_root store.constants.get.is_some then
                current_op Op::location f"Cannot assign to constant `{inc_root}`" ErrorKind::Syntax CasaError::new resolve_errors.push
                continue
            fi
        fi

        if current_op.value OpValue::AssignDec(dec_name) is then
            dec_name "." str::split = dec_parts
            0 dec_parts.get = dec_root
            if dec_root store.constants.get.is_some then
                current_op Op::location f"Cannot assign to constant `{dec_root}`" ErrorKind::Syntax CasaError::new resolve_errors.push
                continue
            fi
        fi

        if current_op.value OpValue::AssignVar(var_name) is then
            var_name "." str::split = var_parts
            0 var_parts.get = var_root
            if var_root store.constants.get.is_some then
                current_op Op::location f"Cannot assign to constant `{var_root}`" ErrorKind::Syntax CasaError::new resolve_errors.push
                continue
            fi
            if var_parts.length 1 < then continue fi
            var_name Variable::new = variable
            if GLOBAL_SCOPE_LABEL function Function::name == then
                if var_name store.variables.has ! then variable var_name store.variables.set drop fi
                continue
            fi
            if var_name function Function::variables variable_list_contains ! then
                if var_name declared_globals.has ! then
                    variable function Function::variables.push
                fi
            fi
            continue
        fi

        if current_op.value OpValue::FnPush(fn_name) is then
            fn_name store.functions.get = lambda_opt
            if lambda_opt.is_some then
                lambda_opt.unwrap = lambda
                true lambda Function::set_is_used
                function lambda store gather_captures
                diagnostics lambda lambda Function::ops store resolve_identifiers = lambda_resolved
                lambda_resolved lambda Function::set_ops
            fi
            continue
        fi

        if current_op.value OpValue::PushArray(items_inner) is then
            diagnostics resolve_errors function items_inner store resolve_array_identifiers
            continue
        fi

        if current_op.value OpValue::ExprGroup(group_inner) is then
            diagnostics function group_inner store resolve_identifiers drop
            continue
        fi

        if current_op.value OpValue::Identifier(ident) is then
            if resolve_errors ident current_op function store try_resolve_fn_ref then continue fi
            if ident current_op try_resolve_numeric_call then continue fi
            if resolve_errors ident current_op store try_resolve_enum_variant_ident then continue fi
            if ident current_op function try_resolve_trait_method_call then continue fi
            resolve_errors ident current_op function store resolve_plain_identifier
            if current_op.value OpValue::FnCall(resolved_fn_name) is then
                diagnostics current_op resolved_fn_name op_index ops store try_fold_const_fn_call = op_index
            fi
            continue
        fi

        if current_op.value OpValue::MatchArm is then
            diagnostics resolve_errors current_op function store resolve_match_op
            continue
        fi

        if current_op.value OpValue::IsCheck(is_enum_variant) is then
            resolve_errors function current_op is_enum_variant store resolve_enum_variant
            continue
        fi
    done

    for resolve_error in resolve_errors.iter do
        resolve_error diagnostics.push_error
    done
    ops
}
# Try resolving compiler-owned numeric associated conversion calls.

fn try_resolve_numeric_call op:Op ident:str -> bool {
    ident "::" str::find = separator
    if separator 0 <= ! then false return fi
    ident 0 separator (u64) str::substring parse_builtin = target_opt
    if target_opt.is_none then false return fi
    ident separator 2 + (u64) ident.length separator (u64) - 2 - str::substring = method
    if
    "from" method ==
    "from_bits" method == ||
    "round_from" method == ||
    "trunc_from" method == ||
    "wrapping_from" method == ||
    "from_codepoint_unchecked" method == ||
    "__from_decimal_parts" method == ||
    "__float_significand" method == ||
    "try_from" method == || !
    then
        false return
    fi
    target_opt.unwrap method NumericCall OpValue::NumericCall op Op::set_value
    true
}
# resolve_match_op — per-arm identifier resolution entry point.
# Registers struct-pattern field bindings as locals/globals and resolves
# enum-variant ordinals (delegating to resolve_enum_variant). Literal and
# wildcard arms need no resolution.

fn register_struct_pattern_binding store:SymbolStore function:Function binding_name:str {
    binding_name Variable::new = match_struct_variant
    if GLOBAL_SCOPE_LABEL function Function::name == then
        match_struct_variant binding_name store.variables.set drop
    else
        if binding_name function Function::variables variable_list_contains ! then
            match_struct_variant function Function::variables.push
        fi
    fi
}

fn resolve_match_op
    store:SymbolStore
    function:Function
    op:Op
    errors:List[CasaError]
    diagnostics:Diagnostics
{
    if op.value OpValue::MatchArm(arm) is then
        arm.pattern_value match
            PatternValue::Struct(struct_pattern) => {
                struct_pattern.bindings.keys = pattern_keys
                for pattern_key in pattern_keys.iter do
                    pattern_key struct_pattern.bindings.get.unwrap = binding_name
                    binding_name function store register_struct_pattern_binding
                done
            }
            PatternValue::EnumVariant(variant) => {
                errors function op variant store resolve_enum_variant
            }
            PatternValue::Literal => { }
        end
        arm.guard_ops = guard_ops
        if guard_ops.length 0 != then
            diagnostics function guard_ops store resolve_identifiers = resolved_guard
            resolved_guard arm MatchArm::set_guard_ops
        fi
    fi
}
# Try resolving `&name` and `&K::method` function references. Returns true
# if the identifier begins with `&`, in which case the op has been rewritten
# (or an error pushed) and the caller should skip further resolution.

fn try_resolve_fn_ref
    store:SymbolStore
    function:Function
    op:Op
    ident:str
    resolve_errors:List[CasaError]
-> bool {
    if '&' 0 ident.at != then false return fi
    ident 1 ident.length 1 - str::substring = ref_name
    if 0 ref_name.length == then
        op Op::location "Expected function name after `&`" ErrorKind::Syntax CasaError::new resolve_errors.push
        true return
    fi
    if ref_name "::" str::find 0 <= then
        ref_name 0 ref_name "::" str::find(u64) str::substring = ref_type_var
        ref_type_var function Function::stack_effect StackEffect::trait_bounds.get = ref_bound_opt
        if ref_bound_opt.is_some then
            ref_name ref_name "::" str::find 2 + (u64) ref_name.length ref_name "::" str::find(u64) - 2 - str::substring = ref_trait_method
            f"__trait_{ref_type_var}_{ref_trait_method}" = ref_hidden
            ref_hidden OpValue::PushVar op Op::set_value
            true return
        fi
    fi
    ref_name store.functions.get = ref_fn_opt
    if ref_fn_opt Option::Some(ref_fn) is then
        ref_name OpValue::FnPush op Op::set_value
        true ref_fn Function::set_is_used
    else
        op Op::location f"Function `{ref_name}` is not defined" ErrorKind::UndefinedName CasaError::new resolve_errors.push
    fi
    true
}
# Try resolving `Enum::Variant` identifiers. Returns true if the enum is
# known (op rewritten, or undefined-variant error pushed).

fn try_resolve_enum_variant_ident
    store:SymbolStore
    op:Op
    ident:str
    resolve_errors:List[CasaError]
-> bool {
    if ident "::" str::find 0 <= ! then false return fi
    ident "::" str::find = separator
    ident 0 separator (u64) str::substring = enum_name
    enum_name store.enums.get = enum_opt
    if enum_opt.is_none then false return fi
    ident separator 2 + (u64) ident.length separator (u64) - 2 - str::substring = binding_name
    enum_opt.unwrap = casa_enum
    binding_name casa_enum CasaEnum::variants string_list_index = ordinal
    if 0 ordinal < then
        op Op::location f"Variant `{binding_name}` is not defined in enum `{enum_name}`" ErrorKind::UndefinedName CasaError::new resolve_errors.push
    else
        ordinal Option::Some binding_name enum_name EnumVariant::new = enum_variant
        enum_variant OpValue::PushEnumVariant op Op::set_value
    fi
    true
}
# Try resolving `K::method` trait-bound method calls. Returns true if K is
# a trait-bound type variable on the enclosing function's stack effect.

fn try_resolve_trait_method_call function:Function op:Op ident:str -> bool {
    if ident "::" str::find 0 <= ! then false return fi
    ident 0 ident "::" str::find(u64) str::substring = type_var
    if type_var function Function::stack_effect StackEffect::trait_bounds.get.is_some ! then false return fi
    ident ident "::" str::find 2 + (u64) ident.length ident "::" str::find(u64) - 2 - str::substring = trait_method
    f"__trait_{type_var}_{trait_method}" = hidden_var
    if hidden_var function Function::variables variable_list_contains ! then
        hidden_var Variable::new function Function::variables.push
    fi
    hidden_var OpValue::TraitMethodCall op Op::set_value
    true
}
# Resolve a bare identifier after `&`-ref, enum-variant, and trait-method
# attempts have already failed. Rewrites `op` in place to the matching op
# kind or pushes an `UndefinedName` error.

fn resolve_plain_identifier
    store:SymbolStore
    function:Function
    op:Op
    ident:str
    resolve_errors:List[CasaError]
{
    if ident function Function::variables variable_list_contains then
        ident OpValue::PushVar op Op::set_value
        return
    fi

    ident store.functions.get = generic_fn_opt
    if generic_fn_opt Option::Some(generic_fn) is then
        ident OpValue::FnCall op Op::set_value
        true generic_fn Function::set_is_used
        return
    fi

    if ident function Function::captures variable_list_contains then
        ident OpValue::PushCapture op Op::set_value
        return
    fi

    if ident store.variables.get.is_some then
        ident OpValue::PushVar op Op::set_value
        return
    fi

    ident store.constants.get = const_opt
    if const_opt Option::Some(casa_const) is then
        casa_const Constant::value = const_value
        const_value match
            ConstantValue::Int(const_int) => {
                const_int OpValue::PushInt op Op::set_value
            }
            ConstantValue::Float(const_float) => {
                const_float OpValue::PushFloat op Op::set_value
            }
            ConstantValue::Str(const_str) => {
                const_str OpValue::PushStr op Op::set_value
            }
            ConstantValue::Bool(const_bool) => {
                const_bool OpValue::PushBool op Op::set_value
            }
            ConstantValue::Char(const_char) => {
                const_char OpValue::PushChar op Op::set_value
            }
        end
        return
    fi

    ident store.structs.get = struct_opt
    if struct_opt Option::Some(casa_struct) is then
        casa_struct OpValue::StructNew op Op::set_value
        return
    fi

    ident store.enums.get = resolved_enum_opt
    if resolved_enum_opt Option::Some(resolved_enum) is then
        resolved_enum CasaEnum::variants.length (i64) make_integer_op_value op Op::set_value
        return
    fi

    op Op::location f"Identifier `{ident}` is not defined" ErrorKind::UndefinedName CasaError::new resolve_errors.push
}
