    location.clone "self" OpValue::PushVar Op::new ops.push
    location.clone OpValue::MatchStart Op::new ops.push
    0 (u64) = variant_index
    for variant_name in casa_enum.variants.iter do
        List[str]::new = bindings
        if variant_name casa_enum.variant_types.get Option::Some(payload_types) is then
            0 (u64) = payload_index
            while payload_index payload_types.length > do
                f"__copy_clone_{variant_index}_{payload_index}" bindings.push
                1 += payload_index
            done
        fi
        bindings.length = binding_count
        variant_index (i64) Option::Some variant_name.clone casa_enum.name.clone EnumVariant::new = pattern_variant
        bindings pattern_variant EnumVariant::set_bindings
        List[Op]::new pattern_variant PatternValue::EnumVariant MatchArm::new = arm
        location.clone arm OpValue::MatchArm Op::new ops.push
        binding_count = binding_index
        while 0 binding_index != do
            1 -= binding_index
            location.clone f"__copy_clone_{variant_index}_{binding_index}" OpValue::PushVar Op::new ops.push
            variant_name casa_enum
                .variant_types
                .get
                .unwrap = payload_types
            if binding_index payload_types.get.is_shared_borrow ! then
                location.clone "clone" OpValue::MethodCall Op::new ops.push
            fi
        done
        variant_index (i64) Option::Some variant_name.clone casa_enum.name.clone EnumVariant::new = constructor
        location.clone constructor OpValue::PushEnumVariant Op::new ops.push
        1 += variant_index
    done
    location.clone OpValue::MatchEnd Op::new ops.push
}

fn make_copy_clone_fallback
    parser:mut$Parser
    trait_impl:mut$TraitImpl
    function_name:mut$str
-> Function {
    List[Parameter]::new = parameters
    SHARED_BORROW_TYPE trait_impl.receiver clone_type apply_borrow_type = receiver
    "self" receiver Parameter::named parameters.push
    List[Type]::new = returns
    trait_impl.receiver returns.push
    returns parameters StackEffect::new = effect
    trait_impl.type_vars string_list_to_set = effect.type_vars
    trait_impl.trait_bounds effect StackEffect::set_trait_bounds

    List[Op]::new = ops
    List[Variable]::new = variables
    if
        0 trait_impl
            .trait_bounds
            .keys
            .length !=
    then
        List[Parameter]::new = hidden_parameters
        trait_impl.trait_bounds parser build_hidden_trait_methods = hidden_methods
        for hidden in hidden_methods.iter do
            hidden.var_name hidden.fn_type Parameter::named hidden_parameters.push
            hidden.fn_type hidden.var_name Variable variables.push
            trait_impl.location hidden.var_name OpValue::AssignVar Op::new = hidden_assign
            hidden.fn_type Option::Some hidden_assign Op::set_type_hint
            hidden_assign ops.push
        done
        0 (u64) = visible_param_index
        while visible_param_index effect.parameters.length > do
            visible_param_index effect.parameters.get hidden_parameters.push
            1 += visible_param_index
        done
        hidden_parameters effect StackEffect::set_parameters
    fi
    receiver "self" Variable variables.push
    trait_impl.location "self" OpValue::AssignVar Op::new ops.push
    trait_impl.receiver.match_base = receiver_name
    if
        receiver_name parser
            .store
            .structs
            .get Option::Some(casa_struct) is
    then
        ops trait_impl.location casa_struct append_struct_copy_clone_body
    elif
        receiver_name parser
            .store
            .enums
            .get Option::Some(casa_enum) is
    then
        ops trait_impl.location casa_enum append_enum_copy_clone_body
    else
        trait_impl.location "self" OpValue::PushVar Op::new ops.push
    fi

    effect trait_impl.location ops function_name Function::with_stack_effect = function
    variables function Function::set_variables
    function
}

fn synthesize_copy_clone_fallbacks parser:mut$Parser {
    if
        "Copy" parser
            .store
            .traits
            .has ! "Clone" parser
            .store
            .traits
            .has ! ||
    then
        return
    fi
    "Copy" GenericType::new Type::Generic = copy_type
    "Clone" GenericType::new Type::Generic = clone_trait_type
    if parser.store clone_trait_type copy_type trait_type_implies ! then
        return
    fi
    parser
        .store
        .trait_impls
        .values = copy_trait_impls
    0 (u64) = copy_impl_index
    while copy_impl_index copy_trait_impls.length > do
        copy_impl_index copy_trait_impls.get = trait_impl
        1 += copy_impl_index
        trait_impl.trait_bound trait_bound_to_type = implemented_trait
        if parser.store copy_type implemented_trait trait_type_implies ! then
            continue
        fi
        parser.store clone_trait_type clone_type Option::Some trait_impl.receiver "clone" resolve_trait_method_semantics_for = clone_method
        if clone_method Option::Some(method) is then
            method.function_name "clone" trait_impl.methods.set = trait_impl.methods
            continue
        fi
        f"{trait_impl.receiver.match_base}::Copy::clone" = function_name
        if
            function_name parser
                .store
                .functions
                .has !
        then
            function_name trait_impl parser make_copy_clone_fallback = function
            function function_name parser
                .store
                .functions
                .set drop
        fi
        function_name "clone" trait_impl.methods.set = trait_impl.methods
    done
}

fn validate_trait_impls parser:mut$Parser {
    for
        trait_impl in parser
            .store
            .trait_impls
            .values
            .iter
    do
        if trait_impl.receiver Type::TypeVar(_) is then
            trait_impl.location "A trait implementation cannot target a type variable." ErrorKind::InvalidScope parser.state.record_error
            continue
        fi
        trait_impl.trait_bound.name parser
            .store
            .traits
            .get = trait_opt
        if trait_opt.is_none then
            trait_impl.location f"Trait `{trait_impl.trait_bound.name}` is not defined" ErrorKind::UndefinedName parser.state.record_error
            continue
        fi
        trait_opt.unwrap = casa_trait
        trait_impl.trait_bound trait_bound_to_type = trait_type
        trait_type trait_impl parser validate_copy_trait_impl
        if
            trait_impl
                .trait_bound
                .type_args
                .length casa_trait.type_params.length !=
        then
            trait_impl.location f"Trait `{casa_trait.name}` expects {casa_trait.type_params.length} type argument(s), got {trait_impl
                .trait_bound
                .type_args
                .length}" ErrorKind::Syntax parser.state.record_error
        fi
        if
            casa_trait.location.file trait_impl.location.file !=
            parser.store trait_impl.location trait_impl.receiver receiver_is_local ! &&
        then
            trait_impl.location f"Trait implementation `{trait_impl trait_impl_key}` must be declared in the module that defines the type or trait" ErrorKind::InvalidScope parser.state.record_error
        fi
    done
}

fn finalize_trait_impl_methods parser:mut$Parser {
    for
        trait_impl in parser
            .store
            .trait_impls
            .values
            .iter
    do
        trait_impl.trait_bound trait_bound_to_type = trait_type
        Map[str str]::new = trait_methods
        for pair in trait_impl.methods.iter do
            pair.first = method_name
            pair.second = function_name
            if parser.store method_name trait_type trait_type_has_method then
                function_name method_name trait_methods.set = trait_methods
                continue
            fi
            f"{trait_impl.receiver.match_base}::{method_name}" = inherent_name
            if
                inherent_name parser
                    .store
                    .functions
                    .has !
            then
                if
                    function_name parser
                        .store
                        .functions
                        .get Option::Some(function) is
                then
                    function.clone_for_import = inherent_function
                    inherent_name.clone inherent_function Function::set_name
                    inherent_function inherent_name parser
                        .store
                        .functions
                        .set drop
                fi
            fi
        done
        trait_methods trait_impl TraitImpl::set_methods
    done
}

fn parse_impl_block parser:mut$Parser cursor:mut$TokenCursor {
    fallback_token "impl" cursor expect_token_value.unwrap_or = impl_token

    # Parse optional type parameters with trait bounds
    List[str]::new = type_vars
    Map[str List[TraitBound]]::new = trait_bounds
    Map[str BuiltinType]::new = const_params
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.trait_bounds = trait_bounds
            parsed_type_variables.const_params = const_params
            # `names` mixes type variables and constant parameters; keep only
            # the type variables here (ADR-0152).
            parsed_type_variables.names = all_type_param_names
            for candidate_name in all_type_param_names.iter do
                if candidate_name const_params.has ! then
                    candidate_name.clone type_vars.push
                fi
            done
        fi
    fi

    cursor parse_type_ast = impl_type
    type_vars string_list_to_set = type_var_set
    type_var_set impl_type canonicalize_type_var = impl_type
    # Constant parameters in the implemented type are constants, not type
    # variables, so `array[T N]` keeps `N` symbolic (ADR-0152).
    if 0 const_params.keys.length != then
        const_params impl_type rewrite_type_const_params = impl_type
    fi

    # Get base type name (without type params)
    impl_type.match_base = base_type

    List[TraitBound]::new = implemented_traits
    Map[str str]::new = trait_impl_methods
    cursor.peek = colon_opt
    if colon_opt Option::Some(colon) is then
        if ":" colon.value == then
            cursor.pop drop
            true = parse_implemented_traits
            while parse_implemented_traits do
                fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = trait_token
                trait_token.value parser
                    .store
                    .traits
                    .get = trait_opt
                trait_token cursor parse_bound_type_args = trait_args
                0 (u64) = argument_index
                while argument_index trait_args.length > do
                    type_var_set argument_index trait_args.get canonicalize_type_var
                    argument_index trait_args.set
                    1 += argument_index
                done
                if trait_opt Option::Some(casa_trait) is then
                    if trait_args.length casa_trait.type_params.length != then
                        trait_token.location f"Trait `{trait_token.value}` expects {casa_trait.type_params.length} type argument(s), got {trait_args.length}" ErrorKind::Syntax parser.state.record_error
                    else
                        trait_args trait_token.value TraitBound implemented_traits.push
                    fi
                else
                    trait_args trait_token.value TraitBound implemented_traits.push
                fi
                cursor.peek = plus_opt
                if plus_opt Option::Some(plus) is then
                    if "+" plus.value == then
                        cursor.pop drop
                    else
                        false = parse_implemented_traits
                    fi
                else
                    false = parse_implemented_traits
                fi
            done
        fi
    fi

    fallback_token "{" cursor expect_token_value.unwrap_or drop
    while true do
        cursor.peek = fn_opt
        if fn_opt.is_none then
            break
        fi
        false = is_unsafe_method
        if fn_opt Option::Some(fn_token) is then
            if "unsafe" fn_token Token::value == then
                true = is_unsafe_method
                cursor.pop drop
            elif "fn" fn_token Token::value != then
                break
            fi
        fi
        cursor parser parse_function = function
        is_unsafe_method function Function::set_is_unsafe
        function Function::name = method_name
        if "drop" method_name == 0 implemented_traits.length != && then
            function.location "`drop` must be declared in an inherent implementation" ErrorKind::InvalidScope parser.state.record_error
        fi
        "" = fn_name
        if 0 implemented_traits.length != then
            0 implemented_traits.get trait_bound_to_type.format = trait_name
            f"{base_type}::{trait_name}::{method_name}" = fn_name
            fn_name.clone method_name trait_impl_methods.set = trait_impl_methods
        else
            f"{base_type}::{method_name}" = fn_name
        fi
        fn_name.clone function Function::set_name
        # Merge inherited type vars, trait bounds, and constant parameters
        if 0 type_vars.length != 0 const_params.keys.length != || then
            const_params trait_bounds type_vars function parser inject_implementation_parameters
        fi
        if
            fn_name parser
                .store
                .functions
                .get
                .is_some
        then
            function Function::location f"Identifier `{fn_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
        fi
        function fn_name parser.put_function
    done
    fallback_token "}" cursor expect_token_value.unwrap_or drop

    for implemented_trait in implemented_traits.iter do
        Map[str str]::new = cloned_methods
        for pair in trait_impl_methods.iter do
            pair.second.clone pair.first.clone cloned_methods.set = cloned_methods
        done
        Map[str List[TraitBound]]::new = cloned_bounds
        for pair in trait_bounds.iter do
            pair.second.shallow_copy pair.first.clone cloned_bounds.set = cloned_bounds
        done
        impl_token.location cloned_methods cloned_bounds type_vars.shallow_copy
        implemented_trait impl_type clone_type TraitImpl
        parser register_trait_impl
    done
}

# ============================================================================
# parse_match_block - parse a full match construct (match ... end)
# ============================================================================

fn is_match_arm_boundary parser:mut$Parser cursor:mut$TokenCursor -> bool {
    cursor TokenCursor::pos = pos
    cursor TokenCursor::tokens = token_list
    if pos 1 + token_list.length < then
        false return
    fi
    pos token_list.get = token
    pos 1 + token_list.get = next_token

    # _ => or _ if ...
    if MATCH_WILDCARD token Token::value == then
        if "=>" next_token Token::value == then
            true return
        fi
        if "if" next_token Token::value == then
            true return
        fi
    fi
    # literal => or literal if ...
    if TokenKind::Literal token Token::kind == then
        if "=>" next_token Token::value == then
            true return
        fi
        if "if" next_token Token::value == then
            true return
        fi
    fi
    if TokenKind::Identifier token Token::kind != then
        false return
    fi
    # Identifier => or Identifier if ...
    if "=>" next_token Token::value == then
        true return
    fi
    if "if" next_token Token::value == then
        true return
    fi
    # StructName { ... } =>
    if
        "{" next_token Token::value ==
        token Token::value parser
            .store
            .structs
            .get
            .is_some parser.syntax_only || &&
    then
        true return
    fi
    # EnumName::Variant(bindings) => or EnumName::Variant(bindings) if ...
    if "(" next_token Token::value == then
        token Token::value "::" str::find = separator
        if 0 separator > then
            pos 2 + = scan_pos
            while scan_pos token_list.length > do
                if ")" scan_pos token_list.get Token::value == then
                    if scan_pos 1 + token_list.length > then
                        scan_pos 1 + token_list.get Token::value = after_paren
                        if "=>" after_paren == then
                            true return
                        fi
                        if "if" after_paren == then
                            true return
                        fi
                    fi
                    break
                fi
                1 += scan_pos
            done
        fi
    fi
    false
}

fn parse_struct_match_pattern
    parser:mut$Parser
    name_token:mut$Token
    cursor:mut$TokenCursor
-> StructPattern {
    fallback_token "{" cursor expect_token_value.unwrap_or drop
    name_token Token::value parser
        .store
        .structs
        .get = struct_opt
    if struct_opt.is_none parser.syntax_only ! && then
        name_token Token::location f"Struct `{name_token Token::value}` is not defined" ErrorKind::UndefinedName parser.state.record_error
    fi
    Map[str str]::new = bindings

    while true do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token Token::location "Unexpected end of input in struct pattern" ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
        if next_opt Option::Some(next) is then
            if "}" next Token::value == then
                cursor.pop drop
                break
            fi
        fi
        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = field_token
        fallback_token ":" cursor expect_token_value.unwrap_or drop
        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = var_token
        var_token Token::value field_token Token::value bindings.set = bindings
    done

    bindings name_token Token::value StructPattern
}
# parse_pattern_terminator — consume the `=>` that separates a match-arm
# pattern from its body. If an `if` keyword appears first the guard
# expression is collected until `=>`. Returns the (possibly empty) list of
# guard ops. The trailing `=>` token is always consumed.
#
# The guard expression may contain a nested `match` block whose arms also
# use `=>`; a match-depth counter skips those nested arrows so only the
# outer arm terminator ends the guard.

fn parse_pattern_terminator
    parser:mut$Parser
    cursor:mut$TokenCursor
    function_name:mut$str
-> List[Op] {
    List[Op]::new = guard_ops
    cursor.peek = guard_peek
    if { Token::value "if" == } guard_peek.filter.is_some then
        cursor.pop drop # consume `if`
        0 = match_depth
        while cursor.is_finished ! do
            cursor.peek = next_opt
            if next_opt.is_none then
                break
            fi
            next_opt.unwrap Token::value = next_value
            if "=>" next_value == 0 match_depth == && then
                break
            fi
            cursor.pop = guard_token_opt
            if guard_token_opt.is_none then
                break
            fi
            guard_token_opt.unwrap = guard_token
            if "match" guard_token Token::value == then
                1 += match_depth
            elif "end" guard_token Token::value == 0 match_depth != && then
                1 -= match_depth
            fi
            if TokenKind::FstringStart guard_token Token::kind == then
                guard_ops function_name cursor guard_token parser handle_fstring
                continue
            fi
            guard_ops function_name cursor guard_token parser token_to_op
        done
    fi
    fallback_token "=>" cursor expect_token_value.unwrap_or drop
    guard_ops
}

fn parse_literal_match_pattern token:mut$Token parser:mut$Parser -> LiteralPattern {
    token Token::value = value
    if "true" value == then
        "true" true LiteralValue::Bool LiteralPattern return
    fi
    if "false" value == then
        "false" false LiteralValue::Bool LiteralPattern return
    fi
    if 0 value.at.is_digit value is_negative_integer_literal || then
        value.clone value.clone str_to_int value IntegerLiteral::new LiteralValue::Int LiteralPattern return
    fi
    if value char_literal_codepoint Option::Some(character) is then
        value character LiteralValue::Char LiteralPattern return
    fi
    if '"' 0 value.at == '"' value.length 1 - value.at == && then
        value.length = value_length
        value 1 value_length 2 - str::substring = string_value
        value string_value LiteralValue::Str LiteralPattern return
    fi
    token Token::location f"Unsupported literal in match arm: `{value}`" ErrorKind::UnexpectedToken parser.state.record_error
    # Unreachable
    "" 0 IntegerLiteral::from_int LiteralValue::Int LiteralPattern
}
# Parse one match-arm pattern (wildcard, literal, struct, bare ident, or
# Enum::Variant) plus its optional guard, append the OpMatchArm to `ops`.

fn parse_match_arm_pattern
    parser:mut$Parser
    arm_token:mut$Token
    cursor:mut$TokenCursor
    function_name:mut$str
    ops:mut$List[Op]
{
    if MATCH_WILDCARD arm_token Token::value == then
        function_name cursor parser parse_pattern_terminator = wildcard_guard_ops
        Option::None MATCH_WILDCARD "" EnumVariant::new = wildcard
        wildcard_guard_ops wildcard PatternValue::EnumVariant MatchArm::new = wildcard_arm
        arm_token Token::location wildcard_arm OpValue::MatchArm Op::new ops.push
    elif TokenKind::Literal arm_token Token::kind == then
        function_name cursor parser parse_pattern_terminator = literal_guard_ops
        parser arm_token parse_literal_match_pattern = literal_pattern
        literal_guard_ops literal_pattern PatternValue::Literal MatchArm::new = literal_arm
        arm_token Token::location literal_arm OpValue::MatchArm Op::new ops.push
    elif TokenKind::Identifier arm_token Token::kind != then
        arm_token Token::location "Expected match pattern or `_`" ErrorKind::UnexpectedToken parser.state.record_error
    elif
        { Token::value "{" == } cursor
            .peek
            .filter
            .is_some
    then
        cursor arm_token parser parse_struct_match_pattern = struct_pattern
        function_name cursor parser parse_pattern_terminator = struct_guard_ops
        struct_guard_ops struct_pattern PatternValue::Struct MatchArm::new = struct_arm
        arm_token Token::location struct_arm OpValue::MatchArm Op::new ops.push
    elif arm_token Token::value "::" str::find 0 > then
        function_name cursor parser parse_pattern_terminator = bare_guard_ops
        Option::None arm_token Token::value "" EnumVariant::new = bare_variant
        bare_guard_ops bare_variant PatternValue::EnumVariant MatchArm::new = bare_arm
        arm_token Token::location bare_arm OpValue::MatchArm Op::new ops.push
    else
        arm_token Token::value "::" str::find = separator
        arm_token Token::value 0 separator (u64) str::substring = enum_name
        arm_token Token::value separator 2 + (u64) arm_token Token::value.length separator (u64) - 2 - str::substring = variant_name

        List[str]::new = bindings
        cursor.peek = paren_opt
        if { Token::value "(" == } paren_opt.filter.is_some then
            cursor.pop drop
            while true do
                cursor.peek = inner_opt
                if inner_opt.is_none then
                    arm_token Token::location "Unexpected end of input in match arm bindings" ErrorKind::UnexpectedToken parser.state.record_error
                    parser.state.mark_output_unusable
                    break
                fi
                if inner_opt Option::Some(inner) is then
                    if ")" inner Token::value == then
                        cursor.pop drop
                        break
                    fi
                fi
                fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = binding_token
                binding_token Token::value bindings.push
            done
        fi

        function_name cursor parser parse_pattern_terminator = enum_guard_ops
        Option::None variant_name enum_name EnumVariant::new = variant
        bindings variant EnumVariant::set_bindings
        enum_guard_ops variant PatternValue::EnumVariant MatchArm::new = variant_arm
        arm_token Token::location variant_arm OpValue::MatchArm Op::new ops.push
    fi
}
# Parse a match-arm body (either a `{...}` block or a single-line expression
# up to the next arm boundary / `end`) and append its ops to `ops`.

fn parse_match_arm_body
    parser:mut$Parser
    cursor:mut$TokenCursor
    function_name:mut$str
    ops:mut$List[Op]
{
    cursor.peek = body_peek
    if { Token::value "{" == } body_peek.filter.is_some then
        function_name cursor parser parse_block_ops = block_ops
        block_ops ops.append
        return
    fi
    while cursor.is_finished ! do
        if cursor parser is_match_arm_boundary then
            break
        fi
        cursor.peek = end_peek
        if { Token::value "end" == } end_peek.filter.is_some then
            break
        fi
        cursor.pop = body_token_opt
        if body_token_opt.is_none then
            break
        fi
        body_token_opt.unwrap = body_token
        if TokenKind::FstringStart body_token Token::kind == then
            ops function_name cursor body_token parser handle_fstring
            continue
        fi
        ops function_name cursor body_token parser token_to_op
    done
}

fn parse_match_block
    parser:mut$Parser
    token:mut$Token
    cursor:mut$TokenCursor
    function_name:mut$str
-> List[Op] {
    List[Op]::new = ops
    token Token::location OpValue::MatchStart Op::new ops.push

    while true do
        fallback_token cursor expect_token.unwrap_or = arm_token
        if "end" arm_token Token::value == then
            arm_token Token::location OpValue::MatchEnd Op::new ops.push
            if parser.syntax_only then
                arm_token Token::location Location::span Span::offset
                token Token::location Location::span Span::offset
                SyntaxSpanKind::MatchForm parser.state.record_span
            fi
            break
        fi
        ops function_name cursor arm_token parser parse_match_arm_pattern
        ops function_name cursor parser parse_match_arm_body
        if parser.syntax_only then
            cursor.previous_offset
            arm_token Token::location Location::span Span::offset
            SyntaxSpanKind::MatchArm parser.state.record_span
        fi
    done
    ops
}

# ============================================================================
# _handle_keyword_import - parse import path
# ============================================================================

fn is_path_specifier spec:mut$str -> bool {
    spec ".casa" str::ends_with
    spec "/" str::contains ||
}

fn dir_of_path path:mut$str -> str {
    Option[u64]::None = last_slash
    0 (u64) = scan
    while scan path.length > do
        if '/' scan path.at == then
            scan Option::Some = last_slash
        fi
        1 += scan
    done
    if last_slash Option::Some(index) is then
        path 0 index 1 + str::substring
        return
    fi
    ""
}

fn resolve_import
    parser:mut$Parser
    importing_file:mut$str
    spec:mut$str
    location:mut$Location
-> str {
    importing_file dir_of_path = source_dir
    importing_file normalize_path = importing_normalized
    # Path-style: keep existing semantics (no existence check).
    if spec is_path_specifier then
        if spec "/" str::starts_with then
            spec
            return
        fi
        f"{source_dir}{spec}" normalize_path
        return
    fi
    # Module-style: probe source dir, then each search path. First hit wins.
    # Skip a same-dir match that resolves to the importing file itself, so an
    # example named `argparse.casa` importing "argparse" still finds the
    # library copy via -L.
    # `searched` accumulates probed dirs for the not-found error message.
    f"{source_dir}{spec}.casa" normalize_path = source_candidate
    if source_candidate.clone file::exists source_candidate importing_normalized != && then
        source_candidate
        return
    fi
    if 0 source_dir.length == then
        "."
    else
        source_dir
    fi
    = first_dir
    f"\n  {first_dir}" = searched
    for base in parser.search_paths.iter do
        f"{searched}\n  {base}" = searched
        f"{base}/{spec}.casa" normalize_path = candidate
        if candidate.clone file::exists then
            candidate
            return
        fi
    done
    location f"module `{spec}` not found, searched:{searched}" ErrorKind::Syntax parser.state.record_error
    parser.state.mark_output_unusable
    ""
}

fn parse_selective_import_symbols cursor:mut$TokenCursor location:mut$Location -> List[str] {
    List[str]::new = symbols
    fallback_token "{" cursor expect_token_value.unwrap_or drop
    while true do
        cursor.pop = symbol_opt
        if symbol_opt.is_none then
            location "Unclosed selective import list" ErrorKind::UnmatchedBlock cursor.state.record_error
            cursor.state.mark_output_unusable
            symbols return
        fi
        symbol_opt.unwrap = symbol_token
        if TokenKind::Comment symbol_token Token::kind == then
            continue
        fi
        if TokenKind::Newline symbol_token Token::kind == then
            continue
        fi
        if "}" symbol_token Token::value == then
            if 0 symbols.length == then
                symbol_token Token::location "Selective import list cannot be empty" ErrorKind::Syntax cursor.state.record_error
            fi
            symbols return
        fi
        if TokenKind::Identifier symbol_token Token::kind != then
            symbol_token Token::location "Expected identifier in selective import list" ErrorKind::UnexpectedToken cursor.state.record_error
        fi
        symbol_token Token::value symbols.push
    done
    symbols
}

fn handle_keyword_import parser:mut$Parser cursor:mut$TokenCursor -> Op {
    fallback_token TokenKind::Literal cursor expect_token_kind.unwrap_or = path_token
    cursor path_token get_op_literal = literal_op
    if literal_op.value OpValue::PushStr(spec) is then
        path_token Token::location = path_location
        if parser.syntax_only then
            spec.clone
        else
            path_location Location::file = importing_file
            path_location spec importing_file parser resolve_import
        fi
        = resolved

        cursor.peek = next_opt
        if { Token::value "{" == } next_opt.filter.is_some then
            path_location cursor parse_selective_import_symbols = symbols
            symbols resolved SelectiveImport = selective
            path_location selective OpValue::ImportFileSelective Op::new return
        fi
        path_location resolved OpValue::ImportFile Op::new return
    fi
    path_token Token::location "Expected string literal for import path" ErrorKind::UnexpectedToken parser.state.record_error
    # Unreachable - parser.state.record_error exits
    path_token Token::location "" OpValue::ImportFile Op::new
}

fn handle_selective_import parser:mut$Parser selective:SelectiveImport location:mut$Location {
    selective.path = import_path
    if 0 import_path.length == then
        return
    fi

    Set[str]::new = included_files
    import_path included_files.add drop
    symbol_store_new included_files import_path parser.analyze_import = import_result
    if import_result Result::Error(read_error) is then
        location f"Cannot read import `{import_path}`: {read_error.to_str}" ErrorKind::Syntax parser
            .state
            .diagnostics
            .record_error_at_encounter
        parser.state.mark_output_unusable
        return
    fi
    import_result.unwrap = imported_result
    location imported_result.diagnostics parser
        .state
        .diagnostics
        .merge_at_encounter
    if imported_result.ops Option::Some(_) is ! then
        parser.state.mark_output_unusable
        return
    fi

    location
    selective.symbols
    parser.store
    imported_result.store
    merge_selective_import_closure = merge_result
    if merge_result Result::Error(merge_diagnostics) is then
        location merge_diagnostics parser
            .state
            .diagnostics
            .merge_at_encounter
        parser.state.mark_output_unusable
        return
    fi
}

# ============================================================================
# handle_question_operator - desugar `?` to method calls
# ============================================================================
#
# The `?` operator is desugared at parse time into method calls on
# `is_ok` and `unwrap`, following the same pattern as `for` loops.
# No compiler knowledge of Result, Option, or any Try trait is needed.
#
# Source `value ?` lowers to roughly:
#
#     dup
#     if .is_ok ! then
#         (FnReturnType)
#         return
#     fi
#     .unwrap
#

fn handle_question_operator
    parser:mut$Parser
    token:mut$Token
    function_name:mut$str
    ops:mut$List[Op]
{
    token Token::location = loc

    # This temporary branch copy does not escape. #353 replaces it with the
    # ownership-aware propagation protocol.
    loc.clone OpValue::PropagationDup Op::new ops.push
    loc.clone OpValue::IfStart Op::new ops.push
    loc.clone "is_ok" OpValue::MethodCall Op::new ops.push
    loc.clone OpValue::Not Op::new ops.push
    loc.clone OpValue::IfCondition Op::new ops.push

    function_name parser
        .store
        .functions
        .get = fn_opt
    if fn_opt Option::Some(function) is then
        function Function::stack_effect StackEffect::return_types = ret_types
        if 0 ret_types.length != then
            0 ret_types.get = ret_type
            loc.clone ret_type OpValue::TypeCast Op::new ops.push
        fi
    fi

    loc.clone OpValue::FnReturn Op::new ops.push
    loc.clone OpValue::IfEnd Op::new ops.push
    loc.clone "unwrap" OpValue::MethodCall Op::new ops.push
}

# ============================================================================
# handle_keyword_for - parse `for <ident> in <expr> do <body> done`
# ============================================================================
#
# The for-loop is desugared at parse time into a `while` loop over the
# iterator's `next` method. The synthesized ops use only existing op kinds,
# so no new typechecker or bytecode support is required.
#
# Source `for x in <iter> do <body> done` lowers to roughly:
#
#     <iter_expr_ops>
#     = __for_iter_N
#     while
#         __for_iter_N .next
#         = __for_opt_N
#         __for_opt_N .is_some
#     do
#         __for_opt_N .unwrap
#         = x
#         <body_ops>
#     done
#
# The hidden variable names embed the source offset so nested for-loops do
# not collide. Nested `while`/`for` inside the body or the iterable
# expression are detected via depth counting on `while`/`for` openers and
# `done` closers so the enclosing `do`/`done` pair is identified correctly.

fn handle_keyword_for
    parser:mut$Parser
    token:mut$Token
    cursor:mut$TokenCursor
    function_name:mut$str
    ops:mut$List[Op]
{
    fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = loop_var_token
    loop_var_token Token::value = loop_var_name
    fallback_token "in" cursor expect_token_value.unwrap_or drop

    token Token::location = for_loc
    for_loc Location::span Span::offset = for_offset
    f"__for_iter_{for_offset}" = hidden_iter_name
    f"__for_opt_{for_offset}" = hidden_opt_name

    # Iterable-expression phase — emit ops until the matching `do`. These ops
    # leave the iterator value on the stack, which the synthesized
    # OpAssignVar below pops into the hidden iterator local.
    0 = nesting_depth
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            for_loc.clone "Unclosed `for` loop" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            return
        fi
        peek_opt.unwrap = peeked_token
        if "do" peeked_token Token::value == 0 nesting_depth == && then
            cursor.pop drop
            break
        fi
        if "while" peeked_token Token::value == then
            1 += nesting_depth
        fi
        if "done" peeked_token Token::value == 0 nesting_depth > && then
            nesting_depth 1 - = nesting_depth
        fi
        cursor.pop drop
        if TokenKind::FstringStart peeked_token Token::kind == then
            ops function_name cursor peeked_token parser handle_fstring
            continue
        fi
        ops function_name cursor peeked_token parser token_to_op
    done

    # Loop preamble: store iterator into hidden local, then open the while
    # loop with the `next`/`is_some` condition.
    for_loc.clone hidden_iter_name.clone OpValue::AssignVar Op::new ops.push
    for_loc.clone OpValue::WhileStart Op::new ops.push
    for_loc.clone hidden_iter_name OpValue::PushVar Op::new ops.push
    for_loc.clone "next" OpValue::MethodCall Op::new ops.push
    for_loc.clone hidden_opt_name.clone OpValue::AssignVar Op::new ops.push
    for_loc.clone hidden_opt_name.clone OpValue::PushVar Op::new ops.push
    for_loc.clone "is_some" OpValue::MethodCall Op::new ops.push
    for_loc.clone OpValue::WhileCondition Op::new ops.push
    for_loc.clone hidden_opt_name OpValue::PushVar Op::new ops.push
    for_loc.clone "unwrap" OpValue::MethodCall Op::new ops.push
    for_loc.clone loop_var_name OpValue::AssignVar Op::new ops.push

    # Body phase — emit ops until the matching `done`, then close the while.
    0 = body_nesting_depth
    while true do
        cursor.peek = body_peek_opt
        if body_peek_opt.is_none then
            for_loc.clone "Unclosed `for` loop body" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            return
        fi
        body_peek_opt.unwrap = body_token
        if "done" body_token Token::value == 0 body_nesting_depth == && then
            cursor.pop drop
            body_token Token::location OpValue::WhileEnd Op::new ops.push
            if parser.syntax_only then
                body_token Token::location Location::span Span::offset
                token Token::location Location::span Span::offset
                SyntaxSpanKind::ControlForm parser.state.record_span
            fi
            return
        fi
        if "while" body_token Token::value == then
            1 += body_nesting_depth
        fi
        if "done" body_token Token::value == 0 body_nesting_depth > && then
            body_nesting_depth 1 - = body_nesting_depth
        fi
        cursor.pop drop
        if TokenKind::FstringStart body_token Token::kind == then
            ops function_name cursor body_token parser handle_fstring
            continue
        fi
        ops function_name cursor body_token parser token_to_op
    done
}

# ============================================================================
# get_op_keyword - handle all keywords
# ============================================================================

fn get_op_keyword
    parser:mut$Parser
    token:mut$Token
    cursor:mut$TokenCursor
    function_name:mut$str
    ops:mut$List[Op]
{
    token Token::value keyword_from_str = keyword_opt
    if keyword_opt.is_none then
        token Token::location f"Token `{token Token::value}` is not a keyword" ErrorKind::Syntax parser.state.record_error
    fi
    keyword_opt.unwrap = keyword

    # unsafe function declaration or lexical block
    if KeywordKind::Unsafe keyword == then
        cursor.peek = unsafe_next_opt
        if unsafe_next_opt Option::Some(unsafe_next) is then
            if "fn" unsafe_next Token::value == then
                parser token Token::location "Functions" function_name require_global_scope
                cursor parser parse_function = function
                true function Function::set_is_unsafe
                if
                    function Function::name parser
                        .store
                        .functions
                        .get
                        .is_some
                then
                    function Function::location f"Identifier `{function Function::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
                fi
                function Function::name = unsafe_function_name
                function unsafe_function_name parser.put_function
                return
            fi
            if "{" unsafe_next Token::value == then
                token Token::location OpValue::UnsafeStart Op::new ops.push
                function_name cursor parser parse_block_ops = unsafe_ops
                unsafe_ops ops.append
                token Token::location OpValue::UnsafeEnd Op::new ops.push
                return
            fi
        fi
        token Token::location "Expected `fn` or `{` after `unsafe`" ErrorKind::Syntax parser.state.record_error
        return
    fi

    # Simple keyword -> OpValue lookup
    keyword keyword_to_op_value = simple_opt
    if simple_opt Option::Some(simple) is then
        if parser.syntax_only then
            token Token::location Location::span Span::offset
            simple parser.state.record_control_op
        fi
        token Token::location simple Op::new ops.push
        return
    fi

    # end without match
    if KeywordKind::End keyword == then
        token Token::location "`end` without matching `match`" ErrorKind::UnmatchedBlock parser.state.record_error
    fi

    # enum
    if KeywordKind::EnumKw keyword == then
        parser token Token::location "Enums" function_name require_global_scope
        cursor.retreat
        cursor parser parse_enum = casa_enum
        if
            casa_enum CasaEnum::name parser
                .store
                .enums
                .get
                .is_some
        then
            casa_enum CasaEnum::location f"Enum `{casa_enum CasaEnum::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
        fi
        casa_enum CasaEnum::name = enum_name
        casa_enum enum_name parser.put_enum
        return
    fi

    # fn
    if KeywordKind::Fn keyword == then
        parser token Token::location "Functions" function_name require_global_scope
        cursor.retreat
        cursor parser parse_function = function
        if
            function Function::name parser
                .store
                .functions
                .get
                .is_some
        then
            function Function::location f"Identifier `{function Function::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
        fi
        function Function::name = parsed_function_name
        function parsed_function_name parser.put_function
        return
    fi

    # impl
    if KeywordKind::Impl keyword == then
        parser token Token::location "Implementation blocks" function_name require_global_scope
        cursor.retreat
        cursor parser parse_impl_block
        return
    fi

    # import
    if KeywordKind::Import keyword == then
        parser token Token::location "Import statements" function_name require_global_scope
        cursor parser handle_keyword_import ops.push
        return
    fi

    # is (standalone is error)
    if KeywordKind::Is keyword == then
        token Token::location "`is` requires a preceding enum variant" ErrorKind::Syntax parser.state.record_error
    fi

    # match
    if KeywordKind::Match keyword == then
        function_name cursor token parser parse_match_block = match_ops
        match_ops ops.append
        return
    fi

    # struct
    if KeywordKind::StructKw keyword == then
        parser token Token::location "Structs" function_name require_global_scope
        cursor.retreat
        cursor parser parse_struct = casa_struct
        casa_struct CasaStruct::name = parsed_struct_name
        casa_struct parsed_struct_name parser.put_struct
        return
    fi

    # for
    if KeywordKind::For keyword == then
        ops function_name cursor token parser handle_keyword_for
        return
    fi

    # in (standalone is error — only valid inside a for header)
    if KeywordKind::In keyword == then
        token Token::location "`in` is only valid inside a `for` loop header" ErrorKind::Syntax parser.state.record_error
    fi

    # global — compile-time declaration; emits DeclareGlobal op
    if KeywordKind::Global keyword == then
        if GLOBAL_SCOPE_LABEL function_name == then
            token Token::location "`global` declaration is only valid inside a function body" ErrorKind::InvalidScope parser.state.record_error
            return
        fi
        if function_name "lambda__" str::starts_with then
            token Token::location "`global` declaration is not allowed inside a lambda" ErrorKind::InvalidScope parser.state.record_error
            return
        fi
        # Placement check: all ops so far must be DeclareGlobal
        for existing_op in ops.iter do
            if existing_op.value OpValue::DeclareGlobal is ! then
                token Token::location "`global` declaration must appear before any other statement in the function body" ErrorKind::Syntax parser.state.record_error
                return
            fi
        done
        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token
        token Token::location name_token Token::value OpValue::DeclareGlobal Op::new ops.push
        return
    fi

    # const
    if KeywordKind::Const keyword == then
        parser token Token::location "Constants" function_name require_global_scope
        # const fn — compile-time evaluable function
        cursor.peek = const_next_opt
        if const_next_opt Option::Some(const_next) is then
            if "fn" const_next Token::value == then
                cursor parser parse_function = function
                true function Function::set_is_const_fn
                if parser.syntax_only ! then
                    parser.state.diagnostics function validate_const_fn_body
                fi
                if
                    function Function::name parser
                        .store
                        .functions
                        .get
                        .is_some
                then
                    function Function::location f"Identifier `{function Function::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
                fi
                function Function::name = const_function_name
                function const_function_name parser.put_function
                return
            fi
        fi
        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = const_name_token
        const_name_token Token::value = const_name
        if
            const_name parser
                .store
                .constants
                .get
                .is_some
        then
            token Token::location f"Constant `{const_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
        fi
        if
            const_name parser
                .store
                .functions
                .get
                .is_some
        then
            token Token::location f"Constant `{const_name}` conflicts with an existing function" ErrorKind::DuplicateName parser.state.record_error
        fi
        if
            const_name parser
                .store
                .variables
                .get
                .is_some
        then
            token Token::location f"Constant `{const_name}` conflicts with an existing variable" ErrorKind::DuplicateName parser.state.record_error
        fi
        if
            const_name parser
                .store
                .structs
                .get
                .is_some
        then
            token Token::location f"Constant `{const_name}` conflicts with an existing struct" ErrorKind::DuplicateName parser.state.record_error
        fi
        if
            const_name parser
                .store
                .enums
                .get
                .is_some
        then
            token Token::location f"Constant `{const_name}` conflicts with an existing enum" ErrorKind::DuplicateName parser.state.record_error
        fi
        cursor.pop = const_value_token_opt
        if const_value_token_opt.is_none then
            token Token::location "Expected a literal value, block expression, or constant name after constant name" ErrorKind::Syntax parser.state.record_error
        fi
        const_value_token_opt.unwrap = const_value_token
        if "{" const_value_token Token::value == then
            cursor.retreat
            if parser.syntax_only then
                "const" cursor parser parse_block_ops drop
                0 IntegerLiteral::from_int ConstantValue::Int
            else
                token Token::location cursor parser eval_const_block
            fi
            = const_block_val
            token Token::location const_block_val const_name.clone Constant = casa_const
            casa_const const_name parser.put_constant
        elif TokenKind::Literal const_value_token Token::kind == then
            const_value_token Token::value parse_literal_to_constant_value = const_lit_val
            token Token::location const_lit_val const_name.clone Constant = casa_const
            casa_const const_name parser.put_constant
        elif TokenKind::Identifier const_value_token Token::kind == then
            const_value_token Token::value = const_ref_name
            if parser.syntax_only then
                0 IntegerLiteral::from_int ConstantValue::Int = syntax_const_value
                token Token::location syntax_const_value const_name.clone Constant = casa_const
                casa_const const_name parser.put_constant
                return
            fi
            const_ref_name parser
                .store
                .constants
                .get = const_ref_opt
            if const_ref_opt Option::Some(const_ref) is then
                token Token::location const_ref Constant::value const_name.clone Constant = casa_const
                casa_const const_name parser.put_constant
            elif
                const_ref_name parser
                    .store
                    .functions
                    .get
                    .is_some
            then
                token Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" ErrorKind::Syntax parser.state.record_error
            elif
                const_ref_name parser
                    .store
                    .structs
                    .get
                    .is_some
            then
                token Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" ErrorKind::Syntax parser.state.record_error
            elif
                const_ref_name parser
                    .store
                    .enums
                    .get
                    .is_some
            then
                token Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" ErrorKind::Syntax parser.state.record_error
            else
                token Token::location f"Undefined constant `{const_ref_name}` referenced in constant `{const_name}`" ErrorKind::Syntax parser.state.record_error
            fi
        else
            token Token::location f"Expected a literal value, block expression, or constant name for constant `{const_name}`" ErrorKind::Syntax parser.state.record_error
        fi
        return
    fi

    # trait
    if KeywordKind::TraitKw keyword == then
        parser token Token::location "Traits" function_name require_global_scope
        cursor.retreat
        cursor parser parse_trait = casa_trait
        if
            casa_trait CasaTrait::name parser
                .store
                .traits
                .get
                .is_some
        then
            casa_trait CasaTrait::location f"Trait `{casa_trait CasaTrait::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error
        fi
        casa_trait CasaTrait::name = parsed_trait_name
        casa_trait parsed_trait_name parser.put_trait
        return
    fi
}

# ============================================================================
# _parse_struct_literal - parse StructName { field: value }
# ============================================================================

fn is_struct_field_boundary cursor:mut$TokenCursor member_names:mut$List[str] -> bool {
    cursor TokenCursor::pos = pos
    cursor TokenCursor::tokens = token_list
    if pos 1 + token_list.length < then
        false return
    fi
    pos token_list.get = token
    if TokenKind::Identifier token Token::kind != then
        false return
    fi
    if token Token::value member_names string_list_contains ! then
        false return
    fi
    ":" pos 1 + token_list.get Token::value ==
}

fn parse_struct_field_value
    parser:mut$Parser
    cursor:mut$TokenCursor
    struct_name:str
    member_names:mut$List[str]
    function_name:mut$str
    all_ops:mut$List[Op]
{
    while cursor.is_finished ! do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            break
        fi
        if peek_opt Option::Some(peek) is then
            if "}" peek Token::value == then
                break
            fi
        fi
        if member_names cursor is_struct_field_boundary then
            break
        fi
        cursor.pop = value_opt
        if value_opt.is_none then
            break
        fi
        value_opt.unwrap = value_token
        if TokenKind::FstringStart value_token Token::kind == then
            all_ops function_name cursor value_token parser handle_fstring
            continue
        fi
        all_ops function_name cursor value_token parser token_to_op
    done
}

fn parse_struct_literal
    parser:mut$Parser
    name_token:mut$Token
    cursor:mut$TokenCursor
    function_name:mut$str
-> List[Op] {
    fallback_token "{" cursor expect_token_value.unwrap_or drop
    name_token Token::value parser
        .store
        .structs
        .get = casa_struct_opt
    if casa_struct_opt.is_none then
        empty_location "Expected option value while unwrapping name_token Token::value parser.store.structs.get" ErrorKind::Syntax parser.state.record_error
        1 exit
    fi
    casa_struct_opt.unwrap = casa_struct
    List[str]::new = member_names
    for member in casa_struct CasaStruct::members.iter do
        member Member::name member_names.push
    done

    List[str]::new = field_order
    List[Op]::new = all_ops
    Set[str]::new = seen

    while true do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token Token::location "Unexpected end of input in struct literal" ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
        if next_opt Option::Some(next) is then
            if "}" next Token::value == then
                cursor.pop drop
                break
            fi
        fi

        fallback_token TokenKind::Identifier cursor expect_token_kind.unwrap_or = field_token
        if field_token Token::value member_names string_list_contains ! then
            field_token Token::location f"Struct `{name_token Token::value}` has no field `{field_token Token::value}`" ErrorKind::UndefinedName parser.state.record_error
        fi
        if field_token Token::value seen.has then
            field_token Token::location f"Duplicate field `{field_token Token::value}` in struct literal" ErrorKind::DuplicateName parser.state.record_error
        fi
        field_token Token::value seen.add = seen
        field_token Token::value field_order.push

        fallback_token ":" cursor expect_token_value.unwrap_or drop

        all_ops.length = ops_before
        all_ops function_name member_names name_token Token::value cursor parser parse_struct_field_value
        if ops_before all_ops.length == then
            field_token Token::location f"Missing value for field `{field_token Token::value}`" ErrorKind::Syntax parser.state.record_error
        fi
    done

    field_order name_token Token::value StructLiteral = literal
    name_token Token::location literal OpValue::StructLiteral Op::new all_ops.push
    all_ops
}

# ============================================================================
# token_to_op - main dispatch: token kind -> handler
# ============================================================================

fn try_parse_explicit_associated_item
    token:mut$Token
    cursor:mut$TokenCursor
    ops:mut$List[Op]
-> bool {
    cursor.save = saved_pos
    cursor.peek = open_opt
    if open_opt.is_none then
        false return
    fi
    if open_opt Option::Some(open) is then
        if "[" open Token::value != then
            false return
        fi
        if
            token Token::location Location::span Span::offset
            token Token::location Location::span Span::length +
            open Token::location Location::span Span::offset !=
        then
            false return
        fi
    fi
    cursor.pop drop
    List[Type]::new = type_args
    while true do
        cursor.peek = next_opt
        if next_opt.is_none then
            saved_pos cursor.restore false return
        fi
        if next_opt Option::Some(next) is then
            if "]" next Token::value == then
                cursor.pop drop
                break
            fi
        fi
        cursor parse_type_ast type_args.push
    done
    cursor.pop = first_colon
    cursor.pop = second_colon
    cursor.pop = member_opt
    if
        first_colon.is_none second_colon.is_none ||
        member_opt.is_none ||
    then
        saved_pos cursor.restore
        false return
    fi
    if
        first_colon.unwrap Token::value ":" !=
        second_colon.unwrap Token::value ":" != ||
        member_opt.unwrap Token::kind TokenKind::Identifier != ||
    then
        saved_pos cursor.restore
        false return
    fi
    member_opt.unwrap Token::value = member
    token Token::value = base
    token Token::location f"{base}::{member}" OpValue::Identifier Op::new = associated_op
    type_args base GenericType Type::Generic = result_type
    result_type Option::Some associated_op Op::set_type_hint
    associated_op ops.push
    true
}

fn token_to_op
    parser:mut$Parser
    token:mut$Token
    cursor:mut$TokenCursor
    function_name:mut$str
    ops:mut$List[Op]
{
    token Token::kind = kind

    # Source newlines do not interrupt an accessor chain.
    if TokenKind::Newline kind == then
        return
    fi

    if parser.syntax_only then
        TokenKind::Delimiter kind == "." token Token::value == && = is_accessor
        if is_accessor ! then
            parser.state.flush_accessor_chain
        fi
    fi

    if TokenKind::Eof kind == then
        return
    fi
    if TokenKind::Comment kind == then
        return
    fi

    if TokenKind::Delimiter kind == then
        ops function_name cursor token parser get_op_delimiter
        return
    fi

    if TokenKind::Literal kind == then
        cursor token get_op_literal ops.push
        return
    fi

    if TokenKind::Intrinsic kind == then
        cursor token get_op_intrinsic ops.push
        return
    fi

    if TokenKind::Keyword kind == then
        ops function_name cursor token parser get_op_keyword
        return
    fi

    if TokenKind::Operator kind == then
        if "?" token Token::value == then
            ops function_name token parser handle_question_operator
            return
        fi
        function_name cursor token get_op_operator ops.push
        return
    fi

    if TokenKind::Identifier kind == then
        if ops cursor token try_parse_explicit_associated_item then
            return
        fi
        # Check for struct literal: StructName { ... }
        cursor.peek = next_opt
        if next_opt Option::Some(next) is then
            if "{" next Token::value == then
                if
                    token Token::value parser
                        .store
                        .structs
                        .get
                        .is_some
                then
                    function_name cursor token parser parse_struct_literal = struct_literal_ops
                    struct_literal_ops ops.append
                    return
                fi
            fi
        fi

        # Check for is check: Enum::Variant is
        if token Token::value "::" str::find 0 <= then
            cursor token try_parse_is_check = is_check_opt
            if is_check_opt Option::Some(is_check_op) is then
                is_check_op ops.push
                return
            fi
        fi

        # Plain identifier
        token Token::location token Token::value OpValue::Identifier Op::new ops.push
        return
    fi

    # F-string tokens should be handled by handle_fstring
    if
        TokenKind::FstringStart kind ==
        TokenKind::FstringEnd kind == ||
        TokenKind::FstringExprStart kind == ||
        TokenKind::FstringExprEnd kind == ||
        TokenKind::FstringText kind == ||
    then
        token Token::location "F-string token should be handled by handle_fstring" ErrorKind::Syntax parser.state.record_error
    fi
}

# ============================================================================
# parse_ops - main parse loop
# ============================================================================

fn parse_ops parser:mut$Parser tokens:List[Token] -> List[Op] {
    parser.state tokens TokenCursor::new = cursor
    List[Op]::new = ops
    while cursor.is_finished ! do
        cursor.pop = token_opt
        if token_opt.is_none then
            break
        fi
        token_opt.unwrap = token
        if TokenKind::Comment token Token::kind == then
            continue
        fi
        if TokenKind::Newline token Token::kind == then
            continue
        fi
        parser.state.reset_store_mutation
        ops.length = ops_before
        if TokenKind::FstringStart token Token::kind == then
            ops GLOBAL_SCOPE_LABEL cursor token parser handle_fstring
        else
            ops GLOBAL_SCOPE_LABEL cursor token parser token_to_op
        fi
        if parser.state.take_recovery_request then
            while ops_before ops.length > do
                ops.pop drop
            done
            if parser.state.store_was_mutated then
                parser.state.mark_output_unusable break
            fi
            if cursor.recover_at_structure ! then
                parser.state.mark_output_unusable break
            fi
        fi
    done
    if parser.syntax_only then
        parser.state.flush_accessor_chain
    fi
    ops
}

fn syntax_parser_tokens tokens:$List[Token] -> List[Token] {
    List[Token]::new = result
    for token in tokens.iter do
        if TokenKind::Comment token.kind == then
            continue
        fi
        if TokenKind::Newline token.kind == then
            continue
        fi
        token.location.clone token.kind token.value.clone Token result.push
    done
    result
}

fn logical_comment_text token:$Token -> str {
    1 (u64) = start
    if 1 token.value.length > then
        if ' ' 1 token.value.at == then
            2 (u64) = start
        fi
    fi
    token.value start token.value.length start - str::substring
}

fn build_syntax_facts source:$str tokens:$List[Token] spans:List[SyntaxSpan] -> SyntaxFacts {
    List[SyntaxTokenFact]::new = meaningful_tokens
    List[SyntaxCommentFact]::new = comments
    0 (u64) = meaningful_count
    false = line_has_meaningful_token

    for token in tokens.iter do
        if TokenKind::Newline token.kind == then
            false = line_has_meaningful_token
        elif TokenKind::Comment token.kind == then
            token logical_comment_text = text
            line_has_meaningful_token meaningful_count text SyntaxCommentFact comments.push
        elif TokenKind::Eof token.kind != then
            # Commas carry no operand content: item separators are required by
            # the grammar (a missing one is a parse error the candidate re-parse
            # still catches), and a trailing comma is optional decoration.
            # Exclude them so the formatter may canonicalize delimited-form
            # commas, including adding or dropping the optional trailing comma,
            # without tripping the token-equality safety net.
            "," token.value == TokenKind::Delimiter token.kind == && = is_separator
            if is_separator ! then
                token
                    .location
                    .span
                    .length = length
                token
                    .location
                    .span
                    .offset = offset
                source offset length str::substring = spelling
                token.kind spelling SyntaxTokenFact meaningful_tokens.push
                1 += meaningful_count
                true = line_has_meaningful_token
            fi
        fi
    done

    spans comments meaningful_tokens SyntaxFacts
}

fn syntax_facts_match expected:$SyntaxFacts actual:$SyntaxFacts -> bool {
    if actual.meaningful_tokens.length expected.meaningful_tokens.length != then
        false return
    fi
    if actual.comments.length expected.comments.length != then
        false return
    fi

    0 (u64) = index
    while index expected.meaningful_tokens.length > do
        index expected.meaningful_tokens.get = expected_token
        index actual.meaningful_tokens.get = actual_token
        if actual_token.kind expected_token.kind != then
            false return
        fi
        if actual_token.spelling expected_token.spelling != then
            false return
        fi
        1 += index
    done

    0 (u64) = index
    while index expected.comments.length > do
        index expected.comments.get = expected_comment
        index actual.comments.get = actual_comment
        if actual_comment.text expected_comment.text != then
            false return
        fi
        if actual_comment.preceding_token_count expected_comment.preceding_token_count != then
            false return
        fi
        if actual_comment.attached_to_preceding expected_comment.attached_to_preceding != then
            false return
        fi
        1 += index
    done
    true
}
# Recognize one complete root file without resolving names or loading imports.

fn analyze_syntax source:$str file:$str -> SyntaxResult {
    SourceStore::new = sources
    source file sources.add
    file source lex_source_fmt = lex_result
    lex_result.tokens = tokens
    if lex_result.diagnostics.has_errors then
        lex_result.diagnostics Option[SyntaxFacts]::None tokens SyntaxResult return
    fi

    tokens syntax_parser_tokens = parser_tokens
    sources lex_result.diagnostics symbol_store_new Parser::new = parser
    true = parser.syntax_only
    parser_tokens parser parse_ops drop

    if
        parser.state.has_usable_output parser
            .state
            .diagnostics
            .has_errors ! &&
    then
        parser
            .state
            .spans
            .clone tokens source build_syntax_facts = facts
        parser.state.diagnostics facts Option::Some tokens SyntaxResult
    else
        parser.state.diagnostics Option[SyntaxFacts]::None tokens SyntaxResult
    fi
}

impl Parser {
    fn finish_resolution
        self:mut$Parser
        ops:List[Op]
        skip_functions:Set[str]
    -> ParseResolveResult {
        if self.state.has_usable_output ! then
            self.state.diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult return
        fi
        ops self resolve_identifiers_global = resolved_ops
        if self.state.has_usable_output ! then
            self.state.diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult return
        fi
        self
            .store
            .functions
            .keys = function_names
        for function_name in function_names.iter do
            if function_name skip_functions.has then
                continue
            fi
            if function_name "lambda__" str::starts_with then
                continue
            fi
            function_name self
                .store
                .functions
                .get
                .unwrap = function
            function.ops clone_ops = function_ops
            self.state.diagnostics function function_ops self.store resolve_identifiers function.set_ops
        done
        self derive_hashable_for_enums
        if self.state.has_usable_output then resolved_ops Option::Some else Option::None fi = result_ops
        self.state.diagnostics self.store result_ops ParseResolveResult
    }
}

fn parse_and_resolve
    tokens:List[Token]
    search_paths:List[str]
    diagnostics:mut$Diagnostics
    sources:SourceStore
-> ParseResolveResult {
    sources diagnostics symbol_store_new Parser::new = parser
    search_paths parser Parser::set_search_paths
    tokens parser parse_ops = ops
    Set[str]::new ops parser.finish_resolution
}

# ============================================================================
# resolve_identifiers - post-parse pass
# ============================================================================

fn gather_captures store:mut$SymbolStore lambda_function:mut$Function function:mut$Function {
    for op in lambda_function Function::ops.iter do
        Option[str]::None = name_opt
        if op.value OpValue::Identifier(identifier_name) is then
            identifier_name Option::Some = name_opt
        elif
            op.value OpValue::AssignVar is
            op.value OpValue::AssignInc is ||
            op.value OpValue::AssignDec is ||
        then
            op op_str_value "." str::split = target_parts
            if target_parts.length 1 < then
                0 target_parts.get Option::Some = name_opt
            fi
        fi
        if name_opt Option::Some(name) is then
            false = captured

            # Check enclosing function variables
            0 (u64) = variable_index
            while variable_index function Function::variables.length > do
                if name variable_index function Function::variables.get_ref Variable::name == then
                    variable_index function Function::variables.get lambda_function Function::captures.push
                    true = captured
                    break
                fi
                1 += variable_index
            done

            if captured ! then
                # Check global variables
                name store.variables.get = global_var_opt
                if global_var_opt Option::Some(global_var) is then
                    global_var lambda_function Function::captures.push
                fi
            fi
        fi
    done

    # Constant parameters stay in scope inside a closure. A call in the body
    # may forward one, and the typechecker adds that read after captures are
    # gathered, so capture them up front (ADR-0152).
    for
        constant_name in function
            .stack_effect
            .const_params
            .keys
            .iter
    do
        if constant_name lambda_function.captures variable_list_contains then
            continue
        fi
        constant_name function.variables variable_list_index = constant_variable_index
        if 0 constant_variable_index >= then
            constant_variable_index u64::try_from.unwrap function.variables.get lambda_function.captures.push
        fi
    done
}

fn resolve_array_identifiers
    store:mut$SymbolStore
    items:mut$List[Op]
    function:mut$Function
    errors:mut$List[CasaError]
    diagnostics:mut$Diagnostics
{
    for rai_item in items.iter do
        if rai_item.value OpValue::PushArray(inner_items) is then
            diagnostics errors function inner_items store resolve_array_identifiers
        elif rai_item.value OpValue::ExprGroup(group_inner) is then
            diagnostics function group_inner store resolve_identifiers drop
        elif rai_item.value OpValue::Identifier(rai_name) is then
            if rai_name function Function::variables variable_list_contains then
                rai_name OpValue::PushVar rai_item Op::set_value
            elif rai_name function Function::captures variable_list_contains then
                rai_name OpValue::PushCapture rai_item Op::set_value
            elif
                rai_name store
                    .variables
                    .get
                    .is_some
            then
                rai_name OpValue::PushVar rai_item Op::set_value
            elif rai_name store.constants.get = rai_const_opt rai_const_opt Option::Some(rai_const) is then
                rai_const Constant::value = rai_const_value
                rai_const_value match
                    ConstantValue::Int(rai_const_int) => {
                        rai_const_int OpValue::PushInt rai_item Op::set_value
                    }
                    ConstantValue::Float(rai_const_float) => {
                        rai_const_float OpValue::PushFloat rai_item Op::set_value
                    }
                    ConstantValue::Str(rai_const_str) => {
                        rai_const_str OpValue::PushStr rai_item Op::set_value
                    }
                    ConstantValue::Bool(rai_const_bool) => {
                        rai_const_bool OpValue::PushBool rai_item Op::set_value
                    }
                    ConstantValue::Char(rai_const_char) => {
                        rai_const_char OpValue::PushChar rai_item Op::set_value
                    }
                end
            elif errors rai_name rai_item store try_resolve_enum_variant_ident then
            elif rai_name store.functions.get Option::Some(rai_fn) is then
                rai_name OpValue::FnPush rai_item Op::set_value
                true rai_fn Function::set_is_used
            else
                rai_item Op::location f"Identifier `{rai_name}` is not defined" ErrorKind::UndefinedName CasaError::new errors.push
            fi
        fi
    done
}

fn resolve_enum_variant
    store:mut$SymbolStore
    variant:EnumVariant
    op:mut$Op
    function:mut$Function
    errors:mut$List[CasaError]
{
    # Resolve enum variant ordinal if still unresolved
    if variant EnumVariant::enum_name.length 0 != variant EnumVariant::ordinal.is_none && then
        variant EnumVariant::enum_name store.enums.get = rev_enum_opt
        if rev_enum_opt.is_none then
            op Op::location f"Enum `{variant EnumVariant::enum_name}` is not defined" ErrorKind::UndefinedName CasaError::new errors.push
        else
            rev_enum_opt.unwrap = rev_enum
            variant EnumVariant::variant_name rev_enum CasaEnum::variants string_list_index = rev_ordinal
            if 0 rev_ordinal < then
                op Op::location f"Variant `{variant EnumVariant::variant_name}` is not defined in enum `{variant EnumVariant::enum_name}`" ErrorKind::UndefinedName CasaError::new errors.push
            else
                rev_ordinal Option::Some variant EnumVariant::set_ordinal
            fi
        fi
    fi
    # Register bindings as variables
    if 0 variant EnumVariant::bindings.length != then
        for rev_var_name in variant EnumVariant::bindings.iter do
            rev_var_name Variable::new = rev_var
            if GLOBAL_SCOPE_LABEL function Function::name == then
                rev_var rev_var_name.clone store.variables.set drop
            else
                if rev_var_name function Function::variables variable_list_contains ! then
                    rev_var function Function::variables.push
                fi
            fi
        done
    fi
}

impl Parser {
    fn analyze_import
        self:mut$Parser
        import_path:mut$str
        included_files:mut$Set[str]
        base_store:SymbolStore
    -> Result[ParseResolveResult IoError] {
        self.sources import_path.clone lex_file = import_result
        if import_result Result::Error(read_error) is then
            read_error Result::Error return
        fi
        import_result.unwrap = lex_result
        Diagnostics::new = diagnostics
        lex_result.diagnostics diagnostics.merge
        if diagnostics.has_errors then
            diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult Result::Ok
            return
        fi
        base_store.functions.keys string_list_to_set = existing_functions
        base_store.clone = imported_store
        self.sources diagnostics imported_store Parser::new = import_parser
        self.search_paths = import_parser.search_paths
        for included_file in included_files.iter do
            included_file.clone import_parser.included_files.add drop
        done
        lex_result.tokens import_parser parse_ops = imported_ops
        if diagnostics.has_errors import_parser.state.has_usable_output ! || then
            diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult Result::Ok
            return
        fi
        existing_functions imported_ops import_parser.finish_resolution = result
        for included_file in import_parser.included_files.iter do
            included_file.clone included_files.add drop
        done
        if result.diagnostics.has_errors then
            result.diagnostics symbol_store_new Option[List[Op]]::None ParseResolveResult Result::Ok
            return
        fi
        result Result::Ok
    }
}

fn expand_imports parser:mut$Parser ops:List[Op] -> List[Op] {
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get = current_op
        1 += op_index

        if current_op.value OpValue::ImportFileSelective(selective_import) is then
            current_op.location selective_import parser handle_selective_import
            if parser.state.has_usable_output ! then
                ops return
            fi
            continue
        fi

        if current_op.value OpValue::ImportFile(import_path) is then
            if 0 import_path.length == then
                continue
            fi
            if import_path parser.included_files.has ! then
                import_path parser.included_files.add drop
                parser.store = import_store
                parser.included_files = imported_files
                import_store imported_files import_path parser.analyze_import = import_result
                if import_result Result::Error(read_error) is then
                    current_op.location f"Cannot read import `{import_path}`: {read_error.to_str}" ErrorKind::Syntax parser
                        .state
                        .diagnostics
                        .record_error_at_encounter
                    parser.state.mark_output_unusable
                    ops return
                fi
                import_result.unwrap = imported_result
                current_op.location imported_result.diagnostics parser
                    .state
                    .diagnostics
                    .merge_at_encounter
                if imported_result.ops Option::Some(import_ops) is then
                    imported_result.store parser.store.merge_import
                    List[Op]::new = new_ops
                    0 (u64) = name_index
                    while name_index op_index > do
                        name_index ops.get new_ops.push
                        1 += name_index
                    done
                    import_ops.shallow_copy new_ops.append
                    op_index = remaining_index
                    while remaining_index ops.length > do
                        remaining_index ops.get new_ops.push
                        1 += remaining_index
                    done
                    import_ops.length += op_index
                    new_ops = ops
                else
                    parser.state.mark_output_unusable
                    ops return
                fi
            fi
            continue
        fi
    done
    ops
}

fn resolve_identifiers_global parser:mut$Parser ops:List[Op] -> List[Op] {
    ops parser expand_imports = expanded_ops
    if parser.state.has_usable_output ! then
        List[Op]::new return
    fi
    if parser validate_traits ! then
        List[Op]::new return
    fi
    parser derive_copy_for_aggregates
    parser register_builtin_copy_impls
    parser validate_drop_methods
    parser finalize_trait_impl_methods
    parser synthesize_copy_clone_fallbacks
    parser validate_trait_impls
    if parser.state.has_usable_output ! then
        List[Op]::new return
    fi
    empty_location List[Op]::new GLOBAL_SCOPE_LABEL Function::new = dummy
    parser.state.diagnostics dummy expanded_ops parser.store resolve_identifiers
}

fn resolve_identifiers
    store:mut$SymbolStore
    ops:mut$List[Op]
    function:mut$Function
    diagnostics:mut$Diagnostics
-> List[Op] {
    0 (u64) = op_index
    List[CasaError]::new = resolve_errors
    Set[str]::new = declared_globals
    while op_index ops.length > do
        op_index ops.get = current_op
        1 += op_index

        if current_op.value OpValue::DeclareGlobal(global_name) is then
            if
                global_name store
                    .variables
                    .get
                    .is_none
            then
                current_op Op::location f"`{global_name}` is not a global variable" ErrorKind::UndefinedGlobal CasaError::new resolve_errors.push
            fi
            global_name declared_globals.add = declared_globals
            continue
        fi

        if current_op.value OpValue::AssignInc(inc_name) is then
            inc_name "." str::split = inc_parts
            0 inc_parts.get = inc_root
            if
                inc_root store
                    .constants
                    .get
                    .is_some
            then
                current_op Op::location f"Cannot assign to constant `{inc_root}`" ErrorKind::Syntax CasaError::new resolve_errors.push
                continue
            fi
        fi

        if current_op.value OpValue::AssignDec(dec_name) is then
            dec_name "." str::split = dec_parts
            0 dec_parts.get = dec_root
            if
                dec_root store
                    .constants
                    .get
                    .is_some
            then
                current_op Op::location f"Cannot assign to constant `{dec_root}`" ErrorKind::Syntax CasaError::new resolve_errors.push
                continue
            fi
        fi

        if current_op.value OpValue::AssignVar(var_name) is then
            var_name "." str::split = var_parts
            0 var_parts.get = var_root
            if
                var_root store
                    .constants
                    .get
                    .is_some
            then
                current_op Op::location f"Cannot assign to constant `{var_root}`" ErrorKind::Syntax CasaError::new resolve_errors.push
                continue
            fi
            if var_parts.length 1 < then
                continue
            fi
            var_name Variable::new = variable
            if GLOBAL_SCOPE_LABEL function Function::name == then
                if var_name store.variables.has ! then
                    variable var_name store.variables.set drop
                fi
                continue
            fi
            if var_name function Function::variables variable_list_contains ! then
                if var_name declared_globals.has ! then
                    variable function Function::variables.push
                fi
            fi
            continue
        fi

        if current_op.value OpValue::FnPush(fn_name) is then
            fn_name store.functions.get = lambda_opt
            if lambda_opt.is_some then
                lambda_opt.unwrap = lambda
                true lambda Function::set_is_used
                function lambda store gather_captures
                lambda Function::ops clone_ops = lambda_ops
                diagnostics lambda lambda_ops store resolve_identifiers = lambda_resolved
                lambda_resolved lambda Function::set_ops
            fi
            continue
        fi

        if current_op.value OpValue::PushArray(items_inner) is then
            diagnostics resolve_errors function items_inner store resolve_array_identifiers
            continue
        fi

        if current_op.value OpValue::ExprGroup(group_inner) is then
            diagnostics function group_inner store resolve_identifiers drop
            continue
        fi

        if current_op.value OpValue::Identifier(ident) is then
            if resolve_errors ident current_op function store try_resolve_fn_ref then
                continue
            fi
            if ident current_op try_resolve_numeric_call then
                continue
            fi
            if resolve_errors ident current_op store try_resolve_enum_variant_ident then
                continue
            fi
            if ident current_op store try_resolve_qualified_trait_method then
                continue
            fi
            if ident current_op store try_resolve_type_qualified_method then
                continue
            fi
            if ident current_op function try_resolve_trait_method_call then
                continue
            fi
            resolve_errors ident current_op function store resolve_plain_identifier
            if current_op.value OpValue::FnCall(resolved_fn_name) is then
                diagnostics current_op resolved_fn_name op_index ops store try_fold_const_fn_call = op_index
            fi
            continue
        fi

        if current_op.value OpValue::MatchArm is then
            diagnostics resolve_errors current_op function store resolve_match_op
            continue
        fi

        if current_op.value OpValue::IsCheck(is_enum_variant) is then
            resolve_errors function current_op is_enum_variant store resolve_enum_variant
            continue
        fi
    done

    0 (u64) = resolve_error_index
    while resolve_error_index resolve_errors.length > do
        resolve_error_index resolve_errors.get diagnostics.push_error
        1 += resolve_error_index
    done
    ops clone_ops
}
# Try resolving compiler-owned numeric associated conversion calls.

fn try_resolve_numeric_call op:mut$Op ident:mut$str -> bool {
    ident "::" str::find = separator
    if separator 0 <= ! then
        false return
    fi
    ident 0 separator (u64) str::substring parse_builtin = target_opt
    if target_opt.is_none then
        false return
    fi
    ident separator 2 + (u64) ident.length separator (u64) - 2 - str::substring = method
    if
        "from" method ==
        "from_bits" method == ||
        "round_from" method == ||
        "trunc_from" method == ||
        "wrapping_from" method == ||
        "from_codepoint_unchecked" method == ||
        "__from_decimal_parts" method == ||
        "__float_significand" method == ||
        "try_from" method == || !
    then
        false return
    fi
    target_opt.unwrap method NumericCall OpValue::NumericCall op Op::set_value
    true
}
# resolve_match_op — per-arm identifier resolution entry point.
# Registers struct-pattern field bindings as locals/globals and resolves
# enum-variant ordinals (delegating to resolve_enum_variant). Literal and
# wildcard arms need no resolution.

fn register_struct_pattern_binding
    store:mut$SymbolStore
    function:mut$Function
    binding_name:mut$str
{
    binding_name Variable::new = match_struct_variant
    if GLOBAL_SCOPE_LABEL function Function::name == then
        match_struct_variant binding_name store.variables.set drop
    else
        if binding_name function Function::variables variable_list_contains ! then
            match_struct_variant function Function::variables.push
        fi
    fi
}

fn resolve_match_op
    store:mut$SymbolStore
    function:mut$Function
    op:mut$Op
    errors:mut$List[CasaError]
    diagnostics:mut$Diagnostics
{
    if op.value OpValue::MatchArm(arm) is then
        arm.pattern_value match
            PatternValue::Struct(struct_pattern) => {
                struct_pattern.bindings.keys = pattern_keys
                for pattern_key in pattern_keys.iter do
                    pattern_key struct_pattern
                        .bindings
                        .get
                        .unwrap = binding_name
                    binding_name function store register_struct_pattern_binding
                done
            }
            PatternValue::EnumVariant(variant) => {
                errors function op variant store resolve_enum_variant
            }
            PatternValue::Literal => {
            }
        end
        arm.guard_ops = guard_ops
        if guard_ops.length 0 != then
            diagnostics function guard_ops store resolve_identifiers = resolved_guard
            resolved_guard arm MatchArm::set_guard_ops
        fi
    fi
}
# Try resolving `&name` and `&K::method` function references. Returns true
# if the identifier begins with `&`, in which case the op has been rewritten
# (or an error pushed) and the caller should skip further resolution.

fn try_resolve_fn_ref
    store:mut$SymbolStore
    function:mut$Function
    op:mut$Op
    ident:mut$str
    resolve_errors:mut$List[CasaError]
-> bool {
    if '&' 0 ident.at != then
        false return
    fi
    ident 1 ident.length 1 - str::substring = ref_name
    if 0 ref_name.length == then
        op Op::location "Expected function name after `&`" ErrorKind::Syntax CasaError::new resolve_errors.push
        true return
    fi
    ref_name "::" str::split = ref_parts
    if 2 ref_parts.length == "drop" ref_parts.length 1 - ref_parts.get == && then
        op Op::location "Reserved `drop` methods cannot be referenced" ErrorKind::InvalidScope CasaError::new resolve_errors.push
        true return
    fi
    if 3 ref_parts.length == then
        0 ref_parts.get parse_type_str = receiver_type
        1 ref_parts.get GenericType::new Type::Generic = qualifier_type
        if op.type_hint Option::Some(hint) is then
            if hint.type_params Option::Some(type_arguments) is then
                type_arguments 1 ref_parts.get GenericType Type::Generic = qualifier_type
            fi
        fi
        2 ref_parts.get = method_name
        store receiver_type qualifier_type method_name resolve_qualified_method_semantics
        = method_opt
        if method_opt Option::Some(method) is then
            if method.function_name store.functions.get Option::Some(method_function) is then
                if method_function.is_unsafe then
                    op Op::location f"Unsafe function `{method.function_name}` cannot be referenced" ErrorKind::InvalidScope CasaError::new resolve_errors.push
                    true return
                fi
                method.function_name.clone OpValue::FnPush op Op::set_value
                true method_function Function::set_is_used
                true return
            fi
        fi
    fi
    if ref_name "::" str::find 0 <= then
        ref_name.clone 0 ref_name "::" str::find(u64) str::substring = ref_type_var
        ref_type_var function Function::stack_effect StackEffect::trait_bounds.get = ref_bound_opt
        if ref_bound_opt.is_some then
            ref_name.clone ref_name "::" str::find 2 + (u64) ref_name.length ref_name "::" str::find(u64) - 2 - str::substring = ref_trait_method
            f"__trait_{ref_type_var}_{ref_trait_method}" = ref_hidden
            ref_hidden OpValue::PushVar op Op::set_value
            true return
        fi
    fi
    if 2 ref_parts.length == then
        0 ref_parts.get parse_type_str = receiver_type
        1 ref_parts.get = method_name
        store Option[Function]::None receiver_type method_name resolve_method_semantics
        = method_opt
        if method_opt Option::Some(method) is then
            if method.function_name store.functions.get Option::Some(method_function) is then
                if method_function.is_unsafe then
                    op Op::location f"Unsafe function `{method.function_name}` cannot be referenced" ErrorKind::InvalidScope CasaError::new resolve_errors.push
                    true return
                fi
                method.function_name.clone OpValue::FnPush op Op::set_value
                true method_function Function::set_is_used
                true return
            fi
        fi
    fi
    ref_name store.functions.get = ref_fn_opt
    if ref_fn_opt Option::Some(ref_fn) is then
        if ref_fn.is_unsafe then
            op Op::location f"Unsafe function `{ref_name}` cannot be referenced" ErrorKind::InvalidScope CasaError::new resolve_errors.push
            true return
        fi
        ref_name OpValue::FnPush op Op::set_value
        true ref_fn Function::set_is_used
    else
        op Op::location f"Function `{ref_name}` is not defined" ErrorKind::UndefinedName CasaError::new resolve_errors.push
    fi
    true
}
# Try resolving `Enum::Variant` identifiers. Returns true if the enum is
# known (op rewritten, or undefined-variant error pushed).

fn try_resolve_enum_variant_ident
    store:mut$SymbolStore
    op:mut$Op
    ident:mut$str
    resolve_errors:mut$List[CasaError]
-> bool {
    if ident "::" str::find 0 <= ! then
        false return
    fi
    ident "::" str::find = separator
    ident 0 separator (u64) str::substring = enum_name
    enum_name store.enums.get = enum_opt
    if enum_opt.is_none then
        false return
    fi
    ident separator 2 + (u64) ident.length separator (u64) - 2 - str::substring = binding_name
    enum_opt.unwrap = casa_enum
    binding_name casa_enum CasaEnum::variants string_list_index = ordinal
    if 0 ordinal < then
        op Op::location f"Variant `{binding_name}` is not defined in enum `{enum_name}`" ErrorKind::UndefinedName CasaError::new resolve_errors.push
    else
        ordinal Option::Some binding_name enum_name EnumVariant::new = enum_variant
        enum_variant OpValue::PushEnumVariant op Op::set_value
    fi
    true
}
# Try resolving `K::method` trait-bound method calls. Returns true if K is
# a trait-bound type variable on the enclosing function's stack effect.

fn try_resolve_trait_method_call function:mut$Function op:mut$Op ident:mut$str -> bool {
    if ident "::" str::find 0 <= ! then
        false return
    fi
    ident 0 ident "::" str::find(u64) str::substring = type_var
    if type_var function Function::stack_effect StackEffect::trait_bounds.get.is_some ! then
        false return
    fi
    ident ident "::" str::find 2 + (u64) ident.length ident "::" str::find(u64) - 2 - str::substring = trait_method
    f"__trait_{type_var}_{trait_method}" = hidden_var
    if hidden_var function Function::variables variable_list_contains ! then
        hidden_var Variable::new function Function::variables.push
    fi
    hidden_var OpValue::TraitMethodCall op Op::set_value
    true
}

fn try_resolve_qualified_trait_method store:mut$SymbolStore op:mut$Op ident:mut$str -> bool {
    ident "::" str::split = parts
    if 2 parts.length != then
        false return
    fi
    0 parts.get = trait_name
    if trait_name store.traits.has ! then
        false return
    fi
    1 parts.get = method_name
    trait_name GenericType::new Type::Generic = trait_type
    if op.type_hint Option::Some(hint) is then
        hint = trait_type
    fi
    method_name trait_type false QualifiedMethod OpValue::QualifiedMethodCall op Op::set_value
    true
}

fn try_resolve_type_qualified_method store:mut$SymbolStore op:mut$Op ident:mut$str -> bool {
    if
        ident store
            .functions
            .get
            .is_some
    then
        false return
    fi
    ident "::" str::split = parts
    if 2 parts.length != then
        false return
    fi
    0 parts.get parse_type_str = receiver_type
    1 parts.get = method_name
    store Option[Function]::None receiver_type method_name resolve_method_semantics = method_opt
    if method_opt.is_none then
        false return
    fi
    method_name receiver_type true QualifiedMethod OpValue::QualifiedMethodCall op Op::set_value
    true
}
# Resolve a bare identifier after `&`-ref, enum-variant, and trait-method
# attempts have already failed. Rewrites `op` in place to the matching op
# kind or pushes an `UndefinedName` error.

fn resolve_plain_identifier
    store:mut$SymbolStore
    function:mut$Function
    op:mut$Op
    ident:mut$str
    resolve_errors:mut$List[CasaError]
{
    ident "::" str::split = identifier_parts
    if 2 identifier_parts.length == "drop" identifier_parts.length 1 - identifier_parts.get == && then
        op Op::location "Reserved `drop` methods cannot be called directly; use the `drop` intrinsic" ErrorKind::InvalidScope CasaError::new resolve_errors.push
        return
    fi
    if ident function Function::variables variable_list_contains then
        ident.clone OpValue::PushVar op Op::set_value
        return
    fi

    ident store.functions.get = generic_fn_opt
    if generic_fn_opt Option::Some(generic_fn) is then
        ident.clone OpValue::FnCall op Op::set_value
        true generic_fn Function::set_is_used
        return
    fi

    if ident function Function::captures variable_list_contains then
        ident.clone OpValue::PushCapture op Op::set_value
        return
    fi

    if
        ident store
            .variables
            .get
            .is_some
    then
        ident.clone OpValue::PushVar op Op::set_value
        return
    fi

    ident store.constants.get = const_opt
    if const_opt Option::Some(casa_const) is then
        casa_const Constant::value = const_value
        const_value match
            ConstantValue::Int(const_int) => {
                const_int OpValue::PushInt op Op::set_value
            }
            ConstantValue::Float(const_float) => {
                const_float OpValue::PushFloat op Op::set_value
            }
            ConstantValue::Str(const_str) => {
                const_str OpValue::PushStr op Op::set_value
            }
            ConstantValue::Bool(const_bool) => {
                const_bool OpValue::PushBool op Op::set_value
            }
            ConstantValue::Char(const_char) => {
                const_char OpValue::PushChar op Op::set_value
            }
        end
        return
    fi

    ident store.structs.get = struct_opt
    if struct_opt Option::Some(casa_struct) is then
        casa_struct OpValue::StructNew op Op::set_value
        return
    fi

    ident store.enums.get = resolved_enum_opt
    if resolved_enum_opt Option::Some(resolved_enum) is then
        resolved_enum CasaEnum::variants.length (i64) make_integer_op_value op Op::set_value
        return
    fi

    op Op::location f"Identifier `{ident}` is not defined" ErrorKind::UndefinedName CasaError::new resolve_errors.push
}
