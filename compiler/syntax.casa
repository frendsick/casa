}

fn token_to_op
    parser:mut$Parser
    token:$Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$List[Op]
{
    token Token::kind = kind

    # Source newlines do not interrupt an accessor chain.
    if TokenKind::Newline kind == then
        return
    fi

    if parser.syntax_only then
        TokenKind::Delimiter kind == "." token Token::value.as_str == && = is_accessor
        if is_accessor ! then
            parser.state.flush_accessor_chain
        fi
    fi

    if TokenKind::Eof kind == then
        return
    fi
    if TokenKind::Comment kind == then
        return
    fi

    if TokenKind::Delimiter kind == then
        ops function_name cursor token parser get_op_delimiter
        return
    fi

    if TokenKind::Literal kind == then
        parser.state cursor token get_op_literal ops.push
        return
    fi

    if TokenKind::Intrinsic kind == then
        parser.state cursor token get_op_intrinsic ops.push
        return
    fi

    if TokenKind::Keyword kind == then
        ops function_name cursor token parser get_op_keyword
        return
    fi

    if TokenKind::Operator kind == then
        if "?" token Token::value.as_str == then
            ops token handle_question_operator
            return
        fi
        parser.state function_name cursor token get_op_operator ops.push
        return
    fi

    if TokenKind::Identifier kind == then
        if parser.state ops cursor token try_parse_pointer_operation then
            return
        fi
        if parser.state ops cursor token try_parse_explicit_associated_item then
            return
        fi
        # Check for struct literal: StructName { ... }
        cursor.peek = next_opt
        if next_opt Option::Some(next) is then
            if "{" next Token::value.as_str == then
                if
                    token Token::value.as_str parser
                        .store
                        .structs
                        .get_str
                        .is_some
                then
                    function_name cursor token parser parse_struct_literal = struct_literal_ops
                    struct_literal_ops ops.append
                    return
                fi
            fi
        fi

        # Check for is check: Enum::Variant is
        if token Token::value.as_str "::" str::find 0 <= then
            cursor token try_parse_is_check = is_check_opt
            is_check_opt match
                Option::Some(is_check) => {
                    is_check ops.push
                    return
                }
                Option::None => {
                }
            end
        fi

        # Plain identifier
        token Token::location token Token::value.clone OpValue::Identifier Op::new ops.push
        return
    fi

    # F-string tokens should be handled by handle_fstring
    if
        TokenKind::FstringStart kind ==
        TokenKind::FstringEnd kind == ||
        TokenKind::FstringExprStart kind == ||
        TokenKind::FstringExprEnd kind == ||
        TokenKind::FstringText kind == ||
    then
        token Token::location "F-string token should be handled by handle_fstring" ErrorKind::Syntax parser.state.record_error
    fi
}

# ============================================================================
# parse_ops - main parse loop
# ============================================================================

fn parse_ops parser:mut$Parser tokens:List[Token] -> List[Op] {
    tokens TokenCursor::new = cursor
    List[Op]::new = ops
    while cursor.is_finished ! do
        cursor.pop = token_opt
        if token_opt.is_none then
            break
        fi
        token_opt.unwrap = token
        if TokenKind::Comment token Token::kind == then
            continue
        fi
        if TokenKind::Newline token Token::kind == then
            continue
        fi
        parser.state.reset_store_mutation
        ops.length = ops_before
        if TokenKind::FstringStart token Token::kind == then
            ops GLOBAL_SCOPE_LABEL cursor token parser handle_fstring
        else
            ops GLOBAL_SCOPE_LABEL cursor token parser token_to_op
        fi
        if parser.state.take_recovery_request then
            while ops_before ops.length > do
                ops.pop drop
            done
            if parser.state.store_was_mutated then
                parser.state.mark_output_unusable break
            fi
            if cursor.recover_at_structure ! then
                parser.state.mark_output_unusable break
            fi
        fi
    done
    if parser.syntax_only then
        parser.state.flush_accessor_chain
    fi
    ops
}

fn syntax_parser_tokens tokens:$List[Token] -> List[Token] {
    List[Token]::new = result
    for token in tokens.iter do
        if TokenKind::Comment token.kind == then
            continue
        fi
        if TokenKind::Newline token.kind == then
            continue
        fi
        token.location.clone token.kind token.value.clone Token result.push
    done
    result
}

fn logical_comment_text token:$Token -> String {
    1 (u64) = start
    if 1 token.value.length > then
        if ' ' 1 token.value.at == then
            2 (u64) = start
        fi
    fi
    token.value.as_str start token.value.length start - str::substring
}

fn build_syntax_facts source:$str tokens:$List[Token] spans:List[SyntaxSpan] -> SyntaxFacts {
    List[SyntaxTokenFact]::new = meaningful_tokens
    List[SyntaxCommentFact]::new = comments
    0 (u64) = meaningful_count
    false = line_has_meaningful_token

    for token in tokens.iter do
        if TokenKind::Newline token.kind == then
            false = line_has_meaningful_token
        elif TokenKind::Comment token.kind == then
            token logical_comment_text = text
            line_has_meaningful_token meaningful_count text SyntaxCommentFact comments.push
        elif TokenKind::Eof token.kind != then
            # Commas carry no operand content: item separators are required by
            # the grammar (a missing one is a parse error the candidate re-parse
            # still catches), and a trailing comma is optional decoration.
            # Exclude them so the formatter may canonicalize delimited-form
            # commas, including adding or dropping the optional trailing comma,
            # without tripping the token-equality safety net.
            "," token.value.as_str == TokenKind::Delimiter token.kind == && = is_separator
            if is_separator ! then
                token
                    .location
                    .span
                    .length = length
                token
                    .location
                    .span
                    .offset = offset
                source offset length str::substring = spelling
                token.kind spelling SyntaxTokenFact meaningful_tokens.push
                1 += meaningful_count
                true = line_has_meaningful_token
            fi
        fi
    done

    spans comments meaningful_tokens SyntaxFacts
}

fn syntax_facts_match expected:$SyntaxFacts actual:$SyntaxFacts -> bool {
    if actual.meaningful_tokens.length expected.meaningful_tokens.length != then
        false return
    fi
    if actual.comments.length expected.comments.length != then
        false return
    fi

    0 (u64) = index
    while index expected.meaningful_tokens.length > do
        index expected.meaningful_tokens.get = expected_token
        index actual.meaningful_tokens.get = actual_token
        if actual_token.kind expected_token.kind != then
            false return
        fi
        if actual_token.spelling expected_token.spelling != then
            false return
        fi
        1 += index
    done

    0 (u64) = index
    while index expected.comments.length > do
        index expected.comments.get = expected_comment
        index actual.comments.get = actual_comment
        if actual_comment.text expected_comment.text != then
            false return
        fi
        if actual_comment.preceding_token_count expected_comment.preceding_token_count != then
            false return
        fi
        if actual_comment.attached_to_preceding expected_comment.attached_to_preceding != then
            false return
        fi
        1 += index
    done
    true
}
# Recognize one complete root file without resolving names or loading imports.

fn analyze_syntax source:$str file:$str -> SyntaxResult {
    SourceStore::new = sources
    source file sources.add
    file source lex_source_fmt = lex_result
    lex_result.into_parts = diagnostics = tokens
    if diagnostics.has_errors then
        diagnostics Option[SyntaxFacts]::None tokens SyntaxResult return
    fi

    tokens syntax_parser_tokens = parser_tokens
    sources diagnostics symbol_store_new Parser::new = parser
    true = parser.syntax_only
    parser_tokens parser parse_ops drop

    if
        parser.state.has_usable_output parser
            .state
            .diagnostics
            .has_errors ! &&
    then
        parser
            .state
            .spans
            .clone tokens source build_syntax_facts = facts
        parser.into_diagnostics facts Option::Some tokens SyntaxResult
    else
        parser.into_diagnostics Option[SyntaxFacts]::None tokens SyntaxResult
    fi
}

impl Parser {
    fn finish_resolution
        self:Parser
        ops:List[Op]
        skip_functions:Set[String]
    -> ParseResolveResult List[String] {
        if self.state.has_usable_output ! then
            self.into_failed_result return
        fi
        skip_functions ops self resolve_identifiers_global = resolved_ops
        if self.state.has_usable_output ! then
            self.into_failed_result return
        fi
        self
            .store
            .functions
            .keys = function_names
        for function_name in function_names.iter do
            if function_name.as_str skip_functions.has_str then
                continue
            fi
            if function_name.as_str "lambda__" str::starts_with then
                continue
            fi
            function_name self
                .store
                .functions
                .remove
                .unwrap = function
            function.split_body = function_ops = function
            function.clone_declaration function_name.clone self
                .store
                .functions
                .set
            self.state.diagnostics function function_ops self.store resolve_identifiers
            function_ops function.set_ops
            function function_name.clone self
                .store
                .functions
                .set
        done
        self derive_hashable_for_enums
        if self.state.has_usable_output then resolved_ops Option::Some else Option::None fi = result_ops
        result_ops self.into_result
    }
}

fn parse_and_resolve
    tokens:List[Token]
    search_paths:List[String]
    diagnostics:Diagnostics
    sources:mut$SourceStore
-> ParseResolveResult {
    sources diagnostics symbol_store_new Parser::new = parser
    search_paths parser Parser::set_search_paths
    tokens parser parse_ops = ops
    Set[String]::new = skip_functions
    skip_functions ops parser.finish_resolution = included_files = result
    result
}

# ============================================================================
# resolve_identifiers - post-parse pass
# ============================================================================

fn gather_captures store:mut$SymbolStore lambda_function:mut$Function function:mut$Function {
    for op in lambda_function Function::ops.iter do
        Option[String]::None = name_opt
        if op.value OpValue::Identifier(identifier_name) is then
            identifier_name.clone Option::Some = name_opt
        elif
            op.value OpValue::AssignVar is
            op.value OpValue::AssignInc is ||
            op.value OpValue::AssignDec is ||
        then
            op op_str_value = target
            target.as_str "." str::split = target_parts
            if target_parts.length 1 < then
                0 target_parts.get.clone Option::Some = name_opt
            fi
        fi
        if name_opt Option::Some(name) is then
            false = captured

            # Check enclosing function variables
            0 (u64) = variable_index
            while variable_index function Function::variables.length > do
                if name variable_index function Function::variables.get_ref Variable::name == then
                    if name.as_str lambda_function.captures variable_list_contains ! then
                        variable_index function Function::variables.get clone_variable lambda_function Function::captures.push
                    fi
                    true = captured
                    break
                fi
                1 += variable_index
            done

            if captured ! then
                # A nested closure can capture a value already captured by its
                # enclosing closure.
                0 (u64) = capture_index
                while capture_index function Function::captures.length > do
                    if name capture_index function Function::captures.get_ref Variable::name == then
                        if name.as_str lambda_function.captures variable_list_contains ! then
                            capture_index function Function::captures.get clone_variable lambda_function Function::captures.push
                        fi
                        true = captured
                        break
                    fi
                    1 += capture_index
                done
            fi

            if captured ! then
                # Check global variables
                name.as_str store.variables.get_str = global_var_opt
                if global_var_opt Option::Some(global_var) is then
                    if name.as_str lambda_function.captures variable_list_contains ! then
                        global_var clone_variable lambda_function Function::captures.push
                        name.clone lambda_function.global_captures.push
                    fi
                fi
            fi
        fi
    done

    # Constant parameters stay in scope inside a closure. A call in the body
    # may forward one, and the typechecker adds that read after captures are
    # gathered, so capture them up front (ADR-0152).
    for
        constant_name in function
            .stack_effect
            .const_params
            .keys
            .iter
    do
        if constant_name.as_str lambda_function.captures variable_list_contains then
            continue
        fi
        constant_name.as_str function.variables variable_list_index = constant_variable_index
        if 0 constant_variable_index >= then
            constant_variable_index u64::try_from.unwrap function.variables.get clone_variable lambda_function.captures.push
        fi
    done

    # Layout parameters are also inserted after parsing. Capture them so a
    # generic call in the closure can forward the enclosing type layout.
    0 (u64) = layout_index
    while layout_index function.variables.length > do
        layout_index function.variables.get = layout_variable
        layout_variable.name.as_str HIDDEN_SIZE_PREFIX str::starts_with = is_size
        layout_variable.name.as_str HIDDEN_REPR_PREFIX str::starts_with = is_repr
        layout_variable.name.as_str HIDDEN_DROP_PREFIX str::starts_with = is_drop
        if is_size is_repr || is_drop || ! then
            1 += layout_index
            continue
        fi
        if layout_variable.name.as_str lambda_function.captures variable_list_contains ! then
            layout_variable clone_variable lambda_function.captures.push
        fi
        1 += layout_index
    done
}

fn mark_function_used store:mut$SymbolStore name:$str {
    name store.functions.remove_str = function_opt
    function_opt match
        Option::Some(function) => {
            true function Function::set_is_used
            function name.clone store.functions.set_str
        }
        Option::None => {
        }
    end
}

fn resolve_array_identifiers
    store:mut$SymbolStore
    items:mut$List[Op]
    function:mut$Function
    errors:mut$List[CasaError]
    diagnostics:mut$Diagnostics
{
    0 (u64) = item_index
    while item_index items.length > do
        item_index items.get_mut = rai_item
        rai_item.value clone_op_value = rai_value
        if rai_value OpValue::PushArray(inner_items) is then
            inner_items clone_ops = owned_inner_items
            diagnostics errors function owned_inner_items store resolve_array_identifiers
            owned_inner_items OpValue::PushArray rai_item Op::set_value
        elif rai_value OpValue::ExprGroup(group_inner) is then
            group_inner clone_ops = owned_group_inner
            diagnostics function owned_group_inner store resolve_identifiers
            owned_group_inner OpValue::ExprGroup rai_item Op::set_value
        elif rai_value OpValue::Identifier(rai_name_ref) is then
            rai_name_ref.clone = rai_name
            if rai_name.as_str function Function::variables variable_list_contains then
                rai_name.clone OpValue::PushVar rai_item Op::set_value
            elif rai_name.as_str function Function::captures variable_list_contains then
                rai_name.clone OpValue::PushCapture rai_item Op::set_value
            elif
                rai_name.as_str store
                    .variables
                    .get_str
                    .is_some
            then
                rai_name.clone OpValue::PushVar rai_item Op::set_value
            elif
                rai_name.as_str store.constants.get_str = rai_const_opt rai_const_opt Option::Some(rai_const) is
            then
                rai_const Constant::value clone_constant_value = rai_const_value
                rai_const_value match
                    ConstantValue::Int(rai_const_int) => {
                        rai_const_int OpValue::PushInt rai_item Op::set_value
                    }
                    ConstantValue::Float(rai_const_float) => {
                        rai_const_float OpValue::PushFloat rai_item Op::set_value
                    }
                    ConstantValue::Str(rai_const_str) => {
                        rai_const_str OpValue::PushStr rai_item Op::set_value
                    }
                    ConstantValue::Bool(rai_const_bool) => {
                        rai_const_bool OpValue::PushBool rai_item Op::set_value
                    }
                    ConstantValue::Char(rai_const_char) => {
                        rai_const_char OpValue::PushChar rai_item Op::set_value
                    }
                end
            elif errors rai_name.as_str rai_item store try_resolve_enum_variant_ident then
            elif rai_name.as_str store.functions.has_str then
                rai_name.clone OpValue::FnPush rai_item Op::set_value
                rai_name.as_str store mark_function_used
            else
                rai_item Op::location.clone f"Identifier `{rai_name}` is not defined" ErrorKind::UndefinedName CasaError::new errors.push
            fi
        fi
        1 += item_index
    done
}

fn resolve_enum_variant
    store:mut$SymbolStore
    variant:mut$EnumVariant
    op:mut$Op
    function:mut$Function
    errors:mut$List[CasaError]
{
    # Resolve enum variant ordinal if still unresolved
    if variant EnumVariant::enum_name.length 0 != variant EnumVariant::ordinal.is_none && then
        variant EnumVariant::enum_name.as_str store.enums.get_str = rev_enum_opt
        if rev_enum_opt.is_none then
            op Op::location.clone f"Enum `{variant EnumVariant::enum_name}` is not defined" ErrorKind::UndefinedName CasaError::new errors.push
        else
