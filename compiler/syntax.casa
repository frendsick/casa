# Parser for the Casa programming language.
#
# Converts a token list into an op list.
import "std" as std
import "os" as os
import "parser" as parser
import "common" as common
import "error" as error
import "lexer" as lexer
import "semantics" as semantics
import "selective_import" as selective_import

# ============================================================================
# Structural layout spans (formatter facts)
#
# Data-only source-offset ranges over the structures whose layout `casafmt`
# owns. `start` and `close` are the source byte offsets of the opening and
# closing tokens. Recorded only in syntax-only mode (see `analyze_syntax`); no
# spans are produced during normal compilation.
# ============================================================================

pub enum SyntaxSpanKind derives std::Copy {
    Definition
    DelimitedForm
    StructBody
    EnumBody
    ControlForm
    MatchForm
    MatchArm
    AccessorChain
}

pub struct SyntaxSpan {
    pub kind:  SyntaxSpanKind
    pub start: u64
    pub close: u64
}

impl SyntaxSpan: std::Clone {
    pub fn clone self:$SyntaxSpan -> SyntaxSpan { self.close self.start self.kind SyntaxSpan }
}

# ============================================================================
# Parser struct and parse/resolve result
#
# `Parser` owns parse-private state. Later compiler phases receive only the
# dependencies they use, not the parser object itself.
# ============================================================================

pub struct ParseState {
    pub diagnostics:       error::Diagnostics
    pub output_usable:     std::List[bool]
    pub recovery_required: std::List[bool]
    pub store_mutated:     std::List[bool]
    pub spans:             std::List[SyntaxSpan]
    pub if_starts:         std::List[u64]
    pub while_starts:      std::List[u64]
    pub accessor_start:    std::Option[u64]
    pub accessor_close:    u64
}

impl ParseState {
    pub fn new diagnostics:error::Diagnostics -> ParseState {
        std::List[bool]::new = store_mutated
        false store_mutated.push
        std::List[bool]::new = recovery_required
        false recovery_required.push
        std::List[bool]::new = output_usable
        true output_usable.push
        std::List[SyntaxSpan]::new = spans
        std::List[u64]::new = if_starts
        std::List[u64]::new = while_starts
        0 (u64)
        std::Option[u64]::None
        while_starts if_starts spans store_mutated recovery_required output_usable diagnostics ParseState
    }

    pub fn record_error
        self:mut$ParseState
        kind:common::ErrorKind
        message:$str
        location:$common::Location
    {
        location message kind self.diagnostics.record_error
    }

    pub fn record_error_string
        self:mut$ParseState
        kind:common::ErrorKind
        message:std::String
        location:$common::Location
    {
        location message kind self.diagnostics.record_error_string
    }

    pub fn record_error_expected
        self:mut$ParseState
        kind:common::ErrorKind
        message:std::String
        location:$common::Location
        expected:std::String
        got:std::String
    {
        got expected location.clone message kind error::CasaError::with_expected
        self.diagnostics.push_error
    }

    pub fn mark_output_unusable self:mut$ParseState { false 0 self.output_usable.set }

    pub fn has_usable_output self:mut$ParseState -> bool { 0 self.output_usable.get copy }

    pub fn request_recovery self:mut$ParseState { true 0 self.recovery_required.set }

    pub fn take_recovery_request self:mut$ParseState -> bool {
        0 self.recovery_required.get copy = requested
        false 0 self.recovery_required.set
        requested
    }

    pub fn reset_store_mutation self:mut$ParseState { false 0 self.store_mutated.set }

    pub fn mark_store_mutated self:mut$ParseState { true 0 self.store_mutated.set }

    pub fn store_was_mutated self:mut$ParseState -> bool { 0 self.store_mutated.get copy }

    pub fn into_diagnostics self:ParseState -> error::Diagnostics {
        self match
            ParseState { diagnostics: diagnostics } => diagnostics
        end
    }

    # Record one structural layout span.
    pub fn record_span self:mut$ParseState kind:SyntaxSpanKind start:u64 close:u64 {
        close start kind SyntaxSpan self.spans.push
    }

    # Record simple control forms while the parser consumes their keywords.
    pub fn record_control_op self:mut$ParseState value:$common::OpValue offset:u64 {
        if value common::OpValue::IfStart is then
            offset self.if_starts.push
        elif value common::OpValue::IfEnd is self.if_starts.is_empty ! && then
            self.if_starts.pop = start
            offset start SyntaxSpanKind::ControlForm self.record_span
        elif value common::OpValue::WhileStart is then
            offset self.while_starts.push
        elif value common::OpValue::WhileEnd is self.while_starts.is_empty ! && then
            self.while_starts.pop = start
            offset start SyntaxSpanKind::ControlForm self.record_span
        fi
    }

    pub fn record_accessor self:mut$ParseState start:u64 close:u64 {
        if self.accessor_start.is_none then
            start std::Option::Some = self.accessor_start
        fi
        close = self.accessor_close
    }

    pub fn flush_accessor_chain self:mut$ParseState {
        # The formatter owns compact and expanded accessor layout.
        if self.accessor_start std::Option::Some(start) is then
            self.accessor_close start SyntaxSpanKind::AccessorChain self.record_span
        fi
        std::Option[u64]::None = self.accessor_start
        0 = self.accessor_close
    }
}

pub struct ImportedModule {
    pub store:             common::SymbolStore
    pub ops:               std::List[common::Op]
    pub included_files:    std::Set[std::String]
    pub inherited_symbols: std::Set[std::String]
    pub inherited_impls:   std::Set[std::String]
}

pub struct Parser {
    pub store:                  common::SymbolStore
    pub included_files:         std::Set[std::String]
    pub import_stack:           std::List[std::String]
    pub selective_import_cache: mut$std::Map[std::String ImportedModule]
    pub search_paths:           std::List[std::String]
    pub sources:                mut$lexer::SourceStore
    pub state:                  ParseState
    pub syntax_only:            bool
}

pub struct ParseResolveResult {
    pub ops:         std::Option[std::List[common::Op]]
    pub store:       common::SymbolStore
    pub diagnostics: error::Diagnostics
}

impl ParseResolveResult {
    pub fn into_parts
        self:ParseResolveResult
    -> std::Option[std::List[common::Op]] common::SymbolStore error::Diagnostics {
        self match
            ParseResolveResult { ops: ops store: store diagnostics: diagnostics } => ops store diagnostics
        end
    }
}
# Data-only facts used to prove that formatting preserves source meaning.

pub struct SyntaxTokenFact {
    pub spelling: std::String
    pub kind:     common::TokenKind
}

pub struct SyntaxCommentFact {
    pub text:                  std::String
    pub preceding_token_count: u64
    pub attached_to_preceding: bool
}

pub struct SyntaxFacts {
    pub meaningful_tokens: std::List[SyntaxTokenFact]
    pub comments:          std::List[SyntaxCommentFact]
    pub spans:             std::List[SyntaxSpan]
}

pub struct SyntaxResult {
    pub tokens:      std::List[common::Token]
    pub facts:       std::Option[SyntaxFacts]
    pub diagnostics: error::Diagnostics
}

impl SyntaxResult {
    pub fn into_parts
        self:SyntaxResult
    -> std::List[common::Token] std::Option[SyntaxFacts] error::Diagnostics {
        self match
            SyntaxResult { tokens: tokens facts: facts diagnostics: diagnostics } => tokens facts diagnostics
        end
    }
}

impl Parser {
    pub fn new
        store:common::SymbolStore
        diagnostics:error::Diagnostics
        sources:mut$lexer::SourceStore
        import_cache:mut$std::Map[std::String ImportedModule]
    -> Parser {
        false
        diagnostics ParseState::new
        sources
        std::List[std::String]::new
        import_cache
        std::List[std::String]::new
        std::Set[std::String]::new
        store
        Parser
    }

    pub fn into_parts self:Parser -> common::SymbolStore std::Set[std::String] ParseState {
        self match
            Parser { store: store included_files: included_files state: state } => store included_files state
        end
    }

    pub fn into_diagnostics self:Parser -> error::Diagnostics {
        self.into_parts = state = included_files = store
        state.into_diagnostics
    }

    pub fn into_result
        self:Parser
        ops:std::Option[std::List[common::Op]]
    -> ParseResolveResult std::List[std::String] {
        self.into_parts = state = included_files = store
        included_files.to_list = included_file_list
        state.into_diagnostics store ops ParseResolveResult
        included_file_list
    }

    pub fn into_failed_result self:Parser -> ParseResolveResult std::List[std::String] {
        self.into_parts = state = included_files = store
        store drop
        included_files.to_list = included_file_list
        state.into_diagnostics common::symbol_store_new std::Option[std::List[common::Op]]::None ParseResolveResult
        included_file_list
    }

    pub fn put_function self:mut$Parser name:std::String function:common::Function {
        self.state.mark_store_mutated
        name.clone self
            .store
            .module_private_symbols
            .add
        function self.store.set_function
    }

    pub fn put_constant self:mut$Parser name:std::String constant:common::Constant {
        self.state.mark_store_mutated
        name.clone self
            .store
            .module_private_symbols
            .add
        constant name self
            .store
            .constants
            .set
    }

    pub fn put_immutable_global
        self:mut$Parser
        name:std::String
        storage_name:std::String
        location:$common::Location
    {
        self.state.mark_store_mutated
        name.clone self
            .store
            .module_private_symbols
            .add
        name.clone self
            .store
            .immutable_globals
            .add
        location.file.clone name.clone self
            .store
            .immutable_global_files
            .set
        storage_name name.clone self
            .store
            .immutable_global_slots
            .set
        name.as_str common::Variable::new name self
            .store
            .variables
            .set
    }

    pub fn put_enum self:mut$Parser name:std::String casa_enum:common::CasaEnum {
        self.state.mark_store_mutated
        name.clone self
            .store
            .module_private_symbols
            .add
        casa_enum name self
            .store
            .enums
            .set
    }

    pub fn put_struct self:mut$Parser name:std::String casa_struct:common::CasaStruct {
        self.state.mark_store_mutated
        name.clone self
            .store
            .module_private_symbols
            .add
        casa_struct name self
            .store
            .structs
            .set
    }

    pub fn put_trait self:mut$Parser name:std::String casa_trait:common::CasaTrait {
        self.state.mark_store_mutated
        name.clone self
            .store
            .module_private_symbols
            .add
        casa_trait name self
            .store
            .traits
            .set
    }

    pub fn put_trait_impl self:mut$Parser name:std::String trait_impl:common::TraitImpl {
        self.state.mark_store_mutated
        trait_impl name self
            .store
            .trait_impls
            .set
        std::Map[std::String bool]::new = self.store.copy_types
    }
}

impl common::SymbolStore {
    pub fn declaration_names self:$common::SymbolStore -> std::Set[std::String] {
        std::Set[std::String]::new = names
        for name in self.get_function_names.iter do
            name.clone names.add
        done
        for
            name in self
                .constants
                .keys
                .iter
        do
            name.clone names.add
        done
        for name in self.immutable_globals.iter do
            name.clone names.add
        done
        for
            name in self
                .structs
                .keys
                .iter
        do
            name.clone names.add
        done
        for
            name in self
                .enums
                .keys
                .iter
        do
            name.clone names.add
        done
        for
            name in self
                .traits
                .keys
                .iter
        do
            name.clone names.add
        done
        names
    }

    pub fn is_function_unsafe self:$common::SymbolStore name:$str -> std::Option[bool] {
        if name self.get_function std::Option::Some(function) is then
            function.is_unsafe std::Option::Some
        else
            std::Option[bool]::None
        fi
    }

    pub fn get_struct_member_names
        self:$common::SymbolStore
        name:$str
    -> std::Option[std::List[std::String]] {
        if name self.structs.get_str std::Option::Some(casa_struct) is then
            std::List[std::String]::new = names
            for member in casa_struct.members.iter do
                member.name.clone names.push
            done
            names std::Option::Some
        else
            std::Option[std::List[std::String]]::None
        fi
    }

    pub fn count_trait_type_parameters self:$common::SymbolStore name:$str -> std::Option[u64] {
        if name self.traits.get_str std::Option::Some(casa_trait) is then
            casa_trait.type_params.length std::Option::Some
        else
            std::Option[u64]::None
        fi
    }

    pub fn clone_ownership self:$common::SymbolStore op_id:i64 -> std::Option[common::OpOwnership] {
        if op_id self.op_ownership.get std::Option::Some(value) is then
            value.clone std::Option::Some
        else
            std::Option[common::OpOwnership]::None
        fi
    }

    pub fn merge_import_metadata self:mut$common::SymbolStore imported:$common::SymbolStore {
        for
            name in imported
                .variables
                .keys
                .iter
        do
            if name self.variables.has ! then
                name imported
                    .variables
                    .get
                    .unwrap
                    .clone name.clone self.variables.set
            fi
        done
        for name in imported.immutable_globals.iter do
            name.clone self.immutable_globals.add
        done
        for pair in imported.immutable_global_files.iter do
            pair.second.clone pair.first.clone self.immutable_global_files.set
        done
        for pair in imported.immutable_global_slots.iter do
            pair.second.clone pair.first.clone self.immutable_global_slots.set
        done
        for
            name in imported
                .constants
                .keys
                .iter
        do
            if name self.constants.has ! then
                name imported
                    .constants
                    .get
                    .unwrap
                    .clone name.clone self.constants.set
            fi
        done
        for
            name in imported
                .enums
                .keys
                .iter
        do
            if name self.enums.has ! then
                name imported
                    .enums
                    .get
                    .unwrap
                    .clone name.clone self.enums.set
            fi
        done
        for
            name in imported
                .structs
                .keys
                .iter
        do
            if name self.structs.has ! then
                name imported
                    .structs
                    .get
                    .unwrap
                    .clone name.clone self.structs.set
            fi
        done
        for
            name in imported
                .traits
                .keys
                .iter
        do
            if name self.traits.has ! then
                name imported
                    .traits
                    .get
                    .unwrap
                    .clone name.clone self.traits.set
            fi
        done
        for
            name in imported
                .trait_impls
                .keys
                .iter
        do
            if name self.trait_impls.has ! then
                name imported
                    .trait_impls
                    .get
                    .unwrap
                    .clone name.clone self.trait_impls.set
            fi
        done
    }

    pub fn merge_import self:mut$common::SymbolStore imported:mut$common::SymbolStore {
        std::Map[std::String bool]::new = self.copy_types
        imported self.move_missing_functions_from
        imported self.merge_import_metadata
        for name in imported.private_symbols.iter do
            name.clone self.private_symbols.add
        done
        for name in imported.module_private_symbols.iter do
            name.clone self.private_symbols.add
        done
    }

    pub fn clone self:$common::SymbolStore -> common::SymbolStore {
        common::symbol_store_new = cloned
        for name in self.get_function_names.iter do
            name.as_str self
                .get_function
                .unwrap
                .clone_declaration cloned.set_function
        done
        self cloned.merge_import_metadata
        self.public_symbols.clone = cloned.public_symbols
        self.private_symbols.clone = cloned.private_symbols
        self.module_private_symbols.clone = cloned.module_private_symbols
        self.immutable_globals.clone = cloned.immutable_globals
        self.immutable_global_files.clone = cloned.immutable_global_files
        self.immutable_global_slots.clone = cloned.immutable_global_slots
        cloned
    }

    pub fn clone_for_selective_import self:$common::SymbolStore -> common::SymbolStore {
        common::symbol_store_new = cloned
        for name in self.get_function_names.iter do
            name.as_str self
                .get_function
                .unwrap
                .clone_for_import cloned.set_function
        done
        self cloned.merge_import_metadata
        self.public_symbols.clone = cloned.public_symbols
        self.private_symbols.clone = cloned.private_symbols
        self.module_private_symbols.clone = cloned.module_private_symbols
        self.immutable_globals.clone = cloned.immutable_globals
        self.immutable_global_files.clone = cloned.immutable_global_files
        self.immutable_global_slots.clone = cloned.immutable_global_slots
        cloned
    }

    # Cache only declarations owned by one source file. Imported dependencies
    # have their own cache entries and must not be copied into every module.
    pub fn retain_file_declarations
        self:mut$common::SymbolStore
        file:$str
        ops:$std::List[common::Op]
    {
        file self.retain_file_functions
        self.constants.keys = constant_names
        for name in constant_names.iter do
            if
                name self
                    .constants
                    .get
                    .unwrap
                    .location
                    .file
                    .as_str file !=
            then
                name.as_str self.constants.delete_str
            fi
        done
        self.structs.keys = struct_names
        for name in struct_names.iter do
            if
                name self
                    .structs
                    .get
                    .unwrap
                    .location
                    .file
                    .as_str file !=
            then
                name.as_str self.structs.delete_str
            fi
        done
        self.enums.keys = enum_names
        for name in enum_names.iter do
            if
                name self
                    .enums
                    .get
                    .unwrap
                    .location
                    .file
                    .as_str file !=
            then
                name.as_str self.enums.delete_str
            fi
        done
        self.traits.keys = trait_names
        for name in trait_names.iter do
            if
                name self
                    .traits
                    .get
                    .unwrap
                    .location
                    .file
                    .as_str file !=
            then
                name.as_str self.traits.delete_str
            fi
        done
        self.trait_impls.keys = trait_impl_names
        for name in trait_impl_names.iter do
            if
                name self
                    .trait_impls
                    .get
                    .unwrap
                    .location
                    .file
                    .as_str file !=
            then
                name.as_str self.trait_impls.delete_str
            fi
        done
        std::Set[std::String]::new = retained_globals
        for op in ops.iter do
            if
                op
                    .location
                    .file
                    .as_str file ==
                op.value common::OpValue::InitGlobal(initializer) is &&
            then
                initializer.name.clone retained_globals.add
            fi
        done
        self.variables.keys = variable_names
        for name in variable_names.iter do
            if name.as_str retained_globals.has_str ! then
                name.as_str self.variables.delete_str
            fi
        done
        self.immutable_global_files.keys = global_file_names
        for name in global_file_names.iter do
            if name.as_str retained_globals.has_str ! then
                name.as_str self.immutable_global_files.delete_str
            fi
        done
        self.immutable_global_slots.keys = global_slot_names
        for name in global_slot_names.iter do
            if name.as_str retained_globals.has_str ! then
                name.as_str self.immutable_global_slots.delete_str
            fi
        done
        retained_globals = self.immutable_globals

        self.declaration_names = retained_names
        self.public_symbols.clone = previous_public
        std::Set[std::String]::new = retained_public
        for name in previous_public.iter do
            if name.as_str retained_names.has_str then
                name.clone retained_public.add
            fi
        done
        retained_public = self.public_symbols

        self.module_private_symbols.clone = previous_private
        std::Set[std::String]::new = retained_private
        for name in previous_private.iter do
            if name.as_str retained_names.has_str then
                name.clone retained_private.add
            fi
        done
        retained_private = self.module_private_symbols
        std::Set[std::String]::new = self.private_symbols
    }
}

# ============================================================================
# Simple keyword -> OpValue lookup (no-payload variants only)
# ============================================================================

pub fn keyword_to_op_value keyword_kind:$common::KeywordKind -> std::Option[common::OpValue] {
    keyword_kind match
        common::KeywordKind::Break => common::OpValue::WhileBreak std::Option::Some
        common::KeywordKind::Continue => common::OpValue::WhileContinue std::Option::Some
        common::KeywordKind::Do => common::OpValue::WhileCondition std::Option::Some
        common::KeywordKind::Done => common::OpValue::WhileEnd std::Option::Some
        common::KeywordKind::Elif => common::OpValue::IfElif std::Option::Some
        common::KeywordKind::Else => common::OpValue::IfElse std::Option::Some
        common::KeywordKind::Fi => common::OpValue::IfEnd std::Option::Some
        common::KeywordKind::If => common::OpValue::IfStart std::Option::Some
        common::KeywordKind::Return => common::OpValue::FnReturn std::Option::Some
        common::KeywordKind::Then => common::OpValue::IfCondition std::Option::Some
        common::KeywordKind::While => common::OpValue::WhileStart std::Option::Some
        _ => std::Option[common::OpValue]::None
    end
}

# ============================================================================
# Operator -> OpValue lookup
# ============================================================================

pub fn operator_to_op_value operator_kind:common::OperatorKind -> std::Option[common::OpValue] {
    operator_kind match
        common::OperatorKind::Plus => common::OpValue::Add std::Option::Some
        common::OperatorKind::Minus => common::OpValue::Sub std::Option::Some
        common::OperatorKind::Mul => common::OpValue::Mul std::Option::Some
        common::OperatorKind::Div => common::OpValue::Div std::Option::Some
        common::OperatorKind::Mod => common::OpValue::Mod std::Option::Some
        common::OperatorKind::Shl => common::OpValue::Shl std::Option::Some
        common::OperatorKind::Shr => common::OpValue::Shr std::Option::Some
        common::OperatorKind::BitAnd => common::OpValue::BitAnd std::Option::Some
        common::OperatorKind::BitOr => common::OpValue::BitOr std::Option::Some
        common::OperatorKind::BitXor => common::OpValue::BitXor std::Option::Some
        common::OperatorKind::BitNot => common::OpValue::BitNot std::Option::Some
        common::OperatorKind::And => common::OpValue::And std::Option::Some
        common::OperatorKind::Or => common::OpValue::Or std::Option::Some
        common::OperatorKind::Not => common::OpValue::Not std::Option::Some
        common::OperatorKind::Eq => common::OpValue::Eq std::Option::Some
        common::OperatorKind::Ge => common::OpValue::Ge std::Option::Some
        common::OperatorKind::Gt => common::OpValue::Gt std::Option::Some
        common::OperatorKind::Le => common::OpValue::Le std::Option::Some
        common::OperatorKind::Lt => common::OpValue::Lt std::Option::Some
        common::OperatorKind::Ne => common::OpValue::Ne std::Option::Some
        _ => std::Option[common::OpValue]::None
    end
}

pub fn op_value_to_operator_kind op_value:$common::OpValue -> std::Option[common::OperatorKind] {
    op_value match
        common::OpValue::Add => common::OperatorKind::Plus std::Option::Some
        common::OpValue::Sub => common::OperatorKind::Minus std::Option::Some
        common::OpValue::Mul => common::OperatorKind::Mul std::Option::Some
        common::OpValue::Div => common::OperatorKind::Div std::Option::Some
        common::OpValue::Mod => common::OperatorKind::Mod std::Option::Some
        common::OpValue::Shl => common::OperatorKind::Shl std::Option::Some
        common::OpValue::Shr => common::OperatorKind::Shr std::Option::Some
        common::OpValue::BitAnd => common::OperatorKind::BitAnd std::Option::Some
        common::OpValue::BitOr => common::OperatorKind::BitOr std::Option::Some
        common::OpValue::BitXor => common::OperatorKind::BitXor std::Option::Some
        common::OpValue::BitNot => common::OperatorKind::BitNot std::Option::Some
        common::OpValue::And => common::OperatorKind::And std::Option::Some
        common::OpValue::Or => common::OperatorKind::Or std::Option::Some
        common::OpValue::Not => common::OperatorKind::Not std::Option::Some
        common::OpValue::Eq => common::OperatorKind::Eq std::Option::Some
        common::OpValue::Ge => common::OperatorKind::Ge std::Option::Some
        common::OpValue::Gt => common::OperatorKind::Gt std::Option::Some
        common::OpValue::Le => common::OperatorKind::Le std::Option::Some
        common::OpValue::Lt => common::OperatorKind::Lt std::Option::Some
        common::OpValue::Ne => common::OperatorKind::Ne std::Option::Some
        _ => std::Option[common::OperatorKind]::None
    end
}

# ============================================================================
# Token cursor
# ============================================================================

pub struct TokenCursor {
    pub tokens: std::List[common::Token]
    pub pos:    u64
}

impl TokenCursor {
    pub fn new tokens:std::List[common::Token] -> TokenCursor { 0 tokens TokenCursor }

    pub fn pop self:mut$TokenCursor -> std::Option[common::Token] {
        self TokenCursor::pos copy = pos
        if self TokenCursor::tokens.length pos >= then
            std::Option::None return
        fi
        pos self TokenCursor::tokens.get.clone = token
        pos 1 + self TokenCursor::set_pos
        token std::Option::Some
    }

    pub fn peek self:mut$TokenCursor -> std::Option[common::Token] {
        self TokenCursor::pos copy = pos
        if self TokenCursor::tokens.length pos >= then
            std::Option::None return
        fi
        pos self TokenCursor::tokens.get.clone std::Option::Some
    }

    pub fn is_finished self:mut$TokenCursor -> bool {
        self TokenCursor::tokens.length self TokenCursor::pos >=
    }

    pub fn advance self:mut$TokenCursor { self TokenCursor::pos 1 + self TokenCursor::set_pos }

    pub fn retreat self:mut$TokenCursor { self TokenCursor::pos 1 - self TokenCursor::set_pos }

    pub fn save self:mut$TokenCursor -> u64 { self TokenCursor::pos }

    # Source byte offset of the token just consumed (at pos - 1).
    pub fn previous_offset self:mut$TokenCursor -> u64 {
        self.pos 1 - self.tokens.get common::Token::location common::Location::span common::Span::offset
    }

    pub fn restore self:mut$TokenCursor saved:u64 { saved self TokenCursor::set_pos }

    pub fn recover_at_structure self:mut$TokenCursor -> bool {
        if 0 self.pos > then
            self.pos 1 - self.tokens.get = previous
            if previous is_parser_synchronization_token then
                true return
            fi
        fi
        while self.is_finished ! do
            self.peek.unwrap = token
            if token is_parser_synchronization_token then
                if token is_parser_delimiter then
                    self.advance
                fi
                true return
            fi
            self.advance
        done
        false
    }
}

pub fn is_parser_synchronization_token token:$common::Token -> bool {
    if token is_parser_delimiter then
        true return
    fi
    token.value.as_str = value: $str
    "fn" value ==
    "enum" value == ||
    "struct" value == ||
    "trait" value == ||
    "impl" value == ||
    "import" value == ||
    "const" value == ||
}

pub fn is_parser_delimiter token:$common::Token -> bool {
    token.value.as_str = value: $str
    "}" value == "fi" value == || "done" value == || "end" value == ||
}

# ============================================================================
# expect_token - consume next token, error if mismatch
# ============================================================================

pub fn fallback_token -> common::Token {
    common::empty_location common::TokenKind::Eof "".to_str common::Token::new
}

pub fn expect_token cursor:mut$TokenCursor state:mut$ParseState -> std::Option[common::Token] {
    cursor.pop = result_opt
    if result_opt.is_none then
        common::empty_location "Unexpected end of input" common::ErrorKind::UnexpectedToken state.record_error
        state.mark_output_unusable
        state.request_recovery
        std::Option::None return
    fi
    result_opt.unwrap = token
    if common::TokenKind::Eof token common::Token::kind == then
        token common::Token::location "Unexpected end of input" common::ErrorKind::UnexpectedToken state.record_error
        state.mark_output_unusable
        state.request_recovery
        std::Option::None return
    fi
    token std::Option::Some
}

pub fn expect_token_value
    cursor:mut$TokenCursor
    expected:str
    state:mut$ParseState
-> std::Option[common::Token] {
    state cursor expect_token = token_opt
    if token_opt.is_none then
        std::Option::None return
    fi
    token_opt.unwrap = token
    if expected token common::Token::value.as_str != then
        cursor.retreat
        f"`{token common::Token::value.as_str}`"
        f"`{expected}`"
        token common::Token::location
        "Unexpected token".to_str
        common::ErrorKind::UnexpectedToken
        state.record_error_expected
        state.request_recovery
        std::Option::None return
    fi
    token std::Option::Some
}

pub fn expect_token_kind
    cursor:mut$TokenCursor
    expected_kind:common::TokenKind
    state:mut$ParseState
-> std::Option[common::Token] {
    state cursor expect_token = token_opt
    if token_opt.is_none then
        std::Option::None return
    fi
    token_opt.unwrap = token
    if expected_kind token common::Token::kind != then
        cursor.retreat
        token common::Token::location "Unexpected token" common::ErrorKind::UnexpectedToken state.record_error
        state.request_recovery
        std::Option::None return
    fi
    token std::Option::Some
}

# ============================================================================
# expect_delimiter - consume expected delimiter or return None
# ============================================================================

pub fn expect_delimiter cursor:mut$TokenCursor expected_value:str -> bool {
    cursor.peek = peek_opt
    if peek_opt.is_none then
        false return
    fi
    peek_opt.unwrap = token
    if expected_value token common::Token::value.as_str != then
        false return
    fi
    cursor.advance
    true
}

# ============================================================================
# parse_type - parse a type expression
# ============================================================================
# True if a type-position leaf is a constant argument (integer, `true`/`false`,
# or char literal) rather than a type name (ADR-0153).

pub fn is_type_argument_literal value:$str -> bool {
    if value common::try_parse_uint_literal.is_some then
        true return
    fi
    if "true" value.as_str == "false" value.as_str == || then
        true return
    fi
    value char_literal_codepoint.is_some
}

pub fn parse_type_ast cursor:mut$TokenCursor state:mut$ParseState -> common::Type {
    cursor.peek = peek_opt
    if peek_opt.is_none then
        common::empty_location "Expected type" common::ErrorKind::UnexpectedToken state.record_error
        common::Type::Unknown return
    fi
    peek_opt.unwrap = peek

    "" = borrow_prefix
    std::String::new = base
    if "fn" peek common::Token::value.as_str == then
        cursor.pop drop
        "fn".to_str = base
    else
        fallback_token state cursor expect_token.unwrap_or = base_token
        if
            common::TokenKind::Identifier base_token common::Token::kind !=
            base_token common::Token::value.as_str is_type_argument_literal ! &&
        then
            base_token common::Token::location "Expected type name" common::ErrorKind::UnexpectedToken state.record_error
        fi
        base_token common::Token::value.clone = base
    fi
    if base.as_str "mut$" str::starts_with then
        common::EXCLUSIVE_BORROW_TYPE = borrow_prefix
        base.length = base_length
        base.as_str 4 base_length 4 - str::substring = base
    elif base.as_str "$" str::starts_with then
        common::SHARED_BORROW_TYPE = borrow_prefix
        base.length = base_length
        base.as_str 1 base_length 1 - str::substring = base
    fi
    if base.as_str "$" str::starts_with base.as_str "mut$" str::starts_with || then
        peek.location "Nested borrow qualifiers are not supported" common::ErrorKind::Syntax
        state.record_error
        common::Type::Unknown return
    fi

    # Char constant (ADR-0153): built here rather than in `parse_type_str`,
    # which cannot decode the codepoint.
    if base.as_str char_literal_codepoint std::Option::Some(char_codepoint) is then
        common::BuiltinType::Char char_codepoint common::ConstType::concrete common::Type::Const return
    fi

    cursor.peek = next_opt
    if next_opt.is_none then
        borrow_prefix base.as_str common::parse_type_str common::apply_borrow_type return
    fi
    if next_opt std::Option::Some(next) is then
        if "[" next common::Token::value.as_str != then
            borrow_prefix base.as_str common::parse_type_str common::apply_borrow_type return
        fi
    fi
    cursor.advance # consume [

    if "fn" base.as_str == then
        std::List[common::Type]::new = fn_params
        std::List[common::Type]::new = fn_returns
        false = past_arrow
        while cursor.is_finished ! do
            cursor.peek = inner_opt
            if inner_opt.is_none then
                break
            fi
            inner_opt.unwrap common::Token::value.as_str = ival: $str
            if "]" ival.as_str == then
                cursor.pop drop
                break
            fi
            if "->" ival.as_str == then
                cursor.pop drop
                true = past_arrow
                continue
            fi
            state cursor parse_type_ast = inner_type
            if past_arrow then
                inner_type fn_returns.push
            else
                inner_type fn_params.push
            fi
        done
        borrow_prefix fn_returns fn_params common::FunctionType common::Type::Function common::apply_borrow_type return
    fi

    std::List[common::Type]::new = inner_types
    while true do
        cursor.peek = inner_opt
        if inner_opt std::Option::Some(inner) is then
            if "]" inner common::Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi
        state cursor parse_type_ast inner_types.push
    done
    if 0 inner_types.length == then
        common::empty_location f"Expected type parameter inside `{base}[...]`" common::ErrorKind::UnexpectedToken state.record_error_string
    fi
    borrow_prefix inner_types base common::GenericType common::Type::Generic common::apply_borrow_type
}

# ============================================================================
# get_op_type_cast - parse (type) cast
# ============================================================================

pub fn get_op_type_cast cursor:mut$TokenCursor state:mut$ParseState -> common::Op {
    fallback_token state "(" cursor expect_token_value.unwrap_or = open_token
    state cursor parse_type_ast = cast_type
    fallback_token state ")" cursor expect_token_value.unwrap_or = close_token

    open_token common::Token::location common::Location::span common::Span::offset = open_offset
    close_token common::Token::location common::Location::span common::Span::offset = close_offset
    close_offset open_offset - 1 + = length
    length open_offset open_token common::Token::location common::Location::file.clone common::Location::new = loc

    loc cast_type common::OpValue::TypeCast common::Op::new
}

# ============================================================================
# get_op_literal - convert literal token to push op
# ============================================================================

pub fn char_literal_codepoint value:$str -> std::Option[i64] {
    if 3 value.length < then
        std::Option[i64]::None return
    fi
    if '\'' 0 value.at != '\'' value.length 1 - value.at != || then
        std::Option[i64]::None return
    fi
    value 1 lexer::decode_utf8_scalar = decoded_opt
    if decoded_opt std::Option::Some(decoded) is then
        if decoded.byte_length 2 + value.length == then
            decoded lexer::DecodedUtf8Scalar::codepoint i64::from std::Option::Some return
        fi
    fi
    std::Option[i64]::None
}

pub fn get_op_literal
    token:$common::Token
    cursor:mut$TokenCursor
    state:mut$ParseState
-> common::Op {
    token common::Token::value.as_str = value: $str
    if "true" value.as_str == then
        token common::Token::location 1 common::OpValue::PushBool common::Op::new return
    fi
    if "false" value.as_str == then
        token common::Token::location 0 common::OpValue::PushBool common::Op::new return
    fi
    # Numeric literal (positive or negative)
    if value lexer::is_float_literal then
        token common::Token::location value.to_str common::OpValue::PushFloat common::Op::new return
    fi
    if 0 value.at.is_digit value lexer::is_negative_integer_literal || then
        value parser::str_to_int = int_value
        token common::Token::location int_value value.to_str common::IntegerLiteral::new common::OpValue::PushInt common::Op::new return
    fi
    value char_literal_codepoint = char_opt
    if char_opt std::Option::Some(char_value) is then
        token common::Token::location char_value common::OpValue::PushChar common::Op::new return
    fi
    # String literal: "..."
    if '"' 0 value.at == '"' value.length 1 - value.at == && then
        value.length = value_length
        value 1 value_length 2 - str::substring = str_value
        token common::Token::location str_value common::OpValue::PushStr common::Op::new return
    fi
    token common::Token::location f"Token `{value}` is not a literal" common::ErrorKind::Syntax state.record_error_string
    token common::Token::location 0 common::make_integer_op_value common::Op::new
}

# ============================================================================
# get_op_intrinsic - convert intrinsic token to op
# ============================================================================

pub fn get_op_intrinsic
    token:$common::Token
    cursor:mut$TokenCursor
    state:mut$ParseState
-> common::Op {
    token common::Token::value.as_str common::intrinsic_from_str = kind_opt
    if kind_opt std::Option::Some(kind) is then
        kind copy = intrinsic_kind
        if intrinsic_kind common::IntrinsicKind::SizeOf == then
            fallback_token state "[" cursor expect_token_value.unwrap_or drop
            state cursor parse_type_ast = target_type
            fallback_token state "]" cursor expect_token_value.unwrap_or drop
            token common::Token::location target_type common::OpValue::SizeOf common::Op::new return
        fi
        intrinsic_kind common::intrinsic_to_op_value match
            std::Option::Some(op_value) => token common::Token::location op_value common::Op::new return
            std::Option::None => {
                token common::Token::location f"No OpValue for intrinsic `{token common::Token::value.as_str}`" common::ErrorKind::Syntax state.record_error_string
            }
        end
    else
        token common::Token::location f"Token `{token common::Token::value.as_str}` is not an intrinsic" common::ErrorKind::Syntax state.record_error_string
    fi
    token common::Token::location 0 common::make_integer_op_value common::Op::new
}

# ============================================================================
# get_op_operator - convert operator token to op
# ============================================================================

pub fn parse_assignment_target
    cursor:mut$TokenCursor
    state:mut$ParseState
-> common::Location std::String {
    fallback_token state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = root_token
    root_token common::Token::value.clone = target
    while "." cursor expect_delimiter do
        fallback_token state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or common::Token::value.as_str = field: $str
        f"{target}.{field}" = target
    done
    root_token common::Token::location.clone
    target
}

pub fn get_op_operator
    token:$common::Token
    cursor:mut$TokenCursor
    function_name:$str
    state:mut$ParseState
-> common::Op {
    token common::Token::value.as_str common::operator_from_str = kind_opt
    if kind_opt std::Option::Some(kind) is then
        kind copy = operator_kind

        # Assignment: = varname
        if common::OperatorKind::Assign operator_kind == then
            state cursor parse_assignment_target = var_name = target_location

            # Optional type annotation: = varname : type
            std::Option[common::Type]::None = type_hint
            cursor.peek = colon_opt
            if colon_opt std::Option::Some(colon) is then
                if ":" colon common::Token::value.as_str == then
                    cursor.advance
                    state cursor parse_type_ast std::Option::Some = type_hint
                fi
            fi
            target_location var_name common::OpValue::AssignVar common::Op::new = assign_op
            type_hint = assign_op.type_hint
            assign_op return
        fi

        # Compound assignment: += varname
        if common::OperatorKind::AssignInc operator_kind == then
            state cursor parse_assignment_target = inc_target = inc_location
            inc_location inc_target common::OpValue::AssignInc common::Op::new return
        fi

        # Compound assignment: -= varname
        if common::OperatorKind::AssignDec operator_kind == then
            state cursor parse_assignment_target = dec_target = dec_location
            dec_location dec_target common::OpValue::AssignDec common::Op::new return
        fi

        # Simple operator -> OpValue lookup
        operator_kind operator_to_op_value match
            std::Option::Some(op_value) => token common::Token::location op_value common::Op::new return
            std::Option::None => {
                token common::Token::location f"No OpValue for operator `{token common::Token::value.as_str}`" common::ErrorKind::Syntax state.record_error_string
            }
        end
    else
        token common::Token::location f"Token `{token common::Token::value.as_str}` is not an operator" common::ErrorKind::Syntax state.record_error_string
    fi
    token common::Token::location 0 common::make_integer_op_value common::Op::new
}

# ============================================================================
# Forward declarations (functions that call each other)
# ============================================================================
# token_to_op, parse_block_ops, handle_fstring are mutually recursive
# In Casa, we just define them in order and rely on global function lookup.
# ============================================================================
# get_op_array - parse [item1, item2] array literal
# ============================================================================

pub fn parse_array_struct_literal
    parser:mut$Parser
    function_name:$str
    cursor:mut$TokenCursor
    name_token:$common::Token
    items:mut$std::List[common::Op]
{
    function_name cursor name_token parser parse_struct_literal = struct_ops
    name_token common::Token::location struct_ops common::OpValue::ExprGroup common::Op::new items.push
}

pub fn parse_array_lambda
    parser:mut$Parser
    function_name:$str
    cursor:mut$TokenCursor
    brace_token:common::Token
    items:mut$std::List[common::Op]
{
    cursor.retreat
    f"lambda__{function_name}_o{brace_token common::Token::location common::Location::span common::Span::offset}" = arr_lam_name
    arr_lam_name.as_str cursor parser parse_block_ops = arr_lam_ops
    brace_token common::Token::location.clone arr_lam_ops arr_lam_name.clone common::Function::new = arr_lam_fn
    arr_lam_fn arr_lam_name.clone parser.put_function
    brace_token common::Token::location.clone arr_lam_name common::OpValue::FnPush common::Op::new items.push
}

pub fn get_op_array parser:mut$Parser function_name:$str cursor:mut$TokenCursor -> common::Op {
    fallback_token parser.state "[" cursor expect_token_value.unwrap_or = open_token
    std::List[common::Op]::new = items
    while true do
        # Close on `]` (also reached after an optional trailing comma).
        cursor.peek = close_peek
        if close_peek std::Option::Some(cp) is then
            if "]" cp common::Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi

        # Parse one item.
        false = parsed_nested
        cursor.peek = next_opt
        if next_opt std::Option::Some(next) is then
            if "[" next common::Token::value.as_str == then
                cursor function_name parser get_op_array items.push
                true = parsed_nested
            fi
        fi
        if parsed_nested ! then
            cursor.pop = value_opt
            if value_opt.is_none then
                open_token common::Token::location "Unexpected end of input in array literal" common::ErrorKind::UnexpectedToken parser.state.record_error
                parser.state.mark_output_unusable
                open_token.location items common::OpValue::PushArray common::Op::new return
            fi
            value_opt.unwrap = value_token
            if "{" value_token common::Token::value.as_str == then
                items value_token cursor function_name parser parse_array_lambda
            elif common::TokenKind::Literal value_token common::Token::kind == then
                parser.state cursor value_token get_op_literal items.push
            elif common::TokenKind::Identifier value_token common::Token::kind == then
                cursor.peek = struct_peek_opt
                if struct_peek_opt std::Option::Some(struct_peek) is then
                    if "{" struct_peek common::Token::value.as_str == then
                        items value_token cursor function_name parser parse_array_struct_literal
                    else
                        value_token common::Token::location value_token common::Token::value.clone common::OpValue::Identifier common::Op::new items.push
                    fi
                else
                    value_token common::Token::location value_token common::Token::value.clone common::OpValue::Identifier common::Op::new items.push
                fi
            else
                value_token common::Token::location "Unexpected token in array literal" common::ErrorKind::UnexpectedToken parser.state.record_error
            fi
        fi

        # Items MUST be comma-separated. A single trailing comma before `]` is
        # allowed for developer experience; the next iteration closes on `]`.
        cursor.peek = sep_peek
        if sep_peek std::Option::Some(sp) is then
            if "," sp common::Token::value.as_str == then
                cursor.pop drop
            else
                if "]" sp common::Token::value.as_str == ! then
                    sp common::Token::location "Expected `,` between array items" common::ErrorKind::UnexpectedToken parser.state.record_error
                    parser.state.mark_output_unusable
                    break
                fi
            fi
        else
            open_token common::Token::location "Unexpected end of input in array literal" common::ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
    done
    if parser.syntax_only then
        cursor.previous_offset
        open_token common::Token::location common::Location::span common::Span::offset
        SyntaxSpanKind::DelimitedForm parser.state.record_span
    fi
    open_token common::Token::location items common::OpValue::PushArray common::Op::new
}

# ============================================================================
# parse_block_ops - parse { ... } delimited block
# ============================================================================

pub fn parse_block_ops
    parser:mut$Parser
    cursor:mut$TokenCursor
    function_name:$str
-> std::List[common::Op] {
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or = open_token
    std::List[common::Op]::new = ops
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            open_token common::Token::location "Unclosed block" common::ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            ops return
        fi
        token_opt.unwrap = token
        if common::TokenKind::Comment token common::Token::kind == then
            continue
        fi
        if common::TokenKind::Newline token common::Token::kind == then
            continue
        fi
        if "}" token common::Token::value.as_str == then
            ops return
        fi
        if common::TokenKind::FstringStart token common::Token::kind == then
            ops function_name cursor token parser handle_fstring
            continue
        fi
        ops function_name cursor token parser token_to_op
    done
    ops
}

# ============================================================================
# handle_fstring - parse f-string tokens into ops
# ============================================================================

pub fn parse_fstring_expr
    parser:mut$Parser
    cursor:mut$TokenCursor
    function_name:$str
-> std::List[common::Op] {
    std::List[common::Op]::new = ops
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            break
        fi
        token_opt.unwrap = token
        if common::TokenKind::FstringExprEnd token common::Token::kind == then
            break
        fi
        if common::TokenKind::FstringStart token common::Token::kind == then
            ops function_name cursor token parser handle_fstring
            continue
        fi
        ops function_name cursor token parser token_to_op
    done
    if parser.syntax_only then
        parser.state.flush_accessor_chain
    fi
    ops
}

pub fn handle_fstring
    parser:mut$Parser
    start_token:common::Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$std::List[common::Op]
{
    if parser.syntax_only then
        parser.state.flush_accessor_chain
    fi
    0 (u64) = part_count
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            break
        fi
        token_opt.unwrap = token
        if common::TokenKind::FstringText token common::Token::kind == then
            token common::Token::location token common::Token::value.clone common::OpValue::PushStr common::Op::new ops.push
            token common::Token::location.clone common::OpValue::FstringToStr common::Op::new ops.push
            1 += part_count
        elif common::TokenKind::FstringExprStart token common::Token::kind == then
            function_name cursor parser parse_fstring_expr = expr_ops
            token common::Token::location.clone common::OpValue::FstringToStr common::Op::new expr_ops.push
            f"lambda__{function_name}_o{token common::Token::location common::Location::span common::Span::offset}" = lambda_name
            token common::Token::location.clone expr_ops lambda_name.clone common::Function::new = lambda_function
            true lambda_function common::Function::set_captures_shared
            lambda_function lambda_name.clone parser.put_function
            token common::Token::location.clone lambda_name common::OpValue::FnPush common::Op::new ops.push
            token common::Token::location.clone common::OpValue::FnExec common::Op::new ops.push
            1 += part_count
        elif common::TokenKind::FstringEnd token common::Token::kind == then
            break
        fi
    done
    if 0 part_count == then
        start_token common::Token::location "".to_str common::OpValue::PushStr common::Op::new ops.push
        start_token common::Token::location.clone common::OpValue::FstringToStr common::Op::new ops.push
        1 (u64) = part_count
    fi
    if 1 part_count > then
        start_token common::Token::location part_count common::OpValue::FstringConcat common::Op::new ops.push
    fi
}

# ============================================================================
# get_op_delimiter - convert delimiter token to op
# ============================================================================

pub fn get_op_delimiter
    parser:mut$Parser
    token:$common::Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$std::List[common::Op]
{
    token common::Token::value.as_str = value: $str

    # Dot . method
    if "." value.as_str == then
        parser.state cursor expect_function_name = method_token
        if parser.syntax_only then
            method_token common::Token::location common::Location::span common::Span::offset
            token common::Token::location common::Location::span common::Span::offset
            parser.state.record_accessor
        fi
        method_token common::Token::location method_token common::Token::value.clone common::OpValue::MethodCall common::Op::new ops.push
        return
    fi

    # Open brace { -> lambda
    if "{" value.as_str == then
        cursor.retreat
        f"lambda__{function_name}_o{token common::Token::location common::Location::span common::Span::offset}" = lambda_name
        lambda_name.as_str cursor parser parse_block_ops = lambda_ops
        token common::Token::location.clone lambda_ops lambda_name.clone common::Function::new = lambda_function
        lambda_function lambda_name.clone parser.put_function
        token common::Token::location lambda_name common::OpValue::FnPush common::Op::new ops.push
        return
    fi

    # Open bracket [ -> array literal
    if "[" value.as_str == then
        cursor.retreat
        cursor function_name parser get_op_array ops.push
        return
    fi

    # Open paren ( -> type cast
    if "(" value.as_str == then
        cursor.retreat
        parser.state cursor get_op_type_cast ops.push
        return
    fi

    # Other delimiters (comma, colon, close brace/bracket/paren, fat arrow, hashtag)
    # are ignored or handled by their enclosing constructs
}

# ============================================================================
# _try_parse_is_check - try parsing Enum::Variant is
# ============================================================================

pub fn try_parse_is_check token:$common::Token cursor:mut$TokenCursor -> std::Option[common::Op] {
    cursor.save = saved_pos
    std::List[std::String]::new = bindings

    # Check for bindings: Enum::Variant(a b) is
    false = has_bindings
    if cursor.peek std::Option::Some(peek_token) is then
        "(" peek_token common::Token::value.as_str == = has_bindings
    else
        std::Option[common::Op]::None return
    fi
    if has_bindings then
        cursor.pop drop # consume (
        while true do
            if cursor.peek std::Option::Some(inner) is then
                if ")" inner common::Token::value.as_str == then
                    cursor.pop drop # consume )
                    if 0 bindings.length == then
                        saved_pos cursor.restore
                        std::Option::None return
                    fi
                    break
                fi
                if common::TokenKind::Identifier inner common::Token::kind != then
                    saved_pos cursor.restore
                    std::Option::None return
                fi
                cursor.pop drop
                inner common::Token::value.clone bindings.push
            else
                saved_pos cursor.restore
                std::Option::None return
            fi
        done
    fi

    # Check if next token is `is`
    if cursor.peek std::Option::Some(is_token) is then
        if "is" is_token common::Token::value.as_str != then
            saved_pos cursor.restore
            std::Option::None return
        fi
    else
        saved_pos cursor.restore
        std::Option::None return
    fi
    cursor.pop drop # consume `is`

    # Split token value on ::
    token common::Token::value.as_str "::" str::find = separator
    token common::Token::value.as_str 0 separator (u64) str::substring = enum_name
    token common::Token::value.as_str separator 2 + (u64) token common::Token::value.as_str.length separator (u64) - 2 - str::substring = variant_name

    std::Option::None variant_name enum_name common::EnumVariant::new = variant
    bindings variant common::EnumVariant::set_bindings
    token common::Token::location variant common::OpValue::IsCheck common::Op::new = parsed_is
    parsed_is std::Option::Some
}

# ============================================================================
# _require_global_scope
# ============================================================================

pub fn require_global_scope
    function_name:$str
    what:str
    location:$common::Location
    parser:mut$Parser
{
    if common::GLOBAL_SCOPE_LABEL function_name != then
        location f"{what} should be defined in the global scope" common::ErrorKind::InvalidScope parser.state.record_error_string
    fi
}

# ============================================================================
# parse_type_variables - parse [T, K: Hashable] type variable lists
# ============================================================================

pub struct ParsedTypeVariables {
    pub names:        std::List[std::String]
    pub trait_bounds: std::Map[std::String std::List[common::TraitBound]]
    pub const_params: std::Map[std::String common::BuiltinType]
}

impl ParsedTypeVariables {
    pub fn into_parts
        self:ParsedTypeVariables
    -> std::List[std::String] std::Map[std::String std::List[common::TraitBound]] std::Map[std::String common::BuiltinType] {
        self match
            ParsedTypeVariables { names: names trait_bounds: trait_bounds const_params: const_params } => names trait_bounds const_params
        end
    }
}
# Parse the `[arg1 arg2 ...]` type argument list that follows a generic trait
# name in a trait bound (e.g. `I: Iterable[i64]`). The caller has already
# consumed the trait identifier. If the next token is not `[`, returns an
# empty list. Otherwise parses each argument as a Type AST value.

pub fn parse_bound_type_args
    cursor:mut$TokenCursor
    trait_token:$common::Token
    state:mut$ParseState
-> std::List[common::Type] {
    std::List[common::Type]::new = bound_args
    cursor.peek = bracket_opt
    if bracket_opt.is_none then
        bound_args return
    fi
    if bracket_opt std::Option::Some(bracket) is then
        if "[" bracket common::Token::value.as_str != then
            bound_args return
        fi
    fi
    cursor.pop drop
    while true do
        cursor.peek = argument_token_option
        if argument_token_option.is_none then
            trait_token common::Token::location "Unclosed trait bound type argument list" common::ErrorKind::Syntax state.record_error
            state.mark_output_unusable
            bound_args return
        fi
        argument_token_option.unwrap common::Token::value.as_str = argument_value: $str
        if "]" argument_value.as_str == then
            cursor.pop drop
            bound_args return
        fi
        if "," argument_value.as_str == then
            cursor.pop drop
            continue
        fi
        state cursor parse_type_ast bound_args.push
    done
    bound_args
}

pub fn trait_bound_method_effect
    type_variable:$str
    method:$common::TraitMethod
    bound:$common::TraitBound
    casa_trait:$common::CasaTrait
-> common::StackEffect {
    casa_trait bound semantics::make_bound_substitutions = substitutions
    0 (u64) = method_type_index
    for method_type_variable in method.type_vars.iter do
        f"__method_type_{method_type_index}" common::Type::TypeVar
        method_type_variable.clone substitutions.set
        1 += method_type_index
    done
    type_variable.to_str common::Type::TypeVar method.stack_effect common::resolve_trait_stack_effect = effect
    substitutions effect common::apply_type_subs_to_stack_effect
}

pub fn stack_effect_shapes_equal first:$common::StackEffect second:$common::StackEffect -> bool {
    if first.parameters.length second.parameters.length != then
        false return
    fi
    if first.return_types.length second.return_types.length != then
        false return
    fi
    for
        pair in second.parameters.iter first
            .parameters
            .iter
            .zip
    do
        if
            pair.second.typ pair
                .first
                .typ
                .eq !
        then
            false return
        fi
    done
    for
        pair in second.return_types.iter first
            .return_types
            .iter
            .zip
    do
        if pair.second pair.first.eq ! then
            false return
        fi
    done
    true
}

pub fn bound_is_compatible
    parser:mut$Parser
    type_variable:$str
    existing_bounds:$std::List[common::TraitBound]
    candidate:$common::TraitBound
-> bool {
    candidate.name parser
        .store
        .traits
        .get = candidate_trait_opt
    if candidate_trait_opt.is_none then
        false return
    fi
    candidate_trait_opt.unwrap = candidate_trait
    candidate_trait parser.store semantics::collect_trait_methods = candidate_methods
    for candidate_method in candidate_methods.iter do
        candidate_trait candidate candidate_method type_variable trait_bound_method_effect
        = candidate_effect
        for existing_bound in existing_bounds.iter do
            existing_bound.name parser
                .store
                .traits
                .get = existing_trait_opt
            if existing_trait_opt.is_none then
                continue
            fi
            existing_trait_opt.unwrap = existing_trait
            existing_trait parser.store semantics::collect_trait_methods = existing_methods
            for existing_method in existing_methods.iter do
                if existing_method.name candidate_method.name != then
                    continue
                fi
                existing_trait existing_bound existing_method type_variable trait_bound_method_effect
                = existing_effect
                if candidate_effect existing_effect stack_effect_shapes_equal ! then
                    false return
                fi
            done
        done
    done
    true
}

pub fn parse_type_variables parser:mut$Parser cursor:mut$TokenCursor -> ParsedTypeVariables {
    fallback_token parser.state "[" cursor expect_token_value.unwrap_or drop
    std::List[std::String]::new = vars
    std::Set[std::String]::new = seen
    std::Map[std::String std::List[common::TraitBound]]::new = trait_bounds
    std::Map[std::String common::BuiltinType]::new = const_params

    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            common::empty_location "Expected `]` to close type parameters" common::ErrorKind::Syntax parser.state.record_error
            parser.state.mark_output_unusable
            const_params trait_bounds vars ParsedTypeVariables return
        fi
        token_opt.unwrap = token
        if "]" token common::Token::value.as_str == then
            if 0 vars.length == then
                token common::Token::location "Empty type parameter list `[]` is not allowed" common::ErrorKind::Syntax parser.state.record_error
            fi
            const_params trait_bounds vars ParsedTypeVariables return
        fi
        if "," token common::Token::value.as_str == then
            continue
        fi
        # `const NAME:TYPE` binds a compile-time constant, not a type variable
        # (ADR-0152).
        if "const" token common::Token::value.as_str == then
            const_params seen vars parser cursor parse_const_type_parameter = const_params
            continue
        fi
        if common::TokenKind::Identifier token common::Token::kind == then
            if
                token common::Token::value.as_str parser
                    .store
                    .builtins
                    .has_str
            then
                token common::Token::location f"Type variable `{token common::Token::value.as_str}` shadows built-in type" common::ErrorKind::DuplicateName parser.state.record_error_string
            fi
            if token common::Token::value.as_str seen.has_str then
                token common::Token::location f"Duplicate type variable `{token common::Token::value.as_str}`" common::ErrorKind::DuplicateName parser.state.record_error_string
            fi
            token common::Token::value.clone vars.push
            token common::Token::value.clone seen.add
            # Check for trait bounds: K: Hashable + Display
            cursor.peek = colon_opt
            if colon_opt std::Option::Some(colon) is then
                if ":" colon common::Token::value.as_str == then
                    cursor.pop drop # consume :
                    std::List[common::TraitBound]::new = bounds
                    true = parse_bounds
                    while parse_bounds do
                        fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = trait_token
                        trait_token common::Token::value.clone = bound_trait_name
                        bound_trait_name parser
                            .store
                            .traits
                            .get = bound_trait_def_opt
                        if bound_trait_def_opt.is_none parser.syntax_only ! && then
                            trait_token common::Token::location f"Trait `{bound_trait_name}` is not defined" common::ErrorKind::UndefinedName parser.state.record_error_string
                        fi
                        parser.state trait_token cursor parse_bound_type_args = bound_args
                        if bound_trait_def_opt std::Option::Some(bound_trait_def) is then
                            bound_trait_def common::CasaTrait::type_params = declared_params: $std::List[std::String]
                            if bound_args.length declared_params.length != then
                                trait_token common::Token::location f"Trait `{bound_trait_name}` expects {declared_params.length} type argument(s), got {bound_args.length}" common::ErrorKind::Syntax parser.state.record_error_string
                            fi
                            bound_args bound_trait_name common::TraitBound = parsed_bound
                            false = duplicate_bound
                            for existing_bound in bounds.iter do
                                if parsed_bound existing_bound common::trait_bound_eq then
                                    true = duplicate_bound
                                fi
                            done
                            if duplicate_bound ! then
                                if parsed_bound bounds token.value.as_str parser bound_is_compatible ! then
                                    trait_token.location f"Bounds on `{token.value}` have incompatible requirements for the same method" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                                fi
                                parsed_bound bounds.push
                            fi
                        elif parser.syntax_only then
                            bound_args bound_trait_name common::TraitBound bounds.push
                        fi
                        cursor.peek = plus_opt
                        if plus_opt std::Option::Some(plus) is then
                            if "+" plus.value.as_str == then
                                cursor.pop drop
                            else
                                false = parse_bounds
                            fi
                        else
                            false = parse_bounds
                        fi
                    done
                    bounds token.value.clone trait_bounds.set
                fi
            fi
        else
            token common::Token::location "Unexpected token in type parameters" common::ErrorKind::UnexpectedToken parser.state.record_error
        fi
    done
    const_params trait_bounds vars ParsedTypeVariables
}
# Parse `const NAME:TYPE` (the `const` keyword already consumed). Adds NAME to
# `vars`/`seen` so it keeps its slot among the type parameters, and maps it to
# its declared type (ADR-0152).

pub fn parse_const_type_parameter
    cursor:mut$TokenCursor
    parser:mut$Parser
    vars:mut$std::List[std::String]
    seen:mut$std::Set[std::String]
    const_params:std::Map[std::String common::BuiltinType]
-> std::Map[std::String common::BuiltinType] {
    fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token
    if
        name_token common::Token::value.as_str parser
            .store
            .builtins
            .has_str
    then
        name_token common::Token::location f"Constant parameter `{name_token common::Token::value.as_str}` shadows built-in type" common::ErrorKind::DuplicateName parser.state.record_error_string
    fi
    if name_token common::Token::value.as_str seen.has_str then
        name_token common::Token::location f"Duplicate type variable `{name_token common::Token::value.as_str}`" common::ErrorKind::DuplicateName parser.state.record_error_string
    fi
    name_token common::Token::value.clone vars.push
    name_token common::Token::value.clone seen.add
    fallback_token parser.state ":" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = type_token
    type_token common::Token::value.as_str common::parse_builtin = builtin_opt
    if builtin_opt std::Option::Some(const_builtin) is then
        if const_builtin const_type_parameter_type_allowed ! then
            type_token common::Token::location f"Constant parameter `{name_token common::Token::value.as_str}` cannot have type `{type_token common::Token::value.as_str}`: only integer, `bool`, and `char` constants are allowed" common::ErrorKind::Syntax parser.state.record_error_string
        fi
        const_builtin name_token common::Token::value.clone const_params.set
        const_params return
    fi
    type_token common::Token::location f"Constant parameter `{name_token common::Token::value.as_str}` has unknown type `{type_token common::Token::value.as_str}`" common::ErrorKind::Syntax parser.state.record_error_string
    const_params
}
# Builtin types allowed as a constant parameter (ADR-0153): integer widths,
# `bool`, `char`. Float and `str` are rejected — neither can select an
# instantiation (ADR-0012 for floats).

pub fn const_type_parameter_type_allowed builtin:$common::BuiltinType -> bool {
    if builtin.is_integer then
        true return
    fi
    builtin common::BuiltinType::Bool == builtin common::BuiltinType::Char == ||
}
# Rewrite const-parameter names in a type from type variables to symbolic
# constants (ADR-0152). `parse_type_str` reads a one-letter name as `TypeVar`
# and a longer one as a bare `Generic`, so both forms are handled.

pub fn rewrite_type_const_params
    typ:$common::Type
    const_params:$std::Map[std::String common::BuiltinType]
-> common::Type {
    typ match
        common::Type::TypeVar(name) => {
            if name const_params.get_copy std::Option::Some(type_var_builtin) is then
                type_var_builtin name.clone common::ConstType::symbolic common::Type::Const
            else
                typ common::clone_type
            fi
        }
        common::Type::Generic(generic) => {
            if 0 generic.params.length == then
                if generic.base const_params.get_copy std::Option::Some(bare_builtin) is then
                    bare_builtin generic.base.clone common::ConstType::symbolic common::Type::Const return
                fi
                typ common::clone_type return
            fi
            std::List[common::Type]::new = new_params
            for param in generic.params.iter do
                const_params param rewrite_type_const_params new_params.push
            done
            new_params generic.base.clone common::GenericType common::Type::Generic
        }
        common::Type::Function(fn_type) => {
            std::List[common::Type]::new = new_params
            for param in fn_type.parameters.iter do
                const_params param rewrite_type_const_params new_params.push
            done
            std::List[common::Type]::new = new_returns
            for ret in fn_type.return_types.iter do
                const_params ret rewrite_type_const_params new_returns.push
            done
            new_returns new_params common::FunctionType common::Type::Function
        }
        _ => {
            typ common::clone_type
        }
    end
}
# Apply `rewrite_type_const_params` to every parameter and return type of a
# stack effect (ADR-0152).

pub fn rewrite_stack_effect_constant_parameters
    effect:mut$common::StackEffect
    constant_parameters:$std::Map[std::String common::BuiltinType]
{
    std::List[common::Parameter]::new = new_parameters
    for parameter in effect.parameters.iter do
        constant_parameters parameter.typ rewrite_type_const_params = rewritten_type
        parameter.name.clone rewritten_type common::Parameter new_parameters.push
    done
    std::List[common::Type]::new = new_return_types
    for return_type in effect.return_types.iter do
        constant_parameters return_type rewrite_type_const_params new_return_types.push
    done
    new_parameters effect common::StackEffect::set_parameters
    new_return_types effect common::StackEffect::set_return_types
}
# Rewrite constant-parameter names in a body's cast and hint types so they read
# as constants rather than unknown type names (ADR-0152).

pub fn rewrite_operation_constant_parameters
    operations:mut$std::List[common::Op]
    constant_parameters:$std::Map[std::String common::BuiltinType]
{
    if 0 constant_parameters.keys.length == then
        return
    fi
    std::Map[std::String common::Type]::new = substitutions
    for constant_name in constant_parameters.keys.iter do
        constant_name constant_parameters.get.unwrap constant_name.clone common::ConstType::symbolic common::Type::Const
        constant_name.clone substitutions.set
    done
    substitutions operations common::substitute_ops_types
}
# Register constant parameters as body variables. Concrete specializations
# replace their reads with literals before bytecode lowering.

pub fn inject_constant_parameters
    effect:mut$common::StackEffect
    variables:mut$std::List[common::Variable]
    location:common::Location
-> std::List[common::Op] {
    std::List[common::Op]::new = assignments
    effect.const_params = constant_parameters: $std::Map[std::String common::BuiltinType]
    if 0 constant_parameters.keys.length == then
        assignments return
    fi
    for constant_name in constant_parameters.keys.iter do
        constant_name constant_parameters.get.unwrap common::Type::Builtin = constant_type
        constant_type common::clone_type constant_name.clone common::Variable variables.push
    done
    assignments
}

# ============================================================================
# parse_parameters - parse name:type parameter pairs
# ============================================================================
# Given an identifier `token` just popped from `cursor`, produce either a
# named parameter (`name:type`) if the next token is `:`, or an unnamed
# parameter by rewinding and re-parsing as a type expression.

pub fn parse_parameter_maybe_named
    cursor:mut$TokenCursor
    token:$common::Token
    state:mut$ParseState
-> common::Parameter {
    cursor.peek = next_opt
    if { common::Token::value.as_str ":" == } next_opt.filter.is_some then
        cursor.advance # consume :
        state cursor parse_type_ast = param_type
        token common::Token::value.clone param_type common::Parameter::named return
    fi
    cursor.retreat
    "".to_str state cursor parse_type_ast common::Parameter::named
}

pub fn parse_parameters
    cursor:mut$TokenCursor
    state:mut$ParseState
-> std::List[common::Parameter] {
    std::List[common::Parameter]::new = params
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            common::empty_location "Unexpected end of input" common::ErrorKind::UnexpectedToken state.record_error
            state.mark_output_unusable
            params return
        fi
        token_opt.unwrap = token

        # Stop at -> or {
        if "->" token common::Token::value.as_str == "{" token common::Token::value.as_str == || then
            cursor.retreat
            params return
        fi

        # Allow fn keyword as unnamed parameter type
        if "fn" token common::Token::value.as_str == then
            cursor.retreat
            "".to_str state cursor parse_type_ast common::Parameter::named params.push
            continue
        fi

        if common::TokenKind::Identifier token common::Token::kind != then
            token common::Token::location "Unexpected token in parameter list" common::ErrorKind::UnexpectedToken state.record_error
        fi

        state token cursor parse_parameter_maybe_named params.push
    done
    params
}

# ============================================================================
# parse_return_types - parse return types after ->
# ============================================================================

pub fn parse_return_types cursor:mut$TokenCursor state:mut$ParseState -> std::List[common::Type] {
    std::List[common::Type]::new = types
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            common::empty_location "Unexpected end of input" common::ErrorKind::UnexpectedToken state.record_error
            state.mark_output_unusable
            types return
        fi
        if peek_opt std::Option::Some(peek) is then
            if "{" peek common::Token::value.as_str == then
                types return
            fi
        fi
        state cursor parse_type_ast types.push
    done
    types
}

# ============================================================================
# parse_stack_effect - parse function stack effect
# ============================================================================

pub fn parse_stack_effect cursor:mut$TokenCursor state:mut$ParseState -> common::StackEffect {
    state cursor parse_parameters = params
    std::List[common::Type]::new = returns

    cursor.peek = next_opt
    if next_opt.is_none then
        common::empty_location "Unexpected end of input" common::ErrorKind::UnexpectedToken state.record_error
        state.mark_output_unusable
        returns params common::StackEffect::new return
    fi
    if next_opt std::Option::Some(next) is then
        if "->" next common::Token::value.as_str == then
            cursor.advance # consume ->
            state cursor parse_return_types = returns
        fi
    fi
    returns params common::StackEffect::new
}

# ============================================================================
# parse_literal_to_constant_value - parse a raw literal string to ConstantValue
# ============================================================================

pub fn parse_literal_to_constant_value raw:$str -> common::ConstantValue {
    if "true" raw == then
        1 common::ConstantValue::Bool return
    fi
    if "false" raw == then
        0 common::ConstantValue::Bool return
    fi
    if '"' 0 raw.at == then
        raw 1 raw.length 2 - str::substring common::ConstantValue::Str return
    fi
    if raw char_literal_codepoint std::Option::Some(codepoint) is then
        codepoint common::ConstantValue::Char return
    fi
    if raw lexer::is_float_literal then
        raw.to_str common::ConstantValue::Float return
    fi
    raw parser::str_to_int raw.to_str common::IntegerLiteral::new common::ConstantValue::Int
}

# ============================================================================
# try_fold_const_fn_call - constant-fold a const fn call with all-literal args
# ============================================================================

pub fn is_const_fold_literal value:$common::OpValue -> bool {
    value common::OpValue::PushInt is
    value common::OpValue::PushFloat is ||
    value common::OpValue::PushStr is ||
    value common::OpValue::PushBool is ||
    value common::OpValue::PushChar is ||
}

pub fn try_fold_const_fn_call
    store:mut$common::SymbolStore
    ops:mut$std::List[common::Op]
    op_index:u64
    fn_name:$str
    location:$common::Location
    diagnostics:mut$error::Diagnostics
-> u64 {
    fn_name store.get_function = fold_fn_opt
    if fold_fn_opt.is_none then
        op_index return
    fi
    fold_fn_opt.unwrap = fold_fn
    if fold_fn common::Function::is_const_fn ! then
        op_index return
    fi
    for
        parameter in fold_fn
            .stack_effect
            .parameters
            .iter
    do
        if parameter.typ.has_unresolved_type_var parameter.typ.has_unresolved || then
            op_index return
        fi
    done
    for
        return_type in fold_fn
            .stack_effect
            .return_types
            .iter
    do
        if return_type.has_unresolved_type_var return_type.has_unresolved || then
            op_index return
        fi
    done
    fold_fn common::Function::stack_effect common::StackEffect::parameters.length = fold_param_count
    op_index 1 - = call_idx
    call_idx fold_param_count - = first_arg_idx
    if 0 first_arg_idx > then
        op_index return
    fi
    first_arg_idx = check_idx
    while check_idx call_idx > do
        check_idx ops.get common::Op::value common::clone_op_value = check_val
        if check_val is_const_fold_literal ! then
            op_index return
        fi
        1 += check_idx
    done
    std::List[common::ConstantValue]::new = fold_stack
    std::List[std::String]::new = fold_eval_stack
    first_arg_idx = load_idx
    while load_idx call_idx > do
        load_idx ops.get common::Op::value common::clone_op_value = load_val
        if load_val common::OpValue::PushInt(li) is then
            li.value li.raw.clone common::IntegerLiteral::new common::ConstantValue::Int fold_stack.push
        elif load_val common::OpValue::PushFloat(float_literal) is then
            float_literal.clone common::ConstantValue::Float fold_stack.push
        elif load_val common::OpValue::PushStr(ls) is then
            ls.clone common::ConstantValue::Str fold_stack.push
        elif load_val common::OpValue::PushBool(lb) is then
            lb common::ConstantValue::Bool fold_stack.push
        elif load_val common::OpValue::PushChar(lc) is then
            lc common::ConstantValue::Char fold_stack.push
        fi
        1 += load_idx
    done
    fn_name.clone = eval_name
    if diagnostics fold_eval_stack location fold_stack eval_name store eval_const_fn ! then
        op_index return
    fi
    fold_stack.pop = fold_result
    fold_result match
        common::ConstantValue::Int(ri) => {
            ri common::OpValue::PushInt first_arg_idx ops.get_mut common::Op::set_value
        }
        common::ConstantValue::Float(float_result) => {
            float_result common::OpValue::PushFloat first_arg_idx ops.get_mut common::Op::set_value
        }
        common::ConstantValue::Str(rs) => {
            rs common::OpValue::PushStr first_arg_idx ops.get_mut common::Op::set_value
        }
        common::ConstantValue::Bool(rb) => {
            rb common::OpValue::PushBool first_arg_idx ops.get_mut common::Op::set_value
        }
        common::ConstantValue::Char(rc) => {
            rc common::OpValue::PushChar first_arg_idx ops.get_mut common::Op::set_value
        }
    end
    if
        1 fold_fn
            .stack_effect
            .return_types
            .length ==
    then
        0 fold_fn
            .stack_effect
            .return_types
            .get common::clone_type std::Option::Some
        first_arg_idx ops.get_mut common::Op::set_type_hint
    fi
    first_arg_idx 1 + = shift_dst
    call_idx 1 + = shift_src
    while shift_src ops.length > do
        shift_src ops.get common::clone_op shift_dst ops.set
        1 += shift_src
        1 += shift_dst
    done
    0 (u64) = pop_count
    while pop_count fold_param_count > do
        ops.pop drop
        1 += pop_count
    done
    first_arg_idx 1 +
}

# ============================================================================
# validate_const_fn_body - ensure const fn body has no disallowed ops
# ============================================================================

pub fn validate_const_fn_body function:mut$common::Function diagnostics:mut$error::Diagnostics {
    for op in function common::Function::ops.iter do
        op common::Op::value = v: $common::OpValue
        if v common::OpValue::IfStart is then
            op common::Op::location "Control flow (`if`) is not allowed in const fn" common::ErrorKind::Syntax diagnostics.record_error
        fi
        if v common::OpValue::WhileStart is then
            op common::Op::location "Control flow (`while`) is not allowed in const fn" common::ErrorKind::Syntax diagnostics.record_error
        fi
        if v common::OpValue::DeclareGlobal is then
            op common::Op::location "Global access is not allowed in const fn" common::ErrorKind::Syntax diagnostics.record_error
        fi
    done
}

# ============================================================================
# eval_const_block - compile-time evaluation of const { ... } expressions
# ============================================================================

pub fn validate_constant_numeric
    value:$common::ConstantValue
    target:$common::Type
    location:$common::Location
    diagnostics:mut$error::Diagnostics
-> bool {
    value match
        common::ConstantValue::Int(literal) => {
            if target.is_integer_type_t ! then
                location f"Integer literal `{literal.raw}` requires an integer context, got `{target.format}`" common::ErrorKind::TypeMismatch diagnostics.record_error_string
                false return
            fi
            if target literal.fits ! then
                target.get_integer_min = minimum
                target.get_integer_max = maximum
                location f"Integer literal `{literal.raw}` is outside `{target.format}` range {minimum}..{maximum}" common::ErrorKind::TypeMismatch diagnostics.record_error_string
                false return
            fi
        }
        common::ConstantValue::Float(literal) => {
            if target.is_float_type_t ! then
                location f"Floating-point literal `{literal}` requires `f32` or `f64` context, got `{target.format}`" common::ErrorKind::TypeMismatch diagnostics.record_error_string
                false return
            fi
        }
        _ => {
        }
    end
    true
}

pub fn const_eval_apply_operator
    stack:mut$std::List[common::ConstantValue]
    operator_kind:common::OperatorKind
    location:$common::Location
    diagnostics:mut$error::Diagnostics
{
    if operator_kind common::OperatorKind::Not == then
        if 0 stack.length == then
            location "Stack underflow in const expression" common::ErrorKind::Syntax diagnostics.record_error
        fi
        stack.pop = a_val
        if a_val common::ConstantValue::Bool(a_bool) is then
            if 0 a_bool != then 0 else 1 fi common::ConstantValue::Bool stack.push
        elif a_val common::ConstantValue::Int(a_int) is then
            if diagnostics location common::make_i64_type a_val validate_constant_numeric ! then
                0 common::IntegerLiteral::from_int common::ConstantValue::Int stack.push
                return
            fi
            if 0 a_int.value != then 0 else 1 fi common::ConstantValue::Bool stack.push
        else
            location "Operator `!` requires bool or i64 operand" common::ErrorKind::Syntax diagnostics.record_error
        fi
        return
    fi
    if operator_kind common::OperatorKind::BitNot == then
        if 0 stack.length == then
            location "Stack underflow in const expression" common::ErrorKind::Syntax diagnostics.record_error
        fi
        stack.pop = bitnot_val
        if bitnot_val common::ConstantValue::Int(bitnot_int) is then
            if diagnostics location common::make_i64_type bitnot_val validate_constant_numeric ! then
                0 common::IntegerLiteral::from_int common::ConstantValue::Int stack.push
                return
            fi
            bitnot_int.value ~ common::IntegerLiteral::from_int common::ConstantValue::Int stack.push
        else
            location "Operator `~` requires i64 operand" common::ErrorKind::Syntax diagnostics.record_error
        fi
        return
    fi
    if 2 stack.length < then
        location "Stack underflow in const expression" common::ErrorKind::Syntax diagnostics.record_error
    fi
    stack.pop = b_val
    stack.pop = a_val
    if a_val common::ConstantValue::Int(a_int) is then
        if b_val common::ConstantValue::Int(b_int) is then
            if
                diagnostics location common::make_i64_type a_val validate_constant_numeric !
                diagnostics location common::make_i64_type b_val validate_constant_numeric ! ||
            then
                0 common::IntegerLiteral::from_int common::ConstantValue::Int stack.push
                return
            fi
            if operator_kind common::OperatorKind::Plus == then
                a_int.value b_int.value + common::IntegerLiteral::from_int common::ConstantValue::Int stack.push return
            fi
            if operator_kind common::OperatorKind::Minus == then
                a_int.value b_int.value - common::IntegerLiteral::from_int common::ConstantValue::Int stack.push return
            fi
            if operator_kind common::OperatorKind::Mul == then
                a_int.value b_int.value * common::IntegerLiteral::from_int common::ConstantValue::Int stack.push return
            fi
            if operator_kind common::OperatorKind::Div == then
                a_int.value b_int.value / common::IntegerLiteral::from_int common::ConstantValue::Int stack.push return
            fi
            if operator_kind common::OperatorKind::Mod == then
                a_int.value b_int.value % common::IntegerLiteral::from_int common::ConstantValue::Int stack.push return
            fi
            if operator_kind common::OperatorKind::Shl == then
                a_int.value b_int.value (u64) << common::IntegerLiteral::from_int common::ConstantValue::Int stack.push return
            fi
            if operator_kind common::OperatorKind::Shr == then
                a_int.value b_int.value (u64) >> common::IntegerLiteral::from_int common::ConstantValue::Int stack.push return
            fi
            if operator_kind common::OperatorKind::BitAnd == then
                a_int.value b_int.value & common::IntegerLiteral::from_int common::ConstantValue::Int stack.push return
            fi
            if operator_kind common::OperatorKind::BitOr == then
                a_int.value b_int.value | common::IntegerLiteral::from_int common::ConstantValue::Int stack.push return
            fi
            if operator_kind common::OperatorKind::BitXor == then
                a_int.value b_int.value ^ common::IntegerLiteral::from_int common::ConstantValue::Int stack.push return
            fi
            if operator_kind common::OperatorKind::Eq == then
                if a_int.value b_int.value == then 1 else 0 fi common::ConstantValue::Bool stack.push return
            fi
            if operator_kind common::OperatorKind::Ne == then
                if a_int.value b_int.value != then 1 else 0 fi common::ConstantValue::Bool stack.push return
            fi
            if operator_kind common::OperatorKind::Lt == then
                if a_int.value b_int.value < then 1 else 0 fi common::ConstantValue::Bool stack.push return
            fi
            if operator_kind common::OperatorKind::Le == then
                if a_int.value b_int.value <= then 1 else 0 fi common::ConstantValue::Bool stack.push return
            fi
            if operator_kind common::OperatorKind::Gt == then
                if a_int.value b_int.value > then 1 else 0 fi common::ConstantValue::Bool stack.push return
            fi
            if operator_kind common::OperatorKind::Ge == then
                if a_int.value b_int.value >= then 1 else 0 fi common::ConstantValue::Bool stack.push return
            fi
            location "Unsupported operator for i64 operands in const expression" common::ErrorKind::Syntax diagnostics.record_error
        fi
    fi
    if a_val common::ConstantValue::Bool(a_bool) is then
        if b_val common::ConstantValue::Bool(b_bool) is then
            if operator_kind common::OperatorKind::And == then
                if 0 a_bool != 0 b_bool != && then 1 else 0 fi common::ConstantValue::Bool stack.push return
            fi
            if operator_kind common::OperatorKind::Or == then
                if 0 a_bool != 0 b_bool != || then 1 else 0 fi common::ConstantValue::Bool stack.push return
            fi
            if operator_kind common::OperatorKind::Eq == then
                if a_bool b_bool == then 1 else 0 fi common::ConstantValue::Bool stack.push return
            fi
            if operator_kind common::OperatorKind::Ne == then
                if a_bool b_bool != then 1 else 0 fi common::ConstantValue::Bool stack.push return
            fi
            location "Unsupported operator for bool operands in const expression" common::ErrorKind::Syntax diagnostics.record_error
        fi
    fi
    location "Type mismatch in const expression" common::ErrorKind::Syntax diagnostics.record_error
}

pub fn eval_const_fn
    store:$common::SymbolStore
    fn_name:$str
    stack:mut$std::List[common::ConstantValue]
    location:$common::Location
    eval_stack:mut$std::List[std::String]
    diagnostics:mut$error::Diagnostics
-> bool {
    if fn_name eval_stack common::string_list_contains then
        location f"Cycle detected in const evaluation: `{fn_name}`" common::ErrorKind::Syntax diagnostics.record_error_string
        false return
    fi
    fn_name store.get_function = fn_opt
    if fn_opt.is_none then
        location f"`{fn_name}` is not a const fn" common::ErrorKind::Syntax diagnostics.record_error_string
        false return
    fi
    fn_opt.unwrap = function: $common::Function
    if function common::Function::is_const_fn ! then
        location f"`{fn_name}` is not a const fn" common::ErrorKind::Syntax diagnostics.record_error_string
        false return
    fi
    fn_name.clone eval_stack.push_str
    function common::Function::stack_effect common::StackEffect::parameters.length = param_count
    std::List[common::ConstantValue]::new = fn_stack
    std::Map[std::String common::ConstantValue]::new = locals
    if param_count stack.length < then
        location f"Not enough arguments for const fn `{fn_name}`" common::ErrorKind::Syntax diagnostics.record_error_string
        false return
    fi
    0 (u64) = pi
    while pi param_count > do
        stack.pop = argument
        pi function
            .stack_effect
            .parameters
            .get
            .typ = parameter_type: $common::Type
        if diagnostics location parameter_type argument validate_constant_numeric ! then
            false return
        fi
        argument fn_stack.push
        1 += pi
    done
    function common::Function::ops = fn_ops: $std::List[common::Op]
    0 (u64) = oi
    while oi fn_ops.length > do
        oi fn_ops.get = fn_op
        1 += oi
        fn_op common::Op::value common::clone_op_value = op_value
        if op_value common::OpValue::PushInt(push_int) is then
            push_int.value push_int.raw.clone common::IntegerLiteral::new common::ConstantValue::Int fn_stack.push
            continue
        fi
        if op_value common::OpValue::PushFloat(push_float) is then
            push_float.clone common::ConstantValue::Float fn_stack.push
            continue
        fi
        if op_value common::OpValue::PushStr(push_str) is then
            push_str.clone common::ConstantValue::Str fn_stack.push
            continue
        fi
        if op_value common::OpValue::PushBool(push_bool) is then
            push_bool common::ConstantValue::Bool fn_stack.push
            continue
        fi
        if op_value common::OpValue::PushChar(push_char) is then
            push_char common::ConstantValue::Char fn_stack.push
            continue
        fi
        op_value op_value_to_operator_kind = eval_op_kind_opt
        if eval_op_kind_opt std::Option::Some(eval_op_kind) is then
            diagnostics fn_op common::Op::location eval_op_kind fn_stack const_eval_apply_operator
            continue
        fi
        if op_value common::OpValue::FnReturn is then
            break
        fi
        if op_value common::OpValue::FnCall(call_name) is then
            if
                diagnostics eval_stack fn_op common::Op::location fn_stack call_name.as_str store eval_const_fn !
            then
                false return
            fi
            continue
        fi
        if op_value common::OpValue::AssignVar(assign_name) is then
            if 0 fn_stack.length != then
                fn_stack.pop assign_name.clone locals.set
            fi
            continue
        fi
        if op_value common::OpValue::PushVar(var_name) is then
            var_name.as_str locals.get_str = local_opt
            if local_opt std::Option::Some(local) is then
                local common::clone_constant_value fn_stack.push
                continue
            fi
            var_name.as_str store.constants.get_str = inner_const_opt
            if inner_const_opt std::Option::Some(inner_const) is then
                inner_const common::Constant::value common::clone_constant_value fn_stack.push
                continue
            fi
            fn_op common::Op::location f"Cannot use variable `{var_name}` in const fn evaluation" common::ErrorKind::Syntax diagnostics.record_error_string
            false return
        fi
        if op_value common::OpValue::Identifier(ident_name) is then
            ident_name.as_str locals.get_str = local_opt
            if local_opt std::Option::Some(local) is then
                local common::clone_constant_value fn_stack.push
                continue
            fi
            ident_name.as_str store.constants.get_str = inner_const_opt
            if inner_const_opt std::Option::Some(inner_const) is then
                inner_const common::Constant::value common::clone_constant_value fn_stack.push
                continue
            fi
            ident_name.as_str store.get_function = inner_fn_opt
            if inner_fn_opt std::Option::Some(inner_fn) is then
                if inner_fn common::Function::is_const_fn then
                    if
                        diagnostics eval_stack fn_op common::Op::location fn_stack ident_name.as_str store eval_const_fn !
                    then
                        false return
                    fi
                    continue
                fi
            fi
            fn_op common::Op::location f"Cannot use `{ident_name}` in const fn evaluation" common::ErrorKind::Syntax diagnostics.record_error_string
            false return
        fi
        fn_op common::Op::location "Unsupported operation in const fn" common::ErrorKind::Syntax diagnostics.record_error
        false return
    done
    eval_stack.pop drop
    if 0 fn_stack.length == then
        location f"Const fn `{fn_name}` produced no value" common::ErrorKind::Syntax diagnostics.record_error_string
        false return
    fi
    fn_stack.pop stack.push
    true
}

pub fn eval_const_block
    parser:mut$Parser
    cursor:mut$TokenCursor
    location:$common::Location
-> common::ConstantValue {
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop
    std::List[common::ConstantValue]::new = stack
    std::List[std::String]::new = eval_stack
    while true do
        cursor.pop = tok_opt
        if tok_opt.is_none then
            location "Unclosed const block expression" common::ErrorKind::Syntax parser.state.record_error
            parser.state.mark_output_unusable
            0 common::IntegerLiteral::from_int common::ConstantValue::Int return
        fi
        tok_opt.unwrap = tok
        if "}" tok common::Token::value.as_str == then
            break
        fi
        if common::TokenKind::Comment tok common::Token::kind == then
            continue
        fi
        if common::TokenKind::Newline tok common::Token::kind == then
            continue
        fi
        if common::TokenKind::Literal tok common::Token::kind == then
            tok common::Token::value.as_str parse_literal_to_constant_value stack.push
            continue
        fi
        if common::TokenKind::Operator tok common::Token::kind == then
            tok common::Token::value.as_str common::operator_from_str = op_kind_opt
            if op_kind_opt std::Option::Some(op_kind) is then
                parser.state.diagnostics tok common::Token::location op_kind stack const_eval_apply_operator
            fi
            continue
        fi
        if common::TokenKind::Identifier tok common::Token::kind == then
            tok common::Token::value.as_str = ident: $str
            ident parser
                .store
                .constants
                .get_str = c_opt
            if c_opt std::Option::Some(casa_const) is then
                casa_const common::Constant::value common::clone_constant_value stack.push
                continue
            fi
            ident parser.store.get_function = f_opt
            if f_opt std::Option::Some(function) is then
                if function common::Function::is_const_fn then
                    if
                        parser.state.diagnostics eval_stack tok common::Token::location stack ident parser.store eval_const_fn !
                    then
                        0 common::IntegerLiteral::from_int common::ConstantValue::Int return
                    fi
                    continue
                fi
            fi
            tok common::Token::location f"Cannot use `{ident}` in const block expression" common::ErrorKind::Syntax parser.state.record_error_string
        fi
        if common::TokenKind::Keyword tok common::Token::kind == then
            tok common::Token::location "Control flow is not allowed in const block expressions" common::ErrorKind::Syntax parser.state.record_error
        fi
        tok common::Token::location f"Unexpected token in const block expression: `{tok common::Token::value.as_str}`" common::ErrorKind::Syntax parser.state.record_error_string
    done
    if 0 stack.length == then
        location "Const block expression produced no value" common::ErrorKind::Syntax parser.state.record_error
        0 common::IntegerLiteral::from_int common::ConstantValue::Int return
    fi
    stack.pop
}

# ============================================================================
# parse_function - parse function definition
# ============================================================================

pub fn expect_function_name cursor:mut$TokenCursor state:mut$ParseState -> common::Token {
    if cursor.peek std::Option::Some(token) is then
        if "drop" token.value.as_str == then
            cursor.pop.unwrap return
        fi
    fi
    fallback_token state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or
}

pub fn parse_function parser:mut$Parser cursor:mut$TokenCursor -> common::Function {
    fallback_token parser.state "fn" cursor expect_token_value.unwrap_or = fn_token
    parser.state cursor expect_function_name = name_token

    # Parse optional type parameters
    std::List[std::String]::new = type_vars
    std::List[std::String]::new = generic_params
    std::Map[std::String std::List[common::TraitBound]]::new = trait_bounds
    std::Map[std::String common::BuiltinType]::new = const_params
    cursor.peek = tvars_opt
    if tvars_opt std::Option::Some(tvars) is then
        if "[" tvars common::Token::value.as_str == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.into_parts = const_params = trait_bounds = all_type_param_names
            all_type_param_names.clone = generic_params
            # `names` mixes type variables and const parameters; keep only the
            # type variables here (ADR-0152).
            for candidate_name in all_type_param_names.iter do
                if candidate_name const_params.has ! then
                    candidate_name.clone type_vars.push
                fi
            done
        fi
    fi

    parser.state cursor parse_stack_effect = effect

    # Rewrite signature const params to symbolic constants so unification treats
    # them as constants, not type variables (ADR-0152).
    if 0 const_params.keys.length != then
        const_params effect rewrite_stack_effect_constant_parameters
    fi

    # Add type vars to the stack effect
    if 0 type_vars.length != then
        for type_var in type_vars.iter do
            type_var.clone effect common::StackEffect::type_vars.add
        done
        trait_bounds effect common::StackEffect::set_trait_bounds
    fi
    type_vars common::string_list_to_set = function_type_vars
    function_type_vars effect common::canonicalize_stack_effect_type_vars
    std::List[common::Op]::new = ops
    std::List[common::Variable]::new = variables

    const_params effect common::StackEffect::set_const_params

    # Constant parameters are symbolic while this body is checked.
    name_token common::Token::location.clone variables effect inject_constant_parameters = constant_assignments
    constant_assignments ops.append

    # Register named parameters as variables and generate assign ops
    for parameter in effect.parameters.iter do
        if "" parameter.name.as_str != then
            parameter.typ common::clone_type parameter.name.clone common::Variable variables.push
            name_token.location parameter.name.clone common::OpValue::AssignVar common::Op::new ops.push
        fi
    done

    name_token common::Token::value.as_str cursor parser parse_block_ops = body_ops
    function_type_vars body_ops common::canonicalize_operation_type_vars
    effect.const_params body_ops rewrite_operation_constant_parameters
    body_ops ops.append

    if parser.syntax_only then
        cursor.previous_offset
        fn_token common::Token::location common::Location::span common::Span::offset
        SyntaxSpanKind::Definition parser.state.record_span
    fi

    effect name_token common::Token::location.clone ops name_token common::Token::value.clone common::Function::with_stack_effect = function
    generic_params function common::Function::set_generic_params
    variables function common::Function::set_variables
    function
}

# ============================================================================
# parse_enum - parse enum definition
# ============================================================================

pub fn parse_derived_traits cursor:mut$TokenCursor state:mut$ParseState -> std::List[std::String] {
    std::List[std::String]::new = derived_traits
    if cursor.peek std::Option::Some(token) is then
        if "derives" token.value.as_str != then
            derived_traits return
        fi
        cursor.pop drop
        while true do
            if cursor.peek std::Option::Some(derived) is then
                if "{" derived.value.as_str == then
                    break
                fi
                fallback_token state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or
                common::Token::value.clone derived_traits.push
            else
                break
            fi
        done
    fi
    derived_traits
}

pub fn parse_enum parser:mut$Parser cursor:mut$TokenCursor -> common::CasaEnum {
    fallback_token parser.state "enum" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    # Parse optional type parameters
    std::List[std::String]::new = type_vars
    cursor.peek = tvars_opt
    if tvars_opt std::Option::Some(tvars) is then
        if "[" tvars common::Token::value.as_str == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.into_parts = parsed_const_params = parsed_bounds = type_vars
            parsed_const_params drop
            parsed_bounds drop
        fi
    fi

    parser.state cursor parse_derived_traits = derived_traits

    fallback_token parser.state "{" cursor expect_token_value.unwrap_or = enum_open_token
    std::List[std::String]::new = variants
    std::Map[std::String std::List[common::Type]]::new = variant_types
    std::Map[std::String common::Location]::new = variant_locations

    while true do
        fallback_token parser.state cursor expect_token.unwrap_or = variant_token
        if "}" variant_token common::Token::value.as_str == then
            if parser.syntax_only then
                variant_token common::Token::location common::Location::span common::Span::offset
                enum_open_token common::Token::location common::Location::span common::Span::offset
                SyntaxSpanKind::EnumBody parser.state.record_span
            fi
            break
        fi
        if common::TokenKind::Identifier variant_token common::Token::kind != then
            variant_token common::Token::location "Expected variant name" common::ErrorKind::UnexpectedToken parser.state.record_error
        fi
        if variant_token common::Token::value.as_str variants common::string_list_contains then
            variant_token common::Token::location f"Duplicate variant `{variant_token common::Token::value.as_str}`" common::ErrorKind::DuplicateName parser.state.record_error_string
        fi
        variant_token common::Token::value.clone variants.push
        variant_token common::Token::location.clone variant_token common::Token::value.clone variant_locations.set

        # Parse optional inner types: Variant(type1 type2)
        std::List[common::Type]::new = inner_types
        cursor.peek = paren_opt
        if paren_opt std::Option::Some(paren) is then
            if "(" paren common::Token::value.as_str == then
                cursor.pop drop # consume (
                while true do
                    cursor.peek = inner_opt
                    if inner_opt.is_none then
                        variant_token common::Token::location "Unexpected end of input in variant inner types" common::ErrorKind::UnexpectedToken parser.state.record_error
                        parser.state.mark_output_unusable
                        break
                    fi
                    if inner_opt std::Option::Some(inner) is then
                        if ")" inner common::Token::value.as_str == then
                            cursor.pop drop # consume )
                            break
                        fi
                    fi
                    parser.state cursor parse_type_ast inner_types.push
                done
                if 0 inner_types.length == then
                    variant_token common::Token::location "Variant inner types cannot be empty" common::ErrorKind::Syntax parser.state.record_error
                fi
            fi
        fi
        inner_types variant_token common::Token::value.clone variant_types.set
    done

    if 0 variants.length == then
        name_token common::Token::location "Enum must have at least one variant" common::ErrorKind::Syntax parser.state.record_error
    fi

    type_vars common::string_list_to_set = tv_set
    for variant_name in variants.iter do
        variant_name variant_types.get_mut = vt_opt
        if vt_opt.is_some then
            vt_opt.unwrap = vt_inner
            0 (u64) = vt_index
            while vt_index vt_inner.length > do
                tv_set vt_index vt_inner.get common::clone_type common::canonicalize_type_var vt_index vt_inner.set
                1 += vt_index
            done
        fi
    done

    variant_locations derived_traits type_vars variant_types name_token common::Token::location.clone variants
    name_token common::Token::value.clone common::CasaEnum
}

# ============================================================================
# Auto-derive Hashable for payload-free enums (#141). Skips enums with inner
# values and any name the user already defined (silent override).
# ============================================================================

pub fn synthesize_hashable_for_enum parser:mut$Parser casa_enum:$common::CasaEnum {
    if casa_enum common::has_inner_values then
        return
    fi
    casa_enum common::CasaEnum::name.clone = enum_name
    casa_enum common::CasaEnum::location.clone = location

    f"{enum_name}::hash" = hash_name
    if
        hash_name.as_str parser
            .store
            .get_function
            .is_none
    then
        std::List[common::Op]::new = hash_ops
        location.clone common::make_i64_type common::clone_type common::OpValue::TypeCast common::Op::new hash_ops.push
        std::List[common::Parameter]::new = hash_params
        common::SHARED_BORROW_TYPE enum_name.clone common::GenericType::new common::Type::Generic
        common::apply_borrow_type common::Parameter::new hash_params.push
        std::List[common::Type]::new = hash_returns
        common::make_i64_type common::clone_type hash_returns.push
        hash_returns hash_params common::StackEffect::new = hash_stack_effect
        hash_stack_effect location.clone hash_ops hash_name.clone common::Function::with_stack_effect = hash_fn
        true = hash_fn.is_resolved
        hash_fn hash_name parser.put_function
    fi

    f"{enum_name}::eq" = eq_name
    if
        eq_name.as_str parser
            .store
            .get_function
            .is_none
    then
        std::List[common::Op]::new = eq_ops
        location.clone common::OpValue::Eq common::Op::new eq_ops.push
        std::List[common::Parameter]::new = eq_params
        common::SHARED_BORROW_TYPE enum_name.clone common::GenericType::new common::Type::Generic
        common::apply_borrow_type common::Parameter::new eq_params.push
        common::SHARED_BORROW_TYPE enum_name.clone common::GenericType::new common::Type::Generic
        common::apply_borrow_type common::Parameter::new eq_params.push
        std::List[common::Type]::new = eq_returns
        common::make_bool_type common::clone_type eq_returns.push
        eq_returns eq_params common::StackEffect::new = eq_stack_effect
        eq_stack_effect location.clone eq_ops eq_name.clone common::Function::with_stack_effect = eq_fn
        true = eq_fn.is_resolved
        eq_fn eq_name parser.put_function
    fi

    if
        common::STD_HASHABLE_TRAIT parser
            .store
            .traits
            .has_str
    then
        enum_name common::GenericType::new common::Type::Generic = receiver
        std::List[common::Type]::new common::STD_HASHABLE_TRAIT.to_str common::TraitBound = hashable_bound
        hashable_bound common::trait_bound_to_type = hashable_type
        if parser.store hashable_type receiver semantics::type_has_satisfying_trait_impl ! then
            location
            std::Map[std::String std::String]::new
            std::Map[std::String std::List[common::TraitBound]]::new
            std::List[std::String]::new
            hashable_bound
            receiver
            common::TraitImpl
            parser register_trait_impl
        fi
    fi
}

pub fn derive_hashable_for_enums parser:mut$Parser {
    for
        casa_enum in parser
            .store
            .enums
            .values
            .iter
    do
        casa_enum parser synthesize_hashable_for_enum
    done
}

pub fn register_derived_copy
    parser:mut$Parser
    name:$str
    type_vars:$std::List[std::String]
    required_type_vars:std::Set[std::String]
    location:$common::Location
{
    std::List[common::Type]::new = arguments
    for type_variable in type_vars.iter do
        type_variable.clone common::Type::TypeVar arguments.push
    done
    arguments name.to_str common::GenericType common::Type::Generic = receiver
    std::List[common::Type]::new common::STD_COPY_TRAIT.to_str common::TraitBound = copy_bound
    if
        parser.store copy_bound common::trait_bound_to_type receiver semantics::type_has_satisfying_trait_impl
    then
        return
    fi
    std::Map[std::String std::List[common::TraitBound]]::new = trait_bounds
    for type_variable in type_vars.iter do
        if type_variable required_type_vars.has ! then
            continue
        fi
        std::List[common::TraitBound]::new = type_bounds
        std::List[common::Type]::new common::STD_COPY_TRAIT.to_str common::TraitBound type_bounds.push
        type_bounds type_variable.clone trait_bounds.set
    done
    location.clone
    std::Map[std::String std::String]::new
    trait_bounds
    type_vars.clone
    copy_bound
    receiver
    common::TraitImpl
    parser register_trait_impl
}

pub fn derive_copy_for_aggregates parser:mut$Parser {
    for
        casa_struct in parser
            .store
            .structs
            .values
            .iter
    do
        for derived_trait in casa_struct.derived_traits.iter do
            if common::STD_COPY_TRAIT derived_trait.as_str == then
                std::Set[std::String]::new = required_type_vars
                for type_variable in casa_struct.type_vars.iter do
                    for member in casa_struct.members.iter do
                        if type_variable.as_str member.typ.type_contains_var then
                            type_variable.clone required_type_vars.add
                            break
                        fi
                    done
                done
                casa_struct.location required_type_vars casa_struct.type_vars casa_struct.name.as_str parser
                register_derived_copy
            else
                casa_struct.location f"Derivation for trait `{derived_trait}` is not supported" common::ErrorKind::InvalidScope parser.state.record_error_string
            fi
        done
    done
    for
        casa_enum in parser
            .store
            .enums
            .values
            .iter
    do
        for derived_trait in casa_enum.derived_traits.iter do
            if common::STD_COPY_TRAIT derived_trait.as_str == then
                std::Set[std::String]::new = required_type_vars
                for type_variable in casa_enum.type_vars.iter do
                    for pair in casa_enum.variant_types.iter do
                        for payload_type in pair.second.iter do
                            if type_variable.as_str payload_type.type_contains_var then
                                type_variable.clone required_type_vars.add
                            fi
                        done
                    done
                done
                casa_enum.location required_type_vars casa_enum.type_vars casa_enum.name.as_str parser
                register_derived_copy
            else
                casa_enum.location f"Derivation for trait `{derived_trait}` is not supported" common::ErrorKind::InvalidScope parser.state.record_error_string
            fi
        done
    done
}

pub fn register_builtin_copy_impls parser:mut$Parser {
    if
        common::STD_COPY_TRAIT parser
            .store
            .traits
            .has_str !
    then
        return
    fi
    parser
        .store
        .builtins
        .clone = builtin_names
    for builtin_name in builtin_names.iter do
        if "str" builtin_name.as_str == "array" builtin_name.as_str == || then
            continue
        fi
        builtin_name.as_str common::parse_type_str = receiver
        if parser.store common::STD_COPY_TRAIT receiver semantics::find_satisfying_trait_type.is_some then
            continue
        fi
        common::STD_COPY_TRAIT parser
            .store
            .traits
            .get_str
            .unwrap
            .location
            .clone
        std::Map[std::String std::String]::new
        std::Map[std::String std::List[common::TraitBound]]::new
        std::List[std::String]::new
        std::List[common::Type]::new common::STD_COPY_TRAIT.to_str common::TraitBound
        receiver
        common::TraitImpl
        parser register_trait_impl
    done
}

# ============================================================================
# _create_member_accessor - create getter/setter for struct members
# ============================================================================

pub fn create_member_accessor
    parser:mut$Parser
    struct_name:$str
    member_name:$str
    member_type:$common::Type
    prior_members:$std::List[common::Member]
    location:$common::Location
    type_vars:$std::List[std::String]
{
    if
        parser.store member_type prior_members common::next_struct_member_offset std::Option::Some(found_offset) is
    then
        found_offset
    else
        prior_members.length common::WORD_SIZE *
    fi
    = offset

    member_type common::get_concrete_array_length.is_some = is_fixed_array
    false = stores_inline
    if member_type.has_unresolved_type_var ! then
        if is_fixed_array then
            true = stores_inline
        elif
            parser.store member_type common::type_value_representation std::Option::Some(representation) is
        then
            common::VALUE_REPR_INDIRECT representation != = stores_inline
        fi
    fi

    # Parameterize the struct name when the struct has type vars
    std::List[common::Type]::new struct_name.to_str common::GenericType common::Type::Generic = param_type
    type_vars common::string_list_to_set = effect_type_vars
    if 0 type_vars.length != then
        type_vars struct_name common::build_parameterized_type = param_type
    fi

    # Getter
    f"{struct_name}::{member_name}" = getter_name
    std::List[common::Op]::new = getter_ops
    location.clone common::OpValue::UnsafeStart common::Op::new getter_ops.push
    location.clone common::make_ptr_type common::clone_type common::OpValue::TypeCast common::Op::new getter_ops.push
    location.clone offset (i64) common::make_integer_op_value common::Op::new getter_ops.push
    location.clone common::OpValue::Add common::Op::new getter_ops.push
    if stores_inline ! then
        location.clone common::OpValue::Load64 common::Op::new getter_ops.push
        location.clone member_type common::clone_type common::OpValue::TypeCast common::Op::new getter_ops.push
    elif is_fixed_array then
        location.clone member_type common::clone_type common::OpValue::PtrAsRef common::Op::new getter_ops.push
    else
        location.clone member_type common::clone_type common::OpValue::PtrRead common::Op::new getter_ops.push
    fi
    location.clone common::OpValue::UnsafeEnd common::Op::new getter_ops.push

    std::List[common::Parameter]::new = getter_params
    "".to_str common::SHARED_BORROW_TYPE param_type common::clone_type common::apply_borrow_type common::Parameter::named getter_params.push
    std::List[common::Type]::new = getter_returns
    member_type common::clone_type getter_returns.push
    getter_returns getter_params common::StackEffect::new = getter_stack_effect
    effect_type_vars.clone getter_stack_effect common::StackEffect::set_type_vars
    effect_type_vars getter_stack_effect common::canonicalize_stack_effect_type_vars
    getter_stack_effect location.clone getter_ops getter_name.clone
    common::Function::with_stack_effect = getter
    true getter common::Function::set_is_typechecked

    if
        getter_name.as_str parser
            .store
            .get_function
            .is_some
    then
        location f"Function `{getter_name}` is already defined" common::ErrorKind::DuplicateName parser.state.record_error_string
    fi
    getter getter_name parser.put_function

    # Setter
    f"{struct_name}::set_{member_name}" = setter_name
    std::List[common::Op]::new = setter_ops
    location.clone common::OpValue::UnsafeStart common::Op::new setter_ops.push
    location.clone common::make_ptr_type common::clone_type common::OpValue::TypeCast common::Op::new setter_ops.push
    location.clone offset (i64) common::make_integer_op_value common::Op::new setter_ops.push
    location.clone common::OpValue::Add common::Op::new setter_ops.push
    if stores_inline ! then
        location.clone common::OpValue::Swap common::Op::new setter_ops.push
        location.clone common::make_u64_type common::clone_type common::OpValue::TypeCast common::Op::new setter_ops.push
        location.clone common::OpValue::Swap common::Op::new setter_ops.push
        location.clone common::OpValue::Store64 common::Op::new setter_ops.push
    else
        location.clone member_type common::clone_type common::OpValue::PtrWrite common::Op::new setter_ops.push
    fi
    location.clone common::OpValue::UnsafeEnd common::Op::new setter_ops.push

    std::List[common::Parameter]::new = setter_params
    "".to_str common::EXCLUSIVE_BORROW_TYPE param_type common::clone_type common::apply_borrow_type common::Parameter::named setter_params.push
    "".to_str member_type common::clone_type common::Parameter::named setter_params.push
    std::List[common::Type]::new = setter_returns
    setter_returns setter_params common::StackEffect::new = setter_stack_effect
    effect_type_vars.clone setter_stack_effect common::StackEffect::set_type_vars
    effect_type_vars setter_stack_effect common::canonicalize_stack_effect_type_vars
    setter_stack_effect location.clone setter_ops setter_name.clone
    common::Function::with_stack_effect = setter
    true setter common::Function::set_is_typechecked

    if
        setter_name.as_str parser
            .store
            .get_function
            .is_some
    then
        location f"Function `{setter_name}` is already defined" common::ErrorKind::DuplicateName parser.state.record_error_string
    fi
    setter setter_name parser.put_function
}

# ============================================================================
# parse_struct - parse struct definition
# ============================================================================

pub fn parse_struct parser:mut$Parser cursor:mut$TokenCursor -> common::CasaStruct {
    fallback_token parser.state "struct" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    # Parse optional type parameters
    std::List[std::String]::new = type_vars
    cursor.peek = tvars_opt
    if tvars_opt std::Option::Some(tvars) is then
        if "[" tvars common::Token::value.as_str == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.into_parts = parsed_const_params = parsed_bounds = type_vars
            parsed_const_params drop
            # Trait bounds are not allowed on struct definitions
            if 0 parsed_bounds.keys.length != then
                name_token common::Token::location "Trait bounds are not allowed on struct definitions. Use `impl[K: Bound] StructName[K]` instead" common::ErrorKind::UnexpectedToken parser.state.record_error
            fi
        fi
    fi

    parser.state cursor parse_derived_traits = derived_traits

    std::List[common::Member]::new = members
    type_vars common::string_list_to_set = struct_type_vars
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or = struct_open_token

    while true do
        fallback_token parser.state cursor expect_token.unwrap_or = member_token
        if "}" member_token common::Token::value.as_str == then
            if parser.syntax_only then
                member_token common::Token::location common::Location::span common::Span::offset
                struct_open_token common::Token::location common::Location::span common::Span::offset
                SyntaxSpanKind::StructBody parser.state.record_span
            fi
            break
        fi
        false = member_is_public
        if "pub" member_token.value.as_str == then
            true = member_is_public
            fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = member_token
        fi
        if common::TokenKind::Identifier member_token common::Token::kind != then
            member_token common::Token::location "Expected member name" common::ErrorKind::UnexpectedToken parser.state.record_error
        fi
        fallback_token parser.state ":" cursor expect_token_value.unwrap_or drop
        parser.state cursor parse_type_ast = member_type
        struct_type_vars member_type common::canonicalize_type_var = member_type

        type_vars member_token common::Token::location members member_type member_token common::Token::value.as_str name_token common::Token::value.as_str parser create_member_accessor
        if member_is_public then
            f"{name_token.value}::{member_token.value}" = getter_name
            f"{name_token.value}::set_{member_token.value}" = setter_name
            getter_name.as_str parser
                .store
                .module_private_symbols
                .remove_str
            setter_name.as_str parser
                .store
                .module_private_symbols
                .remove_str
            getter_name parser
                .store
                .public_symbols
                .add
            setter_name parser
                .store
                .public_symbols
                .add
        fi
        member_type member_token common::Token::value.clone common::Member members.push
    done

    derived_traits type_vars name_token common::Token::location.clone members name_token common::Token::value.clone common::CasaStruct
}

# ============================================================================
# parse_trait - parse trait definition
# ============================================================================

pub fn parse_trait_method_stack_effect
    cursor:mut$TokenCursor
    state:mut$ParseState
-> common::StackEffect {
    std::List[common::Parameter]::new = params

    # Parse parameters, stopping at ->, fn, or }
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            break
        fi
        peek_opt.unwrap = peek
        if
            "->" peek common::Token::value.as_str ==
            "{" peek common::Token::value.as_str == ||
            "fn" peek common::Token::value.as_str == ||
            "}" peek common::Token::value.as_str == ||
        then
            break
        fi
        cursor.pop drop

        if
            common::TokenKind::Identifier peek common::Token::kind !=
            "fn" peek common::Token::value.as_str != &&
        then
            peek common::Token::location "Unexpected token in trait method parameter list" common::ErrorKind::UnexpectedToken state.record_error
        fi

        state peek cursor parse_parameter_maybe_named params.push
    done

    std::List[common::Type]::new = returns
    cursor.peek = arrow_opt
    if arrow_opt std::Option::Some(arrow) is then
        if "->" arrow common::Token::value.as_str == then
            cursor.pop drop # consume ->
            while true do
                cursor.peek = return_opt
                if return_opt.is_none then
                    break
                fi
                return_opt.unwrap = return_token
                if
                    "fn" return_token common::Token::value.as_str ==
                    "}" return_token common::Token::value.as_str == ||
                    "{" return_token common::Token::value.as_str == ||
                then
                    break
                fi
                state cursor parse_type_ast returns.push
            done
        fi
    fi

    returns params common::StackEffect::new
}
# Parse a bracket-delimited identifier-only type-parameter list:
# `[T1 T2 ...]`. `context` (e.g. "trait", "trait method") is interpolated
# into error messages. Does *not* accept trait bounds; for those use
# `parse_type_variables`.

pub fn parse_simple_type_vars
    cursor:mut$TokenCursor
    context:str
    state:mut$ParseState
-> std::List[std::String] {
    cursor.pop drop # consume [
    std::List[std::String]::new = collected
    true = loop_flag
    while loop_flag do
        cursor.peek = token_opt
        if token_opt.is_none then
            common::empty_location f"Unclosed {context} type parameter list" common::ErrorKind::UnmatchedBlock state.record_error_string
            state.mark_output_unusable
            false = loop_flag
        else
            token_opt.unwrap = token
            if "]" token common::Token::value.as_str == then
                cursor.pop drop
                false = loop_flag
            elif common::TokenKind::Identifier token common::Token::kind != then
                token common::Token::location f"Expected type parameter identifier in {context}" common::ErrorKind::UnexpectedToken state.record_error_string
                false = loop_flag
            else
                cursor.pop drop
                token common::Token::value.clone collected.push
            fi
        fi
    done
    collected
}

pub fn parse_trait parser:mut$Parser cursor:mut$TokenCursor -> common::CasaTrait {
    fallback_token parser.state "trait" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    std::List[std::String]::new = type_params
    cursor.peek = bracket_opt
    if { common::Token::value.as_str "[" == } bracket_opt.filter.is_some then
        parser.state "trait" cursor parse_simple_type_vars = type_params
    fi

    std::List[common::TraitBound]::new = supertraits
    cursor.peek = colon_opt
    if { common::Token::value.as_str ":" == } colon_opt.filter.is_some then
        cursor.pop drop
        true = parse_super_loop
        while parse_super_loop do
            fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = super_token
            super_token common::Token::value.clone = super_name
            super_name parser
                .store
                .traits
                .get = super_def_opt
            parser.state super_token cursor parse_bound_type_args = super_args
            if super_def_opt std::Option::Some(super_def) is then
                super_def common::CasaTrait::type_params = super_params: $std::List[std::String]
                if super_args.length super_params.length != then
                    super_token common::Token::location f"Supertrait `{super_name}` expects {super_params.length} type argument(s), got {super_args.length}" common::ErrorKind::Syntax parser.state.record_error_string
                fi
            fi
            super_args super_name common::TraitBound supertraits.push
            cursor.peek = plus_opt
            if { common::Token::value.as_str "+" == } plus_opt.filter.is_some then
                cursor.pop drop
            else
                false = parse_super_loop
            fi
        done
    fi

    std::List[common::TraitMethod]::new = methods
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop

    true = parse_trait_loop
    while parse_trait_loop do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token common::Token::location "Unclosed trait block" common::ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            false = parse_trait_loop
        elif next_opt std::Option::Some(next) is then
            if "}" next common::Token::value.as_str == then
                cursor.pop drop
                false = parse_trait_loop
            elif "fn" next common::Token::value.as_str != then
                next common::Token::location "Expected method declaration in trait" common::ErrorKind::UnexpectedToken parser.state.record_error
                false = parse_trait_loop
            else
                next common::Token::location common::Location::span common::Span::offset = trait_fn_offset
                cursor.pop drop # consume fn
                parser.state cursor expect_function_name = method_name
                if "drop" method_name common::Token::value.as_str == then
                    method_name common::Token::location "`drop` is reserved for inherent cleanup methods" common::ErrorKind::InvalidScope parser.state.record_error
                fi

                # Parse optional method-level type parameters (e.g., fn map[U])
                std::List[std::String]::new = method_type_vars
                if cursor.peek std::Option::Some(mtv_bracket) is then
                    if "[" mtv_bracket common::Token::value.as_str == then
                        parser.state "trait method" cursor parse_simple_type_vars = method_type_vars
                    fi
                fi

                parser.state cursor parse_trait_method_stack_effect = method_stack_effect

                type_params common::string_list_to_set = trait_tv_set
                common::TRAIT_SELF_TYPE trait_tv_set.add_str
                for mtv in method_type_vars.iter do
                    mtv.clone trait_tv_set.add
                done
                trait_tv_set method_stack_effect common::canonicalize_stack_effect_type_vars

                # Parse optional default method body
                std::List[common::Op]::new = default_ops
                if cursor.peek std::Option::Some(body_peek) is then
                    if "{" body_peek common::Token::value.as_str == then
                        f"{name_token common::Token::value.as_str}::{method_name common::Token::value.as_str}" = default_name
                        default_name.as_str cursor parser parse_block_ops = default_ops
                        trait_tv_set default_ops common::canonicalize_operation_type_vars
                        if parser.syntax_only then
                            cursor.previous_offset
                            trait_fn_offset
                            SyntaxSpanKind::Definition parser.state.record_span
                        fi
                    fi
                fi

                method_type_vars false std::List[common::Variable]::new default_ops method_stack_effect method_name common::Token::value.clone common::TraitMethod methods.push
            fi
        else
            false = parse_trait_loop
        fi
    done

    name_token common::Token::location.clone supertraits methods type_params name_token common::Token::value.clone common::CasaTrait
}

# ============================================================================
# parse_impl_block - parse impl Type { fn methods... }
# ============================================================================

pub fn inject_implementation_parameters
    parser:mut$Parser
    function:mut$common::Function
    type_vars:$std::List[std::String]
    generic_params:$std::List[std::String]
    trait_bounds:$std::Map[std::String std::List[common::TraitBound]]
    constant_parameters:$std::Map[std::String common::BuiltinType]
{
    function.stack_effect common::clone_stack_effect = effect
    std::List[std::String]::new = combined_generic_params
    for parameter_name in generic_params.iter do
        parameter_name.clone combined_generic_params.push
    done
    for parameter_name in function.generic_params.iter do
        parameter_name.clone combined_generic_params.push
    done
    combined_generic_params function common::Function::set_generic_params

    # Merge the impl block's constant parameters (ADR-0152) and rewrite the
    # method declaration and body so their names read as constants, not type
    # variables.
    if 0 constant_parameters.keys.length != then
        constant_parameters effect rewrite_stack_effect_constant_parameters
        constant_parameters function.ops rewrite_operation_constant_parameters
        0 (u64) = variable_index
        while variable_index function.variables.length > do
            variable_index function.variables.get_mut = variable
            constant_parameters variable.typ rewrite_type_const_params = rewritten_variable_type
            rewritten_variable_type variable common::Variable::set_typ
            1 += variable_index
        done
        for constant_pair in constant_parameters.iter do
            constant_pair.second.clone constant_pair.first.clone effect.const_params.set
        done
    fi

    # Merge type vars into function stack effect
    for type_var in type_vars.iter do
        if type_var effect.type_vars.has ! then
            type_var.clone effect.type_vars.add
        fi
    done
    effect.type_vars.clone = active_impl_type_vars
    active_impl_type_vars effect common::canonicalize_stack_effect_type_vars
    active_impl_type_vars function.ops common::canonicalize_operation_type_vars
    0 (u64) = variable_index
    while variable_index function.variables.length > do
        variable_index function.variables.get common::clone_variable = variable
        active_impl_type_vars variable.typ common::canonicalize_type_var = variable_type
        variable_type variable common::Variable::set_typ
        variable variable_index function.variables.set
        1 += variable_index
    done

    # Merge trait bounds
    trait_bounds.keys = bound_keys
    for bound_key in bound_keys.iter do
        if bound_key trait_bounds.get std::Option::Some(bounds) is then
            bounds.clone bound_key.clone effect.trait_bounds.set
        fi
    done

    0 (u64) = insert_pos
    # Register the implementation's symbolic constant parameters.
    function.location.clone function.variables effect inject_constant_parameters = constant_assignments
    while 0 constant_assignments.length != do
        constant_assignments.pop = assignment
        insert_pos assignment function.ops.insert
    done

    effect function common::Function::set_stack_effect
}

pub fn namespace_trait_impl_type
    typ:$common::Type
    type_vars:$std::List[std::String]
    prefix:str
-> common::Type {
    std::Map[std::String common::Type]::new = substitutions
    for type_variable in type_vars.iter do
        f"{prefix}{type_variable}" common::Type::TypeVar type_variable.clone substitutions.set
    done
    substitutions typ.substitute_t
}

pub fn resolve_overlap_type
    typ:$common::Type
    bindings:$std::Map[std::String common::Type]
-> common::Type {
    if typ common::Type::TypeVar(type_variable) is then
        if type_variable bindings.get std::Option::Some(bound) is then
            bindings bound resolve_overlap_type return
        fi
    fi
    typ common::clone_type
}

pub fn overlap_type_contains
    type_variable:$str
    typ:$common::Type
    bindings:mut$std::Map[std::String common::Type]
-> bool {
    bindings typ resolve_overlap_type = resolved
    if resolved common::Type::TypeVar(name) is then
        type_variable name.as_str == return
    fi
    if resolved common::Type::Generic(generic) is then
        for parameter in generic.params.iter do
            if bindings parameter type_variable overlap_type_contains then
                true return
            fi
        done
    elif resolved common::Type::Function(function_type) is then
        for parameter in function_type.parameters.iter do
            if bindings parameter type_variable overlap_type_contains then
                true return
            fi
        done
        for return_type in function_type.return_types.iter do
            if bindings return_type type_variable overlap_type_contains then
                true return
            fi
        done
    fi
    false
}

pub fn bind_overlap_type
    type_variable:$str
    typ:$common::Type
    bindings:mut$std::Map[std::String common::Type]
-> bool {
    bindings typ resolve_overlap_type = resolved
    if resolved common::Type::TypeVar(name) is then
        if type_variable name.as_str == then
            true return
        fi
    fi
    if bindings resolved type_variable overlap_type_contains then
        false return
    fi
    resolved type_variable.clone bindings.set_str
    true
}

pub fn unify_trait_impl_types
    first:$common::Type
    second:common::Type
    bindings:mut$std::Map[std::String common::Type]
-> bool {
    bindings first resolve_overlap_type = resolved_first
    bindings second resolve_overlap_type = resolved_second
    if resolved_first common::Type::TypeVar(first_variable) is then
        bindings resolved_second first_variable.as_str bind_overlap_type return
    fi
    if resolved_second common::Type::TypeVar(second_variable) is then
        bindings resolved_first second_variable.as_str bind_overlap_type return
    fi
    if resolved_first common::Type::Generic(first_generic) is then
        if resolved_second common::Type::Generic(second_generic) is then
            if first_generic.base second_generic.base != then
                false return
            fi
            if first_generic.params.length second_generic.params.length != then
                false return
            fi
            for
                pair in second_generic.params.iter first_generic
                    .params
                    .iter
                    .zip
            do
                if
                    bindings pair.first common::clone_type pair.second common::clone_type unify_trait_impl_types !
                then
                    false return
                fi
            done
            true return
        fi
        false return
    fi
    if resolved_first common::Type::Function(first_function) is then
        if resolved_second common::Type::Function(second_function) is then
            if first_function.parameters.length second_function.parameters.length != then
                false return
            fi
            if first_function.return_types.length second_function.return_types.length != then
                false return
            fi
            for
                pair in second_function.parameters.iter first_function
                    .parameters
                    .iter
                    .zip
            do
                if
                    bindings pair.first common::clone_type pair.second common::clone_type unify_trait_impl_types !
                then
                    false return
                fi
            done
            for
                pair in second_function.return_types.iter first_function
                    .return_types
                    .iter
                    .zip
            do
                if
                    bindings pair.first common::clone_type pair.second common::clone_type unify_trait_impl_types !
                then
                    false return
                fi
            done
            true return
        fi
        false return
    fi
    resolved_first resolved_second.eq
}

pub fn trait_impls_overlap first:$common::TraitImpl second:$common::TraitImpl -> bool {
    if first.trait_bound.name second.trait_bound.name != then
        false return
    fi
    if
        first
            .trait_bound
            .type_args
            .length second
            .trait_bound
            .type_args
            .length !=
    then
        false return
    fi
    "left:" first.type_vars first.receiver namespace_trait_impl_type = first_receiver
    "right:" second.type_vars second.receiver namespace_trait_impl_type = second_receiver
    std::Map[std::String common::Type]::new = bindings
    if bindings second_receiver first_receiver unify_trait_impl_types ! then
        false return
    fi
    for
        pair in second
            .trait_bound
            .type_args
            .iter first
            .trait_bound
            .type_args
            .iter
            .zip
    do
        "left:" first.type_vars pair.second namespace_trait_impl_type = first_argument
        "right:" second.type_vars pair.first namespace_trait_impl_type = second_argument
        if bindings second_argument first_argument unify_trait_impl_types ! then
            false return
        fi
    done
    true
}

pub fn receiver_is_local
    receiver:$common::Type
    location:$common::Location
    store:mut$common::SymbolStore
-> bool {
    receiver.match_base = receiver_name
    if receiver_name store.structs.get std::Option::Some(casa_struct) is then
        casa_struct.location.file location.file == return
    fi
    if receiver_name store.enums.get std::Option::Some(casa_enum) is then
        casa_enum.location.file location.file == return
    fi
    false
}

pub fn register_trait_impl parser:mut$Parser trait_impl:common::TraitImpl {
    for
        pair in parser
            .store
            .trait_impls
            .iter
    do
        pair.second = existing: $common::TraitImpl
        if trait_impl existing trait_impls_overlap then
            trait_impl.location f"Trait implementation `{trait_impl common::trait_impl_key}` overlaps an existing implementation in `{existing.location.file}`" common::ErrorKind::DuplicateName parser.state.record_error_string
            return
        fi
    done
    trait_impl common::trait_impl_key = key
    trait_impl key parser.put_trait_impl
}

pub fn normalize_trait_method_effect
    candidate:$semantics::TraitMethodCandidate
-> common::StackEffect {
    std::Map[std::String common::Type]::new = substitutions
