    true = valid
    for required_name in required.iter do
        false = found
        for candidate in candidates.iter do
            if required_name candidate.method.name != then
                continue
            fi
            true = found
            required_name.as_str trait_name.as_str language_trait_method_kind = method_kind
            method_kind language_trait_method_role = method_role
            if casa_trait method_kind candidate language_trait_method_matches ! then
                casa_trait.location f"Language trait `{trait_name}` has incompatible `{required_name}` {method_role}" ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                false = valid
            fi
        done
        if found ! then
            required_name.as_str trait_name.as_str language_trait_method_kind language_trait_method_role = method_role
            casa_trait.location f"Language trait `{trait_name}` is missing required `{required_name}` {method_role}" ErrorKind::TraitSignatureMismatch parser.state.record_error_string
            false = valid
        fi
    done
    for candidate in candidates.iter do
        if
            0 candidate
                .method
                .default_ops
                .length !=
        then
            continue
        fi
        if candidate.trait_type trait_type.eq ! then
            continue
        fi
        candidate
            .method
            .name
            .as_str trait_name.as_str language_trait_method_kind = method_kind
        if 0 method_kind == then
            casa_trait.location f"Language trait `{trait_name}` cannot add bodyless `{candidate.method.name}` requirement" ErrorKind::TraitSignatureMismatch parser.state.record_error_string
            false = valid
        fi
    done
