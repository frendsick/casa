            continue
        fi

        if current_op.value OpValue::FnPush(fn_name_ref) is then
            fn_name_ref.clone = fn_name
            fn_name store.functions.remove = lambda_opt
            lambda_opt match
                Option::Some(lambda) => {
                    true lambda Function::set_is_used
                    function lambda store gather_captures
                    lambda.split_body = lambda_ops = lambda
                    lambda.clone_declaration fn_name.clone store.functions.set
                    diagnostics lambda lambda_ops store resolve_identifiers
                    lambda_ops lambda Function::set_ops
                    lambda fn_name.clone store.functions.set
                }
                Option::None => {
                }
            end
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value OpValue::PushArray(items_inner) is then
            items_inner clone_ops = owned_items_inner
            diagnostics resolve_errors function owned_items_inner store resolve_array_identifiers
            owned_items_inner OpValue::PushArray current_op Op::set_value
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value OpValue::ExprGroup(group_inner) is then
            group_inner clone_ops = owned_group_inner
            diagnostics function owned_group_inner store resolve_identifiers
            owned_group_inner OpValue::ExprGroup current_op Op::set_value
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value OpValue::Identifier(ident_ref) is then
            ident_ref.clone = ident
            if resolve_errors ident.as_str current_op function store try_resolve_fn_ref then
                current_op op_index 1 - ops.set
                continue
            fi
            if ident.as_str current_op try_resolve_numeric_call then
                current_op op_index 1 - ops.set
                continue
            fi
            if ident.as_str current_op function try_resolve_trait_method_call then
                current_op op_index 1 - ops.set
                continue
            fi
            if resolve_errors ident.as_str current_op store try_resolve_enum_variant_ident then
                current_op op_index 1 - ops.set
                continue
            fi
            if ident.as_str current_op store try_resolve_qualified_trait_method then
                current_op op_index 1 - ops.set
                continue
            fi
            if ident.as_str current_op store try_resolve_type_qualified_method then
                current_op op_index 1 - ops.set
                continue
            fi
            resolve_errors ident.as_str current_op function store resolve_plain_identifier
            if current_op.value OpValue::FnCall(resolved_fn_name) is then
                current_op.location.clone = fold_location
                resolved_fn_name.clone = fold_function_name
                current_op op_index 1 - ops.set
                diagnostics fold_location fold_function_name.as_str op_index ops store try_fold_const_fn_call = op_index
                continue
            fi
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value OpValue::MatchArm is then
            diagnostics resolve_errors current_op function store resolve_match_op
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value OpValue::IsCheck(is_enum_variant) is then
            is_enum_variant.clone = resolved_variant
            resolve_errors function current_op resolved_variant store resolve_enum_variant
            resolved_variant OpValue::IsCheck current_op Op::set_value
            current_op op_index 1 - ops.set
            continue
        fi
        current_op op_index 1 - ops.set
    done

    resolve_errors.reverse
    while resolve_errors.is_empty ! do
        resolve_errors.pop diagnostics.push_error
    done
}
# Try resolving compiler-owned numeric associated conversion calls.

fn try_resolve_numeric_call op:mut$Op ident:$str -> bool {
    ident "::" str::find = separator
    if separator 0 <= ! then
        false return
    fi
    ident 0 separator (u64) str::substring = target_name
    target_name.as_str parse_builtin = target_opt
    if target_opt.is_none then
        false return
    fi
    ident separator 2 + (u64) ident.length separator (u64) - 2 - str::substring = method
    if
        "from" method.as_str ==
        "from_bits" method.as_str == ||
        "round_from" method.as_str == ||
        "trunc_from" method.as_str == ||
        "wrapping_from" method.as_str == ||
        "from_codepoint_unchecked" method.as_str == ||
        "__from_decimal_parts" method.as_str == ||
        "__float_significand" method.as_str == ||
        "try_from" method.as_str == || !
    then
        false return
    fi
    target_opt.unwrap method NumericCall OpValue::NumericCall op Op::set_value
    true
}
# resolve_match_op — per-arm identifier resolution entry point.
# Registers struct-pattern field bindings as locals/globals and resolves
# enum-variant ordinals (delegating to resolve_enum_variant). Literal and
# wildcard arms need no resolution.

fn register_struct_pattern_binding store:mut$SymbolStore function:mut$Function binding_name:$str {
    binding_name Variable::new = match_struct_variant
    if GLOBAL_SCOPE_LABEL function Function::name.as_str == then
        match_struct_variant binding_name.clone store.variables.set_str
    else
        if binding_name function Function::variables variable_list_contains ! then
            match_struct_variant function Function::variables.push
        fi
    fi
}

impl Op {
    fn set_match_pattern_value self:mut$Op pattern_value:PatternValue {
        if self.value OpValue::MatchArm(arm) is then
            arm.clone = updated_arm
            pattern_value updated_arm MatchArm::set_pattern_value
            updated_arm OpValue::MatchArm self.set_value
        fi
    }
}

fn resolve_match_op
    store:mut$SymbolStore
    function:mut$Function
    op:mut$Op
    errors:mut$List[CasaError]
    diagnostics:mut$Diagnostics
{
    op pattern_value_of match
        PatternValue::Struct(struct_pattern) => {
            struct_pattern.bindings.keys = pattern_keys
            for pattern_key in pattern_keys.iter do
                pattern_key struct_pattern
                    .bindings
                    .get
                    .unwrap = binding_name
                binding_name.as_str function store register_struct_pattern_binding
            done
        }
        PatternValue::EnumVariant(variant) => {
            errors function op variant store resolve_enum_variant
            variant PatternValue::EnumVariant op.set_match_pattern_value
        }
        PatternValue::Literal => {
        }
    end
    if op.value OpValue::MatchArm(arm) is then
        if arm.guard_ops.length 0 != then
            arm.clone = resolved_arm
            diagnostics function resolved_arm.guard_ops store resolve_identifiers
            resolved_arm OpValue::MatchArm op Op::set_value
        fi
    fi
}
# Try resolving `&name` and `&K::method` function references. Returns true
# if the identifier begins with `&`, in which case the op has been rewritten
# (or an error pushed) and the caller should skip further resolution.

fn try_resolve_fn_ref
    store:mut$SymbolStore
    function:mut$Function
    op:mut$Op
    ident:$str
    resolve_errors:mut$List[CasaError]
-> bool {
    if '&' 0 ident.at != then
        false return
    fi
    ident 1 ident.length 1 - str::substring = ref_name
    if 0 ref_name.length == then
        op Op::location.clone "Expected function name after `&`".to_str ErrorKind::Syntax CasaError::new resolve_errors.push
        true return
    fi
    ref_name.as_str "::" str::split = ref_parts
    if 2 ref_parts.length == "drop" ref_parts.length 1 - ref_parts.get.as_str == && then
        op Op::location.clone "Reserved `drop` methods cannot be referenced".to_str ErrorKind::InvalidScope CasaError::new resolve_errors.push
        true return
    fi
    if 3 ref_parts.length == then
        0 ref_parts.get.as_str parse_type_str = receiver_type
        1 ref_parts.get.clone GenericType::new Type::Generic = qualifier_type
        if op.type_hint Option::Some(hint) is then
            if hint.type_params Option::Some(type_arguments) is then
                type_arguments.clone 1 ref_parts.get.clone GenericType Type::Generic = qualifier_type
            fi
        fi
        2 ref_parts.get = method_name
        store receiver_type qualifier_type method_name.as_str resolve_qualified_method_semantics
        = method_opt
        if method_opt Option::Some(method) is then
            if method.function_name.as_str store.is_function_unsafe Option::Some(is_unsafe) is then
                if is_unsafe then
                    op Op::location.clone f"Unsafe function `{method.function_name}` cannot be referenced" ErrorKind::InvalidScope CasaError::new resolve_errors.push
                    true return
                fi
                method.function_name.clone OpValue::FnPush op Op::set_value
                method.function_name.as_str store mark_function_used
                true return
            fi
        fi
    fi
    if ref_name.as_str "::" str::find 0 <= then
        ref_name.as_str 0 ref_name.as_str "::" str::find(u64) str::substring = ref_type_var
        ref_type_var.as_str function Function::stack_effect StackEffect::trait_bounds.get_str = ref_bound_opt
        if ref_bound_opt.is_some then
            ref_name.as_str ref_name.as_str "::" str::find 2 + (u64) ref_name.length ref_name.as_str "::" str::find(u64) - 2 - str::substring = ref_trait_method
            f"__trait_{ref_type_var}_{ref_trait_method}" = ref_hidden
            ref_hidden OpValue::PushVar op Op::set_value
            true return
        fi
    fi
    if 2 ref_parts.length == then
        0 ref_parts.get.as_str parse_type_str = receiver_type
        1 ref_parts.get = method_name
        store Option[Function]::None receiver_type method_name.as_str resolve_method_semantics
        = method_opt
        if method_opt Option::Some(method) is then
            if method.function_name.as_str store.is_function_unsafe Option::Some(is_unsafe) is then
                if is_unsafe then
                    op Op::location.clone f"Unsafe function `{method.function_name}` cannot be referenced" ErrorKind::InvalidScope CasaError::new resolve_errors.push
                    true return
                fi
                method.function_name.clone OpValue::FnPush op Op::set_value
                method.function_name.as_str store mark_function_used
                true return
            fi
        fi
    fi
    ref_name.as_str store.is_function_unsafe = ref_is_unsafe_opt
    if ref_is_unsafe_opt Option::Some(ref_is_unsafe) is then
        if ref_is_unsafe then
            op Op::location.clone f"Unsafe function `{ref_name}` cannot be referenced" ErrorKind::InvalidScope CasaError::new resolve_errors.push
            true return
        fi
        ref_name.clone OpValue::FnPush op Op::set_value
        ref_name.as_str store mark_function_used
    else
        op Op::location.clone f"Function `{ref_name}` is not defined" ErrorKind::UndefinedName CasaError::new resolve_errors.push
    fi
    true
}
# Try resolving `Enum::Variant` identifiers. Returns true if the enum is
# known (op rewritten, or undefined-variant error pushed).

fn try_resolve_enum_variant_ident
    store:mut$SymbolStore
    op:mut$Op
    ident:$str
    resolve_errors:mut$List[CasaError]
-> bool {
    if ident "::" str::find 0 <= ! then
        false return
    fi
    ident "::" str::find = separator
    ident 0 separator (u64) str::substring = enum_name
    enum_name.as_str store.enums.get_str = enum_opt
    if enum_opt.is_none then
        false return
    fi
    ident separator 2 + (u64) ident.length separator (u64) - 2 - str::substring = binding_name
    enum_opt.unwrap = casa_enum
    binding_name.as_str casa_enum CasaEnum::variants string_list_index = ordinal
    if 0 ordinal < then
        op Op::location.clone f"Variant `{binding_name}` is not defined in enum `{enum_name}`" ErrorKind::UndefinedName CasaError::new resolve_errors.push
    else
        ordinal Option::Some binding_name enum_name EnumVariant::new = enum_variant
        enum_variant OpValue::PushEnumVariant op Op::set_value
    fi
    true
}
# Try resolving `K::method` trait-bound method calls. Returns true if K is
# a trait-bound type variable on the enclosing function's stack effect.

fn try_resolve_trait_method_call function:mut$Function op:mut$Op ident:$str -> bool {
    if ident "::" str::find 0 <= ! then
        false return
    fi
    ident 0 ident "::" str::find(u64) str::substring = type_var
    if type_var function Function::stack_effect StackEffect::trait_bounds.get.is_some ! then
        false return
    fi
    ident ident "::" str::find 2 + (u64) ident.length ident "::" str::find(u64) - 2 - str::substring = trait_method
    f"__trait_{type_var}_{trait_method}" = hidden_var
    if hidden_var.as_str function Function::variables variable_list_contains ! then
        hidden_var.as_str Variable::new function Function::variables.push
    fi
    hidden_var OpValue::TraitMethodCall op Op::set_value
    true
}

fn try_resolve_qualified_trait_method store:mut$SymbolStore op:mut$Op ident:$str -> bool {
    ident "::" str::split = parts
    if 2 parts.length != then
        false return
    fi
    0 parts.get = trait_name
    if trait_name.as_str store.traits.has_str ! then
        false return
    fi
    1 parts.get = method_name
    trait_name.clone GenericType::new Type::Generic = trait_type
    if op.type_hint Option::Some(hint) is then
        hint clone_type = trait_type
    fi
    method_name.clone trait_type false QualifiedMethod OpValue::QualifiedMethodCall op Op::set_value
    true
}

fn try_resolve_type_qualified_method store:mut$SymbolStore op:mut$Op ident:$str -> bool {
    if
        ident store
            .functions
            .get_str
            .is_some
    then
        false return
    fi
    ident "::" str::split = parts
    if 2 parts.length != then
        false return
    fi
    0 parts.get.as_str parse_type_str = receiver_type
    1 parts.get = method_name
    store Option[Function]::None receiver_type method_name.as_str resolve_method_semantics = method_opt
    if method_opt.is_none then
        false return
    fi
    method_name.clone receiver_type true QualifiedMethod OpValue::QualifiedMethodCall op Op::set_value
    true
}
# Resolve a bare identifier after `&`-ref, enum-variant, and trait-method
# attempts have already failed. Rewrites `op` in place to the matching op
# kind or pushes an `UndefinedName` error.

fn resolve_plain_identifier
    store:mut$SymbolStore
    function:mut$Function
    op:mut$Op
    ident:$str
    resolve_errors:mut$List[CasaError]
{
    ident "::" str::split = identifier_parts
    if
        2 identifier_parts.length == "drop" identifier_parts.length 1 - identifier_parts.get.as_str == &&
    then
        op Op::location.clone "Reserved `drop` methods cannot be called directly; use the `drop` intrinsic".to_str ErrorKind::InvalidScope CasaError::new resolve_errors.push
        return
    fi
    if ident function Function::variables variable_list_contains then
        ident.to_str OpValue::PushVar op Op::set_value
        return
    fi

    if ident store.functions.has_str then
        ident.to_str OpValue::FnCall op Op::set_value
        ident store mark_function_used
        return
    fi

    if ident function Function::captures variable_list_contains then
        ident.to_str OpValue::PushCapture op Op::set_value
        return
    fi

    if
        ident store
            .variables
            .get_str
            .is_some
    then
        ident.to_str OpValue::PushVar op Op::set_value
        return
    fi

    ident store.constants.get_str = const_opt
    if const_opt Option::Some(casa_const) is then
        casa_const Constant::value clone_constant_value = const_value
        const_value match
            ConstantValue::Int(const_int) => {
                const_int OpValue::PushInt op Op::set_value
            }
            ConstantValue::Float(const_float) => {
                const_float OpValue::PushFloat op Op::set_value
            }
            ConstantValue::Str(const_str) => {
                const_str OpValue::PushStr op Op::set_value
            }
            ConstantValue::Bool(const_bool) => {
                const_bool OpValue::PushBool op Op::set_value
            }
            ConstantValue::Char(const_char) => {
                const_char OpValue::PushChar op Op::set_value
            }
        end
        return
    fi

    ident store.structs.get_str = struct_opt
    if struct_opt Option::Some(casa_struct) is then
        casa_struct.clone OpValue::StructNew op Op::set_value
        return
    fi

    ident store.enums.get_str = resolved_enum_opt
    if resolved_enum_opt Option::Some(resolved_enum) is then
        resolved_enum CasaEnum::variants.length (i64) make_integer_op_value op Op::set_value
        return
    fi

    op Op::location.clone f"Identifier `{ident}` is not defined" ErrorKind::UndefinedName CasaError::new resolve_errors.push
}
