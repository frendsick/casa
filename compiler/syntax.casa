            elif generic.base store.structs.has generic.base store.enums.has || then
                generic.base inhabited.has
            else
                true
            fi
        }
        Type::Unknown => true
        Type::TypeVar(_) => true
        Type::Builtin(_) => true
        Type::Function(_) => true
