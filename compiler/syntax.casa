            .iter
    do
        if casa_trait parser validate_trait_method_compatibility ! then
            false 0 valid.set
        fi
        if casa_trait parser validate_language_trait_contract ! then
            false 0 valid.set
        fi
    done
    0 valid.get copy
}

pub fn type_is_known_inhabited
    typ:$common::Type
    store:$common::SymbolStore
    inhabited:$std::Set[std::String]
-> bool {
    if typ.borrow_target std::Option::Some(target) is then
        inhabited store target type_is_known_inhabited return
    fi
    typ match
        common::Type::Generic(generic) => {
            if common::ARRAY_TYPE generic.base.as_str == then
                if typ common::get_concrete_array_length std::Option::Some(length) is then
                    if 0 length == then
                        true return
                    fi
                fi
                if 0 generic.params.length == then
                    false return
                fi
                inhabited store 0 generic.params.get type_is_known_inhabited
            elif generic.base store.structs.has generic.base store.enums.has || then
                generic.base inhabited.has
            else
                true
            fi
        }
        common::Type::Unknown => true
        common::Type::TypeVar(_) => true
        common::Type::Builtin(_) => true
        common::Type::Function(_) => true
        common::Type::Const(_) => true
    end
}

pub fn validate_inhabited_aggregates parser:mut$Parser {
    std::Set[std::String]::new = inhabited
    true = changed
    while changed do
        false = changed
        for
            casa_struct in parser
                .store
                .structs
                .values
                .iter
        do
            if casa_struct.name inhabited.has then
                continue
            fi
            true = fields_inhabited
            for member in casa_struct.members.iter do
                if inhabited parser.store member.typ type_is_known_inhabited ! then
                    false = fields_inhabited
                    break
                fi
            done
            if fields_inhabited then
                casa_struct.name.clone inhabited.add
                true = changed
            fi
        done
        for
            casa_enum in parser
                .store
                .enums
                .values
                .iter
        do
            if casa_enum.name inhabited.has then
                continue
            fi
            false = enum_inhabited
            for pair in casa_enum.variant_types.iter do
                true = variant_inhabited
                for payload_type in pair.second.iter do
                    if inhabited parser.store payload_type type_is_known_inhabited ! then
                        false = variant_inhabited
                        break
                    fi
                done
                if variant_inhabited then
                    true = enum_inhabited
                    break
                fi
            done
            if enum_inhabited then
                casa_enum.name.clone inhabited.add
                true = changed
            fi
        done
    done

    for
        casa_struct in parser
            .store
            .structs
            .values
            .iter
    do
        if casa_struct.name inhabited.has ! then
            casa_struct.location
            f"Type `{casa_struct.name}` has no finite safe value; add `Option` or an enum leaf variant"
            common::ErrorKind::TypeMismatch parser.state.record_error_string
        fi
    done
    for
        casa_enum in parser
            .store
            .enums
            .values
            .iter
    do
        if casa_enum.name inhabited.has ! then
            casa_enum.location
            f"Type `{casa_enum.name}` has no finite safe value; add an enum leaf variant"
            common::ErrorKind::TypeMismatch parser.state.record_error_string
        fi
    done
}

pub fn copy_representation_is_eligible
    typ:$common::Type
    trait_bounds:$std::Map[std::String std::List[common::TraitBound]]
    store:$common::SymbolStore
    visiting:mut$std::Set[std::String]
-> bool {
    if typ.is_shared_borrow then
        true return
    fi
    if typ.is_exclusive_borrow then
        false return
    fi
    if typ common::Type::Builtin(common::BuiltinType::Str) is then
        true return
    fi
    if store typ common::type_value_representation std::Option::Some(representation) is then
        if common::VALUE_REPR_INDIRECT representation == then
            false return
        fi
    fi
    typ match
        common::Type::Builtin(builtin) => {
            builtin common::BuiltinType::Str !=
        }
        common::Type::Function(_) => {
            true
        }
        common::Type::Unknown => {
            false
        }
        common::Type::Const(_) => {
            false
        }
        common::Type::TypeVar(type_variable) => {
            if type_variable trait_bounds.get std::Option::Some(bounds) is then
                common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
                for bound in bounds.iter do
                    if store copy_type bound common::trait_bound_to_type semantics::trait_type_implies then
                        true return
                    fi
                done
            fi
            false
        }
        common::Type::Generic(generic) => {
            if "array" generic.base.as_str == then
                false return
            fi
            if f"{generic.base}::drop".as_str store.has_function then
                false return
            fi
            if generic.base visiting.has then
                false return
            fi
            std::Map[std::String common::Type]::new = substitutions
            if generic.base store.structs.get std::Option::Some(casa_struct) is then
                if generic.params.length casa_struct.type_vars.length != then
                    false return
                fi
                for
                    pair in generic.params.iter casa_struct
                        .type_vars
                        .iter
                        .zip
                do
                    pair.second common::clone_type pair.first.clone substitutions.set
                done
                generic.base.clone visiting.add
                for member in casa_struct.members.iter do
                    substitutions member.typ.substitute_t = member_type
                    if visiting store trait_bounds member_type copy_field_is_eligible ! then
                        generic.base visiting.remove
                        false return
                    fi
                done
                generic.base visiting.remove
                true return
            fi
            if generic.base store.enums.get std::Option::Some(casa_enum) is then
                if generic.params.length casa_enum.type_vars.length != then
                    false return
                fi
                for
                    pair in generic.params.iter casa_enum
                        .type_vars
                        .iter
                        .zip
                do
                    pair.second common::clone_type pair.first.clone substitutions.set
                done
                generic.base.clone visiting.add
                for pair in casa_enum.variant_types.iter do
                    for payload_type in pair.second.iter do
                        substitutions payload_type.substitute_t = resolved_payload
                        if visiting store trait_bounds resolved_payload copy_field_is_eligible ! then
                            generic.base visiting.remove
                            false return
                        fi
                    done
                done
                generic.base visiting.remove
                true return
            fi
            false
        }
    end
}

pub fn copy_field_is_eligible
    typ:$common::Type
    trait_bounds:$std::Map[std::String std::List[common::TraitBound]]
    store:$common::SymbolStore
    visiting:mut$std::Set[std::String]
-> bool {
    if typ common::Type::Generic(generic) is then
        if generic.base store.structs.has generic.base store.enums.has || then
            common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
            if store copy_type typ semantics::type_has_satisfying_trait_impl ! then
                false return
            fi
        fi
    fi
    visiting store trait_bounds typ copy_representation_is_eligible
}

pub fn validate_drop_methods parser:mut$Parser {
    parser.store.get_function_names = function_names
    for function_name in function_names.iter do
        function_name.as_str parser
            .store
            .get_function
            .unwrap = function: $common::Function
        if "drop" function_name.as_str == then
            function.location "`drop` must be declared in an inherent implementation" common::ErrorKind::InvalidScope parser.state.record_error
            continue
        fi
        function_name.as_str "::" str::split = name_parts
        if 2 name_parts.length != then
            continue
        fi
        if "drop" 1 name_parts.get.as_str != then
            continue
        fi
        function.stack_effect.clone = effect
        function.location.clone = function_location
        false = valid
        if 1 effect.parameters.length == 0 effect.return_types.length == && then
            0 effect.parameters.get = receiver
            if "self" receiver.name.as_str == receiver.typ.is_exclusive_borrow && then
                if receiver.typ.borrow_target std::Option::Some(target) is then
                    if 0 name_parts.get target.match_base == then
                        true = valid
                    fi
                fi
            fi
        fi
        if valid ! then
            function_location "Reserved `drop` method must have stack effect `self:mut$self -> None`" common::ErrorKind::SignatureMismatch parser.state.record_error
            continue
        fi
        0 effect
            .parameters
            .get
            .typ
            .borrow_target
            .unwrap = receiver_type
        false = receiver_is_copy
        if receiver_type common::Type::Builtin(builtin) is then
            true = receiver_is_copy
        fi
        common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
        if parser.store copy_type receiver_type semantics::type_has_satisfying_trait_impl then
            true = receiver_is_copy
        fi
        if receiver_is_copy then
            function_location "A `Copy` type cannot define a reserved `drop` method" common::ErrorKind::TraitSignatureMismatch parser.state.record_error
        fi
    done
}

pub fn is_copy_trait_impl_valid
    store:$common::SymbolStore
    trait_impl:$common::TraitImpl
    trait_type:$common::Type
-> bool {
    common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
    if store copy_type trait_type semantics::trait_type_implies ! then
        true return
    fi
    std::Set[std::String]::new = visiting
    visiting store trait_impl.trait_bounds trait_impl.receiver copy_representation_is_eligible
}

pub fn append_struct_copy_clone_body
    casa_struct:$common::CasaStruct
    location:$common::Location
    ops:mut$std::List[common::Op]
{
    casa_struct.members.length = member_index
    while 0 member_index != do
        1 -= member_index
        member_index casa_struct.members.get = member
        location.clone "self".to_str common::OpValue::PushVar common::Op::new ops.push
        location.clone member.name.clone common::OpValue::MethodCall common::Op::new ops.push
        if member.typ.is_shared_borrow ! then
            location.clone "clone".to_str common::OpValue::MethodCall common::Op::new ops.push
        fi
    done
    location.clone casa_struct.clone common::OpValue::StructNew common::Op::new ops.push
}

pub fn append_enum_copy_clone_body
    casa_enum:$common::CasaEnum
    location:$common::Location
    ops:mut$std::List[common::Op]
{
    location.clone "self".to_str common::OpValue::PushVar common::Op::new ops.push
    location.clone common::OpValue::MatchStart common::Op::new ops.push
    0 (u64) = variant_index
    for variant_name in casa_enum.variants.iter do
        std::List[std::String]::new = bindings
        if variant_name casa_enum.variant_types.get std::Option::Some(payload_types) is then
            0 (u64) = payload_index
            while payload_index payload_types.length > do
                f"__copy_clone_{variant_index}_{payload_index}" bindings.push
                1 += payload_index
            done
        fi
        bindings.length = binding_count
        variant_index (i64) std::Option::Some variant_name.clone casa_enum.name.clone common::EnumVariant::new = pattern_variant
        bindings pattern_variant common::EnumVariant::set_bindings
        std::List[common::Op]::new pattern_variant common::PatternValue::EnumVariant common::MatchArm::new = arm
        location.clone arm common::OpValue::MatchArm common::Op::new ops.push
        binding_count = binding_index
        while 0 binding_index != do
            1 -= binding_index
            location.clone f"__copy_clone_{variant_index}_{binding_index}" common::OpValue::PushVar common::Op::new ops.push
            variant_name casa_enum
                .variant_types
                .get
                .unwrap = payload_types
            if binding_index payload_types.get.is_shared_borrow ! then
                location.clone "clone".to_str common::OpValue::MethodCall common::Op::new ops.push
            fi
        done
        variant_index (i64) std::Option::Some variant_name.clone casa_enum.name.clone common::EnumVariant::new = constructor
        location.clone constructor common::OpValue::PushEnumVariant common::Op::new ops.push
        1 += variant_index
    done
    location.clone common::OpValue::MatchEnd common::Op::new ops.push
}

pub fn make_copy_clone_fallback
    parser:mut$Parser
    trait_impl:mut$common::TraitImpl
    function_name:$str
-> common::Function {
    std::List[common::Parameter]::new = parameters
    common::SHARED_BORROW_TYPE trait_impl.receiver common::clone_type common::apply_borrow_type = receiver
    "self".to_str receiver common::Parameter::named parameters.push
    std::List[common::Type]::new = returns
    trait_impl.receiver common::clone_type returns.push
    returns parameters common::StackEffect::new = effect
    trait_impl.type_vars common::string_list_to_set = effect.type_vars
    trait_impl.trait_bounds.clone effect common::StackEffect::set_trait_bounds

    std::List[common::Op]::new = ops
    std::List[common::Variable]::new = variables
    receiver "self".to_str common::Variable variables.push
    trait_impl.location.clone "self".to_str common::OpValue::AssignVar common::Op::new ops.push
    trait_impl.receiver.match_base = receiver_name
    if
        receiver_name.as_str parser
            .store
            .structs
            .get_str std::Option::Some(casa_struct) is
    then
        ops trait_impl.location casa_struct append_struct_copy_clone_body
    elif
        receiver_name.as_str parser
            .store
            .enums
            .get_str std::Option::Some(casa_enum) is
    then
        ops trait_impl.location casa_enum append_enum_copy_clone_body
    else
        trait_impl.location.clone "self".to_str common::OpValue::PushVar common::Op::new ops.push
        trait_impl.location.clone common::OpValue::Copy common::Op::new ops.push
    fi

    effect trait_impl.location.clone ops function_name.to_str common::Function::with_stack_effect = function
    variables function common::Function::set_variables
    function
}

pub fn synthesize_copy_clone_fallbacks parser:mut$Parser {
    if
        common::STD_COPY_TRAIT parser
            .store
            .traits
            .has_str ! common::STD_CLONE_TRAIT.to_str parser
            .store
            .traits
            .has ! ||
    then
        return
    fi
    common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
    common::STD_CLONE_TRAIT.to_str common::GenericType::new common::Type::Generic = clone_trait_type
    if parser.store clone_trait_type copy_type semantics::trait_type_implies ! then
        return
    fi
    parser
        .store
        .trait_impls
        .keys = copy_trait_impl_keys
    for copy_impl_key in copy_trait_impl_keys.iter do
        copy_impl_key parser
            .store
            .trait_impls
            .get
            .unwrap common::clone_trait_impl = trait_impl
        trait_impl.trait_bound common::trait_bound_to_type = implemented_trait
        if parser.store copy_type implemented_trait semantics::trait_type_implies ! then
            continue
        fi
        parser.store clone_trait_type common::clone_type std::Option::Some trait_impl.receiver "clone" semantics::resolve_trait_method_semantics_for = clone_method
        if clone_method std::Option::Some(method) is then
            method.function_name.clone "clone".to_str trait_impl.methods.set
            trait_impl copy_impl_key.clone parser
                .store
                .trait_impls
                .set
            continue
        fi
        f"{trait_impl.receiver.match_base}::{common::STD_COPY_TRAIT}::clone" = function_name
        if function_name.as_str parser.store.has_function ! then
            function_name.as_str trait_impl parser make_copy_clone_fallback = function
            function parser.store.set_function
        fi
        function_name.clone "clone".to_str trait_impl.methods.set
        trait_impl copy_impl_key.clone parser
            .store
            .trait_impls
            .set
    done
}

pub fn validate_trait_impls parser:mut$Parser {
    for
        trait_impl in parser
            .store
            .trait_impls
            .values
            .iter
    do
        if trait_impl.receiver common::Type::TypeVar(_) is then
            trait_impl.location "A trait implementation cannot target a type variable." common::ErrorKind::InvalidScope parser.state.record_error
            continue
        fi
        trait_impl.trait_bound.name parser
            .store
            .traits
            .get = trait_opt
        if trait_opt.is_none then
            trait_impl.location f"Trait `{trait_impl.trait_bound.name}` is not defined" common::ErrorKind::UndefinedName parser.state.record_error_string
            continue
        fi
        trait_opt.unwrap = casa_trait
        trait_impl.trait_bound common::trait_bound_to_type = trait_type
        if trait_type trait_impl parser.store is_copy_trait_impl_valid ! then
            trait_impl.location f"Type `{trait_impl.receiver.format}` cannot implement `Copy` because its representation is not safely copyable" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
        fi
        if
            trait_impl
                .trait_bound
                .type_args
                .length casa_trait.type_params.length !=
        then
            trait_impl.location f"Trait `{casa_trait.name}` expects {casa_trait.type_params.length} type argument(s), got {trait_impl
                .trait_bound
                .type_args
                .length}" common::ErrorKind::Syntax parser.state.record_error_string
        fi
        if
            casa_trait.location.file trait_impl.location.file !=
            parser.store trait_impl.location trait_impl.receiver receiver_is_local ! &&
        then
            trait_impl.location f"Trait implementation `{trait_impl common::trait_impl_key}` must be declared in the module that defines the type or trait" common::ErrorKind::InvalidScope parser.state.record_error_string
        fi
    done
}

pub fn finalize_trait_impl_methods parser:mut$Parser skip_functions:$std::Set[std::String] {
    parser
        .store
        .trait_impls
        .keys = trait_impl_keys
    for common::trait_impl_key in trait_impl_keys.iter do
        common::trait_impl_key parser
            .store
            .trait_impls
            .get
            .unwrap common::clone_trait_impl = trait_impl
        trait_impl.trait_bound common::trait_bound_to_type = trait_type
        std::Map[std::String std::String]::new = trait_methods
        for pair in trait_impl.methods.iter do
            pair.first = method_name
            pair.second = function_name
            if function_name.as_str skip_functions.has_str then
                continue
            fi
            if parser.store method_name.as_str trait_type semantics::trait_type_has_method then
                function_name.clone method_name.clone trait_methods.set
                continue
            fi
            f"{trait_impl.receiver.match_base}::{method_name}" = inherent_name
            if inherent_name.as_str parser.store.has_function ! then
                if function_name.as_str parser.store.get_function std::Option::Some(function) is then
                    function.clone_for_import = inherent_function
                    inherent_name.clone inherent_function common::Function::set_name
                    inherent_function parser.store.set_function
                fi
            fi
        done
        trait_methods trait_impl common::TraitImpl::set_methods
        trait_impl common::trait_impl_key.clone parser
            .store
            .trait_impls
            .set
    done
}

pub fn parse_impl_block parser:mut$Parser cursor:mut$TokenCursor {
    fallback_token parser.state "impl" cursor expect_token_value.unwrap_or = impl_token

    # Parse optional type parameters with trait bounds
    std::List[std::String]::new = type_vars
    std::List[std::String]::new = generic_params
    std::Map[std::String std::List[common::TraitBound]]::new = trait_bounds
    std::Map[std::String common::BuiltinType]::new = const_params
    cursor.peek = tvars_opt
    if tvars_opt std::Option::Some(tvars) is then
        if "[" tvars common::Token::value.as_str == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.into_parts = const_params = trait_bounds = all_type_param_names
            all_type_param_names.clone = generic_params
            # `names` mixes type variables and constant parameters; keep only
            # the type variables here (ADR-0152).
            for candidate_name in all_type_param_names.iter do
                if candidate_name const_params.has ! then
                    candidate_name.clone type_vars.push
                fi
            done
        fi
    fi

    parser.state cursor parse_type_ast = impl_type
    type_vars common::string_list_to_set = type_var_set
    type_var_set impl_type common::canonicalize_type_var = impl_type
    # Constant parameters in the implemented type are constants, not type
    # variables, so `array[T N]` keeps `N` symbolic (ADR-0152).
    if 0 const_params.keys.length != then
        const_params impl_type rewrite_type_const_params = impl_type
    fi

    # Get base type name (without type params)
    impl_type.match_base = base_type

    std::List[common::TraitBound]::new = implemented_traits
    std::Map[std::String std::String]::new = trait_impl_methods
    cursor.peek = colon_opt
    if colon_opt std::Option::Some(colon) is then
        if ":" colon.value.as_str == then
            cursor.pop drop
            true = parse_implemented_traits
            while parse_implemented_traits do
                fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = trait_token
                parser.state trait_token cursor parse_bound_type_args = trait_args
                trait_token.value parser
                    .store
                    .traits
                    .get = trait_opt
                0 (u64) = argument_index
                while argument_index trait_args.length > do
                    type_var_set argument_index trait_args.get common::canonicalize_type_var
                    argument_index trait_args.set
                    1 += argument_index
                done
                if trait_opt std::Option::Some(casa_trait) is then
                    if trait_args.length casa_trait.type_params.length != then
                        trait_token.location f"Trait `{trait_token.value}` expects {casa_trait.type_params.length} type argument(s), got {trait_args.length}" common::ErrorKind::Syntax parser.state.record_error_string
                    else
                        trait_args trait_token.value.clone common::TraitBound implemented_traits.push
                    fi
                else
                    trait_args trait_token.value.clone common::TraitBound implemented_traits.push
                fi
                cursor.peek = plus_opt
                if plus_opt std::Option::Some(plus) is then
                    if "+" plus.value.as_str == then
                        cursor.pop drop
                    else
                        false = parse_implemented_traits
                    fi
                else
                    false = parse_implemented_traits
                fi
            done
        fi
    fi

    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop
    while true do
        cursor.peek = method_opt
        if method_opt.is_none then
            break
        fi
        method_opt
            .unwrap
            .value
            .clone = method_keyword
        false = is_unsafe_method
        false = is_public_method
        if "pub" method_keyword.as_str == then
            true = is_public_method
            cursor.pop drop
            cursor.peek = method_opt
            if method_opt.is_none then
                break
            fi
            method_opt
                .unwrap
                .value
                .clone = method_keyword
        fi
        if "unsafe" method_keyword.as_str == then
            true = is_unsafe_method
            cursor.pop drop
        elif "fn" method_keyword.as_str != then
            break
        fi
        cursor parser parse_function = function
        is_unsafe_method function common::Function::set_is_unsafe
        function common::Function::name = method_name: $std::String
        if "drop" method_name.as_str == 0 implemented_traits.length != && then
            function.location "`drop` must be declared in an inherent implementation" common::ErrorKind::InvalidScope parser.state.record_error
        fi
        std::String::new = fn_name
        if 0 implemented_traits.length != then
            0 implemented_traits.get common::trait_bound_to_type.format = trait_name
            f"{base_type}::{trait_name}::{method_name}" = fn_name
            fn_name.clone method_name.clone trait_impl_methods.set
        else
            f"{base_type}::{method_name}" = fn_name
        fi
        fn_name.clone function common::Function::set_name
        # Merge inherited type vars, trait bounds, and constant parameters
        if 0 type_vars.length != 0 const_params.keys.length != || then
            const_params trait_bounds generic_params type_vars function parser inject_implementation_parameters
        fi
        if
            fn_name.as_str parser
                .store
                .get_function
                .is_some
        then
            function common::Function::location f"Identifier `{fn_name}` is already defined" common::ErrorKind::DuplicateName parser.state.record_error_string
        fi
        function fn_name.clone parser.put_function
        if is_public_method then
            fn_name.as_str parser
                .store
                .module_private_symbols
                .remove_str
            fn_name.clone parser
                .store
                .public_symbols
                .add
        fi
    done
    fallback_token parser.state "}" cursor expect_token_value.unwrap_or drop

    for implemented_trait in implemented_traits.iter do
        std::Map[std::String std::String]::new = cloned_methods
        for pair in trait_impl_methods.iter do
            pair.second.clone pair.first.clone cloned_methods.set
        done
        std::Map[std::String std::List[common::TraitBound]]::new = cloned_bounds
        for pair in trait_bounds.iter do
            pair.second.clone pair.first.clone cloned_bounds.set
        done
        impl_token.location.clone cloned_methods cloned_bounds type_vars.clone
        implemented_trait.clone impl_type common::clone_type common::TraitImpl
        parser register_trait_impl
    done
}

# ============================================================================
# parse_match_block - parse a full match construct (match ... end)
# ============================================================================

pub fn is_match_arm_boundary parser:mut$Parser cursor:mut$TokenCursor -> bool {
    cursor TokenCursor::pos = pos
    cursor TokenCursor::tokens = token_list: $std::List[common::Token]
    if pos 1 + token_list.length < then
        false return
    fi
    pos token_list.get = token
    pos 1 + token_list.get = next_token

    # _ => or _ if ...
    if common::MATCH_WILDCARD token common::Token::value.as_str == then
        if "=>" next_token common::Token::value.as_str == then
            true return
        fi
        if "if" next_token common::Token::value.as_str == then
            true return
        fi
    fi
    # literal => or literal if ...
    if common::TokenKind::Literal token common::Token::kind == then
        if "=>" next_token common::Token::value.as_str == then
            true return
        fi
        if "if" next_token common::Token::value.as_str == then
            true return
        fi
    fi
    if common::TokenKind::Identifier token common::Token::kind != then
        false return
    fi
    # Identifier => or Identifier if ...
    if "=>" next_token common::Token::value.as_str == then
        true return
    fi
    if "if" next_token common::Token::value.as_str == then
        true return
    fi
    # StructName { ... } =>
    if
        "{" next_token common::Token::value.as_str ==
        token common::Token::value.as_str parser
            .store
            .structs
            .get_str
            .is_some parser.syntax_only || &&
    then
        true return
    fi
    # EnumName::Variant(bindings) => or EnumName::Variant(bindings) if ...
    if "(" next_token common::Token::value.as_str == then
        token common::Token::value.as_str "::" str::find = separator
        if 0 separator > then
            pos 2 + = scan_pos
            while scan_pos token_list.length > do
                if ")" scan_pos token_list.get common::Token::value.as_str == then
                    if scan_pos 1 + token_list.length > then
                        scan_pos 1 + token_list.get common::Token::value.as_str = after_paren: $str
                        if "=>" after_paren.as_str == then
                            true return
                        fi
                        if "if" after_paren.as_str == then
                            true return
                        fi
                    fi
                    break
                fi
                1 += scan_pos
            done
        fi
    fi
    false
}

pub fn parse_struct_match_pattern
    parser:mut$Parser
    name_token:$common::Token
    cursor:mut$TokenCursor
-> common::StructPattern {
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop
    name_token common::Token::value.as_str parser
        .store
        .structs
        .get_str = struct_opt
    if struct_opt.is_none parser.syntax_only ! && then
        name_token common::Token::location f"Struct `{name_token common::Token::value.as_str}` is not defined" common::ErrorKind::UndefinedName parser.state.record_error_string
    fi
    std::Map[std::String std::String]::new = bindings

    while true do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token common::Token::location "Unexpected end of input in struct pattern" common::ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
        if next_opt std::Option::Some(next) is then
            if "}" next common::Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi
        fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = field_token
        fallback_token parser.state ":" cursor expect_token_value.unwrap_or drop
        fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = var_token
        var_token common::Token::value.clone field_token common::Token::value.clone bindings.set
    done

    bindings name_token common::Token::value.clone common::StructPattern
}
# parse_pattern_terminator — consume the `=>` that separates a match-arm
# pattern from its body. If an `if` keyword appears first the guard
# expression is collected until `=>`. Returns the (possibly empty) list of
# guard ops. The trailing `=>` token is always consumed.
#
# The guard expression may contain a nested `match` block whose arms also
# use `=>`; a match-depth counter skips those nested arrows so only the
# outer arm terminator ends the guard.

pub fn parse_pattern_terminator
    parser:mut$Parser
    cursor:mut$TokenCursor
    function_name:$str
-> std::List[common::Op] {
    std::List[common::Op]::new = guard_ops
    cursor.peek = guard_peek
    if { common::Token::value.as_str "if" == } guard_peek.filter.is_some then
        cursor.pop drop # consume `if`
        0 = match_depth
        while cursor.is_finished ! do
            cursor.peek = next_opt
            if next_opt.is_none then
                break
            fi
            next_opt.unwrap common::Token::value.as_str = next_value: $str
            if "=>" next_value.as_str == 0 match_depth == && then
                break
            fi
            cursor.pop = guard_token_opt
            if guard_token_opt.is_none then
                break
            fi
            guard_token_opt.unwrap = guard_token
            if "match" guard_token common::Token::value.as_str == then
                1 += match_depth
            elif "end" guard_token common::Token::value.as_str == 0 match_depth != && then
                1 -= match_depth
            fi
            if common::TokenKind::FstringStart guard_token common::Token::kind == then
                guard_ops function_name cursor guard_token parser handle_fstring
                continue
            fi
            guard_ops function_name cursor guard_token parser token_to_op
        done
    fi
    fallback_token parser.state "=>" cursor expect_token_value.unwrap_or drop
    guard_ops
}

pub fn parse_literal_match_pattern
    token:$common::Token
    parser:mut$Parser
-> common::LiteralPattern {
    token common::Token::value.as_str = value: $str
    if "true" value.as_str == then
        "true".to_str true common::LiteralValue::Bool common::LiteralPattern return
    fi
    if "false" value.as_str == then
        "false".to_str false common::LiteralValue::Bool common::LiteralPattern return
    fi
    if 0 value.at.is_digit value lexer::is_negative_integer_literal || then
        value.to_str value parser::str_to_int value.to_str common::IntegerLiteral::new common::LiteralValue::Int common::LiteralPattern return
    fi
    if value char_literal_codepoint std::Option::Some(character) is then
        value.to_str character common::LiteralValue::Char common::LiteralPattern return
    fi
    if '"' 0 value.at == '"' value.length 1 - value.at == && then
        value.length = value_length
        value 1 value_length 2 - str::substring = string_value
        value.to_str string_value common::LiteralValue::Str common::LiteralPattern return
    fi
    token common::Token::location f"Unsupported literal in match arm: `{value}`" common::ErrorKind::UnexpectedToken parser.state.record_error_string
    # Unreachable
    "".to_str 0 common::IntegerLiteral::from_int common::LiteralValue::Int common::LiteralPattern
}
# Parse one match-arm pattern (wildcard, literal, struct, bare ident, or
# Enum::Variant) plus its optional guard, append the OpMatchArm to `ops`.

pub fn parse_match_arm_pattern
    parser:mut$Parser
    arm_token:$common::Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$std::List[common::Op]
{
    if common::MATCH_WILDCARD arm_token common::Token::value.as_str == then
        function_name cursor parser parse_pattern_terminator = wildcard_guard_ops
        std::Option::None common::MATCH_WILDCARD.to_str "".to_str common::EnumVariant::new = wildcard
        wildcard_guard_ops wildcard common::PatternValue::EnumVariant common::MatchArm::new = wildcard_arm
        arm_token common::Token::location wildcard_arm common::OpValue::MatchArm common::Op::new ops.push
    elif common::TokenKind::Literal arm_token common::Token::kind == then
        function_name cursor parser parse_pattern_terminator = literal_guard_ops
        parser arm_token parse_literal_match_pattern = literal_pattern
        literal_guard_ops literal_pattern common::PatternValue::Literal common::MatchArm::new = literal_arm
        arm_token common::Token::location literal_arm common::OpValue::MatchArm common::Op::new ops.push
    elif common::TokenKind::Identifier arm_token common::Token::kind != then
        arm_token common::Token::location "Expected match pattern or `_`" common::ErrorKind::UnexpectedToken parser.state.record_error
    elif
        { common::Token::value.as_str "{" == } cursor
            .peek
            .filter
            .is_some
    then
        cursor arm_token parser parse_struct_match_pattern = struct_pattern
        function_name cursor parser parse_pattern_terminator = struct_guard_ops
        struct_guard_ops struct_pattern common::PatternValue::Struct common::MatchArm::new = struct_arm
        arm_token common::Token::location struct_arm common::OpValue::MatchArm common::Op::new ops.push
    elif arm_token common::Token::value.as_str "::" str::find 0 > then
        function_name cursor parser parse_pattern_terminator = bare_guard_ops
        std::Option::None arm_token common::Token::value.clone "".to_str common::EnumVariant::new = bare_variant
        bare_guard_ops bare_variant common::PatternValue::EnumVariant common::MatchArm::new = bare_arm
        arm_token common::Token::location bare_arm common::OpValue::MatchArm common::Op::new ops.push
    else
        arm_token common::Token::value.as_str "::" str::find = separator
        arm_token common::Token::value.as_str 0 separator (u64) str::substring = enum_name
        arm_token common::Token::value.as_str separator 2 + (u64) arm_token common::Token::value.as_str.length separator (u64) - 2 - str::substring = variant_name

        std::List[std::String]::new = bindings
        cursor.peek = paren_opt
        if { common::Token::value.as_str "(" == } paren_opt.filter.is_some then
            cursor.pop drop
            while true do
                cursor.peek = inner_opt
                if inner_opt.is_none then
                    arm_token common::Token::location "Unexpected end of input in match arm bindings" common::ErrorKind::UnexpectedToken parser.state.record_error
                    parser.state.mark_output_unusable
                    break
                fi
                if inner_opt std::Option::Some(inner) is then
                    if ")" inner common::Token::value.as_str == then
                        cursor.pop drop
                        break
                    fi
                fi
                fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = binding_token
                binding_token common::Token::value.clone bindings.push
            done
        fi

        function_name cursor parser parse_pattern_terminator = enum_guard_ops
        std::Option::None variant_name enum_name common::EnumVariant::new = variant
        bindings variant common::EnumVariant::set_bindings
        enum_guard_ops variant common::PatternValue::EnumVariant common::MatchArm::new = variant_arm
        arm_token common::Token::location variant_arm common::OpValue::MatchArm common::Op::new ops.push
    fi
}
# Parse a match-arm body (either a `{...}` block or a single-line expression
# up to the next arm boundary / `end`) and append its ops to `ops`.

pub fn parse_match_arm_body
    parser:mut$Parser
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$std::List[common::Op]
{
    cursor.peek = body_peek
    if { common::Token::value.as_str "{" == } body_peek.filter.is_some then
        function_name cursor parser parse_block_ops = block_ops
        block_ops ops.append
        return
    fi
    while cursor.is_finished ! do
        if cursor parser is_match_arm_boundary then
            break
        fi
        cursor.peek = end_peek
        if { common::Token::value.as_str "end" == } end_peek.filter.is_some then
            break
        fi
        cursor.pop = body_token_opt
        if body_token_opt.is_none then
            break
        fi
        body_token_opt.unwrap = body_token
        if common::TokenKind::FstringStart body_token common::Token::kind == then
            ops function_name cursor body_token parser handle_fstring
            continue
        fi
        ops function_name cursor body_token parser token_to_op
    done
}

pub fn parse_match_block
    parser:mut$Parser
    token:$common::Token
    cursor:mut$TokenCursor
    function_name:$str
-> std::List[common::Op] {
    std::List[common::Op]::new = ops
    token common::Token::location common::OpValue::MatchStart common::Op::new ops.push

    while true do
        fallback_token parser.state cursor expect_token.unwrap_or = arm_token
        if "end" arm_token common::Token::value.as_str == then
            arm_token common::Token::location common::OpValue::MatchEnd common::Op::new ops.push
            if parser.syntax_only then
                arm_token common::Token::location common::Location::span common::Span::offset
                token common::Token::location common::Location::span common::Span::offset
                SyntaxSpanKind::MatchForm parser.state.record_span
            fi
            break
        fi
        ops function_name cursor arm_token parser parse_match_arm_pattern
        ops function_name cursor parser parse_match_arm_body
        if parser.syntax_only then
            cursor.previous_offset
            arm_token common::Token::location common::Location::span common::Span::offset
            SyntaxSpanKind::MatchArm parser.state.record_span
        fi
    done
    ops
}

# ============================================================================
# _handle_keyword_import - parse import path
# ============================================================================

pub fn is_path_specifier spec:$str -> bool {
    spec ".casa" str::ends_with
    spec "/" str::contains ||
}

pub fn namespace_name prefix:$str name:$str -> std::String {
    if 0 prefix.length == then
        name.to_str
    else
        f"{prefix}{name}"
    fi
}

pub fn make_module_namespace name:$str -> std::String { f"__casa_{name}__" }

pub fn next_source_token tokens:$std::List[common::Token] start:u64 -> std::Option[u64] {
    start = index
    while index tokens.length > do
        index tokens.get = token
        if common::TokenKind::Comment token.kind != common::TokenKind::Newline token.kind != && then
            index std::Option::Some return
        fi
        1 += index
    done
    std::Option[u64]::None
}

pub fn namespace_token_value
    value:$str
    names:$std::Map[std::String std::String]
-> std::Option[std::String] {
    "".to_str = sigil
    value.to_str = identifier
    if value "mut$" str::starts_with then
        "mut$".to_str = sigil
        value 4 value.length 4 - str::substring = identifier
    elif value "$" str::starts_with value "&" str::starts_with || then
        value 0 1 str::substring = sigil
        value 1 value.length 1 - str::substring = identifier
    fi
    identifier.as_str "::" str::find = separator
    if separator 0 <= then separator (u64) else identifier.length fi = first_length
    identifier.as_str 0 first_length str::substring = first
    if first.as_str names.get_str std::Option::Some(replacement) is then
        identifier.as_str first_length identifier.length first_length - str::substring = suffix
        if
            replacement.length 0 ==
            replacement.as_str "__" str::ends_with ||
            suffix.as_str "::" str::starts_with &&
        then
            suffix.as_str 2 suffix.length 2 - str::substring = suffix
        fi
        f"{sigil}{replacement}{suffix}" std::Option::Some
    else
        std::Option[std::String]::None
    fi
}

pub fn set_module_source_name
    names:mut$std::Map[std::String std::String]
    source_name:std::String
    internal_name:std::String
    location:$common::Location
    diagnostics:mut$error::Diagnostics
{
    if source_name.as_str names.get_str std::Option::Some(existing) is then
        if internal_name existing != then
            location f"Module name `{source_name}` conflicts with another declaration or import" common::ErrorKind::DuplicateName diagnostics.record_error_string
        fi
        return
    fi
    internal_name source_name names.set
}
# Add one import alias and its selective bindings to the source-name map.

pub fn collect_import_namespace_names
    tokens:$std::List[common::Token]
    import_index:u64
    names:mut$std::Map[std::String std::String]
    namespace_names:mut$std::Set[std::String]
    import_names:mut$std::Set[std::String]
    diagnostics:mut$error::Diagnostics
{
    import_index 1 + tokens next_source_token = path_index_opt
    if path_index_opt.is_none then
        return
    fi
    path_index_opt.unwrap = path_index
    path_index tokens.get = path_token
    path_token.value.as_str 1 path_token.value.length 2 - str::substring = import_spec
    path_index 1 + tokens next_source_token = tail_opt
    std::Option[std::String]::None = alias_opt
    if tail_opt std::Option::Some(tail) is then
        if
            "as" tail tokens
                .get
                .value
                .as_str ==
        then
            if tail 1 + tokens next_source_token std::Option::Some(alias_index) is then
                alias_index tokens
                    .get
                    .value
                    .clone std::Option::Some = alias_opt
                alias_index.to_str import_names.add
                alias_index 1 + tokens next_source_token = tail_opt
            fi
        fi
    fi
    if alias_opt.is_none import_spec.as_str is_path_specifier ! && then
        import_spec.clone std::Option::Some = alias_opt
    fi
    if alias_opt.is_none then
        return
    fi
    alias_opt.unwrap.clone = alias
    alias.clone namespace_names.add
    if import_spec.as_str is_path_specifier then
        alias.as_str make_module_namespace
    else
        import_spec.as_str make_module_namespace
    fi
    = child_prefix
    diagnostics path_token.location child_prefix.clone alias.clone names set_module_source_name
    if tail_opt.is_none then
        return
    fi
    tail_opt.unwrap = tail
    if
        "{" tail tokens
            .get
            .value
            .as_str !=
    then
        return
    fi
    tail 1 + = symbol_index
    while symbol_index tokens.length > do
        symbol_index tokens.get = symbol
        if "}" symbol.value.as_str == then
            return
        fi
        if common::TokenKind::Identifier symbol.kind == then
            symbol.value.as_str "::" str::find = separator
            if separator 0 <= then separator (u64) else symbol.value.length fi = root_length
            symbol.value.as_str 0 root_length str::substring = root
            root.as_str child_prefix.as_str namespace_name = internal_name
            diagnostics symbol.location internal_name root.clone names set_module_source_name
            symbol_index.to_str import_names.add
        fi
        1 += symbol_index
    done
}
# Add one top-level declaration to the source-name map.

pub fn collect_declaration_namespace_name
    tokens:$std::List[common::Token]
    declaration_index:u64
    module_prefix:$str
    names:mut$std::Map[std::String std::String]
    diagnostics:mut$error::Diagnostics
{
    declaration_index tokens.get = declaration
    if
        "fn" declaration.value.as_str !=
        "struct" declaration.value.as_str != &&
        "enum" declaration.value.as_str != &&
        "trait" declaration.value.as_str != &&
        "const" declaration.value.as_str != &&
        "global" declaration.value.as_str != &&
    then
        return
    fi
    declaration_index 1 + tokens next_source_token = name_index_opt
    if name_index_opt.is_none then
        return
    fi
    name_index_opt.unwrap = name_index
    name_index tokens.get = name_token
    if "fn" name_token.value.as_str == then
        name_index 1 + tokens next_source_token = function_name_index_opt
        if function_name_index_opt.is_none then
            return
        fi
        function_name_index_opt.unwrap = function_name_index
        function_name_index tokens.get = name_token
    fi
    if common::TokenKind::Identifier name_token.kind == then
        name_token.value.as_str module_prefix namespace_name = internal_name
        diagnostics name_token.location internal_name name_token.value.clone names set_module_source_name
    fi
}
# Rewrite identifier tokens after the complete source-name map is known.

pub fn rewrite_module_token_names
    tokens:mut$std::List[common::Token]
    names:$std::Map[std::String std::String]
    namespace_names:$std::Set[std::String]
    import_names:$std::Set[std::String]
{
    0 (u64) = index
    "".to_str = previous_value
    while index tokens.length > do
        index tokens.get_mut = token
        if index.to_str import_names.has ! then
            if
                common::TokenKind::Identifier token.kind ==
                "." previous_value.as_str != &&
                token.value.as_str "::" str::contains
                token.value.as_str namespace_names.has_str ! ||
                &&
            then
                if names token.value.as_str namespace_token_value std::Option::Some(namespaced) is then
                    namespaced.clone token.set_value
                fi
            fi
        fi
        if common::TokenKind::Comment token.kind != common::TokenKind::Newline token.kind != && then
            token.value.clone = previous_value
        fi
        1 += index
    done
}
# Enum variants belong to their enum namespace. A same-named top-level
# declaration must not rewrite the variant declaration token.

pub fn protect_enum_variant_names
    tokens:$std::List[common::Token]
    protected:mut$std::Set[std::String]
{
    false = waiting_for_body
    false = in_enum
    0 (u64) = enum_brace_depth
    0 (u64) = payload_depth
    0 (u64) = index
    while index tokens.length > do
        index tokens.get = token
        if in_enum then
            if "{" token.value.as_str == then
                1 += enum_brace_depth
            elif "}" token.value.as_str == then
                1 -= enum_brace_depth
                if 0 enum_brace_depth == then
                    false = in_enum
                fi
            elif "(" token.value.as_str == "[" token.value.as_str == || then
                1 += payload_depth
            elif ")" token.value.as_str == "]" token.value.as_str == || then
                1 -= payload_depth
            elif
                1 enum_brace_depth ==
                0 payload_depth == &&
                common::TokenKind::Identifier token.kind == &&
            then
                index.to_str protected.add
            fi
        elif waiting_for_body then
            if "{" token.value.as_str == then
                true = in_enum
                false = waiting_for_body
                1 (u64) = enum_brace_depth
            fi
        elif "enum" token.value.as_str == then
            true = waiting_for_body
        fi
        1 += index
    done
}
# Give every declaration and imported namespace one module-qualified identity
# before normal parsing and resolution.

pub fn namespace_module_tokens
    tokens:mut$std::List[common::Token]
    module_prefix:$str
    diagnostics:mut$error::Diagnostics
{
    std::Map[std::String std::String]::new = names
    std::Set[std::String]::new = namespace_names
    std::Set[std::String]::new = import_names
    0 (u64) = depth
    0 (u64) = index
    while index tokens.length > do
        index tokens.get = token
        if "{" token.value.as_str == then
            1 += depth
        elif "}" token.value.as_str == then
            if 0 depth > then
                1 -= depth
            fi
        elif 0 depth == "import" token.value.as_str == && then
            diagnostics import_names namespace_names names index tokens collect_import_namespace_names
        elif 0 depth == common::TokenKind::Keyword token.kind == && then
            diagnostics names module_prefix index tokens collect_declaration_namespace_name
        fi
        1 += index
    done
    import_names tokens protect_enum_variant_names
    import_names namespace_names names tokens rewrite_module_token_names
}

pub fn dir_of_path path:$str -> std::String {
    std::Option[u64]::None = last_slash
    0 (u64) = scan
    while scan path.length > do
        if '/' scan path.at == then
            scan std::Option::Some = last_slash
        fi
        1 += scan
    done
    if last_slash std::Option::Some(index) is then
        path 0 index 1 + str::substring
        return
    fi
    "".to_str
}

pub fn resolve_import
    parser:mut$Parser
    importing_file:$str
    spec:$str
    location:$common::Location
-> std::String {
    importing_file dir_of_path = source_dir
    importing_file lexer::absolute_normalize_path = importing_normalized
    # Path-style: keep existing semantics (no existence check).
    if spec is_path_specifier then
        if spec "/" str::starts_with then
            spec lexer::normalize_path
            return
        fi
        f"{source_dir}{spec}" = combined
        combined.as_str lexer::absolute_normalize_path
        return
    fi
    # Module-style: probe source dir, then each search path. First hit wins.
    # Skip a same-dir match that resolves to the importing file itself, so an
    # example named `argparse.casa` importing "argparse" still finds the
    # library copy via -L.
    # `searched` accumulates probed dirs for the not-found error message.
    f"{source_dir}{spec}.casa" = source_candidate_path
    source_candidate_path.as_str lexer::normalize_path = source_candidate
    source_candidate.as_str parser
        .sources
        .get
        .is_some = source_is_overridden
    if source_is_overridden source_candidate.as_str file::exists || then
        source_candidate.as_str lexer::absolute_normalize_path = resolved_candidate
        if resolved_candidate.as_str importing_normalized.as_str != then
            if source_is_overridden then
                source_candidate return
            fi
            resolved_candidate return
        fi
    fi
    if 0 source_dir.length == then
        ".".to_str
    else
        source_dir
    fi
    = first_dir
    f"\n  {first_dir}" = searched
    for base in parser.search_paths.iter do
        f"{searched}\n  {base}" = searched
        f"{base}/{spec}.casa" = candidate_path
        candidate_path.as_str lexer::normalize_path = candidate
        if
            candidate.as_str parser
                .sources
                .get
                .is_some
        then
            candidate return
        fi
        if candidate.as_str file::exists then
            candidate.as_str lexer::absolute_normalize_path
            return
        fi
    done
    location f"module `{spec}` not found, searched:{searched}" common::ErrorKind::Syntax parser.state.record_error_string
    parser.state.mark_output_unusable
    "".to_str
}

pub fn parse_selective_import_symbols
    cursor:mut$TokenCursor
    location:$common::Location
    state:mut$ParseState
-> std::List[std::String] {
    std::List[std::String]::new = symbols
    fallback_token state "{" cursor expect_token_value.unwrap_or drop
    while true do
        cursor.pop = symbol_opt
        if symbol_opt.is_none then
            location "Unclosed selective import list" common::ErrorKind::UnmatchedBlock state.record_error
            state.mark_output_unusable
            symbols return
        fi
        symbol_opt.unwrap = symbol_token
        if common::TokenKind::Comment symbol_token common::Token::kind == then
            continue
        fi
        if common::TokenKind::Newline symbol_token common::Token::kind == then
            continue
        fi
        if "}" symbol_token common::Token::value.as_str == then
            if 0 symbols.length == then
                symbol_token common::Token::location "Selective import list cannot be empty" common::ErrorKind::Syntax state.record_error
            fi
            symbols return
        fi
        if common::TokenKind::Identifier symbol_token common::Token::kind != then
            symbol_token common::Token::location "Expected identifier in selective import list" common::ErrorKind::UnexpectedToken state.record_error
        fi
        symbol_token common::Token::value.clone symbols.push
    done
    symbols
}

pub fn handle_keyword_import parser:mut$Parser cursor:mut$TokenCursor -> common::Op {
    fallback_token parser.state common::TokenKind::Literal cursor expect_token_kind.unwrap_or = path_token
    parser.state cursor path_token get_op_literal = literal_op
    if literal_op.value common::OpValue::PushStr(spec) is then
        path_token common::Token::location.clone = path_location
        std::Option[std::String]::None = alias_opt
        cursor.peek = alias_keyword_opt
        if alias_keyword_opt std::Option::Some(alias_keyword) is then
            if "as" alias_keyword.value.as_str == then
                cursor.pop drop
                fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = alias_token
                alias_token.value.clone std::Option::Some = alias_opt
            fi
        fi
        if alias_opt.is_none then
            if spec.as_str is_path_specifier then
                path_location "Path-style imports require an `as` alias" common::ErrorKind::Syntax parser.state.record_error
                parser.state.mark_output_unusable
                "".to_str std::Option::Some = alias_opt
            else
                spec.clone std::Option::Some = alias_opt
            fi
        fi
        alias_opt.unwrap = alias
        if spec.as_str is_path_specifier then
            alias.as_str
        else
            spec.as_str
        fi make_module_namespace = module_namespace
        if parser.syntax_only then
            spec.clone
        else
            path_location common::Location::file = importing_file: $std::String
            path_location spec.as_str importing_file.as_str parser resolve_import
        fi
        = resolved

        cursor.peek = next_opt
        if { common::Token::value.as_str "{" == } next_opt.filter.is_some then
            parser.state path_location cursor parse_selective_import_symbols = symbols
            symbols module_namespace resolved common::SelectiveImport = selective
            path_location selective common::OpValue::ImportFileSelective common::Op::new return
        fi
        module_namespace resolved common::ModuleImport = import_value
        path_location import_value common::OpValue::ImportFile common::Op::new return
    fi
    path_token common::Token::location "Expected string literal for import path" common::ErrorKind::UnexpectedToken parser.state.record_error
    # Unreachable - parser.state.record_error exits
    "".to_str "".to_str common::ModuleImport = import_value
    path_token common::Token::location import_value common::OpValue::ImportFile common::Op::new
}

impl Parser {
    fn reject_import_cycle self:mut$Parser import_path:$str location:$common::Location -> bool {
        import_path self.import_stack common::string_list_index = cycle_start
        if 0 cycle_start < then
            false return
        fi
        std::List[std::String]::new = cycle
        cycle_start u64::try_from.unwrap self
            .import_stack
            .iter
            .skip = cycle_items
        for item in cycle_items do
            item.clone cycle.push
        done
        import_path cycle.push_str
        " -> " cycle.join_strings = cycle_path
        location f"Module import cycle: {cycle_path}" common::ErrorKind::Syntax self.state.record_error_string
        self.state.mark_output_unusable
        true
    }
}

pub fn immutable_global_ops ops:$std::List[common::Op] -> std::List[common::Op] {
    std::List[common::Op]::new = initializers
    for op in ops.iter do
        if op.value common::OpValue::InitGlobal is then
            op.clone initializers.push
        fi
    done
    initializers
}

pub fn handle_selective_import
    parser:mut$Parser
    selective:common::SelectiveImport
    location:$common::Location
    expanded:mut$std::List[common::Op]
{
    selective.path = import_path: $std::String
    selective.namespace = module_namespace: $std::String
    if 0 import_path.length == then
        return
    fi
    if location import_path.as_str parser.reject_import_cycle then
        return
    fi
    f"{module_namespace}|{import_path}" = import_key
    if import_key.as_str parser.included_files.has_str then
        return
    fi

    common::symbol_store_new = imported_store
    std::List[common::Op]::new = initializer_ops
    std::Set[std::String]::new = inherited_symbols
    std::Set[std::String]::new = inherited_impls
    if import_key.as_str parser.selective_import_cache.get_str std::Option::Some(cached_import) is then
        cached_import.store.clone_for_selective_import = imported_store
        cached_import.ops common::clone_ops = initializer_ops
        cached_import.inherited_symbols.clone = inherited_symbols
        cached_import.inherited_impls.clone = inherited_impls
    else
        std::Set[std::String]::new = included_files
        for included_file in parser.included_files.iter do
            included_file.clone included_files.add
        done
        import_key.clone included_files.add
        parser.store.clone = base_store
        parser.store.declaration_names = inherited_symbols
        parser
            .store
            .trait_impls
            .keys common::string_list_to_set = inherited_impls
        module_namespace.as_str base_store included_files import_path.as_str parser.analyze_import = import_result
        import_result match
            std::Result::Ok(imported_result) => {
                imported_result.into_parts = imported_diagnostics = imported_store_result = imported_ops_opt
                location imported_diagnostics parser
                    .state
                    .diagnostics
                    .merge_at_encounter
                imported_ops_opt match
                    std::Option::Some(imported_ops) => {
                        imported_ops immutable_global_ops = initializer_ops
                        imported_store_result.clone_for_selective_import = imported_store
                        imported_store_result.clone_for_selective_import = cached_store
                        imported_ops import_path.as_str cached_store.retain_file_declarations
                        inherited_impls.clone
                        inherited_symbols.clone
                        std::Set[std::String]::new
                        initializer_ops common::clone_ops
                        cached_store
                        ImportedModule = imported_module
                        imported_ops drop
                        imported_module import_key.clone parser.selective_import_cache.set
                    }
                    std::Option::None => {
                        parser.state.mark_output_unusable
                        return
                    }
                end
            }
            std::Result::Error(read_error) => {
                location f"Cannot read import `{import_path}`: {read_error.to_str}" common::ErrorKind::Syntax parser
                    .state
                    .diagnostics
                    .record_error_at_encounter_string
                parser.state.mark_output_unusable
                return
            }
        end
    fi

    std::List[std::String]::new = requested_symbols
    for symbol in selective.symbols.iter do
        symbol.as_str module_namespace.as_str namespace_name = requested
        if requested.as_str imported_store.public_symbols.has_str ! then
            imported_store.declaration_names = imported_names
            if requested.as_str imported_names.has_str then
                location f"Declaration `{symbol}` is private to module `{module_namespace}`" common::ErrorKind::InvalidScope parser.state.record_error_string
            else
                location f"Public declaration `{symbol}` was not found in module `{module_namespace}`" common::ErrorKind::UndefinedName parser.state.record_error_string
            fi
            parser.state.mark_output_unusable
            return
        fi
        requested requested_symbols.push
    done

    imported_store.declaration_names = imported_names
    imported_store.public_symbols.clone = imported_public
    parser.store.declaration_names = existing_names
    initializer_ops common::clone_ops
    inherited_impls.clone
    inherited_symbols.clone
    location
    requested_symbols.clone
    parser.store
    imported_store
    selective_import::merge_selective_import_closure_with_inherited = merge_result
    merge_result match
        std::Result::Ok(public_surface_types) => {
            std::List[common::Op]::new = selected_initializers
            for op in initializer_ops.iter do
                if op.value common::OpValue::InitGlobal(initializer) is then
                    if
                        initializer.name.as_str parser
                            .store
                            .immutable_globals
                            .has_str
                    then
                        op.clone selected_initializers.push
                    fi
                fi
            done
            selected_initializers = initializer_ops
            parser.store.declaration_names = merged_names
            for name in imported_names.iter do
                false = is_requested_surface
                for requested_symbol in requested_symbols.iter do
                    f"{requested_symbol}::" = member_prefix
                    if name requested_symbol == then
                        true = is_requested_surface
                        break
                    fi
                    if
                        name.as_str imported_public.has_str
                        name.as_str member_prefix.as_str str::starts_with &&
                    then
                        true = is_requested_surface
                        break
                    fi
                done
                if is_requested_surface ! name.as_str imported_public.has_str && then
                    for surface_type in public_surface_types.iter do
                        f"{surface_type}::" = member_prefix
                        if name.as_str member_prefix.as_str str::starts_with then
                            true = is_requested_surface
                            break
                        fi
                    done
                fi
                if
                    name.as_str merged_names.has_str
                    name.as_str inherited_symbols.has_str ! &&
                    name.as_str existing_names.has_str ! &&
                    is_requested_surface ! &&
                then
                    name.clone parser
                        .store
                        .private_symbols
                        .add
                fi
            done
            for requested_symbol in requested_symbols.iter do
                requested_symbol.as_str parser
                    .store
                    .private_symbols
                    .remove_str
                requested_symbol.clone parser
                    .store
                    .public_symbols
                    .add
            done
        }
        std::Result::Error(merge_diagnostics) => {
            location merge_diagnostics parser
                .state
                .diagnostics
                .merge_at_encounter
            parser.state.mark_output_unusable
            return
        }
    end
    initializer_ops expanded.append
}

pub fn handle_full_import
    parser:mut$Parser
    import_value:common::ModuleImport
    location:$common::Location
    expanded:mut$std::List[common::Op]
{
    import_value.path = import_path: $std::String
    import_value.namespace = module_namespace: $std::String
    if 0 import_path.length == then
        return
    fi
    if location import_path.as_str parser.reject_import_cycle then
        return
    fi
    f"{module_namespace}|{import_path}" = import_key
    if import_key.as_str parser.included_files.has_str then
        return
    fi
    import_key.clone parser.included_files.add
    if import_key.as_str parser.selective_import_cache.get_str std::Option::Some(cached_import) is then
        for included_file in cached_import.included_files.iter do
            included_file.clone parser.included_files.add
        done
        cached_import.store.clone_for_selective_import = cached_store
        cached_store parser.store.merge_import
        cached_import.ops common::clone_ops expanded.append
        return
    fi

    parser.store.clone = import_store
    parser.included_files.to_list common::string_list_to_set = imported_files
    module_namespace.as_str import_store imported_files import_path.as_str parser.analyze_import = import_result
    import_result match
        std::Result::Ok(imported_result) => {
            imported_result.into_parts = imported_diagnostics = imported_store_result = import_ops_opt
            location imported_diagnostics parser
                .state
                .diagnostics
                .merge_at_encounter
            import_ops_opt match
                std::Option::Some(import_ops) => {
                    import_ops immutable_global_ops = initializer_ops
                    imported_store_result.clone_for_selective_import = cached_store
                    import_ops import_path.as_str cached_store.retain_file_declarations
                    std::Set[std::String]::new
                    std::Set[std::String]::new
                    std::Set[std::String]::new
                    initializer_ops common::clone_ops
                    cached_store
                    ImportedModule = imported_module
                    imported_module import_key.clone parser.selective_import_cache.set
                    imported_store_result parser.store.merge_import
                    initializer_ops expanded.append
                }
                std::Option::None => parser.state.mark_output_unusable
            end
        }
        std::Result::Error(read_error) => {
            location f"Cannot read import `{import_path}`: {read_error.to_str}" common::ErrorKind::Syntax parser
                .state
                .diagnostics
                .record_error_at_encounter_string
            parser.state.mark_output_unusable
        }
    end
}

# ============================================================================
# handle_question_operator - preserve `?` for type-aware lowering
# ============================================================================
#
# Typechecking resolves the source value and enclosing return type before it
# lowers this operation through the structural propagation methods.
#

pub fn handle_question_operator token:$common::Token ops:mut$std::List[common::Op] {
    token
        .location
        .span
        .offset = offset
    # `$` cannot occur in a source identifier, so user variables cannot collide with this local.
    f"$question_{offset}" common::OpValue::Question = question
    token common::Token::location question common::Op::new ops.push
}

# ============================================================================
# handle_keyword_for - parse `for <ident> in <expr> do <body> done`
# ============================================================================
#
# The for-loop is desugared at parse time into a `while` loop over the
# iterator's `next` method. The synthesized ops use only existing op kinds,
# so no new typechecker or bytecode support is required.
#
# Source `for x in <iter> do <body> done` lowers to roughly:
#
#     <iter_expr_ops>
#     = $for_iter_FILE_N
#     while
#         $for_iter_FILE_N .next
#         = $for_opt_FILE_N
#         $for_opt_FILE_N .is_some
#     do
#         $for_opt_FILE_N .unwrap
#         = x
#         <body_ops>
#     done
#
# The hidden variable names embed the source offset so nested for-loops do
# not collide. Nested `while`/`for` inside the body or the iterable
# expression are detected via depth counting on `while`/`for` openers and
# `done` closers so the enclosing `do`/`done` pair is identified correctly.

pub fn handle_keyword_for
    parser:mut$Parser
    token:$common::Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$std::List[common::Op]
{
    fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = loop_var_token
    loop_var_token common::Token::value.clone = loop_var_name
    fallback_token parser.state "in" cursor expect_token_value.unwrap_or drop

    token common::Token::location.clone = for_loc
    for_loc common::Location::span common::Span::offset = for_offset
    for_loc.file.as_str std::str_hash = for_file_hash
    f"$for_iter_{for_file_hash}_{for_offset}" = hidden_iter_name
    f"$for_opt_{for_file_hash}_{for_offset}" = hidden_opt_name

    # Iterable-expression phase — emit ops until the matching `do`. These ops
    # leave the iterator value on the stack, which the synthesized
    # OpAssignVar below pops into the hidden iterator local.
    0 = nesting_depth
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            for_loc.clone "Unclosed `for` loop" common::ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            return
        fi
        peek_opt.unwrap = peeked_token
        if "do" peeked_token common::Token::value.as_str == 0 nesting_depth == && then
            cursor.pop drop
            break
        fi
        if "while" peeked_token common::Token::value.as_str == then
            1 += nesting_depth
        fi
        if "done" peeked_token common::Token::value.as_str == 0 nesting_depth > && then
            nesting_depth 1 - = nesting_depth
        fi
        cursor.pop drop
        if common::TokenKind::FstringStart peeked_token common::Token::kind == then
            ops function_name cursor peeked_token parser handle_fstring
            continue
        fi
        ops function_name cursor peeked_token parser token_to_op
    done

    # Loop preamble: store iterator into hidden local, then open the while
    # loop with the `next`/`is_some` condition.
    for_loc.clone hidden_iter_name.clone common::OpValue::AssignVar common::Op::new ops.push
    for_loc.clone common::OpValue::WhileStart common::Op::new ops.push
    for_loc.clone hidden_iter_name common::OpValue::PushVar common::Op::new ops.push
    for_loc.clone "next".to_str common::OpValue::MethodCall common::Op::new ops.push
    for_loc.clone hidden_opt_name.clone common::OpValue::AssignVar common::Op::new ops.push
    for_loc.clone hidden_opt_name.clone common::OpValue::PushVar common::Op::new ops.push
    for_loc.clone "is_some".to_str common::OpValue::MethodCall common::Op::new ops.push
    for_loc.clone common::OpValue::WhileCondition common::Op::new ops.push
    for_loc.clone hidden_opt_name common::OpValue::PushVar common::Op::new ops.push
    for_loc.clone "unwrap".to_str common::OpValue::MethodCall common::Op::new ops.push
    for_loc.clone loop_var_name common::OpValue::AssignVar common::Op::new ops.push

    # Body phase — emit ops until the matching `done`, then close the while.
    0 = body_nesting_depth
    while true do
        cursor.peek = body_peek_opt
        if body_peek_opt.is_none then
            for_loc.clone "Unclosed `for` loop body" common::ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            return
        fi
        body_peek_opt.unwrap = body_token
        if "done" body_token common::Token::value.as_str == 0 body_nesting_depth == && then
            cursor.pop drop
            body_token common::Token::location common::OpValue::WhileEnd common::Op::new ops.push
            if parser.syntax_only then
                body_token common::Token::location common::Location::span common::Span::offset
                token common::Token::location common::Location::span common::Span::offset
                SyntaxSpanKind::ControlForm parser.state.record_span
            fi
            return
        fi
        if "while" body_token common::Token::value.as_str == then
            1 += body_nesting_depth
        fi
        if "done" body_token common::Token::value.as_str == 0 body_nesting_depth > && then
            body_nesting_depth 1 - = body_nesting_depth
        fi
        cursor.pop drop
        if common::TokenKind::FstringStart body_token common::Token::kind == then
            ops function_name cursor body_token parser handle_fstring
            continue
        fi
        ops function_name cursor body_token parser token_to_op
    done
}

# ============================================================================
# get_op_keyword - handle all keywords
# ============================================================================
# Return the declaration name after `pub` without consuming parser input.

pub fn public_declaration_name
    cursor:mut$TokenCursor
    state:mut$ParseState
-> std::Option[std::String] {
    cursor.save = saved
    cursor.pop = declaration_opt
    if declaration_opt.is_none then
        saved cursor.restore
        std::Option[std::String]::None return
    fi
    declaration_opt.unwrap = declaration
    std::Option[common::Token]::None = name_opt
    if "unsafe" declaration.value.as_str == then
        cursor.pop drop
        cursor.pop = name_opt
    elif "const" declaration.value.as_str == then
        cursor.pop = next_opt
        if next_opt std::Option::Some(next) is then
            if "fn" next.value.as_str == then
                cursor.pop = name_opt
            else
                next.clone std::Option::Some = name_opt
            fi
        else
            std::Option[common::Token]::None = name_opt
        fi
    elif "global" declaration.value.as_str == then
        cursor.pop = name_opt
    elif
        "fn" declaration.value.as_str ==
        "struct" declaration.value.as_str == ||
        "enum" declaration.value.as_str == ||
        "trait" declaration.value.as_str == ||
    then
        cursor.pop = name_opt
    fi
    saved cursor.restore
    if name_opt std::Option::Some(name) is then
        if common::TokenKind::Identifier name.kind == then
            name.value.clone std::Option::Some return
        fi
    fi
    std::Option[std::String]::None
}

impl Parser {
    # unsafe function declaration or lexical block
    fn handle_keyword_unsafe
        self:mut$Parser
        token:$common::Token
        cursor:mut$TokenCursor
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        cursor.peek = unsafe_next_opt
        if unsafe_next_opt std::Option::Some(unsafe_next) is then
            if "fn" unsafe_next common::Token::value.as_str == then
                self token common::Token::location "Functions" function_name require_global_scope
                cursor self parse_function = function
                true function common::Function::set_is_unsafe
                if
                    function common::Function::name.as_str self
                        .store
                        .get_function
                        .is_some
                then
                    function common::Function::location f"Identifier `{function common::Function::name}` is already defined" common::ErrorKind::DuplicateName self.state.record_error_string
                fi
                function common::Function::name.clone = unsafe_function_name
                function unsafe_function_name.clone self.put_function
                return
            fi
            if "{" unsafe_next common::Token::value.as_str == then
                token common::Token::location common::OpValue::UnsafeStart common::Op::new ops.push
                function_name cursor self parse_block_ops = unsafe_ops
                unsafe_ops ops.append
                token common::Token::location common::OpValue::UnsafeEnd common::Op::new ops.push
                return
            fi
        fi
        token common::Token::location "Expected `fn` or `{` after `unsafe`" common::ErrorKind::Syntax self.state.record_error
        return
    }
    # move { ... } -> closure that owns its affine captures
    fn handle_keyword_move
        self:mut$Parser
        token:$common::Token
        cursor:mut$TokenCursor
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        cursor.peek = move_next_opt
        if move_next_opt std::Option::Some(move_next) is then
            if "{" move_next common::Token::value.as_str == then
                f"lambda__{function_name}_o{token common::Token::location common::Location::span common::Span::offset}" = lambda_name
                lambda_name.as_str cursor self parse_block_ops = lambda_ops
                token common::Token::location.clone lambda_ops lambda_name.clone common::Function::new = lambda_function
                true lambda_function common::Function::set_captures_by_move
                lambda_function lambda_name.clone self.put_function
                token common::Token::location lambda_name common::OpValue::FnPush common::Op::new ops.push
                return
            fi
        fi
        token common::Token::location "Expected `{` after `move`" common::ErrorKind::Syntax self.state.record_error
        return
    }
    fn parse_global_initializer
        self:mut$Parser
        cursor:mut$TokenCursor
        token:$common::Token
    -> std::List[common::Op] {
        if cursor.peek std::Option::Some(next) is then
            if "{" next.value.as_str == then
                common::GLOBAL_SCOPE_LABEL cursor self parse_block_ops return
            fi
        fi
        std::List[common::Op]::new = initializer_ops
        cursor.pop match
            std::Option::Some(initializer_token) => {
                if
                    common::TokenKind::Newline initializer_token.kind ==
                    common::TokenKind::Eof initializer_token.kind == ||
                then
                    token.location "A global declaration requires an initializer" common::ErrorKind::Syntax self.state.record_error
                    initializer_ops return
                fi
                if common::TokenKind::FstringStart initializer_token.kind == then
                    initializer_ops common::GLOBAL_SCOPE_LABEL cursor initializer_token self handle_fstring
                else
                    initializer_ops common::GLOBAL_SCOPE_LABEL cursor initializer_token self token_to_op
                fi
            }
            std::Option::None => {
                token.location "A global declaration requires an initializer" common::ErrorKind::Syntax self.state.record_error
            }
        end
        initializer_ops
    }

    # `global` initializes an immutable place at root scope. The legacy
    # function form remains until mutable globals are removed by #359.
    fn handle_keyword_global
        self:mut$Parser
        token:$common::Token
        cursor:mut$TokenCursor
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        if common::GLOBAL_SCOPE_LABEL function_name == then
            fallback_token self.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token
            name_token.value.clone = global_name
            self.store.declaration_names = declarations
            if
                global_name.as_str declarations.has_str global_name.as_str self
                    .store
                    .variables
                    .has_str ||
            then
                name_token.location f"Identifier `{global_name}` is already defined" common::ErrorKind::DuplicateName self.state.record_error_string
                return
            fi
            token cursor self.parse_global_initializer = initializer_ops
            name_token
                .location
                .file
                .as_str lexer::absolute_normalize_path = global_file
            f"$global:{global_file}:{name_token
                .location
                .span
                .offset}" = storage_name
            name_token.location storage_name.clone global_name.clone self.put_immutable_global
            initializer_ops global_name common::GlobalInitializer = initializer
            token.location initializer common::OpValue::InitGlobal common::Op::new ops.push
            return
        fi
        if function_name "lambda__" str::starts_with then
            token common::Token::location "`global` declaration is not allowed inside a lambda" common::ErrorKind::InvalidScope self.state.record_error
            return
        fi
        # Placement check: all ops so far must be DeclareGlobal
        for existing_op in ops.iter do
            if existing_op.value common::OpValue::DeclareGlobal is ! then
                token common::Token::location "`global` declaration must appear before any other statement in the function body" common::ErrorKind::Syntax self.state.record_error
                return
            fi
        done
        fallback_token self.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token
        token common::Token::location name_token common::Token::value.clone common::OpValue::DeclareGlobal common::Op::new ops.push
        return
    }
    # const
    fn handle_keyword_const
        self:mut$Parser
        token:$common::Token
        cursor:mut$TokenCursor
        function_name:$str
    {
        self token common::Token::location "Constants" function_name require_global_scope
        # const fn is a compile-time evaluable function
        cursor.peek = const_next_opt
        if const_next_opt std::Option::Some(const_next) is then
            if "fn" const_next common::Token::value.as_str == then
                cursor self parse_function = function
                true function common::Function::set_is_const_fn
                if self.syntax_only ! then
                    self.state.diagnostics function validate_const_fn_body
                fi
                if
                    function common::Function::name.as_str self
                        .store
                        .get_function
                        .is_some
                then
                    function common::Function::location f"Identifier `{function common::Function::name}` is already defined" common::ErrorKind::DuplicateName self.state.record_error_string
                fi
                function common::Function::name.clone = const_function_name
                function const_function_name.clone self.put_function
                return
            fi
        fi
        fallback_token self.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = const_name_token
        const_name_token common::Token::value.clone = const_name
        if
            const_name self
                .store
                .constants
                .get
                .is_some
        then
            token common::Token::location f"Constant `{const_name}` is already defined" common::ErrorKind::DuplicateName self.state.record_error_string
        fi
        if
            const_name.as_str self
                .store
                .get_function
                .is_some
        then
            token common::Token::location f"Constant `{const_name}` conflicts with an existing function" common::ErrorKind::DuplicateName self.state.record_error_string
        fi
        if
            const_name self
                .store
                .variables
                .get
                .is_some
        then
            token common::Token::location f"Constant `{const_name}` conflicts with an existing variable" common::ErrorKind::DuplicateName self.state.record_error_string
        fi
        if
            const_name self
                .store
                .structs
                .get
                .is_some
        then
            token common::Token::location f"Constant `{const_name}` conflicts with an existing struct" common::ErrorKind::DuplicateName self.state.record_error_string
        fi
        if
            const_name self
                .store
                .enums
                .get
                .is_some
        then
            token common::Token::location f"Constant `{const_name}` conflicts with an existing enum" common::ErrorKind::DuplicateName self.state.record_error_string
        fi
        cursor.pop = const_value_token_opt
        if const_value_token_opt.is_none then
            token common::Token::location "Expected a literal value, block expression, or constant name after constant name" common::ErrorKind::Syntax self.state.record_error
        fi
        const_value_token_opt.unwrap = const_value_token
        if "{" const_value_token common::Token::value.as_str == then
            cursor.retreat
            if self.syntax_only then
                "const" cursor self parse_block_ops drop
                0 common::IntegerLiteral::from_int common::ConstantValue::Int
            else
                token common::Token::location cursor self eval_const_block
            fi
            = const_block_val
            token common::Token::location.clone const_block_val const_name.clone common::Constant = casa_const
            casa_const const_name self.put_constant
        elif common::TokenKind::Literal const_value_token common::Token::kind == then
            const_value_token common::Token::value.as_str parse_literal_to_constant_value = const_lit_val
            token common::Token::location.clone const_lit_val const_name.clone common::Constant = casa_const
            casa_const const_name self.put_constant
        elif common::TokenKind::Identifier const_value_token common::Token::kind == then
            const_value_token common::Token::value.clone = const_ref_name
            if self.syntax_only then
                0 common::IntegerLiteral::from_int common::ConstantValue::Int = syntax_const_value
                token common::Token::location.clone syntax_const_value const_name.clone common::Constant = casa_const
                casa_const const_name self.put_constant
                return
            fi
            const_ref_name self
                .store
                .constants
                .get = const_ref_opt
            if const_ref_opt std::Option::Some(const_ref) is then
                token common::Token::location.clone const_ref common::Constant::value common::clone_constant_value const_name.clone common::Constant
                = casa_const
                casa_const const_name self.put_constant
            elif
                const_ref_name.as_str self
                    .store
                    .get_function
                    .is_some
            then
                token common::Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" common::ErrorKind::Syntax self.state.record_error_string
            elif
                const_ref_name self
                    .store
                    .structs
                    .get
                    .is_some
            then
                token common::Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" common::ErrorKind::Syntax self.state.record_error_string
            elif
                const_ref_name self
                    .store
                    .enums
                    .get
                    .is_some
            then
                token common::Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" common::ErrorKind::Syntax self.state.record_error_string
            else
                token common::Token::location f"Undefined constant `{const_ref_name}` referenced in constant `{const_name}`" common::ErrorKind::Syntax self.state.record_error_string
            fi
        else
            token common::Token::location f"Expected a literal value, block expression, or constant name for constant `{const_name}`" common::ErrorKind::Syntax self.state.record_error_string
        fi
        return
    }
}

pub fn get_op_keyword
    parser:mut$Parser
    token:$common::Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$std::List[common::Op]
{
    token common::Token::value.as_str common::keyword_from_str = keyword_opt
    if keyword_opt.is_none then
        token common::Token::location f"Token `{token common::Token::value.as_str}` is not a keyword" common::ErrorKind::Syntax parser.state.record_error_string
    fi
    keyword_opt.unwrap = keyword

    if common::KeywordKind::Pub keyword == then
        parser token.location "Public declarations" function_name require_global_scope
        parser.state cursor public_declaration_name = public_name_opt
        if public_name_opt.is_none then
            token.location "`pub` must prefix a function, type, trait, constant, or global declaration" common::ErrorKind::Syntax parser.state.record_error
            return
        fi
        public_name_opt.unwrap.clone = public_name
        fallback_token parser.state cursor expect_token.unwrap_or = declaration_token
        ops function_name cursor declaration_token parser get_op_keyword
        public_name.as_str parser
            .store
            .module_private_symbols
            .remove_str
        public_name parser
            .store
            .public_symbols
            .add
        return
    fi

    if common::KeywordKind::As keyword == then
        token.location "`as` is only valid in an import declaration" common::ErrorKind::Syntax parser.state.record_error
        return
    fi

    # unsafe function declaration or lexical block
    if common::KeywordKind::Unsafe keyword == then
        ops function_name cursor token parser.handle_keyword_unsafe
        return
    fi

    # move { ... } -> closure that owns its affine captures
    if common::KeywordKind::Move keyword == then
        ops function_name cursor token parser.handle_keyword_move
        return
    fi

    # Simple keyword -> OpValue lookup
    keyword keyword_to_op_value = simple_opt
    simple_opt match
        std::Option::Some(simple) => {
            if parser.syntax_only then
                token common::Token::location common::Location::span common::Span::offset
                simple parser.state.record_control_op
            fi
            token common::Token::location simple common::Op::new ops.push
            return
        }
        std::Option::None => {
        }
    end

    # end without match
    if common::KeywordKind::End keyword == then
        token common::Token::location "`end` without matching `match`" common::ErrorKind::UnmatchedBlock parser.state.record_error
    fi

    # enum
    if common::KeywordKind::EnumKw keyword == then
        parser token common::Token::location "Enums" function_name require_global_scope
        cursor.retreat
        cursor parser parse_enum = casa_enum
        if
            casa_enum common::CasaEnum::name parser
                .store
                .enums
                .get
                .is_some
        then
            casa_enum common::CasaEnum::location f"Enum `{casa_enum common::CasaEnum::name}` is already defined" common::ErrorKind::DuplicateName parser.state.record_error_string
        fi
        casa_enum common::CasaEnum::name.clone = enum_name
        casa_enum enum_name.clone parser.put_enum
        return
    fi

    # fn
    if common::KeywordKind::Fn keyword == then
        parser token common::Token::location "Functions" function_name require_global_scope
        cursor.retreat
        cursor parser parse_function = function
        if
            function common::Function::name.as_str parser
                .store
                .get_function
                .is_some
        then
            function common::Function::location f"Identifier `{function common::Function::name}` is already defined" common::ErrorKind::DuplicateName parser.state.record_error_string
        fi
        function common::Function::name.clone = parsed_function_name
        function parsed_function_name.clone parser.put_function
        return
    fi

    # impl
    if common::KeywordKind::Impl keyword == then
        parser token common::Token::location "Implementation blocks" function_name require_global_scope
        cursor.retreat
        cursor parser parse_impl_block
        return
    fi

    # import
    if common::KeywordKind::Import keyword == then
        parser token common::Token::location "Import statements" function_name require_global_scope
        cursor parser handle_keyword_import ops.push
        return
    fi

    # is (standalone is error)
    if common::KeywordKind::Is keyword == then
        token common::Token::location "`is` requires a preceding enum variant" common::ErrorKind::Syntax parser.state.record_error
    fi

    # match
    if common::KeywordKind::Match keyword == then
        function_name cursor token parser parse_match_block = match_ops
        match_ops ops.append
        return
    fi

    # struct
    if common::KeywordKind::StructKw keyword == then
        parser token common::Token::location "Structs" function_name require_global_scope
        cursor.retreat
        cursor parser parse_struct = casa_struct
        casa_struct common::CasaStruct::name.clone = parsed_struct_name
        casa_struct parsed_struct_name parser.put_struct
        return
    fi

    # for
    if common::KeywordKind::For keyword == then
        ops function_name cursor token parser handle_keyword_for
        return
    fi

    # in (standalone is error — only valid inside a for header)
    if common::KeywordKind::In keyword == then
        token common::Token::location "`in` is only valid inside a `for` loop header" common::ErrorKind::Syntax parser.state.record_error
    fi

    # global — compile-time declaration; emits DeclareGlobal op
    if common::KeywordKind::Global keyword == then
        ops function_name cursor token parser.handle_keyword_global
        return
    fi

    # const
    if common::KeywordKind::Const keyword == then
        function_name cursor token parser.handle_keyword_const
        return
    fi

    # trait
    if common::KeywordKind::TraitKw keyword == then
        parser token common::Token::location "Traits" function_name require_global_scope
        cursor.retreat
        cursor parser parse_trait = casa_trait
        if
            casa_trait common::CasaTrait::name parser
                .store
                .traits
                .get
                .is_some
        then
            casa_trait common::CasaTrait::location f"Trait `{casa_trait common::CasaTrait::name}` is already defined" common::ErrorKind::DuplicateName parser.state.record_error_string
        fi
        casa_trait common::CasaTrait::name.clone = parsed_trait_name
        casa_trait parsed_trait_name.clone parser.put_trait
        return
    fi
}

# ============================================================================
# _parse_struct_literal - parse StructName { field: value }
# ============================================================================

pub fn is_struct_field_boundary
    cursor:mut$TokenCursor
    member_names:mut$std::List[std::String]
-> bool {
    cursor TokenCursor::pos = pos
    cursor TokenCursor::tokens = token_list: $std::List[common::Token]
    if pos 1 + token_list.length < then
        false return
    fi
    pos token_list.get = token
    if common::TokenKind::Identifier token common::Token::kind != then
        false return
    fi
    if token common::Token::value.as_str member_names common::string_list_contains ! then
        false return
    fi
    ":" pos 1 + token_list.get common::Token::value.as_str ==
}

pub fn parse_struct_field_value
    parser:mut$Parser
    cursor:mut$TokenCursor
    member_names:mut$std::List[std::String]
    function_name:$str
    all_ops:mut$std::List[common::Op]
{
    while cursor.is_finished ! do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            break
        fi
        if peek_opt std::Option::Some(peek) is then
            if "}" peek common::Token::value.as_str == then
                break
            fi
        fi
        if member_names cursor is_struct_field_boundary then
            break
        fi
        cursor.pop = value_opt
        if value_opt.is_none then
            break
        fi
        value_opt.unwrap = value_token
        if common::TokenKind::FstringStart value_token common::Token::kind == then
            all_ops function_name cursor value_token parser handle_fstring
            continue
        fi
        all_ops function_name cursor value_token parser token_to_op
    done
}

pub fn parse_struct_literal
    parser:mut$Parser
    name_token:$common::Token
    cursor:mut$TokenCursor
    function_name:$str
-> std::List[common::Op] {
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop
    name_token common::Token::value.as_str parser.store.get_struct_member_names = member_names_opt
    if member_names_opt.is_none then
        common::empty_location "Expected option value while unwrapping name_token common::Token::value.as_str parser.store.structs.get" common::ErrorKind::Syntax parser.state.record_error
        1 std::exit
    fi
    member_names_opt.unwrap = member_names

    std::List[std::String]::new = field_order
    std::List[common::Op]::new = all_ops
    std::Set[std::String]::new = seen

    while true do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token common::Token::location "Unexpected end of input in struct literal" common::ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
        if next_opt std::Option::Some(next) is then
            if "}" next common::Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi

        fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = field_token
        if field_token common::Token::value.as_str member_names common::string_list_contains ! then
            field_token common::Token::location f"Struct `{name_token common::Token::value.as_str}` has no field `{field_token common::Token::value.as_str}`" common::ErrorKind::UndefinedName parser.state.record_error_string
        fi
        if field_token common::Token::value.as_str seen.has_str then
            field_token common::Token::location f"Duplicate field `{field_token common::Token::value.as_str}` in struct literal" common::ErrorKind::DuplicateName parser.state.record_error_string
        fi
        field_token common::Token::value.clone seen.add
        field_token common::Token::value.clone field_order.push

        fallback_token parser.state ":" cursor expect_token_value.unwrap_or drop

        all_ops.length = ops_before
        all_ops function_name member_names cursor parser parse_struct_field_value
        if ops_before all_ops.length == then
            field_token common::Token::location f"Missing value for field `{field_token common::Token::value.as_str}`" common::ErrorKind::Syntax parser.state.record_error_string
        fi
    done

    field_order name_token common::Token::value.clone common::StructLiteral = literal
    name_token common::Token::location literal common::OpValue::StructLiteral common::Op::new all_ops.push
    all_ops
}

# ============================================================================
# token_to_op - main dispatch: token kind -> handler
# ============================================================================

pub fn try_parse_pointer_operation
    token:$common::Token
    cursor:mut$TokenCursor
    ops:mut$std::List[common::Op]
    state:mut$ParseState
-> bool {
    if "ptr::into_raw" token.value.as_str == then
        token.location common::OpValue::PtrIntoRaw common::Op::new ops.push
        true return
    fi
    if
        "ptr::read" token.value.as_str !=
        "ptr::write" token.value.as_str != &&
        "ptr::as_ref" token.value.as_str != &&
        "ptr::as_mut" token.value.as_str != &&
    then
        false return
    fi
    cursor.peek = open_opt
    if open_opt.is_none then
        false return
    fi
    if open_opt std::Option::Some(open) is then
        if "[" open.value.as_str != then
            false return
        fi
    fi
    cursor.pop drop
    state cursor parse_type_ast = target_type
    fallback_token state "]" cursor expect_token_value.unwrap_or drop
    if "ptr::read" token.value.as_str == then
        token.location target_type common::OpValue::PtrRead common::Op::new ops.push
    elif "ptr::write" token.value.as_str == then
        token.location target_type common::OpValue::PtrWrite common::Op::new ops.push
    elif "ptr::as_ref" token.value.as_str == then
        token.location target_type common::OpValue::PtrAsRef common::Op::new ops.push
    else
        token.location target_type common::OpValue::PtrAsMut common::Op::new ops.push
    fi
    true
}

pub fn try_parse_explicit_associated_item
    token:$common::Token
    cursor:mut$TokenCursor
    ops:mut$std::List[common::Op]
    state:mut$ParseState
-> bool {
    cursor.save = saved_pos
    cursor.peek = open_opt
    if open_opt.is_none then
        false return
    fi
    if open_opt std::Option::Some(open) is then
        if "[" open common::Token::value.as_str != then
            false return
        fi
        if
            token common::Token::location common::Location::span common::Span::offset
            token common::Token::location common::Location::span common::Span::length +
            open common::Token::location common::Location::span common::Span::offset !=
        then
            false return
        fi
    fi
    cursor.pop drop
    std::List[common::Type]::new = type_args
    while true do
        cursor.peek = next_opt
        if next_opt.is_none then
            saved_pos cursor.restore false return
        fi
        if next_opt std::Option::Some(next) is then
            if "]" next common::Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi
        state cursor parse_type_ast type_args.push
    done
    if '&' 0 token common::Token::value.as_str.at == then
        cursor.peek = suffix_opt
        if suffix_opt.is_none then
            token common::Token::value.as_str 1 token common::Token::value.length 1 - str::substring = ref_name
            token common::Token::location token common::Token::value.clone common::OpValue::Identifier common::Op::new = ref_op
            type_args ref_name common::GenericType common::Type::Generic std::Option::Some ref_op common::Op::set_type_hint
            ref_op ops.push
            true return
        fi
        if suffix_opt std::Option::Some(suffix) is then
            if ":" suffix common::Token::value.as_str != then
                token common::Token::value.as_str 1 token common::Token::value.length 1 - str::substring = ref_name
                token common::Token::location token common::Token::value.clone common::OpValue::Identifier common::Op::new = ref_op
                type_args ref_name common::GenericType common::Type::Generic std::Option::Some ref_op common::Op::set_type_hint
                ref_op ops.push
                true return
            fi
        fi
    fi
    cursor.pop = first_colon
    cursor.pop = second_colon
    cursor.pop = member_opt
    if first_colon std::Option::Some(first_colon_token) is then
        if second_colon std::Option::Some(second_colon_token) is then
            if member_opt std::Option::Some(member_token) is then
                if
                    ":" first_colon_token common::Token::value.as_str ==
                    ":" second_colon_token common::Token::value.as_str == &&
                    common::TokenKind::Identifier member_token common::Token::kind == &&
                then
                    member_token common::Token::value.clone = member
                    token common::Token::value.clone = base
                    token common::Token::location f"{base}::{member}" common::OpValue::Identifier common::Op::new = associated_op
                    type_args base common::GenericType common::Type::Generic = result_type
                    result_type std::Option::Some associated_op common::Op::set_type_hint
                    associated_op ops.push
                    true return
                fi
            fi
        fi
    fi
    saved_pos cursor.restore
    false
}

pub fn token_to_op
    parser:mut$Parser
    token:$common::Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$std::List[common::Op]
{
    token common::Token::kind = kind

    # Source newlines do not interrupt an accessor chain.
    if common::TokenKind::Newline kind == then
        return
    fi

    if parser.syntax_only then
        common::TokenKind::Delimiter kind == "." token common::Token::value.as_str == && = is_accessor
        if is_accessor ! then
            parser.state.flush_accessor_chain
        fi
    fi

    if common::TokenKind::Eof kind == then
        return
    fi
    if common::TokenKind::Comment kind == then
        return
    fi

    if common::TokenKind::Delimiter kind == then
        ops function_name cursor token parser get_op_delimiter
        return
    fi

    if common::TokenKind::Literal kind == then
        parser.state cursor token get_op_literal ops.push
        return
    fi

    if common::TokenKind::Intrinsic kind == then
        parser.state cursor token get_op_intrinsic ops.push
        return
    fi

    if common::TokenKind::Keyword kind == then
        ops function_name cursor token parser get_op_keyword
        return
    fi

    if common::TokenKind::Operator kind == then
        if "?" token common::Token::value.as_str == then
            ops token handle_question_operator
            return
        fi
        parser.state function_name cursor token get_op_operator ops.push
        return
    fi

    if common::TokenKind::Identifier kind == then
        if parser.state ops cursor token try_parse_pointer_operation then
            return
        fi
        if parser.state ops cursor token try_parse_explicit_associated_item then
            return
        fi
        # Check for struct literal: StructName { ... }
        cursor.peek = next_opt
        if next_opt std::Option::Some(next) is then
            if "{" next common::Token::value.as_str == then
                if
                    token common::Token::value.as_str parser
                        .store
                        .structs
                        .get_str
                        .is_some
                then
                    function_name cursor token parser parse_struct_literal = struct_literal_ops
                    struct_literal_ops ops.append
                    return
                fi
            fi
        fi

        # Check for is check: Enum::Variant is
        if token common::Token::value.as_str "::" str::find 0 <= then
            cursor token try_parse_is_check = is_check_opt
            is_check_opt match
                std::Option::Some(is_check) => {
                    is_check ops.push
                    return
                }
                std::Option::None => {
                }
            end
        fi

        # Plain identifier
        token common::Token::location token common::Token::value.clone common::OpValue::Identifier common::Op::new ops.push
        return
    fi

    # F-string tokens should be handled by handle_fstring
    if
        common::TokenKind::FstringStart kind ==
        common::TokenKind::FstringEnd kind == ||
        common::TokenKind::FstringExprStart kind == ||
        common::TokenKind::FstringExprEnd kind == ||
        common::TokenKind::FstringText kind == ||
    then
        token common::Token::location "F-string token should be handled by handle_fstring" common::ErrorKind::Syntax parser.state.record_error
    fi
}

# ============================================================================
# parse_ops - main parse loop
# ============================================================================

pub fn parse_ops parser:mut$Parser tokens:std::List[common::Token] -> std::List[common::Op] {
    tokens TokenCursor::new = cursor
    std::List[common::Op]::new = ops
    while cursor.is_finished ! do
        cursor.pop = token_opt
        if token_opt.is_none then
            break
        fi
        token_opt.unwrap = token
        if common::TokenKind::Comment token common::Token::kind == then
            continue
        fi
        if common::TokenKind::Newline token common::Token::kind == then
            continue
        fi
        parser.state.reset_store_mutation
        ops.length = ops_before
        if common::TokenKind::FstringStart token common::Token::kind == then
            ops common::GLOBAL_SCOPE_LABEL cursor token parser handle_fstring
        else
            ops common::GLOBAL_SCOPE_LABEL cursor token parser token_to_op
        fi
        if parser.state.take_recovery_request then
            while ops_before ops.length > do
                ops.pop drop
            done
            if parser.state.store_was_mutated then
                parser.state.mark_output_unusable break
            fi
            if cursor.recover_at_structure ! then
                parser.state.mark_output_unusable break
            fi
        fi
    done
    if parser.syntax_only then
        parser.state.flush_accessor_chain
    fi
    ops
}

pub fn syntax_parser_tokens tokens:$std::List[common::Token] -> std::List[common::Token] {
    std::List[common::Token]::new = result
    for token in tokens.iter do
        if common::TokenKind::Comment token.kind == then
            continue
        fi
        if common::TokenKind::Newline token.kind == then
            continue
        fi
        token.location.clone token.kind token.value.clone common::Token result.push
    done
    result
}

pub fn logical_comment_text token:$common::Token -> std::String {
    1 (u64) = start
    if 1 token.value.length > then
        if ' ' 1 token.value.at == then
            2 (u64) = start
        fi
    fi
    token.value.as_str start token.value.length start - str::substring
}

pub fn build_syntax_facts
    source:$str
    tokens:$std::List[common::Token]
    spans:std::List[SyntaxSpan]
-> SyntaxFacts {
    std::List[SyntaxTokenFact]::new = meaningful_tokens
    std::List[SyntaxCommentFact]::new = comments
    0 (u64) = meaningful_count
    false = line_has_meaningful_token

    for token in tokens.iter do
        if common::TokenKind::Newline token.kind == then
            false = line_has_meaningful_token
        elif common::TokenKind::Comment token.kind == then
            token logical_comment_text = text
            line_has_meaningful_token meaningful_count text SyntaxCommentFact comments.push
        elif common::TokenKind::Eof token.kind != then
            # Commas carry no operand content: item separators are required by
            # the grammar (a missing one is a parse error the candidate re-parse
            # still catches), and a trailing comma is optional decoration.
            # Exclude them so the formatter may canonicalize delimited-form
            # commas, including adding or dropping the optional trailing comma,
            # without tripping the token-equality safety net.
            "," token.value.as_str == common::TokenKind::Delimiter token.kind == && = is_separator
            if is_separator ! then
                token
                    .location
                    .span
                    .length = length
                token
                    .location
                    .span
                    .offset = offset
                source offset length str::substring = spelling
                token.kind spelling SyntaxTokenFact meaningful_tokens.push
                1 += meaningful_count
                true = line_has_meaningful_token
            fi
        fi
    done

    spans comments meaningful_tokens SyntaxFacts
}

pub fn syntax_facts_match expected:$SyntaxFacts actual:$SyntaxFacts -> bool {
    if actual.meaningful_tokens.length expected.meaningful_tokens.length != then
        false return
    fi
    if actual.comments.length expected.comments.length != then
        false return
    fi

    0 (u64) = index
    while index expected.meaningful_tokens.length > do
        index expected.meaningful_tokens.get = expected_token
        index actual.meaningful_tokens.get = actual_token
        if actual_token.kind expected_token.kind != then
            false return
        fi
        if actual_token.spelling expected_token.spelling != then
            false return
        fi
        1 += index
    done

    0 (u64) = index
    while index expected.comments.length > do
        index expected.comments.get = expected_comment
        index actual.comments.get = actual_comment
        if actual_comment.text expected_comment.text != then
            false return
        fi
        if actual_comment.preceding_token_count expected_comment.preceding_token_count != then
            false return
        fi
        if actual_comment.attached_to_preceding expected_comment.attached_to_preceding != then
            false return
        fi
        1 += index
    done
    true
}
# Recognize one complete root file without resolving names or loading imports.

pub fn analyze_syntax source:$str file:$str -> SyntaxResult {
    lexer::SourceStore::new = sources
    source file sources.add
    file source lexer::lex_source_fmt = lex_result
    lex_result.into_parts = diagnostics = tokens
    if diagnostics.has_errors then
        diagnostics std::Option[SyntaxFacts]::None tokens SyntaxResult return
    fi

    tokens syntax_parser_tokens = parser_tokens
    std::Map[std::String ImportedModule]::new = import_cache
    import_cache sources diagnostics common::symbol_store_new Parser::new = parser
    true = parser.syntax_only
    parser_tokens parser parse_ops drop

    if
        parser.state.has_usable_output parser
            .state
            .diagnostics
            .has_errors ! &&
    then
        parser
            .state
            .spans
            .clone tokens source build_syntax_facts = facts
        parser.into_diagnostics facts std::Option::Some tokens SyntaxResult
    else
        parser.into_diagnostics std::Option[SyntaxFacts]::None tokens SyntaxResult
    fi
}

impl Parser {
    pub fn resolve_trait_default_bodies self:mut$Parser skip_traits:$std::Set[std::String] {
        self
            .store
            .traits
            .keys = trait_names
        for trait_name in trait_names.iter do
            if trait_name.as_str skip_traits.has_str then
                continue
            fi
            trait_name self
                .store
                .traits
                .get
                .unwrap
                .clone = casa_trait
            0 (u64) = method_index
            while method_index casa_trait.methods.length > do
                method_index casa_trait.methods.get = method
                if 0 method.default_ops.length != method.default_is_resolved ! && then
                    method.default_ops common::clone_ops = resolved_ops
                    method.stack_effect.clone
                    std::List[common::Op]::new
                    f"{trait_name}::{method.name}"
                    semantics::make_default_method_function = function
                    self.state.diagnostics function resolved_ops self.store resolve_identifiers
                    method.type_vars.clone true function.variables.clone resolved_ops method.stack_effect.clone method.name.clone
                    common::TraitMethod = resolved_method
                    resolved_method method_index casa_trait.methods.set
                fi
                1 += method_index
            done
            casa_trait trait_name.clone self
                .store
                .traits
                .set
        done
    }

    pub fn finish_resolution
        self:Parser
        ops:std::List[common::Op]
        skip_functions:std::Set[std::String]
        skip_traits:std::Set[std::String]
    -> ParseResolveResult std::List[std::String] {
        if self.state.has_usable_output ! then
            self.into_failed_result return
        fi
        skip_functions ops self resolve_identifiers_global = resolved_ops
        if self.state.has_usable_output ! then
            self.into_failed_result return
        fi
        self.store.get_function_names = function_names
        for function_name in function_names.iter do
            if function_name.as_str skip_functions.has_str then
                continue
            fi
            if function_name.as_str "lambda__" str::starts_with then
                continue
            fi
            if
                function_name.as_str self
                    .store
                    .get_function
                    .unwrap
                    .is_resolved
            then
                continue
            fi
            function_name.as_str self
                .store
                .take_function_for_update
                .unwrap = function
            function.split_body = function_ops = function
            self.state.diagnostics function function_ops self.store resolve_identifiers
            true = function.is_resolved
            function_ops function.set_ops
            function self.store.restore_function
        done
        skip_traits self.resolve_trait_default_bodies
        self derive_hashable_for_enums
        if self.state.has_usable_output then
            resolved_ops std::Option::Some
        else
            std::Option::None
        fi = result_ops
        result_ops self.into_result
    }
}

pub fn parse_and_resolve
    tokens:std::List[common::Token]
    search_paths:std::List[std::String]
    diagnostics:error::Diagnostics
    sources:mut$lexer::SourceStore
-> ParseResolveResult {
    diagnostics "" tokens namespace_module_tokens
    std::Map[std::String ImportedModule]::new = import_cache
    import_cache sources diagnostics common::symbol_store_new Parser::new = parser
    search_paths parser Parser::set_search_paths
    if 0 tokens.length > then
        0 tokens
            .get
            .location
            .file
            .as_str lexer::absolute_normalize_path parser.import_stack.push
    fi
    tokens parser parse_ops = ops
    std::Set[std::String]::new = skip_functions
    std::Set[std::String]::new = skip_traits
    skip_traits skip_functions ops parser.finish_resolution = included_files = result
    result
}

