        fi

        if current_op.value OpValue::AssignInc(inc_name_ref) is then
            inc_name_ref.clone = inc_name
            inc_name.as_str "." str::split = inc_parts
            0 inc_parts.get = inc_root
            if
                inc_root.as_str store
                    .constants
                    .get_str
                    .is_some
            then
                current_op Op::location.clone f"Cannot assign to constant `{inc_root}`" ErrorKind::Syntax CasaError::new resolve_errors.push
                current_op op_index 1 - ops.set
                continue
            fi
        fi

        if current_op.value OpValue::AssignDec(dec_name_ref) is then
            dec_name_ref.clone = dec_name
            dec_name.as_str "." str::split = dec_parts
            0 dec_parts.get = dec_root
            if
                dec_root.as_str store
                    .constants
                    .get_str
                    .is_some
            then
                current_op Op::location.clone f"Cannot assign to constant `{dec_root}`" ErrorKind::Syntax CasaError::new resolve_errors.push
                current_op op_index 1 - ops.set
                continue
            fi
        fi

        if current_op.value OpValue::AssignVar(var_name_ref) is then
            var_name_ref.clone = var_name
            var_name.as_str "." str::split = var_parts
            0 var_parts.get = var_root
            if
                var_root.as_str store
                    .constants
                    .get_str
                    .is_some
            then
                current_op Op::location.clone f"Cannot assign to constant `{var_root}`" ErrorKind::Syntax CasaError::new resolve_errors.push
                current_op op_index 1 - ops.set
                continue
            fi
            if var_parts.length 1 < then
                current_op op_index 1 - ops.set
                continue
            fi
            var_name.as_str Variable::new = variable
            if GLOBAL_SCOPE_LABEL function Function::name.as_str == then
                if var_name.as_str store.variables.has_str ! then
                    variable var_name.clone store.variables.set
                fi
                current_op op_index 1 - ops.set
                continue
            fi
            if var_name.as_str function Function::variables variable_list_contains ! then
                if
                    var_name.as_str declared_globals.has_str !
                    var_name.as_str function Function::captures variable_list_contains ! &&
                then
