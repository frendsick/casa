    if ident "::" str::find 0 <= ! then
        false return
    fi
    ident 0 ident "::" str::find(u64) str::substring = type_var
    if
        type_var function common::Function::stack_effect common::StackEffect::trait_bounds.get.is_some !
    then
        false return
    fi
    ident ident "::" str::find 2 + (u64) ident.length ident "::" str::find(u64) - 2 - str::substring = trait_method
    type_var.to_str common::Type::TypeVar = receiver
    receiver trait_method common::DeferredTraitCall::unresolved common::OpValue::TraitMethodCall op common::Op::set_value
    true
}

pub fn try_resolve_qualified_trait_method
    store:mut$common::SymbolStore
    op:mut$common::Op
    ident:$str
-> bool {
    ident "::" str::split = parts
    if 2 parts.length != then
        false return
    fi
    0 parts.get = trait_name
    if trait_name.as_str store.traits.has_str ! then
        false return
    fi
    1 parts.get = method_name
    trait_name.clone common::GenericType::new common::Type::Generic = trait_type
    if op.type_hint std::Option::Some(hint) is then
        hint common::clone_type = trait_type
    fi
    method_name.clone trait_type false common::QualifiedMethod common::OpValue::QualifiedMethodCall op common::Op::set_value
    true
}

pub fn try_resolve_type_qualified_method
    store:mut$common::SymbolStore
