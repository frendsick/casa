        "PartialEq" trait_name.as_str != "Eq" trait_name.as_str != &&
        "PartialOrd" trait_name.as_str != && "Ord" trait_name.as_str != &&
        "Hashable" trait_name.as_str != && "Display" trait_name.as_str != &&
