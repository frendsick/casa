            fi
        fi = term
        if module_scope declaration_index self.declarations.length < && then
            declaration_index self.declarations.get_mut = declaration
            first_token = declaration.first_token
            self.pos = declaration.after_token
        fi
        first_token = term.keyword
        first_token = term.first_token
        self.pos = term.after_token
        node self.finish_node
        term
    }

    fn parse_expression self:mut$Reader -> TermSyntax {
        self.pos = token
        if self.is_finished then
            "Expected an expression" self.fail
            token TermSyntax::Token return
        fi
        if
            "fn" self.is_at "struct" self.is_at || "enum" self.is_at || "trait" self.is_at || "impl" self.is_at || "extern" self.is_at ||
            "const" self.is_at || "global" self.is_at ||
        then
            std::Option[u64]::None self.parse_declaration_term TermSyntax::Declaration return
        fi
        if "pub" self.is_at then
            self.declarations.length = declaration_index
            0 self.parent == = module_scope
            self.advance
            # A `pub` before an unsafe block is its own term. The block follows it.
            if "unsafe" self.is_at "fn" self.is_next ! && then
                token TermSyntax::Token return
            fi
            token std::Option::Some self.parse_declaration_term = declaration
            if module_scope declaration_index self.declarations.length < && then
                token std::Option::Some declaration_index self
                    .declarations
                    .get_mut
                    .set_public_token
            fi
            declaration TermSyntax::Declaration return
        fi
        if "unsafe" self.is_at then
            if "fn" self.is_next then
                std::Option[u64]::None self.parse_declaration_term TermSyntax::Declaration return
            fi
            self.advance
            self.parse_block token TermSyntax::Unsafe return
        fi
        if "import" self.is_at then
            self.parse_import return
        fi
        if "move" self.is_at then
            self.advance
            self.parse_block token TermSyntax::Move return
        fi
        if "if" self.is_at "while" self.is_at || "for" self.is_at || then
            self.parse_control return
        fi
        if "match" self.is_at then
            self.parse_match TermSyntax::Match return
        fi
        if "{" self.is_at then
            self.parse_block TermSyntax::Block return
        fi
        if "[" self.is_at then
            self.parse_array TermSyntax::Array return
        fi
        if "." self.is_at then
            self.parse_accessor TermSyntax::Accessor return
        fi
        if "=" self.is_at "+=" self.is_at || "-=" self.is_at || then
            SyntaxSpanKind::Assignment self.begin_node = node
            "=" self.is_at = annotated
            self.advance
            self.pos = target
            self.parse_name
            std::List[u64]::new = fields
            if "." self.is_at then
                self.parse_accessor = fields
            fi
            std::Option[TypeSyntax]::None = typ
            if annotated ":" self.is_at && then
                self.advance self.parse_type std::Option::Some = typ
            fi
            node self.finish_node
            typ fields target token AssignmentSyntax TermSyntax::Assignment return
        fi
        if
            "size_of" self.is_at "ptr::read" self.is_at || "ptr::write" self.is_at || "ptr::as_ref" self.is_at || "ptr::as_mut" self.is_at || "ptr::from_raw" self.is_at ||
        then
            if "size_of" self.is_at "[" self.is_next || then
                SyntaxSpanKind::Name self.begin_node = node
                self.advance self.parse_type_operand = operand
                node self.finish_node
                operand token TermSyntax::TypeOperation return
            fi
            self.parse_named_expression TermSyntax::Name return
        fi
        if "(" self.is_at then
            self
                .get_token
                .location
                .clone = location
            location "General casts are not supported; use a named conversion" common::ErrorKind::UnexpectedToken self.diagnostics.record_error
        elif "," self.is_at ":" self.is_at || "=>" self.is_at || "#" self.is_at || then
            self.advance
        elif
            "break" self.is_at "continue" self.is_at || "return" self.is_at || "drop" self.is_at || "copy" self.is_at ||
        then
            self.advance
        else
            self.get_token.kind match
                common::TokenKind::Identifier => self.parse_named_expression TermSyntax::Name return
                common::TokenKind::FstringStart => self.parse_fstring TermSyntax::Fstring return
                common::TokenKind::Literal => self.advance
                common::TokenKind::Operator => self.advance
                common::TokenKind::Intrinsic => self.advance
                _ => "Unexpected token in expression" self.fail
            end
        fi
        token TermSyntax::Token
    }
}

pub fn analyze_syntax source:$str file:$str -> SyntaxResult {
    file source lexer::lex_source_fmt.into_parts = diagnostics = tokens
    diagnostics source tokens parse_tokens
}

pub fn parse_tokens
    tokens:std::List[common::Token]
    source:$str
    diagnostics:error::Diagnostics
-> SyntaxResult {
    if diagnostics.has_errors then
        diagnostics std::Option[SyntaxFacts]::None tokens SyntaxResult return
    fi
    diagnostics source tokens Reader::new = reader
    reader.skip_trivia
    while reader.is_finished ! do
        reader.parse_expression drop
    done
    reader match
        Reader { spans: spans imports: imports declarations: declarations diagnostics: result_diagnostics } => {
            if result_diagnostics.has_errors then
                result_diagnostics std::Option[SyntaxFacts]::None tokens SyntaxResult
            else
                declarations imports spans tokens source build_syntax_facts = facts
                result_diagnostics facts std::Option::Some tokens SyntaxResult
            fi
        }
    end
}

pub struct ModuleSyntax {
    pub root_body:      std::List[TermSyntax]
    pub spans:          std::List[SyntaxSpan]
    pub imports:        std::List[ImportSyntax]
    pub declarations:   std::List[DeclarationSyntax]
    pub impl_receivers: std::List[u64]
    pub references:     std::List[u64]
    pub diagnostics:    error::Diagnostics
    pub complete_until: u64
}

# Record complete top-level constructs before the first syntax or lexical error.
# lexical_limit is a source byte offset. complete_until is a token index.
pub fn parse_module
    tokens:$std::List[common::Token]
    source:$str
    lexical_limit:std::Option[u64]
-> ModuleSyntax {
    error::Diagnostics::new source tokens Reader::new = reader
    reader.skip_trivia
    reader.pos = complete_until
    std::List[TermSyntax]::new = root_body
    while reader.is_finished ! do
        if lexical_limit std::Option::Some(limit) is then
            if
                limit reader
                    .get_token
                    .location
                    .span
                    .offset <=
            then
                break
            fi
        fi
        reader.parse_expression = term
        if lexical_limit std::Option::Some(limit) is then
            reader.previous tokens
                .get
                .location
                .span = previous_span: $common::Span
            if limit previous_span.offset previous_span.length + < then
                break
            fi
        fi
        if reader.has_failed ! then
            reader.pos = complete_until
            term root_body.push
        fi
    done
    reader match
        Reader { spans: spans imports: imports declarations: declarations impl_receivers: impl_receivers references: references diagnostics: diagnostics } => {
            complete_until diagnostics references impl_receivers declarations imports spans root_body ModuleSyntax
        }
    end
}
