pub fn gather_captures
    store:mut$common::SymbolStore
    lambda_function:mut$common::Function
    function:mut$common::Function
{
    for op in lambda_function common::Function::ops.iter do
        std::Option[std::String]::None = name_opt
        if op.value common::OpValue::Identifier(identifier_name) is then
            identifier_name.clone std::Option::Some = name_opt
        elif
            op.value common::OpValue::AssignVar is
            op.value common::OpValue::AssignInc is ||
            op.value common::OpValue::AssignDec is ||
        then
            op common::op_str_value = target
            target.as_str "." str::split = target_parts
            if target_parts.length 1 < then
                0 target_parts.get.clone std::Option::Some = name_opt
            fi
        fi
        if name_opt std::Option::Some(name) is then
            false = captured

            # Check enclosing function variables
            0 (u64) = variable_index
            while variable_index function common::Function::variables.length > do
                if name variable_index function common::Function::variables.get_ref common::Variable::name == then
                    if name.as_str lambda_function.captures common::variable_list_contains ! then
                        variable_index function common::Function::variables.get common::clone_variable lambda_function common::Function::captures.push
                    fi
                    true = captured
                    break
                fi
                1 += variable_index
            done

            if captured ! then
                # A nested closure can capture a value already captured by its
                # enclosing closure.
                0 (u64) = capture_index
                while capture_index function common::Function::captures.length > do
                    if name capture_index function common::Function::captures.get_ref common::Variable::name == then
                        if name.as_str lambda_function.captures common::variable_list_contains ! then
                            capture_index function common::Function::captures.get common::clone_variable lambda_function common::Function::captures.push
                        fi
                        true = captured
                        break
                    fi
                    1 += capture_index
                done
            fi

            if captured ! then
                # Check global variables
                name.as_str store.variables.get_str = global_var_opt
                if global_var_opt std::Option::Some(global_var) is then
                    if name.as_str lambda_function.captures common::variable_list_contains ! then
                        global_var common::clone_variable lambda_function common::Function::captures.push
                        name.clone lambda_function.global_captures.push
                    fi
                fi
            fi
        fi
    done

    # Constant parameters stay in scope inside a closure. A call in the body
    # may forward one, and the typechecker adds that read after captures are
    # gathered, so capture them up front (ADR-0152).
    for
        constant_name in function
            .stack_effect
            .const_params
            .keys
            .iter
    do
        if constant_name.as_str lambda_function.captures common::variable_list_contains then
            continue
        fi
        constant_name.as_str function.variables common::variable_list_index = constant_variable_index
        if 0 constant_variable_index >= then
            constant_variable_index u64::try_from.unwrap function.variables.get common::clone_variable lambda_function.captures.push
        fi
    done
}

pub fn resolve_array_identifiers
    store:mut$common::SymbolStore
    items:mut$std::List[common::Op]
    function:mut$common::Function
    errors:mut$std::List[error::CasaError]
    diagnostics:mut$error::Diagnostics
{
    0 (u64) = item_index
    while item_index items.length > do
        item_index items.get_mut = rai_item
        rai_item.value common::clone_op_value = rai_value
        if rai_value common::OpValue::PushArray(inner_items) is then
            inner_items common::clone_ops = owned_inner_items
            diagnostics errors function owned_inner_items store resolve_array_identifiers
            owned_inner_items common::OpValue::PushArray rai_item common::Op::set_value
        elif rai_value common::OpValue::ExprGroup(group_inner) is then
            group_inner common::clone_ops = owned_group_inner
            diagnostics function owned_group_inner store resolve_identifiers
            owned_group_inner common::OpValue::ExprGroup rai_item common::Op::set_value
        elif rai_value common::OpValue::Identifier(rai_name_ref) is then
            rai_name_ref.clone = rai_name
            if rai_name.as_str function common::Function::variables common::variable_list_contains then
                rai_name.clone common::OpValue::PushVar rai_item common::Op::set_value
            elif rai_name.as_str function common::Function::captures common::variable_list_contains then
                rai_name.clone common::OpValue::PushCapture rai_item common::Op::set_value
            elif
                rai_name.as_str store
                    .variables
                    .get_str
                    .is_some
            then
                rai_name.clone common::OpValue::PushVar rai_item common::Op::set_value
            elif
                rai_name.as_str store.constants.get_str = rai_const_opt rai_const_opt std::Option::Some(rai_const) is
            then
                rai_const common::Constant::value common::clone_constant_value = rai_const_value
                rai_const_value match
                    common::ConstantValue::Int(rai_const_int) => {
                        rai_const_int common::OpValue::PushInt rai_item common::Op::set_value
                    }
                    common::ConstantValue::Float(rai_const_float) => {
                        rai_const_float common::OpValue::PushFloat rai_item common::Op::set_value
                    }
                    common::ConstantValue::Str(rai_const_str) => {
                        rai_const_str common::OpValue::PushStr rai_item common::Op::set_value
                    }
                    common::ConstantValue::Bool(rai_const_bool) => {
                        rai_const_bool common::OpValue::PushBool rai_item common::Op::set_value
                    }
                    common::ConstantValue::Char(rai_const_char) => {
                        rai_const_char common::OpValue::PushChar rai_item common::Op::set_value
                    }
                end
            elif errors rai_name.as_str rai_item store try_resolve_enum_variant_ident then
            elif rai_name.as_str store.has_function then
                rai_name.clone common::OpValue::FnPush rai_item common::Op::set_value
            else
                rai_item common::Op::location.clone f"Identifier `{rai_name}` is not defined" common::ErrorKind::UndefinedName error::CasaError::new errors.push
            fi
        fi
        1 += item_index
    done
}

pub fn resolve_enum_variant
    store:mut$common::SymbolStore
    variant:mut$common::EnumVariant
    op:mut$common::Op
    function:mut$common::Function
    errors:mut$std::List[error::CasaError]
{
    # Resolve enum variant ordinal if still unresolved
    if
        variant common::EnumVariant::enum_name.length 0 != variant common::EnumVariant::ordinal.is_none &&
    then
        variant common::EnumVariant::enum_name.as_str store.enums.get_str = rev_enum_opt
        if rev_enum_opt.is_none then
            op common::Op::location.clone f"Enum `{variant common::EnumVariant::enum_name}` is not defined" common::ErrorKind::UndefinedName error::CasaError::new errors.push
        else
            rev_enum_opt.unwrap = rev_enum
            variant common::EnumVariant::variant_name.as_str rev_enum common::CasaEnum::variants common::string_list_index = rev_ordinal
            if 0 rev_ordinal < then
                op common::Op::location.clone f"Variant `{variant common::EnumVariant::variant_name}` is not defined in enum `{variant common::EnumVariant::enum_name}`" common::ErrorKind::UndefinedName error::CasaError::new errors.push
            else
                rev_ordinal std::Option::Some variant common::EnumVariant::set_ordinal
            fi
        fi
    fi
    # Register bindings as variables
    if 0 variant common::EnumVariant::bindings.length != then
        for rev_var_name in variant common::EnumVariant::bindings.iter do
            rev_var_name.as_str common::Variable::new = rev_var
            if common::GLOBAL_SCOPE_LABEL function common::Function::name.as_str == then
                rev_var rev_var_name.clone store.variables.set
            else
                if rev_var_name.as_str function common::Function::variables common::variable_list_contains ! then
                    rev_var function common::Function::variables.push
                fi
            fi
        done
    fi
}

impl Parser {
    pub fn analyze_import
        self:mut$Parser
        import_path:$str
        included_files:mut$std::Set[std::String]
        base_store:common::SymbolStore
        module_prefix:$str
    -> std::Result[ParseResolveResult os::IoError] {
        self.sources import_path.clone lexer::lex_file = import_result
        error::Diagnostics::new = diagnostics
        std::List[common::Token]::new = tokens
        import_result match
            std::Result::Ok(lex_result) => lex_result.into_parts = diagnostics = tokens
            std::Result::Error(error) => error std::Result::Error return
        end
        if diagnostics.has_errors then
            diagnostics common::symbol_store_new std::Option[std::List[common::Op]]::None ParseResolveResult std::Result::Ok
            return
        fi
        diagnostics module_prefix tokens namespace_module_tokens
        base_store.get_function_names common::string_list_to_set = existing_functions
        base_store.traits.keys common::string_list_to_set = existing_traits
        base_store = imported_store
        self.selective_import_cache self.sources diagnostics imported_store Parser::new = import_parser
        self.search_paths.clone = import_parser.search_paths
        self.import_stack.clone = import_parser.import_stack
        import_path.to_str import_parser.import_stack.push
        included_files.to_list = existing_included_files
        for included_file in existing_included_files.iter do
            included_file.clone import_parser.included_files.add
        done
        tokens import_parser parse_ops = imported_ops
        if
            import_parser
                .state
                .diagnostics
                .has_errors import_parser.state.has_usable_output ! ||
        then
            import_parser.into_diagnostics common::symbol_store_new std::Option[std::List[common::Op]]::None ParseResolveResult std::Result::Ok
            return
        fi
        existing_traits existing_functions imported_ops import_parser.finish_resolution
        = nested_included_files = result
        for included_file in nested_included_files.iter do
            included_file.clone included_files.add
        done
        if result.diagnostics.has_errors then
            result.into_parts = result_diagnostics = result_store = result_ops
            result_diagnostics common::symbol_store_new std::Option[std::List[common::Op]]::None ParseResolveResult std::Result::Ok
            return
        fi
        result std::Result::Ok
    }
}

pub fn expand_imports parser:mut$Parser ops:std::List[common::Op] -> std::List[common::Op] {
    ops.reverse
    std::List[common::Op]::new = expanded
    while ops.is_empty ! do
        ops.pop = current_op
        if current_op.value common::OpValue::ImportFileSelective(selective_import) is then
            selective_import common::clone_selective_import = owned_import
            expanded current_op.location owned_import parser handle_selective_import
            if parser.state.has_usable_output ! then
                expanded return
            fi
            continue
        fi

        if current_op.value common::OpValue::ImportFile(import_value) is then
            import_value common::clone_module_import = owned_import
            expanded current_op.location owned_import parser handle_full_import
            if parser.state.has_usable_output ! then
                expanded return
            fi
            continue
        fi
        current_op expanded.push
    done
    expanded
}

pub fn order_global_initializers
    ops:std::List[common::Op]
    root_file:$str
    store:$common::SymbolStore
-> std::List[common::Op] {
    root_file lexer::absolute_normalize_path = normalized_root
    std::List[common::Op]::new = dependency_initializers
    std::List[common::Op]::new = module_initializers
    std::List[common::Op]::new = root_body
    std::Set[std::String]::new = initialized_slots
    for op in ops.iter do
        if op.value common::OpValue::InitGlobal(initializer) is then
            initializer.name.clone = storage_name
            if initializer.name.as_str store.immutable_global_slots.get_str std::Option::Some(slot) is then
                slot.clone = storage_name
            fi
            if storage_name.as_str initialized_slots.has_str then
                continue
            fi
            storage_name initialized_slots.add
            op
                .location
                .file
                .as_str lexer::absolute_normalize_path = op_file
            if op_file.as_str normalized_root.as_str == then
                op.clone module_initializers.push
            else
                op.clone dependency_initializers.push
            fi
        else
            op.clone root_body.push
        fi
    done
    module_initializers dependency_initializers.append
    root_body dependency_initializers.append
    dependency_initializers
}

pub fn merge_global_initializer_call_bindings
    incoming:$std::Map[std::String std::Set[std::String]]
    merged:mut$std::Map[std::String std::Set[std::String]]
-> bool {
    false = changed
    for pair in incoming.iter do
        if pair.first.as_str merged.has_str ! then
            std::Set[std::String]::new pair.first.as_str merged.set_str
        fi
        pair.first.as_str merged.get_mut_str.unwrap = known_callables
        for function_name in pair.second.iter do
            if function_name.as_str known_callables.has_str ! then
                function_name.clone known_callables.add
                true = changed
            fi
        done
    done
    changed
}

pub fn validate_global_initializer_function_call
    function_name:$str
    argument_callables:$std::Map[std::String std::Set[std::String]]
    initialized:$std::Set[std::String]
    visiting:mut$std::Set[std::String]
    call_bindings:mut$std::Map[std::String std::Map[std::String std::Set[std::String]]]
    initializer_name:$str
    inferred_effects:mut$std::Map[std::String common::StackEffect]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
-> bool {
    if function_name call_bindings.has_str ! then
        std::Map[std::String std::Set[std::String]]::new function_name.to_str call_bindings.set
    fi
    function_name call_bindings.get_mut_str.unwrap = known_bindings
    known_bindings argument_callables merge_global_initializer_call_bindings = bindings_changed
    function_name visiting.has_str = already_visiting
    if already_visiting bindings_changed ! && then
        true return
    fi
    if already_visiting ! then
        function_name.to_str visiting.add
    fi
    std::Option[common::Function]::None = called_function
    if function_name store.get_function std::Option::Some(function) is then
        function.clone_for_import std::Option::Some = called_function
    fi
    true = valid
    called_function match
        std::Option::Some(function) => {
            function_name call_bindings
                .get_str
                .unwrap
                .clone = accumulated_bindings
            accumulated_bindings store inferred_effects function
            semantics::analyze_function_semantics_with_callables = function_semantics
            diagnostics store inferred_effects initializer_name call_bindings visiting initialized
            function_semantics.ordered_facts
            validate_global_initializer_semantics = valid
        }
        std::Option::None => {
        }
    end
    if already_visiting ! then
        function_name visiting.remove_str
    fi
    valid
}

pub fn immutable_global_storage_name name:$str store:$common::SymbolStore -> std::String {
    if name store.immutable_global_slots.get_str std::Option::Some(storage_name) is then
        storage_name.clone return
    fi
    name.to_str
}

pub fn validate_global_initializer_default_method_call
    call:$semantics::SemanticDefaultMethodCall
    initialized:$std::Set[std::String]
    visiting:mut$std::Set[std::String]
    call_bindings:mut$std::Map[std::String std::Map[std::String std::Set[std::String]]]
    initializer_name:$str
    inferred_effects:mut$std::Map[std::String common::StackEffect]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
-> bool {
    f"default:{call.trait_name}:{call.method_name}" = call_key
    if call_key.as_str visiting.has_str then
        true return
    fi
    call_key.clone visiting.add
    std::List[common::Op]::new = default_ops
    if call.trait_name.as_str store.traits.get_str std::Option::Some(casa_trait) is then
        for method in casa_trait.methods.iter do
            if method.name.as_str call.method_name.as_str == then
                method.default_ops common::clone_ops = default_ops
                break
            fi
        done
    fi
    call.stack_effect.clone default_ops call_key.clone semantics::make_default_method_function
    = default_function
    call.argument_callables store inferred_effects default_function
    semantics::analyze_function_semantics_with_callables = default_semantics
    diagnostics store inferred_effects initializer_name call_bindings visiting initialized
    default_semantics.ordered_facts
    validate_global_initializer_semantics = valid
    call_key.as_str visiting.remove_str
    valid
}

pub fn validate_global_initializer_semantics
    facts:$std::List[semantics::SemanticDependency]
    initialized:$std::Set[std::String]
    visiting:mut$std::Set[std::String]
    call_bindings:mut$std::Map[std::String std::Map[std::String std::Set[std::String]]]
    initializer_name:$str
    inferred_effects:mut$std::Map[std::String common::StackEffect]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
-> bool {
    for fact in facts.iter do
        fact match
            semantics::SemanticDependency::Global(reference) => {
                reference.name.as_str "." str::split = parts
                0 parts.get = root_name
                store root_name.as_str immutable_global_storage_name = storage_name
                if
                    root_name.as_str store.immutable_globals.has_str
                    storage_name.as_str initialized.has_str ! &&
                then
                    reference.location
                    f"Global `{initializer_name}` reads `{root_name}` before it is initialized"
                    common::ErrorKind::InvalidVariable diagnostics.record_error_string
                    false return
                fi
            }
            semantics::SemanticDependency::Call(function_name) => {
                if
                    diagnostics store inferred_effects initializer_name call_bindings visiting initialized
                    std::Map[std::String std::Set[std::String]]::new
                    function_name.as_str
                    validate_global_initializer_function_call !
                then
                    false return
                fi
            }
            semantics::SemanticDependency::BoundCall(call) => {
                if
                    diagnostics store inferred_effects initializer_name call_bindings visiting initialized
                    call.argument_callables
                    call.function_name.as_str
                    validate_global_initializer_function_call !
                then
                    false return
                fi
            }
            semantics::SemanticDependency::DefaultMethodCall(call) => {
                if
                    diagnostics store inferred_effects initializer_name call_bindings visiting initialized call
                    validate_global_initializer_default_method_call !
                then
                    false return
                fi
            }
            semantics::SemanticDependency::Symbol(_) => {
            }
            semantics::SemanticDependency::Type(_) => {
            }
        end
    done
    true
}

pub fn validate_global_initializer_ops
    ops:$std::List[common::Op]
    initialized:$std::Set[std::String]
    visiting:mut$std::Set[std::String]
    call_bindings:mut$std::Map[std::String std::Map[std::String std::Set[std::String]]]
    initializer_name:$str
    inferred_effects:mut$std::Map[std::String common::StackEffect]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
-> bool {
    store inferred_effects ops semantics::analyze_global_initializer_semantics = initializer_semantics
    diagnostics store inferred_effects initializer_name call_bindings visiting initialized
    initializer_semantics.ordered_facts
    validate_global_initializer_semantics
}

pub fn validate_global_initializer_order
    ops:$std::List[common::Op]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
{
    std::Set[std::String]::new = initialized
    std::Map[std::String common::StackEffect]::new = inferred_effects
    for op in ops.iter do
        if op.value common::OpValue::InitGlobal(initializer) is then
            std::Set[std::String]::new = visiting
            std::Map[std::String std::Map[std::String std::Set[std::String]]]::new = call_bindings
            diagnostics store inferred_effects initializer.name.as_str call_bindings visiting initialized
            initializer.ops
            validate_global_initializer_ops drop
            store initializer.name.as_str immutable_global_storage_name initialized.add
        fi
    done
}

pub fn resolve_identifiers_global
    parser:mut$Parser
    ops:std::List[common::Op]
    skip_functions:$std::Set[std::String]
-> std::List[common::Op] {
    ops parser expand_imports = expanded_ops
    if parser.state.has_usable_output ! then
        std::List[common::Op]::new return
    fi
    if parser.import_stack.is_empty ! then
        parser.import_stack.length 1 - parser.import_stack.get = root_file
        parser.store root_file.as_str expanded_ops order_global_initializers = expanded_ops
    fi
    std::Set[std::String]::new = no_type_vars
    no_type_vars expanded_ops common::canonicalize_operation_type_vars
    if parser validate_traits ! then
        std::List[common::Op]::new return
    fi
    parser validate_inhabited_aggregates
    parser derive_copy_for_aggregates
    parser register_builtin_copy_impls
    parser validate_drop_methods
    skip_functions parser finalize_trait_impl_methods
    parser synthesize_copy_clone_fallbacks
    parser validate_trait_impls
    if parser.state.has_usable_output ! then
        std::List[common::Op]::new return
    fi
    common::empty_location std::List[common::Op]::new common::GLOBAL_SCOPE_LABEL.to_str common::Function::new = dummy
    parser.state.diagnostics dummy expanded_ops parser.store resolve_identifiers
    parser.state.diagnostics parser.store expanded_ops validate_global_initializer_order
    expanded_ops
}

pub fn resolve_identifiers
    store:mut$common::SymbolStore
    ops:mut$std::List[common::Op]
    function:mut$common::Function
    diagnostics:mut$error::Diagnostics
{
    0 (u64) = op_index
    std::List[error::CasaError]::new = resolve_errors
    std::Set[std::String]::new = declared_globals
    if common::GLOBAL_SCOPE_LABEL function.name.as_str != then
        for variable in function.variables.iter do
            if variable.name.as_str store.immutable_globals.has_str then
                function.location.clone
                f"Binding `{variable.name}` shadows immutable global `{variable.name}`; choose a different name"
                common::ErrorKind::DuplicateName error::CasaError::new resolve_errors.push
            fi
        done
    fi
    while op_index ops.length > do
        common::empty_location common::OpValue::OwnerCleanup common::Op::new op_index ops.replace = current_op
        1 += op_index

        if current_op.value common::OpValue::InitGlobal(initializer) is then
            initializer.clone = resolved_initializer
            diagnostics function resolved_initializer.ops store resolve_identifiers
            resolved_initializer common::OpValue::InitGlobal current_op common::Op::set_value
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value common::OpValue::DeclareGlobal(global_name_ref) is then
            global_name_ref.clone = global_name
            if global_name.as_str store.immutable_globals.has_str then
                current_op.location.clone
                f"Immutable global `{global_name}` cannot be declared for assignment"
                common::ErrorKind::InvalidVariable error::CasaError::new resolve_errors.push
            fi
            if
                global_name store
                    .variables
                    .get
                    .is_none
            then
                current_op common::Op::location.clone f"`{global_name}` is not a global variable" common::ErrorKind::UndefinedGlobal error::CasaError::new resolve_errors.push
            fi
            global_name.clone declared_globals.add
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value common::OpValue::AssignInc(inc_name_ref) is then
            inc_name_ref.clone = inc_name
            inc_name.as_str "." str::split = inc_parts
            0 inc_parts.get = inc_root
            if
                inc_root.as_str store
                    .constants
                    .get_str
                    .is_some
            then
                current_op common::Op::location.clone f"Cannot assign to constant `{inc_root}`" common::ErrorKind::Syntax error::CasaError::new resolve_errors.push
                current_op op_index 1 - ops.set
                continue
            fi
            if inc_root.as_str store.immutable_globals.has_str then
                current_op.location.clone f"Cannot assign to immutable global `{inc_root}`"
                common::ErrorKind::InvalidVariable error::CasaError::new resolve_errors.push
                current_op op_index 1 - ops.set
                continue
            fi
        fi

        if current_op.value common::OpValue::AssignDec(dec_name_ref) is then
            dec_name_ref.clone = dec_name
            dec_name.as_str "." str::split = dec_parts
            0 dec_parts.get = dec_root
            if
                dec_root.as_str store
                    .constants
                    .get_str
                    .is_some
            then
                current_op common::Op::location.clone f"Cannot assign to constant `{dec_root}`" common::ErrorKind::Syntax error::CasaError::new resolve_errors.push
                current_op op_index 1 - ops.set
                continue
            fi
            if dec_root.as_str store.immutable_globals.has_str then
                current_op.location.clone f"Cannot assign to immutable global `{dec_root}`"
                common::ErrorKind::InvalidVariable error::CasaError::new resolve_errors.push
                current_op op_index 1 - ops.set
                continue
            fi
        fi

        if current_op.value common::OpValue::AssignVar(var_name_ref) is then
            var_name_ref.clone = var_name
            var_name.as_str "." str::split = var_parts
            0 var_parts.get = var_root
            if
                var_root.as_str store
                    .constants
                    .get_str
                    .is_some
            then
                current_op common::Op::location.clone f"Cannot assign to constant `{var_root}`" common::ErrorKind::Syntax error::CasaError::new resolve_errors.push
                current_op op_index 1 - ops.set
                continue
            fi
            if var_root.as_str store.immutable_globals.has_str then
                if
                    1 var_parts.length ==
                    common::GLOBAL_SCOPE_LABEL function.name.as_str != &&
                then
                    f"Binding `{var_name}` shadows immutable global `{var_name}`; choose a different name"
                else
                    f"Cannot assign to immutable global `{var_root}`"
                fi = message
                current_op.location.clone message common::ErrorKind::InvalidVariable error::CasaError::new resolve_errors.push
                current_op op_index 1 - ops.set
                continue
            fi
            if var_parts.length 1 < then
                current_op op_index 1 - ops.set
                continue
            fi
            var_name.as_str common::Variable::new = variable
            if common::GLOBAL_SCOPE_LABEL function common::Function::name.as_str == then
                if var_name.as_str store.variables.has_str ! then
                    variable var_name.clone store.variables.set
                fi
                current_op op_index 1 - ops.set
                continue
            fi
            if var_name.as_str function common::Function::variables common::variable_list_contains ! then
                if
                    var_name.as_str declared_globals.has_str !
                    var_name.as_str function common::Function::captures common::variable_list_contains ! &&
                then
                    variable function common::Function::variables.push
                fi
            fi
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value common::OpValue::FnPush(fn_name_ref) is then
            fn_name_ref.clone = fn_name
            fn_name.as_str store.take_function_for_update = lambda_opt
            lambda_opt match
                std::Option::Some(lambda) => {
                    function lambda store gather_captures
                    lambda.split_body = lambda_ops = lambda
                    diagnostics lambda lambda_ops store resolve_identifiers
                    true = lambda.is_resolved
                    lambda_ops lambda common::Function::set_ops
                    lambda store.restore_function
                }
                std::Option::None => {
                }
            end
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value common::OpValue::PushArray(items_inner) is then
            items_inner common::clone_ops = owned_items_inner
            diagnostics resolve_errors function owned_items_inner store resolve_array_identifiers
            owned_items_inner common::OpValue::PushArray current_op common::Op::set_value
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value common::OpValue::ExprGroup(group_inner) is then
            group_inner common::clone_ops = owned_group_inner
            diagnostics function owned_group_inner store resolve_identifiers
            owned_group_inner common::OpValue::ExprGroup current_op common::Op::set_value
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value common::OpValue::Identifier(ident_ref) is then
            ident_ref.clone = ident
            if
                current_op
                    .location
                    .file
                    .as_str ident.as_str store.is_private_from
            then
                current_op.location.clone f"Declaration `{ident}` is private" common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                current_op op_index 1 - ops.set
                continue
            fi
            if resolve_errors ident.as_str current_op function store try_resolve_fn_ref then
                current_op op_index 1 - ops.set
                continue
            fi
            if ident.as_str current_op try_resolve_numeric_call then
                current_op op_index 1 - ops.set
                continue
            fi
            if ident.as_str current_op function try_resolve_trait_method_call then
                current_op op_index 1 - ops.set
                continue
            fi
            if resolve_errors ident.as_str current_op store try_resolve_enum_variant_ident then
                current_op op_index 1 - ops.set
                continue
            fi
            if ident.as_str current_op store try_resolve_qualified_trait_method then
                current_op op_index 1 - ops.set
                continue
            fi
            if ident.as_str current_op store try_resolve_type_qualified_method then
                current_op op_index 1 - ops.set
                continue
            fi
            resolve_errors ident.as_str current_op function store resolve_plain_identifier
            if current_op.value common::OpValue::FnCall(resolved_fn_name) is then
                current_op.location.clone = fold_location
                resolved_fn_name.clone = fold_function_name
                current_op op_index 1 - ops.set
                diagnostics fold_location fold_function_name.as_str op_index ops store try_fold_const_fn_call = op_index
                continue
            fi
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value common::OpValue::MatchArm is then
            diagnostics resolve_errors current_op function store resolve_match_op
            current_op op_index 1 - ops.set
            continue
        fi

        if current_op.value common::OpValue::IsCheck(is_enum_variant) is then
            is_enum_variant.clone = resolved_variant
            resolve_errors function current_op resolved_variant store resolve_enum_variant
            resolved_variant common::OpValue::IsCheck current_op common::Op::set_value
            current_op op_index 1 - ops.set
            continue
        fi
        current_op op_index 1 - ops.set
    done

    resolve_errors.reverse
    while resolve_errors.is_empty ! do
        resolve_errors.pop diagnostics.push_error
    done
}
# Try resolving compiler-owned numeric associated conversion calls.

pub fn try_resolve_numeric_call op:mut$common::Op ident:$str -> bool {
    ident "::" str::find = separator
    if separator 0 <= ! then
        false return
    fi
    ident 0 separator (u64) str::substring = target_name
    target_name.as_str common::parse_builtin = target_opt
    if target_opt.is_none then
        false return
    fi
    ident separator 2 + (u64) ident.length separator (u64) - 2 - str::substring = method
    if
        "from" method.as_str ==
        "from_bits" method.as_str == ||
        "round_from" method.as_str == ||
        "trunc_from" method.as_str == ||
        "wrapping_from" method.as_str == ||
        "from_codepoint_unchecked" method.as_str == ||
        "__from_decimal_parts" method.as_str == ||
        "__float_significand" method.as_str == ||
        "try_from" method.as_str == || !
    then
        false return
    fi
    target_opt.unwrap method common::NumericCall common::OpValue::NumericCall op common::Op::set_value
    true
}
# resolve_match_op — per-arm identifier resolution entry point.
# Registers struct-pattern field bindings as locals/globals and resolves
# enum-variant ordinals (delegating to resolve_enum_variant). Literal and
# wildcard arms need no resolution.

pub fn register_struct_pattern_binding
    store:mut$common::SymbolStore
    function:mut$common::Function
    binding_name:$str
{
    binding_name common::Variable::new = match_struct_variant
    if common::GLOBAL_SCOPE_LABEL function common::Function::name.as_str == then
        match_struct_variant binding_name.clone store.variables.set_str
    else
        if binding_name function common::Function::variables common::variable_list_contains ! then
            match_struct_variant function common::Function::variables.push
        fi
    fi
}

impl common::Op {
    pub fn set_match_pattern_value self:mut$common::Op pattern_value:common::PatternValue {
        if self.value common::OpValue::MatchArm(arm) is then
            arm.clone = updated_arm
            pattern_value updated_arm common::MatchArm::set_pattern_value
            updated_arm common::OpValue::MatchArm self.set_value
        fi
    }
}

pub fn resolve_match_op
    store:mut$common::SymbolStore
    function:mut$common::Function
    op:mut$common::Op
    errors:mut$std::List[error::CasaError]
    diagnostics:mut$error::Diagnostics
{
    op common::pattern_value_of match
        common::PatternValue::Struct(struct_pattern) => {
            struct_pattern.bindings.keys = pattern_keys
            for pattern_key in pattern_keys.iter do
                pattern_key struct_pattern
                    .bindings
                    .get
                    .unwrap = binding_name
                binding_name.as_str function store register_struct_pattern_binding
            done
        }
        common::PatternValue::EnumVariant(variant) => {
            errors function op variant store resolve_enum_variant
            variant common::PatternValue::EnumVariant op.set_match_pattern_value
        }
        common::PatternValue::Literal => {
        }
    end
    if op.value common::OpValue::MatchArm(arm) is then
        if arm.guard_ops.length 0 != then
            arm.clone = resolved_arm
            diagnostics function resolved_arm.guard_ops store resolve_identifiers
            resolved_arm common::OpValue::MatchArm op common::Op::set_value
        fi
    fi
}
# Try resolving `&name` and `&K::method` function references. Returns true
# if the identifier begins with `&`, in which case the op has been rewritten
# (or an error pushed) and the caller should skip further resolution.

pub fn try_resolve_fn_ref
    store:mut$common::SymbolStore
    function:mut$common::Function
    op:mut$common::Op
    ident:$str
    resolve_errors:mut$std::List[error::CasaError]
-> bool {
    if '&' 0 ident.at != then
        false return
    fi
    ident 1 ident.length 1 - str::substring = ref_name
    if 0 ref_name.length == then
        op common::Op::location.clone "Expected function name after `&`".to_str common::ErrorKind::Syntax error::CasaError::new resolve_errors.push
        true return
    fi
    ref_name.as_str "::" str::split = ref_parts
    if 2 ref_parts.length == "drop" ref_parts.length 1 - ref_parts.get.as_str == && then
        op common::Op::location.clone "Reserved `drop` methods cannot be referenced".to_str common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
        true return
    fi
    if 3 ref_parts.length == then
        0 ref_parts.get.as_str common::parse_type_str = receiver_type
        1 ref_parts.get.clone common::GenericType::new common::Type::Generic = qualifier_type
        if op.type_hint std::Option::Some(hint) is then
            if hint.type_params std::Option::Some(type_arguments) is then
                type_arguments.clone 1 ref_parts.get.clone common::GenericType common::Type::Generic = qualifier_type
            fi
        fi
        2 ref_parts.get = method_name
        store receiver_type qualifier_type method_name.as_str semantics::resolve_qualified_method_semantics
        = method_opt
        if method_opt std::Option::Some(method) is then
            if method.function_name.as_str store.is_function_unsafe std::Option::Some(is_unsafe) is then
                if is_unsafe then
                    op common::Op::location.clone f"Unsafe function `{method.function_name}` cannot be referenced" common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                    true return
                fi
                method.function_name.clone common::OpValue::FnPush op common::Op::set_value
                true return
            fi
        fi
    fi
    if ref_name.as_str "::" str::find 0 <= then
        ref_name.as_str 0 ref_name.as_str "::" str::find(u64) str::substring = ref_type_var
        ref_type_var.as_str function common::Function::stack_effect common::StackEffect::trait_bounds.get_str = ref_bound_opt
        if ref_bound_opt.is_some then
            ref_name.as_str ref_name.as_str "::" str::find 2 + (u64) ref_name.length ref_name.as_str "::" str::find(u64) - 2 - str::substring = ref_trait_method
            ref_type_var.to_str common::Type::TypeVar = receiver
            receiver ref_trait_method common::DeferredTraitCall::unresolved
            common::OpValue::TraitMethodRef op common::Op::set_value
            true return
        fi
    fi
    if 2 ref_parts.length == then
        0 ref_parts.get.as_str common::parse_type_str = receiver_type
        1 ref_parts.get = method_name
        store std::Option[common::Function]::None receiver_type method_name.as_str semantics::resolve_method_semantics
        = method_opt
        if method_opt std::Option::Some(method) is then
            if method.function_name.as_str store.is_function_unsafe std::Option::Some(is_unsafe) is then
                if is_unsafe then
                    op common::Op::location.clone f"Unsafe function `{method.function_name}` cannot be referenced" common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                    true return
                fi
                method.function_name.clone common::OpValue::FnPush op common::Op::set_value
                true return
            fi
        fi
    fi
    ref_name.as_str store.is_function_unsafe = ref_is_unsafe_opt
    if ref_is_unsafe_opt std::Option::Some(ref_is_unsafe) is then
        if ref_is_unsafe then
            op common::Op::location.clone f"Unsafe function `{ref_name}` cannot be referenced" common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
            true return
        fi
        ref_name.clone common::OpValue::FnPush op common::Op::set_value
    else
        op common::Op::location.clone f"Function `{ref_name}` is not defined" common::ErrorKind::UndefinedName error::CasaError::new resolve_errors.push
    fi
    true
}
# Try resolving `Enum::Variant` identifiers. Returns true if the enum is
# known (op rewritten, or undefined-variant error pushed).

pub fn try_resolve_enum_variant_ident
    store:mut$common::SymbolStore
    op:mut$common::Op
    ident:$str
    resolve_errors:mut$std::List[error::CasaError]
-> bool {
    if ident "::" str::find 0 <= ! then
        false return
    fi
    ident "::" str::find = separator
    ident 0 separator (u64) str::substring = enum_name
    enum_name.as_str store.enums.get_str = enum_opt
    if enum_opt.is_none then
        false return
    fi
    ident separator 2 + (u64) ident.length separator (u64) - 2 - str::substring = binding_name
    enum_opt.unwrap = casa_enum
    binding_name.as_str casa_enum common::CasaEnum::variants common::string_list_index = ordinal
    if 0 ordinal < then
        op common::Op::location.clone f"Variant `{binding_name}` is not defined in enum `{enum_name}`" common::ErrorKind::UndefinedName error::CasaError::new resolve_errors.push
    else
        ordinal std::Option::Some binding_name enum_name common::EnumVariant::new = enum_variant
        enum_variant common::OpValue::PushEnumVariant op common::Op::set_value
    fi
    true
}
# Preserve `K::method` until the checked body has a concrete specialization.

pub fn try_resolve_trait_method_call
    function:mut$common::Function
    op:mut$common::Op
