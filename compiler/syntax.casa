                    function.clone_for_import = inherent_function
                    inherent_name.clone inherent_function Function::set_name
                    inherent_function inherent_name parser
                        .store
                        .functions
                        .set
                fi
            fi
        done
        trait_methods trait_impl TraitImpl::set_methods
        trait_impl trait_impl_key.clone parser
            .store
            .trait_impls
            .set
    done
}

fn parse_impl_block parser:mut$Parser cursor:mut$TokenCursor {
    fallback_token parser.state "impl" cursor expect_token_value.unwrap_or = impl_token

    # Parse optional type parameters with trait bounds
    List[String]::new = type_vars
    Map[String List[TraitBound]]::new = trait_bounds
    Map[String BuiltinType]::new = const_params
    cursor.peek = tvars_opt
    if tvars_opt Option::Some(tvars) is then
        if "[" tvars Token::value.as_str == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.into_parts = const_params = trait_bounds = all_type_param_names
            # `names` mixes type variables and constant parameters; keep only
            # the type variables here (ADR-0152).
            for candidate_name in all_type_param_names.iter do
                if candidate_name const_params.has ! then
                    candidate_name.clone type_vars.push
                fi
            done
        fi
    fi

    parser.state cursor parse_type_ast = impl_type
    type_vars string_list_to_set = type_var_set
    type_var_set impl_type canonicalize_type_var = impl_type
    # Constant parameters in the implemented type are constants, not type
    # variables, so `array[T N]` keeps `N` symbolic (ADR-0152).
    if 0 const_params.keys.length != then
        const_params impl_type rewrite_type_const_params = impl_type
    fi

    # Get base type name (without type params)
    impl_type.match_base = base_type

    List[TraitBound]::new = implemented_traits
    Map[String String]::new = trait_impl_methods
    cursor.peek = colon_opt
    if colon_opt Option::Some(colon) is then
        if ":" colon.value.as_str == then
            cursor.pop drop
            true = parse_implemented_traits
            while parse_implemented_traits do
                fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = trait_token
                parser.state trait_token cursor parse_bound_type_args = trait_args
                trait_token.value parser
                    .store
                    .traits
                    .get = trait_opt
                0 (u64) = argument_index
                while argument_index trait_args.length > do
                    type_var_set argument_index trait_args.get canonicalize_type_var
                    argument_index trait_args.set
                    1 += argument_index
                done
                if trait_opt Option::Some(casa_trait) is then
                    if trait_args.length casa_trait.type_params.length != then
                        trait_token.location f"Trait `{trait_token.value}` expects {casa_trait.type_params.length} type argument(s), got {trait_args.length}" ErrorKind::Syntax parser.state.record_error_string
                    else
                        trait_args trait_token.value.clone TraitBound implemented_traits.push
                    fi
                else
                    trait_args trait_token.value.clone TraitBound implemented_traits.push
                fi
                cursor.peek = plus_opt
                if plus_opt Option::Some(plus) is then
                    if "+" plus.value.as_str == then
                        cursor.pop drop
                    else
                        false = parse_implemented_traits
                    fi
                else
                    false = parse_implemented_traits
                fi
            done
        fi
    fi

    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop
    while true do
        cursor.peek = fn_opt
        if fn_opt.is_none then
            break
        fi
        false = is_unsafe_method
        if fn_opt Option::Some(fn_token) is then
            if "unsafe" fn_token Token::value.as_str == then
                true = is_unsafe_method
                cursor.pop drop
            elif "fn" fn_token Token::value.as_str != then
                break
            fi
        fi
        cursor parser parse_function = function
        is_unsafe_method function Function::set_is_unsafe
        function Function::name = method_name: $String
        if "drop" method_name.as_str == 0 implemented_traits.length != && then
            function.location "`drop` must be declared in an inherent implementation" ErrorKind::InvalidScope parser.state.record_error
        fi
        String::new = fn_name
        if 0 implemented_traits.length != then
            0 implemented_traits.get trait_bound_to_type.format = trait_name
            f"{base_type}::{trait_name}::{method_name}" = fn_name
            fn_name.clone method_name.clone trait_impl_methods.set
        else
            f"{base_type}::{method_name}" = fn_name
        fi
        fn_name.clone function Function::set_name
        # Merge inherited type vars, trait bounds, and constant parameters
        if 0 type_vars.length != 0 const_params.keys.length != || then
            const_params trait_bounds type_vars function parser inject_implementation_parameters
        fi
        if
            fn_name.as_str parser
                .store
                .functions
                .get_str
                .is_some
        then
            function Function::location f"Identifier `{fn_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error_string
        fi
        function fn_name parser.put_function
    done
    fallback_token parser.state "}" cursor expect_token_value.unwrap_or drop

    for implemented_trait in implemented_traits.iter do
        Map[String String]::new = cloned_methods
        for pair in trait_impl_methods.iter do
            pair.second.clone pair.first.clone cloned_methods.set
        done
        Map[String List[TraitBound]]::new = cloned_bounds
        for pair in trait_bounds.iter do
            pair.second.clone pair.first.clone cloned_bounds.set
        done
        impl_token.location.clone cloned_methods cloned_bounds type_vars.clone
        implemented_trait.clone impl_type clone_type TraitImpl
        parser register_trait_impl
    done
}

# ============================================================================
# parse_match_block - parse a full match construct (match ... end)
# ============================================================================

fn is_match_arm_boundary parser:mut$Parser cursor:mut$TokenCursor -> bool {
    cursor TokenCursor::pos = pos
    cursor TokenCursor::tokens = token_list: $List[Token]
    if pos 1 + token_list.length < then
        false return
    fi
    pos token_list.get = token
    pos 1 + token_list.get = next_token

    # _ => or _ if ...
    if MATCH_WILDCARD token Token::value.as_str == then
        if "=>" next_token Token::value.as_str == then
            true return
        fi
        if "if" next_token Token::value.as_str == then
            true return
        fi
    fi
    # literal => or literal if ...
    if TokenKind::Literal token Token::kind == then
        if "=>" next_token Token::value.as_str == then
            true return
        fi
        if "if" next_token Token::value.as_str == then
            true return
        fi
    fi
    if TokenKind::Identifier token Token::kind != then
        false return
    fi
    # Identifier => or Identifier if ...
    if "=>" next_token Token::value.as_str == then
        true return
    fi
    if "if" next_token Token::value.as_str == then
        true return
    fi
    # StructName { ... } =>
    if
        "{" next_token Token::value.as_str ==
        token Token::value.as_str parser
            .store
            .structs
            .get_str
            .is_some parser.syntax_only || &&
    then
        true return
    fi
    # EnumName::Variant(bindings) => or EnumName::Variant(bindings) if ...
    if "(" next_token Token::value.as_str == then
        token Token::value.as_str "::" str::find = separator
        if 0 separator > then
            pos 2 + = scan_pos
            while scan_pos token_list.length > do
                if ")" scan_pos token_list.get Token::value.as_str == then
                    if scan_pos 1 + token_list.length > then
                        scan_pos 1 + token_list.get Token::value.as_str = after_paren: $str
                        if "=>" after_paren.as_str == then
                            true return
                        fi
                        if "if" after_paren.as_str == then
                            true return
                        fi
                    fi
                    break
                fi
                1 += scan_pos
            done
        fi
    fi
    false
}

fn parse_struct_match_pattern
    parser:mut$Parser
    name_token:$Token
    cursor:mut$TokenCursor
-> StructPattern {
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop
    name_token Token::value.as_str parser
        .store
        .structs
        .get_str = struct_opt
    if struct_opt.is_none parser.syntax_only ! && then
        name_token Token::location f"Struct `{name_token Token::value.as_str}` is not defined" ErrorKind::UndefinedName parser.state.record_error_string
    fi
    Map[String String]::new = bindings

    while true do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token Token::location "Unexpected end of input in struct pattern" ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
        if next_opt Option::Some(next) is then
            if "}" next Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi
        fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = field_token
        fallback_token parser.state ":" cursor expect_token_value.unwrap_or drop
        fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = var_token
        var_token Token::value.clone field_token Token::value.clone bindings.set
    done

    bindings name_token Token::value.clone StructPattern
}
# parse_pattern_terminator — consume the `=>` that separates a match-arm
# pattern from its body. If an `if` keyword appears first the guard
# expression is collected until `=>`. Returns the (possibly empty) list of
# guard ops. The trailing `=>` token is always consumed.
#
# The guard expression may contain a nested `match` block whose arms also
# use `=>`; a match-depth counter skips those nested arrows so only the
# outer arm terminator ends the guard.

fn parse_pattern_terminator
    parser:mut$Parser
    cursor:mut$TokenCursor
    function_name:$str
-> List[Op] {
    List[Op]::new = guard_ops
    cursor.peek = guard_peek
    if { Token::value.as_str "if" == } guard_peek.filter.is_some then
        cursor.pop drop # consume `if`
        0 = match_depth
        while cursor.is_finished ! do
            cursor.peek = next_opt
            if next_opt.is_none then
                break
            fi
            next_opt.unwrap Token::value.as_str = next_value: $str
            if "=>" next_value.as_str == 0 match_depth == && then
                break
            fi
            cursor.pop = guard_token_opt
            if guard_token_opt.is_none then
                break
            fi
            guard_token_opt.unwrap = guard_token
            if "match" guard_token Token::value.as_str == then
                1 += match_depth
            elif "end" guard_token Token::value.as_str == 0 match_depth != && then
                1 -= match_depth
            fi
            if TokenKind::FstringStart guard_token Token::kind == then
                guard_ops function_name cursor guard_token parser handle_fstring
                continue
            fi
            guard_ops function_name cursor guard_token parser token_to_op
        done
    fi
    fallback_token parser.state "=>" cursor expect_token_value.unwrap_or drop
    guard_ops
}

fn parse_literal_match_pattern token:$Token parser:mut$Parser -> LiteralPattern {
    token Token::value.as_str = value: $str
    if "true" value.as_str == then
        "true".to_str true LiteralValue::Bool LiteralPattern return
    fi
    if "false" value.as_str == then
        "false".to_str false LiteralValue::Bool LiteralPattern return
    fi
    if 0 value.at.is_digit value is_negative_integer_literal || then
        value.to_str value str_to_int value.to_str IntegerLiteral::new LiteralValue::Int LiteralPattern return
    fi
    if value char_literal_codepoint Option::Some(character) is then
        value.to_str character LiteralValue::Char LiteralPattern return
    fi
    if '"' 0 value.at == '"' value.length 1 - value.at == && then
        value.length = value_length
        value 1 value_length 2 - str::substring = string_value
        value.to_str string_value LiteralValue::Str LiteralPattern return
    fi
    token Token::location f"Unsupported literal in match arm: `{value}`" ErrorKind::UnexpectedToken parser.state.record_error_string
    # Unreachable
    "".to_str 0 IntegerLiteral::from_int LiteralValue::Int LiteralPattern
}
# Parse one match-arm pattern (wildcard, literal, struct, bare ident, or
# Enum::Variant) plus its optional guard, append the OpMatchArm to `ops`.

fn parse_match_arm_pattern
    parser:mut$Parser
    arm_token:$Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$List[Op]
{
    if MATCH_WILDCARD arm_token Token::value.as_str == then
        function_name cursor parser parse_pattern_terminator = wildcard_guard_ops
        Option::None MATCH_WILDCARD.to_str "".to_str EnumVariant::new = wildcard
        wildcard_guard_ops wildcard PatternValue::EnumVariant MatchArm::new = wildcard_arm
        arm_token Token::location wildcard_arm OpValue::MatchArm Op::new ops.push
    elif TokenKind::Literal arm_token Token::kind == then
        function_name cursor parser parse_pattern_terminator = literal_guard_ops
        parser arm_token parse_literal_match_pattern = literal_pattern
        literal_guard_ops literal_pattern PatternValue::Literal MatchArm::new = literal_arm
        arm_token Token::location literal_arm OpValue::MatchArm Op::new ops.push
    elif TokenKind::Identifier arm_token Token::kind != then
        arm_token Token::location "Expected match pattern or `_`" ErrorKind::UnexpectedToken parser.state.record_error
    elif
        { Token::value.as_str "{" == } cursor
            .peek
            .filter
            .is_some
    then
        cursor arm_token parser parse_struct_match_pattern = struct_pattern
        function_name cursor parser parse_pattern_terminator = struct_guard_ops
        struct_guard_ops struct_pattern PatternValue::Struct MatchArm::new = struct_arm
        arm_token Token::location struct_arm OpValue::MatchArm Op::new ops.push
    elif arm_token Token::value.as_str "::" str::find 0 > then
        function_name cursor parser parse_pattern_terminator = bare_guard_ops
        Option::None arm_token Token::value.clone "".to_str EnumVariant::new = bare_variant
        bare_guard_ops bare_variant PatternValue::EnumVariant MatchArm::new = bare_arm
        arm_token Token::location bare_arm OpValue::MatchArm Op::new ops.push
    else
        arm_token Token::value.as_str "::" str::find = separator
        arm_token Token::value.as_str 0 separator (u64) str::substring = enum_name
        arm_token Token::value.as_str separator 2 + (u64) arm_token Token::value.as_str.length separator (u64) - 2 - str::substring = variant_name

        List[String]::new = bindings
        cursor.peek = paren_opt
        if { Token::value.as_str "(" == } paren_opt.filter.is_some then
            cursor.pop drop
            while true do
                cursor.peek = inner_opt
                if inner_opt.is_none then
                    arm_token Token::location "Unexpected end of input in match arm bindings" ErrorKind::UnexpectedToken parser.state.record_error
                    parser.state.mark_output_unusable
                    break
                fi
                if inner_opt Option::Some(inner) is then
                    if ")" inner Token::value.as_str == then
                        cursor.pop drop
                        break
                    fi
                fi
                fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = binding_token
                binding_token Token::value.clone bindings.push
            done
        fi

        function_name cursor parser parse_pattern_terminator = enum_guard_ops
        Option::None variant_name enum_name EnumVariant::new = variant
        bindings variant EnumVariant::set_bindings
        enum_guard_ops variant PatternValue::EnumVariant MatchArm::new = variant_arm
        arm_token Token::location variant_arm OpValue::MatchArm Op::new ops.push
    fi
}
# Parse a match-arm body (either a `{...}` block or a single-line expression
# up to the next arm boundary / `end`) and append its ops to `ops`.

fn parse_match_arm_body
    parser:mut$Parser
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$List[Op]
{
    cursor.peek = body_peek
    if { Token::value.as_str "{" == } body_peek.filter.is_some then
        function_name cursor parser parse_block_ops = block_ops
        block_ops ops.append
        return
    fi
    while cursor.is_finished ! do
        if cursor parser is_match_arm_boundary then
            break
        fi
        cursor.peek = end_peek
        if { Token::value.as_str "end" == } end_peek.filter.is_some then
            break
        fi
        cursor.pop = body_token_opt
        if body_token_opt.is_none then
            break
        fi
        body_token_opt.unwrap = body_token
        if TokenKind::FstringStart body_token Token::kind == then
            ops function_name cursor body_token parser handle_fstring
            continue
        fi
        ops function_name cursor body_token parser token_to_op
    done
}

fn parse_match_block
    parser:mut$Parser
    token:$Token
    cursor:mut$TokenCursor
    function_name:$str
-> List[Op] {
    List[Op]::new = ops
    token Token::location OpValue::MatchStart Op::new ops.push

    while true do
        fallback_token parser.state cursor expect_token.unwrap_or = arm_token
        if "end" arm_token Token::value.as_str == then
            arm_token Token::location OpValue::MatchEnd Op::new ops.push
            if parser.syntax_only then
                arm_token Token::location Location::span Span::offset
                token Token::location Location::span Span::offset
                SyntaxSpanKind::MatchForm parser.state.record_span
            fi
            break
        fi
        ops function_name cursor arm_token parser parse_match_arm_pattern
        ops function_name cursor parser parse_match_arm_body
        if parser.syntax_only then
            cursor.previous_offset
            arm_token Token::location Location::span Span::offset
            SyntaxSpanKind::MatchArm parser.state.record_span
        fi
    done
    ops
}

# ============================================================================
# _handle_keyword_import - parse import path
# ============================================================================

fn is_path_specifier spec:$str -> bool {
    spec ".casa" str::ends_with
    spec "/" str::contains ||
}

fn dir_of_path path:$str -> String {
    Option[u64]::None = last_slash
    0 (u64) = scan
    while scan path.length > do
        if '/' scan path.at == then
            scan Option::Some = last_slash
        fi
        1 += scan
    done
    if last_slash Option::Some(index) is then
        path 0 index 1 + str::substring
        return
    fi
    "".to_str
}

fn resolve_import parser:mut$Parser importing_file:$str spec:$str location:$Location -> String {
    importing_file dir_of_path = source_dir
    importing_file absolute_normalize_path = importing_normalized
    # Path-style: keep existing semantics (no existence check).
    if spec is_path_specifier then
        if spec "/" str::starts_with then
            spec normalize_path
            return
        fi
        f"{source_dir}{spec}" = combined
        combined.as_str absolute_normalize_path
        return
    fi
    # Module-style: probe source dir, then each search path. First hit wins.
    # Skip a same-dir match that resolves to the importing file itself, so an
    # example named `argparse.casa` importing "argparse" still finds the
    # library copy via -L.
    # `searched` accumulates probed dirs for the not-found error message.
    f"{source_dir}{spec}.casa" = source_candidate_path
    source_candidate_path.as_str normalize_path = source_candidate
    if source_candidate.as_str file::exists then
        source_candidate.as_str absolute_normalize_path = resolved_candidate
        if resolved_candidate.as_str importing_normalized.as_str != then
            resolved_candidate return
        fi
    fi
    if 0 source_dir.length == then
        ".".to_str
    else
        source_dir
    fi
    = first_dir
    f"\n  {first_dir}" = searched
    for base in parser.search_paths.iter do
        f"{searched}\n  {base}" = searched
        f"{base}/{spec}.casa" = candidate_path
        candidate_path.as_str normalize_path = candidate
        if candidate.as_str file::exists then
            candidate.as_str absolute_normalize_path
            return
        fi
    done
    location f"module `{spec}` not found, searched:{searched}" ErrorKind::Syntax parser.state.record_error_string
    parser.state.mark_output_unusable
    "".to_str
}

fn parse_selective_import_symbols
    cursor:mut$TokenCursor
    location:$Location
    state:mut$ParseState
-> List[String] {
    List[String]::new = symbols
    fallback_token state "{" cursor expect_token_value.unwrap_or drop
    while true do
        cursor.pop = symbol_opt
        if symbol_opt.is_none then
            location "Unclosed selective import list" ErrorKind::UnmatchedBlock state.record_error
            state.mark_output_unusable
            symbols return
        fi
        symbol_opt.unwrap = symbol_token
        if TokenKind::Comment symbol_token Token::kind == then
            continue
        fi
        if TokenKind::Newline symbol_token Token::kind == then
            continue
        fi
        if "}" symbol_token Token::value.as_str == then
            if 0 symbols.length == then
                symbol_token Token::location "Selective import list cannot be empty" ErrorKind::Syntax state.record_error
            fi
            symbols return
        fi
        if TokenKind::Identifier symbol_token Token::kind != then
            symbol_token Token::location "Expected identifier in selective import list" ErrorKind::UnexpectedToken state.record_error
        fi
        symbol_token Token::value.clone symbols.push
    done
    symbols
}

fn handle_keyword_import parser:mut$Parser cursor:mut$TokenCursor -> Op {
    fallback_token parser.state TokenKind::Literal cursor expect_token_kind.unwrap_or = path_token
    parser.state cursor path_token get_op_literal = literal_op
    if literal_op.value OpValue::PushStr(spec) is then
        path_token Token::location.clone = path_location
        if parser.syntax_only then
            spec.clone
        else
            path_location Location::file = importing_file: $String
            path_location spec.as_str importing_file.as_str parser resolve_import
        fi
        = resolved

        cursor.peek = next_opt
        if { Token::value.as_str "{" == } next_opt.filter.is_some then
            parser.state path_location cursor parse_selective_import_symbols = symbols
            symbols resolved SelectiveImport = selective
            path_location selective OpValue::ImportFileSelective Op::new return
        fi
        path_location resolved OpValue::ImportFile Op::new return
    fi
    path_token Token::location "Expected string literal for import path" ErrorKind::UnexpectedToken parser.state.record_error
    # Unreachable - parser.state.record_error exits
    path_token Token::location "".to_str OpValue::ImportFile Op::new
}

fn handle_selective_import parser:mut$Parser selective:SelectiveImport location:$Location {
    selective.path = import_path: $String
    if 0 import_path.length == then
        return
    fi
    if import_path.as_str parser.included_files.has_str then
        return
    fi

    symbol_store_new = imported_store
    Set[String]::new = inherited_symbols
    Set[String]::new = inherited_impls
    if import_path.as_str parser.selective_import_cache.get_str Option::Some(cached_import) is then
        cached_import.store.clone_for_selective_import = imported_store
        cached_import.inherited_symbols.clone = inherited_symbols
        cached_import.inherited_impls.clone = inherited_impls
    else
        Set[String]::new = included_files
        for included_file in parser.included_files.iter do
            included_file.clone included_files.add
        done
        import_path.clone included_files.add
        parser.store.clone = base_store
        parser.store.declaration_names = inherited_symbols
        parser
            .store
            .trait_impls
            .keys string_list_to_set = inherited_impls
        base_store included_files import_path.as_str parser.analyze_import = import_result
        import_result match
            Result::Ok(imported_result) => {
                imported_result.into_parts = imported_diagnostics = imported_store_result = imported_ops_opt
                location imported_diagnostics parser
                    .state
                    .diagnostics
                    .merge_at_encounter
                imported_ops_opt match
                    Option::Some(imported_ops) => {
                        inherited_impls.clone inherited_symbols.clone included_files imported_ops imported_store_result
                        ImportedModule = imported_module
                        imported_module.store.clone_for_selective_import = imported_store
                        imported_module import_path.clone parser.selective_import_cache.set
                    }
                    Option::None => {
                        parser.state.mark_output_unusable
                        return
                    }
                end
            }
            Result::Error(read_error) => {
                location f"Cannot read import `{import_path}`: {read_error.to_str}" ErrorKind::Syntax parser
                    .state
                    .diagnostics
                    .record_error_at_encounter_string
                parser.state.mark_output_unusable
                return
            }
        end
    fi

    inherited_impls
    inherited_symbols
    location
    selective.symbols.clone
    parser.store
    imported_store
    merge_selective_import_closure_with_inherited = merge_result
    merge_result match
        Result::Ok(_) => {
        }
        Result::Error(merge_diagnostics) => {
            location merge_diagnostics parser
                .state
                .diagnostics
                .merge_at_encounter
            parser.state.mark_output_unusable
            return
        }
    end
}

fn handle_full_import
    parser:mut$Parser
    import_path:String
    location:$Location
    expanded:mut$List[Op]
{
    if 0 import_path.length == import_path.as_str parser.included_files.has_str || then
        return
    fi
    import_path.clone parser.included_files.add
    import_path.as_str parser.selective_import_cache.remove_str = cached_import_opt
    cached_import_opt match
        Option::Some(cached_import) => {
            cached_import match
                ImportedModule {
                    store: cached_store ops: cached_ops included_files: cached_included_files
                } => {
                    for included_file in cached_included_files.iter do
                        included_file.clone parser.included_files.add
                    done
                    cached_store parser.store.merge_import
                    cached_ops expanded.append
                }
            end
            return
        }
        Option::None => {
        }
    end

    parser.store.clone = import_store
    parser.included_files.to_list string_list_to_set = imported_files
    import_store imported_files import_path.as_str parser.analyze_import = import_result
    imported_files = parser.included_files
    import_result match
        Result::Ok(imported_result) => {
            imported_result.into_parts = imported_diagnostics = imported_store_result = import_ops_opt
            location imported_diagnostics parser
                .state
                .diagnostics
                .merge_at_encounter
            import_ops_opt match
                Option::Some(import_ops) => {
                    imported_store_result parser.store.merge_import
                    import_ops expanded.append
                }
                Option::None => parser.state.mark_output_unusable
            end
        }
        Result::Error(read_error) => {
            location f"Cannot read import `{import_path}`: {read_error.to_str}" ErrorKind::Syntax parser
                .state
                .diagnostics
                .record_error_at_encounter_string
            parser.state.mark_output_unusable
        }
    end
}

# ============================================================================
# handle_question_operator - preserve `?` for type-aware lowering
# ============================================================================
#
# Typechecking resolves the source value and enclosing return type before it
# lowers this operation through the structural propagation methods.
#

fn handle_question_operator token:$Token ops:mut$List[Op] {
    token
        .location
        .span
        .offset = offset
    # `$` cannot occur in a source identifier, so user variables cannot collide with this local.
    f"$question_{offset}" OpValue::Question = question
    token Token::location question Op::new ops.push
}

# ============================================================================
# handle_keyword_for - parse `for <ident> in <expr> do <body> done`
# ============================================================================
#
# The for-loop is desugared at parse time into a `while` loop over the
# iterator's `next` method. The synthesized ops use only existing op kinds,
# so no new typechecker or bytecode support is required.
#
# Source `for x in <iter> do <body> done` lowers to roughly:
#
#     <iter_expr_ops>
#     = $for_iter_FILE_N
#     while
#         $for_iter_FILE_N .next
#         = $for_opt_FILE_N
#         $for_opt_FILE_N .is_some
#     do
#         $for_opt_FILE_N .unwrap
#         = x
#         <body_ops>
#     done
#
# The hidden variable names embed the source offset so nested for-loops do
# not collide. Nested `while`/`for` inside the body or the iterable
# expression are detected via depth counting on `while`/`for` openers and
# `done` closers so the enclosing `do`/`done` pair is identified correctly.

fn handle_keyword_for
    parser:mut$Parser
    token:$Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$List[Op]
{
    fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = loop_var_token
    loop_var_token Token::value.clone = loop_var_name
    fallback_token parser.state "in" cursor expect_token_value.unwrap_or drop

    token Token::location.clone = for_loc
    for_loc Location::span Span::offset = for_offset
    for_loc.file.as_str str_hash = for_file_hash
    f"$for_iter_{for_file_hash}_{for_offset}" = hidden_iter_name
    f"$for_opt_{for_file_hash}_{for_offset}" = hidden_opt_name

    # Iterable-expression phase — emit ops until the matching `do`. These ops
    # leave the iterator value on the stack, which the synthesized
    # OpAssignVar below pops into the hidden iterator local.
    0 = nesting_depth
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            for_loc.clone "Unclosed `for` loop" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            return
        fi
        peek_opt.unwrap = peeked_token
        if "do" peeked_token Token::value.as_str == 0 nesting_depth == && then
            cursor.pop drop
            break
        fi
        if "while" peeked_token Token::value.as_str == then
            1 += nesting_depth
        fi
        if "done" peeked_token Token::value.as_str == 0 nesting_depth > && then
            nesting_depth 1 - = nesting_depth
        fi
        cursor.pop drop
        if TokenKind::FstringStart peeked_token Token::kind == then
            ops function_name cursor peeked_token parser handle_fstring
            continue
        fi
        ops function_name cursor peeked_token parser token_to_op
    done

    # Loop preamble: store iterator into hidden local, then open the while
    # loop with the `next`/`is_some` condition.
    for_loc.clone hidden_iter_name.clone OpValue::AssignVar Op::new ops.push
    for_loc.clone OpValue::WhileStart Op::new ops.push
    for_loc.clone hidden_iter_name OpValue::PushVar Op::new ops.push
    for_loc.clone "next".to_str OpValue::MethodCall Op::new ops.push
    for_loc.clone hidden_opt_name.clone OpValue::AssignVar Op::new ops.push
    for_loc.clone hidden_opt_name.clone OpValue::PushVar Op::new ops.push
    for_loc.clone "is_some".to_str OpValue::MethodCall Op::new ops.push
    for_loc.clone OpValue::WhileCondition Op::new ops.push
    for_loc.clone hidden_opt_name OpValue::PushVar Op::new ops.push
    for_loc.clone "unwrap".to_str OpValue::MethodCall Op::new ops.push
    for_loc.clone loop_var_name OpValue::AssignVar Op::new ops.push

    # Body phase — emit ops until the matching `done`, then close the while.
    0 = body_nesting_depth
    while true do
        cursor.peek = body_peek_opt
        if body_peek_opt.is_none then
            for_loc.clone "Unclosed `for` loop body" ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            return
        fi
        body_peek_opt.unwrap = body_token
        if "done" body_token Token::value.as_str == 0 body_nesting_depth == && then
            cursor.pop drop
            body_token Token::location OpValue::WhileEnd Op::new ops.push
            if parser.syntax_only then
                body_token Token::location Location::span Span::offset
                token Token::location Location::span Span::offset
                SyntaxSpanKind::ControlForm parser.state.record_span
            fi
            return
        fi
        if "while" body_token Token::value.as_str == then
            1 += body_nesting_depth
        fi
        if "done" body_token Token::value.as_str == 0 body_nesting_depth > && then
            body_nesting_depth 1 - = body_nesting_depth
        fi
        cursor.pop drop
        if TokenKind::FstringStart body_token Token::kind == then
            ops function_name cursor body_token parser handle_fstring
            continue
        fi
        ops function_name cursor body_token parser token_to_op
    done
}

# ============================================================================
# get_op_keyword - handle all keywords
# ============================================================================

fn get_op_keyword
    parser:mut$Parser
    token:$Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$List[Op]
{
    token Token::value.as_str keyword_from_str = keyword_opt
    if keyword_opt.is_none then
        token Token::location f"Token `{token Token::value.as_str}` is not a keyword" ErrorKind::Syntax parser.state.record_error_string
    fi
    keyword_opt.unwrap = keyword

    # unsafe function declaration or lexical block
    if KeywordKind::Unsafe keyword == then
        cursor.peek = unsafe_next_opt
        if unsafe_next_opt Option::Some(unsafe_next) is then
            if "fn" unsafe_next Token::value.as_str == then
                parser token Token::location "Functions" function_name require_global_scope
                cursor parser parse_function = function
                true function Function::set_is_unsafe
                if
                    function Function::name parser
                        .store
                        .functions
                        .get
                        .is_some
                then
                    function Function::location f"Identifier `{function Function::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error_string
                fi
                function Function::name.clone = unsafe_function_name
                function unsafe_function_name.clone parser.put_function
                return
            fi
            if "{" unsafe_next Token::value.as_str == then
                token Token::location OpValue::UnsafeStart Op::new ops.push
                function_name cursor parser parse_block_ops = unsafe_ops
                unsafe_ops ops.append
                token Token::location OpValue::UnsafeEnd Op::new ops.push
                return
            fi
        fi
        token Token::location "Expected `fn` or `{` after `unsafe`" ErrorKind::Syntax parser.state.record_error
        return
    fi

    # move { ... } -> closure that owns its affine captures
    if KeywordKind::Move keyword == then
        cursor.peek = move_next_opt
        if move_next_opt Option::Some(move_next) is then
            if "{" move_next Token::value.as_str == then
                f"lambda__{function_name}_o{token Token::location Location::span Span::offset}" = lambda_name
                lambda_name.as_str cursor parser parse_block_ops = lambda_ops
                token Token::location.clone lambda_ops lambda_name.clone Function::new = lambda_function
                true lambda_function Function::set_captures_by_move
                lambda_function lambda_name.clone parser.put_function
                token Token::location lambda_name OpValue::FnPush Op::new ops.push
                return
            fi
        fi
        token Token::location "Expected `{` after `move`" ErrorKind::Syntax parser.state.record_error
        return
    fi

    # Simple keyword -> OpValue lookup
    keyword keyword_to_op_value = simple_opt
    simple_opt match
        Option::Some(simple) => {
            if parser.syntax_only then
                token Token::location Location::span Span::offset
                simple parser.state.record_control_op
            fi
            token Token::location simple Op::new ops.push
            return
        }
        Option::None => {
        }
    end

    # end without match
    if KeywordKind::End keyword == then
        token Token::location "`end` without matching `match`" ErrorKind::UnmatchedBlock parser.state.record_error
    fi

    # enum
    if KeywordKind::EnumKw keyword == then
        parser token Token::location "Enums" function_name require_global_scope
        cursor.retreat
        cursor parser parse_enum = casa_enum
        if
            casa_enum CasaEnum::name parser
                .store
                .enums
                .get
                .is_some
        then
            casa_enum CasaEnum::location f"Enum `{casa_enum CasaEnum::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error_string
        fi
        casa_enum CasaEnum::name.clone = enum_name
        casa_enum enum_name.clone parser.put_enum
        return
    fi

    # fn
    if KeywordKind::Fn keyword == then
        parser token Token::location "Functions" function_name require_global_scope
        cursor.retreat
        cursor parser parse_function = function
        if
            function Function::name parser
                .store
                .functions
                .get
                .is_some
        then
            function Function::location f"Identifier `{function Function::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error_string
        fi
        function Function::name.clone = parsed_function_name
        function parsed_function_name.clone parser.put_function
        return
    fi

    # impl
    if KeywordKind::Impl keyword == then
        parser token Token::location "Implementation blocks" function_name require_global_scope
        cursor.retreat
        cursor parser parse_impl_block
        return
    fi

    # import
    if KeywordKind::Import keyword == then
        parser token Token::location "Import statements" function_name require_global_scope
        cursor parser handle_keyword_import ops.push
        return
    fi

    # is (standalone is error)
    if KeywordKind::Is keyword == then
        token Token::location "`is` requires a preceding enum variant" ErrorKind::Syntax parser.state.record_error
    fi

    # match
    if KeywordKind::Match keyword == then
        function_name cursor token parser parse_match_block = match_ops
        match_ops ops.append
        return
    fi

    # struct
    if KeywordKind::StructKw keyword == then
        parser token Token::location "Structs" function_name require_global_scope
        cursor.retreat
        cursor parser parse_struct = casa_struct
        casa_struct CasaStruct::name.clone = parsed_struct_name
        casa_struct parsed_struct_name parser.put_struct
        return
    fi

    # for
    if KeywordKind::For keyword == then
        ops function_name cursor token parser handle_keyword_for
        return
    fi

    # in (standalone is error — only valid inside a for header)
    if KeywordKind::In keyword == then
        token Token::location "`in` is only valid inside a `for` loop header" ErrorKind::Syntax parser.state.record_error
    fi

    # global — compile-time declaration; emits DeclareGlobal op
    if KeywordKind::Global keyword == then
        if GLOBAL_SCOPE_LABEL function_name == then
            token Token::location "`global` declaration is only valid inside a function body" ErrorKind::InvalidScope parser.state.record_error
            return
        fi
        if function_name "lambda__" str::starts_with then
            token Token::location "`global` declaration is not allowed inside a lambda" ErrorKind::InvalidScope parser.state.record_error
            return
        fi
        # Placement check: all ops so far must be DeclareGlobal
        for existing_op in ops.iter do
            if existing_op.value OpValue::DeclareGlobal is ! then
                token Token::location "`global` declaration must appear before any other statement in the function body" ErrorKind::Syntax parser.state.record_error
                return
            fi
        done
        fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token
        token Token::location name_token Token::value.clone OpValue::DeclareGlobal Op::new ops.push
        return
    fi

    # const
    if KeywordKind::Const keyword == then
        parser token Token::location "Constants" function_name require_global_scope
        # const fn — compile-time evaluable function
        cursor.peek = const_next_opt
        if const_next_opt Option::Some(const_next) is then
            if "fn" const_next Token::value.as_str == then
                cursor parser parse_function = function
                true function Function::set_is_const_fn
                if parser.syntax_only ! then
                    parser.state.diagnostics function validate_const_fn_body
                fi
                if
                    function Function::name parser
                        .store
                        .functions
                        .get
                        .is_some
                then
                    function Function::location f"Identifier `{function Function::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error_string
                fi
                function Function::name.clone = const_function_name
                function const_function_name.clone parser.put_function
                return
            fi
        fi
        fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = const_name_token
        const_name_token Token::value.clone = const_name
        if
            const_name parser
                .store
                .constants
                .get
                .is_some
        then
            token Token::location f"Constant `{const_name}` is already defined" ErrorKind::DuplicateName parser.state.record_error_string
        fi
        if
            const_name parser
                .store
                .functions
                .get
                .is_some
        then
            token Token::location f"Constant `{const_name}` conflicts with an existing function" ErrorKind::DuplicateName parser.state.record_error_string
        fi
        if
            const_name parser
                .store
                .variables
                .get
                .is_some
        then
            token Token::location f"Constant `{const_name}` conflicts with an existing variable" ErrorKind::DuplicateName parser.state.record_error_string
        fi
        if
            const_name parser
                .store
                .structs
                .get
                .is_some
        then
            token Token::location f"Constant `{const_name}` conflicts with an existing struct" ErrorKind::DuplicateName parser.state.record_error_string
        fi
        if
            const_name parser
                .store
                .enums
                .get
                .is_some
        then
            token Token::location f"Constant `{const_name}` conflicts with an existing enum" ErrorKind::DuplicateName parser.state.record_error_string
        fi
        cursor.pop = const_value_token_opt
        if const_value_token_opt.is_none then
            token Token::location "Expected a literal value, block expression, or constant name after constant name" ErrorKind::Syntax parser.state.record_error
        fi
        const_value_token_opt.unwrap = const_value_token
        if "{" const_value_token Token::value.as_str == then
            cursor.retreat
            if parser.syntax_only then
                "const" cursor parser parse_block_ops drop
                0 IntegerLiteral::from_int ConstantValue::Int
            else
                token Token::location cursor parser eval_const_block
            fi
            = const_block_val
            token Token::location.clone const_block_val const_name.clone Constant = casa_const
            casa_const const_name parser.put_constant
        elif TokenKind::Literal const_value_token Token::kind == then
            const_value_token Token::value.as_str parse_literal_to_constant_value = const_lit_val
            token Token::location.clone const_lit_val const_name.clone Constant = casa_const
            casa_const const_name parser.put_constant
        elif TokenKind::Identifier const_value_token Token::kind == then
            const_value_token Token::value.clone = const_ref_name
            if parser.syntax_only then
                0 IntegerLiteral::from_int ConstantValue::Int = syntax_const_value
                token Token::location.clone syntax_const_value const_name.clone Constant = casa_const
                casa_const const_name parser.put_constant
                return
            fi
            const_ref_name parser
                .store
                .constants
                .get = const_ref_opt
            if const_ref_opt Option::Some(const_ref) is then
                token Token::location.clone const_ref Constant::value clone_constant_value const_name.clone Constant
                = casa_const
                casa_const const_name parser.put_constant
            elif
                const_ref_name parser
                    .store
                    .functions
                    .get
                    .is_some
            then
                token Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" ErrorKind::Syntax parser.state.record_error_string
            elif
                const_ref_name parser
                    .store
                    .structs
                    .get
                    .is_some
            then
                token Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" ErrorKind::Syntax parser.state.record_error_string
            elif
                const_ref_name parser
                    .store
                    .enums
                    .get
                    .is_some
            then
                token Token::location f"Cannot use `{const_ref_name}` as a constant value; it is not a constant" ErrorKind::Syntax parser.state.record_error_string
            else
                token Token::location f"Undefined constant `{const_ref_name}` referenced in constant `{const_name}`" ErrorKind::Syntax parser.state.record_error_string
            fi
        else
            token Token::location f"Expected a literal value, block expression, or constant name for constant `{const_name}`" ErrorKind::Syntax parser.state.record_error_string
        fi
        return
    fi

    # trait
    if KeywordKind::TraitKw keyword == then
        parser token Token::location "Traits" function_name require_global_scope
        cursor.retreat
        cursor parser parse_trait = casa_trait
        if
            casa_trait CasaTrait::name parser
                .store
                .traits
                .get
                .is_some
        then
            casa_trait CasaTrait::location f"Trait `{casa_trait CasaTrait::name}` is already defined" ErrorKind::DuplicateName parser.state.record_error_string
        fi
        casa_trait CasaTrait::name.clone = parsed_trait_name
        casa_trait parsed_trait_name.clone parser.put_trait
        return
    fi
}

# ============================================================================
# _parse_struct_literal - parse StructName { field: value }
# ============================================================================

fn is_struct_field_boundary cursor:mut$TokenCursor member_names:mut$List[String] -> bool {
    cursor TokenCursor::pos = pos
    cursor TokenCursor::tokens = token_list: $List[Token]
    if pos 1 + token_list.length < then
        false return
    fi
    pos token_list.get = token
    if TokenKind::Identifier token Token::kind != then
        false return
    fi
    if token Token::value.as_str member_names string_list_contains ! then
        false return
    fi
    ":" pos 1 + token_list.get Token::value.as_str ==
}

fn parse_struct_field_value
    parser:mut$Parser
    cursor:mut$TokenCursor
    member_names:mut$List[String]
    function_name:$str
    all_ops:mut$List[Op]
{
    while cursor.is_finished ! do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            break
        fi
        if peek_opt Option::Some(peek) is then
            if "}" peek Token::value.as_str == then
                break
            fi
        fi
        if member_names cursor is_struct_field_boundary then
            break
        fi
        cursor.pop = value_opt
        if value_opt.is_none then
            break
        fi
        value_opt.unwrap = value_token
        if TokenKind::FstringStart value_token Token::kind == then
            all_ops function_name cursor value_token parser handle_fstring
            continue
        fi
        all_ops function_name cursor value_token parser token_to_op
    done
}

fn parse_struct_literal
    parser:mut$Parser
    name_token:$Token
    cursor:mut$TokenCursor
    function_name:$str
-> List[Op] {
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop
    name_token Token::value.as_str parser.store.get_struct_member_names = member_names_opt
    if member_names_opt.is_none then
        empty_location "Expected option value while unwrapping name_token Token::value.as_str parser.store.structs.get" ErrorKind::Syntax parser.state.record_error
        1 exit
    fi
    member_names_opt.unwrap = member_names

    List[String]::new = field_order
    List[Op]::new = all_ops
    Set[String]::new = seen

    while true do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token Token::location "Unexpected end of input in struct literal" ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
        if next_opt Option::Some(next) is then
            if "}" next Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi

        fallback_token parser.state TokenKind::Identifier cursor expect_token_kind.unwrap_or = field_token
        if field_token Token::value.as_str member_names string_list_contains ! then
            field_token Token::location f"Struct `{name_token Token::value.as_str}` has no field `{field_token Token::value.as_str}`" ErrorKind::UndefinedName parser.state.record_error_string
        fi
        if field_token Token::value.as_str seen.has_str then
            field_token Token::location f"Duplicate field `{field_token Token::value.as_str}` in struct literal" ErrorKind::DuplicateName parser.state.record_error_string
        fi
        field_token Token::value.clone seen.add
        field_token Token::value.clone field_order.push

        fallback_token parser.state ":" cursor expect_token_value.unwrap_or drop

        all_ops.length = ops_before
        all_ops function_name member_names cursor parser parse_struct_field_value
        if ops_before all_ops.length == then
            field_token Token::location f"Missing value for field `{field_token Token::value.as_str}`" ErrorKind::Syntax parser.state.record_error_string
        fi
    done

    field_order name_token Token::value.clone StructLiteral = literal
    name_token Token::location literal OpValue::StructLiteral Op::new all_ops.push
    all_ops
}

# ============================================================================
# token_to_op - main dispatch: token kind -> handler
# ============================================================================

fn try_parse_pointer_operation
    token:$Token
    cursor:mut$TokenCursor
    ops:mut$List[Op]
    state:mut$ParseState
-> bool {
    if "ptr::into_raw" token.value.as_str == then
        token.location OpValue::PtrIntoRaw Op::new ops.push
        true return
    fi
    if
        "ptr::read" token.value.as_str !=
        "ptr::write" token.value.as_str != &&
        "ptr::as_ref" token.value.as_str != &&
        "ptr::as_mut" token.value.as_str != &&
    then
        false return
    fi
    cursor.peek = open_opt
    if open_opt.is_none then
        false return
    fi
    if open_opt Option::Some(open) is then
        if "[" open.value.as_str != then
            false return
        fi
    fi
    cursor.pop drop
    state cursor parse_type_ast = target_type
    fallback_token state "]" cursor expect_token_value.unwrap_or drop
    if "ptr::read" token.value.as_str == then
        token.location target_type OpValue::PtrRead Op::new ops.push
    elif "ptr::write" token.value.as_str == then
        token.location target_type OpValue::PtrWrite Op::new ops.push
    elif "ptr::as_ref" token.value.as_str == then
        token.location target_type OpValue::PtrAsRef Op::new ops.push
    else
        token.location target_type OpValue::PtrAsMut Op::new ops.push
    fi
    true
}

fn try_parse_explicit_associated_item
    token:$Token
    cursor:mut$TokenCursor
    ops:mut$List[Op]
    state:mut$ParseState
-> bool {
    cursor.save = saved_pos
    cursor.peek = open_opt
    if open_opt.is_none then
        false return
    fi
    if open_opt Option::Some(open) is then
        if "[" open Token::value.as_str != then
            false return
        fi
        if
            token Token::location Location::span Span::offset
            token Token::location Location::span Span::length +
            open Token::location Location::span Span::offset !=
        then
            false return
        fi
    fi
    cursor.pop drop
    List[Type]::new = type_args
    while true do
        cursor.peek = next_opt
        if next_opt.is_none then
            saved_pos cursor.restore false return
        fi
        if next_opt Option::Some(next) is then
            if "]" next Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi
        state cursor parse_type_ast type_args.push
    done
    cursor.pop = first_colon
    cursor.pop = second_colon
    cursor.pop = member_opt
    if first_colon Option::Some(first_colon_token) is then
        if second_colon Option::Some(second_colon_token) is then
            if member_opt Option::Some(member_token) is then
                if
                    ":" first_colon_token Token::value.as_str ==
                    ":" second_colon_token Token::value.as_str == &&
                    TokenKind::Identifier member_token Token::kind == &&
                then
                    member_token Token::value.clone = member
                    token Token::value.clone = base
                    token Token::location f"{base}::{member}" OpValue::Identifier Op::new = associated_op
                    type_args base GenericType Type::Generic = result_type
                    result_type Option::Some associated_op Op::set_type_hint
                    associated_op ops.push
                    true return
                fi
            fi
        fi
    fi
    saved_pos cursor.restore
