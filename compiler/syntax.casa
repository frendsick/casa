            0 effect.parameters.get = receiver
            if "self" receiver.name.as_str == receiver.typ.is_exclusive_borrow && then
                if receiver.typ.borrow_target Option::Some(target) is then
                    if 0 name_parts.get target.match_base == then
                        true = valid
                    fi
                fi
            fi
        fi
        if valid ! then
            function_location "Reserved `drop` method must have stack effect `self:mut$self -> None`" ErrorKind::SignatureMismatch parser.state.record_error
            continue
        fi
        0 effect
            .parameters
            .get
            .typ
            .borrow_target
            .unwrap = receiver_type
        false = receiver_is_copy
        if receiver_type Type::Builtin(builtin) is then
            true = receiver_is_copy
        fi
        "Copy".to_str GenericType::new Type::Generic = copy_type
        if parser.store copy_type receiver_type type_has_satisfying_trait_impl then
            true = receiver_is_copy
        fi
        if receiver_is_copy then
            function_location "A `Copy` type cannot define a reserved `drop` method" ErrorKind::TraitSignatureMismatch parser.state.record_error
        fi
    done
}

