fn copy_representation_is_eligible
    typ:$Type
    trait_bounds:$Map[String List[TraitBound]]
    store:$SymbolStore
    visiting:mut$Set[String]
-> bool {
    if typ.is_shared_borrow then
        true return
    fi
    if typ.is_exclusive_borrow then
        false return
    fi
    if typ Type::Builtin(BuiltinType::Str) is then
        true return
    fi
    if store typ type_value_representation Option::Some(representation) is then
        if VALUE_REPR_INDIRECT representation == then
            false return
        fi
    fi
    typ match
        Type::Builtin(builtin) => {
            builtin BuiltinType::Str !=
        }
        Type::Function(_) => {
            true
        }
        Type::Unknown => {
            false
        }
        Type::Const(_) => {
            false
        }
        Type::TypeVar(type_variable) => {
            if type_variable trait_bounds.get Option::Some(bounds) is then
                "Copy".to_str GenericType::new Type::Generic = copy_type
                for bound in bounds.iter do
                    if store copy_type bound trait_bound_to_type trait_type_implies then
                        true return
                    fi
                done
            fi
            false
        }
        Type::Generic(generic) => {
            if "array" generic.base.as_str == then
                false return
            fi
            if f"{generic.base}::drop" store.functions.has then
                false return
            fi
            if generic.base visiting.has then
                false return
            fi
            Map[String Type]::new = substitutions
            if generic.base store.structs.get Option::Some(casa_struct) is then
                if generic.params.length casa_struct.type_vars.length != then
                    false return
                fi
                for
                    pair in generic.params.iter casa_struct
                        .type_vars
                        .iter
                        .zip
                do
                    pair.second clone_type pair.first.clone substitutions.set
                done
                generic.base.clone visiting.add
                for member in casa_struct.members.iter do
                    substitutions member.typ.substitute_t = member_type
                    if visiting store trait_bounds member_type copy_field_is_eligible ! then
                        generic.base visiting.remove
                        false return
                    fi
                done
                generic.base visiting.remove
                true return
            fi
            if generic.base store.enums.get Option::Some(casa_enum) is then
                if generic.params.length casa_enum.type_vars.length != then
                    false return
                fi
                for
                    pair in generic.params.iter casa_enum
                        .type_vars
                        .iter
                        .zip
                do
                    pair.second clone_type pair.first.clone substitutions.set
                done
                generic.base.clone visiting.add
                for pair in casa_enum.variant_types.iter do
                    for payload_type in pair.second.iter do
                        substitutions payload_type.substitute_t = resolved_payload
                        if visiting store trait_bounds resolved_payload copy_field_is_eligible ! then
                            generic.base visiting.remove
                            false return
                        fi
                    done
                done
                generic.base visiting.remove
                true return
            fi
            false
        }
    end
}

fn copy_field_is_eligible
    typ:$Type
    trait_bounds:$Map[String List[TraitBound]]
    store:$SymbolStore
    visiting:mut$Set[String]
-> bool {
    if typ Type::Generic(generic) is then
        if generic.base store.structs.has generic.base store.enums.has || then
            "Copy".to_str GenericType::new Type::Generic = copy_type
            if store copy_type typ type_has_satisfying_trait_impl ! then
                false return
            fi
        fi
    fi
    visiting store trait_bounds typ copy_representation_is_eligible
}

fn validate_drop_methods parser:mut$Parser {
