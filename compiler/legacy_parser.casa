# Legacy parser for compilation and name resolution.
#
# Converts a token list into an op list.
import "std" as std
import "os" as os
import "parser" as parser
import "common" as common
import "constant_eval" as constant_eval
import "error" as error
import "lexer" as lexer
import "semantics" as semantics
import "semantic_rules" as rules
import "syntax" as grammar

# ============================================================================
# Parser struct and parse/resolve result
#
# `Parser` owns parse-private state. Later compiler phases receive only the
# dependencies they use, not the parser object itself.
# ============================================================================

pub struct ParseState {
    pub diagnostics:       error::Diagnostics
    pub output_usable:     std::List[bool]
    pub recovery_required: std::List[bool]
    pub store_mutated:     std::List[bool]
    pub constant_errors:   u64
}

impl ParseState {
    pub fn new diagnostics:error::Diagnostics -> ParseState {
        std::List[bool]::new = store_mutated
        false store_mutated.push
        std::List[bool]::new = recovery_required
        false recovery_required.push
        std::List[bool]::new = output_usable
        true output_usable.push
        0 store_mutated recovery_required output_usable diagnostics ParseState
    }

    pub fn record_error
        self:mut$ParseState
        kind:common::ErrorKind
        message:$str
        location:$common::Location
    {
        location message kind self.diagnostics.record_error
    }

    pub fn record_error_string
        self:mut$ParseState
        kind:common::ErrorKind
        message:std::String
        location:$common::Location
    {
        location message kind self.diagnostics.record_error_string
    }

    pub fn record_error_expected
        self:mut$ParseState
        kind:common::ErrorKind
        message:std::String
        location:$common::Location
        expected:std::String
        got:std::String
    {
        got expected location.clone message kind error::CasaError::with_expected
        self.diagnostics.push_error
    }

    pub fn mark_output_unusable self:mut$ParseState { false 0 self.output_usable.set }

    pub fn has_usable_output self:mut$ParseState -> bool { 0 self.output_usable.get copy }

    pub fn has_nonconstant_errors_since
        self:$ParseState
        errors_before:u64
        constant_errors_before:u64
    -> bool {
        self.diagnostics.error_count errors_before -
        self.constant_errors constant_errors_before - !=
    }

    pub fn request_recovery self:mut$ParseState { true 0 self.recovery_required.set }

    pub fn take_recovery_request self:mut$ParseState -> bool {
        0 self.recovery_required.get copy = requested
        false 0 self.recovery_required.set
        requested
    }

    pub fn reset_store_mutation self:mut$ParseState { false 0 self.store_mutated.set }

    pub fn mark_store_mutated self:mut$ParseState { true 0 self.store_mutated.set }

    pub fn store_was_mutated self:mut$ParseState -> bool { 0 self.store_mutated.get copy }

    pub fn into_diagnostics self:ParseState -> error::Diagnostics {
        self match
            ParseState { diagnostics: diagnostics } => diagnostics
        end
    }
}

pub struct ImportedModule {
    pub failed: bool
}

pub struct ModuleContext {
    pub included_files: std::Set[std::String]
    pub declared_names: std::Set[std::String]
    pub names:          std::Map[std::String common::SourceBinding]
    pub import_ends:    std::Map[std::String u64]
    pub header_ends:    std::Map[std::String u64]
    pub complete_until: std::Option[u64]
}

impl ModuleContext {
    pub fn new -> ModuleContext {
        std::Option[u64]::None
        std::Map[std::String u64]::new std::Map[std::String u64]::new std::Map[std::String common::SourceBinding]::new
        std::Set[std::String]::new std::Set[std::String]::new ModuleContext
    }
}

pub struct Parser {
    pub store:           common::SymbolStore
    pub import_stack:    std::List[std::String]
    pub analyzed_files:  std::Set[std::String]
    pub module_cache:    mut$std::Map[std::String ImportedModule]
    pub search_paths:    std::List[std::String]
    pub sources:         mut$lexer::SourceStore
    pub state:           ParseState
    pub module_contexts: std::List[ModuleContext]
    pub source_prefixes: std::Map[std::String std::String]
}

pub struct ParseResolveResult {
    pub ops:         std::Option[std::List[common::Op]]
    pub store:       common::SymbolStore
    pub diagnostics: error::Diagnostics
}

impl ParseResolveResult {
    pub fn into_parts
        self:ParseResolveResult
    -> std::Option[std::List[common::Op]] common::SymbolStore error::Diagnostics {
        self match
            ParseResolveResult { ops: ops store: store diagnostics: diagnostics } => ops store diagnostics
        end
    }
}

impl Parser {
    pub fn new
        store:common::SymbolStore
        diagnostics:error::Diagnostics
        sources:mut$lexer::SourceStore
        import_cache:mut$std::Map[std::String ImportedModule]
    -> Parser {
        std::List[ModuleContext]::new = module_contexts
        ModuleContext::new module_contexts.push
        std::Map[std::String std::String]::new
        module_contexts
        diagnostics ParseState::new
        sources
        std::List[std::String]::new
        import_cache
        std::Set[std::String]::new
        std::List[std::String]::new
        store
        Parser
    }

    pub fn into_parts self:Parser -> common::SymbolStore std::Set[std::String] ParseState {
        self match
            Parser { store: store analyzed_files: analyzed_files module_contexts: module_contexts state: state } => {
                store analyzed_files state
            }
        end
    }

    pub fn current_module self:$Parser -> $ModuleContext {
        self.module_contexts.length 1 - self.module_contexts.get_ref
    }

    pub fn current_module_mut self:mut$Parser -> mut$ModuleContext {
        self.module_contexts.length 1 - self.module_contexts.get_mut
    }

    pub fn into_diagnostics self:Parser -> error::Diagnostics {
        self.into_parts = state = included_files = store
        state.into_diagnostics
    }

    pub fn into_result
        self:Parser
        ops:std::Option[std::List[common::Op]]
    -> ParseResolveResult std::List[std::String] {
        self.into_parts = state = included_files = store
        included_files.to_list = included_file_list
        state.into_diagnostics store ops ParseResolveResult
        included_file_list
    }

    pub fn into_failed_result self:Parser -> ParseResolveResult std::List[std::String] {
        self.into_parts = state = included_files = store
        store drop
        included_files.to_list = included_file_list
        state.into_diagnostics common::symbol_store_new std::Option[std::List[common::Op]]::None ParseResolveResult
        included_file_list
    }

    fn register_declaration self:mut$Parser name:$str {
        self.state.mark_store_mutated
        name.to_str self
            .current_module_mut
            .declared_names
            .add
    }

    fn register_private_declaration self:mut$Parser name:$str {
        name self.register_declaration
        name.to_str self
            .store
            .module_private_symbols
            .add
    }

    pub fn put_function self:mut$Parser name:std::String function:common::Function {
        name.as_str self.register_private_declaration
        function self.store.set_function
    }

    pub fn put_constant self:mut$Parser name:std::String constant:common::Constant {
        name.as_str self.register_private_declaration
        constant name self
            .store
            .constants
            .set
    }

    pub fn put_enum self:mut$Parser name:std::String casa_enum:common::CasaEnum {
        name.as_str self.register_private_declaration
        casa_enum name self
            .store
            .enums
            .set
    }

    pub fn put_struct self:mut$Parser name:std::String casa_struct:common::CasaStruct {
        name.as_str self.register_private_declaration
        casa_struct name self
            .store
            .structs
            .set
    }

    pub fn put_trait self:mut$Parser name:std::String casa_trait:common::CasaTrait {
        name.as_str self.register_private_declaration
        casa_trait name self
            .store
            .traits
            .set
    }

    pub fn put_trait_impl self:mut$Parser trait_impl:common::TraitImpl {
        trait_impl common::trait_impl_key = name
        name.as_str self.register_declaration
        trait_impl self.store.set_trait_impl
        std::Map[std::String bool]::new = self.store.copy_types
    }
}

fn add_map_names [V] source:$std::Map[std::String V] destination:mut$std::Set[std::String] {
    for name in source.keys.iter do
        name.clone destination.add
    done
}

impl common::SymbolStore {
    pub fn declaration_names self:$common::SymbolStore -> std::Set[std::String] {
        std::Set[std::String]::new = names
        for name in self.get_function_names.iter do
            name.clone names.add
        done
        names self.constants add_map_names
        names self.variables add_map_names
        names self.structs add_map_names
        names self.enums add_map_names
        names self.traits add_map_names
        names
    }

    pub fn is_function_unsafe self:$common::SymbolStore name:$str -> std::Option[bool] {
        if name self.get_function std::Option::Some(function) is then
            function.is_unsafe std::Option::Some
        else
            std::Option[bool]::None
        fi
    }

    pub fn get_struct_member_names
        self:$common::SymbolStore
        name:$str
    -> std::Option[std::List[std::String]] {
        if name self.structs.get_str std::Option::Some(casa_struct) is then
            std::List[std::String]::new = names
            for member in casa_struct.members.iter do
                member.name.clone names.push
            done
            names std::Option::Some
        else
            std::Option[std::List[std::String]]::None
        fi
    }

    pub fn count_trait_type_parameters self:$common::SymbolStore name:$str -> std::Option[u64] {
        if name self.traits.get_str std::Option::Some(casa_trait) is then
            casa_trait.type_params.length std::Option::Some
        else
            std::Option[u64]::None
        fi
    }

    pub fn clone_for_typecheck self:$common::SymbolStore -> common::SymbolStore {
        common::symbol_store_new = cloned
        for name in self.get_function_names.iter do
            name.as_str self
                .get_function
                .unwrap
                .clone_for_import cloned.set_function
        done
        self.variables.clone = cloned.variables
        self.constants.clone = cloned.constants
        self.failed_constants.clone = cloned.failed_constants
        self.enums.clone = cloned.enums
        self.structs.clone = cloned.structs
        self.traits.clone = cloned.traits
        for name in self.get_trait_impl_names.iter do
            name.as_str self
                .get_trait_impl
                .unwrap
                .clone cloned.set_trait_impl
        done
        self.public_symbols.clone = cloned.public_symbols
        self.private_symbols.clone = cloned.private_symbols
        self.module_private_symbols.clone = cloned.module_private_symbols
        self cloned.copy_source_names_from
        cloned
    }
}

# ============================================================================
# Simple keyword -> OpValue lookup (no-payload variants only)
# ============================================================================

pub fn keyword_to_op_value keyword_kind:$common::KeywordKind -> std::Option[common::OpValue] {
    keyword_kind match
        common::KeywordKind::Break => common::OpValue::WhileBreak std::Option::Some
        common::KeywordKind::Continue => common::OpValue::WhileContinue std::Option::Some
        common::KeywordKind::Do => common::OpValue::WhileCondition std::Option::Some
        common::KeywordKind::Done => common::OpValue::WhileEnd std::Option::Some
        common::KeywordKind::Elif => common::OpValue::IfElif std::Option::Some
        common::KeywordKind::Else => common::OpValue::IfElse std::Option::Some
        common::KeywordKind::Fi => common::OpValue::IfEnd std::Option::Some
        common::KeywordKind::If => common::OpValue::IfStart std::Option::Some
        common::KeywordKind::Return => common::OpValue::FnReturn std::Option::Some
        common::KeywordKind::Then => common::OpValue::IfCondition std::Option::Some
        common::KeywordKind::While => common::OpValue::WhileStart std::Option::Some
        _ => std::Option[common::OpValue]::None
    end
}

# ============================================================================
# Operator -> OpValue lookup
# ============================================================================

pub fn operator_to_op_value operator_kind:common::OperatorKind -> std::Option[common::OpValue] {
    operator_kind match
        common::OperatorKind::Plus => common::OpValue::Add std::Option::Some
        common::OperatorKind::Minus => common::OpValue::Sub std::Option::Some
        common::OperatorKind::Mul => common::OpValue::Mul std::Option::Some
        common::OperatorKind::Div => common::OpValue::Div std::Option::Some
        common::OperatorKind::Mod => common::OpValue::Mod std::Option::Some
        common::OperatorKind::Shl => common::OpValue::Shl std::Option::Some
        common::OperatorKind::Shr => common::OpValue::Shr std::Option::Some
        common::OperatorKind::BitAnd => common::OpValue::BitAnd std::Option::Some
        common::OperatorKind::BitOr => common::OpValue::BitOr std::Option::Some
        common::OperatorKind::BitXor => common::OpValue::BitXor std::Option::Some
        common::OperatorKind::BitNot => common::OpValue::BitNot std::Option::Some
        common::OperatorKind::And => common::OpValue::And std::Option::Some
        common::OperatorKind::Or => common::OpValue::Or std::Option::Some
        common::OperatorKind::Not => common::OpValue::Not std::Option::Some
        common::OperatorKind::Eq => common::OpValue::Eq std::Option::Some
        common::OperatorKind::Ge => common::OpValue::Ge std::Option::Some
        common::OperatorKind::Gt => common::OpValue::Gt std::Option::Some
        common::OperatorKind::Le => common::OpValue::Le std::Option::Some
        common::OperatorKind::Lt => common::OpValue::Lt std::Option::Some
        common::OperatorKind::Ne => common::OpValue::Ne std::Option::Some
        _ => std::Option[common::OpValue]::None
    end
}

# ============================================================================
# Token cursor
# ============================================================================

pub struct TokenCursor {
    pub tokens:           $std::List[common::Token]
    pub pos:              u64
    pub names:            std::Map[std::String common::SourceBinding]
    pub constants:        std::Map[std::String common::Constant]
    pub failed_constants: std::Set[std::String]
    pub type_bindings:    std::List[std::String]
    pub module_prefixes:  std::List[std::String]
}

impl TokenCursor {
    pub fn new tokens:$std::List[common::Token] -> TokenCursor {
        std::List[std::String]::new std::List[std::String]::new std::Set[std::String]::new std::Map[std::String common::Constant]::new std::Map[std::String common::SourceBinding]::new 0 tokens TokenCursor
    }

    pub fn copy_module_prefixes self:mut$TokenCursor prefixes:$std::Map[std::String std::String] {
        for prefix in prefixes.iter do
            prefix.second.clone self.module_prefixes.push
        done
    }

    pub fn restore_type_bindings self:mut$TokenCursor count:u64 {
        while count self.type_bindings.length > do
            self.type_bindings.pop drop
        done
    }

    pub fn resolve_name self:$TokenCursor name:$str -> std::String {
        name common::source_reference_head = head
        if head.as_str self.type_bindings common::string_list_contains then
            name.to_str return
        fi
        if self.names name common::resolve_source_name std::Option::Some(resolved) is then
            resolved.clone return
        fi
        if head.as_str "__casa_" str::starts_with ! then
            name.to_str return
        fi
        for prefix in self.module_prefixes.iter do
            if head.as_str prefix.as_str str::starts_with then
                # No source binding exists. An unspellable suffix prevents store-key access.
                f"{name}@unbound" return
            fi
        done
        name.to_str
    }

    pub fn pop self:mut$TokenCursor -> std::Option[common::Token] {
        self TokenCursor::pos copy = pos
        if self TokenCursor::tokens.length pos >= then
            std::Option::None return
        fi
        pos self TokenCursor::tokens.get.clone = token
        pos 1 + self TokenCursor::set_pos
        token std::Option::Some
    }

    pub fn peek self:mut$TokenCursor -> std::Option[common::Token] {
        self TokenCursor::pos copy = pos
        if self TokenCursor::tokens.length pos >= then
            std::Option::None return
        fi
        pos self TokenCursor::tokens.get.clone std::Option::Some
    }

    pub fn is_finished self:mut$TokenCursor -> bool {
        self TokenCursor::tokens.length self TokenCursor::pos >=
    }

    pub fn advance self:mut$TokenCursor { self TokenCursor::pos 1 + self TokenCursor::set_pos }

    pub fn retreat self:mut$TokenCursor { self TokenCursor::pos 1 - self TokenCursor::set_pos }

    pub fn save self:mut$TokenCursor -> u64 { self TokenCursor::pos }

    pub fn restore self:mut$TokenCursor saved:u64 { saved self TokenCursor::set_pos }

    pub fn recover_at_structure self:mut$TokenCursor -> bool {
        if 0 self.pos > then
            self.pos 1 - self.tokens.get = previous
            if previous is_parser_synchronization_token then
                true return
            fi
        fi
        while self.is_finished ! do
            self.peek.unwrap = token
            if token is_parser_synchronization_token then
                if token is_parser_delimiter then
                    self.advance
                fi
                true return
            fi
            self.advance
        done
        false
    }
}

pub fn is_parser_synchronization_token token:$common::Token -> bool {
    if token is_parser_delimiter then
        true return
    fi
    token.value.as_str = value: $str
    "fn" value ==
    "extern" value == ||
    "enum" value == ||
    "struct" value == ||
    "trait" value == ||
    "impl" value == ||
    "import" value == ||
    "const" value == ||
}

pub fn is_parser_delimiter token:$common::Token -> bool {
    token.value.as_str = value: $str
    "}" value == "fi" value == || "done" value == || "end" value == ||
}

# ============================================================================
# expect_token - consume next token, error if mismatch
# ============================================================================

pub fn fallback_token -> common::Token {
    common::empty_location common::TokenKind::Eof "".to_str common::Token::new
}

pub fn expect_token cursor:mut$TokenCursor state:mut$ParseState -> std::Option[common::Token] {
    cursor.pop = result_opt
    if result_opt.is_none then
        common::empty_location "Unexpected end of input" common::ErrorKind::UnexpectedToken state.record_error
        state.mark_output_unusable
        state.request_recovery
        std::Option::None return
    fi
    result_opt.unwrap = token
    if common::TokenKind::Eof token common::Token::kind == then
        token common::Token::location "Unexpected end of input" common::ErrorKind::UnexpectedToken state.record_error
        state.mark_output_unusable
        state.request_recovery
        std::Option::None return
    fi
    token std::Option::Some
}

pub fn expect_token_value
    cursor:mut$TokenCursor
    expected:str
    state:mut$ParseState
-> std::Option[common::Token] {
    state cursor expect_token = token_opt
    if token_opt.is_none then
        std::Option::None return
    fi
    token_opt.unwrap = token
    if expected token common::Token::value.as_str != then
        cursor.retreat
        f"`{token common::Token::value.as_str}`"
        f"`{expected}`"
        token common::Token::location
        "Unexpected token".to_str
        common::ErrorKind::UnexpectedToken
        state.record_error_expected
        state.request_recovery
        std::Option::None return
    fi
    token std::Option::Some
}

pub fn expect_token_kind
    cursor:mut$TokenCursor
    expected_kind:common::TokenKind
    state:mut$ParseState
-> std::Option[common::Token] {
    state cursor expect_token = token_opt
    if token_opt.is_none then
        std::Option::None return
    fi
    token_opt.unwrap = token
    if expected_kind token common::Token::kind != then
        cursor.retreat
        token common::Token::location "Unexpected token" common::ErrorKind::UnexpectedToken state.record_error
        state.request_recovery
        std::Option::None return
    fi
    token std::Option::Some
}

# ============================================================================
# expect_delimiter - consume expected delimiter or return None
# ============================================================================

pub fn expect_delimiter cursor:mut$TokenCursor expected_value:str -> bool {
    cursor.peek = peek_opt
    if peek_opt.is_none then
        false return
    fi
    peek_opt.unwrap = token
    if expected_value token common::Token::value.as_str != then
        false return
    fi
    cursor.advance
    true
}

# ============================================================================
# parse_type - parse a type expression
# ============================================================================
# True if a type-position leaf is a constant argument (integer, `true`/`false`,
# or char literal) rather than a type name (ADR-0153).

pub fn is_type_argument_literal value:$str -> bool {
    if value common::try_parse_uint_literal.is_some value lexer::is_negative_integer_literal || then
        true return
    fi
    if "true" value.as_str == "false" value.as_str == || then
        true return
    fi
    value char_literal_codepoint.is_some
}

pub fn parse_type_ast cursor:mut$TokenCursor state:mut$ParseState -> common::Type {
    cursor.peek = peek_opt
    if peek_opt.is_none then
        common::empty_location "Expected type" common::ErrorKind::UnexpectedToken state.record_error
        common::Type::Unknown return
    fi
    peek_opt.unwrap = peek

    "" = borrow_prefix
    std::String::new = base
    if "fn" peek common::Token::value.as_str == then
        cursor.pop drop
        "fn".to_str = base
    else
        fallback_token state cursor expect_token.unwrap_or = base_token
        if base_token.kind common::TokenKind::Literal == then
            if 0 base_token.value.length != then
                if
                    0 base_token
                        .value
                        .at
                        .is_digit base_token.value.as_str common::try_parse_uint_literal.is_none &&
                then
                    base_token.location f"Integer type argument `{base_token.value}` is outside `u64` range" common::ErrorKind::TypeMismatch state.record_error_string
                    common::Type::Unknown return
                fi
            fi
            if base_token.value.as_str lexer::is_negative_integer_literal then
                base_token.value.as_str parser::str_to_int base_token.value.clone common::IntegerLiteral::new = signed_literal
                if common::make_i64_type signed_literal.fits ! then
                    base_token.location f"Integer type argument `{base_token.value}` is outside `i64` range" common::ErrorKind::TypeMismatch state.record_error_string
                    common::Type::Unknown return
                fi
            fi
        fi
        if
            common::TokenKind::Identifier base_token common::Token::kind !=
            base_token common::Token::value.as_str cursor.resolve_name.as_str is_type_argument_literal ! &&
        then
            base_token common::Token::location "Expected type name" common::ErrorKind::UnexpectedToken state.record_error
        fi
        base_token common::Token::value.as_str cursor.resolve_name = base
        if base.as_str "@unbound" str::ends_with then
            base_token.location f"Type `{base_token.value}` is not defined in this module" common::ErrorKind::UndefinedName state.record_error_string
        fi
    fi
    if base.as_str "mut$" str::starts_with then
        common::EXCLUSIVE_BORROW_TYPE = borrow_prefix
        base.length = base_length
        base.as_str 4 base_length 4 - str::substring = base
    elif base.as_str "$" str::starts_with then
        common::SHARED_BORROW_TYPE = borrow_prefix
        base.length = base_length
        base.as_str 1 base_length 1 - str::substring = base
    fi
    if base.as_str "$" str::starts_with base.as_str "mut$" str::starts_with || then
        peek.location "Nested borrow qualifiers are not supported" common::ErrorKind::Syntax
        state.record_error
        common::Type::Unknown return
    fi

    if base.as_str cursor.type_bindings common::string_list_contains then
        borrow_prefix base common::Type::TypeVar common::apply_borrow_type return
    fi

    # Char constant (ADR-0153): built here rather than in `parse_type_str`,
    # which cannot decode the codepoint.
    if base.as_str char_literal_codepoint std::Option::Some(char_codepoint) is then
        common::BuiltinType::Char char_codepoint common::ConstType::concrete common::Type::Const return
    fi

    if base.as_str cursor.constants.get_str std::Option::Some(named_constant) is then
        named_constant.value match
            common::ConstantValue::Int(integer) => {
                common::BuiltinType::U64 = integer_type
                if integer.raw.as_str "-" str::starts_with 0 integer.value != && then
                    common::BuiltinType::I64 = integer_type
                fi
                integer_type integer.value common::ConstType::concrete common::Type::Const return
            }
            common::ConstantValue::Bool(value) => {
                common::BuiltinType::Bool value common::ConstType::concrete common::Type::Const return
            }
            common::ConstantValue::Char(value) => {
                common::BuiltinType::Char value common::ConstType::concrete common::Type::Const return
            }
            _ => {
                peek.location f"Constant `{peek.value}` cannot be a type argument: only integer, bool, and char values are allowed" common::ErrorKind::TypeMismatch state.record_error_string
                common::Type::Unknown return
            }
        end
    fi

    if base.as_str cursor.failed_constants.has_str then
        peek.location f"Constant `{peek.value}` is unavailable because its declaration failed" common::ErrorKind::UndefinedName state.record_error_string
        common::Type::Unknown return
    fi

    cursor.peek = next_opt
    if next_opt.is_none then
        borrow_prefix base.as_str common::parse_type_str common::apply_borrow_type return
    fi
    if next_opt std::Option::Some(next) is then
        if "[" next common::Token::value.as_str != then
            borrow_prefix base.as_str common::parse_type_str common::apply_borrow_type return
        fi
    fi
    cursor.advance # consume [

    if "fn" base.as_str == then
        std::List[common::Type]::new = fn_params
        std::List[common::Type]::new = fn_returns
        false = past_arrow
        while cursor.is_finished ! do
            cursor.peek = inner_opt
            if inner_opt.is_none then
                break
            fi
            inner_opt.unwrap common::Token::value.as_str = ival: $str
            if "]" ival.as_str == then
                cursor.pop drop
                break
            fi
            if "->" ival.as_str == then
                cursor.pop drop
                true = past_arrow
                continue
            fi
            state cursor parse_type_ast = inner_type
            if past_arrow then
                inner_type fn_returns.push
            else
                inner_type fn_params.push
            fi
        done
        borrow_prefix fn_returns fn_params common::FunctionType common::Type::Function common::apply_borrow_type return
    fi

    std::List[common::Type]::new = inner_types
    while true do
        cursor.peek = inner_opt
        if inner_opt std::Option::Some(inner) is then
            if "]" inner common::Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi
        state cursor parse_type_ast inner_types.push
    done
    if 0 inner_types.length == then
        common::empty_location f"Expected type parameter inside `{base}[...]`" common::ErrorKind::UnexpectedToken state.record_error_string
    fi
    borrow_prefix inner_types base common::GenericType common::Type::Generic common::apply_borrow_type
}

# ============================================================================
# get_op_literal - convert literal token to push op
# ============================================================================

pub fn char_literal_codepoint value:$str -> std::Option[i64] {
    if 3 value.length < then
        std::Option[i64]::None return
    fi
    if '\'' 0 value.at != '\'' value.length 1 - value.at != || then
        std::Option[i64]::None return
    fi
    value 1 lexer::decode_utf8_scalar = decoded_opt
    if decoded_opt std::Option::Some(decoded) is then
        if decoded.byte_length 2 + value.length == then
            decoded lexer::DecodedUtf8Scalar::codepoint i64::from std::Option::Some return
        fi
    fi
    std::Option[i64]::None
}

pub fn get_op_literal
    token:$common::Token
    cursor:mut$TokenCursor
    state:mut$ParseState
-> common::Op {
    token common::Token::value.as_str = value: $str
    if "true" value.as_str == then
        token common::Token::location 1 common::OpValue::PushBool common::Op::new return
    fi
    if "false" value.as_str == then
        token common::Token::location 0 common::OpValue::PushBool common::Op::new return
    fi
    # Numeric literal (positive or negative)
    if value lexer::is_float_literal then
        token common::Token::location value.to_str common::OpValue::PushFloat common::Op::new return
    fi
    if 0 value.at.is_digit value lexer::is_negative_integer_literal || then
        value parser::str_to_int = int_value
        token common::Token::location int_value value.to_str common::IntegerLiteral::new common::OpValue::PushInt common::Op::new return
    fi
    value char_literal_codepoint = char_opt
    if char_opt std::Option::Some(char_value) is then
        token common::Token::location char_value common::OpValue::PushChar common::Op::new return
    fi
    # String literal: "..."
    if '"' 0 value.at == '"' value.length 1 - value.at == && then
        value.length = value_length
        value 1 value_length 2 - str::substring = str_value
        token common::Token::location str_value common::OpValue::PushStr common::Op::new return
    fi
    token common::Token::location f"Token `{value}` is not a literal" common::ErrorKind::Syntax state.record_error_string
    token common::Token::location 0 common::make_integer_op_value common::Op::new
}

# ============================================================================
# get_op_intrinsic - convert intrinsic token to op
# ============================================================================

pub fn get_op_intrinsic
    token:$common::Token
    cursor:mut$TokenCursor
    state:mut$ParseState
-> common::Op {
    token common::Token::value.as_str common::intrinsic_from_str = kind_opt
    if kind_opt std::Option::Some(kind) is then
        kind copy = intrinsic_kind
        if intrinsic_kind common::IntrinsicKind::SizeOf == then
            fallback_token state "[" cursor expect_token_value.unwrap_or drop
            state cursor parse_type_ast = target_type
            fallback_token state "]" cursor expect_token_value.unwrap_or drop
            token common::Token::location target_type common::OpValue::SizeOf common::Op::new return
        fi
        intrinsic_kind common::intrinsic_to_op_value match
            std::Option::Some(op_value) => token common::Token::location op_value common::Op::new return
            std::Option::None => {
                token common::Token::location f"No OpValue for intrinsic `{token common::Token::value.as_str}`" common::ErrorKind::Syntax state.record_error_string
            }
        end
    else
        token common::Token::location f"Token `{token common::Token::value.as_str}` is not an intrinsic" common::ErrorKind::Syntax state.record_error_string
    fi
    token common::Token::location 0 common::make_integer_op_value common::Op::new
}

# ============================================================================
# get_op_operator - convert operator token to op
# ============================================================================

pub fn parse_assignment_target
    cursor:mut$TokenCursor
    state:mut$ParseState
-> common::Location std::String {
    fallback_token state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = root_token
    root_token common::Token::value.clone = target
    while "." cursor expect_delimiter do
        fallback_token state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or common::Token::value.as_str = field: $str
        f"{target}.{field}" = target
    done
    root_token common::Token::location.clone
    target
}

pub fn get_op_operator
    token:$common::Token
    cursor:mut$TokenCursor
    function_name:$str
    state:mut$ParseState
-> common::Op {
    token common::Token::value.as_str common::operator_from_str = kind_opt
    if kind_opt std::Option::Some(kind) is then
        kind copy = operator_kind

        # Assignment: = varname
        if common::OperatorKind::Assign operator_kind == then
            state cursor parse_assignment_target = var_name = target_location

            # Optional type annotation: = varname : type
            std::Option[common::Type]::None = type_hint
            cursor.peek = colon_opt
            if colon_opt std::Option::Some(colon) is then
                if ":" colon common::Token::value.as_str == then
                    cursor.advance
                    state cursor parse_type_ast std::Option::Some = type_hint
                fi
            fi
            target_location var_name common::OpValue::AssignVar common::Op::new = assign_op
            type_hint = assign_op.type_hint
            assign_op return
        fi

        # Compound assignment: += varname
        if common::OperatorKind::AssignInc operator_kind == then
            state cursor parse_assignment_target = inc_target = inc_location
            inc_location inc_target common::OpValue::AssignInc common::Op::new return
        fi

        # Compound assignment: -= varname
        if common::OperatorKind::AssignDec operator_kind == then
            state cursor parse_assignment_target = dec_target = dec_location
            dec_location dec_target common::OpValue::AssignDec common::Op::new return
        fi

        # Simple operator -> OpValue lookup
        operator_kind operator_to_op_value match
            std::Option::Some(op_value) => token common::Token::location op_value common::Op::new return
            std::Option::None => {
                token common::Token::location f"No OpValue for operator `{token common::Token::value.as_str}`" common::ErrorKind::Syntax state.record_error_string
            }
        end
    else
        token common::Token::location f"Token `{token common::Token::value.as_str}` is not an operator" common::ErrorKind::Syntax state.record_error_string
    fi
    token common::Token::location 0 common::make_integer_op_value common::Op::new
}

# ============================================================================
# Forward declarations (functions that call each other)
# ============================================================================
# token_to_op, parse_block_ops, handle_fstring are mutually recursive
# In Casa, we just define them in order and rely on global function lookup.
# ============================================================================
# get_op_array - parse [item1, item2] array literal
# ============================================================================

pub fn parse_array_struct_literal
    parser:mut$Parser
    function_name:$str
    cursor:mut$TokenCursor
    name_token:$common::Token
    items:mut$std::List[common::Op]
{
    function_name cursor name_token parser parse_struct_literal = struct_ops
    name_token common::Token::location struct_ops common::OpValue::ExprGroup common::Op::new items.push
}

pub fn parse_array_lambda
    parser:mut$Parser
    function_name:$str
    cursor:mut$TokenCursor
    brace_token:common::Token
    items:mut$std::List[common::Op]
{
    cursor.retreat
    f"lambda__{function_name}_o{brace_token common::Token::location common::Location::span common::Span::offset}" = arr_lam_name
    arr_lam_name.as_str cursor parser parse_block_ops = arr_lam_ops
    brace_token common::Token::location.clone arr_lam_ops arr_lam_name.clone common::Function::new = arr_lam_fn
    arr_lam_fn arr_lam_name.clone parser.put_function
    brace_token common::Token::location.clone arr_lam_name common::OpValue::FnPush common::Op::new items.push
}

pub fn get_op_array parser:mut$Parser function_name:$str cursor:mut$TokenCursor -> common::Op {
    fallback_token parser.state "[" cursor expect_token_value.unwrap_or = open_token
    std::List[common::Op]::new = items
    while true do
        # Close on `]` (also reached after an optional trailing comma).
        cursor.peek = close_peek
        if close_peek std::Option::Some(cp) is then
            if "]" cp common::Token::value.as_str == then
                cursor.pop drop
                break
            fi
        fi

        # Parse one item.
        false = parsed_nested
        cursor.peek = next_opt
        if next_opt std::Option::Some(next) is then
            if "[" next common::Token::value.as_str == then
                cursor function_name parser get_op_array items.push
                true = parsed_nested
            fi
        fi
        if parsed_nested ! then
            cursor.pop = value_opt
            if value_opt.is_none then
                open_token common::Token::location "Unexpected end of input in array literal" common::ErrorKind::UnexpectedToken parser.state.record_error
                parser.state.mark_output_unusable
                open_token.location items common::OpValue::PushArray common::Op::new return
            fi
            value_opt.unwrap = value_token
            if "{" value_token common::Token::value.as_str == then
                items value_token cursor function_name parser parse_array_lambda
            elif common::TokenKind::Literal value_token common::Token::kind == then
                parser.state cursor value_token get_op_literal items.push
            elif common::TokenKind::Identifier value_token common::Token::kind == then
                cursor.peek = struct_peek_opt
                if struct_peek_opt std::Option::Some(struct_peek) is then
                    if "{" struct_peek common::Token::value.as_str == then
                        items value_token cursor function_name parser parse_array_struct_literal
                    else
                        value_token common::Token::location value_token common::Token::value.clone common::OpValue::Identifier common::Op::new items.push
                    fi
                else
                    value_token common::Token::location value_token common::Token::value.clone common::OpValue::Identifier common::Op::new items.push
                fi
            else
                value_token common::Token::location "Unexpected token in array literal" common::ErrorKind::UnexpectedToken parser.state.record_error
            fi
        fi

        # Items MUST be comma-separated. A single trailing comma before `]` is
        # allowed for developer experience; the next iteration closes on `]`.
        cursor.peek = sep_peek
        if sep_peek std::Option::Some(sp) is then
            if "," sp common::Token::value.as_str == then
                cursor.pop drop
            else
                if "]" sp common::Token::value.as_str == ! then
                    sp common::Token::location "Expected `,` between array items" common::ErrorKind::UnexpectedToken parser.state.record_error
                    parser.state.mark_output_unusable
                    break
                fi
            fi
        else
            open_token common::Token::location "Unexpected end of input in array literal" common::ErrorKind::UnexpectedToken parser.state.record_error
            parser.state.mark_output_unusable
            break
        fi
    done
    open_token common::Token::location items common::OpValue::PushArray common::Op::new
}

# ============================================================================
# parse_block_ops - parse { ... } delimited block
# ============================================================================

pub fn parse_block_ops
    parser:mut$Parser
    cursor:mut$TokenCursor
    function_name:$str
-> std::List[common::Op] {
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or = open_token
    std::List[common::Op]::new = ops
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            open_token common::Token::location "Unclosed block" common::ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            ops return
        fi
        token_opt.unwrap = token
        if common::TokenKind::Comment token common::Token::kind == then
            continue
        fi
        if common::TokenKind::Newline token common::Token::kind == then
            continue
        fi
        if "}" token common::Token::value.as_str == then
            ops return
        fi
        if common::TokenKind::FstringStart token common::Token::kind == then
            ops function_name cursor token parser handle_fstring
            continue
        fi
        ops function_name cursor token parser token_to_op
    done
    ops
}

# ============================================================================
# handle_fstring - parse f-string tokens into ops
# ============================================================================

pub fn parse_fstring_expr
    parser:mut$Parser
    cursor:mut$TokenCursor
    function_name:$str
-> std::List[common::Op] {
    std::List[common::Op]::new = ops
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            break
        fi
        token_opt.unwrap = token
        if common::TokenKind::FstringExprEnd token common::Token::kind == then
            break
        fi
        if common::TokenKind::FstringStart token common::Token::kind == then
            ops function_name cursor token parser handle_fstring
            continue
        fi
        ops function_name cursor token parser token_to_op
    done
    ops
}

pub fn handle_fstring
    parser:mut$Parser
    start_token:common::Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$std::List[common::Op]
{
    0 = part_count: u64
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            break
        fi
        token_opt.unwrap = token
        if common::TokenKind::FstringText token common::Token::kind == then
            token common::Token::location token common::Token::value.clone common::OpValue::PushStr common::Op::new ops.push
            token common::Token::location.clone common::OpValue::FstringToStr common::Op::new ops.push
            1 += part_count
        elif common::TokenKind::FstringExprStart token common::Token::kind == then
            function_name cursor parser parse_fstring_expr = expr_ops
            token common::Token::location.clone common::OpValue::FstringToStr common::Op::new expr_ops.push
            f"lambda__{function_name}_o{token common::Token::location common::Location::span common::Span::offset}" = lambda_name
            token common::Token::location.clone expr_ops lambda_name.clone common::Function::new = lambda_function
            true lambda_function common::Function::set_captures_shared
            lambda_function lambda_name.clone parser.put_function
            token common::Token::location.clone lambda_name common::OpValue::FnPush common::Op::new ops.push
            token common::Token::location.clone common::OpValue::FnExec common::Op::new ops.push
            1 += part_count
        elif common::TokenKind::FstringEnd token common::Token::kind == then
            break
        fi
    done
    if 0 part_count == then
        start_token common::Token::location "".to_str common::OpValue::PushStr common::Op::new ops.push
        start_token common::Token::location.clone common::OpValue::FstringToStr common::Op::new ops.push
        1 = part_count: u64
    fi
    if 1 part_count > then
        start_token common::Token::location part_count common::OpValue::FstringConcat common::Op::new ops.push
    fi
}

# ============================================================================
# get_op_delimiter - convert delimiter token to op
# ============================================================================

pub fn get_op_delimiter
    parser:mut$Parser
    token:$common::Token
    cursor:mut$TokenCursor
    function_name:$str
    ops:mut$std::List[common::Op]
{
    token common::Token::value.as_str = value: $str

    # Dot . method
    if "." value.as_str == then
        parser.state cursor expect_function_name = method_token
        method_token common::Token::location method_token common::Token::value.clone common::OpValue::MethodCall common::Op::new ops.push
        return
    fi

    # Open brace { -> lambda
    if "{" value.as_str == then
        cursor.retreat
        f"lambda__{function_name}_o{token common::Token::location common::Location::span common::Span::offset}" = lambda_name
        lambda_name.as_str cursor parser parse_block_ops = lambda_ops
        token common::Token::location.clone lambda_ops lambda_name.clone common::Function::new = lambda_function
        lambda_function lambda_name.clone parser.put_function
        token common::Token::location lambda_name common::OpValue::FnPush common::Op::new ops.push
        return
    fi

    # Open bracket [ -> array literal
    if "[" value.as_str == then
        cursor.retreat
        cursor function_name parser get_op_array ops.push
        return
    fi

    # Parentheses do not group operations. Reject the removed general cast syntax.
    if "(" value.as_str == then
        token common::Token::location
        "General casts are not supported; use a named conversion or type annotation"
        common::ErrorKind::UnexpectedToken parser.state.record_error
        while cursor.peek.is_some do
            cursor.pop.unwrap = next_token
            if ")" next_token common::Token::value.as_str == then
                break
            fi
        done
        return
    fi

    # Other delimiters (comma, colon, close brace/bracket/paren, fat arrow, hashtag)
    # are ignored or handled by their enclosing constructs
}

# ============================================================================
# _try_parse_is_check - try parsing Enum::Variant is
# ============================================================================

pub fn try_parse_is_check token:$common::Token cursor:mut$TokenCursor -> std::Option[common::Op] {
    cursor.save = saved_pos
    std::List[std::String]::new = bindings

    # Check for bindings: Enum::Variant(a b) is
    false = has_bindings
    if cursor.peek std::Option::Some(peek_token) is then
        "(" peek_token common::Token::value.as_str == = has_bindings
    else
        std::Option[common::Op]::None return
    fi
    if has_bindings then
        cursor.pop drop # consume (
        while true do
            if cursor.peek std::Option::Some(inner) is then
                if ")" inner common::Token::value.as_str == then
                    cursor.pop drop # consume )
                    if 0 bindings.length == then
                        saved_pos cursor.restore
                        std::Option::None return
                    fi
                    break
                fi
                if common::TokenKind::Identifier inner common::Token::kind != then
                    saved_pos cursor.restore
                    std::Option::None return
                fi
                cursor.pop drop
                if inner.value.as_str "::" str::contains then
                    inner.value.as_str cursor.resolve_name bindings.push
                else
                    inner.value.clone bindings.push
                fi
            else
                saved_pos cursor.restore
                std::Option::None return
            fi
        done
    fi

    # Check if next token is `is`
    if cursor.peek std::Option::Some(is_token) is then
        if "is" is_token common::Token::value.as_str != then
            saved_pos cursor.restore
            std::Option::None return
        fi
    else
        saved_pos cursor.restore
        std::Option::None return
    fi
    cursor.pop drop # consume `is`

    # Split token value on ::
    token common::Token::value.as_str cursor.resolve_name.as_str "::" str::find = separator
    token common::Token::value.as_str cursor.resolve_name.as_str 0 separator u64::try_from.unwrap str::substring = enum_name
    token common::Token::value.as_str cursor.resolve_name.as_str separator 2 + u64::try_from.unwrap
    token common::Token::value.as_str cursor
        .resolve_name
        .as_str
        .length separator u64::try_from.unwrap - 2 - str::substring = variant_name

    std::Option::None variant_name enum_name common::EnumVariant::new = variant
    bindings variant common::EnumVariant::set_bindings
    token common::Token::location variant common::OpValue::IsCheck common::Op::new = parsed_is
    parsed_is std::Option::Some
}

# ============================================================================
# _require_global_scope
# ============================================================================

pub fn require_global_scope
    function_name:$str
    what:str
    location:$common::Location
    parser:mut$Parser
{
    if common::GLOBAL_SCOPE_LABEL function_name != then
        location f"{what} should be defined in the global scope" common::ErrorKind::InvalidScope parser.state.record_error_string
    fi
}

# ============================================================================
# parse_type_variables - parse [T, K: Hashable] type variable lists
# ============================================================================

pub struct ParsedTypeVariables {
    pub names:        std::List[std::String]
    pub trait_bounds: std::Map[std::String std::List[common::TraitBound]]
    pub const_params: std::Map[std::String common::BuiltinType]
}

impl ParsedTypeVariables {
    pub fn into_parts
        self:ParsedTypeVariables
    -> std::List[std::String] std::Map[std::String std::List[common::TraitBound]] std::Map[std::String common::BuiltinType] {
        self match
            ParsedTypeVariables { names: names trait_bounds: trait_bounds const_params: const_params } => names trait_bounds const_params
        end
    }
}
# Parse the `[arg1 arg2 ...]` type argument list that follows a generic trait
# name in a trait bound (e.g. `I: Iterable[i64]`). The caller has already
# consumed the trait identifier. If the next token is not `[`, returns an
# empty list. Otherwise parses each argument as a Type AST value.

pub fn parse_bound_type_args
    cursor:mut$TokenCursor
    trait_token:$common::Token
    state:mut$ParseState
-> std::List[common::Type] {
    std::List[common::Type]::new = bound_args
    cursor.peek = bracket_opt
    if bracket_opt.is_none then
        bound_args return
    fi
    if bracket_opt std::Option::Some(bracket) is then
        if "[" bracket common::Token::value.as_str != then
            bound_args return
        fi
    fi
    cursor.pop drop
    while true do
        cursor.peek = argument_token_option
        if argument_token_option.is_none then
            trait_token common::Token::location "Unclosed trait bound type argument list" common::ErrorKind::Syntax state.record_error
            state.mark_output_unusable
            bound_args return
        fi
        argument_token_option.unwrap common::Token::value.as_str = argument_value: $str
        if "]" argument_value.as_str == then
            cursor.pop drop
            bound_args return
        fi
        if "," argument_value.as_str == then
            cursor.pop drop
            continue
        fi
        state cursor parse_type_ast bound_args.push
    done
    bound_args
}

pub fn trait_bound_method_effect
    type_variable:$str
    method:$common::TraitMethod
    bound:$common::TraitBound
    casa_trait:$common::CasaTrait
-> common::StackEffect {
    casa_trait bound rules::make_bound_substitutions = substitutions
    0 = method_type_index: u64
    for method_type_variable in method.type_vars.iter do
        f"__method_type_{method_type_index}" common::Type::TypeVar
        method_type_variable.clone substitutions.set
        1 += method_type_index
    done
    type_variable.to_str common::Type::TypeVar method.stack_effect common::resolve_trait_stack_effect = effect
    substitutions effect common::apply_type_subs_to_stack_effect
}

pub fn stack_effect_shapes_equal first:$common::StackEffect second:$common::StackEffect -> bool {
    if first.parameters.length second.parameters.length != then
        false return
    fi
    if first.return_types.length second.return_types.length != then
        false return
    fi
    for
        pair in second.parameters.iter first
            .parameters
            .iter
            .zip
    do
        if
            pair.second.typ pair
                .first
                .typ
                .eq !
        then
            false return
        fi
    done
    for
        pair in second.return_types.iter first
            .return_types
            .iter
            .zip
    do
        if pair.second pair.first.eq ! then
            false return
        fi
    done
    true
}

pub fn bound_is_compatible
    parser:mut$Parser
    type_variable:$str
    existing_bounds:$std::List[common::TraitBound]
    candidate:$common::TraitBound
-> bool {
    candidate.name parser
        .store
        .traits
        .get = candidate_trait_opt
    if candidate_trait_opt.is_none then
        false return
    fi
    candidate_trait_opt.unwrap = candidate_trait
    candidate_trait parser.store rules::collect_trait_methods = candidate_methods
    for candidate_method in candidate_methods.iter do
        candidate_trait candidate candidate_method type_variable trait_bound_method_effect
        = candidate_effect
        for existing_bound in existing_bounds.iter do
            existing_bound.name parser
                .store
                .traits
                .get = existing_trait_opt
            if existing_trait_opt.is_none then
                continue
            fi
            existing_trait_opt.unwrap = existing_trait
            existing_trait parser.store rules::collect_trait_methods = existing_methods
            for existing_method in existing_methods.iter do
                if existing_method.name candidate_method.name != then
                    continue
                fi
                existing_trait existing_bound existing_method type_variable trait_bound_method_effect
                = existing_effect
                if candidate_effect existing_effect stack_effect_shapes_equal ! then
                    false return
                fi
            done
        done
    done
    true
}

pub fn parse_type_variables parser:mut$Parser cursor:mut$TokenCursor -> ParsedTypeVariables {
    fallback_token parser.state "[" cursor expect_token_value.unwrap_or drop
    std::List[std::String]::new = vars
    std::Set[std::String]::new = seen
    std::Map[std::String std::List[common::TraitBound]]::new = trait_bounds
    std::Map[std::String common::BuiltinType]::new = const_params

    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            common::empty_location "Expected `]` to close type parameters" common::ErrorKind::Syntax parser.state.record_error
            parser.state.mark_output_unusable
            const_params trait_bounds vars ParsedTypeVariables return
        fi
        token_opt.unwrap = token
        if "]" token common::Token::value.as_str == then
            if 0 vars.length == then
                token common::Token::location "Empty type parameter list `[]` is not allowed" common::ErrorKind::Syntax parser.state.record_error
            fi
            const_params trait_bounds vars ParsedTypeVariables return
        fi
        if "," token common::Token::value.as_str == then
            continue
        fi
        # `const NAME:TYPE` binds a compile-time constant, not a type variable
        # (ADR-0152).
        if "const" token common::Token::value.as_str == then
            const_params seen vars parser cursor parse_const_type_parameter = const_params
            continue
        fi
        if common::TokenKind::Identifier token common::Token::kind == then
            if
                token common::Token::value.as_str parser
                    .store
                    .builtins
                    .has_str
            then
                token common::Token::location f"Type variable `{token common::Token::value.as_str}` shadows built-in type" common::ErrorKind::DuplicateName parser.state.record_error_string
            fi
            if token common::Token::value.as_str seen.has_str then
                token common::Token::location f"Duplicate type variable `{token common::Token::value.as_str}`" common::ErrorKind::DuplicateName parser.state.record_error_string
            fi
            token common::Token::value.clone cursor.type_bindings.push
            token common::Token::value.clone vars.push
            token common::Token::value.clone seen.add
            # Check for trait bounds: K: Hashable + Display
            cursor.peek = colon_opt
            if colon_opt std::Option::Some(colon) is then
                if ":" colon common::Token::value.as_str == then
                    cursor.pop drop # consume :
                    std::List[common::TraitBound]::new = bounds
                    true = parse_bounds
                    while parse_bounds do
                        fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = trait_token
                        trait_token common::Token::value.as_str cursor.resolve_name = bound_trait_name
                        bound_trait_name parser
                            .store
                            .traits
                            .get = bound_trait_def_opt
                        if bound_trait_def_opt.is_none then
                            trait_token common::Token::location f"Trait `{bound_trait_name}` is not defined" common::ErrorKind::UndefinedName parser.state.record_error_string
                        fi
                        parser.state trait_token cursor parse_bound_type_args = bound_args
                        if bound_trait_def_opt std::Option::Some(bound_trait_def) is then
                            bound_trait_def common::CasaTrait::type_params = declared_params: $std::List[std::String]
                            if bound_args.length declared_params.length != then
                                trait_token common::Token::location f"Trait `{bound_trait_name}` expects {declared_params.length} type argument(s), got {bound_args.length}" common::ErrorKind::Syntax parser.state.record_error_string
                            fi
                            bound_args bound_trait_name common::TraitBound = parsed_bound
                            false = duplicate_bound
                            for existing_bound in bounds.iter do
                                if parsed_bound existing_bound common::trait_bound_eq then
                                    true = duplicate_bound
                                fi
                            done
                            if duplicate_bound ! then
                                if parsed_bound bounds token.value.as_str parser bound_is_compatible ! then
                                    trait_token.location f"Bounds on `{token.value}` have incompatible requirements for the same method" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                                fi
                                parsed_bound bounds.push
                            fi
                        fi
                        cursor.peek = plus_opt
                        if plus_opt std::Option::Some(plus) is then
                            if "+" plus.value.as_str == then
                                cursor.pop drop
                            else
                                false = parse_bounds
                            fi
                        else
                            false = parse_bounds
                        fi
                    done
                    bounds token.value.clone trait_bounds.set
                fi
            fi
        else
            token common::Token::location "Unexpected token in type parameters" common::ErrorKind::UnexpectedToken parser.state.record_error
        fi
    done
    const_params trait_bounds vars ParsedTypeVariables
}
# Parse `const NAME:TYPE` (the `const` keyword already consumed). Adds NAME to
# `vars`/`seen` so it keeps its slot among the type parameters, and maps it to
# its declared type (ADR-0152).

pub fn parse_const_type_parameter
    cursor:mut$TokenCursor
    parser:mut$Parser
    vars:mut$std::List[std::String]
    seen:mut$std::Set[std::String]
    const_params:std::Map[std::String common::BuiltinType]
-> std::Map[std::String common::BuiltinType] {
    fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token
    if
        name_token common::Token::value.as_str parser
            .store
            .builtins
            .has_str
    then
        name_token common::Token::location f"Constant parameter `{name_token common::Token::value.as_str}` shadows built-in type" common::ErrorKind::DuplicateName parser.state.record_error_string
    fi
    if name_token common::Token::value.as_str seen.has_str then
        name_token common::Token::location f"Duplicate type variable `{name_token common::Token::value.as_str}`" common::ErrorKind::DuplicateName parser.state.record_error_string
    fi
    name_token common::Token::value.clone cursor.type_bindings.push
    name_token common::Token::value.clone vars.push
    name_token common::Token::value.clone seen.add
    fallback_token parser.state ":" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = type_token
    type_token common::Token::value.as_str common::parse_builtin = builtin_opt
    if builtin_opt std::Option::Some(const_builtin) is then
        if const_builtin const_type_parameter_type_allowed ! then
            type_token common::Token::location f"Constant parameter `{name_token common::Token::value.as_str}` cannot have type `{type_token common::Token::value.as_str}`: only integer, `bool`, and `char` constants are allowed" common::ErrorKind::Syntax parser.state.record_error_string
        fi
        const_builtin name_token common::Token::value.clone const_params.set
        const_params return
    fi
    type_token common::Token::location f"Constant parameter `{name_token common::Token::value.as_str}` has unknown type `{type_token common::Token::value.as_str}`" common::ErrorKind::Syntax parser.state.record_error_string
    const_params
}
# Builtin types allowed as a constant parameter (ADR-0153): integer widths,
# `bool`, `char`. Float and `str` are rejected — neither can select an
# instantiation (ADR-0012 for floats).

pub fn const_type_parameter_type_allowed builtin:$common::BuiltinType -> bool {
    if builtin.is_integer then
        true return
    fi
    builtin common::BuiltinType::Bool == builtin common::BuiltinType::Char == ||
}
# Apply the shared constant-parameter rewrite to every parameter and return type of a
# stack effect (ADR-0152).

pub fn rewrite_stack_effect_constant_parameters
    effect:mut$common::StackEffect
    constant_parameters:$std::Map[std::String common::BuiltinType]
{
    std::List[common::Parameter]::new = new_parameters
    for parameter in effect.parameters.iter do
        constant_parameters parameter.typ rules::rewrite_type_const_params = rewritten_type
        parameter.name.clone rewritten_type common::Parameter new_parameters.push
    done
    std::List[common::Type]::new = new_return_types
    for return_type in effect.return_types.iter do
        constant_parameters return_type rules::rewrite_type_const_params new_return_types.push
    done
    new_parameters effect common::StackEffect::set_parameters
    new_return_types effect common::StackEffect::set_return_types
}
# Rewrite constant-parameter names in a body's cast and hint types so they read
# as constants rather than unknown type names (ADR-0152).

pub fn rewrite_operation_constant_parameters
    operations:mut$std::List[common::Op]
    constant_parameters:$std::Map[std::String common::BuiltinType]
{
    if 0 constant_parameters.keys.length == then
        return
    fi
    std::Map[std::String common::Type]::new = substitutions
    for constant_name in constant_parameters.keys.iter do
        constant_name constant_parameters.get.unwrap constant_name.clone common::ConstType::symbolic common::Type::Const
        constant_name.clone substitutions.set
    done
    substitutions operations common::substitute_ops_types
}
# Register constant parameters as body variables. Concrete specializations
# replace their reads with literals before bytecode lowering.

pub fn inject_constant_parameters
    effect:mut$common::StackEffect
    variables:mut$std::List[common::Variable]
    location:common::Location
-> std::List[common::Op] {
    std::List[common::Op]::new = assignments
    effect.const_params = constant_parameters: $std::Map[std::String common::BuiltinType]
    if 0 constant_parameters.keys.length == then
        assignments return
    fi
    for constant_name in constant_parameters.keys.iter do
        constant_name constant_parameters.get.unwrap common::Type::Builtin = constant_type
        constant_type.clone constant_name.clone common::Variable variables.push
    done
    assignments
}

# ============================================================================
# parse_parameters - parse name:type parameter pairs
# ============================================================================
# Given an identifier `token` just popped from `cursor`, produce either a
# named parameter (`name:type`) if the next token is `:`, or an unnamed
# parameter by rewinding and re-parsing as a type expression.

pub fn parse_parameter_maybe_named
    cursor:mut$TokenCursor
    token:$common::Token
    state:mut$ParseState
-> common::Parameter {
    cursor.peek = next_opt
    if { common::Token::value.as_str ":" == } next_opt.filter.is_some then
        cursor.advance # consume :
        state cursor parse_type_ast = param_type
        token common::Token::value.clone param_type common::Parameter::named return
    fi
    cursor.retreat
    "".to_str state cursor parse_type_ast common::Parameter::named
}

pub fn parse_parameters
    cursor:mut$TokenCursor
    state:mut$ParseState
-> std::List[common::Parameter] {
    std::List[common::Parameter]::new = params
    while true do
        cursor.pop = token_opt
        if token_opt.is_none then
            common::empty_location "Unexpected end of input" common::ErrorKind::UnexpectedToken state.record_error
            state.mark_output_unusable
            params return
        fi
        token_opt.unwrap = token

        # Stop at -> or {
        if "->" token common::Token::value.as_str == "{" token common::Token::value.as_str == || then
            cursor.retreat
            params return
        fi

        # Allow fn keyword as unnamed parameter type
        if "fn" token common::Token::value.as_str == then
            cursor.retreat
            "".to_str state cursor parse_type_ast common::Parameter::named params.push
            continue
        fi

        if common::TokenKind::Identifier token common::Token::kind != then
            token common::Token::location "Unexpected token in parameter list" common::ErrorKind::UnexpectedToken state.record_error
        fi

        state token cursor parse_parameter_maybe_named params.push
    done
    params
}

# ============================================================================
# parse_return_types - parse return types after ->
# ============================================================================

pub fn parse_return_types cursor:mut$TokenCursor state:mut$ParseState -> std::List[common::Type] {
    std::List[common::Type]::new = types
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            common::empty_location "Unexpected end of input" common::ErrorKind::UnexpectedToken state.record_error
            state.mark_output_unusable
            types return
        fi
        if peek_opt std::Option::Some(peek) is then
            if "{" peek common::Token::value.as_str == then
                types return
            fi
        fi
        state cursor parse_type_ast types.push
    done
    types
}

# ============================================================================
# parse_stack_effect - parse function stack effect
# ============================================================================

pub fn parse_stack_effect cursor:mut$TokenCursor state:mut$ParseState -> common::StackEffect {
    state cursor parse_parameters = params
    std::List[common::Type]::new = returns

    cursor.peek = next_opt
    if next_opt.is_none then
        common::empty_location "Unexpected end of input" common::ErrorKind::UnexpectedToken state.record_error
        state.mark_output_unusable
        returns params common::StackEffect::new return
    fi
    if next_opt std::Option::Some(next) is then
        if "->" next common::Token::value.as_str == then
            cursor.advance # consume ->
            state cursor parse_return_types = returns
        fi
    fi
    returns params common::StackEffect::new
}

# ============================================================================
# parse_literal_to_constant_value - parse a raw literal string to ConstantValue
# ============================================================================

pub fn parse_literal_to_constant_value raw:$str -> common::ConstantValue {
    if "true" raw == then
        1 common::ConstantValue::Bool return
    fi
    if "false" raw == then
        0 common::ConstantValue::Bool return
    fi
    if '"' 0 raw.at == then
        raw 1 raw.length 2 - str::substring common::ConstantValue::Str return
    fi
    if raw char_literal_codepoint std::Option::Some(codepoint) is then
        codepoint common::ConstantValue::Char return
    fi
    if raw lexer::is_float_literal then
        raw.to_str common::ConstantValue::Float return
    fi
    raw parser::str_to_int raw.to_str common::IntegerLiteral::new common::ConstantValue::Int
}

fn read_constant_reference
    parser:mut$Parser
    cursor:mut$TokenCursor
    token:$common::Token
-> std::Option[constant_eval::EvalValue] {
    token.value.as_str cursor.resolve_name = name
    if
        name.as_str parser
            .store
            .constants
            .get_str std::Option::Some(found) is
    then
        if
            token
                .location
                .file
                .as_str name.as_str parser.store.is_private_from
        then
            token.location f"Constant `{token.value}` is private" common::ErrorKind::InvalidScope parser.state.record_error_string
            std::Option[constant_eval::EvalValue]::None return
        fi
        token.location.clone found.typ.clone found.value.clone constant_eval::EvalValue::new std::Option::Some return
    fi
    if
        name.as_str parser
            .store
            .get_function
            .is_some
        name.as_str parser
            .store
            .structs
            .has_str ||
        name.as_str parser
            .store
            .enums
            .has_str ||
        name.as_str parser
            .store
            .variables
            .has_str ||
    then
        token.location f"`{token.value}` is not a constant" common::ErrorKind::TypeMismatch parser.state.record_error_string
    elif
        name.as_str parser
            .store
            .failed_constants
            .has_str
        token
            .location
            .file
            .as_str name.as_str parser.store.is_private_from &&
    then
        token.location f"Constant `{token.value}` is private" common::ErrorKind::InvalidScope parser.state.record_error_string
    elif
        name.as_str parser
            .store
            .failed_constants
            .has_str token.value.as_str cursor.names.has_str ||
    then
        token.location f"Constant `{token.value}` is unavailable" common::ErrorKind::UndefinedName parser.state.record_error_string
    else
        token.location f"Unknown constant `{token.value}`" common::ErrorKind::UndefinedName parser.state.record_error_string
    fi
    std::Option[constant_eval::EvalValue]::None
}

fn evaluate_bounded_block
    parser:mut$Parser
    cursor:mut$TokenCursor
    annotation:std::Option[common::BuiltinType]
    location:$common::Location
-> std::Option[constant_eval::EvalValue] {
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop
    std::List[constant_eval::EvalValue]::new = stack
    while cursor.is_finished ! do
        cursor.pop.unwrap = token
        if "}" token.value.as_str == then
            if 1 stack.length != then
                token.location f"Constant block must leave exactly one value, got {stack.length}" common::ErrorKind::Syntax parser.state.record_error_string
                std::Option[constant_eval::EvalValue]::None return
            fi
            stack.pop std::Option::Some return
        fi
        if common::TokenKind::Comment token.kind == common::TokenKind::Newline token.kind == || then
            continue
        fi
        if token.kind common::TokenKind::Literal == then
            token.location.clone std::Option[common::BuiltinType]::None token.value.as_str parse_literal_to_constant_value constant_eval::EvalValue::new stack.push
            continue
        fi
        parser
            .state
            .diagnostics
            .error_count = errors_before_intrinsic
        if
            parser.state.diagnostics token.location token.value.as_str stack constant_eval::apply_stack_intrinsic
        then
            if
                parser
                    .state
                    .diagnostics
                    .error_count errors_before_intrinsic <
            then
                std::Option[constant_eval::EvalValue]::None return
            fi
            continue
        fi
        if token.kind common::TokenKind::Operator == then
            if token.value.as_str common::operator_from_str std::Option::Some(operator) is then
                if
                    parser.state.diagnostics token.location annotation.clone operator stack constant_eval::apply_operator !
                then
                    std::Option[constant_eval::EvalValue]::None return
                fi
                continue
            fi
        fi
        if token.kind common::TokenKind::Identifier == then
            if token cursor parser read_constant_reference std::Option::Some(value) is then
                value stack.push
                continue
            fi
            std::Option[constant_eval::EvalValue]::None return
        fi
        token.location f"Unsupported token `{token.value}` in constant block" common::ErrorKind::Syntax parser.state.record_error_string
        std::Option[constant_eval::EvalValue]::None return
    done
    location "Unclosed constant block" common::ErrorKind::Syntax parser.state.record_error
    std::Option[constant_eval::EvalValue]::None
}

impl Parser {
    fn evaluate_constant_declaration
        self:mut$Parser
        cursor:mut$TokenCursor
        declaration:$grammar::DeclarationSyntax
    {
        declaration.first_token = cursor.pos
        cursor.pop.unwrap = keyword
        cursor.pop.unwrap = name_token
        name_token.value.as_str cursor.resolve_name = name
        std::Option[common::BuiltinType]::None = annotation
        if cursor.peek std::Option::Some(next) is then
            if ":" next.value.as_str == then
                cursor.pop drop
                self.state cursor parse_type_ast = annotation_type
                if annotation_type common::Type::Builtin(builtin) is then
                    if
                        builtin.is_integer builtin.is_float ||
                        builtin common::BuiltinType::Bool == ||
                        builtin common::BuiltinType::Char == ||
                        builtin common::BuiltinType::Str == ||
                    then
                        builtin std::Option::Some = annotation
                    else
                        name_token.location f"Unsupported constant type `{builtin.format}`" common::ErrorKind::TypeMismatch self.state.record_error_string
                        return
                    fi
                else
                    name_token.location "Constant annotation must name a primitive value type" common::ErrorKind::TypeMismatch self.state.record_error
                    return
                fi
            fi
        fi
        if cursor.pop std::Option::Some(value_token) is then
            false = block
            std::Option[constant_eval::EvalValue]::None = value
            if "{" value_token.value.as_str == then
                true = block
                cursor.retreat
                value_token.location annotation.clone cursor self evaluate_bounded_block = value
            elif value_token.kind common::TokenKind::Literal == then
                value_token.location.clone std::Option[common::BuiltinType]::None value_token.value.as_str parse_literal_to_constant_value constant_eval::EvalValue::new std::Option::Some = value
            elif value_token.kind common::TokenKind::Identifier == then
                value_token cursor self read_constant_reference = value
            else
                value_token.location "Expected a literal, constant name, or bounded block" common::ErrorKind::Syntax self.state.record_error
                return
            fi
            if value std::Option::Some(initializer) is then
                if
                    self.state.diagnostics name_token.location block annotation.clone initializer constant_eval::constrain std::Option::Some(checked) is
                then
                    if
                        name.as_str self
                            .store
                            .constants
                            .has_str
                    then
                        name_token.location f"Constant `{name_token.value}` is already defined" common::ErrorKind::DuplicateName self.state.record_error_string
                        return
                    fi
                    name_token.location.clone checked.typ.clone checked.value.clone name.clone common::Constant = constant
                    constant.clone name.clone cursor.constants.set
                    constant name.clone self.put_constant
                fi
            fi
        else
            keyword.location "Constant declaration requires an initializer" common::ErrorKind::Syntax self.state.record_error
        fi
    }
}

# ============================================================================
# parse_function - parse function definition
# ============================================================================

pub fn expect_function_name cursor:mut$TokenCursor state:mut$ParseState -> common::Token {
    if cursor.peek std::Option::Some(token) is then
        if "drop" token.value.as_str == then
            cursor.pop.unwrap return
        fi
    fi
    fallback_token state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or
}

pub fn parse_function parser:mut$Parser cursor:mut$TokenCursor -> common::Function {
    cursor parser parse_function_definition = function
    function.name.as_str cursor.resolve_name = function.name
    function
}

pub fn parse_function_definition parser:mut$Parser cursor:mut$TokenCursor -> common::Function {
    cursor.type_bindings.length = inherited_bindings
    fallback_token parser.state "fn" cursor expect_token_value.unwrap_or = fn_token
    parser.state cursor expect_function_name = name_token

    # Parse optional type parameters
    std::List[std::String]::new = type_vars
    std::List[std::String]::new = generic_params
    std::Map[std::String std::List[common::TraitBound]]::new = trait_bounds
    std::Map[std::String common::BuiltinType]::new = const_params
    cursor.peek = tvars_opt
    if tvars_opt std::Option::Some(tvars) is then
        if "[" tvars common::Token::value.as_str == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.into_parts = const_params = trait_bounds = all_type_param_names
            all_type_param_names.clone = generic_params
            # `names` mixes type variables and const parameters; keep only the
            # type variables here (ADR-0152).
            for candidate_name in all_type_param_names.iter do
                if candidate_name const_params.has ! then
                    candidate_name.clone type_vars.push
                fi
            done
        fi
    fi

    parser.state cursor parse_stack_effect = effect

    # Rewrite signature const params to symbolic constants so unification treats
    # them as constants, not type variables (ADR-0152).
    if 0 const_params.keys.length != then
        const_params effect rewrite_stack_effect_constant_parameters
    fi

    # Add type vars to the stack effect
    if 0 type_vars.length != then
        for type_var in type_vars.iter do
            type_var.clone effect common::StackEffect::type_vars.add
        done
        trait_bounds effect common::StackEffect::set_trait_bounds
    fi
    type_vars common::string_list_to_set = function_type_vars
    function_type_vars effect common::canonicalize_stack_effect_type_vars
    std::List[common::Op]::new = ops
    std::List[common::Variable]::new = variables

    const_params effect common::StackEffect::set_const_params

    # Constant parameters are symbolic while this body is checked.
    name_token common::Token::location.clone variables effect inject_constant_parameters = constant_assignments
    constant_assignments ops.append

    # Register named parameters as variables and generate assign ops
    for parameter in effect.parameters.iter do
        if "" parameter.name.as_str != then
            parameter.typ.clone parameter.name.clone common::Variable variables.push
            name_token.location parameter.name.clone common::OpValue::AssignVar common::Op::new ops.push
        fi
    done

    name_token common::Token::value.as_str cursor parser parse_block_ops = body_ops
    function_type_vars body_ops common::canonicalize_operation_type_vars
    effect.const_params body_ops rewrite_operation_constant_parameters
    body_ops ops.append

    effect name_token common::Token::location.clone ops name_token common::Token::value.clone common::Function::with_stack_effect = function
    generic_params function common::Function::set_generic_params
    variables function common::Function::set_variables
    function
    inherited_bindings cursor.restore_type_bindings
}

pub fn does_extern_declaration_end_before parser:$Parser token:$common::Token -> bool {
    if common::TokenKind::Eof token.kind == then
        true return
    fi
    if "->" token.value.as_str == then
        false return
    fi
    token
        .location
        .span
        .offset token
        .location
        .file
        .as_str parser.sources.convert_offset_to_position match
        std::Option::Some(position) => 1 position.column ==
        std::Option::None => false
    end
}

pub fn parse_extern_function parser:mut$Parser cursor:mut$TokenCursor -> common::Function {
    fallback_token parser.state "extern" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state "fn" cursor expect_token_value.unwrap_or drop
    parser.state cursor expect_function_name = name_token

    if cursor.peek std::Option::Some(next) is then
        if "[" next.value.as_str == then
            next.location "Extern functions cannot have type parameters" common::ErrorKind::Syntax
            parser.state.record_error
            cursor parser parse_type_variables drop
        fi
    fi

    std::List[common::Parameter]::new = parameters
    false = has_body
    while true do
        cursor.peek = token_opt
        if token_opt std::Option::Some(token) is then
            if "{" token.value.as_str == then
                token.location "Extern function declarations cannot have a body"
                common::ErrorKind::Syntax parser.state.record_error
                name_token.value.as_str cursor.resolve_name.as_str cursor parser parse_block_ops drop
                true = has_body
                break
            fi
            if token parser does_extern_declaration_end_before then
                break
            fi
            if "->" token.value.as_str == then
                break
            fi
            cursor.pop drop
            if common::TokenKind::Identifier token.kind != "fn" token.value.as_str != && then
                token.location "Unexpected token in extern parameter list"
                common::ErrorKind::UnexpectedToken parser.state.record_error
            fi
            parser.state token cursor parse_parameter_maybe_named parameters.push
        else
            break
        fi
    done

    std::List[common::Type]::new = return_types
    if has_body ! then
        if cursor.peek std::Option::Some(arrow) is then
            if "->" arrow.value.as_str == then
                cursor.pop drop
                while true do
                    cursor.peek = return_token_opt
                    if return_token_opt std::Option::Some(return_token) is then
                        if "{" return_token.value.as_str == then
                            return_token.location "Extern function declarations cannot have a body"
                            common::ErrorKind::Syntax parser.state.record_error
                            name_token.value.as_str cursor.resolve_name.as_str cursor parser parse_block_ops drop
                            break
                        fi
                        if return_token parser does_extern_declaration_end_before then
                            break
                        fi
                        parser.state cursor parse_type_ast return_types.push
                    else
                        break
                    fi
                done
            fi
        fi
    fi
    if 1 return_types.length > then
        name_token.location "Extern functions can return at most one value"
        common::ErrorKind::Syntax parser.state.record_error
    fi

    return_types parameters common::StackEffect::new = effect
    effect name_token.location.clone std::List[common::Op]::new name_token.value.as_str cursor.resolve_name
    common::Function::with_stack_effect = function
    true = function.is_unsafe
    name_token.value.clone std::Option::Some = function.extern_symbol

    function
}

# ============================================================================
# parse_enum - parse enum definition
# ============================================================================

pub fn parse_derived_traits cursor:mut$TokenCursor state:mut$ParseState -> std::List[std::String] {
    std::List[std::String]::new = derived_traits
    if cursor.peek std::Option::Some(token) is then
        if "derives" token.value.as_str != then
            derived_traits return
        fi
        cursor.pop drop
        while true do
            if cursor.peek std::Option::Some(derived) is then
                if "{" derived.value.as_str == then
                    break
                fi
                fallback_token state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or
                common::Token::value.as_str cursor.resolve_name derived_traits.push
            else
                break
            fi
        done
    fi
    derived_traits
}

pub fn parse_enum parser:mut$Parser cursor:mut$TokenCursor -> common::CasaEnum {
    cursor.type_bindings.length = inherited_bindings
    fallback_token parser.state "enum" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    # Parse optional type parameters
    std::List[std::String]::new = type_vars
    cursor.peek = tvars_opt
    if tvars_opt std::Option::Some(tvars) is then
        if "[" tvars common::Token::value.as_str == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.into_parts = parsed_const_params = parsed_bounds = type_vars
            parsed_const_params drop
            parsed_bounds drop
        fi
    fi

    parser.state cursor parse_derived_traits = derived_traits

    fallback_token parser.state "{" cursor expect_token_value.unwrap_or = enum_open_token
    std::List[std::String]::new = variants
    std::Map[std::String std::List[common::Type]]::new = variant_types
    std::Map[std::String common::Location]::new = variant_locations

    while true do
        fallback_token parser.state cursor expect_token.unwrap_or = variant_token
        if "}" variant_token common::Token::value.as_str == then
            break
        fi
        if common::TokenKind::Identifier variant_token common::Token::kind != then
            variant_token common::Token::location "Expected variant name" common::ErrorKind::UnexpectedToken parser.state.record_error
        fi
        if variant_token common::Token::value.as_str variants common::string_list_contains then
            variant_token common::Token::location f"Duplicate variant `{variant_token common::Token::value.as_str}`" common::ErrorKind::DuplicateName parser.state.record_error_string
        fi
        variant_token common::Token::value.clone variants.push
        variant_token common::Token::location.clone variant_token common::Token::value.clone variant_locations.set

        # Parse optional inner types: Variant(type1 type2)
        std::List[common::Type]::new = inner_types
        cursor.peek = paren_opt
        if paren_opt std::Option::Some(paren) is then
            if "(" paren common::Token::value.as_str == then
                cursor.pop drop # consume (
                while true do
                    cursor.peek = inner_opt
                    if inner_opt.is_none then
                        variant_token common::Token::location "Unexpected end of input in variant inner types" common::ErrorKind::UnexpectedToken parser.state.record_error
                        parser.state.mark_output_unusable
                        break
                    fi
                    if inner_opt std::Option::Some(inner) is then
                        if ")" inner common::Token::value.as_str == then
                            cursor.pop drop # consume )
                            break
                        fi
                    fi
                    parser.state cursor parse_type_ast inner_types.push
                done
                if 0 inner_types.length == then
                    variant_token common::Token::location "Variant inner types cannot be empty" common::ErrorKind::Syntax parser.state.record_error
                fi
            fi
        fi
        inner_types variant_token common::Token::value.clone variant_types.set
    done

    if 0 variants.length == then
        name_token common::Token::location "Enum must have at least one variant" common::ErrorKind::Syntax parser.state.record_error
    fi

    type_vars common::string_list_to_set = tv_set
    for variant_name in variants.iter do
        variant_name variant_types.get_mut = vt_opt
        if vt_opt.is_some then
            vt_opt.unwrap = vt_inner
            0 = vt_index: u64
            while vt_index vt_inner.length > do
                tv_set vt_index vt_inner.get.clone common::canonicalize_type_var vt_index vt_inner.set
                1 += vt_index
            done
        fi
    done

    variant_locations derived_traits type_vars variant_types name_token common::Token::location.clone variants
    name_token common::Token::value.as_str cursor.resolve_name common::CasaEnum
    inherited_bindings cursor.restore_type_bindings
}
pub const DERIVED_HASH_SEED 5381
pub const DERIVED_HASH_SHIFT 5

pub fn make_aggregate_receiver name:$str type_vars:$std::List[std::String] -> common::Type {
    std::List[common::Type]::new = arguments
    for type_variable in type_vars.iter do
        type_variable.clone common::Type::TypeVar arguments.push
    done
    arguments name.to_str common::GenericType common::Type::Generic
}

pub fn make_derived_trait_bounds
    trait_name:$str
    type_vars:$std::List[std::String]
    required_type_vars:$std::Set[std::String]
-> std::Map[std::String std::List[common::TraitBound]] {
    std::Map[std::String std::List[common::TraitBound]]::new = trait_bounds
    for type_variable in type_vars.iter do
        if type_variable required_type_vars.has ! then
            continue
        fi
        std::List[common::TraitBound]::new = type_bounds
        std::List[common::Type]::new trait_name.to_str common::TraitBound type_bounds.push
        type_bounds type_variable.clone trait_bounds.set
    done
    trait_bounds
}

pub fn match_derived_impl_parameters
    actual:$common::GenericType
    trait_impl:$common::TraitImpl
-> bool {
    std::Set[std::String]::new = seen
    for parameter in actual.params.iter do
        if parameter common::Type::TypeVar(type_variable) is then
            if type_variable.as_str trait_impl.type_vars common::string_list_contains ! then
                false return
            fi
            if type_variable seen.has then
                false return
            fi
            type_variable.clone seen.add
        else
            false return
        fi
    done
    true
}

pub fn match_derived_generic_receivers
    expected:$common::GenericType
    actual:$common::GenericType
    trait_impl:$common::TraitImpl
    type_vars:$std::List[std::String]
-> bool {
    if expected.base actual.base != expected.params.length actual.params.length != || then
        false return
    fi
    if type_vars.length trait_impl.type_vars.length != then
        false return
    fi
    trait_impl actual match_derived_impl_parameters
}

pub fn match_derived_receiver_impl
    receiver:$common::Type
    type_vars:$std::List[std::String]
    trait_impl:$common::TraitImpl
-> bool {
    if receiver common::Type::Generic(expected) is then
        if trait_impl.receiver common::Type::Generic(actual) is then
            type_vars trait_impl actual expected match_derived_generic_receivers
        else
            false
        fi
    else
        false
    fi
}

pub fn make_derived_function_name receiver:$common::Type method_name:$str -> std::String {
    f"{receiver.match_base}::__derived_{method_name}"
}

pub fn merge_derived_override
    state:mut$ParseState
    receiver:$common::Type
    method_name:$str
    function_name:$std::String
    location:$common::Location
    found:std::Option[std::String]
-> std::Option[std::String] {
    if found.clone std::Option::Some(existing) is then
        if existing function_name != then
            location f"Derived method `{receiver.match_base}::{method_name}` has multiple explicit overrides" common::ErrorKind::DuplicateName state.record_error_string
        fi
        found return
    fi
    function_name.clone std::Option::Some
}

pub fn is_derived_override_trait method_name:$str trait_name:$str -> bool {
    if "clone" method_name == then
        common::STD_CLONE_TRAIT trait_name == return
    fi
    if "hash" method_name == then
        common::STD_HASHABLE_TRAIT trait_name == return
    fi
    if "cmp" method_name == then
        common::STD_ORD_TRAIT trait_name == return
    fi
    if
        "partial_cmp" method_name ==
        "lt" method_name == ||
        "le" method_name == ||
        "gt" method_name == ||
        "ge" method_name == ||
    then
        common::STD_PARTIAL_ORD_TRAIT trait_name ==
        common::STD_ORD_TRAIT trait_name == || return
    fi
    if "eq" method_name == "ne" method_name == || then
        common::STD_PARTIAL_EQ_TRAIT trait_name ==
        common::STD_EQ_TRAIT trait_name == ||
        common::STD_PARTIAL_ORD_TRAIT trait_name == ||
        common::STD_ORD_TRAIT trait_name == ||
        common::STD_HASHABLE_TRAIT trait_name == || return
    fi
    false
}

pub fn does_derived_parameter_override_cover_domain
    store:$common::SymbolStore
    expected_parameter:$common::Type
    actual_parameter:$common::Type
    required_type_vars:$std::Set[std::String]
    required_trait:$str
    trait_impl:$common::TraitImpl
-> bool {
    if expected_parameter common::Type::TypeVar(name) is then
        name.clone std::Option::Some
    else
        std::Option[std::String]::None
    fi = expected_variable_opt
    if expected_variable_opt.is_none then
        true return
    fi
    expected_variable_opt.unwrap = expected_variable

    if actual_parameter common::Type::TypeVar(name) is then
        name.clone std::Option::Some
    else
        std::Option[std::String]::None
    fi = actual_variable_opt
    if actual_variable_opt.is_none then
        true return
    fi
    actual_variable_opt.unwrap = actual_variable

    actual_variable.as_str trait_impl.trait_bounds.get_str = bounds_opt
    if bounds_opt.is_none then
        true return
    fi
    bounds_opt.unwrap = bounds
    if 0 bounds.length != expected_variable.as_str required_type_vars.has_str ! && then
        false return
    fi
    required_trait.to_str common::GenericType::new common::Type::Generic = generated_bound
    for bound in bounds.iter do
        bound common::trait_bound_to_type = explicit_bound
        if store explicit_bound generated_bound rules::trait_type_implies ! then
            false return
        fi
    done
    true
}

pub fn does_derived_override_cover_domain
    store:$common::SymbolStore
    receiver:$common::Type
    required_type_vars:$std::Set[std::String]
    required_trait:$str
    trait_impl:$common::TraitImpl
-> bool {
    if receiver common::Type::Generic(expected) is then
        if trait_impl.receiver common::Type::Generic(actual) is then
            true = covers_domain
            0 = index: u64
            while index expected.params.length > do
                index expected.params.get = expected_parameter
                index actual.params.get = actual_parameter
                trait_impl required_trait required_type_vars actual_parameter expected_parameter store
                does_derived_parameter_override_cover_domain covers_domain && = covers_domain
                1 += index
            done
            covers_domain
        else
            false
        fi
    else
        false
    fi
}

pub fn find_derived_override
    parser:mut$Parser
    receiver:$common::Type
    type_vars:$std::List[std::String]
    required_type_vars:$std::Set[std::String]
    required_trait:$str
    method_name:$str
    location:$common::Location
-> std::Option[std::String] {
    std::Option[std::String]::None = found
    std::Option[std::String]::None = rejected
    for trait_impl in receiver parser.store.get_trait_impl_candidates_for_receiver do
        if trait_impl type_vars receiver match_derived_receiver_impl ! then
            continue
        fi
        if
            trait_impl
                .trait_bound
                .name
                .as_str method_name is_derived_override_trait !
        then
            continue
        fi
        trait_impl.trait_bound common::trait_bound_to_type = trait_type
        if parser.store method_name trait_type rules::trait_type_has_method ! then
            continue
        fi
        method_name trait_impl.methods.get_str = function_name_opt
        if function_name_opt.is_none then
            continue
        fi
        function_name_opt.unwrap = function_name
        method_name receiver make_derived_function_name = generated_name
        if generated_name function_name == then
            continue
        fi
        if
            trait_impl required_trait required_type_vars receiver parser.store does_derived_override_cover_domain !
        then
            if rejected.is_none then
                location f"Explicit `{method_name}` override must cover the full derived implementation domain" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                function_name.clone std::Option::Some = rejected
            fi
            continue
        fi
        found location function_name method_name receiver parser.state merge_derived_override = found
    done
    found
}

pub fn is_derived_trait_bound_satisfied
    parser:mut$Parser
    bounds:$std::List[common::TraitBound]
    required_trait:$str
-> bool {
    required_trait.to_str common::GenericType::new common::Type::Generic = required_type
    for bound in bounds.iter do
        if parser.store required_type bound common::trait_bound_to_type rules::trait_type_implies then
            true return
        fi
    done
    false
}

pub fn add_derived_bound
    parser:mut$Parser
    trait_impl:mut$common::TraitImpl
    type_variable:$std::String
    required_trait:$str
{
    if type_variable trait_impl.trait_bounds.get std::Option::Some(existing_bounds) is then
        existing_bounds.clone = bounds
        if required_trait bounds parser is_derived_trait_bound_satisfied ! then
            std::List[common::Type]::new required_trait.to_str common::TraitBound bounds.push
        fi
        bounds type_variable.clone trait_impl.trait_bounds.set
        return
    fi
    std::List[common::TraitBound]::new = bounds
    std::List[common::Type]::new required_trait.to_str common::TraitBound bounds.push
    bounds type_variable.clone trait_impl.trait_bounds.set
}

pub fn add_derived_bound_at
    parser:mut$Parser
    trait_impl:mut$common::TraitImpl
    receiver:$common::GenericType
    index:u64
    required_trait:$str
{
    if index receiver.params.length > then
        if index receiver.params.get common::Type::TypeVar(type_variable) is then
            required_trait type_variable trait_impl parser add_derived_bound
        fi
    fi
}

pub fn add_named_derived_trait_bounds
    parser:mut$Parser
    trait_impl:mut$common::TraitImpl
    type_vars:$std::List[std::String]
    required_type_vars:$std::Set[std::String]
    required_trait:$str
{
    trait_impl.receiver.clone = receiver_type
    if receiver_type common::Type::Generic(receiver) is then
        0 = index: u64
        while index type_vars.length > do
            index type_vars.get = aggregate_variable
            if aggregate_variable required_type_vars.has then
                required_trait index receiver trait_impl parser add_derived_bound_at
            fi
            1 += index
        done
    fi
}

pub fn install_derived_trait_impl
    parser:mut$Parser
    receiver:$common::Type
    type_vars:$std::List[std::String]
    required_type_vars:$std::Set[std::String]
    required_trait:$str
    trait_name:$str
    methods:$std::Map[std::String std::String]
    location:$common::Location
{
    std::Option[common::TraitImpl]::None = existing_opt
    for
        existing in trait_name receiver parser
            .store
            .get_trait_impl_candidates_for_receiver_and_trait
    do
        if existing type_vars receiver match_derived_receiver_impl ! then
            continue
        fi
        existing.clone std::Option::Some = existing_opt
        break
    done
    if existing_opt std::Option::Some(existing) is then
        if
            existing required_trait required_type_vars receiver parser.store does_derived_override_cover_domain !
        then
            location "Explicit derived implementation must cover the full derived implementation domain" common::ErrorKind::TraitSignatureMismatch parser.state.record_error
            return
        fi
        existing.clone = merged
        for pair in methods.iter do
            if pair.first merged.methods.has ! then
                pair.second.clone pair.first.clone merged.methods.set
            fi
        done
        required_trait required_type_vars type_vars merged parser add_named_derived_trait_bounds
        merged parser.store.set_trait_impl
        return
    fi

    required_type_vars type_vars required_trait make_derived_trait_bounds = trait_bounds
    location.clone
    methods.clone
    trait_bounds
    type_vars.clone
    std::List[common::Type]::new trait_name.to_str common::TraitBound
    receiver.clone
    common::TraitImpl
    parser register_trait_impl
}

pub fn make_derived_method_call
    typ:$common::Type
    trait_name:$str
    method_name:$str
-> common::OpValue {
    trait_name.to_str common::GenericType::new common::Type::Generic std::Option::Some = trait_type
    common::empty_stack_effect trait_type typ.clone method_name.to_str common::DeferredTraitCall::new
    common::OpValue::TraitMethodCall
}

pub fn make_derived_enum_arm
    enum_name:$str
    variant_name:$str
    ordinal:i64
    bindings:std::List[std::String]
-> common::MatchArm {
    ordinal std::Option::Some variant_name.to_str enum_name.to_str common::EnumVariant::new = variant
    bindings variant common::EnumVariant::set_bindings
    std::List[common::Op]::new variant common::PatternValue::EnumVariant common::MatchArm::new
}

pub fn make_derived_wildcard_arm -> common::MatchArm {
    std::Option::None common::MATCH_WILDCARD.to_str "".to_str common::EnumVariant::new = wildcard
    std::List[common::Op]::new wildcard common::PatternValue::EnumVariant common::MatchArm::new
}

pub fn append_derived_ordering
    variant_name:$str
    ordinal:i64
    location:$common::Location
    ops:mut$std::List[common::Op]
{
    ordinal std::Option::Some variant_name.to_str common::STD_ORDERING_TYPE.to_str common::EnumVariant::new = variant
    location.clone variant common::OpValue::PushEnumVariant common::Op::new ops.push
}

pub fn validate_derived_ordering parser:mut$Parser location:$common::Location -> bool {
    if
        common::STD_ORDERING_TYPE parser
            .store
            .enums
            .get_str std::Option::Some(ordering) is
    then
        if 3 ordering.variants.length == ordering common::has_inner_values ! && then
            if
                "Less" 0 ordering.variants.get ==
                "Equal" 1 ordering.variants.get == &&
                "Greater" 2 ordering.variants.get == &&
            then
                true return
            fi
        fi
    fi
    location "Derived `Ord` requires `Ordering` variants `Less`, `Equal`, and `Greater` in that order" common::ErrorKind::TraitSignatureMismatch parser.state.record_error
    false
}

pub fn make_derived_borrow_method
    receiver:$common::Type
    type_vars:$std::List[std::String]
    trait_bounds:std::Map[std::String std::List[common::TraitBound]]
    parameter_names:$std::List[std::String]
    return_type:$common::Type
    body_ops:std::List[common::Op]
    function_name:$str
    location:$common::Location
-> common::Function {
    std::List[common::Parameter]::new = parameters
    std::List[common::Variable]::new = variables
    std::List[common::Op]::new = ops
    common::SHARED_BORROW_TYPE receiver.clone common::apply_borrow_type = borrowed_receiver
    for parameter_name in parameter_names.iter do
        parameter_name.clone borrowed_receiver.clone common::Parameter::named parameters.push
        borrowed_receiver.clone parameter_name.clone common::Variable variables.push
        location.clone parameter_name.clone common::OpValue::AssignVar common::Op::new ops.push
    done
    body_ops ops.append
    std::List[common::Type]::new = returns
    return_type.clone returns.push
    returns parameters common::StackEffect::new = effect
    type_vars common::string_list_to_set = effect.type_vars
    trait_bounds effect common::StackEffect::set_trait_bounds
    effect location.clone ops function_name.to_str common::Function::with_stack_effect = function
    variables function common::Function::set_variables
    function
}

pub fn append_struct_derived_eq_body
    casa_struct:$common::CasaStruct
    location:$common::Location
    ops:mut$std::List[common::Op]
{
    location.clone 1 common::OpValue::PushBool common::Op::new ops.push
    for member in casa_struct.members.iter do
        location.clone "other".to_str common::OpValue::PushVar common::Op::new ops.push
        location.clone member.name.clone common::OpValue::MethodCall common::Op::new ops.push
        location.clone "self".to_str common::OpValue::PushVar common::Op::new ops.push
        location.clone member.name.clone common::OpValue::MethodCall common::Op::new ops.push
        location.clone "eq" common::STD_PARTIAL_EQ_TRAIT member.typ make_derived_method_call common::Op::new ops.push
        location.clone common::OpValue::And common::Op::new ops.push
    done
}

pub fn append_enum_derived_eq_body
    casa_enum:$common::CasaEnum
    location:$common::Location
    ops:mut$std::List[common::Op]
{
    location.clone "self".to_str common::OpValue::PushVar common::Op::new ops.push
    location.clone common::OpValue::MatchStart common::Op::new ops.push
    0 = variant_index: u64
    for variant_name in casa_enum.variants.iter do
        std::List[std::String]::new = self_bindings
        std::List[std::String]::new = other_bindings
        variant_name casa_enum
            .variant_types
            .get
            .unwrap = payload_types
        payload_types.length = payload_count
        0 = payload_index: u64
        while payload_index payload_count > do
            f"__derived_eq_self_{variant_index}_{payload_index}" self_bindings.push
            f"__derived_eq_other_{variant_index}_{payload_index}" other_bindings.push
            1 += payload_index
        done
        self_bindings variant_index i64::try_from.unwrap variant_name.as_str casa_enum.name.as_str make_derived_enum_arm = self_arm
        location.clone self_arm common::OpValue::MatchArm common::Op::new ops.push
        location.clone "other".to_str common::OpValue::PushVar common::Op::new ops.push
        location.clone common::OpValue::MatchStart common::Op::new ops.push
        other_bindings variant_index i64::try_from.unwrap variant_name.as_str casa_enum.name.as_str make_derived_enum_arm = other_arm
        location.clone other_arm common::OpValue::MatchArm common::Op::new ops.push
        location.clone 1 common::OpValue::PushBool common::Op::new ops.push
        0 = payload_index: u64
        while payload_index payload_count > do
            location.clone f"__derived_eq_other_{variant_index}_{payload_index}" common::OpValue::PushVar common::Op::new ops.push
            location.clone f"__derived_eq_self_{variant_index}_{payload_index}" common::OpValue::PushVar common::Op::new ops.push
            location.clone "eq" common::STD_PARTIAL_EQ_TRAIT payload_index payload_types.get make_derived_method_call common::Op::new ops.push
            location.clone common::OpValue::And common::Op::new ops.push
            1 += payload_index
        done
        make_derived_wildcard_arm = wildcard_arm
        location.clone wildcard_arm common::OpValue::MatchArm common::Op::new ops.push
        location.clone 0 common::OpValue::PushBool common::Op::new ops.push
        location.clone common::OpValue::MatchEnd common::Op::new ops.push
        1 += variant_index
    done
    location.clone common::OpValue::MatchEnd common::Op::new ops.push
}

pub fn append_derived_cmp_result location:$common::Location ops:mut$std::List[common::Op] {
    location.clone common::OpValue::MatchStart common::Op::new ops.push
    std::List[std::String]::new 0 "Less" common::STD_ORDERING_TYPE make_derived_enum_arm = less_arm
    location.clone less_arm common::OpValue::MatchArm common::Op::new ops.push
    ops location 0 "Less" append_derived_ordering
    location.clone common::OpValue::FnReturn common::Op::new ops.push
    std::List[std::String]::new 1 "Equal" common::STD_ORDERING_TYPE make_derived_enum_arm = equal_arm
    location.clone equal_arm common::OpValue::MatchArm common::Op::new ops.push
    std::List[std::String]::new 2 "Greater" common::STD_ORDERING_TYPE make_derived_enum_arm = greater_arm
    location.clone greater_arm common::OpValue::MatchArm common::Op::new ops.push
    ops location 2 "Greater" append_derived_ordering
    location.clone common::OpValue::FnReturn common::Op::new ops.push
    location.clone common::OpValue::MatchEnd common::Op::new ops.push
}

pub fn append_struct_derived_cmp_body
    casa_struct:$common::CasaStruct
    location:$common::Location
    ops:mut$std::List[common::Op]
{
    for member in casa_struct.members.iter do
        location.clone "other".to_str common::OpValue::PushVar common::Op::new ops.push
        location.clone member.name.clone common::OpValue::MethodCall common::Op::new ops.push
        location.clone "self".to_str common::OpValue::PushVar common::Op::new ops.push
        location.clone member.name.clone common::OpValue::MethodCall common::Op::new ops.push
        location.clone "cmp" common::STD_ORD_TRAIT member.typ make_derived_method_call common::Op::new ops.push
        ops location append_derived_cmp_result
    done
    ops location 1 "Equal" append_derived_ordering
}

pub fn append_derived_enum_cmp_variant
    casa_enum:$common::CasaEnum
    self_variant:$std::String
    self_index:u64
    self_payload_count:u64
    location:$common::Location
    ops:mut$std::List[common::Op]
{
    0 = other_index: u64
    for other_variant in casa_enum.variants.iter do
        std::List[std::String]::new = other_bindings
        other_variant casa_enum
            .variant_types
            .get
            .unwrap
            .length = other_payload_count
        0 = payload_index: u64
        while payload_index other_payload_count > do
            f"__derived_cmp_other_{self_index}_{other_index}_{payload_index}" other_bindings.push
            1 += payload_index
        done
        other_bindings other_index i64::try_from.unwrap other_variant.as_str casa_enum.name.as_str make_derived_enum_arm = other_arm
        location.clone other_arm common::OpValue::MatchArm common::Op::new ops.push
        if self_index other_index == then
            self_variant casa_enum
                .variant_types
                .get
                .unwrap = payload_types
            0 = payload_index: u64
            while payload_index self_payload_count > do
                location.clone f"__derived_cmp_other_{self_index}_{other_index}_{payload_index}" common::OpValue::PushVar common::Op::new ops.push
                location.clone f"__derived_cmp_self_{self_index}_{payload_index}" common::OpValue::PushVar common::Op::new ops.push
                location.clone "cmp" common::STD_ORD_TRAIT payload_index payload_types.get make_derived_method_call common::Op::new ops.push
                ops location append_derived_cmp_result
                1 += payload_index
            done
            ops location 1 "Equal" append_derived_ordering
        elif other_index self_index < then
            ops location 0 "Less" append_derived_ordering
        else
            ops location 2 "Greater" append_derived_ordering
        fi
        1 += other_index
    done
}

