            if
                resolve_errors allow_root_local_capture current_op.location store function inc_root.as_str
                reject_root_local_capture
            then
                common::OpValue::Rejected current_op common::Op::set_value
                current_op op_index 1 - ops.set
                continue
            fi
        fi

        if current_op.value common::OpValue::AssignDec(dec_name_ref) is then
            dec_name_ref.clone = dec_name
            dec_name.as_str "." str::split = dec_parts
            0 dec_parts.get = dec_root
            if
                dec_root.as_str store
                    .constants
                    .get_str
                    .is_some
            then
                current_op common::Op::location.clone f"Cannot assign to constant `{dec_root}`" common::ErrorKind::Syntax error::CasaError::new resolve_errors.push
                common::OpValue::Rejected current_op common::Op::set_value
                current_op op_index 1 - ops.set
                continue
            fi
            if
                resolve_errors allow_root_local_capture current_op.location store function dec_root.as_str
                reject_root_local_capture
            then
                common::OpValue::Rejected current_op common::Op::set_value
                current_op op_index 1 - ops.set
                continue
            fi
        fi

        if current_op.value common::OpValue::AssignVar(var_name_ref) is then
            var_name_ref.clone = var_name
            var_name.as_str "." str::split = var_parts
            0 var_parts.get = var_root
            if
                var_root.as_str store
                    .constants
                    .get_str
                    .is_some
            then
                current_op common::Op::location.clone f"Cannot assign to constant `{var_root}`" common::ErrorKind::Syntax error::CasaError::new resolve_errors.push
                common::OpValue::Rejected current_op common::Op::set_value
                current_op op_index 1 - ops.set
