# Generic associated-item syntax erases type arguments from the identifier.
# Check both that identifier and the receiver which remains in the type hint.

fn is_private_identifier_or_receiver store:$common::SymbolStore op:$common::Op ident:$str -> bool {
    op
        .location
        .file
        .as_str = source_file
    if source_file ident store.is_private_from then
        true return
    fi
    if op.type_hint std::Option::Some(receiver_type) is then
        receiver_type.match_base = receiver_name
        source_file receiver_name.as_str store.is_private_from return
    fi
    false
}
# A concrete method can be visible even when its erased generic fallback is
# private. Other hinted associated items must pass the normal privacy check.

fn can_defer_private_method_check store:$common::SymbolStore op:$common::Op ident:$str -> bool {
    if op.type_hint std::Option::Some(receiver_type) is then
        if ident "::" str::find 0 <= ! then
            false return
        fi
        ident "::" str::split = parts
        parts.length 1 - parts.get = method_name
        receiver_type.match_base = receiver_base
        if
            op
                .location
                .file
                .as_str receiver_base.as_str store.is_private_from
        then
            false return
        fi
        if receiver_base.as_str store.enums.get_str std::Option::Some(casa_enum) is then
            if method_name.as_str casa_enum common::CasaEnum::variants common::string_list_contains then
                false return
            fi
        fi
        f"{receiver_type.format}::{method_name}" = exact_name
        if exact_name.as_str store.has_function then
            op
                .location
                .file
                .as_str exact_name.as_str store.is_private_from ! return
        fi
    fi
    false
}
# Try resolving compiler-owned numeric associated conversion calls.

pub fn try_resolve_numeric_call op:mut$common::Op ident:$str -> bool {
    ident "::" str::find = separator
    if separator 0 <= ! then
        false return
    fi
    ident 0 separator u64::try_from.unwrap str::substring = target_name
    target_name.as_str common::parse_builtin = target_opt
    if target_opt.is_none then
        false return
    fi
    ident separator 2 + u64::try_from.unwrap ident.length separator u64::try_from.unwrap - 2 - str::substring = method
    if
        "from" method.as_str ==
        "from_bits" method.as_str == ||
        "round_from" method.as_str == ||
        "trunc_from" method.as_str == ||
        "wrapping_from" method.as_str == ||
        "from_codepoint_unchecked" method.as_str == ||
        "__from_decimal_parts" method.as_str == ||
        "__float_significand" method.as_str == ||
        "try_from" method.as_str == || !
    then
        false return
    fi
    target_opt.unwrap method common::NumericCall common::OpValue::NumericCall op common::Op::set_value
    true
}
# resolve_match_op — per-arm identifier resolution entry point.
# Registers struct-pattern field bindings as locals/globals and resolves
# enum-variant ordinals (delegating to resolve_enum_variant). Literal and
# wildcard arms need no resolution.

pub fn register_struct_pattern_binding
    store:mut$common::SymbolStore
    function:mut$common::Function
    binding_name:$str
{
    binding_name common::Variable::new = match_struct_variant
    if common::GLOBAL_SCOPE_LABEL function common::Function::name.as_str == then
        match_struct_variant binding_name.clone store.variables.set_str
    else
        if binding_name function common::Function::variables common::variable_list_contains ! then
            match_struct_variant function common::Function::variables.push
        fi
    fi
}

impl common::Op {
    pub fn set_match_pattern_value self:mut$common::Op pattern_value:common::PatternValue {
        if self.value common::OpValue::MatchArm(arm) is then
            arm.clone = updated_arm
            pattern_value updated_arm common::MatchArm::set_pattern_value
            updated_arm common::OpValue::MatchArm self.set_value
        fi
    }
}

pub fn resolve_match_op
    store:mut$common::SymbolStore
    function:mut$common::Function
    op:mut$common::Op
    allow_root_local_capture:bool
    errors:mut$std::List[error::CasaError]
    diagnostics:mut$error::Diagnostics
{
    op common::pattern_value_of match
        common::PatternValue::Struct(struct_pattern) => {
            struct_pattern.bindings.keys = pattern_keys
            for pattern_key in pattern_keys.iter do
                pattern_key struct_pattern
                    .bindings
                    .get
                    .unwrap = binding_name
                binding_name.as_str function store register_struct_pattern_binding
            done
        }
        common::PatternValue::EnumVariant(variant) => {
            errors function op variant store resolve_enum_variant
            variant common::PatternValue::EnumVariant op.set_match_pattern_value
        }
        common::PatternValue::Literal => {
        }
    end
    if op.value common::OpValue::MatchArm(arm) is then
        if arm.guard_ops.length 0 != then
            arm.clone = resolved_arm
            diagnostics allow_root_local_capture function resolved_arm.guard_ops store resolve_identifiers
            resolved_arm common::OpValue::MatchArm op common::Op::set_value
        fi
    fi
}
# Try resolving `&name` and `&K::method` function references. Returns true
# if the identifier begins with `&`, in which case the op has been rewritten
# (or an error pushed) and the caller should skip further resolution.

pub fn try_resolve_fn_ref
    store:mut$common::SymbolStore
    function:mut$common::Function
    op:mut$common::Op
    ident:$str
    resolve_errors:mut$std::List[error::CasaError]
-> bool {
    if '&' 0 ident.at != then
        false return
    fi
    ident 1 ident.length 1 - str::substring = ref_name
    if 0 ref_name.length == then
        op common::Op::location.clone "Expected function name after `&`".to_str common::ErrorKind::Syntax error::CasaError::new resolve_errors.push
        true return
    fi
    ref_name.as_str "::" str::split = ref_parts
    if 2 ref_parts.length == "drop" ref_parts.length 1 - ref_parts.get.as_str == && then
        op common::Op::location.clone "Reserved `drop` methods cannot be referenced".to_str common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
        true return
    fi
    if 3 ref_parts.length == then
        0 ref_parts.get.as_str common::parse_type_str = receiver_type
        1 ref_parts.get.clone common::GenericType::new common::Type::Generic = qualifier_type
        if op.type_hint std::Option::Some(hint) is then
            hint.match_base = hint_base
            if 0 ref_parts.get.as_str hint_base.as_str == then
                hint.clone = receiver_type
            elif hint.type_params std::Option::Some(type_arguments) is then
                type_arguments.clone 1 ref_parts.get.clone common::GenericType common::Type::Generic = qualifier_type
            fi
        fi
        2 ref_parts.get = method_name
        store receiver_type qualifier_type method_name.as_str rules::resolve_qualified_method_semantics
        = method_opt
        if method_opt.is_none then
            if op.type_hint std::Option::Some(hint) is then
                store std::Option[common::Function]::None hint method_name.as_str
                rules::resolve_method_semantics
                = method_opt
            fi
        fi
        if method_opt std::Option::Some(method) is then
            if method.function_name.as_str store.is_function_unsafe std::Option::Some(is_unsafe) is then
                if
                    op
                        .location
                        .file
                        .as_str method.function_name.as_str store.is_private_from
                then
                    op common::Op::location.clone f"Function `{method.function_name}` is private"
                    common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                    true return
                fi
                if is_unsafe then
                    op common::Op::location.clone f"Unsafe function `{method.function_name}` cannot be referenced" common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                    true return
                fi
                method.function_name.clone common::OpValue::FnPush op common::Op::set_value
                true return
            fi
        fi
    fi
    if ref_name.as_str "::" str::find 0 <= then
        ref_name.as_str 0 ref_name.as_str "::" str::find u64::try_from.unwrap str::substring = ref_type_var
        ref_type_var.as_str function common::Function::stack_effect common::StackEffect::trait_bounds.get_str = ref_bound_opt
        if ref_bound_opt.is_some then
            ref_name.as_str ref_name.as_str "::" str::find 2 + u64::try_from.unwrap
            ref_name.length ref_name.as_str "::" str::find u64::try_from.unwrap - 2 -
            str::substring = ref_trait_method
            ref_type_var.to_str common::Type::TypeVar = receiver
            receiver ref_trait_method common::DeferredTraitCall::unresolved
            common::OpValue::TraitMethodRef op common::Op::set_value
            true return
        fi
    fi
    if 2 ref_parts.length == then
        0 ref_parts.get.as_str common::parse_type_str = receiver_type
        if op.type_hint std::Option::Some(hint) is then
            hint.clone = receiver_type
        fi
        1 ref_parts.get = method_name
        store std::Option[common::Function]::None receiver_type method_name.as_str rules::resolve_method_semantics
        = method_opt
        if method_opt std::Option::Some(method) is then
            if method.function_name.as_str store.is_function_unsafe std::Option::Some(is_unsafe) is then
                if
                    op
                        .location
                        .file
                        .as_str method.function_name.as_str store.is_private_from
                then
                    op common::Op::location.clone f"Function `{method.function_name}` is private"
                    common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                    true return
                fi
                if is_unsafe then
                    op common::Op::location.clone f"Unsafe function `{method.function_name}` cannot be referenced" common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                    true return
                fi
                method.function_name.clone common::OpValue::FnPush op common::Op::set_value
                true return
            fi
        fi
    fi
    ref_name.as_str store.is_function_unsafe = ref_is_unsafe_opt
    if ref_is_unsafe_opt std::Option::Some(ref_is_unsafe) is then
        if ref_is_unsafe then
            op common::Op::location.clone f"Unsafe function `{ref_name}` cannot be referenced" common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
            true return
        fi
        ref_name.clone common::OpValue::FnPush op common::Op::set_value
    else
        op common::Op::location.clone f"Function `{ref_name}` is not defined" common::ErrorKind::UndefinedName error::CasaError::new resolve_errors.push
    fi
    true
}
# Try resolving `Enum::Variant` identifiers. Returns true if the enum is
