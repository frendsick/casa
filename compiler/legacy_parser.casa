                    resolve_errors allow_root_local_capture current_op.location store function var_root.as_str
                    reject_root_local_capture
                then
                    common::OpValue::Rejected current_op common::Op::set_value
                    current_op op_index 1 - ops.set
                    continue
                fi
                current_op op_index 1 - ops.set
                continue
            fi
            var_name.as_str common::Variable::new = variable
            if common::GLOBAL_SCOPE_LABEL function common::Function::name.as_str == then
