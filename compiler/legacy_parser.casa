    }

    fn prepare_module self:mut$Parser tokens:$std::List[common::Token] module_prefix:$str {
        if tokens.is_empty then
            self.state.mark_output_unusable return
        fi
        0 self.state.diagnostics take_diagnostics_since = lexical_diagnostics
        std::Option[u64]::None = lexical_limit
        for diagnostic in lexical_diagnostics.entries.iter do
