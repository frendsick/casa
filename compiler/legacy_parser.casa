            fi

            if captured ! then
                # Check root bindings.
                name.as_str store.variables.get_str = global_var_opt
                if global_var_opt std::Option::Some(global_var) is then
                    if allow_root_local_capture then
                        if name.as_str lambda_function.captures common::variable_list_contains ! then
