pub fn set_derived_method
    methods:mut$std::Map[std::String std::String]
    method_name:$str
    function_name:$std::Option[std::String]
{
    if function_name std::Option::Some(name) is then
        name.clone method_name.to_str methods.set
    fi
}

pub fn does_derived_clone_type_require_var typ:$common::Type type_var:$str -> bool {
    if typ.is_borrow then
        false return
    fi
    typ match
        common::Type::TypeVar(name) => name.as_str type_var ==
        common::Type::Const(const_type) => const_type.is_symbolic const_type.name.as_str type_var == &&
        common::Type::Generic(generic) => {
            for parameter in generic.params.iter do
                if type_var parameter does_derived_clone_type_require_var then
                    true return
                fi
            done
            false
        }
        common::Type::Function(function_type) => {
            for parameter in function_type.parameters.iter do
                if type_var parameter does_derived_clone_type_require_var then
                    true return
                fi
            done
            for return_type in function_type.return_types.iter do
                if type_var return_type does_derived_clone_type_require_var then
                    true return
                fi
            done
            false
        }
        _ => false
    end
}

pub fn does_type_contain_exclusive_borrow typ:$common::Type -> bool {
    if typ.is_shared_borrow then
        false return
    fi
    if typ.is_exclusive_borrow then
        true return
    fi
    if typ common::Type::Generic(generic) is then
        for parameter in generic.params.iter do
            if parameter does_type_contain_exclusive_borrow then
                true return
            fi
        done
    fi
    false
}

pub fn add_derived_required_type_vars
    typ:$common::Type
    type_vars:$std::List[std::String]
    required_type_vars:mut$std::Set[std::String]
{
    for type_variable in type_vars.iter do
        if type_variable.as_str typ.type_contains_var then
            type_variable.clone required_type_vars.add
        fi
    done
}

pub fn add_derived_clone_required_type_vars
    typ:$common::Type
    type_vars:$std::List[std::String]
    required_type_vars:mut$std::Set[std::String]
{
    for type_variable in type_vars.iter do
        if type_variable.as_str typ does_derived_clone_type_require_var then
            type_variable.clone required_type_vars.add
        fi
    done
}

pub fn derive_traits_for_aggregate
    parser:mut$Parser
    name:$str
    type_vars:$std::List[std::String]
    derived_traits:$std::List[std::String]
    required_type_vars:$std::Set[std::String]
    clone_required_type_vars:$std::Set[std::String]
    has_exclusive_borrow:bool
    location:$common::Location
{
    false = derives_clone
    false = derives_copy
    false = derives_eq
    false = derives_hashable
    false = derives_ord
    for derived_trait in derived_traits.iter do
        if common::STD_CLONE_TRAIT derived_trait.as_str == then
            true = derives_clone
        elif common::STD_COPY_TRAIT derived_trait.as_str == then
            true = derives_copy
        elif common::STD_EQ_TRAIT derived_trait.as_str == then
            true = derives_eq
        elif common::STD_HASHABLE_TRAIT derived_trait.as_str == then
            true = derives_hashable
        elif common::STD_ORD_TRAIT derived_trait.as_str == then
            true = derives_ord
        else
            location f"Derivation for trait `{derived_trait}` is not supported" common::ErrorKind::InvalidScope parser.state.record_error_string
        fi
    done

    type_vars name make_aggregate_receiver = receiver
    derives_eq derives_hashable || derives_ord || = needs_eq
    common::STD_EQ_TRAIT.to_str = eq_required_trait
    if derives_eq ! then
        if derives_ord derives_hashable && then
            common::STD_EQ_TRAIT.to_str = eq_required_trait
        elif derives_ord then
            common::STD_ORD_TRAIT.to_str = eq_required_trait
        else
            common::STD_HASHABLE_TRAIT.to_str = eq_required_trait
        fi
    fi
    std::Option[std::String]::None = clone_override
    std::Option[std::String]::None = eq_override
    std::Option[std::String]::None = hash_override
    std::Option[std::String]::None = cmp_override
    if derives_clone then
        location "clone" common::STD_CLONE_TRAIT clone_required_type_vars type_vars receiver parser find_derived_override = clone_override
    fi
    if needs_eq then
        location "eq" eq_required_trait.as_str required_type_vars type_vars receiver parser find_derived_override = eq_override
    fi
    if derives_hashable then
        location "hash" common::STD_HASHABLE_TRAIT required_type_vars type_vars receiver parser find_derived_override = hash_override
    fi
    if derives_ord then
        location "cmp" common::STD_ORD_TRAIT required_type_vars type_vars receiver parser find_derived_override = cmp_override
    fi

    clone_override.is_none derives_clone && = clone_generated
    eq_override.is_none needs_eq && = eq_generated
    hash_override.is_none derives_hashable && = hash_generated
    cmp_override.is_none derives_ord && = cmp_generated
    if clone_generated has_exclusive_borrow && then
        location f"Cannot derive `Clone` for `{name}` because exclusive-borrow fields cannot be cloned"
        common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
        false = derives_clone
        false = clone_generated
    fi
    if eq_override.is_some then
        if derives_hashable hash_override.is_none && then
            location "A custom derived `eq` method requires an explicit `hash` companion" common::ErrorKind::TraitSignatureMismatch parser.state.record_error
            false = hash_generated
        fi
        if derives_ord cmp_override.is_none && then
            location "A custom derived `eq` method requires an explicit `cmp` companion" common::ErrorKind::TraitSignatureMismatch parser.state.record_error
            false = cmp_generated
        fi
    fi

    std::Option[std::String]::None = clone_function
    if clone_override std::Option::Some(override_name) is then
        override_name.clone std::Option::Some = clone_function
    elif clone_generated then
        "clone" receiver make_derived_function_name = function_name
        if function_name.as_str parser.store.has_function ! then
            location clone_required_type_vars type_vars receiver parser make_derived_clone_function = function
            function parser.store.set_function
        fi
        function_name std::Option::Some = clone_function
    fi

    std::Option[std::String]::None = eq_function
    if eq_override std::Option::Some(override_name) is then
        override_name.clone std::Option::Some = eq_function
    elif eq_generated then
        "eq" receiver make_derived_function_name = function_name
        if function_name.as_str parser.store.has_function ! then
            location required_type_vars type_vars receiver parser make_derived_eq_function = function
            function parser.store.set_function
        fi
        function_name std::Option::Some = eq_function
    fi

    std::Option[std::String]::None = hash_function
    if hash_override std::Option::Some(override_name) is then
        override_name.clone std::Option::Some = hash_function
    elif hash_generated then
        "hash" receiver make_derived_function_name = function_name
        if function_name.as_str parser.store.has_function ! then
            location required_type_vars type_vars receiver parser make_derived_hash_function = function
            function parser.store.set_function
        fi
        function_name std::Option::Some = hash_function
    fi

    std::Option[std::String]::None = cmp_function
    if cmp_override std::Option::Some(override_name) is then
        override_name.clone std::Option::Some = cmp_function
    elif cmp_generated then
        if location parser validate_derived_ordering then
            "cmp" receiver make_derived_function_name = function_name
            if function_name.as_str parser.store.has_function ! then
                location required_type_vars type_vars receiver parser make_derived_cmp_function = function
                function parser.store.set_function
            fi
            function_name std::Option::Some = cmp_function
        else
            false = cmp_generated
        fi
    fi

    std::Option[std::String]::None = ne_override
    std::Option[std::String]::None = partial_cmp_override
    std::Option[std::String]::None = lt_override
    std::Option[std::String]::None = le_override
    std::Option[std::String]::None = gt_override
    std::Option[std::String]::None = ge_override
    if needs_eq then
        location "ne" eq_required_trait.as_str required_type_vars type_vars receiver parser find_derived_override = ne_override
    fi
    if derives_ord then
        location "partial_cmp" common::STD_ORD_TRAIT required_type_vars type_vars receiver parser find_derived_override = partial_cmp_override
        location "lt" common::STD_ORD_TRAIT required_type_vars type_vars receiver parser find_derived_override = lt_override
        location "le" common::STD_ORD_TRAIT required_type_vars type_vars receiver parser find_derived_override = le_override
        location "gt" common::STD_ORD_TRAIT required_type_vars type_vars receiver parser find_derived_override = gt_override
        location "ge" common::STD_ORD_TRAIT required_type_vars type_vars receiver parser find_derived_override = ge_override
    fi

    if derives_clone then
        std::Map[std::String std::String]::new = methods
        clone_function "clone" methods set_derived_method
        location methods common::STD_CLONE_TRAIT common::STD_CLONE_TRAIT clone_required_type_vars type_vars receiver parser
        install_derived_trait_impl
    fi
    if derives_copy then
        std::Map[std::String std::String]::new = methods
        location methods common::STD_COPY_TRAIT common::STD_COPY_TRAIT required_type_vars type_vars receiver parser
        install_derived_trait_impl
    fi
    if derives_eq then
        std::Map[std::String std::String]::new = methods
        eq_function "eq" methods set_derived_method
        ne_override "ne" methods set_derived_method
        location methods common::STD_EQ_TRAIT common::STD_EQ_TRAIT required_type_vars type_vars receiver parser
        install_derived_trait_impl
    fi
    if derives_ord then
        std::Map[std::String std::String]::new = methods
        eq_function "eq" methods set_derived_method
        ne_override "ne" methods set_derived_method
        cmp_function "cmp" methods set_derived_method
        partial_cmp_override "partial_cmp" methods set_derived_method
        lt_override "lt" methods set_derived_method
        le_override "le" methods set_derived_method
        gt_override "gt" methods set_derived_method
        ge_override "ge" methods set_derived_method
        location methods common::STD_ORD_TRAIT common::STD_ORD_TRAIT required_type_vars type_vars receiver parser
        install_derived_trait_impl
    fi
    if derives_hashable then
        std::Map[std::String std::String]::new = methods
        eq_function "eq" methods set_derived_method
        ne_override "ne" methods set_derived_method
        hash_function "hash" methods set_derived_method
        location methods common::STD_HASHABLE_TRAIT common::STD_HASHABLE_TRAIT required_type_vars type_vars receiver parser
        install_derived_trait_impl
    fi
}

pub fn derive_traits_for_aggregates parser:mut$Parser {
    for
        casa_struct in parser
            .store
            .structs
            .values
            .iter
    do
        std::Set[std::String]::new = required_type_vars
        std::Set[std::String]::new = clone_required_type_vars
        false = has_exclusive_borrow
        for member in casa_struct.members.iter do
            required_type_vars casa_struct.type_vars member.typ add_derived_required_type_vars
            clone_required_type_vars casa_struct.type_vars member.typ add_derived_clone_required_type_vars
            if member.typ does_type_contain_exclusive_borrow then
                true = has_exclusive_borrow
            fi
        done
        casa_struct.location has_exclusive_borrow clone_required_type_vars required_type_vars casa_struct.derived_traits casa_struct.type_vars
        casa_struct.name.as_str parser derive_traits_for_aggregate
    done
    for
        casa_enum in parser
            .store
            .enums
            .values
            .iter
    do
        std::Set[std::String]::new = required_type_vars
        std::Set[std::String]::new = clone_required_type_vars
        false = has_exclusive_borrow
        for pair in casa_enum.variant_types.iter do
            for payload_type in pair.second.iter do
                required_type_vars casa_enum.type_vars payload_type add_derived_required_type_vars
                clone_required_type_vars casa_enum.type_vars payload_type add_derived_clone_required_type_vars
                if payload_type does_type_contain_exclusive_borrow then
                    true = has_exclusive_borrow
                fi
            done
        done
        casa_enum.location has_exclusive_borrow clone_required_type_vars required_type_vars casa_enum.derived_traits casa_enum.type_vars
        casa_enum.name.as_str parser derive_traits_for_aggregate
    done
}

pub fn register_builtin_copy_impls parser:mut$Parser {
    if
        common::STD_COPY_TRAIT parser
            .store
            .traits
            .has_str !
    then
        return
    fi
    parser
        .store
        .builtins
        .clone = builtin_names
    for builtin_name in builtin_names.iter do
        if "str" builtin_name.as_str == "array" builtin_name.as_str == || then
            continue
        fi
        builtin_name.as_str common::parse_type_str = receiver
        if parser.store common::STD_COPY_TRAIT receiver rules::find_satisfying_trait_type.is_some then
            continue
        fi
        common::STD_COPY_TRAIT parser
            .store
            .traits
            .get_str
            .unwrap
            .location
            .clone
        std::Map[std::String std::String]::new
        std::Map[std::String std::List[common::TraitBound]]::new
        std::List[std::String]::new
        std::List[common::Type]::new common::STD_COPY_TRAIT.to_str common::TraitBound
        receiver
        common::TraitImpl
        parser register_trait_impl
    done
}

# ============================================================================
# _create_member_accessor - create getter/setter for struct members
# ============================================================================

pub fn create_member_accessor
    parser:mut$Parser
    struct_name:$str
    member_name:$str
    member_type:$common::Type
    prior_members:$std::List[common::Member]
    location:$common::Location
    type_vars:$std::List[std::String]
{
    # Parameterize the struct name when the struct has type vars
    std::List[common::Type]::new struct_name.to_str common::GenericType common::Type::Generic = param_type
    type_vars common::string_list_to_set = effect_type_vars
    if 0 type_vars.length != then
        type_vars struct_name common::build_parameterized_type = param_type
    fi

    # Getter
    f"{struct_name}::{member_name}" = getter_name
    std::List[common::Op]::new = getter_ops
    location.clone common::OpValue::UnsafeStart common::Op::new getter_ops.push
    location.clone common::OpValue::PtrFromRef common::Op::new getter_ops.push
    prior_members.length struct_name.to_str common::StructMemberAccess
    common::OpValue::StructMemberProject = project_op
    location.clone project_op common::Op::new getter_ops.push
    location.clone common::OpValue::UnsafeEnd common::Op::new getter_ops.push

    std::List[common::Parameter]::new = getter_params
    "".to_str common::SHARED_BORROW_TYPE param_type.clone common::apply_borrow_type common::Parameter::named getter_params.push
    std::List[common::Type]::new = getter_returns
    member_type.clone getter_returns.push
    getter_returns getter_params common::StackEffect::new = getter_stack_effect
    effect_type_vars.clone getter_stack_effect common::StackEffect::set_type_vars
    effect_type_vars getter_stack_effect common::canonicalize_stack_effect_type_vars
    getter_stack_effect location.clone getter_ops getter_name.clone
    common::Function::with_stack_effect = getter
    true getter common::Function::set_is_typechecked

    if
        getter_name.as_str parser
            .store
            .get_function
            .is_some
    then
        location f"Function `{getter_name}` is already defined" common::ErrorKind::DuplicateName parser.state.record_error_string
    fi
    getter getter_name parser.put_function

    # Setter
    f"{struct_name}::set_{member_name}" = setter_name
    std::List[common::Op]::new = setter_ops
    location.clone common::OpValue::UnsafeStart common::Op::new setter_ops.push
    location.clone common::OpValue::PtrFromRef common::Op::new setter_ops.push
    location.clone common::OpValue::Dup common::Op::new setter_ops.push
    prior_members.length struct_name.to_str common::StructMemberAccess
    common::OpValue::StructMemberProject = project_op
    location.clone project_op common::Op::new setter_ops.push
    location.clone common::OpValue::Drop common::Op::new = drop_op
    member_type.clone std::Option::Some drop_op common::Op::set_type_hint
    drop_op setter_ops.push
    prior_members.length struct_name.to_str common::StructMemberAccess
    common::OpValue::StructMemberStore = store_op
    location.clone store_op common::Op::new setter_ops.push
    location.clone common::OpValue::UnsafeEnd common::Op::new setter_ops.push

    std::List[common::Parameter]::new = setter_params
    "".to_str common::EXCLUSIVE_BORROW_TYPE param_type.clone common::apply_borrow_type common::Parameter::named setter_params.push
    "".to_str member_type.clone common::Parameter::named setter_params.push
    std::List[common::Type]::new = setter_returns
    setter_returns setter_params common::StackEffect::new = setter_stack_effect
    effect_type_vars.clone setter_stack_effect common::StackEffect::set_type_vars
    effect_type_vars setter_stack_effect common::canonicalize_stack_effect_type_vars
    setter_stack_effect location.clone setter_ops setter_name.clone
    common::Function::with_stack_effect = setter
    true setter common::Function::set_is_typechecked

    if
        setter_name.as_str parser
            .store
            .get_function
            .is_some
    then
        location f"Function `{setter_name}` is already defined" common::ErrorKind::DuplicateName parser.state.record_error_string
    fi
    setter setter_name parser.put_function
}

# ============================================================================
# parse_struct - parse struct definition
# ============================================================================

pub fn parse_struct parser:mut$Parser cursor:mut$TokenCursor is_extern:bool -> common::CasaStruct {
    cursor.type_bindings.length = inherited_bindings
    if is_extern then
        fallback_token parser.state "extern" cursor expect_token_value.unwrap_or drop
    fi
    fallback_token parser.state "struct" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    # Parse optional type parameters
    std::List[std::String]::new = type_vars
    cursor.peek = tvars_opt
    if tvars_opt std::Option::Some(tvars) is then
        if "[" tvars common::Token::value.as_str == then
            cursor parser parse_type_variables = parsed_type_variables
            parsed_type_variables.into_parts = parsed_const_params = parsed_bounds = type_vars
            parsed_const_params drop
            # Trait bounds are not allowed on struct definitions
            if 0 parsed_bounds.keys.length != then
                name_token common::Token::location "Trait bounds are not allowed on struct definitions. Use `impl[K: Bound] StructName[K]` instead" common::ErrorKind::UnexpectedToken parser.state.record_error
            fi
        fi
    fi

    parser.state cursor parse_derived_traits = derived_traits

    std::List[common::Member]::new = members
    type_vars common::string_list_to_set = struct_type_vars
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or = struct_open_token

    while true do
        fallback_token parser.state cursor expect_token.unwrap_or = member_token
        if "}" member_token common::Token::value.as_str == then
            break
        fi
        false = member_is_public
        if "pub" member_token.value.as_str == then
            true = member_is_public
            fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = member_token
        fi
        if common::TokenKind::Identifier member_token common::Token::kind != then
            member_token common::Token::location "Expected member name" common::ErrorKind::UnexpectedToken parser.state.record_error
        fi
        fallback_token parser.state ":" cursor expect_token_value.unwrap_or drop
        parser.state cursor parse_type_ast = member_type
        struct_type_vars member_type common::canonicalize_type_var = member_type

        type_vars member_token common::Token::location members member_type
        member_token common::Token::value.as_str name_token common::Token::value.as_str cursor.resolve_name.as_str parser
        create_member_accessor
        if member_is_public then
            f"{name_token.value.as_str cursor.resolve_name}::{member_token.value}" = getter_name
            f"{name_token.value.as_str cursor.resolve_name}::set_{member_token.value}" = setter_name
            getter_name.as_str parser
                .store
                .module_private_symbols
                .remove_str
            setter_name.as_str parser
                .store
                .module_private_symbols
                .remove_str
            getter_name parser
                .store
                .public_symbols
                .add
            setter_name parser
                .store
                .public_symbols
                .add
        fi
        member_type member_token common::Token::value.clone common::Member members.push
    done

    is_extern derived_traits type_vars name_token common::Token::location.clone members
    name_token common::Token::value.as_str cursor.resolve_name common::CasaStruct
    inherited_bindings cursor.restore_type_bindings
}

# ============================================================================
# parse_trait - parse trait definition
# ============================================================================

pub fn parse_trait_method_stack_effect
    cursor:mut$TokenCursor
    state:mut$ParseState
-> common::StackEffect {
    std::List[common::Parameter]::new = params

    # Parse parameters, stopping at ->, fn, or }
    while true do
        cursor.peek = peek_opt
        if peek_opt.is_none then
            break
        fi
        peek_opt.unwrap = peek
        if
            "->" peek common::Token::value.as_str ==
            "{" peek common::Token::value.as_str == ||
            "fn" peek common::Token::value.as_str == ||
            "}" peek common::Token::value.as_str == ||
        then
            break
        fi
        cursor.pop drop

        if
            common::TokenKind::Identifier peek common::Token::kind !=
            "fn" peek common::Token::value.as_str != &&
        then
            peek common::Token::location "Unexpected token in trait method parameter list" common::ErrorKind::UnexpectedToken state.record_error
        fi

        state peek cursor parse_parameter_maybe_named params.push
    done

    std::List[common::Type]::new = returns
    cursor.peek = arrow_opt
    if arrow_opt std::Option::Some(arrow) is then
        if "->" arrow common::Token::value.as_str == then
            cursor.pop drop # consume ->
            while true do
                cursor.peek = return_opt
                if return_opt.is_none then
                    break
                fi
                return_opt.unwrap = return_token
                if
                    "fn" return_token common::Token::value.as_str ==
                    "}" return_token common::Token::value.as_str == ||
                    "{" return_token common::Token::value.as_str == ||
                then
                    break
                fi
                state cursor parse_type_ast returns.push
            done
        fi
    fi

    returns params common::StackEffect::new
}
# Parse a bracket-delimited identifier-only type-parameter list:
# `[T1 T2 ...]`. `context` (e.g. "trait", "trait method") is interpolated
# into error messages. Does *not* accept trait bounds; for those use
# `parse_type_variables`.

pub fn parse_simple_type_vars
    cursor:mut$TokenCursor
    context:str
    state:mut$ParseState
-> std::List[std::String] {
    cursor.pop drop # consume [
    std::List[std::String]::new = collected
    true = loop_flag
    while loop_flag do
        cursor.peek = token_opt
        if token_opt.is_none then
            common::empty_location f"Unclosed {context} type parameter list" common::ErrorKind::UnmatchedBlock state.record_error_string
            state.mark_output_unusable
            false = loop_flag
        else
            token_opt.unwrap = token
            if "]" token common::Token::value.as_str == then
                cursor.pop drop
                false = loop_flag
            elif common::TokenKind::Identifier token common::Token::kind != then
                token common::Token::location f"Expected type parameter identifier in {context}" common::ErrorKind::UnexpectedToken state.record_error_string
                false = loop_flag
            else
                cursor.pop drop
                token common::Token::value.clone cursor.type_bindings.push
                token common::Token::value.clone collected.push
            fi
        fi
    done
    collected
}

pub fn parse_trait parser:mut$Parser cursor:mut$TokenCursor -> common::CasaTrait {
    cursor.type_bindings.length = inherited_bindings
    fallback_token parser.state "trait" cursor expect_token_value.unwrap_or drop
    fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = name_token

    std::List[std::String]::new = type_params
    cursor.peek = bracket_opt
    if { common::Token::value.as_str "[" == } bracket_opt.filter.is_some then
        parser.state "trait" cursor parse_simple_type_vars = type_params
    fi

    std::List[common::TraitBound]::new = supertraits
    cursor.peek = colon_opt
    if { common::Token::value.as_str ":" == } colon_opt.filter.is_some then
        cursor.pop drop
        true = parse_super_loop
        while parse_super_loop do
            fallback_token parser.state common::TokenKind::Identifier cursor expect_token_kind.unwrap_or = super_token
            super_token common::Token::value.as_str cursor.resolve_name = super_name
            super_name parser
                .store
                .traits
                .get = super_def_opt
            parser.state super_token cursor parse_bound_type_args = super_args
            if super_def_opt std::Option::Some(super_def) is then
                super_def common::CasaTrait::type_params = super_params: $std::List[std::String]
                if super_args.length super_params.length != then
                    super_token common::Token::location f"Supertrait `{super_name}` expects {super_params.length} type argument(s), got {super_args.length}" common::ErrorKind::Syntax parser.state.record_error_string
                fi
            fi
            super_args super_name common::TraitBound supertraits.push
            cursor.peek = plus_opt
            if { common::Token::value.as_str "+" == } plus_opt.filter.is_some then
                cursor.pop drop
            else
                false = parse_super_loop
            fi
        done
    fi

    std::List[common::TraitMethod]::new = methods
    fallback_token parser.state "{" cursor expect_token_value.unwrap_or drop

    true = parse_trait_loop
    while parse_trait_loop do
        cursor.peek = next_opt
        if next_opt.is_none then
            name_token common::Token::location "Unclosed trait block" common::ErrorKind::UnmatchedBlock parser.state.record_error
            parser.state.mark_output_unusable
            false = parse_trait_loop
        elif next_opt std::Option::Some(next) is then
            if "}" next common::Token::value.as_str == then
                cursor.pop drop
                false = parse_trait_loop
            elif "fn" next common::Token::value.as_str != then
                next common::Token::location "Expected method declaration in trait" common::ErrorKind::UnexpectedToken parser.state.record_error
                false = parse_trait_loop
            else
                cursor.pop drop # consume fn
                parser.state cursor expect_function_name = method_name
                if "drop" method_name common::Token::value.as_str == then
                    method_name common::Token::location "`drop` is reserved for inherent cleanup methods" common::ErrorKind::InvalidScope parser.state.record_error
                fi

                cursor.type_bindings.length = inherited_method_bindings
                # Parse optional method-level type parameters (e.g., fn map[U])
                std::List[std::String]::new = method_type_vars
                if cursor.peek std::Option::Some(mtv_bracket) is then
                    if "[" mtv_bracket common::Token::value.as_str == then
                        parser.state "trait method" cursor parse_simple_type_vars = method_type_vars
                    fi
                fi

                parser.state cursor parse_trait_method_stack_effect = method_stack_effect

                type_params common::string_list_to_set = trait_tv_set
                common::TRAIT_SELF_TYPE trait_tv_set.add_str
                for mtv in method_type_vars.iter do
                    mtv.clone trait_tv_set.add
                done
                trait_tv_set method_stack_effect common::canonicalize_stack_effect_type_vars

                # Parse optional default method body
                std::List[common::Op]::new = default_ops
                if cursor.peek std::Option::Some(body_peek) is then
                    if "{" body_peek common::Token::value.as_str == then
                        f"{name_token common::Token::value.as_str cursor.resolve_name.as_str}::{method_name common::Token::value.as_str}" = default_name
                        default_name.as_str cursor parser parse_block_ops = default_ops
                        trait_tv_set default_ops common::canonicalize_operation_type_vars
                    fi
                fi

                inherited_method_bindings cursor.restore_type_bindings
                method_type_vars false std::List[common::Variable]::new default_ops method_stack_effect method_name common::Token::value.clone common::TraitMethod methods.push
            fi
        else
            false = parse_trait_loop
        fi
    done

    name_token common::Token::location.clone supertraits methods type_params name_token common::Token::value.as_str cursor.resolve_name common::CasaTrait
    inherited_bindings cursor.restore_type_bindings
}

# ============================================================================
# parse_impl_block - parse impl Type { fn methods... }
# ============================================================================

pub fn inject_implementation_parameters
    parser:mut$Parser
    function:mut$common::Function
    type_vars:$std::List[std::String]
    generic_params:$std::List[std::String]
    trait_bounds:$std::Map[std::String std::List[common::TraitBound]]
    constant_parameters:$std::Map[std::String common::BuiltinType]
{
    function.stack_effect.clone = effect
    std::List[std::String]::new = combined_generic_params
    for parameter_name in generic_params.iter do
        parameter_name.clone combined_generic_params.push
    done
    for parameter_name in function.generic_params.iter do
        parameter_name.clone combined_generic_params.push
    done
    combined_generic_params function common::Function::set_generic_params

    # Merge the impl block's constant parameters (ADR-0152) and rewrite the
    # method declaration and body so their names read as constants, not type
    # variables.
    if 0 constant_parameters.keys.length != then
        constant_parameters effect rewrite_stack_effect_constant_parameters
        constant_parameters function.ops rewrite_operation_constant_parameters
        0 = variable_index: u64
        while variable_index function.variables.length > do
            variable_index function.variables.get_mut = variable
            constant_parameters variable.typ rules::rewrite_type_const_params = rewritten_variable_type
            rewritten_variable_type variable common::Variable::set_typ
            1 += variable_index
        done
        for constant_pair in constant_parameters.iter do
            constant_pair.second.clone constant_pair.first.clone effect.const_params.set
        done
    fi

    # Merge type vars into function stack effect
    for type_var in type_vars.iter do
        if type_var effect.type_vars.has ! then
            type_var.clone effect.type_vars.add
        fi
    done
    effect.type_vars.clone = active_impl_type_vars
    active_impl_type_vars effect common::canonicalize_stack_effect_type_vars
    active_impl_type_vars function.ops common::canonicalize_operation_type_vars
    0 = variable_index: u64
    while variable_index function.variables.length > do
        variable_index function
            .variables
            .get
            .clone = variable
        active_impl_type_vars variable.typ common::canonicalize_type_var = variable_type
        variable_type variable common::Variable::set_typ
        variable variable_index function.variables.set
        1 += variable_index
    done

    # Merge trait bounds
    trait_bounds.keys = bound_keys
    for bound_key in bound_keys.iter do
        if bound_key trait_bounds.get std::Option::Some(bounds) is then
            bounds.clone bound_key.clone effect.trait_bounds.set
        fi
    done

    0 = insert_pos: u64
    # Register the implementation's symbolic constant parameters.
    function.location.clone function.variables effect inject_constant_parameters = constant_assignments
    while 0 constant_assignments.length != do
        constant_assignments.pop = assignment
        insert_pos assignment function.ops.insert
    done

    effect function common::Function::set_stack_effect
}

pub fn namespace_trait_impl_type
    typ:$common::Type
    type_vars:$std::List[std::String]
    prefix:str
-> common::Type {
    std::Map[std::String common::Type]::new = substitutions
    for type_variable in type_vars.iter do
        f"{prefix}{type_variable}" common::Type::TypeVar type_variable.clone substitutions.set
    done
    substitutions typ.substitute_t
}

pub fn resolve_overlap_type
    typ:$common::Type
    bindings:$std::Map[std::String common::Type]
-> common::Type {
    if typ common::Type::TypeVar(type_variable) is then
        if type_variable bindings.get std::Option::Some(bound) is then
            bindings bound resolve_overlap_type return
        fi
    fi
    typ.clone
}

pub fn overlap_type_contains
    type_variable:$str
    typ:$common::Type
    bindings:mut$std::Map[std::String common::Type]
-> bool {
    bindings typ resolve_overlap_type = resolved
    if resolved.clone common::Type::TypeVar(name) is then
        type_variable name.as_str == return
    fi
    if resolved common::Type::Generic(generic) is then
        for parameter in generic.params.iter do
            if bindings parameter type_variable overlap_type_contains then
                true return
            fi
        done
    elif resolved common::Type::Function(function_type) is then
        for parameter in function_type.parameters.iter do
            if bindings parameter type_variable overlap_type_contains then
                true return
            fi
        done
        for return_type in function_type.return_types.iter do
            if bindings return_type type_variable overlap_type_contains then
                true return
            fi
        done
    fi
    false
}

pub fn bind_overlap_type
    type_variable:$str
    typ:$common::Type
    bindings:mut$std::Map[std::String common::Type]
-> bool {
    bindings typ resolve_overlap_type = resolved
    if resolved.clone common::Type::TypeVar(name) is then
        if type_variable name.as_str == then
            true return
        fi
    fi
    if bindings resolved type_variable overlap_type_contains then
        false return
    fi
    resolved type_variable.clone bindings.set_str
    true
}

pub fn unify_trait_impl_types
    first:$common::Type
    second:common::Type
    bindings:mut$std::Map[std::String common::Type]
-> bool {
    bindings first resolve_overlap_type = resolved_first
    bindings second resolve_overlap_type = resolved_second
    if resolved_first common::Type::TypeVar(first_variable) is then
        bindings resolved_second first_variable.as_str bind_overlap_type return
    fi
    if resolved_second common::Type::TypeVar(second_variable) is then
        bindings resolved_first second_variable.as_str bind_overlap_type return
    fi
    if resolved_first common::Type::Generic(first_generic) is then
        if resolved_second common::Type::Generic(second_generic) is then
            if first_generic.base second_generic.base != then
                false return
            fi
            if first_generic.params.length second_generic.params.length != then
                false return
            fi
            for
                pair in second_generic.params.iter first_generic
                    .params
                    .iter
                    .zip
            do
                if bindings pair.first.clone pair.second.clone unify_trait_impl_types ! then
                    false return
                fi
            done
            true return
        fi
        false return
    fi
    if resolved_first common::Type::Function(first_function) is then
        if resolved_second common::Type::Function(second_function) is then
            if first_function.parameters.length second_function.parameters.length != then
                false return
            fi
            if first_function.return_types.length second_function.return_types.length != then
                false return
            fi
            for
                pair in second_function.parameters.iter first_function
                    .parameters
                    .iter
                    .zip
            do
                if bindings pair.first.clone pair.second.clone unify_trait_impl_types ! then
                    false return
                fi
            done
            for
                pair in second_function.return_types.iter first_function
                    .return_types
                    .iter
                    .zip
            do
                if bindings pair.first.clone pair.second.clone unify_trait_impl_types ! then
                    false return
                fi
            done
            true return
        fi
        false return
    fi
    resolved_first resolved_second.eq
}

pub fn trait_impls_overlap first:$common::TraitImpl second:$common::TraitImpl -> bool {
    if first.trait_bound.name second.trait_bound.name != then
        false return
    fi
    if
        first
            .trait_bound
            .type_args
            .length second
            .trait_bound
            .type_args
            .length !=
    then
        false return
    fi
    "left:" first.type_vars first.receiver namespace_trait_impl_type = first_receiver
    "right:" second.type_vars second.receiver namespace_trait_impl_type = second_receiver
    std::Map[std::String common::Type]::new = bindings
    if bindings second_receiver first_receiver unify_trait_impl_types ! then
        false return
    fi
    for
        pair in second
            .trait_bound
            .type_args
            .iter first
            .trait_bound
            .type_args
            .iter
            .zip
    do
        "left:" first.type_vars pair.second namespace_trait_impl_type = first_argument
        "right:" second.type_vars pair.first namespace_trait_impl_type = second_argument
        if bindings second_argument first_argument unify_trait_impl_types ! then
            false return
        fi
    done
    true
}

pub fn receiver_is_local
    receiver:$common::Type
    location:$common::Location
    store:mut$common::SymbolStore
-> bool {
    receiver.match_base = receiver_name
    if receiver_name store.structs.get std::Option::Some(casa_struct) is then
        casa_struct.location.file location.file == return
    fi
    if receiver_name store.enums.get std::Option::Some(casa_enum) is then
        casa_enum.location.file location.file == return
    fi
    false
}

pub fn register_trait_impl parser:mut$Parser trait_impl:common::TraitImpl {
    for
        existing in trait_impl
            .trait_bound
            .name
            .as_str trait_impl.receiver parser
            .store
            .get_trait_impl_candidates_for_receiver_and_trait
    do
        if trait_impl existing trait_impls_overlap then
            trait_impl.location f"Trait implementation `{trait_impl common::trait_impl_key}` overlaps an existing implementation in `{existing.location.file}`" common::ErrorKind::DuplicateName parser.state.record_error_string
            return
        fi
    done
    trait_impl parser.put_trait_impl
}

pub fn normalize_trait_method_effect candidate:$rules::TraitMethodCandidate -> common::StackEffect {
    std::Map[std::String common::Type]::new = substitutions
    0 = index: u64
    for
        type_variable in candidate
            .method
            .type_vars
            .iter
    do
        f"method_type_{index}" common::Type::TypeVar type_variable.clone substitutions.set
        1 += index
    done
    substitutions candidate.effect common::apply_type_subs_to_stack_effect
}

pub fn validate_trait_method_compatibility parser:mut$Parser casa_trait:$common::CasaTrait -> bool {
    casa_trait rules::trait_definition_type = trait_type
    trait_type parser.store rules::collect_trait_method_candidates = candidates
    0 = first_index: u64
    while first_index candidates.length > do
        first_index candidates.get = first
        first normalize_trait_method_effect = first_effect
        first_index 1 + = second_index
        while second_index candidates.length > do
            second_index candidates.get = second
            if first.method.name second.method.name == then
                second normalize_trait_method_effect = second_effect
                if first_effect second_effect stack_effect_shapes_equal ! then
                    casa_trait.location f"Trait `{casa_trait.name}` inherits incompatible `{first.method.name}` methods from `{first.trait_type.format}` and `{second.trait_type.format}`" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                    false return
                fi
            fi
            1 += second_index
        done
        1 += first_index
    done
