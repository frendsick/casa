    done

    # Constant parameters stay in scope inside a closure. A call in the body
    # may forward one, and the typechecker adds that read after captures are
    # gathered, so capture them up front (ADR-0152).
    for
        constant_name in function
            .stack_effect
            .const_params
            .keys
            .iter
    do
        if constant_name.as_str lambda_function.captures common::variable_list_contains then
            continue
        fi
        constant_name.as_str function.variables common::variable_list_index = constant_variable_index
        if 0 constant_variable_index >= then
            constant_variable_index u64::try_from.unwrap function
                .variables
                .get
                .clone lambda_function.captures.push
        fi
    done
}
# Root closures may capture root locals. Other functions must receive root-owned
# state through explicit parameters.
fn reject_root_local_capture
    name:$str
    function:$common::Function
    store:$common::SymbolStore
    location:$common::Location
