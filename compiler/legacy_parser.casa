pub fn language_trait_method_role method_kind:i64 -> str {
    if 1 method_kind == then
        "operator method" return
    fi
    if 2 method_kind == then
        "hashing method" return
    fi
    if 3 method_kind == then
        "formatting method" return
    fi
    if 5 method_kind == then
        "cloning method" return
    fi
    if 6 method_kind == 7 method_kind == || then
        "comparison method" return
    fi
    "trait method"
}

pub fn validate_language_trait_contract parser:mut$Parser casa_trait:$common::CasaTrait -> bool {
    casa_trait.name.clone = trait_name
    if
        common::STD_PARTIAL_EQ_TRAIT trait_name.as_str !=
        common::STD_EQ_TRAIT trait_name.as_str != &&
        common::STD_PARTIAL_ORD_TRAIT trait_name.as_str != &&
        common::STD_ORD_TRAIT trait_name.as_str != &&
        common::STD_HASHABLE_TRAIT trait_name.as_str != &&
        common::STD_DISPLAY_TRAIT trait_name.as_str != &&
        common::STD_ITERABLE_TRAIT trait_name.as_str != &&
        common::STD_COPY_TRAIT trait_name.as_str != &&
        common::STD_CLONE_TRAIT trait_name.as_str != &&
    then
        true return
    fi
    if common::STD_ITERABLE_TRAIT trait_name.as_str == then
        if 1 casa_trait.type_params.length != then
            casa_trait.location "Language trait `Iterable` expects one type parameter" common::ErrorKind::TraitSignatureMismatch parser.state.record_error
            false return
        fi
    elif 0 casa_trait.type_params.length != then
        casa_trait.location f"Language trait `{trait_name}` expects no type parameters" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
        false return
    fi
    if common::STD_COPY_TRAIT trait_name.as_str == then
        if 0 casa_trait.methods.length == then
            true return
        fi
        casa_trait.location "Language trait `Copy` must not declare methods" common::ErrorKind::TraitSignatureMismatch parser.state.record_error
        false return
    fi
    casa_trait rules::trait_definition_type = trait_type
    trait_type parser.store rules::collect_trait_method_candidates = candidates
    std::List[std::String]::new = required
    if
        common::STD_PARTIAL_EQ_TRAIT trait_name.as_str ==
        common::STD_EQ_TRAIT trait_name.as_str == ||
    then
        "eq".to_str required.push "ne".to_str required.push
    elif
        common::STD_PARTIAL_ORD_TRAIT trait_name.as_str ==
        common::STD_ORD_TRAIT trait_name.as_str == ||
    then
        "eq".to_str required.push "ne".to_str required.push
        "partial_cmp".to_str required.push
        "lt".to_str required.push "le".to_str required.push
        "gt".to_str required.push "ge".to_str required.push
        if common::STD_ORD_TRAIT trait_name.as_str == then
            "cmp".to_str required.push
        fi
    elif common::STD_HASHABLE_TRAIT trait_name.as_str == then
        "hash".to_str required.push
    elif common::STD_DISPLAY_TRAIT trait_name.as_str == then
        "to_str".to_str required.push
    elif common::STD_ITERABLE_TRAIT trait_name.as_str == then
        "next".to_str required.push
    else
        "clone".to_str required.push
    fi
    true = valid
    for required_name in required.iter do
        false = found
        for candidate in candidates.iter do
            if required_name candidate.method.name != then
                continue
            fi
            true = found
            required_name.as_str trait_name.as_str language_trait_method_kind = method_kind
            method_kind language_trait_method_role = method_role
            if casa_trait method_kind candidate language_trait_method_matches ! then
                casa_trait.location f"Language trait `{trait_name}` has incompatible `{required_name}` {method_role}" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                false = valid
            fi
        done
        if found ! then
            required_name.as_str trait_name.as_str language_trait_method_kind language_trait_method_role = method_role
            casa_trait.location f"Language trait `{trait_name}` is missing required `{required_name}` {method_role}" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
            false = valid
        fi
    done
    for candidate in candidates.iter do
        if
            0 candidate
                .method
                .default_ops
                .length !=
        then
            continue
        fi
        if candidate.trait_type trait_type.eq ! then
            continue
        fi
        candidate
            .method
            .name
            .as_str trait_name.as_str language_trait_method_kind = method_kind
        if 0 method_kind == then
            casa_trait.location f"Language trait `{trait_name}` cannot add bodyless `{candidate.method.name}` requirement" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
            false = valid
        fi
    done
    valid
}

pub fn validate_trait_visit
    parser:mut$Parser
    trait_name:$str
    path:mut$std::List[std::String]
    visiting:mut$std::Set[std::String]
    checked:mut$std::Set[std::String]
    valid:mut$std::List[bool]
{
    if trait_name checked.has_str then
        return
    fi
    if trait_name visiting.has_str then
        trait_name path common::string_list_index = cycle_start
        std::List[std::String]::new = cycle
        cycle_start u64::try_from.unwrap path.iter.skip = cycle_items
        for item in cycle_items do
            item.clone cycle.push
        done
        trait_name.clone cycle.push_str
        " -> " cycle.join_strings = cycle_path
        trait_name parser
            .store
            .traits
            .get_str
            .unwrap
            .location
        f"Trait inheritance cycle: {cycle_path}"
        common::ErrorKind::TraitSignatureMismatch
        parser.state.record_error_string
        false 0 valid.set
        return
    fi
    if
        trait_name parser
            .store
            .traits
            .has_str !
    then
        return
    fi
    trait_name.clone visiting.add_str
    trait_name.clone path.push_str
    trait_name parser
        .store
        .traits
        .get_str
        .unwrap
        .clone = casa_trait
    casa_trait.location.clone = trait_location
    casa_trait.supertraits.clone = supertraits
    for supertrait in supertraits.iter do
        supertrait.name.as_str parser.store.count_trait_type_parameters = parameter_count_opt
        if parameter_count_opt.is_none then
            trait_location f"Supertrait `{supertrait.name}` is not defined" common::ErrorKind::UndefinedName parser.state.record_error_string
            false 0 valid.set
            continue
        fi
        parameter_count_opt.unwrap = parameter_count
        if supertrait.type_args.length parameter_count != then
            trait_location f"Supertrait `{supertrait.name}` expects {parameter_count} type argument(s), got {supertrait.type_args.length}" common::ErrorKind::Syntax parser.state.record_error_string
            false 0 valid.set
            continue
        fi
        valid checked visiting path supertrait.name.as_str parser validate_trait_visit
    done
    path.pop drop
    trait_name visiting.remove_str
    trait_name.clone checked.add_str
}

