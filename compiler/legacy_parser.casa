    receiver.match_base = receiver_name
    if
        receiver_name parser
            .store
            .structs
            .get std::Option::Some(casa_struct) is
    then
        ops location casa_struct append_struct_derived_eq_body
    elif
        receiver_name parser
            .store
            .enums
            .get std::Option::Some(casa_enum) is
    then
        ops location casa_enum append_enum_derived_eq_body
    fi
    std::List[std::String]::new = parameter_names
    "self".to_str parameter_names.push
    "other".to_str parameter_names.push
    required_type_vars type_vars common::STD_EQ_TRAIT make_derived_trait_bounds = bounds
    location
    "eq" receiver make_derived_function_name.as_str
    ops
    common::make_bool_type
    parameter_names
    bounds
    type_vars
    receiver
    make_derived_borrow_method
}

