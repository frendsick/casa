# Resolve a bare identifier after `&`-ref, enum-variant, and trait-method
# attempts have already failed. Rewrites `op` in place to the matching op
# kind or pushes an `UndefinedName` error.

pub fn resolve_plain_identifier
    store:mut$common::SymbolStore
    function:mut$common::Function
    op:mut$common::Op
    ident:$str
    allow_root_local_capture:bool
    resolve_errors:mut$std::List[error::CasaError]
{
    ident "::" str::split = identifier_parts
    if
        2 identifier_parts.length == "drop" identifier_parts.length 1 - identifier_parts.get.as_str == &&
    then
        op common::Op::location.clone "Reserved `drop` methods cannot be called directly; use the `drop` intrinsic".to_str common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
        return
    fi
    if ident function common::Function::variables common::variable_list_contains then
        ident.to_str common::OpValue::PushVar op common::Op::set_value
        return
    fi

    if ident store.has_function then
        ident.to_str common::OpValue::FnCall op common::Op::set_value
        return
    fi

    if ident function common::Function::captures common::variable_list_contains then
        ident.to_str common::OpValue::PushCapture op common::Op::set_value
        return
    fi

    if
        resolve_errors allow_root_local_capture op.location store function ident
        reject_root_local_capture
    then
        return
    fi

    if
        ident store
            .variables
            .get_str
            .is_some
    then
        ident.to_str common::OpValue::PushVar op common::Op::set_value
        return
    fi

    ident store.constants.get_str = const_opt
    if const_opt std::Option::Some(casa_const) is then
        if casa_const.typ std::Option::Some(builtin) is then
            builtin common::Type::Builtin std::Option::Some = op.type_hint
        fi
        casa_const common::Constant::value.clone = const_value
        const_value match
            common::ConstantValue::Int(const_int) => {
                const_int common::OpValue::PushInt op common::Op::set_value
            }
            common::ConstantValue::Float(const_float) => {
                const_float common::OpValue::PushFloat op common::Op::set_value
            }
            common::ConstantValue::Str(const_str) => {
                const_str common::OpValue::PushStr op common::Op::set_value
            }
            common::ConstantValue::Bool(const_bool) => {
                const_bool common::OpValue::PushBool op common::Op::set_value
            }
            common::ConstantValue::Char(const_char) => {
                const_char common::OpValue::PushChar op common::Op::set_value
            }
        end
        return
    fi

    ident store.structs.get_str = struct_opt
    if struct_opt std::Option::Some(casa_struct) is then
        for member in casa_struct.members.iter do
            f"{casa_struct.name}::{member.name}" = accessor_name
            if
                op
                    .location
                    .file
                    .as_str accessor_name.as_str store.is_private_from
            then
                op.location.clone
                "Cannot construct a struct with private fields outside its module".to_str
                common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                common::OpValue::Rejected op common::Op::set_value
                return
            fi
        done
        casa_struct.clone common::OpValue::StructNew op common::Op::set_value
        return
    fi

    ident store.enums.get_str = resolved_enum_opt
    if resolved_enum_opt std::Option::Some(resolved_enum) is then
        resolved_enum common::CasaEnum::variants.length i64::try_from.unwrap
        common::make_integer_op_value op common::Op::set_value
        return
    fi

    if op.value common::OpValue::Identifier(written) is then
        f"Identifier `{written}` is not defined"
    else
        f"Identifier `{ident}` is not defined"
    fi = message
    if ident store.failed_constants.has_str then
        f"Constant `{ident}` is unavailable because its declaration failed" = message
    fi
    op.location.clone message common::ErrorKind::UndefinedName error::CasaError::new resolve_errors.push
}

