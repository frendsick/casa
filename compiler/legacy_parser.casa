        common::STD_ORDERING_TYPE.to_str common::GenericType::new common::Type::Generic = ordering_type
        if 7 method_kind == then
            0 effect.return_types.get ordering_type.eq return
        fi
        std::List[common::Type]::new = option_args
        ordering_type option_args.push
        option_args common::STD_OPTION_TYPE.to_str common::GenericType common::Type::Generic = expected
        0 effect.return_types.get expected.eq return
    fi
    if 1 effect.parameters.length != then
        false return
    fi
    0 effect
        .parameters
        .get
        .typ
        .clone = receiver_type
    if receiver_type.borrow_target std::Option::Some(target) is then
        target.clone = receiver_type
    fi
    if receiver_type.is_self_type ! then
