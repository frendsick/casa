            if ident.as_str current_op store try_resolve_qualified_trait_method then
                current_op op_index 1 - ops.set
                continue
            fi
            if ident.as_str current_op store try_resolve_type_qualified_method then
                current_op op_index 1 - ops.set
                continue
            fi
            if
                current_op
                    .location
                    .file
                    .as_str ident.as_str store.is_private_from
            then
                current_op.location.clone f"Declaration `{ident}` is private"
                common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                current_op op_index 1 - ops.set
                continue
            fi
            resolve_errors allow_root_local_capture ident.as_str current_op function store resolve_plain_identifier
            current_op op_index 1 - ops.set
