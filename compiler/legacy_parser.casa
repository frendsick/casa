impl Parser {
    pub fn analyze_import
        self:mut$Parser
        import_path:$str
        module_prefix:$str
    -> std::Result[bool os::IoError] {
        self
            .state
            .diagnostics
            .error_count = errors_before
        self.state.constant_errors = constant_errors_before
        self.sources import_path.clone lexer::lex_file = import_result
        error::Diagnostics::new = diagnostics
        std::List[common::Token]::new = tokens
        import_result match
            std::Result::Ok(lex_result) => lex_result.into_parts = diagnostics = tokens
            std::Result::Error(error) => error std::Result::Error return
        end
        diagnostics self
            .state
            .diagnostics
            .merge
        if
            errors_before self
                .state
                .diagnostics
                .error_count >
        then
            false std::Result::Ok
            return
        fi
        self.store.declaration_names = existing_declarations
        self
            .store
            .variables
            .keys common::string_list_to_set = existing_variables
        self.store.get_function_names common::string_list_to_set = existing_functions
        self
            .store
            .traits
            .keys common::string_list_to_set = existing_traits
        ModuleContext::new self.module_contexts.push
        import_path.to_str self.import_stack.push
        module_prefix tokens self.prepare_module
        tokens self parse_ops = imported_ops
        if
            self.state.has_usable_output ! constant_errors_before errors_before self.state.has_nonconstant_errors_since ||
        then
            self.import_stack.pop drop
            self.module_contexts.pop drop
            false std::Result::Ok
            return
        fi
        existing_traits existing_functions imported_ops self.resolve_current_ops = resolved_ops_opt
        # Imported root locals have no scope in the importing module.
        self
            .store
            .variables
            .keys = root_names
        for name in root_names.iter do
            if name.as_str existing_variables.has_str ! then
                name.as_str self
                    .store
                    .variables
                    .remove_str drop
            fi
        done
        self.store.declaration_names = resolved_declarations
        for name in resolved_declarations.iter do
            if name.as_str existing_declarations.has_str ! then
                name.clone self
                    .current_module_mut
                    .declared_names
                    .add
            fi
        done
        self.import_stack.pop drop
        self.module_contexts.pop = module_context
        if
            resolved_ops_opt.is_none constant_errors_before errors_before self.state.has_nonconstant_errors_since ||
        then
            false std::Result::Ok
            return
        fi
        resolved_ops_opt.unwrap = resolved_ops
        for name in module_context.declared_names.iter do
            if
                name.as_str self
                    .store
                    .module_private_symbols
                    .has_str
            then
                name.as_str self
                    .store
                    .module_private_symbols
                    .remove_str
                name.clone self
                    .store
                    .private_symbols
                    .add
            fi
        done
        false ImportedModule
        = imported_module
        imported_module import_path.to_str self.module_cache.set
        true std::Result::Ok
    }
}

pub fn resolve_identifiers_global
    parser:mut$Parser
    ops:std::List[common::Op]
    skip_functions:$std::Set[std::String]
-> std::List[common::Op] {
    ops = expanded_ops
    if parser.state.has_usable_output ! then
        std::List[common::Op]::new return
    fi
    std::Set[std::String]::new = no_type_vars
    no_type_vars expanded_ops common::canonicalize_operation_type_vars
    if parser validate_traits ! then
        std::List[common::Op]::new return
    fi
    parser validate_inhabited_aggregates
    parser derive_traits_for_aggregates
    parser register_builtin_copy_impls
    parser validate_drop_methods
    skip_functions parser finalize_trait_impl_methods
    parser synthesize_copy_clone_fallbacks
    parser validate_trait_impls
    if parser.state.has_usable_output ! then
        std::List[common::Op]::new return
    fi
    common::empty_location std::List[common::Op]::new common::GLOBAL_SCOPE_LABEL.to_str common::Function::new = dummy
    parser.state.diagnostics true dummy expanded_ops parser.store resolve_identifiers
    expanded_ops
}

pub fn resolve_identifiers
    store:mut$common::SymbolStore
