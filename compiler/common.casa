    value match
        "pub" => KeywordKind::Pub std::Option::Some
        "as" => KeywordKind::As std::Option::Some
        "unsafe" => KeywordKind::Unsafe std::Option::Some
        "extern" => KeywordKind::Extern std::Option::Some
        "fn" => KeywordKind::Fn std::Option::Some
        "impl" => KeywordKind::Impl std::Option::Some
        "return" => KeywordKind::Return std::Option::Some
        "while" => KeywordKind::While std::Option::Some
        "do" => KeywordKind::Do std::Option::Some
        "break" => KeywordKind::Break std::Option::Some
        "continue" => KeywordKind::Continue std::Option::Some
        "done" => KeywordKind::Done std::Option::Some
        "if" => KeywordKind::If std::Option::Some
        "then" => KeywordKind::Then std::Option::Some
        "elif" => KeywordKind::Elif std::Option::Some
        "else" => KeywordKind::Else std::Option::Some
        "fi" => KeywordKind::Fi std::Option::Some
        "enum" => KeywordKind::EnumKw std::Option::Some
        "struct" => KeywordKind::StructKw std::Option::Some
        "trait" => KeywordKind::TraitKw std::Option::Some
        "end" => KeywordKind::End std::Option::Some
        "match" => KeywordKind::Match std::Option::Some
        "is" => KeywordKind::Is std::Option::Some
        "import" => KeywordKind::Import std::Option::Some
        "for" => KeywordKind::For std::Option::Some
        "in" => KeywordKind::In std::Option::Some
        "global" => KeywordKind::Global std::Option::Some
        "const" => KeywordKind::Const std::Option::Some
        "move" => KeywordKind::Move std::Option::Some
        _ => std::Option[KeywordKind]::None
    end
}

