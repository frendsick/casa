    pub fn format self:$Type -> std::String {
        self match
            Type::Unknown => {
                "".to_str
            }
            Type::Builtin(builtin) => {
                builtin.format.to_str
            }
            Type::TypeVar(name) => {
                name.clone
            }
            Type::Const(const_type) => {
                if const_type.is_symbolic then
                    const_type.name.clone
                elif const_type.typ BuiltinType::Bool == then
                    if 0 const_type.value != then
                        "true".to_str
                    else
                        "false".to_str
                    fi
                else
                    if const_type.typ BuiltinType::U64 == 0 const_type.value < && then
                        const_type.value u64::wrapping_from.to_str
                    else
                        const_type.value.to_str
                    fi
                fi
            }
            Type::Generic(generic) => {
                if generic.base.as_str SHARED_BORROW_TYPE == 1 generic.params.length == && then
                    f"${0 generic
                        .params
                        .get
                        .format}" return
                fi
                if generic.base.as_str EXCLUSIVE_BORROW_TYPE == 1 generic.params.length == && then
                    f"mut${0 generic
                        .params
                        .get
                        .format}" return
                fi
                if 0 generic.params.length == then
                    generic.base.clone return
                fi
                std::List[std::String]::new = param_strs
                for elem in generic.params.iter do
                    elem.format param_strs.push
                done
                " " param_strs.join_strings = params_str
                f"{generic.base}[{params_str}]"
            }
            Type::Function(fn_type) => {
                if 0 fn_type.parameters.length == 0 fn_type.return_types.length == && then
                    "fn".to_str return
                fi
                std::String::new = builder
                "fn[" builder.append
                if 0 fn_type.parameters.length != then
                    std::List[std::String]::new = fn_param_strs
                    for elem in fn_type.parameters.iter do
                        elem.format fn_param_strs.push
                    done
                    " " fn_param_strs.join_strings builder.append_string
                fi
                if 0 fn_type.return_types.length != then
                    if 0 fn_type.parameters.length != then
                        " " builder.append
                    fi
                    "->" builder.append
                    for return_type in fn_type.return_types.iter do
                        " " builder.append
                        return_type.format builder.append_string
                    done
                fi
                "]" builder.append
                builder
            }
        end
    }

    pub fn base self:$Type -> std::Option[std::String] {
        if self Type::Generic(generic) is then
