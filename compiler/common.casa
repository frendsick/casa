# ============================================================================
# List helpers for variables
# ============================================================================

fn variable_list_index vars:$List[Variable] name:$str -> i64 {
    0 (u64) = index
    while index vars.length > do
        if name index vars.get Variable::name == then
            index (i64) return
        fi
        1 += index
    done
    -1
}

fn variable_list_contains vars:$List[Variable] name:$str -> bool {
    0 name vars variable_list_index >=
}

fn string_list_index items:$List[str] value:$str -> i64 {
    0 (u64) = index
    while index items.length > do
        if value index items.get == then
            index (i64) return
        fi
        1 += index
    done
    -1
}

fn string_list_contains items:$List[str] value:$str -> bool {
    0 value items string_list_index >=
}

# ============================================================================
# SymbolStore
#
# Shared declaration state threaded through the parser/typechecker/bytecode
# pipeline. Each phase holds a `store: SymbolStore` field on
# its owning struct (Parser, TypeChecker, BytecodeCompiler) and reaches
# declarations via dot syntax, e.g. `typechecker.store.functions .get`.
#
# Maps and sets are heap-backed in casa, so passing SymbolStore by value
# copies the struct but not the underlying map data — all holders observe
# the same mutations.
# ============================================================================

struct SymbolStore {
    functions:     Map[str Function]
    variables:     Map[str Variable]
    constants:     Map[str Constant]
    enums:         Map[str CasaEnum]
    structs:       Map[str CasaStruct]
    traits:        Map[str CasaTrait]
    trait_impls:   Map[str TraitImpl]
    builtins:      Set[str]
    copy_types:    Map[str bool]
    borrow_shapes: Map[str bool]
    op_ownership:  Map[Op OpOwnership]
}

fn symbol_store_new -> SymbolStore {
    Set[str]::new = builtins
    "i8" builtins.add = builtins
    "i16" builtins.add = builtins
    "i32" builtins.add = builtins
    "i64" builtins.add = builtins
    "u8" builtins.add = builtins
    "u16" builtins.add = builtins
    "u32" builtins.add = builtins
    "u64" builtins.add = builtins
    "f32" builtins.add = builtins
    "f64" builtins.add = builtins
    "bool" builtins.add = builtins
    "str" builtins.add = builtins
    "char" builtins.add = builtins
    "cstr" builtins.add = builtins
    "ptr" builtins.add = builtins
    "array" builtins.add = builtins

    Map[Op OpOwnership]::new
    Map[str bool]::new
    Map[str bool]::new
    builtins
    Map[str TraitImpl]::new
    Map[str CasaTrait]::new
    Map[str CasaStruct]::new
    Map[str CasaEnum]::new
    Map[str Constant]::new
    Map[str Variable]::new
    Map[str Function]::new
    SymbolStore
}

fn aggregate_type_bindings typ:$Type type_vars:$List[str] -> Map[str Type] {
    Map[str Type]::new = bindings
    if typ.type_params Option::Some(type_params) is then
        for pair in type_params.iter type_vars.iter.zip do
            pair.second clone_type pair.first.clone bindings.set = bindings
        done
    fi
    bindings
}

fn type_needs_destruction typ:mut$Type store:mut$SymbolStore visiting:mut$Set[str] -> bool {
    if typ.is_borrow then false return fi
    if f"{typ.match_base}::drop" store.functions.has then true return fi
    typ clone_type = inspected_type
    if inspected_type Type::Generic(generic) is then
        typ.format = type_name
        if type_name visiting.has then false return fi
        type_name.clone visiting.add drop
        if "array" generic.base == then
            if 0 generic.params.length != then
                visiting store 0 generic.params.get type_needs_destruction = needed
                type_name visiting.remove drop
                needed return
            fi
        elif generic.base store.structs.get Option::Some(casa_struct) is then
            casa_struct.type_vars typ aggregate_type_bindings = substitutions
            for member in casa_struct.members.iter do
                substitutions member.typ.substitute_t = member_type
                if visiting store member_type type_needs_destruction then
                    type_name visiting.remove drop
                    true return
                fi
            done
        elif generic.base store.enums.get Option::Some(casa_enum) is then
            casa_enum.type_vars typ aggregate_type_bindings = substitutions
            for payload_types in casa_enum.variant_types.values.iter do
                for payload_type in payload_types.iter do
                    substitutions payload_type.substitute_t = resolved_payload
                    if visiting store resolved_payload type_needs_destruction then
                        type_name visiting.remove drop
                        true return
                    fi
                done
            done
        fi
        type_name visiting.remove drop
    fi
    false
}

fn type_needs_destruction_in_store typ:mut$Type store:mut$SymbolStore -> bool {
    Set[str]::new = visiting
    visiting store typ type_needs_destruction
}
