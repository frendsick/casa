# ============================================================================
# Core data structures
# ============================================================================

struct Span derives Copy {
    offset: u64
    length: u64
}

struct SourcePosition derives Copy {
    line:   u64
    column: u64
}

impl SourcePosition {
    fn new line:u64 column:u64 -> SourcePosition {
        column line SourcePosition
    }
}

struct Location {
    file: str
    span: Span
}

impl Location {
    fn new file:str offset:u64 length:u64 -> Location {
        length offset Span file Location
    }
}

impl Location: Clone {
    fn clone self:$Location -> Location {
        self.span.length self.span.offset self.file.clone Location::new
    }
}

fn empty_location -> Location {
    0 0 Span "" Location
}

struct Token {
    value:    str
    kind:     TokenKind
    location: Location
}

impl Token {
    fn new value:str kind:TokenKind location:Location -> Token {
        location kind value Token
    }
}

# ============================================================================
# Op value types
#
# Op stores its opcode and any associated data in `value`. Opcodes such as
# Add, Drop, and IfStart have no data. Other opcodes carry typed data that call
# sites unpack with `is` or `match`.
# ============================================================================

struct Op {
    location:             Location
    type_hint:            Option[Type]
    deferred_return_hint: Option[Type]
    value:                OpValue
}

struct OwnerEvent {
    name:       str
    typ:        Type
    generation: u64
}

impl OwnerEvent {
    fn new name:mut$str typ:mut$Type generation:u64 -> OwnerEvent {
        generation typ name OwnerEvent
    }

    fn clone self:mut$OwnerEvent -> OwnerEvent {
        self.generation self.typ clone_type self.name.clone OwnerEvent
    }
}

struct OpOwnership {
    assignments: List[OwnerEvent]
    cleanups:    List[OwnerEvent]
    moves_owner: bool
}

impl OpOwnership {
    fn new -> OpOwnership {
        false List[OwnerEvent]::new List[OwnerEvent]::new OpOwnership
    }
}

struct QualifiedMethod {
    type_qualified: bool
    qualifier_type: Type
    method_name:    str
}

# Op identity is its heap address: two Op values compare equal iff the same
# allocation. Required so labels map by Op identity (Map[Op u64]), not by an
# i64 reinterpretation of an Op pointer at every read site.

impl Op: Hashable {
    fn new value:OpValue location:Location -> Op {
        value Option[Type]::None Option[Type]::None location Op
    }

    fn hash self:$Op -> i64 { self (i64) int_hash }
    fn eq self:$Op other:$Op -> bool { self (i64) other (i64) == }
}

fn ensure_op_ownership store:mut$SymbolStore op:mut$Op -> OpOwnership {
    if op store.op_ownership.get Option::Some(ownership) is then ownership return fi
    OpOwnership::new = ownership
    ownership op store.op_ownership.set drop
    op store.op_ownership.get.unwrap
}

fn add_owner_assignment store:mut$SymbolStore op:mut$Op event:OwnerEvent {
    op store ensure_op_ownership = ownership
    event ownership.assignments.push
}

fn add_owner_cleanup store:mut$SymbolStore op:mut$Op event:OwnerEvent {
    op store ensure_op_ownership = ownership
    event ownership.cleanups.push
}

fn set_moves_owner store:mut$SymbolStore op:mut$Op {
    op store ensure_op_ownership = ownership
    true = ownership.moves_owner
}

fn clone_ops ops:$List[Op] -> List[Op] {
    List[Op]::new = result
    for source_op in ops.iter do
        source_op.value source_op.deferred_return_hint source_op.type_hint source_op.location Op = cloned_op
        source_op.value match
            OpValue::PushArray(items) => { items clone_ops OpValue::PushArray = cloned_op.value }
            OpValue::ExprGroup(items) => { items clone_ops OpValue::ExprGroup = cloned_op.value }
            OpValue::PushEnumVariant(variant) => { variant.clone OpValue::PushEnumVariant = cloned_op.value }
            OpValue::IsCheck(variant) => { variant.clone OpValue::IsCheck = cloned_op.value }
            OpValue::MatchArm(arm) => { arm.clone OpValue::MatchArm = cloned_op.value }
            _ => { }
        end
        cloned_op result.push
    done
    result
}

fn substitute_ops_types ops:mut$List[Op] subs:mut$Map[str Type] {
    for sub_op in ops.iter do
        if sub_op.value OpValue::TypeCast(cast_type) is then
            subs cast_type.substitute_t OpValue::TypeCast sub_op Op::set_value
        fi
        if sub_op.value OpValue::NumericTry(numeric_try) is then
            numeric_try.target subs numeric_try.source.substitute_t NumericTry
            OpValue::NumericTry sub_op Op::set_value
        fi
        if sub_op Op::type_hint Option::Some(hint) is then
            subs hint.substitute_t Option::Some sub_op Op::set_type_hint
        fi
        if sub_op Op::deferred_return_hint Option::Some(deferred_hint) is then
            subs deferred_hint.substitute_t Option::Some sub_op Op::set_deferred_return_hint
        fi
    done
}

# ============================================================================
# Stack effect types
# ============================================================================

struct Parameter {
    typ:  Type
    name: str
}

impl Parameter {
    fn new typ:mut$Type -> Parameter {
        "" typ Parameter
    }

    fn named typ:mut$Type name:mut$str -> Parameter {
        name typ Parameter
    }
}

struct StackEffect {
    parameters:   List[Parameter]
    return_types: List[Type]
    type_vars:    Set[str]
    trait_bounds: Map[str List[TraitBound]]
    const_params: Map[str BuiltinType]
}

fn empty_stack_effect -> StackEffect {
    Map[str BuiltinType]::new
    Map[str List[TraitBound]]::new
    Set[str]::new
    List[Type]::new
    List[Parameter]::new
    StackEffect
}

impl StackEffect {
    fn new params:List[Parameter] returns:List[Type] -> StackEffect {
        Map[str BuiltinType]::new
        Map[str List[TraitBound]]::new
        Set[str]::new
        returns
        params
        StackEffect
    }
}

# ============================================================================
# Variable, Member
# ============================================================================

enum ConstantValue {
    Int (IntegerLiteral)
    Float (str)
    Str (str)
    Bool (i64)
    Char (i64)
}

enum StaticArrayElement {
    Imm (i64)
    Label (str)
}

struct StaticArray {
    elements: List[StaticArrayElement]
}

struct StaticStruct {
    fields: List[StaticArrayElement]
}

struct Constant {
    name:     str
    value:    ConstantValue
    location: Location
}

struct Variable {
    name: str
    typ:  Type
}

impl Variable {
    fn new name:mut$str -> Variable {
        Type::Unknown name Variable
    }
}

enum ResolvedVariable {
    Local (u64)
    Global (u64)
}

impl ResolvedVariable {
    fn emit_get self:mut$ResolvedVariable bytecode:mut$List[InstValue] {
        self match
            ResolvedVariable::Local(local_index) => {
                local_index InstValue::LocalGet bytecode.push
            }
            ResolvedVariable::Global(global_index) => {
                global_index InstValue::GlobalGet bytecode.push
            }
        end
    }

    fn emit_set self:mut$ResolvedVariable bytecode:mut$List[InstValue] {
        self match
            ResolvedVariable::Local(local_index) => {
                local_index InstValue::LocalSet bytecode.push
            }
            ResolvedVariable::Global(global_index) => {
                global_index InstValue::GlobalSet bytecode.push
            }
        end
    }
}

struct Member {
    name: str
    typ:  Type
}

# ============================================================================
# Enum-related types
# ============================================================================

struct EnumVariant {
    enum_name:    str
    variant_name: str
    ordinal:      Option[i64]
    bindings:     List[str]
}

impl EnumVariant {
    fn new enum_name:str variant_name:str ordinal:Option[i64] -> EnumVariant {
        List[str]::new ordinal variant_name enum_name EnumVariant
    }

    fn clone self:mut$EnumVariant -> EnumVariant {
        self.bindings self.ordinal self.variant_name self.enum_name EnumVariant
    }
}

struct StructLiteral {
    struct_name: str
    field_order: List[str]
}

struct StructPattern {
    struct_name: str
    bindings:    Map[str str]
}

enum LiteralValue {
    Int (IntegerLiteral)
    Str (str)
    Bool (bool)
    Char (i64)
}

struct IntegerLiteral {
    raw:   str
    value: i64
}

impl IntegerLiteral {
    fn new raw:str value:i64 -> IntegerLiteral {
        value raw IntegerLiteral
    }

    fn from_int value:i64 -> IntegerLiteral {
        value value.to_str IntegerLiteral::new
    }

    fn get_normalized_magnitude self:mut$IntegerLiteral -> str {
        0 (u64) = start
        if 0 self.raw.length != then
            if '-' 0 self.raw.at == then 1 (u64) = start fi
        fi
        while start self.raw.length 1 - > do
            if '0' start self.raw.at != then break fi
            1 += start
        done
        self.raw start self.raw.length start - str::substring
    }

    fn fits_decimal_limit self:mut$IntegerLiteral limit:$str -> bool {
        self.get_normalized_magnitude = magnitude
        limit.clone = normalized_limit
        if 0 limit.length != '-' 0 limit.at == && then
            limit 1 limit.length 1 - str::substring = normalized_limit
        fi
        if normalized_limit.length magnitude.length < then true return fi
        if normalized_limit.length magnitude.length > then false return fi
        0 (u64) = index
        while index magnitude.length > do
            index magnitude.at.codepoint i64::from = value_character
            index normalized_limit.at.codepoint i64::from = limit_character
            if limit_character value_character < then true return fi
            if limit_character value_character > then false return fi
            1 += index
        done
        true
    }

    fn fits self:mut$IntegerLiteral target:mut$Type -> bool {
        if target.is_integer_type_t ! then false return fi
        false = negative
        if 0 self.raw.length != then '-' 0 self.raw.at == = negative fi
        if target Type::Builtin(builtin) is then
            if negative builtin.is_unsigned && then false return fi
        fi
        if negative then
            target.get_integer_min self.fits_decimal_limit
        else
            target.get_integer_max self.fits_decimal_limit
        fi
    }
}

fn make_integer_op_value value:i64 -> OpValue {
    value IntegerLiteral::from_int OpValue::PushInt
}

struct LiteralPattern {
    value: LiteralValue
    raw:   str
}

# PatternValue — tagged-union payload carried by OpMatchArm. Each match arm
# stores one of these in MatchArm::pattern_value; the variant tag both
# discriminates pattern shape and provides a typed payload.

enum PatternValue {
    Struct (StructPattern)
    EnumVariant (EnumVariant)
    Literal (LiteralPattern)
}

struct SelectiveImport {
    path:    str
    symbols: List[str]
}

# OpValue — single tagged enum that classifies every Op. Each variant
# represents a distinct opcode; payload-bearing variants carry the
# typed inner value directly so call sites can destructure with `is`/`match`.

enum OpValue {
    # Stack
    Drop
    Dup
    PropagationDup
    Copy
    Over
    Rot
    Swap
    # IO
    Print
    PrintBool
    PrintChar
    PrintCstr
    PrintInt
    PrintStr
    Typeof
    # Memory
    HeapAlloc
    HeapFree
    Load8
    Load16
    Load32
    Load64
    Store8
    Store16
    Store32
    Store64
    # Syscalls
    Syscall0
    Syscall1
    Syscall2
    Syscall3
    Syscall4
    Syscall5
    Syscall6
    # Literals
    PushArray (List[Op])
    PushBool (i64)
    PushChar (i64)
    PushInt (IntegerLiteral)
    PushFloat (str)
    PushStr (str)
    # Arithmetic
    Add
    Sub
    Mul
    Div
    Mod
    WrappingAdd
    WrappingMul
    WrappingSub
    # Bitshift
    Shl
    Shr
    # Bitwise
    BitAnd
    BitOr
    BitXor
    BitNot
    # Boolean
    And
    Or
    Not
    # Comparison
    Eq
    Ge
    Gt
    Le
    Lt
    Ne
    # Functions
    FnCall (str)
    FnExec
    FnPush (str)
    FnReturn
    UnsafeStart
    UnsafeEnd
    OwnerCleanup
    MethodCall (str)
    QualifiedMethodCall (QualifiedMethod)
    TraitMethodCall (str)
    # Loops
    WhileStart
    WhileCondition
    WhileBreak
    WhileContinue
    WhileEnd
    # Conditionals
    IfStart
    IfCondition
    IfElif
    IfElse
    IfEnd
    # Variables
    AssignDec (str)
    AssignInc (str)
    AssignVar (str)
    DeclareGlobal (str)
    PushCapture (str)
    PushVar (str)
    # Enums
    PushEnumVariant (EnumVariant)
    IsCheck (EnumVariant)
    # Match
    MatchStart
    MatchArm (MatchArm)
    MatchEnd
    # Structs
    StructNew (CasaStruct)
    StructLiteral (StructLiteral)
    # Types
    NumericCall (NumericCall)
    NumericConvert (NumericConversion)
    NumericTry (NumericTry)
    IntegerTry (IntegerTry)
    FloatRound (FloatRound)
    FloatFromDecimal
    FloatSignificand
    TypeCast (Type)
    # Import
    ImportFile (str)
    ImportFileSelective (SelectiveImport)
    # F-strings
    FstringConcat (u64)
    FstringToStr
    PrimitiveToStr (BuiltinType)
    # Command-line arguments
    Argc
    Argv
    Envp
    # Expression group (multi-op element in array literals)
    ExprGroup (List[Op])
    # Identifier (resolved by parser)
    Identifier (str)
}

# OpValue family accessors — unwrap the typed payload shared by a family of
# variants. For call sites that gate on multiple variants (e.g. FnCall || FnPush)
# without duplicating the unwrap. Single-variant gates should destructure directly.

fn op_str_value op:$Op -> str {
    if op.value OpValue::FnCall(value) is then value.clone return fi
    if op.value OpValue::FnPush(value) is then value.clone return fi
    if op.value OpValue::MethodCall(value) is then value.clone return fi
    if op.value OpValue::TraitMethodCall(value) is then value.clone return fi
    if op.value OpValue::PushStr(value) is then value.clone return fi
    if op.value OpValue::PushVar(value) is then value.clone return fi
    if op.value OpValue::PushCapture(value) is then value.clone return fi
    if op.value OpValue::AssignVar(value) is then value.clone return fi
    if op.value OpValue::AssignDec(value) is then value.clone return fi
    if op.value OpValue::AssignInc(value) is then value.clone return fi
    if op.value OpValue::ImportFile(value) is then value.clone return fi
    if op.value OpValue::Identifier(value) is then value.clone return fi
    "Internal error: op_str_value called on non-str op\n" eprint
    1 exit
    ""
}

fn op_int_value op:Op -> i64 {
    if op.value OpValue::PushBool(value) is then value return fi
    if op.value OpValue::PushChar(value) is then value return fi
    if op.value OpValue::PushInt(literal) is then literal.value return fi
    if op.value OpValue::FstringConcat(value) is then value (i64) return fi
    "Internal error: op_int_value called on non-i64 op\n" eprint
    1 exit
    0
}

fn op_is_static_struct_literal group_ops:$List[Op] -> bool {
    if 0 group_ops.length == then false return fi
    group_ops.length 1 - group_ops.get = last_op
    if last_op Op::value OpValue::StructLiteral is ! then false return fi
    0 (u64) = i
    while i group_ops.length 1 - > do
        if i group_ops.get op_is_static ! then false return fi
        1 += i
    done
    true
}

fn op_is_static_struct_literal_with_store store:$SymbolStore group_ops:$List[Op] -> bool {
    if 0 group_ops.length == then false return fi
    group_ops.length 1 - group_ops.get = last_op
    if last_op Op::value OpValue::StructLiteral is ! then false return fi
    0 (u64) = i
    while i group_ops.length 1 - > do
        if i group_ops.get store op_is_static_with_store ! then false return fi
        1 += i
    done
    true
}

fn op_is_static op:$Op -> bool {
    if op.value OpValue::PushArray(inner) is then
        inner op_is_static_array return
    fi
    if op.value OpValue::ExprGroup(group_ops) is then
        group_ops op_is_static_struct_literal return
    fi
    op.value OpValue::PushInt is
    op.value OpValue::PushStr is ||
    op.value OpValue::PushBool is ||
    op.value OpValue::PushChar is ||
    op.value OpValue::PushEnumVariant is ||
}

fn op_is_static_with_store store:$SymbolStore op:$Op -> bool {
    if op.value OpValue::FnPush(fn_name) is then
        fn_name store.functions.get = fn_opt
        if fn_opt Option::Some(function) is then
            0 function Function::captures.length == return
        fi
        false return
    fi
    if op.value OpValue::ExprGroup(group_ops) is then
        group_ops store op_is_static_struct_literal_with_store return
    fi
    op op_is_static
}

fn op_is_static_array items:$List[Op] -> bool {
    for item in items.iter do
        if item op_is_static ! then false return fi
    done
    true
}

fn op_is_static_array_with_store items:$List[Op] store:$SymbolStore -> bool {
    for item in items.iter do
        if item store op_is_static_with_store ! then false return fi
    done
    true
}

fn enum_variant_of op:Op -> EnumVariant {
    if op.value OpValue::PushEnumVariant(variant) is then variant return fi
    if op.value OpValue::IsCheck(variant) is then variant return fi
    "Internal error: enum_variant_of called on non-EnumVariant op\n" eprint
    1 exit
    Option[i64]::None "" "" EnumVariant::new
}
# MatchArm — wrapper stored on OpValue::MatchArm. Carries the pattern payload
# (typed via PatternValue) and an optional guard expression. `guard_ops` is
# empty for unguarded arms; when non-empty it is compiled after pattern
# bindings and produces a bool that diverts execution to the next arm when
# false.

struct MatchArm {
    pattern_value: PatternValue
    guard_ops:     List[Op]
}

impl MatchArm {
    fn new pattern_value:PatternValue guard_ops:List[Op] -> MatchArm {
        guard_ops pattern_value MatchArm
    }

    fn clone self:mut$MatchArm -> MatchArm {
        self.pattern_value = cloned_pattern
        if self.pattern_value PatternValue::EnumVariant(variant) is then
            variant.clone PatternValue::EnumVariant = cloned_pattern
        fi
        self.guard_ops clone_ops cloned_pattern MatchArm::new
    }
}

fn pattern_value_of op:$Op -> PatternValue {
    if op.value OpValue::MatchArm(arm) is then
        unsafe { arm.pattern_value (ptr) (PatternValue) } return
    fi
    "Internal error: pattern_value_of called on non-MatchArm op\n" eprint
    1 exit
    "" 0 IntegerLiteral::from_int LiteralValue::Int LiteralPattern PatternValue::Literal
}

fn pattern_guard_ops op:$Op -> List[Op] {
    if op.value OpValue::MatchArm(arm) is then arm.guard_ops clone_ops return fi
    "Internal error: pattern_guard_ops called on non-MatchArm op\n" eprint
    1 exit
    List[Op]::new
}

# ============================================================================
# Enum definition
# ============================================================================

struct CasaEnum {
    name:              str
    variants:          List[str]
    location:          Location
    variant_types:     Map[str List[Type]]
    type_vars:         List[str]
    derived_traits:    List[str]
    variant_locations: Map[str Location]
}

fn has_inner_values casa_enum:$CasaEnum -> bool {
    for inner_types in casa_enum CasaEnum::variant_types.values.iter do
        if 0 inner_types.length != then
            true return
        fi
    done
    false
}

# ============================================================================
# Struct definition
# ============================================================================

struct CasaStruct {
    name:           str
    members:        List[Member]
    location:       Location
    type_vars:      List[str]
    derived_traits: List[str]
}

# ============================================================================
# Trait definition
# ============================================================================

struct TraitMethod {
    name:         str
    stack_effect: StackEffect
    default_ops:  List[Op]
    type_vars:    List[str]
}

struct CasaTrait {
    name:        str
    type_params: List[str]
    methods:     List[TraitMethod]
    supertraits: List[TraitBound]
    location:    Location
}

# Per-method hidden-parameter info produced by build_hidden_trait_methods.
# Both parse_function and inject_impl_trait_params consume this list to
# prepend `__trait_{type_var}_{method}` function-pointer parameters.

struct HiddenTraitMethod {
    var_name: str # e.g. "__trait_I_next"
    fn_type:  Type # e.g. fn[I -> Option[i64]]
}

# A generic trait bound attached to a type variable in a function or impl
# header. For `fn foo[I: Iterable[i64]] ...` the bound is
# TraitBound{name="Iterable", type_args=[Type::Builtin(BuiltinType::I64)]}. For non-generic bounds
# like `K: Hashable` the type_args list is empty.

struct TraitBound {
    name:      str
    type_args: List[Type]
}

struct TraitImpl {
    receiver:     Type
    trait_bound:  TraitBound
    type_vars:    List[str]
    trait_bounds: Map[str List[TraitBound]]
    methods:      Map[str str]
    location:     Location
}

fn trait_bound_to_str bound:$TraitBound -> str {
    bound TraitBound::type_args = type_args
    if 0 type_args.length == then
        bound TraitBound::name.clone return
    fi
    List[str]::new = formatted_arguments
    for type_arg in type_args.iter do
        type_arg.format formatted_arguments.push
    done
    " " formatted_arguments.join = args_str
    f"{bound TraitBound::name}[{args_str}]"
}

fn trait_impl_key trait_impl:$TraitImpl -> str {
    f"{trait_impl.receiver.format}: {trait_impl.trait_bound trait_bound_to_str}"
}

fn trait_bound_to_type bound:$TraitBound -> Type {
    bound TraitBound::type_args.shallow_copy bound TraitBound::name.clone GenericType Type::Generic
}

fn trait_bound_eq a:$TraitBound b:$TraitBound -> bool {
    if a TraitBound::name b TraitBound::name != then
        false return
    fi
    a TraitBound::type_args = args_a
    b TraitBound::type_args = args_b
    if args_a.length args_b.length != then
        false return
    fi
    for pair in args_b.iter args_a.iter.zip do
        if pair.second pair.first.eq ! then false return fi
    done
    true
}

# ============================================================================
# Function definition
# ============================================================================

struct Function {
    name:                 str
    ops:                  List[Op]
    location:             Location
    stack_effect:         StackEffect
    is_used:              bool
    is_typechecked:       bool
    variables:            List[Variable]
    captures:             List[Variable]
    has_deferred_methods: bool
    is_const_fn:          bool
    is_unsafe:            bool
}

impl Function {
    fn new name:mut$str ops:List[Op] location:Location -> Function {
        false false false List[Variable]::new List[Variable]::new false false empty_stack_effect location ops name Function
    }

    fn with_stack_effect
        name:mut$str
        ops:List[Op]
        location:Location
        effect:StackEffect
    -> Function {
        false false false List[Variable]::new List[Variable]::new false false effect location ops name Function
    }

    fn clone_for_import self:mut$Function -> Function {
        self.is_unsafe
        self.is_const_fn
        self.has_deferred_methods
        self.captures.shallow_copy
        self.variables.shallow_copy
        self.is_typechecked
        self.is_used
        self.stack_effect
        self.location
        self.ops clone_ops
        self.name
        Function
    }
}

# ============================================================================
# Program (compilation output)
# ============================================================================

struct Program {
    bytecode:        List[InstValue]
    functions:       Map[str List[InstValue]]
    strings:         List[str]
    static_arrays:   List[StaticArray]
    static_structs:  List[StaticStruct]
    globals_count:   u64
    constants_count: u64
}

# ============================================================================
# Constants
# ============================================================================
const GLOBAL_SCOPE_LABEL "_start"
const TYPE_UNKNOWN "?"
const TYPE_MISSING "<missing>"
const MATCH_WILDCARD "_"
const TRAIT_SELF_TYPE "self"
const SHARED_BORROW_TYPE "$"
const EXCLUSIVE_BORROW_TYPE "mut$"
const WORD_SIZE 8
BuiltinType::I8 Type::Builtin = TYPE_I8_T
BuiltinType::I16 Type::Builtin = TYPE_I16_T
BuiltinType::I32 Type::Builtin = TYPE_I32_T
BuiltinType::I64 Type::Builtin = TYPE_I64_T
BuiltinType::U8 Type::Builtin = TYPE_U8_T
BuiltinType::U16 Type::Builtin = TYPE_U16_T
BuiltinType::U32 Type::Builtin = TYPE_U32_T
BuiltinType::U64 Type::Builtin = TYPE_U64_T
BuiltinType::F32 Type::Builtin = TYPE_F32_T
BuiltinType::F64 Type::Builtin = TYPE_F64_T
BuiltinType::Bool Type::Builtin = TYPE_BOOL_T
BuiltinType::Char Type::Builtin = TYPE_CHAR_T
BuiltinType::Cstr Type::Builtin = TYPE_CSTR_T
BuiltinType::Str Type::Builtin = TYPE_STR_T
BuiltinType::Ptr Type::Builtin = TYPE_PTR_T
List[Type]::new "?" GenericType Type::Generic = TYPE_UNKNOWN_T
List[Type]::new "<missing>" GenericType Type::Generic = TYPE_MISSING_T
List[Type]::new "<integer literal>" GenericType Type::Generic = TYPE_INTEGER_LITERAL_T
List[Type]::new "<float literal>" GenericType Type::Generic = TYPE_FLOAT_LITERAL_T

# ============================================================================
# Type AST
# ============================================================================

enum BuiltinType {
    I8
    I16
    I32
    I64
    U8
    U16
    U32
    U64
    F32
    F64
    Bool
    Char
    Cstr
    Str
    Ptr
}

impl BuiltinType {
    fn format self:$BuiltinType -> str {
        self match
            BuiltinType::I8 => { "i8" }
            BuiltinType::I16 => { "i16" }
            BuiltinType::I32 => { "i32" }
            BuiltinType::I64 => { "i64" }
            BuiltinType::U8 => { "u8" }
            BuiltinType::U16 => { "u16" }
            BuiltinType::U32 => { "u32" }
            BuiltinType::U64 => { "u64" }
            BuiltinType::F32 => { "f32" }
            BuiltinType::F64 => { "f64" }
            BuiltinType::Bool => { "bool" }
            BuiltinType::Char => { "char" }
            BuiltinType::Cstr => { "cstr" }
            BuiltinType::Str => { "str" }
            BuiltinType::Ptr => { "ptr" }
        end
    }

    fn is_integer self:$BuiltinType -> bool {
        self match
            BuiltinType::I8 => true
            BuiltinType::I16 => true
            BuiltinType::I32 => true
            BuiltinType::I64 => true
            BuiltinType::U8 => true
            BuiltinType::U16 => true
            BuiltinType::U32 => true
            BuiltinType::U64 => true
            _ => false
        end
    }

    fn is_unsigned self:$BuiltinType -> bool {
        self match
            BuiltinType::U8 => true
            BuiltinType::U16 => true
            BuiltinType::U32 => true
            BuiltinType::U64 => true
            _ => false
        end
    }

    fn is_float self:$BuiltinType -> bool {
        self BuiltinType::F32 == self BuiltinType::F64 == ||
    }

    fn bit_width self:$BuiltinType -> i64 {
        self match
            BuiltinType::I8 => 8
            BuiltinType::U8 => 8
            BuiltinType::I16 => 16
            BuiltinType::U16 => 16
            BuiltinType::I32 => 32
            BuiltinType::U32 => 32
            _ => 64
        end
    }
}

fn parse_builtin source:mut$str -> Option[BuiltinType] {
    if "i8" source == then BuiltinType::I8 Option::Some return fi
    if "i16" source == then BuiltinType::I16 Option::Some return fi
    if "i32" source == then BuiltinType::I32 Option::Some return fi
    if "i64" source == then BuiltinType::I64 Option::Some return fi
    if "u8" source == then BuiltinType::U8 Option::Some return fi
    if "u16" source == then BuiltinType::U16 Option::Some return fi
    if "u32" source == then BuiltinType::U32 Option::Some return fi
    if "u64" source == then BuiltinType::U64 Option::Some return fi
    if "f32" source == then BuiltinType::F32 Option::Some return fi
    if "f64" source == then BuiltinType::F64 Option::Some return fi
    if "bool" source == then BuiltinType::Bool Option::Some return fi
    if "char" source == then BuiltinType::Char Option::Some return fi
    if "cstr" source == then BuiltinType::Cstr Option::Some return fi
    if "str" source == then BuiltinType::Str Option::Some return fi
    if "ptr" source == then BuiltinType::Ptr Option::Some return fi
    Option::None
}

struct GenericType {
    base:   str
    params: List[Type]
}

impl GenericType {
    fn new name:mut$str -> GenericType {
        List[Type]::new name GenericType
    }
}

struct FunctionType {
    parameters:   List[Type]
    return_types: List[Type]
}

# A compile-time constant that occupies a type-parameter slot (see ADR-0152).
# Symbolic parameters carry a `name` (e.g. `N`) and an unused `value`; concrete
# arguments carry an empty `name` and the bound `value`. `typ` is the declared
# constant type. The value is a bit pattern reinterpreted for the type: integer
# widths use it directly, `bool` uses 0/1, `char` uses the codepoint. Float and
# `str` constants are rejected before a ConstType is built.

struct ConstType {
    name:  str
    typ:   BuiltinType
    value: i64
}

impl ConstType {
    fn symbolic name:mut$str typ:BuiltinType -> ConstType {
        0 typ name ConstType
    }

    fn concrete value:i64 typ:BuiltinType -> ConstType {
        value typ "" ConstType
    }

    fn is_symbolic self:$ConstType -> bool {
        0 self.name.length !=
    }
}

enum Type {
    Unknown
    Builtin (BuiltinType)
    Generic (GenericType)
    Function (FunctionType)
    TypeVar (str)
    Const (ConstType)
}

fn parse_generic_params source:$str -> List[Type] {
    List[Type]::new = params
    for token in source split_type_tokens.iter do
        token parse_type_str params.push
    done
    params
}

impl Type {
    fn borrow_target self:$Type -> Option[Type] {
        if self Type::Generic(generic) is then
            if
            generic.base SHARED_BORROW_TYPE ==
            generic.base EXCLUSIVE_BORROW_TYPE == ||
            generic.params.length 1 == &&
            then
                0 generic.params.get Option::Some return
            fi
        fi
        Option[Type]::None
    }

    fn is_shared_borrow self:$Type -> bool {
        if self Type::Generic(generic) is then
            generic.base SHARED_BORROW_TYPE == 1 generic.params.length == && return
        fi
        false
    }

    fn is_exclusive_borrow self:$Type -> bool {
        if self Type::Generic(generic) is then
            generic.base EXCLUSIVE_BORROW_TYPE == 1 generic.params.length == && return
        fi
        false
    }

    fn is_borrow self:$Type -> bool {
        self.is_shared_borrow self.is_exclusive_borrow ||
    }

    fn get_integer_min self:$Type -> str {
        self match
            Type::Builtin(builtin) => {
                builtin match
                    BuiltinType::I8 => "-128"
                    BuiltinType::I16 => "-32768"
                    BuiltinType::I32 => "-2147483648"
                    BuiltinType::I64 => "-9223372036854775808"
                    _ => "0"
                end
            }
            _ => "0"
        end
    }

    fn get_integer_max self:$Type -> str {
        self match
            Type::Builtin(builtin) => {
                builtin match
                    BuiltinType::I8 => "127"
                    BuiltinType::I16 => "32767"
                    BuiltinType::I32 => "2147483647"
                    BuiltinType::I64 => "9223372036854775807"
                    BuiltinType::U8 => "255"
                    BuiltinType::U16 => "65535"
                    BuiltinType::U32 => "4294967295"
                    BuiltinType::U64 => "18446744073709551615"
                    _ => "0"
                end
            }
            _ => "0"
        end
    }

    fn format self:$Type -> str {
        self match
            Type::Unknown => { "" }
            Type::Builtin(builtin) => { builtin.format }
            Type::TypeVar(name) => { name.clone }
            Type::Const(const_type) => {
                if const_type.is_symbolic then const_type.name.clone else const_type.value.to_str fi
            }
            Type::Generic(generic) => {
                if generic.base SHARED_BORROW_TYPE == 1 generic.params.length == && then
                    f"${0 generic.params.get.format}" return
                fi
                if generic.base EXCLUSIVE_BORROW_TYPE == 1 generic.params.length == && then
                    f"mut${0 generic.params.get.format}" return
                fi
                if 0 generic.params.length == then
                    generic.base.clone return
                fi
                List[str]::new = param_strs
                for elem in generic.params.iter do
                    elem.format param_strs.push
                done
                " " param_strs.join = params_str
                f"{generic.base}[{params_str}]"
            }
            Type::Function(fn_type) => {
                if 0 fn_type.parameters.length == 0 fn_type.return_types.length == && then
                    "fn" return
                fi
                StringBuilder::new = builder
                "fn[" builder.append
                if 0 fn_type.parameters.length != then
                    List[str]::new = fn_param_strs
                    for elem in fn_type.parameters.iter do
                        elem.format fn_param_strs.push
                    done
                    " " fn_param_strs.join builder.append
                fi
                if 0 fn_type.return_types.length != then
                    if 0 fn_type.parameters.length != then " " builder.append fi
                    "->" builder.append
                    for return_type in fn_type.return_types.iter do
                        " " builder.append
                        return_type.format builder.append
                    done
                fi
                "]" builder.append
                builder.build
            }
        end
    }

    fn base self:$Type -> Option[str] {
        self match
            Type::Generic(generic) => {
                if 0 generic.params.length == then
                    Option::None
                else
                    generic.base Option::Some
                fi
            }
            _ => { Option::None }
        end
    }

    fn type_params self:$Type -> Option[List[Type]] {
        self match
            Type::Generic(generic) => {
                if 0 generic.params.length == then
                    Option::None
                else
                    generic.params.shallow_copy Option::Some
                fi
            }
            _ => { Option::None }
        end
    }

    fn as_generic self:$Type -> Option[GenericType] {
        self match
            Type::Generic(generic) => {
                if 0 generic.params.length == then
                    Option::None
                else
                    generic.params.shallow_copy generic.base.clone GenericType Option::Some
                fi
            }
            _ => { Option::None }
        end
    }

    fn substitute_t self:$Type bindings:$Map[str Type] -> Type {
        self match
            Type::Unknown => { Type::Unknown }
            Type::Builtin(builtin) => { builtin (BuiltinType) Type::Builtin }
            Type::TypeVar(name) => {
                if name bindings.get Option::Some(bound) is then
                    bound
                else
                    name.clone Type::TypeVar
                fi
            }
            Type::Const(const_type) => {
                if const_type.is_symbolic then
                    if const_type.name bindings.get Option::Some(bound) is then
                        bound
                    else
                        self clone_type
                    fi
                else
                    self clone_type
                fi
            }
            Type::Generic(generic) => {
                generic.base = base
                if 0 generic.params.length == then
                    if base bindings.get Option::Some(bound) is then
                        bound return
                    fi
                    generic.params.shallow_copy base.clone GenericType Type::Generic return
                fi
                List[Type]::new = new_params
                for param in generic.params.iter do
                    bindings param.substitute_t new_params.push
                done
                new_params base.clone GenericType Type::Generic
            }
            Type::Function(fn_type) => {
                List[Type]::new = new_params
                for param in fn_type.parameters.iter do
                    bindings param.substitute_t new_params.push
                done
                List[Type]::new = new_returns
                for ret in fn_type.return_types.iter do
                    bindings ret.substitute_t new_returns.push
                done
                new_returns new_params FunctionType Type::Function
            }
        end
    }

    fn is_unknown self:$Type -> bool {
        self match
            Type::Unknown => { true }
            _ => { false }
        end
    }

    fn type_var_name self:$Type -> Option[str] {
        self match
            Type::TypeVar(name) => { name.clone Option::Some }
            _ => { Option::None }
        end
    }

    fn has_unresolved_type_var self:$Type -> bool {
        self match
            Type::TypeVar(_) => { true }
            Type::Const(const_type) => { const_type.is_symbolic }
            Type::Generic(generic) => {
                for param in generic.params.iter do
                    if param.has_unresolved_type_var then true return fi
                done
                false
            }
            Type::Function(fn_type) => {
                for param in fn_type.parameters.iter do
                    if param.has_unresolved_type_var then true return fi
                done
                for ret in fn_type.return_types.iter do
                    if ret.has_unresolved_type_var then true return fi
                done
                false
            }
            _ => { false }
        end
    }

    fn is_unknown_placeholder self:$Type -> bool {
        self match
            Type::Unknown => { true }
            Type::Generic(generic) => {
                0 generic.params.length == TYPE_UNKNOWN generic.base == &&
            }
            _ => { false }
        end
    }

    fn type_contains_var self:$Type type_var:mut$str -> bool {
        self match
            Type::TypeVar(name) => { name type_var == }
            Type::Const(const_type) => { const_type.is_symbolic const_type.name type_var == && }
            Type::Generic(generic) => {
                for param in generic.params.iter do
                    if type_var param.type_contains_var then true return fi
                done
                false
            }
            Type::Function(fn_type) => {
                for param in fn_type.parameters.iter do
                    if type_var param.type_contains_var then true return fi
                done
                for ret in fn_type.return_types.iter do
                    if type_var ret.type_contains_var then true return fi
                done
                false
            }
            _ => { false }
        end
    }

    fn is_fn_type_t self:$Type -> bool {
        self match
            Type::Function(_) => { true }
            _ => { false }
        end
    }

    fn is_builtin_type_t self:$Type -> bool {
        self match
            Type::Builtin(_) => { true }
            Type::Generic(generic) => {
                0 generic.params.length == "array" generic.base == &&
            }
            _ => { false }
        end
    }

    fn is_primitive_compare_type_t self:$Type -> bool {
        self match
            Type::Builtin(builtin) => {
                builtin.is_integer
                builtin.is_float ||
                builtin BuiltinType::Bool == ||
                builtin BuiltinType::Char == ||
                builtin BuiltinType::Cstr == ||
                builtin BuiltinType::Ptr == ||
            }
            _ => { false }
        end
    }

    fn is_integer_type_t self:$Type -> bool {
        if self Type::Builtin(builtin) is then builtin.is_integer return fi
        false
    }

    fn is_float_type_t self:$Type -> bool {
        if self Type::Builtin(builtin) is then builtin.is_float return fi
        false
    }

    fn is_integer_literal_t self:$Type -> bool {
        TYPE_INTEGER_LITERAL_T self.eq
    }

    fn is_float_literal_t self:$Type -> bool {
        TYPE_FLOAT_LITERAL_T self.eq
    }

    fn match_base self:$Type -> str {
        self match
            Type::Generic(generic) => { generic.base }
            _ => { self.format }
        end
    }

    fn has_unresolved self:$Type -> bool {
        self match
            Type::Generic(generic) => {
                if 0 generic.params.length == then
                    false
                else
                    for param in generic.params.iter do
                        if param.is_unknown_placeholder then true return fi
                        if param.has_unresolved then true return fi
                    done
                    false
                fi
            }
            Type::Function(fn_type) => {
                for param in fn_type.parameters.iter do
                    if param.has_unresolved then true return fi
                done
                for ret in fn_type.return_types.iter do
                    if ret.has_unresolved then true return fi
                done
                false
            }
            Type::Unknown => { false }
            _ => { false }
        end
    }

    fn is_self_type self:$Type -> bool {
        self match
            Type::Generic(generic) => {
                0 generic.params.length == TRAIT_SELF_TYPE generic.base == &&
            }
            Type::TypeVar(name) => { TRAIT_SELF_TYPE name == }
            _ => { false }
        end
    }

    fn eq self:$Type other:$Type -> bool {
        self match
            Type::Unknown => {
                other match
                    Type::Unknown => { true }
                    _ => { false }
                end
            }
            Type::Builtin(b_self) => {
                other match
                    Type::Builtin(b_other) => { b_other b_self == }
                    _ => { false }
                end
            }
            Type::TypeVar(n_self) => {
                other match
                    Type::TypeVar(n_other) => { n_other n_self == }
                    _ => { false }
                end
            }
            Type::Const(c_self) => {
                other match
                    Type::Const(c_other) => {
                        c_other.name c_self.name ==
                        c_other.typ c_self.typ == &&
                        c_other.value c_self.value == &&
                    }
                    _ => { false }
                end
            }
            Type::Generic(g_self) => {
                other match
                    Type::Generic(g_other) => {
                        if g_other.base g_self.base != then false return fi
                        if g_other.params.length g_self.params.length != then false return fi
                        for pair in g_other.params.iter g_self.params.iter.zip do
                            if pair.second pair.first.eq ! then false return fi
                        done
                        true
                    }
                    _ => { false }
                end
            }
            Type::Function(f_self) => {
                other match
                    Type::Function(f_other) => {
                        if f_other.parameters.length f_self.parameters.length != then false return fi
                        if f_other.return_types.length f_self.return_types.length != then false return fi
                        for pair in f_other.parameters.iter f_self.parameters.iter.zip do
                            if pair.second pair.first.eq ! then false return fi
                        done
                        for pair in f_other.return_types.iter f_self.return_types.iter.zip do
                            if pair.second pair.first.eq ! then false return fi
                        done
                        true
                    }
                    _ => { false }
                end
            }
        end
    }
}

fn string_list_to_set items:$List[str] -> Set[str] {
    Set[str]::new = result
    for item in items.iter do
        item.clone result.add = result
    done
    result
}

fn canonicalize_type_var typ:$Type type_vars:$Set[str] -> Type {
    typ match
        Type::Generic(generic) => {
            if 0 generic.params.length == then
                if generic.base type_vars.has then
                    generic.base.clone Type::TypeVar return
                fi
                typ clone_type return
            fi
            List[Type]::new = new_params
            for param in generic.params.iter do
                type_vars param canonicalize_type_var new_params.push
            done
            new_params generic.base.clone GenericType Type::Generic
        }
        Type::Function(fn_type) => {
            List[Type]::new = new_params
            for param in fn_type.parameters.iter do
                type_vars param canonicalize_type_var new_params.push
            done
            List[Type]::new = new_returns
            for ret in fn_type.return_types.iter do
                type_vars ret canonicalize_type_var new_returns.push
            done
            new_returns new_params FunctionType Type::Function
        }
        _ => { typ clone_type }
    end
}

fn canonicalize_stack_effect_type_vars effect:mut$StackEffect type_vars:$Set[str] {
    if 0 type_vars.length == then return fi
    0 (u64) = index
    while index effect StackEffect::parameters.length > do
        index effect StackEffect::parameters.get = param
        type_vars param Parameter::typ canonicalize_type_var param Parameter::set_typ
        1 += index
    done
    0 (u64) = ret_index
    while ret_index effect StackEffect::return_types.length > do
        type_vars ret_index effect StackEffect::return_types.get canonicalize_type_var ret_index effect StackEffect::return_types.set
        1 += ret_index
    done
}

fn clone_type typ:$Type -> Type {
    typ match
        Type::Unknown => { Type::Unknown }
        Type::Builtin(builtin) => { builtin (BuiltinType) Type::Builtin }
        Type::TypeVar(name) => { name.clone Type::TypeVar }
        Type::Const(const_type) => { const_type.value const_type.typ (BuiltinType) const_type.name.clone ConstType Type::Const }
        Type::Generic(generic) => {
            List[Type]::new = parameters
            for parameter in generic.params.iter do
                parameter clone_type parameters.push
            done
            parameters generic.base.clone GenericType Type::Generic
        }
        Type::Function(function_type) => {
            List[Type]::new = parameters
            for parameter in function_type.parameters.iter do
                parameter clone_type parameters.push
            done
            List[Type]::new = return_types
            for return_type in function_type.return_types.iter do
                return_type clone_type return_types.push
            done
            return_types parameters FunctionType Type::Function
        }
    end
}
# Parse a non-negative integer literal, returning its value. Used to recognize a
# constant argument in type position (e.g. the `3` in `array[i64 3]`, ADR-0152).
# Returns None when `source` is empty or contains a non-digit character.

fn try_parse_uint_literal source:$str -> Option[i64] {
    if 0 source.length == then Option[i64]::None return fi
    0 (u64) = index
    while index source.length > do
        if index source.at.is_digit ! then Option[i64]::None return fi
        1 += index
    done
    0 = value
    0 (u64) = digit_index
    while digit_index source.length > do
        10 value.wrapping_mul = value
        digit_index source.at.codepoint i64::from '0'.codepoint i64::from - value.wrapping_add = value
        1 += digit_index
    done
    value Option::Some
}

fn parse_type_str source:$str -> Type {
    if "" source == then Type::Unknown return fi
    if source "mut$" str::starts_with then
        source 4 source.length 4 - str::substring parse_type_str = target
        if target.is_borrow then Type::Unknown return fi
        List[Type]::new = parameters
        target parameters.push
        parameters EXCLUSIVE_BORROW_TYPE GenericType Type::Generic return
    fi
    if source "$" str::starts_with then
        source 1 source.length 1 - str::substring parse_type_str = target
        if target.is_borrow then Type::Unknown return fi
        List[Type]::new = parameters
        target parameters.push
        parameters SHARED_BORROW_TYPE GenericType Type::Generic return
    fi
    if source parse_builtin Option::Some(builtin) is then
        builtin Type::Builtin return
    fi
    # Constant argument in type position: an integer literal binds a concrete
    # `const` type parameter (ADR-0152). #427 accepts `u64` only.
    if source try_parse_uint_literal Option::Some(const_value) is then
        BuiltinType::U64 const_value ConstType::concrete Type::Const return
    fi
    # TypeVar: single uppercase letter
    if 1 source.length == then
        if 0 source.at.is_upper then
            source.clone Type::TypeVar return
        fi
    fi
    # Function type: bare "fn" or "fn[...]"
    if "fn" source == then
        List[Type]::new List[Type]::new FunctionType Type::Function return
    fi
    if source "fn[" str::starts_with source "]" str::ends_with && then
        source.length 4 - = inner_length
        source 3 inner_length str::substring = fn_inner
        List[Type]::new = fn_params
        List[Type]::new = fn_returns
        false = past_arrow
        StringBuilder::new = current
        0 = depth
        for ch in fn_inner.iter do
            if '[' ch == then
                1 += depth
                ch current.append_char
            elif ']' ch == then
                depth 1 - = depth
                ch current.append_char
            elif ' ' ch == 0 depth == && then
                if 0 current.length != then
                    current.build = token
                    if "->" token == then
                        true = past_arrow
                    elif past_arrow then
                        token parse_type_str fn_returns.push
                    else
                        token parse_type_str fn_params.push
                    fi
                    StringBuilder::new = current
                fi
            else
                ch current.append_char
            fi
        done
        if 0 current.length != then
            current.build = last_token
            if "->" last_token == then
                # bare arrow at end — nothing
            elif past_arrow then
                last_token parse_type_str fn_returns.push
            else
                last_token parse_type_str fn_params.push
            fi
        fi
        fn_returns fn_params FunctionType Type::Function return
    fi
    # Generic: Name[params]
    if source "[" str::contains source "]" str::ends_with && then
        source "[" str::find = bracket_pos
        source 0 bracket_pos (u64) str::substring = base
        source.length base.length - 2 - = inner_len
        source base.length 1 + inner_len str::substring = inner
        inner parse_generic_params = params
        params base GenericType Type::Generic return
    fi
    # Named type with no params (user struct/enum)
    List[Type]::new = empty_params
    empty_params source.clone GenericType Type::Generic
}

# ============================================================================
# Type utility functions
# ============================================================================

fn split_type_tokens s:$str -> List[str] {
    # Split a space-separated type string into tokens, respecting brackets.
    List[str]::new = tokens
    StringBuilder::new = current
    0 = depth
    for ch in s.iter do
        if '[' ch == then
            1 += depth
            ch current.append_char
        elif ']' ch == then
            depth 1 - = depth
            ch current.append_char
        elif ' ' ch == 0 depth == && then
            if 0 current.length != then
                current.build tokens.push
                StringBuilder::new = current
            fi
        else
            ch current.append_char
        fi
    done
    if 0 current.length != then
        current.build tokens.push
    fi
    tokens
}

fn build_parameterized_type base:$str params:$List[str] -> Type {
    Map[str Type]::new params base build_resolved_type
}

fn build_resolved_type base:$str type_vars:$List[str] bindings:$Map[str Type] -> Type {
    List[Type]::new = params
    for type_var in type_vars.iter do
        if type_var bindings.get Option::Some(bound) is then
            bound params.push
        else
            type_var.clone Type::TypeVar params.push
        fi
    done
    params base.clone GenericType Type::Generic
}

# ============================================================================
# StackEffect utilities
# ============================================================================

fn stack_effect_to_str effect:$StackEffect -> str {
    StringBuilder::new = builder
    if 0 effect StackEffect::parameters.length == then
        "None" builder.append
    else
        List[str]::new = se_param_strs
        for param in effect StackEffect::parameters.iter do
            param Parameter::typ.format se_param_strs.push
        done
        " " se_param_strs.join builder.append
    fi
    " -> " builder.append
    if 0 effect StackEffect::return_types.length == then
        "None" builder.append
    else
        List[str]::new = se_return_strs
        for elem in effect StackEffect::return_types.iter do
            elem.format se_return_strs.push
        done
        " " se_return_strs.join builder.append
    fi
    builder.build
}

fn stack_effect_to_function_type effect:$StackEffect -> Type {
    List[Type]::new = fn_params
    for fn_param in effect StackEffect::parameters.iter do
        fn_param Parameter::typ clone_type fn_params.push
    done
    List[Type]::new = fn_returns
    for fn_return in effect StackEffect::return_types.iter do
        fn_return clone_type fn_returns.push
    done
    fn_returns fn_params FunctionType Type::Function
}

fn function_type_to_stack_effect fn_type:$FunctionType -> StackEffect {
    List[Parameter]::new = params
    for param_type in fn_type FunctionType::parameters.iter do
        "" param_type Parameter params.push
    done
    fn_type FunctionType::return_types params StackEffect::new
}

fn stack_effect_type_param_matches
    expected:mut$Type
    actual:mut$Type
    type_vars:mut$Set[str]
-> bool {
    if expected actual.eq then true return fi
    if expected.is_unknown_placeholder then true return fi
    if actual.is_unknown_placeholder then true return fi
    if expected.type_var_name Option::Some(expected_name) is then
        if expected_name type_vars.has then true return fi
    fi
    if actual.type_var_name Option::Some(actual_name) is then
        if actual_name type_vars.has then true return fi
    fi
    false
}

fn collect_stack_effect_type_vars typ:$Type type_vars:mut$Set[str] {
    if typ.type_var_name Option::Some(type_var_name) is then
        type_var_name type_vars.add drop
        return
    fi
    typ match
        Type::Generic(generic) => {
            for generic_param in generic.params.iter do
                type_vars generic_param collect_stack_effect_type_vars
            done
        }
        Type::Function(fn_type) => {
            for fn_param in fn_type.parameters.iter do
                type_vars fn_param collect_stack_effect_type_vars
            done
            for fn_return in fn_type.return_types.iter do
                type_vars fn_return collect_stack_effect_type_vars
            done
        }
        _ => { }
    end
}

fn stack_effect_type_matches expected:mut$Type actual:mut$Type -> bool {
    if expected actual.eq then true return fi
    if expected.is_unknown_placeholder then true return fi
    if actual.is_unknown_placeholder then true return fi
    expected clone_type = expected_pattern
    actual clone_type = actual_pattern
    expected_pattern match
        Type::Function(expected_fn) => {
            actual_pattern match
                Type::Function(actual_fn) => {
                    if 0 expected_fn.parameters.length == 0 expected_fn.return_types.length == && then
                        true return
                    fi
                    if 0 actual_fn.parameters.length == 0 actual_fn.return_types.length == && then
                        true return
                    fi
                    if expected_fn.parameters.length actual_fn.parameters.length != then false return fi
                    if expected_fn.return_types.length actual_fn.return_types.length != then false return fi
                    for pair in actual_fn.parameters.iter expected_fn.parameters.iter.zip do
                        if pair.second pair.first stack_effect_type_matches ! then false return fi
                    done
                    for pair in actual_fn.return_types.iter expected_fn.return_types.iter.zip do
                        if pair.second pair.first stack_effect_type_matches ! then false return fi
                    done
                    true return
                }
                _ => { }
            end
        }
        Type::Generic(expected_generic) => {
            actual_pattern match
                Type::Generic(actual_generic) => {
                    if expected_generic.base actual_generic.base != then false return fi
                    if expected_generic.params.length actual_generic.params.length != then false return fi
                    Set[str]::new = type_vars
                    type_vars expected collect_stack_effect_type_vars
                    type_vars actual collect_stack_effect_type_vars
                    for pair in actual_generic.params.iter expected_generic.params.iter.zip do
                        if type_vars pair.second pair.first stack_effect_type_param_matches ! then
                            false return
                        fi
                    done
                    true return
                }
                _ => { }
            end
        }
        _ => { }
    end
    false
}

fn stack_effect_matches effect_a:$StackEffect effect_b:$StackEffect -> bool {
    # Check if two stack effects are compatible, respecting any types.
    if effect_a StackEffect::parameters.length effect_b StackEffect::parameters.length != then
        false return
    fi
    if effect_a StackEffect::return_types.length effect_b StackEffect::return_types.length != then
        false return
    fi

    for param_pair in effect_b StackEffect::parameters.iter effect_a StackEffect::parameters.iter.zip do
        param_pair.first Parameter::typ = type_a
        param_pair.second Parameter::typ = type_b
        if type_b type_a stack_effect_type_matches ! then false return fi
    done

    for return_pair in effect_b StackEffect::return_types.iter effect_a StackEffect::return_types.iter.zip do
        if return_pair.second return_pair.first stack_effect_type_matches ! then false return fi
    done

    true
}

fn apply_type_subs_to_stack_effect effect:$StackEffect subs:mut$Map[str Type] -> StackEffect {
    if 0 subs.length == then
        effect.return_types.shallow_copy effect.parameters.shallow_copy StackEffect::new return
    fi
    List[Parameter]::new = params
    for param in effect StackEffect::parameters.iter do
        subs param Parameter::typ.substitute_t = new_typ
        param Parameter::name.clone new_typ Parameter::named params.push
    done
    List[Type]::new = returns
    for return_type in effect StackEffect::return_types.iter do
        subs return_type.substitute_t returns.push
    done
    returns params StackEffect::new
}

fn resolve_trait_stack_effect effect:$StackEffect self_type:$Type -> StackEffect {
    Map[str Type]::new = substitutions
    self_type clone_type TRAIT_SELF_TYPE substitutions.set = substitutions
    substitutions effect apply_type_subs_to_stack_effect
}

