    # carries `u64` provisionally; its width is checked later against the declared
    # parameter type. Char literals are handled in `parse_type_ast` (codepoint
    # decoder in scope there).
    if source try_parse_uint_literal std::Option::Some(const_value) is then
        BuiltinType::U64 const_value ConstType::concrete Type::Const return
    fi
    if "true" source.as_str == then
        BuiltinType::Bool 1 ConstType::concrete Type::Const return
    fi
    if "false" source.as_str == then
        BuiltinType::Bool 0 ConstType::concrete Type::Const return
    fi
    # TypeVar: single uppercase letter
    if 1 source.length == then
        if 0 source.at.is_upper then
            source.to_str Type::TypeVar return
        fi
    fi
    # Function type: bare "fn" or "fn[...]"
    if "fn" source.as_str == then
        std::List[Type]::new std::List[Type]::new FunctionType Type::Function return
    fi
    if source "fn[" str::starts_with source "]" str::ends_with && then
        source.length 4 - = inner_length
        source 3 inner_length str::substring = fn_inner
        std::List[Type]::new = fn_params
        std::List[Type]::new = fn_returns
        false = past_arrow
        std::String::new = current
        0 = depth
        for ch in fn_inner.iter do
            if '[' ch == then
                1 += depth
                ch current.push
            elif ']' ch == then
                depth 1 - = depth
                ch current.push
            elif ' ' ch == 0 depth == && then
                if 0 current.length != then
                    current = token
                    if "->" token.as_str == then
                        true = past_arrow
                    elif past_arrow then
                        token.as_str parse_type_str fn_returns.push
                    else
                        token.as_str parse_type_str fn_params.push
                    fi
                    std::String::new = current
                fi
            else
                ch current.push
            fi
        done
        if 0 current.length != then
            current = last_token
            if "->" last_token.as_str == then
                # bare arrow at end — nothing
            elif past_arrow then
                last_token.as_str parse_type_str fn_returns.push
            else
                last_token.as_str parse_type_str fn_params.push
            fi
        fi
        fn_returns fn_params FunctionType Type::Function return
    fi
    # Generic: Name[params]
    if source "[" str::contains source "]" str::ends_with && then
        source "[" str::find = bracket_pos
        source 0 bracket_pos u64::try_from.unwrap str::substring = base
        source.length base.length - 2 - = inner_len
        source base.length 1 + inner_len str::substring = inner
        inner.as_str parse_generic_params = params
        params base GenericType Type::Generic return
    fi
    # Named type with no params (user struct/enum)
    std::List[Type]::new = empty_params
    empty_params source.to_str GenericType Type::Generic
}

# ============================================================================
# Type utility functions
# ============================================================================

pub fn split_type_tokens s:$str -> std::List[std::String] {
    # Split a space-separated type string into tokens, respecting brackets.
    std::List[std::String]::new = tokens
    std::String::new = current
    0 = depth
    for ch in s.iter do
        if '[' ch == then
            1 += depth
            ch current.push
        elif ']' ch == then
            depth 1 - = depth
            ch current.push
        elif ' ' ch == 0 depth == && then
            if 0 current.length != then
                current tokens.push
                std::String::new = current
            fi
        else
            ch current.push
        fi
    done
    if 0 current.length != then
        current tokens.push
    fi
    tokens
}

pub fn build_parameterized_type base:$str params:$std::List[std::String] -> Type {
    std::Map[std::String Type]::new params base build_resolved_type
}

pub fn build_resolved_type
    base:$str
    type_vars:$std::List[std::String]
    bindings:$std::Map[std::String Type]
-> Type {
    std::List[Type]::new = params
    for type_var in type_vars.iter do
        if type_var bindings.get std::Option::Some(bound) is then
            bound.clone params.push
        else
            type_var.clone Type::TypeVar params.push
        fi
    done
    params base.to_str GenericType Type::Generic
}

# ============================================================================
# StackEffect utilities
# ============================================================================

pub fn stack_effect_to_str effect:$StackEffect -> std::String {
    std::String::new = builder
    if 0 effect StackEffect::parameters.length == then
        "None" builder.append
    else
        std::List[std::String]::new = se_param_strs
        for param in effect StackEffect::parameters.iter do
            param Parameter::typ.format se_param_strs.push
        done
        " " se_param_strs.join_strings builder.append_string
    fi
    " -> " builder.append
    if 0 effect StackEffect::return_types.length == then
        "None" builder.append
    else
        std::List[std::String]::new = se_return_strs
        for elem in effect StackEffect::return_types.iter do
            elem.format se_return_strs.push
        done
        " " se_return_strs.join_strings builder.append_string
    fi
    builder
}

pub fn stack_effect_to_function_type effect:$StackEffect -> Type {
    std::List[Type]::new = fn_params
    for fn_param in effect StackEffect::parameters.iter do
        fn_param Parameter::typ.clone fn_params.push
    done
    std::List[Type]::new = fn_returns
    for fn_return in effect StackEffect::return_types.iter do
        fn_return.clone fn_returns.push
    done
    fn_returns fn_params FunctionType Type::Function
}

pub fn function_type_to_stack_effect fn_type:$FunctionType -> StackEffect {
    std::List[Parameter]::new = params
    for param_type in fn_type FunctionType::parameters.iter do
        "".to_str param_type.clone Parameter params.push
    done
    fn_type FunctionType::return_types.clone params StackEffect::new
}

pub fn stack_effect_type_param_matches
    expected:$Type
    actual:$Type
    type_vars:mut$std::Set[std::String]
-> bool {
    if expected actual.eq then
        true return
    fi
    if expected.is_unknown_placeholder then
        true return
    fi
    if actual.is_unknown_placeholder then
        true return
    fi
    if expected.type_var_name std::Option::Some(expected_name) is then
        if expected_name type_vars.has then
            true return
        fi
    fi
    if actual.type_var_name std::Option::Some(actual_name) is then
        if actual_name type_vars.has then
            true return
        fi
    fi
    false
}

pub fn collect_stack_effect_type_vars typ:$Type type_vars:mut$std::Set[std::String] {
    if typ.type_var_name std::Option::Some(type_var_name) is then
        type_var_name.clone type_vars.add
        return
    fi
    typ match
        Type::Generic(generic) => {
            for generic_param in generic.params.iter do
                type_vars generic_param collect_stack_effect_type_vars
            done
        }
        Type::Function(fn_type) => {
            for fn_param in fn_type.parameters.iter do
                type_vars fn_param collect_stack_effect_type_vars
            done
            for fn_return in fn_type.return_types.iter do
                type_vars fn_return collect_stack_effect_type_vars
            done
        }
        _ => {
        }
    end
}

pub fn stack_effect_type_matches expected:$Type actual:$Type -> bool {
    if expected actual.eq then
        true return
    fi
    if expected.is_unknown_placeholder then
        true return
    fi
    if actual.is_unknown_placeholder then
        true return
    fi
    expected.clone = expected_pattern
    actual.clone = actual_pattern
    expected_pattern match
        Type::Function(expected_fn) => {
            if actual_pattern Type::Function(actual_fn) is then
                if 0 expected_fn.parameters.length == 0 expected_fn.return_types.length == && then
                    true return
                fi
                if 0 actual_fn.parameters.length == 0 actual_fn.return_types.length == && then
                    true return
                fi
                if expected_fn.parameters.length actual_fn.parameters.length != then
                    false return
                fi
                if expected_fn.return_types.length actual_fn.return_types.length != then
                    false return
                fi
                for
                    pair in actual_fn.parameters.iter expected_fn
                        .parameters
                        .iter
                        .zip
                do
                    if pair.second pair.first stack_effect_type_matches ! then
                        false return
                    fi
                done
                for
                    pair in actual_fn.return_types.iter expected_fn
                        .return_types
                        .iter
                        .zip
                do
                    if pair.second pair.first stack_effect_type_matches ! then
                        false return
                    fi
                done
                true return
            fi
        }
        Type::Generic(expected_generic) => {
            if actual_pattern Type::Generic(actual_generic) is then
                if expected_generic.base actual_generic.base != then
                    false return
                fi
                if expected_generic.params.length actual_generic.params.length != then
                    false return
                fi
                std::Set[std::String]::new = type_vars
                type_vars expected collect_stack_effect_type_vars
                type_vars actual collect_stack_effect_type_vars
                for
                    pair in actual_generic.params.iter expected_generic
                        .params
                        .iter
                        .zip
                do
                    if type_vars pair.second pair.first stack_effect_type_param_matches ! then
                        false return
                    fi
                done
                true return
            fi
        }
        _ => {
        }
    end
    false
}

pub fn stack_effect_matches effect_a:$StackEffect effect_b:$StackEffect -> bool {
    # Check if two stack effects are compatible, respecting any types.
    if effect_a StackEffect::parameters.length effect_b StackEffect::parameters.length != then
        false return
    fi
    if effect_a StackEffect::return_types.length effect_b StackEffect::return_types.length != then
        false return
    fi

    for param_pair in effect_b StackEffect::parameters.iter effect_a StackEffect::parameters.iter.zip do
        param_pair.first Parameter::typ = type_a: $Type
        param_pair.second Parameter::typ = type_b: $Type
        if type_b type_a stack_effect_type_matches ! then
            false return
        fi
    done

    for
        return_pair in effect_b StackEffect::return_types.iter effect_a StackEffect::return_types.iter.zip
    do
        if return_pair.second return_pair.first stack_effect_type_matches ! then
            false return
        fi
    done

    true
}

pub fn apply_type_subs_to_stack_effect
    effect:$StackEffect
    subs:mut$std::Map[std::String Type]
-> StackEffect {
    std::List[Parameter]::new = params
    for param in effect StackEffect::parameters.iter do
        subs param Parameter::typ.substitute_t = new_typ
        param Parameter::name.clone new_typ Parameter::named params.push
    done
    std::List[Type]::new = returns
    for return_type in effect StackEffect::return_types.iter do
        subs return_type.substitute_t returns.push
    done
    effect.clone = resolved
    params resolved StackEffect::set_parameters
    returns resolved StackEffect::set_return_types
    resolved
}

pub fn resolve_trait_stack_effect effect:$StackEffect self_type:$Type -> StackEffect {
    std::Map[std::String Type]::new = substitutions
    self_type.clone TRAIT_SELF_TYPE substitutions.set_str
    substitutions effect apply_type_subs_to_stack_effect
}

