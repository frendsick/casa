    pub typ:  Type
}

impl Member: std::Clone {
    pub fn clone self:$Member -> Member { self.typ clone_type self.name.clone Member }
}

# ============================================================================
# Enum-related types
# ============================================================================

pub struct EnumVariant {
    pub enum_name:    std::String
    pub variant_name: std::String
    pub ordinal:      std::Option[i64]
    pub bindings:     std::List[std::String]
}

impl EnumVariant {
    pub fn new
        enum_name:std::String
        variant_name:std::String
        ordinal:std::Option[i64]
    -> EnumVariant {
        std::List[std::String]::new ordinal variant_name enum_name EnumVariant
    }

    pub fn clone self:$EnumVariant -> EnumVariant {
        std::List[std::String]::new = bindings
        for binding in self.bindings.iter do
            binding.clone bindings.push
        done
        bindings self.ordinal.clone self.variant_name.clone self.enum_name.clone EnumVariant
    }
}

pub struct StructLiteral {
    pub struct_name: std::String
    pub field_order: std::List[std::String]
}

pub struct StructPattern {
    pub struct_name: std::String
    pub bindings:    std::Map[std::String std::String]
}

pub enum LiteralValue {
    Int (IntegerLiteral)
    Str (std::String)
    Bool (bool)
    Char (i64)
}

pub struct IntegerLiteral {
    pub raw:   std::String
    pub value: i64
}

impl IntegerLiteral {
    pub fn new raw:std::String value:i64 -> IntegerLiteral { value raw IntegerLiteral }

    pub fn from_int value:i64 -> IntegerLiteral { value value.to_str IntegerLiteral::new }

    pub fn get_normalized_magnitude self:$IntegerLiteral -> std::String {
        0 (u64) = start
        if 0 self.raw.length != then
            if '-' 0 self.raw.at == then
                1 (u64) = start
            fi
        fi
        while start self.raw.length 1 - > do
            if '0' start self.raw.at != then
                break
            fi
            1 += start
        done
        self.raw.as_str start self.raw.length start - str::substring
    }

    pub fn fits_decimal_limit self:$IntegerLiteral limit:$str -> bool {
        self.get_normalized_magnitude = magnitude
        limit.to_str = normalized_limit
        if 0 limit.length != '-' 0 limit.at == && then
            limit 1 limit.length 1 - str::substring = normalized_limit
        fi
        if normalized_limit.length magnitude.length < then
            true return
        fi
        if normalized_limit.length magnitude.length > then
            false return
        fi
        0 (u64) = index
        while index magnitude.length > do
            index magnitude.at.codepoint i64::from = value_character
            index normalized_limit.at.codepoint i64::from = limit_character
            if limit_character value_character < then
                true return
            fi
            if limit_character value_character > then
                false return
            fi
            1 += index
        done
        true
    }

    pub fn fits self:$IntegerLiteral target:$Type -> bool {
        if target.is_integer_type_t ! then
            false return
        fi
        false = negative
        if 0 self.raw.length != then
            '-' 0 self.raw.at == = negative
        fi
        if target Type::Builtin(builtin) is then
            if negative builtin.is_unsigned && then
                false return
            fi
        fi
        if negative then
            target.get_integer_min self.fits_decimal_limit
        else
            target.get_integer_max self.fits_decimal_limit
        fi
    }
}
# Source identifiers cannot start with `$`. Parser-generated storage uses this
# namespace so it can keep local move semantics even when emitted globally.

pub fn is_internal_variable_name name:$str -> bool { name "$" str::starts_with }

pub fn make_integer_op_value value:i64 -> OpValue {
    value IntegerLiteral::from_int OpValue::PushInt
}

pub struct LiteralPattern {
    pub value: LiteralValue
    pub raw:   std::String
}

pub fn clone_literal_value value:$LiteralValue -> LiteralValue {
    value match
        LiteralValue::Int(literal) => literal.value literal.raw.clone IntegerLiteral::new LiteralValue::Int
        LiteralValue::Str(text) => text.clone LiteralValue::Str
        LiteralValue::Bool(boolean) => boolean LiteralValue::Bool
        LiteralValue::Char(character) => character LiteralValue::Char
    end
}

pub fn clone_pattern_value value:$PatternValue -> PatternValue {
    value match
        PatternValue::Struct(pattern) => {
            pattern.bindings.clone pattern.struct_name.clone StructPattern PatternValue::Struct
        }
        PatternValue::EnumVariant(variant) => variant.clone PatternValue::EnumVariant
        PatternValue::Literal(pattern) => {
            pattern.raw.clone pattern.value clone_literal_value LiteralPattern PatternValue::Literal
        }
    end
}
# PatternValue — tagged-union payload carried by OpMatchArm. Each match arm
# stores one of these in MatchArm::pattern_value; the variant tag both
# discriminates pattern shape and provides a typed payload.

pub enum PatternValue {
    Struct (StructPattern)
    EnumVariant (EnumVariant)
    Literal (LiteralPattern)
}

pub struct SelectiveImport {
    pub path:      std::String
    pub namespace: std::String
    pub symbols:   std::List[std::String]
}

pub struct ModuleImport {
    pub path:      std::String
    pub namespace: std::String
}

pub struct GlobalInitializer {
    pub name: std::String
    pub ops:  std::List[Op]
}

impl GlobalInitializer: std::Clone {
    pub fn clone self:$GlobalInitializer -> GlobalInitializer {
        self.ops clone_ops self.name.clone GlobalInitializer
    }
}
# OpValue — single tagged enum that classifies every Op. Each variant
# represents a distinct opcode; payload-bearing variants carry the
# typed inner value directly so call sites can destructure with `is`/`match`.

pub enum OpValue {
    # Stack
    Drop
    Dup
    Copy
    Over
    Rot
    Swap
    # IO
    Print
    PrintBool
    PrintChar
    PrintCstr
    PrintInt
    PrintStr
    PrintString
    Typeof
    SizeOf (Type)
    # Memory
    HeapAlloc
    HeapFree
    Load8
    Load16
    Load32
    Load64
    PtrAsRef (Type)
    PtrAsMut (Type)
    PtrIntoRaw
    PtrRead (Type)
    Store8
    Store16
    Store32
    Store64
    PtrWrite (Type)
    # Syscalls
    Syscall0
    Syscall1
    Syscall2
    Syscall3
    Syscall4
    Syscall5
    Syscall6
    # Literals
    PushArray (std::List[Op])
    PushBool (i64)
    PushChar (i64)
    PushInt (IntegerLiteral)
    PushFloat (std::String)
    PushStr (std::String)
    # Arithmetic
    Add
    Sub
    Mul
    Div
    Mod
    WrappingAdd
    WrappingMul
    WrappingSub
    # Bitshift
    Shl
    Shr
    # Bitwise
    BitAnd
    BitOr
    BitXor
    BitNot
    # Boolean
    And
    Or
    Not
    # Comparison
    Eq
    Ge
    Gt
    Le
    Lt
    Ne
    # Functions
    FnCall (std::String)
    FnExec
    FnExecOwned
    FnPush (std::String)
    FnReturn
    DestructionFn (Type)
    Question (std::String)
    QuestionMove (std::String)
    UnsafeStart
    UnsafeEnd
    OwnerCleanup
    MethodCall (std::String)
    QualifiedMethodCall (QualifiedMethod)
    TraitMethodCall (DeferredTraitCall)
    TraitMethodRef (DeferredTraitCall)
    # Loops
    WhileStart
    WhileCondition
    WhileBreak
    WhileContinue
    WhileEnd
    # Conditionals
    IfStart
    IfCondition
    IfElif
    IfElse
    IfEnd
    # Variables
    AssignDec (std::String)
    AssignInc (std::String)
    AssignVar (std::String)
    BindTemporary (TemporaryBinding)
    DeclareGlobal (std::String)
    InitGlobal (GlobalInitializer)
    PushCapture (std::String)
    PushVar (std::String)
    # Enums
    PushEnumVariant (EnumVariant)
    IsCheck (EnumVariant)
    # Match
    MatchStart
    MatchArm (MatchArm)
    MatchEnd
    # Structs
    StructNew (CasaStruct)
    StructLiteral (StructLiteral)
    # Types
    NumericCall (NumericCall)
    NumericConvert (NumericConversion)
    NumericTry (NumericTry)
    IntegerTry (IntegerTry)
    FloatRound (FloatRound)
    FloatFromDecimal
    FloatSignificand
    TypeCast (Type)
    # Import
    ImportFile (ModuleImport)
    ImportFileSelective (SelectiveImport)
    # F-strings
    FstringConcat (u64)
    FstringToStr
    PrimitiveToStr (BuiltinType)
    # Command-line arguments
    Argc
    Argv
    Envp
    # Expression group (multi-op element in array literals)
    ExprGroup (std::List[Op])
    # Identifier (resolved by parser)
    Identifier (std::String)
}

# OpValue family accessors — unwrap the typed payload shared by a family of
# variants. For call sites that gate on multiple variants (e.g. FnCall || FnPush)
# without duplicating the unwrap. Single-variant gates should destructure directly.

pub fn op_str_value op:$Op -> std::String {
    if op.value OpValue::FnCall(value) is then
        value.clone return
    fi
    if op.value OpValue::FnPush(value) is then
        value.clone return
    fi
    if op.value OpValue::MethodCall(value) is then
        value.clone return
    fi
    if op.value OpValue::PushStr(value) is then
        value.clone return
    fi
    if op.value OpValue::PushVar(value) is then
        value.clone return
    fi
    if op.value OpValue::PushCapture(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignVar(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignDec(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignInc(value) is then
        value.clone return
    fi
    if op.value OpValue::Question(value) is then
        value.clone return
    fi
    if op.value OpValue::ImportFile(value) is then
        value.path.clone return
    fi
    if op.value OpValue::Identifier(value) is then
        value.clone return
    fi
    "Internal error: op_str_value called on non-str op\n" std::eprint
    1 std::exit
    std::String::new
}

pub fn op_int_value op:$Op -> i64 {
    if op.value OpValue::PushBool(value) is then
        value return
    fi
    if op.value OpValue::PushChar(value) is then
        value return
    fi
    if op.value OpValue::PushInt(literal) is then
        literal.value return
    fi
    if op.value OpValue::FstringConcat(value) is then
        value (i64) return
    fi
    "Internal error: op_int_value called on non-i64 op\n" std::eprint
    1 std::exit
    0
}

pub fn op_is_static_struct_literal group_ops:$std::List[Op] -> bool {
    if 0 group_ops.length == then
        false return
    fi
    group_ops.length 1 - group_ops.get = last_op
    if last_op Op::value OpValue::StructLiteral is ! then
        false return
    fi
    0 (u64) = i
    while i group_ops.length 1 - > do
        if i group_ops.get op_is_static ! then
            false return
        fi
        1 += i
    done
    true
}

pub fn op_is_static_struct_literal_with_store store:$SymbolStore group_ops:$std::List[Op] -> bool {
    if 0 group_ops.length == then
        false return
    fi
    group_ops.length 1 - group_ops.get = last_op
    if last_op Op::value OpValue::StructLiteral is ! then
        false return
    fi
    0 (u64) = i
    while i group_ops.length 1 - > do
        if i group_ops.get store op_is_static_with_store ! then
            false return
        fi
        1 += i
    done
    true
}

pub fn op_is_static op:$Op -> bool {
    if op.value OpValue::PushArray(inner) is then
        inner op_is_static_array return
    fi
    if op.value OpValue::ExprGroup(group_ops) is then
        group_ops op_is_static_struct_literal return
    fi
    op.value OpValue::PushInt is
    op.value OpValue::PushStr is ||
    op.value OpValue::PushBool is ||
    op.value OpValue::PushChar is ||
    op.value OpValue::PushEnumVariant is ||
}

pub fn op_is_static_with_store store:$SymbolStore op:$Op -> bool {
    if op.value OpValue::FnPush(fn_name) is then
        fn_name.as_str store.get_function = fn_opt
        if fn_opt std::Option::Some(function) is then
            0 function Function::captures.length == return
        fi
        false return
    fi
    if op.value OpValue::ExprGroup(group_ops) is then
        group_ops store op_is_static_struct_literal_with_store return
    fi
    op op_is_static
}

pub fn op_is_static_array items:$std::List[Op] -> bool {
    for item in items.iter do
        if item op_is_static ! then
            false return
        fi
    done
    true
}

pub fn op_is_static_array_with_store items:$std::List[Op] store:$SymbolStore -> bool {
    for item in items.iter do
        if item store op_is_static_with_store ! then
            false return
        fi
    done
    true
}

pub fn enum_variant_of op:Op -> EnumVariant {
    op.value clone_op_value = value
    if value OpValue::PushEnumVariant(variant) is then
        variant.clone return
    fi
    if value OpValue::IsCheck(variant) is then
        variant.clone return
    fi
    "Internal error: enum_variant_of called on non-EnumVariant op\n" std::eprint
    1 std::exit
    std::Option[i64]::None "".to_str "".to_str EnumVariant::new
}
# MatchArm — wrapper stored on OpValue::MatchArm. Carries the pattern payload
# (typed via PatternValue) and an optional guard expression. `guard_ops` is
# empty for unguarded arms; when non-empty it is compiled after pattern
# bindings and produces a bool that diverts execution to the next arm when
# false.

pub struct MatchArm {
    pub pattern_value: PatternValue
    pub guard_ops:     std::List[Op]
}

impl MatchArm {
    pub fn new pattern_value:PatternValue guard_ops:std::List[Op] -> MatchArm {
        guard_ops pattern_value MatchArm
    }

    pub fn clone self:$MatchArm -> MatchArm {
        self.guard_ops clone_ops self.pattern_value clone_pattern_value MatchArm::new
    }
}

pub fn pattern_value_of op:$Op -> PatternValue {
    if op.value OpValue::MatchArm(arm) is then
        arm.pattern_value clone_pattern_value return
    fi
    "Internal error: pattern_value_of called on non-MatchArm op\n" std::eprint
    1 std::exit
    "".to_str 0 IntegerLiteral::from_int LiteralValue::Int LiteralPattern PatternValue::Literal
}

pub fn pattern_guard_ops op:$Op -> std::List[Op] {
    if op.value OpValue::MatchArm(arm) is then
        arm.guard_ops clone_ops return
    fi
    "Internal error: pattern_guard_ops called on non-MatchArm op\n" std::eprint
    1 std::exit
    std::List[Op]::new
}

# ============================================================================
# Enum definition
# ============================================================================

pub struct CasaEnum {
    pub name:              std::String
    pub variants:          std::List[std::String]
    pub location:          Location
    pub variant_types:     std::Map[std::String std::List[Type]]
    pub type_vars:         std::List[std::String]
    pub derived_traits:    std::List[std::String]
    pub variant_locations: std::Map[std::String Location]
}

impl CasaEnum: std::Clone {
    pub fn clone self:$CasaEnum -> CasaEnum {
        std::Map[std::String std::List[Type]]::new = variant_types
        for pair in self.variant_types.iter do
            std::List[Type]::new = payload_types
            for payload_type in pair.second.iter do
                payload_type clone_type payload_types.push
            done
            payload_types pair.first.clone variant_types.set
        done
        self.variant_locations.clone
        self.derived_traits.clone
        self.type_vars.clone
        variant_types
        self.location.clone
        self.variants.clone
        self.name.clone
        CasaEnum
    }
}

pub fn has_inner_values casa_enum:$CasaEnum -> bool {
    for pair in casa_enum CasaEnum::variant_types.iter do
        if 0 pair.second.length != then
            true return
        fi
    done
    false
}

# ============================================================================
# Struct definition
# ============================================================================

pub struct CasaStruct {
    pub name:           std::String
    pub members:        std::List[Member]
    pub location:       Location
    pub type_vars:      std::List[std::String]
    pub derived_traits: std::List[std::String]
}

impl CasaStruct: std::Clone {
    pub fn clone self:$CasaStruct -> CasaStruct {
        self.derived_traits.clone self.type_vars.clone self.location.clone
        self.members.clone self.name.clone CasaStruct
    }
}

# ============================================================================
# Trait definition
# ============================================================================

pub struct TraitMethod {
    pub name:                std::String
    pub stack_effect:        StackEffect
    pub default_ops:         std::List[Op]
    pub default_variables:   std::List[Variable]
    pub default_is_resolved: bool
    pub type_vars:           std::List[std::String]
}

pub struct CasaTrait {
    pub name:        std::String
    pub type_params: std::List[std::String]
    pub methods:     std::List[TraitMethod]
    pub supertraits: std::List[TraitBound]
    pub location:    Location
}

pub fn clone_casa_trait casa_trait:$CasaTrait -> CasaTrait {
    std::List[std::String]::new = type_parameters
    for type_parameter in casa_trait.type_params.iter do
        type_parameter.clone type_parameters.push
    done
    std::List[TraitMethod]::new = methods
    for method in casa_trait.methods.iter do
        method clone_trait_method methods.push
    done
    std::List[TraitBound]::new = supertraits
    for supertrait in casa_trait.supertraits.iter do
        supertrait clone_trait_bound supertraits.push
    done
    casa_trait.location.clone supertraits methods type_parameters casa_trait.name.clone CasaTrait
}

impl CasaTrait: std::Clone {
    pub fn clone self:$CasaTrait -> CasaTrait { self clone_casa_trait }
}

pub fn clone_parameter parameter:$Parameter -> Parameter {
    parameter.name.clone parameter.typ clone_type Parameter
}

pub fn clone_trait_bound bound:$TraitBound -> TraitBound {
    std::List[Type]::new = type_arguments
    for argument in bound.type_args.iter do
        argument clone_type type_arguments.push
    done
    type_arguments bound.name.clone TraitBound
}

pub fn clone_stack_effect effect:$StackEffect -> StackEffect {
    std::List[Parameter]::new = parameters
    for parameter in effect.parameters.iter do
        parameter clone_parameter parameters.push
    done
    std::List[Type]::new = return_types
    for return_type in effect.return_types.iter do
        return_type clone_type return_types.push
    done
    return_types parameters StackEffect::new = cloned
    std::Set[std::String]::new = type_variables
    for type_variable in effect.type_vars.iter do
        type_variable.clone type_variables.add
    done
    type_variables cloned StackEffect::set_type_vars
    std::Map[std::String std::List[TraitBound]]::new = trait_bounds
    for pair in effect.trait_bounds.iter do
        std::List[TraitBound]::new = bounds
        for bound in pair.second.iter do
            bound clone_trait_bound bounds.push
        done
        bounds pair.first.clone trait_bounds.set
    done
    trait_bounds cloned StackEffect::set_trait_bounds
    std::Map[std::String BuiltinType]::new = constant_parameters
    for pair in effect.const_params.iter do
        pair.second.clone pair.first.clone constant_parameters.set
    done
    constant_parameters cloned StackEffect::set_const_params
    cloned
}

pub fn clone_trait_method method:$TraitMethod -> TraitMethod {
    std::List[std::String]::new = type_variables
    for type_variable in method.type_vars.iter do
        type_variable.clone type_variables.push
    done
    type_variables method.default_is_resolved method.default_variables.clone method.default_ops clone_ops method.stack_effect clone_stack_effect
    method.name.clone TraitMethod
}

impl Parameter: std::Clone {
    pub fn clone self:$Parameter -> Parameter { self clone_parameter }
}

impl StackEffect: std::Clone {
    pub fn clone self:$StackEffect -> StackEffect { self clone_stack_effect }
}

impl TraitBound: std::Clone {
    pub fn clone self:$TraitBound -> TraitBound { self clone_trait_bound }
}

impl TraitMethod: std::Clone {
    pub fn clone self:$TraitMethod -> TraitMethod { self clone_trait_method }
}
# A generic trait bound attached to a type variable in a function or impl
# header. For `fn foo[I: Iterable[i64]] ...` the bound is
# TraitBound{name="__casa_std__Iterable", type_args=[Type::Builtin(BuiltinType::I64)]}.
# For non-generic bounds
# like `K: Hashable` the type_args list is empty.

pub struct TraitBound {
    pub name:      std::String
    pub type_args: std::List[Type]
}

pub struct TraitImpl {
    pub receiver:     Type
    pub trait_bound:  TraitBound
    pub type_vars:    std::List[std::String]
    pub trait_bounds: std::Map[std::String std::List[TraitBound]]
    pub methods:      std::Map[std::String std::String]
    pub location:     Location
}

pub fn clone_trait_impl trait_impl:$TraitImpl -> TraitImpl {
    std::List[std::String]::new = type_variables
    for type_variable in trait_impl.type_vars.iter do
        type_variable.clone type_variables.push
    done
    std::Map[std::String std::List[TraitBound]]::new = trait_bounds
    for pair in trait_impl.trait_bounds.iter do
        std::List[TraitBound]::new = bounds
        for bound in pair.second.iter do
            bound clone_trait_bound bounds.push
        done
        bounds pair.first.clone trait_bounds.set
    done
    std::Map[std::String std::String]::new = methods
    for pair in trait_impl.methods.iter do
        pair.second.clone pair.first.clone methods.set
    done
    trait_impl.location.clone
    methods
    trait_bounds
    type_variables
    trait_impl.trait_bound clone_trait_bound
    trait_impl.receiver clone_type
    TraitImpl
}

impl TraitImpl: std::Clone {
    pub fn clone self:$TraitImpl -> TraitImpl { self clone_trait_impl }
}

pub fn trait_bound_to_str bound:$TraitBound -> std::String {
    bound TraitBound::type_args = type_args: $std::List[Type]
    if 0 type_args.length == then
        bound TraitBound::name.clone return
    fi
    std::List[std::String]::new = formatted_arguments
    for type_arg in type_args.iter do
        type_arg.format formatted_arguments.push
    done
    " " formatted_arguments.join_strings = args_str
    f"{bound TraitBound::name}[{args_str}]"
}

pub fn trait_impl_key trait_impl:$TraitImpl -> std::String {
    f"{trait_impl.receiver.format}: {trait_impl.trait_bound trait_bound_to_str}"
}

pub fn trait_bound_to_type bound:$TraitBound -> Type {
    std::List[Type]::new = type_arguments
    for argument in bound.type_args.iter do
        argument clone_type type_arguments.push
    done
    type_arguments bound TraitBound::name.clone GenericType Type::Generic
}

pub fn trait_bound_eq a:$TraitBound b:$TraitBound -> bool {
    if a TraitBound::name b TraitBound::name != then
        false return
    fi
    a TraitBound::type_args = args_a: $std::List[Type]
    b TraitBound::type_args = args_b: $std::List[Type]
    if args_a.length args_b.length != then
        false return
    fi
    for pair in args_b.iter args_a.iter.zip do
        if pair.second pair.first.eq ! then
            false return
        fi
    done
    true
}

# ============================================================================
# Function definition
# ============================================================================

pub struct Function {
    pub name:             std::String
    pub ops:              std::List[Op]
    pub location:         Location
    pub stack_effect:     StackEffect
    pub is_resolved:      bool
    pub is_typechecked:   bool
    pub variables:        std::List[Variable]
    pub captures:         std::List[Variable]
    pub global_captures:  std::List[std::String]
    pub owned_captures:   std::List[std::String]
    pub captures_by_move: bool
    pub captures_shared:  bool
    pub is_const_fn:      bool
    pub is_unsafe:        bool
    pub generic_params:   std::List[std::String]
}

impl Function {
    pub fn new name:std::String ops:std::List[Op] location:Location -> Function {
        std::List[std::String]::new false false false false std::List[std::String]::new std::List[std::String]::new std::List[Variable]::new std::List[Variable]::new false false empty_stack_effect location ops name Function
    }

    pub fn with_stack_effect
        name:std::String
        ops:std::List[Op]
        location:Location
        effect:StackEffect
    -> Function {
        std::List[std::String]::new false false false false std::List[std::String]::new std::List[std::String]::new std::List[Variable]::new std::List[Variable]::new false false effect location ops name Function
    }

    pub fn clone_for_import self:$Function -> Function {
        self.generic_params.clone
        self.is_unsafe
        self.is_const_fn
        self.captures_shared
        self.captures_by_move
        self.owned_captures.clone
        self.global_captures.clone
        self.captures.clone
        self.variables.clone
        self.is_typechecked
        self.is_resolved
        self.stack_effect.clone
        self.location.clone
        self.ops clone_ops
        self.name.clone
        Function
    }

    # Preserve callable metadata while an owned function body is updated or compiled.
    pub fn clone_declaration self:$Function -> Function {
        self.generic_params.clone
        self.is_unsafe
        self.is_const_fn
        self.captures_shared
        self.captures_by_move
        self.owned_captures.clone
        self.global_captures.clone
        self.captures.clone
        self.variables.clone
        self.is_typechecked
        self.is_resolved
        self.stack_effect.clone
        self.location.clone
        std::List[Op]::new
        self.name.clone
        Function
    }

    # Split an owned function into its declaration and body.
    pub fn split_body self:Function -> Function std::List[Op] {
        self match
            Function { name: name ops: ops location: location stack_effect: stack_effect is_resolved: is_resolved is_typechecked: is_typechecked variables: variables captures: captures global_captures: global_captures owned_captures: owned_captures captures_by_move: captures_by_move captures_shared: captures_shared is_const_fn: is_const_fn is_unsafe: is_unsafe generic_params: generic_params } => {
                generic_params
                is_unsafe is_const_fn captures_shared captures_by_move
                owned_captures global_captures captures variables is_typechecked is_resolved
                stack_effect location std::List[Op]::new name Function
                ops
            }
        end
    }
}

impl Function: std::Clone {
    pub fn clone self:$Function -> Function { self.clone_for_import }
}

