# Variable, Member
# ============================================================================

pub enum ConstantValue derives std::Clone {
    Int (IntegerLiteral)
    Float (std::String)
    Str (std::String)
    Bool (i64)
    Char (i64)
}

pub enum StaticArrayElement derives std::Clone {
    Imm (i64)
    Label (std::String)
}

pub struct StaticArray derives std::Clone {
    pub elements: std::List[StaticArrayElement]
}

pub struct StaticStruct derives std::Clone {
    pub fields: std::List[StaticArrayElement]
}

pub struct Constant derives std::Clone {
    pub name:     std::String
    pub value:    ConstantValue
    pub location: Location
}

pub struct Variable derives std::Clone {
    pub name: std::String
    pub typ:  Type
}

impl Variable {
    pub fn new name:$str -> Variable { Type::Unknown name.to_str Variable }
}

pub enum ResolvedVariable {
    Local (u64)
    Global (u64)
}

impl ResolvedVariable {
    pub fn emit_get self:mut$ResolvedVariable bytecode:mut$std::List[InstValue] {
        self match
            ResolvedVariable::Local(local_index) => {
                local_index InstValue::LocalGet bytecode.push
            }
            ResolvedVariable::Global(global_index) => {
                global_index InstValue::GlobalGet bytecode.push
            }
        end
    }

    pub fn emit_set self:mut$ResolvedVariable bytecode:mut$std::List[InstValue] {
        self match
            ResolvedVariable::Local(local_index) => {
                local_index InstValue::LocalSet bytecode.push
            }
            ResolvedVariable::Global(global_index) => {
                global_index InstValue::GlobalSet bytecode.push
            }
        end
    }
}

pub struct Member derives std::Clone {
    pub name: std::String
    pub typ:  Type
}

