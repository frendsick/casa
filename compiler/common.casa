# Type AST
pub enum BuiltinType derives std::Eq std::Copy {
    I8
    I16
    I32
    I64
    U8
    U16
    U32
    U64
    F32
    F64
    Bool
    Char
    Cstr
    Str
    Ptr
}

impl BuiltinType {
    pub fn format self:$BuiltinType -> str {
        self match
            BuiltinType::I8 => {
                "i8"
            }
            BuiltinType::I16 => {
                "i16"
            }
            BuiltinType::I32 => {
                "i32"
            }
            BuiltinType::I64 => {
                "i64"
            }
            BuiltinType::U8 => {
                "u8"
            }
            BuiltinType::U16 => {
                "u16"
            }
            BuiltinType::U32 => {
                "u32"
            }
            BuiltinType::U64 => {
                "u64"
            }
            BuiltinType::F32 => {
                "f32"
            }
            BuiltinType::F64 => {
                "f64"
            }
            BuiltinType::Bool => {
                "bool"
            }
            BuiltinType::Char => {
                "char"
            }
            BuiltinType::Cstr => {
                "cstr"
            }
            BuiltinType::Str => {
                "str"
            }
            BuiltinType::Ptr => {
                "ptr"
            }
        end
    }

    pub fn is_integer self:$BuiltinType -> bool {
        self match
            BuiltinType::I8 => true
            BuiltinType::I16 => true
            BuiltinType::I32 => true
            BuiltinType::I64 => true
            BuiltinType::U8 => true
            BuiltinType::U16 => true
            BuiltinType::U32 => true
            BuiltinType::U64 => true
            _ => false
        end
    }

    pub fn is_unsigned self:$BuiltinType -> bool {
        self match
            BuiltinType::U8 => true
            BuiltinType::U16 => true
            BuiltinType::U32 => true
            BuiltinType::U64 => true
            _ => false
        end
    }

    pub fn is_float self:$BuiltinType -> bool {
        self BuiltinType::F32 == self BuiltinType::F64 == ||
    }

    pub fn bit_width self:$BuiltinType -> i64 {
        self match
            BuiltinType::I8 => 8
            BuiltinType::U8 => 8
            BuiltinType::I16 => 16
            BuiltinType::U16 => 16
            BuiltinType::I32 => 32
            BuiltinType::U32 => 32
            _ => 64
        end
    }
}

pub fn parse_builtin source:$str -> std::Option[BuiltinType] {
    if "i8" source.as_str == then
        BuiltinType::I8 std::Option::Some return
    fi
    if "i16" source.as_str == then
        BuiltinType::I16 std::Option::Some return
    fi
    if "i32" source.as_str == then
        BuiltinType::I32 std::Option::Some return
    fi
    if "i64" source.as_str == then
        BuiltinType::I64 std::Option::Some return
    fi
    if "u8" source.as_str == then
        BuiltinType::U8 std::Option::Some return
    fi
    if "u16" source.as_str == then
        BuiltinType::U16 std::Option::Some return
    fi
    if "u32" source.as_str == then
        BuiltinType::U32 std::Option::Some return
    fi
    if "u64" source.as_str == then
        BuiltinType::U64 std::Option::Some return
    fi
    if "f32" source.as_str == then
        BuiltinType::F32 std::Option::Some return
    fi
    if "f64" source.as_str == then
        BuiltinType::F64 std::Option::Some return
    fi
    if "bool" source.as_str == then
        BuiltinType::Bool std::Option::Some return
    fi
    if "char" source.as_str == then
        BuiltinType::Char std::Option::Some return
    fi
    if "cstr" source.as_str == then
        BuiltinType::Cstr std::Option::Some return
    fi
    if "str" source.as_str == then
        BuiltinType::Str std::Option::Some return
    fi
    if "ptr" source.as_str == then
        BuiltinType::Ptr std::Option::Some return
    fi
    std::Option::None
}
# Generic type trees are immutable. Clones share their backing until the last
# owner is destroyed. Substitution constructs a new tree.
pub struct GenericType {
    data: ptr
}

struct GenericTypeData {
    references: u64
    base:       std::String
    params:     std::List[Type]
}

impl GenericType {
    pub fn new name:std::String -> GenericType {
        std::List[Type]::new name GenericType::with_params
    }

    pub fn with_params name:std::String parameters:std::List[Type] -> GenericType {
        # SAFETY: The new backing has one owner. GenericType::drop releases the last owner.
        unsafe { parameters name 1 GenericTypeData ptr::into_raw GenericType }
    }

    pub fn base self:$GenericType -> $std::String {
        # SAFETY: self keeps the immutable backing live for the returned borrow.
        unsafe { self.data ptr::as_ref[GenericTypeData].base }
    }

    pub fn params self:$GenericType -> $std::List[Type] {
        # SAFETY: self keeps the immutable backing live for the returned borrow.
        unsafe { self.data ptr::as_ref[GenericTypeData].params }
    }

    pub fn drop self:mut$GenericType {
        if ptr::null self.data == then
            return
        fi
        # SAFETY: Only the reference count is mutated. The last handle owns the
        # backing and its children. Type construction cannot create a cycle.
        unsafe {
            self.data load64 1 - = remaining
            remaining self.data store64
            if 0 remaining == then
                self.data ptr::from_raw[GenericTypeData] drop
            fi
            ptr::null = self.data
        }
    }
}

impl GenericType: std::Clone {
    pub fn clone self:$GenericType -> GenericType {
        # SAFETY: Handles share immutable data. Only their count is changed,
        # and compiler requests access their owned type trees on one thread.
        unsafe {
            self.data load64 1 + self.data store64
            self.data GenericType
        }
    }
}

pub struct FunctionType derives std::Clone {
    pub parameters:   std::List[Type]
    pub return_types: std::List[Type]
}

# A compile-time constant in a type-parameter slot (ADR-0152, ADR-0153).
# Symbolic: `name` set (e.g. `N`), `value` unused. Concrete: `name` empty,
# `value` holds the constant (integer verbatim, `bool` as 0/1, `char` as
# codepoint). Float and `str` are rejected before a ConstType exists.
pub struct ConstType derives std::Clone {
    pub name:  std::String
    pub typ:   BuiltinType
    pub value: i64
}

impl ConstType {
    pub fn symbolic name:std::String typ:BuiltinType -> ConstType { 0 typ name ConstType }

    pub fn concrete value:i64 typ:BuiltinType -> ConstType { value typ "".to_str ConstType }

    pub fn is_symbolic self:$ConstType -> bool { 0 self.name.length != }

    # Does this argument fit a `const` parameter of `expected_typ`
    # (ADR-0153)? Integer arguments are contextual (fit any width whose range
    # holds them); `bool` and `char` require the same kind. Symbolic arguments
    # must fit for every value of their declared type.
    pub fn fits_parameter self:$ConstType expected_typ:BuiltinType -> bool {
        if self.is_symbolic then
            if self.typ expected_typ == then
                true return
            fi
            if self.typ.is_integer expected_typ.is_integer && ! then
                false return
            fi
            if self.typ.is_unsigned expected_typ.is_unsigned == then
                self.typ.bit_width expected_typ.bit_width >= return
            fi
            expected_typ.is_unsigned ! self.typ.is_unsigned &&
            self.typ.bit_width expected_typ.bit_width > && return
        fi
        if expected_typ.is_integer then
            if self.typ.is_integer ! then
                false return
            fi
            if self.typ BuiltinType::U64 == 0 self.value < && then
                expected_typ BuiltinType::U64 == return
            fi
            self.value IntegerLiteral::from_int = literal
            expected_typ Type::Builtin literal.fits return
        fi
        if expected_typ BuiltinType::Bool == then
            self.typ BuiltinType::Bool == return
        fi
        if expected_typ BuiltinType::Char == then
            self.typ BuiltinType::Char == return
        fi
        false
    }
}

pub enum Type derives std::Clone {
    Unknown
    Builtin (BuiltinType)
    Generic (GenericType)
    Function (FunctionType)
    TypeVar (std::String)
    Const (ConstType)
}

# Build the type of an `array[T N]` value: element type plus its length as a
# concrete constant type parameter (ADR-0152).
pub fn make_array_type element:Type length:u64 -> Type {
    std::List[Type]::new = parameters
    element parameters.push
    BuiltinType::U64 length i64::try_from.unwrap ConstType::concrete Type::Const parameters.push
    parameters ARRAY_TYPE.to_str GenericType::with_params Type::Generic
}
# Bytes an `array[T N]` value occupies. A zero-length array keeps the one-byte
# minimum every inhabited type has (ADR-0132, ADR-0155).
pub fn get_array_storage_size length:u64 element_size:u64 -> u64 {
    if 0 length == then
        1 return
    fi
    length element_size *
}

pub fn get_array_length_parameter array_type:$Type -> std::Option[ConstType] {
    if array_type Type::Generic(generic) is then
        if ARRAY_TYPE generic.base.as_str != 2 generic.params.length != || then
            std::Option[ConstType]::None return
        fi
        if 1 generic.params.get Type::Const(length) is then
            length.value length.typ length.name.clone ConstType std::Option::Some return
        fi
    fi
    std::Option[ConstType]::None
}
# The concrete length of an `array[T N]` type, or None when the type is not an
# array or its length is symbolic.
pub fn get_concrete_array_length array_type:$Type -> std::Option[u64] {
    if array_type get_array_length_parameter std::Option::Some(length) is then
        if length.is_symbolic ! then
            length.value u64::wrapping_from std::Option::Some return
        fi
    fi
    std::Option[u64]::None
}

pub fn parse_generic_params source:$str -> std::List[Type] {
    std::List[Type]::new = params
    for token in source split_type_tokens.iter do
        token.as_str parse_type_str params.push
    done
    params
}

pub fn apply_borrow_type target:Type prefix:$str -> Type {
    if "" prefix == then
        target return
    fi
    if target.borrow_target std::Option::Some(borrowed_target) is then
        if SHARED_BORROW_TYPE prefix == target.is_shared_borrow || then
            SHARED_BORROW_TYPE borrowed_target.clone apply_borrow_type return
        fi
        EXCLUSIVE_BORROW_TYPE borrowed_target.clone apply_borrow_type return
    fi
    std::List[Type]::new = parameters
    target parameters.push
    parameters prefix.to_str GenericType::with_params Type::Generic
}

impl Type {
    pub fn array_element_type self:$Type -> std::Option[Type] {
        if self Type::Generic(generic) is then
            if ARRAY_TYPE generic.base.as_str == 2 generic.params.length == && then
                0 generic
                    .params
                    .get
                    .clone std::Option::Some return
            fi
        fi
        std::Option[Type]::None
    }

    pub fn borrow_target self:$Type -> std::Option[Type] {
        if self Type::Generic(generic) is then
            if
                generic.base.as_str SHARED_BORROW_TYPE ==
                generic.base.as_str EXCLUSIVE_BORROW_TYPE == ||
                generic.params.length 1 == &&
            then
                0 generic
                    .params
                    .get
                    .clone std::Option::Some return
            fi
        fi
