# ============================================================================
# Core data structures
# ============================================================================

pub struct Span {
    pub offset: u64
    pub length: u64
}

pub struct SourcePosition {
    pub line:   u64
    pub column: u64
}

impl Span: std::Clone {
    pub fn clone self:$Span -> Span { self.length self.offset Span }
}

impl SourcePosition: std::Clone {
    pub fn clone self:$SourcePosition -> SourcePosition { self.column self.line SourcePosition }
}

impl SourcePosition {
    pub fn new line:u64 column:u64 -> SourcePosition { column line SourcePosition }
}

pub struct Location {
    pub file: std::String
    pub span: Span
}

impl Location {
    pub fn new file:std::String offset:u64 length:u64 -> Location {
        length offset Span file Location
    }
}

impl Location: std::Clone {
    pub fn clone self:$Location -> Location {
        self.span.length self.span.offset self.file.clone Location::new
    }
}

pub fn empty_location -> Location { 0 0 Span "".to_str Location }

pub struct Token {
    pub value:    std::String
    pub kind:     TokenKind
    pub location: Location
}

impl Token {
    pub fn new value:std::String kind:TokenKind location:$Location -> Token {
        location.clone kind value Token
    }
}

impl Token: std::Clone {
    pub fn clone self:$Token -> Token { self.location.clone self.kind self.value.clone Token }
}

# ============================================================================
# Op value types
#
# Op stores its opcode and any associated data in `value`. Opcodes such as
# Add, Drop, and IfStart have no data. Other opcodes carry typed data that call
# sites unpack with `is` or `match`.
# ============================================================================

pub struct Op {
    pub id:                   i64
    pub location:             Location
    pub type_hint:            std::Option[Type]
    pub deferred_return_hint: std::Option[Type]
    pub call_bindings:        std::Map[std::String Type]
    pub value:                OpValue
}

pub struct OwnerEvent {
    pub name:       std::String
    pub typ:        Type
    pub generation: u64
}

impl OwnerEvent {
    pub fn new name:$str typ:$Type generation:u64 -> OwnerEvent {
        generation typ clone_type name.to_str OwnerEvent
    }

    pub fn clone self:$OwnerEvent -> OwnerEvent {
        self.generation self.typ clone_type self.name.clone OwnerEvent
    }
}

pub struct OpOwnership {
    pub assignments: std::List[OwnerEvent]
    pub cleanups:    std::List[OwnerEvent]
    pub moves_owner: bool
}

impl OpOwnership {
    pub fn new -> OpOwnership {
        false std::List[OwnerEvent]::new std::List[OwnerEvent]::new OpOwnership
    }
}

impl OpOwnership: std::Clone {
    pub fn clone self:$OpOwnership -> OpOwnership {
        std::List[OwnerEvent]::new = assignments
        for event in self.assignments.iter do
            event.clone assignments.push
        done
        std::List[OwnerEvent]::new = cleanups
        for event in self.cleanups.iter do
            event.clone cleanups.push
        done
        self.moves_owner cleanups assignments OpOwnership
    }
}

pub struct QualifiedMethod {
    pub type_qualified: bool
    pub qualifier_type: Type
    pub method_name:    std::String
}

# A checked trait-bound operation keeps its declared contract until a concrete
# specialization can select the implementation.

pub struct DeferredTraitCall {
    pub method_name:  std::String
    pub receiver:     Type
    pub trait_type:   std::Option[Type]
    pub stack_effect: StackEffect
}

impl DeferredTraitCall {
    pub fn unresolved method_name:std::String receiver:Type -> DeferredTraitCall {
        empty_stack_effect std::Option[Type]::None receiver method_name DeferredTraitCall
    }

    pub fn new
        method_name:std::String
        receiver:Type
        trait_type:std::Option[Type]
        stack_effect:StackEffect
    -> DeferredTraitCall {
        stack_effect trait_type receiver method_name DeferredTraitCall
    }

    pub fn substitute
        self:$DeferredTraitCall
        bindings:mut$std::Map[std::String Type]
    -> DeferredTraitCall {
        bindings self.stack_effect apply_type_subs_to_stack_effect = effect
        self.trait_type.clone = trait_type
        if trait_type std::Option::Some(bound) is then
            bindings bound.substitute_t std::Option::Some = trait_type
        fi
        effect trait_type bindings self.receiver.substitute_t
        self.method_name.clone
        DeferredTraitCall
    }
}

impl DeferredTraitCall: std::Clone {
    pub fn clone self:$DeferredTraitCall -> DeferredTraitCall {
        self.stack_effect.clone self.trait_type.clone self.receiver clone_type
        self.method_name.clone DeferredTraitCall
    }
}

pub struct TemporaryBinding {
    pub name:  std::String
    pub depth: u64
}

impl TemporaryBinding: std::Clone {
    pub fn clone self:$TemporaryBinding -> TemporaryBinding {
        self.depth self.name.clone TemporaryBinding
    }
}
# Type checking assigns each operation a stable ID. Dense operation lists can
# relocate their elements, so metadata must not use element addresses.

impl Op {
    pub fn new value:OpValue location:$Location -> Op {
        value std::Map[std::String Type]::new std::Option[Type]::None std::Option[Type]::None location.clone 0 Op
    }
}

pub fn op_identity op:$Op -> i64 { op.id }

pub fn ensure_op_ownership_address store:mut$SymbolStore op_id:i64 -> mut$OpOwnership {
    if op_id store.op_ownership.get_mut std::Option::Some(ownership) is then
        ownership return
    fi
    OpOwnership::new = ownership
    ownership op_id store.op_ownership.set
    op_id store
        .op_ownership
        .get_mut
        .unwrap
}

pub fn ensure_op_ownership store:mut$SymbolStore op:mut$Op -> mut$OpOwnership {
    op op_identity store ensure_op_ownership_address
}

pub fn add_owner_assignment store:mut$SymbolStore op:mut$Op event:OwnerEvent {
    op store ensure_op_ownership = ownership
    event ownership.assignments.push
}

pub fn add_owner_cleanup store:mut$SymbolStore op:mut$Op event:OwnerEvent {
    op store ensure_op_ownership = ownership
    event ownership.cleanups.push
}

pub fn set_moves_owner store:mut$SymbolStore op_id:i64 {
    op_id store ensure_op_ownership_address = ownership
    true = ownership.moves_owner
}

pub fn clone_qualified_method method:$QualifiedMethod -> QualifiedMethod {
    method.method_name.clone method.qualifier_type clone_type method.type_qualified QualifiedMethod
}

pub fn clone_struct_literal literal:$StructLiteral -> StructLiteral {
    literal.field_order.clone literal.struct_name.clone StructLiteral
}

pub fn clone_selective_import import_value:$SelectiveImport -> SelectiveImport {
    import_value.symbols.clone import_value.namespace.clone import_value.path.clone SelectiveImport
}

pub fn clone_module_import import_value:$ModuleImport -> ModuleImport {
    import_value.namespace.clone import_value.path.clone ModuleImport
}

pub fn clone_op_value value:$OpValue -> OpValue {
    value match
        OpValue::SizeOf(typ) => typ clone_type OpValue::SizeOf
        OpValue::PtrAsRef(typ) => typ clone_type OpValue::PtrAsRef
        OpValue::PtrAsMut(typ) => typ clone_type OpValue::PtrAsMut
        OpValue::PtrIntoRaw => OpValue::PtrIntoRaw
        OpValue::PtrRead(typ) => typ clone_type OpValue::PtrRead
        OpValue::PtrWrite(typ) => typ clone_type OpValue::PtrWrite
        OpValue::PushArray(items) => items clone_ops OpValue::PushArray
        OpValue::PushBool(boolean_value) => boolean_value OpValue::PushBool
        OpValue::PushChar(character_value) => character_value OpValue::PushChar
        OpValue::PushInt(literal) => literal.value literal.raw.clone IntegerLiteral::new OpValue::PushInt
        OpValue::PushFloat(text) => text.clone OpValue::PushFloat
        OpValue::PushStr(text) => text.clone OpValue::PushStr
        OpValue::FnCall(name) => name.clone OpValue::FnCall
        OpValue::FnPush(name) => name.clone OpValue::FnPush
        OpValue::DestructionFn(typ) => typ clone_type OpValue::DestructionFn
        OpValue::Question(name) => name.clone OpValue::Question
        OpValue::QuestionMove(name) => name.clone OpValue::QuestionMove
        OpValue::MethodCall(name) => name.clone OpValue::MethodCall
        OpValue::QualifiedMethodCall(method) => method clone_qualified_method OpValue::QualifiedMethodCall
        OpValue::TraitMethodCall(call) => call.clone OpValue::TraitMethodCall
        OpValue::TraitMethodRef(call) => call.clone OpValue::TraitMethodRef
        OpValue::AssignDec(name) => name.clone OpValue::AssignDec
        OpValue::AssignInc(name) => name.clone OpValue::AssignInc
        OpValue::AssignVar(name) => name.clone OpValue::AssignVar
        OpValue::BindTemporary(binding) => binding.clone OpValue::BindTemporary
        OpValue::DeclareGlobal(name) => name.clone OpValue::DeclareGlobal
        OpValue::InitGlobal(initializer) => initializer.clone OpValue::InitGlobal
        OpValue::PushCapture(name) => name.clone OpValue::PushCapture
        OpValue::PushVar(name) => name.clone OpValue::PushVar
        OpValue::PushEnumVariant(variant) => variant.clone OpValue::PushEnumVariant
        OpValue::IsCheck(variant) => variant.clone OpValue::IsCheck
        OpValue::MatchArm(arm) => arm.clone OpValue::MatchArm
        OpValue::StructNew(casa_struct) => casa_struct.clone OpValue::StructNew
        OpValue::StructLiteral(literal) => literal clone_struct_literal OpValue::StructLiteral
        OpValue::NumericCall(call) => call.target call.method.clone NumericCall OpValue::NumericCall
        OpValue::NumericConvert(conversion) => {
            conversion.target conversion.source conversion.kind NumericConversion OpValue::NumericConvert
        }
        OpValue::NumericTry(numeric_try) => {
            numeric_try.target numeric_try.source clone_type NumericTry OpValue::NumericTry
        }
        OpValue::IntegerTry(integer_try) => {
            integer_try.target integer_try.kind IntegerTry OpValue::IntegerTry
        }
        OpValue::FloatRound(rounding) => {
            rounding.target rounding.method.clone FloatRound OpValue::FloatRound
        }
        OpValue::TypeCast(typ) => typ clone_type OpValue::TypeCast
        OpValue::ImportFile(import_value) => import_value clone_module_import OpValue::ImportFile
        OpValue::ImportFileSelective(import_value) => {
            import_value clone_selective_import OpValue::ImportFileSelective
        }
        OpValue::FstringConcat(count) => count OpValue::FstringConcat
        OpValue::PrimitiveToStr(builtin) => builtin OpValue::PrimitiveToStr
        OpValue::ExprGroup(items) => items clone_ops OpValue::ExprGroup
        OpValue::Identifier(name) => name.clone OpValue::Identifier
        OpValue::Drop => OpValue::Drop
        OpValue::Dup => OpValue::Dup
        OpValue::Copy => OpValue::Copy
        OpValue::Over => OpValue::Over
        OpValue::Rot => OpValue::Rot
        OpValue::Swap => OpValue::Swap
        OpValue::Print => OpValue::Print
        OpValue::PrintBool => OpValue::PrintBool
        OpValue::PrintChar => OpValue::PrintChar
        OpValue::PrintCstr => OpValue::PrintCstr
        OpValue::PrintInt => OpValue::PrintInt
        OpValue::PrintStr => OpValue::PrintStr
        OpValue::PrintString => OpValue::PrintString
        OpValue::Typeof => OpValue::Typeof
        OpValue::HeapAlloc => OpValue::HeapAlloc
        OpValue::HeapFree => OpValue::HeapFree
        OpValue::Load8 => OpValue::Load8
        OpValue::Load16 => OpValue::Load16
        OpValue::Load32 => OpValue::Load32
        OpValue::Load64 => OpValue::Load64
        OpValue::Store8 => OpValue::Store8
        OpValue::Store16 => OpValue::Store16
        OpValue::Store32 => OpValue::Store32
        OpValue::Store64 => OpValue::Store64
        OpValue::Syscall0 => OpValue::Syscall0
        OpValue::Syscall1 => OpValue::Syscall1
        OpValue::Syscall2 => OpValue::Syscall2
        OpValue::Syscall3 => OpValue::Syscall3
        OpValue::Syscall4 => OpValue::Syscall4
        OpValue::Syscall5 => OpValue::Syscall5
        OpValue::Syscall6 => OpValue::Syscall6
        OpValue::Add => OpValue::Add
        OpValue::Sub => OpValue::Sub
        OpValue::Mul => OpValue::Mul
        OpValue::Div => OpValue::Div
        OpValue::Mod => OpValue::Mod
        OpValue::WrappingAdd => OpValue::WrappingAdd
        OpValue::WrappingMul => OpValue::WrappingMul
        OpValue::WrappingSub => OpValue::WrappingSub
        OpValue::Shl => OpValue::Shl
        OpValue::Shr => OpValue::Shr
        OpValue::BitAnd => OpValue::BitAnd
        OpValue::BitOr => OpValue::BitOr
        OpValue::BitXor => OpValue::BitXor
        OpValue::BitNot => OpValue::BitNot
        OpValue::And => OpValue::And
        OpValue::Or => OpValue::Or
        OpValue::Not => OpValue::Not
        OpValue::Eq => OpValue::Eq
        OpValue::Ge => OpValue::Ge
        OpValue::Gt => OpValue::Gt
        OpValue::Le => OpValue::Le
        OpValue::Lt => OpValue::Lt
        OpValue::Ne => OpValue::Ne
        OpValue::FnExec => OpValue::FnExec
        OpValue::FnExecOwned => OpValue::FnExecOwned
        OpValue::FnReturn => OpValue::FnReturn
        OpValue::UnsafeStart => OpValue::UnsafeStart
        OpValue::UnsafeEnd => OpValue::UnsafeEnd
        OpValue::OwnerCleanup => OpValue::OwnerCleanup
        OpValue::WhileStart => OpValue::WhileStart
        OpValue::WhileCondition => OpValue::WhileCondition
        OpValue::WhileBreak => OpValue::WhileBreak
        OpValue::WhileContinue => OpValue::WhileContinue
        OpValue::WhileEnd => OpValue::WhileEnd
        OpValue::IfStart => OpValue::IfStart
        OpValue::IfCondition => OpValue::IfCondition
        OpValue::IfElif => OpValue::IfElif
        OpValue::IfElse => OpValue::IfElse
        OpValue::IfEnd => OpValue::IfEnd
        OpValue::MatchStart => OpValue::MatchStart
        OpValue::MatchEnd => OpValue::MatchEnd
        OpValue::FloatFromDecimal => OpValue::FloatFromDecimal
        OpValue::FloatSignificand => OpValue::FloatSignificand
        OpValue::FstringToStr => OpValue::FstringToStr
        OpValue::Argc => OpValue::Argc
        OpValue::Argv => OpValue::Argv
        OpValue::Envp => OpValue::Envp
    end
}

pub fn clone_op source_op:$Op -> Op {
    source_op.value clone_op_value
    source_op.call_bindings clone_type_bindings
    source_op.deferred_return_hint.clone
    source_op.type_hint.clone
    source_op.location.clone
    source_op.id
    Op
}

impl Op: std::Clone {
    pub fn clone self:$Op -> Op { self clone_op }
}

pub fn clone_ops ops:$std::List[Op] -> std::List[Op] {
    std::List[Op]::new = result
    for source_op in ops.iter do
        source_op clone_op result.push
    done
    result
}

pub fn clone_type_bindings bindings:$std::Map[std::String Type] -> std::Map[std::String Type] {
    std::Map[std::String Type]::new = cloned
    for pair in bindings.iter do
        pair.second clone_type pair.first.clone cloned.set
    done
    cloned
}

pub fn substituted_constant_value
    name:$std::String
    subs:mut$std::Map[std::String Type]
-> std::Option[OpValue] {
    if name subs.get std::Option::Some(bound) is then
        if bound Type::Const(constant) is then
            if constant.is_symbolic then
                std::Option[OpValue]::None return
            fi
            if constant.typ BuiltinType::Bool == then
                constant.value OpValue::PushBool std::Option::Some return
            fi
            if constant.typ BuiltinType::Char == then
                constant.value OpValue::PushChar std::Option::Some return
            fi
            constant.value make_integer_op_value std::Option::Some return
        fi
    fi
    std::Option[OpValue]::None
}

pub fn substitute_op_value_type
    value:$OpValue
    subs:mut$std::Map[std::String Type]
-> std::Option[OpValue] {
    value match
        OpValue::TypeCast(cast_type) => {
            subs cast_type.substitute_t OpValue::TypeCast std::Option::Some
        }
        OpValue::NumericTry(numeric_try) => {
            numeric_try.target subs numeric_try.source.substitute_t NumericTry
            OpValue::NumericTry std::Option::Some
        }
        OpValue::SizeOf(target) => {
            subs target.substitute_t OpValue::SizeOf std::Option::Some
        }
        OpValue::PtrRead(target) => {
            subs target.substitute_t OpValue::PtrRead std::Option::Some
        }
        OpValue::PtrWrite(target) => {
            subs target.substitute_t OpValue::PtrWrite std::Option::Some
        }
        OpValue::PtrAsRef(target) => {
            subs target.substitute_t OpValue::PtrAsRef std::Option::Some
        }
        OpValue::PtrAsMut(target) => {
            subs target.substitute_t OpValue::PtrAsMut std::Option::Some
        }
        OpValue::DestructionFn(target) => {
            subs target.substitute_t OpValue::DestructionFn std::Option::Some
        }
        OpValue::TraitMethodCall(call) => {
            subs call.substitute OpValue::TraitMethodCall std::Option::Some
        }
        OpValue::TraitMethodRef(call) => {
            subs call.substitute OpValue::TraitMethodRef std::Option::Some
        }
        OpValue::PushVar(name) => subs name substituted_constant_value
        OpValue::PushCapture(name) => subs name substituted_constant_value
        _ => std::Option::None
    end
}

pub fn substitute_ops_types ops:mut$std::List[Op] subs:mut$std::Map[std::String Type] {
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get_mut = sub_op
        subs sub_op.value substitute_op_value_type = replacement
        replacement match
            std::Option::Some(value) => value sub_op Op::set_value
            std::Option::None => {
            }
        end
        if sub_op Op::type_hint std::Option::Some(hint) is then
            subs hint.substitute_t = substituted_hint
            substituted_hint std::Option::Some sub_op Op::set_type_hint
        fi
        if sub_op Op::deferred_return_hint std::Option::Some(deferred_hint) is then
            subs deferred_hint.substitute_t std::Option::Some sub_op Op::set_deferred_return_hint
        fi
        std::Map[std::String Type]::new = substituted_bindings
        for pair in sub_op.call_bindings.iter do
            subs pair.second.substitute_t pair.first.clone substituted_bindings.set
        done
        substituted_bindings = sub_op.call_bindings
        sub_op.value clone_op_value = nested_value
        if nested_value OpValue::PushArray(items) is then
            items clone_ops = owned_items
            subs owned_items substitute_ops_types
            owned_items OpValue::PushArray sub_op Op::set_value
        elif nested_value OpValue::ExprGroup(items) is then
            items clone_ops = owned_items
            subs owned_items substitute_ops_types
            owned_items OpValue::ExprGroup sub_op Op::set_value
        elif nested_value OpValue::InitGlobal(initializer) is then
            initializer.clone = owned_initializer
            subs owned_initializer.ops substitute_ops_types
            owned_initializer OpValue::InitGlobal sub_op Op::set_value
        elif nested_value OpValue::MatchArm(arm) is then
            arm.clone = owned_arm
            subs owned_arm.guard_ops substitute_ops_types
            owned_arm OpValue::MatchArm sub_op Op::set_value
        fi
        1 += op_index
    done
}

