# ============================================================================
# List helpers for variables
# ============================================================================

pub fn variable_list_index vars:$std::List[Variable] name:$str -> i64 {
    0 = index: u64
    while index vars.length > do
        if name index vars.get Variable::name.as_str == then
            index i64::try_from.unwrap return
        fi
        1 += index
    done
    -1
}

pub fn variable_list_contains vars:$std::List[Variable] name:$str -> bool {
    0 name vars variable_list_index >=
}

pub fn string_list_index items:$std::List[std::String] value:$str -> i64 {
    0 = index: u64
    while index items.length > do
        if value index items.get.as_str == then
            index i64::try_from.unwrap return
        fi
        1 += index
    done
    -1
}

pub fn string_list_contains items:$std::List[std::String] value:$str -> bool {
    0 value items string_list_index >=
}

# ============================================================================
# SymbolStore
#
# Shared declaration state threaded through the parser/typechecker/bytecode
# pipeline. Each phase holds a `store: SymbolStore` field on its owning struct
# (Parser, TypeChecker, BytecodeCompiler) and uses its declaration behavior.
#
# Maps and sets are heap-backed in casa, so passing SymbolStore by value
# copies the struct but not the underlying map data — all holders observe
# the same mutations.
# ============================================================================

pub struct SymbolStore {
    pub next_op_id:             i64
    functions:                  std::Map[std::String Function]
    pub variables:              std::Map[std::String Variable]
    pub constants:              std::Map[std::String Constant]
    pub enums:                  std::Map[std::String CasaEnum]
    pub structs:                std::Map[std::String CasaStruct]
    pub traits:                 std::Map[std::String CasaTrait]
    trait_impls:                std::Map[std::String TraitImpl]
    trait_impls_by_receiver:    std::Map[std::String std::List[std::String]]
    trait_impls_by_pair:        std::Map[std::String std::List[std::String]]
    pub builtins:               std::Set[std::String]
    pub copy_types:             std::Map[std::String bool]
    pub borrow_shapes:          std::Map[std::String bool]
    pub op_ownership:           std::Map[i64 OpOwnership]
    pub immutable_globals:      std::Set[std::String]
    pub immutable_global_files: std::Map[std::String std::String]
    pub immutable_global_slots: std::Map[std::String std::String]
    pub public_symbols:         std::Set[std::String]
    pub private_symbols:        std::Set[std::String]
    pub module_private_symbols: std::Set[std::String]
}

fn retain_map_names [V] values:mut$std::Map[std::String V] retained:$std::Set[std::String] {
    values.keys = names
    for name in names.iter do
        if name.as_str retained.has_str ! then
            name.as_str values.delete_str
        fi
    done
}

fn retain_set_names values:mut$std::Set[std::String] retained:$std::Set[std::String] {
    values.to_list = names
    for name in names.iter do
        if name.as_str retained.has_str ! then
            name.as_str values.remove_str
        fi
    done
}

fn clear_map [V] values:mut$std::Map[std::String V] {
    values.keys = names
    for name in names.iter do
        name.as_str values.delete_str
    done
}

fn append_trait_impl_index
    index:mut$std::Map[std::String std::List[std::String]]
    index_key:$str
    impl_name:std::String
{
    index_key index.get_mut_str = impl_names_opt
    impl_names_opt match
        std::Option::Some(impl_names) => impl_name impl_names.push
        std::Option::None => {
            std::List[std::String]::new = impl_names
            impl_name impl_names.push
            impl_names index_key.to_str index.set
        }
    end
}

fn make_trait_impl_receiver_index_key receiver:$Type -> std::String {
    if receiver Type::Function(_) is then
        "function".to_str return
    fi
    receiver.match_base
}

fn make_trait_impl_pair_index_key receiver:$Type trait_name:$str -> std::String {
    receiver make_trait_impl_receiver_index_key = receiver_key
    f"{receiver_key}: {trait_name}"
}

pub struct TraitImplCandidates {
    trait_impls:  $std::Map[std::String TraitImpl]
    index:        $std::Map[std::String std::List[std::String]]
    index_key:    std::String
    impl_index:   u64
    current_name: std::String
}

impl TraitImplCandidates: std::Iterable[$TraitImpl] {
    pub fn next self:mut$TraitImplCandidates -> std::Option[$TraitImpl] {
        self.impl_index = impl_index
        1 += self.impl_index
        if
            self.index_key.as_str self
                .index
                .get_str std::Option::Some(impl_names) is
        then
            if impl_index impl_names.length > then
                impl_index impl_names.get.clone = self.current_name
                self.current_name.as_str self.trait_impls.get_str return
            fi
        fi
        std::Option[$TraitImpl]::None
    }
}

impl SymbolStore {
    pub fn get_function self:$SymbolStore name:$str -> std::Option[$Function] {
        name self.functions.get_str
    }

    pub fn has_function self:$SymbolStore name:$str -> bool { name self.functions.has_str }

    pub fn set_function self:mut$SymbolStore function:Function {
        function.name.clone = name
        function name self.functions.set
    }

    pub fn get_function_names self:$SymbolStore -> std::List[std::String] { self.functions.keys }

    pub fn count_functions self:$SymbolStore -> u64 { self.functions.length }

    # Transfer a definition for mutation while keeping its declaration visible.
    pub fn take_function_for_update self:mut$SymbolStore name:$str -> std::Option[Function] {
        name self.functions.remove_str = function_opt
        if function_opt.is_none then
            std::Option[Function]::None return
        fi
        function_opt.unwrap = function
        function.clone_declaration self.set_function
        function std::Option::Some
    }

    pub fn take_function_for_typecheck self:mut$SymbolStore name:$str -> std::Option[Function] {
        name self.functions.remove_str = function_opt
        if function_opt.is_none then
            std::Option[Function]::None return
        fi
        function_opt.unwrap = function
        true = function.is_typechecked
        function.clone_declaration self.set_function
        function std::Option::Some
    }

    pub fn set_specialized_function self:mut$SymbolStore function:Function {
        true = function.is_resolved
        true = function.is_typechecked
        function self.set_function
    }

    pub fn restore_function self:mut$SymbolStore function:Function { function self.set_function }

    pub fn get_trait_impl self:$SymbolStore name:$str -> std::Option[$TraitImpl] {
        name self.trait_impls.get_str
    }

    pub fn has_trait_impl self:$SymbolStore name:$str -> bool { name self.trait_impls.has_str }

    pub fn get_trait_impl_names self:$SymbolStore -> std::List[std::String] {
        self.trait_impls.keys
    }

    pub fn clone_trait_impls self:$SymbolStore -> std::List[TraitImpl] { self.trait_impls.values }

    # Insertions extend both indexes. Replacements keep the same derived key.
    pub fn set_trait_impl self:mut$SymbolStore trait_impl:TraitImpl {
        trait_impl trait_impl_key = name
        name.as_str self.trait_impls.has_str ! = is_new
        trait_impl.receiver make_trait_impl_receiver_index_key = receiver_key
        trait_impl
            .trait_bound
            .name
            .as_str trait_impl.receiver make_trait_impl_pair_index_key = pair_key
        trait_impl name.clone self.trait_impls.set
        if is_new then
            name.clone receiver_key.as_str self.trait_impls_by_receiver append_trait_impl_index
            name.clone pair_key.as_str self.trait_impls_by_pair append_trait_impl_index
        fi
    }

    pub fn get_trait_impl_candidates_for_receiver
        self:$SymbolStore
        receiver:$Type
    -> TraitImplCandidates {
        receiver make_trait_impl_receiver_index_key = receiver_key
        std::String::new
        0 receiver_key self.trait_impls_by_receiver self.trait_impls TraitImplCandidates
    }

    pub fn get_trait_impl_candidates_for_receiver_and_trait
        self:$SymbolStore
        receiver:$Type
        trait_name:$str
    -> TraitImplCandidates {
        trait_name receiver make_trait_impl_pair_index_key = pair_key
        std::String::new
        0 pair_key self.trait_impls_by_pair self.trait_impls TraitImplCandidates
    }

    fn rebuild_trait_impl_indexes self:mut$SymbolStore {
        self.trait_impls_by_receiver clear_map
        self.trait_impls_by_pair clear_map
        for pair in self.trait_impls.iter do
            pair.second.receiver make_trait_impl_receiver_index_key = receiver_key
            pair
                .second
                .trait_bound
                .name
                .as_str pair.second.receiver make_trait_impl_pair_index_key
            = pair_key
            pair.first.clone receiver_key.as_str self.trait_impls_by_receiver append_trait_impl_index
            pair.first.clone pair_key.as_str self.trait_impls_by_pair append_trait_impl_index
        done
    }

    pub fn retain_declarations self:mut$SymbolStore retained:$std::Set[std::String] {
        retained self.functions retain_map_names
        retained self.variables retain_map_names
        retained self.constants retain_map_names
        retained self.enums retain_map_names
        retained self.structs retain_map_names
        retained self.traits retain_map_names
        retained self.trait_impls retain_map_names
        self.rebuild_trait_impl_indexes
        retained self.immutable_globals retain_set_names
        retained self.immutable_global_files retain_map_names
        retained self.immutable_global_slots retain_map_names
        retained self.public_symbols retain_set_names
        retained self.private_symbols retain_set_names
        retained self.module_private_symbols retain_set_names
    }

    pub fn is_private_from self:$SymbolStore name:$str file:$str -> bool {
        if name self.public_symbols.has_str then
            false return
        fi
        if name self.private_symbols.has_str ! then
            false return
        fi
        if name self.get_function std::Option::Some(function) is then
            file function
                .location
                .file
                .as_str != return
        fi
        if name self.constants.get_str std::Option::Some(constant) is then
            file constant
                .location
                .file
                .as_str != return
        fi
        if name self.structs.get_str std::Option::Some(casa_struct) is then
            file casa_struct
                .location
                .file
                .as_str != return
        fi
        if name self.enums.get_str std::Option::Some(casa_enum) is then
            file casa_enum
                .location
                .file
                .as_str != return
        fi
        if name self.traits.get_str std::Option::Some(casa_trait) is then
            file casa_trait
                .location
                .file
                .as_str != return
        fi
        if name self.immutable_global_files.get_str std::Option::Some(global_file) is then
            file global_file.as_str != return
        fi
        true
    }

    # Move the declaration maps used by editor queries.
    pub fn into_document_facts
        self:SymbolStore
    -> std::Map[std::String Function] std::Map[std::String CasaStruct] std::Map[std::String CasaEnum] std::Map[std::String Variable] {
        self match
            SymbolStore { functions: functions variables: variables enums: enums structs: structs } => functions structs enums variables
        end
    }
}

pub fn symbol_store_new -> SymbolStore {
    std::Set[std::String]::new = builtins
    "i8".to_str builtins.add
    "i16".to_str builtins.add
    "i32".to_str builtins.add
    "i64".to_str builtins.add
    "u8".to_str builtins.add
    "u16".to_str builtins.add
    "u32".to_str builtins.add
    "u64".to_str builtins.add
    "f32".to_str builtins.add
    "f64".to_str builtins.add
    "bool".to_str builtins.add
    "str".to_str builtins.add
    "char".to_str builtins.add
    "cstr".to_str builtins.add
    "ptr".to_str builtins.add
    "array".to_str builtins.add

    std::Set[std::String]::new
    std::Set[std::String]::new
    std::Set[std::String]::new
    std::Map[std::String std::String]::new
    std::Map[std::String std::String]::new
    std::Set[std::String]::new
    std::Map[i64 OpOwnership]::new
    std::Map[std::String bool]::new
    std::Map[std::String bool]::new
    builtins
    std::Map[std::String std::List[std::String]]::new
    std::Map[std::String std::List[std::String]]::new
    std::Map[std::String TraitImpl]::new
    std::Map[std::String CasaTrait]::new
    std::Map[std::String CasaStruct]::new
    std::Map[std::String CasaEnum]::new
    std::Map[std::String Constant]::new
    std::Map[std::String Variable]::new
    std::Map[std::String Function]::new
    1
    SymbolStore
}

pub struct TypeLayout {
    pub size:      u64
    pub alignment: u64
}

pub struct FieldStoragePlan derives std::Clone {
    pub size:          u64
    pub alignment:     u64
    pub offset:        u64
    pub stores_inline: bool
}

pub fn align_up value:u64 alignment:u64 -> u64 { value alignment 1 - + alignment / alignment * }

pub fn builtin_type_layout builtin:$BuiltinType -> TypeLayout {
    builtin match
        BuiltinType::I8 => 1 1 TypeLayout
        BuiltinType::U8 => 1 1 TypeLayout
        BuiltinType::Bool => 1 1 TypeLayout
        BuiltinType::I16 => 2 2 TypeLayout
        BuiltinType::U16 => 2 2 TypeLayout
        BuiltinType::I32 => 4 4 TypeLayout
        BuiltinType::U32 => 4 4 TypeLayout
        BuiltinType::F32 => 4 4 TypeLayout
        BuiltinType::Char => 4 4 TypeLayout
        _ => WORD_SIZE WORD_SIZE TypeLayout
    end
}

fn make_field_storage_plan layout:$TypeLayout offset:u64 stores_inline:bool -> FieldStoragePlan {
    layout.alignment offset align_up = aligned_offset
    stores_inline aligned_offset layout.alignment layout.size FieldStoragePlan
}
# Fixed arrays use their complete direct layout in aggregate fields. Other
# nested aggregates keep the language's one-word indirect representation.
# Generic fields also use one word because their layout is not yet concrete.

fn plan_aggregate_field_storage
    typ:$Type
    offset:u64
    store:$SymbolStore
    visiting:mut$std::Set[std::String]
-> std::Option[FieldStoragePlan] {
    if typ.has_unresolved_type_var then
        WORD_SIZE WORD_SIZE TypeLayout = layout
        false offset layout make_field_storage_plan
        std::Option::Some return
    fi
    if typ get_concrete_array_length.is_some then
        if visiting store typ type_layout std::Option::Some(layout) is then
            true offset layout make_field_storage_plan
            std::Option::Some
        else
            std::Option[FieldStoragePlan]::None
        fi
        return
    fi
    if store typ type_value_representation std::Option::Some(representation) is then
        if VALUE_REPR_INDIRECT representation == then
            WORD_SIZE WORD_SIZE TypeLayout = layout
            false offset layout make_field_storage_plan
            std::Option::Some return
        fi
    fi
    if visiting store typ type_layout std::Option::Some(layout) is then
        true offset layout make_field_storage_plan
        std::Option::Some
    else
        std::Option[FieldStoragePlan]::None
    fi
}

pub fn type_is_extern_struct typ:$Type store:$SymbolStore -> bool {
    if typ Type::Generic(generic) is then
        if 0 generic.params.length != then
            false return
        fi
        if generic.base store.structs.get std::Option::Some(casa_struct) is then
            casa_struct.is_extern return
        fi
    fi
    false
}

fn check_extern_struct_field
    typ:$Type
    store:$SymbolStore
    visiting:mut$std::Set[std::String]
-> bool {
    if typ.is_borrow then
        false return
    fi
    typ match
        Type::Builtin(builtin) => {
            builtin.is_integer
            builtin.is_float ||
            builtin BuiltinType::Bool == ||
            builtin BuiltinType::Ptr == ||
        }
        Type::Generic(generic) => {
            if ARRAY_TYPE generic.base.as_str == then
                if 2 generic.params.length != then
                    false return
                fi
                if typ get_concrete_array_length std::Option::Some(length) is then
                    if 0 length == then
                        false return
                    fi
                    visiting store 0 generic.params.get check_extern_struct_field return
                fi
                false return
            fi
            if store typ type_is_extern_struct ! then
                false return
            fi
            typ.format = type_name
            if type_name visiting.has then
                false return
            fi
            type_name.clone visiting.add
            generic.base store
                .structs
                .get
                .unwrap = casa_struct
            for member in casa_struct.members.iter do
                if visiting store member.typ check_extern_struct_field ! then
                    type_name visiting.remove
                    false return
                fi
            done
            type_name visiting.remove
            true
        }
        _ => false
    end
}

pub fn type_is_extern_struct_field typ:$Type store:$SymbolStore -> bool {
    std::Set[std::String]::new = visiting
    visiting store typ check_extern_struct_field
}

fn plan_struct_field_storage
    typ:$Type
    offset:u64
    casa_struct:$CasaStruct
    store:$SymbolStore
    visiting:mut$std::Set[std::String]
-> std::Option[FieldStoragePlan] {
    if casa_struct.is_extern then
        if visiting store typ type_layout std::Option::Some(layout) is then
            true offset layout make_field_storage_plan
            std::Option::Some
        else
            std::Option[FieldStoragePlan]::None
        fi
    else
        visiting store offset typ plan_aggregate_field_storage
    fi
}

pub fn struct_type_layout
    typ:$Type
    casa_struct:$CasaStruct
    store:$SymbolStore
    visiting:mut$std::Set[std::String]
-> std::Option[TypeLayout] {
    0 = size: u64
    1 = alignment: u64
    for member in casa_struct.members.iter do
        if
            visiting store casa_struct size member.typ plan_struct_field_storage
            std::Option::Some(plan) is
        then
            plan.offset plan.size + = size
            if alignment plan.alignment > then
                plan.alignment = alignment
            fi
        else
            std::Option[TypeLayout]::None return
        fi
    done
    if 0 size == then
        1 = size: u64
    fi
    alignment size align_up = size
    alignment size TypeLayout std::Option::Some
}

pub fn enum_type_layout
    typ:$Type
    casa_enum:$CasaEnum
    store:$SymbolStore
    visiting:mut$std::Set[std::String]
-> std::Option[TypeLayout] {
    WORD_SIZE = size: u64
    WORD_SIZE = alignment: u64
    for pair in casa_enum.variant_types.iter do
        WORD_SIZE = variant_size: u64
        for payload_type in pair.second.iter do
            if
                visiting store variant_size payload_type plan_aggregate_field_storage
                std::Option::Some(plan) is
            then
                plan.offset plan.size + = variant_size
                if alignment plan.alignment > then
                    plan.alignment = alignment
                fi
            else
                std::Option[TypeLayout]::None return
            fi
        done
        if size variant_size > then
            variant_size = size
        fi
    done
    alignment size align_up = size
    alignment size TypeLayout std::Option::Some
}

pub fn plan_struct_member_storage
    casa_struct:$CasaStruct
    member_index:u64
    store:$SymbolStore
-> std::Option[FieldStoragePlan] {
    std::Set[std::String]::new = visiting
    0 = offset: u64
    0 = index: u64
    while index casa_struct.members.length > do
        index casa_struct.members.get = member
        if
            visiting store casa_struct offset member.typ plan_struct_field_storage
            std::Option::Some(plan) is
        then
            if index member_index == then
                plan.clone std::Option::Some return
            fi
            plan.offset plan.size + = offset
        else
            std::Option[FieldStoragePlan]::None return
        fi
        1 += index
    done
    std::Option[FieldStoragePlan]::None
}

pub fn struct_member_offset
    casa_struct:$CasaStruct
    member_index:u64
    store:$SymbolStore
-> std::Option[u64] {
    if store member_index casa_struct plan_struct_member_storage std::Option::Some(plan) is then
        plan.offset std::Option::Some
    else
        std::Option[u64]::None
    fi
}

pub fn plan_enum_payload_storage
    casa_enum:$CasaEnum
    variant_name:$str
    payload_index:u64
    store:$SymbolStore
-> std::Option[FieldStoragePlan] {
    variant_name casa_enum.variant_types.get_str = payload_types_opt
    if payload_types_opt.is_none then
        std::Option[FieldStoragePlan]::None return
    fi
    payload_types_opt.unwrap = payload_types
    std::Set[std::String]::new = visiting
    WORD_SIZE = offset: u64
    0 = index: u64
    while index payload_types.length > do
        index payload_types.get = payload_type
        if
            visiting store offset payload_type plan_aggregate_field_storage
            std::Option::Some(plan) is
        then
            if index payload_index == then
                plan.clone std::Option::Some return
            fi
            plan.offset plan.size + = offset
        else
            std::Option[FieldStoragePlan]::None return
        fi
        1 += index
    done
    std::Option[FieldStoragePlan]::None
}

pub fn array_type_layout
    typ:$Type
    generic:$GenericType
    store:$SymbolStore
    visiting:mut$std::Set[std::String]
-> std::Option[TypeLayout] {
    if 2 generic.params.length != then
        std::Option[TypeLayout]::None return
    fi
    if typ get_concrete_array_length std::Option::Some(length) is then
        if visiting store 0 generic.params.get type_layout std::Option::Some(element) is then
            if 0 length == then
                1 1 TypeLayout std::Option::Some
            else
                element.alignment length element.size * TypeLayout std::Option::Some
            fi
            return
        fi
    fi
    std::Option[TypeLayout]::None
}

pub fn type_layout
    typ:$Type
    store:$SymbolStore
    visiting:mut$std::Set[std::String]
-> std::Option[TypeLayout] {
    if typ.is_borrow then
        WORD_SIZE WORD_SIZE TypeLayout std::Option::Some return
    fi
    typ match
        Type::Builtin(builtin) => {
            builtin builtin_type_layout std::Option::Some
        }
        Type::Function => {
            WORD_SIZE WORD_SIZE TypeLayout std::Option::Some
        }
        Type::Generic(generic) => {
            if ARRAY_TYPE generic.base.as_str == then
                visiting store generic typ array_type_layout return
            fi
            typ.format = type_name
            if type_name visiting.has then
                WORD_SIZE WORD_SIZE TypeLayout std::Option::Some return
            fi
            type_name.clone visiting.add
            std::Option[TypeLayout]::None = result
            if generic.base store.structs.get std::Option::Some(casa_struct) is then
                visiting store casa_struct typ struct_type_layout = result
            elif generic.base store.enums.get std::Option::Some(casa_enum) is then
                visiting store casa_enum typ enum_type_layout = result
            fi
            type_name visiting.remove
            result
        }
        _ => {
            std::Option[TypeLayout]::None
        }
    end
}

pub fn type_inline_size typ:$Type store:$SymbolStore -> std::Option[u64] {
    std::Set[std::String]::new = visiting
    if visiting store typ type_layout std::Option::Some(layout) is then
        layout.size std::Option::Some
    else
        std::Option[u64]::None
    fi
}

pub fn type_value_representation typ:$Type store:$SymbolStore -> std::Option[u64] {
    if typ.is_borrow then
        VALUE_REPR_RAW u64::try_from.unwrap std::Option::Some return
    fi
    typ match
        Type::Builtin(builtin) => {
            if builtin.is_integer builtin.is_unsigned ! && then
                VALUE_REPR_SIGNED u64::try_from.unwrap std::Option::Some
            else
                VALUE_REPR_RAW u64::try_from.unwrap std::Option::Some
            fi
        }
        Type::Function => {
            VALUE_REPR_RAW u64::try_from.unwrap std::Option::Some
        }
        Type::Generic(generic) => {
            if ARRAY_TYPE generic.base.as_str == generic.base store.structs.has || then
                VALUE_REPR_INDIRECT u64::try_from.unwrap std::Option::Some
            elif generic.base store.enums.get std::Option::Some(casa_enum) is then
                if casa_enum has_inner_values then
                    VALUE_REPR_INDIRECT u64::try_from.unwrap std::Option::Some
                else
                    VALUE_REPR_RAW u64::try_from.unwrap std::Option::Some
                fi
            else
                std::Option[u64]::None
            fi
        }
        _ => {
            std::Option[u64]::None
        }
    end
}

pub fn aggregate_type_bindings
    typ:$Type
    type_vars:$std::List[std::String]
-> std::Map[std::String Type] {
    std::Map[std::String Type]::new = bindings
    if typ.type_params std::Option::Some(type_params) is then
        for pair in type_params.iter type_vars.iter.zip do
            pair.second.clone pair.first.clone bindings.set
        done
    fi
    bindings
}

pub fn type_needs_destruction_in_store typ:$Type store:$SymbolStore -> bool {
    if typ.is_borrow then
        false return
    fi
    if typ Type::TypeVar is then
        true return
    fi
    if typ Type::Function(_) is then
        true return
    fi
    if store typ find_drop_function_name.is_some then
        true return
    fi
    if store typ type_value_representation std::Option::Some(representation) is then
        VALUE_REPR_INDIRECT representation == return
    fi
    false
}
# Return the exact drop hook for a concrete receiver. A generic receiver hook
# is the fallback for types without a concrete hook.
pub fn find_drop_function_name typ:$Type store:$SymbolStore -> std::Option[std::String] {
    f"{typ.format}::drop" = exact_name
    if exact_name.as_str store.get_function std::Option::Some(function) is then
        function.name.clone std::Option::Some return
    fi
    f"{typ.match_base}::drop" = base_name
    if base_name.as_str store.get_function std::Option::Some(function) is then
        function.name.clone std::Option::Some return
    fi
    std::Option[std::String]::None
}
