    pub fn eq self:$Type other:$Type -> bool {
        self match
            Type::Unknown => {
                if other Type::Unknown is then true else false fi
            }
            Type::Builtin(b_self) => {
                if other Type::Builtin(b_other) is then b_other b_self == else false fi
            }
            Type::TypeVar(n_self) => {
                if other Type::TypeVar(n_other) is then n_other n_self == else false fi
            }
            Type::Const(c_self) => {
                if other Type::Const(c_other) is then
                    c_other.name c_self.name ==
                    c_other.typ c_self.typ == &&
                    c_other.value c_self.value == &&
                else
                    false
                fi
            }
            Type::Generic(g_self) => {
                if other Type::Generic(g_other) is then
                    if g_other.data g_self.data == then
                        true return
                    fi
                    if g_other.base g_self.base != then
                        false return
                    fi
                    if g_other.params.length g_self.params.length != then
                        false return
                    fi
                    for
                        pair in g_other.params.iter g_self
                            .params
                            .iter
                            .zip
                    do
                        if pair.second pair.first.eq ! then
                            false return
                        fi
                    done
                    true
                else
                    false
                fi
            }
            Type::Function(f_self) => {
                if other Type::Function(f_other) is then
                    if f_other.parameters.length f_self.parameters.length != then
                        false return
                    fi
                    if f_other.return_types.length f_self.return_types.length != then
                        false return
                    fi
                    for
                        pair in f_other.parameters.iter f_self
                            .parameters
                            .iter
                            .zip
                    do
                        if pair.second pair.first.eq ! then
                            false return
                        fi
                    done
                    for
                        pair in f_other.return_types.iter f_self
                            .return_types
                            .iter
                            .zip
                    do
                        if pair.second pair.first.eq ! then
                            false return
                        fi
                    done
                    true
                else
                    false
                fi
            }
        end
    }
}

pub fn string_list_to_set items:$std::List[std::String] -> std::Set[std::String] {
