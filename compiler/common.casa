impl KeywordKind {
    fn format_source self:$KeywordKind -> str {
        self match
            KeywordKind::Unsafe => "unsafe"
            KeywordKind::Fn => "fn"
            KeywordKind::Impl => "impl"
            KeywordKind::Return => "return"
            KeywordKind::While => "while"
            KeywordKind::Do => "do"
            KeywordKind::Break => "break"
            KeywordKind::Continue => "continue"
            KeywordKind::Done => "done"
            KeywordKind::If => "if"
            KeywordKind::Then => "then"
            KeywordKind::Elif => "elif"
            KeywordKind::Else => "else"
            KeywordKind::Fi => "fi"
            KeywordKind::EnumKw => "enum"
            KeywordKind::StructKw => "struct"
            KeywordKind::TraitKw => "trait"
            KeywordKind::End => "end"
            KeywordKind::Match => "match"
            KeywordKind::Is => "is"
            KeywordKind::Import => "import"
            KeywordKind::For => "for"
            KeywordKind::In => "in"
            KeywordKind::Global => "global"
            KeywordKind::Const => "const"
        end
    }
}

fn build_keyword_lookup -> Map[str KeywordKind] {
    Map[str KeywordKind]::new = lookup
    0 (u64) = keyword_index
    while keyword_index KeywordKind > do
        keyword_index (KeywordKind) = keyword
        keyword.format_source = source
        keyword source lookup.set = lookup
        1 += keyword_index
    done
    lookup
}
build_keyword_lookup = KEYWORD_MAP

fn keyword_from_str value:$str -> Option[KeywordKind] {
    value KEYWORD_MAP.get
}

impl IntrinsicKind {
    fn format_source self:$IntrinsicKind -> str {
        self match
            IntrinsicKind::Drop => "drop"
            IntrinsicKind::Dup => "dup"
            IntrinsicKind::Copy => "copy"
            IntrinsicKind::Over => "over"
            IntrinsicKind::Rot => "rot"
            IntrinsicKind::Swap => "swap"
            IntrinsicKind::Alloc => "alloc"
            IntrinsicKind::Free => "free"
            IntrinsicKind::Load8 => "load8"
            IntrinsicKind::Load16 => "load16"
            IntrinsicKind::Load32 => "load32"
            IntrinsicKind::Load64 => "load64"
            IntrinsicKind::Store8 => "store8"
            IntrinsicKind::Store16 => "store16"
            IntrinsicKind::Store32 => "store32"
            IntrinsicKind::Store64 => "store64"
            IntrinsicKind::Print => "print"
            IntrinsicKind::Typeof => "typeof"
            IntrinsicKind::Exec => "exec"
            IntrinsicKind::Syscall0 => "syscall0"
            IntrinsicKind::Syscall1 => "syscall1"
            IntrinsicKind::Syscall2 => "syscall2"
            IntrinsicKind::Syscall3 => "syscall3"
            IntrinsicKind::Syscall4 => "syscall4"
            IntrinsicKind::Syscall5 => "syscall5"
            IntrinsicKind::Syscall6 => "syscall6"
            IntrinsicKind::Argc => "argc"
            IntrinsicKind::Argv => "argv"
            IntrinsicKind::Envp => "envp"
        end
    }
}

fn build_intrinsic_lookup -> Map[str IntrinsicKind] {
    Map[str IntrinsicKind]::new = lookup
    0 (u64) = intrinsic_index
    while intrinsic_index IntrinsicKind > do
        intrinsic_index (IntrinsicKind) = intrinsic
        intrinsic.format_source = source
        intrinsic source lookup.set = lookup
        1 += intrinsic_index
    done
    IntrinsicKind::Print "print_int" lookup.set = lookup
    IntrinsicKind::Print "print_str" lookup.set = lookup
    IntrinsicKind::Print "print_bool" lookup.set = lookup
    IntrinsicKind::Print "print_char" lookup.set = lookup
    IntrinsicKind::Print "print_cstr" lookup.set = lookup
    lookup
}
build_intrinsic_lookup = INTRINSIC_MAP

fn intrinsic_from_str value:$str -> Option[IntrinsicKind] {
    value INTRINSIC_MAP.get
}
Map[str OperatorKind]::new = OPERATOR_MAP
OperatorKind::Plus "+" OPERATOR_MAP.set = OPERATOR_MAP
OperatorKind::Minus "-" OPERATOR_MAP.set = OPERATOR_MAP
OperatorKind::Mul "*" OPERATOR_MAP.set = OPERATOR_MAP
OperatorKind::Div "/" OPERATOR_MAP.set = OPERATOR_MAP
