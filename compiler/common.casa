}

pub fn clone_constant_value value:$ConstantValue -> ConstantValue {
    value match
        ConstantValue::Int(literal) => literal.value literal.raw.clone IntegerLiteral::new ConstantValue::Int
        ConstantValue::Float(text) => text.clone ConstantValue::Float
        ConstantValue::Str(text) => text.clone ConstantValue::Str
        ConstantValue::Bool(boolean) => boolean ConstantValue::Bool
        ConstantValue::Char(character) => character ConstantValue::Char
    end
}

impl ConstantValue: std::Clone {
    pub fn clone self:$ConstantValue -> ConstantValue { self clone_constant_value }
}

pub enum StaticArrayElement {
    Imm (i64)
    Label (std::String)
}

impl StaticArrayElement: std::Clone {
    pub fn clone self:$StaticArrayElement -> StaticArrayElement {
        self match
            StaticArrayElement::Imm(value) => value StaticArrayElement::Imm
            StaticArrayElement::Label(label) => label.clone StaticArrayElement::Label
        end
    }
}

pub struct StaticArray {
    pub elements: std::List[StaticArrayElement]
}

pub struct StaticStruct {
    pub fields: std::List[StaticArrayElement]
}

impl StaticArray: std::Clone {
    pub fn clone self:$StaticArray -> StaticArray {
        std::List[StaticArrayElement]::new = elements
        for element in self.elements.iter do
            element.clone elements.push
        done
        elements StaticArray
    }
}

impl StaticStruct: std::Clone {
    pub fn clone self:$StaticStruct -> StaticStruct {
        std::List[StaticArrayElement]::new = fields
        for field in self.fields.iter do
            field.clone fields.push
        done
        fields StaticStruct
    }
}

pub struct Constant {
    pub name:     std::String
    pub value:    ConstantValue
    pub location: Location
}

impl Constant: std::Clone {
    pub fn clone self:$Constant -> Constant {
        self.location.clone self.value clone_constant_value self.name.clone Constant
    }
}

pub struct Variable {
    pub name: std::String
    pub typ:  Type
}

impl Variable {
    pub fn new name:$str -> Variable { Type::Unknown name.to_str Variable }
}

pub fn clone_variable variable:$Variable -> Variable {
    variable.typ clone_type variable.name.clone Variable
}

impl Variable: std::Clone {
    pub fn clone self:$Variable -> Variable { self clone_variable }
}

pub enum ResolvedVariable {
    Local (u64)
    Global (u64)
}

impl ResolvedVariable {
    pub fn emit_get self:mut$ResolvedVariable bytecode:mut$std::List[InstValue] {
        self match
            ResolvedVariable::Local(local_index) => {
                local_index InstValue::LocalGet bytecode.push
            }
            ResolvedVariable::Global(global_index) => {
                global_index InstValue::GlobalGet bytecode.push
            }
        end
    }

    pub fn emit_set self:mut$ResolvedVariable bytecode:mut$std::List[InstValue] {
        self match
            ResolvedVariable::Local(local_index) => {
                local_index InstValue::LocalSet bytecode.push
            }
            ResolvedVariable::Global(global_index) => {
                global_index InstValue::GlobalSet bytecode.push
            }
        end
    }
}

pub struct Member {
