pub fn intrinsic_to_op_value intrinsic_kind:IntrinsicKind -> std::Option[OpValue] {
    intrinsic_kind match
        IntrinsicKind::Alloc => OpValue::HeapAlloc std::Option::Some
        IntrinsicKind::Free => OpValue::HeapFree std::Option::Some
        IntrinsicKind::Drop => OpValue::Drop std::Option::Some
        IntrinsicKind::Dup => OpValue::Dup std::Option::Some
        IntrinsicKind::Copy => OpValue::Copy std::Option::Some
        IntrinsicKind::Exec => OpValue::FnExec std::Option::Some
        IntrinsicKind::Load8 => OpValue::Load8 std::Option::Some
        IntrinsicKind::Load16 => OpValue::Load16 std::Option::Some
        IntrinsicKind::Load32 => OpValue::Load32 std::Option::Some
        IntrinsicKind::Load64 => OpValue::Load64 std::Option::Some
        IntrinsicKind::Over => OpValue::Over std::Option::Some
        IntrinsicKind::Print => OpValue::Print std::Option::Some
        IntrinsicKind::Rot => OpValue::Rot std::Option::Some
        IntrinsicKind::Store8 => OpValue::Store8 std::Option::Some
        IntrinsicKind::Store16 => OpValue::Store16 std::Option::Some
        IntrinsicKind::Store32 => OpValue::Store32 std::Option::Some
        IntrinsicKind::Store64 => OpValue::Store64 std::Option::Some
        IntrinsicKind::Swap => OpValue::Swap std::Option::Some
        IntrinsicKind::Typeof => OpValue::Typeof std::Option::Some
        IntrinsicKind::SizeOf => std::Option[OpValue]::None
        IntrinsicKind::Syscall0 => OpValue::Syscall0 std::Option::Some
        IntrinsicKind::Syscall1 => OpValue::Syscall1 std::Option::Some
        IntrinsicKind::Syscall2 => OpValue::Syscall2 std::Option::Some
        IntrinsicKind::Syscall3 => OpValue::Syscall3 std::Option::Some
        IntrinsicKind::Syscall4 => OpValue::Syscall4 std::Option::Some
        IntrinsicKind::Syscall5 => OpValue::Syscall5 std::Option::Some
        IntrinsicKind::Syscall6 => OpValue::Syscall6 std::Option::Some
        IntrinsicKind::Argc => OpValue::Argc std::Option::Some
        IntrinsicKind::Argv => OpValue::Argv std::Option::Some
        IntrinsicKind::Envp => OpValue::Envp std::Option::Some
    end
}

