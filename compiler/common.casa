                type_vars owned_items canonicalize_operation_type_vars
                owned_items OpValue::ExprGroup op Op::set_value
            }
            OpValue::InitGlobal(initializer) => {
                initializer.clone = owned_initializer
                type_vars owned_initializer.ops canonicalize_operation_type_vars
