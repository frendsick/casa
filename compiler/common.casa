# ============================================================================
# Type AST
# ============================================================================

pub enum BuiltinType derives std::Eq std::Copy {
    I8
    I16
    I32
    I64
    U8
    U16
    U32
    U64
    F32
    F64
    Bool
    Char
    Cstr
    Str
    Ptr
}

impl BuiltinType {
    pub fn format self:$BuiltinType -> str {
        self match
            BuiltinType::I8 => {
                "i8"
            }
            BuiltinType::I16 => {
                "i16"
            }
            BuiltinType::I32 => {
                "i32"
            }
            BuiltinType::I64 => {
                "i64"
            }
            BuiltinType::U8 => {
                "u8"
            }
            BuiltinType::U16 => {
                "u16"
            }
            BuiltinType::U32 => {
                "u32"
            }
            BuiltinType::U64 => {
                "u64"
            }
            BuiltinType::F32 => {
                "f32"
            }
            BuiltinType::F64 => {
                "f64"
            }
            BuiltinType::Bool => {
                "bool"
            }
            BuiltinType::Char => {
                "char"
            }
            BuiltinType::Cstr => {
                "cstr"
            }
            BuiltinType::Str => {
                "str"
            }
            BuiltinType::Ptr => {
                "ptr"
            }
        end
    }

    pub fn is_integer self:$BuiltinType -> bool {
        self match
            BuiltinType::I8 => true
            BuiltinType::I16 => true
            BuiltinType::I32 => true
            BuiltinType::I64 => true
            BuiltinType::U8 => true
            BuiltinType::U16 => true
            BuiltinType::U32 => true
            BuiltinType::U64 => true
            _ => false
        end
    }

    pub fn is_unsigned self:$BuiltinType -> bool {
        self match
            BuiltinType::U8 => true
            BuiltinType::U16 => true
            BuiltinType::U32 => true
            BuiltinType::U64 => true
            _ => false
        end
    }

    pub fn is_float self:$BuiltinType -> bool {
        self BuiltinType::F32 == self BuiltinType::F64 == ||
    }

    pub fn bit_width self:$BuiltinType -> i64 {
        self match
            BuiltinType::I8 => 8
            BuiltinType::U8 => 8
            BuiltinType::I16 => 16
            BuiltinType::U16 => 16
            BuiltinType::I32 => 32
            BuiltinType::U32 => 32
            _ => 64
        end
    }
}

pub fn parse_builtin source:$str -> std::Option[BuiltinType] {
    if "i8" source.as_str == then
        BuiltinType::I8 std::Option::Some return
    fi
    if "i16" source.as_str == then
        BuiltinType::I16 std::Option::Some return
    fi
    if "i32" source.as_str == then
        BuiltinType::I32 std::Option::Some return
    fi
    if "i64" source.as_str == then
        BuiltinType::I64 std::Option::Some return
    fi
    if "u8" source.as_str == then
        BuiltinType::U8 std::Option::Some return
    fi
    if "u16" source.as_str == then
        BuiltinType::U16 std::Option::Some return
    fi
    if "u32" source.as_str == then
        BuiltinType::U32 std::Option::Some return
    fi
    if "u64" source.as_str == then
        BuiltinType::U64 std::Option::Some return
    fi
    if "f32" source.as_str == then
        BuiltinType::F32 std::Option::Some return
    fi
    if "f64" source.as_str == then
        BuiltinType::F64 std::Option::Some return
    fi
    if "bool" source.as_str == then
        BuiltinType::Bool std::Option::Some return
    fi
    if "char" source.as_str == then
        BuiltinType::Char std::Option::Some return
    fi
    if "cstr" source.as_str == then
        BuiltinType::Cstr std::Option::Some return
    fi
    if "str" source.as_str == then
        BuiltinType::Str std::Option::Some return
    fi
    if "ptr" source.as_str == then
        BuiltinType::Ptr std::Option::Some return
    fi
    std::Option::None
}

pub struct GenericType {
    pub base:   std::String
    pub params: std::List[Type]
}

impl GenericType {
    pub fn new name:std::String -> GenericType { std::List[Type]::new name GenericType }
}

pub struct FunctionType {
    pub parameters:   std::List[Type]
    pub return_types: std::List[Type]
}

# A compile-time constant in a type-parameter slot (ADR-0152, ADR-0153).
# Symbolic: `name` set (e.g. `N`), `value` unused. Concrete: `name` empty,
# `value` holds the constant (integer verbatim, `bool` as 0/1, `char` as
# codepoint). Float and `str` are rejected before a ConstType exists.

pub struct ConstType {
    pub name:  std::String
    pub typ:   BuiltinType
    pub value: i64
}

impl ConstType {
    pub fn symbolic name:std::String typ:BuiltinType -> ConstType { 0 typ name ConstType }

    pub fn concrete value:i64 typ:BuiltinType -> ConstType { value typ "".to_str ConstType }

    pub fn is_symbolic self:$ConstType -> bool { 0 self.name.length != }

    # Does this concrete argument fit a `const` parameter of `expected_typ`
    # (ADR-0153)? Integer arguments are contextual (fit any width whose range
    # holds them); `bool` and `char` require the same kind.
    pub fn fits_parameter self:$ConstType expected_typ:BuiltinType -> bool {
        if expected_typ.is_integer then
            if self.typ.is_integer ! then
                false return
            fi
            self.value IntegerLiteral::from_int = literal
            expected_typ Type::Builtin literal.fits return
        fi
        if expected_typ BuiltinType::Bool == then
            self.typ BuiltinType::Bool == return
        fi
        if expected_typ BuiltinType::Char == then
            self.typ BuiltinType::Char == return
        fi
        false
    }
}

pub enum Type {
    Unknown
    Builtin (BuiltinType)
    Generic (GenericType)
    Function (FunctionType)
    TypeVar (std::String)
    Const (ConstType)
}

# Build the type of an `array[T N]` value: element type plus its length as a
# concrete constant type parameter (ADR-0152).

pub fn make_array_type element:Type length:u64 -> Type {
    std::List[Type]::new = parameters
    element parameters.push
    BuiltinType::U64 length i64::try_from.unwrap ConstType::concrete Type::Const parameters.push
    parameters ARRAY_TYPE.to_str GenericType Type::Generic
}
# Bytes an `array[T N]` value occupies. A zero-length array keeps the one-byte
# minimum every inhabited type has (ADR-0132, ADR-0155).

pub fn get_array_storage_size length:u64 element_size:u64 -> u64 {
    if 0 length == then
        1 return
    fi
    length element_size *
}

pub fn get_array_length_parameter array_type:$Type -> std::Option[ConstType] {
    if array_type Type::Generic(generic) is then
        if ARRAY_TYPE generic.base.as_str != 2 generic.params.length != || then
            std::Option[ConstType]::None return
        fi
        if 1 generic.params.get Type::Const(length) is then
            length.value length.typ length.name.clone ConstType std::Option::Some return
        fi
    fi
    std::Option[ConstType]::None
}
# The concrete length of an `array[T N]` type, or None when the type is not an
# array or its length is symbolic.

pub fn get_concrete_array_length array_type:$Type -> std::Option[u64] {
    if array_type get_array_length_parameter std::Option::Some(length) is then
        if length.is_symbolic ! then
            length.value u64::try_from.unwrap std::Option::Some return
        fi
    fi
    std::Option[u64]::None
}

pub fn parse_generic_params source:$str -> std::List[Type] {
    std::List[Type]::new = params
    for token in source split_type_tokens.iter do
        token.as_str parse_type_str params.push
    done
    params
}

pub fn apply_borrow_type target:Type prefix:$str -> Type {
    if "" prefix == then
        target return
    fi
    if target.borrow_target std::Option::Some(borrowed_target) is then
        if SHARED_BORROW_TYPE prefix == target.is_shared_borrow || then
            SHARED_BORROW_TYPE borrowed_target clone_type apply_borrow_type return
        fi
        EXCLUSIVE_BORROW_TYPE borrowed_target clone_type apply_borrow_type return
    fi
    std::List[Type]::new = parameters
    target parameters.push
    parameters prefix.to_str GenericType Type::Generic
}

impl Type {
    pub fn array_element_type self:$Type -> std::Option[Type] {
        if self Type::Generic(generic) is then
            if ARRAY_TYPE generic.base.as_str == 2 generic.params.length == && then
                0 generic.params.get clone_type std::Option::Some return
            fi
        fi
        std::Option[Type]::None
    }

    pub fn borrow_target self:$Type -> std::Option[Type] {
        if self Type::Generic(generic) is then
            if
                generic.base.as_str SHARED_BORROW_TYPE ==
                generic.base.as_str EXCLUSIVE_BORROW_TYPE == ||
                generic.params.length 1 == &&
            then
                0 generic.params.get clone_type std::Option::Some return
            fi
        fi
        std::Option[Type]::None
    }

    pub fn is_shared_borrow self:$Type -> bool {
        if self Type::Generic(generic) is then
            generic.base.as_str SHARED_BORROW_TYPE == 1 generic.params.length == && return
        fi
        false
    }

    pub fn is_exclusive_borrow self:$Type -> bool {
        if self Type::Generic(generic) is then
            generic.base.as_str EXCLUSIVE_BORROW_TYPE == 1 generic.params.length == && return
        fi
        false
    }

    pub fn is_borrow self:$Type -> bool { self.is_shared_borrow self.is_exclusive_borrow || }

    pub fn get_integer_min self:$Type -> str {
        self match
            Type::Builtin(builtin) => {
                builtin match
                    BuiltinType::I8 => "-128"
                    BuiltinType::I16 => "-32768"
                    BuiltinType::I32 => "-2147483648"
                    BuiltinType::I64 => "-9223372036854775808"
                    _ => "0"
                end
            }
            _ => "0"
        end
    }

    pub fn get_integer_max self:$Type -> str {
        self match
            Type::Builtin(builtin) => {
                builtin match
                    BuiltinType::I8 => "127"
                    BuiltinType::I16 => "32767"
                    BuiltinType::I32 => "2147483647"
                    BuiltinType::I64 => "9223372036854775807"
                    BuiltinType::U8 => "255"
                    BuiltinType::U16 => "65535"
                    BuiltinType::U32 => "4294967295"
                    BuiltinType::U64 => "18446744073709551615"
                    _ => "0"
                end
            }
            _ => "0"
        end
    }

    pub fn format self:$Type -> std::String {
        self match
            Type::Unknown => {
                "".to_str
            }
            Type::Builtin(builtin) => {
                builtin.format.to_str
            }
            Type::TypeVar(name) => {
                name.clone
            }
            Type::Const(const_type) => {
                if const_type.is_symbolic then
                    const_type.name.clone
                elif const_type.typ BuiltinType::Bool == then
                    if 0 const_type.value != then
                        "true".to_str
                    else
                        "false".to_str
                    fi
                else
                    const_type.value.to_str
                fi
            }
            Type::Generic(generic) => {
                if generic.base.as_str SHARED_BORROW_TYPE == 1 generic.params.length == && then
                    f"${0 generic
                        .params
                        .get
                        .format}" return
                fi
                if generic.base.as_str EXCLUSIVE_BORROW_TYPE == 1 generic.params.length == && then
                    f"mut${0 generic
                        .params
                        .get
                        .format}" return
                fi
                if 0 generic.params.length == then
                    generic.base.clone return
                fi
                std::List[std::String]::new = param_strs
                for elem in generic.params.iter do
                    elem.format param_strs.push
                done
                " " param_strs.join_strings = params_str
                f"{generic.base}[{params_str}]"
            }
            Type::Function(fn_type) => {
                if 0 fn_type.parameters.length == 0 fn_type.return_types.length == && then
                    "fn".to_str return
                fi
                std::String::new = builder
                "fn[" builder.append
                if 0 fn_type.parameters.length != then
                    std::List[std::String]::new = fn_param_strs
                    for elem in fn_type.parameters.iter do
                        elem.format fn_param_strs.push
                    done
                    " " fn_param_strs.join_strings builder.append_string
                fi
                if 0 fn_type.return_types.length != then
                    if 0 fn_type.parameters.length != then
                        " " builder.append
                    fi
                    "->" builder.append
                    for return_type in fn_type.return_types.iter do
                        " " builder.append
                        return_type.format builder.append_string
                    done
                fi
                "]" builder.append
                builder
            }
        end
    }

    pub fn base self:$Type -> std::Option[std::String] {
        self match
            Type::Generic(generic) => {
                if 0 generic.params.length == then
                    std::Option::None
                else
                    generic.base.clone std::Option::Some
                fi
            }
            _ => {
                std::Option::None
            }
        end
    }

    pub fn type_params self:$Type -> std::Option[$std::List[Type]] {
        if self Type::Generic(generic) is then
            if 0 generic.params.length != then
                generic.params std::Option[$std::List[Type]]::Some return
            fi
        fi
        std::Option::None
    }

    pub fn as_generic self:$Type -> std::Option[$GenericType] {
        if self Type::Generic(generic) is then
            if 0 generic.params.length != then
                generic std::Option[$GenericType]::Some return
            fi
        fi
        std::Option::None
    }

    pub fn substitute_t self:$Type bindings:$std::Map[std::String Type] -> Type {
        self match
            Type::Unknown => {
                Type::Unknown
            }
            Type::Builtin(builtin) => {
                builtin (BuiltinType) Type::Builtin
            }
            Type::TypeVar(name) => {
                if name bindings.get std::Option::Some(bound) is then
                    bound clone_type
                else
                    name.clone Type::TypeVar
                fi
            }
            Type::Const(const_type) => {
                if const_type.is_symbolic then
                    if const_type.name bindings.get std::Option::Some(bound) is then
                        bound clone_type
                    else
                        self clone_type
                    fi
                else
                    self clone_type
                fi
            }
            Type::Generic(generic) => {
                generic.base = base: $std::String
                if 0 generic.params.length == then
                    if base.as_str bindings.get_str std::Option::Some(bound) is then
                        bound clone_type return
                    fi
                    std::List[Type]::new base.clone GenericType Type::Generic return
                fi
                std::List[Type]::new = new_params
                for param in generic.params.iter do
                    bindings param.substitute_t new_params.push
                done
                if
                    base.as_str SHARED_BORROW_TYPE ==
                    base.as_str EXCLUSIVE_BORROW_TYPE == ||
                    1 new_params.length == &&
                then
                    base.as_str new_params.pop apply_borrow_type return
                fi
                new_params base.clone GenericType Type::Generic
            }
            Type::Function(fn_type) => {
                std::List[Type]::new = new_params
                for param in fn_type.parameters.iter do
                    bindings param.substitute_t new_params.push
                done
                std::List[Type]::new = new_returns
                for ret in fn_type.return_types.iter do
                    bindings ret.substitute_t new_returns.push
                done
                new_returns new_params FunctionType Type::Function
            }
        end
    }

    pub fn is_unknown self:$Type -> bool {
        self match
            Type::Unknown => {
                true
            }
            _ => {
                false
            }
        end
    }

    pub fn type_var_name self:$Type -> std::Option[std::String] {
        self match
            Type::TypeVar(name) => {
                name.clone std::Option::Some
            }
            _ => {
                std::Option::None
            }
        end
    }

    pub fn has_unresolved_type_var self:$Type -> bool {
        self match
            Type::TypeVar(_) => {
                true
            }
            Type::Const(const_type) => {
                const_type.is_symbolic
            }
            Type::Generic(generic) => {
                for param in generic.params.iter do
                    if param.has_unresolved_type_var then
                        true return
                    fi
                done
                false
            }
            Type::Function(fn_type) => {
                for param in fn_type.parameters.iter do
                    if param.has_unresolved_type_var then
                        true return
                    fi
                done
                for ret in fn_type.return_types.iter do
                    if ret.has_unresolved_type_var then
                        true return
                    fi
                done
                false
            }
            _ => {
                false
            }
        end
    }

    pub fn is_unknown_placeholder self:$Type -> bool {
        self match
            Type::Unknown => {
                true
            }
            Type::Generic(generic) => {
                0 generic.params.length == TYPE_UNKNOWN generic.base.as_str == &&
            }
            _ => {
                false
            }
        end
    }

    pub fn type_contains_var self:$Type type_var:$str -> bool {
        self match
            Type::TypeVar(name) => {
                name.as_str type_var ==
            }
            Type::Const(const_type) => {
                const_type.is_symbolic const_type.name.as_str type_var == &&
            }
            Type::Generic(generic) => {
                for param in generic.params.iter do
                    if type_var param.type_contains_var then
                        true return
                    fi
                done
                false
            }
            Type::Function(fn_type) => {
                for param in fn_type.parameters.iter do
                    if type_var param.type_contains_var then
                        true return
                    fi
                done
                for ret in fn_type.return_types.iter do
                    if type_var ret.type_contains_var then
                        true return
                    fi
                done
                false
            }
            _ => {
                false
            }
        end
    }

    pub fn is_fn_type_t self:$Type -> bool {
        self match
            Type::Function(_) => {
                true
            }
            _ => {
                false
            }
        end
    }

    pub fn is_builtin_type_t self:$Type -> bool {
        self match
            Type::Builtin(_) => {
                true
            }
            Type::Generic(generic) => {
                0 generic.params.length == "array" generic.base.as_str == &&
            }
            _ => {
                false
            }
        end
    }

    pub fn is_primitive_compare_type_t self:$Type -> bool {
        self match
            Type::Builtin(builtin) => {
                builtin.is_integer
                builtin.is_float ||
                builtin BuiltinType::Bool == ||
                builtin BuiltinType::Char == ||
                builtin BuiltinType::Ptr == ||
            }
            _ => {
                false
            }
        end
    }

    pub fn is_integer_type_t self:$Type -> bool {
        if self Type::Builtin(builtin) is then
            builtin.is_integer return
        fi
        false
    }

    pub fn is_float_type_t self:$Type -> bool {
        if self Type::Builtin(builtin) is then
            builtin.is_float return
        fi
        false
    }

    pub fn is_integer_literal_t self:$Type -> bool { make_integer_literal_type self.eq }

    pub fn is_float_literal_t self:$Type -> bool { make_float_literal_type self.eq }

    pub fn match_base self:$Type -> std::String {
        self match
            Type::Generic(generic) => {
                generic.base.clone
            }
            _ => {
                self.format
            }
        end
    }

    pub fn has_unresolved self:$Type -> bool {
        self match
            Type::Generic(generic) => {
                if 0 generic.params.length == then
                    false
                else
                    for param in generic.params.iter do
                        if param.is_unknown_placeholder then
                            true return
                        fi
                        if param.has_unresolved then
                            true return
                        fi
                    done
                    false
                fi
            }
            Type::Function(fn_type) => {
                for param in fn_type.parameters.iter do
                    if param.has_unresolved then
                        true return
                    fi
                done
                for ret in fn_type.return_types.iter do
                    if ret.has_unresolved then
                        true return
                    fi
                done
                false
            }
            Type::Unknown => {
                false
            }
            _ => {
                false
            }
        end
    }

    pub fn is_self_type self:$Type -> bool {
        self match
            Type::Generic(generic) => {
                0 generic.params.length == TRAIT_SELF_TYPE generic.base.as_str == &&
            }
            Type::TypeVar(name) => {
                TRAIT_SELF_TYPE name.as_str ==
            }
            _ => {
                false
            }
        end
    }

    pub fn eq self:$Type other:$Type -> bool {
        self match
            Type::Unknown => {
                other match
                    Type::Unknown => {
                        true
                    }
                    _ => {
                        false
                    }
                end
            }
            Type::Builtin(b_self) => {
                other match
                    Type::Builtin(b_other) => {
                        b_other b_self ==
                    }
                    _ => {
                        false
                    }
                end
            }
            Type::TypeVar(n_self) => {
                other match
                    Type::TypeVar(n_other) => {
                        n_other n_self ==
                    }
                    _ => {
                        false
                    }
                end
            }
            Type::Const(c_self) => {
                other match
                    Type::Const(c_other) => {
                        c_other.name c_self.name ==
                        c_other.typ c_self.typ == &&
                        c_other.value c_self.value == &&
                    }
                    _ => {
                        false
                    }
                end
            }
            Type::Generic(g_self) => {
                other match
                    Type::Generic(g_other) => {
                        if g_other.base g_self.base != then
                            false return
                        fi
                        if g_other.params.length g_self.params.length != then
                            false return
                        fi
                        for
                            pair in g_other.params.iter g_self
                                .params
                                .iter
                                .zip
                        do
                            if pair.second pair.first.eq ! then
                                false return
                            fi
                        done
                        true
                    }
                    _ => {
                        false
                    }
                end
            }
            Type::Function(f_self) => {
                other match
                    Type::Function(f_other) => {
                        if f_other.parameters.length f_self.parameters.length != then
                            false return
                        fi
                        if f_other.return_types.length f_self.return_types.length != then
                            false return
                        fi
                        for
                            pair in f_other.parameters.iter f_self
                                .parameters
                                .iter
                                .zip
                        do
                            if pair.second pair.first.eq ! then
                                false return
                            fi
                        done
                        for
                            pair in f_other.return_types.iter f_self
                                .return_types
                                .iter
                                .zip
                        do
                            if pair.second pair.first.eq ! then
                                false return
                            fi
                        done
                        true
                    }
                    _ => {
                        false
                    }
                end
            }
        end
    }
}

pub fn string_list_to_set items:$std::List[std::String] -> std::Set[std::String] {
    std::Set[std::String]::new = result
    for item in items.iter do
        item.clone result.add
    done
    result
}

pub fn canonicalize_type_var typ:$Type type_vars:$std::Set[std::String] -> Type {
    typ match
        Type::TypeVar(name) => {
            if name type_vars.has then
                typ clone_type
            else
                name.clone GenericType::new Type::Generic
            fi
        }
        Type::Generic(generic) => {
            if 0 generic.params.length == then
                if generic.base type_vars.has then
                    generic.base.clone Type::TypeVar return
                fi
                typ clone_type return
            fi
            std::List[Type]::new = new_params
            for param in generic.params.iter do
                type_vars param canonicalize_type_var new_params.push
            done
            new_params generic.base.clone GenericType Type::Generic
        }
        Type::Function(fn_type) => {
            std::List[Type]::new = new_params
            for param in fn_type.parameters.iter do
                type_vars param canonicalize_type_var new_params.push
            done
            std::List[Type]::new = new_returns
            for ret in fn_type.return_types.iter do
                type_vars ret canonicalize_type_var new_returns.push
            done
            new_returns new_params FunctionType Type::Function
        }
        _ => {
            typ clone_type
        }
    end
}

pub fn canonicalize_stack_effect_type_vars effect:mut$StackEffect type_vars:$std::Set[std::String] {
    0 (u64) = index
    while index effect StackEffect::parameters.length > do
        index effect StackEffect::parameters.get_mut = param
        type_vars param Parameter::typ canonicalize_type_var param Parameter::set_typ
        1 += index
    done
    0 (u64) = ret_index
    while ret_index effect StackEffect::return_types.length > do
        type_vars ret_index effect StackEffect::return_types.get canonicalize_type_var ret_index effect StackEffect::return_types.set
        1 += ret_index
    done
}

pub fn canonicalize_operation_type_vars ops:mut$std::List[Op] type_vars:$std::Set[std::String] {
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get_mut = op
        op.value clone_op_value = value
        value match
            OpValue::TypeCast(target) => {
                type_vars target canonicalize_type_var OpValue::TypeCast op Op::set_value
            }
            OpValue::NumericTry(numeric_try) => {
                numeric_try.target type_vars numeric_try.source canonicalize_type_var NumericTry
                OpValue::NumericTry op Op::set_value
            }
            OpValue::SizeOf(target) => {
                type_vars target canonicalize_type_var OpValue::SizeOf op Op::set_value
            }
            OpValue::PtrRead(target) => {
                type_vars target canonicalize_type_var OpValue::PtrRead op Op::set_value
            }
            OpValue::PtrWrite(target) => {
                type_vars target canonicalize_type_var OpValue::PtrWrite op Op::set_value
            }
            OpValue::PtrAsRef(target) => {
                type_vars target canonicalize_type_var OpValue::PtrAsRef op Op::set_value
            }
            OpValue::PtrAsMut(target) => {
                type_vars target canonicalize_type_var OpValue::PtrAsMut op Op::set_value
            }
            OpValue::PushArray(items) => {
                items clone_ops = owned_items
                type_vars owned_items canonicalize_operation_type_vars
                owned_items OpValue::PushArray op Op::set_value
            }
            OpValue::ExprGroup(items) => {
                items clone_ops = owned_items
                type_vars owned_items canonicalize_operation_type_vars
                owned_items OpValue::ExprGroup op Op::set_value
            }
            OpValue::InitGlobal(initializer) => {
                initializer.clone = owned_initializer
                type_vars owned_initializer.ops canonicalize_operation_type_vars
                owned_initializer OpValue::InitGlobal op Op::set_value
            }
            OpValue::MatchArm(arm) => {
                arm.clone = owned_arm
                type_vars owned_arm.guard_ops canonicalize_operation_type_vars
                owned_arm OpValue::MatchArm op Op::set_value
            }
            _ => {
            }
        end
        op.type_hint.clone = type_hint
        if type_hint std::Option::Some(hint) is then
            type_vars hint canonicalize_type_var std::Option::Some op Op::set_type_hint
        fi
        op.deferred_return_hint.clone = deferred_return_hint
        if deferred_return_hint std::Option::Some(hint) is then
            type_vars hint canonicalize_type_var std::Option::Some op Op::set_deferred_return_hint
        fi
        1 += op_index
    done
}

pub fn clone_type typ:$Type -> Type {
    typ match
        Type::Unknown => {
            Type::Unknown
        }
        Type::Builtin(builtin) => {
            builtin (BuiltinType) Type::Builtin
        }
        Type::TypeVar(name) => {
            name.clone Type::TypeVar
        }
        Type::Const(const_type) => {
            const_type.value const_type.typ (BuiltinType) const_type.name.clone ConstType Type::Const
        }
        Type::Generic(generic) => {
            std::List[Type]::new = parameters
            for parameter in generic.params.iter do
                parameter clone_type parameters.push
            done
            parameters generic.base.clone GenericType Type::Generic
        }
        Type::Function(function_type) => {
            std::List[Type]::new = parameters
            for parameter in function_type.parameters.iter do
                parameter clone_type parameters.push
            done
            std::List[Type]::new = return_types
            for return_type in function_type.return_types.iter do
                return_type clone_type return_types.push
            done
            return_types parameters FunctionType Type::Function
        }
    end
}

impl Type: std::Clone {
    pub fn clone self:$Type -> Type { self clone_type }
}
# Parse a non-negative integer literal, e.g. the `3` in `array[i64 3]`
# (ADR-0152). None if `source` is empty or has a non-digit character.

pub fn try_parse_uint_literal source:$str -> std::Option[i64] {
    if 0 source.length == then
        std::Option[i64]::None return
    fi
    0 = value
    0 (u64) = index
    while index source.length > do
        if index source.at.is_digit ! then
            std::Option[i64]::None return
        fi
        10 value.wrapping_mul = value
        index source.at.codepoint i64::from '0'.codepoint i64::from - value.wrapping_add = value
        1 += index
    done
    value std::Option::Some
}

pub fn parse_type_str source:$str -> Type {
    if "" source.as_str == then
        Type::Unknown return
    fi
    if source "mut$" str::starts_with then
        source 4 source.length 4 - str::substring = target_text
        target_text.as_str parse_type_str = target
        if target.is_borrow then
            Type::Unknown return
        fi
        std::List[Type]::new = parameters
        target parameters.push
        parameters EXCLUSIVE_BORROW_TYPE.to_str GenericType Type::Generic return
    fi
    if source "$" str::starts_with then
        source 1 source.length 1 - str::substring = target_text
        target_text.as_str parse_type_str = target
        if target.is_borrow then
            Type::Unknown return
        fi
        std::List[Type]::new = parameters
        target parameters.push
        parameters SHARED_BORROW_TYPE.to_str GenericType Type::Generic return
    fi
    if source parse_builtin std::Option::Some(builtin) is then
        builtin Type::Builtin return
    fi
    # Constant argument in type position (ADR-0152, ADR-0153). An integer literal
    # carries `u64` provisionally; its width is checked later against the declared
    # parameter type. Char literals are handled in `parse_type_ast` (codepoint
    # decoder in scope there).
    if source try_parse_uint_literal std::Option::Some(const_value) is then
        BuiltinType::U64 const_value ConstType::concrete Type::Const return
    fi
    if "true" source.as_str == then
        BuiltinType::Bool 1 ConstType::concrete Type::Const return
    fi
    if "false" source.as_str == then
        BuiltinType::Bool 0 ConstType::concrete Type::Const return
    fi
    # TypeVar: single uppercase letter
    if 1 source.length == then
        if 0 source.at.is_upper then
            source.to_str Type::TypeVar return
        fi
    fi
    # Function type: bare "fn" or "fn[...]"
    if "fn" source.as_str == then
        std::List[Type]::new std::List[Type]::new FunctionType Type::Function return
    fi
    if source "fn[" str::starts_with source "]" str::ends_with && then
        source.length 4 - = inner_length
        source 3 inner_length str::substring = fn_inner
        std::List[Type]::new = fn_params
        std::List[Type]::new = fn_returns
        false = past_arrow
        std::String::new = current
        0 = depth
        for ch in fn_inner.iter do
            if '[' ch == then
                1 += depth
                ch current.push
            elif ']' ch == then
                depth 1 - = depth
                ch current.push
            elif ' ' ch == 0 depth == && then
                if 0 current.length != then
                    current = token
                    if "->" token.as_str == then
                        true = past_arrow
                    elif past_arrow then
                        token.as_str parse_type_str fn_returns.push
                    else
                        token.as_str parse_type_str fn_params.push
                    fi
                    std::String::new = current
                fi
            else
                ch current.push
            fi
        done
        if 0 current.length != then
            current = last_token
            if "->" last_token.as_str == then
                # bare arrow at end — nothing
            elif past_arrow then
                last_token.as_str parse_type_str fn_returns.push
            else
                last_token.as_str parse_type_str fn_params.push
            fi
        fi
        fn_returns fn_params FunctionType Type::Function return
    fi
    # Generic: Name[params]
    if source "[" str::contains source "]" str::ends_with && then
        source "[" str::find = bracket_pos
        source 0 bracket_pos (u64) str::substring = base
        source.length base.length - 2 - = inner_len
        source base.length 1 + inner_len str::substring = inner
        inner.as_str parse_generic_params = params
        params base GenericType Type::Generic return
    fi
    # Named type with no params (user struct/enum)
    std::List[Type]::new = empty_params
    empty_params source.to_str GenericType Type::Generic
}

# ============================================================================
# Type utility functions
# ============================================================================

pub fn split_type_tokens s:$str -> std::List[std::String] {
    # Split a space-separated type string into tokens, respecting brackets.
    std::List[std::String]::new = tokens
    std::String::new = current
    0 = depth
    for ch in s.iter do
        if '[' ch == then
            1 += depth
            ch current.push
        elif ']' ch == then
            depth 1 - = depth
            ch current.push
        elif ' ' ch == 0 depth == && then
            if 0 current.length != then
                current tokens.push
                std::String::new = current
            fi
        else
            ch current.push
        fi
    done
    if 0 current.length != then
        current tokens.push
    fi
    tokens
}

pub fn build_parameterized_type base:$str params:$std::List[std::String] -> Type {
    std::Map[std::String Type]::new params base build_resolved_type
}

pub fn build_resolved_type
    base:$str
    type_vars:$std::List[std::String]
    bindings:$std::Map[std::String Type]
-> Type {
    std::List[Type]::new = params
    for type_var in type_vars.iter do
        if type_var bindings.get std::Option::Some(bound) is then
            bound clone_type params.push
        else
            type_var.clone Type::TypeVar params.push
        fi
    done
    params base.to_str GenericType Type::Generic
}

