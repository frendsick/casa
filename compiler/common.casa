        end
        op.type_hint.clone = type_hint
        if type_hint std::Option::Some(hint) is then
            type_vars hint canonicalize_type_var std::Option::Some op Op::set_type_hint
        fi
        op.deferred_return_hint.clone = deferred_return_hint
