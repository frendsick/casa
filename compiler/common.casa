impl KeywordKind {
    pub fn format_source self:$KeywordKind -> str {
        self match
            KeywordKind::Pub => "pub"
            KeywordKind::As => "as"
            KeywordKind::Unsafe => "unsafe"
            KeywordKind::Extern => "extern"
            KeywordKind::Fn => "fn"
            KeywordKind::Impl => "impl"
            KeywordKind::Return => "return"
            KeywordKind::While => "while"
            KeywordKind::Do => "do"
            KeywordKind::Break => "break"
            KeywordKind::Continue => "continue"
            KeywordKind::Done => "done"
            KeywordKind::If => "if"
            KeywordKind::Then => "then"
            KeywordKind::Elif => "elif"
            KeywordKind::Else => "else"
            KeywordKind::Fi => "fi"
            KeywordKind::EnumKw => "enum"
            KeywordKind::StructKw => "struct"
            KeywordKind::TraitKw => "trait"
            KeywordKind::End => "end"
            KeywordKind::Match => "match"
            KeywordKind::Is => "is"
            KeywordKind::Import => "import"
            KeywordKind::For => "for"
            KeywordKind::In => "in"
            KeywordKind::Global => "global"
            KeywordKind::Const => "const"
            KeywordKind::Move => "move"
        end
