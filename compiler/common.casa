# Parse a non-negative integer literal, e.g. the `3` in `array[i64 3]`
# (ADR-0152). None if `source` is empty or has a non-digit character.

pub fn try_parse_uint_literal source:$str -> std::Option[i64] {
    if 0 source.length == then
        std::Option[i64]::None return
    fi
    0 = value
    0 = index: u64
    while index source.length > do
        if index source.at.is_digit ! then
            std::Option[i64]::None return
        fi
        10 value.wrapping_mul = value
        index source.at.codepoint i64::from '0'.codepoint i64::from - value.wrapping_add = value
        1 += index
    done
    value std::Option::Some
}

pub fn parse_type_str source:$str -> Type {
    if "" source.as_str == then
        Type::Unknown return
    fi
    if source "mut$" str::starts_with then
        source 4 source.length 4 - str::substring = target_text
        target_text.as_str parse_type_str = target
        if target.is_borrow then
            Type::Unknown return
        fi
        std::List[Type]::new = parameters
        target parameters.push
        parameters EXCLUSIVE_BORROW_TYPE.to_str GenericType Type::Generic return
    fi
    if source "$" str::starts_with then
        source 1 source.length 1 - str::substring = target_text
        target_text.as_str parse_type_str = target
        if target.is_borrow then
            Type::Unknown return
        fi
        std::List[Type]::new = parameters
        target parameters.push
        parameters SHARED_BORROW_TYPE.to_str GenericType Type::Generic return
    fi
    if source parse_builtin std::Option::Some(builtin) is then
        builtin Type::Builtin return
    fi
