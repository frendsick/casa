Map[str DelimiterKind]::new = DELIMITER_MAP
DelimiterKind::Arrow "->" DELIMITER_MAP.set
DelimiterKind::Comma "," DELIMITER_MAP.set
DelimiterKind::FatArrow "=>" DELIMITER_MAP.set
DelimiterKind::Colon ":" DELIMITER_MAP.set
DelimiterKind::Dot "." DELIMITER_MAP.set
DelimiterKind::Hashtag "#" DELIMITER_MAP.set
DelimiterKind::OpenBrace "{" DELIMITER_MAP.set
DelimiterKind::CloseBrace "}" DELIMITER_MAP.set
DelimiterKind::OpenBracket "[" DELIMITER_MAP.set
DelimiterKind::CloseBracket "]" DELIMITER_MAP.set
DelimiterKind::OpenParen "(" DELIMITER_MAP.set
DelimiterKind::CloseParen ")" DELIMITER_MAP.set

fn delimiter_from_str value:$str -> Option[DelimiterKind] { value DELIMITER_MAP.get_copy }

fn delimiter_from_char c:char -> Option[DelimiterKind] {
    if ',' c == then
        DelimiterKind::Comma Option::Some
    elif ':' c == then
        DelimiterKind::Colon Option::Some
    elif '.' c == then
        DelimiterKind::Dot Option::Some
    elif '#' c == then
        DelimiterKind::Hashtag Option::Some
    elif '{' c == then
        DelimiterKind::OpenBrace Option::Some
    elif '}' c == then
        DelimiterKind::CloseBrace Option::Some
    elif '[' c == then
        DelimiterKind::OpenBracket Option::Some
    elif ']' c == then
        DelimiterKind::CloseBracket Option::Some
    elif '(' c == then
        DelimiterKind::OpenParen Option::Some
    elif ')' c == then
        DelimiterKind::CloseParen Option::Some
    else
        Option::None
    fi
}

# ============================================================================
# IntrinsicKind -> OpValue lookup
# ============================================================================

fn intrinsic_to_op_value intrinsic_kind:IntrinsicKind -> Option[OpValue] {
    intrinsic_kind match
        IntrinsicKind::Alloc => OpValue::HeapAlloc Option::Some
        IntrinsicKind::Free => OpValue::HeapFree Option::Some
        IntrinsicKind::Drop => OpValue::Drop Option::Some
        IntrinsicKind::Dup => OpValue::Dup Option::Some
        IntrinsicKind::Copy => OpValue::Copy Option::Some
        IntrinsicKind::Exec => OpValue::FnExec Option::Some
        IntrinsicKind::Load8 => OpValue::Load8 Option::Some
        IntrinsicKind::Load16 => OpValue::Load16 Option::Some
        IntrinsicKind::Load32 => OpValue::Load32 Option::Some
        IntrinsicKind::Load64 => OpValue::Load64 Option::Some
        IntrinsicKind::Over => OpValue::Over Option::Some
        IntrinsicKind::Print => OpValue::Print Option::Some
        IntrinsicKind::Rot => OpValue::Rot Option::Some
        IntrinsicKind::Store8 => OpValue::Store8 Option::Some
        IntrinsicKind::Store16 => OpValue::Store16 Option::Some
        IntrinsicKind::Store32 => OpValue::Store32 Option::Some
        IntrinsicKind::Store64 => OpValue::Store64 Option::Some
        IntrinsicKind::Swap => OpValue::Swap Option::Some
        IntrinsicKind::Typeof => OpValue::Typeof Option::Some
        IntrinsicKind::SizeOf => Option[OpValue]::None
        IntrinsicKind::Syscall0 => OpValue::Syscall0 Option::Some
        IntrinsicKind::Syscall1 => OpValue::Syscall1 Option::Some
        IntrinsicKind::Syscall2 => OpValue::Syscall2 Option::Some
        IntrinsicKind::Syscall3 => OpValue::Syscall3 Option::Some
        IntrinsicKind::Syscall4 => OpValue::Syscall4 Option::Some
        IntrinsicKind::Syscall5 => OpValue::Syscall5 Option::Some
        IntrinsicKind::Syscall6 => OpValue::Syscall6 Option::Some
        IntrinsicKind::Argc => OpValue::Argc Option::Some
        IntrinsicKind::Argv => OpValue::Argv Option::Some
        IntrinsicKind::Envp => OpValue::Envp Option::Some
    end
}

# ============================================================================
# Direct OpValue -> InstValue lowering (for ops that translate 1:1)
# ============================================================================

fn direct_op_to_inst value:$OpValue -> Option[InstValue] {
    value match
        OpValue::Add => InstValue::Add Option::Some
        OpValue::And => InstValue::And Option::Some
        OpValue::BitAnd => InstValue::BitAnd Option::Some
        OpValue::BitNot => InstValue::BitNot Option::Some
        OpValue::BitOr => InstValue::BitOr Option::Some
        OpValue::BitXor => InstValue::BitXor Option::Some
        OpValue::Div => InstValue::Div Option::Some
        OpValue::Drop => InstValue::Drop Option::Some
        OpValue::Dup => InstValue::Dup Option::Some
        OpValue::Eq => InstValue::Eq Option::Some
        OpValue::FnExec => InstValue::FnExec Option::Some
        OpValue::FnReturn => InstValue::FnReturn Option::Some
        OpValue::Ge => InstValue::Ge Option::Some
        OpValue::Gt => InstValue::Gt Option::Some
        OpValue::HeapAlloc => InstValue::HeapAlloc Option::Some
        OpValue::HeapFree => InstValue::HeapFree Option::Some
        OpValue::Le => InstValue::Le Option::Some
        OpValue::Load8 => InstValue::Load8 Option::Some
        OpValue::Load16 => InstValue::Load16 Option::Some
        OpValue::Load32 => InstValue::Load32 Option::Some
        OpValue::Load64 => InstValue::Load64 Option::Some
        OpValue::Lt => InstValue::Lt Option::Some
        OpValue::Mod => InstValue::Mod Option::Some
        OpValue::Mul => InstValue::Mul Option::Some
        OpValue::Ne => InstValue::Ne Option::Some
        OpValue::Not => InstValue::Not Option::Some
        OpValue::Or => InstValue::Or Option::Some
        OpValue::Over => InstValue::Over Option::Some
        OpValue::PrintBool => InstValue::PrintBool Option::Some
        OpValue::PrintChar => InstValue::PrintChar Option::Some
        OpValue::PrintCstr => InstValue::PrintCstr Option::Some
        OpValue::PrintInt => InstValue::PrintInt Option::Some
        OpValue::PrintStr => InstValue::PrintStr Option::Some
        OpValue::Rot => InstValue::Rot Option::Some
        OpValue::Shl => InstValue::Shl Option::Some
        OpValue::Shr => InstValue::Shr Option::Some
        OpValue::Store8 => InstValue::Store8 Option::Some
        OpValue::Store16 => InstValue::Store16 Option::Some
        OpValue::Store32 => InstValue::Store32 Option::Some
        OpValue::Store64 => InstValue::Store64 Option::Some
        OpValue::Sub => InstValue::Sub Option::Some
        OpValue::Swap => InstValue::Swap Option::Some
        OpValue::Syscall0 => InstValue::Syscall0 Option::Some
        OpValue::Syscall1 => InstValue::Syscall1 Option::Some
        OpValue::Syscall2 => InstValue::Syscall2 Option::Some
        OpValue::Syscall3 => InstValue::Syscall3 Option::Some
        OpValue::Syscall4 => InstValue::Syscall4 Option::Some
        OpValue::Syscall5 => InstValue::Syscall5 Option::Some
        OpValue::Syscall6 => InstValue::Syscall6 Option::Some
        OpValue::Argc => InstValue::Argc Option::Some
        OpValue::Argv => InstValue::Argv Option::Some
        OpValue::Envp => InstValue::Envp Option::Some
        _ => Option[InstValue]::None
    end
}

# ============================================================================
# List helpers for variables
# ============================================================================

fn variable_list_index vars:$List[Variable] name:$str -> i64 {
    0 (u64) = index
    while index vars.length > do
        if name index vars.get Variable::name == then
            index (i64) return
        fi
        1 += index
    done
    -1
}

fn variable_list_contains vars:$List[Variable] name:$str -> bool {
    0 name vars variable_list_index >=
}

fn string_list_index items:$List[str] value:$str -> i64 {
    0 (u64) = index
    while index items.length > do
        if value index items.get == then
            index (i64) return
        fi
        1 += index
    done
    -1
}

fn string_list_contains items:$List[str] value:$str -> bool { 0 value items string_list_index >= }

# ============================================================================
# SymbolStore
#
# Shared declaration state threaded through the parser/typechecker/bytecode
# pipeline. Each phase holds a `store: SymbolStore` field on
# its owning struct (Parser, TypeChecker, BytecodeCompiler) and reaches
# declarations via dot syntax, e.g. `typechecker.store.functions .get`.
#
# Maps and sets are heap-backed in casa, so passing SymbolStore by value
# copies the struct but not the underlying map data — all holders observe
# the same mutations.
# ============================================================================

struct SymbolStore {
    next_op_id:    i64
    functions:     Map[str Function]
    variables:     Map[str Variable]
    constants:     Map[str Constant]
    enums:         Map[str CasaEnum]
    structs:       Map[str CasaStruct]
    traits:        Map[str CasaTrait]
    trait_impls:   Map[str TraitImpl]
    builtins:      Set[str]
    copy_types:    Map[str bool]
    borrow_shapes: Map[str bool]
    op_ownership:  Map[i64 OpOwnership]
}

fn symbol_store_new -> SymbolStore {
    Set[str]::new = builtins
    "i8" builtins.add
    "i16" builtins.add
    "i32" builtins.add
    "i64" builtins.add
    "u8" builtins.add
    "u16" builtins.add
    "u32" builtins.add
    "u64" builtins.add
    "f32" builtins.add
    "f64" builtins.add
    "bool" builtins.add
    "str" builtins.add
    "char" builtins.add
    "cstr" builtins.add
    "ptr" builtins.add
    "array" builtins.add

    Map[i64 OpOwnership]::new
    Map[str bool]::new
    Map[str bool]::new
    builtins
    Map[str TraitImpl]::new
    Map[str CasaTrait]::new
    Map[str CasaStruct]::new
    Map[str CasaEnum]::new
    Map[str Constant]::new
    Map[str Variable]::new
    Map[str Function]::new
    1
    SymbolStore
}

struct TypeLayout {
    size:      u64
    alignment: u64
}

fn align_up value:u64 alignment:u64 -> u64 { value alignment 1 - + alignment / alignment * }

fn builtin_type_layout builtin:$BuiltinType -> TypeLayout {
    builtin match
        BuiltinType::I8 => 1 1 TypeLayout
        BuiltinType::U8 => 1 1 TypeLayout
        BuiltinType::Bool => 1 1 TypeLayout
        BuiltinType::I16 => 2 2 TypeLayout
        BuiltinType::U16 => 2 2 TypeLayout
        BuiltinType::I32 => 4 4 TypeLayout
        BuiltinType::U32 => 4 4 TypeLayout
        BuiltinType::F32 => 4 4 TypeLayout
        BuiltinType::Char => 4 4 TypeLayout
        _ => WORD_SIZE WORD_SIZE TypeLayout
    end
}
# Aggregate fields keep the language's one-word indirect representation for
# nested aggregates. Generic fields also use one word because generic functions
# are shared across all instantiations.

fn aggregate_field_layout typ:$Type store:$SymbolStore visiting:mut$Set[str] -> Option[TypeLayout] {
    if typ.has_unresolved_type_var then
        WORD_SIZE WORD_SIZE TypeLayout Option::Some return
    fi
    if store typ type_value_representation Option::Some(representation) is then
        if VALUE_REPR_INDIRECT representation == then
            WORD_SIZE WORD_SIZE TypeLayout Option::Some return
        fi
    fi
    visiting store typ type_layout
}

fn struct_type_layout
    typ:$Type
    casa_struct:$CasaStruct
    store:$SymbolStore
    visiting:mut$Set[str]
-> Option[TypeLayout] {
    0 (u64) = size
    1 (u64) = alignment
    for member in casa_struct.members.iter do
        if visiting store member.typ aggregate_field_layout Option::Some(member_layout) is then
            member_layout.alignment size align_up = size
            member_layout.size += size
            if alignment member_layout.alignment > then
                member_layout.alignment = alignment
            fi
        else
            Option[TypeLayout]::None return
        fi
    done
    if 0 size == then
        1 (u64) = size
    fi
    alignment size align_up = size
    alignment size TypeLayout Option::Some
}

fn enum_type_layout
    typ:$Type
    casa_enum:$CasaEnum
    store:$SymbolStore
    visiting:mut$Set[str]
-> Option[TypeLayout] {
    WORD_SIZE (u64) = size
    WORD_SIZE (u64) = alignment
    for pair in casa_enum.variant_types.iter do
        WORD_SIZE (u64) = variant_size
        for payload_type in pair.second.iter do
            if visiting store payload_type aggregate_field_layout Option::Some(payload_layout) is then
                payload_layout.alignment variant_size align_up = variant_size
                payload_layout.size += variant_size
                if alignment payload_layout.alignment > then
                    payload_layout.alignment = alignment
                fi
            else
                Option[TypeLayout]::None return
            fi
        done
        if size variant_size > then
            variant_size = size
        fi
    done
    alignment size align_up = size
    alignment size TypeLayout Option::Some
}

fn struct_member_offset casa_struct:$CasaStruct member_index:u64 store:$SymbolStore -> Option[u64] {
    Set[str]::new = visiting
    0 (u64) = offset
    0 (u64) = index
    while index casa_struct.members.length > do
        index casa_struct.members.get = member
        if visiting store member.typ aggregate_field_layout Option::Some(layout) is then
            layout.alignment offset align_up = offset
            if index member_index == then
                offset Option::Some return
            fi
            layout.size += offset
        else
            Option[u64]::None return
        fi
        1 += index
    done
    Option[u64]::None
}

fn next_struct_member_offset
    prior_members:$List[Member]
    member_type:$Type
    store:$SymbolStore
-> Option[u64] {
    Set[str]::new = visiting
    0 (u64) = offset
    for member in prior_members.iter do
        WORD_SIZE WORD_SIZE TypeLayout = layout
        if visiting store member.typ aggregate_field_layout Option::Some(found_layout) is then
            found_layout.alignment found_layout.size TypeLayout = layout
        fi
        layout.alignment offset align_up layout.size + = offset
    done
    # An imported or forward aggregate can be absent while its accessors are
    # parsed. Aggregate fields always use one indirect word in that case.
    WORD_SIZE WORD_SIZE TypeLayout = member_layout
    if visiting store member_type aggregate_field_layout Option::Some(found_member_layout) is then
        found_member_layout.alignment found_member_layout.size TypeLayout = member_layout
    fi
    member_layout.alignment offset align_up Option::Some
}

fn enum_payload_offset
    casa_enum:$CasaEnum
    variant_name:$str
    payload_index:u64
    store:$SymbolStore
-> Option[u64] {
    variant_name casa_enum.variant_types.get = payload_types_opt
    if payload_types_opt.is_none then
        Option[u64]::None return
    fi
    payload_types_opt.unwrap = payload_types
    Set[str]::new = visiting
    WORD_SIZE (u64) = offset
    0 (u64) = index
    while index payload_types.length > do
        index payload_types.get = payload_type
        if visiting store payload_type aggregate_field_layout Option::Some(layout) is then
            layout.alignment offset align_up = offset
            if index payload_index == then
                offset Option::Some return
            fi
            layout.size += offset
        else
            Option[u64]::None return
        fi
        1 += index
    done
    Option[u64]::None
}

fn array_type_layout
    typ:$Type
    generic:$GenericType
    store:$SymbolStore
    visiting:mut$Set[str]
-> Option[TypeLayout] {
    if 2 generic.params.length != then
        Option[TypeLayout]::None return
    fi
    if typ get_concrete_array_length Option::Some(length) is then
        if visiting store 0 generic.params.get type_layout Option::Some(element) is then
            if 0 length == then
                1 1 TypeLayout Option::Some
            else
                element.alignment length element.size * TypeLayout Option::Some
            fi
            return
        fi
    fi
    Option[TypeLayout]::None
}

fn type_layout typ:$Type store:$SymbolStore visiting:mut$Set[str] -> Option[TypeLayout] {
    if typ.is_borrow then
        WORD_SIZE WORD_SIZE TypeLayout Option::Some return
    fi
    typ match
        Type::Builtin(builtin) => {
            builtin builtin_type_layout Option::Some
        }
        Type::Function => {
            WORD_SIZE WORD_SIZE TypeLayout Option::Some
        }
        Type::Generic(generic) => {
            if ARRAY_TYPE generic.base == then
                visiting store generic typ array_type_layout return
            fi
            typ.format = type_name
            if type_name visiting.has then
                WORD_SIZE WORD_SIZE TypeLayout Option::Some return
            fi
            type_name.clone visiting.add
            Option[TypeLayout]::None = result
            if generic.base store.structs.get Option::Some(casa_struct) is then
                visiting store casa_struct typ struct_type_layout = result
            elif generic.base store.enums.get Option::Some(casa_enum) is then
                visiting store casa_enum typ enum_type_layout = result
            fi
            type_name visiting.remove
            result
        }
        _ => {
            Option[TypeLayout]::None
        }
    end
}

fn type_inline_size typ:$Type store:$SymbolStore -> Option[u64] {
    Set[str]::new = visiting
    if visiting store typ type_layout Option::Some(layout) is then
        layout.size Option::Some
    else
        Option[u64]::None
    fi
}

fn type_value_representation typ:$Type store:$SymbolStore -> Option[u64] {
    if typ.is_borrow then
        VALUE_REPR_RAW (u64) Option::Some return
    fi
    typ match
        Type::Builtin(builtin) => {
            if builtin.is_integer builtin.is_unsigned ! && then
                VALUE_REPR_SIGNED (u64) Option::Some
            else
                VALUE_REPR_RAW (u64) Option::Some
            fi
        }
        Type::Function => {
            VALUE_REPR_RAW (u64) Option::Some
        }
        Type::Generic(generic) => {
            if ARRAY_TYPE generic.base == generic.base store.structs.has || then
                VALUE_REPR_INDIRECT (u64) Option::Some
            elif generic.base store.enums.get Option::Some(casa_enum) is then
                if casa_enum has_inner_values then
                    VALUE_REPR_INDIRECT (u64) Option::Some
                else
                    VALUE_REPR_RAW (u64) Option::Some
                fi
            else
                Option[u64]::None
            fi
        }
        _ => {
            Option[u64]::None
        }
    end
}

fn aggregate_type_bindings typ:$Type type_vars:$List[str] -> Map[str Type] {
    Map[str Type]::new = bindings
    if typ.type_params Option::Some(type_params) is then
        for pair in type_params.iter type_vars.iter.zip do
            pair.second clone_type pair.first.clone bindings.set
        done
    fi
    bindings
}

fn type_needs_destruction_in_store typ:$Type store:$SymbolStore -> bool {
    if typ.is_borrow then
        false return
    fi
    if typ Type::TypeVar is then
        true return
    fi
    if typ Type::Function(_) is then
        true return
    fi
    if f"{typ.match_base}::drop" store.functions.has then
        true return
    fi
    if store typ type_value_representation Option::Some(representation) is then
        VALUE_REPR_INDIRECT representation == return
    fi
    false
}
