pub struct Parameter {
    pub typ:  Type
    pub name: std::String
}

impl Parameter {
    pub fn new typ:$Type -> Parameter { "".to_str typ clone_type Parameter }

    pub fn named typ:$Type name:std::String -> Parameter { name typ clone_type Parameter }
}

pub struct StackEffect {
    pub parameters:   std::List[Parameter]
    pub return_types: std::List[Type]
    pub type_vars:    std::Set[std::String]
    pub trait_bounds: std::Map[std::String std::List[TraitBound]]
    pub const_params: std::Map[std::String BuiltinType]
}

pub fn empty_stack_effect -> StackEffect {
    std::Map[std::String BuiltinType]::new
    std::Map[std::String std::List[TraitBound]]::new
    std::Set[std::String]::new
    std::List[Type]::new
    std::List[Parameter]::new
    StackEffect
}

impl StackEffect {
    pub fn new params:std::List[Parameter] returns:std::List[Type] -> StackEffect {
        std::Map[std::String BuiltinType]::new
        std::Map[std::String std::List[TraitBound]]::new
        std::Set[std::String]::new
        returns
        params
        StackEffect
    }
}

