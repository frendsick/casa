pub enum LiteralValue derives std::Clone {
    Int (IntegerLiteral)
    Str (std::String)
    Bool (bool)
    Char (i64)
}

pub struct IntegerLiteral derives std::Clone {
    pub raw:   std::String
    pub value: i64
}

impl IntegerLiteral {
    pub fn new raw:std::String value:i64 -> IntegerLiteral { value raw IntegerLiteral }

    pub fn from_int value:i64 -> IntegerLiteral { value value.to_str IntegerLiteral::new }

    pub fn get_normalized_magnitude self:$IntegerLiteral -> std::String {
        0 = start: u64
        if 0 self.raw.length != then
            if '-' 0 self.raw.at == then
                1 = start: u64
            fi
        fi
        while start self.raw.length 1 - > do
            if '0' start self.raw.at != then
                break
            fi
            1 += start
        done
        self.raw.as_str start self.raw.length start - str::substring
    }

    pub fn fits_decimal_limit self:$IntegerLiteral limit:$str -> bool {
        self.get_normalized_magnitude = magnitude
        limit.to_str = normalized_limit
        if 0 limit.length != '-' 0 limit.at == && then
            limit 1 limit.length 1 - str::substring = normalized_limit
        fi
        if normalized_limit.length magnitude.length < then
            true return
        fi
        if normalized_limit.length magnitude.length > then
            false return
        fi
        0 = index: u64
        while index magnitude.length > do
            index magnitude.at.codepoint i64::from = value_character
            index normalized_limit.at.codepoint i64::from = limit_character
            if limit_character value_character < then
                true return
            fi
            if limit_character value_character > then
                false return
            fi
            1 += index
        done
        true
    }

    pub fn fits self:$IntegerLiteral target:$Type -> bool {
        if target.is_integer_type_t ! then
            false return
        fi
        false = negative
        if 0 self.raw.length != then
            '-' 0 self.raw.at == = negative
        fi
        if target Type::Builtin(builtin) is then
            if negative builtin.is_unsigned && then
                false return
            fi
        fi
        if negative then
            target.get_integer_min self.fits_decimal_limit
        else
            target.get_integer_max self.fits_decimal_limit
        fi
    }
}
# Source identifiers cannot start with `$`. Parser-generated storage uses this
# namespace so it can keep local move semantics even when emitted globally.

pub fn is_internal_variable_name name:$str -> bool { name "$" str::starts_with }

pub fn make_integer_op_value value:i64 -> OpValue {
    value IntegerLiteral::from_int OpValue::PushInt
}

pub struct LiteralPattern derives std::Clone {
    pub value: LiteralValue
    pub raw:   std::String
}

# PatternValue — tagged-union payload carried by OpMatchArm. Each match arm
# stores one of these in MatchArm::pattern_value; the variant tag both
# discriminates pattern shape and provides a typed payload.

pub enum PatternValue derives std::Clone {
    Struct (StructPattern)
    EnumVariant (EnumVariant)
    Literal (LiteralPattern)
}

pub struct SelectiveImport {
    pub path:      std::String
    pub namespace: std::String
    pub symbols:   std::List[std::String]
}

impl SelectiveImport: std::Clone {
    pub fn clone self:$SelectiveImport -> SelectiveImport {
        self.symbols.clone self.namespace.clone self.path.clone SelectiveImport
    }
}

pub struct ModuleImport {
    pub path:      std::String
    pub namespace: std::String
}

impl ModuleImport: std::Clone {
    pub fn clone self:$ModuleImport -> ModuleImport {
        self.namespace.clone self.path.clone ModuleImport
    }
}

pub struct GlobalInitializer derives std::Clone {
    pub name: std::String
    pub ops:  std::List[Op]
}

# OpValue — single tagged enum that classifies every Op. Each variant
# represents a distinct opcode; payload-bearing variants carry the
# typed inner value directly so call sites can destructure with `is`/`match`.

pub enum OpValue derives std::Clone {
    # Stack
    Drop
    Dup
    Copy
    Over
    Rot
    Swap
    # IO
    Print
    PrintBool
    PrintChar
    PrintCstr
    PrintInt
    PrintStr
    PrintString
    Typeof
    SizeOf (Type)
    # Memory
    HeapAlloc
    HeapFree
    Load8
    Load16
    Load32
    Load64
    PtrAsRef (Type)
    PtrAsMut (Type)
    PtrFromRaw (Type)
    PtrFromRef
    PtrIntoRaw
    PtrNull
    PtrRead (Type)
    Store8
    Store16
    Store32
    Store64
    PtrWrite (Type)
    StructMemberProject (StructMemberAccess)
    StructMemberStore (StructMemberAccess)
    # Syscalls
    Syscall0
    Syscall1
    Syscall2
    Syscall3
    Syscall4
    Syscall5
    Syscall6
    # Literals
    PushArray (std::List[Op])
    PushBool (i64)
    PushChar (i64)
    PushInt (IntegerLiteral)
    PushFloat (std::String)
    PushStr (std::String)
    # Arithmetic
    Add
    Sub
    Mul
    Div
    Mod
    WrappingAdd
    WrappingMul
    WrappingSub
    # Bitshift
    Shl
    Shr
    # Bitwise
    BitAnd
    BitOr
    BitXor
    BitNot
    # Boolean
    And
    Or
    Not
    # Comparison
    Eq
    Ge
    Gt
    Le
    Lt
    Ne
    # Functions
    FnCall (std::String)
    FnExec
    FnExecOwned
    FnPush (std::String)
    FnReturn
    Panic
    DestructionFn (Type)
    Question (std::String)
    QuestionMove (std::String)
    UnsafeStart
    UnsafeEnd
    OwnerCleanup
    MethodCall (std::String)
    QualifiedMethodCall (QualifiedMethod)
    TraitMethodCall (DeferredTraitCall)
    TraitMethodRef (DeferredTraitCall)
    # Loops
    WhileStart
    WhileCondition
    WhileBreak
    WhileContinue
    WhileEnd
    # Conditionals
    IfStart
    IfCondition
    IfElif
    IfElse
    IfEnd
    # Variables
    AssignDec (std::String)
    AssignInc (std::String)
    AssignVar (std::String)
    BindTemporary (TemporaryBinding)
    InitGlobal (GlobalInitializer)
    PushCapture (std::String)
    PushVar (std::String)
    # Enums
    PushEnumVariant (EnumVariant)
    IsCheck (EnumVariant)
    # Match
    MatchStart
    MatchArm (MatchArm)
    MatchEnd
    # Structs
    StructNew (CasaStruct)
    StructLiteral (StructLiteral)
    # Types
    NumericCall (NumericCall)
    NumericConvert (NumericConversion)
    NumericTry (NumericTry)
    IntegerTry (IntegerTry)
    FloatRound (FloatRound)
    FloatFromDecimal
    FloatSignificand
    # Import
    ImportFile (ModuleImport)
    ImportFileSelective (SelectiveImport)
    # F-strings
    FstringConcat (u64)
    FstringToStr
    PrimitiveToStr (BuiltinType)
    # Command-line arguments
    Argc
    Argv
    Envp
    # Expression group (multi-op element in array literals)
    ExprGroup (std::List[Op])
    # Identifier (resolved by parser)
    Identifier (std::String)
}

# OpValue family accessors — unwrap the typed payload shared by a family of
# variants. For call sites that gate on multiple variants (e.g. FnCall || FnPush)
# without duplicating the unwrap. Single-variant gates should destructure directly.

pub fn op_str_value op:$Op -> std::String {
    if op.value OpValue::FnCall(value) is then
        value.clone return
    fi
    if op.value OpValue::FnPush(value) is then
        value.clone return
    fi
    if op.value OpValue::MethodCall(value) is then
        value.clone return
    fi
    if op.value OpValue::PushStr(value) is then
        value.clone return
    fi
    if op.value OpValue::PushVar(value) is then
        value.clone return
    fi
    if op.value OpValue::PushCapture(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignVar(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignDec(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignInc(value) is then
        value.clone return
    fi
    if op.value OpValue::Question(value) is then
        value.clone return
    fi
    if op.value OpValue::ImportFile(value) is then
        value.path.clone return
    fi
    if op.value OpValue::Identifier(value) is then
        value.clone return
    fi
    "Internal error: op_str_value called on non-str op\n" std::eprint
    1 process::exit
    std::String::new
}

pub fn op_int_value op:$Op -> i64 {
    if op.value OpValue::PushBool(value) is then
        value return
    fi
    if op.value OpValue::PushChar(value) is then
        value return
    fi
    if op.value OpValue::PushInt(literal) is then
        literal.value return
    fi
    if op.value OpValue::FstringConcat(value) is then
        value i64::try_from.unwrap return
    fi
    "Internal error: op_int_value called on non-i64 op\n" std::eprint
    1 process::exit
    0
}

pub fn op_is_static_struct_literal group_ops:$std::List[Op] -> bool {
    if 0 group_ops.length == then
        false return
    fi
    group_ops.length 1 - group_ops.get = last_op
    if last_op Op::value OpValue::StructLiteral is ! then
        false return
    fi
    0 = i: u64
    while i group_ops.length 1 - > do
        if i group_ops.get op_is_static ! then
            false return
        fi
        1 += i
    done
    true
}

pub fn op_is_static_struct_literal_with_store store:$SymbolStore group_ops:$std::List[Op] -> bool {
    if 0 group_ops.length == then
        false return
    fi
    group_ops.length 1 - group_ops.get = last_op
    if last_op Op::value OpValue::StructLiteral is ! then
        false return
    fi
    0 = i: u64
    while i group_ops.length 1 - > do
        if i group_ops.get store op_is_static_with_store ! then
            false return
        fi
        1 += i
    done
    true
}

pub fn op_is_static op:$Op -> bool {
    if op.value OpValue::PushArray(inner) is then
        inner op_is_static_array return
    fi
    if op.value OpValue::ExprGroup(group_ops) is then
        group_ops op_is_static_struct_literal return
    fi
    op.value OpValue::PushInt is
    op.value OpValue::PushStr is ||
    op.value OpValue::PushBool is ||
    op.value OpValue::PushChar is ||
    op.value OpValue::PushEnumVariant is ||
}

pub fn op_is_static_with_store store:$SymbolStore op:$Op -> bool {
    if op.value OpValue::FnPush(fn_name) is then
        fn_name.as_str store.get_function = fn_opt
        if fn_opt std::Option::Some(function) is then
            0 function Function::captures.length == return
        fi
        false return
    fi
    if op.value OpValue::ExprGroup(group_ops) is then
        group_ops store op_is_static_struct_literal_with_store return
    fi
    op op_is_static
}

pub fn op_is_static_array items:$std::List[Op] -> bool {
    for item in items.iter do
        if item op_is_static ! then
            false return
        fi
    done
    true
}

pub fn op_is_static_array_with_store items:$std::List[Op] store:$SymbolStore -> bool {
    for item in items.iter do
        if item store op_is_static_with_store ! then
            false return
        fi
    done
    true
}

pub fn enum_variant_of op:Op -> EnumVariant {
    op.value.clone = value
    if value OpValue::PushEnumVariant(variant) is then
        variant.clone return
    fi
    if value OpValue::IsCheck(variant) is then
        variant.clone return
    fi
    "Internal error: enum_variant_of called on non-EnumVariant op\n" std::eprint
    1 process::exit
    std::Option[i64]::None "".to_str "".to_str EnumVariant::new
}
# MatchArm — wrapper stored on OpValue::MatchArm. Carries the pattern payload
# (typed via PatternValue) and an optional guard expression. `guard_ops` is
# empty for unguarded arms; when non-empty it is compiled after pattern
# bindings and produces a bool that diverts execution to the next arm when
# false.

pub struct MatchArm derives std::Clone {
    pub pattern_value: PatternValue
    pub guard_ops:     std::List[Op]
}

impl MatchArm {
    pub fn new pattern_value:PatternValue guard_ops:std::List[Op] -> MatchArm {
        guard_ops pattern_value MatchArm
    }
}

pub fn pattern_value_of op:$Op -> PatternValue {
    if op.value OpValue::MatchArm(arm) is then
        arm.pattern_value.clone return
    fi
    "Internal error: pattern_value_of called on non-MatchArm op\n" std::eprint
    1 process::exit
    "".to_str 0 IntegerLiteral::from_int LiteralValue::Int LiteralPattern PatternValue::Literal
}

pub fn pattern_guard_ops op:$Op -> std::List[Op] {
    if op.value OpValue::MatchArm(arm) is then
        arm.guard_ops.clone return
    fi
    "Internal error: pattern_guard_ops called on non-MatchArm op\n" std::eprint
    1 process::exit
    std::List[Op]::new
}

