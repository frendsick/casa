    source: Type
    target: BuiltinType
}

struct IntegerTry {
    kind:   IntegerTryKind
    target: BuiltinType
}

# OpValue is defined later because it depends on CasaStruct, EnumVariant,
# MatchArm, and StructLiteral. Each variant represents an opcode and carries
# its typed data when needed.

# ============================================================================
# InstValue enum
#
# One variant per low-level instruction. Payload-bearing variants pack the
# inner value directly so call sites destructure with `is`/`match`; bytecode
# is `List[InstValue]` with no per-element wrapper.
# ============================================================================

enum InstValue {
    # Stack
    Drop
    Dup
    Over
    Push (i64)
    PushFloat32 (str)
    PushFloat64 (str)
    PushChar (i64)
    PushStr (u64)
    Rot
    Swap
    # IO
    PrintBool
    PrintChar
    PrintCstr
    PrintInt
    PrintUint
    PrintStr
    # Memory
    HeapAlloc
    HeapFree
    Load8
    Load16
    Load32
    Load64
    BorrowTyped
    CopyTyped
    ReadTyped
    Store8
    Store16
    Store32
    Store64
    WriteTyped
    MoveBytes (u64)
    # Arithmetic
    Add
    CheckedAdd (BuiltinType)
    CheckedDiv (BuiltinType)
    CheckedMod (BuiltinType)
    CheckedMul (BuiltinType)
    CheckedShl (BuiltinType)
    CheckedShr (BuiltinType)
    CheckedSub (BuiltinType)
    Div
    FloatAdd32
    FloatAdd64
    FloatDiv32
    FloatDiv64
    FloatEq32
    FloatEq64
    FloatGe32
    FloatGe64
    FloatGt32
    FloatGt64
    FloatLe32
    FloatLe64
    FloatLt32
    FloatLt64
    FloatMul32
    FloatMul64
    FloatNe32
    FloatNe64
    FloatSub32
    FloatSub64
    FloatRound (FloatRound)
    FloatFromDecimal
    FloatSignificand
    Mod
    Mul
    Sub
    # Bitshift
    Shl
    Shr
    # Bitwise
    BitAnd
    BitOr
    BitXor
    BitNot
    # Boolean
    And
    Or
    Not
    # Comparison
    Eq
    Ge
    Gt
    Le
    Lt
    Ne
    Ult
    Ule
    Ugt
    Uge
    UDiv
    UMod
    UShr
    NormalizeInt (BuiltinType)
    NumericConvert (NumericConversion)
    NumericTry (NumericTry)
    IntegerTry (IntegerTry)
    # Functions
    FnCall (str)
    FnExec
    FnPush (str)
    FnReturn
    DynamicDrop
    DropFn (str)
    # Jumps
    Label (u64)
    Jump (u64)
    JumpNe (u64)
    # Locals
    LocalsInit (u64)
    LocalsUninit (u64)
    LocalGet (u64)
    LocalSet (u64)
    # Globals
    GlobalsInit (u64)
    GlobalGet (u64)
    GlobalSet (u64)
    # Constants
    ConstantLoad (u64)
    ConstantStore (u64)
    # Closures
    CaptureFlagClear (u64)
    CaptureFlagLoad (u64)
    CaptureFlagMark (u64)
    CaptureLoad (u64)
    CaptureSet (u64)
    ClosureDrop
    ClosureRecord (u64)
    FnPushStatic (str)
    # Strings
    StrEq
    # Static arrays
    PushStaticArray (u64)
    # F-strings
    FstringConcat (u64)
    PrimitiveToStr (BuiltinType)
    # Syscalls
    Syscall0
    Syscall1
    Syscall2
    Syscall3
    Syscall4
    Syscall5
    Syscall6
    # Command-line arguments
    Argc
    Argv
    Envp
}

