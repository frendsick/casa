# StackEffect utilities
# ============================================================================

pub fn stack_effect_to_str effect:$StackEffect -> std::String {
    std::String::new = builder
    if 0 effect StackEffect::parameters.length == then
        "None" builder.append
    else
        std::List[std::String]::new = se_param_strs
        for param in effect StackEffect::parameters.iter do
            param Parameter::typ.format se_param_strs.push
        done
        " " se_param_strs.join_strings builder.append_string
    fi
    " -> " builder.append
    if 0 effect StackEffect::return_types.length == then
        "None" builder.append
    else
        std::List[std::String]::new = se_return_strs
        for elem in effect StackEffect::return_types.iter do
            elem.format se_return_strs.push
        done
        " " se_return_strs.join_strings builder.append_string
    fi
    builder
}

pub fn stack_effect_to_function_type effect:$StackEffect -> Type {
    std::List[Type]::new = fn_params
    for fn_param in effect StackEffect::parameters.iter do
        fn_param Parameter::typ clone_type fn_params.push
    done
    std::List[Type]::new = fn_returns
    for fn_return in effect StackEffect::return_types.iter do
        fn_return clone_type fn_returns.push
    done
    fn_returns fn_params FunctionType Type::Function
}

pub fn function_type_to_stack_effect fn_type:$FunctionType -> StackEffect {
    std::List[Parameter]::new = params
    for param_type in fn_type FunctionType::parameters.iter do
        "".to_str param_type clone_type Parameter params.push
    done
    fn_type FunctionType::return_types.clone params StackEffect::new
}

pub fn stack_effect_type_param_matches
    expected:$Type
    actual:$Type
    type_vars:mut$std::Set[std::String]
-> bool {
    if expected actual.eq then
        true return
    fi
    if expected.is_unknown_placeholder then
        true return
    fi
    if actual.is_unknown_placeholder then
        true return
    fi
    if expected.type_var_name std::Option::Some(expected_name) is then
        if expected_name type_vars.has then
            true return
        fi
    fi
    if actual.type_var_name std::Option::Some(actual_name) is then
        if actual_name type_vars.has then
            true return
        fi
    fi
    false
}

pub fn collect_stack_effect_type_vars typ:$Type type_vars:mut$std::Set[std::String] {
    if typ.type_var_name std::Option::Some(type_var_name) is then
        type_var_name.clone type_vars.add
        return
    fi
    typ match
        Type::Generic(generic) => {
            for generic_param in generic.params.iter do
                type_vars generic_param collect_stack_effect_type_vars
            done
        }
        Type::Function(fn_type) => {
            for fn_param in fn_type.parameters.iter do
                type_vars fn_param collect_stack_effect_type_vars
            done
            for fn_return in fn_type.return_types.iter do
                type_vars fn_return collect_stack_effect_type_vars
            done
        }
        _ => {
        }
    end
}

pub fn stack_effect_type_matches expected:$Type actual:$Type -> bool {
    if expected actual.eq then
        true return
    fi
    if expected.is_unknown_placeholder then
        true return
    fi
    if actual.is_unknown_placeholder then
        true return
    fi
    expected clone_type = expected_pattern
    actual clone_type = actual_pattern
    expected_pattern match
        Type::Function(expected_fn) => {
            actual_pattern match
                Type::Function(actual_fn) => {
                    if 0 expected_fn.parameters.length == 0 expected_fn.return_types.length == && then
                        true return
                    fi
                    if 0 actual_fn.parameters.length == 0 actual_fn.return_types.length == && then
                        true return
                    fi
                    if expected_fn.parameters.length actual_fn.parameters.length != then
                        false return
                    fi
                    if expected_fn.return_types.length actual_fn.return_types.length != then
                        false return
                    fi
                    for
                        pair in actual_fn.parameters.iter expected_fn
                            .parameters
                            .iter
                            .zip
                    do
                        if pair.second pair.first stack_effect_type_matches ! then
                            false return
                        fi
                    done
                    for
                        pair in actual_fn.return_types.iter expected_fn
                            .return_types
                            .iter
                            .zip
                    do
                        if pair.second pair.first stack_effect_type_matches ! then
                            false return
                        fi
                    done
                    true return
                }
                _ => {
                }
            end
        }
        Type::Generic(expected_generic) => {
            actual_pattern match
                Type::Generic(actual_generic) => {
                    if expected_generic.base actual_generic.base != then
                        false return
                    fi
                    if expected_generic.params.length actual_generic.params.length != then
                        false return
                    fi
                    std::Set[std::String]::new = type_vars
                    type_vars expected collect_stack_effect_type_vars
                    type_vars actual collect_stack_effect_type_vars
                    for
                        pair in actual_generic.params.iter expected_generic
                            .params
                            .iter
                            .zip
                    do
                        if type_vars pair.second pair.first stack_effect_type_param_matches ! then
                            false return
                        fi
                    done
                    true return
                }
                _ => {
                }
            end
        }
        _ => {
        }
    end
    false
}

pub fn stack_effect_matches effect_a:$StackEffect effect_b:$StackEffect -> bool {
    # Check if two stack effects are compatible, respecting any types.
    if effect_a StackEffect::parameters.length effect_b StackEffect::parameters.length != then
        false return
    fi
    if effect_a StackEffect::return_types.length effect_b StackEffect::return_types.length != then
        false return
    fi

    for param_pair in effect_b StackEffect::parameters.iter effect_a StackEffect::parameters.iter.zip do
        param_pair.first Parameter::typ = type_a: $Type
        param_pair.second Parameter::typ = type_b: $Type
        if type_b type_a stack_effect_type_matches ! then
            false return
        fi
    done

    for
        return_pair in effect_b StackEffect::return_types.iter effect_a StackEffect::return_types.iter.zip
    do
        if return_pair.second return_pair.first stack_effect_type_matches ! then
            false return
        fi
    done

    true
}

pub fn apply_type_subs_to_stack_effect
    effect:$StackEffect
    subs:mut$std::Map[std::String Type]
-> StackEffect {
    std::List[Parameter]::new = params
    for param in effect StackEffect::parameters.iter do
        subs param Parameter::typ.substitute_t = new_typ
        param Parameter::name.clone new_typ Parameter::named params.push
    done
    std::List[Type]::new = returns
    for return_type in effect StackEffect::return_types.iter do
        subs return_type.substitute_t returns.push
    done
    effect.clone = resolved
    params resolved StackEffect::set_parameters
    returns resolved StackEffect::set_return_types
    resolved
}

pub fn resolve_trait_stack_effect effect:$StackEffect self_type:$Type -> StackEffect {
    std::Map[std::String Type]::new = substitutions
    self_type clone_type TRAIT_SELF_TYPE substitutions.set_str
    substitutions effect apply_type_subs_to_stack_effect
}

# ============================================================================
# Lookup functions (string -> enum ordinal)
# ============================================================================

impl KeywordKind {
    pub fn format_source self:$KeywordKind -> str {
        self match
            KeywordKind::Pub => "pub"
            KeywordKind::As => "as"
            KeywordKind::Unsafe => "unsafe"
            KeywordKind::Fn => "fn"
            KeywordKind::Impl => "impl"
            KeywordKind::Return => "return"
            KeywordKind::While => "while"
            KeywordKind::Do => "do"
            KeywordKind::Break => "break"
            KeywordKind::Continue => "continue"
            KeywordKind::Done => "done"
            KeywordKind::If => "if"
            KeywordKind::Then => "then"
            KeywordKind::Elif => "elif"
            KeywordKind::Else => "else"
            KeywordKind::Fi => "fi"
            KeywordKind::EnumKw => "enum"
            KeywordKind::StructKw => "struct"
            KeywordKind::TraitKw => "trait"
            KeywordKind::End => "end"
            KeywordKind::Match => "match"
            KeywordKind::Is => "is"
            KeywordKind::Import => "import"
            KeywordKind::For => "for"
            KeywordKind::In => "in"
            KeywordKind::Global => "global"
            KeywordKind::Const => "const"
            KeywordKind::Move => "move"
        end
    }
}

pub fn keyword_from_str value:$str -> std::Option[KeywordKind] {
    0 (u64) = keyword_index
    while keyword_index KeywordKind > do
        keyword_index (KeywordKind) = keyword
        if value keyword.format_source == then
            keyword std::Option::Some return
        fi
        1 += keyword_index
    done
    std::Option[KeywordKind]::None
}

impl IntrinsicKind {
    pub fn format_source self:$IntrinsicKind -> str {
        self match
            IntrinsicKind::Drop => "drop"
            IntrinsicKind::Dup => "dup"
            IntrinsicKind::Copy => "copy"
            IntrinsicKind::Over => "over"
            IntrinsicKind::Rot => "rot"
            IntrinsicKind::Swap => "swap"
            IntrinsicKind::Alloc => "alloc"
            IntrinsicKind::Free => "free"
            IntrinsicKind::Load8 => "load8"
            IntrinsicKind::Load16 => "load16"
            IntrinsicKind::Load32 => "load32"
            IntrinsicKind::Load64 => "load64"
            IntrinsicKind::Store8 => "store8"
            IntrinsicKind::Store16 => "store16"
            IntrinsicKind::Store32 => "store32"
            IntrinsicKind::Store64 => "store64"
            IntrinsicKind::Print => "print"
            IntrinsicKind::Typeof => "typeof"
            IntrinsicKind::SizeOf => "size_of"
            IntrinsicKind::Exec => "exec"
            IntrinsicKind::Syscall0 => "syscall0"
            IntrinsicKind::Syscall1 => "syscall1"
            IntrinsicKind::Syscall2 => "syscall2"
            IntrinsicKind::Syscall3 => "syscall3"
            IntrinsicKind::Syscall4 => "syscall4"
            IntrinsicKind::Syscall5 => "syscall5"
            IntrinsicKind::Syscall6 => "syscall6"
            IntrinsicKind::Argc => "argc"
            IntrinsicKind::Argv => "argv"
            IntrinsicKind::Envp => "envp"
        end
    }
}

pub fn intrinsic_from_str value:$str -> std::Option[IntrinsicKind] {
    0 (u64) = intrinsic_index
    while intrinsic_index IntrinsicKind > do
        intrinsic_index (IntrinsicKind) = intrinsic
        if value intrinsic.format_source == then
            intrinsic std::Option::Some return
        fi
        1 += intrinsic_index
    done
    if
        "print_int" value ==
        "print_str" value == ||
        "print_bool" value == ||
        "print_char" value == ||
    then
        IntrinsicKind::Print std::Option::Some
    else
        std::Option[IntrinsicKind]::None
    fi
}

pub fn operator_from_str value:$str -> std::Option[OperatorKind] {
    if "+" value == then
        OperatorKind::Plus std::Option::Some
    elif "-" value == then
        OperatorKind::Minus std::Option::Some
    elif "*" value == then
        OperatorKind::Mul std::Option::Some
    elif "/" value == then
        OperatorKind::Div std::Option::Some
    elif "%" value == then
        OperatorKind::Mod std::Option::Some
    elif "<<" value == then
        OperatorKind::Shl std::Option::Some
    elif ">>" value == then
        OperatorKind::Shr std::Option::Some
    elif "&" value == then
        OperatorKind::BitAnd std::Option::Some
    elif "|" value == then
        OperatorKind::BitOr std::Option::Some
    elif "^" value == then
        OperatorKind::BitXor std::Option::Some
    elif "~" value == then
        OperatorKind::BitNot std::Option::Some
    elif "&&" value == then
        OperatorKind::And std::Option::Some
    elif "||" value == then
        OperatorKind::Or std::Option::Some
    elif "!" value == then
        OperatorKind::Not std::Option::Some
    elif "==" value == then
        OperatorKind::Eq std::Option::Some
    elif ">=" value == then
        OperatorKind::Ge std::Option::Some
    elif ">" value == then
        OperatorKind::Gt std::Option::Some
    elif "<=" value == then
        OperatorKind::Le std::Option::Some
    elif "<" value == then
        OperatorKind::Lt std::Option::Some
    elif "!=" value == then
        OperatorKind::Ne std::Option::Some
    elif "=" value == then
        OperatorKind::Assign std::Option::Some
    elif "-=" value == then
        OperatorKind::AssignDec std::Option::Some
    elif "+=" value == then
        OperatorKind::AssignInc std::Option::Some
    elif "?" value == then
        OperatorKind::Question std::Option::Some
    else
        std::Option[OperatorKind]::None
    fi
}

pub fn delimiter_from_str value:$str -> std::Option[DelimiterKind] {
    if "->" value == then
        DelimiterKind::Arrow std::Option::Some
    elif "=>" value == then
        DelimiterKind::FatArrow std::Option::Some
    elif 1 value.length == then
        0 value.at delimiter_from_char
    else
        std::Option[DelimiterKind]::None
    fi
}

pub fn delimiter_from_char c:char -> std::Option[DelimiterKind] {
    if ',' c == then
        DelimiterKind::Comma std::Option::Some
    elif ':' c == then
        DelimiterKind::Colon std::Option::Some
    elif '.' c == then
        DelimiterKind::Dot std::Option::Some
    elif '#' c == then
        DelimiterKind::Hashtag std::Option::Some
    elif '{' c == then
        DelimiterKind::OpenBrace std::Option::Some
    elif '}' c == then
        DelimiterKind::CloseBrace std::Option::Some
    elif '[' c == then
        DelimiterKind::OpenBracket std::Option::Some
    elif ']' c == then
        DelimiterKind::CloseBracket std::Option::Some
    elif '(' c == then
        DelimiterKind::OpenParen std::Option::Some
    elif ')' c == then
        DelimiterKind::CloseParen std::Option::Some
    else
        std::Option::None
    fi
}

