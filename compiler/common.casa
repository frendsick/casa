# Token kinds
# ============================================================================

pub enum TokenKind derives std::Eq std::Copy {
    Comment
    Delimiter
    Eof
    FstringEnd
    FstringExprEnd
    FstringExprStart
    FstringStart
    FstringText
    Identifier
    Intrinsic
    Keyword
    Literal
    Newline
    Operator
}

