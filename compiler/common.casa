# Core data structures
pub struct Span derives std::Clone {
    pub offset: u64
    pub length: u64
}

pub struct SourcePosition derives std::Clone {
    pub line:   u64
    pub column: u64
}

impl SourcePosition {
    pub fn new line:u64 column:u64 -> SourcePosition { column line SourcePosition }
}

pub struct Location {
    data: ptr
}

struct LocationData {
    references: u64
    file:       std::String
    span:       Span
}

impl Location {
    pub fn new file:std::String offset:u64 length:u64 -> Location {
        # SAFETY: The first handle owns the complete location backing.
        unsafe { length offset Span file 1 LocationData ptr::into_raw Location }
    }

    pub fn file self:$Location -> $std::String {
        # SAFETY: The handle retains immutable backing for the returned borrow.
        unsafe { self.data ptr::as_ref[LocationData].file }
    }

    pub fn span self:$Location -> $Span {
        # SAFETY: The handle retains immutable backing for the returned borrow.
        unsafe { self.data ptr::as_ref[LocationData].span }
    }

    pub fn matches self:$Location other:$Location -> bool {
        self.file other.file ==
        self.span.offset other.span.offset == &&
        self.span.length other.span.length == &&
    }

    pub fn with_span self:$Location offset:u64 length:u64 -> Location {
        length offset self.file.clone Location::new
    }

    pub fn drop self:mut$Location {
        if ptr::null self.data == then
            return
        fi
        # SAFETY: Each handle releases one reference, and the last frees the backing.
        unsafe {
            self.data load64 1 - = remaining
            remaining self.data store64
            if 0 remaining == then
                self.data ptr::from_raw[LocationData] drop
            fi
            ptr::null = self.data
        }
    }
}

impl Location: std::Clone {
    pub fn clone self:$Location -> Location {
        # SAFETY: Compiler requests access their immutable locations on one thread.
        unsafe {
            self.data load64 1 + self.data store64
            self.data Location
        }
    }
}

pub fn empty_location -> Location { 0 0 "".to_str Location::new }

pub struct Token derives std::Clone {
    pub value:    std::String
    pub kind:     TokenKind
    pub location: Location
}

impl Token {
    pub fn new value:std::String kind:TokenKind location:$Location -> Token {
        location.clone kind value Token
    }
}
# Op value types
#
# Op stores its opcode and any associated data in `value`. Opcodes such as
# Add, Drop, and IfStart have no data. Other opcodes carry typed data that call
# sites unpack with `is` or `match`.
pub struct Op derives std::Clone {
    pub id:                   i64
    pub location:             Location
    pub type_hint:            std::Option[Type]
    pub deferred_return_hint: std::Option[Type]
    pub call_bindings:        std::Map[std::String Type]
    pub value:                OpValue
    pub ownership:            std::Option[OpOwnership]
    pub bindings:             std::Option[std::List[BindingFact]]
}

# A binding occurrence retains source spelling and a checker-selected storage identity.
pub struct CheckedBinding derives std::Clone {
    pub name:         std::String
    pub storage_name: std::String
    pub typ:          Type
}

pub struct BindingReference derives std::Clone {
    pub name:         std::String
    pub storage_name: std::String
}

pub enum BindingFact derives std::Clone {
    Definition (CheckedBinding)
    Reference (BindingReference)
}

impl BindingFact {
    pub fn get_name self:$BindingFact -> $std::String {
        self match
            BindingFact::Definition(binding) => binding.name
            BindingFact::Reference(binding) => binding.name
        end
    }

    pub fn get_storage_name self:$BindingFact -> $std::String {
        self match
            BindingFact::Definition(binding) => binding.storage_name
            BindingFact::Reference(binding) => binding.storage_name
        end
    }
}

pub struct OwnerEvent derives std::Clone {
    pub name:         std::String
    pub typ:          Type
    pub generation:   u64
    pub storage_name: std::String
}

impl OwnerEvent {
    pub fn new name:$str typ:$Type generation:u64 -> OwnerEvent {
        name.to_str generation typ.clone name.to_str OwnerEvent
    }
}

pub struct OpOwnership derives std::Clone {
    pub assignments:      std::List[OwnerEvent]
    pub cleanups:         std::List[OwnerEvent]
    pub conditional_move: std::Option[std::String]
    pub moves_owner:      bool
}

impl OpOwnership {
    pub fn new -> OpOwnership {
        false std::Option[std::String]::None std::List[OwnerEvent]::new
        std::List[OwnerEvent]::new OpOwnership
    }
}

pub struct QualifiedMethod derives std::Clone {
    pub type_qualified: bool
    pub qualifier_type: Type
    pub method_name:    std::String
}

# A checked trait-bound operation keeps its declared contract until a concrete
# specialization can select the implementation.
pub struct DeferredTraitCall derives std::Clone {
    pub method_name:  std::String
    pub receiver:     Type
    pub trait_type:   std::Option[Type]
    pub stack_effect: StackEffect
}

impl DeferredTraitCall {
    pub fn unresolved method_name:std::String receiver:Type -> DeferredTraitCall {
        empty_stack_effect std::Option[Type]::None receiver method_name DeferredTraitCall
    }

    pub fn new
        method_name:std::String
        receiver:Type
        trait_type:std::Option[Type]
        stack_effect:StackEffect
    -> DeferredTraitCall {
        stack_effect trait_type receiver method_name DeferredTraitCall
    }

    pub fn substitute
        self:$DeferredTraitCall
        bindings:mut$std::Map[std::String Type]
    -> DeferredTraitCall {
        bindings self.stack_effect apply_type_subs_to_stack_effect = effect
        self.trait_type.clone = trait_type
        if trait_type std::Option::Some(bound) is then
            bindings bound.substitute_t std::Option::Some = trait_type
        fi
        effect trait_type bindings self.receiver.substitute_t
        self.method_name.clone
        DeferredTraitCall
    }
}

pub struct TemporaryBinding derives std::Clone {
    pub name:  std::String
    pub depth: u64
}

# Type checking assigns each operation a stable ID. Dense operation lists can
# relocate their elements, so metadata must not use element addresses.
impl Op {
    pub fn add_binding_fact self:mut$Op fact:BindingFact {
        if self.bindings.is_none then
            [fact] std::List::from_array std::Option::Some = self.bindings
            return
        fi
        if self.bindings std::Option::Some(facts) is then
            fact facts.push
        fi
    }

    pub fn ensure_ownership self:mut$Op -> mut$OpOwnership {
        if self.ownership.is_none then
            OpOwnership::new std::Option::Some = self.ownership
        fi
        if self.ownership std::Option::Some(ownership) is then
            ownership return
        fi
        "Internal error: missing operation ownership" panic
    }

    pub fn moves_owner self:$Op -> bool {
        if self.ownership std::Option::Some(ownership) is then
            ownership.moves_owner return
        fi
        false
    }

    pub fn resolve_constant self:mut$Op constant:$Constant {
        if constant.typ std::Option::Some(builtin) is then
            builtin Type::Builtin std::Option::Some = self.type_hint
        fi
        constant
            .value
            .clone
            .into_op_value = self.value
    }

    pub fn new value:OpValue location:$Location -> Op {
        std::Option[std::List[BindingFact]]::None std::Option[OpOwnership]::None value std::Map[std::String Type]::new std::Option[Type]::None std::Option[Type]::None location.clone 0 Op
    }

    # The source builder transfers its origin into checker-owned work.
    pub fn from_source value:OpValue location:Location -> Op {
        std::Option[std::List[BindingFact]]::None std::Option[OpOwnership]::None value std::Map[std::String Type]::new std::Option[Type]::None std::Option[Type]::None location 0 Op
    }
}

pub fn op_identity op:$Op -> i64 { op.id }

pub fn substituted_constant_value
    name:$std::String
    subs:mut$std::Map[std::String Type]
-> std::Option[OpValue] {
    if name subs.get std::Option::Some(bound) is then
        if bound Type::Const(constant) is then
            if constant.is_symbolic then
                std::Option[OpValue]::None return
            fi
            if constant.typ BuiltinType::Bool == then
                constant.value OpValue::PushBool std::Option::Some return
            fi
            if constant.typ BuiltinType::Char == then
                constant.value OpValue::PushChar std::Option::Some return
            fi
            if constant.typ BuiltinType::U64 == 0 constant.value < && then
                constant.value constant.value u64::wrapping_from.to_str IntegerLiteral::new OpValue::PushInt std::Option::Some return
            fi
            constant.value make_integer_op_value std::Option::Some return
        fi
    fi
    std::Option[OpValue]::None
}

pub fn substitute_op_value_type
    value:$OpValue
    subs:mut$std::Map[std::String Type]
-> std::Option[OpValue] {
    value match
        OpValue::NumericTry(numeric_try) => {
            numeric_try.target subs numeric_try.source.substitute_t NumericTry
            OpValue::NumericTry std::Option::Some
        }
        OpValue::SizeOf(target) => {
            subs target.substitute_t OpValue::SizeOf std::Option::Some
        }
        OpValue::PtrRead(target) => {
            subs target.substitute_t OpValue::PtrRead std::Option::Some
        }
        OpValue::PtrWrite(target) => {
            subs target.substitute_t OpValue::PtrWrite std::Option::Some
        }
        OpValue::PtrAsRef(target) => {
            subs target.substitute_t OpValue::PtrAsRef std::Option::Some
        }
        OpValue::PtrAsMut(target) => {
            subs target.substitute_t OpValue::PtrAsMut std::Option::Some
        }
        OpValue::PtrFromRaw(target) => {
            subs target.substitute_t OpValue::PtrFromRaw std::Option::Some
        }
        OpValue::DestructionFn(target) => {
            subs target.substitute_t OpValue::DestructionFn std::Option::Some
        }
        OpValue::TraitMethodCall(call) => {
            subs call.substitute OpValue::TraitMethodCall std::Option::Some
        }
        OpValue::TraitMethodRef(call) => {
            subs call.substitute OpValue::TraitMethodRef std::Option::Some
        }
        OpValue::PushVar(name) => subs name substituted_constant_value
        OpValue::PushCapture(name) => subs name substituted_constant_value
        _ => std::Option::None
    end
}

pub fn substitute_ops_types ops:mut$std::List[Op] subs:mut$std::Map[std::String Type] {
    0 = op_index: u64
    while op_index ops.length > do
        op_index ops.get_mut = sub_op
        subs sub_op.value substitute_op_value_type = replacement
        replacement match
            std::Option::Some(value) => value sub_op Op::set_value
            std::Option::None => {
            }
        end
        if sub_op Op::type_hint std::Option::Some(hint) is then
            subs hint.substitute_t = substituted_hint
            substituted_hint std::Option::Some sub_op Op::set_type_hint
        fi
        if sub_op Op::deferred_return_hint std::Option::Some(deferred_hint) is then
            subs deferred_hint.substitute_t std::Option::Some sub_op Op::set_deferred_return_hint
        fi
        std::Map[std::String Type]::new = substituted_bindings
        for pair in sub_op.call_bindings.iter do
            subs pair.second.substitute_t pair.first.clone substituted_bindings.set
        done
        substituted_bindings = sub_op.call_bindings
        sub_op.value match
            OpValue::PushArray(items) => subs items substitute_ops_types
            OpValue::ExprGroup(items) => subs items substitute_ops_types
            OpValue::MatchArm(arm) => subs arm.guard_ops substitute_ops_types
            _ => {
            }
        end
        1 += op_index
    done
}
# Stack effect types
pub struct Parameter derives std::Clone {
    pub typ:      Type
    pub name:     std::String
    # Only written parameter names have a source declaration.
    pub location: std::Option[Location]
}

impl Parameter {
    pub fn new typ:$Type -> Parameter { std::Option[Location]::None "".to_str typ.clone Parameter }

    pub fn named typ:$Type name:std::String -> Parameter {
        std::Option[Location]::None name typ.clone Parameter
    }
}

pub struct StackEffect derives std::Clone {
    pub parameters:   std::List[Parameter]
    pub return_types: std::List[Type]
    pub type_vars:    std::Set[std::String]
    pub trait_bounds: std::Map[std::String std::List[TraitBound]]
    pub const_params: std::Map[std::String BuiltinType]
}

pub fn empty_stack_effect -> StackEffect {
    std::Map[std::String BuiltinType]::new
    std::Map[std::String std::List[TraitBound]]::new
    std::Set[std::String]::new
    std::List[Type]::new
    std::List[Parameter]::new
    StackEffect
}

impl StackEffect {
    pub fn new params:std::List[Parameter] returns:std::List[Type] -> StackEffect {
        std::Map[std::String BuiltinType]::new
        std::Map[std::String std::List[TraitBound]]::new
        std::Set[std::String]::new
        returns
        params
        StackEffect
    }
}
# Variable, Member
pub enum ConstantValue derives std::Clone {
    Int (IntegerLiteral)
    Float (std::String)
    Str (std::String)
    Bool (i64)
    Char (i64)
}

impl ConstantValue {
    pub fn into_op_value self:ConstantValue -> OpValue {
        self match
            ConstantValue::Int(value) => value OpValue::PushInt
            ConstantValue::Float(value) => value OpValue::PushFloat
            ConstantValue::Str(value) => value OpValue::PushStr
            ConstantValue::Bool(value) => value OpValue::PushBool
            ConstantValue::Char(value) => value OpValue::PushChar
        end
    }
}

pub struct Constant derives std::Clone {
    pub name:     std::String
    pub value:    ConstantValue
    pub typ:      std::Option[BuiltinType]
    pub location: Location
}

pub struct Variable derives std::Clone {
    pub name: std::String
    pub typ:  Type
}

impl Variable {
    pub fn new name:$str -> Variable { Type::Unknown name.to_str Variable }
}

pub struct Member derives std::Clone {
    pub name: std::String
    pub typ:  Type
}

# Enum-related types
pub struct EnumVariant derives std::Clone {
    pub enum_name:         std::String
    pub variant_name:      std::String
    pub ordinal:           std::Option[i64]
    pub bindings:          std::List[std::String]
    pub binding_locations: std::Map[std::String Location]
}

impl EnumVariant {
    pub fn new
        enum_name:std::String
        variant_name:std::String
        ordinal:std::Option[i64]
    -> EnumVariant {
        std::Map[std::String Location]::new std::List[std::String]::new ordinal variant_name enum_name EnumVariant
    }
}

pub struct StructLiteral derives std::Clone {
    pub struct_name: std::String
    pub field_order: std::List[std::String]
}

# Generated struct accessors resolve field storage after all imports and
# forward declarations are available.
pub struct StructMemberAccess derives std::Clone {
    pub struct_name:  std::String
    pub member_index: u64
}

pub enum MemberAccessKind derives std::Copy std::Eq {
    Read
    Write
}

pub struct MemberAccessor derives std::Clone {
    pub member: StructMemberAccess
    pub kind:   MemberAccessKind
}

pub struct StructPattern derives std::Clone {
    pub struct_name:       std::String
    pub bindings:          std::Map[std::String std::String]
    pub binding_locations: std::Map[std::String Location]
}

pub enum LiteralValue derives std::Clone {
    Int (IntegerLiteral)
    Str (std::String)
    Bool (bool)
    Char (i64)
}

pub struct IntegerLiteral derives std::Clone {
    pub raw:   std::String
    pub value: i64
}

impl IntegerLiteral {
    pub fn new raw:std::String value:i64 -> IntegerLiteral { value raw IntegerLiteral }

    pub fn from_int value:i64 -> IntegerLiteral { value value.to_str IntegerLiteral::new }

    pub fn get_normalized_magnitude self:$IntegerLiteral -> std::String {
        0 = start: u64
        if 0 self.raw.length != then
            if '-' 0 self.raw.at == then
                1 = start: u64
            fi
        fi
        while start self.raw.length 1 - > do
            if '0' start self.raw.at != then
                break
            fi
            1 += start
        done
        self.raw.as_str start self.raw.length start - str::substring
    }

    pub fn fits_decimal_limit self:$IntegerLiteral limit:$str -> bool {
        self.get_normalized_magnitude = magnitude
        limit.to_str = normalized_limit
        if 0 limit.length != '-' 0 limit.at == && then
            limit 1 limit.length 1 - str::substring = normalized_limit
        fi
        if normalized_limit.length magnitude.length < then
            true return
        fi
        if normalized_limit.length magnitude.length > then
            false return
        fi
        0 = index: u64
        while index magnitude.length > do
            index magnitude.at.codepoint i64::from = value_character
            index normalized_limit.at.codepoint i64::from = limit_character
            if limit_character value_character < then
                true return
            fi
            if limit_character value_character > then
                false return
            fi
            1 += index
        done
        true
    }

    pub fn fits self:$IntegerLiteral target:$Type -> bool {
        if target.is_integer_type_t ! then
            false return
        fi
        false = negative
        if 0 self.raw.length != then
            '-' 0 self.raw.at == = negative
        fi
        if target Type::Builtin(builtin) is then
            if negative builtin.is_unsigned && then
                false return
            fi
        fi
        if negative then
            target.get_integer_min self.fits_decimal_limit
        else
            target.get_integer_max self.fits_decimal_limit
        fi
    }
}
# Source identifiers cannot start with `$`. Parser-generated storage uses this
# namespace so it can keep local move semantics even when emitted globally.
pub fn is_internal_variable_name name:$str -> bool { name "$" str::starts_with }

pub fn make_integer_op_value value:i64 -> OpValue {
    value IntegerLiteral::from_int OpValue::PushInt
}

pub struct LiteralPattern derives std::Clone {
    pub value: LiteralValue
    pub raw:   std::String
}

# PatternValue — tagged-union payload carried by OpMatchArm. Each match arm
# stores one of these in MatchArm::pattern_value; the variant tag both
# discriminates pattern shape and provides a typed payload.
pub enum PatternValue derives std::Clone {
    Struct (StructPattern)
    EnumVariant (EnumVariant)
    Literal (LiteralPattern)
}

# OpValue — single tagged enum that classifies every Op. Each variant
# represents a distinct opcode; payload-bearing variants carry the
# typed inner value directly so call sites can destructure with `is`/`match`.
pub enum OpValue derives std::Clone {
    # Checked only for diagnostics and source occurrences. Never emitted by a backend.
    Unreachable (std::List[Op])
    # A rejected source operation, with its diagnostic retained.
    Rejected
    # Stack
    Drop
    Dup
    Copy
    Over
    Rot
    Swap
    # IO
    Print
    PrintBool
    PrintChar
    PrintCstr
    PrintInt
    PrintStr
    PrintString
    Typeof
    SizeOf (Type)
    # Memory
    HeapAlloc
    HeapFree
    Load8
    Load16
    Load32
    Load64
    PtrAsRef (Type)
    PtrAsMut (Type)
    PtrFromRaw (Type)
    PtrFromRef
    PtrIntoRaw
    PtrNull
    PtrRead (Type)
    Store8
    Store16
    Store32
    Store64
    PtrWrite (Type)
    StructMemberProject (StructMemberAccess)
    StructMemberStore (StructMemberAccess)
    # Syscalls
    Syscall0
    Syscall1
    Syscall2
    Syscall3
    Syscall4
    Syscall5
    Syscall6
    # Literals
    PushArray (std::List[Op])
    PushBool (i64)
    PushChar (i64)
    PushInt (IntegerLiteral)
    PushFloat (std::String)
    PushStr (std::String)
    # Arithmetic
    Add
    Sub
    Mul
    Div
    Mod
    WrappingAdd
    WrappingMul
    WrappingSub
    # Bitshift
    Shl
    Shr
    # Bitwise
    BitAnd
    BitOr
    BitXor
    BitNot
    # Boolean
    And
    Or
    Not
    # Comparison
    Eq
    Ge
    Gt
    Le
    Lt
    Ne
    # Functions
    FnCall (std::String)
    FnExec
    FnExecOwned
    FnPush (std::String)
    FnReturn
    Panic
    DestructionFn (Type)
    Question (std::String)
    QuestionMove (std::String)
    UnsafeStart
    UnsafeEnd
    OwnerCleanup
    MethodCall (std::String)
    QualifiedMethodCall (QualifiedMethod)
    TraitMethodCall (DeferredTraitCall)
    TraitMethodRef (DeferredTraitCall)
    # Loops
    WhileStart
    WhileCondition
    WhileBreak
    WhileContinue
    WhileEnd
    # Conditionals
    IfStart
    IfCondition
    IfElif
    IfElse
    IfEnd
    # Variables
    AssignDec (std::String)
    AssignInc (std::String)
    AssignVar (std::String)
    BindTemporary (TemporaryBinding)
    PushCapture (std::String)
    PushVar (std::String)
    # Enums
    PushEnumVariant (EnumVariant)
    IsCheck (EnumVariant)
    # Match
    MatchStart
    MatchArm (MatchArm)
    MatchEnd
    # Structs
    StructNew (CasaStruct)
    StructLiteral (StructLiteral)
    # Types
    NumericCall (NumericCall)
    NumericConvert (NumericConversion)
    NumericTry (NumericTry)
    IntegerTry (IntegerTry)
    FloatRound (FloatRound)
    FloatFromDecimal
    FloatSignificand
    # Import
    # F-strings
    FstringConcat (u64)
    FstringToStr
    PrimitiveToStr (BuiltinType)
    # Command-line arguments
    Argc
    Argv
    Envp
    # Expression group (multi-op element in array literals)
    ExprGroup (std::List[Op])
    # Identifier (resolved by parser)
    Identifier (std::String)
}

# OpValue family accessors — unwrap the typed payload shared by a family of
# variants. For call sites that gate on multiple variants (e.g. FnCall || FnPush)
# without duplicating the unwrap. Single-variant gates should destructure directly.
pub fn op_str_value op:$Op -> std::String {
    if op.value OpValue::FnCall(value) is then
        value.clone return
    fi
    if op.value OpValue::FnPush(value) is then
        value.clone return
    fi
    if op.value OpValue::MethodCall(value) is then
        value.clone return
    fi
    if op.value OpValue::PushStr(value) is then
        value.clone return
    fi
    if op.value OpValue::PushVar(value) is then
        value.clone return
    fi
    if op.value OpValue::PushCapture(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignVar(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignDec(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignInc(value) is then
        value.clone return
    fi
    if op.value OpValue::Question(value) is then
        value.clone return
    fi
    if op.value OpValue::Identifier(value) is then
        value.clone return
    fi
    "Internal error: op_str_value called on non-str op\n" std::eprint
    1 process::exit
    std::String::new
}

pub fn op_int_value op:$Op -> i64 {
    if op.value OpValue::PushBool(value) is then
        value return
    fi
    if op.value OpValue::PushChar(value) is then
        value return
    fi
    if op.value OpValue::PushInt(literal) is then
        literal.value return
    fi
    if op.value OpValue::FstringConcat(value) is then
        value i64::try_from.unwrap return
    fi
    "Internal error: op_int_value called on non-i64 op\n" std::eprint
    1 process::exit
    0
}

pub fn op_is_static_struct_literal group_ops:$std::List[Op] -> bool {
    if 0 group_ops.length == then
        false return
    fi
    group_ops.length 1 - group_ops.get = last_op
    if last_op Op::value OpValue::StructLiteral is ! then
        false return
    fi
    0 = i: u64
    while i group_ops.length 1 - > do
        if i group_ops.get op_is_static ! then
            false return
        fi
        1 += i
    done
    true
}

pub fn op_is_static_struct_literal_with_store store:$SymbolStore group_ops:$std::List[Op] -> bool {
    if 0 group_ops.length == then
        false return
    fi
    group_ops.length 1 - group_ops.get = last_op
    if last_op Op::value OpValue::StructLiteral is ! then
        false return
    fi
    0 = i: u64
    while i group_ops.length 1 - > do
        if i group_ops.get store op_is_static_with_store ! then
            false return
        fi
        1 += i
    done
    true
}

pub fn op_is_static op:$Op -> bool {
    if op.value OpValue::PushArray(inner) is then
        inner op_is_static_array return
    fi
    if op.value OpValue::ExprGroup(group_ops) is then
        group_ops op_is_static_struct_literal return
    fi
    op.value OpValue::PushInt is
    op.value OpValue::PushStr is ||
    op.value OpValue::PushBool is ||
    op.value OpValue::PushChar is ||
    op.value OpValue::PushEnumVariant is ||
}

pub fn op_is_static_with_store store:$SymbolStore op:$Op -> bool {
    if op.value OpValue::FnPush(fn_name) is then
        fn_name.as_str store.get_function = fn_opt
        if fn_opt std::Option::Some(function) is then
            0 function Function::captures.length == return
        fi
        false return
    fi
    if op.value OpValue::ExprGroup(group_ops) is then
        group_ops store op_is_static_struct_literal_with_store return
    fi
    op op_is_static
}

pub fn op_is_static_array items:$std::List[Op] -> bool {
    for item in items.iter do
        if item op_is_static ! then
            false return
        fi
    done
    true
}

pub fn op_is_static_array_with_store items:$std::List[Op] store:$SymbolStore -> bool {
    for item in items.iter do
        if item store op_is_static_with_store ! then
            false return
        fi
    done
    true
}

pub fn enum_variant_of op:Op -> EnumVariant {
    op.value.clone = value
    if value OpValue::PushEnumVariant(variant) is then
        variant.clone return
    fi
    if value OpValue::IsCheck(variant) is then
        variant.clone return
    fi
    "Internal error: enum_variant_of called on non-EnumVariant op\n" std::eprint
    1 process::exit
    std::Option[i64]::None "".to_str "".to_str EnumVariant::new
}
# MatchArm — wrapper stored on OpValue::MatchArm. Carries the pattern payload
# (typed via PatternValue) and an optional guard expression. `guard_ops` is
# empty for unguarded arms; when non-empty it is compiled after pattern
# bindings and produces a bool that diverts execution to the next arm when
# false.
pub struct MatchArm derives std::Clone {
    pub pattern_value: PatternValue
    pub guard_ops:     std::List[Op]
    pub guard_end:     std::Option[u64]
}

impl MatchArm {
    pub fn new pattern_value:PatternValue guard_ops:std::List[Op] -> MatchArm {
        std::Option[u64]::None guard_ops pattern_value MatchArm
    }
}

pub fn pattern_value_of op:$Op -> PatternValue {
    if op.value OpValue::MatchArm(arm) is then
        arm.pattern_value.clone return
    fi
    "Internal error: pattern_value_of called on non-MatchArm op\n" std::eprint
    1 process::exit
    "".to_str 0 IntegerLiteral::from_int LiteralValue::Int LiteralPattern PatternValue::Literal
}

pub fn pattern_guard_ops op:$Op -> std::List[Op] {
    if op.value OpValue::MatchArm(arm) is then
        arm.guard_ops.clone return
    fi
    "Internal error: pattern_guard_ops called on non-MatchArm op\n" std::eprint
    1 process::exit
    std::List[Op]::new
}

