# ============================================================================
# Core data structures
# ============================================================================

struct Span {
    offset: u64
    length: u64
}

struct SourcePosition {
    line:   u64
    column: u64
}

impl Span: Clone {
    fn clone self:$Span -> Span { self.length self.offset Span }
}

impl SourcePosition: Clone {
    fn clone self:$SourcePosition -> SourcePosition { self.column self.line SourcePosition }
}

impl SourcePosition {
    fn new line:u64 column:u64 -> SourcePosition { column line SourcePosition }
}

struct Location {
    file: str
    span: Span
}

impl Location {
    fn new file:str offset:u64 length:u64 -> Location { length offset Span file Location }
}

impl Location: Clone {
    fn clone self:$Location -> Location {
        self.span.length self.span.offset self.file.clone Location::new
    }
}

fn empty_location -> Location { 0 0 Span "" Location }

struct Token {
    value:    str
    kind:     TokenKind
    location: Location
}

impl Token {
    fn new value:str kind:TokenKind location:$Location -> Token { location.clone kind value Token }
}

impl Token: Clone {
    fn clone self:$Token -> Token { self.location.clone self.kind self.value.clone Token }
}

# ============================================================================
# Op value types
#
# Op stores its opcode and any associated data in `value`. Opcodes such as
# Add, Drop, and IfStart have no data. Other opcodes carry typed data that call
# sites unpack with `is` or `match`.
# ============================================================================

struct Op {
    id:                   i64
    location:             Location
    type_hint:            Option[Type]
    deferred_return_hint: Option[Type]
    value:                OpValue
}

struct OwnerEvent {
    name:       str
    typ:        Type
    generation: u64
}

impl OwnerEvent {
    fn new name:$str typ:$Type generation:u64 -> OwnerEvent {
        generation typ clone_type name.clone OwnerEvent
    }

    fn clone self:$OwnerEvent -> OwnerEvent {
        self.generation self.typ clone_type self.name.clone OwnerEvent
    }
}

struct OpOwnership {
    assignments: List[OwnerEvent]
    cleanups:    List[OwnerEvent]
    moves_owner: bool
}

impl OpOwnership {
    fn new -> OpOwnership { false List[OwnerEvent]::new List[OwnerEvent]::new OpOwnership }
}

impl OpOwnership: Clone {
    fn clone self:$OpOwnership -> OpOwnership {
        List[OwnerEvent]::new = assignments
        for event in self.assignments.iter do
            event.clone assignments.push
        done
        List[OwnerEvent]::new = cleanups
        for event in self.cleanups.iter do
            event.clone cleanups.push
        done
        self.moves_owner cleanups assignments OpOwnership
    }
}

struct QualifiedMethod {
    type_qualified: bool
    qualifier_type: Type
    method_name:    str
}

# Type checking assigns each operation a stable ID. Dense operation lists can
# relocate their elements, so metadata must not use element addresses.

impl Op {
    fn new value:OpValue location:$Location -> Op {
        value Option[Type]::None Option[Type]::None location.clone 0 Op
    }
}

fn op_identity op:$Op -> i64 { op.id }

fn ensure_op_ownership_address store:mut$SymbolStore op_id:i64 -> mut$OpOwnership {
    if op_id store.op_ownership.get_mut Option::Some(ownership) is then
        ownership return
    fi
    OpOwnership::new = ownership
    ownership op_id store.op_ownership.set
    op_id store
        .op_ownership
        .get_mut
        .unwrap
}

fn ensure_op_ownership store:mut$SymbolStore op:mut$Op -> mut$OpOwnership {
    op op_identity store ensure_op_ownership_address
}

fn add_owner_assignment store:mut$SymbolStore op:mut$Op event:OwnerEvent {
    op store ensure_op_ownership = ownership
    event ownership.assignments.push
}

fn add_owner_cleanup store:mut$SymbolStore op:mut$Op event:OwnerEvent {
    op store ensure_op_ownership = ownership
    event ownership.cleanups.push
}

fn set_moves_owner store:mut$SymbolStore op_id:i64 {
    op_id store ensure_op_ownership_address = ownership
    true = ownership.moves_owner
}

fn clone_qualified_method method:$QualifiedMethod -> QualifiedMethod {
    method.method_name.clone method.qualifier_type clone_type method.type_qualified QualifiedMethod
}

fn clone_struct_literal literal:$StructLiteral -> StructLiteral {
    literal.field_order.clone literal.struct_name.clone StructLiteral
}

fn clone_selective_import import_value:$SelectiveImport -> SelectiveImport {
    import_value.symbols.clone import_value.path.clone SelectiveImport
}

fn clone_op_value value:$OpValue -> OpValue {
    value match
        OpValue::SizeOf(typ) => typ clone_type OpValue::SizeOf
        OpValue::PtrAsRef(typ) => typ clone_type OpValue::PtrAsRef
        OpValue::PtrAsMut(typ) => typ clone_type OpValue::PtrAsMut
        OpValue::PtrIntoRaw => OpValue::PtrIntoRaw
        OpValue::PtrRead(typ) => typ clone_type OpValue::PtrRead
        OpValue::PtrWrite(typ) => typ clone_type OpValue::PtrWrite
        OpValue::PushArray(items) => items clone_ops OpValue::PushArray
        OpValue::PushBool(boolean_value) => boolean_value OpValue::PushBool
        OpValue::PushChar(character_value) => character_value OpValue::PushChar
        OpValue::PushInt(literal) => literal.value literal.raw.clone IntegerLiteral::new OpValue::PushInt
        OpValue::PushFloat(text) => text.clone OpValue::PushFloat
        OpValue::PushStr(text) => text.clone OpValue::PushStr
        OpValue::FnCall(name) => name.clone OpValue::FnCall
        OpValue::FnPush(name) => name.clone OpValue::FnPush
        OpValue::DestructionFn(typ) => typ clone_type OpValue::DestructionFn
        OpValue::Question(name) => name.clone OpValue::Question
        OpValue::QuestionMove(name) => name.clone OpValue::QuestionMove
        OpValue::MethodCall(name) => name.clone OpValue::MethodCall
        OpValue::QualifiedMethodCall(method) => method clone_qualified_method OpValue::QualifiedMethodCall
        OpValue::TraitMethodCall(name) => name.clone OpValue::TraitMethodCall
        OpValue::AssignDec(name) => name.clone OpValue::AssignDec
        OpValue::AssignInc(name) => name.clone OpValue::AssignInc
        OpValue::AssignVar(name) => name.clone OpValue::AssignVar
        OpValue::DeclareGlobal(name) => name.clone OpValue::DeclareGlobal
        OpValue::PushCapture(name) => name.clone OpValue::PushCapture
        OpValue::PushVar(name) => name.clone OpValue::PushVar
        OpValue::PushEnumVariant(variant) => variant.clone OpValue::PushEnumVariant
        OpValue::IsCheck(variant) => variant.clone OpValue::IsCheck
        OpValue::MatchArm(arm) => arm.clone OpValue::MatchArm
        OpValue::StructNew(casa_struct) => casa_struct.clone OpValue::StructNew
        OpValue::StructLiteral(literal) => literal clone_struct_literal OpValue::StructLiteral
        OpValue::NumericCall(call) => call.target call.method.clone NumericCall OpValue::NumericCall
        OpValue::NumericConvert(conversion) => {
            conversion.target conversion.source conversion.kind NumericConversion OpValue::NumericConvert
        }
        OpValue::NumericTry(numeric_try) => {
            numeric_try.target numeric_try.source clone_type NumericTry OpValue::NumericTry
        }
        OpValue::IntegerTry(integer_try) => {
            integer_try.target integer_try.kind IntegerTry OpValue::IntegerTry
        }
        OpValue::FloatRound(rounding) => {
            rounding.target rounding.method.clone FloatRound OpValue::FloatRound
        }
        OpValue::TypeCast(typ) => typ clone_type OpValue::TypeCast
        OpValue::ImportFile(path) => path.clone OpValue::ImportFile
        OpValue::ImportFileSelective(import_value) => {
            import_value clone_selective_import OpValue::ImportFileSelective
        }
        OpValue::FstringConcat(count) => count OpValue::FstringConcat
        OpValue::PrimitiveToStr(builtin) => builtin OpValue::PrimitiveToStr
        OpValue::ExprGroup(items) => items clone_ops OpValue::ExprGroup
        OpValue::Identifier(name) => name.clone OpValue::Identifier
        OpValue::Drop => OpValue::Drop
        OpValue::Dup => OpValue::Dup
        OpValue::Copy => OpValue::Copy
        OpValue::Over => OpValue::Over
        OpValue::Rot => OpValue::Rot
        OpValue::Swap => OpValue::Swap
        OpValue::Print => OpValue::Print
        OpValue::PrintBool => OpValue::PrintBool
        OpValue::PrintChar => OpValue::PrintChar
        OpValue::PrintCstr => OpValue::PrintCstr
        OpValue::PrintInt => OpValue::PrintInt
        OpValue::PrintStr => OpValue::PrintStr
        OpValue::Typeof => OpValue::Typeof
        OpValue::HeapAlloc => OpValue::HeapAlloc
        OpValue::HeapFree => OpValue::HeapFree
        OpValue::Load8 => OpValue::Load8
        OpValue::Load16 => OpValue::Load16
        OpValue::Load32 => OpValue::Load32
        OpValue::Load64 => OpValue::Load64
        OpValue::Store8 => OpValue::Store8
        OpValue::Store16 => OpValue::Store16
        OpValue::Store32 => OpValue::Store32
        OpValue::Store64 => OpValue::Store64
        OpValue::Syscall0 => OpValue::Syscall0
        OpValue::Syscall1 => OpValue::Syscall1
        OpValue::Syscall2 => OpValue::Syscall2
        OpValue::Syscall3 => OpValue::Syscall3
        OpValue::Syscall4 => OpValue::Syscall4
        OpValue::Syscall5 => OpValue::Syscall5
        OpValue::Syscall6 => OpValue::Syscall6
        OpValue::Add => OpValue::Add
        OpValue::Sub => OpValue::Sub
        OpValue::Mul => OpValue::Mul
        OpValue::Div => OpValue::Div
        OpValue::Mod => OpValue::Mod
        OpValue::WrappingAdd => OpValue::WrappingAdd
        OpValue::WrappingMul => OpValue::WrappingMul
        OpValue::WrappingSub => OpValue::WrappingSub
        OpValue::Shl => OpValue::Shl
        OpValue::Shr => OpValue::Shr
        OpValue::BitAnd => OpValue::BitAnd
        OpValue::BitOr => OpValue::BitOr
        OpValue::BitXor => OpValue::BitXor
        OpValue::BitNot => OpValue::BitNot
        OpValue::And => OpValue::And
        OpValue::Or => OpValue::Or
        OpValue::Not => OpValue::Not
        OpValue::Eq => OpValue::Eq
        OpValue::Ge => OpValue::Ge
        OpValue::Gt => OpValue::Gt
        OpValue::Le => OpValue::Le
        OpValue::Lt => OpValue::Lt
        OpValue::Ne => OpValue::Ne
        OpValue::FnExec => OpValue::FnExec
        OpValue::FnExecOwned => OpValue::FnExecOwned
        OpValue::FnReturn => OpValue::FnReturn
        OpValue::UnsafeStart => OpValue::UnsafeStart
        OpValue::UnsafeEnd => OpValue::UnsafeEnd
        OpValue::OwnerCleanup => OpValue::OwnerCleanup
        OpValue::WhileStart => OpValue::WhileStart
        OpValue::WhileCondition => OpValue::WhileCondition
        OpValue::WhileBreak => OpValue::WhileBreak
        OpValue::WhileContinue => OpValue::WhileContinue
        OpValue::WhileEnd => OpValue::WhileEnd
        OpValue::IfStart => OpValue::IfStart
        OpValue::IfCondition => OpValue::IfCondition
        OpValue::IfElif => OpValue::IfElif
        OpValue::IfElse => OpValue::IfElse
        OpValue::IfEnd => OpValue::IfEnd
        OpValue::MatchStart => OpValue::MatchStart
        OpValue::MatchEnd => OpValue::MatchEnd
        OpValue::FloatFromDecimal => OpValue::FloatFromDecimal
        OpValue::FloatSignificand => OpValue::FloatSignificand
        OpValue::FstringToStr => OpValue::FstringToStr
        OpValue::Argc => OpValue::Argc
        OpValue::Argv => OpValue::Argv
        OpValue::Envp => OpValue::Envp
    end
}

fn clone_op source_op:$Op -> Op {
    source_op.value clone_op_value
    source_op.deferred_return_hint.clone
    source_op.type_hint.clone
    source_op.location.clone
    source_op.id
    Op
}

impl Op: Clone {
    fn clone self:$Op -> Op { self clone_op }
}

fn clone_ops ops:$List[Op] -> List[Op] {
    List[Op]::new = result
    for source_op in ops.iter do
        source_op clone_op result.push
    done
    result
}

fn substitute_op_value_type value:$OpValue subs:mut$Map[str Type] -> Option[OpValue] {
    value match
        OpValue::TypeCast(cast_type) => {
            subs cast_type.substitute_t OpValue::TypeCast Option::Some
        }
        OpValue::NumericTry(numeric_try) => {
            numeric_try.target subs numeric_try.source.substitute_t NumericTry
            OpValue::NumericTry Option::Some
        }
        OpValue::SizeOf(target) => {
            subs target.substitute_t OpValue::SizeOf Option::Some
        }
        OpValue::PtrRead(target) => {
            subs target.substitute_t OpValue::PtrRead Option::Some
        }
        OpValue::PtrWrite(target) => {
            subs target.substitute_t OpValue::PtrWrite Option::Some
        }
        OpValue::PtrAsRef(target) => {
            subs target.substitute_t OpValue::PtrAsRef Option::Some
        }
        OpValue::PtrAsMut(target) => {
            subs target.substitute_t OpValue::PtrAsMut Option::Some
        }
        _ => Option::None
    end
}

fn substitute_ops_types ops:mut$List[Op] subs:mut$Map[str Type] {
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get_mut = sub_op
        subs sub_op.value substitute_op_value_type = replacement
        replacement match
            Option::Some(value) => value sub_op Op::set_value
            Option::None => {
            }
        end
        if sub_op Op::type_hint Option::Some(hint) is then
            subs hint.substitute_t = substituted_hint
            substituted_hint Option::Some sub_op Op::set_type_hint
        fi
        if sub_op Op::deferred_return_hint Option::Some(deferred_hint) is then
            subs deferred_hint.substitute_t Option::Some sub_op Op::set_deferred_return_hint
        fi
        sub_op.value clone_op_value = nested_value
        if nested_value OpValue::PushArray(items) is then
            items clone_ops = owned_items
            subs owned_items substitute_ops_types
            owned_items OpValue::PushArray sub_op Op::set_value
        elif nested_value OpValue::ExprGroup(items) is then
            items clone_ops = owned_items
            subs owned_items substitute_ops_types
            owned_items OpValue::ExprGroup sub_op Op::set_value
        fi
        1 += op_index
    done
}

# ============================================================================
# Stack effect types
# ============================================================================

struct Parameter {
    typ:  Type
    name: str
}

impl Parameter {
    fn new typ:$Type -> Parameter { "" typ clone_type Parameter }

    fn named typ:$Type name:$str -> Parameter { name.clone typ clone_type Parameter }
}

struct StackEffect {
    parameters:   List[Parameter]
    return_types: List[Type]
    type_vars:    Set[str]
    trait_bounds: Map[str List[TraitBound]]
    const_params: Map[str BuiltinType]
}

fn empty_stack_effect -> StackEffect {
    Map[str BuiltinType]::new
    Map[str List[TraitBound]]::new
    Set[str]::new
    List[Type]::new
    List[Parameter]::new
    StackEffect
}

impl StackEffect {
    fn new params:List[Parameter] returns:List[Type] -> StackEffect {
        Map[str BuiltinType]::new
        Map[str List[TraitBound]]::new
        Set[str]::new
        returns
        params
        StackEffect
    }
}

# ============================================================================
# Variable, Member
# ============================================================================

enum ConstantValue {
    Int (IntegerLiteral)
    Float (str)
    Str (str)
    Bool (i64)
    Char (i64)
}

fn clone_constant_value value:$ConstantValue -> ConstantValue {
    value match
        ConstantValue::Int(literal) => literal.value literal.raw.clone IntegerLiteral::new ConstantValue::Int
        ConstantValue::Float(text) => text.clone ConstantValue::Float
        ConstantValue::Str(text) => text.clone ConstantValue::Str
        ConstantValue::Bool(boolean) => boolean ConstantValue::Bool
        ConstantValue::Char(character) => character ConstantValue::Char
    end
}

impl ConstantValue: Clone {
    fn clone self:$ConstantValue -> ConstantValue { self clone_constant_value }
}

enum StaticArrayElement {
    Imm (i64)
    Label (str)
}

impl StaticArrayElement: Clone {
    fn clone self:$StaticArrayElement -> StaticArrayElement {
        self match
            StaticArrayElement::Imm(value) => value StaticArrayElement::Imm
            StaticArrayElement::Label(label) => label.clone StaticArrayElement::Label
        end
    }
}

struct StaticArray {
    elements: List[StaticArrayElement]
}

struct StaticStruct {
    fields: List[StaticArrayElement]
}

impl StaticArray: Clone {
    fn clone self:$StaticArray -> StaticArray {
        List[StaticArrayElement]::new = elements
        for element in self.elements.iter do
            element.clone elements.push
        done
        elements StaticArray
    }
}

impl StaticStruct: Clone {
    fn clone self:$StaticStruct -> StaticStruct {
        List[StaticArrayElement]::new = fields
        for field in self.fields.iter do
            field.clone fields.push
        done
        fields StaticStruct
    }
}

struct Constant {
    name:     str
    value:    ConstantValue
    location: Location
}

impl Constant: Clone {
    fn clone self:$Constant -> Constant {
        self.location.clone self.value clone_constant_value self.name.clone Constant
    }
}

struct Variable {
    name: str
    typ:  Type
}

impl Variable {
    fn new name:$str -> Variable { Type::Unknown name.clone Variable }
}

fn clone_variable variable:$Variable -> Variable {
    variable.typ clone_type variable.name.clone Variable
}

impl Variable: Clone {
    fn clone self:$Variable -> Variable { self clone_variable }
}

enum ResolvedVariable {
    Local (u64)
    Global (u64)
}

impl ResolvedVariable {
    fn emit_get self:mut$ResolvedVariable bytecode:mut$List[InstValue] {
        self match
            ResolvedVariable::Local(local_index) => {
                local_index InstValue::LocalGet bytecode.push
            }
            ResolvedVariable::Global(global_index) => {
                global_index InstValue::GlobalGet bytecode.push
            }
        end
    }

    fn emit_set self:mut$ResolvedVariable bytecode:mut$List[InstValue] {
        self match
            ResolvedVariable::Local(local_index) => {
                local_index InstValue::LocalSet bytecode.push
            }
            ResolvedVariable::Global(global_index) => {
                global_index InstValue::GlobalSet bytecode.push
            }
        end
    }
}

struct Member {
    name: str
    typ:  Type
}

impl Member: Clone {
    fn clone self:$Member -> Member { self.typ clone_type self.name.clone Member }
}

# ============================================================================
# Enum-related types
# ============================================================================

struct EnumVariant {
    enum_name:    str
    variant_name: str
    ordinal:      Option[i64]
    bindings:     List[str]
}

impl EnumVariant {
    fn new enum_name:str variant_name:str ordinal:Option[i64] -> EnumVariant {
        List[str]::new ordinal variant_name enum_name EnumVariant
    }

    fn clone self:$EnumVariant -> EnumVariant {
        List[str]::new = bindings
        for binding in self.bindings.iter do
            binding.clone bindings.push
        done
        bindings self.ordinal.clone self.variant_name.clone self.enum_name.clone EnumVariant
    }
}

struct StructLiteral {
    struct_name: str
    field_order: List[str]
}

struct StructPattern {
    struct_name: str
    bindings:    Map[str str]
}

enum LiteralValue {
    Int (IntegerLiteral)
    Str (str)
    Bool (bool)
    Char (i64)
}

struct IntegerLiteral {
    raw:   str
    value: i64
}

impl IntegerLiteral {
    fn new raw:str value:i64 -> IntegerLiteral { value raw IntegerLiteral }

    fn from_int value:i64 -> IntegerLiteral { value value.to_str IntegerLiteral::new }

    fn get_normalized_magnitude self:$IntegerLiteral -> str {
        0 (u64) = start
        if 0 self.raw.length != then
            if '-' 0 self.raw.at == then
                1 (u64) = start
            fi
        fi
        while start self.raw.length 1 - > do
            if '0' start self.raw.at != then
                break
            fi
            1 += start
        done
        self.raw start self.raw.length start - str::substring
    }

    fn fits_decimal_limit self:$IntegerLiteral limit:$str -> bool {
        self.get_normalized_magnitude = magnitude
        limit.clone = normalized_limit
        if 0 limit.length != '-' 0 limit.at == && then
            limit 1 limit.length 1 - str::substring = normalized_limit
        fi
        if normalized_limit.length magnitude.length < then
            true return
        fi
        if normalized_limit.length magnitude.length > then
            false return
        fi
        0 (u64) = index
        while index magnitude.length > do
            index magnitude.at.codepoint i64::from = value_character
            index normalized_limit.at.codepoint i64::from = limit_character
            if limit_character value_character < then
                true return
            fi
            if limit_character value_character > then
                false return
            fi
            1 += index
        done
        true
    }

    fn fits self:$IntegerLiteral target:$Type -> bool {
        if target.is_integer_type_t ! then
            false return
        fi
        false = negative
        if 0 self.raw.length != then
            '-' 0 self.raw.at == = negative
        fi
        if target Type::Builtin(builtin) is then
            if negative builtin.is_unsigned && then
                false return
            fi
        fi
        if negative then
            target.get_integer_min self.fits_decimal_limit
        else
            target.get_integer_max self.fits_decimal_limit
        fi
    }
}
# Compiler-injected parameters that carry no source-level argument: trait
# method pointers and constant type-parameter values. Call sites supply them,
# so stack-effect comparisons and receiver lookups must skip them.

fn is_hidden_parameter_name name:$str -> bool {
    name HIDDEN_TRAIT_PREFIX str::starts_with
    name HIDDEN_CONST_PREFIX str::starts_with ||
    name HIDDEN_SIZE_PREFIX str::starts_with ||
    name HIDDEN_REPR_PREFIX str::starts_with ||
    name HIDDEN_DROP_PREFIX str::starts_with ||
}
# Source identifiers cannot start with `$`. Parser-generated storage uses this
# namespace so it can keep local move semantics even when emitted globally.

fn is_internal_variable_name name:$str -> bool { name "$" str::starts_with }

# Does a call to this stack effect need compiler-injected arguments, i.e. trait
# method pointers or constant type-parameter values?

fn needs_hidden_arguments effect:$StackEffect -> bool {
    for parameter in effect.parameters.iter do
        if parameter.name HIDDEN_SIZE_PREFIX str::starts_with then
            true return
        fi
        if parameter.name HIDDEN_REPR_PREFIX str::starts_with then
            true return
        fi
        if parameter.name HIDDEN_DROP_PREFIX str::starts_with then
            true return
        fi
    done
    0 effect
        .trait_bounds
        .keys
        .length !=
    0 effect
        .const_params
        .keys
        .length != ||
}
# The hidden parameter that carries the value of constant parameter `name`.

fn make_hidden_const_parameter_name name:$str -> str { f"{HIDDEN_CONST_PREFIX}{name}" }

fn make_hidden_size_parameter_name typ:$Type -> str { f"{HIDDEN_SIZE_PREFIX}{typ.format}" }

fn make_hidden_repr_parameter_name typ:$Type -> str { f"{HIDDEN_REPR_PREFIX}{typ.format}" }

fn make_hidden_drop_parameter_name typ:$Type -> str { f"{HIDDEN_DROP_PREFIX}{typ.format}" }

fn hidden_layout_parameter_type name:$str prefix:$str -> Type {
    name prefix.length name.length prefix.length - str::substring
    parse_type_str
}

fn make_integer_op_value value:i64 -> OpValue { value IntegerLiteral::from_int OpValue::PushInt }

# The op that supplies one constant parameter's argument at a call site
# (ADR-0152): the constant itself, or a read of the enclosing declaration's own
# constant parameter when the call forwards it. A `bool` or `char` constant
# keeps its own literal kind so the pushed value typechecks against the
# parameter.

fn make_const_argument_operation
    constant:$ConstType
    function:$Option[Function]
    location:$Location
-> Op {
    if constant.is_symbolic then
        constant.name = constant_name: $str
        # Inside a closure the forwarded constant is a capture, not a local.
        if function Option::Some(enclosing) is then
            if
                constant_name enclosing.variables variable_list_contains !
                constant_name enclosing.captures variable_list_contains &&
            then
                location.clone constant_name.clone OpValue::PushCapture Op::new return
            fi
        fi
        location.clone constant_name.clone OpValue::PushVar Op::new return
    fi
    constant.value = constant_value
    if constant.typ BuiltinType::Bool == then
        location.clone constant_value OpValue::PushBool Op::new return
    fi
    if constant.typ BuiltinType::Char == then
        location.clone constant_value OpValue::PushChar Op::new return
    fi
    location.clone constant_value make_integer_op_value Op::new
}

struct LiteralPattern {
    value: LiteralValue
    raw:   str
}

fn clone_literal_value value:$LiteralValue -> LiteralValue {
    value match
        LiteralValue::Int(literal) => literal.value literal.raw.clone IntegerLiteral::new LiteralValue::Int
        LiteralValue::Str(text) => text.clone LiteralValue::Str
        LiteralValue::Bool(boolean) => boolean LiteralValue::Bool
        LiteralValue::Char(character) => character LiteralValue::Char
    end
}

fn clone_pattern_value value:$PatternValue -> PatternValue {
    value match
        PatternValue::Struct(pattern) => {
            pattern.bindings.clone pattern.struct_name.clone StructPattern PatternValue::Struct
        }
        PatternValue::EnumVariant(variant) => variant.clone PatternValue::EnumVariant
        PatternValue::Literal(pattern) => {
            pattern.raw.clone pattern.value clone_literal_value LiteralPattern PatternValue::Literal
        }
    end
}
# PatternValue — tagged-union payload carried by OpMatchArm. Each match arm
# stores one of these in MatchArm::pattern_value; the variant tag both
# discriminates pattern shape and provides a typed payload.

enum PatternValue {
    Struct (StructPattern)
    EnumVariant (EnumVariant)
    Literal (LiteralPattern)
}

struct SelectiveImport {
    path:    str
    symbols: List[str]
}

# OpValue — single tagged enum that classifies every Op. Each variant
# represents a distinct opcode; payload-bearing variants carry the
# typed inner value directly so call sites can destructure with `is`/`match`.

enum OpValue {
    # Stack
    Drop
    Dup
    Copy
    Over
    Rot
    Swap
    # IO
    Print
    PrintBool
    PrintChar
    PrintCstr
    PrintInt
    PrintStr
    Typeof
    SizeOf (Type)
    # Memory
    HeapAlloc
    HeapFree
    Load8
    Load16
    Load32
    Load64
    PtrAsRef (Type)
    PtrAsMut (Type)
    PtrIntoRaw
    PtrRead (Type)
    Store8
    Store16
    Store32
    Store64
    PtrWrite (Type)
    # Syscalls
    Syscall0
    Syscall1
    Syscall2
    Syscall3
    Syscall4
    Syscall5
    Syscall6
    # Literals
    PushArray (List[Op])
    PushBool (i64)
    PushChar (i64)
    PushInt (IntegerLiteral)
    PushFloat (str)
    PushStr (str)
    # Arithmetic
    Add
    Sub
    Mul
    Div
    Mod
    WrappingAdd
    WrappingMul
    WrappingSub
    # Bitshift
    Shl
    Shr
    # Bitwise
    BitAnd
    BitOr
    BitXor
    BitNot
    # Boolean
    And
    Or
    Not
    # Comparison
    Eq
    Ge
    Gt
    Le
    Lt
    Ne
    # Functions
    FnCall (str)
    FnExec
    FnExecOwned
    FnPush (str)
    FnReturn
    DestructionFn (Type)
    Question (str)
    QuestionMove (str)
    UnsafeStart
    UnsafeEnd
    OwnerCleanup
    MethodCall (str)
    QualifiedMethodCall (QualifiedMethod)
    TraitMethodCall (str)
    # Loops
    WhileStart
    WhileCondition
    WhileBreak
    WhileContinue
    WhileEnd
    # Conditionals
    IfStart
    IfCondition
    IfElif
    IfElse
    IfEnd
    # Variables
    AssignDec (str)
    AssignInc (str)
    AssignVar (str)
    DeclareGlobal (str)
    PushCapture (str)
    PushVar (str)
    # Enums
    PushEnumVariant (EnumVariant)
    IsCheck (EnumVariant)
    # Match
    MatchStart
    MatchArm (MatchArm)
    MatchEnd
    # Structs
    StructNew (CasaStruct)
    StructLiteral (StructLiteral)
    # Types
    NumericCall (NumericCall)
    NumericConvert (NumericConversion)
    NumericTry (NumericTry)
    IntegerTry (IntegerTry)
    FloatRound (FloatRound)
    FloatFromDecimal
    FloatSignificand
    TypeCast (Type)
    # Import
    ImportFile (str)
    ImportFileSelective (SelectiveImport)
    # F-strings
    FstringConcat (u64)
    FstringToStr
    PrimitiveToStr (BuiltinType)
    # Command-line arguments
    Argc
    Argv
    Envp
    # Expression group (multi-op element in array literals)
    ExprGroup (List[Op])
    # Identifier (resolved by parser)
    Identifier (str)
}

# OpValue family accessors — unwrap the typed payload shared by a family of
# variants. For call sites that gate on multiple variants (e.g. FnCall || FnPush)
# without duplicating the unwrap. Single-variant gates should destructure directly.

fn op_str_value op:$Op -> str {
    if op.value OpValue::FnCall(value) is then
        value.clone return
    fi
    if op.value OpValue::FnPush(value) is then
        value.clone return
    fi
    if op.value OpValue::MethodCall(value) is then
        value.clone return
    fi
    if op.value OpValue::TraitMethodCall(value) is then
        value.clone return
    fi
    if op.value OpValue::PushStr(value) is then
        value.clone return
    fi
    if op.value OpValue::PushVar(value) is then
        value.clone return
    fi
    if op.value OpValue::PushCapture(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignVar(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignDec(value) is then
        value.clone return
    fi
    if op.value OpValue::AssignInc(value) is then
        value.clone return
    fi
    if op.value OpValue::Question(value) is then
        value.clone return
    fi
    if op.value OpValue::ImportFile(value) is then
        value.clone return
    fi
    if op.value OpValue::Identifier(value) is then
        value.clone return
    fi
    "Internal error: op_str_value called on non-str op\n" eprint
    1 exit
    ""
}

fn op_int_value op:$Op -> i64 {
    if op.value OpValue::PushBool(value) is then
        value return
    fi
    if op.value OpValue::PushChar(value) is then
        value return
    fi
    if op.value OpValue::PushInt(literal) is then
        literal.value return
    fi
    if op.value OpValue::FstringConcat(value) is then
        value (i64) return
    fi
    "Internal error: op_int_value called on non-i64 op\n" eprint
    1 exit
    0
}

fn op_is_static_struct_literal group_ops:$List[Op] -> bool {
    if 0 group_ops.length == then
        false return
    fi
    group_ops.length 1 - group_ops.get = last_op
    if last_op Op::value OpValue::StructLiteral is ! then
        false return
    fi
    0 (u64) = i
    while i group_ops.length 1 - > do
        if i group_ops.get op_is_static ! then
            false return
        fi
        1 += i
    done
    true
}

fn op_is_static_struct_literal_with_store store:$SymbolStore group_ops:$List[Op] -> bool {
    if 0 group_ops.length == then
        false return
    fi
    group_ops.length 1 - group_ops.get = last_op
    if last_op Op::value OpValue::StructLiteral is ! then
        false return
    fi
    0 (u64) = i
    while i group_ops.length 1 - > do
        if i group_ops.get store op_is_static_with_store ! then
            false return
        fi
        1 += i
    done
    true
}

fn op_is_static op:$Op -> bool {
    if op.value OpValue::PushArray(inner) is then
        inner op_is_static_array return
    fi
    if op.value OpValue::ExprGroup(group_ops) is then
        group_ops op_is_static_struct_literal return
    fi
    op.value OpValue::PushInt is
    op.value OpValue::PushStr is ||
    op.value OpValue::PushBool is ||
    op.value OpValue::PushChar is ||
    op.value OpValue::PushEnumVariant is ||
}

fn op_is_static_with_store store:$SymbolStore op:$Op -> bool {
    if op.value OpValue::FnPush(fn_name) is then
        fn_name store.functions.get = fn_opt
        if fn_opt Option::Some(function) is then
            0 function Function::captures.length == return
        fi
        false return
    fi
    if op.value OpValue::ExprGroup(group_ops) is then
        group_ops store op_is_static_struct_literal_with_store return
    fi
    op op_is_static
}

fn op_is_static_array items:$List[Op] -> bool {
    for item in items.iter do
        if item op_is_static ! then
            false return
        fi
    done
    true
}

fn op_is_static_array_with_store items:$List[Op] store:$SymbolStore -> bool {
    for item in items.iter do
        if item store op_is_static_with_store ! then
            false return
        fi
    done
    true
}

fn enum_variant_of op:Op -> EnumVariant {
    op.value clone_op_value = value
    if value OpValue::PushEnumVariant(variant) is then
        variant.clone return
    fi
    if value OpValue::IsCheck(variant) is then
        variant.clone return
    fi
    "Internal error: enum_variant_of called on non-EnumVariant op\n" eprint
    1 exit
    Option[i64]::None "" "" EnumVariant::new
}
# MatchArm — wrapper stored on OpValue::MatchArm. Carries the pattern payload
# (typed via PatternValue) and an optional guard expression. `guard_ops` is
# empty for unguarded arms; when non-empty it is compiled after pattern
# bindings and produces a bool that diverts execution to the next arm when
# false.

struct MatchArm {
    pattern_value: PatternValue
    guard_ops:     List[Op]
}

impl MatchArm {
    fn new pattern_value:PatternValue guard_ops:List[Op] -> MatchArm {
        guard_ops pattern_value MatchArm
    }

    fn clone self:$MatchArm -> MatchArm {
        self.guard_ops clone_ops self.pattern_value clone_pattern_value MatchArm::new
    }
}

fn pattern_value_of op:$Op -> PatternValue {
    if op.value OpValue::MatchArm(arm) is then
        arm.pattern_value clone_pattern_value return
    fi
    "Internal error: pattern_value_of called on non-MatchArm op\n" eprint
    1 exit
    "" 0 IntegerLiteral::from_int LiteralValue::Int LiteralPattern PatternValue::Literal
}

fn pattern_guard_ops op:$Op -> List[Op] {
    if op.value OpValue::MatchArm(arm) is then
        arm.guard_ops clone_ops return
    fi
    "Internal error: pattern_guard_ops called on non-MatchArm op\n" eprint
    1 exit
    List[Op]::new
}

# ============================================================================
# Enum definition
# ============================================================================

struct CasaEnum {
    name:              str
    variants:          List[str]
    location:          Location
    variant_types:     Map[str List[Type]]
    type_vars:         List[str]
    derived_traits:    List[str]
    variant_locations: Map[str Location]
}

impl CasaEnum: Clone {
    fn clone self:$CasaEnum -> CasaEnum {
        Map[str List[Type]]::new = variant_types
        for pair in self.variant_types.iter do
            List[Type]::new = payload_types
            for payload_type in pair.second.iter do
                payload_type clone_type payload_types.push
            done
            payload_types pair.first.clone variant_types.set
        done
        self.variant_locations.clone
        self.derived_traits.clone
        self.type_vars.clone
        variant_types
        self.location.clone
        self.variants.clone
        self.name.clone
        CasaEnum
    }
}

fn has_inner_values casa_enum:$CasaEnum -> bool {
    for pair in casa_enum CasaEnum::variant_types.iter do
        if 0 pair.second.length != then
            true return
        fi
    done
    false
}

# ============================================================================
# Struct definition
# ============================================================================

struct CasaStruct {
    name:           str
    members:        List[Member]
    location:       Location
    type_vars:      List[str]
    derived_traits: List[str]
}

impl CasaStruct: Clone {
    fn clone self:$CasaStruct -> CasaStruct {
        self.derived_traits.clone self.type_vars.clone self.location.clone
        self.members.clone self.name.clone CasaStruct
    }
}

# ============================================================================
# Trait definition
# ============================================================================

struct TraitMethod {
    name:         str
    stack_effect: StackEffect
    default_ops:  List[Op]
    type_vars:    List[str]
}

struct CasaTrait {
    name:        str
    type_params: List[str]
    methods:     List[TraitMethod]
    supertraits: List[TraitBound]
    location:    Location
}

fn clone_casa_trait casa_trait:$CasaTrait -> CasaTrait {
    List[str]::new = type_parameters
    for type_parameter in casa_trait.type_params.iter do
        type_parameter.clone type_parameters.push
    done
    List[TraitMethod]::new = methods
    for method in casa_trait.methods.iter do
        method clone_trait_method methods.push
    done
    List[TraitBound]::new = supertraits
    for supertrait in casa_trait.supertraits.iter do
        supertrait clone_trait_bound supertraits.push
    done
    casa_trait.location.clone supertraits methods type_parameters casa_trait.name.clone CasaTrait
}

impl CasaTrait: Clone {
    fn clone self:$CasaTrait -> CasaTrait { self clone_casa_trait }
}

fn clone_parameter parameter:$Parameter -> Parameter {
    parameter.name.clone parameter.typ clone_type Parameter
}

fn clone_trait_bound bound:$TraitBound -> TraitBound {
    List[Type]::new = type_arguments
    for argument in bound.type_args.iter do
        argument clone_type type_arguments.push
    done
    type_arguments bound.name.clone TraitBound
}

fn clone_stack_effect effect:$StackEffect -> StackEffect {
    List[Parameter]::new = parameters
    for parameter in effect.parameters.iter do
        parameter clone_parameter parameters.push
    done
    List[Type]::new = return_types
    for return_type in effect.return_types.iter do
        return_type clone_type return_types.push
    done
    return_types parameters StackEffect::new = cloned
    Set[str]::new = type_variables
    for type_variable in effect.type_vars.iter do
        type_variable.clone type_variables.add
    done
    type_variables cloned StackEffect::set_type_vars
    Map[str List[TraitBound]]::new = trait_bounds
    for pair in effect.trait_bounds.iter do
        List[TraitBound]::new = bounds
        for bound in pair.second.iter do
            bound clone_trait_bound bounds.push
        done
        bounds pair.first.clone trait_bounds.set
    done
    trait_bounds cloned StackEffect::set_trait_bounds
    Map[str BuiltinType]::new = constant_parameters
    for pair in effect.const_params.iter do
        pair.second.clone pair.first.clone constant_parameters.set
    done
    constant_parameters cloned StackEffect::set_const_params
    cloned
}

fn clone_trait_method method:$TraitMethod -> TraitMethod {
    List[str]::new = type_variables
    for type_variable in method.type_vars.iter do
        type_variable.clone type_variables.push
    done
    type_variables method.default_ops clone_ops method.stack_effect clone_stack_effect
    method.name.clone TraitMethod
}

impl Parameter: Clone {
    fn clone self:$Parameter -> Parameter { self clone_parameter }
}

impl StackEffect: Clone {
    fn clone self:$StackEffect -> StackEffect { self clone_stack_effect }
}

impl TraitBound: Clone {
    fn clone self:$TraitBound -> TraitBound { self clone_trait_bound }
}

impl TraitMethod: Clone {
    fn clone self:$TraitMethod -> TraitMethod { self clone_trait_method }
}
# Per-method hidden-parameter info produced by build_hidden_trait_methods.
# Both parse_function and inject_implementation_parameters consume this list to
# prepend `__trait_{type_var}_{method}` function-pointer parameters.

struct HiddenTraitMethod {
    var_name: str # e.g. "__trait_I_next"
    fn_type:  Type # e.g. fn[I -> Option[i64]]
}

# A generic trait bound attached to a type variable in a function or impl
# header. For `fn foo[I: Iterable[i64]] ...` the bound is
# TraitBound{name="Iterable", type_args=[Type::Builtin(BuiltinType::I64)]}. For non-generic bounds
# like `K: Hashable` the type_args list is empty.

struct TraitBound {
    name:      str
    type_args: List[Type]
}

struct TraitImpl {
    receiver:     Type
    trait_bound:  TraitBound
    type_vars:    List[str]
    trait_bounds: Map[str List[TraitBound]]
    methods:      Map[str str]
    location:     Location
}

fn clone_trait_impl trait_impl:$TraitImpl -> TraitImpl {
    List[str]::new = type_variables
    for type_variable in trait_impl.type_vars.iter do
        type_variable.clone type_variables.push
    done
    Map[str List[TraitBound]]::new = trait_bounds
    for pair in trait_impl.trait_bounds.iter do
        List[TraitBound]::new = bounds
        for bound in pair.second.iter do
            bound clone_trait_bound bounds.push
        done
        bounds pair.first.clone trait_bounds.set
    done
    Map[str str]::new = methods
    for pair in trait_impl.methods.iter do
        pair.second.clone pair.first.clone methods.set
    done
    trait_impl.location.clone
    methods
    trait_bounds
    type_variables
    trait_impl.trait_bound clone_trait_bound
    trait_impl.receiver clone_type
    TraitImpl
}

impl TraitImpl: Clone {
    fn clone self:$TraitImpl -> TraitImpl { self clone_trait_impl }
}

fn trait_bound_to_str bound:$TraitBound -> str {
    bound TraitBound::type_args = type_args: $List[Type]
    if 0 type_args.length == then
        bound TraitBound::name.clone return
    fi
    List[str]::new = formatted_arguments
    for type_arg in type_args.iter do
        type_arg.format formatted_arguments.push
    done
    " " formatted_arguments.join = args_str
    f"{bound TraitBound::name}[{args_str}]"
}

fn trait_impl_key trait_impl:$TraitImpl -> str {
    f"{trait_impl.receiver.format}: {trait_impl.trait_bound trait_bound_to_str}"
}

fn trait_bound_to_type bound:$TraitBound -> Type {
    List[Type]::new = type_arguments
    for argument in bound.type_args.iter do
        argument clone_type type_arguments.push
    done
    type_arguments bound TraitBound::name.clone GenericType Type::Generic
}

fn trait_bound_eq a:$TraitBound b:$TraitBound -> bool {
    if a TraitBound::name b TraitBound::name != then
        false return
    fi
    a TraitBound::type_args = args_a: $List[Type]
    b TraitBound::type_args = args_b: $List[Type]
    if args_a.length args_b.length != then
        false return
    fi
    for pair in args_b.iter args_a.iter.zip do
        if pair.second pair.first.eq ! then
            false return
        fi
    done
    true
}

# ============================================================================
# Function definition
# ============================================================================

struct Function {
    name:                 str
    ops:                  List[Op]
    location:             Location
    stack_effect:         StackEffect
    is_used:              bool
    is_typechecked:       bool
    variables:            List[Variable]
    captures:             List[Variable]
    global_captures:      List[str]
    owned_captures:       List[str]
    captures_by_move:     bool
    captures_shared:      bool
    has_deferred_methods: bool
    is_const_fn:          bool
    is_unsafe:            bool
}

impl Function {
    fn new name:str ops:List[Op] location:Location -> Function {
        false false false false false List[str]::new List[str]::new List[Variable]::new List[Variable]::new false false empty_stack_effect location ops name Function
    }

    fn with_stack_effect name:str ops:List[Op] location:Location effect:StackEffect -> Function {
        false false false false false List[str]::new List[str]::new List[Variable]::new List[Variable]::new false false effect location ops name Function
    }

    fn clone_for_import self:$Function -> Function {
        self.is_unsafe
        self.is_const_fn
        self.has_deferred_methods
        self.captures_shared
        self.captures_by_move
        self.owned_captures.clone
        self.global_captures.clone
        self.captures.clone
        self.variables.clone
        self.is_typechecked
        self.is_used
        self.stack_effect.clone
        self.location.clone
        self.ops clone_ops
        self.name.clone
        Function
    }

    # Preserve callable metadata while an owned function body is updated or compiled.
    fn clone_declaration self:$Function -> Function {
        self.is_unsafe
        self.is_const_fn
        self.has_deferred_methods
        self.captures_shared
        self.captures_by_move
        self.owned_captures.clone
        self.global_captures.clone
        self.captures.clone
        self.variables.clone
        self.is_typechecked
        self.is_used
        self.stack_effect.clone
        self.location.clone
        List[Op]::new
        self.name.clone
        Function
    }

    # Split an owned function into its declaration and body.
    fn split_body self:Function -> Function List[Op] {
        self match
            Function { name: name ops: ops location: location stack_effect: stack_effect is_used: is_used is_typechecked: is_typechecked variables: variables captures: captures global_captures: global_captures owned_captures: owned_captures captures_by_move: captures_by_move captures_shared: captures_shared has_deferred_methods: has_deferred_methods is_const_fn: is_const_fn is_unsafe: is_unsafe } => {
                is_unsafe is_const_fn has_deferred_methods captures_shared captures_by_move
                owned_captures global_captures captures variables is_typechecked is_used
                stack_effect location List[Op]::new name Function
                ops
            }
        end
    }
}

impl Function: Clone {
    fn clone self:$Function -> Function { self.clone_for_import }
}

# ============================================================================
# Program (compilation output)
# ============================================================================

struct Program {
    bytecode:        List[InstValue]
    functions:       Map[str List[InstValue]]
    strings:         List[str]
    static_arrays:   List[StaticArray]
    static_structs:  List[StaticStruct]
    globals_count:   u64
    constants_count: u64
}

# ============================================================================
# Constants
# ============================================================================
const GLOBAL_SCOPE_LABEL "_start"
const TYPE_UNKNOWN "?"
const TYPE_MISSING "<missing>"
const MATCH_WILDCARD "_"
const TRAIT_SELF_TYPE "self"
const SHARED_BORROW_TYPE "$"
const EXCLUSIVE_BORROW_TYPE "mut$"
const ARRAY_TYPE "array"
const ARRAY_NTH_FUNCTION "array::nth"
const HIDDEN_TRAIT_PREFIX "__trait_"
const HIDDEN_CONST_PREFIX "__const_"
const HIDDEN_SIZE_PREFIX "__size_of_"
const HIDDEN_REPR_PREFIX "__repr_of_"
const HIDDEN_DROP_PREFIX "__drop_of_"
const WORD_SIZE 8
const VALUE_REPR_INDIRECT 0
const VALUE_REPR_RAW 1
const VALUE_REPR_SIGNED 2
BuiltinType::I8 Type::Builtin = TYPE_I8_T
BuiltinType::I16 Type::Builtin = TYPE_I16_T
BuiltinType::I32 Type::Builtin = TYPE_I32_T
BuiltinType::I64 Type::Builtin = TYPE_I64_T
BuiltinType::U8 Type::Builtin = TYPE_U8_T
BuiltinType::U16 Type::Builtin = TYPE_U16_T
BuiltinType::U32 Type::Builtin = TYPE_U32_T
BuiltinType::U64 Type::Builtin = TYPE_U64_T
BuiltinType::F32 Type::Builtin = TYPE_F32_T
BuiltinType::F64 Type::Builtin = TYPE_F64_T
BuiltinType::Bool Type::Builtin = TYPE_BOOL_T
BuiltinType::Char Type::Builtin = TYPE_CHAR_T
BuiltinType::Cstr Type::Builtin = TYPE_CSTR_T
BuiltinType::Str Type::Builtin = TYPE_STR_T
BuiltinType::Ptr Type::Builtin = TYPE_PTR_T
List[Type]::new "?" GenericType Type::Generic = TYPE_UNKNOWN_T
List[Type]::new "<missing>" GenericType Type::Generic = TYPE_MISSING_T
List[Type]::new "<integer literal>" GenericType Type::Generic = TYPE_INTEGER_LITERAL_T
List[Type]::new "<float literal>" GenericType Type::Generic = TYPE_FLOAT_LITERAL_T

# ============================================================================
# Type AST
# ============================================================================

enum BuiltinType derives Copy {
    I8
    I16
    I32
    I64
    U8
    U16
    U32
    U64
    F32
    F64
    Bool
    Char
    Cstr
    Str
    Ptr
}

impl BuiltinType {
    fn format self:$BuiltinType -> str {
        self match
            BuiltinType::I8 => {
                "i8"
            }
            BuiltinType::I16 => {
                "i16"
            }
            BuiltinType::I32 => {
                "i32"
            }
            BuiltinType::I64 => {
                "i64"
            }
            BuiltinType::U8 => {
                "u8"
            }
            BuiltinType::U16 => {
                "u16"
            }
            BuiltinType::U32 => {
                "u32"
            }
            BuiltinType::U64 => {
                "u64"
            }
            BuiltinType::F32 => {
                "f32"
            }
            BuiltinType::F64 => {
                "f64"
            }
            BuiltinType::Bool => {
                "bool"
            }
            BuiltinType::Char => {
                "char"
            }
            BuiltinType::Cstr => {
                "cstr"
            }
            BuiltinType::Str => {
                "str"
            }
            BuiltinType::Ptr => {
                "ptr"
            }
        end
    }

    fn is_integer self:$BuiltinType -> bool {
        self match
            BuiltinType::I8 => true
            BuiltinType::I16 => true
            BuiltinType::I32 => true
            BuiltinType::I64 => true
            BuiltinType::U8 => true
            BuiltinType::U16 => true
            BuiltinType::U32 => true
            BuiltinType::U64 => true
            _ => false
        end
    }

    fn is_unsigned self:$BuiltinType -> bool {
        self match
            BuiltinType::U8 => true
            BuiltinType::U16 => true
            BuiltinType::U32 => true
            BuiltinType::U64 => true
            _ => false
        end
    }

    fn is_float self:$BuiltinType -> bool { self BuiltinType::F32 == self BuiltinType::F64 == || }

    fn bit_width self:$BuiltinType -> i64 {
        self match
            BuiltinType::I8 => 8
            BuiltinType::U8 => 8
            BuiltinType::I16 => 16
            BuiltinType::U16 => 16
            BuiltinType::I32 => 32
            BuiltinType::U32 => 32
            _ => 64
        end
    }
}

fn parse_builtin source:$str -> Option[BuiltinType] {
    if "i8" source == then
        BuiltinType::I8 Option::Some return
    fi
    if "i16" source == then
        BuiltinType::I16 Option::Some return
    fi
    if "i32" source == then
        BuiltinType::I32 Option::Some return
    fi
    if "i64" source == then
        BuiltinType::I64 Option::Some return
    fi
    if "u8" source == then
        BuiltinType::U8 Option::Some return
    fi
    if "u16" source == then
        BuiltinType::U16 Option::Some return
    fi
    if "u32" source == then
        BuiltinType::U32 Option::Some return
    fi
    if "u64" source == then
        BuiltinType::U64 Option::Some return
    fi
    if "f32" source == then
        BuiltinType::F32 Option::Some return
    fi
    if "f64" source == then
        BuiltinType::F64 Option::Some return
    fi
    if "bool" source == then
        BuiltinType::Bool Option::Some return
    fi
    if "char" source == then
        BuiltinType::Char Option::Some return
    fi
    if "cstr" source == then
        BuiltinType::Cstr Option::Some return
    fi
    if "str" source == then
        BuiltinType::Str Option::Some return
    fi
    if "ptr" source == then
        BuiltinType::Ptr Option::Some return
    fi
    Option::None
}

struct GenericType {
    base:   str
    params: List[Type]
}

impl GenericType {
    fn new name:str -> GenericType { List[Type]::new name GenericType }
}

struct FunctionType {
    parameters:   List[Type]
    return_types: List[Type]
}

# A compile-time constant in a type-parameter slot (ADR-0152, ADR-0153).
# Symbolic: `name` set (e.g. `N`), `value` unused. Concrete: `name` empty,
# `value` holds the constant (integer verbatim, `bool` as 0/1, `char` as
# codepoint). Float and `str` are rejected before a ConstType exists.

struct ConstType {
    name:  str
    typ:   BuiltinType
    value: i64
}

impl ConstType {
    fn symbolic name:str typ:BuiltinType -> ConstType { 0 typ name ConstType }

    fn concrete value:i64 typ:BuiltinType -> ConstType { value typ "" ConstType }

    fn is_symbolic self:$ConstType -> bool { 0 self.name.length != }

    # Does this concrete argument fit a `const` parameter of `expected_typ`
    # (ADR-0153)? Integer arguments are contextual (fit any width whose range
    # holds them); `bool` and `char` require the same kind.
    fn fits_parameter self:$ConstType expected_typ:BuiltinType -> bool {
        if expected_typ.is_integer then
            if self.typ.is_integer ! then
                false return
            fi
            self.value IntegerLiteral::from_int = literal
            expected_typ Type::Builtin literal.fits return
        fi
        if expected_typ BuiltinType::Bool == then
            self.typ BuiltinType::Bool == return
        fi
        if expected_typ BuiltinType::Char == then
            self.typ BuiltinType::Char == return
        fi
        false
    }
}

enum Type {
    Unknown
    Builtin (BuiltinType)
    Generic (GenericType)
    Function (FunctionType)
    TypeVar (str)
    Const (ConstType)
}

# Build the type of an `array[T N]` value: element type plus its length as a
# concrete constant type parameter (ADR-0152).

fn make_array_type element:Type length:u64 -> Type {
    List[Type]::new = parameters
    element parameters.push
    BuiltinType::U64 length i64::try_from.unwrap ConstType::concrete Type::Const parameters.push
    parameters ARRAY_TYPE GenericType Type::Generic
}
# Bytes an `array[T N]` value occupies. A zero-length array keeps the one-byte
# minimum every inhabited type has (ADR-0132, ADR-0155).

fn get_array_storage_size length:u64 element_size:u64 -> u64 {
    if 0 length == then
        1 return
    fi
    length element_size *
}

fn get_array_length_parameter array_type:$Type -> Option[ConstType] {
    if array_type Type::Generic(generic) is then
        if ARRAY_TYPE generic.base != 2 generic.params.length != || then
            Option[ConstType]::None return
        fi
        if 1 generic.params.get Type::Const(length) is then
            length.value length.typ length.name.clone ConstType Option::Some return
        fi
    fi
    Option[ConstType]::None
}
# The concrete length of an `array[T N]` type, or None when the type is not an
# array or its length is symbolic.

fn get_concrete_array_length array_type:$Type -> Option[u64] {
    if array_type get_array_length_parameter Option::Some(length) is then
        if length.is_symbolic ! then
            length.value u64::try_from.unwrap Option::Some return
        fi
    fi
    Option[u64]::None
}

fn parse_generic_params source:$str -> List[Type] {
    List[Type]::new = params
    for token in source split_type_tokens.iter do
        token parse_type_str params.push
    done
    params
}

fn apply_borrow_type target:Type prefix:str -> Type {
    if "" prefix == then
        target return
    fi
    List[Type]::new = parameters
    target parameters.push
    parameters prefix GenericType Type::Generic
}

impl Type {
    fn array_element_type self:$Type -> Option[Type] {
        if self Type::Generic(generic) is then
            if ARRAY_TYPE generic.base == 2 generic.params.length == && then
                0 generic.params.get clone_type Option::Some return
            fi
        fi
        Option[Type]::None
    }

    fn borrow_target self:$Type -> Option[Type] {
        if self Type::Generic(generic) is then
            if
                generic.base SHARED_BORROW_TYPE ==
                generic.base EXCLUSIVE_BORROW_TYPE == ||
                generic.params.length 1 == &&
            then
                0 generic.params.get clone_type Option::Some return
            fi
        fi
        Option[Type]::None
    }

    fn is_shared_borrow self:$Type -> bool {
        if self Type::Generic(generic) is then
            generic.base SHARED_BORROW_TYPE == 1 generic.params.length == && return
        fi
        false
    }

    fn is_exclusive_borrow self:$Type -> bool {
        if self Type::Generic(generic) is then
            generic.base EXCLUSIVE_BORROW_TYPE == 1 generic.params.length == && return
        fi
        false
    }

    fn is_borrow self:$Type -> bool { self.is_shared_borrow self.is_exclusive_borrow || }

    fn get_integer_min self:$Type -> str {
        self match
            Type::Builtin(builtin) => {
                builtin match
                    BuiltinType::I8 => "-128"
                    BuiltinType::I16 => "-32768"
                    BuiltinType::I32 => "-2147483648"
                    BuiltinType::I64 => "-9223372036854775808"
                    _ => "0"
                end
            }
            _ => "0"
        end
    }

    fn get_integer_max self:$Type -> str {
        self match
            Type::Builtin(builtin) => {
                builtin match
                    BuiltinType::I8 => "127"
                    BuiltinType::I16 => "32767"
                    BuiltinType::I32 => "2147483647"
                    BuiltinType::I64 => "9223372036854775807"
                    BuiltinType::U8 => "255"
                    BuiltinType::U16 => "65535"
                    BuiltinType::U32 => "4294967295"
                    BuiltinType::U64 => "18446744073709551615"
                    _ => "0"
                end
            }
            _ => "0"
        end
    }

    fn format self:$Type -> str {
        self match
            Type::Unknown => {
                ""
            }
            Type::Builtin(builtin) => {
                builtin.format
            }
            Type::TypeVar(name) => {
                name.clone
            }
            Type::Const(const_type) => {
                if const_type.is_symbolic then
                    const_type.name.clone
                elif const_type.typ BuiltinType::Bool == then
                    if 0 const_type.value != then
                        "true"
                    else
                        "false"
                    fi
                else
                    const_type.value.to_str
                fi
            }
            Type::Generic(generic) => {
                if generic.base SHARED_BORROW_TYPE == 1 generic.params.length == && then
                    f"${0 generic
                        .params
                        .get
                        .format}" return
                fi
                if generic.base EXCLUSIVE_BORROW_TYPE == 1 generic.params.length == && then
                    f"mut${0 generic
                        .params
                        .get
                        .format}" return
                fi
                if 0 generic.params.length == then
                    generic.base.clone return
                fi
                List[str]::new = param_strs
                for elem in generic.params.iter do
                    elem.format param_strs.push
                done
                " " param_strs.join = params_str
                f"{generic.base}[{params_str}]"
            }
            Type::Function(fn_type) => {
                if 0 fn_type.parameters.length == 0 fn_type.return_types.length == && then
                    "fn" return
                fi
                StringBuilder::new = builder
                "fn[" builder.append
                if 0 fn_type.parameters.length != then
                    List[str]::new = fn_param_strs
                    for elem in fn_type.parameters.iter do
                        elem.format fn_param_strs.push
                    done
                    " " fn_param_strs.join builder.append
                fi
                if 0 fn_type.return_types.length != then
                    if 0 fn_type.parameters.length != then
                        " " builder.append
                    fi
                    "->" builder.append
                    for return_type in fn_type.return_types.iter do
                        " " builder.append
                        return_type.format builder.append
                    done
                fi
                "]" builder.append
                builder.build
            }
        end
    }

    fn base self:$Type -> Option[str] {
        self match
            Type::Generic(generic) => {
                if 0 generic.params.length == then
                    Option::None
                else
                    generic.base.clone Option::Some
                fi
            }
            _ => {
                Option::None
            }
        end
    }

    fn type_params self:$Type -> Option[$List[Type]] {
        if self Type::Generic(generic) is then
            if 0 generic.params.length != then
                generic.params Option[$List[Type]]::Some return
            fi
        fi
        Option::None
    }

    fn as_generic self:$Type -> Option[$GenericType] {
        if self Type::Generic(generic) is then
            if 0 generic.params.length != then
                generic Option[$GenericType]::Some return
            fi
        fi
        Option::None
    }

    fn substitute_t self:$Type bindings:$Map[str Type] -> Type {
        self match
            Type::Unknown => {
                Type::Unknown
            }
            Type::Builtin(builtin) => {
                builtin (BuiltinType) Type::Builtin
            }
            Type::TypeVar(name) => {
                if name bindings.get Option::Some(bound) is then
                    bound clone_type
                else
                    name.clone Type::TypeVar
                fi
            }
            Type::Const(const_type) => {
                if const_type.is_symbolic then
                    if const_type.name bindings.get Option::Some(bound) is then
                        bound clone_type
                    else
                        self clone_type
                    fi
                else
                    self clone_type
                fi
            }
            Type::Generic(generic) => {
                generic.base = base: $str
                if 0 generic.params.length == then
                    if base bindings.get Option::Some(bound) is then
                        bound clone_type return
                    fi
                    List[Type]::new base.clone GenericType Type::Generic return
                fi
                List[Type]::new = new_params
                for param in generic.params.iter do
                    bindings param.substitute_t new_params.push
                done
                new_params base.clone GenericType Type::Generic
            }
            Type::Function(fn_type) => {
                List[Type]::new = new_params
                for param in fn_type.parameters.iter do
                    bindings param.substitute_t new_params.push
                done
                List[Type]::new = new_returns
                for ret in fn_type.return_types.iter do
                    bindings ret.substitute_t new_returns.push
                done
                new_returns new_params FunctionType Type::Function
            }
        end
    }

    fn is_unknown self:$Type -> bool {
        self match
            Type::Unknown => {
                true
            }
            _ => {
                false
            }
        end
    }

    fn type_var_name self:$Type -> Option[str] {
        self match
            Type::TypeVar(name) => {
                name.clone Option::Some
            }
            _ => {
                Option::None
            }
        end
    }

    fn has_unresolved_type_var self:$Type -> bool {
        self match
            Type::TypeVar(_) => {
                true
            }
            Type::Const(const_type) => {
                const_type.is_symbolic
            }
            Type::Generic(generic) => {
                for param in generic.params.iter do
                    if param.has_unresolved_type_var then
                        true return
                    fi
                done
                false
            }
            Type::Function(fn_type) => {
                for param in fn_type.parameters.iter do
                    if param.has_unresolved_type_var then
                        true return
                    fi
                done
                for ret in fn_type.return_types.iter do
                    if ret.has_unresolved_type_var then
                        true return
                    fi
                done
                false
            }
            _ => {
                false
            }
        end
    }

    fn is_unknown_placeholder self:$Type -> bool {
        self match
            Type::Unknown => {
                true
            }
            Type::Generic(generic) => {
                0 generic.params.length == TYPE_UNKNOWN generic.base == &&
            }
            _ => {
                false
            }
        end
    }

    fn type_contains_var self:$Type type_var:$str -> bool {
        self match
            Type::TypeVar(name) => {
                name type_var ==
            }
            Type::Const(const_type) => {
                const_type.is_symbolic const_type.name type_var == &&
            }
            Type::Generic(generic) => {
                for param in generic.params.iter do
                    if type_var param.type_contains_var then
                        true return
                    fi
                done
                false
            }
            Type::Function(fn_type) => {
                for param in fn_type.parameters.iter do
                    if type_var param.type_contains_var then
                        true return
                    fi
                done
                for ret in fn_type.return_types.iter do
                    if type_var ret.type_contains_var then
                        true return
                    fi
                done
                false
            }
            _ => {
                false
            }
        end
    }

    fn is_fn_type_t self:$Type -> bool {
        self match
            Type::Function(_) => {
                true
            }
            _ => {
                false
            }
        end
    }

    fn is_builtin_type_t self:$Type -> bool {
        self match
            Type::Builtin(_) => {
                true
            }
            Type::Generic(generic) => {
                0 generic.params.length == "array" generic.base == &&
            }
            _ => {
                false
            }
        end
    }

    fn is_primitive_compare_type_t self:$Type -> bool {
        self match
            Type::Builtin(builtin) => {
                builtin.is_integer
                builtin.is_float ||
                builtin BuiltinType::Bool == ||
                builtin BuiltinType::Char == ||
                builtin BuiltinType::Cstr == ||
                builtin BuiltinType::Ptr == ||
            }
            _ => {
                false
            }
        end
    }

    fn is_integer_type_t self:$Type -> bool {
        if self Type::Builtin(builtin) is then
            builtin.is_integer return
        fi
        false
    }

    fn is_float_type_t self:$Type -> bool {
        if self Type::Builtin(builtin) is then
            builtin.is_float return
        fi
        false
    }

    fn is_integer_literal_t self:$Type -> bool { TYPE_INTEGER_LITERAL_T self.eq }

    fn is_float_literal_t self:$Type -> bool { TYPE_FLOAT_LITERAL_T self.eq }

    fn match_base self:$Type -> str {
        self match
            Type::Generic(generic) => {
                generic.base.clone
            }
            _ => {
                self.format
            }
        end
    }

    fn has_unresolved self:$Type -> bool {
        self match
            Type::Generic(generic) => {
                if 0 generic.params.length == then
                    false
                else
                    for param in generic.params.iter do
                        if param.is_unknown_placeholder then
                            true return
                        fi
                        if param.has_unresolved then
                            true return
                        fi
                    done
                    false
                fi
            }
            Type::Function(fn_type) => {
                for param in fn_type.parameters.iter do
                    if param.has_unresolved then
                        true return
                    fi
                done
                for ret in fn_type.return_types.iter do
                    if ret.has_unresolved then
                        true return
                    fi
                done
                false
            }
            Type::Unknown => {
                false
            }
            _ => {
                false
            }
        end
    }

    fn is_self_type self:$Type -> bool {
        self match
            Type::Generic(generic) => {
                0 generic.params.length == TRAIT_SELF_TYPE generic.base == &&
            }
            Type::TypeVar(name) => {
                TRAIT_SELF_TYPE name ==
            }
            _ => {
                false
            }
        end
    }

    fn eq self:$Type other:$Type -> bool {
        self match
            Type::Unknown => {
                other match
                    Type::Unknown => {
                        true
                    }
                    _ => {
                        false
                    }
                end
            }
            Type::Builtin(b_self) => {
                other match
                    Type::Builtin(b_other) => {
                        b_other b_self ==
                    }
                    _ => {
                        false
                    }
                end
            }
            Type::TypeVar(n_self) => {
                other match
                    Type::TypeVar(n_other) => {
                        n_other n_self ==
                    }
                    _ => {
                        false
                    }
                end
            }
            Type::Const(c_self) => {
                other match
                    Type::Const(c_other) => {
                        c_other.name c_self.name ==
                        c_other.typ c_self.typ == &&
                        c_other.value c_self.value == &&
                    }
                    _ => {
                        false
                    }
                end
            }
            Type::Generic(g_self) => {
                other match
                    Type::Generic(g_other) => {
                        if g_other.base g_self.base != then
                            false return
                        fi
                        if g_other.params.length g_self.params.length != then
                            false return
                        fi
                        for
                            pair in g_other.params.iter g_self
                                .params
                                .iter
                                .zip
                        do
                            if pair.second pair.first.eq ! then
                                false return
                            fi
                        done
                        true
                    }
                    _ => {
                        false
                    }
                end
            }
            Type::Function(f_self) => {
                other match
                    Type::Function(f_other) => {
                        if f_other.parameters.length f_self.parameters.length != then
                            false return
                        fi
                        if f_other.return_types.length f_self.return_types.length != then
                            false return
                        fi
                        for
                            pair in f_other.parameters.iter f_self
                                .parameters
                                .iter
                                .zip
                        do
                            if pair.second pair.first.eq ! then
                                false return
                            fi
                        done
                        for
                            pair in f_other.return_types.iter f_self
                                .return_types
                                .iter
                                .zip
                        do
                            if pair.second pair.first.eq ! then
                                false return
                            fi
                        done
                        true
                    }
                    _ => {
                        false
                    }
                end
            }
        end
    }
}

fn string_list_to_set items:$List[str] -> Set[str] {
    Set[str]::new = result
    for item in items.iter do
        item.clone result.add
    done
    result
}

fn canonicalize_type_var typ:$Type type_vars:$Set[str] -> Type {
    typ match
        Type::TypeVar(name) => {
            if name type_vars.has then
                typ clone_type
            else
                name.clone GenericType::new Type::Generic
            fi
        }
        Type::Generic(generic) => {
            if 0 generic.params.length == then
                if generic.base type_vars.has then
                    generic.base.clone Type::TypeVar return
                fi
                typ clone_type return
            fi
            List[Type]::new = new_params
            for param in generic.params.iter do
                type_vars param canonicalize_type_var new_params.push
            done
            new_params generic.base.clone GenericType Type::Generic
        }
        Type::Function(fn_type) => {
            List[Type]::new = new_params
            for param in fn_type.parameters.iter do
                type_vars param canonicalize_type_var new_params.push
            done
            List[Type]::new = new_returns
            for ret in fn_type.return_types.iter do
                type_vars ret canonicalize_type_var new_returns.push
            done
            new_returns new_params FunctionType Type::Function
        }
        _ => {
            typ clone_type
        }
    end
}

fn canonicalize_stack_effect_type_vars effect:mut$StackEffect type_vars:$Set[str] {
    0 (u64) = index
    while index effect StackEffect::parameters.length > do
        index effect StackEffect::parameters.get_mut = param
        type_vars param Parameter::typ canonicalize_type_var param Parameter::set_typ
        1 += index
    done
    0 (u64) = ret_index
    while ret_index effect StackEffect::return_types.length > do
        type_vars ret_index effect StackEffect::return_types.get canonicalize_type_var ret_index effect StackEffect::return_types.set
        1 += ret_index
    done
}

fn canonicalize_operation_type_vars ops:mut$List[Op] type_vars:$Set[str] {
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get_mut = op
        op.value clone_op_value = value
        value match
            OpValue::TypeCast(target) => {
                type_vars target canonicalize_type_var OpValue::TypeCast op Op::set_value
            }
            OpValue::NumericTry(numeric_try) => {
                numeric_try.target type_vars numeric_try.source canonicalize_type_var NumericTry
                OpValue::NumericTry op Op::set_value
            }
            OpValue::SizeOf(target) => {
                type_vars target canonicalize_type_var OpValue::SizeOf op Op::set_value
            }
            OpValue::PtrRead(target) => {
                type_vars target canonicalize_type_var OpValue::PtrRead op Op::set_value
            }
            OpValue::PtrWrite(target) => {
                type_vars target canonicalize_type_var OpValue::PtrWrite op Op::set_value
            }
            OpValue::PtrAsRef(target) => {
                type_vars target canonicalize_type_var OpValue::PtrAsRef op Op::set_value
            }
            OpValue::PtrAsMut(target) => {
                type_vars target canonicalize_type_var OpValue::PtrAsMut op Op::set_value
            }
            OpValue::PushArray(items) => {
                items clone_ops = owned_items
                type_vars owned_items canonicalize_operation_type_vars
                owned_items OpValue::PushArray op Op::set_value
            }
            OpValue::ExprGroup(items) => {
                items clone_ops = owned_items
                type_vars owned_items canonicalize_operation_type_vars
                owned_items OpValue::ExprGroup op Op::set_value
            }
            OpValue::MatchArm(arm) => {
                arm.clone = owned_arm
                type_vars owned_arm.guard_ops canonicalize_operation_type_vars
                owned_arm OpValue::MatchArm op Op::set_value
            }
            _ => {
            }
        end
        op.type_hint.clone = type_hint
        if type_hint Option::Some(hint) is then
            type_vars hint canonicalize_type_var Option::Some op Op::set_type_hint
        fi
        op.deferred_return_hint.clone = deferred_return_hint
        if deferred_return_hint Option::Some(hint) is then
            type_vars hint canonicalize_type_var Option::Some op Op::set_deferred_return_hint
        fi
        1 += op_index
    done
}

fn clone_type typ:$Type -> Type {
    typ match
        Type::Unknown => {
            Type::Unknown
        }
        Type::Builtin(builtin) => {
            builtin (BuiltinType) Type::Builtin
        }
        Type::TypeVar(name) => {
            name.clone Type::TypeVar
        }
        Type::Const(const_type) => {
            const_type.value const_type.typ (BuiltinType) const_type.name.clone ConstType Type::Const
        }
        Type::Generic(generic) => {
            List[Type]::new = parameters
            for parameter in generic.params.iter do
                parameter clone_type parameters.push
            done
            parameters generic.base.clone GenericType Type::Generic
        }
        Type::Function(function_type) => {
            List[Type]::new = parameters
            for parameter in function_type.parameters.iter do
                parameter clone_type parameters.push
            done
            List[Type]::new = return_types
            for return_type in function_type.return_types.iter do
                return_type clone_type return_types.push
            done
            return_types parameters FunctionType Type::Function
        }
    end
}

impl Type: Clone {
    fn clone self:$Type -> Type { self clone_type }
}
# Parse a non-negative integer literal, e.g. the `3` in `array[i64 3]`
# (ADR-0152). None if `source` is empty or has a non-digit character.

fn try_parse_uint_literal source:$str -> Option[i64] {
    if 0 source.length == then
        Option[i64]::None return
    fi
    0 = value
    0 (u64) = index
    while index source.length > do
        if index source.at.is_digit ! then
            Option[i64]::None return
        fi
        10 value.wrapping_mul = value
        index source.at.codepoint i64::from '0'.codepoint i64::from - value.wrapping_add = value
        1 += index
    done
    value Option::Some
}

fn parse_type_str source:$str -> Type {
    if "" source == then
        Type::Unknown return
    fi
    if source "mut$" str::starts_with then
        source 4 source.length 4 - str::substring parse_type_str = target
        if target.is_borrow then
            Type::Unknown return
        fi
        List[Type]::new = parameters
        target parameters.push
        parameters EXCLUSIVE_BORROW_TYPE GenericType Type::Generic return
    fi
    if source "$" str::starts_with then
        source 1 source.length 1 - str::substring parse_type_str = target
        if target.is_borrow then
            Type::Unknown return
        fi
        List[Type]::new = parameters
        target parameters.push
        parameters SHARED_BORROW_TYPE GenericType Type::Generic return
    fi
    if source parse_builtin Option::Some(builtin) is then
        builtin Type::Builtin return
    fi
    # Constant argument in type position (ADR-0152, ADR-0153). An integer literal
    # carries `u64` provisionally; its width is checked later against the declared
    # parameter type. Char literals are handled in `parse_type_ast` (codepoint
    # decoder in scope there).
    if source try_parse_uint_literal Option::Some(const_value) is then
        BuiltinType::U64 const_value ConstType::concrete Type::Const return
    fi
    if "true" source == then
        BuiltinType::Bool 1 ConstType::concrete Type::Const return
    fi
    if "false" source == then
        BuiltinType::Bool 0 ConstType::concrete Type::Const return
    fi
    # TypeVar: single uppercase letter
    if 1 source.length == then
        if 0 source.at.is_upper then
            source.clone Type::TypeVar return
        fi
    fi
    # Function type: bare "fn" or "fn[...]"
    if "fn" source == then
        List[Type]::new List[Type]::new FunctionType Type::Function return
    fi
    if source "fn[" str::starts_with source "]" str::ends_with && then
        source.length 4 - = inner_length
        source 3 inner_length str::substring = fn_inner
        List[Type]::new = fn_params
        List[Type]::new = fn_returns
        false = past_arrow
        StringBuilder::new = current
        0 = depth
        for ch in fn_inner.iter do
            if '[' ch == then
                1 += depth
                ch current.append_char
            elif ']' ch == then
                depth 1 - = depth
                ch current.append_char
            elif ' ' ch == 0 depth == && then
                if 0 current.length != then
                    current.build = token
                    if "->" token == then
                        true = past_arrow
                    elif past_arrow then
                        token parse_type_str fn_returns.push
                    else
                        token parse_type_str fn_params.push
                    fi
                    StringBuilder::new = current
                fi
            else
                ch current.append_char
            fi
        done
        if 0 current.length != then
            current.build = last_token
            if "->" last_token == then
                # bare arrow at end — nothing
            elif past_arrow then
                last_token parse_type_str fn_returns.push
            else
                last_token parse_type_str fn_params.push
            fi
        fi
        fn_returns fn_params FunctionType Type::Function return
    fi
    # Generic: Name[params]
    if source "[" str::contains source "]" str::ends_with && then
        source "[" str::find = bracket_pos
        source 0 bracket_pos (u64) str::substring = base
        source.length base.length - 2 - = inner_len
        source base.length 1 + inner_len str::substring = inner
        inner parse_generic_params = params
        params base GenericType Type::Generic return
    fi
    # Named type with no params (user struct/enum)
    List[Type]::new = empty_params
    empty_params source.clone GenericType Type::Generic
}

# ============================================================================
# Type utility functions
# ============================================================================

fn split_type_tokens s:$str -> List[str] {
    # Split a space-separated type string into tokens, respecting brackets.
    List[str]::new = tokens
    StringBuilder::new = current
    0 = depth
    for ch in s.iter do
        if '[' ch == then
            1 += depth
            ch current.append_char
        elif ']' ch == then
            depth 1 - = depth
            ch current.append_char
        elif ' ' ch == 0 depth == && then
            if 0 current.length != then
                current.build tokens.push
                StringBuilder::new = current
            fi
        else
            ch current.append_char
        fi
    done
    if 0 current.length != then
        current.build tokens.push
    fi
    tokens
}

fn build_parameterized_type base:$str params:$List[str] -> Type {
    Map[str Type]::new params base build_resolved_type
}

fn build_resolved_type base:$str type_vars:$List[str] bindings:$Map[str Type] -> Type {
    List[Type]::new = params
    for type_var in type_vars.iter do
        if type_var bindings.get Option::Some(bound) is then
            bound clone_type params.push
        else
            type_var.clone Type::TypeVar params.push
        fi
    done
    params base.clone GenericType Type::Generic
}

# ============================================================================
# StackEffect utilities
# ============================================================================

fn stack_effect_to_str effect:$StackEffect -> str {
    StringBuilder::new = builder
    if 0 effect StackEffect::parameters.length == then
        "None" builder.append
    else
        List[str]::new = se_param_strs
        for param in effect StackEffect::parameters.iter do
            param Parameter::typ.format se_param_strs.push
        done
        " " se_param_strs.join builder.append
    fi
    " -> " builder.append
    if 0 effect StackEffect::return_types.length == then
        "None" builder.append
    else
        List[str]::new = se_return_strs
        for elem in effect StackEffect::return_types.iter do
            elem.format se_return_strs.push
        done
        " " se_return_strs.join builder.append
    fi
    builder.build
}

fn stack_effect_to_function_type effect:$StackEffect -> Type {
    List[Type]::new = fn_params
    for fn_param in effect StackEffect::parameters.iter do
        fn_param Parameter::typ clone_type fn_params.push
    done
    List[Type]::new = fn_returns
    for fn_return in effect StackEffect::return_types.iter do
        fn_return clone_type fn_returns.push
    done
    fn_returns fn_params FunctionType Type::Function
}

fn function_type_to_stack_effect fn_type:$FunctionType -> StackEffect {
    List[Parameter]::new = params
    for param_type in fn_type FunctionType::parameters.iter do
        "" param_type clone_type Parameter params.push
    done
    fn_type FunctionType::return_types.clone params StackEffect::new
}

fn stack_effect_type_param_matches expected:$Type actual:$Type type_vars:mut$Set[str] -> bool {
    if expected actual.eq then
        true return
    fi
    if expected.is_unknown_placeholder then
        true return
    fi
    if actual.is_unknown_placeholder then
        true return
    fi
    if expected.type_var_name Option::Some(expected_name) is then
        if expected_name type_vars.has then
            true return
        fi
    fi
    if actual.type_var_name Option::Some(actual_name) is then
        if actual_name type_vars.has then
            true return
        fi
    fi
    false
}

fn collect_stack_effect_type_vars typ:$Type type_vars:mut$Set[str] {
    if typ.type_var_name Option::Some(type_var_name) is then
        type_var_name.clone type_vars.add
        return
    fi
    typ match
        Type::Generic(generic) => {
            for generic_param in generic.params.iter do
                type_vars generic_param collect_stack_effect_type_vars
            done
        }
        Type::Function(fn_type) => {
            for fn_param in fn_type.parameters.iter do
                type_vars fn_param collect_stack_effect_type_vars
            done
            for fn_return in fn_type.return_types.iter do
                type_vars fn_return collect_stack_effect_type_vars
            done
        }
        _ => {
        }
    end
}

fn stack_effect_type_matches expected:$Type actual:$Type -> bool {
    if expected actual.eq then
        true return
    fi
    if expected.is_unknown_placeholder then
        true return
    fi
    if actual.is_unknown_placeholder then
        true return
    fi
    expected clone_type = expected_pattern
    actual clone_type = actual_pattern
    expected_pattern match
        Type::Function(expected_fn) => {
            actual_pattern match
                Type::Function(actual_fn) => {
                    if 0 expected_fn.parameters.length == 0 expected_fn.return_types.length == && then
                        true return
                    fi
                    if 0 actual_fn.parameters.length == 0 actual_fn.return_types.length == && then
                        true return
                    fi
                    if expected_fn.parameters.length actual_fn.parameters.length != then
                        false return
                    fi
                    if expected_fn.return_types.length actual_fn.return_types.length != then
                        false return
                    fi
                    for
                        pair in actual_fn.parameters.iter expected_fn
                            .parameters
                            .iter
                            .zip
                    do
                        if pair.second pair.first stack_effect_type_matches ! then
                            false return
                        fi
                    done
                    for
                        pair in actual_fn.return_types.iter expected_fn
                            .return_types
                            .iter
                            .zip
                    do
                        if pair.second pair.first stack_effect_type_matches ! then
                            false return
                        fi
                    done
                    true return
                }
                _ => {
                }
            end
        }
        Type::Generic(expected_generic) => {
            actual_pattern match
                Type::Generic(actual_generic) => {
                    if expected_generic.base actual_generic.base != then
                        false return
                    fi
                    if expected_generic.params.length actual_generic.params.length != then
                        false return
                    fi
                    Set[str]::new = type_vars
                    type_vars expected collect_stack_effect_type_vars
                    type_vars actual collect_stack_effect_type_vars
                    for
                        pair in actual_generic.params.iter expected_generic
                            .params
                            .iter
                            .zip
                    do
                        if type_vars pair.second pair.first stack_effect_type_param_matches ! then
                            false return
                        fi
                    done
                    true return
                }
                _ => {
                }
            end
        }
        _ => {
        }
    end
    false
}

fn stack_effect_matches effect_a:$StackEffect effect_b:$StackEffect -> bool {
    # Check if two stack effects are compatible, respecting any types.
    if effect_a StackEffect::parameters.length effect_b StackEffect::parameters.length != then
        false return
    fi
    if effect_a StackEffect::return_types.length effect_b StackEffect::return_types.length != then
        false return
    fi

    for param_pair in effect_b StackEffect::parameters.iter effect_a StackEffect::parameters.iter.zip do
        param_pair.first Parameter::typ = type_a: $Type
        param_pair.second Parameter::typ = type_b: $Type
        if type_b type_a stack_effect_type_matches ! then
            false return
        fi
    done

    for
        return_pair in effect_b StackEffect::return_types.iter effect_a StackEffect::return_types.iter.zip
    do
        if return_pair.second return_pair.first stack_effect_type_matches ! then
            false return
        fi
    done

    true
}

fn apply_type_subs_to_stack_effect effect:$StackEffect subs:mut$Map[str Type] -> StackEffect {
    List[Parameter]::new = params
    for param in effect StackEffect::parameters.iter do
        subs param Parameter::typ.substitute_t = new_typ
        param Parameter::name.clone new_typ Parameter::named params.push
    done
    List[Type]::new = returns
    for return_type in effect StackEffect::return_types.iter do
        subs return_type.substitute_t returns.push
    done
    effect.clone = resolved
    params resolved StackEffect::set_parameters
    returns resolved StackEffect::set_return_types
    resolved
}

fn resolve_trait_stack_effect effect:$StackEffect self_type:$Type -> StackEffect {
    Map[str Type]::new = substitutions
    self_type clone_type TRAIT_SELF_TYPE substitutions.set
    substitutions effect apply_type_subs_to_stack_effect
}

