pub fn intrinsic_from_str value:$str -> std::Option[IntrinsicKind] {
    value match
        "drop" => IntrinsicKind::Drop std::Option::Some return
        "dup" => IntrinsicKind::Dup std::Option::Some return
        "copy" => IntrinsicKind::Copy std::Option::Some return
        "over" => IntrinsicKind::Over std::Option::Some return
        "rot" => IntrinsicKind::Rot std::Option::Some return
        "swap" => IntrinsicKind::Swap std::Option::Some return
        "alloc" => IntrinsicKind::Alloc std::Option::Some return
        "free" => IntrinsicKind::Free std::Option::Some return
        "load8" => IntrinsicKind::Load8 std::Option::Some return
        "load16" => IntrinsicKind::Load16 std::Option::Some return
        "load32" => IntrinsicKind::Load32 std::Option::Some return
        "load64" => IntrinsicKind::Load64 std::Option::Some return
        "store8" => IntrinsicKind::Store8 std::Option::Some return
        "store16" => IntrinsicKind::Store16 std::Option::Some return
        "store32" => IntrinsicKind::Store32 std::Option::Some return
        "store64" => IntrinsicKind::Store64 std::Option::Some return
        "print" => IntrinsicKind::Print std::Option::Some return
        "panic" => IntrinsicKind::Panic std::Option::Some return
        "typeof" => IntrinsicKind::Typeof std::Option::Some return
        "size_of" => IntrinsicKind::SizeOf std::Option::Some return
        "exec" => IntrinsicKind::Exec std::Option::Some return
        "syscall0" => IntrinsicKind::Syscall0 std::Option::Some return
        "syscall1" => IntrinsicKind::Syscall1 std::Option::Some return
        "syscall2" => IntrinsicKind::Syscall2 std::Option::Some return
        "syscall3" => IntrinsicKind::Syscall3 std::Option::Some return
        "syscall4" => IntrinsicKind::Syscall4 std::Option::Some return
        "syscall5" => IntrinsicKind::Syscall5 std::Option::Some return
        "syscall6" => IntrinsicKind::Syscall6 std::Option::Some return
        "argc" => IntrinsicKind::Argc std::Option::Some return
        "argv" => IntrinsicKind::Argv std::Option::Some return
        "envp" => IntrinsicKind::Envp std::Option::Some return
        _ => {
        }
    end
    if
        "print_int" value ==
        "print_str" value == ||
        "print_bool" value == ||
        "print_char" value == ||
    then
        IntrinsicKind::Print std::Option::Some
    else
        std::Option[IntrinsicKind]::None
    fi
}

pub fn operator_from_str value:$str -> std::Option[OperatorKind] {
    if "+" value == then
        OperatorKind::Plus std::Option::Some
    elif "-" value == then
        OperatorKind::Minus std::Option::Some
    elif "*" value == then
        OperatorKind::Mul std::Option::Some
    elif "/" value == then
        OperatorKind::Div std::Option::Some
    elif "%" value == then
        OperatorKind::Mod std::Option::Some
    elif "<<" value == then
        OperatorKind::Shl std::Option::Some
    elif ">>" value == then
        OperatorKind::Shr std::Option::Some
    elif "&" value == then
        OperatorKind::BitAnd std::Option::Some
    elif "|" value == then
        OperatorKind::BitOr std::Option::Some
    elif "^" value == then
        OperatorKind::BitXor std::Option::Some
    elif "~" value == then
        OperatorKind::BitNot std::Option::Some
    elif "&&" value == then
        OperatorKind::And std::Option::Some
    elif "||" value == then
        OperatorKind::Or std::Option::Some
    elif "!" value == then
        OperatorKind::Not std::Option::Some
    elif "==" value == then
        OperatorKind::Eq std::Option::Some
    elif ">=" value == then
        OperatorKind::Ge std::Option::Some
    elif ">" value == then
        OperatorKind::Gt std::Option::Some
    elif "<=" value == then
        OperatorKind::Le std::Option::Some
    elif "<" value == then
        OperatorKind::Lt std::Option::Some
    elif "!=" value == then
        OperatorKind::Ne std::Option::Some
    elif "=" value == then
        OperatorKind::Assign std::Option::Some
    elif "-=" value == then
        OperatorKind::AssignDec std::Option::Some
    elif "+=" value == then
        OperatorKind::AssignInc std::Option::Some
    elif "?" value == then
        OperatorKind::Question std::Option::Some
    else
        std::Option[OperatorKind]::None
    fi
}

pub fn delimiter_from_str value:$str -> std::Option[DelimiterKind] {
    if "->" value == then
        DelimiterKind::Arrow std::Option::Some
    elif "=>" value == then
        DelimiterKind::FatArrow std::Option::Some
    elif 1 value.length == then
        0 value.at delimiter_from_char
    else
        std::Option[DelimiterKind]::None
    fi
}

pub fn delimiter_from_char c:char -> std::Option[DelimiterKind] {
    if ',' c == then
        DelimiterKind::Comma std::Option::Some
    elif ':' c == then
        DelimiterKind::Colon std::Option::Some
    elif '.' c == then
        DelimiterKind::Dot std::Option::Some
    elif '#' c == then
        DelimiterKind::Hashtag std::Option::Some
    elif '{' c == then
        DelimiterKind::OpenBrace std::Option::Some
    elif '}' c == then
        DelimiterKind::CloseBrace std::Option::Some
    elif '[' c == then
        DelimiterKind::OpenBracket std::Option::Some
    elif ']' c == then
        DelimiterKind::CloseBracket std::Option::Some
    elif '(' c == then
        DelimiterKind::OpenParen std::Option::Some
    elif ')' c == then
        DelimiterKind::CloseParen std::Option::Some
    else
        std::Option::None
    fi
}

