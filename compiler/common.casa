pub fn operator_from_str value:$str -> std::Option[OperatorKind] {
    if "+" value == then
        OperatorKind::Plus std::Option::Some
    elif "-" value == then
        OperatorKind::Minus std::Option::Some
    elif "*" value == then
        OperatorKind::Mul std::Option::Some
    elif "/" value == then
        OperatorKind::Div std::Option::Some
    elif "%" value == then
        OperatorKind::Mod std::Option::Some
    elif "<<" value == then
        OperatorKind::Shl std::Option::Some
    elif ">>" value == then
        OperatorKind::Shr std::Option::Some
    elif "&" value == then
        OperatorKind::BitAnd std::Option::Some
    elif "|" value == then
        OperatorKind::BitOr std::Option::Some
    elif "^" value == then
        OperatorKind::BitXor std::Option::Some
    elif "~" value == then
        OperatorKind::BitNot std::Option::Some
    elif "&&" value == then
        OperatorKind::And std::Option::Some
    elif "||" value == then
        OperatorKind::Or std::Option::Some
    elif "!" value == then
        OperatorKind::Not std::Option::Some
    elif "==" value == then
        OperatorKind::Eq std::Option::Some
    elif ">=" value == then
        OperatorKind::Ge std::Option::Some
    elif ">" value == then
        OperatorKind::Gt std::Option::Some
    elif "<=" value == then
        OperatorKind::Le std::Option::Some
    elif "<" value == then
        OperatorKind::Lt std::Option::Some
    elif "!=" value == then
        OperatorKind::Ne std::Option::Some
    elif "=" value == then
        OperatorKind::Assign std::Option::Some
    elif "-=" value == then
        OperatorKind::AssignDec std::Option::Some
    elif "+=" value == then
        OperatorKind::AssignInc std::Option::Some
    elif "?" value == then
        OperatorKind::Question std::Option::Some
    else
        std::Option[OperatorKind]::None
    fi
}

pub fn delimiter_from_str value:$str -> std::Option[DelimiterKind] {
    if "->" value == then
        DelimiterKind::Arrow std::Option::Some
    elif "=>" value == then
        DelimiterKind::FatArrow std::Option::Some
    elif 1 value.length == then
        0 value.at delimiter_from_char
    else
        std::Option[DelimiterKind]::None
    fi
}
# ASCII bits for # ( ) , . : in the low word and [ ] { } in the high word.
const DELIMITER_LOW_BITS 288321669976555520
const DELIMITER_HIGH_BITS 2882303762188206080

pub fn is_delimiter_char c:char -> bool {
    c.codepoint u64::from = code
    DELIMITER_LOW_BITS = bits: u64
    if 64 code >= then
        if 128 code >= then
            false return
        fi
        DELIMITER_HIGH_BITS = bits: u64
        64 -= code
    fi
    0 bits code >> 1 & !=
}

pub fn delimiter_from_char c:char -> std::Option[DelimiterKind] {
    if ',' c == then
        DelimiterKind::Comma std::Option::Some
    elif ':' c == then
        DelimiterKind::Colon std::Option::Some
    elif '.' c == then
        DelimiterKind::Dot std::Option::Some
    elif '#' c == then
        DelimiterKind::Hashtag std::Option::Some
    elif '{' c == then
        DelimiterKind::OpenBrace std::Option::Some
    elif '}' c == then
        DelimiterKind::CloseBrace std::Option::Some
    elif '[' c == then
        DelimiterKind::OpenBracket std::Option::Some
    elif ']' c == then
        DelimiterKind::CloseBracket std::Option::Some
    elif '(' c == then
        DelimiterKind::OpenParen std::Option::Some
    elif ')' c == then
        DelimiterKind::CloseParen std::Option::Some
    else
        std::Option::None
    fi
}

