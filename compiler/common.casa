    pub type_vars:         std::List[std::String]
    pub derived_traits:    std::List[std::String]
    pub variant_locations: std::Map[std::String Location]
}

pub fn has_inner_values casa_enum:$CasaEnum -> bool {
    for pair in casa_enum CasaEnum::variant_types.iter do
        if 0 pair.second.length != then
            true return
        fi
    done
    false
}

