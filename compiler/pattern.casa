# pattern.casa — consolidated match-pattern module.
#
# Introspection primitives and per-phase entry points every compiler phase
# (parser-resolve, typechecker, bytecode) uses to handle match patterns
# without re-reading op-level type metadata.
import "std"
import "common"
import "error"
import "typechecker"

# ============================================================================
# pattern_is_wildcard: true only for a bare `_` wildcard arm.
# Currently stored as an EnumVariant whose variant_name is "_".

fn pattern_is_wildcard op:mut$Op -> bool {
    op pattern_value_of match
        PatternValue::EnumVariant(variant) => {
            MATCH_WILDCARD variant.variant_name ==
        }
        PatternValue::Struct => false
        PatternValue::Literal => false
    end
}
# pattern_is_guarded — true when the arm carries a guard expression.
# Guarded arms never cover their pattern for duplicate-arm and
# exhaustiveness analysis (they may still fail at runtime).

fn pattern_is_guarded op:mut$Op -> bool { op pattern_guard_ops.length 0 != }

# ============================================================================
# pattern_covered_key: stable key used for duplicate-arm detection and for
# exhaustiveness bookkeeping. Mirrors the `__covered:{...}` keys the
# typechecker already produces.

fn pattern_covered_key op:mut$Op -> str {
    if op pattern_is_guarded then
        "" return
    fi
    op pattern_value_of match
        PatternValue::Struct(struct_pat) => {
            f"__covered:{struct_pat.struct_name}"
        }
        PatternValue::Literal(literal_pat) => {
            f"__covered:{literal_pat.raw}"
        }
        PatternValue::EnumVariant(variant) => {
            f"__covered:{variant.variant_name}"
        }
    end
}

# ============================================================================
# pattern_bindings: names this pattern introduces into the enclosing scope.
# Struct patterns bind field aliases; enum variants bind payload names;
# literals and wildcards bind nothing.

fn pattern_bindings op:mut$Op -> List[str] {
    List[str]::new = out
    op pattern_value_of match
        PatternValue::Struct(struct_pat) => {
            struct_pat.bindings.keys = field_names
            for field_name in field_names.iter do
                if field_name struct_pat.bindings.get Option::Some(bound_name) is then
                    bound_name out.push
                fi
            done
        }
        PatternValue::EnumVariant(variant) => {
            variant.bindings = names
            for name in names.iter do
                name.clone out.push
            done
        }
        PatternValue::Literal => {
        }
    end
    out
}

# ============================================================================
# diagnose_bare_enum_pattern — emit a targeted error if a match arm uses an
# unqualified enum variant (e.g. `North =>` instead of `Direction::North =>`).

fn diagnose_bare_enum_pattern tc:mut$TypeChecker op:mut$Op variant:EnumVariant arm_base:str {
    if "" variant EnumVariant::enum_name != then
        return
    fi
    if
        arm_base tc
            .store
            .enums
            .get Option::Some(bare_enum) is
    then
        variant EnumVariant::variant_name = bare_name
        bare_name bare_enum CasaEnum::variants string_list_index = bare_index
        if 0 bare_index >= then
            op Op::location f"Unqualified enum variant `{bare_name}`. Did you mean `{arm_base}::{bare_name}`?" ErrorKind::TypeMismatch tc.diagnostics.record_error
        else
            op Op::location f"Expected qualified enum variant (e.g. `{arm_base}::{0 bare_enum CasaEnum::variants.get}`) or `_`, got `{bare_name}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
        fi
    fi
}

# ============================================================================
# detect_duplicate_arm — raise an error if the current pattern's covered key
# has already been recorded on this match context.

fn detect_duplicate_arm
    type_checker:mut$TypeChecker
    match_ctx:mut$MatchContext
    op:mut$Op
    covered_key:mut$str
{
    if "" covered_key == then
        return
    fi
    for record in match_ctx MatchContext::branch_records.iter do
        if covered_key record == then
            op Op::location f"Duplicate match arm for `{covered_key}`" ErrorKind::DuplicateName type_checker.diagnostics.record_error
        fi
    done
    if covered_key match_ctx MatchContext::current_branch_label == then
        op Op::location f"Duplicate match arm for `{covered_key}`" ErrorKind::DuplicateName type_checker.diagnostics.record_error
    fi
}

# ============================================================================
# unify_arm_stacks — reconcile the stack effect of the arm just finished
# against the arm template recorded on the MatchContext. Runs only when a
# prior arm has already executed (condition_present).

fn unify_arm_stacks tc:mut$TypeChecker match_ctx:mut$MatchContext op:mut$Op {
    if "" match_ctx MatchContext::current_branch_label != then
        match_ctx MatchContext::current_branch_label match_ctx MatchContext::branch_records.push
    fi
    match_ctx MatchContext::before = match_before
    match_ctx MatchContext::after = match_after
    if
        match_before tc.stack.equals
        match_after match_before.equals && !
    then
        tc.store match_after tc.stack.unify_types = unified
        if 0 unified.length != match_after match_before.equals ! && then
            match_after.mark_literals_runtime
            unified match_after.set_types
        elif match_after match_before.equals then
            tc.stack match_after.restore
        else
            op Op::location "Match arms have incompatible stack effects" ErrorKind::StackMismatch tc.diagnostics.record_error
        fi
    fi
    match_before tc.stack.restore
}

# ============================================================================
# register_struct_pattern_bindings — attach field types to each local bound
# by a struct destructure arm.

fn assign_struct_binding_type
    tc:mut$TypeChecker
    matched_struct:$CasaStruct
    match_subject_type:mut$Type
    field_name:mut$str
    bound_var:str
    function_opt:mut$Option[Function]
{
    match_subject_type clone_type = subject_type
    if subject_type.borrow_target Option::Some(target) is then
        target = subject_type
    fi
    matched_struct.type_vars subject_type aggregate_type_bindings = bindings
    for member in matched_struct CasaStruct::members.iter do
        if field_name member Member::name == then
            bindings member Member::typ.substitute_t = binding_type
            if match_subject_type.is_borrow function_opt binding_type tc.type_is_duplicable ! && then
                binding_type clone_type = target
                false = shared
                if binding_type.borrow_target Option::Some(borrowed) is then
                    borrowed = target
                    binding_type.is_shared_borrow = shared
                fi
                if match_subject_type.is_shared_borrow then
                    true = shared
                fi
                if shared then
                    SHARED_BORROW_TYPE
                else
                    EXCLUSIVE_BORROW_TYPE
                fi
                target apply_borrow_type = binding_type
            fi
            function_opt binding_type bound_var tc set_binding_type
        fi
    done
}

fn register_struct_pattern_bindings
    tc:mut$TypeChecker
    function_opt:mut$Option[Function]
    struct_pattern:StructPattern
    match_subject_type:mut$Type
{
    struct_pattern StructPattern::struct_name tc
        .store
        .structs
        .get = matched_struct_opt
    if matched_struct_opt.is_none then
        empty_location "Expected option value while unwrapping struct_pattern StructPattern::struct_name tc.store.structs.get" ErrorKind::Syntax tc.diagnostics.record_error
        return
    fi
    matched_struct_opt.unwrap = matched_struct
    struct_pattern StructPattern::bindings.keys = binding_keys
    for field_name in binding_keys.iter do
        if field_name struct_pattern StructPattern::bindings.get Option::Some(bound_var) is then
            function_opt bound_var field_name match_subject_type matched_struct tc
            assign_struct_binding_type
        else
            empty_location "Expected option value while unwrapping field_name struct_pattern StructPattern::bindings.get" ErrorKind::Syntax tc.diagnostics.record_error
        fi
    done
}

# ============================================================================
# register_enum_pattern_bindings — attach payload types to each local bound
# by an enum-variant destructure arm.

fn register_enum_pattern_bindings
    tc:mut$TypeChecker
    function_opt:mut$Option[Function]
    variant:EnumVariant
    match_subject_type:mut$Type
{
    if 0 variant EnumVariant::bindings.length == then
        return
    fi
    "" = borrow_prefix
    match_subject_type clone_type = subject_type
    if match_subject_type.borrow_target Option::Some(target) is then
        if match_subject_type.is_shared_borrow then
            SHARED_BORROW_TYPE
        else
            EXCLUSIVE_BORROW_TYPE
        fi
        = borrow_prefix
        target = subject_type
    fi
    subject_type.match_base = base_enum_name
    if
        base_enum_name tc
            .store
            .enums
            .get Option::Some(casa_enum) is
    then
        if
            variant EnumVariant::variant_name casa_enum CasaEnum::variant_types.get Option::Some(inner_types) is
        then
            subject_type casa_enum build_enum_type_bindings = type_bindings
            match_subject_type borrow_prefix variant type_bindings inner_types function_opt tc
            apply_enum_bindings
        fi
    fi
}

fn build_enum_type_bindings casa_enum:CasaEnum match_subject_type:mut$Type -> Map[str Type] {
    Map[str Type]::new = type_bindings
    if 0 casa_enum CasaEnum::type_vars.length == then
        type_bindings return
    fi
    if match_subject_type.type_params Option::Some(type_params) is then
        0 (u64) = type_var_index
        while
            type_var_index casa_enum CasaEnum::type_vars.length >
            type_var_index type_params.length > &&
        do
            type_var_index type_params.get type_var_index casa_enum CasaEnum::type_vars.get type_bindings.set = type_bindings
            1 += type_var_index
        done
    fi
    type_bindings
}

fn apply_enum_bindings
    tc:mut$TypeChecker
    function_opt:mut$Option[Function]
    inner_types:$List[Type]
    type_bindings:$Map[str Type]
    variant:$EnumVariant
    borrow_prefix:$str
    match_subject_type:mut$Type
{
    0 (u64) = bind_index
    while
        bind_index variant EnumVariant::bindings.length >
        bind_index inner_types.length > &&
    do
        bind_index variant EnumVariant::bindings.get = binding_var
        bind_index inner_types.get = binding_type
        type_bindings binding_type.substitute_t = binding_type
        if "" borrow_prefix != function_opt binding_type tc.type_is_duplicable ! && then
            binding_type clone_type = target
            SHARED_BORROW_TYPE borrow_prefix == = shared
            if binding_type.borrow_target Option::Some(borrowed) is then
                borrowed = target
                if binding_type.is_shared_borrow then
                    true = shared
                fi
            fi
            if match_subject_type.is_shared_borrow then
                true = shared
            fi
            if shared then
                SHARED_BORROW_TYPE
            else
                EXCLUSIVE_BORROW_TYPE
            fi
            target apply_borrow_type = binding_type
        fi
        function_opt binding_type binding_var tc set_binding_type
        1 += bind_index
    done
}

# ============================================================================
# register_pattern_bindings — dispatch binding registration by pattern kind.

fn register_pattern_bindings
    tc:mut$TypeChecker
    function_opt:mut$Option[Function]
    op:mut$Op
    match_subject_type:mut$Type
{
    op pattern_value_of match
        PatternValue::Struct(struct_pattern) => {
            match_subject_type struct_pattern function_opt tc register_struct_pattern_bindings
        }
        PatternValue::EnumVariant(variant) => {
            if op pattern_is_wildcard then
                return
            fi
            match_subject_type variant function_opt tc register_enum_pattern_bindings
        }
        PatternValue::Literal => {
        }
    end
}

fn record_match_pattern_origins
    tc:mut$TypeChecker
    op:mut$Op
    match_subject_type:mut$Type
    match_origins:mut$Option[List[str]]
    match_place:mut$Option[str]
    function_opt:mut$Option[Function]
{
    for binding_name in op pattern_bindings.iter do
        if binding_name tc.scope.lookup Option::Some(binding_type) is then
            if
                tc.store binding_type type_has_borrow
                function_opt binding_type tc.type_is_duplicable ! ||
            then
                match_origins clone_origins = origins
                if match_subject_type.is_borrow then
                    if match_place Option::Some(subject_place) is then
                        subject_place.clone = binding_place
                        if op pattern_value_of PatternValue::Struct(struct_pattern) is then
                            for pair in struct_pattern.bindings.iter do
                                if pair.second binding_name == then
                                    f"{subject_place}.{pair.first}" = binding_place
                                fi
                            done
                        fi
                        binding_type.is_exclusive_borrow binding_place origins add_origin = origins
                    fi
                fi
                origins binding_name tc.record_binding_origins
            fi
        fi
    done
}

fn check_literal_pattern
    tc:mut$TypeChecker
    op:mut$Op
    literal_pattern:LiteralPattern
    subject_type:mut$Type
{
    if subject_type.is_unknown_placeholder then
        return
    fi
    literal_pattern.value match
        LiteralValue::Int(literal) => {
            if subject_type.is_integer_type_t ! then
                op.location f"Integer pattern `{literal.raw}` requires an integer subject, got `{subject_type.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                return
            fi
            if subject_type literal.fits ! then
                subject_type.get_integer_min = minimum
                subject_type.get_integer_max = maximum
                op.location f"Integer pattern `{literal.raw}` is outside `{subject_type.format}` range {minimum}..{maximum}" ErrorKind::TypeMismatch tc.diagnostics.record_error
                return
            fi
        }
        LiteralValue::Str(_) => {
            if subject_type TYPE_STR_T.eq ! then
                op.location f"String pattern requires a `str` subject, got `{subject_type.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                return
            fi
        }
        LiteralValue::Bool(_) => {
            if subject_type TYPE_BOOL_T.eq ! then
                op.location f"Boolean pattern requires a `bool` subject, got `{subject_type.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                return
            fi
        }
        LiteralValue::Char(_) => {
            if subject_type TYPE_CHAR_T.eq ! then
                op.location f"Character pattern requires a `char` subject, got `{subject_type.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                return
            fi
        }
    end
    subject_type clone_type Option::Some op Op::set_type_hint
}

# ============================================================================
# typecheck_match_op — per-arm typecheck entry point.
#
# Handles pattern-shape validation, duplicate-arm detection, match-arm
# stack unification, and binding-type registration for a single OpMatchArm.
# Callers (currently check_match) delegate the entire arm body to this
# function; start/end of the match block remain in check_match.

fn typecheck_match_op tc:mut$TypeChecker function_opt:mut$Option[Function] op:mut$Op {
    if 0 tc.branched_stacks.length == then
        return
    fi
    tc.branched_stacks.length 1 - tc.branched_stacks.get = top_frame
    if top_frame BranchFrame::BranchMatch(match_ctx) is then
        if match_ctx.condition_present then
            match_ctx.flow_after tc.merge_current_ownership_flow = match_ctx.flow_after
            if tc.path_continues then
                true = match_ctx.has_continuing_arm
            fi
            match_ctx.flow_before tc.restore_ownership_flow
            match_ctx.entry_continues = tc.path_continues
        fi
        match_ctx MatchContext::match_type = match_subject_type
        op pattern_covered_key = covered_key
        match_subject_type.match_base = arm_base

        # A prior arm has already opened (and left open) its scope frame iff the
        # match has seen a condition. Capture this before the block below sets it.
        match_ctx MatchContext::condition_present = arm_has_predecessor

        if op pattern_value_of PatternValue::EnumVariant(variant) is then
            if op pattern_is_wildcard ! then
                arm_base variant op tc diagnose_bare_enum_pattern
            fi
        fi
        if op pattern_value_of PatternValue::Literal(literal_pattern) is then
            match_subject_type literal_pattern op tc check_literal_pattern
        fi

        covered_key op match_ctx tc detect_duplicate_arm

        if match_ctx MatchContext::condition_present then
            op match_ctx tc unify_arm_stacks
        else
            true match_ctx MatchContext::set_condition_present
            tc.stack match_ctx MatchContext::before.restore
            tc.stack match_ctx MatchContext::after.restore
        fi

        # Each arm body gets its own scope frame: pattern bindings and any
        # block-local assignments live here, invisible to other arms and after
        # `end`. Close the previous arm's frame before opening this one.
        if arm_has_predecessor then
            op tc.attach_scope_cleanups
            tc.scope.exit
        fi
        tc.scope.enter

        # Record pattern bindings in the arm scope; implicit bindings cannot
        # shadow an accessible outer variable (same rule as is-bindings).
        for binding_var in op pattern_bindings.iter do
            op binding_var tc.record_implicit_binding
        done

        match_subject_type op function_opt tc register_pattern_bindings
        function_opt match_ctx.match_place match_ctx.match_origins match_subject_type op tc
        record_match_pattern_origins
        match_subject_type clone_type Option::Some op Op::set_type_hint
        for binding_var in op pattern_bindings.iter do
            if binding_var tc.scope.lookup Option::Some(binding_type) is then
                false function_opt binding_type binding_var op tc.record_owner_assignment
            fi
        done

        if op pattern_is_guarded then
            op pattern_guard_ops = guard_ops
            tc.store TypeChecker::new = guard_checker
            tc.diagnostics = guard_checker.diagnostics
            tc.scope.snapshot = guard_checker.scope
            tc.current_ownership_flow guard_checker.restore_ownership_flow
            Map[str u64]::new guard_ops count_variable_uses = guard_checker.remaining_uses
            function_opt guard_ops guard_checker.run_type_check_ops
            for name in guard_checker.moved_owners.iter do
                if name tc.moved_owners string_list_contains ! then
                    op.location f"Match guard cannot move owner `{name}`"
                    ErrorKind::InvalidVariable tc.diagnostics.record_error
                fi
            done
            guard_checker.stack.get_types = guard_stack
            false = guard_ok
            if 1 guard_stack.length == then
                if "bool" 0 guard_stack.get.format == then
                    true = guard_ok
                fi
            fi
            if guard_ok ! then
                op Op::location "Guard expression must leave a single `bool` on the stack" ErrorKind::TypeMismatch tc.diagnostics.record_error
            fi
        fi

        covered_key match_ctx MatchContext::set_current_branch_label
        op Op::location match_ctx MatchContext::set_current_branch_location
    fi
}
