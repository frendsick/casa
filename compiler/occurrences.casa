# Source occurrences retain query facts without executable operands or ownership effects.
import "std" as std
import "common" as common

pub struct Occurrence derives std::Clone {
    pub identity:   i64
    pub location:   common::Location
    pub value:      Value
    pub type_hint:  std::Option[common::Type]
    pub token_kind: std::Option[TokenKind]
    pub hover:      std::Option[std::String]
}

pub struct Shape derives std::Clone {
    pub name:     std::String
    pub location: common::Location
    pub hover:    std::String
}

pub struct Variant derives std::Clone {
    pub enum_name:    std::String
    pub variant_name: std::String
}

pub enum Value derives std::Clone {
    AssignDec (std::String)
    AssignInc (std::String)
    AssignVar (std::String)
    FnCall (std::String)
    FnPush (std::String)
    PushCapture (std::String)
    PushEnumVariant (Variant)
    PushVar (std::String)
    StructNew (Shape)
    Other
}

pub enum TokenKind derives std::Eq std::Copy {
    Function
    Variable
    String
    Number
    Keyword
    Operator
    Type
    EnumMember
    Struct
    Macro
}

pub fn from_operation operation:$common::Op -> Occurrence {
    operation.type_hint.clone = typ
    operation.value.format_hover = hover
    operation.value match
        common::OpValue::PushInt(literal) => {
            common::make_i64_type typ.unwrap_or = concrete
            concrete.format = type_name
            f"{literal.raw}: {type_name}" std::Option::Some = hover
            concrete std::Option::Some = typ
        }
        common::OpValue::PushFloat(literal) => {
            common::make_f64_type typ.unwrap_or = concrete
            concrete.format = type_name
            f"{literal}: {type_name}" std::Option::Some = hover
            concrete std::Option::Some = typ
        }
        common::OpValue::PushStr(literal) => {
            f"\"{literal}\": str" std::Option::Some = hover
            common::make_str_type std::Option::Some = typ
        }
        common::OpValue::PushBool(literal) => {
            if literal 0 != then "true: bool".to_str else "false: bool".to_str fi std::Option::Some = hover
            common::make_bool_type std::Option::Some = typ
        }
        common::OpValue::PushChar(literal) => {
            literal.to_str = value
            f"'{value}': char" std::Option::Some = hover
            common::make_char_type std::Option::Some = typ
        }
        _ => {
        }
    end
    operation.value match
        common::OpValue::AssignDec(name) => name.clone Value::AssignDec
        common::OpValue::AssignInc(name) => name.clone Value::AssignInc
        common::OpValue::AssignVar(name) => name.clone Value::AssignVar
        common::OpValue::FnCall(name) => name.clone Value::FnCall
        common::OpValue::FnPush(name) => name.clone Value::FnPush
        common::OpValue::PushCapture(name) => name.clone Value::PushCapture
        common::OpValue::PushEnumVariant(variant) => variant.variant_name.clone variant.enum_name.clone Variant Value::PushEnumVariant
        common::OpValue::PushVar(name) => name.clone Value::PushVar
        common::OpValue::StructNew(shape) => shape.format_hover shape.location.clone shape.name.clone Shape Value::StructNew
        _ => Value::Other
    end = value
    hover operation.value classify_source_token_kind typ value operation.location.clone operation.id Occurrence
}

fn classify_source_token_kind op_value:$common::OpValue -> std::Option[TokenKind] {
    op_value match
        common::OpValue::FnCall(_) => TokenKind::Function std::Option::Some
        common::OpValue::FnPush(_) => TokenKind::Function std::Option::Some
        common::OpValue::MethodCall(_) => TokenKind::Function std::Option::Some
        common::OpValue::TraitMethodCall(_) => TokenKind::Function std::Option::Some
        common::OpValue::TraitMethodRef(_) => TokenKind::Function std::Option::Some
        common::OpValue::PushVar(_) => TokenKind::Variable std::Option::Some
        common::OpValue::PushCapture(_) => TokenKind::Variable std::Option::Some
        common::OpValue::AssignVar(_) => TokenKind::Variable std::Option::Some
        common::OpValue::AssignInc(_) => TokenKind::Variable std::Option::Some
        common::OpValue::AssignDec(_) => TokenKind::Variable std::Option::Some
        common::OpValue::PushStr(_) => TokenKind::String std::Option::Some
        common::OpValue::PushInt(_) => TokenKind::Number std::Option::Some
        common::OpValue::PushFloat(_) => TokenKind::Number std::Option::Some
        common::OpValue::PushChar(_) => TokenKind::Number std::Option::Some
        common::OpValue::PushBool(_) => TokenKind::Keyword std::Option::Some
        common::OpValue::FnExec => TokenKind::Keyword std::Option::Some
        common::OpValue::FnExecOwned => TokenKind::Keyword std::Option::Some
        common::OpValue::IfStart => TokenKind::Keyword std::Option::Some
        common::OpValue::IfCondition => TokenKind::Keyword std::Option::Some
        common::OpValue::IfElif => TokenKind::Keyword std::Option::Some
        common::OpValue::IfElse => TokenKind::Keyword std::Option::Some
        common::OpValue::IfEnd => TokenKind::Keyword std::Option::Some
        common::OpValue::WhileStart => TokenKind::Keyword std::Option::Some
        common::OpValue::WhileCondition => TokenKind::Keyword std::Option::Some
        common::OpValue::WhileEnd => TokenKind::Keyword std::Option::Some
        common::OpValue::WhileBreak => TokenKind::Keyword std::Option::Some
        common::OpValue::WhileContinue => TokenKind::Keyword std::Option::Some
        common::OpValue::MatchStart => TokenKind::Keyword std::Option::Some
        common::OpValue::MatchArm(_) => TokenKind::Keyword std::Option::Some
        common::OpValue::MatchEnd => TokenKind::Keyword std::Option::Some
        common::OpValue::FnReturn => TokenKind::Keyword std::Option::Some
        common::OpValue::Question(_) => TokenKind::Operator std::Option::Some
        common::OpValue::UnsafeStart => TokenKind::Keyword std::Option::Some
        common::OpValue::Add => TokenKind::Operator std::Option::Some
        common::OpValue::Sub => TokenKind::Operator std::Option::Some
        common::OpValue::Mul => TokenKind::Operator std::Option::Some
        common::OpValue::Div => TokenKind::Operator std::Option::Some
        common::OpValue::Mod => TokenKind::Operator std::Option::Some
        common::OpValue::Shl => TokenKind::Operator std::Option::Some
        common::OpValue::Shr => TokenKind::Operator std::Option::Some
        common::OpValue::BitAnd => TokenKind::Operator std::Option::Some
        common::OpValue::BitOr => TokenKind::Operator std::Option::Some
        common::OpValue::BitXor => TokenKind::Operator std::Option::Some
        common::OpValue::BitNot => TokenKind::Operator std::Option::Some
        common::OpValue::And => TokenKind::Operator std::Option::Some
        common::OpValue::Or => TokenKind::Operator std::Option::Some
        common::OpValue::Not => TokenKind::Operator std::Option::Some
        common::OpValue::Eq => TokenKind::Operator std::Option::Some
        common::OpValue::Ne => TokenKind::Operator std::Option::Some
        common::OpValue::Lt => TokenKind::Operator std::Option::Some
        common::OpValue::Le => TokenKind::Operator std::Option::Some
        common::OpValue::Gt => TokenKind::Operator std::Option::Some
        common::OpValue::Ge => TokenKind::Operator std::Option::Some
        common::OpValue::PushEnumVariant(_) => TokenKind::EnumMember std::Option::Some
        common::OpValue::StructNew(_) => TokenKind::Struct std::Option::Some
        common::OpValue::Drop => TokenKind::Macro std::Option::Some
        common::OpValue::Dup => TokenKind::Macro std::Option::Some
        common::OpValue::Copy => TokenKind::Macro std::Option::Some
        common::OpValue::Swap => TokenKind::Macro std::Option::Some
        common::OpValue::Over => TokenKind::Macro std::Option::Some
        common::OpValue::Rot => TokenKind::Macro std::Option::Some
        common::OpValue::Print => TokenKind::Macro std::Option::Some
        common::OpValue::PrintInt => TokenKind::Macro std::Option::Some
        common::OpValue::PrintStr => TokenKind::Macro std::Option::Some
        common::OpValue::PrintString => TokenKind::Macro std::Option::Some
        common::OpValue::PrintBool => TokenKind::Macro std::Option::Some
        common::OpValue::PrintChar => TokenKind::Macro std::Option::Some
        common::OpValue::HeapAlloc => TokenKind::Macro std::Option::Some
        common::OpValue::HeapFree => TokenKind::Macro std::Option::Some
        common::OpValue::Load8 => TokenKind::Macro std::Option::Some
        common::OpValue::Load16 => TokenKind::Macro std::Option::Some
        common::OpValue::Load32 => TokenKind::Macro std::Option::Some
        common::OpValue::Load64 => TokenKind::Macro std::Option::Some
        common::OpValue::PtrAsRef(_) => TokenKind::Macro std::Option::Some
        common::OpValue::PtrAsMut(_) => TokenKind::Macro std::Option::Some
        common::OpValue::PtrFromRaw(_) => TokenKind::Macro std::Option::Some
        common::OpValue::PtrFromRef => TokenKind::Macro std::Option::Some
        common::OpValue::PtrIntoRaw => TokenKind::Macro std::Option::Some
        common::OpValue::PtrNull => TokenKind::Macro std::Option::Some
        common::OpValue::PtrRead(_) => TokenKind::Macro std::Option::Some
        common::OpValue::Store8 => TokenKind::Macro std::Option::Some
        common::OpValue::Store16 => TokenKind::Macro std::Option::Some
        common::OpValue::Store32 => TokenKind::Macro std::Option::Some
        common::OpValue::Store64 => TokenKind::Macro std::Option::Some
        common::OpValue::PtrWrite(_) => TokenKind::Macro std::Option::Some
        common::OpValue::Syscall0 => TokenKind::Macro std::Option::Some
        common::OpValue::Syscall1 => TokenKind::Macro std::Option::Some
        common::OpValue::Syscall2 => TokenKind::Macro std::Option::Some
        common::OpValue::Syscall3 => TokenKind::Macro std::Option::Some
        common::OpValue::Syscall4 => TokenKind::Macro std::Option::Some
        common::OpValue::Syscall5 => TokenKind::Macro std::Option::Some
        common::OpValue::Syscall6 => TokenKind::Macro std::Option::Some
        common::OpValue::Typeof => TokenKind::Macro std::Option::Some
        common::OpValue::SizeOf(_) => TokenKind::Macro std::Option::Some
        _ => std::Option[TokenKind]::None
    end
}

impl common::OpValue {
    pub fn format_hover self:$common::OpValue -> std::Option[std::String] {
        self match
            common::OpValue::Add => "+: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::Sub => "-: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::Mul => "*: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::Div => "/: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::Mod => "%: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::Shl => "<<: T u64 -> T (integer T)".to_str std::Option::Some
            common::OpValue::Shr => ">>: T u64 -> T (integer T)".to_str std::Option::Some
            common::OpValue::BitAnd => "&: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::BitOr => "|: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::BitXor => "^: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::BitNot => "~: T -> T (integer T)".to_str std::Option::Some
            common::OpValue::Not => "!: bool -> bool".to_str std::Option::Some
            common::OpValue::Eq => "==: [T: PartialEq] T T -> bool".to_str std::Option::Some
            common::OpValue::Ne => "!=: [T: PartialEq] T T -> bool".to_str std::Option::Some
            common::OpValue::Lt => "<: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            common::OpValue::Le => "<=: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            common::OpValue::Gt => ">: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            common::OpValue::Ge => ">=: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            common::OpValue::And => "&&: bool bool -> bool".to_str std::Option::Some
            common::OpValue::Or => "||: bool bool -> bool".to_str std::Option::Some
            common::OpValue::Drop => "drop: T -> None".to_str std::Option::Some
            common::OpValue::Dup => "dup: [T: Copy] T -> T T".to_str std::Option::Some
            common::OpValue::Copy => "copy: [T: Copy] T -> T".to_str std::Option::Some
            common::OpValue::Swap => "swap: T1 T2 -> T2 T1".to_str std::Option::Some
            common::OpValue::Over => "over: [T2: Copy] T1 T2 -> T2 T1 T2".to_str std::Option::Some
            common::OpValue::Rot => "rot: T1 T2 T3 -> T3 T1 T2".to_str std::Option::Some
            common::OpValue::Print => "print: [T: Display] T -> None".to_str std::Option::Some
            common::OpValue::PrintInt => "print: [T: Display] T -> None".to_str std::Option::Some
            common::OpValue::PrintStr => "print: [T: Display] T -> None".to_str std::Option::Some
            common::OpValue::PrintBool => "print: [T: Display] T -> None".to_str std::Option::Some
            common::OpValue::PrintChar => "print: [T: Display] T -> None".to_str std::Option::Some
            common::OpValue::FnExec => "exec: fn[...] -> ...".to_str std::Option::Some
            common::OpValue::FnExecOwned => "exec: fn[...] -> ...".to_str std::Option::Some
            common::OpValue::Typeof => "typeof: T -> str".to_str std::Option::Some
            common::OpValue::SizeOf(_) => "size_of[T]: None -> u64".to_str std::Option::Some
            common::OpValue::AssignDec(_) => "-=: T -> None (integer T)".to_str std::Option::Some
            common::OpValue::AssignInc(_) => "+=: T -> None (integer T)".to_str std::Option::Some
            common::OpValue::HeapAlloc => "alloc: u64 -> ptr".to_str std::Option::Some
            common::OpValue::HeapFree => "free: ptr -> None".to_str std::Option::Some
            common::OpValue::Load8 => "load8: ptr -> u8".to_str std::Option::Some
            common::OpValue::Load16 => "load16: ptr -> u16".to_str std::Option::Some
            common::OpValue::Load32 => "load32: ptr -> u32".to_str std::Option::Some
            common::OpValue::Load64 => "load64: ptr -> u64".to_str std::Option::Some
            common::OpValue::PtrAsRef(target) => f"ptr::as_ref[{target.format}]: ptr -> ${target.format}" std::Option::Some
            common::OpValue::PtrAsMut(target) => f"ptr::as_mut[{target.format}]: ptr -> mut${target.format}" std::Option::Some
            common::OpValue::PtrFromRaw(target) => f"ptr::from_raw[{target.format}]: ptr -> {target.format}" std::Option::Some
            common::OpValue::PtrFromRef => "ptr::from_ref: $T -> ptr".to_str std::Option::Some
            common::OpValue::PtrIntoRaw => "ptr::into_raw: T -> ptr".to_str std::Option::Some
            common::OpValue::PtrNull => "ptr::null: None -> ptr".to_str std::Option::Some
            common::OpValue::PtrRead(target) => f"ptr::read[{target.format}]: ptr -> {target.format}" std::Option::Some
            common::OpValue::Store8 => "store8: u8 ptr -> None".to_str std::Option::Some
            common::OpValue::Store16 => "store16: u16 ptr -> None".to_str std::Option::Some
            common::OpValue::Store32 => "store32: u32 ptr -> None".to_str std::Option::Some
            common::OpValue::Store64 => "store64: u64 ptr -> None".to_str std::Option::Some
            common::OpValue::PtrWrite(target) => f"ptr::write[{target.format}]: ptr {target.format} -> None" std::Option::Some
            common::OpValue::Syscall0 => "syscall0: i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall1 => "syscall1[A1: Word]: A1 i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall2 => "syscall2[A1: Word A2: Word]: A1 A2 i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall3 => "syscall3[A1: Word A2: Word A3: Word]: A1 A2 A3 i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall4 => "syscall4[A1: Word A2: Word A3: Word A4: Word]: A1 A2 A3 A4 i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall5 => "syscall5[A1: Word A2: Word A3: Word A4: Word A5: Word]: A1 A2 A3 A4 A5 i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall6 => "syscall6[A1: Word A2: Word A3: Word A4: Word A5: Word A6: Word]: A1 A2 A3 A4 A5 A6 i64 -> i64".to_str std::Option::Some
            common::OpValue::Argc => "argc: None -> i64".to_str std::Option::Some
            common::OpValue::Argv => "argv: None -> ptr".to_str std::Option::Some
            _ => std::Option[std::String]::None
        end
    }
}

impl common::CasaStruct {
    pub fn format_hover self:$common::CasaStruct -> std::String {
        std::String::new = builder
        if self.is_extern then
            "extern " builder.append
        fi
        "struct " builder.append
        self.name.as_str builder.append
        " { " builder.append
        std::List[std::String]::new = members
        for member in self.members.iter do
            f"{member.name}: {member.typ.format}" members.push
        done
        ", " members.join_strings.as_str builder.append
        " }" builder.append
        builder
    }
}

pub fn collect operations:$std::List[common::Op] -> std::List[Occurrence] {
    std::List[Occurrence]::new = facts
    operations facts append_operations
    facts
}

fn append_operations facts:mut$std::List[Occurrence] operations:$std::List[common::Op] {
    for operation in operations.iter do
        operation.value match
            common::OpValue::ExprGroup(items) => items facts append_operations
            common::OpValue::PushArray(items) => items facts append_operations
            common::OpValue::MatchArm(arm) => arm.guard_ops facts append_operations
            common::OpValue::Unreachable(items) => {
                items facts append_operations
                continue
            }
            _ => {
            }
        end
        operation from_operation facts.push
    done
}

impl Occurrence {
    pub fn has_rejected_target self:$Occurrence rejected:$std::Set[std::String] -> bool {
        self.value match
            Value::FnCall(name) => name rejected.has
            Value::FnPush(name) => name rejected.has
            _ => false
        end
    }
}
