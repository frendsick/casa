# Error reporting for the Casa compiler.
#
# Provides Rust-style diagnostics with source context and multi-error collection.
import "std"
import "common"

# ============================================================================
# CasaError struct
# ============================================================================

struct CasaNote {
    message:  str
    location: Location
}

struct CasaError {
    kind:      ErrorKind
    message:   str
    location:  Location
    expected:  Option[str]
    got:       Option[str]
    got_label: str
    notes:     List[CasaNote]
}

impl CasaError {
    fn new kind:ErrorKind message:str location:Location -> CasaError {
        List[CasaNote]::new "Got" Option::None Option::None location message kind CasaError
    }

    fn with_expected
        kind:ErrorKind
        message:str
        location:Location
        expected:str
        got:str
    -> CasaError {
        List[CasaNote]::new "Got" got Option::Some expected Option::Some location message kind CasaError
    }
}

# ============================================================================
# CasaWarning struct
# ============================================================================

struct CasaWarning {
    kind:     WarningKind
    message:  str
    location: Location
}

enum Diagnostic {
    Error (CasaError)
    Warning (CasaWarning)
}

impl Diagnostic {
    fn get_location self:$Diagnostic -> Location {
        self match
            Diagnostic::Error(error) => error.location.clone
            Diagnostic::Warning(warning) => warning.location.clone
        end
    }
}

struct Diagnostics {
    entries: List[Diagnostic]
}

impl Diagnostics {
    fn new -> Diagnostics {
        List[Diagnostic]::new Diagnostics
    }

    fn push_error self:mut$Diagnostics error:CasaError {
        error Diagnostic::Error self.entries.push
    }

    fn push_warning self:mut$Diagnostics warning:CasaWarning {
        warning Diagnostic::Warning self.entries.push
    }

    fn record_error self:mut$Diagnostics kind:ErrorKind message:str location:$Location {
        location Location::Clone::clone message kind CasaError::new self.push_error
    }

    fn record_error_expected
        self:mut$Diagnostics
        kind:ErrorKind
        message:str
        location:$Location
        expected:str
        got:str
    {
        got expected location Location::Clone::clone message kind CasaError::with_expected self.push_error
    }

    fn record_error_at_encounter
        self:mut$Diagnostics
        kind:ErrorKind
        message:str
        location:$Location
    {
        Diagnostics::new = incoming
        location message kind incoming.record_error
        location incoming self.merge_at_encounter
    }

    fn merge self:mut$Diagnostics other:Diagnostics {
        for diagnostic in other.entries.iter do
            diagnostic self.entries.push
        done
    }

    fn merge_at_encounter self:mut$Diagnostics other:Diagnostics location:$Location {
        List[Diagnostic]::new = merged
        List[Diagnostic]::new = later
        for diagnostic in self.entries.iter do
            diagnostic.get_location = diagnostic_location
            if
            location.file diagnostic_location.file ==
            diagnostic_location.span.offset location.span.offset < &&
            then
                diagnostic later.push
            else
                diagnostic merged.push
            fi
        done
        for diagnostic in other.entries.iter do diagnostic merged.push done
        for diagnostic in later.iter do diagnostic merged.push done
        merged = self.entries
    }

    fn has_errors self:$Diagnostics -> bool {
        for diagnostic in self.entries.iter do
            if diagnostic Diagnostic::Error(_) is then true return fi
        done
        false
    }

    fn error_count self:$Diagnostics -> u64 {
        0 (u64) = count
        for diagnostic in self.entries.iter do
            if diagnostic Diagnostic::Error(_) is then 1 += count fi
        done
        count
    }
}

# ============================================================================
# Error formatting
# ============================================================================

fn error_kind_name kind:ErrorKind -> str {
    kind match
        ErrorKind::Syntax => "SYNTAX"
        ErrorKind::UnexpectedToken => "UNEXPECTED_TOKEN"
        ErrorKind::UndefinedName => "UNDEFINED_NAME"
        ErrorKind::DuplicateName => "DUPLICATE_NAME"
        ErrorKind::InvalidScope => "INVALID_SCOPE"
        ErrorKind::TypeMismatch => "TYPE_MISMATCH"
        ErrorKind::StackMismatch => "STACK_MISMATCH"
        ErrorKind::StackUnderflow => "STACK_UNDERFLOW"
        ErrorKind::SignatureMismatch => "SIGNATURE_MISMATCH"
        ErrorKind::InvalidVariable => "INVALID_VARIABLE"
        ErrorKind::UnmatchedBlock => "UNMATCHED_BLOCK"
        ErrorKind::MissingTraitMethod => "MISSING_TRAIT_METHOD"
        ErrorKind::TraitSignatureMismatch => "TRAIT_SIGNATURE_MISMATCH"
        ErrorKind::UndefinedGlobal => "UNDEFINED_GLOBAL"
    end
}

fn format_source_context file:str source_line:str position:SourcePosition span_length:u64 -> str {
    if 0 span_length == then
        1 (u64) = span_length
    fi
    position.line = line
    position.column = column

    line.to_str.length = width
    StringBuilder::new = builder

    # Arrow line: "  --> file:line:col"
    "  --> " builder.append
    file builder.append
    ":" builder.append
    line.to_str builder.append
    ":" builder.append
    column.to_str builder.append
    "\n" builder.append

    # Padding + pipe
    0 (u64) = index
    while index width > do
        " " builder.append
        1 += index
    done
    " |\n" builder.append

    # Line number + source
    line.to_str builder.append
    " | " builder.append
    source_line builder.append
    "\n" builder.append

    # Padding + carets
    0 (u64) = index
    while index width > do
        " " builder.append
        1 += index
    done
    " | " builder.append
    0 (u64) = index
    while index column 1 - > do
        " " builder.append
        1 += index
    done
    0 (u64) = index
    while index span_length > do
        "^" builder.append
        1 += index
    done

    builder.build
}
