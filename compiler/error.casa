# Error reporting for the Casa compiler.
#
# Provides Rust-style diagnostics with source context and multi-error collection.
import "std" as std
import "common" as common

# ============================================================================
# CasaError struct
# ============================================================================

pub struct CasaNote derives std::Clone {
    pub message:  std::String
    pub location: common::Location
}

pub struct CasaError derives std::Clone {
    pub kind:      common::ErrorKind
    pub message:   std::String
    pub location:  common::Location
    pub expected:  std::Option[std::String]
    pub got:       std::Option[std::String]
    pub got_label: std::String
    pub notes:     std::List[CasaNote]
}

impl CasaError {
    pub fn new kind:common::ErrorKind message:std::String location:common::Location -> CasaError {
        std::List[CasaNote]::new "Got".to_str std::Option::None std::Option::None location message kind CasaError
    }

    pub fn with_expected
        kind:common::ErrorKind
        message:std::String
        location:common::Location
        expected:std::String
        got:std::String
    -> CasaError {
        std::List[CasaNote]::new "Got".to_str got std::Option::Some expected std::Option::Some location message kind CasaError
    }
}

# ============================================================================
# CasaWarning struct
# ============================================================================

pub struct CasaWarning derives std::Clone {
    pub kind:     common::WarningKind
    pub message:  std::String
    pub location: common::Location
}

pub enum Diagnostic derives std::Clone {
    Error (CasaError)
    Warning (CasaWarning)
}

impl Diagnostic {
    pub fn get_location self:$Diagnostic -> common::Location {
        self match
            Diagnostic::Error(error) => error.location.clone
            Diagnostic::Warning(warning) => warning.location.clone
        end
    }
}

pub struct Diagnostics derives std::Clone {
    pub entries: std::List[Diagnostic]
}

impl Diagnostics {
    pub fn new -> Diagnostics { std::List[Diagnostic]::new Diagnostics }

    pub fn push_error self:mut$Diagnostics error:CasaError {
        error Diagnostic::Error self.entries.push
    }

    pub fn push_warning self:mut$Diagnostics warning:CasaWarning {
        warning Diagnostic::Warning self.entries.push
    }

    pub fn record_error
        self:mut$Diagnostics
        kind:common::ErrorKind
        message:$str
        location:$common::Location
    {
        location.clone message std::String::from_str kind CasaError::new self.push_error
    }

    pub fn record_error_string
        self:mut$Diagnostics
        kind:common::ErrorKind
        message:std::String
        location:$common::Location
    {
        location.clone message kind CasaError::new self.push_error
    }

    pub fn record_error_expected
        self:mut$Diagnostics
        kind:common::ErrorKind
        message:$str
        location:$common::Location
        expected:$str
        got:$str
    {
        got std::String::from_str expected std::String::from_str location.clone message std::String::from_str kind
        CasaError::with_expected self.push_error
    }

    pub fn record_error_expected_strings
        self:mut$Diagnostics
        kind:common::ErrorKind
        message:std::String
        location:$common::Location
        expected:std::String
        got:std::String
    {
        got expected location.clone message kind CasaError::with_expected self.push_error
    }

    pub fn record_error_at_encounter
        self:mut$Diagnostics
        kind:common::ErrorKind
        message:$str
        location:$common::Location
    {
        Diagnostics::new = incoming
        location message kind incoming.record_error
        location incoming self.merge_at_encounter
    }

    pub fn record_error_at_encounter_string
        self:mut$Diagnostics
        kind:common::ErrorKind
        message:std::String
        location:$common::Location
    {
        Diagnostics::new = incoming
        location message kind incoming.record_error_string
        location incoming self.merge_at_encounter
    }

    pub fn merge self:mut$Diagnostics other:Diagnostics {
        other.entries.reverse
        while other.entries.is_empty ! do
            other.entries.pop self.entries.push
        done
    }

    pub fn merge_at_encounter self:mut$Diagnostics other:Diagnostics location:$common::Location {
        std::List[Diagnostic]::new = merged
        std::List[Diagnostic]::new = later
        self.entries.reverse
        while self.entries.is_empty ! do
            self.entries.pop = diagnostic
            diagnostic.get_location = diagnostic_location
            if
                location.file diagnostic_location.file ==
                diagnostic_location.span.offset location.span.offset < &&
            then
                diagnostic later.push
            else
                diagnostic merged.push
            fi
        done
        merged.reverse
        later.reverse
        other.entries.reverse
        while other.entries.is_empty ! do
            other.entries.pop merged.push
        done
        later merged.append
        merged = self.entries
    }

    pub fn has_errors self:$Diagnostics -> bool {
        for diagnostic in self.entries.iter do
            if diagnostic Diagnostic::Error(_) is then
                true return
            fi
        done
        false
    }

    pub fn error_count self:$Diagnostics -> u64 {
        0 = count: u64
        for diagnostic in self.entries.iter do
            if diagnostic Diagnostic::Error(_) is then
                1 += count
            fi
        done
        count
    }
}

# ============================================================================
# Error formatting
# ============================================================================

pub fn error_kind_name kind:common::ErrorKind -> str {
    kind match
        common::ErrorKind::Syntax => "SYNTAX"
        common::ErrorKind::UnexpectedToken => "UNEXPECTED_TOKEN"
        common::ErrorKind::UndefinedName => "UNDEFINED_NAME"
        common::ErrorKind::DuplicateName => "DUPLICATE_NAME"
        common::ErrorKind::InvalidScope => "INVALID_SCOPE"
        common::ErrorKind::TypeMismatch => "TYPE_MISMATCH"
        common::ErrorKind::StackMismatch => "STACK_MISMATCH"
        common::ErrorKind::StackUnderflow => "STACK_UNDERFLOW"
        common::ErrorKind::SignatureMismatch => "SIGNATURE_MISMATCH"
        common::ErrorKind::InvalidVariable => "INVALID_VARIABLE"
        common::ErrorKind::UnmatchedBlock => "UNMATCHED_BLOCK"
        common::ErrorKind::MissingTraitMethod => "MISSING_TRAIT_METHOD"
        common::ErrorKind::TraitSignatureMismatch => "TRAIT_SIGNATURE_MISMATCH"
    end
}

pub fn format_source_context
    file:$str
    source_line:$str
    position:common::SourcePosition
    span_length:u64
-> std::String {
    if 0 span_length == then
        1 = span_length: u64
    fi
    position.line = line
    position.column = column

    line.to_str.length = width
    std::String::new = builder

    # Arrow line: "  --> file:line:col"
    "  --> " builder.append
    file builder.append
    ":" builder.append
    line.to_str builder.append_string
    ":" builder.append
    column.to_str builder.append_string
    "\n" builder.append

    # Padding + pipe
    0 = index: u64
    while index width > do
        " " builder.append
        1 += index
    done
    " |\n" builder.append

    # Line number + source
    line.to_str builder.append_string
    " | " builder.append
    source_line builder.append
    "\n" builder.append

    # Padding + carets
    0 = index: u64
    while index width > do
        " " builder.append
        1 += index
    done
    " | " builder.append
    0 = index: u64
    while index column 1 - > do
        " " builder.append
        1 += index
    done
    0 = index: u64
    while index span_length > do
        "^" builder.append
        1 += index
    done

    builder
}
