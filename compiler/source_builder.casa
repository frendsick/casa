# Resolve a bare identifier after `&`-ref, enum-variant, and trait-method
# attempts have already failed. Rewrites `op` in place to the matching op
# kind or pushes an `UndefinedName` error.
pub fn resolve_plain_identifier
    store:mut$common::SymbolStore
    function:mut$common::Function
    op:mut$common::Op
    ident:$str
    allow_root_local_capture:bool
    resolve_errors:mut$std::List[error::CasaError]
{
    ident "::" str::split.unwrap = identifier_parts
    if
        2 identifier_parts.length == "drop" identifier_parts.length 1 - identifier_parts.get.as_str == &&
    then
        op.location.clone "Reserved `drop` methods cannot be called directly; use the `drop` intrinsic".to_str common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
        return
    fi
    if ident function.variables common::variable_list_contains then
        ident.to_str common::OpValue::PushVar op common::Op::set_value
        return
    fi

    if ident store.has_function then
        ident.to_str common::OpValue::FnCall op common::Op::set_value
        return
    fi

    if ident function.captures common::variable_list_contains then
        ident.to_str common::OpValue::PushCapture op common::Op::set_value
        return
    fi

    if
        resolve_errors allow_root_local_capture op.location store function ident
        reject_root_local_capture
    then
        return
    fi

    if
        ident store
            .variables
            .get_str
            .is_some
    then
        ident.to_str common::OpValue::PushVar op common::Op::set_value
        return
    fi

    ident store.constants.get_str = const_opt
    if const_opt std::Option::Some(casa_const) is then
        casa_const op.resolve_constant
        return
    fi

    ident store.structs.get_str = struct_opt
    if struct_opt std::Option::Some(casa_struct) is then
        for member in casa_struct.members.iter do
            f"{casa_struct.name}::{member.name}" = accessor_name
            if
                op
                    .location
                    .file
                    .as_str accessor_name.as_str store.is_private_from
            then
                op.location.clone
                "Cannot construct a struct with private fields outside its module".to_str
                common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                common::OpValue::Rejected op common::Op::set_value
                return
            fi
        done
        casa_struct.clone common::OpValue::StructNew op common::Op::set_value
        return
    fi

    ident store.enums.get_str = resolved_enum_opt
    if resolved_enum_opt std::Option::Some(resolved_enum) is then
        resolved_enum.variants.length i64::try_from.unwrap
        common::make_integer_op_value op common::Op::set_value
        return
    fi

    op
        .location
        .file
        .as_str ident store.format_name_for_source = source_name
    if op.value common::OpValue::Identifier(written) is then
        f"Identifier `{written}` is not defined"
    else
        f"Identifier `{source_name}` is not defined"
    fi = message
    if ident store.failed_constants.has_str then
        f"Constant `{source_name}` is unavailable because its declaration failed" = message
    fi
    if op.value common::OpValue::Identifier(written) is then
        if
            op
                .location
                .file
                .as_str written.as_str store.find_imported_namespace_replacement std::Option::Some(replacement) is
        then
            f"{message}. Use `{replacement}`" = message
        fi
    fi
    op.location.clone message common::ErrorKind::UndefinedName error::CasaError::new resolve_errors.push
}

impl Parser {
    fn check_qualified_access
        self:mut$Parser
        token:$common::Token
        names:$std::Map[std::String common::SourceBinding]
    {
        if names token.value.as_str common::resolve_source_name std::Option::Some(resolved) is then
            resolved = name
            if name.as_str "mut$" str::starts_with then
                name.as_str 4 name.length 4 - str::substring = name
            elif name.as_str "$" str::starts_with name.as_str "&" str::starts_with || then
                name.as_str 1 name.length 1 - str::substring = name
            fi
            token
                .location
                .file
                .as_str name.as_str self.store.is_private_from = private
            if name.as_str "::" str::find std::Option::Some(separator) is then
                name.as_str 0 separator str::substring = receiver
                token
                    .location
                    .file
                    .as_str receiver.as_str self.store.is_private_from private || = private
            fi
            if private then
                token.location f"Declaration `{token.value}` is private" common::ErrorKind::InvalidScope
                self.state.record_error_string
            fi
        fi
    }

    fn bind_declaration
        self:mut$Parser
        declaration:$grammar::DeclarationSyntax
        module_prefix:$str
        names:mut$std::Map[std::String common::SourceBinding]
    {
        declaration.name.as_str module_prefix namespace_name = identity
        self.state.diagnostics declaration.location false identity common::SourceBinding declaration.name.clone
        names set_module_source_name
    }

    fn bind_impl_namespace
        self:mut$Parser
        token:$common::Token
        module_prefix:$str
        names:mut$std::Map[std::String common::SourceBinding]
    {
        token.value.as_str = name
        if
            name "::" str::contains name self
                .store
                .builtins
                .has_str ||
        then
            return
        fi
        if name names.get_str std::Option::Some(existing) is then
            if existing.is_module then
                token.location f"Namespace `{name}` conflicts with an import alias" common::ErrorKind::DuplicateName self.state.record_error_string
            fi
            return
        fi
        name module_prefix namespace_name = identity
        self.state.diagnostics token.location false identity common::SourceBinding token.value.clone
        names set_module_source_name
    }

    fn discover_import
        self:mut$Parser
        imported:$grammar::ImportSyntax
        file:$str
        names:mut$std::Map[std::String common::SourceBinding]
    {
        if imported.alias std::Option::Some(written) is then
            written.clone
        elif imported.specifier.as_str is_path_specifier then
            imported.location "Path-style imports require an `as` alias" common::ErrorKind::Syntax
            self.state.record_error
            self.state.mark_output_unusable return
        else
            imported.specifier.clone
        fi = alias
        imported.location imported.specifier.as_str file self resolve_import = path
        if self.state.has_usable_output ! then
            return
        fi
        path.as_str self.canonical_module_prefix = identity
        self.state.diagnostics imported.location true identity.clone common::SourceBinding alias
        names set_module_source_name
        if
            self
                .state
                .diagnostics
                .has_errors
        then
            self.state.mark_output_unusable return
        fi
        imported.location identity.as_str path.as_str self.import_module
    }

    # Keep root semantic keys disjoint when a root spelling resembles a loaded module key.
    fn reserve_root_names
        self:$Parser
        names:mut$std::Map[std::String common::SourceBinding]
        declarations:$std::List[grammar::DeclarationSyntax]
    {
        0 = index: u64
        std::String::new = root_prefix
        while true do
            f"__casa_root_{index}__" = root_prefix
            false = occupied
            for binding in names.iter do
                if binding.first.as_str root_prefix.as_str str::starts_with then
                    true = occupied
                    break
                fi
            done
            if occupied ! then
                break
            fi
            1 += index
        done
        for declaration in declarations.iter do
            for module in self.source_prefixes.iter do
                if declaration.name.as_str module.second.as_str str::starts_with then
                    false f"{root_prefix}{declaration.name}" common::SourceBinding declaration.name.clone names.set
                    break
                fi
            done
        done
    }

    # Syntax ranges include nested declarations and implementation blocks.
    fn reject_declaration_ranges
        self:mut$Parser
        regions:$std::List[grammar::SyntaxSpan]
        tokens:$std::List[common::Token]
    {
        if
            self
                .current_module
                .rejected_references
                .is_empty
        then
            return
        fi
        for region in regions.iter do
            if region.kind grammar::SyntaxSpanKind::Declaration != then
                continue
            fi
            false = rejected
            for
                reference in self
                    .current_module
                    .rejected_references
                    .iter
            do
                reference.second copy tokens
                    .get
                    .location
                    .span
                    .offset = offset
                if region.start offset <= region.close offset >= && then
                    true = rejected
                    break
                fi
            done
            if rejected then
                region.close region.start.to_str self
                    .current_module_mut
                    .rejected_declarations
                    .set
            fi
        done
    }

    # Return the complete root terms after module declarations are established.
    fn prepare_module
        self:mut$Parser
        tokens:$std::List[common::Token]
        module_prefix:$str
    -> std::List[grammar::TermSyntax] {
        false module_prefix tokens self.prepare_module_with
    }

    # Analyze the module's imports without declaring the module itself.
    fn prepare_imports self:mut$Parser tokens:$std::List[common::Token] module_prefix:$str {
        true module_prefix tokens self.prepare_module_with drop
    }

    fn prepare_module_with
        self:mut$Parser
        tokens:$std::List[common::Token]
        module_prefix:$str
        imports_only:bool
    -> std::List[grammar::TermSyntax] {
        if tokens.is_empty then
            self.state.mark_output_unusable
            std::List[grammar::TermSyntax]::new return
        fi
        0 self.state.diagnostics take_diagnostics_since = lexical_diagnostics
        std::Option[u64]::None = lexical_limit
        for diagnostic in lexical_diagnostics.entries.iter do
            if diagnostic error::Diagnostic::Error(lexical_error) is then
                lexical_error
                    .location
                    .span
                    .offset copy = offset
                offset lexical_limit.unwrap_or = earlier
                if earlier offset > then offset else earlier fi std::Option::Some = lexical_limit
            fi
        done
        0 tokens
            .get
            .location
            .file
            .clone = file
        if file.as_str self.sources.get std::Option::Some(source) is then
            lexical_limit source.as_str tokens grammar::parse_module
        else
            lexical_limit "" tokens grammar::parse_module
        fi = parsed
        if parsed.diagnostics.has_errors lexical_diagnostics.has_errors || then
            if 0 parsed.complete_until == then
                lexical_diagnostics.clone self
                    .state
                    .diagnostics
                    .merge
                parsed.diagnostics.clone self
                    .state
                    .diagnostics
                    .merge
                self.state.mark_output_unusable
                std::List[grammar::TermSyntax]::new return
            fi
            # Only complete top-level constructs can contribute partial editor facts.
            while parsed.imports.is_empty ! do
                parsed.imports.length 1 - parsed
                    .imports
                    .get
                    .first_token copy = import_start
                if parsed.complete_until import_start > then
                    break
                fi
                parsed.imports.pop drop
            done
            while parsed.declarations.is_empty ! do
                parsed.declarations.length 1 - parsed
                    .declarations
                    .get
                    .first_token copy = declaration_start
                if parsed.complete_until declaration_start > then
                    break
                fi
                parsed.declarations.pop drop
            done
            while parsed.references.is_empty ! do
                parsed.references.length 1 - parsed.references.get copy = position
                if parsed.complete_until position > then
                    break
                fi
                parsed.references.pop drop
            done
        fi
        std::Map[std::String common::SourceBinding]::new = names
        0 = declaration_index: u64
        error::Diagnostics::new = diagnostics
        true = imports_usable
        for imported in parsed.imports.iter do
            while declaration_index parsed.declarations.length < do
                declaration_index parsed.declarations.get = declaration
                if
                    imported
                        .location
                        .span
                        .offset declaration
                        .location
                        .span
                        .offset <=
                then
                    break
                fi
                names module_prefix declaration self.bind_declaration
                1 += declaration_index
            done
            0 self.state.diagnostics take_diagnostics_since diagnostics.merge
            true = self.state.output_usable
            false = self.state.recovery_required
            false = self.state.store_mutated
            names file.as_str imported self.discover_import
            self.state.has_usable_output imports_usable && = imports_usable
            0 self.state.diagnostics take_diagnostics_since diagnostics.merge
        done
        if imports_only then
            std::List[grammar::TermSyntax]::new return
        fi
        if imports_usable ! then
            # Failed imports do not invalidate independent declarations in this module.
            true = self.state.output_usable
            false = self.state.recovery_required
        fi
        while declaration_index parsed.declarations.length < do
            names module_prefix declaration_index parsed.declarations.get self.bind_declaration
            1 += declaration_index
        done
        for position in parsed.impl_receivers.iter do
            if position copy parsed.complete_until < then
                names module_prefix position copy tokens.get self.bind_impl_namespace
            fi
        done
        if self.state.has_usable_output ! then
            lexical_diagnostics.clone self
                .state
                .diagnostics
                .merge
            parsed.diagnostics.clone self
                .state
                .diagnostics
                .merge
            self.state.mark_output_unusable
            std::List[grammar::TermSyntax]::new return
        fi
        if 0 module_prefix.length == then
            parsed.declarations names self.reserve_root_names
        fi
        for position in parsed.references.iter do
            self
                .state
                .diagnostics
                .error_count = errors_before_access
            names position copy tokens.get self.check_qualified_access
            if
                errors_before_access self
                    .state
                    .diagnostics
                    .error_count <
            then
                position copy position copy tokens
                    .get
                    .location
                    .span
                    .offset
                    .to_str self
                    .current_module_mut
                    .rejected_references
                    .set
            fi
        done
        tokens parsed.spans self.reject_declaration_ranges
        0 self.state.diagnostics take_diagnostics_since diagnostics.merge
        diagnostics self
            .state
            .diagnostics
            .merge
        file.as_str names self.store.record_source_names
        names.clone = self.current_module_mut.names
        # Source spellings classify local declarations before their headers exist.
        for declaration in parsed.declarations.iter do
            if "const" declaration.kind.as_str != then
                declaration.name.clone self
                    .current_module_mut
                    .nonconstant_names
                    .add
            fi
        done
        tokens NameResolver::new = constant_resolver
        self.source_prefixes constant_resolver.copy_module_prefixes
        0 = import_index: u64
        for declaration in parsed.declarations.iter do
            while import_index parsed.imports.length < do
                import_index parsed.imports.get = preceding_import
                if
                    declaration
                        .location
                        .span
                        .offset preceding_import
                        .location
                        .span
                        .offset <=
                then
                    break
                fi
                std::String::new = import_name
                if preceding_import.alias std::Option::Some(alias) is then
                    alias.clone = import_name
                else
                    preceding_import.specifier.clone = import_name
                fi
                if import_name.as_str names.get_str std::Option::Some(binding) is then
                    binding.clone import_name.clone constant_resolver.names.set
                fi
                1 += import_index
            done
            if declaration.name.as_str names.get_str std::Option::Some(binding) is then
                binding.clone declaration.name.clone constant_resolver.names.set
            fi
            if "const" declaration.kind.as_str != then
                continue
            fi
            declaration.first_token.to_str self
                .current_module_mut
                .constructed_headers
                .add
            self
                .state
                .diagnostics
                .error_count = errors_before_constant
            if
                declaration.first_token tokens
                    .get
                    .location
                    .span
                    .offset
                    .to_str
                    .as_str self
                    .current_module
                    .rejected_declarations
                    .has_str !
            then
                if declaration.constant std::Option::Some(initializer) is then
                    initializer declaration constant_resolver self.evaluate_constant_declaration
                fi
            fi
            self
                .state
                .diagnostics
                .error_count errors_before_constant - self.state.constant_errors + = self.state.constant_errors
            declaration.name.as_str constant_resolver.resolve_name = constant_name
            if
                constant_name.as_str self
                    .store
                    .constants
                    .has_str !
            then
                constant_name.as_str self.register_private_declaration
                constant_name.clone self
                    .store
                    .failed_constants
                    .add
            fi
        done
        tokens parsed.declarations self.collect_headers
        lexical_diagnostics.clone self
            .state
            .diagnostics
            .merge
        parsed.diagnostics.clone self
            .state
            .diagnostics
            .merge
        parsed match
            grammar::ModuleSyntax { root_body: root_body } => root_body
        end
    }
}

impl Parser {
    fn finish_declaration_header
        self:mut$Parser
        declaration:$grammar::DeclarationSyntax
        resolver:$NameResolver
    {
        declaration.first_token.to_str self
            .current_module_mut
            .constructed_headers
            .add
        if declaration.public_token.is_some then
            declaration.name.as_str resolver.resolve_name = name
            name.as_str self
                .store
                .module_private_symbols
                .remove_str
            name self
                .store
                .public_symbols
                .add
        fi
    }

    # Aggregates and traits establish complete headers before ordinary bodies are decoded.
    fn collect_headers
        self:mut$Parser
        declarations:$std::List[grammar::DeclarationSyntax]
        tokens:$std::List[common::Token]
    {
        tokens NameResolver::new = resolver
        self
            .current_module
            .names
            .clone = resolver.names
        self.source_prefixes resolver.copy_module_prefixes
        for declaration in declarations.iter do
            if
                declaration.first_token tokens
                    .get
                    .location
                    .span
                    .offset
                    .to_str
                    .as_str self
                    .current_module
                    .rejected_declarations
                    .has_str
            then
                continue
            fi
            if declaration.header std::Option::Some(header) is then header else continue fi = header
            if "struct" declaration.kind.as_str == then
                if header grammar::DeclarationHeader::Aggregate(aggregate) is then
                    resolver aggregate declaration self construct_struct
                else
                    continue
                fi = structure
                if
                    structure.name.as_str self
                        .store
                        .structs
                        .has_str
                then
                    declaration.location f"Struct `{declaration.name}` is already defined"
                    common::ErrorKind::DuplicateName self.state.record_error_string
                fi
                structure.name.clone = name
                structure name self.put_struct
            elif "enum" declaration.kind.as_str == then
                if header grammar::DeclarationHeader::Aggregate(aggregate) is then
                    resolver aggregate declaration self construct_enum
                else
                    continue
                fi = enumeration
                if
                    enumeration.name.as_str self
                        .store
                        .enums
                        .has_str
                then
                    declaration.location f"Enum `{declaration.name}` is already defined"
                    common::ErrorKind::DuplicateName self.state.record_error_string
                fi
                enumeration.name.clone = name
                enumeration name self.put_enum
            else
                continue
            fi
            resolver declaration self.finish_declaration_header
        done
        for declaration in declarations.iter do
            if
                declaration.first_token tokens
                    .get
                    .location
                    .span
                    .offset
                    .to_str
                    .as_str self
                    .current_module
                    .rejected_declarations
                    .has_str
            then
                continue
            fi
            if declaration.header std::Option::Some(header) is then header else continue fi = header
            if "trait" declaration.kind.as_str == then
                if header grammar::DeclarationHeader::Trait(trait_header) is then
                    resolver trait_header declaration self construct_trait
                else
                    continue
                fi = casa_trait
                if
                    casa_trait.name.as_str self
                        .store
                        .traits
                        .has_str
                then
                    declaration.location f"Trait `{declaration.name}` is already defined"
                    common::ErrorKind::DuplicateName self.state.record_error_string
                fi
                casa_trait.name.clone = name
                casa_trait name self.put_trait
                resolver declaration self.finish_declaration_header
            fi
        done
    }
}
