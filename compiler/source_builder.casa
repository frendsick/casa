    fn lower_match
        self:mut$Parser
        resolver:mut$NameResolver
        construct:$grammar::MatchSyntax
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        construct.keyword resolver
            .tokens
            .get
            .location common::OpValue::MatchStart common::Op::new ops.push
        for arm in construct.arms.iter do
            0 arm.patterns.get = first_pattern
            first_pattern.token resolver
                .tokens
                .get
                .location
                .clone = arm_location
            if 1 arm.patterns.length == then
                false first_pattern resolver self.lower_pattern
            else
                std::List[common::PatternValue]::new = alternatives
                for alternative in arm.patterns.iter do
                    false alternative resolver self.lower_pattern alternatives.push
                done
                alternatives common::PatternValue::Alternatives
            fi = pattern
            std::List[common::Op]::new = guard_ops
            guard_ops function_name arm.guard resolver self.lower_terms
            guard_ops.is_empty ! = guarded
            guard_ops pattern common::MatchArm::new = match_arm
            if guarded then
                arm.arrow resolver
                    .tokens
                    .get
                    .location
                    .span
                    .offset std::Option::Some = match_arm.guard_end
            fi
            arm_location match_arm common::OpValue::MatchArm common::Op::new ops.push
            ops function_name arm.body resolver self.lower_terms
        done
        construct.close resolver
            .tokens
            .get
            .location common::OpValue::MatchEnd common::Op::new ops.push
    }

    # An f-string expression stays in the enclosing body between boundary
    # markers. Its names resolve there, and its value converts before its local
    # bindings end.
    fn lower_fstring
        self:mut$Parser
        resolver:mut$NameResolver
        fstring:$grammar::FstringSyntax
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        fstring.start resolver
            .tokens
            .get
            .location
            .clone = start_location
        0 = part_count: u64
        for part in fstring.parts.iter do
            part match
                grammar::FstringPartSyntax::Text(position) => {
                    position copy resolver.tokens.get = text
                    text.location text.value.clone common::OpValue::PushStr common::Op::new ops.push
                    text.location common::OpValue::FstringToStr common::Op::new ops.push
                }
                grammar::FstringPartSyntax::Expression(open terms close) => {
                    open copy resolver
                        .tokens
                        .get
                        .location
                        .clone = open_location
                    open_location common::OpValue::FstringExprStart common::Op::new ops.push
                    ops function_name terms resolver self.lower_terms
                    open_location common::OpValue::FstringToStr common::Op::new ops.push
                    close copy resolver
                        .tokens
                        .get
                        .location common::OpValue::FstringExprEnd common::Op::new ops.push
                }
            end
            1 += part_count
        done
        if 0 part_count == then
            start_location "".to_str common::OpValue::PushStr common::Op::new ops.push
            start_location common::OpValue::FstringToStr common::Op::new ops.push
            1 = part_count: u64
        fi
        if 1 part_count < then
            start_location part_count common::OpValue::FstringConcat common::Op::new ops.push
        fi
    }

    # Function headers come from their parsed signatures. Bodies lower with the
    # header's type bindings in scope.
    fn build_function
        self:mut$Parser
        resolver:mut$NameResolver
        function:$grammar::FunctionSyntax
    -> FunctionSource {
        resolver.type_bindings.length = inherited_bindings
        function.name_token resolver
            .tokens
            .get
            .clone = name_token
        resolver function.parameters self resolve_generic_parameters = parsed_type_variables
        parsed_type_variables.into_parts = const_params = trait_bounds = generic_params
        # Constant parameters keep their slots in the generic parameters but are not type variables (ADR-0152).
        std::List[std::String]::new = type_vars
        for candidate_name in generic_params.iter do
            if candidate_name const_params.has ! then
                candidate_name.clone type_vars.push
            fi
        done
        "Unexpected token in parameter list" self.store self.state resolver function.signature resolve_signature = effect

        # Rewrite signature const params to symbolic constants so unification treats
        # them as constants, not type variables (ADR-0152).
        if 0 const_params.length != then
            const_params effect rewrite_stack_effect_constant_parameters
        fi

        if 0 type_vars.length != then
            for type_var in type_vars.iter do
                type_var.clone effect.type_vars.add
            done
            trait_bounds effect common::StackEffect::set_trait_bounds
        fi
        type_vars common::string_list_to_set = function_type_vars
        function_type_vars effect common::canonicalize_stack_effect_type_vars
        std::List[common::Op]::new = ops
        std::List[common::Variable]::new = variables

        const_params effect common::StackEffect::set_const_params

        # Constant parameters are symbolic while this body is checked.
        name_token.location.clone variables effect inject_constant_parameters = constant_assignments
        constant_assignments ops.append

        # Named parameters become variables assigned on entry.
        for parameter in effect.parameters.iter do
            if "" parameter.name.as_str != then
                parameter.typ.clone parameter.name.clone common::Variable variables.push
                name_token.location parameter.name.clone common::OpValue::AssignVar common::Op::new ops.push
            fi
        done

        std::List[common::Op]::new = body_ops
        if function.body std::Option::Some(body) is then
            body_ops name_token.value.as_str body.terms resolver self.lower_terms
        fi
        function_type_vars body_ops common::canonicalize_operation_type_vars
        effect.const_params body_ops rewrite_operation_constant_parameters
        body_ops ops.append

        effect name_token.location.clone ops name_token.value.clone FunctionSource::with_stack_effect = source
        if function.body std::Option::Some(body) is then
            body.close resolver.tokens.get source.retain_body_end
        fi
        generic_params source.declaration common::Function::set_generic_params
        variables source.declaration common::Function::set_variables
        inherited_bindings resolver.restore_type_bindings
        source
    }

    fn build_extern_function
        self:mut$Parser
        resolver:mut$NameResolver
        function:$grammar::FunctionSyntax
    -> FunctionSource {
        function.name_token resolver
            .tokens
            .get
            .clone = name_token
        "Unexpected token in extern parameter list" self.store self.state resolver function.signature resolve_signature = effect
        effect name_token.location.clone std::List[common::Op]::new name_token.value.as_str resolver.resolve_name
        FunctionSource::with_stack_effect = source
        true = source.declaration.is_unsafe
        name_token.value.clone std::Option::Some = source.declaration.extern_symbol
        source
    }

    fn lower_implementation
        self:mut$Parser
        resolver:mut$NameResolver
        implementation:$grammar::ImplementationSyntax
        impl_token:$common::Token
    {
        resolver.type_bindings.length = inherited_bindings
        resolver implementation.parameters self resolve_generic_parameters = parsed_type_variables
        parsed_type_variables.into_parts = const_params = trait_bounds = generic_params
        # Constant parameters are not type variables (ADR-0152).
        std::List[std::String]::new = type_vars
        for candidate_name in generic_params.iter do
            if candidate_name const_params.has ! then
                candidate_name.clone type_vars.push
            fi
        done

        self.store self.state resolver implementation.receiver resolve_parsed_type = impl_type
        type_vars common::string_list_to_set = type_var_set
        type_var_set impl_type common::canonicalize_type_var = impl_type
        # Constant parameters in the implemented type are constants, not type
        # variables, so `array[T N]` keeps `N` symbolic (ADR-0152).
        if 0 const_params.length != then
            const_params impl_type rules::rewrite_type_const_params = impl_type
        fi
        impl_type implementation_receiver_name = impl_name

        std::List[common::TraitBound]::new = implemented_traits
        std::Map[std::String std::String]::new = trait_impl_methods
        for parsed in implementation.traits.iter do
            parsed.token resolver
                .tokens
                .get
                .clone = trait_token
            self.store self.state resolver parsed resolve_parsed_bound = bound
            for argument_index in bound.type_args.length 0 std::Range::new do
                type_var_set argument_index bound.type_args.get common::canonicalize_type_var
                argument_index bound.type_args.set
            done
            if
                bound.name self
                    .store
                    .traits
                    .get std::Option::Some(casa_trait) is
            then
                if bound.type_args.length casa_trait.type_params.length != then
                    trait_token.location f"Trait `{trait_token.value}` expects {casa_trait.type_params.length} type argument(s), got {bound.type_args.length}" common::ErrorKind::Syntax self.state.record_error_string
                    continue
                fi
            fi
            bound implemented_traits.push
        done

        for method in implementation.methods.iter do
            method.function resolver self.build_function = function
            method.unsafe_token.is_some function.declaration common::Function::set_is_unsafe
            function
                .declaration
                .name
                .clone = method_name
            if "drop" method_name.as_str == 0 implemented_traits.length != && then
                function.declaration.location "`drop` must be declared in an inherent implementation" common::ErrorKind::InvalidScope self.state.record_error
            fi
            std::String::new = fn_name
            if 0 implemented_traits.length != then
                0 implemented_traits
                    .get
                    .to_type
                    .format = trait_name
                f"{impl_name}::{trait_name}::{method_name}" = fn_name
                fn_name.clone method_name.clone trait_impl_methods.set
            else
                f"{impl_name}::{method_name}" = fn_name
            fi
            fn_name.clone function.declaration common::Function::set_name
            # Merge inherited type vars, trait bounds, and constant parameters
            if 0 type_vars.length != 0 const_params.length != || then
                const_params trait_bounds generic_params type_vars function self inject_implementation_parameters
            fi
            if
                fn_name.as_str self
                    .store
                    .get_function
                    .is_some
            then
                function.declaration.location f"Identifier `{function.declaration.location fn_name.as_str self.format_source_name}` is already defined" common::ErrorKind::DuplicateName self.state.record_error_string
            fi
            function fn_name.clone self.put_function
            if method.public_token.is_some then
                fn_name.as_str self
                    .store
                    .module_private_symbols
                    .remove_str
                fn_name.clone self
                    .store
                    .public_symbols
                    .add
            fi
        done

        for implemented_trait in implemented_traits.iter do
            std::Map[std::String std::String]::new = cloned_methods
            for pair in trait_impl_methods.iter do
                pair.second.clone pair.first.clone cloned_methods.set
            done
            std::Map[std::String std::List[common::TraitBound]]::new = cloned_bounds
            for pair in trait_bounds.iter do
                pair.second.clone pair.first.clone cloned_bounds.set
            done
            impl_token.location.clone cloned_methods cloned_bounds type_vars.clone
            implemented_trait.clone impl_type.clone common::TraitImpl
            self register_trait_impl
        done
        inherited_bindings resolver.restore_type_bindings
    }

    # Declarations keep their scope and prefix diagnostics. Module headers were
    # constructed before bodies, so their root occurrences emit no operations.
    fn lower_declaration
        self:mut$Parser
        resolver:mut$NameResolver
        declaration:$grammar::DeclarationTermSyntax
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        declaration.keyword resolver
            .tokens
            .get
            .clone = keyword_token
        keyword_token.value.as_str common::keyword_from_str.unwrap = keyword
        declaration.first_token.to_str = first_key
        first_key.as_str self
            .current_module
            .constructed_headers
            .has_str = constructed
        # Aggregate and trait headers publish themselves.
        if constructed common::KeywordKind::Const keyword != && then
            return
        fi
        std::Option[std::String]::None = public_name
        if declaration.public_token std::Option::Some(position) is then
            position copy resolver
                .tokens
                .get
                .clone = public
            self public.location "Public declarations" function_name require_global_scope
            resolver declaration public_declaration_name = public_name
            if public_name.is_none then
                public.location "`pub` must prefix a function, type, trait, or constant declaration" common::ErrorKind::Syntax self.state.record_error
            fi
        fi
        if ops declaration resolver self.reject_declaration ! then
            declaration.item match
                grammar::DeclarationItem::Function(function) => ops function_name function keyword keyword_token resolver self.lower_function_declaration
                grammar::DeclarationItem::Implementation(implementation) => {
                    self keyword_token.location "Implementation blocks" function_name require_global_scope
                    keyword_token implementation resolver self.lower_implementation
                }
                grammar::DeclarationItem::Header(_) => {
                    if constructed ! then
                        function_name keyword keyword_token self.reject_misplaced_header
                    fi
                }
            end
        fi
        if public_name std::Option::Some(name) is then
            name.as_str self
                .store
                .module_private_symbols
                .remove_str
            name.clone self
                .store
                .public_symbols
                .add
        fi
    }

    fn lower_function_declaration
        self:mut$Parser
        resolver:mut$NameResolver
        keyword_token:$common::Token
        keyword:common::KeywordKind
        function:$grammar::FunctionSyntax
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        if common::KeywordKind::Const keyword == then
            self keyword_token.location "Constants" function_name require_global_scope
            function resolver self.build_function drop
            keyword_token.location "`const fn` was removed; use `fn` for runtime calls and a bounded `const` block for constant values" common::ErrorKind::Syntax self.state.record_error
            return
        fi
        if common::KeywordKind::Extern keyword == then
            self keyword_token.location "Extern declarations" function_name require_global_scope
            function resolver self.build_extern_function
        else
            self keyword_token.location "Functions" function_name require_global_scope
            function resolver self.build_function = source
            source
                .declaration
                .name
                .as_str resolver.resolve_name = source.declaration.name
            common::KeywordKind::Unsafe keyword == source.declaration common::Function::set_is_unsafe
            source
        fi = source
        if
            source
                .declaration
                .name
                .as_str self
                .store
                .get_function
                .is_some
        then
            source
                .declaration
                .name
                .clone = declared_name
            source.declaration.location declared_name.as_str self.format_source_name = source_name
            source.declaration.location f"Identifier `{source_name}` is already defined" common::ErrorKind::DuplicateName self.state.record_error_string
        fi
        source
            .declaration
            .name
            .clone = name
        source name self.put_function
    }

    # Struct, enum, trait, and constant declarations are constructed only at module scope.
    fn reject_misplaced_header
        self:mut$Parser
        keyword_token:$common::Token
        keyword:common::KeywordKind
        function_name:$str
    {
        keyword match
            common::KeywordKind::Const => {
                self keyword_token.location "Constants" function_name require_global_scope
                keyword_token.location "Constant declaration was not elaborated" common::ErrorKind::Syntax self.state.record_error
                return
            }
            common::KeywordKind::Extern => {
                self keyword_token.location "Extern declarations" function_name require_global_scope
                keyword_token.location "Struct declarations must be constructed from module syntax" common::ErrorKind::InvalidScope self.state.record_error
            }
            common::KeywordKind::EnumKw => {
                keyword_token.location "Enums must be declared at module scope" common::ErrorKind::InvalidScope self.state.record_error
            }
            common::KeywordKind::TraitKw => {
                keyword_token.location "Traits must be declared at module scope" common::ErrorKind::InvalidScope self.state.record_error
            }
            _ => {
                keyword_token.location "Structs must be declared at module scope" common::ErrorKind::InvalidScope self.state.record_error
            }
        end
        self.state.mark_output_unusable
    }

    # Root items fail independently unless their construction already changed the store.
    fn lower_root
        self:mut$Parser
        tokens:$std::List[common::Token]
        root_body:$std::List[grammar::TermSyntax]
    -> std::List[common::Op] {
        std::List[common::Op]::new = ops
        if self.state.has_usable_output ! then
            ops return
        fi
        tokens NameResolver::new = resolver
        self
            .current_module
            .names
            .clone = resolver.names
        self.source_prefixes resolver.copy_module_prefixes
        for term in root_body.iter do
            self.state.reset_store_mutation
            ops.length = ops_before
            ops common::GLOBAL_SCOPE_LABEL term resolver self.lower_term
            if self.state.take_recovery_request then
                while ops_before ops.length < do
                    ops.pop drop
                done
                if self.state.store_was_mutated then
                    self.state.mark_output_unusable break
                fi
            fi
        done
        ops
    }
}

impl Parser {
    fn inherit_default_lambda_context self:mut$Parser name:$str {
        name self
            .store
            .get_function
            .unwrap
            .stack_effect
            .clone = effect
        if name self.bodies.get_completed std::Option::Some(body) is then
            {
                = closure: $str
                effect self.bodies self.store closure inherit_source_lambda_effect
            } = visitor
            visitor body.visit_closures
        fi
    }

    fn inherit_trait_default_context self:mut$Parser skip_traits:$std::Set[std::String] {
        for
            trait_name in self
                .store
                .traits
                .keys
                .iter
        do
            if trait_name skip_traits.has then
                continue
            fi
            trait_name self
                .store
                .traits
                .get
                .unwrap
                .clone = casa_trait
            for method in casa_trait.methods.iter do
                if method.default_function std::Option::Some(name) is then
                    name.as_str self.inherit_default_lambda_context
                fi
            done
        done
    }

    pub fn resolve_current_ops
        self:mut$Parser
        ops:std::List[common::Op]
        skip_functions:$std::Set[std::String]
        skip_traits:$std::Set[std::String]
    -> std::Option[std::List[common::Op]] {
        if self.state.has_usable_output ! then
            std::Option[std::List[common::Op]]::None return
        fi
        skip_functions ops self resolve_identifiers_global = resolved_ops
        if self.state.has_usable_output ! then
            std::Option[std::List[common::Op]]::None return
        fi
        self.store.get_function_names = function_names
        for function_name in function_names.iter do
            if function_name.as_str skip_functions.has_str then
                continue
            fi
            if function_name.as_str "lambda__" str::starts_with then
                continue
            fi
            function_name.as_str self
                .store
                .get_function
                .unwrap
                .clone self.bodies.begin match
                std::Option::Some(active) => false self.bodies self.state.diagnostics self.store active.resolve
                std::Option::None => {}
            end
        done
        skip_traits self.inherit_trait_default_context
        if self.state.has_usable_output then
            resolved_ops std::Option::Some
        else
            std::Option::None
        fi
    }

    pub fn finish_resolution
        self:Parser
        ops:std::List[common::Op]
        skip_functions:std::Set[std::String]
        skip_traits:std::Set[std::String]
    -> ParseResolveResult std::List[std::String] {
        if self.state.has_usable_output ! then
            self.into_failed_result return
        fi
        skip_traits skip_functions ops self.resolve_current_ops = result_ops
        if self.state.has_usable_output ! then
            self.into_failed_result return
        fi
        result_ops self.into_result
    }
}

fn inherit_source_lambda_effect
    name:$str
    store:mut$common::SymbolStore
    bodies:$SourceBodies
    effect:$common::StackEffect
{
    if name "lambda__" str::starts_with ! then
        return
    fi
    if name store.get_function_mut std::Option::Some(lambda) is then
        for variable in effect.type_vars.iter do
            variable.clone lambda
                .stack_effect
                .type_vars
                .add
        done
        for bound in effect.trait_bounds.iter do
            bound.second.clone bound.first.clone lambda
                .stack_effect
                .trait_bounds
                .set
        done
    fi
    if name bodies.get_completed std::Option::Some(body) is then
        {
            = closure: $str
            effect bodies store closure inherit_source_lambda_effect
        } = visitor
        visitor body.visit_closures
    fi
}

# Construct root declarations and lower root operations without resolution.
pub fn parse_ops parser:mut$Parser tokens:$std::List[common::Token] -> std::List[common::Op] {
    "" tokens parser.prepare_module = root_body
    root_body tokens parser.lower_root
}

pub fn parse_and_resolve
    tokens:std::List[common::Token]
    search_paths:std::List[std::String]
    diagnostics:error::Diagnostics
    sources:mut$lexer::SourceStore
-> ParseResolveResult {
    std::Map[std::String ImportedModule]::new = import_cache
    import_cache sources diagnostics common::SymbolStore::new Parser::new = parser
    search_paths parser Parser::set_search_paths
    tokens parser parse_root drop
}

# Root import cycles compare against the root's normalized identity.
fn enter_root parser:mut$Parser tokens:$std::List[common::Token] {
    if 0 tokens.length < then
        0 tokens
            .get
            .location
            .file
            .as_str lexer::absolute_normalize_path parser.import_stack.push
    fi
}

# Also returns the root's imports in analysis order.
fn parse_root
    parser:Parser
    tokens:std::List[common::Token]
-> ParseResolveResult std::List[std::String] {
    tokens parser enter_root
    "" tokens parser.prepare_module = root_body
    parser
        .imports
        .paths
        .clone = root_imports
    root_body tokens parser.lower_root = ops
    std::Set[std::String]::new = skip_functions
    std::Set[std::String]::new = skip_traits
    skip_traits skip_functions ops parser.finish_resolution = included_files = result
    result root_imports
}

# Parser state after analyzing the modules a root imports. The root stage parses
# over copies, so one import analysis can serve several root revisions.
pub struct ImportSource {
    module_cache:    std::Map[std::String ImportedModule]
    analyzed_files:  std::Set[std::String]
    source_prefixes: std::Map[std::String std::String]
    imports:         ImportRecord
}

impl ImportSource {
    pub fn get_paths self:$ImportSource -> $std::List[std::String] { self.imports.paths }
    pub fn get_resolutions self:$ImportSource -> $std::List[ImportResolution] {
        self.imports.resolutions
    }
    pub fn is_clean self:$ImportSource -> bool { self.imports.clean }
}

# Import stage: analyze the root's imports without declaring the root. Root lexical
# diagnostics limit import discovery as they do in `parse_and_resolve`.
pub fn parse_imports
    tokens:$std::List[common::Token]
    search_paths:std::List[std::String]
    diagnostics:error::Diagnostics
    sources:mut$lexer::SourceStore
-> ImportSource common::SymbolStore std::Map[std::String source_body::SourceBody] {
    std::Map[std::String ImportedModule]::new = import_cache
    import_cache sources diagnostics common::SymbolStore::new Parser::new = parser
    search_paths parser Parser::set_search_paths
    tokens parser enter_root
    "" tokens parser.prepare_imports
    parser match
        Parser { bodies: bodies store: store state: state analyzed_files: analyzed_files source_prefixes: prefixes imports: imports } => {
            state.into_parts = references drop
            references store.type_references.append
            bodies.into_bodies store imports prefixes analyzed_files
        }
    end = analyzed_files = prefixes = imports = store = bodies
    imports prefixes analyzed_files import_cache ImportSource store bodies
}

# Root stage: parse the root over `store`, the checked import-stage declarations.
# The returned root import order must match `imports` before the result is used.
pub fn parse_root_with_imports
    tokens:std::List[common::Token]
    search_paths:std::List[std::String]
    diagnostics:error::Diagnostics
    sources:mut$lexer::SourceStore
    imports:$ImportSource
    store:common::SymbolStore
-> ParseResolveResult std::List[std::String] {
    imports.module_cache.clone = import_cache
    import_cache sources diagnostics store Parser::new = parser
    search_paths parser Parser::set_search_paths
    imports.analyzed_files.clone = parser.analyzed_files
    imports.source_prefixes.clone = parser.source_prefixes
    tokens parser parse_root
}

# resolve_identifiers - post-parse pass
# The binding an operation reads or assigns through, when it can be a capture.
fn get_capture_candidate op:$common::Op -> std::Option[std::String] {
    op.value match
        common::OpValue::Identifier(name) => name.clone std::Option::Some
        common::OpValue::AssignVar(target) |
        common::OpValue::AssignYield(target) |
        common::OpValue::AssignInc(target) |
        common::OpValue::AssignDec(target) => {
            target.as_str "." str::split.unwrap = target_parts
            if target_parts.length 1 > then
                0 target_parts.get.clone std::Option::Some
            else
                std::Option[std::String]::None
            fi
        }
        _ => std::Option[std::String]::None
    end
}

fn add_capture variable:$common::Variable lambda_function:mut$common::Function {
    if variable.name.as_str lambda_function.captures common::variable_list_contains ! then
        variable.clone lambda_function.captures.push
    fi
}

pub fn gather_captures
    store:mut$common::SymbolStore
    lambda_function:mut$common::Function
    function:mut$common::Function
    operations:$std::List[common::Op]
    allow_root_local_capture:bool
{
    for op in operations.iter do
        if op get_capture_candidate std::Option::Some(name) is else
            continue
        fi
        if
            name.as_str function.variables common::variable_list_index std::Option::Some(variable_index) is
        then
            lambda_function variable_index function.variables.get add_capture
        elif
            name.as_str function.captures common::variable_list_index std::Option::Some(capture_index) is
        then
            # A nested closure can capture a value already captured by its enclosing closure.
            lambda_function capture_index function.captures.get add_capture
        elif
            name.as_str store.variables.get_str std::Option::Some(root_variable) is allow_root_local_capture &&
        then
            lambda_function root_variable add_capture
        fi
    done

    # Constant parameters stay in scope inside a closure. A call in the body
    # may forward one, and the typechecker adds that read after captures are
    # gathered, so capture them up front (ADR-0152).
    for
        constant_name in function
            .stack_effect
            .const_params
            .keys
            .iter
    do
        if constant_name.as_str lambda_function.captures common::variable_list_contains then
            continue
        fi
        if
            constant_name.as_str function.variables common::variable_list_index std::Option::Some(constant_variable_index) is
        then
            constant_variable_index function
                .variables
                .get
                .clone lambda_function.captures.push
        fi
    done
}

# Root closures may capture root locals. Other functions must receive root-owned
# state through explicit parameters.
fn reject_root_local_capture
    name:$str
    function:$common::Function
    store:$common::SymbolStore
    location:$common::Location
    allow_root_local_capture:bool
    errors:mut$std::List[error::CasaError]
-> bool {
    if allow_root_local_capture then
        false return
    fi
    if
        name function.variables common::variable_list_contains
        name function.captures common::variable_list_contains ||
    then
        false return
    fi
    if name store.variables.has_str ! then
        false return
    fi
    location.clone
    f"Named functions cannot capture root local `{name}`; pass it as a parameter"
    common::ErrorKind::InvalidScope
    error::CasaError::new
    errors.push
    true
}

pub fn resolve_array_identifiers
    store:mut$common::SymbolStore
    items:mut$std::List[common::Op]
    function:mut$common::Function
    allow_root_local_capture:bool
    errors:mut$std::List[error::CasaError]
    diagnostics:mut$error::Diagnostics
    bodies:mut$SourceBodies
{
    for entry in items.iter_mut do
        if entry.value common::OpValue::PushArray(inner_items) is then
            bodies diagnostics errors allow_root_local_capture function inner_items store resolve_array_identifiers
        elif entry.value common::OpValue::ExprGroup(group_inner) is then
            bodies diagnostics allow_root_local_capture function group_inner store resolve_identifiers
        elif entry.value common::OpValue::Identifier(name_reference) is then
            entry
                .location
                .file
                .as_str name_reference.as_str store.resolve_name = resolved_name
            if
                name_reference.as_str function.variables common::variable_list_contains
                name_reference.as_str function.captures common::variable_list_contains ||
                name_reference.as_str store.variables.has_str allow_root_local_capture && ||
                name_reference.as_str common::source_reference_head.as_str function
                    .stack_effect
                    .type_vars
                    .has_str ||
            then
                name_reference.clone = resolved_name
            fi
            if resolved_name.as_str function.variables common::variable_list_contains then
                resolved_name.clone common::OpValue::PushVar entry common::Op::set_value
            elif resolved_name.as_str function.captures common::variable_list_contains then
                resolved_name.clone common::OpValue::PushCapture entry common::Op::set_value
            elif
                errors allow_root_local_capture entry.location store function resolved_name.as_str
                reject_root_local_capture
            then
            elif
                resolved_name.as_str store
                    .variables
                    .get_str
                    .is_some
            then
                resolved_name.clone common::OpValue::PushVar entry common::Op::set_value
            elif
                resolved_name.as_str store.constants.get_str = constant_opt constant_opt std::Option::Some(constant) is
            then
                constant entry.resolve_constant
            elif errors resolved_name.as_str entry store try_resolve_enum_variant_ident then
            elif resolved_name.as_str store.has_function then
                resolved_name.clone common::OpValue::FnPush entry common::Op::set_value
            else
                entry.location.clone f"Identifier `{name_reference}` is not defined" common::ErrorKind::UndefinedName error::CasaError::new errors.push
            fi
        fi
    done
}

pub fn resolve_enum_variant
    store:mut$common::SymbolStore
    variant:mut$common::EnumVariant
    op:mut$common::Op
    function:mut$common::Function
    errors:mut$std::List[error::CasaError]
{
    # Resolve enum variant ordinal if still unresolved
    if variant.enum_name.length 0 != variant.ordinal.is_none && then
        if variant.enum_name.as_str store.enums.get_str std::Option::Some(casa_enum) is then
            variant.variant_name.as_str casa_enum.variants common::string_list_index = variant_ordinal
            if variant_ordinal std::Option::Some(index) is then
                index i64::try_from.unwrap std::Option::Some variant common::EnumVariant::set_ordinal
            else
                op
                    .location
                    .file
                    .as_str variant.enum_name.as_str store.format_name_for_source
                = enum_name
                op.location.clone f"Variant `{variant.variant_name}` is not defined in enum `{enum_name}`" common::ErrorKind::UndefinedName error::CasaError::new errors.push
            fi
        else
            op
                .location
                .file
                .as_str variant.enum_name.as_str store.format_name_for_source
            = enum_name
            op.location.clone f"Enum `{enum_name}` is not defined" common::ErrorKind::UndefinedName error::CasaError::new errors.push
        fi
    fi
    for child in variant.bindings.iter_mut do
        errors function op child store resolve_pattern_value
    done
}

impl Parser {
    pub fn analyze_import
        self:mut$Parser
        import_path:$str
        module_prefix:$str
    -> std::Result[bool os::IoError] {
        self
            .state
            .diagnostics
            .error_count = errors_before
        self.state.constant_errors = constant_errors_before
        self.sources import_path.clone lexer::lex_file = import_result
        error::Diagnostics::new = diagnostics
        std::List[common::Token]::new = tokens
        import_result match
            std::Result::Ok(lex_result) => lex_result.into_parts = diagnostics = tokens
            std::Result::Error(error) => error std::Result::Error return
        end
        diagnostics self
            .state
            .diagnostics
            .merge
        if
            errors_before self
                .state
                .diagnostics
                .error_count <
        then
            false std::Result::Ok
            return
        fi
        self.store.declaration_names = existing_declarations
        self
            .store
            .variables
            .keys common::string_list_to_set = existing_variables
        self.store.get_function_names common::string_list_to_set = existing_functions
        self
            .store
            .traits
            .keys common::string_list_to_set = existing_traits
        ModuleContext::new self.module_contexts.push
        import_path.to_str self.import_stack.push
        module_prefix tokens self.prepare_module = root_body
        root_body tokens self.lower_root = imported_ops
        if
            self.state.has_usable_output ! constant_errors_before errors_before self.state.has_nonconstant_errors_since ||
        then
            self.import_stack.pop drop
            self.module_contexts.pop drop
            false std::Result::Ok
            return
        fi
        existing_traits existing_functions imported_ops self.resolve_current_ops = resolved_ops_opt
        # Imported root locals have no scope in the importing module.
        self
            .store
            .variables
            .keys = root_names
        for name in root_names.iter do
            if name.as_str existing_variables.has_str ! then
                name.as_str self
                    .store
                    .variables
                    .remove_str drop
            fi
        done
        self.store.declaration_names = resolved_declarations
        for name in resolved_declarations.iter do
            if name.as_str existing_declarations.has_str ! then
                name.clone self
                    .current_module_mut
                    .declared_names
                    .add
            fi
        done
        self.import_stack.pop drop
        self.module_contexts.pop = module_context
        if
            resolved_ops_opt.is_none constant_errors_before errors_before self.state.has_nonconstant_errors_since ||
        then
            false std::Result::Ok
            return
        fi
        resolved_ops_opt.unwrap = resolved_ops
        for name in module_context.declared_names.iter do
            if
                name.as_str self
                    .store
                    .module_private_symbols
                    .has_str
            then
                name.as_str self
                    .store
                    .module_private_symbols
                    .remove_str
                name.clone self
                    .store
                    .private_symbols
                    .add
            fi
        done
        false ImportedModule
        = imported_module
        imported_module import_path.to_str self.module_cache.set
        true std::Result::Ok
    }
}

pub fn resolve_identifiers_global
    parser:mut$Parser
    ops:std::List[common::Op]
    skip_functions:$std::Set[std::String]
-> std::List[common::Op] {
    ops = expanded_ops
    if parser.state.has_usable_output ! then
        std::List[common::Op]::new return
    fi
    std::Set[std::String]::new = no_type_vars
    no_type_vars expanded_ops common::canonicalize_operation_type_vars
    if parser validate_traits ! then
        std::List[common::Op]::new return
    fi
    parser validate_inhabited_aggregates
    parser derive_traits_for_aggregates
    parser register_builtin_copy_impls
    parser validate_drop_methods
    skip_functions parser finalize_trait_impl_methods
    parser synthesize_copy_clone_fallbacks
    parser validate_trait_impls
    if parser.state.has_usable_output ! then
        std::List[common::Op]::new return
    fi
    common::empty_location common::GLOBAL_SCOPE_LABEL.to_str common::Function::new = dummy
    parser.bodies parser.state.diagnostics true dummy expanded_ops parser.store resolve_identifiers
    expanded_ops
}

fn resolve_assignment
    store:mut$common::SymbolStore
    function:mut$common::Function
    operation:mut$common::Op
    errors:mut$std::List[error::CasaError]
    allow_root_local_capture:bool
{
    operation.str_value = name
    name.as_str "." str::split.unwrap = parts
    0 parts.get = root
    if root.as_str store.constants.has_str then
        operation
            .location
            .file
            .as_str root.as_str store.format_name_for_source = source_name
        operation.location.clone f"Cannot assign to constant `{source_name}`"
        common::ErrorKind::Syntax error::CasaError::new errors.push
        common::OpValue::Rejected = operation.value
        return
    fi
    if
        operation.value common::OpValue::AssignVar is !
        operation.value common::OpValue::AssignYield is ! &&
        parts.length 1 > ||
    then
        if
            errors allow_root_local_capture operation.location store function root.as_str
            reject_root_local_capture
        then
            common::OpValue::Rejected = operation.value
        fi
        return
    fi
    name.as_str common::Variable::new = variable
    if common::GLOBAL_SCOPE_LABEL function.name.as_str == then
        if name.as_str store.variables.has_str ! then
            variable name.clone store.variables.set
        fi
    elif
        name.as_str function.variables common::variable_list_contains !
        name.as_str function.captures common::variable_list_contains ! &&
    then
        variable function.variables.push
    fi
}

pub fn resolve_identifiers
    store:mut$common::SymbolStore
    ops:mut$std::List[common::Op]
    function:mut$common::Function
    allow_root_local_capture:bool
    diagnostics:mut$error::Diagnostics
    bodies:mut$SourceBodies
{
    0 = op_index: u64
    std::List[error::CasaError]::new = resolve_errors
    while op_index ops.length < do
        op_index ops.get_mut = current_op
        1 += op_index

        if
            current_op.value common::OpValue::AssignVar is
            current_op.value common::OpValue::AssignYield is ||
            current_op.value common::OpValue::AssignInc is ||
            current_op.value common::OpValue::AssignDec is ||
        then
            allow_root_local_capture resolve_errors current_op function store resolve_assignment
            continue
        fi

        if current_op.value common::OpValue::FnPush(fn_name_ref) is then
            fn_name_ref.clone = fn_name
            fn_name.as_str store
                .get_function
                .unwrap
                .clone bodies.begin match
                std::Option::Some(active) => {
                    allow_root_local_capture active.operations function active.declaration store gather_captures
                    allow_root_local_capture bodies diagnostics store active.resolve
                }
                std::Option::None => {}
            end
            continue
        fi

        if current_op.value common::OpValue::PushArray(items_inner) is then
            bodies diagnostics resolve_errors allow_root_local_capture function items_inner store resolve_array_identifiers
            continue
        fi

        if current_op.value common::OpValue::ExprGroup(group_inner) is then
            bodies diagnostics allow_root_local_capture function group_inner store resolve_identifiers
            continue
        fi

        if current_op.value common::OpValue::Identifier(ident_ref) is then
            current_op
                .location
                .file
                .as_str ident_ref.as_str store.resolve_name = ident
            if
                ident_ref.as_str function.variables common::variable_list_contains
                ident_ref.as_str function.captures common::variable_list_contains ||
                ident_ref.as_str store.variables.has_str allow_root_local_capture && ||
                ident_ref.as_str common::source_reference_head.as_str function
                    .stack_effect
                    .type_vars
                    .has_str ||
            then
                ident_ref.clone = ident
            fi
            if
                ident.as_str current_op store is_private_identifier_or_receiver
                ident.as_str current_op store can_defer_private_method_check !
                &&
            then
                current_op
                    .location
                    .file
                    .as_str ident.as_str store.format_name_for_source = source_name
                current_op.location.clone
                f"Declaration `{source_name}` is private"
                common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                continue
            fi
            if resolve_errors ident.as_str current_op function store try_resolve_fn_ref then
                continue
            fi
            if ident.as_str current_op try_resolve_numeric_call then
                continue
            fi
            if ident.as_str current_op function try_resolve_trait_method_call then
                continue
            fi
            if resolve_errors ident.as_str current_op store try_resolve_enum_variant_ident then
                continue
            fi
            if ident.as_str current_op store try_resolve_qualified_trait_method then
                continue
            fi
            if ident.as_str current_op store try_resolve_type_qualified_method then
                continue
            fi
            if
                current_op
                    .location
                    .file
                    .as_str ident.as_str store.is_private_from
            then
                current_op
                    .location
                    .file
                    .as_str ident.as_str store.format_name_for_source = source_name
                current_op.location.clone
                f"Declaration `{source_name}` is private"
                common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                continue
            fi
            resolve_errors allow_root_local_capture ident.as_str current_op function store resolve_plain_identifier
            continue
        fi

        if current_op.value common::OpValue::MatchArm is then
            bodies diagnostics resolve_errors allow_root_local_capture current_op function store resolve_match_op
            continue
        fi

        if current_op.value common::OpValue::IsCheck(is_enum_variant) is then
            is_enum_variant.clone = resolved_variant
            resolve_errors function current_op resolved_variant store resolve_enum_variant
            resolved_variant common::OpValue::IsCheck current_op common::Op::set_value
            continue
        fi
    done

    resolve_errors.reverse
    while resolve_errors.is_empty ! do
        resolve_errors.pop diagnostics.push_error
    done
}

# Generic associated-item syntax erases type arguments from the identifier.
# Check both that identifier and the receiver which remains in the type hint.
fn is_private_identifier_or_receiver store:$common::SymbolStore op:$common::Op ident:$str -> bool {
    op
        .location
        .file
        .as_str = source_file
    if source_file ident store.is_private_from then
        true return
    fi
    if op.type_hint std::Option::Some(receiver_type) is then
        receiver_type.match_base = receiver_name
        source_file receiver_name.as_str store.is_private_from return
    fi
    false
}

# A concrete method can be visible even when its erased generic fallback is
# private. Other hinted associated items must pass the normal privacy check.
fn can_defer_private_method_check store:$common::SymbolStore op:$common::Op ident:$str -> bool {
    if op.type_hint std::Option::Some(receiver_type) is then
        if ident "::" str::contains ! then
            false return
        fi
        ident "::" str::split.unwrap = parts
        parts.length 1 - parts.get = method_name
        receiver_type.match_base = receiver_base
        if
            op
                .location
                .file
                .as_str receiver_base.as_str store.is_private_from
        then
            false return
        fi
        if receiver_base.as_str store.enums.get_str std::Option::Some(casa_enum) is then
            if method_name.as_str casa_enum.variants common::string_list_contains then
                false return
            fi
        fi
        f"{receiver_type.format}::{method_name}" = exact_name
        if exact_name.as_str store.has_function then
            op
                .location
                .file
                .as_str exact_name.as_str store.is_private_from ! return
        fi
    fi
    false
}

# Try resolving compiler-owned numeric associated conversion calls.
pub fn try_resolve_numeric_call op:mut$common::Op ident:$str -> bool {
    if
        ident common::split_qualified_name std::Option::Some(std::Pair { first: target_name second: method }) is
    else
        false return
    fi
    target_name.as_str common::parse_builtin = target_opt
    if target_opt.is_none then
        false return
    fi
    if
        "from" method.as_str ==
        "from_bits" method.as_str == ||
        "round_from" method.as_str == ||
        "trunc_from" method.as_str == ||
        "wrapping_from" method.as_str == ||
        "from_codepoint_unchecked" method.as_str == ||
        "__from_decimal_parts" method.as_str == ||
        "__float_significand" method.as_str == ||
        "try_from" method.as_str == || !
    then
        false return
    fi
    target_opt.unwrap method common::NumericCall common::OpValue::NumericCall op common::Op::set_value
    true
}

pub fn register_struct_pattern_binding
    store:mut$common::SymbolStore
    function:mut$common::Function
    binding_name:$str
{
    binding_name common::Variable::new = match_struct_variant
    if common::GLOBAL_SCOPE_LABEL function.name.as_str == then
        match_struct_variant binding_name.clone store.variables.set_str
    else
        if binding_name function.variables common::variable_list_contains ! then
            match_struct_variant function.variables.push
        fi
    fi
}

impl common::Op {
    pub fn set_match_pattern_value self:mut$common::Op pattern_value:common::PatternValue {
        if self.value common::OpValue::MatchArm(arm) is then
            arm.clone = updated_arm
            pattern_value updated_arm common::MatchArm::set_pattern_value
            updated_arm common::OpValue::MatchArm self.set_value
        fi
    }
}

pub fn resolve_pattern_value
    store:mut$common::SymbolStore
    pattern:mut$common::PatternValue
    op:mut$common::Op
    function:mut$common::Function
    errors:mut$std::List[error::CasaError]
{
    pattern match
        common::PatternValue::Binding(binding) => {
            binding.name.as_str function store register_struct_pattern_binding
        }
        common::PatternValue::EnumVariant(variant) => {
            errors function op variant store resolve_enum_variant
        }
        common::PatternValue::Struct(struct_pattern) => {
            if struct_pattern.struct_name store.structs.has ! then
                op
                    .location
                    .file
                    .as_str struct_pattern.struct_name.as_str store.format_name_for_source = source_name
                op.location.clone
                f"Struct `{source_name}` is not defined"
                common::ErrorKind::UndefinedName error::CasaError::new errors.push
            fi
            for
                name in struct_pattern
                    .bindings
                    .keys
                    .iter
            do
                name struct_pattern
                    .bindings
                    .get_mut
                    .unwrap = child
                errors function op child store resolve_pattern_value
            done
        }
        common::PatternValue::Alternatives(alternatives) => {
            for alternative in alternatives.iter_mut do
                errors function op alternative store resolve_pattern_value
            done
        }
        common::PatternValue::Literal(_) => {}
    end
}

# Register struct-pattern field bindings as locals or globals.
# Resolve enum-variant ordinals. Literal and wildcard patterns need no resolution.
pub fn resolve_match_op
    store:mut$common::SymbolStore
    function:mut$common::Function
    op:mut$common::Op
    allow_root_local_capture:bool
    errors:mut$std::List[error::CasaError]
    diagnostics:mut$error::Diagnostics
    bodies:mut$SourceBodies
{
    op common::pattern_value_of = pattern
    errors function op pattern store resolve_pattern_value
    pattern op.set_match_pattern_value
    if op.value common::OpValue::MatchArm(arm) is then
        if arm.guard_ops.length 0 != then
            arm.clone = resolved_arm
            bodies diagnostics allow_root_local_capture function resolved_arm.guard_ops store resolve_identifiers
            resolved_arm common::OpValue::MatchArm op common::Op::set_value
        fi
    fi
}

# Try resolving `&name` and `&K::method` function references. Returns true
# if the identifier begins with `&`, in which case the op has been rewritten
# (or an error pushed) and the caller should skip further resolution.
pub fn try_resolve_fn_ref
    store:mut$common::SymbolStore
    function:mut$common::Function
    op:mut$common::Op
    ident:$str
    resolve_errors:mut$std::List[error::CasaError]
-> bool {
    if '&' 0 ident.at.unwrap != then
        false return
    fi
    ident 1 ident.length 1 - str::substring = ref_name
    if 0 ref_name.length == then
        op.location.clone "Expected function name after `&`".to_str common::ErrorKind::Syntax error::CasaError::new resolve_errors.push
        true return
    fi
    ref_name.as_str "::" str::split.unwrap = ref_parts
    if 2 ref_parts.length == "drop" ref_parts.length 1 - ref_parts.get.as_str == && then
        op.location.clone "Reserved `drop` methods cannot be referenced".to_str common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
        true return
    fi
    if 3 ref_parts.length == then
        0 ref_parts.get.as_str common::parse_type_str = receiver_type
        1 ref_parts.get.clone common::GenericType::new common::Type::Generic = qualifier_type
        if op.type_hint std::Option::Some(hint) is then
            hint.match_base = hint_base
            if 0 ref_parts.get.as_str hint_base.as_str == then
                hint.clone = receiver_type
            elif hint.type_params std::Option::Some(type_arguments) is then
                type_arguments.clone 1 ref_parts.get.clone common::GenericType::with_params common::Type::Generic = qualifier_type
            fi
        fi
        2 ref_parts.get = method_name
        store receiver_type qualifier_type method_name.as_str rules::resolve_qualified_method_semantics
        = method_opt
        if method_opt.is_none then
            if op.type_hint std::Option::Some(hint) is then
                store std::Option[common::Function]::None hint method_name.as_str
                rules::resolve_method_semantics
                = method_opt
            fi
        fi
        if method_opt std::Option::Some(method) is then
            if method.function_name.as_str store.is_function_unsafe std::Option::Some(is_unsafe) is then
                if
                    op
                        .location
                        .file
                        .as_str method.function_name.as_str store.is_private_from
                then
                    op
                        .location
                        .file
                        .as_str method.function_name.as_str store.format_name_for_source = source_name
                    op.location.clone
                    f"Function `{source_name}` is private"
                    common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                    true return
                fi
                if is_unsafe then
                    op
                        .location
                        .file
                        .as_str method.function_name.as_str store.format_name_for_source = source_name
                    op.location.clone f"Unsafe function `{source_name}` cannot be referenced" common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                    true return
                fi
                method.function_name.clone common::OpValue::FnPush op common::Op::set_value
                true return
            fi
        fi
    fi
    if
        ref_name.as_str common::split_qualified_name std::Option::Some(std::Pair { first: ref_type_var second: ref_trait_method }) is
    then
        ref_type_var.as_str function
            .stack_effect
            .trait_bounds
            .get_str = ref_bound_opt
        if ref_bound_opt.is_some then
            ref_type_var.to_str common::Type::TypeVar = receiver
            receiver ref_trait_method common::DeferredTraitCall::unresolved
            common::OpValue::TraitMethodRef op common::Op::set_value
            true return
        fi
    fi
    if 2 ref_parts.length == then
        0 ref_parts.get.as_str common::parse_type_str = receiver_type
        if op.type_hint std::Option::Some(hint) is then
            hint.clone = receiver_type
        fi
        1 ref_parts.get = method_name
        store std::Option[common::Function]::None receiver_type method_name.as_str rules::resolve_method_semantics
        = method_opt
        if method_opt std::Option::Some(method) is then
            if method.function_name.as_str store.is_function_unsafe std::Option::Some(is_unsafe) is then
                if
                    op
                        .location
                        .file
                        .as_str method.function_name.as_str store.is_private_from
                then
                    op
                        .location
                        .file
                        .as_str method.function_name.as_str store.format_name_for_source = source_name
                    op.location.clone
                    f"Function `{source_name}` is private"
                    common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                    true return
                fi
                if is_unsafe then
                    op
                        .location
                        .file
                        .as_str method.function_name.as_str store.format_name_for_source = source_name
                    op.location.clone f"Unsafe function `{source_name}` cannot be referenced" common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
                    true return
                fi
                method.function_name.clone common::OpValue::FnPush op common::Op::set_value
                true return
            fi
        fi
    fi
    ref_name.as_str store.is_function_unsafe = ref_is_unsafe_opt
    if ref_is_unsafe_opt std::Option::Some(ref_is_unsafe) is then
        if ref_is_unsafe then
            op
                .location
                .file
                .as_str ref_name.as_str store.format_name_for_source = source_name
            op.location.clone f"Unsafe function `{source_name}` cannot be referenced" common::ErrorKind::InvalidScope error::CasaError::new resolve_errors.push
            true return
        fi
        ref_name.clone common::OpValue::FnPush op common::Op::set_value
    else
        op
            .location
            .file
            .as_str ref_name.as_str store.format_name_for_source = source_name
        f"Function `{source_name}` is not defined" = message
        if
            op
                .location
                .file
                .as_str ref_name.as_str store.find_imported_namespace_replacement std::Option::Some(replacement) is
        then
            f"{message}. Use `&{replacement}`" = message
        fi
        op.location.clone message common::ErrorKind::UndefinedName error::CasaError::new resolve_errors.push
    fi
    true
}

# Try resolving `Enum::Variant` identifiers. Returns true if the enum is
