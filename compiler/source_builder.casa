    receiver.clone
    common::TraitImpl = trait_impl
    "clone" receiver make_derived_function_name.as_str trait_impl parser make_copy_clone_fallback
}

pub fn set_derived_method
    methods:mut$std::Map[std::String std::String]
    method_name:$str
    function_name:$std::Option[std::String]
{
    if function_name std::Option::Some(name) is then
        name.clone method_name.to_str methods.set
    fi
}

pub fn does_derived_clone_type_require_var typ:$common::Type type_var:$str -> bool {
    if typ.is_borrow then
        false return
    fi
    typ match
        common::Type::TypeVar(name) => name.as_str type_var ==
        common::Type::Const(const_type) => const_type.is_symbolic const_type.name.as_str type_var == &&
        common::Type::Generic(generic) => {
            for parameter in generic.params.iter do
                if type_var parameter does_derived_clone_type_require_var then
                    true return
                fi
            done
            false
        }
        common::Type::Function(function_type) => {
            for parameter in function_type.parameters.iter do
                if type_var parameter does_derived_clone_type_require_var then
                    true return
                fi
            done
            for return_type in function_type.return_types.iter do
                if type_var return_type does_derived_clone_type_require_var then
                    true return
                fi
            done
            false
        }
        _ => false
    end
}

pub fn does_type_contain_exclusive_borrow typ:$common::Type -> bool {
    if typ.is_shared_borrow then
        false return
    fi
    if typ.is_exclusive_borrow then
        true return
    fi
    if typ common::Type::Generic(generic) is then
        for parameter in generic.params.iter do
            if parameter does_type_contain_exclusive_borrow then
                true return
            fi
        done
    fi
    false
}

pub fn add_derived_required_type_vars
    typ:$common::Type
    type_vars:$std::List[std::String]
    required_type_vars:mut$std::Set[std::String]
{
    for type_variable in type_vars.iter do
        if type_variable.as_str typ.type_contains_var then
            type_variable.clone required_type_vars.add
        fi
    done
}

pub fn add_derived_clone_required_type_vars
    typ:$common::Type
    type_vars:$std::List[std::String]
    required_type_vars:mut$std::Set[std::String]
{
    for type_variable in type_vars.iter do
        if type_variable.as_str typ does_derived_clone_type_require_var then
            type_variable.clone required_type_vars.add
        fi
    done
}

pub fn derive_traits_for_aggregate
    parser:mut$Parser
    name:$str
    type_vars:$std::List[std::String]
    derived_traits:$std::List[std::String]
    required_type_vars:$std::Set[std::String]
    clone_required_type_vars:$std::Set[std::String]
    has_exclusive_borrow:bool
    location:$common::Location
{
    false = derives_clone
    false = derives_copy
    false = derives_eq
    false = derives_hashable
    false = derives_ord
    for derived_trait in derived_traits.iter do
        if common::STD_CLONE_TRAIT derived_trait.as_str == then
            true = derives_clone
        elif common::STD_COPY_TRAIT derived_trait.as_str == then
            true = derives_copy
        elif common::STD_EQ_TRAIT derived_trait.as_str == then
            true = derives_eq
        elif common::STD_HASHABLE_TRAIT derived_trait.as_str == then
            true = derives_hashable
        elif common::STD_ORD_TRAIT derived_trait.as_str == then
            true = derives_ord
        else
            location f"Derivation for trait `{location derived_trait.as_str parser.format_source_name}` is not supported" common::ErrorKind::InvalidScope parser.state.record_error_string
        fi
    done

    type_vars name make_aggregate_receiver = receiver
    for derived_trait in derived_traits.iter do
        if
            location derived_trait.as_str receiver parser find_overlapping_explicit_trait std::Option::Some(explicit_trait) is
        then
            location f"Derived `{location derived_trait.as_str parser.format_source_name}` for `{location name parser.format_source_name}` overlaps explicit `{location explicit_trait.as_str parser.format_source_name}` implementation" common::ErrorKind::DuplicateName parser.state.record_error_string
            return
        fi
    done
    derives_eq derives_hashable || derives_ord || = needs_eq
    if derives_clone has_exclusive_borrow && then
        location f"Cannot derive `Clone` for `{location name parser.format_source_name}` because exclusive-borrow fields cannot be cloned"
        common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
        return
    fi

    std::Option[std::String]::None = clone_function
    if derives_clone then
        "clone" receiver make_derived_function_name = function_name
        if
            function_name.as_str parser.store.has_function function_name.as_str parser.store.is_generated_recipe ! &&
        then
            location f"Derived `clone` for `{location name parser.format_source_name}` conflicts with source method `{location function_name.as_str parser.format_source_name}`" common::ErrorKind::DuplicateName parser.state.record_error_string
            return
        fi
        if function_name.as_str parser.store.has_function ! then
            location clone_required_type_vars type_vars receiver parser make_derived_clone_function = function
            function parser.put_generated_function
        fi
        function_name std::Option::Some = clone_function
    fi

    std::Option[std::String]::None = eq_function
    if needs_eq then
        "eq" receiver make_derived_function_name = function_name
        if
            function_name.as_str parser.store.has_function function_name.as_str parser.store.is_generated_recipe ! &&
        then
            location f"Derived `eq` for `{location name parser.format_source_name}` conflicts with source method `{location function_name.as_str parser.format_source_name}`" common::ErrorKind::DuplicateName parser.state.record_error_string
            return
        fi
        if function_name.as_str parser.store.has_function ! then
            location required_type_vars type_vars receiver parser make_derived_eq_function = function
            function parser.put_generated_function
        fi
        function_name std::Option::Some = eq_function
    fi

    std::Option[std::String]::None = hash_function
    if derives_hashable then
        "hash" receiver make_derived_function_name = function_name
        if
            function_name.as_str parser.store.has_function function_name.as_str parser.store.is_generated_recipe ! &&
        then
            location f"Derived `hash` for `{location name parser.format_source_name}` conflicts with source method `{location function_name.as_str parser.format_source_name}`" common::ErrorKind::DuplicateName parser.state.record_error_string
            return
        fi
        if function_name.as_str parser.store.has_function ! then
            location required_type_vars type_vars receiver parser make_derived_hash_function = function
            function parser.put_generated_function
        fi
        function_name std::Option::Some = hash_function
    fi

    std::Option[std::String]::None = cmp_function
    if derives_ord then
        if location parser validate_derived_ordering then
            "cmp" receiver make_derived_function_name = function_name
            if
                function_name.as_str parser.store.has_function function_name.as_str parser.store.is_generated_recipe ! &&
            then
                location f"Derived `cmp` for `{location name parser.format_source_name}` conflicts with source method `{location function_name.as_str parser.format_source_name}`" common::ErrorKind::DuplicateName parser.state.record_error_string
                return
            fi
            if function_name.as_str parser.store.has_function ! then
                location required_type_vars type_vars receiver parser make_derived_cmp_function = function
                function parser.put_generated_function
            fi
            function_name std::Option::Some = cmp_function
        fi
    fi

    if derives_clone then
        std::Map[std::String std::String]::new = methods
        clone_function "clone" methods set_derived_method
        location methods common::STD_CLONE_TRAIT common::STD_CLONE_TRAIT clone_required_type_vars type_vars receiver parser
        install_derived_trait_impl
    fi
    if derives_copy then
        std::Map[std::String std::String]::new = methods
        location methods common::STD_COPY_TRAIT common::STD_COPY_TRAIT clone_required_type_vars type_vars receiver parser
        install_derived_trait_impl
    fi
    if derives_eq then
        std::Map[std::String std::String]::new = methods
        eq_function "eq" methods set_derived_method
        location methods common::STD_EQ_TRAIT common::STD_EQ_TRAIT required_type_vars type_vars receiver parser
        install_derived_trait_impl
    fi
    if derives_ord then
        std::Map[std::String std::String]::new = methods
        eq_function "eq" methods set_derived_method
        cmp_function "cmp" methods set_derived_method
        location methods common::STD_ORD_TRAIT common::STD_ORD_TRAIT required_type_vars type_vars receiver parser
        install_derived_trait_impl
    fi
    if derives_hashable then
        std::Map[std::String std::String]::new = methods
        eq_function "eq" methods set_derived_method
        hash_function "hash" methods set_derived_method
        location methods common::STD_HASHABLE_TRAIT common::STD_HASHABLE_TRAIT required_type_vars type_vars receiver parser
        install_derived_trait_impl
    fi
}

pub fn derive_traits_for_aggregates parser:mut$Parser {
    for
        casa_struct in parser
            .store
            .structs
            .values
            .iter
    do
        std::Set[std::String]::new = required_type_vars
        std::Set[std::String]::new = clone_required_type_vars
        false = has_exclusive_borrow
        for member in casa_struct.members.iter do
            required_type_vars casa_struct.type_vars member.typ add_derived_required_type_vars
            clone_required_type_vars casa_struct.type_vars member.typ add_derived_clone_required_type_vars
            if member.typ does_type_contain_exclusive_borrow then
                true = has_exclusive_borrow
            fi
        done
        casa_struct.location has_exclusive_borrow clone_required_type_vars required_type_vars casa_struct.derived_traits casa_struct.type_vars
        casa_struct.name.as_str parser derive_traits_for_aggregate
    done
    for
        casa_enum in parser
            .store
            .enums
            .values
            .iter
    do
        std::Set[std::String]::new = required_type_vars
        std::Set[std::String]::new = clone_required_type_vars
        false = has_exclusive_borrow
        for pair in casa_enum.variant_types.iter do
            for payload_type in pair.second.iter do
                required_type_vars casa_enum.type_vars payload_type add_derived_required_type_vars
                clone_required_type_vars casa_enum.type_vars payload_type add_derived_clone_required_type_vars
                if payload_type does_type_contain_exclusive_borrow then
                    true = has_exclusive_borrow
                fi
            done
        done
        casa_enum.location has_exclusive_borrow clone_required_type_vars required_type_vars casa_enum.derived_traits casa_enum.type_vars
        casa_enum.name.as_str parser derive_traits_for_aggregate
    done
}

pub fn register_builtin_copy_impls parser:mut$Parser {
    if
        common::STD_COPY_TRAIT parser
            .store
            .traits
            .has_str !
    then
        return
    fi
    parser
        .store
        .builtins
        .clone = builtin_names
    for builtin_name in builtin_names.iter do
        if "str" builtin_name.as_str == "array" builtin_name.as_str == || then
            continue
        fi
        builtin_name.as_str common::parse_type_str = receiver
        if parser.store common::STD_COPY_TRAIT receiver rules::find_satisfying_trait_type.is_some then
            continue
        fi
        common::STD_COPY_TRAIT parser
            .store
            .traits
            .get_str
            .unwrap
            .location
            .clone
        std::Map[std::String std::String]::new
        std::Map[std::String std::List[common::TraitBound]]::new
        std::List[std::String]::new
        std::List[common::Type]::new common::STD_COPY_TRAIT.to_str common::TraitBound
        receiver
        common::TraitImpl
        parser register_trait_impl
    done
}

pub fn create_member_accessor
    parser:mut$Parser
    struct_name:$str
    member_name:$str
    member_type:$common::Type
    prior_members:$std::List[common::Member]
    location:$common::Location
    type_vars:$std::List[std::String]
{
    # Parameterize the struct name when the struct has type vars
    std::List[common::Type]::new struct_name.to_str common::GenericType::with_params common::Type::Generic = param_type
    type_vars common::string_list_to_set = effect_type_vars
    if 0 type_vars.length != then
        type_vars struct_name common::build_parameterized_type = param_type
    fi

    # Getter
    f"{struct_name}::{member_name}" = getter_name
    std::List[common::Op]::new = getter_ops
    common::MemberAccessKind::Read prior_members.length struct_name.to_str common::StructMemberAccess
    common::MemberAccessor getter_name.clone parser
        .store
        .member_accessors
        .set

    std::List[common::Parameter]::new = getter_params
    "".to_str common::SHARED_BORROW_TYPE param_type.clone common::apply_borrow_type common::Parameter::named getter_params.push
    std::List[common::Type]::new = getter_returns
    member_type.clone getter_returns.push
    getter_returns getter_params common::StackEffect::new = getter_stack_effect
    effect_type_vars.clone getter_stack_effect common::StackEffect::set_type_vars
    effect_type_vars getter_stack_effect common::canonicalize_stack_effect_type_vars
    getter_stack_effect location.clone getter_ops getter_name.clone
    FunctionSource::with_stack_effect = getter

    if
        getter_name.as_str parser
            .store
            .get_function
            .is_some
    then
        location f"Function `{location getter_name.as_str parser.format_source_name}` is already defined" common::ErrorKind::DuplicateName parser.state.record_error_string
    fi
    getter getter_name parser.put_function

    # Setter
    f"{struct_name}::set_{member_name}" = setter_name
    std::List[common::Op]::new = setter_ops
    common::MemberAccessKind::Write prior_members.length struct_name.to_str common::StructMemberAccess
    common::MemberAccessor setter_name.clone parser
        .store
        .member_accessors
        .set

    std::List[common::Parameter]::new = setter_params
    "".to_str common::EXCLUSIVE_BORROW_TYPE param_type.clone common::apply_borrow_type common::Parameter::named setter_params.push
    "".to_str member_type.clone common::Parameter::named setter_params.push
    std::List[common::Type]::new = setter_returns
    setter_returns setter_params common::StackEffect::new = setter_stack_effect
    effect_type_vars.clone setter_stack_effect common::StackEffect::set_type_vars
    effect_type_vars setter_stack_effect common::canonicalize_stack_effect_type_vars
    setter_stack_effect location.clone setter_ops setter_name.clone
    FunctionSource::with_stack_effect = setter

    if
        setter_name.as_str parser
            .store
            .get_function
            .is_some
    then
        location f"Function `{location setter_name.as_str parser.format_source_name}` is already defined" common::ErrorKind::DuplicateName parser.state.record_error_string
    fi
    setter setter_name parser.put_function
}

fn construct_struct
    parser:mut$Parser
    declaration:$grammar::DeclarationSyntax
    parsed:$grammar::AggregateSyntax
    resolver:mut$NameResolver
-> common::CasaStruct {
    resolver.type_bindings.length = inherited_bindings
    resolver parsed.parameters parser resolve_generic_parameters = generic_parameters
    generic_parameters.into_parts = constant_parameters = bounds = type_vars
    if 0 bounds.length != then
        declaration.location "Trait bounds are not allowed on struct definitions. Use `impl[K: Bound] StructName[K]` instead" common::ErrorKind::UnexpectedToken parser.state.record_error
    fi
    parser.state resolver parsed.derives resolve_derived_traits = derived_traits
    std::List[common::Member]::new = members
    type_vars common::string_list_to_set = type_variables
    declaration.name.as_str resolver.resolve_name = name
    for member in parsed.members.iter do
        member.name_token resolver.tokens.get = token
        if member.payload std::Option::Some(types) is then
            parser.store parser.state resolver 0 types.get resolve_parsed_type = member_type
            type_variables member_type common::canonicalize_type_var = member_type
            type_vars token.location members member_type token.value.as_str name.as_str parser create_member_accessor
            if member.public then
                f"{name}::{token.value}" = getter_name
                f"{name}::set_{token.value}" = setter_name
                getter_name.as_str parser
                    .store
                    .module_private_symbols
                    .remove_str
                setter_name.as_str parser
                    .store
                    .module_private_symbols
                    .remove_str
                getter_name parser
                    .store
                    .public_symbols
                    .add
                setter_name parser
                    .store
                    .public_symbols
                    .add
            fi
            member_type token.value.clone common::Member members.push
        fi
    done
    declaration.external derived_traits type_vars declaration.location.clone members name common::CasaStruct
    inherited_bindings resolver.restore_type_bindings
}

# Trait parameters retain their identifier-only contract. Bounds belong to impls.
fn resolve_simple_parameters
    parsed:$std::Option[grammar::GenericParametersSyntax]
    resolver:mut$NameResolver
    state:mut$ParseState
    context:str
-> std::List[std::String] {
    std::List[std::String]::new = names
    if parsed std::Option::Some(parameters) is then parameters else names return fi = parameters
    f"Expected type parameter identifier in {context}" = message
    for parameter in parameters.parameters.iter do
        if parameters.separator std::Option::Some(separator) is then
            if parameter.name_token separator > then
                separator resolver
                    .tokens
                    .get
                    .location message.as_str common::ErrorKind::UnexpectedToken state.record_error
                names return
            fi
        fi
        if parameter.constant std::Option::Some(position) is then
            position resolver
                .tokens
                .get
                .location message.as_str common::ErrorKind::UnexpectedToken state.record_error
            names return
        fi
        parameter.name_token resolver
            .tokens
            .get
            .value
            .clone = name
        name.clone resolver.type_bindings.push
        name names.push
        if 0 parameter.bounds.length != then
            # Source construction tokens omit trivia, so the colon follows the name.
            parameter.name_token 1 + resolver
                .tokens
                .get
                .location message.as_str common::ErrorKind::UnexpectedToken state.record_error
            names return
        fi
    done
    if parameters.separator std::Option::Some(separator) is then
        separator resolver
            .tokens
            .get
            .location message.as_str common::ErrorKind::UnexpectedToken state.record_error
    fi
    names
}

# An unnamed parameter is a type. Its leaf must name one.
fn resolve_signature
    signature:$grammar::SignatureSyntax
    resolver:$NameResolver
    state:mut$ParseState
    store:$common::SymbolStore
    unexpected_parameter:$str
-> common::StackEffect {
    std::List[common::Parameter]::new = parameters
    for parsed in signature.parameters.iter do
        parsed.typ.token resolver.tokens.get = type_token
        if
            parsed.name_token.is_none common::TokenKind::Identifier type_token.kind != && "fn" type_token.value.as_str != &&
        then
            type_token.location unexpected_parameter common::ErrorKind::UnexpectedToken state.record_error
        fi
        store state resolver parsed.typ resolve_parsed_type = typ
        "".to_str typ common::Parameter::named = parameter
        if parsed.name_token std::Option::Some(position) is then
            position resolver.tokens.get = token
            token.value.clone = parameter.name
            token.location.clone std::Option::Some = parameter.location
        fi
        parameter parameters.push
    done
    std::List[common::Type]::new = returns
    for parsed in signature.returns.iter do
        store state resolver parsed resolve_parsed_type returns.push
    done
    returns parameters common::StackEffect::new
}

fn construct_trait
    parser:mut$Parser
    declaration:$grammar::DeclarationSyntax
    parsed:$grammar::TraitSyntax
    resolver:mut$NameResolver
-> common::CasaTrait {
    resolver.type_bindings.length = inherited_bindings
    "trait" parser.state resolver parsed.parameters resolve_simple_parameters = type_params
    std::List[common::TraitBound]::new = supertraits
    for parsed_bound in parsed.supertraits.iter do
        parser.store parser.state resolver parsed_bound resolve_parsed_bound = bound
        if
            bound.name parser
                .store
                .traits
                .get std::Option::Some(supertrait) is
        then
            if bound.type_args.length supertrait.type_params.length != then
                parsed_bound.token resolver.tokens.get = token
                supertrait.type_params.length = expected
                bound.type_args.length = actual
                token.location f"Supertrait `{token.value}` expects {expected} type argument(s), got {actual}" common::ErrorKind::Syntax parser.state.record_error_string
            fi
        fi
        bound supertraits.push
    done
    std::List[common::TraitMethod]::new = methods
    for method in parsed.methods.iter do
        # Trait methods take no modifiers. The first one is diagnosed.
        if method.public_token std::Option::Some(position) is then
            position resolver
                .tokens
                .get
                .location "Expected method declaration in trait" common::ErrorKind::UnexpectedToken parser.state.record_error
        elif method.unsafe_token std::Option::Some(position) is then
            position resolver
                .tokens
                .get
                .location "Expected method declaration in trait" common::ErrorKind::UnexpectedToken parser.state.record_error
        fi
        method.function = function: $grammar::FunctionSyntax
        function.name_token resolver
            .tokens
            .get
            .clone = name_token
        if "drop" name_token.value.as_str == then
            name_token.location "`drop` is reserved for inherent cleanup methods" common::ErrorKind::InvalidScope parser.state.record_error
        fi
        resolver.type_bindings.length = inherited_method_bindings
        "trait method" parser.state resolver function.parameters resolve_simple_parameters = method_type_vars
        "Unexpected token in trait method parameter list" parser.store parser.state resolver function.signature resolve_signature = effect
        type_params common::string_list_to_set = type_variables
        common::TRAIT_SELF_TYPE type_variables.add_str
        for variable in method_type_vars.iter do
            variable.clone type_variables.add
        done
        type_variables effect common::canonicalize_stack_effect_type_vars
        std::Option[std::String]::None = default_function
        if function.body std::Option::Some(body) is then
            type_params type_variables effect body name_token declaration resolver parser parse_default_method = default_function
        fi
        inherited_method_bindings resolver.restore_type_bindings
        name_token.location.clone default_function method_type_vars effect name_token.value.clone common::TraitMethod methods.push
    done
    declaration.name.as_str resolver.resolve_name = name
    declaration.location.clone supertraits methods type_params name common::CasaTrait
    inherited_bindings resolver.restore_type_bindings
}

fn parse_default_method
    parser:mut$Parser
    resolver:mut$NameResolver
    declaration:$grammar::DeclarationSyntax
    method_token:$common::Token
    body:$grammar::BlockSyntax
    effect:$common::StackEffect
    type_vars:$std::Set[std::String]
    type_parameters:$std::List[std::String]
-> std::Option[std::String] {
    declaration.name.as_str resolver.resolve_name = trait_name
    f"{trait_name}::{method_token.value}" = default_name
    std::List[common::Op]::new = operations
    operations default_name.as_str body.terms resolver parser.lower_terms
    type_vars operations common::canonicalize_operation_type_vars
    effect.clone = default_effect
    type_vars.clone = default_effect.type_vars
    std::List[common::Type]::new = arguments
    for parameter in type_parameters.iter do
        parameter.clone common::Type::TypeVar arguments.push
    done
    std::List[common::TraitBound]::new = bounds
    arguments trait_name common::TraitBound bounds.push
    bounds common::TRAIT_SELF_TYPE.to_str default_effect.trait_bounds.set
    f"default:{default_name}" = recipe_name
    default_effect operations recipe_name.clone make_default_method_function = recipe
    method_token.location.clone = recipe.declaration.location
    recipe parser.put_generated_function
    recipe_name std::Option::Some
}

fn make_default_method_function
    name:std::String
    operations:std::List[common::Op]
    effect:common::StackEffect
-> FunctionSource {
    std::List[common::Op]::new = function_operations
    std::List[common::Variable]::new = variables
    for parameter in effect.parameters.iter do
        if "" parameter.name.as_str == then
            continue
        fi
        parameter.typ.clone parameter.name.clone common::Variable variables.push
        common::empty_location parameter.name.clone common::OpValue::AssignVar common::Op::new
        function_operations.push
    done
    operations function_operations.append
    effect common::empty_location function_operations name FunctionSource::with_stack_effect = function
    variables = function.declaration.variables
    function
}

pub fn inject_implementation_parameters
    parser:mut$Parser
    function:mut$FunctionSource
    type_vars:$std::List[std::String]
    generic_params:$std::List[std::String]
    trait_bounds:$std::Map[std::String std::List[common::TraitBound]]
    constant_parameters:$std::Map[std::String common::BuiltinType]
{
    function
        .declaration
        .stack_effect
        .clone = effect
    std::List[std::String]::new = combined_generic_params
    for parameter_name in generic_params.iter do
        parameter_name.clone combined_generic_params.push
    done
    for
        parameter_name in function
            .declaration
            .generic_params
            .iter
    do
        parameter_name.clone combined_generic_params.push
    done
    combined_generic_params function.declaration common::Function::set_generic_params

    # Merge the impl block's constant parameters (ADR-0152) and rewrite the
    # method declaration and body so their names read as constants, not type
    # variables.
    if 0 constant_parameters.length != then
        constant_parameters effect rewrite_stack_effect_constant_parameters
        constant_parameters function.operations rewrite_operation_constant_parameters
        0 = variable_index: u64
        while
            variable_index function
                .declaration
                .variables
                .length <
        do
            variable_index function
                .declaration
                .variables
                .get_mut = variable
            constant_parameters variable.typ rules::rewrite_type_const_params = rewritten_variable_type
            rewritten_variable_type variable common::Variable::set_typ
            1 += variable_index
        done
        for constant_pair in constant_parameters.iter do
            constant_pair.second.clone constant_pair.first.clone effect.const_params.set
        done
    fi

    # Merge type vars into function stack effect
    for type_var in type_vars.iter do
        if type_var effect.type_vars.has ! then
            type_var.clone effect.type_vars.add
        fi
    done
    effect.type_vars.clone = active_impl_type_vars
    active_impl_type_vars effect common::canonicalize_stack_effect_type_vars
    active_impl_type_vars function.operations common::canonicalize_operation_type_vars
    0 = variable_index: u64
    while
        variable_index function
            .declaration
            .variables
            .length <
    do
        variable_index function
            .declaration
            .variables
            .get
            .clone = variable
        active_impl_type_vars variable.typ common::canonicalize_type_var = variable_type
        variable_type variable common::Variable::set_typ
        variable variable_index function
            .declaration
            .variables
            .set
        1 += variable_index
    done

    # Merge trait bounds
    trait_bounds.keys = bound_keys
    for bound_key in bound_keys.iter do
        if bound_key trait_bounds.get std::Option::Some(bounds) is then
            bounds.clone bound_key.clone effect.trait_bounds.set
        fi
    done

    0 = insert_pos: u64
    # Register the implementation's symbolic constant parameters.
    function
        .declaration
        .location
        .clone function.declaration.variables effect inject_constant_parameters = constant_assignments
    while 0 constant_assignments.length != do
        constant_assignments.pop = assignment
        insert_pos assignment function.operations.insert
    done

    effect function.declaration common::Function::set_stack_effect
}

pub fn namespace_trait_impl_type
    typ:$common::Type
    type_vars:$std::List[std::String]
    prefix:str
-> common::Type {
    std::Map[std::String common::Type]::new = substitutions
    for type_variable in type_vars.iter do
        f"{prefix}{type_variable}" common::Type::TypeVar type_variable.clone substitutions.set
    done
    substitutions typ.substitute
}

pub fn resolve_overlap_type
    typ:$common::Type
    bindings:$std::Map[std::String common::Type]
-> common::Type {
    if typ common::Type::TypeVar(type_variable) is then
        if type_variable bindings.get std::Option::Some(bound) is then
            bindings bound resolve_overlap_type return
        fi
    fi
    typ.clone
}

pub fn overlap_type_contains
    type_variable:$str
    typ:$common::Type
    bindings:mut$std::Map[std::String common::Type]
-> bool {
    bindings typ resolve_overlap_type = resolved
    if resolved.clone common::Type::TypeVar(name) is then
        type_variable name.as_str == return
    fi
    if resolved common::Type::Generic(generic) is then
        for parameter in generic.params.iter do
            if bindings parameter type_variable overlap_type_contains then
                true return
            fi
        done
    elif resolved common::Type::Function(function_type) is then
        for parameter in function_type.parameters.iter do
            if bindings parameter type_variable overlap_type_contains then
                true return
            fi
        done
        for return_type in function_type.return_types.iter do
            if bindings return_type type_variable overlap_type_contains then
                true return
            fi
        done
    fi
    false
}

pub fn bind_overlap_type
    type_variable:$str
    typ:$common::Type
    bindings:mut$std::Map[std::String common::Type]
-> bool {
    bindings typ resolve_overlap_type = resolved
    if resolved.clone common::Type::TypeVar(name) is then
        if type_variable name.as_str == then
            true return
        fi
    fi
    if bindings resolved type_variable overlap_type_contains then
        false return
    fi
    resolved type_variable.clone bindings.set_str
    true
}

pub fn unify_trait_impl_types
    first:$common::Type
    second:common::Type
    bindings:mut$std::Map[std::String common::Type]
-> bool {
    bindings first resolve_overlap_type = resolved_first
    bindings second resolve_overlap_type = resolved_second
    if resolved_first common::Type::TypeVar(first_variable) is then
        bindings resolved_second first_variable.as_str bind_overlap_type return
    fi
    if resolved_second common::Type::TypeVar(second_variable) is then
        bindings resolved_first second_variable.as_str bind_overlap_type return
    fi
    if resolved_first common::Type::Generic(first_generic) is then
        if resolved_second common::Type::Generic(second_generic) is then
            if first_generic.base second_generic.base != then
                false return
            fi
            if first_generic.params.length second_generic.params.length != then
                false return
            fi
            for
                pair in second_generic.params.iter first_generic
                    .params
                    .list_iter
                    .zip
            do
                if bindings pair.first.clone pair.second.clone unify_trait_impl_types ! then
                    false return
                fi
            done
            true return
        fi
        false return
    fi
    if resolved_first common::Type::Function(first_function) is then
        if resolved_second common::Type::Function(second_function) is then
            if first_function.parameters.length second_function.parameters.length != then
                false return
            fi
            if first_function.return_types.length second_function.return_types.length != then
                false return
            fi
            for
                pair in second_function.parameters.iter first_function
                    .parameters
                    .list_iter
                    .zip
            do
                if bindings pair.first.clone pair.second.clone unify_trait_impl_types ! then
                    false return
                fi
            done
            for
                pair in second_function.return_types.iter first_function
                    .return_types
                    .list_iter
                    .zip
            do
                if bindings pair.first.clone pair.second.clone unify_trait_impl_types ! then
                    false return
                fi
            done
            true return
        fi
        false return
    fi
    resolved_first resolved_second.eq
}

pub fn trait_impls_overlap first:$common::TraitImpl second:$common::TraitImpl -> bool {
    if first.trait_bound.name second.trait_bound.name != then
        false return
    fi
    if
        first
            .trait_bound
            .type_args
            .length second
            .trait_bound
            .type_args
            .length !=
    then
        false return
    fi
    "left:" first.type_vars first.receiver namespace_trait_impl_type = first_receiver
    "right:" second.type_vars second.receiver namespace_trait_impl_type = second_receiver
    std::Map[std::String common::Type]::new = bindings
    if bindings second_receiver first_receiver unify_trait_impl_types ! then
        false return
    fi
    for
        pair in second
            .trait_bound
            .type_args
            .iter first
            .trait_bound
            .type_args
            .list_iter
            .zip
    do
        "left:" first.type_vars pair.second namespace_trait_impl_type = first_argument
        "right:" second.type_vars pair.first namespace_trait_impl_type = second_argument
        if bindings second_argument first_argument unify_trait_impl_types ! then
            false return
        fi
    done
    true
}

pub fn receiver_is_local
    receiver:$common::Type
    location:$common::Location
    store:mut$common::SymbolStore
-> bool {
    receiver.match_base = receiver_name
    if receiver_name store.structs.get std::Option::Some(casa_struct) is then
        casa_struct.location.file location.file == return
    fi
    if receiver_name store.enums.get std::Option::Some(casa_enum) is then
        casa_enum.location.file location.file == return
    fi
    false
}

pub fn register_trait_impl parser:mut$Parser trait_impl:common::TraitImpl {
    for
        existing in trait_impl
            .trait_bound
            .name
            .as_str trait_impl.receiver parser
            .store
            .get_trait_impl_candidates_for_receiver_and_trait
    do
        if trait_impl existing trait_impls_overlap then
            trait_impl.location f"Trait implementation `{trait_impl parser.format_source_trait_impl}` overlaps an existing implementation in `{existing.location.file}`" common::ErrorKind::DuplicateName parser.state.record_error_string
            return
        fi
    done
    trait_impl parser.put_trait_impl
}

pub fn normalize_trait_method_effect candidate:$rules::TraitMethodCandidate -> common::StackEffect {
    std::Map[std::String common::Type]::new = substitutions
    0 = index: u64
    for
        type_variable in candidate
            .method
            .type_vars
            .iter
    do
        f"method_type_{index}" common::Type::TypeVar type_variable.clone substitutions.set
        1 += index
    done
    substitutions candidate.effect common::apply_type_subs_to_stack_effect
}

pub fn validate_trait_method_compatibility parser:mut$Parser casa_trait:$common::CasaTrait -> bool {
    casa_trait rules::trait_definition_type = trait_type
    trait_type parser.store rules::collect_trait_method_candidates = candidates
    for first_index in candidates.length 0 std::Range::new do
        first_index candidates.get = first
        first normalize_trait_method_effect = first_effect
        first_index 1 + = second_index
        while second_index candidates.length < do
            second_index candidates.get = second
            if first.method.name second.method.name == then
                second normalize_trait_method_effect = second_effect
                if first_effect second_effect stack_effect_shapes_equal ! then
                    casa_trait.location f"Trait `{casa_trait.location casa_trait.name.as_str parser.format_source_name}` inherits incompatible `{first.method.name}` methods from `{casa_trait.location first.trait_type parser.format_source_type}` and `{casa_trait.location second.trait_type parser.format_source_type}`" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                    false return
                fi
            fi
            1 += second_index
        done
    done
    true
}

enum LanguageTraitMethod {
    Cloning
    Comparison
    Formatting
    Hashing
    Iteration
    Operator
    PartialComparison
    Unrecognized
}

fn classify_language_trait_method trait_name:$str method_name:$str -> LanguageTraitMethod {
    if
        common::STD_PARTIAL_EQ_TRAIT trait_name.as_str ==
        common::STD_EQ_TRAIT trait_name.as_str == ||
        common::STD_PARTIAL_ORD_TRAIT trait_name.as_str == ||
        common::STD_ORD_TRAIT trait_name.as_str == ||
    then
        if "eq" method_name.as_str == "ne" method_name.as_str == || then
            LanguageTraitMethod::Operator return
        fi
    fi
    if
        common::STD_PARTIAL_ORD_TRAIT trait_name.as_str ==
        common::STD_ORD_TRAIT trait_name.as_str == ||
    then
        if
            "lt" method_name.as_str == "le" method_name.as_str == ||
            "gt" method_name.as_str == || "ge" method_name.as_str == ||
        then
            LanguageTraitMethod::Operator return
        fi
        if "partial_cmp" method_name.as_str == then
            LanguageTraitMethod::PartialComparison return
        fi
    fi
    if common::STD_ORD_TRAIT trait_name.as_str == "cmp" method_name.as_str == && then
        LanguageTraitMethod::Comparison return
    fi
    if common::STD_HASHABLE_TRAIT trait_name.as_str == then
        if "hash" method_name.as_str == then
            LanguageTraitMethod::Hashing return
        fi
    elif common::STD_DISPLAY_TRAIT trait_name.as_str == "to_str" method_name.as_str == && then
        LanguageTraitMethod::Formatting return
    elif common::STD_ITERABLE_TRAIT trait_name.as_str == "next" method_name.as_str == && then
        LanguageTraitMethod::Iteration return
    elif common::STD_CLONE_TRAIT trait_name.as_str == "clone" method_name.as_str == && then
        LanguageTraitMethod::Cloning return
    fi
    LanguageTraitMethod::Unrecognized
}

impl LanguageTraitMethod {
    fn matches
        self:$LanguageTraitMethod
        candidate:$rules::TraitMethodCandidate
        casa_trait:$common::CasaTrait
    -> bool {
        candidate.effect = effect: $common::StackEffect
        self match
            LanguageTraitMethod::Operator | LanguageTraitMethod::PartialComparison | LanguageTraitMethod::Comparison => 2
            _ => 1
        end = parameter_count: u64
        if effect.parameters.length parameter_count != effect.return_types.length 1 != || then
            false return
        fi
        for parameter in effect.parameters.iter do
            if parameter.typ.borrow_target std::Option::Some(target) is then
                target.is_self_type
            else
                parameter.typ.is_self_type
            fi = is_self_parameter
            if is_self_parameter ! then
                false return
            fi
        done
        0 effect.return_types.get = result_type: $common::Type
        self match
            LanguageTraitMethod::Operator => result_type common::make_bool_type.eq
            LanguageTraitMethod::Hashing => result_type common::make_i64_type.eq
            LanguageTraitMethod::Formatting => result_type common::make_string_type.eq
            LanguageTraitMethod::Cloning => result_type.is_self_type
            LanguageTraitMethod::Comparison | LanguageTraitMethod::PartialComparison => {
                common::STD_ORDERING_TYPE.to_str common::GenericType::new common::Type::Generic = ordering_type
                if self LanguageTraitMethod::Comparison is then
                    result_type ordering_type.eq return
                fi
                std::List[common::Type]::new = option_args
                ordering_type option_args.push
                option_args common::STD_OPTION_TYPE.to_str common::GenericType::with_params common::Type::Generic = expected
                result_type expected.eq
            }
            LanguageTraitMethod::Iteration => {
                if casa_trait.type_params.length 1 != then
                    false return
                fi
                std::List[common::Type]::new = option_args
                0 casa_trait
                    .type_params
                    .get
                    .clone common::Type::TypeVar option_args.push
                option_args common::STD_OPTION_TYPE.to_str common::GenericType::with_params common::Type::Generic = expected
                result_type expected.eq
            }
            LanguageTraitMethod::Unrecognized => false
        end
    }

    fn role self:$LanguageTraitMethod -> str {
        self match
            LanguageTraitMethod::Operator => "operator method"
            LanguageTraitMethod::Hashing => "hashing method"
            LanguageTraitMethod::Formatting => "formatting method"
            LanguageTraitMethod::Cloning => "cloning method"
            LanguageTraitMethod::Comparison | LanguageTraitMethod::PartialComparison => "comparison method"
            LanguageTraitMethod::Iteration | LanguageTraitMethod::Unrecognized => "trait method"
        end
    }
}

pub fn validate_language_trait_contract parser:mut$Parser casa_trait:$common::CasaTrait -> bool {
    casa_trait.name.clone = trait_name
    if
        common::STD_PARTIAL_EQ_TRAIT trait_name.as_str !=
        common::STD_EQ_TRAIT trait_name.as_str != &&
        common::STD_PARTIAL_ORD_TRAIT trait_name.as_str != &&
        common::STD_ORD_TRAIT trait_name.as_str != &&
        common::STD_HASHABLE_TRAIT trait_name.as_str != &&
        common::STD_DISPLAY_TRAIT trait_name.as_str != &&
        common::STD_ITERABLE_TRAIT trait_name.as_str != &&
        common::STD_COPY_TRAIT trait_name.as_str != &&
        common::STD_CLONE_TRAIT trait_name.as_str != &&
    then
        true return
    fi
    if common::STD_ITERABLE_TRAIT trait_name.as_str == then
        if 1 casa_trait.type_params.length != then
            casa_trait.location "Language trait `Iterable` expects one type parameter" common::ErrorKind::TraitSignatureMismatch parser.state.record_error
            false return
        fi
    elif 0 casa_trait.type_params.length != then
        casa_trait.location f"Language trait `{casa_trait.location trait_name.as_str parser.format_source_name}` expects no type parameters" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
        false return
    fi
    if common::STD_COPY_TRAIT trait_name.as_str == then
        if 0 casa_trait.methods.length == then
            true return
        fi
        casa_trait.location "Language trait `Copy` must not declare methods" common::ErrorKind::TraitSignatureMismatch parser.state.record_error
        false return
    fi
    casa_trait rules::trait_definition_type = trait_type
    trait_type parser.store rules::collect_trait_method_candidates = candidates
    std::List[std::String]::new = required
    if
        common::STD_PARTIAL_EQ_TRAIT trait_name.as_str ==
        common::STD_EQ_TRAIT trait_name.as_str == ||
    then
        "eq".to_str required.push "ne".to_str required.push
    elif
        common::STD_PARTIAL_ORD_TRAIT trait_name.as_str ==
        common::STD_ORD_TRAIT trait_name.as_str == ||
    then
        "eq".to_str required.push "ne".to_str required.push
        "partial_cmp".to_str required.push
        "lt".to_str required.push "le".to_str required.push
        "gt".to_str required.push "ge".to_str required.push
        if common::STD_ORD_TRAIT trait_name.as_str == then
            "cmp".to_str required.push
        fi
    elif common::STD_HASHABLE_TRAIT trait_name.as_str == then
        "hash".to_str required.push
    elif common::STD_DISPLAY_TRAIT trait_name.as_str == then
        "to_str".to_str required.push
    elif common::STD_ITERABLE_TRAIT trait_name.as_str == then
        "next".to_str required.push
    else
        "clone".to_str required.push
    fi
    true = valid
    for required_name in required.iter do
        false = found
        for candidate in candidates.iter do
            if required_name candidate.method.name != then
                continue
            fi
            true = found
            required_name.as_str trait_name.as_str classify_language_trait_method = method_kind
            method_kind.role = method_role
            if casa_trait candidate method_kind.matches ! then
                casa_trait.location f"Language trait `{casa_trait.location trait_name.as_str parser.format_source_name}` has incompatible `{required_name}` {method_role}" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                false = valid
            fi
        done
        if found ! then
            required_name.as_str trait_name.as_str classify_language_trait_method.role = method_role
            casa_trait.location f"Language trait `{casa_trait.location trait_name.as_str parser.format_source_name}` is missing required `{required_name}` {method_role}" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
            false = valid
        fi
    done
    for candidate in candidates.iter do
        if candidate.method.has_default_body then
            continue
        fi
        if candidate.trait_type trait_type.eq ! then
            continue
        fi
        candidate
            .method
            .name
            .as_str trait_name.as_str classify_language_trait_method = method_kind
        if method_kind LanguageTraitMethod::Unrecognized is then
            casa_trait.location f"Language trait `{casa_trait.location trait_name.as_str parser.format_source_name}` cannot add bodyless `{candidate.method.name}` requirement" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
            false = valid
        fi
    done
    valid
}

pub fn validate_trait_visit
    parser:mut$Parser
    trait_name:$str
    path:mut$std::List[std::String]
    visiting:mut$std::Set[std::String]
    checked:mut$std::Set[std::String]
    valid:mut$std::List[bool]
{
    if trait_name checked.has_str then
        return
    fi
    if trait_name visiting.has_str then
        trait_name path common::string_list_index.unwrap = cycle_start
        trait_name parser
            .store
            .traits
            .get_str
            .unwrap
            .location
            .clone = location
        std::List[std::String]::new = cycle
        cycle_start path.iter.skip = cycle_items
        for item in cycle_items do
            location item.as_str parser.format_source_name cycle.push
        done
        location trait_name parser.format_source_name cycle.push
        " -> " cycle.join_strings = cycle_path
        location f"Trait inheritance cycle: {cycle_path}"
        common::ErrorKind::TraitSignatureMismatch
        parser.state.record_error_string
        false 0 valid.set
        return
    fi
    if
        trait_name parser
            .store
            .traits
            .has_str !
    then
        return
    fi
    trait_name.clone visiting.add_str
    trait_name.clone path.push_str
    trait_name parser
        .store
        .traits
        .get_str
        .unwrap
        .clone = casa_trait
    casa_trait.location.clone = trait_location
    casa_trait.supertraits.clone = supertraits
    std::List[common::TraitBound]::new = acyclic
    for supertrait in supertraits.iter do
        # Analysis continues after the diagnostic. Without the closing edge, later
        # supertrait traversals terminate.
        if supertrait.name.as_str visiting.has_str then
            valid checked visiting path supertrait.name.as_str parser validate_trait_visit
            continue
        fi
        supertrait.clone acyclic.push
        if
            supertrait.name.as_str parser.store.count_trait_type_parameters std::Option::Some(parameter_count) is
        else
            trait_location f"Supertrait `{trait_location supertrait.name.as_str parser.format_source_name}` is not defined" common::ErrorKind::UndefinedName parser.state.record_error_string
            false 0 valid.set
            continue
        fi
        if supertrait.type_args.length parameter_count != then
            trait_location f"Supertrait `{trait_location supertrait.name.as_str parser.format_source_name}` expects {parameter_count} type argument(s), got {supertrait.type_args.length}" common::ErrorKind::Syntax parser.state.record_error_string
            false 0 valid.set
            continue
        fi
        valid checked visiting path supertrait.name.as_str parser validate_trait_visit
    done
    if acyclic.length supertraits.length != then
        if
            trait_name parser
                .store
                .traits
                .get_mut_str std::Option::Some(stored) is
        then
            acyclic = stored.supertraits
        fi
    fi
    path.pop drop
    trait_name visiting.remove_str
    trait_name.clone checked.add_str
}

pub fn validate_traits parser:mut$Parser -> bool {
    std::Set[std::String]::new = checked
    std::Set[std::String]::new = visiting
    std::List[std::String]::new = path
    std::List[bool]::new = valid
    true valid.push
    for
        trait_name in parser
            .store
            .traits
            .keys
            .iter
    do
        valid checked visiting path trait_name.as_str parser validate_trait_visit
    done
    if 0 valid.get ! then
        false return
    fi
    for
        casa_trait in parser
            .store
            .traits
            .values
            .iter
    do
        if casa_trait parser validate_trait_method_compatibility ! then
            false 0 valid.set
        fi
        if casa_trait parser validate_language_trait_contract ! then
            false 0 valid.set
        fi
    done
    0 valid.get copy
}

pub fn type_is_known_inhabited
    typ:$common::Type
    store:$common::SymbolStore
    inhabited:$std::Set[std::String]
-> bool {
    if typ.borrow_target std::Option::Some(target) is then
        inhabited store target type_is_known_inhabited return
    fi
    typ match
        common::Type::Generic(generic) => {
            if common::ARRAY_TYPE generic.base.as_str == then
                if typ common::get_concrete_array_length std::Option::Some(length) is then
                    if 0 length == then
                        true return
                    fi
                fi
                if 0 generic.params.length == then
                    false return
                fi
                inhabited store 0 generic.params.get type_is_known_inhabited
            elif generic.base store.structs.has generic.base store.enums.has || then
                generic.base inhabited.has
            else
                true
            fi
        }
        common::Type::Unknown => true
        common::Type::TypeVar(_) => true
        common::Type::Builtin(_) => true
        common::Type::Function(_) => true
        common::Type::Const(_) => true
    end
}

pub fn validate_inhabited_aggregates parser:mut$Parser {
    std::Set[std::String]::new = inhabited
    true = changed
    while changed do
        false = changed
        for
            entry in parser
                .store
                .structs
                .iter
        do
            entry.second = casa_struct
            if casa_struct.name inhabited.has then
                continue
            fi
            true = fields_inhabited
            for member in casa_struct.members.iter do
                if inhabited parser.store member.typ type_is_known_inhabited ! then
                    false = fields_inhabited
                    break
                fi
            done
            if fields_inhabited then
                casa_struct.name.clone inhabited.add
                true = changed
            fi
        done
        for
            entry in parser
                .store
                .enums
                .iter
        do
            entry.second = casa_enum
            if casa_enum.name inhabited.has then
                continue
            fi
            false = enum_inhabited
            for pair in casa_enum.variant_types.iter do
                true = variant_inhabited
                for payload_type in pair.second.iter do
                    if inhabited parser.store payload_type type_is_known_inhabited ! then
                        false = variant_inhabited
                        break
                    fi
                done
                if variant_inhabited then
                    true = enum_inhabited
                    break
                fi
            done
            if enum_inhabited then
                casa_enum.name.clone inhabited.add
                true = changed
            fi
        done
    done

    for
        entry in parser
            .store
            .structs
            .iter
    do
        entry.second = casa_struct
        if casa_struct.name inhabited.has ! then
            casa_struct.location
            f"Type `{casa_struct.location casa_struct.name.as_str parser.format_source_name}` has no finite safe value; add `Option` or an enum leaf variant"
            common::ErrorKind::TypeMismatch parser.state.record_error_string
        fi
    done
    for
        entry in parser
            .store
            .enums
            .iter
    do
        entry.second = casa_enum
        if casa_enum.name inhabited.has ! then
            casa_enum.location
            f"Type `{casa_enum.location casa_enum.name.as_str parser.format_source_name}` has no finite safe value; add an enum leaf variant"
            common::ErrorKind::TypeMismatch parser.state.record_error_string
        fi
    done
}

# Map generic parameters to arguments. None means a parameter count mismatch.
fn bind_type_arguments
    arguments:$std::List[common::Type]
    type_vars:$std::List[std::String]
-> std::Option[std::Map[std::String common::Type]] {
    if arguments.length type_vars.length != then
        std::Option[std::Map[std::String common::Type]]::None return
    fi
    std::Map[std::String common::Type]::new = substitutions
    for pair in arguments.iter type_vars.list_iter.zip do
        pair.second.clone pair.first.clone substitutions.set
    done
    substitutions std::Option::Some
}

fn copy_struct_is_eligible
    casa_struct:$common::CasaStruct
    generic:$common::GenericType
    trait_bounds:$std::Map[std::String std::List[common::TraitBound]]
    store:$common::SymbolStore
    visiting:mut$std::Set[std::String]
-> bool {
    if casa_struct.type_vars generic.params bind_type_arguments std::Option::Some(substitutions) is else
        false return
    fi
    generic.base.clone visiting.add
    for member in casa_struct.members.iter do
        substitutions member.typ.substitute = member_type
        if visiting store trait_bounds member_type copy_field_is_eligible ! then
            generic.base visiting.remove
            false return
        fi
    done
    generic.base visiting.remove
    true
}

fn copy_enum_is_eligible
    casa_enum:$common::CasaEnum
    generic:$common::GenericType
    trait_bounds:$std::Map[std::String std::List[common::TraitBound]]
    store:$common::SymbolStore
    visiting:mut$std::Set[std::String]
-> bool {
    if casa_enum.type_vars generic.params bind_type_arguments std::Option::Some(substitutions) is else
        false return
    fi
    generic.base.clone visiting.add
    for pair in casa_enum.variant_types.iter do
        for payload_type in pair.second.iter do
            substitutions payload_type.substitute = resolved_payload
            if visiting store trait_bounds resolved_payload copy_field_is_eligible ! then
                generic.base visiting.remove
                false return
            fi
        done
    done
    generic.base visiting.remove
    true
}

pub fn copy_representation_is_eligible
    typ:$common::Type
    trait_bounds:$std::Map[std::String std::List[common::TraitBound]]
    store:$common::SymbolStore
    visiting:mut$std::Set[std::String]
-> bool {
    if typ.is_shared_borrow then
        true return
    fi
    if typ.is_exclusive_borrow then
        false return
    fi
    if typ common::Type::Builtin(common::BuiltinType::Str) is then
        true return
    fi
    if typ common::Type::Generic(generic) is then
        if common::ARRAY_TYPE generic.base.as_str == then
            if 2 generic.params.length != then
                false return
            fi
            visiting store trait_bounds 0 generic.params.get copy_field_is_eligible return
        fi
    fi
    typ match
        common::Type::Builtin(builtin) => {
            builtin common::BuiltinType::Str !=
        }
        common::Type::Function(_) => {
            false
        }
        common::Type::Unknown => {
            false
        }
        common::Type::Const(_) => {
            false
        }
        common::Type::TypeVar(type_variable) => {
            if type_variable trait_bounds.get std::Option::Some(bounds) is then
                common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
                for bound in bounds.iter do
                    if store copy_type bound.to_type rules::trait_type_implies then
                        true return
                    fi
                done
            fi
            false
        }
        common::Type::Generic(generic) => {
            if store typ common::find_drop_function_name.is_some then
                false return
            fi
            if store typ.has_copy_layout then
                true return
            fi
            if generic.base visiting.has then
                false return
            fi
            if generic.base store.structs.get std::Option::Some(casa_struct) is then
                visiting store trait_bounds generic casa_struct copy_struct_is_eligible return
            fi
            if generic.base store.enums.get std::Option::Some(casa_enum) is then
                visiting store trait_bounds generic casa_enum copy_enum_is_eligible return
            fi
            false
        }
    end
}

pub fn copy_field_is_eligible
    typ:$common::Type
    trait_bounds:$std::Map[std::String std::List[common::TraitBound]]
    store:$common::SymbolStore
    visiting:mut$std::Set[std::String]
-> bool {
    if typ common::Type::Generic(generic) is then
        if
            generic.base store.structs.has generic.base store.enums.has ||
            common::ARRAY_TYPE generic.base.as_str == ||
        then
            common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
            if store trait_bounds copy_type typ rules::type_has_satisfying_trait_impl_with_bounds ! then
                false return
            fi
        fi
    fi
    visiting store trait_bounds typ copy_representation_is_eligible
}

pub fn validate_drop_methods parser:mut$Parser {
    parser.store.get_function_names = function_names
    for function_name in function_names.iter do
        if
            "drop" function_name.as_str !=
            function_name.as_str "::drop" str::ends_with ! &&
        then
            continue
        fi
        function_name.as_str parser
            .store
            .get_function
            .unwrap = function: $common::Function
        if "drop" function_name.as_str == then
            function.location "`drop` must be declared in an inherent implementation" common::ErrorKind::InvalidScope parser.state.record_error
            continue
        fi
        function_name.as_str "::" str::split.unwrap = name_parts
        if 2 name_parts.length != then
            continue
        fi
        if "drop" 1 name_parts.get.as_str != then
            continue
        fi
        function.stack_effect.clone = effect
        function.location.clone = function_location
        false = valid
        if 1 effect.parameters.length == 0 effect.return_types.length == && then
            0 effect.parameters.get = receiver
            if "self" receiver.name.as_str == receiver.typ.is_exclusive_borrow && then
                if receiver.typ.borrow_target std::Option::Some(target) is then
                    target implementation_receiver_name = receiver_name
                    if 0 name_parts.get receiver_name.as_str == then
                        true = valid
                    fi
                fi
            fi
        fi
        if valid ! then
            function_location "Reserved `drop` method must have stack effect `self:mut$self -> None`" common::ErrorKind::SignatureMismatch parser.state.record_error
            continue
        fi
        0 effect
            .parameters
            .get
            .typ
            .borrow_target
            .unwrap = receiver_type
        false = receiver_is_copy
        if receiver_type common::Type::Builtin(builtin) is then
            true = receiver_is_copy
        fi
        common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
        if parser.store copy_type receiver_type rules::type_has_satisfying_trait_impl then
            true = receiver_is_copy
        fi
        if receiver_is_copy then
            function_location "A `Copy` type cannot define a reserved `drop` method" common::ErrorKind::TraitSignatureMismatch parser.state.record_error
        fi
    done
}

pub fn is_copy_trait_impl_valid
    store:$common::SymbolStore
    trait_impl:$common::TraitImpl
    trait_type:$common::Type
-> bool {
    common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
    if store copy_type trait_type rules::trait_type_implies ! then
        true return
    fi
    std::Set[std::String]::new = visiting
    visiting store trait_impl.trait_bounds trait_impl.receiver copy_representation_is_eligible
}

pub fn append_struct_copy_clone_body
    casa_struct:$common::CasaStruct
    location:$common::Location
    ops:mut$std::List[common::Op]
    variables:mut$std::List[common::Variable]
{
    0 = member_index: u64
    for member in casa_struct.members.iter do
        location.clone "self".to_str common::OpValue::PushVar common::Op::new ops.push
        location.clone member.name.clone common::OpValue::MethodCall common::Op::new ops.push
        if member.typ.is_shared_borrow ! then
            location.clone "clone" common::STD_CLONE_TRAIT member.typ make_derived_method_call common::Op::new ops.push
        fi
        f"__copy_clone_value_{member_index}" = variable_name
        location.clone variable_name.clone common::OpValue::AssignVar common::Op::new ops.push
        member.typ.clone variable_name common::Variable variables.push
        1 += member_index
    done
    while 0 member_index != do
        1 -= member_index
        location.clone f"__copy_clone_value_{member_index}" common::OpValue::PushVar common::Op::new ops.push
    done
    location.clone casa_struct.clone common::OpValue::StructNew common::Op::new ops.push
}

pub fn append_enum_copy_clone_body
    casa_enum:$common::CasaEnum
    location:$common::Location
    ops:mut$std::List[common::Op]
    variables:mut$std::List[common::Variable]
{
    location.clone "self".to_str common::OpValue::PushVar common::Op::new ops.push
    location.clone common::OpValue::MatchStart common::Op::new ops.push
    0 = variant_index: u64
    for variant_name in casa_enum.variants.iter do
        std::List[std::String]::new = bindings
        if variant_name casa_enum.variant_types.get std::Option::Some(payload_types) is then
            for payload_index in payload_types.length 0 std::Range::new do
                f"__copy_clone_source_{variant_index}_{payload_index}" bindings.push
            done
        fi
        bindings.length = binding_count
        variant_index i64::try_from.unwrap std::Option::Some variant_name.clone casa_enum.name.clone common::EnumVariant::new = pattern_variant
        bindings pattern::make_binding_patterns pattern_variant common::EnumVariant::set_bindings
        std::List[common::Op]::new pattern_variant common::PatternValue::EnumVariant common::MatchArm::new = arm
        location.clone arm common::OpValue::MatchArm common::Op::new ops.push
        variant_name casa_enum
            .variant_types
            .get
            .unwrap = payload_types
        0 = binding_index: u64
        while binding_index binding_count < do
            location.clone f"__copy_clone_source_{variant_index}_{binding_index}" common::OpValue::PushVar common::Op::new ops.push
            binding_index payload_types.get = payload_type
            if payload_type.is_shared_borrow ! then
                location.clone "clone" common::STD_CLONE_TRAIT payload_type make_derived_method_call common::Op::new ops.push
            fi
            f"__copy_clone_value_{variant_index}_{binding_index}" = variable_name
            location.clone variable_name.clone common::OpValue::AssignVar common::Op::new ops.push
            payload_type.clone variable_name common::Variable variables.push
            1 += binding_index
        done
        while 0 binding_index != do
            1 -= binding_index
            location.clone f"__copy_clone_value_{variant_index}_{binding_index}" common::OpValue::PushVar common::Op::new ops.push
        done
        variant_index i64::try_from.unwrap std::Option::Some variant_name.clone casa_enum.name.clone common::EnumVariant::new = constructor
        location.clone constructor common::OpValue::PushEnumVariant common::Op::new ops.push
        1 += variant_index
    done
    location.clone common::OpValue::MatchEnd common::Op::new ops.push
}

pub fn make_copy_clone_fallback
    parser:mut$Parser
    trait_impl:mut$common::TraitImpl
    function_name:$str
-> FunctionSource {
    std::List[common::Parameter]::new = parameters
    common::SHARED_BORROW_TYPE trait_impl.receiver.clone common::apply_borrow_type = receiver
    "self".to_str receiver common::Parameter::named parameters.push
    std::List[common::Type]::new = returns
    trait_impl.receiver.clone returns.push
    returns parameters common::StackEffect::new = effect
    trait_impl.type_vars common::string_list_to_set = effect.type_vars
    trait_impl.trait_bounds.clone effect common::StackEffect::set_trait_bounds

    std::List[common::Op]::new = ops
    std::List[common::Variable]::new = variables
    receiver "self".to_str common::Variable variables.push
    trait_impl.location.clone "self".to_str common::OpValue::AssignVar common::Op::new ops.push
    trait_impl.receiver.match_base = receiver_name
    if
        receiver_name.as_str parser
            .store
            .structs
            .get_str std::Option::Some(casa_struct) is
    then
        variables ops trait_impl.location casa_struct append_struct_copy_clone_body
    elif
        receiver_name.as_str parser
            .store
            .enums
            .get_str std::Option::Some(casa_enum) is
    then
        variables ops trait_impl.location casa_enum append_enum_copy_clone_body
    else
        trait_impl.location.clone "self".to_str common::OpValue::PushVar common::Op::new ops.push
        trait_impl.location.clone common::OpValue::Copy common::Op::new ops.push
    fi

    effect trait_impl.location.clone ops function_name.to_str FunctionSource::with_stack_effect = function
    variables function.declaration common::Function::set_variables
    function
}

# Generic impls share the base receiver identity. Fully concrete impls use the
# formatted receiver so their methods can coexist with other specializations.
pub fn implementation_receiver_name receiver:$common::Type -> std::String {
    if receiver.has_unresolved_type_var then
        receiver.match_base.to_str
    else
        receiver.format
    fi
}

pub fn synthesize_copy_clone_fallbacks parser:mut$Parser {
    if
        common::STD_COPY_TRAIT parser
            .store
            .traits
            .has_str ! common::STD_CLONE_TRAIT.to_str parser
            .store
            .traits
            .has ! ||
    then
        return
    fi
    common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
    common::STD_CLONE_TRAIT.to_str common::GenericType::new common::Type::Generic = clone_trait_type
    if parser.store clone_trait_type copy_type rules::trait_type_implies ! then
        return
    fi
    parser.store.get_trait_impl_names = copy_trait_impl_keys
    for copy_impl_key in copy_trait_impl_keys.iter do
        copy_impl_key.as_str parser
            .store
            .get_trait_impl
            .unwrap
            .clone = trait_impl
        trait_impl.trait_bound.to_type = implemented_trait
        if parser.store copy_type implemented_trait rules::trait_type_implies ! then
            continue
        fi
        "clone" trait_impl.receiver make_derived_function_name = derived_clone_name
        if derived_clone_name.as_str parser.store.has_function then
            derived_clone_name "clone".to_str trait_impl.methods.set
            trait_impl parser.store.set_trait_impl
            continue
        fi
        parser.store clone_trait_type.clone std::Option::Some trait_impl.receiver "clone" rules::resolve_trait_method_semantics_for = clone_method
        if clone_method std::Option::Some(method) is then
            method.function_name.clone "clone".to_str trait_impl.methods.set
            trait_impl parser.store.set_trait_impl
            continue
        fi
        trait_impl.receiver implementation_receiver_name = receiver_name
        f"{receiver_name}::{common::STD_COPY_TRAIT}::clone" = function_name
        if function_name.as_str parser.store.has_function ! then
            function_name.as_str trait_impl parser make_copy_clone_fallback = function
            function parser.put_generated_function
        fi
        function_name.clone "clone".to_str trait_impl.methods.set
        trait_impl parser.store.set_trait_impl
    done
}

pub fn validate_trait_impls parser:mut$Parser {
    for
        trait_impl in parser
            .store
            .clone_trait_impls
            .iter
    do
        if trait_impl.receiver common::Type::TypeVar(_) is then
            trait_impl.location "A trait implementation cannot target a type variable." common::ErrorKind::InvalidScope parser.state.record_error
            continue
        fi
        trait_impl.trait_bound.name parser
            .store
            .traits
            .get = trait_opt
        if trait_opt std::Option::Some(casa_trait) is else
            trait_impl.location trait_impl
                .trait_bound
                .name
                .as_str parser.format_source_name = source_name
            trait_impl.location f"Trait `{source_name}` is not defined" common::ErrorKind::UndefinedName parser.state.record_error_string
            continue
        fi
        trait_impl.trait_bound.to_type = trait_type
        if
            common::STD_COPY_TRAIT trait_impl
                .trait_bound
                .name
                .as_str ==
        then
            trait_impl.receiver.match_base = receiver_name
            if
                receiver_name.as_str parser
                    .store
                    .structs
                    .get_str std::Option::Some(casa_struct) is
            then
                if casa_struct.location trait_impl.location is_same_declaration ! then
                    trait_impl.location f"`Copy` for `{trait_impl.location trait_impl.receiver parser.format_source_type}` requires `derives Copy` on the type declaration" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                fi
            elif
                receiver_name.as_str parser
                    .store
                    .enums
                    .get_str std::Option::Some(casa_enum) is
            then
                if casa_enum.location trait_impl.location is_same_declaration ! then
                    trait_impl.location f"`Copy` for `{trait_impl.location trait_impl.receiver parser.format_source_type}` requires `derives Copy` on the type declaration" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
                fi
            fi
        fi
        if trait_type trait_impl parser.store is_copy_trait_impl_valid ! then
            trait_impl.location f"Type `{trait_impl.location trait_impl.receiver parser.format_source_type}` cannot implement `Copy` because its representation is not safely copyable" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
        fi
        if
            trait_impl
                .trait_bound
                .type_args
                .length casa_trait.type_params.length !=
        then
            trait_impl.location f"Trait `{trait_impl.location casa_trait.name.as_str parser.format_source_name}` expects {casa_trait.type_params.length} type argument(s), got {trait_impl
                .trait_bound
                .type_args
                .length}" common::ErrorKind::Syntax parser.state.record_error_string
        fi
        if
            casa_trait.location.file trait_impl.location.file !=
            parser.store trait_impl.location trait_impl.receiver receiver_is_local ! &&
        then
            trait_impl.location f"Trait implementation `{trait_impl parser.format_source_trait_impl}` must be declared in the module that defines the type or trait" common::ErrorKind::InvalidScope parser.state.record_error_string
        fi
    done
}

pub fn finalize_trait_impl_methods parser:mut$Parser skip_functions:$std::Set[std::String] {
    parser.store.get_trait_impl_names = trait_impl_keys
    for trait_impl_name in trait_impl_keys.iter do
        trait_impl_name.as_str parser
            .store
            .get_trait_impl
            .unwrap
            .clone = trait_impl
        trait_impl.trait_bound.to_type = trait_type
        std::Map[std::String std::String]::new = trait_methods
        for pair in trait_impl.methods.iter do
            pair.first = method_name
            pair.second = function_name
            if function_name.as_str skip_functions.has_str then
                function_name.clone method_name.clone trait_methods.set
                continue
            fi
            if parser.store method_name.as_str trait_type rules::trait_type_has_method then
                function_name.clone method_name.clone trait_methods.set
                continue
            fi
            trait_impl.receiver implementation_receiver_name = receiver_name
            f"{receiver_name}::{method_name}" = inherent_name
            if inherent_name.as_str parser.store.has_function ! then
                if function_name.as_str parser.store.get_function std::Option::Some(function) is then
                    function.clone = declaration
                    inherent_name.clone = declaration.name
                    function_name.as_str parser.clone_source_operations declaration FunctionSource = inherent_function
                    inherent_function inherent_name.clone parser.put_function
                    if
                        function_name.as_str parser
                            .store
                            .public_symbols
                            .has_str
                    then
                        inherent_name.as_str parser
                            .store
                            .module_private_symbols
                            .remove_str
                        inherent_name.clone parser
                            .store
                            .public_symbols
                            .add
                    fi
                fi
            fi
        done
        trait_methods trait_impl common::TraitImpl::set_methods
        trait_impl parser.store.set_trait_impl
    done
}

pub fn parse_literal_match_pattern
    token:$common::Token
    parser:mut$Parser
-> common::LiteralPattern {
    token.value.as_str = value: $str
    if "true" value.as_str == then
        "true".to_str true common::LiteralValue::Bool common::LiteralPattern return
    fi
    if "false" value.as_str == then
        "false".to_str false common::LiteralValue::Bool common::LiteralPattern return
    fi
    if
        0 value
            .at
            .unwrap
            .is_digit value lexer::is_negative_integer_literal ||
    then
        value.to_str value common::IntegerLiteral::parse common::LiteralValue::Int common::LiteralPattern return
    fi
    if value char_literal_codepoint std::Option::Some(character) is then
        value.to_str character common::LiteralValue::Char common::LiteralPattern return
    fi
    if '"' 0 value.at.unwrap == '"' value.length 1 - value.at.unwrap == && then
        value.length = value_length
        value 1 value_length 2 - str::substring = string_value
        value.to_str string_value common::LiteralValue::Str common::LiteralPattern return
    fi
    token.location f"Unsupported literal in match arm: `{value}`" common::ErrorKind::UnexpectedToken parser.state.record_error_string
    # Unreachable
    "".to_str 0 common::IntegerLiteral::from_int common::LiteralValue::Int common::LiteralPattern
}

# _handle_keyword_import - parse import path
pub fn is_path_specifier spec:$str -> bool {
    spec ".casa" str::ends_with
    spec "/" str::contains ||
}

pub fn namespace_name prefix:$str name:$str -> std::String {
    if 0 prefix.length == then
        name.to_str
    else
        f"{prefix}{name}"
    fi
}

pub fn set_module_source_name
    names:mut$std::Map[std::String common::SourceBinding]
    source_name:std::String
    binding:common::SourceBinding
    location:$common::Location
    diagnostics:mut$error::Diagnostics
{
    if source_name.as_str names.get_str std::Option::Some(existing) is then
        if binding.identity existing.identity != binding.is_module existing.is_module != || then
            location f"Module name `{source_name}` conflicts with another declaration or import" common::ErrorKind::DuplicateName diagnostics.record_error_string
        fi
        return
    fi
    binding source_name names.set
}

pub fn dir_of_path path:$str -> std::String {
    std::Option[u64]::None = last_slash
    for scan in path.length 0 std::Range::new do
        if '/' scan path.at.unwrap == then
            scan std::Option::Some = last_slash
        fi
    done
    if last_slash std::Option::Some(index) is then
        path 0 index 1 + str::substring
        return
    fi
    "".to_str
}

fn path_exists path:$str -> bool {
    if path.as_cstr std::Option::Some(path_cstr) is else
        false return
    fi
    path_cstr os::file::exists
}

pub fn try_resolve_import
    parser:$Parser
    importing_file:$str
    spec:$str
-> std::Option[std::String] std::String {
    spec importing_file parser.search_paths parser.sources resolve_import_in
}

# Overrides in the source store take precedence over files on disk.
pub fn resolve_import_in
    sources:$lexer::SourceStore
    search_paths:$std::List[std::String]
    importing_file:$str
    spec:$str
-> std::Option[std::String] std::String {
    importing_file lexer::absolute_normalize_path = importing_normalized
    importing_normalized.as_str dir_of_path = source_dir
    if spec is_path_specifier then
        if spec "/" str::starts_with then
            spec lexer::absolute_normalize_path std::Option::Some
            std::String::new
            return
        fi
        f"{source_dir}{spec}" = combined
        combined.as_str lexer::absolute_normalize_path std::Option::Some
        std::String::new
        return
    fi
    # Module-style: probe source dir, then each search path. First hit wins.
    # Skip a same-dir match that resolves to the importing file itself, so an
    # example named `argparse.casa` importing "argparse" still finds the
    # library copy via -L.
    # `searched` accumulates probed dirs for the not-found error message.
    f"{source_dir}{spec}.casa" = source_candidate_path
    source_candidate_path.as_str lexer::absolute_normalize_path = source_candidate
    source_candidate.as_str sources.get.is_some = source_is_overridden
    if source_is_overridden source_candidate.as_str path_exists || then
        if source_candidate.as_str importing_normalized.as_str != then
            source_candidate std::Option::Some std::String::new return
        fi
    fi
    if 0 source_dir.length == then
        ".".to_str
    else
        source_dir
    fi
    = first_dir
    f"\n  {first_dir}" = searched
    for base in search_paths.iter do
        f"{searched}\n  {base}" = searched
        f"{base}/{spec}.casa" = candidate_path
        candidate_path.as_str lexer::absolute_normalize_path = candidate
        if candidate.as_str sources.get.is_some candidate.as_str path_exists || then
            candidate std::Option::Some searched return
        fi
    done
    std::Option[std::String]::None searched
}

pub fn resolve_import
    parser:mut$Parser
    importing_file:$str
    spec:$str
    location:$common::Location
-> std::String {
    spec importing_file parser try_resolve_import = searched = resolved
    resolved.clone spec.to_str importing_file.to_str ImportResolution parser
        .imports
        .resolutions
        .push
    if resolved std::Option::Some(path) is then
        path.clone return
    fi
    location f"module `{spec}` not found, searched:{searched}" common::ErrorKind::Syntax parser.state.record_error_string
    parser.state.mark_output_unusable
    "".to_str
}

impl Parser {
    pub fn canonical_module_prefix self:mut$Parser path:$str -> std::String {
        if path self.source_prefixes.get_str std::Option::Some(prefix) is then
            prefix.clone return
        fi
        true = standard_available
        for pair in self.source_prefixes.iter do
            if common::STD_NAMESPACE pair.second.as_str == then
                false = standard_available
            fi
        done
        if standard_available path "/std.casa" str::ends_with && then
            common::STD_NAMESPACE.to_str
        else
            self.source_prefixes.length = module_index
            f"__casa_{module_index}__"
        fi
        = prefix
        prefix.clone path.to_str self.source_prefixes.set
        path prefix.as_str self.store.record_module_stem
        prefix
    }
}

impl Parser {
    fn reject_import_cycle self:mut$Parser import_path:$str location:$common::Location -> bool {
        if import_path self.import_stack common::string_list_index std::Option::Some(cycle_start) is else
            false return
        fi
        std::List[std::String]::new = cycle
        cycle_start self
            .import_stack
            .iter
            .skip = cycle_items
        for item in cycle_items do
            item.clone cycle.push
        done
        import_path cycle.push_str
        " -> " cycle.join_strings = cycle_path
        location f"Module import cycle: {cycle_path}" common::ErrorKind::Syntax self.state.record_error_string
        self.state.mark_output_unusable
        true
    }
}

pub fn take_diagnostics_since diagnostics:mut$error::Diagnostics start:u64 -> error::Diagnostics {
    error::Diagnostics::new = imported
    while diagnostics.entries.length start > do
        diagnostics.entries.pop imported.entries.push
    done
    imported.entries.reverse
    imported
}

impl Parser {
    pub fn ensure_import_analyzed
        self:mut$Parser
        import_path:$str
        module_prefix:$str
        location:$common::Location
    -> bool {
        if 1 self.import_stack.length == then
            import_path.to_str self
                .imports
                .paths
                .push
        fi
        if import_path self.module_cache.get_str std::Option::Some(cached_module) is then
            if cached_module.failed then
                false = self.imports.clean
                self.state.mark_output_unusable
                false return
            fi
            import_path.to_str self.analyzed_files.add
            true return
        fi
        self
            .state
            .diagnostics
            .entries
            .length = diagnostic_start
        module_prefix import_path self.analyze_import = import_result
        diagnostic_start self.state.diagnostics take_diagnostics_since = imported_diagnostics
        if imported_diagnostics.entries.is_empty ! then
            false = self.imports.clean
        fi
        location imported_diagnostics self
            .state
            .diagnostics
            .merge_at_encounter
        import_result match
            std::Result::Ok(imported) => {
                if imported ! then
                    false = self.imports.clean
                    true ImportedModule import_path.to_str self.module_cache.set
                    self.state.mark_output_unusable
                    false return
                fi
                import_path.to_str self.analyzed_files.add
                true
            }
            std::Result::Error(read_error) => {
                false = self.imports.clean
                location f"Cannot read import `{import_path}`: {read_error.to_str}" common::ErrorKind::Syntax self
                    .state
                    .diagnostics
                    .record_error_at_encounter_string
                true ImportedModule import_path.to_str self.module_cache.set
                self.state.mark_output_unusable
                false
            }
        end
    }
}

impl Parser {
    fn import_module self:mut$Parser path:$str module_key:$str location:$common::Location {
        if location path self.reject_import_cycle then
            return
        fi
        if
            path self
                .current_module
                .included_files
                .has_str
        then
            return
        fi
        if location module_key path self.ensure_import_analyzed ! then
            return
        fi
        path.to_str self
            .current_module_mut
            .included_files
            .add
    }
}

# handle_question_operator - preserve `?` for type-aware lowering
#
# Typechecking resolves the source value and enclosing return type before it
# lowers this operation through the structural propagation methods.
#
pub fn handle_question_operator token:$common::Token ops:mut$std::List[common::Op] {
    token
        .location
        .span
        .offset = offset
    # `$` cannot occur in a source identifier, so user variables cannot collide with this local.
    f"$question_{offset}" common::OpValue::Question = question
    token.location question common::Op::new ops.push
}

# Pointer operations without a type operand lower by name.
fn lower_pointer_name token:$common::Token ops:mut$std::List[common::Op] -> bool {
    if "ptr::into_raw" token.value.as_str == then
        token.location common::OpValue::PtrIntoRaw common::Op::new ops.push
    elif "ptr::from_ref" token.value.as_str == then
        token.location common::OpValue::PtrFromRef common::Op::new ops.push
    elif "ptr::null" token.value.as_str == then
        token.location common::OpValue::PtrNull common::Op::new ops.push
    else
        false return
    fi
    true
}

# Return the name that `pub` publishes, if the declaration has one.
fn public_declaration_name
    declaration:$grammar::DeclarationTermSyntax
    resolver:$NameResolver
-> std::Option[std::String] {
    declaration.item match
        grammar::DeclarationItem::Function(function) => function.name_token copy
        grammar::DeclarationItem::Header(position) => position copy
        grammar::DeclarationItem::Implementation(_) => std::Option[std::String]::None return
    end = position
    position resolver.tokens.get = name
    if common::TokenKind::Identifier name.kind == then
        name.value.as_str resolver.resolve_name std::Option::Some return
    fi
    std::Option[std::String]::None
}

# Source construction lowers recognized terms in source order. Body ranges and
# delimiters come from recognition. Name targets select struct construction.
impl Parser {
    fn is_rejected_reference self:$Parser token:$common::Token -> bool {
        if
            self
                .current_module
                .rejected_references
                .is_empty
        then
            false return
        fi
        token
            .location
            .span
            .offset
            .to_str
            .as_str self
            .current_module
            .rejected_references
            .has_str
    }

    # A rejected declaration lowers to one operation over its source range.
    fn reject_declaration
        self:$Parser
        resolver:$NameResolver
        declaration:$grammar::DeclarationTermSyntax
        ops:mut$std::List[common::Op]
    -> bool {
        if
            self
                .current_module
                .rejected_declarations
                .is_empty
        then
            false return
        fi
        declaration.first_token resolver.tokens.get = first
        if
            first
                .location
                .span
                .offset
                .to_str
                .as_str self
                .current_module
                .rejected_declarations
                .has_str !
        then
            false return
        fi
        declaration.after_token 1 - resolver
            .tokens
            .get
            .location
            .span = last_span: $common::Span
        first.location.clone = location
        last_span.offset last_span.length + location.span.offset - location.span.offset location.with_span = location
        location common::OpValue::Rejected common::Op::new ops.push
        true
    }

    fn lower_terms
        self:mut$Parser
        resolver:mut$NameResolver
        terms:$std::List[grammar::TermSyntax]
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        for term in terms.iter do
            ops function_name term resolver self.lower_term
        done
    }

    fn lower_term
        self:mut$Parser
        resolver:mut$NameResolver
        term:$grammar::TermSyntax
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        term match
            grammar::TermSyntax::Token(position) => ops function_name position copy resolver.tokens.get self.lower_token
            grammar::TermSyntax::Name(name) => ops function_name name resolver self.lower_name
            # Outside a struct literal, a field label is an ordinary name.
            grammar::TermSyntax::Field(field) => {
                std::Option[grammar::IsSyntax]::None std::Option[grammar::BlockSyntax]::None std::Option[u64]::None
                std::Option[grammar::TypeArgumentsSyntax]::None field.label copy grammar::NameSyntax = label
                ops function_name label resolver self.lower_name
                ops function_name field.value resolver self.lower_terms
            }
            grammar::TermSyntax::TypeOperation(position operand) => ops operand position copy resolver self.lower_type_operation
            grammar::TermSyntax::Assignment(assignment) => ops assignment resolver self.lower_assignment
            grammar::TermSyntax::Accessor(names) => {
                for position in names.iter do
                    position copy resolver.tokens.get = method
                    method.location method.value.clone common::OpValue::MethodCall common::Op::new ops.push
                done
            }
            grammar::TermSyntax::Array(array) => function_name array resolver self.lower_array ops.push
            grammar::TermSyntax::Block(block) => function_name false block.open block resolver self.lower_closure ops.push
            grammar::TermSyntax::Move(position block) => function_name true position copy block resolver self.lower_closure ops.push
            grammar::TermSyntax::Unsafe(position block) => {
                position copy resolver
                    .tokens
                    .get
                    .location
                    .clone = location
                location common::OpValue::UnsafeStart common::Op::new ops.push
                ops function_name block.terms resolver self.lower_terms
                location common::OpValue::UnsafeEnd common::Op::new ops.push
            }
            grammar::TermSyntax::Control(control) => {
                for segment in control.segments.iter do
                    ops function_name segment.keyword resolver.tokens.get self.lower_keyword
                    ops function_name segment.terms resolver self.lower_terms
                done
                ops function_name control.close resolver.tokens.get self.lower_keyword
            }
            grammar::TermSyntax::For(for_loop) => ops function_name for_loop resolver self.lower_for
            grammar::TermSyntax::Match(construct) => ops function_name construct resolver self.lower_match
            grammar::TermSyntax::Fstring(fstring) => ops function_name fstring resolver self.lower_fstring
            grammar::TermSyntax::Declaration(declaration) => ops function_name declaration resolver self.lower_declaration
            grammar::TermSyntax::Import => {}
        end
    }

    fn lower_token
        self:mut$Parser
        token:$common::Token
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        if token self.is_rejected_reference then
            token.location common::OpValue::Rejected common::Op::new ops.push
            return
        fi
        token.kind match
            common::TokenKind::Literal => self.state token get_op_literal ops.push
            common::TokenKind::Intrinsic => self.state token get_op_intrinsic ops.push
            common::TokenKind::Operator => {
                if "?" token.value.as_str == then
                    ops token handle_question_operator
                else
                    self.state token get_op_operator ops.push
                fi
            }
            common::TokenKind::Keyword => ops function_name token self.lower_keyword
            # Separators carry no operation.
            _ => {}
        end
    }

    # Statement and control keywords lower directly. A `pub` term has no declaration.
    fn lower_keyword
        self:mut$Parser
        token:$common::Token
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        token.value.as_str common::keyword_from_str.unwrap = keyword
        if common::KeywordKind::Pub keyword == then
            self token.location "Public declarations" function_name require_global_scope
            token.location "`pub` must prefix a function, type, trait, or constant declaration" common::ErrorKind::Syntax self.state.record_error
            return
        fi
        keyword keyword_to_op_value match
            std::Option::Some(value) => token.location value common::Op::new ops.push
            std::Option::None => {}
        end
    }

    # Keep the receiver before a trait qualifier. The operation or explicit type
    # arguments retain the trait itself, but cannot also answer for the receiver.
    fn record_qualified_receiver self:mut$Parser resolver:$NameResolver name:$grammar::NameSyntax {
        name.token resolver.tokens.get = token
        token.value.clone = spelling
        if name.member.is_none then
            spelling.as_str common::path_name_spans.name copy = member
            if member.offset 2 < then
                return
            fi
            spelling.as_str 0 member.offset 2 - str::substring = spelling
        fi
        spelling.as_str common::path_name_spans = spans
        if spans.qualifier std::Option::Some(receiver) is then
            spelling.as_str 0 receiver.offset receiver.length + str::substring = prefix
            if prefix.as_str "&" str::starts_with then
                prefix.as_str 1 prefix.length 1 - str::substring = prefix
            fi
            prefix.as_str common::source_reference_head = head
            if head.as_str resolver.type_bindings common::string_list_contains then
                return
            fi
            prefix.as_str resolver.resolve_name = resolved
            receiver copy resolved.as_str token self.state.record_type_reference
        fi
    }

    # A name selects pointer, associated-item, struct, or enum-check meaning
    # before any remaining closure or misplaced pattern suffix.
    fn lower_name
        self:mut$Parser
        resolver:mut$NameResolver
        name:$grammar::NameSyntax
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        name resolver self.record_qualified_receiver
        name.token resolver.tokens.get = token
        if token self.is_rejected_reference then
            token.location common::OpValue::Rejected common::Op::new ops.push
        elif ops token lower_pointer_name ! then
            if name.arguments std::Option::Some(arguments) is then
                ops arguments name resolver self.lower_associated_name
            else
                if name.brace std::Option::Some(brace) is then
                    token.value.as_str resolver.resolve_name = target
                    if
                        target.as_str self
                            .store
                            .structs
                            .has_str
                    then
                        ops function_name brace name.token resolver self.lower_struct_literal
                        return
                    fi
                fi
                if name.check std::Option::Some(check) is then
                    if token.value.as_str "::" str::contains then
                        false check.pattern resolver self.lower_pattern match
                            common::PatternValue::EnumVariant(variant) => token.location.clone variant common::OpValue::IsCheck common::Op::new ops.push
                            _ => token.location token.value.clone common::OpValue::Identifier common::Op::new ops.push
                        end
                        return
                    fi
                fi
                token.location token.value.clone common::OpValue::Identifier common::Op::new ops.push
            fi
        fi
        if name.brace std::Option::Some(brace) is then
            function_name false brace.open brace resolver self.lower_closure ops.push
        fi
        # Without an enum variant, the payload is a removed cast and `is` has no subject.
        if name.check std::Option::Some(check) is then
            if check.pattern.payload std::Option::Some(payload) is then
                if payload grammar::PatternPayloadSyntax::Variant(open _) is then
                    open copy resolver
                        .tokens
                        .get
                        .location
                    "General casts are not supported; use a named conversion or type annotation"
                    common::ErrorKind::UnexpectedToken self.state.record_error
                fi
            fi
            check.is_token resolver
                .tokens
                .get
                .location "`is` requires a preceding enum variant" common::ErrorKind::Syntax self.state.record_error
        fi
    }

    # Explicit type arguments erase into a hint on the associated item or function reference.
    fn lower_associated_name
        self:mut$Parser
        resolver:mut$NameResolver
        name:$grammar::NameSyntax
        arguments:$grammar::TypeArgumentsSyntax
        ops:mut$std::List[common::Op]
    {
        name.token resolver.tokens.get = token
        false self.store self.state resolver arguments.parameters resolve_parsed_arguments = type_args
        token.value.as_str resolver.resolve_name = base
        if base.as_str "&" str::starts_with then
            base.as_str 1 base.length 1 - str::substring = base
        fi
        if name.member std::Option::Some(position) is then
            token.value.as_str common::path_name_spans.name copy = span
            base.clone = referenced
            # In `&Token::Convert[i64]::convert`, the written name is the trait.
            if base.as_str "::" str::contains then
                token.value.as_str span.offset span.length str::substring.as_str resolver.resolve_name = referenced
            fi
            span referenced.as_str token self.state.record_type_reference
            position copy resolver.tokens.get = member
            # The type reference retains the receiver. The operation names the member.
            member.location f"{token.value}::{member.value}" common::OpValue::Identifier common::Op::new
        else
            token.location token.value.clone common::OpValue::Identifier common::Op::new
        fi = associated
        type_args base common::GenericType::with_params common::Type::Generic std::Option::Some associated common::Op::set_type_hint
        associated ops.push
    }

    fn lower_type_operation
        self:mut$Parser
        resolver:mut$NameResolver
        position:u64
        operand:$grammar::TypeSyntax
        ops:mut$std::List[common::Op]
    {
        position resolver.tokens.get = token
        if token self.is_rejected_reference then
            token.location common::OpValue::Rejected common::Op::new ops.push
            return
        fi
        self.store self.state resolver operand resolve_parsed_type = target_type
        token.value.as_str = name
        if "size_of" name == then
            target_type common::OpValue::SizeOf
        elif "ptr::read" name == then
            target_type common::OpValue::PtrRead
        elif "ptr::write" name == then
            target_type common::OpValue::PtrWrite
        elif "ptr::as_ref" name == then
            target_type common::OpValue::PtrAsRef
        elif "ptr::as_mut" name == then
            target_type common::OpValue::PtrAsMut
        else
            target_type common::OpValue::PtrFromRaw
        fi = value
        token.location value common::Op::new ops.push
    }

    fn lower_assignment
        self:mut$Parser
        resolver:mut$NameResolver
        assignment:$grammar::AssignmentSyntax
        ops:mut$std::List[common::Op]
    {
        assignment.target resolver.tokens.get = root
        root.value.clone = target
        for position in assignment.fields.iter do
            position copy resolver.tokens.get = field
            if common::TokenKind::Identifier field.kind != then
                field.location "Unexpected token" common::ErrorKind::UnexpectedToken self.state.record_error
                self.state.request_recovery
                return
            fi
            f"{target}.{field.value}" = target
        done
        assignment.operator resolver
            .tokens
            .get
            .value
            .as_str common::operator_from_str.unwrap = operator
        if common::OperatorKind::AssignInc operator == then
            root.location target common::OpValue::AssignInc common::Op::new ops.push
        elif common::OperatorKind::AssignDec operator == then
            root.location target common::OpValue::AssignDec common::Op::new ops.push
        else
            root.location target common::OpValue::AssignVar common::Op::new = assign_op
            if assignment.typ std::Option::Some(typ) is then
                self.store self.state resolver typ resolve_parsed_type std::Option::Some = assign_op.type_hint
            fi
            assign_op ops.push
        fi
    }

    # A struct target selects field construction for a braced name.
    fn lower_struct_literal
        self:mut$Parser
        resolver:mut$NameResolver
        name_token:u64
        brace:$grammar::BlockSyntax
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        name_token resolver.tokens.get = token
        token.value.as_str resolver.resolve_name = struct_name
        if struct_name.as_str self.store.get_struct_member_names std::Option::Some(member_names) is else
            token.location f"Struct `{token.value}` is not defined" common::ErrorKind::UndefinedName self.state.record_error_string
            self.state.mark_output_unusable
            return
        fi
        token.value.as_str common::path_name_spans.name copy struct_name.as_str token self.state.record_type_reference
        std::List[std::String]::new = field_order
        std::Set[std::String]::new = seen
        for term in brace.terms.iter do
            if term grammar::TermSyntax::Field(field) is then
                field.label resolver.tokens.get = label
                if label.value.as_str member_names common::string_list_contains ! then
                    label.location f"Struct `{token.value}` has no field `{label.value}`" common::ErrorKind::UndefinedName self.state.record_error_string
                fi
                if label.value.as_str seen.has_str then
                    label.location f"Duplicate field `{label.value}` in struct literal" common::ErrorKind::DuplicateName self.state.record_error_string
                fi
                label.value.clone seen.add
                label.value.clone field_order.push
                ops.length = ops_before
                ops function_name field.value resolver self.lower_terms
                if ops_before ops.length == then
                    field.label resolver.tokens.get = label
                    label.location f"Missing value for field `{label.value}`" common::ErrorKind::Syntax self.state.record_error_string
                fi
            else
                # Source construction tokens omit trivia, so the first item follows the brace.
                brace.open 1 + resolver
                    .tokens
                    .get
                    .location "Unexpected token" common::ErrorKind::UnexpectedToken self.state.record_error
                self.state.request_recovery
                break
            fi
        done
        field_order struct_name common::StructLiteral = literal
        name_token resolver
            .tokens
            .get
            .location literal common::OpValue::StructLiteral common::Op::new ops.push
    }

    # Array items are literals, names, struct literals, closures, or nested arrays.
    fn lower_array
        self:mut$Parser
        resolver:mut$NameResolver
        array:$grammar::ArraySyntax
        function_name:$str
    -> common::Op {
        std::List[common::Op]::new = items
        for item in array.items.iter do
            item match
                grammar::TermSyntax::Array(nested) => function_name nested resolver self.lower_array items.push
                grammar::TermSyntax::Block(block) => function_name false block.open block resolver self.lower_closure items.push
                grammar::TermSyntax::Token(position) => self.state position copy resolver.tokens.get get_op_literal items.push
                grammar::TermSyntax::Name(name) => {
                    if name.brace std::Option::Some(brace) is then
                        std::List[common::Op]::new = literal
                        literal function_name brace name.token resolver self.lower_struct_literal
                        name.token resolver
                            .tokens
                            .get
                            .location literal common::OpValue::ExprGroup common::Op::new items.push
                    else
                        name.token resolver.tokens.get = token
                        token.location token.value.clone common::OpValue::Identifier common::Op::new items.push
                    fi
                }
                _ => {}
            end
        done
        array.open resolver
            .tokens
            .get
            .location items common::OpValue::PushArray common::Op::new
    }

    # A closure body becomes a function named after its enclosing function and origin offset.
    fn lower_closure
        self:mut$Parser
        resolver:mut$NameResolver
        block:$grammar::BlockSyntax
        origin:u64
        by_move:bool
        function_name:$str
    -> common::Op {
        origin resolver
            .tokens
            .get
            .location
            .clone = location
        f"lambda__{function_name}_o{location.span.offset}" = lambda_name
        std::List[common::Op]::new = lambda_ops
        lambda_ops lambda_name.as_str block.terms resolver self.lower_terms
        location.clone lambda_ops lambda_name.clone FunctionSource::new = lambda_function
        block.close resolver.tokens.get lambda_function.retain_body_end
        by_move lambda_function.declaration common::Function::set_captures_by_move
        lambda_function lambda_name.clone self.put_function
        location lambda_name common::OpValue::FnPush common::Op::new
    }

    # A `for` loop lowers to a `while` loop that consumes each `next` result:
    #
    #     <iterable> = $for_iter
    #     while true do
    #         $for_iter .next match
    #             Option::Some($for_value) => { $for_value = item <body> }
    #             Option::None => break
    #         end
    #     done
    #     $for_iter drop
    #
    # Consuming the option directly avoids an unwrap call and a separate option
    # owner at each iteration. Keep the source binding as an assignment so an
    # existing outer binding still receives the yielded value. AssignYield
    # retains the payload capability. The hidden names include the file and
    # source offset to distinguish nested loops.
    fn lower_for
        self:mut$Parser
        resolver:mut$NameResolver
        for_loop:$grammar::ForSyntax
        function_name:$str
        ops:mut$std::List[common::Op]
    {
        for_loop.keyword resolver
            .tokens
            .get
            .location
            .clone = for_loc
        for_loop.variable resolver
            .tokens
            .get
            .clone = loop_var_token
        for_loc.span.offset = for_offset
        for_loc.file.as_str std::str_hash = for_file_hash
        f"$for_iter_{for_file_hash}_{for_offset}" = hidden_iter_name
        f"$for_value_{for_file_hash}_{for_offset}" = hidden_value_name
        ops function_name for_loop.iterable resolver self.lower_terms
        for_loop.body.keyword resolver
            .tokens
            .get
            .location
            .clone = body_origin
        for_loc.clone hidden_iter_name.clone common::OpValue::AssignVar common::Op::new ops.push
        for_loc.clone common::OpValue::WhileStart common::Op::new ops.push
        for_loc.clone 1 common::OpValue::PushBool common::Op::new ops.push
        body_origin common::OpValue::WhileCondition common::Op::new ops.push
        for_loc.clone hidden_iter_name.clone common::OpValue::PushVar common::Op::new ops.push
        for_loc.clone "next".to_str common::OpValue::MethodCall common::Op::new ops.push
        for_loc.clone common::OpValue::MatchStart common::Op::new ops.push
        std::Option::None "Some".to_str common::STD_OPTION_TYPE.to_str common::EnumVariant::new = some
        loop_var_token.location.clone hidden_value_name.clone common::PatternBinding
        common::PatternValue::Binding some.bindings.push
        std::List[common::Op]::new some common::PatternValue::EnumVariant common::MatchArm::new = some_arm
        for_loc.clone some_arm common::OpValue::MatchArm common::Op::new ops.push
        loop_var_token.location.clone hidden_value_name common::OpValue::PushVar common::Op::new ops.push
        loop_var_token.location.clone loop_var_token.value.clone common::OpValue::AssignYield common::Op::new ops.push
        ops function_name for_loop.body.terms resolver self.lower_terms
        for_loop.close resolver
            .tokens
            .get
            .location
            .clone = done_location
        std::Option::None "None".to_str common::STD_OPTION_TYPE.to_str common::EnumVariant::new = none
        std::List[common::Op]::new none common::PatternValue::EnumVariant common::MatchArm::new = none_arm
        done_location.clone none_arm common::OpValue::MatchArm common::Op::new ops.push
        done_location.clone common::OpValue::WhileBreak common::Op::new ops.push
        done_location.clone common::OpValue::MatchEnd common::Op::new ops.push
        done_location.clone common::OpValue::WhileEnd common::Op::new ops.push
        done_location.clone hidden_iter_name common::OpValue::PushVar common::Op::new ops.push
        done_location common::OpValue::Drop common::Op::new ops.push
    }

    # Nested names bind. A root name without `::` names an enum variant.
    fn lower_pattern
        self:mut$Parser
        resolver:$NameResolver
        pattern:$grammar::PatternSyntax
        nested:bool
    -> common::PatternValue {
        pattern.token resolver.tokens.get = token
        if common::TokenKind::Literal token.kind == then
            self token parse_literal_match_pattern common::PatternValue::Literal return
        fi
        if pattern.payload std::Option::Some(payload) is then
            if payload grammar::PatternPayloadSyntax::Fields(fields) is then
                std::Map[std::String common::PatternValue]::new = values
                for field in fields.iter do
                    field.label resolver.tokens.get = label
                    if label.value values.has then
                        label.location "Duplicate field in pattern" common::ErrorKind::DuplicateName self.state.record_error
                    fi
                    true field.value resolver self.lower_pattern label.value.clone values.set
                done
                token.value.as_str resolver.resolve_name = struct_name
                token.value.as_str common::path_name_spans.name copy struct_name.as_str token self.state.record_type_reference
                values struct_name common::StructPattern common::PatternValue::Struct return
            fi
        fi
        token.value.as_str resolver.resolve_name = name
        if name.as_str "::" str::find std::Option::Some(separator) is else
            if pattern.payload std::Option::Some(payload) is then
                if payload grammar::PatternPayloadSyntax::Variant(open _) is then
                    open copy resolver.tokens.get = parenthesis
                    if nested then
                        parenthesis.location "Expected pattern" common::ErrorKind::UnexpectedToken self.state.record_error
                        self.state.mark_output_unusable
                    else
                        "`(`".to_str "`=>`".to_str parenthesis.location "Unexpected token".to_str
                        common::ErrorKind::UnexpectedToken self.state.record_error_expected
                        self.state.request_recovery
                    fi
                fi
            fi
            if nested common::MATCH_WILDCARD token.value.as_str != && then
                token.location.clone token.value.clone common::PatternBinding
                common::PatternValue::Binding return
            fi
            std::Option[i64]::None name "".to_str common::EnumVariant::new
            common::PatternValue::EnumVariant return
        fi
        name.as_str 0 separator str::substring = enum_name
        separator 2 + = start
        name.as_str start name.length start - str::substring = variant_name
        token.value.as_str common::path_name_spans = spans
        if spans.qualifier std::Option::Some(span) is then
            span copy enum_name.as_str token self.state.record_type_reference
        fi
        spans.name copy variant_name.clone std::Option::Some enum_name.as_str token self.state.record_reference
        std::Option[i64]::None variant_name enum_name common::EnumVariant::new = variant
        if pattern.payload std::Option::Some(payload) is then
            if payload grammar::PatternPayloadSyntax::Variant(_ items) is then
                for entry in items.iter do
                    true entry resolver self.lower_pattern variant.bindings.push
                done
            fi
        fi
        variant common::PatternValue::EnumVariant
