# Source construction for compilation and name resolution.
#
# Lowers shared syntax terms into operations. Name targets select the meaning
# of neutral source forms.
import "std" as std
import "os" as os
import "parser" as parser
import "pattern" as pattern
import "common" as common
import "constant_eval" as constant_eval
import "error" as error
import "lexer" as lexer
import "source_body" as source_body
import "semantic_rules" as rules
import "syntax" as grammar

# Parser struct and parse/resolve result
#
# `Parser` owns parse-private state. Later compiler phases receive only the
# dependencies they use, not the parser object itself.
pub struct ParseState {
    pub diagnostics:       error::Diagnostics
    pub output_usable:     bool
    pub recovery_required: bool
    pub store_mutated:     bool
    pub constant_errors:   u64
    type_references:       std::List[common::TypeReference]
}

impl ParseState {
    pub fn new diagnostics:error::Diagnostics -> ParseState {
        std::List[common::TypeReference]::new 0 false false true diagnostics ParseState
    }

    # Retain a written type segment and the store key it resolved to.
    pub fn record_type_reference
        self:mut$ParseState
        token:$common::Token
        name:$str
        span:common::Span
    {
        span std::Option[std::String]::None name token self.record_reference
    }

    # Retain the `span` segment of `token`. A `variant` makes the segment name that
    # variant of the `name` enum.
    fn record_reference
        self:mut$ParseState
        token:$common::Token
        name:$str
        variant:std::Option[std::String]
        span:common::Span
    {
        span.length = length
        span.offset = offset
        if 0 length == then
            return
        fi
        variant name.to_str length token
            .location
            .span
            .offset offset + token.location.with_span
        common::TypeReference self.type_references.push
    }

    pub fn record_error
        self:mut$ParseState
        kind:common::ErrorKind
        message:$str
        location:$common::Location
    {
        location message kind self.diagnostics.record_error
    }

    pub fn record_error_string
        self:mut$ParseState
        kind:common::ErrorKind
        message:std::String
        location:$common::Location
    {
        location message kind self.diagnostics.record_error_string
    }

    pub fn record_error_expected
        self:mut$ParseState
        kind:common::ErrorKind
        message:std::String
        location:$common::Location
        expected:std::String
        got:std::String
    {
        got expected location.clone message kind error::CasaError::with_expected
        self.diagnostics.push_error
    }

    pub fn mark_output_unusable self:mut$ParseState { false = self.output_usable }

    pub fn has_usable_output self:$ParseState -> bool { self.output_usable }

    pub fn has_nonconstant_errors_since
        self:$ParseState
        errors_before:u64
        constant_errors_before:u64
    -> bool {
        self.diagnostics.error_count errors_before -
        self.constant_errors constant_errors_before - !=
    }

    pub fn request_recovery self:mut$ParseState { true = self.recovery_required }

    pub fn take_recovery_request self:mut$ParseState -> bool {
        self.recovery_required = requested
        false = self.recovery_required
        requested
    }

    pub fn reset_store_mutation self:mut$ParseState { false = self.store_mutated }

    pub fn mark_store_mutated self:mut$ParseState { true = self.store_mutated }

    pub fn store_was_mutated self:$ParseState -> bool { self.store_mutated }

    pub fn into_parts self:ParseState -> error::Diagnostics std::List[common::TypeReference] {
        self match
            ParseState { diagnostics: diagnostics type_references: references } => diagnostics references
        end
    }
}

pub struct ImportedModule derives std::Clone {
    pub failed: bool
}

pub struct ModuleContext {
    pub included_files:        std::Set[std::String]
    pub declared_names:        std::Set[std::String]
    pub nonconstant_names:     std::Set[std::String]
    pub names:                 std::Map[std::String common::SourceBinding]
    pub constructed_headers:   std::Set[std::String]
    pub rejected_declarations: std::Map[std::String u64]
    pub rejected_references:   std::Map[std::String u64]
}

impl ModuleContext {
    pub fn new -> ModuleContext {
        std::Map[std::String u64]::new std::Map[std::String u64]::new std::Set[std::String]::new
        std::Map[std::String common::SourceBinding]::new std::Set[std::String]::new std::Set[std::String]::new
        std::Set[std::String]::new ModuleContext
    }
}

# A source declaration builder owns syntax separately from callable metadata.
struct FunctionSource {
    declaration: common::Function
    operations:  std::List[common::Op]
}

impl FunctionSource {
    fn new
        name:std::String
        operations:std::List[common::Op]
        location:common::Location
    -> FunctionSource {
        location name common::Function::new = declaration
        operations declaration FunctionSource
    }

    fn with_stack_effect
        name:std::String
        operations:std::List[common::Op]
        location:common::Location
        effect:common::StackEffect
    -> FunctionSource {
        effect location name common::Function::with_stack_effect = declaration
        operations declaration FunctionSource
    }

    fn retain_body_end self:mut$FunctionSource closing:$common::Token {
        closing
            .location
            .span
            .offset closing
            .location
            .span
            .length + std::Option::Some
        = self.declaration.body_end
    }

    fn into_parts self:FunctionSource -> common::Function std::List[common::Op] {
        self match
            FunctionSource { declaration: declaration operations: operations } => declaration operations
        end
    }
}

enum SourceBodyWork {
    Pending(std::List[common::Op])
    Reserved
    Completed(source_body::SourceBody)
}

impl SourceBodyWork {
    fn get_completed self:$SourceBodyWork -> std::Option[$source_body::SourceBody] {
        self match
            SourceBodyWork::Completed(body) => body std::Option[$source_body::SourceBody]::Some
            _ => std::Option[$source_body::SourceBody]::None
        end
    }
}

struct SourceBodies {
    work: std::Map[std::String SourceBodyWork]
}

impl SourceBodies {
    fn new -> SourceBodies { std::Map[std::String SourceBodyWork]::new SourceBodies }

    fn add self:mut$SourceBodies name:std::String operations:std::List[common::Op] {
        operations SourceBodyWork::Pending name self.work.set
    }

    fn get_completed self:$SourceBodies name:$str -> std::Option[$source_body::SourceBody] {
        if name self.work.get_str std::Option::Some(work) is then
            work.get_completed return
        fi
        std::Option[$source_body::SourceBody]::None
    }

    fn clone_operations self:$SourceBodies name:$str -> std::List[common::Op] {
        if name self.work.get_str std::Option::Some(work) is then
            work match
                SourceBodyWork::Pending(operations) => operations.clone return
                SourceBodyWork::Completed(body) => body.lower_operations return
                SourceBodyWork::Reserved => "Cannot copy source while resolving its body" panic
            end
        fi
        std::List[common::Op]::new
    }

    fn begin self:mut$SourceBodies declaration:common::Function -> std::Option[FunctionSource] {
        if declaration.name.as_str self.work.get_str std::Option::Some(work) is then
            if work SourceBodyWork::Pending is ! then
                std::Option[FunctionSource]::None return
            fi
        else
            std::Option[FunctionSource]::None return
        fi
        declaration.name.as_str self
            .work
            .remove_str
            .unwrap match
            SourceBodyWork::Pending(operations) => {
                SourceBodyWork::Reserved declaration.name.clone self.work.set
                operations declaration FunctionSource std::Option::Some
            }
            _ => "Only pending source can begin resolution" panic
        end
    }

    fn into_bodies self:SourceBodies -> std::Map[std::String source_body::SourceBody] {
        std::Map[std::String source_body::SourceBody]::new = bodies
        for
            name in self
                .work
                .keys
                .iter
        do
            name.as_str self
                .work
                .remove_str
                .unwrap match
                SourceBodyWork::Pending(operations) => operations source_body::consume_source_body
                SourceBodyWork::Completed(body) => body
                SourceBodyWork::Reserved => "Cannot finish source with active resolution" panic
            end
            name.clone bodies.set
        done
        bodies
    }
}

impl FunctionSource {
    # The source frame owns declaration and syntax until both are published together.
    fn resolve
        self:FunctionSource
        store:mut$common::SymbolStore
        diagnostics:mut$error::Diagnostics
        bodies:mut$SourceBodies
        allow_root_local_capture:bool
    {
        self match
            FunctionSource { declaration: declaration operations: operations } => {
                bodies diagnostics allow_root_local_capture declaration operations store resolve_identifiers
                operations source_body::consume_source_body SourceBodyWork::Completed declaration.name.clone bodies.work.set
                declaration store.set_function
            }
        end
    }
}

pub struct Parser {
    bodies:              SourceBodies
    pub store:           common::SymbolStore
    pub import_stack:    std::List[std::String]
    pub analyzed_files:  std::Set[std::String]
    pub module_cache:    mut$std::Map[std::String ImportedModule]
    pub search_paths:    std::List[std::String]
    pub sources:         mut$lexer::SourceStore
    pub state:           ParseState
    pub module_contexts: std::List[ModuleContext]
    pub source_prefixes: std::Map[std::String std::String]
    imports:             ImportRecord
}

# One import resolution. `None` means no file was found. Reuse resolves it again before trusting it.
pub struct ImportResolution derives std::Clone {
    pub importing_file: std::String
    pub specifier:      std::String
    pub path:           std::Option[std::String]
}

# Facts about the modules one root imports, recorded while they are analyzed.
struct ImportRecord derives std::Clone {
    # Root-level imports in analysis order, including repeated cache hits.
    paths:       std::List[std::String]
    # Every resolution in the root and its imported modules, in analysis order.
    resolutions: std::List[ImportResolution]
    # False after an imported module reports a diagnostic or fails.
    clean:       bool
}

impl ImportRecord {
    fn new -> ImportRecord {
        true std::List[ImportResolution]::new std::List[std::String]::new ImportRecord
    }
}

pub struct ParseResolveResult {
    source:          std::Option[source_body::SourceProgram]
    pub diagnostics: error::Diagnostics
    resolutions:     std::List[ImportResolution]
}

impl ParseResolveResult {
    pub fn into_parts
        self:ParseResolveResult
    -> std::Option[source_body::SourceProgram] error::Diagnostics {
        self match
            ParseResolveResult { source: source diagnostics: diagnostics } => source diagnostics
        end
    }

    pub fn get_resolutions self:$ParseResolveResult -> $std::List[ImportResolution] {
        self.resolutions
    }
}

impl Parser {
    # Diagnostics spell declarations and types as the reporting file writes them.
    fn format_source_name self:$Parser name:$str location:$common::Location -> std::String {
        location.file.as_str name self.store.format_name_for_source
    }

    fn format_source_type self:$Parser typ:$common::Type location:$common::Location -> std::String {
        location.file.as_str typ self.store.format_type_for_source
    }

    # Source spelling of `common::TraitImpl::key`.
    fn format_source_trait_impl self:$Parser trait_impl:$common::TraitImpl -> std::String {
        trait_impl.location trait_impl.receiver self.format_source_type = receiver
        trait_impl.trait_bound.to_type = trait_type
        trait_impl.location trait_type self.format_source_type = trait_name
        f"{receiver}: {trait_name}"
    }

    pub fn new
        store:common::SymbolStore
        diagnostics:error::Diagnostics
        sources:mut$lexer::SourceStore
        import_cache:mut$std::Map[std::String ImportedModule]
    -> Parser {
        std::List[ModuleContext]::new = module_contexts
        ModuleContext::new module_contexts.push
        ImportRecord::new
        std::Map[std::String std::String]::new
        module_contexts
        diagnostics ParseState::new
        sources
        std::List[std::String]::new
        import_cache
        std::Set[std::String]::new
        std::List[std::String]::new
        store
        SourceBodies::new
        Parser
    }

    pub fn into_parts
        self:Parser
    -> common::SymbolStore std::Set[std::String] error::Diagnostics std::Map[std::String source_body::SourceBody] {
        self match
            Parser { store: store analyzed_files: analyzed_files state: state bodies: bodies } => {
                state.into_parts = references = diagnostics
                references store.type_references.append
                store analyzed_files diagnostics bodies.into_bodies
            }
        end
    }

    pub fn current_module self:$Parser -> $ModuleContext {
        self.module_contexts.length 1 - self.module_contexts.get_ref
    }

    pub fn current_module_mut self:mut$Parser -> mut$ModuleContext {
        self.module_contexts.length 1 - self.module_contexts.get_mut
    }

    pub fn into_result
        self:Parser
        ops:std::Option[std::List[common::Op]]
    -> ParseResolveResult std::List[std::String] {
        self
            .imports
            .resolutions
            .clone = resolutions
        self.into_parts = resolved_bodies = diagnostics = included_files = store
        included_files.to_list = included_file_list
        ops match
            std::Option::Some(operations) => resolved_bodies operations source_body::consume_source_body store source_body::SourceProgram::new std::Option::Some
            std::Option::None => std::Option[source_body::SourceProgram]::None
        end = source
        resolutions diagnostics source ParseResolveResult
        included_file_list
    }

    pub fn into_failed_result self:Parser -> ParseResolveResult std::List[std::String] {
        self
            .imports
            .resolutions
            .clone = resolutions
        self.into_parts = resolved_bodies = diagnostics = included_files = store
        store drop
        included_files.to_list = included_file_list
        std::Option[source_body::SourceProgram]::None = source
        resolutions diagnostics source ParseResolveResult
        included_file_list
    }

    fn register_declaration self:mut$Parser name:$str {
        self.state.mark_store_mutated
        name.to_str self
            .current_module_mut
            .declared_names
            .add
    }

    fn register_private_declaration self:mut$Parser name:$str {
        name self.register_declaration
        name.to_str self
            .store
            .module_private_symbols
            .add
    }

    pub fn put_function self:mut$Parser name:std::String function:FunctionSource {
        name.as_str self.register_private_declaration
        function.into_parts = operations = declaration
        if
            name.as_str self
                .store
                .member_accessors
                .has_str ! declaration.extern_symbol.is_none &&
        then
            operations name.clone self.bodies.add
        fi
        declaration self.store.set_function
    }

    fn put_generated_function self:mut$Parser function:FunctionSource {
        function.into_parts = operations = declaration
        operations declaration.name.clone self.bodies.add
        declaration self.store.set_generated_recipe
    }

    fn clone_source_operations self:$Parser name:$str -> std::List[common::Op] {
        name self.bodies.clone_operations
    }

    pub fn put_constant self:mut$Parser name:std::String constant:common::Constant {
        name.as_str self.register_private_declaration
        constant name self
            .store
            .constants
            .set
    }

    pub fn put_enum self:mut$Parser name:std::String casa_enum:common::CasaEnum {
        name.as_str self.register_private_declaration
        casa_enum name self
            .store
            .enums
            .set
    }

    pub fn put_struct self:mut$Parser name:std::String casa_struct:common::CasaStruct {
        name.as_str self.register_private_declaration
        casa_struct name self
            .store
            .structs
            .set
    }

    pub fn put_trait self:mut$Parser name:std::String casa_trait:common::CasaTrait {
        name.as_str self.register_private_declaration
        casa_trait name self
            .store
            .traits
            .set
    }

    pub fn put_trait_impl self:mut$Parser trait_impl:common::TraitImpl {
        trait_impl.key = name
        name.as_str self.register_declaration
        trait_impl self.store.set_trait_impl
        std::Map[std::String bool]::new = self.store.copy_types
    }
}

fn add_map_names[V] source:$std::Map[std::String V] destination:mut$std::Set[std::String] {
    for name in source.iter_keys do
        name.clone destination.add
    done
}

impl common::SymbolStore {
    pub fn declaration_names self:$common::SymbolStore -> std::Set[std::String] {
        std::Set[std::String]::new = names
        self.get_source_function_names = function_names
        while function_names.is_empty ! do
            function_names.pop names.add
        done
        names self.constants add_map_names
        names self.variables add_map_names
        names self.structs add_map_names
        names self.enums add_map_names
        names self.traits add_map_names
        names
    }

    pub fn is_function_unsafe self:$common::SymbolStore name:$str -> std::Option[bool] {
        if name self.get_function std::Option::Some(function) is then
            function.is_unsafe std::Option::Some
        else
            std::Option[bool]::None
        fi
    }

    pub fn get_struct_member_names
        self:$common::SymbolStore
        name:$str
    -> std::Option[std::List[std::String]] {
        if name self.structs.get_str std::Option::Some(casa_struct) is then
            std::List[std::String]::new = names
            for member in casa_struct.members.iter do
                member.name.clone names.push
            done
            names std::Option::Some
        else
            std::Option[std::List[std::String]]::None
        fi
    }

    pub fn count_trait_type_parameters self:$common::SymbolStore name:$str -> std::Option[u64] {
        if name self.traits.get_str std::Option::Some(casa_trait) is then
            casa_trait.type_params.length std::Option::Some
        else
            std::Option[u64]::None
        fi
    }

    pub fn clone_for_typecheck self:$common::SymbolStore -> common::SymbolStore {
        common::SymbolStore::new = cloned
        for name in self.get_function_names.iter do
            name.as_str self
                .get_function
                .unwrap
                .clone = function
            if name.as_str self.is_generated_recipe then
                function cloned.set_generated_recipe
            else
                function cloned.set_function
            fi
        done
        self.variables.clone = cloned.variables
        self.constants.clone = cloned.constants
        self.failed_constants.clone = cloned.failed_constants
        self.enums.clone = cloned.enums
        self.structs.clone = cloned.structs
        self.traits.clone = cloned.traits
        self.member_accessors.clone = cloned.member_accessors
        for name in self.get_trait_impl_names.iter do
            name.as_str self
                .get_trait_impl
                .unwrap
                .clone cloned.set_trait_impl
        done
        self.public_symbols.clone = cloned.public_symbols
        self.private_symbols.clone = cloned.private_symbols
        self.module_private_symbols.clone = cloned.module_private_symbols
        self cloned.copy_source_names_from
        cloned
    }
}

# Simple keyword -> OpValue lookup (no-payload variants only)
pub fn keyword_to_op_value keyword_kind:$common::KeywordKind -> std::Option[common::OpValue] {
    keyword_kind match
        common::KeywordKind::Break => common::OpValue::WhileBreak std::Option::Some
        common::KeywordKind::Continue => common::OpValue::WhileContinue std::Option::Some
        common::KeywordKind::Do => common::OpValue::WhileCondition std::Option::Some
        common::KeywordKind::Done => common::OpValue::WhileEnd std::Option::Some
        common::KeywordKind::Elif => common::OpValue::IfElif std::Option::Some
        common::KeywordKind::Else => common::OpValue::IfElse std::Option::Some
        common::KeywordKind::Fi => common::OpValue::IfEnd std::Option::Some
        common::KeywordKind::If => common::OpValue::IfStart std::Option::Some
        common::KeywordKind::Return => common::OpValue::FnReturn std::Option::Some
        common::KeywordKind::Then => common::OpValue::IfCondition std::Option::Some
        common::KeywordKind::While => common::OpValue::WhileStart std::Option::Some
        _ => std::Option[common::OpValue]::None
    end
}

pub struct NameResolver {
    pub tokens:          $std::List[common::Token]
    pub names:           std::Map[std::String common::SourceBinding]
    pub type_bindings:   std::List[std::String]
    pub module_prefixes: std::List[std::String]
}

impl NameResolver {
    pub fn new tokens:$std::List[common::Token] -> NameResolver {
        std::List[std::String]::new std::List[std::String]::new std::Map[std::String common::SourceBinding]::new tokens NameResolver
    }

    pub fn copy_module_prefixes self:mut$NameResolver prefixes:$std::Map[std::String std::String] {
        for prefix in prefixes.iter do
            prefix.second.clone self.module_prefixes.push
        done
    }

    pub fn restore_type_bindings self:mut$NameResolver count:u64 {
        while count self.type_bindings.length < do
            self.type_bindings.pop drop
        done
    }

    pub fn resolve_name self:$NameResolver name:$str -> std::String {
        name common::source_reference_head = head
        if head.as_str self.type_bindings common::string_list_contains then
            name.to_str return
        fi
        if self.names name common::resolve_source_name std::Option::Some(resolved) is then
            resolved return
        fi
        if head.as_str "__casa_" str::starts_with ! then
            name.to_str return
        fi
        for prefix in self.module_prefixes.iter do
            if head.as_str prefix.as_str str::starts_with then
                # No source binding exists. An unspellable suffix prevents store-key access.
                f"{name}@unbound" return
            fi
        done
        name.to_str
    }
}

# True if a type-position leaf is a constant argument (integer, `true`/`false`,
# or char literal) rather than a type name (ADR-0153).
pub fn is_type_argument_literal value:$str -> bool {
    if value common::try_parse_uint_literal.is_some value lexer::is_negative_integer_literal || then
        true return
    fi
    if "true" value.as_str == "false" value.as_str == || then
        true return
    fi
    value char_literal_codepoint.is_some
}

# Named type arguments and constant annotations share lookup precedence and failures.
fn read_constant_type_argument
    name:$str
    spelling:$str
    location:$common::Location
    store:$common::SymbolStore
    state:mut$ParseState
-> std::Option[common::Type] {
    if name store.constants.get_str std::Option::Some(named_constant) is then
        named_constant.value match
            common::ConstantValue::Int(integer) => {
                common::BuiltinType::U64 = integer_type
                if integer.raw.as_str "-" str::starts_with 0 integer.value != && then
                    common::BuiltinType::I64 = integer_type
                fi
                integer_type integer.value common::ConstType::concrete common::Type::Const std::Option::Some return
            }
            common::ConstantValue::Bool(value) => {
                common::BuiltinType::Bool value common::ConstType::concrete common::Type::Const std::Option::Some return
            }
            common::ConstantValue::Char(value) => {
                common::BuiltinType::Char value common::ConstType::concrete common::Type::Const std::Option::Some return
            }
            _ => {
                location f"Constant `{spelling}` cannot be a type argument: only integer, bool, and char values are allowed" common::ErrorKind::TypeMismatch state.record_error_string
                common::Type::Unknown std::Option::Some return
            }
        end
    fi

    if name store.failed_constants.has_str then
        location f"Constant `{spelling}` is unavailable because its declaration failed" common::ErrorKind::UndefinedName state.record_error_string
        common::Type::Unknown std::Option::Some return
    fi
    std::Option[common::Type]::None
}

fn validate_type_literal token:$common::Token state:mut$ParseState -> bool {
    if common::TokenKind::Literal token.kind != then
        true return
    fi
    if 0 token.value.length != then
        if
            0 token
                .value
                .at
                .unwrap
                .is_digit token.value.as_str common::try_parse_uint_literal.is_none &&
        then
            token.location f"Integer type argument `{token.value}` is outside `u64` range" common::ErrorKind::TypeMismatch state.record_error_string
            false return
        fi
    fi
    if token.value.as_str lexer::is_negative_integer_literal then
        token.value.as_str common::IntegerLiteral::parse = literal
        if common::make_i64_type literal.fits ! then
            token.location f"Integer type argument `{token.value}` is outside `i64` range" common::ErrorKind::TypeMismatch state.record_error_string
            false return
        fi
    fi
    true
}

# Share type-name lookup and literal validation with parsed declaration types.
fn resolve_type_head
    token:$common::Token
    resolver:$NameResolver
    state:mut$ParseState
    store:$common::SymbolStore
-> std::String str std::Option[common::Type] {
    "" = borrow_prefix
    std::String::new = base
    if "fn" token.value.as_str == then
        "fn".to_str = base
    else
        token = base_token
        if state base_token validate_type_literal ! then
            std::String::new "" common::Type::Unknown std::Option::Some return
        fi
        if
            common::TokenKind::Identifier base_token.kind !=
            base_token.value.as_str resolver.resolve_name.as_str is_type_argument_literal ! &&
        then
            base_token.location "Expected type name" common::ErrorKind::UnexpectedToken state.record_error
        fi
        base_token.value.as_str resolver.resolve_name = base
        if base.as_str "@unbound" str::ends_with then
            base_token.location f"Type `{base_token.value}` is not defined in this module" common::ErrorKind::UndefinedName state.record_error_string
        fi
    fi
    if base.as_str "mut$" str::starts_with then
        common::EXCLUSIVE_BORROW_TYPE = borrow_prefix
        base.length = base_length
        base.as_str 4 base_length 4 - str::substring = base
    elif base.as_str "$" str::starts_with then
        common::SHARED_BORROW_TYPE = borrow_prefix
        base.length = base_length
        base.as_str 1 base_length 1 - str::substring = base
    fi
    if base.as_str "$" str::starts_with base.as_str "mut$" str::starts_with || then
        token.location "Nested borrow qualifiers are not supported" common::ErrorKind::Syntax
        state.record_error
        std::String::new "" common::Type::Unknown std::Option::Some return
    fi

    if base.as_str resolver.type_bindings common::string_list_contains then
        borrow_prefix base.clone common::Type::TypeVar common::apply_borrow_type = resolved
        base borrow_prefix resolved std::Option::Some return
    fi

    # Char constant (ADR-0153): built here rather than in `parse_type_str`,
    # which cannot decode the codepoint.
    if base.as_str char_literal_codepoint std::Option::Some(char_codepoint) is then
        common::BuiltinType::Char char_codepoint common::ConstType::concrete common::Type::Const = resolved
        base borrow_prefix resolved std::Option::Some return
    fi

    if
        state store token.location token.value.as_str base.as_str read_constant_type_argument std::Option::Some(constant_type) is
    then
        base borrow_prefix constant_type std::Option::Some return
    fi

    if
        common::TokenKind::Identifier token.kind == base store.builtins.has ! &&
        base.as_str "@unbound" str::ends_with ! &&
    then
        token.value.as_str common::path_name_spans.name copy base.as_str token state.record_type_reference
    fi
    base borrow_prefix std::Option[common::Type]::None
}

# Resolve a parsed type without consuming or repositioning the token stream.
fn resolve_parsed_type
    parsed:$grammar::TypeSyntax
    resolver:$NameResolver
    state:mut$ParseState
    store:$common::SymbolStore
-> common::Type {
    parsed.token resolver.tokens.get = token
    store state resolver token resolve_type_head = resolved = borrow_prefix = base
    if resolved std::Option::Some(typ) is then
        if parsed.arguments.is_some then
            token.location "Unexpected type arguments" common::ErrorKind::UnexpectedToken state.record_error
        fi
        typ return
    fi
    if parsed.arguments std::Option::Some(arguments) is then
        false store state resolver arguments.parameters resolve_parsed_arguments = parameters
        if "fn" base.as_str == then
            std::List[common::Type]::new = returns
            for result in arguments.returns.iter do
                store state resolver result resolve_parsed_type returns.push
            done
            borrow_prefix returns parameters common::FunctionType common::Type::Function common::apply_borrow_type return
        fi
        if 0 parameters.length == then
            common::empty_location f"Expected type parameter inside `{base}[...]`" common::ErrorKind::UnexpectedToken state.record_error_string
        fi
        borrow_prefix parameters base common::GenericType::with_params common::Type::Generic common::apply_borrow_type return
    fi
    borrow_prefix base.as_str common::parse_type_str common::apply_borrow_type
}

# Separators are legal in trait bounds. Other applied types diagnose them in place.
fn resolve_parsed_arguments
    arguments:$std::List[grammar::TypeArgumentSyntax]
    resolver:$NameResolver
    state:mut$ParseState
    store:$common::SymbolStore
    allow_separators:bool
-> std::List[common::Type] {
    std::List[common::Type]::new = types
    for argument in arguments.iter do
        argument match
            grammar::TypeArgumentSyntax::Type(typ) => {
                store state resolver typ resolve_parsed_type types.push
            }
            grammar::TypeArgumentSyntax::Separator(position) => {
                if allow_separators ! then
                    position resolver.tokens.get = token
                    token.location "Expected type name" common::ErrorKind::UnexpectedToken state.record_error
                    token.value.as_str common::parse_type_str types.push
                fi
            }
        end
    done
    types
}

fn resolve_parsed_bound
    parsed:$grammar::TypeSyntax
    resolver:$NameResolver
    state:mut$ParseState
    store:$common::SymbolStore
-> common::TraitBound {
    parsed.token resolver.tokens.get = token
    token.value.as_str resolver.resolve_name = name
    if common::TokenKind::Identifier token.kind != then
        token.location "Expected trait name" common::ErrorKind::UnexpectedToken state.record_error
    else
        token.value.as_str common::path_name_spans.name copy name.as_str token state.record_type_reference
    fi
    std::List[common::Type]::new = arguments
    if parsed.arguments std::Option::Some(types) is then
        true store state resolver types.parameters resolve_parsed_arguments = arguments
    fi
    arguments name common::TraitBound
}

pub fn char_literal_codepoint value:$str -> std::Option[i64] {
    if 3 value.length > then
        std::Option[i64]::None return
    fi
    if '\'' 0 value.at.unwrap != '\'' value.length 1 - value.at.unwrap != || then
        std::Option[i64]::None return
    fi
    value 1 lexer::decode_utf8_scalar = decoded_opt
    if decoded_opt std::Option::Some(decoded) is then
        if decoded.byte_length 2 + value.length == then
            decoded lexer::DecodedUtf8Scalar::codepoint i64::from std::Option::Some return
        fi
    fi
    std::Option[i64]::None
}

pub fn get_op_literal token:$common::Token state:mut$ParseState -> common::Op {
    token.value.as_str = value: $str
    if "true" value.as_str == then
        token.location 1 common::OpValue::PushBool common::Op::new return
    fi
    if "false" value.as_str == then
        token.location 0 common::OpValue::PushBool common::Op::new return
    fi
    # Numeric literal (positive or negative)
    if value lexer::is_float_literal then
        token.location value.to_str common::OpValue::PushFloat common::Op::new return
    fi
    if
        0 value
            .at
            .unwrap
            .is_digit value lexer::is_negative_integer_literal ||
    then
        token.location value common::IntegerLiteral::parse common::OpValue::PushInt common::Op::new return
    fi
    value char_literal_codepoint = char_opt
    if char_opt std::Option::Some(char_value) is then
        token.location char_value common::OpValue::PushChar common::Op::new return
    fi
    # String literal: "..."
    if '"' 0 value.at.unwrap == '"' value.length 1 - value.at.unwrap == && then
        value.length = value_length
        value 1 value_length 2 - str::substring = str_value
        token.location str_value common::OpValue::PushStr common::Op::new return
    fi
    token.location f"Token `{value}` is not a literal" common::ErrorKind::Syntax state.record_error_string
    token.location 0 common::make_integer_op_value common::Op::new
}

# Recognition routes `size_of` through its type operand.
pub fn get_op_intrinsic token:$common::Token state:mut$ParseState -> common::Op {
    token.value.as_str common::intrinsic_from_str = kind_opt
    if kind_opt std::Option::Some(kind) is then
        kind copy common::intrinsic_to_op_value match
            std::Option::Some(op_value) => token.location op_value common::Op::new return
            std::Option::None => {
                token.location f"No OpValue for intrinsic `{token.value.as_str}`" common::ErrorKind::Syntax state.record_error_string
            }
        end
    else
        token.location f"Token `{token.value.as_str}` is not an intrinsic" common::ErrorKind::Syntax state.record_error_string
    fi
    token.location 0 common::make_integer_op_value common::Op::new
}

# Recognition routes assignments through their targets.
pub fn get_op_operator token:$common::Token state:mut$ParseState -> common::Op {
    token.value.as_str common::operator_from_str = kind_opt
    if kind_opt std::Option::Some(kind) is then
        kind copy common::operator_to_op_value match
            std::Option::Some(op_value) => token.location op_value common::Op::new return
            std::Option::None => {
                token.location f"No OpValue for operator `{token.value.as_str}`" common::ErrorKind::Syntax state.record_error_string
            }
        end
    else
        token.location f"Token `{token.value.as_str}` is not an operator" common::ErrorKind::Syntax state.record_error_string
    fi
    token.location 0 common::make_integer_op_value common::Op::new
}

pub fn require_global_scope
    function_name:$str
    what:str
    location:$common::Location
    parser:mut$Parser
{
    if common::GLOBAL_SCOPE_LABEL function_name != then
        location f"{what} should be defined in the global scope" common::ErrorKind::InvalidScope parser.state.record_error_string
    fi
}

# Generic parameter names, trait bounds, and constant parameter types.
pub struct ParsedTypeVariables {
    pub names:        std::List[std::String]
    pub trait_bounds: std::Map[std::String std::List[common::TraitBound]]
    pub const_params: std::Map[std::String common::BuiltinType]
}

impl ParsedTypeVariables {
    pub fn into_parts
        self:ParsedTypeVariables
    -> std::List[std::String] std::Map[std::String std::List[common::TraitBound]] std::Map[std::String common::BuiltinType] {
        self match
            ParsedTypeVariables { names: names trait_bounds: trait_bounds const_params: const_params } => names trait_bounds const_params
        end
    }
}

pub fn trait_bound_method_effect
    type_variable:$str
    method:$common::TraitMethod
    bound:$common::TraitBound
    casa_trait:$common::CasaTrait
-> common::StackEffect {
    casa_trait bound rules::make_bound_substitutions = substitutions
    0 = method_type_index: u64
    for method_type_variable in method.type_vars.iter do
        f"__method_type_{method_type_index}" common::Type::TypeVar
        method_type_variable.clone substitutions.set
        1 += method_type_index
    done
    type_variable.to_str common::Type::TypeVar method.stack_effect common::resolve_trait_stack_effect = effect
    substitutions effect common::apply_type_subs_to_stack_effect
}

pub fn stack_effect_shapes_equal first:$common::StackEffect second:$common::StackEffect -> bool {
    if first.parameters.length second.parameters.length != then
        false return
    fi
    if first.return_types.length second.return_types.length != then
        false return
    fi
    for
        pair in second.parameters.iter first
            .parameters
            .list_iter
            .zip
    do
        if
            pair.second.typ pair
                .first
                .typ
                .eq !
        then
            false return
        fi
    done
    for
        pair in second.return_types.iter first
            .return_types
            .list_iter
            .zip
    do
        if pair.second pair.first.eq ! then
            false return
        fi
    done
    true
}

pub fn bound_is_compatible
    parser:mut$Parser
    type_variable:$str
    existing_bounds:$std::List[common::TraitBound]
    candidate:$common::TraitBound
-> bool {
    candidate.name parser
        .store
        .traits
        .get = candidate_trait_opt
    if candidate_trait_opt std::Option::Some(candidate_trait) is else
        false return
    fi
    candidate_trait parser.store rules::collect_trait_methods = candidate_methods
    for candidate_method in candidate_methods.iter do
        candidate_trait candidate candidate_method type_variable trait_bound_method_effect
        = candidate_effect
        for existing_bound in existing_bounds.iter do
            existing_bound.name parser
                .store
                .traits
                .get = existing_trait_opt
            if existing_trait_opt std::Option::Some(existing_trait) is else
                continue
            fi
            existing_trait parser.store rules::collect_trait_methods = existing_methods
            for existing_method in existing_methods.iter do
                if existing_method.name candidate_method.name != then
                    continue
                fi
                existing_trait existing_bound existing_method type_variable trait_bound_method_effect
                = existing_effect
                if candidate_effect existing_effect stack_effect_shapes_equal ! then
                    false return
                fi
            done
        done
    done
    true
}

# Builtin types allowed as a constant parameter (ADR-0153): integer widths,
# `bool`, `char`. Float and `str` are rejected — neither can select an
# instantiation (ADR-0012 for floats).
pub fn const_type_parameter_type_allowed builtin:$common::BuiltinType -> bool {
    if builtin.is_integer then
        true return
    fi
    builtin common::BuiltinType::Bool == builtin common::BuiltinType::Char == ||
}

# Apply the shared constant-parameter rewrite to every parameter and return type of a
# stack effect (ADR-0152).
pub fn rewrite_stack_effect_constant_parameters
    effect:mut$common::StackEffect
    constant_parameters:$std::Map[std::String common::BuiltinType]
{
    std::List[common::Parameter]::new = new_parameters
    for parameter in effect.parameters.iter do
        constant_parameters parameter.typ rules::rewrite_type_const_params = rewritten_type
        parameter.location.clone parameter.name.clone rewritten_type common::Parameter new_parameters.push
    done
    std::List[common::Type]::new = new_return_types
    for return_type in effect.return_types.iter do
        constant_parameters return_type rules::rewrite_type_const_params new_return_types.push
    done
    new_parameters effect common::StackEffect::set_parameters
    new_return_types effect common::StackEffect::set_return_types
}

# Rewrite constant-parameter names in a body's cast and hint types so they read
# as constants rather than unknown type names (ADR-0152).
pub fn rewrite_operation_constant_parameters
    operations:mut$std::List[common::Op]
    constant_parameters:$std::Map[std::String common::BuiltinType]
{
    if 0 constant_parameters.length == then
        return
    fi
    std::Map[std::String common::Type]::new = substitutions
    for constant_name in constant_parameters.keys.iter do
        constant_name constant_parameters.get.unwrap constant_name.clone common::ConstType::symbolic common::Type::Const
        constant_name.clone substitutions.set
    done
    substitutions operations common::substitute_ops_types
}

# Register constant parameters as body variables. Concrete specializations
# replace their reads with literals before bytecode lowering.
pub fn inject_constant_parameters
    effect:mut$common::StackEffect
    variables:mut$std::List[common::Variable]
    location:common::Location
-> std::List[common::Op] {
    std::List[common::Op]::new = assignments
    effect.const_params = constant_parameters: $std::Map[std::String common::BuiltinType]
    if 0 constant_parameters.length == then
        assignments return
    fi
    for constant_name in constant_parameters.keys.iter do
        constant_name constant_parameters.get.unwrap common::Type::Builtin = constant_type
        constant_type.clone constant_name.clone common::Variable variables.push
    done
    assignments
}

fn read_constant_reference
    term:$grammar::ConstantTerm
    resolver:$NameResolver
    store:$common::SymbolStore
    nonconstant_names:$std::Set[std::String]
    diagnostics:mut$error::Diagnostics
-> std::Option[constant_eval::EvalValue] {
    term.spelling.as_str resolver.resolve_name = name
    if
        name.as_str store
            .constants
            .get_str std::Option::Some(found) is
    then
        if
            term
                .location
                .file
                .as_str name.as_str store.is_private_from
        then
            term.location f"Constant `{term.spelling}` is private" common::ErrorKind::InvalidScope diagnostics.record_error_string
            std::Option[constant_eval::EvalValue]::None return
        fi
        term.location.clone found.typ.clone found.value.clone constant_eval::EvalValue::new std::Option::Some return
    fi
    if
        term.spelling.as_str nonconstant_names
            .has_str
        name.as_str store
            .get_function
            .is_some ||
        name.as_str store
            .structs
            .has_str ||
        name.as_str store
            .enums
            .has_str ||
        name.as_str store
            .traits
            .has_str ||
        name.as_str store
            .variables
            .has_str ||
    then
        term.location f"`{term.spelling}` is not a constant" common::ErrorKind::TypeMismatch diagnostics.record_error_string
    elif
        name.as_str store
            .failed_constants
            .has_str
        term
            .location
            .file
            .as_str name.as_str store.is_private_from &&
    then
        term.location f"Constant `{term.spelling}` is private" common::ErrorKind::InvalidScope diagnostics.record_error_string
    elif
        name.as_str store
            .failed_constants
            .has_str term.spelling.as_str resolver.names.has_str ||
    then
        term.location f"Constant `{term.spelling}` is unavailable" common::ErrorKind::UndefinedName diagnostics.record_error_string
    else
        term.location f"Unknown constant `{term.spelling}`" common::ErrorKind::UndefinedName diagnostics.record_error_string
    fi
    std::Option[constant_eval::EvalValue]::None
}

impl Parser {
    fn evaluate_constant_declaration
        self:mut$Parser
        resolver:$NameResolver
        declaration:$grammar::DeclarationSyntax
        initializer:$grammar::ConstantSyntax
    {
        declaration.name.as_str resolver.resolve_name = name
        std::Option[common::BuiltinType]::None = annotation
        if initializer.annotation std::Option::Some(written) is then
            common::Type::Unknown = annotation_type
            if written grammar::ConstantAnnotation::Name(type_name location) is then
                type_name.as_str resolver.resolve_name = resolved_name
                if
                    self.state self.store location type_name.as_str resolved_name.as_str read_constant_type_argument std::Option::Some(constant_type) is
                then
                    constant_type = annotation_type
                else
                    resolved_name.as_str common::parse_type_str = annotation_type
                fi
            fi
            if annotation_type common::Type::Builtin(builtin) is then
                if
                    builtin.is_integer builtin.is_float || builtin common::BuiltinType::Bool == || builtin common::BuiltinType::Char == || builtin common::BuiltinType::Str == ||
                then
                    builtin std::Option::Some = annotation
                else
                    builtin.format = type_name
                    declaration.location f"Unsupported constant type `{type_name}`" common::ErrorKind::TypeMismatch self.state.record_error_string
                    return
                fi
            else
                declaration.location "Constant annotation must name a primitive value type" common::ErrorKind::TypeMismatch self.state.record_error
                return
            fi
        fi
        self.store = store: $common::SymbolStore
        self.current_module.nonconstant_names = nonconstant_names: $std::Set[std::String]
        {
            = term: $grammar::ConstantTerm = diagnostics: mut$error::Diagnostics
            diagnostics nonconstant_names store resolver term read_constant_reference
        } = resolve_reference
        if
            self.state.diagnostics resolve_reference declaration.location annotation initializer constant_eval::evaluate_initializer std::Option::Some(checked) is
        then
            if
                name.as_str self
                    .store
                    .constants
                    .has_str
            then
                declaration.location f"Constant `{declaration.name}` is already defined" common::ErrorKind::DuplicateName self.state.record_error_string
                return
            fi
            declaration.location.clone checked.typ.clone checked.value.clone name.clone common::Constant = constant
            constant name self.put_constant
        fi
    }
}

fn resolve_constant_parameter
    parameter:$grammar::GenericParameterSyntax
    token:$common::Token
    resolver:$NameResolver
    state:mut$ParseState
-> std::Option[common::BuiltinType] {
    if 1 parameter.bounds.length != then
        token.location "Expected a constant parameter type" common::ErrorKind::Syntax state.record_error
        std::Option[common::BuiltinType]::None return
    fi
    0 parameter.bounds.get = annotation
    annotation.token resolver.tokens.get = type_token
    if annotation.arguments.is_some then
        type_token.location "Expected a constant parameter type" common::ErrorKind::Syntax state.record_error
    fi
    if type_token.value.as_str common::parse_builtin std::Option::Some(builtin) is then
        if builtin const_type_parameter_type_allowed ! then
            type_token.location f"Constant parameter `{token.value}` cannot have type `{type_token.value}`: only integer, `bool`, and `char` constants are allowed" common::ErrorKind::Syntax state.record_error_string
        fi
        builtin std::Option::Some return
    fi
    type_token.location f"Constant parameter `{token.value}` has unknown type `{type_token.value}`" common::ErrorKind::Syntax state.record_error_string
    std::Option[common::BuiltinType]::None
}

fn resolve_parameter_bounds
    parser:mut$Parser
    parameter:$grammar::GenericParameterSyntax
    token:$common::Token
    resolver:$NameResolver
-> std::List[common::TraitBound] {
    std::List[common::TraitBound]::new = bounds
    for parsed_bound in parameter.bounds.iter do
        parsed_bound.token resolver.tokens.get = bound_token
        bound_token.value.as_str resolver.resolve_name = bound_name
        bound_name parser
            .store
            .traits
            .get = definition
        # Name lookup precedes argument resolution in diagnostic encounter order.
        if definition.is_none then
            bound_token.location f"Trait `{bound_token.value}` is not defined" common::ErrorKind::UndefinedName parser.state.record_error_string
        fi
        parser.store parser.state resolver parsed_bound resolve_parsed_bound = bound
        if definition std::Option::Some(trait_definition) is then
            trait_definition.type_params.length
        else
            continue
        fi = expected
        bound.type_args.length = actual
        if actual expected != then
            bound_token.location f"Trait `{bound_token.value}` expects {expected} type argument(s), got {actual}" common::ErrorKind::Syntax parser.state.record_error_string
        fi
        false = duplicate
        for existing in bounds.iter do
            if bound existing.matches then
                true = duplicate
            fi
        done
        if duplicate then
            continue
        fi
        if bound bounds token.value.as_str parser bound_is_compatible ! then
            bound_token.location f"Bounds on `{token.value}` have incompatible requirements for the same method" common::ErrorKind::TraitSignatureMismatch parser.state.record_error_string
        fi
        bound bounds.push
    done
    bounds
}

# Establish declaration-local bindings in source order, then validate their bounds.
fn resolve_generic_parameters
    parser:mut$Parser
    parsed:$std::Option[grammar::GenericParametersSyntax]
    resolver:mut$NameResolver
-> ParsedTypeVariables {
    std::List[std::String]::new = names
    std::Set[std::String]::new = seen
    std::Map[std::String std::List[common::TraitBound]]::new = trait_bounds
    std::Map[std::String common::BuiltinType]::new = constants
    if parsed std::Option::Some(parameters) is then
        parameters
    else
        constants trait_bounds names ParsedTypeVariables return
    fi = parameters
    if 0 parameters.parameters.length == then
        parameters.close_token resolver
            .tokens
            .get
            .location "Empty type parameter list `[]` is not allowed" common::ErrorKind::Syntax parser.state.record_error
    fi
    for parameter in parameters.parameters.iter do
        parameter.name_token resolver
            .tokens
            .get
            .clone = token
        if
            token.value.as_str parser
                .store
                .builtins
                .has_str
        then
            if parameter.constant.is_some then "Constant parameter" else "Type variable" fi = kind
            token.location f"{kind} `{token.value}` shadows built-in type" common::ErrorKind::DuplicateName parser.state.record_error_string
        fi
        if token.value.as_str seen.has_str then
            token.location f"Duplicate type variable `{token.value}`" common::ErrorKind::DuplicateName parser.state.record_error_string
        fi
        token.value.clone resolver.type_bindings.push
        token.value.clone names.push
        token.value.clone seen.add
        if parameter.constant.is_some then
            if
                parser.state resolver token parameter resolve_constant_parameter std::Option::Some(builtin) is
            then
                builtin token.value.clone constants.set
            fi
        elif 0 parameter.bounds.length != then
            resolver token parameter parser resolve_parameter_bounds token.value.clone trait_bounds.set
        fi
    done
    constants trait_bounds names ParsedTypeVariables
}

fn resolve_derived_traits
    derives:$std::List[u64]
    resolver:$NameResolver
    state:mut$ParseState
-> std::List[std::String] {
    std::List[std::String]::new = traits
    for position in derives.iter do
        position copy resolver.tokens.get = token
        token.value.as_str resolver.resolve_name = name
        token.value.as_str common::path_name_spans.name copy name.as_str token state.record_type_reference
        if name.as_str traits common::string_list_contains then
            token.location f"Trait `{token.value}` is derived more than once" common::ErrorKind::DuplicateName state.record_error_string
        else
            name traits.push
        fi
    done
    traits
}

fn construct_enum
    parser:mut$Parser
    declaration:$grammar::DeclarationSyntax
    parsed:$grammar::AggregateSyntax
    resolver:mut$NameResolver
-> common::CasaEnum {
    resolver.type_bindings.length = inherited_bindings
    resolver parsed.parameters parser resolve_generic_parameters = generic_parameters
    generic_parameters.into_parts = constant_parameters = bounds = type_vars
    parser.state resolver parsed.derives resolve_derived_traits = derived_traits
    std::List[std::String]::new = variants
    std::Map[std::String std::List[common::Type]]::new = variant_types
    std::Map[std::String common::Location]::new = variant_locations
    type_vars common::string_list_to_set = type_variables
    for variant in parsed.members.iter do
        variant.name_token resolver.tokens.get = token
        if variant.public then
            token.location "Expected variant name" common::ErrorKind::UnexpectedToken parser.state.record_error
        fi
        if token.value.as_str variants common::string_list_contains then
            token.location f"Duplicate variant `{token.value}`" common::ErrorKind::DuplicateName parser.state.record_error_string
        fi
        token.value.clone variants.push
        token.location.clone token.value.clone variant_locations.set
        std::List[common::Type]::new = inner_types
        if variant.payload std::Option::Some(payload) is then
            for typ in payload.iter do
                parser.store parser.state resolver typ resolve_parsed_type = resolved
                type_variables resolved common::canonicalize_type_var inner_types.push
            done
            if 0 inner_types.length == then
                token.location "Variant inner types cannot be empty" common::ErrorKind::Syntax parser.state.record_error
            fi
        fi
        inner_types token.value.clone variant_types.set
    done
    if 0 variants.length == then
        declaration.location "Enum must have at least one variant" common::ErrorKind::Syntax parser.state.record_error
    fi
    declaration.name.as_str resolver.resolve_name = name
    variant_locations derived_traits type_vars variant_types declaration.location.clone variants name common::CasaEnum
    inherited_bindings resolver.restore_type_bindings
}
pub const DERIVED_HASH_SEED 5381
pub const DERIVED_HASH_SHIFT 5

pub fn make_aggregate_receiver name:$str type_vars:$std::List[std::String] -> common::Type {
    std::List[common::Type]::new = arguments
    for type_variable in type_vars.iter do
        type_variable.clone common::Type::TypeVar arguments.push
    done
    arguments name.to_str common::GenericType::with_params common::Type::Generic
}

pub fn make_derived_trait_bounds
    trait_name:$str
    type_vars:$std::List[std::String]
    required_type_vars:$std::Set[std::String]
-> std::Map[std::String std::List[common::TraitBound]] {
    std::Map[std::String std::List[common::TraitBound]]::new = trait_bounds
    for type_variable in type_vars.iter do
        if type_variable required_type_vars.has ! then
            continue
        fi
        std::List[common::TraitBound]::new = type_bounds
        std::List[common::Type]::new trait_name.to_str common::TraitBound type_bounds.push
        type_bounds type_variable.clone trait_bounds.set
    done
    trait_bounds
}

pub fn match_derived_impl_parameters
    actual:$common::GenericType
    trait_impl:$common::TraitImpl
-> bool {
    std::Set[std::String]::new = seen
    for parameter in actual.params.iter do
        if parameter common::Type::TypeVar(type_variable) is then
            if type_variable.as_str trait_impl.type_vars common::string_list_contains ! then
                false return
            fi
            if type_variable seen.has then
                false return
            fi
            type_variable.clone seen.add
        else
            false return
        fi
    done
    true
}

pub fn match_derived_generic_receivers
    expected:$common::GenericType
    actual:$common::GenericType
    trait_impl:$common::TraitImpl
    type_vars:$std::List[std::String]
-> bool {
    if expected.base actual.base != expected.params.length actual.params.length != || then
        false return
    fi
    if type_vars.length trait_impl.type_vars.length != then
        false return
    fi
    trait_impl actual match_derived_impl_parameters
}

pub fn match_derived_receiver_impl
    receiver:$common::Type
    type_vars:$std::List[std::String]
    trait_impl:$common::TraitImpl
-> bool {
    if receiver common::Type::Generic(expected) is then
        if trait_impl.receiver common::Type::Generic(actual) is then
            type_vars trait_impl actual expected match_derived_generic_receivers
        else
            false
        fi
    else
        false
    fi
}

pub fn make_derived_function_name receiver:$common::Type method_name:$str -> std::String {
    f"{receiver.match_base}::__derived_{method_name}"
}

pub fn is_same_declaration left:$common::Location right:$common::Location -> bool {
    left.file right.file == left.span.offset right.span.offset == &&
}

fn share_trait_method
    left:$std::List[rules::TraitMethodCandidate]
    right:$std::List[rules::TraitMethodCandidate]
-> bool {
    for left_method in left.iter do
        for right_method in right.iter do
            if left_method.method.name right_method.method.name == then
                true return
            fi
        done
    done
    false
}

pub fn find_overlapping_explicit_trait
    parser:$Parser
    receiver:$common::Type
    trait_name:$str
    location:$common::Location
-> std::Option[std::String] {
    trait_name.to_str common::GenericType::new common::Type::Generic = derived_type
    derived_type parser.store rules::collect_trait_method_candidates = derived_methods
    for
        explicit_impl in receiver parser
            .store
            .get_trait_impl_candidates_for_receiver
    do
        if location explicit_impl.location is_same_declaration then
            continue
        fi
        if explicit_impl.receiver.match_base receiver.match_base != then
            continue
        fi
        explicit_impl.trait_bound.to_type = explicit_type
        if parser.store explicit_type derived_type rules::trait_type_implies then
            explicit_type.format std::Option::Some return
        fi
        if parser.store derived_type explicit_type rules::trait_type_implies then
            explicit_type.format std::Option::Some return
        fi
        explicit_type parser.store rules::collect_trait_method_candidates = explicit_methods
        if explicit_methods derived_methods share_trait_method then
            explicit_type.format std::Option::Some return
        fi
    done
    std::Option[std::String]::None
}

pub fn install_derived_trait_impl
    parser:mut$Parser
    receiver:$common::Type
    type_vars:$std::List[std::String]
    required_type_vars:$std::Set[std::String]
    required_trait:$str
    trait_name:$str
    methods:$std::Map[std::String std::String]
    location:$common::Location
{
    std::Option[common::TraitImpl]::None = existing_opt
    for
        existing in trait_name receiver parser
            .store
            .get_trait_impl_candidates_for_receiver_and_trait
    do
        if existing type_vars receiver match_derived_receiver_impl ! then
            continue
        fi
        existing.clone std::Option::Some = existing_opt
        break
    done
    if existing_opt std::Option::Some(existing) is then
        if location existing.location is_same_declaration then
            return
        fi
        location f"Derived `{location trait_name parser.format_source_name}` for `{location receiver parser.format_source_type}` overlaps an explicit implementation" common::ErrorKind::DuplicateName parser.state.record_error_string
        return
    fi

    required_type_vars type_vars required_trait make_derived_trait_bounds = trait_bounds
    location.clone
    methods.clone
    trait_bounds
    type_vars.clone
    std::List[common::Type]::new trait_name.to_str common::TraitBound
    receiver.clone
    common::TraitImpl
    parser register_trait_impl
}

