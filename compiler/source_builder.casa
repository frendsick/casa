                    .location
                    .span
                    .offset span.offset + op.location.with_span
                common::TypeReference store.type_references.push
            fi
        fi
    fi
    1 parts.get = method_name
    trait_name.clone common::GenericType::new common::Type::Generic = trait_type
    if op.type_hint std::Option::Some(hint) is then
        hint.clone = trait_type
    fi
    method_name.clone trait_type false common::QualifiedMethod common::OpValue::QualifiedMethodCall op common::Op::set_value
    true
}

pub fn try_resolve_type_qualified_method
    store:mut$common::SymbolStore
