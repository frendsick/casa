# Request-owned syntax, editor analysis, and assembly products.
import "std" as std
import "os" as os
import "common" as common
import "error" as error
import "lexer" as lexer
import "syntax" as grammar
import "source_builder" as parser
import "typechecker" as typechecker
import "document" as document
import "backend" as backend

pub struct SourceUnit {
    pub file: std::String
    pub text: std::String
}

pub struct CompilationInput {
    pub root:             SourceUnit
    pub base_directory:   std::String
    pub library_paths:    std::List[std::String]
    pub source_overrides: std::Map[std::String std::String]
}

impl CompilationInput {
    pub fn new root:SourceUnit base_directory:std::String -> CompilationInput {
        std::Map[std::String std::String]::new std::List[std::String]::new
        base_directory root CompilationInput
    }

    fn resolve_path self:$CompilationInput path:$str -> std::String {
        if path "/" str::starts_with then
            path lexer::normalize_path
        else
            f"{self.base_directory}/{path}".as_str lexer::normalize_path
        fi
    }

    # Overrides first, then the authoritative root text.
    fn request_sources self:$CompilationInput root_file:$str -> lexer::SourceStore {
        lexer::SourceStore::new = sources
        for override in self.source_overrides.iter do
            override.second.as_str override.first.as_str self.resolve_path.as_str sources.add
        done
        self
            .root
            .text
            .as_str root_file sources.add
        sources
    }

    fn resolve_library_paths self:$CompilationInput -> std::List[std::String] {
        std::List[std::String]::new = resolved
        for path in self.library_paths.iter do
            path.as_str self.resolve_path resolved.push
        done
        resolved
    }

    fn input_failure self:$CompilationInput message:std::String -> CompilerFailure {
        lexer::SourceStore::new = sources
        self
            .root
            .text
            .as_str self
            .root
            .file
            .as_str sources.add
        sources error::Diagnostics::new Report = report
        std::Option[common::Location]::None message CompilerPhase::Input report CompilerFailure
    }

    # Normalize override identities before choosing any source. Root text is authoritative.
    fn validate self:$CompilationInput -> std::Option[CompilerFailure] {
        if self.base_directory.as_str "/" str::starts_with ! then
            "Compilation base directory must be absolute".to_str self.input_failure
            std::Option::Some return
        fi
        self
            .root
            .file
            .as_str self.resolve_path = root_file
        std::Map[std::String std::String]::new = aliases
        for override in self.source_overrides.iter do
            override.first.as_str self.resolve_path = path
            if root_file path == then
                continue
            fi
            if path.as_str aliases.get_str std::Option::Some(previous) is then
                previous.as_str self
                    .source_overrides
                    .get_str
                    .unwrap = previous_source
                if previous_source override.second != then
                    f"Conflicting source overrides `{previous}` and `{override.first}` resolve to `{path}`"
                    self.input_failure std::Option::Some return
                fi
            else
                override.first.clone path aliases.set
            fi
        done
        std::Option[CompilerFailure]::None
    }
}

pub struct Report {
    diagnostics: error::Diagnostics
    sources:     lexer::SourceStore
}

impl Report {
    pub fn new diagnostics:error::Diagnostics sources:lexer::SourceStore -> Report {
        sources diagnostics Report
    }

    pub fn into_parts self:Report -> error::Diagnostics lexer::SourceStore {
        self match
            Report { diagnostics: diagnostics sources: sources } => diagnostics sources
        end
    }

    pub fn count_diagnostics self:$Report -> u64 { self.diagnostics.entries.length }

    pub fn get_presentation self:$Report index:u64 -> error::DiagnosticPresentation {
        index self
            .diagnostics
            .entries
            .get
            .present
    }

    pub fn get_diagnostics self:$Report -> $error::Diagnostics { self.diagnostics }
    pub fn get_sources self:$Report -> $lexer::SourceStore { self.sources }
}

pub enum CompilerPhase derives std::Copy std::Eq {
    Input
    Checking
    Backend
}

pub struct CompilerFailure {
    report:   Report
    phase:    CompilerPhase
    message:  std::String
    location: std::Option[common::Location]
}

impl CompilerFailure {
    pub fn get_report self:$CompilerFailure -> $Report { self.report }
    pub fn get_phase self:$CompilerFailure -> CompilerPhase { self.phase }
    pub fn get_message self:$CompilerFailure -> $std::String { self.message }
    pub fn get_location self:$CompilerFailure -> $std::Option[common::Location] { self.location }
}

pub struct SyntaxResult {
    report: Report
    tokens: std::List[common::Token]
    facts:  std::Option[grammar::SyntaxFacts]
}

impl SyntaxResult {
    pub fn get_report self:$SyntaxResult -> $Report { self.report }
    pub fn get_tokens self:$SyntaxResult -> $std::List[common::Token] { self.tokens }
    pub fn get_facts self:$SyntaxResult -> $std::Option[grammar::SyntaxFacts] { self.facts }
}

pub struct AnalysisSnapshot {
    report:        Report
    index:         document::EditorIndex
    root_file:     std::String
    # Search order and import resolutions that `is_current` checks again.
    library_paths: std::List[std::String]
    resolutions:   std::List[parser::ImportResolution]
}

impl AnalysisSnapshot {
    pub fn get_report self:$AnalysisSnapshot -> $Report { self.report }
    pub fn get_index self:$AnalysisSnapshot -> $document::EditorIndex { self.index }
    pub fn get_semantic_tokens self:$AnalysisSnapshot -> std::List[document::DocumentToken] {
        self.root_file.as_str self.index.find_semantic_tokens match
            document::ListAnswer::Complete(items) => items
            document::ListAnswer::Incomplete(items _) => items
            document::ListAnswer::Unavailable(_) => std::List[document::DocumentToken]::new
        end
    }
}

pub enum Target derives std::Copy std::Eq {
    LinuxX86_64
}

pub struct AssemblySource {
    target: Target
    text:   std::String
}

impl AssemblySource {
    pub fn new text:std::String target:Target -> AssemblySource { text target AssemblySource }

    pub fn get_target self:$AssemblySource -> Target { self.target }
    pub fn get_text self:$AssemblySource -> $std::String { self.text }
}

pub enum AssemblyResult {
    Produced(Report AssemblySource)
    Rejected(Report)
}

impl AssemblyResult {
    pub fn get_report self:$AssemblyResult -> $Report {
        self match
            AssemblyResult::Produced(report _) => report
            AssemblyResult::Rejected(report) => report
        end
    }
}

# Syntax never loads imports or runs the checker.
pub fn syntax source:SourceUnit -> std::Result[SyntaxResult CompilerFailure] {
    source.file.as_str lexer::normalize_path = file
    lexer::SourceStore::new = sources
    source.text.as_str file.as_str sources.add
    file.as_str source.text.as_str grammar::analyze_syntax.into_parts = diagnostics = facts = tokens
    sources diagnostics Report = report
    facts tokens report SyntaxResult std::Result::Ok
}

# Caller-owned reuse state for `analyze_cached`. A snapshot never borrows it, and
# an empty cache produces the same snapshot as a filled one.
pub struct AnalysisCache {
    imports: std::Option[ImportAnalysis]
}

impl AnalysisCache {
    pub fn new -> AnalysisCache { std::Option[ImportAnalysis]::None AnalysisCache }
}

# Sealed analysis of the modules one root imports. Requests copy it, never change it.
struct ImportAnalysis {
    root_file:      std::String
    base_directory: std::String
    library_paths:  std::List[std::String]
    texts:          lexer::SourceStore
    source:         parser::ImportSource
    check:          typechecker::ImportCheck
    index:          document::ImportIndex
}

# Reuse requires the same inputs: identity, search order, imported text, and resolution.
fn is_current
    imports:$ImportAnalysis
    root_file:$str
    input:$CompilationInput
    library_paths:$std::List[std::String]
    sources:$lexer::SourceStore
-> bool {
    if
        imports.root_file.as_str root_file != imports.base_directory input.base_directory != ||
        library_paths imports.library_paths same_paths ! ||
    then
        false return
    fi
    for
        imported in imports
            .texts
            .sources
            .iter
    do
        if imports.texts sources imported.first.as_str has_same_text ! then
            false return
        fi
    done
    sources library_paths imports.source.get_resolutions resolves_same
}

# Whether `path` still has the text that `analyzed` holds: its override, else the
# file on disk. A file without analyzed text, such as a missing import, never matches.
fn has_same_text path:$str sources:$lexer::SourceStore analyzed:$lexer::SourceStore -> bool {
    if path analyzed.get std::Option::Some(previous) is then
        if path sources.get std::Option::Some(text) is then
            text previous == return
        fi
        if path read_text std::Option::Some(text) is then
            text previous == return
        fi
    fi
    false
}

# Whether each import still resolves to the recorded file, or still to none.
fn resolves_same
    resolutions:$std::List[parser::ImportResolution]
    library_paths:$std::List[std::String]
    sources:$lexer::SourceStore
-> bool {
    for resolution in resolutions.iter do
        resolution.specifier.as_str resolution.importing_file.as_str library_paths sources
        parser::resolve_import_in drop = resolved
        if resolved std::Option::Some(path) is then
            if resolution.path std::Option::Some(recorded) is then
                if path recorded != then
                    false return
                fi
            else
                false return
            fi
        elif resolution.path.is_some then
            false return
        fi
    done
    true
}

# Import stage. Imports with diagnostics produce no reusable analysis.
fn analyze_imports
    root_file:$str
    input:$CompilationInput
    sources:$lexer::SourceStore
    library_paths:$std::List[std::String]
    tokens:$std::List[common::Token]
    diagnostics:$error::Diagnostics
-> std::Option[ImportAnalysis] {
    sources.clone = import_sources
    import_sources diagnostics.clone library_paths.clone tokens parser::parse_imports
    = bodies = store = source
    if source.is_clean ! then
        std::Option[ImportAnalysis]::None return
    fi
    bodies store typechecker::check_imports = check
    if check.is_clean ! then
        std::Option[ImportAnalysis]::None return
    fi
    import_sources.clone_loaded = texts
    check typechecker::finish_imports = finished
    texts.clone finished document::project_imports = index
    ImportAnalysis {
        root_file: root_file.to_str
        base_directory: input.base_directory.clone
        library_paths: library_paths.clone
        texts: texts
        source: source
        check: check
        index: index
    } std::Option::Some
}

# Root stage over a copy of `imports`. No snapshot when the root imports other modules.
fn analyze_root
    imports:$ImportAnalysis
    root_file:$str
    sources:$lexer::SourceStore
    library_paths:std::List[std::String]
    tokens:std::List[common::Token]
    diagnostics:error::Diagnostics
-> std::Option[AnalysisSnapshot] {
    # Root-stage sources hold the imported text, overrides, and the root.
    imports.texts.clone = root_sources
    for text in sources.sources.iter do
        text.second.as_str text.first.as_str root_sources.add
    done
    imports
        .check
        .get_store
        .clone imports.source root_sources diagnostics library_paths.clone tokens
    parser::parse_root_with_imports = root_imports = parsed
    if imports.source.get_paths root_imports same_paths ! then
        std::Option[AnalysisSnapshot]::None return
    fi
    imports
        .source
        .get_resolutions
        .clone = resolutions
    parsed.get_resolutions.clone resolutions.append
    { drop } imports.check root_sources parsed check_root_with_imports.into_parts
    = checked = root_sources = diagnostics
    imports.index root_file.to_str diagnostics root_sources checked document::project_index_with_imports
    = diagnostics = root_sources = index
    AnalysisSnapshot {
        report: root_sources diagnostics Report
        index: index
        root_file: root_file.to_str
        library_paths: library_paths
        resolutions: resolutions
    } std::Option::Some
}

fn same_paths left:$std::List[std::String] right:$std::List[std::String] -> bool {
    if left.length right.length != then
        false return
    fi
    for index in left.length 0 std::Range::new do
        if index left.get index right.get != then
            false return
        fi
    done
    true
}

fn read_text path:$str -> std::Option[std::String] {
    path.as_cstr = path_cstr
    if path_cstr.is_none then
        std::Option[std::String]::None return
    fi
    path_cstr.unwrap os::file::read_all match
        std::Result::Ok(bytes) => bytes.to_str match
            std::Result::Ok(text) => text std::Option::Some
            std::Result::Error(_) => std::Option[std::String]::None
        end
        std::Result::Error(_) => std::Option[std::String]::None
    end
}

# Project source facts, then release all compiler bodies and declarations.
pub fn analyze input:CompilationInput -> std::Result[AnalysisSnapshot CompilerFailure] {
    AnalysisCache::new = cache
    cache input analyze_cached
}

# Analyze in two stages: the root's imports, then the root over a copy of that
# import analysis. A current cached import analysis replaces the first stage.
# Imports with diagnostics use one combined analysis and leave the cache empty.
pub fn analyze_cached
    input:CompilationInput
    cache:mut$AnalysisCache
-> std::Result[AnalysisSnapshot CompilerFailure] {
    if input.validate std::Option::Some(failure) is then
        failure std::Result::Error return
    fi
    input
        .root
        .file
        .as_str input.resolve_path = root_file
    root_file.as_str input.request_sources = sources
    input.resolve_library_paths = library_paths
    root_file.as_str input
        .root
        .text
        .as_str lexer::lex_source.into_parts = diagnostics = tokens
    false = reused
    if cache.imports std::Option::Some(cached) is then
        sources library_paths input root_file.as_str cached is_current = reused
    fi
    if reused ! then
        diagnostics tokens library_paths sources input root_file.as_str analyze_imports = cache.imports
    fi
    if cache.imports std::Option::Some(imports) is then
        if
            diagnostics tokens library_paths sources root_file.as_str imports analyze_root std::Option::Some(snapshot) is
        then
            snapshot std::Result::Ok return
        fi
        # The root now imports other modules. Analyze its imports again.
        std::Option[ImportAnalysis]::None = cache.imports
        if reused then
            cache input analyze_cached return
        fi
    fi
    input root_file analyze_combined
}

# One combined analysis, used when the root's imports report diagnostics.
fn analyze_combined
    root_file:std::String
    input:CompilationInput
-> std::Result[AnalysisSnapshot CompilerFailure] {
    input.resolve_library_paths = library_paths
    { drop } input parse_input = sources = parsed
    parsed.get_resolutions.clone = resolutions
    { drop } sources parsed check.into_parts = checked = sources = diagnostics
    root_file.clone diagnostics sources checked document::project_index
    = diagnostics = sources = index
    AnalysisSnapshot {
        report: sources diagnostics Report
        index: index
        root_file: root_file
        library_paths: library_paths
        resolutions: resolutions
    } std::Result::Ok
}

# Source errors cannot reach emission. Native assembly, linking and launch are caller work.
pub fn assembly
    input:CompilationInput
    target:Target
-> std::Result[AssemblyResult CompilerFailure] {
    { drop } target input assembly_with_progress
}

# Report phase starts synchronously. The callback and its captures remain caller-owned.
pub fn assembly_with_progress
    input:CompilationInput
    target:Target
    log_progress:$fn[str]
-> std::Result[AssemblyResult CompilerFailure] {
    if input.validate std::Option::Some(failure) is then
        failure std::Result::Error return
    fi
    input
        .root
        .file
        .as_str input.resolve_path = root_file
    log_progress input parse_input = sources = parsed
    if parsed.diagnostics.has_errors then
        parsed.into_parts = diagnostics drop
        root_file.as_str sources.retain_used
        sources diagnostics Report AssemblyResult::Rejected std::Result::Ok return
    fi
    log_progress sources parsed check.into_parts = checked = sources = diagnostics
    root_file.as_str sources.retain_used
    sources diagnostics Report = report
    if report.diagnostics.has_errors then
        report AssemblyResult::Rejected std::Result::Ok return
    fi
    if checked std::Option::Some(program_input) is then
        "Preparing checked program" log_progress exec
        program_input.into_checked_program match
            std::Result::Ok(program) => program
            std::Result::Error(message) => {
                std::Option[common::Location]::None message CompilerPhase::Checking report
                CompilerFailure std::Result::Error return
            }
        end = program
        "Planning and emitting assembly" log_progress exec
        report.get_sources program backend::compile_checked match
            std::Result::Ok(text) => {
                text target AssemblySource = source
                source report AssemblyResult::Produced std::Result::Ok
            }
            std::Result::Error(problem) => problem match
                backend::AssemblyError::Rejected(target_diagnostics) => {
                    target_diagnostics report.diagnostics.merge
                    report AssemblyResult::Rejected std::Result::Ok
                }
                backend::AssemblyError::Internal(failure) => {
                    std::Option[common::Location]::None failure.message.clone CompilerPhase::Backend report
                    CompilerFailure std::Result::Error
                }
            end
        end
    else
        std::Option[common::Location]::None
        "Checking returned no program without source diagnostics".to_str CompilerPhase::Checking report
        CompilerFailure std::Result::Error
    fi
}

struct CheckingResult {
    diagnostics: error::Diagnostics
    sources:     lexer::SourceStore
    typechecked: std::Option[typechecker::TypecheckResult]
}

impl CheckingResult {
    fn into_parts
        self:CheckingResult
    -> error::Diagnostics lexer::SourceStore std::Option[typechecker::TypecheckResult] {
        self match
            CheckingResult { diagnostics: diagnostics sources: sources typechecked: typechecked } => diagnostics sources typechecked
        end
    }
}

fn parse_input
    input:CompilationInput
    log_progress:$fn[str]
-> parser::ParseResolveResult lexer::SourceStore {
    input
        .root
        .file
        .as_str input.resolve_path = root_file
    root_file.as_str input.request_sources = sources
    input.resolve_library_paths = resolved_library_paths
    input match
        CompilationInput { root: root } => {
            root match
                SourceUnit {
                    text: text
                } => text
            end
        }
    end = root_source

    "Lexing root source" log_progress exec
    root_file.as_str root_source.as_str lexer::lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    "Parsing and resolving imports" log_progress exec
    sources diagnostics resolved_library_paths tokens parser::parse_and_resolve = parse_result
    parse_result sources
}

fn check_root_with_imports
    parsed:parser::ParseResolveResult
    sources:lexer::SourceStore
    imports:$typechecker::ImportCheck
    log_progress:$fn[str]
-> CheckingResult {
    parsed.into_parts = diagnostics = parsed_source
    parsed_source match
        std::Option::Some(source) => {
            diagnostics log_progress imports source typechecker::check_root_with_imports.with_source_diagnostics
            = typecheck_result
            typecheck_result.get_diagnostics.clone = diagnostics
            typecheck_result std::Option::Some
        }
        std::Option::None => std::Option[typechecker::TypecheckResult]::None
    end
    = typechecked
    typechecked sources diagnostics CheckingResult
}

fn check
    parsed:parser::ParseResolveResult
    sources:lexer::SourceStore
    log_progress:$fn[str]
-> CheckingResult {
    parsed.into_parts = diagnostics = parsed_source
    parsed_source match
        std::Option::Some(source) => {
            diagnostics log_progress source typechecker::type_check_with_progress.with_source_diagnostics
            = typecheck_result
            typecheck_result.get_diagnostics.clone = diagnostics
            typecheck_result std::Option::Some
        }
        std::Option::None => std::Option[typechecker::TypecheckResult]::None
    end
    = typechecked

    typechecked
    sources
    diagnostics
    CheckingResult
}

impl AnalysisSnapshot {
    fn query_offset self:$AnalysisSnapshot position:$common::SourcePosition -> std::Option[u64] {
        if 0 position.line == 0 position.column == || then
            std::Option[u64]::None return
        fi
        if
            self.root_file.as_str self
                .get_sources
                .line_starts
                .get_str std::Option::Some(starts) is
        then
            if starts.length position.line < then
                std::Option[u64]::None return
            fi
            position.line 1 - starts.get copy position.column 1 - + = offset
            if self.get_source.length offset < then
                std::Option[u64]::None return
            fi
            if starts.length position.line > then
                if position.line starts.get copy offset <= then
                    std::Option[u64]::None return
                fi
            fi
            offset std::Option::Some
        else
            std::Option[u64]::None
        fi
    }

    pub fn find_hover_at
        self:$AnalysisSnapshot
        position:$common::SourcePosition
    -> std::Option[document::DocumentHover] {
        if position self.query_offset std::Option::Some(offset) is then
            offset copy self.root_file.as_str self.index.find_hover match
                document::PointAnswer::Known(hover) => hover std::Option::Some return
                _ => {
                }
            end
        fi
        std::Option[document::DocumentHover]::None
    }

    pub fn find_definition_at
        self:$AnalysisSnapshot
        position:$common::SourcePosition
    -> std::Option[document::DocumentLocation] {
        if position self.query_offset std::Option::Some(offset) is then
            offset copy self.root_file.as_str self.index.find_definition match
                document::PointAnswer::Known(location) => location std::Option::Some return
                _ => {
                }
            end
        fi
        std::Option[document::DocumentLocation]::None
    }

    pub fn find_completion_candidates
        self:$AnalysisSnapshot
        position:$common::SourcePosition
        trigger:$str
    -> std::List[document::CompletionCandidate] {
        if position self.query_offset std::Option::Some(offset) is then
            trigger offset copy self.root_file.as_str self.index.find_candidates match
                document::ListAnswer::Complete(items) => items return
                document::ListAnswer::Incomplete(items _) => items return
                _ => {
                }
            end
        fi
        std::List[document::CompletionCandidate]::new
    }

    pub fn find_references_at
        self:$AnalysisSnapshot
        position:$common::SourcePosition
        include_declaration:bool
    -> std::Option[std::List[document::DocumentLocation]] {
        if position self.query_offset std::Option::Some(offset) is then
            include_declaration offset copy self.root_file.as_str self.index.find_references match
                document::ReferenceAnswer::Complete(result) => result.into_ranges std::Option::Some return
                document::ReferenceAnswer::Incomplete(result _) => result.into_ranges std::Option::Some return
                _ => {
                }
            end
        fi
        std::Option[std::List[document::DocumentLocation]]::None
    }
}

impl AnalysisSnapshot {
    pub fn find_completions_at
        self:$AnalysisSnapshot
        position:$common::SourcePosition
        trigger:$str
    -> document::ListAnswer[document::DocumentCompletion] {
        if position self.query_offset std::Option::Some(offset) is then
            trigger offset copy self.root_file.as_str self.index.find_completions return
        fi
        document::QueryReason::InvalidInput document::ListAnswer[document::DocumentCompletion]::Unavailable
    }

    pub fn find_reference_answer_at
        self:$AnalysisSnapshot
        position:$common::SourcePosition
        include_declaration:bool
    -> document::ReferenceAnswer {
        if position self.query_offset std::Option::Some(offset) is then
            include_declaration offset copy self.root_file.as_str self.index.find_references return
        fi
        document::QueryReason::InvalidInput document::ReferenceAnswer::Unavailable
    }
}

impl AnalysisSnapshot {
    pub fn get_file_path self:$AnalysisSnapshot -> $std::String { self.root_file }
    pub fn get_sources self:$AnalysisSnapshot -> $lexer::SourceStore { self.report.sources }
    pub fn get_source self:$AnalysisSnapshot -> $std::String {
        self.root_file.as_str self
            .report
            .sources
            .get
            .unwrap
    }
    pub fn is_incomplete self:$AnalysisSnapshot -> bool { self.index.is_incomplete }

    # Whether analyzing `input` would produce this snapshot again. Reads each
    # resolved file without an override from disk.
    pub fn is_current self:$AnalysisSnapshot input:$CompilationInput -> bool {
        if input.validate.is_some then
            false return
        fi
        input
            .root
            .file
            .as_str input.resolve_path = root_file
        input.resolve_library_paths = library_paths
        if
            root_file self.root_file != library_paths self.library_paths same_paths ! ||
            input.root.text self.get_source != ||
        then
            false return
        fi
        root_file.as_str input.request_sources = sources
        if sources library_paths self.resolutions resolves_same ! then
            false return
        fi
        # Files without text, such as missing path-style imports, need a new analysis.
        # Revisit if editors spend long in that state on large import graphs.
        std::Set[std::String]::new = compared
        for resolution in self.resolutions.iter do
            if resolution.path std::Option::Some(path) is then
                if path compared.has ! then
                    if self.report.sources sources path.as_str has_same_text ! then
                        false return
                    fi
                    path.clone compared.add
                fi
            fi
        done
        true
    }
    pub fn find_symbol_identity_at
        self:$AnalysisSnapshot
        position:$common::SourcePosition
    -> std::Option[document::DocumentSymbol] {
        if position self.query_offset std::Option::Some(offset) is then
            offset copy self.root_file.as_str self.index.find_symbol_identity return
        fi
        std::Option[document::DocumentSymbol]::None
    }
}
