# Request-owned compiler products. Legacy phases remain private adapters here.
import "std" as std
import "common" as common
import "error" as error
import "lexer" as lexer
import "syntax" as grammar
import "analysis" as frontend
import "document" as document
import "bytecode" as bytecode
import "emitter" as emitter

pub struct SourceUnit {
    pub file: std::String
    pub text: std::String
}

pub struct CompilationInput {
    pub root:             SourceUnit
    pub base_directory:   std::String
    pub library_paths:    std::List[std::String]
    pub source_overrides: std::Map[std::String std::String]
}

impl CompilationInput {
    pub fn new root:SourceUnit base_directory:std::String -> CompilationInput {
        std::Map[std::String std::String]::new std::List[std::String]::new
        base_directory root CompilationInput
    }

    fn resolve_path self:$CompilationInput path:$str -> std::String {
        if path "/" str::starts_with then
            path lexer::normalize_path
        else
            f"{self.base_directory}/{path}".as_str lexer::normalize_path
        fi
    }

    # Reject an invalid request base without reading files relative to process state.
    fn validate self:$CompilationInput -> std::Option[CompilerFailure] {
        if self.base_directory.as_str "/" str::starts_with then
            std::Option[CompilerFailure]::None return
        fi
        lexer::SourceStore::new = sources
        self
            .root
            .text
            .as_str self
            .root
            .file
            .as_str sources.add
        sources error::Diagnostics::new Report = report
        std::Option[common::Location]::None
        "Compilation base directory must be absolute".to_str CompilerPhase::Input report
        CompilerFailure std::Option::Some
    }

    fn into_frontend self:CompilationInput -> frontend::AnalysisInput {
        self
            .root
            .file
            .as_str self.resolve_path = root_file
        self
            .root
            .text
            .clone root_file frontend::AnalysisInput::new = input
        for path in self.library_paths.iter do
            path.as_str self.resolve_path input.library_paths.push
        done
        for override in self.source_overrides.iter do
            override.second.clone override.first.as_str self.resolve_path input.source_overrides.set
        done
        input
    }
}

pub struct Report {
    diagnostics: error::Diagnostics
    sources:     lexer::SourceStore
}

impl Report {
    pub fn get_diagnostics self:$Report -> $error::Diagnostics { self.diagnostics }
    pub fn get_sources self:$Report -> $lexer::SourceStore { self.sources }
}

pub enum CompilerPhase derives std::Copy std::Eq {
    Input
    Checking
    Bytecode
}

pub struct CompilerFailure {
    report:   Report
    phase:    CompilerPhase
    message:  std::String
    location: std::Option[common::Location]
}

impl CompilerFailure {
    pub fn get_report self:$CompilerFailure -> $Report { self.report }
    pub fn get_phase self:$CompilerFailure -> CompilerPhase { self.phase }
    pub fn get_message self:$CompilerFailure -> $std::String { self.message }
    pub fn get_location self:$CompilerFailure -> $std::Option[common::Location] { self.location }
}

pub struct SyntaxResult {
    report: Report
    tokens: std::List[common::Token]
    facts:  std::Option[grammar::SyntaxFacts]
}

impl SyntaxResult {
    pub fn get_report self:$SyntaxResult -> $Report { self.report }
    pub fn get_tokens self:$SyntaxResult -> $std::List[common::Token] { self.tokens }
    pub fn get_facts self:$SyntaxResult -> $std::Option[grammar::SyntaxFacts] { self.facts }
}

pub struct AnalysisSnapshot {
    report:          Report
    semantic_tokens: std::List[document::DocumentToken]
}

impl AnalysisSnapshot {
    pub fn get_report self:$AnalysisSnapshot -> $Report { self.report }
    pub fn get_semantic_tokens self:$AnalysisSnapshot -> $std::List[document::DocumentToken] {
        self.semantic_tokens
    }
}

pub enum Target derives std::Copy std::Eq {
    LinuxX86_64
}

pub struct AssemblySource {
    target: Target
    text:   std::String
}

impl AssemblySource {
    pub fn get_target self:$AssemblySource -> Target { self.target }
    pub fn get_text self:$AssemblySource -> $std::String { self.text }
}

pub enum AssemblyResult {
    Produced (Report AssemblySource)
    Rejected (Report)
}

impl AssemblyResult {
    pub fn get_report self:$AssemblyResult -> $Report {
        self match
            AssemblyResult::Produced(report _) => report
            AssemblyResult::Rejected(report) => report
        end
    }
}
# Syntax never loads imports or runs the checker.
pub fn syntax source:SourceUnit -> std::Result[SyntaxResult CompilerFailure] {
    source.file.as_str lexer::normalize_path = file
    lexer::SourceStore::new = sources
    source.text.as_str file.as_str sources.add
    file.as_str source.text.as_str grammar::analyze_syntax.into_parts = diagnostics = facts = tokens
    sources diagnostics Report = report
    facts tokens report SyntaxResult std::Result::Ok
}
# Project presentation data, then release all legacy bodies and declarations.
# Further editor query projections are added by the editor migration slice.
pub fn analyze input:CompilationInput -> std::Result[AnalysisSnapshot CompilerFailure] {
    if input.validate std::Option::Some(failure) is then
        failure std::Result::Error return
    fi
    input.into_frontend = frontend_input
    frontend_input.root_file.clone = root_file
    frontend_input.root_source.clone = root_source
    frontend_input frontend::analyze.into_parts = checked = sources = diagnostics
    root_file.as_str sources.retain_used
    sources diagnostics Report = report
    checked lexer::SourceStore::new error::Diagnostics::new frontend::AnalysisResult = legacy
    root_file root_source legacy document::AnalyzedDocument::new = document
    document.find_semantic_tokens report AnalysisSnapshot std::Result::Ok
}
# Source errors cannot reach emission. Native assembly, linking and launch are caller work.
pub fn assembly
    input:CompilationInput
    target:Target
-> std::Result[AssemblyResult CompilerFailure] {
    if input.validate std::Option::Some(failure) is then
        failure std::Result::Error return
    fi
    input.into_frontend = frontend_input
    frontend_input.root_file.clone = root_file
    frontend_input frontend::analyze.into_parts = checked = sources = diagnostics
    root_file.as_str sources.retain_used
    sources diagnostics Report = report
    if report.diagnostics.has_errors then
        report AssemblyResult::Rejected std::Result::Ok return
    fi
    if checked std::Option::Some(program_input) is then
        program_input bytecode::compile_typechecked match
            std::Result::Ok(program) => {
                program emitter::emit target AssemblySource = source
                source report AssemblyResult::Produced std::Result::Ok
            }
            std::Result::Error(failure) => {
                std::Option[common::Location]::None failure.message.clone CompilerPhase::Bytecode report
                CompilerFailure std::Result::Error
            }
        end
    else
        std::Option[common::Location]::None
        "Checking returned no program without source diagnostics".to_str CompilerPhase::Checking report
        CompilerFailure std::Result::Error
    fi
}
