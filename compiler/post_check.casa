# Declaration validation and reachable concrete specialization after source checking.
import "std" as std
import "common" as common
import "error" as error
import "semantics" as semantics
import "semantic_body" as semantic_body
import "semantic_rules" as rules

fn check_trait_impls
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    checks:mut$semantics::SemanticChecks
{
    for trait_impl in store.clone_trait_impls.iter do
        trait_impl.trait_bound common::trait_bound_to_type = trait_type
        std::Set[std::String]::new = checked_methods
        true = valid
        trait_type store rules::collect_trait_method_candidates = candidates
        for candidate in candidates.iter do
            candidate
                .method
                .name
                .clone = method_name
            if method_name checked_methods.has then
                continue
            fi
            method_name.clone checked_methods.add
            std::Option[std::String]::None = function_name_opt
            if method_name trait_impl.methods.get std::Option::Some(function_name) is then
                function_name.clone std::Option::Some = function_name_opt
            fi
            if function_name_opt.is_none then
                store trait_impl.receiver method_name.as_str rules::find_semantic_method_function = function_name_opt
            fi
            if function_name_opt std::Option::Some(function_name) is then
                diagnostics store function_name.as_str checks.ensure_function = function_opt
                if function_opt.is_none then
                    false = valid continue
                fi
                function_opt.unwrap = implementation
                trait_impl.receiver candidate.effect common::resolve_trait_stack_effect = expected
                if true implementation.stack_effect expected semantics::trait_method_effects_match ! then
                    false = valid
                fi
                if
                    store implementation.stack_effect candidate.method.stack_effect function_name
                    checks.check_trait_return_borrows !
                then
                    trait_impl.location
                    f"Trait method `{method_name}` hides a storage borrow in a return type parameter"
                    common::ErrorKind::TraitSignatureMismatch diagnostics.record_error_string
                    false = valid
                fi
            elif store trait_type method_name.as_str rules::find_trait_default_method.is_none then
                false = valid
            fi
        done
        if valid ! then
            trait_impl.location f"Trait implementation `{trait_impl.receiver.format}: {trait_type.format}` does not satisfy the trait requirements" common::ErrorKind::TraitSignatureMismatch diagnostics.record_error_string
        fi
    done
}

fn does_binding_name_precede left:$std::String right:$std::String -> bool {
    for pair in right.iter left.iter.zip do
        if pair.first pair.second != then
            pair.second pair.first > return
        fi
    done
    right.length left.length >
}

pub fn generic_binding_key bindings:$std::Map[std::String common::Type] -> std::String {
    bindings.keys = names
    &does_binding_name_precede names.sort_by
    std::String::new = key
    for name in names.iter do
        name bindings
            .get
            .unwrap
            .format = value
        f"{name.length}:{name}={value.length}:{value};" key.append_string
    done
    key
}

fn resolve_specialized_trait_callable
    callable:$semantic_body::ConstrainedCallable
    origin:$common::Location
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    checks:mut$semantics::SemanticChecks
-> std::Option[semantic_body::Callable] {
    callable.dispatch = call: $common::DeferredTraitCall
    callable.substitutions.clone = substitutions
    call.receiver.clone = lookup_receiver
    if call.receiver.borrow_target std::Option::Some(target) is then
        target.clone = lookup_receiver
    fi
    if "clone" call.method_name.as_str == then
        checks origin lookup_receiver store semantics::ensure_function_clone_method
    fi
    std::Option[rules::MethodSemantics]::None = semantics_opt
    if call.trait_type std::Option::Some(trait_type) is then
        store lookup_receiver trait_type call.method_name.as_str rules::resolve_qualified_method_semantics
        = semantics_opt
        if
            semantics_opt.is_none "clone" call.method_name.as_str == lookup_receiver common::Type::Function is && &&
        then
            store std::Option[common::Function]::None lookup_receiver call.method_name.as_str rules::resolve_method_semantics
            = semantics_opt
        fi
    else
        store std::Option[common::Function]::None lookup_receiver call.method_name.as_str rules::resolve_method_semantics
        = semantics_opt
    fi
    if semantics_opt.is_none then
        origin f"No implementation of trait method `{call.method_name}` exists for `{call.receiver.format}`"
        common::ErrorKind::MissingTraitMethod diagnostics.record_error_string
        std::Option[semantic_body::Callable]::None return
    fi
    semantics_opt.unwrap = semantics
    semantics.function_name.clone = function_name
    if semantics.kind rules::MethodSemanticsKind::DefaultMethod is then
        checks diagnostics store lookup_receiver semantics semantics::instantiate_default_trait_method = default_name_opt
        if default_name_opt std::Option::Some(default_name) is then
            default_name.clone = function_name
        fi
    fi
    diagnostics store function_name.as_str checks.ensure_function drop
    if
        0 substitutions.length ==
        function_name.as_str store.get_function std::Option::Some(implementation) is &&
    then
        call.stack_effect implementation.stack_effect semantics::bind_stack_effect_pattern = bindings_opt
        if bindings_opt std::Option::Some(bindings) is then
            bindings = substitutions
        fi
    fi
    substitutions function_name semantic_body::Callable std::Option::Some
}

pub fn monomorphized_function_name
    function_name:$str
    bindings:$std::Map[std::String common::Type]
-> std::String {
    bindings generic_binding_key = key
    # The complete length-prefixed key distinguishes instances. Only the backend
    # needs assembler escaping. The space keeps this identity out of source names.
    f"{function_name}__mono_ {key}"
}

pub fn function_receiver_bindings
    typ:$common::Type
    function:$common::Function
-> std::Map[std::String common::Type] {
    std::Map[std::String common::Type]::new = bindings
    if
        0 function
            .stack_effect
            .parameters
            .length ==
    then
        bindings return
    fi
    0 function
        .stack_effect
        .parameters
        .get
        .typ
        .clone = pattern
    typ.clone = actual
    if pattern.is_shared_borrow then
        common::SHARED_BORROW_TYPE actual common::apply_borrow_type = actual
    elif pattern.is_exclusive_borrow then
        common::EXCLUSIVE_BORROW_TYPE actual common::apply_borrow_type = actual
    fi
    bindings actual pattern rules::bind_trait_impl_type drop
    bindings
}

# Specialization owns its traversal state and updates only explicit dependencies.
struct SemanticSpecializer {
    store:       mut$common::SymbolStore
    checks:      mut$semantics::SemanticChecks
    diagnostics: mut$error::Diagnostics
    processed:   std::Set[std::String]
    drop_types:  std::Set[std::String]
}

impl SemanticSpecializer {
    fn select_target
        self:mut$SemanticSpecializer
        name:$str
        bindings:mut$std::Map[std::String common::Type]
        origin:$common::Location
    -> std::String {
        self.diagnostics self.store name self.checks.ensure_function drop
        if
            name self
                .store
                .source_functions
                .has_str
        then
            name.to_str return
        fi
        name self.store.get_function match
            std::Option::None => name.to_str return
            std::Option::Some(declaration) => {
                if
                    declaration
                        .stack_effect
                        .type_vars
                        .is_empty declaration
                        .stack_effect
                        .const_params
                        .length 0 == && bindings.is_empty &&
                then
                    name.to_str return
                fi
            }
        end
        if bindings.is_empty then
            origin f"Cannot monomorphize `{name}` without concrete type arguments"
            common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
            name.to_str return
        fi
        for pair in bindings.iter do
            if pair.second.has_unresolved_type_var then
                origin f"Cannot monomorphize `{name}` with unresolved type arguments"
                common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                name.to_str return
            fi
        done
        bindings name monomorphized_function_name = target
        if target.as_str self.store.has_function ! then
            name self
                .store
                .get_function
                .unwrap
                .clone = declaration
            bindings target.clone declaration rules::specialize_function_declaration = specialized
            self.store bindings name specialized self.checks.install_specialization
            name specialized self.store.set_specialized_function
        fi
        target
    }

    fn visit_function self:mut$SemanticSpecializer name:$str {
        if name self.processed.has_str then
            return
        fi
        name.to_str self.processed.add
        self.diagnostics self.store name self.checks.ensure_function drop
        if name self.store.get_function std::Option::Some(declaration) is then
            declaration.captures.clone
        else
            std::List[common::Variable]::new
        fi = captures
        for capture in captures.iter do
            capture.typ self.visit_drop_type
        done
        if name self.checks.begin_specialization std::Option::Some(active) is then
            active.get_body_mut self.visit_body
            self.checks active.complete
        fi
    }

    fn visit_drop_type self:mut$SemanticSpecializer typ:$common::Type {
        if typ.has_unresolved_type_var typ.is_borrow || then
            return
        fi
        typ.format = key
        if key self.drop_types.has then
            return
        fi
        key self.drop_types.add
        if self.store typ common::find_drop_function_name std::Option::Some(name) is then
            name.as_str self
                .store
                .get_function
                .unwrap = declaration
            declaration typ function_receiver_bindings = bindings
            common::empty_location bindings name.as_str self.select_target = target
            target.as_str self.visit_function
        fi
        std::List[common::Type]::new = children
        typ match
            common::Type::Generic(generic) => generic
            _ => return
        end = generic
        if common::ARRAY_TYPE generic.base.as_str == then
            if generic.params.is_empty ! then
                0 generic
                    .params
                    .get
                    .clone children.push
            fi
        elif
            generic.base.as_str self
                .store
                .structs
                .get_str std::Option::Some(shape) is
        then
            shape.type_vars typ common::aggregate_type_bindings = bindings
            for member in shape.members.iter do
                bindings member.typ.substitute_t children.push
            done
        elif
            generic.base.as_str self
                .store
                .enums
                .get_str std::Option::Some(shape) is
        then
            shape.type_vars typ common::aggregate_type_bindings = bindings
            for variant in shape.variant_types.iter do
                for member in variant.second.iter do
                    bindings member.substitute_t children.push
                done
            done
        fi
        for child in children.iter do
            child self.visit_drop_type
        done
    }

    fn visit_facts self:mut$SemanticSpecializer facts:$semantic_body::OperationFacts {
        if facts.effects std::Option::Some(effects) is then
            for event in effects.cleanups.iter do
                event.typ self.visit_drop_type
            done
        fi
    }

    fn visit_leaf self:mut$SemanticSpecializer leaf:mut$semantic_body::Leaf {
        if
            leaf.action semantic_body::Action::ConstrainedCall is leaf.action semantic_body::Action::ConstrainedClosure is ||
        then
            leaf.action semantic_body::Action::ConstrainedClosure is = as_reference
            leaf.action match
                semantic_body::Action::ConstrainedCall(call) => call
                semantic_body::Action::ConstrainedClosure(call) => call
                _ => "Expected constrained action" panic
            end = constrained: $semantic_body::ConstrainedCallable
            self.checks self.diagnostics self.store leaf.facts.origin constrained resolve_specialized_trait_callable = resolved
            if resolved.is_none then
                return
            fi
            resolved.unwrap = call
            if as_reference then
                call semantic_body::Action::Closure
            else
                call semantic_body::Action::Call
            fi = leaf.action
        fi
        leaf.action match
            semantic_body::Action::Call(call) => {
                leaf.facts.origin call.substitutions call.name.as_str self.select_target = target
                target.clone = call.name
                target.as_str self.visit_function
            }
            semantic_body::Action::Closure(call) => {
                leaf.facts.origin call.substitutions call.name.as_str self.select_target = target
                target.clone = call.name
                target.as_str self.visit_function
            }
            semantic_body::Action::Primitive(kind typ) => {
                if kind semantic_body::PrimitiveKind::Drop == then
                    typ self.visit_drop_type
                fi
            }
            semantic_body::Action::DestructionFn(typ) => typ self.visit_drop_type
            semantic_body::Action::NumericTry(conversion wrapper) => wrapper.as_str self.visit_function
            semantic_body::Action::IntegerTry(conversion wrapper) => wrapper.as_str self.visit_function
            _ => {
            }
        end
        leaf.facts self.visit_facts
    }

    fn visit_body self:mut$SemanticSpecializer body:mut$semantic_body::Body {
        body.get_nodes_mut = nodes
        for index in nodes.length 0 std::Range::new do
            index nodes.get_mut match
                semantic_body::Node::Unreachable(_) => {
                }
                semantic_body::Node::Leaf(leaf) => leaf self.visit_leaf
                semantic_body::Node::Conditional(conditional) => {
                    for branch_index in conditional.branches.length 0 std::Range::new do
                        branch_index conditional.branches.get_mut = branch
                        branch.entry self.visit_facts
                        branch.test self.visit_facts
                        branch.condition self.visit_body
                        branch.consequent self.visit_body
                    done
                    if conditional.alternative std::Option::Some(alternative) is then
                        alternative.entry self.visit_facts
                        alternative.body self.visit_body
                    fi
                    conditional.exit self.visit_facts
                }
                semantic_body::Node::Loop(loop) => {
                    loop.entry self.visit_facts
                    loop.test self.visit_facts
                    loop.condition self.visit_body
                    loop.body self.visit_body
                    loop.exit self.visit_facts
                }
                semantic_body::Node::Match(match_body) => {
                    match_body.entry self.visit_facts
                    for arm_index in match_body.arms.length 0 std::Range::new do
                        arm_index match_body.arms.get_mut = arm
                        arm.entry self.visit_facts
                        arm.guard self.visit_body
                        arm.body self.visit_body
                    done
                    match_body.exit self.visit_facts
                }
                semantic_body::Node::Region(region) => {
                    region.entry self.visit_facts
                    region.body self.visit_body
                    region.exit self.visit_facts
                }
                semantic_body::Node::Array(compound) => {
                    compound.facts self.visit_facts
                    compound.body self.visit_body
                }
                semantic_body::Node::Group(compound) => {
                    compound.facts self.visit_facts
                    compound.body self.visit_body
                }
            end
        done
    }
}

# Tarjan's traversal assigns each recipe to its strongly connected component.
# Edges between components cannot participate in recursive binding changes.
struct RecipeCycleGraph {
    indices:    std::Map[std::String u64]
    lowlinks:   std::Map[std::String u64]
    components: std::Map[std::String u64]
    stack:      std::List[std::String]
}

impl RecipeCycleGraph {
    fn new -> RecipeCycleGraph {
        std::List[std::String]::new std::Map[std::String u64]::new
        std::Map[std::String u64]::new
        std::Map[std::String u64]::new RecipeCycleGraph
    }

    fn visit self:mut$RecipeCycleGraph name:$str checks:$semantics::SemanticChecks -> u64 {
        if name self.indices.get_str std::Option::Some(index) is then
            index copy return
        fi
        self.indices.length = index
        index name.to_str self.indices.set
        index name.to_str self.lowlinks.set
        name.to_str self.stack.push
        if name checks.find_body std::Option::Some(body) is then
            {
                = call: $semantic_body::Callable
                = origin: $common::Location
                origin drop
                if call.name self.components.has then
                    return
                fi
                checks call.name.as_str self.visit = child
                if
                    name self
                        .lowlinks
                        .get_str
                        .unwrap copy child >
                then
                    child name.to_str self.lowlinks.set
                fi
            } = visitor
            visitor body.visit_calls
        fi
        name self
            .lowlinks
            .get_str
            .unwrap copy = lowest
        if lowest index == then
            while true do
                self.stack.pop = member
                member.as_str name == = last
                index member self.components.set
                if last then
                    break
                fi
            done
        fi
        lowest
    }
}

struct RecipeCycleStep derives std::Clone {
    source: std::String
    call:   semantic_body::Callable
    origin: common::Location
}

fn get_recipe_symbol_name typ:$common::Type -> std::Option[std::String] {
    if typ common::Type::TypeVar(name) is then
        name.clone std::Option::Some return
    fi
    if typ common::Type::Const(value) is then
        if value.is_symbolic then
            value.name.clone std::Option::Some return
        fi
    fi
    std::Option::None
}

# Successful paths contain only distinct symbols from the component root.
# A cycle cannot undo a constructed type, a fixed argument, or a repeated symbol.
fn are_recipe_bindings_injective
    bindings:$std::Map[std::String common::Type]
    symbols:$std::Map[std::String common::Type]
-> bool {
    std::Set[std::String]::new = used
    for pair in bindings.iter do
        pair.second get_recipe_symbol_name = symbol_opt
        if symbol_opt.is_none then
            false return
        fi
        symbol_opt.unwrap = symbol
        if symbol used.has then
            false return
        fi
        if symbol symbols.get std::Option::Some(expected) is then
            if expected pair.second.eq ! then
                false return
            fi
        else
            false return
        fi
        symbol used.add
    done
    true
}

fn do_recipe_bindings_match
    left:$std::Map[std::String common::Type]
    right:$std::Map[std::String common::Type]
-> bool {
    if right.length left.length != then
        false return
    fi
    for pair in left.iter do
        if pair.first right.get std::Option::Some(value) is then
            if value pair.second.eq ! then
                false return
            fi
        else
            false return
        fi
    done
    true
}

fn compose_recipe_bindings
    call:$semantic_body::Callable
    bindings:$std::Map[std::String common::Type]
-> std::Map[std::String common::Type] {
    std::Map[std::String common::Type]::new = composed
    for pair in call.substitutions.iter do
        bindings pair.second.substitute_t pair.first.clone composed.set
    done
    composed
}

impl RecipeCycleGraph {
    fn find_path
        self:$RecipeCycleGraph
        name:$str
        target:$str
        checks:$semantics::SemanticChecks
        visited:mut$std::Set[std::String]
        path:mut$std::List[RecipeCycleStep]
    -> bool {
        if target name == then
            true return
        fi
        if name.to_str visited.has then
            false return
        fi
        name.to_str visited.add
        path.length = initial_length
        name self
            .components
            .get_str
            .unwrap copy = component
        name checks.find_body.unwrap = body
        {
            = call: $semantic_body::Callable
            = origin: $common::Location
            if initial_length path.length < then
                return
            fi
            if
                component call.name self
                    .components
                    .get
                    .unwrap copy !=
            then
                return
            fi
            origin.clone call.clone name.to_str RecipeCycleStep path.push
            if path visited checks target call.name.as_str self.find_path ! then
                path.pop drop
            fi
        } = visitor
        visitor body.visit_calls
        initial_length path.length <
    }
}

fn report_recipe_cycle
    path:$std::List[RecipeCycleStep]
    closing:u64
    change:$str
    diagnostics:mut$error::Diagnostics
{
    std::List[std::String]::new = names
    for offset in path.length 0 std::Range::new do
        closing 1 + offset + path.length % path
            .get
            .source
            .clone names.push
    done
    closing path.get = step
    step
        .call
        .name
        .clone names.push
    " -> " names.join_strings = cycle
    step.origin f"Polymorphic recursion changes the type arguments of `{step.call.name}`: {change} (cycle: {cycle})"
    common::ErrorKind::TypeMismatch diagnostics.record_error_string
}

# Replay at most two closed walks on failure. Stop at the first non-renaming
# edge so diagnostics never expand a recursively constructed type or function type.
fn report_recipe_cycle_path
    path:$std::List[RecipeCycleStep]
    checks:$semantics::SemanticChecks
    diagnostics:mut$error::Diagnostics
-> bool {
    0 path
        .get
        .source
        .as_str checks.find_effect.unwrap
    rules::identity_generic_bindings = symbols
    symbols.clone = bindings
    0 = index: u64
    for step in path.iter do
        bindings step.call compose_recipe_bindings = composed
        if symbols composed are_recipe_bindings_injective ! then
            step.call.substitutions generic_binding_key = key
            f"recursive binding `{key}` does not forward distinct symbolic parameters" = change
            diagnostics change.as_str index path report_recipe_cycle
            true return
        fi
        composed = bindings
        1 += index
    done
    if symbols bindings do_recipe_bindings_match ! then
        symbols generic_binding_key = previous
        bindings generic_binding_key = key
        f"`{previous}` becomes `{key}`" = change
        diagnostics change.as_str path.length 1 - path report_recipe_cycle
        true return
    fi
    false
}

# Each recipe gets one injective map into the root's independent symbols.
# Agreement on every edge then proves identity around every participant's cycles.
# Predecessors retain diagnostic paths without copying a full path per recipe.
struct RecipeCycleValidator {
    bindings:  std::Map[std::String std::Map[std::String common::Type]]
    parents:   std::Map[std::String RecipeCycleStep]
    symbols:   std::Map[std::String common::Type]
    root:      std::String
    component: u64
    valid:     bool
}

impl RecipeCycleValidator {
    fn path_to self:$RecipeCycleValidator name:$str -> std::List[RecipeCycleStep] {
        std::List[RecipeCycleStep]::new = path
        name.to_str = current
        while self.root current != do
            current self
                .parents
                .get
                .unwrap = step
            step.clone path.push
            step.source.clone = current
        done
        path.reverse
        path
    }

    fn report_conflict
        self:mut$RecipeCycleValidator
        source:$str
        call:$semantic_body::Callable
        origin:$common::Location
        graph:$RecipeCycleGraph
        checks:$semantics::SemanticChecks
        diagnostics:mut$error::Diagnostics
    {
        false = self.valid
        std::Set[std::String]::new = visited
        std::List[RecipeCycleStep]::new = returning
        if returning visited checks self.root.as_str call.name.as_str graph.find_path ! then
            "A recipe component must contain a return path" panic
        fi
        source self.path_to = incoming
        origin.clone call.clone source.to_str RecipeCycleStep incoming.push
        returning.clone incoming.append
        if diagnostics checks incoming report_recipe_cycle_path then
            return
        fi
        # The incoming walk preserves the root. The stored path must then differ
        # around the same return path, since both maps are injective renamings.
        call.name.as_str self.path_to = previous
        returning previous.append
        if diagnostics checks previous report_recipe_cycle_path ! then
            "Conflicting recipe bindings must change a cycle" panic
        fi
    }

    fn validate
        self:mut$RecipeCycleValidator
        name:$str
        bindings:$std::Map[std::String common::Type]
        graph:$RecipeCycleGraph
        checks:$semantics::SemanticChecks
        diagnostics:mut$error::Diagnostics
    {
        bindings.clone name.to_str self.bindings.set
        name checks.find_body.unwrap = body
        {
            = call: $semantic_body::Callable
            = origin: $common::Location
            if self.valid ! then
                return
            fi
            if
                self.component call.name graph
                    .components
                    .get
                    .unwrap copy !=
            then
                return
            fi
            bindings call compose_recipe_bindings = composed
            if call.name self.bindings.get std::Option::Some(previous) is then
                if previous composed do_recipe_bindings_match ! then
                    diagnostics checks graph origin call name self.report_conflict
                fi
                return
            fi
            if self.symbols composed are_recipe_bindings_injective ! then
                diagnostics checks graph origin call name self.report_conflict
                return
            fi
            origin.clone call.clone name.to_str RecipeCycleStep call.name.clone self.parents.set
            diagnostics checks graph composed call.name.as_str self.validate
        } = visitor
        visitor body.visit_calls
    }
}

pub fn validate_checked_declarations
    store:mut$common::SymbolStore
    checks:mut$semantics::SemanticChecks
    diagnostics:mut$error::Diagnostics
{
    checks diagnostics store check_trait_impls
    RecipeCycleGraph::new = graph
    std::Map[i64 std::String]::new = roots
    store.get_function_names = names
    for name in names.iter do
        name.as_str store.get_function.unwrap = declaration
        if
            declaration
                .stack_effect
                .type_vars
                .is_empty declaration
                .stack_effect
                .const_params
                .is_empty &&
        then
            continue
        fi
        if name.as_str checks.find_body.is_none then
            continue
        fi
        checks name.as_str graph.visit drop
        name graph
            .components
            .get
            .unwrap copy i64::try_from.unwrap = component
        # Choose stable roots in one pass, without sorting every source name.
        if component roots.get std::Option::Some(previous) is then
            if previous name does_binding_name_precede then
                name.clone component roots.set
            fi
        else
            name.clone component roots.set
        fi
    done
    for root in roots.iter do
        root.second = name
        name.as_str store.get_function.unwrap = declaration
        declaration.stack_effect rules::identity_generic_bindings = bindings
        RecipeCycleValidator {
            bindings: std::Map[std::String std::Map[std::String common::Type]]::new
            parents: std::Map[std::String RecipeCycleStep]::new
            symbols: bindings.clone
            root: name.clone
            component: root.first copy u64::try_from.unwrap
            valid: true
        } = validator
        diagnostics checks graph bindings name.as_str validator.validate
    done
}

pub fn specialize
    root:semantics::AnalysisBody
    store:mut$common::SymbolStore
    checks:mut$semantics::SemanticChecks
    diagnostics:mut$error::Diagnostics
-> semantics::AnalysisBody {
    root match
        semantics::AnalysisBody::Checked(body) => {
            if diagnostics.has_errors then
                body semantics::AnalysisBody::RejectedChecked
            else
                std::Set[std::String]::new std::Set[std::String]::new diagnostics checks store
                SemanticSpecializer = specializer
                body specializer.visit_body
                body semantics::AnalysisBody::Checked
            fi
        }
        semantics::AnalysisBody::Rejected(work) => work semantics::AnalysisBody::Rejected
        semantics::AnalysisBody::RejectedChecked(body) => body semantics::AnalysisBody::RejectedChecked
        semantics::AnalysisBody::Source(source) => source semantics::AnalysisBody::Source
    end
}
