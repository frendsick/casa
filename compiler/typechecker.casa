                common::ErrorKind::InvalidScope checker.diagnostics.record_error
                return
            fi
            hidden_name.clone common::OpValue::AssignVar op common::Op::set_value
            function_opt op_index ops op checker.check_assignment
            hidden_name.clone common::OpValue::Question op common::Op::set_value

            return_type hidden_name.clone op.location.clone op_index ops semantics::lower_question_operations
        fi
    }

    pub fn consume_question_owner checker:mut$TypeChecker op:mut$common::Op {
        if op.value common::OpValue::QuestionMove(hidden_name) is then
            if hidden_name.as_str checker.owner_is_moved then
                return
            fi
            if
                checker
                    .stack
                    .values
                    .length hidden_name.as_str checker.has_active_owner_loan
            then
                op.location "Question-mark payload cannot borrow from its consumed source"
                common::ErrorKind::InvalidVariable checker.diagnostics.record_error
                return
            fi
            true hidden_name.as_str checker.set_owner_moved
        fi
    }

