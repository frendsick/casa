impl TypeChecker {
    pub fn resolve_aggregate_literal
        self:mut$TypeChecker
        value:mut$TypedValue
        expected:$common::Type
    -> common::Type {
        value.type_value common::clone_type = actual
        if 0 value.literals.length == then
            actual return
        fi
        if expected.has_unresolved_type_var then
            actual resolve_numeric_literal_default = actual
        else
            expected common::clone_type = actual
        fi
        self.literal_resolutions self.diagnostics actual value.resolve_literals drop
        actual
    }

    pub fn expect_aggregate_value
        self:mut$TypeChecker
        expected:$common::Type
        bindings:mut$std::Map[std::String common::Type]
        origins:std::Option[std::List[std::String]]
    -> std::Option[std::List[std::String]] {
        self.stack_pop_value = value
        bindings expected.substitute_t = current_expected
        current_expected value self.resolve_aggregate_literal = actual

        expected common::clone_type = binding_expected
        actual common::clone_type = binding_actual
        if binding_expected.borrow_target std::Option::Some(target) is then
            target common::clone_type = binding_expected
            if binding_actual.borrow_target std::Option::Some(actual_target) is then
                actual_target common::clone_type = binding_actual
            fi
        fi
        bindings binding_actual binding_expected semantics::bind_semantic_type_arguments

        bindings expected.substitute_t = resolved_expected
        resolved_expected value origins merge_destination_origins = origins
        value resolved_expected self.expect_value_type_t
        origins
    }

    pub fn check_struct_new tc:mut$TypeChecker op:mut$common::Op {
        op.value common::clone_op_value match
            common::OpValue::StructNew(casa_struct) => {
                std::Map[std::String common::Type]::new = bindings
                if op.type_hint std::Option::Some(hint) is then
                    if casa_struct.name hint.match_base == then
                        casa_struct.type_vars hint common::aggregate_type_bindings = bindings
                    fi
                fi
                std::Option[std::List[std::String]]::None = origins
                for member in casa_struct common::CasaStruct::members.iter do
                    origins bindings member.typ tc.expect_aggregate_value = origins
                done
                if 0 casa_struct common::CasaStruct::type_vars.length != then
                    bindings casa_struct common::CasaStruct::type_vars casa_struct common::CasaStruct::name.as_str
                    common::build_resolved_type
                else
                    casa_struct common::CasaStruct::name.clone common::GenericType::new common::Type::Generic
                fi = result_type
                origins result_type tc.stack_push_origins
            }
            _ => {
            }
        end
    }
}

# ============================================================================
# Check struct literal
# ============================================================================

pub fn get_struct_literal_shape
    literal:$common::StructLiteral
    store:$common::SymbolStore
-> std::Option[std::List[std::String]] std::List[common::Type] {
    std::List[common::Type]::new = field_types
    if literal.struct_name store.structs.get std::Option::Some(casa_struct) is then
        for field_name in literal.field_order.iter do
            for member in casa_struct.members.iter do
                if field_name member.name == then
                    member.typ common::clone_type field_types.push
                    break
                fi
            done
        done
        casa_struct.type_vars.clone std::Option::Some field_types
    else
        std::Option[std::List[std::String]]::None field_types
    fi
}

impl TypeChecker {
    pub fn check_struct_literal tc:mut$TypeChecker op:mut$common::Op {
        if op.value common::OpValue::StructLiteral(literal) is then
            literal common::StructLiteral::struct_name.clone = name
            tc.store literal get_struct_literal_shape = field_types = type_variables_opt
            if type_variables_opt std::Option::Some(type_variables) is then
                std::Map[std::String common::Type]::new = bindings
                if op.type_hint std::Option::Some(hint) is then
                    if name hint.match_base == then
                        type_variables hint common::aggregate_type_bindings = bindings
                    fi
                fi
                std::Option[std::List[std::String]]::None = origins
                # Pop field values in reverse order
                field_types.length = index
                while 0 index != do
                    1 -= index
                    origins bindings index field_types.get tc.expect_aggregate_value = origins
                done
                if 0 type_variables.length != then
                    bindings type_variables name.as_str common::build_resolved_type
                else
                    name common::GenericType::new common::Type::Generic
                fi = result_type
                origins result_type tc.stack_push_origins
            else
                name common::GenericType::new common::Type::Generic tc.stack_push_type
            fi
        fi
    }
}

