        fi
        # Lower the operator to the corresponding trait method call.
        type2_t type1_t borrowed_comparison_effect = comparison_effect
        if semantics.into_method std::Option::Some(method) is then
            method.stack_effect.clone = comparison_effect
            if method.function_name.as_str tc.store.get_function std::Option::Some(checked_function) is then
                checked_function.stack_effect.clone = comparison_effect
            fi
            method.method_name.clone
        else
            cmp_value semantics::comparison_method_name.to_str
        fi = method_name
        function_opt op_index ops op comparison_effect value2 value1
        tc.prepare_comparison_values = op_index
        method_name common::OpValue::MethodCall op common::Op::set_value
        function_opt op_index ops op tc.check_method_call
    }
}

