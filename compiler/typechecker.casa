{
    effect StackEffect::trait_bounds.keys = bound_keys
    for bound_type_var in bound_keys.iter do
        if bound_type_var effect StackEffect::trait_bounds.get Option::Some(bound_constraints) is then
            bound_type_var bindings.get = concrete_opt
            if concrete_opt Option::Some(concrete) is then
                for bound_constraint in bound_constraints.iter do
                    store concrete bound_constraint effect bindings method_diff_bind_for_bound
                done
            fi
        fi
    done
}

fn bounds_imply_trait bounds:mut$List[TraitBound] target:mut$Type store:mut$SymbolStore -> bool {
    for bound in bounds.iter do
        bound trait_bound_to_type = direct
        if store target direct trait_type_implies then true return fi
