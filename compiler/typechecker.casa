    value.type_value common::clone_type = target
    if value.type_value.borrow_target std::Option::Some(borrowed_target) is then
        borrowed_target common::clone_type = target
    fi
    if declared.is_exclusive_borrow then
        common::EXCLUSIVE_BORROW_TYPE
    else
        common::SHARED_BORROW_TYPE
    fi
    target common::apply_borrow_type = value.type_value
    std::Option[std::List[std::String]]::None = origins
    if value.origins std::Option::Some(current_origins) is then
        for origin in current_origins.iter do
            origin.as_str origin_place = place
            declared.is_exclusive_borrow place.as_str origins add_origin = origins
        done
    fi
    if origins.is_none then
        if value.place std::Option::Some(place) is then
            declared.is_exclusive_borrow place.as_str origins add_origin = origins
        fi
    fi
    origins = value.origins
}

impl TypeChecker {
