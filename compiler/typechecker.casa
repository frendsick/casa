pub fn validate_generic_cycle_call
    op:$common::Op
    substitutions:mut$std::Map[std::String common::Type]
    active:mut$std::Map[std::String std::String]
    store:$common::SymbolStore
    diagnostics:mut$error::Diagnostics
{
    std::Option[std::String]::None = function_name_opt
    if op.value common::OpValue::FnCall(function_name) is then
        function_name.clone std::Option::Some = function_name_opt
    elif op.value common::OpValue::FnPush(function_name) is then
        function_name.clone std::Option::Some = function_name_opt
    fi
    if function_name_opt.is_none then
        return
    fi
    function_name_opt.unwrap = function_name
    function_name.as_str store.get_function = callee_opt
    if callee_opt.is_none then
        return
    fi
    callee_opt.unwrap = callee_ref
    callee_ref.stack_effect.clone = callee_effect
    if
        0 callee_effect.type_vars.length == 0 callee_effect
            .const_params
            .keys
            .length == &&
    then
        return
    fi
    callee_ref.ops common::clone_ops = callee_ops
    std::Map[std::String common::Type]::new = composed
    for pair in op.call_bindings.iter do
        substitutions pair.second.substitute_t pair.first.clone composed.set
    done
    composed generic_binding_key = key
    if function_name active.get std::Option::Some(previous) is then
        if previous.as_str key.as_str != then
            op.location f"Polymorphic recursion changes the type arguments of `{function_name}`"
            common::ErrorKind::TypeMismatch diagnostics.record_error_string
        fi
        return
    fi
    key.clone function_name.clone active.set
    diagnostics store active composed callee_ops validate_generic_cycles_in_ops
    function_name.as_str active.delete_str
}

pub fn validate_generic_cycles_in_ops
    ops:$std::List[common::Op]
    substitutions:mut$std::Map[std::String common::Type]
    active:mut$std::Map[std::String std::String]
