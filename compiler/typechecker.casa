pub fn check_ops
    ops:mut$std::List[common::Op]
    function_opt:mut$std::Option[common::Function]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
-> common::StackEffect {
    diagnostics store TypeChecker::new = checker
    std::Option[u64]::None = budget
    if function_opt std::Option::Some(the_function) is then
        for variable in the_function.variables.iter do
            true variable.name.as_str checker.set_owner_moved
        done
        if the_function common::Function::name.as_str "lambda__" str::starts_with ! then
            the_function common::Function::stack_effect common::StackEffect::parameters.length std::Option::Some = budget
        fi
    else
        checker
            .store
            .variables
            .keys = global_names
        for global_name in global_names.iter do
            if global_name.as_str common::is_internal_variable_name then
                true global_name.as_str checker.set_owner_moved
            fi
        done
    fi
    budget = checker.param_cap
    std::Map[std::String u64]::new ops count_variable_uses = checker.remaining_uses
    checker.diagnostics.error_count = errors_before_ops
    function_opt ops checker.run_type_check_ops

    if function_opt std::Option::Some(checked_function) is then
        checked_function checker.resolve_declared_return_borrow_capabilities
        if checker.has_return_types ! then
            checked_function checker.validate_borrow_returns
        fi
        checked_function checker.resolve_declared_return_literals
        for capture_name in checked_function.owned_captures.iter do
            if capture_name.as_str checker.owner_is_moved then
                checked_function.location
                f"Repeatable closure does not restore captured owner `{capture_name}`"
                common::ErrorKind::InvalidVariable checker.diagnostics.record_error_string
            fi
        done
    fi

    0 (u64) = stack_index
    while
        stack_index checker
            .stack
            .values
            .length >
    do
        stack_index checker
            .stack
            .values
            .get clone_typed_value = stack_value
        stack_value checker.finish_value_use
        stack_value.type_value resolve_numeric_literal_default = final_type
        checker.literal_resolutions checker.diagnostics final_type stack_value.resolve_literals drop
        false = stack_value.is_literal_constant
        std::List[LiteralRef]::new = stack_value.literals
        final_type = stack_value.type_value
        stack_value stack_index checker
            .stack
            .values
            .set
        1 += stack_index
    done
    if 0 checker.owner_events.length != then
        checker.current_location.clone common::OpValue::OwnerCleanup common::Op::new = cleanup_op
        cleanup_op checker.assign_op_id
        cleanup_op checker.attach_all_owner_cleanups
        cleanup_op ops.push
    fi
    checker.literal_resolutions ops apply_resolved_literal_hints
    checker.diagnostics ops resolve_default_literals

    # Build inferred stack effect
    std::List[common::Type]::new = inferred_returns
    for
        inferred_value in checker
            .stack
            .values
            .iter
    do
        inferred_value.type_value common::clone_type inferred_returns.push
    done
    inferred_returns checker.parameters.clone common::StackEffect::new = inferred

    # Verify against declared stack effect if function has one
    checker.diagnostics.error_count errors_before_ops < = had_type_errors
    if had_type_errors ! then
        if function_opt std::Option::Some(declared_function) is then
            declared_function common::Function::stack_effect = declared: $common::StackEffect
            if
                declared common::stack_effect_to_str.as_str "None -> None" !=
                0 inferred.return_types.length != checker.has_return_types ! || &&
            then
                false = invalid_effect
                if 0 declared.type_vars.length != then
                    declared inferred checked_generic_body_effect_matches ! = invalid_effect
                else
                    inferred declared common::stack_effect_matches ! = invalid_effect
                fi
                if invalid_effect then
                    declared_function common::Function::location f"Invalid stack effect for function `{declared_function common::Function::name}`: expected `{declared common::stack_effect_to_str}`, got `{inferred common::stack_effect_to_str}`" common::ErrorKind::SignatureMismatch checker.diagnostics.record_error_string
                fi
            fi
            # Update inferred stack effect with declared return types for type-var functions
            if 0 declared common::StackEffect::type_vars.length != then
                declared.clone = inferred
            fi
        fi
    fi

    inferred
}

