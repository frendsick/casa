    # Reject an out-of-range constant index before the program runs (ADR-0152).
    # A runtime index keeps the terminating bounds check in `array::nth`.
    pub fn check_constant_array_index
        self:mut$TypeChecker
        stack_effect:$common::StackEffect
        function_name:$str
    {
        if common::ARRAY_NTH_FUNCTION function_name != then
            return
        fi
        std::List[u64]::new = source_parameter_positions
        0 (u64) = parameter_index
        while parameter_index stack_effect.parameters.length > do
            if
                parameter_index stack_effect
                    .parameters
                    .get_ref
                    .name
                    .as_str common::is_hidden_parameter_name !
            then
                parameter_index source_parameter_positions.push
            fi
            1 += parameter_index
        done
        if 2 source_parameter_positions.length != then
            return
        fi
        self
            .stack
            .values
            .length = stack_depth
        1 source_parameter_positions.get copy = index_position
        if stack_depth index_position >= then
            return
        fi
        stack_depth 1 - 0 source_parameter_positions.get copy - self
            .stack
            .values
            .get = array_value: $TypedValue
        stack_depth 1 - index_position - self
            .stack
            .values
            .get = index_value: $TypedValue

        array_value.type_value common::clone_type = array_type
        if array_type.borrow_target std::Option::Some(target) is then
            target common::clone_type = array_type
        fi
        array_type common::get_concrete_array_length = array_length_option
        0 (u64) = array_length
        array_length_option match
            std::Option::Some(length) => length = array_length
            std::Option::None => return
        end

        if index_value.is_literal_constant ! then
            return
        fi
        if 1 index_value.literals.length != then
            return
        fi
        0 index_value.literals.get = literal
        if literal.is_integer then
            literal.integer_value = index_constant
            if array_length i64::try_from.unwrap index_constant >= then
                self.current_location f"Array index {index_constant} is out of bounds for `{array_type.format}`"
                common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
            fi
        fi
    }

    # Keep borrowed owner temporaries in ordinary compiler-managed variables.
