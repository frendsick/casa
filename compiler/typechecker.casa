            }
            common::OpValue::MatchArm(arm) => {
                diagnostics store active substitutions arm.guard_ops validate_generic_cycles_in_ops
            }
            _ => {
            }
        end
    done
}

pub fn validate_generic_cycles store:$common::SymbolStore diagnostics:mut$error::Diagnostics {
    for function_name in store.get_function_names.iter do
        if function_name.as_str store.get_function std::Option::Some(function) is then
            if
