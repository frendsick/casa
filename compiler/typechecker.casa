# ============================================================================

pub fn qualify_default_method_calls
    ops:mut$std::List[common::Op]
    trait_type:$common::Type
    receiver:$common::Type
    store:mut$common::SymbolStore
{
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get_mut = body_op
        body_op.value common::clone_op_value = body_value
        if body_value common::OpValue::MethodCall(method_name) is then
            store receiver method_name.as_str semantics::collect_method_qualifiers = qualifiers
            if
                store method_name.as_str trait_type semantics::trait_type_has_method
                qualifiers.length 1 < &&
            then
                method_name.clone trait_type common::clone_type false common::QualifiedMethod common::OpValue::QualifiedMethodCall
                body_op common::Op::set_value
            fi
        elif body_value common::OpValue::PushArray(items) is then
            items common::clone_ops = owned_items
            store receiver trait_type owned_items qualify_default_method_calls
            owned_items common::OpValue::PushArray body_op common::Op::set_value
        elif body_value common::OpValue::ExprGroup(items) is then
            items common::clone_ops = owned_items
            store receiver trait_type owned_items qualify_default_method_calls
            owned_items common::OpValue::ExprGroup body_op common::Op::set_value
        fi
        1 += op_index
    done
}

pub fn get_default_trait_specialization_parts
    trait_name:$str
    method_name:$str
    store:$common::SymbolStore
-> std::Option[common::TraitMethod] std::List[std::String] std::List[common::TraitMethod] {
    if trait_name store.traits.get_str std::Option::Some(casa_trait) is then
        store casa_trait method_name semantics::find_semantic_trait_method = default_method
        casa_trait.type_params.clone = type_parameters
        std::List[common::TraitMethod]::new = declared_methods
        for method in casa_trait.methods.iter do
            method common::clone_trait_method declared_methods.push
        done
        default_method type_parameters declared_methods
    else
        std::Option[common::TraitMethod]::None std::List[std::String]::new std::List[common::TraitMethod]::new
    fi
}

pub fn instantiate_default_trait_method
    semantics:semantics::MethodSemantics
    receiver:$common::Type
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
-> std::Option[std::String] {
    semantics.function_name.clone = receiver_key
    if receiver_key.as_str store.has_function then
        receiver_key.clone std::Option::Some return
    fi
    store semantics.method_name.as_str semantics.trait_name.as_str get_default_trait_specialization_parts
    = declared_methods = type_params = default_method_opt
    if default_method_opt std::Option::None is then
        std::Option[std::String]::None return
    fi
    default_method_opt.unwrap = default_method

    # Check that receiver implements all abstract methods
    std::List[common::Type]::new = required_trait_arguments
    for type_parameter in type_params.iter do
        type_parameter.clone common::Type::TypeVar required_trait_arguments.push
    done
    required_trait_arguments semantics.trait_name.clone common::GenericType common::Type::Generic
    = required_trait_type
    if semantics.trait_type std::Option::Some(resolved_trait_type) is then
        resolved_trait_type common::clone_type = required_trait_type
    fi
    if store required_trait_type receiver semantics::type_has_semantic_trait_shape ! then
        std::Option[std::String]::None return
    fi

    # Determine function name and whether to use generic or concrete form
    receiver.base = fn_base_opt
    semantics.function_name = synth_fn_name: $std::String

    # For generic receivers, keep trait type params as function type vars.
    # For non-generic receivers, substitute trait type params with concrete types.
    std::Map[std::String common::Type]::new = trait_subs
    receiver common::clone_type = default_self_type
    common::empty_stack_effect = resolved_stack_effect
    if fn_base_opt std::Option::Some(base_name) is then
        if 0 type_params.length != then
            std::List[common::Type]::new = default_type_params
            for type_param in type_params.iter do
                type_param.clone common::Type::TypeVar default_type_params.push
            done
            default_type_params base_name.clone common::GenericType common::Type::Generic
            = default_self_type
        fi
        default_self_type default_method common::TraitMethod::stack_effect common::resolve_trait_stack_effect = resolved_stack_effect
    else
        if semantics.trait_type std::Option::Some(resolved_trait_type) is then
            if resolved_trait_type.type_params std::Option::Some(trait_args) is then
                for pair in trait_args.iter type_params.iter.zip do
                    pair.second common::clone_type pair.first.clone trait_subs.set
                done
            fi
        fi
        # Infer trait type params from concrete method stack effects
        std::Set[std::String]::new = type_param_set
        for type_param in type_params.iter do
            type_param.clone type_param_set.add
        done
        for infer_method in declared_methods.iter do
            if 0 infer_method common::TraitMethod::default_ops.length == then
                store std::Option[common::Function]::None receiver infer_method common::TraitMethod::name.as_str
                semantics::resolve_method_semantics = infer_method_opt
                std::Option[CheckedFunction]::None = infer_fn_opt
                if infer_method_opt std::Option::Some(infer_semantics) is then
                    diagnostics store infer_semantics.function_name.as_str ensure_typechecked = infer_fn_opt
                fi
                if infer_fn_opt.is_some then
                    infer_fn_opt.unwrap = infer_fn
                    receiver infer_method common::TraitMethod::stack_effect common::resolve_trait_stack_effect = infer_trait_resolved
                    0 (u64) = ret_index
                    while
                        ret_index infer_trait_resolved common::StackEffect::return_types.length > ret_index infer_fn.stack_effect common::StackEffect::return_types.length > &&
                    do
                        type_param_set ret_index infer_fn.stack_effect common::StackEffect::return_types.get ret_index infer_trait_resolved common::StackEffect::return_types.get trait_subs bind_generic_params_standalone = trait_subs
                        1 += ret_index
                    done
                fi
            fi
        done
        trait_subs receiver default_method common::TraitMethod::stack_effect common::resolve_trait_stack_effect common::apply_type_subs_to_stack_effect = resolved_stack_effect
    fi

    # Add trait type params as function type vars for generic receivers
    if fn_base_opt.is_some then
        std::Set[std::String]::new = receiver_type_vars
        receiver_type_vars receiver common::collect_stack_effect_type_vars
        for receiver_type_var in receiver_type_vars.iter do
            receiver_type_var.clone resolved_stack_effect common::StackEffect::type_vars.add
        done
        for type_param in type_params.iter do
            type_param.clone resolved_stack_effect common::StackEffect::type_vars.add
        done
    fi

    default_self_type common::clone_type common::TRAIT_SELF_TYPE trait_subs.set_str

    # Add method-level type vars to stack effect
    for method_type_var in default_method common::TraitMethod::type_vars.iter do
        method_type_var.clone resolved_stack_effect common::StackEffect::type_vars.add
    done

    # Build function ops: parameter assignments + cloned body
    std::List[common::Op]::new = synth_ops
    std::List[common::Variable]::new = synth_vars
    for synth_param in resolved_stack_effect common::StackEffect::parameters.iter do
        if "" synth_param common::Parameter::name.as_str != then
            synth_param common::Parameter::typ common::clone_type synth_param common::Parameter::name.clone common::Variable synth_vars.push
            common::empty_location synth_param common::Parameter::name.clone common::OpValue::AssignVar common::Op::new synth_ops.push
        fi
    done

    default_method common::TraitMethod::default_ops common::clone_ops = cloned_body
    if 0 trait_subs.length != then
        trait_subs cloned_body common::substitute_ops_types
    fi
    if semantics.trait_type std::Option::Some(default_trait_type) is then
        store receiver default_trait_type cloned_body qualify_default_method_calls
    fi
    0 (u64) = cloned_lambda_index
    0 (u64) = body_index
    while body_index cloned_body.length > do
        body_index cloned_body.get_mut = body_op
        1 += body_index
        if body_op.value common::OpValue::FnPush(lambda_name) is then
            if lambda_name.as_str "lambda__" str::starts_with ! then
                continue
            fi
            lambda_name.as_str store.get_function = lambda_opt
            if lambda_opt.is_none then
                continue
            fi
            lambda_opt.unwrap.clone_for_import = lambda

            f"{lambda_name}__{synth_fn_name}_{cloned_lambda_index}" = cloned_lambda_name
            # The specialization mutates its cloned body and declaration independently.
            lambda.split_body = lambda_ops = lambda
            if 0 trait_subs.length != then
                trait_subs lambda_ops common::substitute_ops_types
            fi
            if semantics.trait_type std::Option::Some(default_trait_type) is then
                store receiver default_trait_type lambda_ops qualify_default_method_calls
            fi
            std::List[common::Parameter]::new = lambda_params
            std::List[common::Type]::new = lambda_returns
            lambda_returns lambda_params common::StackEffect::new = lambda_effect
            for lambda_type_var in resolved_stack_effect common::StackEffect::type_vars.iter do
                lambda_type_var.clone lambda_effect common::StackEffect::type_vars.add
            done
            lambda_effect lambda common::Function::location.clone lambda_ops cloned_lambda_name.clone common::Function::with_stack_effect = cloned_lambda
            lambda.variables.clone cloned_lambda common::Function::set_variables
            lambda.captures.clone cloned_lambda common::Function::set_captures
            lambda.global_captures.clone cloned_lambda common::Function::set_global_captures
            lambda.captures_by_move cloned_lambda common::Function::set_captures_by_move
            lambda.captures_shared cloned_lambda common::Function::set_captures_shared
            0 (u64) = lambda_op_index
            while lambda_op_index cloned_lambda.ops.length > do
                lambda_op_index cloned_lambda.ops.get = lambda_op
                if lambda_op.value common::OpValue::PushCapture(capture_name) is then
                    if capture_name.as_str cloned_lambda.captures common::variable_list_contains ! then
                        capture_name.as_str common::Variable::new cloned_lambda.captures.push
                    fi
                fi
                1 += lambda_op_index
            done
            cloned_lambda store.set_function
            cloned_lambda_name common::OpValue::FnPush body_op common::Op::set_value
            1 += cloned_lambda_index
        fi
    done
    cloned_body synth_ops.append

    # Create, register, and typecheck the function
    resolved_stack_effect common::empty_location synth_ops synth_fn_name.clone common::Function::with_stack_effect = synth_fn
    synth_vars synth_fn common::Function::set_variables
    synth_fn store.set_function
    diagnostics store synth_fn_name.as_str ensure_typechecked drop

    synth_fn_name.clone std::Option::Some
}

impl TypeChecker {
    pub fn apply_trait_bound_method_semantics
        tc:mut$TypeChecker
        semantics:semantics::MethodSemantics
        receiver:$common::Type
        op:mut$common::Op
        ops:mut$std::List[common::Op]
        op_index:u64
        function_opt:mut$std::Option[common::Function]
    -> u64 {
        tc.stack_pop_drop
        receiver tc.stack_push_type
        semantics.method_name.as_str receiver.make_method_key = method_key
        semantics.stack_effect.clone = effect
        function_opt op_index ops op 0 effect tc.bind_borrowed_temporaries = bound
        bound += op_index
        function_opt std::Option[common::Type]::None method_key.as_str
        effect tc.apply_stack_effect
        effect semantics.trait_type.clone receiver common::clone_type semantics.method_name.clone
        common::DeferredTraitCall::new common::OpValue::TraitMethodCall op common::Op::set_value
        op_index
    }
}

# ============================================================================
# Check method call
# ============================================================================

impl TypeChecker {
    pub fn check_char_codepoint tc:mut$TypeChecker op:mut$common::Op method_name:$str -> bool {
        if "codepoint" method_name.as_str != then
            false return
        fi
        tc.stack_pop_value = value
        if value.type_value common::make_char_type.eq ! then
            op.location f"Method `codepoint` requires `char`, got `{value.type_value.format}`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        fi
        common::BuiltinType::U32 common::BuiltinType::Char common::NumericConversionKind::ToBits common::NumericConversion
        common::OpValue::NumericConvert op common::Op::set_value
        common::make_u32_type common::clone_type std::Option::Some op common::Op::set_type_hint
        common::make_u32_type tc.stack_push_type
        true
    }

    pub fn check_try_integer_method tc:mut$TypeChecker op:mut$common::Op method_name:$str -> bool {
        if
            "try_add" method_name.as_str ==
            "try_sub" method_name.as_str == ||
            "try_mul" method_name.as_str == ||
            "try_div" method_name.as_str == ||
            "try_mod" method_name.as_str == || !
        then
            false return
        fi
        tc.stack_pop_value = receiver
        receiver tc.stack_pop_left_like = other
        common::make_i64_type common::clone_type = target_type
        if receiver.type_value.is_integer_type_t then
            receiver.type_value common::clone_type = target_type
        elif other.type_value.is_integer_type_t then
            other.type_value common::clone_type = target_type
        fi
        if target_type common::Type::Builtin(target) is then
            target_type receiver tc.resolve_integer_value drop
            target_type other tc.resolve_integer_value drop
            method_name.clone match
                "try_add" => common::IntegerTryKind::Add
                "try_sub" => common::IntegerTryKind::Sub
                "try_mul" => common::IntegerTryKind::Mul
                "try_div" => common::IntegerTryKind::Div
                _ => common::IntegerTryKind::Mod
            end = kind
            target kind common::IntegerTry common::OpValue::IntegerTry op common::Op::set_value
            target_type common::clone_type std::Option::Some op common::Op::set_type_hint
            std::List[common::Type]::new = option_params
            target_type common::clone_type option_params.push
            option_params common::STD_OPTION_TYPE.to_str common::GenericType common::Type::Generic tc.stack_push_type
            true return
        fi
        f"Method requires integer operands, got `{receiver.type_value.format}` and `{other.type_value.format}`" tc.raise_type_mismatch
        common::make_unknown_type tc.stack_push_type
        true
    }

    pub fn check_float_round tc:mut$TypeChecker op:mut$common::Op method_name:$str -> bool {
        if
            "__float_floor" method_name.as_str ==
            "__float_ceil" method_name.as_str == ||
            "__float_trunc" method_name.as_str == ||
            "__float_round" method_name.as_str == || !
        then
            false return
        fi
        tc.stack_pop_value = value
        if value.type_value common::Type::Builtin(target) is then
            if target.is_float then
                target (i64) = target_value
                target_value (common::BuiltinType) method_name.to_str common::FloatRound = rounding
                rounding common::OpValue::FloatRound op common::Op::set_value
                target_value (common::BuiltinType) common::Type::Builtin std::Option::Some op common::Op::set_type_hint
                target_value (common::BuiltinType) common::Type::Builtin tc.stack_push_type
                true return
            fi
        fi
        op.location f"Method `{method_name}` requires `f32` or `f64`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        common::make_unknown_type tc.stack_push_type
        true
    }

    pub fn check_wrapping_method tc:mut$TypeChecker op:mut$common::Op method_name:$str -> bool {
        if
            "wrapping_add" method_name.as_str ==
            "wrapping_sub" method_name.as_str == ||
            "wrapping_mul" method_name.as_str == || !
        then
            false return
        fi
        tc.stack_pop_value = receiver
        receiver tc.stack_pop_left_like = other
        common::make_i64_type common::clone_type = target
        if receiver.type_value.is_integer_type_t then
            receiver.type_value common::clone_type = target
        elif other.type_value.is_integer_type_t then
            other.type_value common::clone_type = target
        fi
        if target.is_integer_type_t ! then
            f"Method requires integer operands, got `{receiver.type_value.format}` and `{other.type_value.format}`" tc.raise_type_mismatch
            false return
        fi
        target receiver tc.resolve_integer_value drop
        target other tc.resolve_integer_value drop
        if "wrapping_add" method_name.as_str == then
            common::OpValue::WrappingAdd op common::Op::set_value
        elif "wrapping_sub" method_name.as_str == then
            common::OpValue::WrappingSub op common::Op::set_value
        else
            common::OpValue::WrappingMul op common::Op::set_value
        fi
        target common::clone_type std::Option::Some op common::Op::set_type_hint
        target tc.stack_push_type
        true
    }

    pub fn check_method_call
        tc:mut$TypeChecker
        op:mut$common::Op
        ops:mut$std::List[common::Op]
        op_index:u64
        function_opt:mut$std::Option[common::Function]
    -> u64 {
        std::Option[std::String]::None = method_name_opt
        op.value common::clone_op_value = method_value
        if method_value common::OpValue::MethodCall(method_name) is then
            method_name.clone std::Option::Some = method_name_opt
        elif method_value common::OpValue::QualifiedMethodCall(qualified) is then
            qualified.method_name.clone std::Option::Some = method_name_opt
        fi
        if method_name_opt std::Option::Some(method_name) is then
            if "drop" method_name.as_str == then
                op.location "Reserved `drop` methods cannot be called directly; use the `drop` intrinsic" common::ErrorKind::InvalidScope tc.diagnostics.record_error
            fi
            tc.stack_peek_type = receiver
            f"{receiver.match_base}::{method_name}" = method_key
            if
                op
                    .location
                    .file
                    .as_str method_key.as_str tc.store.is_private_from
            then
                op.location f"Method `{method_key}` is private" common::ErrorKind::InvalidScope tc.diagnostics.record_error_string
                op_index return
            fi
            ValueCapability::Owned = receiver_capability
            if
                0 tc
                    .stack
                    .values
                    .length !=
            then
                tc
                    .stack
                    .values
                    .length 1 - tc
                    .stack
                    .values
                    .get
                    .capability = receiver_capability
            fi
            receiver common::clone_type = lookup_receiver
            if
                receiver.is_shared_borrow
                receiver_capability ValueCapability::Exclusive is &&
            then
                receiver.borrow_target.unwrap common::clone_type = receiver_target
                common::EXCLUSIVE_BORROW_TYPE receiver_target common::apply_borrow_type = lookup_receiver
            elif receiver.is_borrow ! then
                if receiver_capability ValueCapability::Shared is then
                    common::SHARED_BORROW_TYPE receiver common::clone_type common::apply_borrow_type = lookup_receiver
                elif receiver_capability ValueCapability::Exclusive is then
                    common::EXCLUSIVE_BORROW_TYPE receiver common::clone_type common::apply_borrow_type = lookup_receiver
                fi
            fi
            if "clone" method_name.as_str == then
                op.location lookup_receiver tc.store ensure_function_clone_method
            fi
            if method_value common::OpValue::MethodCall is then
                if method_name.as_str op tc.check_float_to_bits then
                    op_index return
                fi
                if method_name.as_str op tc.check_char_codepoint then
                    op_index return
                fi
                if method_name.as_str op tc.check_float_round then
                    op_index return
                fi
                if method_name.as_str op tc.check_try_integer_method then
                    op_index return
                fi
                if method_name.as_str op tc.check_wrapping_method then
                    op_index return
                fi
            fi
            method_value common::clone_op_value = analyzed_method_value
            tc.store function_opt lookup_receiver semantics::make_type_borrow_option analyzed_method_value
            semantics::analyze_operation = semantics
            semantics.into_method match
                std::Option::Some(method_semantics) => {
                    method_name.as_str receiver_capability method_semantics.stack_effect
                    tc.check_method_receiver_capability
                    if method_semantics.kind semantics::MethodSemanticsKind::TraitBound is then
                        function_opt op_index ops op receiver method_semantics
                        tc.apply_trait_bound_method_semantics return
                    fi
                    method_semantics.function_name.clone = fn_name
                    if method_semantics.kind semantics::MethodSemanticsKind::DefaultMethod is then
                        receiver common::clone_type = default_receiver
                        if default_receiver.borrow_target std::Option::Some(target) is then
                            target common::clone_type = default_receiver
                        fi
                        tc.diagnostics tc.store default_receiver method_semantics
                        instantiate_default_trait_method = default_inst_opt
                        if default_inst_opt std::Option::Some(default_name) is then
                            default_name.clone = fn_name
                        fi
                    fi
                    tc.diagnostics tc.store fn_name.as_str ensure_typechecked = checked_function_opt
                    checked_function_opt match
                        std::Option::Some(function) => {
                            function.into_parts = is_unsafe = effect
                            if is_unsafe then
                                fn_name.as_str op tc.require_unsafe
                            fi
                            if
                                0 effect.type_vars.length != 0 effect
                                    .const_params
                                    .keys
                                    .length != ||
                            then
                                std::Option[common::Type]::None function_opt op.location effect
                                tc.resolve_generic_call_bindings = op.call_bindings
                            fi
                            function_opt op_index ops op 0 effect tc.bind_borrowed_temporaries = bound
                            bound += op_index
                            function_opt op.type_hint.clone fn_name.as_str effect
                            tc.apply_stack_effect
                            receiver_capability fn_name.as_str tc.mark_struct_getter_borrow
                            fn_name common::OpValue::FnCall op common::Op::set_value
                            op_index return
                        }
                        std::Option::None => {
                        }
                    end
                }
                std::Option::None => {
                }
            end
            method_name.as_str receiver.make_method_key = missing_name
            tc.store receiver method_name.as_str semantics::collect_method_qualifiers = qualifiers
            if qualifiers.length 1 < then
                ", " qualifiers.join_strings = qualifier_list
                op.location f"Method `{missing_name}` is ambiguous between `{qualifier_list}`. Use a trait-qualified call"
                common::ErrorKind::TraitSignatureMismatch tc.diagnostics.record_error_string
            else
                op.location f"Method `{missing_name}` does not exist"
                common::ErrorKind::UndefinedName tc.diagnostics.record_error_string
            fi
        fi
        op_index
    }
}

# ============================================================================
# Check f-string expression conversion (Display trait dispatch)
# ============================================================================

impl TypeChecker {
    pub fn check_fstring_to_str
        tc:mut$TypeChecker
        op:mut$common::Op
        ops:mut$std::List[common::Op]
        op_index:u64
        function_opt:mut$std::Option[common::Function]
    -> u64 {
        "value with trait `Display`".to_str = tc.current_expect_ctx
        tc.stack_peek_type = fstring_type_t
        fstring_type_t common::clone_type = fstring_value_type
        if fstring_value_type.borrow_target std::Option::Some(target) is then
            target common::clone_type = fstring_value_type
        fi
        if common::make_string_type fstring_value_type.eq then
            tc
                .stack
                .values
                .length 1 - tc
                .stack
                .values
                .get = string_value
            if string_value.capability ValueCapability::Owned is then
                op_index return
            fi
            "clone".to_str common::OpValue::MethodCall op common::Op::set_value
            function_opt op_index ops op tc.check_method_call return
        fi
        if common::make_str_type fstring_value_type.eq then
            "to_str".to_str common::OpValue::MethodCall op common::Op::set_value
            function_opt op_index ops op tc.check_method_call return
        fi
        fstring_type_t.format = fstring_type
        if common::TYPE_MISSING fstring_type.as_str == common::TYPE_UNKNOWN fstring_type.as_str == || then
            tc.stack_pop_drop
            common::make_string_type tc.stack_push_type
            op_index return
        fi
        if fstring_type_t common::Type::Builtin(builtin) is then
            if
                builtin.is_integer
                builtin common::BuiltinType::Bool == ||
                builtin common::BuiltinType::Char == ||
                builtin common::BuiltinType::Cstr == ||
            then
                builtin common::OpValue::PrimitiveToStr op common::Op::set_value
                tc.stack_pop_drop
                common::make_string_type tc.stack_push_type
                op_index return
            fi
        fi
        tc.store function_opt fstring_type_t semantics::make_type_borrow_option op.value
        semantics::analyze_operation = semantics
        common::STD_DISPLAY_TRAIT.to_str common::GenericType::new common::Type::Generic = display_type
        if tc.diagnostics tc.store function_opt display_type fstring_type_t type_satisfies_trait ! then
            op common::Op::location f"Type `{fstring_type}` cannot be used in f-string: does not satisfy trait `Display`" common::ErrorKind::MissingTraitMethod tc.diagnostics.record_error_string
            tc.stack_pop_drop
            common::make_string_type tc.stack_push_type
            op_index return
        fi
        if semantics.method std::Option::Some(method) is then
            method.method_name.clone common::OpValue::MethodCall op common::Op::set_value
        else
            "to_str".to_str common::OpValue::MethodCall op common::Op::set_value
        fi
        function_opt op_index ops op tc.check_method_call
    }
}

# ============================================================================
# Ensure a function is typechecked
# ============================================================================

pub struct CheckedFunction {
    pub stack_effect: common::StackEffect
    pub is_unsafe:    bool
}

impl CheckedFunction {
    pub fn into_parts self:CheckedFunction -> common::StackEffect bool {
        self match
            CheckedFunction { stack_effect: stack_effect is_unsafe: is_unsafe } => stack_effect is_unsafe
        end
    }
}

pub fn checked_function_summary function:$common::Function -> CheckedFunction {
    CheckedFunction { stack_effect: function.stack_effect.clone is_unsafe: function.is_unsafe }
}

pub fn ensure_typechecked
    function_name:$str
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
-> std::Option[CheckedFunction] {
    if function_name store.get_function std::Option::Some(existing) is then
        if existing.is_typechecked then
            existing checked_function_summary std::Option::Some return
        fi
    fi
    function_name store.take_function_for_typecheck = function_opt
    if function_opt.is_none then
        std::Option[CheckedFunction]::None return
    fi
    function_opt.unwrap = function
    function.split_body = function_ops = function
    diagnostics function function_ops store syntax::resolve_identifiers
    function std::Option::Some = active_function
    diagnostics store active_function function_ops check_ops = inferred_stack_effect
    active_function.unwrap = function
    function_ops function common::Function::set_ops
    function common::Function::stack_effect common::stack_effect_to_str = effect_text
    if effect_text.as_str "None -> None" == then
        if function.name.as_str "lambda__" str::starts_with then
            inferred_stack_effect function common::Function::set_stack_effect
        else
            std::Map[std::String common::StackEffect]::new = inferred_effects
            store inferred_effects function semantics::analyze_function_semantics
            = semantics
            semantics.inferred_effect.clone function common::Function::set_stack_effect
        fi
    fi
    function checked_function_summary = summary
    function store.restore_function
    summary std::Option::Some
}

# ============================================================================
# Main type check dispatch
# ============================================================================

impl TypeChecker {
    pub fn check_copy_operation
        tc:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        tc
            .stack
            .values
            .length = depth
        0 (u64) = copied_index
        if op.value common::OpValue::Over is then
            if depth 2 < then
                function_opt op tc.apply_fixed_semantics return
            fi
            depth 2 - = copied_index
        else
            if 0 depth == then
                function_opt op tc.apply_fixed_semantics return
            fi
            depth 1 - = copied_index
        fi
        copied_index tc
            .stack
            .values
            .get = copied_value
        copied_value.type_value common::clone_type = copied_type
        if copied_type.is_borrow ! then
            if copied_value.capability ValueCapability::Shared is then
                common::SHARED_BORROW_TYPE copied_type common::clone_type common::apply_borrow_type = copied_type
            elif copied_value.capability ValueCapability::Exclusive is then
                common::EXCLUSIVE_BORROW_TYPE copied_type common::clone_type common::apply_borrow_type = copied_type
            fi
        fi
        copied_type common::clone_type = copy_check_type
        if op.value common::OpValue::Copy is then
            if copy_check_type.borrow_target std::Option::Some(target) is then
                target common::clone_type = copy_check_type
            fi
        fi
        copy_check_type resolve_numeric_literal_default = copy_check_type
        if function_opt copy_check_type tc.type_is_duplicable ! then
            op.location f"Type `{copied_type.format}` does not satisfy trait `Copy`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        fi
        function_opt op tc.apply_fixed_semantics
    }

    fn check_size_of
        self:mut$TypeChecker
        op:mut$common::Op
        target_type:$common::Type
        function_opt:mut$std::Option[common::Function]
    {
        op.location function_opt target_type self.validate_type_exists
        if
            target_type.has_unresolved_type_var !
            self.store target_type common::type_inline_size.is_none &&
        then
            op.location f"Cannot determine inline size of `{target_type.format}`"
            common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
        fi
        common::make_u64_type self.stack_push_type
    }

    fn check_type_cast
        self:mut$TypeChecker
        op:mut$common::Op
        cast_type_ref:$common::Type
        function_opt:mut$std::Option[common::Function]
    {
        cast_type_ref common::clone_type = cast_type
        op common::Op::location function_opt cast_type self.validate_type_exists
        self.stack_pop_value = cast_value
        if
            0 cast_value.literals.length !=
            common::ARRAY_TYPE cast_type.match_base.as_str == &&
        then
            self.literal_resolutions self.diagnostics cast_type cast_value.resolve_literals drop
        fi
        cast_value.origins clone_origins = cast_origins
        if cast_type common::make_char_type.eq then
            op.location "Cast to `char` is not allowed; use `char::from_codepoint`" common::ErrorKind::TypeMismatch self.diagnostics.record_error
        elif cast_value.type_value common::make_char_type.eq then
            op.location "Cast from `char` is not allowed; use `.codepoint`" common::ErrorKind::TypeMismatch self.diagnostics.record_error
        fi
        if cast_type common::make_ptr_type.eq cast_value.type_value common::make_ptr_type.eq || then
            "pointer cast" op self.require_unsafe
        fi
        if
            cast_type common::make_ptr_type.eq
            self.store cast_type type_has_borrow ||
        then
            cast_value self.release_value
        else
            cast_value self.consume_value
        fi
        if self.store cast_type type_has_borrow then
            if cast_origins.is_none 0 self.unsafe_depth != && then
                cast_type.is_exclusive_borrow function_opt
                self.raw_borrow_input_origins = cast_origins
            fi
            cast_origins cast_type self.stack_push_origins
        else
            cast_type self.stack_push_type
        fi
    }

    fn run_type_check_op
        self:mut$TypeChecker
        current_op:mut$common::Op
        ops:mut$std::List[common::Op]
        op_index:u64
        function_opt:mut$std::Option[common::Function]
    -> u64 {
        if
            current_op.value common::OpValue::Dup is
            current_op.value common::OpValue::Over is ||
            current_op.value common::OpValue::Copy is ||
        then
            function_opt current_op self.check_copy_operation
            op_index return
        fi
        if
            current_op.value common::OpValue::Add is
            current_op.value common::OpValue::Sub is ||
            current_op.value common::OpValue::Mul is ||
            current_op.value common::OpValue::Div is ||
            current_op.value common::OpValue::Mod is ||
            current_op.value common::OpValue::Shl is ||
            current_op.value common::OpValue::Shr is ||
            current_op.value common::OpValue::BitAnd is ||
            current_op.value common::OpValue::BitOr is ||
            current_op.value common::OpValue::BitXor is ||
            current_op.value common::OpValue::BitNot is ||
        then
            current_op self.check_integer_operation
            op_index return
        fi
        if current_op.value common::OpValue::Drop is then
            current_op self.check_stack_ops
            op_index return
        fi
        if current_op.value semantics::operation_uses_fixed_typecheck_effect then
            function_opt current_op self.apply_fixed_semantics
            op_index return
        fi
        if current_op.value semantics::operation_is_comparison then
            function_opt op_index ops current_op self.check_comparison return
        fi
        if current_op.value semantics::operation_is_memory then
            function_opt current_op self.check_memory
            op_index return
        fi
        current_op.value match
            common::OpValue::UnsafeStart => 1 += self.unsafe_depth
            common::OpValue::UnsafeEnd => {
                if 0 self.unsafe_depth != then
                    1 -= self.unsafe_depth
                fi
            }
            common::OpValue::Question(_) => function_opt op_index ops current_op self.lower_question_operator
            common::OpValue::QuestionMove(_) => current_op self.consume_question_owner
            common::OpValue::NumericCall(_) => current_op self.check_numeric_call
            common::OpValue::AssignVar(_) => function_opt op_index ops current_op self.check_assignment
            common::OpValue::AssignDec(_) => function_opt op_index ops current_op self.check_assignment
            common::OpValue::AssignInc(_) => function_opt op_index ops current_op self.check_assignment
            common::OpValue::BindTemporary(_) => function_opt current_op self.check_temporary_binding
            common::OpValue::PushVar(_) => function_opt current_op self.check_push_var
            common::OpValue::PushCapture(_) => function_opt current_op self.check_push_var
            common::OpValue::InitGlobal(_) => current_op self.check_global_initializer
            common::OpValue::IfStart => current_op self.check_if_block
            common::OpValue::IfCondition => current_op self.check_if_block
            common::OpValue::IfElif => current_op self.check_if_block
            common::OpValue::IfElse => current_op self.check_if_block
            common::OpValue::IfEnd => current_op self.check_if_block
            common::OpValue::WhileStart => current_op self.check_while_block
            common::OpValue::WhileCondition => current_op self.check_while_block
            common::OpValue::WhileBreak => current_op self.check_while_block
