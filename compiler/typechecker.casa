# Stack-based type inference and checking for the Casa compiler.
#
# Maintains a virtual stack of types and validates that operations
# are type-safe.
import "std"
import "common"
import "error"
import "syntax"
import "block_scope"
import "semantics"
import "pattern"

# ============================================================================
# TypedStack — typed values with source and unresolved-literal origins.
# ============================================================================

struct TypedStack {
    values: List[TypedValue]
}

enum ValueCapability {
    Owned
    Shared
    Exclusive
}

struct TypedValue {
    type_value: Type
    origin:     Location
    literals:   List[Op]
    place:      Option[str]
    capability: ValueCapability
    binding:    Option[str]
    source:     Option[Op]
    origins:    Option[List[str]]
}

fn origin_is_exclusive origin:mut$str -> bool {
    origin "!" str::starts_with
}

fn origin_place origin:mut$str -> str {
    if origin origin_is_exclusive then
        origin.length 1 - = length
        origin 1 length str::substring return
    fi
    origin.clone
}

fn origin_matches_place origin:mut$str place:mut$str -> bool {
    origin origin_place = origin_path
    if origin_path place == then true return fi
    if origin_path f"{place}." str::starts_with then true return fi
    place f"{origin_path}." str::starts_with
}

fn get_place_root place:mut$str -> str {
    place "." str::split = parts
    0 parts.get.clone
}

fn add_origin origins:Option[List[str]] place:mut$str exclusive:bool -> Option[List[str]] {
    if exclusive then f"!{place}" else place.clone fi = origin
    if origins Option::Some(items) is then
        if origin items string_list_contains ! then origin items.push fi
        items Option::Some return
    fi
    List[str]::new = items
    origin items.push
    items Option::Some
}

fn merge_origins target:Option[List[str]] source:mut$Option[List[str]] -> Option[List[str]] {
    if source Option::Some(items) is then
        for origin in items.iter do
            origin origin_place = place
            origin origin_is_exclusive place target add_origin = target
        done
    fi
    target
}

fn clone_origins source:mut$Option[List[str]] -> Option[List[str]] {
    if source Option::Some(items) is then
        List[str]::new = cloned
        for origin in items.iter do origin.clone cloned.push done
        cloned Option::Some return
    fi
    Option[List[str]]::None
}

fn has_origin_descendant origin:mut$str origins:$List[str] -> bool {
    origin origin_place = place
    for other in origins.iter do
        if other origin_is_exclusive ! then continue fi
        other origin_place = other_place
        if place other_place != other_place f"{place}." str::starts_with && then true return fi
    done
    false
}

fn count_variable_uses ops:mut$List[Op] counts:Map[str u64] -> Map[str u64] {
    for op in ops.iter do
        if op.value OpValue::PushVar(name) is then
            0 (u64) = count
            if name counts.get Option::Some(found) is then found = count fi
            count 1 + name.clone counts.set = counts
        fi
        if op.value OpValue::PushArray(items) is then
            counts items count_variable_uses = counts
        elif op.value OpValue::ExprGroup(items) is then
            counts items count_variable_uses = counts
        elif op.value OpValue::MatchArm(arm) is then
            counts arm.guard_ops count_variable_uses = counts
        fi
    done
    counts
}

fn type_capability typ:mut$Type -> ValueCapability {
    if typ.is_shared_borrow then ValueCapability::Shared return fi
    if typ.is_exclusive_borrow then ValueCapability::Exclusive return fi
    ValueCapability::Owned
}

fn type_contains_borrow
    typ:mut$Type
    exclusive:bool
    store:mut$SymbolStore
    visiting:mut$List[str]
-> bool {
    if typ.is_borrow then
        if exclusive then typ.is_exclusive_borrow else typ.is_shared_borrow fi return
    fi
    if typ Type::Generic(generic) is then
        for parameter in generic.params.iter do
            if visiting store exclusive parameter type_contains_borrow then true return fi
        done
        if generic.base visiting string_list_contains then false return fi
        generic.base.clone visiting.push
        Map[str Type]::new = bindings
        if generic.base store.structs.get Option::Some(casa_struct) is then
            for pair in generic.params.iter casa_struct.type_vars.iter.zip do
                pair.second clone_type pair.first.clone bindings.set = bindings
            done
            for member in casa_struct.members.iter do
                bindings member.typ.substitute_t = member_type
                if visiting store exclusive member_type type_contains_borrow then true return fi
            done
        elif generic.base store.enums.get Option::Some(casa_enum) is then
            for pair in generic.params.iter casa_enum.type_vars.iter.zip do
                pair.second clone_type pair.first.clone bindings.set = bindings
            done
            for payload_types in casa_enum.variant_types.values.iter do
                for payload_type in payload_types.iter do
                    bindings payload_type.substitute_t = resolved
                    if visiting store exclusive resolved type_contains_borrow then true return fi
                done
            done
        fi
    fi
    false
}

fn type_has_shared_borrow typ:mut$Type store:mut$SymbolStore -> bool {
    if typ.is_shared_borrow then true return fi
    if typ Type::Generic is ! then false return fi
    f"shared:{typ.format}" = key
    if key store.borrow_shapes.get Option::Some(cached) is then cached return fi
    List[str]::new = visiting
    visiting store false typ type_contains_borrow = result
    result key store.borrow_shapes.set drop
    result
}

fn type_has_exclusive_borrow typ:mut$Type store:mut$SymbolStore -> bool {
    if typ.is_exclusive_borrow then true return fi
    if typ Type::Generic is ! then false return fi
    f"exclusive:{typ.format}" = key
    if key store.borrow_shapes.get Option::Some(cached) is then cached return fi
    List[str]::new = visiting
    visiting store true typ type_contains_borrow = result
    result key store.borrow_shapes.set drop
    result
}

fn type_has_borrow typ:mut$Type store:mut$SymbolStore -> bool {
    if store typ type_has_shared_borrow then true return fi
    store typ type_has_exclusive_borrow
}

fn method_receiver_type effect:$StackEffect -> Option[Type] {
    for parameter in effect.parameters.iter do
        if parameter.name is_hidden_parameter_name ! then
            parameter.typ clone_type Option::Some return
        fi
    done
    Option[Type]::None
}

fn capability_matches_receiver capability:$ValueCapability expected:mut$Type -> bool {
    if capability ValueCapability::Shared is then expected.is_shared_borrow return fi
    if capability ValueCapability::Exclusive is then
        expected.is_shared_borrow expected.is_exclusive_borrow || return
    fi
    true
}

fn contains_op ops:mut$List[Op] candidate:mut$Op -> bool {
    for op in ops.iter do
        if candidate op.eq then true return fi
    done
    false
}

impl TypedValue {
    fn resolve_literals self:$TypedValue target:$Type diagnostics:mut$Diagnostics -> bool {
        true = valid
        0 (u64) = literal_index
        while literal_index self.literals.length > do
            if diagnostics target literal_index self.literals.get.resolve_literal ! then
                false = valid
            fi
            1 += literal_index
        done
        valid
    }
}

impl TypedStack {
    fn new -> TypedStack {
        List[TypedValue]::new TypedStack
    }

    fn snapshot self:$TypedStack -> TypedStack {
        self.values.shallow_copy = values
        0 (u64) = index
        while index values.length > do
            index values.get = value
            value.origins clone_origins = value.origins
            1 += index
        done
        values TypedStack
    }

    fn restore self:mut$TypedStack source:$TypedStack {
        source.snapshot.values = self.values
    }

    fn get_types self:$TypedStack -> List[Type] {
        List[Type]::new = types
        for value in self.values.iter do
            value.type_value clone_type types.push
        done
        types
    }

    fn set_types self:mut$TypedStack types:$List[Type] {
        0 (u64) = index
        while index self.values.length > do
            index self.values.get = value
            value.origins clone_origins value.source value.binding value.capability value.place
            value.literals value.origin
            index types.get clone_type TypedValue index self.values.set
            1 += index
        done
    }

    # Pure stack comparison on the types slice (origins are not compared).
    fn equals self:$TypedStack other:$TypedStack -> bool {
        self.get_types other.get_types stacks_equal
    }

    fn merge_literals self:mut$TypedStack candidate:$TypedStack {
        0 (u64) = index
        while index self.values.length > do
            index self.values.get = value
            index candidate.values.get = candidate_value
            0 (u64) = literal_index
            while literal_index candidate_value.literals.length > do
                literal_index candidate_value.literals.get = candidate_literal
                if candidate_literal value.literals contains_op ! then
                    candidate_literal value.literals.push
                fi
                1 += literal_index
            done
            1 += index
        done
    }

    # Produce unified types and retain literal origins from both stacks.
    fn unify_types self:mut$TypedStack candidate:$TypedStack store:mut$SymbolStore -> List[Type] {
        store self.get_types candidate.get_types stacks_compatible = unified
        if unified.length self.values.length == then candidate self.merge_literals fi
        unified
    }
}

# ============================================================================
# Branch contexts — one specialized struct per branch kind (if / while / match).
# ============================================================================

struct OwnershipFlow {
    moved: List[str]
    loans: Map[str List[str]]
}

impl OwnershipFlow {
    fn new -> OwnershipFlow {
        Map[str List[str]]::new List[str]::new OwnershipFlow
    }

    fn merge self:mut$OwnershipFlow other:$OwnershipFlow {
        for name in other.moved.iter do
            if name self.moved string_list_contains ! then name.clone self.moved.push fi
        done
        for pair in other.loans.iter do
            List[str]::new = origins
            if pair.first self.loans.get Option::Some(existing) is then
                existing.shallow_copy = origins
            fi
            for origin in pair.second.iter do
                if origin origins string_list_contains ! then origin.clone origins.push fi
            done
            origins pair.first.clone self.loans.set = self.loans
        done
    }
}

struct IfContext {
    before:                  TypedStack
    after:                   TypedStack
    flow_before:             OwnershipFlow
    flow_after:              OwnershipFlow
    entry_continues:         bool
    has_continuing_branch:   bool
    condition_present:       bool
    default_present:         bool
    current_branch_label:    str
    current_branch_location: Location
}

struct WhileContext {
    before:                  TypedStack
    flow_before:             OwnershipFlow
    flow_exit:               OwnershipFlow
    entry_continues:         bool
    has_exit:                bool
    condition_present:       bool
    current_branch_location: Location
    scope_depth:             u64
}

struct MatchContext {
    before:                  TypedStack
    after:                   TypedStack
    flow_before:             OwnershipFlow
    flow_after:              OwnershipFlow
    entry_continues:         bool
    has_continuing_arm:      bool
    condition_present:       bool
    branch_records:          List[str]
    match_type:              Type
    match_origins:           Option[List[str]]
    match_place:             Option[str]
    current_branch_label:    str
    current_branch_location: Location
}

enum BranchFrame {
    BranchIf (IfContext)
    BranchWhile (WhileContext)
    BranchMatch (MatchContext)
}

impl IfContext {
    fn new -> IfContext {
        empty_location
        ""
        false
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        TypedStack::new
        IfContext
    }
}

impl WhileContext {
    fn new scope_depth:u64 -> WhileContext {
        scope_depth
        empty_location
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        WhileContext
    }
}

impl MatchContext {
    fn new match_type:Type -> MatchContext {
        empty_location
        ""
        Option[str]::None
        Option[List[str]]::None
        match_type
        List[str]::new
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        TypedStack::new
        MatchContext
    }
}

# ============================================================================
# TypeChecker struct
# ============================================================================

struct TypeChecker {
    stack:                      TypedStack
    parameters:                 List[Parameter]
    return_types:               TypedStack
    has_return_types:           bool
    branched_stacks:            List[BranchFrame]
    current_location:           Location
    current_op_context:         str
    current_expect_ctx:         str
    in_branch_condition:        bool
    path_continues:             bool
    store:                      SymbolStore
    param_cap:                  Option[u64]
    underflow_reported_this_op: bool
    scope:                      BlockScope
    moved_owners:               List[str]
    owner_events:               List[OwnerEvent]
    next_owner_generation:      u64
    binding_origins:            Map[str List[str]]
    remaining_uses:             Map[str u64]
    unsafe_depth:               u64
    diagnostics:                Diagnostics
}

struct TypecheckResult {
    store:               SymbolStore
    global_stack_effect: StackEffect
    ops:                 List[Op]
    diagnostics:         Diagnostics
}

fn unsafe_operation_name operation:mut$OpValue -> str {
    # Callers already classify the operation as unsafe. Keep enforcement if a name is missing.
    operation match
        OpValue::HeapAlloc => "alloc"
        OpValue::HeapFree => "free"
        OpValue::Load8 => "load8"
        OpValue::Load16 => "load16"
        OpValue::Load32 => "load32"
        OpValue::Load64 => "load64"
        OpValue::Store8 => "store8"
        OpValue::Store16 => "store16"
        OpValue::Store32 => "store32"
        OpValue::Store64 => "store64"
        OpValue::Syscall0 => "syscall0"
        OpValue::Syscall1 => "syscall1"
        OpValue::Syscall2 => "syscall2"
        OpValue::Syscall3 => "syscall3"
        OpValue::Syscall4 => "syscall4"
        OpValue::Syscall5 => "syscall5"
        OpValue::Syscall6 => "syscall6"
        _ => "operation"
    end
}

impl TypeChecker {
    fn new store:mut$SymbolStore -> TypeChecker {
        Diagnostics::new # diagnostics
        0 # unsafe_depth
        Map[str u64]::new # remaining_uses
        Map[str List[str]]::new # binding_origins
        0 # next_owner_generation
        List[OwnerEvent]::new # owner_events
        List[str]::new # moved_owners
        BlockScope::new # scope
        false # underflow_reported_this_op
        Option[u64]::None # param_cap
        store # store
        true # path_continues
        false # in_branch_condition
        "" # current_expect_ctx
        "" # current_op_context
        empty_location # current_location
        List[BranchFrame]::new # branched_stacks
        false # has_return_types
        TypedStack::new # return_types
        List[Parameter]::new # parameters
        TypedStack::new # stack
        TypeChecker
    }
}

fn resolve_numeric_literal_default type_value:$Type -> Type {
    if type_value.is_integer_literal_t then TYPE_I64_T return fi
    if type_value.is_float_literal_t then TYPE_F64_T return fi
    type_value match
        Type::Generic(generic) => {
            List[Type]::new = parameters
            for parameter in generic.params.iter do
                parameter resolve_numeric_literal_default parameters.push
            done
            parameters generic.base.clone GenericType Type::Generic
        }
        Type::Function(function_type) => {
            List[Type]::new = parameters
            for parameter in function_type.parameters.iter do
                parameter resolve_numeric_literal_default parameters.push
            done
            List[Type]::new = return_types
            for return_type in function_type.return_types.iter do
                return_type resolve_numeric_literal_default return_types.push
            done
            return_types parameters FunctionType Type::Function
        }
        _ => type_value clone_type
    end
}

impl Op {
    fn has_numeric_literal self:$Op -> bool {
        self.value match
            OpValue::PushInt(_) => true
            OpValue::PushFloat(_) => true
            OpValue::PushArray(items) => {
                for item in items.iter do
                    if item.has_numeric_literal then true return fi
                done
                false
            }
            OpValue::ExprGroup(items) => {
                for item in items.iter do
                    if item.has_numeric_literal then true return fi
                done
                false
            }
            _ => false
        end
    }

    fn resolve_array_literals
        self:mut$Op
        items:$List[Op]
        target:$Type
        diagnostics:mut$Diagnostics
    -> bool {
        target.as_generic = generic_option
        if generic_option.is_none then false return fi
        generic_option.unwrap = generic
        if ARRAY_TYPE generic.base != 2 generic.params.length != || then false return fi
        if target array_type_length Option::Some(target_length) is then
            if items.length target_length != then
                self.location f"Array literal with {items.length} element(s) does not fit `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error
                false return
            fi
        fi
        true = valid
        0 generic.params.get = element_type
        0 (u64) = item_index
        while item_index items.length > do
            item_index items.get = item
            1 += item_index
            if item.has_numeric_literal diagnostics element_type item.resolve_literal ! && then
                false = valid
            fi
        done
        if valid then target clone_type Option::Some self Op::set_type_hint fi
        valid
    }

    fn resolve_literal self:mut$Op target:$Type diagnostics:mut$Diagnostics -> bool {
        self.value match
            OpValue::PushInt(literal) => {
                if target.is_integer_type_t ! then
                    self.location f"Integer literal `{literal.raw}` requires an integer context, got `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error
                    false return
                fi
                if target literal.fits ! then
                    target.get_integer_min = minimum
                    target.get_integer_max = maximum
                    self.location f"Integer literal `{literal.raw}` is outside `{target.format}` range {minimum}..{maximum}" ErrorKind::TypeMismatch diagnostics.record_error
                    false return
                fi
                target clone_type Option::Some self Op::set_type_hint
                true
            }
            OpValue::PushFloat(value) => {
                if target.is_float_type_t ! then
                    self.location f"Floating-point literal `{value}` requires `f32` or `f64` context, got `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error
                    false return
                fi
                if
                target TYPE_F32_T.eq value.to_f32.is_none &&
                target TYPE_F64_T.eq value.to_f64.is_none && ||
                then
                    self.location f"Floating-point literal `{value}` is outside `{target.format}` finite range" ErrorKind::TypeMismatch diagnostics.record_error
                    false return
                fi
                target clone_type Option::Some self Op::set_type_hint
                true
            }
            OpValue::PushArray(items) => diagnostics target items self.resolve_array_literals
            _ => false
        end
    }
}

fn resolve_default_literals ops:mut$List[Op] diagnostics:mut$Diagnostics {
    0 (u64) = default_op_index
    while default_op_index ops.length > do
        default_op_index ops.get = op
        1 += default_op_index
        if op.type_hint.is_none then
            if op.value OpValue::PushInt is then
                diagnostics TYPE_I64_T op.resolve_literal drop
            elif op.value OpValue::PushFloat is then
                diagnostics TYPE_F64_T op.resolve_literal drop
            fi
        fi
        if op.value OpValue::PushArray(items) is then
            diagnostics items resolve_default_literals
        elif op.value OpValue::ExprGroup(items) is then
            diagnostics items resolve_default_literals
        elif op.value OpValue::MatchArm(arm) is then
            diagnostics arm.guard_ops resolve_default_literals
        fi
    done
}

impl TypeChecker {
    fn within_param_cap tc:mut$TypeChecker -> bool {
        if tc.param_cap Option::Some(cap) is then
            cap tc.parameters.length < return
        fi
        true
    }
}
# Raise a TypeMismatch error at the type checker's current location.

impl TypeChecker {
    fn raise_type_mismatch tc:mut$TypeChecker message:str {
        tc.current_location message ErrorKind::TypeMismatch tc.diagnostics.record_error
    }
}

# ============================================================================
# Stack operations
# ============================================================================

impl TypeChecker {
    fn current_ownership_flow tc:mut$TypeChecker -> OwnershipFlow {
        List[str]::new = moved
        for name in tc.moved_owners.iter do
            if name tc.scope.lookup.is_some then name.clone moved.push fi
        done
        Map[str List[str]]::new = loans
        for pair in tc.binding_origins.iter do
            if pair.first tc.scope.lookup.is_some then
                pair.second.shallow_copy pair.first.clone loans.set = loans
            fi
        done
        loans moved OwnershipFlow
    }

    fn restore_ownership_flow tc:mut$TypeChecker flow:$OwnershipFlow {
        flow.moved.shallow_copy = tc.moved_owners
        Map[str List[str]]::new = loans
        for pair in flow.loans.iter do
            pair.second.shallow_copy pair.first.clone loans.set = loans
        done
        loans = tc.binding_origins
    }

    fn remove_flow_names tc:mut$TypeChecker names:$List[str] {
        for name in names.iter do
            false name tc.set_owner_moved
            if name tc.binding_origins.has then
                name tc.binding_origins.delete = tc.binding_origins
            fi
        done
    }

    fn merge_current_ownership_flow tc:mut$TypeChecker flow:OwnershipFlow -> OwnershipFlow {
        if tc.path_continues then
            tc.current_ownership_flow = current
            current flow.merge
        fi
        flow
    }

    fn report_loop_flow_difference
        tc:mut$TypeChecker
        expected:$OwnershipFlow
        local_names:$List[str]
        op:mut$Op
    {
        tc.current_ownership_flow = current
        for name in current.moved.iter do
            if
            name local_names string_list_contains !
            name expected.moved string_list_contains ! &&
            then
                op.location f"Loop back-edge does not restore ownership of `{name}`"
                ErrorKind::InvalidVariable tc.diagnostics.record_error
            fi
        done
        for name in expected.moved.iter do
            if
            name local_names string_list_contains !
            name current.moved string_list_contains ! &&
            then
                op.location f"Loop back-edge changes ownership of `{name}`"
                ErrorKind::InvalidVariable tc.diagnostics.record_error
            fi
        done
        for pair in current.loans.iter do
            if pair.first local_names string_list_contains then continue fi
            if pair.first tc.scope.lookup Option::Some(typ) is then
                if tc.store typ type_has_borrow ! then continue fi
            fi
            false = same
            if pair.first expected.loans.get Option::Some(origins) is then
                pair.second.length origins.length == = same
                if same then
                    for origin in pair.second.iter do
                        if origin origins string_list_contains ! then false = same fi
                    done
                fi
            fi
            if same ! then
                op.location f"Loop back-edge changes loans for `{pair.first}`"
                ErrorKind::InvalidVariable tc.diagnostics.record_error
            fi
        done
        for pair in expected.loans.iter do
            if pair.first tc.scope.lookup Option::Some(typ) is then
                if tc.store typ type_has_borrow ! then continue fi
            fi
            if
            pair.first local_names string_list_contains !
            pair.first current.loans.has ! &&
            then
                op.location f"Loop back-edge does not restore loans for `{pair.first}`"
                ErrorKind::InvalidVariable tc.diagnostics.record_error
            fi
        done
    }

    fn owner_is_moved tc:mut$TypeChecker name:$str -> bool {
        name tc.moved_owners string_list_contains
    }

    fn set_owner_moved tc:mut$TypeChecker name:$str moved:bool {
        name tc.moved_owners string_list_index = index
        if moved then
            if 0 index < then name.clone tc.moved_owners.push fi
            return
        fi
        if 0 index >= then
            tc.moved_owners.pop = last
            if tc.moved_owners.length index (u64) < then
                last index (u64) tc.moved_owners.set
            fi
        fi
    }

    fn use_binding tc:mut$TypeChecker name:mut$str {
        if name tc.remaining_uses.get Option::Some(count) is then
            if 0 count != then count 1 - name.clone tc.remaining_uses.set = tc.remaining_uses fi
        fi
    }

    fn binding_is_live tc:mut$TypeChecker name:mut$str -> bool {
        if name tc.remaining_uses.get Option::Some(count) is then 0 count != return fi
        false
    }

    fn record_binding_origins tc:mut$TypeChecker name:mut$str origins:mut$Option[List[str]] {
        if origins Option::Some(items) is then
            items.clone name.clone tc.binding_origins.set = tc.binding_origins
        elif name tc.binding_origins.has then
            name tc.binding_origins.delete = tc.binding_origins
        fi
    }

    fn record_pattern_origins tc:mut$TypeChecker names:mut$List[str] origins:mut$Option[List[str]] {
        for name in names.iter do
            if name tc.scope.lookup Option::Some(typ) is then
                if
                tc.store typ type_has_borrow
                Option[Function]::None typ tc.type_is_duplicable ! ||
                then
                    origins name tc.record_binding_origins
                fi
            fi
        done
    }

    fn place_has_conflicting_loan
        self:mut$TypeChecker
        place:mut$str
        stack_depth:u64
        exclusive:bool
    -> bool {
        0 (u64) = index
        while index stack_depth > do
            index self.stack.values.get = value
            if value.binding Option::Some(binding_name) is then
                if place binding_name == then 1 += index continue fi
            fi
            if value.place Option::Some(value_place) is then
                if place value_place == value.type_value.is_borrow exclusive ! || && then
                    1 += index
                    continue
                fi
            fi
            if value.capability ValueCapability::Owned is ! then
                if value.place Option::Some(value_place) is then
                    if
                    place value_place origin_matches_place
                    value.capability ValueCapability::Exclusive is exclusive || &&
                    then
                        true return
                    fi
                fi
            fi
            if value.origins Option::Some(origins) is then
                for origin in origins.iter do
                    if
                    place origin origin_matches_place
                    origin origin_is_exclusive exclusive || &&
                    then
                        true return
                    fi
                done
            fi
            1 += index
        done
        for binding_name in self.binding_origins.keys.iter do
            if
            place binding_name origin_matches_place
            binding_name self.binding_is_live ! ||
            binding_name self.scope.lookup.is_none ||
            then continue fi
            if binding_name self.binding_origins.get Option::Some(origins) is then
                for origin in origins.iter do
                    if
                    place origin origin_matches_place
                    origin origin_is_exclusive exclusive || &&
                    then
                        true return
                    fi
                done
            fi
        done
        for frame in self.branched_stacks.iter do
            if frame BranchFrame::BranchWhile(while_ctx) is then
                for pair in while_ctx.flow_before.loans.iter do
                    if
                    place pair.first origin_matches_place
                    pair.first self.scope.lookup.is_none ||
                    then continue fi
                    for origin in pair.second.iter do
                        if
                        place origin origin_matches_place
                        origin origin_is_exclusive exclusive || &&
                        then
                            true return
                        fi
                    done
                done
            fi
        done
        false
    }

    fn has_active_owner_loan self:mut$TypeChecker owner:mut$str stack_depth:u64 -> bool {
        true stack_depth owner self.place_has_conflicting_loan
    }

    fn type_is_duplicable
        tc:mut$TypeChecker
        typ:mut$Type
        function_opt:mut$Option[Function]
    -> bool {
        if typ.is_shared_borrow then true return fi
        if typ.is_exclusive_borrow then false return fi
        if typ Type::Builtin(builtin) is then builtin BuiltinType::Str != return fi
        if typ Type::Function(_) is then true return fi
        if typ.has_unresolved_type_var then
            "Copy" GenericType::new Type::Generic = unresolved_copy_type
            if tc.store function_opt unresolved_copy_type typ matches_trait_bound then true return fi
            tc.store unresolved_copy_type typ type_has_satisfying_trait_impl return
        fi
        typ.format = type_name
        if type_name tc.store.copy_types.get Option::Some(cached) is then cached return fi
        "Copy" GenericType::new Type::Generic = copy_type
        tc.store function_opt copy_type typ matches_trait_bound = is_copy
        if is_copy ! then tc.store copy_type typ type_has_satisfying_trait_impl = is_copy fi
        is_copy type_name tc.store.copy_types.set drop
        is_copy
    }

    fn record_owner_assignment
        tc:mut$TypeChecker
        op:mut$Op
        name:mut$str
        typ:mut$Type
        function_opt:mut$Option[Function]
        is_global:bool
    {
        if is_global function_opt.is_some && then return fi
        if typ.is_borrow function_opt typ tc.type_is_duplicable || then return fi
        if tc.store typ type_needs_destruction_in_store ! then return fi
        1 += tc.next_owner_generation
        tc.next_owner_generation typ name OwnerEvent::new = event
        event.clone op tc.store add_owner_assignment
        event tc.owner_events.push
    }

    fn owner_cleanups_for_names tc:mut$TypeChecker names:mut$List[str] -> List[OwnerEvent] {
        List[OwnerEvent]::new = cleanups
        tc.owner_events.length = event_index
        while 0 event_index != do
            1 -= event_index
            event_index tc.owner_events.get = event
            if event.name names string_list_contains then event.clone cleanups.push fi
        done
        cleanups
    }

    fn remove_owner_events_for_names tc:mut$TypeChecker names:mut$List[str] {
        List[OwnerEvent]::new = remaining
        0 (u64) = event_index
        while event_index tc.owner_events.length > do
            if event_index tc.owner_events.get_ref.name names string_list_contains ! then
                event_index tc.owner_events.get remaining.push
            fi
            1 += event_index
        done
        remaining = tc.owner_events
    }

    fn attach_owner_cleanups tc:mut$TypeChecker op:mut$Op names:mut$List[str] remove:bool {
        names tc.owner_cleanups_for_names = cleanups
        0 (u64) = cleanup_index
        while cleanup_index cleanups.length > do
            cleanup_index cleanups.get op tc.store add_owner_cleanup
            1 += cleanup_index
        done
        if remove then names tc.remove_owner_events_for_names fi
    }

    fn attach_scope_cleanups tc:mut$TypeChecker op:mut$Op {
        tc.scope.current_names = names
        true names op tc.attach_owner_cleanups
    }

    fn attach_all_owner_cleanups tc:mut$TypeChecker op:mut$Op {
        tc.owner_events.length = event_index
        while 0 event_index != do
            1 -= event_index
            event_index tc.owner_events.get.clone op tc.store add_owner_cleanup
        done
    }

    fn stack_push_type tc:mut$TypeChecker type_value:mut$Type {
        Option[List[str]]::None Option[Op]::None Option[str]::None type_value type_capability Option[str]::None
        List[Op]::new tc.current_location type_value TypedValue
        tc.stack.values.push
    }

    fn stack_push_binding
        tc:mut$TypeChecker
        type_value:mut$Type
        name:mut$str
        op:mut$Op
        function_opt:mut$Option[Function]
    {
        Option[str]::None = binding
        Option[Op]::None = source
        type_value clone_type = stack_type
        type_value type_capability = capability
        if type_value.borrow_target Option::Some(target) is then
            if function_opt target tc.type_is_duplicable then target = stack_type fi
        fi
        if
        function_opt.is_some
        type_value.is_borrow ! &&
        function_opt type_value tc.type_is_duplicable ! &&
        then
            if name tc.owner_is_moved then
                op.location f"Owner `{name}` was already moved" ErrorKind::InvalidVariable
                tc.diagnostics.record_error
            fi
            name.clone Option::Some = binding
            unsafe { op (ptr) (Op) Option::Some = source }
        fi
        name.clone Option::Some = place
        Option[List[str]]::None = origins
        if name tc.binding_origins.get Option::Some(stored) is then
            stored.clone Option::Some = origins
        fi
        origins source binding type_value type_capability place
        List[Op]::new tc.current_location stack_type
        TypedValue
        tc.stack.values.push
    }

    fn stack_push_literal tc:mut$TypeChecker type_value:mut$Type op:mut$Op {
        List[Op]::new = literals
        unsafe { op (ptr) (Op) literals.push }
        Option[List[str]]::None Option[Op]::None Option[str]::None
        ValueCapability::Owned Option[str]::None literals
        tc.current_location type_value TypedValue
        tc.stack.values.push
    }
}

fn borrow_argument_matches expected:mut$Type actual:mut$Type store:mut$SymbolStore -> bool {
    expected.borrow_target = expected_target_opt
    if expected_target_opt.is_none then false return fi
    if expected.is_exclusive_borrow actual.is_shared_borrow && then false return fi
    actual clone_type = actual_target
    if actual.borrow_target Option::Some(borrowed_target) is then borrowed_target = actual_target fi
    store actual_target expected_target_opt.unwrap unify_type_t.is_some
}

fn borrowed_copy_argument_matches tc:mut$TypeChecker expected:mut$Type actual:mut$Type -> bool {
    if actual.borrow_target Option::Some(target) is then
        if tc.store target expected unify_type_t.is_none then false return fi
        Option[Function]::None target tc.type_is_duplicable return
    fi
    false
}

impl TypeChecker {
    fn consume_value tc:mut$TypeChecker value:mut$TypedValue {
        if value.binding Option::Some(name) is then
            if name tc.owner_is_moved then
                tc.current_location f"Owner `{name}` was already moved"
                ErrorKind::InvalidVariable tc.diagnostics.record_error
                return
            fi
            if tc.stack.values.length name tc.has_active_owner_loan then
                tc.current_location f"Cannot move owner `{name}` while it is borrowed"
                ErrorKind::InvalidVariable tc.diagnostics.record_error
                return
            fi
            true name tc.set_owner_moved
            if value.source Option::Some(source_op) is then
                source_op tc.store set_moves_owner
            fi
        fi
    }

    fn release_value tc:mut$TypeChecker value:mut$TypedValue {
        if value.binding Option::Some(name) is then
            if name tc.owner_is_moved then
                tc.current_location f"Owner `{name}` was already moved"
                ErrorKind::InvalidVariable tc.diagnostics.record_error
            fi
        fi
    }
}

impl TypeChecker {
    fn report_stack_underflow tc:mut$TypeChecker message:str {
        if tc.underflow_reported_this_op then return fi
        tc.current_location message ErrorKind::StackUnderflow tc.diagnostics.record_error
        true = tc.underflow_reported_this_op
    }
}

impl TypeChecker {
    fn stack_underflow_message tc:mut$TypeChecker -> str {
        tc.current_expect_ctx = expect_what
        if "" expect_what == then
            "Stack underflow: expected a value but stack is empty" return
        fi
        f"Stack underflow: expected {expect_what} but stack is empty"
    }
}

impl TypeChecker {
    fn stack_peek_type tc:mut$TypeChecker -> Type {
        if 0 tc.stack.values.length == then
            if tc.within_param_cap then
                TYPE_UNKNOWN_T return
            fi
            tc.stack_underflow_message tc.report_stack_underflow
            TYPE_MISSING_T return
        fi
        tc.stack.values.length 1 - = top
        top tc.stack.values.get = value
        if 0 value.literals.length != then
            value.type_value resolve_numeric_literal_default = resolved
            tc.diagnostics resolved value.resolve_literals drop
            value.origins clone_origins value.source value.binding value.capability value.place
            List[Op]::new value.origin
            resolved clone_type TypedValue top tc.stack.values.set
            resolved return
        fi
        value.type_value
    }
}

impl TypeChecker {
    fn stack_pop_value tc:mut$TypeChecker -> TypedValue {
        if 0 tc.stack.values.length == then
            if tc.within_param_cap then
                TYPE_UNKNOWN_T Parameter::new tc.parameters.push
                Option[List[str]]::None Option[Op]::None Option[str]::None ValueCapability::Owned Option[str]::None
                List[Op]::new empty_location TYPE_UNKNOWN_T TypedValue return
            fi
            tc.stack_underflow_message tc.report_stack_underflow
            Option[List[str]]::None Option[Op]::None Option[str]::None ValueCapability::Owned Option[str]::None
            List[Op]::new empty_location TYPE_MISSING_T TypedValue return
        fi
        tc.stack.values.pop
    }

    fn stack_pop_type tc:mut$TypeChecker -> Type {
        tc.stack_pop_value = value
        if 0 value.literals.length != then
            value.type_value resolve_numeric_literal_default = resolved
            tc.diagnostics resolved value.resolve_literals drop
            resolved return
        fi
        value.type_value
    }
}

impl TypeChecker {
    fn stack_pop_drop tc:mut$TypeChecker {
        if 0 tc.stack.values.length == then
            if tc.within_param_cap then
                TYPE_UNKNOWN_T Parameter::new tc.parameters.push
                return
            fi
            tc.stack_underflow_message tc.report_stack_underflow
            return
        fi
        tc.stack_pop_value = value
        value tc.consume_value
    }
}
# Infer a lambda's missing left operand from the concrete right operand.

impl TypeChecker {
    fn stack_pop_left_like tc:mut$TypeChecker right:mut$TypedValue -> TypedValue {
        if 0 tc.stack.values.length == tc.within_param_cap && then
            right.type_value resolve_numeric_literal_default = inferred
            if inferred.is_unknown_placeholder ! inferred TYPE_MISSING_T.eq ! && then
                tc.diagnostics inferred right.resolve_literals drop
                inferred Parameter::new tc.parameters.push
                Option[List[str]]::None Option[Op]::None Option[str]::None ValueCapability::Owned Option[str]::None
                List[Op]::new empty_location inferred TypedValue return
            fi
        fi
        tc.stack_pop_value
    }
}

impl TypeChecker {
    fn expect_type_t tc:mut$TypeChecker expected:mut$Type {
        if 0 tc.stack.values.length == then
            if tc.within_param_cap then
                expected Parameter::new tc.parameters.push
                return
            fi
            f"Stack underflow: expected `{expected.format}` but stack is empty" tc.report_stack_underflow
            return
        fi
        tc.stack_pop_value = et_value
        et_value.type_value = et_actual_t
        if expected.is_borrow then et_value tc.release_value else et_value tc.consume_value fi
        if 0 et_value.literals.length != then
            if expected.is_unknown_placeholder expected.has_unresolved_type_var || then
                et_actual_t resolve_numeric_literal_default = literal_default
                tc.diagnostics literal_default et_value.resolve_literals drop
                return
            fi
            if tc.diagnostics expected et_value.resolve_literals then return fi
        fi
        if tc.store et_actual_t expected borrow_argument_matches then return fi
        if et_actual_t expected tc borrowed_copy_argument_matches then return fi
        if tc.store et_actual_t expected unify_type_t.is_some then return fi
        et_actual_t.format = et_actual
        expected.format = et_expected
        "Type mismatch" = et_message
        if "" tc.current_op_context != then
            f"Type mismatch in {tc.current_op_context}" = et_message
        fi
        et_actual et_expected tc.current_location et_message ErrorKind::TypeMismatch tc.diagnostics.record_error_expected
    }
}

# ============================================================================
# Type compatibility
# ============================================================================

fn type_exists_recursive_t
    typ:mut$Type
    function_opt:mut$Option[Function]
    store:mut$SymbolStore
-> bool {
    typ match
        Type::Unknown => { false }
        Type::Builtin(_) => { true }
        Type::TypeVar(name) => {
            if function_opt Option::Some(check_fn) is then
                name check_fn Function::stack_effect StackEffect::type_vars.has return
            fi
            false
        }
        Type::Const(const_type) => {
            if const_type.is_symbolic ! then true return fi
            if function_opt Option::Some(check_fn) is then
                const_type.name check_fn Function::stack_effect StackEffect::const_params.has return
            fi
            false
        }
        Type::Generic(generic) => {
            for param in generic.params.iter do
                if store function_opt param type_exists_recursive_t ! then false return fi
            done
            if SHARED_BORROW_TYPE generic.base == then true return fi
            if EXCLUSIVE_BORROW_TYPE generic.base == then true return fi
            if generic.base store.structs.get.is_some then true return fi
            if generic.base store.enums.get.is_some then true return fi
            if "array" generic.base == then true return fi
            if function_opt Option::Some(check_fn) is then
                if generic.base check_fn Function::stack_effect StackEffect::type_vars.has then true return fi
            fi
            false
        }
        Type::Function(fn_type) => {
            for param in fn_type.parameters.iter do
                if store function_opt param type_exists_recursive_t ! then false return fi
            done
            for ret in fn_type.return_types.iter do
                if store function_opt ret type_exists_recursive_t ! then false return fi
            done
            true
        }
    end
}

impl TypeChecker {
    fn validate_type_exists
        self:mut$TypeChecker
        typ:mut$Type
        function_opt:mut$Option[Function]
        location:mut$Location
    {
        if self.store function_opt typ type_exists_recursive_t then return fi
        location f"type `{typ.format}` does not exist" ErrorKind::Syntax self.diagnostics.record_error
    }
}

# ============================================================================
# Unify types — returns the more specific type, or "" on incompatibility
# ============================================================================
# ============================================================================
# Stack compatibility — unify element-wise, returns empty list on mismatch
# ============================================================================

fn stacks_compatible stack_a:$List[Type] stack_b:$List[Type] store:mut$SymbolStore -> List[Type] {
    if stack_a.length stack_b.length != then
        List[Type]::new return
    fi
    List[Type]::new = result
    0 (u64) = index
    while index stack_a.length > do
        if index stack_b.get index stack_a.get.eq then
            index stack_a.get clone_type result.push
        else
            store index stack_b.get index stack_a.get unify_type_t = unified
            if unified.is_none then
                List[Type]::new return
            fi
            if unified Option::Some(unified_type) is then
                unified_type result.push
            else
                List[Type]::new return
            fi
        fi
        1 += index
    done
    result
}

fn stacks_equal stack_a:$List[Type] stack_b:$List[Type] -> bool {
    if stack_a.length stack_b.length != then false return fi
    for pair in stack_b.iter stack_a.iter.zip do
        if pair.second pair.first.eq ! then false return fi
    done
    true
}

# ============================================================================
# Apply stack effect: pop params, push returns, with type variable binding.
# ============================================================================

fn resolve_return_type_t bindings:$Map[str Type] ret:$Type -> Type {
    ret match
        Type::TypeVar(name) => {
            if name bindings.get Option::Some(bound) is then
                bound clone_type
            else
                name.clone Type::TypeVar
            fi
        }
        Type::Const(const_type) => {
            if const_type.is_symbolic then
                if const_type.name bindings.get Option::Some(bound) is then
                    bound clone_type
                else
                    ret clone_type
                fi
            else
                ret clone_type
            fi
        }
        Type::Generic(generic) => {
            if 0 generic.params.length == then
                if generic.base bindings.get Option::Some(bound) is then
                    bound clone_type return
                fi
                generic.params.shallow_copy generic.base.clone GenericType Type::Generic return
            fi
            List[Type]::new = new_params
            for param in generic.params.iter do
                param bindings resolve_return_type_t new_params.push
            done
            new_params generic.base.clone GenericType Type::Generic
        }
        Type::Function(fn_type) => {
            List[Type]::new = new_params
            for param in fn_type.parameters.iter do
                param bindings resolve_return_type_t new_params.push
            done
            List[Type]::new = new_returns
            for ret_inner in fn_type.return_types.iter do
                ret_inner bindings resolve_return_type_t new_returns.push
            done
            new_returns new_params FunctionType Type::Function
        }
        Type::Unknown => { Type::Unknown }
        Type::Builtin(builtin) => { builtin (i64) (BuiltinType) Type::Builtin }
    end
}

impl TypeChecker {
    fn bind_type_var
        tc:mut$TypeChecker
        bindings:Map[str Type]
        type_var:$str
        actual:$Type
    -> Map[str Type] {
        type_var bindings.get = existing
        if existing.is_none then
            actual clone_type type_var.clone bindings.set return
        fi
        existing.unwrap = bound
        if bound.has_unresolved_type_var actual.has_unresolved_type_var ! && then
            actual clone_type type_var.clone bindings.set return
        fi
        actual.is_unknown_placeholder = actual_unknown
        bound.is_unknown_placeholder = bound_unknown
        if
        bound_unknown
        bound.has_unresolved_type_var ||
        actual_unknown ! &&
        then
            actual clone_type type_var.clone bindings.set return
        fi
        if
        bound actual.eq !
        actual_unknown ! &&
        bound_unknown ! &&
        actual.has_unresolved_type_var ! &&
        then
            f"Type variable `{type_var}` bound to `{bound.format}` but got `{actual.format}`" tc.raise_type_mismatch
        fi
        bindings
    }
}

impl TypeChecker {
    fn resolve_type_var_literals
        tc:mut$TypeChecker
        value:mut$TypedValue
        fallback:Type
        bound:mut$Option[Type]
    -> Type {
        fallback = target
        if bound Option::Some(candidate) is then
            if candidate.is_integer_type_t candidate.is_float_type_t || then
                candidate clone_type = target
            fi
        fi
        tc.diagnostics target value.resolve_literals drop
        target
    }
}

impl TypeChecker {
    fn record_literal_binding
        tc:mut$TypeChecker
        type_variable:mut$str
        literals:mut$List[Op]
        literal_bindings:mut$Map[str List[Op]]
    {
        if type_variable literal_bindings.get Option::Some(bound_literals) is then
            literals.shallow_copy bound_literals.append
        else
            literals.shallow_copy type_variable.clone literal_bindings.set drop
        fi
    }

    fn bind_direct_type_variable_parameter
        tc:mut$TypeChecker
        parameter:$Parameter
        effect:mut$StackEffect
        bindings:mut$Map[str Type]
        literal_bindings:mut$Map[str List[Op]]
    -> bool {
        parameter.typ.type_var_name = type_variable_option
        if type_variable_option.is_none then
            false return
        fi
        type_variable_option.unwrap = type_variable
        if type_variable effect.type_vars.has ! then
            false return
        fi
        tc.stack_pop_value = value
        if parameter.typ.is_borrow then value tc.release_value else value tc.consume_value fi
        value.type_value = actual
        if 0 value.literals.length != then
            type_variable bindings.get = bound
            false = resolved
            if bound Option::Some(bound_type) is then
                if bound_type.is_integer_type_t bound_type.is_float_type_t || then
                    bound actual value tc.resolve_type_var_literals = actual
                    true = resolved
                fi
            fi
            if resolved ! then literal_bindings value.literals type_variable tc.record_literal_binding fi
        fi
        unsafe { actual type_variable bindings (ptr) (Map[str Type]) tc.bind_type_var drop }
        true
    }

    fn push_resolved_return
        tc:mut$TypeChecker
        return_type:mut$Type
        bindings:mut$Map[str Type]
        literal_bindings:mut$Map[str List[Op]]
    {
        return_type bindings resolve_return_type_t = resolved
        if return_type.type_var_name Option::Some(type_variable) is then
            if type_variable literal_bindings.get Option::Some(literals) is then
                Option[List[str]]::None Option[Op]::None Option[str]::None resolved type_capability Option[str]::None
                literals tc.current_location resolved TypedValue
                tc.stack.values.push
                return
            fi
        fi
        resolved tc.stack_push_type
    }
}

impl TypeChecker {
    fn bind_generic_param
        tc:mut$TypeChecker
        bindings:mut$Map[str Type]
        expected:mut$Parameter
        effect:mut$StackEffect
    -> bool {
        # Bind type vars from a parameterized param like Map[K V].
        expected Parameter::typ.base = base_opt
        if base_opt.is_none then false return fi
        expected Parameter::typ.type_params = expected_params_opt
        if expected_params_opt.is_none then false return fi
        expected_params_opt.unwrap = expected_params
        # Check if any param is a type variable
        false = has_type_var
        for expected_param in expected_params.iter do
            if expected_param.type_var_name Option::Some(probe_name) is then
                if probe_name effect StackEffect::type_vars.has then
                    true = has_type_var
                fi
            fi
        done
        if has_type_var ! then false return fi

        base_opt.unwrap = base
        tc.stack_pop_value = value
        if expected.typ.is_borrow then value tc.release_value else value tc.consume_value fi
        value.type_value = actual
        bindings expected.typ.substitute_t = resolved_expected
        if 0 value.literals.length != then
            if resolved_expected.has_unresolved_type_var then
                actual resolve_numeric_literal_default = actual
            else
                resolved_expected = actual
            fi
            tc.diagnostics actual value.resolve_literals drop
        fi
        actual match
            Type::Generic(actual_g) => {
                if 0 actual_g.params.length == then
                    expected_params bindings effect tc.bind_unknowns
                    true return
                fi
                if base actual_g.base != then
                    "Type mismatch" tc.raise_type_mismatch
                    true return
                fi
                if actual_g.params.length expected_params.length != then
                    "Type mismatch" tc.raise_type_mismatch
                    true return
                fi
                0 (u64) = bind_index
                while bind_index expected_params.length > do
                    if bind_index expected_params.get.type_var_name Option::Some(bind_name) is then
                        if bind_name effect StackEffect::type_vars.has then
                            unsafe { bind_index actual_g.params.get bind_name bindings (ptr) (Map[str Type]) tc.bind_type_var drop }
                        fi
                    fi
                    bind_index actual_g.params.get bind_index expected_params.get tc.validate_const_arguments_t
                    1 += bind_index
                done
                true return
            }
            Type::Unknown => {
                expected_params bindings effect tc.bind_unknowns
                true return
            }
            _ => {
                "Type mismatch" tc.raise_type_mismatch
            }
        end
        true
    }

    # Validate the argument for a symbolic `const` parameter (ADR-0152): it must
    # be a compile-time constant that fits the parameter's type, else a
    # diagnostic that names the argument.
    fn validate_const_argument tc:mut$TypeChecker expected_const:$ConstType actual:$Type {
        if expected_const.is_symbolic ! then return fi
        if actual.is_unknown then return fi
        if actual Type::Const(actual_const) is then
            if actual_const.is_symbolic then return fi
            if expected_const.typ actual_const.fits_parameter ! then
                tc.current_location f"Constant argument `{actual_const.value}` does not fit type `{expected_const.typ.format}` of constant parameter `{expected_const.name}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
            fi
            return
        fi
        tc.current_location f"Constant parameter `{expected_const.name}` requires a compile-time constant, got `{actual.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
    }

    # Walk an expected type and its actual argument in parallel, validating every
    # symbolic `const` parameter position against the supplied argument (ADR-0152).
    fn validate_const_arguments_t tc:mut$TypeChecker expected:$Type actual:$Type {
        expected match
            Type::Const(expected_const) => {
                actual expected_const tc.validate_const_argument
            }
            Type::Generic(expected_generic) => {
                if actual Type::Generic(actual_generic) is then
                    if
                    expected_generic.base actual_generic.base ==
                    expected_generic.params.length actual_generic.params.length == &&
                    then
                        for pair in actual_generic.params.iter expected_generic.params.iter.zip do
                            pair.second pair.first tc.validate_const_arguments_t
                        done
                    fi
                fi
            }
            Type::Function(expected_function) => {
                if actual Type::Function(actual_function) is then
                    for pair in actual_function.parameters.iter expected_function.parameters.iter.zip do
                        pair.second pair.first tc.validate_const_arguments_t
                    done
                    for pair in actual_function.return_types.iter expected_function.return_types.iter.zip do
                        pair.second pair.first tc.validate_const_arguments_t
                    done
                fi
            }
            _ => { }
        end
    }
}

impl TypeChecker {
    fn bind_unknowns
        tc:mut$TypeChecker
        effect:mut$StackEffect
        bindings:mut$Map[str Type]
        expected_params:mut$List[Type]
    {
        for expected_param in expected_params.iter do
            if expected_param.type_var_name Option::Some(unk_name) is then
                if unk_name effect StackEffect::type_vars.has then
                    unsafe { TYPE_UNKNOWN_T unk_name bindings (ptr) (Map[str Type]) tc.bind_type_var drop }
                fi
            fi
        done
    }
}

impl TypeChecker {
    fn bind_fn_param
        tc:mut$TypeChecker
        bindings:mut$Map[str Type]
        expected:mut$Parameter
        effect:mut$StackEffect
    -> bool {
        # Bind type vars from a function-type param like fn[T -> T].
        if expected Parameter::typ.is_fn_type_t ! then false return fi
        # Check if any type var appears in the function type.
        false = has_type_var
        effect StackEffect::type_vars.to_list = type_var_list
        for type_var in type_var_list.iter do
            if type_var expected Parameter::typ.type_contains_var then
                true = has_type_var
            fi
        done
        if has_type_var ! then false return fi

        tc.stack_pop_value = function_value
        if expected.typ.is_borrow then
            function_value tc.release_value
        else
            function_value tc.consume_value
        fi
        function_value.type_value = actual
        if actual.is_unknown_placeholder then
            for type_var2 in type_var_list.iter do
                if type_var2 expected Parameter::typ.type_contains_var then
                    unsafe { TYPE_UNKNOWN_T type_var2 bindings (ptr) (Map[str Type]) tc.bind_type_var drop }
                fi
            done
            true return
        fi
        if actual.is_fn_type_t ! then
            "Type mismatch" tc.raise_type_mismatch
            true return
        fi
        expected Parameter::typ match
            Type::Function(expected_fn) => {
                actual match
                    Type::Function(actual_fn) => {
                        expected_fn.parameters = expected_fn_params
                        actual_fn.parameters = actual_fn_params
                        0 (u64) = param_index
                        while
                        param_index expected_fn_params.length >
                        param_index actual_fn_params.length > &&
                        do
                            param_index expected_fn_params.get = expected_param
                            param_index actual_fn_params.get = actual_param
                            unsafe { bindings (ptr) (Map[str Type]) actual_param expected_param bind_semantic_type_arguments drop }
                            1 += param_index
                        done
                        expected_fn.return_types = expected_fn_returns
                        actual_fn.return_types = actual_fn_returns
                        0 (u64) = return_index
                        while
                        return_index expected_fn_returns.length >
                        return_index actual_fn_returns.length > &&
                        do
                            return_index expected_fn_returns.get = expected_return
                            return_index actual_fn_returns.get = actual_return
                            unsafe { bindings (ptr) (Map[str Type]) actual_return expected_return bind_semantic_type_arguments drop }
                            1 += return_index
                        done
                    }
                    _ => { }
                end
            }
            _ => { }
        end
        true
    }
}

impl TypeChecker {
    fn stack_push_origins tc:mut$TypeChecker typ:mut$Type origins:Option[List[str]] {
        typ tc.stack_push_type
        tc.stack.values.length 1 - tc.stack.values.get = value
        origins = value.origins
    }

    fn call_origins tc:mut$TypeChecker effect:mut$StackEffect exclusive:bool -> Option[List[str]] {
        Option[List[str]]::None = origins
        tc.stack.values.length = depth
        0 (u64) = index
        while index effect.parameters.length > index depth > && do
            index effect.parameters.get.typ = parameter_type
            depth 1 - index - tc.stack.values.get = argument
            if argument.origins Option::Some(argument_origins) is then
                for origin in argument_origins.iter do
                    if
                    exclusive !
                    origin origin_is_exclusive ||
                    parameter_type.is_exclusive_borrow argument.capability ValueCapability::Exclusive is && ||
                    then
                        origin origin_place = place
                        exclusive place origins add_origin = origins
                    fi
                done
            fi
            if parameter_type.is_borrow then
                if argument.place Option::Some(place) is then
                    if exclusive ! parameter_type.is_exclusive_borrow || then
                        exclusive place origins add_origin = origins
                    fi
                fi
            fi
            1 += index
        done
        origins
    }

    fn check_call_borrow_pair
        tc:mut$TypeChecker
        first_type:$Type
        first_value:$TypedValue
        second_type:$Type
        second_value:$TypedValue
    {
        if second_type.is_borrow ! then return fi
        if first_type.is_exclusive_borrow second_type.is_exclusive_borrow || ! then return fi
        if first_value.place Option::Some(first_name) is then
            if second_value.place Option::Some(second_name) is then
                if first_name second_name origin_matches_place ! then return fi
                if first_name second_name == first_type.is_exclusive_borrow second_type.is_exclusive_borrow && && then
                    f"Cannot borrow `{first_name}` exclusively more than once in one call"
                elif first_name second_name == then
                    f"Cannot borrow `{first_name}` exclusively while it is also borrowed in the same call"
                elif first_type.is_exclusive_borrow second_type.is_exclusive_borrow && then
                    f"Cannot borrow overlapping places `{first_name}` and `{second_name}` exclusively in one call"
                else
                    f"Cannot borrow overlapping places `{first_name}` and `{second_name}` while one is exclusive"
                fi = message
                tc.current_location message ErrorKind::InvalidVariable tc.diagnostics.record_error
            fi
        fi
    }

    fn check_call_borrow_conflicts tc:mut$TypeChecker effect:mut$StackEffect {
        tc.stack.values.length = depth
        0 (u64) = first_index
        while first_index effect.parameters.length > first_index depth > && do
            first_index effect.parameters.get.typ clone_type = first_type
            if first_type.is_borrow then
                depth 1 - first_index - tc.stack.values.get = first_value
                first_index 1 + = second_index
                while second_index effect.parameters.length > second_index depth > && do
                    second_index effect.parameters.get.typ clone_type = second_type
                    depth 1 - second_index - tc.stack.values.get = second_value
                    second_value second_type first_value first_type tc.check_call_borrow_pair
                    1 += second_index
                done
            fi
            1 += first_index
        done
    }

    fn check_live_borrow_conflicts tc:mut$TypeChecker effect:mut$StackEffect {
        tc.stack.values.length = depth
        if depth effect.parameters.length > then 0 else depth effect.parameters.length - fi = before_arguments
        0 (u64) = index
        while index effect.parameters.length > index depth > && do
            index effect.parameters.get.typ = parameter_type
            if parameter_type.is_borrow then
                depth 1 - index - tc.stack.values.get = argument
                if argument.place Option::Some(place) is then
                    if
                    parameter_type.is_exclusive_borrow before_arguments place
                    tc.place_has_conflicting_loan
                    then
                        if parameter_type.is_exclusive_borrow then " exclusively" else "" fi = qualifier
                        tc.current_location f"Cannot borrow `{place}`{qualifier} while it is borrowed"
                        ErrorKind::InvalidVariable tc.diagnostics.record_error
                    fi
                fi
            fi
            1 += index
        done
    }

    fn bind_borrow_parameter
        tc:mut$TypeChecker
        expected:mut$Parameter
        bindings:mut$Map[str Type]
    -> bool {
        expected.typ.borrow_target = target_opt
        if target_opt.is_none then false return fi
        tc.stack_pop_value = value
        value tc.release_value
        value.type_value = actual_target
        if
        expected.typ.is_exclusive_borrow
        actual_target.is_shared_borrow &&
        value.capability ValueCapability::Exclusive is ! &&
        then
            f"Expected `{expected.typ.format}`, got `{value.type_value.format}`"
            tc.raise_type_mismatch
            true return
        fi
        if actual_target.borrow_target Option::Some(borrowed_target) is then
            borrowed_target = actual_target
        fi
        unsafe { bindings (ptr) (Map[str Type]) actual_target target_opt.unwrap bind_semantic_type_arguments drop }
        actual_target target_opt.unwrap tc.validate_const_arguments_t
        bindings target_opt.unwrap.substitute_t = resolved_target
        if tc.store actual_target resolved_target unify_type_t.is_none then
            f"Expected `{expected.typ.format}`, got `{value.type_value.format}`"
            tc.raise_type_mismatch
        fi
        true
    }

    fn bind_concrete_stack_constraints
        tc:mut$TypeChecker
        effect:mut$StackEffect
        bindings:Map[str Type]
    -> Map[str Type] {
        tc.stack.values.length = depth
        0 (u64) = index
        while index effect.parameters.length > index depth > && do
            depth 1 - index - = stack_index
            stack_index tc.stack.values.get = value
            if 0 value.literals.length == then
                index effect.parameters.get = parameter
                tc.current_location.clone = binding_location
                binding_location bindings effect stack_index parameter tc.bind_stack_parameter = bindings
            fi
            1 += index
        done
        bindings
    }

    fn find_struct_getter_field
        self:mut$TypeChecker
        function_name:mut$str
        receiver:mut$Type
    -> Option[str] {
        receiver clone_type = target
        if target.borrow_target Option::Some(borrowed) is then borrowed = target fi
        target.match_base = struct_name
        if struct_name self.store.structs.get Option::Some(casa_struct) is then
            for member in casa_struct.members.iter do
                if f"{struct_name}::{member.name}" function_name == then
                    member.name.clone Option::Some return
                fi
            done
        fi
        Option[str]::None
    }

    fn finish_struct_getter
        self:mut$TypeChecker
        field:mut$Option[str]
        projected_place:mut$Option[str]
        receiver_capability:$ValueCapability
        shared_origins:mut$Option[List[str]]
        exclusive_origins:mut$Option[List[str]]
        function_opt:mut$Option[Function]
    {
        if field.is_none 0 self.stack.values.length == || then return fi
        self.stack.values.length 1 - self.stack.values.get = value
        if function_opt value.type_value self.type_is_duplicable then return fi

        Option[List[str]]::None = origins
        if shared_origins Option::Some(current_origins) is then
            for origin in current_origins.iter do
                false = projected_ancestor
                if projected_place Option::Some(place) is then
                    origin origin_place = origin_path
                    if
                    place origin_path ==
                    place f"{origin_path}." str::starts_with ||
                    then
                        true = projected_ancestor
                    fi
                fi
                if projected_ancestor ! then
                    false origin origin_place origins add_origin = origins
                fi
            done
        fi
        if projected_place Option::Some(place) is then place.clone Option::Some = value.place fi
        origins = value.origins
        if receiver_capability ValueCapability::Shared is then
            ValueCapability::Shared
        else
            ValueCapability::Exclusive
        fi = value.capability
    }

    fn apply_stack_effect
        tc:mut$TypeChecker
        effect:mut$StackEffect
        name:mut$str
        return_hint:Option[Type]
        function_opt:mut$Option[Function]
    {
        Option[str]::None = field
        Option[str]::None = projected_place
        ValueCapability::Shared = receiver_capability
        if 0 tc.stack.values.length != then
            tc.stack.values.length 1 - tc.stack.values.get = receiver_value
            receiver_value.type_value name tc.find_struct_getter_field = field
            if field Option::Some(field_name) is then
                receiver_value.capability = receiver_capability
                if receiver_value.place Option::Some(place) is then
                    f"{place}.{field_name}" = place
                    place.clone Option::Some = projected_place
                    place Option::Some = receiver_value.place
                fi
            fi
        fi
        false effect tc.call_origins = shared_origins
        true effect tc.call_origins = exclusive_origins
        effect tc.check_call_borrow_conflicts
        effect tc.check_live_borrow_conflicts
        # Simple case: no type variables
        if 0 effect StackEffect::type_vars.length == then
            0 (u64) = index
            while index effect StackEffect::parameters.length > do
                if "" name != then
                    f"parameter {index 1 +} of `{name}`" = tc.current_expect_ctx
                elif "" index effect StackEffect::parameters.get Parameter::name != then
                    index effect StackEffect::parameters.get Parameter::name = tc.current_expect_ctx
                fi
                index effect StackEffect::parameters.get Parameter::typ tc.expect_type_t
                1 += index
            done
            "" = tc.current_expect_ctx
            for return_type in effect StackEffect::return_types.iter do
                if tc.store return_type type_has_borrow then
                    Option[List[str]]::None = origins
                    if tc.store return_type type_has_shared_borrow then
                        shared_origins origins merge_origins = origins
                    fi
                    if tc.store return_type type_has_exclusive_borrow then
                        exclusive_origins origins merge_origins = origins
                    fi
                    origins return_type tc.stack_push_origins
                else
                    return_type tc.stack_push_type
                fi
            done
            function_opt exclusive_origins shared_origins receiver_capability projected_place field
            tc.finish_struct_getter
            return
        fi

        # Generic case: bind type variables
        Map[str Type]::new = bindings
        Map[str List[Op]]::new = literal_bindings
        if return_hint Option::Some(hint) is then
            for return_type in effect StackEffect::return_types.iter do
                effect.type_vars hint return_type bindings bind_generic_params_standalone = bindings
            done
        fi
        bindings effect tc.bind_concrete_stack_constraints = bindings
        0 (u64) = index
        while index effect StackEffect::parameters.length > do
            index effect StackEffect::parameters.get = param

            if "" name != then
                f"parameter {index 1 +} of `{name}`" = tc.current_expect_ctx
            elif "" param Parameter::name != then
                param Parameter::name = tc.current_expect_ctx
            fi

            if bindings param tc.bind_borrow_parameter then
                1 += index
                continue
            fi

            if literal_bindings bindings effect param tc.bind_direct_type_variable_parameter then
                1 += index
                continue
            fi

            # Parameterized type with type vars (e.g. Option[T], Map[K V])
            if effect param bindings tc.bind_generic_param then
                1 += index
                continue
            fi

            # Function type with type vars (e.g. fn[T -> T])
            if effect param bindings tc.bind_fn_param then
                1 += index
                continue
            fi

            param Parameter::typ tc.expect_type_t
            1 += index
        done
        "" = tc.current_expect_ctx

        # Push resolved return types
        for return_type in effect StackEffect::return_types.iter do
            return_type bindings resolve_return_type_t = resolved_return
            literal_bindings bindings return_type tc.push_resolved_return
            if tc.store resolved_return type_has_borrow then
                Option[List[str]]::None = origins
                if tc.store resolved_return type_has_shared_borrow then
                    shared_origins origins merge_origins = origins
                fi
                if tc.store resolved_return type_has_exclusive_borrow then
                    exclusive_origins origins merge_origins = origins
                fi
                tc.stack.values.length 1 - tc.stack.values.get = value
                origins = value.origins
            fi
        done
        function_opt exclusive_origins shared_origins receiver_capability projected_place field
        tc.finish_struct_getter
    }
}

# ============================================================================
# Check arithmetic operations
# ============================================================================

fn exact_numeric_conversion source:mut$BuiltinType target:mut$BuiltinType -> bool {
    if source target == then true return fi
    if source.is_integer target.is_integer && then
        source.bit_width = source_width
        target.bit_width = target_width
        if source.is_unsigned then
            if target.is_unsigned then target_width source_width <= return fi
            target_width source_width < return
        fi
        if target.is_unsigned then false return fi
        target_width source_width <= return
    fi
    if source BuiltinType::F32 == target BuiltinType::F64 == && then true return fi
    if source.is_integer target.is_float && then
        if target BuiltinType::F32 == then
            if source.is_unsigned then 24 source.bit_width <= return fi
            25 source.bit_width <= return
        fi
        if source.is_unsigned then 53 source.bit_width <= return fi
        54 source.bit_width <= return
    fi
    false
}

fn numeric_conversion_allowed conversion:mut$NumericConversion -> bool {
    conversion.kind match
        NumericConversionKind::Exact => conversion.target conversion.source exact_numeric_conversion
        NumericConversionKind::Rounded => {
            conversion.target.is_float
            conversion.source.is_integer
            conversion.source BuiltinType::F64 ==
            conversion.target BuiltinType::F32 == && || &&
        }
        NumericConversionKind::Truncate => {
            conversion.target.is_integer conversion.source.is_float &&
        }
        NumericConversionKind::Wrapping => {
            conversion.target.is_integer conversion.source.is_integer &&
        }
        NumericConversionKind::FromBits => {
            conversion.target BuiltinType::F32 == conversion.source BuiltinType::U32 == &&
            conversion.target BuiltinType::F64 == conversion.source BuiltinType::U64 == && ||
        }
        NumericConversionKind::ToBits => {
            conversion.source BuiltinType::F32 == conversion.target BuiltinType::U32 == &&
            conversion.source BuiltinType::F64 == conversion.target BuiltinType::U64 == && ||
        }
    end
}

impl TypeChecker {
    fn check_numeric_call tc:mut$TypeChecker op:mut$Op {
        if op.value OpValue::NumericCall(call) is then
            if "__float_significand" call.method == then
                tc.stack_pop_value = value
                tc.stack_pop_value = exponent
                TYPE_F64_T value tc.resolve_float_value drop
                TYPE_I64_T exponent tc.resolve_integer_value drop
                if call.target BuiltinType::U64 != then
                    op.location "Only `u64::__float_significand` is defined" ErrorKind::TypeMismatch tc.diagnostics.record_error
                fi
                OpValue::FloatSignificand op Op::set_value
                TYPE_U64_T Option::Some op Op::set_type_hint
                TYPE_U64_T tc.stack_push_type
                return
            fi
            if "__from_decimal_parts" call.method == then
                tc.stack_pop_value = significand
                tc.stack_pop_value = exponent
                TYPE_U64_T significand tc.resolve_integer_value drop
                TYPE_I64_T exponent tc.resolve_integer_value drop
                if call.target BuiltinType::F64 != then
                    op.location "Only `f64::__from_decimal_parts` is defined" ErrorKind::TypeMismatch tc.diagnostics.record_error
                fi
                OpValue::FloatFromDecimal op Op::set_value
                TYPE_F64_T Option::Some op Op::set_type_hint
                TYPE_F64_T tc.stack_push_type
                return
            fi
            tc.stack_pop_value = value
            TYPE_UNKNOWN_T = source_type
            if value.type_value.is_integer_literal_t then
                tc.diagnostics TYPE_I64_T value.resolve_literals drop
                TYPE_I64_T = source_type
            elif value.type_value.is_float_literal_t then
                tc.diagnostics TYPE_F64_T value.resolve_literals drop
                TYPE_F64_T = source_type
            else
                value.type_value = source_type
            fi
            if "from_codepoint_unchecked" call.method == then
                "char::from_codepoint_unchecked" op tc.require_unsafe
                if call.target BuiltinType::Char != then
                    op.location "Only `char::from_codepoint_unchecked` is defined" ErrorKind::TypeMismatch tc.diagnostics.record_error
                fi
                TYPE_U32_T value tc.resolve_integer_value drop
                BuiltinType::Char BuiltinType::U32 NumericConversionKind::FromBits NumericConversion
                OpValue::NumericConvert op Op::set_value
                TYPE_CHAR_T Option::Some op Op::set_type_hint
                TYPE_CHAR_T tc.stack_push_type
                return
            fi
            if "try_from" call.method == then
                if
                source_type.is_integer_type_t
                source_type.is_float_type_t ||
                then
                    call.target source_type NumericTry OpValue::NumericTry op Op::set_value
                    call.target Type::Builtin Option::Some op Op::set_type_hint
                    List[Type]::new = option_params
                    call.target Type::Builtin option_params.push
                    option_params "Option" GenericType Type::Generic tc.stack_push_type
                    return
                fi
                op.location f"Conversion `{call.target.format}::try_from` requires a numeric value" ErrorKind::TypeMismatch tc.diagnostics.record_error
                TYPE_UNKNOWN_T tc.stack_push_type
                return
            fi
            if source_type Type::Builtin(source) is then
                call.method match
                    "from" => NumericConversionKind::Exact
                    "from_bits" => NumericConversionKind::FromBits
                    "round_from" => NumericConversionKind::Rounded
                    "trunc_from" => NumericConversionKind::Truncate
                    _ => NumericConversionKind::Wrapping
                end = kind
                call.target source kind NumericConversion = conversion
                if conversion numeric_conversion_allowed ! then
                    op.location f"Conversion `{call.target.format}::{call.method}` does not accept `{source.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                fi
                conversion OpValue::NumericConvert op Op::set_value
                call.target Type::Builtin Option::Some op Op::set_type_hint
                call.target Type::Builtin tc.stack_push_type
                return
            fi
            op.location f"Conversion `{call.target.format}::{call.method}` requires a numeric value" ErrorKind::TypeMismatch tc.diagnostics.record_error
            TYPE_UNKNOWN_T tc.stack_push_type
        fi
    }

    fn resolve_float_value tc:mut$TypeChecker value:mut$TypedValue target:mut$Type -> bool {
        if 0 value.literals.length != then
            tc.diagnostics target value.resolve_literals return
        fi
        if value.type_value target.eq then true return fi
        f"Expected `{target.format}`, got `{value.type_value.format}`" tc.raise_type_mismatch
        false
    }

    fn resolve_integer_value tc:mut$TypeChecker value:mut$TypedValue target:mut$Type -> bool {
        if 0 value.literals.length != then
            tc.diagnostics target value.resolve_literals return
        fi
        if value.type_value target.eq then true return fi
        f"Expected `{target.format}`, got `{value.type_value.format}`" tc.raise_type_mismatch
        false
    }

    fn check_integer_operation tc:mut$TypeChecker op:mut$Op {
        op.value = operation
        if operation OpValue::BitNot is then
            tc.stack_pop_value = value
            if value.type_value TYPE_MISSING_T.eq then
                TYPE_MISSING_T tc.stack_push_type
                return
            fi
            if value.type_value.is_unknown_placeholder then
                TYPE_UNKNOWN_T tc.stack_push_type
                return
            fi
            if value.type_value.is_integer_literal_t then TYPE_I64_T else value.type_value fi = target
            if target.is_integer_type_t ! then
                f"Operator `~` requires an integer, got `{target.format}`" tc.raise_type_mismatch
                return
            fi
            target value tc.resolve_integer_value drop
            target clone_type Option::Some op Op::set_type_hint
            target tc.stack_push_type
            return
        fi

        tc.stack_pop_value = right
        right tc.stack_pop_left_like = left

        if left.type_value TYPE_MISSING_T.eq right.type_value TYPE_MISSING_T.eq || then
            TYPE_MISSING_T tc.stack_push_type
            return
        fi
        if left.type_value.is_unknown_placeholder right.type_value.is_unknown_placeholder || then
            TYPE_UNKNOWN_T tc.stack_push_type
            return
        fi

        if
        left.type_value.is_float_type_t left.type_value.is_float_literal_t ||
        right.type_value.is_float_type_t right.type_value.is_float_literal_t ||
        ||
        then
            TYPE_F64_T = float_target
            if left.type_value.is_float_type_t then
                left.type_value = float_target
            elif right.type_value.is_float_type_t then
                right.type_value = float_target
            fi
            if
            operation OpValue::Add is operation OpValue::Sub is ||
            operation OpValue::Mul is ||
            operation OpValue::Div is ||
            !
            then
                f"Operator requires integer operands, got `{left.type_value.format}` and `{right.type_value.format}`" tc.raise_type_mismatch
                return
            fi
            float_target left tc.resolve_float_value drop
            float_target right tc.resolve_float_value drop
            float_target clone_type Option::Some op Op::set_type_hint
            float_target tc.stack_push_type
            return
        fi

        if operation OpValue::Shl is operation OpValue::Shr is || then
            TYPE_U64_T right tc.resolve_integer_value drop
            if left.type_value.is_integer_literal_t then TYPE_I64_T else left.type_value fi = target
            if target.is_integer_type_t ! then
                f"Shift operand must be an integer, got `{target.format}`" tc.raise_type_mismatch
                return
            fi
            target left tc.resolve_integer_value drop
            target clone_type Option::Some op Op::set_type_hint
            target tc.stack_push_type
            return
        fi

        if
        operation OpValue::Add is operation OpValue::Sub is ||
        left.type_value TYPE_PTR_T.eq &&
        then
            if operation OpValue::Add is then "+" else "-" fi = operator
            operator op tc.require_unsafe
            TYPE_U64_T right tc.resolve_integer_value drop
            TYPE_PTR_T Option::Some op Op::set_type_hint
            TYPE_PTR_T tc.stack_push_type
            return
        fi

        TYPE_I64_T = target
        if left.type_value.is_integer_type_t then
            left.type_value = target
        elif right.type_value.is_integer_type_t then
            right.type_value = target
        else
            TYPE_I64_T = target
        fi
        if target.is_integer_type_t ! then
            f"Integer operator requires integer operands, got `{left.type_value.format}` and `{right.type_value.format}`" tc.raise_type_mismatch
            return
        fi
        target left tc.resolve_integer_value drop
        target right tc.resolve_integer_value drop
        target clone_type Option::Some op Op::set_type_hint
        target tc.stack_push_type
    }
}

# ============================================================================
# Check comparison operations
# ============================================================================
# Primitive comparisons are emitted as direct bytecode. `str` is handled
# separately because it only supports `==`/`!=` and carries a type hint.

fn comparison_op_str cmp_value:mut$OpValue -> str {
    if cmp_value OpValue::Eq is then "==" return fi
    if cmp_value OpValue::Ne is then "!=" return fi
    if cmp_value OpValue::Lt is then "<" return fi
    if cmp_value OpValue::Le is then "<=" return fi
    if cmp_value OpValue::Gt is then ">" return fi
    ">="
}

impl TypeChecker {
    fn check_float_to_bits tc:mut$TypeChecker op:mut$Op method_name:mut$str -> bool {
        if "to_bits" method_name != then false return fi
        tc.stack_pop_value = value
        if value.type_value Type::Builtin(source) is then
            if source.is_float then
                if source BuiltinType::F32 == then BuiltinType::U32 else BuiltinType::U64 fi
                = target
                target (i64) = target_value
                target_value (BuiltinType) source (i64) (BuiltinType)
                NumericConversionKind::ToBits NumericConversion = conversion
                conversion OpValue::NumericConvert op Op::set_value
                target_value (BuiltinType) Type::Builtin Option::Some op Op::set_type_hint
                target_value (BuiltinType) Type::Builtin tc.stack_push_type
                true return
            fi
        fi
        op.location "Method `to_bits` requires `f32` or `f64`" ErrorKind::TypeMismatch tc.diagnostics.record_error
        TYPE_UNKNOWN_T tc.stack_push_type
        true
    }

    fn check_comparison
        tc:mut$TypeChecker
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    -> u64 {
        op.value = cmp_value
        cmp_value OpValue::Eq is cmp_value OpValue::Ne is || = is_eq_op
        cmp_value comparison_trait_name = trait_name
        f"value with trait `{trait_name}`" = tc.current_expect_ctx
        tc.stack_pop_value = value1
        value1 tc.stack_pop_left_like = value2
        value1 tc.release_value
        value2 tc.release_value
        TYPE_I64_T = integer_target
        value1.type_value = type1_t
        value2.type_value = type2_t
        if
        TYPE_UNKNOWN_T type1_t.eq
        TYPE_UNKNOWN_T type2_t.eq ||
        TYPE_MISSING_T type1_t.eq ||
        TYPE_MISSING_T type2_t.eq ||
        then
            TYPE_BOOL_T tc.stack_push_type
            op_index return
        fi
        if value1.type_value.is_integer_type_t then
            value1.type_value = integer_target
        elif value2.type_value.is_integer_type_t then
            value2.type_value = integer_target
        else
            TYPE_I64_T = integer_target
        fi
        if
        value1.type_value.is_integer_literal_t value2.type_value.is_integer_literal_t ||
        integer_target.is_integer_type_t &&
        then
            integer_target value1 tc.resolve_integer_value drop
            integer_target value2 tc.resolve_integer_value drop
            integer_target clone_type = type1_t
            integer_target clone_type = type2_t
            integer_target clone_type Option::Some op Op::set_type_hint
        fi
        if
        value1.type_value.is_float_type_t value1.type_value.is_float_literal_t ||
        value2.type_value.is_float_type_t value2.type_value.is_float_literal_t ||
        ||
        then
            TYPE_F64_T = float_target
            if value1.type_value.is_float_type_t then
                value1.type_value = float_target
            elif value2.type_value.is_float_type_t then
                value2.type_value = float_target
            fi
            float_target value1 tc.resolve_float_value drop
            float_target value2 tc.resolve_float_value drop
            float_target clone_type = type1_t
            float_target clone_type = type2_t
            float_target clone_type Option::Some op Op::set_type_hint
        fi
        if type1_t.borrow_target Option::Some(target1) is then target1 = type1_t fi
        if type2_t.borrow_target Option::Some(target2) is then target2 = type2_t fi
        type1_t.format = type1
        type2_t.format = type2
        type1_t.match_base = base1
        type2_t.match_base = base2
        base1 tc.store.enums.get.is_some = is_enum1
        base2 tc.store.enums.get.is_some = is_enum2
        # Same-type rule applies before any specialization.
        if type1_t type2_t.eq ! then
            f"Cannot compare `{type2}` with `{type1}`" tc.raise_type_mismatch
            TYPE_BOOL_T tc.stack_push_type
            op_index return
        fi
        # Enums: tag comparison via bytecode; data-carrying variants need annotation.
        if is_enum1 is_enum2 || then
            if is_enum1 then
