impl TypeChecker {
    pub fn check_global_initializer self:mut$TypeChecker op:mut$common::Op {
        if op.value common::OpValue::InitGlobal(initializer) is then
            initializer.clone = checked_initializer
            self
                .stack
                .values
                .length = stack_before
            std::Option[common::Function]::None = root_scope
            root_scope checked_initializer.ops self.run_type_check_ops
            self
                .stack
                .values
                .length = stack_after
            if stack_before 1 + stack_after != then
                op.location
                f"Global `{checked_initializer.name}` initializer must produce exactly one value, produced {stack_after stack_before -}"
                common::ErrorKind::SignatureMismatch self.diagnostics.record_error_string
                while
                    self
                        .stack
                        .values
                        .length stack_before >
                do
                    self.stack_pop_drop
                done
                checked_initializer common::OpValue::InitGlobal op common::Op::set_value
                return
            fi

            self.stack_pop_value = value
            value.type_value resolve_numeric_literal_default = global_type
            self.literal_resolutions self.diagnostics global_type value.resolve_literals drop
            if global_type.is_exclusive_borrow then
                op.location
                f"Global `{checked_initializer.name}` cannot store an exclusive borrow"
                common::ErrorKind::InvalidVariable self.diagnostics.record_error_string
            elif value.capability ValueCapability::Owned is ! global_type.is_borrow ! && then
                common::SHARED_BORROW_TYPE global_type common::apply_borrow_type = global_type
            fi
            checked_initializer.name.clone = initializer_storage
            if
                checked_initializer.name.as_str self
                    .store
                    .immutable_global_slots
                    .get_str
                std::Option::Some(slot) is
            then
                slot.clone = initializer_storage
            fi
            self
                .store
                .immutable_global_slots
                .iter = global_slots
            for pair in global_slots do
                if pair.second.as_str initializer_storage.as_str != then
                    continue
                fi
                pair.first.as_str self
                    .store
                    .variables
                    .remove_str = global_opt
                global_opt match
                    std::Option::Some(global_var) => {
                        global_type common::clone_type global_var common::Variable::set_typ
                        global_var pair.first.clone self
                            .store
                            .variables
                            .set
                    }
                    std::Option::None => {
                    }
                end
            done
            checked_initializer common::OpValue::InitGlobal op common::Op::set_value
        fi
    }
}

impl TypeChecker {
    pub fn check_literals
        tc:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        if op.value common::OpValue::PushInt is then
            op.type_hint.clone = integer_type_opt
            integer_type_opt match
                std::Option::Some(integer_type) => {
                    tc.diagnostics integer_type op.resolve_literal drop
                    integer_type tc.stack_push_type
