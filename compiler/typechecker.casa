# ============================================================================
# Check function-related operations
# ============================================================================

impl TypeChecker {
    # ADR-0112: a typed borrow reconstructed from a raw address inside `unsafe`
    # is anchored conservatively to every compatible borrowed input of the
    # enclosing function. A shared borrow accepts any borrowed input; an
    # exclusive borrow accepts only exclusive inputs (ADR-0113). A function with
    # no compatible input yields no origin, so the borrow cannot escape.
    fn raw_borrow_input_origins
        self:mut$TypeChecker
        function_opt:mut$Option[Function]
        exclusive:bool
    -> Option[List[str]] {
        Option[List[str]]::None = origins
        if function_opt Option::Some(function) is then
            for parameter in function.stack_effect.parameters.iter do
                if exclusive then
                    if self.store parameter.typ type_has_exclusive_borrow ! then continue fi
                elif self.store parameter.typ type_has_borrow ! then
                    continue
                fi
                exclusive parameter.name origins add_origin = origins
            done
        fi
        origins
    }

    fn is_return_origin_valid self:mut$TypeChecker function:mut$Function origin:mut$str -> bool {
        origin origin_is_exclusive = exclusive
        origin origin_place = place
        place get_place_root = root
        if root self.store.variables.has then true return fi
        for parameter in function.stack_effect.parameters.iter do
            if root parameter.name == then
                if exclusive then
                    self.store parameter.typ type_has_exclusive_borrow return
                fi
                self.store parameter.typ type_has_borrow return
            fi
        done
        false
    }

    fn report_overlapping_origin_lists
        self:mut$TypeChecker
        first_origins:$List[str]
        second_origins:$List[str]
    {
        for first_origin in first_origins.iter do
            if first_origin origin_is_exclusive ! then continue fi
            if first_origins first_origin has_origin_descendant then continue fi
            for second_origin in second_origins.iter do
                if second_origin origin_is_exclusive ! then continue fi
                if second_origins second_origin has_origin_descendant then continue fi
                first_origin origin_place = first_place
                second_origin origin_place = second_place
                if first_place second_place origin_matches_place ! then continue fi
                self.current_location
                f"Cannot return overlapping exclusive places `{first_place}` and `{second_place}`"
                ErrorKind::InvalidVariable self.diagnostics.record_error
            done
        done
    }

    fn report_overlapping_return_origins
        self:mut$TypeChecker
        first_value:$TypedValue
        second_value:$TypedValue
    {
        if first_value.origins Option::Some(first_origins) is then
            if second_value.origins Option::Some(second_origins) is then
                second_origins first_origins self.report_overlapping_origin_lists
            fi
        fi
    }

    fn generated_return_has_implicit_borrow_origin
        self:mut$TypeChecker
        function:mut$Function
    -> bool {
        if function.name "::Copy::clone" str::ends_with then true return fi
        if 1 function.stack_effect.parameters.length != then false return fi
        0 function.stack_effect.parameters.get.typ = receiver
        receiver function.name self.find_struct_getter_field.is_some
    }

    fn validate_borrow_returns self:mut$TypeChecker function:mut$Function {
        0 (u64) = index
        while index self.stack.values.length > index function.stack_effect.return_types.length > && do
            index function.stack_effect.return_types.get = return_type
            if self.store return_type type_has_borrow then
                index self.stack.values.get = value
                if value.origins Option::Some(origins) is then
                    for origin in origins.iter do
                        if origin function self.is_return_origin_valid ! then
                            origin origin_place = place
                            self.current_location f"Borrowed return escapes local owner `{place}`"
                            ErrorKind::InvalidVariable self.diagnostics.record_error
                        fi
                    done
                else
                    if function self.generated_return_has_implicit_borrow_origin ! then
                        self.current_location "Borrowed return has no live input origin"
                        ErrorKind::InvalidVariable self.diagnostics.record_error
                    fi
                fi
            fi
            1 += index
        done
        0 (u64) = first_index
        while
        first_index self.stack.values.length >
        first_index function.stack_effect.return_types.length > &&
        do
            first_index function.stack_effect.return_types.get = first_declared
            first_index self.stack.values.get = first_value
            if first_declared.is_exclusive_borrow then
                first_index 1 + = second_index
                while
                second_index self.stack.values.length >
                second_index function.stack_effect.return_types.length > &&
                do
                    second_index function.stack_effect.return_types.get = second_declared
                    second_index self.stack.values.get = second_value
                    if second_declared.is_exclusive_borrow then
                        second_value first_value self.report_overlapping_return_origins
                    fi
                    1 += second_index
                done
            fi
            1 += first_index
        done
    }

    fn sync_capture_types tc:mut$TypeChecker lambda:mut$Function function_opt:mut$Option[Function] {
        if function_opt.is_none then return fi
        for capture in lambda Function::captures.iter do
            capture Variable::name = capture_name
