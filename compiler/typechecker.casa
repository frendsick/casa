# Stack-based type inference and checking for the Casa compiler.
#
# Maintains a virtual stack of types and validates that operations
# are type-safe.
import "std"
import "common"
import "error"
import "syntax"
import "block_scope"
import "semantics"
import "pattern"

# ============================================================================
# TypedStack — typed values with source and unresolved-literal origins.
# ============================================================================

struct TypedStack {
    values: List[TypedValue]
}

struct LiteralRef {
    id:            i64
    integer_value: i64
    is_integer:    bool
}

impl LiteralRef: Clone {
    fn clone self:$LiteralRef -> LiteralRef {
        self.is_integer self.integer_value self.id LiteralRef
    }
}

enum ValueCapability derives Copy {
    Owned
    Shared
    Exclusive
}

struct TypedValue {
    type_value:          Type
    origin:              Location
    literals:            List[LiteralRef]
    place:               Option[String]
    capability:          ValueCapability
    binding:             Option[String]
    source:              Option[i64]
    origins:             Option[List[String]]
    is_literal_constant: bool
}

fn origin_is_exclusive origin:$str -> bool { origin "!" str::starts_with }

fn origin_place origin:$str -> String {
    if origin.as_str origin_is_exclusive then
        origin.length 1 - = length
        origin 1 length str::substring return
    fi
    origin.to_str
}

fn origin_matches_place origin:$str place:$str -> bool {
    origin.as_str origin_place = origin_path
    if origin_path.as_str place == then
        true return
    fi
    f"{place}." = place_prefix
    if origin_path.as_str place_prefix.as_str str::starts_with then
        true return
    fi
    f"{origin_path}." = origin_prefix
    place origin_prefix.as_str str::starts_with
}

fn get_place_root place:$str -> String {
    place "." str::split = parts
    0 parts.get.clone
}

fn add_origin origins:Option[List[String]] place:$str exclusive:bool -> Option[List[String]] {
    if exclusive then f"!{place}" else place.to_str fi = origin
    origins match
        Option::Some(items) => {
            if origin.as_str items string_list_contains ! then
                origin items.push
            fi
            items Option::Some
        }
        Option::None => {
            List[String]::new = items
            origin items.push
            items Option::Some
        }
    end
}

fn merge_origins target:Option[List[String]] source:$Option[List[String]] -> Option[List[String]] {
    if source Option::Some(items) is then
        for origin in items.iter do
            origin.as_str origin_place = place
            origin.as_str origin_is_exclusive place.as_str target add_origin = target
        done
    fi
    target
}

fn merge_destination_origins
    target:Option[List[String]]
    value:$TypedValue
    expected:$Type
-> Option[List[String]] {
    value.origins target merge_origins = target
    if expected.is_borrow value.origins.is_none && then
        if value.place Option::Some(place) is then
            expected.is_exclusive_borrow place.as_str target add_origin = target
        fi
    fi
    target
}

fn clone_origins source:$Option[List[String]] -> Option[List[String]] {
    if source Option::Some(items) is then
        List[String]::new = cloned
        for origin in items.iter do
            origin.clone cloned.push
        done
        cloned Option::Some return
    fi
    Option[List[String]]::None
}

fn clone_typed_value value:$TypedValue -> TypedValue {
    Option[String]::None = place
    if value.place Option::Some(current_place) is then
        current_place.clone Option::Some = place
    fi
    Option[String]::None = binding
    if value.binding Option::Some(current_binding) is then
        current_binding.clone Option::Some = binding
    fi
    Option[i64]::None = source
    if value.source Option::Some(current_source) is then
        current_source Option::Some = source
    fi
    value.is_literal_constant
    value.origins clone_origins
    source
    binding
    value.capability
    place
    value.literals.clone
    value.origin.clone
    value.type_value clone_type
    TypedValue
}

fn has_origin_descendant origin:$str origins:$List[String] -> bool {
    origin.as_str origin_place = place
    for other in origins.iter do
        if other.as_str origin_is_exclusive ! then
            continue
        fi
        other.as_str origin_place = other_place
        f"{place}." = place_prefix
        if
            place.as_str other_place.as_str != other_place.as_str place_prefix.as_str str::starts_with &&
        then
            true return
        fi
    done
    false
}

fn count_variable_uses ops:$List[Op] counts:Map[String u64] -> Map[String u64] {
    for op in ops.iter do
        if op.value OpValue::PushVar(name) is then
            0 (u64) = count
            if name counts.get_copy Option::Some(found) is then
                found = count
            fi
            count 1 + name.clone counts.set
        fi
        if op.value OpValue::PushArray(items) is then
            counts items count_variable_uses = counts
        elif op.value OpValue::ExprGroup(items) is then
            counts items count_variable_uses = counts
        elif op.value OpValue::MatchArm(arm) is then
            counts arm.guard_ops count_variable_uses = counts
        fi
    done
    counts
}

fn type_capability typ:$Type -> ValueCapability {
    if typ.is_shared_borrow then
        ValueCapability::Shared return
    fi
    if typ.is_exclusive_borrow then
        ValueCapability::Exclusive return
    fi
    ValueCapability::Owned
}

fn type_contains_borrow
    typ:$Type
    exclusive:bool
    store:$SymbolStore
    visiting:mut$List[String]
-> bool {
    if typ.is_borrow then
        if exclusive then typ.is_exclusive_borrow else typ.is_shared_borrow fi return
    fi
    if typ Type::Generic(generic) is then
        for parameter in generic.params.iter do
            if visiting store exclusive parameter type_contains_borrow then
                true return
            fi
        done
        if generic.base.as_str visiting string_list_contains then
            false return
        fi
        generic.base.clone visiting.push
        Map[String Type]::new = bindings
        if generic.base store.structs.get Option::Some(casa_struct) is then
            for
                pair in generic.params.iter casa_struct
                    .type_vars
                    .iter
                    .zip
            do
                pair.second clone_type pair.first.clone bindings.set
            done
            for member in casa_struct.members.iter do
                bindings member.typ.substitute_t = member_type
                if visiting store exclusive member_type type_contains_borrow then
                    true return
                fi
            done
        elif generic.base store.enums.get Option::Some(casa_enum) is then
            for
                pair in generic.params.iter casa_enum
                    .type_vars
                    .iter
                    .zip
            do
                pair.second clone_type pair.first.clone bindings.set
            done
            for pair in casa_enum.variant_types.iter do
                for payload_type in pair.second.iter do
                    bindings payload_type.substitute_t = resolved
                    if visiting store exclusive resolved type_contains_borrow then
                        true return
                    fi
                done
            done
        fi
    fi
    false
}

fn clone_type_binding bindings:$Map[String Type] name:$str -> Option[Type] {
    if name bindings.get_str Option::Some(value) is then
        value clone_type Option::Some
    else
        Option[Type]::None
    fi
}

fn type_has_shared_borrow typ:$Type store:mut$SymbolStore -> bool {
    if typ.is_shared_borrow then
        true return
    fi
    if typ Type::Generic is ! then
        false return
    fi
    f"shared:{typ.format}" = key
    if key store.borrow_shapes.get Option::Some(cached) is then
        cached.clone return
    fi
    List[String]::new = visiting
    visiting store false typ type_contains_borrow = result
    result key store.borrow_shapes.set
    result
}

fn type_has_exclusive_borrow typ:$Type store:mut$SymbolStore -> bool {
    if typ.is_exclusive_borrow then
        true return
    fi
    if typ Type::Generic is ! then
        false return
    fi
    f"exclusive:{typ.format}" = key
    if key store.borrow_shapes.get Option::Some(cached) is then
        cached.clone return
    fi
    List[String]::new = visiting
    visiting store true typ type_contains_borrow = result
    result key store.borrow_shapes.set
    result
}

fn type_has_borrow typ:$Type store:mut$SymbolStore -> bool {
    if store typ type_has_shared_borrow then
        true return
    fi
    store typ type_has_exclusive_borrow
}

fn method_receiver_type effect:$StackEffect -> Option[Type] {
    for parameter in effect.parameters.iter do
        if parameter.name.as_str is_hidden_parameter_name ! then
            parameter.typ clone_type Option::Some return
        fi
    done
    Option[Type]::None
}

fn capability_matches_receiver capability:$ValueCapability expected:$Type -> bool {
    if capability ValueCapability::Shared is then
        expected.is_shared_borrow return
    fi
    if capability ValueCapability::Exclusive is then
        expected.is_shared_borrow expected.is_exclusive_borrow || return
    fi
    true
}

fn contains_literal literals:$List[LiteralRef] candidate:$LiteralRef -> bool {
    for literal in literals.iter do
        if candidate.id literal.id == then
            true return
        fi
    done
    false
}

impl TypedValue {
    fn same_owner_source self:$TypedValue other:$TypedValue -> bool {
        if self.binding Option::Some(name) is then
            if other.binding Option::Some(other_name) is then
                if name other_name != then
                    false return
                fi
                if self.source Option::Some(source) is then
                    if other.source Option::Some(other_source) is then
                        source other_source == return
                    fi
                fi
            fi
            false return
        fi
        other.binding.is_none
    }

    fn same_place self:$TypedValue other:$TypedValue -> bool {
        if self.place Option::Some(place) is then
            if other.place Option::Some(other_place) is then
                place other_place == return
            fi
            false return
        fi
        other.place.is_none
    }

    fn clear_owner_source self:mut$TypedValue {
        Option[String]::None = self.place
        Option[String]::None = self.binding
        Option[i64]::None = self.source
    }

    fn resolve_literals
        self:mut$TypedValue
        target:$Type
        diagnostics:mut$Diagnostics
        resolutions:mut$Map[i64 Type]
    -> bool {
        target clone_type = resolved_target
        if resolved_target.borrow_target Option::Some(borrowed_target) is then
            borrowed_target clone_type = resolved_target
        fi
        for literal in self.literals.iter do
            if 0 literal.id != then
                resolved_target clone_type literal.id resolutions.set
            fi
        done
        true
    }
}

impl TypedStack {
    fn new -> TypedStack { List[TypedValue]::new TypedStack }

    fn snapshot self:$TypedStack -> TypedStack {
        List[TypedValue]::new = values
        for value in self.values.iter do
            value clone_typed_value values.push
        done
        values TypedStack
    }

    fn restore self:mut$TypedStack source:$TypedStack {
        List[TypedValue]::new = values
        for value in source.values.iter do
            value clone_typed_value values.push
        done
        values = self.values
    }

    fn get_types self:$TypedStack -> List[Type] {
        List[Type]::new = types
        for value in self.values.iter do
            value.type_value clone_type types.push
        done
        types
    }

    fn set_types self:mut$TypedStack types:$List[Type] {
        0 (u64) = index
        while index self.values.length > do
            index self.values.get_mut = value
            value.is_literal_constant value.origins clone_origins
            value.source.clone value.binding.clone value.capability value.place.clone
            value.literals.clone value.origin.clone
            index types.get clone_type TypedValue index self.values.set
            1 += index
        done
    }

    # Pure stack comparison on the types slice (origins are not compared).
    fn equals self:$TypedStack other:$TypedStack -> bool {
        if self.values.length other.values.length != then
            false return
        fi
        0 (u64) = index
        while index self.values.length > do
            if
                index self
                    .values
                    .get
                    .capability
                index other
                    .values
                    .get
                    .capability !=
            then
                false return
            fi
            1 += index
        done
        self.get_types other.get_types stacks_equal
    }

    fn merge_literals self:mut$TypedStack candidate:$TypedStack {
        0 (u64) = index
        while index self.values.length > do
            index self.values.get_mut = value
            index candidate.values.get = candidate_value
            if candidate_value value.same_owner_source ! then
                value.clear_owner_source
            elif candidate_value value.same_place ! then
                Option[String]::None = value.place
            fi
            value.origins clone_origins = merged_origins
            candidate_value.origins merged_origins merge_origins = merged_origins
            merged_origins = value.origins
            0 (u64) = literal_index
            while literal_index candidate_value.literals.length > do
                literal_index candidate_value.literals.get = candidate_literal
                if candidate_literal value.literals contains_literal ! then
                    candidate_literal.clone value.literals.push
                fi
                1 += literal_index
            done
            1 += index
        done
    }

    fn mark_literals_runtime self:mut$TypedStack {
        0 (u64) = index
        while index self.values.length > do
            index self.values.get_mut = value
            if 0 value.literals.length != then
                false = value.is_literal_constant
            fi
            1 += index
        done
    }

    # Produce unified types and retain literal origins from both stacks.
    fn unify_types self:mut$TypedStack candidate:$TypedStack store:mut$SymbolStore -> List[Type] {
        if self.values.length candidate.values.length == then
            0 (u64) = index
            while index self.values.length > do
                if
                    index self
                        .values
                        .get
                        .capability
                    index candidate
                        .values
                        .get
                        .capability !=
                then
                    List[Type]::new return
                fi
                1 += index
            done
        fi
        store self.get_types candidate.get_types stacks_compatible = unified
        if unified.length self.values.length == then
            candidate self.merge_literals
        fi
        unified
    }
}

# ============================================================================
# Branch contexts — one specialized struct per branch kind (if / while / match).
# ============================================================================

struct OwnershipFlow {
    moved: List[String]
    loans: Map[String List[String]]
}

impl OwnershipFlow {
    fn new -> OwnershipFlow { Map[String List[String]]::new List[String]::new OwnershipFlow }

    fn merge self:mut$OwnershipFlow other:$OwnershipFlow {
        for name in other.moved.iter do
            if name.as_str self.moved string_list_contains ! then
                name.clone self.moved.push
            fi
        done
        for pair in other.loans.iter do
            List[String]::new = origins
            if pair.first self.loans.get Option::Some(existing) is then
                existing.clone = origins
            fi
            for origin in pair.second.iter do
                if origin.as_str origins string_list_contains ! then
                    origin.clone origins.push
                fi
            done
            origins pair.first.clone self.loans.set
        done
    }
}

struct IfContext {
    before:                  TypedStack
    after:                   TypedStack
    flow_before:             OwnershipFlow
    flow_after:              OwnershipFlow
    entry_continues:         bool
    has_continuing_branch:   bool
    condition_present:       bool
    default_present:         bool
    current_branch_label:    String
    current_branch_location: Location
}

struct WhileContext {
    before:                  TypedStack
    flow_before:             OwnershipFlow
    flow_exit:               OwnershipFlow
    entry_continues:         bool
    has_exit:                bool
    condition_present:       bool
    current_branch_location: Location
    scope_depth:             u64
}

struct MatchContext {
    before:                  TypedStack
    after:                   TypedStack
    flow_before:             OwnershipFlow
    flow_after:              OwnershipFlow
    entry_continues:         bool
    has_continuing_arm:      bool
    condition_present:       bool
    branch_records:          List[String]
    match_type:              Type
    match_origins:           Option[List[String]]
    match_place:             Option[String]
    current_branch_label:    String
    current_branch_location: Location
}

enum BranchFrame {
    BranchIf (IfContext)
    BranchWhile (WhileContext)
    BranchMatch (MatchContext)
}

impl BranchFrame {
    fn into_if self:BranchFrame -> IfContext {
        self match
            BranchFrame::BranchIf(context) => context
            _ => {
                "Internal error: expected if branch frame\n" eprint
                1 exit
                IfContext::new
            }
        end
    }

    fn into_while self:BranchFrame -> WhileContext {
        self match
            BranchFrame::BranchWhile(context) => context
            _ => {
                "Internal error: expected while branch frame\n" eprint
                1 exit
                0 WhileContext::new
            }
        end
    }

    fn into_match self:BranchFrame -> MatchContext {
        self match
            BranchFrame::BranchMatch(context) => context
            _ => {
                "Internal error: expected match branch frame\n" eprint
                1 exit
                TYPE_UNKNOWN_T clone_type MatchContext::new
            }
        end
    }
}

impl IfContext {
    fn new -> IfContext {
        empty_location
        "".to_str
        false
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        TypedStack::new
        IfContext
    }
}

impl WhileContext {
    fn new scope_depth:u64 -> WhileContext {
        scope_depth
        empty_location
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        WhileContext
    }
}

impl MatchContext {
    fn new match_type:Type -> MatchContext {
        empty_location
        "".to_str
        Option[String]::None
        Option[List[String]]::None
        match_type
        List[String]::new
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        TypedStack::new
        MatchContext
    }
}

# ============================================================================
# TypeChecker struct
# ============================================================================

struct TypeChecker {
    stack:                      TypedStack
    parameters:                 List[Parameter]
    return_types:               TypedStack
    has_return_types:           bool
    branched_stacks:            List[BranchFrame]
    current_location:           Location
    current_op_context:         String
    current_expect_ctx:         String
    in_branch_condition:        bool
    path_continues:             bool
    store:                      mut$SymbolStore
    param_cap:                  Option[u64]
    underflow_reported_this_op: bool
    scope:                      BlockScope
    moved_owners:               List[String]
    owner_events:               List[OwnerEvent]
    next_owner_generation:      u64
    binding_origins:            Map[String List[String]]
    remaining_uses:             Map[String u64]
    unsafe_depth:               u64
    required_drop_types:        List[Type]
    literal_resolutions:        Map[i64 Type]
    diagnostics:                mut$Diagnostics
}

struct TypecheckResult {
    store:               SymbolStore
    global_stack_effect: StackEffect
    ops:                 List[Op]
    diagnostics:         Diagnostics
}

fn unsafe_operation_name operation:$OpValue -> str {
    # Callers already classify the operation as unsafe. Keep enforcement if a name is missing.
    operation match
        OpValue::HeapAlloc => "alloc"
        OpValue::HeapFree => "free"
        OpValue::Load8 => "load8"
        OpValue::Load16 => "load16"
        OpValue::Load32 => "load32"
        OpValue::Load64 => "load64"
        OpValue::PtrAsRef => "ptr::as_ref"
        OpValue::PtrAsMut => "ptr::as_mut"
        OpValue::PtrIntoRaw => "ptr::into_raw"
        OpValue::PtrRead => "ptr::read"
        OpValue::Store8 => "store8"
        OpValue::Store16 => "store16"
        OpValue::Store32 => "store32"
        OpValue::Store64 => "store64"
        OpValue::PtrWrite => "ptr::write"
        OpValue::Syscall0 => "syscall0"
        OpValue::Syscall1 => "syscall1"
        OpValue::Syscall2 => "syscall2"
        OpValue::Syscall3 => "syscall3"
        OpValue::Syscall4 => "syscall4"
        OpValue::Syscall5 => "syscall5"
        OpValue::Syscall6 => "syscall6"
        _ => "operation"
    end
}

impl TypeChecker {
    fn new store:mut$SymbolStore diagnostics:mut$Diagnostics -> TypeChecker {
        diagnostics # diagnostics
        Map[i64 Type]::new # literal_resolutions
        List[Type]::new # required_drop_types
        0 # unsafe_depth
        Map[String u64]::new # remaining_uses
        Map[String List[String]]::new # binding_origins
        0 # next_owner_generation
        List[OwnerEvent]::new # owner_events
        List[String]::new # moved_owners
        BlockScope::new # scope
        false # underflow_reported_this_op
        Option[u64]::None # param_cap
        store # store
        true # path_continues
        false # in_branch_condition
        "".to_str # current_expect_ctx
        "".to_str # current_op_context
        empty_location # current_location
        List[BranchFrame]::new # branched_stacks
        false # has_return_types
        TypedStack::new # return_types
        List[Parameter]::new # parameters
        TypedStack::new # stack
        TypeChecker
    }

    fn assign_op_id self:mut$TypeChecker op:mut$Op {
        self.store.next_op_id = op.id
        1 += self.store.next_op_id
    }
}

fn resolve_numeric_literal_default type_value:$Type -> Type {
    if type_value.is_integer_literal_t then
        TYPE_I64_T clone_type return
    fi
    if type_value.is_float_literal_t then
        TYPE_F64_T clone_type return
    fi
    type_value match
        Type::Generic(generic) => {
            List[Type]::new = parameters
            for parameter in generic.params.iter do
                parameter resolve_numeric_literal_default parameters.push
            done
            parameters generic.base.clone GenericType Type::Generic
        }
        Type::Function(function_type) => {
            List[Type]::new = parameters
            for parameter in function_type.parameters.iter do
                parameter resolve_numeric_literal_default parameters.push
            done
            List[Type]::new = return_types
            for return_type in function_type.return_types.iter do
                return_type resolve_numeric_literal_default return_types.push
            done
            return_types parameters FunctionType Type::Function
        }
        _ => type_value clone_type
    end
}

impl Op {
    fn has_numeric_literal self:$Op -> bool {
        self.value match
            OpValue::PushInt(_) => true
            OpValue::PushFloat(_) => true
            OpValue::PushArray(items) => {
                for item in items.iter do
                    if item.has_numeric_literal then
                        true return
                    fi
                done
                false
            }
            OpValue::ExprGroup(items) => {
                for item in items.iter do
                    if item.has_numeric_literal then
                        true return
                    fi
                done
                false
            }
            _ => false
        end
    }

    fn resolve_array_literals
        self:mut$Op
        items:mut$List[Op]
        target:$Type
        diagnostics:mut$Diagnostics
    -> bool {
        target.as_generic = generic_option
        if generic_option.is_none then
            false return
        fi
        generic_option.unwrap = generic
        if ARRAY_TYPE generic.base.as_str != 2 generic.params.length != || then
            false return
        fi
        if target get_array_length_parameter Option::Some(target_length) is then
            if target_length.is_symbolic then
                self.location
                f"Array literal length {items.length} cannot satisfy constant parameter `{target_length.name}`"
                ErrorKind::TypeMismatch diagnostics.record_error_string
                false return
            fi
            if items.length i64::try_from.unwrap target_length.value != then
                self.location f"Array literal with {items.length} element(s) does not fit `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error_string
                false return
            fi
        fi
        true = valid
        0 generic.params.get = element_type
        0 (u64) = item_index
        while item_index items.length > do
            item_index items.get_mut = item
            1 += item_index
            if item.has_numeric_literal diagnostics element_type item.resolve_literal ! && then
                false = valid
            fi
        done
        if valid then
            target clone_type Option::Some self Op::set_type_hint
        fi
        valid
    }

    fn resolve_literal self:mut$Op target:$Type diagnostics:mut$Diagnostics -> bool {
        self.value match
            OpValue::PushInt(literal) => {
                if target.is_integer_type_t ! then
                    self.location f"Integer literal `{literal.raw}` requires an integer context, got `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error_string
                    false return
                fi
                if target literal.fits ! then
                    target.get_integer_min = minimum
                    target.get_integer_max = maximum
                    self.location f"Integer literal `{literal.raw}` is outside `{target.format}` range {minimum}..{maximum}" ErrorKind::TypeMismatch diagnostics.record_error_string
                    false return
                fi
                target clone_type Option::Some self Op::set_type_hint
                true
            }
            OpValue::PushFloat(value) => {
                if target.is_float_type_t ! then
                    self.location f"Floating-point literal `{value}` requires `f32` or `f64` context, got `{target.format}`" ErrorKind::TypeMismatch diagnostics.record_error_string
                    false return
                fi
                if
                    target TYPE_F32_T.eq value.to_f32.is_none &&
                    target TYPE_F64_T.eq value.to_f64.is_none && ||
                then
                    self.location f"Floating-point literal `{value}` is outside `{target.format}` finite range" ErrorKind::TypeMismatch diagnostics.record_error_string
                    false return
                fi
                target clone_type Option::Some self Op::set_type_hint
                true
            }
            OpValue::PushArray(items) => diagnostics target items self.resolve_array_literals
            _ => false
        end
    }
}

fn resolve_default_literals ops:mut$List[Op] diagnostics:mut$Diagnostics {
    0 (u64) = default_op_index
    while default_op_index ops.length > do
        default_op_index ops.get_mut = op
        1 += default_op_index
        op.value clone_op_value = op_value
        if op_value OpValue::PushInt is then
            op.type_hint.clone = target_opt
            target_opt match
                Option::Some(resolved_target) => diagnostics resolved_target op.resolve_literal drop
                Option::None => diagnostics TYPE_I64_T op.resolve_literal drop
            end
        elif op_value OpValue::PushFloat is then
            op.type_hint.clone = target_opt
            target_opt match
                Option::Some(resolved_target) => diagnostics resolved_target op.resolve_literal drop
                Option::None => diagnostics TYPE_F64_T op.resolve_literal drop
            end
        elif op_value OpValue::PushArray is then
            op.type_hint.clone = target_opt
            target_opt match
                Option::Some(resolved_target) => diagnostics resolved_target op.resolve_literal drop
                Option::None => {
                    if op_value OpValue::PushArray(items) is then
                        items clone_ops = owned_items
                        diagnostics owned_items resolve_default_literals
                        owned_items OpValue::PushArray op Op::set_value
                    fi
                }
            end
        elif op_value OpValue::ExprGroup(items) is then
            items clone_ops = owned_items
            diagnostics owned_items resolve_default_literals
            owned_items OpValue::ExprGroup op Op::set_value
        elif op_value OpValue::MatchArm(arm) is then
            arm.clone = resolved_arm
            diagnostics resolved_arm.guard_ops resolve_default_literals
            resolved_arm OpValue::MatchArm op Op::set_value
        fi
    done
}

fn apply_resolved_literal_hints ops:mut$List[Op] resolutions:$Map[i64 Type] {
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get_mut = op
        op.value clone_op_value = op_value
        if 0 op.id != then
            if op.id resolutions.get Option::Some(target) is then
                target clone_type = resolved_target
                if op_value OpValue::PushArray(items) is then
                    if target Type::Generic(generic) is then
                        if ARRAY_TYPE generic.base.as_str == 1 generic.params.length == && then
                            items.length 0 generic.params.get clone_type make_array_type = resolved_target
                        fi
                    fi
                fi
                resolved_target Option::Some op Op::set_type_hint
            fi
        fi
        if op_value OpValue::PushArray(items) is then
            items clone_ops = owned_items
            resolutions owned_items apply_resolved_literal_hints
            owned_items OpValue::PushArray op Op::set_value
        elif op_value OpValue::ExprGroup(items) is then
            items clone_ops = owned_items
            resolutions owned_items apply_resolved_literal_hints
            owned_items OpValue::ExprGroup op Op::set_value
        elif op_value OpValue::MatchArm(arm) is then
            arm.clone = resolved_arm
            resolutions resolved_arm.guard_ops apply_resolved_literal_hints
            resolved_arm OpValue::MatchArm op Op::set_value
        fi
        1 += op_index
    done
}

impl TypeChecker {
    fn within_param_cap tc:mut$TypeChecker -> bool {
        if tc.param_cap Option::Some(cap) is then
            cap tc.parameters.length < return
        fi
        true
    }
}
# Raise a TypeMismatch error at the type checker's current location.

impl TypeChecker {
    fn raise_type_mismatch tc:mut$TypeChecker message:String {
        tc.current_location message ErrorKind::TypeMismatch tc.diagnostics.record_error_string
    }
}

# ============================================================================
# Stack operations
# ============================================================================

impl TypeChecker {
    # A branch-local binding cannot identify the value after control-flow joins.
    # Transfer it to the branch result before the binding's scope is cleaned up.
    fn materialize_branch_results self:mut$TypeChecker before:$TypedStack {
        0 (u64) = index
        while
            index self
                .stack
                .values
                .length >
        do
            index self
                .stack
                .values
                .get clone_typed_value = value
            false = entered_branch
            if index before.values.length > then
                index before.values.get = before_value
                before_value value.same_owner_source = entered_branch
            fi
            if value.binding.is_some entered_branch ! && then
                value self.consume_value
                index self
                    .stack
                    .values
                    .get_mut
                    .clear_owner_source
            fi
            1 += index
        done
    }

    fn current_ownership_flow tc:mut$TypeChecker -> OwnershipFlow {
        List[String]::new = moved
        for name in tc.moved_owners.iter do
            if
                name.as_str tc
                    .scope
                    .lookup
                    .is_some
            then
                name.clone moved.push
            fi
        done
        Map[String List[String]]::new = loans
        for pair in tc.binding_origins.iter do
            if
                pair.first.as_str tc
                    .scope
                    .lookup
                    .is_some
            then
                pair.second.clone pair.first.clone loans.set
            fi
        done
        loans moved OwnershipFlow
    }

    fn restore_ownership_flow tc:mut$TypeChecker flow:$OwnershipFlow {
        flow.moved.clone = tc.moved_owners
        Map[String List[String]]::new = loans
        for pair in flow.loans.iter do
            pair.second.clone pair.first.clone loans.set
        done
        loans = tc.binding_origins
    }

    fn remove_flow_names tc:mut$TypeChecker names:$List[String] {
        for name in names.iter do
            false name.as_str tc.set_owner_moved
            if name.as_str tc.binding_origins.has_str then
                name.as_str tc.binding_origins.remove_str drop
            fi
        done
    }

    fn merge_current_ownership_flow tc:mut$TypeChecker flow:mut$OwnershipFlow {
        if tc.path_continues then
            tc.current_ownership_flow = current
            current flow.merge
        fi
    }

    fn report_loop_flow_difference
        tc:mut$TypeChecker
        expected:$OwnershipFlow
        local_names:$List[String]
        op:mut$Op
    {
        tc.current_ownership_flow = current
        for name in current.moved.iter do
            if
                name.as_str local_names string_list_contains !
                name.as_str expected.moved string_list_contains ! &&
            then
                op.location f"Loop back-edge does not restore ownership of `{name}`"
                ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
        for name in expected.moved.iter do
            if
                name.as_str local_names string_list_contains !
                name.as_str current.moved string_list_contains ! &&
            then
                op.location f"Loop back-edge changes ownership of `{name}`"
                ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
        for pair in current.loans.iter do
            if pair.first.as_str local_names string_list_contains then
                continue
            fi
            if pair.first.as_str tc.scope.lookup Option::Some(typ) is then
                if tc.store typ type_has_borrow ! then
                    continue
                fi
            fi
            false = same
            if pair.first expected.loans.get Option::Some(origins) is then
                pair.second.length origins.length == = same
                if same then
                    for origin in pair.second.iter do
                        if origin.as_str origins string_list_contains ! then
                            false = same
                        fi
                    done
                fi
            fi
            if same ! then
                op.location f"Loop back-edge changes loans for `{pair.first}`"
                ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
        for pair in expected.loans.iter do
            if pair.first.as_str tc.scope.lookup Option::Some(typ) is then
                if tc.store typ type_has_borrow ! then
                    continue
                fi
            fi
            if
                pair.first.as_str local_names string_list_contains !
                pair.first.as_str current.loans.has_str ! &&
            then
                op.location f"Loop back-edge does not restore loans for `{pair.first}`"
                ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
    }

    fn owner_is_moved tc:mut$TypeChecker name:$str -> bool {
        name tc.moved_owners string_list_contains
    }

    fn set_owner_moved tc:mut$TypeChecker name:$str moved:bool {
        name tc.moved_owners string_list_index = index
        if moved then
            if 0 index < then
                name.clone tc.moved_owners.push_str
            fi
            return
        fi
        if 0 index >= then
            tc.moved_owners.pop = last
            if tc.moved_owners.length index (u64) < then
                last index (u64) tc.moved_owners.set
            fi
        fi
    }

    fn use_binding tc:mut$TypeChecker name:$str {
        if name tc.remaining_uses.get_str Option::Some(count) is then
            if 0 count != then
                count 1 - name.clone tc.remaining_uses.set_str
            fi
        fi
    }

    fn binding_is_live tc:mut$TypeChecker name:$str -> bool {
        if name tc.remaining_uses.get_str Option::Some(count) is then
            0 count != return
        fi
        false
    }

    fn record_binding_origins tc:mut$TypeChecker name:$str origins:mut$Option[List[String]] {
        if origins Option::Some(items) is then
            items.clone name.clone tc.binding_origins.set_str
        elif name tc.binding_origins.has_str then
            name tc.binding_origins.remove_str drop
        fi
    }

    fn record_pattern_origins
        tc:mut$TypeChecker
        names:mut$List[String]
        origins:mut$Option[List[String]]
    {
        for name in names.iter do
            if name.as_str tc.scope.lookup Option::Some(typ) is then
                if
                    tc.store typ type_has_borrow
                    Option[Function]::None typ tc.type_is_duplicable ! ||
                then
                    origins name.as_str tc.record_binding_origins
                fi
            fi
        done
    }

    fn place_has_conflicting_loan
        self:mut$TypeChecker
        place:$str
        stack_depth:u64
        exclusive:bool
    -> bool {
        0 (u64) = index
        while index stack_depth > do
            index self
                .stack
                .values
                .get_mut = value
            if value.binding Option::Some(binding_name) is then
                if place binding_name.as_str == then
                    1 += index continue
                fi
            fi
            if value.place Option::Some(value_place) is then
                if place value_place.as_str == value.type_value.is_borrow exclusive ! || && then
                    1 += index
                    continue
                fi
            fi
            if value.capability ValueCapability::Owned is ! then
                if value.place Option::Some(value_place) is then
                    if
                        place value_place.as_str origin_matches_place
                        value.capability ValueCapability::Exclusive is exclusive || &&
                    then
                        true return
                    fi
                fi
            fi
            if value.origins Option::Some(origins) is then
                for origin in origins.iter do
                    if
                        place origin.as_str origin_matches_place
                        origin.as_str origin_is_exclusive exclusive || &&
                    then
                        true return
                    fi
                done
            fi
            1 += index
        done
        for
            binding_name in self
                .binding_origins
                .keys
                .iter
        do
            if
                place binding_name.as_str origin_matches_place
                binding_name.as_str self.binding_is_live ! ||
                binding_name.as_str self
                    .scope
                    .lookup
                    .is_none ||
            then
                continue
            fi
            if binding_name.as_str self.binding_origins.get_str Option::Some(origins) is then
                for origin in origins.iter do
                    if
                        place origin.as_str origin_matches_place
                        origin.as_str origin_is_exclusive exclusive || &&
                    then
                        true return
                    fi
                done
            fi
        done
        for frame in self.branched_stacks.iter do
            if frame BranchFrame::BranchWhile(while_ctx) is then
                for
                    pair in while_ctx
                        .flow_before
                        .loans
                        .iter
                do
                    if
                        place pair.first.as_str origin_matches_place
                        pair.first.as_str self
                            .scope
                            .lookup
                            .is_none ||
                    then
                        continue
                    fi
                    for origin in pair.second.iter do
                        if
                            place origin.as_str origin_matches_place
                            origin.as_str origin_is_exclusive exclusive || &&
                        then
                            true return
                        fi
                    done
                done
            fi
        done
        false
    }

    fn has_active_owner_loan self:mut$TypeChecker owner:$str stack_depth:u64 -> bool {
        true stack_depth owner self.place_has_conflicting_loan
    }

    fn type_is_duplicable tc:mut$TypeChecker typ:$Type function_opt:mut$Option[Function] -> bool {
        if typ.is_shared_borrow then
            true return
        fi
        if typ.is_exclusive_borrow then
            false return
        fi
        if typ Type::Builtin(builtin) is then
            true return
        fi
        if typ Type::Function(_) is then
            false return
        fi
        if typ.has_unresolved_type_var then
            "Copy".to_str GenericType::new Type::Generic = unresolved_copy_type
            if tc.store function_opt unresolved_copy_type typ matches_trait_bound then
                true return
            fi
            tc.store unresolved_copy_type typ type_has_satisfying_trait_impl return
        fi
        typ.format = type_name
        if
            type_name tc
                .store
                .copy_types
                .get Option::Some(cached) is
        then
            cached.clone return
        fi
        "Copy".to_str GenericType::new Type::Generic = copy_type
        tc.store function_opt copy_type typ matches_trait_bound = is_copy
        if is_copy ! then
            tc.store copy_type typ type_has_satisfying_trait_impl = is_copy
        fi
        is_copy type_name tc
            .store
            .copy_types
            .set
        is_copy
    }

    fn record_owner_assignment
        tc:mut$TypeChecker
        op:mut$Op
        name:$str
        typ:$Type
        function_opt:mut$Option[Function]
        is_global:bool
    {
        if is_global function_opt.is_some && then
            return
        fi
        if function_opt Option::Some(function) is then
            if name function.captures variable_list_contains then
                return
            fi
        fi
        if typ.is_borrow function_opt typ tc.type_is_duplicable || then
            return
        fi
        if tc.store typ type_needs_destruction_in_store ! then
            return
        fi
        1 += tc.next_owner_generation
        tc.next_owner_generation typ name OwnerEvent::new = event
        event.clone op tc.store add_owner_assignment
        event tc.owner_events.push
    }

    fn owner_cleanups_for_names tc:mut$TypeChecker names:mut$List[String] -> List[OwnerEvent] {
        List[OwnerEvent]::new = cleanups
        tc.owner_events.length = event_index
        while 0 event_index != do
            1 -= event_index
            event_index tc.owner_events.get = event
            if event.name.as_str names string_list_contains then
                event.clone cleanups.push
            fi
        done
        cleanups
    }

    fn remove_owner_events_for_names tc:mut$TypeChecker names:mut$List[String] {
        List[OwnerEvent]::new = remaining
        tc.owner_events.reverse
        while tc.owner_events.is_empty ! do
            tc.owner_events.pop = event
            if event.name.as_str names string_list_contains ! then
                event remaining.push
            fi
        done
        remaining = tc.owner_events
    }

    fn attach_owner_cleanups tc:mut$TypeChecker op:mut$Op names:mut$List[String] remove:bool {
        names tc.owner_cleanups_for_names = cleanups
        cleanups.reverse
        while cleanups.is_empty ! do
            cleanups.pop op tc.store add_owner_cleanup
        done
        if remove then
            names tc.remove_owner_events_for_names
        fi
    }

    fn attach_scope_cleanups tc:mut$TypeChecker op:mut$Op {
        tc.scope.current_names = names
        true names op tc.attach_owner_cleanups
    }

    fn attach_all_owner_cleanups tc:mut$TypeChecker op:mut$Op {
        tc.owner_events.length = event_index
        while 0 event_index != do
            1 -= event_index
            event_index tc
                .owner_events
                .get
                .clone op tc.store add_owner_cleanup
        done
    }

    fn stack_push_type tc:mut$TypeChecker type_value:$Type {
        false Option[List[String]]::None Option[i64]::None Option[String]::None
        type_value type_capability Option[String]::None
        List[LiteralRef]::new tc.current_location.clone type_value clone_type TypedValue
        tc
            .stack
            .values
            .push
    }

    fn stack_push_binding
        tc:mut$TypeChecker
        type_value:$Type
        name:$str
        op:mut$Op
        function_opt:mut$Option[Function]
    {
        Option[String]::None = binding
        Option[i64]::None = source
        type_value clone_type = stack_type
        type_value type_capability = capability
        type_value.borrow_target = target_opt
        target_opt match
            Option::Some(target) => {
                if function_opt target tc.type_is_duplicable then
                    target = stack_type
                fi
            }
            Option::None => {
            }
        end
        if
            type_value.is_borrow !
            function_opt type_value tc.type_is_duplicable ! &&
        then
            if name.as_str tc.owner_is_moved then
                op.location f"Owner `{name}` was already moved" ErrorKind::InvalidVariable
                tc.diagnostics.record_error_string
            fi
            name.to_str Option::Some = binding
            op.id Option::Some = source
        fi
        name.to_str Option::Some = place
        Option[List[String]]::None = origins
        if name tc.binding_origins.get_str Option::Some(stored) is then
            stored.clone Option::Some = origins
            if tc.store type_value type_has_borrow ! then
                ValueCapability::Shared = capability
                for origin in stored.iter do
                    if origin.as_str origin_is_exclusive then
                        ValueCapability::Exclusive = capability
                        break
                    fi
                done
                Option[String]::None = binding
                Option[i64]::None = source
            fi
        fi
        false origins source binding capability place
        List[LiteralRef]::new tc.current_location.clone stack_type
        TypedValue
        tc
            .stack
            .values
            .push
    }

    fn stack_push_literal tc:mut$TypeChecker type_value:$Type op:mut$Op {
        false = is_integer
        0 = integer_value
        if op.value OpValue::PushInt(integer) is then
            true = is_integer
            integer.value = integer_value
        fi
        List[LiteralRef]::new = literals
        is_integer integer_value op.id LiteralRef literals.push
        true Option[List[String]]::None Option[i64]::None Option[String]::None
        ValueCapability::Owned Option[String]::None literals
        tc.current_location.clone type_value clone_type TypedValue
        tc
            .stack
            .values
            .push
    }

    fn stack_push_global tc:mut$TypeChecker type_value:$Type name:$str in_function:bool {
        if Option[Function]::None type_value tc.type_is_duplicable then
            type_value tc.stack_push_type return
        fi
        if in_function then
            ValueCapability::Shared
        else
            ValueCapability::Exclusive
        fi = capability
        if type_value.is_borrow then
            type_value type_capability = capability
        fi
        false Option[List[String]]::None Option[i64]::None Option[String]::None
        capability name.to_str Option::Some List[LiteralRef]::new
        tc.current_location.clone type_value clone_type TypedValue tc
            .stack
            .values
            .push
    }
}

fn borrow_argument_matches expected:$Type actual:$Type store:$SymbolStore -> bool {
    if expected.borrow_target Option::Some(expected_target) is then
        if expected.is_exclusive_borrow actual.is_shared_borrow && then
            false return
        fi
        actual clone_type = actual_target
        if actual.borrow_target Option::Some(borrowed_target) is then
            borrowed_target clone_type = actual_target
        fi
        store actual_target expected_target unify_type_t.is_some return
    fi
    false
}

fn borrowed_copy_argument_matches tc:mut$TypeChecker expected:$Type actual:$Type -> bool {
    if actual.borrow_target Option::Some(target) is then
        if tc.store target expected unify_type_t.is_none then
            false return
        fi
        Option[Function]::None target tc.type_is_duplicable return
    fi
    false
}

fn stack_effect_may_borrow effect:$StackEffect -> bool {
    for parameter in effect.parameters.iter do
        if parameter.typ.is_borrow parameter.typ Type::TypeVar is || then
            true return
        fi
    done
    false
}

impl TypeChecker {
    fn consume_value tc:mut$TypeChecker value:$TypedValue {
        if
            value.capability ValueCapability::Owned is !
            value.type_value.is_borrow ! &&
        then
            if value.place Option::Some(place) is then
                tc.current_location f"Cannot move borrowed value `{place}` of type `{value.type_value.format}` in `{tc.current_op_context}`; clone it first"
                ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            else
                tc.current_location "Cannot move a borrowed value; clone it first"
                ErrorKind::InvalidVariable tc.diagnostics.record_error
            fi
            return
        fi
        if value.binding Option::Some(name) is then
            if name.as_str tc.owner_is_moved then
                tc.current_location f"Owner `{name}` was already moved"
                ErrorKind::InvalidVariable tc.diagnostics.record_error_string
                return
            fi
            if
                tc
                    .stack
                    .values
                    .length name.as_str tc.has_active_owner_loan
            then
                tc.current_location f"Cannot move owner `{name}` while it is borrowed"
                ErrorKind::InvalidVariable tc.diagnostics.record_error_string
                return
            fi
            true name.as_str tc.set_owner_moved
            if value.source Option::Some(source_op) is then
                source_op tc.store set_moves_owner
            fi
        fi
    }

    fn release_value tc:mut$TypeChecker value:$TypedValue {
        if value.binding Option::Some(name) is then
            if name.as_str tc.owner_is_moved then
                tc.current_location f"Owner `{name}` was already moved"
                ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        fi
    }

    # Finish a stack use. Owned values move; borrowed values are released.
    fn finish_value_use self:mut$TypeChecker value:$TypedValue {
        if value.capability ValueCapability::Owned is then
            value self.consume_value
        else
            value self.release_value
        fi
    }
}

impl TypeChecker {
    fn report_stack_underflow tc:mut$TypeChecker message:String {
        if tc.underflow_reported_this_op then
            return
        fi
        tc.current_location message ErrorKind::StackUnderflow tc.diagnostics.record_error_string
        true = tc.underflow_reported_this_op
    }
}

impl TypeChecker {
    fn stack_underflow_message tc:mut$TypeChecker -> String {
        tc.current_expect_ctx = expect_what: $String
        if "" expect_what.as_str == then
            "Stack underflow: expected a value but stack is empty".to_str return
        fi
        f"Stack underflow: expected {expect_what} but stack is empty"
    }
}

impl TypeChecker {
    fn stack_peek_type tc:mut$TypeChecker -> Type {
        if
            0 tc
                .stack
                .values
                .length ==
        then
            if tc.within_param_cap then
                TYPE_UNKNOWN_T clone_type return
            fi
            tc.stack_underflow_message tc.report_stack_underflow
            TYPE_MISSING_T clone_type return
        fi
        tc
            .stack
            .values
            .length 1 - = top
        top tc
            .stack
            .values
            .get clone_typed_value = value
        if 0 value.literals.length != then
            value.type_value resolve_numeric_literal_default = resolved
            tc.literal_resolutions tc.diagnostics resolved value.resolve_literals drop
            false = value.is_literal_constant
            List[LiteralRef]::new = value.literals
            resolved clone_type = value.type_value
            value top tc
                .stack
                .values
                .set
            resolved return
        fi
        value.type_value clone_type
    }
}

impl TypeChecker {
    fn stack_pop_value tc:mut$TypeChecker -> TypedValue {
        if
            0 tc
                .stack
                .values
                .length ==
        then
            if tc.within_param_cap then
                TYPE_UNKNOWN_T Parameter::new tc.parameters.push
                false Option[List[String]]::None Option[i64]::None Option[String]::None
                ValueCapability::Owned Option[String]::None
                List[LiteralRef]::new empty_location TYPE_UNKNOWN_T clone_type TypedValue return
            fi
            tc.stack_underflow_message tc.report_stack_underflow
            false Option[List[String]]::None Option[i64]::None Option[String]::None
            ValueCapability::Owned Option[String]::None
            List[LiteralRef]::new empty_location TYPE_MISSING_T clone_type TypedValue return
        fi
        tc
            .stack
            .values
            .pop
    }

    fn stack_pop_type tc:mut$TypeChecker -> Type {
        tc.stack_pop_value = value
