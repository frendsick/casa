    fn check_function_ops
        tc:mut$TypeChecker
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    -> u64 {
        op.value = fn_value
        if fn_value OpValue::FnCall(fn_name) is then
            fn_name tc.store.functions.get = fn_opt
            if fn_opt.is_some then
                fn_opt.unwrap = function
                if function.is_unsafe then fn_name op tc.require_unsafe fi
                tc.diagnostics tc.store function ensure_typechecked
                tc.store function_opt Option[Type]::None fn_value
                analyze_operation = semantics
                if semantics.stack_effect Option::None is then op_index return fi
                semantics.stack_effect.unwrap = effect
