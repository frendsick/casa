                function_opt.is_none = is_global
                is_global name.as_str tc.scope.assign
                if function_opt std::Option::Some(function) is then
                    owner_type common::clone_type name.clone common::Variable function.variables.push
                else
                    owner_type common::clone_type name.clone common::Variable = variable
                    variable name.clone tc
                        .store
                        .variables
                        .set
                fi
                false name.as_str tc.set_owner_moved

                leading_values parameter_index + = depth
