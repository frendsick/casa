# Typechecking phase orchestration.
import "std" as std
import "common" as common
import "binding" as binding
import "error" as error
import "semantics" as semantics
import "semantic_body" as semantic_body
import "bindings" as bindings
import "source_body" as source_body

pub struct TypecheckResult {
    store:               common::SymbolStore
    global_stack_effect: common::StackEffect
    root:                semantics::AnalysisBody
    bodies:              std::Map[std::String semantics::AnalysisBody]
    diagnostics:         error::Diagnostics
    verified_operations: std::Set[i64]
    binding_store:       binding::BindingStore
}

# Only this module can construct backend input. Bodies and their declarations transfer together.
pub struct CheckedProgram {
    store:   common::SymbolStore
    root:    semantic_body::Body
    bodies:  std::Map[std::String semantic_body::Body]
    types:   std::Map[std::String CheckedType]
    externs: std::Map[std::String CheckedExtern]
}

# Concrete source signature retained independently of physical ABI decisions.
pub struct CheckedExtern {
    pub symbol:   std::String
    pub effect:   common::StackEffect
    pub location: common::Location
}

impl CheckedProgram {
    pub fn get_externs self:$CheckedProgram -> $std::Map[std::String CheckedExtern] { self.externs }

    pub fn is_copy_aggregate self:$CheckedProgram typ:$common::Type -> bool {
        typ.format = key
        key self
            .types
            .get
            .unwrap
            .copy_aggregate
    }
    pub fn has_plain_storage self:$CheckedProgram typ:$common::Type -> bool {
        typ.format = key
        key self
            .types
            .get
            .unwrap
            .plain_storage
    }
    pub fn needs_destruction self:$CheckedProgram typ:$common::Type -> bool {
        typ.format = key
        key self
            .types
            .get
            .unwrap
            .needs_destruction
    }
    pub fn find_drop_function self:$CheckedProgram typ:$common::Type -> std::Option[std::String] {
        typ.format = key
        key self
            .types
            .get
            .unwrap
            .drop_function
            .clone
    }
    pub fn get_shape self:$CheckedProgram typ:$common::Type -> CheckedShape {
        typ.format = key
        key self
            .types
            .get
            .unwrap
            .shape copy
    }
    pub fn get_value_kind self:$CheckedProgram typ:$common::Type -> CheckedValueKind {
        typ.format = key
        key self
            .types
            .get
            .unwrap
            .value_kind copy
    }
    pub fn get_store self:$CheckedProgram -> $common::SymbolStore { self.store }
    pub fn get_function_names self:$CheckedProgram -> std::List[std::String] { self.bodies.keys }
    pub fn get_root self:$CheckedProgram -> $semantic_body::Body { self.root }

    pub fn find_body self:$CheckedProgram name:$str -> std::Option[$semantic_body::Body] {
        name self.bodies.get_str
    }
}

impl TypecheckResult {
    pub fn get_store self:$TypecheckResult -> $common::SymbolStore { self.store }
    pub fn get_effect self:$TypecheckResult -> $common::StackEffect { self.global_stack_effect }
    pub fn get_diagnostics self:$TypecheckResult -> $error::Diagnostics { self.diagnostics }
    pub fn with_source_diagnostics
        self:TypecheckResult
        diagnostics:error::Diagnostics
    -> TypecheckResult {
        self match
            TypecheckResult { store: store global_stack_effect: effect root: root bodies: bodies diagnostics: checked verified_operations: verified binding_store: bindings } => {
                checked diagnostics.merge
                bindings verified diagnostics bodies root effect store TypecheckResult
            }
        end
    }

    pub fn get_root self:$TypecheckResult -> $semantics::AnalysisBody { self.root }

    pub fn find_body self:$TypecheckResult name:$str -> std::Option[$semantics::AnalysisBody] {
        name self.bodies.get_str
    }

    pub fn into_analysis_parts
        self:TypecheckResult
    -> common::SymbolStore semantics::AnalysisBody std::Map[std::String semantics::AnalysisBody] std::Set[i64] binding::BindingStore {
        self match
            TypecheckResult { store: store root: root bodies: bodies verified_operations: verified binding_store: bindings } => store root bodies verified bindings
        end
    }

    pub fn into_checked_program self:TypecheckResult -> std::Result[CheckedProgram std::String] {
        self match
            TypecheckResult { store: store root: root bodies: bodies diagnostics: diagnostics } => {
                if diagnostics.has_errors then
                    "Backend input requires error-free checking".to_str std::Result::Error return
                fi
                bodies root store commit_checked_program
            }
        end
    }
}

fn collect_drop_dependencies
    typ:$common::Type
    store:$common::SymbolStore
    callees:mut$std::List[std::String]
    visited:mut$std::Set[std::String]
-> std::Result[bool std::String] {
    typ semantic_body::validate_type ? drop
    if typ.is_borrow then
        true std::Result::Ok return
    fi
    typ.format = key
    if key visited.has then
        true std::Result::Ok return
    fi
    key visited.add
    if store typ common::find_drop_function_name std::Option::Some(name) is then
        name.as_str store.get_function.unwrap = declaration
        if
            declaration
                .stack_effect
                .type_vars
                .is_empty ! declaration
                .stack_effect
                .const_params
                .length 0 != ||
        then
            declaration typ semantics::function_receiver_bindings = substitutions
            substitutions name.as_str semantics::monomorphized_function_name callees.push
        else
            name.clone callees.push
        fi
    fi
    typ match
        common::Type::Generic(generic) => generic
        _ => true std::Result::Ok return
    end = generic
    if common::ARRAY_TYPE generic.base.as_str == then
        if generic.params.is_empty ! then
            visited callees store 0 generic.params.get collect_drop_dependencies ? drop
        fi
    elif generic.base.as_str store.structs.get_str std::Option::Some(shape) is then
        shape.type_vars typ common::aggregate_type_bindings = substitutions
        for member in shape.members.iter do
            substitutions member.typ.substitute_t = child_type
            visited callees store child_type collect_drop_dependencies ? drop
        done
    elif generic.base.as_str store.enums.get_str std::Option::Some(shape) is then
        shape.type_vars typ common::aggregate_type_bindings = substitutions
        for variant in shape.variant_types.iter do
            for member in variant.second.iter do
                substitutions member.substitute_t = child_type
                visited callees store child_type collect_drop_dependencies ? drop
            done
        done
    fi
    true std::Result::Ok
}

fn validate_concrete_body
    body:$semantic_body::Body
    store:$common::SymbolStore
    callees:mut$std::List[std::String]
    drop_types:mut$std::Set[std::String]
    owner:$str
-> std::Result[bool std::String] {
    std::List[common::Type]::new = drops
    std::List[common::Variable]::new = empty_variables
    if owner store.get_function std::Option::Some(declaration) is then
        declaration.captures declaration.variables store semantic_body::BodyReferences::new = references
        references drops callees body.validate_concrete ? drop
    else
        store.variables.values = root_variables
        empty_variables root_variables store semantic_body::BodyReferences::new = references
        references drops callees body.validate_concrete ? drop
    fi
    for typ in drops.iter do
        drop_types callees store typ collect_drop_dependencies ? drop
    done
    true std::Result::Ok
}

fn prepare_body_storage
    function:mut$common::Function
    body:$semantic_body::Body
-> std::Result[bool std::String] {
    function.variables body.collect_storage_variables = locals
    for variable in locals.iter do
        variable.typ semantic_body::validate_type ? drop
    done
    locals = function.variables
    true std::Result::Ok
}

fn commit_checked_program
    store:common::SymbolStore
    root_analysis:semantics::AnalysisBody
    available:std::Map[std::String semantics::AnalysisBody]
-> std::Result[CheckedProgram std::String] {
    std::Map[std::String semantic_body::Body]::new = bodies
    std::List[std::String]::new = callees
    std::Set[std::String]::new = drop_types
    std::Set[std::String]::new = visited
    std::Map[std::String CheckedExtern]::new = externs
    root_analysis.into_checked ? = root
    store.variables.values = declarations
    declarations root.collect_storage_variables = root_variables
    std::Map[std::String common::Variable]::new = variables
    for variable in root_variables.iter do
        variable.typ semantic_body::validate_type ? drop
        variable.clone variable.name.clone variables.set
    done
    variables = store.variables
    common::GLOBAL_SCOPE_LABEL drop_types callees store root validate_concrete_body ? drop
    while callees.is_empty ! do
        callees.pop = name
        if name visited.has then
            continue
        fi
        name.clone visited.add
        name.as_str store.get_function match
            std::Option::Some(declaration) => {
                declaration.stack_effect semantic_body::validate_effect ? drop
                if declaration.extern_symbol std::Option::Some(symbol) is then
                    declaration.location.clone declaration.stack_effect.clone symbol.clone
                    CheckedExtern name.clone externs.set
                    continue
                fi
            }
            std::Option::None => f"Missing checked function `{name}`" std::Result::Error return
        end
        name.as_str available.remove_str match
            std::Option::Some(body) => body.into_checked ?
            std::Option::None => f"Missing checked body `{name}`" std::Result::Error return
        end = body
        body name.as_str store.get_function_mut.unwrap prepare_body_storage ? drop
        name.as_str store.get_function.unwrap = declaration
        for capture in declaration.captures.iter do
            capture.typ semantic_body::validate_type ? drop
            drop_types callees store capture.typ collect_drop_dependencies ? drop
        done
        name.as_str drop_types callees store body validate_concrete_body ? drop
        body name bodies.set
    done
    std::Map[std::String CheckedType]::new = types
    types store root commit_body_type_facts
    for variable in store.variables.iter do
        types store variable.second.typ commit_type_facts
    done
    for body in bodies.iter do
        types store body.second commit_body_type_facts
        body.first.as_str store.get_function.unwrap = typed_declaration
        for variable in typed_declaration.variables.iter do
            types store variable.typ commit_type_facts
        done
        for capture in typed_declaration.captures.iter do
            types store capture.typ commit_type_facts
        done
    done
    externs types bodies root store CheckedProgram std::Result::Ok
}

pub fn type_check source:source_body::SourceProgram -> TypecheckResult {
    { drop } source type_check_with_progress
}

pub fn type_check_with_progress
    source:source_body::SourceProgram
    log_progress:$fn[str]
-> TypecheckResult {
    error::Diagnostics::new = diagnostics
    source.into_parts = source_bodies = source_root = store
    "Checking extern declarations" log_progress exec
    diagnostics store semantics::validate_extern_structs
    diagnostics store semantics::validate_extern_functions
    store.get_function_names = function_names
    source_bodies source_root store source_body::SourceProgram::new semantics::SemanticSession::from_source = root_body = semantic_session
    "Checking root types and ownership" log_progress exec
    semantic_session root_body semantics::analyze_source_root_semantics match
        semantics::FunctionSemantics { operations: operations inferred_effect: effect diagnostics: root_diagnostics } => {
            root_diagnostics diagnostics.merge
            effect operations
        }
    end = checked_ops = global_stack_effect
    "Checking function types and ownership" log_progress exec
    diagnostics semantic_session function_names schedule_functions
    "Validating declarations" log_progress exec
    diagnostics semantic_session.validate_checked_declarations
    if diagnostics.has_errors ! then
        "Specializing reachable functions" log_progress exec
    fi
    diagnostics checked_ops semantic_session.finish = bindings = verified = bodies = root = checked_store
    bindings verified diagnostics bodies root global_stack_effect checked_store TypecheckResult
}

pub fn check_ops
    ops:mut$std::List[common::Op]
    function_opt:mut$std::Option[common::Function]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    bodies:$std::Map[std::String source_body::SourceBody]
    require_empty_final_stack:bool
-> common::StackEffect {
    require_empty_final_stack bodies diagnostics store function_opt ops semantics::check_ops
}

fn schedule_functions
    function_names:$std::List[std::String]
    semantic_session:mut$semantics::SemanticSession
    diagnostics:mut$error::Diagnostics
{
    for function_name in function_names.iter do
        diagnostics function_name.as_str semantic_session.check_declared_function
    done
}

pub fn type_satisfies_trait
    typ:$common::Type
    trait_type:$common::Type
    function_opt:mut$std::Option[common::Function]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    bodies:$std::Map[std::String source_body::SourceBody]
-> bool {
    bodies diagnostics store function_opt trait_type typ semantics::type_satisfies_trait
}

pub fn method_receiver_type effect:$common::StackEffect -> std::Option[common::Type] {
    effect semantics::method_receiver_type
}

pub fn resolve_numeric_literal_default type_value:$common::Type -> common::Type {
    type_value semantics::resolve_numeric_literal_default
}

pub fn monomorphized_function_name
    function_name:$str
    bindings:$std::Map[std::String common::Type]
-> std::String {
    bindings function_name semantics::monomorphized_function_name
}

pub fn function_receiver_bindings
    typ:$common::Type
    function:$common::Function
-> std::Map[std::String common::Type] {
    function typ semantics::function_receiver_bindings
}

pub enum CheckedValueKind derives std::Copy {
    Scalar
    Enum
    StringStr
    StrString
    Other
}

pub enum CheckedShape derives std::Copy {
    Scalar
    Borrow
    Closure
    Array
    Struct
    Enum
}

pub struct CheckedType {
    pub plain_storage:     bool
    pub shape:             CheckedShape
    pub copy_aggregate:    bool
    pub needs_destruction: bool
    pub drop_function:     std::Option[std::String]
    pub value_kind:        CheckedValueKind
}

# Direct fields still need their own destruction when they own storage or a hook.
fn has_plain_variant_fields
    members:$std::List[common::Type]
    substitutions:$std::Map[std::String common::Type]
    store:$common::SymbolStore
-> bool {
    for member in members.iter do
        substitutions member.substitute_t = child
        if store child common::type_needs_destruction_in_store then
            false return
        fi
    done
    true
}

fn has_plain_fields typ:$common::Type store:$common::SymbolStore -> bool {
    typ match
        common::Type::Generic(generic) => generic
        _ => false return
    end = generic
    if generic.base store.structs.get std::Option::Some(shape) is then
        shape.type_vars typ common::aggregate_type_bindings = substitutions
        for member in shape.members.iter do
            substitutions member.typ.substitute_t = child
            if store child common::type_needs_destruction_in_store then
                false return
            fi
        done
        true return
    fi
    if generic.base store.enums.get std::Option::Some(shape) is then
        shape.type_vars typ common::aggregate_type_bindings = substitutions
        for variant in shape.variant_types.iter do
            if store substitutions variant.second has_plain_variant_fields ! then
                false return
            fi
        done
        true return
    fi
    false
}

fn commit_type_facts
    typ:$common::Type
    store:$common::SymbolStore
    types:mut$std::Map[std::String CheckedType]
{
    typ.format = key
    if key types.has then
        return
    fi
    CheckedValueKind::Other = kind
    if typ common::Type::Builtin(builtin) is then
        CheckedValueKind::Scalar = kind
    elif key.as_str "StringStrEq" == then
        CheckedValueKind::StringStr = kind
    elif key.as_str "StrStringEq" == then
        CheckedValueKind::StrString = kind
    elif key store.enums.has then
        CheckedValueKind::Enum = kind
    fi
    false = copy_aggregate
    if typ common::get_concrete_array_length.is_some store typ common::type_is_extern_struct || then
        common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
        store copy_type typ semantics::type_has_satisfying_trait_impl = copy_aggregate
    fi
    std::Option[std::String]::None = drop_function
    if store typ common::find_drop_function_name std::Option::Some(name) is then
        name.as_str store.get_function.unwrap = declaration
        if
            declaration
                .stack_effect
                .type_vars
                .is_empty ! declaration
                .stack_effect
                .const_params
                .length 0 != ||
        then
            declaration typ semantics::function_receiver_bindings = substitutions
            substitutions name.as_str semantics::monomorphized_function_name std::Option::Some = drop_function
        else
            name.clone std::Option::Some = drop_function
        fi
    fi
    store typ common::type_needs_destruction_in_store = needs_destruction
    CheckedShape::Scalar = shape_kind
    if typ.is_borrow then
        CheckedShape::Borrow = shape_kind
    elif typ common::Type::Function(_) is then
        CheckedShape::Closure = shape_kind
    elif typ common::Type::Generic(generic) is then
        if generic.base.as_str common::ARRAY_TYPE == then
            CheckedShape::Array = shape_kind
        elif generic.base store.structs.has then
            CheckedShape::Struct = shape_kind
        elif generic.base store.enums.has then
            CheckedShape::Enum = shape_kind
        fi
    fi
    false = plain_storage
    if needs_destruction copy_aggregate ! && then
        if store typ common::type_value_representation std::Option::Some(representation) is then
            if common::VALUE_REPR_INDIRECT representation == then
                store typ has_plain_fields = plain_storage
            fi
        fi
    fi
    kind drop_function needs_destruction copy_aggregate shape_kind plain_storage CheckedType key types.set
    if typ common::Type::Generic(generic) is then
        types store typ generic commit_child_type_facts
    fi
}

fn commit_child_type_facts
    generic:$common::GenericType
    typ:$common::Type
    store:$common::SymbolStore
    types:mut$std::Map[std::String CheckedType]
{
    for parameter in generic.params.iter do
        types store parameter commit_type_facts
    done
    if generic.base store.structs.get std::Option::Some(shape) is then
        shape.type_vars typ common::aggregate_type_bindings = substitutions
        for member in shape.members.iter do
            substitutions member.typ.substitute_t = child_type
            types store child_type commit_type_facts
        done
    elif generic.base store.enums.get std::Option::Some(shape) is then
        shape.type_vars typ common::aggregate_type_bindings = substitutions
        for variant in shape.variant_types.iter do
            for member in variant.second.iter do
                substitutions member.substitute_t = child_type
                types store child_type commit_type_facts
            done
        done
    fi
}

fn commit_body_type_facts
    body:$semantic_body::Body
    store:$common::SymbolStore
    types:mut$std::Map[std::String CheckedType]
{
    { = typ: $common::Type types store typ commit_type_facts } = visitor
    visitor body.visit_types
}
