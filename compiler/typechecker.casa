pub fn check_functions store:mut$common::SymbolStore diagnostics:mut$error::Diagnostics {
    store.get_function_names = function_names
    for func_name in function_names.iter do
        func_name.as_str store.get_function.unwrap = current_fn_ref
        if current_fn_ref common::Function::is_typechecked then
            continue
        fi
        if func_name.as_str "lambda__" str::starts_with then
            continue
        fi
        func_name.as_str store.take_function_for_typecheck.unwrap = current_fn
        current_fn.split_body = current_ops = current_fn
        diagnostics current_fn current_ops store syntax::resolve_identifiers
        diagnostics.error_count = errors_before
        current_fn std::Option::Some = current_fn_opt
        diagnostics store current_fn_opt current_ops check_ops = inferred_stack_effect
        current_fn_opt.unwrap = current_fn
        current_ops current_fn common::Function::set_ops
        diagnostics.error_count errors_before < = had_errors
        if had_errors then
            current_fn store.restore_function
            continue
        fi
        current_fn common::Function::stack_effect common::stack_effect_to_str = effect_text
        if effect_text.as_str "None -> None" == then
            std::Map[std::String common::StackEffect]::new = inferred_effects
            store inferred_effects current_fn semantics::analyze_function_semantics
            = semantics
            semantics.inferred_effect.clone current_fn common::Function::set_stack_effect
        fi
        current_fn store.restore_function
    done
}

pub fn check_trait_impls store:mut$common::SymbolStore diagnostics:mut$error::Diagnostics {
    for
        trait_impl in store
            .trait_impls
            .values
            .iter
    do
        trait_impl.trait_bound common::trait_bound_to_type = trait_type
        std::Set[std::String]::new = checked_methods
        true = valid
        trait_type store semantics::collect_trait_method_candidates = candidates
        for candidate in candidates.iter do
            candidate
                .method
                .name
                .clone = method_name
            if method_name checked_methods.has then
                continue
            fi
            method_name.clone checked_methods.add
            std::Option[std::String]::None = function_name_opt
            if method_name trait_impl.methods.get std::Option::Some(function_name) is then
                function_name.clone std::Option::Some = function_name_opt
            fi
            if function_name_opt.is_none then
                store trait_impl.receiver method_name.as_str semantics::find_semantic_method_function = function_name_opt
            fi
            if function_name_opt std::Option::Some(function_name) is then
                diagnostics store function_name.as_str ensure_typechecked = function_opt
                if function_opt.is_none then
                    false = valid continue
                fi
                function_opt.unwrap = implementation
                trait_impl.receiver candidate.effect common::resolve_trait_stack_effect = expected
                if true implementation.stack_effect expected trait_method_effects_match ! then
                    false = valid
                fi
            elif store trait_type method_name.as_str semantics::find_trait_default_method.is_none then
                false = valid
            fi
        done
        if valid ! then
            trait_impl.location f"Trait implementation `{trait_impl.receiver.format}: {trait_type.format}` does not satisfy the trait requirements" common::ErrorKind::TraitSignatureMismatch diagnostics.record_error_string
        fi
    done
}

pub fn generic_binding_key bindings:$std::Map[std::String common::Type] -> std::String {
