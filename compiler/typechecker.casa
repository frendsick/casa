            hidden_name.clone OpValue::AssignVar op Op::set_value
            function_opt op_index ops op checker.check_assignment
            hidden_name.clone OpValue::Question op Op::set_value

            return_type hidden_name.clone op.location.clone op_index ops lower_question_operations
        fi
    }

    fn consume_question_owner checker:mut$TypeChecker op:mut$Op {
