impl TypeChecker {
    pub fn expect_value_type_t self:mut$TypeChecker expected:$common::Type et_value:mut$TypedValue {
        if expected.is_borrow then
            et_value self.release_value
        elif et_value.type_value expected self borrowed_copy_argument_matches then
            et_value self.release_value
        else
            et_value self.consume_value
        fi
        if 0 et_value.literals.length != then
            if expected.is_unknown_placeholder expected.has_unresolved_type_var || then
                et_value.type_value resolve_numeric_literal_default = literal_default
                self.literal_resolutions self.diagnostics literal_default et_value.resolve_literals drop
                return
            fi
            if self.literal_resolutions self.diagnostics expected et_value.resolve_literals then
                return
            fi
        fi
        et_value.type_value = et_actual_t: $common::Type
        if
            expected.is_exclusive_borrow
            et_actual_t.is_shared_borrow et_value.capability ValueCapability::Shared is || && !
        then
            if self.store et_actual_t expected borrow_argument_matches then
                return
            fi
            if et_actual_t expected self borrowed_copy_argument_matches then
                return
            fi
            if self.store et_actual_t expected semantics::unify_type_t.is_some then
                return
            fi
        fi
        et_actual_t.format = et_actual
        expected.format = et_expected
        "Type mismatch".to_str = et_message
        if "" self.current_op_context.as_str != then
            f"Type mismatch in {self.current_op_context}" = et_message
        fi
        et_actual et_expected self.current_location et_message common::ErrorKind::TypeMismatch
        self.diagnostics.record_error_expected_strings
    }

    pub fn expect_type_t tc:mut$TypeChecker expected:$common::Type {
        if
            0 tc
                .stack
                .values
                .length ==
        then
            if tc.within_param_cap then
                expected common::Parameter::new tc.parameters.push
                return
            fi
            f"Stack underflow: expected `{expected.format}` but stack is empty" tc.report_stack_underflow
            return
        fi
        tc.stack_pop_value = value
        value expected tc.expect_value_type_t
    }
}

# ============================================================================
# Type compatibility
# ============================================================================

pub fn type_exists_recursive_t
    typ:$common::Type
    function_opt:mut$std::Option[common::Function]
    store:mut$common::SymbolStore
-> bool {
    typ match
        common::Type::Unknown => {
            false
        }
        common::Type::Builtin(_) => {
            true
        }
        common::Type::TypeVar(name) => {
            if function_opt std::Option::Some(check_fn) is then
                name check_fn common::Function::stack_effect common::StackEffect::type_vars.has return
            fi
            false
        }
        common::Type::Const(const_type) => {
            if const_type.is_symbolic ! then
                true return
            fi
            if function_opt std::Option::Some(check_fn) is then
                const_type.name check_fn common::Function::stack_effect common::StackEffect::const_params.has return
            fi
            false
        }
        common::Type::Generic(generic) => {
            for param in generic.params.iter do
                if store function_opt param type_exists_recursive_t ! then
                    false return
                fi
            done
            if common::SHARED_BORROW_TYPE generic.base.as_str == then
                true return
            fi
            if common::EXCLUSIVE_BORROW_TYPE generic.base.as_str == then
                true return
            fi
            if
                generic.base store
                    .structs
                    .get
                    .is_some
            then
                true return
            fi
            if
                generic.base store
                    .enums
                    .get
                    .is_some
            then
                true return
            fi
            if "array" generic.base.as_str == then
                true return
            fi
            if function_opt std::Option::Some(check_fn) is then
                if generic.base check_fn common::Function::stack_effect common::StackEffect::type_vars.has then
                    true return
                fi
            fi
            false
        }
        common::Type::Function(fn_type) => {
            for param in fn_type.parameters.iter do
                if store function_opt param type_exists_recursive_t ! then
                    false return
                fi
            done
            for ret in fn_type.return_types.iter do
                if store function_opt ret type_exists_recursive_t ! then
                    false return
                fi
            done
            true
        }
    end
}

impl TypeChecker {
    pub fn validate_type_exists
        self:mut$TypeChecker
        typ:$common::Type
        function_opt:mut$std::Option[common::Function]
        location:$common::Location
    {
        typ.match_base = type_name
        if location.file.as_str type_name.as_str self.store.is_private_from then
            location f"Type `{type_name}` is private" common::ErrorKind::InvalidScope self.diagnostics.record_error_string
            return
        fi
        if self.store function_opt typ type_exists_recursive_t then
            return
        fi
        location f"type `{typ.format}` does not exist" common::ErrorKind::Syntax self.diagnostics.record_error_string
    }
}

# ============================================================================
# Unify types — returns the more specific type, or "" on incompatibility
# ============================================================================
# ============================================================================
# Stack compatibility — unify element-wise, returns empty list on mismatch
# ============================================================================

pub fn stacks_compatible
    stack_a:$std::List[common::Type]
    stack_b:$std::List[common::Type]
    store:mut$common::SymbolStore
-> std::List[common::Type] {
    if stack_a.length stack_b.length != then
        std::List[common::Type]::new return
    fi
    std::List[common::Type]::new = result
    0 (u64) = index
    while index stack_a.length > do
        if index stack_b.get index stack_a.get.eq then
            index stack_a.get common::clone_type result.push
        else
            store index stack_b.get index stack_a.get semantics::unify_type_t = unified
            unified match
                std::Option::Some(unified_type) => unified_type result.push
                std::Option::None => std::List[common::Type]::new return
            end
        fi
        1 += index
    done
    result
}

pub fn stacks_equal stack_a:$std::List[common::Type] stack_b:$std::List[common::Type] -> bool {
    if stack_a.length stack_b.length != then
        false return
    fi
    for pair in stack_b.iter stack_a.iter.zip do
        if pair.second pair.first.eq ! then
            false return
        fi
    done
    true
}

# ============================================================================
# Apply stack effect: pop params, push returns, with type variable binding.
# ============================================================================

pub fn resolve_return_type_t
    bindings:$std::Map[std::String common::Type]
    ret:$common::Type
-> common::Type {
    ret match
        common::Type::TypeVar(name) => {
            if name bindings.get std::Option::Some(bound) is then
                bound common::clone_type
            else
                name.clone common::Type::TypeVar
            fi
        }
        common::Type::Const(const_type) => {
            if const_type.is_symbolic then
                if const_type.name bindings.get std::Option::Some(bound) is then
                    bound common::clone_type
                else
                    ret common::clone_type
                fi
            else
                ret common::clone_type
            fi
        }
        common::Type::Generic(generic) => {
            if 0 generic.params.length == then
                if generic.base bindings.get std::Option::Some(bound) is then
                    bound common::clone_type return
                fi
                generic.params.clone generic.base.clone common::GenericType common::Type::Generic return
            fi
            std::List[common::Type]::new = new_params
            for param in generic.params.iter do
                param bindings resolve_return_type_t new_params.push
            done
            new_params generic.base.clone common::GenericType common::Type::Generic
        }
        common::Type::Function(fn_type) => {
            std::List[common::Type]::new = new_params
            for param in fn_type.parameters.iter do
                param bindings resolve_return_type_t new_params.push
            done
            std::List[common::Type]::new = new_returns
            for ret_inner in fn_type.return_types.iter do
                ret_inner bindings resolve_return_type_t new_returns.push
            done
            new_returns new_params common::FunctionType common::Type::Function
        }
        common::Type::Unknown => {
            common::Type::Unknown
        }
        common::Type::Builtin(builtin) => {
            builtin (i64) (common::BuiltinType) common::Type::Builtin
        }
    end
}

impl TypeChecker {
    pub fn bind_type_var
        tc:mut$TypeChecker
        bindings:mut$std::Map[std::String common::Type]
        type_var:$str
        actual:$common::Type
    {
        type_var bindings.remove_str = existing
        if existing.is_none then
            actual common::clone_type type_var.clone bindings.set_str
            return
        fi
        existing.unwrap = bound
        if bound.has_unresolved_type_var actual.has_unresolved_type_var ! && then
            actual common::clone_type type_var.clone bindings.set_str
            return
        fi
        if
            bound.is_integer_literal_t actual.is_integer_type_t &&
            bound.is_float_literal_t actual.is_float_type_t && ||
        then
            actual common::clone_type type_var.clone bindings.set_str
            return
        fi
        if
            actual.is_integer_literal_t bound.is_integer_type_t &&
            actual.is_float_literal_t bound.is_float_type_t && ||
        then
            bound type_var.clone bindings.set_str
            return
        fi
        actual.is_unknown_placeholder = actual_unknown
        bound.is_unknown_placeholder = bound_unknown
        if
            bound_unknown
            bound.has_unresolved_type_var ||
            actual_unknown ! &&
        then
            actual common::clone_type type_var.clone bindings.set_str
            return
        fi
        if
            bound actual.eq !
            actual_unknown ! &&
            bound_unknown ! &&
            actual.has_unresolved_type_var ! &&
        then
            f"Type variable `{type_var}` bound to `{bound.format}` but got `{actual.format}`" tc.raise_type_mismatch
        fi
        bound type_var.clone bindings.set_str
    }
}

impl TypeChecker {
    pub fn record_literal_binding
        tc:mut$TypeChecker
        type_variable:$str
        literals:$std::List[LiteralRef]
        literal_bindings:mut$std::Map[std::String std::List[LiteralRef]]
    {
        type_variable literal_bindings.get_mut_str = bound_literals_opt
        bound_literals_opt match
            std::Option::Some(bound_literals) => literals.clone bound_literals.append
            std::Option::None => literals.clone type_variable.clone literal_bindings.set_str
        end
    }

    pub fn bind_direct_type_variable_parameter
        tc:mut$TypeChecker
        parameter:$common::Parameter
        effect:$common::StackEffect
        bindings:mut$std::Map[std::String common::Type]
        literal_bindings:mut$std::Map[std::String std::List[LiteralRef]]
    -> bool {
        parameter.typ.type_var_name = type_variable_option
        type_variable_option match
            std::Option::Some(type_variable) => {
                if type_variable.as_str effect.type_vars.has_str ! then
                    false return
                fi
                type_variable.as_str bindings.get_str = bound
                tc.stack_pop_value = value
                if bound std::Option::Some is then
                    bindings parameter.typ.substitute_t = resolved_expected
                    value resolved_expected tc.expect_value_type_t
                    true return
                fi
                value tc.consume_value
                value.type_value common::clone_type = actual
                if 0 value.literals.length != then
                    literal_bindings value.literals type_variable.as_str tc.record_literal_binding
                fi
                actual type_variable.as_str bindings tc.bind_type_var
                true
            }
            std::Option::None => false
        end
    }

    pub fn push_resolved_return
        tc:mut$TypeChecker
        return_type:$common::Type
        bindings:mut$std::Map[std::String common::Type]
        literal_bindings:mut$std::Map[std::String std::List[LiteralRef]]
    {
        return_type bindings resolve_return_type_t = resolved
        if return_type.type_var_name std::Option::Some(type_variable) is then
            if type_variable.as_str literal_bindings.get_str std::Option::Some(literals) is then
                false std::Option[std::List[std::String]]::None std::Option[i64]::None std::Option[std::String]::None
                resolved type_capability std::Option[std::String]::None
                literals.clone tc.current_location.clone resolved TypedValue
                tc
                    .stack
                    .values
                    .push
                return
            fi
        fi
        resolved tc.stack_push_type
    }
}

impl TypeChecker {
    pub fn bind_generic_param
        tc:mut$TypeChecker
        bindings:mut$std::Map[std::String common::Type]
        expected:$common::Parameter
        effect:$common::StackEffect
    -> bool {
        # Bind type vars from a parameterized param like Map[K V].
        expected common::Parameter::typ.base = base_opt
        if base_opt.is_none then
            false return
        fi
        expected common::Parameter::typ.type_params = expected_params_opt
        if expected_params_opt.is_none then
            false return
        fi
        expected_params_opt.unwrap = expected_params
        # Check if any param is a type variable
        false = has_type_var
        for expected_param in expected_params.iter do
            if expected_param.type_var_name std::Option::Some(probe_name) is then
                if probe_name effect common::StackEffect::type_vars.has then
                    true = has_type_var
                fi
            fi
        done
        if has_type_var ! then
            false return
        fi

        base_opt.unwrap = base
        tc.stack_pop_value = value
        if expected.typ.is_borrow then
            value tc.release_value
        else
            value tc.consume_value
        fi
        value.type_value common::clone_type = actual
        bindings expected.typ.substitute_t = resolved_expected
        if 0 value.literals.length != then
            if resolved_expected.has_unresolved_type_var then
                actual resolve_numeric_literal_default = actual
            else
                resolved_expected = actual
            fi
            tc.literal_resolutions tc.diagnostics actual value.resolve_literals drop
        fi
        actual match
            common::Type::Generic(actual_g) => {
                if 0 actual_g.params.length == then
                    expected_params bindings effect tc.bind_unknowns
                    true return
                fi
                if base actual_g.base != then
                    "Type mismatch".to_str tc.raise_type_mismatch
                    true return
                fi
                if actual_g.params.length expected_params.length != then
                    "Type mismatch".to_str tc.raise_type_mismatch
                    true return
                fi
                0 (u64) = bind_index
                while bind_index expected_params.length > do
                    if bind_index expected_params.get.type_var_name std::Option::Some(bind_name) is then
                        if bind_name.as_str effect common::StackEffect::type_vars.has_str then
                            bind_index actual_g.params.get bind_name.as_str bindings tc.bind_type_var
                        fi
                    fi
                    bind_index actual_g.params.get bind_index expected_params.get tc.validate_const_arguments_t
                    1 += bind_index
                done
                true return
            }
            common::Type::Unknown => {
                expected_params bindings effect tc.bind_unknowns
                true return
            }
            _ => {
                "Type mismatch".to_str tc.raise_type_mismatch
            }
        end
        true
    }

    # Validate the argument for a symbolic `const` parameter (ADR-0152): it must
    # be a compile-time constant that fits the parameter's type, else a
    # diagnostic that names the argument.
    pub fn validate_const_argument
        tc:mut$TypeChecker
        expected_const:$common::ConstType
        actual:$common::Type
    {
        if expected_const.is_symbolic ! then
            return
        fi
        if actual.is_unknown then
            return
        fi
        if actual common::Type::Const(actual_const) is then
            if actual_const.is_symbolic then
                return
            fi
            if expected_const.typ actual_const.fits_parameter ! then
                tc.current_location f"Constant argument `{actual_const.value}` does not fit type `{expected_const.typ.format}` of constant parameter `{expected_const.name}`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi
            return
        fi
        tc.current_location f"Constant parameter `{expected_const.name}` requires a compile-time constant, got `{actual.format}`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
    }

    # Walk an expected type and its actual argument in parallel, validating every
    # symbolic `const` parameter position against the supplied argument (ADR-0152).
    pub fn validate_const_arguments_t
        tc:mut$TypeChecker
        expected:$common::Type
        actual:$common::Type
    {
        expected match
            common::Type::Const(expected_const) => {
                actual expected_const tc.validate_const_argument
            }
            common::Type::Generic(expected_generic) => {
                if actual common::Type::Generic(actual_generic) is then
                    if
                        expected_generic.base actual_generic.base ==
                        expected_generic.params.length actual_generic.params.length == &&
                    then
                        for
                            pair in actual_generic.params.iter expected_generic
                                .params
                                .iter
                                .zip
                        do
                            pair.second pair.first tc.validate_const_arguments_t
                        done
                    fi
                fi
            }
            common::Type::Function(expected_function) => {
                if actual common::Type::Function(actual_function) is then
                    for
                        pair in actual_function.parameters.iter expected_function
                            .parameters
                            .iter
                            .zip
                    do
                        pair.second pair.first tc.validate_const_arguments_t
                    done
                    for
                        pair in actual_function.return_types.iter expected_function
                            .return_types
                            .iter
                            .zip
                    do
                        pair.second pair.first tc.validate_const_arguments_t
                    done
                fi
            }
            _ => {
            }
        end
    }
}

impl TypeChecker {
