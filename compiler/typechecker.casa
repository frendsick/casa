                    Type::Function(actual_fn) => {
                        expected_fn.parameters = expected_fn_params: $List[Type]
                        actual_fn.parameters = actual_fn_params: $List[Type]
                        0 (u64) = param_index
                        while
                            param_index expected_fn_params.length >
                            param_index actual_fn_params.length > &&
                        do
                            param_index expected_fn_params.get = expected_param
                            param_index actual_fn_params.get = actual_param
                            bindings actual_param expected_param bind_semantic_type_arguments
                            1 += param_index
                        done
                        expected_fn.return_types = expected_fn_returns: $List[Type]
                        actual_fn.return_types = actual_fn_returns: $List[Type]
                        0 (u64) = return_index
                        while
                            return_index expected_fn_returns.length >
                            return_index actual_fn_returns.length > &&
                        do
                            return_index expected_fn_returns.get = expected_return
                            return_index actual_fn_returns.get = actual_return
                            bindings actual_return expected_return bind_semantic_type_arguments
                            1 += return_index
                        done
                    }
                    _ => {
                    }
                end
            }
            _ => {
            }
        end
        true
    }
}

impl TypeChecker {
    fn stack_push_origins tc:mut$TypeChecker typ:$Type origins:Option[List[String]] {
        typ tc.stack_push_type
        tc
            .stack
            .values
            .length 1 - tc
            .stack
            .values
            .get_mut = value
        origins = value.origins
    }

    fn call_origins
        tc:mut$TypeChecker
        effect:$StackEffect
        bindings:mut$Map[String Type]
        exclusive:bool
    -> Option[List[String]] {
        Option[List[String]]::None = origins
        tc
            .stack
            .values
            .length = depth
        0 (u64) = index
        while index effect.parameters.length > index depth > && do
            index effect
                .parameters
                .get
                .typ = declared_parameter_type: $Type
            bindings declared_parameter_type.substitute_t = parameter_type
            depth 1 - index - tc
                .stack
                .values
                .get = argument: $TypedValue
            argument.origins.clone = argument_origins_opt
            argument_origins_opt match
                Option::Some(argument_origins) => {
                    for origin in argument_origins.iter do
                        if
                            exclusive !
                            origin.as_str origin_is_exclusive ||
                            parameter_type.is_exclusive_borrow argument.capability ValueCapability::Exclusive is && ||
                        then
                            origin.as_str origin_place = place
                            exclusive place.as_str origins add_origin = origins
                        fi
                    done
                }
                Option::None => {
                }
            end
            if parameter_type.is_borrow then
                if argument.place Option::Some(place) is then
                    if exclusive ! parameter_type.is_exclusive_borrow || then
                        exclusive place.as_str origins add_origin = origins
                    fi
                fi
            fi
            1 += index
        done
        origins
    }

    fn check_call_borrow_pair
        tc:mut$TypeChecker
        first_type:$Type
        first_value:$TypedValue
        second_type:$Type
        second_value:$TypedValue
    {
        if second_type.is_borrow ! then
            return
        fi
        if first_type.is_exclusive_borrow second_type.is_exclusive_borrow || ! then
            return
        fi
        if first_value.place Option::Some(first_name) is then
            if second_value.place Option::Some(second_name) is then
                if first_name.as_str second_name.as_str origin_matches_place ! then
                    return
                fi
                if
                    first_name.as_str second_name.as_str == first_type.is_exclusive_borrow second_type.is_exclusive_borrow && &&
                then
                    f"Cannot borrow `{first_name}` exclusively more than once in one call"
                elif first_name.as_str second_name.as_str == then
                    f"Cannot borrow `{first_name}` exclusively while it is also borrowed in the same call"
                elif first_type.is_exclusive_borrow second_type.is_exclusive_borrow && then
                    f"Cannot borrow overlapping places `{first_name}` and `{second_name}` exclusively in one call"
                else
                    f"Cannot borrow overlapping places `{first_name}` and `{second_name}` while one is exclusive"
                fi = message
                tc.current_location message ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        fi
    }

    fn check_call_borrow_conflicts
        tc:mut$TypeChecker
        effect:$StackEffect
        bindings:mut$Map[String Type]
    {
        tc
            .stack
            .values
            .length = depth
        0 (u64) = first_index
        while first_index effect.parameters.length > first_index depth > && do
            first_index effect
                .parameters
                .get
                .typ = declared_first_type: $Type
            bindings declared_first_type.substitute_t = first_type
            if first_type.is_borrow then
                depth 1 - first_index - tc
                    .stack
                    .values
                    .get clone_typed_value = first_value
                first_index 1 + = second_index
                while second_index effect.parameters.length > second_index depth > && do
                    second_index effect
                        .parameters
                        .get
                        .typ = declared_second_type: $Type
                    bindings declared_second_type.substitute_t = second_type
                    depth 1 - second_index - tc
                        .stack
                        .values
                        .get clone_typed_value = second_value
                    second_value second_type first_value first_type tc.check_call_borrow_pair
                    1 += second_index
                done
            fi
            1 += first_index
        done
    }

    fn check_live_borrow_conflicts
        tc:mut$TypeChecker
        effect:$StackEffect
        bindings:mut$Map[String Type]
    {
        tc
            .stack
            .values
            .length = depth
        if depth effect.parameters.length > then
            0
        else
            depth effect.parameters.length -
        fi = before_arguments
        0 (u64) = index
        while index effect.parameters.length > index depth > && do
            index effect
                .parameters
                .get
                .typ = declared_parameter_type: $Type
            bindings declared_parameter_type.substitute_t = parameter_type
            if parameter_type.is_borrow then
                depth 1 - index - tc
                    .stack
                    .values
                    .get clone_typed_value = argument
                if argument.place Option::Some(place) is then
                    if
                        parameter_type.is_exclusive_borrow before_arguments place.as_str
                        tc.place_has_conflicting_loan
                    then
                        if parameter_type.is_exclusive_borrow then " exclusively" else "" fi = qualifier
                        tc.current_location f"Cannot borrow `{place}`{qualifier} while it is borrowed"
                        ErrorKind::InvalidVariable tc.diagnostics.record_error_string
                    fi
                fi
            fi
            1 += index
        done
    }

    fn bind_borrow_parameter
        tc:mut$TypeChecker
        expected:$Parameter
        bindings:mut$Map[String Type]
    -> bool {
        expected.typ.borrow_target = target_opt
        target_opt match
            Option::Some(target) => {
                tc.stack_pop_value = value
                value tc.release_value
                value.type_value = actual_type: $Type
                actual_type clone_type = actual_target
                if actual_target.borrow_target Option::Some(borrowed_target) is then
                    borrowed_target clone_type = actual_target
                fi
                bindings actual_target target bind_semantic_type_arguments
                actual_target target tc.validate_const_arguments_t
                bindings target.substitute_t = resolved_target
                bindings expected.typ.substitute_t = resolved_expected
                if
                    resolved_expected.is_exclusive_borrow
                    actual_type.is_shared_borrow
                    value.capability ValueCapability::Shared is || &&
                then
                    f"Expected `{resolved_expected.format}`, got `{value.type_value.format}`"
                    tc.raise_type_mismatch
                    true return
                fi
                if tc.store actual_target resolved_target unify_type_t.is_none then
                    f"Expected `{resolved_expected.format}`, got `{value.type_value.format}`"
                    tc.raise_type_mismatch
                fi
                true
            }
            Option::None => false
        end
    }

    fn bind_concrete_stack_constraints
        tc:mut$TypeChecker
        effect:$StackEffect
        bindings:Map[String Type]
    -> Map[String Type] {
        tc
            .stack
            .values
            .length = depth
        0 (u64) = index
        while index effect.parameters.length > index depth > && do
            depth 1 - index - = stack_index
            stack_index tc
                .stack
                .values
                .get clone_typed_value = value
            index effect.parameters.get = parameter
            if 0 value.literals.length == then
                tc.current_location.clone = binding_location
                binding_location bindings effect stack_index parameter tc.bind_stack_parameter = bindings
            else
                value.type_value clone_type = actual
                if actual.borrow_target Option::Some(target) is then
                    target clone_type = actual
                fi
                parameter.typ clone_type = expected
                if expected.borrow_target Option::Some(target) is then
                    target clone_type = expected
                fi
                actual expected bindings bind_standalone_constant_parameters = bindings
            fi
            1 += index
        done
        bindings
    }

    fn find_struct_getter_field
        self:mut$TypeChecker
        function_name:$str
        receiver:$Type
    -> Option[String] {
        receiver clone_type = target
        if target.borrow_target Option::Some(borrowed_target) is then
            borrowed_target clone_type = target
        fi
        target.match_base = struct_name
        if
            struct_name.as_str self
                .store
                .structs
                .get_str Option::Some(casa_struct) is
        then
            for member in casa_struct.members.iter do
                f"{struct_name}::{member.name}" = getter_name
                if getter_name.as_str function_name == then
                    member.name.clone Option::Some return
                fi
            done
        fi
        Option[String]::None
    }

    fn finish_struct_getter
        self:mut$TypeChecker
        field:mut$Option[String]
        projected_place:mut$Option[String]
        receiver_capability:$ValueCapability
        shared_origins:mut$Option[List[String]]
        exclusive_origins:mut$Option[List[String]]
        function_opt:mut$Option[Function]
    {
        if
            field.is_none 0 self
                .stack
                .values
                .length == ||
        then
            return
        fi
        self
            .stack
            .values
            .length 1 - = value_index
        value_index self
            .stack
            .values
            .get TypedValue::type_value clone_type = value_type
        if function_opt value_type self.type_is_duplicable then
            return
        fi
        value_index self
            .stack
            .values
            .get_mut = value

        Option[List[String]]::None = origins
        if shared_origins Option::Some(current_origins) is then
            for origin in current_origins.iter do
                false = projected_ancestor
                if projected_place Option::Some(place) is then
                    origin.as_str origin_place = origin_path
                    if
                        place.as_str origin_path.as_str ==
                        f"{origin_path}." = origin_prefix
                        place.as_str origin_prefix.as_str str::starts_with ||
                    then
                        true = projected_ancestor
                    fi
                fi
                if projected_ancestor ! then
                    origin.as_str origin_place = place
                    false place.as_str origins add_origin = origins
                fi
            done
        fi
        if projected_place Option::Some(place) is then
            place.clone Option::Some = value.place
        fi
        origins = value.origins
        if receiver_capability ValueCapability::Shared is then
            ValueCapability::Shared
        else
            ValueCapability::Exclusive
        fi = value.capability
    }

    # Reject an out-of-range constant index before the program runs (ADR-0152).
    # A runtime index keeps the terminating bounds check in `array::nth`.
    fn check_constant_array_index
        self:mut$TypeChecker
        stack_effect:$StackEffect
        function_name:$str
    {
        if ARRAY_NTH_FUNCTION function_name != then
            return
        fi
        List[u64]::new = source_parameter_positions
        0 (u64) = parameter_index
        while parameter_index stack_effect.parameters.length > do
            if
                parameter_index stack_effect
                    .parameters
                    .get_ref
                    .name
                    .as_str is_hidden_parameter_name !
            then
                parameter_index source_parameter_positions.push
            fi
            1 += parameter_index
        done
        if 2 source_parameter_positions.length != then
            return
        fi
        self
            .stack
            .values
            .length = stack_depth
        1 source_parameter_positions.get copy = index_position
        if stack_depth index_position >= then
            return
        fi
        stack_depth 1 - 0 source_parameter_positions.get copy - self
            .stack
            .values
            .get = array_value: $TypedValue
        stack_depth 1 - index_position - self
            .stack
            .values
            .get = index_value: $TypedValue

        array_value.type_value clone_type = array_type
        if array_type.borrow_target Option::Some(target) is then
            target clone_type = array_type
        fi
        array_type get_concrete_array_length = array_length_option
        0 (u64) = array_length
        array_length_option match
            Option::Some(length) => length = array_length
            Option::None => return
        end

        if index_value.is_literal_constant ! then
            return
        fi
        if 1 index_value.literals.length != then
            return
        fi
        0 index_value.literals.get = literal
        if literal.is_integer then
            literal.integer_value = index_constant
            if array_length i64::try_from.unwrap index_constant >= then
                self.current_location f"Array index {index_constant} is out of bounds for `{array_type.format}`"
                ErrorKind::TypeMismatch self.diagnostics.record_error_string
            fi
        fi
    }

    fn apply_stack_effect
        tc:mut$TypeChecker
        effect:$StackEffect
        name:$str
        return_hint:Option[Type]
        function_opt:mut$Option[Function]
    {
        name effect tc.check_constant_array_index
        Option[String]::None = field
        Option[String]::None = projected_place
        ValueCapability::Shared = receiver_capability
        if
            0 tc
                .stack
                .values
                .length !=
        then
            tc
                .stack
                .values
                .length 1 - = receiver_index
            receiver_index tc
                .stack
                .values
                .get clone_typed_value = receiver_value
            receiver_value.type_value name tc.find_struct_getter_field = field
            if field Option::Some(field_name) is then
                receiver_value.capability = receiver_capability
                if receiver_value.place Option::Some(place) is then
                    f"{place}.{field_name}" = projected
                    projected.clone Option::Some = projected_place
                    receiver_index tc
                        .stack
                        .values
                        .get_mut = stored_receiver
                    projected Option::Some = stored_receiver.place
                fi
            fi
        fi
        Map[String Type]::new = bindings
        if
            0 effect.type_vars.length !=
            0 effect
                .const_params
                .keys
                .length != ||
        then
            if return_hint Option::Some(hint) is then
                for return_type in effect StackEffect::return_types.iter do
                    effect.type_vars hint return_type bindings bind_generic_params_standalone = bindings
                    hint return_type bindings bind_standalone_constant_parameters = bindings
                done
            fi
            bindings effect tc.bind_concrete_stack_constraints = bindings
        fi
        Option[List[String]]::None = shared_origins
        Option[List[String]]::None = exclusive_origins
        if effect stack_effect_may_borrow then
            false bindings effect tc.call_origins = shared_origins
            true bindings effect tc.call_origins = exclusive_origins
            bindings effect tc.check_call_borrow_conflicts
            bindings effect tc.check_live_borrow_conflicts
        fi
        # Simple case: no type or constant parameters
        if
            0 effect.type_vars.length ==
            0 effect
                .const_params
                .keys
                .length == &&
        then
            0 (u64) = index
            while index effect StackEffect::parameters.length > do
                index effect StackEffect::parameters.get = parameter
                if "" name.as_str != then
                    f"parameter {index 1 +} of `{name}`" = tc.current_expect_ctx
                elif "" parameter.name.as_str != then
                    parameter.name.clone = tc.current_expect_ctx
                fi
                parameter.typ tc.expect_type_t
                1 += index
            done
            "".to_str = tc.current_expect_ctx
            for return_type in effect StackEffect::return_types.iter do
                if tc.store return_type type_has_borrow then
                    Option[List[String]]::None = origins
                    if tc.store return_type type_has_shared_borrow then
                        shared_origins origins merge_origins = origins
                    fi
                    if tc.store return_type type_has_exclusive_borrow then
                        exclusive_origins origins merge_origins = origins
                    fi
                    origins return_type tc.stack_push_origins
                else
                    return_type tc.stack_push_type
                fi
            done
            function_opt exclusive_origins shared_origins receiver_capability projected_place field
            tc.finish_struct_getter
            return
        fi

        # Generic case: bind type variables
        Map[String List[LiteralRef]]::new = literal_bindings
        0 (u64) = index
        while index effect.parameters.length > do
            index effect.parameters.get = parameter

            if "" name.as_str != then
                f"parameter {index 1 +} of `{name}`" = tc.current_expect_ctx
            elif "" parameter.name.as_str != then
                parameter.name.clone = tc.current_expect_ctx
            fi

            if bindings parameter tc.bind_borrow_parameter then
                1 += index
                continue
            fi

            if literal_bindings bindings effect parameter tc.bind_direct_type_variable_parameter then
                1 += index
                continue
            fi

            # Parameterized type with type vars (e.g. Option[T], Map[K V])
            if effect parameter bindings tc.bind_generic_param then
                1 += index
                continue
            fi

            # Function type with type vars (e.g. fn[T -> T])
            if effect parameter bindings tc.bind_fn_param then
                1 += index
                continue
            fi

            bindings parameter.typ.substitute_t tc.expect_type_t
            1 += index
        done
        "".to_str = tc.current_expect_ctx

        # Push resolved return types
        for return_type in effect StackEffect::return_types.iter do
            return_type bindings resolve_return_type_t = resolved_return
            literal_bindings bindings return_type tc.push_resolved_return
            if tc.store resolved_return type_has_borrow then
                Option[List[String]]::None = origins
                if tc.store resolved_return type_has_shared_borrow then
                    shared_origins origins merge_origins = origins
                fi
                if tc.store resolved_return type_has_exclusive_borrow then
                    exclusive_origins origins merge_origins = origins
                fi
                tc
                    .stack
                    .values
                    .length 1 - tc
                    .stack
                    .values
                    .get_mut = value
                origins = value.origins
            fi
        done
        function_opt exclusive_origins shared_origins receiver_capability projected_place field
        tc.finish_struct_getter
    }
}

# ============================================================================
# Check arithmetic operations
# ============================================================================

fn exact_numeric_conversion source:mut$BuiltinType target:mut$BuiltinType -> bool {
    if source target == then
        true return
    fi
    if source.is_integer target.is_integer && then
        source.bit_width = source_width
        target.bit_width = target_width
        if source.is_unsigned then
            if target.is_unsigned then
                target_width source_width <= return
            fi
            target_width source_width < return
        fi
        if target.is_unsigned then
            false return
        fi
        target_width source_width <= return
    fi
    if source BuiltinType::F32 == target BuiltinType::F64 == && then
        true return
    fi
    if source.is_integer target.is_float && then
        if target BuiltinType::F32 == then
            if source.is_unsigned then
                24 source.bit_width <= return
            fi
            25 source.bit_width <= return
        fi
        if source.is_unsigned then
            53 source.bit_width <= return
        fi
        54 source.bit_width <= return
    fi
    false
}

fn numeric_conversion_allowed conversion:mut$NumericConversion -> bool {
    conversion.kind match
        NumericConversionKind::Exact => conversion.target conversion.source exact_numeric_conversion
        NumericConversionKind::Rounded => {
            conversion.target.is_float
            conversion.source.is_integer
            conversion.source BuiltinType::F64 ==
            conversion.target BuiltinType::F32 == && || &&
        }
        NumericConversionKind::Truncate => {
            conversion.target.is_integer conversion.source.is_float &&
        }
        NumericConversionKind::Wrapping => {
            conversion.target.is_integer conversion.source.is_integer &&
        }
        NumericConversionKind::FromBits => {
            conversion.target BuiltinType::F32 == conversion.source BuiltinType::U32 == &&
            conversion.target BuiltinType::F64 == conversion.source BuiltinType::U64 == && ||
        }
        NumericConversionKind::ToBits => {
            conversion.source BuiltinType::F32 == conversion.target BuiltinType::U32 == &&
            conversion.source BuiltinType::F64 == conversion.target BuiltinType::U64 == && ||
        }
    end
}

impl TypeChecker {
    fn check_numeric_call tc:mut$TypeChecker op:mut$Op {
        op.value clone_op_value = numeric_value
        if numeric_value OpValue::NumericCall(call) is then
            if "__float_significand" call.method.as_str == then
                tc.stack_pop_value = value
                tc.stack_pop_value = exponent
                TYPE_F64_T value tc.resolve_float_value drop
                TYPE_I64_T exponent tc.resolve_integer_value drop
                if call.target BuiltinType::U64 != then
                    op.location "Only `u64::__float_significand` is defined" ErrorKind::TypeMismatch tc.diagnostics.record_error
                fi
                OpValue::FloatSignificand op Op::set_value
                TYPE_U64_T clone_type Option::Some op Op::set_type_hint
                TYPE_U64_T tc.stack_push_type
                return
            fi
            if "__from_decimal_parts" call.method.as_str == then
                tc.stack_pop_value = significand
                tc.stack_pop_value = exponent
                TYPE_U64_T significand tc.resolve_integer_value drop
                TYPE_I64_T exponent tc.resolve_integer_value drop
                if call.target BuiltinType::F64 != then
                    op.location "Only `f64::__from_decimal_parts` is defined" ErrorKind::TypeMismatch tc.diagnostics.record_error
                fi
                OpValue::FloatFromDecimal op Op::set_value
                TYPE_F64_T clone_type Option::Some op Op::set_type_hint
                TYPE_F64_T tc.stack_push_type
                return
            fi
            tc.stack_pop_value = value
            TYPE_UNKNOWN_T clone_type = source_type
            if value.type_value.is_integer_literal_t then
                tc.literal_resolutions tc.diagnostics TYPE_I64_T value.resolve_literals drop
                TYPE_I64_T clone_type = source_type
            elif value.type_value.is_float_literal_t then
                tc.literal_resolutions tc.diagnostics TYPE_F64_T value.resolve_literals drop
                TYPE_F64_T clone_type = source_type
            else
                value.type_value clone_type = source_type
            fi
            if "from_codepoint_unchecked" call.method.as_str == then
                "char::from_codepoint_unchecked" op tc.require_unsafe
                if call.target BuiltinType::Char != then
                    op.location "Only `char::from_codepoint_unchecked` is defined" ErrorKind::TypeMismatch tc.diagnostics.record_error
                fi
                TYPE_U32_T value tc.resolve_integer_value drop
                BuiltinType::Char BuiltinType::U32 NumericConversionKind::FromBits NumericConversion
                OpValue::NumericConvert op Op::set_value
                TYPE_CHAR_T clone_type Option::Some op Op::set_type_hint
                TYPE_CHAR_T tc.stack_push_type
                return
            fi
            if "try_from" call.method.as_str == then
                if
                    source_type.is_integer_type_t
                    source_type.is_float_type_t ||
                then
                    call.target source_type NumericTry OpValue::NumericTry op Op::set_value
                    call.target Type::Builtin Option::Some op Op::set_type_hint
                    List[Type]::new = option_params
                    call.target Type::Builtin option_params.push
                    option_params "Option".to_str GenericType Type::Generic tc.stack_push_type
                    return
                fi
                op.location f"Conversion `{call.target.format}::try_from` requires a numeric value" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                TYPE_UNKNOWN_T tc.stack_push_type
                return
            fi
            if source_type Type::Builtin(source) is then
                call.method.as_str match
                    "from" => NumericConversionKind::Exact
                    "from_bits" => NumericConversionKind::FromBits
                    "round_from" => NumericConversionKind::Rounded
                    "trunc_from" => NumericConversionKind::Truncate
                    _ => NumericConversionKind::Wrapping
                end = kind
                call.target source kind NumericConversion = conversion
                if conversion numeric_conversion_allowed ! then
                    op.location f"Conversion `{call.target.format}::{call.method}` does not accept `{source.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                fi
                conversion OpValue::NumericConvert op Op::set_value
                call.target Type::Builtin Option::Some op Op::set_type_hint
                call.target Type::Builtin tc.stack_push_type
                return
            fi
            op.location f"Conversion `{call.target.format}::{call.method}` requires a numeric value" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            TYPE_UNKNOWN_T tc.stack_push_type
        fi
    }

    fn resolve_float_value tc:mut$TypeChecker value:mut$TypedValue target:$Type -> bool {
        if 0 value.literals.length != then
            tc.literal_resolutions tc.diagnostics target value.resolve_literals return
        fi
        if value.type_value target.eq then
            true return
        fi
        f"Expected `{target.format}`, got `{value.type_value.format}`" tc.raise_type_mismatch
        false
    }

    fn resolve_integer_value tc:mut$TypeChecker value:mut$TypedValue target:$Type -> bool {
        if 0 value.literals.length != then
            tc.literal_resolutions tc.diagnostics target value.resolve_literals return
        fi
        if value.type_value target.eq then
            true return
        fi
        f"Expected `{target.format}`, got `{value.type_value.format}`" tc.raise_type_mismatch
        false
    }

    fn check_integer_operation tc:mut$TypeChecker op:mut$Op {
        op.value clone_op_value = operation
        if operation OpValue::BitNot is then
            tc.stack_pop_value = value
            if value.type_value TYPE_MISSING_T.eq then
                TYPE_MISSING_T tc.stack_push_type
                return
            fi
            if value.type_value.is_unknown_placeholder then
                TYPE_UNKNOWN_T tc.stack_push_type
                return
            fi
            if value.type_value.is_integer_literal_t then
                TYPE_I64_T clone_type
            else
                value.type_value clone_type
            fi = target
            if target.is_integer_type_t ! then
                f"Operator `~` requires an integer, got `{target.format}`" tc.raise_type_mismatch
                return
            fi
            target value tc.resolve_integer_value drop
            target clone_type Option::Some op Op::set_type_hint
            target tc.stack_push_type
            return
        fi

        tc.stack_pop_value = right
        right tc.stack_pop_left_like = left

        if left.type_value TYPE_MISSING_T.eq right.type_value TYPE_MISSING_T.eq || then
            TYPE_MISSING_T tc.stack_push_type
            return
        fi
        if left.type_value.is_unknown_placeholder right.type_value.is_unknown_placeholder || then
            TYPE_UNKNOWN_T tc.stack_push_type
            return
        fi

        if
            left.type_value.is_float_type_t left.type_value.is_float_literal_t ||
            right.type_value.is_float_type_t right.type_value.is_float_literal_t ||
            ||
        then
            TYPE_F64_T clone_type = float_target
            if left.type_value.is_float_type_t then
                left.type_value clone_type = float_target
            elif right.type_value.is_float_type_t then
                right.type_value clone_type = float_target
            fi
            if
                operation OpValue::Add is operation OpValue::Sub is ||
                operation OpValue::Mul is ||
                operation OpValue::Div is ||
                !
            then
                f"Operator requires integer operands, got `{left.type_value.format}` and `{right.type_value.format}`" tc.raise_type_mismatch
                return
            fi
            float_target left tc.resolve_float_value drop
            float_target right tc.resolve_float_value drop
            float_target clone_type Option::Some op Op::set_type_hint
            float_target tc.stack_push_type
            return
        fi

        if operation OpValue::Shl is operation OpValue::Shr is || then
            TYPE_U64_T right tc.resolve_integer_value drop
            if left.type_value.is_integer_literal_t then
                TYPE_I64_T clone_type
            else
                left.type_value clone_type
            fi = target
            if target.is_integer_type_t ! then
                f"Shift operand must be an integer, got `{target.format}`" tc.raise_type_mismatch
                return
            fi
            target left tc.resolve_integer_value drop
            target clone_type Option::Some op Op::set_type_hint
            target tc.stack_push_type
            return
        fi

        if
            operation OpValue::Add is operation OpValue::Sub is ||
            left.type_value TYPE_PTR_T.eq &&
        then
            if operation OpValue::Add is then "+" else "-" fi = operator
            operator op tc.require_unsafe
            TYPE_U64_T right tc.resolve_integer_value drop
            TYPE_PTR_T clone_type Option::Some op Op::set_type_hint
            TYPE_PTR_T tc.stack_push_type
            return
        fi

        TYPE_I64_T clone_type = target
        if left.type_value.is_integer_type_t then
            left.type_value clone_type = target
        elif right.type_value.is_integer_type_t then
            right.type_value clone_type = target
        else
            TYPE_I64_T clone_type = target
        fi
        if target.is_integer_type_t ! then
            f"Integer operator requires integer operands, got `{left.type_value.format}` and `{right.type_value.format}`" tc.raise_type_mismatch
            return
        fi
        target left tc.resolve_integer_value drop
        target right tc.resolve_integer_value drop
        target clone_type Option::Some op Op::set_type_hint
        target tc.stack_push_type
    }
}

# ============================================================================
# Check comparison operations
# ============================================================================
# Primitive comparisons are emitted as direct bytecode. `str` is handled
# separately because it only supports `==`/`!=` and carries a type hint.

fn comparison_op_str cmp_value:$OpValue -> str {
    if cmp_value OpValue::Eq is then
        "==" return
    fi
    if cmp_value OpValue::Ne is then
        "!=" return
    fi
    if cmp_value OpValue::Lt is then
        "<" return
    fi
    if cmp_value OpValue::Le is then
        "<=" return
    fi
    if cmp_value OpValue::Gt is then
        ">" return
    fi
    ">="
}

impl TypeChecker {
    fn check_float_to_bits tc:mut$TypeChecker op:mut$Op method_name:$str -> bool {
        if "to_bits" method_name.as_str != then
            false return
        fi
        tc.stack_pop_value = value
        if value.type_value Type::Builtin(source) is then
            if source.is_float then
                if source BuiltinType::F32 == then
                    BuiltinType::U32
                else
                    BuiltinType::U64
                fi
                = target
                target (i64) = target_value
                target_value (BuiltinType) source (i64) (BuiltinType)
                NumericConversionKind::ToBits NumericConversion = conversion
                conversion OpValue::NumericConvert op Op::set_value
                target_value (BuiltinType) Type::Builtin Option::Some op Op::set_type_hint
                target_value (BuiltinType) Type::Builtin tc.stack_push_type
                true return
            fi
        fi
        op.location "Method `to_bits` requires `f32` or `f64`" ErrorKind::TypeMismatch tc.diagnostics.record_error
        TYPE_UNKNOWN_T tc.stack_push_type
        true
    }

    fn check_comparison
        tc:mut$TypeChecker
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    -> u64 {
        op.value clone_op_value = cmp_value
        cmp_value OpValue::Eq is cmp_value OpValue::Ne is || = is_eq_op
        cmp_value comparison_trait_name = trait_name
        f"value with trait `{trait_name}`" = tc.current_expect_ctx
        tc.stack_pop_value = value1
        value1 tc.stack_pop_left_like = value2
        value1 tc.release_value
        value2 tc.release_value
        TYPE_I64_T clone_type = integer_target
        value1.type_value clone_type = type1_t
        value2.type_value clone_type = type2_t
        if
            TYPE_UNKNOWN_T type1_t.eq
            TYPE_UNKNOWN_T type2_t.eq ||
            TYPE_MISSING_T type1_t.eq ||
            TYPE_MISSING_T type2_t.eq ||
        then
            TYPE_BOOL_T tc.stack_push_type
            op_index return
        fi
        if value1.type_value.is_integer_type_t then
            value1.type_value clone_type = integer_target
        elif value2.type_value.is_integer_type_t then
            value2.type_value clone_type = integer_target
        else
            TYPE_I64_T clone_type = integer_target
        fi
        if
            value1.type_value.is_integer_literal_t value2.type_value.is_integer_literal_t ||
            integer_target.is_integer_type_t &&
        then
            integer_target value1 tc.resolve_integer_value drop
            integer_target value2 tc.resolve_integer_value drop
            integer_target clone_type = type1_t
            integer_target clone_type = type2_t
            integer_target clone_type Option::Some op Op::set_type_hint
        fi
        if
            value1.type_value.is_float_type_t value1.type_value.is_float_literal_t ||
            value2.type_value.is_float_type_t value2.type_value.is_float_literal_t ||
            ||
        then
            TYPE_F64_T clone_type = float_target
            if value1.type_value.is_float_type_t then
                value1.type_value clone_type = float_target
            elif value2.type_value.is_float_type_t then
                value2.type_value clone_type = float_target
            fi
            float_target value1 tc.resolve_float_value drop
            float_target value2 tc.resolve_float_value drop
            float_target clone_type = type1_t
            float_target clone_type = type2_t
            float_target clone_type Option::Some op Op::set_type_hint
        fi
        if type1_t.borrow_target Option::Some(target) is then
            target clone_type = type1_t
        fi
        if type2_t.borrow_target Option::Some(target) is then
            target clone_type = type2_t
        fi
        if is_eq_op then
            TYPE_STR_T type1_t.eq TYPE_STRING_T type2_t.eq && = str_string
            TYPE_STRING_T type1_t.eq TYPE_STR_T type2_t.eq && = string_str
            if str_string string_str || then
                if string_str then "StringStrEq".to_str else "StrStringEq".to_str fi GenericType::new
                Type::Generic Option::Some op Op::set_type_hint
                TYPE_BOOL_T tc.stack_push_type
                op_index return
            fi
        fi
        type1_t.format = type1
        type2_t.format = type2
        type1_t.match_base = base1
        type2_t.match_base = base2
        base1.as_str tc
            .store
            .enums
            .get_str
            .is_some = is_enum1
        base2.as_str tc
            .store
            .enums
            .get_str
            .is_some = is_enum2
        # Same-type rule applies before any specialization.
        if type1_t type2_t.eq ! then
            f"Cannot compare `{type2}` with `{type1}`" tc.raise_type_mismatch
            TYPE_BOOL_T tc.stack_push_type
            op_index return
        fi
        # Enums: tag comparison via bytecode; data-carrying variants need annotation.
        if is_enum1 is_enum2 || then
            if is_enum1 then
                base1.as_str tc
                    .store
                    .enums
                    .get_str
                    .unwrap = casa_enum
                if casa_enum has_inner_values then
                    base1 GenericType::new Type::Generic Option::Some op Op::set_type_hint
                fi
            fi
            TYPE_BOOL_T tc.stack_push_type
            op_index return
        fi
        # str: only ==/!=, annotated for the bytecode emitter.
        if "str" type1.as_str == then
            if is_eq_op ! then
                "Type `str` only supports `==` and `!=` comparison".to_str tc.raise_type_mismatch
            fi
            TYPE_STR_T clone_type Option::Some op Op::set_type_hint
            TYPE_BOOL_T tc.stack_push_type
            op_index return
        fi
        # Other primitives: bytecode handles the comparison directly.
        if type1_t.is_primitive_compare_type_t then
            if type1_t.is_integer_type_t then
                type1_t clone_type Option::Some op Op::set_type_hint
            fi
            TYPE_BOOL_T tc.stack_push_type
            op_index return
        fi
        # User-defined types must satisfy Eq (or Ord) explicitly.
        tc.store function_opt type1_t make_type_borrow_option cmp_value analyze_operation
        = semantics
        trait_name.to_str GenericType::new Type::Generic = trait_type
        if tc.diagnostics tc.store function_opt trait_type type1_t type_satisfies_trait ! then
            cmp_value comparison_op_str = cmp_str
            op Op::location f"Type `{type1}` cannot be compared with `{cmp_str}`: does not satisfy trait `{trait_name}`" ErrorKind::MissingTraitMethod tc.diagnostics.record_error_string
            TYPE_BOOL_T tc.stack_push_type
            op_index return
        fi
        # Lower the operator to the corresponding trait method call.
        if semantics.into_method Option::Some(method) is then
            method.method_name.clone
        else
            cmp_value comparison_method_name.to_str
        fi = method_name
        type2_t tc.stack_push_type
        type1_t tc.stack_push_type
        method_name OpValue::MethodCall op Op::set_value
        function_opt op_index ops op tc.check_method_call
    }
}

