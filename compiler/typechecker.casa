pub fn find_forwarded_layout_argument
    function_opt:mut$std::Option[common::Function]
    parameter_name:$str
-> std::Option[common::OpValue] {
    if function_opt std::Option::Some(caller) is then
        for
            caller_parameter in caller
                .stack_effect
                .parameters
                .iter
        do
            if parameter_name caller_parameter.name.as_str == then
                parameter_name.to_str common::OpValue::PushVar std::Option::Some return
            fi
        done
        if parameter_name caller.captures common::variable_list_contains then
            parameter_name.to_str common::OpValue::PushCapture std::Option::Some return
        fi
    fi
    std::Option[common::OpValue]::None
}

pub fn ensure_function_clone_method
    store:mut$common::SymbolStore
    typ:$common::Type
    location:$common::Location
{
    if typ common::Type::Function(_) is ! then
        return
    fi
    if
        common::STD_COPY_TRAIT store.traits.has_str !
        common::STD_CLONE_TRAIT.to_str store.traits.has ! ||
    then
        return
    fi
    common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
    common::STD_CLONE_TRAIT.to_str common::GenericType::new common::Type::Generic = clone_trait_type
    if store clone_trait_type copy_type semantics::trait_type_implies ! then
        return
    fi

    "clone" typ.make_method_key = function_name
    if function_name.as_str store.has_function then
        return
    fi

    std::List[common::Parameter]::new = parameters
    "self".to_str typ common::clone_type common::Parameter::named parameters.push
    std::List[common::Type]::new = returns
    typ common::clone_type returns.push
    returns parameters common::StackEffect::new = effect

    std::List[common::Op]::new = ops
    location.clone "self".to_str common::OpValue::AssignVar common::Op::new ops.push
    location.clone "self".to_str common::OpValue::PushVar common::Op::new ops.push
    effect location.clone ops function_name.clone common::Function::with_stack_effect = function
    std::List[common::Variable]::new = variables
    typ common::clone_type "self".to_str common::Variable variables.push
    variables function common::Function::set_variables
    function store.set_function
}

impl TypeChecker {
    pub fn bind_concrete_type_variable
        tc:mut$TypeChecker
        name:$str
        actual:$common::Type
        bindings:std::Map[std::String common::Type]
        location:$common::Location
    -> std::Map[std::String common::Type] {
        name bindings.remove_str = existing_option
        if existing_option.is_none then
            actual common::clone_type name.clone bindings.set_str
            bindings return
        fi
        existing_option.unwrap = existing
        if existing.has_unresolved_type_var actual.has_unresolved_type_var ! && then
            actual common::clone_type name.clone bindings.set_str
            bindings return
        fi
        if
            existing.is_integer_literal_t actual.is_integer_type_t &&
            existing.is_float_literal_t actual.is_float_type_t && ||
        then
            actual common::clone_type name.clone bindings.set_str
            bindings return
        fi
        if
            actual.is_integer_literal_t existing.is_integer_type_t &&
            actual.is_float_literal_t existing.is_float_type_t && ||
        then
            existing name.clone bindings.set_str
            bindings return
        fi
        if existing actual.eq ! then
            location f"Type variable `{name}` bound to `{existing.format}` but got `{actual.format}`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        fi
        existing name.clone bindings.set_str
        bindings
    }

    pub fn bind_stack_parameter
        tc:mut$TypeChecker
        parameter:$common::Parameter
        stack_index:u64
        effect:$common::StackEffect
        bindings:std::Map[std::String common::Type]
        location:$common::Location
    -> std::Map[std::String common::Type] {
        stack_index tc
            .stack
            .values
            .get clone_typed_value = value
        value.type_value common::clone_type = actual
        if actual.borrow_target std::Option::Some(target) is then
            target common::clone_type = actual
        fi
        parameter.typ common::clone_type = pattern
        if pattern.borrow_target std::Option::Some(target) is then
            target common::clone_type = pattern
        fi
        if pattern.type_var_name std::Option::Some(type_variable) is then
            if type_variable.as_str effect.type_vars.has_str then
                type_variable.as_str bindings.get_str = existing_option
                if existing_option std::Option::Some(existing) is then
                    if existing.is_borrow then
                        bindings return
                    fi
                fi
                location bindings actual type_variable.as_str tc.bind_concrete_type_variable return
            fi
        fi
        effect.type_vars actual pattern bindings bind_generic_params_standalone = bindings
        actual pattern bindings bind_standalone_constant_parameters
    }

    pub fn finalize_stack_parameter_literals
        tc:mut$TypeChecker
        parameter:$common::Parameter
        stack_index:u64
        effect:$common::StackEffect
        bindings:std::Map[std::String common::Type]
        location:$common::Location
    -> std::Map[std::String common::Type] {
        stack_index tc
            .stack
            .values
            .get clone_typed_value = value
        if 0 value.literals.length == then
            bindings return
        fi
        bindings parameter.typ.substitute_t resolve_numeric_literal_default = target
        tc.literal_resolutions tc.diagnostics target value.resolve_literals drop
        target common::clone_type = value.type_value
        value stack_index tc
            .stack
            .values
            .set
        location bindings effect stack_index parameter tc.bind_stack_parameter
    }

    pub fn resolve_generic_call_bindings
        tc:mut$TypeChecker
        effect:$common::StackEffect
        location:$common::Location
        function_opt:mut$std::Option[common::Function]
        return_hint:std::Option[common::Type]
    -> std::Map[std::String common::Type] {
        std::Map[std::String common::Type]::new = bindings
        std::List[common::Parameter]::new = visible_parameters
        for parameter in effect.parameters.iter do
            if parameter.name.as_str common::is_hidden_parameter_name ! then
                parameter common::clone_parameter visible_parameters.push
            fi
        done

        tc
            .stack
            .values
            .length = depth
        0 (u64) = index
        while index visible_parameters.length > do
            if index depth > then
                depth 1 - index - = stack_index
                index visible_parameters.get = parameter
                location bindings effect stack_index parameter tc.bind_stack_parameter = bindings
            fi
            1 += index
        done
        0 (u64) = index
        while index visible_parameters.length > do
            if index depth > then
                depth 1 - index - = stack_index
                index visible_parameters.get = parameter
                location bindings effect stack_index parameter tc.finalize_stack_parameter_literals
                = bindings
            fi
            1 += index
        done
        tc.store bindings function_opt effect method_diff_bind_all

        if return_hint std::Option::Some(hint) is then
            for return_type in effect.return_types.iter do
                effect.type_vars hint return_type bindings bind_generic_params_standalone = bindings
            done
        fi

        for
            constant_name in effect
                .const_params
                .keys
                .iter
        do
            if constant_name.as_str bindings clone_type_binding std::Option::Some(bound) is then
                bound common::clone_type = resolved_bound
                if function_opt std::Option::Some(caller) is then
                    caller.stack_effect.const_params resolved_bound syntax::rewrite_type_const_params
                    = resolved_bound
                fi
                resolved_bound constant_name.clone bindings.set
            fi
        done
        function_opt location bindings effect tc.validate_generic_bindings
        bindings
    }

    pub fn validate_generic_bindings
        tc:mut$TypeChecker
        effect:$common::StackEffect
        bindings:mut$std::Map[std::String common::Type]
        location:$common::Location
        function_opt:mut$std::Option[common::Function]
    {
        for
            constant_name in effect
                .const_params
                .keys
                .iter
        do
            if constant_name.as_str bindings clone_type_binding std::Option::Some(bound) is then
                if bound common::Type::Const is ! then
                    location f"Constant parameter `{constant_name}` requires a compile-time constant, got `{bound.format}`"
                    common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                fi
            else
                location f"Cannot determine the value of constant parameter `{constant_name}`"
                common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi
        done
        for
            type_variable in effect
                .trait_bounds
                .keys
                .iter
        do
            type_variable.as_str bindings clone_type_binding = concrete_opt
            if concrete_opt.is_none then
                location f"Cannot determine concrete type for type variable `{type_variable}`"
                common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                continue
            fi
            concrete_opt.unwrap = concrete
            concrete.format = concrete_name
            for
                bound in type_variable effect
                    .trait_bounds
                    .get
                    .unwrap
                    .iter
            do
                bound common::trait_bound_to_type = trait_type
                bindings trait_type.substitute_t = resolved_trait
                tc.store resolved_trait concrete_name.as_str function_opt caller_forwards_trait_bound
                = forwards_bound
                if
                    forwards_bound ! tc.diagnostics tc.store function_opt resolved_trait concrete
                    type_satisfies_trait ! &&
                then
                    location f"Type `{concrete_name}` does not satisfy trait `{resolved_trait.format}`"
                    common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                fi
            done
        done
    }
}

# ============================================================================
# Check function-related operations
# ============================================================================

impl TypeChecker {
    # ADR-0112: a typed borrow reconstructed from a raw address inside `unsafe`
    # is anchored conservatively to every compatible borrowed input of the
    # enclosing function. A shared borrow accepts any borrowed input; an
    # exclusive borrow accepts only exclusive inputs (ADR-0113). A function with
    # no compatible input yields no origin, so the borrow cannot escape.
    pub fn raw_borrow_input_origins
        self:mut$TypeChecker
        function_opt:mut$std::Option[common::Function]
        exclusive:bool
    -> std::Option[std::List[std::String]] {
        std::Option[std::List[std::String]]::None = origins
        if function_opt std::Option::Some(function) is then
            for
                parameter in function
                    .stack_effect
                    .parameters
                    .iter
            do
                if exclusive then
                    if self.store parameter.typ type_has_exclusive_borrow ! then
                        continue
                    fi
                elif self.store parameter.typ type_has_borrow ! then
                    continue
                fi
                exclusive parameter.name.as_str origins add_origin = origins
            done
        fi
        origins
    }

    pub fn is_return_origin_valid
        self:mut$TypeChecker
        function:$common::Function
        origin:$str
    -> bool {
        origin.as_str origin_is_exclusive = exclusive
        origin.as_str origin_place = place
        place.as_str get_place_root = root
        if
            root self
                .store
                .variables
                .has
        then
            true return
        fi
        for
            parameter in function
                .stack_effect
                .parameters
                .iter
        do
            if root parameter.name == then
                if exclusive then
                    self.store parameter.typ type_has_exclusive_borrow return
                fi
                self.store parameter.typ type_has_borrow return
            fi
        done
        false
    }

    pub fn report_overlapping_origin_lists
        self:mut$TypeChecker
        first_origins:$std::List[std::String]
        second_origins:$std::List[std::String]
    {
        for first_origin in first_origins.iter do
            if first_origin.as_str origin_is_exclusive ! then
                continue
            fi
            if first_origins first_origin.as_str has_origin_descendant then
                continue
            fi
            for second_origin in second_origins.iter do
                if second_origin.as_str origin_is_exclusive ! then
                    continue
                fi
                if second_origins second_origin.as_str has_origin_descendant then
                    continue
                fi
                first_origin.as_str origin_place = first_place
                second_origin.as_str origin_place = second_place
                if first_place.as_str second_place.as_str origin_matches_place ! then
                    continue
                fi
                self.current_location
                f"Cannot return overlapping exclusive places `{first_place}` and `{second_place}`"
                common::ErrorKind::InvalidVariable self.diagnostics.record_error_string
            done
        done
    }

    pub fn report_overlapping_return_origins
        self:mut$TypeChecker
        first_value:$TypedValue
        second_value:$TypedValue
    {
        if first_value.origins std::Option::Some(first_origins) is then
            if second_value.origins std::Option::Some(second_origins) is then
                second_origins first_origins self.report_overlapping_origin_lists
            fi
        fi
    }

    pub fn generated_return_has_implicit_borrow_origin
        self:mut$TypeChecker
        function:$common::Function
    -> bool {
        f"::{common::STD_COPY_TRAIT}::clone" = copy_clone_suffix
        if function.name.as_str copy_clone_suffix.as_str str::ends_with then
            true return
        fi
        if
            1 function
                .stack_effect
                .parameters
                .length !=
        then
            false return
        fi
        0 function
            .stack_effect
            .parameters
            .get
            .typ = receiver: $common::Type
        receiver function.name.as_str self.find_struct_getter_field.is_some
    }

    pub fn validate_borrow_returns self:mut$TypeChecker function:mut$common::Function {
        0 (u64) = index
        while
            index self
                .stack
                .values
                .length > index function
                .stack_effect
