                forwarded_name.as_str function_opt find_forwarded_layout_argument = forward_value
                forward_value match
                    Option::Some(value) => location.clone value Op::new Option::Some = layout_operation
                    Option::None => {
                        if is_drop function_opt.is_some && then
                            resolved_type clone_type tc.required_drop_types.push
