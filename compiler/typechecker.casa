                bound_index trait_bounds.get = trait_bound
                trait_bound trait_bound_to_type = trait_bound_type
                bindings trait_bound_type.substitute_t = resolved_trait_type
                resolved_trait_type.format = trait_name
                if
                    trait_bound.name.as_str tc
                        .store
                        .traits
                        .has_str !
                then
                    continue
                fi

                tc.store resolved_trait_type concrete.as_str function_opt caller_forwards_trait_bound
                = is_forwarding

