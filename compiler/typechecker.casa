                tc.literal_resolutions tc.diagnostics inferred right.resolve_literals drop
                inferred common::Parameter::new tc.parameters.push
                false std::Option[std::List[std::String]]::None std::Option[i64]::None std::Option[std::String]::None
                ValueCapability::Owned std::Option[std::String]::None
