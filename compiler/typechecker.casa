}

impl TypeChecker {
    pub fn bind_fn_param
        tc:mut$TypeChecker
        bindings:mut$std::Map[std::String common::Type]
        expected:$common::Parameter
        effect:$common::StackEffect
    -> bool {
        # Bind type vars from a function-type param like fn[T -> T].
        if expected common::Parameter::typ.is_fn_type_t ! then
            false return
        fi
        # Check if any type var appears in the function type.
        false = has_type_var
        effect common::StackEffect::type_vars.to_list = type_var_list
        for type_var in type_var_list.iter do
            if type_var.as_str expected common::Parameter::typ.type_contains_var then
                true = has_type_var
            fi
        done
        if has_type_var ! then
            false return
        fi

        tc.stack_pop_value = function_value
        if expected.typ.is_borrow then
            function_value tc.release_value
        else
            function_value tc.consume_value
        fi
        function_value.type_value common::clone_type = actual
        if actual.is_unknown_placeholder then
            for type_var2 in type_var_list.iter do
                if type_var2.as_str expected common::Parameter::typ.type_contains_var then
                    common::make_unknown_type type_var2.as_str bindings tc.bind_type_var
                fi
            done
            tc.current_location "Cannot infer generic callback type. Add explicit callback parameter types."
            common::ErrorKind::TypeMismatch tc.diagnostics.record_error
            true return
        fi
        if actual.is_fn_type_t ! then
            "Type mismatch".to_str tc.raise_type_mismatch
            true return
        fi
        actual common::clone_type = validated_actual
        expected common::Parameter::typ match
            common::Type::Function(expected_fn) => {
                actual match
                    common::Type::Function(actual_fn) => {
                        expected_fn.parameters = expected_fn_params: $std::List[common::Type]
                        actual_fn.parameters = actual_fn_params: $std::List[common::Type]
                        0 (u64) = param_index
                        while
                            param_index expected_fn_params.length >
                            param_index actual_fn_params.length > &&
                        do
                            param_index expected_fn_params.get = expected_param
                            param_index actual_fn_params.get = actual_param
                            bindings actual_param expected_param semantics::bind_semantic_type_arguments
                            1 += param_index
                        done
                        expected_fn.return_types = expected_fn_returns: $std::List[common::Type]
                        actual_fn.return_types = actual_fn_returns: $std::List[common::Type]
                        0 (u64) = return_index
                        while
                            return_index expected_fn_returns.length >
                            return_index actual_fn_returns.length > &&
                        do
                            return_index expected_fn_returns.get = expected_return
                            return_index actual_fn_returns.get = actual_return
                            bindings actual_return expected_return semantics::bind_semantic_type_arguments
                            1 += return_index
                        done
                    }
                    _ => {
                    }
                end
            }
            _ => {
            }
        end
        bindings expected.typ.substitute_t = resolved_expected
        if validated_actual resolved_expected.eq ! then
            f"Expected `{resolved_expected.format}`, got `{validated_actual.format}`".to_str tc.raise_type_mismatch
        fi
        true
    }
}

