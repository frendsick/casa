    }
}

# ============================================================================
# Check function-related operations
# ============================================================================

impl TypeChecker {
    # ADR-0112: a typed borrow reconstructed from a raw address inside `unsafe`
    # is anchored conservatively to every compatible borrowed input of the
    # enclosing function. A shared borrow accepts any borrowed input; an
    # exclusive borrow accepts only exclusive inputs (ADR-0113). A function with
    # no compatible input yields no origin, so the borrow cannot escape.
    fn raw_borrow_input_origins
        self:mut$TypeChecker
        function_opt:mut$Option[Function]
        exclusive:bool
    -> Option[List[String]] {
        Option[List[String]]::None = origins
        if function_opt Option::Some(function) is then
            for
                parameter in function
                    .stack_effect
                    .parameters
                    .iter
            do
                if exclusive then
                    if self.store parameter.typ type_has_exclusive_borrow ! then
                        continue
                    fi
                elif self.store parameter.typ type_has_borrow ! then
                    continue
                fi
                exclusive parameter.name.as_str origins add_origin = origins
            done
        fi
        origins
    }

    fn is_return_origin_valid self:mut$TypeChecker function:$Function origin:$str -> bool {
        origin.as_str origin_is_exclusive = exclusive
        origin.as_str origin_place = place
        place.as_str get_place_root = root
        if
            root self
                .store
                .variables
                .has
        then
            true return
        fi
        for
            parameter in function
                .stack_effect
                .parameters
                .iter
        do
            if root parameter.name == then
                if exclusive then
                    self.store parameter.typ type_has_exclusive_borrow return
                fi
                self.store parameter.typ type_has_borrow return
            fi
        done
        false
    }

    fn report_overlapping_origin_lists
        self:mut$TypeChecker
        first_origins:$List[String]
        second_origins:$List[String]
    {
        for first_origin in first_origins.iter do
            if first_origin.as_str origin_is_exclusive ! then
                continue
            fi
            if first_origins first_origin.as_str has_origin_descendant then
                continue
            fi
            for second_origin in second_origins.iter do
                if second_origin.as_str origin_is_exclusive ! then
                    continue
                fi
                if second_origins second_origin.as_str has_origin_descendant then
                    continue
                fi
                first_origin.as_str origin_place = first_place
                second_origin.as_str origin_place = second_place
                if first_place.as_str second_place.as_str origin_matches_place ! then
                    continue
                fi
                self.current_location
                f"Cannot return overlapping exclusive places `{first_place}` and `{second_place}`"
                ErrorKind::InvalidVariable self.diagnostics.record_error_string
            done
        done
    }

    fn report_overlapping_return_origins
        self:mut$TypeChecker
        first_value:$TypedValue
        second_value:$TypedValue
    {
        if first_value.origins Option::Some(first_origins) is then
            if second_value.origins Option::Some(second_origins) is then
                second_origins first_origins self.report_overlapping_origin_lists
            fi
        fi
    }

    fn generated_return_has_implicit_borrow_origin self:mut$TypeChecker function:$Function -> bool {
        if function.name.as_str "::Copy::clone" str::ends_with then
            true return
        fi
        if
            1 function
                .stack_effect
                .parameters
                .length !=
        then
            false return
        fi
        0 function
            .stack_effect
            .parameters
            .get
            .typ = receiver: $Type
        receiver function.name.as_str self.find_struct_getter_field.is_some
    }

    fn validate_borrow_returns self:mut$TypeChecker function:mut$Function {
        0 (u64) = index
        while
            index self
                .stack
                .values
                .length > index function
                .stack_effect
                .return_types
                .length > &&
        do
            index function
                .stack_effect
