# ============================================================================
# Check enum variant push
# ============================================================================

pub fn get_enum_variant_shape
    enum_name:$str
    variant_name:$str
    store:$common::SymbolStore
-> std::Option[std::List[std::String]] std::List[common::Type] {
    std::List[common::Type]::new = payload_types
    if enum_name store.enums.get_str std::Option::Some(casa_enum) is then
        if variant_name casa_enum.variant_types.get_str std::Option::Some(found_types) is then
            for found_type in found_types.iter do
                found_type common::clone_type payload_types.push
            done
        fi
        casa_enum.type_vars.clone std::Option::Some payload_types
    else
        std::Option[std::List[std::String]]::None payload_types
    fi
}

pub fn get_enum_variant_arity
    enum_name:$str
    variant_name:$str
    store:$common::SymbolStore
-> std::Option[u64] {
    if enum_name store.enums.get_str std::Option::Some(casa_enum) is then
        if variant_name casa_enum.variant_types.get_str std::Option::Some(payload_types) is then
            payload_types.length std::Option::Some return
        fi
    fi
    std::Option[u64]::None
}

impl TypeChecker {
    pub fn check_enum_variant
        tc:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        if op.value common::OpValue::PushEnumVariant(variant) is then
            variant common::EnumVariant::enum_name.clone = enum_name
            tc.store variant.variant_name.as_str enum_name.as_str get_enum_variant_shape = inner_types
            = type_variables_opt
            if type_variables_opt std::Option::Some(type_variables) is then
                if 0 inner_types.length == then
                    if op.type_hint std::Option::Some(explicit_type) is then
                        op.location function_opt explicit_type tc.validate_type_exists
                        explicit_type tc.stack_push_type
                    elif 0 type_variables.length != then
                        type_variables enum_name.as_str common::build_parameterized_type tc.stack_push_type
                    else
                        enum_name common::GenericType::new common::Type::Generic tc.stack_push_type
                    fi
                    return
                fi

                std::Map[std::String common::Type]::new = bindings
                if op.type_hint std::Option::Some(hint) is then
                    if enum_name hint.match_base == then
                        type_variables hint common::aggregate_type_bindings = bindings
                    fi
                fi
                std::Option[std::List[std::String]]::None = origins
                for expected in inner_types.iter do
                    origins bindings expected tc.expect_aggregate_value = origins
                done
                if 0 type_variables.length != then
                    bindings type_variables enum_name.as_str common::build_resolved_type
                else
                    enum_name common::GenericType::new common::Type::Generic
                fi = result_type
                origins result_type tc.stack_push_origins
            else
                enum_name common::GenericType::new common::Type::Generic tc.stack_push_type
            fi
        fi
    }
}

# ============================================================================
# diagnose_bare_enum_pattern — emit a targeted error if a match arm uses an
# unqualified enum variant (e.g. `North =>` instead of `Direction::North =>`).

impl TypeChecker {
    fn diagnose_bare_enum_pattern
        self:mut$TypeChecker
        op:mut$common::Op
        variant:common::EnumVariant
        arm_base:$str
    {
        if "" variant common::EnumVariant::enum_name.as_str != then
            return
        fi
        if
            arm_base self
                .store
                .enums
                .get_str std::Option::Some(bare_enum) is
        then
            variant common::EnumVariant::variant_name.as_str = bare_name: $str
            bare_name bare_enum common::CasaEnum::variants common::string_list_index = bare_index
            if 0 bare_index >= then
                op common::Op::location f"Unqualified enum variant `{bare_name}`. Did you mean `{arm_base}::{bare_name}`?" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
            else
                op common::Op::location f"Expected qualified enum variant (e.g. `{arm_base}::{0 bare_enum common::CasaEnum::variants.get}`) or `_`, got `{bare_name}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
            fi
        fi
    }

    # ============================================================================
    # detect_duplicate_arm — raise an error if the current pattern's covered key
    # has already been recorded on this match context.

    fn detect_duplicate_arm
        self:mut$TypeChecker
        match_ctx:mut$MatchContext
        op:mut$common::Op
        covered_key:$str
    {
        if "" covered_key.as_str == then
            return
        fi
        for record in match_ctx MatchContext::branch_records.iter do
            if covered_key record.as_str == then
                op common::Op::location f"Duplicate match arm for `{covered_key}`" common::ErrorKind::DuplicateName self.diagnostics.record_error_string
            fi
        done
        if covered_key match_ctx MatchContext::current_branch_label.as_str == then
            op common::Op::location f"Duplicate match arm for `{covered_key}`" common::ErrorKind::DuplicateName self.diagnostics.record_error_string
        fi
    }

    # ============================================================================
    # unify_arm_stacks — reconcile the stack effect of the arm just finished
    # against the arm template recorded on the MatchContext. Runs only when a
    # prior arm has already executed (condition_present).

    fn unify_arm_stacks self:mut$TypeChecker match_ctx:mut$MatchContext op:mut$common::Op {
        if "" match_ctx MatchContext::current_branch_label.as_str != then
            match_ctx MatchContext::current_branch_label.clone match_ctx MatchContext::branch_records.push
        fi
        match_ctx MatchContext::before = match_before: mut$TypedStack
        match_ctx MatchContext::after = match_after: mut$TypedStack
        if
            match_before self.stack.equals
            match_after match_before.equals && !
        then
            self.store match_after self.stack.unify_types = unified
            if 0 unified.length != match_after match_before.equals ! && then
                self.stack match_after.merge_literals
                match_after.mark_literals_runtime
                unified match_after.set_types
            elif match_after match_before.equals then
                self.stack match_after.restore
            else
                op common::Op::location "Match arms have incompatible stack effects" common::ErrorKind::StackMismatch self.diagnostics.record_error
            fi
        fi
        match_before self.stack.restore
    }

    # ============================================================================
    # register_struct_pattern_bindings — attach field types to each local bound
    # by a struct destructure arm.

    fn assign_struct_binding_type
        self:mut$TypeChecker
        match_subject_type:$common::Type
        binding_type:common::Type
        bound_var:$str
        function_opt:mut$std::Option[common::Function]
    {
        if match_subject_type.is_borrow function_opt binding_type self.type_is_duplicable ! && then
            binding_type common::clone_type = target
            false = shared
            if binding_type.borrow_target std::Option::Some(borrowed_target) is then
                borrowed_target common::clone_type = target
                binding_type.is_shared_borrow = shared
            fi
            if match_subject_type.is_shared_borrow then
                true = shared
            fi
            if shared then
                common::SHARED_BORROW_TYPE
            else
                common::EXCLUSIVE_BORROW_TYPE
            fi
            target common::apply_borrow_type = binding_type
        fi
        function_opt binding_type bound_var self set_binding_type
    }
}

fn resolve_struct_pattern_field_types
    subject_type:$common::Type
    struct_name:$str
    store:$common::SymbolStore
-> std::Option[std::Map[std::String common::Type]] {
    if struct_name store.structs.get_str std::Option::Some(casa_struct) is then
        subject_type common::clone_type = owned_subject_type
        if owned_subject_type.borrow_target std::Option::Some(target) is then
            target common::clone_type = owned_subject_type
        fi
        casa_struct.type_vars owned_subject_type common::aggregate_type_bindings = bindings
        std::Map[std::String common::Type]::new = field_types
        for member in casa_struct.members.iter do
            bindings member.typ.substitute_t member.name.clone field_types.set
        done
        field_types std::Option::Some
    else
        std::Option[std::Map[std::String common::Type]]::None
    fi
}

impl TypeChecker {
    fn register_struct_pattern_bindings
        self:mut$TypeChecker
        function_opt:mut$std::Option[common::Function]
        struct_pattern:common::StructPattern
        match_subject_type:$common::Type
    {
        self.store struct_pattern.struct_name.as_str match_subject_type resolve_struct_pattern_field_types
        = field_types_opt
        if field_types_opt.is_none then
            common::empty_location "Expected option value while unwrapping struct_pattern StructPattern::struct_name self.store.structs.get" common::ErrorKind::Syntax self.diagnostics.record_error
            return
        fi
        field_types_opt.unwrap = field_types
        struct_pattern common::StructPattern::bindings.keys = binding_keys
        for field_name in binding_keys.iter do
            if
                field_name struct_pattern common::StructPattern::bindings.get std::Option::Some(bound_var) is
            then
                if field_name field_types.get std::Option::Some(binding_type) is then
                    function_opt bound_var.as_str binding_type common::clone_type match_subject_type self.assign_struct_binding_type
                fi
            else
                common::empty_location "Expected option value while unwrapping field_name struct_pattern StructPattern::bindings.get" common::ErrorKind::Syntax self.diagnostics.record_error
            fi
        done
    }

    # ============================================================================
    # register_enum_pattern_bindings — attach payload types to each local bound
    # by an enum-variant destructure arm.

    fn register_enum_pattern_bindings
        self:mut$TypeChecker
        function_opt:mut$std::Option[common::Function]
        variant:common::EnumVariant
        match_subject_type:$common::Type
    {
        if 0 variant common::EnumVariant::bindings.length == then
            return
        fi
        "" = borrow_prefix
        match_subject_type common::clone_type = subject_type
        if match_subject_type.borrow_target std::Option::Some(target) is then
            if match_subject_type.is_shared_borrow then
                common::SHARED_BORROW_TYPE
            else
                common::EXCLUSIVE_BORROW_TYPE
            fi
            = borrow_prefix
            target common::clone_type = subject_type
        fi
        subject_type.match_base = base_enum_name
        if
            self.store base_enum_name.as_str variant.variant_name.as_str subject_type resolve_enum_pattern_types
            std::Option::Some(inner_types) is
        then
            match_subject_type borrow_prefix variant inner_types function_opt self.apply_enum_bindings
        fi
    }
}

fn resolve_enum_pattern_types
    subject_type:$common::Type
    variant_name:$str
    enum_name:$str
    store:$common::SymbolStore
-> std::Option[std::List[common::Type]] {
    if enum_name store.enums.get_str std::Option::Some(casa_enum) is then
        subject_type casa_enum build_enum_type_bindings = type_bindings
        if variant_name casa_enum.variant_types.get_str std::Option::Some(payload_types) is then
            std::List[common::Type]::new = resolved_types
            for payload_type in payload_types.iter do
                type_bindings payload_type.substitute_t resolved_types.push
            done
            resolved_types std::Option::Some return
        fi
    fi
    std::Option[std::List[common::Type]]::None
}

fn build_enum_type_bindings
    casa_enum:$common::CasaEnum
    match_subject_type:$common::Type
-> std::Map[std::String common::Type] {
    std::Map[std::String common::Type]::new = type_bindings
    if 0 casa_enum common::CasaEnum::type_vars.length == then
        type_bindings return
    fi
    if match_subject_type.type_params std::Option::Some(type_params) is then
        0 (u64) = type_var_index
        while
            type_var_index casa_enum common::CasaEnum::type_vars.length >
            type_var_index type_params.length > &&
        do
            type_var_index type_params.get common::clone_type
            type_var_index casa_enum common::CasaEnum::type_vars.get.clone
            type_bindings.set
            1 += type_var_index
        done
    fi
    type_bindings
}

impl TypeChecker {
    fn apply_enum_bindings
        self:mut$TypeChecker
        function_opt:mut$std::Option[common::Function]
        inner_types:$std::List[common::Type]
        variant:$common::EnumVariant
        borrow_prefix:$str
        match_subject_type:$common::Type
    {
        0 (u64) = bind_index
        while
            bind_index variant common::EnumVariant::bindings.length >
            bind_index inner_types.length > &&
        do
            bind_index variant common::EnumVariant::bindings.get = binding_var
            bind_index inner_types.get common::clone_type = binding_type
            if "" borrow_prefix.as_str != function_opt binding_type self.type_is_duplicable ! && then
                binding_type common::clone_type = target
                common::SHARED_BORROW_TYPE borrow_prefix == = shared
                if binding_type.borrow_target std::Option::Some(borrowed_target) is then
                    borrowed_target common::clone_type = target
                    if binding_type.is_shared_borrow then
                        true = shared
                    fi
                fi
                if match_subject_type.is_shared_borrow then
                    true = shared
                fi
                if shared then
                    common::SHARED_BORROW_TYPE
                else
                    common::EXCLUSIVE_BORROW_TYPE
                fi
                target common::apply_borrow_type = binding_type
            fi
            function_opt binding_type binding_var.as_str self set_binding_type
            1 += bind_index
        done
    }

    # ============================================================================
    # register_pattern_bindings — dispatch binding registration by pattern kind.

    fn register_pattern_bindings
        self:mut$TypeChecker
        function_opt:mut$std::Option[common::Function]
        op:mut$common::Op
        match_subject_type:$common::Type
    {
        op common::pattern_value_of match
            common::PatternValue::Struct(struct_pattern) => {
                match_subject_type struct_pattern function_opt self.register_struct_pattern_bindings
            }
            common::PatternValue::EnumVariant(variant) => {
                if op pattern::pattern_is_wildcard then
                    return
                fi
                match_subject_type variant function_opt self.register_enum_pattern_bindings
            }
            common::PatternValue::Literal => {
            }
        end
    }

    fn record_match_pattern_origins
        self:mut$TypeChecker
        op:mut$common::Op
        match_subject_type:$common::Type
        match_origins:mut$std::Option[std::List[std::String]]
        match_place:mut$std::Option[std::String]
        function_opt:mut$std::Option[common::Function]
    {
        for binding_name in op pattern::pattern_bindings.iter do
            if binding_name.as_str self.scope.lookup std::Option::Some(binding_type) is then
                if
                    self.store binding_type type_has_borrow
                    match_subject_type.is_borrow
                    function_opt binding_type self.type_is_duplicable ! && ||
                then
                    match_origins clone_origins = origins
                    if match_subject_type.is_borrow then
                        if match_place std::Option::Some(subject_place) is then
                            subject_place.clone = binding_place
                            if op common::pattern_value_of common::PatternValue::Struct(struct_pattern) is then
                                for pair in struct_pattern.bindings.iter do
                                    if pair.second binding_name == then
                                        f"{subject_place}.{pair.first}" = binding_place
                                    fi
                                done
                            fi
                            binding_type.is_exclusive_borrow binding_place.as_str origins add_origin = origins
                        fi
                    fi
                    origins binding_name.as_str self.record_binding_origins
                fi
            fi
        done
    }

    fn check_literal_pattern
        self:mut$TypeChecker
        op:mut$common::Op
        literal_pattern:common::LiteralPattern
        subject_type:$common::Type
    {
        subject_type common::clone_type = pattern_type
        if pattern_type.borrow_target std::Option::Some(target) is then
            target common::clone_type = pattern_type
        fi
        if pattern_type.is_unknown_placeholder then
            return
        fi
        literal_pattern.value match
            common::LiteralValue::Int(literal) => {
                if pattern_type.is_integer_type_t ! then
                    op.location f"Integer pattern `{literal.raw}` requires an integer subject, got `{pattern_type.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
                if pattern_type literal.fits ! then
                    pattern_type.get_integer_min = minimum
                    pattern_type.get_integer_max = maximum
                    op.location f"Integer pattern `{literal.raw}` is outside `{pattern_type.format}` range {minimum}..{maximum}" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
            }
            common::LiteralValue::Str(_) => {
                if pattern_type common::make_str_type.eq ! then
                    op.location f"String pattern requires a `str` subject, got `{pattern_type.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
            }
            common::LiteralValue::Bool(_) => {
                if pattern_type common::make_bool_type.eq ! then
                    op.location f"Boolean pattern requires a `bool` subject, got `{pattern_type.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
            }
            common::LiteralValue::Char(_) => {
                if pattern_type common::make_char_type.eq ! then
                    op.location f"Character pattern requires a `char` subject, got `{pattern_type.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
            }
        end
        subject_type common::clone_type std::Option::Some op common::Op::set_type_hint
    }

    # ============================================================================
    # typecheck_match_op — per-arm typecheck entry point.
    #
    # Handles pattern-shape validation, duplicate-arm detection, match-arm
    # stack unification, and binding-type registration for a single OpMatchArm.
    # Callers (currently check_match) delegate the entire arm body to this
    # function; start/end of the match block remain in check_match.

    fn typecheck_match_op
        self:mut$TypeChecker
        function_opt:mut$std::Option[common::Function]
        op:mut$common::Op
    {
        if 0 self.branched_stacks.length == then
            return
        fi
        self.branched_stacks.pop = top_frame
        if top_frame BranchFrame::BranchMatch is then
            top_frame.into_match = match_ctx
            if match_ctx.condition_present then
                if self.path_continues then
                    match_ctx.before self.materialize_branch_results
                fi
                match_ctx.flow_after self.merge_current_ownership_flow
                if self.path_continues then
                    true = match_ctx.has_continuing_arm
                fi
                match_ctx.flow_before self.restore_ownership_flow
                match_ctx.entry_continues = self.path_continues
            fi
            match_ctx MatchContext::match_type common::clone_type = match_subject_type
            op pattern::pattern_covered_key = covered_key
            match_subject_type.match_base = arm_base

            # A prior arm has already opened (and left open) its scope frame iff the
            # match has seen a condition. Capture this before the block below sets it.
            match_ctx MatchContext::condition_present = arm_has_predecessor

            op common::pattern_value_of match
                common::PatternValue::EnumVariant(variant) => {
                    if op pattern::pattern_is_wildcard ! then
                        arm_base.as_str variant op self.diagnose_bare_enum_pattern
                    fi
                }
                common::PatternValue::Literal(literal_pattern) => {
                    match_subject_type literal_pattern op self.check_literal_pattern
                }
                _ => {
                }
            end

            covered_key.as_str op match_ctx self.detect_duplicate_arm

            if match_ctx MatchContext::condition_present then
                op match_ctx self.unify_arm_stacks
            else
                true match_ctx MatchContext::set_condition_present
                self.stack match_ctx MatchContext::before.restore
                self.stack match_ctx MatchContext::after.restore
            fi

            # Each arm body gets its own scope frame: pattern bindings and any
            # block-local assignments live here, invisible to other arms and after
            # `end`. Close the previous arm's frame before opening this one.
            if arm_has_predecessor then
                op self.attach_scope_cleanups
                self.scope.exit
            fi
            self.scope.enter

            # Record pattern bindings in the arm scope; implicit bindings cannot
            # shadow an accessible outer variable (same rule as is-bindings).
            for binding_var in op pattern::pattern_bindings.iter do
                op binding_var.as_str self.record_implicit_binding
            done

            match_subject_type op function_opt self.register_pattern_bindings
            function_opt match_ctx.match_place match_ctx.match_origins match_subject_type op self.record_match_pattern_origins
            match_subject_type common::clone_type std::Option::Some op common::Op::set_type_hint
            for binding_var in op pattern::pattern_bindings.iter do
                if binding_var.as_str self.scope.lookup std::Option::Some(binding_type) is then
                    false function_opt binding_type binding_var.as_str op self.record_owner_assignment
                fi
            done

            if op pattern::pattern_is_guarded then
                op common::pattern_guard_ops = guard_ops
                self.scope.snapshot = guard_scope
                self.current_ownership_flow = guard_flow
                self.diagnostics self.store TypeChecker::new = guard_checker
                guard_scope = guard_checker.scope
                guard_flow guard_checker.restore_ownership_flow
                std::Map[std::String u64]::new guard_ops count_variable_uses = guard_checker.remaining_uses
                function_opt guard_ops guard_checker.run_type_check_ops
                for name in guard_checker.moved_owners.iter do
                    if name.as_str self.moved_owners common::string_list_contains ! then
                        op.location f"Match guard cannot move owner `{name}`"
                        common::ErrorKind::InvalidVariable guard_checker.diagnostics.record_error_string
                    fi
                done
                guard_checker.stack.get_types = guard_stack
                false = guard_ok
                if 1 guard_stack.length == then
                    0 guard_stack.get.format = guard_type
                    if "bool" guard_type.as_str == then
                        true = guard_ok
                    fi
                fi
                if guard_ok ! then
                    op common::Op::location "Guard expression must leave a single `bool` on the stack" common::ErrorKind::TypeMismatch guard_checker.diagnostics.record_error
                fi
            fi

            covered_key match_ctx MatchContext::set_current_branch_label
            op common::Op::location.clone match_ctx MatchContext::set_current_branch_location
            match_ctx BranchFrame::BranchMatch = top_frame
        fi
        top_frame self.branched_stacks.push
    }
}

# ============================================================================
# Check is keyword
# ============================================================================

impl TypeChecker {
    pub fn check_is
        tc:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        tc.stack_pop_value = subject
        subject tc.release_value
        subject.type_value common::clone_type = typ
        typ common::clone_type = subject_type
        if typ.borrow_target std::Option::Some(target) is then
            target common::clone_type = subject_type
        fi
        subject_type.match_base = base
        if
            base tc
                .store
                .enums
                .has !
        then
            f"`is` requires an enum type, got `{subject_type.format}`" tc.raise_type_mismatch
            common::make_bool_type tc.stack_push_type
            return
        fi
        op.value common::clone_op_value = is_value
        if is_value common::OpValue::IsCheck(variant) is then
            # Validate the variant belongs to the correct enum
            if "" variant common::EnumVariant::enum_name.as_str != then
                if variant common::EnumVariant::enum_name base != then
                    f"Cannot check `{variant common::EnumVariant::enum_name}::{variant common::EnumVariant::variant_name}` on value of type `{typ.format}`" tc.raise_type_mismatch
                fi
            fi
            # Validate binding count for data-carrying variants
            if 0 variant common::EnumVariant::bindings.length != then
                tc.store variant.variant_name.as_str base.as_str get_enum_variant_arity = arity_opt
                if arity_opt std::Option::Some(arity) is then
                    if variant common::EnumVariant::bindings.length arity != then
                        f"Variant `{variant common::EnumVariant::enum_name}::{variant common::EnumVariant::variant_name}` has {arity} inner value(s), but {variant common::EnumVariant::bindings.length} binding(s) provided" tc.raise_type_mismatch
                    fi
                fi
                if tc.in_branch_condition ! then
                    op common::Op::location "`is` with bindings is only allowed in if/elif conditions" common::ErrorKind::InvalidScope tc.diagnostics.record_error
                    common::make_bool_type tc.stack_push_type
                    return
                fi
            fi
            # Track bindings in scope; implicit bindings cannot shadow outer vars.
            for binding_var in variant common::EnumVariant::bindings.iter do
                op binding_var.as_str tc.record_implicit_binding
            done
            variant.bindings.clone = binding_names
            typ common::clone_type = observed_type
            typ.match_base = observed_base
            if
                observed_base.as_str common::SHARED_BORROW_TYPE !=
                observed_base.as_str common::EXCLUSIVE_BORROW_TYPE != &&
            then
                common::SHARED_BORROW_TYPE observed_type common::apply_borrow_type = observed_type
            fi
            observed_type variant.clone function_opt tc.register_enum_pattern_bindings
            subject.origins clone_origins = binding_origins
            if subject.place std::Option::Some(subject_place) is then
                false subject_place.as_str binding_origins add_origin = binding_origins
            fi
            binding_origins binding_names tc.record_pattern_origins
        fi
        common::make_bool_type tc.stack_push_type
    }
}

# ============================================================================
# Check match blocks
# ============================================================================

pub fn set_binding_type
    tc:mut$TypeChecker
    var_name:$str
    field_type:$common::Type
    function_opt:mut$std::Option[common::Function]
{
    false var_name.as_str tc.set_owner_moved
    field_type var_name.as_str tc.scope.set_type = scope_updated
    if function_opt.is_none then
        var_name.as_str tc
            .store
            .variables
            .remove_str = global_opt
        if global_opt std::Option::Some(global_var) is then
            global_var common::clone_variable = updated_global
            field_type common::clone_type updated_global common::Variable::set_typ
            updated_global var_name.clone tc
                .store
                .variables
                .set_str
            return
        fi
    fi
    if scope_updated then
        return
    fi
    if function_opt std::Option::Some(function) is then
        for variable in function common::Function::variables.iter do
            if var_name variable common::Variable::name.as_str == then
                false var_name.as_str tc.scope.assign
                field_type var_name.as_str tc.scope.set_type drop
                return
            fi
        done
    fi
    var_name.as_str tc
        .store
        .variables
        .remove_str = global_opt
    if global_opt std::Option::Some(global_var_fallback) is then
        global_var_fallback common::clone_variable = updated_global
        field_type common::clone_type updated_global common::Variable::set_typ
        updated_global var_name.clone tc
            .store
            .variables
            .set_str
    fi
}

impl TypeChecker {
    fn begin_match
        self:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        std::Option[std::List[std::String]]::None = match_origins
        std::Option[std::String]::None = match_place
        if
            0 self
                .stack
                .values
                .length ==
        then
            self.within_param_cap = inferring_stack_effect
            if function_opt std::Option::Some(function) is then
                if function common::Function::name.as_str "lambda__" str::starts_with ! then
                    false = inferring_stack_effect
                fi
            else
                false = inferring_stack_effect
            fi
            if inferring_stack_effect ! then
                op common::Op::location "`match` requires a subject value on the stack" common::ErrorKind::StackUnderflow self.diagnostics.record_error
                true = self.underflow_reported_this_op
            fi
        fi
        0 self
            .stack
            .values
            .length != = has_match_subject
        self.stack_pop_value = match_subject
        match_subject.type_value common::clone_type = match_type
        if 0 match_subject.literals.length != then
            match_type resolve_numeric_literal_default = match_type
            self.literal_resolutions self.diagnostics match_type match_subject.resolve_literals drop
        fi
        if has_match_subject then
            match_subject.origins clone_origins = match_origins
            if match_subject.place std::Option::Some(place) is then
                place.clone std::Option::Some = match_place
            fi
            match_subject self.finish_value_use
            if match_subject.capability ValueCapability::Owned is ! then
                if match_type.is_borrow ! then
                    if match_subject.capability ValueCapability::Shared is then
                        common::SHARED_BORROW_TYPE
                    else
                        common::EXCLUSIVE_BORROW_TYPE
                    fi
                    match_type common::apply_borrow_type = match_type
                fi
            fi
        fi
        match_type MatchContext::new = match_ctx
        match_origins = match_ctx.match_origins
        match_place = match_ctx.match_place
        self.path_continues = match_ctx.entry_continues
        self.current_ownership_flow = match_ctx.flow_before
        # Snapshot the entry stack state eagerly so that an OpFnReturn visiting
        # this frame before any OpMatchArm still finds a correct `before` to
        # restore from. Matches the pre-refactor make_branched_stack behavior.
        self.stack match_ctx MatchContext::before.restore
        self.stack match_ctx MatchContext::after.restore
        op common::Op::location.clone match_ctx MatchContext::set_current_branch_location
        match_ctx BranchFrame::BranchMatch = match_frame
        match_frame self.branched_stacks.push
    }

    fn check_match_exhaustiveness
        self:mut$TypeChecker
        op:mut$common::Op
        match_ctx:mut$MatchContext
    {
        match_ctx MatchContext::match_type common::clone_type = end_match_type
        if end_match_type.borrow_target std::Option::Some(target) is then
            target common::clone_type = end_match_type
        fi
        end_match_type.match_base = end_base

        # Build covered set
        std::Set[std::String]::new = covered_set
        for record in match_ctx MatchContext::branch_records.iter do
            if record.as_str "__covered:" str::starts_with then
                record.as_str 10 record.length 10 - str::substring covered_set.add
            fi
        done
        common::MATCH_WILDCARD covered_set.has_str = has_wildcard

        # Check exhaustiveness
        if has_wildcard ! then
            if
                end_base self
                    .store
                    .enums
                    .get std::Option::Some(end_enum) is
            then
                std::List[std::String]::new = missing
                for variant_name in end_enum common::CasaEnum::variants.iter do
                    if variant_name covered_set.has ! then
                        variant_name.clone missing.push
                    fi
                done
                if 0 missing.length != then
                    std::List[std::String]::new = formatted_missing
                    for variant_name in missing.iter do
                        f"`{end_base}::{variant_name}`" formatted_missing.push
                    done
                    ", " formatted_missing.join_strings = missing_str
                    op common::Op::location f"Non-exhaustive match, missing arms: {missing_str}" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                fi
            fi
        fi
        if
            end_base self
                .store
                .structs
                .has has_wildcard ! &&
        then
            if end_base covered_set.has ! then
                op common::Op::location f"Non-exhaustive match on struct `{end_match_type.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
            fi
        fi
        # Literal exhaustiveness
        if
            "bool" end_base.as_str ==
            end_match_type.is_integer_type_t ||
            "char" end_base.as_str == ||
            "str" end_base.as_str == ||
        then
            if has_wildcard ! then
                if "bool" end_base.as_str == then
                    std::List[std::String]::new = bool_missing
                    if "true".to_str covered_set.has ! then
                        "true".to_str bool_missing.push
                    fi
                    if "false".to_str covered_set.has ! then
                        "false".to_str bool_missing.push
                    fi
                    if 0 bool_missing.length != then
                        op common::Op::location "Non-exhaustive match on `bool`" common::ErrorKind::TypeMismatch self.diagnostics.record_error
                    fi
                else
                    op common::Op::location f"Non-exhaustive match on type `{end_base}`. A wildcard `_` arm is required" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                fi
            fi
        fi
    }

    fn apply_match_result_stack self:mut$TypeChecker op:mut$common::Op match_ctx:mut$MatchContext {
        # Apply final stack state
        match_ctx MatchContext::before = final_before: mut$TypedStack
        match_ctx MatchContext::after = final_after: mut$TypedStack
        # When stack == before and before == after, nothing changed
        if final_before self.stack.equals final_after final_before.equals && then
            return
        fi
        # When stack == before but after differs (e.g. wildcard-only match),
        # accept the after state directly
        if final_before self.stack.equals final_after final_before.equals ! && then
            final_after self.stack.restore
            return
        fi
        self.store final_after self.stack.unify_types = unified
        if 0 unified.length != then
            self.stack final_after.merge_literals
            final_after.mark_literals_runtime
            final_after self.stack.restore
            unified self.stack.set_types
            return
        fi
        op common::Op::location "Match arms have incompatible stack effects" common::ErrorKind::StackMismatch self.diagnostics.record_error
    }

    fn finish_match self:mut$TypeChecker op:mut$common::Op {
        self
            .branched_stacks
            .pop
            .into_match = match_ctx
        # Close the final arm's scope frame (only opened if an arm ran).
        if match_ctx MatchContext::condition_present then
            if self.path_continues then
                match_ctx.before self.materialize_branch_results
            fi
            op self.attach_scope_cleanups
            self.scope.exit
        fi
        match_ctx.flow_after self.merge_current_ownership_flow
        if self.path_continues then
            true = match_ctx.has_continuing_arm
        fi
        if match_ctx.has_continuing_arm then
            match_ctx.flow_after self.restore_ownership_flow
        else
            match_ctx.flow_before self.restore_ownership_flow
        fi
        match_ctx.has_continuing_arm = self.path_continues
        if match_ctx MatchContext::condition_present then
            op match_ctx self.unify_arm_stacks
        fi

        match_ctx op self.check_match_exhaustiveness
        match_ctx op self.apply_match_result_stack
    }

    pub fn check_match
        self:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        op.value match
            common::OpValue::MatchStart => function_opt op self.begin_match
            common::OpValue::MatchArm => op function_opt self.typecheck_match_op
            common::OpValue::MatchEnd => op self.finish_match
            _ => {
            }
        end
    }
}

