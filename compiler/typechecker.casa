                    root.clone common::OpValue::PushCapture = second_root_value
                fi
            fi
            location.clone second_root_value common::Op::new = root_op
            insert_index root_op ops.insert
            1 += insert_index
            1 (u64) = field_index
        fi

        while field_index parts.length 1 - > do
            location.clone field_index parts.get.clone common::OpValue::MethodCall common::Op::new = getter
            insert_index getter ops.insert
            1 += insert_index
            1 += field_index
        done
        parts.length 1 - parts.get = field
        location f"set_{field}".to_str common::OpValue::MethodCall common::Op::new = setter
        insert_index setter ops.insert
