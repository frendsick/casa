    # Resolve `?` only after the input and enclosing return types are known.
    # The hidden local owns the value until exactly one branch consumes it.
    fn lower_question_operator
        checker:mut$TypeChecker
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    {
        op.value clone_op_value = question_value
