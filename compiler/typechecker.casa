pub fn resolve_specialized_trait_operation
    op:mut$common::Op
    as_reference:bool
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
{
    std::Option[common::DeferredTraitCall]::None = call_opt
    if op.value common::OpValue::TraitMethodCall(call) is then
        call.clone std::Option::Some = call_opt
    elif op.value common::OpValue::TraitMethodRef(call) is then
        call.clone std::Option::Some = call_opt
    fi
    if call_opt.is_none then
        return
    fi
    call_opt.unwrap = call
    call.receiver common::clone_type = lookup_receiver
    if call.receiver.borrow_target std::Option::Some(target) is then
        target common::clone_type = lookup_receiver
    fi
    if "clone" call.method_name.as_str == then
        op.location lookup_receiver store ensure_function_clone_method
    fi
    std::Option[semantics::MethodSemantics]::None = semantics_opt
    if call.trait_type std::Option::Some(trait_type) is then
        store lookup_receiver trait_type call.method_name.as_str semantics::resolve_qualified_method_semantics
        = semantics_opt
        if
            semantics_opt.is_none "clone" call.method_name.as_str == lookup_receiver common::Type::Function is && &&
        then
            store std::Option[common::Function]::None lookup_receiver call.method_name.as_str semantics::resolve_method_semantics
            = semantics_opt
        fi
    else
        store std::Option[common::Function]::None lookup_receiver call.method_name.as_str semantics::resolve_method_semantics
        = semantics_opt
    fi
    if semantics_opt.is_none then
        op.location f"No implementation of trait method `{call.method_name}` exists for `{call.receiver.format}`"
        common::ErrorKind::MissingTraitMethod diagnostics.record_error_string
        return
    fi
    semantics_opt.unwrap = semantics
    semantics.function_name.clone = function_name
    if semantics.kind semantics::MethodSemanticsKind::DefaultMethod is then
        diagnostics store lookup_receiver semantics instantiate_default_trait_method = default_name_opt
        if default_name_opt std::Option::Some(default_name) is then
            default_name.clone = function_name
        fi
    fi
    diagnostics store function_name.as_str ensure_typechecked drop
    if function_name.as_str store.get_function std::Option::Some(implementation) is then
        call.stack_effect implementation.stack_effect bind_stack_effect_pattern = bindings_opt
        if bindings_opt std::Option::Some(bindings) is then
            bindings common::clone_type_bindings = op.call_bindings
        fi
    fi
    if as_reference then
        function_name common::OpValue::FnPush op common::Op::set_value
    else
        function_name common::OpValue::FnCall op common::Op::set_value
    fi
}

pub fn monomorphized_function_name
    function_name:$str
    bindings:$std::Map[std::String common::Type]
-> std::String {
    bindings generic_binding_key = key
    f"{function_name}__mono_{key.as_str std::str_hash}"
}

pub fn function_receiver_bindings
    typ:$common::Type
    function:$common::Function
-> std::Map[std::String common::Type] {
    std::Map[std::String common::Type]::new = bindings
    if
        0 function
            .stack_effect
            .parameters
            .length ==
    then
        bindings return
    fi
    0 function
        .stack_effect
        .parameters
        .get
        .typ common::clone_type = pattern
    typ common::clone_type = actual
    if pattern.is_shared_borrow then
        common::SHARED_BORROW_TYPE actual common::apply_borrow_type = actual
    elif pattern.is_exclusive_borrow then
        common::EXCLUSIVE_BORROW_TYPE actual common::apply_borrow_type = actual
    fi
    bindings actual pattern semantics::bind_trait_impl_type drop
    bindings
}

pub fn monomorphize_function_body
    function_name:$str
    processed:mut$std::Set[std::String]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
{
    if function_name processed.has_str then
        return
    fi
    if function_name store.get_function std::Option::Some(source) is then
        source.clone_for_import = function
        function_name.to_str processed.add
        diagnostics store processed function.ops monomorphize_ops
        function store.set_function
    fi
}

pub fn monomorphize_drop_type_inner
    typ:$common::Type
    visiting:mut$std::Set[std::String]
    processed:mut$std::Set[std::String]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
{
    if typ.has_unresolved_type_var typ.is_borrow || then
        return
    fi
    typ.format = type_key
    if type_key.as_str visiting.has_str then
        return
    fi
    type_key.clone visiting.add

    f"{typ.match_base}::drop" = drop_name
    if drop_name.as_str store.get_function std::Option::Some(source_ref) is then
        source_ref.clone_for_import = source
        if
            0 source
                .stack_effect
                .type_vars
                .length != 0 source
                .stack_effect
                .const_params
                .keys
                .length != ||
        then
            source typ function_receiver_bindings = bindings
            bindings drop_name.as_str monomorphized_function_name = specialized_name
            if specialized_name.as_str store.has_function ! then
                store bindings specialized_name.clone source specialize_checked_function = specialized
                specialized store.set_specialized_function
            fi
            diagnostics store processed specialized_name.as_str monomorphize_function_body
        else
            diagnostics store processed drop_name.as_str monomorphize_function_body
        fi
    fi

    std::List[common::Type]::new = child_types
    if typ common::Type::Generic(generic) is then
        if common::ARRAY_TYPE generic.base.as_str == then
            if 0 generic.params.length != then
                0 generic.params.get common::clone_type child_types.push
            fi
        elif generic.base.as_str store.structs.get_str std::Option::Some(casa_struct) is then
            casa_struct.clone = owned_struct
            owned_struct.type_vars typ common::aggregate_type_bindings = bindings
            for member in owned_struct.members.iter do
                bindings member.typ.substitute_t child_types.push
            done
        elif generic.base.as_str store.enums.get_str std::Option::Some(casa_enum) is then
            casa_enum.clone = owned_enum
            owned_enum.type_vars typ common::aggregate_type_bindings = bindings
            for pair in owned_enum.variant_types.iter do
                for payload in pair.second.iter do
                    bindings payload.substitute_t child_types.push
                done
            done
        fi
    fi
    for child_type in child_types.iter do
        diagnostics store processed visiting child_type monomorphize_drop_type_inner
    done
}

pub fn monomorphize_drop_type
    typ:$common::Type
    processed:mut$std::Set[std::String]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
{
    std::Set[std::String]::new = visiting
    diagnostics store processed visiting typ monomorphize_drop_type_inner
}

pub fn monomorphize_named_operation
    op:mut$common::Op
    processed:mut$std::Set[std::String]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
{
    op.value common::clone_op_value = value
    std::Option[std::String]::None = function_name_opt
    false = call_operation
    if value common::OpValue::FnCall(function_name) is then
        true = call_operation
        function_name.clone std::Option::Some = function_name_opt
    elif value common::OpValue::FnPush(function_name) is then
        function_name.clone std::Option::Some = function_name_opt
    fi
    if function_name_opt.is_none then
        return
    fi
    function_name_opt.unwrap = function_name
    function_name.as_str store.get_function = source_opt
    if source_opt.is_none then
        return
    fi
    source_opt.unwrap = source_ref
    source_ref.clone_for_import = source
    op.call_bindings.clone = bindings
    0 bindings.length != = has_bindings
    0 source
        .stack_effect
        .type_vars
        .length != 0 source
        .stack_effect
        .const_params
        .keys
        .length != ||
    has_bindings ||
    = generic_source
    if generic_source ! then
        diagnostics store processed function_name.as_str monomorphize_function_body
        return
    fi
    if has_bindings ! then
        op.location f"Cannot monomorphize `{function_name}` without concrete type arguments"
        common::ErrorKind::TypeMismatch diagnostics.record_error_string
        return
    fi
    for pair in bindings.iter do
        if pair.second.has_unresolved_type_var then
            op.location f"Cannot monomorphize `{function_name}` with unresolved type arguments"
            common::ErrorKind::TypeMismatch diagnostics.record_error_string
            return
        fi
    done
    bindings function_name.as_str monomorphized_function_name = specialized_name
    if call_operation then
        specialized_name.clone common::OpValue::FnCall op common::Op::set_value
    else
        specialized_name.clone common::OpValue::FnPush op common::Op::set_value
    fi
    if specialized_name.as_str store.has_function ! then
        store bindings specialized_name.clone source specialize_checked_function = specialized
        specialized store.set_specialized_function
    fi
    diagnostics store processed specialized_name.as_str monomorphize_function_body
}

pub fn monomorphize_ops
    ops:mut$std::List[common::Op]
    processed:mut$std::Set[std::String]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
{
    0 (u64) = index
    while index ops.length > do
        index ops.get_mut = op
        if op.value common::OpValue::TraitMethodCall is then
            diagnostics store false op resolve_specialized_trait_operation
        elif op.value common::OpValue::TraitMethodRef is then
            diagnostics store true op resolve_specialized_trait_operation
        fi
        diagnostics store processed op monomorphize_named_operation
        if op.value common::OpValue::Drop is then
            if op.type_hint std::Option::Some(drop_type) is then
                diagnostics store processed drop_type monomorphize_drop_type
            fi
        fi
        if op.id store.clone_ownership std::Option::Some(ownership) is then
            for event in ownership.cleanups.iter do
                diagnostics store processed event.typ monomorphize_drop_type
            done
        fi
        op.value common::clone_op_value = nested_value
        if nested_value common::OpValue::PushArray(items) is then
            items common::clone_ops = nested
            diagnostics store processed nested monomorphize_ops
            nested common::OpValue::PushArray op common::Op::set_value
        elif nested_value common::OpValue::ExprGroup(items) is then
            items common::clone_ops = nested
            diagnostics store processed nested monomorphize_ops
            nested common::OpValue::ExprGroup op common::Op::set_value
        elif nested_value common::OpValue::MatchArm(arm) is then
            arm.clone = specialized_arm
            diagnostics store processed specialized_arm.guard_ops monomorphize_ops
            specialized_arm common::OpValue::MatchArm op common::Op::set_value
        fi
        1 += index
    done
}

pub fn monomorphize_checked_generics
    ops:mut$std::List[common::Op]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
{
    std::Set[std::String]::new = processed
    diagnostics store processed ops monomorphize_ops
}

pub fn type_check ops:std::List[common::Op] store:common::SymbolStore -> TypecheckResult {
    error::Diagnostics::new = diagnostics
    diagnostics store std::Option::None ops check_ops = global_stack_effect
    diagnostics store check_functions
    diagnostics store check_trait_impls
    diagnostics store validate_generic_cycles
    if diagnostics.has_errors ! then
        diagnostics store ops monomorphize_checked_generics
    fi
    diagnostics
    ops
    global_stack_effect
    store
    TypecheckResult
}
