            TYPE_UNKNOWN_T = compound_type
            if function_opt compound_name tc.local_var_type Option::Some(local_type) is then
                local_type = compound_type
            elif compound_name tc.store.variables.get Option::Some(global_var) is then
                global_var.typ = compound_type
            fi
            if compound_type.is_integer_type_t ! then
