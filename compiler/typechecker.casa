                common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi
        elif op.value common::OpValue::PtrWrite(target_type) is then
            op.location function_opt target_type tc.validate_type_exists
            if
                target_type.has_unresolved_type_var !
                tc.store target_type common::type_value_representation.is_none &&
            then
                op.location f"Cannot determine representation of `{target_type.format}`"
                common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi
        elif op.value common::OpValue::PtrAsRef(target_type) is then
            op.location function_opt target_type tc.validate_type_exists
        elif op.value common::OpValue::PtrAsMut(target_type) is then
            op.location function_opt target_type tc.validate_type_exists
        elif op.value common::OpValue::PtrIntoRaw is then
            tc.stack_peek_type = source_type
            false = source_is_owned
            if
                0 tc
                    .stack
                    .values
                    .length !=
            then
                tc
                    .stack
                    .values
                    .length 1 - tc
                    .stack
                    .values
                    .get = source_value
                source_value.capability ValueCapability::Owned is = source_is_owned
            fi
            if source_is_owned source_type.has_unresolved_type_var ! && then
                if tc.store source_type common::type_value_representation std::Option::Some(representation) is then
                    if common::VALUE_REPR_INDIRECT representation != then
                        op.location f"`ptr::into_raw` requires a heap-indirect owner, got `{source_type.format}`"
                        common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                    fi
                else
                    op.location f"Cannot determine representation of `{source_type.format}`"
                    common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                fi
            fi
        fi
        tc.store function_opt std::Option[$common::Type]::None op.value
        semantics::analyze_operation = semantics
        if semantics.stack_effect std::Option::Some(stored_effect) is then
            stored_effect.clone = effect
            # Raw stores require an explicit conversion instead of binding `T` to
            # the store width while checking a generic function body.
            if
                op.value semantics::operation_is_store 1 tc
                    .stack
                    .values
                    .length > &&
            then
                tc
                    .stack
                    .values
                    .length 2 - tc
                    .stack
                    .values
                    .get = store_value
                if store_value.type_value common::Type::TypeVar(_) is then
                    1 effect
                        .parameters
                        .get
                        .typ = expected_store_type: $common::Type
                    f"Expected `{expected_store_type.format}`, got `{store_value.type_value.format}`" tc.raise_type_mismatch
                fi
            fi
            0 (u64) = index
            while index effect.parameters.length > do
                index effect.parameters.get = parameter
                if
                    semantics.word_parameter_start index >=
                    index semantics.word_parameter_start semantics.word_parameter_count + > &&
                then
                    tc.stack_pop_type = word_type
                    function_opt word_type op tc.assert_word_bound
                else
                    parameter.typ tc.expect_type_t
                fi
                1 += index
            done
            for return_type in effect.return_types.iter do
                if op.value common::OpValue::PtrAsRef is then
                    false function_opt tc.raw_borrow_input_origins = origins
                    origins return_type tc.stack_push_origins
                elif op.value common::OpValue::PtrAsMut is then
                    true function_opt tc.raw_borrow_input_origins = origins
                    origins return_type tc.stack_push_origins
                else
                    return_type tc.stack_push_type
                fi
            done
        fi
    }
}

impl TypeChecker {
    pub fn apply_stack_reordering tc:mut$TypeChecker op:mut$common::Op -> bool {
        tc
            .stack
            .values
            .length = depth
        if op.value common::OpValue::Dup is then
            if 1 depth < then
                false return
            fi
            depth 1 - tc
                .stack
                .values
                .get clone_typed_value = value
            std::Option[std::String]::None = value.binding
            std::Option[i64]::None = value.source
            value tc
                .stack
                .values
                .push
            true return
        fi
        if op.value common::OpValue::Copy is then
            if 1 depth < then
                false return
            fi
            tc.stack_pop_value = value
            value.type_value common::clone_type = copied_type
            if copied_type.borrow_target std::Option::Some(target) is then
                target common::clone_type std::Option::Some op common::Op::set_type_hint
                target common::clone_type = copied_type
            fi
            copied_type tc.stack_push_type
            true return
        fi
        if op.value common::OpValue::Swap is then
            if 2 depth < then
                false return
            fi
            tc
                .stack
                .values
                .pop = top
            tc
                .stack
                .values
                .pop = below
            top tc
                .stack
                .values
                .push
            below tc
                .stack
                .values
                .push
            true return
        fi
        if op.value common::OpValue::Over is then
            if 2 depth < then
                false return
            fi
            depth 2 - tc
                .stack
                .values
                .get clone_typed_value = value
            std::Option[std::String]::None = value.binding
            std::Option[i64]::None = value.source
            value tc
                .stack
                .values
                .push
            true return
        fi
        if op.value common::OpValue::Rot is then
            if 3 depth < then
                false return
            fi
            tc
                .stack
                .values
                .pop = top
            tc
                .stack
                .values
                .pop = middle
            tc
                .stack
                .values
                .pop = bottom
            middle tc
                .stack
                .values
                .push
            top tc
                .stack
                .values
                .push
            bottom tc
                .stack
                .values
                .push
            true return
        fi
        false
    }

    pub fn apply_fixed_semantics
        tc:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        if op tc.apply_stack_reordering then
            return
        fi
        if
            op.value common::OpValue::Drop is 0 tc
                .stack
                .values
                .length != &&
        then
            tc.stack_peek_type common::clone_type std::Option::Some op common::Op::set_type_hint
        fi
        tc.store function_opt std::Option[$common::Type]::None op.value
        semantics::analyze_operation = semantics
        if semantics.into_stack_effect std::Option::Some(effect) is then
            function_opt std::Option[common::Type]::None "" effect
            tc.apply_stack_effect
        fi
    }
}

# ============================================================================
# Check assignment operations
# ============================================================================
# Unify the stored type of `variable` with the type being assigned to it.
# `scope` ("local" / "global") is only used in the error message.

impl TypeChecker {
    pub fn assignment_origins
        tc:mut$TypeChecker
        name:$str
        typ:$common::Type
        function_opt:mut$std::Option[common::Function]
    -> std::Option[std::List[std::String]] {
        std::Option[std::List[std::String]]::None = origins
        if
            0 tc
                .stack
                .values
                .length !=
        then
            tc
                .stack
                .values
                .length 1 - tc
                .stack
                .values
                .get = value
            value.origins clone_origins = origins
            if
                origins.is_none
                typ.is_borrow value.capability ValueCapability::Owned is ! || &&
            then
                if value.place std::Option::Some(place) is then
                    value.capability ValueCapability::Exclusive is place.as_str origins add_origin = origins
                fi
            fi
        fi
        if origins.is_none then
            if function_opt std::Option::Some(function) is then
                for
                    parameter in function
                        .stack_effect
                        .parameters
                        .iter
                do
                    if
                        name.as_str parameter.name.as_str ==
                        tc.store parameter.typ type_has_borrow &&
                    then
                        tc.store parameter.typ type_has_exclusive_borrow
                        name origins add_origin = origins
                    fi
                done
            fi
        fi
        origins
    }

    pub fn unify_variable_assignment
        self:mut$TypeChecker
        op:mut$common::Op
        variable:mut$common::Variable
        effective_type:$common::Type
        scope:str
    {
        variable common::Variable::name = var_name: $std::String
        variable common::Variable::typ = pre_type: $common::Type
        pre_type.is_unknown pre_type.is_unknown_placeholder || = pre_unknown
        if pre_unknown effective_type.is_unknown_placeholder ! && then
            effective_type common::clone_type variable common::Variable::set_typ
        fi
        self.store effective_type variable common::Variable::typ semantics::unify_type_t = unified
        unified match
            std::Option::Some(unified_type) => unified_type variable common::Variable::set_typ
            std::Option::None => {
                op common::Op::location f"Cannot override {scope} variable `{var_name}` of type `{variable common::Variable::typ.format}` with other type `{effective_type.format}`" common::ErrorKind::InvalidVariable self.diagnostics.record_error_string
            }
