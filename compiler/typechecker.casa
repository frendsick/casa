            layout_parameter_index effect.parameters.get = layout_parameter
            layout_parameter.name.as_str HIDDEN_SIZE_PREFIX str::starts_with = is_size
            layout_parameter.name.as_str HIDDEN_REPR_PREFIX str::starts_with = is_repr
            layout_parameter.name.as_str HIDDEN_DROP_PREFIX str::starts_with = is_drop
            if is_size is_repr || is_drop || ! then
                continue
            fi
