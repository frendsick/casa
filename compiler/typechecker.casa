# Stack-based type inference and checking for the Casa compiler.
#
# Maintains a virtual stack of types and validates that operations
# are type-safe.
import "std" as std
import "common" as common
import "error" as error
import "syntax" as syntax
import "block_scope" as block_scope
import "semantics" as semantics
import "pattern" as pattern

# ============================================================================
# TypedStack — typed values with source and unresolved-literal origins.
# ============================================================================

pub struct TypedStack {
    pub values: std::List[TypedValue]
}

pub struct LiteralRef {
    pub id:            i64
    pub integer_value: i64
    pub is_integer:    bool
}

impl LiteralRef: std::Clone {
    pub fn clone self:$LiteralRef -> LiteralRef {
        self.is_integer self.integer_value self.id LiteralRef
    }
}

pub enum ValueCapability derives std::Eq std::Copy {
    Owned
    Shared
    Exclusive
}

pub struct TypedValue {
    pub type_value:          common::Type
    pub origin:              common::Location
    pub literals:            std::List[LiteralRef]
    pub place:               std::Option[std::String]
    pub capability:          ValueCapability
    pub binding:             std::Option[std::String]
    pub source:              std::Option[i64]
    pub origins:             std::Option[std::List[std::String]]
    pub is_literal_constant: bool
}

pub fn origin_is_exclusive origin:$str -> bool { origin "!" str::starts_with }

pub fn origin_place origin:$str -> std::String {
    if origin.as_str origin_is_exclusive then
        origin.length 1 - = length
        origin 1 length str::substring return
    fi
    origin.to_str
}

pub fn origin_matches_place origin:$str place:$str -> bool {
    origin.as_str origin_place = origin_path
    if origin_path.as_str place == then
        true return
    fi
    f"{place}." = place_prefix
    if origin_path.as_str place_prefix.as_str str::starts_with then
        true return
    fi
    f"{origin_path}." = origin_prefix
    place origin_prefix.as_str str::starts_with
}

pub fn get_place_root place:$str -> std::String {
    place "." str::split = parts
    0 parts.get.clone
}

pub fn add_origin
    origins:std::Option[std::List[std::String]]
    place:$str
    exclusive:bool
-> std::Option[std::List[std::String]] {
    if exclusive then f"!{place}" else place.to_str fi = origin
    origins match
        std::Option::Some(items) => {
            if origin.as_str items common::string_list_contains ! then
                origin items.push
            fi
            items std::Option::Some
        }
        std::Option::None => {
            std::List[std::String]::new = items
            origin items.push
            items std::Option::Some
        }
    end
}

pub fn merge_origins
    target:std::Option[std::List[std::String]]
    source:$std::Option[std::List[std::String]]
-> std::Option[std::List[std::String]] {
    if source std::Option::Some(items) is then
        for origin in items.iter do
            origin.as_str origin_place = place
            origin.as_str origin_is_exclusive place.as_str target add_origin = target
        done
    fi
    target
}

pub fn merge_destination_origins
    target:std::Option[std::List[std::String]]
    value:$TypedValue
    expected:$common::Type
-> std::Option[std::List[std::String]] {
    value.origins target merge_origins = target
    if expected.is_borrow value.origins.is_none && then
        if value.place std::Option::Some(place) is then
            expected.is_exclusive_borrow place.as_str target add_origin = target
        fi
    fi
    target
}

pub fn clone_origins
    source:$std::Option[std::List[std::String]]
-> std::Option[std::List[std::String]] {
    if source std::Option::Some(items) is then
        std::List[std::String]::new = cloned
        for origin in items.iter do
            origin.clone cloned.push
        done
        cloned std::Option::Some return
    fi
    std::Option[std::List[std::String]]::None
}

pub fn clone_typed_value value:$TypedValue -> TypedValue {
    std::Option[std::String]::None = place
    if value.place std::Option::Some(current_place) is then
        current_place.clone std::Option::Some = place
    fi
    std::Option[std::String]::None = binding
    if value.binding std::Option::Some(current_binding) is then
        current_binding.clone std::Option::Some = binding
    fi
    std::Option[i64]::None = source
    if value.source std::Option::Some(current_source) is then
        current_source std::Option::Some = source
    fi
    value.is_literal_constant
    value.origins clone_origins
    source
    binding
    value.capability
    place
    value.literals.clone
    value.origin.clone
    value.type_value common::clone_type
    TypedValue
}

pub fn has_origin_descendant origin:$str origins:$std::List[std::String] -> bool {
    origin.as_str origin_place = place
    for other in origins.iter do
        if other.as_str origin_is_exclusive ! then
            continue
        fi
        other.as_str origin_place = other_place
        f"{place}." = place_prefix
        if
            place.as_str other_place.as_str != other_place.as_str place_prefix.as_str str::starts_with &&
        then
            true return
        fi
    done
    false
}

pub fn count_variable_uses
    ops:$std::List[common::Op]
    counts:std::Map[std::String u64]
-> std::Map[std::String u64] {
    for op in ops.iter do
        if op.value common::OpValue::PushVar(name) is then
            0 (u64) = count
            if name counts.get_copy std::Option::Some(found) is then
                found = count
            fi
            count 1 + name.clone counts.set
        fi
        if op.value common::OpValue::PushArray(items) is then
            counts items count_variable_uses = counts
        elif op.value common::OpValue::ExprGroup(items) is then
            counts items count_variable_uses = counts
        elif op.value common::OpValue::InitGlobal(initializer) is then
            counts initializer.ops count_variable_uses = counts
        elif op.value common::OpValue::MatchArm(arm) is then
            counts arm.guard_ops count_variable_uses = counts
        fi
    done
    counts
}

pub fn type_capability typ:$common::Type -> ValueCapability {
    if typ.is_shared_borrow then
        ValueCapability::Shared return
    fi
    if typ.is_exclusive_borrow then
        ValueCapability::Exclusive return
    fi
    ValueCapability::Owned
}

pub fn type_contains_borrow
    typ:$common::Type
    exclusive:bool
    store:$common::SymbolStore
    visiting:mut$std::List[std::String]
-> bool {
    if typ.is_borrow then
        if exclusive then typ.is_exclusive_borrow else typ.is_shared_borrow fi return
    fi
    if typ common::Type::Generic(generic) is then
        for parameter in generic.params.iter do
            if visiting store exclusive parameter type_contains_borrow then
                true return
            fi
        done
        if generic.base.as_str visiting common::string_list_contains then
            false return
        fi
        generic.base.clone visiting.push
        std::Map[std::String common::Type]::new = bindings
        if generic.base store.structs.get std::Option::Some(casa_struct) is then
            for
                pair in generic.params.iter casa_struct
                    .type_vars
                    .iter
                    .zip
            do
                pair.second common::clone_type pair.first.clone bindings.set
            done
            for member in casa_struct.members.iter do
                bindings member.typ.substitute_t = member_type
                if visiting store exclusive member_type type_contains_borrow then
                    true return
                fi
            done
        elif generic.base store.enums.get std::Option::Some(casa_enum) is then
            for
                pair in generic.params.iter casa_enum
                    .type_vars
                    .iter
                    .zip
            do
                pair.second common::clone_type pair.first.clone bindings.set
            done
            for pair in casa_enum.variant_types.iter do
                for payload_type in pair.second.iter do
                    bindings payload_type.substitute_t = resolved
                    if visiting store exclusive resolved type_contains_borrow then
                        true return
                    fi
                done
            done
        fi
    fi
    false
}

pub fn clone_type_binding
    bindings:$std::Map[std::String common::Type]
    name:$str
-> std::Option[common::Type] {
    if name bindings.get_str std::Option::Some(value) is then
        value common::clone_type std::Option::Some
    else
        std::Option[common::Type]::None
    fi
}

pub fn type_has_shared_borrow typ:$common::Type store:mut$common::SymbolStore -> bool {
    if typ.is_shared_borrow then
        true return
    fi
    if typ common::Type::Generic is ! then
        false return
    fi
    f"shared:{typ.format}" = key
    if key store.borrow_shapes.get std::Option::Some(cached) is then
        cached.clone return
    fi
    std::List[std::String]::new = visiting
    visiting store false typ type_contains_borrow = result
    result key store.borrow_shapes.set
    result
}

pub fn type_has_exclusive_borrow typ:$common::Type store:mut$common::SymbolStore -> bool {
    if typ.is_exclusive_borrow then
        true return
    fi
    if typ common::Type::Generic is ! then
        false return
    fi
    f"exclusive:{typ.format}" = key
    if key store.borrow_shapes.get std::Option::Some(cached) is then
        cached.clone return
    fi
    std::List[std::String]::new = visiting
    visiting store true typ type_contains_borrow = result
    result key store.borrow_shapes.set
    result
}

pub fn type_has_borrow typ:$common::Type store:mut$common::SymbolStore -> bool {
    if store typ type_has_shared_borrow then
        true return
    fi
    store typ type_has_exclusive_borrow
}

pub fn method_receiver_type effect:$common::StackEffect -> std::Option[common::Type] {
    for parameter in effect.parameters.iter do
        if parameter.name.as_str common::is_hidden_parameter_name ! then
            parameter.typ common::clone_type std::Option::Some return
        fi
    done
    std::Option[common::Type]::None
}

pub fn capability_matches_receiver capability:$ValueCapability expected:$common::Type -> bool {
    if capability ValueCapability::Shared is then
        expected.is_shared_borrow return
    fi
    if capability ValueCapability::Exclusive is then
        expected.is_shared_borrow expected.is_exclusive_borrow || return
    fi
    true
}

pub fn contains_literal literals:$std::List[LiteralRef] candidate:$LiteralRef -> bool {
    for literal in literals.iter do
        if candidate.id literal.id == then
            true return
        fi
    done
    false
}

impl TypedValue {
    pub fn same_owner_source self:$TypedValue other:$TypedValue -> bool {
        if self.binding std::Option::Some(name) is then
            if other.binding std::Option::Some(other_name) is then
                if name other_name != then
                    false return
                fi
                if self.source std::Option::Some(source) is then
                    if other.source std::Option::Some(other_source) is then
                        source other_source == return
                    fi
                fi
            fi
            false return
        fi
        other.binding.is_none
    }

    pub fn same_place self:$TypedValue other:$TypedValue -> bool {
        if self.place std::Option::Some(place) is then
            if other.place std::Option::Some(other_place) is then
                place other_place == return
            fi
            false return
        fi
        other.place.is_none
    }

    pub fn clear_owner_source self:mut$TypedValue {
        std::Option[std::String]::None = self.place
        std::Option[std::String]::None = self.binding
        std::Option[i64]::None = self.source
    }

    pub fn resolve_literals
        self:mut$TypedValue
        target:$common::Type
        diagnostics:mut$error::Diagnostics
        resolutions:mut$std::Map[i64 common::Type]
    -> bool {
        target common::clone_type = resolved_target
        if resolved_target.borrow_target std::Option::Some(borrowed_target) is then
            borrowed_target common::clone_type = resolved_target
        fi
        for literal in self.literals.iter do
            if 0 literal.id != then
                resolved_target common::clone_type literal.id resolutions.set
            fi
        done
        true
    }
}

impl TypedStack {
    pub fn new -> TypedStack { std::List[TypedValue]::new TypedStack }

    pub fn snapshot self:$TypedStack -> TypedStack {
        std::List[TypedValue]::new = values
        for value in self.values.iter do
            value clone_typed_value values.push
        done
        values TypedStack
    }

    pub fn restore self:mut$TypedStack source:$TypedStack {
        std::List[TypedValue]::new = values
        for value in source.values.iter do
            value clone_typed_value values.push
        done
        values = self.values
    }

    pub fn get_types self:$TypedStack -> std::List[common::Type] {
        std::List[common::Type]::new = types
        for value in self.values.iter do
            value.type_value common::clone_type types.push
        done
        types
    }

    pub fn set_types self:mut$TypedStack types:$std::List[common::Type] {
        0 (u64) = index
        while index self.values.length > do
            index self.values.get_mut = value
            value.is_literal_constant value.origins clone_origins
            value.source.clone value.binding.clone value.capability value.place.clone
            value.literals.clone value.origin.clone
            index types.get common::clone_type TypedValue index self.values.set
            1 += index
        done
    }

    # Pure stack comparison on the types slice (origins are not compared).
    pub fn equals self:$TypedStack other:$TypedStack -> bool {
        if self.values.length other.values.length != then
            false return
        fi
        0 (u64) = index
        while index self.values.length > do
            if
                index self
                    .values
                    .get
                    .capability
                index other
                    .values
                    .get
                    .capability !=
            then
                false return
            fi
            1 += index
        done
        self.get_types other.get_types stacks_equal
    }

    pub fn merge_literals self:mut$TypedStack candidate:$TypedStack {
        0 (u64) = index
        while index self.values.length > do
            index self.values.get_mut = value
            index candidate.values.get = candidate_value
            if candidate_value value.same_owner_source ! then
                value.clear_owner_source
            elif candidate_value value.same_place ! then
                std::Option[std::String]::None = value.place
            fi
            value.origins clone_origins = merged_origins
            candidate_value.origins merged_origins merge_origins = merged_origins
            merged_origins = value.origins
            0 (u64) = literal_index
            while literal_index candidate_value.literals.length > do
                literal_index candidate_value.literals.get = candidate_literal
                if candidate_literal value.literals contains_literal ! then
                    candidate_literal.clone value.literals.push
                fi
                1 += literal_index
            done
            1 += index
        done
    }

    pub fn mark_literals_runtime self:mut$TypedStack {
        0 (u64) = index
        while index self.values.length > do
            index self.values.get_mut = value
            if 0 value.literals.length != then
                false = value.is_literal_constant
            fi
            1 += index
        done
    }

    # Produce unified types and retain literal origins from both stacks.
    pub fn unify_types
        self:mut$TypedStack
        candidate:$TypedStack
        store:mut$common::SymbolStore
    -> std::List[common::Type] {
        if self.values.length candidate.values.length == then
            0 (u64) = index
            while index self.values.length > do
                if
                    index self
                        .values
                        .get
                        .capability
                    index candidate
                        .values
                        .get
                        .capability !=
                then
                    std::List[common::Type]::new return
                fi
                1 += index
            done
        fi
        store self.get_types candidate.get_types stacks_compatible = unified
        if unified.length self.values.length == then
            candidate self.merge_literals
        fi
        unified
    }
}

# ============================================================================
# Branch contexts — one specialized struct per branch kind (if / while / match).
# ============================================================================

pub struct OwnershipFlow {
    pub moved: std::List[std::String]
    pub loans: std::Map[std::String std::List[std::String]]
}

impl OwnershipFlow {
    pub fn new -> OwnershipFlow {
        std::Map[std::String std::List[std::String]]::new std::List[std::String]::new OwnershipFlow
    }

    pub fn merge self:mut$OwnershipFlow other:$OwnershipFlow {
        for name in other.moved.iter do
            if name.as_str self.moved common::string_list_contains ! then
                name.clone self.moved.push
            fi
        done
        for pair in other.loans.iter do
            std::List[std::String]::new = origins
            if pair.first self.loans.get std::Option::Some(existing) is then
                existing.clone = origins
            fi
            for origin in pair.second.iter do
                if origin.as_str origins common::string_list_contains ! then
                    origin.clone origins.push
                fi
            done
            origins pair.first.clone self.loans.set
        done
    }
}

pub struct IfContext {
    pub before:                  TypedStack
    pub after:                   TypedStack
    pub flow_before:             OwnershipFlow
    pub flow_after:              OwnershipFlow
    pub entry_continues:         bool
    pub has_continuing_branch:   bool
    pub condition_present:       bool
    pub default_present:         bool
    pub current_branch_label:    std::String
    pub current_branch_location: common::Location
}

pub struct WhileContext {
    pub before:                  TypedStack
    pub flow_before:             OwnershipFlow
    pub flow_exit:               OwnershipFlow
    pub entry_continues:         bool
    pub has_exit:                bool
    pub condition_present:       bool
    pub current_branch_location: common::Location
    pub scope_depth:             u64
}

pub struct MatchContext {
    pub before:                  TypedStack
    pub after:                   TypedStack
    pub flow_before:             OwnershipFlow
    pub flow_after:              OwnershipFlow
    pub entry_continues:         bool
    pub has_continuing_arm:      bool
    pub condition_present:       bool
    pub branch_records:          std::List[std::String]
    pub match_type:              common::Type
    pub match_origins:           std::Option[std::List[std::String]]
    pub match_place:             std::Option[std::String]
    pub current_branch_label:    std::String
    pub current_branch_location: common::Location
}

pub enum BranchFrame {
    BranchIf (IfContext)
    BranchWhile (WhileContext)
    BranchMatch (MatchContext)
}

impl BranchFrame {
    pub fn into_if self:BranchFrame -> IfContext {
        self match
            BranchFrame::BranchIf(context) => context
            _ => {
                "Internal error: expected if branch frame\n" std::eprint
                1 std::exit
                IfContext::new
            }
        end
    }

    pub fn into_while self:BranchFrame -> WhileContext {
        self match
            BranchFrame::BranchWhile(context) => context
            _ => {
                "Internal error: expected while branch frame\n" std::eprint
                1 std::exit
                0 WhileContext::new
            }
        end
    }

    pub fn into_match self:BranchFrame -> MatchContext {
        self match
            BranchFrame::BranchMatch(context) => context
            _ => {
                "Internal error: expected match branch frame\n" std::eprint
                1 std::exit
                common::make_unknown_type common::clone_type MatchContext::new
            }
        end
    }
}

impl IfContext {
    pub fn new -> IfContext {
        common::empty_location
        "".to_str
        false
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        TypedStack::new
        IfContext
    }
}

impl WhileContext {
    pub fn new scope_depth:u64 -> WhileContext {
        scope_depth
        common::empty_location
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        WhileContext
    }
}

impl MatchContext {
    pub fn new match_type:common::Type -> MatchContext {
        common::empty_location
        "".to_str
        std::Option[std::String]::None
        std::Option[std::List[std::String]]::None
        match_type
        std::List[std::String]::new
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        TypedStack::new
        MatchContext
    }
}

# ============================================================================
# TypeChecker struct
# ============================================================================

pub struct TypeChecker {
    pub stack:                      TypedStack
    pub parameters:                 std::List[common::Parameter]
    pub return_types:               TypedStack
    pub has_return_types:           bool
    pub branched_stacks:            std::List[BranchFrame]
    pub current_location:           common::Location
    pub current_op_context:         std::String
    pub current_expect_ctx:         std::String
    pub in_branch_condition:        bool
    pub path_continues:             bool
    pub store:                      mut$common::SymbolStore
    pub param_cap:                  std::Option[u64]
    pub underflow_reported_this_op: bool
    pub scope:                      block_scope::BlockScope
    pub moved_owners:               std::List[std::String]
    pub owner_events:               std::List[common::OwnerEvent]
    pub next_owner_generation:      u64
    pub binding_origins:            std::Map[std::String std::List[std::String]]
    pub remaining_uses:             std::Map[std::String u64]
    pub unsafe_depth:               u64
    pub required_drop_types:        std::List[common::Type]
    pub literal_resolutions:        std::Map[i64 common::Type]
    pub diagnostics:                mut$error::Diagnostics
}

pub struct TypecheckResult {
    pub store:               common::SymbolStore
    pub global_stack_effect: common::StackEffect
    pub ops:                 std::List[common::Op]
    pub diagnostics:         error::Diagnostics
}

impl TypecheckResult {
    # Move the facts used by editor queries and release the remaining typecheck state.
    pub fn into_document_parts
        self:TypecheckResult
    -> std::List[common::Op] std::Map[std::String common::Function] std::Map[std::String common::CasaStruct] std::Map[std::String common::CasaEnum] std::Map[std::String common::Variable] {
        self match
            TypecheckResult { store: store ops: ops } => {
                store.into_document_facts = variables = enums = structs = functions
                ops functions structs enums variables
            }
        end
    }
}

pub fn unsafe_operation_name operation:$common::OpValue -> str {
    # Callers already classify the operation as unsafe. Keep enforcement if a name is missing.
    operation match
        common::OpValue::HeapAlloc => "alloc"
        common::OpValue::HeapFree => "free"
        common::OpValue::Load8 => "load8"
        common::OpValue::Load16 => "load16"
        common::OpValue::Load32 => "load32"
        common::OpValue::Load64 => "load64"
        common::OpValue::PtrAsRef => "ptr::as_ref"
        common::OpValue::PtrAsMut => "ptr::as_mut"
        common::OpValue::PtrIntoRaw => "ptr::into_raw"
        common::OpValue::PtrRead => "ptr::read"
        common::OpValue::Store8 => "store8"
        common::OpValue::Store16 => "store16"
        common::OpValue::Store32 => "store32"
        common::OpValue::Store64 => "store64"
        common::OpValue::PtrWrite => "ptr::write"
        common::OpValue::Syscall0 => "syscall0"
        common::OpValue::Syscall1 => "syscall1"
        common::OpValue::Syscall2 => "syscall2"
        common::OpValue::Syscall3 => "syscall3"
        common::OpValue::Syscall4 => "syscall4"
        common::OpValue::Syscall5 => "syscall5"
        common::OpValue::Syscall6 => "syscall6"
        _ => "operation"
    end
}

impl TypeChecker {
    pub fn new store:mut$common::SymbolStore diagnostics:mut$error::Diagnostics -> TypeChecker {
        diagnostics # diagnostics
        std::Map[i64 common::Type]::new # literal_resolutions
        std::List[common::Type]::new # required_drop_types
        0 # unsafe_depth
        std::Map[std::String u64]::new # remaining_uses
        std::Map[std::String std::List[std::String]]::new # binding_origins
        0 # next_owner_generation
        std::List[common::OwnerEvent]::new # owner_events
        std::List[std::String]::new # moved_owners
        block_scope::BlockScope::new # scope
        false # underflow_reported_this_op
        std::Option[u64]::None # param_cap
        store # store
        true # path_continues
        false # in_branch_condition
        "".to_str # current_expect_ctx
        "".to_str # current_op_context
        common::empty_location # current_location
        std::List[BranchFrame]::new # branched_stacks
        false # has_return_types
        TypedStack::new # return_types
        std::List[common::Parameter]::new # parameters
        TypedStack::new # stack
        TypeChecker
    }

    pub fn assign_op_id self:mut$TypeChecker op:mut$common::Op {
        self.store.next_op_id = op.id
        1 += self.store.next_op_id
    }
}

pub fn resolve_numeric_literal_default type_value:$common::Type -> common::Type {
    if type_value.is_integer_literal_t then
        common::make_i64_type common::clone_type return
    fi
    if type_value.is_float_literal_t then
        common::make_f64_type common::clone_type return
    fi
    type_value match
        common::Type::Generic(generic) => {
            std::List[common::Type]::new = parameters
            for parameter in generic.params.iter do
                parameter resolve_numeric_literal_default parameters.push
            done
            parameters generic.base.clone common::GenericType common::Type::Generic
        }
        common::Type::Function(function_type) => {
            std::List[common::Type]::new = parameters
            for parameter in function_type.parameters.iter do
                parameter resolve_numeric_literal_default parameters.push
            done
            std::List[common::Type]::new = return_types
            for return_type in function_type.return_types.iter do
                return_type resolve_numeric_literal_default return_types.push
            done
            return_types parameters common::FunctionType common::Type::Function
        }
        _ => type_value common::clone_type
    end
}

impl common::Op {
    pub fn has_numeric_literal self:$common::Op -> bool {
        self.value match
            common::OpValue::PushInt(_) => true
            common::OpValue::PushFloat(_) => true
            common::OpValue::PushArray(items) => {
                for item in items.iter do
                    if item.has_numeric_literal then
                        true return
                    fi
                done
                false
            }
            common::OpValue::ExprGroup(items) => {
                for item in items.iter do
                    if item.has_numeric_literal then
                        true return
                    fi
                done
                false
            }
            common::OpValue::InitGlobal(initializer) => {
                for item in initializer.ops.iter do
                    if item.has_numeric_literal then
                        true return
                    fi
                done
                false
            }
            _ => false
        end
    }

    pub fn resolve_array_literals
        self:mut$common::Op
        items:mut$std::List[common::Op]
        target:$common::Type
        diagnostics:mut$error::Diagnostics
    -> bool {
        target.as_generic = generic_option
        if generic_option.is_none then
            false return
        fi
        generic_option.unwrap = generic
        if common::ARRAY_TYPE generic.base.as_str != 2 generic.params.length != || then
            false return
        fi
        if target common::get_array_length_parameter std::Option::Some(target_length) is then
            if target_length.is_symbolic then
                self.location
                f"Array literal length {items.length} cannot satisfy constant parameter `{target_length.name}`"
                common::ErrorKind::TypeMismatch diagnostics.record_error_string
                false return
            fi
            if items.length i64::try_from.unwrap target_length.value != then
                self.location f"Array literal with {items.length} element(s) does not fit `{target.format}`" common::ErrorKind::TypeMismatch diagnostics.record_error_string
                false return
            fi
        fi
        true = valid
        0 generic.params.get = element_type
        0 (u64) = item_index
        while item_index items.length > do
            item_index items.get_mut = item
            1 += item_index
            if item.has_numeric_literal diagnostics element_type item.resolve_literal ! && then
                false = valid
            fi
        done
        if valid then
            target common::clone_type std::Option::Some self common::Op::set_type_hint
        fi
        valid
    }

    pub fn resolve_literal
        self:mut$common::Op
        target:$common::Type
        diagnostics:mut$error::Diagnostics
    -> bool {
        self.value match
            common::OpValue::PushInt(literal) => {
                if target.is_integer_type_t ! then
                    self.location f"Integer literal `{literal.raw}` requires an integer context, got `{target.format}`" common::ErrorKind::TypeMismatch diagnostics.record_error_string
                    false return
                fi
                if target literal.fits ! then
                    target.get_integer_min = minimum
                    target.get_integer_max = maximum
                    self.location f"Integer literal `{literal.raw}` is outside `{target.format}` range {minimum}..{maximum}" common::ErrorKind::TypeMismatch diagnostics.record_error_string
                    false return
                fi
                target common::clone_type std::Option::Some self common::Op::set_type_hint
                true
            }
            common::OpValue::PushFloat(value) => {
                if target.is_float_type_t ! then
                    self.location f"Floating-point literal `{value}` requires `f32` or `f64` context, got `{target.format}`" common::ErrorKind::TypeMismatch diagnostics.record_error_string
                    false return
                fi
                if
                    target common::make_f32_type.eq value.to_f32.is_none &&
                    target common::make_f64_type.eq value.to_f64.is_none && ||
                then
                    self.location f"Floating-point literal `{value}` is outside `{target.format}` finite range" common::ErrorKind::TypeMismatch diagnostics.record_error_string
                    false return
                fi
                target common::clone_type std::Option::Some self common::Op::set_type_hint
                true
            }
            common::OpValue::PushArray(items) => diagnostics target items self.resolve_array_literals
            _ => false
        end
    }
}

pub fn resolve_default_literals ops:mut$std::List[common::Op] diagnostics:mut$error::Diagnostics {
    0 (u64) = default_op_index
    while default_op_index ops.length > do
        default_op_index ops.get_mut = op
        1 += default_op_index
        op.value common::clone_op_value = op_value
        if op_value common::OpValue::PushInt is then
            op.type_hint.clone = target_opt
            target_opt match
                std::Option::Some(resolved_target) => diagnostics resolved_target op.resolve_literal drop
                std::Option::None => diagnostics common::make_i64_type op.resolve_literal drop
            end
        elif op_value common::OpValue::PushFloat is then
            op.type_hint.clone = target_opt
            target_opt match
                std::Option::Some(resolved_target) => diagnostics resolved_target op.resolve_literal drop
                std::Option::None => diagnostics common::make_f64_type op.resolve_literal drop
            end
        elif op_value common::OpValue::PushArray is then
            op.type_hint.clone = target_opt
            target_opt match
                std::Option::Some(resolved_target) => diagnostics resolved_target op.resolve_literal drop
                std::Option::None => {
                    if op_value common::OpValue::PushArray(items) is then
                        items common::clone_ops = owned_items
                        diagnostics owned_items resolve_default_literals
                        owned_items common::OpValue::PushArray op common::Op::set_value
                    fi
                }
            end
        elif op_value common::OpValue::ExprGroup(items) is then
            items common::clone_ops = owned_items
            diagnostics owned_items resolve_default_literals
            owned_items common::OpValue::ExprGroup op common::Op::set_value
        elif op_value common::OpValue::InitGlobal(initializer) is then
            initializer.clone = resolved_initializer
            diagnostics resolved_initializer.ops resolve_default_literals
            resolved_initializer common::OpValue::InitGlobal op common::Op::set_value
        elif op_value common::OpValue::MatchArm(arm) is then
            arm.clone = resolved_arm
            diagnostics resolved_arm.guard_ops resolve_default_literals
            resolved_arm common::OpValue::MatchArm op common::Op::set_value
        fi
    done
}

pub fn apply_resolved_literal_hints
    ops:mut$std::List[common::Op]
    resolutions:$std::Map[i64 common::Type]
{
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get_mut = op
        op.value common::clone_op_value = op_value
        if 0 op.id != then
            if op.id resolutions.get std::Option::Some(target) is then
                target common::clone_type = resolved_target
                if op_value common::OpValue::PushArray(items) is then
                    if target common::Type::Generic(generic) is then
                        if common::ARRAY_TYPE generic.base.as_str == 1 generic.params.length == && then
                            items.length 0 generic.params.get common::clone_type common::make_array_type = resolved_target
                        fi
                    fi
                fi
                resolved_target std::Option::Some op common::Op::set_type_hint
            fi
        fi
        if op_value common::OpValue::PushArray(items) is then
            items common::clone_ops = owned_items
            resolutions owned_items apply_resolved_literal_hints
            owned_items common::OpValue::PushArray op common::Op::set_value
        elif op_value common::OpValue::ExprGroup(items) is then
            items common::clone_ops = owned_items
            resolutions owned_items apply_resolved_literal_hints
            owned_items common::OpValue::ExprGroup op common::Op::set_value
        elif op_value common::OpValue::InitGlobal(initializer) is then
            initializer.clone = resolved_initializer
            resolutions resolved_initializer.ops apply_resolved_literal_hints
            resolved_initializer common::OpValue::InitGlobal op common::Op::set_value
        elif op_value common::OpValue::MatchArm(arm) is then
            arm.clone = resolved_arm
            resolutions resolved_arm.guard_ops apply_resolved_literal_hints
            resolved_arm common::OpValue::MatchArm op common::Op::set_value
        fi
        1 += op_index
    done
}

impl TypeChecker {
    pub fn within_param_cap tc:mut$TypeChecker -> bool {
        if tc.param_cap std::Option::Some(cap) is then
            cap tc.parameters.length < return
        fi
        true
    }
}
# Raise a TypeMismatch error at the type checker's current location.

impl TypeChecker {
    pub fn raise_type_mismatch tc:mut$TypeChecker message:std::String {
        tc.current_location message common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
    }
}

# ============================================================================
# Stack operations
# ============================================================================

impl TypeChecker {
    # A branch-local binding cannot identify the value after control-flow joins.
    # Transfer it to the branch result before the binding's scope is cleaned up.
    pub fn materialize_branch_results self:mut$TypeChecker before:$TypedStack {
        0 (u64) = index
        while
            index self
                .stack
                .values
                .length >
        do
            index self
                .stack
                .values
                .get clone_typed_value = value
            false = entered_branch
            if index before.values.length > then
                index before.values.get = before_value
                before_value value.same_owner_source = entered_branch
            fi
            if value.binding.is_some entered_branch ! && then
                value self.consume_value
                index self
                    .stack
                    .values
                    .get_mut
                    .clear_owner_source
            fi
            1 += index
        done
    }

    pub fn current_ownership_flow tc:mut$TypeChecker -> OwnershipFlow {
        std::List[std::String]::new = moved
        for name in tc.moved_owners.iter do
            if
                name.as_str tc
                    .scope
                    .lookup
                    .is_some
            then
                name.clone moved.push
            fi
        done
        std::Map[std::String std::List[std::String]]::new = loans
        for pair in tc.binding_origins.iter do
            if
                pair.first.as_str tc
                    .scope
                    .lookup
                    .is_some
            then
                pair.second.clone pair.first.clone loans.set
            fi
        done
        loans moved OwnershipFlow
    }

    pub fn restore_ownership_flow tc:mut$TypeChecker flow:$OwnershipFlow {
        flow.moved.clone = tc.moved_owners
        std::Map[std::String std::List[std::String]]::new = loans
        for pair in flow.loans.iter do
            pair.second.clone pair.first.clone loans.set
        done
        loans = tc.binding_origins
    }

    pub fn remove_flow_names tc:mut$TypeChecker names:$std::List[std::String] {
        for name in names.iter do
            false name.as_str tc.set_owner_moved
            if name.as_str tc.binding_origins.has_str then
                name.as_str tc.binding_origins.delete_str
            fi
        done
    }

    pub fn merge_current_ownership_flow tc:mut$TypeChecker flow:mut$OwnershipFlow {
        if tc.path_continues then
            tc.current_ownership_flow = current
            current flow.merge
        fi
    }

    pub fn report_loop_flow_difference
        tc:mut$TypeChecker
        expected:$OwnershipFlow
        local_names:$std::List[std::String]
        op:mut$common::Op
    {
        tc.current_ownership_flow = current
        for name in current.moved.iter do
            if
                name.as_str local_names common::string_list_contains !
                name.as_str expected.moved common::string_list_contains ! &&
            then
                op.location f"Loop back-edge does not restore ownership of `{name}`"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
        for name in expected.moved.iter do
            if
                name.as_str local_names common::string_list_contains !
                name.as_str current.moved common::string_list_contains ! &&
            then
                op.location f"Loop back-edge changes ownership of `{name}`"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
        for pair in current.loans.iter do
            if pair.first.as_str local_names common::string_list_contains then
                continue
            fi
            if pair.first.as_str tc.scope.lookup std::Option::Some(typ) is then
                if tc.store typ type_has_borrow ! then
                    continue
                fi
            fi
            false = same
            if pair.first expected.loans.get std::Option::Some(origins) is then
                pair.second.length origins.length == = same
                if same then
                    for origin in pair.second.iter do
                        if origin.as_str origins common::string_list_contains ! then
                            false = same
                        fi
                    done
                fi
            fi
            if same ! then
                op.location f"Loop back-edge changes loans for `{pair.first}`"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
        for pair in expected.loans.iter do
            if pair.first.as_str tc.scope.lookup std::Option::Some(typ) is then
                if tc.store typ type_has_borrow ! then
                    continue
                fi
            fi
            if
                pair.first.as_str local_names common::string_list_contains !
                pair.first.as_str current.loans.has_str ! &&
            then
                op.location f"Loop back-edge does not restore loans for `{pair.first}`"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
    }

    pub fn owner_is_moved tc:mut$TypeChecker name:$str -> bool {
        name tc.moved_owners common::string_list_contains
    }

    pub fn set_owner_moved tc:mut$TypeChecker name:$str moved:bool {
        name tc.moved_owners common::string_list_index = index
        if moved then
            if 0 index < then
                name.clone tc.moved_owners.push_str
            fi
            return
        fi
        if 0 index >= then
            tc.moved_owners.pop = last
            if tc.moved_owners.length index (u64) < then
                last index (u64) tc.moved_owners.set
            fi
        fi
    }

    pub fn use_binding tc:mut$TypeChecker name:$str {
        if name tc.remaining_uses.get_str std::Option::Some(count) is then
            if 0 count != then
                count 1 - name.clone tc.remaining_uses.set_str
            fi
        fi
    }

    pub fn binding_is_live tc:mut$TypeChecker name:$str -> bool {
        if name tc.remaining_uses.get_str std::Option::Some(count) is then
            0 count != return
        fi
        false
    }

    pub fn record_binding_origins
        tc:mut$TypeChecker
        name:$str
        origins:mut$std::Option[std::List[std::String]]
    {
        if origins std::Option::Some(items) is then
            items.clone name.clone tc.binding_origins.set_str
        elif name tc.binding_origins.has_str then
            name tc.binding_origins.delete_str
        fi
    }

    pub fn record_pattern_origins
        tc:mut$TypeChecker
        names:mut$std::List[std::String]
        origins:mut$std::Option[std::List[std::String]]
    {
        for name in names.iter do
            if name.as_str tc.scope.lookup std::Option::Some(typ) is then
                if
                    tc.store typ type_has_borrow
                    std::Option[common::Function]::None typ tc.type_is_duplicable ! ||
                then
                    origins name.as_str tc.record_binding_origins
                fi
            fi
        done
    }

    pub fn place_has_conflicting_loan
        self:mut$TypeChecker
        place:$str
        stack_depth:u64
        exclusive:bool
    -> bool {
        0 (u64) = index
        while index stack_depth > do
            index self
                .stack
                .values
                .get_mut = value
            if value.binding std::Option::Some(binding_name) is then
                if place binding_name.as_str == then
                    1 += index continue
                fi
            fi
            if value.place std::Option::Some(value_place) is then
                if place value_place.as_str == value.type_value.is_borrow exclusive ! || && then
                    1 += index
                    continue
                fi
            fi
            if value.capability ValueCapability::Owned is ! then
                if value.place std::Option::Some(value_place) is then
                    if
                        place value_place.as_str origin_matches_place
                        value.capability ValueCapability::Exclusive is exclusive || &&
                    then
                        true return
                    fi
                fi
            fi
            if value.origins std::Option::Some(origins) is then
                for origin in origins.iter do
                    if
                        place origin.as_str origin_matches_place
                        origin.as_str origin_is_exclusive exclusive || &&
                    then
                        true return
                    fi
                done
            fi
            1 += index
        done
        for
            binding_name in self
                .binding_origins
                .keys
                .iter
        do
            if
                place binding_name.as_str origin_matches_place
                binding_name.as_str self.binding_is_live ! ||
                binding_name.as_str self
                    .scope
                    .lookup
                    .is_none ||
            then
                continue
            fi
            if binding_name.as_str self.binding_origins.get_str std::Option::Some(origins) is then
                for origin in origins.iter do
                    if
                        place origin.as_str origin_matches_place
                        origin.as_str origin_is_exclusive exclusive || &&
                    then
                        true return
                    fi
                done
            fi
        done
        for frame in self.branched_stacks.iter do
            if frame BranchFrame::BranchWhile(while_ctx) is then
                for
                    pair in while_ctx
                        .flow_before
                        .loans
                        .iter
                do
                    if
                        place pair.first.as_str origin_matches_place
                        pair.first.as_str self
                            .scope
                            .lookup
                            .is_none ||
                    then
                        continue
                    fi
                    for origin in pair.second.iter do
                        if
                            place origin.as_str origin_matches_place
                            origin.as_str origin_is_exclusive exclusive || &&
                        then
                            true return
                        fi
                    done
                done
            fi
        done
        false
    }

    pub fn has_active_owner_loan self:mut$TypeChecker owner:$str stack_depth:u64 -> bool {
        true stack_depth owner self.place_has_conflicting_loan
    }

    pub fn type_is_duplicable
        tc:mut$TypeChecker
        typ:$common::Type
        function_opt:mut$std::Option[common::Function]
    -> bool {
        if typ.is_shared_borrow then
            true return
        fi
        if typ.is_exclusive_borrow then
            false return
        fi
        if typ common::Type::Builtin(builtin) is then
            true return
        fi
        if typ common::Type::Function(_) is then
            false return
        fi
        if typ.has_unresolved_type_var then
            common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = unresolved_copy_type
            if tc.store function_opt unresolved_copy_type typ matches_trait_bound then
                true return
            fi
            tc.store unresolved_copy_type typ semantics::type_has_satisfying_trait_impl return
        fi
        typ.format = type_name
        if
            type_name tc
                .store
                .copy_types
                .get std::Option::Some(cached) is
        then
            cached.clone return
        fi
        common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
        tc.store function_opt copy_type typ matches_trait_bound = is_copy
        if is_copy ! then
            tc.store copy_type typ semantics::type_has_satisfying_trait_impl = is_copy
        fi
        is_copy type_name tc
            .store
            .copy_types
            .set
        is_copy
    }

    pub fn record_owner_assignment
        tc:mut$TypeChecker
        op:mut$common::Op
        name:$str
        typ:$common::Type
        function_opt:mut$std::Option[common::Function]
        is_global:bool
    {
        if is_global function_opt.is_some && then
            return
        fi
        if function_opt std::Option::Some(function) is then
            if name function.captures common::variable_list_contains then
                return
            fi
        fi
        if typ.is_borrow function_opt typ tc.type_is_duplicable || then
            return
        fi
        if tc.store typ common::type_needs_destruction_in_store ! then
            return
        fi
        1 += tc.next_owner_generation
        tc.next_owner_generation typ name common::OwnerEvent::new = event
        event.clone op tc.store common::add_owner_assignment
        event tc.owner_events.push
    }

    pub fn owner_cleanups_for_names
        tc:mut$TypeChecker
        names:mut$std::List[std::String]
    -> std::List[common::OwnerEvent] {
        std::List[common::OwnerEvent]::new = cleanups
        tc.owner_events.length = event_index
        while 0 event_index != do
            1 -= event_index
            event_index tc.owner_events.get = event
            if event.name.as_str names common::string_list_contains then
                event.clone cleanups.push
            fi
        done
        cleanups
    }

    pub fn remove_owner_events_for_names tc:mut$TypeChecker names:mut$std::List[std::String] {
        std::List[common::OwnerEvent]::new = remaining
        tc.owner_events.reverse
        while tc.owner_events.is_empty ! do
            tc.owner_events.pop = event
            if event.name.as_str names common::string_list_contains ! then
                event remaining.push
            fi
        done
        remaining = tc.owner_events
    }

    pub fn attach_owner_cleanups
        tc:mut$TypeChecker
        op:mut$common::Op
        names:mut$std::List[std::String]
        remove:bool
    {
        names tc.owner_cleanups_for_names = cleanups
        cleanups.reverse
        while cleanups.is_empty ! do
            cleanups.pop op tc.store common::add_owner_cleanup
        done
        if remove then
            names tc.remove_owner_events_for_names
        fi
    }

    pub fn attach_scope_cleanups tc:mut$TypeChecker op:mut$common::Op {
        tc.scope.current_names = names
        true names op tc.attach_owner_cleanups
    }

    pub fn attach_all_owner_cleanups tc:mut$TypeChecker op:mut$common::Op {
        tc.owner_events.length = event_index
        while 0 event_index != do
            1 -= event_index
            event_index tc
                .owner_events
                .get
                .clone op tc.store common::add_owner_cleanup
        done
    }

    pub fn stack_push_type tc:mut$TypeChecker type_value:$common::Type {
        false std::Option[std::List[std::String]]::None std::Option[i64]::None std::Option[std::String]::None
        type_value type_capability std::Option[std::String]::None
        std::List[LiteralRef]::new tc.current_location.clone type_value common::clone_type TypedValue
        tc
            .stack
            .values
            .push
    }

    pub fn stack_push_binding
        tc:mut$TypeChecker
        type_value:$common::Type
        name:$str
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        std::Option[std::String]::None = binding
        std::Option[i64]::None = source
        type_value common::clone_type = stack_type
        type_value type_capability = capability
        type_value.borrow_target = target_opt
        target_opt match
            std::Option::Some(target) => {
                if function_opt target tc.type_is_duplicable then
                    target = stack_type
                fi
            }
            std::Option::None => {
            }
        end
        if
            type_value.is_borrow !
            function_opt type_value tc.type_is_duplicable ! &&
        then
            if name.as_str tc.owner_is_moved then
                op.location f"Owner `{name}` was already moved" common::ErrorKind::InvalidVariable
                tc.diagnostics.record_error_string
            fi
            name.to_str std::Option::Some = binding
            op.id std::Option::Some = source
        fi
        name.to_str std::Option::Some = place
        std::Option[std::List[std::String]]::None = origins
        if name tc.binding_origins.get_str std::Option::Some(stored) is then
            stored.clone std::Option::Some = origins
            if tc.store type_value type_has_borrow ! then
                ValueCapability::Shared = capability
                for origin in stored.iter do
                    if origin.as_str origin_is_exclusive then
                        ValueCapability::Exclusive = capability
                        break
                    fi
                done
                std::Option[std::String]::None = binding
                std::Option[i64]::None = source
            fi
        fi
        false origins source binding capability place
        std::List[LiteralRef]::new tc.current_location.clone stack_type
        TypedValue
        tc
            .stack
            .values
            .push
    }

    pub fn stack_push_literal tc:mut$TypeChecker type_value:$common::Type op:mut$common::Op {
        false = is_integer
        0 = integer_value
        if op.value common::OpValue::PushInt(integer) is then
            true = is_integer
            integer.value = integer_value
        fi
        std::List[LiteralRef]::new = literals
        is_integer integer_value op.id LiteralRef literals.push
        true std::Option[std::List[std::String]]::None std::Option[i64]::None std::Option[std::String]::None
        ValueCapability::Owned std::Option[std::String]::None literals
        tc.current_location.clone type_value common::clone_type TypedValue
        tc
            .stack
            .values
            .push
    }

    pub fn stack_push_global
        tc:mut$TypeChecker
        type_value:$common::Type
        name:$str
        in_function:bool
    {
        if std::Option[common::Function]::None type_value tc.type_is_duplicable then
            type_value tc.stack_push_type return
        fi
        if
            name tc
                .store
                .immutable_globals
                .has_str in_function ||
        then
            ValueCapability::Shared
        else
            ValueCapability::Exclusive
        fi = capability
        if type_value.is_borrow then
            type_value type_capability = capability
        fi
        false std::Option[std::List[std::String]]::None std::Option[i64]::None std::Option[std::String]::None
        capability name.to_str std::Option::Some std::List[LiteralRef]::new
        tc.current_location.clone type_value common::clone_type TypedValue tc
            .stack
            .values
            .push
    }
}

pub fn borrow_argument_matches
    expected:$common::Type
    actual:$common::Type
    store:$common::SymbolStore
-> bool {
    if expected.borrow_target std::Option::Some(expected_target) is then
        if expected.is_exclusive_borrow actual.is_shared_borrow && then
            false return
        fi
        actual common::clone_type = actual_target
        if actual.borrow_target std::Option::Some(borrowed_target) is then
            borrowed_target common::clone_type = actual_target
        fi
        store actual_target expected_target semantics::unify_type_t.is_some return
    fi
    false
}

pub fn borrowed_copy_argument_matches
    tc:mut$TypeChecker
    expected:$common::Type
    actual:$common::Type
-> bool {
    if actual.borrow_target std::Option::Some(target) is then
        if tc.store target expected semantics::unify_type_t.is_none then
            false return
        fi
        std::Option[common::Function]::None target tc.type_is_duplicable return
    fi
    false
}

pub fn stack_effect_may_borrow effect:$common::StackEffect -> bool {
    for parameter in effect.parameters.iter do
        if parameter.typ.is_borrow parameter.typ common::Type::TypeVar is || then
            true return
        fi
    done
    false
}

impl TypeChecker {
    pub fn consume_value tc:mut$TypeChecker value:$TypedValue {
        if value.capability ValueCapability::Owned is ! then
            if value.place std::Option::Some(place) is then
                tc.current_location f"Cannot move borrowed value `{place}` of type `{value.type_value.format}` in `{tc.current_op_context}`; clone it first"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            else
                tc.current_location "Cannot move a borrowed value; clone it first"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error
            fi
            return
        fi
        if value.binding std::Option::Some(name) is then
            if name.as_str tc.owner_is_moved then
                tc.current_location f"Owner `{name}` was already moved"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
                return
            fi
            if
                tc
                    .stack
                    .values
                    .length name.as_str tc.has_active_owner_loan
            then
                tc.current_location f"Cannot move owner `{name}` while it is borrowed"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
                return
            fi
            true name.as_str tc.set_owner_moved
            if value.source std::Option::Some(source_op) is then
                source_op tc.store common::set_moves_owner
            fi
        fi
    }

    pub fn release_value tc:mut$TypeChecker value:$TypedValue {
        if value.binding std::Option::Some(name) is then
            if name.as_str tc.owner_is_moved then
                tc.current_location f"Owner `{name}` was already moved"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        fi
    }

    # Finish a stack use. Owned values move; borrowed values are released.
    pub fn finish_value_use self:mut$TypeChecker value:$TypedValue {
        if value.capability ValueCapability::Owned is then
            value self.consume_value
        else
            value self.release_value
        fi
    }
}

impl TypeChecker {
    pub fn report_stack_underflow tc:mut$TypeChecker message:std::String {
        if tc.underflow_reported_this_op then
            return
        fi
        tc.current_location message common::ErrorKind::StackUnderflow tc.diagnostics.record_error_string
        true = tc.underflow_reported_this_op
    }
}

impl TypeChecker {
    pub fn stack_underflow_message tc:mut$TypeChecker -> std::String {
        tc.current_expect_ctx = expect_what: $std::String
        if "" expect_what.as_str == then
            "Stack underflow: expected a value but stack is empty".to_str return
        fi
        f"Stack underflow: expected {expect_what} but stack is empty"
    }
}

impl TypeChecker {
    pub fn stack_peek_type tc:mut$TypeChecker -> common::Type {
        if
            0 tc
                .stack
                .values
                .length ==
        then
            if tc.within_param_cap then
                common::make_unknown_type common::clone_type return
            fi
            tc.stack_underflow_message tc.report_stack_underflow
            common::make_missing_type common::clone_type return
        fi
        tc
            .stack
            .values
            .length 1 - = top
        top tc
            .stack
            .values
            .get clone_typed_value = value
        if 0 value.literals.length != then
            value.type_value resolve_numeric_literal_default = resolved
            tc.literal_resolutions tc.diagnostics resolved value.resolve_literals drop
            false = value.is_literal_constant
            std::List[LiteralRef]::new = value.literals
            resolved common::clone_type = value.type_value
            value top tc
                .stack
                .values
                .set
            resolved return
        fi
        value.type_value common::clone_type
    }
}

