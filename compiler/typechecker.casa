            then
                op.location "Question-mark payload cannot borrow from its consumed source"
                ErrorKind::InvalidVariable checker.diagnostics.record_error
                return
            fi
            true hidden_name.as_str checker.set_owner_moved
        fi
    }

    fn check_function_ops
