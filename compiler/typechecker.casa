# ============================================================================
# Check stack manipulation operations
# ============================================================================

impl TypeChecker {
    fn check_stack_ops tc:mut$TypeChecker op:mut$Op {
        if op.value OpValue::Drop is then
            "value for `drop`".to_str = tc.current_expect_ctx
            if
                0 tc
                    .stack
                    .values
                    .length !=
            then
                tc.stack_peek_type clone_type Option::Some op Op::set_type_hint
            fi
            tc.stack_pop_value = value
            value tc.finish_value_use
            return
        fi
        Option[Function]::None op tc.apply_fixed_semantics
    }
}

# ============================================================================
# Check memory operations
# ============================================================================
# Returns true if `bound` names `Word` directly or transitively via supertraits.

fn bound_implies_word bound:$TraitBound store:$SymbolStore -> bool {
    bound TraitBound::name.as_str = bound_name: $str
    if "Word" bound_name.as_str == then
        true return
    fi
    bound_name store.traits.get_str = bound_trait_opt
    if bound_trait_opt.is_none then
        false return
    fi
    if bound_trait_opt Option::Some(bound_trait) is then
        for super_bound in bound_trait CasaTrait::supertraits.iter do
            if store super_bound bound_implies_word then
                true return
            fi
        done
    fi
    false
}
# Validate that `type_name` satisfies the `Word` marker trait at the given op
# location. Concrete single-slot types always satisfy `Word` in current Casa.
# A type variable from the enclosing function satisfies `Word` only when its
# declared bound is `Word` itself or a trait that extends `Word`. An unbounded
# type variable is allowed; the concrete type bound at the call site will
# satisfy `Word` automatically.

impl TypeChecker {
    fn check_word_bounds tc:mut$TypeChecker bounds:$List[TraitBound] type_name:$str op:mut$Op {
        for bound in bounds.iter do
            if tc.store bound bound_implies_word then
                return
            fi
        done
        if 0 bounds.length != then
            op.location f"Type variable `{type_name}` does not satisfy `Word` bound; add `[{type_name}: Word]` (or a trait that extends `Word`) to the function's type parameters" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        fi
    }

    fn assert_word_bound tc:mut$TypeChecker op:mut$Op typ:$Type function_opt:mut$Option[Function] {
        if typ.is_unknown_placeholder then
            return
        fi
        if function_opt Option::Some(function) is then
            if typ Type::TypeVar(type_name) is then
                function.stack_effect = word_stack_effect: $StackEffect
                if type_name word_stack_effect.type_vars.has ! then
                    return
                fi
                type_name word_stack_effect.trait_bounds.get = word_bounds_opt
                if word_bounds_opt Option::Some(word_bounds) is then
                    op type_name.as_str word_bounds tc.check_word_bounds
                fi
            fi
        fi
    }
}

impl TypeChecker {
    fn require_unsafe tc:mut$TypeChecker op:mut$Op operation:$str {
        if 0 tc.unsafe_depth != then
            return
        fi
        op.location f"Unsafe operation `{operation}` requires an `unsafe` block" ErrorKind::InvalidScope tc.diagnostics.record_error_string
    }

    fn check_memory tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        op.value unsafe_operation_name = operation
        operation op tc.require_unsafe
        if op.value OpValue::PtrRead(target_type) is then
            op.location function_opt target_type tc.validate_type_exists
            if
                target_type.has_unresolved_type_var !
                tc.store target_type type_value_representation.is_none &&
            then
                op.location f"Cannot determine representation of `{target_type.format}`"
                ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi
        elif op.value OpValue::PtrWrite(target_type) is then
            op.location function_opt target_type tc.validate_type_exists
            if
                target_type.has_unresolved_type_var !
                tc.store target_type type_value_representation.is_none &&
            then
                op.location f"Cannot determine representation of `{target_type.format}`"
                ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi
        elif op.value OpValue::PtrAsRef(target_type) is then
            op.location function_opt target_type tc.validate_type_exists
        elif op.value OpValue::PtrAsMut(target_type) is then
            op.location function_opt target_type tc.validate_type_exists
        elif op.value OpValue::PtrIntoRaw is then
            tc.stack_peek_type = source_type
            false = source_is_owned
            if
                0 tc
                    .stack
                    .values
                    .length !=
            then
                tc
                    .stack
                    .values
                    .length 1 - tc
                    .stack
                    .values
                    .get = source_value
                source_value.capability ValueCapability::Owned is = source_is_owned
            fi
            if source_is_owned ! then
                op.location "Cannot move a borrowed value; clone it first"
                ErrorKind::InvalidVariable tc.diagnostics.record_error
            elif source_type.has_unresolved_type_var ! then
                if tc.store source_type type_value_representation Option::Some(representation) is then
                    if VALUE_REPR_INDIRECT representation != then
                        op.location f"`ptr::into_raw` requires a heap-indirect owner, got `{source_type.format}`"
                        ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                    fi
                else
                    op.location f"Cannot determine representation of `{source_type.format}`"
                    ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                fi
            fi
        fi
        tc.store function_opt Option[$Type]::None op.value
        analyze_operation = semantics
        if semantics.stack_effect Option::Some(stored_effect) is then
            stored_effect.clone = effect
            # Raw stores require an explicit conversion instead of binding `T` to
            # the store width while checking a generic function body.
            if
                op.value operation_is_store 1 tc
                    .stack
                    .values
                    .length > &&
            then
                tc
                    .stack
                    .values
                    .length 2 - tc
                    .stack
                    .values
                    .get = store_value
                if store_value.type_value Type::TypeVar(_) is then
                    1 effect
                        .parameters
                        .get
                        .typ = expected_store_type: $Type
                    f"Expected `{expected_store_type.format}`, got `{store_value.type_value.format}`" tc.raise_type_mismatch
                fi
            fi
            0 (u64) = index
            while index effect.parameters.length > do
                index effect.parameters.get = parameter
                if
                    semantics.word_parameter_start index >=
                    index semantics.word_parameter_start semantics.word_parameter_count + > &&
                then
                    tc.stack_pop_type = word_type
                    function_opt word_type op tc.assert_word_bound
                else
                    parameter.typ tc.expect_type_t
                fi
                1 += index
            done
            for return_type in effect.return_types.iter do
                if op.value OpValue::PtrAsRef is then
                    false function_opt tc.raw_borrow_input_origins = origins
                    origins return_type tc.stack_push_origins
                elif op.value OpValue::PtrAsMut is then
                    true function_opt tc.raw_borrow_input_origins = origins
                    origins return_type tc.stack_push_origins
                else
                    return_type tc.stack_push_type
                fi
            done
        fi
    }
}

impl TypeChecker {
    fn apply_stack_reordering tc:mut$TypeChecker op:mut$Op -> bool {
        tc
            .stack
            .values
            .length = depth
        if op.value OpValue::Dup is then
            if 1 depth < then
                false return
            fi
            depth 1 - tc
                .stack
                .values
                .get clone_typed_value = value
            Option[String]::None = value.binding
            Option[i64]::None = value.source
            value tc
                .stack
                .values
                .push
            true return
        fi
        if op.value OpValue::Copy is then
            if 1 depth < then
                false return
            fi
            tc.stack_pop_value = value
            value.type_value clone_type = copied_type
            if copied_type.borrow_target Option::Some(target) is then
                target clone_type Option::Some op Op::set_type_hint
                target clone_type = copied_type
            fi
            copied_type tc.stack_push_type
            true return
        fi
        if op.value OpValue::Swap is then
            if 2 depth < then
                false return
            fi
            tc
                .stack
                .values
                .pop = top
            tc
                .stack
                .values
                .pop = below
            top tc
                .stack
                .values
                .push
            below tc
                .stack
                .values
                .push
            true return
        fi
        if op.value OpValue::Over is then
            if 2 depth < then
                false return
            fi
            depth 2 - tc
                .stack
                .values
                .get clone_typed_value = value
            Option[String]::None = value.binding
            Option[i64]::None = value.source
            value tc
                .stack
                .values
                .push
            true return
        fi
        if op.value OpValue::Rot is then
            if 3 depth < then
                false return
            fi
            tc
                .stack
                .values
                .pop = top
            tc
                .stack
                .values
                .pop = middle
            tc
                .stack
                .values
                .pop = bottom
            middle tc
                .stack
                .values
                .push
            top tc
                .stack
                .values
                .push
            bottom tc
                .stack
                .values
                .push
            true return
        fi
        false
    }

    fn apply_fixed_semantics tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        if op tc.apply_stack_reordering then
            return
        fi
        if
            op.value OpValue::Drop is 0 tc
                .stack
                .values
                .length != &&
        then
            tc.stack_peek_type clone_type Option::Some op Op::set_type_hint
        fi
        tc.store function_opt Option[$Type]::None op.value
        analyze_operation = semantics
        if semantics.into_stack_effect Option::Some(effect) is then
            function_opt Option[Type]::None "" effect tc.apply_stack_effect
        fi
    }
}

# ============================================================================
# Check assignment operations
# ============================================================================
# Unify the stored type of `variable` with the type being assigned to it.
# `scope` ("local" / "global") is only used in the error message.

impl TypeChecker {
    fn assignment_origins
        tc:mut$TypeChecker
        name:$str
        typ:$Type
        function_opt:mut$Option[Function]
    -> Option[List[String]] {
        Option[List[String]]::None = origins
        if
            0 tc
                .stack
                .values
                .length !=
        then
            tc
                .stack
                .values
                .length 1 - tc
                .stack
                .values
                .get = value
            value.origins clone_origins = origins
            if
                origins.is_none
                typ.is_borrow value.capability ValueCapability::Owned is ! || &&
            then
                if value.place Option::Some(place) is then
                    value.capability ValueCapability::Exclusive is place.as_str origins add_origin = origins
                fi
            fi
        fi
        if origins.is_none then
            if function_opt Option::Some(function) is then
                for
                    parameter in function
                        .stack_effect
                        .parameters
                        .iter
                do
                    if
                        name.as_str parameter.name.as_str ==
                        tc.store parameter.typ type_has_borrow &&
                    then
                        tc.store parameter.typ type_has_exclusive_borrow
                        name origins add_origin = origins
                    fi
                done
            fi
        fi
        origins
    }

    fn unify_variable_assignment
        self:mut$TypeChecker
        op:mut$Op
        variable:mut$Variable
        effective_type:$Type
        scope:str
    {
        variable Variable::name = var_name: $String
        variable Variable::typ = pre_type: $Type
        pre_type.is_unknown pre_type.is_unknown_placeholder || = pre_unknown
        if pre_unknown effective_type.is_unknown_placeholder ! && then
            effective_type clone_type variable Variable::set_typ
        fi
        self.store effective_type variable Variable::typ unify_type_t = unified
        unified match
            Option::Some(unified_type) => unified_type variable Variable::set_typ
            Option::None => {
                op Op::location f"Cannot override {scope} variable `{var_name}` of type `{variable Variable::typ.format}` with other type `{effective_type.format}`" ErrorKind::InvalidVariable self.diagnostics.record_error_string
            }
        end
    }
}

impl TypeChecker {
    fn unify_assignment_type
        self:mut$TypeChecker
        op:mut$Op
        var_name:$str
        current_type:Type
        effective_type:$Type
        scope:str
    -> Type {
        current_type = stored_type
        stored_type.is_unknown stored_type.is_unknown_placeholder || = pre_unknown
        if pre_unknown effective_type.is_unknown_placeholder ! && then
            effective_type clone_type = stored_type
        fi
        self.store effective_type stored_type unify_type_t = unified
        unified match
            Option::Some(unified_type) => unified_type
            Option::None => {
                op Op::location f"Cannot override {scope} variable `{var_name}` of type `{stored_type.format}` with other type `{effective_type.format}`" ErrorKind::InvalidVariable self.diagnostics.record_error_string
                stored_type
            }
        end
    }
}

impl TypeChecker {
    fn local_var_type
        tc:mut$TypeChecker
        var_name:$str
        function_opt:mut$Option[Function]
    -> Option[Type] {
        if var_name.as_str tc.scope.lookup Option::Some(binding_type) is then
            binding_type clone_type Option::Some return
        fi
        if function_opt Option::Some(function) is then
            var_name.as_str function Function::variables variable_list_index = local_index
            if 0 local_index >= then
                local_index (u64) function Function::variables.get Variable::typ clone_type Option::Some return
            fi
            var_name.as_str function Function::captures variable_list_index = capture_index
            if 0 capture_index >= then
                capture_index (u64) function Function::captures.get Variable::typ clone_type Option::Some return
            fi
        fi
        if
            var_name.as_str tc
                .store
                .variables
                .get_str Option::Some(global_var) is
        then
            global_var.typ clone_type Option::Some return
        fi
        Option[Type]::None
    }

    fn is_global_assignment
        self:mut$TypeChecker
        var_name:$str
        function_opt:mut$Option[Function]
    -> bool {
        if
            var_name self
                .store
                .variables
                .has_str !
        then
            false return
        fi
        if function_opt Option::Some(function) is then
            var_name.as_str function Function::variables variable_list_contains ! return
        fi
        true
    }

    fn record_implicit_binding self:mut$TypeChecker var_name:$str op:mut$Op {
        if var_name self.scope.bind ! then
            f"Binding `{var_name}` shadows an existing variable; choose a different name" = message
            op Op::location message ErrorKind::DuplicateName self.diagnostics.record_error_string
        fi
    }

    fn lower_field_assignment
        tc:mut$TypeChecker
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
        parts:List[String]
    {
        op.value clone_op_value = assignment_value
        assignment_value OpValue::AssignInc is = increment
        assignment_value OpValue::AssignDec is = decrement
        0 parts.get = root
        op Op::location.clone = location

        root.clone OpValue::PushVar = root_value
        if function_opt Option::Some(function) is then
            if root.as_str function Function::captures variable_list_contains then
                root.clone OpValue::PushCapture = root_value
            fi
        fi
        root_value op Op::set_value
        function_opt op tc.check_push_var
        op_index = insert_index

        1 (u64) = field_index
        if increment decrement || then
            while field_index parts.length > do
                location.clone field_index parts.get.clone OpValue::MethodCall Op::new = getter
                insert_index getter ops.insert
                1 += insert_index
                1 += field_index
            done
            if decrement then
                location.clone OpValue::Swap Op::new = swap_op
                insert_index swap_op ops.insert
                1 += insert_index
                location.clone OpValue::Sub Op::new = sub_op
                insert_index sub_op ops.insert
            else
                location.clone OpValue::Add Op::new = add_op
                insert_index add_op ops.insert
            fi
            1 += insert_index

            root.clone OpValue::PushVar = second_root_value
            if function_opt Option::Some(function) is then
                if root.as_str function Function::captures variable_list_contains then
                    root.clone OpValue::PushCapture = second_root_value
                fi
            fi
            location.clone second_root_value Op::new = root_op
            insert_index root_op ops.insert
            1 += insert_index
            1 (u64) = field_index
        fi

        while field_index parts.length 1 - > do
            location.clone field_index parts.get.clone OpValue::MethodCall Op::new = getter
            insert_index getter ops.insert
            1 += insert_index
            1 += field_index
        done
        parts.length 1 - parts.get = field
        location f"set_{field}".to_str OpValue::MethodCall Op::new = setter
        insert_index setter ops.insert
    }

    fn check_assignment
        tc:mut$TypeChecker
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    {
        op.value clone_op_value = assignment_value
        op op_str_value = target
        target.as_str "." str::split = target_parts
        if target_parts.length 1 < then
            target_parts function_opt op_index ops op tc.lower_field_assignment
            return
        fi
        if
            assignment_value OpValue::AssignDec is
            assignment_value OpValue::AssignInc is ||
        then
            op op_str_value = compound_name
            TYPE_UNKNOWN_T clone_type = compound_type
            if function_opt compound_name.as_str tc.local_var_type Option::Some(local_type) is then
                local_type clone_type = compound_type
            elif
                compound_name.as_str tc
                    .store
                    .variables
                    .get_str Option::Some(global_var) is
            then
                global_var.typ clone_type = compound_type
            fi
            if compound_type.is_integer_type_t ! then
                op.location f"Compound assignment requires an integer variable, got `{compound_type.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                tc.stack_pop_drop
                return
            fi
            compound_type tc.expect_type_t
            compound_type Option::Some op Op::set_type_hint
            return
        fi
        if assignment_value OpValue::AssignVar(var_name) is then
            op Op::type_hint.is_some = has_annotation
            TYPE_UNKNOWN_T clone_type = stack_type_t
            TYPE_UNKNOWN_T clone_type = effective_type_t
            if has_annotation then
                op Op::type_hint.clone = hint_opt
                if hint_opt.is_none then
                    empty_location "Expected option value while unwrapping op Op::type_hint" ErrorKind::Syntax tc.diagnostics.record_error
                    return
                fi
                hint_opt.unwrap = effective_type_t
                op Op::location function_opt effective_type_t tc.validate_type_exists
                effective_type_t clone_type = stack_type_t
            else
                tc.stack_peek_type = stack_type_t
                stack_type_t clone_type = effective_type_t
            fi
            if has_annotation ! stack_type_t.has_unresolved && then
                op.location f"Cannot infer element type of empty array literal assigned to `{var_name}`; add a type annotation (e.g. `= {var_name}:array[i64 0]`) or an explicit cast (e.g. `[] (array[i64 0])`)." ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi

            function_opt var_name.as_str tc.is_global_assignment = is_global
            is_global var_name.as_str tc.scope.assign

            if var_name.as_str tc.scope.is_block_binding then
                var_name.as_str tc
                    .scope
                    .lookup
                    .unwrap = scoped_type
                "local" effective_type_t scoped_type var_name.as_str op tc.unify_assignment_type = unified_scoped
                unified_scoped clone_type var_name.as_str tc.scope.set_type drop
                function_opt effective_type_t var_name.as_str tc.assignment_origins = origins
                effective_type_t tc.expect_type_t
                origins var_name.as_str tc.record_binding_origins
                if is_global ! then
                    false var_name.as_str tc.set_owner_moved
                    is_global function_opt unified_scoped var_name.as_str op tc.record_owner_assignment
                fi
                return
            fi

            # Try local variables first
            -1 (i64) = local_index
            if function_opt Option::Some(function) is then
                var_name.as_str function Function::variables variable_list_index = local_index
            fi
            if 0 local_index >= then
                TYPE_UNKNOWN_T clone_type = current_local_type
                if function_opt Option::Some(function) is then
                    local_index (u64) function Function::variables.get Variable::typ clone_type = current_local_type
                fi
                if var_name.as_str tc.scope.lookup Option::Some(binding_type) is then
                    if binding_type.is_unknown ! binding_type.is_unknown_placeholder ! && then
                        binding_type clone_type = current_local_type
                    fi
                fi
                "local" effective_type_t current_local_type var_name.as_str op tc.unify_assignment_type = unified_local
                unified_local clone_type var_name.as_str tc.scope.set_type drop
                function_opt effective_type_t var_name.as_str tc.assignment_origins = origins
                effective_type_t tc.expect_type_t
                origins var_name.as_str tc.record_binding_origins
                if is_global ! then
                    false var_name.as_str tc.set_owner_moved
                    is_global function_opt unified_local var_name.as_str op tc.record_owner_assignment
                fi
                if function_opt Option::Some(function) is then
                    local_index (u64) function Function::variables.get_mut = local_var
                    unified_local local_var Variable::set_typ
                fi
                return
            fi

            # Assignments to a capture update the closure record. Owned moving
            # captures stay owned by the closure across invocations.
            -1 (i64) = capture_index
            if function_opt Option::Some(function) is then
                var_name.as_str function Function::captures variable_list_index = capture_index
            fi
            if 0 capture_index >= then
                function_opt var_name.as_str tc.local_var_type.unwrap = captured_type
                "capture" effective_type_t captured_type var_name.as_str op tc.unify_assignment_type
                = unified_capture
                function_opt effective_type_t var_name.as_str tc.assignment_origins = origins
                effective_type_t tc.expect_type_t
                origins var_name.as_str tc.record_binding_origins
                false var_name.as_str tc.set_owner_moved
                unified_capture drop
                return
            fi

            # Try global variables
            var_name.as_str tc
                .store
                .variables
                .remove_str = global_opt
            if global_opt.is_some then
                global_opt.unwrap = global_var
                "global" effective_type_t global_var op tc.unify_variable_assignment
                function_opt effective_type_t var_name.as_str tc.assignment_origins = origins
                effective_type_t tc.expect_type_t
                origins var_name.as_str tc.record_binding_origins
                if is_global ! var_name.as_str is_internal_variable_name || then
                    false var_name.as_str tc.set_owner_moved
                fi
                global_var.typ clone_type = global_type
                is_global function_opt global_type var_name.as_str op tc.record_owner_assignment
                global_var var_name.clone tc
                    .store
                    .variables
                    .set
                return
            fi
            function_opt effective_type_t var_name.as_str tc.assignment_origins = origins
            effective_type_t tc.expect_type_t
            origins var_name.as_str tc.record_binding_origins
            if is_global ! then
                false var_name.as_str tc.set_owner_moved
            fi
            is_global function_opt effective_type_t var_name.as_str op tc.record_owner_assignment
        fi
    }
}

impl TypeChecker {
    fn check_method_receiver_capability
        tc:mut$TypeChecker
        effect:$StackEffect
        capability:$ValueCapability
        method_name:$str
    {
        effect method_receiver_type = expected_receiver_opt
        if expected_receiver_opt Option::Some(expected_receiver) is then
            if expected_receiver capability capability_matches_receiver ! then
                if expected_receiver.is_exclusive_borrow then
                    "exclusive"
                else
                    "owned"
                fi
                = requirement
                tc.current_location
                f"Method `{method_name}` requires an {requirement} receiver"
                ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi
        fi
    }

    fn check_trait_method_call tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        if function_opt.is_none then
            return
        fi
        tc.stack_peek_type = receiver
        ValueCapability::Owned = receiver_capability
        if
            0 tc
                .stack
                .values
                .length !=
        then
            tc
                .stack
                .values
                .length 1 - tc
                .stack
                .values
                .get
                .capability = receiver_capability
        fi
        tc.store function_opt receiver make_type_borrow_option op.value analyze_operation
        = semantics
        if semantics.into_method Option::Some(method) is then
            method.stack_effect.clone = effect
            method.method_name.as_str receiver_capability effect tc.check_method_receiver_capability
            method.method_name.as_str receiver.make_method_key = method_key
            function_opt Option[Type]::None method_key.as_str effect tc.apply_stack_effect
        fi
    }
}

# ============================================================================
# Check push variable / capture
# ============================================================================

impl TypeChecker {
    fn check_push_var tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        op.value clone_op_value = push_value
        if push_value OpValue::PushCapture(capture_name) is then
            capture_name.as_str tc.use_binding
            Option[Type]::None = capture_type_opt
            false = is_global_capture
            if function_opt Option::Some(function) is then
                capture_name.as_str function Function::captures variable_list_index = capture_index
                if 0 capture_index >= then
                    if capture_index (u64) function Function::captures.get Variable::typ.is_unknown ! then
                        capture_index (u64) function Function::captures.get Variable::typ clone_type Option::Some = capture_type_opt
                        capture_name.as_str function.global_captures string_list_contains = is_global_capture
                    fi
                fi
            fi
            if capture_type_opt Option::Some(capture_type) is then
                if is_global_capture then
                    true capture_name.as_str capture_type tc.stack_push_global
                else
                    function_opt op capture_name.as_str capture_type tc.stack_push_binding
                fi
                return
            fi
            TYPE_UNKNOWN_T tc.stack_push_type
            return
        fi

        # PUSH_VARIABLE
        if push_value OpValue::PushVar(var_name) is then
            var_name.as_str tc.use_binding
            if var_name.as_str tc.scope.is_expired then
                op Op::location f"Variable `{var_name}` is not accessible outside its block scope" ErrorKind::UndefinedName tc.diagnostics.record_error_string
                TYPE_UNKNOWN_T tc.stack_push_type
                return
            fi

            # Check local variables first
            if function_opt var_name.as_str tc.local_var_type Option::Some(local_type) is then
                if local_type.is_unknown ! then
                    if function_opt var_name.as_str tc.is_global_assignment then
                        if var_name.as_str is_internal_variable_name then
                            function_opt op var_name.as_str local_type tc.stack_push_binding
                        else
                            function_opt.is_some var_name.as_str local_type tc.stack_push_global
                        fi
                    else
                        function_opt op var_name.as_str local_type tc.stack_push_binding
                    fi
                else
                    TYPE_UNKNOWN_T tc.stack_push_type
                fi
                return
            fi

            # Check global variables
            var_name.as_str tc
                .store
                .variables
                .get_str = global_opt
            if global_opt Option::Some(global_var) is then
                if global_var Variable::typ.is_unknown ! then
                    function_opt.is_some var_name.as_str global_var Variable::typ tc.stack_push_global
                else
                    TYPE_UNKNOWN_T tc.stack_push_type
                fi
                return
            fi

            op Op::location f"Variable `{var_name}` is not defined" ErrorKind::UndefinedName tc.diagnostics.record_error_string
        fi
    }
}

# ============================================================================
# Check if/elif/else/fi blocks
# ============================================================================

impl TypeChecker {
    fn merge_if_branch_stack self:mut$TypeChecker op:mut$Op if_ctx:mut$IfContext {
        op Op::location.clone if_ctx IfContext::set_current_branch_location
        if_ctx IfContext::before = if_before: mut$TypedStack
        if_ctx IfContext::after = if_after: mut$TypedStack
        if if_before self.stack.equals if_after if_before.equals && then
            return
        fi
        self.store if_after self.stack.unify_types = unified
        if 0 unified.length != if_after if_before.equals ! && then
            self.stack if_after.merge_literals
            if_after.mark_literals_runtime
            unified if_after.set_types
            if_before self.stack.restore
        elif if_after if_before.equals then
            self.stack if_after.restore
            if_before self.stack.restore
        else
            op Op::location "Branches have incompatible stack effects"
            ErrorKind::StackMismatch self.diagnostics.record_error
        fi
    }

    fn check_if_block tc:mut$TypeChecker op:mut$Op {
        op.value clone_op_value = if_value
        if if_value OpValue::IfStart is then
            IfContext::new = if_ctx
            tc.path_continues = if_ctx.entry_continues
            op Op::location.clone if_ctx IfContext::set_current_branch_location
            if_ctx BranchFrame::BranchIf = if_frame
            if_frame tc.branched_stacks.push
            # Scope the then-branch: is-bindings from the condition and any
            # block-local assignments live here until the next branch or `fi`.
            tc.scope.enter
            true = tc.in_branch_condition
        elif if_value OpValue::IfCondition is then
            false = tc.in_branch_condition
            TYPE_BOOL_T tc.expect_type_t
            if 0 tc.branched_stacks.length == then
                return
            fi
            tc
                .branched_stacks
                .pop
                .into_if = if_ctx
            tc.current_ownership_flow = if_ctx.flow_before
            if if_ctx IfContext::condition_present ! then
                true if_ctx IfContext::set_condition_present
                tc.stack if_ctx IfContext::before.restore
                tc.stack if_ctx IfContext::after.restore
                "if".to_str if_ctx IfContext::set_current_branch_label
            fi
            if_ctx BranchFrame::BranchIf tc.branched_stacks.push
        elif
            if_value OpValue::IfElif is
            if_value OpValue::IfElse is ||
        then
            # Close the preceding branch scope and open a fresh one. Each
            # branch gets independent is-bindings and block-local variables.
            if 0 tc.branched_stacks.length == then
                return
            fi
            tc
                .branched_stacks
                .pop
                .into_if = if_ctx
            if tc.path_continues then
                if_ctx.before tc.materialize_branch_results
            fi
            op tc.attach_scope_cleanups
            tc.scope.exit
            tc.scope.enter
            if_ctx.flow_after tc.merge_current_ownership_flow
            if tc.path_continues then
                true = if_ctx.has_continuing_branch
            fi
            if_ctx.flow_before tc.restore_ownership_flow
            if_ctx.entry_continues = tc.path_continues
            if if_value OpValue::IfElse is then
                true if_ctx IfContext::set_default_present
                false = tc.in_branch_condition
            else
                true = tc.in_branch_condition
            fi
            if_ctx op tc.merge_if_branch_stack
            if_ctx BranchFrame::BranchIf tc.branched_stacks.push
        elif if_value OpValue::IfEnd is then
            tc
                .branched_stacks
                .pop
                .into_if = if_ctx
            if tc.path_continues then
                if_ctx.before tc.materialize_branch_results
            fi
            # Close the final branch scope after its result takes ownership.
            op tc.attach_scope_cleanups
            tc.scope.exit
            if_ctx.flow_after tc.merge_current_ownership_flow
            if tc.path_continues then
                true = if_ctx.has_continuing_branch
            fi
            if if_ctx.default_present ! if_ctx.entry_continues && then
                if_ctx.flow_before if_ctx.flow_after.merge
                true = if_ctx.has_continuing_branch
            fi
            if if_ctx.has_continuing_branch then
                if_ctx.flow_after tc.restore_ownership_flow
            else
                if_ctx.flow_before tc.restore_ownership_flow
            fi
            if_ctx.has_continuing_branch = tc.path_continues
            if_ctx IfContext::before = if_before: mut$TypedStack
            if_ctx IfContext::after = if_after: mut$TypedStack
            if if_before tc.stack.equals if_after if_before.equals && then
                return
            fi
            tc.store if_after tc.stack.unify_types = unified
            if 0 unified.length != if_ctx IfContext::default_present && then
                tc.stack if_after.merge_literals
                if_after.mark_literals_runtime
                if_after tc.stack.restore
                unified tc.stack.set_types
                return
            fi
            tc.store if_before tc.stack.unify_types = unified_before
            if 0 unified_before.length != if_ctx IfContext::default_present ! && then
                tc.stack if_before.merge_literals
                if_before tc.stack.restore
                unified_before tc.stack.set_types
                return
            fi
            op Op::location "Branches have incompatible stack effects" ErrorKind::StackMismatch tc.diagnostics.record_error
        fi
    }
}

# ============================================================================
# Check while/do/break/continue/done blocks
# ============================================================================

impl TypeChecker {
    fn current_while_scope_depth tc:mut$TypeChecker -> Option[u64] {
        tc.branched_stacks.length = frame_index
        while 0 frame_index != do
            1 -= frame_index
            if frame_index tc.branched_stacks.get BranchFrame::BranchWhile(while_ctx) is then
                while_ctx.scope_depth Option::Some return
            fi
        done
        Option[u64]::None
    }

    fn check_while_block tc:mut$TypeChecker op:mut$Op {
        op.value clone_op_value = while_value
        if while_value OpValue::WhileStart is then
            tc
                .scope
                .frames
                .length 1 + WhileContext::new = while_ctx
            tc.current_ownership_flow = while_ctx.flow_before
            tc.path_continues = while_ctx.entry_continues
            tc.stack while_ctx WhileContext::before.restore
            op Op::location.clone while_ctx WhileContext::set_current_branch_location
            while_ctx BranchFrame::BranchWhile = while_frame
            while_frame tc.branched_stacks.push
            tc.scope.enter
        elif while_value OpValue::WhileCondition is then
            TYPE_BOOL_T tc.expect_type_t
            if 0 tc.branched_stacks.length == then
                return
            fi
            tc
                .branched_stacks
                .pop
                .into_while = while_ctx
            true while_ctx WhileContext::set_condition_present
            while_ctx.flow_exit tc.merge_current_ownership_flow
            if tc.path_continues then
                true = while_ctx.has_exit
            fi
            while_ctx BranchFrame::BranchWhile tc.branched_stacks.push
        elif
            while_value OpValue::WhileBreak is
            while_value OpValue::WhileContinue is ||
        then
            if 0 tc.branched_stacks.length == then
                return
            fi
            if tc.current_while_scope_depth Option::Some(scope_depth) is then
                scope_depth tc.scope.names_from = names
                tc.branched_stacks.length = frame_index
                while 0 frame_index != do
                    1 -= frame_index
                    frame_index tc
                        .branched_stacks
                        .remove
                        .unwrap = top_frame
                    false = found_while
                    if top_frame BranchFrame::BranchWhile is then
                        top_frame.into_while = while_ctx
                        true = found_while
                        if tc.path_continues then
                            if while_value OpValue::WhileBreak is then
                                tc.current_ownership_flow while_ctx.flow_exit.merge
                                true = while_ctx.has_exit
                            else
                                op names while_ctx.flow_before tc.report_loop_flow_difference
                            fi
                        fi
                        while_ctx BranchFrame::BranchWhile = top_frame
                    fi
                    frame_index top_frame tc.branched_stacks.insert
                    if found_while then
                        break
                    fi
                done
                false names op tc.attach_owner_cleanups
            fi
            false = tc.path_continues
        elif while_value OpValue::WhileEnd is then
            op tc.attach_scope_cleanups
            tc
                .branched_stacks
                .pop
                .into_while = while_ctx
            while_ctx.scope_depth tc.scope.names_from = names
            if tc.path_continues then
                op names while_ctx.flow_before tc.report_loop_flow_difference
            fi
            tc.scope.exit
            if while_ctx.has_exit then
                while_ctx.flow_exit tc.restore_ownership_flow
            else
                while_ctx.flow_before tc.restore_ownership_flow
            fi
            names tc.remove_flow_names
            while_ctx.has_exit = tc.path_continues
        fi
    }
}

# ============================================================================
# Trait support: bind_generic_params_standalone, type_satisfies_trait, inject_trait_fn_ptrs
# ============================================================================

fn bind_direct_generic_params
    bindings:Map[String Type]
    expected_type:$Type
    actual_type:$Type
    type_vars:$Set[String]
-> Map[String Type] {
    if expected_type.type_var_name Option::Some(type_var_name) is then
        if type_var_name type_vars.has type_var_name bindings.get.is_none && then
            actual_type clone_type type_var_name.clone bindings.set
        fi
        bindings return
    fi
    if expected_type Type::Generic(expected_generic) is then
        if actual_type Type::Generic(actual_generic) is then
            if expected_generic.base actual_generic.base != then
                bindings return
            fi
            0 (u64) = index
            while
                index expected_generic.params.length >
                index actual_generic.params.length > &&
            do
                index expected_generic.params.get = expected_parameter
                if expected_parameter.type_var_name Option::Some(type_var_name) is then
                    if type_var_name type_vars.has type_var_name bindings.get.is_none && then
                        index actual_generic.params.get clone_type type_var_name.clone bindings.set
                    fi
                fi
                1 += index
            done
        fi
    fi
    bindings
}

fn bind_generic_params_standalone
    bindings:Map[String Type]
    expected_type:$Type
    actual_type:$Type
    type_vars:$Set[String]
-> Map[String Type] {
    type_vars actual_type expected_type bindings bind_direct_generic_params = bindings
    if expected_type Type::Function(expected_function) is then
        if actual_type Type::Function(actual_function) is then
            0 (u64) = index
            while
                index expected_function.parameters.length >
                index actual_function.parameters.length > &&
            do
                type_vars index actual_function.parameters.get index expected_function.parameters.get bindings
                bind_direct_generic_params = bindings
                1 += index
            done
            0 (u64) = index
            while
                index expected_function.return_types.length >
                index actual_function.return_types.length > &&
            do
                type_vars index actual_function.return_types.get index expected_function.return_types.get bindings
                bind_direct_generic_params = bindings
                1 += index
            done
        fi
    fi
    bindings
}
# Bind every symbolic constant parameter in `expected` to the argument in the
# matching position of `actual` (ADR-0152). The bound value is either a concrete
# constant or the caller's own constant parameter when the call forwards it.

fn bind_standalone_constant_parameters
    bindings:Map[String Type]
    expected:$Type
    actual:$Type
-> Map[String Type] {
    if expected Type::Const(expected_constant) is then
        if expected_constant.is_symbolic expected_constant.name bindings.has ! && then
            actual clone_type expected_constant.name.clone bindings.set
        fi
        bindings return
    fi
    if expected Type::Generic(expected_generic) is then
        actual expected_generic bindings bind_matching_generic_constant_parameters return
    fi
    bindings
}

fn bind_matching_generic_constant_parameters
    bindings:Map[String Type]
    expected:$GenericType
    actual:$Type
-> Map[String Type] {
    if actual Type::Generic(actual_generic) is then
        if expected.base actual_generic.base != then
            bindings return
        fi
        if expected.params.length actual_generic.params.length != then
            bindings return
        fi
        for
            pair in actual_generic.params.iter expected
                .params
                .iter
                .zip
        do
            pair.second pair.first bindings bind_standalone_constant_parameters = bindings
        done
    fi
    bindings
}

fn matches_trait_bound
    receiver:$Type
    trait_type:$Type
    function_opt:mut$Option[Function]
    store:mut$SymbolStore
-> bool {
    if function_opt Option::Some(function) is then
        if receiver Type::TypeVar(type_var_name) is then
            type_var_name function
                .stack_effect
                .trait_bounds
                .get = bounds_opt
            if bounds_opt Option::Some(bounds) is then
                for bound in bounds.iter do
                    bound trait_bound_to_type = bound_type
                    if store trait_type bound_type trait_type_implies then
                        true return
                    fi
                done
            fi
        fi
    fi
    false
}

fn bind_stack_effect_pattern pattern:$StackEffect actual:$StackEffect -> Option[Map[String Type]] {
    if pattern.parameters.length actual.parameters.length != then
        Option[Map[String Type]]::None return
    fi
    if pattern.return_types.length actual.return_types.length != then
        Option[Map[String Type]]::None return
    fi
    Map[String Type]::new = bindings
    for
        pair in actual.parameters.iter pattern
            .parameters
            .iter
            .zip
    do
        if bindings pair.second.typ pair.first.typ bind_trait_impl_type ! then
            Option[Map[String Type]]::None return
        fi
    done
    for
        pair in actual.return_types.iter pattern
            .return_types
            .iter
            .zip
    do
        if bindings pair.second pair.first bind_trait_impl_type ! then
            Option[Map[String Type]]::None return
        fi
    done
    bindings Option::Some
}

fn stack_effect_type_variables effect:$StackEffect -> Set[String] {
    Set[String]::new = type_variables
    for parameter in effect.parameters.iter do
        type_variables parameter.typ collect_stack_effect_type_vars
    done
    for return_type in effect.return_types.iter do
        type_variables return_type collect_stack_effect_type_vars
    done
    type_variables
}

fn trait_method_effects_match
    expected:$StackEffect
    actual:$StackEffect
    generic_declaration:bool
-> bool {
    List[Parameter]::new = actual_parameters
    0 (u64) = actual_index
    while actual_index actual.parameters.length > do
        if
            actual_index actual
                .parameters
                .get_ref
                .name
                .as_str is_hidden_parameter_name !
        then
            actual_index actual.parameters.get clone_parameter actual_parameters.push
        fi
        1 += actual_index
    done
    actual.return_types.clone actual_parameters StackEffect::new = visible_actual
    visible_actual expected bind_stack_effect_pattern = expected_match
    if generic_declaration then
        if expected_match Option::Some(expected_bindings) is then
            expected stack_effect_type_variables = expected_type_variables
            for type_variable in expected_type_variables.iter do
                if type_variable expected_bindings.get Option::Some(bound) is then
                    if bound Type::TypeVar(_) is ! then
                        false return
                    fi
                fi
            done
            true return
        fi
        false return
    fi
    if expected_match.is_some then
        true return
    fi
    expected visible_actual bind_stack_effect_pattern.is_some
}

fn collect_trait_shape_requirements
    trait_type:$Type
    store:$SymbolStore
-> Option[List[TraitMethod]] Map[String Type] {
    Map[String Type]::new = substitutions
    if trait_type.match_base store.traits.get Option::Some(casa_trait) is then
        if trait_type.type_params Option::Some(trait_arguments) is then
            if trait_arguments.length casa_trait.type_params.length == then
                for
                    pair in trait_arguments.iter casa_trait
                        .type_params
                        .iter
                        .zip
                do
                    pair.second clone_type pair.first.clone substitutions.set
                done
            fi
        fi
        casa_trait store collect_trait_methods Option::Some substitutions
    else
        Option[List[TraitMethod]]::None substitutions
    fi
}

fn collect_trait_methods_named trait_name:$str store:$SymbolStore -> List[TraitMethod] {
    if trait_name store.traits.get_str Option::Some(casa_trait) is then
        casa_trait store collect_trait_methods
    else
        List[TraitMethod]::new
    fi
}

fn type_has_trait_shape
    receiver:$Type
    trait_type:$Type
    store:mut$SymbolStore
    diagnostics:mut$Diagnostics
    generic_declaration:bool
-> bool {
    trait_type.match_base = trait_lookup_name
    store trait_type collect_trait_shape_requirements = trait_subs = trait_methods_opt
    if trait_methods_opt Option::Some(trait_methods) is then
        for method in trait_methods.iter do
            Option[CheckedFunction]::None = fn_opt
            if store receiver method.name.as_str find_semantic_method_function Option::Some(fn_name) is then
                diagnostics store fn_name.as_str ensure_typechecked = fn_opt
            fi
            if fn_opt.is_none then
                store receiver method.name.as_str resolve_default_method_semantics = semantics_opt
                if semantics_opt Option::Some(method_semantics) is then
                    if method_semantics.kind MethodSemanticsKind::DefaultMethod is then
                        continue
                    fi
                    diagnostics store method_semantics.function_name.as_str ensure_typechecked = fn_opt
                fi
            fi
            if fn_opt.is_none then
                # Default methods (with a body) don't require a concrete implementation
                if 0 method TraitMethod::default_ops.length != then
                    continue
                fi
                false return
            fi
            fn_opt.unwrap = function
            function.stack_effect stack_effect_to_str = effect_text
            if "None -> None" effect_text.as_str == then
                false return
            fi
            trait_subs receiver method TraitMethod::stack_effect resolve_trait_stack_effect apply_type_subs_to_stack_effect = resolved
            if generic_declaration function.stack_effect resolved trait_method_effects_match ! then
                false return
            fi
        done
        true
    else
        false
    fi
}

fn type_satisfies_trait
    receiver:$Type
    trait_type:$Type
    function_opt:mut$Option[Function]
    store:mut$SymbolStore
    diagnostics:mut$Diagnostics
-> bool {
    receiver clone_type = receiver_type
    if receiver.borrow_target Option::Some(target) is then
        if
            "Copy" trait_type.match_base.as_str ==
            "Clone" trait_type.match_base.as_str == ||
        then
            false return
        fi
        target clone_type = receiver_type
    fi
    if "Clone" trait_type.match_base.as_str == receiver_type Type::Function(_) is && then
        "Copy".to_str GenericType::new Type::Generic = copy_type
        if store trait_type copy_type trait_type_implies then
            true return
        fi
    fi
    if store function_opt trait_type receiver_type matches_trait_bound then
        true return
    fi
    if store trait_type receiver_type type_has_satisfying_trait_impl ! then
        false return
    fi
    false diagnostics store trait_type receiver_type type_has_trait_shape
}

fn find_tparam_index tparams:$List[String] name:$str -> Option[u64] {
    Option[u64]::None = found_index
    0 (u64) = scan_index
    while scan_index tparams.length > do
        if scan_index tparams.get.as_str name == then
            scan_index Option::Some = found_index
        fi
        1 += scan_index
    done
    found_index
}

fn try_bind_caller_tvar
    bindings:mut$Map[String Type]
    effect:$StackEffect
    caller_ref:$Type
    concrete:$Type
{
    if caller_ref.type_var_name Option::Some(caller_type_var) is then
        if caller_type_var.as_str effect StackEffect::type_vars.has_str ! then
            return
        fi
        if caller_type_var.as_str bindings.get_str Option::Some is then
            return
        fi
        concrete clone_type caller_type_var.clone bindings.set
    fi
}
# Given a single (trait-side expected type, concrete-side actual type) pair
# from a method stack-effect diff, if the expected type references a trait
# type parameter that maps (via the current bound's type args) to an unbound
# caller type variable, bind it to the actual type. Handles both direct
# references (`T`) and one-level nested generics (`Option[T]` vs `Option[i64]`).

fn bind_from_type_slot
    bindings:mut$Map[String Type]
    effect:$StackEffect
    tparams:$List[String]
    bargs:$List[Type]
    expected:$Type
    actual:$Type
{
    if expected.type_var_name Option::Some(direct_tv_name) is then
        direct_tv_name.as_str tparams find_tparam_index = direct_tp_idx
        if direct_tp_idx Option::Some(direct_index) is then
            direct_index bargs.get = direct_caller_ref
            actual direct_caller_ref effect bindings try_bind_caller_tvar
            return
        fi
        return
    fi
    if expected.as_generic Option::Some(expected_g) is then
        if actual.as_generic Option::Some(actual_g) is then
            if expected_g.base actual_g.base == then
                0 (u64) = slot_index
                while
                    slot_index expected_g.params.length >
                    slot_index actual_g.params.length > &&
                do
                    if
                        slot_index expected_g
                            .params
                            .get
                            .type_var_name Option::Some(nested_name) is
                    then
                        nested_name.as_str tparams find_tparam_index = nested_tp_idx
                        if nested_tp_idx Option::Some(nested_index) is then
                            nested_index bargs.get = nested_caller_ref
                            slot_index actual_g.params.get nested_caller_ref effect bindings try_bind_caller_tvar
                        fi
                    fi
                    1 += slot_index
                done
            fi
        fi
    fi
}

fn diff_method_stack_effect
    bindings:mut$Map[String Type]
    effect:$StackEffect
    tparams:$List[String]
    bargs:$List[Type]
    trait_resolved:$StackEffect
    impl_stack_effect:$StackEffect
{
    0 (u64) = param_index
    while
        param_index trait_resolved StackEffect::parameters.length >
        param_index impl_stack_effect StackEffect::parameters.length > &&
    do
        param_index trait_resolved StackEffect::parameters.get Parameter::typ = expected_param: $Type
        param_index impl_stack_effect StackEffect::parameters.get Parameter::typ = actual_param: $Type
        actual_param expected_param bargs tparams effect bindings bind_from_type_slot
        1 += param_index
    done
    0 (u64) = return_index
    while
        return_index trait_resolved StackEffect::return_types.length >
        return_index impl_stack_effect StackEffect::return_types.length > &&
    do
        return_index trait_resolved StackEffect::return_types.get = expected_return
        return_index impl_stack_effect StackEffect::return_types.get = actual_return
        actual_return expected_return bargs tparams effect bindings bind_from_type_slot
        1 += return_index
    done
}

fn method_diff_bind_for_bound
    bindings:mut$Map[String Type]
    effect:$StackEffect
    bound:$TraitBound
    concrete:$Type
    store:$SymbolStore
{
    bound TraitBound::name.as_str store.traits.get_str = trait_opt
    if trait_opt.is_none then
        return
    fi
    trait_opt.unwrap = trait_def
    trait_def CasaTrait::type_params = trait_params: $List[String]
    bound TraitBound::type_args = bound_args: $List[Type]
    if bound_args.length trait_params.length != then
        return
    fi
    for trait_method in trait_def CasaTrait::methods.iter do
        store Option[Function]::None concrete trait_method.name.as_str resolve_method_semantics
        = method_opt
        if method_opt Option::Some(method_semantics) is then
            method_semantics.function_name = function_name: $String
            if function_name.as_str store.functions.get_str Option::Some(concrete_fn) is then
                concrete trait_method TraitMethod::stack_effect resolve_trait_stack_effect
                = trait_resolved
                concrete_fn Function::stack_effect trait_resolved bound_args trait_params effect
                bindings diff_method_stack_effect
            fi
        fi
    done
}

fn method_diff_bind_all
    effect:$StackEffect
    function_opt:mut$Option[Function]
    bindings:mut$Map[String Type]
    store:$SymbolStore
{
    effect StackEffect::trait_bounds.keys = bound_keys
    for bound_type_var in bound_keys.iter do
        if bound_type_var effect StackEffect::trait_bounds.get Option::Some(constraints) is then
            bound_type_var.as_str bindings clone_type_binding = concrete_opt
            if concrete_opt Option::Some(concrete) is then
                for bound_constraint in constraints.iter do
                    store concrete bound_constraint effect bindings method_diff_bind_for_bound
                done
            fi
        fi
    done
}

fn bounds_imply_trait bounds:$List[TraitBound] target:$Type store:$SymbolStore -> bool {
    for bound in bounds.iter do
        bound trait_bound_to_type = direct
        if store target direct trait_type_implies then
            true return
        fi
    done
    false
}

fn caller_forwards_trait_bound
    function_opt:mut$Option[Function]
    concrete_name:$str
    trait_type:$Type
    store:$SymbolStore
-> bool {
    if function_opt Option::Some(function) is then
        if
            concrete_name function
                .stack_effect
                .trait_bounds
                .get_str Option::Some(caller_bounds) is
        then
            if store trait_type caller_bounds bounds_imply_trait then
                true return
            fi
        fi
    fi
    false
}

fn find_forwarded_layout_argument
    function_opt:mut$Option[Function]
    parameter_name:$str
-> Option[OpValue] {
    if function_opt Option::Some(caller) is then
        for
            caller_parameter in caller
                .stack_effect
                .parameters
                .iter
        do
            if parameter_name caller_parameter.name.as_str == then
                parameter_name.to_str OpValue::PushVar Option::Some return
            fi
        done
        if parameter_name caller.captures variable_list_contains then
            parameter_name.to_str OpValue::PushCapture Option::Some return
        fi
    fi
    Option[OpValue]::None
}

impl TypeChecker {
    fn ensure_function_clone_method self:mut$TypeChecker typ:$Type location:$Location {
        if typ Type::Function(_) is ! then
            return
        fi
        if
            "Copy" self
                .store
                .traits
                .has_str ! "Clone".to_str self
                .store
                .traits
                .has ! ||
        then
            return
        fi
        "Copy".to_str GenericType::new Type::Generic = copy_type
        "Clone".to_str GenericType::new Type::Generic = clone_trait_type
        if self.store clone_trait_type copy_type trait_type_implies ! then
            return
        fi

        "clone" typ.make_method_key = function_name
        if
            function_name.as_str self
                .store
                .functions
                .has_str
        then
            return
        fi

        List[Parameter]::new = parameters
        "self".to_str typ clone_type Parameter::named parameters.push
        List[Type]::new = returns
        typ clone_type returns.push
        returns parameters StackEffect::new = effect

        List[Op]::new = ops
        location.clone "self".to_str OpValue::AssignVar Op::new ops.push
        location.clone "self".to_str OpValue::PushVar Op::new ops.push
        effect location.clone ops function_name.clone Function::with_stack_effect = function
        List[Variable]::new = variables
        typ clone_type "self".to_str Variable variables.push
        variables function Function::set_variables
        function function_name self
            .store
            .functions
            .set
    }

    fn ensure_layout_adapter
        self:mut$TypeChecker
        target_name:$str
        exposed_effect:$StackEffect
        concrete_type:$Type
        method_name:$str
        location:$Location
    -> String {
        f"__layout_adapter_{target_name}_{concrete_type.format}_{method_name}" = adapter_name
        if
            adapter_name.as_str self
                .store
                .functions
                .has_str
        then
            adapter_name return
        fi

        List[Op]::new = adapter_ops
        List[Variable]::new = adapter_variables
        for parameter in exposed_effect.parameters.iter do
            parameter.name.clone = parameter_name
            parameter.typ clone_type parameter_name.clone Variable adapter_variables.push
            location.clone parameter_name.clone OpValue::AssignVar Op::new adapter_ops.push
        done
        exposed_effect.parameters.length = parameter_index
        while 0 parameter_index != do
            1 -= parameter_index
            parameter_index exposed_effect.parameters.get = parameter
            location.clone parameter.name.clone OpValue::PushVar Op::new adapter_ops.push
        done
        location.clone target_name.to_str OpValue::FnCall Op::new adapter_ops.push

        exposed_effect clone_stack_effect location.clone adapter_ops adapter_name.clone
        Function::with_stack_effect = adapter
        adapter_variables adapter Function::set_variables
        true adapter Function::set_is_used
        adapter adapter_name.clone self
            .store
            .functions
            .set
        self.diagnostics self.store adapter_name.as_str ensure_typechecked drop
        adapter_name
    }

    fn bind_concrete_type_variable
        tc:mut$TypeChecker
        name:$str
        actual:$Type
        bindings:Map[String Type]
        location:$Location
    -> Map[String Type] {
        name bindings.remove_str = existing_option
        if existing_option.is_none then
            actual clone_type name.clone bindings.set_str
            bindings return
        fi
        existing_option.unwrap = existing
        if existing.has_unresolved_type_var actual.has_unresolved_type_var ! && then
            actual clone_type name.clone bindings.set_str
            bindings return
        fi
        if
            existing.is_integer_literal_t actual.is_integer_type_t &&
            existing.is_float_literal_t actual.is_float_type_t && ||
        then
            actual clone_type name.clone bindings.set_str
            bindings return
        fi
        if
            actual.is_integer_literal_t existing.is_integer_type_t &&
            actual.is_float_literal_t existing.is_float_type_t && ||
        then
            existing name.clone bindings.set_str
            bindings return
        fi
        if existing actual.eq ! then
            location f"Type variable `{name}` bound to `{existing.format}` but got `{actual.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        fi
        existing name.clone bindings.set_str
        bindings
    }

    fn bind_stack_parameter
        tc:mut$TypeChecker
        parameter:$Parameter
        stack_index:u64
        effect:$StackEffect
        bindings:Map[String Type]
        location:$Location
    -> Map[String Type] {
        stack_index tc
            .stack
            .values
            .get clone_typed_value = value
        value.type_value clone_type = actual
        if actual.borrow_target Option::Some(target) is then
            target clone_type = actual
        fi
        parameter.typ clone_type = pattern
        if pattern.borrow_target Option::Some(target) is then
            target clone_type = pattern
        fi
        if pattern.type_var_name Option::Some(type_variable) is then
            if type_variable.as_str effect.type_vars.has_str then
                type_variable.as_str bindings.get_str = existing_option
                if existing_option Option::Some(existing) is then
                    if existing.is_borrow then
                        bindings return
                    fi
                fi
                location bindings actual type_variable.as_str tc.bind_concrete_type_variable return
            fi
        fi
        effect.type_vars actual pattern bindings bind_generic_params_standalone = bindings
        actual pattern bindings bind_standalone_constant_parameters
    }

    fn finalize_stack_parameter_literals
        tc:mut$TypeChecker
        parameter:$Parameter
        stack_index:u64
        effect:$StackEffect
        bindings:Map[String Type]
        location:$Location
    -> Map[String Type] {
        stack_index tc
            .stack
            .values
            .get clone_typed_value = value
        if 0 value.literals.length == then
            bindings return
        fi
        bindings parameter.typ.substitute_t resolve_numeric_literal_default = target
        tc.literal_resolutions tc.diagnostics target value.resolve_literals drop
        target clone_type = value.type_value
        value stack_index tc
            .stack
            .values
            .set
        location bindings effect stack_index parameter tc.bind_stack_parameter
    }

    fn inject_trait_method_pointer
        self:mut$TypeChecker
        method:$TraitMethod
        concrete_type:$Type
        concrete_name:$str
        seen_methods:mut$Set[String]
        ops:mut$List[Op]
        insert_pos:u64
        inserted:u64
        location:$Location
        forwarding:bool
    -> u64 u64 {
        if 0 method.default_ops.length != method.name.as_str seen_methods.has_str || then
            inserted insert_pos return
        fi
        method.name.clone seen_methods.add
        if "clone" method.name.as_str == then
            location concrete_type self.ensure_function_clone_method
        fi
        if forwarding then
            f"__trait_{concrete_name}_{method.name}" = hidden_variable
            location.clone hidden_variable OpValue::PushVar Op::new = push_op
            insert_pos push_op ops.insert
            1 += insert_pos
            1 += inserted
            concrete_type method.stack_effect resolve_trait_stack_effect = forwarded_effect
            forwarded_effect stack_effect_to_function_type self.stack_push_type
            inserted insert_pos return
        fi

        self.store Option[Function]::None concrete_type method.name.as_str resolve_method_semantics
        = method_semantics_opt
        if method_semantics_opt Option::Some(method_semantics) is then
            method_semantics.function_name.clone = function_name
            function_name.as_str self.store mark_function_used
            self.diagnostics self.store function_name.as_str ensure_typechecked = checked_function_opt
            if checked_function_opt Option::Some(checked_function) is then
                concrete_type method.stack_effect resolve_trait_stack_effect = callable_effect
                if checked_function.stack_effect needs_hidden_arguments then
                    location method.name.as_str concrete_type callable_effect function_name.as_str self.ensure_layout_adapter
                    = function_name
                fi
                location.clone function_name OpValue::FnPush Op::new = push_op
                insert_pos push_op ops.insert
                1 += insert_pos
                1 += inserted
                callable_effect stack_effect_to_function_type self.stack_push_type
                inserted insert_pos return
            else
                location f"Function `{function_name}` required by trait method `{method.name}` not found"
                ErrorKind::TypeMismatch self.diagnostics.record_error_string
                inserted insert_pos return
            fi
        fi
        location f"Function required by trait method `{method.name}` not found"
        ErrorKind::TypeMismatch self.diagnostics.record_error_string
        inserted insert_pos
    }

    fn layout_constant_op
        self:mut$TypeChecker
        layout_value:Option[u64]
        resolved_type:$Type
        location:$Location
    -> Option[Op] {
        if layout_value Option::Some(value) is then
            if value i64::try_from Option::Some(signed_value) is then
                location.clone signed_value make_integer_op_value Op::new Option::Some return
            fi
            location.clone f"Layout of `{resolved_type.format}` exceeds the supported constant range"
            ErrorKind::TypeMismatch self.diagnostics.record_error_string
            Option[Op]::None return
        fi
        location.clone f"Cannot determine layout of `{resolved_type.format}`"
        ErrorKind::TypeMismatch self.diagnostics.record_error_string
        Option[Op]::None
    }

    fn inject_trait_fn_ptrs
        tc:mut$TypeChecker
        effect:$StackEffect
        ops:mut$List[Op]
        op_index:u64
        location:$Location
        function_opt:mut$Option[Function]
        return_hint:Option[Type]
    -> u64 {
        # Bind type variables from the stack (peek at positions)
        Map[String Type]::new = bindings

        # Collect non-hidden parameters
        List[Parameter]::new = non_hidden
        0 (u64) = param_index
        while param_index effect StackEffect::parameters.length > do
            if
                param_index effect
                    .parameters
                    .get_ref
                    .name
                    .as_str is_hidden_parameter_name !
            then
                param_index effect StackEffect::parameters.get clone_parameter non_hidden.push
            fi
            1 += param_index
        done

        # Peek at stack to bind type variables
        tc
            .stack
            .values
            .length = depth
        0 (u64) = index
        while index non_hidden.length > do
            if index depth > then
                depth 1 - index - = stack_index
                index non_hidden.get = parameter
                location bindings effect stack_index parameter tc.bind_stack_parameter = bindings
            fi
            1 += index
        done
        0 (u64) = index
        while index non_hidden.length > do
            if index depth > then
                depth 1 - index - = stack_index
                index non_hidden.get = parameter
                location bindings effect stack_index parameter tc.finalize_stack_parameter_literals
                = bindings
            fi
            1 += index
        done

        # Method stack-effect diff binding for bounds with type-var args.
        # For a bound like `I: Iterable[T]` where T is still unbound but I is
        # bound from the stack, inspect the concrete type's implementation of
        # each trait method and diff its stack effect against the trait's declared
        # stack effect to bind T. Single pass in declaration order.
        tc.store bindings function_opt effect method_diff_bind_all

        if return_hint Option::Some(hint) is then
            for return_type in effect StackEffect::return_types.iter do
                effect StackEffect::type_vars hint return_type bindings bind_generic_params_standalone = bindings
            done
        fi

        # Inject FN_PUSH ops for each trait bound.
        # Iterate type vars in reverse so the first param in the stack effect (which
        # the parser prepends in forward key order) ends up on the top of the stack,
        # matching the order apply_stack_effect pops parameters in.
        0 (u64) = inserted
        op_index 1 - = insert_pos

        # Push the value of every constant parameter (ADR-0152). These go in
        # before the trait pointers because the parser prepends trait pointers
        # ahead of them, and in reverse key order for the same reason as below.
        effect.const_params.keys = constant_keys
        constant_keys.length = constant_index
        while 0 constant_index != do
            1 -= constant_index
            constant_index constant_keys.get = constant_name
            constant_name effect
                .const_params
                .get
                .unwrap Type::Builtin = constant_type
            constant_name.as_str bindings clone_type_binding = constant_bound_option
            if constant_bound_option.is_none then
                location f"Cannot determine the value of constant parameter `{constant_name}`" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                continue
            fi
            constant_bound_option.unwrap = constant_bound_type
            if function_opt Option::Some(caller) is then
                caller.stack_effect.const_params constant_bound_type rewrite_type_const_params
                = constant_bound_type
            fi
            if constant_bound_type Type::Const(constant_bound) is then
                location function_opt constant_bound make_const_argument_operation = constant_push_operation
                constant_type clone_type Option::Some constant_push_operation Op::set_type_hint
                insert_pos constant_push_operation ops.insert
                1 += insert_pos
                1 += inserted
                constant_type tc.stack_push_type
            else
                location f"Constant parameter `{constant_name}` requires a compile-time constant, got `{constant_bound_type.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi
        done

        effect StackEffect::trait_bounds.keys = type_var_keys
        type_var_keys.length = type_index
        while 0 type_index != do
            1 -= type_index
            type_index type_var_keys.get = type_var
