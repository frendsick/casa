                std::Option::None => op common::make_integer_literal_type tc.stack_push_literal
            end
        elif op.value common::OpValue::PushFloat is then
            op.type_hint.clone = float_type_opt
            float_type_opt match
                std::Option::Some(float_type) => {
                    tc.diagnostics float_type op.resolve_literal drop
                    float_type tc.stack_push_type
                }
                std::Option::None => op common::make_float_literal_type tc.stack_push_literal
            end
        elif op.value common::OpValue::PushArray is then
            op.value.clone_array_literal_items = checked_items
            if 0 checked_items.length == then
                0 common::make_unknown_type common::clone_type common::make_array_type = empty_array_type
                op empty_array_type tc.stack_push_literal
            else
                function_opt checked_items tc.run_type_check_ops
                common::make_unknown_type common::clone_type = elem_type_t
                std::Option[std::List[std::String]]::None = origins
                0 (u64) = items_idx
                while items_idx checked_items.length > do
                    tc.stack_pop_value = item_value
                    item_value.type_value common::clone_type = item_type_t
                    # The literal takes ownership of every element, so a moved
                    # owner must not stay usable through its old binding.
                    item_value.origins origins merge_origins = origins
                    if item_type_t.is_borrow item_value.origins.is_none && then
                        if item_value.place std::Option::Some(place) is then
                            item_type_t.is_exclusive_borrow place.as_str origins add_origin = origins
                        fi
                    fi
                    item_value tc.consume_value
                    tc.store item_type_t elem_type_t semantics::unify_type_t = unified_opt
                    unified_opt match
                        std::Option::Some(unified) => unified = elem_type_t
                        std::Option::None => {
                            op common::Op::location f"Heterogeneous array literal: cannot unify `{elem_type_t.format}` and `{item_type_t.format}`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                        }
                    end
                    1 += items_idx
                done
                checked_items.length elem_type_t common::make_array_type = array_type
                array_type common::clone_type std::Option::Some op common::Op::set_type_hint
                if op.has_numeric_literal then
                    op array_type tc.stack_push_literal
                    tc
                        .stack
                        .values
                        .length 1 - tc
                        .stack
                        .values
                        .get_mut = pushed_value
                    origins = pushed_value.origins
                else
                    origins array_type tc.stack_push_origins
                fi
            fi
            checked_items common::OpValue::PushArray op common::Op::set_value
        elif op.value common::OpValue::ExprGroup is then
            op function_opt tc check_expression_group
        fi
    }
}

