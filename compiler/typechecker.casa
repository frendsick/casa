        if type1_t.is_primitive_compare_type_t then
            if type1_t.is_integer_type_t then type1_t clone_type Option::Some op Op::set_type_hint fi
            TYPE_BOOL_T tc.stack_push_type
            op_index return
        fi
        # User-defined types must satisfy Eq (or Ord) explicitly.
        tc.store function_opt type1_t clone_type Option::Some cmp_value analyze_operation
        = semantics
        trait_name GenericType::new Type::Generic = trait_type
