# ============================================================================

impl TypeChecker {
    pub fn check_io
        tc:mut$TypeChecker
        op:mut$common::Op
        ops:mut$std::List[common::Op]
        op_index:u64
        function_opt:mut$std::Option[common::Function]
    -> u64 {
        "value with trait `Display`".to_str = tc.current_expect_ctx
        tc.stack_peek_type = peek_t
        peek_t.format = typ
        tc.store function_opt peek_t semantics::make_type_borrow_option op.value semantics::analyze_operation = semantics
        if semantics.resolved_operation std::Option::Some(operation) is then
            operation common::clone_op_value = resolved_operation
            tc.stack_pop_drop
            resolved_operation op common::Op::set_value
            peek_t common::clone_type std::Option::Some op common::Op::set_type_hint
            op_index return
        fi
        if common::TYPE_MISSING typ.as_str == common::TYPE_UNKNOWN typ.as_str == || then
            tc.stack_pop_drop
