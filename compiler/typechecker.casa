# ============================================================================
# Check memory operations
# ============================================================================
# Returns true if `bound` names `Word` directly or transitively via supertraits.

fn bound_implies_word bound:TraitBound store:SymbolStore -> bool {
    bound TraitBound::name = bound_name
    if "Word" bound_name == then true return fi
    bound_name store.traits.get = bound_trait_opt
    if bound_trait_opt.is_none then false return fi
    if bound_trait_opt Option::Some(bound_trait) is then
        for super_bound in bound_trait CasaTrait::supertraits.iter do
            if store super_bound bound_implies_word then true return fi
        done
    fi
    false
}
# Validate that `type_name` satisfies the `Word` marker trait at the given op
# location. Concrete single-slot types always satisfy `Word` in current Casa.
# A type variable from the enclosing function satisfies `Word` only when its
# declared bound is `Word` itself or a trait that extends `Word`. An unbounded
# type variable is allowed; the concrete type bound at the call site will
# satisfy `Word` automatically.

impl TypeChecker {
    fn check_word_bounds tc:TypeChecker bounds:List[TraitBound] type_name:str op:Op {
        for bound in bounds.iter do
            if tc.store bound bound_implies_word then return fi
        done
        if 0 bounds.length != then
            op.location f"Type variable `{type_name}` does not satisfy `Word` bound; add `[{type_name}: Word]` (or a trait that extends `Word`) to the function's type parameters" ErrorKind::TypeMismatch tc.diagnostics.record_error
        fi
    }

    fn assert_word_bound tc:TypeChecker op:Op typ:Type function_opt:Option[Function] {
        if typ.is_unknown_placeholder then return fi
        if function_opt Option::Some(function) is then
            if typ Type::TypeVar(type_name) is then
                function.stack_effect = word_stack_effect
                if type_name word_stack_effect.type_vars.has ! then return fi
                type_name word_stack_effect.trait_bounds.get = word_bounds_opt
                if word_bounds_opt Option::Some(word_bounds) is then
                    op type_name word_bounds tc.check_word_bounds
                fi
            fi
        fi
    }
}

impl TypeChecker {
    fn check_memory tc:TypeChecker op:Op function_opt:Option[Function] {
        tc.store function_opt Option[Type]:: None op.value
        analyze_operation = semantics
        if semantics.stack_effect Option::None is then return fi
        semantics.stack_effect.unwrap = effect
        0 (u64) = index
        while index effect.parameters.length > do
            index effect.parameters.get = parameter
            if
            semantics.word_parameter_start index >=
            index semantics.word_parameter_start semantics.word_parameter_count + > &&
            then
                tc.stack_pop_type = word_type
                function_opt word_type op tc.assert_word_bound
            else
                parameter.typ tc.expect_type_t
            fi
            1 += index
        done
        for return_type in effect.return_types.iter do
            return_type tc.stack_push_type
        done
    }
}

impl TypeChecker {
    fn apply_fixed_semantics tc:TypeChecker op:Op function_opt:Option[Function] {
        tc.store function_opt Option[Type]:: None op.value
        analyze_operation = semantics
        if semantics.stack_effect Option::Some(effect) is then
            Option[Type]:: None "" effect tc.apply_stack_effect
        fi
    }
}

# ============================================================================
# Check assignment operations
# ============================================================================
# Unify the stored type of `variable` with the type being assigned to it.
# `scope` ("local" / "global") is only used in the error message.

impl TypeChecker {
    fn unify_variable_assignment
        self:TypeChecker
        op:Op
        variable:Variable
        effective_type:Type
        scope:str
    {
        variable Variable::name = var_name
        variable Variable::typ = pre_type
        pre_type.is_unknown pre_type.is_unknown_placeholder || = pre_unknown
        if pre_unknown effective_type.is_unknown_placeholder ! && then
            effective_type variable Variable::set_typ
        fi
        self.store effective_type variable Variable::typ unify_type_t = unified
        if unified.is_none then
            op Op::location f"Cannot override {scope} variable `{var_name}` of type `{variable Variable::typ.format}` with other type `{effective_type.format}`" ErrorKind::InvalidVariable self.diagnostics.record_error
        elif unified Option::Some(unified_type) is then
            unified_type variable Variable::set_typ
        fi
    }
}

impl TypeChecker {
    fn unify_assignment_type
        self:TypeChecker
        op:Op
        var_name:str
        current_type:Type
        effective_type:Type
        scope:str
    -> Type {
        current_type = stored_type
        stored_type.is_unknown stored_type.is_unknown_placeholder || = pre_unknown
        if pre_unknown effective_type.is_unknown_placeholder ! && then
            effective_type = stored_type
        fi
        self.store effective_type stored_type unify_type_t = unified
        if unified.is_none then
            op Op::location f"Cannot override {scope} variable `{var_name}` of type `{stored_type.format}` with other type `{effective_type.format}`" ErrorKind::InvalidVariable self.diagnostics.record_error
            stored_type
        elif unified Option::Some(unified_type) is then
            unified_type
        else
            stored_type
        fi
    }
}

impl TypeChecker {
    fn local_var_type tc:TypeChecker var_name:str function_opt:Option[Function] -> Option[Type] {
        if var_name tc.scope.lookup Option::Some(binding_type) is then
            binding_type Option::Some return
        fi
        if function_opt Option::Some(function) is then
            var_name function Function::variables variable_list_index = local_index
            if 0 local_index >= then
                local_index (u64) function Function::variables.get Variable::typ Option::Some return
            fi
        fi
        Option[Type]:: None
    }

    fn is_global_assignment self:TypeChecker var_name:str function_opt:Option[Function] -> bool {
        if var_name self.store.variables.has ! then false return fi
        if function_opt Option::Some(function) is then
            var_name function Function::variables variable_list_contains ! return
        fi
        true
    }

    fn record_implicit_binding self:TypeChecker var_name:str op:Op {
        if var_name self.scope.bind ! then
            f"Binding `{var_name}` shadows an existing variable; choose a different name" = message
            op Op::location message ErrorKind::DuplicateName self.diagnostics.record_error
        fi
    }

    fn lower_field_assignment
        tc:TypeChecker
        op:Op
        ops:List[Op]
        op_index:u64
        function_opt:Option[Function]
        parts:List[str]
    {
        op.value OpValue::AssignInc is = increment
        op.value OpValue::AssignDec is = decrement
        0 parts.get = root
        op Op::location = location

        root OpValue::PushVar = root_value
        if function_opt Option::Some(function) is then
            if root function Function::captures variable_list_contains then
                root OpValue::PushCapture = root_value
            fi
        fi
        root_value op Op::set_value
        function_opt op tc.check_push_var
        op_index = insert_index

        1 (u64) = field_index
        if increment decrement || then
            while field_index parts.length > do
                location field_index parts.get OpValue::MethodCall Op::new = getter
                insert_index getter ops.insert
                1 += insert_index
                1 += field_index
            done
            if decrement then
                location OpValue::Swap Op::new = swap_op
                insert_index swap_op ops.insert
                1 += insert_index
                location OpValue::Sub Op::new = sub_op
                insert_index sub_op ops.insert
            else
                location OpValue::Add Op::new = add_op
                insert_index add_op ops.insert
            fi
            1 += insert_index

            location root_value Op::new = root_op
            insert_index root_op ops.insert
            1 += insert_index
            1 (u64) = field_index
        fi

        while field_index parts.length 1 - > do
            location field_index parts.get OpValue::MethodCall Op::new = getter
            insert_index getter ops.insert
            1 += insert_index
            1 += field_index
        done
        parts.length 1 - parts.get = field
        location f"set_{field}" OpValue::MethodCall Op::new = setter
        insert_index setter ops.insert
    }

    fn check_assignment
        tc:TypeChecker
        op:Op
        ops:List[Op]
        op_index:u64
        function_opt:Option[Function]
    {
        op op_str_value "." str::split = target_parts
        if target_parts.length 1 < then
            target_parts function_opt op_index ops op tc.lower_field_assignment
            return
        fi
        if
        op.value OpValue::AssignDec is
        op.value OpValue::AssignInc is ||
        then
            op op_str_value = compound_name
            TYPE_UNKNOWN_T = compound_type
            if function_opt compound_name tc.local_var_type Option::Some(local_type) is then
                local_type = compound_type
            elif compound_name tc.store.variables.get Option::Some(global_var) is then
                global_var.typ = compound_type
            fi
            if compound_type.is_integer_type_t ! then
                op.location f"Compound assignment requires an integer variable, got `{compound_type.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                tc.stack_pop_drop
                return
            fi
            compound_type tc.expect_type_t
            compound_type Option::Some op Op::set_type_hint
            return
        fi
        if op.value OpValue::AssignVar(var_name) is then
            op Op::type_hint.is_some = has_annotation
            TYPE_UNKNOWN_T = stack_type_t
            TYPE_UNKNOWN_T = effective_type_t
            if has_annotation then
                op Op::type_hint = hint_opt
                if hint_opt.is_none then
                    empty_location "Expected option value while unwrapping op Op::type_hint" ErrorKind::Syntax tc.diagnostics.record_error
                    return
                fi
                hint_opt.unwrap = effective_type_t
                op Op::location function_opt effective_type_t tc.validate_type_exists
                effective_type_t = stack_type_t
            else
                tc.stack_peek_type = stack_type_t
                stack_type_t = effective_type_t
            fi
            if has_annotation ! stack_type_t.has_unresolved && then
                op Op::location f"Cannot infer element type of empty array literal assigned to `{var_name}`; add a type annotation (e.g. `= {var_name}:array[i64]`) or an explicit cast (e.g. `[] (array[i64])`)." ErrorKind::TypeMismatch tc.diagnostics.record_error
            fi

            function_opt var_name tc.is_global_assignment = is_global
            is_global var_name tc.scope.assign

            if var_name tc.scope.is_block_binding then
                var_name tc.scope.lookup.unwrap = scoped_type
                "local" effective_type_t scoped_type var_name op tc.unify_assignment_type = unified_scoped
                unified_scoped var_name tc.scope.set_type drop
                effective_type_t tc.expect_type_t
                return
            fi

            # Try local variables first
            if function_opt.is_some then
                function_opt.unwrap = function
                var_name function Function::variables variable_list_index = local_index
                if 0 local_index >= then
                    local_index (u64) function Function::variables.get = local_var
                    local_var Variable::typ = current_local_type
                    if var_name tc.scope.lookup Option::Some(binding_type) is then
                        if binding_type.is_unknown ! binding_type.is_unknown_placeholder ! && then
                            binding_type = current_local_type
                        fi
                    fi
                    "local" effective_type_t current_local_type var_name op tc.unify_assignment_type = unified_local
                    unified_local var_name tc.scope.set_type drop
                    unified_local local_var Variable::set_typ
                    effective_type_t tc.expect_type_t
                    return
                fi
            fi

            # Try global variables
            var_name tc.store.variables.get = global_opt
            if global_opt.is_some then
                global_opt.unwrap = global_var
                "global" effective_type_t global_var op tc.unify_variable_assignment
                effective_type_t tc.expect_type_t
                return
            fi
            effective_type_t tc.expect_type_t
        fi
    }
}

impl TypeChecker {
    fn check_trait_method_call tc:TypeChecker op:Op function_opt:Option[Function] {
        if function_opt.is_none then return fi
        tc.stack_peek_type = receiver
        tc.store function_opt receiver Option::Some op.value analyze_operation
        = semantics
        if semantics.stack_effect Option::Some(effect) is then
            if semantics.method Option::Some(method) is then
                method.method_name receiver.make_method_key = method_key
                Option[Type]:: None method_key effect tc.apply_stack_effect
            fi
        fi
    }
}

# ============================================================================
# Check push variable / capture
# ============================================================================

impl TypeChecker {
    fn check_push_var tc:TypeChecker op:Op function_opt:Option[Function] {
        if op.value OpValue::PushCapture(capture_name) is then
            if function_opt.is_some then
                function_opt.unwrap = function
                capture_name function Function::captures variable_list_index = capture_index
                if 0 capture_index >= then
                    if capture_index (u64) function Function::captures.get Variable::typ.is_unknown ! then
                        capture_index (u64) function Function::captures.get Variable::typ tc.stack_push_type
                        return
                    fi
                fi
            fi
            TYPE_UNKNOWN_T tc.stack_push_type
            return
        fi

        # PUSH_VARIABLE
        if op.value OpValue::PushVar(var_name) is then
            if var_name tc.scope.is_expired then
                op Op::location f"Variable `{var_name}` is not accessible outside its block scope" ErrorKind::UndefinedName tc.diagnostics.record_error
                TYPE_UNKNOWN_T tc.stack_push_type
                return
            fi

            # Check local variables first
            if function_opt var_name tc.local_var_type Option::Some(local_type) is then
                if local_type.is_unknown ! then
                    local_type tc.stack_push_type
                else
                    TYPE_UNKNOWN_T tc.stack_push_type
                fi
                return
            fi

            # Check global variables
            var_name tc.store.variables.get = global_opt
            if global_opt Option::Some(global_var) is then
                if global_var Variable::typ.is_unknown ! then
                    global_var Variable::typ tc.stack_push_type
                else
                    TYPE_UNKNOWN_T tc.stack_push_type
                fi
                return
            fi

            op Op::location f"Variable `{var_name}` is not defined" ErrorKind::UndefinedName tc.diagnostics.record_error
        fi
    }
}

# ============================================================================
# Check if/elif/else/fi blocks
# ============================================================================

impl TypeChecker {
    fn check_if_block tc:TypeChecker op:Op {
        op.value = if_value
        if if_value OpValue::IfStart is then
            IfContext::new = if_ctx
            op Op::location if_ctx IfContext::set_current_branch_location
            if_ctx BranchFrame::BranchIf = if_frame
            if_frame tc.branched_stacks.push
            # Scope the then-branch: is-bindings from the condition and any
            # block-local assignments live here until the next branch or `fi`.
            tc.scope.enter
            true = tc.in_branch_condition
        elif if_value OpValue::IfCondition is then
            false = tc.in_branch_condition
            TYPE_BOOL_T tc.expect_type_t
            if 0 tc.branched_stacks.length == then return fi
            tc.branched_stacks.length 1 - tc.branched_stacks.get = top_frame
            if top_frame BranchFrame::BranchIf(if_ctx) is then
                if if_ctx IfContext::condition_present ! then
                    true if_ctx IfContext::set_condition_present
                    tc.stack if_ctx IfContext::before.restore
                    tc.stack if_ctx IfContext::after.restore
                    "if" if_ctx IfContext::set_current_branch_label
                fi
            fi
        elif
        if_value OpValue::IfElif is
        if_value OpValue::IfElse is ||
        then
            # Close the preceding branch scope and open a fresh one. Each
            # branch gets independent is-bindings and block-local variables.
            tc.scope.exit
            tc.scope.enter
            if 0 tc.branched_stacks.length == then return fi
            tc.branched_stacks.length 1 - tc.branched_stacks.get = top_frame
            if top_frame BranchFrame::BranchIf(if_ctx) is then
                if if_value OpValue::IfElse is then
                    true if_ctx IfContext::set_default_present
                    false = tc.in_branch_condition
                else
                    true = tc.in_branch_condition
                fi
                if_ctx IfContext::before = if_before
                if_ctx IfContext::after = if_after
                if if_before tc.stack.equals if_after if_before.equals && then
                    op Op::location if_ctx IfContext::set_current_branch_location
                    return
                fi
                tc.store if_after tc.stack.unify_types = unified
                if 0 unified.length != if_after if_before.equals ! && then
                    unified if_after.set_types
                    if_before tc.stack.restore
                    op Op::location if_ctx IfContext::set_current_branch_location
                    return
                fi
                if if_after if_before.equals then
                    tc.stack if_after.restore
                    if_before tc.stack.restore
                    op Op::location if_ctx IfContext::set_current_branch_location
                    return
                fi
                op Op::location "Branches have incompatible stack effects" ErrorKind::StackMismatch tc.diagnostics.record_error
            fi
        elif if_value OpValue::IfEnd is then
            # Close the final branch scope.
            tc.scope.exit
            tc.branched_stacks.pop = top_frame
            if top_frame BranchFrame::BranchIf(if_ctx) is then
                if_ctx IfContext::before = if_before
                if_ctx IfContext::after = if_after
                if if_before tc.stack.equals if_after if_before.equals && then
                    return
                fi
                tc.store if_after tc.stack.unify_types = unified
                if 0 unified.length != if_ctx IfContext::default_present && then
                    if_after tc.stack.restore
                    unified tc.stack.set_types
                    return
                fi
                tc.store if_before tc.stack.unify_types = unified_before
                if 0 unified_before.length != if_ctx IfContext::default_present ! && then
                    if_before tc.stack.restore
                    unified_before tc.stack.set_types
                    return
                fi
                op Op::location "Branches have incompatible stack effects" ErrorKind::StackMismatch tc.diagnostics.record_error
            fi
        fi
    }
}

# ============================================================================
# Check while/do/break/continue/done blocks
# ============================================================================

impl TypeChecker {
    fn check_while_block tc:TypeChecker op:Op {
        op.value = while_value
        if while_value OpValue::WhileStart is then
            WhileContext::new = while_ctx
            tc.stack while_ctx WhileContext::before.restore
            op Op::location while_ctx WhileContext::set_current_branch_location
            while_ctx BranchFrame::BranchWhile = while_frame
            while_frame tc.branched_stacks.push
            tc.scope.enter
        elif while_value OpValue::WhileCondition is then
            TYPE_BOOL_T tc.expect_type_t
            if 0 tc.branched_stacks.length == then return fi
            tc.branched_stacks.length 1 - tc.branched_stacks.get = top_frame
            if top_frame BranchFrame::BranchWhile(while_ctx) is then
                true while_ctx WhileContext::set_condition_present
            fi
        elif
        while_value OpValue::WhileBreak is
        while_value OpValue::WhileContinue is ||
        then
            if 0 tc.branched_stacks.length == then return fi
        elif while_value OpValue::WhileEnd is then
            tc.branched_stacks.pop drop
            tc.scope.exit
        fi
    }
}

# ============================================================================
# Trait support: bind_generic_params_standalone, type_satisfies_trait, inject_trait_fn_ptrs
# ============================================================================

fn bind_generic_params_standalone
    bindings:Map[str Type]
    expected_type:Type
    actual_type:Type
    type_vars:Set[str]
-> Map[str Type] {
    if expected_type.as_generic.is_none then bindings return fi
    expected_type.as_generic.unwrap = expected_g
    if actual_type.as_generic.is_none then bindings return fi
    actual_type.as_generic.unwrap = actual_g
    if expected_g.base actual_g.base != then bindings return fi
    0 (u64) = index
    while
    index expected_g.params.length >
    index actual_g.params.length > &&
    do
        if index expected_g.params.get.type_var_name Option::Some(tv_name) is then
            if
            tv_name type_vars.has
            tv_name bindings.get.is_none &&
            then
                index actual_g.params.get tv_name bindings.set = bindings
            fi
        fi
        1 += index
    done
    bindings
}

fn matches_trait_bound
    receiver:Type
    trait_type:Type
    function_opt:Option[Function]
    store:SymbolStore
-> bool {
    if function_opt Option::Some(function) is then
        if receiver Type::TypeVar(type_var_name) is then
            type_var_name function.stack_effect.trait_bounds.get = bounds_opt
            if bounds_opt Option::Some(bounds) is then
                for bound in bounds.iter do
                    bound trait_bound_to_type = bound_type
                    if store trait_type bound_type trait_type_implies then true return fi
                done
            fi
        fi
    fi
    false
}

fn bind_stack_effect_pattern pattern:StackEffect actual:StackEffect -> Option[Map[str Type]] {
    if pattern.parameters.length actual.parameters.length != then
        Option[Map[str Type]]:: None return
    fi
    if pattern.return_types.length actual.return_types.length != then
        Option[Map[str Type]]:: None return
    fi
    Map[str Type]:: new = bindings
    for pair in actual.parameters.iter pattern.parameters.iter.zip do
        if bindings pair.second.typ pair.first.typ bind_trait_impl_type ! then
            Option[Map[str Type]]:: None return
        fi
    done
    for pair in actual.return_types.iter pattern.return_types.iter.zip do
        if bindings pair.second pair.first bind_trait_impl_type ! then
            Option[Map[str Type]]:: None return
        fi
    done
    bindings Option::Some
}

fn stack_effect_type_variables effect:StackEffect -> Set[str] {
    Set[str]:: new = type_variables
    for parameter in effect.parameters.iter do
        type_variables parameter.typ collect_stack_effect_type_vars = type_variables
    done
    for return_type in effect.return_types.iter do
        type_variables return_type collect_stack_effect_type_vars = type_variables
    done
    type_variables
}

fn trait_method_effects_match
    expected:StackEffect
    actual:StackEffect
    generic_declaration:bool
-> bool {
    List[Parameter]:: new = actual_parameters
    for parameter in actual.parameters.iter do
        if parameter.name "__trait_" str::starts_with ! then
            parameter actual_parameters.push
        fi
    done
    actual.return_types actual_parameters StackEffect::new = visible_actual
    visible_actual expected bind_stack_effect_pattern = expected_match
    if generic_declaration then
        if expected_match.is_none then false return fi
        expected stack_effect_type_variables = expected_type_variables
        for type_variable in expected_type_variables.to_list.iter do
            if type_variable expected_match.unwrap.get Option::Some(bound) is then
                if bound Type::TypeVar(_) is ! then false return fi
            fi
        done
        true return
    fi
    if expected_match.is_some then true return fi
    expected visible_actual bind_stack_effect_pattern.is_some
}

fn type_has_trait_shape
    receiver:Type
    trait_type:Type
    store:SymbolStore
    diagnostics:Diagnostics
    generic_declaration:bool
-> bool {
    trait_type.match_base = trait_lookup_name
    trait_lookup_name store.traits.get = trait_opt
    if trait_opt.is_none then false return fi
    trait_opt.unwrap = trait_def
    # Build substitution map from the trait's structural type arguments.
    Map[str Type]:: new = trait_subs
    if trait_type.type_params Option::Some(trait_args) is then
        trait_def CasaTrait::type_params = tparams
        if trait_args.length tparams.length == then
            for sub_pair in trait_args.iter tparams.iter.zip do
                sub_pair.second sub_pair.first trait_subs.set = trait_subs
            done
        fi
    fi
    for method in trait_def store collect_trait_methods.iter do
        Option[Function]:: None = fn_opt
        if store receiver method.name find_semantic_method_function Option::Some(fn_name) is then
            fn_name store.functions.get = fn_opt
        fi
        if fn_opt.is_none then
            # Default methods (with a body) don't require a concrete implementation
            if 0 method TraitMethod::default_ops.length != then
                continue
            fi
            false return
        fi
        fn_opt.unwrap = function
        diagnostics store function ensure_typechecked
        if "None -> None" function Function::stack_effect stack_effect_to_str == then false return fi
        trait_subs receiver method TraitMethod::stack_effect resolve_trait_stack_effect apply_type_subs_to_stack_effect = resolved
        if generic_declaration function.stack_effect resolved trait_method_effects_match ! then false return fi
    done
    true
}

fn type_satisfies_trait
    receiver:Type
    trait_type:Type
    function_opt:Option[Function]
    store:SymbolStore
    diagnostics:Diagnostics
-> bool {
    if store function_opt trait_type receiver matches_trait_bound then true return fi
    if store trait_type receiver type_has_satisfying_trait_impl ! then false return fi
    false diagnostics store trait_type receiver type_has_trait_shape
}

fn find_tparam_index tparams:List[str] name:str -> Option[u64] {
    Option[u64]:: None = found_index
    0 (u64) = scan_index
    while scan_index tparams.length > do
        if scan_index tparams.get name == then
            scan_index Option::Some = found_index
        fi
        1 += scan_index
    done
    found_index
}

fn try_bind_caller_tvar
    bindings:Map[str Type]
    effect:StackEffect
    caller_ref:Type
    concrete:Type
-> Map[str Type] {
    if caller_ref.type_var_name.is_none then bindings return fi
    caller_ref.type_var_name.unwrap = caller_type_var
    if caller_type_var effect StackEffect::type_vars.has ! then bindings return fi
    if caller_type_var bindings.get.is_some then bindings return fi
    concrete caller_type_var bindings.set return
}
# Given a single (trait-side expected type, concrete-side actual type) pair
# from a method stack-effect diff, if the expected type references a trait
# type parameter that maps (via the current bound's type args) to an unbound
# caller type variable, bind it to the actual type. Handles both direct
# references (`T`) and one-level nested generics (`Option[T]` vs `Option[i64]`).

fn bind_from_type_slot
    bindings:Map[str Type]
    effect:StackEffect
    tparams:List[str]
    bargs:List[Type]
    expected:Type
    actual:Type
-> Map[str Type] {
    if expected.type_var_name Option::Some(direct_tv_name) is then
        direct_tv_name tparams find_tparam_index = direct_tp_idx
        if direct_tp_idx Option::Some(direct_index) is then
            direct_index bargs.get = direct_caller_ref
            actual direct_caller_ref effect bindings try_bind_caller_tvar return
        fi
        bindings return
    fi
    if expected.as_generic.is_none then bindings return fi
    expected.as_generic.unwrap = expected_g
    if actual.as_generic.is_none then bindings return fi
    actual.as_generic.unwrap = actual_g
    if expected_g.base actual_g.base != then bindings return fi
    0 (u64) = slot_index
    while
    slot_index expected_g.params.length >
    slot_index actual_g.params.length > &&
    do
        if slot_index expected_g.params.get.type_var_name Option::Some(nested_name) is then
            nested_name tparams find_tparam_index = nested_tp_idx
            if nested_tp_idx Option::Some(nested_index) is then
                nested_index bargs.get = nested_caller_ref
                slot_index actual_g.params.get nested_caller_ref effect bindings try_bind_caller_tvar = bindings
            fi
        fi
        1 += slot_index
    done
    bindings
}

fn diff_method_stack_effect
    bindings:Map[str Type]
    effect:StackEffect
    tparams:List[str]
    bargs:List[Type]
    trait_resolved:StackEffect
    impl_stack_effect:StackEffect
-> Map[str Type] {
    0 (u64) = param_index
    while
    param_index trait_resolved StackEffect::parameters.length >
    param_index impl_stack_effect StackEffect::parameters.length > &&
    do
        param_index trait_resolved StackEffect::parameters.get Parameter::typ = expected_param
        param_index impl_stack_effect StackEffect::parameters.get Parameter::typ = actual_param
        actual_param expected_param bargs tparams effect bindings bind_from_type_slot = bindings
        1 += param_index
    done
    0 (u64) = return_index
    while
    return_index trait_resolved StackEffect::return_types.length >
    return_index impl_stack_effect StackEffect::return_types.length > &&
    do
        return_index trait_resolved StackEffect::return_types.get = expected_return
        return_index impl_stack_effect StackEffect::return_types.get = actual_return
        actual_return expected_return bargs tparams effect bindings bind_from_type_slot = bindings
        1 += return_index
    done
    bindings
}

fn method_diff_bind_for_bound
    bindings:Map[str Type]
    effect:StackEffect
    bound:TraitBound
    concrete:Type
    store:SymbolStore
-> Map[str Type] {
    bound TraitBound::name store.traits.get = trait_opt
    if trait_opt.is_none then bindings return fi
    trait_opt.unwrap = trait_def
    trait_def CasaTrait::type_params = trait_params
    bound TraitBound::type_args = bound_args
    if bound_args.length trait_params.length != then bindings return fi
    for trait_method in trait_def CasaTrait::methods.iter do
        store concrete trait_method.name find_semantic_method_function = function_opt
        if function_opt Option::Some(function_name) is then
            if function_name store.functions.get Option::Some(concrete_fn) is then
                concrete trait_method TraitMethod::stack_effect resolve_trait_stack_effect
                = trait_resolved
                concrete_fn Function::stack_effect trait_resolved bound_args trait_params effect
                bindings diff_method_stack_effect = bindings
            fi
        fi
    done
    bindings
}

fn method_diff_bind_all
    effect:StackEffect
    function_opt:Option[Function]
    bindings:Map[str Type]
    store:SymbolStore
-> Map[str Type] {
    effect StackEffect::trait_bounds.keys = bound_keys
    for bound_type_var in bound_keys.iter do
        if bound_type_var effect StackEffect::trait_bounds.get Option::Some(bound_constraints) is then
            bound_type_var bindings.get = concrete_opt
            if concrete_opt Option::Some(concrete) is then
                for bound_constraint in bound_constraints.iter do
                    store concrete bound_constraint effect bindings method_diff_bind_for_bound = bindings
                done
            fi
        fi
    done
    bindings
}

fn bounds_imply_trait bounds:List[TraitBound] target:Type store:SymbolStore -> bool {
    for bound in bounds.iter do
        bound trait_bound_to_type = direct
        if store target direct trait_type_implies then true return fi
    done
    false
}

impl TypeChecker {
    fn bind_concrete_type_variable
        tc:TypeChecker
        name:str
        actual:Type
        bindings:Map[str Type]
        location:Location
    -> Map[str Type] {
        name bindings.get = existing_option
        if existing_option.is_none then
            actual name bindings.set return
        fi
        existing_option.unwrap = existing
        if existing.has_unresolved_type_var actual.has_unresolved_type_var ! && then
            actual name bindings.set return
        fi
        if existing actual.eq ! then
            location f"Type variable `{name}` bound to `{existing.format}` but got `{actual.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
        fi
        bindings
    }

    fn bind_stack_parameter
        tc:TypeChecker
        parameter:Parameter
        stack_index:u64
        effect:StackEffect
        bindings:Map[str Type]
        location:Location
    -> Map[str Type] {
        stack_index tc.stack.values.get = value
        value.type_value = actual
        if parameter.typ.type_var_name Option::Some(type_variable) is then
            if type_variable effect.type_vars.has then
                type_variable bindings.get = existing_option
                if 0 value.literals.length != then
                    actual resolve_numeric_literal_default = fallback
                    existing_option fallback value tc.resolve_type_var_literals = actual
                    List[Op]:: new value.origin actual TypedValue stack_index tc.stack.values.set
                fi
                location bindings actual type_variable tc.bind_concrete_type_variable return
            fi
        fi
        effect.type_vars actual parameter.typ bindings bind_generic_params_standalone
    }

    fn inject_trait_fn_ptrs
        tc:TypeChecker
        effect:StackEffect
        ops:List[Op]
        op_index:u64
        location:Location
        function_opt:Option[Function]
        return_hint:Option[Type]
    -> u64 {
        # Bind type variables from the stack (peek at positions)
        Map[str Type]:: new = bindings

        # Collect non-hidden parameters
        List[Parameter]:: new = non_hidden
        for param in effect StackEffect::parameters.iter do
            if param Parameter::name "__trait_" str::starts_with ! then
                param non_hidden.push
            fi
        done

        # Peek at stack to bind type variables
        tc.stack.values.length = depth
        0 (u64) = index
        while index non_hidden.length > do
            if index depth > then
                depth 1 - index - = stack_index
                index non_hidden.get = parameter
                location bindings effect stack_index parameter tc.bind_stack_parameter = bindings
            fi
            1 += index
        done

        # Method stack-effect diff binding for bounds with type-var args.
        # For a bound like `I: Iterable[T]` where T is still unbound but I is
        # bound from the stack, inspect the concrete type's implementation of
        # each trait method and diff its stack effect against the trait's declared
        # stack effect to bind T. Single pass in declaration order.
        tc.store bindings function_opt effect method_diff_bind_all = bindings

        if return_hint Option::Some(hint) is then
            for return_type in effect StackEffect::return_types.iter do
                effect StackEffect::type_vars hint return_type bindings bind_generic_params_standalone = bindings
            done
        fi

        # Inject FN_PUSH ops for each trait bound.
        # Iterate type vars in reverse so the first param in the stack effect (which
        # the parser prepends in forward key order) ends up on the top of the stack,
        # matching the order apply_stack_effect pops parameters in.
        0 (u64) = inserted
        op_index 1 - = insert_pos
        effect StackEffect::trait_bounds.keys = type_var_keys
        type_var_keys.length = type_index
        while 0 type_index != do
            1 -= type_index
            type_index type_var_keys.get = type_var
            type_var effect StackEffect::trait_bounds.get = trait_bounds_opt
            if trait_bounds_opt.is_none then
                empty_location "Expected option value while unwrapping type_var effect StackEffect::trait_bounds.get" ErrorKind::Syntax tc.diagnostics.record_error
                continue
            fi
            trait_bounds_opt.unwrap = trait_bounds
            type_var bindings.get = concrete_opt
            if concrete_opt.is_none then
                location f"Cannot determine concrete type for type variable `{type_var}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                continue
            fi
            concrete_opt.unwrap = concrete_t
            concrete_t.format = concrete
            Set[str]:: new = seen_methods
            trait_bounds.length = bound_index
            while 0 bound_index != do
                1 -= bound_index
                bound_index trait_bounds.get = trait_bound
                trait_bound trait_bound_to_type = trait_bound_type
                bindings trait_bound_type.substitute_t = resolved_trait_type
                resolved_trait_type.format = trait_name
                trait_bound.name tc.store.traits.get = trait_def_opt
                if trait_def_opt.is_none then continue fi
                trait_def_opt.unwrap = trait_def

                false = is_forwarding
                if function_opt Option::Some(function) is then
                    concrete function.stack_effect.trait_bounds.get = caller_bounds_opt
                    if caller_bounds_opt Option::Some(caller_bounds) is then
                        if tc.store resolved_trait_type caller_bounds bounds_imply_trait then
                            true = is_forwarding
                        fi
                    fi
                fi

                if is_forwarding ! then
                    if tc.diagnostics tc.store function_opt resolved_trait_type concrete_t type_satisfies_trait ! then
                        location f"Type `{concrete}` does not satisfy trait `{trait_name}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                    fi
                fi

                trait_def tc.store collect_trait_methods = expanded_methods
                expanded_methods.length = method_index
                while 0 method_index != do
                    1 -= method_index
                    method_index expanded_methods.get = method
                    if
                    0 method.default_ops.length ==
                    method.name seen_methods.has ! &&
                    then
                        method.name seen_methods.add = seen_methods
                        if is_forwarding then
                            f"__trait_{concrete}_{method TraitMethod::name}" = hidden_var
                            location hidden_var OpValue::PushVar Op::new = push_op
                            insert_pos push_op ops.insert
                            1 += insert_pos
                            1 += inserted
                            concrete_t method TraitMethod::stack_effect resolve_trait_stack_effect = forward_stack_effect
                            forward_stack_effect stack_effect_to_function_type tc.stack_push_type
                        else
                            tc.store concrete_t method.name find_semantic_method_function
                            = fn_name_opt
                            Option[Function]:: None = global_fn_opt
                            "" = fn_name
                            if fn_name_opt Option::Some(found_name) is then
                                found_name = fn_name
                                fn_name tc.store.functions.get = global_fn_opt
                            fi
                            if global_fn_opt.is_some then
                                global_fn_opt.unwrap = global_fn
                                if global_fn Function::is_used ! then
                                    true global_fn Function::set_is_used
                                    tc.diagnostics global_fn global_fn Function::ops tc.store resolve_identifiers global_fn Function::set_ops
                                fi
                                tc.diagnostics tc.store global_fn ensure_typechecked
                                location fn_name OpValue::FnPush Op::new = push_op
                                insert_pos push_op ops.insert
                                1 += insert_pos
                                1 += inserted
                                global_fn Function::stack_effect stack_effect_to_function_type tc.stack_push_type
                            else
                                location f"Function `{fn_name}` required by trait `{trait_name}` not found" ErrorKind::TypeMismatch tc.diagnostics.record_error
                            fi
                        fi
                    fi
                done
            done
        done
        inserted
    }
}

# ============================================================================
# Check function-related operations
# ============================================================================

impl TypeChecker {
    fn sync_capture_types tc:TypeChecker lambda:Function function_opt:Option[Function] {
        if function_opt.is_none then return fi
        for capture in lambda Function::captures.iter do
            capture Variable::name = capture_name
            if function_opt capture_name tc.local_var_type Option::Some(capture_type) is then
                if capture_type.is_unknown ! then
                    capture_type capture Variable::set_typ
                fi
            fi
        done
    }

    fn check_function_ops
        tc:TypeChecker
        op:Op
        ops:List[Op]
        op_index:u64
        function_opt:Option[Function]
    -> u64 {
        op.value = fn_value
        if fn_value OpValue::FnCall(fn_name) is then
            fn_name tc.store.functions.get = fn_opt
            if fn_opt.is_some then
                fn_opt.unwrap = function
                tc.diagnostics tc.store function ensure_typechecked
                tc.store function_opt Option[Type]:: None fn_value
                analyze_operation = semantics
                if semantics.stack_effect Option::None is then op_index return fi
                semantics.stack_effect.unwrap = effect
                if 0 effect StackEffect::trait_bounds.keys.length != then
                    op.type_hint function_opt op Op::location op_index ops effect tc.inject_trait_fn_ptrs = injected
                    injected += op_index
                fi
                op.type_hint fn_name effect tc.apply_stack_effect
                if op.type_hint Option::Some(explicit_type) is then
                    false = valid_explicit_type
                    if 1 effect.return_types.length == then
                        0 effect.return_types.get = declared_return
                        if declared_return Type::Generic(declared_generic) is then
                            if explicit_type Type::Generic(explicit_generic) is then
                                declared_generic.base explicit_generic.base ==
                                0 declared_generic.params.length ==
                                declared_generic.params.length explicit_generic.params.length == || &&
                                = valid_explicit_type
                            fi
                        fi
                    fi
                    if valid_explicit_type then
                        op.location function_opt explicit_type tc.validate_type_exists
                        tc.stack_pop_drop
                        explicit_type tc.stack_push_type
                    else
                        op.location f"Explicit type `{explicit_type.format}` does not match `{fn_name}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                    fi
                fi
            fi
        elif fn_value OpValue::FnExec is then
            tc.stack_peek_type = fn_ptr_type
            if fn_ptr_type.is_unknown_placeholder then
                TYPE_UNKNOWN_T tc.expect_type_t
            else
                fn_ptr_type tc.expect_type_t
                tc.store function_opt fn_ptr_type Option::Some fn_value
                analyze_operation = semantics
                if semantics.stack_effect Option::Some(effect) is then
                    if 0 effect.parameters.length != 0 effect.return_types.length != || then
                        Option[Type]:: None "exec" effect tc.apply_stack_effect
                    fi
                fi
            fi
        elif fn_value OpValue::FnPush(push_name) is then
            push_name tc.store.functions.get = push_fn_opt
            if push_fn_opt.is_some then
                push_fn_opt.unwrap = push_fn
                function_opt push_fn tc.sync_capture_types
                tc.diagnostics tc.store push_fn ensure_typechecked
                tc.store function_opt Option[Type]:: None fn_value
                analyze_operation = semantics
                if semantics.stack_effect Option::Some(effect) is then
                    Option[Type]:: None "" effect tc.apply_stack_effect
                fi
            else
                List[Type]:: new List[Type]:: new FunctionType Type::Function tc.stack_push_type
            fi
        elif fn_value OpValue::FnReturn is then
            if tc.has_return_types ! then
                true = tc.has_return_types
                tc.stack tc.return_types.restore
            fi
            if 0 tc.branched_stacks.length != then
                tc.branched_stacks.length 1 - tc.branched_stacks.get = top_frame
                if top_frame BranchFrame::BranchIf(if_ctx) is then
                    if_ctx IfContext::before tc.stack.restore
                elif top_frame BranchFrame::BranchWhile(while_ctx) is then
                    while_ctx WhileContext::before tc.stack.restore
                elif top_frame BranchFrame::BranchMatch(match_ctx) is then
                    match_ctx MatchContext::before tc.stack.restore
                fi
            fi
        fi
        op_index
    }
}

# ============================================================================
# Check literal push operations
# ============================================================================

impl TypeChecker {
    fn check_literals tc:TypeChecker op:Op function_opt:Option[Function] {
        op.value = literal_value
        if literal_value OpValue::PushInt is then
            if op.type_hint Option::Some(integer_type) is then
                tc.diagnostics integer_type op.resolve_literal drop
                integer_type tc.stack_push_type
            else
                op TYPE_INTEGER_LITERAL_T tc.stack_push_literal
            fi
        elif literal_value OpValue::PushFloat is then
            if op.type_hint Option::Some(float_type) is then
                tc.diagnostics float_type op.resolve_literal drop
                float_type tc.stack_push_type
            else
                op TYPE_FLOAT_LITERAL_T tc.stack_push_literal
            fi
        elif literal_value OpValue::PushArray(items) is then
            if 0 items.length == then
                List[Type]:: new = empty_params
                TYPE_UNKNOWN_T empty_params.push
                empty_params "array" GenericType Type::Generic tc.stack_push_type
            else
                function_opt items tc.run_type_check_ops
                TYPE_UNKNOWN_T = elem_type_t
                0 (u64) = items_idx
                while items_idx items.length > do
                    tc.stack_pop_value = item_value
                    item_value.type_value = item_type_t
                    tc.store item_type_t elem_type_t unify_type_t = unified_opt
                    if unified_opt.is_none then
                        op Op::location f"Heterogeneous array literal: cannot unify `{elem_type_t.format}` and `{item_type_t.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                    else
                        unified_opt.unwrap = elem_type_t
                    fi
                    1 += items_idx
                done
                List[Type]:: new = item_params
                elem_type_t item_params.push
                item_params "array" GenericType Type::Generic = array_type
                if op.has_numeric_literal then
                    op array_type tc.stack_push_literal
                else
                    array_type tc.stack_push_type
                fi
            fi
        elif literal_value OpValue::ExprGroup(group_ops) is then
            function_opt group_ops tc.run_type_check_ops
        fi
    }
}

# ============================================================================
# Check print dispatch
# ============================================================================

impl TypeChecker {
    fn check_io
        tc:TypeChecker
        op:Op
        ops:List[Op]
        op_index:u64
        function_opt:Option[Function]
    -> u64 {
        "value with trait `Display`" = tc.current_expect_ctx
        tc.stack_peek_type = peek_t
        peek_t.format = typ
        tc.store function_opt peek_t Option::Some op.value analyze_operation = semantics
        if semantics.resolved_operation Option::Some(resolved_operation) is then
            tc.stack_pop_drop
            resolved_operation op Op::set_value
            peek_t Option::Some op Op::set_type_hint
            op_index return
        fi
        if TYPE_MISSING typ == TYPE_UNKNOWN typ == || then
            tc.stack_pop_drop
            op_index return
        fi
        "Display" GenericType::new Type::Generic = display_type
        if tc.diagnostics tc.store function_opt display_type peek_t type_satisfies_trait ! then
            op Op::location f"Type `{typ}` cannot be printed: does not satisfy trait `Display`" ErrorKind::MissingTraitMethod tc.diagnostics.record_error
            tc.stack_pop_drop
            op_index return
        fi
        if semantics.method Option::Some(method) is then
            method.method_name OpValue::MethodCall op Op::set_value
        else
            "to_str" OpValue::MethodCall op Op::set_value
        fi
        function_opt op_index ops op tc.check_method_call = new_index
        op Op::location OpValue::Print Op::new = print_op
        new_index print_op ops.insert
        new_index
    }
}

