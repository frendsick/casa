# ============================================================================
# Check literal push operations
# ============================================================================

impl OpValue {
    fn clone_array_literal_items self:$OpValue -> List[Op] {
        if self OpValue::PushArray(items) is then
            items clone_ops return
        fi
        List[Op]::new
    }
}

fn check_expression_group tc:mut$TypeChecker function_opt:mut$Option[Function] op:mut$Op {
    if op.value OpValue::ExprGroup(group_ops) is then
        group_ops clone_ops = owned_group_ops
        function_opt owned_group_ops tc.run_type_check_ops
        owned_group_ops OpValue::ExprGroup op Op::set_value
    fi
}

impl TypeChecker {
    fn check_literals tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        if op.value OpValue::PushInt is then
            op.type_hint.clone = integer_type_opt
            integer_type_opt match
                Option::Some(integer_type) => {
                    tc.diagnostics integer_type op.resolve_literal drop
                    integer_type tc.stack_push_type
                }
                Option::None => op TYPE_INTEGER_LITERAL_T tc.stack_push_literal
            end
        elif op.value OpValue::PushFloat is then
            op.type_hint.clone = float_type_opt
            float_type_opt match
                Option::Some(float_type) => {
                    tc.diagnostics float_type op.resolve_literal drop
                    float_type tc.stack_push_type
                }
                Option::None => op TYPE_FLOAT_LITERAL_T tc.stack_push_literal
            end
        elif op.value OpValue::PushArray is then
            op.value.clone_array_literal_items = checked_items
            if 0 checked_items.length == then
                0 TYPE_UNKNOWN_T clone_type make_array_type = empty_array_type
                op empty_array_type tc.stack_push_literal
            else
                function_opt checked_items tc.run_type_check_ops
                TYPE_UNKNOWN_T clone_type = elem_type_t
                Option[List[String]]::None = origins
                0 (u64) = items_idx
                while items_idx checked_items.length > do
                    tc.stack_pop_value = item_value
                    item_value.type_value clone_type = item_type_t
                    # The literal takes ownership of every element, so a moved
                    # owner must not stay usable through its old binding.
                    item_value.origins origins merge_origins = origins
                    if item_type_t.is_borrow item_value.origins.is_none && then
                        if item_value.place Option::Some(place) is then
                            item_type_t.is_exclusive_borrow place.as_str origins add_origin = origins
                        fi
                    fi
                    item_value tc.consume_value
                    tc.store item_type_t elem_type_t unify_type_t = unified_opt
                    unified_opt match
                        Option::Some(unified) => unified = elem_type_t
                        Option::None => {
                            op Op::location f"Heterogeneous array literal: cannot unify `{elem_type_t.format}` and `{item_type_t.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                        }
                    end
                    1 += items_idx
                done
                checked_items.length elem_type_t make_array_type = array_type
                array_type clone_type Option::Some op Op::set_type_hint
                if op.has_numeric_literal then
                    op array_type tc.stack_push_literal
                    tc
                        .stack
                        .values
                        .length 1 - tc
                        .stack
                        .values
                        .get_mut = pushed_value
                    origins = pushed_value.origins
                else
                    origins array_type tc.stack_push_origins
                fi
            fi
            checked_items OpValue::PushArray op Op::set_value
        elif op.value OpValue::ExprGroup is then
            op function_opt tc check_expression_group
        fi
    }
}

# ============================================================================
# Check print dispatch
# ============================================================================

impl TypeChecker {
    fn check_io
        tc:mut$TypeChecker
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    -> u64 {
        "value with trait `Display`".to_str = tc.current_expect_ctx
        tc.stack_peek_type = peek_t
        peek_t.format = typ
        tc.store function_opt peek_t make_type_borrow_option op.value analyze_operation = semantics
        if semantics.resolved_operation Option::Some(operation) is then
            operation clone_op_value = resolved_operation
            tc.stack_pop_drop
            resolved_operation op Op::set_value
            peek_t clone_type Option::Some op Op::set_type_hint
            op_index return
        fi
        if TYPE_MISSING typ.as_str == TYPE_UNKNOWN typ.as_str == || then
            tc.stack_pop_drop
            op_index return
        fi
        "Display".to_str GenericType::new Type::Generic = display_type
        if tc.diagnostics tc.store function_opt display_type peek_t type_satisfies_trait ! then
            op Op::location f"Type `{typ}` cannot be printed: does not satisfy trait `Display`" ErrorKind::MissingTraitMethod tc.diagnostics.record_error_string
            tc.stack_pop_drop
            op_index return
        fi
        if semantics.method Option::Some(method) is then
            method.method_name.clone OpValue::MethodCall op Op::set_value
        else
            "to_str".to_str OpValue::MethodCall op Op::set_value
        fi
        function_opt op_index ops op tc.check_method_call = new_index
        op Op::location OpValue::Print Op::new = print_op
        new_index print_op ops.insert
        new_index
    }
}

