                function_opt op.type_hint fn_name effect tc.apply_stack_effect
                if op.type_hint Option::Some(explicit_type) is then
                    false = valid_explicit_type
                    if 1 effect.return_types.length == then
                        0 effect.return_types.get = declared_return
                        if declared_return Type::Generic(declared_generic) is then
                            if explicit_type Type::Generic(explicit_generic) is then
                                declared_generic.base explicit_generic.base ==
                                0 declared_generic.params.length ==
                                declared_generic.params.length explicit_generic.params.length == || &&
                                = valid_explicit_type
                            fi
                        fi
                    fi
                    if valid_explicit_type then
                        op.location function_opt explicit_type tc.validate_type_exists
                        tc.stack_pop_value = explicit_value
                        explicit_value.origins clone_origins = explicit_origins
                        explicit_value tc.consume_value
                        if tc.store explicit_type type_has_borrow then
