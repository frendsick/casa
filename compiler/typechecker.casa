# ============================================================================
# Check enum variant push
# ============================================================================

impl TypeChecker {
    fn check_enum_variant tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        if op.value OpValue::PushEnumVariant(variant) is then
            variant EnumVariant::enum_name = enum_name
            enum_name tc.store.enums.get = enum_opt
            if enum_opt.is_none then
                enum_name GenericType::new Type::Generic tc.stack_push_type
                return
            fi
            enum_opt.unwrap = casa_enum
            variant EnumVariant::variant_name casa_enum CasaEnum::variant_types.get = inner_opt
            List[Type]::new = inner_types
            if inner_opt Option::Some(found_inner_types) is then
                found_inner_types = inner_types
            fi
            if 0 inner_types.length == then
                if op.type_hint Option::Some(explicit_type) is then
                    op.location function_opt explicit_type tc.validate_type_exists
                    explicit_type tc.stack_push_type
                elif 0 casa_enum CasaEnum::type_vars.length != then
                    casa_enum CasaEnum::type_vars enum_name build_parameterized_type tc.stack_push_type
                else
                    enum_name GenericType::new Type::Generic tc.stack_push_type
                fi
                return
            fi

            # Data-carrying variant: pop inner values, resolve generics
            Option[List[str]]::None = origins
            if 0 casa_enum CasaEnum::type_vars.length != then
                # Generic enum variant (e.g. Option::Some with T)
                # Bind type vars from inner values
                Map[str Type]::new = bindings
                Set[str]::new = type_vars
                for type_var in casa_enum CasaEnum::type_vars.iter do
                    type_var.clone type_vars.add = type_vars
                done
                for expected in inner_types.iter do
                    if expected.type_var_name Option::Some(tv_name) is tv_name type_vars.has && then
                        tc.stack_pop_value = actual_value
                        actual_value.origins origins merge_origins = origins
                        actual_value.type_value = actual_t
                        if 0 actual_value.literals.length != then
                            actual_t resolve_numeric_literal_default = actual_t
                            tc.diagnostics actual_t actual_value.resolve_literals drop
                        fi
                        actual_value tc.consume_value
                        actual_t tv_name bindings tc.bind_type_var = bindings
                    else
                        if 0 tc.stack.values.length != then
                            tc.stack.values.length 1 - tc.stack.values.get.origins origins merge_origins = origins
                        fi
                        expected tc.expect_type_t
                    fi
                done
                # Build resolved type name
                bindings casa_enum CasaEnum::type_vars enum_name build_resolved_type = result_type
                origins result_type tc.stack_push_origins
            else
                # Non-generic variant: pop inner values directly
                for inner_type in inner_types.iter do
                    if 0 tc.stack.values.length != then
                        tc.stack.values.length 1 - tc.stack.values.get.origins origins merge_origins = origins
                    fi
                    inner_type tc.expect_type_t
                done
                enum_name GenericType::new Type::Generic = result_type
                origins result_type tc.stack_push_origins
            fi
        fi
    }
}

# ============================================================================
# Check is keyword
# ============================================================================

impl TypeChecker {
    fn check_is tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        tc.stack_pop_value = subject
        subject tc.release_value
        subject.type_value = typ
        typ clone_type = subject_type
        if typ.borrow_target Option::Some(target) is then target = subject_type fi
        subject_type.match_base = base
        if base tc.store.enums.get.is_none then
            f"`is` requires an enum type, got `{subject_type.format}`" tc.raise_type_mismatch
            TYPE_BOOL_T tc.stack_push_type
            return
        fi
        base tc.store.enums.get.unwrap = casa_enum
        if op.value OpValue::IsCheck(variant) is then
            # Validate the variant belongs to the correct enum
            if "" variant EnumVariant::enum_name != then
                if variant EnumVariant::enum_name casa_enum CasaEnum::name != then
                    f"Cannot check `{variant EnumVariant::enum_name}::{variant EnumVariant::variant_name}` on value of type `{typ.format}`" tc.raise_type_mismatch
                fi
            fi
            # Validate binding count for data-carrying variants
            if 0 variant EnumVariant::bindings.length != then
                variant EnumVariant::variant_name casa_enum CasaEnum::variant_types.get = inner_opt
                if inner_opt.is_some then
                    inner_opt.unwrap = inner_types
                    if variant EnumVariant::bindings.length inner_types.length != then
                        f"Variant `{variant EnumVariant::enum_name}::{variant EnumVariant::variant_name}` has {inner_types.length} inner value(s), but {variant EnumVariant::bindings.length} binding(s) provided" tc.raise_type_mismatch
                    fi
                fi
                if tc.in_branch_condition ! then
                    op Op::location "`is` with bindings is only allowed in if/elif conditions" ErrorKind::InvalidScope tc.diagnostics.record_error
                    TYPE_BOOL_T tc.stack_push_type
                    return
                fi
            fi
            # Track bindings in scope; implicit bindings cannot shadow outer vars.
            for binding_var in variant EnumVariant::bindings.iter do
                op binding_var tc.record_implicit_binding
            done
            variant.bindings.shallow_copy = binding_names
            subject_type variant function_opt tc register_enum_pattern_bindings
            subject.origins binding_names tc.record_pattern_origins
        fi
        TYPE_BOOL_T tc.stack_push_type
    }
}

# ============================================================================
# Check match blocks
# ============================================================================

fn set_binding_type
    tc:mut$TypeChecker
    var_name:mut$str
    field_type:mut$Type
    function_opt:mut$Option[Function]
{
    false var_name tc.set_owner_moved
    field_type var_name tc.scope.set_type = scope_updated
    if function_opt.is_none then
        if var_name tc.store.variables.get Option::Some(global_var) is then
            field_type clone_type global_var Variable::set_typ
            return
        fi
    fi
    if scope_updated then return fi
    if function_opt.is_some then
        function_opt.unwrap = function
        for variable in function Function::variables.iter do
            if var_name variable Variable::name == then
                false var_name tc.scope.assign
                field_type var_name tc.scope.set_type drop
                return
            fi
        done
    fi
    var_name tc.store.variables.get = global_opt
    if global_opt Option::Some(global_var_fallback) is then
        field_type clone_type global_var_fallback Variable::set_typ
    fi
}

impl TypeChecker {
    fn check_match tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        op.value = match_value
        if match_value OpValue::MatchStart is then
            Option[List[str]]::None = match_origins
            Option[str]::None = match_place
            if 0 tc.stack.values.length == then
                tc.within_param_cap = inferring_stack_effect
                if function_opt Option::Some(function) is then
                    if function Function::name "lambda__" str::starts_with ! then
                        false = inferring_stack_effect
                    fi
                else
                    false = inferring_stack_effect
                fi
                if inferring_stack_effect ! then
                    op Op::location "`match` requires a subject value on the stack" ErrorKind::StackUnderflow tc.diagnostics.record_error
                    true = tc.underflow_reported_this_op
                fi
            fi
            if 0 tc.stack.values.length != then
                tc.stack.values.length 1 - tc.stack.values.get = match_subject
                match_subject.origins clone_origins = match_origins
                if match_subject.place Option::Some(place) is then
                    place.clone Option::Some = match_place
                fi
                match_subject tc.consume_value
            fi
            tc.stack_pop_type = match_type
            match_type MatchContext::new = match_ctx
            match_origins = match_ctx.match_origins
            match_place = match_ctx.match_place
            tc.path_continues = match_ctx.entry_continues
            tc.current_ownership_flow = match_ctx.flow_before
            # Snapshot the entry stack state eagerly so that an OpFnReturn visiting
            # this frame before any OpMatchArm still finds a correct `before` to
            # restore from. Matches the pre-refactor make_branched_stack behavior.
            tc.stack match_ctx MatchContext::before.restore
            tc.stack match_ctx MatchContext::after.restore
            op Op::location match_ctx MatchContext::set_current_branch_location
            match_ctx BranchFrame::BranchMatch = match_frame
            match_frame tc.branched_stacks.push
        elif match_value OpValue::MatchArm is then
            op function_opt tc typecheck_match_op
        elif match_value OpValue::MatchEnd is then
            tc.branched_stacks.pop = top_frame
            if top_frame BranchFrame::BranchMatch(match_ctx) is then
                # Close the final arm's scope frame (only opened if an arm ran).
                if match_ctx MatchContext::condition_present then
                    op tc.attach_scope_cleanups
                    tc.scope.exit
                fi
                match_ctx.flow_after tc.merge_current_ownership_flow = match_ctx.flow_after
                if tc.path_continues then true = match_ctx.has_continuing_arm fi
                if match_ctx.has_continuing_arm then
                    match_ctx.flow_after tc.restore_ownership_flow
                else
                    match_ctx.flow_before tc.restore_ownership_flow
                fi
                match_ctx.has_continuing_arm = tc.path_continues
                # Record last arm label
                if "" match_ctx MatchContext::current_branch_label != then
                    match_ctx MatchContext::current_branch_label match_ctx MatchContext::branch_records.push
                fi
                # Record last arm stack effect (same logic as next-arm recording)
                if match_ctx MatchContext::condition_present then
                    match_ctx MatchContext::before = match_before
                    match_ctx MatchContext::after = match_after
                    if
                    match_before tc.stack.equals
                    match_after match_before.equals && !
                    then
                        tc.store match_after tc.stack.unify_types = last_unified
                        if 0 last_unified.length != match_after match_before.equals ! && then
                            last_unified match_after.set_types
                        elif match_after match_before.equals then
                            tc.stack match_after.restore
                        else
                            op Op::location "Match arms have incompatible stack effects" ErrorKind::StackMismatch tc.diagnostics.record_error
                        fi
                    fi
                    match_before tc.stack.restore
                fi

                match_ctx MatchContext::match_type = end_match_type
                end_match_type.match_base = end_base

                # Build covered set
                Set[str]::new = covered_set
                for record in match_ctx MatchContext::branch_records.iter do
                    if record "__covered:" str::starts_with then
                        record.clone 10 record.length 10 - str::substring covered_set.add = covered_set
                    fi
                done
                MATCH_WILDCARD covered_set.has = has_wildcard

                # Check exhaustiveness
                if end_base tc.store.enums.get.is_some has_wildcard ! && then
                    end_base tc.store.enums.get.unwrap = end_enum
                    List[str]::new = missing
                    for variant_name in end_enum CasaEnum::variants.iter do
                        if variant_name covered_set.has ! then
                            variant_name.clone missing.push
                        fi
                    done
                    if 0 missing.length != then
                        List[str]::new = formatted_missing
                        for variant_name in missing.iter do
                            f"`{end_base}::{variant_name}`" formatted_missing.push
                        done
                        ", " formatted_missing.join = missing_str
                        op Op::location f"Non-exhaustive match, missing arms: {missing_str}" ErrorKind::TypeMismatch tc.diagnostics.record_error
                    fi
                fi
                if end_base tc.store.structs.get.is_some has_wildcard ! && then
                    if end_base covered_set.has ! then
                        op Op::location f"Non-exhaustive match on struct `{end_match_type.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                    fi
                fi
                # Literal exhaustiveness
                if
                "bool" end_base ==
                end_match_type.is_integer_type_t ||
                "char" end_base == ||
                "str" end_base == ||
                then
                    if has_wildcard ! then
                        if "bool" end_base == then
                            List[str]::new = bool_missing
                            if "true" covered_set.has ! then "true" bool_missing.push fi
                            if "false" covered_set.has ! then "false" bool_missing.push fi
                            if 0 bool_missing.length != then
                                op Op::location "Non-exhaustive match on `bool`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                            fi
                        else
                            op Op::location f"Non-exhaustive match on type `{end_base}`. A wildcard `_` arm is required" ErrorKind::TypeMismatch tc.diagnostics.record_error
                        fi
                    fi
                fi

                # Apply final stack state
                match_ctx MatchContext::before = final_before
                match_ctx MatchContext::after = final_after
                # When stack == before and before == after, nothing changed
                if final_before tc.stack.equals final_after final_before.equals && then
                    return
                fi
                # When stack == before but after differs (e.g. wildcard-only match),
                # accept the after state directly
                if final_before tc.stack.equals final_after final_before.equals ! && then
                    final_after tc.stack.restore
                    return
                fi
                tc.store final_after tc.stack.unify_types = unified
                if 0 unified.length != then
                    final_after tc.stack.restore
                    unified tc.stack.set_types
                    return
                fi
                op Op::location "Match arms have incompatible stack effects" ErrorKind::StackMismatch tc.diagnostics.record_error
            fi
        fi
    }
}

# ============================================================================
# Check struct new
# ============================================================================

impl TypeChecker {
    fn resolve_struct_member_literal
        tc:mut$TypeChecker
        value:mut$TypedValue
        expected:mut$Type
    -> Type {
        value.type_value = actual
        if 0 value.literals.length == then actual return fi
        if expected.has_unresolved_type_var then
            actual resolve_numeric_literal_default = actual
        else
            expected clone_type = actual
        fi
        tc.diagnostics actual value.resolve_literals drop
        actual
    }

    fn check_struct_new tc:mut$TypeChecker op:mut$Op {
        if op.value OpValue::StructNew(casa_struct) is then
            casa_struct CasaStruct::name = name
            # Build type variable bindings from actual stack values
            Map[str Type]::new = bindings
            Option[List[str]]::None = origins
            for member in casa_struct CasaStruct::members.iter do
                member Member::typ = expected
                tc.stack_pop_value = value
                value.origins origins merge_origins = origins
                if expected.is_borrow value.origins.is_none && then
                    if value.place Option::Some(place) is then
                        expected.is_exclusive_borrow place origins add_origin = origins
                    fi
                fi
                value tc.consume_value
                bindings expected.substitute_t = resolved_expected
                resolved_expected value tc.resolve_struct_member_literal = actual
                if 0 casa_struct CasaStruct::type_vars.length != then
                    bindings actual expected bind_semantic_type_arguments = bindings
                    bindings expected.substitute_t = resolved_expected
                    if actual resolved_expected stack_effect_type_matches ! then
                        f"Expected `{resolved_expected.format}`, got `{actual.format}`" tc.raise_type_mismatch
                    fi
                fi
            done
            # Construct the result type
            if 0 casa_struct CasaStruct::type_vars.length == then
                name GenericType::new Type::Generic = result_type
                origins result_type tc.stack_push_origins
            else
                bindings casa_struct CasaStruct::type_vars name build_resolved_type = result_type
                origins result_type tc.stack_push_origins
            fi
        fi
    }
}

# ============================================================================
# Check struct literal
# ============================================================================

impl TypeChecker {
    fn check_struct_literal tc:mut$TypeChecker op:mut$Op {
        if op.value OpValue::StructLiteral(literal) is then
            literal StructLiteral::struct_name = name
            name tc.store.structs.get = struct_opt
            if struct_opt.is_none then
                name GenericType::new Type::Generic tc.stack_push_type
                return
            fi
            struct_opt.unwrap = casa_struct
            Option[List[str]]::None = origins
            # Pop field values in reverse order
            literal StructLiteral::field_order.length = index
            while 0 index != do
                1 -= index
                index literal StructLiteral::field_order.get = field_name
                # Find member type
                for member in casa_struct CasaStruct::members.iter do
                    if field_name member Member::name == then
                        if 0 tc.stack.values.length != then
                            tc.stack.values.length 1 - tc.stack.values.get.origins origins merge_origins = origins
                        fi
                        member Member::typ tc.expect_type_t
                        break
                    fi
                done
            done
            name GenericType::new Type::Generic = result_type
            origins result_type tc.stack_push_origins
        fi
    }
}

# ============================================================================
# Instantiate default trait method for a concrete type
# ============================================================================

fn qualify_default_method_calls
    ops:mut$List[Op]
    trait_type:mut$Type
    receiver:mut$Type
    store:mut$SymbolStore
{
    for body_op in ops.iter do
        if body_op.value OpValue::MethodCall(method_name) is then
            store receiver method_name collect_method_qualifiers = qualifiers
            if
            store method_name trait_type trait_type_has_method
            qualifiers.length 1 < &&
            then
                method_name trait_type false QualifiedMethod OpValue::QualifiedMethodCall
                body_op Op::set_value
            fi
        elif body_op.value OpValue::PushArray(items) is then
            store receiver trait_type items qualify_default_method_calls
        elif body_op.value OpValue::ExprGroup(items) is then
            store receiver trait_type items qualify_default_method_calls
        fi
    done
}

fn instantiate_default_trait_method
    semantics:MethodSemantics
    receiver:mut$Type
    store:mut$SymbolStore
    diagnostics:mut$Diagnostics
-> Option[str] {
    semantics.function_name = receiver_key
    receiver_key store.functions.get = already_opt
    if already_opt.is_some then
        receiver_key Option::Some return
    fi
    semantics.trait_name store.traits.get = trait_opt
    if trait_opt Option::None is then
        Option[str]::None return
    fi
    trait_opt.unwrap = trait_def
    store trait_def semantics.method_name find_semantic_trait_method = default_method_opt
    if default_method_opt Option::None is then
        Option[str]::None return
    fi
    default_method_opt.unwrap = default_method

    # Check that receiver implements all abstract methods
    trait_def trait_definition_type = required_trait_type
    if semantics.trait_type Option::Some(resolved_trait_type) is then
        resolved_trait_type = required_trait_type
    fi
    if store required_trait_type receiver type_has_semantic_trait_shape ! then
        Option[str]::None return
    fi

    trait_def CasaTrait::type_params = type_params

    # Determine function name and whether to use generic or concrete form
    receiver.base = fn_base_opt
    semantics.function_name = synth_fn_name

    # For generic receivers, keep trait type params as function type vars.
    # For non-generic receivers, substitute trait type params with concrete types.
    Map[str Type]::new = trait_subs
    receiver clone_type = default_self_type
    empty_stack_effect = resolved_stack_effect
    if fn_base_opt.is_some then
        fn_base_opt.unwrap = base_name
        List[Type]::new = default_type_params
        for type_param in type_params.iter do
            type_param.clone Type::TypeVar default_type_params.push
        done
        default_type_params base_name.clone GenericType Type::Generic = default_self_type
        default_self_type default_method TraitMethod::stack_effect resolve_trait_stack_effect = resolved_stack_effect
    else
        if semantics.trait_type Option::Some(resolved_trait_type) is then
            if resolved_trait_type.type_params Option::Some(trait_args) is then
                for pair in trait_args.iter type_params.iter.zip do
                    pair.second clone_type pair.first.clone trait_subs.set = trait_subs
                done
            fi
        fi
        # Infer trait type params from concrete method stack effects
        Set[str]::new = type_param_set
        for type_param in type_params.iter do
            type_param.clone type_param_set.add = type_param_set
        done
        for infer_method in trait_def CasaTrait::methods.iter do
            if 0 infer_method TraitMethod::default_ops.length == then
                store Option[Function]::None receiver infer_method TraitMethod::name
                resolve_method_semantics = infer_method_opt
                Option[Function]::None = infer_fn_opt
                if infer_method_opt Option::Some(infer_semantics) is then
                    infer_semantics.function_name store.functions.get = infer_fn_opt
                fi
                if infer_fn_opt.is_some then
                    infer_fn_opt.unwrap = infer_fn
                    diagnostics store infer_fn ensure_typechecked
                    receiver infer_method TraitMethod::stack_effect resolve_trait_stack_effect = infer_trait_resolved
                    0 (u64) = ret_index
                    while ret_index infer_trait_resolved StackEffect::return_types.length > ret_index infer_fn Function::stack_effect StackEffect::return_types.length > && do
                        type_param_set ret_index infer_fn Function::stack_effect StackEffect::return_types.get ret_index infer_trait_resolved StackEffect::return_types.get trait_subs bind_generic_params_standalone = trait_subs
                        1 += ret_index
                    done
                fi
            fi
        done
        trait_subs receiver default_method TraitMethod::stack_effect resolve_trait_stack_effect apply_type_subs_to_stack_effect = resolved_stack_effect
    fi

    # Add trait type params as function type vars for generic receivers
    if fn_base_opt.is_some then
        for type_param in type_params.iter do
            type_param.clone resolved_stack_effect StackEffect::type_vars.add = new_tvs
            new_tvs resolved_stack_effect StackEffect::set_type_vars
        done
    fi

    default_self_type clone_type TRAIT_SELF_TYPE trait_subs.set = trait_subs

    # Add method-level type vars to stack effect
    for method_type_var in default_method TraitMethod::type_vars.iter do
        method_type_var.clone resolved_stack_effect StackEffect::type_vars.add = new_tvs
        new_tvs resolved_stack_effect StackEffect::set_type_vars
    done

    # Build function ops: parameter assignments + cloned body
    List[Op]::new = synth_ops
    List[Variable]::new = synth_vars
    for synth_param in resolved_stack_effect StackEffect::parameters.iter do
        if "" synth_param Parameter::name != then
            synth_param Parameter::typ synth_param Parameter::name Variable synth_vars.push
            empty_location synth_param Parameter::name OpValue::AssignVar Op::new synth_ops.push
        fi
    done

    default_method TraitMethod::default_ops clone_ops = cloned_body
    if 0 trait_subs.length != then
        trait_subs cloned_body substitute_ops_types
    fi
    if semantics.trait_type Option::Some(default_trait_type) is then
        store receiver default_trait_type cloned_body qualify_default_method_calls
    fi
    0 (u64) = cloned_lambda_index
    0 (u64) = body_index
    while body_index cloned_body.length > do
        body_index cloned_body.get = body_op
        1 += body_index
        if body_op.value OpValue::FnPush(lambda_name) is then
            if lambda_name "lambda__" str::starts_with ! then continue fi
            lambda_name store.functions.get = lambda_opt
            if lambda_opt.is_none then continue fi
            lambda_opt.unwrap = lambda

            f"{lambda_name}__{synth_fn_name}_{cloned_lambda_index}" = cloned_lambda_name
            lambda Function::ops clone_ops = lambda_ops
            if 0 trait_subs.length != then
                trait_subs lambda_ops substitute_ops_types
            fi
            if semantics.trait_type Option::Some(default_trait_type) is then
                store receiver default_trait_type lambda_ops qualify_default_method_calls
            fi
            List[Parameter]::new = lambda_params
            List[Type]::new = lambda_returns
            lambda_returns lambda_params StackEffect::new = lambda_effect
            for lambda_type_var in resolved_stack_effect StackEffect::type_vars.iter do
                lambda_type_var lambda_effect StackEffect::type_vars.add = lambda_tvs
                lambda_tvs lambda_effect StackEffect::set_type_vars
            done
            lambda_effect lambda Function::location lambda_ops cloned_lambda_name Function::with_stack_effect = cloned_lambda
            cloned_lambda cloned_lambda_name store.functions.set drop
            cloned_lambda_name OpValue::FnPush body_op Op::set_value
            1 += cloned_lambda_index
        fi
    done
    cloned_body.shallow_copy synth_ops.append

    # Create, register, and typecheck the function
    resolved_stack_effect empty_location synth_ops synth_fn_name Function::with_stack_effect = synth_fn
    synth_vars synth_fn Function::set_variables
    true synth_fn Function::set_is_used
    unsafe { synth_fn (ptr) (Function) synth_fn_name store.functions.set drop }
    diagnostics store synth_fn ensure_typechecked
    synth_fn synth_fn_name store.functions.set drop

    synth_fn_name Option::Some
}

impl TypeChecker {
    fn apply_trait_bound_method_semantics
        tc:mut$TypeChecker
        semantics:MethodSemantics
        receiver:mut$Type
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    -> u64 {
        tc.stack_pop_drop
        receiver tc.stack_push_type
        semantics.method_name receiver.make_method_key = method_key
        function_opt Option[Type]::None method_key semantics.stack_effect tc.apply_stack_effect
        semantics.function_name OpValue::PushVar op Op::set_value
        op.location OpValue::FnExec Op::new = exec_op
        op_index exec_op ops.insert
        op_index 1 +
    }
}

# ============================================================================
# Check method call
# ============================================================================

impl TypeChecker {
    fn check_char_codepoint tc:mut$TypeChecker op:mut$Op method_name:mut$str -> bool {
        if "codepoint" method_name != then false return fi
        tc.stack_pop_value = value
        if value.type_value TYPE_CHAR_T.eq ! then
            op.location f"Method `codepoint` requires `char`, got `{value.type_value.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error
        fi
        BuiltinType::U32 BuiltinType::Char NumericConversionKind::ToBits NumericConversion
        OpValue::NumericConvert op Op::set_value
        TYPE_U32_T Option::Some op Op::set_type_hint
        TYPE_U32_T tc.stack_push_type
        true
    }

    fn check_try_integer_method tc:mut$TypeChecker op:mut$Op method_name:mut$str -> bool {
        if
        "try_add" method_name ==
        "try_sub" method_name == ||
        "try_mul" method_name == ||
        "try_div" method_name == ||
        "try_mod" method_name == || !
        then
            false return
        fi
        tc.stack_pop_value = receiver
        receiver tc.stack_pop_left_like = other
        TYPE_I64_T = target_type
        if receiver.type_value.is_integer_type_t then
            receiver.type_value = target_type
        elif other.type_value.is_integer_type_t then
            other.type_value = target_type
        fi
        if target_type Type::Builtin(target) is then
            target_type receiver tc.resolve_integer_value drop
            target_type other tc.resolve_integer_value drop
            method_name.clone match
                "try_add" => IntegerTryKind::Add
                "try_sub" => IntegerTryKind::Sub
                "try_mul" => IntegerTryKind::Mul
                "try_div" => IntegerTryKind::Div
                _ => IntegerTryKind::Mod
            end = kind
            target kind IntegerTry OpValue::IntegerTry op Op::set_value
            target_type clone_type Option::Some op Op::set_type_hint
            List[Type]::new = option_params
            target_type clone_type option_params.push
            option_params "Option" GenericType Type::Generic tc.stack_push_type
            true return
        fi
        f"Method requires integer operands, got `{receiver.type_value.format}` and `{other.type_value.format}`" tc.raise_type_mismatch
        TYPE_UNKNOWN_T tc.stack_push_type
        true
    }

    fn check_float_round tc:mut$TypeChecker op:mut$Op method_name:mut$str -> bool {
        if
        "__float_floor" method_name ==
        "__float_ceil" method_name == ||
        "__float_trunc" method_name == ||
        "__float_round" method_name == || !
        then
            false return
        fi
        tc.stack_pop_value = value
        if value.type_value Type::Builtin(target) is then
            if target.is_float then
                target (i64) = target_value
                target_value (BuiltinType) method_name FloatRound = rounding
                rounding OpValue::FloatRound op Op::set_value
                target_value (BuiltinType) Type::Builtin Option::Some op Op::set_type_hint
                target_value (BuiltinType) Type::Builtin tc.stack_push_type
                true return
            fi
        fi
        op.location f"Method `{method_name}` requires `f32` or `f64`" ErrorKind::TypeMismatch tc.diagnostics.record_error
        TYPE_UNKNOWN_T tc.stack_push_type
        true
    }

    fn check_wrapping_method tc:mut$TypeChecker op:mut$Op method_name:mut$str -> bool {
        if
        "wrapping_add" method_name ==
        "wrapping_sub" method_name == ||
        "wrapping_mul" method_name == || !
        then
            false return
        fi
        tc.stack_pop_value = receiver
        receiver tc.stack_pop_left_like = other
        TYPE_I64_T = target
        if receiver.type_value.is_integer_type_t then
            receiver.type_value = target
        elif other.type_value.is_integer_type_t then
            other.type_value = target
        fi
        if target.is_integer_type_t ! then
            f"Method requires integer operands, got `{receiver.type_value.format}` and `{other.type_value.format}`" tc.raise_type_mismatch
            false return
        fi
        target receiver tc.resolve_integer_value drop
        target other tc.resolve_integer_value drop
        if "wrapping_add" method_name == then
            OpValue::WrappingAdd op Op::set_value
        elif "wrapping_sub" method_name == then
            OpValue::WrappingSub op Op::set_value
        else
            OpValue::WrappingMul op Op::set_value
        fi
        target clone_type Option::Some op Op::set_type_hint
        target tc.stack_push_type
        true
    }

    fn check_method_call
        tc:mut$TypeChecker
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    -> u64 {
        Option[str]::None = method_name_opt
        if op.value OpValue::MethodCall(method_name) is then
            method_name Option::Some = method_name_opt
        elif op.value OpValue::QualifiedMethodCall(qualified) is then
            qualified.method_name Option::Some = method_name_opt
        fi
        if method_name_opt Option::Some(method_name) is then
            if "drop" method_name == then
                op.location "Reserved `drop` methods cannot be called directly; use the `drop` intrinsic" ErrorKind::InvalidScope tc.diagnostics.record_error
            fi
            tc.stack_peek_type = receiver
            ValueCapability::Owned = receiver_capability
            if 0 tc.stack.values.length != then
                tc.stack.values.length 1 - tc.stack.values.get.capability = receiver_capability
            fi
            receiver clone_type = lookup_receiver
            if
            receiver.is_shared_borrow
            receiver_capability ValueCapability::Exclusive is &&
            then
                receiver.borrow_target.unwrap clone_type = receiver_target
                EXCLUSIVE_BORROW_TYPE receiver_target apply_borrow_type = lookup_receiver
            elif receiver.is_borrow ! then
                if receiver_capability ValueCapability::Shared is then
                    SHARED_BORROW_TYPE receiver clone_type apply_borrow_type = lookup_receiver
                elif receiver_capability ValueCapability::Exclusive is then
                    EXCLUSIVE_BORROW_TYPE receiver clone_type apply_borrow_type = lookup_receiver
                fi
            fi
            if "clone" method_name == then
                op.location lookup_receiver tc.ensure_function_clone_method
            fi
            if op.value OpValue::MethodCall is then
                if method_name op tc.check_float_to_bits then op_index return fi
                if method_name op tc.check_char_codepoint then op_index return fi
                if method_name op tc.check_float_round then op_index return fi
                if method_name op tc.check_try_integer_method then op_index return fi
                if method_name op tc.check_wrapping_method then op_index return fi
            fi
            tc.store function_opt lookup_receiver clone_type Option::Some op.value
            analyze_operation = semantics
            if semantics.method Option::Some(method_semantics) is then
                method_name receiver_capability method_semantics.stack_effect
                tc.check_method_receiver_capability
                if method_semantics.kind MethodSemanticsKind::TraitBound is then
                    function_opt op_index ops op receiver method_semantics
                    tc.apply_trait_bound_method_semantics return
                fi
                method_semantics.function_name = fn_name
                if method_semantics.kind MethodSemanticsKind::DefaultMethod is then
                    tc.diagnostics tc.store receiver method_semantics
                    instantiate_default_trait_method = default_inst_opt
                    if default_inst_opt Option::Some(default_name) is then
                        default_name = fn_name
                    fi
                fi
                if fn_name tc.store.functions.get Option::Some(function) is then
                    if function.is_unsafe then fn_name op tc.require_unsafe fi
                    if function Function::is_typechecked ! then
                        function Function::ops clone_ops = function_ops
                        tc.diagnostics function function_ops tc.store resolve_identifiers
                        function Function::set_ops
                        true function Function::set_is_used
                    fi
                    tc.diagnostics tc.store function ensure_typechecked
                    function Function::stack_effect = effect
                    if effect effect_needs_hidden_arguments then
                        Option[Type]::None function_opt op Op::location op_index ops effect
                        tc.inject_trait_fn_ptrs += op_index
                    fi
                    function_opt Option[Type]::None fn_name effect tc.apply_stack_effect
                    fn_name OpValue::FnCall op Op::set_value
                    op_index return
                fi
            fi
            method_name receiver.make_method_key = missing_name
            tc.store receiver method_name collect_method_qualifiers = qualifiers
            if qualifiers.length 1 < then
                ", " qualifiers.join = qualifier_list
                op.location f"Method `{missing_name}` is ambiguous between `{qualifier_list}`. Use a trait-qualified call"
                ErrorKind::TraitSignatureMismatch tc.diagnostics.record_error
            else
                op.location f"Method `{missing_name}` does not exist"
                ErrorKind::UndefinedName tc.diagnostics.record_error
            fi
        fi
        op_index
    }
}

# ============================================================================
# Check f-string expression conversion (Display trait dispatch)
# ============================================================================

impl TypeChecker {
    fn check_fstring_to_str
        tc:mut$TypeChecker
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    -> u64 {
        "value with trait `Display`" = tc.current_expect_ctx
        if TYPE_STR_T tc.stack_peek_type.eq then
            op_index return
        fi
        tc.stack_peek_type = fstring_type_t
        fstring_type_t.format = fstring_type
        if TYPE_MISSING fstring_type == TYPE_UNKNOWN fstring_type == || then
            tc.stack_pop_drop
            TYPE_STR_T tc.stack_push_type
            op_index return
        fi
        if fstring_type_t Type::Builtin(builtin) is then
            if
            builtin.is_integer
            builtin BuiltinType::Bool == ||
            builtin BuiltinType::Char == ||
            builtin BuiltinType::Cstr == ||
            then
                builtin OpValue::PrimitiveToStr op Op::set_value
                tc.stack_pop_drop
                TYPE_STR_T tc.stack_push_type
                op_index return
            fi
        fi
        tc.store function_opt fstring_type_t clone_type Option::Some op.value
        analyze_operation = semantics
        "Display" GenericType::new Type::Generic = display_type
        if tc.diagnostics tc.store function_opt display_type fstring_type_t type_satisfies_trait ! then
            op Op::location f"Type `{fstring_type}` cannot be used in f-string: does not satisfy trait `Display`" ErrorKind::MissingTraitMethod tc.diagnostics.record_error
            tc.stack_pop_drop
            TYPE_STR_T tc.stack_push_type
            op_index return
        fi
        if semantics.method Option::Some(method) is then
            method.method_name OpValue::MethodCall op Op::set_value
        else
            "to_str" OpValue::MethodCall op Op::set_value
        fi
        function_opt op_index ops op tc.check_method_call
    }
}

# ============================================================================
# Ensure a function is typechecked
# ============================================================================

fn ensure_typechecked function:mut$Function store:mut$SymbolStore diagnostics:mut$Diagnostics {
    if function Function::is_typechecked then return fi
    true function Function::set_is_typechecked
    function Function::ops clone_ops = function_ops
    diagnostics function function_ops store resolve_identifiers = resolved_ops
    diagnostics store function Option::Some resolved_ops check_ops = inferred_stack_effect
    resolved_ops function Function::set_ops
    if function Function::stack_effect stack_effect_to_str "None -> None" == then
        if function.name "lambda__" str::starts_with then
            inferred_stack_effect function Function::set_stack_effect
        else
            Map[str StackEffect]::new = inferred_effects
            store inferred_effects function analyze_function_semantics
            = semantics
            semantics.inferred_effect function Function::set_stack_effect
        fi
    fi
}

# ============================================================================
# Main type check dispatch
# ============================================================================

impl TypeChecker {
    fn check_copy_operation tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        tc.stack.values.length = depth
        0 (u64) = copied_index
        if op.value OpValue::Over is then
            if depth 2 < then function_opt op tc.apply_fixed_semantics return fi
            depth 2 - = copied_index
        else
            if 0 depth == then function_opt op tc.apply_fixed_semantics return fi
            depth 1 - = copied_index
        fi
        copied_index tc.stack.values.get = copied_value
        copied_value.type_value clone_type = copied_type
        if copied_type.is_borrow ! then
            if copied_value.capability ValueCapability::Shared is then
                SHARED_BORROW_TYPE copied_type clone_type apply_borrow_type = copied_type
            elif copied_value.capability ValueCapability::Exclusive is then
                EXCLUSIVE_BORROW_TYPE copied_type clone_type apply_borrow_type = copied_type
            fi
        fi
        copied_type resolve_numeric_literal_default = copy_check_type
        if function_opt copy_check_type tc.type_is_duplicable ! then
            op.location f"Type `{copied_type.format}` does not satisfy trait `Copy`" ErrorKind::TypeMismatch tc.diagnostics.record_error
        fi
        function_opt op tc.apply_fixed_semantics
    }

    fn run_type_check_ops
        checker:mut$TypeChecker
        ops:mut$List[Op]
        function_opt:mut$Option[Function]
    {
        0 (u64) = op_index
        while op_index ops.length > do
            op_index ops.get = current_op
            1 += op_index
            current_op Op::location = checker.current_location
            "" = checker.current_expect_ctx
            false = checker.underflow_reported_this_op
            current_op.value = op_value
            if op_value OpValue::UnsafeStart is then
                1 += checker.unsafe_depth
                continue
            fi
            if op_value OpValue::UnsafeEnd is then
                if 0 checker.unsafe_depth != then 1 -= checker.unsafe_depth fi
                continue
            fi
            if
            op_value OpValue::Dup is
            op_value OpValue::Over is ||
            op_value OpValue::Copy is ||
            then
                function_opt current_op checker.check_copy_operation
                continue
            fi
            if
            op_value OpValue::Add is
            op_value OpValue::Sub is ||
            op_value OpValue::Mul is ||
            op_value OpValue::Div is ||
            op_value OpValue::Mod is ||
            op_value OpValue::Shl is ||
            op_value OpValue::Shr is ||
            op_value OpValue::BitAnd is ||
            op_value OpValue::BitOr is ||
            op_value OpValue::BitXor is ||
            op_value OpValue::BitNot is ||
            then
                current_op checker.check_integer_operation
                continue
            fi
            if op_value operation_uses_fixed_typecheck_effect then
                function_opt current_op checker.apply_fixed_semantics
                continue
            fi
            if op_value OpValue::NumericCall is then
                current_op checker.check_numeric_call
                continue
            fi
            # Comparison
            if op_value operation_is_comparison then
                function_opt op_index ops current_op checker.check_comparison = op_index
                continue
            fi

            # Memory
            if op_value operation_is_memory then
                function_opt current_op checker.check_memory
                continue
            fi

            # Assignment
            if
            op_value OpValue::AssignVar is
            op_value OpValue::AssignDec is ||
            op_value OpValue::AssignInc is ||
            then
                function_opt op_index ops current_op checker.check_assignment
                continue
            fi

            # Push variable / capture
            if
            op_value OpValue::PushVar is
            op_value OpValue::PushCapture is ||
            then
                function_opt current_op checker.check_push_var
                continue
            fi

            # If block
            if
            op_value OpValue::IfStart is
            op_value OpValue::IfCondition is ||
            op_value OpValue::IfElif is ||
            op_value OpValue::IfElse is ||
            op_value OpValue::IfEnd is ||
            then
                current_op checker.check_if_block
                continue
            fi

            # While block
            if
            op_value OpValue::WhileStart is
            op_value OpValue::WhileCondition is ||
            op_value OpValue::WhileBreak is ||
            op_value OpValue::WhileContinue is ||
            op_value OpValue::WhileEnd is ||
            then
                current_op checker.check_while_block
                continue
            fi

            # Function ops
            if
            op_value OpValue::FnCall is
            op_value OpValue::FnExec is ||
            op_value OpValue::FnPush is ||
            op_value OpValue::FnReturn is ||
            then
                function_opt op_index ops current_op checker.check_function_ops = op_index
                continue
            fi

            # Literals
            if
            op_value OpValue::PushInt is
            op_value OpValue::PushFloat is ||
            op_value OpValue::PushArray is ||
            op_value OpValue::ExprGroup is ||
            then
                function_opt current_op checker.check_literals
                continue
            fi

            # IO
            if op_value OpValue::Print is then
                function_opt op_index ops current_op checker.check_io = op_index
                continue
            fi

            # Typeof
            if op_value OpValue::Typeof is then
                current_op checker.check_typeof
                continue
            fi

            # Syscalls
            if
            op_value OpValue::Syscall0 is
            op_value OpValue::Syscall1 is ||
            op_value OpValue::Syscall2 is ||
            op_value OpValue::Syscall3 is ||
            op_value OpValue::Syscall4 is ||
            op_value OpValue::Syscall5 is ||
            op_value OpValue::Syscall6 is ||
            then
                function_opt current_op checker.check_syscalls
                continue
            fi

            # Argc / Argv
            if op_value OpValue::Argc is then
                TYPE_I64_T checker.stack_push_type
                continue
            fi
            if op_value OpValue::Argv is then
                TYPE_PTR_T checker.stack_push_type
                continue
            fi
            if op_value OpValue::Envp is then
                TYPE_PTR_T checker.stack_push_type
                continue
            fi

            # Enum variant
            if op_value OpValue::PushEnumVariant is then
                function_opt current_op checker.check_enum_variant
                continue
            fi

            # Is check
            if op_value OpValue::IsCheck is then
                function_opt current_op checker.check_is
                continue
            fi

            # Match block
            if
            op_value OpValue::MatchStart is
            op_value OpValue::MatchArm is ||
            op_value OpValue::MatchEnd is ||
            then
                function_opt current_op checker.check_match
                continue
            fi

            # Struct new
            if op_value OpValue::StructNew is then
                current_op checker.check_struct_new
                continue
            fi

            # Struct literal
            if op_value OpValue::StructLiteral is then
                current_op checker.check_struct_literal
                continue
            fi

            # Method call
            if
            op_value OpValue::MethodCall is
            op_value OpValue::QualifiedMethodCall is ||
            then
                function_opt op_index ops current_op checker.check_method_call = op_index
                continue
            fi

            # Trait-bound method call
            if op_value OpValue::TraitMethodCall is then
                function_opt current_op checker.check_trait_method_call
                continue
            fi

            # F-string expression -> str conversion (Display trait)
            if op_value OpValue::FstringToStr is then
                function_opt op_index ops current_op checker.check_fstring_to_str = op_index
                continue
            fi

            # Type cast
            if op_value OpValue::TypeCast(cast_type) is then
                current_op Op::location function_opt cast_type checker.validate_type_exists
                checker.stack_pop_value = cast_value
                cast_value.origins clone_origins = cast_origins
                if cast_type TYPE_CHAR_T.eq then
                    current_op.location "Cast to `char` is not allowed; use `char::from_codepoint`" ErrorKind::TypeMismatch checker.diagnostics.record_error
                elif cast_value.type_value TYPE_CHAR_T.eq then
                    current_op.location "Cast from `char` is not allowed; use `.codepoint`" ErrorKind::TypeMismatch checker.diagnostics.record_error
                fi
                if cast_type TYPE_PTR_T.eq cast_value.type_value TYPE_PTR_T.eq || then
                    "pointer cast" current_op checker.require_unsafe
                fi
                if cast_type TYPE_PTR_T.eq then
                    cast_value checker.release_value
                else
                    cast_value checker.consume_value
                fi
                if checker.store cast_type type_has_borrow then
                    if cast_origins.is_none 0 checker.unsafe_depth != && then
                        cast_type.is_exclusive_borrow function_opt
                        checker.raw_borrow_input_origins = cast_origins
                    fi
                    cast_origins cast_type checker.stack_push_origins
                else
                    cast_type checker.stack_push_type
                fi
                continue
            fi

            # Import file and DeclareGlobal (compile-time only, no type effect)
            if
            op_value OpValue::ImportFile is
            op_value OpValue::ImportFileSelective is ||
            op_value OpValue::DeclareGlobal is ||
            then
                continue
            fi

            # Print variants (already resolved, should not appear)
            if
            op_value OpValue::PrintBool is
            op_value OpValue::PrintChar is ||
            op_value OpValue::PrintCstr is ||
            op_value OpValue::PrintInt is ||
            op_value OpValue::PrintStr is ||
            then
                continue
            fi

            # Identifier (should be resolved by parser)
            if op_value OpValue::Identifier is then
                continue
            fi
        done
    }
}

fn materialize_declared_return_borrow value:mut$TypedValue declared:mut$Type {
    if declared.is_borrow ! value.capability ValueCapability::Owned is || then return fi
    value.type_value clone_type = target
    if value.type_value.borrow_target Option::Some(borrowed) is then borrowed = target fi
    if declared.is_exclusive_borrow then EXCLUSIVE_BORROW_TYPE else SHARED_BORROW_TYPE fi
    target apply_borrow_type = value.type_value
    Option[List[str]]::None = origins
    if value.origins Option::Some(current_origins) is then
        for origin in current_origins.iter do
            origin origin_place = place
            declared.is_exclusive_borrow place origins add_origin = origins
        done
    fi
    if origins.is_none then
        if value.place Option::Some(place) is then
            declared.is_exclusive_borrow place origins add_origin = origins
        fi
    fi
    origins = value.origins
}

impl TypeChecker {
    fn resolve_declared_return_borrow_capabilities self:mut$TypeChecker function:mut$Function {
        0 (u64) = index
        while
        index self.stack.values.length >
        index function.stack_effect.return_types.length > &&
        do
            index function.stack_effect.return_types.get = declared
            index self.stack.values.get = value
            declared value materialize_declared_return_borrow
            1 += index
        done
    }

    fn resolve_declared_return_literals
        checker:mut$TypeChecker
        function:mut$Function
        diagnostics:mut$Diagnostics
    {
        function.stack_effect.return_types = declared_returns
        if declared_returns.length checker.stack.values.length != then return fi
        0 (u64) = return_index
        while return_index declared_returns.length > do
            return_index checker.stack.values.get = return_value
            if 0 return_value.literals.length != then
                return_index declared_returns.get = declared_return
                diagnostics declared_return return_value.resolve_literals drop
                return_value.origins clone_origins return_value.source return_value.binding
                return_value.capability return_value.place
                List[Op]::new return_value.origin
                declared_return TypedValue
                return_index checker.stack.values.set
            fi
            1 += return_index
        done
    }
}

fn check_ops
    ops:mut$List[Op]
    function_opt:mut$Option[Function]
    store:mut$SymbolStore
    diagnostics:mut$Diagnostics
-> StackEffect {
    store TypeChecker::new = checker
    unsafe { diagnostics (ptr) (Diagnostics) = checker.diagnostics }
    Option[u64]::None = budget
    if function_opt.is_some then
        function_opt.unwrap = the_function
        for variable in the_function.variables.iter do
            true variable.name checker.set_owner_moved
        done
        if the_function Function::name "lambda__" str::starts_with ! then
            the_function Function::stack_effect StackEffect::parameters.length Option::Some = budget
        fi
    fi
    budget = checker.param_cap
    Map[str u64]::new ops count_variable_uses = checker.remaining_uses
    diagnostics.error_count = errors_before_ops
    function_opt ops checker.run_type_check_ops

    if function_opt Option::Some(checked_function) is then
        checked_function checker.resolve_declared_return_borrow_capabilities
        if checker.has_return_types ! then
            checked_function checker.validate_borrow_returns
        fi
        diagnostics checked_function checker.resolve_declared_return_literals
    fi

    0 (u64) = stack_index
    while stack_index checker.stack.values.length > do
        stack_index checker.stack.values.get = stack_value
        stack_value checker.consume_value
        stack_value.type_value resolve_numeric_literal_default = final_type
        diagnostics final_type stack_value.resolve_literals drop
        stack_value.origins clone_origins stack_value.source stack_value.binding
        stack_value.capability stack_value.place List[Op]::new
        stack_value.origin final_type
        TypedValue
        stack_index checker.stack.values.set
        1 += stack_index
    done
    if 0 checker.owner_events.length != then
        checker.current_location OpValue::OwnerCleanup Op::new = cleanup_op
        cleanup_op checker.attach_all_owner_cleanups
        cleanup_op ops.push
    fi
    diagnostics ops resolve_default_literals

    # Build inferred stack effect
    List[Type]::new = inferred_returns
    for inferred_value in checker.stack.values.iter do
        inferred_value.type_value inferred_returns.push
    done
    inferred_returns checker.parameters StackEffect::new = inferred

    # Verify against declared stack effect if function has one
    diagnostics.error_count errors_before_ops < = had_type_errors
    if function_opt.is_some had_type_errors ! && then
        function_opt.unwrap = declared_function
        declared_function Function::stack_effect = declared
        if
        declared stack_effect_to_str "None -> None" !=
        0 declared StackEffect::type_vars.length == &&
        then
            if inferred declared stack_effect_matches ! then
                declared_function Function::location f"Invalid stack effect for function `{declared_function Function::name}`: expected `{declared stack_effect_to_str}`, got `{inferred stack_effect_to_str}`" ErrorKind::SignatureMismatch diagnostics.record_error
            fi
        fi
        # Update inferred stack effect with declared return types for type-var functions
        if 0 declared StackEffect::type_vars.length != then
            declared = inferred
        fi
    fi

    inferred
}

# ============================================================================
# Type check all functions
# ============================================================================

fn check_functions store:mut$SymbolStore diagnostics:mut$Diagnostics {
    for pair in store.functions.iter do
        pair.first = func_name
        pair.second = current_fn
        if current_fn Function::is_typechecked then
            continue
        fi
        if func_name "lambda__" str::starts_with then
            continue
        fi
        true current_fn Function::set_is_typechecked
        current_fn Function::ops clone_ops = current_ops
        diagnostics current_fn current_ops store resolve_identifiers = resolved_ops
        # Skip type checking for functions with trait bounds (checked on demand)
        if 0 current_fn Function::stack_effect StackEffect::trait_bounds.keys.length != then
            resolved_ops current_fn Function::set_ops
            continue
        fi
        diagnostics.error_count = errors_before
        unsafe { current_fn (ptr) (Function) Option::Some = current_fn_opt }
        diagnostics store current_fn_opt resolved_ops check_ops = inferred_stack_effect
        resolved_ops current_fn Function::set_ops
        diagnostics.error_count errors_before < = had_errors
        if had_errors then
            continue
        fi
        if current_fn Function::stack_effect stack_effect_to_str "None -> None" == then
            Map[str StackEffect]::new = inferred_effects
            store inferred_effects current_fn analyze_function_semantics
            = semantics
            semantics.inferred_effect current_fn Function::set_stack_effect
        fi
    done
}

fn check_trait_impls store:mut$SymbolStore diagnostics:mut$Diagnostics {
    for trait_impl in store.trait_impls.values.iter do
        trait_impl.trait_bound trait_bound_to_type = trait_type
        Set[str]::new = checked_methods
        true = valid
        for candidate in trait_type store collect_trait_method_candidates.iter do
            candidate.method.name = method_name
            if method_name checked_methods.has then continue fi
            method_name checked_methods.add = checked_methods
            method_name trait_impl.methods.get = function_name_opt
            if function_name_opt.is_none then
                store trait_impl.receiver method_name find_semantic_method_function = function_name_opt
            fi
            if function_name_opt Option::Some(function_name) is then
                function_name store.functions.get = function_opt
                if function_opt.is_none then false = valid continue fi
                function_opt.unwrap = implementation
                diagnostics store implementation ensure_typechecked
                trait_impl.receiver candidate.effect resolve_trait_stack_effect = expected
                if true implementation.stack_effect expected trait_method_effects_match ! then
                    false = valid
                fi
            elif store trait_type method_name find_trait_default_method.is_none then
                false = valid
            fi
        done
        if valid ! then
            trait_impl.location f"Trait implementation `{trait_impl.receiver.format}: {trait_type.format}` does not satisfy the trait requirements" ErrorKind::TraitSignatureMismatch diagnostics.record_error
        fi
    done
}

fn type_check ops:mut$List[Op] store:mut$SymbolStore -> TypecheckResult {
    Diagnostics::new = diagnostics
    diagnostics store Option::None ops check_ops = global_stack_effect
    diagnostics store check_functions
    diagnostics store check_trait_impls
    diagnostics
    ops
    global_stack_effect
    store
    TypecheckResult
}
