# ============================================================================
# Check enum variant push
# ============================================================================

fn get_enum_variant_shape
    enum_name:$str
    variant_name:$str
    store:$SymbolStore
-> Option[List[String]] List[Type] {
    List[Type]::new = payload_types
    if enum_name store.enums.get_str Option::Some(casa_enum) is then
        if variant_name casa_enum.variant_types.get_str Option::Some(found_types) is then
            for found_type in found_types.iter do
                found_type clone_type payload_types.push
            done
        fi
        casa_enum.type_vars.clone Option::Some payload_types
    else
        Option[List[String]]::None payload_types
    fi
}

fn get_enum_variant_arity enum_name:$str variant_name:$str store:$SymbolStore -> Option[u64] {
    if enum_name store.enums.get_str Option::Some(casa_enum) is then
        if variant_name casa_enum.variant_types.get_str Option::Some(payload_types) is then
            payload_types.length Option::Some return
        fi
    fi
    Option[u64]::None
}

impl TypeChecker {
    fn check_enum_variant tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        if op.value OpValue::PushEnumVariant(variant) is then
            variant EnumVariant::enum_name.clone = enum_name
            tc.store variant.variant_name.as_str enum_name.as_str get_enum_variant_shape = inner_types
            = type_variables_opt
            if type_variables_opt Option::Some(type_variables) is then
                if 0 inner_types.length == then
                    if op.type_hint Option::Some(explicit_type) is then
                        op.location function_opt explicit_type tc.validate_type_exists
                        explicit_type tc.stack_push_type
                    elif 0 type_variables.length != then
                        type_variables enum_name.as_str build_parameterized_type tc.stack_push_type
                    else
                        enum_name GenericType::new Type::Generic tc.stack_push_type
                    fi
                    return
                fi

                Map[String Type]::new = bindings
                if op.type_hint Option::Some(hint) is then
                    if enum_name hint.match_base == then
                        type_variables hint aggregate_type_bindings = bindings
                    fi
                fi
                Option[List[String]]::None = origins
                for expected in inner_types.iter do
                    origins bindings expected tc.expect_aggregate_value = origins
                done
                if 0 type_variables.length != then
                    bindings type_variables enum_name.as_str build_resolved_type
                else
                    enum_name GenericType::new Type::Generic
                fi = result_type
                origins result_type tc.stack_push_origins
            else
                enum_name GenericType::new Type::Generic tc.stack_push_type
            fi
        fi
    }
}

# ============================================================================
# Check is keyword
# ============================================================================

impl TypeChecker {
    fn check_is tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        tc.stack_pop_value = subject
        subject tc.release_value
        subject.type_value clone_type = typ
        typ clone_type = subject_type
        if typ.borrow_target Option::Some(target) is then
            target clone_type = subject_type
        fi
        subject_type.match_base = base
        if
            base tc
                .store
                .enums
                .has !
        then
            f"`is` requires an enum type, got `{subject_type.format}`" tc.raise_type_mismatch
            TYPE_BOOL_T tc.stack_push_type
            return
        fi
        op.value clone_op_value = is_value
        if is_value OpValue::IsCheck(variant) is then
            # Validate the variant belongs to the correct enum
            if "" variant EnumVariant::enum_name.as_str != then
                if variant EnumVariant::enum_name base != then
                    f"Cannot check `{variant EnumVariant::enum_name}::{variant EnumVariant::variant_name}` on value of type `{typ.format}`" tc.raise_type_mismatch
                fi
            fi
            # Validate binding count for data-carrying variants
            if 0 variant EnumVariant::bindings.length != then
                tc.store variant.variant_name.as_str base.as_str get_enum_variant_arity = arity_opt
                if arity_opt Option::Some(arity) is then
                    if variant EnumVariant::bindings.length arity != then
                        f"Variant `{variant EnumVariant::enum_name}::{variant EnumVariant::variant_name}` has {arity} inner value(s), but {variant EnumVariant::bindings.length} binding(s) provided" tc.raise_type_mismatch
                    fi
                fi
                if tc.in_branch_condition ! then
                    op Op::location "`is` with bindings is only allowed in if/elif conditions" ErrorKind::InvalidScope tc.diagnostics.record_error
                    TYPE_BOOL_T tc.stack_push_type
                    return
                fi
            fi
            # Track bindings in scope; implicit bindings cannot shadow outer vars.
            for binding_var in variant EnumVariant::bindings.iter do
                op binding_var.as_str tc.record_implicit_binding
            done
            variant.bindings.clone = binding_names
            typ clone_type = observed_type
            typ.match_base = observed_base
            if
                observed_base.as_str SHARED_BORROW_TYPE !=
                observed_base.as_str EXCLUSIVE_BORROW_TYPE != &&
            then
                SHARED_BORROW_TYPE observed_type apply_borrow_type = observed_type
            fi
            observed_type variant.clone function_opt tc register_enum_pattern_bindings
            subject.origins clone_origins = binding_origins
            if subject.place Option::Some(subject_place) is then
                false subject_place.as_str binding_origins add_origin = binding_origins
            fi
            binding_origins binding_names tc.record_pattern_origins
        fi
        TYPE_BOOL_T tc.stack_push_type
    }
}

# ============================================================================
# Check match blocks
# ============================================================================

fn set_binding_type
    tc:mut$TypeChecker
    var_name:$str
    field_type:$Type
    function_opt:mut$Option[Function]
{
    false var_name.as_str tc.set_owner_moved
    field_type var_name.as_str tc.scope.set_type = scope_updated
    if function_opt.is_none then
        var_name.as_str tc
            .store
            .variables
            .remove_str = global_opt
        if global_opt Option::Some(global_var) is then
            global_var clone_variable = updated_global
            field_type clone_type updated_global Variable::set_typ
            updated_global var_name.clone tc
                .store
                .variables
                .set_str
            return
        fi
    fi
    if scope_updated then
        return
    fi
    if function_opt Option::Some(function) is then
        for variable in function Function::variables.iter do
            if var_name variable Variable::name.as_str == then
                false var_name.as_str tc.scope.assign
                field_type var_name.as_str tc.scope.set_type drop
                return
            fi
        done
    fi
    var_name.as_str tc
        .store
        .variables
        .remove_str = global_opt
    if global_opt Option::Some(global_var_fallback) is then
        global_var_fallback clone_variable = updated_global
        field_type clone_type updated_global Variable::set_typ
        updated_global var_name.clone tc
            .store
            .variables
            .set_str
    fi
}

impl TypeChecker {
    fn check_match tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        if op.value OpValue::MatchStart is then
            Option[List[String]]::None = match_origins
            Option[String]::None = match_place
            if
                0 tc
                    .stack
                    .values
                    .length ==
            then
                tc.within_param_cap = inferring_stack_effect
                if function_opt Option::Some(function) is then
                    if function Function::name.as_str "lambda__" str::starts_with ! then
                        false = inferring_stack_effect
                    fi
                else
                    false = inferring_stack_effect
                fi
                if inferring_stack_effect ! then
                    op Op::location "`match` requires a subject value on the stack" ErrorKind::StackUnderflow tc.diagnostics.record_error
                    true = tc.underflow_reported_this_op
                fi
            fi
            0 tc
                .stack
                .values
                .length != = has_match_subject
            tc.stack_pop_value = match_subject
            match_subject.type_value clone_type = match_type
            if 0 match_subject.literals.length != then
                match_type resolve_numeric_literal_default = match_type
                tc.literal_resolutions tc.diagnostics match_type match_subject.resolve_literals drop
            fi
            if has_match_subject then
                match_subject.origins clone_origins = match_origins
                if match_subject.place Option::Some(place) is then
                    place.clone Option::Some = match_place
                fi
                match_subject tc.finish_value_use
                if match_subject.capability ValueCapability::Owned is ! then
                    if match_type.is_borrow ! then
                        if match_subject.capability ValueCapability::Shared is then
                            SHARED_BORROW_TYPE
                        else
                            EXCLUSIVE_BORROW_TYPE
                        fi
                        match_type apply_borrow_type = match_type
                    fi
                fi
            fi
            match_type MatchContext::new = match_ctx
            match_origins = match_ctx.match_origins
            match_place = match_ctx.match_place
            tc.path_continues = match_ctx.entry_continues
            tc.current_ownership_flow = match_ctx.flow_before
            # Snapshot the entry stack state eagerly so that an OpFnReturn visiting
            # this frame before any OpMatchArm still finds a correct `before` to
            # restore from. Matches the pre-refactor make_branched_stack behavior.
            tc.stack match_ctx MatchContext::before.restore
            tc.stack match_ctx MatchContext::after.restore
            op Op::location.clone match_ctx MatchContext::set_current_branch_location
            match_ctx BranchFrame::BranchMatch = match_frame
            match_frame tc.branched_stacks.push
        elif op.value OpValue::MatchArm is then
            op function_opt tc typecheck_match_op
        elif op.value OpValue::MatchEnd is then
            tc
                .branched_stacks
                .pop
                .into_match = match_ctx
            # Close the final arm's scope frame (only opened if an arm ran).
            if match_ctx MatchContext::condition_present then
                if tc.path_continues then
                    match_ctx.before tc.materialize_branch_results
                fi
                op tc.attach_scope_cleanups
                tc.scope.exit
            fi
            match_ctx.flow_after tc.merge_current_ownership_flow
            if tc.path_continues then
                true = match_ctx.has_continuing_arm
            fi
            if match_ctx.has_continuing_arm then
                match_ctx.flow_after tc.restore_ownership_flow
            else
                match_ctx.flow_before tc.restore_ownership_flow
            fi
            match_ctx.has_continuing_arm = tc.path_continues
            # Record last arm label
            if "" match_ctx MatchContext::current_branch_label.as_str != then
                match_ctx MatchContext::current_branch_label.clone match_ctx MatchContext::branch_records.push
            fi
            # Record last arm stack effect (same logic as next-arm recording)
            if match_ctx MatchContext::condition_present then
                match_ctx MatchContext::before = match_before: mut$TypedStack
                match_ctx MatchContext::after = match_after: mut$TypedStack
                if
                    match_before tc.stack.equals
                    match_after match_before.equals && !
                then
                    tc.store match_after tc.stack.unify_types = last_unified
                    if 0 last_unified.length != match_after match_before.equals ! && then
                        tc.stack match_after.merge_literals
                        match_after.mark_literals_runtime
                        last_unified match_after.set_types
                    elif match_after match_before.equals then
                        tc.stack match_after.restore
                    else
                        op Op::location "Match arms have incompatible stack effects" ErrorKind::StackMismatch tc.diagnostics.record_error
                    fi
                fi
                match_before tc.stack.restore
            fi

            match_ctx MatchContext::match_type = end_match_type: mut$Type
            end_match_type.match_base = end_base

            # Build covered set
            Set[String]::new = covered_set
            for record in match_ctx MatchContext::branch_records.iter do
                if record.as_str "__covered:" str::starts_with then
                    record.as_str 10 record.length 10 - str::substring covered_set.add
                fi
            done
            MATCH_WILDCARD covered_set.has_str = has_wildcard

            # Check exhaustiveness
            if has_wildcard ! then
                if
                    end_base tc
                        .store
                        .enums
                        .get Option::Some(end_enum) is
                then
                    List[String]::new = missing
                    for variant_name in end_enum CasaEnum::variants.iter do
                        if variant_name covered_set.has ! then
                            variant_name.clone missing.push
                        fi
                    done
                    if 0 missing.length != then
                        List[String]::new = formatted_missing
                        for variant_name in missing.iter do
                            f"`{end_base}::{variant_name}`" formatted_missing.push
                        done
                        ", " formatted_missing.join_strings = missing_str
                        op Op::location f"Non-exhaustive match, missing arms: {missing_str}" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                    fi
                fi
            fi
            if
                end_base tc
                    .store
                    .structs
                    .has has_wildcard ! &&
            then
                if end_base covered_set.has ! then
                    op Op::location f"Non-exhaustive match on struct `{end_match_type.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                fi
            fi
            # Literal exhaustiveness
            if
                "bool" end_base.as_str ==
                end_match_type.is_integer_type_t ||
                "char" end_base.as_str == ||
                "str" end_base.as_str == ||
            then
                if has_wildcard ! then
                    if "bool" end_base.as_str == then
                        List[String]::new = bool_missing
                        if "true".to_str covered_set.has ! then
                            "true".to_str bool_missing.push
                        fi
                        if "false".to_str covered_set.has ! then
                            "false".to_str bool_missing.push
                        fi
                        if 0 bool_missing.length != then
                            op Op::location "Non-exhaustive match on `bool`" ErrorKind::TypeMismatch tc.diagnostics.record_error
                        fi
                    else
                        op Op::location f"Non-exhaustive match on type `{end_base}`. A wildcard `_` arm is required" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                    fi
                fi
            fi

            # Apply final stack state
            match_ctx MatchContext::before = final_before: mut$TypedStack
            match_ctx MatchContext::after = final_after: mut$TypedStack
            # When stack == before and before == after, nothing changed
            if final_before tc.stack.equals final_after final_before.equals && then
                return
            fi
            # When stack == before but after differs (e.g. wildcard-only match),
            # accept the after state directly
            if final_before tc.stack.equals final_after final_before.equals ! && then
                final_after tc.stack.restore
                return
            fi
            tc.store final_after tc.stack.unify_types = unified
            if 0 unified.length != then
                tc.stack final_after.merge_literals
                final_after.mark_literals_runtime
                final_after tc.stack.restore
                unified tc.stack.set_types
                return
            fi
            op Op::location "Match arms have incompatible stack effects" ErrorKind::StackMismatch tc.diagnostics.record_error
        fi
    }
}

# ============================================================================
# Check struct new
# ============================================================================

impl TypeChecker {
    fn resolve_aggregate_literal self:mut$TypeChecker value:mut$TypedValue expected:$Type -> Type {
        value.type_value clone_type = actual
        if 0 value.literals.length == then
            actual return
        fi
        if expected.has_unresolved_type_var then
            actual resolve_numeric_literal_default = actual
        else
            expected clone_type = actual
        fi
        self.literal_resolutions self.diagnostics actual value.resolve_literals drop
        actual
    }

    fn expect_aggregate_value
        self:mut$TypeChecker
        expected:$Type
        bindings:mut$Map[String Type]
        origins:Option[List[String]]
    -> Option[List[String]] {
        self.stack_pop_value = value
        bindings expected.substitute_t = current_expected
        current_expected value self.resolve_aggregate_literal = actual

        expected clone_type = binding_expected
        actual clone_type = binding_actual
        if binding_expected.borrow_target Option::Some(target) is then
            target clone_type = binding_expected
            if binding_actual.borrow_target Option::Some(actual_target) is then
                actual_target clone_type = binding_actual
            fi
        fi
        bindings binding_actual binding_expected bind_semantic_type_arguments

        bindings expected.substitute_t = resolved_expected
        resolved_expected value origins merge_destination_origins = origins
        value resolved_expected self.expect_value_type_t
        origins
    }

    fn check_struct_new tc:mut$TypeChecker op:mut$Op {
        op.value clone_op_value match
            OpValue::StructNew(casa_struct) => {
                Map[String Type]::new = bindings
                if op.type_hint Option::Some(hint) is then
                    if casa_struct.name hint.match_base == then
                        casa_struct.type_vars hint aggregate_type_bindings = bindings
                    fi
                fi
                Option[List[String]]::None = origins
                for member in casa_struct CasaStruct::members.iter do
                    origins bindings member.typ tc.expect_aggregate_value = origins
                done
                if 0 casa_struct CasaStruct::type_vars.length != then
                    bindings casa_struct CasaStruct::type_vars casa_struct CasaStruct::name.as_str
                    build_resolved_type
                else
                    casa_struct CasaStruct::name.clone GenericType::new Type::Generic
                fi = result_type
                origins result_type tc.stack_push_origins
            }
            _ => {
            }
        end
    }
}

# ============================================================================
# Check struct literal
# ============================================================================

fn get_struct_literal_shape
    literal:$StructLiteral
    store:$SymbolStore
-> Option[List[String]] List[Type] {
    List[Type]::new = field_types
    if literal.struct_name store.structs.get Option::Some(casa_struct) is then
        for field_name in literal.field_order.iter do
            for member in casa_struct.members.iter do
                if field_name member.name == then
                    member.typ clone_type field_types.push
                    break
                fi
            done
        done
        casa_struct.type_vars.clone Option::Some field_types
    else
        Option[List[String]]::None field_types
    fi
}

impl TypeChecker {
    fn check_struct_literal tc:mut$TypeChecker op:mut$Op {
        if op.value OpValue::StructLiteral(literal) is then
            literal StructLiteral::struct_name.clone = name
            tc.store literal get_struct_literal_shape = field_types = type_variables_opt
            if type_variables_opt Option::Some(type_variables) is then
                Map[String Type]::new = bindings
                if op.type_hint Option::Some(hint) is then
                    if name hint.match_base == then
                        type_variables hint aggregate_type_bindings = bindings
                    fi
                fi
                Option[List[String]]::None = origins
                # Pop field values in reverse order
                field_types.length = index
                while 0 index != do
                    1 -= index
                    origins bindings index field_types.get tc.expect_aggregate_value = origins
                done
                if 0 type_variables.length != then
                    bindings type_variables name.as_str build_resolved_type
                else
                    name GenericType::new Type::Generic
                fi = result_type
                origins result_type tc.stack_push_origins
            else
                name GenericType::new Type::Generic tc.stack_push_type
            fi
        fi
    }
}

# ============================================================================
# Instantiate default trait method for a concrete type
# ============================================================================

fn qualify_default_method_calls
    ops:mut$List[Op]
    trait_type:$Type
    receiver:$Type
    store:mut$SymbolStore
{
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get_mut = body_op
        body_op.value clone_op_value = body_value
        if body_value OpValue::MethodCall(method_name) is then
            store receiver method_name.as_str collect_method_qualifiers = qualifiers
            if
                store method_name.as_str trait_type trait_type_has_method
                qualifiers.length 1 < &&
            then
                method_name.clone trait_type clone_type false QualifiedMethod OpValue::QualifiedMethodCall
                body_op Op::set_value
            fi
        elif body_value OpValue::PushArray(items) is then
            items clone_ops = owned_items
            store receiver trait_type owned_items qualify_default_method_calls
            owned_items OpValue::PushArray body_op Op::set_value
        elif body_value OpValue::ExprGroup(items) is then
            items clone_ops = owned_items
            store receiver trait_type owned_items qualify_default_method_calls
            owned_items OpValue::ExprGroup body_op Op::set_value
        fi
        1 += op_index
    done
}

fn get_default_trait_specialization_parts
    trait_name:$str
    method_name:$str
    store:$SymbolStore
-> Option[TraitMethod] List[String] List[TraitMethod] {
    if trait_name store.traits.get_str Option::Some(casa_trait) is then
        store casa_trait method_name find_semantic_trait_method = default_method
        casa_trait.type_params.clone = type_parameters
        List[TraitMethod]::new = declared_methods
        for method in casa_trait.methods.iter do
            method clone_trait_method declared_methods.push
        done
        default_method type_parameters declared_methods
    else
        Option[TraitMethod]::None List[String]::new List[TraitMethod]::new
    fi
}

fn instantiate_default_trait_method
    semantics:MethodSemantics
    receiver:$Type
    store:mut$SymbolStore
    diagnostics:mut$Diagnostics
-> Option[String] {
    semantics.function_name.clone = receiver_key
    if receiver_key.as_str store.functions.has_str then
        receiver_key.clone Option::Some return
    fi
    store semantics.method_name.as_str semantics.trait_name.as_str get_default_trait_specialization_parts
    = declared_methods = type_params = default_method_opt
    if default_method_opt Option::None is then
        Option[String]::None return
    fi
    default_method_opt.unwrap = default_method

    # Check that receiver implements all abstract methods
    List[Type]::new = required_trait_arguments
    for type_parameter in type_params.iter do
        type_parameter.clone Type::TypeVar required_trait_arguments.push
    done
    required_trait_arguments semantics.trait_name.clone GenericType Type::Generic
    = required_trait_type
    if semantics.trait_type Option::Some(resolved_trait_type) is then
        resolved_trait_type clone_type = required_trait_type
    fi
    if store required_trait_type receiver type_has_semantic_trait_shape ! then
        Option[String]::None return
    fi

    # Determine function name and whether to use generic or concrete form
    receiver.base = fn_base_opt
    semantics.function_name = synth_fn_name: $String

    # For generic receivers, keep trait type params as function type vars.
    # For non-generic receivers, substitute trait type params with concrete types.
    Map[String Type]::new = trait_subs
    receiver clone_type = default_self_type
    empty_stack_effect = resolved_stack_effect
    if fn_base_opt Option::Some(base_name) is then
        List[Type]::new = default_type_params
        for type_param in type_params.iter do
            type_param.clone Type::TypeVar default_type_params.push
        done
        default_type_params base_name.clone GenericType Type::Generic = default_self_type
        default_self_type default_method TraitMethod::stack_effect resolve_trait_stack_effect = resolved_stack_effect
    else
        if semantics.trait_type Option::Some(resolved_trait_type) is then
            if resolved_trait_type.type_params Option::Some(trait_args) is then
                for pair in trait_args.iter type_params.iter.zip do
                    pair.second clone_type pair.first.clone trait_subs.set
                done
            fi
        fi
        # Infer trait type params from concrete method stack effects
        Set[String]::new = type_param_set
        for type_param in type_params.iter do
            type_param.clone type_param_set.add
        done
        for infer_method in declared_methods.iter do
            if 0 infer_method TraitMethod::default_ops.length == then
                store Option[Function]::None receiver infer_method TraitMethod::name.as_str
                resolve_method_semantics = infer_method_opt
                Option[CheckedFunction]::None = infer_fn_opt
                if infer_method_opt Option::Some(infer_semantics) is then
                    diagnostics store infer_semantics.function_name.as_str ensure_typechecked = infer_fn_opt
                fi
                if infer_fn_opt.is_some then
                    infer_fn_opt.unwrap = infer_fn
                    receiver infer_method TraitMethod::stack_effect resolve_trait_stack_effect = infer_trait_resolved
                    0 (u64) = ret_index
                    while
                        ret_index infer_trait_resolved StackEffect::return_types.length > ret_index infer_fn.stack_effect StackEffect::return_types.length > &&
                    do
                        type_param_set ret_index infer_fn.stack_effect StackEffect::return_types.get ret_index infer_trait_resolved StackEffect::return_types.get trait_subs bind_generic_params_standalone = trait_subs
                        1 += ret_index
                    done
                fi
            fi
        done
        trait_subs receiver default_method TraitMethod::stack_effect resolve_trait_stack_effect apply_type_subs_to_stack_effect = resolved_stack_effect
    fi

    # Add trait type params as function type vars for generic receivers
    if fn_base_opt.is_some then
        for type_param in type_params.iter do
            type_param.clone resolved_stack_effect StackEffect::type_vars.add
        done
    fi

    default_self_type clone_type TRAIT_SELF_TYPE trait_subs.set_str

    # Add method-level type vars to stack effect
    for method_type_var in default_method TraitMethod::type_vars.iter do
        method_type_var.clone resolved_stack_effect StackEffect::type_vars.add
    done

    # Build function ops: parameter assignments + cloned body
    List[Op]::new = synth_ops
    List[Variable]::new = synth_vars
    for synth_param in resolved_stack_effect StackEffect::parameters.iter do
        if "" synth_param Parameter::name.as_str != then
            synth_param Parameter::typ clone_type synth_param Parameter::name.clone Variable synth_vars.push
            empty_location synth_param Parameter::name.clone OpValue::AssignVar Op::new synth_ops.push
        fi
    done

    default_method TraitMethod::default_ops clone_ops = cloned_body
    if 0 trait_subs.length != then
        trait_subs cloned_body substitute_ops_types
    fi
    if semantics.trait_type Option::Some(default_trait_type) is then
        store receiver default_trait_type cloned_body qualify_default_method_calls
    fi
    0 (u64) = cloned_lambda_index
    0 (u64) = body_index
    while body_index cloned_body.length > do
        body_index cloned_body.get_mut = body_op
        1 += body_index
        if body_op.value OpValue::FnPush(lambda_name) is then
            if lambda_name.as_str "lambda__" str::starts_with ! then
                continue
            fi
            lambda_name.as_str store.functions.get_str = lambda_opt
            if lambda_opt.is_none then
                continue
            fi
            lambda_opt.unwrap.clone_for_import = lambda

            f"{lambda_name}__{synth_fn_name}_{cloned_lambda_index}" = cloned_lambda_name
            # The specialization mutates its cloned body and declaration independently.
            lambda.split_body = lambda_ops = lambda
            if 0 trait_subs.length != then
                trait_subs lambda_ops substitute_ops_types
            fi
            if semantics.trait_type Option::Some(default_trait_type) is then
                store receiver default_trait_type lambda_ops qualify_default_method_calls
            fi
            List[Parameter]::new = lambda_params
            List[Type]::new = lambda_returns
            lambda_returns lambda_params StackEffect::new = lambda_effect
            for lambda_type_var in resolved_stack_effect StackEffect::type_vars.iter do
                lambda_type_var.clone lambda_effect StackEffect::type_vars.add
            done
            lambda_effect lambda Function::location.clone lambda_ops cloned_lambda_name.clone Function::with_stack_effect = cloned_lambda
            lambda.variables.clone cloned_lambda Function::set_variables
            lambda.captures.clone cloned_lambda Function::set_captures
            lambda.global_captures.clone cloned_lambda Function::set_global_captures
            lambda.captures_by_move cloned_lambda Function::set_captures_by_move
            lambda.captures_shared cloned_lambda Function::set_captures_shared
            0 (u64) = lambda_op_index
            while lambda_op_index cloned_lambda.ops.length > do
                lambda_op_index cloned_lambda.ops.get = lambda_op
                if lambda_op.value OpValue::PushCapture(capture_name) is then
                    if capture_name.as_str cloned_lambda.captures variable_list_contains ! then
                        capture_name.as_str Variable::new cloned_lambda.captures.push
                    fi
                fi
                1 += lambda_op_index
            done
            for
                type_var_name in resolved_stack_effect
                    .type_vars
                    .to_list
                    .iter
            do
                type_var_name.clone Type::TypeVar = type_var
                type_var make_hidden_drop_parameter_name = hidden_drop
                if hidden_drop.as_str cloned_lambda.captures variable_list_contains ! then
                    TYPE_U64_T clone_type hidden_drop Variable cloned_lambda.captures.push
                fi
            done
            cloned_lambda cloned_lambda_name.clone store.functions.set
            cloned_lambda_name OpValue::FnPush body_op Op::set_value
            1 += cloned_lambda_index
        fi
    done
    cloned_body synth_ops.append

    # Create, register, and typecheck the function
    resolved_stack_effect empty_location synth_ops synth_fn_name.clone Function::with_stack_effect = synth_fn
    synth_vars synth_fn Function::set_variables
    true synth_fn Function::set_is_used
    synth_fn synth_fn_name.clone store.functions.set
    diagnostics store synth_fn_name.as_str ensure_typechecked drop

    synth_fn_name.clone Option::Some
}

impl TypeChecker {
    fn apply_trait_bound_method_semantics
        tc:mut$TypeChecker
        semantics:MethodSemantics
        receiver:$Type
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    -> u64 {
        tc.stack_pop_drop
        receiver tc.stack_push_type
        semantics.method_name.as_str receiver.make_method_key = method_key
        function_opt Option[Type]::None method_key.as_str semantics.stack_effect tc.apply_stack_effect
        op.location.clone semantics.function_name.clone OpValue::PushVar Op::new = push_op
        op_index 1 - push_op ops.insert
        OpValue::FnExec op Op::set_value
        op_index 1 +
    }
}

# ============================================================================
# Check method call
# ============================================================================

impl TypeChecker {
    fn check_char_codepoint tc:mut$TypeChecker op:mut$Op method_name:$str -> bool {
        if "codepoint" method_name.as_str != then
            false return
        fi
        tc.stack_pop_value = value
        if value.type_value TYPE_CHAR_T.eq ! then
            op.location f"Method `codepoint` requires `char`, got `{value.type_value.format}`" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        fi
        BuiltinType::U32 BuiltinType::Char NumericConversionKind::ToBits NumericConversion
        OpValue::NumericConvert op Op::set_value
        TYPE_U32_T clone_type Option::Some op Op::set_type_hint
        TYPE_U32_T tc.stack_push_type
        true
    }

    fn check_try_integer_method tc:mut$TypeChecker op:mut$Op method_name:$str -> bool {
        if
            "try_add" method_name.as_str ==
            "try_sub" method_name.as_str == ||
            "try_mul" method_name.as_str == ||
            "try_div" method_name.as_str == ||
            "try_mod" method_name.as_str == || !
        then
            false return
        fi
        tc.stack_pop_value = receiver
        receiver tc.stack_pop_left_like = other
        TYPE_I64_T clone_type = target_type
        if receiver.type_value.is_integer_type_t then
            receiver.type_value clone_type = target_type
        elif other.type_value.is_integer_type_t then
            other.type_value clone_type = target_type
        fi
        if target_type Type::Builtin(target) is then
            target_type receiver tc.resolve_integer_value drop
            target_type other tc.resolve_integer_value drop
            method_name.clone match
                "try_add" => IntegerTryKind::Add
                "try_sub" => IntegerTryKind::Sub
                "try_mul" => IntegerTryKind::Mul
                "try_div" => IntegerTryKind::Div
                _ => IntegerTryKind::Mod
            end = kind
            target kind IntegerTry OpValue::IntegerTry op Op::set_value
            target_type clone_type Option::Some op Op::set_type_hint
            List[Type]::new = option_params
            target_type clone_type option_params.push
            option_params "Option".to_str GenericType Type::Generic tc.stack_push_type
            true return
        fi
        f"Method requires integer operands, got `{receiver.type_value.format}` and `{other.type_value.format}`" tc.raise_type_mismatch
        TYPE_UNKNOWN_T tc.stack_push_type
        true
    }

    fn check_float_round tc:mut$TypeChecker op:mut$Op method_name:$str -> bool {
        if
            "__float_floor" method_name.as_str ==
            "__float_ceil" method_name.as_str == ||
            "__float_trunc" method_name.as_str == ||
            "__float_round" method_name.as_str == || !
        then
            false return
        fi
        tc.stack_pop_value = value
        if value.type_value Type::Builtin(target) is then
            if target.is_float then
                target (i64) = target_value
                target_value (BuiltinType) method_name.to_str FloatRound = rounding
                rounding OpValue::FloatRound op Op::set_value
                target_value (BuiltinType) Type::Builtin Option::Some op Op::set_type_hint
                target_value (BuiltinType) Type::Builtin tc.stack_push_type
                true return
            fi
        fi
        op.location f"Method `{method_name}` requires `f32` or `f64`" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        TYPE_UNKNOWN_T tc.stack_push_type
        true
    }

    fn check_wrapping_method tc:mut$TypeChecker op:mut$Op method_name:$str -> bool {
        if
            "wrapping_add" method_name.as_str ==
            "wrapping_sub" method_name.as_str == ||
            "wrapping_mul" method_name.as_str == || !
        then
            false return
        fi
        tc.stack_pop_value = receiver
        receiver tc.stack_pop_left_like = other
        TYPE_I64_T clone_type = target
        if receiver.type_value.is_integer_type_t then
            receiver.type_value clone_type = target
        elif other.type_value.is_integer_type_t then
            other.type_value clone_type = target
        fi
        if target.is_integer_type_t ! then
            f"Method requires integer operands, got `{receiver.type_value.format}` and `{other.type_value.format}`" tc.raise_type_mismatch
            false return
        fi
        target receiver tc.resolve_integer_value drop
        target other tc.resolve_integer_value drop
        if "wrapping_add" method_name.as_str == then
            OpValue::WrappingAdd op Op::set_value
        elif "wrapping_sub" method_name.as_str == then
            OpValue::WrappingSub op Op::set_value
        else
            OpValue::WrappingMul op Op::set_value
        fi
        target clone_type Option::Some op Op::set_type_hint
        target tc.stack_push_type
        true
    }

    fn check_method_call
        tc:mut$TypeChecker
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    -> u64 {
        Option[String]::None = method_name_opt
        op.value clone_op_value = method_value
        if method_value OpValue::MethodCall(method_name) is then
            method_name.clone Option::Some = method_name_opt
        elif method_value OpValue::QualifiedMethodCall(qualified) is then
            qualified.method_name.clone Option::Some = method_name_opt
        fi
        if method_name_opt Option::Some(method_name) is then
            if "drop" method_name.as_str == then
                op.location "Reserved `drop` methods cannot be called directly; use the `drop` intrinsic" ErrorKind::InvalidScope tc.diagnostics.record_error
            fi
            tc.stack_peek_type = receiver
            ValueCapability::Owned = receiver_capability
            if
                0 tc
                    .stack
                    .values
                    .length !=
            then
                tc
                    .stack
                    .values
                    .length 1 - tc
                    .stack
                    .values
                    .get
                    .capability = receiver_capability
            fi
            receiver clone_type = lookup_receiver
            if
                receiver.is_shared_borrow
                receiver_capability ValueCapability::Exclusive is &&
            then
                receiver.borrow_target.unwrap clone_type = receiver_target
                EXCLUSIVE_BORROW_TYPE receiver_target apply_borrow_type = lookup_receiver
            elif receiver.is_borrow ! then
                if receiver_capability ValueCapability::Shared is then
                    SHARED_BORROW_TYPE receiver clone_type apply_borrow_type = lookup_receiver
                elif receiver_capability ValueCapability::Exclusive is then
                    EXCLUSIVE_BORROW_TYPE receiver clone_type apply_borrow_type = lookup_receiver
                fi
            fi
            if "clone" method_name.as_str == then
                op.location lookup_receiver tc.ensure_function_clone_method
            fi
            if method_value OpValue::MethodCall is then
                if method_name.as_str op tc.check_float_to_bits then
                    op_index return
                fi
                if method_name.as_str op tc.check_char_codepoint then
                    op_index return
                fi
                if method_name.as_str op tc.check_float_round then
                    op_index return
                fi
                if method_name.as_str op tc.check_try_integer_method then
                    op_index return
                fi
                if method_name.as_str op tc.check_wrapping_method then
                    op_index return
                fi
            fi
            method_value clone_op_value = analyzed_method_value
            tc.store function_opt lookup_receiver make_type_borrow_option analyzed_method_value
            analyze_operation = semantics
            semantics.into_method match
                Option::Some(method_semantics) => {
                    method_name.as_str receiver_capability method_semantics.stack_effect
                    tc.check_method_receiver_capability
                    if method_semantics.kind MethodSemanticsKind::TraitBound is then
                        function_opt op_index ops op receiver method_semantics
                        tc.apply_trait_bound_method_semantics return
                    fi
                    method_semantics.function_name.clone = fn_name
                    if method_semantics.kind MethodSemanticsKind::DefaultMethod is then
                        tc.diagnostics tc.store receiver method_semantics
                        instantiate_default_trait_method = default_inst_opt
                        if default_inst_opt Option::Some(default_name) is then
                            default_name.clone = fn_name
                        fi
                    fi
                    tc.diagnostics tc.store fn_name.as_str ensure_typechecked = checked_function_opt
                    checked_function_opt match
                        Option::Some(function) => {
                            function.into_parts = is_unsafe = effect
                            if is_unsafe then
                                fn_name.as_str op tc.require_unsafe
                            fi
                            if effect needs_hidden_arguments then
                                Option[Type]::None function_opt op Op::location op_index ops effect
                                tc.inject_trait_fn_ptrs += op_index
                            fi
                            function_opt op.type_hint.clone fn_name.as_str effect tc.apply_stack_effect
                            fn_name OpValue::FnCall op Op::set_value
                            op_index return
                        }
                        Option::None => {
                        }
                    end
                }
                Option::None => {
                }
            end
            method_name.as_str receiver.make_method_key = missing_name
            tc.store receiver method_name.as_str collect_method_qualifiers = qualifiers
            if qualifiers.length 1 < then
                ", " qualifiers.join_strings = qualifier_list
                op.location f"Method `{missing_name}` is ambiguous between `{qualifier_list}`. Use a trait-qualified call"
                ErrorKind::TraitSignatureMismatch tc.diagnostics.record_error_string
            else
                op.location f"Method `{missing_name}` does not exist"
                ErrorKind::UndefinedName tc.diagnostics.record_error_string
            fi
        fi
        op_index
    }
}

# ============================================================================
# Check f-string expression conversion (Display trait dispatch)
# ============================================================================

impl TypeChecker {
    fn check_fstring_to_str
        tc:mut$TypeChecker
        op:mut$Op
        ops:mut$List[Op]
        op_index:u64
        function_opt:mut$Option[Function]
    -> u64 {
        "value with trait `Display`".to_str = tc.current_expect_ctx
        tc.stack_peek_type = fstring_type_t
        fstring_type_t clone_type = fstring_value_type
        if fstring_value_type.borrow_target Option::Some(target) is then
            target clone_type = fstring_value_type
        fi
        if TYPE_STRING_T fstring_value_type.eq then
            tc
                .stack
                .values
                .length 1 - tc
                .stack
                .values
                .get = string_value
            if string_value.capability ValueCapability::Owned is then
                op_index return
            fi
            "clone".to_str OpValue::MethodCall op Op::set_value
            function_opt op_index ops op tc.check_method_call return
        fi
        if TYPE_STR_T fstring_value_type.eq then
            "to_str".to_str OpValue::MethodCall op Op::set_value
            function_opt op_index ops op tc.check_method_call return
        fi
        fstring_type_t.format = fstring_type
        if TYPE_MISSING fstring_type.as_str == TYPE_UNKNOWN fstring_type.as_str == || then
            tc.stack_pop_drop
            TYPE_STRING_T tc.stack_push_type
            op_index return
        fi
        if fstring_type_t Type::Builtin(builtin) is then
            if
                builtin.is_integer
                builtin BuiltinType::Bool == ||
                builtin BuiltinType::Char == ||
                builtin BuiltinType::Cstr == ||
            then
                builtin OpValue::PrimitiveToStr op Op::set_value
                tc.stack_pop_drop
                TYPE_STRING_T tc.stack_push_type
                op_index return
            fi
        fi
        tc.store function_opt fstring_type_t make_type_borrow_option op.value
        analyze_operation = semantics
        "Display".to_str GenericType::new Type::Generic = display_type
        if tc.diagnostics tc.store function_opt display_type fstring_type_t type_satisfies_trait ! then
            op Op::location f"Type `{fstring_type}` cannot be used in f-string: does not satisfy trait `Display`" ErrorKind::MissingTraitMethod tc.diagnostics.record_error_string
            tc.stack_pop_drop
            TYPE_STRING_T tc.stack_push_type
            op_index return
        fi
        if semantics.method Option::Some(method) is then
            method.method_name.clone OpValue::MethodCall op Op::set_value
        else
            "to_str".to_str OpValue::MethodCall op Op::set_value
        fi
        function_opt op_index ops op tc.check_method_call
    }
}

# ============================================================================
# Ensure a function is typechecked
# ============================================================================

fn add_hidden_layout_parameter
    name:String
    hidden_parameters:mut$List[Parameter]
    variables:mut$List[Variable]
    assignments:mut$List[Op]
    seen:mut$Set[String]
    location:$Location
{
    if name.as_str seen.has_str then
        return
    fi
    name.clone seen.add
    name.clone TYPE_U64_T Parameter::named hidden_parameters.push
    TYPE_U64_T clone_type name.clone Variable variables.push
    location.clone name.clone OpValue::AssignVar Op::new = assignment
    TYPE_U64_T clone_type Option::Some assignment Op::set_type_hint
    assignment assignments.push
}

fn add_hidden_drop_parameters
    typ:$Type
    store:$SymbolStore
    hidden_parameters:mut$List[Parameter]
    variables:mut$List[Variable]
    assignments:mut$List[Op]
    seen:mut$Set[String]
    visiting:mut$Set[String]
    location:$Location
{
    if typ.is_shared_borrow then
        return
    fi
    if typ.borrow_target Option::Some(target) is then
        location visiting seen assignments variables hidden_parameters store target
        add_hidden_drop_parameters
        return
    fi
    typ clone_type = inspected_type
    inspected_type match
        Type::TypeVar(_) => {
            typ make_hidden_drop_parameter_name = hidden_drop
            location seen assignments variables hidden_parameters hidden_drop
            add_hidden_layout_parameter
        }
        Type::Generic(generic) => {
            typ.format = type_name
            if type_name.as_str visiting.has_str then
                return
            fi
            type_name.clone visiting.add
            f"{typ.match_base}::drop" = drop_name
            if drop_name.as_str store.functions.has_str then
                for parameter in generic.params.iter do
                    location visiting seen assignments variables hidden_parameters store parameter
                    add_hidden_drop_parameters
                done
            elif ARRAY_TYPE generic.base.as_str == then
                if 0 generic.params.length != then
                    location visiting seen assignments variables hidden_parameters store
                    0 generic.params.get add_hidden_drop_parameters
                fi
            elif generic.base.as_str store.structs.get_str Option::Some(casa_struct) is then
                casa_struct.type_vars typ aggregate_type_bindings = substitutions
                for member in casa_struct.members.iter do
                    substitutions member.typ.substitute_t = member_type
                    location visiting seen assignments variables hidden_parameters store member_type
                    add_hidden_drop_parameters
                done
            elif generic.base.as_str store.enums.get_str Option::Some(casa_enum) is then
                casa_enum.type_vars typ aggregate_type_bindings = substitutions
                for pair in casa_enum.variant_types.iter do
                    for payload_type in pair.second.iter do
                        substitutions payload_type.substitute_t = resolved_payload
                        location visiting seen assignments variables hidden_parameters store resolved_payload
                        add_hidden_drop_parameters
                    done
                done
            fi
            type_name.as_str visiting.remove_str
        }
        _ => {
        }
    end
}

fn rewrite_generic_size_queries
    ops:mut$List[Op]
    hidden_parameters:mut$List[Parameter]
    variables:mut$List[Variable]
    assignments:mut$List[Op]
    seen:mut$Set[String]
    location:$Location
{
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get_mut = op
        op.value clone_op_value = query_value
        if query_value OpValue::SizeOf(target) is then
            if target.has_unresolved_type_var then
                target make_hidden_size_parameter_name = hidden_name
                location seen assignments variables hidden_parameters hidden_name.clone
                add_hidden_layout_parameter
                hidden_name OpValue::PushVar op Op::set_value
            fi
        elif query_value OpValue::PtrRead(target) is then
            if target.has_unresolved_type_var then
                target make_hidden_size_parameter_name = hidden_size
                location seen assignments variables hidden_parameters hidden_size
                add_hidden_layout_parameter
                target make_hidden_repr_parameter_name = hidden_repr
                location seen assignments variables hidden_parameters hidden_repr
                add_hidden_layout_parameter
            fi
        elif query_value OpValue::PtrWrite(target) is then
            if target.has_unresolved_type_var then
                target make_hidden_size_parameter_name = hidden_size
                location seen assignments variables hidden_parameters hidden_size
                add_hidden_layout_parameter
                target make_hidden_repr_parameter_name = hidden_repr
                location seen assignments variables hidden_parameters hidden_repr
                add_hidden_layout_parameter
            fi
        elif query_value OpValue::PtrAsRef(target) is then
            if target.has_unresolved_type_var then
                target make_hidden_size_parameter_name = hidden_size
                location seen assignments variables hidden_parameters hidden_size
                add_hidden_layout_parameter
                target make_hidden_repr_parameter_name = hidden_repr
                location seen assignments variables hidden_parameters hidden_repr
                add_hidden_layout_parameter
            fi
        elif query_value OpValue::PtrAsMut(target) is then
            if target.has_unresolved_type_var then
                target make_hidden_size_parameter_name = hidden_size
                location seen assignments variables hidden_parameters hidden_size
                add_hidden_layout_parameter
                target make_hidden_repr_parameter_name = hidden_repr
                location seen assignments variables hidden_parameters hidden_repr
                add_hidden_layout_parameter
            fi
        elif query_value OpValue::PushArray(items) is then
            items clone_ops = owned_items
            location seen assignments variables hidden_parameters owned_items rewrite_generic_size_queries
            owned_items OpValue::PushArray op Op::set_value
        elif query_value OpValue::ExprGroup(items) is then
            items clone_ops = owned_items
            location seen assignments variables hidden_parameters owned_items rewrite_generic_size_queries
            owned_items OpValue::ExprGroup op Op::set_value
        elif query_value OpValue::MatchArm(arm) is then
            arm.clone = rewritten_arm
            location seen assignments variables hidden_parameters rewritten_arm.guard_ops
            rewrite_generic_size_queries
            rewritten_arm OpValue::MatchArm op Op::set_value
        fi
        1 += op_index
    done
}

fn prepare_generic_size_queries function:mut$Function {
    List[Parameter]::new = hidden_parameters
    List[Op]::new = assignments
    Set[String]::new = seen
    for
        existing_parameter in function
            .stack_effect
            .parameters
            .iter
    do
        existing_parameter.name.as_str HIDDEN_SIZE_PREFIX str::starts_with = is_size
        existing_parameter.name.as_str HIDDEN_REPR_PREFIX str::starts_with = is_repr
        existing_parameter.name.as_str HIDDEN_DROP_PREFIX str::starts_with = is_drop
        if is_size is_repr || is_drop || then
            existing_parameter.name.clone seen.add
        fi
    done
    function.location seen assignments function.variables hidden_parameters function.ops
    rewrite_generic_size_queries
    List[Type]::new = signature_types
    for
        parameter in function
            .stack_effect
            .parameters
            .iter
    do
        parameter.typ clone_type signature_types.push
    done
    for
        return_type in function
            .stack_effect
            .return_types
            .iter
    do
        return_type clone_type signature_types.push
    done
    0 (u64) = signature_index
    while signature_index signature_types.length > do
        signature_index signature_types.get clone_type = parameter_type
        1 += signature_index
        if parameter_type.borrow_target Option::Some(target) is then
            target clone_type = parameter_type
        fi
        if parameter_type Type::Generic(storage_type) is then
            storage_type.base.as_str ARRAY_TYPE ==
            storage_type.base.as_str "List" == ||
            storage_type.base.as_str "Slice" == ||
            storage_type.base.as_str "Map" == ||
            storage_type.base.as_str "Set" == ||
            = carries_inline_values
            if carries_inline_values ! then
                for nested_type in storage_type.params.iter do
                    nested_type clone_type signature_types.push
                done
                continue
            fi
            storage_type.params.length = element_count
            if ARRAY_TYPE storage_type.base.as_str == then
                1 (u64) = element_count
            fi
            0 (u64) = element_index
            while element_index element_count > do
                element_index storage_type.params.get = element_type
                if element_type.has_unresolved_type_var ! then
                    1 += element_index
                    continue
                fi
                element_type make_hidden_size_parameter_name = hidden_size
                function.location seen assignments function.variables hidden_parameters hidden_size
                add_hidden_layout_parameter
                element_type make_hidden_repr_parameter_name = hidden_repr
                function.location seen assignments function.variables hidden_parameters hidden_repr
                add_hidden_layout_parameter
                1 += element_index
            done
        fi
    done
    if 0 hidden_parameters.length == then
        return
    fi
    for
        parameter in function
            .stack_effect
            .parameters
            .iter
    do
        parameter.name.clone parameter.typ clone_type Parameter hidden_parameters.push
    done
    hidden_parameters function.stack_effect StackEffect::set_parameters
    while assignments.is_empty ! do
        0 assignments.pop function.ops.insert
    done
}

struct CheckedFunction {
    stack_effect: StackEffect
    is_unsafe:    bool
}

impl CheckedFunction {
    fn into_parts self:CheckedFunction -> StackEffect bool {
        self match
            CheckedFunction { stack_effect: stack_effect is_unsafe: is_unsafe } => stack_effect is_unsafe
        end
    }
}

fn checked_function_summary function:$Function -> CheckedFunction {
    CheckedFunction { stack_effect: function.stack_effect.clone is_unsafe: function.is_unsafe }
}

fn ensure_typechecked
    function_name:$str
    store:mut$SymbolStore
    diagnostics:mut$Diagnostics
-> Option[CheckedFunction] {
    if function_name store.functions.get_str Option::Some(existing) is then
        if existing.is_typechecked then
            existing checked_function_summary Option::Some return
        fi
    fi
    function_name store.functions.remove_str = function_opt
    if function_opt.is_none then
        Option[CheckedFunction]::None return
    fi
    function_opt.unwrap = function
    if function Function::is_typechecked then
        function checked_function_summary = summary
        function function_name.clone store.functions.set_str
        summary Option::Some return
    fi
    function prepare_generic_size_queries
    true function Function::set_is_typechecked
    function.split_body = function_ops = function
    function.clone_declaration function_name.clone store.functions.set_str
    diagnostics function function_ops store resolve_identifiers
    function Option::Some = active_function
    diagnostics store active_function function_ops check_ops = inferred_stack_effect
    active_function.unwrap = function
    function_ops function Function::set_ops
    function Function::stack_effect stack_effect_to_str = effect_text
    if effect_text.as_str "None -> None" == then
        if function.name.as_str "lambda__" str::starts_with then
            inferred_stack_effect function Function::set_stack_effect
        else
            Map[String StackEffect]::new = inferred_effects
            store inferred_effects function analyze_function_semantics
            = semantics
            semantics.inferred_effect.clone function Function::set_stack_effect
        fi
    fi
    function checked_function_summary = summary
    function function_name.clone store.functions.set_str
    summary Option::Some
}

# ============================================================================
# Main type check dispatch
# ============================================================================

impl TypeChecker {
    fn check_copy_operation tc:mut$TypeChecker op:mut$Op function_opt:mut$Option[Function] {
        tc
            .stack
            .values
            .length = depth
        0 (u64) = copied_index
        if op.value OpValue::Over is then
            if depth 2 < then
                function_opt op tc.apply_fixed_semantics return
            fi
            depth 2 - = copied_index
        else
            if 0 depth == then
                function_opt op tc.apply_fixed_semantics return
            fi
            depth 1 - = copied_index
        fi
        copied_index tc
            .stack
            .values
            .get = copied_value
        copied_value.type_value clone_type = copied_type
        if copied_type.is_borrow ! then
            if copied_value.capability ValueCapability::Shared is then
                SHARED_BORROW_TYPE copied_type clone_type apply_borrow_type = copied_type
            elif copied_value.capability ValueCapability::Exclusive is then
                EXCLUSIVE_BORROW_TYPE copied_type clone_type apply_borrow_type = copied_type
            fi
        fi
        copied_type clone_type = copy_check_type
        if op.value OpValue::Copy is then
            if copy_check_type.borrow_target Option::Some(target) is then
                target clone_type = copy_check_type
            fi
        fi
        copy_check_type resolve_numeric_literal_default = copy_check_type
        if function_opt copy_check_type tc.type_is_duplicable ! then
            op.location f"Type `{copied_type.format}` does not satisfy trait `Copy`" ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        fi
        function_opt op tc.apply_fixed_semantics
    }

    fn run_type_check_ops
        checker:mut$TypeChecker
        ops:mut$List[Op]
        function_opt:mut$Option[Function]
    {
        0 (u64) = op_index
        while op_index ops.length > do
            checker.current_location.clone OpValue::OwnerCleanup Op::new
            op_index ops.replace = current_op
            current_op checker.assign_op_id
            1 += op_index
            current_op Op::location.clone = checker.current_location
            "".to_str = checker.current_expect_ctx
            false = checker.underflow_reported_this_op
            if current_op.value OpValue::UnsafeStart is then
                1 += checker.unsafe_depth
                current_op op_index 1 - ops.set
                continue
            fi
            if current_op.value OpValue::UnsafeEnd is then
                if 0 checker.unsafe_depth != then
                    1 -= checker.unsafe_depth
                fi
                current_op op_index 1 - ops.set
                continue
            fi
            if current_op.value OpValue::Question is then
                function_opt op_index ops current_op checker.lower_question_operator
                current_op op_index 1 - ops.set
                continue
            fi
            if current_op.value OpValue::QuestionMove is then
                current_op checker.consume_question_owner
                current_op op_index 1 - ops.set
                continue
            fi
            if
                current_op.value OpValue::Dup is
                current_op.value OpValue::Over is ||
                current_op.value OpValue::Copy is ||
            then
                function_opt current_op checker.check_copy_operation
                current_op op_index 1 - ops.set
                continue
            fi
            if
                current_op.value OpValue::Add is
                current_op.value OpValue::Sub is ||
                current_op.value OpValue::Mul is ||
                current_op.value OpValue::Div is ||
                current_op.value OpValue::Mod is ||
                current_op.value OpValue::Shl is ||
                current_op.value OpValue::Shr is ||
                current_op.value OpValue::BitAnd is ||
                current_op.value OpValue::BitOr is ||
                current_op.value OpValue::BitXor is ||
                current_op.value OpValue::BitNot is ||
            then
                current_op checker.check_integer_operation
                current_op op_index 1 - ops.set
                continue
            fi
            if current_op.value OpValue::Drop is then
                current_op checker.check_stack_ops
                current_op op_index 1 - ops.set
                continue
            fi
            if current_op.value operation_uses_fixed_typecheck_effect then
                function_opt current_op checker.apply_fixed_semantics
                current_op op_index 1 - ops.set
                continue
            fi
            if current_op.value OpValue::NumericCall is then
                current_op checker.check_numeric_call
                current_op op_index 1 - ops.set
                continue
            fi
            # Comparison
            if current_op.value operation_is_comparison then
                function_opt op_index ops current_op checker.check_comparison = op_index
                current_op op_index 1 - ops.set
                continue
            fi

            # Memory
            if current_op.value operation_is_memory then
                function_opt current_op checker.check_memory
                current_op op_index 1 - ops.set
                continue
            fi

            # Assignment
            if
                current_op.value OpValue::AssignVar is
                current_op.value OpValue::AssignDec is ||
                current_op.value OpValue::AssignInc is ||
            then
                function_opt op_index ops current_op checker.check_assignment
                current_op op_index 1 - ops.set
                continue
            fi

            # Push variable / capture
            if
                current_op.value OpValue::PushVar is
                current_op.value OpValue::PushCapture is ||
            then
                function_opt current_op checker.check_push_var
                current_op op_index 1 - ops.set
                continue
            fi

            # If block
            if
                current_op.value OpValue::IfStart is
                current_op.value OpValue::IfCondition is ||
                current_op.value OpValue::IfElif is ||
                current_op.value OpValue::IfElse is ||
                current_op.value OpValue::IfEnd is ||
            then
                current_op checker.check_if_block
                current_op op_index 1 - ops.set
                continue
            fi

            # While block
            if
                current_op.value OpValue::WhileStart is
                current_op.value OpValue::WhileCondition is ||
                current_op.value OpValue::WhileBreak is ||
                current_op.value OpValue::WhileContinue is ||
                current_op.value OpValue::WhileEnd is ||
            then
                current_op checker.check_while_block
                current_op op_index 1 - ops.set
                continue
            fi

            # Function ops
            if
                current_op.value OpValue::FnCall is
                current_op.value OpValue::FnExec is ||
                current_op.value OpValue::FnExecOwned is ||
                current_op.value OpValue::FnPush is ||
                current_op.value OpValue::FnReturn is ||
            then
                function_opt op_index ops current_op checker.check_function_ops = op_index
                current_op op_index 1 - ops.set
                continue
            fi

            # Literals
            if
                current_op.value OpValue::PushInt is
                current_op.value OpValue::PushFloat is ||
                current_op.value OpValue::PushArray is ||
                current_op.value OpValue::ExprGroup is ||
            then
                function_opt current_op checker.check_literals
                current_op op_index 1 - ops.set
                continue
            fi

            # IO
            if current_op.value OpValue::Print is then
                function_opt op_index ops current_op checker.check_io = op_index
                current_op op_index 1 - ops.set
                continue
            fi

            # Typeof
            if current_op.value OpValue::Typeof is then
                current_op checker.check_typeof
                current_op op_index 1 - ops.set
                continue
            fi

            if current_op.value OpValue::SizeOf(target_type) is then
                current_op.location function_opt target_type checker.validate_type_exists
                if
                    target_type.has_unresolved_type_var !
                    checker.store target_type type_inline_size.is_none &&
                then
                    current_op.location f"Cannot determine inline size of `{target_type.format}`"
                    ErrorKind::TypeMismatch checker.diagnostics.record_error_string
                fi
                TYPE_U64_T checker.stack_push_type
                current_op op_index 1 - ops.set
                continue
            fi

            # Syscalls
            if
                current_op.value OpValue::Syscall0 is
                current_op.value OpValue::Syscall1 is ||
                current_op.value OpValue::Syscall2 is ||
                current_op.value OpValue::Syscall3 is ||
                current_op.value OpValue::Syscall4 is ||
                current_op.value OpValue::Syscall5 is ||
                current_op.value OpValue::Syscall6 is ||
            then
                function_opt current_op checker.check_syscalls
                current_op op_index 1 - ops.set
                continue
            fi

            # Argc / Argv
            if current_op.value OpValue::Argc is then
                TYPE_I64_T checker.stack_push_type
                current_op op_index 1 - ops.set
                continue
            fi
            if current_op.value OpValue::Argv is then
                TYPE_PTR_T checker.stack_push_type
                current_op op_index 1 - ops.set
                continue
            fi
            if current_op.value OpValue::Envp is then
                TYPE_PTR_T checker.stack_push_type
                current_op op_index 1 - ops.set
                continue
            fi

            # Enum variant
            if current_op.value OpValue::PushEnumVariant is then
                function_opt current_op checker.check_enum_variant
                current_op op_index 1 - ops.set
                continue
            fi

            # Is check
            if current_op.value OpValue::IsCheck is then
                function_opt current_op checker.check_is
                current_op op_index 1 - ops.set
                continue
            fi

            # Match block
            if
                current_op.value OpValue::MatchStart is
                current_op.value OpValue::MatchArm is ||
                current_op.value OpValue::MatchEnd is ||
            then
                function_opt current_op checker.check_match
                current_op op_index 1 - ops.set
                continue
            fi

            # Struct new
            if current_op.value OpValue::StructNew is then
                current_op checker.check_struct_new
                current_op op_index 1 - ops.set
                continue
            fi

            # Struct literal
            if current_op.value OpValue::StructLiteral is then
                current_op checker.check_struct_literal
                current_op op_index 1 - ops.set
                continue
            fi

            # Method call
            if
                current_op.value OpValue::MethodCall is
                current_op.value OpValue::QualifiedMethodCall is ||
            then
                function_opt op_index ops current_op checker.check_method_call = op_index
                current_op op_index 1 - ops.set
                continue
            fi

            # Trait-bound method call
            if current_op.value OpValue::TraitMethodCall is then
                function_opt current_op checker.check_trait_method_call
                current_op op_index 1 - ops.set
                continue
            fi

            # F-string expression -> str conversion (Display trait)
            if current_op.value OpValue::FstringToStr is then
                function_opt op_index ops current_op checker.check_fstring_to_str = op_index
                current_op op_index 1 - ops.set
                continue
            fi

            # Type cast
            if current_op.value OpValue::TypeCast(cast_type_ref) is then
                cast_type_ref clone_type = cast_type
                current_op Op::location function_opt cast_type checker.validate_type_exists
                checker.stack_pop_value = cast_value
                if
                    0 cast_value.literals.length !=
                    ARRAY_TYPE cast_type.match_base.as_str == &&
                then
                    checker.literal_resolutions checker.diagnostics cast_type cast_value.resolve_literals drop
                fi
                cast_value.origins clone_origins = cast_origins
                if cast_type TYPE_CHAR_T.eq then
                    current_op.location "Cast to `char` is not allowed; use `char::from_codepoint`" ErrorKind::TypeMismatch checker.diagnostics.record_error
                elif cast_value.type_value TYPE_CHAR_T.eq then
                    current_op.location "Cast from `char` is not allowed; use `.codepoint`" ErrorKind::TypeMismatch checker.diagnostics.record_error
                fi
                if cast_type TYPE_PTR_T.eq cast_value.type_value TYPE_PTR_T.eq || then
                    "pointer cast" current_op checker.require_unsafe
                fi
                if
                    cast_type TYPE_PTR_T.eq
                    checker.store cast_type type_has_borrow ||
                then
                    cast_value checker.release_value
                else
                    cast_value checker.consume_value
                fi
                if checker.store cast_type type_has_borrow then
                    if cast_origins.is_none 0 checker.unsafe_depth != && then
                        cast_type.is_exclusive_borrow function_opt
                        checker.raw_borrow_input_origins = cast_origins
                    fi
                    cast_origins cast_type checker.stack_push_origins
                else
                    cast_type checker.stack_push_type
                fi
                current_op op_index 1 - ops.set
                continue
            fi

            # Import file and DeclareGlobal (compile-time only, no type effect)
            if
                current_op.value OpValue::ImportFile is
                current_op.value OpValue::ImportFileSelective is ||
                current_op.value OpValue::DeclareGlobal is ||
            then
                current_op op_index 1 - ops.set
                continue
            fi

            # Print variants (already resolved, should not appear)
            if
                current_op.value OpValue::PrintBool is
                current_op.value OpValue::PrintChar is ||
                current_op.value OpValue::PrintCstr is ||
                current_op.value OpValue::PrintInt is ||
                current_op.value OpValue::PrintStr is ||
                current_op.value OpValue::PrintString is ||
            then
                current_op op_index 1 - ops.set
                continue
            fi

            # Identifier (should be resolved by parser)
            if current_op.value OpValue::Identifier is then
                current_op op_index 1 - ops.set
                continue
            fi
            current_op op_index 1 - ops.set
        done
    }
}

fn materialize_declared_return_borrow value:mut$TypedValue declared:$Type {
    if declared.is_borrow ! value.capability ValueCapability::Owned is || then
        return
    fi
    value.type_value clone_type = target
    if value.type_value.borrow_target Option::Some(borrowed_target) is then
        borrowed_target clone_type = target
    fi
    if declared.is_exclusive_borrow then
        EXCLUSIVE_BORROW_TYPE
    else
        SHARED_BORROW_TYPE
    fi
    target apply_borrow_type = value.type_value
    Option[List[String]]::None = origins
    if value.origins Option::Some(current_origins) is then
        for origin in current_origins.iter do
            origin.as_str origin_place = place
            declared.is_exclusive_borrow place.as_str origins add_origin = origins
        done
    fi
    if origins.is_none then
        if value.place Option::Some(place) is then
            declared.is_exclusive_borrow place.as_str origins add_origin = origins
        fi
    fi
    origins = value.origins
}

impl TypeChecker {
    fn resolve_declared_return_borrow_capabilities self:mut$TypeChecker function:mut$Function {
        0 (u64) = index
        while
            index self
                .stack
                .values
                .length >
            index function
                .stack_effect
                .return_types
                .length > &&
        do
            index function
                .stack_effect
                .return_types
                .get = declared
            index self
                .stack
                .values
                .get_mut = value
            declared value materialize_declared_return_borrow
            1 += index
        done
    }

    fn resolve_declared_return_literals checker:mut$TypeChecker function:mut$Function {
        function.stack_effect.return_types = declared_returns: $List[Type]
        if
            declared_returns.length checker
                .stack
                .values
                .length !=
        then
            return
        fi
        0 (u64) = return_index
        while return_index declared_returns.length > do
            return_index checker
                .stack
                .values
                .get clone_typed_value = return_value
            if 0 return_value.literals.length != then
                return_index declared_returns.get clone_type = declared_return
                checker.literal_resolutions checker.diagnostics declared_return return_value.resolve_literals drop
                false = return_value.is_literal_constant
                List[LiteralRef]::new = return_value.literals
                declared_return = return_value.type_value
                return_value return_index checker
                    .stack
                    .values
                    .set
            fi
            1 += return_index
        done
    }
}

fn collect_cleanup_drop_types ops:$List[Op] store:$SymbolStore required:mut$List[Type] {
    for op in ops.iter do
        op.value clone_op_value = value
        if value OpValue::Drop is then
            if op.type_hint Option::Some(drop_type) is then
                if drop_type.has_unresolved_type_var then
                    drop_type clone_type required.push
                fi
            fi
        fi
        if op.id store.clone_ownership Option::Some(ownership) is then
            for event in ownership.cleanups.iter do
                if event.typ.has_unresolved_type_var then
                    event.typ clone_type required.push
                fi
            done
        fi
        value match
            OpValue::PushArray(items) => {
                required store items collect_cleanup_drop_types
            }
            OpValue::ExprGroup(items) => {
                required store items collect_cleanup_drop_types
            }
            OpValue::MatchArm(arm) => {
                required store arm.guard_ops collect_cleanup_drop_types
            }
            _ => {
            }
        end
    done
}

fn add_required_drop_parameters
    function:mut$Function
    ops:mut$List[Op]
    store:$SymbolStore
    forwarded_types:$List[Type]
{
    List[Type]::new = cleanup_types
    cleanup_types store ops collect_cleanup_drop_types
    List[Parameter]::new = hidden_parameters
    List[Variable]::new = hidden_variables
    List[Op]::new = assignments
    Set[String]::new = seen
    Set[String]::new = visiting
    for
        parameter in function
            .stack_effect
            .parameters
            .iter
    do
        parameter.name.clone seen.add
    done
    for forwarded_type in forwarded_types.iter do
        forwarded_type make_hidden_drop_parameter_name = hidden_drop
        function.location seen assignments hidden_variables hidden_parameters hidden_drop
        add_hidden_layout_parameter
    done
    for cleanup_type in cleanup_types.iter do
        function.location visiting seen assignments hidden_variables hidden_parameters store cleanup_type
        add_hidden_drop_parameters
    done
    if function.name.as_str "lambda__" str::starts_with then
        for
            type_var_name in function
                .stack_effect
                .type_vars
                .to_list
                .iter
        do
            type_var_name.clone Type::TypeVar = type_var
            type_var make_hidden_drop_parameter_name = hidden_drop
            function.location seen assignments hidden_variables hidden_parameters hidden_drop
            add_hidden_layout_parameter
        done
    fi
    if hidden_parameters.is_empty then
        return
    fi
    if function.name.as_str "lambda__" str::starts_with then
        for hidden_variable in hidden_variables.iter do
            if hidden_variable.name.as_str function.captures variable_list_contains ! then
                hidden_variable clone_variable function.captures.push
            fi
        done
        return
    fi
    hidden_variables function.variables.append
    for
        parameter in function
            .stack_effect
            .parameters
            .iter
    do
        parameter.name.clone parameter.typ clone_type Parameter hidden_parameters.push
    done
    hidden_parameters function.stack_effect StackEffect::set_parameters
    while assignments.is_empty ! do
        0 assignments.pop ops.insert
    done
}

fn check_ops
    ops:mut$List[Op]
    function_opt:mut$Option[Function]
    store:mut$SymbolStore
    diagnostics:mut$Diagnostics
-> StackEffect {
    diagnostics store TypeChecker::new = checker
    Option[u64]::None = budget
    if function_opt Option::Some(the_function) is then
        for variable in the_function.variables.iter do
            true variable.name.as_str checker.set_owner_moved
        done
        if the_function Function::name.as_str "lambda__" str::starts_with ! then
            the_function Function::stack_effect StackEffect::parameters.length Option::Some = budget
        fi
    else
        checker
            .store
            .variables
            .keys = global_names
        for global_name in global_names.iter do
            if global_name.as_str is_internal_variable_name then
                true global_name.as_str checker.set_owner_moved
            fi
        done
    fi
    budget = checker.param_cap
    Map[String u64]::new ops count_variable_uses = checker.remaining_uses
    checker.diagnostics.error_count = errors_before_ops
    function_opt ops checker.run_type_check_ops

    if function_opt Option::Some(checked_function) is then
        checked_function checker.resolve_declared_return_borrow_capabilities
        if checker.has_return_types ! then
            checked_function checker.validate_borrow_returns
        fi
        checked_function checker.resolve_declared_return_literals
        for capture_name in checked_function.owned_captures.iter do
            if capture_name.as_str checker.owner_is_moved then
                checked_function.location
                f"Repeatable closure does not restore captured owner `{capture_name}`"
                ErrorKind::InvalidVariable checker.diagnostics.record_error_string
            fi
        done
    fi

    0 (u64) = stack_index
    while
        stack_index checker
            .stack
            .values
            .length >
    do
        stack_index checker
            .stack
            .values
            .get clone_typed_value = stack_value
        stack_value checker.finish_value_use
        stack_value.type_value resolve_numeric_literal_default = final_type
        checker.literal_resolutions checker.diagnostics final_type stack_value.resolve_literals drop
        false = stack_value.is_literal_constant
        List[LiteralRef]::new = stack_value.literals
        final_type = stack_value.type_value
        stack_value stack_index checker
            .stack
            .values
            .set
        1 += stack_index
    done
    if 0 checker.owner_events.length != then
        checker.current_location.clone OpValue::OwnerCleanup Op::new = cleanup_op
        cleanup_op checker.assign_op_id
        cleanup_op checker.attach_all_owner_cleanups
        cleanup_op ops.push
    fi
    checker.literal_resolutions ops apply_resolved_literal_hints
    checker.diagnostics ops resolve_default_literals

    # Build inferred stack effect
    List[Type]::new = inferred_returns
    for
        inferred_value in checker
            .stack
            .values
            .iter
    do
        inferred_value.type_value clone_type inferred_returns.push
    done
    inferred_returns checker.parameters.clone StackEffect::new = inferred

    # Verify against declared stack effect if function has one
    checker.diagnostics.error_count errors_before_ops < = had_type_errors
    if had_type_errors ! then
        if function_opt Option::Some(declared_function) is then
            declared_function Function::stack_effect = declared: $StackEffect
            if
                declared stack_effect_to_str.as_str "None -> None" !=
                0 declared StackEffect::type_vars.length == &&
            then
                if inferred declared stack_effect_matches ! then
                    declared_function Function::location f"Invalid stack effect for function `{declared_function Function::name}`: expected `{declared stack_effect_to_str}`, got `{inferred stack_effect_to_str}`" ErrorKind::SignatureMismatch checker.diagnostics.record_error_string
                fi
            fi
            # Update inferred stack effect with declared return types for type-var functions
            if 0 declared StackEffect::type_vars.length != then
                declared.clone = inferred
            fi
        fi
    fi

    if function_opt Option::Some(checked_function) is then
        checker.required_drop_types.clone = forwarded_types
        forwarded_types checker.store ops checked_function add_required_drop_parameters
    fi

    inferred
}

# ============================================================================
# Type check all functions
# ============================================================================

fn check_functions store:mut$SymbolStore diagnostics:mut$Diagnostics {
    # Prepare callees before any caller is checked so their hidden layout
    # arguments are visible regardless of map iteration order.
    store.functions.keys = function_names
    for function_name in function_names.iter do
        function_name store
            .functions
            .remove
            .unwrap = function
        if function.name.as_str "lambda__" str::starts_with ! function.is_typechecked ! && then
            function prepare_generic_size_queries
        fi
        function function_name.clone store.functions.set
    done
    for func_name in function_names.iter do
        func_name store
            .functions
            .remove
            .unwrap = current_fn
        if current_fn Function::is_typechecked then
            current_fn func_name.clone store.functions.set
            continue
        fi
        if func_name.as_str "lambda__" str::starts_with then
            current_fn func_name.clone store.functions.set
            continue
        fi
        current_fn.clone_declaration func_name.clone store.functions.set
        current_fn.split_body = current_ops = current_fn
        diagnostics current_fn current_ops store resolve_identifiers
        # Skip type checking for functions with trait bounds (checked on demand)
        if 0 current_fn Function::stack_effect StackEffect::trait_bounds.keys.length != then
            current_ops current_fn Function::set_ops
            current_fn func_name.clone store.functions.set
            continue
        fi
        true current_fn Function::set_is_typechecked
        current_fn.clone_declaration func_name.clone store.functions.set
        diagnostics.error_count = errors_before
        current_fn Option::Some = current_fn_opt
        diagnostics store current_fn_opt current_ops check_ops = inferred_stack_effect
        current_fn_opt.unwrap = current_fn
        current_ops current_fn Function::set_ops
        diagnostics.error_count errors_before < = had_errors
        if had_errors then
            current_fn func_name.clone store.functions.set
            continue
        fi
        current_fn Function::stack_effect stack_effect_to_str = effect_text
        if effect_text.as_str "None -> None" == then
            Map[String StackEffect]::new = inferred_effects
            store inferred_effects current_fn analyze_function_semantics
            = semantics
            semantics.inferred_effect.clone current_fn Function::set_stack_effect
        fi
        current_fn func_name.clone store.functions.set
    done
}

fn check_trait_impls store:mut$SymbolStore diagnostics:mut$Diagnostics {
    for
        trait_impl in store
            .trait_impls
            .values
            .iter
    do
        trait_impl.trait_bound trait_bound_to_type = trait_type
        Set[String]::new = checked_methods
        true = valid
        trait_type store collect_trait_method_candidates = candidates
        for candidate in candidates.iter do
            candidate
                .method
                .name
                .clone = method_name
            if method_name checked_methods.has then
                continue
            fi
            method_name.clone checked_methods.add
            Option[String]::None = function_name_opt
            if method_name trait_impl.methods.get Option::Some(function_name) is then
                function_name.clone Option::Some = function_name_opt
            fi
            if function_name_opt.is_none then
                store trait_impl.receiver method_name.as_str find_semantic_method_function = function_name_opt
            fi
            if function_name_opt Option::Some(function_name) is then
                diagnostics store function_name.as_str ensure_typechecked = function_opt
                if function_opt.is_none then
                    false = valid continue
                fi
                function_opt.unwrap = implementation
                trait_impl.receiver candidate.effect resolve_trait_stack_effect = expected
                if true implementation.stack_effect expected trait_method_effects_match ! then
                    false = valid
                fi
            elif store trait_type method_name.as_str find_trait_default_method.is_none then
                false = valid
            fi
        done
        if valid ! then
            trait_impl.location f"Trait implementation `{trait_impl.receiver.format}: {trait_type.format}` does not satisfy the trait requirements" ErrorKind::TraitSignatureMismatch diagnostics.record_error_string
        fi
    done
}

fn type_check ops:List[Op] store:SymbolStore -> TypecheckResult {
    Diagnostics::new = diagnostics
    diagnostics store Option::None ops check_ops = global_stack_effect
    diagnostics store check_functions
    diagnostics store check_trait_impls
    diagnostics
    ops
    global_stack_effect
    store
    TypecheckResult
}
