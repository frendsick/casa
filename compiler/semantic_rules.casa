-> MethodSemantics {
    stack_effect method_name trait_type trait_name function_name kind MethodSemantics
}

pub fn does_trait_bound_match_qualifier
    bound:$common::TraitBound
    qualifier:$std::Option[common::Type]
    store:$common::SymbolStore
-> bool {
    if qualifier std::Option::Some(required_trait) is then
        bound common::trait_bound_to_type = bound_type
        store required_trait bound_type trait_type_implies return
    fi
    true
}

pub fn resolve_bound_method_semantics
    method_name:$str
    receiver:$common::Type
    qualifier:$std::Option[common::Type]
    function:$common::Function
    store:$common::SymbolStore
-> std::Option[MethodSemantics] {
    receiver.clone = receiver_pattern
    if receiver_pattern common::Type::TypeVar(type_variable) is then
        if
            type_variable function
                .stack_effect
                .trait_bounds
                .get std::Option::Some(bounds) is
        then
            for bound in bounds.iter do
                if store qualifier bound does_trait_bound_match_qualifier ! then
                    continue
                fi
                if bound.name store.traits.get std::Option::Some(casa_trait) is then
                    store casa_trait method_name find_semantic_trait_method = trait_method_opt
                    if trait_method_opt std::Option::Some(method) is then
                        casa_trait bound make_bound_substitutions = substitutions
                        receiver method.stack_effect common::resolve_trait_stack_effect = resolved_effect
                        substitutions resolved_effect common::apply_type_subs_to_stack_effect = resolved_effect
                        resolved_effect method_name.to_str bound common::trait_bound_to_type std::Option::Some bound.name.clone std::String::new
                        MethodSemanticsKind::TraitBound
                        make_method_semantics std::Option::Some return
                    fi
                fi
            done
        fi
    fi
    std::Option[MethodSemantics]::None
}

pub fn resolve_trait_method_semantics_for
    method_name:$str
    receiver:$common::Type
    qualifier:$std::Option[common::Type]
    store:$common::SymbolStore
-> std::Option[MethodSemantics] {
    std::Option[MethodSemantics]::None = found
    std::String::new = found_identity
    false = has_exact
    if qualifier std::Option::Some(required_trait) is then
        for
            trait_impl in required_trait
                .match_base
                .as_str receiver store.get_trait_impl_candidates_for_receiver_and_trait
        do
            store trait_impl receiver resolve_applicable_trait_impl = direct_opt
            if direct_opt std::Option::Some(direct_trait) is then
                if direct_trait required_trait.eq then
                    true = has_exact
                fi
            fi
        done
    fi
    for trait_impl in receiver store.get_trait_impl_candidates_for_receiver do
        store trait_impl receiver resolve_applicable_trait_impl = trait_type_opt
        if trait_type_opt.is_none then
            continue
        fi
        trait_type_opt.unwrap = trait_type
        if qualifier std::Option::Some(required_trait) is then
            if has_exact trait_type required_trait.eq ! && then
                continue
            fi
            if store required_trait trait_type trait_type_implies ! then
                continue
            fi
        fi
        trait_type.clone = lookup_trait_type
        if qualifier std::Option::Some(required_trait) is then
            required_trait.clone = lookup_trait_type
        fi
        if store method_name lookup_trait_type trait_type_has_method ! then
            continue
        fi
        if method_name trait_impl.methods.get_str std::Option::Some(function_name) is then
            function_name.as_str store
                .get_function
                .unwrap
                .stack_effect
                .clone = effect
            trait_type.match_base = trait_name
            effect method_name.to_str trait_type.clone std::Option::Some trait_name function_name.clone
            MethodSemanticsKind::Function make_method_semantics = candidate
            if "" found_identity.as_str == then
                function_name.clone = found_identity
                candidate std::Option::Some = found
            elif function_name.as_str found_identity.as_str != then
                std::Option[MethodSemantics]::None return
            fi
            continue
        fi
        store lookup_trait_type method_name find_trait_default_method = default_opt
        if
            default_opt.is_none
            has_exact ! &&
            lookup_trait_type trait_type.eq ! &&
        then
            store trait_type method_name find_trait_default_method = default_opt
        fi
        if
            qualifier.is_none default_opt.is_none ||
            store receiver method_name
            find_semantic_method_function std::Option::Some(function_name) is &&
        then
            function_name.as_str store
                .get_function
                .unwrap
                .stack_effect
                .clone = effect
            trait_type.match_base = trait_name
            effect method_name.to_str trait_type.clone std::Option::Some trait_name function_name.clone
            MethodSemanticsKind::Function make_method_semantics = candidate
            if "" found_identity.as_str == then
                function_name.clone = found_identity
                candidate std::Option::Some = found
            elif function_name.as_str found_identity.as_str != then
                std::Option[MethodSemantics]::None return
            fi
            continue
        fi
        if default_opt std::Option::Some(default_method) is then
            f"{default_method.trait_type.format}::{method_name}" = identity
            receiver default_method.effect common::resolve_trait_stack_effect = resolved_effect
            default_method.trait_type.format = trait_text
            trait_text.as_str std::str_hash = trait_hash
            receiver.format = receiver_text
            receiver_text.as_str std::str_hash = receiver_hash
            f"{receiver.match_base}::{method_name}__default_{receiver_hash}_{trait_hash}"
            = function_name
            default_method.trait_type.clone std::Option::Some = default_trait_type
            default_method.trait_type.match_base = default_trait_name
            resolved_effect method_name.to_str default_trait_type
            default_trait_name function_name
            MethodSemanticsKind::DefaultMethod make_method_semantics = candidate
            if "" found_identity.as_str == then
                identity = found_identity
                candidate std::Option::Some = found
            elif identity.as_str found_identity.as_str != then
                std::Option[MethodSemantics]::None return
            fi
        fi
    done
    found
}

pub fn resolve_default_method_semantics
    method_name:$str
    receiver:$common::Type
    store:$common::SymbolStore
-> std::Option[MethodSemantics] {
    store std::Option[common::Type]::None receiver method_name resolve_trait_method_semantics_for
}

pub fn resolve_qualified_method_semantics
    method_name:$str
    qualifier:$common::Type
    receiver:$common::Type
    store:$common::SymbolStore
-> std::Option[MethodSemantics] {
    receiver.clone = receiver_type
    if receiver_type.borrow_target std::Option::Some(target) is then
        target.clone = receiver_type
    fi
    qualifier.clone std::Option::Some = qualifier_opt
    store qualifier_opt receiver_type method_name resolve_trait_method_semantics_for
}

pub fn resolve_qualified_method_semantics_with_bounds
    method_name:$str
    receiver:$common::Type
    qualifier:$common::Type
    function_opt:$std::Option[common::Function]
    store:$common::SymbolStore
-> std::Option[MethodSemantics] {
    receiver.clone = receiver_type
    if receiver_type.borrow_target std::Option::Some(target) is then
        target.clone = receiver_type
    fi
    if function_opt std::Option::Some(function) is then
        qualifier.clone std::Option::Some = qualifier_opt
        store function qualifier_opt receiver_type method_name resolve_bound_method_semantics = bound_method_opt
        if bound_method_opt.is_some then
            bound_method_opt return
        fi
    fi
    store receiver_type qualifier method_name resolve_qualified_method_semantics
}

pub fn collect_method_qualifiers
    method_name:$str
    receiver:$common::Type
    store:$common::SymbolStore
-> std::List[std::String] {
    receiver.clone = receiver_type
    if receiver.borrow_target std::Option::Some(target) is then
        target.clone = receiver_type
    fi
    std::List[std::String]::new = result
    std::Set[std::String]::new = seen
    for trait_impl in receiver_type store.get_trait_impl_candidates_for_receiver do
        store trait_impl receiver_type resolve_applicable_trait_impl = trait_type_opt
        if trait_type_opt.is_none then
            continue
        fi
        trait_type_opt.unwrap = trait_type
        if store method_name trait_type trait_type_has_method ! then
            continue
        fi
        trait_type.format = qualifier
        if qualifier seen.has ! then
            qualifier.clone seen.add
            qualifier result.push
        fi
    done
    result
}

pub fn resolve_method_semantics
    method_name:$str
    receiver:$common::Type
    function_opt:$std::Option[common::Function]
    store:$common::SymbolStore
-> std::Option[MethodSemantics] {
    receiver.clone = receiver_type
    if receiver.borrow_target std::Option::Some(target) is then
        target.clone = receiver_type
    fi
    if function_opt std::Option::Some(function) is then
        store function std::Option[common::Type]::None receiver_type method_name resolve_bound_method_semantics = bound_method_opt
        bound_method_opt match
            std::Option::Some(method) => method std::Option::Some return
            std::Option::None => {
            }
        end
    fi
    if store receiver method_name find_semantic_method_function std::Option::Some(function_name) is then
        function_name.as_str store.get_function.unwrap = resolved_function: $common::Function
        resolved_function common::Function::stack_effect = stored_effect: $common::StackEffect
        stored_effect.clone = effect
        effect method_name.to_str std::Option[common::Type]::None "".to_str function_name.clone MethodSemanticsKind::Function
        make_method_semantics std::Option::Some return
    fi
    store receiver_type method_name resolve_default_method_semantics
}

pub fn primitive_print_operation receiver:$common::Type -> std::Option[common::OpValue] {
    if receiver.is_integer_type_t then
        common::OpValue::PrintInt std::Option::Some return
    fi
    receiver.format = receiver_name
    if common::STD_STRING_TYPE receiver_name.as_str == then
        common::OpValue::PrintString std::Option::Some return
    fi
    receiver_name.as_str match
        "str" => common::OpValue::PrintStr std::Option::Some
        "bool" => common::OpValue::PrintBool std::Option::Some
        "char" => common::OpValue::PrintChar std::Option::Some
        _ => std::Option[common::OpValue]::None
    end
}

pub fn comparison_method_name operation:$common::OpValue -> str {
    operation match
        common::OpValue::Eq => "eq"
        common::OpValue::Ne => "ne"
        common::OpValue::Lt => "lt"
        common::OpValue::Le => "le"
        common::OpValue::Gt => "gt"
        _ => "ge"
    end
}

pub fn comparison_trait_name operation:$common::OpValue -> str {
    operation match
        common::OpValue::Eq => common::STD_PARTIAL_EQ_TRAIT
        common::OpValue::Ne => common::STD_PARTIAL_EQ_TRAIT
        _ => common::STD_PARTIAL_ORD_TRAIT
    end
}

pub fn comparison_uses_method receiver:$common::Type store:$common::SymbolStore -> bool {
    if receiver.is_unknown_placeholder then
        false return
    fi
    if common::make_str_type receiver.eq then
        false return
    fi
    if receiver.is_primitive_compare_type_t then
        false return
    fi
    receiver match
        common::Type::TypeVar(_) => true
        common::Type::Generic(generic) => generic.base.as_str store.structs.has_str
        _ => false
    end
}

pub fn add_method_dependencies
    result:mut$SemanticFacts
    method:mut$MethodSemantics
    receiver:$common::Type
    store:$common::SymbolStore
{
    if "" method.trait_name.as_str != then
        method.trait_name.clone result.dependencies.push
    fi
    if method.kind MethodSemanticsKind::Function is then
        method.function_name.clone result.dependencies.push
    elif method.kind MethodSemanticsKind::DefaultMethod is then
        if method.trait_name.as_str store.traits.get_str std::Option::Some(casa_trait) is then
            store casa_trait receiver collect_trait_implementation_dependencies = implementations
            implementations result.dependencies.append
        fi
    fi
}

pub fn analyze_method_operation
    result:mut$SemanticFacts
    method_name:$str
    receiver:$common::Type
    function_opt:$std::Option[common::Function]
    store:$common::SymbolStore
-> std::Option[MethodSemantics] {
    store function_opt receiver method_name resolve_method_semantics = method_opt
    method_opt match
        std::Option::Some(method) => {
            store receiver method result add_method_dependencies
            method std::Option::Some
        }
        std::Option::None => std::Option[MethodSemantics]::None
    end
}

pub fn analyze_operation
    operation:$common::OpValue
    receiver:std::Option[common::Type]
    function_opt:$std::Option[common::Function]
    store:$common::SymbolStore
-> SemanticFacts {
    SemanticFacts::new = result
    operation fixed_operation_stack_effect = result.stack_effect
    operation operation_syscall_argument_count = result.syscall_argument_count
    if result.syscall_argument_count std::Option::Some(argument_count) is then
        argument_count make_syscall_stack_effect std::Option::Some = result.stack_effect
        argument_count = result.word_parameter_count
        1 = result.word_parameter_start
    fi
    operation match
        common::OpValue::FnCall(function_name) => {
            function_name.clone result.dependencies.push
            if function_name.as_str store.get_function std::Option::Some(function) is then
                function.stack_effect.clone std::Option::Some = result.stack_effect
            fi
        }
        common::OpValue::FnPush(function_name) => {
            function_name.clone result.dependencies.push
            if function_name.as_str store.get_function std::Option::Some(function) is then
                function.stack_effect.clone make_function_reference_stack_effect std::Option::Some
                = result.stack_effect
            fi
        }
        common::OpValue::FnExec => {
            if receiver.clone std::Option::Some(receiver_type) is then
                if receiver_type common::Type::Function(function_type) is then
                    function_type common::function_type_to_stack_effect std::Option::Some = result.stack_effect
                fi
            fi
        }
        common::OpValue::FnExecOwned => {
            if receiver.clone std::Option::Some(receiver_type) is then
                if receiver_type common::Type::Function(function_type) is then
                    function_type common::function_type_to_stack_effect std::Option::Some = result.stack_effect
                fi
            fi
        }
        common::OpValue::MethodCall(method_name) => {
            if receiver.clone std::Option::Some(receiver_type) is then
                store function_opt receiver_type method_name.as_str result analyze_method_operation match
                    std::Option::Some(method) => {
                        method.stack_effect.clone std::Option::Some = result.stack_effect
                        method std::Option::Some = result.method
                    }
                    std::Option::None => {
                    }
                end
            fi
        }
        common::OpValue::QualifiedMethodCall(qualified) => {
            if receiver.clone std::Option::Some(receiver_type) is then
                std::Option[MethodSemantics]::None = method_opt
                if qualified.type_qualified then
                    store function_opt qualified.qualifier_type qualified.method_name.as_str resolve_method_semantics
                    = method_opt
                else
                    store function_opt qualified.qualifier_type receiver_type qualified.method_name.as_str
                    resolve_qualified_method_semantics_with_bounds
                    = method_opt
                fi
                method_opt match
                    std::Option::Some(method) => {
                        method.stack_effect.clone std::Option::Some = result.stack_effect
                        if qualified.type_qualified then
                            store qualified.qualifier_type method result add_method_dependencies
                        else
                            store receiver_type method result add_method_dependencies
                        fi
                        method std::Option::Some = result.method
                    }
                    std::Option::None => {
                    }
                end
            fi
        }
        common::OpValue::TraitMethodCall(call) => {
            std::Option[MethodSemantics]::None = method_opt
            if function_opt std::Option::Some(function) is then
                store function call.trait_type call.receiver call.method_name.as_str resolve_bound_method_semantics = method_opt
            fi
            if method_opt.is_none then
                if call.trait_type std::Option::Some(trait_type) is then
                    store call.receiver trait_type call.method_name.as_str resolve_qualified_method_semantics = method_opt
                else
                    store function_opt call.receiver call.method_name.as_str resolve_method_semantics = method_opt
                fi
            fi
            method_opt match
                std::Option::Some(method) => {
                    method.stack_effect.clone std::Option::Some = result.stack_effect
                    store call.receiver method result add_method_dependencies
                    method std::Option::Some = result.method
                }
                std::Option::None => {
                }
            end
        }
        common::OpValue::TraitMethodRef(call) => {
            store function_opt call.receiver call.method_name.as_str result analyze_method_operation match
                std::Option::Some(method) => {
                    method.stack_effect.clone make_function_reference_stack_effect std::Option::Some
                    = result.stack_effect
                    method std::Option::Some = result.method
                }
                std::Option::None => {
                }
            end
        }
        common::OpValue::Print => {
            if receiver.clone std::Option::Some(receiver_type) is then
                receiver_type primitive_print_operation = result.resolved_operation
                if result.resolved_operation.is_none receiver_type.is_unknown_placeholder ! && then
                    common::STD_DISPLAY_TRAIT.to_str result.dependencies.push
                    store function_opt receiver_type "to_str" result analyze_method_operation = method_opt
                    method_opt match
                        std::Option::Some(method) => method std::Option::Some = result.method
                        std::Option::None => {
                        }
                    end
                fi
            fi
        }
        common::OpValue::FstringToStr => {
            if receiver.clone std::Option::Some(receiver_type) is then
                if common::make_str_type receiver_type.eq ! receiver_type.is_unknown_placeholder ! && then
                    common::STD_DISPLAY_TRAIT.to_str result.dependencies.push
                    store function_opt receiver_type "to_str" result analyze_method_operation = method_opt
                    method_opt match
                        std::Option::Some(method) => method std::Option::Some = result.method
                        std::Option::None => {
                        }
                    end
                fi
            fi
        }
        common::OpValue::PrimitiveToStr => {
        }
        _ => {
        }
    end
    if operation operation_is_comparison then
        if receiver.clone std::Option::Some(receiver_type) is then
            if store receiver_type comparison_uses_method then
                operation comparison_trait_name result.dependencies.push_str
                operation comparison_method_name = method_name
                store function_opt receiver_type method_name result analyze_method_operation = method_opt
                method_opt match
                    std::Option::Some(method) => method std::Option::Some = result.method
                    std::Option::None => {
                    }
                end
            fi
        fi
    fi
    result
}

pub fn make_type_borrow_option value:$common::Type -> std::Option[common::Type] {
    value.clone std::Option::Some = result: std::Option[common::Type]
    result
}
# Pattern payloads follow the subject capability. Copy payloads remain values.
pub fn pattern_binding_type
    subject_type:$common::Type
    binding_type:common::Type
    binding_is_copy:bool
-> common::Type {
    if subject_type.is_borrow ! binding_is_copy || then
        binding_type return
    fi
    binding_type.clone = target
    subject_type.is_shared_borrow = shared
    if binding_type.borrow_target std::Option::Some(borrowed_target) is then
        borrowed_target.clone = target
        if binding_type.is_shared_borrow then
            true = shared
        fi
    fi
    if shared then
        common::SHARED_BORROW_TYPE
    else
        common::EXCLUSIVE_BORROW_TYPE
    fi
    target common::apply_borrow_type
}
