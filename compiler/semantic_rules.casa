}

pub fn collect_bound_semantic_dependencies
    effect:$common::StackEffect
    bindings:mut$std::Map[std::String common::Type]
    store:$common::SymbolStore
-> std::List[std::String] {
    std::List[std::String]::new = dependencies
    for
        type_variable in effect
            .trait_bounds
            .keys
            .iter
    do
        if type_variable bindings.get std::Option::Some(receiver) is then
            for
                bound in type_variable effect
                    .trait_bounds
                    .get
                    .unwrap
                    .iter
            do
                if bound.name store.traits.get std::Option::Some(casa_trait) is then
                    bound.name.clone dependencies.push
                    store casa_trait receiver collect_trait_implementation_dependencies
                    = implementations
                    implementations dependencies.append
                fi
            done
        fi
    done
    dependencies
}

pub fn make_method_semantics
    kind:MethodSemanticsKind
    function_name:std::String
    trait_name:std::String
    trait_type:std::Option[common::Type]
    method_name:std::String
