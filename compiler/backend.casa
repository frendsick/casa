        semantic_body::IntrinsicKind::Store32 => InstValue::Store32 std::Option::Some
        semantic_body::IntrinsicKind::Store64 => InstValue::Store64 std::Option::Some
        semantic_body::IntrinsicKind::Swap => InstValue::Swap std::Option::Some
