# Linux x86-64 backend. Machine construction and rendering stay private.
import "std" as std
import "abi" as abi
import "common" as common
import "error" as error
import "pattern" as pattern
import "semantic_rules" as semantics
import "typechecker" as typechecker
import "runtime" as runtime

enum InstValue {
    # Stack
    Drop
    Dup
    Over
    Push (i64)
    PushFloat32 (std::String)
    PushFloat64 (std::String)
    PushChar (i64)
    PushStr (u64)
    Rot
    Swap
    # IO
    PrintBool
    PrintChar
    PrintCstr
    PrintInt
    PrintUint
    PrintStr
    PrintString
    Panic
    # Memory
    HeapAlloc
    HeapFree
    HeapFreeIfAllocated
    Load8
    Load16
    Load32
    Load64
    ReadIndirect (u64)
    Store8
    Store16
    Store32
    Store64
    WriteIndirect (u64)
    MoveBytes (u64)
    # Arithmetic
    Add
    CheckedAdd (common::BuiltinType)
    CheckedDiv (common::BuiltinType)
    CheckedMod (common::BuiltinType)
    CheckedMul (common::BuiltinType)
    CheckedShl (common::BuiltinType)
    CheckedShr (common::BuiltinType)
    CheckedSub (common::BuiltinType)
    Div
    FloatAdd32
    FloatAdd64
    FloatDiv32
    FloatDiv64
    FloatEq32
    FloatEq64
    FloatGe32
    FloatGe64
    FloatGt32
    FloatGt64
    FloatLe32
    FloatLe64
    FloatLt32
    FloatLt64
    FloatMul32
    FloatMul64
    FloatNe32
    FloatNe64
    FloatSub32
    FloatSub64
    FloatRound (common::FloatRound)
    FloatFromDecimal
    FloatSignificand
    Mod
    Mul
    Sub
    # Bitshift
    Shl
    Shr
    # Bitwise
    BitAnd
    BitOr
    BitXor
    BitNot
    # Boolean
    And
    Or
    Not
    # Comparison
    Eq
    Ge
    Gt
    Le
    Lt
    Ne
    Ult
    Ule
    Ugt
    Uge
    UDiv
    UMod
    UShr
    NormalizeInt (common::BuiltinType)
    NumericConvert (common::NumericConversion)
    NumericTry (common::NumericTry)
    IntegerTry (common::IntegerTry)
    # Functions
    FnCall (std::String)
    ExternCall (std::String)
    FnExec
    FnPush (std::String)
    FnReturn
    DropFn (std::String)
    # Jumps
    Label (u64)
    Jump (u64)
    JumpNe (u64)
    # Locals
    LocalsInit (u64)
    LocalsUninit (u64)
    LocalAddress (u64)
    LocalGet (u64)
    LocalSet (u64)
    # Constants
    ConstantLoad (u64)
    ConstantStore (u64)
    # Closures
    CaptureFlagClear (u64)
    CaptureFlagLoad (u64)
    CaptureFlagMark (u64)
    CaptureLoad (u64)
    CaptureSet (u64)
    ClosureDrop
    ClosureRecord (u64)
    FnPushStatic (std::String)
    # Strings
    StrEq
    StringStrEq
    StrStringEq
    # Static arrays
    PushStaticArray (u64)
    # F-strings
    FstringConcat (u64)
    PrimitiveToStr (common::BuiltinType)
    # Syscalls
    Syscall0
    Syscall1
    Syscall2
    Syscall3
    Syscall4
    Syscall5
    Syscall6
    # Command-line arguments
    Argc
    Argv
    Envp
}

struct Program {
    native_calls:    std::Map[std::String common::NativeCallPlan]
    bytecode:        std::List[InstValue]
    functions:       std::Map[std::String std::List[InstValue]]
    strings:         std::List[std::String]
    static_arrays:   std::List[common::StaticArray]
    static_structs:  std::List[common::StaticStruct]
    constants_count: u64
}

fn direct_op_to_inst value:$common::OpValue -> std::Option[InstValue] {
    value match
        common::OpValue::Add => InstValue::Add std::Option::Some
        common::OpValue::And => InstValue::And std::Option::Some
        common::OpValue::BitAnd => InstValue::BitAnd std::Option::Some
        common::OpValue::BitNot => InstValue::BitNot std::Option::Some
        common::OpValue::BitOr => InstValue::BitOr std::Option::Some
        common::OpValue::BitXor => InstValue::BitXor std::Option::Some
        common::OpValue::Div => InstValue::Div std::Option::Some
        common::OpValue::Drop => InstValue::Drop std::Option::Some
        common::OpValue::Dup => InstValue::Dup std::Option::Some
        common::OpValue::Eq => InstValue::Eq std::Option::Some
        common::OpValue::FnExec => InstValue::FnExec std::Option::Some
        common::OpValue::FnReturn => InstValue::FnReturn std::Option::Some
        common::OpValue::Ge => InstValue::Ge std::Option::Some
        common::OpValue::Gt => InstValue::Gt std::Option::Some
        common::OpValue::HeapAlloc => InstValue::HeapAlloc std::Option::Some
        common::OpValue::HeapFree => InstValue::HeapFree std::Option::Some
        common::OpValue::Le => InstValue::Le std::Option::Some
        common::OpValue::Load8 => InstValue::Load8 std::Option::Some
        common::OpValue::Load16 => InstValue::Load16 std::Option::Some
        common::OpValue::Load32 => InstValue::Load32 std::Option::Some
        common::OpValue::Load64 => InstValue::Load64 std::Option::Some
        common::OpValue::Lt => InstValue::Lt std::Option::Some
        common::OpValue::Mod => InstValue::Mod std::Option::Some
        common::OpValue::Mul => InstValue::Mul std::Option::Some
        common::OpValue::Ne => InstValue::Ne std::Option::Some
        common::OpValue::Not => InstValue::Not std::Option::Some
        common::OpValue::Or => InstValue::Or std::Option::Some
        common::OpValue::Over => InstValue::Over std::Option::Some
        common::OpValue::Panic => InstValue::Panic std::Option::Some
        common::OpValue::PrintBool => InstValue::PrintBool std::Option::Some
        common::OpValue::PrintChar => InstValue::PrintChar std::Option::Some
        common::OpValue::PrintCstr => InstValue::PrintCstr std::Option::Some
        common::OpValue::PrintInt => InstValue::PrintInt std::Option::Some
        common::OpValue::PrintStr => InstValue::PrintStr std::Option::Some
        common::OpValue::PrintString => InstValue::PrintString std::Option::Some
        common::OpValue::Rot => InstValue::Rot std::Option::Some
        common::OpValue::Shl => InstValue::Shl std::Option::Some
        common::OpValue::Shr => InstValue::Shr std::Option::Some
        common::OpValue::Store8 => InstValue::Store8 std::Option::Some
        common::OpValue::Store16 => InstValue::Store16 std::Option::Some
        common::OpValue::Store32 => InstValue::Store32 std::Option::Some
        common::OpValue::Store64 => InstValue::Store64 std::Option::Some
        common::OpValue::Sub => InstValue::Sub std::Option::Some
        common::OpValue::Swap => InstValue::Swap std::Option::Some
        common::OpValue::Syscall0 => InstValue::Syscall0 std::Option::Some
        common::OpValue::Syscall1 => InstValue::Syscall1 std::Option::Some
        common::OpValue::Syscall2 => InstValue::Syscall2 std::Option::Some
        common::OpValue::Syscall3 => InstValue::Syscall3 std::Option::Some
        common::OpValue::Syscall4 => InstValue::Syscall4 std::Option::Some
        common::OpValue::Syscall5 => InstValue::Syscall5 std::Option::Some
        common::OpValue::Syscall6 => InstValue::Syscall6 std::Option::Some
        common::OpValue::Argc => InstValue::Argc std::Option::Some
        common::OpValue::Argv => InstValue::Argv std::Option::Some
        common::OpValue::Envp => InstValue::Envp std::Option::Some
        _ => std::Option[InstValue]::None
    end
}
# Checked lowering to private machine instructions.
#
# Translates high-level Ops (owned by the checked program) into
# low-level instructions suitable for code generation.

# ============================================================================
# LoweringBuilder struct
# ============================================================================

pub struct BackendFailure {
    pub message: std::String
}

impl BackendFailure {
    fn new message:std::String -> BackendFailure { message BackendFailure }
}

enum ControlFlowKind derives std::Copy {
    If
    While
    Match
}

struct ControlFlowTarget {
    block_start: u64
    next_branch: u64
    block_end:   u64
    parent:      u64
}

struct ControlFlowTargets {
    data:   ptr
    length: u64
}

impl ControlFlowTargets {
    fn new length:u64 -> ControlFlowTargets {
        if 0 length == then
            unsafe { length ptr::null ControlFlowTargets } return
        fi
        size_of[ControlFlowTarget] = stride
        # SAFETY: The table owns length target slots, which initialize before use.
        unsafe { length length stride * alloc ControlFlowTargets }
    }

    fn drop self:mut$ControlFlowTargets {
        # SAFETY: The table owns the complete allocation until destruction.
        unsafe { self.data free }
        unsafe { ptr::null = self.data }
        0 = self.length
    }

    fn initialize self:mut$ControlFlowTargets op_index:u64 {
        ControlFlowTarget {
            block_start: self.length
            next_branch: self.length
            block_end: self.length
            parent: self.length
        } = target
        # SAFETY: The prepass initializes each in-bounds target exactly once.
        unsafe {
            target self.data op_index size_of[ControlFlowTarget] * + ptr::write[ControlFlowTarget]
        }
    }

    fn get_ref self:$ControlFlowTargets op_index:u64 -> $ControlFlowTarget {
        # SAFETY: Callers use initialized operation indexes from this sequence.
        unsafe { self.data op_index size_of[ControlFlowTarget] * + ptr::as_ref[ControlFlowTarget] }
    }

    fn get_mut self:mut$ControlFlowTargets op_index:u64 -> mut$ControlFlowTarget {
        # SAFETY: The exclusive table borrow and operation index identify one target.
        unsafe { self.data op_index size_of[ControlFlowTarget] * + ptr::as_mut[ControlFlowTarget] }
    }

    fn set_start self:mut$ControlFlowTargets op_index:u64 start:u64 {
        op_index self.get_mut = target
        start = target.block_start
    }

    fn set_next self:mut$ControlFlowTargets op_index:u64 next:u64 {
        op_index self.get_mut = target
        next = target.next_branch
    }

    fn set_end self:mut$ControlFlowTargets start:u64 end_index:u64 {
        start self.get_mut = target
        end_index = target.block_end
    }

    fn set_parent self:mut$ControlFlowTargets op_index:u64 parent:u64 {
        op_index self.get_mut = target
        parent = target.parent
    }

    fn get_parent self:$ControlFlowTargets op_index:u64 -> u64 { op_index self.get_ref.parent }

    fn get_start self:$ControlFlowTargets op_index:u64 -> std::Option[u64] {
        op_index self.get_ref.block_start = start
        if start self.length != then
            start std::Option::Some
        else
            std::Option[u64]::None
        fi
    }

    fn get_end self:$ControlFlowTargets op_index:u64 -> std::Option[u64] {
        if op_index self.get_start std::Option::Some(start) is then
            start self.get_ref.block_end = end_index
            if end_index self.length != then
                end_index std::Option::Some return
            fi
        fi
        std::Option[u64]::None
    }

    fn get_next self:$ControlFlowTargets op_index:u64 -> std::Option[u64] {
        op_index self.get_ref.next_branch = next
        if next self.length != then
            next std::Option::Some
        else
            std::Option[u64]::None
        fi
    }
}

struct IfTargetFrame {
    start:  u64
    branch: u64
}

struct WhileTargetFrame {
    start:               u64
    first_end_target_op: u64
}

struct MatchTargetFrame {
    start: u64
    arm:   u64
}

fn make_if_target_frames capacity:u64 -> std::List[IfTargetFrame] {
    if 0 capacity == then
        std::List[IfTargetFrame]::new return
    fi
    # SAFETY: The list owns capacity frame slots and publishes no initialized elements yet.
    unsafe {
        capacity 0 capacity size_of[IfTargetFrame] * alloc std::List
        = frames: std::List[IfTargetFrame]
        frames
    }
}

fn make_while_target_frames capacity:u64 -> std::List[WhileTargetFrame] {
    if 0 capacity == then
        std::List[WhileTargetFrame]::new return
    fi
    # SAFETY: The list owns capacity frame slots and publishes no initialized elements yet.
    unsafe {
        capacity 0 capacity size_of[WhileTargetFrame] * alloc std::List
        = frames: std::List[WhileTargetFrame]
        frames
    }
}

fn make_match_target_frames capacity:u64 -> std::List[MatchTargetFrame] {
    if 0 capacity == then
        std::List[MatchTargetFrame]::new return
    fi
    # SAFETY: The list owns capacity frame slots and publishes no initialized elements yet.
    unsafe {
        capacity 0 capacity size_of[MatchTargetFrame] * alloc std::List
        = frames: std::List[MatchTargetFrame]
        frames
    }
}

struct LoweringState {
    store:           $common::SymbolStore
    program:         Program
    failure:         std::Option[BackendFailure]
    constants_table: std::List[std::String]
    label_counter:   u64
    op_label_map:    std::Map[i64 u64]
}

struct LoweringBuilder {
    ops:           $std::List[common::Op]
    function:      std::Option[common::Function]
    local_slots:   std::Map[std::String u64]
    capture_slots: std::Map[std::String u64]
    locals_count:  u64
    state:         mut$LoweringState
    owner_flags:   std::Map[std::String u64]
}

struct ResolvedStructField {
    storage: common::FieldStoragePlan
    typ:     common::Type
}

fn resolve_struct_field
    member:$common::StructMemberAccess
    store:$common::SymbolStore
-> std::Option[ResolvedStructField] {
    if member.struct_name store.structs.get std::Option::Some(casa_struct) is then
        if member.member_index casa_struct.members.length > then
            if
                store member.member_index casa_struct common::plan_struct_member_storage
                std::Option::Some(storage) is
            then
                member.member_index casa_struct
                    .members
                    .get
                    .typ
                    .clone = typ
                typ storage.clone ResolvedStructField std::Option::Some return
            fi
        fi
    fi
    std::Option[ResolvedStructField]::None
}

impl LoweringState {
    fn new store:$common::SymbolStore -> LoweringState {
        std::Map[i64 u64]::new
        0
        std::List[std::String]::new
        std::Option[BackendFailure]::None
        0
        std::List[common::StaticStruct]::new
        std::List[common::StaticArray]::new
        std::List[std::String]::new
        std::Map[std::String std::List[InstValue]]::new
        std::List[InstValue]::new
        std::Map[std::String common::NativeCallPlan]::new
        Program
        store
        LoweringState
    }

    fn into_result self:LoweringState -> std::Result[Program BackendFailure] {
        self match
            LoweringState { program: program failure: failure } => {
                failure match
                    std::Option::Some(bytecode_failure) => bytecode_failure std::Result::Error
                    std::Option::None => program std::Result::Ok
                end
            }
        end
    }
}

impl LoweringBuilder {
    fn new state:mut$LoweringState ops:$std::List[common::Op] -> LoweringBuilder {
        state.store state.store.variables index_root_variable_map = locals_count = local_slots
        std::Map[std::String u64]::new
        state
        locals_count
        std::Map[std::String u64]::new
        local_slots
        std::Option[common::Function]::None
        ops
        LoweringBuilder
    }

    fn child
        self:mut$LoweringBuilder
        function:$common::Function
        ops:$std::List[common::Op]
    -> LoweringBuilder {
        self.state.store function.variables index_local_variable_list = locals_count = local_slots
        std::Map[std::String u64]::new
        self.state
        locals_count
        function.captures index_variable_list
        local_slots
        function.clone_declaration std::Option::Some
        ops
        LoweringBuilder
    }

    fn record_failure_string self:mut$LoweringBuilder message:std::String {
        if
            self
                .state
                .failure
                .is_none
        then
            message BackendFailure::new std::Option::Some = self.state.failure
        fi
    }

    fn record_failure self:mut$LoweringBuilder message:$str {
        message.to_str self.record_failure_string
    }

    fn has_failed self:mut$LoweringBuilder -> bool {
        self
            .state
            .failure
            .is_some
    }

    fn emit_field_load
        compiler:mut$LoweringBuilder
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[InstValue]
    {
        if plan.stores_inline then
            bytecode declared_type compiler.emit_typed_load
        else
            InstValue::Load64 bytecode.push
        fi
    }

    fn emit_field_projection
        compiler:mut$LoweringBuilder
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[InstValue]
    {
        if plan.stores_inline ! then
            InstValue::Load64 bytecode.push
            return
        fi
        if
            compiler.state.store declared_type common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation != then
                bytecode declared_type compiler.emit_typed_load
            fi
        else
            f"Cannot determine field representation of `{declared_type.format}`" compiler.record_failure_string
        fi
    }

    fn emit_field_store
        compiler:mut$LoweringBuilder
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[InstValue]
    {
        if plan.stores_inline then
            bytecode declared_type compiler.emit_typed_store
        else
            InstValue::Store64 bytecode.push
        fi
    }

    fn get_struct_field_plan
        compiler:mut$LoweringBuilder
        casa_struct:$common::CasaStruct
        member_index:u64
    -> common::FieldStoragePlan {
        if
            compiler.state.store member_index casa_struct common::plan_struct_member_storage
            std::Option::Some(plan) is
        then
            plan.clone return
        fi
        f"Cannot determine member {member_index} storage of struct `{casa_struct.name}`"
        compiler.record_failure_string
        false 0 1 0 common::FieldStoragePlan
    }

    fn struct_size compiler:mut$LoweringBuilder casa_struct:$common::CasaStruct -> u64 {
        casa_struct.name.clone common::GenericType::new common::Type::Generic = struct_type
        if compiler.state.store struct_type common::type_inline_size std::Option::Some(size) is then
            size return
        fi
        f"Cannot determine layout of struct `{casa_struct.name}`" compiler.record_failure_string
        0
    }

    fn get_enum_field_plan
        compiler:mut$LoweringBuilder
        casa_enum:$common::CasaEnum
        variant_name:$str
        payload_index:u64
    -> common::FieldStoragePlan {
        if
            compiler.state.store payload_index variant_name casa_enum
            common::plan_enum_payload_storage std::Option::Some(plan) is
        then
            plan.clone return
        fi
        f"Cannot determine payload {payload_index} storage of `{casa_enum.name}::{variant_name}`"
        compiler.record_failure_string
        false 0 1 0 common::FieldStoragePlan
    }

    fn enum_size compiler:mut$LoweringBuilder casa_enum:$common::CasaEnum -> u64 {
        casa_enum.name.clone common::GenericType::new common::Type::Generic = enum_type
        if compiler.state.store enum_type common::type_inline_size std::Option::Some(size) is then
            size return
        fi
        f"Cannot determine layout of enum `{casa_enum.name}`" compiler.record_failure_string
        0
    }
}

# ============================================================================
# Label management
# ============================================================================

impl LoweringState {
    fn new_label self:mut$LoweringState -> u64 {
        self.label_counter = value
        1 += self.label_counter
        value
    }

    fn op_identity_to_label self:mut$LoweringState address:i64 -> u64 {
        if address self.op_label_map.get_copy std::Option::Some(existing) is then
            existing
        else
            self.new_label = label
            label address self.op_label_map.set
            label
        fi
    }
}

impl LoweringBuilder {
    fn new_label self:mut$LoweringBuilder -> u64 { self.state.new_label }

    fn op_to_label self:mut$LoweringBuilder op:$common::Op -> u64 {
        op common::op_identity = address
        address self.state.op_identity_to_label
    }
}

# ============================================================================
# String/constant interning
# ============================================================================

fn intern_table table:mut$std::List[std::String] value:$str -> u64 {
    # Add value to table if not present, return its index.
    if value table common::string_list_contains then
        value table common::string_list_index u64::try_from.unwrap
    else
        table.length = table_index
        value.clone table.push_str
        table_index
    fi
}

impl LoweringBuilder {
    fn intern_string compiler:mut$LoweringBuilder value:$str -> u64 {
        value compiler
            .state
            .program
            .strings intern_table
    }
}

# ============================================================================
# Variable resolution
# ============================================================================

fn index_variable_list variables:$std::List[common::Variable] -> std::Map[std::String u64] {
    std::Map[std::String u64]::new = slots
    0 = index: u64
    for variable in variables.iter do
        if variable.name slots.has ! then
            index variable.name.clone slots.set
        fi
        1 += index
    done
    slots
}

fn has_copy_aggregate_storage typ:$common::Type store:$common::SymbolStore -> bool {
    if
        typ common::get_concrete_array_length.is_none
        store typ common::type_is_extern_struct ! &&
    then
        false return
    fi
    common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
    store copy_type typ semantics::type_has_satisfying_trait_impl
}

fn uses_inline_local_storage typ:$common::Type store:$common::SymbolStore -> bool {
    typ common::get_concrete_array_length.is_some store typ has_copy_aggregate_storage ||
}

fn local_variable_slot_width variable:$common::Variable store:$common::SymbolStore -> u64 {
    if store variable.typ uses_inline_local_storage then
        if store variable.typ common::type_inline_size std::Option::Some(size) is then
            size common::WORD_SIZE u64::try_from.unwrap 1 - +
            common::WORD_SIZE u64::try_from.unwrap / return
        fi
    fi
    1
}

fn index_local_variable_list
    variables:$std::List[common::Variable]
    store:$common::SymbolStore
-> std::Map[std::String u64] u64 {
    std::Map[std::String u64]::new = slots
    0 = next_slot: u64
    for variable in variables.iter do
        if variable.name slots.has ! then
            store variable local_variable_slot_width = width
            next_slot width + 1 - variable.name.clone slots.set
            width += next_slot
        fi
    done
    slots next_slot
}

fn index_root_variable_map
    variables:$std::Map[std::String common::Variable]
    store:$common::SymbolStore
-> std::Map[std::String u64] u64 {
    std::Map[std::String u64]::new = slots
    variables.keys = names
    0 = next_slot: u64
    for name in names.iter do
        if name.as_str variables.get_str std::Option::Some(variable) is then
            store variable local_variable_slot_width = width
            next_slot width + 1 - name.clone slots.set
            width += next_slot
        fi
    done
    slots next_slot
}

impl LoweringBuilder {
    fn allocate_local compiler:mut$LoweringBuilder -> u64 {
        compiler.locals_count = local_index
        1 += compiler.locals_count
        local_index
    }

    fn resolve_local compiler:mut$LoweringBuilder variable_name:$str -> u64 {
        if variable_name compiler.local_slots.get_copy_str std::Option::Some(local_index) is then
            local_index return
        fi
        if compiler.function std::Option::Some(function) is then
            f"Variable `{variable_name}` is missing while compiling `{function.name}`"
            compiler.record_failure_string
        else
            f"Variable `{variable_name}` is missing during backend lowering"
            compiler.record_failure_string
        fi
        0
    }

    fn find_local_inline_aggregate_type
        self:mut$LoweringBuilder
        variable_name:$str
    -> std::Option[common::Type] {
        if self.function std::Option::Some(function) is then
            for variable in function.variables.iter do
                if variable.name.as_str variable_name == then
                    if self.state.store variable.typ uses_inline_local_storage then
                        variable.typ.clone std::Option::Some return
                    fi
                fi
            done
        elif
            variable_name self
                .state
                .store
                .variables
                .get_str std::Option::Some(variable) is
        then
            if self.state.store variable.typ uses_inline_local_storage then
                variable.typ.clone std::Option::Some return
            fi
        fi
        std::Option[common::Type]::None
    }

    fn emit_variable_get
        compiler:mut$LoweringBuilder
        variable_name:$str
        move_owned:bool
        bytecode:mut$std::List[InstValue]
    {
        variable_name compiler.resolve_local = local_index
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            local_index InstValue::LocalAddress bytecode.push
            if move_owned then
                bytecode aggregate_type compiler.emit_typed_load
            fi
            return
        fi
        local_index InstValue::LocalGet bytecode.push
    }

    fn emit_variable_set
        compiler:mut$LoweringBuilder
        variable_name:$str
        bytecode:mut$std::List[InstValue]
    {
        variable_name compiler.resolve_local = local_index
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            local_index InstValue::LocalAddress bytecode.push
            bytecode aggregate_type compiler.emit_typed_store
            return
        fi
        local_index InstValue::LocalSet bytecode.push
    }
}

# ============================================================================
# Deterministic destruction
# ============================================================================

impl LoweringBuilder {
    fn is_copy_aggregate self:$LoweringBuilder typ:$common::Type -> bool {
        self.state.store typ has_copy_aggregate_storage
    }

    fn compile_drop_hook
        compiler:mut$LoweringBuilder
        store:$common::SymbolStore
        typ:$common::Type
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if store typ common::find_drop_function_name std::Option::Some(drop_name) is then
            drop_name.clone = function_name
            function_name.as_str store.get_function.unwrap = function: $common::Function
            if
                0 function
                    .stack_effect
                    .type_vars
                    .length != 0 function
                    .stack_effect
                    .const_params
                    .keys
                    .length != ||
            then
                function typ typechecker::function_receiver_bindings = bindings
                bindings function_name.as_str typechecker::monomorphized_function_name = function_name
            fi
            InstValue::Dup bytecode.push
            if op function_name.as_str compiler.compile_named_function then
                function_name InstValue::FnCall bytecode.push
            fi
        fi
    }

    # Destroy every element of an `array[T N]` value. The array stores nothing
    # but its elements, so the element count comes from the type (ADR-0152).
    fn compile_array_destruction
        compiler:mut$LoweringBuilder
        element_type:$common::Type
        length:$common::ConstType
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        compiler.allocate_local = array_local
        compiler.allocate_local = index_local
        array_local InstValue::LocalSet bytecode.push
        length.value InstValue::Push bytecode.push
        index_local InstValue::LocalSet bytecode.push

        compiler.new_label = start_label
        compiler.new_label = element_label
        compiler.new_label = end_label
        start_label InstValue::Label bytecode.push
        index_local InstValue::LocalGet bytecode.push
        0 InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        element_label InstValue::JumpNe bytecode.push
        end_label InstValue::Jump bytecode.push
        element_label InstValue::Label bytecode.push
        index_local InstValue::LocalGet bytecode.push
        1 InstValue::Push bytecode.push
        InstValue::Sub bytecode.push
        index_local InstValue::LocalSet bytecode.push
        array_local InstValue::LocalGet bytecode.push
        index_local InstValue::LocalGet bytecode.push
        bytecode element_type compiler.emit_inline_size
        InstValue::Mul bytecode.push
        InstValue::Add bytecode.push
        bytecode element_type compiler.emit_typed_load
        bytecode op element_type compiler.compile_destruction
        start_label InstValue::Jump bytecode.push
        end_label InstValue::Label bytecode.push
        array_local InstValue::LocalGet bytecode.push
    }

    fn compile_struct_fields
        compiler:mut$LoweringBuilder
        typ:$common::Type
        casa_struct:$common::CasaStruct
        skipped:mut$std::List[std::String]
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        casa_struct.type_vars typ common::aggregate_type_bindings = substitutions
        casa_struct.members.length = member_index
        while 0 member_index != do
            1 -= member_index
            member_index casa_struct.members.get = member
            if member.name.as_str skipped common::string_list_contains then
                continue
            fi
            substitutions member.typ.substitute_t = member_type
            InstValue::Dup bytecode.push
            member_index casa_struct compiler.get_struct_field_plan = plan
            if 0 plan.offset != then
                plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::Add bytecode.push
            fi
            bytecode plan member.typ compiler.emit_field_load
            bytecode op member_type compiler.compile_destruction
        done
        InstValue::HeapFree bytecode.push
    }

    fn compile_enum_variant_fields
        compiler:mut$LoweringBuilder
        typ:$common::Type
        casa_enum:$common::CasaEnum
        variant_name:$str
        skipped_count:u64
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        casa_enum.type_vars typ common::aggregate_type_bindings = substitutions
        if variant_name casa_enum.variant_types.get_str std::Option::Some(payload_types) is then
            payload_types.length = payload_index
            while skipped_count payload_index > do
                1 -= payload_index
                substitutions payload_index payload_types.get.substitute_t = payload_type
                InstValue::Dup bytecode.push
                payload_index variant_name casa_enum compiler.get_enum_field_plan = plan
                plan.offset i64::try_from.unwrap
                InstValue::Push bytecode.push
                InstValue::Add bytecode.push
                bytecode plan payload_index payload_types.get compiler.emit_field_load
                bytecode op payload_type compiler.compile_destruction
            done
        fi
        InstValue::HeapFree bytecode.push
    }

    fn compile_enum_fields
        compiler:mut$LoweringBuilder
        typ:$common::Type
        casa_enum:$common::CasaEnum
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        compiler.allocate_local = enum_local
        enum_local InstValue::LocalSet bytecode.push
        compiler.new_label = end_label
        0 = variant_index: u64
        while variant_index casa_enum.variants.length > do
            compiler.new_label = next_label
            enum_local InstValue::LocalGet bytecode.push
            InstValue::Load64 bytecode.push
            variant_index i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Eq bytecode.push
            next_label InstValue::JumpNe bytecode.push
            enum_local InstValue::LocalGet bytecode.push
            variant_index casa_enum.variants.get = variant_name
            bytecode op 0 variant_name.as_str casa_enum typ compiler.compile_enum_variant_fields
            end_label InstValue::Jump bytecode.push
            next_label InstValue::Label bytecode.push
            1 += variant_index
        done
        end_label InstValue::Label bytecode.push
    }

    fn compile_destruction_body
        compiler:mut$LoweringBuilder
        typ:$common::Type
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if typ.is_borrow then
            InstValue::Drop bytecode.push return
        fi
        if typ common::Type::Function(_) is then
            InstValue::ClosureDrop bytecode.push return
        fi
        if typ compiler.is_copy_aggregate then
            InstValue::HeapFreeIfAllocated bytecode.push return
        fi
        bytecode op typ compiler.state.store compiler.compile_drop_hook
        typ.clone = destruction_type
        if destruction_type.clone common::Type::Generic(generic) is then
            if common::ARRAY_TYPE generic.base.as_str == then
                if destruction_type common::get_array_length_parameter std::Option::Some(array_length) is then
                    bytecode op array_length 0 generic.params.get compiler.compile_array_destruction
                    InstValue::HeapFree bytecode.push
                else
                    InstValue::Drop bytecode.push
                fi
                return
            fi
            if
                generic.base compiler
                    .state
                    .store
                    .structs
                    .get std::Option::Some(owned_struct) is
            then
                std::List[std::String]::new = skipped
                bytecode op skipped owned_struct typ compiler.compile_struct_fields
                return
            fi
            if
                generic.base compiler
                    .state
                    .store
                    .enums
                    .get std::Option::Some(owned_enum) is
            then
                if owned_enum common::has_inner_values then
                    bytecode op owned_enum typ compiler.compile_enum_fields
                else
                    InstValue::Drop bytecode.push
                fi
                return
            fi
        fi
        InstValue::Drop bytecode.push
    }

    fn destruction_needs_function compiler:mut$LoweringBuilder typ:$common::Type -> bool {
        compiler.state.store typ common::type_needs_destruction_in_store
    }

    fn ensure_destruction_function
        compiler:mut$LoweringBuilder
        typ:$common::Type
        op:$common::Op
    -> std::String {
        f"__drop_{typ.format}" = function_name
        if
            function_name compiler
                .state
                .program
                .functions
                .has
        then
            function_name return
        fi
        std::List[InstValue]::new function_name.clone compiler
            .state
            .program
            .functions
            .set

        std::List[common::Op]::new = empty_ops
        common::empty_location empty_ops function_name.clone common::Function::new = function
        std::List[common::Op]::new = destructor_ops
        destructor_ops function compiler.child = destructor
        std::List[InstValue]::new = body
        body op typ destructor.compile_destruction_body
        if destructor.has_failed then
            function_name return
        fi

        std::List[InstValue]::new = function_bytecode
        if 0 destructor.locals_count != then
            destructor.locals_count InstValue::LocalsInit function_bytecode.push
        fi
        body function_bytecode.append
        if 0 destructor.locals_count != then
            destructor.locals_count InstValue::LocalsUninit function_bytecode.push
        fi
        InstValue::FnReturn function_bytecode.push
        function_bytecode function_name.clone compiler
            .state
            .program
            .functions
            .set
        function_name
    }

    fn compile_destruction
        compiler:mut$LoweringBuilder
        typ:$common::Type
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if typ compiler.destruction_needs_function ! then
            InstValue::Drop bytecode.push
            return
        fi
        op typ compiler.ensure_destruction_function = function_name
        function_name InstValue::FnCall bytecode.push
    }

    fn compile_enum_pattern_destruction
        compiler:mut$LoweringBuilder
        store:$common::SymbolStore
        op:$common::Op
        variant:$common::EnumVariant
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if typ compiler.destruction_needs_function ! then
            InstValue::Drop bytecode.push
            return
        fi
        bytecode op typ store compiler.compile_drop_hook
        if typ.clone common::Type::Generic(generic) is then
            if generic.base store.enums.get std::Option::Some(owned_enum) is then
                if owned_enum common::has_inner_values then
                    variant.bindings.length = skipped_count
                    bytecode op skipped_count variant.variant_name.as_str owned_enum typ
                    compiler.compile_enum_variant_fields
                    return
                fi
            fi
        fi
        InstValue::Drop bytecode.push
    }

    fn compile_match_destruction
        compiler:mut$LoweringBuilder
        store:$common::SymbolStore
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if op.type_hint std::Option::None is then
            InstValue::Drop bytecode.push return
        fi
        op
            .type_hint
            .clone
            .unwrap = typ
        if op common::pattern_value_of common::PatternValue::EnumVariant(variant) is then
            if op pattern::pattern_is_wildcard ! then
                bytecode typ variant op store compiler.compile_enum_pattern_destruction
                return
            fi
        fi
        if typ compiler.destruction_needs_function ! then
            InstValue::Drop bytecode.push
            return
        fi
        bytecode op typ store compiler.compile_drop_hook
        if typ.clone common::Type::Generic(generic) is then
            if generic.base store.structs.get std::Option::Some(owned_struct) is then
                std::List[std::String]::new = skipped
                if op common::pattern_value_of common::PatternValue::Struct(struct_pattern) is then
                    struct_pattern.bindings.keys = skipped
                fi
                bytecode op skipped owned_struct typ compiler.compile_struct_fields
                return
            fi
            if generic.base store.enums.get std::Option::Some(owned_enum) is then
                if owned_enum common::has_inner_values ! then
                    InstValue::Drop bytecode.push return
                fi
                if op common::pattern_value_of common::PatternValue::EnumVariant(variant) is then
                    bytecode op owned_enum typ compiler.compile_enum_fields
                    return
                fi
            fi
        fi
        InstValue::Drop bytecode.push
    }

    fn owner_flag compiler:mut$LoweringBuilder name:$str -> u64 {
        if name compiler.owner_flags.get_copy_str std::Option::Some(flag) is then
            flag return
        fi
        compiler.allocate_local = flag
        flag name.clone compiler.owner_flags.set_str
        flag
    }

    fn set_owner_flag
        compiler:mut$LoweringBuilder
        name:$str
        value:u64
        bytecode:mut$std::List[InstValue]
    {
        name compiler.owner_flag = flag
        value i64::try_from.unwrap InstValue::Push bytecode.push
        flag InstValue::LocalSet bytecode.push
    }

    fn compile_variable_destruction
        compiler:mut$LoweringBuilder
        variable_name:$str
        typ:$common::Type
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            variable_name compiler.resolve_local = local_index
            local_index InstValue::LocalAddress bytecode.push
            bytecode op aggregate_type compiler.state.store compiler.compile_drop_hook
            if aggregate_type common::get_array_length_parameter std::Option::Some(array_length) is then
                if aggregate_type.array_element_type std::Option::Some(element_type) is then
                    bytecode op array_length element_type compiler.compile_array_destruction
                    InstValue::Drop bytecode.push
                    return
                fi
            fi
            InstValue::Drop bytecode.push
            return
        fi
        variable_name compiler.resolve_local InstValue::LocalGet bytecode.push
        bytecode op typ compiler.compile_destruction
    }

    fn compile_active_owner_cleanup
        compiler:mut$LoweringBuilder
        event:$common::OwnerEvent
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        event.name.as_str compiler.owner_flag = flag
        compiler.new_label = cleanup_label
        compiler.new_label = end_label
        flag InstValue::LocalGet bytecode.push
        0 InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        cleanup_label InstValue::JumpNe bytecode.push
        end_label InstValue::Jump bytecode.push
        cleanup_label InstValue::Label bytecode.push
        bytecode op event.typ event.name.as_str compiler.compile_variable_destruction
        bytecode 0 event.name.as_str compiler.set_owner_flag
        end_label InstValue::Label bytecode.push
    }

    fn compile_owner_cleanup
        compiler:mut$LoweringBuilder
        event:$common::OwnerEvent
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        event.name.as_str compiler.owner_flag = flag
        compiler.new_label = end_label
        flag InstValue::LocalGet bytecode.push
        event.generation i64::try_from.unwrap InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        end_label InstValue::JumpNe bytecode.push
        bytecode op event.typ event.name.as_str compiler.compile_variable_destruction
        bytecode 0 event.name.as_str compiler.set_owner_flag
        end_label InstValue::Label bytecode.push
    }

    fn compile_owner_cleanups
        compiler:mut$LoweringBuilder
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if op.ownership std::Option::Some(ownership) is then
            for event in ownership.cleanups.iter do
                bytecode op event compiler.compile_owner_cleanup
            done
        fi
    }
}

# ============================================================================
# Control-flow targets
# ============================================================================

fn make_control_flow_failure message:$str -> std::Result[ControlFlowTargets BackendFailure] {
    message.to_str BackendFailure::new std::Result::Error
}

fn make_if_end_failure has_open_if:bool -> std::Result[ControlFlowTargets BackendFailure] {
    if has_open_if then
        "`if` without matching `fi`" make_control_flow_failure return
    fi
    "`fi` without parent `if`" make_control_flow_failure
}

fn make_open_while_failure
    ops:$std::List[common::Op]
    frame:$WhileTargetFrame
-> std::Result[ControlFlowTargets BackendFailure] {
    if frame.first_end_target_op ops.length != then
        if frame.first_end_target_op ops.get.value common::OpValue::WhileCondition is then
            "`do` without matching `done`" make_control_flow_failure return
        fi
        "`break` without matching `done`" make_control_flow_failure return
    fi
    "`while` without matching `done`" make_control_flow_failure
}

fn is_current_control_flow ops:$std::List[common::Op] op_index:u64 kind:ControlFlowKind -> bool {
    if op_index ops.length == then
        false return
    fi
    kind match
        ControlFlowKind::If => op_index ops.get.value common::OpValue::IfStart is
        ControlFlowKind::While => op_index ops.get.value common::OpValue::WhileStart is
        ControlFlowKind::Match => op_index ops.get.value common::OpValue::MatchStart is
    end
}
# Build the target index once before emitting an operation sequence.
fn precompute_control_flow_targets
    ops:$std::List[common::Op]
-> std::Result[ControlFlowTargets BackendFailure] {
    ops.length ControlFlowTargets::new = targets
    ops.length make_if_target_frames = if_frames
    ops.length make_while_target_frames = while_frames
    ops.length make_match_target_frames = match_frames
    ops.length = current_block

    0 = index: u64
    while index ops.length > do
        index targets.initialize
        index ops.get.value match
            common::OpValue::IfStart => {
                ops.length index IfTargetFrame if_frames.push
                current_block index targets.set_parent
                index = current_block
            }
            common::OpValue::IfCondition => {
                if ControlFlowKind::If current_block ops is_current_control_flow ! then
                    "`then` without matching `if`" make_control_flow_failure return
                fi
                if_frames.length 1 - if_frames.get_mut = frame
                frame.start index targets.set_start
                index = frame.branch
            }
            common::OpValue::IfElif => {
                if ControlFlowKind::If current_block ops is_current_control_flow ! then
                    "`elif` without parent `if`" make_control_flow_failure return
                fi
                if_frames.length 1 - if_frames.get_mut = frame
                if frame.branch ops.length != then
                    index frame.branch targets.set_next
                fi
                frame.start index targets.set_start
                index = frame.branch
            }
            common::OpValue::IfElse => {
                if ControlFlowKind::If current_block ops is_current_control_flow ! then
                    "`else` without parent `if`" make_control_flow_failure return
                fi
                if_frames.length 1 - if_frames.get_mut = frame
                if frame.branch ops.length != then
                    index frame.branch targets.set_next
                fi
                frame.start index targets.set_start
                index = frame.branch
            }
            common::OpValue::IfEnd => {
                if ControlFlowKind::If current_block ops is_current_control_flow ! then
                    if_frames.is_empty ! make_if_end_failure return
                fi
                current_block targets.get_parent = current_block
                if_frames.pop = frame
                frame.start index targets.set_start
                index frame.start targets.set_end
                if frame.branch ops.length != then
                    index frame.branch targets.set_next
                fi
            }
            common::OpValue::WhileStart => {
                ops.length index WhileTargetFrame while_frames.push
                current_block index targets.set_parent
                index = current_block
            }
            common::OpValue::WhileCondition => {
                if ControlFlowKind::While current_block ops is_current_control_flow ! then
                    "`do` without parent `while`" make_control_flow_failure return
                fi
                while_frames.length 1 - while_frames.get_mut = frame
                frame.start index targets.set_start
                if frame.first_end_target_op ops.length == then
                    index = frame.first_end_target_op
                fi
            }
            common::OpValue::WhileBreak => {
                if while_frames.is_empty then
                    "`break` without parent `while`" make_control_flow_failure return
                fi
                while_frames.length 1 - while_frames.get_mut = frame
                frame.start index targets.set_start
                if frame.first_end_target_op ops.length == then
                    index = frame.first_end_target_op
                fi
            }
            common::OpValue::WhileContinue => {
                if while_frames.is_empty then
                    "`continue` without parent `while`" make_control_flow_failure return
                fi
                while_frames.length 1 - while_frames.get.start index targets.set_start
            }
            common::OpValue::WhileEnd => {
                if ControlFlowKind::While current_block ops is_current_control_flow ! then
                    "`done` without parent `while`" make_control_flow_failure return
                fi
                current_block targets.get_parent = current_block
                while_frames.pop = frame
                frame.start index targets.set_start
                index frame.start targets.set_end
            }
            common::OpValue::MatchStart => {
                ops.length index MatchTargetFrame match_frames.push
                current_block index targets.set_parent
                index = current_block
            }
            common::OpValue::MatchArm(_) => {
                if ControlFlowKind::Match current_block ops is_current_control_flow ! then
                    "`match` arm without parent `match`" make_control_flow_failure return
                fi
                match_frames.length 1 - match_frames.get_mut = frame
                if frame.arm ops.length != then
                    index frame.arm targets.set_next
                fi
                frame.start index targets.set_start
                index = frame.arm
            }
            common::OpValue::MatchEnd => {
                if ControlFlowKind::Match current_block ops is_current_control_flow ! then
                    "`end` without parent `match`" make_control_flow_failure return
                fi
                current_block targets.get_parent = current_block
                match_frames.pop = frame
                frame.start index targets.set_start
                index frame.start targets.set_end
                if frame.arm ops.length != then
                    index frame.arm targets.set_next
                fi
            }
            _ => {
            }
        end
        1 += index
    done

    if current_block ops.length != then
        current_block ops.get.value match
            common::OpValue::IfStart => {
                "`if` without matching `fi`" make_control_flow_failure return
            }
            common::OpValue::WhileStart => {
                while_frames.length 1 - while_frames.get = frame
                frame ops make_open_while_failure return
            }
            common::OpValue::MatchStart => {
                match_frames.length 1 - match_frames.get = frame
                if frame.arm ops.length != then
                    "`match` arm without matching `end`" make_control_flow_failure return
                fi
                "`match` without matching `end`" make_control_flow_failure return
            }
            _ => "Unrecognized open control-flow block" make_control_flow_failure return
        end
    fi
    targets std::Result::Ok
}

# ============================================================================
# Compile assignment
# ============================================================================

impl common::OpValue {
    fn produces_integer_result self:$common::OpValue -> bool {
        self match
            common::OpValue::Add => true
            common::OpValue::Sub => true
            common::OpValue::Mul => true
            common::OpValue::Div => true
            common::OpValue::Mod => true
            common::OpValue::Shl => true
            common::OpValue::Shr => true
            common::OpValue::BitAnd => true
            common::OpValue::BitOr => true
            common::OpValue::BitXor => true
            common::OpValue::BitNot => true
            common::OpValue::AssignInc => true
            common::OpValue::AssignDec => true
            common::OpValue::WrappingAdd => true
            common::OpValue::WrappingSub => true
            common::OpValue::WrappingMul => true
            _ => false
        end
    }

    fn select_typed_instruction
        self:$common::OpValue
        direct:InstValue
        builtin:$common::BuiltinType
    -> InstValue {
        if builtin.is_float then
            if builtin common::BuiltinType::F32 == then
                self match
                    common::OpValue::Add => InstValue::FloatAdd32
                    common::OpValue::Sub => InstValue::FloatSub32
                    common::OpValue::Mul => InstValue::FloatMul32
                    common::OpValue::Div => InstValue::FloatDiv32
                    common::OpValue::Eq => InstValue::FloatEq32
                    common::OpValue::Ne => InstValue::FloatNe32
                    common::OpValue::Lt => InstValue::FloatLt32
                    common::OpValue::Le => InstValue::FloatLe32
                    common::OpValue::Gt => InstValue::FloatGt32
                    common::OpValue::Ge => InstValue::FloatGe32
                    _ => direct
                end
            else
                self match
                    common::OpValue::Add => InstValue::FloatAdd64
                    common::OpValue::Sub => InstValue::FloatSub64
                    common::OpValue::Mul => InstValue::FloatMul64
                    common::OpValue::Div => InstValue::FloatDiv64
                    common::OpValue::Eq => InstValue::FloatEq64
                    common::OpValue::Ne => InstValue::FloatNe64
                    common::OpValue::Lt => InstValue::FloatLt64
                    common::OpValue::Le => InstValue::FloatLe64
                    common::OpValue::Gt => InstValue::FloatGt64
                    common::OpValue::Ge => InstValue::FloatGe64
                    _ => direct
                end
            fi
            return
        fi
        self match
            common::OpValue::Add => {
                builtin copy InstValue::CheckedAdd return
            }
            common::OpValue::Sub => {
                builtin copy InstValue::CheckedSub return
            }
            common::OpValue::Mul => {
                builtin copy InstValue::CheckedMul return
            }
            common::OpValue::Div => {
                builtin copy InstValue::CheckedDiv return
            }
            common::OpValue::Mod => {
                builtin copy InstValue::CheckedMod return
            }
            common::OpValue::Shl => {
                builtin copy InstValue::CheckedShl return
            }
            common::OpValue::Shr => {
                builtin copy InstValue::CheckedShr return
            }
            _ => {
            }
        end
        if builtin.is_unsigned ! then
            direct return
        fi
        self match
            common::OpValue::Div => InstValue::UDiv
            common::OpValue::Mod => InstValue::UMod
            common::OpValue::Shr => InstValue::UShr
            common::OpValue::Lt => InstValue::Ult
            common::OpValue::Le => InstValue::Ule
            common::OpValue::Gt => InstValue::Ugt
            common::OpValue::Ge => InstValue::Uge
            common::OpValue::PrintInt => InstValue::PrintUint
            _ => direct
        end
    }
}

impl LoweringBuilder {
    fn emit_integer_normalization
        compiler:mut$LoweringBuilder
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if op.value.produces_integer_result ! then
            return
        fi
        if op.type_hint std::Option::Some(type_hint) is then
            if type_hint common::Type::Builtin(builtin) is then
                if builtin.is_integer ! then
                    return
                fi
                builtin InstValue::NormalizeInt bytecode.push
            fi
        fi
    }

    fn compile_assignment
        compiler:mut$LoweringBuilder
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        op common::op_str_value = name
        if name compiler.capture_slots.get_copy std::Option::Some(capture_index) is then
            false = owns_capture
            common::make_unknown_type.clone = capture_type
            if compiler.function std::Option::Some(function) is then
                name.as_str function.owned_captures common::string_list_contains = owns_capture
                capture_index function.captures.get common::Variable::typ.clone = capture_type
            fi
            if op.value common::OpValue::AssignVar is then
                if owns_capture then
                    compiler.new_label = inactive_label
                    capture_index InstValue::CaptureFlagLoad bytecode.push
                    0 InstValue::Push bytecode.push
                    InstValue::Ne bytecode.push
                    inactive_label InstValue::JumpNe bytecode.push
                    capture_index InstValue::CaptureLoad bytecode.push
                    bytecode op capture_type compiler.compile_destruction
                    inactive_label InstValue::Label bytecode.push
                fi
                if owns_capture capture_type compiler.is_copy_aggregate && then
                    InstValue::Dup bytecode.push
                    bytecode capture_type compiler.emit_typed_load
                    InstValue::Swap bytecode.push
                    InstValue::HeapFreeIfAllocated bytecode.push
                fi
                capture_index InstValue::CaptureSet bytecode.push
                if owns_capture then
                    capture_index InstValue::CaptureFlagMark bytecode.push
                fi
                return
            fi
            capture_index InstValue::CaptureLoad bytecode.push
            if op.value common::OpValue::AssignDec is then
                InstValue::Swap bytecode.push
                InstValue::Sub bytecode.push
            elif op.value common::OpValue::AssignInc is then
                InstValue::Add bytecode.push
            else
                "compile_assignment received an unsupported capture assignment" compiler.record_failure
                return
            fi
            bytecode op compiler.emit_integer_normalization
            capture_index InstValue::CaptureSet bytecode.push
            return
        fi
        name.as_str compiler.resolve_local = local_index

        op.value match
            common::OpValue::AssignDec => {
                local_index InstValue::LocalGet bytecode.push
                InstValue::Swap bytecode.push
                InstValue::Sub = instruction
                if op.type_hint std::Option::Some(type_hint) is then
                    if type_hint common::Type::Builtin(builtin) is then
                        builtin InstValue::CheckedSub = instruction
                    fi
                fi
                instruction bytecode.push
                bytecode op compiler.emit_integer_normalization
                local_index InstValue::LocalSet bytecode.push
            }
            common::OpValue::AssignInc => {
                local_index InstValue::LocalGet bytecode.push
                InstValue::Add = instruction
                if op.type_hint std::Option::Some(type_hint) is then
                    if type_hint common::Type::Builtin(builtin) is then
                        builtin InstValue::CheckedAdd = instruction
                    fi
                fi
                instruction bytecode.push
                bytecode op compiler.emit_integer_normalization
                local_index InstValue::LocalSet bytecode.push
            }
            common::OpValue::AssignVar => bytecode name.as_str compiler.emit_variable_set
            common::OpValue::Question(_) => bytecode name.as_str compiler.emit_variable_set
            _ => {
                "compile_assignment received a non-assignment operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile if block
# ============================================================================

impl LoweringBuilder {
    fn compile_if_block
        self:mut$LoweringBuilder
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        bytecode:mut$std::List[InstValue]
    {
        op.value match
            common::OpValue::IfCondition => {
                if op_index targets.get_next std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = end_label
                    end_label InstValue::JumpNe bytecode.push
                else
                    "If condition target is missing during backend lowering" self.record_failure
                fi
            }
            common::OpValue::IfElif => {
                op_index ops.get self.op_to_label = elif_label
                if op_index targets.get_end std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = end_label_2
                    bytecode op self.compile_owner_cleanups
                    end_label_2 InstValue::Jump bytecode.push
                    elif_label InstValue::Label bytecode.push
                    bytecode op self.compile_owner_cleanups
                else
                    "Elif end target is missing during backend lowering" self.record_failure
                fi
            }
            common::OpValue::IfElse => {
                op_index ops.get self.op_to_label = else_label
                if op_index targets.get_end std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = end_label_3
                    bytecode op self.compile_owner_cleanups
                    end_label_3 InstValue::Jump bytecode.push
                    else_label InstValue::Label bytecode.push
                    bytecode op self.compile_owner_cleanups
                else
                    "Else end target is missing during backend lowering" self.record_failure
                fi
            }
            common::OpValue::IfEnd => {
                op_index ops.get self.op_to_label = fi_label
                bytecode op self.compile_owner_cleanups
                fi_label InstValue::Label bytecode.push
                bytecode op self.compile_owner_cleanups
            }
            common::OpValue::IfStart => {
            }
            _ => {
                "compile_if_block received a non-if operation" self.record_failure
            }
        end
    }
}

# ============================================================================
# Compile while block
# ============================================================================

impl LoweringBuilder {
    fn compile_while_block
        self:mut$LoweringBuilder
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        bytecode:mut$std::List[InstValue]
    {
        op.value match
            common::OpValue::WhileBreak => {
                if op_index targets.get_end std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = end_label
                    end_label InstValue::Jump bytecode.push
                else
                    "Break target is missing during backend lowering" self.record_failure
                fi
            }
            common::OpValue::WhileCondition => {
                if op_index targets.get_end std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = end_label_2
                    end_label_2 InstValue::JumpNe bytecode.push
                else
                    "While condition target is missing during backend lowering" self.record_failure
                fi
            }
            common::OpValue::WhileContinue => {
                if op_index targets.get_start std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = continue_target
                    continue_target InstValue::Jump bytecode.push
                else
                    "Continue target is missing during backend lowering" self.record_failure
                fi
            }
            common::OpValue::WhileEnd => {
                op_index ops.get self.op_to_label = while_label
                if op_index targets.get_start std::Option::Some(target_index) is then
                    target_index ops.get self.op_to_label = loop_start
                    bytecode op self.compile_owner_cleanups
                    loop_start InstValue::Jump bytecode.push
                    while_label InstValue::Label bytecode.push
                    bytecode op self.compile_owner_cleanups
                else
                    "While start target is missing during backend lowering" self.record_failure
                fi
            }
            common::OpValue::WhileStart => {
                op_index ops.get self.op_to_label = start_label
                start_label InstValue::Label bytecode.push
            }
            _ => {
                "compile_while_block received a non-while operation" self.record_failure
            }
        end
    }
}

# ============================================================================
# Compile match block
# ============================================================================
# compile_match_op — per-arm bytecode entry point dispatching on PatternValue.
# Replaces the three former compile_match_arm_* helpers and consolidates
# literal / enum / struct emission behind a single pattern-driven function.

impl LoweringBuilder {
    fn emit_struct_arm
        compiler:mut$LoweringBuilder
        store:$common::SymbolStore
        struct_pattern:common::StructPattern
        bytecode:mut$std::List[InstValue]
    {
        struct_pattern common::StructPattern::struct_name store.structs.get = casa_struct_opt
        if casa_struct_opt.is_none then
            f"Struct `{struct_pattern.struct_name}` is missing during backend lowering" compiler.record_failure_string
            return
        fi
        casa_struct_opt.unwrap = casa_struct
        0 = index: u64
        while index casa_struct common::CasaStruct::members.length > do
            index casa_struct common::CasaStruct::members.get = member
            member common::Member::name.as_str = field_name: $str
            index casa_struct compiler.get_struct_field_plan = plan
            if
                field_name struct_pattern common::StructPattern::bindings.get_str std::Option::Some(var_name) is
            then
                InstValue::Dup bytecode.push
                if 0 plan.offset > then
                    plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                    InstValue::Add bytecode.push
                fi
                bytecode plan member.typ compiler.emit_field_load
                bytecode var_name.as_str compiler.emit_variable_set
            fi
            1 += index
        done
    }
}

fn emit_int_eq value:$i64 bytecode:mut$std::List[InstValue] {
    value copy InstValue::Push bytecode.push
    InstValue::Eq bytecode.push
}

fn require_variant_ordinal variant:$common::EnumVariant compiler:mut$LoweringBuilder -> i64 {
    if variant.ordinal std::Option::Some(ordinal) is then
        ordinal return
    fi
    f"Enum variant `{variant.variant_name}` has no ordinal during backend lowering" compiler.record_failure_string
    0
}

impl LoweringBuilder {
    fn emit_literal_arm
        compiler:mut$LoweringBuilder
        literal_pattern:common::LiteralPattern
        is_last:bool
        next_arm:mut$std::Option[u64]
        bytecode:mut$std::List[InstValue]
    {
        if is_last then
            return
        fi
        InstValue::Dup bytecode.push
        literal_pattern.value match
            common::LiteralValue::Str(str_value) => {
                str_value.as_str compiler.intern_string = str_index
                str_index InstValue::PushStr bytecode.push
                InstValue::StrEq bytecode.push
            }
            common::LiteralValue::Int(int_value) => {
                bytecode int_value.value emit_int_eq
            }
            common::LiteralValue::Char(char_value) => {
                bytecode char_value emit_int_eq
            }
            common::LiteralValue::Bool(bool_value) => {
                bytecode if bool_value then 1 else 0 fi emit_int_eq
            }
        end
        if next_arm std::Option::Some(label) is then
            label InstValue::JumpNe bytecode.push
        else
            "Match arm has no following label during backend lowering" compiler.record_failure
        fi
    }
}

impl LoweringBuilder {
    fn emit_enum_arm
        compiler:mut$LoweringBuilder
        variant:$common::EnumVariant
        is_wildcard:bool
        is_last:bool
        next_arm:mut$std::Option[u64]
        bytecode:mut$std::List[InstValue]
    {
        if is_wildcard then
            return
        fi
        variant.enum_name.as_str = enum_name: $str
        if
            "" enum_name.as_str != enum_name compiler
                .state
                .store
                .enums
                .has_str &&
        then
            enum_name compiler
                .state
                .store
                .enums
                .get_str
                .unwrap
                .clone = casa_enum
            if casa_enum common::has_inner_values then
                if is_last ! then
                    InstValue::Dup bytecode.push
                    InstValue::Load64 bytecode.push
                    compiler variant require_variant_ordinal InstValue::Push bytecode.push
                    InstValue::Eq bytecode.push
                    if next_arm std::Option::Some(label) is then
                        label InstValue::JumpNe bytecode.push
                    else
                        "Match arm has no following label during backend lowering" compiler.record_failure
                    fi
                fi
                casa_enum variant bytecode compiler.emit_enum_arm_bindings
                return
            fi
        fi

        if is_last then
            return
        fi
        InstValue::Dup bytecode.push
        compiler variant require_variant_ordinal InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        if next_arm std::Option::Some(label) is then
            label InstValue::JumpNe bytecode.push
        else
            "Match arm has no following label during backend lowering" compiler.record_failure
        fi
    }
}

impl LoweringBuilder {
    fn emit_enum_arm_bindings
        compiler:mut$LoweringBuilder
        bytecode:mut$std::List[InstValue]
        variant:$common::EnumVariant
        casa_enum:$common::CasaEnum
    {
        variant.variant_name casa_enum
            .variant_types
            .get
            .unwrap = payload_types
        0 = index: u64
        while index variant common::EnumVariant::bindings.length > do
            index variant.variant_name.as_str casa_enum compiler.get_enum_field_plan = plan
            InstValue::Dup bytecode.push
            plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            bytecode plan index payload_types.get compiler.emit_field_load
            index variant common::EnumVariant::bindings.get = var_name
            bytecode var_name.as_str compiler.emit_variable_set
            1 += index
        done
    }
}

impl LoweringBuilder {
    fn compile_match_op
        self:mut$LoweringBuilder
        op:$common::Op
        next_arm:mut$std::Option[u64]
        bytecode:mut$std::List[InstValue]
        is_last:bool
    {
        op common::pattern_value_of match
            common::PatternValue::Struct(struct_pattern) => {
                bytecode struct_pattern self.state.store self.emit_struct_arm
            }
            common::PatternValue::Literal(literal_pattern) => {
                bytecode next_arm is_last literal_pattern self.emit_literal_arm
            }
            common::PatternValue::EnumVariant(variant) => {
                op pattern::pattern_is_wildcard = is_wildcard
                bytecode next_arm is_last is_wildcard variant self.emit_enum_arm
            }
        end
        if op.value common::OpValue::MatchArm(arm) is then
            if arm.guard_ops.length 0 != then
                bytecode arm.guard_ops self.compile_sequence
                if next_arm std::Option::Some(label) is then
                    label InstValue::JumpNe bytecode.push
                else
                    "Guarded match arm has no following label during backend lowering" self.record_failure
                fi
            fi
        fi
        if op.ownership std::Option::Some(ownership) is then
            for event in ownership.assignments.iter do
                bytecode event.generation event.name.as_str self.set_owner_flag
            done
        fi
        bytecode op self.state.store self.compile_match_destruction
    }
}

impl LoweringBuilder {
    fn compile_match_block
        self:mut$LoweringBuilder
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        bytecode:mut$std::List[InstValue]
    {
        if op.value common::OpValue::MatchArm is then
            0 = end_label: u64
            if op_index targets.get_end std::Option::Some(target_index) is then
                target_index ops.get self.op_to_label = end_label
            else
                "Match end target is missing during backend lowering" self.record_failure
                return
            fi

            op_index ops.get common::op_identity self
                .state
                .op_label_map
                .get_copy = existing
            existing.is_some ! = is_first

            if is_first ! then
                bytecode op self.compile_owner_cleanups
                end_label InstValue::Jump bytecode.push
                if existing std::Option::Some(label) is then
                    label InstValue::Label bytecode.push
                    bytecode op self.compile_owner_cleanups
                else
                    "Match arm label is missing during backend lowering" self.record_failure
                fi
            fi

            0 = next_index: u64
            if op_index targets.get_next std::Option::Some(found_next_index) is then
                found_next_index = next_index
            else
                "Match arm target is missing during backend lowering" self.record_failure
                return
            fi
            next_index ops.get.value common::OpValue::MatchEnd is = is_last
            std::Option[u64]::None = next_arm
            if is_last ! then
                next_index ops.get self.op_to_label std::Option::Some = next_arm
            fi

            is_last bytecode next_arm op self.compile_match_op
        elif op.value common::OpValue::MatchEnd is then
            op_index ops.get self.op_to_label = end_match_label
            bytecode op self.compile_owner_cleanups
            end_match_label InstValue::Label bytecode.push
            bytecode op self.compile_owner_cleanups
        fi
    }
}

# ============================================================================
# Compile struct new
# ============================================================================

impl LoweringBuilder {
    fn compile_struct_new
        compiler:mut$LoweringBuilder
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if op.value common::OpValue::StructNew(casa_struct) is then
            casa_struct common::CasaStruct::members.length = count
            casa_struct compiler.struct_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::HeapAlloc bytecode.push
            0 = index: u64
            while index count > do
                InstValue::Swap bytecode.push
                InstValue::Over bytecode.push
                index casa_struct compiler.get_struct_field_plan = plan
                if 0 plan.offset > then
                    plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                    InstValue::Add bytecode.push
                fi
                index casa_struct.members.get = member
                bytecode plan member.typ compiler.emit_field_store
                1 += index
            done
        fi
    }
}

# ============================================================================
# Compile enum variant
# ============================================================================

impl LoweringBuilder {
    fn compile_enum_variant
        compiler:mut$LoweringBuilder
        variant:$common::EnumVariant
        casa_enum:$common::CasaEnum
        bytecode:mut$std::List[InstValue]
    {
        variant.variant_name.clone = variant_name
        variant_name casa_enum common::CasaEnum::variant_types.get = types_opt
        std::List[common::Type]::new = types
        0 = inner_count: u64
        if types_opt std::Option::Some(found_types) is then
            for found_type in found_types.iter do
                found_type.clone types.push
            done
            types.length = inner_count
        fi
        # Store inner values from stack into temp locals
        std::List[u64]::new = temps
        0 = index: u64
        while index inner_count > do
            compiler.allocate_local = local_index
            local_index temps.push
            local_index InstValue::LocalSet bytecode.push
            1 += index
        done

        # Allocate heap
        compiler.allocate_local = ptr_local
        casa_enum compiler.enum_size i64::try_from.unwrap InstValue::Push bytecode.push
        InstValue::HeapAlloc bytecode.push
        ptr_local InstValue::LocalSet bytecode.push

        # Store ordinal at offset 0
        compiler variant require_variant_ordinal InstValue::Push bytecode.push
        ptr_local InstValue::LocalGet bytecode.push
        InstValue::Store64 bytecode.push

        # Store inner values at their padded payload offsets.
        0 = inner_index: u64
        while inner_index inner_count > do
            inner_index variant_name.as_str casa_enum compiler.get_enum_field_plan = plan
            ptr_local InstValue::LocalGet bytecode.push
            plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            inner_index temps.get copy = temp_local
            temp_local InstValue::LocalGet bytecode.push
            InstValue::Swap bytecode.push
            bytecode plan inner_index types.get compiler.emit_field_store
            1 += inner_index
        done

        # Push pointer
        ptr_local InstValue::LocalGet bytecode.push
    }
}

# ============================================================================
# Compile is check
# ============================================================================

impl LoweringBuilder {
    fn compile_is_check
        compiler:mut$LoweringBuilder
        store:$common::SymbolStore
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if op.value common::OpValue::IsCheck(variant) is then
            variant.enum_name.clone = enum_name
            enum_name store.enums.get = casa_enum_opt
            if casa_enum_opt.is_none then
                f"Enum `{enum_name}` is missing during backend lowering" compiler.record_failure_string
                return
            fi
            casa_enum_opt.unwrap = casa_enum

            if casa_enum common::has_inner_values ! then
                # Plain enum: compare ordinal directly
                compiler variant require_variant_ordinal InstValue::Push bytecode.push
                InstValue::Eq bytecode.push
                return
            fi

            if 0 variant common::EnumVariant::bindings.length == then
                # Data-carrying enum, no bindings: load ordinal and compare
                InstValue::Load64 bytecode.push
                compiler variant require_variant_ordinal InstValue::Push bytecode.push
                InstValue::Eq bytecode.push
                return
            fi

            # Data-carrying enum with bindings
            compiler.allocate_local = temp_ptr

            compiler.new_label = skip_bindings

            # Save enum pointer
            temp_ptr InstValue::LocalSet bytecode.push

            # Load ordinal and compare
            temp_ptr InstValue::LocalGet bytecode.push
            InstValue::Load64 bytecode.push
            compiler variant require_variant_ordinal InstValue::Push bytecode.push
            InstValue::Eq bytecode.push

            # Duplicate bool
            InstValue::Dup bytecode.push
            skip_bindings InstValue::JumpNe bytecode.push

            # Extract bindings
            variant.variant_name casa_enum
                .variant_types
                .get
                .unwrap = payload_types
            0 = index: u64
            while index variant common::EnumVariant::bindings.length > do
                index variant.variant_name.as_str casa_enum compiler.get_enum_field_plan = plan
                temp_ptr InstValue::LocalGet bytecode.push
                plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::Add bytecode.push
                bytecode plan index payload_types.get compiler.emit_field_load
                index variant common::EnumVariant::bindings.get = var_name
                bytecode var_name.as_str compiler.emit_variable_set
                1 += index
            done

            if op.ownership std::Option::Some(ownership) is then
                for event in ownership.assignments.iter do
                    bytecode event.generation event.name.as_str compiler.set_owner_flag
                done
                if ownership.conditional_move std::Option::Some(subject_name) is then
                    temp_ptr InstValue::LocalGet bytecode.push
                    op
                        .type_hint
                        .clone
                        .unwrap = subject_type
                    bytecode subject_type variant op store compiler.compile_enum_pattern_destruction
                    bytecode 0 subject_name.as_str compiler.set_owner_flag
                fi
            fi

            skip_bindings InstValue::Label bytecode.push
        fi
    }
}

# ============================================================================
# Compile struct literal
# ============================================================================

impl LoweringBuilder {
    fn compile_struct_literal
        compiler:mut$LoweringBuilder
        store:$common::SymbolStore
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if op.value common::OpValue::StructLiteral(literal) is then
            literal.struct_name store.structs.get = casa_struct_opt
            if casa_struct_opt.is_none then
                f"Struct `{literal.struct_name}` is missing during backend lowering" compiler.record_failure_string
                return
            fi
            casa_struct_opt.unwrap = casa_struct
            casa_struct common::CasaStruct::members.length = count

            # Store all field values into temp locals (top of stack = last in field_order)
            # Iterate field_order in reverse
            literal common::StructLiteral::field_order.length = field_index
            std::Map[std::String u64]::new = temp_locals
            while 0 field_index != do
                1 -= field_index
                compiler.allocate_local = local_index
                field_index literal common::StructLiteral::field_order.get = field_name
                local_index field_name.clone temp_locals.set
                local_index InstValue::LocalSet bytecode.push
            done

            # Allocate struct on heap
            casa_struct compiler.struct_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::HeapAlloc bytecode.push

            # Store each field at its correct offset
            0 = member_index: u64
            while member_index casa_struct common::CasaStruct::members.length > do
                member_index casa_struct common::CasaStruct::members.get = member
                member common::Member::name.as_str = member_name: $str
                member_index casa_struct compiler.get_struct_field_plan = plan
                InstValue::Dup bytecode.push
                if 0 plan.offset > then
                    plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                    InstValue::Add bytecode.push
                fi
                if member_name temp_locals.get_copy_str std::Option::Some(temp_local) is then
                    temp_local copy InstValue::LocalGet bytecode.push
                else
                    f"Struct literal field `{member_name}` has no temporary local during backend lowering" compiler.record_failure_string
                    return
                fi
                InstValue::Swap bytecode.push
                bytecode plan member.typ compiler.emit_field_store
                1 += member_index
            done
        fi
    }
}

# ============================================================================
# Compile push array
# ============================================================================

impl LoweringBuilder {
    fn compile_static_array_fns compiler:mut$LoweringBuilder items:$std::List[common::Op] {
        for item in items.iter do
            if item common::Op::value common::OpValue::FnPush(fn_name) is then
                fn_name.as_str compiler
                    .state
                    .store
                    .get_function = csa_fn_opt
                if csa_fn_opt std::Option::Some(csa_fn) is then
                    item csa_fn compiler.compile_function
                else
                    f"Function `{fn_name}` is missing during backend lowering" compiler.record_failure_string
                fi
            fi
        done
    }
}

impl LoweringBuilder {
    fn compile_static_element
        compiler:mut$LoweringBuilder
        op:$common::Op
    -> common::StaticArrayElement {
        op common::Op::value match
            common::OpValue::PushInt(val) => {
                val.value common::StaticArrayElement::Imm return
            }
            common::OpValue::PushStr(val) => {
                val.as_str compiler.intern_string = str_idx f"str_{str_idx}" common::StaticArrayElement::Label return
            }
            common::OpValue::PushBool(val) => {
                val common::StaticArrayElement::Imm return
            }
            common::OpValue::PushChar(val) => {
                val common::StaticArrayElement::Imm return
            }
            common::OpValue::PushEnumVariant(ev) => {
                compiler ev require_variant_ordinal common::StaticArrayElement::Imm return
            }
            common::OpValue::FnPush(fn_name) => {
                fn_name.clone common::StaticArrayElement::Function return
            }
            _ => {
                "compile_static_element received a non-static operation" compiler.record_failure
                0 common::StaticArrayElement::Imm return
            }
        end
        0 common::StaticArrayElement::Imm
    }
}

impl LoweringBuilder {
    fn compile_static_struct
        self:mut$LoweringBuilder
        store:$common::SymbolStore
        group_ops:$std::List[common::Op]
    -> std::String {
        if 0 group_ops.length == then
            "Static struct expression group is empty during backend lowering" self.record_failure
            "".to_str return
        fi
        group_ops.length 1 - group_ops.get common::Op::value = last_val: $common::OpValue
        "".to_str = static_struct_label
        if last_val common::OpValue::StructLiteral(literal) is then
            literal.struct_name.clone = struct_name
            literal common::StructLiteral::field_order = field_order: $std::List[std::String]
            struct_name store.structs.get = casa_struct_opt
            if casa_struct_opt.is_none then
                f"Struct `{struct_name}` is missing during backend lowering" self.record_failure_string
                "".to_str return
            fi
            casa_struct_opt.unwrap = casa_struct

            std::List[common::StaticArrayElement]::new = ordered_elems
            0 = i: u64
            while i field_order.length > do
                i group_ops.get self.compile_static_element ordered_elems.push
                1 += i
            done

            # Reorder to match struct member definition order
            std::List[common::StaticArrayElement]::new = fields
            0 = mi: u64
            while mi casa_struct common::CasaStruct::members.length > do
                mi casa_struct common::CasaStruct::members.get common::Member::name.as_str = member_name: $str
                member_name field_order common::string_list_index = fo_idx
                if 0 fo_idx < then
                    f"Static struct field `{member_name}` is missing during backend lowering" self.record_failure_string
                    "".to_str return
                fi
                fo_idx u64::try_from.unwrap ordered_elems.get.clone fields.push
                1 += mi
            done

            self
                .state
                .program
                .static_structs
                .length = struct_index
            fields common::StaticStruct self
                .state
                .program
                .static_structs
                .push
            f"static_struct_{struct_index}" = static_struct_label
        else
            "compile_static_struct received a non-struct expression group" self.record_failure
        fi
        static_struct_label
    }
}

impl LoweringBuilder {
    fn compile_static_array
        compiler:mut$LoweringBuilder
        items:$std::List[common::Op]
        bytecode:mut$std::List[InstValue]
    {
        items compiler.compile_static_array_fns
        std::List[common::StaticArrayElement]::new = elements
        for item in items.iter do
            item common::Op::value match
                common::OpValue::PushArray(inner_items) => {
                    std::List[InstValue]::new = discard_bytecode
                    discard_bytecode inner_items compiler.compile_static_array
                    compiler
                        .state
                        .program
                        .static_arrays
                        .length 1 - = inner_idx
                    f"static_array_{inner_idx}" common::StaticArrayElement::Label elements.push
                }
                common::OpValue::ExprGroup(group_ops) => {
                    group_ops compiler.state.store compiler.compile_static_struct = struct_label
                    struct_label common::StaticArrayElement::Label elements.push
                }
                _ => {
                    item compiler.compile_static_element elements.push
                }
            end
        done
        compiler
            .state
            .program
            .static_arrays
            .length = array_index
        elements common::StaticArray compiler
            .state
            .program
            .static_arrays
            .push
        array_index InstValue::PushStaticArray bytecode.push
    }
}

impl LoweringBuilder {
    fn static_array_element_is_word self:$LoweringBuilder element_type:$common::Type -> bool {
        if self.state.store element_type common::type_inline_size std::Option::Some(element_size) is then
            if
                self.state.store element_type common::type_value_representation std::Option::Some(representation) is
            then
                common::WORD_SIZE element_size ==
                common::VALUE_REPR_RAW representation ==
                common::VALUE_REPR_SIGNED representation == || &&
                return
            fi
        fi
        false
    }

    fn can_emit_static_array
        self:$LoweringBuilder
        op:$common::Op
        items:$std::List[common::Op]
    -> bool {
        if items.is_empty self.state.store items common::op_is_static_array_with_store ! || then
            false return
        fi
        if op.type_hint std::Option::Some(array_type) is then
            if array_type.array_element_type std::Option::Some(element_type) is then
                element_type typechecker::resolve_numeric_literal_default = resolved_type
                resolved_type self.static_array_element_is_word return
            fi
            false return
        fi
        false
    }

    fn compile_push_array
        self:mut$LoweringBuilder
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if op.value common::OpValue::PushArray(items) is then
            items.length = length

            items op self.can_emit_static_array = can_emit_static
            if can_emit_static then
                bytecode items self.compile_static_array return
            fi

            common::make_unknown_type.clone = element_type
            if op.type_hint std::Option::Some(array_type) is then
                if array_type.array_element_type std::Option::Some(found_element_type) is then
                    found_element_type typechecker::resolve_numeric_literal_default = element_type
                else
                    "Array literal has no element type during backend lowering"
                    self.record_failure return
                fi
            else
                "Array literal has no type during backend lowering" self.record_failure return
            fi

            bytecode items self.compile_sequence_reversed

            # An array stores only its elements (ADR-0152), so the allocation
            # is exactly the element storage.
            self.allocate_local = list_local
            self.state.store element_type common::type_inline_size.unwrap = element_size
            element_size length common::get_array_storage_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::HeapAlloc bytecode.push
            list_local InstValue::LocalSet bytecode.push

            # Store elements starting at offset 0
            self.allocate_local = index_local
            0 InstValue::Push bytecode.push
            index_local InstValue::LocalSet bytecode.push

            self.new_label = start_label
            self.new_label = end_label

            # while index limit > do
            start_label InstValue::Label bytecode.push
            index_local InstValue::LocalGet bytecode.push
            length element_size * i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Gt bytecode.push
            end_label InstValue::JumpNe bytecode.push

            # list index + typed store
            list_local InstValue::LocalGet bytecode.push
            index_local InstValue::LocalGet bytecode.push
            InstValue::Add bytecode.push
            bytecode element_type self.emit_typed_store

            # element_size += index
            index_local InstValue::LocalGet bytecode.push
            element_size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            index_local InstValue::LocalSet bytecode.push

            # done
            start_label InstValue::Jump bytecode.push
            end_label InstValue::Label bytecode.push

            # Push array pointer
            list_local InstValue::LocalGet bytecode.push
        fi
    }
}

# ============================================================================
# Compile function call
# ============================================================================

impl LoweringBuilder {
    fn lower_extern_call
        self:mut$LoweringBuilder
        function:$common::Function
        symbol:std::String
    -> std::Option[std::String] {
        if
            function.name self
                .state
                .program
                .native_calls
                .has
        then
            function.name.clone std::Option::Some return
        fi
        std::List[common::ExternAbiType]::new = parameters
        for
            parameter in function
                .stack_effect
                .parameters
                .iter
        do
            if
                self.state.store parameter.typ abi::classify_extern_type
                std::Option::Some(classification) is
            then
                classification.clone parameters.push
            else
                f"Extern parameter `{parameter.typ.format}` has no ABI classification"
                self.record_failure_string
                std::Option[std::String]::None return
            fi
        done
        std::Option[common::ExternAbiType]::None = return_type
        if
            function
                .stack_effect
                .return_types
                .is_empty !
        then
            0 function
                .stack_effect
                .return_types
                .get = declared_return
            if
                self.state.store declared_return abi::classify_extern_type
                std::Option::Some(classification) is
            then
                classification.clone std::Option::Some = return_type
            else
                f"Extern return `{declared_return.format}` has no ABI classification"
                self.record_failure_string
                std::Option[std::String]::None return
            fi
        fi
        return_type parameters symbol.as_str abi::plan_native_call
        function.name.clone self
            .state
            .program
            .native_calls
            .set
        function.name.clone std::Option::Some
    }

    fn compile_named_function compiler:mut$LoweringBuilder name:$str op:$common::Op -> bool {
        if
            name compiler
                .state
                .program
                .functions
                .has_str
        then
            true return
        fi
        name compiler
            .state
            .store
            .get_function match
            std::Option::Some(function) => {
                if function.extern_symbol.is_none then
                    op function compiler.compile_function
                fi
                compiler.has_failed !
            }
            std::Option::None => {
                f"Function `{name}` is missing during backend lowering" compiler.record_failure_string
                false
            }
        end
    }

    fn compile_function compiler:mut$LoweringBuilder function:$common::Function op:$common::Op {
        if function.extern_symbol.is_some then
            return
        fi
        # Compile a function if not already compiled.
        if
            function common::Function::name compiler
                .state
                .program
                .functions
                .has
        then
            return
        fi
        # Mark as being compiled to prevent infinite recursion on recursive calls
        std::List[InstValue]::new = function_bytecode
        std::List[InstValue]::new function common::Function::name.clone compiler
            .state
            .program
            .functions
            .set
        function.ops function compiler.child = function_compiler
        function_bytecode function_compiler.compile_ops
        if function_compiler.has_failed then
            return
        fi

        # Handle locals
        function_compiler.locals_count = locals_count
        if locals_count 0 < then
            # Build new list with LOCALS_INIT at front
            std::List[InstValue]::new = final_bytecode
            locals_count InstValue::LocalsInit final_bytecode.push

            function_bytecode.reverse
            while function_bytecode.is_empty ! do
                function_bytecode.pop = instruction
                if instruction InstValue::FnReturn is then
                    locals_count InstValue::LocalsUninit final_bytecode.push
                fi
                instruction final_bytecode.push
            done
            locals_count InstValue::LocalsUninit final_bytecode.push
            InstValue::FnReturn final_bytecode.push
            final_bytecode = function_bytecode
        else
            InstValue::FnReturn function_bytecode.push
        fi

        function_bytecode function common::Function::name.clone compiler
            .state
            .program
            .functions
            .set
    }
}

impl LoweringBuilder {
    fn ensure_closure_destruction_function
        compiler:mut$LoweringBuilder
        lambda:$common::Function
        op:$common::Op
    -> std::String {
        f"__drop_closure_{lambda.name}" = drop_name
        if
            drop_name compiler
                .state
                .program
                .functions
                .has
        then
            drop_name return
        fi
        std::List[InstValue]::new drop_name.clone compiler
            .state
            .program
            .functions
            .set

        std::List[InstValue]::new = body
        lambda.ops lambda compiler.child = destructor
        0 = capture_index: u64
        while capture_index lambda.captures.length > do
            capture_index lambda.captures.get = capture
            if capture.name.as_str lambda.owned_captures common::string_list_contains then
                destructor.new_label = end_label
                capture_index InstValue::CaptureFlagLoad body.push
                0 InstValue::Push body.push
                InstValue::Ne body.push
                end_label InstValue::JumpNe body.push
                capture_index InstValue::CaptureLoad body.push
                body op capture.typ destructor.compile_destruction
                end_label InstValue::Label body.push
            fi
            1 += capture_index
        done
        InstValue::HeapFree body.push
        InstValue::FnReturn body.push
        body drop_name.clone compiler
            .state
            .program
            .functions
            .set
        drop_name
    }

    fn compile_function_ops
        compiler:mut$LoweringBuilder
        store:$common::SymbolStore
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        op common::op_str_value = name

        op.value match
            common::OpValue::FnCall => {
                if op name.as_str compiler.compile_named_function then
                    name.as_str store.get_function.unwrap = called_function
                    called_function.extern_symbol match
                        std::Option::Some(symbol) => {
                            symbol.clone called_function compiler.lower_extern_call match
                                std::Option::Some(call) => {
                                    call InstValue::ExternCall bytecode.push
                                }
                                std::Option::None => {
                                }
                            end
                        }
                        std::Option::None => name InstValue::FnCall bytecode.push
                    end
                fi
            }
            common::OpValue::FnPush => {
                if op name.as_str compiler.compile_named_function ! then
                    return
                fi
                name.as_str store
                    .get_function
                    .unwrap
                    .clone = lambda
                lambda.captures.clone = captures

                # Zero-capture closures share a single static record so trait
                # dispatch and named-function pushes do not allocate per call.
                if 0 captures.length == then
                    name InstValue::FnPushStatic bytecode.push
                else
                    # Each capture is followed by its ownership flag. The record
                    # header stores the call and destruction functions.
                    for capture in captures.iter do
                        capture common::Variable::name.as_str = capture_name: $str
                        capture_name.as_str lambda.owned_captures common::string_list_contains = owns_capture
                        owns_capture capture.typ compiler.is_copy_aggregate && = copies_aggregate
                        if capture_name.as_str compiler.capture_slots.get_copy_str std::Option::Some(capture_index) is then
                            capture_index InstValue::CaptureLoad bytecode.push
                            if copies_aggregate then
                                bytecode capture.typ compiler.emit_typed_load
                            elif owns_capture then
                                capture_index InstValue::CaptureFlagClear bytecode.push
                            fi
                        else
                            bytecode owns_capture copies_aggregate ! && capture_name.as_str
                            compiler.emit_variable_get
                            if copies_aggregate then
                                bytecode capture.typ compiler.emit_typed_load
                            elif owns_capture then
                                if capture_name.as_str compiler.owner_flags.get_copy_str std::Option::Some(flag) is then
                                    0 InstValue::Push bytecode.push
                                    flag InstValue::LocalSet bytecode.push
                                fi
                            fi
                        fi
                        if owns_capture then 1 else 0 fi InstValue::Push bytecode.push
                    done
                    name InstValue::FnPush bytecode.push
                    op lambda compiler.ensure_closure_destruction_function = drop_name
                    drop_name InstValue::DropFn bytecode.push
                    captures.length InstValue::ClosureRecord bytecode.push
                fi
            }
            _ => {
                "compile_function_ops received a non-function operation" compiler.record_failure
            }
        end
    }
}

# ============================================================================
# Compile enum comparison (data-carrying enums)
# ============================================================================

impl LoweringBuilder {
    fn compile_enum_comparison
        compiler:mut$LoweringBuilder
        compare_value:InstValue
        bytecode:mut$std::List[InstValue]
    {
        compiler.allocate_local = local_a
        local_a InstValue::LocalSet bytecode.push
        InstValue::Load64 bytecode.push
        local_a InstValue::LocalGet bytecode.push
        InstValue::Load64 bytecode.push
        compare_value bytecode.push
    }
}

# ============================================================================
# Compile single op
# ============================================================================

impl LoweringBuilder {
    fn emit_inline_size
        compiler:mut$LoweringBuilder
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if compiler.state.store target common::type_inline_size std::Option::Some(size) is then
            size i64::try_from.unwrap InstValue::Push bytecode.push
        else
            f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
        fi
    }

    fn emit_typed_load
        compiler:mut$LoweringBuilder
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation == then
                compiler.state.store target common::type_inline_size.unwrap
                InstValue::ReadIndirect bytecode.push
                return
            fi
            if compiler.state.store target common::type_inline_size std::Option::Some(size) is then
                if 1 size == then
                    InstValue::Load8 bytecode.push
                elif 2 size == then
                    InstValue::Load16 bytecode.push
                elif 4 size == then
                    InstValue::Load32 bytecode.push
                elif 8 size == then
                    InstValue::Load64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure_string
                    return
                fi
                if common::VALUE_REPR_SIGNED representation == then
                    if target common::Type::Builtin(builtin) is then
                        builtin InstValue::NormalizeInt bytecode.push
                    fi
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }

    fn emit_typed_borrow
        compiler:mut$LoweringBuilder
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        # A cstr borrow is the raw character address itself, not a pointer loaded from it.
        if target common::make_cstr_type.eq then
            return
        fi
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation != then
                bytecode target compiler.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }

    fn emit_typed_copy
        compiler:mut$LoweringBuilder
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if target compiler.is_copy_aggregate then
            bytecode target compiler.emit_inline_copy return
        fi
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation == then
                bytecode target compiler.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }

    fn emit_inline_copy
        self:mut$LoweringBuilder
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        self.state.store target common::type_inline_size.unwrap = size
        size common::WORD_SIZE u64::try_from.unwrap 1 - +
        common::WORD_SIZE u64::try_from.unwrap / = width
        0 = copy_local: u64
        while 0 width != do
            self.allocate_local = copy_local
            1 -= width
        done
        copy_local InstValue::LocalAddress bytecode.push
        size InstValue::MoveBytes bytecode.push
        copy_local InstValue::LocalAddress bytecode.push
    }

    fn emit_copy_aggregate_for_op
        self:mut$LoweringBuilder
        target:$common::Type
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        op.moves_owner = materialize_owner
        if materialize_owner then
            bytecode target self.emit_typed_load
        else
            bytecode target self.emit_inline_copy
        fi
    }

    fn emit_typed_store
        compiler:mut$LoweringBuilder
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if compiler.state.store target common::type_inline_size std::Option::Some(size) is then
                if common::VALUE_REPR_INDIRECT representation == then
                    size InstValue::WriteIndirect bytecode.push
                elif 1 size == then
                    InstValue::Store8 bytecode.push
                elif 2 size == then
                    InstValue::Store16 bytecode.push
                elif 4 size == then
                    InstValue::Store32 bytecode.push
                elif 8 size == then
                    InstValue::Store64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure_string
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }
}

impl LoweringBuilder {
    fn compile_temporary_binding
        compiler:mut$LoweringBuilder
        op:$common::Op
        binding:$common::TemporaryBinding
        bytecode:mut$std::List[InstValue]
    {
        if binding.name.as_str compiler.local_slots.has_str ! then
            compiler.allocate_local = local
            local binding.name.clone compiler.local_slots.set
        fi
        std::List[u64]::new = spilled
        0 = depth: u64
        while depth binding.depth > do
            compiler.allocate_local = local
            local InstValue::LocalSet bytecode.push
            local spilled.push
            1 += depth
        done
        if op.ownership std::Option::Some(ownership) is then
            for event in ownership.assignments.iter do
                bytecode op event compiler.compile_active_owner_cleanup
            done
        fi
        bytecode binding.name.as_str compiler.emit_variable_set
        bytecode false binding.name.as_str compiler.emit_variable_get
        while spilled.is_empty ! do
            spilled.pop InstValue::LocalGet bytecode.push
        done
        if op.ownership std::Option::Some(ownership) is then
            for event in ownership.assignments.iter do
                bytecode event.generation event.name.as_str compiler.set_owner_flag
            done
        fi
    }

    fn compile_direct_op
        self:mut$LoweringBuilder
        op:$common::Op
        type_hint_name:$str
        bytecode:mut$std::List[InstValue]
    -> bool {
        if op.type_hint std::Option::Some(copied_type) is then
            if copied_type self.is_copy_aggregate then
                if op.value common::OpValue::Dup is then
                    InstValue::Dup bytecode.push
                    bytecode op copied_type self.emit_copy_aggregate_for_op
                    true return
                elif op.value common::OpValue::Over is then
                    InstValue::Over bytecode.push
                    bytecode op copied_type self.emit_copy_aggregate_for_op
                    true return
                fi
            fi
        fi
        op.value direct_op_to_inst = direct_inst_opt
        # Check direct op-to-inst mapping first
        direct_inst_opt match
            std::Option::Some(direct_inst) => {
                # Data-carrying enum comparison
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    op.value common::OpValue::Lt is ||
                    op.value common::OpValue::Le is ||
                    op.value common::OpValue::Gt is ||
                    op.value common::OpValue::Ge is ||
                    op.type_hint.is_some &&
                    type_hint_name.as_str self
                        .state
                        .store
                        .enums
                        .has_str &&
                then
                    bytecode direct_inst self.compile_enum_comparison
                    true return
                fi
                # String content comparison
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    "str" type_hint_name.as_str == &&
                then
                    InstValue::StrEq bytecode.push
                    if op.value common::OpValue::Ne is then
                        InstValue::Not bytecode.push
                    fi
                    true return
                fi
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    "StringStrEq" type_hint_name.as_str == &&
                then
                    InstValue::StringStrEq bytecode.push
                    if op.value common::OpValue::Ne is then
                        InstValue::Not bytecode.push
                    fi
                    true return
                fi
                if
                    op.value common::OpValue::Eq is
                    op.value common::OpValue::Ne is ||
                    "StrStringEq" type_hint_name.as_str == &&
                then
                    InstValue::StrStringEq bytecode.push
                    if op.value common::OpValue::Ne is then
                        InstValue::Not bytecode.push
                    fi
                    true return
                fi
                # Data-carrying enum print
                if
                    op.value common::OpValue::PrintInt is type_hint_name.as_str self
                        .state
                        .store
                        .enums
                        .has_str &&
                then
                    InstValue::Load64 bytecode.push
                    InstValue::PrintInt bytecode.push
                    true return
                fi
                type_hint_name.as_str common::parse_builtin = builtin_hint
                if builtin_hint std::Option::Some(builtin) is then
                    builtin direct_inst op.value.select_typed_instruction bytecode.push
                else
                    direct_inst bytecode.push
                fi
                bytecode op self.emit_integer_normalization
                true return
            }
            std::Option::None => {
            }
        end
        false
    }

    fn compile_wrapping_numeric_op
        self:mut$LoweringBuilder
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        InstValue::Swap bytecode.push
        op.value match
            common::OpValue::WrappingAdd => InstValue::Add bytecode.push
            common::OpValue::WrappingSub => InstValue::Sub bytecode.push
            common::OpValue::WrappingMul => InstValue::Mul bytecode.push
            _ => {
            }
        end
        bytecode op self.emit_integer_normalization
    }

    fn compile_numeric_op
        self:mut$LoweringBuilder
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    -> bool {
        op.value match
            common::OpValue::WrappingAdd => {
                bytecode op self.compile_wrapping_numeric_op
                true
            }
            common::OpValue::WrappingSub => {
                bytecode op self.compile_wrapping_numeric_op
                true
            }
            common::OpValue::WrappingMul => {
                bytecode op self.compile_wrapping_numeric_op
                true
            }
            common::OpValue::NumericConvert(conversion) => {
                conversion.target conversion.source conversion.kind common::NumericConversion InstValue::NumericConvert bytecode.push
                true
            }
            common::OpValue::NumericTry(numeric_try) => {
                if numeric_try.source common::Type::Builtin is then
                    numeric_try.target numeric_try.source.clone common::NumericTry InstValue::NumericTry bytecode.push
                    f"{common::STD_NAMESPACE}__numeric_try_{numeric_try.target.format}" = wrapper_name
                    if op wrapper_name.as_str self.compile_named_function then
                        wrapper_name InstValue::FnCall bytecode.push
                    fi
                else
                    f"Numeric conversion source `{numeric_try.source.format}` was not specialized" self.record_failure_string
                fi
                true
            }
            common::OpValue::IntegerTry(integer_try) => {
                InstValue::Swap bytecode.push
                integer_try.target integer_try.kind common::IntegerTry InstValue::IntegerTry bytecode.push
                f"{common::STD_NAMESPACE}__numeric_try_{integer_try.target.format}" = wrapper_name
                if op wrapper_name.as_str self.compile_named_function then
                    wrapper_name InstValue::FnCall bytecode.push
                fi
                true
            }
            common::OpValue::FloatRound(rounding) => {
                rounding.target rounding.method.clone common::FloatRound InstValue::FloatRound bytecode.push
                true
            }
            common::OpValue::FloatFromDecimal => {
                InstValue::FloatFromDecimal bytecode.push
                true
            }
            common::OpValue::FloatSignificand => {
                InstValue::FloatSignificand bytecode.push
                true
            }
            _ => false
        end
    }

    fn compile_terminal_op
        self:mut$LoweringBuilder
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    -> bool {
        op.value match
            common::OpValue::Drop => {
                if op.type_hint std::Option::Some(drop_type) is then
                    bytecode op drop_type self.compile_destruction
                else
                    InstValue::Drop bytecode.push
                fi
                true
            }
            common::OpValue::FnExecOwned => {
                self.allocate_local = closure_local
                InstValue::Dup bytecode.push
                closure_local InstValue::LocalSet bytecode.push
                InstValue::FnExec bytecode.push
                closure_local InstValue::LocalGet bytecode.push
                InstValue::ClosureDrop bytecode.push
                true
            }
            _ => false
        end
    }

    fn compile_owned_assignment
        self:mut$LoweringBuilder
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    {
        if op.ownership std::Option::Some(ownership) is then
            for event in ownership.assignments.iter do
                bytecode op event self.compile_active_owner_cleanup
            done
        fi
        bytecode op self.compile_assignment
        if op.ownership std::Option::Some(ownership) is then
            for event in ownership.assignments.iter do
                bytecode event.generation event.name.as_str self.set_owner_flag
            done
        fi
    }

    fn compile_stateful_op
        self:mut$LoweringBuilder
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    -> bool {
        op.value match
            common::OpValue::BindTemporary(binding) => {
                bytecode binding op self.compile_temporary_binding
                true
            }
            common::OpValue::AssignDec(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::AssignInc(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::AssignVar(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::Question(_) => {
                bytecode op self.compile_owned_assignment
                true
            }
            common::OpValue::QuestionMove(hidden_name) => {
                if hidden_name self.owner_flags.get_copy std::Option::Some(flag) is then
                    0 InstValue::Push bytecode.push
                    flag InstValue::LocalSet bytecode.push
                fi
                true
            }
            _ => false
        end
    }

    fn compile_callable_op
        self:mut$LoweringBuilder
        op:$common::Op
        bytecode:mut$std::List[InstValue]
    -> bool {
        op.value match
            common::OpValue::FstringConcat(count) => {
                count InstValue::FstringConcat bytecode.push
                true
            }
            common::OpValue::PrimitiveToStr(builtin) => {
                builtin copy InstValue::PrimitiveToStr bytecode.push
                true
            }
            common::OpValue::FstringToStr => true
            common::OpValue::DestructionFn(target) => {
                if target self.destruction_needs_function then
                    op target self.ensure_destruction_function = drop_name
                    drop_name InstValue::DropFn bytecode.push
                else
                    0 InstValue::Push bytecode.push
                fi
                true
            }
            common::OpValue::FnCall(_) => {
                bytecode op self.state.store self.compile_function_ops
                true
            }
            common::OpValue::FnPush(_) => {
                bytecode op self.state.store self.compile_function_ops
                true
            }
            common::OpValue::Rejected => {
                "Rejected source operation reached backend lowering" self.record_failure
                true
            }
            common::OpValue::Identifier(name) => {
                f"Identifier `{name}` reached backend lowering unresolved"
                self.record_failure_string
                true
            }
            common::OpValue::Copy => {
                if op.type_hint std::Option::Some(copied_type) is then
                    if copied_type self.is_copy_aggregate then
                        bytecode op copied_type self.emit_copy_aggregate_for_op
                    else
                        bytecode copied_type self.emit_typed_copy
                    fi
                fi
                true
            }
            common::OpValue::MethodCall(_) => {
                "Method call reached backend lowering before typechecker lowering"
                self.record_failure
                true
            }
            common::OpValue::QualifiedMethodCall(_) => {
                "Method call reached backend lowering before typechecker lowering"
                self.record_failure
                true
            }
            common::OpValue::TraitMethodCall(_) => {
                "Trait operation reached backend lowering before monomorphization"
                self.record_failure
                true
            }
            common::OpValue::TraitMethodRef(_) => {
                "Trait operation reached backend lowering before monomorphization"
                self.record_failure
                true
            }
            common::OpValue::Print => {
                "Generic print reached backend lowering before typechecker lowering"
                self.record_failure
                true
            }
            _ => false
        end
    }

    fn compile_structural_op
        self:mut$LoweringBuilder
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        type_hint_name:$str
        bytecode:mut$std::List[InstValue]
    -> bool {
        op.value match
            common::OpValue::IfStart => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfCondition => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfElif => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfElse => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::IfEnd => {
                bytecode op_index op targets ops self.compile_if_block
                true
            }
            common::OpValue::PtrFromRaw(_) => true
            common::OpValue::PtrFromRef => true
            common::OpValue::PtrIntoRaw => true
            common::OpValue::OwnerCleanup => true
            common::OpValue::PushEnumVariant(variant) => {
                if
                    variant.enum_name self
                        .state
                        .store
                        .enums
                        .get std::Option::Some(owned_enum) is
                then
                    if owned_enum common::has_inner_values then
                        bytecode owned_enum variant self.compile_enum_variant
                    else
                        self variant require_variant_ordinal InstValue::Push bytecode.push
                    fi
                else
                    f"Enum `{variant.enum_name}` is missing during backend lowering"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::IsCheck(_) => {
                bytecode op self.state.store self.compile_is_check
                true
            }
            common::OpValue::MatchStart => {
                bytecode op_index op targets ops self.compile_match_block
                true
            }
            common::OpValue::MatchArm(_) => {
                bytecode op_index op targets ops self.compile_match_block
                true
            }
            common::OpValue::MatchEnd => {
                bytecode op_index op targets ops self.compile_match_block
                true
            }
            common::OpValue::Typeof => {
                type_hint_name self.intern_string = typeof_index
                InstValue::Drop bytecode.push
                typeof_index InstValue::PushStr bytecode.push
                InstValue::PrintStr bytecode.push
                true
            }
            common::OpValue::SizeOf(target_type) => {
                if self.state.store target_type common::type_inline_size std::Option::Some(size) is then
                    if size i64::try_from std::Option::Some(signed_size) is then
                        signed_size InstValue::Push bytecode.push
                    else
                        f"Inline size of `{target_type.format}` exceeds the supported constant range"
                        self.record_failure_string
                    fi
                else
                    f"Cannot determine inline size of `{target_type.format}`"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::StructMemberProject(member) => {
                if
                    self.state.store member resolve_struct_field
                    std::Option::Some(field) is
                then
                    if 0 field.storage.offset != then
                        field.storage.offset i64::try_from.unwrap InstValue::Push
                        bytecode.push
                        InstValue::Add bytecode.push
                    fi
                    bytecode field.storage field.typ self.emit_field_projection
                else
                    f"Cannot determine member {member.member_index} storage of struct `{member.struct_name}`"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::StructMemberStore(member) => {
                if
                    self.state.store member resolve_struct_field
                    std::Option::Some(field) is
                then
                    if 0 field.storage.offset != then
                        field.storage.offset i64::try_from.unwrap InstValue::Push
                        bytecode.push
                        InstValue::Add bytecode.push
                    fi
                    bytecode field.storage field.typ self.emit_field_store
                else
                    f"Cannot determine member {member.member_index} storage of struct `{member.struct_name}`"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::PtrRead(target_type) => {
                bytecode target_type self.emit_typed_load
                true
            }
            common::OpValue::PtrWrite(target_type) => {
                bytecode target_type self.emit_typed_store
                true
            }
            common::OpValue::PtrAsRef(target_type) => {
                bytecode target_type self.emit_typed_borrow
                true
            }
            common::OpValue::PtrAsMut(target_type) => {
                bytecode target_type self.emit_typed_borrow
                true
            }
            common::OpValue::PtrNull => {
                0 InstValue::Push bytecode.push
                true
            }
            common::OpValue::PushArray(_) => {
                bytecode op self.compile_push_array
                true
            }
            common::OpValue::ExprGroup(group_ops) => {
                bytecode group_ops self.compile_sequence
                true
            }
            common::OpValue::StructNew(_) => {
                bytecode op self.compile_struct_new
                true
            }
            common::OpValue::StructLiteral(_) => {
                bytecode op self.state.store self.compile_struct_literal
                true
            }
            common::OpValue::WhileStart => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileCondition => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileBreak => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileContinue => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            common::OpValue::WhileEnd => {
                bytecode op_index op targets ops self.compile_while_block
                true
            }
            _ => false
        end
    }

    fn compile_value_op
        self:mut$LoweringBuilder
        op:$common::Op
        type_hint_name:$str
        bytecode:mut$std::List[InstValue]
    -> bool {
        op.value match
            common::OpValue::PushBool(value) => {
                value InstValue::Push bytecode.push
                true
            }
            common::OpValue::PushChar(value) => {
                value InstValue::PushChar bytecode.push
                true
            }
            common::OpValue::PushCapture(name) => {
                std::Option[common::Type]::None = copied_aggregate_type
                if self.function.is_none then
                    f"Capture `{name}` reached root backend lowering"
                    self.record_failure_string
                elif name self.capture_slots.get_copy std::Option::Some(capture_index) is then
                    if self.function std::Option::Some(function) is then
                        capture_index function.captures.get = capture
                        if capture.typ self.is_copy_aggregate then
                            capture.typ.clone std::Option::Some = copied_aggregate_type
                        fi
                    fi
                    capture_index InstValue::CaptureLoad bytecode.push
                    if copied_aggregate_type.clone std::Option::Some(copied_type) is then
                        bytecode op copied_type self.emit_copy_aggregate_for_op
                    fi
                    if
                        op.moves_owner
                        copied_aggregate_type.is_none &&
                    then
                        capture_index InstValue::CaptureFlagClear bytecode.push
                    fi
                else
                    f"Capture `{name}` is missing during backend lowering"
                    self.record_failure_string
                fi
                true
            }
            common::OpValue::PushInt(value) => {
                value.value InstValue::Push bytecode.push
                true
            }
            common::OpValue::PushFloat(value) => {
                if "f32" type_hint_name == then
                    value.clone InstValue::PushFloat32 bytecode.push
                else
                    value.clone InstValue::PushFloat64 bytecode.push
                fi
                true
            }
            common::OpValue::PushStr(value) => {
                value.as_str self.intern_string = string_index
                string_index InstValue::PushStr bytecode.push
                true
            }
            common::OpValue::PushVar(name) => {
                op.moves_owner = moves_owner
                bytecode moves_owner name.as_str self.emit_variable_get
                if moves_owner then
                    if name self.owner_flags.get_copy std::Option::Some(flag) is then
                        0 InstValue::Push bytecode.push
                        flag InstValue::LocalSet bytecode.push
                    fi
                fi
                true
            }
            _ => false
        end
    }

    fn compile_op
        self:mut$LoweringBuilder
        ops:$std::List[common::Op]
        targets:$ControlFlowTargets
        op:$common::Op
        op_index:u64
        bytecode:mut$std::List[InstValue]
    {
        op.value match
            common::OpValue::IfElif => false
            common::OpValue::IfElse => false
            common::OpValue::IfEnd => false
            common::OpValue::WhileEnd => false
            common::OpValue::MatchArm(_) => false
            common::OpValue::MatchEnd => false
            _ => true
        end = compile_cleanups
        if compile_cleanups then
            bytecode op self.compile_owner_cleanups
        fi
        if bytecode op self.compile_terminal_op then
            return
        fi
        "".to_str = type_hint_name
        if op.type_hint std::Option::Some(type_hint) is then
            type_hint.format = type_hint_name
        fi
        if bytecode type_hint_name.as_str op self.compile_direct_op then
            return
        fi
        if bytecode op self.compile_numeric_op then
            return
        fi
        if bytecode op self.compile_stateful_op then
            return
        fi
        if bytecode op self.compile_callable_op then
            return
        fi
        if bytecode type_hint_name.as_str op_index op targets ops self.compile_structural_op then
            return
        fi
        bytecode type_hint_name.as_str op self.compile_value_op drop
    }
}

# ============================================================================
# Compile ops list
# ============================================================================

impl LoweringBuilder {
    fn compile_sequence
        self:mut$LoweringBuilder
        ops:$std::List[common::Op]
        bytecode:mut$std::List[InstValue]
    {
        ops precompute_control_flow_targets match
            std::Result::Error(failure) => failure std::Option::Some = self.state.failure
            std::Result::Ok(targets) => {
                0 = index: u64
                while index ops.length > self.has_failed ! && do
                    index ops.get = op
                    bytecode index op targets ops self.compile_op
                    1 += index
                done
            }
        end
    }

    fn compile_sequence_reversed
        self:mut$LoweringBuilder
        ops:$std::List[common::Op]
        bytecode:mut$std::List[InstValue]
    {
        ops precompute_control_flow_targets match
            std::Result::Error(failure) => failure std::Option::Some = self.state.failure
            std::Result::Ok(targets) => {
                ops.length = index
                while 0 index != self.has_failed ! && do
                    1 -= index
                    index ops.get = op
                    bytecode index op targets ops self.compile_op
                done
            }
        end
    }

    fn compile_ops self:mut$LoweringBuilder bytecode:mut$std::List[InstValue] {
        # Function label
        self.new_label = function_label
        function_label InstValue::Label bytecode.push

        bytecode self.ops self.compile_sequence
    }
}

# ============================================================================
# Main entry: compile_bytecode
# ============================================================================

fn compile_bytecode_into ops:$std::List[common::Op] state:mut$LoweringState {
    std::List[InstValue]::new = bytecode
    ops state LoweringBuilder::new = compiler

    bytecode compiler.compile_ops

    # Reserve root local slots around the root body.
    compiler.locals_count = locals_count
    if locals_count 0 < then
        std::List[InstValue]::new = final_bytecode
        locals_count InstValue::LocalsInit final_bytecode.push
        bytecode final_bytecode.append
        locals_count InstValue::LocalsUninit final_bytecode.push
        final_bytecode = bytecode
    fi

    bytecode = compiler
        .state
        .program
        .bytecode
    compiler
        .state
        .constants_table
        .length = compiler
        .state
        .program
        .constants_count
}

fn compile_bytecode
    store:$common::SymbolStore
    ops:$std::List[common::Op]
-> std::Result[Program BackendFailure] {
    store LoweringState::new = state
    state ops compile_bytecode_into
    state.into_result
}

fn compile_typechecked result:$typechecker::CheckedProgram -> std::Result[Program BackendFailure] {
    result.get_ops result.get_store compile_bytecode
}
# Keep path selection private to backend orchestration. A failed commitment
# must never retry the legacy path or publish partial assembly.
pub fn compile_assembly
    result:$typechecker::CheckedProgram
-> std::Result[std::String BackendFailure] {
    result compile_scalar match
        std::Result::Error(message) => message BackendFailure::new std::Result::Error
        std::Result::Ok(candidate) => {
            if candidate std::Option::Some(assembly) is then
                assembly std::Result::Ok
            else
                result compile_typechecked match
                    std::Result::Ok(program) => program emit std::Result::Ok
                    std::Result::Error(failure) => failure std::Result::Error
                end
            fi
        }
    end
}
# x86-64 GNU assembly emitter for the Casa compiler.

# ============================================================================
# Constants
# ============================================================================
const INT32_MAX 2147483647
const INT32_MIN -2147483648
const RETURN_STACK_SIZE 1048576
const HEAP_CHUNK_HEADER_SIZE 16
const EXIT_SYSCALL 60
const STDOUT_FD 1
const STDERR_FD 2
const FAILURE_STATUS 1
const F32_ABSOLUTE_MASK 2147483647
const F32_INTEGRAL_THRESHOLD_BITS 1258291200
const F64_INTEGRAL_THRESHOLD_BITS 4841369599423283200
const F32_HALF_BITS 1056964608
const F64_HALF_BITS 4602678819172646912
const F32_SIGN_BIT_INDEX 31
const F64_SIGN_BIT_INDEX 63
const ODD_INTEGER_MASK 1
const MAX_LEAF_INSTRUCTIONS 8
const SCALAR_REGISTER_COUNT 4
const MAX_DIRECT_LOCAL_WORDS 32

# ============================================================================
# Emitter state
# ============================================================================

struct Emitter {
    native_calls:    std::Map[std::String common::NativeCallPlan]
    asm:             std::String
    label_counter:   u64
    functions:       std::Map[std::String std::List[InstValue]]
    strings:         std::List[std::String]
    static_arrays:   std::List[common::StaticArray]
    static_structs:  std::List[common::StaticStruct]
    constants_count: u64
    buffering:       bool
    instructions:    std::List[MachineLine]
}

impl Program {
    # Keep global bytecode outside Emitter so emission can mutate its output
    # while it reads the instruction list.
    fn split_bytecode self:Program -> Program std::List[InstValue] {
        self match
            Program { native_calls: native_calls bytecode: bytecode functions: functions strings: strings static_arrays: static_arrays static_structs: static_structs constants_count: constants_count } => {
                constants_count static_structs static_arrays
                strings functions std::List[InstValue]::new native_calls Program
                bytecode
            }
        end
    }
}

impl Emitter {
    fn new program:Program -> Emitter {
        program match
            Program { native_calls: native_calls functions: functions strings: strings static_arrays: arrays static_structs: structs constants_count: constants } => {
                std::List[MachineLine]::new false constants structs arrays strings functions
                0 std::String::new native_calls Emitter
            }
        end
    }

    fn new_scalar -> Emitter {
        std::List[MachineLine]::new false 0
        std::List[common::StaticStruct]::new std::List[common::StaticArray]::new
        std::List[std::String]::new std::Map[std::String std::List[InstValue]]::new
        0 std::String::new std::Map[std::String common::NativeCallPlan]::new Emitter
    }

    fn into_asm self:Emitter -> std::String {
        self match
            Emitter { asm: asm } => asm
        end
    }

    fn emit_uid self:mut$Emitter -> u64 {
        1 += self.label_counter
        self.label_counter
    }

    fn line self:mut$Emitter text:$str {
        if self.buffering then
            text.to_str MachineLine::Directive self.instructions.push
        else
            text self.asm.append
            '\n' self.asm.push
        fi
    }

    fn indent self:mut$Emitter text:$str {
        if self.buffering then
            text.to_str MachineLine::Instruction self.instructions.push
        else
            "    " self.asm.append
            text self.asm.append
            '\n' self.asm.push
        fi
    }

    fn line_string self:mut$Emitter text:std::String { text.as_str self.line }

    fn indent_string self:mut$Emitter text:std::String { text.as_str self.indent }
}

# ============================================================================
# Convert a source-level function name to an assembler-safe label.
# ============================================================================

fn sanitize_name name:$str -> std::String {
    if name " " str::contains then
        # Source identifiers cannot contain whitespace or an emitted dot. Preserve the
        # complete generated identity without sharing the source-label namespace.
        ".generic_".to_str = generated
        for character in name.iter do
            if character.is_alpha character.is_digit || then
                character generated.push
            else
                f"_{character.codepoint}_" generated.append_string
            fi
        done
        generated return
    fi
    name "::" str::split = parts
    "__" parts.join_strings = namespaced
    std::String::new = result
    for character in namespaced.iter do
        if
            character.is_alpha
            character.is_digit ||
            '_' character == ||
            ':' character == ||
        then
            character result.push
        else
            '_' result.push
        fi
    done
    result
}
# A forwarding parameter can remain on the value stack when no instruction
# observes its local slot or introduces another call or control-flow path.
fn has_forwarding_frame bytecode:$std::List[InstValue] -> bool {
    if 6 bytecode.length < then
        false return
    fi
    if 0 bytecode.get InstValue::LocalsInit(count) is then
        if 1 count != then
            false return
        fi
    else
        false return
    fi
    if 1 bytecode.get InstValue::Label is ! then
        false return
    fi
    if 2 bytecode.get InstValue::LocalSet(index) is then
        if 0 index != then
            false return
        fi
    else
        false return
    fi
    if 3 bytecode.get InstValue::LocalGet(index) is then
        if 0 index != then
            false return
        fi
    else
        false return
    fi
    if bytecode.length 2 - bytecode.get InstValue::LocalsUninit(count) is then
        if 1 count != then
            false return
        fi
    else
        false return
    fi
    if bytecode.length 1 - bytecode.get InstValue::FnReturn is ! then
        false return
    fi
    4 = index: u64
    while index bytecode.length 2 - > do
        if index bytecode.get is_leaf_instruction ! then
            false return
        fi
        1 += index
    done
    true
}
# Explicitly exclude operations that call runtime helpers, access frame state,
# or transfer control. Checked arithmetic can call the error writer, whose
# return-stack reservation must observe the original physical frame.
fn is_leaf_instruction inst:$InstValue -> bool {
    inst match
        InstValue::Drop => true
        InstValue::Dup => true
        InstValue::Over => true
        InstValue::Push => true
        InstValue::PushChar => true
        InstValue::PushStr => true
        InstValue::Rot => true
        InstValue::Swap => true
        InstValue::Load8 => true
        InstValue::Load16 => true
        InstValue::Load32 => true
        InstValue::Load64 => true
        InstValue::Add => true
        InstValue::Sub => true
        InstValue::Mul => true
        InstValue::BitAnd => true
        InstValue::BitOr => true
        InstValue::BitXor => true
        InstValue::BitNot => true
        InstValue::And => true
        InstValue::Or => true
        InstValue::Not => true
        InstValue::Eq => true
        InstValue::Ne => true
        InstValue::Lt => true
        InstValue::Le => true
        InstValue::Gt => true
        InstValue::Ge => true
        InstValue::Ult => true
        InstValue::Ule => true
        InstValue::Ugt => true
        InstValue::Uge => true
        InstValue::NormalizeInt => true
        _ => false
    end
}

struct LeafTemplate {
    instructions: std::List[InstValue]
    local_bytes:  u64
    start:        u64
    end_index:    u64
}

# A register holds one distinct value in a suffix of the value stack. Copies
# use separate registers. Calls, branches, and unsupported operations flush it.
struct ScalarStack {
    depth: u64
    first: u64
}

impl ScalarStack {
    fn new -> ScalarStack { 0 0 ScalarStack }

    fn get_register self:$ScalarStack index:u64 -> str {
        self.first index + SCALAR_REGISTER_COUNT % get_scalar_register
    }
}

fn get_scalar_register index:u64 -> str {
    index match
        0 => "%r8"
        1 => "%r9"
        2 => "%r10"
        3 => "%r11"
        _ => "Invalid scalar register index" panic
    end
}

fn get_scalar_input_count inst:$InstValue -> std::Option[u64] {
    inst match
        InstValue::Push => 0
        InstValue::PushChar => 0
        InstValue::PushStr => 0
        InstValue::LocalGet => 0
        InstValue::LocalAddress => 0
        InstValue::LocalSet => 1
        InstValue::JumpNe => 1
        InstValue::Drop => 1
        InstValue::Dup => 1
        InstValue::Over => 2
        InstValue::Swap => 2
        InstValue::Rot => 3
        InstValue::Load8 => 1
        InstValue::Load16 => 1
        InstValue::Load32 => 1
        InstValue::Load64 => 1
        InstValue::Store8 => 2
        InstValue::Store16 => 2
        InstValue::Store32 => 2
        InstValue::Store64 => 2
        InstValue::NormalizeInt(builtin) => {
            if 64 builtin.bit_width == then
                0
            else
                std::Option[u64]::None return
            fi
        }
        InstValue::NumericConvert(conversion) => {
            if
                conversion.kind common::NumericConversionKind::FromBits ==
                conversion.kind common::NumericConversionKind::ToBits == ||
                conversion.source.is_integer conversion.target.is_integer &&
                64 conversion.target.bit_width == && ||
            then
                0
            else
                std::Option[u64]::None return
            fi
        }
        InstValue::Add => 2
        InstValue::Sub => 2
        InstValue::Mul => 2
        InstValue::CheckedAdd(builtin) => {
            if 64 builtin.bit_width != then
                std::Option[u64]::None return
            fi
            2
        }
        InstValue::CheckedSub(builtin) => {
            if 64 builtin.bit_width != then
                std::Option[u64]::None return
            fi
            2
        }
        InstValue::CheckedMul(builtin) => {
            if 64 builtin.bit_width != then
                std::Option[u64]::None return
            fi
            2
        }
        InstValue::BitAnd => 2
        InstValue::BitOr => 2
        InstValue::BitXor => 2
        InstValue::BitNot => 1
        InstValue::And => 2
        InstValue::Or => 2
        InstValue::Not => 1
        InstValue::Eq => 2
        InstValue::Ne => 2
        InstValue::Lt => 2
        InstValue::Le => 2
        InstValue::Gt => 2
        InstValue::Ge => 2
        InstValue::Ult => 2
        InstValue::Ule => 2
        InstValue::Ugt => 2
        InstValue::Uge => 2
        _ => std::Option[u64]::None return
    end = count: u64
    count std::Option::Some
}
# Templates borrow no function storage and live only during this emission.
# The fixed budget bounds code growth. Calls and recursive placeholders never
# qualify, so classification is independent of function-map traversal order.
fn collect_leaf_templates
    functions:mut$std::Map[std::String std::List[InstValue]]
-> std::Map[std::String LeafTemplate] {
    std::Map[std::String LeafTemplate]::new = templates
    functions.keys = names
    for name in names.iter do
        name functions.get.unwrap = body
        if body.is_empty then
            continue
        fi
        0 = start: u64
        body.length 1 - = end_index
        0 = local_bytes: u64
        if body has_forwarding_frame then
            4 = start: u64
            1 -= end_index
            common::WORD_SIZE = local_bytes: u64
        else
            if end_index body.get InstValue::FnReturn is ! then
                continue
            fi
            if 0 body.get InstValue::Label is then
                1 = start: u64
            fi
        fi
        if start end_index <= then
            continue
        fi
        if MAX_LEAF_INSTRUCTIONS end_index start - > then
            continue
        fi
        true = eligible
        start = index
        while index end_index > do
            if index body.get is_leaf_instruction ! then
                false = eligible
                break
            fi
            1 += index
        done
        if eligible then
            name functions.remove.unwrap = instructions
            end_index start local_bytes instructions LeafTemplate name.clone templates.set
        fi
    done
    templates
}

# ============================================================================
# escape_string: escape special chars for assembly string literals
# ============================================================================

fn make_octal_digit value:u32 -> char { value '0'.codepoint + char::from_codepoint.unwrap }

fn escape_string s:$str -> std::String {
    std::String::new = builder
    0 = index: u64
    while index s.length > do
        index s.at = byte
        if '\\' byte == then
            "\\\\" builder.append
        elif '"' byte == then
            "\\\"" builder.append
        elif '\n' byte == then
            "\\n" builder.append
        elif '\t' byte == then
            "\\t" builder.append
        elif '\0' byte == then
            "\\000" builder.append
        elif '\r' byte == then
            "\\r" builder.append
        elif
            32 byte.codepoint i64::from <
            127 byte.codepoint i64::from >= ||
        then
            '\\' builder.push
            byte.codepoint 64 / make_octal_digit builder.push
            byte.codepoint 8 / 8 % make_octal_digit builder.push
            byte.codepoint 8 % make_octal_digit builder.push
        else
            byte builder.push
        fi
        1 += index
    done
    builder
}

# ============================================================================
# BSS section
# ============================================================================

impl Emitter {
    fn emit_bss self:mut$Emitter {
        ".section .bss" self.line
        if 0 self.constants_count > then
            f"constants: .skip {self.constants_count common::WORD_SIZE *}" self.line_string
        fi
        "" self.line
    }

    # ============================================================================
    # DATA section
    # ============================================================================

    fn emit_data self:mut$Emitter {
        ".section .data" self.line
        0 = index: u64
        while
            index self
                .strings
                .length >
        do
            index self.strings.get = value
            value.as_str escape_string = escaped
            ".align 8" self.line
            f"str_{index}:" self.line_string
            f".quad {value.length}" self.line_string
            f".asciz \"{escaped}\"" self.line_string
            1 += index
        done
        # Static closure record per function
        for
            name in self
                .functions
                .keys
                .iter
        do
            name.as_str sanitize_name = label
            ".align 8" self.line
            f"closure_{label}: .quad fn_{label}" self.line_string
            ".quad 0" self.line
        done

        # Static array literals
        0 = sa_index: u64
        while
            sa_index self
                .static_arrays
                .length >
        do
            sa_index self
                .static_arrays
                .get
                .clone = sa
            sa common::StaticArray::elements = elems: $std::List[common::StaticArrayElement]
            ".align 8" self.line
            f"static_array_{sa_index}:" self.line_string
            # A zero-length array is inhabited, so its label owns storage of
            # its own rather than aliasing what follows (ADR-0155).
            if 0 elems.length == then
                ".quad 0" self.line
            fi
            for elem in elems.iter do
                elem match
                    common::StaticArrayElement::Imm(v) => {
                        f".quad {v}" self.line_string
                    }
                    common::StaticArrayElement::Label(lbl) => {
                        f".quad {lbl}" self.line_string
                    }
                    common::StaticArrayElement::Function(name) => {
                        name.as_str sanitize_name = label
                        f".quad closure_{label}" self.line_string
                    }
                end
            done
            1 += sa_index
        done

        # Static struct literals
        0 = ss_index: u64
        while
            ss_index self
                .static_structs
                .length >
        do
            ss_index self
                .static_structs
                .get
                .clone = ss
            ss common::StaticStruct::fields = fields: $std::List[common::StaticArrayElement]
            ".align 8" self.line
            f"static_struct_{ss_index}:" self.line_string
            for field in fields.iter do
                field match
                    common::StaticArrayElement::Imm(v) => {
                        f".quad {v}" self.line_string
                    }
                    common::StaticArrayElement::Label(lbl) => {
                        f".quad {lbl}" self.line_string
                    }
                    common::StaticArrayElement::Function(name) => {
                        name.as_str sanitize_name = label
                        f".quad closure_{label}" self.line_string
                    }
                end
            done
            1 += ss_index
        done

        "" self.line
    }

    # ============================================================================
    # TEXT section
    # ============================================================================

    fn emit_text self:mut$Emitter bytecode:$std::List[InstValue] {
        self.functions collect_leaf_templates = templates
        ".section .text" self.line
        templates self.emit_functions
        templates bytecode self.emit_start
    }

    # ============================================================================
    # Helper subroutines
    # ============================================================================
    # ============================================================================
    # Emit user functions
    # ============================================================================

    fn emit_functions self:mut$Emitter templates:$std::Map[std::String LeafTemplate] {
        for pair in templates.iter do
            pair.first.as_str sanitize_name = label
            f"fn_{label}:" self.line_string
            "popq -8(%r14)" self.indent
            false templates pair.second.instructions self.emit_bytecode
            "" self.line
        done
        self.functions.keys = function_names
        for name in function_names.iter do
            name self
                .functions
                .remove
                .unwrap = bytecode
            name.as_str sanitize_name = label
            f"fn_{label}:" self.line_string
            "popq -8(%r14)" self.indent
            false templates bytecode self.emit_bytecode
            "" self.line
        done
    }

    # ============================================================================
    # Emit _start entry point
    # ============================================================================

    fn emit_start
        self:mut$Emitter
        bytecode:$std::List[InstValue]
        templates:$std::Map[std::String LeafTemplate]
    {
        ".globl _start" self.line
        "_start:" self.line
        "leaq return_stack(%rip), %r14" self.indent
        "movq (%rsp), %rax" self.indent
        "movq %rax, __argc(%rip)" self.indent
        "leaq 8(%rsp), %rax" self.indent
        "movq %rax, __argv(%rip)" self.indent
        "movq (%rsp), %rcx" self.indent
        "addq $1, %rcx" self.indent
        "leaq 8(%rsp,%rcx,8), %rax" self.indent
        "movq %rax, __envp(%rip)" self.indent
        true templates bytecode self.emit_bytecode
        "movq $60, %rax" self.indent
        "xorq %rdi, %rdi" self.indent
        "syscall" self.indent
        "" self.line
    }

    # ============================================================================
    # Emit bytecode sequence
    # ============================================================================

    fn emit_bytecode
        self:mut$Emitter
        bytecode:$std::List[InstValue]
        templates:$std::Map[std::String LeafTemplate]
        is_global:bool
    {
        ScalarStack::new = cache
        if is_global ! bytecode has_forwarding_frame && then
            common::WORD_SIZE self.emit_return_stack_check
            4 = index: u64
            while index bytecode.length 2 - > do
                is_global cache index bytecode.get self.emit_scalar_or_inst
                1 += index
            done
            is_global cache InstValue::FnReturn self.emit_scalar_or_inst
            return
        fi
        for inst in bytecode.iter do
            if inst InstValue::FnCall(name) is then
                if name templates.get std::Option::Some(template) is then
                    is_global cache template self.emit_leaf_template
                    continue
                fi
            fi
            is_global cache inst self.emit_scalar_or_inst
        done
        cache self.flush_scalar_stack
    }

    fn emit_leaf_template
        self:mut$Emitter
        template:$LeafTemplate
        cache:mut$ScalarStack
        is_global:bool
    {
        common::WORD_SIZE template.local_bytes + self.emit_return_stack_check
        template.start = index
        while index template.end_index > do
            is_global cache index template.instructions.get self.emit_scalar_or_inst
            1 += index
        done
    }

    fn flush_scalar_stack self:mut$Emitter cache:mut$ScalarStack {
        0 = index: u64
        while index cache.depth > do
            f"pushq {index cache.get_register}" self.indent_string
            1 += index
        done
        0 = cache.depth: u64
        0 = cache.first: u64
    }

    # Fill below the cached suffix without moving registers that are already
    # live. The circular order gives each stack value a distinct register.
    fn refill_scalar_stack self:mut$Emitter cache:mut$ScalarStack needed:u64 {
        if needed cache.depth >= then
            return
        fi
        needed cache.depth - = missing
        cache.first SCALAR_REGISTER_COUNT + missing - SCALAR_REGISTER_COUNT % = cache.first
        missing = index
        while 0 index > do
            1 -= index
            f"popq {index cache.get_register}" self.indent_string
        done
        needed = cache.depth
    }

    fn reserve_scalar_register self:mut$Emitter cache:mut$ScalarStack -> str {
        if SCALAR_REGISTER_COUNT cache.depth == then
            cache self.flush_scalar_stack
        fi
        cache.depth cache.get_register = register
        1 += cache.depth
        register
    }

    fn emit_scalar_or_inst self:mut$Emitter inst:$InstValue cache:mut$ScalarStack is_global:bool {
        if cache inst self.emit_scalar_inst ! then
            cache self.flush_scalar_stack
            is_global inst self.emit_inst
        fi
    }

    # False means no assembly or cache state changed. Existing lowering then
    # receives the complete physical stack, including all cached values.
    fn emit_scalar_inst self:mut$Emitter inst:$InstValue cache:mut$ScalarStack -> bool {
        if inst get_scalar_input_count std::Option::Some(count) is then
            count cache self.refill_scalar_stack
        else
            false return
        fi
        "%r8" = top
        "%r8" = below
        if 0 cache.depth > then
            cache.depth 1 - cache.get_register = top
        fi
        if 1 cache.depth > then
            cache.depth 2 - cache.get_register = below
        fi
        inst match
            InstValue::Push(value) => {
                cache self.reserve_scalar_register = target
                if INT32_MIN value >= INT32_MAX value <= && then
                    f"movq ${value}, {target}" self.indent_string
                else
                    f"movabsq ${value}, {target}" self.indent_string
                fi
            }
            InstValue::PushChar(value) => {
                cache self.reserve_scalar_register = target
                f"movq ${value}, {target}" self.indent_string
            }
            InstValue::PushStr(index) => {
                cache self.reserve_scalar_register = target
                f"leaq str_{index}(%rip), {target}" self.indent_string
            }
            InstValue::LocalGet(index) => {
                cache self.reserve_scalar_register = target
                f"movq -{index 1 + common::WORD_SIZE *}(%r14), {target}" self.indent_string
            }
            InstValue::LocalAddress(index) => {
                cache self.reserve_scalar_register = target
                f"leaq -{index 1 + common::WORD_SIZE *}(%r14), {target}" self.indent_string
            }
            InstValue::LocalSet(index) => {
                f"movq {top}, -{index 1 + common::WORD_SIZE *}(%r14)" self.indent_string
                1 -= cache.depth
            }
            InstValue::JumpNe(label) => {
                1 -= cache.depth
                cache self.flush_scalar_stack
                f"testq {top}, {top}" self.indent_string
                f"jz .L{label}" self.indent_string
            }
            InstValue::Drop => 1 -= cache.depth
            InstValue::Dup => {
                cache self.reserve_scalar_register = target
                f"movq {top}, {target}" self.indent_string
            }
            InstValue::Over => {
                cache self.reserve_scalar_register = target
                f"movq {below}, {target}" self.indent_string
            }
            InstValue::Swap => {
                f"movq {top}, %rax" self.indent_string
                f"movq {below}, {top}" self.indent_string
                f"movq %rax, {below}" self.indent_string
            }
            InstValue::Rot => {
                cache.depth 3 - cache.get_register = bottom
                f"movq {bottom}, %rax" self.indent_string
                f"movq {below}, {bottom}" self.indent_string
                f"movq {top}, {below}" self.indent_string
                f"movq %rax, {top}" self.indent_string
            }
            InstValue::Load8 => f"movzbq ({top}), {top}" self.indent_string
            InstValue::Load16 => f"movzwq ({top}), {top}" self.indent_string
            InstValue::Load32 => {
                f"movl ({top}), %eax" self.indent_string
                f"movq %rax, {top}" self.indent_string
            }
            InstValue::Load64 => f"movq ({top}), {top}" self.indent_string
            InstValue::Store8 => {
                f"movq {below}, %rax" self.indent_string
                f"movb %al, ({top})" self.indent_string
                2 -= cache.depth
            }
            InstValue::Store16 => {
                f"movq {below}, %rax" self.indent_string
                f"movw %ax, ({top})" self.indent_string
                2 -= cache.depth
            }
            InstValue::Store32 => {
                f"movq {below}, %rax" self.indent_string
                f"movl %eax, ({top})" self.indent_string
                2 -= cache.depth
            }
            InstValue::Store64 => {
                f"movq {below}, ({top})" self.indent_string
                2 -= cache.depth
            }
            InstValue::BitNot => f"notq {top}" self.indent_string
            # These eligible conversions leave the representation unchanged.
            InstValue::NormalizeInt => {
            }
            InstValue::NumericConvert => {
            }
            InstValue::Not => {
                f"cmpq $0, {top}" self.indent_string
                "sete %al" self.indent
                f"movzbq %al, {top}" self.indent_string
            }
            _ => {
                inst match
                    InstValue::Add => f"addq {top}, {below}" self.indent_string
                    InstValue::Sub => f"subq {top}, {below}" self.indent_string
                    InstValue::Mul => f"imulq {top}, {below}" self.indent_string
                    InstValue::CheckedAdd(builtin) => {
                        f"addq {top}, {below}" self.indent_string
                        if builtin.is_unsigned then "jc arithmetic_error" else "jo arithmetic_error" fi self.indent
                    }
                    InstValue::CheckedSub(builtin) => {
                        f"subq {top}, {below}" self.indent_string
                        if builtin.is_unsigned then "jc arithmetic_error" else "jo arithmetic_error" fi self.indent
                    }
                    InstValue::CheckedMul(builtin) => {
                        if builtin.is_unsigned then
                            f"movq {below}, %rax" self.indent_string
                            f"mulq {top}" self.indent_string
                            "testq %rdx, %rdx" self.indent
                            "jnz arithmetic_error" self.indent
                            f"movq %rax, {below}" self.indent_string
                        else
                            f"imulq {top}, {below}" self.indent_string
                            "jo arithmetic_error" self.indent
                        fi
                    }
                    InstValue::BitAnd => f"andq {top}, {below}" self.indent_string
                    InstValue::BitOr => f"orq {top}, {below}" self.indent_string
                    InstValue::BitXor => f"xorq {top}, {below}" self.indent_string
                    InstValue::And => {
                        f"testq {top}, {top}" self.indent_string
                        "setne %al" self.indent
                        f"testq {below}, {below}" self.indent_string
                        "setne %cl" self.indent
                        "andb %cl, %al" self.indent
                        f"movzbq %al, {below}" self.indent_string
                    }
                    InstValue::Or => {
                        f"orq {top}, {below}" self.indent_string
                        "setne %al" self.indent
                        f"movzbq %al, {below}" self.indent_string
                    }
                    _ => {
                        inst match
                            InstValue::Eq => "sete"
                            InstValue::Ne => "setne"
                            InstValue::Lt => "setl"
                            InstValue::Le => "setle"
                            InstValue::Gt => "setg"
                            InstValue::Ge => "setge"
                            InstValue::Ult => "setb"
                            InstValue::Ule => "setbe"
                            InstValue::Ugt => "seta"
                            InstValue::Uge => "setae"
                            _ => "Invalid cached scalar operation" panic
                        end = comparison
                        f"cmpq {below}, {top}" self.indent_string
                        f"{comparison} %al" self.indent_string
                        f"movzbq %al, {below}" self.indent_string
                    }
                end
                1 -= cache.depth
            }
        end
        true
    }

    # ============================================================================
    # Emit comparison helper
    # ============================================================================

    fn emit_comparison self:mut$Emitter setcc:str {
        "popq %rax" self.indent
        "cmpq (%rsp), %rax" self.indent
        f"{setcc} %al" self.indent_string
        "movzbq %al, %rax" self.indent
        "movq %rax, (%rsp)" self.indent
    }

    # ============================================================================
    # Emit syscall helper
    # ============================================================================

    fn emit_syscall self:mut$Emitter arg_count:u64 {
        "popq %rax" self.indent
        ["%rdi", "%rsi", "%rdx", "%r10", "%r8", "%r9"] = syscall_regs
        0 = index: u64
        while index arg_count > do
            f"popq {index syscall_regs array::nth}" self.indent_string
            1 += index
        done
        "syscall" self.indent
        "pushq %rax" self.indent
    }

    # Plans are request-owned. Temporarily move one out to keep its borrow
    # independent of the emitter's mutable output, then restore it for later calls.
    fn emit_extern_call self:mut$Emitter identity:$std::String {
        identity self
            .native_calls
            .remove
            .unwrap = plan
        for action in plan.actions.iter do
            action match
                common::NativeAction::Instruction(text) => text.as_str self.indent
                common::NativeAction::Allocate(size) => {
                    f"movq ${size}, %rdi" self.indent_string
                    "extern_alloc_done" "heap_alloc" self.emit_call_via_return_stack
                }
                common::NativeAction::ReleaseArgument(offset) => {
                    f"pushq {offset}(%r13)" self.indent_string
                    self.emit_heap_free_if_allocated
                }
            end
        done
        plan identity.clone self.native_calls.set
    }

    # ============================================================================
    # Check available return and local stack capacity without advancing r14.
    # ============================================================================

    fn emit_return_stack_check self:mut$Emitter byte_count:u64 {
        if RETURN_STACK_SIZE byte_count > then
            "jmp return_stack_overflow" self.indent
            return
        fi
        RETURN_STACK_SIZE byte_count - = maximum_offset
        f"leaq return_stack+{maximum_offset}(%rip), %rcx" self.indent_string
        "cmpq %rcx, %r14" self.indent
        "ja return_stack_overflow" self.indent
    }

    # Reserve space only after the complete range passes the capacity check.
    fn emit_return_stack_reservation self:mut$Emitter byte_count:u64 {
        byte_count self.emit_return_stack_check
        if RETURN_STACK_SIZE byte_count > then
            return
        fi
        f"addq ${byte_count}, %r14" self.indent_string
    }

    # The callee moves the native return address into the reserved slot before
    # accessing the value stack. Native call/ret enables CPU return prediction.
    fn emit_call_via_return_stack self:mut$Emitter jump_target:$str label_prefix:$str {
        self.emit_uid = uid
        common::WORD_SIZE self.emit_return_stack_reservation
        f"call {jump_target}" self.indent_string
        f".L{label_prefix}_{uid}:" self.line_string
    }

    # ============================================================================
    # Emit memory load/store shared helpers
    # ============================================================================

    fn emit_load self:mut$Emitter mov_op:str dst_reg:str {
        "popq %rax" self.indent
        f"{mov_op} (%rax), {dst_reg}" self.indent_string
        "pushq %rax" self.indent
    }

    fn emit_store self:mut$Emitter mov_op:str src_reg:str {
        "popq %rax" self.indent
        "popq %rbx" self.indent
        f"{mov_op} {src_reg}, (%rax)" self.indent_string
    }

    fn emit_move_bytes self:mut$Emitter size:u64 {
        "popq %rdi" self.indent
        "popq %rsi" self.indent
        f"movq ${size}, %rcx" self.indent_string
        "rep movsb" self.indent
    }

    fn emit_indirect_read self:mut$Emitter size:u64 {
        "popq %rax" self.indent
        "pushq %rax" self.indent
        f"movq ${size}, %rdi" self.indent_string
        "indirect_read_alloc_done" "heap_alloc" self.emit_call_via_return_stack
        "popq %r10" self.indent
        "popq %rsi" self.indent
        f"movq ${size}, %rcx" self.indent_string
        "movq %r10, %rdi" self.indent
        "rep movsb" self.indent
        "pushq %r10" self.indent
    }

    fn emit_indirect_write self:mut$Emitter size:u64 {
        "popq %rdi" self.indent
        "popq %rsi" self.indent
        "movq %rsi, %rdx" self.indent
        f"movq ${size}, %rcx" self.indent_string
        "rep movsb" self.indent
        "pushq %rdx" self.indent
        self.emit_heap_free_if_allocated
    }

    fn emit_heap_free_if_allocated self:mut$Emitter {
        self.emit_uid = uid
        "popq %rdi" self.indent
        "movq heap_chunks(%rip), %rax" self.indent
        f".Lheap_free_if_allocated_search_{uid}:" self.line_string
        "testq %rax, %rax" self.indent
        f"jz .Lheap_free_if_allocated_done_{uid}" self.indent_string
        f"leaq {HEAP_CHUNK_HEADER_SIZE}(%rax), %rcx" self.indent_string
        "cmpq %rcx, %rdi" self.indent
        f"jb .Lheap_free_if_allocated_next_{uid}" self.indent_string
        "movq 8(%rax), %rcx" self.indent
        "cmpq %rcx, %rdi" self.indent
        f"jb .Lheap_free_if_allocated_found_{uid}" self.indent_string
        f".Lheap_free_if_allocated_next_{uid}:" self.line_string
        "movq (%rax), %rax" self.indent
        f"jmp .Lheap_free_if_allocated_search_{uid}" self.indent_string
        f".Lheap_free_if_allocated_found_{uid}:" self.line_string
        "heap_free_if_allocated_return" "heap_free" self.emit_call_via_return_stack
        f".Lheap_free_if_allocated_done_{uid}:" self.line_string
    }

    # ============================================================================
    # Emit stack operations
    # ============================================================================

    fn emit_stack_ops self:mut$Emitter inst:$InstValue {
        inst match
            InstValue::Push(value) => {
                if
                    INT32_MIN value >=
                    INT32_MAX value <= &&
                then
                    f"pushq ${value}" self.indent_string
                else
                    f"movabsq ${value}, %rax" self.indent_string
                    "pushq %rax" self.indent
                fi
            }
            InstValue::PushFloat32(value) => {
                "jmp 1f" self.indent
                ".align 4" self.line
                "0:" self.line
                f".float {value}" self.line_string
                "1:" self.line
                "movl 0b(%rip), %eax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::PushFloat64(value) => {
                "jmp 1f" self.indent
                ".align 8" self.line
                "0:" self.line
                f".double {value}" self.line_string
                "1:" self.line
                "pushq 0b(%rip)" self.indent
            }
            InstValue::PushStr(str_index) => {
                f"leaq str_{str_index}(%rip), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            InstValue::PushStaticArray(array_index) => {
                array_index self.static_arrays.get common::StaticArray::elements.length 8 * = byte_count
                if 0 byte_count == then
                    1 = byte_count: u64
                fi
                f"movq ${byte_count}, %rdi" self.indent_string
                "static_array_alloc_done" "heap_alloc" self.emit_call_via_return_stack
                "movq (%rsp), %rdi" self.indent
                f"leaq static_array_{array_index}(%rip), %rsi" self.indent_string
                f"movq ${byte_count}, %rcx" self.indent_string
                "rep movsb" self.indent
            }
            InstValue::PushChar(char_value) => f"pushq ${char_value}" self.indent_string
            InstValue::Drop => "addq $8, %rsp" self.indent
            InstValue::Dup => "pushq (%rsp)" self.indent
            InstValue::Swap => {
                "popq %rax" self.indent
                "popq %rbx" self.indent
                "pushq %rax" self.indent
                "pushq %rbx" self.indent
            }
            InstValue::Over => "pushq 8(%rsp)" self.indent
            InstValue::Rot => {
                "popq %rax" self.indent
                "popq %rbx" self.indent
                "popq %rcx" self.indent
                "pushq %rbx" self.indent
                "pushq %rax" self.indent
                "pushq %rcx" self.indent
            }
            _ => {
                "Internal error: emit_stack_ops called with non-stack InstValue\n" std::eprint
                1 process::exit
            }
        end
    }

    # ============================================================================
    # Emit arithmetic / bitwise / boolean / comparison operations
    # ============================================================================

    fn emit_arithmetic self:mut$Emitter inst:$InstValue {
        inst match
            InstValue::Add => {
                "popq %rax" self.indent
                "addq %rax, (%rsp)" self.indent
            }
            InstValue::Sub => {
                "popq %rax" self.indent
                "subq %rax, (%rsp)" self.indent
            }
            InstValue::Mul => {
                "popq %rax" self.indent
                "imulq (%rsp), %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            InstValue::Div => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "cqto" self.indent
                "idivq %rbx" self.indent
                "pushq %rax" self.indent
            }
            InstValue::Mod => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "cqto" self.indent
                "idivq %rbx" self.indent
                "pushq %rdx" self.indent
            }
            InstValue::UDiv => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "xorq %rdx, %rdx" self.indent
                "divq %rbx" self.indent
                "pushq %rax" self.indent
            }
            InstValue::UMod => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "xorq %rdx, %rdx" self.indent
                "divq %rbx" self.indent
                "pushq %rdx" self.indent
            }
            InstValue::Shl => {
                "popq %rcx" self.indent
                "shlq %cl, (%rsp)" self.indent
            }
            InstValue::Shr => {
                "popq %rcx" self.indent
                "sarq %cl, (%rsp)" self.indent
            }
            InstValue::UShr => {
                "popq %rcx" self.indent
                "shrq %cl, (%rsp)" self.indent
            }
            InstValue::BitAnd => {
                "popq %rax" self.indent
                "andq %rax, (%rsp)" self.indent
            }
            InstValue::BitOr => {
                "popq %rax" self.indent
                "orq %rax, (%rsp)" self.indent
            }
            InstValue::BitXor => {
                "popq %rax" self.indent
                "xorq %rax, (%rsp)" self.indent
            }
            InstValue::BitNot => "notq (%rsp)" self.indent
            InstValue::And => {
                "popq %rax" self.indent
                "testq %rax, %rax" self.indent
                "setne %al" self.indent
                "cmpq $0, (%rsp)" self.indent
                "setne %cl" self.indent
                "andb %cl, %al" self.indent
                "movzbq %al, %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            InstValue::Or => {
                "popq %rax" self.indent
                "orq %rax, (%rsp)" self.indent
                "setne %al" self.indent
                "movzbq %al, %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            InstValue::Not => {
                "cmpq $0, (%rsp)" self.indent
                "sete %al" self.indent
                "movzbq %al, %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            InstValue::Eq => "sete" self.emit_comparison
            InstValue::Ne => "setne" self.emit_comparison
            InstValue::Lt => "setl" self.emit_comparison
            InstValue::Le => "setle" self.emit_comparison
            InstValue::Gt => "setg" self.emit_comparison
            InstValue::Ge => "setge" self.emit_comparison
            InstValue::Ult => "setb" self.emit_comparison
            InstValue::Ule => "setbe" self.emit_comparison
            InstValue::Ugt => "seta" self.emit_comparison
            InstValue::Uge => "setae" self.emit_comparison
            InstValue::NormalizeInt(builtin) => {
                builtin match
                    common::BuiltinType::I8 => "movsbq (%rsp), %rax" self.indent
                    common::BuiltinType::I16 => "movswq (%rsp), %rax" self.indent
                    common::BuiltinType::I32 => "movslq (%rsp), %rax" self.indent
                    common::BuiltinType::U8 => "movzbq (%rsp), %rax" self.indent
                    common::BuiltinType::U16 => "movzwq (%rsp), %rax" self.indent
                    common::BuiltinType::U32 => "movl (%rsp), %eax" self.indent
                    _ => return
                end
                "movq %rax, (%rsp)" self.indent
            }
            InstValue::FloatAdd32 => "addss" self.emit_float_binary
            InstValue::FloatAdd64 => "addsd" self.emit_float_binary
            InstValue::FloatSub32 => "subss" self.emit_float_binary
            InstValue::FloatSub64 => "subsd" self.emit_float_binary
            InstValue::FloatMul32 => "mulss" self.emit_float_binary
            InstValue::FloatMul64 => "mulsd" self.emit_float_binary
            InstValue::FloatDiv32 => "divss" self.emit_float_binary
            InstValue::FloatDiv64 => "divsd" self.emit_float_binary
            InstValue::FloatEq32 => "ucomiss" "sete" self.emit_float_comparison
            InstValue::FloatEq64 => "ucomisd" "sete" self.emit_float_comparison
            InstValue::FloatNe32 => "ucomiss" "setne" self.emit_float_comparison
            InstValue::FloatNe64 => "ucomisd" "setne" self.emit_float_comparison
            InstValue::FloatLt32 => "ucomiss" "setb" self.emit_float_comparison
            InstValue::FloatLt64 => "ucomisd" "setb" self.emit_float_comparison
            InstValue::FloatLe32 => "ucomiss" "setbe" self.emit_float_comparison
            InstValue::FloatLe64 => "ucomisd" "setbe" self.emit_float_comparison
            InstValue::FloatGt32 => "ucomiss" "seta" self.emit_float_comparison
            InstValue::FloatGt64 => "ucomisd" "seta" self.emit_float_comparison
            InstValue::FloatGe32 => "ucomiss" "setae" self.emit_float_comparison
            InstValue::FloatGe64 => "ucomisd" "setae" self.emit_float_comparison
            InstValue::CheckedAdd(builtin) => "arithmetic_error" builtin self.emit_checked_add
            InstValue::CheckedSub(builtin) => "arithmetic_error" builtin self.emit_checked_sub
            InstValue::CheckedMul(builtin) => "arithmetic_error" builtin self.emit_checked_mul
            InstValue::CheckedDiv(builtin) => "arithmetic_error" builtin false self.emit_checked_division
            InstValue::CheckedMod(builtin) => "arithmetic_error" builtin true self.emit_checked_division
            InstValue::CheckedShl(builtin) => builtin false self.emit_checked_shift
            InstValue::CheckedShr(builtin) => builtin true self.emit_checked_shift
            InstValue::NumericConvert(conversion) => conversion self.emit_numeric_conversion
            InstValue::NumericTry(numeric_try) => numeric_try self.emit_numeric_try
            InstValue::IntegerTry(integer_try) => integer_try self.emit_integer_try
            InstValue::FloatRound(rounding) => rounding self.emit_float_round
            InstValue::FloatFromDecimal => self.emit_float_from_decimal
            InstValue::FloatSignificand => self.emit_float_significand
            _ => {
                "Internal error: emit_arithmetic called with non-arithmetic InstValue\n" std::eprint
                1 process::exit
            }
        end
    }

    fn emit_checked_range self:mut$Emitter builtin:mut$common::BuiltinType failure:$str {
        builtin match
            common::BuiltinType::I8 => "movsbq (%rsp), %rax" self.indent
            common::BuiltinType::I16 => "movswq (%rsp), %rax" self.indent
            common::BuiltinType::I32 => "movslq (%rsp), %rax" self.indent
            common::BuiltinType::U8 => "movzbq (%rsp), %rax" self.indent
            common::BuiltinType::U16 => "movzwq (%rsp), %rax" self.indent
            common::BuiltinType::U32 => "movl (%rsp), %eax" self.indent
            _ => return
        end
        "cmpq %rax, (%rsp)" self.indent
        f"jne {failure}" self.indent_string
    }

    fn emit_checked_add self:mut$Emitter builtin:mut$common::BuiltinType failure:$str {
        "popq %rax" self.indent
        "addq %rax, (%rsp)" self.indent
        if 64 builtin.bit_width == then
            if builtin.is_unsigned then f"jc {failure}" else f"jo {failure}" fi self.indent_string
        else
            failure builtin self.emit_checked_range
        fi
    }

    fn emit_checked_sub self:mut$Emitter builtin:mut$common::BuiltinType failure:$str {
        "popq %rax" self.indent
        "subq %rax, (%rsp)" self.indent
        if 64 builtin.bit_width == then
            if builtin.is_unsigned then f"jc {failure}" else f"jo {failure}" fi self.indent_string
        else
            failure builtin self.emit_checked_range
        fi
    }

    fn emit_checked_mul self:mut$Emitter builtin:mut$common::BuiltinType failure:$str {
        "popq %rax" self.indent
        if builtin common::BuiltinType::U64 == then
            "mulq (%rsp)" self.indent
            "testq %rdx, %rdx" self.indent
            f"jnz {failure}" self.indent_string
        else
            "imulq (%rsp), %rax" self.indent
            if builtin common::BuiltinType::I64 == then
                f"jo {failure}" self.indent_string
            fi
        fi
        "movq %rax, (%rsp)" self.indent
        if 64 builtin.bit_width != then
            failure builtin self.emit_checked_range
        fi
    }

    fn emit_checked_division
        self:mut$Emitter
        remainder:bool
        builtin:mut$common::BuiltinType
        failure:$str
    {
        "popq %rbx" self.indent
        "testq %rbx, %rbx" self.indent
        f"jz {failure}" self.indent_string
        "movq (%rsp), %rax" self.indent
        if builtin.is_unsigned then
            "xorq %rdx, %rdx" self.indent
            "divq %rbx" self.indent
        else
            builtin copy common::Type::Builtin = integer_type
            integer_type.get_integer_min = minimum
            self.emit_uid = uid
            "cmpq $-1, %rbx" self.indent
            f"jne .Ldiv_ready_{uid}" self.indent_string
            f"movabsq ${minimum}, %rcx" self.indent_string
            "cmpq %rcx, %rax" self.indent
            f"je {failure}" self.indent_string
            f".Ldiv_ready_{uid}:" self.line_string
            "cqto" self.indent
            "idivq %rbx" self.indent
        fi
        if remainder then "movq %rdx, (%rsp)" else "movq %rax, (%rsp)" fi self.indent
    }

    fn emit_checked_shift self:mut$Emitter right:bool builtin:mut$common::BuiltinType {
        "popq %rcx" self.indent
        f"cmpq ${builtin.bit_width}, %rcx" self.indent_string
        "jae arithmetic_error" self.indent
        if right then
            if builtin.is_unsigned then "shrq %cl, (%rsp)" else "sarq %cl, (%rsp)" fi self.indent
        else
            "shlq %cl, (%rsp)" self.indent
        fi
    }

    fn emit_normalize_numeric self:mut$Emitter builtin:mut$common::BuiltinType {
        builtin match
            common::BuiltinType::I8 => "movsbq (%rsp), %rax" self.indent
            common::BuiltinType::I16 => "movswq (%rsp), %rax" self.indent
            common::BuiltinType::I32 => "movslq (%rsp), %rax" self.indent
            common::BuiltinType::U8 => "movzbq (%rsp), %rax" self.indent
            common::BuiltinType::U16 => "movzwq (%rsp), %rax" self.indent
            common::BuiltinType::U32 => "movl (%rsp), %eax" self.indent
            _ => return
        end
        "movq %rax, (%rsp)" self.indent
    }

    fn emit_integer_to_float
        self:mut$Emitter
        source:mut$common::BuiltinType
        target:mut$common::BuiltinType
    {
        self.emit_uid = uid
        "movq (%rsp), %rax" self.indent
        if source common::BuiltinType::U64 == then
            "testq %rax, %rax" self.indent
            f"jns .Luint_float_ready_{uid}" self.indent_string
            "movq %rax, %rcx" self.indent
            "andq $1, %rcx" self.indent
            "shrq $1, %rax" self.indent
            "orq %rcx, %rax" self.indent
            if target common::BuiltinType::F32 == then
                "cvtsi2ssq %rax, %xmm0" self.indent
                "addss %xmm0, %xmm0" self.indent
            else
                "cvtsi2sdq %rax, %xmm0" self.indent
                "addsd %xmm0, %xmm0" self.indent
            fi
            f"jmp .Luint_float_done_{uid}" self.indent_string
            f".Luint_float_ready_{uid}:" self.line_string
        fi
        if target common::BuiltinType::F32 == then
            "cvtsi2ssq %rax, %xmm0" self.indent
        else
            "cvtsi2sdq %rax, %xmm0" self.indent
        fi
        f".Luint_float_done_{uid}:" self.line_string
        if target common::BuiltinType::F32 == then
            "movd %xmm0, %eax" self.indent
            "movq %rax, (%rsp)" self.indent
        else
            "movq %xmm0, (%rsp)" self.indent
        fi
    }

    fn emit_float_constant self:mut$Emitter value:str source:mut$common::BuiltinType register:str {
        self.emit_uid = uid
        f"jmp .Lfloat_constant_done_{uid}" self.indent_string
        if source common::BuiltinType::F32 == then ".align 4" else ".align 8" fi self.line
        f".Lfloat_constant_{uid}:" self.line_string
        if source common::BuiltinType::F32 == then
            f".float {value}"
        else
            f".double {value}"
        fi self.line_string
        f".Lfloat_constant_done_{uid}:" self.line_string
        if source common::BuiltinType::F32 == then
            f"movss .Lfloat_constant_{uid}(%rip), {register}" self.indent_string
        else
            f"movsd .Lfloat_constant_{uid}(%rip), {register}" self.indent_string
        fi
    }

    fn emit_truncate_to_u64 self:mut$Emitter source:mut$common::BuiltinType failure:$str {
        self.emit_uid = uid
        if source common::BuiltinType::F32 == then
            "xorps %xmm1, %xmm1" self.indent
            "ucomiss %xmm1, %xmm0" self.indent
        else
            "xorpd %xmm1, %xmm1" self.indent
            "ucomisd %xmm1, %xmm0" self.indent
        fi
        f"jp {failure}" self.indent_string
        f"jb {failure}" self.indent_string
        "%xmm1" source "18446744073709551616.0" self.emit_float_constant
        if source common::BuiltinType::F32 == then
            "ucomiss %xmm1, %xmm0" self.indent
        else
            "ucomisd %xmm1, %xmm0" self.indent
        fi
        f"jae {failure}" self.indent_string
        "%xmm1" source "9223372036854775808.0" self.emit_float_constant
        if source common::BuiltinType::F32 == then
            "ucomiss %xmm1, %xmm0" self.indent
            f"jb .Ltrunc_u64_low_{uid}" self.indent_string
            "subss %xmm1, %xmm0" self.indent
            "cvttss2siq %xmm0, %rax" self.indent
        else
            "ucomisd %xmm1, %xmm0" self.indent
            f"jb .Ltrunc_u64_low_{uid}" self.indent_string
            "subsd %xmm1, %xmm0" self.indent
            "cvttsd2siq %xmm0, %rax" self.indent
        fi
        "btc $63, %rax" self.indent
        f"jmp .Ltrunc_u64_done_{uid}" self.indent_string
        f".Ltrunc_u64_low_{uid}:" self.line_string
        if source common::BuiltinType::F32 == then
            "cvttss2siq %xmm0, %rax" self.indent
        else
            "cvttsd2siq %xmm0, %rax" self.indent
        fi
        f".Ltrunc_u64_done_{uid}:" self.line_string
        "movq %rax, (%rsp)" self.indent
    }

    fn emit_float_to_integer
        self:mut$Emitter
        source:mut$common::BuiltinType
        target:mut$common::BuiltinType
        failure:$str
    {
        if source common::BuiltinType::F32 == then
            "movss (%rsp), %xmm0" self.indent
        else
            "movsd (%rsp), %xmm0" self.indent
        fi
        if target common::BuiltinType::U64 == then
            failure source self.emit_truncate_to_u64 return
        fi
        if source common::BuiltinType::F32 == then
            "cvttss2siq %xmm0, %rax" self.indent
        else
            "cvttsd2siq %xmm0, %rax" self.indent
        fi
        "movq %rax, (%rsp)" self.indent
        if target common::BuiltinType::I64 == then
            self.emit_uid = uid
            "movabsq $-9223372036854775808, %rcx" self.indent
            "cmpq %rcx, %rax" self.indent
            f"jne .Ltrunc_i64_done_{uid}" self.indent_string
            if source common::BuiltinType::F32 == then
                "cvtsi2ssq %rax, %xmm1" self.indent
                "ucomiss %xmm1, %xmm0" self.indent
            else
                "cvtsi2sdq %rax, %xmm1" self.indent
                "ucomisd %xmm1, %xmm0" self.indent
            fi
            f"jp {failure}" self.indent_string
            f"jne {failure}" self.indent_string
            f".Ltrunc_i64_done_{uid}:" self.line_string
        else
            failure target self.emit_checked_range
            target self.emit_normalize_numeric
        fi
    }

    fn emit_numeric_conversion self:mut$Emitter conversion:$common::NumericConversion {
        if
            conversion.kind common::NumericConversionKind::FromBits ==
            conversion.kind common::NumericConversionKind::ToBits == ||
        then
            return
        fi
        if conversion.source.is_integer conversion.target.is_integer && then
            conversion.target self.emit_normalize_numeric
            return
        fi
        if conversion.source.is_integer conversion.target.is_float && then
            conversion.target conversion.source self.emit_integer_to_float
            return
        fi
        if
            conversion.source common::BuiltinType::F32 ==
            conversion.target common::BuiltinType::F64 == &&
        then
            "movss (%rsp), %xmm0" self.indent
            "cvtss2sd %xmm0, %xmm0" self.indent
            "movq %xmm0, (%rsp)" self.indent
            return
        fi
        if
            conversion.source common::BuiltinType::F64 ==
            conversion.target common::BuiltinType::F32 == &&
        then
            "movsd (%rsp), %xmm0" self.indent
            "cvtsd2ss %xmm0, %xmm0" self.indent
            "movd %xmm0, %eax" self.indent
            "movq %rax, (%rsp)" self.indent
            return
        fi
        if conversion.source.is_float conversion.target.is_integer && then
            "arithmetic_error" conversion.target conversion.source self.emit_float_to_integer
        fi
    }

    fn emit_numeric_try self:mut$Emitter numeric_try:$common::NumericTry {
        if numeric_try.source common::Type::Builtin(source) is then
            numeric_try.target = target
            self.emit_uid = uid
            f".Lnumeric_try_fail_{uid}" = failure
            f".Lnumeric_try_done_{uid}" = done_label
            "movq (%rsp), %r10" self.indent

            if source.is_integer target.is_integer && then
                target self.emit_normalize_numeric
                if source.is_unsigned ! target.is_unsigned && then
                    "testq %r10, %r10" self.indent
                    f"js {failure}" self.indent_string
                elif source.is_unsigned target.is_unsigned ! && then
                    "cmpq $0, (%rsp)" self.indent
                    f"jl {failure}" self.indent_string
                fi
                "cmpq %r10, (%rsp)" self.indent
                f"jne {failure}" self.indent_string
            elif source.is_integer target.is_float && then
                target source self.emit_integer_to_float
                if target common::BuiltinType::F32 == then
                    "movss (%rsp), %xmm0" self.indent
                else
                    "movsd (%rsp), %xmm0" self.indent
                fi
                if source common::BuiltinType::U64 == then
                    "%xmm1" target "18446744073709551616.0" self.emit_float_constant
                    if target common::BuiltinType::F32 == then
                        "ucomiss %xmm1, %xmm0" self.indent
                    else
                        "ucomisd %xmm1, %xmm0" self.indent
                    fi
                    f"jae {failure}" self.indent_string
                    "%xmm1" target "9223372036854775808.0" self.emit_float_constant
                    if target common::BuiltinType::F32 == then
                        "ucomiss %xmm1, %xmm0" self.indent
                        f"jb .Lnumeric_try_uint_low_{uid}" self.indent_string
                        "subss %xmm1, %xmm0" self.indent
                        "cvttss2siq %xmm0, %rax" self.indent
                    else
                        "ucomisd %xmm1, %xmm0" self.indent
                        f"jb .Lnumeric_try_uint_low_{uid}" self.indent_string
                        "subsd %xmm1, %xmm0" self.indent
                        "cvttsd2siq %xmm0, %rax" self.indent
                    fi
                    "btc $63, %rax" self.indent
                    f"jmp .Lnumeric_try_uint_done_{uid}" self.indent_string
                    f".Lnumeric_try_uint_low_{uid}:" self.line_string
                    if target common::BuiltinType::F32 == then
                        "cvttss2siq %xmm0, %rax" self.indent
                    else
                        "cvttsd2siq %xmm0, %rax" self.indent
                    fi
                    f".Lnumeric_try_uint_done_{uid}:" self.line_string
                elif target common::BuiltinType::F32 == then
                    "cvttss2siq %xmm0, %rax" self.indent
                else
                    "cvttsd2siq %xmm0, %rax" self.indent
                fi
                "cmpq %r10, %rax" self.indent
                f"jne {failure}" self.indent_string
            elif source.is_float target.is_integer && then
                failure.as_str target source self.emit_float_to_integer
                "movq (%rsp), %r11" self.indent
                source target self.emit_integer_to_float
                "movq %r10, %xmm1" self.indent
                if source common::BuiltinType::F32 == then
                    "movss (%rsp), %xmm0" self.indent
                    "ucomiss %xmm1, %xmm0" self.indent
                else
                    "movsd (%rsp), %xmm0" self.indent
                    "ucomisd %xmm1, %xmm0" self.indent
                fi
                f"jp {failure}" self.indent_string
                f"jne {failure}" self.indent_string
                "movq %r11, (%rsp)" self.indent
            elif source.is_float target.is_float && then
                false = check_narrowing
                if source target != then
                    source common::BuiltinType::F64 == target common::BuiltinType::F32 == && = check_narrowing
                    target source common::NumericConversionKind::Rounded common::NumericConversion = conversion
                    conversion self.emit_numeric_conversion
                fi
                if check_narrowing then
                    "movq (%rsp), %r11" self.indent
                    common::BuiltinType::F64 common::BuiltinType::F32 common::NumericConversionKind::Exact common::NumericConversion
                    self.emit_numeric_conversion
                    "movq %r10, %xmm1" self.indent
                    "movsd (%rsp), %xmm0" self.indent
                    "ucomisd %xmm1, %xmm0" self.indent
                    f"jp {failure}" self.indent_string
                    f"jne {failure}" self.indent_string
                    "movq %r11, (%rsp)" self.indent
                fi
            else
                f"jmp {failure}" self.indent_string
            fi
            "movq $1, %rax" self.indent
            f"jmp {done_label}" self.indent_string
            f"{failure}:" self.line_string
            "movq $0, (%rsp)" self.indent
            "xorq %rax, %rax" self.indent
            f"{done_label}:" self.line_string
            "pushq %rax" self.indent
        fi
    }

    fn emit_float_binary self:mut$Emitter instruction:str {
        "movq (%rsp), %xmm0" self.indent
        "addq $8, %rsp" self.indent
        "movq (%rsp), %xmm1" self.indent
        f"{instruction} %xmm0, %xmm1" self.indent_string
        "movq %xmm1, (%rsp)" self.indent
    }

    fn emit_float_comparison self:mut$Emitter setcc:str instruction:str {
        "movq (%rsp), %xmm0" self.indent
        "addq $8, %rsp" self.indent
        f"{instruction} (%rsp), %xmm0" self.indent_string
        f"{setcc} %al" self.indent_string
        if "setne" setcc == then
            "setp %cl" self.indent
            "orb %cl, %al" self.indent
        else
            "setnp %cl" self.indent
            "andb %cl, %al" self.indent
        fi
        "movzbq %al, %rax" self.indent
        "movq %rax, (%rsp)" self.indent
    }

    fn emit_float_round self:mut$Emitter rounding:$common::FloatRound {
        self.emit_uid = label_id
        f".Lfloat_round_result_{label_id}" = result_label
        f".Lfloat_round_store_{label_id}" = store_label
        f".Lfloat_round_done_{label_id}" = done_label

        # Values at or above the significand limit are already integral. This
        # also preserves infinities and NaNs without requiring SSE4.1.
        if rounding.target common::BuiltinType::F32 == then
            "movss (%rsp), %xmm0" self.indent
            "movd %xmm0, %eax" self.indent
            "movl %eax, %ecx" self.indent
            f"andl ${F32_ABSOLUTE_MASK}, %ecx" self.indent_string
            f"cmpl ${F32_INTEGRAL_THRESHOLD_BITS}, %ecx" self.indent_string
            f"jae {done_label}" self.indent_string
            "cvttss2siq %xmm0, %rax" self.indent
            "cvtsi2ssq %rax, %xmm1" self.indent
        else
            "movsd (%rsp), %xmm0" self.indent
            "movq %xmm0, %rax" self.indent
            "movq %rax, %rcx" self.indent
            f"btrq ${F64_SIGN_BIT_INDEX}, %rcx" self.indent_string
            f"movabsq ${F64_INTEGRAL_THRESHOLD_BITS}, %rdx" self.indent_string
            "cmpq %rdx, %rcx" self.indent
            f"jae {done_label}" self.indent_string
            "cvttsd2siq %xmm0, %rax" self.indent
            "cvtsi2sdq %rax, %xmm1" self.indent
        fi

        rounding.method.as_str match
            "__float_floor" => {
                if rounding.target common::BuiltinType::F32 == then
                    "ucomiss %xmm1, %xmm0" self.indent
                else
                    "ucomisd %xmm1, %xmm0" self.indent
                fi
                f"jae {result_label}" self.indent_string
                "decq %rax" self.indent
            }
            "__float_ceil" => {
                if rounding.target common::BuiltinType::F32 == then
                    "ucomiss %xmm1, %xmm0" self.indent
                else
                    "ucomisd %xmm1, %xmm0" self.indent
                fi
                f"jbe {result_label}" self.indent_string
                "incq %rax" self.indent
            }
            "__float_trunc" => {
            }
            _ => {
                f".Lfloat_round_adjust_{label_id}" = adjust_label
                f".Lfloat_round_negative_{label_id}" = negative_label
                if rounding.target common::BuiltinType::F32 == then
                    "movaps %xmm0, %xmm2" self.indent
                    "subss %xmm1, %xmm2" self.indent
                    "movd %xmm2, %ecx" self.indent
                    f"andl ${F32_ABSOLUTE_MASK}, %ecx" self.indent_string
                    f"cmpl ${F32_HALF_BITS}, %ecx" self.indent_string
                else
                    "movapd %xmm0, %xmm2" self.indent
                    "subsd %xmm1, %xmm2" self.indent
                    "movq %xmm2, %rcx" self.indent
                    f"btrq ${F64_SIGN_BIT_INDEX}, %rcx" self.indent_string
                    f"movabsq ${F64_HALF_BITS}, %rdx" self.indent_string
                    "cmpq %rdx, %rcx" self.indent
                fi
                f"jb {result_label}" self.indent_string
                f"ja {adjust_label}" self.indent_string
                f"testq ${ODD_INTEGER_MASK}, %rax" self.indent_string
                f"jz {result_label}" self.indent_string
                f"{adjust_label}:" self.line_string
                if rounding.target common::BuiltinType::F32 == then
                    "cmpl $0, (%rsp)" self.indent
                else
                    "cmpq $0, (%rsp)" self.indent
                fi
                f"js {negative_label}" self.indent_string
                "incq %rax" self.indent
                f"jmp {result_label}" self.indent_string
                f"{negative_label}:" self.line_string
                "decq %rax" self.indent
            }
        end

        f"{result_label}:" self.line_string
        if rounding.target common::BuiltinType::F32 == then
            "cvtsi2ssq %rax, %xmm0" self.indent
            "movd %xmm0, %eax" self.indent
            "cmpl $0, (%rsp)" self.indent
            f"jns {store_label}" self.indent_string
            f"btsl ${F32_SIGN_BIT_INDEX}, %eax" self.indent_string
            f"{store_label}:" self.line_string
            "movq %rax, (%rsp)" self.indent
        else
            "cvtsi2sdq %rax, %xmm0" self.indent
            "movq %xmm0, %rax" self.indent
            "cmpq $0, (%rsp)" self.indent
            f"jns {store_label}" self.indent_string
            f"btsq ${F64_SIGN_BIT_INDEX}, %rax" self.indent_string
            f"{store_label}:" self.line_string
            "movq %rax, (%rsp)" self.indent
        fi
        f"{done_label}:" self.line_string
    }

    fn emit_integer_try self:mut$Emitter integer_try:$common::IntegerTry {
        self.emit_uid = uid
        f".Linteger_try_fail_{uid}" = failure
        f".Linteger_try_done_{uid}" = done_label
        integer_try.kind match
            common::IntegerTryKind::Add => {
                failure.as_str integer_try.target self.emit_checked_add
            }
            common::IntegerTryKind::Sub => {
                failure.as_str integer_try.target self.emit_checked_sub
            }
            common::IntegerTryKind::Mul => {
                failure.as_str integer_try.target self.emit_checked_mul
            }
            common::IntegerTryKind::Div => {
                failure.as_str integer_try.target false self.emit_checked_division
            }
            common::IntegerTryKind::Mod => {
                failure.as_str integer_try.target true self.emit_checked_division
            }
        end
        integer_try.target self.emit_normalize_numeric
        "pushq $1" self.indent
        f"jmp {done_label}" self.indent_string
        f"{failure}:" self.line_string
        "movq $0, (%rsp)" self.indent
        "pushq $0" self.indent
        f"{done_label}:" self.line_string
    }

    fn emit_float_from_decimal self:mut$Emitter {
        self.emit_uid = uid
        "fildq (%rsp)" self.indent
        "addq $8, %rsp" self.indent
        "popq %rcx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jz .Ldecimal_float_done_{uid}" self.indent_string
        "xorq %rdx, %rdx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jns .Ldecimal_float_abs_ready_{uid}" self.indent_string
        "negq %rcx" self.indent
        "movq $1, %rdx" self.indent
        f".Ldecimal_float_abs_ready_{uid}:" self.line_string
        "fld1" self.indent
        "fildl float_decimal_ten(%rip)" self.indent
        f".Ldecimal_float_power_loop_{uid}:" self.line_string
        "testq $1, %rcx" self.indent
        f"jz .Ldecimal_float_power_skip_{uid}" self.indent_string
        "fmul %st(0), %st(1)" self.indent
        f".Ldecimal_float_power_skip_{uid}:" self.line_string
        "shrq $1, %rcx" self.indent
        f"jz .Ldecimal_float_power_done_{uid}" self.indent_string
        "fmul %st(0), %st(0)" self.indent
        f"jmp .Ldecimal_float_power_loop_{uid}" self.indent_string
        f".Ldecimal_float_power_done_{uid}:" self.line_string
        "fstp %st(0)" self.indent
        "testq %rdx, %rdx" self.indent
        f"jnz .Ldecimal_float_divide_{uid}" self.indent_string
        "fmulp %st(0), %st(1)" self.indent
        f"jmp .Ldecimal_float_done_{uid}" self.indent_string
        f".Ldecimal_float_divide_{uid}:" self.line_string
        "fdivrp %st(0), %st(1)" self.indent
        f".Ldecimal_float_done_{uid}:" self.line_string
        "subq $8, %rsp" self.indent
        "fstpl (%rsp)" self.indent
    }

    fn emit_float_significand self:mut$Emitter {
        self.emit_uid = uid
        "fldl (%rsp)" self.indent
        "addq $8, %rsp" self.indent
        "popq %rcx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jz .Lfloat_significand_done_{uid}" self.indent_string
        "xorq %rdx, %rdx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jns .Lfloat_significand_abs_ready_{uid}" self.indent_string
        "negq %rcx" self.indent
        "movq $1, %rdx" self.indent
        f".Lfloat_significand_abs_ready_{uid}:" self.line_string
        "fld1" self.indent
        "fildl float_decimal_ten(%rip)" self.indent
        f".Lfloat_significand_power_loop_{uid}:" self.line_string
        "testq $1, %rcx" self.indent
        f"jz .Lfloat_significand_power_skip_{uid}" self.indent_string
        "fmul %st(0), %st(1)" self.indent
        f".Lfloat_significand_power_skip_{uid}:" self.line_string
        "shrq $1, %rcx" self.indent
        f"jz .Lfloat_significand_power_done_{uid}" self.indent_string
        "fmul %st(0), %st(0)" self.indent
        f"jmp .Lfloat_significand_power_loop_{uid}" self.indent_string
        f".Lfloat_significand_power_done_{uid}:" self.line_string
        "fstp %st(0)" self.indent
        "testq %rdx, %rdx" self.indent
        f"jnz .Lfloat_significand_divide_{uid}" self.indent_string
        "fmulp %st(0), %st(1)" self.indent
        f"jmp .Lfloat_significand_done_{uid}" self.indent_string
        f".Lfloat_significand_divide_{uid}:" self.line_string
        "fdivrp %st(0), %st(1)" self.indent
        f".Lfloat_significand_done_{uid}:" self.line_string
        "frndint" self.indent
        "subq $8, %rsp" self.indent
        "fistpq (%rsp)" self.indent
    }

    # ============================================================================
    # Emit control flow / variable / function operations
    # ============================================================================

    fn emit_control_flow self:mut$Emitter inst:$InstValue is_global:bool {
        inst match
            InstValue::Label(label) => f".L{label}:" self.line_string
            InstValue::Jump(label) => f"jmp .L{label}" self.indent_string
            InstValue::JumpNe(label) => {
                "popq %rax" self.indent
                "testq %rax, %rax" self.indent
                f"jz .L{label}" self.indent_string
            }
            InstValue::LocalsInit(count) => {
                if 0 count == then
                    return
                fi
                count common::WORD_SIZE * = byte_count
                "movq %r14, %rdi" self.indent
                byte_count self.emit_return_stack_reservation
                if MAX_DIRECT_LOCAL_WORDS count <= then
                    "xorq %rax, %rax" self.indent
                    0 u64::try_from.unwrap = index
                    while index count > do
                        f"movq %rax, {index common::WORD_SIZE *}(%rdi)" self.indent_string
                        1 += index
                    done
                    f"leaq {byte_count}(%rdi), %rdi" self.indent_string
                    "movq $0, %rcx" self.indent
                else
                    f"movq ${count}, %rcx" self.indent_string
                    "xorq %rax, %rax" self.indent
                    "rep stosq" self.indent
                fi
            }
            InstValue::LocalsUninit(count) => {
                if 0 count != then
                    f"subq ${count common::WORD_SIZE *}, %r14" self.indent_string
                fi
            }
            InstValue::LocalAddress(local_index) => {
                local_index 1 + common::WORD_SIZE * = offset
                f"leaq -{offset}(%r14), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            InstValue::LocalGet(local_index) => {
                local_index 1 + common::WORD_SIZE * = offset
                f"movq -{offset}(%r14), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            InstValue::LocalSet(local_index) => {
                local_index 1 + common::WORD_SIZE * = offset
                "popq %rax" self.indent
                f"movq %rax, -{offset}(%r14)" self.indent_string
            }
            InstValue::ConstantLoad(constant_index) => {
                constant_index common::WORD_SIZE * = offset
                f"movq constants+{offset}(%rip), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            InstValue::ConstantStore(constant_index) => {
                constant_index common::WORD_SIZE * = offset
                "popq %rax" self.indent
                f"movq %rax, constants+{offset}(%rip)" self.indent_string
            }
            InstValue::FnCall(fn_name) => {
                fn_name.as_str sanitize_name = fn_label
                f"fn_{fn_label}" = jump_target
                "ret" jump_target.as_str self.emit_call_via_return_stack
            }
            InstValue::ExternCall(call) => call self.emit_extern_call
            InstValue::FnExec => {
                self.emit_uid = uid
                common::WORD_SIZE self.emit_return_stack_reservation
                # Save the caller's active closure env on the env stack and switch
                # current_env to the popped closure record so its body can access
                # captured values via InstCaptureLoad. After the callee returns,
                # restore the previous env.
                "popq %rax" self.indent
                "movq current_env(%rip), %rbx" self.indent
                "movq env_sp(%rip), %rcx" self.indent
                f"cmpq ${RETURN_STACK_SIZE}, %rcx" self.indent_string
                "jge env_stack_overflow" self.indent
                "movq %rbx, env_stack(%rcx)" self.indent
                "addq $8, %rcx" self.indent
                "movq %rcx, env_sp(%rip)" self.indent
                "movq %rax, current_env(%rip)" self.indent
                "movq (%rax), %rax" self.indent
                "callq *%rax" self.indent
                f".Lret_{uid}:" self.line_string
                "movq env_sp(%rip), %rcx" self.indent
                "subq $8, %rcx" self.indent
                "movq %rcx, env_sp(%rip)" self.indent
                "movq env_stack(%rcx), %rax" self.indent
                "movq %rax, current_env(%rip)" self.indent
            }
            InstValue::DropFn(fn_name) => {
                fn_name.as_str sanitize_name = fn_label
                f"leaq fn_{fn_label}(%rip), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            InstValue::CaptureLoad(capture_index) => {
                capture_index 2 * 2 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq {offset}(%rax), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            InstValue::CaptureSet(capture_index) => {
                capture_index 2 * 2 + common::WORD_SIZE * = offset
                "popq %rax" self.indent
                "movq current_env(%rip), %rbx" self.indent
                f"movq %rax, {offset}(%rbx)" self.indent_string
            }
            InstValue::CaptureFlagLoad(capture_index) => {
                capture_index 2 * 3 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq {offset}(%rax), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            InstValue::CaptureFlagClear(capture_index) => {
                capture_index 2 * 3 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq $0, {offset}(%rax)" self.indent_string
            }
            InstValue::CaptureFlagMark(capture_index) => {
                capture_index 2 * 3 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq $1, {offset}(%rax)" self.indent_string
            }
            InstValue::ClosureRecord(capture_count) => {
                capture_count 2 * 2 + common::WORD_SIZE * = record_size
                f"movq ${record_size}, %rdi" self.indent_string
                "closure_alloc_done" "heap_alloc" self.emit_call_via_return_stack
                "popq %rdx" self.indent
                # Stack top is the destruction function, followed by the call function.
                "popq %rax" self.indent
                "movq %rax, 8(%rdx)" self.indent
                "popq %rax" self.indent
                "movq %rax, (%rdx)" self.indent
                capture_count 0 + = capture_remaining
                while 0 capture_remaining > do
                    capture_remaining 1 - 2 * 2 + common::WORD_SIZE * = field_offset
                    field_offset 8 + = flag_offset
                    "popq %rax" self.indent
                    f"movq %rax, {flag_offset}(%rdx)" self.indent_string
                    "popq %rax" self.indent
                    f"movq %rax, {field_offset}(%rdx)" self.indent_string
                    capture_remaining 1 - = capture_remaining
                done
                "pushq %rdx" self.indent
            }
            InstValue::ClosureDrop => {
                self.emit_uid = uid
                "popq %rax" self.indent
                "movq 8(%rax), %rdx" self.indent
                "testq %rdx, %rdx" self.indent
                f"jz .Lclosure_drop_done_{uid}" self.indent_string
                common::WORD_SIZE self.emit_return_stack_reservation
                "movq current_env(%rip), %rbx" self.indent
                "movq env_sp(%rip), %rcx" self.indent
                f"cmpq ${RETURN_STACK_SIZE}, %rcx" self.indent_string
                "jge env_stack_overflow" self.indent
                "movq %rbx, env_stack(%rcx)" self.indent
                "addq $8, %rcx" self.indent
                "movq %rcx, env_sp(%rip)" self.indent
                "movq %rax, current_env(%rip)" self.indent
                "pushq %rax" self.indent
                "callq *%rdx" self.indent
                f".Lclosure_drop_return_{uid}:" self.line_string
                "movq env_sp(%rip), %rcx" self.indent
                "subq $8, %rcx" self.indent
                "movq %rcx, env_sp(%rip)" self.indent
                "movq env_stack(%rcx), %rax" self.indent
                "movq %rax, current_env(%rip)" self.indent
                f".Lclosure_drop_done_{uid}:" self.line_string
            }
            InstValue::FnPush(fn_name) => {
                fn_name.as_str sanitize_name = fn_label
                f"leaq fn_{fn_label}(%rip), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            InstValue::FnPushStatic(fn_name) => {
                fn_name.as_str sanitize_name = fn_label
                f"leaq closure_{fn_label}(%rip), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            InstValue::Panic => {
                "popq %rdi" self.indent
                "movq (%rdi), %rdx" self.indent
                "leaq 8(%rdi), %rsi" self.indent
                f"movq ${STDERR_FD}, %rdi" self.indent_string
                "panic_write_done" "write_all" self.emit_call_via_return_stack
                f"movq ${EXIT_SYSCALL}, %rax" self.indent_string
                f"movq ${FAILURE_STATUS}, %rdi" self.indent_string
                "syscall" self.indent
            }
            InstValue::FnReturn => {
                if is_global then
                    "movq $60, %rax" self.indent
                    "xorq %rdi, %rdi" self.indent
                    "syscall" self.indent
                else
                    "subq $8, %r14" self.indent
                    "pushq (%r14)" self.indent
                    "ret" self.indent
                fi
            }
            _ => {
                "Internal error: emit_control_flow called with non-control-flow InstValue\n" std::eprint
                1 process::exit
            }
        end
    }

    # ============================================================================
    # Emit memory operations
    # ============================================================================

    fn emit_memory self:mut$Emitter inst:$InstValue {
        inst match
            InstValue::HeapAlloc => {
                "popq %rdi" self.indent
                "heap_alloc_done" "heap_alloc" self.emit_call_via_return_stack
            }
            InstValue::HeapFree => {
                "popq %rdi" self.indent
                "heap_free_done" "heap_free" self.emit_call_via_return_stack
            }
            InstValue::HeapFreeIfAllocated => self.emit_heap_free_if_allocated
            InstValue::Load8 => "%eax" "movzbl" self.emit_load
            InstValue::Load16 => "%eax" "movzwl" self.emit_load
            InstValue::Load32 => "%eax" "movl" self.emit_load
            InstValue::Load64 => "%rax" "movq" self.emit_load
            InstValue::ReadIndirect(size) => size self.emit_indirect_read
            InstValue::Store8 => "%bl" "movb" self.emit_store
            InstValue::Store16 => "%bx" "movw" self.emit_store
            InstValue::Store32 => "%ebx" "movl" self.emit_store
            InstValue::Store64 => "%rbx" "movq" self.emit_store
            InstValue::WriteIndirect(size) => size self.emit_indirect_write
            InstValue::MoveBytes(size) => size self.emit_move_bytes
            _ => {
                "Internal error: emit_memory called with non-memory InstValue\n" std::eprint
                1 process::exit
            }
        end
    }

    # ============================================================================
    # Emit IO operations
    # ============================================================================

    fn emit_io_ops self:mut$Emitter inst:$InstValue {
        inst match
            InstValue::PrintInt => self.select_print_int
            InstValue::PrintUint => self.select_print_uint
            InstValue::PrintBool => self.select_print_bool
            InstValue::PrintStr => self.select_print_str
            InstValue::PrintString => {
                "popq %r12" self.indent
                "movq (%r12), %rdi" self.indent
                "print_string_done" "print_str" self.emit_call_via_return_stack
                "movq (%r12), %rdi" self.indent
                "print_string_data_free_done" "heap_free" self.emit_call_via_return_stack
                "movq %r12, %rdi" self.indent
                "print_string_wrapper_free_done" "heap_free" self.emit_call_via_return_stack
            }
            InstValue::PrintChar => self.select_print_char
            InstValue::PrintCstr => self.select_print_cstr
            InstValue::FstringConcat(fstring_count) => {
                f"movq ${fstring_count}, %rdi" self.indent_string
                "concat_done" "str_concat" self.emit_call_via_return_stack
            }
            InstValue::PrimitiveToStr(builtin) => {
                "popq %rdi" self.indent
                0 = kind
                if builtin.is_unsigned then
                    1 = kind
                elif builtin common::BuiltinType::Bool == then
                    2 = kind
                elif builtin common::BuiltinType::Char == then
                    3 = kind
                elif builtin common::BuiltinType::Cstr == then
                    4 = kind
                fi
                f"movq ${kind}, %r8" self.indent_string
                f"to_str_{builtin.format}_done" = return_label
                return_label.as_str "primitive_to_str" self.emit_call_via_return_stack
            }
            _ => {
                "Internal error: emit_io_ops called with non-IO InstValue\n" std::eprint
                1 process::exit
            }
        end
    }

    # ============================================================================
    # Emit string equality
    # ============================================================================

    fn emit_str_eq self:mut$Emitter {
        self.emit_uid = uid
        "popq %rsi" self.indent
        "popq %rdi" self.indent
        "movq (%rdi), %rcx" self.indent
        "cmpq (%rsi), %rcx" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent_string
        "leaq 8(%rdi), %rdi" self.indent
        "leaq 8(%rsi), %rsi" self.indent
        "repe cmpsb" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent_string
        "pushq $1" self.indent
        f"jmp .Lstreq_done_{uid}" self.indent_string
        f".Lstreq_ne_{uid}:" self.line_string
        "pushq $0" self.indent
        f".Lstreq_done_{uid}:" self.line_string
    }

    fn emit_mixed_string_eq self:mut$Emitter owned_register:$str {
        self.emit_uid = uid
        "popq %rsi" self.indent
        "popq %rdi" self.indent
        f"movq ({owned_register}), {owned_register}" self.indent_string
        "movq (%rdi), %rcx" self.indent
        "cmpq (%rsi), %rcx" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent_string
        "leaq 8(%rdi), %rdi" self.indent
        "leaq 8(%rsi), %rsi" self.indent
        "repe cmpsb" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent_string
        "pushq $1" self.indent
        f"jmp .Lstreq_done_{uid}" self.indent_string
        f".Lstreq_ne_{uid}:" self.line_string
        "pushq $0" self.indent
        f".Lstreq_done_{uid}:" self.line_string
    }

    fn emit_string_str_eq self:mut$Emitter { "%rsi" self.emit_mixed_string_eq }

    fn emit_str_string_eq self:mut$Emitter { "%rdi" self.emit_mixed_string_eq }

    # ============================================================================
    # Emit single instruction (main dispatch)
    # ============================================================================

    fn emit_inst self:mut$Emitter inst:$InstValue is_global:bool {
        inst match
            # Stack operations
            InstValue::Drop => inst self.emit_stack_ops
            InstValue::Dup => inst self.emit_stack_ops
            InstValue::Over => inst self.emit_stack_ops
            InstValue::Push => inst self.emit_stack_ops
            InstValue::PushFloat32 => inst self.emit_stack_ops
            InstValue::PushFloat64 => inst self.emit_stack_ops
            InstValue::PushChar => inst self.emit_stack_ops
            InstValue::PushStr => inst self.emit_stack_ops
            InstValue::PushStaticArray => inst self.emit_stack_ops
            InstValue::Rot => inst self.emit_stack_ops
            InstValue::Swap => inst self.emit_stack_ops

            # Arithmetic / bitshift / bitwise / boolean / comparison
            InstValue::Add => inst self.emit_arithmetic
            InstValue::Sub => inst self.emit_arithmetic
            InstValue::Mul => inst self.emit_arithmetic
            InstValue::Div => inst self.emit_arithmetic
            InstValue::Mod => inst self.emit_arithmetic
            InstValue::Shl => inst self.emit_arithmetic
            InstValue::Shr => inst self.emit_arithmetic
            InstValue::BitAnd => inst self.emit_arithmetic
            InstValue::BitOr => inst self.emit_arithmetic
            InstValue::BitXor => inst self.emit_arithmetic
            InstValue::BitNot => inst self.emit_arithmetic
            InstValue::And => inst self.emit_arithmetic
            InstValue::Or => inst self.emit_arithmetic
            InstValue::Not => inst self.emit_arithmetic
            InstValue::Eq => inst self.emit_arithmetic
            InstValue::Ne => inst self.emit_arithmetic
            InstValue::Lt => inst self.emit_arithmetic
            InstValue::Le => inst self.emit_arithmetic
            InstValue::Gt => inst self.emit_arithmetic
            InstValue::Ge => inst self.emit_arithmetic
            InstValue::Ult => inst self.emit_arithmetic
            InstValue::Ule => inst self.emit_arithmetic
            InstValue::Ugt => inst self.emit_arithmetic
            InstValue::Uge => inst self.emit_arithmetic
            InstValue::UDiv => inst self.emit_arithmetic
            InstValue::UMod => inst self.emit_arithmetic
            InstValue::UShr => inst self.emit_arithmetic
            InstValue::NormalizeInt => inst self.emit_arithmetic
            InstValue::CheckedAdd => inst self.emit_arithmetic
            InstValue::CheckedSub => inst self.emit_arithmetic
            InstValue::CheckedMul => inst self.emit_arithmetic
            InstValue::CheckedDiv => inst self.emit_arithmetic
            InstValue::CheckedMod => inst self.emit_arithmetic
            InstValue::CheckedShl => inst self.emit_arithmetic
            InstValue::CheckedShr => inst self.emit_arithmetic
            InstValue::NumericConvert => inst self.emit_arithmetic
            InstValue::NumericTry => inst self.emit_arithmetic
            InstValue::IntegerTry => inst self.emit_arithmetic
            InstValue::FloatRound => inst self.emit_arithmetic
            InstValue::FloatFromDecimal => inst self.emit_arithmetic
            InstValue::FloatSignificand => inst self.emit_arithmetic
            InstValue::FloatAdd32 => inst self.emit_arithmetic
            InstValue::FloatAdd64 => inst self.emit_arithmetic
            InstValue::FloatSub32 => inst self.emit_arithmetic
            InstValue::FloatSub64 => inst self.emit_arithmetic
            InstValue::FloatMul32 => inst self.emit_arithmetic
            InstValue::FloatMul64 => inst self.emit_arithmetic
            InstValue::FloatDiv32 => inst self.emit_arithmetic
            InstValue::FloatDiv64 => inst self.emit_arithmetic
            InstValue::FloatEq32 => inst self.emit_arithmetic
            InstValue::FloatEq64 => inst self.emit_arithmetic
            InstValue::FloatNe32 => inst self.emit_arithmetic
            InstValue::FloatNe64 => inst self.emit_arithmetic
            InstValue::FloatLt32 => inst self.emit_arithmetic
            InstValue::FloatLt64 => inst self.emit_arithmetic
            InstValue::FloatLe32 => inst self.emit_arithmetic
            InstValue::FloatLe64 => inst self.emit_arithmetic
            InstValue::FloatGt32 => inst self.emit_arithmetic
            InstValue::FloatGt64 => inst self.emit_arithmetic
            InstValue::FloatGe32 => inst self.emit_arithmetic
            InstValue::FloatGe64 => inst self.emit_arithmetic

            # Control flow / variables / functions
            InstValue::Label => is_global inst self.emit_control_flow
            InstValue::Jump => is_global inst self.emit_control_flow
            InstValue::JumpNe => is_global inst self.emit_control_flow
            InstValue::LocalsInit => is_global inst self.emit_control_flow
            InstValue::LocalsUninit => is_global inst self.emit_control_flow
            InstValue::LocalAddress => is_global inst self.emit_control_flow
            InstValue::LocalGet => is_global inst self.emit_control_flow
            InstValue::LocalSet => is_global inst self.emit_control_flow
            InstValue::ConstantLoad => is_global inst self.emit_control_flow
            InstValue::ConstantStore => is_global inst self.emit_control_flow
            InstValue::CaptureLoad => is_global inst self.emit_control_flow
            InstValue::CaptureSet => is_global inst self.emit_control_flow
            InstValue::CaptureFlagLoad => is_global inst self.emit_control_flow
            InstValue::CaptureFlagClear => is_global inst self.emit_control_flow
            InstValue::CaptureFlagMark => is_global inst self.emit_control_flow
            InstValue::ClosureDrop => is_global inst self.emit_control_flow
            InstValue::ClosureRecord => is_global inst self.emit_control_flow
            InstValue::FnCall => is_global inst self.emit_control_flow
            InstValue::ExternCall => is_global inst self.emit_control_flow
            InstValue::FnExec => is_global inst self.emit_control_flow
            InstValue::FnPush => is_global inst self.emit_control_flow
            InstValue::FnPushStatic => is_global inst self.emit_control_flow
            InstValue::Panic => is_global inst self.emit_control_flow
            InstValue::FnReturn => is_global inst self.emit_control_flow
            InstValue::DropFn => is_global inst self.emit_control_flow

            # Memory operations
            InstValue::HeapAlloc => inst self.emit_memory
            InstValue::HeapFree => inst self.emit_memory
            InstValue::HeapFreeIfAllocated => inst self.emit_memory
            InstValue::Load8 => inst self.emit_memory
            InstValue::Load16 => inst self.emit_memory
            InstValue::Load32 => inst self.emit_memory
            InstValue::Load64 => inst self.emit_memory
            InstValue::ReadIndirect => inst self.emit_memory
            InstValue::Store8 => inst self.emit_memory
            InstValue::Store16 => inst self.emit_memory
            InstValue::Store32 => inst self.emit_memory
            InstValue::Store64 => inst self.emit_memory
            InstValue::WriteIndirect => inst self.emit_memory
            InstValue::MoveBytes => inst self.emit_memory

            # IO operations
            InstValue::PrintInt => inst self.emit_io_ops
            InstValue::PrintUint => inst self.emit_io_ops
            InstValue::PrintBool => inst self.emit_io_ops
            InstValue::PrintStr => inst self.emit_io_ops
            InstValue::PrintString => inst self.emit_io_ops
            InstValue::PrintChar => inst self.emit_io_ops
            InstValue::PrintCstr => inst self.emit_io_ops
            InstValue::FstringConcat => inst self.emit_io_ops
            InstValue::PrimitiveToStr => inst self.emit_io_ops

            # String equality
            InstValue::StrEq => self.emit_str_eq
            InstValue::StringStrEq => self.emit_string_str_eq
            InstValue::StrStringEq => self.emit_str_string_eq

            # Syscalls
            InstValue::Syscall0 => 0 self.emit_syscall
            InstValue::Syscall1 => 1 self.emit_syscall
            InstValue::Syscall2 => 2 self.emit_syscall
            InstValue::Syscall3 => 3 self.emit_syscall
            InstValue::Syscall4 => 4 self.emit_syscall
            InstValue::Syscall5 => 5 self.emit_syscall
            InstValue::Syscall6 => 6 self.emit_syscall

            # argc / argv
            InstValue::Argc => {
                "movq __argc(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::Argv => {
                "movq __argv(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::Envp => {
                "movq __envp(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
        end
    }

    # ============================================================================
    # Main emit function
    # ============================================================================
}

fn emit program:Program -> std::String {
    program.split_bytecode = bytecode = program
    program Emitter::new = emitter
    runtime::ASSEMBLY emitter.asm.append
    emitter.emit_bss
    emitter.emit_data
    bytecode emitter.emit_text
    emitter.into_asm
}

impl Emitter {
    fn select_print_int self:mut$Emitter {
        "popq %rdi" self.indent
        "print_done" "print_int" self.emit_call_via_return_stack
    }
}

impl Emitter {
    fn select_print_uint self:mut$Emitter {
        "popq %rdi" self.indent
        "print_uint_done" "print_uint" self.emit_call_via_return_stack
    }
}

impl Emitter {
    fn select_print_bool self:mut$Emitter {
        self.emit_uid = uid
        "popq %rax" self.indent
        "testq %rax, %rax" self.indent
        f"jz .Lpb_false_{uid}" self.indent_string
        "leaq bool_true(%rip), %rsi" self.indent
        "movq $4, %rdx" self.indent
        f"jmp .Lpb_write_{uid}" self.indent_string
        f".Lpb_false_{uid}:" self.line_string
        "leaq bool_false(%rip), %rsi" self.indent
        "movq $5, %rdx" self.indent
        f".Lpb_write_{uid}:" self.line_string
        f"movq ${STDOUT_FD}, %rdi" self.indent_string
        "print_bool_write_done" "write_all" self.emit_call_via_return_stack
    }
}

impl Emitter {
    fn select_print_str self:mut$Emitter {
        "popq %rdi" self.indent
        "print_done" "print_str" self.emit_call_via_return_stack
    }
}

impl Emitter {
    fn select_print_char self:mut$Emitter {
        "popq %rdi" self.indent
        "print_char_encoded" "encode_char" self.emit_call_via_return_stack
        f"movq ${STDOUT_FD}, %rdi" self.indent_string
        "print_char_write_done" "write_all" self.emit_call_via_return_stack
    }
}

impl Emitter {
    fn select_print_cstr self:mut$Emitter {
        self.emit_uid = uid
        "popq %rsi" self.indent
        "movq %rsi, %rdi" self.indent
        f".Lpc_scan_{uid}:" self.line_string
        "cmpb $0, (%rsi)" self.indent
        f"je .Lpc_done_{uid}" self.indent_string
        "incq %rsi" self.indent
        f"jmp .Lpc_scan_{uid}" self.indent_string
        f".Lpc_done_{uid}:" self.line_string
        "movq %rsi, %rdx" self.indent
        "subq %rdi, %rdx" self.indent
        "movq %rdi, %rsi" self.indent
        f"movq ${STDOUT_FD}, %rdi" self.indent_string
        "print_cstr_write_done" "write_all" self.emit_call_via_return_stack
    }
}
# Target instructions for one function. Selection fixes all widths, offsets,
# targets and runtime calls before the renderer sees this buffer.
enum MachineLine {
    Instruction (std::String)
    Directive (std::String)
}

impl Emitter {
    fn render_function self:mut$Emitter {
        false = self.buffering
        self.instructions.reverse
        while self.instructions.is_empty ! do
            self.instructions.pop match
                MachineLine::Instruction(text) => text.as_str self.indent
                MachineLine::Directive(text) => text.as_str self.line
            end
        done
        # Release capacity as well as elements between functions.
        std::List[MachineLine]::new = self.instructions
    }
}
# Scalar commitment is private. Unsupported aggregate/closure/extern programs
# stay on the legacy path until their target plans migrate.
enum ScalarPrimitive derives std::Copy {
    WrappingAdd
    WrappingSub
    WrappingMul
    Add
    Sub
    Mul
    Div
    Mod
    Shl
    Shr
    BitAnd
    BitOr
    BitXor
    BitNot
    And
    Or
    Not
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
    Drop
    Dup
    Over
    Swap
    Rot
    PrintInt
    PrintBool
    PrintChar
    PrintStr
    PrintCstr
}

enum CheckedScalarOp {
    Integer (i64)
    Float (std::String common::BuiltinType)
    String (u64)
    Primitive (ScalarPrimitive common::BuiltinType)
    Convert (common::NumericConversion)
    Load (u64)
    Store (u64)
    Call (u64)
    Conditional (CheckedScalarBody CheckedScalarBody CheckedScalarBody)
    Return
}

struct CheckedScalarBody {
    operations: std::List[CheckedScalarOp]
}

struct CheckedScalarFunction {
    body:        CheckedScalarBody
    local_count: u64
}

struct CheckedScalarProgram {
    functions: std::List[CheckedScalarFunction]
    strings:   std::List[std::String]
}

struct ScalarCursor {
    position: u64
}

struct ScalarCommit {
    source:     $common::SymbolStore
    names:      std::List[std::String]
    identities: std::Map[std::String u64]
    strings:    std::List[std::String]
    supported:  bool
    failure:    std::Option[std::String]
}

impl ScalarCommit {
    fn fail self:mut$ScalarCommit message:$str {
        if self.failure.is_none then
            message.to_str std::Option::Some = self.failure
        fi
    }

    fn classify_type self:mut$ScalarCommit typ:$common::Type -> common::BuiltinType {
        if typ common::Type::Builtin(builtin) is then
            builtin copy return
        fi
        false = self.supported
        common::BuiltinType::I64
    }

    fn resolve_function self:mut$ScalarCommit name:$str -> u64 {
        if name self.identities.get_copy_str std::Option::Some(identity) is then
            identity return
        fi
        if name self.source.get_function std::Option::Some(function) is then
            function.extern_symbol.is_some = external
            function.is_typechecked = checked
            if external then
                false = self.supported
            elif checked ! then
                "Unchecked function in scalar commitment" self.fail
            fi
        else
            "Missing function in scalar commitment" self.fail
        fi
        self.names.length = identity
        name.to_str self.names.push
        identity name.to_str self.identities.set
        identity
    }

    fn resolve_local self:mut$ScalarCommit name:$str locals:$std::Map[std::String u64] -> u64 {
        if name locals.get_copy_str std::Option::Some(identity) is then
            identity return
        fi
        f"Missing local `{name}` in scalar commitment".as_str self.fail
        0
    }

    fn intern self:mut$ScalarCommit value:$str -> u64 {
        0 = index: u64
        for item in self.strings.iter do
            if value item.as_str == then
                index return
            fi
            1 += index
        done
        value.to_str self.strings.push
        index
    }

    fn commit_primitive
        self:mut$ScalarCommit
        op:$common::Op
        kind:ScalarPrimitive
        output:mut$std::List[CheckedScalarOp]
    {
        common::BuiltinType::I64 = builtin
        if op.type_hint std::Option::Some(typ) is then
            typ self.classify_type = builtin
        elif kind.requires_type then
            "Missing checked scalar type" self.fail
        fi
        builtin kind CheckedScalarOp::Primitive output.push
    }

    fn validate_ownership self:mut$ScalarCommit op:$common::Op locals:$std::Map[std::String u64] {
        if op.ownership std::Option::Some(ownership) is then
            for cleanup in ownership.cleanups.iter do
                locals cleanup.name.as_str self.resolve_local drop
                false = self.supported
            done
            if ownership.moves_owner ownership.conditional_move.is_some || then
                false = self.supported
            fi
        fi
    }

    fn commit_operation
        self:mut$ScalarCommit
        op:$common::Op
        locals:$std::Map[std::String u64]
        output:mut$std::List[CheckedScalarOp]
    {
        locals op self.validate_ownership
        op.value match
            common::OpValue::PushInt(value) => value.value CheckedScalarOp::Integer output.push
            common::OpValue::PushBool(value) => value CheckedScalarOp::Integer output.push
            common::OpValue::PushChar(value) => value CheckedScalarOp::Integer output.push
            common::OpValue::PushStr(value) => value.as_str self.intern CheckedScalarOp::String output.push
            common::OpValue::PushFloat(value) => {
                if op.type_hint std::Option::Some(typ) is then
                    typ self.classify_type value.clone CheckedScalarOp::Float output.push
                else
                    "Floating operation lacks a checked type" self.fail
                fi
            }
            common::OpValue::FnCall(name) => name.as_str self.resolve_function CheckedScalarOp::Call output.push
            common::OpValue::PushVar(name) => locals name.as_str self.resolve_local CheckedScalarOp::Load output.push
            common::OpValue::AssignVar(name) => locals name.as_str self.resolve_local CheckedScalarOp::Store output.push
            common::OpValue::AssignInc(name) => {
                locals name.as_str self.resolve_local = identity
                identity CheckedScalarOp::Load output.push
                output ScalarPrimitive::Add op self.commit_primitive
                identity CheckedScalarOp::Store output.push
            }
            common::OpValue::AssignDec(name) => {
                locals name.as_str self.resolve_local = identity
                identity CheckedScalarOp::Load output.push
                common::BuiltinType::I64 ScalarPrimitive::Swap CheckedScalarOp::Primitive output.push
                output ScalarPrimitive::Sub op self.commit_primitive
                identity CheckedScalarOp::Store output.push
            }
            common::OpValue::FnReturn => CheckedScalarOp::Return output.push
            common::OpValue::NumericConvert(conversion) => conversion.clone CheckedScalarOp::Convert output.push
            common::OpValue::UnsafeStart => {
            }
            common::OpValue::UnsafeEnd => {
            }
            common::OpValue::OwnerCleanup => {
            }
            common::OpValue::Rejected => "Rejected operation in scalar commitment" self.fail
            common::OpValue::Identifier(_) => "Unresolved identifier in scalar commitment" self.fail
            common::OpValue::MethodCall(_) => "Unresolved method in scalar commitment" self.fail
            common::OpValue::QualifiedMethodCall(_) => "Unresolved method in scalar commitment" self.fail
            common::OpValue::TraitMethodCall(_) => "Unresolved trait in scalar commitment" self.fail
            common::OpValue::TraitMethodRef(_) => "Unresolved trait in scalar commitment" self.fail
            common::OpValue::Print => "Unresolved print in scalar commitment" self.fail
            common::OpValue::FnPush(name) => {
                name.as_str self.resolve_function drop
                false = self.supported
            }
            common::OpValue::PushArray(items) => {
                false = self.supported
                for item in items.iter do
                    output locals item self.commit_operation
                done
            }
            common::OpValue::ExprGroup(items) => {
                for item in items.iter do
                    output locals item self.commit_operation
                done
            }
            common::OpValue::MatchArm(arm) => {
                false = self.supported
                for item in arm.guard_ops.iter do
                    output locals item self.commit_operation
                done
            }
            common::OpValue::WrappingAdd => output ScalarPrimitive::WrappingAdd op self.commit_primitive
            common::OpValue::WrappingSub => output ScalarPrimitive::WrappingSub op self.commit_primitive
            common::OpValue::WrappingMul => output ScalarPrimitive::WrappingMul op self.commit_primitive
            common::OpValue::Add => output ScalarPrimitive::Add op self.commit_primitive
            common::OpValue::Sub => output ScalarPrimitive::Sub op self.commit_primitive
            common::OpValue::Mul => output ScalarPrimitive::Mul op self.commit_primitive
            common::OpValue::Div => output ScalarPrimitive::Div op self.commit_primitive
            common::OpValue::Mod => output ScalarPrimitive::Mod op self.commit_primitive
            common::OpValue::Shl => output ScalarPrimitive::Shl op self.commit_primitive
            common::OpValue::Shr => output ScalarPrimitive::Shr op self.commit_primitive
            common::OpValue::BitAnd => output ScalarPrimitive::BitAnd op self.commit_primitive
            common::OpValue::BitOr => output ScalarPrimitive::BitOr op self.commit_primitive
            common::OpValue::BitXor => output ScalarPrimitive::BitXor op self.commit_primitive
            common::OpValue::BitNot => output ScalarPrimitive::BitNot op self.commit_primitive
            common::OpValue::And => output ScalarPrimitive::And op self.commit_primitive
            common::OpValue::Or => output ScalarPrimitive::Or op self.commit_primitive
            common::OpValue::Not => output ScalarPrimitive::Not op self.commit_primitive
            common::OpValue::Eq => output ScalarPrimitive::Eq op self.commit_primitive
            common::OpValue::Ne => output ScalarPrimitive::Ne op self.commit_primitive
            common::OpValue::Lt => output ScalarPrimitive::Lt op self.commit_primitive
            common::OpValue::Le => output ScalarPrimitive::Le op self.commit_primitive
            common::OpValue::Gt => output ScalarPrimitive::Gt op self.commit_primitive
            common::OpValue::Ge => output ScalarPrimitive::Ge op self.commit_primitive
            common::OpValue::Drop => output ScalarPrimitive::Drop op self.commit_primitive
            common::OpValue::Dup => output ScalarPrimitive::Dup op self.commit_primitive
            common::OpValue::Over => output ScalarPrimitive::Over op self.commit_primitive
            common::OpValue::Swap => output ScalarPrimitive::Swap op self.commit_primitive
            common::OpValue::Rot => output ScalarPrimitive::Rot op self.commit_primitive
            common::OpValue::PrintInt => output ScalarPrimitive::PrintInt op self.commit_primitive
            common::OpValue::PrintBool => output ScalarPrimitive::PrintBool op self.commit_primitive
            common::OpValue::PrintChar => output ScalarPrimitive::PrintChar op self.commit_primitive
            common::OpValue::PrintStr => output ScalarPrimitive::PrintStr op self.commit_primitive
            common::OpValue::PrintCstr => output ScalarPrimitive::PrintCstr op self.commit_primitive
            _ => false = self.supported
        end
    }

    fn commit_body
        self:mut$ScalarCommit
        ops:$std::List[common::Op]
        cursor:mut$ScalarCursor
        locals:$std::Map[std::String u64]
    -> CheckedScalarBody {
        std::List[CheckedScalarOp]::new = output
        while cursor.position ops.length > self.failure.is_none && do
            cursor.position ops.get = op
            op.value match
                common::OpValue::IfCondition => break
                common::OpValue::IfElse => break
                common::OpValue::IfElif => break
                common::OpValue::IfEnd => break
                common::OpValue::IfStart => {
                    locals op self.validate_ownership
                    locals cursor ops self.commit_conditional output.push
                }
                _ => {
                    output locals op self.commit_operation
                    1 += cursor.position
                }
            end
        done
        output CheckedScalarBody
    }

    fn commit_conditional
        self:mut$ScalarCommit
        ops:$std::List[common::Op]
        cursor:mut$ScalarCursor
        locals:$std::Map[std::String u64]
    -> CheckedScalarOp {
        1 += cursor.position
        locals cursor ops self.commit_body = condition
        if cursor.position ops.length <= then
            "Incomplete scalar condition" self.fail
            std::List[CheckedScalarOp]::new CheckedScalarBody
            std::List[CheckedScalarOp]::new CheckedScalarBody condition CheckedScalarOp::Conditional return
        fi
        if cursor.position ops.get.value common::OpValue::IfCondition is ! then
            "Missing checked condition boundary" self.fail
        fi
        locals cursor.position ops.get self.validate_ownership
        1 += cursor.position
        locals cursor ops self.commit_body = consequent
        std::List[CheckedScalarOp]::new = alternative
        if cursor.position ops.length > then
            locals cursor.position ops.get self.validate_ownership
            cursor.position ops.get.value match
                common::OpValue::IfElse => {
                    1 += cursor.position
                    locals cursor ops self.commit_body = else_body
                    else_body match
                        CheckedScalarBody {
                            operations: operations
                        } => operations = alternative
                    end
                }
                common::OpValue::IfElif => {
                    locals cursor ops self.commit_conditional alternative.push
                    alternative CheckedScalarBody consequent condition CheckedScalarOp::Conditional return
                }
                _ => {
                }
            end
        fi
        if cursor.position ops.length <= then
            "Incomplete scalar conditional" self.fail
        elif cursor.position ops.get.value common::OpValue::IfEnd is then
            locals cursor.position ops.get self.validate_ownership
            1 += cursor.position
        else
            "Invalid checked conditional boundary" self.fail
        fi
        alternative CheckedScalarBody consequent condition CheckedScalarOp::Conditional
    }

    fn commit_function
        self:mut$ScalarCommit
        ops:$std::List[common::Op]
        variables:$std::List[common::Variable]
    -> CheckedScalarFunction {
        std::Map[std::String u64]::new = locals
        for variable in variables.iter do
            variable.typ self.classify_type drop
            if variable.name locals.has ! then
                locals.length variable.name.clone locals.set
            fi
        done
        if self.supported ! then
            locals.length std::List[CheckedScalarOp]::new CheckedScalarBody CheckedScalarFunction return
        fi
        0 ScalarCursor = cursor
        locals cursor ops self.commit_body = body
        if cursor.position ops.length != then
            "Unexpected checked control boundary" self.fail
        fi
        locals.length body CheckedScalarFunction
    }
}

impl ScalarCommit {
    fn commit_named_function
        self:mut$ScalarCommit
        function:$common::Function
    -> CheckedScalarFunction {
        if function.extern_symbol.is_some then
            false = self.supported
            0 std::List[CheckedScalarOp]::new CheckedScalarBody CheckedScalarFunction return
        fi
        for
            parameter in function
                .stack_effect
                .parameters
                .iter
        do
            parameter.typ self.classify_type drop
        done
        for
            typ in function
                .stack_effect
                .return_types
                .iter
        do
            typ self.classify_type drop
        done
        if function.captures.is_empty ! then
            false = self.supported
        fi
        function.variables.clone = variables
        for capture in function.captures.iter do
            capture.clone variables.push
        done
        variables function.ops self.commit_function
    }
}

fn commit_scalar
    result:$typechecker::CheckedProgram
-> std::Result[std::Option[CheckedScalarProgram] std::String] {
    std::Option[std::String]::None true std::List[std::String]::new
    std::Map[std::String u64]::new std::List[std::String]::new result.get_store ScalarCommit = commit
    # Identity zero belongs to root execution. Callees receive identities before any body is built.
    "".to_str commit.names.push
    std::List[common::Variable]::new = root_variables
    for
        variable in result
            .get_store
            .variables
            .iter
    do
        variable.second.clone root_variables.push
    done
    std::List[CheckedScalarFunction]::new = functions
    root_variables result.get_ops commit.commit_function functions.push
    1 = index: u64
    while index commit.names.length > commit.failure.is_none && commit.supported && do
        index commit
            .names
            .get
            .clone = name
        if name.as_str result.get_store.get_function std::Option::Some(function) is then
            function commit.commit_named_function functions.push
        fi
        1 += index
    done
    commit match
        ScalarCommit { strings: strings supported: supported failure: failure } => {
            if failure std::Option::Some(message) is then
                message.clone std::Result::Error
            elif supported then
                strings functions CheckedScalarProgram std::Option::Some std::Result::Ok
            else
                std::Option[CheckedScalarProgram]::None std::Result::Ok
            fi
        }
    end
}
# Request-owned target plans retain only offsets and small leaf ranges. Checked
# bodies own the operations, so no machine buffer survives function rendering.
struct ScalarTargetPlan {
    functions:   $std::List[CheckedScalarFunction]
    leaf_starts: std::List[std::Option[u64]]
}

impl CheckedScalarFunction {
    fn find_leaf_start self:$CheckedScalarFunction -> std::Option[u64] {
        self.body.operations = operations: $std::List[CheckedScalarOp]
        0 = start: u64
        if 1 self.local_count == 2 operations.length >= && then
            if 0 operations.get CheckedScalarOp::Store(slot) is then
                if 0 slot != then
                    std::Option[u64]::None return
                fi
            else
                std::Option[u64]::None return
            fi
            if 1 operations.get CheckedScalarOp::Load(slot) is then
                if 0 slot != then
                    std::Option[u64]::None return
                fi
            else
                std::Option[u64]::None return
            fi
            2 = start: u64
        elif 0 self.local_count != then
            std::Option[u64]::None return
        fi
        if MAX_LEAF_INSTRUCTIONS operations.length start - > then
            std::Option[u64]::None return
        fi
        start = index
        while index operations.length > do
            index operations.get match
                CheckedScalarOp::Integer(_) => {
                }
                CheckedScalarOp::String(_) => {
                }
                CheckedScalarOp::Primitive(kind builtin) => {
                    if builtin.is_float then
                        std::Option[u64]::None return
                    fi
                    kind match
                        # Error writers must observe the original physical frame.
                        ScalarPrimitive::Add => std::Option[u64]::None return
                        ScalarPrimitive::Sub => std::Option[u64]::None return
                        ScalarPrimitive::Mul => std::Option[u64]::None return
                        ScalarPrimitive::PrintInt => std::Option[u64]::None return
                        ScalarPrimitive::PrintBool => std::Option[u64]::None return
                        ScalarPrimitive::PrintChar => std::Option[u64]::None return
                        ScalarPrimitive::PrintStr => std::Option[u64]::None return
                        ScalarPrimitive::PrintCstr => std::Option[u64]::None return
                        ScalarPrimitive::Div => std::Option[u64]::None return
                        ScalarPrimitive::Mod => std::Option[u64]::None return
                        ScalarPrimitive::Shl => std::Option[u64]::None return
                        ScalarPrimitive::Shr => std::Option[u64]::None return
                        _ => {
                        }
                    end
                }
                _ => std::Option[u64]::None return
            end
            1 += index
        done
        start std::Option::Some
    }
}

impl ScalarTargetPlan {
    fn new functions:$std::List[CheckedScalarFunction] -> ScalarTargetPlan {
        std::List[std::Option[u64]]::new = starts
        for function in functions.iter do
            function.find_leaf_start starts.push
        done
        starts functions ScalarTargetPlan
    }
}

impl ScalarPrimitive {
    fn requires_type self:$ScalarPrimitive -> bool {
        self match
            ScalarPrimitive::Drop => false
            ScalarPrimitive::Dup => false
            ScalarPrimitive::Over => false
            ScalarPrimitive::Swap => false
            ScalarPrimitive::Rot => false
            ScalarPrimitive::And => false
            ScalarPrimitive::Or => false
            ScalarPrimitive::Not => false
            ScalarPrimitive::PrintBool => false
            ScalarPrimitive::PrintChar => false
            ScalarPrimitive::PrintStr => false
            ScalarPrimitive::PrintCstr => false
            _ => true
        end
    }

    fn get_input_count self:$ScalarPrimitive -> u64 {
        self match
            ScalarPrimitive::Drop => 1
            ScalarPrimitive::Dup => 1
            ScalarPrimitive::BitNot => 1
            ScalarPrimitive::Not => 1
            ScalarPrimitive::Rot => 3
            ScalarPrimitive::PrintInt => 1
            ScalarPrimitive::PrintBool => 1
            ScalarPrimitive::PrintChar => 1
            ScalarPrimitive::PrintStr => 1
            ScalarPrimitive::PrintCstr => 1
            _ => 2
        end
    }

    fn get_comparison self:$ScalarPrimitive unsigned:bool -> std::Option[str] {
        self match
            ScalarPrimitive::Eq => "sete"
            ScalarPrimitive::Ne => "setne"
            ScalarPrimitive::Lt => if unsigned then "setb" else "setl" fi
            ScalarPrimitive::Le => if unsigned then "setbe" else "setle" fi
            ScalarPrimitive::Gt => if unsigned then "seta" else "setg" fi
            ScalarPrimitive::Ge => if unsigned then "setae" else "setge" fi
            _ => std::Option[str]::None return
        end std::Option::Some
    }
}

impl Emitter {
    fn select_scalar_primitive
        self:mut$Emitter
        kind:$ScalarPrimitive
        builtin:common::BuiltinType
        cache:mut$ScalarStack
    {
        # Floating operations and narrow checked arithmetic use the shared target selectors.
        if builtin.is_float then
            if false kind.get_comparison std::Option::Some(comparison) is then
                cache self.flush_scalar_stack
                if common::BuiltinType::F32 builtin == then
                    "ucomiss"
                else
                    "ucomisd"
                fi
                true kind.get_comparison.unwrap self.emit_float_comparison
                return
            fi
            kind match
                ScalarPrimitive::Add => "add"
                ScalarPrimitive::Sub => "sub"
                ScalarPrimitive::Mul => "mul"
                ScalarPrimitive::Div => "div"
                _ => ""
            end = operation
            if operation "" != then
                cache self.flush_scalar_stack
                if common::BuiltinType::F32 builtin == then "ss" else "sd" fi = suffix
                operation suffix str::concat.as_str self.emit_float_binary
                return
            fi
        fi
        if common::BuiltinType::Str builtin == then
            kind match
                ScalarPrimitive::Eq => {
                    cache self.flush_scalar_stack
                    self.emit_str_eq
                    return
                }
                ScalarPrimitive::Ne => {
                    cache self.flush_scalar_stack
                    self.emit_str_eq
                    "xorq $1, (%rsp)" self.indent
                    return
                }
                _ => {
                }
            end
        fi
        if builtin.is_integer 64 builtin.bit_width != && then
            cache self.flush_scalar_stack
            kind match
                ScalarPrimitive::Add => "arithmetic_error" builtin self.emit_checked_add
                ScalarPrimitive::Sub => "arithmetic_error" builtin self.emit_checked_sub
                ScalarPrimitive::Mul => "arithmetic_error" builtin self.emit_checked_mul
                _ => {
                    builtin kind cache self.select_scalar_cached
                    return
                }
            end
            return
        fi
        builtin kind cache self.select_scalar_cached
    }

    fn select_scalar_cached
        self:mut$Emitter
        cache:mut$ScalarStack
        kind:$ScalarPrimitive
        builtin:common::BuiltinType
    {
        kind.get_input_count cache self.refill_scalar_stack
        cache.depth 1 - cache.get_register = top
        if 1 cache.depth > then cache.depth 2 - cache.get_register else top fi = below
        kind match
            ScalarPrimitive::Drop => 1 -= cache.depth
            ScalarPrimitive::Dup => {
                cache self.reserve_scalar_register = target
                # reserve may flush a full cache, including the value being duplicated.
                f"movq {top}, {target}" self.indent_string
            }
            ScalarPrimitive::Over => {
                cache self.reserve_scalar_register = target
                f"movq {below}, {target}" self.indent_string
            }
            ScalarPrimitive::Swap => {
                f"movq {top}, %rax" self.indent_string
                f"movq {below}, {top}" self.indent_string
                f"movq %rax, {below}" self.indent_string
            }
            ScalarPrimitive::Rot => {
                cache.depth 3 - cache.get_register = bottom
                f"movq {bottom}, %rax" self.indent_string
                f"movq {below}, {bottom}" self.indent_string
                f"movq {top}, {below}" self.indent_string
                f"movq %rax, {top}" self.indent_string
            }
            ScalarPrimitive::BitNot => f"notq {top}" self.indent_string
            ScalarPrimitive::Not => {
                f"testq {top}, {top}" self.indent_string
                "sete %al" self.indent
                f"movzbq %al, {top}" self.indent_string
            }
            ScalarPrimitive::WrappingAdd => {
                f"addq {top}, {below}" self.indent_string
                1 -= cache.depth
            }
            ScalarPrimitive::WrappingSub => {
                # Method receiver is the top operand, unlike infix subtraction.
                f"subq {below}, {top}" self.indent_string
                f"movq {top}, {below}" self.indent_string
                1 -= cache.depth
            }
            ScalarPrimitive::WrappingMul => {
                f"imulq {top}, {below}" self.indent_string
                1 -= cache.depth
            }
            ScalarPrimitive::Add => {
                f"addq {top}, {below}" self.indent_string
                if builtin.is_unsigned then "jc arithmetic_error" else "jo arithmetic_error" fi self.indent
                1 -= cache.depth
            }
            ScalarPrimitive::Sub => {
                f"subq {top}, {below}" self.indent_string
                if builtin.is_unsigned then "jc arithmetic_error" else "jo arithmetic_error" fi self.indent
                1 -= cache.depth
            }
            ScalarPrimitive::Mul => {
                if builtin.is_unsigned then
                    f"movq {below}, %rax" self.indent_string
                    f"mulq {top}" self.indent_string
                    "testq %rdx, %rdx" self.indent
                    "jnz arithmetic_error" self.indent
                    f"movq %rax, {below}" self.indent_string
                else
                    f"imulq {top}, {below}" self.indent_string
                    "jo arithmetic_error" self.indent
                fi
                1 -= cache.depth
            }
            ScalarPrimitive::BitAnd => {
                f"andq {top}, {below}" self.indent_string
                1 -= cache.depth
            }
            ScalarPrimitive::BitOr => {
                f"orq {top}, {below}" self.indent_string
                1 -= cache.depth
            }
            ScalarPrimitive::BitXor => {
                f"xorq {top}, {below}" self.indent_string
                1 -= cache.depth
            }
            ScalarPrimitive::And => {
                f"testq {top}, {top}" self.indent_string
                "setne %al" self.indent
                f"testq {below}, {below}" self.indent_string
                "setne %cl" self.indent
                "andb %cl, %al" self.indent
                f"movzbq %al, {below}" self.indent_string
                1 -= cache.depth
            }
            ScalarPrimitive::Or => {
                f"orq {top}, {below}" self.indent_string
                "setne %al" self.indent
                f"movzbq %al, {below}" self.indent_string
                1 -= cache.depth
            }
            ScalarPrimitive::Div => {
                cache self.flush_scalar_stack
                "arithmetic_error" builtin false self.emit_checked_division
            }
            ScalarPrimitive::Mod => {
                cache self.flush_scalar_stack
                "arithmetic_error" builtin true self.emit_checked_division
            }
            ScalarPrimitive::Shl => {
                cache self.flush_scalar_stack
                builtin false self.emit_checked_shift
            }
            ScalarPrimitive::Shr => {
                cache self.flush_scalar_stack
                builtin true self.emit_checked_shift
            }
            ScalarPrimitive::PrintInt => {
                cache self.flush_scalar_stack
                if builtin.is_unsigned then
                    self.select_print_uint
                else
                    self.select_print_int
                fi
            }
            ScalarPrimitive::PrintBool => {
                cache self.flush_scalar_stack self.select_print_bool
            }
            ScalarPrimitive::PrintChar => {
                cache self.flush_scalar_stack self.select_print_char
            }
            ScalarPrimitive::PrintStr => {
                cache self.flush_scalar_stack self.select_print_str
            }
            ScalarPrimitive::PrintCstr => {
                cache self.flush_scalar_stack self.select_print_cstr
            }
            _ => {
                f"cmpq {below}, {top}" self.indent_string
                builtin.is_unsigned kind.get_comparison.unwrap = comparison
                f"{comparison} %al" self.indent_string
                f"movzbq %al, {below}" self.indent_string
                1 -= cache.depth
            }
        end
        if builtin.is_integer 64 builtin.bit_width != && then
            kind match
                ScalarPrimitive::Shl => true
                ScalarPrimitive::Shr => true
                ScalarPrimitive::WrappingAdd => true
                ScalarPrimitive::WrappingSub => true
                ScalarPrimitive::WrappingMul => true
                ScalarPrimitive::BitAnd => true
                ScalarPrimitive::BitOr => true
                ScalarPrimitive::BitXor => true
                ScalarPrimitive::BitNot => true
                _ => false
            end = normalize
            if normalize then
                cache self.flush_scalar_stack
                builtin self.emit_normalize_numeric
            fi
        fi
    }

    fn select_scalar_return self:mut$Emitter frame_bytes:u64 root:bool {
        if 0 frame_bytes != then
            f"subq ${frame_bytes}, %r14" self.indent_string
        fi
        if root then
            "movq $60, %rax" self.indent
            "xorq %rdi, %rdi" self.indent
            "syscall" self.indent
        else
            "subq $8, %r14" self.indent
            "pushq (%r14)" self.indent
            "ret" self.indent
        fi
    }

    fn select_scalar_call
        self:mut$Emitter
        identity:u64
        cache:mut$ScalarStack
        frame_bytes:u64
        plan:$ScalarTargetPlan
        root:bool
    {
        if identity plan.leaf_starts.get std::Option::Some(start) is then
            # Expansion must check the call slot and the callee's original locals,
            # even though neither is physically allocated by the expanded body.
            identity plan
                .functions
                .get
                .local_count 1 + common::WORD_SIZE * self.emit_return_stack_check
            root start plan frame_bytes cache identity plan
                .functions
                .get
                .body self.select_scalar_body
        else
            cache self.flush_scalar_stack
            "scalar_ret" f".Lscalar_fn_{identity}".as_str self.emit_call_via_return_stack
        fi
    }

    fn select_scalar_body
        self:mut$Emitter
        body:$CheckedScalarBody
        cache:mut$ScalarStack
        frame_bytes:u64
        plan:$ScalarTargetPlan
        start:u64
        root:bool
    {
        start = index
        while index body.operations.length > do
            index body.operations.get = operation
            1 += index
            operation match
                CheckedScalarOp::Integer(value) => {
                    cache self.reserve_scalar_register = target
                    f"movabsq ${value}, {target}" self.indent_string
                }
                CheckedScalarOp::String(identity) => {
                    cache self.reserve_scalar_register = target
                    f"leaq str_{identity}(%rip), {target}" self.indent_string
                }
                CheckedScalarOp::Float(value builtin) => {
                    cache self.flush_scalar_stack
                    "jmp 1f" self.indent
                    if common::BuiltinType::F32 builtin == then
                        ".align 4" self.line "0:" self.line
                        f".float {value}" self.line_string
                        "1:" self.line "movl 0b(%rip), %eax" self.indent
                    else
                        ".align 8" self.line "0:" self.line
                        f".double {value}" self.line_string
                        "1:" self.line "movq 0b(%rip), %rax" self.indent
                    fi
                    "pushq %rax" self.indent
                }
                CheckedScalarOp::Primitive(kind builtin) => cache builtin copy kind self.select_scalar_primitive
                CheckedScalarOp::Convert(conversion) => {
                    cache self.flush_scalar_stack
                    conversion self.emit_numeric_conversion
                }
                CheckedScalarOp::Load(identity) => {
                    cache self.reserve_scalar_register = target
                    f"movq -{identity 1 + common::WORD_SIZE *}(%r14), {target}" self.indent_string
                }
                CheckedScalarOp::Store(identity) => {
                    1 cache self.refill_scalar_stack
                    cache.depth 1 - cache.get_register = top
                    f"movq {top}, -{identity 1 + common::WORD_SIZE *}(%r14)" self.indent_string
                    1 -= cache.depth
                }
                CheckedScalarOp::Call(identity) => root plan frame_bytes cache identity self.select_scalar_call
                CheckedScalarOp::Conditional(condition consequent alternative) => {
                    self.emit_uid = label
                    root 0 plan frame_bytes cache condition self.select_scalar_body
                    1 cache self.refill_scalar_stack
                    cache.depth 1 - cache.get_register = top
                    1 -= cache.depth
                    cache self.flush_scalar_stack
                    f"testq {top}, {top}" self.indent_string
                    f"jz .Lscalar_else_{label}" self.indent_string
                    root 0 plan frame_bytes cache consequent self.select_scalar_body
                    cache self.flush_scalar_stack
                    f"jmp .Lscalar_end_{label}" self.indent_string
                    f".Lscalar_else_{label}:" self.line_string
                    root 0 plan frame_bytes cache alternative self.select_scalar_body
                    cache self.flush_scalar_stack
                    f".Lscalar_end_{label}:" self.line_string
                }
                CheckedScalarOp::Return => {
                    cache self.flush_scalar_stack
                    root frame_bytes self.select_scalar_return
                }
            end
        done
    }

    fn select_scalar_function
        self:mut$Emitter
        function:$CheckedScalarFunction
        identity:u64
        plan:$ScalarTargetPlan
    {
        true = self.buffering
        function.local_count common::WORD_SIZE * = frame_bytes
        0 = start: u64
        if 0 identity != then
            if identity plan.leaf_starts.get std::Option::Some(leaf_start) is then
                leaf_start = start
                if 0 start != then
                    0 = frame_bytes: u64
                fi
            fi
        fi
        if 0 identity == then
            ".globl _start" self.line "_start:" self.line
            "leaq return_stack(%rip), %r14" self.indent
        else
            f".Lscalar_fn_{identity}:" self.line_string
            "popq -8(%r14)" self.indent
        fi
        if 0 start != then
            common::WORD_SIZE self.emit_return_stack_check
        fi
        if 0 frame_bytes != then
            "movq %r14, %rdi" self.indent
            frame_bytes self.emit_return_stack_reservation
            if MAX_DIRECT_LOCAL_WORDS function.local_count <= then
                "xorq %rax, %rax" self.indent
                0 = slot: u64
                while slot function.local_count > do
                    f"movq %rax, {slot common::WORD_SIZE *}(%rdi)" self.indent_string
                    1 += slot
                done
            else
                f"movq ${function.local_count}, %rcx" self.indent_string
                "xorq %rax, %rax" self.indent "rep stosq" self.indent
            fi
        fi
        ScalarStack::new = cache
        0 identity == start plan frame_bytes cache function.body self.select_scalar_body
        cache self.flush_scalar_stack
        0 identity == frame_bytes self.select_scalar_return
        self.render_function
    }
}
# Returns None only for a complete checked program requiring the legacy target path.
# An invalid private reference or incomplete check is always a failure.
fn compile_scalar
    result:$typechecker::CheckedProgram
-> std::Result[std::Option[std::String] std::String] {
    result commit_scalar match
        std::Result::Error(message) => message std::Result::Error
        std::Result::Ok(candidate) => {
            if candidate std::Option::Some(program) is then
                program select_scalar_program std::Option::Some std::Result::Ok
            else
                std::Option[std::String]::None std::Result::Ok
            fi
        }
    end
}

fn select_scalar_program program:CheckedScalarProgram -> std::String {
    Emitter::new_scalar = emitter
    program match
        CheckedScalarProgram { functions: functions strings: strings } => {
            strings = emitter.strings
            runtime::ASSEMBLY emitter.asm.append
            emitter.emit_bss
            emitter.emit_data
            ".section .text" emitter.line
            functions ScalarTargetPlan::new = plan
            0 = identity: u64
            for function in functions.iter do
                plan identity function emitter.select_scalar_function
                1 += identity
            done
        }
    end
    emitter.into_asm
}
