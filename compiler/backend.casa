        kind match
            RoundingKind::Floor => {
                if target common::BuiltinType::F32 == then
                    "ucomiss %xmm1, %xmm0" self.indent
                else
                    "ucomisd %xmm1, %xmm0" self.indent
                fi
                f"jae {result_label}" self.indent_string
                "decq %rax" self.indent
            }
            RoundingKind::Ceil => {
                if target common::BuiltinType::F32 == then
                    "ucomiss %xmm1, %xmm0" self.indent
                else
                    "ucomisd %xmm1, %xmm0" self.indent
                fi
                f"jbe {result_label}" self.indent_string
                "incq %rax" self.indent
            }
            RoundingKind::Trunc => {}
            RoundingKind::Round => {
                f".Lfloat_round_adjust_{label_id}" = adjust_label
                f".Lfloat_round_negative_{label_id}" = negative_label
                if target common::BuiltinType::F32 == then
                    "movaps %xmm0, %xmm2" self.indent
                    "subss %xmm1, %xmm2" self.indent
                    "movd %xmm2, %ecx" self.indent
                    f"andl ${F32_ABSOLUTE_MASK}, %ecx" self.indent_string
                    f"cmpl ${F32_HALF_BITS}, %ecx" self.indent_string
                else
                    "movapd %xmm0, %xmm2" self.indent
                    "subsd %xmm1, %xmm2" self.indent
                    "movq %xmm2, %rcx" self.indent
                    f"btrq ${F64_SIGN_BIT_INDEX}, %rcx" self.indent_string
                    f"movabsq ${F64_HALF_BITS}, %rdx" self.indent_string
                    "cmpq %rdx, %rcx" self.indent
                fi
                f"jb {result_label}" self.indent_string
                f"ja {adjust_label}" self.indent_string
                f"testq ${ODD_INTEGER_MASK}, %rax" self.indent_string
                f"jz {result_label}" self.indent_string
                f"{adjust_label}:" self.line_string
                if target common::BuiltinType::F32 == then
                    f"cmpl $0, {top}" self.indent_string
                else
                    f"cmpq $0, {top}" self.indent_string
                fi
                f"js {negative_label}" self.indent_string
                "incq %rax" self.indent
                f"jmp {result_label}" self.indent_string
                f"{negative_label}:" self.line_string
                "decq %rax" self.indent
            }
        end

        f"{result_label}:" self.line_string
        if target common::BuiltinType::F32 == then
            "cvtsi2ssq %rax, %xmm0" self.indent
            "movd %xmm0, %eax" self.indent
            f"cmpl $0, {top}" self.indent_string
            f"jns {store_label}" self.indent_string
            f"btsl ${F32_SIGN_BIT_INDEX}, %eax" self.indent_string
            f"{store_label}:" self.line_string
            f"movq %rax, {top}" self.indent_string
        else
            "cvtsi2sdq %rax, %xmm0" self.indent
            "movq %xmm0, %rax" self.indent
            f"cmpq $0, {top}" self.indent_string
            f"jns {store_label}" self.indent_string
            f"btsq ${F64_SIGN_BIT_INDEX}, %rax" self.indent_string
            f"{store_label}:" self.line_string
            f"movq %rax, {top}" self.indent_string
        fi
        f"{done_label}:" self.line_string
    }

    fn emit_integer_try self:mut$Emitter integer_try:$common::IntegerTry {
        self.emit_uid = uid
        f".Linteger_try_fail_{uid}" = failure
        f".Linteger_try_done_{uid}" = done_label
        integer_try.kind match
            common::IntegerTryKind::Add => {
                failure.as_str integer_try.target self.emit_checked_add
            }
            common::IntegerTryKind::Sub => {
                failure.as_str integer_try.target self.emit_checked_sub
            }
            common::IntegerTryKind::Mul => {
                failure.as_str integer_try.target self.emit_checked_mul
            }
            common::IntegerTryKind::Div => {
                failure.as_str integer_try.target false self.emit_checked_division
            }
            common::IntegerTryKind::Mod => {
                failure.as_str integer_try.target true self.emit_checked_division
            }
        end
        # Every failure branch jumps after the operation consumes its right operand.
        self.stack_offset = failure_offset
        integer_try.target self.emit_normalize_numeric
        "$1" self.emit_push
        f"jmp {done_label}" self.indent_string
        failure_offset = self.stack_offset
        f"{failure}:" self.line_string
        f"movq $0, {0 self.stack_operand}" self.indent_string
        "$0" self.emit_push
        f"{done_label}:" self.line_string
    }

    fn emit_float_from_decimal self:mut$Emitter {
        self.emit_uid = uid
        f"fildq {0 self.stack_operand}" self.indent_string
        common::WORD_SIZE += self.stack_offset
        "%rcx" self.emit_pop
        "testq %rcx, %rcx" self.indent
        f"jz .Ldecimal_float_done_{uid}" self.indent_string
        "xorq %rdx, %rdx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jns .Ldecimal_float_abs_ready_{uid}" self.indent_string
        "negq %rcx" self.indent
        "movq $1, %rdx" self.indent
        f".Ldecimal_float_abs_ready_{uid}:" self.line_string
        "fld1" self.indent
        "fildl float_decimal_ten(%rip)" self.indent
        f".Ldecimal_float_power_loop_{uid}:" self.line_string
        "testq $1, %rcx" self.indent
        f"jz .Ldecimal_float_power_skip_{uid}" self.indent_string
        "fmul %st(0), %st(1)" self.indent
        f".Ldecimal_float_power_skip_{uid}:" self.line_string
        "shrq $1, %rcx" self.indent
        f"jz .Ldecimal_float_power_done_{uid}" self.indent_string
        "fmul %st(0), %st(0)" self.indent
        f"jmp .Ldecimal_float_power_loop_{uid}" self.indent_string
        f".Ldecimal_float_power_done_{uid}:" self.line_string
        "fstp %st(0)" self.indent
        "testq %rdx, %rdx" self.indent
        f"jnz .Ldecimal_float_divide_{uid}" self.indent_string
        "fmulp %st(0), %st(1)" self.indent
        f"jmp .Ldecimal_float_done_{uid}" self.indent_string
        f".Ldecimal_float_divide_{uid}:" self.line_string
        "fdivrp %st(0), %st(1)" self.indent
        f".Ldecimal_float_done_{uid}:" self.line_string
        common::WORD_SIZE -= self.stack_offset
        f"fstpl {0 self.stack_operand}" self.indent_string
    }

    fn emit_float_significand self:mut$Emitter {
        self.emit_uid = uid
        f"fldl {0 self.stack_operand}" self.indent_string
        common::WORD_SIZE += self.stack_offset
        "%rcx" self.emit_pop
        "testq %rcx, %rcx" self.indent
        f"jz .Lfloat_significand_done_{uid}" self.indent_string
        "xorq %rdx, %rdx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jns .Lfloat_significand_abs_ready_{uid}" self.indent_string
        "negq %rcx" self.indent
        "movq $1, %rdx" self.indent
        f".Lfloat_significand_abs_ready_{uid}:" self.line_string
        "fld1" self.indent
        "fildl float_decimal_ten(%rip)" self.indent
        f".Lfloat_significand_power_loop_{uid}:" self.line_string
        "testq $1, %rcx" self.indent
        f"jz .Lfloat_significand_power_skip_{uid}" self.indent_string
        "fmul %st(0), %st(1)" self.indent
        f".Lfloat_significand_power_skip_{uid}:" self.line_string
        "shrq $1, %rcx" self.indent
        f"jz .Lfloat_significand_power_done_{uid}" self.indent_string
        "fmul %st(0), %st(0)" self.indent
        f"jmp .Lfloat_significand_power_loop_{uid}" self.indent_string
        f".Lfloat_significand_power_done_{uid}:" self.line_string
        "fstp %st(0)" self.indent
        "testq %rdx, %rdx" self.indent
        f"jnz .Lfloat_significand_divide_{uid}" self.indent_string
        "fmulp %st(0), %st(1)" self.indent
        f"jmp .Lfloat_significand_done_{uid}" self.indent_string
        f".Lfloat_significand_divide_{uid}:" self.line_string
        "fdivrp %st(0), %st(1)" self.indent
        f".Lfloat_significand_done_{uid}:" self.line_string
        "frndint" self.indent
        common::WORD_SIZE -= self.stack_offset
        f"fistpq {0 self.stack_operand}" self.indent_string
    }

    fn emit_string_bytes_equal self:mut$Emitter {
        self.emit_uid = uid
        "movq %rcx, %rdx" self.indent
        "shrq $3, %rcx" self.indent
        f"jz .Lbytes_tail_{uid}" self.indent_string
        f".Lbytes_words_{uid}:" self.line_string
        "movq (%rdi), %rax" self.indent
        "cmpq (%rsi), %rax" self.indent
        f"jne .Lbytes_done_{uid}" self.indent_string
        "addq $8, %rdi" self.indent
        "addq $8, %rsi" self.indent
        "decq %rcx" self.indent
        f"jnz .Lbytes_words_{uid}" self.indent_string
        f".Lbytes_tail_{uid}:" self.line_string
        "andq $7, %rdx" self.indent
        f"jz .Lbytes_done_{uid}" self.indent_string
        f".Lbytes_next_{uid}:" self.line_string
        "movb (%rdi), %al" self.indent
        "cmpb (%rsi), %al" self.indent
        f"jne .Lbytes_done_{uid}" self.indent_string
        "incq %rdi" self.indent
        "incq %rsi" self.indent
        "decq %rdx" self.indent
        f"jnz .Lbytes_next_{uid}" self.indent_string
        f".Lbytes_done_{uid}:" self.line_string
    }

    # Both branches store the result into the slot of the consumed left operand.
    fn emit_str_eq self:mut$Emitter {
        self.emit_uid = uid
        "%rsi" self.emit_pop
        0 self.stack_operand = result
        f"movq {result}, %rdi" self.indent_string
        "movq (%rdi), %rcx" self.indent
        "cmpq (%rsi), %rcx" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent_string
        "leaq 8(%rdi), %rdi" self.indent
        "leaq 8(%rsi), %rsi" self.indent
        self.emit_string_bytes_equal
        f"jne .Lstreq_ne_{uid}" self.indent_string
        f"movq $1, {result}" self.indent_string
        f"jmp .Lstreq_done_{uid}" self.indent_string
        f".Lstreq_ne_{uid}:" self.line_string
        f"movq $0, {result}" self.indent_string
        f".Lstreq_done_{uid}:" self.line_string
    }

    fn emit_mixed_string_eq self:mut$Emitter owned_register:$str {
        self.emit_uid = uid
        "%rsi" self.emit_pop
        0 self.stack_operand = result
        f"movq {result}, %rdi" self.indent_string
        f"movq ({owned_register}), {owned_register}" self.indent_string
        "movq (%rdi), %rcx" self.indent
        "cmpq (%rsi), %rcx" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent_string
        "leaq 8(%rdi), %rdi" self.indent
        "leaq 8(%rsi), %rsi" self.indent
        self.emit_string_bytes_equal
        f"jne .Lstreq_ne_{uid}" self.indent_string
        f"movq $1, {result}" self.indent_string
        f"jmp .Lstreq_done_{uid}" self.indent_string
        f".Lstreq_ne_{uid}:" self.line_string
        f"movq $0, {result}" self.indent_string
        f".Lstreq_done_{uid}:" self.line_string
    }

    fn emit_string_str_eq self:mut$Emitter { "%rsi" self.emit_mixed_string_eq }

    fn emit_str_string_eq self:mut$Emitter { "%rdi" self.emit_mixed_string_eq }

    # Scalar operations have already been consumed by emit_scalar_inst.
    fn emit_inst self:mut$Emitter inst:$InstValue is_global:bool {
        inst match
            InstValue::PushStaticArray(array_index byte_count) => {
                f"movq {0 self.stack_operand}, %rdi" self.indent_string
                f"leaq static_array_{array_index}(%rip), %rsi" self.indent_string
                f"movq ${byte_count}, %rcx" self.indent_string
                "rep movsb" self.indent
            }

            # Arithmetic / bitshift / bitwise / boolean / comparison
            InstValue::Div => {
                "%rcx" self.emit_pop
                "%rax" self.emit_pop
                "cqto" self.indent
                "idivq %rcx" self.indent
                "%rax" self.emit_push
            }
            InstValue::Mod => {
                "%rcx" self.emit_pop
                "%rax" self.emit_pop
                "cqto" self.indent
                "idivq %rcx" self.indent
                "%rdx" self.emit_push
            }
            InstValue::Shl => {
                "%rcx" self.emit_pop
                f"shlq %cl, {0 self.stack_operand}" self.indent_string
            }
            InstValue::Shr => {
                "%rcx" self.emit_pop
                f"sarq %cl, {0 self.stack_operand}" self.indent_string
            }
            InstValue::UDiv => {
                "%rcx" self.emit_pop
                "%rax" self.emit_pop
                "xorq %rdx, %rdx" self.indent
                "divq %rcx" self.indent
                "%rax" self.emit_push
            }
            InstValue::UMod => {
                "%rcx" self.emit_pop
                "%rax" self.emit_pop
                "xorq %rdx, %rdx" self.indent
                "divq %rcx" self.indent
                "%rdx" self.emit_push
            }
            InstValue::UShr => {
                "%rcx" self.emit_pop
                f"shrq %cl, {0 self.stack_operand}" self.indent_string
            }
            InstValue::NormalizeInt(builtin) => builtin self.emit_normalize_numeric
            InstValue::CheckedAdd(builtin) => "arithmetic_error" builtin self.emit_checked_add
            InstValue::CheckedSub(builtin) => "arithmetic_error" builtin self.emit_checked_sub
            InstValue::CheckedMul(builtin) => "arithmetic_error" builtin self.emit_checked_mul
            InstValue::CheckedDiv(builtin) => "arithmetic_error" builtin false self.emit_checked_division
            InstValue::CheckedMod(builtin) => "arithmetic_error" builtin true self.emit_checked_division
            InstValue::CheckedShl(builtin) => builtin false self.emit_checked_shift
            InstValue::CheckedShr(builtin) => builtin true self.emit_checked_shift
            InstValue::NumericConvert(conversion) => conversion self.emit_numeric_conversion
            InstValue::NumericTry(source target) => target source self.emit_numeric_try
            InstValue::IntegerTry(integer_try) => integer_try self.emit_integer_try
            InstValue::FloatRound(kind target) => target kind self.emit_float_round
            InstValue::FloatFromDecimal => self.emit_float_from_decimal
            InstValue::FloatSignificand => self.emit_float_significand
            InstValue::FloatEq32 => "ucomiss" "sete" self.emit_float_comparison
            InstValue::FloatEq64 => "ucomisd" "sete" self.emit_float_comparison
            InstValue::FloatNe32 => "ucomiss" "setne" self.emit_float_comparison
            InstValue::FloatNe64 => "ucomisd" "setne" self.emit_float_comparison
            InstValue::FloatLt32 => "ucomiss" "setb" self.emit_float_comparison
            InstValue::FloatLt64 => "ucomisd" "setb" self.emit_float_comparison
            InstValue::FloatLe32 => "ucomiss" "setbe" self.emit_float_comparison
            InstValue::FloatLe64 => "ucomisd" "setbe" self.emit_float_comparison
            InstValue::FloatGt32 => "ucomiss" "seta" self.emit_float_comparison
            InstValue::FloatGt64 => "ucomisd" "seta" self.emit_float_comparison
            InstValue::FloatGe32 => "ucomiss" "setae" self.emit_float_comparison
            InstValue::FloatGe64 => "ucomisd" "setae" self.emit_float_comparison

            # Control flow / variables / functions
            InstValue::Label(label) | InstValue::MemoryLabel(label) => {
                self.sync_value_stack
                f".L{label}:" self.line_string
            }
            InstValue::Jump(label) => {
                self.sync_value_stack
                f"jmp .L{label}" self.indent_string
            }
            InstValue::JumpTable(targets fallback) => {
                self.emit_uid = identity
                targets.length = count
                "%rax" self.emit_pop
                self.sync_value_stack
                f"cmpq ${count}, %rax" self.indent_string
                f"jae .L{fallback}" self.indent_string
                f"jmp *.Ldispatch_{identity}(,%rax,8)" self.indent_string
                ".p2align 3" self.line
                f".Ldispatch_{identity}:" self.line_string
                for target in targets.iter do
                    f".quad .L{target}" self.line_string
                done
            }
            InstValue::LocalsInit(count) => {
                if 0 count == then
                    return
                fi
                count = self.local_count
                count self.register_locals.length +
                if self.preserve_stack then 1 else 0 fi + common::WORD_SIZE * = byte_count
                byte_count = self.frame_bytes
                # Every value slot is assigned before use. Ownership flags are
                # initialized explicitly when the complete frame is finalized.
                byte_count self.emit_return_stack_reservation
                self.save_function_registers
            }
            InstValue::LocalsUninit(count) => {
                if 0 count != then
                    self.restore_function_registers
                    self.frame_bytes = byte_count
                    f"addq ${byte_count}, %rsp" self.indent_string
                    f".cfi_adjust_cfa_offset -{byte_count}" self.indent_string
                fi
            }
            InstValue::ConstantLoad(constant_index) => {
                constant_index common::WORD_SIZE * = offset
                f"movq constants+{offset}(%rip), %rax" self.indent_string
                "%rax" self.emit_push
            }
            InstValue::ConstantStore(constant_index) => {
                constant_index common::WORD_SIZE * = offset
                "%rax" self.emit_pop
                f"movq %rax, constants+{offset}(%rip)" self.indent_string
            }
            InstValue::CaptureLoad(capture_index) => {
                capture_index 2 * 2 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq {offset}(%rax), %rax" self.indent_string
                "%rax" self.emit_push
            }
            InstValue::CaptureAddress(capture_index) => {
                capture_index 2 * 2 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"leaq {offset}(%rax), %rax" self.indent_string
                "%rax" self.emit_push
            }
            InstValue::CaptureSet(capture_index) => {
                capture_index 2 * 2 + common::WORD_SIZE * = offset
                "%rax" self.emit_pop
                "movq current_env(%rip), %rcx" self.indent
                f"movq %rax, {offset}(%rcx)" self.indent_string
            }
            InstValue::CaptureFlagLoad(capture_index) => {
                capture_index 2 * 3 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq {offset}(%rax), %rax" self.indent_string
                "%rax" self.emit_push
            }
            InstValue::CaptureFlagClear(capture_index) => {
                capture_index 2 * 3 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq $0, {offset}(%rax)" self.indent_string
            }
            InstValue::CaptureFlagMark(capture_index) => {
                capture_index 2 * 3 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq $1, {offset}(%rax)" self.indent_string
            }
            InstValue::ClosureDrop => {
                self.emit_uid = uid
                "%rax" self.emit_pop
                self.sync_value_stack
                "movq 8(%rax), %rdx" self.indent
                "testq %rdx, %rdx" self.indent
                f"jz .Lclosure_drop_done_{uid}" self.indent_string
                # The destructor consumes the record, so both paths rejoin at the same rbx.
                "%rax" self.emit_push
                self.sync_value_stack
                "callq *%rdx" self.indent
                f".Lclosure_drop_done_{uid}:" self.line_string
            }
            InstValue::ClosureRecord(capture_count) => {
                capture_count 2 * 2 + common::WORD_SIZE * = record_size
                f"movq ${record_size}, %rdi" self.indent_string
                "call heap_alloc" self.indent
                "movq %rax, %rdx" self.indent
                # Stack top is the destruction function, followed by the call function.
                "%rax" self.emit_pop
                "movq %rax, 8(%rdx)" self.indent
                "%rax" self.emit_pop
                "movq %rax, (%rdx)" self.indent
                capture_count copy = capture_remaining
                while 0 capture_remaining < do
                    capture_remaining 1 - 2 * 2 + common::WORD_SIZE * = field_offset
                    field_offset 8 + = flag_offset
                    "%rax" self.emit_pop
                    f"movq %rax, {flag_offset}(%rdx)" self.indent_string
                    "%rax" self.emit_pop
                    f"movq %rax, {field_offset}(%rdx)" self.indent_string
                    1 -= capture_remaining
                done
                "%rdx" self.emit_push
            }
            InstValue::FnCall(fn_name) => {
                self.sync_value_stack
                f"call fn_{fn_name.as_str self.function_label}" self.indent_string
            }
            InstValue::ExternCall(call) => call self.emit_extern_call
            InstValue::FnExec => {
                "%rax" self.emit_pop
                self.emit_execute
            }
            InstValue::FnPush(fn_name) => {
                f"leaq fn_{fn_name.as_str self.function_label}(%rip), %rax" self.indent_string
                "%rax" self.emit_push
            }
            InstValue::FnPushStatic(fn_name) => {
                f"leaq closure_{fn_name.as_str self.function_label}(%rip), %rax" self.indent_string
                "%rax" self.emit_push
            }
            InstValue::Panic => {
                "%rdi" self.emit_pop
                "movq (%rdi), %rdx" self.indent
                "leaq 8(%rdi), %rsi" self.indent
                f"movq ${STDERR_FD}, %rdi" self.indent_string
                "call write_all" self.indent
                f"movq ${EXIT_SYSCALL}, %rax" self.indent_string
                f"movq ${FAILURE_STATUS}, %rdi" self.indent_string
                "syscall" self.indent
            }
            InstValue::FnReturn => {
                if is_global then
                    "movq $60, %rax" self.indent
                    "xorq %rdi, %rdi" self.indent
                    "syscall" self.indent
                else
                    self.sync_value_stack
                    "ret" self.indent
                    # Code after an early return remains inside the frame.
                    if 0 self.frame_bytes != then
                        f".cfi_adjust_cfa_offset {self.frame_bytes}" self.indent_string
                        self.describe_saved_registers
                    fi
                fi
            }
            InstValue::DropFn(fn_name) => {
                f"leaq fn_{fn_name.as_str self.function_label}(%rip), %rax" self.indent_string
                "%rax" self.emit_push
            }

            # Memory operations
            InstValue::HeapAlloc => {
                "%rdi" self.emit_pop
                "call heap_alloc" self.indent
                "%rax" self.emit_push
            }
            InstValue::HeapFree => {
                "%rdi" self.emit_pop
                "call heap_free" self.indent
            }
            InstValue::ReadIndirect(size) => size self.emit_indirect_read
            InstValue::WriteIndirect(size) => size self.emit_indirect_write
            InstValue::MoveBytes(size) => size self.emit_move_bytes

            # IO operations
            InstValue::PrintInt => self.select_print_int
            InstValue::PrintUint => self.select_print_uint
            InstValue::PrintBool => self.select_print_bool
            InstValue::PrintStr => self.select_print_str
            InstValue::PrintString => {
                "%r12" self.emit_pop
                "movq (%r12), %rdi" self.indent
                "call print_str" self.indent
                "movq (%r12), %rdi" self.indent
                "call heap_free" self.indent
            }
            InstValue::PrintChar => self.select_print_char
            InstValue::PrintCstr => self.select_print_cstr
            InstValue::FstringConcat(fstring_count) => {
                self.sync_value_stack
                f"movq ${fstring_count}, %rdi" self.indent_string
                "call str_concat" self.indent
                fstring_count common::WORD_SIZE * i64::try_from.unwrap += self.stack_offset
                "%rax" self.emit_push
            }
            InstValue::PrimitiveToStr(builtin) => {
                "%rdi" self.emit_pop
                0 = kind
                if builtin.is_unsigned then
                    1 = kind
                elif builtin common::BuiltinType::Bool == then
                    2 = kind
                elif builtin common::BuiltinType::Char == then
                    3 = kind
                elif builtin common::BuiltinType::Cstr == then
                    4 = kind
                fi
                f"movq ${kind}, %r8" self.indent_string
                "call primitive_to_str" self.indent
                "%rax" self.emit_push
            }

            # String equality
            InstValue::StrEq => self.emit_str_eq
            InstValue::StringStrEq => self.emit_string_str_eq
            InstValue::StrStringEq => self.emit_str_string_eq

            # Syscalls
            InstValue::Syscall0 => 0 self.emit_syscall
            InstValue::Syscall1 => 1 self.emit_syscall
            InstValue::Syscall2 => 2 self.emit_syscall
            InstValue::Syscall3 => 3 self.emit_syscall
            InstValue::Syscall4 => 4 self.emit_syscall
            InstValue::Syscall5 => 5 self.emit_syscall
            InstValue::Syscall6 => 6 self.emit_syscall

            # argc / argv
            InstValue::Argc => {
                "movq __argc(%rip), %rax" self.indent
                "%rax" self.emit_push
            }
            InstValue::Argv => {
                "movq __argv(%rip), %rax" self.indent
                "%rax" self.emit_push
            }
            InstValue::Envp => {
                "movq __envp(%rip), %rax" self.indent
                "%rax" self.emit_push
            }
            _ => "Cached scalar operation reached fallback emitter" panic
        end
    }
}

impl Emitter {
    fn select_print_int self:mut$Emitter {
        "%rdi" self.emit_pop
        "call print_int" self.indent
    }
}

impl Emitter {
    fn select_print_uint self:mut$Emitter {
        "%rdi" self.emit_pop
        "call print_uint" self.indent
    }
}

impl Emitter {
    fn select_print_bool self:mut$Emitter {
        self.emit_uid = uid
        "%rax" self.emit_pop
        "testq %rax, %rax" self.indent
        f"jz .Lpb_false_{uid}" self.indent_string
        "leaq bool_true(%rip), %rsi" self.indent
        "movq $4, %rdx" self.indent
        f"jmp .Lpb_write_{uid}" self.indent_string
        f".Lpb_false_{uid}:" self.line_string
        "leaq bool_false(%rip), %rsi" self.indent
        "movq $5, %rdx" self.indent
        f".Lpb_write_{uid}:" self.line_string
        f"movq ${STDOUT_FD}, %rdi" self.indent_string
        "call write_all" self.indent
    }
}

impl Emitter {
    fn select_print_str self:mut$Emitter {
        "%rdi" self.emit_pop
        "call print_str" self.indent
    }
}

impl Emitter {
    fn select_print_char self:mut$Emitter {
        "%rdi" self.emit_pop
        "call encode_char" self.indent
        f"movq ${STDOUT_FD}, %rdi" self.indent_string
        "call write_all" self.indent
    }
}

impl Emitter {
    fn select_print_cstr self:mut$Emitter {
        self.emit_uid = uid
        "%rsi" self.emit_pop
        "movq %rsi, %rdi" self.indent
        f".Lpc_scan_{uid}:" self.line_string
        "cmpb $0, (%rsi)" self.indent
        f"je .Lpc_done_{uid}" self.indent_string
        "incq %rsi" self.indent
        f"jmp .Lpc_scan_{uid}" self.indent_string
        f".Lpc_done_{uid}:" self.line_string
        "movq %rsi, %rdx" self.indent
        "subq %rdi, %rdx" self.indent
        "movq %rdi, %rsi" self.indent
        f"movq ${STDOUT_FD}, %rdi" self.indent_string
        "call write_all" self.indent
    }
}

# A complete physical function plan owns its actions and capture bounds.
struct FunctionPlan {
    locations:     std::List[common::Location]
    actions:       std::List[InstValue]
    capture_count: u64
}

impl FunctionPlan {
    fn new actions:std::List[InstValue] capture_count:u64 -> FunctionPlan {
        std::List[InstValue]::new = instructions
        std::List[common::Location]::new = locations
        common::empty_location = location
        # Frame setup belongs to the declaration, before the first body operation.
        for action in actions.iter do
            if action InstValue::Source(origin) is then
                origin.clone = location
                break
            fi
        done
        actions.reverse
        while actions.is_empty ! do
            actions.pop = action
            if action InstValue::Source(origin) is then
                origin = location
            else
                location.clone locations.push
                action instructions.push
            fi
        done
        capture_count instructions locations FunctionPlan
    }
}

impl Emitter {
    fn validate_function self:$Emitter plan:$FunctionPlan -> std::Result[std::Unit std::String] {
        std::Set[i64]::new = labels
        0 = local_count: u64
        if plan.actions.is_empty ! then
            if 0 plan.actions.get InstValue::LocalsInit(count) is then
                count = local_count
            fi
        fi
        for action in plan.actions.iter do
            action match
                InstValue::Label(label) | InstValue::MemoryLabel(label) => {
                    if label label_key labels.has label label_key self.labels.has || then
                        "Duplicate machine label".to_str std::Result::Error return
                    fi
                    label label_key labels.add
                }
                _ => {}
            end
        done
        for action in plan.actions.iter do
            true = valid
            action match
                InstValue::Jump(label) => label label_key labels.has = valid
                InstValue::JumpNe(label) => label label_key labels.has = valid
                InstValue::JumpTable(targets fallback) => {
                    fallback label_key labels.has targets.is_empty ! && = valid
                    for target in targets.iter do
                        target copy label_key labels.has valid && = valid
                    done
                }
                InstValue::FnCall(name) => name self.functions.has = valid
                InstValue::FnPush(name) => name self.functions.has = valid
                InstValue::FnPushStatic(name) => name self.functions.has = valid
                InstValue::DropFn(name) => name self.functions.has = valid
                InstValue::ExternCall(name) => name self.native_calls.has = valid
                InstValue::PushStr(index) => self.strings.length index > = valid
                InstValue::PushStaticArray(index _) => self.static_arrays.length index > = valid
                InstValue::LocalAddress(slot) => local_count slot > = valid
                InstValue::LocalGet(slot) => local_count slot > = valid
                InstValue::LocalSet(slot) => local_count slot > = valid
                InstValue::LocalsInit(count) => local_count count == = valid
                InstValue::LocalsUninit(count) => local_count count == = valid
                InstValue::CaptureLoad(slot) => plan.capture_count slot > = valid
                InstValue::CaptureAddress(slot) => plan.capture_count slot > = valid
                InstValue::CaptureSet(slot) => plan.capture_count slot > = valid
                InstValue::CaptureFlagLoad(slot) => plan.capture_count slot > = valid
                InstValue::CaptureFlagMark(slot) => plan.capture_count slot > = valid
                InstValue::CaptureFlagClear(slot) => plan.capture_count slot > = valid
                InstValue::ConstantLoad(slot) => self.constants_count slot > = valid
                InstValue::ConstantStore(slot) => self.constants_count slot > = valid
                _ => {}
            end
            if valid ! then
                "Invalid machine reference".to_str std::Result::Error return
            fi
        done
        std::Unit::Value std::Result::Ok
    }
}

fn label_key value:u64 -> i64 {
    # SAFETY: The conversion preserves all label bits in the hash key.
    unsafe { value i64::wrapping_from }
}

impl Emitter {
    fn validate_pool_element self:$Emitter element:$StaticArrayElement -> bool {
        element match
            StaticArrayElement::Imm(_) => true
            StaticArrayElement::String(identity) => self.strings.length identity >
            StaticArrayElement::Function(name) => name self.completed.has
        end
    }

    fn validate_pools self:$Emitter -> std::Result[std::Unit std::String] {
        for array in self.static_arrays.iter do
            for element in array.elements.iter do
                if element self.validate_pool_element ! then
                    "Invalid static array reference".to_str std::Result::Error return
                fi
            done
        done
        std::Unit::Value std::Result::Ok
    }
}

impl Emitter {
    fn reject self:mut$Emitter message:$str -> std::Result[std::Unit std::String] {
        message.to_str std::Option::Some = self.failure
        message.to_str std::Result::Error
    }

    fn begin_selection self:mut$Emitter plan:$FunctionPlan -> std::Result[std::Unit std::String] {
        if self.failure std::Option::Some(message) is then
            message.clone std::Result::Error return
        fi
        plan self.validate_function match
            std::Result::Error(message) => message.as_str self.reject return
            std::Result::Ok(_) => {}
        end
        for action in plan.actions.iter do
            action match
                InstValue::Label(label) | InstValue::MemoryLabel(label) => label label_key self.labels.add
                _ => {}
            end
        done
        std::Unit::Value std::Result::Ok
    }
}

impl FunctionPlanner {
    fn compile_primitive
        self:mut$FunctionPlanner
        kind:$semantic_body::PrimitiveKind
        typ:$common::Type
        facts:$semantic_body::OperationFacts
        bytecode:mut$std::List[InstValue]
    {
        kind match
            semantic_body::PrimitiveKind::Drop => bytecode typ self.compile_destruction
            semantic_body::PrimitiveKind::Copy => {
                if typ self.is_copy_aggregate then
                    bytecode typ self.emit_inline_copy
                else
                    bytecode typ self.emit_typed_copy
                fi
            }
            semantic_body::PrimitiveKind::Typeof => {
                typ.format = name
                name.as_str self.intern_string = identity
                InstValue::Drop bytecode.push
                identity InstValue::PushStr bytecode.push
            }
            semantic_body::PrimitiveKind::WrappingAdd => bytecode typ kind self.compile_wrapping_numeric_op
            semantic_body::PrimitiveKind::WrappingSub => bytecode typ kind self.compile_wrapping_numeric_op
            semantic_body::PrimitiveKind::WrappingMul => bytecode typ kind self.compile_wrapping_numeric_op
            _ => {
                if bytecode facts typ kind self.compile_direct_op ! then
                    "Missing checked primitive plan" self.record_failure
                fi
            }
        end
    }
}

impl FunctionPlanner {
    fn compile_intrinsic
        self:mut$FunctionPlanner
        kind:$semantic_body::IntrinsicKind
        bytecode:mut$std::List[InstValue]
    {
        kind match
            semantic_body::IntrinsicKind::FnReturn => {
                bytecode self.finish_results
                InstValue::FnReturn bytecode.push
            }
            semantic_body::IntrinsicKind::WhileBreak => bytecode kind self.compile_loop_exit
            semantic_body::IntrinsicKind::WhileContinue => bytecode kind self.compile_loop_exit
            semantic_body::IntrinsicKind::PtrFromRef => {}
            semantic_body::IntrinsicKind::OwnerCleanup => {}
            semantic_body::IntrinsicKind::FstringToStr => {}
            semantic_body::IntrinsicKind::PtrNull => 0 InstValue::Push bytecode.push
            semantic_body::IntrinsicKind::FloatFromDecimal => InstValue::FloatFromDecimal bytecode.push
            semantic_body::IntrinsicKind::FloatSignificand => InstValue::FloatSignificand bytecode.push
            _ => {
                kind intrinsic_to_inst match
                    std::Option::Some(action) => action bytecode.push
                    std::Option::None => "Missing checked intrinsic plan" self.record_failure
                end
            }
        end
    }

    fn compile_loop_exit
        self:mut$FunctionPlanner
        kind:$semantic_body::IntrinsicKind
        bytecode:mut$std::List[InstValue]
    {
        if self.loop_targets.is_empty then
            "Missing checked loop target" self.record_failure return
        fi
        self.loop_targets.length 1 - self.loop_targets.get = targets
        if kind semantic_body::IntrinsicKind::WhileBreak == then
            targets.exit
        else
            targets.start
        fi
        InstValue::Jump bytecode.push
    }
}

fn sanitize_name name:$str -> std::String {
    name "::" str::split.unwrap = parts
    "__" parts.join_strings = namespaced
    std::String::new = result
    for character in namespaced.iter do
        if
            character.is_alpha
            character.is_digit ||
            '_' character == ||
            ':' character == ||
        then
            character result.push
        else
            '_' result.push
        fi
    done
    result
}

fn make_octal_digit value:u32 -> char { value '0'.codepoint + char::from_codepoint.unwrap }

fn escape_string s:$str -> std::String {
    std::String::new = builder
    for index in s.length 0 std::Range::new do
        index s.at.unwrap = byte
        if '\\' byte == then
            "\\\\" builder.append
        elif '"' byte == then
            "\\\"" builder.append
        elif '\n' byte == then
            "\\n" builder.append
        elif '\t' byte == then
            "\\t" builder.append
        elif '\0' byte == then
            "\\000" builder.append
        elif '\r' byte == then
            "\\r" builder.append
        elif
            32 byte.codepoint i64::from >
            127 byte.codepoint i64::from <= ||
        then
            '\\' builder.push
            byte.codepoint 64 / make_octal_digit builder.push
            byte.codepoint 8 / 8 % make_octal_digit builder.push
            byte.codepoint 8 % make_octal_digit builder.push
        else
            byte builder.push
        fi
    done
    builder
}

impl Emitter {
    fn emit_entry_location self:mut$Emitter locations:$std::List[common::Location] {
        std::Option[common::Location]::None = self.last_location
        if locations.is_empty then
            common::empty_location self.emit_location
        else
            0 locations.get self.emit_location
        fi
    }

    fn source_file_index self:mut$Emitter path:$str -> u64 {
        if path self.source_files.get_copy_str std::Option::Some(index) is then
            index return
        fi
        self.source_files.length 1 + = index
        index path self.source_files.set_str
        path escape_string = escaped
        f".file {index} \"{escaped}\"" self.line_string
        index
    }

    fn emit_location self:mut$Emitter location:$common::Location {
        if self.last_location std::Option::Some(previous) is then
            if location previous.matches then
                return
            fi
        fi
        location.clone std::Option::Some = self.last_location
        if self.asm.length self.record_end == then
            # No output followed the previous record, so it describes no address.
            self.record_start self.asm.truncate
        fi
        location.file.as_str = path
        if
            path self
                .sources
                .line_starts
                .get_str std::Option::Some(starts) is
        then
            location.span.offset = offset
            { offset > } starts.bisect = line
            offset line 1 - starts.get copy - 1 + = column
            path self.source_file_index = file_index
            f".loc {file_index} {line} {column}"
        else
            # GAS drops line-zero records. A synthetic file prevents generated
            # helpers and runtime from inheriting a user's source line.
            "<casa-generated>" self.source_file_index = file_index
            f".loc {file_index} 1 0"
        fi = record
        self.asm.length = self.record_start
        record self.line_string
        self.asm.length = self.record_end
    }
}

# Escape the complete semantic identity, including bindings, without collisions.
# ASCII letters, digits, and underscores stay readable. Periods delimit decimal
# code points.
fn encode_specialization_name name:$str -> std::String {
    ".specialized_".to_str = label
    for character in name.iter do
        if character.codepoint 128 < character.is_alpha character.is_digit || '_' character == || && then
            character label.push
        else
            f".{character.codepoint}." label.append_string
        fi
    done
    label
}
