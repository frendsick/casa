# Plans structured checked bodies and selects one physical function at a time.
import "std" as std
import "abi" as abi
import "common" as common
import "semantic_body" as semantic_body
import "error" as error
import "typechecker" as typechecker
import "runtime" as runtime
import "local_storage" as local_storage

pub struct BytecodeFailure {
    pub message: std::String
}

impl BytecodeFailure {
    fn new message:std::String -> BytecodeFailure { message BytecodeFailure }
}

pub enum AssemblyError {
    Rejected(error::Diagnostics)
    Internal(BytecodeFailure)
}

const ENUM_DISPATCH_MIN_ARMS 4
const SHORT_COPY_LIMIT 64
const LOCAL_AGGREGATE_BYTES: u64 4096

enum StorageKind derives std::Copy {
    Heap
    Local
}

struct LocalAggregates {
    constructions: std::Map[i64 u64]
    owners:        std::Set[std::String]
    drops:         std::Set[i64]
}

impl LocalAggregates {
    fn new -> LocalAggregates {
        std::Set[i64]::new std::Set[std::String]::new std::Map[i64 u64]::new LocalAggregates
    }
}

enum FunctionWork {
    Checked(std::String)
    Destruction(std::String common::Type StorageKind)
    ClosureDestruction(std::String std::String)
}

struct BackendPlanner {
    store:         $common::SymbolStore
    checked:       $typechecker::CheckedProgram
    program:       Emitter
    pending:       std::List[FunctionWork]
    failure:       std::Option[BytecodeFailure]
    label_counter: u64
    layouts:       common::LayoutPlanner
}

struct EnumDispatch {
    labels:      std::List[u64]
    targets:     std::List[u64]
    fallback:    u64
    has_payload: bool
}

struct LoopTargets {
    start: u64
    exit:  u64
}

struct FunctionPlanner {
    loop_targets:     std::List[LoopTargets]
    function:         std::Option[$common::Function]
    local_slots:      std::Map[std::String u64]
    capture_slots:    std::Map[std::String u64]
    locals_count:     u64
    state:            mut$BackendPlanner
    owner_flags:      std::Map[std::String u64]
    result_slot:      std::Option[u64]
    local_aggregates: LocalAggregates
}

struct ResolvedStructField {
    storage: common::FieldStoragePlan
    typ:     common::Type
}

fn resolve_struct_field
    member:$common::StructMemberAccess
    store:$common::SymbolStore
    typ:$common::Type
    owner:$common::Type
    layouts:mut$common::LayoutPlanner
-> std::Option[ResolvedStructField] {
    if member.struct_name store.structs.get std::Option::Some(declaration) is then
        if store owner common::type_has_copy_layout then
            declaration owner common::copy_storage_struct
        else
            declaration.clone
        fi = casa_struct
        if member.member_index casa_struct.members.length < then
            if
                member.member_index casa_struct layouts.plan_struct_member
                std::Option::Some(storage) is
            then
                typ.clone storage.clone ResolvedStructField std::Option::Some return
            fi
        fi
    fi
    std::Option[ResolvedStructField]::None
}

impl BackendPlanner {
    fn new checked:$typechecker::CheckedProgram -> BackendPlanner {
        checked.get_store = store
        store common::LayoutPlanner::new
        0
        std::Option[BytecodeFailure]::None
        std::List[FunctionWork]::new
        Emitter::new
        checked
        store
        BackendPlanner
    }

    fn into_result self:BackendPlanner -> std::Result[std::String AssemblyError] {
        self match
            BackendPlanner { program: program failure: failure } => {
                failure match
                    std::Option::Some(problem) => problem AssemblyError::Internal std::Result::Error
                    std::Option::None => program.finish match
                        std::Result::Ok(assembly) => assembly std::Result::Ok
                        std::Result::Error(message) => message BytecodeFailure::new AssemblyError::Internal std::Result::Error
                    end
                end
            }
        end
    }
}

impl FunctionPlanner {
    fn new state:mut$BackendPlanner -> FunctionPlanner {
        state.layouts state.checked state.store.variables index_root_variable_map = locals_count = local_slots
        LocalAggregates::new
        std::Option[u64]::None
        std::Map[std::String u64]::new
        state
        locals_count
        std::Map[std::String u64]::new
        local_slots
        std::Option[$common::Function]::None
        std::List[LoopTargets]::new
        FunctionPlanner
    }

    fn for_function state:mut$BackendPlanner function:$common::Function -> FunctionPlanner {
        state.layouts state.checked function.variables index_local_variable_list = locals_count = local_slots
        LocalAggregates::new
        std::Option[u64]::None
        std::Map[std::String u64]::new
        state
        locals_count
        function.captures index_variable_list
        local_slots
        function std::Option::Some
        std::List[LoopTargets]::new
        FunctionPlanner
    }

    fn record_failure_string self:mut$FunctionPlanner message:std::String {
        if
            self
                .state
                .failure
                .is_none
        then
            message BytecodeFailure::new std::Option::Some = self.state.failure
        fi
    }

    fn record_failure self:mut$FunctionPlanner message:$str {
        message.to_str self.record_failure_string
    }

    fn has_failed self:mut$FunctionPlanner -> bool {
        self
            .state
            .failure
            .is_some
    }

    fn emit_field_load
        compiler:mut$FunctionPlanner
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[InstValue]
    {
        if plan.stores_inline then
            bytecode declared_type compiler.emit_typed_load
        else
            InstValue::Load64 bytecode.push
            if declared_type compiler.is_copy_aggregate then
                bytecode declared_type compiler.emit_inline_copy
            fi
        fi
    }

    fn emit_field_projection
        compiler:mut$FunctionPlanner
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[InstValue]
    {
        if plan.stores_inline ! then
            InstValue::Load64 bytecode.push
            return
        fi
        if
            compiler.state.store declared_type common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation != then
                bytecode declared_type compiler.emit_typed_load
            fi
        else
            f"Cannot determine field representation of `{declared_type.format}`" compiler.record_failure_string
        fi
    }

    fn emit_field_store
        compiler:mut$FunctionPlanner
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[InstValue]
    {
        if plan.stores_inline then
            bytecode declared_type compiler.emit_typed_store
        else
            if declared_type.has_unresolved_type_var ! then
                if declared_type compiler.is_copy_aggregate then
                    InstValue::Swap bytecode.push
                    bytecode declared_type compiler.emit_heap_copy
                    InstValue::Swap bytecode.push
                fi
            fi
            InstValue::Store64 bytecode.push
        fi
    }

    # Consume a field address. Inline C-compatible bodies have no resources to
    # destroy and their storage belongs to the containing allocation.
    fn compile_field_destruction
        compiler:mut$FunctionPlanner
        typ:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[InstValue]
    {
        if typ compiler.is_copy_aggregate then
            if plan.stores_inline then
                InstValue::Drop bytecode.push
            else
                InstValue::Load64 bytecode.push
                InstValue::HeapFree bytecode.push
            fi
            return
        fi
        if plan.stores_inline compiler.state.store typ common::type_has_trivial_c_field_layout && then
            InstValue::Drop bytecode.push
            return
        fi
        bytecode plan typ compiler.emit_field_load
        bytecode typ compiler.compile_destruction
    }

    fn get_struct_field_plan
        compiler:mut$FunctionPlanner
        casa_struct:$common::CasaStruct
        member_index:u64
    -> common::FieldStoragePlan {
        if
            member_index casa_struct compiler
                .state
                .layouts
                .plan_struct_member
            std::Option::Some(plan) is
        then
            plan.clone return
        fi
        f"Cannot determine member {member_index} storage of struct `{casa_struct.name}`"
        compiler.record_failure_string
        false 0 1 0 common::FieldStoragePlan
    }

    fn get_enum_field_plan
        compiler:mut$FunctionPlanner
        casa_enum:$common::CasaEnum
        variant_name:$str
        payload_index:u64
    -> common::FieldStoragePlan {
        if
            payload_index variant_name casa_enum
            compiler
                .state
                .layouts
                .plan_enum_payload std::Option::Some(plan) is
        then
            plan.clone return
        fi
        f"Cannot determine payload {payload_index} storage of `{casa_enum.name}::{variant_name}`"
        compiler.record_failure_string
        false 0 1 0 common::FieldStoragePlan
    }
}

# Label management
impl BackendPlanner {
    fn new_label self:mut$BackendPlanner -> u64 {
        self.label_counter = value
        1 += self.label_counter
        value
    }
}

impl FunctionPlanner {
    fn new_label self:mut$FunctionPlanner -> u64 { self.state.new_label }
}

# String interning
impl FunctionPlanner {
    fn intern_string compiler:mut$FunctionPlanner value:$str -> u64 {
        value compiler
            .state
            .program
            .intern_string
    }
}

# Variable resolution
fn index_variable_list variables:$std::List[common::Variable] -> std::Map[std::String u64] {
    std::Map[std::String u64]::new = slots
    0 = index: u64
    for variable in variables.iter do
        if variable.name slots.has ! then
            index variable.name.clone slots.set
        fi
        1 += index
    done
    slots
}

fn uses_inline_local_storage typ:$common::Type checked:$typechecker::CheckedProgram -> bool {
    typ common::get_concrete_array_length.is_some typ checked.is_copy_aggregate ||
}

fn local_variable_slot_width
    variable:$common::Variable
    checked:$typechecker::CheckedProgram
    layouts:mut$common::LayoutPlanner
-> u64 {
    if checked variable.typ uses_inline_local_storage then
        if variable.typ layouts.inline_size std::Option::Some(size) is then
            size common::WORD_SIZE u64::try_from.unwrap 1 - +
            common::WORD_SIZE u64::try_from.unwrap / return
        fi
    fi
    1
}

fn index_local_variable_list
    variables:$std::List[common::Variable]
    checked:$typechecker::CheckedProgram
    layouts:mut$common::LayoutPlanner
-> std::Map[std::String u64] u64 {
    std::Map[std::String u64]::new = slots
    0 = next_slot: u64
    for variable in variables.iter do
        if variable.name slots.has ! then
            layouts checked variable local_variable_slot_width = width
            next_slot width + 1 - variable.name.clone slots.set
            width += next_slot
        fi
    done
    slots next_slot
}

fn index_root_variable_map
    variables:$std::Map[std::String common::Variable]
    checked:$typechecker::CheckedProgram
    layouts:mut$common::LayoutPlanner
-> std::Map[std::String u64] u64 {
    std::Map[std::String u64]::new = slots
    variables.keys = names
    0 = next_slot: u64
    for name in names.iter do
        if name.as_str variables.get_str std::Option::Some(variable) is then
            layouts checked variable local_variable_slot_width = width
            next_slot width + 1 - name.clone slots.set
            width += next_slot
        fi
    done
    slots next_slot
}

impl FunctionPlanner {
    fn allocate_local compiler:mut$FunctionPlanner -> u64 {
        compiler.locals_count = local_index
        1 += compiler.locals_count
        local_index
    }

    fn resolve_local compiler:mut$FunctionPlanner variable_name:$str -> u64 {
        if variable_name compiler.local_slots.get_copy_str std::Option::Some(local_index) is then
            local_index return
        fi
        if compiler.function std::Option::Some(function) is then
            f"Variable `{variable_name}` is missing while compiling `{function.name}`"
            compiler.record_failure_string
        else
            f"Variable `{variable_name}` is missing during bytecode compilation"
            compiler.record_failure_string
        fi
        0
    }

    fn find_local_inline_aggregate_type
        self:mut$FunctionPlanner
        variable_name:$str
    -> std::Option[common::Type] {
        if self.function std::Option::Some(function) is then
            for variable in function.variables.iter do
                if variable.name.as_str variable_name == then
                    if self.state.checked variable.typ uses_inline_local_storage then
                        variable.typ.clone std::Option::Some return
                    fi
                fi
            done
        elif
            variable_name self
                .state
                .store
                .variables
                .get_str std::Option::Some(variable) is
        then
            if self.state.checked variable.typ uses_inline_local_storage then
                variable.typ.clone std::Option::Some return
            fi
        fi
        std::Option[common::Type]::None
    }

    fn emit_variable_get
        compiler:mut$FunctionPlanner
        variable_name:$str
        move_owned:bool
        bytecode:mut$std::List[InstValue]
    {
        variable_name compiler.resolve_local = local_index
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            local_index InstValue::LocalAddress bytecode.push
            if move_owned then
                bytecode aggregate_type compiler.emit_typed_load
            fi
            return
        fi
        local_index InstValue::LocalGet bytecode.push
    }

    fn emit_variable_set
        compiler:mut$FunctionPlanner
        variable_name:$str
        bytecode:mut$std::List[InstValue]
    {
        variable_name compiler.resolve_local = local_index
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            local_index InstValue::LocalAddress bytecode.push
            bytecode aggregate_type compiler.emit_typed_store
            return
        fi
        local_index InstValue::LocalSet bytecode.push
    }
}

# Deterministic destruction
impl FunctionPlanner {
    fn is_copy_aggregate self:$FunctionPlanner typ:$common::Type -> bool {
        typ self
            .state
            .checked
            .is_copy_aggregate
    }

    fn finish_destruction
        self:mut$FunctionPlanner
        storage_kind:StorageKind
        bytecode:mut$std::List[InstValue]
    {
        storage_kind match
            StorageKind::Heap => InstValue::HeapFree bytecode.push
            StorageKind::Local => InstValue::Drop bytecode.push
        end
    }

    fn prepare_local_aggregates self:mut$FunctionPlanner body:$semantic_body::Body {
        self.state.checked body local_storage::find_candidates = candidates
        0 = used_bytes: u64
        for candidate in candidates.iter do
            candidate.typ self
                .state
                .layouts
                .inline_size
                .unwrap = size
            common::WORD_SIZE u64::try_from.unwrap = word_size
            size word_size 1 - + word_size / word_size * = aligned
            if LOCAL_AGGREGATE_BYTES used_bytes aligned + < then
                continue
            fi
            size self.allocate_value_storage candidate.construction self
                .local_aggregates
                .constructions
                .set
            candidate.name.clone self
                .local_aggregates
                .owners
                .add
            for identity in candidate.drops.iter do
                identity copy self
                    .local_aggregates
                    .drops
                    .add
            done
            aligned += used_bytes
        done
    }

    fn compile_drop_hook
        compiler:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if
            typ compiler
                .state
                .checked
                .find_drop_function std::Option::Some(drop_name) is
        then
            drop_name.clone = function_name
            InstValue::Dup bytecode.push
            if function_name.as_str compiler.compile_named_function then
                function_name InstValue::FnCall bytecode.push
            fi
        fi
    }

    # Destroy every element of an `array[T N]` value. The array stores nothing
    # but its elements, so the element count comes from the type (ADR-0152).
    fn compile_array_destruction
        compiler:mut$FunctionPlanner
        element_type:$common::Type
        length:$common::ConstType
        bytecode:mut$std::List[InstValue]
    {
        compiler.allocate_local = array_local
        compiler.allocate_local = index_local
        array_local InstValue::LocalSet bytecode.push
        length.value InstValue::Push bytecode.push
        index_local InstValue::LocalSet bytecode.push

        compiler.new_label = start_label
        compiler.new_label = element_label
        compiler.new_label = end_label
        start_label InstValue::Label bytecode.push
        index_local InstValue::LocalGet bytecode.push
        0 InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        element_label InstValue::JumpNe bytecode.push
        end_label InstValue::Jump bytecode.push
        element_label InstValue::Label bytecode.push
        index_local InstValue::LocalGet bytecode.push
        1 InstValue::Push bytecode.push
        InstValue::Sub bytecode.push
        index_local InstValue::LocalSet bytecode.push
        array_local InstValue::LocalGet bytecode.push
        index_local InstValue::LocalGet bytecode.push
        bytecode element_type compiler.emit_inline_size
        InstValue::Mul bytecode.push
        InstValue::Add bytecode.push
        bytecode element_type compiler.emit_typed_load
        bytecode element_type compiler.compile_destruction
        start_label InstValue::Jump bytecode.push
        end_label InstValue::Label bytecode.push
        array_local InstValue::LocalGet bytecode.push
    }

    fn compile_struct_fields
        compiler:mut$FunctionPlanner
        typ:$common::Type
        casa_struct:$common::CasaStruct
        skipped:mut$std::List[std::String]
        bytecode:mut$std::List[InstValue]
        storage_kind:StorageKind
    {
        casa_struct.type_vars typ common::aggregate_type_bindings = substitutions
        casa_struct.members.length = member_index
        while 0 member_index != do
            1 -= member_index
            member_index casa_struct.members.get = member
            substitutions member.typ.substitute_t = member_type
            if
                member.name.as_str skipped common::string_list_contains member_type compiler.is_copy_aggregate ! &&
            then
                continue
            fi
            if
                member_type compiler
                    .state
                    .checked
                    .needs_destruction !
            then
                continue
            fi
            InstValue::Dup bytecode.push
            member_index casa_struct compiler.get_struct_field_plan = plan
            if 0 plan.offset != then
                plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::Add bytecode.push
            fi
            bytecode plan member_type compiler.compile_field_destruction
        done
        bytecode storage_kind compiler.finish_destruction
    }

    fn compile_enum_variant_fields
        compiler:mut$FunctionPlanner
        typ:$common::Type
        casa_enum:$common::CasaEnum
        variant_name:$str
        skipped_count:u64
        bytecode:mut$std::List[InstValue]
        storage_kind:StorageKind
    {
        casa_enum.type_vars typ common::aggregate_type_bindings = substitutions
        if variant_name casa_enum.variant_types.get_str std::Option::Some(payload_types) is then
            payload_types.length = payload_index
            while 0 payload_index != do
                1 -= payload_index
                substitutions payload_index payload_types.get.substitute_t = payload_type
                if skipped_count payload_index > payload_type compiler.is_copy_aggregate ! && then
                    continue
                fi
                if
                    payload_type compiler
                        .state
                        .checked
                        .needs_destruction !
                then
                    continue
                fi
                InstValue::Dup bytecode.push
                payload_index variant_name casa_enum compiler.get_enum_field_plan = plan
                plan.offset i64::try_from.unwrap
                InstValue::Push bytecode.push
                InstValue::Add bytecode.push
                bytecode plan payload_type compiler.compile_field_destruction
            done
        fi
        bytecode storage_kind compiler.finish_destruction
    }

    fn compile_enum_fields
        compiler:mut$FunctionPlanner
        typ:$common::Type
        casa_enum:$common::CasaEnum
        bytecode:mut$std::List[InstValue]
        storage_kind:StorageKind
    {
        compiler.allocate_local = enum_local
        enum_local InstValue::LocalSet bytecode.push
        compiler.new_label = end_label
        std::List[u64]::new = labels
        for _variant in casa_enum.variants.iter do
            compiler.new_label labels.push
        done
        enum_local InstValue::LocalGet bytecode.push
        InstValue::Load64 bytecode.push
        end_label labels.clone InstValue::JumpTable bytecode.push
        0 = variant_index: u64
        for variant_name in casa_enum.variants.iter do
            variant_index labels.get copy InstValue::Label bytecode.push
            enum_local InstValue::LocalGet bytecode.push
            storage_kind bytecode 0 variant_name.as_str casa_enum typ compiler.compile_enum_variant_fields
            end_label InstValue::Jump bytecode.push
            1 += variant_index
        done
        end_label InstValue::Label bytecode.push
    }

    fn compile_destruction_body
        compiler:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
        storage_kind:StorageKind
    {
        if
            typ compiler
                .state
                .checked
                .has_plain_storage
        then
            bytecode typ compiler.compile_drop_hook
            bytecode storage_kind compiler.finish_destruction
            return
        fi
        typ compiler
            .state
            .checked
            .get_shape = shape
        if shape typechecker::CheckedShape::Borrow is then
            InstValue::Drop bytecode.push return
        fi
        if shape typechecker::CheckedShape::Closure is then
            InstValue::ClosureDrop bytecode.push return
        fi
        if typ compiler.is_copy_aggregate then
            InstValue::Drop bytecode.push return
        fi
        bytecode typ compiler.compile_drop_hook
        shape match
            typechecker::CheckedShape::Array => {
                typ common::get_array_length_parameter.unwrap = length
                typ.array_element_type.unwrap = element_type
                bytecode length element_type compiler.compile_array_destruction
                bytecode storage_kind compiler.finish_destruction
            }
            typechecker::CheckedShape::Struct => {
                typ.match_base = name
                name compiler
                    .state
                    .store
                    .structs
                    .get
                    .unwrap = struct_declaration
                std::List[std::String]::new = skipped
                storage_kind bytecode skipped struct_declaration typ compiler.compile_struct_fields
            }
            typechecker::CheckedShape::Enum => {
                typ.match_base = name
                name compiler
                    .state
                    .store
                    .enums
                    .get
                    .unwrap = enum_declaration
                if enum_declaration common::has_inner_values then
                    storage_kind bytecode enum_declaration typ compiler.compile_enum_fields
                else
                    InstValue::Drop bytecode.push
                fi
            }
            _ => InstValue::Drop bytecode.push
        end
    }

    fn destruction_needs_function compiler:mut$FunctionPlanner typ:$common::Type -> bool {
        typ compiler
            .state
            .checked
            .needs_destruction
    }

    fn ensure_destruction_function
        compiler:mut$FunctionPlanner
        typ:$common::Type
        storage_kind:StorageKind
    -> std::String {
        typ.format = type_name
        # A separator outside source identifiers keeps local_Value's heap
        # destructor distinct from Value's local destructor.
        storage_kind match
            StorageKind::Heap => f"__drop_{type_name}"
            StorageKind::Local => f"__drop_local {type_name}"
        end = function_name
        if
            function_name compiler
                .state
                .program
                .functions
                .has
        then
            function_name return
        fi
        function_name.as_str compiler
            .state
            .program
            .register_function
        storage_kind typ.clone function_name.clone FunctionWork::Destruction compiler
            .state
            .pending
            .push
        function_name
    }

    fn compile_destruction
        self:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        StorageKind::Heap bytecode typ self.compile_destruction_in_storage
    }

    fn compile_destruction_in_storage
        compiler:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
        storage_kind:StorageKind
    {
        if typ compiler.destruction_needs_function ! then
            InstValue::Drop bytecode.push
            return
        fi
        if
            typ compiler
                .state
                .checked
                .has_plain_storage
        then
            bytecode typ compiler.compile_drop_hook
            bytecode storage_kind compiler.finish_destruction
            return
        fi
        storage_kind typ compiler.ensure_destruction_function = function_name
        function_name InstValue::FnCall bytecode.push
    }

    fn compile_enum_pattern_destruction
        compiler:mut$FunctionPlanner
        store:$common::SymbolStore
        variant:$common::EnumVariant
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if typ compiler.is_copy_aggregate then
            InstValue::Drop bytecode.push return
        fi
        if typ compiler.destruction_needs_function ! then
            InstValue::Drop bytecode.push
            return
        fi
        bytecode typ compiler.compile_drop_hook
        if typ.clone common::Type::Generic(generic) is then
            if generic.base store.enums.get std::Option::Some(owned_enum) is then
                if owned_enum common::has_inner_values then
                    variant.bindings.length = skipped_count
                    StorageKind::Heap bytecode skipped_count variant.variant_name.as_str owned_enum typ
                    compiler.compile_enum_variant_fields
                    return
                fi
            fi
        fi
        InstValue::Drop bytecode.push
    }

    fn compile_match_destruction
        compiler:mut$FunctionPlanner
        store:$common::SymbolStore
        pattern_value:$common::PatternValue
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if typ compiler.is_copy_aggregate then
            InstValue::Drop bytecode.push return
        fi
        if pattern_value common::PatternValue::EnumVariant(variant) is then
            if pattern_value is_wildcard ! then
                bytecode typ variant store compiler.compile_enum_pattern_destruction
                return
            fi
        fi
        if typ compiler.destruction_needs_function ! then
            InstValue::Drop bytecode.push
            return
        fi
        bytecode typ compiler.compile_drop_hook
        if typ.clone common::Type::Generic(generic) is then
            if generic.base store.structs.get std::Option::Some(owned_struct) is then
                std::List[std::String]::new = skipped
                if pattern_value common::PatternValue::Struct(struct_pattern) is then
                    struct_pattern.bindings.keys = skipped
                fi
                StorageKind::Heap bytecode skipped owned_struct typ compiler.compile_struct_fields
                return
            fi
            if generic.base store.enums.get std::Option::Some(owned_enum) is then
                if owned_enum common::has_inner_values ! then
                    InstValue::Drop bytecode.push return
                fi
                if pattern_value common::PatternValue::EnumVariant(variant) is then
                    StorageKind::Heap bytecode owned_enum typ compiler.compile_enum_fields
                    return
                fi
            fi
        fi
        InstValue::Drop bytecode.push
    }

    fn owner_flag compiler:mut$FunctionPlanner name:$str -> u64 {
        if name compiler.owner_flags.get_copy_str std::Option::Some(flag) is then
            flag return
        fi
        compiler.allocate_local = flag
        flag name.clone compiler.owner_flags.set_str
        flag
    }

    fn set_owner_flag
        compiler:mut$FunctionPlanner
        name:$str
        value:u64
        bytecode:mut$std::List[InstValue]
    {
        name compiler.owner_flag = flag
        value i64::try_from.unwrap InstValue::Push bytecode.push
        flag InstValue::LocalSet bytecode.push
    }

    fn compile_variable_destruction
        compiler:mut$FunctionPlanner
        variable_name:$str
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            variable_name compiler.resolve_local = local_index
            local_index InstValue::LocalAddress bytecode.push
            bytecode aggregate_type compiler.compile_drop_hook
            if aggregate_type common::get_array_length_parameter std::Option::Some(array_length) is then
                if aggregate_type.array_element_type std::Option::Some(element_type) is then
                    bytecode array_length element_type compiler.compile_array_destruction
                    InstValue::Drop bytecode.push
                    return
                fi
            fi
            InstValue::Drop bytecode.push
            return
        fi
        variable_name compiler.resolve_local InstValue::LocalGet bytecode.push
        if
            variable_name compiler
                .local_aggregates
                .owners
                .has_str
        then
            StorageKind::Local bytecode typ compiler.compile_destruction_in_storage
        else
            bytecode typ compiler.compile_destruction
        fi
    }

    fn compile_active_owner_cleanup
        compiler:mut$FunctionPlanner
        event:$common::OwnerEvent
        bytecode:mut$std::List[InstValue]
    {
        event.storage_name.as_str compiler.owner_flag = flag
        compiler.new_label = cleanup_label
        compiler.new_label = end_label
        flag InstValue::LocalGet bytecode.push
        0 InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        cleanup_label InstValue::JumpNe bytecode.push
        end_label InstValue::Jump bytecode.push
        cleanup_label InstValue::Label bytecode.push
        bytecode event.typ event.storage_name.as_str compiler.compile_variable_destruction
        bytecode 0 event.storage_name.as_str compiler.set_owner_flag
        end_label InstValue::Label bytecode.push
    }

    fn compile_owner_cleanup
        compiler:mut$FunctionPlanner
        event:$common::OwnerEvent
        bytecode:mut$std::List[InstValue]
    {
        event.storage_name.as_str compiler.owner_flag = flag
        compiler.new_label = end_label
        flag InstValue::LocalGet bytecode.push
        event.generation i64::try_from.unwrap InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        end_label InstValue::JumpNe bytecode.push
        bytecode event.typ event.storage_name.as_str compiler.compile_variable_destruction
        bytecode 0 event.storage_name.as_str compiler.set_owner_flag
        end_label InstValue::Label bytecode.push
    }
}

# Control-flow targets
impl semantic_body::PrimitiveKind {
    fn produces_integer_result self:$semantic_body::PrimitiveKind -> bool {
        self match
            semantic_body::PrimitiveKind::Add => true
            semantic_body::PrimitiveKind::Sub => true
            semantic_body::PrimitiveKind::Mul => true
            semantic_body::PrimitiveKind::Div => true
            semantic_body::PrimitiveKind::Mod => true
            semantic_body::PrimitiveKind::Shl => true
            semantic_body::PrimitiveKind::Shr => true
            semantic_body::PrimitiveKind::BitAnd => true
            semantic_body::PrimitiveKind::BitOr => true
            semantic_body::PrimitiveKind::BitXor => true
            semantic_body::PrimitiveKind::BitNot => true
            semantic_body::PrimitiveKind::WrappingAdd => true
            semantic_body::PrimitiveKind::WrappingSub => true
            semantic_body::PrimitiveKind::WrappingMul => true
            _ => false
        end
    }

    fn select_typed_instruction
        self:$semantic_body::PrimitiveKind
        direct:InstValue
        builtin:$common::BuiltinType
    -> InstValue {
        if builtin.is_float then
            if builtin common::BuiltinType::F32 swap == then
                self match
                    semantic_body::PrimitiveKind::Add => InstValue::FloatAdd32
                    semantic_body::PrimitiveKind::Sub => InstValue::FloatSub32
                    semantic_body::PrimitiveKind::Mul => InstValue::FloatMul32
                    semantic_body::PrimitiveKind::Div => InstValue::FloatDiv32
                    semantic_body::PrimitiveKind::Eq => InstValue::FloatEq32
                    semantic_body::PrimitiveKind::Ne => InstValue::FloatNe32
                    semantic_body::PrimitiveKind::Lt => InstValue::FloatLt32
                    semantic_body::PrimitiveKind::Le => InstValue::FloatLe32
                    semantic_body::PrimitiveKind::Gt => InstValue::FloatGt32
                    semantic_body::PrimitiveKind::Ge => InstValue::FloatGe32
                    _ => direct
                end
            else
                self match
                    semantic_body::PrimitiveKind::Add => InstValue::FloatAdd64
                    semantic_body::PrimitiveKind::Sub => InstValue::FloatSub64
                    semantic_body::PrimitiveKind::Mul => InstValue::FloatMul64
                    semantic_body::PrimitiveKind::Div => InstValue::FloatDiv64
                    semantic_body::PrimitiveKind::Eq => InstValue::FloatEq64
                    semantic_body::PrimitiveKind::Ne => InstValue::FloatNe64
                    semantic_body::PrimitiveKind::Lt => InstValue::FloatLt64
                    semantic_body::PrimitiveKind::Le => InstValue::FloatLe64
                    semantic_body::PrimitiveKind::Gt => InstValue::FloatGt64
                    semantic_body::PrimitiveKind::Ge => InstValue::FloatGe64
                    _ => direct
                end
            fi
            return
        fi
        self match
            semantic_body::PrimitiveKind::Add => {
                builtin copy InstValue::CheckedAdd return
            }
            semantic_body::PrimitiveKind::Sub => {
                builtin copy InstValue::CheckedSub return
            }
            semantic_body::PrimitiveKind::Mul => {
                builtin copy InstValue::CheckedMul return
            }
            semantic_body::PrimitiveKind::Div => {
                builtin copy InstValue::CheckedDiv return
            }
            semantic_body::PrimitiveKind::Mod => {
                builtin copy InstValue::CheckedMod return
            }
            semantic_body::PrimitiveKind::Shl => {
                builtin copy InstValue::CheckedShl return
            }
            semantic_body::PrimitiveKind::Shr => {
                builtin copy InstValue::CheckedShr return
            }
            _ => {
            }
        end
        if builtin.is_unsigned ! then
            direct return
        fi
        self match
            semantic_body::PrimitiveKind::Div => InstValue::UDiv
            semantic_body::PrimitiveKind::Mod => InstValue::UMod
            semantic_body::PrimitiveKind::Shr => InstValue::UShr
            semantic_body::PrimitiveKind::Lt => InstValue::Ult
            semantic_body::PrimitiveKind::Le => InstValue::Ule
            semantic_body::PrimitiveKind::Gt => InstValue::Ugt
            semantic_body::PrimitiveKind::Ge => InstValue::Uge
            semantic_body::PrimitiveKind::PrintInt => InstValue::PrintUint
            _ => direct
        end
    }
}

impl FunctionPlanner {
    fn emit_integer_normalization
        self:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if typ common::Type::Builtin(builtin) is then
            if builtin.is_integer then
                builtin InstValue::NormalizeInt bytecode.push
            fi
        fi
    }

    fn compile_assignment
        compiler:mut$FunctionPlanner
        kind:$semantic_body::BindingKind
        binding:$common::BindingReference
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        binding.storage_name = name: $std::String
        if name compiler.capture_slots.get_copy std::Option::Some(capture_index) is then
            false = owns_capture
            common::make_unknown_type.clone = capture_type
            if compiler.function std::Option::Some(function) is then
                name.as_str function.owned_captures common::string_list_contains = owns_capture
                capture_index function.captures.get common::Variable::typ.clone = capture_type
            fi
            if kind semantic_body::BindingKind::AssignVar is then
                if owns_capture then
                    compiler.new_label = inactive_label
                    capture_index InstValue::CaptureFlagLoad bytecode.push
                    0 InstValue::Push bytecode.push
                    InstValue::Ne bytecode.push
                    inactive_label InstValue::JumpNe bytecode.push
                    capture_index InstValue::CaptureLoad bytecode.push
                    if capture_type compiler.is_copy_aggregate then
                        InstValue::HeapFree bytecode.push
                    else
                        bytecode capture_type compiler.compile_destruction
                    fi
                    inactive_label InstValue::Label bytecode.push
                fi
                if owns_capture capture_type compiler.is_copy_aggregate && then
                    bytecode capture_type compiler.emit_heap_copy
                fi
                capture_index InstValue::CaptureSet bytecode.push
                if owns_capture then
                    capture_index InstValue::CaptureFlagMark bytecode.push
                fi
                return
            fi
            capture_index InstValue::CaptureLoad bytecode.push
            if kind semantic_body::BindingKind::AssignDec is then
                InstValue::Swap bytecode.push
                InstValue::Sub bytecode.push
            elif kind semantic_body::BindingKind::AssignInc is then
                InstValue::Add bytecode.push
            else
                "compile_assignment received an unsupported capture assignment" compiler.record_failure
                return
            fi
            bytecode typ compiler.emit_integer_normalization
            capture_index InstValue::CaptureSet bytecode.push
            return
        fi
        name.as_str compiler.resolve_local = local_index

        kind match
            semantic_body::BindingKind::AssignDec => {
                local_index InstValue::LocalGet bytecode.push
                InstValue::Swap bytecode.push
                InstValue::Sub = instruction
                if typ common::Type::Builtin(builtin) is then
                    builtin InstValue::CheckedSub = instruction
                fi
                instruction bytecode.push
                bytecode typ compiler.emit_integer_normalization
                local_index InstValue::LocalSet bytecode.push
            }
            semantic_body::BindingKind::AssignInc => {
                local_index InstValue::LocalGet bytecode.push
                InstValue::Add = instruction
                if typ common::Type::Builtin(builtin) is then
                    builtin InstValue::CheckedAdd = instruction
                fi
                instruction bytecode.push
                bytecode typ compiler.emit_integer_normalization
                local_index InstValue::LocalSet bytecode.push
            }
            semantic_body::BindingKind::AssignVar => bytecode name.as_str compiler.emit_variable_set
            semantic_body::BindingKind::Question => bytecode name.as_str compiler.emit_variable_set
            _ => {
                "compile_assignment received a non-assignment operation" compiler.record_failure
            }
        end
    }
}

# Compile if block
impl FunctionPlanner {
    fn emit_struct_arm
        compiler:mut$FunctionPlanner
        store:$common::SymbolStore
        struct_pattern:$common::StructPattern
        subject_type:$common::Type
        facts:$semantic_body::OperationFacts
        bytecode:mut$std::List[InstValue]
    {
        struct_pattern common::StructPattern::struct_name store.structs.get = casa_struct_opt
        if casa_struct_opt.is_none then
            f"Struct `{struct_pattern.struct_name}` is missing during bytecode compilation" compiler.record_failure_string
            return
        fi
        casa_struct_opt.unwrap = declaration
        subject_type.clone = owner
        if subject_type.borrow_target std::Option::Some(target) is then
            target.clone = owner
        fi
        if owner compiler.is_copy_aggregate then
            declaration owner common::copy_storage_struct
        else
            declaration.clone
        fi = casa_struct
        casa_struct.type_vars owner common::aggregate_type_bindings = substitutions
        0 = index: u64
        while index casa_struct common::CasaStruct::members.length < do
            index casa_struct common::CasaStruct::members.get = member
            member common::Member::name.as_str = field_name: $str
            index casa_struct compiler.get_struct_field_plan = plan
            if
                field_name struct_pattern common::StructPattern::bindings.get_str std::Option::Some(var_name) is
            then
                InstValue::Dup bytecode.push
                if 0 plan.offset < then
                    plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                    InstValue::Add bytecode.push
                fi
                substitutions member.typ.substitute_t = member_type
                if subject_type.is_borrow then
                    bytecode plan member_type compiler.emit_field_projection
                else
                    bytecode plan member_type compiler.emit_field_load
                fi
                var_name.as_str facts.resolve_storage_name = storage_name
                bytecode storage_name.as_str compiler.emit_variable_set
            fi
            1 += index
        done
    }
}

fn emit_int_eq value:$i64 bytecode:mut$std::List[InstValue] {
    value copy InstValue::Push bytecode.push
    InstValue::Eq bytecode.push
}

fn require_variant_ordinal variant:$common::EnumVariant compiler:mut$FunctionPlanner -> i64 {
    if variant.ordinal std::Option::Some(ordinal) is then
        ordinal return
    fi
    f"Enum variant `{variant.variant_name}` has no ordinal during bytecode compilation" compiler.record_failure_string
    0
}

impl FunctionPlanner {
    fn emit_literal_arm
        compiler:mut$FunctionPlanner
        literal_pattern:$common::LiteralPattern
        is_last:bool
        next_arm:mut$std::Option[u64]
        bytecode:mut$std::List[InstValue]
    {
        if is_last then
            return
        fi
        InstValue::Dup bytecode.push
        literal_pattern.value match
            common::LiteralValue::Str(str_value) => {
                str_value.as_str compiler.intern_string = str_index
                str_index InstValue::PushStr bytecode.push
                InstValue::StrEq bytecode.push
            }
            common::LiteralValue::Int(int_value) => {
                bytecode int_value.value emit_int_eq
            }
            common::LiteralValue::Char(char_value) => {
                bytecode char_value emit_int_eq
            }
            common::LiteralValue::Bool(bool_value) => {
                bytecode if bool_value then 1 else 0 fi emit_int_eq
            }
        end
        if next_arm std::Option::Some(label) is then
            label InstValue::JumpNe bytecode.push
        else
            "Match arm has no following label during bytecode compilation" compiler.record_failure
        fi
    }
}

impl FunctionPlanner {
    fn emit_enum_arm
        compiler:mut$FunctionPlanner
        variant:$common::EnumVariant
        is_wildcard:bool
        is_last:bool
        next_arm:mut$std::Option[u64]
        facts:$semantic_body::OperationFacts
        subject_type:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if is_wildcard then
            return
        fi
        variant.enum_name.as_str = enum_name: $str
        if
            "" enum_name.as_str != enum_name compiler
                .state
                .store
                .enums
                .has_str &&
        then
            enum_name compiler
                .state
                .store
                .enums
                .get_str
                .unwrap common::has_inner_values = has_payload
            if has_payload then
                if is_last ! then
                    InstValue::Dup bytecode.push
                    InstValue::Load64 bytecode.push
                    compiler variant require_variant_ordinal InstValue::Push bytecode.push
                    InstValue::Eq bytecode.push
                    if next_arm std::Option::Some(label) is then
                        label InstValue::JumpNe bytecode.push
                    else
                        "Match arm has no following label during bytecode compilation" compiler.record_failure
                    fi
                fi
                enum_name compiler
                    .state
                    .store
                    .enums
                    .get_str
                    .unwrap = declaration
                subject_type.clone = owner
                if subject_type.borrow_target std::Option::Some(target) is then
                    target.clone = owner
                fi
                if owner compiler.is_copy_aggregate then
                    declaration owner common::copy_storage_enum
                else
                    declaration.clone
                fi = casa_enum
                owner facts casa_enum variant bytecode compiler.emit_enum_arm_bindings
                return
            fi
        fi

        if is_last then
            return
        fi
        InstValue::Dup bytecode.push
        compiler variant require_variant_ordinal InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        if next_arm std::Option::Some(label) is then
            label InstValue::JumpNe bytecode.push
        else
            "Match arm has no following label during bytecode compilation" compiler.record_failure
        fi
    }
}

impl FunctionPlanner {
    fn emit_enum_arm_bindings
        compiler:mut$FunctionPlanner
        bytecode:mut$std::List[InstValue]
        variant:$common::EnumVariant
        casa_enum:$common::CasaEnum
        facts:$semantic_body::OperationFacts
        owner:$common::Type
    {
        casa_enum.type_vars owner common::aggregate_type_bindings = substitutions
        variant.variant_name casa_enum
            .variant_types
            .get
            .unwrap = payload_types
        0 = index: u64
        while index variant common::EnumVariant::bindings.length < do
            index variant.variant_name.as_str casa_enum compiler.get_enum_field_plan = plan
            InstValue::Dup bytecode.push
            plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            substitutions index payload_types.get.substitute_t = payload_type
            bytecode plan payload_type compiler.emit_field_load
            index variant common::EnumVariant::bindings.get = var_name
            var_name.as_str facts.resolve_storage_name = storage_name
            bytecode storage_name.as_str compiler.emit_variable_set
            1 += index
        done
    }
}

impl FunctionPlanner {
    fn compile_struct_new
        compiler:mut$FunctionPlanner
        casa_struct:$common::CasaStruct
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
        local_slot:std::Option[u64]
    {
        if casa_struct.type_vars.is_empty ! typ compiler.is_copy_aggregate && then
            casa_struct typ common::copy_storage_struct = concrete
            local_slot bytecode typ concrete compiler.compile_struct_new
            return
        fi
        casa_struct.type_vars typ common::aggregate_type_bindings = substitutions
        casa_struct common::CasaStruct::members.length = count
        local_slot bytecode typ compiler.emit_value_storage
        0 = index: u64
        while index count < do
            InstValue::Swap bytecode.push
            InstValue::Over bytecode.push
            index casa_struct compiler.get_struct_field_plan = plan
            if 0 plan.offset < then
                plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::Add bytecode.push
            fi
            index casa_struct.members.get = member
            substitutions member.typ.substitute_t = member_type
            bytecode plan member_type compiler.emit_field_store
            1 += index
        done
    }
}

# Compile enum variant
impl FunctionPlanner {
    fn compile_enum_variant
        compiler:mut$FunctionPlanner
        variant:$common::EnumVariant
        casa_enum:$common::CasaEnum
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
        local_slot:std::Option[u64]
    {
        if casa_enum.type_vars.is_empty ! typ compiler.is_copy_aggregate && then
            casa_enum typ common::copy_storage_enum = concrete
            local_slot bytecode typ concrete variant compiler.compile_enum_variant
            return
        fi
        casa_enum.type_vars typ common::aggregate_type_bindings = substitutions
        local_slot bytecode typ compiler.emit_value_storage
        InstValue::Dup bytecode.push
        compiler variant require_variant_ordinal InstValue::Push bytecode.push
        InstValue::Swap bytecode.push
        InstValue::Store64 bytecode.push
        if variant.variant_name casa_enum.variant_types.get std::Option::Some(types) is then
            0 = index: u64
            for payload_type in types.iter do
                InstValue::Swap bytecode.push
                InstValue::Over bytecode.push
                index variant.variant_name.as_str casa_enum compiler.get_enum_field_plan = plan
                plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::Add bytecode.push
                substitutions payload_type.substitute_t = concrete_type
                bytecode plan concrete_type compiler.emit_field_store
                1 += index
            done
        fi
    }
}

# Compile is check
impl FunctionPlanner {
    fn compile_is_check
        compiler:mut$FunctionPlanner
        store:$common::SymbolStore
        variant:$common::EnumVariant
        subject_type:$common::Type
        op:$semantic_body::OperationFacts
        bytecode:mut$std::List[InstValue]
    {
        variant.enum_name.clone = enum_name
        enum_name store.enums.get = casa_enum_opt
        if casa_enum_opt.is_none then
            f"Enum `{enum_name}` is missing during bytecode compilation" compiler.record_failure_string
            return
        fi
        casa_enum_opt.unwrap = declaration
        subject_type.clone = owner
        if subject_type.borrow_target std::Option::Some(target) is then
            target.clone = owner
        fi
        if owner compiler.is_copy_aggregate then
            declaration owner common::copy_storage_enum
        else
            declaration.clone
        fi = casa_enum

        if casa_enum common::has_inner_values ! then
            # Plain enum: compare ordinal directly
            compiler variant require_variant_ordinal InstValue::Push bytecode.push
            InstValue::Eq bytecode.push
            return
        fi

        if 0 variant common::EnumVariant::bindings.length == then
            # Data-carrying enum, no bindings: load ordinal and compare
            InstValue::Load64 bytecode.push
            compiler variant require_variant_ordinal InstValue::Push bytecode.push
            InstValue::Eq bytecode.push
            return
        fi

        # Data-carrying enum with bindings
        compiler.allocate_local = temp_ptr

        compiler.new_label = skip_bindings

        # Save enum pointer
        temp_ptr InstValue::LocalSet bytecode.push

        # Load ordinal and compare
        temp_ptr InstValue::LocalGet bytecode.push
        InstValue::Load64 bytecode.push
        compiler variant require_variant_ordinal InstValue::Push bytecode.push
        InstValue::Eq bytecode.push

        # Duplicate bool
        InstValue::Dup bytecode.push
        skip_bindings InstValue::JumpNe bytecode.push

        # Extract bindings
        variant.variant_name casa_enum
            .variant_types
            .get
            .unwrap = payload_types
        casa_enum.type_vars owner common::aggregate_type_bindings = substitutions
        0 = index: u64
        while index variant common::EnumVariant::bindings.length < do
            index variant.variant_name.as_str casa_enum compiler.get_enum_field_plan = plan
            temp_ptr InstValue::LocalGet bytecode.push
            plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            substitutions index payload_types.get.substitute_t = payload_type
            bytecode plan payload_type compiler.emit_field_load
            index variant common::EnumVariant::bindings.get = var_name
            var_name.as_str op.resolve_storage_name = storage_name
            bytecode storage_name.as_str compiler.emit_variable_set
            1 += index
        done

        if op.effects std::Option::Some(ownership) is then
            for event in ownership.assignments.iter do
                bytecode event.generation event.storage_name.as_str compiler.set_owner_flag
            done
            if ownership.conditional_move std::Option::Some(subject_name) is then
                temp_ptr InstValue::LocalGet bytecode.push
                bytecode subject_type variant store compiler.compile_enum_pattern_destruction
                subject_name.as_str op.resolve_storage_name = subject_storage
                bytecode 0 subject_storage.as_str compiler.set_owner_flag
            fi
        fi

        skip_bindings InstValue::Label bytecode.push
    }
}

# Compile struct literal
impl FunctionPlanner {
    fn compile_struct_literal
        compiler:mut$FunctionPlanner
        store:$common::SymbolStore
        literal:$common::StructLiteral
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
        local_slot:std::Option[u64]
    {
        literal.struct_name store.structs.get = casa_struct_opt
        if casa_struct_opt.is_none then
            f"Struct `{literal.struct_name}` is missing during bytecode compilation" compiler.record_failure_string
            return
        fi
        casa_struct_opt.unwrap = declaration
        if typ compiler.is_copy_aggregate then
            declaration typ common::copy_storage_struct
        else
            declaration.clone
        fi = casa_struct
        casa_struct.type_vars typ common::aggregate_type_bindings = substitutions
        casa_struct common::CasaStruct::members.length = count

        # Store all field values into temp locals (top of stack = last in field_order)
        # Iterate field_order in reverse
        literal common::StructLiteral::field_order.length = field_index
        std::Map[std::String u64]::new = temp_locals
        while 0 field_index != do
            1 -= field_index
            compiler.allocate_local = local_index
            field_index literal common::StructLiteral::field_order.get = field_name
            local_index field_name.clone temp_locals.set
            local_index InstValue::LocalSet bytecode.push
