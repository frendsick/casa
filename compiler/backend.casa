    fn emit_float_round self:mut$Emitter kind:RoundingKind target:common::BuiltinType {
        self.emit_uid = label_id
        f".Lfloat_round_result_{label_id}" = result_label
        f".Lfloat_round_store_{label_id}" = store_label
        f".Lfloat_round_done_{label_id}" = done_label
        0 self.stack_operand = top

        # Values at or above the significand limit are already integral. This
        # also preserves infinities and NaNs without requiring SSE4.1.
        if target common::BuiltinType::F32 == then
            f"movss {top}, %xmm0" self.indent_string
            "movd %xmm0, %eax" self.indent
            "movl %eax, %ecx" self.indent
            f"andl ${F32_ABSOLUTE_MASK}, %ecx" self.indent_string
            f"cmpl ${F32_INTEGRAL_THRESHOLD_BITS}, %ecx" self.indent_string
            f"jae {done_label}" self.indent_string
            "cvttss2siq %xmm0, %rax" self.indent
            "cvtsi2ssq %rax, %xmm1" self.indent
        else
            f"movsd {top}, %xmm0" self.indent_string
            "movq %xmm0, %rax" self.indent
            "movq %rax, %rcx" self.indent
            f"btrq ${F64_SIGN_BIT_INDEX}, %rcx" self.indent_string
            f"movabsq ${F64_INTEGRAL_THRESHOLD_BITS}, %rdx" self.indent_string
            "cmpq %rdx, %rcx" self.indent
            f"jae {done_label}" self.indent_string
            "cvttsd2siq %xmm0, %rax" self.indent
            "cvtsi2sdq %rax, %xmm1" self.indent
