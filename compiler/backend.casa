    HeapAlloc
    HeapFree
    Load8
    Load16
    Load32
    Load64
    ReadIndirect(u64)
    Store8
    Store16
    Store32
    Store64
    WriteIndirect(u64)
    MoveBytes(u64)
    # Arithmetic
    Add
    CheckedAdd(common::BuiltinType)
    CheckedDiv(common::BuiltinType)
    CheckedMod(common::BuiltinType)
    CheckedMul(common::BuiltinType)
    CheckedShl(common::BuiltinType)
    CheckedShr(common::BuiltinType)
    CheckedSub(common::BuiltinType)
    Div
    FloatAdd32
    FloatAdd64
    FloatDiv32
    FloatDiv64
    FloatEq32
    FloatEq64
    FloatGe32
    FloatGe64
    FloatGt32
    FloatGt64
    FloatLe32
    FloatLe64
    FloatLt32
    FloatLt64
    FloatMul32
    FloatMul64
    FloatNe32
    FloatNe64
    FloatSub32
    FloatSub64
    FloatRound(RoundingKind common::BuiltinType)
    FloatFromDecimal
    FloatSignificand
    Mod
    Mul
    Sub
    # Bitshift
    Shl
    Shr
    # Bitwise
    BitAnd
    BitOr
    BitXor
    BitNot
    # Boolean
    And
    Or
    Not
    # Comparison
    Eq
    Ge
    Gt
    Le
    Lt
    Ne
    Ult
    Ule
    Ugt
    Uge
    UDiv
    UMod
    UShr
    NormalizeInt(common::BuiltinType)
    NumericConvert(common::NumericConversion)
    NumericTry(common::BuiltinType common::BuiltinType)
    IntegerTry(common::IntegerTry)
    # Functions
    FnCall(std::String)
    ExternCall(std::String)
    FnExec(std::Option[RegisterCallPlan])
    FnPush(std::String)
    FnReturn
    DropFn(std::String)
    # Jumps
    Label(u64)
    # Internal loops with a changing stack height require a memory boundary.
    MemoryLabel(u64)
    Jump(u64)
    JumpNe(u64)
    JumpTable(std::List[u64] u64)
    # Locals
    LocalsInit(u64)
    LocalsUninit(u64)
    LocalAddress(u64)
    LocalGet(u64)
    LocalSet(u64)
    # Constants
    ConstantLoad(u64)
    ConstantStore(u64)
    # Closures
    CaptureFlagClear(u64)
    CaptureFlagLoad(u64)
    CaptureFlagMark(u64)
    CaptureLoad(u64)
    CaptureAddress(u64)
    CaptureSet(u64)
    ClosureDrop
    ClosureRecord(u64)
    FnPushStatic(std::String)
    # Strings
    StrEq
    StringStrEq
    StrStringEq
    # Static arrays
    PushStaticArray(u64 u64)
    # F-strings
    FstringConcat(u64)
    PrimitiveToStr(common::BuiltinType)
    # Syscalls
    Syscall0
    Syscall1
    Syscall2
    Syscall3
    Syscall4
    Syscall5
    Syscall6
    # Command-line arguments
    Argc
    Argv
    Envp
}

enum StaticArrayElement derives std::Clone {
    Imm(i64)
    String(u64)
