# x86-64 GNU assembly emitter for the Casa compiler.
# Constants
const INT32_MAX 2147483647
const INT32_MIN -2147483648
const RETURN_STACK_SIZE 1048576

# A function lowers rsp by at most one unchecked frame reservation, and then
# accesses at most this many bytes below rsp. Both fit in the runtime's 64 KiB
# return stack guard region.
const UNCHECKED_RETURN_STACK_BYTES 32768
const EXIT_SYSCALL 60
const STDOUT_FD 1
const STDERR_FD 2
const FAILURE_STATUS 1
const F32_ABSOLUTE_MASK 0x7FFFFFFF
const F32_INTEGRAL_THRESHOLD_BITS 0x4B000000
const F64_INTEGRAL_THRESHOLD_BITS 0x4330000000000000
const F32_HALF_BITS 0x3F000000
const F64_HALF_BITS 0x3FE0000000000000
const F32_SIGN_BIT_INDEX 31
const F64_SIGN_BIT_INDEX 63
const ODD_INTEGER_MASK 1
const MAX_LEAF_INSTRUCTIONS 8
const SCALAR_REGISTER_COUNT: u64 4
const LOCAL_REGISTER_COUNT: u64 4
const MIN_LOCAL_REGISTER_USES: u64 4
const LOOP_LOCAL_WEIGHT: u64 8

# Two bits per slot, initially r8, r9, r10, r11.
const INITIAL_SCALAR_REGISTER_ORDER 0xE4

struct Emitter {
    sources:                $lexer::SourceStore
    source_files:           std::Map[std::String u64]
    last_location:          std::Option[common::Location]
    # Byte range of the latest .loc record in asm.
    record_start:           u64
    record_end:             u64
    # Displacement of the value stack top from rbx until the next synchronization.
    stack_offset:           i64
    # Local storage below the return address, fixed for one function.
    frame_bytes:            u64
    local_count:            u64
    register_locals:        std::List[u64]
    preserve_stack:         bool
    join_depths:            std::Map[i64 u64]
    reachable:              bool
    arithmetic_error_label: u64
    env_overflow_label:     u64
    register_results:       std::Option[u64]
    register_calls:         std::Map[std::String RegisterCallPlan]
    native_calls:           std::Map[std::String common::NativeCallPlan]
    asm:                    std::String
    label_counter:          u64
    functions:              std::Map[std::String std::String]
    templates:              std::Map[std::String LeafTemplate]
    completed:              std::Set[std::String]
    strings:                std::List[std::String]
    string_indexes:         std::Map[std::String u64]
    static_arrays:          std::List[StaticArray]
    constants_count:        u64
    expanding_leaf:         bool
    labels:                 std::Set[i64]
    symbols:                std::Set[std::String]
    root_selected:          bool
    failure:                std::Option[std::String]
}

impl Emitter {
    fn new sources:$lexer::SourceStore -> Emitter {
        ".section .text\n".to_str = header
        std::Option[std::String]::None false std::Set[std::String]::new std::Set[i64]::new
        false 0
        std::List[StaticArray]::new
        std::Map[std::String u64]::new std::List[std::String]::new
        std::Set[std::String]::new std::Map[std::String LeafTemplate]::new
        std::Map[std::String std::String]::new
        0 header std::Map[std::String common::NativeCallPlan]::new
        std::Map[std::String RegisterCallPlan]::new std::Option[u64]::None 0 0 true std::Map[i64 u64]::new false std::List[u64]::new 0 0 0 0 0 std::Option[common::Location]::None std::Map[std::String u64]::new sources Emitter
    }

    fn intern_string self:mut$Emitter value:$str -> u64 {
        if value self.string_indexes.get_copy_str std::Option::Some(index) is then
            index return
        fi
        # The list defines first-seen pool order. The map only accelerates lookup.
        self.strings.length = index
        value self.strings.push_str
        index value self.string_indexes.set_str
        index
    }

    # Registration order is deterministic. Semantic identities remain the map keys.
    fn register_function self:mut$Emitter name:$str {
        if name self.functions.has_str then
            return
        fi
        if name " " str::contains then
            name encode_specialization_name
        else
            name sanitize_name
        fi = label
        label name self.functions.set_str
    }

    fn function_label self:$Emitter name:$str -> $str { name self.functions.get_str.unwrap.as_str }

    fn into_asm self:Emitter -> std::String {
        self match
            Emitter { asm: asm } => asm
        end
    }

    fn emit_uid self:mut$Emitter -> u64 {
        1 += self.label_counter
        self.label_counter
    }

    fn line self:mut$Emitter text:str {
        text self.asm.append
        '\n' self.asm.push
    }

    fn indent self:mut$Emitter text:str {
        "    " self.asm.append
        text self.asm.append
        '\n' self.asm.push
    }

    fn line_string self:mut$Emitter text:std::String {
        text.as_str self.asm.append
        '\n' self.asm.push
    }

    # Higher slots have lower addresses, so inline aggregates span upward from
    # their recorded slot.
    fn emit_local_operand self:mut$Emitter index:u64 {
        self.frame_bytes index 1 + common::WORD_SIZE * - = offset
        f"{offset}(%rsp)" = operand
        operand.as_str self.asm.append
    }

    fn emit_unary_register self:mut$Emitter operation:$str register:$str {
        "    " self.asm.append
        operation self.asm.append
        " " self.asm.append
        register self.asm.append
        "" self.line
    }

    fn emit_binary_registers self:mut$Emitter operation:$str source:$str destination:$str {
        "    " self.asm.append
        operation self.asm.append
        " " self.asm.append
        source self.asm.append
        ", " self.asm.append
        destination self.asm.append
        "" self.line
    }

    fn indent_string self:mut$Emitter text:std::String {
        "    " self.asm.append
        text.as_str self.asm.append
        '\n' self.asm.push
    }

    # The value stack grows down from rbx. Pushes and pops move a compile-time
    # displacement, so rbx itself moves only when the stack is synchronized.
    fn stack_operand self:$Emitter depth:u64 -> std::String {
        depth common::WORD_SIZE * i64::try_from.unwrap self.stack_offset + = displacement
        f"{displacement}(%rbx)"
    }

    fn emit_pop self:mut$Emitter destination:$str {
        f"movq {self.stack_offset}(%rbx), {destination}" self.indent_string
        common::WORD_SIZE += self.stack_offset
    }

    fn emit_push self:mut$Emitter source:$str {
        common::WORD_SIZE -= self.stack_offset
        f"movq {source}, {self.stack_offset}(%rbx)" self.indent_string
    }

    # Calls, returns, and block boundaries expect rbx at the value stack top.
    # leaq preserves the flags of a pending conditional jump.
    fn sync_value_stack self:mut$Emitter {
        if 0 self.stack_offset == then
            return
        fi
        f"leaq {self.stack_offset}(%rbx), %rbx" self.indent_string
        0 = self.stack_offset
    }

    # A runtime failure must be called from inside the current frame's CFI.
    # Share one cold call site per handler without adding work to the hot path.
    fn emit_failure_jump self:mut$Emitter jump:$str failure:$str {
        if failure "arithmetic_error" == then
            if 0 self.arithmetic_error_label == then
                self.emit_uid = self.arithmetic_error_label
            fi
            f"{jump} .Larithmetic_error_{self.arithmetic_error_label}" self.indent_string
        elif failure "env_stack_overflow" == then
            if 0 self.env_overflow_label == then
                self.emit_uid = self.env_overflow_label
            fi
            f"{jump} .Lenv_overflow_{self.env_overflow_label}" self.indent_string
        else
            f"{jump} {failure}" self.indent_string
        fi
    }

    fn emit_failure_calls self:mut$Emitter {
        if 0 self.arithmetic_error_label != then
            f".Larithmetic_error_{self.arithmetic_error_label}:" self.line_string
            "call arithmetic_error" self.indent
            "ud2" self.indent
        fi
        if 0 self.env_overflow_label != then
            f".Lenv_overflow_{self.env_overflow_label}:" self.line_string
            "call env_stack_overflow" self.indent
            "ud2" self.indent
        fi
    }
}

# A forwarding parameter can remain on the value stack when no instruction
# observes its local slot or introduces a call without a bounded leaf template.
fn has_forwarding_frame
    bytecode:$std::List[InstValue]
    templates:$std::Map[std::String LeafTemplate]
-> bool {
    if 6 bytecode.length > then
        false return
    fi
    if 0 bytecode.get InstValue::LocalsInit(count) is then
        if 1 count != then
            false return
        fi
    else
        false return
    fi
    if 1 bytecode.get InstValue::Label is ! then
        false return
    fi
    if 2 bytecode.get InstValue::LocalSet(index) is then
        if 0 index != then
            false return
        fi
    else
        false return
    fi
    if 3 bytecode.get InstValue::LocalGet(index) is then
        if 0 index != then
            false return
        fi
    else
        false return
    fi
    if bytecode.length 2 - bytecode.get InstValue::LocalsUninit(count) is then
        if 1 count != then
            false return
        fi
    else
        false return
    fi
    if bytecode.length 1 - bytecode.get InstValue::FnReturn is ! then
        false return
    fi
    for index in bytecode.length 2 - 4 std::Range::new do
        if templates index bytecode.get leaf_instruction_size.is_none then
            false return
        fi
    done
    true
}

# Explicitly exclude operations that call runtime helpers, access frame state,
# or transfer control. Checked arithmetic can call the error writer, whose
# return address must observe the original physical frame.
fn is_leaf_instruction inst:$InstValue -> bool {
    inst match
        InstValue::Drop => true
        InstValue::Dup => true
        InstValue::Over => true
        InstValue::Push => true
        InstValue::PushChar => true
        InstValue::PushStr => true
        InstValue::Rot => true
        InstValue::Swap => true
        InstValue::Load8 => true
        InstValue::Load16 => true
        InstValue::Load32 => true
        InstValue::Load64 => true
        InstValue::Add => true
        InstValue::Sub => true
        InstValue::Mul => true
        InstValue::BitAnd => true
        InstValue::BitOr => true
        InstValue::BitXor => true
        InstValue::BitNot => true
        InstValue::And => true
        InstValue::Or => true
        InstValue::Not => true
        InstValue::Eq => true
        InstValue::Ne => true
        InstValue::Lt => true
        InstValue::Le => true
        InstValue::Gt => true
        InstValue::Ge => true
        InstValue::Ult => true
        InstValue::Ule => true
        InstValue::Ugt => true
        InstValue::Uge => true
        InstValue::NormalizeInt => true
        _ => false
    end
}

struct LeafTemplate {
    instructions:   std::List[InstValue]
    locations:      std::List[common::Location]
    local_bytes:    u64
    start:          u64
    end_index:      u64
    expanded_count: u64
}

# A register holds one distinct value in a suffix of the value stack. Copies
# use separate registers. Calls and branch edges reconcile the suffix with
# their register contracts. Unsupported operations materialize it in memory.
struct ScalarStack {
    depth: u64
    first: u64
    order: u64
}

# Scalar frame slots have disjoint storage from inline aggregates. An address
# use pins its slot in memory, including shared and exclusive borrows.
impl Emitter {
    fn plan_register_storage self:mut$Emitter instructions:$std::List[InstValue] {
        std::List[u64]::new = self.register_locals
        std::Map[i64 u64]::new = self.join_depths
        false = self.preserve_stack
        true = self.reachable
        std::List[u64]::new = uses
        std::Map[i64 u64]::new = label_positions
        0 = depth: u64
        0 = position: u64
        for instruction in instructions.iter do
            instruction match
                InstValue::LocalGet(slot) | InstValue::LocalSet(slot) => {
                    slot uses.get 1 + slot uses.set
                }
                InstValue::LocalsInit(count) => {
                    for index in count 0 std::Range::new do
                        0 uses.push
                    done
                }
                InstValue::Label(label) | InstValue::MemoryLabel(label) => {
                    position label label_key label_positions.set
                    if instruction InstValue::MemoryLabel is then
                        0 label label_key self.join_depths.set
                    fi
                }
                InstValue::Jump(label) => {
                    if label label_key label_positions.get_copy std::Option::Some(start) is then
                        uses position start instructions weight_loop_locals
                    fi
                }
                # All dispatch edges use the memory stack. Establish their
                # contracts before a preceding branch can choose another depth.
                InstValue::JumpTable(targets fallback) => {
                    0 fallback label_key self.join_depths.set
                    for target in targets.iter do
                        0 target label_key self.join_depths.set
                    done
                }
                _ => {}
            end
            1 += position
            depth instruction self.plan_cached_depth = depth
        done
        # Frameless functions keep the memory fallback for lower call values.
        # Add a preservation-only frame if those calls become a measured bottleneck.
        if uses.is_empty then
            false = self.preserve_stack
            return
        fi
        for instruction in instructions.iter do
            if instruction InstValue::LocalAddress(slot) is then
                0 slot uses.set
            fi
        done
        # Dense frame indices make equal scores deterministic without sorting.
        while self.register_locals.length LOCAL_REGISTER_COUNT < do
            std::Option[u64]::None = selected
            MIN_LOCAL_REGISTER_USES 1 - = score
            for slot in uses.length 0 std::Range::new do
                slot uses.get copy = count
                if count score > then
                    slot std::Option::Some = selected
                    count = score
                fi
            done
            if selected std::Option::Some(slot) is then
                slot self.register_locals.push
                0 slot uses.set
            else
                break
            fi
        done
    }

    # Estimate the cache in straight-line regions only to decide whether rbp
    # needs a save slot. Emission may spill at other calls without this slot.
    fn plan_cached_depth self:mut$Emitter instruction:$InstValue depth:u64 -> u64 {
        if instruction InstValue::FnCall(name) is then
            if name self.register_calls.get_copy std::Option::Some(plan) is then
                if depth plan.arguments > name self.templates.has ! && then
                    true = self.preserve_stack
                fi
                plan.results return
            fi
            0 return
        fi
        if instruction InstValue::FnExec(plan) is then
            if plan std::Option::Some(contract) is then
                if depth contract.arguments 1 + > then
                    true = self.preserve_stack
                fi
                contract.results return
            fi
            0 return
        fi
        if instruction get_scalar_input_count std::Option::Some(inputs) is then
            if depth inputs < then
                inputs = depth
            fi
            instruction match
                InstValue::Drop | InstValue::LocalSet | InstValue::JumpNe | InstValue::Store8 | InstValue::Store16 | InstValue::Store32 | InstValue::Store64 => 0
                InstValue::Dup | InstValue::Swap => 2
                InstValue::Over | InstValue::Rot => 3
                InstValue::NumericConvert => 0
                InstValue::NormalizeInt(builtin) => {
                    if builtin.bit_width 64 == then 0 else 1 fi
                }
                _ => 1
            end = outputs: u64
            depth inputs - outputs + = depth
            if depth SCALAR_REGISTER_COUNT > then
                SCALAR_REGISTER_COUNT
            else
                depth
            fi
        else
            0
        fi
    }

    fn find_local_register self:$Emitter slot:u64 -> std::Option[str] {
        for index in self.register_locals.length 0 std::Range::new do
            if index self.register_locals.get slot == then
                index get_local_register std::Option::Some return
            fi
        done
        std::Option[str]::None
    }

    fn emit_register_slot_store self:mut$Emitter register:str slot:u64 {
        "    movq " self.asm.append
        register self.asm.append
        ", " self.asm.append
        slot self.emit_local_operand
        "" self.line
    }

    fn emit_register_slot_load self:mut$Emitter register:str slot:u64 {
        "    movq " self.asm.append
        slot self.emit_local_operand
        ", " self.asm.append
        register self.asm.append
        "" self.line
    }

    fn describe_saved_registers self:mut$Emitter {
        for index in self.register_locals.length 0 std::Range::new do
            index get_local_register = register
            self.local_count index + 2 + common::WORD_SIZE * = offset
            f".cfi_offset {register}, -{offset}" self.indent_string
        done
        if self.preserve_stack then
            self.local_count self.register_locals.length + 2 + common::WORD_SIZE * = offset
            f".cfi_offset %rbp, -{offset}" self.indent_string
        fi
    }

    fn save_function_registers self:mut$Emitter {
        for index in self.register_locals.length 0 std::Range::new do
            self.local_count index + index get_local_register self.emit_register_slot_store
        done
        if self.preserve_stack then
            self.local_count self.register_locals.length + "%rbp" self.emit_register_slot_store
        fi
        self.describe_saved_registers
    }

    fn restore_function_registers self:mut$Emitter {
        for index in self.register_locals.length 0 std::Range::new do
            index get_local_register = register
            self.local_count index + register self.emit_register_slot_load
            f".cfi_restore {register}" self.indent_string
        done
        if self.preserve_stack then
            self.local_count self.register_locals.length + "%rbp" self.emit_register_slot_load
            ".cfi_restore %rbp" self.indent
        fi
    }

    # Runtime helpers and native adapters predate the callee-saved local ABI.
    # Preserve every register they clobber, including callers' unallocated ones.
    fn get_local_clobbers self:$Emitter instruction:$InstValue -> u64 {
        instruction match
            InstValue::ExternCall => 0xA
            InstValue::PrimitiveToStr => 0xA
            InstValue::FstringConcat => 0xF
            InstValue::PrintInt => 0x8
            InstValue::PrintString => 0x1
            _ => 0
        end
    }

    fn save_clobbered_registers self:mut$Emitter mask:u64 {
        ".cfi_remember_state" self.indent
        self.frame_bytes common::WORD_SIZE + = offset
        for index in LOCAL_REGISTER_COUNT 0 std::Range::new do
            if mask index >> 1 & 0 == then
                continue
            fi
            index get_local_register = register
            register "pushq" self.emit_unary_register
            common::WORD_SIZE += offset
            ".cfi_adjust_cfa_offset 8" self.indent
            # An allocated register's prologue slot holds the caller's value.
            # This temporary push holds our local, so retain the earlier rule.
            if index self.register_locals.length >= then
                f".cfi_offset {register}, -{offset}" self.indent_string
            fi
        done
    }

    fn restore_clobbered_registers self:mut$Emitter mask:u64 {
        LOCAL_REGISTER_COUNT = remaining
        while remaining 0 > do
            1 -= remaining
            if mask remaining >> 1 & 0 == then
                continue
            fi
            remaining get_local_register "popq" self.emit_unary_register
            ".cfi_adjust_cfa_offset -8" self.indent
        done
        ".cfi_restore_state" self.indent
    }

    # Each label has one canonical register suffix. The first incoming edge
    # chooses its depth, and later edges spill or refill to that contract.
    fn prepare_join self:mut$Emitter cache:mut$ScalarStack label:u64 {
        if label label_key self.join_depths.get_copy std::Option::Some(depth) is then
            depth
        else
            cache.depth label label_key self.join_depths.set
            cache.depth
        fi = depth
        depth cache self.prepare_register_transfer
        self.sync_value_stack
    }

    # Keep the highest live value below the arguments in a callee-saved
    # register. Deeper live values spill in order. Revisit this one-value limit
    # if measured call sites justify taking registers away from hot locals.
    fn preserve_call_value self:mut$Emitter cache:mut$ScalarStack arguments:u64 -> bool {
        if self.preserve_stack ! cache.depth arguments <= || then
            false return
        fi
        cache.depth arguments - = lower_count
        for index in lower_count 1 - 0 std::Range::new do
            index cache.get_register self.emit_push
        done
        "%rbp" lower_count 1 - cache.get_register "movq" self.emit_binary_registers
        cache.first lower_count + SCALAR_REGISTER_COUNT % = cache.first
        arguments = cache.depth
        true
    }

    fn restore_call_value self:mut$Emitter cache:mut$ScalarStack {
        if cache.depth SCALAR_REGISTER_COUNT == then
            "%rbp" self.emit_push
        else
            cache.first SCALAR_REGISTER_COUNT + 1 - SCALAR_REGISTER_COUNT % = cache.first
            0 cache.get_register "%rbp" "movq" self.emit_binary_registers
            1 += cache.depth
        fi
    }

    fn emit_register_normalization self:mut$Emitter builtin:common::BuiltinType target:str {
        if builtin.bit_width 64 == then
            return
        fi
        "%rax" target "movq" self.emit_binary_registers
        builtin match
            common::BuiltinType::I8 => target "%al" "movsbq" self.emit_binary_registers
            common::BuiltinType::I16 => target "%ax" "movswq" self.emit_binary_registers
            common::BuiltinType::I32 => target "%eax" "movslq" self.emit_binary_registers
            common::BuiltinType::U8 => target "%al" "movzbq" self.emit_binary_registers
            common::BuiltinType::U16 => target "%ax" "movzwq" self.emit_binary_registers
            common::BuiltinType::U32 => {
                "movl %eax, %eax" self.indent
                target "%rax" "movq" self.emit_binary_registers
            }
            _ => {}
        end
    }

    fn emit_float_literal self:mut$Emitter value:str builtin:common::BuiltinType target:str {
        ".pushsection .rodata" self.line
        if builtin common::BuiltinType::F32 == then ".align 4" else ".align 8" fi self.line
        "0:" self.line
        if builtin common::BuiltinType::F32 == then
            f".float {value}"
        else
            f".double {value}"
        fi self.line_string
        ".popsection" self.line
        if builtin common::BuiltinType::F32 == then
            "movl 0b(%rip), %eax" self.indent
            target "%rax" "movq" self.emit_binary_registers
        else
            f"movq 0b(%rip), {target}" self.indent_string
        fi
    }

    fn emit_register_float_binary self:mut$Emitter instruction:$InstValue top:str below:str {
        instruction match
            InstValue::FloatAdd32 => "addss"
            InstValue::FloatAdd64 => "addsd"
            InstValue::FloatSub32 => "subss"
            InstValue::FloatSub64 => "subsd"
            InstValue::FloatMul32 => "mulss"
            InstValue::FloatMul64 => "mulsd"
            InstValue::FloatDiv32 => "divss"
            InstValue::FloatDiv64 => "divsd"
            _ => "Invalid register float operation" panic
        end = operation
        "%xmm0" below "movq" self.emit_binary_registers
        "%xmm1" top "movq" self.emit_binary_registers
        "%xmm0" "%xmm1" operation self.emit_binary_registers
        below "%xmm0" "movq" self.emit_binary_registers
    }
}

# Backward jumps delimit already-lowered loop bodies. Weight their local uses
# without retaining a control-flow graph or iterating a dataflow analysis.
fn weight_loop_locals
    instructions:$std::List[InstValue]
    start:u64
    end_index:u64
    uses:mut$std::List[u64]
{
    for index in end_index start std::Range::new do
        index instructions.get match
            InstValue::LocalGet(slot) | InstValue::LocalSet(slot) => {
                slot uses.get LOOP_LOCAL_WEIGHT + slot uses.set
            }
            _ => {}
        end
    done
}

fn get_local_register index:u64 -> str {
    index match
        0 => "%r12"
        1 => "%r13"
        2 => "%r14"
        3 => "%r15"
        _ => "Invalid local register index" panic
    end
}

impl ScalarStack {
    fn new -> ScalarStack { INITIAL_SCALAR_REGISTER_ORDER 0 0 ScalarStack }

    fn get_register self:$ScalarStack index:u64 -> str {
        self.first index + 3 & 2 * = shift
        self.order shift >> 3 & get_scalar_register
    }

    # Reorder register identities without moving the values stored in them.
    fn swap_registers self:mut$ScalarStack first:u64 second:u64 {
        self.first first + 3 & 2 * = first_shift
        self.first second + 3 & 2 * = second_shift
        self.order first_shift >> self.order second_shift >> ^ 3 & = difference
        self.order difference first_shift << ^ difference second_shift << ^ = self.order
    }
}

fn get_scalar_register index:u64 -> str {
    index match
        0 => "%r8"
        1 => "%r9"
        2 => "%r10"
        3 => "%r11"
        _ => "Invalid scalar register index" panic
    end
}

fn get_scalar_input_count inst:$InstValue -> std::Option[u64] {
    inst match
        InstValue::Push => 0
        InstValue::PushChar => 0
        InstValue::PushStr => 0
        InstValue::LocalGet => 0
        InstValue::LocalAddress => 0
        InstValue::LocalSet => 1
        InstValue::JumpNe => 1
        InstValue::Drop => 1
        InstValue::Dup => 1
        InstValue::Over => 2
        InstValue::Swap => 2
        InstValue::Rot => 3
        InstValue::Load8 => 1
        InstValue::Load16 => 1
        InstValue::Load32 => 1
        InstValue::Load64 => 1
        InstValue::Store8 => 2
        InstValue::Store16 => 2
        InstValue::Store32 => 2
        InstValue::Store64 => 2
        InstValue::NormalizeInt(builtin) => {
            if builtin.bit_width 64 == then 0 else 1 fi
        }
        InstValue::PushFloat32 => 0
        InstValue::PushFloat64 => 0
        InstValue::FloatAdd32 | InstValue::FloatAdd64 | InstValue::FloatSub32 | InstValue::FloatSub64 | InstValue::FloatMul32 | InstValue::FloatMul64 | InstValue::FloatDiv32 | InstValue::FloatDiv64 => 2
        InstValue::NumericConvert(conversion) => {
            if
                conversion.kind common::NumericConversionKind::FromBits ==
                conversion.kind common::NumericConversionKind::ToBits == ||
                conversion.source.is_integer conversion.target.is_integer &&
                64 conversion.target.bit_width == && ||
            then
                0
            else
                std::Option[u64]::None return
            fi
        }
        InstValue::Add => 2
        InstValue::Sub => 2
        InstValue::Mul => 2
        InstValue::CheckedAdd(builtin) => {
            if 64 builtin.bit_width != then
                std::Option[u64]::None return
            fi
            2
        }
        InstValue::CheckedSub(builtin) => {
            if 64 builtin.bit_width != then
                std::Option[u64]::None return
            fi
            2
        }
        InstValue::CheckedMul(builtin) => {
            if 64 builtin.bit_width != then
                std::Option[u64]::None return
            fi
            2
        }
        InstValue::BitAnd => 2
        InstValue::BitOr => 2
        InstValue::BitXor => 2
        InstValue::BitNot => 1
        InstValue::And => 2
        InstValue::Or => 2
        InstValue::Not => 1
        InstValue::Eq => 2
        InstValue::Ne => 2
        InstValue::Lt => 2
        InstValue::Le => 2
        InstValue::Gt => 2
        InstValue::Ge => 2
        InstValue::Ult => 2
        InstValue::Ule => 2
        InstValue::Ugt => 2
        InstValue::Uge => 2
        _ => std::Option[u64]::None return
    end = count: u64
    count std::Option::Some
}

# Templates borrow no function storage and live only during this emission.
# The fixed budget bounds expanded code growth. Only already-selected callees
# can contribute templates, so recursive calls cannot form expansion cycles.
struct LeafRange {
    local_bytes:    u64
    start:          u64
    end_index:      u64
    expanded_count: u64
}

fn leaf_instruction_size
    instruction:$InstValue
    templates:$std::Map[std::String LeafTemplate]
-> std::Option[u64] {
    if instruction InstValue::FnCall(name) is then
        if name templates.get std::Option::Some(template) is then
            # Count each nested expansion too, bounding expansion depth.
            template.expanded_count 1 + std::Option::Some return
        fi
    elif instruction is_leaf_instruction then
        1 std::Option[u64]::Some return
    fi
    std::Option[u64]::None
}

fn find_leaf_range
    body:$std::List[InstValue]
    templates:$std::Map[std::String LeafTemplate]
-> std::Option[LeafRange] {
    if body.is_empty then
        std::Option[LeafRange]::None return
    fi
    0 = start: u64
    body.length 1 - = end_index
    0 = local_bytes: u64
    if templates body has_forwarding_frame then
        4 = start: u64
        1 -= end_index
        common::WORD_SIZE = local_bytes: u64
    else
        if end_index body.get InstValue::FnReturn is ! then
            std::Option[LeafRange]::None return
        fi
        if 0 body.get InstValue::Label is then
            1 = start: u64
        fi
    fi
    if start end_index >= MAX_LEAF_INSTRUCTIONS end_index start - < || then
        std::Option[LeafRange]::None return
    fi
    start = index
    0 = expanded_count: u64
    0 = nested_bytes: u64
    while index end_index < do
        index body.get = instruction
        templates instruction leaf_instruction_size match
            std::Option::Some(count) => count += expanded_count
            std::Option::None => std::Option[LeafRange]::None return
        end
        if MAX_LEAF_INSTRUCTIONS expanded_count < then
            std::Option[LeafRange]::None return
        fi
        if instruction InstValue::FnCall(name) is then
            name templates
                .get
                .unwrap
                .local_bytes common::WORD_SIZE + = required
            if nested_bytes required < then
                required = nested_bytes
            fi
        fi
        1 += index
    done
    expanded_count end_index start local_bytes nested_bytes + LeafRange std::Option::Some
}

# BSS section
impl Emitter {
    fn emit_bss self:mut$Emitter {
        ".section .bss" self.line
        if 0 self.constants_count < then
            f"constants: .skip {self.constants_count common::WORD_SIZE *}" self.line_string
        fi
        "" self.line
    }

    # DATA section
    fn emit_static_element self:mut$Emitter element:$StaticArrayElement {
        element match
            StaticArrayElement::Imm(value) => f".quad {value}" self.line_string
            StaticArrayElement::String(identity) => f".quad str_{identity}" self.line_string
            StaticArrayElement::Function(name) => {
                name.as_str self.function_label = label
                f".quad closure_{label}" self.line_string
            }
        end
    }

    fn emit_data self:mut$Emitter {
        ".section .data" self.line
        0 = index: u64
        while
            index self
                .strings
                .length <
        do
            index self.strings.get = value
            value.as_str escape_string = escaped
            value.length = length
            ".align 8" self.line
            f"str_{index}:" self.line_string
            f".quad {length}" self.line_string
            f".asciz \"{escaped}\"" self.line_string
            1 += index
        done
        # Static closure record per function
        for
            name in self
                .functions
                .keys
                .iter
        do
            name.as_str self.function_label = label
            f"closure_{label}: .quad fn_{label}" = record
            ".align 8" self.line
            record self.line_string
            ".quad 0" self.line
        done

        # Static array literals
        self.static_arrays.reverse
        0 = sa_index: u64
        while self.static_arrays.is_empty ! do
            self.static_arrays.pop = sa
            sa.elements = elems: $std::List[StaticArrayElement]
            ".align 8" self.line
            f"static_array_{sa_index}:" self.line_string
            # A zero-length array is inhabited, so its label owns storage of
            # its own rather than aliasing what follows (ADR-0155).
            if 0 elems.length == then
                ".quad 0" self.line
            fi
            for elem in elems.iter do
                elem self.emit_static_element
            done
            1 += sa_index
        done

        "" self.line
    }

    # TEXT section
    fn select_function
        self:mut$Emitter
        name:$str
        plan:FunctionPlan
    -> std::Result[std::Unit std::String] {
        plan self.begin_selection ? drop
        if name self.completed.has_str then
            "Duplicate machine function" self.reject return
        fi
        if name self.functions.has_str ! then
            "Unregistered machine function" self.reject return
        fi
        name self.function_label.to_str = label
        if label self.symbols.has then
            "Duplicate machine symbol" self.reject return
        fi
        label.clone self.symbols.add
        plan match
            FunctionPlan { actions: actions locations: locations } => locations actions
        end = bytecode = locations
        ".p2align 6" self.line
        f".type fn_{label}, @function" self.line_string
        f"fn_{label}:" self.line_string
        ".cfi_startproc" self.indent
        locations self.emit_entry_location
        name self.register_calls.get_copy_str false locations bytecode self.emit_bytecode
        self.emit_failure_calls
        ".cfi_endproc" self.indent
        f".size fn_{label}, .-fn_{label}" self.line_string
        "" self.line
        self.templates bytecode find_leaf_range match
            std::Option::Some(range) => {
                range.expanded_count range.end_index range.start range.local_bytes locations bytecode LeafTemplate
                name.to_str self.templates.set
            }
            std::Option::None => {}
        end
        name self.completed.add_str
        std::Unit::Value std::Result::Ok
    }

    fn select_root self:mut$Emitter plan:FunctionPlan -> std::Result[std::Unit std::String] {
        if self.root_selected then
            "Duplicate root function" self.reject return
        fi
        plan self.begin_selection ? drop
        plan.locations plan.actions self.emit_start
        true = self.root_selected
        std::Unit::Value std::Result::Ok
    }

    fn finish self:Emitter -> std::Result[std::String std::String] {
        if self.failure std::Option::Some(message) is then
            message.clone std::Result::Error return
        fi
        if self.root_selected ! then
            "Missing root function".to_str std::Result::Error return
        fi
        self.validate_pools ? drop
        if self.functions.length self.completed.length != then
            "Missing completed machine function".to_str std::Result::Error return
        fi
        self.emit_bss
        self.emit_data
        common::empty_location self.emit_location
        runtime::ASSEMBLY self.asm.append
        self.into_asm std::Result::Ok
    }

    fn emit_start
        self:mut$Emitter
        bytecode:$std::List[InstValue]
        locations:$std::List[common::Location]
    {
        ".globl _start" self.line
        ".type _start, @function" self.line
        "_start:" self.line
        ".cfi_startproc" self.indent
        # Unwinders stop at the process entry.
        ".cfi_undefined %rip" self.indent
        locations self.emit_entry_location
        "movq (%rsp), %rax" self.indent
        "movq %rax, __argc(%rip)" self.indent
        "leaq 8(%rsp), %rax" self.indent
        "movq %rax, __argv(%rip)" self.indent
        "movq (%rsp), %rcx" self.indent
        "addq $1, %rcx" self.indent
        "leaq 8(%rsp,%rcx,8), %rax" self.indent
        "movq %rax, __envp(%rip)" self.indent
        # The process stack holds values, and rsp moves to the return stack.
        "movq %rsp, %rbx" self.indent
        "leaq return_stack_top(%rip), %rsp" self.indent
        "call return_stack_guard_init" self.indent
        std::Option[RegisterCallPlan]::None true locations bytecode self.emit_bytecode
        "movq $60, %rax" self.indent
        "xorq %rdi, %rdi" self.indent
        "syscall" self.indent
        self.emit_failure_calls
        ".cfi_endproc" self.indent
        ".size _start, .-_start" self.line
        "" self.line
    }

    fn emit_bytecode
        self:mut$Emitter
        bytecode:$std::List[InstValue]
        locations:$std::List[common::Location]
        is_global:bool
        call_plan:std::Option[RegisterCallPlan]
    {
        bytecode self.plan_register_storage
        ScalarStack::new = cache
        std::Option[u64]::None = self.register_results
        if call_plan std::Option::Some(plan) is then
            plan.arguments = cache.depth
            plan.results std::Option::Some = self.register_results
        fi
        0 = self.stack_offset
        0 = self.frame_bytes
        0 = self.arithmetic_error_label
        0 = self.env_overflow_label
        # A standalone wrapper keeps its frame so nested capacity checks include it.
        std::Map[std::String LeafTemplate]::new = no_templates
        if is_global ! no_templates bytecode has_forwarding_frame && then
            common::WORD_SIZE self.emit_return_stack_check
            is_global cache bytecode.length 2 - 4 locations bytecode self.emit_instruction_range
            is_global cache InstValue::FnReturn self.emit_scalar_or_inst
            return
        fi
        0 = start: u64
        if self.register_results.is_some then
            # The first label is an entry marker, never a control-flow target.
            # Frame setup and flag initialization must see the incoming suffix.
            while start bytecode.length < do
                start locations.get self.emit_location
                start bytecode.get = instruction
                1 += start
                if instruction InstValue::Label is then
                    is_global instruction self.emit_inst
                    break
                fi
                is_global cache instruction self.emit_scalar_or_inst
            done
        fi
        is_global cache bytecode.length start locations bytecode self.emit_instruction_range
        cache self.flush_scalar_stack
    }

    fn emit_instruction_range
        self:mut$Emitter
        bytecode:$std::List[InstValue]
        locations:$std::List[common::Location]
        start:u64
        end_index:u64
        cache:mut$ScalarStack
        is_global:bool
    {
        start = index
        while index end_index < do
            index bytecode.get = inst
            index locations.get self.emit_location
            if self.reachable ! inst InstValue::Label is ! && inst InstValue::MemoryLabel is ! && then
                1 += index
                continue
            fi
            cache end_index index bytecode.slice self.emit_fused_instructions = consumed
            if 0 consumed == then
                is_global cache inst self.emit_expanded_or_inst
                1 = consumed: u64
            fi
            consumed += index
        done
    }

    # Emit the first instruction of `window` together with the instructions
    # after it as one machine sequence. Return the number of instructions
    # emitted, or zero when no combination applies.
    fn emit_fused_instructions
        self:mut$Emitter
        window:$std::Slice[InstValue]
        cache:mut$ScalarStack
    -> u64 {
        if window.length 2 < then
            0 return
        fi
        0 window.nth = inst
        1 window.nth = next
        inst match
            InstValue::LocalSet(written) => {
                next match
                    InstValue::LocalGet(read) if written read == => {
                        cache inst self.emit_scalar_inst drop
                        1 += cache.depth
                        2 return
                    }
                    _ => {}
                end
            }
            InstValue::Push(amount) => {
                if cache next amount self.emit_immediate_shift then
                    2 return
                fi
                if cache next amount self.emit_power_of_two_division then
                    2 return
                fi
                if
                    window.length 3 >=
                    INT32_MIN amount <= && INT32_MAX amount >= &&
                    next InstValue::Add is &&
                then
                    # `&&` is eager, so read the third instruction only after
                    # the length check.
                    if 2 window.nth InstValue::Load64 is then
                        1 cache self.refill_scalar_stack
                        cache.depth 1 - cache.get_register = register
                        f"movq {amount}({register}), {register}" self.indent_string
                        3 return
                    fi
                fi
            }
            _ => {}
        end
        if cache next inst self.emit_comparison_branch then
            2 return
        fi
        0
    }

    # Match only adjacent constants, as with immediate shifts. Propagating local
    # values would need dataflow analysis and is left to a future measured need.
    # A false result leaves the cache and output unchanged.
    fn emit_power_of_two_division
        self:mut$Emitter
        divisor_bits:i64
        instruction:$InstValue
        cache:mut$ScalarStack
    -> bool {
        instruction match
            InstValue::CheckedDiv(builtin) => {
                if builtin.is_unsigned ! then false return fi
                false
            }
            InstValue::CheckedMod(builtin) => {
                if builtin.is_unsigned ! then false return fi
                true
            }
            _ => false return
        end = remainder
        # SAFETY: Push stores integer bits as i64, including the u64 high bit.
        unsafe { divisor_bits u64::wrapping_from = divisor }
        if divisor 0 == then
            false return
        fi
        divisor 1 - = mask
        if divisor mask & 0 != then
            false return
        fi
        1 cache self.refill_scalar_stack
        cache.depth 1 - cache.get_register = register
        if remainder then
            # andq immediates sign-extend 32 bits. Larger masks need a register.
            if mask INT32_MAX u64::try_from.unwrap <= then
                f"andq ${mask}, {register}" self.indent_string
            else
                f"movabsq ${mask}, %rax" self.indent_string
                f"andq %rax, {register}" self.indent_string
            fi
        else
            0 = shift: u64
            while divisor 1 > do
                divisor 1 >> = divisor
                1 += shift
            done
            f"shrq ${shift}, {register}" self.indent_string
        fi
        true
    }

    # Constant counts can shift a cached value directly. Invalid counts retain
    # the checked path, and following normalization still handles narrow integers.
    fn emit_immediate_shift
        self:mut$Emitter
        amount:i64
        instruction:$InstValue
        cache:mut$ScalarStack
    -> bool {
        if 0 amount > then
            false return
        fi
        instruction match
            InstValue::CheckedShl(builtin) => {
                if builtin.bit_width amount <= then false return fi
                "shlq"
            }
            InstValue::CheckedShr(builtin) => {
                if builtin.bit_width amount <= then
                    false return
                fi
                if builtin.is_unsigned then
                    "shrq"
                else
                    "sarq"
                fi
            }
            _ => false return
        end = operation
        1 cache self.refill_scalar_stack
        cache.depth 1 - cache.get_register = register
        f"{operation} ${amount}, {register}" self.indent_string
        true
    }

    # A false result leaves both the cache and output unchanged. The comparison
    # consumes its two operands, and the branch consumes the unmaterialized bool.
    fn emit_comparison_branch
        self:mut$Emitter
        comparison:$InstValue
        jump:$InstValue
        cache:mut$ScalarStack
    -> bool {
        jump match
            InstValue::JumpNe(label) => label
            _ => false return
        end = label
        comparison match
            InstValue::Eq => "jne"
            InstValue::Ne => "je"
            InstValue::Lt => "jge"
            InstValue::Le => "jg"
            InstValue::Gt => "jle"
            InstValue::Ge => "jl"
            InstValue::Ult => "jae"
            InstValue::Ule => "ja"
            InstValue::Ugt => "jbe"
            InstValue::Uge => "jb"
            _ => false return
        end = branch
        2 cache self.refill_scalar_stack
        cache.depth 1 - cache.get_register = top
        cache.depth 2 - cache.get_register = below
        2 -= cache.depth
        # Keep cmp and jcc adjacent for branch fusion. Only nonempty suffixes
        # can overwrite operand registers while reconciling the edge.
        if
            cache.depth 0 != 0 label label_key self
                .join_depths
                .get_copy
                .unwrap_or 0 != ||
        then
            "%rax" top "movq" self.emit_binary_registers
            "%rdx" below "movq" self.emit_binary_registers
            label cache self.prepare_join
            "%rdx" "%rax" "cmpq" self.emit_binary_registers
        else
            label cache self.prepare_join
            below top "cmpq" self.emit_binary_registers
        fi
        f"{branch} .L{label}" self.indent_string
        true
    }

    fn emit_expanded_or_inst self:mut$Emitter inst:$InstValue cache:mut$ScalarStack is_global:bool {
        if inst InstValue::FnCall(name) is then
            if name self.templates.get std::Option::Some(template) is then
                is_global cache template self.emit_leaf_template
                return
            fi
        fi
        is_global cache inst self.emit_scalar_or_inst
    }

    fn emit_leaf_template
        self:mut$Emitter
        template:$LeafTemplate
        cache:mut$ScalarStack
        is_global:bool
    {
        self.expanding_leaf = nested
        self.last_location.clone = callsite
        # The outer check covers the maximum reservation across nested templates.
        if nested ! then
            common::WORD_SIZE template.local_bytes + self.emit_return_stack_check
        fi
        true = self.expanding_leaf
        is_global cache template.end_index template.start template.locations template.instructions
        self.emit_instruction_range
        nested = self.expanding_leaf
        if callsite std::Option::Some(location) is then
            location self.emit_location
        fi
    }

    fn flush_scalar_stack self:mut$Emitter cache:mut$ScalarStack {
        for index in cache.depth 0 std::Range::new do
            index cache.get_register self.emit_push
        done
        0 = cache.depth: u64
        0 = cache.first: u64
    }

    # Fill below the cached suffix without moving registers that are already
    # live. The circular order gives each stack value a distinct register.
    fn refill_scalar_stack self:mut$Emitter cache:mut$ScalarStack needed:u64 {
        if needed cache.depth <= then
            return
        fi
        needed cache.depth - = missing
        cache.first SCALAR_REGISTER_COUNT + missing - SCALAR_REGISTER_COUNT % = cache.first
        missing = index
        while 0 index < do
            1 -= index
            index cache.get_register self.emit_pop
        done
        needed = cache.depth
    }

    fn reserve_scalar_register self:mut$Emitter cache:mut$ScalarStack -> str {
        if SCALAR_REGISTER_COUNT cache.depth == then
            0 cache.get_register self.emit_push
            cache.first 1 + SCALAR_REGISTER_COUNT % = cache.first
            1 -= cache.depth
        fi
        cache.depth cache.get_register = register
        1 += cache.depth
        register
    }

    # The closure record is in rax. Environment bookkeeping preserves all
    # argument and result registers and restores the caller's active capture set.
    fn emit_execute self:mut$Emitter {
        self.sync_value_stack
        "movq current_env(%rip), %rsi" self.indent
        "movq env_sp(%rip), %rcx" self.indent
        f"cmpq ${RETURN_STACK_SIZE}, %rcx" self.indent_string
        "env_stack_overflow" "jge" self.emit_failure_jump
        "movq %rsi, env_stack(%rcx)" self.indent
        "addq $8, %rcx" self.indent
        "movq %rcx, env_sp(%rip)" self.indent
        "movq %rax, current_env(%rip)" self.indent
        "movq (%rax), %rax" self.indent
        "callq *%rax" self.indent
        "movq env_sp(%rip), %rcx" self.indent
        "subq $8, %rcx" self.indent
        "movq %rcx, env_sp(%rip)" self.indent
        "movq env_stack(%rcx), %rax" self.indent
        "movq %rax, current_env(%rip)" self.indent
    }

    # Transfer a suffix using r8..r11 in bottom-to-top order. All four are
    # caller-clobbered, so only the live values below the arguments are spilled.
    # The same operation normalizes every explicit and implicit return.
    fn prepare_register_transfer self:mut$Emitter cache:mut$ScalarStack count:u64 {
        if cache.depth count > then
            cache.depth count - = lower_count
            for index in lower_count 0 std::Range::new do
                index cache.get_register self.emit_push
            done
            cache.first lower_count + SCALAR_REGISTER_COUNT % = cache.first
            count = cache.depth
        fi
        count cache self.refill_scalar_stack
        for index in count 0 std::Range::new do
            index cache.get_register = source
            index get_scalar_register = target
            if source target != then
                0 = target_index: u64
                while target_index cache.get_register target != do
                    1 += target_index
                done
                target source if target_index count < then "xchgq" else "movq" fi self.emit_binary_registers
                target_index index cache.swap_registers
            fi
        done
        0 = cache.first
        INITIAL_SCALAR_REGISTER_ORDER = cache.order
    }

    fn emit_scalar_or_inst self:mut$Emitter inst:$InstValue cache:mut$ScalarStack is_global:bool {
        inst match
            InstValue::Label(label) | InstValue::MemoryLabel(label) => {
                if self.reachable then
                    label cache self.prepare_join
                else
                    0 label label_key self
                        .join_depths
                        .get_copy
                        .unwrap_or = cache.depth
                    cache.depth label label_key self.join_depths.set
                    0 = cache.first
                    INITIAL_SCALAR_REGISTER_ORDER = cache.order
                    0 = self.stack_offset
                fi
                true = self.reachable
                is_global inst self.emit_inst
                return
            }
            InstValue::Jump(label) => {
                label cache self.prepare_join
                is_global inst self.emit_inst
                false = self.reachable
                return
            }
            _ => {}
        end
        if inst InstValue::FnCall(name) is then
            if name self.register_calls.get_copy std::Option::Some(plan) is then
                plan.arguments cache self.preserve_call_value = preserved
                plan.arguments cache self.prepare_register_transfer
                self.sync_value_stack
                f"call fn_{name.as_str self.function_label}" self.indent_string
                plan.results = cache.depth
                if preserved then
                    cache self.restore_call_value
                fi
                return
            fi
        fi
        if inst InstValue::FnExec(contract) is then
            if contract std::Option::Some(plan) is then
                1 cache self.refill_scalar_stack
                cache.depth 1 - cache.get_register = closure
                "%rax" closure "movq" self.emit_binary_registers
                1 -= cache.depth
                plan.arguments cache self.preserve_call_value = preserved
                plan.arguments cache self.prepare_register_transfer
                self.emit_execute
                plan.results = cache.depth
                if preserved then
                    cache self.restore_call_value
                fi
                return
            fi
        fi
        if self.register_results std::Option::Some(result_count) is then
            if inst InstValue::FnReturn is then
                result_count cache self.prepare_register_transfer
                is_global inst self.emit_inst
                0 = cache.depth
                false = self.reachable
                return
            fi
            if inst InstValue::LocalsInit is inst InstValue::LocalsUninit is || then
                is_global inst self.emit_inst
                return
            fi
        fi
        if cache inst self.emit_scalar_inst ! then
            cache self.flush_scalar_stack
            inst self.get_local_clobbers = clobbers
            if clobbers 0 != then
                clobbers self.save_clobbered_registers
            fi
            is_global inst self.emit_inst
            if clobbers 0 != then
                clobbers self.restore_clobbered_registers
            fi
            if inst InstValue::FnReturn is inst InstValue::JumpTable is || inst InstValue::Panic is || then
                false = self.reachable
            fi
        fi
    }

    # False means no assembly or cache state changed. Existing lowering then
    # receives the complete physical stack, including all cached values.
    fn emit_scalar_inst self:mut$Emitter inst:$InstValue cache:mut$ScalarStack -> bool {
        if inst get_scalar_input_count std::Option::Some(count) is then
            count cache self.refill_scalar_stack
        else
            false return
        fi
        "%r8" = top
        "%r8" = below
        if 0 cache.depth < then
            cache.depth 1 - cache.get_register = top
        fi
        if 1 cache.depth < then
            cache.depth 2 - cache.get_register = below
        fi
        inst match
            InstValue::Push(value) => {
                cache self.reserve_scalar_register = target
                if INT32_MIN value <= INT32_MAX value >= && then
                    f"movq ${value}, {target}" self.indent_string
                else
                    f"movabsq ${value}, {target}" self.indent_string
                fi
            }
            InstValue::PushChar(value) => {
                cache self.reserve_scalar_register = target
                f"movq ${value}, {target}" self.indent_string
            }
            InstValue::PushStr(index) => {
                cache self.reserve_scalar_register = target
                f"leaq str_{index}(%rip), {target}" self.indent_string
            }
            InstValue::LocalGet(index) => {
                cache self.reserve_scalar_register = target
                if index self.find_local_register std::Option::Some(source) is then
                    target source "movq" self.emit_binary_registers
                    true return
                fi
                "    movq " self.asm.append
                index self.emit_local_operand
                ", " self.asm.append
                target self.asm.append
                "" self.line
            }
            InstValue::LocalAddress(index) => {
                cache self.reserve_scalar_register = target
                "    leaq " self.asm.append
                index self.emit_local_operand
                ", " self.asm.append
                target self.asm.append
                "" self.line
            }
            InstValue::LocalSet(index) => {
                if index self.find_local_register std::Option::Some(target) is then
                    target top "movq" self.emit_binary_registers
                    1 -= cache.depth
                    true return
                fi
                "    movq " self.asm.append
                top self.asm.append
                ", " self.asm.append
                index self.emit_local_operand
                "" self.line
                1 -= cache.depth
            }
            InstValue::JumpNe(label) => {
                1 -= cache.depth
                top top "testq" self.emit_binary_registers
                label cache self.prepare_join
                f"jz .L{label}" self.indent_string
            }
            InstValue::Drop => 1 -= cache.depth
            InstValue::Dup => {
                cache self.reserve_scalar_register = target
                target top "movq" self.emit_binary_registers
            }
            InstValue::Over => {
                cache self.reserve_scalar_register = target
                target below "movq" self.emit_binary_registers
            }
            InstValue::Swap => {
                cache.depth 2 - cache.depth 1 - cache.swap_registers
            }
            InstValue::Rot => {
                cache.depth 2 - cache.depth 3 - cache.swap_registers
                cache.depth 1 - cache.depth 2 - cache.swap_registers
            }
            InstValue::Load8 => f"movzbq ({top}), {top}" self.indent_string
            InstValue::Load16 => f"movzwq ({top}), {top}" self.indent_string
            InstValue::Load32 => {
                f"movl ({top}), %eax" self.indent_string
                top "%rax" "movq" self.emit_binary_registers
            }
            InstValue::Load64 => f"movq ({top}), {top}" self.indent_string
            InstValue::Store8 => {
                "%rax" below "movq" self.emit_binary_registers
                f"movb %al, ({top})" self.indent_string
                2 -= cache.depth
            }
            InstValue::Store16 => {
                "%rax" below "movq" self.emit_binary_registers
                f"movw %ax, ({top})" self.indent_string
                2 -= cache.depth
            }
            InstValue::Store32 => {
                "%rax" below "movq" self.emit_binary_registers
                f"movl %eax, ({top})" self.indent_string
                2 -= cache.depth
            }
            InstValue::Store64 => {
                f"movq {below}, ({top})" self.indent_string
                2 -= cache.depth
            }
            InstValue::BitNot => top "notq" self.emit_unary_register
            InstValue::NormalizeInt(builtin) => top builtin self.emit_register_normalization
            InstValue::PushFloat32(value) => {
                cache self.reserve_scalar_register = target
                target common::BuiltinType::F32 value.as_str self.emit_float_literal
            }
            InstValue::PushFloat64(value) => {
                cache self.reserve_scalar_register = target
                target common::BuiltinType::F64 value.as_str self.emit_float_literal
            }
            InstValue::FloatAdd32 | InstValue::FloatAdd64 | InstValue::FloatSub32 | InstValue::FloatSub64 | InstValue::FloatMul32 | InstValue::FloatMul64 | InstValue::FloatDiv32 | InstValue::FloatDiv64 => {
                below top inst self.emit_register_float_binary
                1 -= cache.depth
            }
            # These eligible conversions leave the representation unchanged.
            InstValue::NumericConvert => {}
            InstValue::Not => {
                f"cmpq $0, {top}" self.indent_string
                "sete %al" self.indent
                top "%al" "movzbq" self.emit_binary_registers
            }
            _ => {
                inst match
                    InstValue::Add => below top "addq" self.emit_binary_registers
                    InstValue::Sub => below top "subq" self.emit_binary_registers
                    InstValue::Mul => below top "imulq" self.emit_binary_registers
                    InstValue::CheckedAdd(builtin) => {
                        below top "addq" self.emit_binary_registers
                        "arithmetic_error" if builtin.is_unsigned then "jc" else "jo" fi self.emit_failure_jump
                    }
                    InstValue::CheckedSub(builtin) => {
                        below top "subq" self.emit_binary_registers
                        "arithmetic_error" if builtin.is_unsigned then "jc" else "jo" fi self.emit_failure_jump
                    }
                    InstValue::CheckedMul(builtin) => {
                        if builtin.is_unsigned then
                            "%rax" below "movq" self.emit_binary_registers
                            top "mulq" self.emit_unary_register
                            "testq %rdx, %rdx" self.indent
                            "arithmetic_error" "jnz" self.emit_failure_jump
                            below "%rax" "movq" self.emit_binary_registers
                        else
                            below top "imulq" self.emit_binary_registers
                            "arithmetic_error" "jo" self.emit_failure_jump
                        fi
                    }
                    InstValue::BitAnd => below top "andq" self.emit_binary_registers
                    InstValue::BitOr => below top "orq" self.emit_binary_registers
                    InstValue::BitXor => below top "xorq" self.emit_binary_registers
                    InstValue::And => {
                        top top "testq" self.emit_binary_registers
                        "setne %al" self.indent
                        below below "testq" self.emit_binary_registers
                        "setne %cl" self.indent
                        "andb %cl, %al" self.indent
                        below "%al" "movzbq" self.emit_binary_registers
                    }
                    InstValue::Or => {
                        below top "orq" self.emit_binary_registers
                        "setne %al" self.indent
                        below "%al" "movzbq" self.emit_binary_registers
                    }
                    _ => {
                        inst match
                            InstValue::Eq => "sete"
                            InstValue::Ne => "setne"
                            InstValue::Lt => "setl"
                            InstValue::Le => "setle"
                            InstValue::Gt => "setg"
                            InstValue::Ge => "setge"
                            InstValue::Ult => "setb"
                            InstValue::Ule => "setbe"
                            InstValue::Ugt => "seta"
                            InstValue::Uge => "setae"
                            _ => "Invalid cached scalar operation" panic
                        end = comparison
                        below top "cmpq" self.emit_binary_registers
                        "%al" comparison self.emit_unary_register
                        below "%al" "movzbq" self.emit_binary_registers
                    }
                end
                1 -= cache.depth
            }
        end
        true
    }

    fn emit_syscall self:mut$Emitter arg_count:u64 {
        "%rax" self.emit_pop
        ["%rdi", "%rsi", "%rdx", "%r10", "%r8", "%r9"] = syscall_regs
        for index in arg_count 0 std::Range::new do
            index syscall_regs array::nth self.emit_pop
        done
        "syscall" self.indent
        "%rax" self.emit_push
    }

    # Plans are request-owned. Temporarily move one out to keep its borrow
    # independent of the emitter's mutable output, then restore it for later calls.
    fn emit_extern_call self:mut$Emitter identity:$std::String {
        identity self
            .native_calls
            .remove
            .unwrap = plan
        self.sync_value_stack
        for action in plan.actions.iter do
            action match
                common::NativeAction::Instruction(text) => text.clone self.indent_string
                common::NativeAction::Allocate(size) => {
                    f"movq ${size}, %rdi" self.indent_string
                    "call heap_alloc" self.indent
                }
                common::NativeAction::CheckReturnStack(byte_count) => byte_count self.emit_return_stack_comparison
            end
        done
        plan identity.clone self.native_calls.set
    }

    # Check available return and local stack capacity without lowering rsp.
    # Reading the lowest required word faults in the guard region on overflow.
    fn emit_return_stack_check self:mut$Emitter byte_count:u64 {
        if UNCHECKED_RETURN_STACK_BYTES byte_count >= then
            f"testq %rax, -{byte_count}(%rsp)" self.indent_string
            return
        fi
        byte_count self.emit_return_stack_comparison
    }

    # Larger ranges could skip past the guard region.
    fn emit_return_stack_comparison self:mut$Emitter byte_count:u64 {
        if RETURN_STACK_SIZE byte_count < then
            "jmp return_stack_overflow" self.indent
            return
        fi
        f"cmpq $return_stack+{byte_count}, %rsp" self.indent_string
        "jb return_stack_overflow" self.indent
    }

    # Small reservations rely on the guard region. A frame that overflows faults
    # when it accesses a slot below the return stack or makes a call.
    fn emit_return_stack_reservation self:mut$Emitter byte_count:u64 {
        if UNCHECKED_RETURN_STACK_BYTES byte_count < then
            byte_count self.emit_return_stack_comparison
        fi
        # An oversized frame has already failed. Its frame description still
        # matches the release at each return.
        if RETURN_STACK_SIZE byte_count >= then
            f"subq ${byte_count}, %rsp" self.indent_string
        fi
        f".cfi_adjust_cfa_offset {byte_count}" self.indent_string
    }

    fn emit_copy_bytes self:mut$Emitter size:u64 {
        if SHORT_COPY_LIMIT size < then
            f"movq ${size}, %rcx" self.indent_string
            "rep movsb" self.indent
            return
        fi
        0 = offset: u64
        while 8 size offset - <= do
            f"movq {offset}(%rsi), %rax" self.indent_string
            f"movq %rax, {offset}(%rdi)" self.indent_string
            8 += offset
        done
        while offset size < do
            f"movb {offset}(%rsi), %al" self.indent_string
            f"movb %al, {offset}(%rdi)" self.indent_string
            1 += offset
        done
    }

    fn emit_move_bytes self:mut$Emitter size:u64 {
        "%rdi" self.emit_pop
