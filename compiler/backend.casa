        semantic_body::PrimitiveKind::BitAnd => InstValue::BitAnd std::Option::Some
        semantic_body::PrimitiveKind::BitNot => InstValue::BitNot std::Option::Some
        semantic_body::PrimitiveKind::BitOr => InstValue::BitOr std::Option::Some
        semantic_body::PrimitiveKind::BitXor => InstValue::BitXor std::Option::Some
        semantic_body::PrimitiveKind::Div => InstValue::Div std::Option::Some
        semantic_body::PrimitiveKind::Drop => InstValue::Drop std::Option::Some
        semantic_body::PrimitiveKind::Dup => InstValue::Dup std::Option::Some
        semantic_body::PrimitiveKind::Eq => InstValue::Eq std::Option::Some
        semantic_body::PrimitiveKind::Ge => InstValue::Ge std::Option::Some
        semantic_body::PrimitiveKind::Gt => InstValue::Gt std::Option::Some
        semantic_body::PrimitiveKind::Le => InstValue::Le std::Option::Some
        semantic_body::PrimitiveKind::Lt => InstValue::Lt std::Option::Some
        semantic_body::PrimitiveKind::Mod => InstValue::Mod std::Option::Some
        semantic_body::PrimitiveKind::Mul => InstValue::Mul std::Option::Some
        semantic_body::PrimitiveKind::Ne => InstValue::Ne std::Option::Some
        semantic_body::PrimitiveKind::Over => InstValue::Over std::Option::Some
        semantic_body::PrimitiveKind::PrintInt => InstValue::PrintInt std::Option::Some
        semantic_body::PrimitiveKind::Shl => InstValue::Shl std::Option::Some
        semantic_body::PrimitiveKind::Shr => InstValue::Shr std::Option::Some
        semantic_body::PrimitiveKind::Sub => InstValue::Sub std::Option::Some
        _ => std::Option[InstValue]::None
    end
}

fn intrinsic_to_inst value:$semantic_body::IntrinsicKind -> std::Option[InstValue] {
    value match
        semantic_body::IntrinsicKind::And => InstValue::And std::Option::Some
        semantic_body::IntrinsicKind::FnReturn => InstValue::FnReturn std::Option::Some
