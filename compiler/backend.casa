        semantic_body::IntrinsicKind::PrintBool => InstValue::PrintBool std::Option::Some
        semantic_body::IntrinsicKind::PrintChar => InstValue::PrintChar std::Option::Some
        semantic_body::IntrinsicKind::PrintCstr => InstValue::PrintCstr std::Option::Some
        semantic_body::IntrinsicKind::PrintStr => InstValue::PrintStr std::Option::Some
        semantic_body::IntrinsicKind::PrintString => InstValue::PrintString std::Option::Some
        semantic_body::IntrinsicKind::Rot => InstValue::Rot std::Option::Some
        semantic_body::IntrinsicKind::Store8 => InstValue::Store8 std::Option::Some
        semantic_body::IntrinsicKind::Store16 => InstValue::Store16 std::Option::Some
        semantic_body::IntrinsicKind::Store32 => InstValue::Store32 std::Option::Some
        semantic_body::IntrinsicKind::Store64 => InstValue::Store64 std::Option::Some
        semantic_body::IntrinsicKind::Swap => InstValue::Swap std::Option::Some
        semantic_body::IntrinsicKind::Syscall0 => InstValue::Syscall0 std::Option::Some
        semantic_body::IntrinsicKind::Syscall1 => InstValue::Syscall1 std::Option::Some
        semantic_body::IntrinsicKind::Syscall2 => InstValue::Syscall2 std::Option::Some
        semantic_body::IntrinsicKind::Syscall3 => InstValue::Syscall3 std::Option::Some
