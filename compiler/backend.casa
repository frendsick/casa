# Plans structured checked bodies and selects one physical function at a time.
import "std" as std
import "abi" as abi
import "common" as common
import "pattern" as pattern
import "semantic_body" as semantic_body
import "error" as error
import "typechecker" as typechecker
import "runtime" as runtime
import "lexer" as lexer

pub struct BytecodeFailure {
    pub message: std::String
}

impl BytecodeFailure {
    fn new message:std::String -> BytecodeFailure { message BytecodeFailure }
}

pub enum AssemblyError {
    Rejected(error::Diagnostics)
    Internal(BytecodeFailure)
}

const ENUM_DISPATCH_MIN_ARMS 4
const SHORT_COPY_LIMIT 64
const AUTOMATIC_AGGREGATE_BYTES: u64 4096

# A recursive destruction worker starts with a frame buffer for 16 two-word
# continuations, so shallow values do not allocate. Growth moves them to a heap
# buffer of twice the capacity. Only the frame buffer has this capacity.
const CONTINUATION_BUFFER_BYTES: u64 256
const CONTINUATION_GROWTH_FUNCTION "__destruction_continuations grow"

enum StorageKind derives std::Copy {
    Heap
    Local
}

enum FunctionWork {
    Checked(std::String)
    Destruction(std::String common::Type StorageKind)
    RecursiveDestruction(std::String std::List[DestructionNode])
    ContinuationGrowth(std::String)
    ClosureDestruction(std::String std::String)
}

# One generated destruction function, including a concrete closure record.
enum DestructionNode derives std::Clone {
    Value(common::Type StorageKind)
    Closure(std::String)
}

impl DestructionNode {
    fn get_name self:$DestructionNode -> std::String {
        self match
            DestructionNode::Value(typ storage) => storage copy typ destruction_function_name
            DestructionNode::Closure(name) => f"__drop_closure_{name}"
        end
    }
}

# Frame slots of a recursive destruction worker's continuation buffer.
struct ContinuationSlots derives std::Copy {
    buffer:   u64
    length:   u64
    capacity: u64
}

# A worker destroys every member of one recursive destruction cycle in a
# single frame. `starts` maps each member's destruction function name to its
# body label, and `resumes` lists the label of each continuation by its id.
struct RecursiveDestruction {
    starts:   std::Map[std::String u64]
    resumes:  std::List[u64]
    slots:    ContinuationSlots
    closures: std::List[std::String]
}

struct BackendPlanner {
    store:         $common::SymbolStore
    checked:       $typechecker::CheckedProgram
    program:       Emitter
    pending:       std::List[FunctionWork]
    failure:       std::Option[BytecodeFailure]
    label_counter: u64
    layouts:       common::LayoutPlanner
    closures:      std::Map[std::String std::List[std::String]]
}

struct EnumDispatch {
    labels:      std::List[u64]
    targets:     std::List[u64]
    fallback:    u64
    has_payload: bool
}

struct LoopTargets {
    start: u64
    exit:  u64
}

struct FunctionPlanner {
    loop_targets:          std::List[LoopTargets]
    function:              std::Option[$common::Function]
    local_slots:           std::Map[std::String u64]
    capture_slots:         std::Map[std::String u64]
    locals_count:          u64
    state:                 mut$BackendPlanner
    owner_flags:           std::Map[std::String u64]
    result_slot:           std::Option[u64]
    recursive_destruction: std::Option[RecursiveDestruction]
}

struct ResolvedStructField {
    storage: common::FieldStoragePlan
    typ:     common::Type
}

fn resolve_struct_field
    member:$common::StructMemberAccess
    store:$common::SymbolStore
    typ:$common::Type
    owner:$common::Type
    layouts:mut$common::LayoutPlanner
-> std::Option[ResolvedStructField] {
    if member.struct_name store.structs.get std::Option::Some(declaration) is then
        if store owner common::type_has_copy_layout then
            declaration owner common::copy_storage_struct
        else
            declaration.clone
        fi = casa_struct
        if member.member_index casa_struct.members.length < then
            if
                member.member_index casa_struct layouts.plan_struct_member
                std::Option::Some(storage) is
            then
                typ.clone storage.clone ResolvedStructField std::Option::Some return
            fi
        fi
    fi
    std::Option[ResolvedStructField]::None
}

impl BackendPlanner {
    fn new checked:$typechecker::CheckedProgram sources:$lexer::SourceStore -> BackendPlanner {
        checked.get_store = store
        # Any capturing function with this checked stack effect can inhabit a
        # function value. Index all of them before planning destruction cycles.
        std::Map[std::String std::List[std::String]]::new = closures
        for name in checked.get_function_names.iter do
            name.as_str store.get_function.unwrap = function
            if function.captures.is_empty then
                continue
            fi
            function.stack_effect common::stack_effect_to_function_type.format = key
            if key closures.get_mut std::Option::Some(names) is then
                name.clone names.push
            else
                std::List[std::String]::new = names
                name.clone names.push
                names key closures.set
            fi
        done
        closures
        store common::LayoutPlanner::new
        0
        std::Option[BytecodeFailure]::None
        std::List[FunctionWork]::new
        sources Emitter::new
        checked
        store
        BackendPlanner
    }

    fn into_result self:BackendPlanner -> std::Result[std::String AssemblyError] {
        self match
            BackendPlanner { program: program failure: failure } => {
                failure match
                    std::Option::Some(problem) => problem AssemblyError::Internal std::Result::Error
                    std::Option::None => program.finish match
                        std::Result::Ok(assembly) => assembly std::Result::Ok
                        std::Result::Error(message) => message BytecodeFailure::new AssemblyError::Internal std::Result::Error
                    end
                end
            }
        end
    }
}

impl FunctionPlanner {
    fn new state:mut$BackendPlanner -> FunctionPlanner {
        state.layouts state.checked state.store.variables index_root_variable_map = locals_count = local_slots
        std::Option[RecursiveDestruction]::None
        std::Option[u64]::None
        std::Map[std::String u64]::new
        state
        locals_count
        std::Map[std::String u64]::new
        local_slots
        std::Option[$common::Function]::None
        std::List[LoopTargets]::new
        FunctionPlanner
    }

    fn for_function state:mut$BackendPlanner function:$common::Function -> FunctionPlanner {
        state.layouts state.checked function.variables index_local_variable_list = locals_count = local_slots
        std::Option[RecursiveDestruction]::None
        std::Option[u64]::None
        std::Map[std::String u64]::new
        state
        locals_count
        function.captures index_variable_list
        local_slots
        function std::Option::Some
        std::List[LoopTargets]::new
        FunctionPlanner
    }

    fn record_failure_string self:mut$FunctionPlanner message:std::String {
        if
            self
                .state
                .failure
                .is_none
        then
            message BytecodeFailure::new std::Option::Some = self.state.failure
        fi
    }

    fn record_failure self:mut$FunctionPlanner message:$str {
        message.to_str self.record_failure_string
    }

    fn has_failed self:mut$FunctionPlanner -> bool {
        self
            .state
            .failure
            .is_some
    }

    fn emit_field_load
        compiler:mut$FunctionPlanner
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[InstValue]
    {
        if plan.stores_inline then
            bytecode declared_type compiler.emit_typed_load
        else
            InstValue::Load64 bytecode.push
            if declared_type compiler.uses_automatic_storage then
                bytecode declared_type compiler.emit_inline_copy
            fi
        fi
    }

    fn emit_field_projection
        compiler:mut$FunctionPlanner
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[InstValue]
    {
        if plan.stores_inline ! then
            InstValue::Load64 bytecode.push
            return
        fi
        if
            compiler.state.store declared_type common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation != then
                bytecode declared_type compiler.emit_typed_load
            fi
        else
            f"Cannot determine field representation of `{declared_type.format}`" compiler.record_failure_string
        fi
    }

    fn emit_field_store
        compiler:mut$FunctionPlanner
        declared_type:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[InstValue]
    {
        if plan.stores_inline then
            bytecode declared_type compiler.emit_typed_store
        else
            if declared_type.has_unresolved_type_var ! then
                if declared_type compiler.uses_automatic_storage then
                    InstValue::Swap bytecode.push
                    bytecode declared_type compiler.emit_heap_copy
                    InstValue::Swap bytecode.push
                fi
            fi
            InstValue::Store64 bytecode.push
        fi
    }

    # Consume a field address above its owner. Inline bodies belong to the
    # containing allocation, so they are destroyed in place. C-compatible
    # bodies have no resources.
    fn compile_field_destruction
        compiler:mut$FunctionPlanner
        typ:$common::Type
        plan:$common::FieldStoragePlan
        bytecode:mut$std::List[InstValue]
    {
        if typ compiler.is_copy_aggregate then
            if plan.stores_inline then
                InstValue::Drop bytecode.push
            else
                InstValue::Load64 bytecode.push
                InstValue::HeapFree bytecode.push
            fi
            return
        fi
        if plan.stores_inline compiler.state.store typ common::type_has_trivial_c_field_layout && then
            InstValue::Drop bytecode.push
            return
        fi
        bytecode plan typ compiler.emit_field_projection
        if plan.stores_inline then
            StorageKind::Local
        else
            StorageKind::Heap
        fi = storage
        std::List[u64]::new = no_locals
        bytecode no_locals true storage typ compiler.compile_child_destruction
    }

    fn get_struct_field_plan
        compiler:mut$FunctionPlanner
        casa_struct:$common::CasaStruct
        member_index:u64
    -> common::FieldStoragePlan {
        if
            member_index casa_struct compiler
                .state
                .layouts
                .plan_struct_member
            std::Option::Some(plan) is
        then
            plan.clone return
        fi
        f"Cannot determine member {member_index} storage of struct `{casa_struct.name}`"
        compiler.record_failure_string
        false 0 1 0 common::FieldStoragePlan
    }

    fn get_enum_field_plan
        compiler:mut$FunctionPlanner
        casa_enum:$common::CasaEnum
        variant_name:$str
        payload_index:u64
    -> common::FieldStoragePlan {
        if
            payload_index variant_name casa_enum
            compiler
                .state
                .layouts
                .plan_enum_payload std::Option::Some(plan) is
        then
            plan.clone return
        fi
        f"Cannot determine payload {payload_index} storage of `{casa_enum.name}::{variant_name}`"
        compiler.record_failure_string
        false 0 1 0 common::FieldStoragePlan
    }
}

# Label management
impl BackendPlanner {
    fn new_label self:mut$BackendPlanner -> u64 {
        self.label_counter = value
        1 += self.label_counter
        value
    }
}

impl FunctionPlanner {
    fn new_label self:mut$FunctionPlanner -> u64 { self.state.new_label }
}

# String interning
impl FunctionPlanner {
    fn intern_string compiler:mut$FunctionPlanner value:$str -> u64 {
        value compiler
            .state
            .program
            .intern_string
    }
}

# Variable resolution
fn index_variable_list variables:$std::List[common::Variable] -> std::Map[std::String u64] {
    std::Map[std::String u64]::new = slots
    0 = index: u64
    for variable in variables.iter do
        if variable.name slots.has ! then
            index variable.name.clone slots.set
        fi
        1 += index
    done
    slots
}

# Standalone aggregates use automatic storage across Casa calls. Recursive
# edges and indirect fields keep their existing independently owned allocations.
fn uses_automatic_storage
    typ:$common::Type
    checked:$typechecker::CheckedProgram
    layouts:mut$common::LayoutPlanner
-> bool {
    if typ common::Type::Generic is ! then
        false return
    fi
    typ checked.get_shape match
        typechecker::CheckedShape::Struct | typechecker::CheckedShape::Enum => {
            if
                checked.get_store typ common::type_value_representation.unwrap common::VALUE_REPR_INDIRECT !=
            then
                false return
            fi
            # Keep large affine bodies on the heap instead of forcing a return
            # stack overflow. Copy retains its allocation-free representation.
            if typ layouts.inline_size std::Option::Some(size) is else
                # Native-call planning reports unsupported or overflowing layouts.
                false return
            fi
            if size AUTOMATIC_AGGREGATE_BYTES <= then
                true return
            fi
            typ checked.is_copy_aggregate
        }
        typechecker::CheckedShape::Array => typ checked.is_copy_aggregate
        _ => false
    end
}

fn uses_inline_local_storage
    typ:$common::Type
    checked:$typechecker::CheckedProgram
    layouts:mut$common::LayoutPlanner
-> bool {
    typ common::get_concrete_array_length.is_some layouts checked typ uses_automatic_storage ||
}

fn local_variable_slot_width
    variable:$common::Variable
    checked:$typechecker::CheckedProgram
    layouts:mut$common::LayoutPlanner
-> u64 {
    if layouts checked variable.typ uses_inline_local_storage then
        if variable.typ layouts.inline_size std::Option::Some(size) is then
            size common::WORD_SIZE u64::try_from.unwrap 1 - +
            common::WORD_SIZE u64::try_from.unwrap / return
        fi
    fi
    1
}

fn index_local_variable_list
    variables:$std::List[common::Variable]
    checked:$typechecker::CheckedProgram
    layouts:mut$common::LayoutPlanner
-> std::Map[std::String u64] u64 {
    std::Map[std::String u64]::new = slots
    0 = next_slot: u64
    for variable in variables.iter do
        if variable.name slots.has ! then
            layouts checked variable local_variable_slot_width = width
            next_slot width + 1 - variable.name.clone slots.set
            width += next_slot
        fi
    done
    slots next_slot
}

fn index_root_variable_map
    variables:$std::Map[std::String common::Variable]
    checked:$typechecker::CheckedProgram
    layouts:mut$common::LayoutPlanner
-> std::Map[std::String u64] u64 {
    std::Map[std::String u64]::new = slots
    variables.keys = names
    0 = next_slot: u64
    for name in names.iter do
        if name.as_str variables.get_str std::Option::Some(variable) is then
            layouts checked variable local_variable_slot_width = width
            next_slot width + 1 - name.clone slots.set
            width += next_slot
        fi
    done
    slots next_slot
}

impl FunctionPlanner {
    fn allocate_local compiler:mut$FunctionPlanner -> u64 {
        compiler.locals_count = local_index
        1 += compiler.locals_count
        local_index
    }

    fn resolve_local compiler:mut$FunctionPlanner variable_name:$str -> u64 {
        if variable_name compiler.local_slots.get_copy_str std::Option::Some(local_index) is then
            local_index return
        fi
        if compiler.function std::Option::Some(function) is then
            f"Variable `{variable_name}` is missing while compiling `{function.name}`"
            compiler.record_failure_string
        else
            f"Variable `{variable_name}` is missing during bytecode compilation"
            compiler.record_failure_string
        fi
        0
    }

    fn binding_is_borrow self:mut$FunctionPlanner name:$str -> bool {
        if self.function std::Option::Some(function) is then
            for variable in function.variables.iter do
                if variable.name.as_str name == then
                    variable.typ.is_borrow return
                fi
            done
        elif
            name self
                .state
                .store
                .variables
                .get_str std::Option::Some(variable) is
        then
            variable.typ.is_borrow return
        fi
        false
    }

    # An f-string expression reads an outer generic owner at a borrow type.
    # When specialization selects scalar storage, the read lends the owner's
    # address, as a call borrow does. Only function locals need this: root
    # bindings are concrete, and a closure cannot use generic bounds yet, so it
    # cannot interpolate a generic capture. Lend captured scalars here once
    # closures inherit bounds.
    fn lends_owned_scalar self:mut$FunctionPlanner name:$str typ:$common::Type -> bool {
        if typ.borrow_target std::Option::Some(target) is then
            if self.state.store target common::type_has_scalar_storage ! then
                false return
            fi
        else
            false return
        fi
        if self.function std::Option::Some(function) is then
            for variable in function.variables.iter do
                if variable.name.as_str name == then
                    variable.typ.is_borrow ! return
                fi
            done
        fi
        false
    }

    fn find_local_inline_aggregate_type
        self:mut$FunctionPlanner
        variable_name:$str
    -> std::Option[common::Type] {
        self.state.checked = checked
        if self.function std::Option::Some(function) is then
            for variable in function.variables.iter do
                if variable.name.as_str variable_name == then
                    if self.state.layouts checked variable.typ uses_inline_local_storage then
                        variable.typ.clone std::Option::Some return
                    fi
                fi
            done
        elif
            variable_name self
                .state
                .store
                .variables
                .get_str std::Option::Some(variable) is
        then
            if self.state.layouts checked variable.typ uses_inline_local_storage then
                variable.typ.clone std::Option::Some return
            fi
        fi
        std::Option[common::Type]::None
    }

    fn emit_variable_get
        compiler:mut$FunctionPlanner
        variable_name:$str
        move_owned:bool
        bytecode:mut$std::List[InstValue]
    {
        variable_name compiler.resolve_local = local_index
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            local_index InstValue::LocalAddress bytecode.push
            if move_owned then
                bytecode aggregate_type compiler.emit_typed_load
            fi
            return
        fi
        local_index InstValue::LocalGet bytecode.push
    }

    fn emit_variable_set
        compiler:mut$FunctionPlanner
        variable_name:$str
        bytecode:mut$std::List[InstValue]
    {
        variable_name compiler.resolve_local = local_index
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            local_index InstValue::LocalAddress bytecode.push
            bytecode aggregate_type compiler.emit_typed_store
            return
        fi
        local_index InstValue::LocalSet bytecode.push
    }
}

# A separator outside source identifiers keeps local_Value's heap destructor
# distinct from Value's local destructor.
fn destruction_function_name typ:$common::Type storage_kind:StorageKind -> std::String {
    typ.format = type_name
    storage_kind match
        StorageKind::Heap => f"__drop_{type_name}"
        StorageKind::Local => f"__drop_local {type_name}"
    end
}

# Deterministic destruction
impl FunctionPlanner {
    fn is_copy_aggregate self:$FunctionPlanner typ:$common::Type -> bool {
        typ self
            .state
            .checked
            .is_copy_aggregate
    }

    fn uses_automatic_storage self:mut$FunctionPlanner typ:$common::Type -> bool {
        self.state.checked = checked
        self.state.layouts checked typ uses_automatic_storage
    }

    fn value_storage self:mut$FunctionPlanner typ:$common::Type -> StorageKind {
        if typ self.uses_automatic_storage then
            StorageKind::Local
        else
            StorageKind::Heap
        fi
    }

    fn finish_destruction
        self:mut$FunctionPlanner
        storage_kind:StorageKind
        bytecode:mut$std::List[InstValue]
    {
        storage_kind match
            StorageKind::Heap => InstValue::HeapFree bytecode.push
            StorageKind::Local => InstValue::Drop bytecode.push
        end
    }

    fn compile_drop_hook
        compiler:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if
            typ compiler
                .state
                .checked
                .find_drop_function std::Option::Some(drop_name) is
        then
            drop_name.clone = function_name
            InstValue::Dup bytecode.push
            if function_name.as_str compiler.compile_named_function then
                function_name InstValue::FnCall bytecode.push
            fi
        fi
    }

    # Destroy every element of an `array[T N]` value. The array stores nothing
    # but its elements, so the element count comes from the type (ADR-0152).
    fn compile_array_destruction
        compiler:mut$FunctionPlanner
        element_type:$common::Type
        length:$common::ConstType
        bytecode:mut$std::List[InstValue]
    {
        compiler.allocate_local = array_local
        compiler.allocate_local = index_local
        array_local InstValue::LocalSet bytecode.push
        length.value InstValue::Push bytecode.push
        index_local InstValue::LocalSet bytecode.push

        compiler.new_label = start_label
        compiler.new_label = element_label
        compiler.new_label = end_label
        start_label InstValue::Label bytecode.push
        index_local InstValue::LocalGet bytecode.push
        0 InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        element_label InstValue::JumpNe bytecode.push
        end_label InstValue::Jump bytecode.push
        element_label InstValue::Label bytecode.push
        index_local InstValue::LocalGet bytecode.push
        1 InstValue::Push bytecode.push
        InstValue::Sub bytecode.push
        index_local InstValue::LocalSet bytecode.push
        array_local InstValue::LocalGet bytecode.push
        index_local InstValue::LocalGet bytecode.push
        bytecode element_type compiler.emit_inline_size
        InstValue::Mul bytecode.push
        InstValue::Add bytecode.push
        # Destroy an automatic-storage element in place. A copy would occupy
        # frame storage that a recursive destruction worker reuses for nested
        # elements while this element's continuation is pending.
        if element_type compiler.uses_automatic_storage ! then
            bytecode element_type compiler.emit_typed_load
        fi
        std::List[u64]::new = saved_locals
        array_local saved_locals.push
        index_local saved_locals.push
        element_type compiler.value_storage = storage
        bytecode saved_locals false storage element_type compiler.compile_child_destruction
        start_label InstValue::Jump bytecode.push
        end_label InstValue::Label bytecode.push
        array_local InstValue::LocalGet bytecode.push
    }

    fn compile_struct_fields
        compiler:mut$FunctionPlanner
        typ:$common::Type
        casa_struct:$common::CasaStruct
        skipped:mut$std::List[std::String]
        bytecode:mut$std::List[InstValue]
        storage_kind:StorageKind
    {
        casa_struct.type_vars typ common::aggregate_type_bindings = substitutions
        casa_struct.members.length = member_index
        while 0 member_index != do
            1 -= member_index
            member_index casa_struct.members.get = member
            substitutions member.typ.substitute = member_type
            if
                member.name.as_str skipped common::string_list_contains member_type compiler.is_copy_aggregate ! &&
            then
                continue
            fi
            if
                member_type compiler
                    .state
                    .checked
                    .needs_destruction !
            then
                continue
            fi
            InstValue::Dup bytecode.push
            member_index casa_struct compiler.get_struct_field_plan = plan
            if 0 plan.offset != then
                plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::Add bytecode.push
            fi
            bytecode plan member_type compiler.compile_field_destruction
        done
        bytecode storage_kind compiler.finish_destruction
    }

    fn compile_enum_variant_fields
        compiler:mut$FunctionPlanner
        typ:$common::Type
        casa_enum:$common::CasaEnum
        variant_name:$str
        skipped_count:u64
        bytecode:mut$std::List[InstValue]
        storage_kind:StorageKind
    {
        casa_enum.type_vars typ common::aggregate_type_bindings = substitutions
        if variant_name casa_enum.variant_types.get_str std::Option::Some(payload_types) is then
            payload_types.length = payload_index
            while 0 payload_index != do
                1 -= payload_index
                substitutions payload_index payload_types.get.substitute = payload_type
                if skipped_count payload_index > payload_type compiler.is_copy_aggregate ! && then
                    continue
                fi
                if
                    payload_type compiler
                        .state
                        .checked
                        .needs_destruction !
                then
                    continue
                fi
                InstValue::Dup bytecode.push
                payload_index variant_name casa_enum compiler.get_enum_field_plan = plan
                plan.offset i64::try_from.unwrap
                InstValue::Push bytecode.push
                InstValue::Add bytecode.push
                bytecode plan payload_type compiler.compile_field_destruction
            done
        fi
        bytecode storage_kind compiler.finish_destruction
    }

    fn compile_enum_fields
        compiler:mut$FunctionPlanner
        typ:$common::Type
        casa_enum:$common::CasaEnum
        bytecode:mut$std::List[InstValue]
        storage_kind:StorageKind
    {
        compiler.allocate_local = enum_local
        enum_local InstValue::LocalSet bytecode.push
        compiler.new_label = end_label
        std::List[u64]::new = labels
        for _variant in casa_enum.variants.iter do
            compiler.new_label labels.push
        done
        enum_local InstValue::LocalGet bytecode.push
        InstValue::Load64 bytecode.push
        end_label labels.clone InstValue::JumpTable bytecode.push
        0 = variant_index: u64
        for variant_name in casa_enum.variants.iter do
            variant_index labels.get copy InstValue::Label bytecode.push
            enum_local InstValue::LocalGet bytecode.push
            storage_kind bytecode 0 variant_name.as_str casa_enum typ compiler.compile_enum_variant_fields
            end_label InstValue::Jump bytecode.push
            1 += variant_index
        done
        end_label InstValue::Label bytecode.push
    }

    fn compile_destruction_body
        compiler:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
        storage_kind:StorageKind
    {
        if
            typ compiler
                .state
                .checked
                .has_plain_storage
        then
            bytecode typ compiler.compile_drop_hook
            bytecode storage_kind compiler.finish_destruction
            return
        fi
        typ compiler
            .state
            .checked
            .get_shape = shape
        if shape typechecker::CheckedShape::Borrow is then
            InstValue::Drop bytecode.push return
        fi
        if shape typechecker::CheckedShape::Closure is then
            bytecode compiler.compile_closure_dispatch return
        fi
        if typ compiler.is_copy_aggregate then
            InstValue::Drop bytecode.push return
        fi
        bytecode typ compiler.compile_drop_hook
        shape match
            typechecker::CheckedShape::Array => {
                typ common::get_array_length_parameter.unwrap = length
                typ.array_element_type.unwrap = element_type
                bytecode length element_type compiler.compile_array_destruction
                bytecode storage_kind compiler.finish_destruction
            }
            typechecker::CheckedShape::Struct => {
                typ.match_base = name
                name compiler
                    .state
                    .store
                    .structs
                    .get
                    .unwrap = struct_declaration
                std::List[std::String]::new = skipped
                storage_kind bytecode skipped struct_declaration typ compiler.compile_struct_fields
            }
            typechecker::CheckedShape::Enum => {
                typ.match_base = name
                name compiler
                    .state
                    .store
                    .enums
                    .get
                    .unwrap = enum_declaration
                if enum_declaration common::has_inner_values then
                    storage_kind bytecode enum_declaration typ compiler.compile_enum_fields
                else
                    InstValue::Drop bytecode.push
                fi
            }
            _ => InstValue::Drop bytecode.push
        end
    }

    fn destruction_needs_function compiler:mut$FunctionPlanner typ:$common::Type -> bool {
        typ compiler
            .state
            .checked
            .needs_destruction
    }

    fn ensure_destruction_function
        compiler:mut$FunctionPlanner
        typ:$common::Type
        storage_kind:StorageKind
    -> std::String {
        storage_kind typ destruction_function_name = function_name
        if
            function_name compiler
                .state
                .program
                .functions
                .has
        then
            function_name return
        fi
        function_name.as_str compiler
            .state
            .program
            .register_function
        storage_kind typ.clone function_name.clone FunctionWork::Destruction compiler
            .state
            .pending
            .push
        function_name
    }

    fn compile_destruction
        self:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        typ self.value_storage bytecode typ self.compile_destruction_in_storage
    }

    fn compile_destruction_in_storage
        compiler:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
        storage_kind:StorageKind
    {
        if typ compiler.destruction_needs_function ! then
            InstValue::Drop bytecode.push
            return
        fi
        if
            typ compiler
                .state
                .checked
                .has_plain_storage
        then
            bytecode typ compiler.compile_drop_hook
            bytecode storage_kind compiler.finish_destruction
            return
        fi
        storage_kind typ compiler.ensure_destruction_function = function_name
        function_name InstValue::FnCall bytecode.push
    }

    # Record a call that `compile_destruction_in_storage` makes to destroy `typ`.
    fn push_destruction_child
        compiler:mut$FunctionPlanner
        typ:$common::Type
        storage_kind:StorageKind
        children:mut$std::List[DestructionNode]
    {
        if typ compiler.destruction_needs_function ! then
            return
        fi
        if
            typ compiler
                .state
                .checked
                .has_plain_storage
        then
            return
        fi
        storage_kind typ.clone DestructionNode::Value children.push
    }

    # Record a call that `compile_field_destruction` makes to destroy a field.
    fn push_field_destruction_child
        compiler:mut$FunctionPlanner
        typ:$common::Type
        plan:$common::FieldStoragePlan
        children:mut$std::List[DestructionNode]
    {
        if typ compiler.is_copy_aggregate then
            return
        fi
        if plan.stores_inline compiler.state.store typ common::type_has_trivial_c_field_layout && then
            return
        fi
        if plan.stores_inline then
            StorageKind::Local
        else
            StorageKind::Heap
        fi = storage
        children storage typ compiler.push_destruction_child
    }

    # List the destruction functions that `compile_destruction_body` calls for
    # `typ`. Keep it in step with that body. A missing call keeps destruction
    # correct but lets that call nest on the return stack.
    fn destruction_children
        compiler:mut$FunctionPlanner
        typ:$common::Type
    -> std::List[DestructionNode] {
        std::List[DestructionNode]::new = children
        if
            typ compiler
                .state
                .checked
                .has_plain_storage typ compiler.is_copy_aggregate ||
        then
            children return
        fi
        typ compiler
            .state
            .checked
            .get_shape match
            typechecker::CheckedShape::Closure => {
                typ.format = key
                if
                    key compiler
                        .state
                        .closures
                        .get std::Option::Some(names) is
                then
                    for name in names.iter do
                        name.clone DestructionNode::Closure children.push
                    done
                fi
            }
            typechecker::CheckedShape::Array => {
                typ.array_element_type.unwrap = element_type
                element_type compiler.value_storage = storage
                children storage element_type compiler.push_destruction_child
            }
            typechecker::CheckedShape::Struct => {
                typ.match_base = name
                name compiler
                    .state
                    .store
                    .structs
                    .get
                    .unwrap = casa_struct
                casa_struct.type_vars typ common::aggregate_type_bindings = substitutions
                for member_index in casa_struct.members.length 0 std::Range::new do
                    member_index casa_struct.members.get = member
                    substitutions member.typ.substitute = member_type
                    member_index casa_struct compiler.get_struct_field_plan = plan
                    children plan member_type compiler.push_field_destruction_child
                done
            }
            typechecker::CheckedShape::Enum => {
                typ.match_base = name
                name compiler
                    .state
                    .store
                    .enums
                    .get
                    .unwrap = casa_enum
                casa_enum.type_vars typ common::aggregate_type_bindings = substitutions
                for variant_name in casa_enum.variants.iter do
                    if variant_name.as_str casa_enum.variant_types.get_str std::Option::Some(payload_types) is then
                        for payload_index in payload_types.length 0 std::Range::new do
                            substitutions payload_index payload_types.get.substitute = payload_type
                            payload_index variant_name.as_str casa_enum compiler.get_enum_field_plan = plan
                            children plan payload_type compiler.push_field_destruction_child
                        done
                    fi
                done
            }
            _ => {}
        end
        children
    }

    fn destruction_node_children
        compiler:mut$FunctionPlanner
        node:$DestructionNode
    -> std::List[DestructionNode] {
        node match
            DestructionNode::Value(typ _) => typ compiler.destruction_children
            DestructionNode::Closure(name) => {
                std::List[DestructionNode]::new = children
                name.as_str compiler
                    .state
                    .store
                    .get_function
                    .unwrap = lambda
                for capture in lambda.captures.iter do
                    if capture.name.as_str lambda.owned_captures common::string_list_contains then
                        # Copy captures only release their backing allocation.
                        if capture.typ compiler.is_copy_aggregate ! then
                            children StorageKind::Heap capture.typ compiler.push_destruction_child
                        fi
                    fi
                done
                children
            }
        end
    }

    # Return the destruction cycle that contains `root`, ordered by function
    # name, or no nodes when destroying `root` never destroys another `root`.
    fn recursive_destruction_nodes
        compiler:mut$FunctionPlanner
        root:$DestructionNode
    -> std::List[DestructionNode] {
        root.get_name = root_name
        std::Map[std::String DestructionNode]::new = nodes
        std::Map[std::String std::List[std::String]]::new = edges
        std::List[DestructionNode]::new = pending
        root.clone pending.push
        while pending.is_empty ! do
            pending.pop = node
            node.get_name = name
            if name nodes.has then
                continue
            fi
            std::List[std::String]::new = child_names
            for child in node compiler.destruction_node_children.iter do
                child.get_name child_names.push
                child.clone pending.push
            done
            child_names name.clone edges.set
            node name nodes.set
        done

        # Collect the reachable nodes that reach the root until none is added.
        std::Set[std::String]::new = cycle
        nodes.keys = names
        &does_function_name_precede names.sort_by
        true = changed
        while changed do
            false = changed
            for name in names.iter do
                if name cycle.has then
                    continue
                fi
                for
                    child_name in name edges
                        .get
                        .unwrap
                        .iter
                do
                    if child_name root_name == child_name cycle.has || then
                        name.clone cycle.add
                        true = changed
                        break
                    fi
                done
            done
        done

        std::List[DestructionNode]::new = members
        if root_name cycle.has then
            for name in names.iter do
                if name cycle.has then
                    name nodes
                        .get
                        .unwrap
                        .clone members.push
                fi
            done
        fi
        members
    }

    # Compile a destruction function body. A member of a recursive destruction
    # cycle enters the cycle's shared worker, so its depth does not consume the
    # return stack. Other types keep the direct body.
    fn compile_destruction_entry
        compiler:mut$FunctionPlanner
        root:$DestructionNode
        bytecode:mut$std::List[InstValue]
    {
        root compiler.recursive_destruction_nodes = nodes
        if nodes.is_empty then
            bytecode root compiler.compile_destruction_node
            return
        fi
        root.get_name = root_name
        0 = entry: u64
        for node in nodes.iter do
            if node.get_name root_name == then
                break
            fi
            1 += entry
        done
        0 nodes.get = first
        first.get_name = first_name
        f"__drop_recursive {first_name}" = worker
        if
            worker compiler
                .state
                .program
                .functions
                .has !
        then
            worker.as_str compiler
                .state
                .program
                .register_function
            nodes worker.clone FunctionWork::RecursiveDestruction compiler
                .state
                .pending
                .push
        fi
        entry i64::try_from.unwrap InstValue::Push bytecode.push
        worker InstValue::FnCall bytecode.push
    }

    fn compile_destruction_node
        compiler:mut$FunctionPlanner
        node:$DestructionNode
        bytecode:mut$std::List[InstValue]
    {
        node match
            DestructionNode::Value(typ storage) => storage copy bytecode typ compiler.compile_destruction_body
            DestructionNode::Closure(name) => {
                name.as_str compiler
                    .state
                    .store
                    .get_function
                    .unwrap = lambda
                bytecode lambda compiler.compile_closure_destruction
            }
        end
    }

    # The record itself supplies captures and active flags. No destruction body
    # needs current_env, so a worker can resume another record in the same frame.
    fn compile_closure_destruction
        compiler:mut$FunctionPlanner
        lambda:$common::Function
        bytecode:mut$std::List[InstValue]
    {
        for capture_index in lambda.captures.length 0 std::Range::new do
            capture_index lambda.captures.get = capture
            if capture.name.as_str lambda.owned_captures common::string_list_contains ! then
                continue
            fi
            compiler.new_label = end_label
            # Two header words, then a value and an active flag per capture.
            capture_index 2 * 2 + common::WORD_SIZE * = value_offset
            InstValue::Dup bytecode.push
            value_offset common::WORD_SIZE + i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            InstValue::Load64 bytecode.push
            end_label InstValue::JumpNe bytecode.push
            InstValue::Dup bytecode.push
            value_offset i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            InstValue::Load64 bytecode.push
            if capture.typ compiler.is_copy_aggregate then
                InstValue::HeapFree bytecode.push
            else
                std::List[u64]::new = no_locals
                bytecode no_locals true StorageKind::Heap capture.typ compiler.compile_child_destruction
            fi
            end_label InstValue::Label bytecode.push
        done
        InstValue::HeapFree bytecode.push
    }

    # A function value's record selects a concrete capture layout at runtime.
    # Cycle members jump to that layout's body. Other records retain direct cleanup.
    fn compile_closure_dispatch compiler:mut$FunctionPlanner bytecode:mut$std::List[InstValue] {
        std::List[std::String]::new = closures
        if compiler.recursive_destruction std::Option::Some(context) is then
            context.closures.clone = closures
        fi
        for name in closures.iter do
            name.as_str compiler
                .state
                .store
                .get_function
                .unwrap = lambda
            lambda compiler.ensure_closure_destruction_function = destructor
            compiler.new_label = next_label
            InstValue::Dup bytecode.push
            common::WORD_SIZE InstValue::Push bytecode.push
            InstValue::Add bytecode.push
            InstValue::Load64 bytecode.push
            destructor.clone InstValue::DropFn bytecode.push
            InstValue::Eq bytecode.push
            next_label InstValue::JumpNe bytecode.push
            if compiler.recursive_destruction std::Option::Some(context) is then
                destructor context
                    .starts
                    .get_copy
                    .unwrap InstValue::Jump bytecode.push
            fi
            next_label InstValue::Label bytecode.push
        done
        InstValue::ClosureDrop bytecode.push
    }

    fn emit_continuation_address
        compiler:mut$FunctionPlanner
        slots:ContinuationSlots
        offset:u64
        bytecode:mut$std::List[InstValue]
    {
        slots.buffer InstValue::LocalGet bytecode.push
        slots.length InstValue::LocalGet bytecode.push
        InstValue::Add bytecode.push
        if 0 offset != then
            offset i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Add bytecode.push
        fi
    }

    fn emit_continuation_length_change
        compiler:mut$FunctionPlanner
        slots:ContinuationSlots
        bytes:u64
        instruction:InstValue
        bytecode:mut$std::List[InstValue]
    {
        slots.length InstValue::LocalGet bytecode.push
        bytes i64::try_from.unwrap InstValue::Push bytecode.push
        instruction bytecode.push
        slots.length InstValue::LocalSet bytecode.push
    }

    # Consume a child value and destroy it. Inside a recursive destruction
    # worker, a call to a cycle member becomes a continuation: the owner below
    # the child when `owner_below` is set, then `saved_locals`, then the resume
    # id. The worker restores them after the child is destroyed.
    fn compile_child_destruction
        compiler:mut$FunctionPlanner
        typ:$common::Type
        storage_kind:StorageKind
        owner_below:bool
        saved_locals:$std::List[u64]
        bytecode:mut$std::List[InstValue]
    {
        storage_kind typ destruction_function_name = name
        std::Option[u64]::None = start
        0 0 0 ContinuationSlots = slots
        if compiler.recursive_destruction std::Option::Some(context) is then
            name context.starts.get_copy = start
            context.slots copy = slots
        fi
        if start std::Option::Some(start_label) is else
            storage_kind bytecode typ compiler.compile_destruction_in_storage
            return
        fi
        compiler.ensure_continuation_growth_function = growth
        compiler.new_label = store_label
        compiler.new_label = resume_label
        0 = resume_id: u64
        if compiler.recursive_destruction std::Option::Some(context) is then
            context.resumes.length = resume_id
            resume_label context.resumes.push
        fi
        common::WORD_SIZE u64::try_from.unwrap = word
        saved_locals.length 1 + word * = saved_bytes
        if owner_below then
            word += saved_bytes
        fi

        # Grow the buffer when the continuation does not fit.
        slots.length InstValue::LocalGet bytecode.push
        saved_bytes i64::try_from.unwrap InstValue::Push bytecode.push
        InstValue::Add bytecode.push
        slots.capacity InstValue::LocalGet bytecode.push
        InstValue::Ugt bytecode.push
        store_label InstValue::JumpNe bytecode.push
        slots.buffer InstValue::LocalGet bytecode.push
        slots.length InstValue::LocalGet bytecode.push
        slots.capacity InstValue::LocalGet bytecode.push
        growth InstValue::FnCall bytecode.push
        slots.capacity InstValue::LocalSet bytecode.push
        slots.buffer InstValue::LocalSet bytecode.push
        store_label InstValue::Label bytecode.push

        0 = offset: u64
        if owner_below then
            InstValue::Swap bytecode.push
            bytecode offset slots compiler.emit_continuation_address
            InstValue::Store64 bytecode.push
            word += offset
        fi
        for local in saved_locals.iter do
            local copy InstValue::LocalGet bytecode.push
            bytecode offset slots compiler.emit_continuation_address
            InstValue::Store64 bytecode.push
            word += offset
        done
        resume_id i64::try_from.unwrap InstValue::Push bytecode.push
        bytecode offset slots compiler.emit_continuation_address
        InstValue::Store64 bytecode.push
        bytecode InstValue::Add saved_bytes slots compiler.emit_continuation_length_change
        start_label InstValue::Jump bytecode.push

        # The dispatch has removed the resume id.
        resume_label InstValue::Label bytecode.push
        saved_bytes word - = restored_bytes
        bytecode InstValue::Sub restored_bytes slots compiler.emit_continuation_length_change
        0 = restore_offset: u64
        if owner_below then
            word += restore_offset
        fi
        for local in saved_locals.iter do
            bytecode restore_offset slots compiler.emit_continuation_address
            InstValue::Load64 bytecode.push
            local copy InstValue::LocalSet bytecode.push
            word += restore_offset
        done
        if owner_below then
            bytecode 0 slots compiler.emit_continuation_address
            InstValue::Load64 bytecode.push
        fi
    }

    fn ensure_continuation_growth_function compiler:mut$FunctionPlanner -> std::String {
        CONTINUATION_GROWTH_FUNCTION.to_str = name
        if
            name compiler
                .state
                .program
                .functions
                .has !
        then
            name.as_str compiler
                .state
                .program
                .register_function
            name.clone FunctionWork::ContinuationGrowth compiler
                .state
                .pending
                .push
        fi
        name
    }

    # Destroy the members of one recursive destruction cycle in one frame.
    # Consumes the value and its entry index in `nodes`. Each member body jumps
    # to the dispatch after it releases its storage. The dispatch resumes the
    # latest continuation, or releases the buffer and returns when none is left.
    fn compile_recursive_destruction
        compiler:mut$FunctionPlanner
        nodes:$std::List[DestructionNode]
        bytecode:mut$std::List[InstValue]
    {
        compiler.allocate_local = buffer
        compiler.allocate_local = length
        compiler.allocate_local = capacity
        capacity length buffer ContinuationSlots = slots
        CONTINUATION_BUFFER_BYTES compiler.allocate_value_storage = frame_buffer
        frame_buffer InstValue::LocalAddress bytecode.push
        buffer InstValue::LocalSet bytecode.push
        0 InstValue::Push bytecode.push
        length InstValue::LocalSet bytecode.push
        CONTINUATION_BUFFER_BYTES i64::try_from.unwrap InstValue::Push bytecode.push
        capacity InstValue::LocalSet bytecode.push
        std::Map[std::String u64]::new = starts
        std::List[u64]::new = start_labels
        std::List[std::String]::new = closures
        for node in nodes.iter do
            compiler.new_label = label
            label node.get_name starts.set
            label start_labels.push
            if node DestructionNode::Closure(name) is then
                name.clone closures.push
            fi
        done
        compiler.new_label = dispatch_label
        compiler.new_label = finish_label
        closures slots std::List[u64]::new starts RecursiveDestruction std::Option::Some = compiler.recursive_destruction

        0 start_labels.get copy start_labels.clone InstValue::JumpTable bytecode.push
        0 = index: u64
        for node in nodes.iter do
            index start_labels.get copy InstValue::Label bytecode.push
            bytecode node compiler.compile_destruction_node
            dispatch_label InstValue::Jump bytecode.push
            1 += index
        done

        dispatch_label InstValue::Label bytecode.push
        length InstValue::LocalGet bytecode.push
        0 InstValue::Push bytecode.push
        InstValue::Ne bytecode.push
        finish_label InstValue::JumpNe bytecode.push
        bytecode InstValue::Sub common::WORD_SIZE u64::try_from.unwrap slots compiler.emit_continuation_length_change
        bytecode 0 slots compiler.emit_continuation_address
        InstValue::Load64 bytecode.push
        std::List[u64]::new = resumes
        if compiler.recursive_destruction std::Option::Some(context) is then
            context.resumes.clone = resumes
        fi
        std::Option[RecursiveDestruction]::None = compiler.recursive_destruction
        finish_label resumes InstValue::JumpTable bytecode.push

        finish_label InstValue::Label bytecode.push
        bytecode slots compiler.emit_continuation_buffer_release
    }

    # Release a continuation buffer unless it is the worker's frame buffer.
    fn emit_continuation_buffer_release
        compiler:mut$FunctionPlanner
        slots:ContinuationSlots
        bytecode:mut$std::List[InstValue]
    {
        compiler.new_label = end_label
        slots.capacity InstValue::LocalGet bytecode.push
        CONTINUATION_BUFFER_BYTES i64::try_from.unwrap InstValue::Push bytecode.push
        InstValue::Ne bytecode.push
        end_label InstValue::JumpNe bytecode.push
        slots.buffer InstValue::LocalGet bytecode.push
        InstValue::HeapFree bytecode.push
        end_label InstValue::Label bytecode.push
    }

    # Move continuations to a larger buffer. Consumes the buffer, its used
    # bytes, and its capacity, and returns the new buffer and capacity.
    fn compile_continuation_growth compiler:mut$FunctionPlanner bytecode:mut$std::List[InstValue] {
        compiler.allocate_local = buffer
        compiler.allocate_local = length
        compiler.allocate_local = capacity
        compiler.allocate_local = grown
        compiler.allocate_local = offset
        capacity length buffer ContinuationSlots = slots
        capacity InstValue::LocalSet bytecode.push
        length InstValue::LocalSet bytecode.push
        buffer InstValue::LocalSet bytecode.push
        capacity InstValue::LocalGet bytecode.push
        2 InstValue::Push bytecode.push
        InstValue::Mul bytecode.push
        InstValue::HeapAlloc bytecode.push
        grown InstValue::LocalSet bytecode.push

        compiler.new_label = loop_label
        compiler.new_label = end_label
        0 InstValue::Push bytecode.push
        offset InstValue::LocalSet bytecode.push
        loop_label InstValue::Label bytecode.push
        offset InstValue::LocalGet bytecode.push
        length InstValue::LocalGet bytecode.push
        InstValue::Ult bytecode.push
        end_label InstValue::JumpNe bytecode.push
        buffer InstValue::LocalGet bytecode.push
        offset InstValue::LocalGet bytecode.push
        InstValue::Add bytecode.push
        InstValue::Load64 bytecode.push
        grown InstValue::LocalGet bytecode.push
        offset InstValue::LocalGet bytecode.push
        InstValue::Add bytecode.push
        InstValue::Store64 bytecode.push
        offset InstValue::LocalGet bytecode.push
        common::WORD_SIZE InstValue::Push bytecode.push
        InstValue::Add bytecode.push
        offset InstValue::LocalSet bytecode.push
        loop_label InstValue::Jump bytecode.push
        end_label InstValue::Label bytecode.push

        bytecode slots compiler.emit_continuation_buffer_release
        grown InstValue::LocalGet bytecode.push
        capacity InstValue::LocalGet bytecode.push
        2 InstValue::Push bytecode.push
        InstValue::Mul bytecode.push
    }

    fn owner_flag compiler:mut$FunctionPlanner name:$str -> u64 {
        if name compiler.owner_flags.get_copy_str std::Option::Some(flag) is then
            flag return
        fi
        compiler.allocate_local = flag
        flag name.clone compiler.owner_flags.set_str
        flag
    }

    fn set_owner_flag
        compiler:mut$FunctionPlanner
        name:$str
        value:u64
        bytecode:mut$std::List[InstValue]
    {
        name compiler.owner_flag = flag
        value i64::try_from.unwrap InstValue::Push bytecode.push
        flag InstValue::LocalSet bytecode.push
    }

    fn compile_variable_destruction
        compiler:mut$FunctionPlanner
        variable_name:$str
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if
            variable_name compiler.find_local_inline_aggregate_type
            std::Option::Some(aggregate_type) is
        then
            variable_name compiler.resolve_local = local_index
            local_index InstValue::LocalAddress bytecode.push
            StorageKind::Local bytecode aggregate_type compiler.compile_destruction_in_storage
            return
        fi
        variable_name compiler.resolve_local InstValue::LocalGet bytecode.push
        bytecode typ compiler.compile_destruction
    }

    fn compile_active_owner_cleanup
        compiler:mut$FunctionPlanner
        event:$common::OwnerEvent
        bytecode:mut$std::List[InstValue]
    {
        event.storage_name.as_str compiler.owner_flag = flag
        compiler.new_label = cleanup_label
        compiler.new_label = end_label
        flag InstValue::LocalGet bytecode.push
        0 InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        cleanup_label InstValue::JumpNe bytecode.push
        end_label InstValue::Jump bytecode.push
        cleanup_label InstValue::Label bytecode.push
        bytecode event.typ event.storage_name.as_str compiler.compile_variable_destruction
        bytecode 0 event.storage_name.as_str compiler.set_owner_flag
        end_label InstValue::Label bytecode.push
    }

    fn compile_owner_cleanup
        compiler:mut$FunctionPlanner
        event:$common::OwnerEvent
        bytecode:mut$std::List[InstValue]
    {
        event.storage_name.as_str compiler.owner_flag = flag
        compiler.new_label = end_label
        flag InstValue::LocalGet bytecode.push
        event.generation i64::try_from.unwrap InstValue::Push bytecode.push
        InstValue::Eq bytecode.push
        end_label InstValue::JumpNe bytecode.push
        bytecode event.typ event.storage_name.as_str compiler.compile_variable_destruction
        bytecode 0 event.storage_name.as_str compiler.set_owner_flag
        end_label InstValue::Label bytecode.push
    }
}

# Control-flow targets
impl semantic_body::PrimitiveKind {
    fn produces_integer_result self:$semantic_body::PrimitiveKind -> bool {
        self match
            semantic_body::PrimitiveKind::Add => true
            semantic_body::PrimitiveKind::Sub => true
            semantic_body::PrimitiveKind::Mul => true
            semantic_body::PrimitiveKind::Div => true
            semantic_body::PrimitiveKind::Mod => true
            semantic_body::PrimitiveKind::Shl => true
            semantic_body::PrimitiveKind::Shr => true
            semantic_body::PrimitiveKind::BitAnd => true
            semantic_body::PrimitiveKind::BitOr => true
            semantic_body::PrimitiveKind::BitXor => true
            semantic_body::PrimitiveKind::BitNot => true
            semantic_body::PrimitiveKind::WrappingAdd => true
            semantic_body::PrimitiveKind::WrappingSub => true
            semantic_body::PrimitiveKind::WrappingMul => true
            _ => false
        end
    }

    fn select_typed_instruction
        self:$semantic_body::PrimitiveKind
        direct:InstValue
        builtin:$common::BuiltinType
    -> InstValue {
        if builtin.is_float then
            if builtin common::BuiltinType::F32 == then
                self match
                    semantic_body::PrimitiveKind::Add => InstValue::FloatAdd32
                    semantic_body::PrimitiveKind::Sub => InstValue::FloatSub32
                    semantic_body::PrimitiveKind::Mul => InstValue::FloatMul32
                    semantic_body::PrimitiveKind::Div => InstValue::FloatDiv32
                    semantic_body::PrimitiveKind::Eq => InstValue::FloatEq32
                    semantic_body::PrimitiveKind::Ne => InstValue::FloatNe32
                    semantic_body::PrimitiveKind::Lt => InstValue::FloatLt32
                    semantic_body::PrimitiveKind::Le => InstValue::FloatLe32
                    semantic_body::PrimitiveKind::Gt => InstValue::FloatGt32
                    semantic_body::PrimitiveKind::Ge => InstValue::FloatGe32
                    _ => direct
                end
            else
                self match
                    semantic_body::PrimitiveKind::Add => InstValue::FloatAdd64
                    semantic_body::PrimitiveKind::Sub => InstValue::FloatSub64
                    semantic_body::PrimitiveKind::Mul => InstValue::FloatMul64
                    semantic_body::PrimitiveKind::Div => InstValue::FloatDiv64
                    semantic_body::PrimitiveKind::Eq => InstValue::FloatEq64
                    semantic_body::PrimitiveKind::Ne => InstValue::FloatNe64
                    semantic_body::PrimitiveKind::Lt => InstValue::FloatLt64
                    semantic_body::PrimitiveKind::Le => InstValue::FloatLe64
                    semantic_body::PrimitiveKind::Gt => InstValue::FloatGt64
                    semantic_body::PrimitiveKind::Ge => InstValue::FloatGe64
                    _ => direct
                end
            fi
            return
        fi
        self match
            semantic_body::PrimitiveKind::Add => {
                builtin copy InstValue::CheckedAdd return
            }
            semantic_body::PrimitiveKind::Sub => {
                builtin copy InstValue::CheckedSub return
            }
            semantic_body::PrimitiveKind::Mul => {
                builtin copy InstValue::CheckedMul return
            }
            semantic_body::PrimitiveKind::Div => {
                builtin copy InstValue::CheckedDiv return
            }
            semantic_body::PrimitiveKind::Mod => {
                builtin copy InstValue::CheckedMod return
            }
            semantic_body::PrimitiveKind::Shl => {
                builtin copy InstValue::CheckedShl return
            }
            semantic_body::PrimitiveKind::Shr => {
                builtin copy InstValue::CheckedShr return
            }
            _ => {}
        end
        if builtin.is_unsigned ! then
            direct return
        fi
        self match
            semantic_body::PrimitiveKind::Div => InstValue::UDiv
            semantic_body::PrimitiveKind::Mod => InstValue::UMod
            semantic_body::PrimitiveKind::Shr => InstValue::UShr
            semantic_body::PrimitiveKind::Lt => InstValue::Ult
            semantic_body::PrimitiveKind::Le => InstValue::Ule
            semantic_body::PrimitiveKind::Gt => InstValue::Ugt
            semantic_body::PrimitiveKind::Ge => InstValue::Uge
            semantic_body::PrimitiveKind::PrintInt => InstValue::PrintUint
            _ => direct
        end
    }
}

impl FunctionPlanner {
    fn emit_integer_normalization
        self:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if typ common::Type::Builtin(builtin) is then
            if builtin.is_integer then
                builtin InstValue::NormalizeInt bytecode.push
            fi
        fi
    }

    fn compile_assignment
        compiler:mut$FunctionPlanner
        kind:$semantic_body::BindingKind
        binding:$common::BindingReference
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        binding.storage_name = name: $std::String
        if name compiler.capture_slots.get_copy std::Option::Some(capture_index) is then
            false = owns_capture
            common::make_unknown_type.clone = capture_type
            if compiler.function std::Option::Some(function) is then
                name.as_str function.owned_captures common::string_list_contains = owns_capture
                capture_index function
                    .captures
                    .get
                    .typ
                    .clone = capture_type
            fi
            if kind semantic_body::BindingKind::AssignVar is then
                if owns_capture then
                    compiler.new_label = inactive_label
                    capture_index InstValue::CaptureFlagLoad bytecode.push
                    0 InstValue::Push bytecode.push
                    InstValue::Ne bytecode.push
                    inactive_label InstValue::JumpNe bytecode.push
                    capture_index InstValue::CaptureLoad bytecode.push
                    if capture_type compiler.is_copy_aggregate then
                        InstValue::HeapFree bytecode.push
                    else
                        StorageKind::Heap bytecode capture_type compiler.compile_destruction_in_storage
                    fi
                    inactive_label InstValue::Label bytecode.push
                fi
                if owns_capture capture_type compiler.uses_automatic_storage && then
                    bytecode capture_type compiler.emit_heap_copy
                fi
                capture_index InstValue::CaptureSet bytecode.push
                if owns_capture then
                    capture_index InstValue::CaptureFlagMark bytecode.push
                fi
                return
            fi
            capture_index InstValue::CaptureLoad bytecode.push
            if kind semantic_body::BindingKind::AssignDec is then
                InstValue::Swap bytecode.push
                InstValue::Sub = instruction
                if typ common::Type::Builtin(builtin) is then
                    builtin InstValue::CheckedSub = instruction
                fi
                instruction bytecode.push
            elif kind semantic_body::BindingKind::AssignInc is then
                InstValue::Add = instruction
                if typ common::Type::Builtin(builtin) is then
                    builtin InstValue::CheckedAdd = instruction
                fi
                instruction bytecode.push
            else
                "compile_assignment received an unsupported capture assignment" compiler.record_failure
                return
            fi
            bytecode typ compiler.emit_integer_normalization
            capture_index InstValue::CaptureSet bytecode.push
            return
        fi
        name.as_str compiler.resolve_local = local_index

        kind match
            semantic_body::BindingKind::AssignDec => {
                local_index InstValue::LocalGet bytecode.push
                InstValue::Swap bytecode.push
                InstValue::Sub = instruction
                if typ common::Type::Builtin(builtin) is then
                    builtin InstValue::CheckedSub = instruction
                fi
                instruction bytecode.push
                bytecode typ compiler.emit_integer_normalization
                local_index InstValue::LocalSet bytecode.push
            }
            semantic_body::BindingKind::AssignInc => {
                local_index InstValue::LocalGet bytecode.push
                InstValue::Add = instruction
                if typ common::Type::Builtin(builtin) is then
                    builtin InstValue::CheckedAdd = instruction
                fi
                instruction bytecode.push
                bytecode typ compiler.emit_integer_normalization
                local_index InstValue::LocalSet bytecode.push
            }
            semantic_body::BindingKind::AssignVar => bytecode name.as_str compiler.emit_variable_set
            semantic_body::BindingKind::Question => bytecode name.as_str compiler.emit_variable_set
            _ => {
                "compile_assignment received a non-assignment operation" compiler.record_failure
            }
        end
    }
}

fn emit_int_eq value:$i64 bytecode:mut$std::List[InstValue] {
    value copy InstValue::Push bytecode.push
    InstValue::Eq bytecode.push
}

fn require_variant_ordinal variant:$common::EnumVariant compiler:mut$FunctionPlanner -> i64 {
    if variant.ordinal std::Option::Some(ordinal) is then
        ordinal return
    fi
    f"Enum variant `{variant.variant_name}` has no ordinal during bytecode compilation" compiler.record_failure_string
    0
}

# Each projection retains its storage plan so tests can inspect fields without
# allocating copies, while binding and destruction use the same field path.
struct PatternField {
    pattern: common::PatternValue
    typ:     common::Type
    plan:    common::FieldStoragePlan
}

impl FunctionPlanner {
    fn pattern_fields
        self:mut$FunctionPlanner
        value:$common::PatternValue
        subject:$common::Type
    -> std::List[PatternField] {
        std::List[PatternField]::new = fields
        subject pattern::owned_type = owner
        value match
            common::PatternValue::Struct(struct_pattern) => {
                struct_pattern.struct_name self
                    .state
                    .store
                    .structs
                    .get
                    .unwrap = declaration
                if owner self.is_copy_aggregate then
                    declaration owner common::copy_storage_struct
                else
                    declaration.clone
                fi = concrete
                concrete.type_vars owner common::aggregate_type_bindings = substitutions
                0 = index: u64
                for member in concrete.members.iter do
                    member.name struct_pattern.bindings.get match
                        std::Option::Some(child) => child.clone
                        std::Option::None => pattern::wildcard
                    end = child
                    index concrete self.get_struct_field_plan
                    substitutions member.typ.substitute child PatternField fields.push
                    1 += index
                done
            }
            common::PatternValue::EnumVariant(variant) => {
                if value pattern::is_wildcard then
                    fields return
                fi
                variant.enum_name self
                    .state
                    .store
                    .enums
                    .get
                    .unwrap = declaration
                if owner self.is_copy_aggregate then
                    declaration owner common::copy_storage_enum
                else
                    declaration.clone
                fi = concrete
                self.state.store variant owner pattern::enum_payload_types = types
                0 = index: u64
                for typ in types.iter do
                    if index variant.bindings.length < then
                        index variant
                            .bindings
                            .get
                            .clone
                    else
                        pattern::wildcard
                    fi = child
                    index variant.variant_name.as_str concrete self.get_enum_field_plan
                    typ.clone child PatternField fields.push
                    1 += index
                done
            }
            _ => {}
        end
        fields
    }

    fn emit_pattern_field_address
        self:mut$FunctionPlanner
        field:$PatternField
        subject:u64
        bytecode:mut$std::List[InstValue]
    {
        subject InstValue::LocalGet bytecode.push
        if 0 field.plan.offset != then
            field.plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::Add bytecode.push
        fi
    }

    # Tests leave the stack unchanged on either edge. No binding owns a field
    # until every nested test and the shared arm guard have succeeded.
    fn emit_pattern_test
        self:mut$FunctionPlanner
        value:$common::PatternValue
        typ:$common::Type
        subject:u64
        failure:u64
        bytecode:mut$std::List[InstValue]
    {
        value match
            common::PatternValue::Literal(literal) => {
                subject InstValue::LocalGet bytecode.push
                literal.value match
                    common::LiteralValue::Str(text) => {
                        text.as_str self.intern_string InstValue::PushStr bytecode.push
                        InstValue::StrEq bytecode.push
                    }
                    common::LiteralValue::Int(number) => bytecode number.value emit_int_eq
                    common::LiteralValue::Char(character) => bytecode character emit_int_eq
                    common::LiteralValue::Bool(boolean) => {
                        bytecode if boolean then 1 else 0 fi emit_int_eq
                    }
                end
                failure InstValue::JumpNe bytecode.push
            }
            common::PatternValue::EnumVariant(variant) => {
                if value pattern::is_wildcard then
                    return
                fi
                subject InstValue::LocalGet bytecode.push
                if
                    variant.enum_name self
                        .state
                        .store
                        .enums
                        .get
                        .unwrap common::has_inner_values
                then
                    InstValue::Load64 bytecode.push
                fi
                self variant require_variant_ordinal InstValue::Push bytecode.push
                InstValue::Eq bytecode.push
                failure InstValue::JumpNe bytecode.push
            }
            _ => {}
        end
        for field in typ value self.pattern_fields.iter do
            if field.pattern common::PatternValue::Binding is field.pattern pattern::is_wildcard || then
                continue
            fi
            bytecode subject field self.emit_pattern_field_address
            bytecode field.plan field.typ self.emit_field_projection
            if field.typ.borrow_target std::Option::Some(target) is then
                if self.state.store target common::type_has_scalar_storage then
                    bytecode target self.emit_typed_load
                fi
            fi
            self.allocate_local = child
            child InstValue::LocalSet bytecode.push
            bytecode failure child field.typ field.pattern self.emit_pattern_test
        done
    }

    fn emit_pattern_bindings
        self:mut$FunctionPlanner
        value:$common::PatternValue
        typ:$common::Type
        subject:u64
        facts:$semantic_body::OperationFacts
        bytecode:mut$std::List[InstValue]
    {
        for field in typ value self.pattern_fields.iter do
            if field.pattern pattern::binding_names.is_empty then
                continue
            fi
            bytecode subject field self.emit_pattern_field_address
            if field.pattern common::PatternValue::Binding(binding) is then
                binding.name.as_str facts.resolve_storage_name = storage_name
                if storage_name.as_str self.binding_is_borrow then
                    if self.state.store field.typ common::type_has_scalar_storage ! then
                        bytecode field.plan field.typ self.emit_field_projection
                    fi
                else
                    bytecode field.plan field.typ self.emit_field_load
                fi
                bytecode storage_name.as_str self.emit_variable_set
            else
                bytecode field.plan field.typ self.emit_field_projection
                self.allocate_local = child
                child InstValue::LocalSet bytecode.push
                bytecode facts child field.typ field.pattern self.emit_pattern_bindings
            fi
        done
    }

    # Consume the successful subject. Bound non-Copy leaves have moved. All
    # other fields and every owned wrapper are destroyed exactly once.
    fn compile_pattern_destruction
        self:mut$FunctionPlanner
        value:$common::PatternValue
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
        storage:StorageKind
        facts:$semantic_body::OperationFacts
    {
        if typ.is_borrow typ self.is_copy_aggregate || then
            InstValue::Drop bytecode.push return
        fi
        if value common::PatternValue::Binding(binding) is then
            if storage StorageKind::Heap is typ self.uses_automatic_storage && then
                # Guards used a snapshot. Refresh after enclosing cleanup hooks,
                # then release the backing that the moved binding no longer needs.
                bytecode typ self.move_heap_value
                binding.name.as_str facts.resolve_storage_name = storage_name
                bytecode storage_name.as_str self.emit_variable_set
            else
                InstValue::Drop bytecode.push
            fi
            return
        fi
        if value pattern::binding_names.is_empty then
            storage bytecode typ self.compile_destruction_in_storage return
        fi
        bytecode typ self.compile_drop_hook
        self.allocate_local = subject
        subject InstValue::LocalSet bytecode.push
        typ value self.pattern_fields = fields
        fields.length = index
        while 0 index != do
            1 -= index
            index fields.get = field
            bytecode subject field self.emit_pattern_field_address
            if field.typ self.is_copy_aggregate then
                bytecode field.plan field.typ self.compile_field_destruction
            else
                bytecode field.plan field.typ self.emit_field_projection
                facts
                if field.plan.stores_inline then
                    StorageKind::Local
                else
                    StorageKind::Heap
                fi
                bytecode field.typ field.pattern self.compile_pattern_destruction
            fi
        done
        subject InstValue::LocalGet bytecode.push
        bytecode storage self.finish_destruction
    }
}

impl FunctionPlanner {
    fn compile_struct_new
        compiler:mut$FunctionPlanner
        casa_struct:$common::CasaStruct
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if casa_struct.type_vars.is_empty ! typ compiler.is_copy_aggregate && then
            casa_struct typ common::copy_storage_struct = concrete
            bytecode typ concrete compiler.compile_struct_new
            return
        fi
        casa_struct.type_vars typ common::aggregate_type_bindings = substitutions
        casa_struct.members.length = count
        bytecode typ compiler.emit_value_storage
        for index in count 0 std::Range::new do
            InstValue::Swap bytecode.push
            InstValue::Over bytecode.push
            index casa_struct compiler.get_struct_field_plan = plan
            if 0 plan.offset < then
                plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::Add bytecode.push
            fi
            index casa_struct.members.get = member
            substitutions member.typ.substitute = member_type
            bytecode plan member_type compiler.emit_field_store
        done
    }
}

# Compile enum variant
impl FunctionPlanner {
    fn compile_enum_variant
        compiler:mut$FunctionPlanner
        variant:$common::EnumVariant
        casa_enum:$common::CasaEnum
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if casa_enum.type_vars.is_empty ! typ compiler.is_copy_aggregate && then
            casa_enum typ common::copy_storage_enum = concrete
            bytecode typ concrete variant compiler.compile_enum_variant
            return
        fi
        casa_enum.type_vars typ common::aggregate_type_bindings = substitutions
        bytecode typ compiler.emit_value_storage
        InstValue::Dup bytecode.push
        compiler variant require_variant_ordinal InstValue::Push bytecode.push
        InstValue::Swap bytecode.push
        InstValue::Store64 bytecode.push
        if variant.variant_name casa_enum.variant_types.get std::Option::Some(types) is then
            0 = index: u64
            for payload_type in types.iter do
                InstValue::Swap bytecode.push
                InstValue::Over bytecode.push
                index variant.variant_name.as_str casa_enum compiler.get_enum_field_plan = plan
                plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::Add bytecode.push
                substitutions payload_type.substitute = concrete_type
                bytecode plan concrete_type compiler.emit_field_store
                1 += index
            done
        fi
    }
}

# Compile is check
impl FunctionPlanner {
    fn compile_is_check
        compiler:mut$FunctionPlanner
        store:$common::SymbolStore
        variant:$common::EnumVariant
        subject_type:$common::Type
        op:$semantic_body::OperationFacts
        bytecode:mut$std::List[InstValue]
    {
        variant.clone common::PatternValue::EnumVariant = value
        compiler.allocate_local = subject
        compiler.new_label = failed
        compiler.new_label = finished
        subject InstValue::LocalSet bytecode.push
        bytecode failed subject subject_type value compiler.emit_pattern_test
        bytecode op subject subject_type value compiler.emit_pattern_bindings
        if op.effects std::Option::Some(ownership) is then
            for event in ownership.assignments.iter do
                bytecode event.generation event.storage_name.as_str compiler.set_owner_flag
            done
            if ownership.conditional_move std::Option::Some(subject_name) is then
                subject InstValue::LocalGet bytecode.push
                op subject_type compiler.value_storage bytecode subject_type value compiler.compile_pattern_destruction
                subject_name.as_str op.resolve_storage_name = storage
                bytecode 0 storage.as_str compiler.set_owner_flag
            fi
        fi
        1 InstValue::Push bytecode.push
        finished InstValue::Jump bytecode.push
        failed InstValue::Label bytecode.push
        0 InstValue::Push bytecode.push
        finished InstValue::Label bytecode.push
    }
}

# Compile struct literal
impl FunctionPlanner {
    fn compile_struct_literal
        compiler:mut$FunctionPlanner
        store:$common::SymbolStore
        literal:$common::StructLiteral
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if literal.struct_name store.structs.get std::Option::Some(declaration) is else
            f"Struct `{literal.struct_name}` is missing during bytecode compilation" compiler.record_failure_string
            return
        fi
        if typ compiler.is_copy_aggregate then
            declaration typ common::copy_storage_struct
        else
            declaration.clone
        fi = casa_struct
        casa_struct.type_vars typ common::aggregate_type_bindings = substitutions
        casa_struct.members.length = count

        # Store all field values into temp locals (top of stack = last in field_order)
        # Iterate field_order in reverse
        literal.field_order.length = field_index
        std::Map[std::String u64]::new = temp_locals
        while 0 field_index != do
            1 -= field_index
            compiler.allocate_local = local_index
            field_index literal.field_order.get = field_name
            local_index field_name.clone temp_locals.set
            local_index InstValue::LocalSet bytecode.push
        done

        bytecode typ compiler.emit_value_storage

        # Store each field at its correct offset
        for member_index in casa_struct.members.length 0 std::Range::new do
            member_index casa_struct.members.get = member
            member.name.as_str = member_name: $str
            member_index casa_struct compiler.get_struct_field_plan = plan
            InstValue::Dup bytecode.push
            if 0 plan.offset < then
                plan.offset i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::Add bytecode.push
            fi
            if member_name temp_locals.get_copy_str std::Option::Some(temp_local) is then
                temp_local copy InstValue::LocalGet bytecode.push
            else
                f"Struct literal field `{member_name}` has no temporary local during bytecode compilation" compiler.record_failure_string
                return
            fi
            InstValue::Swap bytecode.push
            substitutions member.typ.substitute = member_type
            bytecode plan member_type compiler.emit_field_store
        done
    }
}

# Compile push array
impl FunctionPlanner {
    fn compile_static_element
        self:mut$FunctionPlanner
        leaf:$semantic_body::Leaf
    -> StaticArrayElement {
        leaf.action match
            semantic_body::Action::Integer(value _) => value.value StaticArrayElement::Imm
            semantic_body::Action::Boolean(value) => value StaticArrayElement::Imm
            semantic_body::Action::Character(value) => value StaticArrayElement::Imm
            semantic_body::Action::String(value) => value.as_str self.intern_string StaticArrayElement::String
            semantic_body::Action::Enum(variant _) => self variant require_variant_ordinal StaticArrayElement::Imm
            semantic_body::Action::Closure(call) => {
                call.name.as_str self.compile_named_function drop
                call.name.clone StaticArrayElement::Function
            }
            _ => {
                "Invalid checked static element" self.record_failure
                0 StaticArrayElement::Imm
            }
        end
    }
}

impl FunctionPlanner {
    fn compile_static_array
        compiler:mut$FunctionPlanner
        body:$semantic_body::Body
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        body.get_nodes = items
        std::List[StaticArrayElement]::new = elements
        for item in items.iter do
            item match
                semantic_body::Node::Leaf(leaf) => leaf compiler.compile_static_element elements.push
                _ => "Invalid checked static array" compiler.record_failure
            end
        done
        compiler
            .state
            .program
            .static_arrays
            .length = array_index
        elements StaticArray compiler
            .state
            .program
            .static_arrays
            .push
        items.length common::WORD_SIZE * = byte_count
        if 0 byte_count == then
            1 = byte_count: u64
        fi
        bytecode typ compiler.emit_value_storage
        byte_count array_index InstValue::PushStaticArray bytecode.push
    }
}

impl FunctionPlanner {
    fn compile_push_array
        self:mut$FunctionPlanner
        array:$semantic_body::ArrayLiteral
        bytecode:mut$std::List[InstValue]
    {
        array.body.get_nodes = nodes: $std::List[semantic_body::Node]
        nodes.length = length
        array
            .typ
            .array_element_type
            .unwrap = element_type
        element_type self
            .state
            .layouts
            .inline_size
            .unwrap = element_size
        # Static elements occupy one raw word. Aggregates use the dynamic path
        # even when their inline storage is one word (ADR-0152).
        if length 0 != common::WORD_SIZE element_size == && then
            self.state.store element_type common::type_value_representation.unwrap = representation
            if common::VALUE_REPR_RAW representation == common::VALUE_REPR_SIGNED representation == || then
                if array.body self.is_static_sequence then
                    bytecode array.typ array.body self.compile_static_array return
                fi
            fi
        fi
        nodes.length = position
        while 0 position != do
            1 -= position
            bytecode position nodes.get self.compile_node
        done

        # An array stores only its elements (ADR-0152), so the allocation
        # is exactly the element storage.
        self.allocate_local = list_local
        bytecode array.typ self.emit_value_storage
        list_local InstValue::LocalSet bytecode.push

        # Store elements starting at offset 0
        self.allocate_local = index_local
        0 InstValue::Push bytecode.push
        index_local InstValue::LocalSet bytecode.push

        self.new_label = start_label
        self.new_label = end_label

        # while index limit < do
        start_label InstValue::MemoryLabel bytecode.push
        index_local InstValue::LocalGet bytecode.push
        length element_size * i64::try_from.unwrap InstValue::Push bytecode.push
        InstValue::Lt bytecode.push
        end_label InstValue::JumpNe bytecode.push

        # list index + typed store
        list_local InstValue::LocalGet bytecode.push
        index_local InstValue::LocalGet bytecode.push
        InstValue::Add bytecode.push
        bytecode element_type self.emit_typed_store

        # element_size += index
        index_local InstValue::LocalGet bytecode.push
        element_size i64::try_from.unwrap InstValue::Push bytecode.push
        InstValue::Add bytecode.push
        index_local InstValue::LocalSet bytecode.push

        # done
        start_label InstValue::Jump bytecode.push
        end_label InstValue::MemoryLabel bytecode.push

        # Push array pointer
        list_local InstValue::LocalGet bytecode.push
    }
}

# Compile function call
impl FunctionPlanner {
    fn compile_named_function compiler:mut$FunctionPlanner name:$str -> bool {
        if
            name compiler
                .state
                .program
                .functions
                .has_str
        then
            true return
        fi
        if
            name compiler
                .state
                .store
                .get_function std::Option::Some(function) is
        then
            if function.extern_symbol.is_none then
                name compiler
                    .state
                    .program
                    .register_function
                name.to_str FunctionWork::Checked compiler
                    .state
                    .pending
                    .push
            fi
            true
        else
            f"Missing checked function `{name}`" compiler.record_failure_string
            false
        fi
    }
}

impl FunctionPlanner {
    fn ensure_closure_destruction_function
        compiler:mut$FunctionPlanner
        lambda:$common::Function
    -> std::String {
        f"__drop_closure_{lambda.name}" = drop_name
        if
            drop_name compiler
                .state
                .program
                .functions
                .has
        then
            drop_name return
        fi
        drop_name.as_str compiler
            .state
            .program
            .register_function
        lambda.name.clone drop_name.clone FunctionWork::ClosureDestruction compiler
            .state
            .pending
            .push
        drop_name
    }

    fn allocate_value_storage self:mut$FunctionPlanner size:u64 -> u64 {
        size common::WORD_SIZE u64::try_from.unwrap 1 - +
        common::WORD_SIZE u64::try_from.unwrap / = width
        width += self.locals_count
        self.locals_count 1 -
    }

    fn result_storage_size self:mut$FunctionPlanner returns:$std::List[common::Type] -> u64 {
        0 = size: u64
        for typ in returns.iter do
            if typ self.uses_automatic_storage then
                typ self
                    .state
                    .layouts
                    .inline_size
                    .unwrap = value_size
                common::WORD_SIZE u64::try_from.unwrap value_size common::align_up size + = size
            fi
        done
        size
    }

    fn prepare_results
        self:mut$FunctionPlanner
        returns:$std::List[common::Type]
        bytecode:mut$std::List[InstValue]
    -> bool {
        returns self.result_storage_size = size
        if 0 size == then
            false return
        fi
        size self.allocate_value_storage InstValue::LocalAddress bytecode.push
        true
    }

    fn begin_results self:mut$FunctionPlanner bytecode:mut$std::List[InstValue] {
        if self.function std::Option::Some(function) is then
            function
                .stack_effect
                .return_types
                .clone = returns
            if 0 returns self.result_storage_size != then
                self.allocate_local = slot
                slot std::Option::Some = self.result_slot
                slot InstValue::LocalSet bytecode.push
            fi
        fi
    }

    fn finish_results self:mut$FunctionPlanner bytecode:mut$std::List[InstValue] {
        if self.result_slot std::Option::Some(destination) is then
            self.function match
                std::Option::Some(function) => function
                    .stack_effect
                    .return_types
                    .clone
                std::Option::None => return
            end = returns
            self.new_label = end_label
            # Direct field access lends its existing place. An indirect call to a
            # getter supplies an owned destination through the normal value ABI.
            destination InstValue::LocalGet bytecode.push
            0 InstValue::Push bytecode.push
            InstValue::Ne bytecode.push
            end_label InstValue::JumpNe bytecode.push
            std::List[u64]::new = values
            for _typ in returns.iter do
                self.allocate_local = slot
                slot InstValue::LocalSet bytecode.push
                slot values.push
            done
            0 = offset: u64
            for typ in returns.iter do
                values.pop InstValue::LocalGet bytecode.push
                if typ self.uses_automatic_storage then
                    destination InstValue::LocalGet bytecode.push
                    offset i64::try_from.unwrap InstValue::Push bytecode.push
                    InstValue::Add bytecode.push
                    InstValue::Dup bytecode.push
                    self.allocate_local = address
                    address InstValue::LocalSet bytecode.push
                    bytecode typ self.emit_typed_store
                    address InstValue::LocalGet bytecode.push
                    typ self
                        .state
                        .layouts
                        .inline_size
                        .unwrap = size
                    common::WORD_SIZE u64::try_from.unwrap size common::align_up offset + = offset
                fi
            done
            end_label InstValue::Label bytecode.push
        fi
    }

    fn compile_execute
        self:mut$FunctionPlanner
        typ:$common::Type
        owned:bool
        bytecode:mut$std::List[InstValue]
    {
        if typ common::Type::Function(function) is then
            self.allocate_local = closure
            closure InstValue::LocalSet bytecode.push
            bytecode function.return_types self.prepare_results drop
            closure InstValue::LocalGet bytecode.push
            self.state.checked = checked
            self.state.layouts function.return_types function.parameters.length checked plan_register_call
            InstValue::FnExec bytecode.push
            if owned then
                closure InstValue::LocalGet bytecode.push
                InstValue::ClosureDrop bytecode.push
            fi
        else
            "Missing checked callable type" self.record_failure
        fi
    }

    fn compile_call self:mut$FunctionPlanner name:$str bytecode:mut$std::List[InstValue] {
        if name self.compile_named_function then
            if
                name self
                    .state
                    .program
                    .native_calls
                    .has_str
            then
                name self
                    .state
                    .store
                    .get_function
                    .unwrap
                    .stack_effect
                    .return_types
                    .clone = returns
                bytecode returns self.prepare_results drop
                name.to_str InstValue::ExternCall bytecode.push
            else
                name self
                    .state
                    .store
                    .get_function
                    .unwrap
                    .stack_effect
                    .return_types
                    .clone = returns
                if
                    name self
                        .state
                        .checked
                        .find_body
                        .unwrap
                        .is_field_projection
                then
                    if 0 returns self.result_storage_size != then
                        0 InstValue::Push bytecode.push
                    fi
                else
                    bytecode returns self.prepare_results drop
                fi
                name.to_str InstValue::FnCall bytecode.push
            fi
        fi
    }

    fn compile_closure
        compiler:mut$FunctionPlanner
        store:$common::SymbolStore
        call:$semantic_body::Callable
        op:$semantic_body::OperationFacts
        bytecode:mut$std::List[InstValue]
    {
        call.name = name: $std::String

        if name.as_str compiler.compile_named_function ! then
            return
        fi
        name.as_str store
            .get_function
            .unwrap
            .clone = lambda
        lambda.captures.clone = captures

        # Zero-capture closures share a single static record so trait
        # dispatch and named-function pushes do not allocate per call.
        if 0 captures.length == then
            name.clone InstValue::FnPushStatic bytecode.push
        else
            # Each capture is followed by its ownership flag. The record
            # header stores the call and destruction functions.
            for capture in captures.iter do
                capture.name.as_str = capture_name: $str
                capture_name.as_str lambda.owned_captures common::string_list_contains = owns_capture
                owns_capture capture.typ compiler.is_copy_aggregate && = copies_aggregate
                if capture_name.as_str compiler.capture_slots.get_copy_str std::Option::Some(capture_index) is then
                    capture_index InstValue::CaptureLoad bytecode.push
                    if copies_aggregate then
                        bytecode capture.typ compiler.emit_heap_copy
                    elif owns_capture then
                        capture_index InstValue::CaptureFlagClear bytecode.push
                    fi
                else
                    capture_name op.resolve_storage_name = storage_name
                    bytecode owns_capture copies_aggregate ! && storage_name.as_str
                    compiler.emit_variable_get
                    if owns_capture capture.typ compiler.uses_automatic_storage && then
                        bytecode capture.typ compiler.emit_heap_copy
                    fi
                    if owns_capture copies_aggregate ! && then
                        if storage_name.as_str compiler.owner_flags.get_copy_str std::Option::Some(flag) is then
                            0 InstValue::Push bytecode.push
                            flag InstValue::LocalSet bytecode.push
                        fi
                    fi
                fi
                if owns_capture then 1 else 0 fi InstValue::Push bytecode.push
            done
            name.clone InstValue::FnPush bytecode.push
            lambda compiler.ensure_closure_destruction_function = drop_name
            drop_name InstValue::DropFn bytecode.push
            captures.length InstValue::ClosureRecord bytecode.push
        fi
    }
}

# Compile enum comparison (data-carrying enums)
impl FunctionPlanner {
    fn compile_enum_comparison
        compiler:mut$FunctionPlanner
        compare_value:InstValue
        bytecode:mut$std::List[InstValue]
    {
        compiler.allocate_local = local_a
        local_a InstValue::LocalSet bytecode.push
        InstValue::Load64 bytecode.push
        local_a InstValue::LocalGet bytecode.push
        InstValue::Load64 bytecode.push
        compare_value bytecode.push
    }
}

# Compile single op
impl FunctionPlanner {
    fn emit_inline_size
        compiler:mut$FunctionPlanner
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if
            target compiler
                .state
                .layouts
                .inline_size std::Option::Some(size) is
        then
            size i64::try_from.unwrap InstValue::Push bytecode.push
        else
            f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
        fi
    }

    fn emit_typed_load
        compiler:mut$FunctionPlanner
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if target compiler.uses_automatic_storage then
            bytecode target compiler.emit_inline_copy return
        fi
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation == then
                target compiler
                    .state
                    .layouts
                    .inline_size
                    .unwrap
                InstValue::ReadIndirect bytecode.push
                return
            fi
            if
                target compiler
                    .state
                    .layouts
                    .inline_size std::Option::Some(size) is
            then
                if 1 size == then
                    InstValue::Load8 bytecode.push
                elif 2 size == then
                    InstValue::Load16 bytecode.push
                elif 4 size == then
                    InstValue::Load32 bytecode.push
                elif 8 size == then
                    InstValue::Load64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure_string
                    return
                fi
                if common::VALUE_REPR_SIGNED representation == then
                    if target common::Type::Builtin(builtin) is then
                        builtin InstValue::NormalizeInt bytecode.push
                    fi
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }

    fn emit_typed_borrow
        self:mut$FunctionPlanner
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if target common::make_cstr_type.eq self.state.store target common::type_has_scalar_storage || then
            return
        fi
        if
            self.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if common::VALUE_REPR_INDIRECT representation != then
                bytecode target self.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" self.record_failure_string
        fi
    }

    fn emit_typed_copy
        compiler:mut$FunctionPlanner
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if target compiler.is_copy_aggregate then
            bytecode target compiler.emit_inline_copy return
        fi
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if
                common::VALUE_REPR_INDIRECT representation ==
                compiler.state.store target common::type_has_scalar_storage ||
            then
                bytecode target compiler.emit_typed_load
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }

    fn emit_value_storage
        self:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        typ self
            .state
            .layouts
            .inline_size
            .unwrap = size
        if typ self.uses_automatic_storage then
            size self.allocate_value_storage InstValue::LocalAddress bytecode.push
        else
            size i64::try_from.unwrap InstValue::Push bytecode.push
            InstValue::HeapAlloc bytecode.push
        fi
    }

    fn emit_inline_copy
        self:mut$FunctionPlanner
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        target self
            .state
            .layouts
            .inline_size
            .unwrap = size
        size self.allocate_value_storage = copy_local
        copy_local InstValue::LocalAddress bytecode.push
        size InstValue::MoveBytes bytecode.push
        copy_local InstValue::LocalAddress bytecode.push
    }

    # Move an independently allocated body into this frame. Its fields keep
    # their owners, and only the old backing allocation is released.
    fn move_heap_value
        self:mut$FunctionPlanner
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        self.allocate_local = source
        InstValue::Dup bytecode.push
        source InstValue::LocalSet bytecode.push
        bytecode typ self.emit_inline_copy
        source InstValue::LocalGet bytecode.push
        InstValue::HeapFree bytecode.push
    }

    # Escaping raw owners and closure captures need storage with their own lifetime.
    fn emit_heap_copy
        self:mut$FunctionPlanner
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        target self
            .state
            .layouts
            .inline_size
            .unwrap InstValue::ReadIndirect bytecode.push
    }

    fn emit_typed_store
        compiler:mut$FunctionPlanner
        target:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if
            compiler.state.store target common::type_value_representation std::Option::Some(representation) is
        then
            if
                target compiler
                    .state
                    .layouts
                    .inline_size std::Option::Some(size) is
            then
                if common::VALUE_REPR_INDIRECT representation == then
                    if target compiler.uses_automatic_storage then
                        size InstValue::MoveBytes bytecode.push
                    else
                        size InstValue::WriteIndirect bytecode.push
                    fi
                elif 1 size == then
                    InstValue::Store8 bytecode.push
                elif 2 size == then
                    InstValue::Store16 bytecode.push
                elif 4 size == then
                    InstValue::Store32 bytecode.push
                elif 8 size == then
                    InstValue::Store64 bytecode.push
                else
                    f"Direct value `{target.format}` has unsupported size {size}"
                    compiler.record_failure_string
                fi
            else
                f"Cannot determine inline size of `{target.format}`" compiler.record_failure_string
            fi
        else
            f"Cannot determine representation of `{target.format}`" compiler.record_failure_string
        fi
    }
}

impl FunctionPlanner {
    fn compile_temporary_binding
        compiler:mut$FunctionPlanner
        op:$semantic_body::OperationFacts
        binding:$common::BindingReference
        binding_depth:u64
        bytecode:mut$std::List[InstValue]
    {
        if binding.storage_name.as_str compiler.local_slots.has_str ! then
            compiler.allocate_local = local
            local binding.storage_name.clone compiler.local_slots.set
        fi
        std::List[u64]::new = spilled
        for depth in binding_depth 0 std::Range::new do
            compiler.allocate_local = local
            local InstValue::LocalSet bytecode.push
            local spilled.push
        done
        if op.effects std::Option::Some(ownership) is then
            for event in ownership.assignments.iter do
                bytecode event compiler.compile_active_owner_cleanup
            done
        fi
        bytecode binding.storage_name.as_str compiler.emit_variable_set
        bytecode false binding.storage_name.as_str compiler.emit_variable_get
        while spilled.is_empty ! do
            spilled.pop InstValue::LocalGet bytecode.push
        done
        if op.effects std::Option::Some(ownership) is then
            for event in ownership.assignments.iter do
                bytecode event.generation event.storage_name.as_str compiler.set_owner_flag
            done
        fi
    }

    fn compile_direct_op
        self:mut$FunctionPlanner
        kind:$semantic_body::PrimitiveKind
        typ:$common::Type
        op:$semantic_body::OperationFacts
        bytecode:mut$std::List[InstValue]
    -> bool {
        typ = copied_type: $common::Type
        if copied_type self.is_copy_aggregate then
            if kind semantic_body::PrimitiveKind::Dup is then
                InstValue::Dup bytecode.push
                bytecode copied_type self.emit_inline_copy
                true return
            elif kind semantic_body::PrimitiveKind::Over is then
                InstValue::Over bytecode.push
                bytecode copied_type self.emit_inline_copy
                true return
            fi
        fi
        typechecker::CheckedValueKind::Other = value_kind
        std::Option[common::BuiltinType]::None = builtin_hint
        typ self
            .state
            .checked
            .get_value_kind = value_kind
        if typ common::Type::Builtin(builtin) is then
            builtin copy std::Option::Some = builtin_hint
        fi
        false = string_value
        if builtin_hint std::Option::Some(builtin) is then
            common::BuiltinType::Str builtin == = string_value
        fi
        kind primitive_to_inst = direct_inst_opt
        # Check direct op-to-inst mapping first
        direct_inst_opt match
            std::Option::Some(direct_inst) => {
                # Data-carrying enum comparison
                if
                    kind semantic_body::PrimitiveKind::Eq is
                    kind semantic_body::PrimitiveKind::Ne is ||
                    kind semantic_body::PrimitiveKind::Lt is ||
                    kind semantic_body::PrimitiveKind::Le is ||
                    kind semantic_body::PrimitiveKind::Gt is ||
                    kind semantic_body::PrimitiveKind::Ge is ||
                    value_kind typechecker::CheckedValueKind::Enum is &&
                then
                    bytecode direct_inst self.compile_enum_comparison
                    true return
                fi
                # String content comparison
                if
                    kind semantic_body::PrimitiveKind::Eq is
                    kind semantic_body::PrimitiveKind::Ne is ||
                    string_value &&
                then
                    InstValue::StrEq bytecode.push
                    if kind semantic_body::PrimitiveKind::Ne is then
                        InstValue::Not bytecode.push
                    fi
                    true return
                fi
                if
                    kind semantic_body::PrimitiveKind::Eq is
                    kind semantic_body::PrimitiveKind::Ne is ||
                    value_kind typechecker::CheckedValueKind::StringStr is &&
                then
                    InstValue::StringStrEq bytecode.push
                    if kind semantic_body::PrimitiveKind::Ne is then
                        InstValue::Not bytecode.push
                    fi
                    true return
                fi
                if
                    kind semantic_body::PrimitiveKind::Eq is
                    kind semantic_body::PrimitiveKind::Ne is ||
                    value_kind typechecker::CheckedValueKind::StrString is &&
                then
                    InstValue::StrStringEq bytecode.push
                    if kind semantic_body::PrimitiveKind::Ne is then
                        InstValue::Not bytecode.push
                    fi
                    true return
                fi
                # Data-carrying enum print
                if
                    kind semantic_body::PrimitiveKind::PrintInt is value_kind typechecker::CheckedValueKind::Enum is &&
                then
                    InstValue::Load64 bytecode.push
                    InstValue::PrintInt bytecode.push
                    true return
                fi
                if builtin_hint std::Option::Some(builtin) is then
                    builtin direct_inst kind.select_typed_instruction bytecode.push
                else
                    direct_inst bytecode.push
                fi
                if kind.produces_integer_result then
                    bytecode typ self.emit_integer_normalization
                fi
                true return
            }
            std::Option::None => {}
        end
        false
    }

    fn compile_wrapping_numeric_op
        self:mut$FunctionPlanner
        kind:$semantic_body::PrimitiveKind
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        InstValue::Swap bytecode.push
        kind match
            semantic_body::PrimitiveKind::WrappingAdd => InstValue::Add bytecode.push
            semantic_body::PrimitiveKind::WrappingSub => InstValue::Sub bytecode.push
            semantic_body::PrimitiveKind::WrappingMul => InstValue::Mul bytecode.push
            _ => {}
        end
        bytecode typ self.emit_integer_normalization
    }

    fn compile_numeric_try
        self:mut$FunctionPlanner
        conversion:$common::NumericTry
        wrapper:$std::String
        output:mut$std::List[InstValue]
    {
        if conversion.source common::Type::Builtin(source) is then
            conversion.target source InstValue::NumericTry output.push
            output wrapper.as_str self.compile_call
        else
            "Unspecialized numeric conversion source" self.record_failure
        fi
    }

    fn compile_float_round
        self:mut$FunctionPlanner
        rounding:$common::FloatRound
        output:mut$std::List[InstValue]
    {
        rounding.method.as_str match
            "__float_floor" => RoundingKind::Floor
            "__float_ceil" => RoundingKind::Ceil
            "__float_trunc" => RoundingKind::Trunc
            "__float_round" => RoundingKind::Round
            _ => {
                "Invalid checked rounding operation" self.record_failure return
            }
        end = kind
        rounding.target kind InstValue::FloatRound output.push
    }

    fn compile_owned_assignment
        self:mut$FunctionPlanner
        kind:$semantic_body::BindingKind
        binding:$common::BindingReference
        typ:$common::Type
        op:$semantic_body::OperationFacts
        bytecode:mut$std::List[InstValue]
    {
        if op.effects std::Option::Some(ownership) is then
            for event in ownership.assignments.iter do
                # A first assignment outside a loop cannot replace a live owner.
                if self.loop_targets.is_empty ! event.storage_name.as_str self.owner_flags.has_str || then
                    bytecode event self.compile_active_owner_cleanup
                fi
            done
        fi
        bytecode typ binding kind self.compile_assignment
        if op.effects std::Option::Some(ownership) is then
            for event in ownership.assignments.iter do
                bytecode event.generation event.storage_name.as_str self.set_owner_flag
            done
        fi
    }

    fn compile_leaf
        self:mut$FunctionPlanner
        leaf:$semantic_body::Leaf
        bytecode:mut$std::List[InstValue]
    {
        bytecode leaf.facts self.compile_facts
        leaf.action match
            semantic_body::Action::Primitive(kind typ) => bytecode leaf.facts typ kind self.compile_primitive
            semantic_body::Action::Intrinsic(kind) => bytecode kind self.compile_intrinsic
            semantic_body::Action::Execute(typ owned) => bytecode owned typ self.compile_execute
            semantic_body::Action::IntoRaw(typ) => {
                if typ self.uses_automatic_storage then
                    bytecode typ self.emit_heap_copy
                fi
            }
            semantic_body::Action::Integer(value _) => value.value InstValue::Push bytecode.push
            semantic_body::Action::Float(value typ) => {
                if typ common::make_f32_type.eq then
                    value.clone InstValue::PushFloat32 bytecode.push
                else
                    value.clone InstValue::PushFloat64 bytecode.push
                fi
            }
            semantic_body::Action::Boolean(value) => value InstValue::Push bytecode.push
            semantic_body::Action::Character(value) => value InstValue::PushChar bytecode.push
            semantic_body::Action::String(value) => value.as_str self.intern_string InstValue::PushStr bytecode.push
            semantic_body::Action::Call(call) => bytecode call.name.as_str self.compile_call
            semantic_body::Action::Closure(call) => bytecode leaf.facts call self.state.store self.compile_closure
            semantic_body::Action::Binding(kind binding typ) => {
                if
                    kind semantic_body::BindingKind::PushVar == kind semantic_body::BindingKind::PushCapture == ||
                then
                    bytecode leaf.facts typ binding kind self.compile_binding_value
                else
                    bytecode leaf.facts typ binding kind self.compile_owned_assignment
                fi
            }
            semantic_body::Action::OwnerMoved(binding) => {
                if binding.storage_name self.owner_flags.get_copy std::Option::Some(flag) is then
                    0 InstValue::Push bytecode.push
                    flag InstValue::LocalSet bytecode.push
                fi
            }
            semantic_body::Action::Temporary(binding depth) => bytecode depth binding leaf.facts self.compile_temporary_binding
            semantic_body::Action::Enum(variant typ) => {
                if
                    variant.enum_name self
                        .state
                        .store
                        .enums
                        .get std::Option::Some(declaration) is
                then
                    if declaration common::has_inner_values then
                        bytecode typ declaration variant self.compile_enum_variant
                    else
                        self variant require_variant_ordinal InstValue::Push bytecode.push
                    fi
                else
                    f"Enum `{variant.enum_name}` is missing during target planning" self.record_failure_string
                fi
            }
            semantic_body::Action::PatternTest(variant typ) => bytecode leaf.facts typ variant self.state.store self.compile_is_check
            semantic_body::Action::Struct(shape typ) => bytecode typ shape self.compile_struct_new
            semantic_body::Action::StructFields(literal typ) => bytecode typ literal self.state.store self.compile_struct_literal
            semantic_body::Action::ConstrainedCall(_) => "Deferred dispatch reached target planning" self.record_failure
            semantic_body::Action::ConstrainedClosure(_) => "Deferred dispatch reached target planning" self.record_failure
            semantic_body::Action::SizeOf(typ) => {
                if
                    typ self
                        .state
                        .layouts
                        .inline_size std::Option::Some(size) is
                then
                    if size i64::try_from std::Option::Some(signed_size) is then
                        signed_size InstValue::Push bytecode.push
                    else
                        f"Inline size of `{typ.format}` exceeds the supported constant range" self.record_failure_string
                    fi
                else
                    f"Cannot determine inline size of `{typ.format}`" self.record_failure_string
                fi
            }
            semantic_body::Action::PtrAsRef(typ) => bytecode typ self.emit_typed_borrow
            semantic_body::Action::PtrAsMut(typ) => bytecode typ self.emit_typed_borrow
            semantic_body::Action::PtrFromRaw(typ) => {
                if typ self.uses_automatic_storage then
                    bytecode typ self.move_heap_value
                fi
            }
            semantic_body::Action::PtrRead(typ) => bytecode typ self.emit_typed_load
            semantic_body::Action::PtrWrite(typ) => bytecode typ self.emit_typed_store
            semantic_body::Action::StructMemberProject(member typ) => bytecode typ member self.compile_member_projection
            semantic_body::Action::StructMemberStore(member typ) => bytecode typ member self.compile_member_store
            semantic_body::Action::DestructionFn(typ) => {
                if typ self.destruction_needs_function then
                    StorageKind::Heap typ self.ensure_destruction_function InstValue::DropFn bytecode.push
                else
                    0 InstValue::Push bytecode.push
                fi
            }
            semantic_body::Action::NumericConvert(conversion) => conversion.clone InstValue::NumericConvert bytecode.push
            semantic_body::Action::NumericTry(conversion wrapper) => bytecode wrapper conversion self.compile_numeric_try
            semantic_body::Action::IntegerTry(conversion wrapper) => {
                InstValue::Swap bytecode.push
                conversion.clone InstValue::IntegerTry bytecode.push
                bytecode wrapper.as_str self.compile_call
            }
            semantic_body::Action::FloatRound(rounding) => bytecode rounding self.compile_float_round
            semantic_body::Action::FstringConcat(count) => {
                count InstValue::FstringConcat bytecode.push
                bytecode self.store_runtime_string
            }
            semantic_body::Action::PrimitiveToStr(builtin) => {
                builtin copy InstValue::PrimitiveToStr bytecode.push
                bytecode self.store_runtime_string
            }
        end
    }

    # Runtime formatting returns the owned text buffer. String's one-word
    # wrapper lives in this frame, like a source-level String construction.
    fn store_runtime_string self:mut$FunctionPlanner bytecode:mut$std::List[InstValue] {
        self.allocate_local = slot
        slot InstValue::LocalSet bytecode.push
        slot InstValue::LocalAddress bytecode.push
    }

    fn compile_binding_value
        self:mut$FunctionPlanner
        kind:$semantic_body::BindingKind
        binding:$common::BindingReference
        typ:$common::Type
        facts:$semantic_body::OperationFacts
        bytecode:mut$std::List[InstValue]
    {
        if kind semantic_body::BindingKind::PushCapture == then
            if binding.name self.capture_slots.get_copy std::Option::Some(index) is then
                index InstValue::CaptureLoad bytecode.push
                if facts.moves_owner then
                    if typ self.is_copy_aggregate then
                        bytecode typ self.emit_inline_copy
                    else
                        if typ self.uses_automatic_storage then
                            bytecode typ self.move_heap_value
                        fi
                        index InstValue::CaptureFlagClear bytecode.push
                    fi
                fi
            else
                f"Capture `{binding.name}` is missing during target planning" self.record_failure_string
            fi
        else
            if typ binding.storage_name.as_str self.lends_owned_scalar then
                binding.storage_name.as_str self.resolve_local InstValue::LocalAddress bytecode.push
                return
            fi
            bytecode facts.moves_owner binding.storage_name.as_str self.emit_variable_get
            if facts.moves_owner then
                if binding.storage_name self.owner_flags.get_copy std::Option::Some(flag) is then
                    0 InstValue::Push bytecode.push
                    flag InstValue::LocalSet bytecode.push
                fi
            fi
        fi
        bytecode typ self.emit_integer_normalization
    }

    fn compile_member_address
        self:mut$FunctionPlanner
        member:$common::StructMemberAccess
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    -> std::Option[ResolvedStructField] {
        member.struct_name.clone common::GenericType::new common::Type::Generic = owner
        if self.function std::Option::Some(function) is then
            if
                0 function
                    .stack_effect
                    .parameters
                    .length !=
            then
                0 function
                    .stack_effect
                    .parameters
                    .get
                    .typ = receiver: $common::Type
                if receiver.borrow_target std::Option::Some(target) is then
                    target.clone = owner
                fi
            fi
        fi
        bytecode typ owner member self.compile_field_address
    }

    fn compile_field_address
        self:mut$FunctionPlanner
        member:$common::StructMemberAccess
        owner:$common::Type
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    -> std::Option[ResolvedStructField] {
        self.state = state
        if state.layouts owner typ state.store member resolve_struct_field std::Option::Some(field) is then
            if 0 field.storage.offset != then
                field.storage.offset i64::try_from.unwrap InstValue::Push bytecode.push
                InstValue::Add bytecode.push
            fi
            field std::Option::Some
        else
            f"Cannot determine member {member.member_index} storage of struct `{member.struct_name}`" self.record_failure_string
            std::Option[ResolvedStructField]::None
        fi
    }

    # Intermediate fields project their owner value. The last field keeps its address.
    fn compile_projected_address
        self:mut$FunctionPlanner
        binding:$common::BindingReference
        members:$std::List[common::ProjectedMember]
        bytecode:mut$std::List[InstValue]
    {
        if binding.name self.capture_slots.get_copy std::Option::Some(slot) is then
            slot InstValue::CaptureLoad bytecode.push
        else
            bytecode false binding.storage_name.as_str self.emit_variable_get
        fi
        for index in members.length 0 std::Range::new do
            index members.get = projected
            if
                bytecode projected.typ projected.owner projected.member self.compile_field_address std::Option::Some(field) is
            else
                return
            fi
            if index 1 + members.length < then
                bytecode field.storage field.typ self.emit_field_projection
            fi
        done
    }

    fn compile_member_projection
        self:mut$FunctionPlanner
        member:$common::StructMemberAccess
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if bytecode typ member self.compile_member_address std::Option::Some(field) is then
            bytecode field.storage field.typ self.emit_field_projection
        fi
    }

    fn compile_member_store
        self:mut$FunctionPlanner
        member:$common::StructMemberAccess
        typ:$common::Type
        bytecode:mut$std::List[InstValue]
    {
        if bytecode typ member self.compile_member_address std::Option::Some(field) is then
            InstValue::Dup bytecode.push
            bytecode field.storage field.typ self.compile_field_destruction
            bytecode field.storage field.typ self.emit_field_store
        fi
    }
}

impl FunctionPlanner {
    fn compile_scalar_input
        self:mut$FunctionPlanner
        input:$common::ScalarInput
        bytecode:mut$std::List[InstValue]
    {
        if self.state.store input.typ common::type_has_scalar_storage ! then
            return
        fi
        std::List[u64]::new = spilled
        for depth in input.depth 0 std::Range::new do
            self.allocate_local = slot
            slot InstValue::LocalSet bytecode.push
            slot spilled.push
        done
        input.kind match
            common::ScalarInputKind::BorrowValue => {
                self.allocate_local = slot
                slot InstValue::LocalSet bytecode.push
                slot InstValue::LocalAddress bytecode.push
            }
            common::ScalarInputKind::BorrowBinding(binding) => {
                InstValue::Drop bytecode.push
                if binding.name self.capture_slots.get_copy std::Option::Some(slot) is then
                    slot InstValue::CaptureAddress bytecode.push
                else
                    binding.storage_name.as_str self.resolve_local = slot
                    slot InstValue::LocalAddress bytecode.push
                fi
            }
            common::ScalarInputKind::BorrowField(binding members) => {
                InstValue::Drop bytecode.push
                bytecode members binding self.compile_projected_address
            }
            common::ScalarInputKind::StoreField(binding members target) => {
                bytecode members binding self.compile_projected_address
                bytecode target.storage_name.as_str self.emit_variable_set
            }
            common::ScalarInputKind::Read => bytecode input.typ self.emit_typed_load
        end
        while spilled.is_empty ! do
            spilled.pop InstValue::LocalGet bytecode.push
        done
    }

    fn compile_facts
        self:mut$FunctionPlanner
        facts:$semantic_body::OperationFacts
        bytecode:mut$std::List[InstValue]
    {
        facts.origin.clone InstValue::Source bytecode.push
        if facts.effects std::Option::Some(effects) is then
            for event in effects.cleanups.iter do
                bytecode event self.compile_owner_cleanup
            done
            for input in effects.scalar_inputs.iter do
                bytecode input self.compile_scalar_input
            done
        fi
    }

    fn compile_conditional
        self:mut$FunctionPlanner
        conditional:$semantic_body::Conditional
        bytecode:mut$std::List[InstValue]
    {
        self.new_label = end_label
        for index in conditional.branches.length 0 std::Range::new do
            index conditional.branches.get = branch
            index 1 + conditional.branches.length < conditional.alternative.is_some || = has_alternative
            end_label = next_label
            if has_alternative then
                self.new_label = next_label
            fi
            bytecode branch.entry self.compile_facts
            bytecode branch.condition self.compile_body
            bytecode branch.test self.compile_facts
            next_label InstValue::JumpNe bytecode.push
            bytecode branch.consequent self.compile_body
            # Boundary cleanup belongs to both incoming paths.
            if index 1 + conditional.branches.length < then
                bytecode index 1 + conditional
                    .branches
                    .get
                    .entry self.compile_facts
            elif conditional.alternative std::Option::Some(alternative) is then
                bytecode alternative.entry self.compile_facts
            else
                bytecode conditional.exit self.compile_facts
            fi
            if has_alternative then
                end_label InstValue::Jump bytecode.push
                next_label InstValue::Label bytecode.push
            fi
        done
        if conditional.alternative std::Option::Some(alternative) is then
            bytecode alternative.entry self.compile_facts
            bytecode alternative.body self.compile_body
            bytecode conditional.exit self.compile_facts
        fi
        end_label InstValue::Label bytecode.push
        bytecode conditional.exit self.compile_facts
    }

    fn compile_loop
        self:mut$FunctionPlanner
        loop:$semantic_body::Loop
        bytecode:mut$std::List[InstValue]
    {
        self.new_label = start_label
        self.new_label = end_label
        end_label start_label LoopTargets self.loop_targets.push
        bytecode loop.entry self.compile_facts
        start_label InstValue::Label bytecode.push
        bytecode loop.condition self.compile_body
        bytecode loop.test self.compile_facts
        end_label InstValue::JumpNe bytecode.push
        bytecode loop.body self.compile_body
        bytecode loop.exit self.compile_facts
        start_label InstValue::Jump bytecode.push
        end_label InstValue::Label bytecode.push
        bytecode loop.exit self.compile_facts
        self.loop_targets.pop drop
    }

    fn plan_enum_dispatch
        self:mut$FunctionPlanner
        body:$semantic_body::Match
    -> std::Option[EnumDispatch] {
        if ENUM_DISPATCH_MIN_ARMS body.arms.length > then
            std::Option[EnumDispatch]::None return
        fi
        # Checked enum arms share one declaration. Borrow its name before the
        # loop so rejected dispatch candidates retain no temporary name storage.
        0 body
            .arms
            .get
            .pattern match
            common::PatternValue::EnumVariant(variant) => variant.enum_name.as_str
            _ => std::Option[EnumDispatch]::None return
        end = enum_name
        false = wildcard_seen
        for arm in body.arms.iter do
            if wildcard_seen then
                std::Option[EnumDispatch]::None return
            fi
            if
                arm
                    .guard
                    .get_nodes
                    .is_empty !
            then
                std::Option[EnumDispatch]::None return
            fi
            if arm.entry.effects std::Option::Some(effects) is then
                if effects.cleanups.is_empty ! then
                    std::Option[EnumDispatch]::None return
                fi
            fi
            arm.pattern match
                common::PatternValue::EnumVariant(variant) => {
                    for child in variant.bindings.iter do
                        if child common::PatternValue::Binding is ! child pattern::is_wildcard ! && then
                            std::Option[EnumDispatch]::None return
                        fi
                    done
                    if common::MATCH_WILDCARD variant.variant_name.as_str == then
                        true = wildcard_seen
                    fi
                }
                _ => std::Option[EnumDispatch]::None return
            end
        done
        enum_name self
            .state
            .store
            .enums
            .get_str match
            std::Option::Some(declaration) => declaration common::has_inner_values declaration.variants.length
            std::Option::None => std::Option[EnumDispatch]::None return
        end = variant_count = has_payload
        std::List[u64]::new = labels
        for arm in body.arms.iter do
            self.new_label labels.push
        done
        labels.length 1 - labels.get copy = fallback
        std::List[u64]::new = targets
        for variant_index in variant_count 0 std::Range::new do
            fallback targets.push
        done
        0 = index: u64
        for arm in body.arms.iter do
            if arm.pattern common::PatternValue::EnumVariant(variant) is then
                if variant.ordinal std::Option::Some(ordinal) is then
                    index labels.get copy ordinal u64::try_from.unwrap targets.set
                fi
            fi
            1 += index
        done
        has_payload fallback targets labels EnumDispatch std::Option::Some
    }

    fn compile_match
        self:mut$FunctionPlanner
        match_body:$semantic_body::Match
        bytecode:mut$std::List[InstValue]
    {
        bytecode match_body.entry self.compile_facts
        self.new_label = end_label
        self.allocate_local = subject
        subject InstValue::LocalSet bytecode.push
        match_body self.plan_enum_dispatch = dispatch
        dispatch = dispatch_ref: $std::Option[EnumDispatch]
        if dispatch_ref std::Option::Some(plan) is then
            subject InstValue::LocalGet bytecode.push
            if plan.has_payload then
                InstValue::Load64 bytecode.push
            fi
            plan.fallback plan.targets.clone InstValue::JumpTable bytecode.push
        fi
        for index in match_body.arms.length 0 std::Range::new do
            index match_body.arms.get = arm
            index 1 + match_body.arms.length == = is_last
            end_label = next_label
            if is_last ! then
                self.new_label = next_label
            fi
            if dispatch_ref std::Option::Some(plan) is then
                index plan.labels.get copy InstValue::Label bytecode.push
            fi
            if 0 index != then
                bytecode arm.entry self.compile_facts
            fi
            std::List[common::PatternValue]::new = alternatives
            if arm.pattern common::PatternValue::Alternatives(values) is then
                values.clone = alternatives
            else
                arm.pattern.clone alternatives.push
            fi
            self.allocate_local = selected
            self.new_label = matched
            0 = alternative_index: u64
            for alternative in alternatives.iter do
                next_label = failed
                if alternative_index 1 + alternatives.length < then
                    self.new_label = failed
                fi
                bytecode failed subject arm.subject_type alternative self.emit_pattern_test
                bytecode arm.entry subject arm.subject_type alternative self.emit_pattern_bindings
                alternative_index i64::try_from.unwrap InstValue::Push bytecode.push
                selected InstValue::LocalSet bytecode.push
                matched InstValue::Jump bytecode.push
                if alternative_index 1 + alternatives.length < then
                    failed InstValue::Label bytecode.push
                fi
                1 += alternative_index
            done
            matched InstValue::Label bytecode.push
            if
                arm
                    .guard
                    .get_nodes
                    .is_empty !
            then
                if is_last then
                    "Guarded final match arm" self.record_failure return
                fi
                bytecode arm.guard self.compile_body
                next_label InstValue::JumpNe bytecode.push
            fi
            if arm.entry.effects std::Option::Some(ownership) is then
                for event in ownership.assignments.iter do
                    bytecode event.generation event.storage_name.as_str self.set_owner_flag
                done
            fi
            self.new_label = committed
            0 = destruction_index: u64
            for alternative in alternatives.iter do
                self.new_label = next_destruction
                if destruction_index 1 + alternatives.length < then
                    selected InstValue::LocalGet bytecode.push
                    bytecode destruction_index i64::try_from.unwrap emit_int_eq
                    next_destruction InstValue::JumpNe bytecode.push
                fi
                subject InstValue::LocalGet bytecode.push
                arm.entry arm.subject_type self.value_storage bytecode arm.subject_type alternative self.compile_pattern_destruction
                committed InstValue::Jump bytecode.push
                next_destruction InstValue::Label bytecode.push
                1 += destruction_index
            done
            committed InstValue::Label bytecode.push
            bytecode arm.body self.compile_body
            if is_last then
                bytecode match_body.exit self.compile_facts
            else
                bytecode index 1 + match_body
                    .arms
                    .get
                    .entry self.compile_facts
            fi
            if is_last ! then
                end_label InstValue::Jump bytecode.push
                next_label InstValue::Label bytecode.push
            fi
        done
        end_label InstValue::Label bytecode.push
        bytecode match_body.exit self.compile_facts
    }

    fn compile_node
        self:mut$FunctionPlanner
        node:$semantic_body::Node
        bytecode:mut$std::List[InstValue]
    {
        node match
            semantic_body::Node::Unreachable(_) => {}
            semantic_body::Node::Leaf(leaf) => bytecode leaf self.compile_leaf
            semantic_body::Node::Conditional(conditional) => bytecode conditional self.compile_conditional
            semantic_body::Node::Loop(loop) => bytecode loop self.compile_loop
            semantic_body::Node::Match(match_body) => bytecode match_body self.compile_match
            semantic_body::Node::Region(region) => {
                bytecode region.entry self.compile_facts
                bytecode region.body self.compile_body
                bytecode region.exit self.compile_facts
            }
            semantic_body::Node::Group(group) => {
                bytecode group.facts self.compile_facts
                bytecode group.body self.compile_body
            }
            semantic_body::Node::Array(array) => {
                bytecode array.facts self.compile_facts
                bytecode array self.compile_push_array
            }
        end
    }

    fn compile_body
        self:mut$FunctionPlanner
        body:$semantic_body::Body
        bytecode:mut$std::List[InstValue]
    {
        for node in body.get_nodes.iter do
            if self.has_failed then
                return
            fi
            bytecode node self.compile_node
        done
    }
}

fn finalize_frame
    instructions:std::List[InstValue]
    locals_count:u64
    owner_flags:$std::Map[std::String u64]
    is_root:bool
-> std::List[InstValue] {
    std::List[InstValue]::new = output
    if 0 locals_count != then
        locals_count InstValue::LocalsInit output.push
        for flag in owner_flags.iter do
            0 InstValue::Push output.push
            flag.second copy InstValue::LocalSet output.push
        done
    fi
    instructions.reverse
    while instructions.is_empty ! do
        instructions.pop = instruction
        if instruction InstValue::FnReturn is 0 locals_count != && then
            locals_count InstValue::LocalsUninit output.push
        fi
        instruction output.push
    done
    if 0 locals_count != then
        locals_count InstValue::LocalsUninit output.push
    fi
    if is_root ! then
        InstValue::FnReturn output.push
    fi
    output
}

fn plan_function
    checked:$typechecker::CheckedProgram
    state:mut$BackendPlanner
    work:$FunctionWork
-> FunctionPlan {
    std::List[InstValue]::new = output
    work match
        FunctionWork::Checked(name) => {
            name.as_str checked
                .get_store
                .get_function
                .unwrap = function
            name.as_str checked.find_body.unwrap = body
            function state FunctionPlanner::for_function = compiler
            function.location.clone InstValue::Source output.push
            compiler.new_label InstValue::Label output.push
            output compiler.begin_results
            output body compiler.compile_body
            output compiler.finish_results
            function.captures.length false compiler.owner_flags compiler.locals_count output finalize_frame FunctionPlan::new
        }
        FunctionWork::Destruction(name typ storage_kind) => {
            common::empty_location name.clone common::Function::new = function
            function state FunctionPlanner::for_function = compiler
            storage_kind copy typ.clone DestructionNode::Value = node
            output node compiler.compile_destruction_entry
            0 false compiler.owner_flags compiler.locals_count output finalize_frame FunctionPlan::new
        }
        FunctionWork::RecursiveDestruction(name nodes) => {
            common::empty_location name.clone common::Function::new = function
            function state FunctionPlanner::for_function = compiler
            output nodes compiler.compile_recursive_destruction
            0 false compiler.owner_flags compiler.locals_count output finalize_frame FunctionPlan::new
        }
        FunctionWork::ContinuationGrowth(name) => {
            common::empty_location name.clone common::Function::new = function
            function state FunctionPlanner::for_function = compiler
            output compiler.compile_continuation_growth
            0 false compiler.owner_flags compiler.locals_count output finalize_frame FunctionPlan::new
        }
        FunctionWork::ClosureDestruction(name lambda_name) => {
            common::empty_location name.clone common::Function::new = function
            function state FunctionPlanner::for_function = compiler
            lambda_name.clone DestructionNode::Closure = node
            output node compiler.compile_destruction_entry
            0 false compiler.owner_flags compiler.locals_count output finalize_frame FunctionPlan::new
        }
    end
}

impl FunctionWork {
    fn get_name self:$FunctionWork -> std::String {
        self match
            FunctionWork::Checked(name) => name.clone
            FunctionWork::Destruction(name) => name.clone
            FunctionWork::RecursiveDestruction(name) => name.clone
            FunctionWork::ContinuationGrowth(name) => name.clone
            FunctionWork::ClosureDestruction(name _) => name.clone
        end
    }
}

fn does_function_name_precede left:$std::String right:$std::String -> bool {
    for pair in right.iter left.iter.zip do
        if pair.first pair.second != then
            pair.second pair.first > return
        fi
    done
    right.length left.length >
}

impl FunctionPlanner {
    fn is_static_element self:$FunctionPlanner leaf:$semantic_body::Leaf -> bool {
        leaf.action match
            semantic_body::Action::Integer(_) => true
            semantic_body::Action::Boolean(_) => true
            semantic_body::Action::Character(_) => true
            semantic_body::Action::String(_) => true
            semantic_body::Action::Enum(variant _) => {
                if
                    variant.enum_name self
                        .state
                        .store
                        .enums
                        .get std::Option::Some(declaration) is
                then
                    declaration common::has_inner_values !
                else
                    false
                fi
            }
            semantic_body::Action::Closure(call) => {
                if
                    call.name.as_str self
                        .state
                        .store
                        .get_function std::Option::Some(function) is
                then
                    function.captures.is_empty
                else
                    false
                fi
            }
            _ => false
        end
    }

    fn is_static_sequence self:$FunctionPlanner body:$semantic_body::Body -> bool {
        for node in body.get_nodes.iter do
            node match
                semantic_body::Node::Leaf(leaf) => {
                    if leaf self.is_static_element ! then false return fi
                }
                _ => false return
            end
        done
        true
    }
}

fn has_calling_effects facts:$semantic_body::OperationFacts -> bool {
    if facts.effects std::Option::Some(effects) is then
        effects.cleanups.is_empty ! effects.assignments.is_empty ! ||
    else
        false
    fi
}

fn is_leaf_action
    action:$semantic_body::Action
    checked:$typechecker::CheckedProgram
    templates:$std::Map[std::String LeafTemplate]
-> bool {
    action match
        semantic_body::Action::Call(call) => call.name templates.has
        semantic_body::Action::Closure(_) => false
        semantic_body::Action::ConstrainedCall(_) => false
        semantic_body::Action::ConstrainedClosure(_) => false
        semantic_body::Action::DestructionFn(_) => false
        semantic_body::Action::NumericTry(_) => false
        semantic_body::Action::IntegerTry(_) => false
        semantic_body::Action::Primitive(kind typ) => {
            if kind semantic_body::PrimitiveKind::Drop == then
                typ checked.needs_destruction !
            else
                true
            fi
        }
        semantic_body::Action::PatternTest(variant typ) => typ checked.needs_destruction !
        semantic_body::Action::StructMemberStore(member typ) => typ checked.needs_destruction !
        _ => true
    end
}

fn is_leaf_node
    node:$semantic_body::Node
    checked:$typechecker::CheckedProgram
    templates:$std::Map[std::String LeafTemplate]
-> bool {
    node match
        semantic_body::Node::Leaf(leaf) => leaf.facts has_calling_effects ! templates checked leaf.action is_leaf_action &&
        semantic_body::Node::Group(group) => group.facts has_calling_effects ! templates checked group.body is_leaf_candidate &&
        semantic_body::Node::Region(region) => {
            region.entry has_calling_effects ! region.exit has_calling_effects ! &&
            templates checked region.body is_leaf_candidate &&
        }
        semantic_body::Node::Unreachable(_) => true
        _ => false
    end
}

fn is_leaf_candidate
    body:$semantic_body::Body
    checked:$typechecker::CheckedProgram
    templates:$std::Map[std::String LeafTemplate]
-> bool {
    # Plan call-free bodies and calls with an existing bounded template first.
    # Physical instruction eligibility and its fixed budget bound retained templates.
    for node in body.get_nodes.iter do
        if templates checked node is_leaf_node ! then
            false return
        fi
    done
    true
}

# Each current Casa value has a word carrier, including indirect aggregate
# addresses. Automatic aggregate results also need hidden destination storage.
# Keep that convention and signatures larger than the cache on the memory ABI.
struct RegisterCallPlan derives std::Copy {
    arguments: u64
    results:   u64
}

fn plan_register_call
    checked:$typechecker::CheckedProgram
    argument_count:u64
    returns:$std::List[common::Type]
    layouts:mut$common::LayoutPlanner
-> std::Option[RegisterCallPlan] {
    if argument_count SCALAR_REGISTER_COUNT > returns.length SCALAR_REGISTER_COUNT > || then
        std::Option[RegisterCallPlan]::None return
    fi
    for typ in returns.iter do
        if layouts checked typ uses_automatic_storage then
            std::Option[RegisterCallPlan]::None return
        fi
    done
    returns.length argument_count RegisterCallPlan std::Option::Some
}

pub fn compile_checked
    checked:$typechecker::CheckedProgram
    sources:$lexer::SourceStore
-> std::Result[std::String AssemblyError] {
    sources checked BackendPlanner::new = state
    error::Diagnostics::new = diagnostics
    checked.get_externs.keys = extern_names
    &does_function_name_precede extern_names.sort_by
    for name in extern_names.iter do
        name checked
            .get_externs
            .get
            .unwrap = signature
        false = caller_owned_result
        for
            typ in signature
                .effect
                .return_types
                .iter
        do
            state.layouts checked typ uses_automatic_storage = caller_owned_result
        done
        if
            caller_owned_result diagnostics state.layouts state.store signature abi::plan_checked_extern std::Option::Some(plan) is
        then
            plan name.clone state
                .program
                .native_calls
                .set
        fi
    done
    if diagnostics.has_errors then
        diagnostics AssemblyError::Rejected std::Result::Error return
    fi
    checked.get_function_names = names
    &does_function_name_precede names.sort_by
    for name in names.iter do
        name.as_str state.program.register_function
        name.as_str checked
            .get_store
            .get_function
            .unwrap = function
        state.layouts function.stack_effect.return_types function
            .stack_effect
            .parameters
            .length checked plan_register_call
        match
            std::Option::Some(plan) => plan name.clone state
                .program
                .register_calls
                .set
            std::Option::None => {}
        end
    done
    for name in names.iter do
        name.clone FunctionWork::Checked = work
        name.as_str checked.find_body.unwrap = body
        if state.program.templates checked body is_leaf_candidate then
            work state checked plan_function = planned
            if state.failure.is_some then
                state.into_result return
            fi
            planned name.as_str state.program.select_function match
                std::Result::Error(message) => message BytecodeFailure::new std::Option::Some = state.failure
                std::Result::Ok(_) => {}
            end
        else
            work state.pending.push
        fi
    done
    # Accessor wrappers can qualify after the direct leaves have been selected.
    for name in names.iter do
        if
            name state
                .program
                .completed
                .has
        then
            continue
        fi
        name.as_str checked.find_body.unwrap = body
        if state.program.templates checked body is_leaf_candidate then
            name.clone FunctionWork::Checked state checked plan_function = planned
            if state.failure.is_some then
                state.into_result return
            fi
            planned name.as_str state.program.select_function match
                std::Result::Error(message) => message BytecodeFailure::new std::Option::Some = state.failure
                std::Result::Ok(_) => {}
            end
        fi
    done
    std::List[InstValue]::new = instructions
    state FunctionPlanner::new = compiler
    compiler.new_label InstValue::Label instructions.push
    instructions checked.get_root compiler.compile_body
    true compiler.owner_flags compiler.locals_count instructions finalize_frame = root
    if state.failure.is_none then
        0 root FunctionPlan::new state.program.select_root match
            std::Result::Error(message) => message BytecodeFailure::new std::Option::Some = state.failure
            std::Result::Ok(_) => {}
        end
    fi
    # The worklist grows only when a concrete function identity is first reached.
    # Each completed buffer is rendered and released before the next is planned.
    0 = index: u64
    while index state.pending.length < state.failure.is_none && do
        index state.pending.get = work
        # Transfer the small work record out of the list before mutating request state.
        work.get_name = name
        if
            name state
                .program
                .completed
                .has
        then
            1 += index
            continue
        fi
        index state.pending.get match
            FunctionWork::Checked(value) => value.clone FunctionWork::Checked
            FunctionWork::Destruction(value typ storage_kind) => storage_kind copy typ.clone value.clone FunctionWork::Destruction
            FunctionWork::RecursiveDestruction(value nodes) => nodes.clone value.clone FunctionWork::RecursiveDestruction
            FunctionWork::ContinuationGrowth(value) => value.clone FunctionWork::ContinuationGrowth
            FunctionWork::ClosureDestruction(value lambda) => lambda.clone value.clone FunctionWork::ClosureDestruction
        end = current
        current state checked plan_function = body
        if state.failure.is_none then
            body name.as_str state.program.select_function match
                std::Result::Error(message) => message BytecodeFailure::new std::Option::Some = state.failure
                std::Result::Ok(_) => {}
            end
        fi
        1 += index
    done
    state.into_result
}

enum RoundingKind derives std::Copy {
    Floor
    Ceil
    Trunc
    Round
}

enum InstValue {
    # Removed into the source table before instruction selection.
    Source(common::Location)
    # Stack
    Drop
    Dup
    Over
    Push(i64)
    PushFloat32(std::String)
    PushFloat64(std::String)
    PushChar(i64)
    PushStr(u64)
    Rot
