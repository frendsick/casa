        # ptr::read's snapshot even when the destination overlaps the source.
        0 = pass: u64
        while 2 pass > do
            0 = offset: u64
            while 8 size offset - <= do
                offset 8 / = register
                if 0 pass == then
                    f"movq {offset}(%rsi), %xmm{register}"
                else
                    f"movq %xmm{register}, {offset}(%rdi)"
                fi self.indent_string
                8 += offset
            done
            if 4 size offset - <= then
                offset 8 / = tail_register
                if 0 pass == then
                    f"movd {offset}(%rsi), %xmm{tail_register}"
                else
                    f"movd %xmm{tail_register}, {offset}(%rdi)"
                fi self.indent_string
                4 += offset
            fi
            if 2 size offset - <= then
                if 0 pass == then
                    f"movw {offset}(%rsi), %ax"
                else
                    f"movw %ax, {offset}(%rdi)"
                fi self.indent_string
                2 += offset
            fi
            if offset size < then
                if 0 pass == then
                    f"movb {offset}(%rsi), %dl"
                else
                    f"movb %dl, {offset}(%rdi)"
                fi self.indent_string
            fi
            1 += pass
        done
    }

