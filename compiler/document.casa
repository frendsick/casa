# Semantic queries over one analyzed source document.
import "std" as std
import "common" as common
import "analysis" as analysis
import "lexer" as lexer

pub enum SymbolPart derives std::Eq std::Copy {
    Whole
    TypeName
    Separator
    MemberName
}

pub enum DocumentSymbolKind derives std::Eq std::Copy {
    Function
    Variable
    Struct
    Enum
    EnumVariant
}

pub struct AnalyzedDocument {
    pub ops:       std::List[common::Op]
    pub functions: std::Map[std::String common::Function]
    pub structs:   std::Map[std::String common::CasaStruct]
    pub enums:     std::Map[std::String common::CasaEnum]
    pub variables: std::Map[std::String common::Variable]
    pub sources:   lexer::SourceStore
    pub source:    std::String
    pub file_path: std::String
}

pub struct DocumentElement {
    pub op:                  common::Op
    pub containing_function: std::Option[common::Function]
    pub part:                SymbolPart
    pub location:            common::Location
}

pub struct DocumentLocation {
    pub file:   std::String
    pub offset: u64
    pub length: u64
}

pub struct DocumentHover {
    pub content:  std::String
    pub location: DocumentLocation
}

pub enum DocumentTokenKind derives std::Eq std::Copy {
    Function
    Variable
    String
    Number
    Keyword
    Operator
    Type
    EnumMember
    Struct
    Macro
}

pub struct DocumentToken {
    pub kind:     DocumentTokenKind
    pub location: DocumentLocation
}

impl DocumentToken {
    pub fn comes_before self:$DocumentToken pivot:$DocumentToken -> bool {
        pivot.location.offset self.location.offset <
    }
}

pub enum CompletionCandidate {
    Function (std::String)
    Variable (common::Variable)
    Keyword (common::KeywordKind)
    Intrinsic (common::IntrinsicKind)
    Struct (common::CasaStruct)
    Enum (std::String)
    EnumVariant (std::String)
    Method (std::String)
}

pub struct DocumentSymbol {
    pub kind:        DocumentSymbolKind
    pub name:        std::String
    pub declaration: common::Location
    pub owner:       std::Option[common::Function]
}

pub struct FindSymbolState {
    pub best:        std::Option[DocumentElement]
    pub best_length: u64
}

impl common::Location {
    pub fn matches self:$common::Location other:$common::Location -> bool {
        self.file other.file ==
        self.span.offset other.span.offset == &&
        self.span.length other.span.length == &&
    }

    pub fn contains_offset self:$common::Location file_path:$str offset:u64 -> bool {
        if self.file file_path != then
            false return
        fi
        self.span.offset offset >=
        offset self.span.offset self.span.length + > &&
    }
}

impl DocumentSymbol {
    pub fn new
        kind:DocumentSymbolKind
        name:$str
        declaration:$common::Location
        owner:std::Option[common::Function]
    -> DocumentSymbol {
        owner declaration.clone name.to_str kind DocumentSymbol
    }

    pub fn matches_identity self:$DocumentSymbol other:$DocumentSymbol -> bool {
        if self.kind other.kind != self.name other.name != || then
            false return
        fi
        if other.declaration self.declaration.matches ! then
            false return
        fi
        if self.owner std::Option::Some(self_owner) is then
            if other.owner std::Option::Some(other_owner) is then
                other_owner.location self_owner.location.matches return
            fi
            false return
        fi
        other.owner.is_none
    }

    pub fn has_declaration_reference self:$DocumentSymbol -> bool {
        self.kind match
            DocumentSymbolKind::Function => true
            DocumentSymbolKind::Variable => false
            DocumentSymbolKind::Struct => true
            DocumentSymbolKind::Enum => true
            DocumentSymbolKind::EnumVariant => true
        end
    }
}

pub fn find_qualified_part source:$str op:$common::Op cursor_offset:u64 -> SymbolPart {
    op
        .location
        .span
        .offset = start
    op
        .location
        .span
        .length = length
    source start length str::substring.as_str "::" str::find = separator
    if 0 separator < then
        SymbolPart::Whole return
    fi
    separator u64::try_from.unwrap = separator_index
    cursor_offset start - = relative_offset
    if relative_offset separator_index > then
        SymbolPart::TypeName
    elif relative_offset separator_index 2 + > then
        SymbolPart::Separator
    else
        SymbolPart::MemberName
    fi
}

pub fn get_symbol_location source:$str op:$common::Op part:$SymbolPart -> common::Location {
    if part SymbolPart::Whole is then
        op.location.clone return
    fi
    op
        .location
        .span
        .offset = start
    op
        .location
        .span
        .length = length
    source start length str::substring.as_str "::" str::find = separator
    separator u64::try_from.unwrap = separator_index
    part copy match
        SymbolPart::TypeName => separator_index start op
            .location
            .file
            .clone common::Location::new
        SymbolPart::Separator => 2 start separator_index + op
            .location
            .file
            .clone common::Location::new
        SymbolPart::MemberName => {
            length separator_index - 2 -
            start separator_index + 2 +
            op
                .location
                .file
                .clone
            common::Location::new
        }
        SymbolPart::Whole => op.location.clone
    end
}

pub fn find_best_spanning_symbol
    ops:$std::List[common::Op]
    file_path:$str
    source:$str
    offset:u64
    function:$std::Option[common::Function]
    find_state:FindSymbolState
-> FindSymbolState {
    for op in ops.iter do
        if op.location.file file_path != then
            continue
        fi
        op
            .location
            .span
            .offset = span_offset
        op
            .location
            .span
            .length = span_length
        if 1 span_length < then
            1 = span_length: u64
        fi
        if
            span_offset offset >=
            offset span_offset span_length + > &&
            find_state.best.is_none span_length find_state.best_length > || &&
        then
            offset op source find_qualified_part = part
            part op source get_symbol_location = location
            span_length
            location
            part
            std::Option[common::Function]::None = containing_function
            if function std::Option::Some(value) is then
                value.clone_for_import std::Option::Some = containing_function
            fi
            containing_function
            op.clone
            DocumentElement std::Option::Some FindSymbolState = find_state
        fi
    done
    find_state
}

pub fn find_best_assignment
    name:$str
    ops:$std::List[common::Op]
    usage_offset:u64
    best:std::Option[common::Op]
-> std::Option[common::Op] {
    0 = op_index: u64
    while op_index ops.length > do
        op_index ops.get = op
        1 += op_index
        if op.value common::OpValue::AssignVar(assign_name) is then
            if assign_name name != then
                continue
            fi
            if
                op
                    .location
                    .span
                    .offset usage_offset >
            then
                op.clone std::Option::Some = best
            elif best.is_none then
                op.clone std::Option::Some = best
            fi
        fi
    done
    best
}

pub fn extract_word_before source:$str offset:u64 -> std::String {
    offset = end_pos
    end_pos = start_pos
    while 0 start_pos != do
        1 -= start_pos
        start_pos source.at = character
        if character.is_alpha ! character.is_digit ! && character '_' != && then
            1 += start_pos
            break
        fi
    done
    source start_pos end_pos start_pos - str::substring
}

pub fn extract_chain_before source:$str offset:u64 -> std::List[std::String] {
    std::List[std::String]::new = reversed_parts
    offset = position
    while 0 position > do
        position source extract_word_before = word
        if 0 word.length == then
            break
        fi
        word.length = word_length
        word reversed_parts.push
        word_length position swap - = position
        if 0 position > then
            if '.' position 1 - source.at == then
                1 -= position
            else
                break
            fi
        fi
    done

    std::List[std::String]::new = parts
    reversed_parts.length = reverse_index
    while 0 reverse_index != do
        1 -= reverse_index
        reverse_index reversed_parts.get.clone parts.push
    done
    parts
}

pub fn infer_literal_type text:$str -> std::Option[common::Type] {
    if 0 text.length == then
        std::Option[common::Type]::None return
    fi
    true = all_digits
    for character in text.iter do
        if character.is_digit ! then
            false = all_digits
            break
        fi
    done
    if all_digits then
        common::make_i64_type.clone std::Option::Some return
    fi
    if text lexer::is_float_literal then
        common::make_f64_type.clone std::Option::Some return
    fi
    if text "true" == text "false" == || then
        common::make_bool_type.clone std::Option::Some return
    fi
    std::Option[common::Type]::None
}

pub fn find_first_assignment name:$str ops:$std::List[common::Op] -> std::Option[common::Location] {
    for op in ops.iter do
        if op.value common::OpValue::AssignVar(assign_name) is then
            if assign_name name == then
                op.location.clone std::Option::Some return
            fi
        fi
    done
    std::Option[common::Location]::None
}

pub fn is_qualified_operation source:$str op:$common::Op -> bool {
    if
        0 op
            .location
            .span
            .length ==
    then
        false return
    fi
    source op
        .location
        .span
        .offset op
        .location
        .span
        .length str::substring.as_str "::" str::contains
}

pub fn find_document_token_kind op_value:$common::OpValue -> std::Option[DocumentTokenKind] {
    op_value match
        common::OpValue::FnCall(_) => DocumentTokenKind::Function std::Option::Some
        common::OpValue::FnPush(_) => DocumentTokenKind::Function std::Option::Some
        common::OpValue::MethodCall(_) => DocumentTokenKind::Function std::Option::Some
        common::OpValue::TraitMethodCall(_) => DocumentTokenKind::Function std::Option::Some
        common::OpValue::TraitMethodRef(_) => DocumentTokenKind::Function std::Option::Some
        common::OpValue::PushVar(_) => DocumentTokenKind::Variable std::Option::Some
        common::OpValue::PushCapture(_) => DocumentTokenKind::Variable std::Option::Some
        common::OpValue::AssignVar(_) => DocumentTokenKind::Variable std::Option::Some
        common::OpValue::AssignInc(_) => DocumentTokenKind::Variable std::Option::Some
        common::OpValue::AssignDec(_) => DocumentTokenKind::Variable std::Option::Some
        common::OpValue::PushStr(_) => DocumentTokenKind::String std::Option::Some
        common::OpValue::PushInt(_) => DocumentTokenKind::Number std::Option::Some
        common::OpValue::PushFloat(_) => DocumentTokenKind::Number std::Option::Some
        common::OpValue::PushChar(_) => DocumentTokenKind::Number std::Option::Some
        common::OpValue::PushBool(_) => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::FnExec => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::FnExecOwned => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::IfStart => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::IfCondition => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::IfElif => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::IfElse => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::IfEnd => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::WhileStart => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::WhileCondition => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::WhileEnd => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::WhileBreak => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::WhileContinue => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::MatchStart => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::MatchArm(_) => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::MatchEnd => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::FnReturn => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::Question(_) => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::UnsafeStart => DocumentTokenKind::Keyword std::Option::Some
        common::OpValue::Add => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Sub => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Mul => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Div => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Mod => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Shl => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Shr => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::BitAnd => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::BitOr => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::BitXor => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::BitNot => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::And => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Or => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Not => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Eq => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Ne => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Lt => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Le => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Gt => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::Ge => DocumentTokenKind::Operator std::Option::Some
        common::OpValue::PushEnumVariant(_) => DocumentTokenKind::EnumMember std::Option::Some
        common::OpValue::StructNew(_) => DocumentTokenKind::Struct std::Option::Some
        common::OpValue::Drop => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Dup => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Copy => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Swap => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Over => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Rot => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Print => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PrintInt => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PrintStr => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PrintString => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PrintBool => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PrintChar => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::HeapAlloc => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::HeapFree => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Load8 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Load16 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Load32 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Load64 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PtrAsRef(_) => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PtrAsMut(_) => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PtrFromRaw(_) => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PtrFromRef => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PtrIntoRaw => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PtrNull => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PtrRead(_) => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Store8 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Store16 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Store32 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Store64 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::PtrWrite(_) => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Syscall0 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Syscall1 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Syscall2 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Syscall3 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Syscall4 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Syscall5 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Syscall6 => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::Typeof => DocumentTokenKind::Macro std::Option::Some
        common::OpValue::SizeOf(_) => DocumentTokenKind::Macro std::Option::Some
        _ => std::Option[DocumentTokenKind]::None
    end
}

pub fn classify_qualified_member op_value:$common::OpValue -> DocumentTokenKind {
    if op_value common::OpValue::PushEnumVariant is then
        DocumentTokenKind::EnumMember
    else
        DocumentTokenKind::Function
    fi
}

pub fn find_keyword_before
    source:$str
    file_path:$str
    name_offset:u64
    keyword:$str
-> std::Option[common::Location] {
    name_offset = position
    while 0 position != do
        1 -= position
        position source.at = character
        if ' ' character != '\t' character != && '\n' character != && then
            break
        fi
    done
    if keyword.length position 1 + >= then
        position 1 + keyword.length - = keyword_start
        if source keyword_start keyword.length str::substring keyword == then
            keyword.length keyword_start file_path.to_str common::Location::new std::Option::Some return
        fi
    fi
    std::Option[common::Location]::None
}

impl common::Function {
    pub fn format_hover self:$common::Function -> std::String {
        std::String::new = builder
        if self.is_unsafe then
            "unsafe " builder.append
        fi
        "fn " builder.append
        self.name.as_str builder.append
        if
            0 self
                .stack_effect
                .parameters
                .length !=
        then
            " " builder.append
            std::List[std::String]::new = parameters
            for
                parameter in self
                    .stack_effect
                    .parameters
                    .iter
            do
                if "" parameter.name != then
                    f"{parameter.name}:{parameter.typ.format}"
                else
                    parameter.typ.format
                fi
                parameters.push
            done
            " " parameters.join_strings.as_str builder.append
        fi
        " -> " builder.append
        if
            0 self
                .stack_effect
                .return_types
                .length !=
        then
            std::List[std::String]::new = return_types
            for
                return_type in self
                    .stack_effect
                    .return_types
                    .iter
            do
                return_type.format return_types.push
            done
            " " return_types.join_strings.as_str builder.append
        else
            "None" builder.append
        fi
        builder
    }
}

impl common::CasaStruct {
    pub fn format_hover self:$common::CasaStruct -> std::String {
        std::String::new = builder
        "struct " builder.append
        self.name.as_str builder.append
        " { " builder.append
        std::List[std::String]::new = members
        for member in self.members.iter do
            f"{member.name}: {member.typ.format}" members.push
        done
        ", " members.join_strings.as_str builder.append
        " }" builder.append
        builder
    }
}

impl common::CasaEnum {
    pub fn format_hover self:$common::CasaEnum -> std::String {
        std::String::new = builder
        "enum " builder.append
        self.name.as_str builder.append
        " { " builder.append
        ", " self
            .variants
            .join_strings
            .as_str builder.append
        " }" builder.append
        builder
    }
}

impl common::OpValue {
    pub fn format_hover self:$common::OpValue -> std::Option[std::String] {
        self match
            common::OpValue::Add => "+: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::Sub => "-: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::Mul => "*: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::Div => "/: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::Mod => "%: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::Shl => "<<: T u64 -> T (integer T)".to_str std::Option::Some
            common::OpValue::Shr => ">>: T u64 -> T (integer T)".to_str std::Option::Some
            common::OpValue::BitAnd => "&: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::BitOr => "|: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::BitXor => "^: T T -> T (same-width integers)".to_str std::Option::Some
            common::OpValue::BitNot => "~: T -> T (integer T)".to_str std::Option::Some
            common::OpValue::Not => "!: bool -> bool".to_str std::Option::Some
            common::OpValue::Eq => "==: [T: PartialEq] T T -> bool".to_str std::Option::Some
            common::OpValue::Ne => "!=: [T: PartialEq] T T -> bool".to_str std::Option::Some
            common::OpValue::Lt => "<: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            common::OpValue::Le => "<=: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            common::OpValue::Gt => ">: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            common::OpValue::Ge => ">=: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            common::OpValue::And => "&&: bool bool -> bool".to_str std::Option::Some
            common::OpValue::Or => "||: bool bool -> bool".to_str std::Option::Some
            common::OpValue::Drop => "drop: T -> None".to_str std::Option::Some
            common::OpValue::Dup => "dup: [T: Copy] T -> T T".to_str std::Option::Some
            common::OpValue::Copy => "copy: [T: Copy] T -> T".to_str std::Option::Some
            common::OpValue::Swap => "swap: T1 T2 -> T2 T1".to_str std::Option::Some
            common::OpValue::Over => "over: [T2: Copy] T1 T2 -> T2 T1 T2".to_str std::Option::Some
            common::OpValue::Rot => "rot: T1 T2 T3 -> T3 T1 T2".to_str std::Option::Some
            common::OpValue::Print => "print: [T: Display] T -> None".to_str std::Option::Some
            common::OpValue::PrintInt => "print: [T: Display] T -> None".to_str std::Option::Some
            common::OpValue::PrintStr => "print: [T: Display] T -> None".to_str std::Option::Some
            common::OpValue::PrintBool => "print: [T: Display] T -> None".to_str std::Option::Some
            common::OpValue::PrintChar => "print: [T: Display] T -> None".to_str std::Option::Some
            common::OpValue::FnExec => "exec: fn[...] -> ...".to_str std::Option::Some
            common::OpValue::FnExecOwned => "exec: fn[...] -> ...".to_str std::Option::Some
            common::OpValue::Typeof => "typeof: T -> str".to_str std::Option::Some
            common::OpValue::SizeOf(_) => "size_of[T]: None -> u64".to_str std::Option::Some
            common::OpValue::AssignDec(_) => "-=: T -> None (integer T)".to_str std::Option::Some
            common::OpValue::AssignInc(_) => "+=: T -> None (integer T)".to_str std::Option::Some
            common::OpValue::HeapAlloc => "alloc: u64 -> ptr".to_str std::Option::Some
            common::OpValue::HeapFree => "free: ptr -> None".to_str std::Option::Some
            common::OpValue::Load8 => "load8: ptr -> u8".to_str std::Option::Some
            common::OpValue::Load16 => "load16: ptr -> u16".to_str std::Option::Some
            common::OpValue::Load32 => "load32: ptr -> u32".to_str std::Option::Some
            common::OpValue::Load64 => "load64: ptr -> u64".to_str std::Option::Some
            common::OpValue::PtrAsRef(target) => f"ptr::as_ref[{target.format}]: ptr -> ${target.format}" std::Option::Some
            common::OpValue::PtrAsMut(target) => f"ptr::as_mut[{target.format}]: ptr -> mut${target.format}" std::Option::Some
            common::OpValue::PtrFromRaw(target) => f"ptr::from_raw[{target.format}]: ptr -> {target.format}" std::Option::Some
            common::OpValue::PtrFromRef => "ptr::from_ref: $T -> ptr".to_str std::Option::Some
            common::OpValue::PtrIntoRaw => "ptr::into_raw: T -> ptr".to_str std::Option::Some
            common::OpValue::PtrNull => "ptr::null: None -> ptr".to_str std::Option::Some
            common::OpValue::PtrRead(target) => f"ptr::read[{target.format}]: ptr -> {target.format}" std::Option::Some
            common::OpValue::Store8 => "store8: u8 ptr -> None".to_str std::Option::Some
            common::OpValue::Store16 => "store16: u16 ptr -> None".to_str std::Option::Some
            common::OpValue::Store32 => "store32: u32 ptr -> None".to_str std::Option::Some
            common::OpValue::Store64 => "store64: u64 ptr -> None".to_str std::Option::Some
            common::OpValue::PtrWrite(target) => f"ptr::write[{target.format}]: ptr {target.format} -> None" std::Option::Some
            common::OpValue::Syscall0 => "syscall0: i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall1 => "syscall1[A1: Word]: A1 i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall2 => "syscall2[A1: Word A2: Word]: A1 A2 i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall3 => "syscall3[A1: Word A2: Word A3: Word]: A1 A2 A3 i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall4 => "syscall4[A1: Word A2: Word A3: Word A4: Word]: A1 A2 A3 A4 i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall5 => "syscall5[A1: Word A2: Word A3: Word A4: Word A5: Word]: A1 A2 A3 A4 A5 i64 -> i64".to_str std::Option::Some
            common::OpValue::Syscall6 => "syscall6[A1: Word A2: Word A3: Word A4: Word A5: Word A6: Word]: A1 A2 A3 A4 A5 A6 i64 -> i64".to_str std::Option::Some
            common::OpValue::Argc => "argc: None -> i64".to_str std::Option::Some
            common::OpValue::Argv => "argv: None -> ptr".to_str std::Option::Some
            _ => std::Option[std::String]::None
        end
    }
}

impl AnalyzedDocument {
    pub fn new
        analysis:analysis::AnalysisResult
        source:std::String
        file_path:std::String
    -> AnalyzedDocument {
        analysis.into_parts = typechecked = sources = diagnostics
        std::List[common::Op]::new = ops
        std::Map[std::String common::Function]::new = functions
        std::Map[std::String common::CasaStruct]::new = structs
        std::Map[std::String common::CasaEnum]::new = enums
        std::Map[std::String common::Variable]::new = variables
        typechecked match
            std::Option::Some(typecheck_result) => {
                typecheck_result.into_document_parts = variables = enums = structs = functions = ops
            }
            std::Option::None => {
            }
        end
        diagnostics drop
        file_path
        source
        sources
        variables
        enums
        structs
        functions
        ops
        AnalyzedDocument
    }

    pub fn collect_document_functions self:$AnalyzedDocument -> std::List[common::Function] {
        std::List[common::Function]::new = functions
        for
            function_name in self
                .functions
                .keys
                .iter
        do
            function_name self
                .functions
                .get
                .unwrap = function
            if "" function.location.file == then
                continue
            fi
            if function.location.file self.file_path != then
                continue
            fi
            function.clone_for_import functions.push
        done
        functions
    }

    pub fn collect_operation_tokens
        self:$AnalyzedDocument
        ops:$std::List[common::Op]
        tokens:mut$std::List[DocumentToken]
    {
        for op in ops.iter do
            if
                op.location.file self.file_path != 0 op
                    .location
                    .span
                    .length <= ||
            then
                continue
            fi
            if op.value find_document_token_kind std::Option::Some(kind) is then
                if
                    op.value common::OpValue::FnCall is
                    op.value common::OpValue::FnPush is ||
                    op.value common::OpValue::PushEnumVariant is ||
                    op self.source.as_str is_qualified_operation &&
                then
                    SymbolPart::TypeName op self.source.as_str get_symbol_location self.locate
                    DocumentTokenKind::Type DocumentToken tokens.push
                    SymbolPart::MemberName op self.source.as_str get_symbol_location self.locate
                    op.value classify_qualified_member
                    DocumentToken tokens.push
                else
                    op.location self.locate kind copy DocumentToken tokens.push
                fi
            fi
        done
    }

    pub fn collect_declaration_token
        self:$AnalyzedDocument
        location:$common::Location
        keyword:$str
        kind:DocumentTokenKind
        tokens:mut$std::List[DocumentToken]
    {
        if location.file self.file_path != 0 location.span.length <= || then
            return
        fi
        location self.locate kind DocumentToken tokens.push
        if
            keyword location.span.offset self.file_path.as_str self.source.as_str find_keyword_before std::Option::Some(keyword_location) is
        then
            keyword_location self.locate DocumentTokenKind::Keyword DocumentToken tokens.push
        fi
    }

    pub fn find_semantic_tokens self:$AnalyzedDocument -> std::List[DocumentToken] {
        std::List[DocumentToken]::new = tokens
        tokens self.ops self.collect_operation_tokens
        for function in self.collect_document_functions.iter do
            tokens function.ops self.collect_operation_tokens
            if
                function.name.as_str "lambda__" str::starts_with !
                function.name.as_str "__" str::starts_with ! &&
            then
                tokens DocumentTokenKind::Function "fn" function.location self.collect_declaration_token
                if function.is_unsafe then
                    if
                        "unsafe" function
                            .location
                            .span
                            .offset self.file_path.as_str self.source.as_str
                        find_keyword_before std::Option::Some(unsafe_location) is
                    then
                        unsafe_location self.locate DocumentTokenKind::Keyword DocumentToken tokens.push
                    fi
                fi
            fi
        done
        for
            enum_name in self
                .enums
                .keys
                .iter
        do
            enum_name self
                .enums
                .get
                .unwrap = casa_enum
            tokens DocumentTokenKind::Type "enum" casa_enum.location self.collect_declaration_token
        done
        for
            struct_name in self
                .structs
                .keys
                .iter
        do
            struct_name self
                .structs
                .get
                .unwrap = casa_struct
            tokens DocumentTokenKind::Struct "struct" casa_struct.location self.collect_declaration_token
        done
        &DocumentToken::comes_before tokens.sort_by
        tokens
    }

    pub fn find_symbol_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
    -> std::Option[DocumentElement] {
        position self.file_path.as_str self
            .sources
            .convert_position_to_offset
            .unwrap = offset
        0 std::Option[DocumentElement]::None FindSymbolState = find_state
        find_state
        std::Option[common::Function]::None
        offset
        self.source.as_str
        self.file_path.as_str
        self.ops
        find_best_spanning_symbol = find_state
        self.collect_document_functions = document_functions
        0 = document_function_index: u64
        while document_function_index document_functions.length > do
            document_function_index document_functions.get = function
            1 += document_function_index
            find_state
            function.clone_for_import std::Option::Some
            offset
            self.source.as_str
            self.file_path.as_str
            function.ops
            find_best_spanning_symbol = find_state
        done
        find_state match
            FindSymbolState { best: best } => best
        end
    }

    pub fn find_completion_candidates
        self:$AnalyzedDocument
        position:$common::SourcePosition
        trigger:$str
    -> std::List[CompletionCandidate] {
        position self.file_path.as_str self
            .sources
            .convert_position_to_offset
            .unwrap = cursor_offset
        if trigger "." == trigger ":" == || then
            cursor_offset self.find_triggered_completion_candidates return
        fi

        std::List[CompletionCandidate]::new = candidates
        for
            function_name in self
                .functions
                .keys
                .iter
        do
            if
                function_name.as_str "lambda__" str::starts_with
                function_name.as_str "__" str::starts_with ||
                function_name.as_str "::" str::contains ||
            then
                continue
            fi
            function_name self
                .functions
                .get
                .unwrap
                .name
                .clone CompletionCandidate::Function candidates.push
        done

        for
            struct_name in self
                .structs
                .keys
                .iter
        do
            struct_name self
                .structs
                .get
                .unwrap
                .clone CompletionCandidate::Struct candidates.push
        done

        for
            enum_name in self
                .enums
                .keys
                .iter
        do
            enum_name self
                .enums
                .get
                .unwrap
                .name
                .clone CompletionCandidate::Enum candidates.push
        done

        if cursor_offset self.find_containing_function std::Option::Some(function) is then
            0 = variable_index: u64
            while variable_index function.variables.length > do
                variable_index function
                    .variables
                    .get
                    .clone CompletionCandidate::Variable candidates.push
                1 += variable_index
            done
        fi
        for
            variable_name in self
                .variables
                .keys
                .iter
        do
            if variable_name self.variables.get std::Option::Some(variable) is then
                variable.clone CompletionCandidate::Variable candidates.push
            fi
        done

        [
            common::KeywordKind::Pub,
            common::KeywordKind::As,
            common::KeywordKind::Unsafe,
            common::KeywordKind::Fn,
            common::KeywordKind::Impl,
            common::KeywordKind::Return,
            common::KeywordKind::While,
            common::KeywordKind::Do,
            common::KeywordKind::Break,
            common::KeywordKind::Continue,
            common::KeywordKind::Done,
            common::KeywordKind::If,
            common::KeywordKind::Then,
            common::KeywordKind::Elif,
            common::KeywordKind::Else,
            common::KeywordKind::Fi,
            common::KeywordKind::EnumKw,
            common::KeywordKind::StructKw,
            common::KeywordKind::TraitKw,
            common::KeywordKind::End,
            common::KeywordKind::Match,
            common::KeywordKind::Is,
            common::KeywordKind::Import,
            common::KeywordKind::For,
            common::KeywordKind::In,
            common::KeywordKind::Global,
            common::KeywordKind::Const,
            common::KeywordKind::Move,
        ] = keywords
        for keyword in keywords.iter do
            keyword copy CompletionCandidate::Keyword candidates.push
        done

        [
            common::IntrinsicKind::Drop,
            common::IntrinsicKind::Dup,
            common::IntrinsicKind::Copy,
            common::IntrinsicKind::Over,
            common::IntrinsicKind::Rot,
            common::IntrinsicKind::Swap,
            common::IntrinsicKind::Alloc,
            common::IntrinsicKind::Free,
            common::IntrinsicKind::Load8,
            common::IntrinsicKind::Load16,
            common::IntrinsicKind::Load32,
            common::IntrinsicKind::Load64,
            common::IntrinsicKind::Store8,
            common::IntrinsicKind::Store16,
            common::IntrinsicKind::Store32,
            common::IntrinsicKind::Store64,
            common::IntrinsicKind::Print,
            common::IntrinsicKind::Typeof,
            common::IntrinsicKind::SizeOf,
            common::IntrinsicKind::Exec,
            common::IntrinsicKind::Syscall0,
            common::IntrinsicKind::Syscall1,
            common::IntrinsicKind::Syscall2,
            common::IntrinsicKind::Syscall3,
            common::IntrinsicKind::Syscall4,
            common::IntrinsicKind::Syscall5,
            common::IntrinsicKind::Syscall6,
            common::IntrinsicKind::Argc,
            common::IntrinsicKind::Argv,
            common::IntrinsicKind::Envp,
        ] = intrinsics
        for intrinsic in intrinsics.iter do
            intrinsic copy CompletionCandidate::Intrinsic candidates.push
        done
        candidates
    }

    pub fn find_methods_for_type
        self:$AnalyzedDocument
        receiver_type:$common::Type
    -> std::List[CompletionCandidate] {
        f"{receiver_type.match_base}::" = method_prefix
        std::List[CompletionCandidate]::new = candidates
        for
            function_name in self
                .functions
                .keys
                .iter
        do
            if function_name.as_str method_prefix.as_str str::starts_with then
                function_name self
                    .functions
                    .get
                    .unwrap
                    .name
                    .clone CompletionCandidate::Method candidates.push
            fi
        done
        candidates
    }

    pub fn find_qualified_completion_candidates
        self:$AnalyzedDocument
        type_name:$str
    -> std::List[CompletionCandidate] {
        std::List[CompletionCandidate]::new = candidates
        if type_name self.lookup_enum std::Option::Some(casa_enum) is then
            for variant_name in casa_enum.variants.iter do
                variant_name.clone CompletionCandidate::EnumVariant candidates.push
            done
        fi
        type_name common::parse_type_str = receiver_type
        receiver_type self.find_methods_for_type candidates.append
        candidates
    }

    pub fn resolve_completion_chain_type
        self:$AnalyzedDocument
        parts:$std::List[std::String]
        offset:u64
    -> std::Option[common::Type] {
        if 0 parts.length == then
            std::Option[common::Type]::None return
        fi
        offset self.find_containing_function = containing_function
        0 parts.get = first_part
        containing_function first_part.as_str self.find_variable_type = current_type
        if current_type.is_none then
            first_part.as_str infer_literal_type = current_type
        fi
        if current_type.is_none then
            std::Option[common::Type]::None return
        fi

        current_type.unwrap = resolved_type
        1 = part_index: u64
        while part_index parts.length > do
            part_index parts.get = method_name
            f"{resolved_type.match_base}::{method_name}".as_str self.lookup_function match
                std::Option::Some(function) => {
                    if
                        0 function
                            .stack_effect
                            .return_types
                            .length ==
                    then
                        std::Option[common::Type]::None return
                    fi
                    0 function
                        .stack_effect
                        .return_types
                        .get
                        .clone = resolved_type
                }
                std::Option::None => std::Option[common::Type]::None return
            end
            1 += part_index
        done
        resolved_type std::Option::Some
    }

    pub fn find_triggered_completion_candidates
        self:$AnalyzedDocument
        offset:u64
    -> std::List[CompletionCandidate] {
        if 0 offset == then
            std::List[CompletionCandidate]::new return
        fi
        offset 1 - = position

        if 1 position >= then
            if self.source.as_str position 1 - 2 str::substring.as_str "::" == then
                position 1 - self.source.as_str extract_word_before = type_name
                if 0 type_name.length != then
                    type_name.as_str self.find_qualified_completion_candidates return
                fi
            fi
        fi

        if '.' position self.source.at == then
            position self.source.as_str extract_chain_before = chain
            if offset chain self.resolve_completion_chain_type std::Option::Some(receiver_type) is then
                receiver_type self.find_methods_for_type return
            fi
        fi

        std::List[CompletionCandidate]::new
    }

    pub fn find_variable_owner
        self:$AnalyzedDocument
        name:$str
        function:$std::Option[common::Function]
    -> std::Option[common::Function] {
        if function std::Option::Some(containing_function) is then
            if name containing_function.variables common::variable_list_contains then
                containing_function.clone_for_import std::Option::Some return
            fi
            if name containing_function.captures common::variable_list_contains then
                if containing_function self.find_parent_function std::Option::Some(parent) is then
                    parent.clone_for_import std::Option::Some name self.find_variable_owner return
                fi
            fi
        fi
        std::Option[common::Function]::None
    }

    pub fn find_parent_function
        self:$AnalyzedDocument
        child:$common::Function
    -> std::Option[common::Function] {
        for
            function_name in self
                .functions
                .keys
                .iter
        do
            function_name self
                .functions
                .get
                .unwrap = function
            0 = op_index: u64
            while op_index function.ops.length > do
                if
                    op_index function
                        .ops
                        .get_ref
                        .value common::OpValue::FnPush(pushed_name) is
                then
                    if pushed_name child.name == then
                        function.clone_for_import std::Option::Some return
                    fi
                fi
                1 += op_index
            done
        done
        std::Option[common::Function]::None
    }

    pub fn find_callable_symbol
        self:$AnalyzedDocument
        name:$str
        part:$SymbolPart
    -> std::Option[DocumentSymbol] {
        if part SymbolPart::TypeName is then
            name "::" str::split = parts
            0 parts.get.as_str self.find_type_symbol return
        fi
        if part SymbolPart::Separator is then
            std::Option[DocumentSymbol]::None return
        fi
        if name self.lookup_function std::Option::Some(function) is then
            std::Option[common::Function]::None
            function.location
            name
            DocumentSymbolKind::Function
            DocumentSymbol::new std::Option::Some return
        fi
        std::Option[DocumentSymbol]::None
    }

    pub fn find_enum_variant_symbol
        self:$AnalyzedDocument
        variant:$common::EnumVariant
        part:$SymbolPart
    -> std::Option[DocumentSymbol] {
        if part SymbolPart::TypeName is then
            variant.enum_name.as_str self.find_type_symbol return
        fi
        if part SymbolPart::Separator is then
            std::Option[DocumentSymbol]::None return
        fi
        if variant.enum_name.as_str self.lookup_enum std::Option::Some(casa_enum) is then
            if variant.variant_name casa_enum.variant_locations.get std::Option::Some(declaration) is then
                std::Option[common::Function]::None
                declaration
                variant.variant_name.as_str
                DocumentSymbolKind::EnumVariant
                DocumentSymbol::new std::Option::Some return
            fi
        fi
        std::Option[DocumentSymbol]::None
    }

    pub fn find_variable_symbol
        self:$AnalyzedDocument
        name:$str
        function:$std::Option[common::Function]
    -> std::Option[DocumentSymbol] {
        function name self.find_variable_owner = owner
        if owner std::Option::Some(owner_function) is then
            owner_function.ops
        else
            self.ops
        fi
        = operations: $std::List[common::Op]
        if operations name find_first_assignment std::Option::Some(declaration) is then
            owner declaration name DocumentSymbolKind::Variable DocumentSymbol::new std::Option::Some return
        fi
        std::Option[DocumentSymbol]::None
    }

    pub fn find_symbol_identity
        self:$AnalyzedDocument
        element:$DocumentElement
    -> std::Option[DocumentSymbol] {
        element.op.value match
            common::OpValue::FnCall(name) => element.part name.as_str self.find_callable_symbol
            common::OpValue::FnPush(name) => element.part name.as_str self.find_callable_symbol
            common::OpValue::PushEnumVariant(variant) => element.part variant self.find_enum_variant_symbol
            common::OpValue::StructNew(casa_struct) => {
                std::Option[common::Function]::None
                casa_struct.location
                casa_struct.name.as_str
                DocumentSymbolKind::Struct
                DocumentSymbol::new std::Option::Some
            }
            common::OpValue::PushVar(name) => element.containing_function name.as_str self.find_variable_symbol
            common::OpValue::PushCapture(name) => element.containing_function name.as_str self.find_variable_symbol
            common::OpValue::AssignVar(name) => element.containing_function name.as_str self.find_variable_symbol
            common::OpValue::AssignInc(name) => element.containing_function name.as_str self.find_variable_symbol
            common::OpValue::AssignDec(name) => element.containing_function name.as_str self.find_variable_symbol
            _ => std::Option[DocumentSymbol]::None
        end
    }

    pub fn find_type_symbol self:$AnalyzedDocument name:$str -> std::Option[DocumentSymbol] {
        if name self.lookup_struct std::Option::Some(casa_struct) is then
            std::Option[common::Function]::None
            casa_struct.location
            casa_struct.name.as_str
            DocumentSymbolKind::Struct
            DocumentSymbol::new std::Option::Some return
        fi
        if name self.lookup_enum std::Option::Some(casa_enum) is then
            std::Option[common::Function]::None
            casa_enum.location
            casa_enum.name.as_str
            DocumentSymbolKind::Enum
            DocumentSymbol::new std::Option::Some return
        fi
        std::Option[DocumentSymbol]::None
    }

    pub fn find_symbol_identity_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
    -> std::Option[DocumentSymbol] {
        if position self.find_function_at std::Option::Some(function) is then
            std::Option[common::Function]::None
            function.location
            function.name.as_str
            DocumentSymbolKind::Function
            DocumentSymbol::new std::Option::Some return
        fi
        position self.find_declared_symbol_at match
            std::Option::Some(symbol) => symbol std::Option::Some return
            std::Option::None => {
            }
        end
        if position self.find_symbol_at std::Option::Some(element) is then
            element self.find_symbol_identity return
        fi
        std::Option[DocumentSymbol]::None
    }

    pub fn find_declared_symbol_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
    -> std::Option[DocumentSymbol] {
        position self.file_path.as_str self
            .sources
            .convert_position_to_offset
            .unwrap = offset
        for
            struct_name in self
                .structs
                .keys
                .iter
        do
            struct_name self
                .structs
                .get
                .unwrap = casa_struct
            if offset self.file_path.as_str casa_struct.location.contains_offset then
                struct_name.as_str self.find_type_symbol return
            fi
        done
        for
            enum_name in self
                .enums
                .keys
                .iter
        do
            enum_name self
                .enums
                .get
                .unwrap = casa_enum
            offset casa_enum self.find_declared_enum_symbol_at match
                std::Option::Some(symbol) => symbol std::Option::Some return
                std::Option::None => {
                }
            end
        done
        std::Option[DocumentSymbol]::None
    }

    pub fn find_declared_enum_symbol_at
        self:$AnalyzedDocument
        casa_enum:$common::CasaEnum
        offset:u64
    -> std::Option[DocumentSymbol] {
        if offset self.file_path.as_str casa_enum.location.contains_offset then
            casa_enum.name.as_str self.find_type_symbol return
        fi
        for variant_name in casa_enum.variants.iter do
            if variant_name casa_enum.variant_locations.get std::Option::Some(location) is then
                if offset self.file_path.as_str location.contains_offset then
                    std::Option[common::Function]::None
                    location
                    variant_name.as_str
                    DocumentSymbolKind::EnumVariant
                    DocumentSymbol::new std::Option::Some return
                fi
            fi
        done
        std::Option[DocumentSymbol]::None
    }

    pub fn collect_symbol_references
        self:$AnalyzedDocument
        symbol:$DocumentSymbol
        ops:$std::List[common::Op]
        function:$std::Option[common::Function]
        references:mut$std::List[DocumentLocation]
    {
        for op in ops.iter do
            if
                op
                    .location
                    .file
                    .as_str self.sources.get std::Option::Some(op_source) is
            then
                if op op_source.as_str is_qualified_operation then
                    references op_source.as_str SymbolPart::TypeName op function symbol self.collect_element_reference
                    references op_source.as_str SymbolPart::MemberName op function symbol self.collect_element_reference
                else
                    references op_source.as_str SymbolPart::Whole op function symbol self.collect_element_reference
                fi
            fi
        done
    }

    pub fn collect_element_reference
        self:$AnalyzedDocument
        symbol:$DocumentSymbol
        function:$std::Option[common::Function]
        op:$common::Op
        part:$SymbolPart
        source:$str
        references:mut$std::List[DocumentLocation]
    {
        part op source get_symbol_location = location
        std::Option[common::Function]::None = containing_function
        if function std::Option::Some(value) is then
            value.clone_for_import std::Option::Some = containing_function
        fi
        location.clone part copy containing_function op.clone DocumentElement = element
        if element self.find_symbol_identity std::Option::Some(reference_symbol) is then
            if reference_symbol symbol.matches_identity then
                if symbol.name.length location.span.length < then
                    symbol.name.length
                    location.span.offset location.span.length + symbol.name.length -
                    location.file.clone
                    common::Location::new = location
                fi
                location self.locate references.push
            fi
        fi
    }

    pub fn find_references_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
        include_declaration:bool
    -> std::Option[std::List[DocumentLocation]] {
        if position self.find_symbol_identity_at std::Option::Some(symbol) is then
            std::List[DocumentLocation]::new = references
            if include_declaration symbol.has_declaration_reference && then
                symbol.declaration self.locate references.push
            fi
            references std::Option[common::Function]::None self.ops symbol self.collect_symbol_references
            for
                function_name in self
                    .functions
                    .keys
                    .iter
            do
                function_name self
                    .functions
                    .get
                    .unwrap = function
                references function.clone_for_import std::Option::Some function.ops symbol self.collect_symbol_references
            done
            if 0 references.length != then
                references std::Option::Some return
            fi
        fi
        std::Option[std::List[DocumentLocation]]::None
    }

    pub fn find_function_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
    -> std::Option[common::Function] {
        position self.file_path.as_str self
            .sources
            .convert_position_to_offset
            .unwrap = offset
        for function in self.collect_document_functions.iter do
            if
                function.name.as_str "lambda__" str::starts_with
                function.name.as_str "__" str::starts_with ||
            then
                continue
            fi
            if
                function
                    .location
                    .span
                    .offset offset >=
                offset function
                    .location
                    .span
                    .offset function
                    .location
                    .span
                    .length + > &&
            then
                function.clone_for_import std::Option::Some return
            fi
        done
        std::Option[common::Function]::None
    }

    pub fn find_containing_function
        self:$AnalyzedDocument
        offset:u64
    -> std::Option[common::Function] {
        for function in self.collect_document_functions.iter do
            if 0 function.ops.length == then
                continue
            fi
            0 function
                .ops
                .get
                .location
                .span
                .offset = start_offset
            function.ops.length 1 - function.ops.get = last_op
            last_op
                .location
                .span
                .offset last_op
                .location
                .span
                .length + = end_offset
            if start_offset offset >= offset end_offset >= && then
                function.clone_for_import std::Option::Some return
            fi
        done
        std::Option[common::Function]::None
    }

    pub fn lookup_function self:$AnalyzedDocument name:$str -> std::Option[$common::Function] {
        name self.functions.get_str
    }

    pub fn lookup_struct self:$AnalyzedDocument name:$str -> std::Option[$common::CasaStruct] {
        name self.structs.get_str
    }

    pub fn lookup_enum self:$AnalyzedDocument name:$str -> std::Option[$common::CasaEnum] {
        name self.enums.get_str
    }

    pub fn find_variable_type
        self:$AnalyzedDocument
        name:$str
        function:$std::Option[common::Function]
    -> std::Option[common::Type] {
        if function std::Option::Some(containing_function) is then
            for variable in containing_function.variables.iter do
                if variable.name name == variable.typ.is_unknown ! && then
                    variable.typ.clone std::Option::Some return
                fi
            done
            for capture in containing_function.captures.iter do
                if capture.name name == capture.typ.is_unknown ! && then
                    capture.typ.clone std::Option::Some return
                fi
            done
        fi
        if name self.variables.get_str std::Option::Some(variable) is then
            if variable.typ.is_unknown ! then
                variable.typ.clone std::Option::Some return
            fi
        fi
        std::Option[common::Type]::None
    }

    pub fn find_symbol_type
        self:$AnalyzedDocument
        symbol:$DocumentElement
    -> std::Option[common::Type] {
        symbol.op.value match
            common::OpValue::PushVar(name) => symbol.containing_function name.as_str self.find_variable_type
            common::OpValue::PushCapture(name) => symbol.containing_function name.as_str self.find_variable_type
            common::OpValue::AssignVar(name) => symbol.containing_function name.as_str self.find_variable_type
            common::OpValue::PushInt(_) => {
                if symbol.op.type_hint std::Option::Some(literal_type) is then
                    literal_type.clone std::Option::Some
                else
                    common::make_i64_type.clone std::Option::Some
                fi
            }
            common::OpValue::PushFloat(_) => {
                if symbol.op.type_hint std::Option::Some(literal_type) is then
                    literal_type.clone std::Option::Some
                else
                    common::make_f64_type.clone std::Option::Some
                fi
            }
            common::OpValue::PushStr(_) => common::make_str_type.clone std::Option::Some
            common::OpValue::PushBool(_) => common::make_bool_type.clone std::Option::Some
            common::OpValue::PushChar(_) => common::make_char_type.clone std::Option::Some
            _ => std::Option[common::Type]::None
        end
    }

    pub fn format_type_hover self:$AnalyzedDocument name:$str -> std::Option[std::String] {
        if name self.lookup_struct std::Option::Some(casa_struct) is then
            casa_struct.format_hover std::Option::Some return
        fi
        if name self.lookup_enum std::Option::Some(casa_enum) is then
            casa_enum.format_hover std::Option::Some return
        fi
        std::Option[std::String]::None
    }

    pub fn format_hover self:$AnalyzedDocument symbol:$DocumentElement -> std::Option[std::String] {
        if symbol.part SymbolPart::Separator is then
            std::Option[std::String]::None return
        fi

        if symbol.part SymbolPart::TypeName is then
            if
                symbol.op.value common::OpValue::FnCall is
                symbol.op.value common::OpValue::FnPush is ||
            then
                symbol.op common::op_str_value.as_str "::" str::split = parts
                0 parts.get.as_str self.format_type_hover return
            fi
            if symbol.op.value common::OpValue::PushEnumVariant(variant) is then
                variant.enum_name.as_str self.format_type_hover return
            fi
            std::Option[std::String]::None return
        fi

        if
            symbol.op.value common::OpValue::FnCall is
            symbol.op.value common::OpValue::FnPush is ||
        then
            symbol.op common::op_str_value = name
            if name.as_str self.lookup_function std::Option::Some(function) is then
                function.format_hover std::Option::Some
            else
                std::Option[std::String]::None
            fi
            return
        fi

        if
            symbol.op.value common::OpValue::PushVar is
            symbol.op.value common::OpValue::PushCapture is ||
        then
            symbol.op common::op_str_value = name
            if symbol self.find_symbol_type std::Option::Some(variable_type) is then
                f"{name}: {variable_type.format}" std::Option::Some
            else
                name.clone std::Option::Some
            fi
            return
        fi

        symbol.op.value match
            common::OpValue::StructNew(casa_struct) => casa_struct.format_hover std::Option::Some
            common::OpValue::PushEnumVariant(variant) => {
                f"{variant.enum_name}::{variant.variant_name}" std::Option::Some
            }
            common::OpValue::PushInt(value) => {
                if symbol.op.type_hint std::Option::Some(literal_type) is then
                    f"{value.raw}: {literal_type.format}" std::Option::Some
                else
                    f"{value.raw}: i64" std::Option::Some
                fi
            }
            common::OpValue::PushFloat(value) => {
                if symbol.op.type_hint std::Option::Some(literal_type) is then
                    f"{value}: {literal_type.format}" std::Option::Some
                else
                    f"{value}: f64" std::Option::Some
                fi
            }
            common::OpValue::PushStr(value) => f"\"{value}\": str" std::Option::Some
            common::OpValue::PushBool(value) => {
                if value 0 != then "true: bool".to_str else "false: bool".to_str fi std::Option::Some
            }
            common::OpValue::PushChar(value) => f"'{value.to_str}': char" std::Option::Some
            common::OpValue::AssignVar(name) => {
                if symbol self.find_symbol_type std::Option::Some(variable_type) is then
                    f"= {name}: {variable_type.format}" std::Option::Some
                else
                    f"= {name}" std::Option::Some
                fi
            }
            _ => symbol
                .op
                .value
                .format_hover
        end
    }

    pub fn find_enum_name_for_variant
        self:$AnalyzedDocument
        symbol:$DocumentSymbol
    -> std::Option[std::String] {
        for
            enum_name in self
                .enums
                .keys
                .iter
        do
            enum_name self
                .enums
                .get
                .unwrap = casa_enum
            if symbol.name casa_enum.variant_locations.get std::Option::Some(location) is then
                if location symbol.declaration.matches then
                    enum_name.clone std::Option::Some return
                fi
            fi
        done
        std::Option[std::String]::None
    }

    pub fn format_declaration_hover
        self:$AnalyzedDocument
        symbol:$DocumentSymbol
    -> std::Option[std::String] {
        symbol.kind match
            DocumentSymbolKind::Function => {
                if symbol.name.as_str self.lookup_function std::Option::Some(function) is then
                    function.format_hover std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            DocumentSymbolKind::Variable => std::Option[std::String]::None
            DocumentSymbolKind::Struct => {
                if symbol.name.as_str self.lookup_struct std::Option::Some(casa_struct) is then
                    casa_struct.format_hover std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            DocumentSymbolKind::Enum => {
                if symbol.name.as_str self.lookup_enum std::Option::Some(casa_enum) is then
                    casa_enum.format_hover std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            DocumentSymbolKind::EnumVariant => {
                if symbol self.find_enum_name_for_variant std::Option::Some(enum_name) is then
                    f"{enum_name}::{symbol.name}" std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
        end
    }

    pub fn find_declaration_hover_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
    -> std::Option[DocumentHover] {
        if position self.find_declared_symbol_at std::Option::Some(symbol) is then
            symbol self.format_declaration_hover match
                std::Option::Some(content) => symbol.declaration self.locate content DocumentHover std::Option::Some return
                std::Option::None => {
                }
            end
        fi
        if position self.find_function_at std::Option::Some(function) is then
            function.location self.locate function.format_hover DocumentHover std::Option::Some return
        fi
        std::Option[DocumentHover]::None
    }

    pub fn find_hover_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
    -> std::Option[DocumentHover] {
        position self.find_declaration_hover_at match
            std::Option::Some(hover) => hover std::Option::Some return
            std::Option::None => {
            }
        end
        if position self.find_symbol_at std::Option::Some(symbol) is then
            symbol self.format_hover match
                std::Option::Some(content) => symbol.location self.locate content DocumentHover std::Option::Some return
                std::Option::None => {
                }
            end
        fi
        std::Option[DocumentHover]::None
    }

    pub fn find_variable_definition
        self:$AnalyzedDocument
        name:$str
        function:$std::Option[common::Function]
        usage_offset:u64
    -> std::Option[common::Location] {
        std::Option[common::Op]::None = best
        if function std::Option::Some(containing_function) is then
            best usage_offset containing_function.ops name find_best_assignment = best
        fi
        if best.is_none then
            best usage_offset self.ops name find_best_assignment = best
        fi
        if best std::Option::Some(definition_op) is then
            definition_op.location.clone std::Option::Some
        else
            std::Option[common::Location]::None
        fi
    }

    pub fn find_type_definition self:$AnalyzedDocument name:$str -> std::Option[common::Location] {
        if name self.lookup_struct std::Option::Some(casa_struct) is then
            casa_struct.location.clone std::Option::Some return
        fi
        if name self.lookup_enum std::Option::Some(casa_enum) is then
            casa_enum.location.clone std::Option::Some return
        fi
        std::Option[common::Location]::None
    }

    pub fn find_callable_definition
        self:$AnalyzedDocument
        symbol:$DocumentElement
    -> std::Option[common::Location] {
        if symbol.part SymbolPart::TypeName is then
            symbol.op common::op_str_value.as_str "::" str::split = parts
            0 parts.get.as_str self.find_type_definition return
        fi
        if symbol.op common::op_str_value.as_str self.lookup_function std::Option::Some(function) is then
            if "" function.location.file != then
                function.location.clone std::Option::Some return
            fi
        fi
        std::Option[common::Location]::None
    }

    pub fn find_enum_definition
        self:$AnalyzedDocument
        symbol:$DocumentElement
        variant:$common::EnumVariant
    -> std::Option[common::Location] {
        variant.enum_name.as_str self.lookup_enum = enum_result
        if enum_result std::Option::Some(casa_enum) is then
            if symbol.part SymbolPart::MemberName is then
                variant.variant_name casa_enum.variant_locations.get = variant_location
                if variant_location std::Option::Some(location) is then
                    location.clone std::Option::Some return
                fi
            fi
            casa_enum.location.clone std::Option::Some return
        fi
        std::Option[common::Location]::None
    }

    pub fn find_definition
        self:$AnalyzedDocument
        symbol:$DocumentElement
    -> std::Option[common::Location] {
        if symbol.part SymbolPart::Separator is then
            std::Option[common::Location]::None return
        fi
        symbol.op.value match
            common::OpValue::FnCall(_) => symbol self.find_callable_definition
            common::OpValue::FnPush(_) => symbol self.find_callable_definition
            common::OpValue::PushVar(name) => {
                symbol
                    .op
                    .location
                    .span
                    .offset
                symbol.containing_function
                name.as_str
                self.find_variable_definition
            }
            common::OpValue::PushCapture(name) => {
                symbol
                    .op
                    .location
                    .span
                    .offset
                symbol.containing_function
                name.as_str
                self.find_variable_definition
            }
            common::OpValue::StructNew(casa_struct) => casa_struct.location.clone std::Option::Some
            common::OpValue::PushEnumVariant(variant) => variant symbol self.find_enum_definition
            _ => std::Option[common::Location]::None
        end
    }

    pub fn find_definition_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
    -> std::Option[DocumentLocation] {
        if position self.find_symbol_at std::Option::Some(symbol) is then
            if symbol self.find_definition std::Option::Some(location) is then
                location self.locate std::Option::Some return
            fi
        fi
        std::Option[DocumentLocation]::None
    }

    pub fn locate self:$AnalyzedDocument location:$common::Location -> DocumentLocation {
        location.span.length location.span.offset location.file.clone DocumentLocation
    }
}
