}

impl AnalyzedDocument {
    pub fn new
        analysis:analysis::AnalysisResult
        source:std::String
        file_path:std::String
    -> AnalyzedDocument {
        std::Option[QueryReason]::None = coverage
        for
            diagnostic in analysis
                .diagnostics
                .entries
                .iter
        do
            if diagnostic error::Diagnostic::Error(failure) is then
                failure classify_query_failure std::Option::Some = coverage
            fi
        done
        file_path.as_str analysis.sources.retain_used
        file_path.clone = root_file
        source.clone = root_source
        coverage file_path source analysis IndexBuilder::new.project = document
        root_file = document.file_path
        root_source = document.source
        document
    }

    pub fn into_parts self:AnalyzedDocument -> EditorIndex lexer::SourceStore {
        self match
            AnalyzedDocument { index: index sources: sources } => index sources
        end
    }

    pub fn get_index self:$AnalyzedDocument -> $EditorIndex { self.index }

    pub fn is_incomplete self:$AnalyzedDocument -> bool { self.index.coverage.is_some }

    fn query_offset self:$AnalyzedDocument position:$common::SourcePosition -> std::Option[u64] {
        if 0 position.line == 0 position.column == || then
            std::Option[u64]::None return
        fi
        if
            self.file_path.as_str self
                .sources
                .line_starts
                .get_str std::Option::Some(starts) is
        then
            if starts.length position.line > then
                std::Option[u64]::None return
            fi
            position.line 1 - starts.get copy position.column 1 - + = offset
            if self.source.length offset > then
                std::Option[u64]::None return
            fi
            if starts.length position.line < then
                if position.line starts.get copy offset >= then
                    std::Option[u64]::None return
                fi
            fi
            offset std::Option::Some
        else
            std::Option[u64]::None
        fi
    }

    pub fn find_hover_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
    -> std::Option[DocumentHover] {
        if position self.query_offset std::Option::Some(offset) is then
            offset copy self.file_path.as_str self.index.find_hover match
                PointAnswer::Known(hover) => hover std::Option::Some return
                _ => {
                }
            end
        fi
        std::Option[DocumentHover]::None
    }

    pub fn find_definition_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
    -> std::Option[DocumentLocation] {
        if position self.query_offset std::Option::Some(offset) is then
            offset copy self.file_path.as_str self.index.find_definition match
                PointAnswer::Known(location) => location std::Option::Some return
                _ => {
                }
            end
        fi
        std::Option[DocumentLocation]::None
    }

    pub fn find_completion_candidates
        self:$AnalyzedDocument
        position:$common::SourcePosition
        trigger:$str
    -> std::List[CompletionCandidate] {
        if position self.query_offset std::Option::Some(offset) is then
            trigger offset copy self.file_path.as_str self.index.find_candidates match
                ListAnswer::Complete(items) => items return
                ListAnswer::Incomplete(items _) => items return
                _ => {
                }
            end
        fi
        std::List[CompletionCandidate]::new
    }

    pub fn find_symbol_identity_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
    -> std::Option[DocumentSymbol] {
        if position self.query_offset std::Option::Some(offset) is then
            if offset copy self.file_path.as_str self.index.find_occurrence std::Option::Some(index) is then
