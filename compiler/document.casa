    pub fn find_definition
        self:$IndexBuilder
        symbol:$DocumentElement
    -> std::Option[common::Location] {
        if symbol.part SymbolPart::Separator is then
            std::Option[common::Location]::None return
        fi
        symbol.op.value match
            semantic_body::OccurrenceValue::FnCall(_) => symbol self.find_callable_definition
            semantic_body::OccurrenceValue::FnPush(_) => symbol self.find_callable_definition
            semantic_body::OccurrenceValue::PushVar(_) => symbol.op self.find_binding_definition
            semantic_body::OccurrenceValue::PushCapture(_) => symbol.op self.find_binding_definition
            semantic_body::OccurrenceValue::AssignVar(_) => symbol.op self.find_binding_definition
            semantic_body::OccurrenceValue::AssignInc(_) => symbol.op self.find_binding_definition
            semantic_body::OccurrenceValue::AssignDec(_) => symbol.op self.find_binding_definition
