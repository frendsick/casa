# Semantic queries over one analyzed source document.
import "std"
import "analysis"

enum SymbolPart {
    Whole
    TypeName
    Separator
    MemberName
}

enum DocumentSymbolKind {
    Function
    Variable
    Struct
    Enum
    EnumVariant
}

struct AnalyzedDocument {
    ops:       List[Op]
    functions: Map[str Function]
    structs:   Map[str CasaStruct]
    enums:     Map[str CasaEnum]
    variables: Map[str Variable]
    sources:   SourceStore
    source:    str
    file_path: str
}

struct DocumentElement {
    op:                  Op
    containing_function: Option[Function]
    part:                SymbolPart
    location:            Location
}

struct DocumentLocation {
    file:   str
    offset: u64
    length: u64
}

struct DocumentHover {
    content:  str
    location: DocumentLocation
}

enum DocumentTokenKind {
    Function
    Variable
    String
    Number
    Keyword
    Operator
    Type
    EnumMember
    Struct
    Macro
}

struct DocumentToken {
    kind:     DocumentTokenKind
    location: DocumentLocation
}

impl DocumentToken {
    fn comes_before self:$DocumentToken pivot:$DocumentToken -> bool {
        pivot.location.offset self.location.offset <
    }
}

enum CompletionCandidate {
    Function (Function)
    Variable (Variable)
    Keyword (KeywordKind)
    Intrinsic (IntrinsicKind)
    Struct (CasaStruct)
    Enum (CasaEnum)
    EnumVariant (str)
    Method (Function)
}

struct DocumentSymbol {
    kind:        DocumentSymbolKind
    name:        str
    declaration: Location
    owner:       Option[Function]
}

struct FindSymbolState {
    best:        Option[DocumentElement]
    best_length: u64
}

impl Location {
    fn matches self:$Location other:$Location -> bool {
        self.file other.file ==
        self.span.offset other.span.offset == &&
        self.span.length other.span.length == &&
    }

    fn contains_offset self:$Location file_path:$str offset:u64 -> bool {
        if self.file file_path != then false return fi
        self.span.offset offset >=
        offset self.span.offset self.span.length + > &&
    }
}

impl DocumentSymbol {
    fn new
        kind:DocumentSymbolKind
        name:$str
        declaration:$Location
        owner:Option[Function]
    -> DocumentSymbol {
        owner declaration.clone name.clone kind DocumentSymbol
    }

    fn matches_identity self:$DocumentSymbol other:$DocumentSymbol -> bool {
        if self.kind other.kind != self.name other.name != || then false return fi
        if other.declaration self.declaration.matches ! then false return fi
        if self.owner Option::Some(self_owner) is then
            if other.owner Option::Some(other_owner) is then
                other_owner.location self_owner.location.matches return
            fi
            false return
        fi
        other.owner.is_none
    }

    fn has_declaration_reference self:$DocumentSymbol -> bool {
        self.kind match
            DocumentSymbolKind::Function => true
            DocumentSymbolKind::Variable => false
            DocumentSymbolKind::Struct => true
            DocumentSymbolKind::Enum => true
            DocumentSymbolKind::EnumVariant => true
        end
    }
}

fn find_qualified_part source:$str op:$Op cursor_offset:u64 -> SymbolPart {
    op.location.span.offset = start
    op.location.span.length = length
    source start length str::substring "::" str::find = separator
    if 0 separator < then SymbolPart::Whole return fi
    separator (u64) = separator_index
    cursor_offset start - = relative_offset
    if relative_offset separator_index > then
        SymbolPart::TypeName
    elif relative_offset separator_index 2 + > then
        SymbolPart::Separator
    else
        SymbolPart::MemberName
    fi
}

fn get_symbol_location source:$str op:$Op part:$SymbolPart -> Location {
    op.location.span.offset = start
    op.location.span.length = length
    source start length str::substring "::" str::find = separator
    separator (u64) = separator_index
    part match
        SymbolPart::TypeName => separator_index start op.location.file Location::new
        SymbolPart::Separator => 2 start separator_index + op.location.file Location::new
        SymbolPart::MemberName => {
            length separator_index - 2 -
            start separator_index + 2 +
            op.location.file
            Location::new
        }
        SymbolPart::Whole => op.location
    end
}

fn find_best_spanning_symbol
    ops:$List[Op]
    file_path:$str
    source:$str
    offset:u64
    function:Option[Function]
    find_state:FindSymbolState
-> FindSymbolState {
    for op in ops.iter do
        if op.location.file file_path != then continue fi
        op.location.span.offset = span_offset
        op.location.span.length = span_length
        if 1 span_length < then 1 (u64) = span_length fi
        if
        span_offset offset >=
        offset span_offset span_length + > &&
        find_state.best.is_none span_length find_state.best_length > || &&
        then
            offset op source find_qualified_part = part
            part op source get_symbol_location = location
            span_length
            location
            part
            function
            op
            DocumentElement Option::Some FindSymbolState = find_state
        fi
    done
    find_state
}

fn find_best_assignment name:$str ops:$List[Op] usage_offset:u64 best:Option[Op] -> Option[Op] {
    for op in ops.iter do
        if op.value OpValue::AssignVar(assign_name) is then
            if assign_name name != then continue fi
            if op.location.span.offset usage_offset > then
                op Option::Some = best
            elif best.is_none then
                op Option::Some = best
            fi
        fi
    done
    best
}

fn extract_word_before source:$str offset:u64 -> str {
    offset = end_pos
    end_pos = start_pos
    while 0 start_pos != do
        1 -= start_pos
        start_pos source.at = character
        if character.is_alpha ! character.is_digit ! && character '_' != && then
            1 += start_pos
            break
        fi
    done
    source start_pos end_pos start_pos - str::substring
}

fn extract_chain_before source:$str offset:u64 -> List[str] {
    List[str]::new = reversed_parts
    offset = position
    while 0 position > do
        position source extract_word_before = word
        if 0 word.length == then break fi
        word.length = word_length
        word reversed_parts.push
        word_length position swap - = position
        if 0 position > then
            if '.' position 1 - source.at == then
                1 -= position
            else
                break
            fi
        fi
    done

    List[str]::new = parts
    reversed_parts.length = reverse_index
    while 0 reverse_index != do
        1 -= reverse_index
        reverse_index reversed_parts.get parts.push
    done
    parts
}

fn infer_literal_type text:$str -> Option[Type] {
    if 0 text.length == then Option[Type]::None return fi
    true = all_digits
    for character in text.iter do
        if character.is_digit ! then
            false = all_digits
            break
        fi
    done
    if all_digits then TYPE_I64_T Option::Some return fi
    if text is_float_literal then TYPE_F64_T Option::Some return fi
    if text "true" == text "false" == || then TYPE_BOOL_T Option::Some return fi
    Option[Type]::None
}

fn find_first_assignment name:$str ops:$List[Op] -> Option[Location] {
    for op in ops.iter do
        if op.value OpValue::AssignVar(assign_name) is then
            if assign_name name == then op.location Option::Some return fi
        fi
    done
    Option[Location]::None
}

fn is_qualified_operation source:$str op:$Op -> bool {
    if 0 op.location.span.length == then false return fi
    source op.location.span.offset op.location.span.length str::substring "::" str::contains
}

fn find_document_token_kind op_value:$OpValue -> Option[DocumentTokenKind] {
    op_value match
        OpValue::FnCall(_) => DocumentTokenKind::Function Option::Some
        OpValue::FnPush(_) => DocumentTokenKind::Function Option::Some
        OpValue::MethodCall(_) => DocumentTokenKind::Function Option::Some
        OpValue::TraitMethodCall(_) => DocumentTokenKind::Function Option::Some
        OpValue::PushVar(_) => DocumentTokenKind::Variable Option::Some
        OpValue::PushCapture(_) => DocumentTokenKind::Variable Option::Some
        OpValue::AssignVar(_) => DocumentTokenKind::Variable Option::Some
        OpValue::AssignInc(_) => DocumentTokenKind::Variable Option::Some
        OpValue::AssignDec(_) => DocumentTokenKind::Variable Option::Some
        OpValue::PushStr(_) => DocumentTokenKind::String Option::Some
        OpValue::PushInt(_) => DocumentTokenKind::Number Option::Some
        OpValue::PushFloat(_) => DocumentTokenKind::Number Option::Some
        OpValue::PushChar(_) => DocumentTokenKind::Number Option::Some
        OpValue::PushBool(_) => DocumentTokenKind::Keyword Option::Some
        OpValue::FnExec => DocumentTokenKind::Keyword Option::Some
        OpValue::IfStart => DocumentTokenKind::Keyword Option::Some
        OpValue::IfCondition => DocumentTokenKind::Keyword Option::Some
        OpValue::IfElif => DocumentTokenKind::Keyword Option::Some
        OpValue::IfElse => DocumentTokenKind::Keyword Option::Some
        OpValue::IfEnd => DocumentTokenKind::Keyword Option::Some
        OpValue::WhileStart => DocumentTokenKind::Keyword Option::Some
        OpValue::WhileCondition => DocumentTokenKind::Keyword Option::Some
        OpValue::WhileEnd => DocumentTokenKind::Keyword Option::Some
        OpValue::WhileBreak => DocumentTokenKind::Keyword Option::Some
        OpValue::WhileContinue => DocumentTokenKind::Keyword Option::Some
        OpValue::MatchStart => DocumentTokenKind::Keyword Option::Some
        OpValue::MatchArm(_) => DocumentTokenKind::Keyword Option::Some
        OpValue::MatchEnd => DocumentTokenKind::Keyword Option::Some
        OpValue::FnReturn => DocumentTokenKind::Keyword Option::Some
        OpValue::Add => DocumentTokenKind::Operator Option::Some
        OpValue::Sub => DocumentTokenKind::Operator Option::Some
        OpValue::Mul => DocumentTokenKind::Operator Option::Some
        OpValue::Div => DocumentTokenKind::Operator Option::Some
        OpValue::Mod => DocumentTokenKind::Operator Option::Some
        OpValue::Shl => DocumentTokenKind::Operator Option::Some
        OpValue::Shr => DocumentTokenKind::Operator Option::Some
        OpValue::BitAnd => DocumentTokenKind::Operator Option::Some
        OpValue::BitOr => DocumentTokenKind::Operator Option::Some
        OpValue::BitXor => DocumentTokenKind::Operator Option::Some
        OpValue::BitNot => DocumentTokenKind::Operator Option::Some
        OpValue::And => DocumentTokenKind::Operator Option::Some
        OpValue::Or => DocumentTokenKind::Operator Option::Some
        OpValue::Not => DocumentTokenKind::Operator Option::Some
        OpValue::Eq => DocumentTokenKind::Operator Option::Some
        OpValue::Ne => DocumentTokenKind::Operator Option::Some
        OpValue::Lt => DocumentTokenKind::Operator Option::Some
        OpValue::Le => DocumentTokenKind::Operator Option::Some
        OpValue::Gt => DocumentTokenKind::Operator Option::Some
        OpValue::Ge => DocumentTokenKind::Operator Option::Some
        OpValue::TypeCast(_) => DocumentTokenKind::Type Option::Some
        OpValue::PushEnumVariant(_) => DocumentTokenKind::EnumMember Option::Some
        OpValue::StructNew(_) => DocumentTokenKind::Struct Option::Some
        OpValue::Drop => DocumentTokenKind::Macro Option::Some
        OpValue::Dup => DocumentTokenKind::Macro Option::Some
        OpValue::Copy => DocumentTokenKind::Macro Option::Some
        OpValue::Swap => DocumentTokenKind::Macro Option::Some
        OpValue::Over => DocumentTokenKind::Macro Option::Some
        OpValue::Rot => DocumentTokenKind::Macro Option::Some
        OpValue::Print => DocumentTokenKind::Macro Option::Some
        OpValue::PrintInt => DocumentTokenKind::Macro Option::Some
        OpValue::PrintStr => DocumentTokenKind::Macro Option::Some
        OpValue::PrintBool => DocumentTokenKind::Macro Option::Some
        OpValue::PrintChar => DocumentTokenKind::Macro Option::Some
        OpValue::PrintCstr => DocumentTokenKind::Macro Option::Some
        OpValue::HeapAlloc => DocumentTokenKind::Macro Option::Some
        OpValue::Load8 => DocumentTokenKind::Macro Option::Some
        OpValue::Load16 => DocumentTokenKind::Macro Option::Some
        OpValue::Load32 => DocumentTokenKind::Macro Option::Some
        OpValue::Load64 => DocumentTokenKind::Macro Option::Some
        OpValue::Store8 => DocumentTokenKind::Macro Option::Some
        OpValue::Store16 => DocumentTokenKind::Macro Option::Some
        OpValue::Store32 => DocumentTokenKind::Macro Option::Some
        OpValue::Store64 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall0 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall1 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall2 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall3 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall4 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall5 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall6 => DocumentTokenKind::Macro Option::Some
        OpValue::Typeof => DocumentTokenKind::Macro Option::Some
        _ => Option[DocumentTokenKind]::None
    end
}

fn classify_qualified_member op_value:$OpValue -> DocumentTokenKind {
    if op_value OpValue::PushEnumVariant is then
        DocumentTokenKind::EnumMember
    else
        DocumentTokenKind::Function
    fi
}

fn find_keyword_before source:$str file_path:$str name_offset:u64 keyword:$str -> Option[Location] {
    name_offset = position
    while 0 position != do
        1 -= position
        position source.at = character
        if ' ' character != '\t' character != && '\n' character != && then break fi
    done
    if keyword.length position 1 + >= then
        position 1 + keyword.length - = keyword_start
        if source keyword_start keyword.length str::substring keyword == then
            keyword.length keyword_start file_path.clone Location::new Option::Some return
        fi
    fi
    Option[Location]::None
}

impl Function {
    fn format_hover self:$Function -> str {
        StringBuilder::new = builder
        "fn " builder.append
        self.name builder.append
        if 0 self.stack_effect.parameters.length != then
            " " builder.append
            List[str]::new = parameters
            for parameter in self.stack_effect.parameters.iter do
                if "" parameter.name != then
                    f"{parameter.name}:{parameter.typ.format}"
                else
                    parameter.typ.format
                fi
                parameters.push
            done
            " " parameters.join builder.append
        fi
        " -> " builder.append
        if 0 self.stack_effect.return_types.length != then
            List[str]::new = return_types
            for return_type in self.stack_effect.return_types.iter do
                return_type.format return_types.push
            done
            " " return_types.join builder.append
        else
            "None" builder.append
        fi
        builder.build
    }
}

impl CasaStruct {
    fn format_hover self:$CasaStruct -> str {
        StringBuilder::new = builder
        "struct " builder.append
        self.name builder.append
        " { " builder.append
        List[str]::new = members
        for member in self.members.iter do
            f"{member.name}: {member.typ.format}" members.push
        done
        ", " members.join builder.append
        " }" builder.append
        builder.build
    }
}

impl CasaEnum {
    fn format_hover self:$CasaEnum -> str {
        StringBuilder::new = builder
        "enum " builder.append
        self.name builder.append
        " { " builder.append
        ", " self.variants.join builder.append
        " }" builder.append
        builder.build
    }
}

impl OpValue {
    fn format_hover self:$OpValue -> Option[str] {
        self match
            OpValue::Add => "+: T T -> T (same-width integers)" Option::Some
            OpValue::Sub => "-: T T -> T (same-width integers)" Option::Some
            OpValue::Mul => "*: T T -> T (same-width integers)" Option::Some
            OpValue::Div => "/: T T -> T (same-width integers)" Option::Some
            OpValue::Mod => "%: T T -> T (same-width integers)" Option::Some
            OpValue::Shl => "<<: T u64 -> T (integer T)" Option::Some
            OpValue::Shr => ">>: T u64 -> T (integer T)" Option::Some
            OpValue::BitAnd => "&: T T -> T (same-width integers)" Option::Some
            OpValue::BitOr => "|: T T -> T (same-width integers)" Option::Some
            OpValue::BitXor => "^: T T -> T (same-width integers)" Option::Some
            OpValue::BitNot => "~: T -> T (integer T)" Option::Some
            OpValue::Not => "!: bool -> bool" Option::Some
            OpValue::Eq => "==: [T: Eq] T T -> bool" Option::Some
            OpValue::Ne => "!=: [T: Eq] T T -> bool" Option::Some
            OpValue::Lt => "<: [T: Ord] T T -> bool" Option::Some
            OpValue::Le => "<=: [T: Ord] T T -> bool" Option::Some
            OpValue::Gt => ">: [T: Ord] T T -> bool" Option::Some
            OpValue::Ge => ">=: [T: Ord] T T -> bool" Option::Some
            OpValue::And => "&&: bool bool -> bool" Option::Some
            OpValue::Or => "||: bool bool -> bool" Option::Some
            OpValue::Drop => "drop: T -> None" Option::Some
            OpValue::Dup => "dup: [T: Copy] T -> T T" Option::Some
            OpValue::Copy => "copy: [T: Copy] T -> T" Option::Some
            OpValue::Swap => "swap: T1 T2 -> T2 T1" Option::Some
            OpValue::Over => "over: [T2: Copy] T1 T2 -> T2 T1 T2" Option::Some
            OpValue::Rot => "rot: T1 T2 T3 -> T3 T1 T2" Option::Some
            OpValue::Print => "print: [T: Display] T -> None" Option::Some
            OpValue::PrintInt => "print: [T: Display] T -> None" Option::Some
            OpValue::PrintStr => "print: [T: Display] T -> None" Option::Some
            OpValue::PrintBool => "print: [T: Display] T -> None" Option::Some
            OpValue::PrintChar => "print: [T: Display] T -> None" Option::Some
            OpValue::PrintCstr => "print: [T: Display] T -> None" Option::Some
            OpValue::FnExec => "exec: fn[...] -> ..." Option::Some
            OpValue::Typeof => "typeof: T -> str" Option::Some
            OpValue::AssignDec(_) => "-=: T -> None (integer T)" Option::Some
            OpValue::AssignInc(_) => "+=: T -> None (integer T)" Option::Some
            OpValue::HeapAlloc => "alloc: u64 -> ptr" Option::Some
            OpValue::Load8 => "load8: ptr -> u8" Option::Some
            OpValue::Load16 => "load16: ptr -> u16" Option::Some
            OpValue::Load32 => "load32: ptr -> u32" Option::Some
            OpValue::Load64 => "load64: ptr -> u64" Option::Some
            OpValue::Store8 => "store8: u8 ptr -> None" Option::Some
            OpValue::Store16 => "store16: u16 ptr -> None" Option::Some
            OpValue::Store32 => "store32: u32 ptr -> None" Option::Some
            OpValue::Store64 => "store64: u64 ptr -> None" Option::Some
            OpValue::Syscall0 => "syscall0: i64 -> i64" Option::Some
            OpValue::Syscall1 => "syscall1[A1: Word]: A1 i64 -> i64" Option::Some
            OpValue::Syscall2 => "syscall2[A1: Word A2: Word]: A1 A2 i64 -> i64" Option::Some
            OpValue::Syscall3 => "syscall3[A1: Word A2: Word A3: Word]: A1 A2 A3 i64 -> i64" Option::Some
            OpValue::Syscall4 => "syscall4[A1: Word A2: Word A3: Word A4: Word]: A1 A2 A3 A4 i64 -> i64" Option::Some
            OpValue::Syscall5 => "syscall5[A1: Word A2: Word A3: Word A4: Word A5: Word]: A1 A2 A3 A4 A5 i64 -> i64" Option::Some
            OpValue::Syscall6 => "syscall6[A1: Word A2: Word A3: Word A4: Word A5: Word A6: Word]: A1 A2 A3 A4 A5 A6 i64 -> i64" Option::Some
            OpValue::Argc => "argc: None -> i64" Option::Some
            OpValue::Argv => "argv: None -> ptr" Option::Some
            _ => Option[str]::None
        end
    }
}

impl AnalyzedDocument {
    fn new analysis:$AnalysisResult source:$str file_path:$str -> AnalyzedDocument {
        symbol_store_new = store
        List[Op]::new = ops
        if analysis.typechecked Option::Some(typecheck_result) is then
            typecheck_result.ops = ops
            typecheck_result.store = store
        fi
        file_path.clone
        source.clone
        analysis.sources
        store.variables
        store.enums
        store.structs
        store.functions
        ops
        AnalyzedDocument
    }

    fn collect_document_functions self:$AnalyzedDocument -> List[Function] {
        List[Function]::new = functions
        for function_name in self.functions.keys.iter do
            function_name self.functions.get.unwrap = function
            if "" function.location.file == then continue fi
            if function.location.file self.file_path != then continue fi
            function functions.push
        done
        functions
    }

    fn collect_operation_tokens
        self:$AnalyzedDocument
        ops:$List[Op]
        tokens:mut$List[DocumentToken]
    {
        for op in ops.iter do
            if op.location.file self.file_path != 0 op.location.span.length <= || then continue fi
            if op.value find_document_token_kind Option::Some(kind) is then
                if
                op.value OpValue::FnCall is
                op.value OpValue::FnPush is ||
                op.value OpValue::PushEnumVariant is ||
                op self.source is_qualified_operation &&
                then
                    SymbolPart::TypeName op self.source get_symbol_location self.locate
                    DocumentTokenKind::Type DocumentToken tokens.push
                    SymbolPart::MemberName op self.source get_symbol_location self.locate
                    op.value classify_qualified_member
                    DocumentToken tokens.push
                else
                    op.location self.locate kind DocumentToken tokens.push
                fi
            fi
        done
    }

    fn collect_declaration_token
        self:$AnalyzedDocument
        location:$Location
        keyword:$str
        kind:DocumentTokenKind
        tokens:mut$List[DocumentToken]
    {
        if location.file self.file_path != 0 location.span.length <= || then return fi
        location self.locate kind DocumentToken tokens.push
        if keyword location.span.offset self.file_path self.source find_keyword_before Option::Some(keyword_location) is then
            keyword_location self.locate DocumentTokenKind::Keyword DocumentToken tokens.push
        fi
    }

    fn find_semantic_tokens self:$AnalyzedDocument -> List[DocumentToken] {
        List[DocumentToken]::new = tokens
        tokens self.ops self.collect_operation_tokens
        for function in self.collect_document_functions.iter do
            tokens function.ops self.collect_operation_tokens
            if
            function.name "lambda__" str::starts_with !
            function.name "__" str::starts_with ! &&
            then
                tokens DocumentTokenKind::Function "fn" function.location self.collect_declaration_token
            fi
        done
        for enum_name in self.enums.keys.iter do
            enum_name self.enums.get.unwrap = casa_enum
            tokens DocumentTokenKind::Type "enum" casa_enum.location self.collect_declaration_token
        done
        for struct_name in self.structs.keys.iter do
            struct_name self.structs.get.unwrap = casa_struct
            tokens DocumentTokenKind::Struct "struct" casa_struct.location self.collect_declaration_token
        done
        &DocumentToken::comes_before tokens.sort_by
        tokens
    }

    fn find_symbol_at self:$AnalyzedDocument position:$SourcePosition -> Option[DocumentElement] {
        position self.file_path self.sources.convert_position_to_offset.unwrap = offset
        0 Option[DocumentElement]::None FindSymbolState = find_state
        find_state
        Option[Function]::None
        offset
        self.source
        self.file_path
        self.ops
        find_best_spanning_symbol = find_state
        for function in self.collect_document_functions.iter do
            find_state
            function Option::Some
            offset
            self.source
            self.file_path
            function.ops
            find_best_spanning_symbol = find_state
        done
        find_state.best
    }

    fn find_completion_candidates
        self:$AnalyzedDocument
        position:$SourcePosition
        trigger:$str
    -> List[CompletionCandidate] {
        position self.file_path self.sources.convert_position_to_offset.unwrap = cursor_offset
        if trigger "." == trigger ":" == || then
            cursor_offset self.find_triggered_completion_candidates return
        fi

        List[CompletionCandidate]::new = candidates
        for function_name in self.functions.keys.iter do
            if
            function_name "lambda__" str::starts_with
            function_name "__" str::starts_with ||
            function_name "::" str::contains ||
            then
                continue
            fi
            function_name self.functions.get.unwrap CompletionCandidate::Function candidates.push
        done

        for struct_name in self.structs.keys.iter do
            struct_name self.structs.get.unwrap CompletionCandidate::Struct candidates.push
        done

        for enum_name in self.enums.keys.iter do
            enum_name self.enums.get.unwrap CompletionCandidate::Enum candidates.push
        done

        if cursor_offset self.find_containing_function Option::Some(function) is then
            for variable in function.variables.iter do
                variable CompletionCandidate::Variable candidates.push
            done
        fi
        for variable_name in self.variables.keys.iter do
            if variable_name self.variables.get Option::Some(variable) is then
                variable CompletionCandidate::Variable candidates.push
            fi
        done

        KeywordKind (u64) = keyword_count
        0 (u64) = keyword_index
        while keyword_index keyword_count > do
            keyword_index (KeywordKind) CompletionCandidate::Keyword candidates.push
            1 += keyword_index
        done

        IntrinsicKind (u64) = intrinsic_count
        0 (u64) = intrinsic_index
        while intrinsic_index intrinsic_count > do
            intrinsic_index (IntrinsicKind) CompletionCandidate::Intrinsic candidates.push
            1 += intrinsic_index
        done
        candidates
    }

    fn find_methods_for_type
        self:$AnalyzedDocument
        receiver_type:$Type
    -> List[CompletionCandidate] {
        f"{receiver_type.match_base}::" = method_prefix
        List[CompletionCandidate]::new = candidates
        for function_name in self.functions.keys.iter do
            if function_name method_prefix str::starts_with then
                function_name self.functions.get.unwrap CompletionCandidate::Method candidates.push
            fi
        done
        candidates
    }

    fn find_qualified_completion_candidates
        self:$AnalyzedDocument
        type_name:$str
    -> List[CompletionCandidate] {
        List[CompletionCandidate]::new = candidates
        if type_name self.lookup_enum Option::Some(casa_enum) is then
            for variant_name in casa_enum.variants.iter do
                variant_name CompletionCandidate::EnumVariant candidates.push
            done
        fi
        type_name parse_type_str = receiver_type
        for method in receiver_type self.find_methods_for_type.iter do
            method candidates.push
        done
        candidates
    }

    fn resolve_completion_chain_type
        self:$AnalyzedDocument
        parts:$List[str]
        offset:u64
    -> Option[Type] {
        if 0 parts.length == then Option[Type]::None return fi
        offset self.find_containing_function = containing_function
        0 parts.get = first_part
        containing_function first_part self.find_variable_type = current_type
        if current_type.is_none then first_part infer_literal_type = current_type fi
        if current_type.is_none then Option[Type]::None return fi

        current_type.unwrap = resolved_type
        1 (u64) = part_index
        while part_index parts.length > do
            part_index parts.get = method_name
            f"{resolved_type.match_base}::{method_name}" self.lookup_function = function
            if function.is_none then Option[Type]::None return fi
            if 0 function.unwrap.stack_effect.return_types.length == then
                Option[Type]::None return
            fi
            0 function.unwrap.stack_effect.return_types.get = resolved_type
            1 += part_index
        done
        resolved_type Option::Some
    }

    fn find_triggered_completion_candidates
        self:$AnalyzedDocument
        offset:u64
    -> List[CompletionCandidate] {
        if 0 offset == then List[CompletionCandidate]::new return fi
        offset 1 - = position

        if 1 position >= then
            if self.source position 1 - 2 str::substring "::" == then
                position 1 - self.source extract_word_before = type_name
                if 0 type_name.length != then
                    type_name self.find_qualified_completion_candidates return
                fi
            fi
        fi

        if '.' position self.source.at == then
            position self.source extract_chain_before = chain
            if offset chain self.resolve_completion_chain_type Option::Some(receiver_type) is then
                receiver_type self.find_methods_for_type return
            fi
        fi

        List[CompletionCandidate]::new
    }

    fn find_variable_owner
        self:$AnalyzedDocument
        name:$str
        function:$Option[Function]
    -> Option[Function] {
        if function Option::Some(containing_function) is then
            if name containing_function.variables variable_list_contains then
                containing_function Option::Some return
            fi
            if name containing_function.captures variable_list_contains then
                if containing_function self.find_parent_function Option::Some(parent) is then
                    parent Option::Some name self.find_variable_owner return
                fi
            fi
        fi
        Option[Function]::None
    }

    fn find_parent_function self:$AnalyzedDocument child:$Function -> Option[Function] {
        for function_name in self.functions.keys.iter do
            function_name self.functions.get.unwrap = function
            for op in function.ops.iter do
                if op.value OpValue::FnPush(pushed_name) is then
                    if pushed_name child.name == then function Option::Some return fi
                fi
            done
        done
        Option[Function]::None
    }

    fn find_callable_symbol
        self:$AnalyzedDocument
        name:$str
        part:$SymbolPart
    -> Option[DocumentSymbol] {
        if part SymbolPart::TypeName is then
            name "::" str::split = parts
            0 parts.get self.find_type_symbol return
        fi
        if part SymbolPart::Separator is then Option[DocumentSymbol]::None return fi
        if name self.lookup_function Option::Some(function) is then
            Option[Function]::None
            function.location
            name
            DocumentSymbolKind::Function
            DocumentSymbol::new Option::Some return
        fi
        Option[DocumentSymbol]::None
    }

    fn find_enum_variant_symbol
        self:$AnalyzedDocument
        variant:$EnumVariant
        part:$SymbolPart
    -> Option[DocumentSymbol] {
        if part SymbolPart::TypeName is then variant.enum_name self.find_type_symbol return fi
        if part SymbolPart::Separator is then Option[DocumentSymbol]::None return fi
        if variant.enum_name self.lookup_enum Option::Some(casa_enum) is then
            if variant.variant_name casa_enum.variant_locations.get Option::Some(declaration) is then
                Option[Function]::None
                declaration
                variant.variant_name
                DocumentSymbolKind::EnumVariant
                DocumentSymbol::new Option::Some return
            fi
        fi
        Option[DocumentSymbol]::None
    }

    fn find_variable_symbol
        self:$AnalyzedDocument
        name:$str
        function:$Option[Function]
    -> Option[DocumentSymbol] {
        function name self.find_variable_owner = owner
        if owner Option::Some(owner_function) is then owner_function.ops else self.ops fi = operations
        if operations name find_first_assignment Option::Some(declaration) is then
            owner declaration name DocumentSymbolKind::Variable DocumentSymbol::new Option::Some return
        fi
        Option[DocumentSymbol]::None
    }

    fn find_symbol_identity
        self:$AnalyzedDocument
        element:$DocumentElement
    -> Option[DocumentSymbol] {
        element.op.value match
            OpValue::FnCall(name) => element.part name self.find_callable_symbol
            OpValue::FnPush(name) => element.part name self.find_callable_symbol
            OpValue::PushEnumVariant(variant) => element.part variant self.find_enum_variant_symbol
            OpValue::StructNew(casa_struct) => {
                Option[Function]::None
                casa_struct.location
                casa_struct.name
                DocumentSymbolKind::Struct
                DocumentSymbol::new Option::Some
            }
            OpValue::TypeCast(cast_type) => cast_type.match_base self.find_type_symbol
            OpValue::PushVar(name) => element.containing_function name self.find_variable_symbol
            OpValue::PushCapture(name) => element.containing_function name self.find_variable_symbol
            OpValue::AssignVar(name) => element.containing_function name self.find_variable_symbol
            OpValue::AssignInc(name) => element.containing_function name self.find_variable_symbol
            OpValue::AssignDec(name) => element.containing_function name self.find_variable_symbol
            _ => Option[DocumentSymbol]::None
        end
    }

    fn find_type_symbol self:$AnalyzedDocument name:$str -> Option[DocumentSymbol] {
        if name self.lookup_struct Option::Some(casa_struct) is then
            Option[Function]::None
            casa_struct.location
            casa_struct.name
            DocumentSymbolKind::Struct
            DocumentSymbol::new Option::Some return
        fi
        if name self.lookup_enum Option::Some(casa_enum) is then
            Option[Function]::None
            casa_enum.location
            casa_enum.name
            DocumentSymbolKind::Enum
            DocumentSymbol::new Option::Some return
        fi
        Option[DocumentSymbol]::None
    }

    fn find_symbol_identity_at
        self:$AnalyzedDocument
        position:$SourcePosition
    -> Option[DocumentSymbol] {
        if position self.find_function_at Option::Some(function) is then
            Option[Function]::None
            function.location
            function.name
            DocumentSymbolKind::Function
            DocumentSymbol::new Option::Some return
        fi
        if position self.find_declared_symbol_at Option::Some(symbol) is then
            symbol Option::Some return
        fi
        if position self.find_symbol_at Option::Some(element) is then
            element self.find_symbol_identity return
        fi
        Option[DocumentSymbol]::None
    }

    fn find_declared_symbol_at
        self:$AnalyzedDocument
        position:$SourcePosition
    -> Option[DocumentSymbol] {
        position self.file_path self.sources.convert_position_to_offset.unwrap = offset
        for struct_name in self.structs.keys.iter do
            struct_name self.structs.get.unwrap = casa_struct
            if offset self.file_path casa_struct.location.contains_offset then
                struct_name self.find_type_symbol return
            fi
        done
        for enum_name in self.enums.keys.iter do
            enum_name self.enums.get.unwrap = casa_enum
            if offset casa_enum self.find_declared_enum_symbol_at Option::Some(symbol) is then
                symbol Option::Some return
            fi
        done
        Option[DocumentSymbol]::None
    }

    fn find_declared_enum_symbol_at
        self:$AnalyzedDocument
        casa_enum:$CasaEnum
        offset:u64
    -> Option[DocumentSymbol] {
        if offset self.file_path casa_enum.location.contains_offset then
            casa_enum.name self.find_type_symbol return
        fi
        for variant_name in casa_enum.variants.iter do
            if variant_name casa_enum.variant_locations.get Option::Some(location) is then
                if offset self.file_path location.contains_offset then
                    Option[Function]::None
                    location
                    variant_name
                    DocumentSymbolKind::EnumVariant
                    DocumentSymbol::new Option::Some return
                fi
            fi
        done
        Option[DocumentSymbol]::None
    }

    fn collect_symbol_references
        self:$AnalyzedDocument
        symbol:$DocumentSymbol
        ops:$List[Op]
        function:$Option[Function]
        references:mut$List[DocumentLocation]
    {
        for op in ops.iter do
            if op.location.file self.sources.get Option::Some(op_source) is then
                if op op_source is_qualified_operation then
                    references op_source SymbolPart::TypeName op function symbol self.collect_element_reference
                    references op_source SymbolPart::MemberName op function symbol self.collect_element_reference
                else
                    references op_source SymbolPart::Whole op function symbol self.collect_element_reference
                fi
            fi
        done
    }

    fn collect_element_reference
        self:$AnalyzedDocument
        symbol:$DocumentSymbol
        function:$Option[Function]
        op:$Op
        part:$SymbolPart
        source:$str
        references:mut$List[DocumentLocation]
    {
        part op source get_symbol_location = location
        Option[Function]::None = containing_function
        if function Option::Some(value) is then value Option::Some = containing_function fi
        location.clone part containing_function op DocumentElement = element
        if element self.find_symbol_identity Option::Some(reference_symbol) is then
            if reference_symbol symbol.matches_identity then
                if symbol.name.length location.span.length < then
                    symbol.name.length
                    location.span.offset location.span.length + symbol.name.length -
                    location.file
                    Location::new = location
                fi
                location self.locate references.push
            fi
        fi
    }

    fn find_references_at
        self:$AnalyzedDocument
        position:$SourcePosition
        include_declaration:bool
    -> Option[List[DocumentLocation]] {
        if position self.find_symbol_identity_at Option::Some(symbol) is then
            List[DocumentLocation]::new = references
            if include_declaration symbol.has_declaration_reference && then
                symbol.declaration self.locate references.push
            fi
            references Option[Function]::None self.ops symbol self.collect_symbol_references
            for function_name in self.functions.keys.iter do
                function_name self.functions.get.unwrap = function
                references function Option::Some function.ops symbol self.collect_symbol_references
            done
            if 0 references.length != then references Option::Some return fi
        fi
        Option[List[DocumentLocation]]::None
    }

    fn find_function_at self:$AnalyzedDocument position:$SourcePosition -> Option[Function] {
        position self.file_path self.sources.convert_position_to_offset.unwrap = offset
        for function in self.collect_document_functions.iter do
            if
            function.name "lambda__" str::starts_with
            function.name "__" str::starts_with ||
            then
                continue
            fi
            if
            function.location.span.offset offset >=
            offset function.location.span.offset function.location.span.length + > &&
            then
                function Option::Some return
            fi
        done
        Option[Function]::None
    }

    fn find_containing_function self:$AnalyzedDocument offset:u64 -> Option[Function] {
        for function in self.collect_document_functions.iter do
            if 0 function.ops.length == then continue fi
            0 function.ops.get.location.span.offset = start_offset
            function.ops.length 1 - function.ops.get = last_op
            last_op.location.span.offset last_op.location.span.length + = end_offset
            if start_offset offset >= offset end_offset >= && then function Option::Some return fi
        done
        Option[Function]::None
    }

    fn lookup_function self:$AnalyzedDocument name:$str -> Option[Function] {
        name self.functions.get
    }

    fn lookup_struct self:$AnalyzedDocument name:$str -> Option[CasaStruct] {
        name self.structs.get
    }

    fn lookup_enum self:$AnalyzedDocument name:$str -> Option[CasaEnum] {
        name self.enums.get
    }

    fn find_variable_type
        self:$AnalyzedDocument
        name:$str
        function:Option[Function]
    -> Option[Type] {
        if function Option::Some(containing_function) is then
            for variable in containing_function.variables.iter do
                if variable.name name == variable.typ.is_unknown ! && then
                    variable.typ Option::Some return
                fi
            done
            for capture in containing_function.captures.iter do
                if capture.name name == capture.typ.is_unknown ! && then
                    capture.typ Option::Some return
                fi
            done
        fi
        if name self.variables.get Option::Some(variable) is then
            if variable.typ.is_unknown ! then variable.typ Option::Some return fi
        fi
        Option[Type]::None
    }

    fn find_symbol_type self:$AnalyzedDocument symbol:$DocumentElement -> Option[Type] {
        symbol.op.value match
            OpValue::PushVar(name) => symbol.containing_function name self.find_variable_type
            OpValue::PushCapture(name) => symbol.containing_function name self.find_variable_type
            OpValue::AssignVar(name) => symbol.containing_function name self.find_variable_type
            OpValue::PushInt(_) => {
                if symbol.op.type_hint Option::Some(literal_type) is then
                    literal_type Option::Some
                else
                    TYPE_I64_T Option::Some
                fi
            }
            OpValue::PushFloat(_) => {
                if symbol.op.type_hint Option::Some(literal_type) is then
                    literal_type Option::Some
                else
                    TYPE_F64_T Option::Some
                fi
            }
            OpValue::PushStr(_) => TYPE_STR_T Option::Some
            OpValue::PushBool(_) => TYPE_BOOL_T Option::Some
            OpValue::PushChar(_) => TYPE_CHAR_T Option::Some
            _ => Option[Type]::None
        end
    }

    fn format_type_hover self:$AnalyzedDocument name:$str -> Option[str] {
        if name self.lookup_struct Option::Some(casa_struct) is then
            casa_struct.format_hover Option::Some return
        fi
        if name self.lookup_enum Option::Some(casa_enum) is then
            casa_enum.format_hover Option::Some return
        fi
        Option[str]::None
    }

    fn format_hover self:$AnalyzedDocument symbol:$DocumentElement -> Option[str] {
        if symbol.part SymbolPart::Separator is then Option[str]::None return fi

        if symbol.part SymbolPart::TypeName is then
            if
            symbol.op.value OpValue::FnCall is
            symbol.op.value OpValue::FnPush is ||
            then
                symbol.op op_str_value "::" str::split = parts
                0 parts.get self.format_type_hover return
            fi
            if symbol.op.value OpValue::PushEnumVariant(variant) is then
                variant.enum_name self.format_type_hover return
            fi
            Option[str]::None return
        fi

        if
        symbol.op.value OpValue::FnCall is
        symbol.op.value OpValue::FnPush is ||
        then
            symbol.op op_str_value = name
            if name self.lookup_function Option::Some(function) is then
                function.format_hover Option::Some
            else
                Option[str]::None
            fi
            return
        fi

        if
        symbol.op.value OpValue::PushVar is
        symbol.op.value OpValue::PushCapture is ||
        then
            symbol.op op_str_value = name
            if symbol self.find_symbol_type Option::Some(variable_type) is then
                f"{name}: {variable_type.format}" Option::Some
            else
                name Option::Some
            fi
            return
        fi

        symbol.op.value match
            OpValue::StructNew(casa_struct) => casa_struct.format_hover Option::Some
            OpValue::PushEnumVariant(variant) => {
                f"{variant.enum_name}::{variant.variant_name}" Option::Some
            }
            OpValue::PushInt(value) => {
                if symbol.op.type_hint Option::Some(literal_type) is then
                    f"({literal_type.format}) {value.raw}" Option::Some
                else
                    f"(i64) {value.raw}" Option::Some
                fi
            }
            OpValue::PushFloat(value) => {
                if symbol.op.type_hint Option::Some(literal_type) is then
                    f"({literal_type.format}) {value}" Option::Some
                else
                    f"(f64) {value}" Option::Some
                fi
            }
            OpValue::PushStr(value) => f"(str) \"{value}\"" Option::Some
            OpValue::PushBool(value) => {
                if value 0 != then "(bool) true" else "(bool) false" fi Option::Some
            }
            OpValue::PushChar(value) => f"(char) '{value.to_str}'" Option::Some
            OpValue::AssignVar(name) => {
                if symbol self.find_symbol_type Option::Some(variable_type) is then
                    f"= {name}: {variable_type.format}" Option::Some
                else
                    f"= {name}" Option::Some
                fi
            }
            _ => symbol.op.value.format_hover
        end
    }

    fn find_enum_name_for_variant self:$AnalyzedDocument symbol:$DocumentSymbol -> Option[str] {
        for enum_name in self.enums.keys.iter do
            enum_name self.enums.get.unwrap = casa_enum
            if symbol.name casa_enum.variant_locations.get Option::Some(location) is then
                if location symbol.declaration.matches then enum_name Option::Some return fi
            fi
        done
        Option[str]::None
    }

    fn format_declaration_hover self:$AnalyzedDocument symbol:$DocumentSymbol -> Option[str] {
        symbol.kind match
            DocumentSymbolKind::Function => {
                if symbol.name self.lookup_function Option::Some(function) is then
                    function.format_hover Option::Some
                else
                    Option[str]::None
                fi
            }
            DocumentSymbolKind::Variable => Option[str]::None
            DocumentSymbolKind::Struct => {
                if symbol.name self.lookup_struct Option::Some(casa_struct) is then
                    casa_struct.format_hover Option::Some
                else
                    Option[str]::None
                fi
            }
            DocumentSymbolKind::Enum => {
                if symbol.name self.lookup_enum Option::Some(casa_enum) is then
                    casa_enum.format_hover Option::Some
                else
                    Option[str]::None
                fi
            }
            DocumentSymbolKind::EnumVariant => {
                if symbol self.find_enum_name_for_variant Option::Some(enum_name) is then
                    f"{enum_name}::{symbol.name}" Option::Some
                else
                    Option[str]::None
                fi
            }
        end
    }

    fn find_declaration_hover_at
        self:$AnalyzedDocument
        position:$SourcePosition
    -> Option[DocumentHover] {
        if position self.find_declared_symbol_at Option::Some(symbol) is then
            if symbol self.format_declaration_hover Option::Some(content) is then
                symbol.declaration self.locate content DocumentHover Option::Some return
            fi
        fi
        if position self.find_function_at Option::Some(function) is then
            function.location self.locate function.format_hover DocumentHover Option::Some return
        fi
        Option[DocumentHover]::None
    }

    fn find_hover_at self:$AnalyzedDocument position:$SourcePosition -> Option[DocumentHover] {
        if position self.find_declaration_hover_at Option::Some(hover) is then
            hover Option::Some return
        fi
        if position self.find_symbol_at Option::Some(symbol) is then
            if symbol self.format_hover Option::Some(content) is then
                symbol.location self.locate content DocumentHover Option::Some return
            fi
        fi
        Option[DocumentHover]::None
    }

    fn find_variable_definition
        self:$AnalyzedDocument
        name:$str
        function:Option[Function]
        usage_offset:u64
    -> Option[Location] {
        Option[Op]::None = best
        if function Option::Some(containing_function) is then
            best usage_offset containing_function.ops name find_best_assignment = best
        fi
        if best.is_none then best usage_offset self.ops name find_best_assignment = best fi
        if best Option::Some(definition_op) is then
            definition_op.location Option::Some
        else
            Option[Location]::None
        fi
    }

    fn find_type_definition self:$AnalyzedDocument name:$str -> Option[Location] {
        if name self.lookup_struct Option::Some(casa_struct) is then
            casa_struct.location Option::Some return
        fi
        if name self.lookup_enum Option::Some(casa_enum) is then
            casa_enum.location Option::Some return
        fi
        Option[Location]::None
    }

    fn find_callable_definition self:$AnalyzedDocument symbol:$DocumentElement -> Option[Location] {
        if symbol.part SymbolPart::TypeName is then
            symbol.op op_str_value "::" str::split = parts
            0 parts.get self.find_type_definition return
        fi
        if symbol.op op_str_value self.lookup_function Option::Some(function) is then
            if "" function.location.file != then function.location Option::Some return fi
        fi
        Option[Location]::None
    }

    fn find_enum_definition
        self:$AnalyzedDocument
        symbol:$DocumentElement
        variant:$EnumVariant
    -> Option[Location] {
        variant.enum_name self.lookup_enum = enum_result
        if enum_result Option::Some(casa_enum) is then
            if symbol.part SymbolPart::MemberName is then
                variant.variant_name casa_enum.variant_locations.get = variant_location
                if variant_location Option::Some(location) is then location Option::Some return fi
            fi
            casa_enum.location Option::Some return
        fi
        Option[Location]::None
    }

    fn find_definition self:$AnalyzedDocument symbol:$DocumentElement -> Option[Location] {
        if symbol.part SymbolPart::Separator is then
            Option[Location]::None return
        fi
        symbol.op.value match
            OpValue::FnCall(_) => symbol self.find_callable_definition
            OpValue::FnPush(_) => symbol self.find_callable_definition
            OpValue::PushVar(name) => {
                symbol.op.location.span.offset
                symbol.containing_function
                name
                self.find_variable_definition
            }
            OpValue::PushCapture(name) => {
                symbol.op.location.span.offset
                symbol.containing_function
                name
                self.find_variable_definition
            }
            OpValue::StructNew(casa_struct) => casa_struct.location Option::Some
            OpValue::PushEnumVariant(variant) => variant symbol self.find_enum_definition
            OpValue::TypeCast(cast_type) => cast_type.format self.find_type_definition
            _ => Option[Location]::None
        end
    }

    fn find_definition_at
        self:$AnalyzedDocument
        position:$SourcePosition
    -> Option[DocumentLocation] {
        if position self.find_symbol_at Option::Some(symbol) is then
            if symbol self.find_definition Option::Some(location) is then
                location self.locate Option::Some return
            fi
        fi
        Option[DocumentLocation]::None
    }

    fn locate self:$AnalyzedDocument location:$Location -> DocumentLocation {
        location.span.length location.span.offset location.file DocumentLocation
    }
}
