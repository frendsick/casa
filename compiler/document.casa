    pub fn find_references_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
        include_declaration:bool
    -> std::Option[std::List[DocumentLocation]] {
        if position self.query_offset std::Option::Some(offset) is then
            include_declaration offset copy self.file_path.as_str self.index.find_references match
                ReferenceAnswer::Complete(result) => result.into_ranges std::Option::Some return
                ReferenceAnswer::Incomplete(result _) => result.into_ranges std::Option::Some return
                _ => {
                }
            end
        fi
        std::Option[std::List[DocumentLocation]]::None
    }

    pub fn find_semantic_tokens self:$AnalyzedDocument -> std::List[DocumentToken] {
        self.file_path.as_str self.index.find_semantic_tokens match
            ListAnswer::Complete(items) => items
            ListAnswer::Incomplete(items _) => items
            ListAnswer::Unavailable(_) => std::List[DocumentToken]::new
        end
    }
}

struct CoverageRegion {
    location: DocumentLocation
    reason:   QueryReason
}

fn classify_query_failure failure:$error::CasaError -> QueryReason {
    if failure.message.as_str "not found, searched:" str::contains then
        QueryReason::UnresolvedDependency return
    fi
    if
        failure.kind common::ErrorKind::Syntax == failure.kind common::ErrorKind::UnexpectedToken == || failure.kind common::ErrorKind::UnmatchedBlock == ||
    then
        QueryReason::RejectedSyntax return
    fi
    QueryReason::MissingSemanticFact
}

impl IndexBuilder {
    fn find_verified_assignment
        self:$IndexBuilder
        name:$str
        ops:$std::List[ProjectionOperation]
    -> std::Option[common::Location] {
        for op in ops.iter do
            if op.verified ! then
                continue
            fi
            if op.value occurrences::Value::AssignVar(assigned) is then
                if assigned name == then
                    op.location.clone std::Option::Some return
                fi
            fi
        done
        std::Option[common::Location]::None
    }
}

impl EditorIndex {
    fn find_unavailable_reason self:$EditorIndex file:$str offset:u64 -> std::Option[QueryReason] {
        for region in self.unavailable.iter do
            if offset file region.location.contains then
                region.reason std::Option::Some return
            fi
            if region.location.file file != then
                continue
            fi
            if region.reason QueryReason::MissingSemanticFact != then
                if region.location.offset offset >= then
                    region.reason std::Option::Some return
                fi
            fi
        done
        std::Option[QueryReason]::None
    }

    fn find_file_coverage self:$EditorIndex file:$str -> std::Option[QueryReason] {
        for region in self.unavailable.iter do
            if region.location.file file == then
                region.reason std::Option::Some return
            fi
        done
        std::Option[QueryReason]::None
    }
}

impl CompletionCandidate {
    fn get_insertion_text self:$CompletionCandidate -> std::String {
        self match
            CompletionCandidate::Function(name) => name.clone
            CompletionCandidate::Variable(variable) => variable.name.clone
            CompletionCandidate::Keyword(keyword) => keyword.format_source.to_str
            CompletionCandidate::Intrinsic(intrinsic) => intrinsic.format_source.to_str
            CompletionCandidate::Struct(declaration) => declaration.name.clone
            CompletionCandidate::Enum(name) => name.clone
            CompletionCandidate::EnumVariant(name) => name.clone
            CompletionCandidate::Method(name) => name.as_str "::" str::split.pop
        end
    }
}

impl EditorIndex {
    fn find_replacement self:$EditorIndex file:$str offset:u64 -> DocumentLocation {
        for word in self.words.iter do
            if word.file file != then
                continue
            fi
            if word.offset offset >= word.offset word.length + offset <= && then
                word.clone return
            fi
        done
        0 offset file.to_str DocumentLocation
    }

    pub fn find_completions
        self:$EditorIndex
        file:$str
        offset:u64
        trigger:$str
    -> ListAnswer[DocumentCompletion] {
        std::List[CompletionCandidate]::new = candidates
        std::Option[QueryReason]::None = reason
        trigger offset file self.find_candidates match
            ListAnswer::Complete(items) => items = candidates
            ListAnswer::Incomplete(items missing) => {
                items = candidates
                missing std::Option::Some = reason
            }
            ListAnswer::Unavailable(missing) => missing ListAnswer[DocumentCompletion]::Unavailable return
        end
        offset file self.find_replacement = replacement
        std::List[DocumentCompletion]::new = result
        for candidate in candidates.iter do
            replacement.clone candidate.get_insertion_text candidate.clone DocumentCompletion result.push
        done
        if reason std::Option::Some(missing) is then
            missing result ListAnswer::Incomplete
        else
            result ListAnswer::Complete
        fi
    }
}

impl EditorIndex {
    fn find_reference_coverage
        self:$EditorIndex
        symbol:$DocumentSymbol
    -> std::Option[QueryReason] {
        # Signature and field type occurrences are not represented yet.
        if symbol.kind DocumentSymbolKind::Struct == symbol.kind DocumentSymbolKind::Enum == || then
            QueryReason::MissingSemanticFact std::Option::Some return
        fi
        if symbol.owner std::Option::Some(owner) is then
            for body in self.bodies.iter do
                if body.file owner.file != body.offset owner.span.offset != || then
                    continue
                fi
                body self.find_region_coverage return
            done
        fi
        self.coverage.clone
    }

    fn find_region_coverage self:$EditorIndex range:$DocumentLocation -> std::Option[QueryReason] {
        for region in self.unavailable.iter do
            if
                region.location.offset region
                    .location
                    .file
                    .as_str range.contains
            then
                region.reason std::Option::Some return
            fi
        done
        std::Option[QueryReason]::None
    }
}

impl AnalyzedDocument {
    pub fn find_completions_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
        trigger:$str
    -> ListAnswer[DocumentCompletion] {
        if position self.query_offset std::Option::Some(offset) is then
            trigger offset copy self.file_path.as_str self.index.find_completions return
        fi
        QueryReason::InvalidInput ListAnswer[DocumentCompletion]::Unavailable
    }

    pub fn find_reference_answer_at
        self:$AnalyzedDocument
        position:$common::SourcePosition
        include_declaration:bool
    -> ReferenceAnswer {
        if position self.query_offset std::Option::Some(offset) is then
            include_declaration offset copy self.file_path.as_str self.index.find_references return
        fi
        QueryReason::InvalidInput ReferenceAnswer::Unavailable
    }
}

impl EditorIndex {
    fn find_completion_coverage self:$EditorIndex file:$str offset:u64 -> std::Option[QueryReason] {
        for region in self.unavailable.iter do
            if region.location.file file == region.reason QueryReason::MissingSemanticFact != && then
                region.reason std::Option::Some return
            fi
        done
        offset file self.find_unavailable_reason
    }
}
