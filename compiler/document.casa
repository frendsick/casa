# Owned source facts. Neither the index nor any query answer contains compiler bodies.
pub enum QueryReason derives std::Copy std::Eq {
    InvalidInput
    RejectedSyntax
    UnresolvedDependency
    MissingSemanticFact
}

pub enum PointAnswer[T] {
    Known (T)
    Absent
    Unavailable (QueryReason)
}

pub enum ListAnswer[T] {
    Complete (std::List[T])
    Incomplete (std::List[T] QueryReason)
    Unavailable (QueryReason)
}

pub struct DocumentCompletion {
    pub candidate:      CompletionCandidate
    pub insertion_text: std::String
    pub replacement:    DocumentLocation
}

pub struct DocumentReferences {
    pub ranges:                    std::List[DocumentLocation]
    pub declaration:               DocumentLocation
    pub files:                     std::List[std::String]
    pub rename_requires_workspace: bool
}

impl DocumentReferences {
    pub fn into_ranges self:DocumentReferences -> std::List[DocumentLocation] {
        self match
            DocumentReferences { ranges: ranges } => ranges
        end
    }
}

pub enum ReferenceAnswer {
    Complete (DocumentReferences)
    Incomplete (DocumentReferences QueryReason)
    Unavailable (QueryReason)
}

pub struct DocumentSymbol derives std::Clone {
    pub kind:        DocumentSymbolKind
    pub name:        std::String
    pub declaration: common::Location
    pub owner:       std::Option[common::Location]
}

impl DocumentSymbol {
    pub fn matches_identity self:$DocumentSymbol other:$DocumentSymbol -> bool {
        self.kind other.kind == other.declaration self.declaration.matches &&
    }
}

struct Occurrence {
    location:         DocumentLocation
    hover:            std::Option[std::String]
    definition:       std::Option[DocumentLocation]
    symbol:           std::Option[DocumentSymbol]
    declaration:      bool
    reference_offset: u64
    reference_length: u64
}

struct CompletionScope {
    location: DocumentLocation
    items:    std::List[CompletionCandidate]
}

pub struct EditorIndex {
    files:       std::List[DocumentLocation]
    occurrences: std::List[Occurrence]
    tokens:      std::List[DocumentToken]
    completions: std::List[CompletionScope]
    scopes:      std::List[CompletionScope]
    triggers:    std::List[CompletionScope]
    coverage:    std::Option[QueryReason]
    unavailable: std::List[CoverageRegion]
    words:       std::List[DocumentLocation]
    bodies:      std::List[DocumentLocation]
}

pub struct AnalyzedDocument {
    index:         EditorIndex
    pub sources:   lexer::SourceStore
    pub source:    std::String
    pub file_path: std::String
}

impl DocumentLocation {
    pub fn contains self:$DocumentLocation file:$str offset:u64 -> bool {
        self.file file == self.offset offset >= && offset self.offset self.length + > &&
    }

    pub fn matches self:$DocumentLocation other:$DocumentLocation -> bool {
        self.file other.file == self.offset other.offset == && self.length other.length == &&
    }

    pub fn comes_before self:$DocumentLocation other:$DocumentLocation -> bool {
        if self.file other.file == then
            other.offset self.offset <
        else
            0 = index: u64
            while index self.file.length > index other.file.length > && do
                index self.file.at = first
                index other.file.at = second
                if first second != then
                    second first < return
                fi
                1 += index
            done
            other.file.length self.file.length <
        fi
    }
}

impl ProjectionSymbol {
    fn project self:$ProjectionSymbol -> DocumentSymbol {
        std::Option[common::Location]::None = owner
        if self.owner std::Option::Some(function) is then
            function.clone std::Option::Some = owner
        fi
        owner self.declaration.clone self.name.clone self.kind DocumentSymbol
    }
}

