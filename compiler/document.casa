# Semantic queries over one analyzed source document.
import "std" as std
import "common" as common
import "analysis" as analysis
import "lexer" as lexer
import "typechecker" as typechecker
import "semantics" as semantics
import "error" as error
import "occurrences" as occurrences

pub enum SymbolPart derives std::Eq std::Copy {
    Whole
    TypeName
    Separator
    MemberName
}

pub enum DocumentSymbolKind derives std::Eq std::Copy {
    Function
    Variable
    Struct
    Enum
    EnumVariant
}

# Facts needed while building the index. No ownership effects, substitutions, or executable bodies survive here.
struct ProjectionOperation {
    location:   common::Location
    value:      occurrences::Value
    type_hint:  std::Option[common::Type]
    token_kind: std::Option[DocumentTokenKind]
    hover:      std::Option[std::String]
    verified:   bool
}

impl ProjectionOperation {
    fn get_symbol_name self:$ProjectionOperation -> std::String {
        self.value match
            occurrences::Value::AssignDec(name) => name.clone
            occurrences::Value::AssignInc(name) => name.clone
            occurrences::Value::AssignVar(name) => name.clone
            occurrences::Value::FnCall(name) => name.clone
            occurrences::Value::FnPush(name) => name.clone
            occurrences::Value::PushCapture(name) => name.clone
            occurrences::Value::PushVar(name) => name.clone
            _ => std::String::new
        end
    }
}

fn project_body
    body:$semantics::AnalysisBody
    verified:$std::Set[i64]
-> std::List[ProjectionOperation] {
    std::List[ProjectionOperation]::new = occurrences
    body match
        semantics::AnalysisBody::Checked(checked) => {
            {
                = occurrence: $occurrences::Occurrence
                verified occurrences occurrence project_source_occurrence
            } = visitor
            visitor checked.visit_occurrences
        }
        semantics::AnalysisBody::RejectedChecked(checked) => {
            {
                = occurrence: $occurrences::Occurrence
                verified occurrences occurrence project_source_occurrence
            } = visitor
            visitor checked.visit_occurrences
        }
        semantics::AnalysisBody::Rejected(operations) => verified occurrences operations project_occurrences
        semantics::AnalysisBody::Source(source) => {
            source.lower_operations = operations
            verified occurrences operations project_occurrences
        }
    end
    occurrences
}

fn project_occurrences
    operations:$std::List[common::Op]
    occurrences:mut$std::List[ProjectionOperation]
    verified:$std::Set[i64]
{
    for operation in operations.iter do
        operation.value match
            common::OpValue::Unreachable(items) => {
                verified occurrences items project_occurrences
                continue
            }
            common::OpValue::ExprGroup(items) => verified occurrences items project_occurrences
            common::OpValue::PushArray(items) => verified occurrences items project_occurrences
            common::OpValue::MatchArm(arm) => verified occurrences arm.guard_ops project_occurrences
            _ => {
            }
        end
        verified occurrences operation project_occurrence
    done
}

impl occurrences::TokenKind {
    fn into_document_kind self:occurrences::TokenKind -> DocumentTokenKind {
        self match
            occurrences::TokenKind::Function => DocumentTokenKind::Function
            occurrences::TokenKind::Variable => DocumentTokenKind::Variable
            occurrences::TokenKind::String => DocumentTokenKind::String
            occurrences::TokenKind::Number => DocumentTokenKind::Number
            occurrences::TokenKind::Keyword => DocumentTokenKind::Keyword
            occurrences::TokenKind::Operator => DocumentTokenKind::Operator
            occurrences::TokenKind::Type => DocumentTokenKind::Type
            occurrences::TokenKind::EnumMember => DocumentTokenKind::EnumMember
            occurrences::TokenKind::Struct => DocumentTokenKind::Struct
            occurrences::TokenKind::Macro => DocumentTokenKind::Macro
        end
    }
}

fn project_occurrence
    operation:$common::Op
    output:mut$std::List[ProjectionOperation]
    verified:$std::Set[i64]
{
    verified output operation occurrences::from_operation project_source_occurrence
}

fn project_source_occurrence
    occurrence:$occurrences::Occurrence
    output:mut$std::List[ProjectionOperation]
    verified:$std::Set[i64]
{
    { = kind: occurrences::TokenKind kind.into_document_kind } occurrence
        .token_kind
        .clone
        .map = token_kind
    occurrence.identity verified.has occurrence.hover.clone token_kind occurrence.type_hint.clone
    occurrence.value.clone occurrence.location.clone ProjectionOperation output.push
}

struct IndexBuilder {
    lexical_tokens:    std::Map[std::String std::List[common::Token]]
    declarations:      std::List[common::Location]
    root_occurrences:  std::List[ProjectionOperation]
    body_occurrences:  std::Map[std::String std::List[ProjectionOperation]]
    empty_occurrences: std::List[ProjectionOperation]
    store:             common::SymbolStore
    diagnostics:       error::Diagnostics
    sources:           lexer::SourceStore
    source:            std::String
    file_path:         std::String
}

struct DocumentElement {
    pub op:                  $ProjectionOperation
    pub containing_function: std::Option[std::String]
    pub part:                SymbolPart
    pub location:            common::Location
}

pub struct DocumentLocation derives std::Clone {
    pub file:   std::String
    pub offset: u64
    pub length: u64
}

pub struct DocumentHover derives std::Clone {
    pub content:  std::String
    pub location: DocumentLocation
}

pub enum DocumentTokenKind derives std::Eq std::Copy {
    Function
    Variable
    String
    Number
    Keyword
    Operator
    Type
    EnumMember
    Struct
    Macro
}

pub struct DocumentToken derives std::Clone {
    pub kind:     DocumentTokenKind
    pub location: DocumentLocation
}

impl DocumentToken {
    pub fn comes_before self:$DocumentToken pivot:$DocumentToken -> bool {
        if pivot.location.offset self.location.offset == then
            self.kind DocumentTokenKind::Function == pivot.kind DocumentTokenKind::Function != &&
        else
            pivot.location.offset self.location.offset <
        fi
    }
}

pub enum CompletionCandidate derives std::Clone {
    Function (std::String)
    Variable (common::Variable)
    Keyword (common::KeywordKind)
    Intrinsic (common::IntrinsicKind)
    Struct (common::CasaStruct)
    Enum (std::String)
    EnumVariant (std::String)
    Method (std::String)
}

struct ProjectionSymbol {
    pub kind:        DocumentSymbolKind
    pub name:        std::String
    pub declaration: common::Location
    pub owner:       std::Option[common::Location]
}

impl common::Location {
    pub fn matches self:$common::Location other:$common::Location -> bool {
        self.file other.file ==
        self.span.offset other.span.offset == &&
        self.span.length other.span.length == &&
    }

    pub fn contains_offset self:$common::Location file_path:$str offset:u64 -> bool {
        if self.file file_path != then
            false return
        fi
        self.span.offset offset >=
        offset self.span.offset self.span.length + > &&
    }
}

impl ProjectionSymbol {
    pub fn new
        kind:DocumentSymbolKind
        name:$str
        declaration:$common::Location
        owner:std::Option[common::Location]
    -> ProjectionSymbol {
        owner declaration.clone name.to_str kind ProjectionSymbol
    }

    pub fn matches_identity self:$ProjectionSymbol other:$ProjectionSymbol -> bool {
        if self.kind other.kind != self.name other.name != || then
            false return
        fi
        if other.declaration self.declaration.matches ! then
            false return
        fi
        if self.owner std::Option::Some(self_owner) is then
            if other.owner std::Option::Some(other_owner) is then
                other_owner self_owner.matches return
            fi
            false return
        fi
        other.owner.is_none
    }

    pub fn has_declaration_reference self:$ProjectionSymbol -> bool {
        self.kind match
            DocumentSymbolKind::Function => true
            DocumentSymbolKind::Variable => false
            DocumentSymbolKind::Struct => true
            DocumentSymbolKind::Enum => true
            DocumentSymbolKind::EnumVariant => true
        end
    }
}

fn get_symbol_location source:$str op:$ProjectionOperation part:$SymbolPart -> common::Location {
    if part SymbolPart::Whole is then
        op.location.clone return
    fi
    op
        .location
        .span
        .offset = start
    op
        .location
        .span
        .length = length
    source start length str::substring.as_str "::" str::find = separator
    separator u64::try_from.unwrap = separator_index
    part copy match
        SymbolPart::TypeName => separator_index start op
            .location
            .file
            .clone common::Location::new
        SymbolPart::Separator => 2 start separator_index + op
            .location
            .file
            .clone common::Location::new
        SymbolPart::MemberName => {
            length separator_index - 2 -
            start separator_index + 2 +
            op
                .location
                .file
                .clone
            common::Location::new
        }
        SymbolPart::Whole => op.location.clone
    end
}

fn find_best_assignment
    name:$str
    ops:$std::List[ProjectionOperation]
    usage_offset:u64
    best:std::Option[common::Location]
-> std::Option[common::Location] {
    0 = op_index: u64
    while op_index ops.length > do
        op_index ops.get = op
        1 += op_index
        if op.value occurrences::Value::AssignVar(assign_name) is then
            if assign_name name != then
                continue
            fi
            if
                op
                    .location
                    .span
                    .offset usage_offset >
            then
                op.location.clone std::Option::Some = best
            elif best.is_none then
                op.location.clone std::Option::Some = best
            fi
        fi
    done
    best
}

pub fn extract_word_before source:$str offset:u64 -> std::String {
    offset = end_pos
    end_pos = start_pos
    while 0 start_pos != do
        1 -= start_pos
        start_pos source.at = character
        if character.is_alpha ! character.is_digit ! && character '_' != && then
            1 += start_pos
            break
        fi
    done
    source start_pos end_pos start_pos - str::substring
}
# Extract a qualified receiver and keep balanced generic type arguments.
pub fn extract_type_before source:$str offset:u64 -> std::String {
    offset = end_pos
    end_pos = start_pos
    0 = bracket_depth: u64
    while 0 start_pos != do
        1 -= start_pos
        start_pos source.at = character
        if ']' character == then
            1 += bracket_depth
        elif '[' character == then
            if 0 bracket_depth == then
                1 += start_pos
                break
            fi
            1 -= bracket_depth
        elif 0 bracket_depth != then
            continue
        elif
            character.is_alpha
            character.is_digit ||
            character '_' == ||
            character ':' == ||
            character '$' == || !
        then
            1 += start_pos
            break
        fi
    done
    if 0 bracket_depth != then
        std::String::new return
    fi
    source start_pos end_pos start_pos - str::substring
}

pub fn extract_chain_before source:$str offset:u64 -> std::List[std::String] {
    std::List[std::String]::new = reversed_parts
    offset = position
    while 0 position > do
        position source extract_word_before = word
        if 0 word.length == then
            break
        fi
        word.length = word_length
        word reversed_parts.push
        word_length position swap - = position
        if 0 position > then
            if '.' position 1 - source.at == then
                1 -= position
            else
                break
            fi
        fi
    done

    std::List[std::String]::new = parts
    reversed_parts.length = reverse_index
    while 0 reverse_index != do
        1 -= reverse_index
        reverse_index reversed_parts.get.clone parts.push
    done
    parts
}

pub fn infer_literal_type text:$str -> std::Option[common::Type] {
    if 0 text.length == then
        std::Option[common::Type]::None return
    fi
    true = all_digits
    for character in text.iter do
        if character.is_digit ! then
            false = all_digits
            break
        fi
    done
    if all_digits then
        common::make_i64_type.clone std::Option::Some return
    fi
    if text lexer::is_float_literal then
        common::make_f64_type.clone std::Option::Some return
    fi
    if text "true" == text "false" == || then
        common::make_bool_type.clone std::Option::Some return
    fi
    std::Option[common::Type]::None
}

fn is_qualified_operation source:$str op:$ProjectionOperation -> bool {
    if
        0 op
            .location
            .span
            .length ==
    then
        false return
    fi
    source op
        .location
        .span
        .offset op
        .location
        .span
        .length str::substring.as_str "::" str::contains
}

fn classify_qualified_member op_value:$occurrences::Value -> DocumentTokenKind {
    if op_value occurrences::Value::PushEnumVariant is then
        DocumentTokenKind::EnumMember
    else
        DocumentTokenKind::Function
    fi
}

pub fn find_keyword_before
    source:$str
    file_path:$str
    name_offset:u64
    keyword:$str
-> std::Option[common::Location] {
    name_offset = position
    while 0 position != do
        1 -= position
        position source.at = character
        if ' ' character != '\t' character != && '\n' character != && then
            break
        fi
    done
    if keyword.length position 1 + >= then
        position 1 + keyword.length - = keyword_start
        if source keyword_start keyword.length str::substring keyword == then
            keyword.length keyword_start file_path.to_str common::Location::new std::Option::Some return
        fi
    fi
    std::Option[common::Location]::None
}

impl common::Function {
    pub fn format_hover self:$common::Function store:$common::SymbolStore file:$str -> std::String {
        std::String::new = builder
        if self.is_unsafe then
            "unsafe " builder.append
        fi
        "fn " builder.append
        file self.name.as_str store.format_name_for_source.as_str builder.append
        if
            0 self
                .stack_effect
                .parameters
                .length !=
        then
            " " builder.append
            std::List[std::String]::new = parameters
            for
                parameter in self
                    .stack_effect
                    .parameters
                    .iter
            do
                if "" parameter.name != then
                    f"{parameter.name}:{file parameter.typ store.format_type_for_source}"
                else
                    file parameter.typ store.format_type_for_source
                fi
                parameters.push
            done
            " " parameters.join_strings.as_str builder.append
        fi
        " -> " builder.append
        if
            0 self
                .stack_effect
                .return_types
                .length !=
        then
            std::List[std::String]::new = return_types
            for
                return_type in self
                    .stack_effect
                    .return_types
                    .iter
            do
                file return_type store.format_type_for_source return_types.push
            done
            " " return_types.join_strings.as_str builder.append
        else
            "None" builder.append
        fi
        builder
    }
}

impl common::CasaEnum {
    pub fn format_hover self:$common::CasaEnum -> std::String {
        std::String::new = builder
        "enum " builder.append
        self.name.as_str builder.append
        " { " builder.append
        ", " self
            .variants
            .join_strings
            .as_str builder.append
        " }" builder.append
        builder
    }
}

impl IndexBuilder {
    fn project_failures self:$IndexBuilder index:mut$EditorIndex {
        for
            diagnostic in self
                .diagnostics
                .entries
                .iter
        do
            if diagnostic error::Diagnostic::Error(failure) is then
                failure classify_query_failure failure.location self.locate CoverageRegion index.unavailable.push
            fi
        done
    }

    pub fn new
        analysis:analysis::AnalysisResult
        source:std::String
        file_path:std::String
    -> IndexBuilder {
        analysis.into_parts = typechecked = sources = diagnostics
        std::List[ProjectionOperation]::new = root_occurrences
        std::Map[std::String std::List[ProjectionOperation]]::new = body_occurrences
        common::symbol_store_new = store
        if typechecked std::Option::Some(result) is then
            result.into_analysis_parts = verified = bodies = root = checked_store
            verified root project_body = root_occurrences
            for entry in bodies.iter do
                verified entry.second project_body entry.first.clone body_occurrences.set
            done
            checked_store = store
        fi
        file_path source sources diagnostics store std::List[ProjectionOperation]::new body_occurrences root_occurrences
        std::List[common::Location]::new std::Map[std::String std::List[common::Token]]::new IndexBuilder
    }

    fn get_function_occurrences self:$IndexBuilder name:$str -> $std::List[ProjectionOperation] {
        if name self.body_occurrences.get_str std::Option::Some(occurrences) is then
            occurrences return
        fi
        self.empty_occurrences
    }

    pub fn collect_document_functions self:$IndexBuilder -> std::List[std::String] {
        std::List[std::String]::new = functions
        for
            function_name in self
                .store
                .get_source_function_names
                .iter
        do
            if
                function_name self
                    .store
                    .source_functions
                    .has
            then
                continue
            fi
            function_name.as_str self
                .store
                .get_function
                .unwrap = function
            if "" function.location.file == then
                continue
            fi
            if function.location.file self.file_path != then
                continue
            fi
            function.name.clone functions.push
        done
        functions
    }

    pub fn collect_operation_tokens
        self:$IndexBuilder
        ops:$std::List[ProjectionOperation]
        tokens:mut$std::List[DocumentToken]
    {
        for op in ops.iter do
            if op.verified ! then
                continue
            fi
            if
                op.location.file self.file_path != 0 op
                    .location
                    .span
                    .length <= ||
            then
                continue
            fi
            if op.token_kind.clone std::Option::Some(kind) is then
                if
                    op.value occurrences::Value::FnCall is
                    op.value occurrences::Value::FnPush is ||
                    op.value occurrences::Value::PushEnumVariant is ||
                    op self.source.as_str is_qualified_operation &&
                then
                    SymbolPart::TypeName op self.source.as_str get_symbol_location self.locate
                    DocumentTokenKind::Type DocumentToken tokens.push
                    SymbolPart::MemberName op self.source.as_str get_symbol_location self.locate
                    op.value classify_qualified_member
                    DocumentToken tokens.push
                else
                    op.location self.locate kind copy DocumentToken tokens.push
                fi
            fi
        done
    }

    pub fn collect_declaration_token
        self:$IndexBuilder
        location:$common::Location
        keyword:$str
        kind:DocumentTokenKind
        tokens:mut$std::List[DocumentToken]
    {
        if location.file self.file_path != 0 location.span.length <= || then
            return
        fi
        location self.locate kind DocumentToken tokens.push
        if
            keyword location.span.offset self.file_path.as_str self.source.as_str find_keyword_before std::Option::Some(keyword_location) is
        then
            keyword_location self.locate DocumentTokenKind::Keyword DocumentToken tokens.push
        fi
    }

    pub fn find_semantic_tokens self:$IndexBuilder -> std::List[DocumentToken] {
        std::List[DocumentToken]::new = tokens
        tokens self.root_occurrences self.collect_operation_tokens
        for function_name in self.collect_document_functions.iter do
            function_name.as_str self.lookup_function.unwrap = function
            tokens function.name.as_str self.get_function_occurrences self.collect_operation_tokens
            if function self.has_source_declaration then
                tokens DocumentTokenKind::Function "fn" function.location self.collect_declaration_token
                if function.is_unsafe then
                    if
                        "unsafe" function
                            .location
                            .span
                            .offset self.file_path.as_str self.source.as_str
                        find_keyword_before std::Option::Some(unsafe_location) is
                    then
                        unsafe_location self.locate DocumentTokenKind::Keyword DocumentToken tokens.push
                    fi
                fi
            fi
        done
        for
            enum_name in self
                .store
                .enums
                .keys
                .iter
        do
            enum_name self
                .store
                .enums
                .get
                .unwrap = casa_enum
            tokens DocumentTokenKind::Type "enum" casa_enum.location self.collect_declaration_token
        done
        for
            struct_name in self
                .store
                .structs
                .keys
                .iter
        do
            struct_name self
                .store
                .structs
                .get
                .unwrap = casa_struct
            tokens DocumentTokenKind::Struct "struct" casa_struct.location self.collect_declaration_token
        done
        &DocumentToken::comes_before tokens.sort_by
        tokens
    }

    pub fn find_completion_candidates
        self:$IndexBuilder
        position:$common::SourcePosition
        trigger:$str
    -> std::List[CompletionCandidate] {
        position self.file_path.as_str self
            .sources
            .convert_position_to_offset
            .unwrap = cursor_offset
        if trigger "." == trigger ":" == || then
            cursor_offset self.find_triggered_completion_candidates return
        fi

        std::List[CompletionCandidate]::new = candidates
        for
            function_name in self
                .store
                .get_source_function_names
                .iter
        do
            if
                function_name self
                    .store
                    .source_functions
                    .has
            then
                continue
            fi
            if self.file_path.as_str function_name.as_str self.store.is_private_from then
                continue
            fi
            self.file_path.as_str function_name.as_str self.store.format_name_for_source = source_name
            if
                source_name.as_str "lambda__" str::starts_with
                source_name.as_str "__" str::starts_with ||
                source_name.as_str "::" str::contains ||
            then
                continue
            fi
            source_name CompletionCandidate::Function candidates.push
        done

        for
            struct_name in self
                .store
                .structs
                .keys
                .iter
        do
            if self.file_path.as_str struct_name.as_str self.store.is_private_from then
                continue
            fi
            self.file_path.as_str struct_name.as_str self.store.format_name_for_source = source_name
            if source_name.as_str "__" str::starts_with then
                continue
            fi
            struct_name self
                .store
                .structs
                .get
                .unwrap
                .clone = declaration
            source_name = declaration.name
            declaration CompletionCandidate::Struct candidates.push
        done

        for
            enum_name in self
                .store
                .enums
                .keys
                .iter
        do
            if self.file_path.as_str enum_name.as_str self.store.is_private_from then
                continue
            fi
            self.file_path.as_str enum_name.as_str self.store.format_name_for_source = source_name
            if source_name.as_str "__" str::starts_with then
                continue
            fi
            source_name CompletionCandidate::Enum candidates.push
        done

        [
            common::KeywordKind::Pub,
            common::KeywordKind::As,
            common::KeywordKind::Unsafe,
            common::KeywordKind::Fn,
            common::KeywordKind::Impl,
            common::KeywordKind::Return,
            common::KeywordKind::While,
            common::KeywordKind::Do,
            common::KeywordKind::Break,
            common::KeywordKind::Continue,
            common::KeywordKind::Done,
            common::KeywordKind::If,
            common::KeywordKind::Then,
            common::KeywordKind::Elif,
            common::KeywordKind::Else,
            common::KeywordKind::Fi,
            common::KeywordKind::EnumKw,
            common::KeywordKind::StructKw,
            common::KeywordKind::TraitKw,
            common::KeywordKind::End,
            common::KeywordKind::Match,
            common::KeywordKind::Is,
            common::KeywordKind::Import,
            common::KeywordKind::For,
            common::KeywordKind::In,
            common::KeywordKind::Const,
            common::KeywordKind::Move,
        ] = keywords
        for keyword in keywords.iter do
            keyword copy CompletionCandidate::Keyword candidates.push
        done

        [
            common::IntrinsicKind::Drop,
            common::IntrinsicKind::Dup,
            common::IntrinsicKind::Copy,
            common::IntrinsicKind::Over,
            common::IntrinsicKind::Rot,
            common::IntrinsicKind::Swap,
            common::IntrinsicKind::Alloc,
            common::IntrinsicKind::Free,
            common::IntrinsicKind::Load8,
            common::IntrinsicKind::Load16,
            common::IntrinsicKind::Load32,
            common::IntrinsicKind::Load64,
            common::IntrinsicKind::Store8,
            common::IntrinsicKind::Store16,
            common::IntrinsicKind::Store32,
            common::IntrinsicKind::Store64,
            common::IntrinsicKind::Print,
            common::IntrinsicKind::Panic,
            common::IntrinsicKind::Typeof,
            common::IntrinsicKind::SizeOf,
            common::IntrinsicKind::Exec,
            common::IntrinsicKind::Syscall0,
            common::IntrinsicKind::Syscall1,
            common::IntrinsicKind::Syscall2,
            common::IntrinsicKind::Syscall3,
            common::IntrinsicKind::Syscall4,
            common::IntrinsicKind::Syscall5,
            common::IntrinsicKind::Syscall6,
            common::IntrinsicKind::Argc,
            common::IntrinsicKind::Argv,
            common::IntrinsicKind::Envp,
        ] = intrinsics
        for intrinsic in intrinsics.iter do
            intrinsic copy CompletionCandidate::Intrinsic candidates.push
        done
        candidates
    }

    fn accepts_receiver
        self:$IndexBuilder
        function:$common::Function
        receiver:$common::Type
    -> bool {
        function.stack_effect semantics::method_receiver_type = expected
        if expected.is_none then
            false return
        fi
        receiver semantics::type_capability = capability
        expected.unwrap capability semantics::capability_matches_receiver
    }

    pub fn find_methods_for_type
        self:$IndexBuilder
        receiver_type:$common::Type
        require_receiver:bool
    -> std::List[CompletionCandidate] {
        receiver_type.clone receiver_type.borrow_target.unwrap_or = target
        f"{target.format}::" = exact_prefix
        f"{target.match_base}::" = base_prefix
        std::List[CompletionCandidate]::new = candidates
        std::Set[std::String]::new = method_names
        for
