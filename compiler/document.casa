    fn project self:IndexBuilder coverage:std::Option[QueryReason] -> AnalyzedDocument {
        EditorIndex {
            files: std::List[DocumentLocation]::new
            occurrences: std::List[Occurrence]::new
            tokens: std::List[DocumentToken]::new
            completions: std::List[CompletionScope]::new
            scopes: std::List[CompletionScope]::new
            triggers: std::List[CompletionScope]::new
            coverage: coverage
            unavailable: std::List[CoverageRegion]::new
            words: std::List[DocumentLocation]::new
            bodies: std::List[DocumentLocation]::new
        } = index
        index self.project_failures
        for
            file in self
                .sources
                .sources
                .keys
                .iter
        do
            file.clone = self.file_path
            file self
                .sources
                .sources
                .get
                .unwrap
                .clone = self.source
            self.source.length 1 + 0 file.clone DocumentLocation = file_range
            file_range.clone index.files.push
            "" 1 1 common::SourcePosition self.find_completion_candidates file_range
            CompletionScope index.completions.push
            self.file_path.as_str self.source.as_str lexer::lex_source.into_parts = lexical_diagnostics = lexical_tokens
            lexical_tokens self.collect_source_declarations
            self.find_semantic_tokens index.tokens.append
            for token in lexical_tokens.iter do
                index token self.project_lexical_token
            done
            lexical_tokens file.clone self.lexical_tokens.set
            0 = offset: u64
            while offset self.source.length > do
                if '.' offset self.source.at == ':' offset self.source.at == || then
                    offset 1 + self.find_triggered_completion_candidates
                    1 offset 1 + self.file_path.clone DocumentLocation CompletionScope index.triggers.push
                fi
                1 += offset
            done
        done
        index self.project_facts
        index self.project_global_variables
        # Move the retained text and index. The temporary compiler maps are destroyed here.
        self match
            IndexBuilder { sources: sources source: source file_path: file_path } => file_path source sources index AnalyzedDocument
        end
    }
}

impl EditorIndex {
    fn contains self:$EditorIndex file:$str offset:u64 -> bool {
        for range in self.files.iter do
            if offset file range.contains then
                true return
            fi
        done
        false
    }

    fn find_occurrence self:$EditorIndex file:$str offset:u64 -> std::Option[u64] {
        std::Option[u64]::None = best
        0 = index: u64
        while index self.occurrences.length > do
            index self.occurrences.get = occurrence
            index = current
            1 += index
            if offset file occurrence.location.contains ! then
                continue
            fi
            if best std::Option::Some(previous) is then
                previous copy self.occurrences.get = previous_occurrence
                if previous_occurrence.declaration then
                    continue
                fi
                if
                    occurrence.declaration ! previous_occurrence.location.length occurrence.location.length >= &&
                then
                    continue
                fi
            fi
            current std::Option::Some = best
        done
        best
    }

    pub fn find_hover self:$EditorIndex file:$str offset:u64 -> PointAnswer[DocumentHover] {
        if offset file self.contains ! then
            QueryReason::InvalidInput PointAnswer[DocumentHover]::Unavailable return
        fi
        if offset file self.find_occurrence std::Option::Some(index) is then
            index copy self.occurrences.get = occurrence
            if occurrence.hover std::Option::Some(content) is then
                occurrence.location.clone content.clone DocumentHover PointAnswer::Known return
            fi
            PointAnswer[DocumentHover]::Absent return
        fi
        if offset file self.find_unavailable_reason std::Option::Some(reason) is then
            reason copy PointAnswer[DocumentHover]::Unavailable
        else
            PointAnswer[DocumentHover]::Absent
        fi
    }

    pub fn find_definition self:$EditorIndex file:$str offset:u64 -> PointAnswer[DocumentLocation] {
        if offset file self.contains ! then
            QueryReason::InvalidInput PointAnswer[DocumentLocation]::Unavailable return
        fi
        if offset file self.find_occurrence std::Option::Some(index) is then
            index copy self.occurrences.get = occurrence
            if occurrence.definition std::Option::Some(location) is then
                location.clone PointAnswer::Known return
            fi
            PointAnswer[DocumentLocation]::Absent return
        fi
        if offset file self.find_unavailable_reason std::Option::Some(reason) is then
            reason copy PointAnswer[DocumentLocation]::Unavailable
        else
            PointAnswer[DocumentLocation]::Absent
        fi
    }

    fn find_candidates
        self:$EditorIndex
        file:$str
        offset:u64
        trigger:$str
    -> ListAnswer[CompletionCandidate] {
        if offset file self.contains ! then
            QueryReason::InvalidInput ListAnswer[CompletionCandidate]::Unavailable return
        fi
        std::List[CompletionCandidate]::new = items
        if trigger "." == trigger ":" == || then
            for scope in self.triggers.iter do
                if offset file scope.location.contains then
                    scope.items.clone = items
                    break
                fi
            done
        else
            for scope in self.completions.iter do
                if offset file scope.location.contains then
                    scope.items.clone items.append
                fi
            done
            for scope in self.scopes.iter do
                if offset file scope.location.contains then
                    scope.items.clone items.append
                fi
            done
        fi
        if offset file self.find_completion_coverage std::Option::Some(reason) is then
            reason copy items ListAnswer::Incomplete
        else
            items ListAnswer::Complete
        fi
    }

    pub fn find_references
        self:$EditorIndex
