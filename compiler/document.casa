            common::TokenKind::Keyword => DocumentTokenKind::Keyword
            common::TokenKind::Operator => DocumentTokenKind::Operator
            common::TokenKind::Intrinsic => DocumentTokenKind::Macro
            common::TokenKind::FstringText => DocumentTokenKind::String
