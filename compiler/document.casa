            fi
            if symbol.op.value occurrences::Value::PushEnumVariant(variant) is then
                variant.enum_name.as_str self.format_type_hover return
            fi
            std::Option[std::String]::None return
        fi

        if
            symbol.op.value occurrences::Value::FnCall is
            symbol.op.value occurrences::Value::FnPush is ||
        then
            symbol.op.get_symbol_name = name
            if name.as_str self.lookup_function std::Option::Some(function) is then
                symbol
                    .location
                    .file
                    .as_str function self.format_function_hover std::Option::Some
            else
                std::Option[std::String]::None
            fi
            return
        fi

        if
            symbol.op.value occurrences::Value::PushVar is
            symbol.op.value occurrences::Value::PushCapture is ||
        then
            symbol.op.get_symbol_name = name
            if symbol self.find_symbol_type std::Option::Some(variable_type) is then
                f"{name}: {variable_type.format}" std::Option::Some
            else
                name.clone std::Option::Some
            fi
            return
        fi

        symbol.op.value match
            occurrences::Value::StructNew(casa_struct) => casa_struct.hover.clone std::Option::Some
            occurrences::Value::PushEnumVariant(variant) => {
                f"{variant.enum_name}::{variant.variant_name}" std::Option::Some
            }
            occurrences::Value::AssignVar(name) => {
                if symbol self.find_symbol_type std::Option::Some(variable_type) is then
                    f"= {name}: {variable_type.format}" std::Option::Some
                else
                    f"= {name}" std::Option::Some
                fi
            }
            _ => symbol
                .op
                .hover
                .clone
        end
    }

