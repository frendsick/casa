# Semantic queries over one analyzed source document.
import "std"
import "analysis"

enum SymbolPart derives Copy {
    Whole
    TypeName
    Separator
    MemberName
}

enum DocumentSymbolKind derives Copy {
    Function
    Variable
    Struct
    Enum
    EnumVariant
}

struct AnalyzedDocument {
    ops:       List[Op]
    functions: Map[String Function]
    structs:   Map[String CasaStruct]
    enums:     Map[String CasaEnum]
    variables: Map[String Variable]
    sources:   SourceStore
    source:    String
    file_path: String
}

struct DocumentElement {
    op:                  Op
    containing_function: Option[Function]
    part:                SymbolPart
    location:            Location
}

struct DocumentLocation {
    file:   String
    offset: u64
    length: u64
}

struct DocumentHover {
    content:  String
    location: DocumentLocation
}

enum DocumentTokenKind derives Copy {
    Function
    Variable
    String
    Number
    Keyword
    Operator
    Type
    EnumMember
    Struct
    Macro
}

struct DocumentToken {
    kind:     DocumentTokenKind
    location: DocumentLocation
}

impl DocumentToken {
    fn comes_before self:$DocumentToken pivot:$DocumentToken -> bool {
        pivot.location.offset self.location.offset <
    }
}

enum CompletionCandidate {
    Function (String)
    Variable (Variable)
    Keyword (KeywordKind)
    Intrinsic (IntrinsicKind)
    Struct (CasaStruct)
    Enum (String)
    EnumVariant (String)
    Method (String)
}

struct DocumentSymbol {
    kind:        DocumentSymbolKind
    name:        String
    declaration: Location
    owner:       Option[Function]
}

struct FindSymbolState {
    best:        Option[DocumentElement]
    best_length: u64
}

impl Location {
    fn matches self:$Location other:$Location -> bool {
        self.file other.file ==
        self.span.offset other.span.offset == &&
        self.span.length other.span.length == &&
    }

    fn contains_offset self:$Location file_path:$str offset:u64 -> bool {
        if self.file file_path != then
            false return
        fi
        self.span.offset offset >=
        offset self.span.offset self.span.length + > &&
    }
}

impl DocumentSymbol {
    fn new
        kind:DocumentSymbolKind
        name:$str
        declaration:$Location
        owner:Option[Function]
    -> DocumentSymbol {
        owner declaration.clone name.to_str kind DocumentSymbol
    }

    fn matches_identity self:$DocumentSymbol other:$DocumentSymbol -> bool {
        if self.kind other.kind != self.name other.name != || then
            false return
        fi
        if other.declaration self.declaration.matches ! then
            false return
        fi
        if self.owner Option::Some(self_owner) is then
            if other.owner Option::Some(other_owner) is then
                other_owner.location self_owner.location.matches return
            fi
            false return
        fi
        other.owner.is_none
    }

    fn has_declaration_reference self:$DocumentSymbol -> bool {
        self.kind match
            DocumentSymbolKind::Function => true
            DocumentSymbolKind::Variable => false
            DocumentSymbolKind::Struct => true
            DocumentSymbolKind::Enum => true
            DocumentSymbolKind::EnumVariant => true
        end
    }
}

fn find_qualified_part source:$str op:$Op cursor_offset:u64 -> SymbolPart {
    op
        .location
        .span
        .offset = start
    op
        .location
        .span
        .length = length
    source start length str::substring.as_str "::" str::find = separator
    if 0 separator < then
        SymbolPart::Whole return
    fi
    separator (u64) = separator_index
    cursor_offset start - = relative_offset
    if relative_offset separator_index > then
        SymbolPart::TypeName
    elif relative_offset separator_index 2 + > then
        SymbolPart::Separator
    else
        SymbolPart::MemberName
    fi
}

fn get_symbol_location source:$str op:$Op part:$SymbolPart -> Location {
    op
        .location
        .span
        .offset = start
    op
        .location
        .span
        .length = length
    source start length str::substring.as_str "::" str::find = separator
    separator (u64) = separator_index
    part copy match
        SymbolPart::TypeName => separator_index start op
            .location
            .file
            .clone Location::new
        SymbolPart::Separator => 2 start separator_index + op
            .location
            .file
            .clone Location::new
        SymbolPart::MemberName => {
            length separator_index - 2 -
            start separator_index + 2 +
            op
                .location
                .file
                .clone
            Location::new
        }
        SymbolPart::Whole => op.location.clone
    end
}

fn find_best_spanning_symbol
    ops:$List[Op]
    file_path:$str
    source:$str
    offset:u64
    function:$Option[Function]
    find_state:FindSymbolState
-> FindSymbolState {
    for op in ops.iter do
        if op.location.file file_path != then
            continue
        fi
        op
            .location
            .span
            .offset = span_offset
        op
            .location
            .span
            .length = span_length
        if 1 span_length < then
            1 (u64) = span_length
        fi
        if
            span_offset offset >=
            offset span_offset span_length + > &&
            find_state.best.is_none span_length find_state.best_length > || &&
        then
            offset op source find_qualified_part = part
            part op source get_symbol_location = location
            span_length
            location
            part
            Option[Function]::None = containing_function
            if function Option::Some(value) is then
                value.clone_for_import Option::Some = containing_function
            fi
            containing_function
            op.clone
            DocumentElement Option::Some FindSymbolState = find_state
        fi
    done
    find_state
}

fn find_best_assignment name:$str ops:$List[Op] usage_offset:u64 best:Option[Op] -> Option[Op] {
    0 (u64) = op_index
    while op_index ops.length > do
        op_index ops.get = op
        1 += op_index
        if op.value OpValue::AssignVar(assign_name) is then
            if assign_name name != then
                continue
            fi
            if
                op
                    .location
                    .span
                    .offset usage_offset >
            then
                op.clone Option::Some = best
            elif best.is_none then
                op.clone Option::Some = best
            fi
        fi
    done
    best
}

fn extract_word_before source:$str offset:u64 -> String {
    offset = end_pos
    end_pos = start_pos
    while 0 start_pos != do
        1 -= start_pos
        start_pos source.at = character
        if character.is_alpha ! character.is_digit ! && character '_' != && then
            1 += start_pos
            break
        fi
    done
    source start_pos end_pos start_pos - str::substring
}

fn extract_chain_before source:$str offset:u64 -> List[String] {
    List[String]::new = reversed_parts
    offset = position
    while 0 position > do
        position source extract_word_before = word
        if 0 word.length == then
            break
        fi
        word.length = word_length
        word reversed_parts.push
        word_length position swap - = position
        if 0 position > then
            if '.' position 1 - source.at == then
                1 -= position
            else
                break
            fi
        fi
    done

    List[String]::new = parts
    reversed_parts.length = reverse_index
    while 0 reverse_index != do
        1 -= reverse_index
        reverse_index reversed_parts.get.clone parts.push
    done
    parts
}

fn infer_literal_type text:$str -> Option[Type] {
    if 0 text.length == then
        Option[Type]::None return
    fi
    true = all_digits
    for character in text.iter do
        if character.is_digit ! then
            false = all_digits
            break
        fi
    done
    if all_digits then
        TYPE_I64_T clone_type Option::Some return
    fi
    if text is_float_literal then
        TYPE_F64_T clone_type Option::Some return
    fi
    if text "true" == text "false" == || then
        TYPE_BOOL_T clone_type Option::Some return
    fi
    Option[Type]::None
}

fn find_first_assignment name:$str ops:$List[Op] -> Option[Location] {
    for op in ops.iter do
        if op.value OpValue::AssignVar(assign_name) is then
            if assign_name name == then
                op.location.clone Option::Some return
            fi
        fi
    done
    Option[Location]::None
}

fn is_qualified_operation source:$str op:$Op -> bool {
    if
        0 op
            .location
            .span
            .length ==
    then
        false return
    fi
    source op
        .location
        .span
        .offset op
        .location
        .span
        .length str::substring.as_str "::" str::contains
}

fn find_document_token_kind op_value:$OpValue -> Option[DocumentTokenKind] {
    op_value match
        OpValue::FnCall(_) => DocumentTokenKind::Function Option::Some
        OpValue::FnPush(_) => DocumentTokenKind::Function Option::Some
        OpValue::MethodCall(_) => DocumentTokenKind::Function Option::Some
        OpValue::TraitMethodCall(_) => DocumentTokenKind::Function Option::Some
        OpValue::TraitMethodRef(_) => DocumentTokenKind::Function Option::Some
        OpValue::PushVar(_) => DocumentTokenKind::Variable Option::Some
        OpValue::PushCapture(_) => DocumentTokenKind::Variable Option::Some
        OpValue::AssignVar(_) => DocumentTokenKind::Variable Option::Some
        OpValue::AssignInc(_) => DocumentTokenKind::Variable Option::Some
        OpValue::AssignDec(_) => DocumentTokenKind::Variable Option::Some
        OpValue::PushStr(_) => DocumentTokenKind::String Option::Some
        OpValue::PushInt(_) => DocumentTokenKind::Number Option::Some
        OpValue::PushFloat(_) => DocumentTokenKind::Number Option::Some
        OpValue::PushChar(_) => DocumentTokenKind::Number Option::Some
        OpValue::PushBool(_) => DocumentTokenKind::Keyword Option::Some
        OpValue::FnExec => DocumentTokenKind::Keyword Option::Some
        OpValue::FnExecOwned => DocumentTokenKind::Keyword Option::Some
        OpValue::IfStart => DocumentTokenKind::Keyword Option::Some
        OpValue::IfCondition => DocumentTokenKind::Keyword Option::Some
        OpValue::IfElif => DocumentTokenKind::Keyword Option::Some
        OpValue::IfElse => DocumentTokenKind::Keyword Option::Some
        OpValue::IfEnd => DocumentTokenKind::Keyword Option::Some
        OpValue::WhileStart => DocumentTokenKind::Keyword Option::Some
        OpValue::WhileCondition => DocumentTokenKind::Keyword Option::Some
        OpValue::WhileEnd => DocumentTokenKind::Keyword Option::Some
        OpValue::WhileBreak => DocumentTokenKind::Keyword Option::Some
        OpValue::WhileContinue => DocumentTokenKind::Keyword Option::Some
        OpValue::MatchStart => DocumentTokenKind::Keyword Option::Some
        OpValue::MatchArm(_) => DocumentTokenKind::Keyword Option::Some
        OpValue::MatchEnd => DocumentTokenKind::Keyword Option::Some
        OpValue::FnReturn => DocumentTokenKind::Keyword Option::Some
        OpValue::Question(_) => DocumentTokenKind::Operator Option::Some
        OpValue::UnsafeStart => DocumentTokenKind::Keyword Option::Some
        OpValue::Add => DocumentTokenKind::Operator Option::Some
        OpValue::Sub => DocumentTokenKind::Operator Option::Some
        OpValue::Mul => DocumentTokenKind::Operator Option::Some
        OpValue::Div => DocumentTokenKind::Operator Option::Some
        OpValue::Mod => DocumentTokenKind::Operator Option::Some
        OpValue::Shl => DocumentTokenKind::Operator Option::Some
        OpValue::Shr => DocumentTokenKind::Operator Option::Some
        OpValue::BitAnd => DocumentTokenKind::Operator Option::Some
        OpValue::BitOr => DocumentTokenKind::Operator Option::Some
        OpValue::BitXor => DocumentTokenKind::Operator Option::Some
        OpValue::BitNot => DocumentTokenKind::Operator Option::Some
        OpValue::And => DocumentTokenKind::Operator Option::Some
        OpValue::Or => DocumentTokenKind::Operator Option::Some
        OpValue::Not => DocumentTokenKind::Operator Option::Some
        OpValue::Eq => DocumentTokenKind::Operator Option::Some
        OpValue::Ne => DocumentTokenKind::Operator Option::Some
        OpValue::Lt => DocumentTokenKind::Operator Option::Some
        OpValue::Le => DocumentTokenKind::Operator Option::Some
        OpValue::Gt => DocumentTokenKind::Operator Option::Some
        OpValue::Ge => DocumentTokenKind::Operator Option::Some
        OpValue::TypeCast(_) => DocumentTokenKind::Type Option::Some
        OpValue::PushEnumVariant(_) => DocumentTokenKind::EnumMember Option::Some
        OpValue::StructNew(_) => DocumentTokenKind::Struct Option::Some
        OpValue::Drop => DocumentTokenKind::Macro Option::Some
        OpValue::Dup => DocumentTokenKind::Macro Option::Some
        OpValue::Copy => DocumentTokenKind::Macro Option::Some
        OpValue::Swap => DocumentTokenKind::Macro Option::Some
        OpValue::Over => DocumentTokenKind::Macro Option::Some
        OpValue::Rot => DocumentTokenKind::Macro Option::Some
        OpValue::Print => DocumentTokenKind::Macro Option::Some
        OpValue::PrintInt => DocumentTokenKind::Macro Option::Some
        OpValue::PrintStr => DocumentTokenKind::Macro Option::Some
        OpValue::PrintString => DocumentTokenKind::Macro Option::Some
        OpValue::PrintBool => DocumentTokenKind::Macro Option::Some
        OpValue::PrintChar => DocumentTokenKind::Macro Option::Some
        OpValue::PrintCstr => DocumentTokenKind::Macro Option::Some
        OpValue::HeapAlloc => DocumentTokenKind::Macro Option::Some
        OpValue::HeapFree => DocumentTokenKind::Macro Option::Some
        OpValue::Load8 => DocumentTokenKind::Macro Option::Some
        OpValue::Load16 => DocumentTokenKind::Macro Option::Some
        OpValue::Load32 => DocumentTokenKind::Macro Option::Some
        OpValue::Load64 => DocumentTokenKind::Macro Option::Some
        OpValue::PtrAsRef(_) => DocumentTokenKind::Macro Option::Some
        OpValue::PtrAsMut(_) => DocumentTokenKind::Macro Option::Some
        OpValue::PtrIntoRaw => DocumentTokenKind::Macro Option::Some
        OpValue::PtrRead(_) => DocumentTokenKind::Macro Option::Some
        OpValue::Store8 => DocumentTokenKind::Macro Option::Some
        OpValue::Store16 => DocumentTokenKind::Macro Option::Some
        OpValue::Store32 => DocumentTokenKind::Macro Option::Some
        OpValue::Store64 => DocumentTokenKind::Macro Option::Some
        OpValue::PtrWrite(_) => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall0 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall1 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall2 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall3 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall4 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall5 => DocumentTokenKind::Macro Option::Some
        OpValue::Syscall6 => DocumentTokenKind::Macro Option::Some
        OpValue::Typeof => DocumentTokenKind::Macro Option::Some
        OpValue::SizeOf(_) => DocumentTokenKind::Macro Option::Some
        _ => Option[DocumentTokenKind]::None
    end
}

fn classify_qualified_member op_value:$OpValue -> DocumentTokenKind {
    if op_value OpValue::PushEnumVariant is then
        DocumentTokenKind::EnumMember
    else
        DocumentTokenKind::Function
    fi
}

fn find_keyword_before source:$str file_path:$str name_offset:u64 keyword:$str -> Option[Location] {
    name_offset = position
    while 0 position != do
        1 -= position
        position source.at = character
        if ' ' character != '\t' character != && '\n' character != && then
            break
        fi
    done
    if keyword.length position 1 + >= then
        position 1 + keyword.length - = keyword_start
        if source keyword_start keyword.length str::substring keyword == then
            keyword.length keyword_start file_path.to_str Location::new Option::Some return
        fi
    fi
    Option[Location]::None
}

impl Function {
    fn format_hover self:$Function -> String {
        String::new = builder
        if self.is_unsafe then
            "unsafe " builder.append
        fi
        "fn " builder.append
        self.name.as_str builder.append
        if
            0 self
                .stack_effect
                .parameters
                .length !=
        then
            " " builder.append
            List[String]::new = parameters
            for
                parameter in self
                    .stack_effect
                    .parameters
                    .iter
            do
                if "" parameter.name != then
                    f"{parameter.name}:{parameter.typ.format}"
                else
                    parameter.typ.format
                fi
                parameters.push
            done
            " " parameters.join_strings.as_str builder.append
        fi
        " -> " builder.append
        if
            0 self
                .stack_effect
                .return_types
                .length !=
        then
            List[String]::new = return_types
            for
                return_type in self
                    .stack_effect
                    .return_types
                    .iter
            do
                return_type.format return_types.push
            done
            " " return_types.join_strings.as_str builder.append
        else
            "None" builder.append
        fi
        builder
    }
}

impl CasaStruct {
    fn format_hover self:$CasaStruct -> String {
        String::new = builder
        "struct " builder.append
        self.name.as_str builder.append
        " { " builder.append
        List[String]::new = members
        for member in self.members.iter do
            f"{member.name}: {member.typ.format}" members.push
        done
        ", " members.join_strings.as_str builder.append
        " }" builder.append
        builder
    }
}

impl CasaEnum {
    fn format_hover self:$CasaEnum -> String {
        String::new = builder
        "enum " builder.append
        self.name.as_str builder.append
        " { " builder.append
        ", " self
            .variants
            .join_strings
            .as_str builder.append
        " }" builder.append
        builder
    }
}

impl OpValue {
    fn format_hover self:$OpValue -> Option[String] {
        self match
            OpValue::Add => "+: T T -> T (same-width integers)".to_str Option::Some
            OpValue::Sub => "-: T T -> T (same-width integers)".to_str Option::Some
            OpValue::Mul => "*: T T -> T (same-width integers)".to_str Option::Some
            OpValue::Div => "/: T T -> T (same-width integers)".to_str Option::Some
            OpValue::Mod => "%: T T -> T (same-width integers)".to_str Option::Some
            OpValue::Shl => "<<: T u64 -> T (integer T)".to_str Option::Some
            OpValue::Shr => ">>: T u64 -> T (integer T)".to_str Option::Some
            OpValue::BitAnd => "&: T T -> T (same-width integers)".to_str Option::Some
            OpValue::BitOr => "|: T T -> T (same-width integers)".to_str Option::Some
            OpValue::BitXor => "^: T T -> T (same-width integers)".to_str Option::Some
            OpValue::BitNot => "~: T -> T (integer T)".to_str Option::Some
            OpValue::Not => "!: bool -> bool".to_str Option::Some
            OpValue::Eq => "==: [T: PartialEq] T T -> bool".to_str Option::Some
            OpValue::Ne => "!=: [T: PartialEq] T T -> bool".to_str Option::Some
            OpValue::Lt => "<: [T: PartialOrd] T T -> bool".to_str Option::Some
            OpValue::Le => "<=: [T: PartialOrd] T T -> bool".to_str Option::Some
            OpValue::Gt => ">: [T: PartialOrd] T T -> bool".to_str Option::Some
            OpValue::Ge => ">=: [T: PartialOrd] T T -> bool".to_str Option::Some
            OpValue::And => "&&: bool bool -> bool".to_str Option::Some
            OpValue::Or => "||: bool bool -> bool".to_str Option::Some
            OpValue::Drop => "drop: T -> None".to_str Option::Some
            OpValue::Dup => "dup: [T: Copy] T -> T T".to_str Option::Some
            OpValue::Copy => "copy: [T: Copy] T -> T".to_str Option::Some
            OpValue::Swap => "swap: T1 T2 -> T2 T1".to_str Option::Some
            OpValue::Over => "over: [T2: Copy] T1 T2 -> T2 T1 T2".to_str Option::Some
            OpValue::Rot => "rot: T1 T2 T3 -> T3 T1 T2".to_str Option::Some
            OpValue::Print => "print: [T: Display] T -> None".to_str Option::Some
            OpValue::PrintInt => "print: [T: Display] T -> None".to_str Option::Some
            OpValue::PrintStr => "print: [T: Display] T -> None".to_str Option::Some
            OpValue::PrintBool => "print: [T: Display] T -> None".to_str Option::Some
            OpValue::PrintChar => "print: [T: Display] T -> None".to_str Option::Some
            OpValue::PrintCstr => "print: [T: Display] T -> None".to_str Option::Some
            OpValue::FnExec => "exec: fn[...] -> ...".to_str Option::Some
            OpValue::FnExecOwned => "exec: fn[...] -> ...".to_str Option::Some
            OpValue::Typeof => "typeof: T -> str".to_str Option::Some
            OpValue::SizeOf(_) => "size_of[T]: None -> u64".to_str Option::Some
            OpValue::AssignDec(_) => "-=: T -> None (integer T)".to_str Option::Some
            OpValue::AssignInc(_) => "+=: T -> None (integer T)".to_str Option::Some
            OpValue::HeapAlloc => "alloc: u64 -> ptr".to_str Option::Some
            OpValue::HeapFree => "free: ptr -> None".to_str Option::Some
            OpValue::Load8 => "load8: ptr -> u8".to_str Option::Some
            OpValue::Load16 => "load16: ptr -> u16".to_str Option::Some
            OpValue::Load32 => "load32: ptr -> u32".to_str Option::Some
            OpValue::Load64 => "load64: ptr -> u64".to_str Option::Some
            OpValue::PtrAsRef(target) => f"ptr::as_ref[{target.format}]: ptr -> ${target.format}" Option::Some
            OpValue::PtrAsMut(target) => f"ptr::as_mut[{target.format}]: ptr -> mut${target.format}" Option::Some
            OpValue::PtrIntoRaw => "ptr::into_raw: T -> ptr".to_str Option::Some
            OpValue::PtrRead(target) => f"ptr::read[{target.format}]: ptr -> {target.format}" Option::Some
            OpValue::Store8 => "store8: u8 ptr -> None".to_str Option::Some
            OpValue::Store16 => "store16: u16 ptr -> None".to_str Option::Some
            OpValue::Store32 => "store32: u32 ptr -> None".to_str Option::Some
            OpValue::Store64 => "store64: u64 ptr -> None".to_str Option::Some
            OpValue::PtrWrite(target) => f"ptr::write[{target.format}]: ptr {target.format} -> None" Option::Some
            OpValue::Syscall0 => "syscall0: i64 -> i64".to_str Option::Some
            OpValue::Syscall1 => "syscall1[A1: Word]: A1 i64 -> i64".to_str Option::Some
            OpValue::Syscall2 => "syscall2[A1: Word A2: Word]: A1 A2 i64 -> i64".to_str Option::Some
            OpValue::Syscall3 => "syscall3[A1: Word A2: Word A3: Word]: A1 A2 A3 i64 -> i64".to_str Option::Some
            OpValue::Syscall4 => "syscall4[A1: Word A2: Word A3: Word A4: Word]: A1 A2 A3 A4 i64 -> i64".to_str Option::Some
            OpValue::Syscall5 => "syscall5[A1: Word A2: Word A3: Word A4: Word A5: Word]: A1 A2 A3 A4 A5 i64 -> i64".to_str Option::Some
            OpValue::Syscall6 => "syscall6[A1: Word A2: Word A3: Word A4: Word A5: Word A6: Word]: A1 A2 A3 A4 A5 A6 i64 -> i64".to_str Option::Some
            OpValue::Argc => "argc: None -> i64".to_str Option::Some
            OpValue::Argv => "argv: None -> ptr".to_str Option::Some
            _ => Option[String]::None
        end
    }
}

impl AnalyzedDocument {
    fn new analysis:AnalysisResult source:String file_path:String -> AnalyzedDocument {
        analysis.into_parts = typechecked = sources = diagnostics
        List[Op]::new = ops
        Map[String Function]::new = functions
        Map[String CasaStruct]::new = structs
        Map[String CasaEnum]::new = enums
        Map[String Variable]::new = variables
        typechecked match
            Option::Some(typecheck_result) => {
                typecheck_result.into_document_parts = variables = enums = structs = functions = ops
            }
            Option::None => {
            }
        end
        diagnostics drop
        file_path
        source
        sources
        variables
        enums
        structs
        functions
        ops
        AnalyzedDocument
    }

    fn collect_document_functions self:$AnalyzedDocument -> List[Function] {
        List[Function]::new = functions
        for
            function_name in self
                .functions
                .keys
                .iter
        do
            function_name self
                .functions
                .get
                .unwrap = function
            if "" function.location.file == then
                continue
            fi
            if function.location.file self.file_path != then
                continue
            fi
            function.clone_for_import functions.push
        done
        functions
    }

    fn collect_operation_tokens
        self:$AnalyzedDocument
        ops:$List[Op]
        tokens:mut$List[DocumentToken]
    {
        for op in ops.iter do
            if
                op.location.file self.file_path != 0 op
                    .location
                    .span
                    .length <= ||
            then
                continue
            fi
            if op.value find_document_token_kind Option::Some(kind) is then
                if
                    op.value OpValue::FnCall is
                    op.value OpValue::FnPush is ||
                    op.value OpValue::PushEnumVariant is ||
                    op self.source.as_str is_qualified_operation &&
                then
                    SymbolPart::TypeName op self.source.as_str get_symbol_location self.locate
                    DocumentTokenKind::Type DocumentToken tokens.push
                    SymbolPart::MemberName op self.source.as_str get_symbol_location self.locate
                    op.value classify_qualified_member
                    DocumentToken tokens.push
                else
                    op.location self.locate kind copy DocumentToken tokens.push
                fi
            fi
        done
    }

    fn collect_declaration_token
        self:$AnalyzedDocument
        location:$Location
        keyword:$str
        kind:DocumentTokenKind
        tokens:mut$List[DocumentToken]
    {
        if location.file self.file_path != 0 location.span.length <= || then
            return
        fi
        location self.locate kind DocumentToken tokens.push
        if
            keyword location.span.offset self.file_path.as_str self.source.as_str find_keyword_before Option::Some(keyword_location) is
        then
            keyword_location self.locate DocumentTokenKind::Keyword DocumentToken tokens.push
        fi
    }

    fn find_semantic_tokens self:$AnalyzedDocument -> List[DocumentToken] {
        List[DocumentToken]::new = tokens
        tokens self.ops self.collect_operation_tokens
        for function in self.collect_document_functions.iter do
            tokens function.ops self.collect_operation_tokens
            if
                function.name.as_str "lambda__" str::starts_with !
                function.name.as_str "__" str::starts_with ! &&
            then
