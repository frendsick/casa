            .unwrap = cursor_offset
        if trigger "." == trigger ":" == || then
            cursor_offset self.find_triggered_completion_candidates return
        fi

        List[CompletionCandidate]::new = candidates
        for
            function_name in self
                .functions
                .keys
                .iter
        do
            if
                function_name.as_str "lambda__" str::starts_with
                function_name.as_str "__" str::starts_with ||
                function_name.as_str "::" str::contains ||
            then
                continue
            fi
            function_name self
                .functions
                .get
                .unwrap
                .name
                .clone CompletionCandidate::Function candidates.push
        done

        for
            struct_name in self
                .structs
                .keys
                .iter
        do
            struct_name self
                .structs
                .get
                .unwrap
                .clone CompletionCandidate::Struct candidates.push
        done

        for
            enum_name in self
                .enums
                .keys
                .iter
        do
            enum_name self
                .enums
                .get
                .unwrap
                .name
                .clone CompletionCandidate::Enum candidates.push
        done

        if cursor_offset self.find_containing_function Option::Some(function) is then
            0 (u64) = variable_index
            while variable_index function.variables.length > do
                variable_index function
                    .variables
                    .get
                    .clone CompletionCandidate::Variable candidates.push
                1 += variable_index
            done
        fi
        for
            variable_name in self
                .variables
                .keys
                .iter
        do
            if variable_name self.variables.get Option::Some(variable) is then
                variable.clone CompletionCandidate::Variable candidates.push
            fi
        done

        KeywordKind (u64) = keyword_count
        0 (u64) = keyword_index
        while keyword_index keyword_count > do
            keyword_index (KeywordKind) CompletionCandidate::Keyword candidates.push
            1 += keyword_index
        done

        IntrinsicKind (u64) = intrinsic_count
        0 (u64) = intrinsic_index
        while intrinsic_index intrinsic_count > do
            intrinsic_index (IntrinsicKind) CompletionCandidate::Intrinsic candidates.push
            1 += intrinsic_index
        done
        candidates
    }

    fn find_methods_for_type
