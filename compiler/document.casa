        done
        for
            enum_name in self
                .enums
                .keys
                .iter
        do
            enum_name self
                .enums
                .get
                .unwrap = casa_enum
            tokens DocumentTokenKind::Type "enum" casa_enum.location self.collect_declaration_token
        done
        for
            struct_name in self
