    fn lookup_enum self:$AnalyzedDocument name:$str -> Option[$CasaEnum] { name self.enums.get_str }

    fn find_variable_type
        self:$AnalyzedDocument
        name:$str
        function:$Option[Function]
    -> Option[Type] {
        if function Option::Some(containing_function) is then
            for variable in containing_function.variables.iter do
                if variable.name name == variable.typ.is_unknown ! && then
                    variable.typ clone_type Option::Some return
                fi
            done
            for capture in containing_function.captures.iter do
                if capture.name name == capture.typ.is_unknown ! && then
                    capture.typ clone_type Option::Some return
                fi
            done
        fi
        if name self.variables.get_str Option::Some(variable) is then
            if variable.typ.is_unknown ! then
                variable.typ clone_type Option::Some return
            fi
        fi
        Option[Type]::None
    }

    fn find_symbol_type self:$AnalyzedDocument symbol:$DocumentElement -> Option[Type] {
        symbol.op.value match
            OpValue::PushVar(name) => symbol.containing_function name.as_str self.find_variable_type
            OpValue::PushCapture(name) => symbol.containing_function name.as_str self.find_variable_type
            OpValue::AssignVar(name) => symbol.containing_function name.as_str self.find_variable_type
            OpValue::PushInt(_) => {
                if symbol.op.type_hint Option::Some(literal_type) is then
                    literal_type clone_type Option::Some
                else
                    TYPE_I64_T clone_type Option::Some
                fi
            }
            OpValue::PushFloat(_) => {
                if symbol.op.type_hint Option::Some(literal_type) is then
                    literal_type clone_type Option::Some
                else
                    TYPE_F64_T clone_type Option::Some
                fi
            }
            OpValue::PushStr(_) => TYPE_STR_T clone_type Option::Some
            OpValue::PushBool(_) => TYPE_BOOL_T clone_type Option::Some
            OpValue::PushChar(_) => TYPE_CHAR_T clone_type Option::Some
            _ => Option[Type]::None
        end
    }

    fn format_type_hover self:$AnalyzedDocument name:$str -> Option[String] {
        if name self.lookup_struct Option::Some(casa_struct) is then
            casa_struct.format_hover Option::Some return
        fi
        if name self.lookup_enum Option::Some(casa_enum) is then
            casa_enum.format_hover Option::Some return
        fi
        Option[String]::None
    }

    fn format_hover self:$AnalyzedDocument symbol:$DocumentElement -> Option[String] {
        if symbol.part SymbolPart::Separator is then
            Option[String]::None return
        fi

        if symbol.part SymbolPart::TypeName is then
            if
                symbol.op.value OpValue::FnCall is
                symbol.op.value OpValue::FnPush is ||
            then
                symbol.op op_str_value.as_str "::" str::split = parts
                0 parts.get.as_str self.format_type_hover return
            fi
            if symbol.op.value OpValue::PushEnumVariant(variant) is then
                variant.enum_name.as_str self.format_type_hover return
            fi
            Option[String]::None return
        fi

        if
            symbol.op.value OpValue::FnCall is
            symbol.op.value OpValue::FnPush is ||
        then
            symbol.op op_str_value = name
            if name.as_str self.lookup_function Option::Some(function) is then
                function.format_hover Option::Some
            else
                Option[String]::None
            fi
            return
        fi

        if
            symbol.op.value OpValue::PushVar is
            symbol.op.value OpValue::PushCapture is ||
        then
            symbol.op op_str_value = name
            if symbol self.find_symbol_type Option::Some(variable_type) is then
                f"{name}: {variable_type.format}" Option::Some
            else
                name.clone Option::Some
            fi
            return
        fi

        symbol.op.value match
            OpValue::StructNew(casa_struct) => casa_struct.format_hover Option::Some
            OpValue::PushEnumVariant(variant) => {
                f"{variant.enum_name}::{variant.variant_name}" Option::Some
            }
            OpValue::PushInt(value) => {
                if symbol.op.type_hint Option::Some(literal_type) is then
                    f"({literal_type.format}) {value.raw}" Option::Some
                else
                    f"(i64) {value.raw}" Option::Some
                fi
            }
            OpValue::PushFloat(value) => {
                if symbol.op.type_hint Option::Some(literal_type) is then
                    f"({literal_type.format}) {value}" Option::Some
                else
                    f"(f64) {value}" Option::Some
                fi
            }
            OpValue::PushStr(value) => f"(str) \"{value}\"" Option::Some
            OpValue::PushBool(value) => {
                if value 0 != then "(bool) true".to_str else "(bool) false".to_str fi Option::Some
            }
            OpValue::PushChar(value) => f"(char) '{value.to_str}'" Option::Some
            OpValue::AssignVar(name) => {
                if symbol self.find_symbol_type Option::Some(variable_type) is then
                    f"= {name}: {variable_type.format}" Option::Some
                else
                    f"= {name}" Option::Some
                fi
            }
            _ => symbol
                .op
                .value
                .format_hover
        end
    }

    fn find_enum_name_for_variant self:$AnalyzedDocument symbol:$DocumentSymbol -> Option[String] {
        for
            enum_name in self
                .enums
                .keys
                .iter
        do
            enum_name self
                .enums
                .get
                .unwrap = casa_enum
            if symbol.name casa_enum.variant_locations.get Option::Some(location) is then
                if location symbol.declaration.matches then
                    enum_name.clone Option::Some return
                fi
            fi
        done
        Option[String]::None
    }

    fn format_declaration_hover self:$AnalyzedDocument symbol:$DocumentSymbol -> Option[String] {
        symbol.kind match
            DocumentSymbolKind::Function => {
                if symbol.name.as_str self.lookup_function Option::Some(function) is then
                    function.format_hover Option::Some
                else
                    Option[String]::None
                fi
            }
            DocumentSymbolKind::Variable => Option[String]::None
            DocumentSymbolKind::Struct => {
                if symbol.name.as_str self.lookup_struct Option::Some(casa_struct) is then
                    casa_struct.format_hover Option::Some
                else
                    Option[String]::None
                fi
            }
            DocumentSymbolKind::Enum => {
                if symbol.name.as_str self.lookup_enum Option::Some(casa_enum) is then
                    casa_enum.format_hover Option::Some
                else
                    Option[String]::None
                fi
            }
            DocumentSymbolKind::EnumVariant => {
                if symbol self.find_enum_name_for_variant Option::Some(enum_name) is then
                    f"{enum_name}::{symbol.name}" Option::Some
                else
                    Option[String]::None
                fi
            }
        end
    }

    fn find_declaration_hover_at
        self:$AnalyzedDocument
        position:$SourcePosition
    -> Option[DocumentHover] {
        if position self.find_declared_symbol_at Option::Some(symbol) is then
            symbol self.format_declaration_hover match
                Option::Some(content) => symbol.declaration self.locate content DocumentHover Option::Some return
                Option::None => {
                }
            end
        fi
        if position self.find_function_at Option::Some(function) is then
            function.location self.locate function.format_hover DocumentHover Option::Some return
        fi
        Option[DocumentHover]::None
    }

    fn find_hover_at self:$AnalyzedDocument position:$SourcePosition -> Option[DocumentHover] {
        position self.find_declaration_hover_at match
            Option::Some(hover) => hover Option::Some return
            Option::None => {
            }
        end
        if position self.find_symbol_at Option::Some(symbol) is then
            symbol self.format_hover match
                Option::Some(content) => symbol.location self.locate content DocumentHover Option::Some return
                Option::None => {
                }
            end
        fi
        Option[DocumentHover]::None
    }

    fn find_variable_definition
        self:$AnalyzedDocument
        name:$str
        function:$Option[Function]
        usage_offset:u64
    -> Option[Location] {
        Option[Op]::None = best
        if function Option::Some(containing_function) is then
            best usage_offset containing_function.ops name find_best_assignment = best
        fi
        if best.is_none then
            best usage_offset self.ops name find_best_assignment = best
        fi
        if best Option::Some(definition_op) is then
            definition_op.location.clone Option::Some
        else
            Option[Location]::None
        fi
    }

    fn find_type_definition self:$AnalyzedDocument name:$str -> Option[Location] {
        if name self.lookup_struct Option::Some(casa_struct) is then
            casa_struct.location.clone Option::Some return
        fi
        if name self.lookup_enum Option::Some(casa_enum) is then
            casa_enum.location.clone Option::Some return
        fi
        Option[Location]::None
    }

    fn find_callable_definition self:$AnalyzedDocument symbol:$DocumentElement -> Option[Location] {
        if symbol.part SymbolPart::TypeName is then
            symbol.op op_str_value.as_str "::" str::split = parts
            0 parts.get.as_str self.find_type_definition return
        fi
        if symbol.op op_str_value.as_str self.lookup_function Option::Some(function) is then
            if "" function.location.file != then
                function.location.clone Option::Some return
            fi
        fi
        Option[Location]::None
    }

    fn find_enum_definition
        self:$AnalyzedDocument
        symbol:$DocumentElement
        variant:$EnumVariant
    -> Option[Location] {
        variant.enum_name.as_str self.lookup_enum = enum_result
        if enum_result Option::Some(casa_enum) is then
            if symbol.part SymbolPart::MemberName is then
                variant.variant_name casa_enum.variant_locations.get = variant_location
                if variant_location Option::Some(location) is then
                    location.clone Option::Some return
                fi
            fi
            casa_enum.location.clone Option::Some return
        fi
        Option[Location]::None
    }

    fn find_definition self:$AnalyzedDocument symbol:$DocumentElement -> Option[Location] {
        if symbol.part SymbolPart::Separator is then
            Option[Location]::None return
        fi
        symbol.op.value match
            OpValue::FnCall(_) => symbol self.find_callable_definition
            OpValue::FnPush(_) => symbol self.find_callable_definition
            OpValue::PushVar(name) => {
                symbol
                    .op
                    .location
                    .span
                    .offset
                symbol.containing_function
                name.as_str
                self.find_variable_definition
            }
            OpValue::PushCapture(name) => {
                symbol
                    .op
                    .location
                    .span
                    .offset
                symbol.containing_function
                name.as_str
                self.find_variable_definition
            }
            OpValue::StructNew(casa_struct) => casa_struct.location.clone Option::Some
            OpValue::PushEnumVariant(variant) => variant symbol self.find_enum_definition
            OpValue::TypeCast(cast_type) => cast_type.format.as_str self.find_type_definition
            _ => Option[Location]::None
        end
    }

    fn find_definition_at
        self:$AnalyzedDocument
        position:$SourcePosition
    -> Option[DocumentLocation] {
        if position self.find_symbol_at Option::Some(symbol) is then
            if symbol self.find_definition Option::Some(location) is then
                location self.locate Option::Some return
            fi
        fi
        Option[DocumentLocation]::None
    }

    fn locate self:$AnalyzedDocument location:$Location -> DocumentLocation {
        location.span.length location.span.offset location.file.clone DocumentLocation
    }
}
