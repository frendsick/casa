# Semantic queries over one analyzed source document.
import "std" as std
import "common" as common
import "binding" as binding
import "lexer" as lexer
import "typechecker" as typechecker
import "semantics" as semantics
import "error" as error
import "semantic_body" as semantic_body

pub enum SymbolPart derives std::Eq std::Copy {
    Whole
    TypeName
    Separator
    MemberName
}

pub enum DocumentSymbolKind derives std::Eq std::Copy {
    Function
    Variable
    Struct
    Enum
    EnumVariant
    Trait
}

# Facts needed while building the index. No ownership effects, substitutions, or executable bodies survive here.
struct ProjectionOperation {
    identity:   i64
    location:   common::Location
    value:      semantic_body::OccurrenceValue
    type_hint:  std::Option[common::Type]
    token_kind: std::Option[DocumentTokenKind]
    hover:      std::Option[std::String]
    verified:   bool
}

impl ProjectionOperation {
    fn get_symbol_name self:$ProjectionOperation -> std::String {
        self.value match
            semantic_body::OccurrenceValue::AssignDec(name) => name.clone
            semantic_body::OccurrenceValue::AssignInc(name) => name.clone
            semantic_body::OccurrenceValue::AssignVar(name) => name.clone
            semantic_body::OccurrenceValue::FnCall(name) => name.clone
            semantic_body::OccurrenceValue::FnPush(name) => name.clone
            semantic_body::OccurrenceValue::PushCapture(name) => name.clone
            semantic_body::OccurrenceValue::PushVar(name) => name.clone
            _ => std::String::new
        end
    }
}

fn project_body
    body:$semantics::AnalysisBody
    verified:$std::Set[i64]
    store:$common::SymbolStore
-> std::List[ProjectionOperation] {
    std::List[ProjectionOperation]::new = occurrences
    body match
        semantics::AnalysisBody::Checked(checked) => {
            {
                = occurrence: $semantic_body::Occurrence
                store verified occurrences occurrence project_source_occurrence
            } = visitor
            visitor checked.visit_occurrences
        }
        semantics::AnalysisBody::RejectedChecked(checked) => {
            {
                = occurrence: $semantic_body::Occurrence
                store verified occurrences occurrence project_source_occurrence
            } = visitor
            visitor checked.visit_occurrences
        }
        semantics::AnalysisBody::Rejected(work) => {
            {
                = operation: $common::Op
                store verified occurrences operation semantic_body::Occurrence::from_operation project_source_occurrence
            } = visitor
            visitor work.visit_operations
        }
        semantics::AnalysisBody::Source(source) => {
            source.lower_operations = operations
            store verified occurrences operations project_occurrences
        }
    end
    occurrences
}

fn project_occurrences
    operations:$std::List[common::Op]
    occurrences:mut$std::List[ProjectionOperation]
    verified:$std::Set[i64]
    store:$common::SymbolStore
{
    for operation in operations.iter do
        operation.value match
            common::OpValue::Unreachable(items) => {
                store verified occurrences items project_occurrences
                continue
            }
            common::OpValue::ExprGroup(items) => store verified occurrences items project_occurrences
            common::OpValue::PushArray(items) => store verified occurrences items project_occurrences
            common::OpValue::MatchArm(arm) => store verified occurrences arm.guard_ops project_occurrences
            _ => {}
        end
        store verified occurrences operation project_occurrence
    done
}

fn classify_source_token_kind
    value:$semantic_body::OccurrenceValue
-> std::Option[DocumentTokenKind] {
    value match
        semantic_body::OccurrenceValue::FnCall(_) => DocumentTokenKind::Function std::Option::Some
        semantic_body::OccurrenceValue::FnPush(_) => DocumentTokenKind::Function std::Option::Some
        semantic_body::OccurrenceValue::MethodCall => DocumentTokenKind::Function std::Option::Some
        semantic_body::OccurrenceValue::TraitMethodCall => DocumentTokenKind::Function std::Option::Some
        semantic_body::OccurrenceValue::TraitMethodRef => DocumentTokenKind::Function std::Option::Some
        semantic_body::OccurrenceValue::PushVar(_) => DocumentTokenKind::Variable std::Option::Some
        semantic_body::OccurrenceValue::PushCapture(_) => DocumentTokenKind::Variable std::Option::Some
        semantic_body::OccurrenceValue::AssignVar(_) => DocumentTokenKind::Variable std::Option::Some
        semantic_body::OccurrenceValue::AssignInc(_) => DocumentTokenKind::Variable std::Option::Some
        semantic_body::OccurrenceValue::AssignDec(_) => DocumentTokenKind::Variable std::Option::Some
        semantic_body::OccurrenceValue::PushStr(_) => DocumentTokenKind::String std::Option::Some
        semantic_body::OccurrenceValue::PushInt(_) => DocumentTokenKind::Number std::Option::Some
        semantic_body::OccurrenceValue::PushFloat(_) => DocumentTokenKind::Number std::Option::Some
        semantic_body::OccurrenceValue::PushChar(_) => DocumentTokenKind::Number std::Option::Some
        semantic_body::OccurrenceValue::PushBool(_) => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::FnExec => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::FnExecOwned => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::IfStart => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::IfCondition => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::IfElif => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::IfElse => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::IfEnd => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::WhileStart => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::WhileCondition => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::WhileEnd => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::WhileBreak => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::WhileContinue => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::MatchStart => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::MatchArm => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::MatchEnd => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::FnReturn => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::Question => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::UnsafeStart => DocumentTokenKind::Keyword std::Option::Some
        semantic_body::OccurrenceValue::Add => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Sub => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Mul => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Div => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Mod => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Shl => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Shr => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::BitAnd => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::BitOr => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::BitXor => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::BitNot => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::And => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Or => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Not => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Eq => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Ne => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Lt => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Le => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Gt => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::Ge => DocumentTokenKind::Operator std::Option::Some
        semantic_body::OccurrenceValue::PushEnumVariant(_) => DocumentTokenKind::EnumMember std::Option::Some
        semantic_body::OccurrenceValue::StructNew(_) => DocumentTokenKind::Struct std::Option::Some
        semantic_body::OccurrenceValue::Drop => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Dup => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Copy => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Swap => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Over => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Rot => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Print => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PrintInt => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PrintStr => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PrintString => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PrintBool => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PrintChar => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::HeapAlloc => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::HeapFree => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Load8 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Load16 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Load32 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Load64 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PtrAsRef(_) => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PtrAsMut(_) => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PtrFromRaw(_) => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PtrFromRef => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PtrIntoRaw => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PtrNull => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PtrRead(_) => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Store8 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Store16 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Store32 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Store64 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::PtrWrite(_) => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Syscall0 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Syscall1 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Syscall2 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Syscall3 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Syscall4 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Syscall5 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Syscall6 => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::Typeof => DocumentTokenKind::Macro std::Option::Some
        semantic_body::OccurrenceValue::SizeOf => DocumentTokenKind::Macro std::Option::Some
        _ => std::Option[DocumentTokenKind]::None
    end
}

impl semantic_body::OccurrenceValue {
    pub fn format_hover
        self:$semantic_body::OccurrenceValue
        store:$common::SymbolStore
        file:$str
    -> std::Option[std::String] {
        self match
            semantic_body::OccurrenceValue::Add => "+: T T -> T (same-width integers)".to_str std::Option::Some
            semantic_body::OccurrenceValue::Sub => "-: T T -> T (same-width integers)".to_str std::Option::Some
            semantic_body::OccurrenceValue::Mul => "*: T T -> T (same-width integers)".to_str std::Option::Some
            semantic_body::OccurrenceValue::Div => "/: T T -> T (same-width integers)".to_str std::Option::Some
            semantic_body::OccurrenceValue::Mod => "%: T T -> T (same-width integers)".to_str std::Option::Some
            semantic_body::OccurrenceValue::Shl => "<<: u64 T -> T (integer T)".to_str std::Option::Some
            semantic_body::OccurrenceValue::Shr => ">>: u64 T -> T (integer T)".to_str std::Option::Some
            semantic_body::OccurrenceValue::BitAnd => "&: T T -> T (same-width integers)".to_str std::Option::Some
            semantic_body::OccurrenceValue::BitOr => "|: T T -> T (same-width integers)".to_str std::Option::Some
            semantic_body::OccurrenceValue::BitXor => "^: T T -> T (same-width integers)".to_str std::Option::Some
            semantic_body::OccurrenceValue::BitNot => "~: T -> T (integer T)".to_str std::Option::Some
            semantic_body::OccurrenceValue::Not => "!: bool -> bool".to_str std::Option::Some
            semantic_body::OccurrenceValue::Eq => "==: [T: PartialEq] T T -> bool".to_str std::Option::Some
            semantic_body::OccurrenceValue::Ne => "!=: [T: PartialEq] T T -> bool".to_str std::Option::Some
            semantic_body::OccurrenceValue::Lt => "<: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            semantic_body::OccurrenceValue::Le => "<=: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            semantic_body::OccurrenceValue::Gt => ">: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            semantic_body::OccurrenceValue::Ge => ">=: [T: PartialOrd] T T -> bool".to_str std::Option::Some
            semantic_body::OccurrenceValue::And => "&&: bool bool -> bool".to_str std::Option::Some
            semantic_body::OccurrenceValue::Or => "||: bool bool -> bool".to_str std::Option::Some
            semantic_body::OccurrenceValue::Drop => "drop: T -> None".to_str std::Option::Some
            semantic_body::OccurrenceValue::Dup => "dup: [T: Copy] T -> T T".to_str std::Option::Some
            semantic_body::OccurrenceValue::Copy => "copy: [T: Copy] T -> T".to_str std::Option::Some
            semantic_body::OccurrenceValue::Swap => "swap: T1 T2 -> T2 T1".to_str std::Option::Some
            semantic_body::OccurrenceValue::Over => "over: [T2: Copy] T1 T2 -> T2 T1 T2".to_str std::Option::Some
            semantic_body::OccurrenceValue::Rot => "rot: T1 T2 T3 -> T3 T1 T2".to_str std::Option::Some
            semantic_body::OccurrenceValue::Print => "print: [T: Display] T -> None".to_str std::Option::Some
            semantic_body::OccurrenceValue::PrintInt => "print: [T: Display] T -> None".to_str std::Option::Some
            semantic_body::OccurrenceValue::PrintStr => "print: [T: Display] T -> None".to_str std::Option::Some
            semantic_body::OccurrenceValue::PrintBool => "print: [T: Display] T -> None".to_str std::Option::Some
            semantic_body::OccurrenceValue::PrintChar => "print: [T: Display] T -> None".to_str std::Option::Some
            semantic_body::OccurrenceValue::TraitMethodCall => "Trait requirement: conservative borrow sources from all compatible inputs".to_str std::Option::Some
            semantic_body::OccurrenceValue::TraitMethodRef => "Trait requirement: conservative borrow sources from all compatible inputs".to_str std::Option::Some
            semantic_body::OccurrenceValue::FnExec => "exec: fn[...] -> ...".to_str std::Option::Some
            semantic_body::OccurrenceValue::FnExecOwned => "exec: fn[...] -> ...".to_str std::Option::Some
            semantic_body::OccurrenceValue::Typeof => "typeof: T -> str".to_str std::Option::Some
            semantic_body::OccurrenceValue::SizeOf => "size_of[T]: None -> u64".to_str std::Option::Some
            semantic_body::OccurrenceValue::AssignDec(_) => "-=: T -> None (integer T)".to_str std::Option::Some
            semantic_body::OccurrenceValue::AssignInc(_) => "+=: T -> None (integer T)".to_str std::Option::Some
            semantic_body::OccurrenceValue::HeapAlloc => "alloc: u64 -> ptr".to_str std::Option::Some
            semantic_body::OccurrenceValue::HeapFree => "free: ptr -> None".to_str std::Option::Some
            semantic_body::OccurrenceValue::Load8 => "load8: ptr -> u8".to_str std::Option::Some
            semantic_body::OccurrenceValue::Load16 => "load16: ptr -> u16".to_str std::Option::Some
            semantic_body::OccurrenceValue::Load32 => "load32: ptr -> u32".to_str std::Option::Some
            semantic_body::OccurrenceValue::Load64 => "load64: ptr -> u64".to_str std::Option::Some
            semantic_body::OccurrenceValue::PtrAsRef(target) => {
                file target store.format_type_for_source = type_name
                f"ptr::as_ref[{type_name}]: ptr -> ${type_name}" std::Option::Some
            }
            semantic_body::OccurrenceValue::PtrAsMut(target) => {
                file target store.format_type_for_source = type_name
                f"ptr::as_mut[{type_name}]: ptr -> mut${type_name}" std::Option::Some
            }
            semantic_body::OccurrenceValue::PtrFromRaw(target) => {
                file target store.format_type_for_source = type_name
                f"ptr::from_raw[{type_name}]: ptr -> {type_name}" std::Option::Some
            }
            semantic_body::OccurrenceValue::PtrFromRef => "ptr::from_ref: $T -> ptr".to_str std::Option::Some
            semantic_body::OccurrenceValue::PtrIntoRaw => "ptr::into_raw: T -> ptr".to_str std::Option::Some
            semantic_body::OccurrenceValue::PtrNull => "ptr::null: None -> ptr".to_str std::Option::Some
            semantic_body::OccurrenceValue::PtrRead(target) => {
                file target store.format_type_for_source = type_name
                f"ptr::read[{type_name}]: ptr -> {type_name}" std::Option::Some
            }
            semantic_body::OccurrenceValue::Store8 => "store8: u8 ptr -> None".to_str std::Option::Some
            semantic_body::OccurrenceValue::Store16 => "store16: u16 ptr -> None".to_str std::Option::Some
            semantic_body::OccurrenceValue::Store32 => "store32: u32 ptr -> None".to_str std::Option::Some
            semantic_body::OccurrenceValue::Store64 => "store64: u64 ptr -> None".to_str std::Option::Some
            semantic_body::OccurrenceValue::PtrWrite(target) => {
                file target store.format_type_for_source = type_name
                f"ptr::write[{type_name}]: ptr {type_name} -> None" std::Option::Some
            }
            semantic_body::OccurrenceValue::Syscall0 => "syscall0: i64 -> i64".to_str std::Option::Some
            semantic_body::OccurrenceValue::Syscall1 => "syscall1[A1: Word]: A1 i64 -> i64".to_str std::Option::Some
            semantic_body::OccurrenceValue::Syscall2 => "syscall2[A1: Word A2: Word]: A1 A2 i64 -> i64".to_str std::Option::Some
            semantic_body::OccurrenceValue::Syscall3 => "syscall3[A1: Word A2: Word A3: Word]: A1 A2 A3 i64 -> i64".to_str std::Option::Some
            semantic_body::OccurrenceValue::Syscall4 => "syscall4[A1: Word A2: Word A3: Word A4: Word]: A1 A2 A3 A4 i64 -> i64".to_str std::Option::Some
            semantic_body::OccurrenceValue::Syscall5 => "syscall5[A1: Word A2: Word A3: Word A4: Word A5: Word]: A1 A2 A3 A4 A5 i64 -> i64".to_str std::Option::Some
            semantic_body::OccurrenceValue::Syscall6 => "syscall6[A1: Word A2: Word A3: Word A4: Word A5: Word A6: Word]: A1 A2 A3 A4 A5 A6 i64 -> i64".to_str std::Option::Some
            semantic_body::OccurrenceValue::Argc => "argc: None -> i64".to_str std::Option::Some
            semantic_body::OccurrenceValue::Argv => "argv: None -> ptr".to_str std::Option::Some
            _ => std::Option[std::String]::None
        end
    }
}

impl semantic_body::Occurrence {
    fn format_hover
        self:$semantic_body::Occurrence
        store:$common::SymbolStore
    -> std::Option[std::String] {
        self.value match
            semantic_body::OccurrenceValue::PushInt(literal) => {
                self
                    .type_hint
                    .clone
                    .unwrap
                    .format = type_name
                f"{literal}: {type_name}" std::Option::Some
            }
            semantic_body::OccurrenceValue::PushFloat(literal) => {
                self
                    .type_hint
                    .clone
                    .unwrap
                    .format = type_name
                f"{literal}: {type_name}" std::Option::Some
            }
            semantic_body::OccurrenceValue::PushStr(literal) => f"\"{literal}\": str" std::Option::Some
            semantic_body::OccurrenceValue::PushBool(literal) => {
                if literal 0 != then "true: bool".to_str else "false: bool".to_str fi std::Option::Some
            }
            semantic_body::OccurrenceValue::PushChar(literal) => {
                literal.to_str = value
                f"'{value}': char" std::Option::Some
            }
            _ => self
                .location
                .file
                .as_str store self.value.format_hover
        end
    }
}

fn format_struct_hover
    name:$str
    fields:$std::List[common::Member]
    is_extern:bool
    store:$common::SymbolStore
    file:$str
-> std::String {
    std::String::new = builder
    if is_extern then
        "extern " builder.append
    fi
    "struct " builder.append
    file name store.format_name_for_source.as_str builder.append
    " { " builder.append
    std::List[std::String]::new = members
    for member in fields.iter do
        file member.typ store.format_type_for_source = type_name
        f"{member.name}: {type_name}" members.push
    done
    ", " members.join_strings.as_str builder.append
    " }" builder.append
    builder
}

impl common::CasaStruct {
    pub fn format_hover
        self:$common::CasaStruct
        store:$common::SymbolStore
        file:$str
    -> std::String {
        file store self.is_extern self.members self.name.as_str format_struct_hover
    }
}

impl semantic_body::OccurrenceStruct {
    fn format_hover
        self:$semantic_body::OccurrenceStruct
        store:$common::SymbolStore
        file:$str
    -> std::String {
        file store self.is_extern self.members self.name.as_str format_struct_hover
    }
}

fn project_occurrence
    operation:$common::Op
    output:mut$std::List[ProjectionOperation]
    verified:$std::Set[i64]
    store:$common::SymbolStore
{
    store verified output operation semantic_body::Occurrence::from_operation project_source_occurrence
}

fn project_source_occurrence
    occurrence:$semantic_body::Occurrence
    output:mut$std::List[ProjectionOperation]
    verified:$std::Set[i64]
    store:$common::SymbolStore
{
    # Generated storage and cleanup work inherits source locations but has no source occurrence.
    if occurrence.value semantic_body::OccurrenceValue::OwnerCleanup is then
        return
    fi
    occurrence.value classify_source_token_kind = token_kind
    store occurrence.format_hover = hover
    occurrence.identity verified.has hover token_kind occurrence.type_hint.clone
    occurrence.value.clone occurrence.location.clone occurrence.identity ProjectionOperation output.push
}

struct IndexBuilder {
    declarations:      std::Set[std::String]
    # Source function names in store order, with positions keyed by the text before the first `::`.
    function_names:    std::List[std::String]
    receiver_names:    std::Map[std::String std::List[u64]]
    root_occurrences:  std::List[ProjectionOperation]
    body_occurrences:  std::Map[std::String std::List[ProjectionOperation]]
    empty_occurrences: std::List[ProjectionOperation]
    store:             common::SymbolStore
    diagnostics:       error::Diagnostics
    sources:           lexer::SourceStore
    source:            std::String
    file_path:         std::String
    bindings:          binding::BindingStore
    # Verified binding indexes by visibility file and name, in declaration order.
    visible_bindings:  std::Map[std::String std::Map[std::String std::List[u64]]]
    # Method candidates by receiver format. Completion triggers repeat few receivers.
    receiver_methods:  std::Map[std::String std::List[CompletionCandidate]]
}

fn index_receiver_names names:$std::List[std::String] -> std::Map[std::String std::List[u64]] {
    std::Map[std::String std::List[u64]]::new = receivers
    0 = index: u64
    for name in names.iter do
        if name.as_str "::" str::find std::Option::Some(separator) is then
            name.as_str 0 separator str::substring = receiver
            if receiver.as_str receivers.has_str ! then
                std::List[u64]::new receiver.clone receivers.set
            fi
            index receiver.as_str receivers
                .get_mut_str
                .unwrap
                .push
        fi
        1 += index
    done
    receivers
}

fn declaration_key location:$common::Location -> std::String {
    f"{location.span.offset}:{location.span.length}:{location.file}"
}

struct DocumentElement {
    pub op:       $ProjectionOperation
    pub part:     SymbolPart
    pub location: common::Location
}

pub struct DocumentLocation derives std::Clone {
    pub file:   std::String
    pub offset: u64
    pub length: u64
}

pub struct DocumentHover derives std::Clone {
    pub content:  std::String
    pub location: DocumentLocation
}

pub enum DocumentTokenKind derives std::Eq std::Copy {
    Function
    Variable
    String
    Number
    Keyword
    Operator
    Type
    EnumMember
    Struct
    Macro
}

pub struct DocumentToken derives std::Clone {
    pub kind:     DocumentTokenKind
    pub location: DocumentLocation
}

impl DocumentToken {
    pub fn comes_before self:$DocumentToken pivot:$DocumentToken -> bool {
        if pivot.location.offset self.location.offset == then
            self.kind DocumentTokenKind::Function == pivot.kind DocumentTokenKind::Function != &&
        else
            pivot.location.offset self.location.offset >
        fi
    }
}

pub enum CompletionCandidate derives std::Clone {
    Function(std::String)
    Variable(common::Variable std::String)
    Keyword(common::KeywordKind)
    Intrinsic(common::IntrinsicKind)
    Struct(common::CasaStruct std::String)
    Enum(std::String)
    EnumVariant(std::String)
    Method(std::String)
}

struct ProjectionSymbol {
    pub kind:        DocumentSymbolKind
    pub name:        std::String
    pub declaration: common::Location
    pub owner:       std::Option[common::Location]
}

impl ProjectionSymbol {
    pub fn new
        kind:DocumentSymbolKind
        name:$str
        declaration:$common::Location
        owner:std::Option[common::Location]
    -> ProjectionSymbol {
        owner declaration.clone name.to_str kind ProjectionSymbol
    }

    pub fn matches_identity self:$ProjectionSymbol other:$ProjectionSymbol -> bool {
        if self.kind other.kind != self.name other.name != || then
            false return
        fi
        if other.declaration self.declaration.matches ! then
            false return
        fi
        if self.owner std::Option::Some(self_owner) is then
            if other.owner std::Option::Some(other_owner) is then
                other_owner self_owner.matches return
            fi
            false return
        fi
        other.owner.is_none
    }
}

# A qualified name splits at its last `::`. The type part excludes module prefixes.
# Members after explicit type arguments already have their own token location.
fn get_symbol_location source:$str op:$ProjectionOperation part:$SymbolPart -> common::Location {
    if part SymbolPart::Whole is then
        op.location.clone return
    fi
    op
        .location
        .span
        .offset = start
    source start op
        .location
        .span
        .length str::substring = spelling
    spelling.as_str common::path_name_spans = spans
    spans
        .qualifier
        .clone
        .unwrap = type_span
    spans.name copy = member_span
    part copy match
        SymbolPart::TypeName => type_span.length start type_span.offset + op.location.with_span
        SymbolPart::Separator => 2 start member_span.offset + 2 - op.location.with_span
        SymbolPart::MemberName => member_span.length start member_span.offset + op.location.with_span
        SymbolPart::Whole => op.location.clone
    end
}

pub fn extract_word_before source:$str offset:u64 -> std::String {
    offset = end_pos
    end_pos = start_pos
    while 0 start_pos != do
        1 -= start_pos
        start_pos source.at.unwrap = character
        if character.is_alpha ! character.is_digit ! && character '_' != && then
            1 += start_pos
            break
        fi
    done
    source start_pos end_pos start_pos - str::substring
}

# Extract a qualified receiver and keep balanced generic type arguments.
pub fn extract_type_before source:$str offset:u64 -> std::String {
    offset = end_pos
    end_pos = start_pos
    0 = bracket_depth: u64
    while 0 start_pos != do
        1 -= start_pos
        start_pos source.at.unwrap = character
        if ']' character == then
            1 += bracket_depth
        elif '[' character == then
            if 0 bracket_depth == then
                1 += start_pos
                break
            fi
            1 -= bracket_depth
        elif 0 bracket_depth != then
            continue
        elif
            character.is_alpha
            character.is_digit ||
            character '_' == ||
            character ':' == ||
            character '$' == || !
        then
            1 += start_pos
            break
        fi
    done
    if 0 bracket_depth != then
        std::String::new return
    fi
    source start_pos end_pos start_pos - str::substring
}

pub fn extract_chain_before source:$str offset:u64 -> std::List[std::String] {
    std::List[std::String]::new = reversed_parts
    offset = position
    while 0 position < do
        position source extract_word_before = word
        if 0 word.length == then
            break
        fi
        word.length = word_length
        word reversed_parts.push
        word_length -= position
        if 0 position < then
            if '.' position 1 - source.at.unwrap == then
                1 -= position
            else
                break
            fi
        fi
    done

    std::List[std::String]::new = parts
    reversed_parts.length = reverse_index
    while 0 reverse_index != do
        1 -= reverse_index
        reverse_index reversed_parts.get.clone parts.push
    done
    parts
}

pub fn infer_literal_type text:$str -> std::Option[common::Type] {
    if 0 text.length == then
        std::Option[common::Type]::None return
    fi
    true = all_digits
    for character in text.iter do
        if character.is_digit ! then
            false = all_digits
            break
        fi
    done
    if all_digits then
        common::make_i64_type.clone std::Option::Some return
    fi
    if text lexer::is_float_literal then
        common::make_f64_type.clone std::Option::Some return
    fi
    if text "true" == text "false" == || then
        common::make_bool_type.clone std::Option::Some return
    fi
    std::Option[common::Type]::None
}

# A qualified struct name has no member. Its module prefix is not a type. A match
# arm or `is` check is located at a pattern and has no symbol. Its whole-token
# occurrence leaves the pattern names to the narrower type reference occurrences.
fn is_qualified_operation source:$str op:$ProjectionOperation -> bool {
    if
        0 op
            .location
            .span
            .length == op.value semantic_body::OccurrenceValue::StructNew is ||
        op.value semantic_body::OccurrenceValue::MatchArm is ||
        op.value semantic_body::OccurrenceValue::Other is ||
    then
        false return
    fi
    source op
        .location
        .span
        .offset op
        .location
        .span
        .length str::substring.as_str "::" str::contains
}

fn classify_qualified_member op_value:$semantic_body::OccurrenceValue -> DocumentTokenKind {
    if op_value semantic_body::OccurrenceValue::PushEnumVariant is then
        DocumentTokenKind::EnumMember
    else
        DocumentTokenKind::Function
    fi
}

pub fn find_keyword_before
    source:$str
    file_path:$str
    name_offset:u64
    keyword:$str
-> std::Option[common::Location] {
    name_offset = position
    while 0 position != do
        1 -= position
        position source.at.unwrap = character
        if ' ' character != '\t' character != && '\n' character != && then
            break
        fi
    done
    if keyword.length position 1 + <= then
        position 1 + keyword.length - = keyword_start
        if source keyword_start keyword.length str::substring keyword == then
            keyword.length keyword_start file_path.to_str common::Location::new std::Option::Some return
        fi
    fi
    std::Option[common::Location]::None
}

impl common::Function {
    pub fn format_hover self:$common::Function store:$common::SymbolStore file:$str -> std::String {
        std::String::new = builder
        if self.is_unsafe then
            "unsafe " builder.append
        fi
        "fn " builder.append
        file self.name.as_str store.format_name_for_source.as_str builder.append
        if
            0 self
                .stack_effect
                .parameters
                .length !=
        then
            " " builder.append
            std::List[std::String]::new = parameters
            for
                parameter in self
                    .stack_effect
                    .parameters
                    .iter
            do
                if "" parameter.name != then
                    f"{parameter.name}:{file parameter.typ store.format_type_for_source}"
                else
                    file parameter.typ store.format_type_for_source
                fi
                parameters.push
            done
            " " parameters.join_strings.as_str builder.append
        fi
        " -> " builder.append
        if
            0 self
                .stack_effect
                .return_types
                .length !=
        then
            std::List[std::String]::new = return_types
            for
                return_type in self
                    .stack_effect
                    .return_types
                    .iter
            do
                file return_type store.format_type_for_source return_types.push
            done
            " " return_types.join_strings.as_str builder.append
        else
            "None" builder.append
        fi
        if self.borrow_sources std::Option::Some(sources) is then
            "\n" builder.append
            sources.as_str builder.append
        fi
        builder
    }
}

impl common::CasaTrait {
    pub fn format_hover
        self:$common::CasaTrait
        store:$common::SymbolStore
        file:$str
    -> std::String {
        std::String::new = builder
        "trait " builder.append
        file self.name.as_str store.format_name_for_source.as_str builder.append
        if 0 self.type_params.length != then
            "[" builder.append
            " " self
                .type_params
                .join_strings
                .as_str builder.append
            "]" builder.append
        fi
        if 0 self.supertraits.length != then
            std::List[std::String]::new = supertraits
            for supertrait in self.supertraits.iter do
                file supertrait common::trait_bound_to_type store.format_type_for_source supertraits.push
            done
            ": " builder.append
            " + " supertraits.join_strings.as_str builder.append
        fi
        std::List[std::String]::new = methods
        for method in self.methods.iter do
            method.name.clone methods.push
        done
        " { " builder.append
        ", " methods.join_strings.as_str builder.append
        " }" builder.append
        builder
    }
}

impl common::CasaEnum {
    pub fn format_hover self:$common::CasaEnum store:$common::SymbolStore file:$str -> std::String {
        std::String::new = builder
        "enum " builder.append
        file self.name.as_str store.format_name_for_source.as_str builder.append
        " { " builder.append
        ", " self
            .variants
            .join_strings
            .as_str builder.append
        " }" builder.append
        builder
    }
}

impl IndexBuilder {
    fn project_failures self:$IndexBuilder index:mut$EditorIndex {
        for
            diagnostic in self
                .diagnostics
                .entries
                .iter
        do
            if diagnostic error::Diagnostic::Error(failure) is then
                failure classify_query_failure failure.location self.locate CoverageRegion index.unavailable.push
            fi
        done
    }

    pub fn new
        typechecked:std::Option[typechecker::TypecheckResult]
        sources:lexer::SourceStore
        diagnostics:error::Diagnostics
        file_path:std::String
    -> IndexBuilder {
        if file_path.as_str sources.get std::Option::Some(text) is then
            text.clone
        else
            std::String::new
        fi = source
        std::List[ProjectionOperation]::new = root_occurrences
        std::Map[std::String std::List[ProjectionOperation]]::new = body_occurrences
        common::symbol_store_new = store
        binding::BindingStore::new = bindings
        if typechecked std::Option::Some(result) is then
            result.into_analysis_parts = checked_bindings = verified = bodies = root = checked_store
            checked_store verified root project_body = root_occurrences
            for entry in bodies.iter do
                checked_store verified entry.second project_body entry.first.clone body_occurrences.set
            done
            checked_store = store
            checked_bindings = bindings
        fi
        std::Map[std::String std::List[CompletionCandidate]]::new bindings index_visible_bindings
        store.get_source_function_names = function_names
        function_names index_receiver_names = receiver_names
        bindings file_path source sources diagnostics store std::List[ProjectionOperation]::new body_occurrences root_occurrences
        receiver_names function_names std::Set[std::String]::new IndexBuilder
    }

    fn get_function_occurrences self:$IndexBuilder name:$str -> $std::List[ProjectionOperation] {
        if name self.body_occurrences.get_str std::Option::Some(occurrences) is then
            occurrences return
        fi
        self.empty_occurrences
    }

    pub fn collect_document_functions self:$IndexBuilder -> std::List[std::String] {
        std::List[std::String]::new = functions
        for
            function_name in self
                .function_names
                .iter
        do
            if
                function_name self
                    .store
                    .source_functions
                    .has
            then
                continue
            fi
            function_name.as_str self
                .store
                .get_function
                .unwrap = function
            if "" function.location.file == then
                continue
            fi
            if function.location.file self.file_path != then
                continue
            fi
            function.name.clone functions.push
        done
        functions
    }

    pub fn collect_operation_tokens
        self:$IndexBuilder
        ops:$std::List[ProjectionOperation]
        tokens:mut$std::List[DocumentToken]
    {
        for op in ops.iter do
            if op.verified ! then
                continue
            fi
            if
                op.location.file self.file_path != 0 op
                    .location
                    .span
                    .length >= ||
            then
                continue
            fi
            if op.token_kind.clone std::Option::Some(kind) is then
                if
                    op.value semantic_body::OccurrenceValue::FnCall is
                    op.value semantic_body::OccurrenceValue::FnPush is ||
                    op.value semantic_body::OccurrenceValue::PushEnumVariant is ||
                    op self.source.as_str is_qualified_operation &&
                then
                    SymbolPart::TypeName op self.source.as_str get_symbol_location self.locate
                    DocumentTokenKind::Type DocumentToken tokens.push
                    SymbolPart::MemberName op self.source.as_str get_symbol_location self.locate
                    op.value classify_qualified_member
                    DocumentToken tokens.push
                else
                    op.location self.locate kind copy DocumentToken tokens.push
                fi
            fi
        done
    }

    pub fn collect_declaration_token
        self:$IndexBuilder
        location:$common::Location
        keyword:$str
        kind:DocumentTokenKind
        tokens:mut$std::List[DocumentToken]
    {
        if location.file self.file_path != 0 location.span.length >= || then
            return
        fi
        location self.locate kind DocumentToken tokens.push
        if
            keyword location.span.offset self.file_path.as_str self.source.as_str find_keyword_before std::Option::Some(keyword_location) is
        then
            keyword_location self.locate DocumentTokenKind::Keyword DocumentToken tokens.push
        fi
    }

    pub fn find_semantic_tokens self:$IndexBuilder -> std::List[DocumentToken] {
        std::List[DocumentToken]::new = tokens
        for
            reference in self
                .store
                .type_references
                .iter
        do
            if reference.location.file self.file_path == reference.variant.is_none && then
                if reference.name.as_str self.find_type_symbol.is_some then
                    reference.location self.locate DocumentTokenKind::Type DocumentToken tokens.push
                fi
            fi
        done
        tokens self.root_occurrences self.collect_operation_tokens
        for function_name in self.collect_document_functions.iter do
            function_name.as_str self.lookup_function.unwrap = function
            tokens function.name.as_str self.get_function_occurrences self.collect_operation_tokens
            if function self.has_source_declaration then
                tokens DocumentTokenKind::Function "fn" function.location self.collect_declaration_token
                if function.is_unsafe then
                    if
                        "unsafe" function
                            .location
                            .span
                            .offset self.file_path.as_str self.source.as_str
                        find_keyword_before std::Option::Some(unsafe_location) is
                    then
                        unsafe_location self.locate DocumentTokenKind::Keyword DocumentToken tokens.push
                    fi
                fi
            fi
        done
        for
            enum_name in self
                .store
                .enums
                .keys
                .iter
        do
            enum_name self
                .store
                .enums
                .get
                .unwrap = casa_enum
            tokens DocumentTokenKind::Type "enum" casa_enum.location self.collect_declaration_token
        done
        for
            struct_name in self
                .store
                .structs
                .keys
                .iter
        do
            struct_name self
                .store
                .structs
                .get
                .unwrap = casa_struct
            tokens DocumentTokenKind::Struct "struct" casa_struct.location self.collect_declaration_token
        done
        &DocumentToken::comes_before tokens.sort_by
        tokens
    }

    pub fn find_completion_candidates
        self:mut$IndexBuilder
        position:$common::SourcePosition
        trigger:$str
    -> std::List[CompletionCandidate] {
        position self.file_path.as_str self
            .sources
            .convert_position_to_offset
            .unwrap = cursor_offset
        if trigger "." == trigger ":" == || then
            cursor_offset self.find_triggered_completion_candidates return
        fi

        std::List[CompletionCandidate]::new = candidates
        for
            function_name in self
                .function_names
                .iter
        do
            if
                function_name self
                    .store
                    .source_functions
                    .has
            then
                continue
            fi
            if self.file_path.as_str function_name.as_str self.store.is_private_from then
                continue
            fi
            self.file_path.as_str function_name.as_str self.store.format_name_for_source = source_name
            if
                source_name.as_str "lambda__" str::starts_with
                source_name.as_str "__" str::starts_with ||
                source_name.as_str "::" str::contains ||
            then
                continue
            fi
            source_name CompletionCandidate::Function candidates.push
        done

        for
            struct_name in self
                .store
                .structs
                .keys
                .iter
        do
            if self.file_path.as_str struct_name.as_str self.store.is_private_from then
                continue
            fi
            self.file_path.as_str struct_name.as_str self.store.format_name_for_source = source_name
            if source_name.as_str "__" str::starts_with then
                continue
            fi
            struct_name self
                .store
                .structs
                .get
                .unwrap
                .clone = declaration
            source_name = declaration.name
            std::String::new = members
            for member_index in declaration.members.length 0 std::Range::new do
                if 0 member_index != then
                    ", " members.append
                fi
                member_index declaration.members.get = member
                member.name.as_str members.append
                ": " members.append
                self.file_path.as_str member.typ self
                    .store
                    .format_type_for_source
                    .as_str members.append
            done
            members declaration CompletionCandidate::Struct candidates.push
        done

        for
            enum_name in self
                .store
                .enums
                .keys
                .iter
        do
            if self.file_path.as_str enum_name.as_str self.store.is_private_from then
                continue
            fi
            self.file_path.as_str enum_name.as_str self.store.format_name_for_source = source_name
            if source_name.as_str "__" str::starts_with then
                continue
            fi
            source_name CompletionCandidate::Enum candidates.push
        done

        [
            common::KeywordKind::Pub,
            common::KeywordKind::As,
            common::KeywordKind::Unsafe,
            common::KeywordKind::Fn,
            common::KeywordKind::Impl,
            common::KeywordKind::Return,
            common::KeywordKind::While,
            common::KeywordKind::Do,
            common::KeywordKind::Break,
            common::KeywordKind::Continue,
            common::KeywordKind::Done,
            common::KeywordKind::If,
            common::KeywordKind::Then,
            common::KeywordKind::Elif,
            common::KeywordKind::Else,
            common::KeywordKind::Fi,
            common::KeywordKind::EnumKw,
            common::KeywordKind::StructKw,
            common::KeywordKind::TraitKw,
            common::KeywordKind::End,
            common::KeywordKind::Match,
            common::KeywordKind::Is,
            common::KeywordKind::Import,
            common::KeywordKind::For,
            common::KeywordKind::In,
            common::KeywordKind::Const,
            common::KeywordKind::Move,
        ] = keywords
        for keyword in keywords.iter do
            keyword copy CompletionCandidate::Keyword candidates.push
        done

        [
            common::IntrinsicKind::Drop,
            common::IntrinsicKind::Dup,
            common::IntrinsicKind::Copy,
            common::IntrinsicKind::Over,
            common::IntrinsicKind::Rot,
            common::IntrinsicKind::Swap,
            common::IntrinsicKind::Alloc,
            common::IntrinsicKind::Free,
            common::IntrinsicKind::Load8,
            common::IntrinsicKind::Load16,
            common::IntrinsicKind::Load32,
            common::IntrinsicKind::Load64,
            common::IntrinsicKind::Store8,
            common::IntrinsicKind::Store16,
            common::IntrinsicKind::Store32,
            common::IntrinsicKind::Store64,
            common::IntrinsicKind::Print,
            common::IntrinsicKind::Panic,
            common::IntrinsicKind::Typeof,
            common::IntrinsicKind::SizeOf,
            common::IntrinsicKind::Exec,
            common::IntrinsicKind::Syscall0,
            common::IntrinsicKind::Syscall1,
            common::IntrinsicKind::Syscall2,
            common::IntrinsicKind::Syscall3,
            common::IntrinsicKind::Syscall4,
            common::IntrinsicKind::Syscall5,
            common::IntrinsicKind::Syscall6,
            common::IntrinsicKind::Argc,
            common::IntrinsicKind::Argv,
            common::IntrinsicKind::Envp,
        ] = intrinsics
        for intrinsic in intrinsics.iter do
            intrinsic copy CompletionCandidate::Intrinsic candidates.push
        done
        candidates
    }

    fn accepts_receiver
        self:$IndexBuilder
        function:$common::Function
        receiver:$common::Type
    -> bool {
        if function.stack_effect semantics::method_receiver_type std::Option::Some(expected) is else
            false return
        fi
        receiver semantics::type_capability = capability
        expected capability semantics::capability_matches_receiver
    }

    pub fn find_methods_for_type
        self:mut$IndexBuilder
        receiver_type:$common::Type
        require_receiver:bool
    -> std::List[CompletionCandidate] {
        # Qualified lookups ignore receiver capability, so they use a separate key.
        receiver_type.format = key
        if require_receiver ! then
            "::" key.append
        fi
        if key.as_str self.receiver_methods.get_str std::Option::Some(cached) is then
            cached.clone return
        fi
        require_receiver receiver_type self.collect_methods_for_type = candidates
        candidates.clone key self.receiver_methods.set
        candidates
    }

    fn collect_methods_for_type
        self:$IndexBuilder
        receiver_type:$common::Type
        require_receiver:bool
    -> std::List[CompletionCandidate] {
        receiver_type.clone receiver_type.borrow_target.unwrap_or = target
        f"{target.format}::" = exact_prefix
        f"{target.match_base}::" = base_prefix
        std::List[CompletionCandidate]::new = candidates
        std::Set[std::String]::new = method_names
        target.match_base target.format self.find_receiver_positions = positions
        for position in positions.iter do
            position copy self.function_names.get = function_name
            if
                function_name.as_str exact_prefix.as_str str::starts_with ! function_name.as_str base_prefix.as_str str::starts_with ! &&
            then
                continue
            fi
            function_name.as_str self
                .store
                .get_function
                .unwrap = function
            if require_receiver then
                if receiver_type function self.accepts_receiver ! then
                    continue
                fi
            fi
            function_name.as_str "::" str::split.unwrap.pop = method_name
            if method_name.as_str method_names.has_str then
                continue
            fi
            method_name method_names.add
            function.name.clone CompletionCandidate::Method candidates.push
        done
        candidates
    }

    # Positions of names that can start with either receiver, in store order.
    fn find_receiver_positions
        self:$IndexBuilder
        exact:std::String
        base:std::String
    -> std::List[u64] {
        std::List[u64]::new = positions
        if exact.as_str "::" str::contains base.as_str "::" str::contains || then
            for position in self.function_names.length 0 std::Range::new do
                position positions.push
            done
            positions return
        fi
        if exact.as_str self.receiver_names.get_str std::Option::Some(found) is then
            found.clone positions.append
        fi
        if exact base != then
            if base.as_str self.receiver_names.get_str std::Option::Some(found) is then
                found.clone positions.append
                positions.sort
            fi
        fi
        positions
    }

    pub fn find_qualified_completion_candidates
        self:mut$IndexBuilder
        type_name:$str
    -> std::List[CompletionCandidate] {
        std::List[CompletionCandidate]::new = candidates
        if type_name self.lookup_enum std::Option::Some(casa_enum) is then
            for variant_name in casa_enum.variants.iter do
                variant_name.clone CompletionCandidate::EnumVariant candidates.push
            done
        fi
        type_name common::parse_type_str = receiver_type
        false receiver_type self.find_methods_for_type candidates.append
        candidates
    }

    pub fn resolve_completion_chain_type
        self:$IndexBuilder
        parts:$std::List[std::String]
        offset:u64
    -> std::Option[common::Type] {
        if 0 parts.length == then
            std::Option[common::Type]::None return
        fi
        0 parts.get = first_part
        offset first_part.as_str self.find_variable_type = current_type
        if current_type.is_none then
            first_part.as_str infer_literal_type = current_type
        fi
        if current_type std::Option::Some(resolved_type) is else
            std::Option[common::Type]::None return
        fi

        for part_index in parts.length 1 std::Range::new do
            part_index parts.get = method_name
            resolved_type.clone resolved_type.borrow_target.unwrap_or = target
            f"{target.format}::{method_name}" = exact_name
            f"{target.match_base}::{method_name}" = base_name
            exact_name.as_str self.lookup_function = function_opt
            if function_opt.is_none then
                base_name.as_str self.lookup_function = function_opt
            fi
            function_opt match
                std::Option::Some(function) => {
                    if resolved_type function self.accepts_receiver ! then
                        std::Option[common::Type]::None return
                    fi
                    if
                        0 function
                            .stack_effect
                            .return_types
                            .length ==
                    then
                        std::Option[common::Type]::None return
                    fi
                    0 function
                        .stack_effect
                        .return_types
                        .get
                        .clone = resolved_type
                }
                std::Option::None => std::Option[common::Type]::None return
            end
        done
        resolved_type std::Option::Some
    }

    pub fn find_triggered_completion_candidates
        self:mut$IndexBuilder
        offset:u64
    -> std::List[CompletionCandidate] {
        if 0 offset == then
            std::List[CompletionCandidate]::new return
        fi
        offset 1 - = position

        if 1 position <= then
            if self.source.as_str position 1 - 2 str::substring.as_str "::" == then
                position 1 - self.source.as_str extract_type_before = type_name
                if 0 type_name.length != then
                    type_name.as_str self.find_qualified_completion_candidates return
                fi
            fi
        fi

        if
            '.' position self
                .source
                .at
                .unwrap ==
        then
            position self.source.as_str extract_chain_before = chain
            if offset chain self.resolve_completion_chain_type std::Option::Some(receiver_type) is then
                true receiver_type self.find_methods_for_type return
            fi
        fi

        std::List[CompletionCandidate]::new
    }

    # The type key that the written qualifier of a callable `element` names, or an empty
    # string. `Plain::tag`, `Tagged::tag`, and `Plain::Tagged::tag` all resolve to
    # `Plain::Tagged::tag`, so the written segment selects the receiver or the trait.
    # Only the segment before the member is projected, so `Plain` in
    # `Plain::Tagged::tag` has no answer. Project it too if struct rename must edit it.
    fn find_qualifier_name self:$IndexBuilder element:$DocumentElement -> std::String {
        element
            .location
            .file
            .as_str = file
        if file self.sources.get std::Option::Some(source) is then
            source.as_str element
                .location
                .span
                .offset element
                .location
                .span
                .length str::substring = written
            element
                .op
                .get_symbol_name
                .as_str "::" str::split.unwrap = parts
            # The last part is the member.
            parts.length 1 - = position
            while 0 position < do
                1 -= position
                position parts.get.clone = key
                if key.as_str "[" str::find std::Option::Some(bracket) is then
                    key.as_str 0 bracket str::substring = key
                fi
                file key.as_str self.store.format_name_for_source = source_name
                source_name.as_str common::path_name_spans.name copy = span
                if source_name.as_str span.offset span.length str::substring written == then
                    key return
                fi
            done
        fi
        std::String::new
    }

    pub fn find_callable_symbol
        self:$IndexBuilder
        element:$DocumentElement
        name:$str
    -> std::Option[ProjectionSymbol] {
        if element.part SymbolPart::TypeName is then
            element self.find_qualifier_name.as_str self.find_type_symbol return
        fi
        if element.part SymbolPart::Separator is then
            std::Option[ProjectionSymbol]::None return
        fi
        if name self.lookup_function std::Option::Some(function) is then
            std::Option[common::Location]::None
            function.location
            name
            DocumentSymbolKind::Function
            ProjectionSymbol::new std::Option::Some return
        fi
        std::Option[ProjectionSymbol]::None
    }

    pub fn find_enum_variant_symbol
        self:$IndexBuilder
        variant:$semantic_body::OccurrenceVariant
        part:$SymbolPart
    -> std::Option[ProjectionSymbol] {
        if part SymbolPart::TypeName is then
            variant.enum_name.as_str self.find_type_symbol return
        fi
        if part SymbolPart::Separator is then
            std::Option[ProjectionSymbol]::None return
        fi
        variant.variant_name variant.enum_name.as_str self.find_variant_symbol
    }

    fn find_variant_symbol
        self:$IndexBuilder
        enum_name:$str
        variant_name:$std::String
    -> std::Option[ProjectionSymbol] {
        if enum_name self.lookup_enum std::Option::Some(casa_enum) is then
            if variant_name casa_enum.variant_locations.get std::Option::Some(declaration) is then
                std::Option[common::Location]::None
                declaration
                variant_name.as_str
                DocumentSymbolKind::EnumVariant
                ProjectionSymbol::new std::Option::Some return
            fi
        fi
        std::Option[ProjectionSymbol]::None
    }

    pub fn find_symbol_identity
        self:$IndexBuilder
        element:$DocumentElement
    -> std::Option[ProjectionSymbol] {
        element.op.value match
            semantic_body::OccurrenceValue::FnCall(name) => name.as_str element self.find_callable_symbol
            semantic_body::OccurrenceValue::FnPush(name) => name.as_str element self.find_callable_symbol
            semantic_body::OccurrenceValue::PushEnumVariant(variant) => element.part variant self.find_enum_variant_symbol
            semantic_body::OccurrenceValue::StructNew(casa_struct) => {
                std::Option[common::Location]::None
                casa_struct.location
                casa_struct.name.as_str
                DocumentSymbolKind::Struct
                ProjectionSymbol::new std::Option::Some
            }
            semantic_body::OccurrenceValue::PushVar(_) => element.op self.find_binding_symbol
            semantic_body::OccurrenceValue::PushCapture(_) => element.op self.find_binding_symbol
            semantic_body::OccurrenceValue::AssignVar(_) => element.op self.find_binding_symbol
            semantic_body::OccurrenceValue::AssignInc(_) => element.op self.find_binding_symbol
            semantic_body::OccurrenceValue::AssignDec(_) => element.op self.find_binding_symbol
            _ => std::Option[ProjectionSymbol]::None
        end
    }

    pub fn find_type_symbol self:$IndexBuilder name:$str -> std::Option[ProjectionSymbol] {
        if name self.lookup_struct std::Option::Some(casa_struct) is then
            std::Option[common::Location]::None
            casa_struct.location
            casa_struct.name.as_str
            DocumentSymbolKind::Struct
            ProjectionSymbol::new std::Option::Some return
        fi
        if name self.lookup_enum std::Option::Some(casa_enum) is then
            std::Option[common::Location]::None
            casa_enum.location
            casa_enum.name.as_str
            DocumentSymbolKind::Enum
            ProjectionSymbol::new std::Option::Some return
        fi
        if name self.lookup_trait std::Option::Some(casa_trait) is then
            std::Option[common::Location]::None
            casa_trait.location
            casa_trait.name.as_str
            DocumentSymbolKind::Trait
            ProjectionSymbol::new std::Option::Some return
        fi
        std::Option[ProjectionSymbol]::None
    }

    pub fn lookup_function self:$IndexBuilder name:$str -> std::Option[$common::Function] {
        name self.store.get_function
    }

    pub fn lookup_struct self:$IndexBuilder name:$str -> std::Option[$common::CasaStruct] {
        name self
            .store
            .structs
            .get_str
    }

    pub fn lookup_enum self:$IndexBuilder name:$str -> std::Option[$common::CasaEnum] {
        name self
            .store
            .enums
            .get_str
    }

    pub fn lookup_trait self:$IndexBuilder name:$str -> std::Option[$common::CasaTrait] {
        name self
            .store
            .traits
            .get_str
    }

    pub fn find_symbol_type
        self:$IndexBuilder
        symbol:$DocumentElement
    -> std::Option[common::Type] {
        symbol
            .op
            .type_hint
            .clone
    }

    fn format_function_hover
        self:$IndexBuilder
        function:$common::Function
        file:$str
    -> std::String {
        if
            function.name self
                .store
                .source_functions
                .get std::Option::Some(source_name) is
        then
            source_name.as_str self
                .store
                .get_function
                .unwrap = source
            file self.store source.format_hover return
        fi
        file self.store function.format_hover
    }

    pub fn format_type_hover self:$IndexBuilder name:$str file:$str -> std::Option[std::String] {
        if name self.lookup_struct std::Option::Some(casa_struct) is then
            file self.store casa_struct.format_hover std::Option::Some return
        fi
        if name self.lookup_enum std::Option::Some(casa_enum) is then
            file self.store casa_enum.format_hover std::Option::Some return
        fi
        if name self.lookup_trait std::Option::Some(casa_trait) is then
            file self.store casa_trait.format_hover std::Option::Some return
        fi
        std::Option[std::String]::None
    }

    fn append_binding_sources
        self:$IndexBuilder
        operation:$ProjectionOperation
        description:std::String
    -> std::String {
        if
            operation.identity self
                .bindings
                .references
                .get std::Option::Some(reference) is
        then
            if reference.borrow_sources std::Option::Some(sources) is then
                "\n" description.append
                sources.as_str description.append
            fi
        fi
        description
    }

    pub fn format_hover self:$IndexBuilder symbol:$DocumentElement -> std::Option[std::String] {
        if symbol.part SymbolPart::Separator is then
            std::Option[std::String]::None return
        fi
        symbol
            .location
            .file
            .as_str = file

        if symbol.part SymbolPart::TypeName is then
            if
                symbol.op.value semantic_body::OccurrenceValue::FnCall is
                symbol.op.value semantic_body::OccurrenceValue::FnPush is ||
            then
                file symbol self.find_qualifier_name.as_str self.format_type_hover return
            fi
            if symbol.op.value semantic_body::OccurrenceValue::PushEnumVariant(variant) is then
                file variant.enum_name.as_str self.format_type_hover return
            fi
            std::Option[std::String]::None return
        fi

        if
            symbol.op.value semantic_body::OccurrenceValue::FnCall is
            symbol.op.value semantic_body::OccurrenceValue::FnPush is ||
        then
            symbol.op.get_symbol_name = name
            if name.as_str self.lookup_function std::Option::Some(function) is then
                file function self.format_function_hover std::Option::Some
            else
                std::Option[std::String]::None
            fi
            return
        fi

        if
            symbol.op.value semantic_body::OccurrenceValue::PushVar is
            symbol.op.value semantic_body::OccurrenceValue::PushCapture is ||
        then
            symbol.op.get_symbol_name = name
            if symbol self.find_symbol_type std::Option::Some(variable_type) is then
                file variable_type self.store.format_type_for_source = type_name
                f"{name}: {type_name}" = description
                description symbol.op self.append_binding_sources std::Option::Some
            else
                name.clone std::Option::Some
            fi
            return
        fi

        symbol.op.value match
            semantic_body::OccurrenceValue::StructNew(casa_struct) => {
                file self.store casa_struct.format_hover std::Option::Some
            }
            semantic_body::OccurrenceValue::PushEnumVariant(variant) => {
                file variant.enum_name.as_str self.store.format_name_for_source = enum_name
                f"{enum_name}::{variant.variant_name}" std::Option::Some
            }
            semantic_body::OccurrenceValue::AssignVar(name) => {
                if symbol self.find_symbol_type std::Option::Some(variable_type) is then
                    file variable_type self.store.format_type_for_source = type_name
                    f"= {name}: {type_name}" symbol.op self.append_binding_sources std::Option::Some
                else
                    f"= {name}" std::Option::Some
                fi
            }
            _ => symbol
                .op
                .hover
                .clone
        end
    }

    pub fn find_enum_name_for_variant
        self:$IndexBuilder
        symbol:$ProjectionSymbol
    -> std::Option[std::String] {
        for
            enum_name in self
                .store
                .enums
                .keys
                .iter
        do
            enum_name self
                .store
                .enums
                .get
                .unwrap = casa_enum
            if symbol.name casa_enum.variant_locations.get std::Option::Some(location) is then
                if location symbol.declaration.matches then
                    enum_name.clone std::Option::Some return
                fi
            fi
        done
        std::Option[std::String]::None
    }

    pub fn format_declaration_hover
        self:$IndexBuilder
        symbol:$ProjectionSymbol
    -> std::Option[std::String] {
        symbol.kind match
            DocumentSymbolKind::Function => {
                if symbol.name.as_str self.lookup_function std::Option::Some(function) is then
                    symbol
                        .declaration
                        .file
                        .as_str function self.format_function_hover std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            DocumentSymbolKind::Variable => std::Option[std::String]::None
            DocumentSymbolKind::Struct => {
                if symbol.name.as_str self.lookup_struct std::Option::Some(casa_struct) is then
                    symbol
                        .declaration
                        .file
                        .as_str self.store casa_struct.format_hover std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            DocumentSymbolKind::Enum => {
                if symbol.name.as_str self.lookup_enum std::Option::Some(casa_enum) is then
                    symbol
                        .declaration
                        .file
                        .as_str self.store casa_enum.format_hover std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
            DocumentSymbolKind::Trait => {
                symbol
                    .declaration
                    .file
                    .as_str symbol.name.as_str self.format_type_hover
            }
            DocumentSymbolKind::EnumVariant => {
                if symbol self.find_enum_name_for_variant std::Option::Some(enum_name) is then
                    symbol
                        .declaration
                        .file
                        .as_str enum_name.as_str self.store.format_name_for_source = source_name
                    f"{source_name}::{symbol.name}" std::Option::Some
                else
                    std::Option[std::String]::None
                fi
            }
        end
    }

    pub fn find_type_definition self:$IndexBuilder name:$str -> std::Option[common::Location] {
        if name self.lookup_struct std::Option::Some(casa_struct) is then
            casa_struct.location.clone std::Option::Some return
        fi
        if name self.lookup_enum std::Option::Some(casa_enum) is then
            casa_enum.location.clone std::Option::Some return
        fi
        if name self.lookup_trait std::Option::Some(casa_trait) is then
            casa_trait.location.clone std::Option::Some return
        fi
        std::Option[common::Location]::None
    }

    pub fn find_callable_definition
        self:$IndexBuilder
        symbol:$DocumentElement
    -> std::Option[common::Location] {
        if symbol.part SymbolPart::TypeName is then
            symbol self.find_qualifier_name.as_str self.find_type_definition return
        fi
        if
            symbol
                .op
                .get_symbol_name
                .as_str self.lookup_function std::Option::Some(function) is
        then
            if "" function.location.file != then
                function.location.clone std::Option::Some return
            fi
        fi
        std::Option[common::Location]::None
    }

    pub fn find_enum_definition
        self:$IndexBuilder
        symbol:$DocumentElement
        variant:$semantic_body::OccurrenceVariant
    -> std::Option[common::Location] {
        variant.enum_name.as_str self.lookup_enum = enum_result
        if enum_result std::Option::Some(casa_enum) is then
            if symbol.part SymbolPart::TypeName is ! then
                variant.variant_name casa_enum.variant_locations.get = variant_location
                if variant_location std::Option::Some(location) is then
                    location.clone std::Option::Some return
                fi
            fi
            casa_enum.location.clone std::Option::Some return
        fi
        std::Option[common::Location]::None
    }

    pub fn find_definition
        self:$IndexBuilder
        symbol:$DocumentElement
    -> std::Option[common::Location] {
        if symbol.part SymbolPart::Separator is then
            std::Option[common::Location]::None return
        fi
        symbol.op.value match
            semantic_body::OccurrenceValue::FnCall(_) => symbol self.find_callable_definition
            semantic_body::OccurrenceValue::FnPush(_) => symbol self.find_callable_definition
            semantic_body::OccurrenceValue::PushVar(_) => symbol.op self.find_binding_definition
            semantic_body::OccurrenceValue::PushCapture(_) => symbol.op self.find_binding_definition
            semantic_body::OccurrenceValue::AssignVar(_) => symbol.op self.find_binding_definition
            semantic_body::OccurrenceValue::AssignInc(_) => symbol.op self.find_binding_definition
            semantic_body::OccurrenceValue::AssignDec(_) => symbol.op self.find_binding_definition
            semantic_body::OccurrenceValue::StructNew(casa_struct) => casa_struct.location.clone std::Option::Some
            semantic_body::OccurrenceValue::PushEnumVariant(variant) => variant symbol self.find_enum_definition
            _ => std::Option[common::Location]::None
        end
    }

    pub fn locate self:$IndexBuilder location:$common::Location -> DocumentLocation {
        location.span.length location.span.offset location.file.clone DocumentLocation
    }
}

# Owned source facts. Neither the index nor any query answer contains compiler bodies.
pub enum QueryReason derives std::Copy std::Eq {
    InvalidInput
    RejectedSyntax
    UnresolvedDependency
    MissingSemanticFact
}

pub enum PointAnswer[T] {
    Known(T)
    Absent
    Unavailable(QueryReason)
}

pub enum ListAnswer[T] {
    Complete(std::List[T])
    Incomplete(std::List[T] QueryReason)
    Unavailable(QueryReason)
}

pub struct DocumentCompletion {
    pub candidate:      CompletionCandidate
    pub insertion_text: std::String
    pub replacement:    DocumentLocation
}

pub struct DocumentReferences {
    pub ranges:                    std::List[DocumentLocation]
    pub declaration:               DocumentLocation
    pub files:                     std::List[std::String]
    pub rename_requires_workspace: bool
}

impl DocumentReferences {
    pub fn into_ranges self:DocumentReferences -> std::List[DocumentLocation] {
        self match
            DocumentReferences { ranges: ranges } => ranges
        end
    }
}

pub enum ReferenceAnswer {
    Complete(DocumentReferences)
    Incomplete(DocumentReferences QueryReason)
    Unavailable(QueryReason)
}

pub struct DocumentSymbol derives std::Clone {
    pub kind:        DocumentSymbolKind
    pub name:        std::String
    pub declaration: common::Location
    pub owner:       std::Option[common::Location]
}

impl DocumentSymbol {
    pub fn matches_identity self:$DocumentSymbol other:$DocumentSymbol -> bool {
        self.kind other.kind == other.declaration self.declaration.matches &&
    }
}

struct Occurrence derives std::Clone {
    location:         DocumentLocation
    hover:            std::Option[std::String]
    definition:       std::Option[DocumentLocation]
    symbol:           std::Option[DocumentSymbol]
    declaration:      bool
    reference_offset: u64
    reference_length: u64
}

struct CompletionScope derives std::Clone {
    location: DocumentLocation
    items:    std::List[CompletionCandidate]
}

pub struct EditorIndex derives std::Clone {
    files:       std::List[DocumentLocation]
    occurrences: std::List[Occurrence]
    tokens:      std::List[DocumentToken]
    completions: std::List[CompletionScope]
    scopes:      std::List[CompletionScope]
    triggers:    std::List[CompletionScope]
    coverage:    std::Option[QueryReason]
    unavailable: std::List[CoverageRegion]
    words:       std::List[DocumentLocation]
    bodies:      std::List[DocumentLocation]
}

impl DocumentLocation {
    pub fn contains self:$DocumentLocation file:$str offset:u64 -> bool {
        self.file file == self.offset offset <= && offset self.offset self.length + < &&
    }

    pub fn matches self:$DocumentLocation other:$DocumentLocation -> bool {
        self.file other.file == self.offset other.offset == && self.length other.length == &&
    }

    pub fn comes_before self:$DocumentLocation other:$DocumentLocation -> bool {
        if self.file other.file == then
            other.offset self.offset >
        else
            0 = index: u64
            while index self.file.length < index other.file.length < && do
                index self
                    .file
                    .at
                    .unwrap = first
                index other
                    .file
                    .at
                    .unwrap = second
                if first second != then
                    second first > return
                fi
                1 += index
            done
            other.file.length self.file.length >
        fi
    }
}

impl ProjectionSymbol {
    fn project self:$ProjectionSymbol -> DocumentSymbol {
        std::Option[common::Location]::None = owner
        if self.owner std::Option::Some(function) is then
            function.clone std::Option::Some = owner
        fi
        owner self.declaration.clone self.name.clone self.kind DocumentSymbol
    }
}

impl IndexBuilder {
    fn project_operation
        self:$IndexBuilder
        op:$ProjectionOperation
        part:SymbolPart
        index:mut$EditorIndex
    {
        if
            op
                .location
                .file
                .as_str self.sources.get std::Option::Some(source) is
        then
            part op source.as_str get_symbol_location = location
            if 0 location.span.length == then
                return
            fi
            location.clone part op DocumentElement = element
            std::Option[DocumentSymbol]::None = symbol
            if element self.find_symbol_identity std::Option::Some(identity) is then
                identity.project std::Option::Some = symbol
            fi
            std::Option[DocumentLocation]::None = definition
            if element self.find_definition std::Option::Some(target) is then
                target self.locate std::Option::Some = definition
            fi
            element self.format_hover = hover
            # A checked trait call keeps no trait name. Its written type reference answers instead.
            if part SymbolPart::TypeName is symbol.is_none && definition.is_none && hover.is_none && then
                return
            fi
            false = declaration
            if symbol.clone std::Option::Some(identity) is then
                if identity.kind DocumentSymbolKind::Variable == then
                    location identity.declaration.matches = declaration
                fi
            fi
            source.as_str location.span.offset location.span.length str::substring.as_str
            common::path_name_spans.name copy = name_span
            location.span.offset name_span.offset + = reference_offset
            name_span.length reference_offset declaration symbol definition hover location self.locate
            Occurrence index.occurrences.push
        fi
    }

    fn project_operations
        self:$IndexBuilder
        ops:$std::List[ProjectionOperation]
        function:std::Option[std::String]
        index:mut$EditorIndex
    {
        for op in ops.iter do
            if function.clone std::Option::Some(name) is then
                if
                    op.location name.as_str self
                        .lookup_function
                        .unwrap
                        .location
                        .matches
                then
                    continue
                fi
            fi
            if op.verified ! then
                QueryReason::MissingSemanticFact op.location self.locate CoverageRegion index.unavailable.push
                continue
            fi
            if
                op
                    .location
                    .file
                    .as_str self.sources.get std::Option::Some(source) is
            then
                if op source.as_str is_qualified_operation then
                    index SymbolPart::TypeName op self.project_operation
                    index SymbolPart::MemberName op self.project_operation
                else
                    index SymbolPart::Whole op self.project_operation
                fi
            fi
        done
    }

    fn project_declaration self:$IndexBuilder symbol:ProjectionSymbol index:mut$EditorIndex {
        if
            "" symbol.declaration.file == 0 symbol
                .declaration
                .span
                .length == ||
        then
            return
        fi
        symbol
            .declaration
            .span
            .length symbol
            .declaration
            .span
            .offset
        true symbol.project std::Option::Some
        symbol.declaration self.locate std::Option::Some
        symbol self.format_declaration_hover symbol.declaration self.locate
        Occurrence index.occurrences.push
    }

    fn project_variables self:$IndexBuilder function:$common::Function index:mut$EditorIndex {
        function
            .location
            .span
            .offset function
            .location
            .span
            .length + 1 + = end_offset
        end_offset function
            .body_end
            .clone
            .unwrap_or = end_offset
        end_offset function
            .location
            .span
            .offset - function
            .location
            .span
            .offset function
            .location
            .file
            .clone
        DocumentLocation index.bodies.push
        for
            parameter in function
                .stack_effect
                .parameters
                .iter
        do
            if parameter.location std::Option::Some(location) is then
                function.location.clone std::Option::Some location parameter.name.as_str
                DocumentSymbolKind::Variable ProjectionSymbol::new = symbol
                location.span.length location.span.offset true symbol.project std::Option::Some
                location self.locate std::Option::Some
                location.file.as_str parameter.typ self.store.format_type_for_source = parameter_type
                f"{parameter.name}: {parameter_type}" std::Option::Some location self.locate
                Occurrence index.occurrences.push
            fi
        done
    }

    fn has_source_declaration self:$IndexBuilder function:$common::Function -> bool {
        function.location declaration_key self.declarations.has
    }

    fn collect_source_declarations self:mut$IndexBuilder tokens:$std::List[common::Token] {
        false = after_fn
        for token in tokens.iter do
            if token.kind common::TokenKind::Newline == token.kind common::TokenKind::Comment == || then
                continue
            fi
            if after_fn token.kind common::TokenKind::Identifier == && then
                token.location declaration_key self.declarations.add
            fi
            token.kind common::TokenKind::Keyword == token.value "fn" == && = after_fn
        done
    }

    fn project_lexical_token self:$IndexBuilder token:$common::Token index:mut$EditorIndex {
        if token.kind common::TokenKind::Identifier == then
            token
                .location
                .span
                .offset = start
            start = offset
            start token
                .location
                .span
                .length + = end_offset
            while end_offset offset > do
                offset self
                    .source
                    .at
                    .unwrap = character
                1 += offset
                if ':' character != '.' character != && then
                    continue
                fi
                if start offset 1 - < then
                    offset 1 - start - start self.file_path.clone DocumentLocation index.words.push
                fi
                offset = start
            done
            if start end_offset < then
                end_offset start - start self.file_path.clone DocumentLocation index.words.push
            fi
        fi
        # These lexical categories do not need resolved symbol facts.
        token.kind match
            common::TokenKind::Keyword => DocumentTokenKind::Keyword
            common::TokenKind::Operator => DocumentTokenKind::Operator
            common::TokenKind::Intrinsic => DocumentTokenKind::Macro
            common::TokenKind::FstringText => DocumentTokenKind::String
            common::TokenKind::Literal => {
                if token.value.as_str "\"" str::starts_with then
                    DocumentTokenKind::String
                elif token.value "true" == token.value "false" == || then
                    DocumentTokenKind::Keyword
                else
                    DocumentTokenKind::Number
                fi
            }
            _ => return
        end = kind
        token.location self.locate kind DocumentToken index.tokens.push
    }

    # Import-stage names already have projected facts when the root stage reuses them.
    fn project_facts
        self:$IndexBuilder
        index:mut$EditorIndex
        imported_functions:$std::Set[std::String]
        imported_types:$std::Set[std::String]
    {
        index std::Option[std::String]::None self.root_occurrences self.project_operations
        for
            name in self
                .function_names
                .iter
        do
            if
                name self
                    .store
                    .source_functions
                    .has name imported_functions.has ||
            then
                continue
            fi
            name.as_str self
                .store
                .get_function
                .unwrap = function
            index function.name.clone std::Option::Some function.name.as_str self.get_function_occurrences self.project_operations
            if function self.has_source_declaration then
                index std::Option[common::Location]::None function.location function.name.as_str
                DocumentSymbolKind::Function ProjectionSymbol::new self.project_declaration
            fi
            index function self.project_variables
        done
        for
            entry in self
                .store
                .structs
                .iter
        do
            if entry.first imported_types.has then
                continue
            fi
            index std::Option[common::Location]::None entry.second.location entry.first.as_str
            DocumentSymbolKind::Struct ProjectionSymbol::new self.project_declaration
        done
        for
            entry in self
                .store
                .enums
                .iter
        do
            if entry.first imported_types.has then
                continue
            fi
            index std::Option[common::Location]::None entry.second.location entry.first.as_str
            DocumentSymbolKind::Enum ProjectionSymbol::new self.project_declaration
            for
                variant in entry
                    .second
                    .variant_locations
                    .iter
            do
                index std::Option[common::Location]::None variant.second variant.first.as_str
                DocumentSymbolKind::EnumVariant ProjectionSymbol::new self.project_declaration
            done
        done
        for
            entry in self
                .store
                .traits
                .iter
        do
            if entry.first imported_types.has then
                continue
            fi
            index std::Option[common::Location]::None entry.second.location entry.first.as_str
            DocumentSymbolKind::Trait ProjectionSymbol::new self.project_declaration
        done
    }

    # Written type names that resolve to a struct, enum, or trait answer definition and
    # references. They omit hover text, which would copy the declaration's hover to
    # every use. Variant names in patterns also answer hover with the short
    # `Enum::Variant` text of a variant expression. Body occurrences come first, so
    # they keep any position both claim.
    fn project_type_references
        self:$IndexBuilder
        index:mut$EditorIndex
        imported_files:$std::Set[std::String]
    {
        for
            reference in self
                .store
                .type_references
                .iter
        do
            if reference.location.file imported_files.has then
                continue
            fi
            std::Option[std::String]::None = hover
            if reference.variant std::Option::Some(variant) is then
                variant reference.name.as_str self.find_variant_symbol
                reference
                    .location
                    .file
                    .as_str reference.name.as_str self.store.format_name_for_source = enum_name
                f"{enum_name}::{variant}" std::Option::Some = hover
            else
                reference.name.as_str self.find_type_symbol
            fi = symbol
            if symbol std::Option::Some(identity) is then
                reference.location.span = span
                span.length span.offset false identity.project std::Option::Some
                identity.declaration self.locate std::Option::Some
                hover
                reference.location self.locate
                Occurrence index.occurrences.push
            fi
        done
    }

    fn project_file self:mut$IndexBuilder file:$std::String index:mut$EditorIndex {
        file.clone = self.file_path
        file self
            .sources
            .sources
            .get
            .unwrap
            .clone = self.source
        self.source.length 1 + 0 file.clone DocumentLocation = file_range
        file_range.clone index.files.push
        "" 1 1 common::SourcePosition self.find_completion_candidates file_range
        CompletionScope index.completions.push
        self.file_path.as_str self.source.as_str lexer::lex_source.into_parts = lexical_diagnostics = lexical_tokens
        lexical_tokens self.collect_source_declarations
        self.find_semantic_tokens index.tokens.append
        for token in lexical_tokens.iter do
            index token self.project_lexical_token
            index token self.project_completion_triggers
        done
    }

    # Files and declarations in `imports` keep the facts the import stage projected.
    fn project
        self:IndexBuilder
        coverage:std::Option[QueryReason]
        imports:$ImportIndex
    -> EditorIndex lexer::SourceStore error::Diagnostics {
        coverage EditorIndex::new = index
        index self.project_failures
        for
            file in self
                .sources
                .sources
                .keys
                .iter
        do
            if file imports.files.has ! then
                index file self.project_file
            fi
        done
        imports.types imports.functions index self.project_facts
        imports.files index self.project_type_references
        imports.bindings index self.project_bindings
        imports.index index.append_copy
        # Move the retained text and index. The temporary compiler maps are destroyed here.
        self match
            IndexBuilder { sources: sources diagnostics: diagnostics } => index sources diagnostics
        end
    }

    fn project_completion_triggers
        self:mut$IndexBuilder
        token:$common::Token
        index:mut$EditorIndex
    {
        if token.kind common::TokenKind::Identifier != token.kind common::TokenKind::Delimiter != && then
            return
        fi
        token
            .location
            .span
            .offset = offset
        offset token
            .location
            .span
            .length + = end_offset
        # The lexer consumes a trailing :: even when it cannot find a member name.
        if token.kind common::TokenKind::Identifier == self.source.length end_offset 2 + >= && then
            if
                ':' end_offset self
                    .source
                    .at
                    .unwrap == ':' end_offset 1 + self
                    .source
                    .at
                    .unwrap == &&
            then
                2 += end_offset
            fi
        fi
        while end_offset offset > do
            offset self
                .source
                .at
                .unwrap = character
            1 += offset
            if '.' character == ':' character == || then
                offset self.find_triggered_completion_candidates
                1 offset self.file_path.clone DocumentLocation CompletionScope index.triggers.push
            fi
        done
    }
}

impl EditorIndex {
    fn new coverage:std::Option[QueryReason] -> EditorIndex {
        EditorIndex {
            files: std::List[DocumentLocation]::new
            occurrences: std::List[Occurrence]::new
            tokens: std::List[DocumentToken]::new
            completions: std::List[CompletionScope]::new
            scopes: std::List[CompletionScope]::new
            triggers: std::List[CompletionScope]::new
            coverage: coverage
            unavailable: std::List[CoverageRegion]::new
            words: std::List[DocumentLocation]::new
            bodies: std::List[DocumentLocation]::new
        }
    }

    # Root-stage facts come first, so they win ties in `find_occurrence`.
    fn append_copy self:mut$EditorIndex other:$EditorIndex {
        other.files.clone self.files.append
        other.occurrences.clone self.occurrences.append
        other.tokens.clone self.tokens.append
        other.completions.clone self.completions.append
        other.scopes.clone self.scopes.append
        other.triggers.clone self.triggers.append
        other.unavailable.clone self.unavailable.append
        other.words.clone self.words.append
        other.bodies.clone self.bodies.append
    }

    fn contains self:$EditorIndex file:$str offset:u64 -> bool {
        for range in self.files.iter do
            if offset file range.contains then
                true return
            fi
        done
        false
    }

    fn find_occurrence self:$EditorIndex file:$str offset:u64 -> std::Option[u64] {
        std::Option[u64]::None = best
        0 = index: u64
        while index self.occurrences.length < do
            index self.occurrences.get = occurrence
            index = current
            1 += index
            if offset file occurrence.location.contains ! then
                continue
            fi
            if best std::Option::Some(previous) is then
                previous copy self.occurrences.get = previous_occurrence
                if previous_occurrence.declaration then
                    continue
                fi
                if
                    occurrence.declaration ! previous_occurrence.location.length occurrence.location.length <= &&
                then
                    continue
                fi
            fi
            current std::Option::Some = best
        done
        best
    }

    pub fn find_hover self:$EditorIndex file:$str offset:u64 -> PointAnswer[DocumentHover] {
        if offset file self.contains ! then
            QueryReason::InvalidInput PointAnswer[DocumentHover]::Unavailable return
        fi
        if offset file self.find_occurrence std::Option::Some(index) is then
            index copy self.occurrences.get = occurrence
            if occurrence.hover std::Option::Some(content) is then
                occurrence.location.clone content.clone DocumentHover PointAnswer::Known return
            fi
            PointAnswer[DocumentHover]::Absent return
        fi
        if offset file self.find_unavailable_reason std::Option::Some(reason) is then
            reason copy PointAnswer[DocumentHover]::Unavailable
        else
            PointAnswer[DocumentHover]::Absent
        fi
    }

    pub fn find_definition self:$EditorIndex file:$str offset:u64 -> PointAnswer[DocumentLocation] {
        if offset file self.contains ! then
            QueryReason::InvalidInput PointAnswer[DocumentLocation]::Unavailable return
        fi
        if offset file self.find_occurrence std::Option::Some(index) is then
            index copy self.occurrences.get = occurrence
            if occurrence.definition std::Option::Some(location) is then
                location.clone PointAnswer::Known return
            fi
            PointAnswer[DocumentLocation]::Absent return
        fi
        if offset file self.find_unavailable_reason std::Option::Some(reason) is then
            reason copy PointAnswer[DocumentLocation]::Unavailable
        else
            PointAnswer[DocumentLocation]::Absent
        fi
    }

    pub fn find_candidates
        self:$EditorIndex
        file:$str
        offset:u64
        trigger:$str
    -> ListAnswer[CompletionCandidate] {
        if offset file self.contains ! then
            QueryReason::InvalidInput ListAnswer[CompletionCandidate]::Unavailable return
        fi
        std::List[CompletionCandidate]::new = items
        if trigger "." == trigger ":" == || then
            for scope in self.triggers.iter do
                if offset file scope.location.contains then
                    scope.items.clone = items
                    break
                fi
            done
        else
            for scope in self.completions.iter do
                if offset file scope.location.contains then
                    scope.items.clone items.append
                fi
            done
            for scope in self.scopes.iter do
                if offset file scope.location.contains then
                    scope.items.clone items.append
                fi
            done
        fi
        if offset file self.find_completion_coverage std::Option::Some(reason) is then
            reason copy items ListAnswer::Incomplete
        else
            items ListAnswer::Complete
        fi
    }

    pub fn find_references
        self:$EditorIndex
        file:$str
        offset:u64
        include_declaration:bool
    -> ReferenceAnswer {
        if offset file self.contains ! then
            QueryReason::InvalidInput ReferenceAnswer::Unavailable return
        fi
        if offset file self.find_occurrence std::Option::Some(selected) is else
            QueryReason::MissingSemanticFact ReferenceAnswer::Unavailable return
        fi
        selected self.occurrences.get = occurrence
        if occurrence.symbol.clone std::Option::Some(symbol) is else
            QueryReason::MissingSemanticFact ReferenceAnswer::Unavailable return
        fi
        std::List[DocumentLocation]::new = ranges
        if include_declaration "" symbol.declaration.file != && then
            symbol
                .declaration
                .span
                .length symbol
                .declaration
                .span
                .offset symbol
                .declaration
                .file
                .clone
            DocumentLocation ranges.push
        fi
        ranges include_declaration symbol self.collect_references
        &DocumentLocation::comes_before ranges.sort_by
        std::List[DocumentLocation]::new = unique
        for range in ranges.iter do
            if 0 unique.length != then
                if range unique.length 1 - unique.get.matches then
                    continue
                fi
            fi
            range.clone unique.push
        done
        std::List[std::String]::new = files
        for range in self.files.iter do
            range.file.clone files.push
        done
        DocumentReferences {
            ranges: unique
            declaration: symbol
                .declaration
                .span
                .length symbol
                .declaration
                .span
                .offset symbol
                .declaration
                .file
                .clone DocumentLocation
            files: files
            rename_requires_workspace: symbol.owner.is_none
        } = result
        if symbol self.find_reference_coverage std::Option::Some(reason) is then
            reason copy result ReferenceAnswer::Incomplete
        else
            result ReferenceAnswer::Complete
        fi
    }

    fn collect_references
        self:$EditorIndex
        symbol:$DocumentSymbol
        include_declaration:bool
        ranges:mut$std::List[DocumentLocation]
    {
        for occurrence in self.occurrences.iter do
            if occurrence.declaration include_declaration ! && then
                continue
            fi
            if occurrence.symbol.is_none then
                continue
            fi
            occurrence
                .symbol
                .clone
                .unwrap = candidate
            if candidate symbol.matches_identity ! then
                continue
            fi
            occurrence.location.clone = range
            occurrence.reference_offset = range.offset
            occurrence.reference_length = range.length
            range ranges.push
        done
    }

    pub fn find_semantic_tokens self:$EditorIndex file:$str -> ListAnswer[DocumentToken] {
        if 0 file self.contains ! then
            QueryReason::InvalidInput ListAnswer[DocumentToken]::Unavailable return
        fi
        std::List[DocumentToken]::new = tokens
        for token in self.tokens.iter do
            if token.location.file file == then
                token.clone tokens.push
            fi
        done
        &DocumentToken::comes_before tokens.sort_by
        std::List[DocumentToken]::new = unique
        0 = end_offset: u64
        for token in tokens.iter do
            if end_offset token.location.offset > then
                continue
            fi
            token.location.offset token.location.length + = end_offset
            token.clone unique.push
        done
        if file self.find_file_coverage std::Option::Some(reason) is then
            reason copy unique ListAnswer::Incomplete
        else
            unique ListAnswer::Complete
        fi
    }
}

fn index_visible_bindings
    bindings:$binding::BindingStore
-> std::Map[std::String std::Map[std::String std::List[u64]]] {
    std::Map[std::String std::Map[std::String std::List[u64]]]::new = files
    0 = index: u64
    for binding in bindings.declarations.iter do
        if binding.verified then
            binding.visibility.file = file
            if file.as_str files.has_str ! then
                std::Map[std::String std::List[u64]]::new file.clone files.set
            fi
            file.as_str files.get_mut_str.unwrap = names
            if binding.name.as_str names.has_str ! then
                std::List[u64]::new binding.name.clone names.set
            fi
            index binding.name.as_str names
                .get_mut_str
                .unwrap
                .push
        fi
        1 += index
    done
    files
}

# Imported-file facts and the import-stage names that produced them.
pub struct ImportIndex {
    index:     EditorIndex
    files:     std::Set[std::String]
    functions: std::Set[std::String]
    types:     std::Set[std::String]
    bindings:  u64
}

impl ImportIndex {
    fn empty -> ImportIndex {
        ImportIndex {
            index: std::Option[QueryReason]::None EditorIndex::new
            files: std::Set[std::String]::new
            functions: std::Set[std::String]::new
            types: std::Set[std::String]::new
            bindings: 0
        }
    }
}

# Project every imported file once. `sources` holds the imported files only.
pub fn project_imports
    checked:typechecker::TypecheckResult
    sources:lexer::SourceStore
-> ImportIndex {
    sources.sources.keys common::string_list_to_set = files
    "".to_str error::Diagnostics::new sources checked std::Option::Some IndexBuilder::new = builder
    builder.store.get_function_names common::string_list_to_set = functions
    builder
        .store
        .structs
        .keys common::string_list_to_set = types
    for
        name in builder
            .store
            .enums
            .keys
            .iter
    do
        name.clone types.add
    done
    for
        name in builder
            .store
            .traits
            .keys
            .iter
    do
        name.clone types.add
    done
    builder
        .bindings
        .declarations
        .length = bindings
    ImportIndex::empty = none
    none std::Option[QueryReason]::None builder.project = diagnostics = sources = index
    bindings types functions files index ImportIndex
}

# Project root-stage facts beside imported-file facts from `imports`.
pub fn project_index_with_imports
    checked:std::Option[typechecker::TypecheckResult]
    sources:lexer::SourceStore
    diagnostics:error::Diagnostics
    root_file:std::String
    imports:$ImportIndex
-> EditorIndex lexer::SourceStore error::Diagnostics {
    diagnostics find_coverage = coverage
    root_file.as_str sources.retain_used
    imports coverage root_file diagnostics sources checked IndexBuilder::new.project
}

fn find_coverage diagnostics:$error::Diagnostics -> std::Option[QueryReason] {
    std::Option[QueryReason]::None = coverage
    for diagnostic in diagnostics.entries.iter do
        if diagnostic error::Diagnostic::Error(failure) is then
            failure classify_query_failure std::Option::Some = coverage
        fi
    done
    coverage
}

pub fn project_index
    checked:std::Option[typechecker::TypecheckResult]
    sources:lexer::SourceStore
    diagnostics:error::Diagnostics
    root_file:std::String
-> EditorIndex lexer::SourceStore error::Diagnostics {
    ImportIndex::empty = none
    none root_file diagnostics sources checked project_index_with_imports
}

struct CoverageRegion derives std::Clone {
    location: DocumentLocation
    reason:   QueryReason
}

fn classify_query_failure failure:$error::CasaError -> QueryReason {
    if failure.message.as_str "not found, searched:" str::contains then
        QueryReason::UnresolvedDependency return
    fi
    if
        failure.kind common::ErrorKind::Syntax == failure.kind common::ErrorKind::UnexpectedToken == || failure.kind common::ErrorKind::UnmatchedBlock == ||
    then
        QueryReason::RejectedSyntax return
    fi
    QueryReason::MissingSemanticFact
}

impl EditorIndex {
    fn find_unavailable_reason self:$EditorIndex file:$str offset:u64 -> std::Option[QueryReason] {
        for region in self.unavailable.iter do
            if offset file region.location.contains then
                region.reason std::Option::Some return
            fi
            if region.location.file file != then
                continue
            fi
            if region.reason QueryReason::MissingSemanticFact != then
                if region.location.offset offset <= then
                    region.reason std::Option::Some return
                fi
            fi
        done
        std::Option[QueryReason]::None
    }

    fn find_file_coverage self:$EditorIndex file:$str -> std::Option[QueryReason] {
        for region in self.unavailable.iter do
            if region.location.file file == then
                region.reason std::Option::Some return
            fi
        done
        std::Option[QueryReason]::None
    }
}

impl CompletionCandidate {
    fn get_insertion_text self:$CompletionCandidate -> std::String {
        self match
            CompletionCandidate::Function(name) => name.clone
            CompletionCandidate::Variable(variable _) => variable.name.clone
            CompletionCandidate::Keyword(keyword) => keyword.format_source.to_str
            CompletionCandidate::Intrinsic(intrinsic) => intrinsic.format_source.to_str
            CompletionCandidate::Struct(declaration _) => declaration.name.clone
            CompletionCandidate::Enum(name) => name.clone
            CompletionCandidate::EnumVariant(name) => name.clone
            CompletionCandidate::Method(name) => name.as_str "::" str::split.unwrap.pop
        end
    }
}

impl EditorIndex {
    fn find_replacement self:$EditorIndex file:$str offset:u64 -> DocumentLocation {
        for word in self.words.iter do
            if word.file file != then
                continue
            fi
            if word.offset offset <= word.offset word.length + offset >= && then
                word.clone return
            fi
        done
        0 offset file.to_str DocumentLocation
    }

    pub fn find_completions
        self:$EditorIndex
        file:$str
        offset:u64
        trigger:$str
    -> ListAnswer[DocumentCompletion] {
        std::List[CompletionCandidate]::new = candidates
        std::Option[QueryReason]::None = reason
        trigger offset file self.find_candidates match
            ListAnswer::Complete(items) => items = candidates
            ListAnswer::Incomplete(items missing) => {
                items = candidates
                missing std::Option::Some = reason
            }
            ListAnswer::Unavailable(missing) => missing ListAnswer[DocumentCompletion]::Unavailable return
        end
        offset file self.find_replacement = replacement
        std::List[DocumentCompletion]::new = result
        for candidate in candidates.iter do
            replacement.clone candidate.get_insertion_text candidate.clone DocumentCompletion result.push
        done
        if reason std::Option::Some(missing) is then
            missing result ListAnswer::Incomplete
        else
            result ListAnswer::Complete
        fi
    }
}

impl EditorIndex {
    fn find_reference_coverage
        self:$EditorIndex
        symbol:$DocumentSymbol
    -> std::Option[QueryReason] {
        if symbol.owner std::Option::Some(owner) is then
            for body in self.bodies.iter do
                if body.file owner.file != body.offset owner.span.offset != || then
                    continue
                fi
                body self.find_region_coverage return
            done
        fi
        self.coverage.clone
    }

    fn find_region_coverage self:$EditorIndex range:$DocumentLocation -> std::Option[QueryReason] {
        for region in self.unavailable.iter do
            if
                region.location.offset region
                    .location
                    .file
                    .as_str range.contains
            then
                region.reason std::Option::Some return
            fi
        done
        std::Option[QueryReason]::None
    }
}

impl EditorIndex {
    fn find_completion_coverage self:$EditorIndex file:$str offset:u64 -> std::Option[QueryReason] {
        for region in self.unavailable.iter do
            if region.location.file file == region.reason QueryReason::MissingSemanticFact != && then
                region.reason std::Option::Some return
            fi
        done
        offset file self.find_unavailable_reason
    }
}

impl EditorIndex {
    pub fn is_incomplete self:$EditorIndex -> bool { self.coverage.is_some }

    pub fn find_symbol_identity
        self:$EditorIndex
        file:$str
        offset:u64
    -> std::Option[DocumentSymbol] {
        if offset file self.find_occurrence std::Option::Some(index) is then
            index copy self
                .occurrences
                .get
                .symbol
                .clone return
        fi
        std::Option[DocumentSymbol]::None
    }
}

impl IndexBuilder {
    fn find_binding_symbol
        self:$IndexBuilder
        operation:$ProjectionOperation
    -> std::Option[ProjectionSymbol] {
        if operation.identity self.bindings.find_reference std::Option::Some(binding) is then
            binding.owner.clone binding.declaration binding.name.as_str
            DocumentSymbolKind::Variable ProjectionSymbol::new std::Option::Some return
        fi
        std::Option[ProjectionSymbol]::None
    }

    fn find_binding_definition
        self:$IndexBuilder
        operation:$ProjectionOperation
    -> std::Option[common::Location] {
        if operation.identity self.bindings.find_reference std::Option::Some(binding) is then
            binding.declaration.clone std::Option::Some return
        fi
        std::Option[common::Location]::None
    }

    fn find_variable_type self:$IndexBuilder name:$str offset:u64 -> std::Option[common::Type] {
        if self.file_path.as_str self.visible_bindings.get_str std::Option::Some(names) is then
            if name names.get_str std::Option::Some(indexes) is then
                for index in indexes.iter do
                    index copy self
                        .bindings
                        .declarations
                        .get = binding
                    if offset self.file_path.as_str binding.visibility self.locate.contains then
                        binding.typ.clone std::Option::Some return
                    fi
                done
            fi
        fi
        std::Option[common::Type]::None
    }

    fn project_bindings self:$IndexBuilder index:mut$EditorIndex first:u64 {
        for
            binding in first self
                .bindings
                .declarations
                .iter
                .skip
        do
            if binding.verified ! then
                continue
            fi
            binding.owner.clone binding.declaration binding.name.as_str
            DocumentSymbolKind::Variable ProjectionSymbol::new = symbol
            binding
                .declaration
                .file
                .as_str binding.typ self.store.format_type_for_source = type_name
            f"{binding.name}: {type_name}" = hover
            if binding.borrow_sources std::Option::Some(sources) is then
                "\n" hover.append
                sources.as_str hover.append
            fi
            binding
                .declaration
                .span
                .length binding
                .declaration
                .span
                .offset true
            symbol.project std::Option::Some binding.declaration self.locate std::Option::Some
            hover std::Option::Some binding.declaration self.locate Occurrence index.occurrences.push
            for alternative in binding.alternative_declarations.iter do
                if alternative binding.declaration.matches then
                    continue
                fi
                alternative.span.length alternative.span.offset true
                symbol.project std::Option::Some binding.declaration self.locate std::Option::Some
                f"{binding.name}: {type_name}" std::Option::Some alternative self.locate
                Occurrence index.occurrences.push
            done
            std::List[CompletionCandidate]::new = items
            type_name.clone binding.typ.clone binding.name.clone common::Variable CompletionCandidate::Variable items.push
            binding.visibility self.locate = visibility
            if visibility.file.as_str self.sources.get std::Option::Some(source) is then
                source.length 1 + visibility.offset - = remaining
                if remaining visibility.length < then
                    remaining = visibility.length
                fi
            fi
            items visibility CompletionScope index.scopes.push
        done
    }
}
