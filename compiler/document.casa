            OpValue::PushVar(name) => element.containing_function name.as_str self.find_variable_symbol
            OpValue::PushCapture(name) => element.containing_function name.as_str self.find_variable_symbol
            OpValue::AssignVar(name) => element.containing_function name.as_str self.find_variable_symbol
            OpValue::AssignInc(name) => element.containing_function name.as_str self.find_variable_symbol
            OpValue::AssignDec(name) => element.containing_function name.as_str self.find_variable_symbol
            _ => Option[DocumentSymbol]::None
        end
