# Immutable backing for compiler values with frequent clones.
import "std" as std

# SAFETY: address is live backing whose first word is a positive u64 count.
# The caller retains a reference and serializes all count changes.
pub unsafe fn retain address:ptr -> ptr {
    unsafe { address load64 1 + address store64 }
    address
}
# SAFETY: A non-null address owns one reference to backing whose first word is
# a positive u64 count. The caller serializes count changes. True transfers
# final ownership to the caller, which must destroy the backing exactly once.
pub unsafe fn release address:ptr -> bool {
    if ptr::null address == then
        false return
    fi
    unsafe {
        address load64 1 - = remaining
        remaining address store64
        0 remaining ==
    }
}

pub struct Shared[T] {
    address: ptr
}

struct Storage[T] {
    references: u64
    value:      T
}

impl[T] Shared[T] {
    pub fn new value:T -> Shared[T] {
        # SAFETY: One handle owns the new backing until its final drop.
        unsafe { value 1 Storage ptr::into_raw Shared }
    }

    pub fn get self:$Shared[T] -> $T {
        # SAFETY: The handle retains immutable backing for the returned borrow.
        unsafe { self.address ptr::as_ref[Storage[T]].value }
    }

    pub fn drop self:mut$Shared[T] {
        # SAFETY: The handle owns one reference to Storage[T]. A final
        # release transfers the complete backing for typed destruction.
        unsafe {
            if self.address release then
                self.address ptr::from_raw[Storage[T]] drop
            fi
        }
        ptr::null = self.address
    }
}

impl[T] Shared[T]: std::Clone {
    pub fn clone self:$Shared[T] -> Shared[T] {
        # SAFETY: The shared handle retains the backing during this count change.
        unsafe { self.address retain Shared }
    }
}
