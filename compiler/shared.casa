# Immutable backing for compiler values with frequent clones.
import "std" as std

pub struct Shared[T] {
    address: ptr
}

struct Storage[T] {
    references: u64
    value:      T
}

impl[T] Shared[T] {
    pub fn new value:T -> Shared[T] {
        # SAFETY: One handle owns the new backing until its final drop.
        unsafe { value 1 Storage ptr::into_raw Shared }
    }

    pub fn get self:$Shared[T] -> $T {
        # SAFETY: The handle retains immutable backing for the returned borrow.
        unsafe { self.address ptr::as_ref[Storage[T]].value }
    }

    pub fn drop self:mut$Shared[T] {
        if ptr::null self.address == then
            return
        fi
        # SAFETY: Only the count is mutated. The last handle releases the
        # backing and its value. Construction cannot create reference cycles.
        unsafe {
            self.address load64 1 - = remaining
            remaining self.address store64
            if 0 remaining == then
                self.address ptr::from_raw[Storage[T]] drop
            fi
            ptr::null = self.address
        }
    }
}

impl[T] Shared[T]: std::Clone {
    pub fn clone self:$Shared[T] -> Shared[T] {
        # SAFETY: Compiler requests access their values on one thread. Cloning
        # changes only the count and retains immutable backing for both handles.
        unsafe {
            self.address load64 1 + self.address store64
            self.address Shared
        }
    }
}
