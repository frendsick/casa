# Phase-independent meaning for resolved operations.
import "std"
import "common"

fn collect_trait_methods_into
    seen:Set[str]
    result:List[TraitMethod]
    store:SymbolStore
    trait_def:CasaTrait
-> Set[str] {
    for method in trait_def.methods.iter do
        if method.name seen.has ! then
            method.name seen.add = seen
            method result.push
        fi
    done
    for supertrait in trait_def.supertraits.iter do
        if supertrait.name store.traits.get Option::Some(supertrait_def) is then
            supertrait_def store result seen collect_trait_methods_into = seen
        fi
    done
    seen
}

fn collect_trait_methods store:SymbolStore trait_def:CasaTrait -> List[TraitMethod] {
    List::new(List[TraitMethod]) = result
    Set::new(Set[str]) = seen
    trait_def store result seen collect_trait_methods_into drop
    result
}

enum MethodSemanticsKind {
    Function
    TraitBound
    DefaultMethod
}

struct MethodSemantics {
    kind:          MethodSemanticsKind
    function_name: str
    trait_name:    str
    method_name:   str
    stack_effect:  StackEffect
}

struct OperationSemanticsResult {
    stack_effect:           Option[StackEffect]
    resolved_operation:     Option[OpValue]
    method:                 Option[MethodSemantics]
    dependencies:           List[str]
    syscall_argument_count: Option[int]
    word_parameter_start:   int
    word_parameter_count:   int
}

impl OperationSemanticsResult {
    fn new -> OperationSemanticsResult {
        0
        0
        Option::None(Option[int])
        List::new(List[str])
        Option::None(Option[MethodSemantics])
        Option::None(Option[OpValue])
        Option::None(Option[StackEffect])
        OperationSemanticsResult
    }
}

fn make_operation_stack_effect
    parameters:List[Parameter]
    return_types:List[Type]
    type_variables:List[str]
-> StackEffect {
    return_types parameters StackEffect::new = effect
    for type_variable in type_variables.iter do
        type_variable effect.type_vars.add = effect.type_vars
    done
    effect
}

fn add_parameter parameters:List[Parameter] typ:Type {
    typ Parameter::new parameters.push
}

fn add_named_parameter parameters:List[Parameter] typ:Type name:str {
    name typ Parameter::named parameters.push
}

fn operation_is_comparison operation:OpValue -> bool {
    operation match
        OpValue::Eq => true
        OpValue::Ne => true
        OpValue::Lt => true
        OpValue::Le => true
        OpValue::Gt => true
        OpValue::Ge => true
        _ => false
    end
}

fn operation_is_load operation:OpValue -> bool {
    operation match
        OpValue::Load8 => true
        OpValue::Load16 => true
        OpValue::Load32 => true
        OpValue::Load64 => true
        _ => false
    end
}

fn operation_is_store operation:OpValue -> bool {
    operation match
        OpValue::Store8 => true
        OpValue::Store16 => true
        OpValue::Store32 => true
        OpValue::Store64 => true
        _ => false
    end
}

fn operation_is_memory operation:OpValue -> bool {
    if operation operation_is_load then true return fi
    if operation operation_is_store then true return fi
    operation OpValue::HeapAlloc is
}

fn fixed_operation_stack_effect operation:OpValue -> Option[StackEffect] {
    List::new(List[Type]) = return_types
    List::new(List[Parameter]) = parameter_types
    List::new(List[str]) = type_variables
    "T" Type::TypeVar = type_t
    "U" Type::TypeVar = type_u
    false = handled

    if operation operation_is_comparison then
        type_t parameter_types add_parameter
        type_t parameter_types add_parameter
        TYPE_BOOL_T return_types.push
        "T" type_variables.push
        type_variables return_types parameter_types make_operation_stack_effect Option::Some
        return
    fi
    if operation operation_is_load then
        TYPE_PTR_T parameter_types add_parameter
        TYPE_INT_T return_types.push
        type_variables return_types parameter_types make_operation_stack_effect Option::Some
        return
    fi
    if operation operation_is_store then
        TYPE_PTR_T parameter_types add_parameter
        type_t parameter_types add_parameter
        "T" type_variables.push
        type_variables return_types parameter_types make_operation_stack_effect Option::Some
        return
    fi

    operation match
        OpValue::PushInt(_) => { TYPE_INT_T return_types.push true = handled }
        OpValue::PushStr(_) => { TYPE_STR_T return_types.push true = handled }
        OpValue::PushBool(_) => { TYPE_BOOL_T return_types.push true = handled }
        OpValue::PushChar(_) => { TYPE_CHAR_T return_types.push true = handled }
        OpValue::Argc => { TYPE_INT_T return_types.push true = handled }
        OpValue::Argv => { TYPE_PTR_T return_types.push true = handled }
        OpValue::Envp => { TYPE_PTR_T return_types.push true = handled }
        OpValue::Mul => {
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T return_types.push
            true = handled
        }
        OpValue::Div => {
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T return_types.push
            true = handled
        }
        OpValue::Mod => {
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T return_types.push
            true = handled
        }
        OpValue::BitAnd => {
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T return_types.push
            true = handled
        }
        OpValue::BitOr => {
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T return_types.push
            true = handled
        }
        OpValue::BitXor => {
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T return_types.push
            true = handled
        }
        OpValue::Add => {
            TYPE_INT_T parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::Sub => {
            TYPE_INT_T parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::Shl => {
            TYPE_INT_T parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::Shr => {
            TYPE_INT_T parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::And => {
            type_t parameter_types add_parameter
            type_u parameter_types add_parameter
            TYPE_BOOL_T return_types.push
            "T" type_variables.push
            "U" type_variables.push
            true = handled
        }
        OpValue::Or => {
            type_t parameter_types add_parameter
            type_u parameter_types add_parameter
            TYPE_BOOL_T return_types.push
            "T" type_variables.push
            "U" type_variables.push
            true = handled
        }
        OpValue::Not => {
            type_t parameter_types add_parameter
            TYPE_BOOL_T return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::BitNot => {
            TYPE_INT_T parameter_types add_parameter
            TYPE_INT_T return_types.push
            true = handled
        }
        OpValue::Drop => {
            "value for `drop`" type_t parameter_types add_named_parameter
            "T" type_variables.push
            true = handled
        }
        OpValue::Dup => {
            "value for `dup`" type_t parameter_types add_named_parameter
            type_t return_types.push
            type_t return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::Swap => {
            "argument 1 of `swap`" type_t parameter_types add_named_parameter
            "argument 2 of `swap`" type_u parameter_types add_named_parameter
            type_t return_types.push
            type_u return_types.push
            "T" type_variables.push
            "U" type_variables.push
            true = handled
        }
        OpValue::Over => {
            "argument 1 of `over`" type_t parameter_types add_named_parameter
            "argument 2 of `over`" type_u parameter_types add_named_parameter
            type_u return_types.push
            type_t return_types.push
            type_u return_types.push
            "T" type_variables.push
            "U" type_variables.push
            true = handled
        }
        OpValue::Rot => {
            "V" Type::TypeVar = type_v
            "argument 1 of `rot`" type_t parameter_types add_named_parameter
            "argument 2 of `rot`" type_u parameter_types add_named_parameter
            "argument 3 of `rot`" type_v parameter_types add_named_parameter
            type_u return_types.push
            type_t return_types.push
            type_v return_types.push
            "T" type_variables.push
            "U" type_variables.push
            "V" type_variables.push
            true = handled
        }
        OpValue::Print => {
            type_t parameter_types add_parameter
            "T" type_variables.push
            true = handled
        }
        OpValue::PrintBool => { TYPE_BOOL_T parameter_types add_parameter true = handled }
        OpValue::PrintChar => { TYPE_CHAR_T parameter_types add_parameter true = handled }
        OpValue::PrintCstr => { TYPE_CSTR_T parameter_types add_parameter true = handled }
        OpValue::PrintInt => { TYPE_INT_T parameter_types add_parameter true = handled }
        OpValue::PrintStr => { TYPE_STR_T parameter_types add_parameter true = handled }
        OpValue::FstringToStr => {
            type_t parameter_types add_parameter
            TYPE_STR_T return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::FstringConcat(count) => {
            0 = index
            while index count > do
                TYPE_STR_T parameter_types add_parameter
                1 += index
            done
            TYPE_STR_T return_types.push
            true = handled
        }
        OpValue::Typeof => {
            type_t parameter_types add_parameter
            TYPE_STR_T return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::HeapAlloc => {
            TYPE_INT_T parameter_types add_parameter
            TYPE_PTR_T return_types.push
            true = handled
        }
        _ => { }
    end

    if handled ! then Option::None(Option[StackEffect]) return fi
    type_variables return_types parameter_types make_operation_stack_effect Option::Some
}

fn operation_uses_fixed_typecheck_effect operation:OpValue -> bool {
    operation match
        OpValue::PushInt(_) => true
        OpValue::PushStr(_) => true
        OpValue::PushBool(_) => true
        OpValue::PushChar(_) => true
        OpValue::Argc => true
        OpValue::Argv => true
        OpValue::Envp => true
        OpValue::Mul => true
        OpValue::Div => true
        OpValue::Mod => true
        OpValue::BitAnd => true
        OpValue::BitOr => true
        OpValue::BitXor => true
        OpValue::Add => true
        OpValue::Sub => true
        OpValue::Shl => true
        OpValue::Shr => true
        OpValue::And => true
        OpValue::Or => true
        OpValue::Not => true
        OpValue::BitNot => true
        OpValue::Drop => true
        OpValue::Dup => true
        OpValue::Swap => true
        OpValue::Over => true
        OpValue::Rot => true
        OpValue::FstringConcat(_) => true
        _ => false
    end
}

fn operation_syscall_argument_count operation:OpValue -> Option[int] {
    operation match
        OpValue::Syscall0 => 0 Option::Some
        OpValue::Syscall1 => 1 Option::Some
        OpValue::Syscall2 => 2 Option::Some
        OpValue::Syscall3 => 3 Option::Some
        OpValue::Syscall4 => 4 Option::Some
        OpValue::Syscall5 => 5 Option::Some
        OpValue::Syscall6 => 6 Option::Some
        _ => Option::None(Option[int])
    end
}

fn make_syscall_stack_effect argument_count:int -> StackEffect {
    List::new(List[Type]) = return_types
    List::new(List[Parameter]) = parameter_types
    TYPE_INT_T parameter_types add_parameter
    0 = index
    while index argument_count > do
        TYPE_UNKNOWN_T parameter_types add_parameter
        1 += index
    done
    TYPE_INT_T return_types.push
    List::new(List[str]) return_types parameter_types make_operation_stack_effect
}

fn make_function_reference_stack_effect effect:StackEffect -> StackEffect {
    List::new(List[Type]) = return_types
    effect stack_effect_to_function_type return_types.push
    List::new(List[str]) return_types List::new(List[Parameter])
    make_operation_stack_effect
}

impl Type {
    fn make_method_key self:Type method_name:str -> str {
        f"{self.format}::{method_name}"
    }

    fn make_base_method_key self:Type method_name:str -> Option[str] {
        if self.base Option::Some(base) is then
            f"{base}::{method_name}" Option::Some return
        fi
        Option::None(Option[str])
    }
}

fn find_semantic_method_function method_name:str receiver:Type store:SymbolStore -> Option[str] {
    method_name receiver.make_method_key = function_name
    if function_name store.functions.has then function_name Option::Some return fi
    if method_name receiver.make_base_method_key Option::Some(base_name) is then
        if base_name store.functions.has then base_name Option::Some return fi
    fi
    Option::None(Option[str])
}

fn find_semantic_trait_method
    method_name:str
    casa_trait:CasaTrait
    store:SymbolStore
-> Option[TraitMethod] {
    for method in casa_trait store collect_trait_methods.iter do
        if method_name method.name == then method Option::Some return fi
    done
    Option::None(Option[TraitMethod])
}

fn type_has_semantic_trait_shape receiver:Type casa_trait:CasaTrait store:SymbolStore -> bool {
    for method in casa_trait store collect_trait_methods.iter do
        if
        0 method.default_ops.length ==
        store receiver method.name find_semantic_method_function.is_none &&
        then
            false return
        fi
    done
    true
}

fn bind_semantic_type_arguments expected:Type actual:Type bindings:Map[str Type] -> Map[str Type] {
    expected match
        Type::TypeVar(type_variable) => {
            if type_variable bindings.has ! then
                actual type_variable bindings.set = bindings
            fi
        }
        Type::Generic(expected_generic) => {
            if actual Type::Generic(actual_generic) is then
                if expected_generic.base actual_generic.base == then
                    for pair in actual_generic.params.iter expected_generic.params.iter.zip do
                        bindings pair.second pair.first bind_semantic_type_arguments = bindings
                    done
                fi
            fi
        }
        Type::Function(expected_function) => {
            if actual Type::Function(actual_function) is then
                for pair in actual_function.parameters.iter expected_function.parameters.iter.zip do
                    bindings pair.second pair.first bind_semantic_type_arguments = bindings
                done
                actual_function.return_types.iter expected_function.return_types.iter.zip
                = return_type_pairs
                for pair in return_type_pairs do
                    bindings pair.second pair.first bind_semantic_type_arguments = bindings
                done
            fi
        }
        _ => { }
    end
    bindings
}

fn make_bound_substitutions bound:TraitBound casa_trait:CasaTrait -> Map[str Type] {
    Map::new(Map[str Type]) = substitutions
    if bound.type_args.length casa_trait.type_params.length == then
        for pair in bound.type_args.iter casa_trait.type_params.iter.zip do
            pair.second pair.first substitutions.set = substitutions
        done
    fi
    substitutions
}

fn infer_default_method_substitutions
    receiver:Type
    casa_trait:CasaTrait
    store:SymbolStore
-> Map[str Type] {
    Map::new(Map[str Type]) = substitutions
    for trait_method in casa_trait.methods.iter do
        if 0 trait_method.default_ops.length != then continue fi
        store receiver trait_method.name find_semantic_method_function = function_opt
        if function_opt Option::Some(function_name) is then
            if function_name store.functions.get Option::Some(function) is then
                receiver trait_method.stack_effect resolve_trait_stack_effect = expected_effect
                function.stack_effect.return_types.iter expected_effect.return_types.iter.zip
                = return_type_pairs
                for pair in return_type_pairs do
                    substitutions pair.second pair.first bind_semantic_type_arguments
                    = substitutions
                done
            fi
        fi
    done
    substitutions
}

fn collect_trait_implementation_dependencies
    receiver:Type
    casa_trait:CasaTrait
    store:SymbolStore
-> List[str] {
    List::new(List[str]) = dependencies
    for method in casa_trait store collect_trait_methods.iter do
        if 0 method.default_ops.length != then continue fi
        store receiver method.name find_semantic_method_function = function_opt
        if function_opt Option::Some(function_name) is then
            function_name dependencies.push
        fi
    done
    dependencies
}

fn collect_bound_semantic_dependencies
    effect:StackEffect
    bindings:Map[str Type]
    store:SymbolStore
-> List[str] {
    List::new(List[str]) = dependencies
    for type_variable in effect.trait_bounds.keys.iter do
        if type_variable bindings.get Option::Some(receiver) is then
            type_variable effect.trait_bounds.get.unwrap = bound
            if bound.name store.traits.get Option::Some(casa_trait) is then
                bound.name dependencies.push
                store casa_trait receiver collect_trait_implementation_dependencies
                = implementations
                for implementation in implementations.iter do
                    implementation dependencies.push
                done
            fi
        fi
    done
    dependencies
}

fn make_method_semantics
    kind:MethodSemanticsKind
    function_name:str
    trait_name:str
    method_name:str
    stack_effect:StackEffect
-> MethodSemantics {
    stack_effect method_name trait_name function_name kind MethodSemantics
}

fn resolve_bound_method_semantics
    method_name:str
    receiver:Type
    function:Function
    store:SymbolStore
-> Option[MethodSemantics] {
    if receiver Type::TypeVar(type_variable) is then
        if type_variable function.stack_effect.trait_bounds.get Option::Some(bound) is then
            if bound.name store.traits.get Option::Some(casa_trait) is then
                store casa_trait method_name find_semantic_trait_method = trait_method_opt
                if trait_method_opt Option::Some(method) is then
                    casa_trait bound make_bound_substitutions = substitutions
                    receiver method.stack_effect resolve_trait_stack_effect = resolved_effect
                    substitutions resolved_effect apply_type_subs_to_stack_effect = resolved_effect
                    f"__trait_{type_variable}_{method_name}" = hidden_name
                    resolved_effect method_name bound.name hidden_name
                    MethodSemanticsKind::TraitBound
                    make_method_semantics Option::Some return
                fi
            fi
        fi
    fi
    Option::None(Option[MethodSemantics])
}

fn resolve_default_method_semantics
    method_name:str
    receiver:Type
    store:SymbolStore
-> Option[MethodSemantics] {
    for trait_name in store.traits.keys.iter do
        trait_name store.traits.get.unwrap = casa_trait
        store casa_trait method_name find_semantic_trait_method = trait_method_opt
        if trait_method_opt Option::Some(method) is then
            store casa_trait receiver type_has_semantic_trait_shape = has_trait_shape
            if 0 method.default_ops.length != has_trait_shape && then
                store casa_trait receiver infer_default_method_substitutions = substitutions
                receiver method.stack_effect resolve_trait_stack_effect = resolved_effect
                substitutions resolved_effect apply_type_subs_to_stack_effect = resolved_effect
                method_name receiver.make_method_key = function_name
                if method_name receiver.make_base_method_key Option::Some(base_name) is then
                    base_name = function_name
                fi
                resolved_effect method_name trait_name function_name
                MethodSemanticsKind::DefaultMethod
                make_method_semantics Option::Some return
            fi
        fi
    done
    Option::None(Option[MethodSemantics])
}

fn resolve_method_semantics
    method_name:str
    receiver:Type
    function_opt:Option[Function]
    store:SymbolStore
-> Option[MethodSemantics] {
    if function_opt Option::Some(function) is then
        store function receiver method_name resolve_bound_method_semantics = bound_method_opt
        if bound_method_opt Option::Some(method) is then
            method Option::Some return
        fi
    fi
    if store receiver method_name find_semantic_method_function Option::Some(function_name) is then
        function_name store.functions.get.unwrap.stack_effect = effect
        effect method_name "" function_name MethodSemanticsKind::Function
        make_method_semantics Option::Some return
    fi
    store receiver method_name resolve_default_method_semantics
}

fn primitive_print_operation receiver:Type -> Option[OpValue] {
    receiver.format match
        "str" => OpValue::PrintStr Option::Some
        "bool" => OpValue::PrintBool Option::Some
        "char" => OpValue::PrintChar Option::Some
        "cstr" => OpValue::PrintCstr Option::Some
        "int" => OpValue::PrintInt Option::Some
        _ => Option::None(Option[OpValue])
    end
}

fn comparison_method_name operation:OpValue -> str {
    operation match
        OpValue::Eq => "eq"
        OpValue::Ne => "ne"
        OpValue::Lt => "lt"
        OpValue::Le => "le"
        OpValue::Gt => "gt"
        _ => "ge"
    end
}

fn comparison_trait_name operation:OpValue -> str {
    operation match
        OpValue::Eq => "Eq"
        OpValue::Ne => "Eq"
        _ => "Ord"
    end
}

fn comparison_uses_method receiver:Type store:SymbolStore -> bool {
    if receiver.is_unknown_placeholder then false return fi
    if TYPE_STR_T receiver.eq then false return fi
    if receiver.is_primitive_compare_type_t then false return fi
    receiver match
        Type::TypeVar(_) => true
        Type::Generic(generic) => generic.base store.structs.has
        _ => false
    end
}

fn add_method_dependencies
    result:OperationSemanticsResult
    method:MethodSemantics
    receiver:Type
    store:SymbolStore
{
    if "" method.trait_name != then method.trait_name result.dependencies.push fi
    if method.kind MethodSemanticsKind::Function is then
        method.function_name result.dependencies.push
    elif method.kind MethodSemanticsKind::DefaultMethod is then
        if method.trait_name store.traits.get Option::Some(casa_trait) is then
            store casa_trait receiver collect_trait_implementation_dependencies = implementations
            for implementation in implementations.iter do
                implementation result.dependencies.push
            done
        fi
    fi
}

fn analyze_method_operation
    result:OperationSemanticsResult
    method_name:str
    receiver:Type
    function_opt:Option[Function]
    store:SymbolStore
{
    if store function_opt receiver method_name resolve_method_semantics Option::Some(method) is then
        method Option::Some = result.method
        store receiver method result add_method_dependencies
    fi
}

fn parse_trait_method_name hidden_name:str -> Option[str] {
    "__trait_" = hidden_prefix
    if hidden_name hidden_prefix str::starts_with ! then Option::None(Option[str]) return fi
    hidden_name hidden_prefix.length hidden_name.length hidden_prefix.length - str::substring
    = trait_suffix
    trait_suffix "_" str::find = separator
    if separator 0 >= then Option::None(Option[str]) return fi
    trait_suffix separator 1 + trait_suffix.length separator - 1 - str::substring Option::Some
}

fn analyze_operation_semantics
    operation:OpValue
    receiver:Option[Type]
    function_opt:Option[Function]
    store:SymbolStore
-> OperationSemanticsResult {
    OperationSemanticsResult::new = result
    operation fixed_operation_stack_effect = result.stack_effect
    operation operation_syscall_argument_count = result.syscall_argument_count
    if result.syscall_argument_count Option::Some(argument_count) is then
        argument_count make_syscall_stack_effect Option::Some = result.stack_effect
        argument_count = result.word_parameter_count
        1 = result.word_parameter_start
    fi
    if operation operation_is_store then
        1 = result.word_parameter_start
        1 = result.word_parameter_count
    fi
    operation match
        OpValue::FnCall(function_name) => {
            function_name result.dependencies.push
            if function_name store.functions.get Option::Some(function) is then
                function.stack_effect Option::Some = result.stack_effect
            fi
        }
        OpValue::FnPush(function_name) => {
            function_name result.dependencies.push
            if function_name store.functions.get Option::Some(function) is then
                function.stack_effect make_function_reference_stack_effect Option::Some
                = result.stack_effect
            fi
        }
        OpValue::FnExec => {
            if receiver Option::Some(receiver_type) is then
                if receiver_type Type::Function(function_type) is then
                    function_type function_type_to_stack_effect Option::Some = result.stack_effect
                fi
            fi
        }
        OpValue::MethodCall(method_name) => {
            if receiver Option::Some(receiver_type) is then
                store function_opt receiver_type method_name result analyze_method_operation
                if result.method Option::Some(method) is then
                    method.stack_effect Option::Some = result.stack_effect
                fi
            fi
        }
        OpValue::TraitMethodCall(hidden_name) => {
            if receiver Option::Some(receiver_type) is then
                if hidden_name parse_trait_method_name Option::Some(method_name) is then
                    store function_opt receiver_type method_name result analyze_method_operation
                    if result.method Option::Some(method) is then
                        method.stack_effect Option::Some = result.stack_effect
                    fi
                fi
            fi
        }
        OpValue::Print => {
            if receiver Option::Some(receiver_type) is then
                receiver_type primitive_print_operation = result.resolved_operation
                if result.resolved_operation.is_none receiver_type.is_unknown_placeholder ! && then
                    "Display" result.dependencies.push
                    store function_opt receiver_type "to_str" result analyze_method_operation
                fi
            fi
        }
        OpValue::FstringToStr => {
            if receiver Option::Some(receiver_type) is then
                if TYPE_STR_T receiver_type.eq ! receiver_type.is_unknown_placeholder ! && then
                    "Display" result.dependencies.push
                    store function_opt receiver_type "to_str" result analyze_method_operation
                fi
            fi
        }
        _ => { }
    end
    if operation operation_is_comparison then
        if receiver Option::Some(receiver_type) is then
            if store receiver_type comparison_uses_method then
                operation comparison_trait_name result.dependencies.push
                operation comparison_method_name = method_name
                store function_opt receiver_type method_name result analyze_method_operation
            fi
        fi
    fi
    result
}
