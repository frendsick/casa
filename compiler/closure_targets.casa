    fn analyze_function
        self:mut$Analysis
        name:$str
        arguments:std::List[u64]
        captures:std::List[u64]
    -> u64 {
        name self.checked.find_body match
            std::Option::Some(body) => body
            std::Option::None => 0 return
        end = body
        f"{name.length}:{name}" = key
        arguments key append_ids
        ":" key.append
        captures key append_ids
        if key self.contexts.get_copy std::Option::Some(identity) is then
            if identity 1 - self
                .plan
                .contexts
                .get
                .complete then identity else 0 fi return
        fi
        if self.depth MAX_ANALYSIS_DEPTH >= then
            0 return
        fi
        false = specialized
        for argument in arguments.iter do
            if argument 0 != then
                true = specialized
            fi
        done
        for capture in captures.iter do
            if capture 0 != then
                true = specialized
            fi
        done
        0 name self
            .counts
            .get_copy_str
            .unwrap_or = count
        if specialized then
            if count MAX_CONTEXTS_PER_FUNCTION >= self.specializations MAX_SPECIALIZATIONS >= || then
                0 return
            fi
            1 += self.specializations
            count 1 + name.to_str self.counts.set
        fi
        self
            .plan
            .contexts
            .length 1 + = identity
        if specialized then f"{name}$closure${identity}" else name.to_str fi = symbol
        name self
            .checked
            .get_store
            .get_function
            .unwrap = function
        std::List[u64]::new = unknown
        for
            typ in function
                .stack_effect
                .return_types
                .iter
        do
            0 unknown.push
        done
        false true unknown std::Map[i64 u64]::new std::Map[i64 u64]::new symbol name.to_str Context self
            .plan
            .contexts
            .push
        identity key self.contexts.set
        if specialized ! then
            identity name.to_str self
                .plan
                .defaults
                .set
        fi
        Flow::new = flow
        while arguments.is_empty ! do
            arguments.pop flow.stack.push
        done
        function
            .stack_effect
            .return_types
            .length Frame::new = frame
        0 = index: u64
        for capture in function.captures.iter do
            capture.name.clone frame.captures.add
            if index captures.length < then
                index captures.get copy
            else
                0
            fi capture.name.clone flow.variables.set
            1 += index
        done
        1 += self.depth
        frame flow body self.analyze_body
        1 -= self.depth
        if flow.stopped ! then
            flow frame.record_return
        fi
        identity 1 - self
            .plan
            .contexts
            .get_mut = result
        frame match
            Frame { calls: calls executions: executions invalidates: invalidates returns: returns } => {
                calls = result.calls
                executions = result.executions
                invalidates = result.invalidates
                std::List[u64]::new returns.unwrap_or = result.outputs
            }
        end
        true = result.complete
        if specialized then
            false = needs_body
            for execution in result.executions.iter do
                if execution.second 0 != then
                    true = needs_body
                fi
            done
            result.calls.values = calls
            for callee in calls.iter do
                if callee 0 != then
                    callee 1 - self
                        .plan
                        .contexts
                        .get = called
                    if called.name called.symbol != then
                        true = needs_body
                    fi
                fi
            done
            if needs_body ! then
                identity 1 - self
                    .plan
                    .contexts
                    .get_mut = destination
                name.to_str = destination.symbol
