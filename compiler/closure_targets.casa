    fn analyze_body self:mut$Analysis body:$semantic_body::Body flow:mut$Flow frame:mut$Frame {
        std::Option[i64]::None = literal
        for node in body.get_nodes.iter do
            if flow.stopped then
                return
            fi
            if literal node is_exit_syscall then
                true = flow.stopped return
            fi
            std::Option[i64]::None = literal
            if node semantic_body::Node::Leaf(leaf) is then
                if leaf.action semantic_body::Action::Integer(value _) is then
                    value.value std::Option::Some = literal
                fi
            fi
            frame flow node self.analyze_node
        done
