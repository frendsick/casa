# Bounded target propagation over checked bodies. Shapes describe callable targets,
# never runtime values or capture storage. Every call still receives its original values.
import "std" as std
import "common" as common
import "semantic_body" as semantic_body
import "pattern" as pattern
import "typechecker" as typechecker

const MAX_CONTEXTS_PER_FUNCTION: u64 8
const MAX_SPECIALIZATIONS: u64 1024
const MAX_ANALYSIS_DEPTH: u64 16
const MAX_SHAPES: u64 8192
const MAX_LOOP_PASSES: u64 4

# Zero is the unknown shape. Positive identities index this request-owned table.
struct Shape {
    target:   std::String
    children: std::List[u64]
}

pub struct Context {
    pub name:       std::String
    pub symbol:     std::String
    pub calls:      std::Map[i64 u64]
    pub executions: std::Map[i64 u64]
    outputs:        std::List[u64]
    invalidates:    bool
    complete:       bool
}

pub struct Plan {
    pub contexts: std::List[Context]
    pub defaults: std::Map[std::String u64]
    pub root:     u64
}

struct Analysis {
    checked:         $typechecker::CheckedProgram
    plan:            Plan
    shapes:          std::List[Shape]
    shape_keys:      std::Map[std::String u64]
    contexts:        std::Map[std::String u64]
    counts:          std::Map[std::String u64]
    specializations: u64
    depth:           u64
}

struct Flow derives std::Clone {
    stack:             std::List[u64]
    variables:         std::Map[std::String u64]
    stopped:           bool
    invalidates:       bool
    # Binding coverage is independent of whether callable target shapes are known.
    bindings_complete: bool
    # Checked unconditional transfers disable cleanup. Conditional cleanup events
    # cannot prove inactivity because their runtime generation guard may fail.
    inactive:          std::Set[std::String]
}

struct LoopExit {
    flow:      Flow
    continues: bool
}

struct Frame {
    calls:        std::Map[i64 u64]
    executions:   std::Map[i64 u64]
    returns:      std::Option[std::List[u64]]
    return_count: u64
    captures:     std::Set[std::String]
    invalidates:  bool
    exits:        std::List[LoopExit]
}

impl Flow {
    fn new -> Flow {
        std::Set[std::String]::new true false false std::Map[std::String u64]::new std::List[u64]::new Flow
    }
    fn replace self:mut$Flow value:Flow {
        value match
            Flow { stack: stack variables: variables stopped: stopped invalidates: invalidates bindings_complete: bindings_complete inactive: inactive } => {
                stack = self.stack variables = self.variables stopped = self.stopped invalidates = self.invalidates bindings_complete = self.bindings_complete inactive = self.inactive
            }
        end
    }
    fn pop self:mut$Flow -> u64 {
        if self.stack.is_empty then
            0
        else
            self.stack.pop
        fi
    }
    # Keep binding identities for later replacement cleanup, even without targets.
    fn forget self:mut$Flow {
        0 = index: u64
        while index self.stack.length < do
            0 index self.stack.set
            1 += index
        done
        self.variables.keys = names
        for name in names.iter do
            0 name.clone self.variables.set
        done
    }
    fn is_equal self:$Flow other:$Flow -> bool {
        if
            self.stack.length other.stack.length != self.variables.length other.variables.length != || self.invalidates other.invalidates != || self.bindings_complete other.bindings_complete != || self.inactive.length other.inactive.length != ||
        then
            false return
        fi
        0 = index: u64
        while index self.stack.length < do
            if index self.stack.get copy index other.stack.get copy != then
                false return
            fi
            1 += index
        done
        for name in self.inactive.iter do
            if name other.inactive.has ! then
                false return
            fi
        done
        for entry in self.variables.iter do
            if
                0 entry.first other
                    .variables
                    .get_copy
                    .unwrap_or entry.second !=
            then
                false return
            fi
        done
        true
    }
    fn merge self:mut$Flow other:$Flow {
        if other.stopped then
            return
        fi
        if self.stopped then
            other.clone self.replace return
        fi
        self.invalidates other.invalidates || = self.invalidates
        # In a fully modeled path, no binding means no initialized owner.
        # Pattern bindings are entered even when their target is unknown.
        std::Set[std::String]::new = inactive
        for name in self.inactive.iter do
            if name other.inactive.has name other.variables.has ! other.bindings_complete && || then
                name.clone inactive.add
            fi
        done
        for name in other.inactive.iter do
            if name self.variables.has ! self.bindings_complete && then
                name.clone inactive.add
            fi
        done
        inactive = self.inactive
        self.bindings_complete other.bindings_complete && = self.bindings_complete
        if self.stack.length other.stack.length != then
            std::List[u64]::new = self.stack
        else
            0 = index: u64
            while index self.stack.length < do
                if index self.stack.get copy index other.stack.get copy != then
                    0 index self.stack.set
                fi
                1 += index
            done
        fi
        for entry in other.variables.iter do
            if entry.first self.variables.has ! then
                0 entry.first.clone self.variables.set
            fi
        done
        self.variables.keys = names
        for name in names.iter do
            0 name self
                .variables
                .get_copy
                .unwrap_or = value
            if
                0 name other
                    .variables
                    .get_copy
                    .unwrap_or value !=
            then
                0 name.clone self.variables.set
            fi
        done
    }
}

impl Frame {
    fn new return_count:u64 -> Frame {
        std::List[LoopExit]::new false std::Set[std::String]::new return_count std::Option[std::List[u64]]::None
        std::Map[i64 u64]::new std::Map[i64 u64]::new Frame
    }
    fn record_return self:mut$Frame flow:$Flow {
        self.invalidates flow.invalidates || = self.invalidates
        std::List[u64]::new = result
        self.return_count = remaining
        while 0 remaining != do
            if remaining flow.stack.length <= then
                flow.stack.length remaining - flow.stack.get copy
            else
                0
            fi result.push
            1 -= remaining
        done
        if self.returns std::Option::Some(previous) is then
            0 = index: u64
            while index result.length < do
                if index result.get copy index previous.get copy != then
                    0 index result.set
                fi
                1 += index
            done
        fi
        result std::Option::Some = self.returns
    }
    fn record_unknown_return self:mut$Frame {
        Flow::new = exit_flow
        exit_flow self.record_return
        true = self.invalidates
    }
    fn invalidate self:mut$Frame flow:mut$Flow {
        true = flow.invalidates
        flow.forget
    }
}

fn can_hold_targets typ:$common::Type -> bool {
    if typ.borrow_target std::Option::Some(target) is then
        target can_hold_targets return
    fi
    typ match
        common::Type::Function(_) => true
        common::Type::Generic(_) => true
        _ => false
    end
}

fn is_exit_syscall node:$semantic_body::Node literal:$std::Option[i64] -> bool {
    node match
        semantic_body::Node::Leaf(leaf) => leaf
        _ => false return
    end = leaf
    leaf.action match
        semantic_body::Action::Intrinsic(kind) => kind
        _ => false return
    end = kind
    if kind semantic_body::IntrinsicKind::Syscall1 != then
        false return
    fi
    literal match
        std::Option::Some(number) => number
        _ => false return
    end = number
    # Linux exit and exit_group never reach the loop back-edge.
    number 60 == number 231 == ||
}

fn record_target targets:mut$std::Map[i64 u64] identity:i64 target:u64 {
    if identity targets.get_copy std::Option::Some(previous) is then
        if previous target != then
            0 identity targets.set
        fi
    else
        target identity targets.set
    fi
}

fn append_ids text:mut$std::String ids:$std::List[u64] {
    for identity in ids.iter do
        f"/{identity}" = part
        part.as_str text.append
    done
}

