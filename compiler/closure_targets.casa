            semantic_body::Action::OwnerMoved(binding) => binding.storage_name.clone flow.inactive.add
            semantic_body::Action::Integer(_) => 0 flow.stack.push
            semantic_body::Action::Float(_) => 0 flow.stack.push
            semantic_body::Action::Boolean(_) => 0 flow.stack.push
            semantic_body::Action::Character(_) => 0 flow.stack.push
            semantic_body::Action::String(_) => 0 flow.stack.push
            semantic_body::Action::SizeOf(_) => 0 flow.stack.push
            semantic_body::Action::PtrAsRef(_) => {
                flow.pop drop 0 flow.stack.push
