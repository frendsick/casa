            semantic_body::PrimitiveKind::Dup => {
                flow.pop = value value flow.stack.push value flow.stack.push
            }
            semantic_body::PrimitiveKind::Over => {
                flow.pop = top flow.pop = under
                under flow.stack.push top flow.stack.push under flow.stack.push
