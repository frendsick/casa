                # local binding. Absence no longer proves an inactive owner.
                false = flow.bindings_complete
                std::Set[std::String]::new = flow.inactive
                std::List[u64]::new = flow.stack
                0 flow.stack.push
            }
            semantic_body::Node::Unreachable(_) => {
            }
        end
