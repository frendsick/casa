            fi
        done
        if target.is_empty known ! && then
            0 return
        fi
        f"{target.length}:{target}" = key
        children key append_ids
        if key self.shape_keys.get_copy std::Option::Some(identity) is then
            identity return
        fi
        if self.shapes.length MAX_SHAPES >= then
            0 return
        fi
        self.shapes.length 1 + = identity
        children target Shape self.shapes.push
        identity key self.shape_keys.set
        identity
    }
