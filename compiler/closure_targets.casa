    fn analyze_conditional
        self:mut$Analysis
        conditional:$semantic_body::Conditional
        flow:mut$Flow
        frame:mut$Frame
    {
        flow.clone = remaining
        Flow::new = joined true = joined.stopped
        0 = index: u64
        for branch in conditional.branches.iter do
            frame remaining branch.entry self.analyze_facts
            frame remaining branch.condition self.analyze_body
            frame remaining branch.test self.analyze_facts
            remaining.pop drop
            remaining.clone = branch_flow
            frame branch_flow branch.consequent self.analyze_body
            if index 1 + conditional.branches.length < then
                frame branch_flow index 1 + conditional
                    .branches
                    .get
                    .entry self.analyze_facts
            elif conditional.alternative std::Option::Some(alternative) is then
                frame branch_flow alternative.entry self.analyze_facts
            else
                frame branch_flow conditional.exit self.analyze_facts
            fi
            branch_flow joined.merge
            1 += index
        done
        if conditional.alternative std::Option::Some(alternative) is then
            frame remaining alternative.entry self.analyze_facts
            frame remaining alternative.body self.analyze_body
        fi
        remaining joined.merge
        joined flow.replace
        frame flow conditional.exit self.analyze_facts
    }
    fn analyze_loop self:mut$Analysis loop:$semantic_body::Loop flow:mut$Flow frame:mut$Frame {
        # Meet entry and back-edge facts before retaining any loop target. The
        # fixed pass budget widens all values on difficult changing loops.
        frame flow loop.entry self.analyze_facts
        flow.clone = entry
        frame.exits.length = exit_base
        false = stable
        Flow::new = exits
        true = exits.stopped
        0 = pass: u64
        while pass MAX_LOOP_PASSES < do
            entry.clone = previous
            entry.clone = iteration
            frame iteration loop.condition self.analyze_body
            frame iteration loop.test self.analyze_facts
            iteration.pop drop
            iteration exits.merge
            frame iteration loop.body self.analyze_body
            frame iteration loop.exit self.analyze_facts
            iteration entry.merge
            while frame.exits.length exit_base > do
                frame.exits.pop match
                    LoopExit { flow: exit_flow continues: continues } => {
                        if continues then
                            exit_flow entry.merge
                        else
                            exit_flow exits.merge
                        fi
                    }
                end
            done
            if previous entry.is_equal then
                true = stable break
            fi
            1 += pass
        done
        if stable ! then
            entry.forget
            entry.clone = iteration
            frame iteration loop.condition self.analyze_body
            frame iteration loop.test self.analyze_facts
            iteration.pop drop
            iteration exits.merge
            frame iteration loop.body self.analyze_body
            while frame.exits.length exit_base > do
                frame.exits.pop match
                    LoopExit { flow: exit_flow continues: continues } => {
                        if continues ! then
                            exit_flow exits.merge
                        fi
                    }
                end
            done
        fi
        exits flow.replace
        frame flow loop.exit self.analyze_facts
    }
    fn analyze_node self:mut$Analysis node:$semantic_body::Node flow:mut$Flow frame:mut$Frame {
        node match
            semantic_body::Node::Leaf(leaf) => frame flow leaf self.analyze_leaf
            semantic_body::Node::Region(region) => {
                frame flow region.entry self.analyze_facts
                frame flow region.body self.analyze_body
                frame flow region.exit self.analyze_facts
            }
            semantic_body::Node::Group(group) => {
                frame flow group.facts self.analyze_facts frame flow group.body self.analyze_body
            }
            semantic_body::Node::Conditional(conditional) => frame flow conditional self.analyze_conditional
            semantic_body::Node::Loop(loop) => frame flow loop self.analyze_loop
            semantic_body::Node::Match(value) => {
                frame flow value.entry self.analyze_facts
                if 0 value.subject_type self.does_destruction_invalidate then
                    flow frame.invalidate
                fi
                # Failed guards can mutate state before a later arm is selected.
                for arm in value.arms.iter do
                    if
                        arm
                            .guard
                            .get_nodes
                            .is_empty !
                    then
                        flow frame.invalidate
                    fi
                done
                flow.pop drop
                flow.clone = entry
                Flow::new = joined true = joined.stopped
                0 = index: u64
                for arm in value.arms.iter do
                    entry.clone = branch
                    frame branch arm.entry self.analyze_facts
                    branch arm.entry arm.pattern self.forget_pattern_bindings
                    frame branch arm.guard self.analyze_body
                    std::List[u64]::new = branch.stack
                    frame branch arm.body self.analyze_body
                    if index 1 + value.arms.length < then
                        frame branch index 1 + value
                            .arms
                            .get
                            .entry self.analyze_facts
                    else
                        frame branch value.exit self.analyze_facts
                    fi
                    branch joined.merge
                    1 += index
                done
                joined flow.replace
                frame flow value.exit self.analyze_facts
            }
            semantic_body::Node::Array(_) => {
                # Element expressions can call, mutate, or return. Preserve no
                # target summary until element evaluation is modeled explicitly.
                frame.record_unknown_return
                flow frame.invalidate
