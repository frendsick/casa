    fn does_destruction_invalidate self:$Analysis typ:$common::Type depth:u64 -> bool {
        depth 0 typ self.does_shape_destruction_invalidate
    }
    fn does_shape_destruction_invalidate
        self:$Analysis
        typ:$common::Type
        shape:u64
        depth:u64
    -> bool {
        if typ.is_borrow then
            false return
        fi
        if depth MAX_ANALYSIS_DEPTH >= then
            true return
        fi
        if
            typ self
                .checked
                .find_drop_function
                .is_some
        then
            true return
        fi
        typ self.checked.get_shape match
            typechecker::CheckedShape::Closure => {
                if shape 0 == then
                    true return
                fi
                shape 1 - self.shapes.get = value
                if value.target.is_empty then
                    true return
                fi
                value.target.as_str self
                    .checked
                    .get_store
                    .get_function
                    .unwrap = function
                0 = index: u64
                for capture in function.captures.iter do
                    if capture.name.as_str function.owned_captures common::string_list_contains then
                        if depth 1 + index shape self.get_child capture.typ self.does_shape_destruction_invalidate then
                            true return
                        fi
                    fi
                    1 += index
                done
                false
            }
            typechecker::CheckedShape::Array => depth 1 + typ.array_element_type.unwrap self.does_destruction_invalidate
            typechecker::CheckedShape::Struct => {
                typ.match_base self
                    .checked
                    .get_store
                    .structs
                    .get
                    .unwrap = declaration
                declaration.type_vars typ common::aggregate_type_bindings = substitutions
                0 = index: u64
                for member in declaration.members.iter do
                    substitutions member.typ.substitute_t = field_type
                    if depth 1 + index shape self.get_child field_type self.does_shape_destruction_invalidate then
                        true return
                    fi
                    1 += index
                done
                false
            }
            typechecker::CheckedShape::Enum => {
                typ.match_base self
                    .checked
                    .get_store
                    .enums
                    .get
                    .unwrap = declaration
                declaration.type_vars typ common::aggregate_type_bindings = substitutions
                for variant in declaration.variant_types.iter do
                    for payload in variant.second.iter do
                        substitutions payload.substitute_t = payload_type
                        if depth 1 + payload_type self.does_destruction_invalidate then
                            true return
                        fi
                    done
                done
                false
            }
            _ => false
        end
    }
