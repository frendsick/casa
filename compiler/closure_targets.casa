}

pub fn analyze checked:$typechecker::CheckedProgram -> Plan {
    0 std::Map[std::String u64]::new std::List[Context]::new Plan = plan
    0 0 std::Map[std::String u64]::new std::Map[std::String u64]::new std::Map[std::String u64]::new
    std::List[Shape]::new plan checked Analysis = analysis
    Flow::new = flow
    0 Frame::new = frame
    frame flow checked.get_root analysis.analyze_body
    frame match
        Frame { calls: calls executions: executions invalidates: invalidates } => {
            true invalidates std::List[u64]::new executions calls "".to_str "".to_str Context analysis
                .plan
                .contexts
                .push
        }
    end
    analysis
        .plan
        .contexts
        .length = analysis.plan.root
    for name in checked.get_function_names.iter do
        std::List[u64]::new = arguments
        name.as_str checked
            .get_store
            .get_function
            .unwrap = function
        for
            parameter in function
                .stack_effect
                .parameters
                .iter
        do
            0 arguments.push
        done
        std::List[u64]::new arguments name.as_str analysis.analyze_function drop
    done
    analysis match
        Analysis { plan: result } => result
    end
}
