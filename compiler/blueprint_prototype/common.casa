    unsafe { values ptr::from_ref load64 }
}

fn choose flag:bool -> i64 {
    if flag then
        17 return
    else
        19
    fi
}

fn count -> i64 {
    0 = index
    while 3 index < do
        1 += index
    done
    index
}

fn select flag:bool -> i64 {
    flag match
        true => {
            23
        }
        false => {
            29
        }
    end
