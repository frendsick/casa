trait __casa_std__Clone { fn clone self: $self -> self }

trait __casa_std__Copy: __casa_std__Clone { }

extern struct Pair derives __casa_std__Copy {
    first:  i64
    second: i64
}

extern fn pair_value value:Pair -> i64

extern fn pair_return value:i64 -> Pair

extern fn sum_seven a:i64 b:i64 c:i64 d:i64 e:i64 f:i64 g:i64 -> i64

unsafe {
    4 pair_return pair_value print
    7 6 5 4 3 2 1 sum_seven print
}
