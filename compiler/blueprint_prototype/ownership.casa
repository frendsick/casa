# The drop hook makes cleanup order visible without test-only compiler hooks.
struct Resource {
    id: i64
}

impl Resource {
    fn drop self:mut$Resource { self.id print }
}

fn identity [T] value:$T -> $T { value }

fn read value:$Resource -> i64 { value.id }

fn conditional flag:bool {
    7 Resource = first
    8 Resource = second
    first identity identity read print
    if flag then
        first drop
    fi
}

fn early flag:bool -> i64 {
    9 Resource = owner
    if flag then
        1 return
    fi
    2
}
true conditional
false conditional
true early print
false early print
