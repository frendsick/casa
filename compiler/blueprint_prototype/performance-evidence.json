  "reproduction_scripts": {
    "measure.py": "#!/usr/bin/env python3\nimport json\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport time\n\nroot = Path('/home/ai-agent/git/casa-651')\nout = Path('/tmp/casa-651-speed')\nlabel = sys.argv[1] if len(sys.argv) > 1 else 'single'\ncompiler = sys.argv[2] if len(sys.argv) > 2 else '/tmp/casa-651-control'\ncommand = [compiler, '-L', 'lib', 'casa.casa', '-o', str(out / 'compiler-build'), '--keep-asm', '--verbose']\nstarted = time.perf_counter()\nevents = []\nwith (out / f'{label}.log').open('w') as log:\n    process = subprocess.Popen(['/usr/bin/time', '-f', '%e %M %U %S', '-o', str(out / f'{label}.time'), *command], cwd=root, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=1)\n    for line in process.stdout:\n        elapsed = time.perf_counter() - started\n        events.append({'elapsed_s': elapsed, 'line': line.rstrip()})\n        print(f'{elapsed:9.3f}s {line}', end='', flush=True)\n        log.write(f'{elapsed:9.3f}s {line}')\n    returncode = process.wait()\nwall = time.perf_counter() - started\nmetrics = (out / f'{label}.time').read_text().strip().splitlines()[-1].split()\nresult = {'label': label, 'command': command, 'cwd': str(root), 'exit_code': returncode, 'wall_s': wall, 'time_wall_s': float(metrics[0]), 'peak_rss_kib': int(metrics[1]), 'user_s': float(metrics[2]), 'system_s': float(metrics[3]), 'events': events, 'ceiling_s': 10.0, 'passes': returncode == 0 and wall <= 10.0}\n(out / f'{label}.json').write_text(json.dumps(result, indent=2) + '\\n')\nprint(f\"{'PASS' if result['passes'] else 'FAIL'}: wall={wall:.3f}s peak_RSS={result['peak_rss_kib']/1024:.2f}MiB ceiling=10.000s\", flush=True)\nsys.exit(0 if result['passes'] else 1)\n",
    "phases.gdb": "set pagination off\nset confirm off\nset startup-with-shell off\nset disable-randomization off\nstarti\npython\nexec(open('/tmp/casa-651-speed/phases.py').read())\nend\nquit\n",
    "phases.py": "import json\nfrom pathlib import Path\nimport time\n\nstarted = time.perf_counter()\npath = Path('/tmp/casa-651-speed/phases.jsonl')\npath.write_text('')\nclass Phase(gdb.Breakpoint):\n    def stop(self):\n        event={'phase': self.location, 'elapsed_s': time.perf_counter()-started}\n        with path.open('a') as log:\n            log.write(json.dumps(event)+'\\n')\n        print('PHASE ' + json.dumps(event), flush=True)\n        return False\nfor name in (\n    'fn___casa_module_7__parse_and_resolve',\n    'fn___casa_module_8__type_check',\n    'fn___casa_module_8__schedule_functions',\n    'fn___casa_module_15__check_trait_impls',\n    'fn___casa_module_15__validate_generic_cycles',\n    'fn___casa_module_15__monomorphize_checked_generics',\n    'fn___casa_module_10__compile_typechecked',\n    'fn___casa_module_11__emit',\n):\n    Phase(name, internal=True)\ngdb.execute('continue')\nevent={'phase':'process_exit','elapsed_s':time.perf_counter()-started}\nwith path.open('a') as log:\n    log.write(json.dumps(event)+'\\n')\nprint('PHASE ' + json.dumps(event), flush=True)\n"
