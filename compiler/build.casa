# Assembler and linker integration for producing x86-64 binaries.
import "std" as std
import "os" as os

pub const ASSEMBLER_PATH "/usr/bin/as"
pub const LINKER_PATH "/usr/bin/ld"

pub fn compile_binary asm_source:$str output_name:$str keep_asm:bool {
    f"{output_name}.s" = asm_file
    f"{output_name}.o" = obj_file

    # Write assembly to file
    asm_source asm_file.as_str file::write_all = write_result
    if write_result std::Result::Error(write_err) is then
        f"error: cannot write {asm_file}: {write_err.to_str}" std::eprintln_string
        1 std::exit
    fi

    # Assemble
    std::List[std::String]::new = assembler_args
    ASSEMBLER_PATH assembler_args.push_str
    "-o".to_str assembler_args.push
    obj_file.clone assembler_args.push
    asm_file.clone assembler_args.push
    assembler_args std::run_command = assemble_result
    if 0 assemble_result != then
        f"Assembly failed with exit code {assemble_result}" std::eprintln_string
        1 std::exit
    fi

    # Link
    std::List[std::String]::new = linker_args
    LINKER_PATH linker_args.push_str
    "-o".to_str linker_args.push
    output_name.clone linker_args.push_str
    obj_file.clone linker_args.push
    linker_args std::run_command = link_result
    if 0 link_result != then
        f"Linking failed with exit code {link_result}" std::eprintln_string
        1 std::exit
    fi

    # Clean build artifacts
    if keep_asm ! then
        asm_file.as_str file::remove drop
    fi
    obj_file.as_str file::remove drop
}
