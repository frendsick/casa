# Assembler and linker integration for producing x86-64 binaries.
import "std" as std
import "os" as os

pub const ASSEMBLER_PATH "/usr/bin/as"
pub const LINKER_PATH "/usr/bin/cc"

pub fn compile_binary
    asm_source:$str
    output_name:$str
    keep_asm:bool
    link_libraries:$std::List[std::String]
{
    f"{output_name}.s" = asm_file
    f"{output_name}.o" = obj_file

    # Write assembly to file
    asm_source std::Bytes::from_str asm_file
        .as_str
        .as_cstr
        .unwrap file::write_all = write_result
    if write_result std::Result::Error(write_err) is then
        f"error: cannot write {asm_file}: {write_err.to_str}" std::eprintln_string
        1 process::exit
    fi

    # Assemble
    std::List[std::Bytes]::new = assembler_args
    ASSEMBLER_PATH assembler_args.push_str
    "-o" assembler_args.push_str
    obj_file.as_str assembler_args.push_str
    asm_file.as_str assembler_args.push_str
    assembler_args std::run_command = assemble_result
    if 0 assemble_result != then
        f"Assembly failed with exit code {assemble_result}" std::eprintln_string
        1 process::exit
    fi

    # Link
    std::List[std::Bytes]::new = linker_args
    LINKER_PATH linker_args.push_str
    "-nostdlib" linker_args.push_str
    "-no-pie" linker_args.push_str
    "-Wl,-e,_start" linker_args.push_str
    "-Wl,-z,noexecstack" linker_args.push_str
    "-o" linker_args.push_str
    output_name linker_args.push_str
    obj_file.as_str linker_args.push_str
    for library in link_libraries.iter do
        "-l" linker_args.push_str
        library.as_str linker_args.push_str
    done
    linker_args std::run_command = link_result
    if 0 link_result != then
        f"Linking failed with exit code {link_result}" std::eprintln_string
        1 process::exit
    fi

    # Clean build artifacts
    if keep_asm ! then
        asm_file
            .as_str
            .as_cstr
            .unwrap file::remove drop
    fi
    obj_file
        .as_str
        .as_cstr
        .unwrap file::remove drop
}
