# Shared compiler front-end analysis.
import "std"
import "typechecker"

struct AnalysisInput {
    root_file:        String
    root_source:      String
    library_paths:    List[String]
    source_overrides: Map[String String]
}

impl AnalysisInput {
    fn new root_file:String root_source:String -> AnalysisInput {
        Map[String String]::new
        List[String]::new
        root_source
        root_file
        AnalysisInput
    }

    fn into_parts self:AnalysisInput -> String String List[String] Map[String String] {
        self match
            AnalysisInput { root_file: root_file root_source: root_source library_paths: library_paths source_overrides: source_overrides } => root_file root_source library_paths source_overrides
        end
    }
}

struct AnalysisResult {
    diagnostics: Diagnostics
    sources:     SourceStore
    typechecked: Option[TypecheckResult]
}

impl AnalysisResult {
    fn into_parts self:AnalysisResult -> Diagnostics SourceStore Option[TypecheckResult] {
        self match
            AnalysisResult { diagnostics: diagnostics sources: sources typechecked: typechecked } => diagnostics sources typechecked
        end
    }
}

fn analyze input:AnalysisInput -> AnalysisResult {
    input.into_parts = source_overrides = library_paths = root_source = root_file

    SourceStore::new = sources
    for override in source_overrides.iter do
        override.second.as_str override.first.as_str sources.add
    done
    root_source.as_str root_file.as_str sources.add

    root_file.as_str root_source.as_str lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    sources diagnostics library_paths tokens parse_and_resolve = parse_result
    parse_result.into_parts = diagnostics = typecheck_store = parsed_ops
    parsed_ops match
        Option::Some(ops) => {
            typecheck_store ops type_check = typecheck_result
            typecheck_result.diagnostics.clone diagnostics.merge
            typecheck_result Option::Some
        }
        Option::None => Option[TypecheckResult]::None
    end
    = typechecked

    typechecked
    sources
    diagnostics
    AnalysisResult
}
