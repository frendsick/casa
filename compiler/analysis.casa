# Shared compiler front-end analysis.
import "std" as std
import "error" as error
import "lexer" as lexer
import "syntax" as syntax
import "typechecker" as typechecker

pub struct AnalysisInput {
    pub root_file:        std::String
    pub root_source:      std::String
    pub library_paths:    std::List[std::String]
    pub source_overrides: std::Map[std::String std::String]
}

impl AnalysisInput {
    pub fn new root_file:std::String root_source:std::String -> AnalysisInput {
        std::Map[std::String std::String]::new
        std::List[std::String]::new
        root_source
        root_file
        AnalysisInput
    }

    pub fn into_parts
        self:AnalysisInput
    -> std::String std::String std::List[std::String] std::Map[std::String std::String] {
        self match
            AnalysisInput { root_file: root_file root_source: root_source library_paths: library_paths source_overrides: source_overrides } => root_file root_source library_paths source_overrides
        end
    }
}

pub struct AnalysisResult {
    pub diagnostics: error::Diagnostics
    pub sources:     lexer::SourceStore
    pub typechecked: std::Option[typechecker::TypecheckResult]
}

impl AnalysisResult {
    pub fn into_parts
        self:AnalysisResult
    -> error::Diagnostics lexer::SourceStore std::Option[typechecker::TypecheckResult] {
        self match
            AnalysisResult { diagnostics: diagnostics sources: sources typechecked: typechecked } => diagnostics sources typechecked
        end
    }
}

pub fn analyze input:AnalysisInput -> AnalysisResult {
    input.into_parts = source_overrides = library_paths = root_source = root_file

    lexer::SourceStore::new = sources
    for override in source_overrides.iter do
        override.second.as_str override.first.as_str sources.add
    done
    root_source.as_str root_file.as_str sources.add

    root_file.as_str root_source.as_str lexer::lex_source = lex_result
    lex_result.into_parts = diagnostics = tokens
    sources diagnostics library_paths tokens syntax::parse_and_resolve = parse_result
    parse_result.into_parts = diagnostics = typecheck_store = parsed_ops
    parsed_ops match
        std::Option::Some(ops) => {
            typecheck_store ops typechecker::type_check = typecheck_result
            typecheck_result.diagnostics.clone diagnostics.merge
            typecheck_result std::Option::Some
        }
        std::Option::None => std::Option[typechecker::TypecheckResult]::None
    end
    = typechecked

    typechecked
    sources
    diagnostics
    AnalysisResult
}
