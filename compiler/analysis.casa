# Shared compiler front-end analysis.
import "std"
import "typechecker"

struct AnalysisInput {
    root_file:        str
    root_source:      str
    library_paths:    List[str]
    source_overrides: Map[str str]
}

impl AnalysisInput {
    fn new root_file:str root_source:str -> AnalysisInput {
        Map[str str]::new
        List[str]::new
        root_source
        root_file
        AnalysisInput
    }
}

struct AnalysisResult {
    diagnostics: Diagnostics
    sources:     SourceStore
    typechecked: Option[TypecheckResult]
}

fn analyze input:AnalysisInput -> AnalysisResult {
    SourceStore::new = sources
    for override in input.source_overrides.iter do
        override.second override.first sources.add
    done
    input.root_source input.root_file sources.add

    input.root_file input.root_source lex_source = lex_result
    sources lex_result.diagnostics input.library_paths lex_result.tokens parse_and_resolve = parse_result
    if parse_result.ops Option::Some(ops) is then
        parse_result.store ops type_check = typecheck_result
        typecheck_result.diagnostics parse_result.diagnostics.merge
        typecheck_result Option::Some
    else
        Option[TypecheckResult]::None
    fi
    = typechecked

    typechecked
    sources
    parse_result.diagnostics
    AnalysisResult
}
