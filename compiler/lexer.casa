# Tokenizer for the Casa programming language.
import "std" as std
import "os" as os
import "parser" as parser
import "common" as common
import "error" as error

# ============================================================================
# Escape sequence map
# ============================================================================
# ============================================================================
# UTF-8 decoding
# ============================================================================

pub struct DecodedUtf8Scalar {
    pub codepoint:   u32
    pub byte_length: u64
}

pub fn is_unicode_scalar codepoint:u32 -> bool {
    1114111 codepoint <=
    55296 codepoint >= 57343 codepoint <= && ! &&
}

pub fn utf8_byte offset:u64 source:$str -> std::Option[u32] {
    if source.length offset >= then
        std::Option[u32]::None return
    fi
    offset source.at.codepoint std::Option::Some
}

pub fn is_utf8_continuation byte:u32 -> bool { 128 byte >= 191 byte <= && }

# Decode one scalar without replacing malformed input.

pub fn decode_utf8_scalar offset:u64 source:$str -> std::Option[DecodedUtf8Scalar] {
    source offset utf8_byte = first_opt
    if first_opt.is_none then
        std::Option[DecodedUtf8Scalar]::None return
    fi
    first_opt.unwrap = first
    if 127 first <= then
        1 first DecodedUtf8Scalar std::Option::Some return
    fi

    source offset 1 + utf8_byte = second_opt
    if second_opt.is_none then
        std::Option[DecodedUtf8Scalar]::None return
    fi
    second_opt.unwrap = second
    if second is_utf8_continuation ! then
        std::Option[DecodedUtf8Scalar]::None return
    fi

    if 194 first >= 223 first <= && then
        first 31 & 6 << second 63 & | = codepoint
        2 codepoint DecodedUtf8Scalar std::Option::Some return
    fi

    source offset 2 + utf8_byte = third_opt
    if third_opt.is_none then
        std::Option[DecodedUtf8Scalar]::None return
    fi
    third_opt.unwrap = third
    if third is_utf8_continuation ! then
        std::Option[DecodedUtf8Scalar]::None return
    fi

    if 224 first >= 239 first <= && then
        first 15 & 12 <<
        second 63 & 6 << |
        third 63 & |
        = codepoint
        if 2048 codepoint >= codepoint is_unicode_scalar && then
            3 codepoint DecodedUtf8Scalar std::Option::Some return
        fi
        std::Option[DecodedUtf8Scalar]::None return
    fi

    source offset 3 + utf8_byte = fourth_opt
    if fourth_opt.is_none then
        std::Option[DecodedUtf8Scalar]::None return
    fi
    fourth_opt.unwrap = fourth
    if fourth is_utf8_continuation ! then
        std::Option[DecodedUtf8Scalar]::None return
    fi

    if 240 first >= 244 first <= && then
        first 7 & 18 <<
        second 63 & 12 << |
        third 63 & 6 << |
        fourth 63 & |
        = codepoint
        if 65536 codepoint >= codepoint is_unicode_scalar && then
            4 codepoint DecodedUtf8Scalar std::Option::Some return
        fi
    fi
    std::Option[DecodedUtf8Scalar]::None
}
# Pushes a byte-indexed source character into a String builder.
# str::at returns a byte as a char; this reverses that encoding.
# SAFETY: Source bytes form valid UTF-8 so pushing them back preserves the invariant.
fn push_source_byte builder:mut$std::String character:char {
    unsafe { character.codepoint (u8) builder.push_byte_unchecked }
}

# ============================================================================
# Lexer state
# ============================================================================

pub fn normalize_path path:$str -> std::String {
    # Resolve ".." components in a path.
    path "/" str::starts_with = is_absolute

    # Split by "/" and process each component.
    std::List[std::String]::new = parts
    0 (u64) = start
    0 (u64) = scan
    while scan path.length > do
        if '/' scan path.at == then
            if start scan != then
                path start scan start - str::substring parts.push
            fi
            scan 1 + = start
        fi
        1 += scan
    done
    if start path.length != then
        path start path.length start - str::substring parts.push
    fi

    # Process parts, resolving ".."
    std::List[std::String]::new = resolved_parts
    for part in parts.iter do
        if ".." part.as_str == then
            if 0 resolved_parts.length != then
                resolved_parts.pop drop
            fi
        elif "." part.as_str != then
            part.clone resolved_parts.push
        fi
    done

    # Rebuild path
    "/" resolved_parts.join_strings = path_body
    if is_absolute then
        "/" path_body.as_str str::concat
    else
        path_body
    fi
}

pub fn absolute_normalize_path path:$str -> std::String {
    path normalize_path = normalized
    if normalized.as_str "/" str::starts_with then
        normalized return
    fi
    dir::current
        .unwrap
        .to_str
        .unwrap = current_dir
    f"{current_dir}/{normalized}" = absolute
    absolute.as_str normalize_path
}

pub struct SourceStore {
    pub sources:     std::Map[std::String std::String]
    pub line_starts: std::Map[std::String std::List[u64]]
}

impl SourceStore: std::Clone {
    pub fn clone self:$SourceStore -> SourceStore {
        self.line_starts.clone self.sources.clone SourceStore
    }
}

pub struct SourceContext {
    pub position:    common::SourcePosition
    pub source_line: std::String
}

impl SourceStore {
    pub fn new -> SourceStore {
        std::Map[std::String std::List[u64]]::new
        std::Map[std::String std::String]::new
        SourceStore
    }

    pub fn add self:mut$SourceStore path:$str source:$str {
        path normalize_path = normalized
        source.to_str normalized.clone self.sources.set

        # Build line-start index: byte offset of the first byte of each line.
        std::List[u64]::new = starts
        0 (u64) starts.push
        0 (u64) = i
        while i source.length > do
            if '\n' i source.at == then
                i 1 + starts.push
            fi
            1 += i
        done
        starts normalized self.line_starts.set
    }

    pub fn get self:$SourceStore path:$str -> std::Option[$std::String] {
        path self.sources.get_str
    }

    pub fn get_context self:$SourceStore path:$str offset:u64 -> std::Option[SourceContext] {
        if path self.get std::Option::Some(source) is then
            if offset source.length < then
                source.length = offset
            fi

            1 (u64) = line
            0 (u64) = line_start
            if path self.line_starts.get_str std::Option::Some(line_starts) is then
                { offset < } line_starts.bisect = split
                if split 0 < then
                    split 1 - = index
                    index 1 + = line
                    index line_starts.get.clone = line_start
                fi
            fi

            offset = line_end
            while line_end source.length > do
                if '\n' line_end source.at == then
                    break
                fi
                1 += line_end
            done

            source.as_str line_start line_end line_start - str::substring = source_line
            source_line offset line_start - 1 + line common::SourcePosition::new SourceContext std::Option::Some
            return
        fi
        std::Option[SourceContext]::None
    }

    pub fn convert_offset_to_position
        self:$SourceStore
        path:$str
        offset:u64
    -> std::Option[common::SourcePosition] {
        if offset path self.get_context std::Option::Some(context) is then
            context.position.clone std::Option::Some
        else
            std::Option[common::SourcePosition]::None
        fi
    }

    pub fn convert_position_to_offset
        self:$SourceStore
        path:$str
        position:$common::SourcePosition
    -> std::Option[u64] {
        if path self.line_starts.get_str std::Option::Some(line_starts) is then
            position.line = target_line
            position.column = column
            if target_line 1 > then
                1 (u64) = target_line
            fi
            if column 1 > then
                1 (u64) = column
            fi

            target_line 1 - = idx
            if line_starts.length idx >= then
                line_starts.length 1 - = idx
            fi
            idx line_starts.get.clone column 1 - + std::Option::Some return
        fi
        std::Option[u64]::None
    }

    pub fn append_source_context
        self:$SourceStore
        location:$common::Location
        builder:mut$std::String
    {
        if "" location.file.as_str == then
            return
        fi
        if location.span.offset location.file.as_str self.get_context std::Option::Some(context) is then
            "\n" builder.append
            location.span.length context.position.clone context.source_line.as_str location.file.as_str
            error::format_source_context builder.append_string
        fi
    }

    pub fn format_error self:$SourceStore error:$error::CasaError -> std::String {
        std::String::new = builder
        "error[" builder.append
        error.kind error::error_kind_name builder.append
        "]: " builder.append
        error.message.as_str builder.append

        builder error.location self.append_source_context

        if error.expected std::Option::Some(expected) is then
            "\n  Expected: " builder.append
            expected.as_str builder.append
        fi
        if error.got std::Option::Some(got) is then
            "\n  " builder.append
            error.got_label.as_str builder.append
            ": " builder.append
            got.as_str builder.append
        fi

        for note in error.notes.iter do
            "\n  Note: " builder.append
            note.message.as_str builder.append
            builder note.location self.append_source_context
        done

        builder
    }
}

pub struct LexResult {
    pub tokens:      std::List[common::Token]
    pub diagnostics: error::Diagnostics
}

impl LexResult {
    pub fn into_parts self:LexResult -> std::List[common::Token] error::Diagnostics {
        self match
            LexResult { tokens: tokens diagnostics: diagnostics } => tokens diagnostics
        end
    }
}

pub struct Lexer {
    pub cursor:      parser::Cursor
    pub file:        std::String
    pub formatter:   bool
    pub diagnostics: error::Diagnostics
}

impl Lexer {
    pub fn new source:$str file:std::String formatter:bool -> Lexer {
        error::Diagnostics::new formatter file source parser::Cursor::new Lexer
    }

    pub fn loc self:mut$Lexer offset:u64 length:u64 -> common::Location {
        length offset self Lexer::file.clone common::Location::new
    }

    pub fn cur_loc self:mut$Lexer length:u64 -> common::Location {
        length self Lexer::cursor parser::Cursor::pos self.loc
    }

    pub fn skip_whitespace self:mut$Lexer {
        while self Lexer::cursor.is_eof ! do
            self Lexer::cursor.peek = char_opt
            if char_opt.is_none then
                break
            fi
            char_opt.unwrap = ch
            if self.formatter then
                if ch ' ' == ch '\t' == || ! then
                    break
                fi
            else
                if ch.is_space ! then
                    break
                fi
            fi
            self Lexer::cursor.advance drop
        done
    }

    pub fn skip_line self:mut$Lexer {
        while self Lexer::cursor.is_eof ! do
            self Lexer::cursor.advance = char_opt
            if char_opt.is_none then
                break
            fi
            if char_opt std::Option::Some(ch) is then
                if '\n' ch == then
                    break
                fi
            fi
        done
    }

    pub fn consume_newline self:mut$Lexer newline:char -> u64 {
        self Lexer::cursor.advance drop
        if '\r' newline != then
            1 return
        fi
        self Lexer::cursor.peek = after_cr_opt
        if after_cr_opt.is_none then
            1 return
        fi
        if '\n' after_cr_opt.unwrap != then
            1 return
        fi
        self Lexer::cursor.advance drop
        2
    }

    pub fn lex_newline self:mut$Lexer -> std::Option[common::Token] {
        if self.formatter ! then
            std::Option[common::Token]::None return
        fi
        self Lexer::cursor.peek = newline_opt
        if newline_opt.is_none then
            std::Option[common::Token]::None return
        fi
        newline_opt.unwrap = newline
        if '\n' newline != '\r' newline != && then
            std::Option[common::Token]::None return
        fi
        self Lexer::cursor parser::Cursor::pos = position
        newline self.consume_newline = length
        length position self.loc common::TokenKind::Newline "\n".to_str common::Token::new std::Option::Some
    }

    pub fn startswith self:mut$Lexer prefix:str -> bool { prefix self Lexer::cursor.starts_with }

    pub fn add_error self:mut$Lexer kind:common::ErrorKind message:str location:$common::Location {
        location.clone message.to_str kind error::CasaError::new self.diagnostics.push_error
    }

    pub fn lex_digits self:mut$Lexer {
        while self Lexer::cursor.is_eof ! do
            self Lexer::cursor.peek = char_opt
            if char_opt.is_none then
                break
            fi
            if char_opt std::Option::Some(ch) is then
                if ch.is_digit ! then
                    break
                fi
            fi
            self Lexer::cursor.advance drop
        done
    }

    pub fn can_lex_fraction self:mut$Lexer -> bool {
        self Lexer::cursor parser::Cursor::pos = position
        if self Lexer::cursor parser::Cursor::source.length position >= then
            false return
        fi
        if '.' position self Lexer::cursor parser::Cursor::source.at != then
            false return
        fi
        if self Lexer::cursor parser::Cursor::source.length position 1 + >= then
            true return
        fi
        position 1 + self Lexer::cursor parser::Cursor::source.at = following
        following.is_alpha '_' following == || !
    }

    pub fn lex_fraction self:mut$Lexer start:u64 {
        self Lexer::cursor.advance drop
        self Lexer::cursor parser::Cursor::pos = fraction_start
        self.lex_digits
        if fraction_start self Lexer::cursor parser::Cursor::pos == then
            self Lexer::cursor parser::Cursor::pos start - start self.loc
            "Expected digits after decimal point" common::ErrorKind::Syntax self.add_error
        fi
    }

    pub fn lex_exponent self:mut$Lexer start:u64 {
        self Lexer::cursor parser::Cursor::pos = position
        if self Lexer::cursor parser::Cursor::source.length position >= then
            return
        fi
        position self Lexer::cursor parser::Cursor::source.at = marker
        if 'e' marker != 'E' marker != && then
            return
        fi
        self Lexer::cursor.advance drop
        self Lexer::cursor parser::Cursor::pos = sign_position
        if sign_position self Lexer::cursor parser::Cursor::source.length > then
            sign_position self Lexer::cursor parser::Cursor::source.at = sign
            if '+' sign == '-' sign == || then
                self Lexer::cursor.advance drop
            fi
        fi
        self Lexer::cursor parser::Cursor::pos = exponent_start
        self.lex_digits
        if exponent_start self Lexer::cursor parser::Cursor::pos == then
            self Lexer::cursor parser::Cursor::pos start - start self.loc
            "Expected digits in floating-point exponent" common::ErrorKind::Syntax self.add_error
        fi
    }

    pub fn lex_number self:mut$Lexer -> common::Token {
        self Lexer::cursor parser::Cursor::pos = start
        if '-' start self Lexer::cursor parser::Cursor::source.at == then
            self Lexer::cursor.advance drop
        fi
        self.lex_digits
        if self.can_lex_fraction then
            start self.lex_fraction
        fi
        start self.lex_exponent
        self Lexer::cursor parser::Cursor::pos = number_end
        number_end start - start self.loc = loc
        self Lexer::cursor parser::Cursor::source start number_end start - str::substring = value
        loc common::TokenKind::Literal value common::Token::new
    }

    pub fn parse_hex_escape self:mut$Lexer -> std::Option[std::String] {
        self Lexer::cursor.advance = high_opt
        if high_opt.is_none then
            2 self Lexer::cursor parser::Cursor::pos 2 - self.loc = loc
            loc "Expected two hex digits after \\x" common::ErrorKind::Syntax self.add_error
            "".to_str std::Option::Some return
        fi
        high_opt.unwrap hex_digit_value = high_value
        if 0 high_value < then
            3 self Lexer::cursor parser::Cursor::pos 3 - self.loc = loc
            loc "Invalid hex digit in \\x escape" common::ErrorKind::Syntax self.add_error
            "".to_str std::Option::Some return
        fi
        self Lexer::cursor.advance = low_opt
        if low_opt.is_none then
            3 self Lexer::cursor parser::Cursor::pos 3 - self.loc = loc
            loc "Expected two hex digits after \\x" common::ErrorKind::Syntax self.add_error
            "".to_str std::Option::Some return
        fi
        low_opt.unwrap hex_digit_value = low_value
        if 0 low_value < then
            4 self Lexer::cursor parser::Cursor::pos 4 - self.loc = loc
            loc "Invalid hex digit in \\x escape" common::ErrorKind::Syntax self.add_error
            "".to_str std::Option::Some return
        fi
        high_value 16 * low_value + = hex_value
        if 127 hex_value > then
            4 self Lexer::cursor parser::Cursor::pos 4 - self.loc = loc
            loc "Non-ASCII \\x escape is not valid text; use \\u{...}" common::ErrorKind::Syntax self.add_error
            "".to_str std::Option::Some return
        fi
        hex_value (u32) char::from_codepoint.unwrap.to_str std::Option::Some
    }

    pub fn parse_unicode_escape self:mut$Lexer -> std::Option[std::String] {
        self Lexer::cursor parser::Cursor::pos 2 - = start
        self Lexer::cursor.advance = open_opt
        if open_opt.is_none then
            2 start self.loc "Expected `{` after \\u" common::ErrorKind::Syntax self.add_error
            "".to_str std::Option::Some return
        fi
        if open_opt std::Option::Some(open) is then
            if '{' open != then
                3 start self.loc "Expected `{` after \\u" common::ErrorKind::Syntax self.add_error
                "".to_str std::Option::Some return
            fi
        fi

        0 (u32) = codepoint
        0 (u64) = digit_count
        false = invalid_digit
        false = closed
        while self Lexer::cursor.is_eof ! do
            self Lexer::cursor.advance = digit_opt
            if digit_opt.is_none then
                break
            fi
            digit_opt.unwrap = digit_char
            if '}' digit_char == then
                true = closed
                break
            fi
            1 += digit_count
            digit_char hex_digit_value = digit
            if 0 digit < then
                true = invalid_digit
            elif 6 digit_count <= then
                codepoint 16 * digit (u32) + = codepoint
            fi
        done

        self Lexer::cursor parser::Cursor::pos start - = length
        if closed ! then
            length start self.loc "Unclosed Unicode escape" common::ErrorKind::Syntax self.add_error
            "".to_str std::Option::Some return
        fi
        if invalid_digit 0 digit_count == || 6 digit_count > || then
            length start self.loc "Invalid Unicode escape" common::ErrorKind::Syntax self.add_error
            "".to_str std::Option::Some return
        fi
        if codepoint is_unicode_scalar ! then
            length start self.loc "Unicode escape is not a scalar value" common::ErrorKind::Syntax self.add_error
            "".to_str std::Option::Some return
        fi
        codepoint char::from_codepoint.unwrap.to_str std::Option::Some
    }

    pub fn parse_escape self:mut$Lexer -> std::Option[std::String] {
        '\0' = char_val
        self Lexer::cursor.advance match
            std::Option::Some(value) => value = char_val
            std::Option::None => std::Option[std::String]::None return
        end
        char_val match
            'n' => "\n".to_str std::Option::Some return
            't' => "\t".to_str std::Option::Some return
            '\\' => "\\".to_str std::Option::Some return
            '"' => "\"".to_str std::Option::Some return
            '0' => "\0".to_str std::Option::Some return
            'r' => "\r".to_str std::Option::Some return
            '{' => "{".to_str std::Option::Some return
            '}' => "}".to_str std::Option::Some return
            '\'' => "'".to_str std::Option::Some return
            _ => {
            }
        end
        if 'x' char_val == then
            self.parse_hex_escape return
        fi
        if 'u' char_val == then
            self.parse_unicode_escape return
        fi
        2 self Lexer::cursor parser::Cursor::pos 2 - self.loc = loc
        loc "Invalid escape sequence" common::ErrorKind::Syntax self.add_error
        "".to_str std::Option::Some
    }

    pub fn parse_string self:mut$Lexer -> std::String {
        self Lexer::cursor parser::Cursor::pos = start
        self Lexer::cursor.advance drop # skip "
        std::String::new = builder
        '"' builder.push
        false = closed
        while self Lexer::cursor.is_eof ! do
            self Lexer::cursor.advance = char_opt
            if char_opt.is_none then
                break
            fi
            char_opt.unwrap = character
            if '\\' character == then
                self.parse_escape = escape
                if escape.is_none then
                    break
                fi
                if escape std::Option::Some(escaped) is then
                    escaped.clone builder.append_string
                fi
                continue
            fi
            if '"' character == then
                '"' builder.push
                true = closed
                break
            fi
            character builder push_source_byte
        done
        if closed ! then
            self Lexer::cursor parser::Cursor::pos start - start self.loc = error_loc
            error_loc "Unclosed string literal" common::ErrorKind::Syntax self.add_error
        fi
        builder
    }

    pub fn parse_char self:mut$Lexer -> common::Token {
        self Lexer::cursor parser::Cursor::pos = start
        self Lexer::cursor.advance drop # skip '

        self Lexer::cursor.peek = next_opt
        if next_opt.is_none then
            self Lexer::cursor parser::Cursor::pos start - start self.loc = error_loc
            error_loc "Unclosed char literal" common::ErrorKind::Syntax self.add_error
            error_loc common::TokenKind::Literal "'\0'".to_str common::Token::new return
        fi
        next_opt.unwrap = next_char
        std::String::new = char_value

        if '\\' next_char == then
            self Lexer::cursor.advance drop
            self.parse_escape = escape
            if escape.is_none then
                self Lexer::cursor parser::Cursor::pos start - start self.loc = error_loc2
                error_loc2 common::TokenKind::Literal "'\0'".to_str common::Token::new return
            fi
            escape.unwrap = char_value
        elif '\'' next_char == then
            self Lexer::cursor.advance drop
            self Lexer::cursor parser::Cursor::pos start - start self.loc = error_loc3
            error_loc3 "Empty char literal" common::ErrorKind::Syntax self.add_error
            error_loc3 common::TokenKind::Literal "'\0'".to_str common::Token::new return
        else
            self Lexer::cursor parser::Cursor::pos = scalar_offset
            self Lexer::cursor parser::Cursor::source scalar_offset decode_utf8_scalar = decoded_opt
            if decoded_opt std::Option::Some(decoded) is then
                self Lexer::cursor parser::Cursor::source scalar_offset decoded.byte_length str::substring = char_value
                decoded.byte_length self Lexer::cursor parser::Cursor::skip
            else
                self Lexer::cursor.advance drop
                1 scalar_offset self.loc "Invalid UTF-8 in char literal" common::ErrorKind::Syntax self.add_error
            fi
        fi

        # Expect closing '
        self Lexer::cursor.advance = closing
        if closing.is_none then
            self Lexer::cursor parser::Cursor::pos start - start self.loc = error_loc4
            error_loc4 "Unclosed char literal" common::ErrorKind::Syntax self.add_error
        else
            if closing std::Option::Some(closing_char) is then
                if '\'' closing_char != then
                    self Lexer::cursor parser::Cursor::pos start - start self.loc = error_loc5
                    error_loc5 "Character literal must contain exactly one Unicode scalar value" common::ErrorKind::Syntax self.add_error
                    while self Lexer::cursor.is_eof ! do
                        self Lexer::cursor.advance = recovery_opt
                        if recovery_opt std::Option::Some(recovery_char) is then
                            if '\'' recovery_char == '\n' recovery_char == || then
                                break
                            fi
                        fi
                    done
                fi
            fi
        fi

        self Lexer::cursor parser::Cursor::pos start - start self.loc = final_loc
        std::String::new = result
        '\'' result.push
        char_value result.append_string
        '\'' result.push
        final_loc common::TokenKind::Literal result common::Token::new
    }

    pub fn peek_word self:mut$Lexer -> std::Option[std::String] {
        if self Lexer::cursor.is_eof then
            std::Option::None return
        fi
        self Lexer::cursor parser::Cursor::pos = position
        self Lexer::cursor parser::Cursor::source = source: $str
        std::String::new = builder

        while position source.length > do
            position source.at = character
            if character common::delimiter_from_char.is_some then
                break
            fi
            if character.is_space then
                break
            fi
            builder.as_str = word
            if "->" word == then
                break
            fi
            if "=>" word == then
                break
            fi
            if word "->" str::ends_with then
                word.length = word_length
                word 0 word_length 2 - str::substring std::Option::Some return
            fi
            if word "=>" str::ends_with then
                word.length = word_length
                word 0 word_length 2 - str::substring std::Option::Some return
            fi
            character builder push_source_byte
            1 += position
        done

        builder = final_word
        if 0 final_word.length == then
            std::Option::None
        else
            final_word std::Option::Some
        fi
    }

    pub fn lex_multichar self:mut$Lexer -> std::Option[common::Token] {
        self Lexer::cursor parser::Cursor::pos = start
        # String literal
        if "\"" self.startswith then
            self.parse_string = str_value
            self Lexer::cursor parser::Cursor::pos start - start self.loc = str_loc
            str_loc common::TokenKind::Literal str_value common::Token::new std::Option::Some return
        fi

        std::String::new = value
        self.peek_word match
            std::Option::Some(word) => word = value
            std::Option::None => std::Option[common::Token]::None return
        end
        value.length = length
        length start self.loc = loc
        self Lexer::cursor parser::Cursor::pos length + self Lexer::cursor parser::Cursor::set_pos

        # Previous char is digit?
        false = prev_digit
        if 0 start != then
            start 1 - self Lexer::cursor parser::Cursor::source.at.is_digit = prev_digit
        fi

        # Negative integer literal
        if value.as_str is_negative_integer_literal prev_digit ! && then
            loc common::TokenKind::Literal value common::Token::new std::Option::Some return
        fi
        # Boolean literals
        if "true" value.as_str == "false" value.as_str == || then
            loc common::TokenKind::Literal value common::Token::new std::Option::Some return
        fi
        # Delimiter
        if value.as_str common::delimiter_from_str.is_some then
            loc common::TokenKind::Delimiter value common::Token::new std::Option::Some return
        fi
        # Intrinsic
        if value.as_str common::intrinsic_from_str.is_some then
            loc common::TokenKind::Intrinsic value common::Token::new std::Option::Some return
        fi
        # Keyword
        if value.as_str common::keyword_from_str.is_some then
            loc common::TokenKind::Keyword value common::Token::new std::Option::Some return
        fi
        # Operator
        if value.as_str common::operator_from_str.is_some then
            loc common::TokenKind::Operator value common::Token::new std::Option::Some return
        fi
        # :: chaining
        if "::" self.startswith then
            self Lexer::cursor parser::Cursor::pos 2 + self Lexer::cursor parser::Cursor::set_pos
            self.lex_multichar = method_opt
            method_opt match
                std::Option::Some(method_token) => {
                    method_token common::Token::value.clone = method_name
                    f"{value}::{method_name}" = full_name
                    full_name.length start self.loc = full_loc
                    full_loc common::TokenKind::Identifier full_name common::Token::new std::Option::Some return
                }
                std::Option::None => {
                    loc "Expected method name after `::`" common::ErrorKind::Syntax self.add_error
                    loc common::TokenKind::Identifier value common::Token::new std::Option::Some return
                }
            end
        fi
        # Identifier
        loc common::TokenKind::Identifier value common::Token::new std::Option::Some
    }

    pub fn lex_fstring_expr self:mut$Lexer tokens:mut$std::List[common::Token] {
        0 = depth
        while self Lexer::cursor.is_eof ! do
            self.skip_whitespace
            self.lex_newline = newline_opt
            newline_opt match
                std::Option::Some(newline) => {
                    newline tokens.push
                    continue
                }
                std::Option::None => {
                }
            end
            if self Lexer::cursor.is_eof then
                break
            fi
            self Lexer::cursor.peek = char_opt
            if char_opt.is_none then
                break
            fi
            char_opt.unwrap = character
            # Nested f-string
            if "f\"" self.startswith then
                tokens self.lex_fstring
                continue
            fi
            # Closing }
            if '}' character == 0 depth == && then
                1 self.cur_loc = end_loc
                end_loc common::TokenKind::FstringExprEnd "}".to_str common::Token::new tokens.push
                self Lexer::cursor.advance drop
                return
            fi
            if '{' character == then
                1 += depth
            fi
            if '}' character == then
                depth 1 - = depth
            fi
            self.parse_single_token = token_opt
            token_opt match
                std::Option::Some(token) => token tokens.push
                std::Option::None => {
                }
            end
        done
        0 self.cur_loc "Unclosed f-string expression" common::ErrorKind::Syntax self.add_error
    }

    pub fn lex_fstring self:mut$Lexer tokens:mut$std::List[common::Token] {
        self Lexer::cursor parser::Cursor::pos = start
        2 start self.loc = start_loc
        self Lexer::cursor parser::Cursor::pos 2 + self Lexer::cursor parser::Cursor::set_pos

        start_loc common::TokenKind::FstringStart "".to_str common::Token::new tokens.push
        std::String::new = text
        self Lexer::cursor parser::Cursor::pos = text_start

        while self Lexer::cursor.is_eof ! do
            self Lexer::cursor.peek = char_opt
            if char_opt.is_none then
                break
            fi
            char_opt.unwrap = character
            # Escape
            if '\\' character == then
                self Lexer::cursor.advance drop
                self.parse_escape = escape
                if escape.is_none then
                    break
                fi
                if escape std::Option::Some(escaped) is then
                    escaped.clone text.append_string
                fi
                continue
            fi
            # Expression
            if '{' character == then
                if 0 text.length != then
                    self Lexer::cursor parser::Cursor::pos text_start - text_start self.loc = text_loc
                    text_loc common::TokenKind::FstringText text common::Token::new tokens.push
                    std::String::new = text
                fi
                1 self Lexer::cursor parser::Cursor::pos self.loc = expr_loc
                expr_loc common::TokenKind::FstringExprStart "{".to_str common::Token::new tokens.push
                self Lexer::cursor.advance drop
                tokens self.lex_fstring_expr
                self Lexer::cursor parser::Cursor::pos = text_start
                continue
            fi
            # End
            if '"' character == then
                if 0 text.length != then
                    self Lexer::cursor parser::Cursor::pos text_start - text_start self.loc = text_loc2
                    text_loc2 common::TokenKind::FstringText text common::Token::new tokens.push
                fi
                self Lexer::cursor.advance drop
                1 self Lexer::cursor parser::Cursor::pos 1 - self.loc = end_loc
                end_loc common::TokenKind::FstringEnd "".to_str common::Token::new tokens.push
                return
            fi
            character text push_source_byte
            self Lexer::cursor.advance drop
        done
        self Lexer::cursor parser::Cursor::pos start - start self.loc
        "Unclosed f-string" common::ErrorKind::Syntax self.add_error
    }

    pub fn parse_single_token self:mut$Lexer -> std::Option[common::Token] {
        '\0' = character
        self Lexer::cursor.peek match
            std::Option::Some(value) => value = character
            std::Option::None => std::Option[common::Token]::None return
        end
        # Comment
        if '#' character == then
            if self.formatter then
                self Lexer::cursor parser::Cursor::pos = comment_start
                std::String::new = comment_builder
                '#' comment_builder.push
                self Lexer::cursor.advance drop
                while self Lexer::cursor.is_eof ! do
                    self Lexer::cursor.peek = peek_opt
                    if peek_opt.is_none then
                        break
                    fi
                    if peek_opt std::Option::Some(peek_char) is then
                        if '\n' peek_char == '\r' peek_char == || then
                            break
                        fi
                        peek_char comment_builder push_source_byte
                        self Lexer::cursor.advance drop
                    fi
                done
                self Lexer::cursor parser::Cursor::pos comment_start - comment_start self.loc = comment_loc
                comment_loc common::TokenKind::Comment comment_builder common::Token::new std::Option::Some return
            fi
            self.skip_line
            std::Option::None return
        fi
        # Char literal
        if '\'' character == then
            self.parse_char std::Option::Some return
        fi
        # Single-char delimiter
        if character common::delimiter_from_char.is_some then
            self Lexer::cursor parser::Cursor::pos = position
            std::String::new = builder
            character builder.push
            1 position self.loc = loc
            loc common::TokenKind::Delimiter builder common::Token::new std::Option::Some
            self Lexer::cursor.advance drop
            return
        fi
        # Numeric literal
        if character.is_digit then
            self.lex_number std::Option::Some return
        fi
        if '-' character == then
            self Lexer::cursor parser::Cursor::pos = number_start
            self Lexer::cursor parser::Cursor::source = number_source: $str
            false = previous_is_digit
            if 0 number_start != then
                number_start 1 - number_source.at.is_digit = previous_is_digit
            fi
            if number_start 1 + number_source.length > then
                if number_start 1 + number_source.at.is_digit previous_is_digit ! && then
                    self.lex_number std::Option::Some return
                fi
            fi
        fi
        # Multichar
        self.lex_multichar
    }

    pub fn lex self:Lexer -> LexResult {
        0 (u64) = utf8_offset
        while utf8_offset self Lexer::cursor parser::Cursor::source.length > do
            self Lexer::cursor parser::Cursor::source utf8_offset decode_utf8_scalar = decoded_opt
            if decoded_opt std::Option::Some(decoded) is then
                decoded.byte_length += utf8_offset
            else
                1 utf8_offset self.loc "Source is not valid UTF-8" common::ErrorKind::Syntax self.add_error
                1 += utf8_offset
            fi
        done

        std::List[common::Token]::new = tokens
        while self Lexer::cursor.is_eof ! do
            self.skip_whitespace
            if self Lexer::cursor.is_eof then
                break
            fi
            # Emit one logical newline token for LF, CRLF, or bare CR.
            self.lex_newline = newline_opt
            newline_opt match
                std::Option::Some(newline) => {
                    newline tokens.push
                    continue
                }
                std::Option::None => {
                }
            end
            if "f\"" self.startswith then
                tokens self.lex_fstring
                continue
            fi
            self.parse_single_token = token_opt
            token_opt match
                std::Option::Some(token) => token tokens.push
                std::Option::None => {
                }
            end
        done
        0 self.cur_loc common::TokenKind::Eof "".to_str common::Token::new tokens.push
        self match
            Lexer { diagnostics: diagnostics } => diagnostics tokens LexResult
        end
    }
}

# ============================================================================
# Escape sequence
# ============================================================================

pub fn hex_digit_value character:char -> i64 {
    if '0' character >= '9' character <= && then
        character.codepoint i64::from '0'.codepoint i64::from -
    elif 'a' character >= 'f' character <= && then
        character.codepoint i64::from 'a'.codepoint i64::from - 10 +
    elif 'A' character >= 'F' character <= && then
        character.codepoint i64::from 'A'.codepoint i64::from - 10 +
    else
        -1
    fi
}

# ============================================================================
# Negative integer literal check
# ============================================================================

pub fn is_negative_integer_literal value:$str -> bool {
    if 2 value.length < then
        false return
    fi
    if '-' 0 value.at != then
        false return
    fi
    1 (u64) = index
    while index value.length > do
        if index value.at.is_digit ! then
            false return
        fi
        1 += index
    done
    true
}

pub fn is_float_literal value:$str -> bool {
    if 0 value.length == then
        false return
    fi
    if 0 value.at.is_digit ! then
        if '-' 0 value.at != then
            false return
        fi
        if 2 value.length < then
            false return
        fi
        if 1 value.at.is_digit ! then
            false return
        fi
    fi
    value "." str::contains
    value "e" str::contains ||
    value "E" str::contains ||
}

# ============================================================================
# Public API
# ============================================================================

pub fn lex_source code:$str file:$str -> LexResult { false file.to_str code Lexer::new.lex }

pub fn lex_file path:$str sources:mut$SourceStore -> std::Result[LexResult os::IoError] {
    path normalize_path = normalized_path
    if normalized_path.as_str sources.sources.get_str std::Option::Some(source) is then
        path source.as_str lex_source std::Result::Ok return
    fi
    normalized_path.as_str file::read_all = read_result
    read_result match
        std::Result::Ok(read_bytes) => {
            read_bytes.to_str match
                std::Result::Error(utf8_error) => {
                    error::Diagnostics::new = diagnostics
                    1 utf8_error.index normalized_path.clone common::Location::new = location
                    location f"Source is not valid UTF-8 at byte {utf8_error.index}"
                    common::ErrorKind::Syntax diagnostics.record_error_string
                    diagnostics std::List[common::Token]::new LexResult std::Result::Ok return
                }
                std::Result::Ok(read_source) => {
                    read_source.as_str normalized_path.as_str sources.add
                }
            end
            normalized_path.as_str sources
                .sources
                .get_str
                .unwrap = cached_source
            path cached_source.as_str lex_source std::Result::Ok
        }
        std::Result::Error(error) => error std::Result::Error
    end
}

pub fn lex_source_fmt code:$str file:$str -> LexResult { true file.to_str code Lexer::new.lex }
