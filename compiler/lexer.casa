# Tokenizer for the Casa programming language.
import "std"
import "os"
import "parser"
import "common"
import "error"

# ============================================================================
# Escape sequence map
# ============================================================================
Map::new(Map[int str]) = ESCAPE_SEQUENCES
"\n" 'n' (int) ESCAPE_SEQUENCES.set = ESCAPE_SEQUENCES
"\t" 't' (int) ESCAPE_SEQUENCES.set = ESCAPE_SEQUENCES
"\\" '\\' (int) ESCAPE_SEQUENCES.set = ESCAPE_SEQUENCES
"\"" '"' (int) ESCAPE_SEQUENCES.set = ESCAPE_SEQUENCES
"\0" '0' (int) ESCAPE_SEQUENCES.set = ESCAPE_SEQUENCES
"\r" 'r' (int) ESCAPE_SEQUENCES.set = ESCAPE_SEQUENCES
"{" '{' (int) ESCAPE_SEQUENCES.set = ESCAPE_SEQUENCES
"}" '}' (int) ESCAPE_SEQUENCES.set = ESCAPE_SEQUENCES
"'" '\'' (int) ESCAPE_SEQUENCES.set = ESCAPE_SEQUENCES

# ============================================================================
# Lexer state
# ============================================================================

fn normalize_path path:str -> str {
    # Resolve ".." components in a path.
    path "/" str::starts_with = is_absolute

    # Split by "/" and process each component.
    List::new(List[str]) = parts
    0 = start
    0 = scan
    while scan path.length > do
        if '/' scan path.at == then
            if start scan != then
                path start scan start - str::substring parts.push
            fi
            scan 1 + = start
        fi
        1 += scan
    done
    if start path.length != then
        path start path.length start - str::substring parts.push
    fi

    # Process parts, resolving ".."
    List::new(List[str]) = resolved_parts
    for part in parts.iter do
        if ".." part == then
            if 0 resolved_parts.length != then
                resolved_parts.pop drop
            fi
        elif "." part != then
            part resolved_parts.push
        fi
    done

    # Rebuild path
    "/" resolved_parts.join = path_body
    if is_absolute then
        "/" path_body str::concat
    else
        path_body
    fi
}

struct SourceStore {
    sources: Map[str str]
}

struct SourceContext {
    position:    SourcePosition
    source_line: str
}

impl SourceStore {
    fn new -> SourceStore {
        Map::new(Map[str str]) SourceStore
    }

    fn add self:SourceStore path:str source:str {
        source path normalize_path self.sources.set = self.sources
    }

    fn get self:SourceStore path:str -> Option[str] {
        path normalize_path self.sources.get
    }

    fn get_context self:SourceStore path:str offset:int -> Option[SourceContext] {
        if path self.get Option::Some(source) is then
            if offset source.length < then source.length = offset fi
            if 0 offset < then 0 = offset fi

            1 = line
            0 = line_start
            0 = index
            while index offset > do
                if '\n' index source.at == then
                    1 += line
                    index 1 + = line_start
                fi
                1 += index
            done

            offset = line_end
            while line_end source.length > do
                if '\n' line_end source.at == then break fi
                1 += line_end
            done

            source line_start line_end line_start - str::substring = source_line
            source_line offset line_start - 1 + line SourcePosition::new SourceContext Option::Some
            return
        fi
        Option::None(Option[SourceContext])
    }

    fn convert_offset_to_position self:SourceStore path:str offset:int -> Option[SourcePosition] {
        if offset path self.get_context Option::Some(context) is then
            context.position Option::Some
        else
            Option::None(Option[SourcePosition])
        fi
    }

    fn convert_position_to_offset self:SourceStore path:str position:SourcePosition -> Option[int] {
        if path self.get Option::Some(source) is then
            position.line = target_line
            position.column = column
            if target_line 1 > then 1 = target_line fi
            if column 1 > then 1 = column fi

            1 = line
            0 = offset
            0 = scan
            while
            scan source.length >
            line target_line > &&
            do
                if '\n' scan source.at == then
                    scan 1 + = offset
                    1 += line
                fi
                1 += scan
            done
            offset column 1 - + Option::Some return
        fi
        Option::None(Option[int])
    }

    fn append_source_context self:SourceStore location:Location builder:StringBuilder {
        if "" location.file == then return fi
        if location.span.offset location.file self.get_context Option::Some(context) is then
            "\n" builder.append
            location.span.length context.position context.source_line location.file
            format_source_context builder.append
        fi
    }

    fn format_error self:SourceStore error:CasaError -> str {
        StringBuilder::new = builder
        "error[" builder.append
        error.kind error_kind_name builder.append
        "]: " builder.append
        error.message builder.append

        builder error.location self.append_source_context

        if error.expected Option::Some(expected) is then
            "\n  Expected: " builder.append
            expected builder.append
        fi
        if error.got Option::Some(got) is then
            "\n  " builder.append
            error.got_label builder.append
            ": " builder.append
            got builder.append
        fi

        for note in error.notes.iter do
            "\n  Note: " builder.append
            note.message builder.append
            builder note.location self.append_source_context
        done

        builder.build
    }

    fn read self:SourceStore path:str -> Result[str IoError] {
        path normalize_path = path
        path self.sources.get = source
        if source.is_some then source.unwrap Result::Ok return fi
        path file::read_all = result
        if result Result::Ok(contents) is then
            contents path self.sources.set = self.sources
        fi
        result
    }
}

struct LexResult {
    tokens:      List[Token]
    diagnostics: Diagnostics
}

struct Lexer {
    cursor:      Cursor
    file:        str
    formatter:   bool
    diagnostics: Diagnostics
}

impl Lexer {
    fn new source:str file:str formatter:bool -> Lexer {
        Diagnostics::new formatter file source Cursor::new Lexer
    }

    fn loc self:Lexer offset:int length:int -> Location {
        length offset self Lexer::file Location::new
    }

    fn cur_loc self:Lexer length:int -> Location {
        length self Lexer::cursor Cursor::pos self.loc
    }

    fn skip_whitespace self:Lexer {
        while self Lexer::cursor.is_eof ! do
            self Lexer::cursor.peek = char_opt
            if char_opt.is_none then break fi
            char_opt.unwrap = ch
            if self.formatter then
                if ch ' ' == ch '\t' == || ! then break fi
            else
                if ch.is_space ! then break fi
            fi
            self Lexer::cursor.advance drop
        done
    }

    fn skip_line self:Lexer {
        while self Lexer::cursor.is_eof ! do
            self Lexer::cursor.advance = char_opt
            if char_opt.is_none then break fi
            if char_opt Option::Some(ch) is then
                if '\n' ch == then break fi
            fi
        done
    }

    fn startswith self:Lexer prefix:str -> bool {
        prefix self Lexer::cursor.starts_with
    }

    fn add_error self:Lexer kind:ErrorKind message:str location:Location {
        location message kind CasaError::new self.diagnostics.push_error
    }

    fn lex_integer self:Lexer -> Token {
        self Lexer::cursor Cursor::pos = start
        StringBuilder::new = builder
        while self Lexer::cursor.is_eof ! do
            self Lexer::cursor.peek = char_opt
            if char_opt.is_none then break fi
            if char_opt Option::Some(ch) is then
                if ch.is_digit ! then break fi
                ch builder.append_char
            fi
            self Lexer::cursor.advance drop
        done
        self Lexer::cursor Cursor::pos start - start self.loc = loc
        loc TokenKind::Literal builder.build Token::new
    }

    fn parse_hex_escape self:Lexer -> Option[str] {
        self Lexer::cursor.advance = high_opt
        if high_opt.is_none then
            2 self Lexer::cursor Cursor::pos 2 - self.loc = loc
            loc "Expected two hex digits after \\x" ErrorKind::Syntax self.add_error
            "" Option::Some return
        fi
        high_opt.unwrap hex_digit_value = high_value
        if 0 high_value < then
            3 self Lexer::cursor Cursor::pos 3 - self.loc = loc
            loc "Invalid hex digit in \\x escape" ErrorKind::Syntax self.add_error
            "" Option::Some return
        fi
        self Lexer::cursor.advance = low_opt
        if low_opt.is_none then
            3 self Lexer::cursor Cursor::pos 3 - self.loc = loc
            loc "Expected two hex digits after \\x" ErrorKind::Syntax self.add_error
            "" Option::Some return
        fi
        low_opt.unwrap hex_digit_value = low_value
        if 0 low_value < then
            4 self Lexer::cursor Cursor::pos 4 - self.loc = loc
            loc "Invalid hex digit in \\x escape" ErrorKind::Syntax self.add_error
            "" Option::Some return
        fi
        high_value 16 * low_value + (char) = hex_char
        StringBuilder::new = hex_builder
        hex_char hex_builder.append_char
        hex_builder.build Option::Some
    }

    fn parse_escape self:Lexer -> Option[str] {
        self Lexer::cursor.advance ? = char_val
        char_val (int) ESCAPE_SEQUENCES.get = result
        if result.is_some then
            result return
        fi
        if 'x' char_val == then
            self.parse_hex_escape return
        fi
        2 self Lexer::cursor Cursor::pos 2 - self.loc = loc
        loc "Invalid escape sequence" ErrorKind::Syntax self.add_error
        "" Option::Some
    }

    fn parse_string self:Lexer -> str {
        self Lexer::cursor Cursor::pos = start
        self Lexer::cursor.advance drop # skip "
        StringBuilder::new = builder
        '"' builder.append_char
        false = closed
        while self Lexer::cursor.is_eof ! do
            self Lexer::cursor.advance = char_opt
            if char_opt.is_none then break fi
            char_opt.unwrap = character
            if '\\' character == then
                self.parse_escape = escape
                if escape.is_none then break fi
                if escape Option::Some(escaped) is then
                    escaped builder.append
                fi
                continue
            fi
            if '"' character == then
                '"' builder.append_char
                true = closed
                break
            fi
            character builder.append_char
        done
        if closed ! then
            self Lexer::cursor Cursor::pos start - start self.loc = error_loc
            error_loc "Unclosed string literal" ErrorKind::Syntax self.add_error
        fi
        builder.build
    }

    fn parse_char self:Lexer -> Token {
        self Lexer::cursor Cursor::pos = start
        self Lexer::cursor.advance drop # skip '

        self Lexer::cursor.advance = next_opt
        if next_opt.is_none then
            self Lexer::cursor Cursor::pos start - start self.loc = error_loc
            error_loc "Unclosed char literal" ErrorKind::Syntax self.add_error
            error_loc TokenKind::Literal "'\0'" Token::new return
        fi
        next_opt.unwrap = next_char
        "" = char_value

        if '\\' next_char == then
            self.parse_escape = escape
            if escape.is_none then
                self Lexer::cursor Cursor::pos start - start self.loc = error_loc2
                error_loc2 TokenKind::Literal "'\0'" Token::new return
            fi
            escape.unwrap = char_value
        elif '\'' next_char == then
            self Lexer::cursor Cursor::pos start - start self.loc = error_loc3
            error_loc3 "Empty char literal" ErrorKind::Syntax self.add_error
            error_loc3 TokenKind::Literal "'\0'" Token::new return
        else
            StringBuilder::new = char_builder
            next_char char_builder.append_char
            char_builder.build = char_value
        fi

        # Expect closing '
        self Lexer::cursor.advance = closing
        if closing.is_none then
            self Lexer::cursor Cursor::pos start - start self.loc = error_loc4
            error_loc4 "Unclosed char literal" ErrorKind::Syntax self.add_error
        else
            if closing Option::Some(closing_char) is then
                if '\'' closing_char != then
                    self Lexer::cursor Cursor::pos start - start self.loc = error_loc5
                    error_loc5 "Unclosed char literal" ErrorKind::Syntax self.add_error
                fi
            fi
        fi

        self Lexer::cursor Cursor::pos start - start self.loc = final_loc
        StringBuilder::new = result
        '\'' result.append_char
        char_value result.append
        '\'' result.append_char
        final_loc TokenKind::Literal result.build Token::new
    }

    fn peek_word self:Lexer -> Option[str] {
        if self Lexer::cursor.is_eof then
            Option::None return
        fi
        self Lexer::cursor Cursor::source = source
        self Lexer::cursor Cursor::pos = position
        StringBuilder::new = builder

        while position source.length > do
            position source.at = character
            if character delimiter_from_char.is_some then break fi
            if character.is_space then break fi
            builder.build = word
            if "->" word == then break fi
            if "=>" word == then break fi
            if word "->" str::ends_with then
                word 0 word.length 2 - str::substring Option::Some return
            fi
            if word "=>" str::ends_with then
                word 0 word.length 2 - str::substring Option::Some return
            fi
            character builder.append_char
            1 += position
        done

        builder.build = final_word
        if 0 final_word.length == then
            Option::None
        else
            final_word Option::Some
        fi
    }

    fn lex_multichar self:Lexer -> Option[Token] {
        self Lexer::cursor Cursor::pos = start
        # String literal
        if "\"" self.startswith then
            self.parse_string = str_value
            self Lexer::cursor Cursor::pos start - start self.loc = str_loc
            str_loc TokenKind::Literal str_value Token::new Option::Some return
        fi

        self.peek_word ? = value
        value.length = length
        length start self.loc = loc
        self Lexer::cursor Cursor::pos length + self Lexer::cursor Cursor::set_pos

        # Previous char is digit?
        false = prev_digit
        if 0 start != then
            start 1 - self Lexer::cursor Cursor::source.at.is_digit = prev_digit
        fi

        # Negative integer literal
        if value is_negative_integer_literal prev_digit ! && then
            loc TokenKind::Literal value Token::new Option::Some return
        fi
        # Boolean literals
        if "true" value == "false" value == || then
            loc TokenKind::Literal value Token::new Option::Some return
        fi
        # Delimiter
        if value delimiter_from_str.is_some then
            loc TokenKind::Delimiter value Token::new Option::Some return
        fi
        # Intrinsic
        if value intrinsic_from_str.is_some then
            loc TokenKind::Intrinsic value Token::new Option::Some return
        fi
        # Keyword
        if value keyword_from_str.is_some then
            loc TokenKind::Keyword value Token::new Option::Some return
        fi
        # Operator
        if value operator_from_str.is_some then
            loc TokenKind::Operator value Token::new Option::Some return
        fi
        # :: chaining
        if "::" self.startswith then
            self Lexer::cursor Cursor::pos 2 + self Lexer::cursor Cursor::set_pos
            self.lex_multichar = method_opt
            if method_opt.is_none then
                loc "Expected method name after `::`" ErrorKind::Syntax self.add_error
                loc TokenKind::Identifier value Token::new Option::Some return
            fi
            if method_opt Option::Some(method_token) is then
                method_token Token::value = method_name
                f"{value}::{method_name}" = full_name
                full_name.length start self.loc = full_loc
                full_loc TokenKind::Identifier full_name Token::new Option::Some return
            fi
        fi
        # Identifier
        loc TokenKind::Identifier value Token::new Option::Some
    }

    fn lex_fstring_expr self:Lexer tokens:List[Token] {
        0 = depth
        while self Lexer::cursor.is_eof ! do
            self.skip_whitespace
            if self Lexer::cursor.is_eof then break fi
            self Lexer::cursor.peek = char_opt
            if char_opt.is_none then
                break
            fi
            char_opt.unwrap = character
            # Nested f-string
            if "f\"" self.startswith then
                tokens self.lex_fstring
                continue
            fi
            # Closing }
            if '}' character == 0 depth == && then
                1 self.cur_loc = end_loc
                end_loc TokenKind::FstringExprEnd "}" Token::new tokens.push
                self Lexer::cursor.advance drop
                return
            fi
            if '{' character == then
                1 += depth
            fi
            if '}' character == then
                depth 1 - = depth
            fi
            self.parse_single_token = token_opt
            if token_opt Option::Some(token) is then
                token tokens.push
            fi
        done
        0 self.cur_loc "Unclosed f-string expression" ErrorKind::Syntax self.add_error
    }

    fn lex_fstring self:Lexer tokens:List[Token] {
        self Lexer::cursor Cursor::pos = start
        2 start self.loc = start_loc
        self Lexer::cursor Cursor::pos 2 + self Lexer::cursor Cursor::set_pos

        start_loc TokenKind::FstringStart "" Token::new tokens.push
        StringBuilder::new = text
        self Lexer::cursor Cursor::pos = text_start

        while self Lexer::cursor.is_eof ! do
            self Lexer::cursor.peek = char_opt
            if char_opt.is_none then
                break
            fi
            char_opt.unwrap = character
            # Escape
            if '\\' character == then
                self Lexer::cursor.advance drop
                self.parse_escape = escape
                if escape.is_none then break fi
                if escape Option::Some(escaped) is then
                    escaped text.append
                fi
                continue
            fi
            # Expression
            if '{' character == then
                if 0 text.length != then
                    self Lexer::cursor Cursor::pos text_start - text_start self.loc = text_loc
                    text_loc TokenKind::FstringText text.build Token::new tokens.push
                    StringBuilder::new = text
                fi
                1 self Lexer::cursor Cursor::pos self.loc = expr_loc
                expr_loc TokenKind::FstringExprStart "{" Token::new tokens.push
                self Lexer::cursor.advance drop
                tokens self.lex_fstring_expr
                self Lexer::cursor Cursor::pos = text_start
                continue
            fi
            # End
            if '"' character == then
                if 0 text.length != then
                    self Lexer::cursor Cursor::pos text_start - text_start self.loc = text_loc2
                    text_loc2 TokenKind::FstringText text.build Token::new tokens.push
                fi
                self Lexer::cursor.advance drop
                1 self Lexer::cursor Cursor::pos 1 - self.loc = end_loc
                end_loc TokenKind::FstringEnd "" Token::new tokens.push
                return
            fi
            character text.append_char
            self Lexer::cursor.advance drop
        done
        self Lexer::cursor Cursor::pos start - start self.loc
        "Unclosed f-string" ErrorKind::Syntax self.add_error
    }

    fn parse_single_token self:Lexer -> Option[Token] {
        self Lexer::cursor.peek ? = character
        # Comment
        if '#' character == then
            if self.formatter then
                self Lexer::cursor Cursor::pos = comment_start
                StringBuilder::new = comment_builder
                '#' comment_builder.append_char
                self Lexer::cursor.advance drop
                while self Lexer::cursor.is_eof ! do
                    self Lexer::cursor.peek = peek_opt
                    if peek_opt.is_none then break fi
                    if peek_opt Option::Some(peek_char) is then
                        if '\n' peek_char == then break fi
                        peek_char comment_builder.append_char
                        self Lexer::cursor.advance drop
                    fi
                done
                self Lexer::cursor Cursor::pos comment_start - comment_start self.loc = comment_loc
                comment_loc TokenKind::Comment comment_builder.build Token::new Option::Some return
            fi
            self.skip_line
            Option::None return
        fi
        # Char literal
        if '\'' character == then
            self.parse_char Option::Some return
        fi
        # Single-char delimiter
        if character delimiter_from_char.is_some then
            self Lexer::cursor Cursor::pos = position
            StringBuilder::new = builder
            character builder.append_char
            1 position self.loc = loc
            loc TokenKind::Delimiter builder.build Token::new Option::Some
            self Lexer::cursor.advance drop
            return
        fi
        # Integer literal
        if character.is_digit then
            self.lex_integer Option::Some return
        fi
        # Multichar
        self.lex_multichar
    }

    fn lex self:Lexer -> LexResult {
        List::new(List[Token]) = tokens
        while self Lexer::cursor.is_eof ! do
            self.skip_whitespace
            if self Lexer::cursor.is_eof then break fi
            # Emit newline tokens in formatter mode
            if self.formatter then
                self Lexer::cursor.peek = nl_opt
                if nl_opt Option::Some(nl_char) is then
                    if '\n' nl_char == then
                        self Lexer::cursor Cursor::pos = nl_pos
                        1 nl_pos self.loc = nl_loc
                        nl_loc TokenKind::Newline "\n" Token::new tokens.push
                        self Lexer::cursor.advance drop
                        continue
                    fi
                fi
            fi
            if "f\"" self.startswith then
                tokens self.lex_fstring
                continue
            fi
            self.parse_single_token = token_opt
            if token_opt Option::Some(token) is then
                token tokens.push
            fi
        done
        0 self.cur_loc TokenKind::Eof "" Token::new tokens.push
        self.diagnostics tokens LexResult
    }
}

# ============================================================================
# Escape sequence
# ============================================================================

fn hex_digit_value character:char -> int {
    if '0' character >= '9' character <= && then
        character (int) '0' (int) -
    elif 'a' character >= 'f' character <= && then
        character (int) 'a' (int) - 10 +
    elif 'A' character >= 'F' character <= && then
        character (int) 'A' (int) - 10 +
    else
        -1
    fi
}

# ============================================================================
# Negative integer literal check
# ============================================================================

fn is_negative_integer_literal value:str -> bool {
    if 2 value.length < then
        false return
    fi
    if '-' 0 value.at != then
        false return
    fi
    1 = index
    while index value.length > do
        if index value.at.is_digit ! then
            false return
        fi
        1 += index
    done
    true
}

# ============================================================================
# Public API
# ============================================================================

fn lex_source code:str file:str -> LexResult {
    false file code Lexer::new.lex
}

fn lex_file path:str sources:SourceStore -> Result[LexResult IoError] {
    path sources.read = read_result
    if read_result Result::Error(read_error) is then read_error Result::Error return fi
    path read_result.unwrap lex_source Result::Ok
}

fn lex_source_fmt code:str file:str -> LexResult {
    true file code Lexer::new.lex
}
