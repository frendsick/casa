# Structured source bodies. Semantic construction owns each body it consumes.
import "std" as std
import "common" as common

# Grammar categories reuse token kinds without admitting checked cleanup or dispatch actions.
pub enum BindingSyntax derives std::Copy std::Eq {
    Read
    Capture
    Assign
    Increment
    Decrement
    Question
}

pub enum CallSyntax derives std::Copy std::Eq {
    Invoke
    Reference
    Method
}

pub enum PointerSyntax derives std::Copy std::Eq {
    FromRef
    IntoRaw
    Null
}

pub enum TypeSyntax derives std::Copy std::Eq {
    SizeOf
    AsRef
    AsMut
    FromRaw
    Read
    Write
}

pub enum SourceTerm derives std::Clone {
    Rejected
    Name(std::String)
    Literal(common::ConstantValue std::Option[common::Type])
    Intrinsic(common::IntrinsicKind)
    Operator(common::OperatorKind)
    Control(common::KeywordKind)
    Binding(BindingSyntax std::String std::Option[common::Type])
    Call(CallSyntax std::String std::Option[common::Type])
    QualifiedMethod(common::QualifiedMethod)
    TraitMethod(CallSyntax SourceTraitMethod)
    Pointer(PointerSyntax)
    TypeQuery(TypeSyntax common::Type)
    Enum(common::EnumVariant std::Option[common::Type])
    PatternTest(common::EnumVariant)
    Struct(common::CasaStruct std::Option[common::Type])
    StructFields(common::StructLiteral std::Option[common::Type])
    NumericCall(common::NumericCall)
    FormatValue
    FormatJoin(u64)
}

pub struct SourceTraitMethod derives std::Clone {
    pub method:     std::String
    pub receiver:   common::Type
    pub trait_type: std::Option[common::Type]
}

pub struct SourceLeaf derives std::Clone {
    pub origin: common::Location
    pub term:   SourceTerm
}

pub struct SourceBody derives std::Clone {
    nodes: std::List[SourceNode]
}

pub enum SourceNode derives std::Clone {
    Leaf(SourceLeaf)
    Rejected(SourceRejection)
    Conditional(SourceConditional)
    Loop(SourceLoop)
    Match(SourceMatch)
    Unsafe(SourceRegion)
    Array(SourceCompound)
    Group(SourceCompound)
}

pub struct SourceRejection derives std::Clone {
    pub origin:  common::Location
    pub message: std::String
}

pub struct SourceBranch derives std::Clone {
    pub origin:           common::Location
    pub condition_origin: common::Location
    pub condition:        SourceBody
    pub consequent:       SourceBody
}

pub struct SourceAlternative derives std::Clone {
    pub origin: common::Location
    pub body:   SourceBody
}

pub struct SourceConditional derives std::Clone {
    pub branches:    std::List[SourceBranch]
    pub alternative: std::Option[SourceAlternative]
    pub end_origin:  common::Location
}

pub struct SourceLoop derives std::Clone {
    pub origin:           common::Location
    pub condition_origin: common::Location
    pub condition:        SourceBody
    pub body:             SourceBody
    pub end_origin:       common::Location
}

pub struct SourceArm derives std::Clone {
    pub origin:    common::Location
    pub pattern:   common::PatternValue
    pub guard:     SourceBody
    pub guard_end: std::Option[u64]
    pub body:      SourceBody
}

pub struct SourceMatch derives std::Clone {
    pub origin:     common::Location
    pub arms:       std::List[SourceArm]
    pub end_origin: common::Location
}

pub struct SourceRegion derives std::Clone {
    pub origin:     common::Location
    pub body:       SourceBody
    pub end_origin: common::Location
}

pub struct SourceCompound derives std::Clone {
    pub origin: common::Location
    pub body:   SourceBody
}

impl SourceBody {
    pub fn get_nodes self:$SourceBody -> $std::List[SourceNode] { self.nodes }

    pub fn into_nodes self:SourceBody -> std::List[SourceNode] {
        self match
            SourceBody { nodes: nodes } => nodes
        end
    }
}

fn select_source_term
    opcode:common::OpValue
    annotation:std::Option[common::Type]
-> std::Result[SourceTerm std::String] {
    opcode match
        common::OpValue::Rejected => SourceTerm::Rejected
        common::OpValue::Identifier(name) => name SourceTerm::Name
        common::OpValue::PushInt(value) => annotation value common::ConstantValue::Int SourceTerm::Literal
        common::OpValue::PushFloat(value) => annotation value common::ConstantValue::Float SourceTerm::Literal
        common::OpValue::PushBool(value) => annotation value common::ConstantValue::Bool SourceTerm::Literal
        common::OpValue::PushChar(value) => annotation value common::ConstantValue::Char SourceTerm::Literal
        common::OpValue::PushStr(value) => annotation value common::ConstantValue::Str SourceTerm::Literal
        common::OpValue::Drop => common::IntrinsicKind::Drop SourceTerm::Intrinsic
        common::OpValue::Dup => common::IntrinsicKind::Dup SourceTerm::Intrinsic
        common::OpValue::Copy => common::IntrinsicKind::Copy SourceTerm::Intrinsic
        common::OpValue::Over => common::IntrinsicKind::Over SourceTerm::Intrinsic
        common::OpValue::Rot => common::IntrinsicKind::Rot SourceTerm::Intrinsic
        common::OpValue::Swap => common::IntrinsicKind::Swap SourceTerm::Intrinsic
        common::OpValue::Load8 => common::IntrinsicKind::Load8 SourceTerm::Intrinsic
        common::OpValue::Load16 => common::IntrinsicKind::Load16 SourceTerm::Intrinsic
        common::OpValue::Load32 => common::IntrinsicKind::Load32 SourceTerm::Intrinsic
        common::OpValue::Load64 => common::IntrinsicKind::Load64 SourceTerm::Intrinsic
        common::OpValue::Store8 => common::IntrinsicKind::Store8 SourceTerm::Intrinsic
        common::OpValue::Store16 => common::IntrinsicKind::Store16 SourceTerm::Intrinsic
        common::OpValue::Store32 => common::IntrinsicKind::Store32 SourceTerm::Intrinsic
        common::OpValue::Store64 => common::IntrinsicKind::Store64 SourceTerm::Intrinsic
        common::OpValue::Print => common::IntrinsicKind::Print SourceTerm::Intrinsic
        common::OpValue::Panic => common::IntrinsicKind::Panic SourceTerm::Intrinsic
        common::OpValue::Typeof => common::IntrinsicKind::Typeof SourceTerm::Intrinsic
        common::OpValue::Syscall0 => common::IntrinsicKind::Syscall0 SourceTerm::Intrinsic
        common::OpValue::Syscall1 => common::IntrinsicKind::Syscall1 SourceTerm::Intrinsic
        common::OpValue::Syscall2 => common::IntrinsicKind::Syscall2 SourceTerm::Intrinsic
        common::OpValue::Syscall3 => common::IntrinsicKind::Syscall3 SourceTerm::Intrinsic
        common::OpValue::Syscall4 => common::IntrinsicKind::Syscall4 SourceTerm::Intrinsic
        common::OpValue::Syscall5 => common::IntrinsicKind::Syscall5 SourceTerm::Intrinsic
        common::OpValue::Syscall6 => common::IntrinsicKind::Syscall6 SourceTerm::Intrinsic
        common::OpValue::Argc => common::IntrinsicKind::Argc SourceTerm::Intrinsic
        common::OpValue::Argv => common::IntrinsicKind::Argv SourceTerm::Intrinsic
        common::OpValue::Envp => common::IntrinsicKind::Envp SourceTerm::Intrinsic
        common::OpValue::HeapAlloc => common::IntrinsicKind::Alloc SourceTerm::Intrinsic
        common::OpValue::HeapFree => common::IntrinsicKind::Free SourceTerm::Intrinsic
        common::OpValue::FnExec => common::IntrinsicKind::Exec SourceTerm::Intrinsic
        common::OpValue::Mul => common::OperatorKind::Mul SourceTerm::Operator
        common::OpValue::Div => common::OperatorKind::Div SourceTerm::Operator
        common::OpValue::Mod => common::OperatorKind::Mod SourceTerm::Operator
        common::OpValue::Shl => common::OperatorKind::Shl SourceTerm::Operator
        common::OpValue::Shr => common::OperatorKind::Shr SourceTerm::Operator
        common::OpValue::BitAnd => common::OperatorKind::BitAnd SourceTerm::Operator
        common::OpValue::BitOr => common::OperatorKind::BitOr SourceTerm::Operator
        common::OpValue::BitXor => common::OperatorKind::BitXor SourceTerm::Operator
        common::OpValue::BitNot => common::OperatorKind::BitNot SourceTerm::Operator
        common::OpValue::And => common::OperatorKind::And SourceTerm::Operator
        common::OpValue::Or => common::OperatorKind::Or SourceTerm::Operator
        common::OpValue::Not => common::OperatorKind::Not SourceTerm::Operator
        common::OpValue::Eq => common::OperatorKind::Eq SourceTerm::Operator
        common::OpValue::Ge => common::OperatorKind::Ge SourceTerm::Operator
        common::OpValue::Gt => common::OperatorKind::Gt SourceTerm::Operator
        common::OpValue::Le => common::OperatorKind::Le SourceTerm::Operator
        common::OpValue::Lt => common::OperatorKind::Lt SourceTerm::Operator
        common::OpValue::Ne => common::OperatorKind::Ne SourceTerm::Operator
        common::OpValue::Add => common::OperatorKind::Plus SourceTerm::Operator
        common::OpValue::Sub => common::OperatorKind::Minus SourceTerm::Operator
        common::OpValue::FnReturn => common::KeywordKind::Return SourceTerm::Control
        common::OpValue::WhileBreak => common::KeywordKind::Break SourceTerm::Control
        common::OpValue::WhileContinue => common::KeywordKind::Continue SourceTerm::Control
        common::OpValue::PushVar(name) => annotation name BindingSyntax::Read SourceTerm::Binding
        common::OpValue::PushCapture(name) => annotation name BindingSyntax::Capture SourceTerm::Binding
        common::OpValue::AssignVar(name) => annotation name BindingSyntax::Assign SourceTerm::Binding
        common::OpValue::AssignInc(name) => annotation name BindingSyntax::Increment SourceTerm::Binding
        common::OpValue::AssignDec(name) => annotation name BindingSyntax::Decrement SourceTerm::Binding
        common::OpValue::Question(name) => annotation name BindingSyntax::Question SourceTerm::Binding
        common::OpValue::FnCall(name) => annotation name CallSyntax::Invoke SourceTerm::Call
        common::OpValue::FnPush(name) => annotation name CallSyntax::Reference SourceTerm::Call
        common::OpValue::MethodCall(name) => annotation name CallSyntax::Method SourceTerm::Call
        common::OpValue::PtrFromRef => PointerSyntax::FromRef SourceTerm::Pointer
        common::OpValue::PtrIntoRaw => PointerSyntax::IntoRaw SourceTerm::Pointer
        common::OpValue::PtrNull => PointerSyntax::Null SourceTerm::Pointer
        common::OpValue::SizeOf(typ) => typ TypeSyntax::SizeOf SourceTerm::TypeQuery
        common::OpValue::PtrAsRef(typ) => typ TypeSyntax::AsRef SourceTerm::TypeQuery
        common::OpValue::PtrAsMut(typ) => typ TypeSyntax::AsMut SourceTerm::TypeQuery
        common::OpValue::PtrFromRaw(typ) => typ TypeSyntax::FromRaw SourceTerm::TypeQuery
        common::OpValue::PtrRead(typ) => typ TypeSyntax::Read SourceTerm::TypeQuery
        common::OpValue::PtrWrite(typ) => typ TypeSyntax::Write SourceTerm::TypeQuery
        common::OpValue::QualifiedMethodCall(method) => method SourceTerm::QualifiedMethod
        common::OpValue::TraitMethodCall(method) => {
            method match
                common::DeferredTraitCall {
                    method_name: name receiver: receiver trait_type: trait_type
                } => trait_type receiver name SourceTraitMethod CallSyntax::Invoke SourceTerm::TraitMethod
            end
        }
        common::OpValue::TraitMethodRef(method) => {
            method match
                common::DeferredTraitCall {
                    method_name: name receiver: receiver trait_type: trait_type
                } => trait_type receiver name SourceTraitMethod CallSyntax::Reference SourceTerm::TraitMethod
            end
        }
        common::OpValue::PushEnumVariant(variant) => annotation variant SourceTerm::Enum
        common::OpValue::IsCheck(variant) => variant SourceTerm::PatternTest
        common::OpValue::StructNew(shape) => annotation shape SourceTerm::Struct
        common::OpValue::StructLiteral(literal) => annotation literal SourceTerm::StructFields
        common::OpValue::NumericCall(call) => call SourceTerm::NumericCall
        common::OpValue::FstringToStr => SourceTerm::FormatValue
        common::OpValue::FstringConcat(count) => count SourceTerm::FormatJoin
        _ => "Checked action cannot be used as source syntax".to_str std::Result::Error return
    end
    std::Result::Ok
}

impl SourceLeaf {
    pub fn into_operation self:SourceLeaf -> common::Op {
        self match
            SourceLeaf { origin: origin term: term } => {
                std::Option[common::Type]::None = annotation
                term match
                    SourceTerm::Rejected => common::OpValue::Rejected
                    SourceTerm::Name(name) => name common::OpValue::Identifier
                    SourceTerm::Literal(literal declared) => {
                        declared = annotation
                        literal.into_op_value
                    }
                    SourceTerm::Intrinsic(kind) => kind common::intrinsic_to_op_value.unwrap
                    SourceTerm::Operator(kind) => {
                        kind common::operator_to_op_value match
                            std::Option::Some(value) => value
                            std::Option::None => "Invalid source operator category" panic
                        end
                    }
                    SourceTerm::Control(kind) => {
                        kind match
                            common::KeywordKind::Return => common::OpValue::FnReturn
                            common::KeywordKind::Break => common::OpValue::WhileBreak
                            common::KeywordKind::Continue => common::OpValue::WhileContinue
                            _ => "Invalid source control category" panic
                        end
                    }
                    SourceTerm::Binding(kind name declared) => {
                        declared = annotation
                        kind match
                            BindingSyntax::Read => name common::OpValue::PushVar
                            BindingSyntax::Capture => name common::OpValue::PushCapture
                            BindingSyntax::Assign => name common::OpValue::AssignVar
                            BindingSyntax::Increment => name common::OpValue::AssignInc
                            BindingSyntax::Decrement => name common::OpValue::AssignDec
                            BindingSyntax::Question => name common::OpValue::Question
                        end
                    }
                    SourceTerm::Call(kind name declared) => {
                        declared = annotation
                        kind match
                            CallSyntax::Invoke => name common::OpValue::FnCall
                            CallSyntax::Reference => name common::OpValue::FnPush
                            CallSyntax::Method => name common::OpValue::MethodCall
                        end
                    }
                    SourceTerm::QualifiedMethod(method) => method common::OpValue::QualifiedMethodCall
                    SourceTerm::TraitMethod(kind method) => {
                        method match
                            SourceTraitMethod {
                                method: name receiver: receiver trait_type: trait_type
                            } => common::empty_stack_effect trait_type receiver name common::DeferredTraitCall
                        end = dispatch
                        if kind CallSyntax::Reference swap == then
                            dispatch common::OpValue::TraitMethodRef
                        else
                            dispatch common::OpValue::TraitMethodCall
                        fi
                    }
                    SourceTerm::Pointer(kind) => {
                        kind match
                            PointerSyntax::FromRef => common::OpValue::PtrFromRef
                            PointerSyntax::IntoRaw => common::OpValue::PtrIntoRaw
                            PointerSyntax::Null => common::OpValue::PtrNull
                        end
                    }
                    SourceTerm::TypeQuery(kind typ) => {
                        kind match
                            TypeSyntax::SizeOf => typ common::OpValue::SizeOf
                            TypeSyntax::AsRef => typ common::OpValue::PtrAsRef
                            TypeSyntax::AsMut => typ common::OpValue::PtrAsMut
                            TypeSyntax::FromRaw => typ common::OpValue::PtrFromRaw
                            TypeSyntax::Read => typ common::OpValue::PtrRead
                            TypeSyntax::Write => typ common::OpValue::PtrWrite
                        end
                    }
                    SourceTerm::Enum(variant declared) => {
                        declared = annotation variant common::OpValue::PushEnumVariant
                    }
                    SourceTerm::PatternTest(variant) => variant common::OpValue::IsCheck
                    SourceTerm::Struct(shape declared) => {
                        declared = annotation shape common::OpValue::StructNew
                    }
                    SourceTerm::StructFields(literal declared) => {
                        declared = annotation literal common::OpValue::StructLiteral
                    }
                    SourceTerm::NumericCall(call) => call common::OpValue::NumericCall
                    SourceTerm::FormatValue => common::OpValue::FstringToStr
                    SourceTerm::FormatJoin(count) => count common::OpValue::FstringConcat
                end = value
                origin value common::Op::from_source = operation
                annotation = operation.type_hint
                operation
            }
        end
    }
}

impl common::Op {
    fn into_source_origin self:common::Op -> common::Location {
        self match
            common::Op { location: origin } => origin
        end
    }
}

struct SourceCursor {
    operations: mut$std::List[common::Op]
}

fn ends_sequence value:$common::OpValue -> bool {
    value common::OpValue::IfCondition is
    value common::OpValue::IfElif is ||
    value common::OpValue::IfElse is ||
    value common::OpValue::IfEnd is ||
    value common::OpValue::WhileCondition is ||
    value common::OpValue::WhileEnd is ||
    value common::OpValue::MatchArm is ||
    value common::OpValue::MatchEnd is ||
    value common::OpValue::UnsafeEnd is ||
}

impl SourceCursor {
    fn read_sequence self:mut$SourceCursor -> SourceBody {
        std::List[SourceNode]::new = nodes
        while self.operations.is_empty ! do
            if
                self.operations.length 1 - self
                    .operations
                    .get
                    .value ends_sequence
            then
                break
            fi
            self.operations.length 1 - self
                .operations
                .get
                .location
                .clone = origin
            self.operations.pop self.read_node match
                std::Result::Ok(node) => node nodes.push
                std::Result::Error(message) => {
                    message origin SourceRejection SourceNode::Rejected nodes.push
                    # The damaged region has no established continuation boundary.
                    while self.operations.is_empty ! do
                        self.operations.pop drop
                    done
                    break
                }
            end
        done
        nodes SourceBody
    }

    fn read_boundary self:mut$SourceCursor -> std::Result[common::Op std::String] {
        if self.operations.is_empty then
            "Incomplete structured source body".to_str std::Result::Error return
        fi
        self.operations.pop std::Result::Ok
    }

    fn read_branch
        self:mut$SourceCursor
        origin:common::Location
    -> std::Result[SourceBranch std::String] {
        self.read_sequence = condition
        self.read_boundary ? = boundary
        if boundary.value common::OpValue::IfCondition is ! then
            "Missing source branch condition boundary".to_str std::Result::Error return
        fi
        self.read_sequence = consequent
        consequent condition boundary.into_source_origin origin SourceBranch std::Result::Ok
    }

    fn read_conditional
        self:mut$SourceCursor
        origin:common::Location
    -> std::Result[SourceNode std::String] {
        origin self.read_branch ? = branch
        [branch] std::List::from_array = branches
        std::Option[SourceAlternative]::None = alternative
        while true do
            self.read_boundary ? = boundary
            if boundary.value common::OpValue::IfElif is then
                boundary.into_source_origin self.read_branch ? branches.push
                continue
            fi
            if boundary.value common::OpValue::IfElse is then
                self.read_sequence boundary.into_source_origin SourceAlternative std::Option::Some = alternative
                self.read_boundary ? = boundary
            fi
            if boundary.value common::OpValue::IfEnd is ! then
                "Missing source branch end".to_str std::Result::Error return
            fi
            boundary.into_source_origin alternative branches SourceConditional SourceNode::Conditional std::Result::Ok return
        done
        "Incomplete source branch".to_str std::Result::Error
    }

    fn read_loop
        self:mut$SourceCursor
        origin:common::Location
    -> std::Result[SourceNode std::String] {
        self.read_sequence = condition
        self.read_boundary ? = boundary
        if boundary.value common::OpValue::WhileCondition is ! then
            "Missing source loop condition boundary".to_str std::Result::Error return
        fi
        boundary.into_source_origin = condition_origin
        self.read_sequence = body
        self.read_boundary ? = boundary
        if boundary.value common::OpValue::WhileEnd is ! then
            "Missing source loop end".to_str std::Result::Error return
        fi
        boundary.into_source_origin body condition condition_origin origin SourceLoop SourceNode::Loop std::Result::Ok
    }

    fn read_match
        self:mut$SourceCursor
        origin:common::Location
    -> std::Result[SourceNode std::String] {
        std::List[SourceArm]::new = arms
        while true do
            self.read_boundary ? = boundary
            if boundary.value common::OpValue::MatchEnd is then
                boundary.into_source_origin arms origin SourceMatch SourceNode::Match std::Result::Ok return
            fi
            boundary self.read_arm ? arms.push
        done
        "Incomplete source match".to_str std::Result::Error
    }

    fn read_arm self:mut$SourceCursor operation:common::Op -> std::Result[SourceArm std::String] {
        operation match
            common::Op { location: origin value: value } => {
                value match
                    common::OpValue::MatchArm(arm) => {
                        arm match
                            common::MatchArm {
                                pattern_value: pattern guard_ops: operations guard_end: guard_end
                            } => {
                                operations consume_source_body = guard
                                self.read_sequence = body
                                body guard_end guard pattern origin SourceArm std::Result::Ok
                            }
                        end
                    }
                    _ => "Missing source match arm".to_str std::Result::Error
                end
            }
        end
    }

    fn read_region
        self:mut$SourceCursor
        origin:common::Location
    -> std::Result[SourceNode std::String] {
        self.read_sequence = body
        self.read_boundary ? = boundary
        if boundary.value common::OpValue::UnsafeEnd is ! then
            "Missing source unsafe end".to_str std::Result::Error return
        fi
        boundary.into_source_origin body origin SourceRegion SourceNode::Unsafe std::Result::Ok
    }

    fn read_node self:mut$SourceCursor operation:common::Op -> std::Result[SourceNode std::String] {
        operation match
            common::Op { location: origin type_hint: annotation value: value } => {
                # Borrow the tag so the fallback retains its owned leaf payload.
                value = tag: $common::OpValue
                tag match
                    common::OpValue::IfStart => origin self.read_conditional return
                    common::OpValue::WhileStart => origin self.read_loop return
                    common::OpValue::MatchStart => origin self.read_match return
                    common::OpValue::UnsafeStart => origin self.read_region return
                    common::OpValue::PushArray(_) => {
                        if value common::OpValue::PushArray(items) is then
                            items consume_source_body origin SourceCompound SourceNode::Array std::Result::Ok return
                        fi
                    }
                    common::OpValue::ExprGroup(_) => {
                        if value common::OpValue::ExprGroup(items) is then
                            items consume_source_body origin SourceCompound SourceNode::Group std::Result::Ok return
                        fi
                    }
                    _ => {
                    }
                end
                annotation value select_source_term ?
                origin SourceLeaf SourceNode::Leaf std::Result::Ok
            }
        end
    }
}

# Ownership transfers into source nodes. No semantic metadata is retained.
pub fn consume_source_operations operations:mut$std::List[common::Op] -> SourceBody {
    operations.reverse
    operations SourceCursor = cursor
    cursor.read_sequence = body
    if cursor.operations.is_empty ! then
        cursor.operations.length 1 - cursor
            .operations
            .get
            .location
            .clone = origin
        "Unexpected source body boundary".to_str origin SourceRejection SourceNode::Rejected body.nodes.push
        while cursor.operations.is_empty ! do
            cursor.operations.pop drop
        done
    fi
    body
}

pub fn consume_source_body operations:std::List[common::Op] -> SourceBody {
    operations consume_source_operations
}

impl SourceBody {
    # Pending declarations retain their source occurrences for editor projection.
    pub fn lower_operations self:$SourceBody -> std::List[common::Op] {
        std::List[common::Op]::new = operations
        operations self.lower_into
        operations
    }

    fn lower_into self:$SourceBody operations:mut$std::List[common::Op] {
        for node in self.nodes.iter do
            operations node.lower_into
        done
    }
}

pub struct SourceProgram {
    declarations: common::SymbolStore
    root:         SourceBody
    functions:    std::Map[std::String SourceBody]
}

impl SourceProgram {
    pub fn new
        declarations:common::SymbolStore
        root:SourceBody
        functions:std::Map[std::String SourceBody]
    -> SourceProgram {
        functions root declarations SourceProgram
    }

    pub fn into_parts
        self:SourceProgram
    -> common::SymbolStore SourceBody std::Map[std::String SourceBody] {
        self match
            SourceProgram { declarations: declarations root: root functions: functions } => declarations root functions
        end
    }
}

impl SourceBody {
    pub fn visit_closures self:$SourceBody visitor:$fn[$str] {
        for node in self.nodes.iter do
            visitor node.visit_closures
        done
    }
}

impl SourceNode {
    fn lower_into self:$SourceNode operations:mut$std::List[common::Op] {
        self match
            SourceNode::Rejected(rejection) => {
                rejection.origin.clone common::OpValue::Rejected common::Op::from_source operations.push
            }
            SourceNode::Leaf(leaf) => {
                leaf.clone.into_operation operations.push
            }
            SourceNode::Conditional(conditional) => {
                true = first
                for branch in conditional.branches.iter do
                    if first then common::OpValue::IfStart else common::OpValue::IfElif fi = entry
                    branch.origin.clone entry common::Op::from_source operations.push
                    operations branch.condition.lower_into
                    branch.condition_origin.clone common::OpValue::IfCondition common::Op::from_source operations.push
                    operations branch.consequent.lower_into
                    false = first
                done
                if conditional.alternative std::Option::Some(alternative) is then
                    alternative.origin.clone common::OpValue::IfElse common::Op::from_source operations.push
                    operations alternative.body.lower_into
                fi
                conditional.end_origin.clone common::OpValue::IfEnd common::Op::from_source operations.push
            }
            SourceNode::Loop(loop) => {
                loop.origin.clone common::OpValue::WhileStart common::Op::from_source operations.push
                operations loop.condition.lower_into
                loop.condition_origin.clone common::OpValue::WhileCondition common::Op::from_source operations.push
                operations loop.body.lower_into
                loop.end_origin.clone common::OpValue::WhileEnd common::Op::from_source operations.push
            }
            SourceNode::Match(match_body) => {
                match_body.origin.clone common::OpValue::MatchStart common::Op::from_source operations.push
                for arm in match_body.arms.iter do
                    arm.guard.lower_operations arm.pattern.clone common::MatchArm::new common::OpValue::MatchArm = value
                    arm.origin.clone value common::Op::from_source operations.push
                    operations arm.body.lower_into
                done
                match_body.end_origin.clone common::OpValue::MatchEnd common::Op::from_source operations.push
            }
            SourceNode::Unsafe(region) => {
                region.origin.clone common::OpValue::UnsafeStart common::Op::from_source operations.push
                operations region.body.lower_into
                region.end_origin.clone common::OpValue::UnsafeEnd common::Op::from_source operations.push
            }
            SourceNode::Array(compound) => {
                compound.origin.clone compound.body.lower_operations common::OpValue::PushArray common::Op::from_source operations.push
            }
            SourceNode::Group(compound) => {
                compound.origin.clone compound.body.lower_operations common::OpValue::ExprGroup common::Op::from_source operations.push
            }
        end
    }
}

impl SourceNode {
    fn visit_closures self:$SourceNode visitor:$fn[$str] {
        self match
            SourceNode::Leaf(leaf) => {
                if leaf.term SourceTerm::Call(kind name _) is then
                    if kind CallSyntax::Reference swap == then
                        name.as_str visitor exec
                    fi
                fi
            }
            SourceNode::Conditional(conditional) => {
                for branch in conditional.branches.iter do
                    visitor branch.condition.visit_closures
                    visitor branch.consequent.visit_closures
                done
                if conditional.alternative std::Option::Some(alternative) is then
                    visitor alternative.body.visit_closures
                fi
            }
            SourceNode::Loop(loop) => {
                visitor loop.condition.visit_closures
                visitor loop.body.visit_closures
            }
            SourceNode::Match(match_body) => {
                for arm in match_body.arms.iter do
                    visitor arm.guard.visit_closures
                    visitor arm.body.visit_closures
                done
            }
            SourceNode::Unsafe(region) => visitor region.body.visit_closures
            SourceNode::Array(compound) => visitor compound.body.visit_closures
            SourceNode::Group(compound) => visitor compound.body.visit_closures
            SourceNode::Rejected(_) => {
            }
        end
    }
}
