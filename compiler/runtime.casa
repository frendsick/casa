# Fixed Linux x86-64 runtime, embedded by normal compilation.
# Helpers use native call/ret on the return stack and preserve the value stack
# pointer in rbx.
pub const HEAP_GROWTH_SIZE 67108864
pub const ASSEMBLY ".equ CASA_RETURN_STACK_SIZE, 1048576
.equ CASA_RETURN_STACK_GUARD_SIZE, 65536
.equ CASA_SIGNAL_STACK_SIZE, 65536
.equ CASA_PAGE_SIZE, 4096
.equ CASA_SMALL_ALLOC_LIMIT, 512
.equ CASA_SMALL_PAGE_SIZE, 65536
.equ CASA_SMALL_PAGE_HEADER_SIZE, 16
.equ CASA_SMALL_PAGE_NEXT, 8
.equ CASA_HEAP_CHUNK_HEADER_SIZE, 16
.equ CASA_HEAP_GROWTH_SIZE, 67108864
.equ CASA_MMAP_SYSCALL, 9
.equ CASA_MMAP_PROT_READ_WRITE, 3
.equ CASA_MMAP_PRIVATE_ANONYMOUS, 34
.equ CASA_MPROTECT_SYSCALL, 10
.equ CASA_MPROTECT_PROT_NONE, 0
.equ CASA_RT_SIGACTION_SYSCALL, 13
.equ CASA_RT_SIGRETURN_SYSCALL, 15
.equ CASA_SIGALTSTACK_SYSCALL, 131
.equ CASA_SIGSEGV, 11
.equ CASA_SIGSET_SIZE, 8
# SA_SIGINFO | SA_RESTORER | SA_ONSTACK | SA_RESETHAND
.equ CASA_GUARD_SIGACTION_FLAGS, 0x8C000004
.equ CASA_SIGINFO_ADDRESS_OFFSET, 16
.equ CASA_WRITE_SYSCALL, 1
.equ CASA_EXIT_SYSCALL, 60
.equ CASA_EINTR_RESULT, -4
.equ CASA_STDOUT_FD, 1
.equ CASA_STDERR_FD, 2
.equ CASA_FAILURE_STATUS, 1

.section .bss
# The return stack grows down from return_stack_top. Accesses below it fault in
# the guard region. The emitter checks reservations that could skip past it.
.balign CASA_PAGE_SIZE
return_stack_guard: .skip CASA_RETURN_STACK_GUARD_SIZE
return_stack: .skip CASA_RETURN_STACK_SIZE
return_stack_top:
# The guard handler cannot run on an overflowed return stack.
signal_stack: .skip CASA_SIGNAL_STACK_SIZE
env_stack: .skip CASA_RETURN_STACK_SIZE
env_sp: .skip 8
current_env: .skip 8
.align 16
heap_chunks: .skip 8
heap_ptr: .skip 8
heap_end: .skip 8
free_list: .skip 8
small_pages: .skip CASA_SMALL_ALLOC_LIMIT
__argc: .skip 8
__argv: .skip 8
__envp: .skip 8
print_buf: .skip 32

.section .data
bool_true: .ascii \"true\"
bool_false: .ascii \"false\"
float_decimal_ten: .long 10
arithmetic_error_msg: .ascii \"error: integer arithmetic failed\\n\"
.equ arithmetic_error_msg_len, . - arithmetic_error_msg
return_stack_overflow_msg: .ascii \"error: return stack overflow\\n\"
.equ return_stack_overflow_msg_len, . - return_stack_overflow_msg
env_stack_overflow_msg: .ascii \"error: env stack overflow\\n\"
.equ env_stack_overflow_msg_len, . - env_stack_overflow_msg
return_stack_guard_failure_msg: .ascii \"fatal: return stack guard setup failed\\n\"
.equ return_stack_guard_failure_msg_len, . - return_stack_guard_failure_msg
allocation_failure_msg: .ascii \"fatal: allocation failed\\n\"
.equ allocation_failure_msg_len, . - allocation_failure_msg

.section .text
# Each mmap chunk starts with the previous chunk and its end address. Large
# blocks grow up from the chunk start and small-block pages grow down from its
# end. Each page holds blocks of one small size, and its own free list keeps
# reuse within the page, so allocations stay close together after many frees.
# Empty pages keep their size. Return them to a shared pool if memory grows
# when workloads move between sizes.
# Larger free blocks are ordered by address for first-fit reuse, splitting, and
# coalescing of adjacent large blocks.
# heap_alloc: byte count in rdi, aligned pointer in rax.
heap_alloc:
    .cfi_startproc
    testq %rdi, %rdi
    jz .Lheap_alloc_null
    movq %rdi, %rax
    addq $7, %rax
    jc .Lheap_alloc_oom
    andq $-8, %rax
    cmpq $CASA_SMALL_ALLOC_LIMIT, %rax
    ja .Lheap_alloc_large
.Lheap_alloc_small:
    leaq small_pages(%rip), %r9
    leaq -8(%r9,%rax), %r9
    movq (%r9), %rcx
    testq %rcx, %rcx
    jz .Lheap_alloc_page
.Lheap_alloc_small_pop:
    # A listed page always has a free block. Unlist the page when it runs out.
    movq (%rcx), %rdx
    movq 8(%rdx), %r8
    movq %r8, (%rcx)
    testq %r8, %r8
    jnz .Lheap_alloc_small_return
    movq CASA_SMALL_PAGE_NEXT(%rcx), %r8
    movq %r8, (%r9)
.Lheap_alloc_small_return:
    leaq 8(%rdx), %rax
    ret
.Lheap_alloc_page:
    movq heap_ptr(%rip), %rdx
    testq %rdx, %rdx
    jz .Lheap_alloc_page_grow
    movq heap_end(%rip), %rcx
    andq $-CASA_SMALL_PAGE_SIZE, %rcx
    subq $CASA_SMALL_PAGE_SIZE, %rcx
    cmpq %rdx, %rcx
    jae .Lheap_alloc_page_init
.Lheap_alloc_page_grow:
    call heap_grow
    jmp .Lheap_alloc_small
.Lheap_alloc_page_init:
    # Link every block of the new page in address order.
    movq %rcx, heap_end(%rip)
    leaq CASA_SMALL_PAGE_HEADER_SIZE(%rcx), %rdx
    movq %rdx, (%rcx)
    movq $0, CASA_SMALL_PAGE_NEXT(%rcx)
    leaq CASA_SMALL_PAGE_SIZE-8(%rcx), %rdi
    subq %rax, %rdi
.Lheap_alloc_page_link:
    movq %rax, (%rdx)
    leaq 8(%rdx,%rax), %r8
    cmpq %rdi, %r8
    ja .Lheap_alloc_page_last
    movq %r8, 8(%rdx)
    movq %r8, %rdx
    jmp .Lheap_alloc_page_link
.Lheap_alloc_page_last:
    movq $0, 8(%rdx)
    movq %rcx, (%r9)
    jmp .Lheap_alloc_small_pop
.Lheap_alloc_large:
    movq free_list(%rip), %rcx
    xorq %rdx, %rdx
.Lheap_alloc_search:
    testq %rcx, %rcx
    jz .Lheap_alloc_bump
    cmpq %rax, (%rcx)
    jae .Lheap_alloc_reuse
    movq %rcx, %rdx
    movq 8(%rcx), %rcx
    jmp .Lheap_alloc_search
.Lheap_alloc_reuse:
    movq 8(%rcx), %r8
    movq (%rcx), %r9
    subq %rax, %r9
    # Small sizes belong to pages, so a remainder needs an eight-byte header and
    # a large payload. A smaller remainder stays in the allocation.
    cmpq $CASA_SMALL_ALLOC_LIMIT+8, %r9
    jbe .Lheap_alloc_unlink
    subq $8, %r9
    leaq 8(%rcx,%rax), %rdi
    movq %r9, (%rdi)
    movq %rax, (%rcx)
    movq %r8, 8(%rdi)
    movq %rdi, %r8
.Lheap_alloc_unlink:
    testq %rdx, %rdx
    jz .Lheap_alloc_reuse_head
    movq %r8, 8(%rdx)
    jmp .Lheap_alloc_return_block
.Lheap_alloc_reuse_head:
    movq %r8, free_list(%rip)
.Lheap_alloc_return_block:
    leaq 8(%rcx), %rax
    ret
.Lheap_alloc_bump:
    movq heap_ptr(%rip), %rcx
    testq %rcx, %rcx
    jz .Lheap_alloc_grow
    addq $7, %rcx
    andq $-8, %rcx
    movq %rax, %r8
    addq $8, %r8
    jc .Lheap_alloc_oom
    addq %rcx, %r8
    jc .Lheap_alloc_oom
    cmpq heap_end(%rip), %r8
    jbe .Lheap_alloc_commit
.Lheap_alloc_grow:
    call heap_grow
    jmp .Lheap_alloc_bump
.Lheap_alloc_commit:
    movq %rax, (%rcx)
    movq %r8, heap_ptr(%rip)
    leaq 8(%rcx), %rax
    ret
.Lheap_alloc_null:
    xorq %rax, %rax
    ret
.Lheap_alloc_oom:
    call allocation_failure
    ud2
    .cfi_endproc

# heap_grow: block size in rax. Maps a chunk that fits the block and makes it
# the bump region. Preserves rax, rsi, r10, and r11.
heap_grow:
    .cfi_startproc
    pushq %rsi
    .cfi_adjust_cfa_offset 8
    pushq %r10
    .cfi_adjust_cfa_offset 8
    pushq %r11
    .cfi_adjust_cfa_offset 8
    pushq %rax
    .cfi_adjust_cfa_offset 8
    movq %rax, %rsi
    addq $CASA_HEAP_CHUNK_HEADER_SIZE+8, %rsi
    jc .Lheap_grow_oom
    cmpq $CASA_HEAP_GROWTH_SIZE, %rsi
    jae .Lheap_grow_size_ready
    movq $CASA_HEAP_GROWTH_SIZE, %rsi
.Lheap_grow_size_ready:
    xorq %rdi, %rdi
    movq $CASA_MMAP_PROT_READ_WRITE, %rdx
    movq $CASA_MMAP_PRIVATE_ANONYMOUS, %r10
    movq $-1, %r8
    xorq %r9, %r9
    movq $CASA_MMAP_SYSCALL, %rax
    syscall
    testq %rax, %rax
    jz .Lheap_grow_oom
    cmpq $-4095, %rax
    jae .Lheap_grow_oom
    movq heap_chunks(%rip), %r8
    movq %r8, (%rax)
    movq %rax, %rcx
    addq %rsi, %rcx
    jc .Lheap_grow_oom
    movq %rcx, 8(%rax)
    movq %rax, heap_chunks(%rip)
    movq %rcx, heap_end(%rip)
    addq $CASA_HEAP_CHUNK_HEADER_SIZE, %rax
    movq %rax, heap_ptr(%rip)
    popq %rax
    .cfi_adjust_cfa_offset -8
    popq %r11
    .cfi_adjust_cfa_offset -8
    popq %r10
    .cfi_adjust_cfa_offset -8
    popq %rsi
    .cfi_adjust_cfa_offset -8
    ret
.Lheap_grow_oom:
    .cfi_def_cfa_offset 40
    call allocation_failure
    ud2
    .cfi_endproc

allocation_failure:
    .cfi_startproc
    movq $CASA_STDERR_FD, %rdi
    leaq allocation_failure_msg(%rip), %rsi
    movq $allocation_failure_msg_len, %rdx
    call write_all
    movq $CASA_EXIT_SYSCALL, %rax
    movq $CASA_FAILURE_STATUS, %rdi
    syscall
    .cfi_endproc

# heap_free: allocation in rdi, returns the complete allocation for reuse.
heap_free:
    .cfi_startproc
    testq %rdi, %rdi
    jz .Lheap_free_return
    leaq -8(%rdi), %rax
    movq (%rax), %rdx
    cmpq $CASA_SMALL_ALLOC_LIMIT, %rdx
    ja .Lheap_free_large
    # The block's page is listed again when the block is its only free block.
    movq %rax, %rcx
    andq $-CASA_SMALL_PAGE_SIZE, %rcx
    movq (%rcx), %r8
    movq %r8, 8(%rax)
    movq %rax, (%rcx)
    testq %r8, %r8
    jnz .Lheap_free_return
    leaq small_pages(%rip), %r9
    leaq -8(%r9,%rdx), %r9
    movq (%r9), %r8
    movq %r8, CASA_SMALL_PAGE_NEXT(%rcx)
    movq %rcx, (%r9)
    jmp .Lheap_free_return
.Lheap_free_large:
    movq free_list(%rip), %rcx
    xorq %r8, %r8
.Lheap_free_search:
    testq %rcx, %rcx
    jz .Lheap_free_insert
    cmpq %rax, %rcx
    jae .Lheap_free_insert
    movq %rcx, %r8
    movq 8(%rcx), %rcx
    jmp .Lheap_free_search
.Lheap_free_insert:
    movq %rcx, 8(%rax)
    testq %r8, %r8
    jz .Lheap_free_insert_head
    movq %rax, 8(%r8)
    jmp .Lheap_free_merge_next
.Lheap_free_insert_head:
    movq %rax, free_list(%rip)
.Lheap_free_merge_next:
    testq %rcx, %rcx
    jz .Lheap_free_merge_previous
    leaq 8(%rax,%rdx), %r9
    cmpq %rcx, %r9
    jne .Lheap_free_merge_previous
    movq (%rcx), %r9
    leaq 8(%rdx,%r9), %rdx
    movq %rdx, (%rax)
    movq 8(%rcx), %r9
    movq %r9, 8(%rax)
.Lheap_free_merge_previous:
    testq %r8, %r8
    jz .Lheap_free_return
    movq (%r8), %r9
    leaq 8(%r8,%r9), %rcx
    cmpq %rax, %rcx
    jne .Lheap_free_return
    leaq 8(%rdx,%r9), %rdx
    movq %rdx, (%r8)
    movq 8(%rax), %rcx
    movq %rcx, 8(%r8)
.Lheap_free_return:
    ret
    .cfi_endproc

# write_all: fd in rdi, buffer in rsi, byte length in rdx.
# Output operations cannot report errors, so an unrecoverable write exits unsuccessfully.
write_all:
    .cfi_startproc
.Lwrite_all_next:
    testq %rdx, %rdx
    jz .Lwrite_all_return
    movq $CASA_WRITE_SYSCALL, %rax
    syscall
    cmpq $CASA_EINTR_RESULT, %rax
    je .Lwrite_all_next
    testq %rax, %rax
    jle .Lwrite_all_fail
    addq %rax, %rsi
    subq %rax, %rdx
    jmp .Lwrite_all_next
.Lwrite_all_return:
    ret
.Lwrite_all_fail:
    movq $CASA_EXIT_SYSCALL, %rax
    movq $CASA_FAILURE_STATUS, %rdi
    syscall
    .cfi_endproc

# print_int: value in rdi.
print_int:
    .cfi_startproc
    movq %rdi, %rax
    leaq print_buf+32(%rip), %rsi
    testq %rax, %rax
    jnz .Lpi_nonzero
    decq %rsi
    movb $48, (%rsi)
    jmp .Lpi_write
.Lpi_nonzero:
    movq %rax, %r15
    jns .Lpi_abs
    negq %rax
.Lpi_abs:
    movq $10, %rcx
.Lpi_digit_loop:
    decq %rsi
    xorq %rdx, %rdx
    divq %rcx
    addb $48, %dl
    movb %dl, (%rsi)
    testq %rax, %rax
    jnz .Lpi_digit_loop
    testq %r15, %r15
    jns .Lpi_write
    decq %rsi
    movb $45, (%rsi)
.Lpi_write:
    leaq print_buf+32(%rip), %rdx
    subq %rsi, %rdx
    movq $CASA_STDOUT_FD, %rdi
    jmp write_all
    .cfi_endproc

# print_uint: value in rdi.
print_uint:
    .cfi_startproc
    movq %rdi, %rax
    leaq print_buf+32(%rip), %rsi
    testq %rax, %rax
    jnz .Lpui_digit_loop
    decq %rsi
    movb $48, (%rsi)
    jmp .Lpui_write
.Lpui_digit_loop:
    decq %rsi
    xorq %rdx, %rdx
    movq $10, %rcx
    divq %rcx
    addb $48, %dl
    movb %dl, (%rsi)
    testq %rax, %rax
    jnz .Lpui_digit_loop
.Lpui_write:
    leaq print_buf+32(%rip), %rdx
    subq %rsi, %rdx
    movq $CASA_STDOUT_FD, %rdi
    jmp write_all
    .cfi_endproc

# print_str: string pointer in rdi (points to length prefix).
print_str:
    .cfi_startproc
    movq (%rdi), %rdx
    leaq 8(%rdi), %rsi
    movq $CASA_STDOUT_FD, %rdi
    jmp write_all
    .cfi_endproc

# encode_char: Unicode scalar in rdi, UTF-8 bytes in print_buf.
# Returns the buffer in rsi and its byte length in rdx.
encode_char:
    .cfi_startproc
    leaq print_buf(%rip), %rsi
    cmpq $127, %rdi
    ja .Lec_two
    movb %dil, (%rsi)
    movq $1, %rdx
    ret
.Lec_two:
    cmpq $2047, %rdi
    ja .Lec_three
    movq %rdi, %rax
    shrq $6, %rax
    orb $192, %al
    movb %al, (%rsi)
    movq %rdi, %rax
    andb $63, %al
    orb $128, %al
    movb %al, 1(%rsi)
    movq $2, %rdx
    ret
.Lec_three:
    cmpq $65535, %rdi
    ja .Lec_four
    movq %rdi, %rax
    shrq $12, %rax
    orb $224, %al
    movb %al, (%rsi)
    movq %rdi, %rax
    shrq $6, %rax
    andb $63, %al
    orb $128, %al
    movb %al, 1(%rsi)
    movq %rdi, %rax
    andb $63, %al
    orb $128, %al
    movb %al, 2(%rsi)
    movq $3, %rdx
    ret
.Lec_four:
    movq %rdi, %rax
    shrq $18, %rax
    orb $240, %al
    movb %al, (%rsi)
    movq %rdi, %rax
    shrq $12, %rax
    andb $63, %al
    orb $128, %al
    movb %al, 1(%rsi)
    movq %rdi, %rax
    shrq $6, %rax
    andb $63, %al
    orb $128, %al
    movb %al, 2(%rsi)
    movq %rdi, %rax
    andb $63, %al
    orb $128, %al
    movb %al, 3(%rsi)
    movq $4, %rdx
    ret
    .cfi_endproc

# primitive_to_str: value in rdi, kind in r8, owned text buffer in rax.
# Kinds: 0 signed integer, 1 unsigned integer, 2 bool, 3 char, 4 cstr.
primitive_to_str:
    .cfi_startproc
    cmpq $2, %r8
    je .Lpts_bool
    cmpq $3, %r8
    je .Lpts_char
    cmpq $4, %r8
    je .Lpts_cstr
    movq %rdi, %rax
    leaq print_buf+32(%rip), %rsi
    testq %rax, %rax
    jnz .Lpts_integer_nonzero
    decq %rsi
    movb $48, (%rsi)
    jmp .Lpts_integer_done
.Lpts_integer_nonzero:
    testq %r8, %r8
    jnz .Lpts_integer_abs
    testq %rax, %rax
    jns .Lpts_integer_abs
    negq %rax
.Lpts_integer_abs:
    movq $10, %rcx
.Lpts_integer_loop:
    decq %rsi
    xorq %rdx, %rdx
    divq %rcx
    addb $48, %dl
    movb %dl, (%rsi)
    testq %rax, %rax
    jnz .Lpts_integer_loop
    testq %r8, %r8
    jnz .Lpts_integer_done
    testq %rdi, %rdi
    jns .Lpts_integer_done
    decq %rsi
    movb $45, (%rsi)
.Lpts_integer_done:
    leaq print_buf+32(%rip), %rdx
    subq %rsi, %rdx
    jmp .Lpts_copy
.Lpts_bool:
    testq %rdi, %rdi
    jz .Lpts_bool_false
    leaq bool_true(%rip), %rsi
    movq $4, %rdx
    jmp .Lpts_copy
.Lpts_bool_false:
    leaq bool_false(%rip), %rsi
    movq $5, %rdx
    jmp .Lpts_copy
.Lpts_char:
    call encode_char
    jmp .Lpts_copy
.Lpts_cstr:
    movq %rdi, %rsi
    movq %rdi, %rax
.Lpts_cstr_loop:
    cmpb $0, (%rax)
    je .Lpts_cstr_done
    incq %rax
    jmp .Lpts_cstr_loop
.Lpts_cstr_done:
    movq %rax, %rdx
    subq %rsi, %rdx
.Lpts_copy:
    movq %rdx, %rdi
    addq $9, %rdi
    jc .Lpts_oom
    pushq %rsi
    .cfi_adjust_cfa_offset 8
    pushq %rdx
    .cfi_adjust_cfa_offset 8
    call heap_alloc
    movq %rax, %r13
    popq %rdx
    .cfi_adjust_cfa_offset -8
    popq %rsi
    .cfi_adjust_cfa_offset -8
    movq %rdx, (%r13)
    leaq 8(%r13), %rdi
    movq %rdx, %rcx
    rep movsb
    movb $0, (%rdi)
    movq %r13, %rax
    ret
.Lpts_oom:
    call allocation_failure
    ud2
    .cfi_endproc

# str_concat consumes rdi owned String wrappers at the value stack top in rbx.
# Returns an owned text buffer in rax. Wrappers belong to the caller frame.
str_concat:
    .cfi_startproc
    movq %rdi, %r15
    xorq %r10, %r10
    xorq %rcx, %rcx
.Lsc_len_loop:
    cmpq %r15, %rcx
    jge .Lsc_len_done
    movq (%rbx,%rcx,8), %rax
    movq (%rax), %rax
    addq (%rax), %r10
    jc .Lsc_oom
    incq %rcx
    jmp .Lsc_len_loop
.Lsc_len_done:
    movq %r10, %rdi
    addq $9, %rdi
    jc .Lsc_oom
    call heap_alloc
    movq %rax, %r13
    movq %r10, (%r13)
    leaq 8(%r13), %rdi
    movq %r15, %rcx
    decq %rcx
.Lsc_copy_loop:
    cmpq $0, %rcx
    jl .Lsc_copy_done
    movq (%rbx,%rcx,8), %rsi
    movq (%rsi), %rsi
    movq (%rsi), %rdx
    addq $8, %rsi
    movq %rcx, %r12
    movq %rdx, %rcx
    rep movsb
    movq %r12, %rcx
    decq %rcx
    jmp .Lsc_copy_loop
.Lsc_copy_done:
    movb $0, (%rdi)
    xorq %r12, %r12
.Lsc_free_loop:
    cmpq %r15, %r12
    jge .Lsc_free_done
    movq (%rbx,%r12,8), %r14
    movq (%r14), %rdi
    call heap_free
    incq %r12
    jmp .Lsc_free_loop
.Lsc_free_done:
    movq %r13, %rax
    ret
.Lsc_oom:
    call allocation_failure
    ud2
    .cfi_endproc

# Arithmetic failure handler: write error to fd 2 and exit(1).
arithmetic_error:
    .cfi_startproc
    leaq arithmetic_error_msg(%rip), %rsi
    movq $arithmetic_error_msg_len, %rdx
    movq $CASA_STDERR_FD, %rdi
    call write_all
    movq $CASA_FAILURE_STATUS, %rdi
    movq $CASA_EXIT_SYSCALL, %rax
    syscall
    .cfi_endproc

# Internal helper: make the guard region inaccessible and report its faults as
# return stack overflow. Other faults keep the default action.
return_stack_guard_init:
    .cfi_startproc
    # Kernel stack_t layout: base, flags, and size.
    subq $32, %rsp
    .cfi_adjust_cfa_offset 32
    leaq signal_stack(%rip), %rax
    movq %rax, (%rsp)
    movq $0, 8(%rsp)
    movq $CASA_SIGNAL_STACK_SIZE, 16(%rsp)
    movq $CASA_SIGALTSTACK_SYSCALL, %rax
    movq %rsp, %rdi
    xorq %rsi, %rsi
    syscall
    testq %rax, %rax
    jnz .Lreturn_stack_guard_failure_reserved
    # Kernel sigaction layout: handler, flags, restorer, and signal mask.
    leaq return_stack_guard_fault(%rip), %rax
    movq %rax, (%rsp)
    movabsq $CASA_GUARD_SIGACTION_FLAGS, %rax
    movq %rax, 8(%rsp)
    leaq return_stack_guard_restore(%rip), %rax
    movq %rax, 16(%rsp)
    movq $0, 24(%rsp)
    movq $CASA_RT_SIGACTION_SYSCALL, %rax
    movq $CASA_SIGSEGV, %rdi
    movq %rsp, %rsi
    xorq %rdx, %rdx
    movq $CASA_SIGSET_SIZE, %r10
    syscall
    addq $32, %rsp
    .cfi_adjust_cfa_offset -32
    testq %rax, %rax
    jnz .Lreturn_stack_guard_failure
    movq $CASA_MPROTECT_SYSCALL, %rax
    leaq return_stack_guard(%rip), %rdi
    movq $CASA_RETURN_STACK_GUARD_SIZE, %rsi
    movq $CASA_MPROTECT_PROT_NONE, %rdx
    syscall
    testq %rax, %rax
    jnz .Lreturn_stack_guard_failure
    ret
.Lreturn_stack_guard_failure_reserved:
    .cfi_def_cfa_offset 40
    addq $32, %rsp
    .cfi_adjust_cfa_offset -32
.Lreturn_stack_guard_failure:
    leaq return_stack_guard_failure_msg(%rip), %rsi
    movq $return_stack_guard_failure_msg_len, %rdx
    movq $CASA_STDERR_FD, %rdi
    movq $CASA_WRITE_SYSCALL, %rax
    syscall
    movq $CASA_FAILURE_STATUS, %rdi
    movq $CASA_EXIT_SYSCALL, %rax
    syscall
    .cfi_endproc

# SIGSEGV handler on the signal stack: fault address in siginfo at rsi.
return_stack_guard_fault:
    movq CASA_SIGINFO_ADDRESS_OFFSET(%rsi), %rax
    leaq return_stack_guard(%rip), %rcx
    subq %rcx, %rax
    cmpq $CASA_RETURN_STACK_GUARD_SIZE, %rax
    jb return_stack_overflow
    # SA_RESETHAND restored the default action, so the fault repeats on return.
    ret

return_stack_guard_restore:
    movq $CASA_RT_SIGRETURN_SYSCALL, %rax
    syscall

# Return stack overflow handler: write error to fd 2 and exit(1).
return_stack_overflow:
    leaq return_stack_overflow_msg(%rip), %rsi
    movq $return_stack_overflow_msg_len, %rdx
    movq $2, %rdi
    movq $1, %rax
    syscall
    movq $1, %rdi
    movq $60, %rax
    syscall

# env_stack overflow handler: write error to fd 2 and exit(1).
env_stack_overflow:
    .cfi_startproc
    leaq env_stack_overflow_msg(%rip), %rsi
    movq $env_stack_overflow_msg_len, %rdx
    movq $CASA_STDERR_FD, %rdi
    call write_all
    movq $CASA_FAILURE_STATUS, %rdi
    movq $CASA_EXIT_SYSCALL, %rax
    syscall
    .cfi_endproc

"
