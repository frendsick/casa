    session checked_ops source_body::consume_source_body analyze_source_root_semantics = result
    FunctionSemantics { ordered_facts: result.ordered_facts.clone inferred_effect: result.inferred_effect.clone operations: result.body.lower_operations diagnostics: result.diagnostics.clone return_callables: result.return_callables.clone checked_function: std::Option[common::Function]::None }
