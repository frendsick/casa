    pub fn type_is_duplicable
        tc:mut$TypeChecker
        typ:$common::Type
        function_opt:mut$std::Option[common::Function]
    -> bool {
        if typ.is_shared_borrow then
            true return
        fi
        if typ.is_exclusive_borrow then
            false return
        fi
        if typ common::Type::Builtin(builtin) is then
            true return
        fi
        if typ common::Type::Function(_) is then
            false return
        fi
        if typ.array_element_type std::Option::Some(element_type) is then
            common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
            if tc.store function_opt copy_type element_type matches_trait_bound then
                true return
            fi
            tc.store copy_type element_type rules::type_has_satisfying_trait_impl return
        fi
        if typ.has_unresolved_type_var then
            common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = unresolved_copy_type
            if tc.store function_opt unresolved_copy_type typ matches_trait_bound then
                true return
            fi
            tc.store unresolved_copy_type typ rules::type_has_satisfying_trait_impl return
        fi
        typ.format = type_name
        if
            type_name tc
                .store
                .copy_types
                .get std::Option::Some(cached) is
        then
            cached.clone return
        fi
        common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
        tc.store function_opt copy_type typ matches_trait_bound = is_copy
        if is_copy ! then
            tc.store copy_type typ rules::type_has_satisfying_trait_impl = is_copy
        fi
        is_copy type_name tc
            .store
            .copy_types
            .set
        is_copy
    }

    pub fn uses_copy_storage self:mut$TypeChecker typ:$common::Type -> bool {
        if typ.is_borrow then
            false return
        fi
        if self.store typ common::type_value_representation std::Option::Some(representation) is then
            if common::VALUE_REPR_INDIRECT representation == then
                std::Option[common::Function]::None typ self.type_is_duplicable return
            fi
        fi
        false
    }

    fn does_callable_own_captures self:$TypeChecker callable:$str -> bool {
        if callable self.store.get_function std::Option::Some(function) is then
            function.captures_by_move return
        fi
        false
    }

    fn does_binding_own_callable_captures self:$TypeChecker name:$str -> bool {
        if name self.callable_bindings.get_str std::Option::Some(callables) is then
            for callable in callables.iter do
                if callable.as_str self.does_callable_own_captures then
                    true return
                fi
            done
        fi
        false
    }

    pub fn type_implements_clone tc:mut$TypeChecker typ:$common::Type -> bool {
        common::STD_CLONE_TRAIT.to_str common::GenericType::new common::Type::Generic = clone_type
        if typ common::Type::TypeVar(type_var_name) is then
            if type_var_name tc.current_trait_bounds.get std::Option::Some(bounds) is then
                for bound in bounds.iter do
                    bound common::trait_bound_to_type = bound_type
                    if tc.store clone_type bound_type rules::trait_type_implies then
                        true return
                    fi
                done
            fi
        fi
        tc.store clone_type typ rules::type_has_satisfying_trait_impl
    }

    pub fn record_owner_assignment
        tc:mut$TypeChecker
        op:mut$common::Op
        name:$str
        typ:$common::Type
        function_opt:mut$std::Option[common::Function]
        is_global:bool
    {
        function_opt typ name op tc.record_source_binding
        if name tc.scope.find_binding std::Option::Some(binding) is then
            binding common::BindingFact::Definition op.add_binding_fact
        fi
        if is_global function_opt.is_some && then
            return
        fi
        if function_opt std::Option::Some(function) is then
            if name function.captures common::variable_list_contains then
                return
            fi
        fi
        if typ.is_borrow function_opt typ tc.type_is_duplicable || then
            return
        fi
        if tc.store typ common::type_needs_destruction_in_store ! then
            return
        fi
        if tc.path_continues ! then
            return
        fi
        tc.scope typ name op tc.ownership.record_assignment
    }

    fn validate_owner_cleanups
        tc:mut$TypeChecker
        op:mut$common::Op
        cleanups:$std::List[common::OwnerEvent]
        ending_names:$std::List[std::String]
    {
        if tc.path_continues ! then
            return
        fi
        std::List[std::String]::new = checked
        for event in cleanups.iter do
            if event.name.as_str checked common::string_list_contains then
                continue
            fi
            if
                event.name.as_str tc.ownership.owner_is_moved !
                event.name.as_str tc.ownership.has_reported_move_conflict ! &&
            then
                if
                    ending_names true tc
                        .stack
                        .values
                        .length event.name.as_str Place::new
                    tc.find_conflicting_loan_except std::Option::Some(conflict) is
                then
                    conflict f"Cannot destroy owner `{event.name}` while it is borrowed"
                    tc.current_location tc.diagnostics tc.ownership.report_loan_conflict
                    event.name.as_str tc.ownership.record_move_conflict
                fi
            fi
            event.name.clone checked.push
        done
    }

    pub fn attach_owner_cleanups
        tc:mut$TypeChecker
        op:mut$common::Op
        names:mut$std::List[std::String]
        remove:bool
    {
        names tc.ownership.owner_cleanups_for_names = cleanups
        names cleanups op tc.validate_owner_cleanups
        cleanups.reverse
        while cleanups.is_empty ! do
            cleanups.pop op
                .ensure_ownership
                .cleanups
                .push
        done
        if remove then
            names tc.ownership.remove_owner_events_for_names
        fi
    }

    pub fn attach_scope_cleanups tc:mut$TypeChecker op:mut$common::Op {
        tc.scope.current_names = names
        true names op tc.attach_owner_cleanups
    }

    pub fn attach_all_owner_cleanups tc:mut$TypeChecker op:mut$common::Op {
        tc.ownership.all_owner_cleanups = ending_names = cleanups
        ending_names cleanups op tc.validate_owner_cleanups
        for event in cleanups.iter do
            event.clone op
                .ensure_ownership
                .cleanups
                .push
        done
    }

    pub fn stack_push_type tc:mut$TypeChecker type_value:$common::Type {
