import "body_builder" as body_builder
import "literal_resolution" as literal_resolution

# TypedStack — typed values with source and unresolved-literal origins.
struct TypedStack {
    values: std::List[TypedValue]
}

enum LiteralKind derives std::Copy std::Eq {
    Integer
    Numeric
    Aggregate
}

struct LiteralRef derives std::Clone {
    id:            i64
    integer_value: i64
    kind:          LiteralKind
}

enum ValueCapability derives std::Eq std::Copy {
    Owned
    Shared
    Exclusive
}

enum CallOriginMode derives std::Copy {
    Shared
    ContainedShared
    Exclusive
    ContainedExclusive
}

enum CallStackLayout derives std::Copy {
    ArgumentsOnly
    CallableOnTop
}

impl CallStackLayout {
    fn get_argument_offset self:$CallStackLayout -> u64 {
        if self CallStackLayout::CallableOnTop is then
            1
        else
            0
        fi
    }
}

enum ReturnCleanupMode derives std::Copy {
    NoCleanup
    Exact
    AllOrigins
}

struct ReturnOriginSummary derives std::Clone {
    origins:         std::Option[std::List[Origin]]
    cleanup_origins: std::Option[std::List[Origin]]
}

const CALLABLE_PARAMETER_PREFIX "parameter "
const CALLABLE_RETURN_PREFIX "return "
const CALLABLE_CONTRACT "contract "

# A return dependency retains the caller's symbolic arguments until its recursive
# group has published all equations. Source bodies are never checked again.
struct CallableReturnDependency derives std::Clone {
    function_name: std::String
    arguments:     std::Map[std::String std::Set[std::String]]
    return_index:  u64
    reference:     std::String
}

struct CallReturnSummary derives std::Clone {
    callables: std::List[std::Set[std::String]]
    origins:   std::List[ReturnOriginSummary]
}

impl CallReturnSummary {
    fn new -> CallReturnSummary {
        CallReturnSummary {
            callables: std::List[std::Set[std::String]]::new
            origins: std::List[ReturnOriginSummary]::new
        }
    }
}

struct ReturnOriginSources {
    shared:                $std::Option[std::List[Origin]]
    exclusive:             $std::Option[std::List[Origin]]
    callable:              $std::Option[std::List[Origin]]
    callable_cleanup:      $std::Option[std::List[Origin]]
    type_variables:        $std::Map[std::String std::List[Origin]]
    type_variable_cleanup: $std::Map[std::String std::List[Origin]]
}

struct LoanSpan derives std::Clone {
    origin:    common::Location
    later_use: common::Location
}

struct TypedValue derives std::Clone {
    inferred_parameter:  std::Option[u64]
    type_value:          common::Type
    origin:              common::Location
    literals:            std::List[LiteralRef]
    place:               std::Option[Place]
    capability:          ValueCapability
    binding:             std::Option[std::String]
    source:              std::Option[i64]
    origins:             std::Option[std::List[Origin]]
    cleanup_origins:     std::Option[std::List[Origin]]
    loan_spans:          std::Map[Origin std::Option[LoanSpan]]
    is_literal_constant: bool
    callables:           std::Set[std::String]
}

struct LoanConflict derives std::Clone {
    binding:   std::Option[std::String]
    origin:    std::Option[common::Location]
    later_use: std::Option[common::Location]
}

# A binding is the resolved lexical name. Field components are separate from
# that identity, so overlap compares complete projections rather than prefixes.
struct Place derives std::Clone {
    binding: std::String
    fields:  std::List[std::String]
}

impl Place {
    fn new binding:$str -> Place { std::List[std::String]::new binding.to_str Place }

    fn contains self:$Place other:$Place -> bool {
        if self.binding.as_str other.binding.as_str != then
            false return
        fi
        if self.fields.length other.fields.length > then
            false return
        fi
        0 = index: u64
        while index self.fields.length < do
            if
                index self
                    .fields
                    .get
                    .as_str index other
                    .fields
                    .get
                    .as_str !=
            then
                false return
            fi
            1 += index
        done
        true
    }

    fn overlaps self:$Place other:$Place -> bool { other self.contains self other.contains || }

    fn project self:$Place field:$str -> Place {
        self.clone = projected
        field.to_str projected.fields.push
        projected
    }

    fn format self:$Place -> std::String {
        self.binding.clone = name
        for field in self.fields.iter do
            "." name.append
            field.as_str name.append
        done
        name
    }
}

impl Place: std::Eq + std::Hashable {
    pub fn eq self:$Place other:$Place -> bool {
        self.fields.length other.fields.length == other self.contains &&
    }

    pub fn hash self:$Place -> i64 {
        self.binding.hash = hash
        for field in self.fields.iter do
            hash field.hash ^ std::int_hash = hash
        done
        hash
    }
}

enum OriginKind derives std::Eq std::Hashable std::Copy {
    Place
    InputOrigins
    InputPayload
    InputCleanup
}

struct Origin derives std::Clone {
    place:     Place
    kind:      OriginKind
    exclusive: bool
}

impl Origin: std::Hashable {
    pub fn eq self:$Origin other:$Origin -> bool {
        other.place self.place.eq other.kind self.kind == && other.exclusive self.exclusive == &&
    }

    pub fn hash self:$Origin -> i64 {
        self.place.hash self.kind.hash ^ if self.exclusive then 1 else 0 fi ^
    }
}

impl Origin {
    fn overlaps self:$Origin place:$Place -> bool {
        self.kind OriginKind::Place is place self.place.overlaps &&
    }

    fn with_capability self:$Origin exclusive:bool -> Origin {
        exclusive self.kind self.place.clone Origin
    }
}

fn contains_origin origins:$std::List[Origin] origin:$Origin -> bool {
    for candidate in origins.iter do
        if origin candidate.eq then
            true return
        fi
    done
    false
}

fn append_origin
    origins:std::Option[std::List[Origin]]
    origin:Origin
-> std::Option[std::List[Origin]] {
    if origins std::Option::Some(items) is then
        if origin items contains_origin ! then
            origin items.push
        fi
        items std::Option::Some
    else
        std::List[Origin]::new = items
        origin items.push
        items std::Option::Some
    fi
}

fn is_function_parameter name:$str function_opt:$std::Option[common::Function] -> bool {
    if function_opt std::Option::Some(function) is then
        for
            parameter in function
                .stack_effect
                .parameters
                .iter
        do
            if name.as_str parameter.name.as_str == then
                true return
            fi
        done
    fi
    false
}

fn do_origins_have_runtime_dependency origins:$std::List[Origin] -> bool {
    for origin in origins.iter do
        if origin.kind OriginKind::Place is then
            true return
        fi
    done
    false
}

pub fn add_origin
    origins:std::Option[std::List[Origin]]
    place:$Place
    exclusive:bool
-> std::Option[std::List[Origin]] {
    exclusive OriginKind::Place place.clone Origin = origin
    origin origins append_origin
}

pub fn merge_origins
    target:std::Option[std::List[Origin]]
    source:$std::Option[std::List[Origin]]
-> std::Option[std::List[Origin]] {
    if source std::Option::Some(items) is then
        for origin in items.iter do
            origin.clone target append_origin = target
        done
    fi
    target
}

fn should_preserve_contained_origin origin:$Origin place:$std::Option[Place] -> bool {
    if origin.kind OriginKind::Place is ! then
        true return
    fi
    if place std::Option::Some(container_place) is then
        container_place origin.place.eq ! return
    fi
    true
}

# Ignore the loan used to access a container while preserving origins stored in it.
fn merge_contained_origins
    target:std::Option[std::List[Origin]]
    source:$std::Option[std::List[Origin]]
    place:$std::Option[Place]
-> std::Option[std::List[Origin]] {
    if source std::Option::Some(items) is then
        for origin in items.iter do
            place origin should_preserve_contained_origin = preserve
            if preserve then
                origin.clone target append_origin = target
            fi
        done
    fi
    target
}

fn merge_type_variable_origins
    collected:mut$std::Map[std::String std::List[Origin]]
    name:$str
    source:$std::Option[std::List[Origin]]
{
    std::List[Origin]::new = items
    if name collected.get_str std::Option::Some(existing) is then
        existing.clone = items
    fi
    items std::Option::Some = merged
    source merged merge_origins = merged
    merged.unwrap name.to_str collected.set
}

fn promote_callable_return_origins
    parameter_type:$common::Type
    type_variable:$str
    origins:$std::Option[std::List[Origin]]
    cleanup_origins:std::Option[std::List[Origin]]
-> std::Option[std::List[Origin]] {
    if parameter_type.clone common::Type::Function(function_type) is then
        for return_type in function_type.return_types.iter do
            if type_variable return_type.type_contains_var then
                origins cleanup_origins merge_origins return
            fi
        done
    fi
    cleanup_origins
}

fn clone_nonempty_origins
    origins_by_name:$std::Map[std::String std::List[Origin]]
    name:$str
-> std::Option[std::List[Origin]] {
    if name origins_by_name.get_str std::Option::Some(origins) is then
        if origins.is_empty ! then
            origins.clone std::Option::Some return
        fi
    fi
    std::Option[std::List[Origin]]::None
}

# A projected owned field provides storage even when it also carries payload loans.
fn needs_storage_origin value:$TypedValue -> bool {
    if value.type_value.is_borrow then
        false return
    fi
    if value.capability ValueCapability::Owned is then
        true return
    fi
    if value.place std::Option::Some(place) is then
        place.fields.is_empty ! return
    fi
    false
}

pub fn has_origin_descendant origin:$Origin origins:$std::List[Origin] -> bool {
    for other in origins.iter do
        if other.exclusive other.kind OriginKind::Place is && then
            if other.place origin.place.eq ! other.place origin.place.contains && then
                true return
            fi
        fi
    done
    false
}

fn resolve_loan_capability origins:$std::List[Origin] -> ValueCapability {
    for origin in origins.iter do
        if origin.exclusive then
            ValueCapability::Exclusive return
        fi
    done
    ValueCapability::Shared
}

pub struct VariableUses {
    pub counts:                   std::Map[std::String u64]
    pub observing_counts:         std::Map[std::String u64]
    pub cleanup_only_use_offsets: std::Set[i64]
    pub last_locations:           std::Map[std::String common::Location]
}

impl VariableUses {
    pub fn new -> VariableUses {
        std::Map[std::String common::Location]::new std::Set[i64]::new
        std::Map[std::String u64]::new std::Map[std::String u64]::new VariableUses
    }

    fn record
        self:mut$VariableUses
        name:$str
        location:$common::Location
        occurrences:u64
        observing:bool
    {
        0 = count: u64
        if name self.counts.get_copy_str std::Option::Some(found) is then
            found = count
        fi
        count occurrences + name self.counts.set_str
        if observing then
            0 = observing_count: u64
            if name self.observing_counts.get_copy_str std::Option::Some(found) is then
                found = observing_count
            fi
            observing_count occurrences + name self.observing_counts.set_str
            location.clone name self.last_locations.set_str
        fi
    }
}

impl source_body::SourceNode {
    fn is_drop self:$source_body::SourceNode -> bool {
        if self source_body::SourceNode::Leaf(leaf) is then
            if leaf.term source_body::SourceTerm::Intrinsic(kind) is then
                kind common::IntrinsicKind::Drop == return
            fi
        fi
        false
    }
}

impl source_body::SourceLeaf {
    fn record_uses
        self:$source_body::SourceLeaf
        uses:VariableUses
        cleanup_only:bool
    -> VariableUses {
        if self.term source_body::SourceTerm::Binding(kind name _) is then
            if kind source_body::BindingSyntax::Read == then
                if cleanup_only then
                    self
                        .origin
                        .span
                        .offset i64::try_from.unwrap uses.cleanup_only_use_offsets.add
                fi
                cleanup_only ! 1 self.origin name.as_str uses.record
                uses return
            fi
            if
                kind source_body::BindingSyntax::Assign !=
                kind source_body::BindingSyntax::Increment != &&
                kind source_body::BindingSyntax::Decrement != &&
            then
                uses return
            fi
            name.as_str "." str::split.unwrap = parts
            if parts.length 1 <= then
                uses return
            fi
            if kind source_body::BindingSyntax::Assign == then 1 else 2 fi = occurrences: u64
            true occurrences self.origin 0 parts.get.as_str uses.record
        fi
        uses
    }
}

# Source uses are measured before checking, while lexical spelling is intact.
fn collect_source_variable_uses body:$source_body::SourceBody uses:VariableUses -> VariableUses {
    body.get_nodes = nodes
    0 = index: u64
    while index nodes.length < do
        index nodes.get match
            source_body::SourceNode::Rejected(_) => {
            }
            source_body::SourceNode::Leaf(leaf) => {
                index 1 + nodes.length < = has_next
                false = cleanup_only
                if has_next then
                    index 1 + nodes.get.is_drop = cleanup_only
                fi
                cleanup_only uses leaf.record_uses = uses
            }
            source_body::SourceNode::Conditional(conditional) => {
                for branch in conditional.branches.iter do
                    uses branch.condition collect_source_variable_uses = uses
                    uses branch.consequent collect_source_variable_uses = uses
                done
                if conditional.alternative std::Option::Some(alternative) is then
                    uses alternative.body collect_source_variable_uses = uses
                fi
            }
            source_body::SourceNode::Loop(loop) => {
                uses loop.condition collect_source_variable_uses = uses
                uses loop.body collect_source_variable_uses = uses
            }
            source_body::SourceNode::Match(match_body) => {
                for arm in match_body.arms.iter do
                    uses arm.guard collect_source_variable_uses = uses
                    uses arm.body collect_source_variable_uses = uses
                done
            }
            source_body::SourceNode::Unsafe(region) => uses region.body collect_source_variable_uses = uses
            source_body::SourceNode::FormatExpr(region) => uses region.body collect_source_variable_uses = uses
            source_body::SourceNode::Array(compound) => uses compound.body collect_source_variable_uses = uses
            source_body::SourceNode::Group(compound) => uses compound.body collect_source_variable_uses = uses
        end
        1 += index
    done
    uses
}

enum SourceWork {
    Array(source_body::SourceBody)
    Group(source_body::SourceBody)
    Arm(source_body::SourceBody)
}

fn decrement_binding_use counts:mut$std::Map[std::String u64] name:$str {
    if name counts.get_str std::Option::Some(count) is then
        if 0 count != then
            count 1 - name.clone counts.set_str
        fi
    fi
}

pub fn type_capability typ:$common::Type -> ValueCapability {
    if typ.is_shared_borrow then
        ValueCapability::Shared return
    fi
    if typ.is_exclusive_borrow then
        ValueCapability::Exclusive return
    fi
    ValueCapability::Owned
}

fn capability_name capability:$ValueCapability -> str {
    capability match
        ValueCapability::Owned => "owned"
        ValueCapability::Shared => "shared"
        ValueCapability::Exclusive => "exclusive"
    end
}

fn value_owned_type value:$TypedValue -> common::Type {
    if value.type_value.borrow_target std::Option::Some(target) is then
        target.clone return
    fi
    value.type_value.clone
}

fn type_access_type typ:$common::Type capability:$ValueCapability -> common::Type {
    if typ.is_borrow then
        typ.clone return
    fi
    capability match
        ValueCapability::Shared => {
            common::SHARED_BORROW_TYPE typ.clone common::apply_borrow_type
        }
        ValueCapability::Exclusive => {
            common::EXCLUSIVE_BORROW_TYPE typ.clone common::apply_borrow_type
        }
        ValueCapability::Owned => typ.clone
    end
}

fn value_access_type value:$TypedValue -> common::Type {
    value.capability value.type_value type_access_type
}

enum BorrowShape derives std::Copy {
    Shared
    Exclusive
    Captured
}

fn type_contains_borrow
    typ:$common::Type
    shape:$BorrowShape
    store:$common::SymbolStore
    visiting:mut$std::List[std::String]
-> bool {
    if shape BorrowShape::Captured is typ.is_function && then
        true return
    fi
    if typ.is_borrow then
        shape match
            BorrowShape::Exclusive => typ.is_exclusive_borrow
            BorrowShape::Shared => typ.is_shared_borrow
            BorrowShape::Captured => false
        end return
    fi
    if typ common::Type::Generic(generic) is then
        for parameter in generic.params.iter do
            if visiting store shape parameter type_contains_borrow then
                true return
            fi
        done
        if generic.base.as_str visiting common::string_list_contains then
            false return
        fi
        generic.base.clone visiting.push
        std::Map[std::String common::Type]::new = bindings
        if generic.base store.structs.get std::Option::Some(casa_struct) is then
            for
                pair in generic.params.iter casa_struct
                    .type_vars
                    .list_iter
                    .zip
            do
                pair.second.clone pair.first.clone bindings.set
            done
            for member in casa_struct.members.iter do
                bindings member.typ.substitute_t = member_type
                if visiting store shape member_type type_contains_borrow then
                    true return
                fi
            done
        elif generic.base store.enums.get std::Option::Some(casa_enum) is then
            for
                pair in generic.params.iter casa_enum
                    .type_vars
                    .list_iter
                    .zip
            do
                pair.second.clone pair.first.clone bindings.set
            done
            for pair in casa_enum.variant_types.iter do
                for payload_type in pair.second.iter do
                    bindings payload_type.substitute_t = resolved
                    if visiting store shape resolved type_contains_borrow then
                        true return
                    fi
                done
            done
        fi
    fi
    false
}

pub fn clone_type_binding
    bindings:$std::Map[std::String common::Type]
    name:$str
-> std::Option[common::Type] {
    if name bindings.get_str std::Option::Some(value) is then
        value.clone std::Option::Some
    else
        std::Option[common::Type]::None
    fi
}
const SHARED_BORROW_SHAPE 1
const EXCLUSIVE_BORROW_SHAPE 2
const CAPTURED_BORROW_SHAPE 4

fn get_borrow_shape typ:$common::Type store:mut$common::SymbolStore -> i64 {
    if typ.is_shared_borrow then
        SHARED_BORROW_SHAPE return
    fi
    if typ.is_exclusive_borrow then
        EXCLUSIVE_BORROW_SHAPE return
    fi
    if typ.is_function then
        CAPTURED_BORROW_SHAPE return
    fi
    if typ common::Type::Generic is ! then
        0 return
    fi
    typ.format = key
    if key store.borrow_shapes.get std::Option::Some(cached) is then
        cached copy return
    fi
    std::List[std::String]::new = shared_visiting
    std::List[std::String]::new = exclusive_visiting
    0 = shape
    if shared_visiting store BorrowShape::Shared typ type_contains_borrow then
        SHARED_BORROW_SHAPE shape | = shape
    fi
    if exclusive_visiting store BorrowShape::Exclusive typ type_contains_borrow then
        EXCLUSIVE_BORROW_SHAPE shape | = shape
    fi
    std::List[std::String]::new = captured_visiting
    if captured_visiting store BorrowShape::Captured typ type_contains_borrow then
        CAPTURED_BORROW_SHAPE shape | = shape
    fi
    shape key store.borrow_shapes.set
    shape
}

pub fn type_has_shared_borrow typ:$common::Type store:mut$common::SymbolStore -> bool {
    store typ get_borrow_shape SHARED_BORROW_SHAPE & 0 !=
}

pub fn type_has_exclusive_borrow typ:$common::Type store:mut$common::SymbolStore -> bool {
    store typ get_borrow_shape EXCLUSIVE_BORROW_SHAPE & 0 !=
}

pub fn type_has_borrow typ:$common::Type store:mut$common::SymbolStore -> bool {
    store typ get_borrow_shape SHARED_BORROW_SHAPE EXCLUSIVE_BORROW_SHAPE | & 0 !=
}

fn does_cleanup_observe_borrow
    typ:$common::Type
    store:mut$common::SymbolStore
    visiting:mut$std::List[std::String]
-> bool {
    if typ.is_borrow then
        false return
    fi
    if
        store typ common::find_drop_function_name.is_some
        store typ type_has_borrow &&
    then
        true return
    fi
    if typ.clone common::Type::Generic(generic) is then
        typ.format = type_key
        if type_key.as_str visiting common::string_list_contains then
            false return
        fi
        type_key.clone visiting.push

        std::List[common::Type]::new = child_types
        if common::ARRAY_TYPE generic.base.as_str == then
            if 0 generic.params.length != then
                0 generic
                    .params
                    .get
                    .clone child_types.push
            fi
        elif generic.base.as_str store.structs.get_str std::Option::Some(casa_struct) is then
            casa_struct.type_vars typ common::aggregate_type_bindings = bindings
            for member in casa_struct.members.iter do
                bindings member.typ.substitute_t child_types.push
            done
        elif generic.base.as_str store.enums.get_str std::Option::Some(casa_enum) is then
            casa_enum.type_vars typ common::aggregate_type_bindings = bindings
            for pair in casa_enum.variant_types.iter do
                for payload in pair.second.iter do
                    bindings payload.substitute_t child_types.push
                done
            done
        fi

        for child_type in child_types.iter do
            if visiting store child_type does_cleanup_observe_borrow then
                visiting.pop drop
                true return
            fi
        done
        visiting.pop drop
    fi
    false
}

fn resolve_cleanup_origins
    typ:$common::Type
    origins:$std::Option[std::List[Origin]]
    nested_origins:std::Option[std::List[Origin]]
    store:$common::SymbolStore
-> std::Option[std::List[Origin]] {
    if store typ common::find_drop_function_name.is_some then
        origins.clone return
    fi
    nested_origins
}

pub fn method_receiver_type effect:$common::StackEffect -> std::Option[common::Type] {
    for parameter in effect.parameters.iter do
        parameter.typ.clone std::Option::Some return
    done
    std::Option[common::Type]::None
}

pub fn capability_matches_receiver capability:$ValueCapability expected:$common::Type -> bool {
    if capability ValueCapability::Shared is then
        expected.is_shared_borrow return
    fi
    if capability ValueCapability::Exclusive is then
        expected.is_shared_borrow expected.is_exclusive_borrow || return
    fi
    true
}

pub fn contains_literal literals:$std::List[LiteralRef] candidate:$LiteralRef -> bool {
    for literal in literals.iter do
        if candidate.id literal.id == then
            true return
        fi
    done
    false
}

fn locations_equal left:$common::Location right:$common::Location -> bool {
    left.file right.file ==
    left.span.offset right.span.offset == &&
    left.span.length right.span.length == &&
}

fn loan_spans_equal left:$LoanSpan right:$LoanSpan -> bool {
    right.origin left.origin locations_equal
    right.later_use left.later_use locations_equal &&
}

impl TypedValue {
    fn apply_return_origins
        self:mut$TypedValue
        origins:std::Option[std::List[Origin]]
        cleanup_origins:std::Option[std::List[Origin]]
        cleanup_mode:$ReturnCleanupMode
    {
        origins.clone = self.origins
        cleanup_mode match
            ReturnCleanupMode::NoCleanup => {
            }
            ReturnCleanupMode::Exact => {
                cleanup_origins = self.cleanup_origins
            }
            ReturnCleanupMode::AllOrigins => {
                origins = self.cleanup_origins
            }
        end
    }

    pub fn same_owner_source self:$TypedValue other:$TypedValue -> bool {
        if self.binding std::Option::Some(name) is then
            if other.binding std::Option::Some(other_name) is then
                if name other_name != then
                    false return
                fi
                if self.source std::Option::Some(source) is then
                    if other.source std::Option::Some(other_source) is then
                        source other_source == return
                    fi
                fi
            fi
            false return
        fi
        other.binding.is_none
    }

    pub fn same_place self:$TypedValue other:$TypedValue -> bool {
        if self.place std::Option::Some(place) is then
            if other.place std::Option::Some(other_place) is then
                place other_place.eq return
            fi
            false return
        fi
        other.place.is_none
    }

    pub fn clear_owner_source self:mut$TypedValue {
        std::Option[Place]::None = self.place
        std::Option[std::String]::None = self.binding
        std::Option[i64]::None = self.source
    }

    pub fn resolve_literals
        self:mut$TypedValue
        target:$common::Type
        diagnostics:mut$error::Diagnostics
        resolutions:mut$std::Map[i64 common::Type]
    -> bool {
        target.clone = resolved_target
        if resolved_target.borrow_target std::Option::Some(borrowed_target) is then
            borrowed_target.clone = resolved_target
        fi
        for literal in self.literals.iter do
            if literal.kind LiteralKind::Aggregate == then
                if self.type_value resolved_target common::stack_effect_type_matches ! then
                    false return
                fi
            fi
            if 0 literal.id != then
                resolved_target.clone literal.id resolutions.set
            fi
        done
        true
    }
}

impl TypedStack {
    pub fn new -> TypedStack { std::List[TypedValue]::new TypedStack }

    pub fn snapshot self:$TypedStack -> TypedStack {
        std::List[TypedValue]::new = values
        for value in self.values.iter do
            value.clone values.push
        done
        values TypedStack
    }

    pub fn restore self:mut$TypedStack source:$TypedStack {
        std::List[TypedValue]::new = values
        for value in source.values.iter do
            value.clone values.push
        done
        values = self.values
    }

    pub fn get_types self:$TypedStack -> std::List[common::Type] {
        std::List[common::Type]::new = types
        for value in self.values.iter do
            value.type_value.clone types.push
        done
        types
    }

    pub fn peek_callables self:$TypedStack -> std::Set[std::String] {
        if self.values.is_empty then
            std::Set[std::String]::new return
        fi
        self.values.length 1 - self
            .values
            .get
            .callables
            .clone
    }

    pub fn set_top_callables self:mut$TypedStack callables:std::Set[std::String] {
        if self.values.is_empty then
            return
        fi
        self.values.length 1 - self.values.get_mut = value
        callables = value.callables
    }

    pub fn set_return_callables
        self:mut$TypedStack
        return_callables:$std::List[std::Set[std::String]]
    {
        if self.values.length return_callables.length < then
            return
        fi
        self.values.length return_callables.length - = start
        0 = index: u64
        while index return_callables.length < do
            start index + self.values.get_mut = value
            index return_callables.get.clone = value.callables
            if value.type_value.is_function value.callables.is_empty && then
                CALLABLE_CONTRACT value.callables.add_str
            fi
            1 += index
        done
    }

    pub fn set_types self:mut$TypedStack types:$std::List[common::Type] {
        0 = index: u64
        while index self.values.length < do
            index self.values.get_mut = value
            index types.get.clone = value.type_value
            1 += index
        done
    }

    # Pure stack comparison on the types slice (origins are not compared).
    pub fn equals self:$TypedStack other:$TypedStack -> bool {
        if self.values.length other.values.length != then
            false return
        fi
        0 = index: u64
        while index self.values.length < do
            if
                index self
                    .values
                    .get
                    .capability
                index other
                    .values
                    .get
                    .capability !=
            then
                false return
            fi
            1 += index
        done
        self.get_types other.get_types stacks_equal
    }

    pub fn merge_literals self:mut$TypedStack candidate:$TypedStack {
        0 = index: u64
        while index self.values.length < do
            index self.values.get_mut = value
            index candidate.values.get = candidate_value
            if candidate_value value.same_owner_source ! then
                value.clear_owner_source
            elif candidate_value value.same_place ! then
                std::Option[Place]::None = value.place
            fi
            value.origins.clone = original_origins
            if original_origins.clone std::Option::Some(original_items) is then
                for original_origin in original_items.iter do
                    if original_origin value.loan_spans.has ! then
                        std::Option[LoanSpan]::None original_origin.clone value.loan_spans.set
                    fi
                done
            fi
            if candidate_value.origins std::Option::Some(candidate_origins) is then
                for candidate_origin in candidate_origins.iter do
                    false = value_has_origin
                    if original_origins.clone std::Option::Some(original_items) is then
                        candidate_origin original_items contains_origin
                        = value_has_origin
                    fi
                    if value_has_origin then
                        false = spans_match
                        if
                            candidate_origin value.loan_spans.get
                            std::Option::Some(existing) is
                        then
                            if
                                candidate_origin candidate_value.loan_spans.get
                                std::Option::Some(candidate_span_opt) is
                            then
                                if existing std::Option::Some(existing_span) is then
                                    if candidate_span_opt std::Option::Some(candidate_span) is then
                                        candidate_span existing_span loan_spans_equal = spans_match
                                    fi
                                fi
                            fi
                        fi
                        if spans_match ! then
                            std::Option[LoanSpan]::None candidate_origin.clone
                            value.loan_spans.set
                        fi
                    elif
                        candidate_origin candidate_value.loan_spans.get
                        std::Option::Some(candidate_span_opt) is
                    then
                        candidate_span_opt.clone candidate_origin.clone value.loan_spans.set
                    else
                        std::Option[LoanSpan]::None candidate_origin.clone value.loan_spans.set
                    fi
                done
            fi
            candidate_value.origins original_origins merge_origins = merged_origins
            merged_origins = value.origins
            candidate_value.cleanup_origins value.cleanup_origins.clone merge_origins
            = value.cleanup_origins
            0 = literal_index: u64
            while literal_index candidate_value.literals.length < do
                literal_index candidate_value.literals.get = candidate_literal
                if candidate_literal value.literals contains_literal ! then
                    candidate_literal.clone value.literals.push
                fi
                1 += literal_index
            done
            for callable in candidate_value.callables.iter do
                callable.clone value.callables.add
            done
            1 += index
        done
    }

    pub fn mark_literals_runtime self:mut$TypedStack {
        0 = index: u64
        while index self.values.length < do
            index self.values.get_mut = value
            if 0 value.literals.length != then
                false = value.is_literal_constant
            fi
            1 += index
        done
    }

    # Produce unified types and retain literal origins from both stacks.
    pub fn unify_types
        self:mut$TypedStack
        candidate:$TypedStack
        store:mut$common::SymbolStore
    -> std::List[common::Type] {
        if self.values.length candidate.values.length == then
            0 = index: u64
            while index self.values.length < do
                if
                    index self
                        .values
                        .get
                        .capability
                    index candidate
                        .values
                        .get
                        .capability !=
                then
                    std::List[common::Type]::new return
                fi
                1 += index
            done
        fi
        store self.get_types candidate.get_types stacks_compatible = unified
        if unified.length self.values.length == then
            candidate self.merge_literals
        fi
        unified
    }
}

# Branch contexts — one specialized struct per branch kind (if / while / match).
struct BindingLoans derives std::Clone {
    capability:      ValueCapability
    origins:         std::Option[std::List[Origin]]
    cleanup_origins: std::Option[std::List[Origin]]
    location:        std::Option[common::Location]
}

impl BindingLoans {
    fn format_sources self:$BindingLoans -> std::String {
        std::List[std::String]::new = sources
        if self.origins std::Option::Some(origins) is then
            for origin in origins.iter do
                origin
                    .place
                    .binding
                    .as_str = source
                if source sources common::string_list_contains ! then
                    source.to_str sources.push
                fi
            done
        fi
        ", " sources.join_strings
    }

    fn collect_spans
        self:$BindingLoans
        later_use:$common::Location
    -> std::Map[Origin std::Option[LoanSpan]] {
        std::Map[Origin std::Option[LoanSpan]]::new = spans
        if self.location std::Option::Some(location) is then
            if self.origins std::Option::Some(origins) is then
                for origin in origins.iter do
                    later_use.clone location.clone LoanSpan std::Option::Some origin.clone spans.set
                done
            fi
        fi
        spans
    }

    fn merge self:mut$BindingLoans other:$BindingLoans {
        if self.origins.is_none then
            other.location.clone = self.location
        elif other.origins.is_some then
            false = same_location
            if self.location std::Option::Some(location) is then
                if other.location std::Option::Some(other_location) is then
                    other_location location locations_equal = same_location
                fi
            fi
            if same_location ! then
                std::Option[common::Location]::None = self.location
            fi
        fi
        if other.capability ValueCapability::Owned is ! then
            other.capability = self.capability
        fi
        other.origins self.origins.clone merge_origins = self.origins
        other.cleanup_origins self.cleanup_origins.clone merge_origins = self.cleanup_origins
    }
}

fn origins_equal
    left:$std::Option[std::List[Origin]]
    right:$std::Option[std::List[Origin]]
-> bool {
    if left std::Option::Some(left_items) is then
        if right std::Option::Some(right_items) is then
            if left_items.length right_items.length != then
                false return
            fi
            true = equal
            for origin in left_items.iter do
                origin right_items contains_origin equal && = equal
            done
            equal return
        fi
        false return
    fi
    right.is_none
}

struct OwnershipFlow {
    moved:                   std::List[std::String]
    reported_move_conflicts: std::List[std::String]
    bindings:                std::Map[std::String BindingLoans]
    callables:               std::Map[std::String std::Set[std::String]]
}

impl OwnershipFlow {
    pub fn new -> OwnershipFlow {
        std::Map[std::String std::Set[std::String]]::new
        std::Map[std::String BindingLoans]::new
        std::List[std::String]::new
        std::List[std::String]::new
        OwnershipFlow
    }

    pub fn merge self:mut$OwnershipFlow other:$OwnershipFlow {
        for name in other.moved.iter do
            if name.as_str self.moved common::string_list_contains ! then
                name.clone self.moved.push
            fi
        done
        for name in other.reported_move_conflicts.iter do
            if name.as_str self.reported_move_conflicts common::string_list_contains ! then
                name.clone self.reported_move_conflicts.push
            fi
        done
        for pair in other.bindings.iter do
            if pair.first self.bindings.get_mut std::Option::Some(existing) is then
                pair.second existing.merge
            else
                pair.second.clone pair.first.clone self.bindings.set
            fi
        done
        for pair in other.callables.iter do
            std::Set[std::String]::new = callables
            if pair.first self.callables.get std::Option::Some(existing) is then
                existing.clone = callables
            fi
            for callable in pair.second.iter do
                callable.clone callables.add
            done
            callables pair.first.clone self.callables.set
        done
    }

    pub fn remove_move self:mut$OwnershipFlow name:$str {
        name self.moved common::string_list_index = index
        if 0 index > then
            return
        fi
        self.moved.pop = last
        if self.moved.length index u64::try_from.unwrap > then
            last index u64::try_from.unwrap self.moved.set
        fi
    }
}

struct IfContext {
    before:                  TypedStack
    after:                   TypedStack
    flow_before:             OwnershipFlow
    flow_after:              OwnershipFlow
    entry_continues:         bool
    has_continuing_branch:   bool
    condition_present:       bool
    default_present:         bool
    conditional_moves:       std::List[std::String]
    current_branch_label:    std::String
    current_branch_location: common::Location
    entry_facts_available:   bool
    branches_have_facts:     bool
}

struct WhileContext {
    live_bindings:           std::Set[std::String]
    after:                   TypedStack
    before:                  TypedStack
    flow_before:             OwnershipFlow
    flow_exit:               OwnershipFlow
    entry_continues:         bool
    has_exit:                bool
    condition_present:       bool
    current_branch_location: common::Location
    scope_depth:             u64
    body_start:              u64
}

struct MatchContext {
    before:                  TypedStack
    after:                   TypedStack
    flow_before:             OwnershipFlow
    flow_after:              OwnershipFlow
    entry_continues:         bool
    has_continuing_arm:      bool
    condition_present:       bool
    coverage:                std::List[pattern::CoverageRow]
    match_type:              common::Type
    match_origins:           std::Option[std::List[Origin]]
    match_cleanup_origins:   std::Option[std::List[Origin]]
    match_place:             std::Option[Place]
    current_branch_location: common::Location
    entry_facts_available:   bool
    arms_have_facts:         bool
}

enum BranchFrame {
    BranchIf(IfContext)
    BranchWhile(WhileContext)
    BranchMatch(MatchContext)
}

impl BranchFrame {
    fn into_if self:BranchFrame -> IfContext {
        self match
            BranchFrame::BranchIf(context) => context
            BranchFrame::BranchWhile(_) => {
                "Internal error: expected if branch frame\n" std::eprint
                1 std::process::exit
                IfContext::new
            }
            BranchFrame::BranchMatch(_) => {
                "Internal error: expected if branch frame\n" std::eprint
                1 std::process::exit
                IfContext::new
            }
        end
    }

    fn into_while self:BranchFrame -> WhileContext {
        self match
            BranchFrame::BranchIf(_) => {
                "Internal error: expected while branch frame\n" std::eprint
                1 std::process::exit
                0 WhileContext::new
            }
            BranchFrame::BranchWhile(context) => context
            BranchFrame::BranchMatch(_) => {
                "Internal error: expected while branch frame\n" std::eprint
                1 std::process::exit
                0 WhileContext::new
            }
        end
    }

    fn into_match self:BranchFrame -> MatchContext {
        self match
            BranchFrame::BranchIf(_) => {
                "Internal error: expected match branch frame\n" std::eprint
                1 std::process::exit
                common::make_unknown_type.clone MatchContext::new
            }
            BranchFrame::BranchWhile(_) => {
                "Internal error: expected match branch frame\n" std::eprint
                1 std::process::exit
                common::make_unknown_type.clone MatchContext::new
            }
            BranchFrame::BranchMatch(context) => context
        end
    }
}

impl IfContext {
    pub fn new -> IfContext {
        true true
        common::empty_location
        "".to_str
        std::List[std::String]::new
        false
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        TypedStack::new
        IfContext
    }
}

impl WhileContext {
    pub fn new scope_depth:u64 -> WhileContext {
        0 scope_depth
        common::empty_location
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        TypedStack::new
        std::Set[std::String]::new WhileContext
    }
}

impl MatchContext {
    pub fn new match_type:common::Type -> MatchContext {
        true true
        common::empty_location
        std::Option[Place]::None
        std::Option[std::List[Origin]]::None
        std::Option[std::List[Origin]]::None
        match_type
        std::List[pattern::CoverageRow]::new
        false
        false
        false
        OwnershipFlow::new
        OwnershipFlow::new
        TypedStack::new
        TypedStack::new
        MatchContext
    }
}

# Own the diagnostic inputs until the parameter check finishes. Source-name
# lookup and message construction run only when a diagnostic needs the text.
struct ParameterContext {
    operation: std::String
    name:      std::String
    index:     u64
    file:      std::String
}

enum ExpectationContext {
    None
    Text(std::String)
    Parameter(ParameterContext)
}

# Per-body ownership proof state. Stack checking supplies live stack and scope
# facts through methods and never accesses these collections directly.
struct OwnershipChecker {
    moved_owners:             std::List[std::String]
    # Latest move sites persist after reinitialization and flow restores.
    # Read them only while the owner is moved.
    move_locations:           std::Map[std::String common::Location]
    reported_move_conflicts:  std::List[std::String]
    owner_events:             std::List[common::OwnerEvent]
    next_owner_generation:    u64
    moved_operations:         std::Set[i64]
    binding_loans:            std::Map[std::String BindingLoans]
    remaining_uses:           std::Map[std::String u64]
    remaining_observing_uses: std::Map[std::String u64]
    cleanup_only_use_offsets: std::Set[i64]
    last_use_locations:       std::Map[std::String common::Location]
}

impl OwnershipChecker {
    fn new -> OwnershipChecker {
        std::Map[std::String common::Location]::new # last_use_locations
        std::Set[i64]::new # cleanup_only_use_offsets
        std::Map[std::String u64]::new # remaining_observing_uses
        std::Map[std::String u64]::new # remaining_uses
        std::Map[std::String BindingLoans]::new # binding_loans
        std::Set[i64]::new # moved_operations
        0 # next_owner_generation
        std::List[common::OwnerEvent]::new # owner_events
        std::List[std::String]::new # reported_move_conflicts
        std::Map[std::String common::Location]::new # move_locations
        std::List[std::String]::new # moved_owners
        OwnershipChecker
    }

    pub fn owner_is_moved self:$OwnershipChecker name:$str -> bool {
        name self.moved_owners common::string_list_contains
    }

    pub fn set_owner_moved self:mut$OwnershipChecker name:$str moved:bool {
        name self.moved_owners common::string_list_index = index
        if moved then
            if 0 index > then
                name.clone self.moved_owners.push_str
            fi
            return
        fi
        if 0 index <= then
            self.moved_owners.pop = last
            if self.moved_owners.length index u64::try_from.unwrap > then
                last index u64::try_from.unwrap self.moved_owners.set
            fi
        fi
    }

    pub fn use_binding self:mut$OwnershipChecker name:$str op:$common::Op {
        name self.remaining_uses decrement_binding_use
        if
            op
                .location
                .span
                .offset i64::try_from.unwrap self.cleanup_only_use_offsets.has
        then
            return
        fi
        name self.remaining_observing_uses decrement_binding_use
    }

    pub fn binding_is_live self:$OwnershipChecker name:$str -> bool {
        if name self.remaining_observing_uses.get_str std::Option::Some(count) is then
            0 count != return
        fi
        false
    }

    fn make_loan_conflict
        self:$OwnershipChecker
        binding:std::Option[std::String]
        fallback_origin:$common::Location
    -> LoanConflict {
        fallback_origin.clone std::Option::Some = origin
        std::Option[common::Location]::None = later_use
        if binding.clone std::Option::Some(name) is then
            if name.as_str self.binding_loans.get_str std::Option::Some(loans) is then
                if loans.location std::Option::Some(location) is then
                    location.clone std::Option::Some = origin
                fi
            fi
            if name.as_str self.binding_is_live then
                if name.as_str self.last_use_locations.get_str std::Option::Some(location) is then
                    location.clone std::Option::Some = later_use
                fi
            fi
        fi
        later_use origin binding LoanConflict
    }

    fn make_stacked_loan_conflict
        self:$OwnershipChecker
        value:$TypedValue
        matched_origin:std::Option[Origin]
    -> LoanConflict {
        value self.loan_binding_for_value = binding
        std::Option[common::Location]::None = origin
        std::Option[common::Location]::None = later_use
        false = has_tracked_origin
        if matched_origin std::Option::Some(matched) is then
            if
                matched value.loan_spans.get
                std::Option::Some(tracked_span) is
            then
                true = has_tracked_origin
                if tracked_span std::Option::Some(span) is then
                    span.origin.clone std::Option::Some = origin
                    span.later_use.clone std::Option::Some = later_use
                fi
            fi
        fi
        if has_tracked_origin ! then
            value.origin.clone std::Option::Some = origin
        fi
        later_use origin binding LoanConflict
    }

    fn loan_binding_for_value self:$OwnershipChecker value:$TypedValue -> std::Option[std::String] {
        if value.place std::Option::Some(value_place) is then
            value_place.binding.clone = root
            if value.loan_spans.is_empty ! root.as_str self.binding_loans.has_str || then
                root std::Option::Some return
            fi
        fi
        std::Option[std::String]::None
    }

    fn find_value_loan_conflict
        self:$OwnershipChecker
        value:$TypedValue
        place:$Place
        exclusive:bool
        ignored_bindings:$std::List[std::String]
    -> std::Option[LoanConflict] {
        if value.binding std::Option::Some(binding_name) is then
            if
                place.fields.is_empty place.binding.as_str binding_name.as_str == &&
                binding_name.as_str ignored_bindings common::string_list_contains ||
            then
                std::Option[LoanConflict]::None return
            fi
        fi
        if value.place std::Option::Some(value_place) is then
            if place value_place.eq value.type_value.is_borrow exclusive ! || && then
                std::Option[LoanConflict]::None return
            fi
        fi
        if value.capability ValueCapability::Owned is ! then
            if value.place std::Option::Some(value_place) is then
                if
                    place value_place.overlaps
                    value.capability ValueCapability::Exclusive is exclusive || &&
                then
                    std::Option[Origin]::None value self.make_stacked_loan_conflict
                    std::Option::Some return
                fi
            fi
        fi
        exclusive place value self.find_value_origin_conflict
    }

    # Report a loan that a value holds on an overlapping place.
    fn find_value_origin_conflict
        self:$OwnershipChecker
        value:$TypedValue
        place:$Place
        exclusive:bool
    -> std::Option[LoanConflict] {
        if value.origins std::Option::Some(origins) is then
            for origin in origins.iter do
                if
                    place origin.overlaps
                    origin.exclusive exclusive || &&
                then
                    origin.clone std::Option::Some value self.make_stacked_loan_conflict
                    std::Option::Some return
                fi
            done
        fi
        std::Option[LoanConflict]::None
    }

    pub fn owner_cleanups_for_names
        self:mut$OwnershipChecker
        names:mut$std::List[std::String]
    -> std::List[common::OwnerEvent] {
        std::List[common::OwnerEvent]::new = cleanups
        self.owner_events.length = event_index
        while 0 event_index != do
            1 -= event_index
            event_index self.owner_events.get = event
            if event.name.as_str names common::string_list_contains then
                event.clone cleanups.push
            fi
        done
        cleanups
    }

    pub fn remove_owner_events_for_names
        self:mut$OwnershipChecker
        names:mut$std::List[std::String]
    {
        std::List[common::OwnerEvent]::new = remaining
        self.owner_events.reverse
        while self.owner_events.is_empty ! do
            self.owner_events.pop = event
            if event.name.as_str names common::string_list_contains ! then
                event remaining.push
            fi
        done
        remaining = self.owner_events
    }

    fn describe_loan self:$OwnershipChecker conflict:$LoanConflict -> std::String {
        "loan starts here".to_str = explanation
        if conflict.binding std::Option::Some(name) is then
            if name.as_str self.binding_loans.get_str std::Option::Some(loans) is then
                loans.format_sources = sources
                if sources.is_empty ! then
                    f" (borrow sources: {sources})".as_str explanation.append
                fi
            fi
        fi
        explanation
    }

    # Mark an initialized owner as moved at the current location.
    pub fn record_owner_move self:mut$OwnershipChecker location:$common::Location name:$str {
        true name self.set_owner_moved
        location.clone name.to_str self.move_locations.set
    }

    pub fn record_binding_origins
        self:mut$OwnershipChecker
        current_location:$common::Location
        name:$str
        origins:mut$std::Option[std::List[Origin]]
        cleanup_origins:mut$std::Option[std::List[Origin]]
        capability:$ValueCapability
    {
        if origins.is_some cleanup_origins.is_some || then
            std::Option[common::Location]::None = location
            if origins.is_some then
                current_location.clone std::Option::Some = location
            fi
            location cleanup_origins.clone origins.clone capability copy BindingLoans
            name.to_str self.binding_loans.set
        elif name self.binding_loans.has_str then
            name self.binding_loans.delete_str
        fi
    }

    pub fn report_moved_owner
        self:$OwnershipChecker
        diagnostics:mut$error::Diagnostics
        location:$common::Location
        name:$str
    {
        location.clone f"Owner `{name}` was already moved" common::ErrorKind::InvalidVariable
        error::CasaError::new = diagnostic
        if name self.move_locations.get_str std::Option::Some(moved_at) is then
            moved_at.clone f"`{name}` moved here" error::CasaNote diagnostic.notes.push
        fi
        diagnostic diagnostics.push_error
    }

    fn report_loan_conflict
        self:$OwnershipChecker
        diagnostics:mut$error::Diagnostics
        current_location:$common::Location
        message:std::String
        conflict:$LoanConflict
    {
        current_location.clone message common::ErrorKind::InvalidVariable error::CasaError::new
        = diagnostic
        if conflict.origin std::Option::Some(location) is then
            if "" location.file.as_str != then
                conflict self.describe_loan = explanation
                location.clone explanation error::CasaNote = note
                note diagnostic.notes.push
            fi
        fi
        if conflict.later_use std::Option::Some(location) is then
            if "" location.file.as_str != then
                if conflict.binding std::Option::Some(binding) is then
                    f"later use of `{binding}` keeps this loan active"
                else
                    "later use keeps this loan active".to_str
                fi = note_message
                location.clone note_message error::CasaNote = note
                note diagnostic.notes.push
            fi
        fi
        diagnostic diagnostics.push_error
    }

    fn find_conflicting_loan_except
        self:$OwnershipChecker
        stack:$TypedStack
        scope:$block_scope::BlockScope
        enclosing_stacks:$std::List[TypedStack]
        branches:$std::List[BranchFrame]
        place:$Place
        stack_depth:u64
        exclusive:bool
        ignored_bindings:$std::List[std::String]
    -> std::Option[LoanConflict] {
        0 = index: u64
        while index stack_depth < do
            index stack.values.get = value
            ignored_bindings exclusive place value self.find_value_loan_conflict = conflict
            if conflict.is_some then
                conflict return
            fi
            1 += index
        done
        # Borrows held below an f-string expression stay live while it runs.
        for enclosing in enclosing_stacks.iter do
            for value in enclosing.values.iter do
                exclusive place value self.find_value_origin_conflict = conflict
                if conflict.is_some then
                    conflict return
                fi
            done
        done
        for
            binding in self
                .binding_loans
                .iter
        do
            binding.first = binding_name
            if
                place.binding.as_str binding_name.as_str ==
                binding_name.as_str ignored_bindings common::string_list_contains ||
                binding_name.as_str scope
                    .has_binding ! ||
            then
                continue
            fi
            binding.second = loans
            if binding_name.as_str self.binding_is_live then
                loans.origins
            elif binding_name.as_str self.owner_is_moved ! then
                loans.cleanup_origins
            else
                continue
            fi = active_origins: $std::Option[std::List[Origin]]
            if active_origins std::Option::Some(origins) is then
                for origin in origins.iter do
                    if
                        place origin.overlaps
                        origin.exclusive exclusive || &&
                    then
                        common::empty_location binding_name.clone std::Option::Some self.make_loan_conflict
                        std::Option::Some return
                    fi
                done
            fi
        done
        for frame in branches.iter do
            if frame BranchFrame::BranchWhile(while_ctx) is then
                for
                    pair in while_ctx
                        .flow_before
                        .bindings
                        .iter
                do
                    if
                        place.binding.as_str pair.first.as_str ==
                        pair.first.as_str ignored_bindings common::string_list_contains ||
                        pair.first.as_str scope
                            .has_binding ! ||
                    then
                        continue
                    fi
                    if pair.first while_ctx.live_bindings.has then
                        pair.second.origins
                    else
                        pair.second.cleanup_origins
                    fi match
                        std::Option::Some(origins) => origins
                        std::Option::None => continue
                    end = loop_origins: $std::List[Origin]
                    for origin in loop_origins.iter do
                        if
                            place origin.overlaps
                            origin.exclusive exclusive || &&
                        then
                            common::empty_location = loan_origin
                            if pair.second.location std::Option::Some(location) is then
                                location.clone = loan_origin
                            fi
                            std::Option[common::Location]::None
                            loan_origin std::Option::Some
                            pair.first.clone std::Option::Some LoanConflict
                            std::Option::Some return
                        fi
                    done
                done
            fi
        done
        std::Option[LoanConflict]::None
    }

    pub fn current_ownership_flow
        self:$OwnershipChecker
        scope:$block_scope::BlockScope
        callables:$std::Map[std::String std::Set[std::String]]
    -> OwnershipFlow {
        std::List[std::String]::new = moved
        for name in self.moved_owners.iter do
            if
                name.as_str scope
                    .lookup
                    .is_some
            then
                name.clone moved.push
            fi
        done
        std::Map[std::String BindingLoans]::new = bindings
        for pair in self.binding_loans.iter do
            if
                pair.first.as_str scope
                    .lookup
                    .is_some
            then
                pair.second.clone pair.first.clone bindings.set
            fi
        done
        std::Map[std::String std::Set[std::String]]::new = copied_callables
        for pair in callables.iter do
            pair.second.clone pair.first.clone copied_callables.set
        done
        self.reported_move_conflicts.clone = reported_move_conflicts
        copied_callables bindings reported_move_conflicts moved OwnershipFlow
    }

    pub fn restore_ownership_flow self:mut$OwnershipChecker flow:$OwnershipFlow {
        flow.moved.clone = self.moved_owners
        flow.reported_move_conflicts.clone = self.reported_move_conflicts
        flow.bindings.clone = self.binding_loans
    }

    pub fn remove_flow_names self:mut$OwnershipChecker names:$std::List[std::String] {
        for name in names.iter do
            false name.as_str self.set_owner_moved
            name.as_str self.reported_move_conflicts common::string_list_index = conflict_index
            if 0 conflict_index <= then
                self.reported_move_conflicts.pop = last_conflict
                if self.reported_move_conflicts.length conflict_index u64::try_from.unwrap > then
                    last_conflict conflict_index u64::try_from.unwrap self.reported_move_conflicts.set
                fi
            fi
            if name.as_str self.binding_loans.has_str then
                name.as_str self.binding_loans.delete_str
            fi
        done
    }

    # A borrowed local aliases its sources. Its own binding is not new storage.
    fn add_storage_origins
        self:$OwnershipChecker
        origins:std::Option[std::List[Origin]]
        storage:$std::Option[Place]
        exclusive:bool
    -> std::Option[std::List[Origin]] {
        if storage std::Option::Some(place) is then
            if place.binding self.binding_loans.get std::Option::Some(binding) is then
                if binding.capability ValueCapability::Owned is ! then
                    if binding.origins std::Option::Some(sources) is then
                        for source in sources.iter do
                            if
                                source.kind OriginKind::Place is source.place.binding place.binding == && source
                                    .place
                                    .fields
                                    .is_empty &&
                            then
                                exclusive place origins add_origin = origins
                            else
                                source.clone origins append_origin = origins
                            fi
                        done
                        origins return
                    fi
                fi
            fi
            exclusive place origins add_origin = origins
        fi
        origins
    }

    fn merge_destination_origins
        self:$OwnershipChecker
        target:std::Option[std::List[Origin]]
        value:$TypedValue
        expected:$common::Type
    -> std::Option[std::List[Origin]] {
        value.origins target merge_origins = target
        if expected.is_borrow value.origins.is_none value needs_storage_origin || && then
            expected.is_exclusive_borrow value.place target self.add_storage_origins = target
        fi
        target
    }

    fn materialize_declared_return_borrow
        self:$OwnershipChecker
        value:mut$TypedValue
        declared:$common::Type
    {
        if declared.is_borrow ! value.capability ValueCapability::Owned is || then
            return
        fi
        value needs_storage_origin = borrows_storage
        value.type_value.clone = target
        if value.type_value.borrow_target std::Option::Some(borrowed_target) is then
            borrowed_target.clone = target
        fi
        if declared.is_exclusive_borrow then
            common::EXCLUSIVE_BORROW_TYPE
        else
            common::SHARED_BORROW_TYPE
        fi
        target common::apply_borrow_type = value.type_value
        std::Option[std::List[Origin]]::None = origins
        if value.origins std::Option::Some(current_origins) is then
            for origin in current_origins.iter do
                declared.is_exclusive_borrow origin.with_capability = adjusted
                adjusted origins append_origin = origins
            done
        fi
        if origins.is_none borrows_storage || then
            declared.is_exclusive_borrow value.place origins self.add_storage_origins = origins
        fi
        origins = value.origins
    }

    # A generic input can become a borrow at a concrete callable boundary.
    fn resolve_input_storage_origin
        self:$OwnershipChecker
        effect:$common::StackEffect
        dependency:$Origin
        origins:std::Option[std::List[Origin]]
        value:$TypedValue
    -> std::Option[std::List[Origin]] {
        for parameter in effect.parameters.iter do
            if parameter.name dependency.place.binding == parameter.typ.is_borrow && then
                parameter.typ.is_exclusive_borrow value.place origins self.add_storage_origins return
            fi
        done
        origins
    }

    fn record_assignment
        self:mut$OwnershipChecker
        op:mut$common::Op
        name:$str
        typ:$common::Type
        scope:$block_scope::BlockScope
    {
        1 += self.next_owner_generation
        self.next_owner_generation typ name common::OwnerEvent::new = event
        if name scope.resolve_binding_reference std::Option::Some(binding) is then
            binding.storage_name.clone = event.storage_name
        fi
        event.clone op
            .ensure_ownership
            .assignments
            .push
        event self.owner_events.push
    }

    fn all_owner_cleanups
        self:$OwnershipChecker
    -> std::List[common::OwnerEvent] std::List[std::String] {
        self.owner_events.clone = cleanups
        cleanups.reverse
        std::List[std::String]::new = ending_names
        for event in cleanups.iter do
            if event.name.as_str ending_names common::string_list_contains ! then
                event.name.clone ending_names.push
            fi
        done
        for
            name in self
                .binding_loans
                .keys
                .iter
        do
            if name.as_str ending_names common::string_list_contains ! then
                name.clone ending_names.push
            fi
        done
        cleanups ending_names
    }

    fn has_owner_cleanups self:$OwnershipChecker -> bool { self.owner_events.is_empty ! }

    fn has_reported_move_conflict self:$OwnershipChecker name:$str -> bool {
        name self.reported_move_conflicts common::string_list_contains
    }

    fn record_move_conflict self:mut$OwnershipChecker name:$str {
        if name self.has_reported_move_conflict ! then
            name.to_str self.reported_move_conflicts.push
        fi
    }

    fn record_operation_move self:mut$OwnershipChecker operation:i64 {
        operation self.moved_operations.add
    }

    fn attach_body_moves self:$OwnershipChecker body:mut$body_builder::Builder {
        self.moved_operations = moved: $std::Set[i64]
        {
            = operation: mut$common::Op
            if operation.id moved.has then
                true = operation.ensure_ownership.moves_owner
            fi
        } = visitor
        visitor body.visit_operations_mut
    }

    fn set_variable_uses self:mut$OwnershipChecker uses:$VariableUses {
        uses.counts.clone = self.remaining_uses
        uses.observing_counts.clone = self.remaining_observing_uses
        uses.cleanup_only_use_offsets.clone = self.cleanup_only_use_offsets
        uses.last_locations.clone = self.last_use_locations
    }

    fn binding_has_remaining_uses self:$OwnershipChecker name:$std::String -> bool {
        if name self.remaining_uses.get std::Option::Some(count) is then
            0 count != return
        fi
        false
    }

    fn find_binding_loans self:$OwnershipChecker name:$str -> std::Option[$BindingLoans] {
        name self.binding_loans.get_str
    }

    # Move sites outlive branch restores, but a guard checks its own moves.
    fn inherit_move_locations self:mut$OwnershipChecker parent:$OwnershipChecker {
        parent.move_locations.clone = self.move_locations
    }

    fn validate_guard_moves
        self:$OwnershipChecker
        parent:$OwnershipChecker
        location:$common::Location
        diagnostics:mut$error::Diagnostics
    {
        for name in self.moved_owners.iter do
            if name.as_str parent.owner_is_moved ! then
                location f"Match guard cannot move owner `{name}`"
                common::ErrorKind::InvalidVariable diagnostics.record_error_string
            fi
        done
    }
}

struct TypeChecker {
    stack:                      TypedStack
    parameters:                 std::List[common::Parameter]
    return_types:               TypedStack
    has_return_types:           bool
    branched_stacks:            std::List[BranchFrame]
    current_location:           common::Location
    current_op_context:         std::String
    current_expect_ctx:         ExpectationContext
    in_branch_condition:        bool
    path_continues:             bool
    store:                      mut$common::SymbolStore
    param_cap:                  std::Option[u64]
    underflow_reported_this_op: bool
    ownership:                  OwnershipChecker
    scope:                      block_scope::BlockScope
    scalar_inputs:              std::List[common::ScalarInput]
    operation_stack_depth:      u64
    current_trait_bounds:       std::Map[std::String std::List[common::TraitBound]]
    unsafe_depth:               u64
    # Scope depth of the innermost f-string expression, or zero outside one.
    format_scope_depth:         u64
    # Stacks that enclosing f-string expressions set aside, innermost last.
    format_enclosing_stacks:    std::List[TypedStack]
    literal_resolutions:        std::Map[i64 common::Type]
    contextual_parameters:      std::List[common::Type]
    contextual_callables:       std::List[std::Set[std::String]]
    callable_bindings:          std::Map[std::String std::Set[std::String]]
    return_callables:           std::List[std::Set[std::String]]
    return_origin_summaries:    std::List[ReturnOriginSummary]
    conservative_loop_returns:  bool
    initialized_parameters:     std::Set[std::String]
    pending_lambdas:            std::Map[i64 std::String]
    active_calls:               std::Set[std::String]
    checks:                     mut$SemanticChecks
    infer_parameters:           bool
    ordered_facts:              std::List[SemanticDependency]
    seen_dependencies:          std::Set[std::String]
    diagnostics:                mut$error::Diagnostics
    facts_available:            bool
    checked_guards:             std::List[body_builder::Builder]
}

pub struct FunctionSemantics {
    pub ordered_facts:    std::List[SemanticDependency]
    pub inferred_effect:  common::StackEffect
    pub operations:       std::List[common::Op]
    pub diagnostics:      error::Diagnostics
    pub return_callables: std::List[std::Set[std::String]]
    pub checked_function: std::Option[common::Function]
}

impl FunctionSemantics {
    pub fn has_symbol_dependency self:$FunctionSemantics dependency:$str -> bool {
        for fact in self.ordered_facts.iter do
            if fact SemanticDependency::Symbol(symbol) is then
                if symbol.as_str dependency == then
                    true return
                fi
            fi
        done
        false
    }
}

enum FunctionWork derives std::Clone {
    Pending(source_body::SourceBody)
    Reserved(CheckedFunction)
    Completed(CompletedFunction)
    Rejected(RejectedBody)
}

enum RejectedBody derives std::Clone {
    Partial(body_builder::Builder)
    Checked(CompletedFunction)
}

impl RejectedBody {
    fn into_analysis
        self:RejectedBody
        checks:mut$SemanticChecks
        rejected:$std::Set[std::String]
    -> AnalysisBody {
        self match
            RejectedBody::Checked(completed) => {
                checks.verified_operations rejected true completed.body.settle_facts drop
                completed.into_body AnalysisBody::RejectedChecked
            }
            RejectedBody::Partial(partial) => {
                checks.verified_operations rejected true partial.settle_facts drop
                partial AnalysisBody::Rejected
            }
        end
    }

    fn lower_operations self:$RejectedBody -> std::List[common::Op] {
        self match
            RejectedBody::Partial(operations) => operations.lower_operations
            RejectedBody::Checked(completed) => completed.body.lower_operations
        end
    }
}

impl FunctionWork {
    fn into_analysis
        self:FunctionWork
        checks:mut$SemanticChecks
        rejected:$std::Set[std::String]
    -> AnalysisBody {
        self match
            FunctionWork::Completed(completed) => {
                checks.verified_operations rejected true completed.body.settle_facts drop
                completed.into_body AnalysisBody::Checked
            }
            FunctionWork::Rejected(rejection) => rejected checks rejection.into_analysis
            FunctionWork::Pending(source) => source AnalysisBody::Source
            FunctionWork::Reserved(_) => "Cannot finish semantics with active body work" panic
        end
    }

    fn get_body self:$FunctionWork -> std::Option[$semantic_body::Body] {
        self match
            FunctionWork::Completed(completed) => completed.body std::Option[$semantic_body::Body]::Some
            _ => std::Option[$semantic_body::Body]::None
        end
    }

    fn get_signature self:$FunctionWork -> std::Option[$CheckedFunction] {
        self match
            FunctionWork::Reserved(signature) => signature std::Option::Some
            FunctionWork::Completed(completed) => completed.signature std::Option[$CheckedFunction]::Some
            _ => std::Option[$CheckedFunction]::None
        end
    }
}

pub struct SemanticChecks derives std::Clone {
    functions:             std::Map[std::String FunctionWork]
    checking_functions:    std::List[std::String]
    recursive_functions:   std::Set[std::String]
    verified_operations:   std::Set[i64]
    return_summaries:      std::Map[std::String CallReturnSummary]
    callable_dependencies: std::List[CallableReturnDependency]
    resolved_callables:    std::Map[std::String std::Set[std::String]]
    bindings:              binding::BindingStore
    capture_bindings:      std::Map[std::String std::Map[std::String u64]]
}

impl SemanticChecks {
    fn resolve_callables
        self:$SemanticChecks
        callables:$std::Set[std::String]
    -> std::Set[std::String] {
        std::Set[std::String]::new = resolved
        for callable in callables.iter do
            if callable.as_str self.resolved_callables.get_str std::Option::Some(targets) is then
                for target in targets.iter do
                    target.clone resolved.add
                done
            else
                callable.clone resolved.add
            fi
        done
        resolved
    }

    fn resolve_return_callables
        self:$SemanticChecks
        returns:$std::List[std::Set[std::String]]
    -> std::List[std::Set[std::String]] {
        std::List[std::Set[std::String]]::new = resolved
        for returned in returns.iter do
            returned self.resolve_callables resolved.push
        done
        resolved
    }

    # Public target facts expose identities. Borrow-contract markers stay in the checked summaries.
    fn resolve_callable_targets
        self:$SemanticChecks
        returned:$std::List[std::Set[std::String]]
    -> std::List[std::Set[std::String]] {
        returned self.resolve_return_callables = resolved
        0 = index: u64
        while index resolved.length < do
            CALLABLE_CONTRACT index resolved.get_mut.remove_str
            1 += index
        done
        resolved
    }

    fn resolve_callable_arguments
        self:$SemanticChecks
        arguments:$std::Map[std::String std::Set[std::String]]
    -> std::Map[std::String std::Set[std::String]] {
        std::Map[std::String std::Set[std::String]]::new = resolved
        for argument in arguments.iter do
            argument.second self.resolve_callables argument.first.clone resolved.set
        done
        resolved
    }

    fn resolve_dependency_callables
        self:$SemanticChecks
        facts:std::List[SemanticDependency]
    -> std::List[SemanticDependency] {
        0 = index: u64
        while index facts.length < do
            index facts.get_mut match
                SemanticDependency::BoundCall(call) => {
                    call.argument_callables self.resolve_callable_arguments = call.argument_callables
                }
                SemanticDependency::DefaultMethodCall(call) => {
                    call.argument_callables self.resolve_callable_arguments = call.argument_callables
                }
                _ => {
                }
            end
            1 += index
        done
        facts
    }

    fn has_pending_callables self:$SemanticChecks callables:$std::Set[std::String] -> bool {
        for callable in callables.iter do
            if callable.as_str CALLABLE_RETURN_PREFIX str::starts_with then
                if callable.as_str self.resolved_callables.has_str ! then
                    true return
                fi
            fi
        done
        false
    }

    fn defer_return_callables
        self:mut$SemanticChecks
        function_name:$str
        arguments:$std::Map[std::String std::Set[std::String]]
        return_types:$std::List[common::Type]
    -> std::List[std::Set[std::String]] {
        std::List[std::Set[std::String]]::new = returns
        0 = index: u64
        while index return_types.length < do
            if index return_types.get TypeChecker::does_type_need_symbolic_origin ! then
                std::Set[std::String]::new returns.push
                1 += index
                continue
            fi
            self.resolved_callables.length self.callable_dependencies.length + = identity
            f"{CALLABLE_RETURN_PREFIX}{identity}" = reference
            reference.clone index arguments.clone function_name.to_str
            CallableReturnDependency self.callable_dependencies.push
            std::Set[std::String]::new = callables
            reference callables.add
            callables returns.push
            1 += index
        done
        returns
    }

    fn evaluate_callable_dependency
        self:$SemanticChecks
        dependency:$CallableReturnDependency
    -> std::Set[std::String] {
        dependency.function_name.as_str self
            .return_summaries
            .get_str
            .unwrap = summary
        if dependency.return_index summary.callables.length >= then
            std::Set[std::String]::new return
        fi
        dependency.return_index summary.callables.get self.resolve_callables = returned
        dependency.arguments self.resolve_callable_arguments returned resolve_returned_callables
    }

    fn callables_are_ready
        self:$SemanticChecks
        callables:$std::Set[std::String]
        ready:$std::Set[std::String]
    -> bool {
        for callable in callables.iter do
            if callable.as_str CALLABLE_RETURN_PREFIX str::starts_with ! then
                continue
            fi
            if callable.as_str self.resolved_callables.has_str callable ready.has || ! then
                false return
            fi
        done
        true
    }

    fn dependency_is_ready
        self:$SemanticChecks
        dependency:$CallableReturnDependency
        ready:$std::Set[std::String]
    -> bool {
        dependency.function_name.as_str self.return_summaries.get_str match
            std::Option::Some(summary) => {
                if dependency.return_index summary.callables.length < then
                    if ready dependency.return_index summary.callables.get self.callables_are_ready ! then
                        false return
                    fi
                fi
            }
            std::Option::None => false return
        end
        for
            argument in dependency
                .arguments
                .values
                .iter
        do
            if ready argument self.callables_are_ready ! then
                false return
            fi
        done
        true
    }

    fn find_ready_callable_dependencies self:$SemanticChecks -> std::Set[std::String] {
        # Settle closed groups independently. An unrelated active caller must not
        # withhold a completed group's facts merely because it was visited first.
        std::Set[std::String]::new = ready
        for dependency in self.callable_dependencies.iter do
            dependency.reference.clone ready.add
        done
        true = changed
        while changed do
            false = changed
            for dependency in self.callable_dependencies.iter do
                if dependency.reference ready.has ! then
                    continue
                fi
                if ready dependency self.dependency_is_ready ! then
                    dependency.reference ready.remove
                    true = changed
                fi
            done
        done
        ready
    }

    fn solve_return_callables self:mut$SemanticChecks ready:$std::Set[std::String] {
        for reference in ready.iter do
            std::Set[std::String]::new reference.clone self.resolved_callables.set
        done
        true = changed
        while changed do
            false = changed
            for dependency in self.callable_dependencies.iter do
                if dependency.reference ready.has ! then
                    continue
                fi
                dependency self.evaluate_callable_dependency = incoming
                dependency.reference.as_str self
                    .resolved_callables
                    .get_str
                    .unwrap = previous
                previous.clone = merged
                for target in incoming.iter do
                    target.clone merged.add
                done
                if previous.length merged.length != then
                    true = changed
                fi
                merged dependency.reference.clone self.resolved_callables.set
            done
        done
        for
            name in self
                .return_summaries
                .keys
                .iter
        do
            name.as_str self
                .return_summaries
                .get_str
                .unwrap = summary
            summary.callables self.resolve_return_callables = resolved
            name.as_str self
                .return_summaries
                .get_mut_str
                .unwrap = target
            resolved = target.callables
        done
    }

    fn settle_return_callables self:mut$SemanticChecks {
        if self.callable_dependencies.is_empty then
            return
        fi
        self.find_ready_callable_dependencies = ready
        if ready.is_empty then
            return
        fi
        ready self.solve_return_callables
        std::List[CallableReturnDependency]::new = pending
        self.callable_dependencies.reverse
        while self.callable_dependencies.is_empty ! do
            self.callable_dependencies.pop = remaining
            if remaining.reference ready.has ! then
                remaining pending.push
            fi
        done
        pending = self.callable_dependencies
    }

    fn function_is_rejected self:$SemanticChecks name:$str -> bool {
        if name self.functions.get_str std::Option::Some(status) is then
            status FunctionWork::Rejected is return
        fi
        false
    }

    fn reject_dependent self:mut$SemanticChecks name:$str -> bool {
        std::List[std::String]::new = callees
        if name self.functions.get_str std::Option::Some(work) is then
            if work FunctionWork::Completed(completed) is then
                callees completed.body.collect_callees
            fi
        fi
        for callee in callees.iter do
            if callee.as_str self.function_is_rejected then
                name self
                    .functions
                    .remove_str
                    .unwrap match
                    FunctionWork::Completed(completed) => {
                        completed RejectedBody::Checked FunctionWork::Rejected name.to_str self.functions.set
                        true return
                    }
                    _ => {
                    }
                end
            fi
        done
        false
    }

    # Recursion can use a reserved signature. Settle its obligations before publishing facts.
    fn settle_function_rejections self:mut$SemanticChecks names:$std::List[std::String] {
        true = changed
        while changed do
            false = changed
            for name in names.iter do
                if name.as_str self.reject_dependent then
                    true = changed
                fi
            done
        done
    }

    fn get_rejected_names self:$SemanticChecks -> std::Set[std::String] {
        std::Set[std::String]::new = names
        for
            name in self
                .functions
                .keys
                .iter
        do
            if name.as_str self.function_is_rejected then
                name.clone names.add
            fi
        done
        names
    }

    fn stage_sources self:mut$SemanticChecks bodies:std::Map[std::String source_body::SourceBody] {
        for name in bodies.keys.iter do
            name.as_str bodies.remove_str.unwrap FunctionWork::Pending name.clone self.functions.set
        done
    }

    fn stage_accessors self:mut$SemanticChecks store:mut$common::SymbolStore {
        for
            name in store
                .member_accessors
                .keys
                .iter
        do
            if name.as_str self.functions.has_str then
                continue
            fi
            name.as_str store
                .get_function
                .unwrap
                .clone = declaration
            name.as_str store
                .member_accessors
                .get_str
                .unwrap
                .clone = accessor
            store declaration accessor semantic_body::make_accessor_body = body
            body declaration checked_function_summary CompletedFunction FunctionWork::Completed name.clone self.functions.set
        done
    }

    # Reserve only the recursive signature. The returned private frame owns the body.
    fn begin_function self:mut$SemanticChecks declaration:common::Function -> ActiveFunction {
        declaration.name.clone self.checking_functions.push
        declaration.name.as_str self
            .functions
            .remove_str
            .unwrap match
            FunctionWork::Pending(body) => {
                declaration checked_function_summary FunctionWork::Reserved declaration.name.clone self.functions.set
                body declaration ActiveFunction
            }
            _ => "Only pending source work can begin checking" panic
        end
    }

    pub fn begin_specialization
        self:mut$SemanticChecks
        name:$str
    -> std::Option[ActiveSpecialization] {
        if name self.functions.get_str std::Option::Some(work) is then
            if work FunctionWork::Completed is ! then
                std::Option[ActiveSpecialization]::None return
            fi
        else
            std::Option[ActiveSpecialization]::None return
        fi
        name self
            .functions
            .remove_str
            .unwrap match
            FunctionWork::Completed(completed) => {
                completed.signature.clone FunctionWork::Reserved name.to_str self.functions.set
                completed name.to_str ActiveSpecialization std::Option::Some
            }
            _ => "Only completed recipes can begin specialization" panic
        end
    }

    fn new -> SemanticChecks {
        std::Map[std::String std::Map[std::String u64]]::new binding::BindingStore::new
        std::Map[std::String std::Set[std::String]]::new
        std::List[CallableReturnDependency]::new
        std::Map[std::String CallReturnSummary]::new std::Set[i64]::new
        std::Set[std::String]::new std::List[std::String]::new
        std::Map[std::String FunctionWork]::new SemanticChecks
    }
}

# Rejected analysis retains occurrences but cannot be committed as backend input.
pub enum AnalysisBody {
    Checked(semantic_body::Body)
    RejectedChecked(semantic_body::Body)
    Rejected(body_builder::Builder)
    Source(source_body::SourceBody)
}

impl AnalysisBody {
    fn settle_facts self:$AnalysisBody checks:mut$SemanticChecks rejected:$std::Set[std::String] {
        self match
            AnalysisBody::Checked(body) => checks.verified_operations rejected true body.settle_facts drop
            AnalysisBody::RejectedChecked(body) => checks.verified_operations rejected true body.settle_facts drop
            AnalysisBody::Rejected(operations) => checks.verified_operations rejected true operations.settle_facts drop
            _ => {
            }
        end
    }

    pub fn lower_operations self:$AnalysisBody -> std::List[common::Op] {
        self match
            AnalysisBody::Checked(body) => body.lower_operations
            AnalysisBody::RejectedChecked(body) => body.lower_operations
            AnalysisBody::Rejected(operations) => operations.lower_operations
            AnalysisBody::Source(body) => body.lower_operations
        end
    }

    pub fn into_checked self:AnalysisBody -> std::Result[semantic_body::Body std::String] {
        self match
            AnalysisBody::Checked(body) => body std::Result::Ok
            _ => "Backend input requires a completed body".to_str std::Result::Error
        end
    }
}

pub struct SemanticSession {
    store:  common::SymbolStore
    checks: SemanticChecks
}

impl SemanticSession {
    pub fn new
        store:$common::SymbolStore
        bodies:$std::Map[std::String source_body::SourceBody]
    -> SemanticSession {
        bodies.clone store.clone_for_semantics SemanticSession::from_store
    }

    pub fn from_store
        store:common::SymbolStore
        bodies:std::Map[std::String source_body::SourceBody]
    -> SemanticSession {
        bodies SemanticChecks::new store SemanticSession::from_checks
    }

    # Continue from earlier work, such as copied import-stage checks.
    pub fn from_checks
        store:common::SymbolStore
        checks:SemanticChecks
        bodies:std::Map[std::String source_body::SourceBody]
    -> SemanticSession {
        bodies checks.stage_sources
        store checks.stage_accessors
        checks store SemanticSession
    }

    pub fn from_source
        source:source_body::SourceProgram
    -> SemanticSession source_body::SourceBody {
        source.into_parts = bodies = root = store
        bodies store SemanticSession::from_store root
    }

    pub fn clone_function self:$SemanticSession name:$str -> std::Option[common::Function] {
        if name self.store.get_function std::Option::Some(function) is then
            function.clone std::Option::Some return
        fi
        std::Option[common::Function]::None
    }

    pub fn find_checked_body self:$SemanticSession name:$str -> std::Option[$semantic_body::Body] {
        if
            name self
                .checks
                .functions
                .get_str std::Option::Some(work) is
        then
            work.get_body return
        fi
        std::Option[$semantic_body::Body]::None
    }

    # The scheduler asks for a completed result. Body ownership stays in the session.
    pub fn check_declared_function
        self:mut$SemanticSession
        name:$str
        diagnostics:mut$error::Diagnostics
    {
        if name "lambda__" str::starts_with then
            return
        fi
        if
            name self
                .checks
                .functions
                .get_str std::Option::Some(work) is
        then
            if work FunctionWork::Pending is ! then
                return
            fi
        fi
        if name self.store.get_function std::Option::Some(function) is then
            if function.extern_symbol.is_some then
                return
            fi
        else
            return
        fi
        false self.checks diagnostics self.store name ensure_checked_function drop
    }

    pub fn into_parts self:SemanticSession -> common::SymbolStore SemanticChecks {
        self match
            SemanticSession { store: store checks: checks } => store checks
        end
    }
}

# Settle source facts after declaration validation and concrete specialization.
pub fn finish_semantics
    store:common::SymbolStore
    checks:SemanticChecks
    root:AnalysisBody
-> common::SymbolStore AnalysisBody std::Map[std::String AnalysisBody] std::Set[i64] binding::BindingStore {
    0 std::Set[std::String]::new root checks store finish_root_semantics
}

impl SemanticChecks {
    pub fn count_bindings self:$SemanticChecks -> u64 { self.bindings.declarations.length }
}

# Settle work outside `imported` and bindings from `imported_bindings` on.
# Import-stage functions cannot call root-stage functions, and the import stage
# settles its own facts.
pub fn finish_root_semantics
    store:common::SymbolStore
    checks:SemanticChecks
    root:AnalysisBody
    imported:$std::Set[std::String]
    imported_bindings:u64
-> common::SymbolStore AnalysisBody std::Map[std::String AnalysisBody] std::Set[i64] binding::BindingStore {
    std::List[std::String]::new = names
    for name in store.get_function_names.iter do
        if name imported.has ! then
            name.clone names.push
        fi
    done
    names checks.settle_function_rejections
    checks.get_rejected_names = rejected
    rejected checks root.settle_facts
    std::Map[std::String AnalysisBody]::new = bodies
    for
        name in checks
            .functions
            .keys
            .iter
    do
        if name imported.has then
            continue
        fi
        rejected checks name.as_str checks
            .functions
            .remove_str
            .unwrap
            .into_analysis
        name.clone bodies.set
    done
    imported_bindings = binding_index
    while
        binding_index checks
            .bindings
            .declarations
            .length <
    do
        binding_index checks
            .bindings
            .declarations
            .get_mut = binding
        binding.operation checks.verified_operations.has = binding.verified
        1 += binding_index
    done
    checks match
        SemanticChecks { bindings: bindings verified_operations: verified } => verified bindings
    end = bindings = verified
    store root bodies verified bindings
}

pub enum SemanticDependency derives std::Clone {
    Symbol(std::String)
    Call(std::String)
    BoundCall(SemanticBoundCall)
    DefaultMethodCall(SemanticDefaultMethodCall)
    Type(common::Type)
}

pub struct SemanticBoundCall derives std::Clone {
    pub function_name:      std::String
    pub argument_callables: std::Map[std::String std::Set[std::String]]
}

pub struct SemanticDefaultMethodCall derives std::Clone {
    pub trait_name:         std::String
    pub method_name:        std::String
    pub stack_effect:       common::StackEffect
    pub argument_callables: std::Map[std::String std::Set[std::String]]
}

pub fn unsafe_operation_name operation:$common::OpValue -> str {
    # Callers already classify the operation as unsafe. Keep enforcement if a name is missing.
    operation match
        common::OpValue::HeapAlloc => "alloc"
        common::OpValue::HeapFree => "free"
        common::OpValue::Load8 => "load8"
        common::OpValue::Load16 => "load16"
        common::OpValue::Load32 => "load32"
        common::OpValue::Load64 => "load64"
        common::OpValue::PtrAsRef => "ptr::as_ref"
        common::OpValue::PtrAsMut => "ptr::as_mut"
        common::OpValue::PtrFromRaw => "ptr::from_raw"
        common::OpValue::PtrFromRef => "ptr::from_ref"
        common::OpValue::PtrIntoRaw => "ptr::into_raw"
        common::OpValue::PtrNull => "ptr::null"
        common::OpValue::PtrRead => "ptr::read"
        common::OpValue::Store8 => "store8"
        common::OpValue::Store16 => "store16"
        common::OpValue::Store32 => "store32"
        common::OpValue::Store64 => "store64"
        common::OpValue::PtrWrite => "ptr::write"
        common::OpValue::Syscall0 => "syscall0"
        common::OpValue::Syscall1 => "syscall1"
        common::OpValue::Syscall2 => "syscall2"
        common::OpValue::Syscall3 => "syscall3"
        common::OpValue::Syscall4 => "syscall4"
        common::OpValue::Syscall5 => "syscall5"
        common::OpValue::Syscall6 => "syscall6"
        _ => "operation"
    end
}

impl TypeChecker {
    pub fn new
        store:mut$common::SymbolStore
        diagnostics:mut$error::Diagnostics
        active_calls:std::Set[std::String]
        checks:mut$SemanticChecks
        infer_parameters:bool
    -> TypeChecker {
        std::List[body_builder::Builder]::new # checked_guards
        true # facts_available
        diagnostics # diagnostics
        std::Set[std::String]::new # seen_dependencies
        std::List[SemanticDependency]::new # ordered_facts
        infer_parameters # infer_parameters
        checks # checks
        active_calls # active_calls
        std::Map[i64 std::String]::new # pending_lambdas
        std::Set[std::String]::new # initialized_parameters
        false # conservative_loop_returns
        std::List[ReturnOriginSummary]::new # return_origin_summaries
        std::List[std::Set[std::String]]::new # return_callables
        std::Map[std::String std::Set[std::String]]::new # callable_bindings
        std::List[std::Set[std::String]]::new # contextual_callables
        std::List[common::Type]::new # contextual_parameters
        std::Map[i64 common::Type]::new # literal_resolutions
        std::List[TypedStack]::new # format_enclosing_stacks
        0 # format_scope_depth
        0 # unsafe_depth
        std::Map[std::String std::List[common::TraitBound]]::new # current_trait_bounds
        0 # operation_stack_depth
        std::List[common::ScalarInput]::new # scalar_inputs
        block_scope::BlockScope::new # scope
        OwnershipChecker::new # ownership
        false # underflow_reported_this_op
        std::Option[u64]::None # param_cap
        store # store
        true # path_continues
        false # in_branch_condition
        ExpectationContext::None # current_expect_ctx
        "".to_str # current_op_context
        common::empty_location # current_location
        std::List[BranchFrame]::new # branched_stacks
        false # has_return_types
        TypedStack::new # return_types
        std::List[common::Parameter]::new # parameters
        TypedStack::new # stack
        TypeChecker
    }

    pub fn assign_op_id self:mut$TypeChecker op:mut$common::Op {
        std::Option[common::OpOwnership]::None = op.ownership
        std::Option[std::List[common::BindingFact]]::None = op.bindings
        self.store.next_op_id = op.id
        1 += self.store.next_op_id
    }

    # End one control-flow path and restore the enclosing branch entry so the
    # next branch can be checked independently.
    pub fn end_path self:mut$TypeChecker {
        false = self.path_continues
        if 0 self.branched_stacks.length == then
            return
        fi
        self.branched_stacks.pop = top_frame
        top_frame match
            BranchFrame::BranchIf(if_ctx) => {
                if self.in_branch_condition ! then
                    if_ctx.before self.stack.restore
                    if_ctx.flow_before self.restore_ownership_flow
                fi
                if_ctx BranchFrame::BranchIf self.branched_stacks.push
            }
            BranchFrame::BranchWhile(while_ctx) => {
                while_ctx.before self.stack.restore
                while_ctx.flow_before self.restore_ownership_flow
                while_ctx BranchFrame::BranchWhile self.branched_stacks.push
            }
            BranchFrame::BranchMatch(match_ctx) => {
                match_ctx.before self.stack.restore
                match_ctx.flow_before self.restore_ownership_flow
                match_ctx BranchFrame::BranchMatch self.branched_stacks.push
            }
        end
    }
}

pub fn resolve_numeric_literal_default type_value:$common::Type -> common::Type {
    if type_value.is_integer_literal_t then
        common::make_i64_type.clone return
    fi
    if type_value.is_float_literal_t then
        common::make_f64_type.clone return
    fi
    type_value match
        common::Type::Generic(generic) => {
            std::List[common::Type]::new = parameters
            for parameter in generic.params.iter do
                parameter resolve_numeric_literal_default parameters.push
            done
            parameters generic.base.clone common::GenericType::with_params common::Type::Generic
        }
        common::Type::Function(function_type) => {
            std::List[common::Type]::new = parameters
            for parameter in function_type.parameters.iter do
                parameter resolve_numeric_literal_default parameters.push
            done
            std::List[common::Type]::new = return_types
            for return_type in function_type.return_types.iter do
                return_type resolve_numeric_literal_default return_types.push
            done
            return_types parameters common::FunctionType common::Type::Function
        }
        _ => type_value.clone
    end
}

pub fn pattern_binding_type
    subject_type:$common::Type
    binding_type:common::Type
    binding_is_copy:bool
-> common::Type {
    binding_is_copy binding_type subject_type rules::pattern_binding_type
}

impl TypeChecker {
    pub fn within_param_cap tc:mut$TypeChecker -> bool {
        if tc.param_cap std::Option::Some(cap) is then
            cap tc.parameters.length > return
        fi
        true
    }

    fn get_contextual_parameter self:$TypeChecker -> std::Option[common::Type] {
        if self.parameters.length self.contextual_parameters.length < then
            self.parameters.length self
                .contextual_parameters
                .get
                .clone std::Option::Some return
        fi
        std::Option[common::Type]::None
    }

    fn stack_peek_callables self:mut$TypeChecker -> std::Set[std::String] {
        if
            self
                .stack
                .values
                .is_empty !
        then
            self.stack.peek_callables return
        fi
        if self.within_param_cap self.parameters.length self.contextual_callables.length < && then
            self.parameters.length self
                .contextual_callables
                .get
                .clone return
        fi
        std::Set[std::String]::new
    }
}

# Raise a TypeMismatch error at the type checker's current location.
impl TypeChecker {
    pub fn raise_type_mismatch tc:mut$TypeChecker message:std::String {
        tc.current_location message common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
    }
}

# Stack operations
impl TypeChecker {
    # A branch-local binding cannot identify the value after control-flow joins.
    # Transfer it to the branch result before the binding's scope is cleaned up.
    pub fn materialize_branch_results self:mut$TypeChecker before:$TypedStack {
        0 = index: u64
        while
            index self
                .stack
                .values
                .length <
        do
            index self
                .stack
                .values
                .get
                .clone = value
            false = entered_branch
            if index before.values.length < then
                index before.values.get = before_value
                before_value value.same_owner_source = entered_branch
            fi
            if value.binding.is_some entered_branch ! && then
                value self.consume_value
                index self
                    .stack
                    .values
                    .get_mut
                    .clear_owner_source
            fi
            1 += index
        done
    }

    fn complete_branch self:mut$TypeChecker before:$TypedStack op:mut$common::Op {
        if self.path_continues then
            before self.materialize_branch_results
        fi
        op self.attach_scope_cleanups
        0 op
            .location
            .span
            .offset self.close_source_bindings
        self.scope.exit
    }

    pub fn current_ownership_flow self:$TypeChecker -> OwnershipFlow {
        self.callable_bindings self.scope self.ownership.current_ownership_flow
    }

    pub fn restore_ownership_flow self:mut$TypeChecker flow:$OwnershipFlow {
        flow self.ownership.restore_ownership_flow
        flow.callables.clone = self.callable_bindings
    }

    pub fn remove_flow_names self:mut$TypeChecker names:$std::List[std::String] {
        names self.ownership.remove_flow_names
        for name in names.iter do
            if name.as_str self.callable_bindings.has_str then
                name.as_str self.callable_bindings.delete_str
            fi
        done
    }

    pub fn merge_current_ownership_flow tc:mut$TypeChecker flow:mut$OwnershipFlow {
        if tc.path_continues then
            tc.current_ownership_flow = current
            current flow.merge
        fi
    }

    pub fn report_loop_flow_difference
        tc:mut$TypeChecker
        expected:$OwnershipFlow
        local_names:$std::List[std::String]
        op:mut$common::Op
    {
        tc.current_ownership_flow = current
        for name in current.moved.iter do
            if
                name.as_str local_names common::string_list_contains !
                name.as_str expected.moved common::string_list_contains ! &&
            then
                op.location f"Loop back-edge does not restore ownership of `{name}`"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
        for name in expected.moved.iter do
            if
                name.as_str local_names common::string_list_contains !
                name.as_str current.moved common::string_list_contains ! &&
            then
                op.location f"Loop back-edge changes ownership of `{name}`"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
        for pair in current.bindings.iter do
            if pair.first.as_str local_names common::string_list_contains then
                continue
            fi
            std::Option[std::List[Origin]]::None = expected_origins
            std::Option[std::List[Origin]]::None = expected_cleanup
            if pair.first expected.bindings.get std::Option::Some(binding) is then
                binding.origins.clone = expected_origins
                binding.cleanup_origins.clone = expected_cleanup
            fi
            false = check_origins
            if pair.first.as_str tc.scope.lookup std::Option::Some(typ) is then
                tc.store typ type_has_borrow typ common::Type::Function is || = check_origins
            fi
            if check_origins expected_origins pair.second.origins origins_equal ! && then
                op.location f"Loop back-edge changes loans for `{pair.first}`"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
            if
                expected_origins pair.second.origins origins_equal ! expected_cleanup pair.second.cleanup_origins origins_equal ! ||
            then
                # Symbolic callbacks can add dependencies on later iterations. Until
                # loop summaries solve those equations, calls use the full contract.
                true = tc.conservative_loop_returns
            fi
            if
                expected_cleanup clone_runtime_origins pair.second.cleanup_origins clone_runtime_origins origins_equal !
            then
                op.location f"Loop back-edge changes cleanup-observed loans for `{pair.first}`"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
        for pair in expected.bindings.iter do
            if pair.first.as_str local_names common::string_list_contains then
                continue
            fi
            if pair.first current.bindings.has then
                continue
            fi
            false = check_origins
            if pair.first.as_str tc.scope.lookup std::Option::Some(typ) is then
                tc.store typ type_has_borrow typ common::Type::Function is || = check_origins
            fi
            if
                pair
                    .second
                    .origins
                    .is_some check_origins &&
            then
                op.location f"Loop back-edge does not restore loans for `{pair.first}`"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
            if
                pair
                    .second
                    .cleanup_origins clone_runtime_origins
                    .is_some
            then
                op.location f"Loop back-edge does not restore cleanup-observed loans for `{pair.first}`"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
        done
        for pair in current.callables.iter do
            if pair.first.as_str local_names common::string_list_contains then
                continue
            fi
            for callable in pair.second.iter do
                false = established
                if pair.first expected.callables.get std::Option::Some(targets) is then
                    callable targets.has = established
                fi
                if established ! then
                    op.location f"Loop back-edge changes callable targets for `{pair.first}`"
                    common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
                fi
            done
        done
    }

    pub fn record_conditional_move tc:mut$TypeChecker op:mut$common::Op name:$str {
        name op tc.record_named_binding
        name tc.current_location tc.ownership.record_owner_move
        name.to_str std::Option::Some = op.ensure_ownership.conditional_move
        tc
            .branched_stacks
            .pop
            .into_if = if_ctx
        name.to_str if_ctx.conditional_moves.push
        if_ctx BranchFrame::BranchIf tc.branched_stacks.push
    }

    fn record_enum_pattern_origins
        self:mut$TypeChecker
        variant:$common::EnumVariant
        subject:$TypedValue
        function_opt:mut$std::Option[common::Function]
    {
        variant.clone common::PatternValue::EnumVariant = pattern_value
        for name in pattern_value pattern::binding_names.iter do
            name.as_str self.scope.lookup match
                std::Option::Some(typ) => typ.clone
                std::Option::None => continue
            end = typ
            if
                self.store typ get_borrow_shape 0 == typ.has_unresolved_type_var ! && function_opt typ self.type_is_duplicable &&
            then
                continue
            fi
            subject.origins.clone = origins
            function_opt subject.type_value name.as_str pattern_value self.pattern_copies_payload = copied
            if copied then
                subject.place subject.origins std::Option[std::List[Origin]]::None merge_contained_origins = origins
            elif subject.capability ValueCapability::Owned is ! then
                subject.capability ValueCapability::Exclusive is subject.place origins self.ownership.add_storage_origins = origins
            fi
            subject.cleanup_origins.clone = cleanup_origins
            std::List[std::String]::new = visiting
            if visiting self.store typ does_cleanup_observe_borrow then
                origins cleanup_origins merge_origins = cleanup_origins
            fi
            typ type_capability cleanup_origins origins name.as_str self.current_location self.ownership.record_binding_origins
        done
    }

    fn find_conflicting_loan_except
