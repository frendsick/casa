pub fn borrow_argument_matches
    expected:$common::Type
    actual:$common::Type
    store:$common::SymbolStore
-> bool {
    if expected.borrow_target std::Option::Some(expected_target) is then
        if expected.is_exclusive_borrow actual.is_shared_borrow && then
            false return
        fi
        actual.clone = actual_target
        if actual.borrow_target std::Option::Some(borrowed_target) is then
            borrowed_target.clone = actual_target
        fi
        store actual_target expected_target rules::unify_type_t.is_some return
    fi
    false
}

pub fn borrowed_copy_argument_matches
    tc:mut$TypeChecker
    expected:$common::Type
    actual:$common::Type
-> bool {
    if actual.borrow_target std::Option::Some(target) is then
        if tc.store target expected rules::unify_type_t.is_none then
            false return
        fi
        std::Option[common::Function]::None target tc.type_is_duplicable return
    fi
    false
}

pub fn stack_effect_may_borrow effect:$common::StackEffect -> bool {
    for parameter in effect.parameters.iter do
        if parameter.typ.is_borrow parameter.typ common::Type::TypeVar is || then
            true return
        fi
    done
    false
}

impl TypeChecker {
    fn clone_hint self:mut$TypeChecker value:$TypedValue -> str {
        value value_owned_type = owned_type
        if owned_type self.type_implements_clone then
            "; clone it first" return
        fi
        ""
    }

    fn report_borrowed_to_owned self:mut$TypeChecker expected:$common::Type value:$TypedValue {
        self.format_expectation_context = context
        if value.place std::Option::Some(place) is then
            if "" context.as_str != then
                f"Cannot pass borrowed `{place.format}` to consuming {context}"
            else
                f"Cannot move borrowed value `{place.format}`"
            fi
        else
            if "" context.as_str != then
                f"Cannot pass a borrowed value to consuming {context}"
            else
                "Cannot move a borrowed value".to_str
            fi
        fi = message
        value self.clone_hint = hint
        f"{message}{hint}" = message

        self
            .current_location
            .file
            .as_str expected self.store.format_type_for_source = expected_name
        value value_access_type = access_type
        self
            .current_location
            .file
            .as_str access_type self.store.format_type_for_source = access_name
        value.capability capability_name = access
        f"owned value: {expected_name}" = expected_contract
        f"{access} access: {access_name}" = available_contract
        available_contract expected_contract self.current_location.clone message
        common::ErrorKind::InvalidVariable error::CasaError::with_expected = diagnostic
        "Available".to_str = diagnostic.got_label
        diagnostic self.diagnostics.push_error
    }

    # Finish an argument use according to the required ownership. A false
    # result means this function reported the ownership conflict.
    fn finish_expected_value_use
        self:mut$TypeChecker
        expected:$common::Type
        value:$TypedValue
    -> bool {
        if
            self
                .stack
                .values
                .length self.operation_stack_depth <
        then
            self.operation_stack_depth self
                .stack
                .values
                .length - 1 - = depth
            depth expected value self.record_scalar_input
        fi
        if expected.is_borrow then
            value self.release_value
            true return
        fi
        if value.type_value expected self borrowed_copy_argument_matches then
            value self.release_value
            true return
        fi
        if value.capability ValueCapability::Owned is ! then
            value value_owned_type = owned_actual
            self.store owned_actual expected rules::unify_type_t.is_some = ownership_matches
            if ownership_matches then
                value expected self.report_borrowed_to_owned
                value self.release_value
                false return
            fi
            # Let the normal type mismatch describe incompatible borrowed data.
            value self.release_value
            true return
        fi
        value self.materialize_copy_escape
        value self.consume_value
        true
    }

    pub fn consume_value tc:mut$TypeChecker value:$TypedValue {
        if value.capability ValueCapability::Owned is ! then
            value tc.clone_hint = hint
            tc
                .current_location
                .file
                .as_str value.type_value tc.store.format_type_for_source = type_name
            if value.place std::Option::Some(place) is then
                tc.current_location f"Cannot move borrowed value `{place.format}` of type `{type_name}`{hint}"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            else
                tc.current_location f"Cannot move a borrowed value of type `{type_name}`{hint}"
                common::ErrorKind::InvalidVariable tc.diagnostics.record_error_string
            fi
            return
        fi
        if value.binding std::Option::Some(name) is then
            if name.as_str tc.ownership.owner_is_moved then
                name.as_str tc.current_location.clone tc.diagnostics tc.ownership.report_moved_owner
                return
            fi
            if
                true tc
                    .stack
                    .values
                    .length name.as_str Place::new tc.find_conflicting_loan std::Option::Some(conflict) is
            then
                conflict f"Cannot move owner `{name}` while it is borrowed" tc.current_location tc.diagnostics tc.ownership.report_loan_conflict
                name.as_str tc.ownership.record_move_conflict
                return
            fi
            name.as_str tc.current_location tc.ownership.record_owner_move
            if value.source std::Option::Some(source_op) is then
                source_op tc.ownership.record_operation_move
            fi
        fi
    }

    pub fn release_value tc:mut$TypeChecker value:$TypedValue {
        if value.binding std::Option::Some(name) is then
            if name.as_str tc.ownership.owner_is_moved then
                name.as_str tc.current_location.clone tc.diagnostics tc.ownership.report_moved_owner
            fi
        fi
    }

    # Finish a stack use. Owned values move; borrowed values are released.
    pub fn finish_value_use self:mut$TypeChecker value:$TypedValue {
        if value.capability ValueCapability::Owned is then
            value self.consume_value
        else
            value self.release_value
        fi
    }

    pub fn materialize_copy_escape self:mut$TypeChecker value:$TypedValue {
        if value.type_value self.uses_copy_storage then
            if value.source std::Option::Some(source_op) is then
                source_op self.ownership.record_operation_move
            fi
        fi
    }
}

impl TypeChecker {
    pub fn report_stack_underflow tc:mut$TypeChecker message:std::String {
        if tc.underflow_reported_this_op then
