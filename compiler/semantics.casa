# Phase-independent meaning for resolved operations.
#
# Maintains a virtual stack of types and validates that operations
# are type-safe.
import "std" as std
import "shared" as shared
import "common" as common
import "binding" as binding
import "error" as error
import "block_scope" as block_scope
import "semantic_rules" as rules
