        common::make_unknown_type.clone = elem_type_t
        std::Option[std::List[Origin]]::None = origins
        std::Option[std::List[Origin]]::None = cleanup_origins
        0 = items_idx: u64
        while items_idx item_count < do
            self.stack_pop_value = item_value
            item_value.type_value.clone = item_type_t
            # The literal takes ownership of every element, so a moved
            # owner must not stay usable through its old binding.
            item_value.origins origins merge_origins = origins
            item_value.cleanup_origins cleanup_origins merge_origins = cleanup_origins
            if item_type_t.is_borrow item_value.origins.is_none && then
                if item_value.place std::Option::Some(place) is then
                    item_type_t.is_exclusive_borrow place origins add_origin = origins
                fi
            fi
            item_value self.consume_value
            self.store item_type_t elem_type_t rules::unify_type_t = unified_opt
            unified_opt match
                std::Option::Some(unified) => unified = elem_type_t
                std::Option::None => {
                    op common::Op::location f"Heterogeneous array literal: cannot unify `{elem_type_t.format}` and `{item_type_t.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                }
            end
            1 += items_idx
        done
        item_count elem_type_t common::make_array_type = array_type
        array_type.clone std::Option::Some op common::Op::set_type_hint
        if has_numeric_literal then
            op array_type self.stack_push_literal
            self
                .stack
                .values
                .length 1 - self
                .stack
                .values
                .get_mut = pushed_value
            origins = pushed_value.origins
            cleanup_origins = pushed_value.cleanup_origins
        else
            cleanup_origins origins array_type self.push_value_origins
        fi
    }

    fn check_literals tc:mut$TypeChecker op:mut$common::Op {
        if op.value common::OpValue::PushInt is then
            op.type_hint.clone = integer_type_opt
            integer_type_opt match
                std::Option::Some(integer_type) => {
                    tc.diagnostics integer_type op.resolve_literal drop
