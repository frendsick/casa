                .values
                .is_empty ! self.within_param_cap ! ||
        then
            return
        fi
        if function_opt std::Option::Some(function) is then
            if function.name.as_str "lambda__" str::starts_with ! then
                return
            fi
            name.to_str typ.clone common::Parameter::named = parameter
            if
                self.parameters.length function
                    .stack_effect
                    .parameters
                    .length <
            then
                parameter self.parameters.length function
                    .stack_effect
                    .parameters
                    .set
            else
                parameter function
                    .stack_effect
                    .parameters
                    .push
            fi
        fi
    }

    fn take_parameter_initialization
        tc:mut$TypeChecker
        name:$str
        function_opt:mut$std::Option[common::Function]
    -> bool {
        if name tc.initialized_parameters.has_str then
            false return
        fi
        if function_opt name is_function_parameter ! then
            false return
        fi
        name.to_str tc.initialized_parameters.add
        true
    }

    # Unify the stored type of `variable` with the type being assigned to it.
    # `scope` is used only in the error message.
    pub fn unify_variable_assignment
        self:mut$TypeChecker
        op:mut$common::Op
        variable:mut$common::Variable
        effective_type:$common::Type
        scope:str
    {
        variable common::Variable::typ = pre_type: $common::Type
        pre_type.is_unknown pre_type.is_unknown_placeholder || = pre_unknown
        if pre_unknown effective_type.is_unknown_placeholder ! && then
            effective_type.clone variable common::Variable::set_typ
        fi
        self.store effective_type variable common::Variable::typ rules::unify_type_t = unified
        unified match
            std::Option::Some(unified_type) => unified_type variable common::Variable::set_typ
            std::Option::None => {
                op common::Op::location f"Cannot override {scope} variable `{variable common::Variable::name}` of type `{variable common::Variable::typ.format}` with other type `{effective_type.format}`" common::ErrorKind::InvalidVariable self.diagnostics.record_error_string
            }
        end
    }
}

impl TypeChecker {
    pub fn unify_assignment_type
        self:mut$TypeChecker
        op:mut$common::Op
        var_name:$str
        current_type:common::Type
        effective_type:$common::Type
        scope:str
    -> common::Type {
        current_type = stored_type
        stored_type.is_unknown stored_type.is_unknown_placeholder || = pre_unknown
        if pre_unknown effective_type.is_unknown_placeholder ! && then
            effective_type.clone = stored_type
        fi
        self.store effective_type stored_type rules::unify_type_t = unified
        unified match
            std::Option::Some(unified_type) => unified_type
            std::Option::None => {
                op common::Op::location f"Cannot override {scope} variable `{var_name}` of type `{stored_type.format}` with other type `{effective_type.format}`" common::ErrorKind::InvalidVariable self.diagnostics.record_error_string
                stored_type
            }
        end
    }
}

impl TypeChecker {
    pub fn local_var_type
        tc:mut$TypeChecker
        var_name:$str
        function_opt:mut$std::Option[common::Function]
    -> std::Option[common::Type] {
        if var_name.as_str tc.scope.lookup std::Option::Some(binding_type) is then
            binding_type.clone std::Option::Some return
        fi
        if function_opt std::Option::Some(function) is then
            var_name.as_str function common::Function::variables common::variable_list_index = local_index
            if 0 local_index <= then
                local_index u64::try_from.unwrap function common::Function::variables.get common::Variable::typ.clone std::Option::Some return
            fi
            var_name.as_str function common::Function::captures common::variable_list_index = capture_index
            if 0 capture_index <= then
                capture_index u64::try_from.unwrap function common::Function::captures.get common::Variable::typ.clone std::Option::Some return
            fi
        fi
        if
            var_name.as_str tc
                .store
                .variables
                .get_str std::Option::Some(global_var) is
        then
            global_var.typ.clone std::Option::Some return
        fi
        std::Option[common::Type]::None
    }

    pub fn is_global_assignment
        self:mut$TypeChecker
        var_name:$str
        function_opt:mut$std::Option[common::Function]
    -> bool {
        if
            var_name self
                .store
                .variables
                .has_str !
        then
            false return
        fi
        if function_opt std::Option::Some(function) is then
            var_name.as_str function common::Function::variables common::variable_list_contains ! return
        fi
        # Root bindings obey the same block lifetime as function locals.
        false
    }

    pub fn record_implicit_binding self:mut$TypeChecker var_name:$str op:mut$common::Op {
        if var_name self.scope.bind ! then
            f"Binding `{var_name}` shadows an existing variable; choose a different name" = message
            op common::Op::location message common::ErrorKind::DuplicateName self.diagnostics.record_error_string
        fi
    }

    pub fn lower_field_assignment
        tc:mut$TypeChecker
        op:mut$common::Op
        pending_ops:mut$std::List[common::Op]
        function_opt:mut$std::Option[common::Function]
        parts:std::List[std::String]
    {
        op.value.clone = assignment_value
        assignment_value common::OpValue::AssignInc is = increment
        assignment_value common::OpValue::AssignDec is = decrement
        0 parts.get = root
        op common::Op::location.clone = location

        root.clone common::OpValue::PushVar = root_value
        if function_opt std::Option::Some(function) is then
            if root.as_str function common::Function::captures common::variable_list_contains then
                root.clone common::OpValue::PushCapture = root_value
            fi
        fi
        root_value op common::Op::set_value
        function_opt op tc.check_push_var
        std::List[common::Op]::new = lowered_ops

        1 = field_index: u64
        if increment decrement || then
            while field_index parts.length < do
                location.clone field_index parts.get.clone common::OpValue::MethodCall common::Op::new = getter
                getter lowered_ops.push
                1 += field_index
            done
            if decrement then
                location.clone common::OpValue::Swap common::Op::new = swap_op
                swap_op lowered_ops.push
                location.clone common::OpValue::Sub common::Op::new = sub_op
                sub_op lowered_ops.push
            else
                location.clone common::OpValue::Add common::Op::new = add_op
                add_op lowered_ops.push
            fi

            root.clone common::OpValue::PushVar = second_root_value
            if function_opt std::Option::Some(function) is then
                if root.as_str function common::Function::captures common::variable_list_contains then
                    root.clone common::OpValue::PushCapture = second_root_value
                fi
            fi
            location.clone second_root_value common::Op::new = root_op
            root_op lowered_ops.push
            1 = field_index: u64
        fi

        while field_index parts.length 1 - < do
            location.clone field_index parts.get.clone common::OpValue::MethodCall common::Op::new = getter
            getter lowered_ops.push
            1 += field_index
        done
        parts.length 1 - parts.get = field
        location f"set_{field}".to_str common::OpValue::MethodCall common::Op::new = setter
        setter lowered_ops.push
        lowered_ops.reverse
        lowered_ops pending_ops.append
    }

    fn validate_owner_replacement
        tc:mut$TypeChecker
        op:mut$common::Op
        name:$str
        typ:$common::Type
        function_opt:mut$std::Option[common::Function]
    {
        if
            name tc.ownership.owner_is_moved
            typ.is_borrow ||
            function_opt typ tc.type_is_duplicable ||
            tc.store typ common::type_needs_destruction_in_store ! ||
        then
            return
        fi
        if
            true tc
                .stack
                .values
                .length name Place::new tc.find_conflicting_loan
            std::Option::Some(conflict) is
        then
            conflict f"Cannot replace owner `{name}` while it is borrowed"
            tc.current_location tc.diagnostics tc.ownership.report_loan_conflict
        fi
    }

    pub fn check_assignment
        tc:mut$TypeChecker
        op:mut$common::Op
        pending_ops:mut$std::List[common::Op]
        function_opt:mut$std::Option[common::Function]
    {
        if op.value common::OpValue::AssignYield(name) is then
            # Keep the yielded capability when reading a named Copy borrow
            # would otherwise materialize its target during assignment.
            tc
                .stack
                .values
                .length 1 - tc
                .stack
                .values
                .get = value
            name.clone common::OpValue::AssignVar = op.value
            value value_access_type std::Option::Some = op.type_hint
        fi
        op.value.clone = assignment_value
        op common::op_str_value = target
        target.as_str "." str::split.unwrap = target_parts
        if 0 target_parts.get.as_str tc.is_format_outer_binding then
            op.location f"F-string expression cannot assign `{target}` declared outside it"
            common::ErrorKind::InvalidScope tc.diagnostics.record_error_string
            tc.stack_pop_drop
            return
        fi
        if target_parts.length 1 > then
            target_parts function_opt pending_ops op tc.lower_field_assignment
            return
        fi
        if
            assignment_value common::OpValue::AssignDec is
            assignment_value common::OpValue::AssignInc is ||
        then
            op common::op_str_value = compound_name
            common::make_unknown_type.clone = compound_type
            if function_opt compound_name.as_str tc.local_var_type std::Option::Some(local_type) is then
                local_type.clone = compound_type
            elif
                compound_name.as_str tc
                    .store
                    .variables
                    .get_str std::Option::Some(global_var) is
            then
                global_var.typ.clone = compound_type
            fi
            if compound_type.is_integer_type_t ! then
                op.location f"Compound assignment requires an integer variable, got `{compound_type.format}`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                tc.stack_pop_drop
                return
            fi
            compound_type tc.expect_type_t
            compound_type std::Option::Some op common::Op::set_type_hint
            return
        fi
        if assignment_value common::OpValue::AssignVar(var_name) is then
            tc.stack_peek_callables = assigned_callables
            if var_name.as_str tc.callable_bindings.get_str std::Option::Some(previous) is then
                if CALLABLE_CONTRACT previous.has_str then
                    CALLABLE_CONTRACT assigned_callables.add_str
                fi
            fi
            if op.type_hint std::Option::Some(annotation) is then
                if annotation is_callable_contract then
                    CALLABLE_CONTRACT assigned_callables.add_str
                fi
            fi
            assigned_callables var_name.clone tc.callable_bindings.set
            op common::Op::type_hint.is_some = has_annotation
            common::make_unknown_type.clone = stack_type_t
            common::make_unknown_type.clone = effective_type_t
            if has_annotation then
                op common::Op::type_hint.clone = hint_opt
                if hint_opt.is_none then
                    common::empty_location "Expected option value while unwrapping op Op::type_hint" common::ErrorKind::Syntax tc.diagnostics.record_error
                    return
                fi
                hint_opt.unwrap = effective_type_t
                op common::Op::location function_opt effective_type_t tc.validate_type_exists
                effective_type_t.clone = stack_type_t
            else
                tc.stack_peek_type = stack_type_t
                stack_type_t.clone = effective_type_t
            fi
            effective_type_t type_capability = assigned_capability
            if
                effective_type_t.is_borrow ! tc
                    .stack
                    .values
                    .is_empty ! &&
            then
                tc
                    .stack
                    .values
                    .length 1 - tc
                    .stack
                    .values
                    .get
                    .capability = assigned_capability
            fi
            if has_annotation ! stack_type_t.has_unresolved && then
                op.location f"Cannot infer element type of empty array literal assigned to `{var_name}`; add a type annotation (e.g. `= {var_name}:array[i64 0]`)." common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi

            function_opt effective_type_t var_name.as_str tc.name_lambda_parameter
            function_opt var_name.as_str tc.take_parameter_initialization
            = is_parameter_initialization
            if
                is_parameter_initialization ! tc
                    .stack
                    .values
                    .is_empty ! &&
            then
                tc
                    .stack
                    .values
                    .length 1 - tc
                    .stack
                    .values
                    .get = value
                0 effective_type_t value tc.record_scalar_input
            fi

            function_opt var_name.as_str tc.is_global_assignment = is_global
            var_name.as_str tc
                .scope
                .lookup
                .is_some = was_initialized
            if function_opt std::Option::Some(function) is then
                if var_name.as_str function.captures common::variable_list_contains then
                    true = was_initialized
                elif is_global then
                    true = was_initialized
                fi
            fi
            if was_initialized var_name.as_str tc.ownership.owner_is_moved ! && then
                if function_opt var_name.as_str tc.local_var_type std::Option::Some(previous_type) is then
                    function_opt previous_type var_name.as_str op tc.validate_owner_replacement
                fi
            fi
            is_global var_name.as_str tc.scope.assign

            if var_name.as_str tc.scope.is_block_binding then
                var_name.as_str tc
                    .scope
                    .lookup
                    .unwrap = scoped_type
                "local" effective_type_t scoped_type var_name.as_str op tc.unify_assignment_type = unified_scoped
                unified_scoped.clone std::Option::Some = op.type_hint
                unified_scoped.clone var_name.as_str tc.scope.set_type drop
                if
                    function_opt.is_none
                    var_name.as_str tc
                        .store
                        .variables
                        .get_mut_str std::Option::Some(variable) is &&
                then
                    unified_scoped.clone = variable.typ
                fi
                is_parameter_initialization function_opt effective_type_t var_name.as_str
                tc.assignment_origins = origins
                is_parameter_initialization function_opt effective_type_t var_name.as_str
                tc.get_assignment_cleanup_origins
                = cleanup_origins
                effective_type_t tc.expect_type_t
                assigned_capability cleanup_origins origins var_name.as_str tc.current_location tc.ownership.record_binding_origins
                if is_global ! then
                    false var_name.as_str tc.ownership.set_owner_moved
                    is_global function_opt unified_scoped var_name.as_str op tc.record_owner_assignment
                fi
                return
            fi

            # Try local variables first
            -1 = local_index: i64
            if function_opt std::Option::Some(function) is then
                var_name.as_str function common::Function::variables common::variable_list_index = local_index
            fi
            if 0 local_index <= then
                common::make_unknown_type.clone = current_local_type
                if function_opt std::Option::Some(function) is then
                    local_index u64::try_from.unwrap function common::Function::variables.get common::Variable::typ.clone = current_local_type
                fi
                if var_name.as_str tc.scope.lookup std::Option::Some(binding_type) is then
                    if binding_type.is_unknown ! binding_type.is_unknown_placeholder ! && then
                        binding_type.clone = current_local_type
                    fi
                fi
                "local" effective_type_t current_local_type var_name.as_str op tc.unify_assignment_type = unified_local
                unified_local.clone std::Option::Some = op.type_hint
                unified_local.clone var_name.as_str tc.scope.set_type drop
                is_parameter_initialization function_opt effective_type_t var_name.as_str
                tc.assignment_origins = origins
                is_parameter_initialization function_opt effective_type_t var_name.as_str
                tc.get_assignment_cleanup_origins
                = cleanup_origins
                effective_type_t tc.expect_type_t
                assigned_capability cleanup_origins origins var_name.as_str tc.current_location tc.ownership.record_binding_origins
                if is_global ! then
                    false var_name.as_str tc.ownership.set_owner_moved
                    is_global function_opt unified_local var_name.as_str op tc.record_owner_assignment
                fi
                if function_opt std::Option::Some(function) is then
                    local_index u64::try_from.unwrap function common::Function::variables.get_mut = local_var
                    unified_local local_var common::Variable::set_typ
                fi
                return
            fi

            # Assignments to a capture update the closure record. Owned moving
            # captures stay owned by the closure across invocations.
            -1 = capture_index: i64
            if function_opt std::Option::Some(function) is then
                var_name.as_str function common::Function::captures common::variable_list_index = capture_index
            fi
            if 0 capture_index <= then
                function_opt var_name.as_str tc.local_var_type.unwrap = captured_type
                "capture" effective_type_t captured_type var_name.as_str op tc.unify_assignment_type
                = unified_capture
                unified_capture.clone std::Option::Some = op.type_hint
                is_parameter_initialization function_opt effective_type_t var_name.as_str
                tc.assignment_origins = origins
                is_parameter_initialization function_opt effective_type_t var_name.as_str
                tc.get_assignment_cleanup_origins
                = cleanup_origins
                effective_type_t tc.expect_type_t
                assigned_capability cleanup_origins origins var_name.as_str tc.current_location tc.ownership.record_binding_origins
                false var_name.as_str tc.ownership.set_owner_moved
                unified_capture drop
                return
            fi

            # Try module-level variables.
            var_name.as_str tc
                .store
                .variables
                .remove_str = global_opt
            if global_opt.is_some then
                global_opt.unwrap = global_var
                "global" effective_type_t global_var op tc.unify_variable_assignment
                is_parameter_initialization function_opt effective_type_t var_name.as_str
                tc.assignment_origins = origins
                is_parameter_initialization function_opt effective_type_t var_name.as_str
                tc.get_assignment_cleanup_origins
                = cleanup_origins
                effective_type_t tc.expect_type_t
                assigned_capability cleanup_origins origins var_name.as_str tc.current_location tc.ownership.record_binding_origins
                if is_global ! var_name.as_str common::is_internal_variable_name || then
                    false var_name.as_str tc.ownership.set_owner_moved
                fi
                global_var.typ.clone = global_type
                global_type var_name.as_str tc.scope.set_type drop
                global_type.clone std::Option::Some = op.type_hint
                is_global function_opt global_type var_name.as_str op tc.record_owner_assignment
                global_var var_name.clone tc
                    .store
                    .variables
                    .set
                return
            fi
            is_parameter_initialization function_opt effective_type_t var_name.as_str
            tc.assignment_origins = origins
            is_parameter_initialization function_opt effective_type_t var_name.as_str
            tc.get_assignment_cleanup_origins
            = cleanup_origins
            effective_type_t tc.expect_type_t
            assigned_capability cleanup_origins origins var_name.as_str tc.current_location tc.ownership.record_binding_origins
            if is_global ! then
                false var_name.as_str tc.ownership.set_owner_moved
            fi
            effective_type_t.clone std::Option::Some = op.type_hint
            is_global function_opt effective_type_t var_name.as_str op tc.record_owner_assignment
        fi
    }
}

impl TypeChecker {
    pub fn check_method_receiver_capability
        tc:mut$TypeChecker
        effect:$common::StackEffect
        capability:$ValueCapability
        method_name:$str
        receiver_type:$common::Type
    -> bool {
        effect method_receiver_type = expected_receiver_opt
        if expected_receiver_opt std::Option::Some(expected_receiver) is then
            if expected_receiver capability capability_matches_receiver ! then
                receiver_type.clone = receiver_target
                if receiver_type.borrow_target std::Option::Some(target) is then
                    target.clone = receiver_target
                fi
                tc
                    .current_location
                    .file
                    .as_str receiver_target tc.store.format_type_for_source
                = receiver_type_name
                tc
                    .current_location
                    .file
                    .as_str expected_receiver tc.store.format_type_for_source
                = expected_name
                capability receiver_type type_access_type = available_type
                tc
                    .current_location
                    .file
                    .as_str available_type tc.store.format_type_for_source
                = available_name
                capability capability_name = available_access
                "the receiver".to_str = receiver_label
                if
                    0 tc
                        .stack
                        .values
                        .length !=
                then
                    tc
                        .stack
                        .values
                        .length 1 - tc
                        .stack
                        .values
                        .get = receiver_value
                    if receiver_value.place std::Option::Some(place) is then
                        f"`{place.format}`" = receiver_label
                    fi
                fi
                if expected_receiver.is_exclusive_borrow then
                    f"Method `{method_name}` needs exclusive access to `{receiver_type_name}`, but {receiver_label} is {available_access}"
                    f"exclusive receiver: {expected_name}"
                else
                    f"Method `{method_name}` needs ownership of `{receiver_type_name}`, but {receiver_label} is {available_access}"
                    f"owned receiver: {expected_name}"
                fi = expected_contract = message
                f"{available_access} receiver: {available_name}" = available_contract
                available_contract expected_contract tc.current_location.clone message
                common::ErrorKind::TypeMismatch error::CasaError::with_expected = diagnostic
                "Available".to_str = diagnostic.got_label
                diagnostic tc.diagnostics.push_error

                # Recover with the required receiver type so this one conflict
                # does not produce a follow-on generic type mismatch.
                if
                    0 tc
                        .stack
                        .values
                        .length !=
                then
                    tc
                        .stack
                        .values
                        .length 1 - tc
                        .stack
                        .values
                        .get_mut = stored_receiver
                    expected_receiver.clone = stored_receiver.type_value
                    expected_receiver type_capability = stored_receiver.capability
                fi
                true return
            fi
        fi
        false
    }

    pub fn check_trait_method_call
        tc:mut$TypeChecker
        op:mut$common::Op
        emitted_ops:mut$std::List[common::Op]
        function_opt:mut$std::Option[common::Function]
    {
        if function_opt.is_none then
            return
        fi
        tc.stack_peek_type = receiver
        ValueCapability::Owned = receiver_capability
        if
            0 tc
                .stack
                .values
                .length !=
        then
            tc
                .stack
                .values
                .length 1 - tc
                .stack
                .values
                .get
                .capability = receiver_capability
        fi
        tc.store function_opt receiver rules::make_type_borrow_option op.value rules::analyze_operation
        = semantics
        semantics tc.record_decision_dependencies
        if semantics.into_method std::Option::Some(method) is then
            method.stack_effect.clone = effect
            method.method_name.clone = method_name
            method.trait_type.clone = trait_type
            receiver method.method_name.as_str receiver_capability effect
            tc.check_method_receiver_capability drop
            method.method_name.as_str receiver.make_method_key = method_key
            if
                0 effect.type_vars.length !=
                0 effect
                    .const_params
                    .length != ||
            then
                op.type_hint.clone function_opt op.location effect tc.resolve_generic_call_bindings
                = op.call_bindings
            fi
            function_opt emitted_ops op 0 effect tc.bind_borrowed_temporaries
            function_opt std::Option[common::Type]::None method_key.as_str
            effect tc.apply_stack_effect
            effect trait_type receiver.clone method_name common::DeferredTraitCall::new
            common::OpValue::TraitMethodCall op common::Op::set_value
        else
            if op.value.clone common::OpValue::TraitMethodCall(call) is then
                op.location f"No implementation of trait method `{call.method_name}` exists for `{call.receiver.format}`"
                common::ErrorKind::MissingTraitMethod tc.diagnostics.record_error_string
            fi
        fi
    }

    pub fn check_trait_method_ref
        tc:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        if op.value.clone common::OpValue::TraitMethodRef(call) is then
            tc.store function_opt call.receiver rules::make_type_borrow_option op.value rules::analyze_operation
            = semantics
            semantics tc.record_decision_dependencies
            if semantics.into_method std::Option::Some(method) is then
                method.stack_effect.clone = effect
                effect common::stack_effect_to_function_type tc.stack_push_type
                effect method.trait_type.clone call.receiver.clone method.method_name.clone
                common::DeferredTraitCall::new common::OpValue::TraitMethodRef op common::Op::set_value
                return
            fi
        fi
        std::List[common::Type]::new std::List[common::Type]::new common::FunctionType common::Type::Function tc.stack_push_type
    }
}

# Check push variable / capture
impl TypeChecker {
    fn apply_binding_callables self:mut$TypeChecker name:$str {
        if name self.callable_bindings.get_str std::Option::Some(callables) is then
            callables.clone self.stack.set_top_callables
        fi
    }

    # An f-string expression shares bindings declared outside it.
    fn is_format_outer_binding self:$TypeChecker name:$str -> bool {
        if 0 self.format_scope_depth == then
            false return
        fi
        name self
            .scope
            .lookup
            .is_some self.format_scope_depth name self.scope.binds_from ! &&
    }

    # Borrow an outer owner on top of the stack. Copy values and existing
    # borrows keep their access. Returns whether the value became shared.
    fn share_format_value self:mut$TypeChecker name:$str -> bool {
        if name self.is_format_outer_binding ! then
            false return
        fi
        self
            .stack
            .values
            .length 1 - self
            .stack
            .values
            .get_mut = value
        if value.binding.is_none then
            false return
        fi
        common::SHARED_BORROW_TYPE value.type_value.clone common::apply_borrow_type = value.type_value
        ValueCapability::Shared = value.capability
        std::Option[std::String]::None = value.binding
        std::Option[i64]::None = value.source
        false name Place::new value.origins.clone add_origin = value.origins
        true
    }

    fn share_format_binding self:mut$TypeChecker name:$str op:mut$common::Op {
        if name self.share_format_value then
            self
                .stack
                .values
                .length 1 - self
                .stack
                .values
                .get
                .type_value
                .clone std::Option::Some = op.type_hint
        fi
    }

    pub fn check_push_var
        tc:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        op.value.clone = push_value
        if push_value common::OpValue::PushCapture(capture_name) is then
            op capture_name.as_str tc.ownership.use_binding
            std::Option[common::Type]::None = capture_type_opt
            if function_opt std::Option::Some(function) is then
                capture_name.as_str function common::Function::captures common::variable_list_index = capture_index
                if 0 capture_index <= then
                    if
                        capture_index u64::try_from.unwrap function common::Function::captures.get common::Variable::typ.is_unknown !
                    then
                        capture_index u64::try_from.unwrap function common::Function::captures.get common::Variable::typ.clone std::Option::Some = capture_type_opt
                    fi
                fi
            fi
            if capture_type_opt std::Option::Some(capture_type) is then
                function_opt op capture_name.as_str capture_type tc.stack_push_binding
                op capture_name.as_str tc.share_format_binding
                capture_name.as_str tc.apply_binding_callables
                return
            fi
            common::make_unknown_type tc.stack_push_type
            capture_name.as_str tc.apply_binding_callables
            return
        fi

        # PUSH_VARIABLE
        if push_value common::OpValue::PushVar(var_name) is then
            var_name.as_str op tc.record_named_binding
            op var_name.as_str tc.ownership.use_binding
            if var_name.as_str tc.scope.is_expired then
                op common::Op::location f"Variable `{var_name}` is not accessible outside its block scope" common::ErrorKind::UndefinedName tc.diagnostics.record_error_string
                common::make_unknown_type tc.stack_push_type
                var_name.as_str tc.apply_binding_callables
                return
            fi

            # Check local variables first
            if function_opt var_name.as_str tc.local_var_type std::Option::Some(local_type) is then
                if local_type.is_unknown ! then
                    function_opt op var_name.as_str local_type tc.stack_push_binding
                    op var_name.as_str tc.share_format_binding
                else
                    common::make_unknown_type tc.stack_push_type
                fi
                var_name.as_str tc.apply_binding_callables
                return
            fi

            # Check root bindings.
            var_name.as_str tc
                .store
                .variables
                .get_str = global_opt
            if global_opt std::Option::Some(global_var) is then
                if global_var common::Variable::typ.is_unknown ! then
                    function_opt op var_name.as_str global_var common::Variable::typ tc.stack_push_binding
                    op var_name.as_str tc.share_format_binding
                else
                    common::make_unknown_type tc.stack_push_type
                fi
                var_name.as_str tc.apply_binding_callables
                return
            fi

            op common::Op::location f"Variable `{var_name}` is not defined" common::ErrorKind::UndefinedName tc.diagnostics.record_error_string
        fi
    }
}

# Check if/elif/else/fi blocks
impl TypeChecker {
    pub fn merge_if_branch_stack self:mut$TypeChecker op:mut$common::Op if_ctx:mut$IfContext {
        op common::Op::location.clone if_ctx IfContext::set_current_branch_location
        if_ctx IfContext::before = if_before: mut$TypedStack
        if_ctx IfContext::after = if_after: mut$TypedStack
        if self.path_continues ! then
            if_before self.stack.restore
            return
        fi
        if if_ctx.has_continuing_branch ! then
            self.stack if_after.restore
            if_before self.stack.restore
            return
        fi
        if if_after self.stack.equals then
            self.stack if_after.merge_literals
            if_after.mark_literals_runtime
            if_before self.stack.restore
            return
        fi
        self.store if_after self.stack.unify_types = unified
        if 0 unified.length != then
            self.stack if_after.merge_literals
            if_after.mark_literals_runtime
            unified if_after.set_types
            if_before self.stack.restore
        else
            op common::Op::location "Branches have incompatible stack effects"
            common::ErrorKind::StackMismatch self.diagnostics.record_error
            if_before self.stack.restore
        fi
    }

    pub fn check_if_block tc:mut$TypeChecker op:mut$common::Op {
        op.value.clone = if_value
        if if_value common::OpValue::IfStart is then
            IfContext::new = if_ctx
            tc.facts_available = if_ctx.entry_facts_available
            tc.path_continues = if_ctx.entry_continues
            op common::Op::location.clone if_ctx IfContext::set_current_branch_location
            if_ctx BranchFrame::BranchIf = if_frame
            if_frame tc.branched_stacks.push
            # Scope the then-branch: is-bindings from the condition and any
            # block-local assignments live here until the next branch or `fi`.
            tc.scope.enter
            true = tc.in_branch_condition
        elif if_value common::OpValue::IfCondition is then
            false = tc.in_branch_condition
            tc.diagnostics.error_count = errors_before_condition
            if tc.path_continues then
                common::make_bool_type tc.expect_type_t
            fi
            if 0 tc.branched_stacks.length == then
                return
            fi
            tc
                .branched_stacks
                .pop
                .into_if = if_ctx
            tc.facts_available errors_before_condition tc.diagnostics.error_count == &&
            if_ctx.entry_facts_available && = if_ctx.entry_facts_available
            tc.current_ownership_flow = if_ctx.flow_before
            for name in if_ctx.conditional_moves.iter do
                name.as_str if_ctx.flow_before.remove_move
            done
            std::List[std::String]::new = if_ctx.conditional_moves
            if if_ctx IfContext::condition_present ! then
                true if_ctx IfContext::set_condition_present
                tc.stack if_ctx IfContext::before.restore
                tc.stack if_ctx IfContext::after.restore
                "if".to_str if_ctx IfContext::set_current_branch_label
            fi
            if tc.path_continues ! then
                false = if_ctx.entry_continues
            fi
            if_ctx BranchFrame::BranchIf tc.branched_stacks.push
        elif
            if_value common::OpValue::IfElif is
            if_value common::OpValue::IfElse is ||
        then
            # Close the preceding branch scope and open a fresh one. Each
            # branch gets independent is-bindings and block-local variables.
            if 0 tc.branched_stacks.length == then
                return
            fi
            tc
                .branched_stacks
                .pop
                .into_if = if_ctx
            tc.facts_available if_ctx.branches_have_facts && = if_ctx.branches_have_facts
            tc.diagnostics.error_count = errors_before_completion
            op if_ctx.before tc.complete_branch
            tc.scope.enter
            if_ctx.flow_after tc.merge_current_ownership_flow
            if tc.path_continues then
                if_ctx op tc.merge_if_branch_stack
                true = if_ctx.has_continuing_branch
            else
                # Unreachable code after a path ends cannot reach the next branch.
                if_ctx.before tc.stack.restore
            fi
            errors_before_completion tc.diagnostics.error_count == if_ctx.branches_have_facts &&
            = if_ctx.branches_have_facts
            if_ctx.entry_facts_available = tc.facts_available
            if_ctx.flow_before tc.restore_ownership_flow
            if_ctx.entry_continues = tc.path_continues
            if if_value common::OpValue::IfElse is then
                true if_ctx IfContext::set_default_present
                false = tc.in_branch_condition
            else
                true = tc.in_branch_condition
            fi
            if_ctx BranchFrame::BranchIf tc.branched_stacks.push
        elif if_value common::OpValue::IfEnd is then
            tc
                .branched_stacks
                .pop
                .into_if = if_ctx
            tc.facts_available if_ctx.branches_have_facts && = if_ctx.branches_have_facts
            tc.diagnostics.error_count = errors_before_completion
            op if_ctx.before tc.complete_branch
            if_ctx.flow_after tc.merge_current_ownership_flow
            if tc.path_continues then
                if_ctx op tc.merge_if_branch_stack
                true = if_ctx.has_continuing_branch
            fi
            if if_ctx.default_present ! if_ctx.entry_continues && then
                if_ctx.flow_before if_ctx.flow_after.merge
                if_ctx.entry_continues = tc.path_continues
                if_ctx op tc.merge_if_branch_stack
                true = if_ctx.has_continuing_branch
            fi
            if if_ctx.has_continuing_branch then
                if_ctx.flow_after tc.restore_ownership_flow
                if_ctx.after tc.stack.restore
            else
                if_ctx.flow_before tc.restore_ownership_flow
                if_ctx.before tc.stack.restore
            fi
            if_ctx.branches_have_facts if_ctx.entry_facts_available &&
            errors_before_completion tc.diagnostics.error_count == && = tc.facts_available
            if_ctx.has_continuing_branch = tc.path_continues
        fi
    }
}

# Check while/do/break/continue/done blocks
impl TypeChecker {
    pub fn current_while_scope_depth tc:mut$TypeChecker -> std::Option[u64] {
        tc.branched_stacks.length = frame_index
        while 0 frame_index != do
            1 -= frame_index
            if frame_index tc.branched_stacks.get BranchFrame::BranchWhile(while_ctx) is then
                while_ctx.scope_depth std::Option::Some return
            fi
        done
        std::Option[u64]::None
    }

    # A header is checked before its body, so settle its literal types once.
    fn resolve_loop_header self:mut$TypeChecker {
        0 = index: u64
        while
            index self
                .stack
                .values
                .length <
        do
            index self
                .stack
                .values
                .get_mut = value
            value.type_value resolve_numeric_literal_default = resolved
            self.literal_resolutions self.diagnostics resolved value.resolve_literals drop
            resolved = value.type_value
            false = value.is_literal_constant
            1 += index
        done
    }

    # A back-edge must preserve every fact used to check the next iteration.
    fn validate_loop_stack self:mut$TypeChecker expected:$TypedStack op:$common::Op {
        if expected self.stack.equals ! then
            self.store expected.get_types self.stack.get_types stacks_compatible = unified
            if unified.is_empty then
                op.location "Loop back-edge has incompatible stack effects"
                common::ErrorKind::StackMismatch self.diagnostics.record_error
                return
            fi
        fi
        0 = index: u64
        while index expected.values.length < do
            index expected.values.get = before
            index self
                .stack
                .values
                .get = after
            if
                before.capability after.capability !=
                before.origins after.origins origins_equal ! ||
                before.cleanup_origins after.cleanup_origins origins_equal ! ||
            then
                op.location "Loop back-edge changes stack capability or origins"
                common::ErrorKind::InvalidVariable self.diagnostics.record_error
            fi
            for callable in after.callables.iter do
                if callable before.callables.has ! then
                    op.location "Loop back-edge changes stack callable targets"
                    common::ErrorKind::InvalidVariable self.diagnostics.record_error
                fi
            done
            1 += index
        done
    }

    fn merge_loop_exit self:mut$TypeChecker context:mut$WhileContext op:mut$common::Op {
        if self.path_continues ! then
            return
        fi
        context.before self.materialize_branch_results
        if context.has_exit then
            if context.after self.stack.equals then
                self.stack context.after.merge_literals
            else
                self.store self.stack context.after.unify_types = unified
                if unified.is_empty then
                    op.location "Loop exits have incompatible stack effects"
                    common::ErrorKind::StackMismatch self.diagnostics.record_error
                else
                    unified context.after.set_types
                fi
            fi
        else
            self.stack context.after.restore
        fi
        context.after.mark_literals_runtime
        context.flow_exit self.merge_current_ownership_flow
        true = context.has_exit
    }

    pub fn check_while_block tc:mut$TypeChecker op:mut$common::Op {
        op.value.clone = while_value
        if while_value common::OpValue::WhileStart is then
            tc.resolve_loop_header
            tc
                .scope
                .frames
                .length 1 + WhileContext::new = while_ctx
            tc.current_ownership_flow = while_ctx.flow_before
            for
                binding in while_ctx
                    .flow_before
                    .bindings
                    .iter
            do
                if binding.first tc.ownership.binding_has_remaining_uses then
                    binding.first.clone while_ctx.live_bindings.add
                fi
            done
            tc.path_continues = while_ctx.entry_continues
            tc.stack while_ctx WhileContext::before.restore
            op common::Op::location.clone while_ctx WhileContext::set_current_branch_location
            while_ctx BranchFrame::BranchWhile = while_frame
            while_frame tc.branched_stacks.push
            tc.scope.enter
        elif while_value common::OpValue::WhileCondition is then
            if tc.path_continues then
                common::make_bool_type tc.expect_type_t
            fi
            if 0 tc.branched_stacks.length == then
                return
            fi
            tc
                .branched_stacks
                .pop
                .into_while = while_ctx
            op
                .location
                .span
                .offset op
                .location
                .span
                .length + = while_ctx.body_start
            true while_ctx WhileContext::set_condition_present
            tc.stack.snapshot = body_stack
            tc.current_ownership_flow = body_flow
            op while_ctx tc.merge_loop_exit
            body_stack tc.stack.restore
            body_flow tc.restore_ownership_flow
            while_ctx BranchFrame::BranchWhile tc.branched_stacks.push
        elif
            while_value common::OpValue::WhileBreak is
            while_value common::OpValue::WhileContinue is ||
        then
            if 0 tc.branched_stacks.length == then
                return
            fi
            if tc.current_while_scope_depth std::Option::Some(scope_depth) is then
                scope_depth tc.scope.names_from = names
                tc.branched_stacks.length = frame_index
                while 0 frame_index != do
                    1 -= frame_index
                    frame_index tc
                        .branched_stacks
                        .remove
                        .unwrap = top_frame
                    false = found_while
                    if top_frame BranchFrame::BranchWhile is then
                        top_frame.into_while = while_ctx
                        true = found_while
                        if tc.path_continues then
                            if while_value common::OpValue::WhileBreak is then
                                while_ctx.before tc.materialize_branch_results
                                false names op tc.attach_owner_cleanups
                                op while_ctx tc.merge_loop_exit
                            else
                                while_ctx.before tc.materialize_branch_results
                                op while_ctx.before tc.validate_loop_stack
                                op names while_ctx.flow_before tc.report_loop_flow_difference
                                false names op tc.attach_owner_cleanups
                            fi
                        fi
                        while_ctx BranchFrame::BranchWhile = top_frame
                    fi
                    frame_index top_frame tc.branched_stacks.insert
                    if found_while then
                        break
                    fi
                done
            fi
            tc.end_path
        elif while_value common::OpValue::WhileEnd is then
            tc
                .branched_stacks
                .pop
                .into_while = while_ctx
            while_ctx.scope_depth tc.scope.names_from = names
            if tc.path_continues then
                while_ctx.before tc.materialize_branch_results
                op while_ctx.before tc.validate_loop_stack
                op names while_ctx.flow_before tc.report_loop_flow_difference
            fi
            op tc.attach_scope_cleanups
            0 op
                .location
                .span
                .offset tc.close_source_bindings
            tc.scope.exit
            if while_ctx.has_exit then
                while_ctx.after tc.stack.restore
                while_ctx.flow_exit tc.restore_ownership_flow
                true = tc.path_continues
                if op.ownership std::Option::Some(ownership) is then
                    ownership.cleanups.clone = cleanups
                    names cleanups op tc.validate_owner_cleanups
                fi
            else
                while_ctx.flow_before tc.restore_ownership_flow
            fi
            names tc.remove_flow_names
            while_ctx.has_exit = tc.path_continues
        fi
    }
}

# Trait support: bind_generic_params_standalone and type_satisfies_trait
pub fn bind_standalone_type_variable
    bindings:std::Map[std::String common::Type]
    name:$std::String
    actual:$common::Type
    type_vars:$std::Set[std::String]
-> std::Map[std::String common::Type] {
    if name type_vars.has ! then
        bindings return
    fi
    if name bindings.get std::Option::Some(existing) is then
        if
            existing.is_integer_literal_t actual.is_integer_type_t &&
            existing.is_float_literal_t actual.is_float_type_t && ||
        then
            actual.clone name.clone bindings.set
        fi
    else
        actual.clone name.clone bindings.set
    fi
    bindings
}

pub fn bind_direct_generic_params
    bindings:std::Map[std::String common::Type]
    expected_type:$common::Type
    actual_type:$common::Type
    type_vars:$std::Set[std::String]
-> std::Map[std::String common::Type] {
    if expected_type.type_var_name std::Option::Some(type_var_name) is then
        type_vars actual_type type_var_name bindings bind_standalone_type_variable return
    fi
    if expected_type common::Type::Generic(expected_generic) is then
        if actual_type common::Type::Generic(actual_generic) is then
            if expected_generic.base actual_generic.base != then
                bindings return
            fi
            0 = index: u64
            while
                index expected_generic.params.length <
                index actual_generic.params.length < &&
            do
                index expected_generic.params.get = expected_parameter
                if expected_parameter.type_var_name std::Option::Some(type_var_name) is then
                    type_vars index actual_generic.params.get type_var_name bindings
                    bind_standalone_type_variable = bindings
                fi
                1 += index
            done
        fi
    fi
    bindings
}

pub fn bind_generic_params_standalone
    bindings:std::Map[std::String common::Type]
    expected_type:$common::Type
    actual_type:$common::Type
    type_vars:$std::Set[std::String]
-> std::Map[std::String common::Type] {
    type_vars actual_type expected_type bindings bind_direct_generic_params = bindings
    if expected_type common::Type::Function(expected_function) is then
        if actual_type common::Type::Function(actual_function) is then
            0 = index: u64
            while
                index expected_function.parameters.length <
                index actual_function.parameters.length < &&
            do
                type_vars index actual_function.parameters.get index expected_function.parameters.get bindings
                bind_direct_generic_params = bindings
                1 += index
            done
            0 = index: u64
            while
                index expected_function.return_types.length <
                index actual_function.return_types.length < &&
            do
                type_vars index actual_function.return_types.get index expected_function.return_types.get bindings
                bind_direct_generic_params = bindings
                1 += index
            done
        fi
    fi
    bindings
}

# Bind every symbolic constant parameter in `expected` to the argument in the
# matching position of `actual` (ADR-0152). The bound value is either a concrete
# constant or the caller's own constant parameter when the call forwards it.
pub fn bind_standalone_constant_parameters
    bindings:std::Map[std::String common::Type]
    expected:$common::Type
    actual:$common::Type
-> std::Map[std::String common::Type] {
    if expected common::Type::Const(expected_constant) is then
        if expected_constant.is_symbolic expected_constant.name bindings.has ! && then
            actual.clone expected_constant.name.clone bindings.set
        fi
        bindings return
    fi
    if expected common::Type::Generic(expected_generic) is then
        actual expected_generic bindings bind_matching_generic_constant_parameters return
    fi
    bindings
}

pub fn bind_matching_generic_constant_parameters
    bindings:std::Map[std::String common::Type]
    expected:$common::GenericType
    actual:$common::Type
-> std::Map[std::String common::Type] {
    if actual common::Type::Generic(actual_generic) is then
        if expected.base actual_generic.base != then
            bindings return
        fi
        if expected.params.length actual_generic.params.length != then
            bindings return
        fi
        for
            pair in actual_generic.params.iter expected
                .params
                .list_iter
                .zip
        do
            pair.second pair.first bindings bind_standalone_constant_parameters = bindings
        done
    fi
    bindings
}

pub fn matches_trait_bound
    receiver:$common::Type
    trait_type:$common::Type
    function_opt:mut$std::Option[common::Function]
    store:mut$common::SymbolStore
-> bool {
    if receiver.has_unresolved_type_var ! then
        false return
    fi
    if function_opt std::Option::Some(function) is then
        store function.stack_effect.trait_bounds trait_type receiver
        rules::type_has_satisfying_trait_impl_with_bounds return
    fi
    false
}

pub fn bind_stack_effect_pattern
    pattern:$common::StackEffect
    actual:$common::StackEffect
-> std::Option[std::Map[std::String common::Type]] {
    if pattern.parameters.length actual.parameters.length != then
        std::Option[std::Map[std::String common::Type]]::None return
    fi
    if pattern.return_types.length actual.return_types.length != then
        std::Option[std::Map[std::String common::Type]]::None return
    fi
    std::Map[std::String common::Type]::new = bindings
    for
        pair in actual.parameters.iter pattern
            .parameters
            .list_iter
            .zip
    do
        if bindings pair.second.typ pair.first.typ rules::bind_trait_impl_type ! then
            std::Option[std::Map[std::String common::Type]]::None return
        fi
    done
    for
        pair in actual.return_types.iter pattern
            .return_types
            .list_iter
            .zip
    do
        if bindings pair.second pair.first rules::bind_trait_impl_type ! then
            std::Option[std::Map[std::String common::Type]]::None return
        fi
    done
    bindings std::Option::Some
}

pub fn stack_effect_type_variables effect:$common::StackEffect -> std::Set[std::String] {
    std::Set[std::String]::new = type_variables
    for parameter in effect.parameters.iter do
        type_variables parameter.typ common::collect_stack_effect_type_vars
    done
    for return_type in effect.return_types.iter do
        type_variables return_type common::collect_stack_effect_type_vars
    done
    type_variables
}

pub fn trait_method_effects_match
    expected:$common::StackEffect
    actual:$common::StackEffect
    generic_declaration:bool
-> bool {
    actual expected bind_stack_effect_pattern = expected_match
    if generic_declaration then
        if expected_match std::Option::Some(expected_bindings) is then
            expected stack_effect_type_variables = expected_type_variables
            for type_variable in expected_type_variables.iter do
                if type_variable expected_bindings.get std::Option::Some(bound) is then
                    if bound common::Type::TypeVar(_) is ! then
                        false return
                    fi
                fi
            done
            true return
        fi
        false return
    fi
    if expected_match.is_some then
        true return
    fi
    expected actual bind_stack_effect_pattern.is_some
}

pub fn collect_trait_shape_requirements
    trait_type:$common::Type
    store:$common::SymbolStore
-> std::Option[std::List[common::TraitMethod]] std::Map[std::String common::Type] {
    std::Map[std::String common::Type]::new = substitutions
    if trait_type.match_base store.traits.get std::Option::Some(casa_trait) is then
        if trait_type.type_params std::Option::Some(trait_arguments) is then
            if trait_arguments.length casa_trait.type_params.length == then
                for
                    pair in trait_arguments.iter casa_trait
                        .type_params
                        .list_iter
                        .zip
                do
                    pair.second.clone pair.first.clone substitutions.set
                done
            fi
        fi
        casa_trait store rules::collect_trait_methods std::Option::Some substitutions
    else
        std::Option[std::List[common::TraitMethod]]::None substitutions
    fi
}

fn type_has_trait_shape
    receiver:$common::Type
    trait_type:$common::Type
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    checks:mut$SemanticChecks
    generic_declaration:bool
-> bool {
    trait_type.match_base = trait_lookup_name
    store trait_type collect_trait_shape_requirements = trait_subs = trait_methods_opt
    if trait_methods_opt std::Option::Some(trait_methods) is then
        for method in trait_methods.iter do
            std::Option[CheckedFunction]::None = fn_opt
            store receiver trait_type method.name.as_str rules::resolve_qualified_method_semantics
            = semantics_opt
            if semantics_opt std::Option::Some(method_semantics) is then
                if method_semantics.kind rules::MethodSemanticsKind::DefaultMethod is then
                    continue
                fi
                false checks diagnostics store method_semantics.function_name.as_str ensure_checked_function = fn_opt
            fi
            if fn_opt.is_none then
                # Default methods (with a body) don't require a concrete implementation
                if method.has_default_body then
                    continue
                fi
                false return
            fi
            fn_opt.unwrap = function
            function.stack_effect common::stack_effect_to_str = effect_text
            if "None -> None" effect_text.as_str == then
                false return
            fi
            trait_subs receiver method common::TraitMethod::stack_effect common::resolve_trait_stack_effect common::apply_type_subs_to_stack_effect = resolved
            if generic_declaration function.stack_effect resolved trait_method_effects_match ! then
                false return
            fi
        done
        true
    else
        false
    fi
}

pub fn type_has_satisfying_trait_impl
    receiver:$common::Type
    trait_type:$common::Type
    store:$common::SymbolStore
-> bool {
    store trait_type receiver rules::type_has_satisfying_trait_impl
}

pub fn type_satisfies_trait
    receiver:$common::Type
    trait_type:$common::Type
    function_opt:mut$std::Option[common::Function]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    bodies:$std::Map[std::String source_body::SourceBody]
-> bool {
    SemanticChecks::new = checks
    bodies.clone checks.stage_sources
    store checks.stage_accessors
    checks diagnostics store function_opt trait_type receiver check_trait_satisfaction = result
    result
}

fn check_trait_satisfaction
    receiver:$common::Type
    trait_type:$common::Type
    function_opt:mut$std::Option[common::Function]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    checks:mut$SemanticChecks
-> bool {
    receiver.clone = receiver_type
    if receiver.borrow_target std::Option::Some(target) is then
        if
            common::STD_COPY_TRAIT trait_type.match_base.as_str ==
            common::STD_CLONE_TRAIT trait_type.match_base.as_str == ||
        then
            false return
        fi
        target.clone = receiver_type
    fi
    if common::STD_CLONE_TRAIT trait_type.match_base.as_str == receiver_type.is_function && then
        common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
        if store trait_type copy_type rules::trait_type_implies then
            true return
        fi
    fi
    if store function_opt trait_type receiver_type matches_trait_bound then
        true return
    fi
    if store trait_type receiver_type rules::type_has_satisfying_trait_impl ! then
        false return
    fi
    false checks diagnostics store trait_type receiver_type type_has_trait_shape
}

pub fn find_tparam_index tparams:$std::List[std::String] name:$str -> std::Option[u64] {
    std::Option[u64]::None = found_index
    0 = scan_index: u64
    while scan_index tparams.length < do
        if scan_index tparams.get.as_str name == then
            scan_index std::Option::Some = found_index
        fi
        1 += scan_index
    done
    found_index
}

pub fn try_bind_caller_tvar
    bindings:mut$std::Map[std::String common::Type]
    effect:$common::StackEffect
    caller_ref:$common::Type
    concrete:$common::Type
{
    if caller_ref.type_var_name std::Option::Some(caller_type_var) is then
        if caller_type_var.as_str effect common::StackEffect::type_vars.has_str ! then
            return
        fi
        if caller_type_var.as_str bindings.get_str std::Option::Some is then
            return
        fi
        concrete.clone caller_type_var.clone bindings.set
    fi
}

# Given a single (trait-side expected type, concrete-side actual type) pair
# from a method stack-effect diff, if the expected type references a trait
# type parameter that maps (via the current bound's type args) to an unbound
# caller type variable, bind it to the actual type. Handles both direct
# references (`T`) and one-level nested generics (`Option[T]` vs `Option[i64]`).
pub fn bind_from_type_slot
    bindings:mut$std::Map[std::String common::Type]
    effect:$common::StackEffect
    tparams:$std::List[std::String]
    bargs:$std::List[common::Type]
    expected:$common::Type
    actual:$common::Type
{
    if expected.type_var_name std::Option::Some(direct_tv_name) is then
        direct_tv_name.as_str tparams find_tparam_index = direct_tp_idx
        if direct_tp_idx std::Option::Some(direct_index) is then
            direct_index bargs.get = direct_caller_ref
            actual direct_caller_ref effect bindings try_bind_caller_tvar
            return
        fi
        return
    fi
    if expected.as_generic std::Option::Some(expected_g) is then
        if actual.as_generic std::Option::Some(actual_g) is then
            if expected_g.base actual_g.base == then
                0 = slot_index: u64
                while
                    slot_index expected_g.params.length <
                    slot_index actual_g.params.length < &&
                do
                    if
                        slot_index expected_g
                            .params
                            .get
                            .type_var_name std::Option::Some(nested_name) is
                    then
                        nested_name.as_str tparams find_tparam_index = nested_tp_idx
                        if nested_tp_idx std::Option::Some(nested_index) is then
                            nested_index bargs.get = nested_caller_ref
                            slot_index actual_g.params.get nested_caller_ref effect bindings try_bind_caller_tvar
                        fi
                    fi
                    1 += slot_index
                done
            fi
        fi
    fi
}

pub fn diff_method_stack_effect
    bindings:mut$std::Map[std::String common::Type]
    effect:$common::StackEffect
    tparams:$std::List[std::String]
    bargs:$std::List[common::Type]
    trait_resolved:$common::StackEffect
    impl_stack_effect:$common::StackEffect
{
    0 = param_index: u64
    while
        param_index trait_resolved common::StackEffect::parameters.length <
        param_index impl_stack_effect common::StackEffect::parameters.length < &&
    do
        param_index trait_resolved common::StackEffect::parameters.get common::Parameter::typ = expected_param: $common::Type
        param_index impl_stack_effect common::StackEffect::parameters.get common::Parameter::typ = actual_param: $common::Type
        actual_param expected_param bargs tparams effect bindings bind_from_type_slot
        1 += param_index
    done
    0 = return_index: u64
    while
        return_index trait_resolved common::StackEffect::return_types.length <
        return_index impl_stack_effect common::StackEffect::return_types.length < &&
    do
        return_index trait_resolved common::StackEffect::return_types.get = expected_return
        return_index impl_stack_effect common::StackEffect::return_types.get = actual_return
        actual_return expected_return bargs tparams effect bindings bind_from_type_slot
        1 += return_index
    done
}

pub fn method_diff_bind_for_bound
    bindings:mut$std::Map[std::String common::Type]
    effect:$common::StackEffect
    bound:$common::TraitBound
    concrete:$common::Type
    store:$common::SymbolStore
{
    bound common::TraitBound::name.as_str store.traits.get_str = trait_opt
    if trait_opt.is_none then
        return
    fi
    trait_opt.unwrap = trait_def
    trait_def common::CasaTrait::type_params = trait_params: $std::List[std::String]
    bound common::TraitBound::type_args = bound_args: $std::List[common::Type]
    if bound_args.length trait_params.length != then
        return
    fi
    for trait_method in trait_def common::CasaTrait::methods.iter do
        store std::Option[common::Function]::None concrete trait_method.name.as_str rules::resolve_method_semantics
        = method_opt
        if method_opt std::Option::Some(method_semantics) is then
            method_semantics.function_name = function_name: $std::String
            if function_name.as_str store.get_function std::Option::Some(concrete_fn) is then
                concrete trait_method common::TraitMethod::stack_effect common::resolve_trait_stack_effect
                = trait_resolved
                concrete_fn common::Function::stack_effect trait_resolved bound_args trait_params effect
                bindings diff_method_stack_effect
            fi
        fi
    done
}

pub fn method_diff_bind_all
    effect:$common::StackEffect
    function_opt:mut$std::Option[common::Function]
    bindings:mut$std::Map[std::String common::Type]
    store:$common::SymbolStore
{
    effect common::StackEffect::trait_bounds.keys = bound_keys
    for bound_type_var in bound_keys.iter do
        if
            bound_type_var effect common::StackEffect::trait_bounds.get std::Option::Some(constraints) is
        then
            bound_type_var.as_str bindings clone_type_binding = concrete_opt
            if concrete_opt std::Option::Some(concrete) is then
                for bound_constraint in constraints.iter do
                    store concrete bound_constraint effect bindings method_diff_bind_for_bound
                done
            fi
        fi
    done
}

pub fn bounds_imply_trait
    bounds:$std::List[common::TraitBound]
    target:$common::Type
    store:$common::SymbolStore
-> bool {
    for bound in bounds.iter do
        bound common::trait_bound_to_type = direct
        if store target direct rules::trait_type_implies then
            true return
        fi
    done
    false
}

pub fn caller_forwards_trait_bound
    function_opt:mut$std::Option[common::Function]
    concrete_name:$str
    trait_type:$common::Type
    store:$common::SymbolStore
-> bool {
    if function_opt std::Option::Some(function) is then
        if
            concrete_name function
                .stack_effect
                .trait_bounds
                .get_str std::Option::Some(caller_bounds) is
        then
            if store trait_type caller_bounds bounds_imply_trait then
                true return
            fi
        fi
    fi
    false
}

pub fn ensure_function_clone_method
    store:mut$common::SymbolStore
    typ:$common::Type
    location:$common::Location
    checks:mut$SemanticChecks
{
    if typ common::Type::Function(_) is ! then
        return
    fi
    if
        common::STD_COPY_TRAIT store.traits.has_str !
        common::STD_CLONE_TRAIT.to_str store.traits.has ! ||
    then
        return
    fi
    common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
    common::STD_CLONE_TRAIT.to_str common::GenericType::new common::Type::Generic = clone_trait_type
    if store clone_trait_type copy_type rules::trait_type_implies ! then
        return
    fi

    "clone" typ.make_method_key = function_name
    if function_name.as_str store.has_function then
        return
    fi

    std::List[common::Parameter]::new = parameters
    "self".to_str typ.clone common::Parameter::named parameters.push
    std::List[common::Type]::new = returns
    typ.clone returns.push
    returns parameters common::StackEffect::new = effect

    std::List[common::Op]::new = ops
    location.clone "self".to_str common::OpValue::AssignVar common::Op::new ops.push
    location.clone "self".to_str common::OpValue::PushVar common::Op::new ops.push
    effect location.clone function_name.clone common::Function::with_stack_effect = function
    std::List[common::Variable]::new = variables
    typ.clone "self".to_str common::Variable variables.push
    variables function common::Function::set_variables
    ops source_body::consume_source_body FunctionWork::Pending function_name.clone checks.functions.set
    function store.set_generated_recipe
}

impl TypeChecker {
    pub fn bind_concrete_type_variable
        tc:mut$TypeChecker
        name:$str
        actual:$common::Type
        bindings:std::Map[std::String common::Type]
        location:$common::Location
    -> std::Map[std::String common::Type] {
        name bindings.remove_str = existing_option
        if existing_option.is_none then
            actual.clone name.clone bindings.set_str
            bindings return
        fi
        existing_option.unwrap = existing
        if existing.has_unresolved_type_var actual.has_unresolved_type_var ! && then
            actual.clone name.clone bindings.set_str
            bindings return
        fi
        if
            existing.is_integer_literal_t actual.is_integer_type_t &&
            existing.is_float_literal_t actual.is_float_type_t && ||
        then
            actual.clone name.clone bindings.set_str
            bindings return
        fi
        if
            actual.is_integer_literal_t existing.is_integer_type_t &&
            actual.is_float_literal_t existing.is_float_type_t && ||
        then
            existing name.clone bindings.set_str
            bindings return
        fi
        if existing actual.eq ! then
            location f"Type variable `{name}` bound to `{existing.format}` but got `{actual.format}`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        fi
        existing name.clone bindings.set_str
        bindings
    }

    pub fn bind_stack_parameter
        tc:mut$TypeChecker
        parameter:$common::Parameter
        stack_index:u64
        effect:$common::StackEffect
        bindings:std::Map[std::String common::Type]
        location:$common::Location
    -> std::Map[std::String common::Type] {
        stack_index tc
            .stack
            .values
            .get
            .type_value
            .clone = actual
        if actual.borrow_target std::Option::Some(target) is then
            target.clone = actual
        fi
        parameter.typ.clone = pattern
        if pattern.borrow_target std::Option::Some(target) is then
            target.clone = pattern
        fi
        if pattern.type_var_name std::Option::Some(type_variable) is then
            if type_variable.as_str effect.type_vars.has_str then
                type_variable.as_str bindings.get_str = existing_option
                if existing_option std::Option::Some(existing) is then
                    if existing.is_borrow then
                        bindings return
                    fi
                fi
                location bindings actual type_variable.as_str tc.bind_concrete_type_variable return
            fi
        fi
        effect.type_vars actual pattern bindings bind_generic_params_standalone = bindings
        actual pattern bindings bind_standalone_constant_parameters
    }

    pub fn finalize_stack_parameter_literals
        tc:mut$TypeChecker
        parameter:$common::Parameter
        stack_index:u64
        effect:$common::StackEffect
        bindings:std::Map[std::String common::Type]
        location:$common::Location
    -> std::Map[std::String common::Type] {
        if
            stack_index tc
                .stack
                .values
                .get
                .literals
                .is_empty
        then
            bindings return
        fi
        stack_index tc
            .stack
            .values
            .get
            .clone = value
        bindings parameter.typ.substitute_t resolve_numeric_literal_default = target
        tc.literal_resolutions tc.diagnostics target value.resolve_literals drop
        if target.borrow_target std::Option::Some(borrowed_target) is then
            borrowed_target.clone = target
        fi
        target.clone = value.type_value
        value stack_index tc
            .stack
            .values
            .set
        location bindings effect stack_index parameter tc.bind_stack_parameter
    }

    pub fn resolve_generic_call_bindings
        tc:mut$TypeChecker
        effect:$common::StackEffect
        location:$common::Location
        function_opt:mut$std::Option[common::Function]
        return_hint:std::Option[common::Type]
    -> std::Map[std::String common::Type] {
        std::Map[std::String common::Type]::new = bindings
        tc
            .stack
            .values
            .length = depth
        0 = index: u64
        while index effect.parameters.length < do
            if index depth < then
                depth 1 - index - = stack_index
                index effect.parameters.get = parameter
                location bindings effect stack_index parameter tc.bind_stack_parameter = bindings
            fi
            1 += index
        done
        0 = index: u64
        while index effect.parameters.length < do
            if index depth < then
                depth 1 - index - = stack_index
                index effect.parameters.get = parameter
                bindings parameter.typ.substitute_t = contextual_type
                contextual_type.clone std::Option::Some stack_index
                tc.materialize_pending_lambda_at
                location bindings effect stack_index parameter tc.bind_stack_parameter = bindings
            fi
            1 += index
        done
        0 = index: u64
        while index effect.parameters.length < do
            if index depth < then
                depth 1 - index - = stack_index
                index effect.parameters.get = parameter
                location bindings effect stack_index parameter tc.finalize_stack_parameter_literals
                = bindings
            fi
            1 += index
        done
        tc.store bindings function_opt effect method_diff_bind_all

        if return_hint std::Option::Some(hint) is then
            for return_type in effect.return_types.iter do
                effect.type_vars hint return_type bindings bind_generic_params_standalone = bindings
            done
        fi

        function_opt location bindings effect tc.validate_generic_bindings
        bindings
    }

    fn validate_reference_types
        self:mut$TypeChecker
        effect:$common::StackEffect
        bindings:$std::Map[std::String common::Type]
        location:$common::Location
        function_opt:mut$std::Option[common::Function]
    {
        for type_variable in effect.type_vars.iter do
            if type_variable.as_str bindings clone_type_binding std::Option::Some(bound) is then
                if bound common::Type::Const is then
                    location f"Type parameter `{type_variable}` requires a type, got `{bound.format}`"
                    common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                else
                    location function_opt bound self.validate_type_exists
                fi
            else
                location f"Cannot determine concrete type for type variable `{type_variable}`"
                common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
            fi
        done
    }

    pub fn validate_generic_bindings
        tc:mut$TypeChecker
        effect:$common::StackEffect
        bindings:mut$std::Map[std::String common::Type]
        location:$common::Location
        function_opt:mut$std::Option[common::Function]
    {
        for parameter in effect.parameters.iter do
            bindings parameter.typ.substitute_t = resolved
            if tc.store resolved parameter.typ hides_callable_storage_borrow then
                location
                f"Generic callback `{parameter.name}` hides a borrowed result in a type parameter"
                common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi
        done
        for returned in effect.return_types.iter do
            bindings returned.substitute_t = resolved
            if tc.store resolved returned hides_callable_storage_borrow then
                location "Generic callback result hides a borrowed result in a type parameter"
                common::ErrorKind::TypeMismatch tc.diagnostics.record_error
            fi
        done
        for
            constant_name in effect
                .const_params
                .keys
                .iter
        do
            if constant_name.as_str bindings clone_type_binding std::Option::Some(bound) is then
                if function_opt std::Option::Some(caller) is then
                    caller.stack_effect.const_params bound rules::rewrite_type_const_params = bound
                fi
                constant_name effect
                    .const_params
                    .get
                    .unwrap constant_name.clone
                common::ConstType::symbolic = expected
                bound expected tc.validate_const_argument
                bound constant_name.clone bindings.set
            else
                location f"Cannot determine the value of constant parameter `{constant_name}`"
                common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            fi
        done
        for
            type_variable in effect
                .trait_bounds
                .keys
                .iter
        do
            type_variable.as_str bindings clone_type_binding = concrete_opt
            if concrete_opt.is_none then
                location f"Cannot determine concrete type for type variable `{type_variable}`"
                common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                continue
            fi
            concrete_opt.unwrap = concrete
            concrete.format = concrete_name
            for
                bound in type_variable effect
                    .trait_bounds
                    .get
                    .unwrap
                    .iter
            do
                bound common::trait_bound_to_type = trait_type
                bindings trait_type.substitute_t = resolved_trait
                tc.store resolved_trait concrete_name.as_str function_opt caller_forwards_trait_bound
                = forwards_bound
                if
                    forwards_bound ! tc.checks tc.diagnostics tc.store function_opt resolved_trait concrete
                    check_trait_satisfaction ! &&
                then
                    location f"Type `{concrete_name}` does not satisfy trait `{resolved_trait.format}`"
                    common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                fi
            done
        done
    }
}

# Check function-related operations
impl TypeChecker {
    fn materialize_named_lambda
        self:mut$TypeChecker
        stack_index:u64
        lambda_name:std::String
        expected:std::Option[common::Type]
    {
        if lambda_name.as_str self.store.get_function std::Option::Some(lambda) is then
            lambda.clone = owned_lambda
            false = completed
            if
                lambda_name.as_str self
                    .checks
                    .functions
                    .get_str std::Option::Some(work) is
            then
                work FunctionWork::Completed is = completed
            fi
            if completed ! expected std::Option::Some(expected_type) is && then
                expected_type.clone = callback_type
                if callback_type.borrow_target std::Option::Some(target) is then
                    target.clone = callback_type
                fi
                if callback_type common::Type::Function(function_type) is then
                    function_type common::function_type_to_stack_effect = contextual_effect
                    owned_lambda
                        .stack_effect
                        .type_vars
                        .clone contextual_effect common::StackEffect::set_type_vars
                    owned_lambda
                        .stack_effect
                        .trait_bounds
                        .clone contextual_effect common::StackEffect::set_trait_bounds
                    owned_lambda
                        .stack_effect
                        .const_params
                        .clone contextual_effect common::StackEffect::set_const_params
                    contextual_effect owned_lambda common::Function::set_stack_effect
                fi
            fi
            owned_lambda self.store.set_function
            if
                self.infer_parameters self.checks self.diagnostics self.store
                lambda_name.as_str ensure_checked_function std::Option::Some(checked) is
            then
                checked.stack_effect common::stack_effect_to_function_type = lambda_type
                stack_index self
                    .stack
                    .values
                    .get_mut = value
                lambda_type.clone = value.type_value
                lambda_type type_capability = value.capability
                std::Option[i64]::None = value.source
            else
                false = self.facts_available
            fi
        fi
    }

    # Apply declared callback inputs before checking a returned closure's body.
    fn materialize_return_lambdas self:mut$TypeChecker effect:$common::StackEffect {
        0 = index: u64
        while
            index self
                .stack
                .values
                .length <
        do
            std::Option[common::Type]::None = expected
            if index effect.return_types.length < then
                index effect
                    .return_types
                    .get
                    .clone std::Option::Some = expected
            fi
            expected.clone index self.materialize_pending_lambda_at
            if expected std::Option::Some(return_type) is then
                if return_type is_callable_contract then
                    CALLABLE_CONTRACT index self
                        .stack
                        .values
                        .get_mut
                        .callables
                        .add_str
                fi
            fi
            1 += index
        done
    }

    fn materialize_pending_lambda_at
        self:mut$TypeChecker
        stack_index:u64
        expected:std::Option[common::Type]
    {
        stack_index self
            .stack
            .values
            .get = pending_value
        if pending_value.source.clone std::Option::Some(source) is then
            if source self.pending_lambdas.remove std::Option::Some(lambda_name) is then
                expected lambda_name.clone stack_index self.materialize_named_lambda
            fi
        fi
    }

    fn materialize_pending_lambda self:mut$TypeChecker expected:std::Option[common::Type] {
        if
            self
                .stack
                .values
                .is_empty
        then
            return
        fi
        expected self
            .stack
            .values
            .length 1 - self.materialize_pending_lambda_at
    }

    # ADR-0112: a typed borrow reconstructed from a raw address inside `unsafe`
    # is anchored conservatively to every compatible borrowed input of the
    # enclosing function. A shared borrow accepts any borrowed input; an
    # exclusive borrow accepts only exclusive inputs (ADR-0113). A function with
    # no compatible input yields no origin, so the borrow cannot escape.
    pub fn raw_borrow_input_origins
        self:mut$TypeChecker
        function_opt:mut$std::Option[common::Function]
        exclusive:bool
    -> std::Option[std::List[Origin]] {
        std::Option[std::List[Origin]]::None = origins
        if function_opt std::Option::Some(function) is then
            for
                parameter in function
