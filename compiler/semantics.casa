# Check memory operations
# Returns true if `bound` names `Word` directly or transitively via supertraits.
pub fn bound_implies_word bound:$common::TraitBound store:$common::SymbolStore -> bool {
    bound common::TraitBound::name.as_str = bound_name: $str
    if common::STD_WORD_TRAIT bound_name.as_str == then
        true return
    fi
    bound_name store.traits.get_str = bound_trait_opt
    if bound_trait_opt.is_none then
        false return
    fi
    if bound_trait_opt std::Option::Some(bound_trait) is then
        for super_bound in bound_trait common::CasaTrait::supertraits.iter do
            if store super_bound bound_implies_word then
                true return
            fi
        done
    fi
    false
}

# Validate that `type_name` satisfies the `Word` marker trait at the given op
# location. Concrete single-slot types always satisfy `Word` in current Casa.
# A type variable from the enclosing function satisfies `Word` only when its
# declared bound is `Word` itself or a trait that extends `Word`. An unbounded
# type variable is allowed; the concrete type bound at the call site will
# satisfy `Word` automatically.
impl TypeChecker {
    pub fn check_word_bounds
        tc:mut$TypeChecker
        bounds:$std::List[common::TraitBound]
        type_name:$str
        op:mut$common::Op
    {
        for bound in bounds.iter do
            if tc.store bound bound_implies_word then
                return
            fi
        done
        if 0 bounds.length != then
            op.location f"Type variable `{type_name}` does not satisfy `Word` bound; add `[{type_name}: Word]` (or a trait that extends `Word`) to the function's type parameters" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        fi
    }

    pub fn assert_word_bound
        tc:mut$TypeChecker
        op:mut$common::Op
        typ:$common::Type
        function_opt:mut$std::Option[common::Function]
    {
        if typ.is_unknown_placeholder then
            return
        fi
        if function_opt std::Option::Some(function) is then
            if typ common::Type::TypeVar(type_name) is then
                function.stack_effect = word_stack_effect: $common::StackEffect
                if type_name word_stack_effect.type_vars.has ! then
                    return
                fi
                type_name word_stack_effect.trait_bounds.get = word_bounds_opt
                if word_bounds_opt std::Option::Some(word_bounds) is then
                    op type_name.as_str word_bounds tc.check_word_bounds
                fi
            fi
        fi
    }
}

