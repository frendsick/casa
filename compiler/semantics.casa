        fi
        if function_opt name is_function_parameter ! then
            std::Option[std::List[Origin]]::None return
        fi
        if typ TypeChecker::does_type_need_symbolic_origin then
            false OriginKind::InputCleanup name Place::new Origin = dependency
            dependency std::Option[std::List[Origin]]::None append_origin return
        fi
        std::List[std::String]::new = visiting
        if visiting tc.store typ does_cleanup_observe_borrow then
            false OriginKind::InputCleanup name Place::new Origin = dependency
            dependency std::Option[std::List[Origin]]::None append_origin return
        fi
        std::Option[std::List[Origin]]::None
    }

    pub fn assignment_origins
        tc:mut$TypeChecker
        name:$str
