# A retained exclusive capture cannot lend through a repeatable fn contract.
# Moving a stored payload uses symbolic dependencies and remains valid.
fn is_exclusive_capture_reborrow origin:$Origin function:$common::Function -> bool {
    if origin.kind OriginKind::Place is ! then
        false return
    fi
    for capture in function.captures.iter do
        if origin.place.binding capture.name == capture.typ.is_exclusive_borrow && then
            true return
        fi
    done
    false
}

