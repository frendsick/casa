impl TypeChecker {
    pub fn bind_fn_param
        tc:mut$TypeChecker
        bindings:mut$std::Map[std::String common::Type]
        expected:$common::Parameter
        effect:$common::StackEffect
    -> bool {
        # Bind type vars from a function-type param like fn[T -> T].
        if expected common::Parameter::typ.is_fn_type_t ! then
            false return
        fi
        # Check if any type var appears in the function type.
        false = has_type_var
        effect common::StackEffect::type_vars.to_list = type_var_list
        for type_var in type_var_list.iter do
            if type_var.as_str expected common::Parameter::typ.type_contains_var then
                true = has_type_var
            fi
        done
        if has_type_var ! then
            false return
        fi

        tc.stack_pop_value = function_value
        if expected.typ.is_borrow then
            function_value tc.release_value
        else
            function_value tc.consume_value
        fi
        function_value.type_value.clone = actual
        if actual.is_unknown_placeholder then
            for type_var2 in type_var_list.iter do
                if type_var2.as_str expected common::Parameter::typ.type_contains_var then
                    common::make_unknown_type type_var2.as_str bindings tc.bind_type_var
                fi
            done
            tc.current_location "Cannot infer generic callback type. Add explicit callback parameter types."
            common::ErrorKind::TypeMismatch tc.diagnostics.record_error
            true return
        fi
        if actual.is_fn_type_t ! then
            "Type mismatch".to_str tc.raise_type_mismatch
            true return
        fi
        actual.clone = validated_actual
        if expected common::Parameter::typ common::Type::Function(expected_fn) is then
            if actual common::Type::Function(actual_fn) is then
                expected_fn.parameters = expected_fn_params: $std::List[common::Type]
                actual_fn.parameters = actual_fn_params: $std::List[common::Type]
                0 = param_index: u64
                while
                    param_index expected_fn_params.length <
                    param_index actual_fn_params.length < &&
                do
                    param_index expected_fn_params.get = expected_param
                    param_index actual_fn_params.get = actual_param
                    bindings actual_param expected_param rules::bind_semantic_type_arguments
                    1 += param_index
                done
                expected_fn.return_types = expected_fn_returns: $std::List[common::Type]
                actual_fn.return_types = actual_fn_returns: $std::List[common::Type]
                0 = return_index: u64
                while
                    return_index expected_fn_returns.length <
                    return_index actual_fn_returns.length < &&
                do
                    return_index expected_fn_returns.get = expected_return
                    return_index actual_fn_returns.get = actual_return
                    bindings actual_return expected_return rules::bind_semantic_type_arguments
                    1 += return_index
                done
            fi
        fi
        bindings expected.typ.substitute_t = resolved_expected
        if validated_actual resolved_expected.eq ! then
            f"Expected `{resolved_expected.format}`, got `{validated_actual.format}`".to_str tc.raise_type_mismatch
        fi
        true
    }
}

impl TypeChecker {
    pub fn stack_push_origins
        tc:mut$TypeChecker
        typ:$common::Type
        origins:std::Option[std::List[Origin]]
    {
        typ tc.stack_push_type
        tc
            .stack
            .values
            .length 1 - tc
            .stack
            .values
            .get_mut = value
        origins.clone = value.origins
        std::List[std::String]::new = visiting
        if visiting tc.store typ does_cleanup_observe_borrow then
            origins = value.cleanup_origins
        fi
    }

    fn push_value_origins
        tc:mut$TypeChecker
        typ:$common::Type
        origins:std::Option[std::List[Origin]]
        cleanup_origins:std::Option[std::List[Origin]]
    {
        typ tc.stack_push_type
        tc
            .stack
            .values
            .length 1 - tc
            .stack
            .values
            .get_mut = value
        origins = value.origins
        cleanup_origins = value.cleanup_origins
    }

    fn collect_call_origins
        tc:mut$TypeChecker
        effect:$common::StackEffect
        bindings:mut$std::Map[std::String common::Type]
        mode:$CallOriginMode
    -> std::Option[std::List[Origin]] {
        mode CallOriginMode::Exclusive is
        mode CallOriginMode::ContainedExclusive is || = exclusive
        mode CallOriginMode::ContainedShared is
        mode CallOriginMode::ContainedExclusive is || = prefer_contained_origins
        std::Option[std::List[Origin]]::None = origins
        tc
            .stack
            .values
            .length = depth
        0 = index: u64
        while index effect.parameters.length < index depth < && do
            index effect
                .parameters
                .get
                .typ = declared_parameter_type: $common::Type
            bindings declared_parameter_type.substitute_t = parameter_type
            depth 1 - index - tc
                .stack
                .values
                .get = argument: $TypedValue
            argument.origins match
                std::Option::Some(argument_origins) => {
                    for origin in argument_origins.iter do
                        if
                            exclusive !
                            origin.exclusive ||
                            parameter_type.is_exclusive_borrow argument.capability ValueCapability::Exclusive is && ||
                        then
                            exclusive origin.with_capability = adjusted
                            adjusted origins append_origin = origins
                        fi
                    done
                }
                std::Option::None => {
                }
            end
            if
                parameter_type.is_borrow
                prefer_contained_origins ! argument.origins.is_none || exclusive || &&
            then
                if argument.place std::Option::Some(place) is then
                    if exclusive ! parameter_type.is_exclusive_borrow || then
                        exclusive place origins add_origin = origins
                    fi
                fi
            fi
            1 += index
        done
        origins
    }

    # A generic wrapper-to-value call can return a borrow stored in its input,
    # such as Option[$T]::unwrap -> $T.
    fn collect_type_variable_argument_origins
        tc:$TypeChecker
        effect:$common::StackEffect
    -> std::Map[std::String std::List[Origin]] std::Map[std::String std::List[Origin]] {
        std::Map[std::String std::List[Origin]]::new = collected
        std::Map[std::String std::List[Origin]]::new = cleanup_collected
        effect stack_effect_type_variables = tracked_type_variables
        tc
            .stack
            .values
            .length = depth
        0 = index: u64
        while index effect.parameters.length < index depth < && do
            index effect
                .parameters
                .get
                .typ = parameter_type: $common::Type
            depth 1 - index - tc
                .stack
                .values
                .get = argument
            if parameter_type common::Type::TypeVar(type_variable) is then
                argument.origins type_variable.as_str collected merge_type_variable_origins
                argument.cleanup_origins type_variable.as_str cleanup_collected
                merge_type_variable_origins
                1 += index
                continue
            fi
            std::Option[std::List[Origin]]::None = contained_origins
            argument.place argument.origins contained_origins merge_contained_origins
            = contained_origins
            std::Option[std::List[Origin]]::None = contained_cleanup_origins
            argument.place argument.cleanup_origins contained_cleanup_origins
            merge_contained_origins = contained_cleanup_origins
            for type_variable in tracked_type_variables.iter do
                if type_variable.as_str parameter_type.type_contains_var then
                    contained_cleanup_origins.clone argument.origins type_variable.as_str
                    parameter_type promote_callable_return_origins = variable_cleanup_origins
                    contained_origins type_variable.as_str collected merge_type_variable_origins
                    variable_cleanup_origins type_variable.as_str cleanup_collected
                    merge_type_variable_origins
                fi
            done
            1 += index
        done
        collected cleanup_collected
    }

    # Use a conservative fallback for callable results when no body summary is
    # available. Concrete function bodies replace it with exact dependencies.
    fn collect_argument_origins
