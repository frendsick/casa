# Phase-independent meaning for resolved operations.
import "std" as std
import "common" as common

pub struct TraitMethodCandidate {
    pub method:     common::TraitMethod
    pub trait_type: common::Type
    pub effect:     common::StackEffect
}

pub fn clone_trait_method_candidate candidate:$TraitMethodCandidate -> TraitMethodCandidate {
    candidate.effect common::clone_stack_effect
    candidate.trait_type common::clone_type
    candidate.method common::clone_trait_method
    TraitMethodCandidate
}

pub fn collect_trait_method_candidates_into
    seen:std::Set[std::String]
    result:mut$std::List[TraitMethodCandidate]
    store:$common::SymbolStore
    trait_type:$common::Type
-> std::Set[std::String] {
    trait_type.match_base = trait_name
    trait_name.as_str store.traits.get_str = trait_opt
    if trait_opt.is_none then
        seen return
    fi
    trait_opt.unwrap = trait_def
    std::Map[std::String common::Type]::new = substitutions
    if trait_type.type_params std::Option::Some(arguments) is then
        for
            pair in arguments.iter trait_def
                .type_params
                .iter
                .zip
        do
            pair.second common::clone_type pair.first.clone substitutions.set
        done
    fi
    for method in trait_def.methods.iter do
        f"{trait_type.format}::{method.name}" = identity
        if identity.as_str seen.has_str ! then
            identity seen.add
            substitutions method.stack_effect common::apply_type_subs_to_stack_effect = resolved_effect
            resolved_effect trait_type common::clone_type method common::clone_trait_method TraitMethodCandidate result.push
        fi
    done
    for supertrait in trait_def.supertraits.iter do
        substitutions supertrait common::trait_bound_to_type.substitute_t = resolved_supertrait
        resolved_supertrait store result seen collect_trait_method_candidates_into = seen
    done
    seen
}

pub fn collect_trait_method_candidates
    store:$common::SymbolStore
    trait_type:$common::Type
-> std::List[TraitMethodCandidate] {
    std::List[TraitMethodCandidate]::new = result
    std::Set[std::String]::new = seen
    trait_type store result seen collect_trait_method_candidates_into drop
    result
}

pub fn trait_definition_type trait_def:$common::CasaTrait -> common::Type {
    std::List[common::Type]::new = type_arguments
    for type_parameter in trait_def.type_params.iter do
        type_parameter.clone common::Type::TypeVar type_arguments.push
    done
    type_arguments trait_def.name.clone common::GenericType common::Type::Generic
}

pub fn collect_trait_methods_into
    seen:std::Set[std::String]
    result:mut$std::List[common::TraitMethod]
    store:$common::SymbolStore
    trait_def:$common::CasaTrait
-> std::Set[std::String] {
    0 (u64) = method_index
    while method_index trait_def.methods.length > do
        method_index trait_def
            .methods
            .get_ref
            .name = method_name: $std::String
        if method_name.as_str seen.has_str ! then
            method_name.clone seen.add
            method_index trait_def.methods.get common::clone_trait_method result.push
        fi
        1 += method_index
    done
    for supertrait in trait_def.supertraits.iter do
        if supertrait.name.as_str store.traits.get_str std::Option::Some(supertrait_def) is then
            supertrait_def store result seen collect_trait_methods_into = seen
        fi
    done
    seen
}

pub fn collect_trait_methods
    store:$common::SymbolStore
    trait_def:$common::CasaTrait
-> std::List[common::TraitMethod] {
    std::List[common::TraitMethod]::new = result
    std::Set[std::String]::new = seen
    trait_def store result seen collect_trait_methods_into drop
    result
}

pub enum MethodSemanticsKind derives std::Eq std::Copy {
    Function
    TraitBound
    DefaultMethod
}

pub struct MethodSemantics {
    pub kind:          MethodSemanticsKind
    pub function_name: std::String
    pub trait_name:    std::String
    pub trait_type:    std::Option[common::Type]
    pub method_name:   std::String
    pub stack_effect:  common::StackEffect
}

impl MethodSemantics: std::Clone {
    pub fn clone self:$MethodSemantics -> MethodSemantics {
        self.stack_effect.clone self.method_name.clone self.trait_type.clone
        self.trait_name.clone self.function_name.clone self.kind make_method_semantics
    }
}

pub struct SemanticStack {
    pub types:              std::List[common::Type]
    pub callables:          std::List[std::Set[std::String]]
    pub parameters:         std::List[common::Parameter]
    pub next_parameter:     u64
    pub branches:           std::List[SemanticBranch]
    pub variables:          std::Map[std::String common::Type]
    pub variable_callables: std::Map[std::String std::Set[std::String]]
    pub infer_parameters:   bool
}

pub struct SemanticStackSnapshot {
    pub types:              std::List[common::Type]
    pub callables:          std::List[std::Set[std::String]]
    pub next_parameter:     u64
    pub variables:          std::Map[std::String common::Type]
    pub variable_callables: std::Map[std::String std::Set[std::String]]
}

pub fn clone_variable_callables
    variable_callables:$std::Map[std::String std::Set[std::String]]
    variable_name:$str
-> std::Set[std::String] {
    if variable_name variable_callables.get_str std::Option::Some(callables) is then
        callables.clone return
    fi
    std::Set[std::String]::new
}

pub enum SemanticBranchKind {
    If
    While
    Match
}

impl common::StackEffect {
    pub fn needs_inference self:$common::StackEffect -> bool {
        0 self.parameters.length == 0 self.return_types.length == &&
    }
}

pub struct SemanticBranch {
    pub kind:         SemanticBranchKind
    pub before:       std::Option[SemanticStackSnapshot]
    pub after:        std::Option[SemanticStackSnapshot]
    pub subject_type: std::Option[common::Type]
    pub active:       bool
    pub has_default:  bool
}

pub fn get_variable_root_name variable_name:$str -> std::String {
    variable_name "." str::split = name_parts
    0 name_parts.remove.unwrap
}

pub fn unify_generic_type_parameters
    type_a:$common::Type
    type_b:$common::Type
    store:$common::SymbolStore
-> std::Option[common::Type] {
    type_a.base = base_a
    type_b.base = base_b
    if base_a.is_some base_b.is_some != then
        std::Option[common::Type]::None return
    fi
    if base_a std::Option::Some(first_base) is then
        if base_b std::Option::Some(second_base) is then
            if first_base second_base != then
                std::Option[common::Type]::None return
            fi
        fi
    fi
    type_a.type_params = parameters_a_result
    type_b.type_params = parameters_b_result
    if parameters_a_result.is_none then
        type_b common::clone_type std::Option::Some return
    fi
    if parameters_b_result.is_none then
        type_a common::clone_type std::Option::Some return
    fi
    parameters_a_result.unwrap = parameters_a
    parameters_b_result.unwrap = parameters_b
    if parameters_a.length parameters_b.length != then
        std::Option[common::Type]::None return
    fi
    std::List[common::Type]::new = unified
    for pair in parameters_b.iter parameters_a.iter.zip do
        store pair.second pair.first unify_type_t match
            std::Option::Some(value) => value unified.push
            std::Option::None => {
                std::Option[common::Type]::None return
            }
        end
    done
    type_a.base = base_result
    if base_result.is_none then
        std::Option[common::Type]::None return
    fi
    base_result.unwrap = base
    unified base common::GenericType common::Type::Generic std::Option::Some
}

pub fn unify_type_t
    type_a:$common::Type
    type_b:$common::Type
    store:$common::SymbolStore
-> std::Option[common::Type] {
    if type_a type_b.eq then
        type_a common::clone_type std::Option::Some return
    fi
    if type_a.is_integer_literal_t type_b.is_integer_type_t && then
        type_b common::clone_type std::Option::Some return
    fi
    if type_b.is_integer_literal_t type_a.is_integer_type_t && then
        type_a common::clone_type std::Option::Some return
    fi
    if type_a.is_float_literal_t type_b.is_float_type_t && then
        type_b common::clone_type std::Option::Some return
    fi
    if type_b.is_float_literal_t type_a.is_float_type_t && then
        type_a common::clone_type std::Option::Some return
    fi
    if type_a.is_unknown_placeholder then
        type_b common::clone_type std::Option::Some return
    fi
    if type_b.is_unknown_placeholder then
        type_a common::clone_type std::Option::Some return
    fi
    if type_a.has_unresolved_type_var then
        type_b common::clone_type std::Option::Some return
    fi
    if type_b.has_unresolved_type_var then
        type_a common::clone_type std::Option::Some return
    fi
    type_a.base = base_a
    type_b.base = base_b
    if base_a.is_some base_b.is_some && then
        store type_b type_a unify_generic_type_parameters = generic_result
        if generic_result.is_some then
            generic_result return
        fi
    fi
    if base_a std::Option::Some(first_base_name) is then
        if first_base_name type_b.format == then
            type_a common::clone_type std::Option::Some return
        fi
    fi
    if base_b std::Option::Some(second_base_name) is then
        if second_base_name type_a.format == then
            type_b common::clone_type std::Option::Some return
        fi
    fi
    std::Option[common::Type]::None
}

impl SemanticStack {
    pub fn new function:mut$common::Function -> SemanticStack {
        std::Map[std::String common::Type]::new = variables
        std::Map[std::String std::Set[std::String]]::new = variable_callables
        for variable in function.variables.iter do
            variable.typ common::clone_type variable.name.clone variables.set
            std::Set[std::String]::new variable.name.clone variable_callables.set
        done
        for capture in function.captures.iter do
            capture.typ common::clone_type capture.name.clone variables.set
            std::Set[std::String]::new capture.name.clone variable_callables.set
        done
        function.stack_effect.needs_inference
        variable_callables
        variables
        std::List[SemanticBranch]::new
        0
        function
            .stack_effect
            .parameters
            .clone
        std::List[std::Set[std::String]]::new
        std::List[common::Type]::new
        SemanticStack
    }

    pub fn push self:mut$SemanticStack type_value:common::Type {
        std::Set[std::String]::new self.callables.push
        type_value self.types.push
    }

    pub fn set_top_callable self:mut$SemanticStack function_name:$str {
        if 0 self.callables.length == then
            return
        fi
        std::Set[std::String]::new = callable
        function_name callable.add_str
        callable self.callables.length 1 - self.callables.set
    }

    pub fn set_top_callables self:mut$SemanticStack callables:std::Set[std::String] {
        if 0 self.callables.length == then
            return
        fi
        callables self.callables.length 1 - self.callables.set
    }

    pub fn set_return_callables
        self:mut$SemanticStack
        return_callables:$std::List[std::Set[std::String]]
    {
        if self.callables.length return_callables.length > then
            return
        fi
        self.callables.length return_callables.length - = start
        0 = index: u64
        while index return_callables.length > do
            index return_callables.get.clone start index + self.callables.set
            1 += index
        done
    }

    pub fn seed_parameter_callables
        self:mut$SemanticStack
        argument_callables:$std::Map[std::String std::Set[std::String]]
    {
        for pair in argument_callables.iter do
            pair.second.clone pair.first.clone self.variable_callables.set
        done
    }

    pub fn peek_callables self:mut$SemanticStack -> std::Set[std::String] {
        if 0 self.callables.length == then
            std::Set[std::String]::new return
        fi
        self.callables.length 1 - self
            .callables
            .get
            .clone
    }

    pub fn peek self:mut$SemanticStack -> std::Option[common::Type] {
        if 0 self.types.length != then
            self.types.length 1 - self.types.get common::clone_type std::Option::Some return
        fi
        if self.next_parameter self.parameters.length > then
            self.next_parameter self
                .parameters
                .get
                .typ common::clone_type std::Option::Some return
        fi
        if self.infer_parameters then
            common::make_unknown_type common::clone_type std::Option::Some return
        fi
        std::Option[common::Type]::None
    }

    pub fn pop self:mut$SemanticStack -> std::Option[common::Type] {
        if 0 self.types.length != then
            self.callables.pop drop
            self.types.pop std::Option::Some return
        fi
        if self.next_parameter self.parameters.length > then
            self.next_parameter self
                .parameters
                .get
                .typ common::clone_type = parameter_type
            1 += self.next_parameter
            parameter_type std::Option::Some return
        fi
        if self.infer_parameters then
            common::make_unknown_type common::clone_type common::Parameter::new self.parameters.push
            1 += self.next_parameter
            common::make_unknown_type common::clone_type std::Option::Some return
        fi
        std::Option[common::Type]::None
    }

    pub fn drop_count self:mut$SemanticStack count:u64 {
        0 (u64) = index
        while index count > do
            self.pop drop
            1 += index
        done
    }
}

impl SemanticStack {
    pub fn apply_effect_with_bindings
        self:mut$SemanticStack
        effect:$common::StackEffect
    -> std::Map[std::String common::Type] {
        std::Map[std::String common::Type]::new = bindings
        for parameter in effect.parameters.iter do
            if parameter.name.as_str common::is_hidden_parameter_name then
                continue
            fi
            if self.pop std::Option::Some(actual_type) is then
                bindings actual_type parameter.typ bind_semantic_type_arguments
            fi
        done
        for return_type in effect.return_types.iter do
            bindings return_type.substitute_t self.push
        done
        bindings
    }

    pub fn apply_result self:mut$SemanticStack consumed:u64 result_type:common::Type {
        consumed self.drop_count
        result_type self.push
    }

    pub fn clone_variables self:mut$SemanticStack -> std::Map[std::String common::Type] {
        std::Map[std::String common::Type]::new = cloned
        for pair in self.variables.iter do
            pair.second common::clone_type pair.first.clone cloned.set
        done
        cloned
    }

    pub fn snapshot self:mut$SemanticStack -> SemanticStackSnapshot {
        self.variable_callables.clone
        self.clone_variables
        self.next_parameter
        self.callables.clone
        self.types.clone
        SemanticStackSnapshot
    }

    pub fn restore self:mut$SemanticStack snapshot:$SemanticStackSnapshot {
        snapshot.types.clone = self.types
        snapshot.callables.clone = self.callables
        snapshot.next_parameter = self.next_parameter
        snapshot.variable_callables.clone = self.variable_callables
        std::Map[std::String common::Type]::new = self.variables
        for pair in snapshot.variables.iter do
            pair.second common::clone_type pair.first.clone self.variables.set
        done
    }

    pub fn restore_callable_shuffle
        self:mut$SemanticStack
        operation:$common::OpValue
        before:std::List[std::Set[std::String]]
    {
        before = restored
        if operation common::OpValue::Dup is then
            if 0 restored.length == then
                return
            fi
            restored.pop = top
            top.clone restored.push
            top restored.push
        elif operation common::OpValue::Copy is then
            if 0 restored.length == then
                return
            fi
        elif operation common::OpValue::Swap is then
            if 2 restored.length < then
                return
            fi
            restored.pop = top
            restored.pop = second
            top restored.push
            second restored.push
        elif operation common::OpValue::Over is then
            if 2 restored.length < then
                return
            fi
            restored.pop = top
            restored.pop = second
            second.clone restored.push
            top restored.push
            second restored.push
        elif operation common::OpValue::Rot is then
            if 3 restored.length < then
                return
            fi
            restored.pop = top
            restored.pop = middle
            restored.pop = bottom
            middle restored.push
            top restored.push
            bottom restored.push
        else
            return
        fi
        restored = self.callables
    }

    pub fn start_branch
        self:mut$SemanticStack
        subject_type:mut$std::Option[common::Type]
        kind:SemanticBranchKind
        capture_now:bool
    {
        std::Option[SemanticStackSnapshot]::None = before
        if capture_now then
            self.snapshot std::Option::Some = before
        fi
        false
        false
        subject_type.clone
        std::Option[SemanticStackSnapshot]::None
        before
        kind
        SemanticBranch = branch
        branch self.branches.push
    }

    pub fn capture_branch_entry self:mut$SemanticStack {
        if 0 self.branches.length == then
            return
        fi
        self.branches.length 1 - self.branches.get_mut = branch
        if branch.before std::Option::None is then
            self.snapshot std::Option::Some = branch.before
        fi
    }

    pub fn restore_branch_entry self:mut$SemanticStack {
        if 0 self.branches.length == then
            return
        fi
        self.branches.length 1 - self.branches.get = branch
        if branch.before std::Option::Some(before) is then
            before self.restore
        fi
    }

    pub fn end_loop self:mut$SemanticStack {
        if 0 self.branches.length == then
            return
        fi
        self.branches.pop = branch
        if branch.kind SemanticBranchKind::While is then
            if branch.before std::Option::Some(before) is then
                before self.restore
            fi
        fi
    }

    pub fn end_branch self:mut$SemanticStack {
        if 0 self.branches.length != then
            self.branches.pop drop
        fi
    }

    pub fn get_branch_subject self:mut$SemanticStack -> std::Option[common::Type] {
        if 0 self.branches.length != then
            self.branches.length 1 - self
                .branches
                .get
                .subject_type
                .clone return
        fi
        std::Option[common::Type]::None
    }

    pub fn get_variable_type
        self:mut$SemanticStack
        variable_name:$str
    -> std::Option[common::Type] {
        variable_name get_variable_root_name self.variables.get = variable_type
        if variable_type std::Option::Some(value) is then
            value common::clone_type std::Option::Some
        else
            std::Option[common::Type]::None
        fi
    }

    pub fn assign_variable_type
        self:mut$SemanticStack
        variable_name:$str
        type_result:std::Option[common::Type]
    {
        variable_name "." str::split = name_parts
        if 1 name_parts.length != then
            return
        fi
        if type_result std::Option::Some(type_value) is then
            type_value common::clone_type variable_name.clone self.variables.set_str
        fi
    }

    pub fn assign_variable_callables
        self:mut$SemanticStack
        variable_name:$str
        callables:std::Set[std::String]
    {
        variable_name "." str::split = name_parts
        if 1 name_parts.length != then
            return
        fi
        callables variable_name.clone self.variable_callables.set_str
    }
}

pub struct SemanticFacts {
    pub stack_effect:           std::Option[common::StackEffect]
    pub resolved_operation:     std::Option[common::OpValue]
    pub method:                 std::Option[MethodSemantics]
    pub dependencies:           std::List[std::String]
    pub syscall_argument_count: std::Option[u64]
    pub word_parameter_start:   u64
    pub word_parameter_count:   u64
}

impl SemanticFacts {
    pub fn new -> SemanticFacts {
        0
        0
        std::Option[u64]::None
        std::List[std::String]::new
        std::Option[MethodSemantics]::None
        std::Option[common::OpValue]::None
        std::Option[common::StackEffect]::None
        SemanticFacts
    }

    pub fn into_stack_effect self:SemanticFacts -> std::Option[common::StackEffect] {
        self match
            SemanticFacts { stack_effect: stack_effect resolved_operation: resolved_operation method: method dependencies: dependencies syscall_argument_count: syscall_argument_count word_parameter_start: word_parameter_start word_parameter_count: word_parameter_count } => stack_effect
        end
    }

    pub fn into_method self:SemanticFacts -> std::Option[MethodSemantics] {
        self match
            SemanticFacts { stack_effect: stack_effect resolved_operation: resolved_operation method: method dependencies: dependencies syscall_argument_count: syscall_argument_count word_parameter_start: word_parameter_start word_parameter_count: word_parameter_count } => method
        end
    }
}

pub fn make_operation_stack_effect
    parameters:std::List[common::Parameter]
    return_types:std::List[common::Type]
    type_variables:$std::List[std::String]
-> common::StackEffect {
    return_types parameters common::StackEffect::new = effect
    for type_variable in type_variables.iter do
        type_variable.clone effect.type_vars.add
    done
    effect
}

pub fn add_parameter parameters:mut$std::List[common::Parameter] typ:$common::Type {
    typ common::clone_type common::Parameter::new parameters.push
}

pub fn add_named_parameter parameters:mut$std::List[common::Parameter] typ:$common::Type name:$str {
    name.to_str typ common::clone_type common::Parameter::named parameters.push
}

pub fn operation_is_comparison operation:$common::OpValue -> bool {
    operation match
        common::OpValue::Eq => true
        common::OpValue::Ne => true
        common::OpValue::Lt => true
        common::OpValue::Le => true
        common::OpValue::Gt => true
        common::OpValue::Ge => true
        _ => false
    end
}

pub fn operation_is_load operation:$common::OpValue -> bool {
    operation match
        common::OpValue::Load8 => true
        common::OpValue::Load16 => true
        common::OpValue::Load32 => true
        common::OpValue::Load64 => true
        _ => false
    end
}

pub fn operation_is_store operation:$common::OpValue -> bool {
    operation match
        common::OpValue::Store8 => true
        common::OpValue::Store16 => true
        common::OpValue::Store32 => true
        common::OpValue::Store64 => true
        _ => false
    end
}

pub fn operation_is_memory operation:$common::OpValue -> bool {
    if operation operation_is_load then
        true return
    fi
    if operation operation_is_store then
        true return
    fi
    operation common::OpValue::HeapAlloc is
    operation common::OpValue::HeapFree is ||
    operation common::OpValue::PtrAsRef is ||
    operation common::OpValue::PtrAsMut is ||
    operation common::OpValue::PtrIntoRaw is ||
    operation common::OpValue::PtrRead is ||
    operation common::OpValue::PtrWrite is ||
}

pub fn fixed_operation_stack_effect operation:$common::OpValue -> std::Option[common::StackEffect] {
    std::List[common::Type]::new = return_types
    std::List[common::Parameter]::new = parameter_types
    std::List[std::String]::new = type_variables
    "T".to_str common::Type::TypeVar = type_t
    "U".to_str common::Type::TypeVar = type_u
    false = handled
    common::make_u64_type common::clone_type = memory_integer_type
    if operation common::OpValue::Load8 is operation common::OpValue::Store8 is || then
        common::make_u8_type common::clone_type = memory_integer_type
    elif operation common::OpValue::Load16 is operation common::OpValue::Store16 is || then
        common::make_u16_type common::clone_type = memory_integer_type
    elif operation common::OpValue::Load32 is operation common::OpValue::Store32 is || then
        common::make_u32_type common::clone_type = memory_integer_type
    fi

    if operation operation_is_comparison then
        type_t parameter_types add_parameter
        type_t parameter_types add_parameter
        common::make_bool_type common::clone_type return_types.push
        "T".to_str type_variables.push
        type_variables return_types parameter_types make_operation_stack_effect std::Option::Some
        return
    fi
    if operation operation_is_load then
        common::make_ptr_type parameter_types add_parameter
        memory_integer_type common::clone_type return_types.push
        type_variables return_types parameter_types make_operation_stack_effect std::Option::Some
        return
    fi
    if operation operation_is_store then
        common::make_ptr_type parameter_types add_parameter
        memory_integer_type parameter_types add_parameter
        type_variables return_types parameter_types make_operation_stack_effect std::Option::Some
        return
    fi
    if operation common::OpValue::PtrRead(target_type) is then
        common::make_ptr_type parameter_types add_parameter
        target_type common::clone_type return_types.push
        type_variables return_types parameter_types make_operation_stack_effect std::Option::Some
        return
    fi
    if operation common::OpValue::PtrIntoRaw is then
        type_t parameter_types add_parameter
        common::make_ptr_type common::clone_type return_types.push
        "T".to_str type_variables.push
        type_variables return_types parameter_types make_operation_stack_effect std::Option::Some
        return
    fi
    if operation common::OpValue::PtrAsRef(target_type) is then
        common::make_ptr_type parameter_types add_parameter
        "" common::SHARED_BORROW_TYPE target_type common::clone_type common::apply_borrow_type return_types.push
        type_variables return_types parameter_types make_operation_stack_effect std::Option::Some
        return
    fi
    if operation common::OpValue::PtrAsMut(target_type) is then
        common::make_ptr_type parameter_types add_parameter
        "" common::EXCLUSIVE_BORROW_TYPE target_type common::clone_type common::apply_borrow_type return_types.push
        type_variables return_types parameter_types make_operation_stack_effect std::Option::Some
        return
    fi
    if operation common::OpValue::PtrWrite(target_type) is then
        common::make_ptr_type parameter_types add_parameter
        target_type parameter_types add_parameter
        type_variables return_types parameter_types make_operation_stack_effect std::Option::Some
        return
    fi

    operation match
        common::OpValue::PushInt(_) => {
            common::make_i64_type common::clone_type return_types.push true = handled
        }
        common::OpValue::PushFloat(_) => {
            common::make_f64_type common::clone_type return_types.push true = handled
        }
        common::OpValue::PushStr(_) => {
            common::make_str_type common::clone_type return_types.push true = handled
        }
        common::OpValue::PushBool(_) => {
            common::make_bool_type common::clone_type return_types.push true = handled
        }
        common::OpValue::PushChar(_) => {
            common::make_char_type common::clone_type return_types.push true = handled
        }
        common::OpValue::Argc => {
            common::make_u64_type common::clone_type return_types.push true = handled
        }
        common::OpValue::Argv => {
            common::make_ptr_type common::clone_type return_types.push true = handled
        }
        common::OpValue::Envp => {
            common::make_ptr_type common::clone_type return_types.push true = handled
        }
        common::OpValue::Mul => {
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type common::clone_type return_types.push
            true = handled
        }
        common::OpValue::Div => {
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type common::clone_type return_types.push
            true = handled
        }
        common::OpValue::Mod => {
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type common::clone_type return_types.push
            true = handled
        }
        common::OpValue::BitAnd => {
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type common::clone_type return_types.push
            true = handled
        }
        common::OpValue::BitOr => {
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type common::clone_type return_types.push
            true = handled
        }
        common::OpValue::BitXor => {
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type common::clone_type return_types.push
            true = handled
        }
        common::OpValue::Add => {
            common::make_i64_type parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T".to_str type_variables.push
            true = handled
        }
        common::OpValue::Sub => {
            common::make_i64_type parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T".to_str type_variables.push
            true = handled
        }
        common::OpValue::Shl => {
            common::make_i64_type parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T".to_str type_variables.push
            true = handled
        }
        common::OpValue::Shr => {
            common::make_i64_type parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T".to_str type_variables.push
            true = handled
        }
        common::OpValue::And => {
            type_t parameter_types add_parameter
            type_u parameter_types add_parameter
            common::make_bool_type common::clone_type return_types.push
            "T".to_str type_variables.push
            "U".to_str type_variables.push
            true = handled
        }
        common::OpValue::Or => {
            type_t parameter_types add_parameter
            type_u parameter_types add_parameter
            common::make_bool_type common::clone_type return_types.push
            "T".to_str type_variables.push
            "U".to_str type_variables.push
            true = handled
        }
        common::OpValue::Not => {
            type_t parameter_types add_parameter
            common::make_bool_type common::clone_type return_types.push
            "T".to_str type_variables.push
            true = handled
        }
        common::OpValue::BitNot => {
            common::make_i64_type parameter_types add_parameter
            common::make_i64_type common::clone_type return_types.push
            true = handled
        }
        common::OpValue::Drop => {
            "value for `drop`" type_t parameter_types add_named_parameter
            "T".to_str type_variables.push
            true = handled
        }
        common::OpValue::Dup => {
            "value for `dup`" type_t parameter_types add_named_parameter
            type_t common::clone_type return_types.push
            type_t common::clone_type return_types.push
            "T".to_str type_variables.push
            true = handled
        }
        common::OpValue::Copy => {
            common::SHARED_BORROW_TYPE type_t common::clone_type common::apply_borrow_type
            = borrowed_type
            "value for `copy`" borrowed_type parameter_types add_named_parameter
            type_t common::clone_type return_types.push
            "T".to_str type_variables.push
            true = handled
        }
        common::OpValue::Swap => {
            "argument 1 of `swap`" type_t parameter_types add_named_parameter
            "argument 2 of `swap`" type_u parameter_types add_named_parameter
            type_t common::clone_type return_types.push
            type_u common::clone_type return_types.push
            "T".to_str type_variables.push
            "U".to_str type_variables.push
            true = handled
        }
        common::OpValue::Over => {
            "argument 1 of `over`" type_t parameter_types add_named_parameter
            "argument 2 of `over`" type_u parameter_types add_named_parameter
            type_u common::clone_type return_types.push
            type_t common::clone_type return_types.push
            type_u common::clone_type return_types.push
            "T".to_str type_variables.push
            "U".to_str type_variables.push
            true = handled
        }
        common::OpValue::Rot => {
            "V".to_str common::Type::TypeVar = type_v
            "argument 1 of `rot`" type_t parameter_types add_named_parameter
            "argument 2 of `rot`" type_u parameter_types add_named_parameter
            "argument 3 of `rot`" type_v parameter_types add_named_parameter
            type_u return_types.push
            type_t return_types.push
            type_v return_types.push
            "T".to_str type_variables.push
            "U".to_str type_variables.push
            "V".to_str type_variables.push
            true = handled
        }
        common::OpValue::Print => {
            type_t parameter_types add_parameter
            "T".to_str type_variables.push
            true = handled
        }
        common::OpValue::PrintBool => {
            common::make_bool_type parameter_types add_parameter true = handled
        }
        common::OpValue::PrintChar => {
            common::make_char_type parameter_types add_parameter true = handled
        }
        common::OpValue::PrintCstr => {
            common::make_cstr_type parameter_types add_parameter true = handled
        }
        common::OpValue::PrintInt => {
            common::make_i64_type parameter_types add_parameter true = handled
        }
        common::OpValue::PrintStr => {
            common::make_str_type parameter_types add_parameter true = handled
        }
        common::OpValue::PrintString => {
            common::make_string_type parameter_types add_parameter true = handled
        }
        common::OpValue::FstringToStr => {
            type_t parameter_types add_parameter
            common::make_string_type common::clone_type return_types.push
            "T".to_str type_variables.push
            true = handled
        }
        common::OpValue::PrimitiveToStr(builtin) => {
            builtin (i64) (common::BuiltinType) common::Type::Builtin parameter_types add_parameter
            common::make_string_type common::clone_type return_types.push
            true = handled
        }
        common::OpValue::FstringConcat(count) => {
            0 (u64) = index
            while index count > do
                common::make_string_type parameter_types add_parameter
                1 += index
            done
            common::make_string_type common::clone_type return_types.push
            true = handled
        }
        common::OpValue::Typeof => {
            type_t parameter_types add_parameter
            common::make_str_type common::clone_type return_types.push
            "T".to_str type_variables.push
            true = handled
        }
        common::OpValue::SizeOf(_) => {
            common::make_u64_type common::clone_type return_types.push
            true = handled
        }
        common::OpValue::HeapAlloc => {
            common::make_u64_type parameter_types add_parameter
            common::make_ptr_type common::clone_type return_types.push
            true = handled
        }
        common::OpValue::HeapFree => {
            common::make_ptr_type parameter_types add_parameter true = handled
        }
        _ => {
        }
    end

    if handled ! then
        std::Option[common::StackEffect]::None return
    fi
    type_variables return_types parameter_types make_operation_stack_effect = effect
    "" = copy_type_variable
    if operation common::OpValue::Dup is operation common::OpValue::Copy is || then
        "T" = copy_type_variable
    elif operation common::OpValue::Over is then
        "U" = copy_type_variable
    fi
    if "" copy_type_variable != then
        std::List[common::TraitBound]::new = copy_bounds
        std::List[common::Type]::new common::STD_COPY_TRAIT.to_str common::TraitBound copy_bounds.push
        copy_bounds copy_type_variable effect.trait_bounds.set_str
    fi
    effect std::Option::Some
}

pub fn operation_uses_fixed_typecheck_effect operation:$common::OpValue -> bool {
    operation match
        common::OpValue::PushStr(_) => true
        common::OpValue::PushBool(_) => true
        common::OpValue::PushChar(_) => true
        common::OpValue::Argc => true
        common::OpValue::Argv => true
        common::OpValue::Envp => true
        common::OpValue::And => true
        common::OpValue::Or => true
        common::OpValue::Not => true
        common::OpValue::Drop => true
        common::OpValue::Dup => true
        common::OpValue::Copy => true
        common::OpValue::Swap => true
        common::OpValue::Over => true
        common::OpValue::Rot => true
        common::OpValue::FstringConcat(_) => true
        _ => false
    end
}
# Build the canonical control-flow rewrite for a resolved `?` operation.

pub fn lower_question_operations
    ops:mut$std::List[common::Op]
    insert_index:u64
    location:common::Location
    hidden_name:std::String
    return_type:common::Type
{
    location.clone common::OpValue::IfStart common::Op::new = injected
    insert_index injected ops.insert
    1 += insert_index
    location.clone hidden_name.clone common::OpValue::PushVar common::Op::new = injected
    insert_index injected ops.insert
    1 += insert_index
    location.clone "is_ok".to_str common::OpValue::MethodCall common::Op::new = injected
    insert_index injected ops.insert
    1 += insert_index
    location.clone common::OpValue::Not common::Op::new = injected
    insert_index injected ops.insert
    1 += insert_index
    location.clone common::OpValue::IfCondition common::Op::new = injected
    insert_index injected ops.insert
    1 += insert_index
    location.clone hidden_name.clone common::OpValue::PushVar common::Op::new = injected
    insert_index injected ops.insert
    1 += insert_index
    location.clone "propagate".to_str common::OpValue::MethodCall common::Op::new = propagate
    return_type std::Option::Some propagate common::Op::set_type_hint
    insert_index propagate ops.insert
    1 += insert_index
    location.clone hidden_name.clone common::OpValue::QuestionMove common::Op::new = injected
    insert_index injected ops.insert
    1 += insert_index
    location.clone common::OpValue::FnReturn common::Op::new = injected
    insert_index injected ops.insert
    1 += insert_index
    location.clone common::OpValue::IfEnd common::Op::new = injected
    insert_index injected ops.insert
    1 += insert_index
    location.clone hidden_name.clone common::OpValue::PushVar common::Op::new = injected
    insert_index injected ops.insert
    1 += insert_index
    location.clone "unwrap".to_str common::OpValue::MethodCall common::Op::new = injected
    insert_index injected ops.insert
    1 += insert_index
    location hidden_name common::OpValue::QuestionMove common::Op::new = injected
    insert_index injected ops.insert
}

pub fn operation_syscall_argument_count operation:$common::OpValue -> std::Option[u64] {
    operation match
        common::OpValue::Syscall0 => 0 (u64) std::Option::Some
        common::OpValue::Syscall1 => 1 (u64) std::Option::Some
        common::OpValue::Syscall2 => 2 (u64) std::Option::Some
        common::OpValue::Syscall3 => 3 (u64) std::Option::Some
        common::OpValue::Syscall4 => 4 (u64) std::Option::Some
        common::OpValue::Syscall5 => 5 (u64) std::Option::Some
        common::OpValue::Syscall6 => 6 (u64) std::Option::Some
        _ => std::Option[u64]::None
    end
}

pub fn make_syscall_stack_effect argument_count:u64 -> common::StackEffect {
    std::List[common::Type]::new = return_types
    std::List[common::Parameter]::new = parameter_types
    common::make_i64_type parameter_types add_parameter
    0 (u64) = index
    while index argument_count > do
        common::make_unknown_type parameter_types add_parameter
        1 += index
    done
    common::make_i64_type common::clone_type return_types.push
    std::List[std::String]::new return_types parameter_types make_operation_stack_effect
}

pub fn make_function_reference_stack_effect effect:$common::StackEffect -> common::StackEffect {
    std::List[common::Type]::new = return_types
    effect common::stack_effect_to_function_type return_types.push
    std::List[std::String]::new return_types std::List[common::Parameter]::new
    make_operation_stack_effect
}

impl common::Type {
    pub fn make_method_key self:$common::Type method_name:$str -> std::String {
        f"{self.format}::{method_name}"
    }

    pub fn make_base_method_key self:$common::Type method_name:$str -> std::Option[std::String] {
        if self.base std::Option::Some(base) is then
            f"{base}::{method_name}" std::Option::Some return
        fi
        std::Option[std::String]::None
    }
}

pub fn find_semantic_method_function
    method_name:$str
    receiver:$common::Type
    store:$common::SymbolStore
-> std::Option[std::String] {
    receiver common::clone_type = receiver_type
    method_name receiver_type.make_method_key = exact_name
    if exact_name.as_str store.get_function std::Option::Some(function) is then
        function.name.clone std::Option::Some return
    fi
    if receiver.borrow_target std::Option::Some(target) is then
        target common::clone_type = receiver_type
    fi
    method_name receiver_type.make_method_key = function_name
    if function_name.as_str store.get_function std::Option::Some(function) is then
        function.name.clone std::Option::Some return
    fi
    if method_name receiver_type.make_base_method_key std::Option::Some(base_name) is then
        if base_name.as_str store.get_function std::Option::Some(function) is then
            function.name.clone std::Option::Some return
        fi
    fi
    std::Option[std::String]::None
}

pub fn find_semantic_trait_method
    method_name:$str
    casa_trait:$common::CasaTrait
    store:$common::SymbolStore
-> std::Option[common::TraitMethod] {
    casa_trait store collect_trait_methods = methods
    for method in methods.iter do
        if method_name method.name.as_str == then
            method.clone std::Option::Some return
        fi
    done
    std::Option[common::TraitMethod]::None
}

pub fn type_has_semantic_trait_shape
    receiver:$common::Type
    trait_type:$common::Type
    store:$common::SymbolStore
-> bool {
    trait_type store collect_trait_method_candidates = candidates
    for candidate in candidates.iter do
        if
            0 candidate
                .method
                .default_ops
                .length ==
        then
            store receiver trait_type candidate
                .method
                .name
                .as_str resolve_qualified_method_semantics
            = method_opt
            if method_opt.is_none then
                false return
            fi
        fi
    done
    true
}

pub fn bind_semantic_type_arguments
    expected:$common::Type
    actual:$common::Type
    bindings:mut$std::Map[std::String common::Type]
{
    expected match
        common::Type::TypeVar(type_variable) => {
            if type_variable bindings.has ! then
                actual common::clone_type type_variable.clone bindings.set
            fi
        }
        common::Type::Const(expected_const) => {
            if expected_const.is_symbolic expected_const.name bindings.has ! && then
                actual common::clone_type expected_const.name.clone bindings.set
            fi
        }
        common::Type::Generic(expected_generic) => {
            if actual common::Type::Generic(actual_generic) is then
                if expected_generic.base actual_generic.base == then
                    for
                        pair in actual_generic.params.iter expected_generic
                            .params
                            .iter
                            .zip
                    do
                        bindings pair.second pair.first bind_semantic_type_arguments
                    done
                fi
            fi
        }
        common::Type::Function(expected_function) => {
            if actual common::Type::Function(actual_function) is then
                for
                    pair in actual_function.parameters.iter expected_function
                        .parameters
                        .iter
                        .zip
                do
                    bindings pair.second pair.first bind_semantic_type_arguments
                done
                actual_function.return_types.iter expected_function
                    .return_types
                    .iter
                    .zip
                = return_type_pairs
                for pair in return_type_pairs do
                    bindings pair.second pair.first bind_semantic_type_arguments
                done
            fi
        }
        _ => {
        }
    end
}

pub fn make_bound_substitutions
    bound:$common::TraitBound
    casa_trait:$common::CasaTrait
-> std::Map[std::String common::Type] {
    std::Map[std::String common::Type]::new = substitutions
    if bound.type_args.length casa_trait.type_params.length == then
        for
            pair in bound.type_args.iter casa_trait
                .type_params
                .iter
                .zip
        do
            pair.second common::clone_type pair.first.clone substitutions.set
        done
    fi
    substitutions
}

pub fn bind_trait_impl_type
    pattern:$common::Type
    actual:$common::Type
    bindings:mut$std::Map[std::String common::Type]
-> bool {
    # A symbolic constant parameter binds the argument in that position the way
    # a type variable binds a type (ADR-0152).
    if pattern common::Type::Const(pattern_const) is then
        if pattern_const.is_symbolic then
            if pattern_const.name bindings.get std::Option::Some(bound_const) is then
                actual bound_const.eq return
            fi
            actual common::clone_type pattern_const.name.clone bindings.set
            true return
        fi
        pattern actual.eq return
    fi
    if pattern common::Type::TypeVar(type_variable) is then
        if type_variable bindings.get std::Option::Some(bound_type) is then
            actual bound_type.eq return
        fi
        actual common::clone_type type_variable.clone bindings.set
        true return
    fi
    if pattern common::Type::Generic(pattern_generic) is then
        if actual common::Type::Generic(actual_generic) is then
            if pattern_generic.base actual_generic.base != then
                false return
            fi
            if pattern_generic.params.length actual_generic.params.length != then
                false return
            fi
            for
                pair in actual_generic.params.iter pattern_generic
                    .params
                    .iter
                    .zip
            do
                if bindings pair.second pair.first bind_trait_impl_type ! then
                    false return
                fi
            done
            true return
        fi
        false return
    fi
    if pattern common::Type::Function(pattern_function) is then
        if actual common::Type::Function(actual_function) is then
            if pattern_function.parameters.length actual_function.parameters.length != then
                false return
            fi
            if pattern_function.return_types.length actual_function.return_types.length != then
                false return
            fi
            for
                pair in actual_function.parameters.iter pattern_function
                    .parameters
                    .iter
                    .zip
            do
                if bindings pair.second pair.first bind_trait_impl_type ! then
                    false return
                fi
            done
            for
                pair in actual_function.return_types.iter pattern_function
                    .return_types
                    .iter
                    .zip
            do
                if bindings pair.second pair.first bind_trait_impl_type ! then
                    false return
                fi
            done
            true return
        fi
        false return
    fi
    pattern actual.eq
}

pub fn resolve_trait_impl_bound
    bound:$common::TraitBound
    bindings:$std::Map[std::String common::Type]
-> common::Type {
    bindings bound common::trait_bound_to_type.substitute_t
}

pub fn trait_impl_receiver_may_match pattern:$common::Type actual:$common::Type -> bool {
    if pattern common::Type::TypeVar(_) is then
        true return
    fi
    if pattern common::Type::Generic(pattern_generic) is then
        if actual common::Type::Generic(actual_generic) is then
            pattern_generic.base actual_generic.base == return
        fi
        false return
    fi
    if pattern common::Type::Builtin(pattern_builtin) is then
        if actual common::Type::Builtin(actual_builtin) is then
            pattern_builtin actual_builtin == return
        fi
        false return
    fi
    if pattern common::Type::Function(pattern_function) is then
        if actual common::Type::Function(actual_function) is then
            true return
        fi
    fi
    false
}

pub fn trait_type_implies
    direct:$common::Type
    target:$common::Type
    store:$common::SymbolStore
-> bool {
    if direct target.eq then
        true return
    fi
    direct.match_base store.traits.get = direct_trait_opt
    if direct_trait_opt.is_none then
        false return
    fi
    direct_trait_opt.unwrap = direct_trait
    std::Map[std::String common::Type]::new = substitutions
    if direct.type_params std::Option::Some(direct_arguments) is then
        for
            pair in direct_arguments.iter direct_trait
                .type_params
                .iter
                .zip
        do
            pair.second common::clone_type pair.first.clone substitutions.set
        done
    fi
    for supertrait in direct_trait.supertraits.iter do
        substitutions supertrait common::trait_bound_to_type.substitute_t = resolved_supertrait
        if store target resolved_supertrait trait_type_implies then
            true return
        fi
    done
    false
}

pub fn trait_impl_constraints_hold
    trait_impl:$common::TraitImpl
    bindings:mut$std::Map[std::String common::Type]
    store:$common::SymbolStore
-> bool {
    for
        type_variable in trait_impl
            .trait_bounds
            .keys
            .iter
    do
        if type_variable bindings.remove std::Option::Some(concrete_type) is then
            for
                bound in type_variable trait_impl
                    .trait_bounds
                    .get
                    .unwrap
                    .iter
            do
                bindings bound resolve_trait_impl_bound = resolved_bound
                if store resolved_bound concrete_type type_has_satisfying_trait_impl ! then
                    concrete_type common::clone_type type_variable.clone bindings.set
                    false return
                fi
            done
            concrete_type common::clone_type type_variable.clone bindings.set
        else
            false return
        fi
    done
    true
}

pub fn resolve_applicable_trait_impl
    receiver:$common::Type
    trait_impl:$common::TraitImpl
    store:$common::SymbolStore
-> std::Option[common::Type] {
    std::Map[std::String common::Type]::new = bindings
    if bindings receiver trait_impl.receiver bind_trait_impl_type ! then
        std::Option[common::Type]::None return
    fi
    if store bindings trait_impl trait_impl_constraints_hold ! then
        std::Option[common::Type]::None return
    fi
    bindings trait_impl.trait_bound resolve_trait_impl_bound std::Option::Some
}

pub fn trait_type_has_method
    trait_type:$common::Type
    method_name:$str
    store:$common::SymbolStore
-> bool {
    trait_type store collect_trait_method_candidates = candidates
    for candidate in candidates.iter do
        if
            method_name candidate
                .method
                .name
                .as_str ==
        then
            true return
        fi
    done
    false
}

pub fn find_trait_default_method
    method_name:$str
    trait_type:$common::Type
    store:$common::SymbolStore
-> std::Option[TraitMethodCandidate] {
    std::Option[TraitMethodCandidate]::None = found
    false = has_direct_declaration
    trait_type store collect_trait_method_candidates = candidates
    0 (u64) = candidate_index
    while candidate_index candidates.length > do
        candidate_index candidates.get_ref = candidate
        1 += candidate_index
        if
            method_name candidate
                .method
                .name
                .as_str !=
        then
            continue
        fi
        if candidate.trait_type trait_type.eq ! then
            continue
        fi
        true = has_direct_declaration
        if
            0 candidate
                .method
                .default_ops
                .length !=
        then
            candidate_index 1 - candidates.get clone_trait_method_candidate std::Option::Some = found
        fi
    done
    if has_direct_declaration then
        found return
    fi
    0 (u64) = default_index
    while default_index candidates.length > do
        default_index candidates.get_ref = candidate
        1 += default_index
        if
            method_name candidate
                .method
                .name
                .as_str ==
            0 candidate
                .method
                .default_ops
                .length != &&
        then
            if found.is_some then
                std::Option[TraitMethodCandidate]::None return
            fi
            default_index 1 - candidates.get clone_trait_method_candidate std::Option::Some = found
        fi
    done
    found
}

pub fn type_has_satisfying_trait_impl
    receiver:$common::Type
    trait_type:$common::Type
    store:$common::SymbolStore
-> bool {
    if receiver.is_borrow then
        if
            common::STD_COPY_TRAIT trait_type.match_base.as_str ==
            common::STD_CLONE_TRAIT trait_type.match_base.as_str == ||
        then
            false return
        fi
    fi
    if common::STD_COPY_TRAIT trait_type.match_base.as_str == then
        if receiver common::Type::Builtin(builtin) is then
            if builtin common::BuiltinType::Str != then
                true return
            fi
        elif receiver common::Type::Function(_) is then
            true return
        fi
    fi
    if
        common::STD_CLONE_TRAIT trait_type.match_base.as_str == receiver common::Type::Function(_) is &&
    then
        common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
        if store trait_type copy_type trait_type_implies then
            true return
        fi
    fi
    for pair in store.trait_impls.iter do
        pair.second = trait_impl: $common::TraitImpl
        if trait_impl.receiver receiver trait_impl_receiver_may_match ! then
            continue
        fi
        std::Map[std::String common::Type]::new = bindings
        if bindings receiver trait_impl.receiver bind_trait_impl_type ! then
            continue
        fi
        bindings trait_impl.trait_bound resolve_trait_impl_bound = implemented_trait
        if store trait_type implemented_trait trait_type_implies ! then
            continue
        fi
        if store bindings trait_impl trait_impl_constraints_hold then
            true return
        fi
    done
    false
}

