impl TypeChecker {
    pub fn apply_stack_reordering tc:mut$TypeChecker op:mut$common::Op -> bool {
        tc
            .stack
            .values
            .length = depth
        if op.value common::OpValue::Dup is then
            if 1 depth > then
                false return
            fi
            depth 1 - tc
                .stack
                .values
                .get
                .clone = value
            std::Option[std::String]::None = value.binding
            op.id std::Option::Some = value.source
            value tc
                .stack
                .values
                .push
            true return
        fi
        if op.value common::OpValue::Copy is then
            if 1 depth > then
                false return
            fi
            tc.stack_pop_value = value
            value.type_value.clone = copied_type
            if copied_type.borrow_target std::Option::Some(target) is then
                target.clone std::Option::Some op common::Op::set_type_hint
                target.clone = copied_type
            fi
            std::Option[std::List[Origin]]::None = origins
            if tc.store copied_type type_has_borrow copied_type.has_unresolved_type_var || then
                value.place value.origins origins merge_contained_origins = origins
                if origins.is_none then
                    value.origins.clone = origins
                fi
            fi
            copied_type tc.stack_push_type
            tc
                .stack
                .values
                .length 1 - tc
                .stack
                .values
                .get_mut = copied_value
            origins = copied_value.origins
            value.loan_spans.clone = copied_value.loan_spans
            op.id std::Option::Some = copied_value.source
            true return
        fi
        if op.value common::OpValue::Swap is then
            # Reordering preserves borrows even when a lambda input is supplied
            # by its contextual stack instead of the local stack.
            "argument 1 of `swap`".to_str ExpectationContext::Text = tc.current_expect_ctx
            if depth 0 == then tc.stack_pop_value else tc
                .stack
                .values
                .pop fi = top
            "argument 2 of `swap`".to_str ExpectationContext::Text = tc.current_expect_ctx
            if depth 2 < then tc.stack_pop_value else tc
                .stack
                .values
                .pop fi = below
            top tc
                .stack
                .values
                .push
            below tc
                .stack
                .values
                .push
            true return
        fi
        if op.value common::OpValue::Over is then
            if 2 depth > then
                false return
            fi
            depth 2 - tc
                .stack
                .values
                .get
                .clone = value
            std::Option[std::String]::None = value.binding
            op.id std::Option::Some = value.source
            value tc
                .stack
                .values
                .push
            true return
        fi
        if op.value common::OpValue::Rot is then
            if 3 depth > then
                false return
            fi
            tc
                .stack
                .values
                .pop = top
            tc
                .stack
                .values
                .pop = middle
            tc
                .stack
                .values
                .pop = bottom
            middle tc
                .stack
                .values
                .push
            top tc
                .stack
                .values
                .push
            bottom tc
                .stack
                .values
                .push
            true return
        fi
        false
    }

    pub fn apply_fixed_semantics
        tc:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        if op.value common::OpValue::Copy is then
