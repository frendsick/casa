impl TypeChecker {
    fn collect_pattern_types
        self:mut$TypeChecker
        value:$common::PatternValue
        subject:$common::Type
        bindings:mut$std::Map[std::String common::Type]
        op:mut$common::Op
        function:mut$std::Option[common::Function]
    {
        subject pattern::owned_type = owner
        value match
            common::PatternValue::Binding(binding) => {
                if binding.name bindings.has then
                    binding.location "Duplicate binding in pattern" common::ErrorKind::DuplicateName self.diagnostics.record_error
                fi
                subject.clone binding.name.clone bindings.set
            }
            common::PatternValue::Literal(literal) => {
                subject literal.clone op self.check_literal_pattern
            }
            common::PatternValue::EnumVariant(variant) => {
                if value pattern::is_wildcard then
                    return
                fi
                if variant.enum_name.as_str "" == then
                    owner.match_base.as_str variant.clone op self.diagnose_bare_enum_pattern
                    return
                fi
                if owner.is_unknown_placeholder ! owner.match_base variant.enum_name != && then
                    op.location f"Cannot match `{variant.enum_name}::{variant.variant_name}` on `{owner.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
                self.store variant owner pattern::enum_payload_types = types
                if variant.bindings.is_empty then
                    return
                fi
                if types.length variant.bindings.length < then
                    op.location f"Variant `{variant.enum_name}::{variant.variant_name}` has {types.length} inner value(s), but {variant.bindings.length} pattern(s) provided" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
                0 = index: u64
                for child in variant.bindings.iter do
                    index types.get = typ
                    function typ self.type_is_duplicable typ.clone subject rules::pattern_binding_type = child_type
                    function op bindings child_type child self.collect_pattern_types
                    1 += index
                done
            }
            common::PatternValue::Struct(struct_pattern) => {
                if owner.is_unknown_placeholder ! owner.match_base struct_pattern.struct_name != && then
                    op.location f"Cannot match struct `{struct_pattern.struct_name}` on `{owner.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
                self.store struct_pattern.struct_name.as_str owner resolve_struct_pattern_field_types match
                    std::Option::Some(types) => types
                    std::Option::None => return
                end = types
                for field in struct_pattern.bindings.iter do
                    f"{struct_pattern.struct_name}::{field.first}" = accessor
                    if
                        op
                            .location
                            .file
                            .as_str accessor.as_str self.store.is_private_from
                    then
                        op.location "Cannot bind a private struct field outside its module" common::ErrorKind::InvalidScope self.diagnostics.record_error
                    fi
                    if field.first types.get std::Option::Some(typ) is then
                        function typ self.type_is_duplicable typ.clone subject rules::pattern_binding_type = child_type
                        function op bindings child_type field.second self.collect_pattern_types
                    else
                        op.location f"Unknown pattern field `{field.first}`" common::ErrorKind::UndefinedName self.diagnostics.record_error_string
                    fi
                done
            }
            common::PatternValue::Alternatives(alternatives) => {
                false = first
                for alternative in alternatives.iter do
                    std::Map[std::String common::Type]::new = current
                    function op current subject alternative self.collect_pattern_types
                    if first ! then
                        for binding in current.iter do
                            binding.second.clone binding.first.clone bindings.set
                        done
                        true = first
                        continue
                    fi
                    current.length bindings.length == = compatible
                    for binding in bindings.iter do
                        if binding.first current.get std::Option::Some(typ) is then
                            if binding.second typ.eq ! then
                                false = compatible
                            fi
                        else
                            false = compatible
                        fi
                    done
                    if compatible ! then
                        op.location "Pattern alternatives must bind the same names with the same types and capabilities" common::ErrorKind::TypeMismatch self.diagnostics.record_error
                    fi
                done
            }
        end
    }

    fn register_pattern_bindings
        self:mut$TypeChecker
        function:mut$std::Option[common::Function]
        op:mut$common::Op
        subject:$common::Type
    {
        std::Map[std::String common::Type]::new = bindings
        function op bindings subject op common::pattern_value_of self.collect_pattern_types
        for binding in bindings.iter do
