            value tc.finish_value_use
            resolved_operation op common::Op::set_value
            peek_t.clone std::Option::Some op common::Op::set_type_hint
            return
        fi
        if common::TYPE_MISSING typ.as_str == common::TYPE_UNKNOWN typ.as_str == || then
            tc.stack_pop_drop
            return
        fi
        common::STD_DISPLAY_TRAIT.to_str common::GenericType::new common::Type::Generic = display_type
        if
            tc.checks tc.diagnostics tc.store function_opt display_type peek_t check_trait_satisfaction !
        then
            op common::Op::location f"Type `{typ}` cannot be printed: does not satisfy trait `Display`" common::ErrorKind::MissingTraitMethod tc.diagnostics.record_error_string
            tc.stack_pop_drop
            return
        fi
        common::STD_DISPLAY_TRAIT tc.add_symbol_dependency
        "to_str".to_str common::OpValue::MethodCall op common::Op::set_value
        function_opt emitted_ops op tc.check_method_call
        op common::Op::location common::OpValue::Print common::Op::new = print_op
        print_op pending_ops.push
    }
}

