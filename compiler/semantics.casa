pub fn primitive_print_operation receiver:$common::Type -> std::Option[common::OpValue] {
    if receiver.is_integer_type_t then
        common::OpValue::PrintInt std::Option::Some return
    fi
    receiver.format = receiver_name
    if common::STD_STRING_TYPE receiver_name.as_str == then
        common::OpValue::PrintString std::Option::Some return
    fi
    receiver_name.as_str match
        "str" => common::OpValue::PrintStr std::Option::Some
        "bool" => common::OpValue::PrintBool std::Option::Some
        "char" => common::OpValue::PrintChar std::Option::Some
        "cstr" => common::OpValue::PrintCstr std::Option::Some
        _ => std::Option[common::OpValue]::None
    end
}

pub fn comparison_method_name operation:$common::OpValue -> str {
    operation match
        common::OpValue::Eq => "eq"
        common::OpValue::Ne => "ne"
        common::OpValue::Lt => "lt"
        common::OpValue::Le => "le"
        common::OpValue::Gt => "gt"
        _ => "ge"
    end
}

pub fn comparison_trait_name operation:$common::OpValue -> str {
    operation match
        common::OpValue::Eq => common::STD_PARTIAL_EQ_TRAIT
        common::OpValue::Ne => common::STD_PARTIAL_EQ_TRAIT
        _ => common::STD_PARTIAL_ORD_TRAIT
    end
}

pub fn comparison_uses_method receiver:$common::Type store:$common::SymbolStore -> bool {
    if receiver.is_unknown_placeholder then
        false return
    fi
    if common::make_str_type receiver.eq then
        false return
    fi
    if receiver.is_primitive_compare_type_t then
        false return
    fi
    receiver match
        common::Type::TypeVar(_) => true
        common::Type::Generic(generic) => generic.base.as_str store.structs.has_str
        _ => false
    end
}

pub fn add_method_dependencies
