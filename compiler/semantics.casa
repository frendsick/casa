}

fn analyze_function_semantics_in_store
    function:$common::Function
    store:mut$common::SymbolStore
    argument_callables:$std::Map[std::String std::Set[std::String]]
    active_calls:std::Set[std::String]
    checks:mut$SemanticChecks
    infer_parameters:bool
-> AnalyzedFunction {
    if function.name.as_str store.has_function ! then
        function.clone store.set_function
    fi
    function.name.as_str store
        .get_function
        .unwrap
        .clone checks.begin_function = active
    error::Diagnostics::new = diagnostics
    infer_parameters checks active_calls argument_callables diagnostics store active.check = checked
    function.name.as_str checks
        .functions
        .get_str
        .unwrap match
        FunctionWork::Completed(completed) => completed.body.lower_operations
        FunctionWork::Rejected(rejection) => rejection.lower_operations
        _ => "Function checking did not publish its result" panic
    end = operations
    AnalyzedFunction {
        checked_function: function.name.as_str store
            .get_function
            .unwrap
            .clone
        ordered_facts: checked.ordered_facts.clone checks.resolve_dependency_callables
        inferred_effect: checked.inferred_effect.clone
        operations: operations
        diagnostics: diagnostics
        return_callables: checked.return_callables checks.resolve_callable_targets
        return_origin_summaries: checked.return_origin_summaries.clone
    }
}

pub fn analyze_function_semantics
