                type_variable.as_str sources.type_variable_cleanup clone_nonempty_origins
                = cleanup_origins
                cleanup_origins origins resolved_return tc.classify_type_variable_return_origins
                = cleanup_origins = origins
                origins cleanup_origins ReturnCleanupMode::Exact return
            fi
        fi

        # Recursive calls have no saved summary yet. Keep all input origins for
        # callable results, including function types with symbolic return parameters.
        if tc.store resolved_return get_borrow_shape CAPTURED_BORROW_SHAPE & 0 != then
            sources.callable.clone sources.callable_cleanup.clone ReturnCleanupMode::Exact return
        fi

        if resolved_return.has_unresolved_type_var then
            std::Option[std::List[Origin]]::None = origins
            std::Option[std::List[Origin]]::None = cleanup_origins
            std::Set[std::String]::new = type_variables
            type_variables resolved_return common::collect_stack_effect_type_vars
            for type_variable in type_variables.iter do
                type_variable.as_str sources.type_variables clone_nonempty_origins
                origins merge_origins = origins
                type_variable.as_str sources.type_variable_cleanup clone_nonempty_origins
                cleanup_origins merge_origins = cleanup_origins
            done
            # A symbolic payload does not erase an explicit borrow in the result shape.
            if tc.store resolved_return type_has_shared_borrow then
                sources.shared origins merge_origins = origins
            fi
            if tc.store resolved_return type_has_exclusive_borrow then
                sources.exclusive origins merge_origins = origins
            fi
            std::List[std::String]::new = visiting
            if visiting tc.store resolved_return does_cleanup_observe_borrow then
                origins cleanup_origins merge_origins = cleanup_origins
            fi
            origins cleanup_origins ReturnCleanupMode::Exact return
        fi

        std::Option[std::List[Origin]]::None = origins
        if tc.store resolved_return type_has_shared_borrow then
            sources.shared origins merge_origins = origins
        fi
        if tc.store resolved_return type_has_exclusive_borrow then
            sources.exclusive origins merge_origins = origins
        fi
        std::List[std::String]::new = visiting
        if visiting tc.store resolved_return does_cleanup_observe_borrow then
            origins std::Option[std::List[Origin]]::None ReturnCleanupMode::AllOrigins return
        fi
        origins std::Option[std::List[Origin]]::None ReturnCleanupMode::NoCleanup
    }

    pub fn apply_stack_effect
        tc:mut$TypeChecker
        effect:$common::StackEffect
        name:$str
        return_hint:std::Option[common::Type]
        function_opt:mut$std::Option[common::Function]
    {
        name effect tc.check_constant_array_index
        std::Option[std::String]::None = field
        std::Option[Place]::None = projected_place
        ValueCapability::Shared = receiver_capability
        if
            0 tc
                .stack
                .values
                .length !=
        then
            tc
                .stack
                .values
                .length 1 - = receiver_index
            receiver_index tc
                .stack
                .values
                .get = receiver_value
            receiver_value.type_value name tc.find_struct_getter_field = field
            if field.clone std::Option::Some(field_name) is then
                receiver_value.capability = receiver_capability
                if receiver_value.place std::Option::Some(place) is then
                    field_name.as_str place.project = projected
                    projected.clone std::Option::Some = projected_place
                    receiver_index tc
                        .stack
                        .values
                        .get_mut = stored_receiver
                    projected std::Option::Some = stored_receiver.place
                fi
            fi
        fi
        std::Map[std::String common::Type]::new = bindings
        if
            0 effect.type_vars.length !=
            0 effect
                .const_params
                .length != ||
        then
            if return_hint std::Option::Some(hint) is then
                for return_type in effect common::StackEffect::return_types.iter do
                    effect.type_vars hint return_type bindings bind_generic_params_standalone = bindings
                    hint return_type bindings bind_standalone_constant_parameters = bindings
                done
            fi
            bindings effect tc.bind_concrete_stack_constraints = bindings
        fi
        std::Option[std::List[Origin]]::None = shared_origins
        std::Option[std::List[Origin]]::None = exclusive_origins
        std::Option[std::List[Origin]]::None = callable_origins
        std::Option[std::List[Origin]]::None = callable_cleanup_origins
        std::Map[std::String std::List[Origin]]::new = type_variable_origins
        std::Map[std::String std::List[Origin]]::new = type_variable_cleanup_origins
        0 effect.type_vars.length !=
        0 effect.const_params.length != || = has_generic_parameters
        false = returns_borrow
        false = returns_callable
        false = returns_unresolved_type
        for return_type in effect.return_types.iter do
            bindings return_type.substitute_t = resolved_return
            if tc.store resolved_return type_has_borrow then
                true = returns_borrow
            fi
            if tc.store resolved_return get_borrow_shape CAPTURED_BORROW_SHAPE & 0 != then
                true = returns_callable
            fi
            if resolved_return.has_unresolved_type_var then
                true = returns_unresolved_type
            fi
        done
        if effect stack_effect_may_borrow then
            bindings effect tc.should_preserve_contained_call_origins = prefer_contained_origins
            if prefer_contained_origins then
                CallOriginMode::ContainedShared
            else
                CallOriginMode::Shared
            fi = shared_mode
            if prefer_contained_origins then
                CallOriginMode::ContainedExclusive
            else
                CallOriginMode::Exclusive
            fi = exclusive_mode
            shared_mode bindings effect tc.collect_call_origins = shared_origins
            exclusive_mode bindings effect tc.collect_call_origins = exclusive_origins
            name bindings effect tc.check_call_borrow_conflicts
            bindings effect tc.check_live_borrow_conflicts
        elif returns_borrow then
            CallOriginMode::Shared bindings effect tc.collect_call_origins = shared_origins
            CallOriginMode::Exclusive bindings effect tc.collect_call_origins
            = exclusive_origins
        fi
        if has_generic_parameters returns_unresolved_type || then
            effect tc.collect_type_variable_argument_origins
            = type_variable_cleanup_origins = type_variable_origins
        fi
        if returns_callable then
            bindings effect tc.collect_argument_origins
            = callable_cleanup_origins = callable_origins
        fi
        ReturnOriginSources {
            shared: shared_origins
            exclusive: exclusive_origins
            callable: callable_origins
            callable_cleanup: callable_cleanup_origins
            type_variables: type_variable_origins
            type_variable_cleanup: type_variable_cleanup_origins
        } = return_origin_sources
        # Simple case: no type or constant parameters
        if has_generic_parameters ! then
            0 = index: u64
            while index effect common::StackEffect::parameters.length < do
                index effect common::StackEffect::parameters.get = parameter
                index parameter name tc.set_parameter_context
                parameter.typ tc.expect_type_t
                1 += index
            done
            ExpectationContext::None = tc.current_expect_ctx
            for return_type in effect common::StackEffect::return_types.iter do
                if tc.store return_type get_borrow_shape CAPTURED_BORROW_SHAPE & 0 != then
                    callable_cleanup_origins.clone callable_origins.clone return_type
                    tc.push_value_origins
                elif return_type.has_unresolved_type_var then
                    return_type tc.stack_push_type
                    return_type.type_var_name = return_type_variable
                    return_type_variable return_type return_origin_sources
                    tc.select_generic_return_origins
                    = cleanup_mode = cleanup_origins = origins
                    tc
                        .stack
                        .values
                        .length 1 - tc
                        .stack
                        .values
                        .get_mut = value
                    cleanup_mode cleanup_origins origins value.apply_return_origins
                elif tc.store return_type type_has_borrow then
                    std::Option[std::List[Origin]]::None = origins
                    if tc.store return_type type_has_shared_borrow then
                        shared_origins origins merge_origins = origins
                    fi
                    if tc.store return_type type_has_exclusive_borrow then
                        exclusive_origins origins merge_origins = origins
                    fi
                    origins return_type tc.stack_push_origins
                else
                    return_type tc.stack_push_type
                fi
            done
            function_opt shared_origins receiver_capability projected_place field
            tc.finish_struct_getter
            return
        fi

        # Generic case: bind type variables
        std::Map[std::String std::List[LiteralRef]]::new = literal_bindings
        0 = index: u64
        while index effect.parameters.length < do
            index effect.parameters.get = parameter
            index parameter name tc.set_parameter_context

            if bindings parameter tc.bind_borrow_parameter then
                1 += index
                continue
            fi

            if literal_bindings bindings effect parameter tc.bind_direct_type_variable_parameter then
                1 += index
                continue
            fi

            # Parameterized type with type vars (e.g. Option[T], Map[K V])
            if effect parameter bindings tc.bind_generic_param then
                1 += index
                continue
            fi

            # Function type with type vars (e.g. fn[T -> T])
            if effect parameter bindings tc.bind_fn_param then
                1 += index
                continue
            fi

            bindings parameter.typ.substitute_t tc.expect_type_t
            1 += index
        done
        ExpectationContext::None = tc.current_expect_ctx

        tc.store bindings effect rules::collect_bound_semantic_dependencies
        = bound_dependencies
        for dependency in bound_dependencies.iter do
            dependency.as_str tc.add_symbol_dependency
        done
        # Push resolved return types
        for return_type in effect common::StackEffect::return_types.iter do
            return_type bindings resolve_return_type_t = resolved_return
            std::Option[std::String]::None = return_type_variable
            if return_type common::Type::TypeVar(type_variable_name) is then
                type_variable_name.clone std::Option::Some = return_type_variable
            fi
            literal_bindings bindings return_type tc.push_resolved_return
            if
                tc.store resolved_return type_has_borrow
                return_type_variable.is_some ||
                tc.store resolved_return get_borrow_shape CAPTURED_BORROW_SHAPE & 0 != ||
            then
                return_type_variable resolved_return return_origin_sources
                tc.select_generic_return_origins
                = cleanup_mode = cleanup_origins = origins
                tc
                    .stack
                    .values
                    .length 1 - tc
                    .stack
                    .values
                    .get_mut = value
                cleanup_mode cleanup_origins origins value.apply_return_origins
            fi
        done
        function_opt shared_origins receiver_capability projected_place field
        tc.finish_struct_getter
    }
}

pub fn exact_numeric_conversion
    source:mut$common::BuiltinType
    target:mut$common::BuiltinType
-> bool {
    if source target == then
        true return
    fi
    if source.is_integer target.is_integer && then
        source.bit_width = source_width
        target.bit_width = target_width
        if source.is_unsigned then
            if target.is_unsigned then
                target_width source_width >= return
            fi
            target_width source_width > return
        fi
        if target.is_unsigned then
            false return
        fi
        target_width source_width >= return
    fi
    if source common::BuiltinType::F32 == target common::BuiltinType::F64 == && then
        true return
    fi
    if source.is_integer target.is_float && then
        if target common::BuiltinType::F32 == then
            if source.is_unsigned then
                24 source.bit_width >= return
            fi
            25 source.bit_width >= return
        fi
        if source.is_unsigned then
            53 source.bit_width >= return
        fi
        54 source.bit_width >= return
    fi
    false
}

pub fn numeric_conversion_allowed conversion:mut$common::NumericConversion -> bool {
    conversion.kind match
        common::NumericConversionKind::Exact => conversion.target conversion.source exact_numeric_conversion
        common::NumericConversionKind::Rounded => {
            conversion.target.is_float
            conversion.source.is_integer
            conversion.source common::BuiltinType::F64 ==
            conversion.target common::BuiltinType::F32 == && || &&
        }
        common::NumericConversionKind::Truncate => {
            conversion.target.is_integer conversion.source.is_float &&
        }
        common::NumericConversionKind::Wrapping => {
            conversion.target.is_integer conversion.source.is_integer &&
        }
        common::NumericConversionKind::FromBits => {
            conversion.target common::BuiltinType::F32 == conversion.source common::BuiltinType::U32 == &&
            conversion.target common::BuiltinType::F64 == conversion.source common::BuiltinType::U64 == && ||
        }
        common::NumericConversionKind::ToBits => {
            conversion.source common::BuiltinType::F32 == conversion.target common::BuiltinType::U32 == &&
            conversion.source common::BuiltinType::F64 == conversion.target common::BuiltinType::U64 == && ||
        }
    end
}

impl TypeChecker {
    pub fn check_numeric_call tc:mut$TypeChecker op:mut$common::Op {
        op.value.clone = numeric_value
        if numeric_value common::OpValue::NumericCall(call) is then
            if "__float_significand" call.method.as_str == then
                tc.stack_pop_value = value
                0 value tc.read_scalar_value
                tc.stack_pop_value = exponent
                1 exponent tc.read_scalar_value
                common::make_f64_type value tc.resolve_float_value drop
                common::make_i64_type exponent tc.resolve_integer_value drop
                if call.target common::BuiltinType::U64 != then
                    op.location "Only `u64::__float_significand` is defined" common::ErrorKind::TypeMismatch tc.diagnostics.record_error
                fi
                common::OpValue::FloatSignificand op common::Op::set_value
                common::make_u64_type.clone std::Option::Some op common::Op::set_type_hint
                common::make_u64_type tc.stack_push_type
                return
            fi
            if "__from_decimal_parts" call.method.as_str == then
                tc.stack_pop_value = significand
                0 significand tc.read_scalar_value
                tc.stack_pop_value = exponent
                1 exponent tc.read_scalar_value
                common::make_u64_type significand tc.resolve_integer_value drop
                common::make_i64_type exponent tc.resolve_integer_value drop
                if call.target common::BuiltinType::F64 != then
                    op.location "Only `f64::__from_decimal_parts` is defined" common::ErrorKind::TypeMismatch tc.diagnostics.record_error
                fi
                common::OpValue::FloatFromDecimal op common::Op::set_value
                common::make_f64_type.clone std::Option::Some op common::Op::set_type_hint
                common::make_f64_type tc.stack_push_type
                return
            fi
            tc.stack_pop_value = value
            0 value tc.read_scalar_value
            common::make_unknown_type.clone = source_type
            if value.type_value.is_integer_literal_t then
                tc.literal_resolutions tc.diagnostics common::make_i64_type value.resolve_literals drop
                common::make_i64_type.clone = source_type
            elif value.type_value.is_float_literal_t then
                tc.literal_resolutions tc.diagnostics common::make_f64_type value.resolve_literals drop
                common::make_f64_type.clone = source_type
            else
                value.type_value.clone = source_type
            fi
            if "from_codepoint_unchecked" call.method.as_str == then
                "char::from_codepoint_unchecked" op tc.require_unsafe
                if call.target common::BuiltinType::Char != then
                    op.location "Only `char::from_codepoint_unchecked` is defined" common::ErrorKind::TypeMismatch tc.diagnostics.record_error
                fi
                common::make_u32_type value tc.resolve_integer_value drop
                common::BuiltinType::Char common::BuiltinType::U32 common::NumericConversionKind::FromBits common::NumericConversion
                common::OpValue::NumericConvert op common::Op::set_value
                common::make_char_type.clone std::Option::Some op common::Op::set_type_hint
                common::make_char_type tc.stack_push_type
                return
            fi
            if "try_from" call.method.as_str == then
                if
                    source_type.is_integer_type_t
                    source_type.is_float_type_t ||
                then
                    call.target source_type common::NumericTry common::OpValue::NumericTry op common::Op::set_value
                    call.target common::Type::Builtin std::Option::Some op common::Op::set_type_hint
                    std::List[common::Type]::new = option_params
                    call.target common::Type::Builtin option_params.push
                    option_params common::STD_OPTION_TYPE.to_str common::GenericType::with_params common::Type::Generic tc.stack_push_type
                    return
                fi
                op.location f"Conversion `{call.target.format}::try_from` requires a numeric value" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                common::make_unknown_type tc.stack_push_type
                return
            fi
            if source_type common::Type::Builtin(source) is then
                call.method.as_str match
                    "from" => common::NumericConversionKind::Exact
                    "from_bits" => common::NumericConversionKind::FromBits
                    "round_from" => common::NumericConversionKind::Rounded
                    "trunc_from" => common::NumericConversionKind::Truncate
                    _ => common::NumericConversionKind::Wrapping
                end = kind
                call.target source kind common::NumericConversion = conversion
                if conversion numeric_conversion_allowed ! then
                    op.location f"Conversion `{call.target.format}::{call.method}` does not accept `{source.format}`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
                fi
                conversion common::OpValue::NumericConvert op common::Op::set_value
                call.target common::Type::Builtin std::Option::Some op common::Op::set_type_hint
                call.target common::Type::Builtin tc.stack_push_type
                return
            fi
            op.location f"Conversion `{call.target.format}::{call.method}` requires a numeric value" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
            common::make_unknown_type tc.stack_push_type
        fi
    }

    pub fn resolve_float_value
        tc:mut$TypeChecker
        value:mut$TypedValue
        target:$common::Type
    -> bool {
        if 0 value.literals.length != then
            tc.literal_resolutions tc.diagnostics target value.resolve_literals return
        fi
        if value.type_value target.eq then
            true return
        fi
        f"Expected `{target.format}`, got `{value.type_value.format}`" tc.raise_type_mismatch
        false
    }

    pub fn resolve_integer_value
        tc:mut$TypeChecker
        value:mut$TypedValue
        target:$common::Type
    -> bool {
        if 0 value.literals.length != then
            tc.literal_resolutions tc.diagnostics target value.resolve_literals return
        fi
        if value.type_value target.eq then
            true return
        fi
        f"Expected `{target.format}`, got `{value.type_value.format}`" tc.raise_type_mismatch
        false
    }

    pub fn check_integer_operation tc:mut$TypeChecker op:mut$common::Op {
        op.value.clone = operation
        if operation common::OpValue::BitNot is then
            tc.stack_pop_value = value
            0 value tc.read_scalar_value
            if value.type_value common::make_missing_type.eq then
                common::make_missing_type tc.stack_push_type
                return
            fi
            if value.type_value.is_unknown_placeholder then
                common::make_unknown_type tc.stack_push_type
                return
            fi
            if value.type_value.is_integer_literal_t then
                common::make_i64_type.clone
            else
                value.type_value.clone
            fi = target
            if target.is_integer_type_t ! then
                f"Operator `~` requires an integer, got `{target.format}`" tc.raise_type_mismatch
                return
            fi
            target value tc.resolve_integer_value drop
            target.clone std::Option::Some op common::Op::set_type_hint
            target tc.stack_push_type
            return
        fi

        tc.stack_pop_value = right
        0 right tc.read_scalar_value
        right tc.stack_pop_left_like = left
        1 left tc.read_scalar_value

        if
            left.type_value common::make_missing_type.eq right.type_value common::make_missing_type.eq ||
        then
            common::make_missing_type tc.stack_push_type
            return
        fi
        if left.type_value.is_unknown_placeholder right.type_value.is_unknown_placeholder || then
            common::make_unknown_type tc.stack_push_type
            return
        fi

        if
            left.type_value.is_float_type_t left.type_value.is_float_literal_t ||
            right.type_value.is_float_type_t right.type_value.is_float_literal_t ||
            ||
        then
            common::make_f64_type.clone = float_target
            if left.type_value.is_float_type_t then
                left.type_value.clone = float_target
            elif right.type_value.is_float_type_t then
                right.type_value.clone = float_target
            fi
            if
                operation common::OpValue::Add is operation common::OpValue::Sub is ||
                operation common::OpValue::Mul is ||
                operation common::OpValue::Div is ||
                !
            then
                f"Operator requires integer operands, got `{left.type_value.format}` and `{right.type_value.format}`" tc.raise_type_mismatch
                return
            fi
            float_target left tc.resolve_float_value drop
            float_target right tc.resolve_float_value drop
            float_target.clone std::Option::Some op common::Op::set_type_hint
            float_target tc.stack_push_type
            return
        fi

        if operation common::OpValue::Shl is operation common::OpValue::Shr is || then
            common::make_u64_type right tc.resolve_integer_value drop
            if left.type_value.is_integer_literal_t then
                common::make_i64_type.clone
            else
                left.type_value.clone
            fi = target
            if target.is_integer_type_t ! then
                f"Shift operand must be an integer, got `{target.format}`" tc.raise_type_mismatch
                return
            fi
            target left tc.resolve_integer_value drop
            target.clone std::Option::Some op common::Op::set_type_hint
            target tc.stack_push_type
            return
        fi

        if
            operation common::OpValue::Add is operation common::OpValue::Sub is ||
            left.type_value common::make_ptr_type.eq &&
        then
            if operation common::OpValue::Add is then "+" else "-" fi = operator
            operator op tc.require_unsafe
            common::make_u64_type right tc.resolve_integer_value drop
            common::make_ptr_type.clone std::Option::Some op common::Op::set_type_hint
            common::make_ptr_type tc.stack_push_type
            return
        fi

        common::make_i64_type.clone = target
        if left.type_value.is_integer_type_t then
            left.type_value.clone = target
        elif right.type_value.is_integer_type_t then
            right.type_value.clone = target
        else
            common::make_i64_type.clone = target
        fi
        if target.is_integer_type_t ! then
            f"Integer operator requires integer operands, got `{left.type_value.format}` and `{right.type_value.format}`" tc.raise_type_mismatch
            return
        fi
        target left tc.resolve_integer_value drop
        target right tc.resolve_integer_value drop
        target.clone std::Option::Some op common::Op::set_type_hint
        target tc.stack_push_type
    }
}

# Check comparison operations
# Primitive comparisons are emitted as direct bytecode. `str` is handled
# separately because it only supports `==`/`!=` and carries a type hint.
pub fn comparison_op_str cmp_value:$common::OpValue -> str {
    if cmp_value common::OpValue::Eq is then
        "==" return
    fi
    if cmp_value common::OpValue::Ne is then
        "!=" return
    fi
    if cmp_value common::OpValue::Lt is then
        "<" return
    fi
    if cmp_value common::OpValue::Le is then
        "<=" return
    fi
    if cmp_value common::OpValue::Gt is then
        ">" return
    fi
    ">="
}

pub fn borrowed_comparison_effect type1:$common::Type type2:$common::Type -> common::StackEffect {
    std::List[common::Parameter]::new = parameters
    common::SHARED_BORROW_TYPE type1.clone common::apply_borrow_type = first_borrow
    "".to_str first_borrow common::Parameter::named parameters.push
    common::SHARED_BORROW_TYPE type2.clone common::apply_borrow_type = second_borrow
    "".to_str second_borrow common::Parameter::named parameters.push
    std::List[common::Type]::new parameters common::StackEffect::new
}

impl TypeChecker {
    # A migration can put `swap` between an inferred input and its comparison.
    # Retain that input's identity so the other operand still determines its type.
    fn resolve_comparison_parameter self:mut$TypeChecker value:mut$TypedValue other:$TypedValue {
        if value.type_value.is_unknown_placeholder ! then
            return
        fi
        if value.inferred_parameter std::Option::Some(index) is then
            other.type_value resolve_numeric_literal_default = inferred
            if inferred.is_unknown_placeholder inferred common::make_missing_type.eq || then
                return
            fi
            inferred.clone = value.type_value
            inferred type_capability = value.capability
            index self.parameters.get_mut = parameter
            inferred = parameter.typ
        fi
    }

    pub fn prepare_comparison_values
        tc:mut$TypeChecker
        value1:TypedValue
        value2:TypedValue
        effect:$common::StackEffect
        op:mut$common::Op
        emitted_ops:mut$std::List[common::Op]
        function_opt:mut$std::Option[common::Function]
    {
        value2 tc
            .stack
            .values
            .push
        value1 tc
            .stack
            .values
            .push
        function_opt emitted_ops op 0 effect tc.bind_borrowed_temporaries
        if 0 effect.parameters.length != then
            tc
                .stack
                .values
                .length 1 - tc
