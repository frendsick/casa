    fi
    inferred declared common::stack_effect_type_matches
}

pub fn checked_generic_body_effect_matches
    inferred:$common::StackEffect
    declared:$common::StackEffect
-> bool {
    if inferred.parameters.length declared.parameters.length != then
        false return
    fi
    declared.return_types.length = declared_return_count
    if 1 declared_return_count == then
        if 0 declared.return_types.get common::Type::Generic(return_type) is then
            if "None" return_type.base.as_str == return_type.params.is_empty && then
                0 = declared_return_count: u64
            fi
        fi
    fi
    if inferred.return_types.length declared_return_count != then
        false return
    fi
    for
        pair in declared.parameters.iter inferred
            .parameters
            .list_iter
            .zip
    do
        if pair.second.typ pair.first.typ checked_generic_body_type_matches ! then
            false return
        fi
    done
    0 = return_index: u64
    while return_index declared_return_count < do
        if
            return_index declared.return_types.get return_index inferred.return_types.get
            checked_generic_body_type_matches !
        then
            false return
        fi
        1 += return_index
    done
    true
}

# A stack value can be consumed after its source operation has been emitted.
# Resolve those private pending moves before publishing the checked body.
struct CheckedOperations {
    is_valid:                bool
    inferred_effect:         common::StackEffect
    ordered_facts:           std::List[SemanticDependency]
    return_callables:        std::List[std::Set[std::String]]
    return_origin_summaries: std::List[ReturnOriginSummary]
}

fn analyze_ops
    source:source_body::SourceBody
    ops:mut$body_builder::Builder
    function_opt:mut$std::Option[common::Function]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    require_empty_final_stack:bool
    argument_callables:$std::Map[std::String std::Set[std::String]]
    active_calls:std::Set[std::String]
    checks:mut$SemanticChecks
    infer_parameters:bool
-> CheckedOperations {
    diagnostics.error_count = errors_before_check
    infer_parameters checks active_calls diagnostics store TypeChecker::new = checker
    argument_callables.clone = checker.callable_bindings
    std::Option[u64]::None = budget
    if function_opt std::Option::Some(the_function) is then
        the_function.location.clone = checker.current_location
        the_function checker.record_capture_origins
        the_function
            .stack_effect
            .trait_bounds
            .clone = checker.current_trait_bounds
        for variable in the_function.variables.iter do
            true variable.name.as_str checker.ownership.set_owner_moved
        done
        for parameter in the_function common::Function::stack_effect.parameters.iter do
            parameter.typ.clone checker.contextual_parameters.push
            std::Set[std::String]::new = parameter_callables
            if "" parameter.name.as_str != then
                if parameter.name.as_str argument_callables.get_str std::Option::Some(callables) is then
                    callables.clone = parameter_callables
                elif parameter.typ TypeChecker::does_type_need_symbolic_origin then
                    f"{CALLABLE_PARAMETER_PREFIX}{parameter.name}" parameter_callables.add
                fi
            fi
            parameter_callables checker.contextual_callables.push
        done
        if the_function common::Function::name.as_str "lambda__" str::starts_with ! then
            if infer_parameters ! then
                the_function common::Function::stack_effect common::StackEffect::parameters.length
                std::Option::Some = budget
            fi
        fi
    else
        checker
            .store
            .variables
            .keys = global_names
        for global_name in global_names.iter do
            if global_name.as_str common::is_internal_variable_name then
                true global_name.as_str checker.ownership.set_owner_moved
            fi
        done
    fi
    budget = checker.param_cap
    VariableUses::new source collect_source_variable_uses = variable_uses
    variable_uses checker.ownership.set_variable_uses
    checker.diagnostics.error_count = errors_before_ops
    std::List[common::Op]::new = pending
    function_opt ops pending source checker.check_source_sequence

    function_opt checker.record_scalar_returns
    if checker.scalar_inputs.is_empty ! then
        checker.current_location.clone common::OpValue::OwnerCleanup common::Op::new = inputs
        inputs checker.assign_op_id
        checker.scalar_inputs.clone = inputs.ensure_ownership.scalar_inputs
        std::List[common::ScalarInput]::new = checker.scalar_inputs
        inputs ops.push_operation
    fi
    if function_opt std::Option::Some(checked_function) is then
        checker.path_continues ! checker.has_return_types ! && = checked_function.is_non_returning
        checked_function.stack_effect checker.materialize_return_lambdas
        checked_function checker.resolve_declared_return_borrow_capabilities
        if checker.path_continues then
            checked_function checker.validate_borrow_returns
        fi
        checked_function checker.resolve_declared_return_literals
    fi

    if checker.has_return_types then
        checker.merge_return_stack
    fi
    if checker.path_continues then
        checker.stack TypeChecker::collect_return_origin_summaries = fallthrough_origins
        fallthrough_origins checker.return_origin_summaries
        TypeChecker::merge_return_origin_summaries
    fi

    0 = stack_index: u64
    while
        stack_index checker
            .stack
            .values
            .length <
    do
        std::Option[common::Type]::None stack_index checker.materialize_pending_lambda_at
        stack_index checker
            .stack
            .values
            .get
            .clone = stack_value
        if checker.path_continues then
            stack_value checker.materialize_copy_escape
            stack_value checker.finish_value_use
        fi
        stack_value.type_value resolve_numeric_literal_default = final_type
        checker.literal_resolutions checker.diagnostics final_type stack_value.resolve_literals drop
        false = stack_value.is_literal_constant
        std::List[LiteralRef]::new = stack_value.literals
        final_type = stack_value.type_value
        stack_value stack_index checker
            .stack
            .values
            .set
        1 += stack_index
    done
    if function_opt std::Option::Some(function) is then
        function checker.validate_capture_restoration
    fi
    if checker.ownership.has_owner_cleanups then
        checker.current_location.clone common::OpValue::OwnerCleanup common::Op::new = cleanup_op
        cleanup_op checker.assign_op_id
        cleanup_op checker.attach_all_owner_cleanups
        cleanup_op ops.push_operation
    fi
    function_opt checker.close_source_function
    checker.resolve_return_literals
    ops checker.ownership.attach_body_moves
    checker.literal_resolutions ops apply_body_literal_hints
    std::Option[common::Type]::None checker.diagnostics ops.resolve_literals

    # Build inferred stack effect from every returning path.
    checker.stack.get_types = inferred_returns
    if checker.has_return_types then
        checker.return_types.get_types = inferred_returns
    fi
    inferred_returns checker.parameters.clone common::StackEffect::new = inferred
    if function_opt std::Option::Some(function) is then
        0 = parameter_index: u64
        for
            parameter in function
                .stack_effect
                .parameters
                .iter
        do
            if parameter_index inferred.parameters.length < then
                parameter_index inferred.parameters.get_mut = inferred_parameter
                parameter.name.clone = inferred_parameter.name
            fi
            1 += parameter_index
        done
        function
            .stack_effect
            .type_vars
            .clone = inferred.type_vars
        function
            .stack_effect
            .trait_bounds
            .clone = inferred.trait_bounds
        function
            .stack_effect
            .const_params
            .clone = inferred.const_params
    fi

    # Verify against declared stack effect if function has one
    checker.diagnostics.error_count errors_before_ops > checker.facts_available ! || = had_type_errors
    if had_type_errors ! then
        if
            require_empty_final_stack
            checker.path_continues &&
            0 inferred.return_types.length != &&
        then
            checker.current_location
            f"Root body must leave an empty stack, got `{inferred common::stack_effect_to_str}`"
            common::ErrorKind::StackMismatch checker.diagnostics.record_error_string
        elif function_opt std::Option::Some(declared_function) is then
            if declared_function.name.as_str "lambda__" str::starts_with ! then
                declared_function common::Function::stack_effect = declared: $common::StackEffect
                if declared_function.is_non_returning ! then
                    if
                        declared common::stack_effect_to_str.as_str "None -> None" !=
                        0 inferred.return_types.length != checker.has_return_types ! || &&
                    then
                        false = invalid_effect
                        if 0 declared.type_vars.length != then
                            declared inferred checked_generic_body_effect_matches ! = invalid_effect
                        else
                            inferred declared common::stack_effect_matches ! = invalid_effect
                        fi
                        if invalid_effect then
                            declared_function
                                .location
                                .file
                                .as_str declared_function.name.as_str checker.store.format_name_for_source = source_name
                            declared common::stack_effect_to_str = expected
                            inferred common::stack_effect_to_str = actual
                            declared_function.location f"Invalid stack effect for function `{source_name}`: expected `{expected}`, got `{actual}`" common::ErrorKind::SignatureMismatch checker.diagnostics.record_error_string
                        fi
