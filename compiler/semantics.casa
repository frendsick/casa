                if 0 declared common::StackEffect::type_vars.length != then
                    declared.clone = inferred
                fi
            fi
        fi
    fi

    std::List[std::Set[std::String]]::new = fallthrough_callables
    for
        value in checker
            .stack
            .values
            .iter
    do
        value.callables.clone fallthrough_callables.push
    done
    if checker.path_continues then
        fallthrough_callables checker.return_callables TypeChecker::merge_return_callables
    fi
    if checker.conservative_loop_returns then
        std::List[ReturnOriginSummary]::new = checker.return_origin_summaries
    fi
    checker.return_origin_summaries.clone checker.return_callables.clone
    checker.ordered_facts.clone inferred
    errors_before_check checker.diagnostics.error_count == checker.facts_available && CheckedOperations
}

pub fn check_ops
    ops:mut$std::List[common::Op]
    function_opt:mut$std::Option[common::Function]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    bodies:$std::Map[std::String source_body::SourceBody]
    require_empty_final_stack:bool
-> common::StackEffect {
    false require_empty_final_stack bodies diagnostics store function_opt ops check_ops_with_parameter_policy
}

fn check_ops_with_parameter_policy
    ops:mut$std::List[common::Op]
    function_opt:mut$std::Option[common::Function]
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    bodies:$std::Map[std::String source_body::SourceBody]
    require_empty_final_stack:bool
    infer_parameters:bool
-> common::StackEffect {
    SemanticChecks::new = checks
    bodies.clone checks.stage_sources
    store checks.stage_accessors
    infer_parameters checks
    std::Set[std::String]::new
    std::Map[std::String std::Set[std::String]]::new
    ops source_body::consume_source_operations = source
    body_builder::Builder::new = work
    require_empty_final_stack diagnostics store function_opt work source analyze_ops = checked
    work.lower_operations ops.append
    checked.inferred_effect.clone = effect
    effect
}

impl common::SymbolStore {
    fn clone_for_semantics source:$common::SymbolStore -> common::SymbolStore {
        common::symbol_store_new = cloned
        source.next_op_id = cloned.next_op_id
        for function_name in source.get_function_names.iter do
            function_name.as_str source
                .get_function
                .unwrap
                .clone = function
            if function_name.as_str source.is_generated_recipe then
                function cloned.set_generated_recipe
            else
                function cloned.set_function
            fi
        done
        source.variables.clone = cloned.variables
        source.constants.clone = cloned.constants
        source.enums.clone = cloned.enums
        source.structs.clone = cloned.structs
        source.traits.clone = cloned.traits
        source.member_accessors.clone = cloned.member_accessors
        for implementation in source.clone_trait_impls.iter do
            implementation.clone cloned.set_trait_impl
        done
        source.builtins.clone = cloned.builtins
        source.copy_types.clone = cloned.copy_types
        source.borrow_shapes.clone = cloned.borrow_shapes
        source.public_symbols.clone = cloned.public_symbols
        source.private_symbols.clone = cloned.private_symbols
        source.module_private_symbols.clone = cloned.module_private_symbols
        source cloned.copy_source_names_from
        cloned
    }
}

struct AnalyzedFunction {
    checked_function:        common::Function
    ordered_facts:           std::List[SemanticDependency]
    inferred_effect:         common::StackEffect
    operations:              std::List[common::Op]
