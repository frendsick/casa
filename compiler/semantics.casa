                    float_type tc.stack_push_type
                }
                std::Option::None => op common::make_float_literal_type tc.stack_push_literal
            end
        fi
    }
}

# Check print dispatch
impl TypeChecker {
    pub fn check_io
        tc:mut$TypeChecker
        op:mut$common::Op
        pending_ops:mut$std::List[common::Op]
