                then
                    match_origins.clone = origins
                    op common::pattern_value_of = pattern_value
                    function_opt match_subject_type binding_name.as_str pattern_value self.pattern_copies_payload = copied
                    if copied then
                        match_place match_origins std::Option[std::List[Origin]]::None merge_contained_origins = origins
                    elif match_subject_type.is_borrow then
                        if match_place std::Option::Some(subject_place) is then
                            subject_place.clone = binding_place
                            if op common::pattern_value_of common::PatternValue::Struct(struct_pattern) is then
                                for pair in struct_pattern.bindings.iter do
                                    if binding_name.as_str pair.second pattern::binding_names common::string_list_contains then
                                        pair.first.as_str subject_place.project = binding_place
                                    fi
                                done
                            fi
                            binding_type.is_exclusive_borrow binding_place std::Option::Some origins self.ownership.add_storage_origins = origins
                        fi
                    fi
                    match_cleanup_origins.clone = cleanup_origins
                    std::List[std::String]::new = visiting
                    if visiting self.store binding_type does_cleanup_observe_borrow then
                        origins cleanup_origins merge_origins = cleanup_origins
                    fi
                    binding_type type_capability = capability
                    if match_subject_type.is_borrow copied ! && then
                        match_subject_type type_capability = capability
                    fi
                    capability cleanup_origins origins binding_name.as_str self.current_location self.ownership.record_binding_origins
                fi
            fi
        done
    }

    fn check_literal_pattern
        self:mut$TypeChecker
        op:mut$common::Op
        literal_pattern:common::LiteralPattern
        subject_type:$common::Type
    {
        subject_type.clone = pattern_type
        if pattern_type.borrow_target std::Option::Some(target) is then
            target.clone = pattern_type
        fi
        if pattern_type.is_unknown_placeholder then
            return
        fi
        literal_pattern.value match
            common::LiteralValue::Int(literal) => {
                if pattern_type.is_integer_type_t ! then
                    op.location f"Integer pattern `{literal.raw}` requires an integer subject, got `{pattern_type.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
                if pattern_type literal.fits ! then
                    pattern_type.get_integer_min = minimum
                    pattern_type.get_integer_max = maximum
                    op.location f"Integer pattern `{literal.raw}` is outside `{pattern_type.format}` range {minimum}..{maximum}" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
            }
            common::LiteralValue::Str(_) => {
                if pattern_type common::make_str_type.eq ! then
                    op.location f"String pattern requires a `str` subject, got `{pattern_type.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
            }
            common::LiteralValue::Bool(_) => {
                if pattern_type common::make_bool_type.eq ! then
                    op.location f"Boolean pattern requires a `bool` subject, got `{pattern_type.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
            }
            common::LiteralValue::Char(_) => {
                if pattern_type common::make_char_type.eq ! then
                    op.location f"Character pattern requires a `char` subject, got `{pattern_type.format}`" common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
                    return
                fi
            }
        end
    }

    # Return the error checkpoint after completing the previous arm, so its
    # failures cannot invalidate this arm's independent pattern bindings.
    fn typecheck_match_op
        self:mut$TypeChecker
        function_opt:mut$std::Option[common::Function]
        op:mut$common::Op
        source_guard:std::Option[source_body::SourceBody]
    -> u64 {
        self.diagnostics.error_count = errors_before_arm
        if 0 self.branched_stacks.length == then
            errors_before_arm return
        fi
        self.branched_stacks.pop = top_frame
        if top_frame BranchFrame::BranchMatch is then
            top_frame.into_match = match_ctx
            if match_ctx.condition_present then
                self.facts_available match_ctx.arms_have_facts && = match_ctx.arms_have_facts
                self.diagnostics.error_count = errors_before_completion
                op match_ctx.before self.complete_branch
                match_ctx.flow_after self.merge_current_ownership_flow
                op match_ctx self.unify_arm_stacks
                if self.path_continues then
                    true = match_ctx.has_continuing_arm
                fi
                match_ctx.flow_before self.restore_ownership_flow
                match_ctx.entry_continues = self.path_continues
                errors_before_completion self.diagnostics.error_count == match_ctx.arms_have_facts &&
                = match_ctx.arms_have_facts
            fi
            match_ctx.entry_facts_available = self.facts_available
            self.diagnostics.error_count = errors_before_arm
            match_ctx MatchContext::match_type.clone = match_subject_type
            match_ctx.coverage.clone = arm_coverage
            op common::pattern_value_of = arm_pattern
            if arm_pattern common::PatternValue::Alternatives(alternatives) is then
                for alternative in alternatives.iter do
                    op arm_coverage match_subject_type alternative self.record_pattern_coverage
                done
            else
                op arm_coverage match_subject_type arm_pattern self.record_pattern_coverage
            fi
            if source_guard.is_none then
                arm_coverage = match_ctx.coverage
            fi

            if match_ctx MatchContext::condition_present ! then
                true match_ctx MatchContext::set_condition_present
                self.stack match_ctx MatchContext::before.restore
                self.stack match_ctx MatchContext::after.restore
            fi

            # Pattern bindings and assignments belong to this arm's scope.
            self.scope.enter

            # Record pattern bindings in the arm scope; implicit bindings cannot
            # shadow an accessible outer variable (same rule as is-bindings).
            for binding_var in op pattern::pattern_bindings.iter do
                op binding_var.as_str self.record_implicit_binding
            done

            match_subject_type op function_opt self.register_pattern_bindings
            function_opt match_ctx.match_place match_ctx.match_cleanup_origins match_ctx.match_origins match_subject_type op self.record_match_pattern_origins
            match_subject_type.clone std::Option::Some op common::Op::set_type_hint
            for binding_var in op pattern::pattern_bindings.iter do
                if binding_var.as_str self.scope.lookup std::Option::Some(binding_type) is then
                    false function_opt binding_type binding_var.as_str op self.record_owner_assignment
                fi
            done

            if source_guard std::Option::Some(guard_body) is then
                self
                    .checks
                    .bindings
                    .declarations
                    .length = first_guard_binding
                self.scope.snapshot = guard_scope
                self.current_ownership_flow = guard_flow
                self.infer_parameters self.checks
                self.active_calls.clone self.diagnostics self.store TypeChecker::new = guard_checker
                self.facts_available = guard_checker.facts_available
                self.current_trait_bounds.clone = guard_checker.current_trait_bounds
                guard_scope = guard_checker.scope
                guard_flow guard_checker.restore_ownership_flow
                self.ownership guard_checker.ownership.inherit_move_locations
                self.contextual_callables.clone = guard_checker.contextual_callables
                VariableUses::new guard_body collect_source_variable_uses = variable_uses
                variable_uses guard_checker.ownership.set_variable_uses
                body_builder::Builder::new = guard_ops
                std::List[common::Op]::new = pending
                function_opt guard_ops pending guard_body guard_checker.check_source_sequence
                guard_checker.path_continues = guard_continues
                if guard_continues then
                    guard_checker.diagnostics op.location self.ownership
                    guard_checker.ownership.validate_guard_moves
                    guard_checker.stack.get_types = guard_stack
                    false = guard_ok
                    if 1 guard_stack.length == then
                        0 guard_stack.get.format = guard_type
                        if "bool" guard_type.as_str == then
                            true = guard_ok
                        fi
                    fi
                    if guard_ok ! then
                        op common::Op::location "Guard expression must leave a single `bool` on the stack" common::ErrorKind::TypeMismatch guard_checker.diagnostics.record_error
                    fi
                fi
                guard_ops guard_checker.ownership.attach_body_moves
                if op.value common::OpValue::MatchArm(arm) is then
                    guard_checker
                        .current_location
                        .span
                        .offset guard_checker
                        .current_location
                        .span
                        .length +
                    arm
                        .guard_end
                        .clone
                        .unwrap_or = guard_end
                    first_guard_binding guard_end guard_checker.close_source_bindings
                fi
                guard_checker.facts_available = guard_facts_available
                guard_checker.into_semantic_dependencies = guard_dependencies
                guard_facts_available = self.facts_available
                guard_ops self.checked_guards.push
                if guard_continues ! then
                    false = self.path_continues
                fi
                guard_dependencies self.merge_dependencies
            fi

            errors_before_arm self.diagnostics.error_count == self.facts_available &&
            = self.facts_available
            op common::Op::location.clone match_ctx MatchContext::set_current_branch_location
            match_ctx BranchFrame::BranchMatch = top_frame
        fi
        top_frame self.branched_stacks.push
        errors_before_arm
    }
}

# Check is keyword
impl TypeChecker {
    fn bind_is_subject
        self:mut$TypeChecker
        subject:mut$TypedValue
        op:mut$common::Op
        emitted_ops:mut$std::List[common::Op]
        function_opt:mut$std::Option[common::Function]
    {
        if
            subject.capability ValueCapability::Owned is !
            subject.binding.is_some ||
            subject.place.is_some ||
            self.store subject.type_value common::type_needs_destruction_in_store ! ||
        then
            return
        fi
        f"$if_is_subject_{op.id}" = name
        false name.as_str self.scope.assign
        subject.type_value name.as_str self.scope.set_type drop
        if function_opt std::Option::Some(function) is then
            subject.type_value.clone name.clone common::Variable function.variables.push
        else
            subject.type_value.clone name.clone common::Variable = variable
            variable name.clone self
                .store
                .variables
                .set
        fi
        false name.as_str self.ownership.set_owner_moved

        0 name.clone common::TemporaryBinding = binding
        op.location.clone binding common::OpValue::BindTemporary common::Op::new = bind_op
        bind_op self.assign_op_id
        false function_opt subject.type_value name.as_str bind_op self.record_owner_assignment
        name.as_str Place::new std::Option::Some = subject.place
        name std::Option::Some = subject.binding
        std::Option[i64]::None = subject.source

        bind_op emitted_ops.push
    }

    pub fn check_is
        tc:mut$TypeChecker
        op:mut$common::Op
        emitted_ops:mut$std::List[common::Op]
        function_opt:mut$std::Option[common::Function]
    {
        tc.stack_pop_value = subject
        if subject.type_value.borrow_target std::Option::Some(target) is then
            0 target subject tc.record_scalar_input
        fi
        function_opt emitted_ops op subject tc.bind_is_subject
        subject tc.release_value
        subject.type_value.clone = typ
        typ.clone std::Option::Some op common::Op::set_type_hint
        typ.clone = subject_type
        if typ.borrow_target std::Option::Some(target) is then
            target.clone = subject_type
        fi
        subject_type.match_base = base
        if
            base tc
                .store
                .enums
                .has !
        then
            f"`is` requires an enum type, got `{subject_type.format}`" tc.raise_type_mismatch
            common::make_bool_type tc.stack_push_type
            return
        fi
        op.value.clone = is_value
        if is_value common::OpValue::IsCheck(variant) is then
            # Validate the variant belongs to the correct enum
            if "" variant common::EnumVariant::enum_name.as_str != then
                if variant common::EnumVariant::enum_name base != then
                    f"Cannot check `{variant common::EnumVariant::enum_name}::{variant common::EnumVariant::variant_name}` on value of type `{typ.format}`" tc.raise_type_mismatch
                fi
            fi
            variant.clone common::PatternValue::EnumVariant = pattern_value
            pattern_value pattern::binding_names = binding_names
            if binding_names.is_empty ! tc.in_branch_condition ! && then
                op.location "`is` with bindings is only allowed in if/elif conditions" common::ErrorKind::InvalidScope tc.diagnostics.record_error
                common::make_bool_type tc.stack_push_type
                return
            fi
            for name in binding_names.iter do
                op name.as_str tc.record_implicit_binding
            done
            typ.clone = pattern_subject_type
            if pattern_subject_type.is_borrow ! then
                if subject.capability ValueCapability::Shared is then
                    common::SHARED_BORROW_TYPE pattern_subject_type common::apply_borrow_type
                    = pattern_subject_type
                elif subject.capability ValueCapability::Exclusive is then
                    common::EXCLUSIVE_BORROW_TYPE pattern_subject_type common::apply_borrow_type
                    = pattern_subject_type
                fi
            fi
            std::Map[std::String common::Type]::new = binding_types
            function_opt op binding_types pattern_subject_type pattern_value tc.collect_pattern_types
            for binding in binding_types.iter do
                function_opt binding.second binding.first.as_str tc set_binding_type
            done
            false = moves_payload
            for binding_name in binding_names.iter do
                if binding_name.as_str tc.scope.lookup std::Option::Some(binding_type) is then
                    false function_opt binding_type binding_name.as_str op tc.record_owner_assignment
                    if
                        subject.capability ValueCapability::Owned is
                        binding_type.is_borrow ! &&
                        function_opt binding_type tc.type_is_duplicable ! &&
                    then
                        true = moves_payload
                    fi
                fi
            done
            function_opt subject variant tc.record_enum_pattern_origins
            if moves_payload then
                if subject.binding std::Option::Some(subject_name) is then
                    if
                        true tc
                            .stack
                            .values
                            .length subject_name.as_str Place::new tc.find_conflicting_loan
                        std::Option::Some(conflict) is
                    then
                        conflict f"Cannot move owner `{subject_name}` while it is borrowed"
                        tc.current_location tc.diagnostics tc.ownership.report_loan_conflict
                    elif subject_name.as_str tc.ownership.owner_is_moved ! then
                        subject_name.as_str op tc.record_conditional_move
                    fi
                fi
            fi
        fi
        common::make_bool_type tc.stack_push_type
    }
}

pub fn set_binding_type
    tc:mut$TypeChecker
    var_name:$str
    field_type:$common::Type
    function_opt:mut$std::Option[common::Function]
{
    false var_name.as_str tc.ownership.set_owner_moved
    field_type var_name.as_str tc.scope.set_type = scope_updated
    if function_opt.is_none then
        var_name.as_str tc
            .store
            .variables
            .remove_str = global_opt
        if global_opt std::Option::Some(global_var) is then
            global_var.clone = updated_global
            field_type.clone updated_global common::Variable::set_typ
            updated_global var_name.clone tc
                .store
                .variables
                .set_str
            return
        fi
    fi
    if scope_updated then
        return
    fi
    if function_opt std::Option::Some(function) is then
        for variable in function common::Function::variables.iter do
            if var_name variable common::Variable::name.as_str == then
                false var_name.as_str tc.scope.assign
                field_type var_name.as_str tc.scope.set_type drop
                return
            fi
        done
    fi
    var_name.as_str tc
        .store
        .variables
        .remove_str = global_opt
    if global_opt std::Option::Some(global_var_fallback) is then
        global_var_fallback.clone = updated_global
        field_type.clone updated_global common::Variable::set_typ
        updated_global var_name.clone tc
            .store
            .variables
            .set_str
    fi
}

impl TypeChecker {
    fn begin_match
        self:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        self.diagnostics.error_count = errors_before
        std::Option[std::List[Origin]]::None = match_origins
        std::Option[std::List[Origin]]::None = match_cleanup_origins
        std::Option[Place]::None = match_place
        common::make_unknown_type.clone = match_type
        if self.path_continues then
            if
                0 self
                    .stack
                    .values
                    .length ==
            then
                self.within_param_cap = inferring_stack_effect
                if function_opt std::Option::Some(function) is then
                    if function common::Function::name.as_str "lambda__" str::starts_with ! then
                        false = inferring_stack_effect
                    fi
                else
                    false = inferring_stack_effect
                fi
                if inferring_stack_effect ! then
                    op common::Op::location "`match` requires a subject value on the stack" common::ErrorKind::StackUnderflow self.diagnostics.record_error
                    true = self.underflow_reported_this_op
                fi
            fi
            0 self
                .stack
                .values
                .length != = has_match_subject
            self.stack_pop_value = match_subject
            if match_subject.type_value.borrow_target std::Option::Some(target) is then
                0 target match_subject self.record_scalar_input
            fi
            match_subject.type_value.clone = match_type
            if 0 match_subject.literals.length != then
                match_type resolve_numeric_literal_default = match_type
                self.literal_resolutions self.diagnostics match_type match_subject.resolve_literals drop
            fi
            if has_match_subject then
                match_subject.origins.clone = match_origins
                match_subject.cleanup_origins.clone = match_cleanup_origins
                if match_subject.place std::Option::Some(place) is then
                    place.clone std::Option::Some = match_place
                fi
                match_subject self.finish_value_use
                if match_subject.capability ValueCapability::Owned is ! then
                    if match_type.is_borrow ! then
                        if match_subject.capability ValueCapability::Shared is then
                            common::SHARED_BORROW_TYPE
                        else
                            common::EXCLUSIVE_BORROW_TYPE
                        fi
                        match_type common::apply_borrow_type = match_type
                    fi
                fi
            fi
        fi
        match_type.clone std::Option::Some = op.type_hint
        match_type MatchContext::new = match_ctx
        errors_before self.diagnostics.error_count == self.facts_available &&
        = match_ctx.entry_facts_available
        match_origins = match_ctx.match_origins
        match_cleanup_origins = match_ctx.match_cleanup_origins
        match_place = match_ctx.match_place
        self.path_continues = match_ctx.entry_continues
        self.current_ownership_flow = match_ctx.flow_before
        # Snapshot the entry stack state eagerly so that an OpFnReturn visiting
        # this frame before any OpMatchArm still finds a correct `before` to
        # restore from. Matches the pre-refactor make_branched_stack behavior.
        self.stack match_ctx MatchContext::before.restore
        self.stack match_ctx MatchContext::after.restore
        op common::Op::location.clone match_ctx MatchContext::set_current_branch_location
        match_ctx BranchFrame::BranchMatch = match_frame
        match_frame self.branched_stacks.push
    }

    fn check_match_exhaustiveness
        self:mut$TypeChecker
        op:mut$common::Op
        match_ctx:mut$MatchContext
    {
        pattern::CoveragePattern::any pattern::CoverageRow::single = remaining
        if match_ctx.coverage remaining pattern::is_useful then
            match_ctx.match_type pattern::owned_type = subject
            if
                subject.match_base self
                    .store
                    .structs
                    .has
            then
                f"Non-exhaustive match on struct `{subject.format}`"
            else
                f"Non-exhaustive match on `{subject.format}`. Add the missing patterns or a wildcard `_` arm"
            fi = message
            op.location message common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
        fi
    }

    fn finish_match self:mut$TypeChecker op:mut$common::Op {
        self
            .branched_stacks
            .pop
            .into_match = match_ctx
        self.facts_available match_ctx.arms_have_facts && = match_ctx.arms_have_facts
        self.diagnostics.error_count = errors_before_completion
        # Close the final arm's scope frame (only opened if an arm ran).
        if match_ctx MatchContext::condition_present then
            op match_ctx.before self.complete_branch
        fi
        match_ctx.flow_after self.merge_current_ownership_flow
        if match_ctx MatchContext::condition_present then
            op match_ctx self.unify_arm_stacks
        fi
        if self.path_continues then
            true = match_ctx.has_continuing_arm
        fi
        if match_ctx.has_continuing_arm then
            match_ctx.after self.stack.restore
            match_ctx.flow_after self.restore_ownership_flow
        else
            match_ctx.flow_before self.restore_ownership_flow
        fi
        match_ctx.has_continuing_arm = self.path_continues

        match_ctx op self.check_match_exhaustiveness
        match_ctx.entry_facts_available match_ctx.arms_have_facts &&
        errors_before_completion self.diagnostics.error_count == && = self.facts_available
    }
}

# Check struct new
impl TypeChecker {
    pub fn resolve_aggregate_literal
        self:mut$TypeChecker
        value:mut$TypedValue
        expected:$common::Type
    -> common::Type {
        value.type_value.clone = actual
        if 0 value.literals.length == then
            actual return
        fi
        if expected.has_unresolved_type_var then
            actual resolve_numeric_literal_default = actual
        else
            expected.clone = actual
        fi
        self.literal_resolutions self.diagnostics actual value.resolve_literals drop
        actual
    }

    pub fn expect_aggregate_value
        self:mut$TypeChecker
        expected:$common::Type
        bindings:mut$std::Map[std::String common::Type]
        origins:std::Option[std::List[Origin]]
        cleanup_origins:std::Option[std::List[Origin]]
    -> std::Option[std::List[Origin]] std::Option[std::List[Origin]] {
        self.stack_pop_value = value
        bindings expected.substitute_t = current_expected
        current_expected value self.resolve_aggregate_literal = actual

        expected.clone = binding_expected
        actual.clone = binding_actual
        if binding_expected.borrow_target std::Option::Some(target) is then
            target.clone = binding_expected
            if binding_actual.borrow_target std::Option::Some(actual_target) is then
                actual_target.clone = binding_actual
            fi
        fi
        bindings binding_actual binding_expected rules::bind_semantic_type_arguments

        bindings expected.substitute_t = resolved_expected
        if self.store resolved_expected expected hides_callable_storage_borrow then
            self.current_location "Generic callback field hides a borrowed result in a type parameter"
            common::ErrorKind::TypeMismatch self.diagnostics.record_error
        fi
        resolved_expected value origins self.ownership.merge_destination_origins = origins
        value.cleanup_origins cleanup_origins merge_origins = cleanup_origins
        value resolved_expected self.expect_value_type_t
        origins cleanup_origins
    }

    pub fn check_struct_new tc:mut$TypeChecker op:mut$common::Op {
        if op.value.clone common::OpValue::StructNew(casa_struct) is then
            std::Map[std::String common::Type]::new = bindings
            if op.type_hint std::Option::Some(hint) is then
                if casa_struct.name hint.match_base == then
                    casa_struct.type_vars hint common::aggregate_type_bindings = bindings
                fi
            fi
            std::Option[std::List[Origin]]::None = origins
            std::Option[std::List[Origin]]::None = cleanup_origins
            for member in casa_struct common::CasaStruct::members.iter do
                cleanup_origins origins bindings member.typ tc.expect_aggregate_value
                = cleanup_origins = origins
            done
            if 0 casa_struct common::CasaStruct::type_vars.length != then
                bindings casa_struct common::CasaStruct::type_vars casa_struct common::CasaStruct::name.as_str
                common::build_resolved_type
            else
                casa_struct common::CasaStruct::name.clone common::GenericType::new common::Type::Generic
            fi = result_type
            result_type.clone std::Option::Some = op.type_hint
            tc.store cleanup_origins origins result_type resolve_cleanup_origins = cleanup_origins
            cleanup_origins origins result_type tc.push_value_origins
            op tc.record_aggregate_materialization
        fi
    }
}

# Check struct literal
pub fn get_struct_literal_shape
    literal:$common::StructLiteral
    store:$common::SymbolStore
-> std::Option[std::List[std::String]] std::List[common::Type] {
    std::List[common::Type]::new = field_types
    if literal.struct_name store.structs.get std::Option::Some(casa_struct) is then
        for field_name in literal.field_order.iter do
            for member in casa_struct.members.iter do
                if field_name member.name == then
                    member.typ.clone field_types.push
                    break
                fi
            done
        done
        casa_struct.type_vars.clone std::Option::Some field_types
    else
        std::Option[std::List[std::String]]::None field_types
    fi
}

impl TypeChecker {
    pub fn check_struct_literal tc:mut$TypeChecker op:mut$common::Op {
        if op.value common::OpValue::StructLiteral(literal) is then
            literal common::StructLiteral::struct_name.clone = name
            if
                name.as_str tc
                    .store
                    .structs
                    .get_str std::Option::Some(casa_struct) is
            then
                for member in casa_struct.members.iter do
                    f"{casa_struct.name}::{member.name}" = accessor_name
                    if
                        op
                            .location
                            .file
                            .as_str accessor_name.as_str tc.store.is_private_from
                    then
                        op.location
                        "Cannot construct a struct with private fields outside its module"
                        common::ErrorKind::InvalidScope tc.diagnostics.record_error
                        break
                    fi
                done
            fi
            tc.store literal get_struct_literal_shape = field_types = type_variables_opt
            if type_variables_opt std::Option::Some(type_variables) is then
                std::Map[std::String common::Type]::new = bindings
                if op.type_hint std::Option::Some(hint) is then
                    if name hint.match_base == then
                        type_variables hint common::aggregate_type_bindings = bindings
                    fi
                fi
                std::Option[std::List[Origin]]::None = origins
                std::Option[std::List[Origin]]::None = cleanup_origins
                # Pop field values in reverse order
                field_types.length = index
                while 0 index != do
                    1 -= index
                    cleanup_origins origins bindings index field_types.get
                    tc.expect_aggregate_value = cleanup_origins = origins
                done
                if 0 type_variables.length != then
                    bindings type_variables name.as_str common::build_resolved_type
                else
                    name common::GenericType::new common::Type::Generic
                fi = result_type
                result_type.clone std::Option::Some = op.type_hint
                tc.store cleanup_origins origins result_type resolve_cleanup_origins = cleanup_origins
                cleanup_origins origins result_type tc.push_value_origins
                op tc.record_aggregate_materialization
            else
                name common::GenericType::new common::Type::Generic tc.stack_push_type
                tc.stack_peek_type.clone std::Option::Some = op.type_hint
            fi
        fi
    }
}

# Instantiate default trait method for a concrete type
pub fn get_default_trait_specialization_parts
    trait_name:$str
    method_name:$str
    store:$common::SymbolStore
-> std::Option[common::TraitMethod] std::List[std::String] std::List[common::TraitMethod] {
    if trait_name store.traits.get_str std::Option::Some(casa_trait) is then
        store casa_trait method_name rules::find_semantic_trait_method = default_method
        casa_trait.type_params.clone = type_parameters
        std::List[common::TraitMethod]::new = declared_methods
        for method in casa_trait.methods.iter do
            method.clone declared_methods.push
        done
        default_method type_parameters declared_methods
    else
        std::Option[common::TraitMethod]::None std::List[std::String]::new std::List[common::TraitMethod]::new
    fi
}

pub fn instantiate_default_trait_method
    semantics:rules::MethodSemantics
    receiver:$common::Type
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    checks:mut$SemanticChecks
-> std::Option[std::String] {
    semantics.function_name.clone = receiver_key
    if receiver_key.as_str store.has_function then
        receiver_key.clone std::Option::Some return
    fi
    store semantics.method_name.as_str semantics.trait_name.as_str get_default_trait_specialization_parts
    = declared_methods = type_params = default_method_opt
    if default_method_opt std::Option::None is then
        std::Option[std::String]::None return
    fi
    default_method_opt.unwrap = default_method

    # Check that receiver implements all abstract methods
    std::List[common::Type]::new = required_trait_arguments
    for type_parameter in type_params.iter do
        type_parameter.clone common::Type::TypeVar required_trait_arguments.push
    done
    required_trait_arguments semantics.trait_name.clone common::GenericType::with_params common::Type::Generic
    = required_trait_type
    if semantics.trait_type std::Option::Some(resolved_trait_type) is then
        resolved_trait_type.clone = required_trait_type
    fi
    if store required_trait_type receiver rules::type_has_semantic_trait_shape ! then
        std::Option[std::String]::None return
    fi

    # Determine function name and whether to use generic or concrete form
    receiver.base = fn_base_opt
    semantics.function_name = synth_fn_name: $std::String

    # Bind trait arguments before specializing the receiver and default body.
    std::Map[std::String common::Type]::new = trait_subs
    receiver.clone = default_self_type
    common::empty_stack_effect = resolved_stack_effect
    if semantics.trait_type std::Option::Some(resolved_trait_type) is then
        if resolved_trait_type.type_params std::Option::Some(trait_args) is then
            for pair in trait_args.iter type_params.list_iter.zip do
                pair.second.clone pair.first.clone trait_subs.set
            done
        fi
    fi
    if fn_base_opt.is_none then
        # Infer trait type params from concrete method stack effects
        std::Set[std::String]::new = type_param_set
        for type_param in type_params.iter do
            type_param.clone type_param_set.add
        done
        for infer_method in declared_methods.iter do
            if infer_method.has_default_body ! then
                store std::Option[common::Function]::None receiver infer_method common::TraitMethod::name.as_str
                rules::resolve_method_semantics = infer_method_opt
                std::Option[CheckedFunction]::None = infer_fn_opt
                if infer_method_opt std::Option::Some(infer_semantics) is then
                    false checks diagnostics store infer_semantics.function_name.as_str
                    ensure_checked_function = infer_fn_opt
                fi
                if infer_fn_opt.is_some then
                    infer_fn_opt.unwrap = infer_fn
                    receiver infer_method common::TraitMethod::stack_effect common::resolve_trait_stack_effect = infer_trait_resolved
                    0 = ret_index: u64
                    while
                        ret_index infer_trait_resolved common::StackEffect::return_types.length < ret_index infer_fn.stack_effect common::StackEffect::return_types.length < &&
                    do
                        type_param_set ret_index infer_fn.stack_effect common::StackEffect::return_types.get ret_index infer_trait_resolved common::StackEffect::return_types.get trait_subs bind_generic_params_standalone = trait_subs
                        1 += ret_index
                    done
                fi
            fi
        done
    fi
    trait_subs receiver default_method common::TraitMethod::stack_effect common::resolve_trait_stack_effect common::apply_type_subs_to_stack_effect = resolved_stack_effect

    # Add trait type params as function type vars for generic receivers
    if fn_base_opt.is_some then
        std::Set[std::String]::new = receiver_type_vars
        receiver_type_vars receiver common::collect_stack_effect_type_vars
        for receiver_type_var in receiver_type_vars.iter do
            receiver_type_var.clone resolved_stack_effect common::StackEffect::type_vars.add
        done
        for type_param in type_params.iter do
            if type_param.as_str trait_subs.has_str ! then
                type_param.clone resolved_stack_effect common::StackEffect::type_vars.add
            fi
        done
    fi

    default_self_type.clone common::TRAIT_SELF_TYPE trait_subs.set_str

    # Add method-level type vars to stack effect
    for method_type_var in default_method common::TraitMethod::type_vars.iter do
        method_type_var.clone resolved_stack_effect common::StackEffect::type_vars.add
    done

    default_method
        .default_function
        .clone
        .unwrap = template_name
    if false checks diagnostics store template_name.as_str ensure_checked_function.is_none then
        std::Option[std::String]::None return
    fi
    template_name.as_str checks
        .functions
        .get_str
        .unwrap match
        FunctionWork::Completed(completed) => completed.body.clone
        _ => std::Option[std::String]::None return
    end = body
    store trait_subs body.substitute
    DefaultSpecializer {
        store: store
        checks: checks
        diagnostics: diagnostics
        bindings: trait_subs
        effect: resolved_stack_effect
        owner: synth_fn_name
        next_lambda: 0
    } = specializer
    body specializer.clone_closures
    template_name.as_str store
        .get_function
        .unwrap
        .clone = template
    trait_subs synth_fn_name.clone template rules::specialize_function_declaration = declaration
    resolved_stack_effect = declaration.stack_effect

    if template_name checks.return_summaries.get std::Option::Some(summary) is then
        summary.clone synth_fn_name.clone checks.return_summaries.set
    fi
    if template_name checks.recursive_functions.has then
        synth_fn_name.clone checks.recursive_functions.add
    fi
    body declaration checked_function_summary CompletedFunction FunctionWork::Completed
    synth_fn_name.clone checks.functions.set
    declaration store.set_generated_recipe

    synth_fn_name.clone std::Option::Some
}

struct DefaultSpecializer {
    store:       mut$common::SymbolStore
    checks:      mut$SemanticChecks
    diagnostics: mut$error::Diagnostics
    bindings:    mut$std::Map[std::String common::Type]
    effect:      $common::StackEffect
    owner:       $std::String
    next_lambda: u64
}

impl DefaultSpecializer {
    fn clone_closures self:mut$DefaultSpecializer body:mut$semantic_body::Body {
        {
            = call: mut$semantic_body::Callable
            call self.clone_closure
        } = visitor
        visitor body.visit_closures
    }

    fn clone_closure self:mut$DefaultSpecializer call:mut$semantic_body::Callable {
        if call.name.as_str "lambda__" str::starts_with ! then
            return
        fi
        if
            false self.checks self.diagnostics self.store call.name.as_str ensure_checked_function.is_none
        then
            return
        fi
        call.name.as_str self
            .checks
            .functions
            .get_str
            .unwrap match
            FunctionWork::Completed(completed) => completed.body.clone
            _ => return
        end = body
        call.name.as_str self
            .store
            .get_function
            .unwrap
            .clone = template
        f"{call.name}__{self.owner}_{self.next_lambda}" = name
        1 += self.next_lambda
        self.bindings name.clone template rules::specialize_function_declaration = declaration
        self
            .effect
            .type_vars
            .clone = declaration.stack_effect.type_vars
        self
            .effect
            .trait_bounds
            .clone = declaration.stack_effect.trait_bounds
        self
            .effect
            .const_params
            .clone = declaration.stack_effect.const_params
        self.store self.bindings body.substitute
        body self.clone_closures
        body declaration checked_function_summary CompletedFunction FunctionWork::Completed name.clone self
            .checks
            .functions
            .set

        declaration self.store.set_generated_recipe
        name = call.name
    }
}

impl TypeChecker {
    pub fn apply_trait_bound_method_semantics
        tc:mut$TypeChecker
        semantics:rules::MethodSemantics
        receiver:$common::Type
        op:mut$common::Op
        emitted_ops:mut$std::List[common::Op]
        function_opt:mut$std::Option[common::Function]
    {
        semantics.method_name.as_str receiver.make_method_key = method_key
        semantics.stack_effect.clone = effect
        function_opt emitted_ops op 0 effect tc.bind_borrowed_temporaries
        function_opt std::Option[common::Type]::None method_key.as_str
        effect tc.apply_stack_effect
        effect semantics.trait_type.clone receiver.clone semantics.method_name.clone
        common::DeferredTraitCall::new common::OpValue::TraitMethodCall op common::Op::set_value
    }
}

# Check method call
impl TypeChecker {
    pub fn check_char_codepoint tc:mut$TypeChecker op:mut$common::Op method_name:$str -> bool {
        if "codepoint" method_name.as_str != then
            false return
        fi
        tc.stack_pop_value = value
        0 value tc.read_scalar_value
        if value.type_value common::make_char_type.eq ! then
            op.location f"Method `codepoint` requires `char`, got `{value.type_value.format}`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        fi
        common::BuiltinType::U32 common::BuiltinType::Char common::NumericConversionKind::ToBits common::NumericConversion
        common::OpValue::NumericConvert op common::Op::set_value
        common::make_u32_type.clone std::Option::Some op common::Op::set_type_hint
        common::make_u32_type tc.stack_push_type
        true
    }

    pub fn check_try_integer_method tc:mut$TypeChecker op:mut$common::Op method_name:$str -> bool {
        if
            "try_add" method_name.as_str ==
            "try_sub" method_name.as_str == ||
            "try_mul" method_name.as_str == ||
            "try_div" method_name.as_str == ||
            "try_mod" method_name.as_str == || !
        then
            false return
        fi
        tc.stack_pop_value = receiver
        0 receiver tc.read_scalar_value
        receiver tc.stack_pop_left_like = other
        1 other tc.read_scalar_value
        common::make_i64_type.clone = target_type
        if receiver.type_value.is_integer_type_t then
            receiver.type_value.clone = target_type
        elif other.type_value.is_integer_type_t then
            other.type_value.clone = target_type
        fi
        if target_type common::Type::Builtin(target) is then
            target_type receiver tc.resolve_integer_value drop
            target_type other tc.resolve_integer_value drop
            method_name.clone match
                "try_add" => common::IntegerTryKind::Add
                "try_sub" => common::IntegerTryKind::Sub
                "try_mul" => common::IntegerTryKind::Mul
                "try_div" => common::IntegerTryKind::Div
                _ => common::IntegerTryKind::Mod
            end = kind
            target kind common::IntegerTry common::OpValue::IntegerTry op common::Op::set_value
            target_type.clone std::Option::Some op common::Op::set_type_hint
            std::List[common::Type]::new = option_params
            target_type.clone option_params.push
            option_params common::STD_OPTION_TYPE.to_str common::GenericType::with_params common::Type::Generic tc.stack_push_type
            true return
        fi
        f"Method requires integer operands, got `{receiver.type_value.format}` and `{other.type_value.format}`" tc.raise_type_mismatch
        common::make_unknown_type tc.stack_push_type
        true
    }

    pub fn check_float_round tc:mut$TypeChecker op:mut$common::Op method_name:$str -> bool {
        if
            "__float_floor" method_name.as_str ==
            "__float_ceil" method_name.as_str == ||
            "__float_trunc" method_name.as_str == ||
            "__float_round" method_name.as_str == || !
        then
            false return
        fi
        tc.stack_pop_value = value
        0 value tc.read_scalar_value
        if value.type_value common::Type::Builtin(target) is then
            if target.is_float then
                target copy method_name.to_str common::FloatRound = rounding
                rounding common::OpValue::FloatRound op common::Op::set_value
                target copy common::Type::Builtin std::Option::Some op common::Op::set_type_hint
                target copy common::Type::Builtin tc.stack_push_type
                true return
            fi
        fi
        op.location f"Method `{method_name}` requires `f32` or `f64`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        common::make_unknown_type tc.stack_push_type
        true
    }

    pub fn check_wrapping_method tc:mut$TypeChecker op:mut$common::Op method_name:$str -> bool {
        if
            "wrapping_add" method_name.as_str ==
            "wrapping_sub" method_name.as_str == ||
            "wrapping_mul" method_name.as_str == || !
        then
            false return
        fi
        tc.stack_pop_value = receiver
        0 receiver tc.read_scalar_value
        receiver tc.stack_pop_left_like = other
        1 other tc.read_scalar_value
        common::make_i64_type.clone = target
        if receiver.type_value.is_integer_type_t then
            receiver.type_value.clone = target
        elif other.type_value.is_integer_type_t then
            other.type_value.clone = target
        fi
        if target.is_integer_type_t ! then
            f"Method requires integer operands, got `{receiver.type_value.format}` and `{other.type_value.format}`" tc.raise_type_mismatch
            false return
        fi
        target receiver tc.resolve_integer_value drop
        target other tc.resolve_integer_value drop
        if "wrapping_add" method_name.as_str == then
            common::OpValue::WrappingAdd op common::Op::set_value
        elif "wrapping_sub" method_name.as_str == then
            common::OpValue::WrappingSub op common::Op::set_value
        else
            common::OpValue::WrappingMul op common::Op::set_value
        fi
        target.clone std::Option::Some op common::Op::set_type_hint
        target tc.stack_push_type
        true
    }

    pub fn check_method_call
        tc:mut$TypeChecker
        op:mut$common::Op
        emitted_ops:mut$std::List[common::Op]
        function_opt:mut$std::Option[common::Function]
    {
        std::Option[std::String]::None = method_name_opt
        op.value.clone = method_value
        if method_value.clone common::OpValue::MethodCall(method_name) is then
            method_name.clone std::Option::Some = method_name_opt
        elif method_value.clone common::OpValue::QualifiedMethodCall(qualified) is then
            qualified.method_name.clone std::Option::Some = method_name_opt
        fi
        if method_name_opt std::Option::Some(method_name) is then
            if "drop" method_name.as_str == then
                op.location "Reserved `drop` methods cannot be called directly; use the `drop` intrinsic" common::ErrorKind::InvalidScope tc.diagnostics.record_error
            fi
            tc.stack_peek_type = receiver
            ValueCapability::Owned = receiver_capability
            if
                0 tc
                    .stack
                    .values
                    .length !=
            then
                tc
                    .stack
                    .values
                    .length 1 - tc
                    .stack
                    .values
                    .get
                    .capability = receiver_capability
            fi
            receiver.clone = lookup_receiver
            if
                receiver.is_shared_borrow
                receiver_capability ValueCapability::Exclusive is &&
            then
                receiver
                    .borrow_target
                    .unwrap
                    .clone = receiver_target
                common::EXCLUSIVE_BORROW_TYPE receiver_target common::apply_borrow_type = lookup_receiver
            elif receiver.is_borrow ! then
                if receiver_capability ValueCapability::Shared is then
                    common::SHARED_BORROW_TYPE receiver.clone common::apply_borrow_type = lookup_receiver
                elif receiver_capability ValueCapability::Exclusive is then
                    common::EXCLUSIVE_BORROW_TYPE receiver.clone common::apply_borrow_type = lookup_receiver
                fi
            fi
            if "clone" method_name.as_str == then
                tc.checks op.location lookup_receiver tc.store ensure_function_clone_method
            fi
            if method_value.clone common::OpValue::MethodCall is then
                if method_name.as_str op tc.check_float_to_bits then
                    return
                fi
                if method_name.as_str op tc.check_char_codepoint then
                    return
                fi
                if method_name.as_str op tc.check_float_round then
                    return
                fi
                if method_name.as_str op tc.check_try_integer_method then
                    return
                fi
                if method_name.as_str op tc.check_wrapping_method then
                    return
                fi
            fi
            method_value.clone = analyzed_method_value
            tc.store function_opt lookup_receiver rules::make_type_borrow_option analyzed_method_value
            rules::analyze_operation = semantics
            semantics tc.record_decision_dependencies
            semantics.into_method match
                std::Option::Some(method_semantics) => {
                    method_semantics.kind = method_kind
                    receiver method_name.as_str receiver_capability method_semantics.stack_effect
                    tc.check_method_receiver_capability = receiver_recovered
                    if method_kind rules::MethodSemanticsKind::TraitBound is then
                        function_opt emitted_ops op receiver method_semantics
                        tc.apply_trait_bound_method_semantics
                        return
                    fi
                    CallStackLayout::ArgumentsOnly method_semantics.stack_effect
                    tc.bind_stack_callable_arguments
                    = method_argument_callables
                    std::List[std::Set[std::String]]::new = method_return_callables
                    CallReturnSummary::new = method_return_summary
                    method_semantics.function_name.clone = fn_name
                    if method_kind rules::MethodSemanticsKind::Function is then
                        fn_name.as_str tc.add_symbol_dependency
                    fi
                    if
                        op
                            .location
                            .file
                            .as_str fn_name.as_str tc.store.is_private_from
                    then
                        op.location f"Method `{fn_name}` is private"
                        common::ErrorKind::InvalidScope tc.diagnostics.record_error_string
                        return
                    fi
                    if method_kind rules::MethodSemanticsKind::DefaultMethod is then
                        receiver.clone = default_receiver
                        if default_receiver.borrow_target std::Option::Some(target) is then
                            target.clone = default_receiver
                        fi
                        method_argument_callables default_receiver method_semantics
                        tc.add_default_method_dependency
                        method_argument_callables method_semantics
                        tc.collect_default_method_return_callables = method_return_callables
                        tc.checks tc.diagnostics tc.store default_receiver method_semantics
                        instantiate_default_trait_method = default_inst_opt
                        if default_inst_opt std::Option::Some(default_name) is then
                            default_name.clone = fn_name
                        fi
                    fi
                    tc.infer_parameters tc.checks tc.diagnostics tc.store fn_name.as_str
                    ensure_checked_function = checked_function_opt
                    checked_function_opt match
                        std::Option::Some(function) => {
                            function.is_non_returning = is_non_returning
                            function.into_parts = is_unsafe = signature
                            signature.get = effect
                            if is_unsafe then
                                fn_name.as_str op tc.require_unsafe
                            fi
                            if
                                0 effect.type_vars.length != 0 effect
                                    .const_params
                                    .length != ||
                            then
                                op.type_hint.clone function_opt op.location effect
                                tc.resolve_generic_call_bindings = op.call_bindings
                            fi
                            function_opt emitted_ops op 0 effect tc.bind_borrowed_temporaries
                            if
                                method_kind rules::MethodSemanticsKind::Function is
                                method_kind rules::MethodSemanticsKind::DefaultMethod is ||
                            then
                                CallStackLayout::ArgumentsOnly effect fn_name.as_str
                                tc.add_stack_aware_call
                                = method_return_summary
                                method_return_summary.callables.clone
                                = method_return_callables
                            fi
                            function_opt op.type_hint.clone fn_name.as_str effect
                            tc.apply_stack_effect
                            method_return_summary tc.apply_call_return_summary
                            method_return_callables tc.stack.set_return_callables
                            receiver_capability fn_name.as_str tc.mark_struct_getter_borrow
                            fn_name common::OpValue::FnCall op common::Op::set_value
                            if is_non_returning then
                                tc.end_path
                            fi
                            return
                        }
                        std::Option::None => {
                        }
                    end
                }
                std::Option::None => {
                }
            end
            method_name.as_str receiver.make_method_key = missing_name
            tc.store receiver method_name.as_str rules::collect_method_qualifiers = qualifiers
            if qualifiers.length 1 > then
                ", " qualifiers.join_strings = qualifier_list
                op.location f"Method `{missing_name}` is ambiguous between `{qualifier_list}`. Use a trait-qualified call"
                common::ErrorKind::TraitSignatureMismatch tc.diagnostics.record_error_string
            else
                op.location f"Method `{missing_name}` does not exist"
                common::ErrorKind::UndefinedName tc.diagnostics.record_error_string
            fi
        fi
    }
}

# Check f-string expression conversion (Display trait dispatch)
impl TypeChecker {
    pub fn check_fstring_to_str
        tc:mut$TypeChecker
        op:mut$common::Op
        emitted_ops:mut$std::List[common::Op]
        function_opt:mut$std::Option[common::Function]
    {
        "value with trait `Display`".to_str ExpectationContext::Text = tc.current_expect_ctx
        tc.stack_peek_type = fstring_type_t
        fstring_type_t.clone = fstring_value_type
        if fstring_value_type.borrow_target std::Option::Some(target) is then
            target.clone = fstring_value_type
        fi
        if common::make_string_type fstring_value_type.eq then
            tc
                .stack
                .values
                .length 1 - tc
                .stack
                .values
                .get = string_value
            if string_value.capability ValueCapability::Owned is then
                return
            fi
            "clone".to_str common::OpValue::MethodCall op common::Op::set_value
            function_opt emitted_ops op tc.check_method_call
            return
        fi
        if common::make_str_type fstring_value_type.eq then
            "to_str".to_str common::OpValue::MethodCall op common::Op::set_value
            function_opt emitted_ops op tc.check_method_call
            return
        fi
        fstring_type_t.format = fstring_type
        if common::TYPE_MISSING fstring_type.as_str == common::TYPE_UNKNOWN fstring_type.as_str == || then
            tc.stack_pop_drop
            common::make_string_type tc.stack_push_type
            return
        fi
        if fstring_value_type common::Type::Builtin(builtin) is then
            if
                builtin.is_integer
                builtin common::BuiltinType::Bool == ||
                builtin common::BuiltinType::Char == ||
            then
                builtin common::OpValue::PrimitiveToStr op common::Op::set_value
                tc.stack_pop_value = value
                0 fstring_value_type value tc.record_scalar_input
                value tc.finish_value_use
                common::make_string_type tc.stack_push_type
                return
            fi
        fi
        common::STD_DISPLAY_TRAIT.to_str common::GenericType::new common::Type::Generic = display_type
        if
            tc.checks tc.diagnostics tc.store function_opt display_type fstring_value_type check_trait_satisfaction !
        then
            op common::Op::location f"Type `{fstring_type}` cannot be used in f-string: does not satisfy trait `Display`" common::ErrorKind::MissingTraitMethod tc.diagnostics.record_error_string
            tc.stack_pop_drop
            common::make_string_type tc.stack_push_type
            return
        fi
        common::STD_DISPLAY_TRAIT tc.add_symbol_dependency
        "to_str".to_str common::OpValue::MethodCall op common::Op::set_value
        function_opt emitted_ops op tc.check_method_call
    }
}

# Ensure a function is typechecked
# The private active owner keeps the recipe alive through recursive specialization.
pub struct ActiveSpecialization {
    name:     std::String
    function: CompletedFunction
}

impl ActiveSpecialization {
    pub fn get_body_mut self:mut$ActiveSpecialization -> mut$semantic_body::Body {
        self.function.body
    }

    pub fn complete self:ActiveSpecialization checks:mut$SemanticChecks {
        self match
            ActiveSpecialization { name: name function: function } => {
                function FunctionWork::Completed name checks.functions.set
            }
        end
    }
}

struct CompletedFunction derives std::Clone {
    signature: CheckedFunction
    body:      semantic_body::Body
}

impl CompletedFunction {
    fn into_body self:CompletedFunction -> semantic_body::Body {
        self match
            CompletedFunction { body: body } => body
        end
    }
}

pub struct CheckedFunction derives std::Clone {
    signature:        shared::Shared[common::StackEffect]
    is_unsafe:        bool
    is_non_returning: bool
}

impl CheckedFunction {
    pub fn stack_effect self:$CheckedFunction -> $common::StackEffect { self.signature.get }

    pub fn into_parts self:CheckedFunction -> shared::Shared[common::StackEffect] bool {
        self match
            CheckedFunction { signature: signature is_unsafe: is_unsafe } => signature is_unsafe
        end
    }
}

fn checked_function_summary function:$common::Function -> CheckedFunction {
    CheckedFunction { signature: function.stack_effect.clone shared::Shared[common::StackEffect]::new is_unsafe: function.is_unsafe is_non_returning: function.is_non_returning }
}

fn mark_recursive_cycle
    checking:$std::List[std::String]
    recursive:mut$std::Set[std::String]
    function_name:$str
{
    false = in_cycle
    for active in checking.iter do
        active.as_str function_name == in_cycle || = in_cycle
        if in_cycle then
            active.clone recursive.add
        fi
    done
}

fn ensure_checked_function
    function_name:$str
    store:mut$common::SymbolStore
    diagnostics:mut$error::Diagnostics
    checks:mut$SemanticChecks
    infer_parameters:bool
-> std::Option[CheckedFunction] {
    if function_name store.get_function std::Option::Some(existing) is then
        if function_name checks.functions.get_str std::Option::Some(status) is then
            if status FunctionWork::Rejected is then
                existing
                    .location
                    .file
                    .as_str function_name store.format_name_for_source = source_name
                existing.location f"Function `{source_name}` did not pass checking"
                common::ErrorKind::TypeMismatch diagnostics.record_error_string
                std::Option[CheckedFunction]::None return
            fi
            if status FunctionWork::Reserved is then
                function_name checks.recursive_functions checks.checking_functions mark_recursive_cycle
            fi
            if status.get_signature std::Option::Some(signature) is then
                signature.clone std::Option::Some return
            fi
        fi
        if existing.extern_symbol.is_some then
            existing checked_function_summary std::Option::Some return
        fi
        if function_name store.member_accessors.get_str std::Option::Some(accessor) is then
            existing checked_function_summary = signature
            existing.clone = declaration
            accessor.clone = member
            store declaration member semantic_body::make_accessor_body = body
            body signature.clone CompletedFunction FunctionWork::Completed function_name.to_str checks.functions.set
            signature std::Option::Some return
        fi
    fi
    function_name store.get_function match
        std::Option::Some(declaration) => declaration.clone
        std::Option::None => std::Option[CheckedFunction]::None return
    end = function
    function checks.begin_function = active
    infer_parameters checks std::Set[std::String]::new
    std::Map[std::String std::Set[std::String]]::new diagnostics store active.check = checked
    if checked.is_valid ! then
        std::Option[CheckedFunction]::None return
    fi
    function_name checks
        .functions
        .get_str
        .unwrap
        .get_signature
        .unwrap
        .clone std::Option::Some
}

# The active frame consumes source and publishes the declaration with its completed body.
# Recursion can observe the reserved signature, never this frame's mutable operations.
struct ActiveFunction {
    declaration: common::Function
    source:      source_body::SourceBody
}

impl ActiveFunction {
    fn check
        self:ActiveFunction
        store:mut$common::SymbolStore
        diagnostics:mut$error::Diagnostics
        argument_callables:$std::Map[std::String std::Set[std::String]]
        active_calls:std::Set[std::String]
        checks:mut$SemanticChecks
        infer_parameters:bool
    -> CheckedOperations {
        self match
            ActiveFunction { declaration: declaration source: source } => {
                declaration std::Option::Some = function_opt
                body_builder::Builder::new = operations
                infer_parameters checks active_calls argument_callables
                false diagnostics store function_opt operations source analyze_ops = checked
                checks.checking_functions.pop drop
                function_opt.unwrap = function
                if
                    function.name.as_str "lambda__" str::starts_with
                    function.stack_effect common::stack_effect_to_str.as_str "None -> None" == ||
                then
                    checked.inferred_effect.clone = function.stack_effect
                fi
                function.name.clone = name
                if checked.is_valid then
                    store function.stack_effect checked.return_origin_summaries format_borrow_sources
                    = function.borrow_sources
                fi
                if name checks.recursive_functions.has then
                    if function.borrow_sources.is_some then
                        "Borrow sources: conservative (recursive call cycle)".to_str std::Option::Some
                        = function.borrow_sources
                    fi
                fi
                function checked_function_summary = signature
                function store.set_function
                if checked.is_valid then
                    store operations.into_body.unwrap = body
                    body signature CompletedFunction FunctionWork::Completed name.clone checks.functions.set
                    checked.return_origin_summaries.clone checked.return_callables.clone CallReturnSummary
                    name checks.return_summaries.set
                    checks.settle_return_callables
                else
                    operations RejectedBody::Partial FunctionWork::Rejected name checks.functions.set
                fi
                checked
            }
        end
    }
}

fn default_unconstrained_aggregate
    typ:$common::Type
    function_opt:$std::Option[common::Function]
-> common::Type {
    std::Set[std::String]::new = variables
    variables typ common::collect_stack_effect_type_vars
    std::Map[std::String common::Type]::new = defaults
    for name in variables.iter do
        if function_opt std::Option::Some(function) is then
            if
                name function
                    .stack_effect
                    .type_vars
                    .has
            then
                continue
            fi
        fi
        common::make_i64_type name.clone defaults.set
    done
    defaults typ.substitute_t
}

pub fn implements_copy typ:$common::Type store:$common::SymbolStore -> bool {
    common::STD_COPY_TRAIT.to_str common::GenericType::new common::Type::Generic = copy_type
    store copy_type typ rules::type_has_satisfying_trait_impl
}

pub fn validate_extern_structs store:$common::SymbolStore diagnostics:mut$error::Diagnostics {
    for
        casa_struct in store
            .structs
            .values
            .iter
    do
        if casa_struct.is_extern ! then
            continue
        fi
        if 0 casa_struct.type_vars.length != then
            casa_struct.location f"Extern struct `{casa_struct.name}` cannot have type parameters"
            common::ErrorKind::TypeMismatch diagnostics.record_error_string
        fi
        if casa_struct.members.is_empty then
            casa_struct.location f"Extern struct `{casa_struct.name}` must contain at least one field"
            common::ErrorKind::TypeMismatch diagnostics.record_error_string
        fi
        for member in casa_struct.members.iter do
            if store member.typ common::type_is_extern_struct_field ! then
                casa_struct.location
                f"Extern struct field `{casa_struct.name}.{member.name}` type `{member.typ.format}` is not C-ABI safe"
                common::ErrorKind::TypeMismatch diagnostics.record_error_string
            fi
        done
    done
}

pub fn validate_extern_functions store:mut$common::SymbolStore diagnostics:mut$error::Diagnostics {
    for function_name in store.get_function_names.iter do
        function_name.as_str store.get_function.unwrap = function
        if function.extern_symbol.is_none then
            continue
        fi
        for
            parameter in function
                .stack_effect
                .parameters
                .iter
        do
            if store parameter.typ common::type_is_extern_parameter ! then
                parameter.typ.format = type_name
                function.location f"Extern parameter type `{type_name}` is not C-ABI safe"
                common::ErrorKind::TypeMismatch diagnostics.record_error_string
                continue
            fi
            if store parameter.typ common::type_is_extern_struct then
                if store parameter.typ implements_copy ! then
                    parameter.typ.format = type_name
                    function.location
                    f"Extern parameter type `{type_name}` must implement `Copy` for by-value passing"
                    common::ErrorKind::TypeMismatch diagnostics.record_error_string
                fi
            fi
        done
        for
            return_type in function
                .stack_effect
                .return_types
                .iter
        do
            if store return_type common::type_is_extern_value ! then
                return_type.format = type_name
                function.location f"Extern return type `{type_name}` is not C-ABI safe"
                common::ErrorKind::TypeMismatch diagnostics.record_error_string
            fi
        done
    done
}

fn resolve_returned_callables
    returned:$std::Set[std::String]
    arguments:$std::Map[std::String std::Set[std::String]]
-> std::Set[std::String] {
    std::Set[std::String]::new = resolved
    for callable in returned.iter do
        if callable.as_str CALLABLE_PARAMETER_PREFIX str::starts_with ! then
            callable.clone resolved.add
            continue
        fi
        CALLABLE_PARAMETER_PREFIX.length = prefix_length
        callable.as_str prefix_length callable.length prefix_length - str::substring = parameter
        if parameter.as_str arguments.get_str std::Option::Some(inputs) is then
            for input in inputs.iter do
                input.clone resolved.add
            done
        fi
    done
    resolved
}

impl TypeChecker {
    fn bind_stack_callable_arguments
        self:$TypeChecker
        effect:$common::StackEffect
        layout:$CallStackLayout
    -> std::Map[std::String std::Set[std::String]] {
        std::Map[std::String std::Set[std::String]]::new = argument_callables
        layout.get_argument_offset = offset
        for parameter in effect.parameters.iter do
            if
                offset self
                    .stack
                    .values
                    .length >=
            then
                break
            fi
            self
                .stack
                .values
                .length 1 - offset - self
                .stack
                .values
                .get = argument
            if "" parameter.name.as_str != then
                argument.callables.clone parameter.name.clone argument_callables.set
            fi
            1 += offset
        done
        argument_callables
    }

    fn has_callable_arguments
        argument_callables:$std::Map[std::String std::Set[std::String]]
    -> bool {
        for callables in argument_callables.values.iter do
            if callables.is_empty ! then
                true return
            fi
        done
        false
    }

    fn merge_return_callables
        merged:mut$std::List[std::Set[std::String]]
        incoming:$std::List[std::Set[std::String]]
    {
        if merged.is_empty then
            incoming.clone merged.append
            return
        fi
        if merged.length incoming.length != then
            return
        fi
        0 = index: u64
        while index merged.length < do
            index merged.get_mut = merged_callables
            for callable in index incoming.get.iter do
                callable.clone merged_callables.add
            done
            1 += index
        done
    }

    fn merge_return_origin_summaries
        merged:mut$std::List[ReturnOriginSummary]
        incoming:$std::List[ReturnOriginSummary]
    {
        if merged.is_empty then
            incoming.clone merged.append
            return
        fi
        if merged.length incoming.length != then
            return
        fi
        0 = index: u64
        while index merged.length < do
            index merged.get_mut = target
            index incoming.get = source
            source.origins target.origins.clone merge_origins = target.origins
            source.cleanup_origins target.cleanup_origins.clone merge_origins
            = target.cleanup_origins
            1 += index
        done
    }

    fn merge_call_return_summaries merged:mut$CallReturnSummary incoming:$CallReturnSummary {
        incoming.callables merged.callables TypeChecker::merge_return_callables
        incoming.origins merged.origins TypeChecker::merge_return_origin_summaries
    }

    fn collect_return_origin_summaries stack:$TypedStack -> std::List[ReturnOriginSummary] {
        std::List[ReturnOriginSummary]::new = summaries
        for value in stack.values.iter do
            value.cleanup_origins.clone value.origins.clone ReturnOriginSummary summaries.push
        done
        summaries
    }

    # Substitute stable results immediately and retain an equation for recursive results.
    fn collect_function_return_summary
        self:mut$TypeChecker
        function_name:$str
        argument_callables:$std::Map[std::String std::Set[std::String]]
    -> CallReturnSummary {
        CallReturnSummary::new = summary
        false = pending
        if
            function_name self
                .checks
                .return_summaries
                .get_str std::Option::Some(saved) is
        then
            if
                function_name self
                    .checks
                    .recursive_functions
                    .has_str !
            then
                saved.origins.clone = summary.origins
            fi
            for returned in saved.callables.iter do
                returned self.checks.resolve_callables = targets
                if targets self.checks.has_pending_callables then
                    true = pending
                fi
                argument_callables targets resolve_returned_callables summary.callables.push
            done
        elif
            function_name self
                .checks
                .functions
                .get_str std::Option::Some(work) is
        then
            work FunctionWork::Reserved is = pending
        fi
        if pending then
            function_name self
                .store
                .get_function
                .unwrap
                .stack_effect
                .return_types
            argument_callables function_name self.checks.defer_return_callables = summary.callables
        fi
        summary
    }

    fn find_call_argument
        self:$TypeChecker
        effect:$common::StackEffect
        parameter_name:$str
        layout:$CallStackLayout
    -> std::Option[TypedValue] {
        0 = parameter_index: u64
        for parameter in effect.parameters.iter do
            if parameter_name.as_str parameter.name.as_str == then
                layout.get_argument_offset = offset
                if
                    offset parameter_index + self
                        .stack
                        .values
                        .length >=
                then
                    std::Option[TypedValue]::None return
                fi
                self
                    .stack
                    .values
                    .length 1 - offset - parameter_index - = stack_index
                stack_index self
                    .stack
                    .values
                    .get
                    .clone std::Option::Some return
            fi
            1 += parameter_index
        done
        std::Option[TypedValue]::None
    }

    fn merge_dependency_origins
        target:std::Option[std::List[Origin]]
        source:$std::Option[std::List[Origin]]
        exclusive:bool
        preserve_capability:bool
    -> std::Option[std::List[Origin]] {
        if source std::Option::Some(origins) is then
            for origin in origins.iter do
                exclusive = result_exclusive
                if preserve_capability exclusive ! && then
                    origin.exclusive = result_exclusive
                fi
                result_exclusive origin.with_capability = adjusted
                adjusted target append_origin = target
            done
        fi
        target
    }

    fn resolve_origin_dependency
        self:$TypeChecker
        effect:$common::StackEffect
        origin:$Origin
        resolved:std::Option[std::List[Origin]]
        layout:$CallStackLayout
    -> std::Option[std::List[Origin]] {
        origin = dependency: $Origin
        layout dependency
            .place
            .binding
            .as_str effect self.find_call_argument = argument
        if argument.is_none then
            if layout CallStackLayout::CallableOnTop is then
                self
                    .stack
                    .values
                    .length 1 - self
                    .stack
                    .values
                    .get = callable
                if dependency.kind OriginKind::InputCleanup is then
                    true dependency.exclusive callable.cleanup_origins resolved
                    TypeChecker::merge_dependency_origins return
                fi
                true dependency.exclusive callable.origins resolved
                TypeChecker::merge_dependency_origins return
            fi
            origin.clone resolved append_origin return
        fi
        argument.unwrap = value
        if dependency.kind OriginKind::InputCleanup is then
            true dependency.exclusive value.cleanup_origins resolved TypeChecker::merge_dependency_origins return
        fi
        if dependency.kind OriginKind::InputPayload is then
            value.place value.origins resolved merge_contained_origins return
        fi
        if dependency.kind OriginKind::InputOrigins is then
            true dependency.exclusive value.origins resolved TypeChecker::merge_dependency_origins = resolved
            if value needs_storage_origin then
                value resolved dependency effect self.ownership.resolve_input_storage_origin return
            fi
            resolved return
        fi
        # Borrow the input storage without strengthening loans carried inside it.
        dependency.exclusive false value.origins resolved TypeChecker::merge_dependency_origins = resolved
        if
            value.origins.is_some value.capability ValueCapability::Owned is ! && value needs_storage_origin ! &&
        then
            resolved return
        fi
        dependency.exclusive value.place resolved self.ownership.add_storage_origins
    }

    fn resolve_origin_dependencies
        self:$TypeChecker
        effect:$common::StackEffect
        symbolic:$std::Option[std::List[Origin]]
        layout:$CallStackLayout
    -> std::Option[std::List[Origin]] {
        std::Option[std::List[Origin]]::None = resolved
        if symbolic std::Option::Some(origins) is then
            for origin in origins.iter do
                layout resolved origin effect self.resolve_origin_dependency = resolved
            done
        fi
        resolved
    }

    fn resolve_call_return_summary
        self:$TypeChecker
        effect:$common::StackEffect
        symbolic:CallReturnSummary
        layout:$CallStackLayout
    -> CallReturnSummary {
        std::List[ReturnOriginSummary]::new = origins
        for returned in symbolic.origins.iter do
            layout returned.origins effect self.resolve_origin_dependencies = resolved_origins
            layout returned.cleanup_origins effect self.resolve_origin_dependencies
            = resolved_cleanup_origins
            resolved_cleanup_origins resolved_origins ReturnOriginSummary origins.push
        done
        symbolic match
            CallReturnSummary { callables: callables } => callables
        end = callables
        origins callables CallReturnSummary
    }

    fn apply_call_return_summary self:mut$TypeChecker summary:$CallReturnSummary {
        if
            summary.origins.length self
                .stack
                .values
                .length >
        then
            return
        fi
        self
            .stack
            .values
            .length summary.origins.length - = start
        0 = index: u64
        while index summary.origins.length < do
            start index + self
                .stack
                .values
                .get
                .type_value
                .clone = return_type
            index summary.origins.get = returned
