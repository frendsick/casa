}

pub fn analyze_source_root_semantics
    source:source_body::SourceBody
    session:mut$SemanticSession
-> RootSemantics {
    body_builder::Builder::new = checked_ops
    std::Option[common::Function]::None = function_opt
    error::Diagnostics::new = diagnostics
    false session.checks
    std::Set[std::String]::new
    std::Map[std::String std::Set[std::String]]::new
    true diagnostics session.store function_opt checked_ops source analyze_ops = checked
    if checked.is_valid then
        session.store checked_ops.into_body.unwrap AnalysisBody::Checked
    else
        checked_ops AnalysisBody::Rejected
    fi = body
    RootSemantics {
        ordered_facts: checked.ordered_facts.clone session.checks.resolve_dependency_callables
        inferred_effect: checked.inferred_effect.clone
        body: body
        diagnostics: diagnostics
        return_callables: checked.return_callables session.checks.resolve_callable_targets
    }
}

# Abstract callers can retain only the storage loans visible in the return type.
fn allows_storage_borrow typ:$common::Type exclusive:bool store:mut$common::SymbolStore -> bool {
    store typ get_borrow_shape = shape
    if shape CAPTURED_BORROW_SHAPE & 0 != then
        true return
    fi
    if exclusive then
        shape EXCLUSIVE_BORROW_SHAPE & 0 !=
    else
        shape SHARED_BORROW_SHAPE EXCLUSIVE_BORROW_SHAPE | & 0 !=
    fi
}

# An explicit fn contract erases body-specific sources. Specialization cannot
# hide a storage loan that its generic caller was never required to retain.
fn hides_callable_storage_borrow
    declared:$common::Type
    resolved:$common::Type
    store:mut$common::SymbolStore
-> bool {
    if declared common::Type::Function(contract) is then
        if resolved common::Type::Function(actual) is then
            for parameter in contract.parameters.iter do
                if parameter.is_borrow ! then
                    continue
                fi
                for
                    pair in actual.return_types.iter contract
                        .return_types
                        .list_iter
                        .zip
                do
                    store pair.second get_borrow_shape = actual_shape
                    actual_shape EXCLUSIVE_BORROW_SHAPE CAPTURED_BORROW_SHAPE | & 0 !=
                    parameter.is_exclusive_borrow && = exclusive
                    if actual_shape 0 != store exclusive pair.first allows_storage_borrow ! && then
                        true return
                    fi
                done
            done
            for
                pair in actual.parameters.iter contract
                    .parameters
                    .list_iter
                    .zip
            do
                if store pair.second pair.first hides_callable_storage_borrow then
                    true return
                fi
            done
            for
                pair in actual.return_types.iter contract
                    .return_types
                    .list_iter
                    .zip
            do
                if store pair.second pair.first hides_callable_storage_borrow then
                    true return
                fi
            done
        fi
    elif declared common::Type::Generic(contract) is then
        if resolved common::Type::Generic(actual) is then
            for
                pair in actual.params.iter contract
                    .params
                    .list_iter
                    .zip
            do
                if store pair.second pair.first hides_callable_storage_borrow then
                    true return
                fi
            done
        fi
    fi
    false
}

fn trait_return_borrows_match
    contract:$common::StackEffect
    implementation:$common::StackEffect
    summary:$CallReturnSummary
    store:mut$common::SymbolStore
-> bool {
    for
        pair in implementation.parameters.iter contract
            .parameters
            .list_iter
            .zip
    do
        if store pair.second.typ pair.first.typ hides_callable_storage_borrow then
            false return
        fi
    done
    for
        pair in implementation.return_types.iter contract
            .return_types
            .list_iter
            .zip
    do
        if store pair.second pair.first hides_callable_storage_borrow then
            false return
        fi
    done
    0 = index: u64
    for returned in summary.origins.iter do
        if contract.return_types.length index <= then
            false return
        fi
        if implementation.return_types.length index <= then
            false return
        fi
        index implementation.return_types.get = actual
        if store actual get_borrow_shape 0 == then
            1 += index
            continue
        fi
        index contract.return_types.get = declared
        returned.cleanup_origins returned.origins.clone merge_origins = origins
        if origins std::Option::Some(items) is then
            for origin in items.iter do
                if origin.kind OriginKind::Place is ! then
                    continue
                fi
                for
                    pair in implementation.parameters.iter contract
                        .parameters
                        .list_iter
                        .zip
                do
                    if
                        pair
                            .first
                            .typ
                            .is_borrow origin.place.binding pair.second.name == &&
                        store origin.exclusive declared allows_storage_borrow ! &&
                    then
                        false return
                    fi
                done
            done
        fi
        1 += index
    done
    true
}

impl TypeChecker {
    # Establish declaration identity once, while the binding's lexical frame is open.
    fn record_source_binding
        self:mut$TypeChecker
        operation:$common::Op
        name:$str
        typ:$common::Type
        function:$std::Option[common::Function]
    {
        if name common::is_internal_variable_name then
            return
        fi
        if name self.scope.find_scope_binding std::Option::Some(binding) is then
            if binding.source_identity.is_some then
                return
            fi
        else
            return
        fi
        operation.location.clone = declaration
        std::Option[common::Location]::None = owner
        if function std::Option::Some(enclosing) is then
            enclosing.location.clone std::Option::Some = owner
            if declaration enclosing.location.matches then
                name enclosing.find_parameter_location = parameter
                if parameter.is_none then
                    return
                fi
                parameter.unwrap = declaration
            fi
        fi
        std::List[common::Location]::new = alternatives
        operation.value match
            common::OpValue::IsCheck(variant) => {
                name variant.clone common::PatternValue::EnumVariant pattern::find_binding match
                    std::Option::Some(location) => location = declaration
                    std::Option::None => return
                end
            }
            common::OpValue::MatchArm(arm) => {
                name arm.pattern_value pattern::binding_locations = alternatives
                name arm.pattern_value pattern::find_binding match
                    std::Option::Some(location) => location = declaration
                    std::Option::None => return
                end
            }
            _ => {
            }
        end
        self
            .checks
            .bindings
            .declarations
            .length = identity
        declaration self.get_binding_visibility = visibility
        alternatives false typ resolve_numeric_literal_default visibility owner declaration name.to_str operation.id
        name typ self.format_callable_borrow_sources binding::Binding self
            .checks
            .bindings
            .declarations
            .push
        identity name self.scope.set_source_identity
    }

    fn get_binding_visibility self:$TypeChecker declaration:$common::Location -> common::Location {
        declaration.clone = visibility
        # A for binding is inside a generated match arm. Its source scope
        # still starts after the enclosing loop's do token.
        self.branched_stacks.length = index
        while index 0 != do
            1 -= index
            index self.branched_stacks.get = frame
            if frame BranchFrame::BranchWhile(loop) is then
                if visibility.span.offset loop.body_start < then
                    visibility.span.length loop.body_start visibility.with_span = visibility
                fi
                break
            fi
        done
        visibility
    }

    fn record_source_reference self:mut$TypeChecker operation:$common::Op {
        operation.value match
            common::OpValue::AssignVar(name) => name.as_str
            common::OpValue::AssignInc(name) => name.as_str
            common::OpValue::AssignDec(name) => name.as_str
            common::OpValue::PushVar(name) => name.as_str
            common::OpValue::PushCapture(name) => name.as_str
            _ => return
        end = name
        if name self.scope.find_scope_binding std::Option::Some(binding) is then
            if binding.source_identity std::Option::Some(identity) is then
                name binding.typ self.format_callable_borrow_sources
                identity copy binding::BindingReference operation.id self
                    .checks
                    .bindings
                    .references
                    .set
            fi
        fi
    }

    fn close_source_bindings self:mut$TypeChecker end_offset:u64 first_identity:u64 {
        for
            name in self
                .scope
                .current_names
                .iter
        do
            name.as_str self
                .scope
                .find_scope_binding
                .unwrap = scoped
            if scoped.source_identity std::Option::Some(identity) is then
                if first_identity identity copy > then
                    continue
                fi
                end_offset identity copy self
                    .checks
                    .bindings
                    .declarations
                    .get_mut
                    .close_visibility
            fi
        done
    }

    fn close_source_function self:mut$TypeChecker function:$std::Option[common::Function] {
        for
            scoped in self
                .scope
                .function_bindings
                .values
                .iter
        do
            if scoped.source_identity.is_none then
                continue
            fi
            scoped
                .source_identity
                .clone
                .unwrap self
                .checks
                .bindings
                .declarations
                .get_mut = binding
            18446744073709551615 = end_offset: u64
            if function std::Option::Some(enclosing) is then
                if enclosing binding.belongs_to ! then
                    continue
                fi
                self
                    .current_location
                    .span
                    .offset self
                    .current_location
                    .span
                    .length + 1 +
                enclosing
                    .body_end
                    .clone
                    .unwrap_or = end_offset
            fi
            end_offset binding.close_visibility
        done
    }
}

impl common::Function {
    fn find_parameter_location self:$common::Function name:$str -> std::Option[common::Location] {
        for
            parameter in self
                .stack_effect
                .parameters
                .iter
        do
            if parameter.name name == then
                parameter.location.clone return
            fi
        done
        std::Option[common::Location]::None
    }
}

fn apply_body_literal_hints body:mut$body_builder::Builder resolutions:$std::Map[i64 common::Type] {
    {
        = operation: mut$common::Op
        if operation.id resolutions.get std::Option::Some(target) is then
            target.clone std::Option::Some = operation.type_hint
        fi
    } = visitor
    visitor body.visit_operations_mut
}

impl TypeChecker {
    fn check_generated_leaf
        self:mut$TypeChecker
        operation:common::Op
        emitted:mut$body_builder::Builder
        function:mut$std::Option[common::Function]
    {
        std::List[common::Op]::new = pending
        function emitted pending std::Option[SourceWork]::None operation self.check_work_operation drop
    }

    # The hidden owner is consumed on exactly one continuing or returning path.
    fn check_question_tail
        self:mut$TypeChecker
        origin:common::Location
        hidden_name:$str
        emitted:mut$body_builder::Builder
        function:mut$std::Option[common::Function]
    {
        function match
            std::Option::Some(declaration) => 0 declaration
                .stack_effect
                .return_types
                .get
                .clone
            std::Option::None => "Checked question has no function" panic
        end = return_type
        function common::OpValue::IfStart origin.clone self.check_source_boundary = entry
        body_builder::Builder::new = condition
        function condition origin.clone hidden_name.to_str common::OpValue::PushVar common::Op::new self.check_generated_leaf
        function condition origin.clone "is_ok".to_str common::OpValue::MethodCall common::Op::new self.check_generated_leaf
        function condition origin.clone common::OpValue::Not common::Op::new self.check_generated_leaf
        function common::OpValue::IfCondition origin.clone self.check_source_boundary = test
        body_builder::Builder::new = consequent
        function consequent origin.clone hidden_name.to_str common::OpValue::PushVar common::Op::new self.check_generated_leaf
        origin.clone "propagate".to_str common::OpValue::MethodCall common::Op::new = propagate
        return_type std::Option::Some = propagate.type_hint
        function consequent propagate self.check_generated_leaf
        function consequent origin.clone hidden_name.to_str common::OpValue::QuestionMove common::Op::new self.check_generated_leaf
        function consequent origin.clone common::OpValue::FnReturn common::Op::new self.check_generated_leaf
        function common::OpValue::IfEnd origin.clone self.check_source_boundary = exit
        consequent test condition entry body_builder::Branch = branch
        exit std::Option[body_builder::Alternative]::None[
            branch,
        ] std::List::from_array body_builder::Part::Conditional emitted.push
        function emitted origin.clone hidden_name.to_str common::OpValue::PushVar common::Op::new self.check_generated_leaf
        function emitted origin.clone "unwrap".to_str common::OpValue::MethodCall common::Op::new self.check_generated_leaf
        function emitted origin hidden_name.to_str common::OpValue::QuestionMove common::Op::new self.check_generated_leaf
    }
}

fn format_borrow_sources
    summaries:$std::List[ReturnOriginSummary]
    effect:$common::StackEffect
    store:mut$common::SymbolStore
-> std::Option[std::String] {
    if summaries.is_empty effect.return_types.is_empty ! && then
        "Borrow sources: conservative (no established source summary)".to_str std::Option::Some return
    fi
    std::String::new = description
    0 = output_index: u64
    for returned in summaries.iter do
        output_index effect.return_types.get = return_type
        if return_type.has_unresolved_type_var store return_type get_borrow_shape 0 != || then
            returned.cleanup_origins returned.origins.clone merge_origins = origins
            std::List[std::String]::new = sources
            std::Set[std::String]::new = source_names
            std::List[Origin]::new origins.unwrap_or = items
            for origin in items.iter do
                origin
                    .place
                    .binding
                    .clone source_names.add
            done
            0 = input_index: u64
            for parameter in effect.parameters.iter do
                if parameter.name source_names.has then
                    f"input {input_index 1 +}" sources.push
                    parameter.name source_names.remove
                fi
                1 += input_index
            done
            if source_names.is_empty ! then
                "captures".to_str sources.push
            fi
            if description.is_empty then
                "Borrow sources (inferred):" description.append
            fi
            if sources.is_empty then "none".to_str else ", " sources.join_strings fi = source_text
            f"\n  output {output_index 1 +}: {source_text}".as_str description.append
        fi
        1 += output_index
    done
    if description.is_empty then
        std::Option[std::String]::None
    else
        description std::Option::Some
    fi
}

impl TypeChecker {
    fn format_callable_borrow_sources
        self:$TypeChecker
        typ:$common::Type
        name:$str
    -> std::Option[std::String] {
        if typ is_callable_contract ! then
            std::Option[std::String]::None return
        fi
        name self.callable_bindings.get_str match
            std::Option::Some(value) => value
            std::Option::None => std::Option[std::String]::None return
        end = callables
        if CALLABLE_CONTRACT callables.has_str then
            "Borrow sources: conservative (explicit fn contract)".to_str std::Option::Some return
        fi
        std::String::new = description
        for callable in callables.iter do
            callable.as_str self.store.get_function match
                std::Option::Some(value) => value
                std::Option::None => continue
            end = function
            if function.borrow_sources std::Option::Some(sources) is then
                if description.is_empty ! then
                    "\n" description.append
                fi
                sources.as_str description.append
            fi
        done
        if description.is_empty then
            std::Option[std::String]::None
        else
            description std::Option::Some
        fi
    }
}

fn is_callable_contract typ:$common::Type -> bool {
    if typ.borrow_target std::Option::Some(target) is then
        target.is_function return
    fi
    typ.is_function
}

# Keep a borrowed container separate from the loans stored inside it.
fn make_borrowed_input_origins
    typ:$common::Type
    name:$str
    store:mut$common::SymbolStore
-> std::Option[std::List[Origin]] {
    typ.is_exclusive_borrow name Place::new std::Option[std::List[Origin]]::None add_origin = origins
    if typ.borrow_target std::Option::Some(target) is then
        if target.has_unresolved_type_var store target get_borrow_shape 0 != || then
            false OriginKind::InputPayload name Place::new Origin = payload
            payload origins append_origin = origins
        fi
    fi
    origins
}

# Function types retain parameter positions. Checked summaries use source names.
fn copy_parameter_names target:mut$common::StackEffect source:$common::StackEffect {
    0 = index: u64
    for parameter in source.parameters.iter do
        if index target.parameters.length < then
            index target.parameters.get_mut = target_parameter
            parameter.name.clone = target_parameter.name
        fi
        1 += index
    done
}

fn resolve_pattern_payload_type
    pattern_value:$common::PatternValue
    name:$str
    subject_type:$common::Type
    store:$common::SymbolStore
-> std::Option[common::Type] {
    pattern_value match
        common::PatternValue::Binding(binding) => {
            if binding.name name == then
                subject_type.clone std::Option::Some return
            fi
        }
        common::PatternValue::Struct(struct_pattern) => {
            store struct_pattern.struct_name.as_str subject_type resolve_struct_pattern_field_types match
                std::Option::Some(types) => types
                std::Option::None => std::Option[common::Type]::None return
            end = types
            for field in struct_pattern.bindings.iter do
                if field.first types.get std::Option::Some(typ) is then
                    if store typ name field.second resolve_pattern_payload_type std::Option::Some(found) is then
                        found std::Option::Some return
                    fi
                fi
            done
        }
        common::PatternValue::EnumVariant(variant) => {
            store variant subject_type pattern::enum_payload_types = types
            0 = index: u64
            for child in variant.bindings.iter do
                if index types.length < then
                    if store index types.get name child resolve_pattern_payload_type std::Option::Some(found) is then
                        found std::Option::Some return
                    fi
                fi
                1 += index
            done
        }
        common::PatternValue::Alternatives(alternatives) => {
            if alternatives.is_empty ! then
                store subject_type name 0 alternatives.get resolve_pattern_payload_type return
            fi
        }
        _ => {
        }
    end
    std::Option[common::Type]::None
}

impl TypeChecker {
    fn pattern_copies_payload
        self:mut$TypeChecker
        pattern_value:$common::PatternValue
        name:$str
        subject_type:$common::Type
        function_opt:mut$std::Option[common::Function]
    -> bool {
        subject_type.clone = container_type
        if container_type.borrow_target std::Option::Some(target) is then
            target.clone = container_type
        fi
        self.store container_type name pattern_value resolve_pattern_payload_type match
            std::Option::Some(typ) => function_opt typ self.type_is_duplicable
            std::Option::None => false
        end
    }
}

fn clone_runtime_origins source:$std::Option[std::List[Origin]] -> std::Option[std::List[Origin]] {
    std::Option[std::List[Origin]]::None = runtime
    if source std::Option::Some(origins) is then
        for origin in origins.iter do
            if origin.kind OriginKind::Place is then
                origin.clone runtime append_origin = runtime
            fi
        done
    fi
    runtime
}

# Post-check phases can inspect recipes and prepare generated methods without
# accessing pending source work, callable summaries, or ownership proof state.
impl SemanticChecks {
    pub fn find_body self:$SemanticChecks name:$str -> std::Option[$semantic_body::Body] {
        if name self.functions.get_str std::Option::Some(work) is then
            work.get_body return
        fi
        std::Option::None
    }

    pub fn find_effect self:$SemanticChecks name:$str -> std::Option[$common::StackEffect] {
        if name self.functions.get_str std::Option::Some(work) is then
            if work.get_signature std::Option::Some(signature) is then
                signature.stack_effect std::Option::Some return
            fi
        fi
        std::Option::None
    }

    pub fn ensure_function
        self:mut$SemanticChecks
        name:$str
        store:mut$common::SymbolStore
        diagnostics:mut$error::Diagnostics
    -> std::Option[CheckedFunction] {
        false self diagnostics store name ensure_checked_function
    }

    pub fn check_trait_return_borrows
        self:$SemanticChecks
        name:$std::String
        contract:$common::StackEffect
        implementation:$common::StackEffect
        store:mut$common::SymbolStore
    -> bool {
        if name self.return_summaries.get std::Option::Some(summary) is then
            store summary implementation contract trait_return_borrows_match return
        fi
        true
    }

    pub fn install_specialization
        self:mut$SemanticChecks
        declaration:$common::Function
        source:$str
        bindings:mut$std::Map[std::String common::Type]
        store:mut$common::SymbolStore
    {
        if source self.find_body std::Option::Some(recipe) is then
            recipe.clone = body
            store bindings body.substitute
            body declaration checked_function_summary CompletedFunction
            FunctionWork::Completed declaration.name.clone self.functions.set
        fi
    }
}
