# Phase-independent meaning for resolved operations.
import "std"
import "common"

struct TraitMethodCandidate {
    method:     TraitMethod
    trait_type: Type
    effect:     StackEffect
}

fn collect_trait_method_candidates_into
    seen:Set[str]
    result:List[TraitMethodCandidate]
    store:SymbolStore
    trait_type:Type
-> Set[str] {
    trait_type.match_base store.traits.get = trait_opt
    if trait_opt.is_none then seen return fi
    trait_opt.unwrap = trait_def
    Map[str Type]::new = substitutions
    if trait_type.type_params Option::Some(arguments) is then
        for pair in arguments.iter trait_def.type_params.iter.zip do
            pair.second pair.first substitutions.set drop
        done
    fi
    for method in trait_def.methods.iter do
        f"{trait_type.format}::{method.name}" = identity
        if identity seen.has ! then
            identity seen.add = seen
            substitutions method.stack_effect apply_type_subs_to_stack_effect = resolved_effect
            resolved_effect trait_type method TraitMethodCandidate result.push
        fi
    done
    for supertrait in trait_def.supertraits.iter do
        substitutions supertrait trait_bound_to_type.substitute_t = resolved_supertrait
        resolved_supertrait store result seen collect_trait_method_candidates_into = seen
    done
    seen
}

fn collect_trait_method_candidates store:SymbolStore trait_type:Type -> List[TraitMethodCandidate] {
    List[TraitMethodCandidate]::new = result
    Set[str]::new = seen
    trait_type store result seen collect_trait_method_candidates_into drop
    result
}

fn trait_definition_type trait_def:CasaTrait -> Type {
    List[Type]::new = type_arguments
    for type_parameter in trait_def.type_params.iter do
        type_parameter Type::TypeVar type_arguments.push
    done
    type_arguments trait_def.name GenericType Type::Generic
}

fn collect_trait_methods_into
    seen:Set[str]
    result:List[TraitMethod]
    store:SymbolStore
    trait_def:CasaTrait
-> Set[str] {
    for method in trait_def.methods.iter do
        if method.name seen.has ! then
            method.name seen.add = seen
            method result.push
        fi
    done
    for supertrait in trait_def.supertraits.iter do
        if supertrait.name store.traits.get Option::Some(supertrait_def) is then
            supertrait_def store result seen collect_trait_methods_into = seen
        fi
    done
    seen
}

fn collect_trait_methods store:SymbolStore trait_def:CasaTrait -> List[TraitMethod] {
    List[TraitMethod]:: new = result
    Set[str]:: new = seen
    trait_def store result seen collect_trait_methods_into drop
    result
}

enum MethodSemanticsKind {
    Function
    TraitBound
    DefaultMethod
}

struct MethodSemantics {
    kind:          MethodSemanticsKind
    function_name: str
    trait_name:    str
    trait_type:    Option[Type]
    method_name:   str
    stack_effect:  StackEffect
}

struct SemanticStack {
    types:            List[Type]
    parameters:       List[Parameter]
    next_parameter:   u64
    branches:         List[SemanticBranch]
    variables:        Map[str Type]
    infer_parameters: bool
}

struct SemanticStackSnapshot {
    types:          List[Type]
    next_parameter: u64
    variables:      Map[str Type]
}

enum SemanticBranchKind {
    If
    While
    Match
}

impl StackEffect {
    fn needs_inference self:StackEffect -> bool {
        0 self.parameters.length == 0 self.return_types.length == &&
    }
}

struct SemanticBranch {
    kind:         SemanticBranchKind
    before:       Option[SemanticStackSnapshot]
    after:        Option[SemanticStackSnapshot]
    subject_type: Option[Type]
    active:       bool
    has_default:  bool
}

fn get_variable_root_name variable_name:str -> str {
    variable_name "." str::split = name_parts
    0 name_parts.get
}

fn unify_generic_type_parameters type_a:Type type_b:Type store:SymbolStore -> Option[Type] {
    if type_a.base type_b.base != then Option[Type]:: None return fi
    type_a.type_params = parameters_a_result
    type_b.type_params = parameters_b_result
    if parameters_a_result.is_none then type_b Option::Some return fi
    if parameters_b_result.is_none then type_a Option::Some return fi
    parameters_a_result.unwrap = parameters_a
    parameters_b_result.unwrap = parameters_b
    if parameters_a.length parameters_b.length != then Option[Type]:: None return fi
    List[Type]:: new = unified
    for pair in parameters_b.iter parameters_a.iter.zip do
        store pair.second pair.first unify_type_t ? unified.push
    done
    type_a.base = base_result
    if base_result.is_none then Option[Type]:: None return fi
    base_result.unwrap = base
    unified base GenericType Type::Generic Option::Some
}

fn unify_type_t type_a:Type type_b:Type store:SymbolStore -> Option[Type] {
    if type_a type_b.eq then type_a Option::Some return fi
    if type_a.is_integer_literal_t type_b.is_integer_type_t && then type_b Option::Some return fi
    if type_b.is_integer_literal_t type_a.is_integer_type_t && then type_a Option::Some return fi
    if type_a.is_float_literal_t type_b.is_float_type_t && then type_b Option::Some return fi
    if type_b.is_float_literal_t type_a.is_float_type_t && then type_a Option::Some return fi
    if type_a.is_unknown_placeholder then type_b Option::Some return fi
    if type_b.is_unknown_placeholder then type_a Option::Some return fi
    if type_a.has_unresolved_type_var then type_b Option::Some return fi
    if type_b.has_unresolved_type_var then type_a Option::Some return fi
    type_a.base = base_a
    type_b.base = base_b
    if base_a.is_some base_b.is_some && then
        store type_b type_a unify_generic_type_parameters = generic_result
        if generic_result.is_some then generic_result return fi
    fi
    if base_a Option::Some(first_base_name) is then
        if first_base_name type_b.format == then type_a Option::Some return fi
    fi
    if base_b Option::Some(second_base_name) is then
        if second_base_name type_a.format == then type_b Option::Some return fi
    fi
    Option[Type]:: None
}

impl SemanticStack {
    fn new function:Function -> SemanticStack {
        Map[str Type]:: new = variables
        for variable in function.variables.iter do
            variable.typ variable.name variables.set = variables
        done
        for capture in function.captures.iter do
            capture.typ capture.name variables.set = variables
        done
        function.stack_effect.needs_inference
        variables
        List[SemanticBranch]:: new
        0
        function.stack_effect.parameters
        List[Type]:: new
        SemanticStack
    }

    fn push self:SemanticStack type_value:Type {
        type_value self.types.push
    }

    fn peek self:SemanticStack -> Option[Type] {
        if 0 self.types.length != then
            self.types.length 1 - self.types.get Option::Some return
        fi
        if self.next_parameter self.parameters.length > then
            self.next_parameter self.parameters.get.typ Option::Some return
        fi
        if self.infer_parameters then
            TYPE_UNKNOWN_T Option::Some return
        fi
        Option[Type]:: None
    }

    fn pop self:SemanticStack -> Option[Type] {
        if 0 self.types.length != then
            self.types.pop Option::Some return
        fi
        if self.next_parameter self.parameters.length > then
            self.next_parameter self.parameters.get.typ = parameter_type
            1 += self.next_parameter
            parameter_type Option::Some return
        fi
        if self.infer_parameters then
            TYPE_UNKNOWN_T Parameter::new self.parameters.push
            1 += self.next_parameter
            TYPE_UNKNOWN_T Option::Some return
        fi
        Option[Type]:: None
    }

    fn drop_count self:SemanticStack count:u64 {
        0 (u64) = index
        while index count > do
            self.pop drop
            1 += index
        done
    }
}

impl SemanticStack {
    fn apply_effect_with_bindings self:SemanticStack effect:StackEffect -> Map[str Type] {
        Map[str Type]:: new = bindings
        for parameter in effect.parameters.iter do
            if parameter.name "__trait_" str::starts_with then
                continue
            fi
            if self.pop Option::Some(actual_type) is then
                bindings actual_type parameter.typ bind_semantic_type_arguments = bindings
            fi
        done
        for return_type in effect.return_types.iter do
            bindings return_type.substitute_t self.push
        done
        bindings
    }

    fn apply_result self:SemanticStack consumed:u64 result_type:Type {
        consumed self.drop_count
        result_type self.push
    }

    fn clone_variables self:SemanticStack -> Map[str Type] {
        Map[str Type]:: new = cloned
        for name in self.variables.keys.iter do
            name self.variables.get.unwrap name cloned.set = cloned
        done
        cloned
    }

    fn snapshot self:SemanticStack -> SemanticStackSnapshot {
        self.clone_variables self.next_parameter self.types.clone SemanticStackSnapshot
    }

    fn restore self:SemanticStack snapshot:SemanticStackSnapshot {
        snapshot.types.clone = self.types
        snapshot.next_parameter = self.next_parameter
        Map[str Type]:: new = self.variables
        for name in snapshot.variables.keys.iter do
            name snapshot.variables.get.unwrap name self.variables.set = self.variables
        done
    }

    fn start_branch
        self:SemanticStack
        subject_type:Option[Type]
        kind:SemanticBranchKind
        capture_now:bool
    {
        Option[SemanticStackSnapshot]:: None = before
        if capture_now then
            self.snapshot Option::Some = before
        fi
        false
        false
        subject_type
        Option[SemanticStackSnapshot]:: None
        before
        kind
        SemanticBranch = branch
        branch self.branches.push
    }

    fn capture_branch_entry self:SemanticStack {
        if 0 self.branches.length == then
            return
        fi
        self.branches.length 1 - self.branches.get = branch
        if branch.before Option::None is then
            self.snapshot Option::Some = branch.before
        fi
    }

    fn restore_branch_entry self:SemanticStack {
        if 0 self.branches.length == then
            return
        fi
        self.branches.length 1 - self.branches.get = branch
        if branch.before Option::Some(before) is then
            before self.restore
        fi
    }

    fn end_loop self:SemanticStack {
        if 0 self.branches.length == then
            return
        fi
        self.branches.pop = branch
        if branch.kind SemanticBranchKind::While is then
            if branch.before Option::Some(before) is then
                before self.restore
            fi
        fi
    }

    fn end_branch self:SemanticStack {
        if 0 self.branches.length != then
            self.branches.pop drop
        fi
    }

    fn get_branch_subject self:SemanticStack -> Option[Type] {
        if 0 self.branches.length != then
            self.branches.length 1 - self.branches.get.subject_type return
        fi
        Option[Type]:: None
    }

    fn get_variable_type self:SemanticStack variable_name:str -> Option[Type] {
        variable_name get_variable_root_name self.variables.get
    }

    fn assign_variable_type self:SemanticStack variable_name:str type_result:Option[Type] {
        variable_name "." str::split = name_parts
        if 1 name_parts.length != then
            return
        fi
        if type_result Option::Some(type_value) is then
            type_value variable_name self.variables.set = self.variables
        fi
    }
}

struct SemanticFacts {
    stack_effect:           Option[StackEffect]
    resolved_operation:     Option[OpValue]
    method:                 Option[MethodSemantics]
    dependencies:           List[str]
    syscall_argument_count: Option[u64]
    word_parameter_start:   u64
    word_parameter_count:   u64
}

impl SemanticFacts {
    fn new -> SemanticFacts {
        0
        0
        Option[u64]:: None
        List[str]:: new
        Option[MethodSemantics]:: None
        Option[OpValue]:: None
        Option[StackEffect]:: None
        SemanticFacts
    }
}

fn make_operation_stack_effect
    parameters:List[Parameter]
    return_types:List[Type]
    type_variables:List[str]
-> StackEffect {
    return_types parameters StackEffect::new = effect
    for type_variable in type_variables.iter do
        type_variable effect.type_vars.add = effect.type_vars
    done
    effect
}

fn add_parameter parameters:List[Parameter] typ:Type {
    typ Parameter::new parameters.push
}

fn add_named_parameter parameters:List[Parameter] typ:Type name:str {
    name typ Parameter::named parameters.push
}

fn operation_is_comparison operation:OpValue -> bool {
    operation match
        OpValue::Eq => true
        OpValue::Ne => true
        OpValue::Lt => true
        OpValue::Le => true
        OpValue::Gt => true
        OpValue::Ge => true
        _ => false
    end
}

fn operation_is_load operation:OpValue -> bool {
    operation match
        OpValue::Load8 => true
        OpValue::Load16 => true
        OpValue::Load32 => true
        OpValue::Load64 => true
        _ => false
    end
}

fn operation_is_store operation:OpValue -> bool {
    operation match
        OpValue::Store8 => true
        OpValue::Store16 => true
        OpValue::Store32 => true
        OpValue::Store64 => true
        _ => false
    end
}

fn operation_is_memory operation:OpValue -> bool {
    if operation operation_is_load then true return fi
    if operation operation_is_store then true return fi
    operation OpValue::HeapAlloc is
}

fn fixed_operation_stack_effect operation:OpValue -> Option[StackEffect] {
    List[Type]:: new = return_types
    List[Parameter]:: new = parameter_types
    List[str]:: new = type_variables
    "T" Type::TypeVar = type_t
    "U" Type::TypeVar = type_u
    false = handled

    if operation operation_is_comparison then
        type_t parameter_types add_parameter
        type_t parameter_types add_parameter
        TYPE_BOOL_T return_types.push
        "T" type_variables.push
        type_variables return_types parameter_types make_operation_stack_effect Option::Some
        return
    fi
    if operation operation_is_load then
        TYPE_PTR_T parameter_types add_parameter
        TYPE_I64_T return_types.push
        type_variables return_types parameter_types make_operation_stack_effect Option::Some
        return
    fi
    if operation operation_is_store then
        TYPE_PTR_T parameter_types add_parameter
        type_t parameter_types add_parameter
        "T" type_variables.push
        type_variables return_types parameter_types make_operation_stack_effect Option::Some
        return
    fi

    operation match
        OpValue::PushInt(_) => { TYPE_I64_T return_types.push true = handled }
        OpValue::PushFloat(_) => { TYPE_F64_T return_types.push true = handled }
        OpValue::PushStr(_) => { TYPE_STR_T return_types.push true = handled }
        OpValue::PushBool(_) => { TYPE_BOOL_T return_types.push true = handled }
        OpValue::PushChar(_) => { TYPE_CHAR_T return_types.push true = handled }
        OpValue::Argc => { TYPE_U64_T return_types.push true = handled }
        OpValue::Argv => { TYPE_PTR_T return_types.push true = handled }
        OpValue::Envp => { TYPE_PTR_T return_types.push true = handled }
        OpValue::Mul => {
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T return_types.push
            true = handled
        }
        OpValue::Div => {
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T return_types.push
            true = handled
        }
        OpValue::Mod => {
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T return_types.push
            true = handled
        }
        OpValue::BitAnd => {
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T return_types.push
            true = handled
        }
        OpValue::BitOr => {
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T return_types.push
            true = handled
        }
        OpValue::BitXor => {
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T return_types.push
            true = handled
        }
        OpValue::Add => {
            TYPE_I64_T parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::Sub => {
            TYPE_I64_T parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::Shl => {
            TYPE_I64_T parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::Shr => {
            TYPE_I64_T parameter_types add_parameter
            type_t parameter_types add_parameter
            type_t return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::And => {
            type_t parameter_types add_parameter
            type_u parameter_types add_parameter
            TYPE_BOOL_T return_types.push
            "T" type_variables.push
            "U" type_variables.push
            true = handled
        }
        OpValue::Or => {
            type_t parameter_types add_parameter
            type_u parameter_types add_parameter
            TYPE_BOOL_T return_types.push
            "T" type_variables.push
            "U" type_variables.push
            true = handled
        }
        OpValue::Not => {
            type_t parameter_types add_parameter
            TYPE_BOOL_T return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::BitNot => {
            TYPE_I64_T parameter_types add_parameter
            TYPE_I64_T return_types.push
            true = handled
        }
        OpValue::Drop => {
            "value for `drop`" type_t parameter_types add_named_parameter
            "T" type_variables.push
            true = handled
        }
        OpValue::Dup => {
            "value for `dup`" type_t parameter_types add_named_parameter
            type_t return_types.push
            type_t return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::Swap => {
            "argument 1 of `swap`" type_t parameter_types add_named_parameter
            "argument 2 of `swap`" type_u parameter_types add_named_parameter
            type_t return_types.push
            type_u return_types.push
            "T" type_variables.push
            "U" type_variables.push
            true = handled
        }
        OpValue::Over => {
            "argument 1 of `over`" type_t parameter_types add_named_parameter
            "argument 2 of `over`" type_u parameter_types add_named_parameter
            type_u return_types.push
            type_t return_types.push
            type_u return_types.push
            "T" type_variables.push
            "U" type_variables.push
            true = handled
        }
        OpValue::Rot => {
            "V" Type::TypeVar = type_v
            "argument 1 of `rot`" type_t parameter_types add_named_parameter
            "argument 2 of `rot`" type_u parameter_types add_named_parameter
            "argument 3 of `rot`" type_v parameter_types add_named_parameter
            type_u return_types.push
            type_t return_types.push
            type_v return_types.push
            "T" type_variables.push
            "U" type_variables.push
            "V" type_variables.push
            true = handled
        }
        OpValue::Print => {
            type_t parameter_types add_parameter
            "T" type_variables.push
            true = handled
        }
        OpValue::PrintBool => { TYPE_BOOL_T parameter_types add_parameter true = handled }
        OpValue::PrintChar => { TYPE_CHAR_T parameter_types add_parameter true = handled }
        OpValue::PrintCstr => { TYPE_CSTR_T parameter_types add_parameter true = handled }
        OpValue::PrintInt => { TYPE_I64_T parameter_types add_parameter true = handled }
        OpValue::PrintStr => { TYPE_STR_T parameter_types add_parameter true = handled }
        OpValue::FstringToStr => {
            type_t parameter_types add_parameter
            TYPE_STR_T return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::PrimitiveToStr(builtin) => {
            builtin Type::Builtin parameter_types add_parameter
            TYPE_STR_T return_types.push
            true = handled
        }
        OpValue::FstringConcat(count) => {
            0 (u64) = index
            while index count > do
                TYPE_STR_T parameter_types add_parameter
                1 += index
            done
            TYPE_STR_T return_types.push
            true = handled
        }
        OpValue::Typeof => {
            type_t parameter_types add_parameter
            TYPE_STR_T return_types.push
            "T" type_variables.push
            true = handled
        }
        OpValue::HeapAlloc => {
            TYPE_U64_T parameter_types add_parameter
            TYPE_PTR_T return_types.push
            true = handled
        }
        _ => { }
    end

    if handled ! then Option[StackEffect]:: None return fi
    type_variables return_types parameter_types make_operation_stack_effect Option::Some
}

fn operation_uses_fixed_typecheck_effect operation:OpValue -> bool {
    operation match
        OpValue::PushStr(_) => true
        OpValue::PushBool(_) => true
        OpValue::PushChar(_) => true
        OpValue::Argc => true
        OpValue::Argv => true
        OpValue::Envp => true
        OpValue::And => true
        OpValue::Or => true
        OpValue::Not => true
        OpValue::Drop => true
        OpValue::Dup => true
        OpValue::Swap => true
        OpValue::Over => true
        OpValue::Rot => true
        OpValue::FstringConcat(_) => true
        _ => false
    end
}

fn operation_syscall_argument_count operation:OpValue -> Option[u64] {
    operation match
        OpValue::Syscall0 => 0 (u64) Option::Some
        OpValue::Syscall1 => 1 (u64) Option::Some
        OpValue::Syscall2 => 2 (u64) Option::Some
        OpValue::Syscall3 => 3 (u64) Option::Some
        OpValue::Syscall4 => 4 (u64) Option::Some
        OpValue::Syscall5 => 5 (u64) Option::Some
        OpValue::Syscall6 => 6 (u64) Option::Some
        _ => Option[u64]:: None
    end
}

fn make_syscall_stack_effect argument_count:u64 -> StackEffect {
    List[Type]:: new = return_types
    List[Parameter]:: new = parameter_types
    TYPE_I64_T parameter_types add_parameter
    0 (u64) = index
    while index argument_count > do
        TYPE_UNKNOWN_T parameter_types add_parameter
        1 += index
    done
    TYPE_I64_T return_types.push
    List[str]:: new return_types parameter_types make_operation_stack_effect
}

fn make_function_reference_stack_effect effect:StackEffect -> StackEffect {
    List[Type]:: new = return_types
    effect stack_effect_to_function_type return_types.push
    List[str]:: new return_types List[Parameter]:: new
    make_operation_stack_effect
}

impl Type {
    fn make_method_key self:Type method_name:str -> str {
        f"{self.format}::{method_name}"
    }

    fn make_base_method_key self:Type method_name:str -> Option[str] {
        if self.base Option::Some(base) is then
            f"{base}::{method_name}" Option::Some return
        fi
        Option[str]:: None
    }
}

fn find_semantic_method_function method_name:str receiver:Type store:SymbolStore -> Option[str] {
    method_name receiver.make_method_key = function_name
    if function_name store.functions.get Option::Some(function) is then
        function.name Option::Some return
    fi
    if method_name receiver.make_base_method_key Option::Some(base_name) is then
        if base_name store.functions.get Option::Some(function) is then
            function.name Option::Some return
        fi
    fi
    Option[str]:: None
}

fn find_semantic_trait_method
    method_name:str
    casa_trait:CasaTrait
    store:SymbolStore
-> Option[TraitMethod] {
    for method in casa_trait store collect_trait_methods.iter do
        if method_name method.name == then method Option::Some return fi
    done
    Option[TraitMethod]:: None
}

fn type_has_semantic_trait_shape receiver:Type trait_type:Type store:SymbolStore -> bool {
    for candidate in trait_type store collect_trait_method_candidates.iter do
        if 0 candidate.method.default_ops.length == then
            store receiver trait_type candidate.method.name resolve_qualified_method_semantics
            = method_opt
            if method_opt.is_none then false return fi
        fi
    done
    true
}

fn bind_semantic_type_arguments expected:Type actual:Type bindings:Map[str Type] -> Map[str Type] {
    expected match
        Type::TypeVar(type_variable) => {
            if type_variable bindings.has ! then
                actual type_variable bindings.set = bindings
            fi
        }
        Type::Generic(expected_generic) => {
            if actual Type::Generic(actual_generic) is then
                if expected_generic.base actual_generic.base == then
                    for pair in actual_generic.params.iter expected_generic.params.iter.zip do
                        bindings pair.second pair.first bind_semantic_type_arguments = bindings
                    done
                fi
            fi
        }
        Type::Function(expected_function) => {
            if actual Type::Function(actual_function) is then
                for pair in actual_function.parameters.iter expected_function.parameters.iter.zip do
                    bindings pair.second pair.first bind_semantic_type_arguments = bindings
                done
                actual_function.return_types.iter expected_function.return_types.iter.zip
                = return_type_pairs
                for pair in return_type_pairs do
                    bindings pair.second pair.first bind_semantic_type_arguments = bindings
                done
            fi
        }
        _ => { }
    end
    bindings
}

fn make_bound_substitutions bound:TraitBound casa_trait:CasaTrait -> Map[str Type] {
    Map[str Type]:: new = substitutions
    if bound.type_args.length casa_trait.type_params.length == then
        for pair in bound.type_args.iter casa_trait.type_params.iter.zip do
            pair.second pair.first substitutions.set = substitutions
        done
    fi
    substitutions
}

fn bind_trait_impl_type pattern:Type actual:Type bindings:Map[str Type] -> bool {
    if pattern Type::TypeVar(type_variable) is then
        if type_variable bindings.get Option::Some(bound_type) is then
            actual bound_type.eq return
        fi
        actual type_variable bindings.set drop
        true return
    fi
    if pattern Type::Generic(pattern_generic) is then
        if actual Type::Generic(actual_generic) is then
            if pattern_generic.base actual_generic.base != then false return fi
            if pattern_generic.params.length actual_generic.params.length != then false return fi
            for pair in actual_generic.params.iter pattern_generic.params.iter.zip do
                if bindings pair.second pair.first bind_trait_impl_type ! then false return fi
            done
            true return
        fi
        false return
    fi
    if pattern Type::Function(pattern_function) is then
        if actual Type::Function(actual_function) is then
            if pattern_function.parameters.length actual_function.parameters.length != then false return fi
            if pattern_function.return_types.length actual_function.return_types.length != then false return fi
            for pair in actual_function.parameters.iter pattern_function.parameters.iter.zip do
                if bindings pair.second pair.first bind_trait_impl_type ! then false return fi
            done
            for pair in actual_function.return_types.iter pattern_function.return_types.iter.zip do
                if bindings pair.second pair.first bind_trait_impl_type ! then false return fi
            done
            true return
        fi
        false return
    fi
    pattern actual.eq
}

fn resolve_trait_impl_bound bound:TraitBound bindings:Map[str Type] -> Type {
    bindings bound trait_bound_to_type.substitute_t
}

fn trait_type_implies direct:Type target:Type store:SymbolStore -> bool {
    if direct target.eq then true return fi
    direct.match_base store.traits.get = direct_trait_opt
    if direct_trait_opt.is_none then false return fi
    direct_trait_opt.unwrap = direct_trait
    Map[str Type]:: new = substitutions
    if direct.type_params Option::Some(direct_arguments) is then
        for pair in direct_arguments.iter direct_trait.type_params.iter.zip do
            pair.second pair.first substitutions.set drop
        done
    fi
    for supertrait in direct_trait.supertraits.iter do
        substitutions supertrait trait_bound_to_type.substitute_t = resolved_supertrait
        if store target resolved_supertrait trait_type_implies then true return fi
    done
    false
}

fn trait_impl_constraints_hold
    trait_impl:TraitImpl
    bindings:Map[str Type]
    store:SymbolStore
-> bool {
    for type_variable in trait_impl.trait_bounds.keys.iter do
        if type_variable bindings.get Option::Some(concrete) is then
            for bound in type_variable trait_impl.trait_bounds.get.unwrap.iter do
                bindings bound resolve_trait_impl_bound = resolved_bound
                if store resolved_bound concrete type_has_satisfying_trait_impl ! then false return fi
            done
        else
            false return
        fi
    done
    true
}

fn resolve_applicable_trait_impl
    receiver:Type
    trait_impl:TraitImpl
    store:SymbolStore
-> Option[Type] {
    Map[str Type]::new = bindings
    if bindings receiver trait_impl.receiver bind_trait_impl_type ! then Option[Type]::None return fi
    if store bindings trait_impl trait_impl_constraints_hold ! then Option[Type]::None return fi
    bindings trait_impl.trait_bound resolve_trait_impl_bound Option::Some
}

fn trait_type_has_method trait_type:Type method_name:str store:SymbolStore -> bool {
    for candidate in trait_type store collect_trait_method_candidates.iter do
        if method_name candidate.method.name == then true return fi
    done
    false
}

fn find_trait_default_method
    method_name:str
    trait_type:Type
    store:SymbolStore
-> Option[TraitMethodCandidate] {
    Option[TraitMethodCandidate]::None = found
    false = has_direct_declaration
    trait_type store collect_trait_method_candidates = candidates
    for candidate in candidates.iter do
        if method_name candidate.method.name != then continue fi
        if candidate.trait_type trait_type.eq then
            true = has_direct_declaration
            if 0 candidate.method.default_ops.length != then candidate Option::Some = found fi
        fi
    done
    if has_direct_declaration then found return fi
    for candidate in candidates.iter do
        if
        method_name candidate.method.name ==
        0 candidate.method.default_ops.length != &&
        then
            if found.is_some then Option[TraitMethodCandidate]::None return fi
            candidate Option::Some = found
        fi
    done
    found
}

fn type_has_satisfying_trait_impl receiver:Type trait_type:Type store:SymbolStore -> bool {
    for trait_impl in store.trait_impls.values.iter do
        Map[str Type]:: new = bindings
        if bindings receiver trait_impl.receiver bind_trait_impl_type ! then continue fi
        bindings trait_impl.trait_bound resolve_trait_impl_bound = implemented_trait
        if store trait_type implemented_trait trait_type_implies ! then continue fi
        if store bindings trait_impl trait_impl_constraints_hold then true return fi
    done
    false
}

fn find_implied_trait_type direct:Type trait_name:str store:SymbolStore -> Option[Type] {
    if direct.match_base trait_name == then direct Option::Some return fi
    direct.match_base store.traits.get = direct_trait_opt
    if direct_trait_opt.is_none then Option[Type]:: None return fi
    direct_trait_opt.unwrap = direct_trait
    Map[str Type]:: new = substitutions
    if direct.type_params Option::Some(direct_arguments) is then
        for pair in direct_arguments.iter direct_trait.type_params.iter.zip do
            pair.second pair.first substitutions.set drop
        done
    fi
    for supertrait in direct_trait.supertraits.iter do
        substitutions supertrait trait_bound_to_type.substitute_t = resolved_supertrait
        if store trait_name resolved_supertrait find_implied_trait_type Option::Some(found) is then
            found Option::Some return
        fi
    done
    Option[Type]:: None
}

fn find_satisfying_trait_type receiver:Type trait_name:str store:SymbolStore -> Option[Type] {
    for trait_impl in store.trait_impls.values.iter do
        Map[str Type]:: new = bindings
        if bindings receiver trait_impl.receiver bind_trait_impl_type ! then continue fi
        if store bindings trait_impl trait_impl_constraints_hold ! then continue fi
        bindings trait_impl.trait_bound resolve_trait_impl_bound = implemented_trait
        if store trait_name implemented_trait find_implied_trait_type Option::Some(found) is then
            found Option::Some return
        fi
    done
    Option[Type]:: None
}

fn infer_default_method_substitutions
    receiver:Type
    casa_trait:CasaTrait
    store:SymbolStore
-> Map[str Type] {
    Map[str Type]:: new = substitutions
    for trait_method in casa_trait.methods.iter do
        if 0 trait_method.default_ops.length != then continue fi
        store receiver trait_method.name find_semantic_method_function = function_opt
        if function_opt Option::Some(function_name) is then
            if function_name store.functions.get Option::Some(function) is then
                receiver trait_method.stack_effect resolve_trait_stack_effect = expected_effect
                function.stack_effect.return_types.iter expected_effect.return_types.iter.zip
                = return_type_pairs
                for pair in return_type_pairs do
                    substitutions pair.second pair.first bind_semantic_type_arguments
                    = substitutions
                done
            fi
        fi
    done
    substitutions
}

fn collect_trait_implementation_dependencies
    receiver:Type
    casa_trait:CasaTrait
    store:SymbolStore
-> List[str] {
    List[str]:: new = dependencies
    for method in casa_trait store collect_trait_methods.iter do
        if 0 method.default_ops.length != then continue fi
        casa_trait trait_definition_type Option::Some = qualifier
        store qualifier receiver method.name resolve_trait_method_semantics_for = method_opt
        if method_opt Option::Some(resolved) is then
            resolved.function_name dependencies.push
        fi
    done
    dependencies
}

fn collect_bound_semantic_dependencies
    effect:StackEffect
    bindings:Map[str Type]
    store:SymbolStore
-> List[str] {
    List[str]:: new = dependencies
    for type_variable in effect.trait_bounds.keys.iter do
        if type_variable bindings.get Option::Some(receiver) is then
            for bound in type_variable effect.trait_bounds.get.unwrap.iter do
                if bound.name store.traits.get Option::Some(casa_trait) is then
                    bound.name dependencies.push
                    store casa_trait receiver collect_trait_implementation_dependencies
                    = implementations
                    for implementation in implementations.iter do
                        implementation dependencies.push
                    done
                fi
            done
        fi
    done
    dependencies
}

fn make_method_semantics
    kind:MethodSemanticsKind
    function_name:str
    trait_name:str
    trait_type:Option[Type]
    method_name:str
    stack_effect:StackEffect
-> MethodSemantics {
    stack_effect method_name trait_type trait_name function_name kind MethodSemantics
}

fn resolve_bound_method_semantics
    method_name:str
    receiver:Type
    function:Function
    store:SymbolStore
-> Option[MethodSemantics] {
    if receiver Type::TypeVar(type_variable) is then
        if type_variable function.stack_effect.trait_bounds.get Option::Some(bounds) is then
            for bound in bounds.iter do
                if bound.name store.traits.get Option::Some(casa_trait) is then
                    store casa_trait method_name find_semantic_trait_method = trait_method_opt
                    if trait_method_opt Option::Some(method) is then
                        casa_trait bound make_bound_substitutions = substitutions
                        receiver method.stack_effect resolve_trait_stack_effect = resolved_effect
                        substitutions resolved_effect apply_type_subs_to_stack_effect = resolved_effect
                        f"__trait_{type_variable}_{method_name}" = hidden_name
                        resolved_effect method_name bound trait_bound_to_type Option::Some bound.name hidden_name
                        MethodSemanticsKind::TraitBound
                        make_method_semantics Option::Some return
                    fi
                fi
            done
        fi
    fi
    Option[MethodSemantics]:: None
}

fn resolve_trait_method_semantics_for
    method_name:str
    receiver:Type
    qualifier:Option[Type]
    store:SymbolStore
-> Option[MethodSemantics] {
    Option[MethodSemantics]::None = found
    "" = found_identity
    false = has_exact
    if qualifier Option::Some(required_trait) is then
        for trait_impl in store.trait_impls.values.iter do
            store trait_impl receiver resolve_applicable_trait_impl = direct_opt
            if direct_opt Option::Some(direct_trait) is then
                if direct_trait required_trait.eq then true = has_exact fi
            fi
        done
    fi
    for trait_impl in store.trait_impls.values.iter do
        store trait_impl receiver resolve_applicable_trait_impl = trait_type_opt
        if trait_type_opt.is_none then continue fi
        trait_type_opt.unwrap = trait_type
        if qualifier Option::Some(required_trait) is then
            if has_exact trait_type required_trait.eq ! && then continue fi
            if store required_trait trait_type trait_type_implies ! then continue fi
        fi
        trait_type = lookup_trait_type
        if qualifier Option::Some(required_trait) is then required_trait = lookup_trait_type fi
        if store method_name lookup_trait_type trait_type_has_method ! then continue fi
        if method_name trait_impl.methods.get Option::Some(function_name) is then
            function_name store.functions.get.unwrap.stack_effect = effect
            effect method_name trait_type Option::Some trait_type.match_base function_name
            MethodSemanticsKind::Function make_method_semantics = candidate
            if "" found_identity == then
                function_name = found_identity
                candidate Option::Some = found
            elif function_name found_identity != then
                Option[MethodSemantics]::None return
            fi
            continue
        fi
        if store receiver method_name find_semantic_method_function Option::Some(function_name) is then
            function_name store.functions.get.unwrap.stack_effect = effect
            effect method_name trait_type Option::Some trait_type.match_base function_name
            MethodSemanticsKind::Function make_method_semantics = candidate
            if "" found_identity == then
                function_name = found_identity
                candidate Option::Some = found
            elif function_name found_identity != then
                Option[MethodSemantics]::None return
            fi
            continue
        fi
        store lookup_trait_type method_name find_trait_default_method = default_opt
        if default_opt Option::Some(default_method) is then
            f"{default_method.trait_type.format}::{method_name}" = identity
            receiver default_method.effect resolve_trait_stack_effect = resolved_effect
            default_method.trait_type.format str_hash = trait_hash
            receiver.format str_hash = receiver_hash
            f"{receiver.match_base}::{method_name}__default_{receiver_hash}_{trait_hash}"
            = function_name
            resolved_effect method_name default_method.trait_type Option::Some
            default_method.trait_type.match_base function_name
            MethodSemanticsKind::DefaultMethod make_method_semantics = candidate
            if "" found_identity == then
                identity = found_identity
                candidate Option::Some = found
            elif identity found_identity != then
                Option[MethodSemantics]::None return
            fi
        fi
    done
    found
}

fn resolve_default_method_semantics
    method_name:str
    receiver:Type
    store:SymbolStore
-> Option[MethodSemantics] {
    store Option[Type]::None receiver method_name resolve_trait_method_semantics_for
}

fn resolve_qualified_method_semantics
    method_name:str
    qualifier:Type
    receiver:Type
    store:SymbolStore
-> Option[MethodSemantics] {
    store qualifier Option::Some receiver method_name resolve_trait_method_semantics_for
}

fn collect_method_qualifiers method_name:str receiver:Type store:SymbolStore -> List[str] {
    List[str]::new = result
    Set[str]::new = seen
    for trait_impl in store.trait_impls.values.iter do
        store trait_impl receiver resolve_applicable_trait_impl = trait_type_opt
        if trait_type_opt.is_none then continue fi
        trait_type_opt.unwrap = trait_type
        if store method_name trait_type trait_type_has_method ! then continue fi
        trait_type.format = qualifier
        if qualifier seen.has ! then
            qualifier seen.add = seen
            qualifier result.push
        fi
    done
    result
}

fn resolve_method_semantics
    method_name:str
    receiver:Type
    function_opt:Option[Function]
    store:SymbolStore
-> Option[MethodSemantics] {
    if function_opt Option::Some(function) is then
        store function receiver method_name resolve_bound_method_semantics = bound_method_opt
        if bound_method_opt Option::Some(method) is then
            method Option::Some return
        fi
    fi
    if store receiver method_name find_semantic_method_function Option::Some(function_name) is then
        function_name store.functions.get.unwrap.stack_effect = effect
        effect method_name Option[Type]::None "" function_name MethodSemanticsKind::Function
        make_method_semantics Option::Some return
    fi
    store receiver method_name resolve_default_method_semantics
}

fn primitive_print_operation receiver:Type -> Option[OpValue] {
    if receiver.is_integer_type_t then OpValue::PrintInt Option::Some return fi
    receiver.format match
        "str" => OpValue::PrintStr Option::Some
        "bool" => OpValue::PrintBool Option::Some
        "char" => OpValue::PrintChar Option::Some
        "cstr" => OpValue::PrintCstr Option::Some
        _ => Option[OpValue]:: None
    end
}

fn comparison_method_name operation:OpValue -> str {
    operation match
        OpValue::Eq => "eq"
        OpValue::Ne => "ne"
        OpValue::Lt => "lt"
        OpValue::Le => "le"
        OpValue::Gt => "gt"
        _ => "ge"
    end
}

fn comparison_trait_name operation:OpValue -> str {
    operation match
        OpValue::Eq => "Eq"
        OpValue::Ne => "Eq"
        _ => "Ord"
    end
}

fn comparison_uses_method receiver:Type store:SymbolStore -> bool {
    if receiver.is_unknown_placeholder then false return fi
    if TYPE_STR_T receiver.eq then false return fi
    if receiver.is_primitive_compare_type_t then false return fi
    receiver match
        Type::TypeVar(_) => true
        Type::Generic(generic) => generic.base store.structs.has
        _ => false
    end
}

fn add_method_dependencies
    result:SemanticFacts
    method:MethodSemantics
    receiver:Type
    store:SymbolStore
{
    if "" method.trait_name != then method.trait_name result.dependencies.push fi
    if method.kind MethodSemanticsKind::Function is then
        method.function_name result.dependencies.push
    elif method.kind MethodSemanticsKind::DefaultMethod is then
        if method.trait_name store.traits.get Option::Some(casa_trait) is then
            store casa_trait receiver collect_trait_implementation_dependencies = implementations
            for implementation in implementations.iter do
                implementation result.dependencies.push
            done
        fi
    fi
}

fn analyze_method_operation
    result:SemanticFacts
    method_name:str
    receiver:Type
    function_opt:Option[Function]
    store:SymbolStore
{
    if store function_opt receiver method_name resolve_method_semantics Option::Some(method) is then
        method Option::Some = result.method
        store receiver method result add_method_dependencies
    fi
}

fn parse_trait_method_name hidden_name:str -> Option[str] {
    "__trait_" = hidden_prefix
    if hidden_name hidden_prefix str::starts_with ! then Option[str]:: None return fi
    hidden_name hidden_prefix.length hidden_name.length hidden_prefix.length - str::substring
    = trait_suffix
    trait_suffix "_" str::find = separator
    if separator 0 >= then Option[str]:: None return fi
    trait_suffix separator 1 + (u64) trait_suffix.length separator (u64) - 1 - str::substring Option::Some
}

fn analyze_operation
    operation:OpValue
    receiver:Option[Type]
    function_opt:Option[Function]
    store:SymbolStore
-> SemanticFacts {
    SemanticFacts::new = result
    operation fixed_operation_stack_effect = result.stack_effect
    operation operation_syscall_argument_count = result.syscall_argument_count
    if result.syscall_argument_count Option::Some(argument_count) is then
        argument_count make_syscall_stack_effect Option::Some = result.stack_effect
        argument_count = result.word_parameter_count
        1 = result.word_parameter_start
    fi
    if operation operation_is_store then
        1 = result.word_parameter_start
        1 = result.word_parameter_count
    fi
    operation match
        OpValue::FnCall(function_name) => {
            function_name result.dependencies.push
            if function_name store.functions.get Option::Some(function) is then
                function.stack_effect Option::Some = result.stack_effect
            fi
        }
        OpValue::FnPush(function_name) => {
            function_name result.dependencies.push
            if function_name store.functions.get Option::Some(function) is then
                function.stack_effect make_function_reference_stack_effect Option::Some
                = result.stack_effect
            fi
        }
        OpValue::FnExec => {
            if receiver Option::Some(receiver_type) is then
                if receiver_type Type::Function(function_type) is then
                    function_type function_type_to_stack_effect Option::Some = result.stack_effect
                fi
            fi
        }
        OpValue::MethodCall(method_name) => {
            if receiver Option::Some(receiver_type) is then
                store function_opt receiver_type method_name result analyze_method_operation
                if result.method Option::Some(method) is then
                    method.stack_effect Option::Some = result.stack_effect
                fi
            fi
        }
        OpValue::QualifiedMethodCall(qualified) => {
            if receiver Option::Some(receiver_type) is then
                store receiver_type qualified.trait_type qualified.method_name resolve_qualified_method_semantics
                = method_opt
                if method_opt Option::Some(method) is then
                    method Option::Some = result.method
                    store receiver_type method result add_method_dependencies
                    method.stack_effect Option::Some = result.stack_effect
                fi
            fi
        }
        OpValue::TraitMethodCall(hidden_name) => {
            if receiver Option::Some(receiver_type) is then
                if hidden_name parse_trait_method_name Option::Some(method_name) is then
                    store function_opt receiver_type method_name result analyze_method_operation
                    if result.method Option::Some(method) is then
                        method.stack_effect Option::Some = result.stack_effect
                    fi
                fi
            fi
        }
        OpValue::Print => {
            if receiver Option::Some(receiver_type) is then
                receiver_type primitive_print_operation = result.resolved_operation
                if result.resolved_operation.is_none receiver_type.is_unknown_placeholder ! && then
                    "Display" result.dependencies.push
                    store function_opt receiver_type "to_str" result analyze_method_operation
                fi
            fi
        }
        OpValue::FstringToStr => {
            if receiver Option::Some(receiver_type) is then
                if TYPE_STR_T receiver_type.eq ! receiver_type.is_unknown_placeholder ! && then
                    "Display" result.dependencies.push
                    store function_opt receiver_type "to_str" result analyze_method_operation
                fi
            fi
        }
        OpValue::PrimitiveToStr => { }
        _ => { }
    end
    if operation operation_is_comparison then
        if receiver Option::Some(receiver_type) is then
            if store receiver_type comparison_uses_method then
                operation comparison_trait_name result.dependencies.push
                operation comparison_method_name = method_name
                store function_opt receiver_type method_name result analyze_method_operation
            fi
        fi
    fi
    result
}

struct FunctionSemantics {
    ordered_facts:   List[SemanticDependency]
    inferred_effect: StackEffect
}

impl FunctionSemantics {
    fn has_symbol_dependency self:FunctionSemantics dependency:str -> bool {
        for fact in self.ordered_facts.iter do
            if fact SemanticDependency::Symbol(symbol) is then
                if symbol dependency == then true return fi
            fi
        done
        false
    }
}

enum SemanticDependency {
    Symbol (str)
    Type (Type)
    Global (SemanticGlobalReference)
}

struct SemanticGlobalReference {
    name:            str
    location:        Location
    declared_global: bool
}

struct SemanticAnalysis {
    store:             SymbolStore
    inferred_effects:  Map[str StackEffect]
    seen_dependencies: Set[str]
    ordered_facts:     List[SemanticDependency]
}

impl SemanticAnalysis {
    fn merge_branch_variable
        self:SemanticAnalysis
        merged:SemanticStackSnapshot
        current:SemanticStackSnapshot
        variable_name:str
    {
        variable_name current.variables.get = current_result
        variable_name merged.variables.get = merged_result
        if current_result.is_none merged_result.is_none || then return fi
        self.store current_result.unwrap merged_result.unwrap unify_type_t = unified
        if unified Option::Some(type_value) is then
            type_value variable_name merged.variables.set = merged.variables
        fi
    }

    fn merge_branch_exit self:SemanticAnalysis stack:SemanticStack {
        if 0 stack.branches.length == then return fi
        stack.branches.length 1 - stack.branches.get = branch
        if branch.active ! then return fi
        stack.snapshot = current
        if branch.after Option::None is then
            current Option::Some = branch.after
            return
        fi
        branch.after.unwrap = merged
        if merged.types.length current.types.length != then return fi
        0 (u64) = index
        while index merged.types.length > do
            self.store index current.types.get index merged.types.get unify_type_t
            = unified
            if unified Option::Some(type_value) is then
                type_value index merged.types.set
            fi
            1 += index
        done
        for variable_name in merged.variables.keys.iter do
            variable_name current merged self.merge_branch_variable
        done
    }

    fn finish_branch self:SemanticAnalysis stack:SemanticStack include_entry:bool {
        stack self.merge_branch_exit
        if 0 stack.branches.length == then return fi
        stack.branches.length 1 - stack.branches.get = branch
        if include_entry branch.before Option::Some(entry) is && then
            true = branch.active
            entry stack.restore
            stack self.merge_branch_exit
        fi
        if branch.after Option::Some(after) is then after stack.restore fi
        stack.end_branch
    }

    fn new store:SymbolStore inferred_effects:Map[str StackEffect] -> SemanticAnalysis {
        List[SemanticDependency]:: new
        Set[str]:: new
        inferred_effects
        store
        SemanticAnalysis
    }

    fn add_dependency self:SemanticAnalysis dependency:str {
        if dependency self.seen_dependencies.has ! then
            dependency self.seen_dependencies.add = self.seen_dependencies
            dependency SemanticDependency::Symbol self.ordered_facts.push
        fi
    }

    fn add_type_dependency self:SemanticAnalysis type_value:Type {
        type_value SemanticDependency::Type self.ordered_facts.push
    }

    fn add_global_reference self:SemanticAnalysis name:str location:Location declared_global:bool {
        declared_global location name SemanticGlobalReference = reference
        reference SemanticDependency::Global self.ordered_facts.push
    }

    fn get_variable_type self:SemanticAnalysis function:Function variable_name:str -> Option[Type] {
        variable_name get_variable_root_name = root_name
        for variable in function.variables.iter do
            if variable.name root_name == then variable.typ Option::Some return fi
        done
        for capture in function.captures.iter do
            if capture.name root_name == then capture.typ Option::Some return fi
        done
        if root_name self.store.variables.get Option::Some(variable) is then
            variable.typ Option::Some return
        fi
        Option[Type]:: None
    }

    fn get_function_effect self:SemanticAnalysis function_name:str -> Option[StackEffect] {
        if function_name self.inferred_effects.get Option::Some(effect) is then
            effect Option::Some return
        fi
        if function_name self.store.functions.get Option::Some(function) is then
            if function.stack_effect.needs_inference then
                function.stack_effect function_name self.inferred_effects.set = self.inferred_effects
                self.store self.inferred_effects function
                analyze_function_semantics = semantics
                semantics.inferred_effect function_name self.inferred_effects.set
                = self.inferred_effects
                semantics.inferred_effect Option::Some return
            fi
            function.stack_effect Option::Some return
        fi
        Option[StackEffect]:: None
    }
}

impl SemanticAnalysis {
    fn collect_pattern_dependencies self:SemanticAnalysis pattern:PatternValue {
        pattern match
            PatternValue::Struct(struct_pattern) => {
                if "" struct_pattern.struct_name != then
                    struct_pattern.struct_name self.add_dependency
                fi
            }
            PatternValue::EnumVariant(variant) => {
                if "" variant.enum_name != then
                    variant.enum_name self.add_dependency
                fi
            }
            PatternValue::Literal => { }
        end
    }

    fn collect_operation_facts self:SemanticAnalysis function:Function operation_node:Op {
        if operation_node.type_hint Option::Some(type_hint) is then
            type_hint self.add_type_dependency
        fi
        if operation_node.deferred_return_hint Option::Some(return_hint) is then
            return_hint self.add_type_dependency
        fi

        operation_node.value = operation_value
        if operation_value OpValue::DeclareGlobal(global_name) is then
            true operation_node.location global_name self.add_global_reference
        elif
        operation_value OpValue::PushVar is
        operation_value OpValue::PushCapture is ||
        operation_value OpValue::AssignVar is ||
        operation_value OpValue::AssignInc is ||
        operation_value OpValue::AssignDec is ||
        then
            false operation_node.location operation_node op_str_value
            self.add_global_reference
        fi

        operation_value match
            OpValue::StructNew(casa_struct) => { casa_struct.name self.add_dependency }
            OpValue::StructLiteral(literal) => { literal.struct_name self.add_dependency }
            OpValue::PushEnumVariant(variant) => { variant.enum_name self.add_dependency }
            OpValue::IsCheck(variant) => { variant.enum_name self.add_dependency }
            OpValue::TypeCast(cast_type) => { cast_type self.add_type_dependency }
            OpValue::MatchArm(arm) => {
                arm.pattern_value self.collect_pattern_dependencies
            }
            _ => { }
        end
    }

    fn construct_struct_type
        self:SemanticAnalysis
        stack:SemanticStack
        casa_struct:CasaStruct
    -> Type {
        Map[str Type]:: new = bindings
        for member in casa_struct.members.iter do
            if stack.pop Option::Some(actual_type) is then
                bindings actual_type member.typ bind_semantic_type_arguments = bindings
            fi
        done
        bindings casa_struct.type_vars casa_struct.name build_resolved_type
    }

    fn construct_struct_literal_type
        self:SemanticAnalysis
        stack:SemanticStack
        literal:StructLiteral
    -> Type {
        if literal.struct_name self.store.structs.get Option::Some(casa_struct) is then
            Map[str Type]:: new = bindings
            literal.field_order.length = field_index
            while 0 field_index != do
                1 -= field_index
                field_index literal.field_order.get = field_name
                stack.pop = actual_type_result
                actual_type_result field_name casa_struct bindings
                self.bind_struct_literal_field = bindings
            done
            bindings casa_struct.type_vars casa_struct.name build_resolved_type return
        fi
        literal.field_order.length stack.drop_count
        literal.struct_name GenericType::new Type::Generic
    }

    fn bind_struct_literal_field
        self:SemanticAnalysis
        bindings:Map[str Type]
        casa_struct:CasaStruct
        field_name:str
        actual_type_result:Option[Type]
    -> Map[str Type] {
        for member in casa_struct.members.iter do
            if field_name member.name == then
                if actual_type_result Option::Some(actual_type) is then
                    bindings actual_type member.typ bind_semantic_type_arguments = bindings
                fi
                break
            fi
        done
        bindings
    }

    fn bind_enum_payload
        self:SemanticAnalysis
        stack:SemanticStack
        expected_types:List[Type]
    -> Map[str Type] {
        Map[str Type]:: new = bindings
        for expected_type in expected_types.iter do
            if stack.pop Option::Some(actual_type) is then
                bindings actual_type expected_type bind_semantic_type_arguments = bindings
            fi
        done
        bindings
    }

    fn construct_enum_type self:SemanticAnalysis stack:SemanticStack variant:EnumVariant -> Type {
        if variant.enum_name self.store.enums.get Option::Some(casa_enum) is then
            List[Type]:: new = expected_types
            if variant.variant_name casa_enum.variant_types.get Option::Some(variant_types) is then
                variant_types = expected_types
            fi
            expected_types stack self.bind_enum_payload = bindings
            bindings casa_enum.type_vars casa_enum.name build_resolved_type return
        fi
        variant.enum_name GenericType::new Type::Generic
    }

    fn push_variable_type self:SemanticAnalysis function:Function stack:SemanticStack name:str {
        if name stack.get_variable_type Option::Some(variable_type) is then
            variable_type stack.push
            return
        fi
        if name function self.get_variable_type Option::Some(variable_type) is then
            variable_type stack.push
        fi
    }

    fn make_pattern_substitutions
        self:SemanticAnalysis
        type_variables:List[str]
        subject_type:Option[Type]
    -> Map[str Type] {
        Map[str Type]:: new = substitutions
        if subject_type Option::Some(subject) is then
            if subject Type::Generic(subject_generic) is then
                for pair in subject_generic.params.iter type_variables.iter.zip do
                    pair.second pair.first substitutions.set = substitutions
                done
            fi
        fi
        substitutions
    }

    fn assign_struct_pattern_field
        self:SemanticAnalysis
        stack:SemanticStack
        casa_struct:CasaStruct
        substitutions:Map[str Type]
        field_name:str
        bound_name:str
    {
        for member in casa_struct.members.iter do
            if field_name member.name == then
                substitutions member.typ.substitute_t Option::Some
                bound_name
                stack.assign_variable_type
                return
            fi
        done
    }

    fn assign_struct_pattern_bindings
        self:SemanticAnalysis
        stack:SemanticStack
        subject_type:Option[Type]
        pattern:StructPattern
    {
        if pattern.struct_name self.store.structs.get Option::Some(casa_struct) is then
            subject_type casa_struct.type_vars self.make_pattern_substitutions = substitutions
            for field_name in pattern.bindings.keys.iter do
                if field_name pattern.bindings.get Option::Some(bound_name) is then
                    bound_name field_name substitutions casa_struct stack
                    self.assign_struct_pattern_field
                fi
            done
        fi
    }

    fn assign_enum_pattern_payloads
        self:SemanticAnalysis
        stack:SemanticStack
        substitutions:Map[str Type]
        payload_types:List[Type]
        binding_names:List[str]
    {
        for pair in binding_names.iter payload_types.iter.zip do
            substitutions pair.first.substitute_t Option::Some
            pair.second
            stack.assign_variable_type
        done
    }

    fn assign_enum_pattern_bindings
        self:SemanticAnalysis
        stack:SemanticStack
        subject_type:Option[Type]
        variant:EnumVariant
    {
        if variant.enum_name self.store.enums.get Option::Some(casa_enum) is then
            subject_type casa_enum.type_vars self.make_pattern_substitutions = substitutions
            if variant.variant_name casa_enum.variant_types.get Option::Some(payload_types) is then
                variant.bindings payload_types substitutions stack
                self.assign_enum_pattern_payloads
            fi
        fi
    }

    fn assign_pattern_bindings
        self:SemanticAnalysis
        stack:SemanticStack
        subject_type:Option[Type]
        pattern:PatternValue
    {
        pattern match
            PatternValue::Struct(struct_pattern) => {
                struct_pattern subject_type stack self.assign_struct_pattern_bindings
            }
            PatternValue::EnumVariant(variant) => {
                variant subject_type stack self.assign_enum_pattern_bindings
            }
            PatternValue::Literal => { }
        end
    }

    fn collect_semantic_dependencies self:SemanticAnalysis semantics:SemanticFacts {
        for dependency in semantics.dependencies.iter do
            dependency self.add_dependency
        done
    }

    fn collect_bound_semantics self:SemanticAnalysis effect:StackEffect bindings:Map[str Type] {
        self.store bindings effect collect_bound_semantic_dependencies = dependencies
        for dependency in dependencies.iter do
            dependency self.add_dependency
        done
    }

    fn apply_shared_semantics
        self:SemanticAnalysis
        stack:SemanticStack
        function:Function
        operation:OpValue
    -> bool {
        stack.peek = receiver
        self.store function Option::Some receiver operation analyze_operation = semantics
        semantics self.collect_semantic_dependencies
        if semantics.stack_effect Option::None is then false return fi
        semantics.stack_effect.unwrap = effect

        if operation OpValue::FnCall(function_name) is then
            if function_name self.get_function_effect Option::Some(inferred_effect) is then
                inferred_effect = effect
            fi
        elif operation OpValue::FnPush(function_name) is then
            if function_name self.get_function_effect Option::Some(inferred_effect) is then
                inferred_effect make_function_reference_stack_effect = effect
            fi
        elif semantics.method Option::Some(method) is then
            if method.kind MethodSemanticsKind::Function is then
                method.function_name self.get_function_effect = inferred_effect_opt
                if inferred_effect_opt Option::Some(inferred_effect) is then
                    inferred_effect = effect
                fi
            fi
        fi

        if operation OpValue::FnExec is then
            stack.pop drop
        fi
        effect stack.apply_effect_with_bindings = bindings
        bindings effect self.collect_bound_semantics
        true
    }

    fn update_type_stack
        self:SemanticAnalysis
        function:Function
        operation_node:Op
        stack:SemanticStack
    {
        operation_node.value = operation_value
        if operation_value OpValue::PushInt is then
            if operation_node.type_hint Option::Some(type_hint) is then
                type_hint stack.push
            else
                TYPE_I64_T stack.push
            fi
            return
        fi
        if operation_value OpValue::PushFloat is then
            if operation_node.type_hint Option::Some(type_hint) is then
                type_hint stack.push
            else
                TYPE_F64_T stack.push
            fi
            return
        fi
        if operation_node.type_hint Option::Some(type_hint) is then
            if operation_value operation_is_comparison then
                stack.pop drop
                stack.pop drop
                TYPE_BOOL_T stack.push
                return
            fi
            if
            operation_value OpValue::Add is
            operation_value OpValue::Sub is ||
            operation_value OpValue::Mul is ||
            operation_value OpValue::Div is ||
            operation_value OpValue::Mod is ||
            operation_value OpValue::Shl is ||
            operation_value OpValue::Shr is ||
            operation_value OpValue::BitAnd is ||
            operation_value OpValue::BitOr is ||
            operation_value OpValue::BitXor is ||
            operation_value OpValue::WrappingAdd is ||
            operation_value OpValue::WrappingSub is ||
            operation_value OpValue::WrappingMul is ||
            then
                stack.pop drop
                stack.pop drop
                type_hint stack.push
                return
            fi
            if operation_value OpValue::BitNot is then
                stack.pop drop
                type_hint stack.push
                return
            fi
        fi
        if operation_value function stack self.apply_shared_semantics then return fi

        operation_value match
            OpValue::PushVar(name) => { name stack function self.push_variable_type }
            OpValue::PushCapture(name) => { name stack function self.push_variable_type }
            OpValue::StructNew(casa_struct) => {
                casa_struct stack self.construct_struct_type stack.push
            }
            OpValue::StructLiteral(literal) => {
                literal stack self.construct_struct_literal_type stack.push
            }
            OpValue::PushEnumVariant(variant) => {
                variant stack self.construct_enum_type stack.push
            }
            OpValue::TypeCast(cast_type) => {
                stack.pop drop
                cast_type stack.push
            }
            OpValue::NumericConvert(conversion) => {
                stack.pop drop
                conversion.target Type::Builtin stack.push
            }
            OpValue::NumericTry(numeric_try) => {
                stack.pop drop
                List[Type]:: new = option_params
                numeric_try.target Type::Builtin option_params.push
                option_params "Option" GenericType Type::Generic stack.push
            }
            OpValue::IntegerTry(integer_try) => {
                stack.pop drop
                stack.pop drop
                List[Type]:: new = option_params
                integer_try.target Type::Builtin option_params.push
                option_params "Option" GenericType Type::Generic stack.push
            }
            OpValue::FloatRound(rounding) => {
                stack.pop drop
                rounding.target Type::Builtin stack.push
            }
            OpValue::FloatFromDecimal => {
                stack.pop drop
                stack.pop drop
                TYPE_F64_T stack.push
            }
            OpValue::FloatSignificand => {
                stack.pop drop
                stack.pop drop
                TYPE_U64_T stack.push
            }
            OpValue::IfStart => {
                false
                SemanticBranchKind::If
                Option[Type]:: None
                stack.start_branch
            }
            OpValue::IfCondition => {
                stack.pop drop
                stack.capture_branch_entry
                if 0 stack.branches.length != then
                    stack.branches.length 1 - stack.branches.get = branch
                    true = branch.active
                fi
            }
            OpValue::IfElif => {
                stack self.merge_branch_exit
                stack.restore_branch_entry
            }
            OpValue::IfElse => {
                stack self.merge_branch_exit
                stack.restore_branch_entry
                if 0 stack.branches.length != then
                    stack.branches.length 1 - stack.branches.get = branch
                    true = branch.has_default
                fi
            }
            OpValue::IfEnd => {
                false = include_entry
                if 0 stack.branches.length != then
                    stack.branches.length 1 - stack.branches.get.has_default ! = include_entry
                fi
                include_entry stack self.finish_branch
            }
            OpValue::WhileStart => {
                true
                SemanticBranchKind::While
                Option[Type]:: None
                stack.start_branch
            }
            OpValue::WhileCondition => { stack.pop drop }
            OpValue::WhileEnd => { stack.end_loop }
            OpValue::MatchStart => {
                true
                SemanticBranchKind::Match
                stack.pop
                stack.start_branch
            }
            OpValue::MatchArm(arm) => {
                stack self.merge_branch_exit
                stack.restore_branch_entry
                if 0 stack.branches.length != then
                    stack.branches.length 1 - stack.branches.get = branch
                    true = branch.active
                fi
                arm.pattern_value stack.get_branch_subject stack self.assign_pattern_bindings
                arm.guard_ops function stack self.collect_operations_with_stack
                if 0 arm.guard_ops.length != then
                    stack.pop drop
                fi
            }
            OpValue::MatchEnd => { false stack self.finish_branch }
            OpValue::IsCheck(variant) => {
                variant stack.peek stack self.assign_enum_pattern_bindings
                TYPE_BOOL_T 1 stack.apply_result
            }
            OpValue::AssignVar(name) => { stack.pop name stack.assign_variable_type }
            OpValue::AssignInc(name) => {
                stack.pop drop
                TYPE_I64_T Option::Some name stack.assign_variable_type
            }
            OpValue::AssignDec(name) => {
                stack.pop drop
                TYPE_I64_T Option::Some name stack.assign_variable_type
            }
            OpValue::PushArray(items) => {
                items function stack self.collect_operations_with_stack
                TYPE_UNKNOWN_T stack.peek.unwrap_or = element_type
                items.length stack.drop_count
                List[Type]:: new = array_parameters
                element_type array_parameters.push
                array_parameters "array" GenericType Type::Generic stack.push
            }
            OpValue::ExprGroup(items) => { items function stack self.collect_operations_with_stack }
            _ => { }
        end
    }

    fn collect_operations_with_stack
        self:SemanticAnalysis
        stack:SemanticStack
        function:Function
        operations:List[Op]
    {
        for operation_node in operations.iter do
            operation_node function self.collect_operation_facts
            stack operation_node function self.update_type_stack
        done
    }

    fn collect_operations
        self:SemanticAnalysis
        function:Function
        operations:List[Op]
    -> StackEffect {
        function SemanticStack::new = stack
        operations function stack self.collect_operations_with_stack
        stack.types.clone stack.parameters StackEffect::new
    }
}

fn analyze_function_semantics
    function:Function
    inferred_effects:Map[str StackEffect]
    store:SymbolStore
-> FunctionSemantics {
    inferred_effects store SemanticAnalysis::new = analysis
    function.ops function analysis.collect_operations = inferred_effect
    inferred_effect
    analysis.ordered_facts
    FunctionSemantics
}
