    fn collect_executable_return_summary
        self:mut$TypeChecker
        callables:$std::Set[std::String]
        effect:$common::StackEffect
    -> CallReturnSummary bool {
        CallReturnSummary::new = summary
        callables.is_empty ! = precise
        for callable in callables.iter do
            if
                callable.as_str CALLABLE_PARAMETER_PREFIX str::starts_with
