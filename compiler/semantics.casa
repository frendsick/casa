    if method.kind MethodSemanticsKind::Function is then
        method.function_name.clone result.dependencies.push
    elif method.kind MethodSemanticsKind::DefaultMethod is then
        if method.trait_name.as_str store.traits.get_str std::Option::Some(casa_trait) is then
            store casa_trait receiver collect_trait_implementation_dependencies = implementations
            implementations result.dependencies.append
        fi
    fi
}

pub fn analyze_method_operation
    result:mut$SemanticFacts
    method_name:$str
    receiver:$common::Type
    function_opt:$std::Option[common::Function]
    store:$common::SymbolStore
-> std::Option[MethodSemantics] {
    store function_opt receiver method_name resolve_method_semantics = method_opt
    method_opt match
        std::Option::Some(method) => {
            store receiver method result add_method_dependencies
            method std::Option::Some
        }
        std::Option::None => std::Option[MethodSemantics]::None
    end
}

pub fn parse_trait_method_name hidden_name:$str -> std::Option[std::String] {
    "__trait_" = hidden_prefix
    if hidden_name hidden_prefix str::starts_with ! then
        std::Option[std::String]::None return
    fi
    hidden_name hidden_prefix.length hidden_name.length hidden_prefix.length - str::substring
    = trait_suffix
    trait_suffix.as_str "_" str::find = separator
    if separator 0 >= then
        std::Option[std::String]::None return
    fi
    trait_suffix.as_str separator 1 + (u64) trait_suffix.length separator (u64) - 1 - str::substring std::Option::Some
}

pub fn analyze_operation
    operation:$common::OpValue
    receiver:std::Option[$common::Type]
    function_opt:$std::Option[common::Function]
    store:$common::SymbolStore
-> SemanticFacts {
    SemanticFacts::new = result
    operation fixed_operation_stack_effect = result.stack_effect
    operation operation_syscall_argument_count = result.syscall_argument_count
    if result.syscall_argument_count std::Option::Some(argument_count) is then
        argument_count make_syscall_stack_effect std::Option::Some = result.stack_effect
        argument_count = result.word_parameter_count
        1 = result.word_parameter_start
    fi
    operation match
        common::OpValue::FnCall(function_name) => {
            function_name.clone result.dependencies.push
            if function_name.as_str store.get_function std::Option::Some(function) is then
                function.stack_effect.clone std::Option::Some = result.stack_effect
            fi
        }
        common::OpValue::FnPush(function_name) => {
            function_name.clone result.dependencies.push
            if function_name.as_str store.get_function std::Option::Some(function) is then
                function.stack_effect.clone make_function_reference_stack_effect std::Option::Some
                = result.stack_effect
            fi
        }
        common::OpValue::FnExec => {
            if receiver std::Option::Some(receiver_type) is then
                if receiver_type common::Type::Function(function_type) is then
                    function_type common::function_type_to_stack_effect std::Option::Some = result.stack_effect
                fi
            fi
        }
        common::OpValue::FnExecOwned => {
            if receiver std::Option::Some(receiver_type) is then
                if receiver_type common::Type::Function(function_type) is then
                    function_type common::function_type_to_stack_effect std::Option::Some = result.stack_effect
                fi
            fi
        }
        common::OpValue::MethodCall(method_name) => {
            if receiver std::Option::Some(receiver_type) is then
                store function_opt receiver_type method_name.as_str result analyze_method_operation match
                    std::Option::Some(method) => {
                        method.stack_effect.clone std::Option::Some = result.stack_effect
                        method std::Option::Some = result.method
                    }
                    std::Option::None => {
                    }
                end
            fi
        }
        common::OpValue::QualifiedMethodCall(qualified) => {
            if receiver std::Option::Some(receiver_type) is then
                std::Option[MethodSemantics]::None = method_opt
                if qualified.type_qualified then
                    store function_opt qualified.qualifier_type qualified.method_name.as_str resolve_method_semantics
                    = method_opt
                else
                    store receiver_type qualified.qualifier_type qualified.method_name.as_str resolve_qualified_method_semantics
                    = method_opt
                fi
                method_opt match
                    std::Option::Some(method) => {
                        method.stack_effect.clone std::Option::Some = result.stack_effect
                        if qualified.type_qualified then
                            store qualified.qualifier_type method result add_method_dependencies
                        else
                            store receiver_type method result add_method_dependencies
                        fi
                        method std::Option::Some = result.method
                    }
                    std::Option::None => {
                    }
                end
            fi
        }
        common::OpValue::TraitMethodCall(call) => {
            std::Option[MethodSemantics]::None = method_opt
            if function_opt std::Option::Some(function) is then
                store function call.trait_type call.receiver call.method_name.as_str resolve_bound_method_semantics = method_opt
            fi
            if method_opt.is_none then
                if call.trait_type std::Option::Some(trait_type) is then
                    store call.receiver trait_type call.method_name.as_str resolve_qualified_method_semantics = method_opt
                else
                    store function_opt call.receiver call.method_name.as_str resolve_method_semantics = method_opt
                fi
            fi
            method_opt match
                std::Option::Some(method) => {
                    method.stack_effect.clone std::Option::Some = result.stack_effect
                    store call.receiver method result add_method_dependencies
                    method std::Option::Some = result.method
                }
                std::Option::None => {
                }
            end
        }
        common::OpValue::TraitMethodRef(call) => {
            store function_opt call.receiver call.method_name.as_str result analyze_method_operation match
                std::Option::Some(method) => {
                    method.stack_effect.clone make_function_reference_stack_effect std::Option::Some
                    = result.stack_effect
                    method std::Option::Some = result.method
                }
                std::Option::None => {
                }
            end
        }
        common::OpValue::Print => {
            if receiver std::Option::Some(receiver_type) is then
                receiver_type primitive_print_operation = result.resolved_operation
                if result.resolved_operation.is_none receiver_type.is_unknown_placeholder ! && then
                    common::STD_DISPLAY_TRAIT.to_str result.dependencies.push
                    store function_opt receiver_type "to_str" result analyze_method_operation = method_opt
                    method_opt match
                        std::Option::Some(method) => method std::Option::Some = result.method
                        std::Option::None => {
                        }
                    end
                fi
            fi
        }
        common::OpValue::FstringToStr => {
            if receiver std::Option::Some(receiver_type) is then
                if common::make_str_type receiver_type.eq ! receiver_type.is_unknown_placeholder ! && then
                    common::STD_DISPLAY_TRAIT.to_str result.dependencies.push
                    store function_opt receiver_type "to_str" result analyze_method_operation = method_opt
                    method_opt match
                        std::Option::Some(method) => method std::Option::Some = result.method
                        std::Option::None => {
                        }
                    end
                fi
            fi
        }
        common::OpValue::PrimitiveToStr => {
        }
        _ => {
        }
    end
    if operation operation_is_comparison then
        if receiver std::Option::Some(receiver_type) is then
            if store receiver_type comparison_uses_method then
                operation comparison_trait_name result.dependencies.push_str
                operation comparison_method_name = method_name
                store function_opt receiver_type method_name result analyze_method_operation = method_opt
                method_opt match
                    std::Option::Some(method) => method std::Option::Some = result.method
                    std::Option::None => {
                    }
                end
            fi
        fi
    fi
    result
}

pub fn make_type_borrow_option value:$common::Type -> std::Option[$common::Type] {
    value std::Option::Some(std::Option[$common::Type])
}

pub struct FunctionSemantics {
    pub ordered_facts:   std::List[SemanticDependency]
    pub inferred_effect: common::StackEffect
}

impl FunctionSemantics {
    pub fn has_symbol_dependency self:mut$FunctionSemantics dependency:$str -> bool {
        for fact in self.ordered_facts.iter do
            if fact SemanticDependency::Symbol(symbol) is then
                if symbol.as_str dependency == then
                    true return
                fi
            fi
        done
        false
    }
}

pub enum SemanticDependency {
    Symbol (std::String)
    Call (std::String)
    BoundCall (SemanticBoundCall)
    DefaultMethodCall (SemanticDefaultMethodCall)
    Type (common::Type)
    Global (SemanticGlobalReference)
}

pub struct SemanticBoundCall {
    pub function_name:      std::String
    pub argument_callables: std::Map[std::String std::Set[std::String]]
}

pub fn bind_stack_callable_arguments
    effect:$common::StackEffect
    stack:$SemanticStack
    skip_callable:bool
-> std::Map[std::String std::Set[std::String]] {
    std::Map[std::String std::Set[std::String]]::new = argument_callables
    stack.callables.clone = stack_callables
    if skip_callable 0 stack_callables.length != && then
        stack_callables.pop drop
    fi
    for parameter in effect.parameters.iter do
        if parameter.name.as_str common::is_hidden_parameter_name then
            continue
        fi
        if 0 stack_callables.length == then
            break
        fi
        stack_callables.pop = callables
        if "" parameter.name.as_str != then
            callables parameter.name.clone argument_callables.set
        fi
    done
    argument_callables
}

pub fn has_callable_arguments
    argument_callables:$std::Map[std::String std::Set[std::String]]
-> bool {
    for callables in argument_callables.values.iter do
        if callables.is_empty ! then
            true return
        fi
    done
    false
}

pub fn make_default_method_function
    name:std::String
    ops:std::List[common::Op]
    effect:common::StackEffect
-> common::Function {
    std::List[common::Op]::new = function_ops
    std::List[common::Variable]::new = variables
    for parameter in effect.parameters.iter do
        if "" parameter.name.as_str == parameter.name.as_str common::is_hidden_parameter_name || then
            continue
        fi
        parameter.typ common::clone_type parameter.name.clone common::Variable variables.push
        common::empty_location parameter.name.clone common::OpValue::AssignVar common::Op::new
        function_ops.push
    done
    ops function_ops.append
    effect common::empty_location function_ops name common::Function::with_stack_effect = function
    variables = function.variables
    function
}

pub struct SemanticDefaultMethodCall {
    pub trait_name:         std::String
    pub method_name:        std::String
    pub stack_effect:       common::StackEffect
    pub argument_callables: std::Map[std::String std::Set[std::String]]
}

pub struct SemanticGlobalReference {
    pub name:            std::String
    pub location:        common::Location
    pub declared_global: bool
}

pub struct SemanticAnalysis {
    pub store:             mut$common::SymbolStore
    pub inferred_effects:  mut$std::Map[std::String common::StackEffect]
    pub seen_dependencies: std::Set[std::String]
    pub ordered_facts:     std::List[SemanticDependency]
    pub active_calls:      std::Set[std::String]
}

impl SemanticAnalysis {
    pub fn merge_branch_callables merged:mut$SemanticStackSnapshot current:$SemanticStackSnapshot {
        if merged.callables.length current.callables.length != then
            return
        fi
        0 = index: u64
        while index merged.callables.length > do
            index merged.callables.get_mut = merged_callables
            for
                function_name in index current
                    .callables
                    .get
                    .iter
            do
                function_name.clone merged_callables.add
            done
            1 += index
        done
    }

    pub fn merge_branch_variable
        self:mut$SemanticAnalysis
        merged:mut$SemanticStackSnapshot
        current:$SemanticStackSnapshot
        variable_name:$str
    {
        variable_name current.variables.get_str = current_result
        variable_name merged.variables.get_str = merged_result
        if current_result.is_none merged_result.is_none || then
            return
        fi
        self.store current_result.unwrap merged_result.unwrap unify_type_t = unified
        if unified std::Option::Some(type_value) is then
            type_value common::clone_type variable_name.clone merged.variables.set_str
        fi
        variable_name current.variable_callables clone_variable_callables = current_callables
        variable_name merged.variable_callables clone_variable_callables = merged_callables
        for function_name in current_callables.iter do
            function_name.clone merged_callables.add
        done
        merged_callables variable_name.clone merged.variable_callables.set_str
    }

    pub fn merge_branch_exit self:mut$SemanticAnalysis stack:mut$SemanticStack {
        if 0 stack.branches.length == then
            return
        fi
        stack.branches.pop = branch
        if branch.active ! then
            branch stack.branches.push
            return
        fi
        stack.snapshot = current
        if branch.after std::Option::None is then
            current std::Option::Some = branch.after
            branch stack.branches.push
            return
        fi
        branch.after = after: mut$std::Option[SemanticStackSnapshot]
        if after std::Option::Some(merged) is then
            if merged.types.length current.types.length == then
                current merged SemanticAnalysis::merge_branch_callables
                0 (u64) = index
                while index merged.types.length > do
                    self.store index current.types.get index merged.types.get unify_type_t
                    = unified
                    if unified std::Option::Some(type_value) is then
                        type_value common::clone_type index merged.types.set
                    fi
                    1 += index
                done
                for
                    variable_name in merged
                        .variables
                        .keys
                        .iter
                do
                    variable_name.as_str current merged self.merge_branch_variable
                done
            fi
        fi
        branch stack.branches.push
    }

    pub fn finish_branch self:mut$SemanticAnalysis stack:mut$SemanticStack include_entry:bool {
        stack self.merge_branch_exit
        if 0 stack.branches.length == then
            return
        fi
        stack.branches.pop = branch
        if include_entry branch.before std::Option::Some(entry) is && then
            entry stack.restore
            true = branch.active
            branch stack.branches.push
            stack self.merge_branch_exit
            stack.branches.pop = branch
        fi
        if branch.after std::Option::Some(after) is then
            after stack.restore
        fi
    }

    pub fn new
        store:mut$common::SymbolStore
        inferred_effects:mut$std::Map[std::String common::StackEffect]
    -> SemanticAnalysis {
        std::Set[std::String]::new
        std::List[SemanticDependency]::new
        std::Set[std::String]::new
        inferred_effects
        store
        SemanticAnalysis
    }

    pub fn finish self:SemanticAnalysis inferred_effect:common::StackEffect -> FunctionSemantics {
        self match
            SemanticAnalysis { ordered_facts: ordered_facts } => inferred_effect ordered_facts FunctionSemantics
        end
    }

    pub fn add_dependency self:mut$SemanticAnalysis dependency:$str {
        if dependency self.seen_dependencies.has_str ! then
            dependency self.seen_dependencies.add_str
            dependency.to_str SemanticDependency::Symbol self.ordered_facts.push
        fi
    }

    pub fn add_type_dependency self:mut$SemanticAnalysis type_value:common::Type {
        type_value SemanticDependency::Type self.ordered_facts.push
    }

    pub fn add_call self:mut$SemanticAnalysis function_name:$str {
        function_name.to_str SemanticDependency::Call self.ordered_facts.push
    }

    pub fn add_bound_call
        self:mut$SemanticAnalysis
        function_name:$str
        argument_callables:std::Map[std::String std::Set[std::String]]
    {
        argument_callables function_name.to_str SemanticBoundCall
        SemanticDependency::BoundCall self.ordered_facts.push
    }

    pub fn add_stack_aware_call
        self:mut$SemanticAnalysis
        stack:$SemanticStack
        function_name:$str
        skip_callable:bool
    -> std::Map[std::String std::Set[std::String]] {
        std::Map[std::String std::Set[std::String]]::new = argument_callables
        if function_name self.store.get_function std::Option::Some(function) is then
            skip_callable stack function.stack_effect bind_stack_callable_arguments = argument_callables
        fi
        if argument_callables has_callable_arguments then
            argument_callables.clone function_name self.add_bound_call
        else
            function_name self.add_call
        fi
        argument_callables
    }

    pub fn collect_call_return_callables
        self:mut$SemanticAnalysis
        function_name:$str
        argument_callables:$std::Map[std::String std::Set[std::String]]
    -> std::List[std::Set[std::String]] {
        if function_name self.active_calls.has_str then
            std::List[std::Set[std::String]]::new return
        fi
        std::Option[common::Function]::None = called_function
        if function_name self.store.get_function std::Option::Some(function) is then
            function.clone_for_import std::Option::Some = called_function
        fi
        if called_function std::Option::None is then
            std::List[std::Set[std::String]]::new return
        fi
        called_function.unwrap = function
        false = returns_callable
        for
            return_type in function
                .stack_effect
                .return_types
                .iter
        do
            if return_type common::Type::Function is then
                true = returns_callable
                break
            fi
        done
        if returns_callable ! then
            std::List[std::Set[std::String]]::new return
        fi
        function_name self.active_calls.add_str
        function SemanticStack::new = stack
        argument_callables stack.seed_parameter_callables
        function.ops common::clone_ops = operations
        operations function stack self.collect_operations_with_stack
        function_name self.active_calls.remove_str
        stack.callables.clone
    }

    pub fn collect_default_method_return_callables
        self:mut$SemanticAnalysis
        method:$MethodSemantics
        argument_callables:$std::Map[std::String std::Set[std::String]]
    -> std::List[std::Set[std::String]] {
        false = returns_callable
        for
            return_type in method
                .stack_effect
                .return_types
                .iter
        do
            if return_type common::Type::Function is then
                true = returns_callable
                break
            fi
        done
        if returns_callable ! then
            std::List[std::Set[std::String]]::new return
        fi
        f"default:{method.trait_name}:{method.method_name}" = call_key
        if call_key.as_str self.active_calls.has_str then
            std::List[std::Set[std::String]]::new return
        fi
        std::List[common::Op]::new = default_ops
        if
            method.trait_name.as_str self
                .store
                .traits
                .get_str std::Option::Some(casa_trait) is
        then
            for trait_method in casa_trait.methods.iter do
                if trait_method.name.as_str method.method_name.as_str == then
                    trait_method.default_ops common::clone_ops = default_ops
                    break
                fi
            done
        fi
        call_key.clone self.active_calls.add
        method.stack_effect.clone default_ops call_key make_default_method_function = function
        function SemanticStack::new = stack
        argument_callables stack.seed_parameter_callables
        function.ops common::clone_ops = operations
        operations function stack self.collect_operations_with_stack
        function.name.as_str self.active_calls.remove_str
        stack.callables.clone
    }

    pub fn add_default_method_call
        self:mut$SemanticAnalysis
        method:$MethodSemantics
        argument_callables:$std::Map[std::String std::Set[std::String]]
    {
        argument_callables.clone method.stack_effect.clone method.method_name.clone
        method.trait_name.clone SemanticDefaultMethodCall
        SemanticDependency::DefaultMethodCall self.ordered_facts.push
    }

    pub fn add_global_reference
        self:mut$SemanticAnalysis
        name:$str
        location:common::Location
        declared_global:bool
    {
        declared_global location name.to_str SemanticGlobalReference = reference
        reference SemanticDependency::Global self.ordered_facts.push
    }

    pub fn get_variable_type
        self:mut$SemanticAnalysis
        function:mut$common::Function
        variable_name:$str
    -> std::Option[common::Type] {
        variable_name get_variable_root_name = root_name
        for variable in function.variables.iter do
            if variable.name root_name == then
                variable.typ common::clone_type std::Option::Some return
            fi
        done
        for capture in function.captures.iter do
            if capture.name root_name == then
                capture.typ common::clone_type std::Option::Some return
            fi
        done
        if
            root_name.as_str self
                .store
                .variables
                .get_str std::Option::Some(variable) is
        then
            variable.typ common::clone_type std::Option::Some return
        fi
        std::Option[common::Type]::None
    }

    pub fn get_function_effect
        self:mut$SemanticAnalysis
        function_name:$str
    -> std::Option[common::StackEffect] {
        if function_name self.inferred_effects.get_str std::Option::Some(effect) is then
            effect.clone std::Option::Some return
        fi
        function_name self.store.take_function_for_update = function_opt
        function_opt match
            std::Option::Some(function) => {
                function.stack_effect.clone = effect
                if effect.needs_inference then
                    effect.clone function_name.clone self.inferred_effects.set_str
                    self.store self.inferred_effects function
                    analyze_function_semantics = semantics
                    function self.store.restore_function
                    semantics.inferred_effect.clone function_name.clone self.inferred_effects.set_str
                    semantics.inferred_effect.clone std::Option::Some return
                fi
                function self.store.restore_function
                effect std::Option::Some return
            }
            std::Option::None => {
            }
        end
        std::Option[common::StackEffect]::None
    }
}

impl SemanticAnalysis {
    pub fn collect_pattern_dependencies self:mut$SemanticAnalysis pattern:$common::PatternValue {
        pattern match
            common::PatternValue::Struct(struct_pattern) => {
                if "" struct_pattern.struct_name.as_str != then
                    struct_pattern.struct_name.as_str self.add_dependency
                fi
            }
            common::PatternValue::EnumVariant(variant) => {
                if "" variant.enum_name.as_str != then
                    variant.enum_name.as_str self.add_dependency
                fi
            }
            common::PatternValue::Literal => {
            }
        end
    }

    pub fn collect_operation_facts
        self:mut$SemanticAnalysis
        function:mut$common::Function
        operation_node:$common::Op
    {
        if operation_node.type_hint std::Option::Some(type_hint) is then
            type_hint common::clone_type self.add_type_dependency
        fi
        if operation_node.deferred_return_hint std::Option::Some(return_hint) is then
            return_hint common::clone_type self.add_type_dependency
        fi

        if operation_node.value common::OpValue::Identifier(name) is then
            if name.as_str "&" str::starts_with then
                name.as_str 1 name.length 1 - str::substring = referenced_name
                if referenced_name.as_str self.store.has_function then
                    referenced_name.as_str self.add_dependency
                fi
            elif name.as_str self.store.has_function then
                name.as_str self.add_dependency
            elif
                name.as_str self
                    .store
                    .variables
                    .has_str
            then
                false operation_node.location.clone name.as_str self.add_global_reference
            fi
        elif operation_node.value common::OpValue::DeclareGlobal(global_name) is then
            true operation_node.location.clone global_name.as_str self.add_global_reference
        elif
            operation_node.value common::OpValue::PushVar is
            operation_node.value common::OpValue::PushCapture is ||
            operation_node.value common::OpValue::AssignVar is ||
            operation_node.value common::OpValue::AssignInc is ||
            operation_node.value common::OpValue::AssignDec is ||
        then
            operation_node common::op_str_value = operation_name
            false operation_node.location.clone operation_name.as_str self.add_global_reference
        fi

        operation_node.value = operation_value: $common::OpValue
        operation_value match
            common::OpValue::StructNew(casa_struct) => {
                casa_struct.name.as_str self.add_dependency
            }
            common::OpValue::StructLiteral(literal) => {
                literal.struct_name.as_str self.add_dependency
            }
            common::OpValue::PushEnumVariant(variant) => {
                variant.enum_name.as_str self.add_dependency
            }
            common::OpValue::IsCheck(variant) => {
                variant.enum_name.as_str self.add_dependency
            }
            common::OpValue::TypeCast(cast_type) => {
                cast_type common::clone_type self.add_type_dependency
            }
            common::OpValue::SizeOf(target_type) => {
                target_type common::clone_type self.add_type_dependency
            }
            common::OpValue::PtrRead(target_type) => {
                target_type common::clone_type self.add_type_dependency
            }
            common::OpValue::PtrWrite(target_type) => {
                target_type common::clone_type self.add_type_dependency
            }
            common::OpValue::PtrAsRef(target_type) => {
                target_type common::clone_type self.add_type_dependency
            }
            common::OpValue::PtrAsMut(target_type) => {
                target_type common::clone_type self.add_type_dependency
            }
            common::OpValue::MatchArm(arm) => {
                arm.pattern_value self.collect_pattern_dependencies
            }
            _ => {
            }
        end
    }

    pub fn construct_struct_type
        self:mut$SemanticAnalysis
        stack:mut$SemanticStack
        casa_struct:$common::CasaStruct
    -> common::Type {
        std::Map[std::String common::Type]::new = bindings
        for member in casa_struct.members.iter do
            if stack.pop std::Option::Some(actual_type) is then
                bindings actual_type member.typ bind_semantic_type_arguments
            fi
        done
        bindings casa_struct.type_vars casa_struct.name.as_str common::build_resolved_type
    }

    pub fn construct_struct_literal_type
        self:mut$SemanticAnalysis
        stack:mut$SemanticStack
        literal:$common::StructLiteral
    -> common::Type {
        if
            literal.struct_name.as_str self
                .store
                .structs
                .get_str std::Option::Some(owned_struct) is
        then
            std::Map[std::String common::Type]::new = bindings
            literal.field_order.length = field_index
            while 0 field_index != do
                1 -= field_index
                field_index literal.field_order.get = field_name
                stack.pop = actual_type_result
                actual_type_result field_name.as_str owned_struct bindings
                SemanticAnalysis::bind_struct_literal_field = bindings
            done
            bindings owned_struct.type_vars owned_struct.name.as_str common::build_resolved_type return
        fi
        literal.field_order.length stack.drop_count
        literal.struct_name.clone common::GenericType::new common::Type::Generic
    }

    pub fn bind_struct_literal_field
        bindings:std::Map[std::String common::Type]
        casa_struct:$common::CasaStruct
        field_name:$str
        actual_type_result:std::Option[common::Type]
    -> std::Map[std::String common::Type] {
        for member in casa_struct.members.iter do
            if field_name member.name.as_str == then
                if actual_type_result std::Option::Some(actual_type) is then
                    bindings actual_type member.typ bind_semantic_type_arguments
                fi
                break
            fi
        done
        bindings
    }

    pub fn bind_enum_payload
        stack:mut$SemanticStack
        expected_types:$std::List[common::Type]
    -> std::Map[std::String common::Type] {
        std::Map[std::String common::Type]::new = bindings
        for expected_type in expected_types.iter do
            if stack.pop std::Option::Some(actual_type) is then
                bindings actual_type expected_type bind_semantic_type_arguments
            fi
        done
        bindings
    }

    pub fn construct_enum_type
        self:mut$SemanticAnalysis
        stack:mut$SemanticStack
        variant:$common::EnumVariant
    -> common::Type {
        if
            variant.enum_name.as_str self
                .store
                .enums
                .get_str std::Option::Some(owned_enum) is
        then
            std::Map[std::String common::Type]::new = bindings
            if variant.variant_name owned_enum.variant_types.get std::Option::Some(variant_types) is then
                variant_types stack SemanticAnalysis::bind_enum_payload = bindings
            fi
            bindings owned_enum.type_vars owned_enum.name.as_str common::build_resolved_type return
        fi
        variant.enum_name.clone common::GenericType::new common::Type::Generic
    }

    pub fn push_variable_type
        self:mut$SemanticAnalysis
        function:mut$common::Function
        stack:mut$SemanticStack
        name:$str
    {
        if name stack.get_variable_type std::Option::Some(variable_type) is then
            variable_type common::clone_type stack.push
            return
        fi
        if name function self.get_variable_type std::Option::Some(variable_type) is then
            variable_type common::clone_type stack.push
        fi
    }

    pub fn make_pattern_substitutions
        type_variables:$std::List[std::String]
        subject_type:$std::Option[common::Type]
    -> std::Map[std::String common::Type] {
        std::Map[std::String common::Type]::new = substitutions
        if subject_type std::Option::Some(subject) is then
            if subject common::Type::Generic(subject_generic) is then
                for pair in subject_generic.params.iter type_variables.iter.zip do
                    pair.second common::clone_type pair.first.clone substitutions.set
                done
            fi
        fi
        substitutions
    }

    pub fn assign_struct_pattern_field
        stack:mut$SemanticStack
        casa_struct:$common::CasaStruct
        substitutions:mut$std::Map[std::String common::Type]
        field_name:$str
        bound_name:$str
    {
        for member in casa_struct.members.iter do
            if field_name member.name.as_str == then
                substitutions member.typ.substitute_t std::Option::Some
                bound_name
                stack.assign_variable_type
                return
            fi
        done
    }

    pub fn assign_struct_pattern_bindings
        self:mut$SemanticAnalysis
        stack:mut$SemanticStack
        subject_type:mut$std::Option[common::Type]
        pattern:common::StructPattern
    {
        if
            pattern.struct_name.as_str self
                .store
                .structs
                .get_str std::Option::Some(owned_struct) is
        then
            subject_type owned_struct.type_vars SemanticAnalysis::make_pattern_substitutions
            = substitutions
            for
                field_name in pattern
                    .bindings
                    .keys
                    .iter
            do
                if field_name pattern.bindings.get std::Option::Some(bound_name) is then
                    bound_name.as_str field_name.as_str substitutions owned_struct stack
                    SemanticAnalysis::assign_struct_pattern_field
                fi
            done
        fi
    }

    pub fn assign_enum_pattern_payloads
        stack:mut$SemanticStack
        substitutions:mut$std::Map[std::String common::Type]
        payload_types:$std::List[common::Type]
        binding_names:$std::List[std::String]
    {
        for pair in binding_names.iter payload_types.iter.zip do
            substitutions pair.first.substitute_t std::Option::Some
            pair.second.as_str
            stack.assign_variable_type
        done
    }

    pub fn assign_enum_pattern_bindings
        self:mut$SemanticAnalysis
        stack:mut$SemanticStack
        subject_type:mut$std::Option[common::Type]
        variant:$common::EnumVariant
    {
        if
            variant.enum_name.as_str self
                .store
                .enums
                .get_str std::Option::Some(owned_enum) is
        then
            subject_type owned_enum.type_vars SemanticAnalysis::make_pattern_substitutions
            = substitutions
            if variant.variant_name owned_enum.variant_types.get std::Option::Some(payload_types) is then
                variant.bindings payload_types substitutions stack
                SemanticAnalysis::assign_enum_pattern_payloads
            fi
        fi
    }

    pub fn assign_pattern_bindings
        self:mut$SemanticAnalysis
        stack:mut$SemanticStack
        subject_type:mut$std::Option[common::Type]
        pattern:common::PatternValue
    {
        pattern match
            common::PatternValue::Struct(struct_pattern) => {
                struct_pattern subject_type stack self.assign_struct_pattern_bindings
            }
            common::PatternValue::EnumVariant(variant) => {
                variant subject_type stack self.assign_enum_pattern_bindings
            }
            common::PatternValue::Literal => {
            }
        end
    }

    pub fn collect_semantic_dependencies self:mut$SemanticAnalysis semantics:mut$SemanticFacts {
        for dependency in semantics.dependencies.iter do
            dependency.as_str self.add_dependency
        done
    }

    pub fn collect_bound_semantics
        self:mut$SemanticAnalysis
        effect:$common::StackEffect
        bindings:mut$std::Map[std::String common::Type]
    {
        self.store bindings effect collect_bound_semantic_dependencies = dependencies
        for dependency in dependencies.iter do
            dependency.as_str self.add_dependency
        done
    }

    pub fn apply_shared_semantics
        self:mut$SemanticAnalysis
        stack:mut$SemanticStack
        function:mut$common::Function
        operation:$common::OpValue
    -> bool {
        stack.peek = receiver
        std::Option[$common::Type]::None = receiver_ref
        if receiver std::Option::Some(receiver_type) is then
            receiver_type make_type_borrow_option = receiver_ref
        fi
        function.clone_declaration std::Option::Some = function_opt
        self.store function_opt receiver_ref operation analyze_operation = semantics
        semantics self.collect_semantic_dependencies
        semantics match
            SemanticFacts { stack_effect: stack_effect resolved_operation: resolved_operation method: method dependencies: dependencies syscall_argument_count: syscall_argument_count word_parameter_start: word_parameter_start word_parameter_count: word_parameter_count } => stack_effect method
        end = method_opt = effect_opt
        std::List[std::Set[std::String]]::new = method_return_callables
        if method_opt std::Option::Some(method) is then
            std::Map[std::String std::Set[std::String]]::new = argument_callables
            if method.kind MethodSemanticsKind::DefaultMethod is then
                false stack method.stack_effect bind_stack_callable_arguments = argument_callables
            elif 0 method.function_name.length != then
                false method.function_name.as_str stack self.add_stack_aware_call = argument_callables
            fi
            if method.kind MethodSemanticsKind::DefaultMethod is then
                argument_callables method self.add_default_method_call
                argument_callables method self.collect_default_method_return_callables
                = method_return_callables
            elif 0 method.function_name.length != then
                argument_callables method.function_name.as_str self.collect_call_return_callables
                = method_return_callables
            fi
        fi
        effect_opt match
            std::Option::Some(effect) => {
                if operation common::OpValue::FnCall(function_name) is then
                    effect function_name.as_str self.get_function_effect.unwrap_or = effect
                elif operation common::OpValue::FnPush(function_name) is then
                    if function_name.as_str self.get_function_effect std::Option::Some(inferred_effect) is then
                        inferred_effect make_function_reference_stack_effect = effect
                    fi
                elif method_opt std::Option::Some(method) is then
                    if method.kind MethodSemanticsKind::Function is then
                        effect method.function_name.as_str self.get_function_effect.unwrap_or = effect
                    fi
                fi

                if operation common::OpValue::FnExec is operation common::OpValue::FnExecOwned is || then
                    stack.pop drop
                fi
                effect stack.apply_effect_with_bindings = bindings
                bindings effect self.collect_bound_semantics
                method_return_callables stack.set_return_callables
                true return
            }
            std::Option::None => {
            }
        end
        false
    }

    pub fn update_type_stack
        self:mut$SemanticAnalysis
        function:mut$common::Function
        operation_node:$common::Op
        stack:mut$SemanticStack
    {
        operation_node.value = operation_value: $common::OpValue
        if operation_value common::OpValue::PushInt is then
            if operation_node.type_hint std::Option::Some(type_hint) is then
                type_hint common::clone_type stack.push
            else
                common::make_i64_type common::clone_type stack.push
            fi
            return
        fi
        if operation_value common::OpValue::PushFloat is then
            if operation_node.type_hint std::Option::Some(type_hint) is then
                type_hint common::clone_type stack.push
            else
                common::make_f64_type common::clone_type stack.push
            fi
            return
        fi
        if operation_value common::OpValue::Question(hidden_name) is then
            if
                1 function
                    .stack_effect
                    .return_types
                    .length !=
            then
                return
            fi
            std::List[common::Op]::new = question_operations
            operation_node.location.clone hidden_name.clone common::OpValue::AssignVar common::Op::new
            question_operations.push
            0 function
                .stack_effect
                .return_types
                .get common::clone_type = return_type
            return_type hidden_name.clone operation_node.location.clone 1 question_operations
            lower_question_operations
            question_operations function stack self.collect_operations_with_stack
            return
        fi
        if operation_node.type_hint std::Option::Some(type_hint) is then
            if operation_value operation_is_comparison then
                stack.pop drop
                stack.pop drop
                common::make_bool_type common::clone_type stack.push
                return
            fi
            if
                operation_value common::OpValue::Add is
                operation_value common::OpValue::Sub is ||
                operation_value common::OpValue::Mul is ||
                operation_value common::OpValue::Div is ||
                operation_value common::OpValue::Mod is ||
                operation_value common::OpValue::Shl is ||
                operation_value common::OpValue::Shr is ||
                operation_value common::OpValue::BitAnd is ||
                operation_value common::OpValue::BitOr is ||
                operation_value common::OpValue::BitXor is ||
                operation_value common::OpValue::WrappingAdd is ||
                operation_value common::OpValue::WrappingSub is ||
                operation_value common::OpValue::WrappingMul is ||
            then
                stack.pop drop
                stack.pop drop
                type_hint common::clone_type stack.push
                return
            fi
            if operation_value common::OpValue::BitNot is then
                stack.pop drop
                type_hint common::clone_type stack.push
                return
            fi
        fi
        if operation_value function stack self.apply_shared_semantics then
            return
        fi

        operation_value match
            common::OpValue::Identifier(name) => {
                if name.as_str "&" str::starts_with then
                    name.as_str 1 name.length 1 - str::substring = referenced_name
                    if referenced_name.as_str self.store.get_function std::Option::Some(referenced) is then
                        referenced.stack_effect common::stack_effect_to_function_type stack.push
                    fi
                else
                    name.as_str stack function self.push_variable_type
                fi
            }
            common::OpValue::PushVar(name) => {
                name.as_str stack function self.push_variable_type
            }
            common::OpValue::PushCapture(name) => {
                name.as_str stack function self.push_variable_type
            }
            common::OpValue::StructNew(casa_struct) => {
                casa_struct stack self.construct_struct_type stack.push
            }
            common::OpValue::StructLiteral(literal) => {
                literal stack self.construct_struct_literal_type stack.push
            }
            common::OpValue::PushEnumVariant(variant) => {
                variant stack self.construct_enum_type stack.push
            }
            common::OpValue::TypeCast(cast_type) => {
                stack.pop drop
                cast_type common::clone_type stack.push
            }
            common::OpValue::SizeOf(_) => {
                common::make_u64_type common::clone_type stack.push
            }
            common::OpValue::NumericConvert(conversion) => {
                stack.pop drop
                conversion.target common::Type::Builtin stack.push
            }
            common::OpValue::NumericTry(numeric_try) => {
                stack.pop drop
                std::List[common::Type]::new = option_params
                numeric_try.target common::Type::Builtin option_params.push
                option_params common::STD_OPTION_TYPE.to_str common::GenericType common::Type::Generic stack.push
            }
            common::OpValue::IntegerTry(integer_try) => {
                stack.pop drop
                stack.pop drop
                std::List[common::Type]::new = option_params
                integer_try.target common::Type::Builtin option_params.push
                option_params common::STD_OPTION_TYPE.to_str common::GenericType common::Type::Generic stack.push
            }
            common::OpValue::FloatRound(rounding) => {
                stack.pop drop
                rounding.target common::Type::Builtin stack.push
            }
            common::OpValue::FloatFromDecimal => {
                stack.pop drop
                stack.pop drop
                common::make_f64_type common::clone_type stack.push
            }
            common::OpValue::FloatSignificand => {
                stack.pop drop
                stack.pop drop
                common::make_u64_type common::clone_type stack.push
            }
            common::OpValue::IfStart => {
                false
                SemanticBranchKind::If
                std::Option[common::Type]::None
                stack.start_branch
            }
            common::OpValue::IfCondition => {
                stack.pop drop
                stack.capture_branch_entry
                if 0 stack.branches.length != then
                    stack.branches.length 1 - stack.branches.get_mut = branch
                    true = branch.active
                fi
            }
            common::OpValue::IfElif => {
                stack self.merge_branch_exit
                stack.restore_branch_entry
            }
            common::OpValue::IfElse => {
                stack self.merge_branch_exit
                stack.restore_branch_entry
                if 0 stack.branches.length != then
                    stack.branches.length 1 - stack.branches.get_mut = branch
                    true = branch.has_default
                fi
            }
            common::OpValue::IfEnd => {
                false = include_entry
                if 0 stack.branches.length != then
                    stack.branches.length 1 - stack
                        .branches
                        .get
                        .has_default ! = include_entry
                fi
                include_entry stack self.finish_branch
            }
            common::OpValue::WhileStart => {
                true
                SemanticBranchKind::While
                std::Option[common::Type]::None
                stack.start_branch
            }
            common::OpValue::WhileCondition => {
                stack.pop drop
            }
            common::OpValue::WhileEnd => {
                stack.end_loop
            }
            common::OpValue::MatchStart => {
                true
                SemanticBranchKind::Match
                stack.pop
                stack.start_branch
            }
            common::OpValue::MatchArm(arm) => {
                stack self.merge_branch_exit
                stack.restore_branch_entry
                if 0 stack.branches.length != then
                    stack.branches.length 1 - stack.branches.get_mut = branch
                    true = branch.active
                fi
                arm.pattern_value common::clone_pattern_value stack.get_branch_subject stack
                self.assign_pattern_bindings
                arm.guard_ops function stack self.collect_operations_with_stack
                if 0 arm.guard_ops.length != then
                    stack.pop drop
                fi
            }
            common::OpValue::MatchEnd => {
                false stack self.finish_branch
            }
            common::OpValue::IsCheck(variant) => {
                variant stack.peek stack self.assign_enum_pattern_bindings
                common::make_bool_type common::clone_type 1 stack.apply_result
            }
            common::OpValue::AssignVar(name) => {
                stack.peek_callables = callables
                if
                    callables.is_empty
                    0 stack.types.length == &&
                    stack.next_parameter stack.parameters.length > &&
                then
                    name.as_str stack.variable_callables clone_variable_callables = callables
                fi
                stack.pop name.as_str stack.assign_variable_type
                callables name.as_str stack.assign_variable_callables
            }
            common::OpValue::AssignInc(name) => {
                stack.pop drop
                common::make_i64_type common::clone_type std::Option::Some name.as_str stack.assign_variable_type
                std::Set[std::String]::new name.as_str stack.assign_variable_callables
            }
            common::OpValue::AssignDec(name) => {
                stack.pop drop
                common::make_i64_type common::clone_type std::Option::Some name.as_str stack.assign_variable_type
                std::Set[std::String]::new name.as_str stack.assign_variable_callables
            }
            common::OpValue::PushArray(items) => {
                items function stack self.collect_operations_with_stack
                common::make_unknown_type common::clone_type stack.peek.unwrap_or = element_type
                items.length stack.drop_count
                items.length element_type common::make_array_type stack.push
            }
            common::OpValue::ExprGroup(items) => {
                items function stack self.collect_operations_with_stack
            }
            _ => {
            }
        end
    }

    pub fn collect_operations_with_stack
        self:mut$SemanticAnalysis
        stack:mut$SemanticStack
        function:mut$common::Function
        operations:$std::List[common::Op]
    {
        for operation_node in operations.iter do
            stack.callables.clone = callables_before
            std::Map[std::String std::Set[std::String]]::new = direct_arguments
            std::List[std::Set[std::String]]::new = indirect_return_callables
            if operation_node.value common::OpValue::FnCall(function_name) is then
                false function_name.as_str stack self.add_stack_aware_call = direct_arguments
            elif operation_node.value common::OpValue::Identifier(function_name) is then
                if function_name.as_str self.store.has_function then
                    false function_name.as_str stack self.add_stack_aware_call = direct_arguments
                fi
            elif
                operation_node.value common::OpValue::FnExec is
                operation_node.value common::OpValue::FnExecOwned is ||
            then
                stack.peek_callables = function_names
                for function_name in function_names.iter do
                    true function_name.as_str stack self.add_stack_aware_call = arguments
                    arguments function_name.as_str self.collect_call_return_callables = returned_callables
                    if indirect_return_callables.is_empty then
                        returned_callables = indirect_return_callables
                    elif indirect_return_callables.length returned_callables.length == then
                        0 (u64) = return_index
                        while return_index returned_callables.length > do
                            return_index indirect_return_callables.get_mut = merged_callables
                            for returned_name in return_index returned_callables.get.iter do
                                returned_name.clone merged_callables.add
                            done
                            1 += return_index
                        done
                    fi
                done
            fi
            operation_node function self.collect_operation_facts
            stack operation_node function self.update_type_stack
            if operation_node.value common::OpValue::FnCall(function_name) is then
                direct_arguments function_name.as_str self.collect_call_return_callables
                = return_callables
                return_callables stack.set_return_callables
            elif operation_node.value common::OpValue::Identifier(function_name) is then
                if function_name.as_str "&" str::starts_with then
                    function_name.as_str 1 function_name.length 1 - str::substring = referenced_name
                    if referenced_name.as_str self.store.has_function then
                        referenced_name.as_str stack.set_top_callable
                    fi
                elif function_name.as_str self.store.has_function then
                    direct_arguments function_name.as_str self.collect_call_return_callables
                    = return_callables
                    return_callables stack.set_return_callables
                else
                    function_name.as_str stack.variable_callables clone_variable_callables
                    stack.set_top_callables
                fi
            elif operation_node.value common::OpValue::FnPush(function_name) is then
                function_name.as_str stack.set_top_callable
            elif
                operation_node.value common::OpValue::FnExec is
                operation_node.value common::OpValue::FnExecOwned is ||
            then
                indirect_return_callables stack.set_return_callables
            elif operation_node.value common::OpValue::PushVar(name) is then
                name.as_str stack.variable_callables clone_variable_callables = pushed_callables
                pushed_callables stack.set_top_callables
            elif operation_node.value common::OpValue::PushCapture(name) is then
                name.as_str stack.variable_callables clone_variable_callables = pushed_callables
                pushed_callables stack.set_top_callables
            elif
                operation_node.value common::OpValue::Dup is
                operation_node.value common::OpValue::Copy is ||
                operation_node.value common::OpValue::Swap is ||
                operation_node.value common::OpValue::Over is ||
                operation_node.value common::OpValue::Rot is ||
            then
                callables_before operation_node.value stack.restore_callable_shuffle
            fi
        done
    }

    pub fn collect_operations
        self:mut$SemanticAnalysis
        function:mut$common::Function
        operations:$std::List[common::Op]
    -> common::StackEffect {
        function SemanticStack::new = stack
        operations function stack self.collect_operations_with_stack
        stack.types.clone stack.parameters.clone common::StackEffect::new
    }
}

pub fn analyze_function_semantics
    function:$common::Function
    inferred_effects:mut$std::Map[std::String common::StackEffect]
    store:mut$common::SymbolStore
-> FunctionSemantics {
    inferred_effects store SemanticAnalysis::new = analysis
    function.clone_declaration = semantic_function
    function.ops semantic_function analysis.collect_operations = inferred_effect
    inferred_effect analysis.finish
}

pub fn analyze_function_semantics_with_callables
    function:$common::Function
    inferred_effects:mut$std::Map[std::String common::StackEffect]
    store:mut$common::SymbolStore
    argument_callables:$std::Map[std::String std::Set[std::String]]
-> FunctionSemantics {
    inferred_effects store SemanticAnalysis::new = analysis
    function.clone_declaration = semantic_function
    semantic_function SemanticStack::new = stack
    argument_callables stack.seed_parameter_callables
    function.ops semantic_function stack analysis.collect_operations_with_stack
    stack.types.clone stack.parameters.clone common::StackEffect::new = inferred_effect
    inferred_effect analysis.finish
}

pub fn analyze_global_initializer_semantics
    operations:$std::List[common::Op]
    inferred_effects:mut$std::Map[std::String common::StackEffect]
    store:mut$common::SymbolStore
-> FunctionSemantics {
    common::empty_location
    operations common::clone_ops
    common::GLOBAL_SCOPE_LABEL.to_str common::Function::new = initializer
    store inferred_effects initializer analyze_function_semantics
}
