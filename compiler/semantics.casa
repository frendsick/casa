    }

    fn add_stack_aware_call
        self:mut$TypeChecker
        function_name:$str
        effect:$common::StackEffect
        layout:$CallStackLayout
    -> CallReturnSummary {
        # Borrowed temporaries must already have places before sources are resolved.
        layout effect self.bind_stack_callable_arguments = argument_callables
        if function_name self.store.get_function std::Option::Some(function) is then
            layout.get_argument_offset = offset
            0 = parameter_index: u64
            while
                parameter_index effect.parameters.length <
                offset self
                    .stack
                    .values
                    .length < &&
            do
                parameter_index effect.parameters.get = parameter
                if
                    "" parameter.name.as_str ==
                    parameter_index function.variables.length < &&
                then
                    self
                        .stack
                        .values
                        .length 1 - offset - self
                        .stack
                        .values
                        .get = argument
                    parameter_index function
                        .variables
                        .get
                        .name
