    fn add_symbol_dependency self:mut$TypeChecker dependency:$str {
        if dependency self.seen_dependencies.has_str then
            return
        fi
        dependency self.seen_dependencies.add_str
        dependency.to_str SemanticDependency::Symbol self.ordered_facts.push
    }

    fn merge_dependencies self:mut$TypeChecker dependencies:$std::List[SemanticDependency] {
        for dependency in dependencies.iter do
            if dependency SemanticDependency::Symbol(symbol) is then
                symbol.as_str self.add_symbol_dependency
            else
                dependency.clone self.ordered_facts.push
            fi
        done
    }

    fn into_semantic_dependencies self:TypeChecker -> std::List[SemanticDependency] {
        self match
            TypeChecker { ordered_facts: facts } => facts
        end
    }

    fn collect_pattern_dependency self:mut$TypeChecker value:$common::PatternValue {
        value match
            common::PatternValue::Struct(struct_pattern) => {
                struct_pattern.struct_name.as_str self.add_symbol_dependency
                for field in struct_pattern.bindings.iter do
                    field.second self.collect_pattern_dependency
                done
            }
            common::PatternValue::EnumVariant(variant) => {
                if variant.enum_name.is_empty ! then
                    variant.enum_name.as_str self.add_symbol_dependency
                fi
                for child in variant.bindings.iter do
                    child self.collect_pattern_dependency
                done
            }
            common::PatternValue::Alternatives(alternatives) => {
                for alternative in alternatives.iter do
                    alternative self.collect_pattern_dependency
                done
            }
            _ => {
            }
        end
    }

    fn add_default_method_dependency
        self:mut$TypeChecker
        method:$rules::MethodSemantics
        receiver:$common::Type
        argument_callables:$std::Map[std::String std::Set[std::String]]
    {
        method.trait_name.as_str self.add_symbol_dependency
        std::List[std::String]::new = implementations
        if
            method.trait_name.as_str self
                .store
                .traits
                .get_str std::Option::Some(casa_trait) is
        then
            casa_trait.clone = trait_definition
            self.store trait_definition receiver rules::collect_trait_implementation_dependencies
            = implementations
        fi
        for implementation in implementations.iter do
            implementation.as_str self.add_symbol_dependency
        done
        argument_callables.clone
        method.stack_effect.clone
        method.method_name.clone
        method.trait_name.clone
        SemanticDefaultMethodCall
        SemanticDependency::DefaultMethodCall self.ordered_facts.push
    }

    fn collect_default_method_return_callables
        self:mut$TypeChecker
        method:$rules::MethodSemantics
        argument_callables:$std::Map[std::String std::Set[std::String]]
    -> std::List[std::Set[std::String]] {
        false = returns_callable
        for
            return_type in method
                .stack_effect
                .return_types
                .iter
        do
            if return_type common::Type::Function is then
                true = returns_callable
                break
            fi
        done
        if returns_callable ! then
            std::List[std::Set[std::String]]::new return
        fi
        std::Option[std::String]::None = template_name
        if
            method.trait_name.as_str self
                .store
                .traits
                .get_str std::Option::Some(casa_trait) is
        then
            for trait_method in casa_trait.methods.iter do
                if trait_method.name.as_str method.method_name.as_str == then
                    trait_method.default_function.clone = template_name
                    break
                fi
            done
        fi
        if template_name std::Option::Some(name) is then
            false self.checks self.diagnostics self.store name.as_str ensure_checked_function drop
            argument_callables name.as_str self
                .collect_function_return_summary
                .callables
                .clone return
        fi
        std::List[std::Set[std::String]]::new
    }

    fn record_decision_dependencies self:mut$TypeChecker decision:$rules::SemanticFacts {
        for dependency in decision.dependencies.iter do
            dependency.as_str self.add_symbol_dependency
        done
    }

    fn rollback_operation_facts self:mut$TypeChecker facts_before:u64 {
        while facts_before self.ordered_facts.length < do
            self.ordered_facts.pop drop
        done
        std::Set[std::String]::new = self.seen_dependencies
        for fact in self.ordered_facts.iter do
            if fact SemanticDependency::Symbol(name) is then
                name.clone self.seen_dependencies.add
            fi
        done
    }

    fn collect_operation_facts self:mut$TypeChecker op:$common::Op {
        if op.type_hint std::Option::Some(type_hint) is then
            type_hint.clone SemanticDependency::Type self.ordered_facts.push
        fi
        if op.deferred_return_hint std::Option::Some(return_hint) is then
            return_hint.clone SemanticDependency::Type self.ordered_facts.push
        fi

        op.value match
            common::OpValue::FnCall(function_name) => {
                function_name.as_str self.add_symbol_dependency
            }
            common::OpValue::FnPush(function_name) => {
                function_name.as_str self.add_symbol_dependency
            }
            common::OpValue::StructNew(casa_struct) => {
                casa_struct.name.as_str self.add_symbol_dependency
            }
            common::OpValue::StructLiteral(literal) => {
                literal.struct_name.as_str self.add_symbol_dependency
            }
            common::OpValue::PushEnumVariant(variant) => {
                variant.enum_name.as_str self.add_symbol_dependency
            }
            common::OpValue::IsCheck(variant) => {
                variant.clone common::PatternValue::EnumVariant self.collect_pattern_dependency
            }
            common::OpValue::SizeOf(target_type) => {
                target_type.clone SemanticDependency::Type self.ordered_facts.push
            }
            common::OpValue::StructMemberProject(member) => {
                member.struct_name.as_str self.add_symbol_dependency
            }
            common::OpValue::StructMemberStore(member) => {
                member.struct_name.as_str self.add_symbol_dependency
            }
            common::OpValue::PtrRead(target_type) => {
                target_type.clone SemanticDependency::Type self.ordered_facts.push
            }
            common::OpValue::PtrWrite(target_type) => {
                target_type.clone SemanticDependency::Type self.ordered_facts.push
            }
            common::OpValue::PtrAsRef(target_type) => {
                target_type.clone SemanticDependency::Type self.ordered_facts.push
            }
            common::OpValue::PtrAsMut(target_type) => {
                target_type.clone SemanticDependency::Type self.ordered_facts.push
            }
            common::OpValue::PtrFromRaw(target_type) => {
                target_type.clone SemanticDependency::Type self.ordered_facts.push
            }
            common::OpValue::MatchArm(arm) => {
                arm.pattern_value self.collect_pattern_dependency
            }
            _ => {
            }
        end
    }

    pub fn check_copy_operation
        tc:mut$TypeChecker
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        tc
            .stack
            .values
            .length = depth
        0 = copied_index: u64
        if op.value common::OpValue::Over is then
            if 2 depth > then
                function_opt op tc.apply_fixed_semantics
                tc.stack_peek_type.clone std::Option::Some = op.type_hint
                return
            fi
            depth 2 - = copied_index
        else
            if 0 depth == then
                function_opt op tc.apply_fixed_semantics
                tc.stack_peek_type.clone std::Option::Some = op.type_hint
                return
            fi
            depth 1 - = copied_index
        fi
        copied_index tc
            .stack
            .values
            .get = copied_value
        copied_value.type_value.clone = copied_type
        if copied_type.is_borrow ! then
            if copied_value.capability ValueCapability::Shared is then
                common::SHARED_BORROW_TYPE copied_type.clone common::apply_borrow_type = copied_type
            elif copied_value.capability ValueCapability::Exclusive is then
                common::EXCLUSIVE_BORROW_TYPE copied_type.clone common::apply_borrow_type = copied_type
            fi
        fi
        copied_type.clone = copy_check_type
        if op.value common::OpValue::Copy is then
            if copy_check_type.borrow_target std::Option::Some(target) is then
                target.clone = copy_check_type
            fi
        fi
        copy_check_type resolve_numeric_literal_default = copy_check_type
        copy_check_type.clone std::Option::Some op common::Op::set_type_hint
        if function_opt copy_check_type tc.type_is_duplicable ! then
            op.location f"Type `{copied_type.format}` does not satisfy trait `Copy`" common::ErrorKind::TypeMismatch tc.diagnostics.record_error_string
        fi
        function_opt op tc.apply_fixed_semantics
    }

    fn check_size_of
        self:mut$TypeChecker
        op:mut$common::Op
        target_type:$common::Type
        function_opt:mut$std::Option[common::Function]
    {
        op.location function_opt target_type self.validate_type_exists
        if
            target_type.has_unresolved_type_var !
            self.store target_type common::type_inline_size.is_none &&
        then
            op.location f"Cannot determine inline size of `{target_type.format}`"
            common::ErrorKind::TypeMismatch self.diagnostics.record_error_string
        fi
        common::make_u64_type self.stack_push_type
    }

    fn run_type_check_op
        self:mut$TypeChecker
        current_op:mut$common::Op
        pending_ops:mut$std::List[common::Op]
        emitted_ops:mut$std::List[common::Op]
        function_opt:mut$std::Option[common::Function]
    {
        if
            current_op.value common::OpValue::Dup is
            current_op.value common::OpValue::Over is ||
            current_op.value common::OpValue::Copy is ||
        then
            function_opt current_op self.check_copy_operation
            return
        fi
        if
            current_op.value common::OpValue::Add is
            current_op.value common::OpValue::Sub is ||
            current_op.value common::OpValue::Mul is ||
            current_op.value common::OpValue::Div is ||
            current_op.value common::OpValue::Mod is ||
            current_op.value common::OpValue::Shl is ||
            current_op.value common::OpValue::Shr is ||
            current_op.value common::OpValue::BitAnd is ||
            current_op.value common::OpValue::BitOr is ||
            current_op.value common::OpValue::BitXor is ||
            current_op.value common::OpValue::BitNot is ||
        then
            current_op self.check_integer_operation
            return
        fi
        if current_op.value common::OpValue::Drop is then
            function_opt current_op self.check_stack_ops
            return
        fi
        if current_op.value rules::operation_uses_fixed_typecheck_effect then
            function_opt current_op self.apply_fixed_semantics
            return
        fi
        if current_op.value rules::operation_is_comparison then
            function_opt emitted_ops current_op self.check_comparison
            return
        fi
        if current_op.value rules::operation_is_memory then
            function_opt current_op self.check_memory
            return
        fi
        current_op.value match
            common::OpValue::Identifier(_) => {
                # Name resolution already reported this error.
                false = self.facts_available
            }
            common::OpValue::Rejected => false = self.facts_available
            common::OpValue::Question(_) => function_opt pending_ops current_op self.lower_question_operator
            common::OpValue::QuestionMove(_) => current_op self.consume_question_owner
            common::OpValue::NumericCall(_) => current_op self.check_numeric_call
            common::OpValue::AssignVar(_) => function_opt pending_ops current_op self.check_assignment
            common::OpValue::AssignYield(_) => function_opt pending_ops current_op self.check_assignment
            common::OpValue::AssignDec(_) => function_opt pending_ops current_op self.check_assignment
            common::OpValue::AssignInc(_) => function_opt pending_ops current_op self.check_assignment
            common::OpValue::BindTemporary(_) => function_opt current_op self.check_temporary_binding
            common::OpValue::PushVar(_) => function_opt current_op self.check_push_var
            common::OpValue::PushCapture(_) => function_opt current_op self.check_push_var
            common::OpValue::WhileBreak => current_op self.check_while_block
            common::OpValue::WhileContinue => current_op self.check_while_block
            common::OpValue::TraitMethodRef(_) => function_opt current_op self.check_trait_method_ref
            common::OpValue::FnCall(_) => function_opt emitted_ops current_op self.check_function_ops
            common::OpValue::FnExec => function_opt emitted_ops current_op self.check_function_ops
            common::OpValue::FnExecOwned => function_opt emitted_ops current_op self.check_function_ops
            common::OpValue::FnPush(_) => function_opt emitted_ops current_op self.check_function_ops
            common::OpValue::FnReturn => function_opt emitted_ops current_op self.check_function_ops
            common::OpValue::PushInt(_) => current_op self.check_literals
            common::OpValue::PushFloat(_) => current_op self.check_literals
            common::OpValue::Print => function_opt emitted_ops pending_ops current_op self.check_io
            common::OpValue::Panic => self.check_panic
            common::OpValue::Typeof => current_op self.check_typeof
            common::OpValue::SizeOf(target_type) => function_opt target_type current_op self.check_size_of
            common::OpValue::Syscall0 => function_opt current_op self.check_syscalls
            common::OpValue::Syscall1 => function_opt current_op self.check_syscalls
            common::OpValue::Syscall2 => function_opt current_op self.check_syscalls
            common::OpValue::Syscall3 => function_opt current_op self.check_syscalls
            common::OpValue::Syscall4 => function_opt current_op self.check_syscalls
            common::OpValue::Syscall5 => function_opt current_op self.check_syscalls
            common::OpValue::Syscall6 => function_opt current_op self.check_syscalls
            common::OpValue::PushEnumVariant(_) => function_opt current_op self.check_enum_variant
            common::OpValue::IsCheck(_) => function_opt emitted_ops current_op self.check_is
            common::OpValue::StructNew(_) => current_op self.check_struct_new
            common::OpValue::StructLiteral(_) => current_op self.check_struct_literal
            common::OpValue::MethodCall(_) => function_opt emitted_ops current_op self.check_method_call
            common::OpValue::QualifiedMethodCall(_) => function_opt emitted_ops current_op self.check_method_call
            common::OpValue::TraitMethodCall(_) => function_opt emitted_ops current_op self.check_trait_method_call
            common::OpValue::FstringToStr => function_opt emitted_ops current_op self.check_fstring_to_str
            _ => {
            }
        end
    }

    # Capture storage facts while the current lexical scope is still open.
    fn record_operation_binding_facts self:$TypeChecker operation:mut$common::Op {
        operation.value match
            common::OpValue::AssignInc(name) => name.clone
            common::OpValue::AssignDec(name) => name.clone
            common::OpValue::FnPush(name) => name.clone
            _ => return
        end = name
        if operation.value common::OpValue::FnPush(_) is then
            name.as_str operation self.record_capture_binding_facts
        else
            name.as_str operation self.record_named_binding
        fi
    }

    fn record_capture_binding_facts self:$TypeChecker operation:mut$common::Op function_name:$str {
        if function_name self.store.get_function std::Option::Some(function) is then
            for capture in function.captures.iter do
                capture.name.as_str operation self.record_named_binding
            done
        fi
    }

    fn record_named_binding self:$TypeChecker operation:mut$common::Op name:$str {
        if name self.scope.is_block_binding ! then
            return
        fi
        if name self.scope.resolve_binding_reference std::Option::Some(binding) is then
            binding common::BindingFact::Reference operation.add_binding_fact
        fi
    }

    fn begin_operation self:mut$TypeChecker operation:mut$common::Op -> u64 u64 {
        self
            .stack
            .values
            .length = self.operation_stack_depth
        std::List[common::ScalarInput]::new = self.scalar_inputs
        if operation.ownership std::Option::Some(effects) is then
            std::List[common::ScalarInput]::new = effects.scalar_inputs
        fi
        operation self.assign_op_id
        operation.id self.scope.begin_operation
        operation.location.clone = self.current_location
        ExpectationContext::None = self.current_expect_ctx
        false = self.underflow_reported_this_op
        operation self.record_operation_binding_facts
        self.diagnostics.error_count self.ordered_facts.length
    }

    fn finish_operation
        self:mut$TypeChecker
        operation:mut$common::Op
        errors_before:u64
        facts_before:u64
    -> bool {
        if self.scalar_inputs.is_empty ! then
            self.scalar_inputs.clone = operation.ensure_ownership.scalar_inputs
            std::List[common::ScalarInput]::new = self.scalar_inputs
        fi
        errors_before self.diagnostics.error_count == = succeeded
        operation.value common::OpValue::IfElse is
        operation.value common::OpValue::IfElif is || = restores_branch
        if succeeded ! restores_branch ! && then
            false = self.facts_available
        fi
        if succeeded self.facts_available && then
            operation self.record_source_reference
            operation self.collect_operation_facts
            operation.id self
                .checks
                .verified_operations
                .add
        else
            facts_before self.rollback_operation_facts
        fi
        succeeded
    }

    fn check_work_operation
        self:mut$TypeChecker
        operation:common::Op
        source_work:std::Option[SourceWork]
        pending_ops:mut$std::List[common::Op]
        emitted:mut$body_builder::Builder
        function_opt:mut$std::Option[common::Function]
    -> std::Option[body_builder::Builder] {
        std::Option[body_builder::Builder]::None = compound
        operation pending_ops.push
        while pending_ops.is_empty ! do
            pending_ops.pop = current_op
            current_op self.begin_operation = facts_before = errors_before
            std::Option[std::String]::None = question_name
            if current_op.value common::OpValue::Question(name) is then
                name.clone std::Option::Some = question_name
            fi
            std::List[common::Op]::new = emitted_ops
            source_work match
                std::Option::Some(work) => {
                    work match
                        SourceWork::Array(body) => {
                            body_builder::Builder::new = items
                            function_opt items pending_ops body self.check_source_sequence
                            items.has_numeric_literal items.length current_op self.finish_array_literal
                            items std::Option::Some = compound
                        }
                        SourceWork::Group(body) => {
                            body_builder::Builder::new = items
                            function_opt items pending_ops body self.check_source_sequence
                            items std::Option::Some = compound
                        }
                        SourceWork::Arm(body) => {
                            if body.get_nodes.is_empty then
                                std::Option[source_body::SourceBody]::None
                            else
                                body std::Option::Some
                            fi current_op function_opt self.typecheck_match_op = errors_before
                            if self.checked_guards.is_empty ! then
                                self.checked_guards.pop std::Option::Some = compound
                            fi
                        }
                    end
                }
                std::Option::None => function_opt emitted_ops pending_ops current_op self.run_type_check_op
            end
            std::Option[SourceWork]::None = source_work
            facts_before errors_before current_op self.finish_operation = succeeded
            emitted_ops emitted.append_operations
            current_op.location.clone = origin
            current_op emitted.push_operation
            if succeeded then
                if question_name std::Option::Some(name) is then
                    function_opt emitted name.as_str origin self.check_question_tail
                fi
            fi
        done
        compound
    }

    fn check_source_boundary
        self:mut$TypeChecker
        origin:common::Location
        value:common::OpValue
        function:mut$std::Option[common::Function]
    -> common::Op {
        origin value common::Op::from_source = operation
        operation self.begin_operation = facts_before = errors_before
        operation.value match
            common::OpValue::IfStart => operation self.check_if_block
            common::OpValue::IfCondition => operation self.check_if_block
            common::OpValue::IfElif => operation self.check_if_block
            common::OpValue::IfElse => operation self.check_if_block
            common::OpValue::IfEnd => operation self.check_if_block
            common::OpValue::WhileStart => operation self.check_while_block
            common::OpValue::WhileCondition => operation self.check_while_block
            common::OpValue::WhileEnd => operation self.check_while_block
            common::OpValue::MatchStart => function operation self.begin_match
            common::OpValue::MatchEnd => operation self.finish_match
            common::OpValue::UnsafeStart => 1 += self.unsafe_depth
            common::OpValue::UnsafeEnd => {
                if 0 self.unsafe_depth != then
                    1 -= self.unsafe_depth
                fi
            }
            _ => "Expected a structured source boundary" panic
        end
        facts_before errors_before operation self.finish_operation drop
        operation
    }

    fn check_source_branch
        self:mut$TypeChecker
        branch:source_body::SourceBranch
        pending:mut$std::List[common::Op]
        function:mut$std::Option[common::Function]
        first:bool
    -> body_builder::Branch {
        branch match
            source_body::SourceBranch { origin: origin condition_origin: test condition: condition consequent: consequent } => {
                if first then common::OpValue::IfStart else common::OpValue::IfElif fi = boundary
                function boundary origin self.check_source_boundary = entry
                body_builder::Builder::new = checked_condition
                function checked_condition pending condition self.check_source_sequence
                function common::OpValue::IfCondition test self.check_source_boundary = checked_test
                body_builder::Builder::new = checked_consequent
                function checked_consequent pending consequent self.check_source_sequence
                body_builder::Branch {
                    entry: entry condition: checked_condition test: checked_test consequent: checked_consequent
                }
            }
        end
    }

    fn check_source_conditional
        self:mut$TypeChecker
        conditional:source_body::SourceConditional
        pending:mut$std::List[common::Op]
        emitted:mut$body_builder::Builder
        function:mut$std::Option[common::Function]
    {
        conditional match
            source_body::SourceConditional { branches: branches alternative: alternative end_origin: end_origin } => {
                std::List[body_builder::Branch]::new = checked_branches
                true = first
                branches.reverse
                while branches.is_empty ! do
                    first function pending branches.pop self.check_source_branch checked_branches.push
                    false = first
                done
                std::Option[body_builder::Alternative]::None = checked_alternative
                if alternative std::Option::Some(branch) is then
                    branch match
                        source_body::SourceAlternative {
                            origin: origin body: body
                        } => {
                            function common::OpValue::IfElse origin self.check_source_boundary = entry
                            body_builder::Builder::new = checked_body
                            function checked_body pending body self.check_source_sequence
                            checked_body entry body_builder::Alternative std::Option::Some = checked_alternative
                        }
                    end
                fi
                function common::OpValue::IfEnd end_origin self.check_source_boundary = exit
                exit checked_alternative checked_branches body_builder::Part::Conditional emitted.push
            }
        end
    }

    fn check_source_arm
        self:mut$TypeChecker
        arm:source_body::SourceArm
        pending:mut$std::List[common::Op]
        function:mut$std::Option[common::Function]
    -> body_builder::Arm {
        arm match
            source_body::SourceArm { origin: origin pattern: pattern guard: guard guard_end: guard_end body: body } => {
                guard SourceWork::Arm std::Option::Some = source_work
                origin guard_end std::List[common::Op]::new pattern common::MatchArm common::OpValue::MatchArm common::Op::from_source = operation
                body_builder::Builder::new = work
                function work pending source_work operation self.check_work_operation = checked_guard
                body_builder::Builder::new checked_guard.unwrap_or = guard_work
                work.pop_operation = entry
                body_builder::Builder::new = checked_body
                function checked_body pending body self.check_source_sequence
                checked_body guard_work entry body_builder::Arm
            }
        end
    }

    fn check_source_match
        self:mut$TypeChecker
        match_body:source_body::SourceMatch
        pending:mut$std::List[common::Op]
        emitted:mut$body_builder::Builder
        function:mut$std::Option[common::Function]
    {
        match_body match
            source_body::SourceMatch { origin: origin arms: arms end_origin: end_origin } => {
                function common::OpValue::MatchStart origin self.check_source_boundary = entry
                std::List[body_builder::Arm]::new = checked_arms
                arms.reverse
                while arms.is_empty ! do
                    function pending arms.pop self.check_source_arm checked_arms.push
                done
                function common::OpValue::MatchEnd end_origin self.check_source_boundary = exit
                exit checked_arms entry body_builder::Part::Match emitted.push
            }
        end
    }

    # An f-string expression starts from an empty stack and leaves one value.
    # It shares bindings declared outside it, and its own bindings end with it.
    fn check_format_expr
        self:mut$TypeChecker
        expression:source_body::SourceRegion
        pending:mut$std::List[common::Op]
        emitted:mut$body_builder::Builder
        function:mut$std::Option[common::Function]
    {
        expression match
            source_body::SourceRegion { origin: origin body: body end_origin: end_origin } => {
                if false body.find_format_exit std::Option::Some(exit) is then
                    exit.term match
                        source_body::SourceTerm::Control(kind) => kind.format_source
                        _ => "?"
                    end = keyword
                    exit.origin f"`{keyword}` cannot leave an f-string expression"
                    common::ErrorKind::InvalidScope self.diagnostics.record_error_string
                    false = self.facts_available
                    common::make_string_type self.stack_push_type
                    return
                fi
                self.stack.snapshot self.format_enclosing_stacks.push
                TypedStack::new = self.stack
                self.param_cap.clone = enclosing_param_cap
                self.parameters.length std::Option::Some = self.param_cap
                self.format_scope_depth copy = enclosing_scope_depth
                self.scope.enter
                self
                    .scope
                    .frames
                    .length = self.format_scope_depth
                function emitted pending body self.check_source_sequence
                if self.path_continues then
                    self
                        .stack
                        .values
                        .length = value_count
                    if 1 value_count != then
                        end_origin f"F-string expression must leave one value, got {value_count}"
                        common::ErrorKind::StackMismatch self.diagnostics.record_error_string
                    fi
                    TypedStack::new self.materialize_branch_results
                fi
                end_origin.clone = self.current_location
                end_origin.clone common::OpValue::OwnerCleanup common::Op::new = cleanup
                cleanup self.assign_op_id
                cleanup self.attach_scope_cleanups
                0 end_origin.span.offset self.close_source_bindings
                self.scope.exit
                cleanup emitted.push_operation
                if
                    self
                        .stack
                        .values
                        .is_empty
                then
                    common::make_string_type self.stack_push_type
                fi
                self
                    .stack
                    .values
                    .pop = value
                self.format_enclosing_stacks.pop = self.stack
                value self
                    .stack
                    .values
                    .push
                enclosing_param_cap = self.param_cap
                enclosing_scope_depth = self.format_scope_depth
            }
        end
    }

    fn check_source_node
        self:mut$TypeChecker
        node:source_body::SourceNode
        pending:mut$std::List[common::Op]
        emitted:mut$body_builder::Builder
        function:mut$std::Option[common::Function]
    {
        node match
            source_body::SourceNode::Rejected(rejection) => {
                rejection match
                    source_body::SourceRejection {
                        origin: origin message: message
                    } => {
                        origin message common::ErrorKind::UnmatchedBlock self.diagnostics.record_error_string
                        origin.clone common::OpValue::Rejected common::Op::from_source = operation
                        function emitted pending std::Option[SourceWork]::None operation self.check_work_operation drop
                    }
                end
            }
            source_body::SourceNode::Leaf(leaf) => {
                function emitted pending std::Option[SourceWork]::None leaf.into_operation self.check_work_operation drop
            }
            source_body::SourceNode::Conditional(conditional) => function emitted pending conditional self.check_source_conditional
            source_body::SourceNode::Loop(loop) => {
                loop match
                    source_body::SourceLoop {
                        origin: origin condition_origin: condition_origin condition: condition body: body end_origin: end_origin
                    } => {
                        function common::OpValue::WhileStart origin self.check_source_boundary = entry
                        body_builder::Builder::new = checked_condition
                        function checked_condition pending condition self.check_source_sequence
                        function common::OpValue::WhileCondition condition_origin self.check_source_boundary = test
                        body_builder::Builder::new = checked_body
                        function checked_body pending body self.check_source_sequence
                        function common::OpValue::WhileEnd end_origin self.check_source_boundary = exit
                        exit checked_body test checked_condition entry body_builder::Part::Loop emitted.push
                    }
                end
            }
            source_body::SourceNode::Match(match_body) => function emitted pending match_body self.check_source_match
            source_body::SourceNode::FormatExpr(region) => function emitted pending region self.check_format_expr
            source_body::SourceNode::Unsafe(region) => {
                region match
                    source_body::SourceRegion {
                        origin: origin body: body end_origin: end_origin
                    } => {
                        function common::OpValue::UnsafeStart origin self.check_source_boundary = entry
                        body_builder::Builder::new = checked_body
                        function checked_body pending body self.check_source_sequence
                        function common::OpValue::UnsafeEnd end_origin self.check_source_boundary = exit
                        exit checked_body entry body_builder::Part::Region emitted.push
                    }
                end
            }
            source_body::SourceNode::Array(compound) => {
                compound match
                    source_body::SourceCompound {
                        origin: origin body: body
                    } => {
                        origin std::List[common::Op]::new common::OpValue::PushArray common::Op::from_source = operation
                        body_builder::Builder::new = work
                        function work pending body SourceWork::Array std::Option::Some operation self.check_work_operation.unwrap = items
                        items work.pop_operation body_builder::Part::Array emitted.push
                    }
                end
            }
            source_body::SourceNode::Group(compound) => {
                compound match
                    source_body::SourceCompound {
                        origin: origin body: body
                    } => {
                        origin std::List[common::Op]::new common::OpValue::ExprGroup common::Op::from_source = operation
                        body_builder::Builder::new = work
                        function work pending body SourceWork::Group std::Option::Some operation self.check_work_operation.unwrap = items
                        items work.pop_operation body_builder::Part::Group emitted.push
                    }
                end
            }
        end
    }

    fn check_source_sequence
        self:mut$TypeChecker
        body:source_body::SourceBody
        pending_ops:mut$std::List[common::Op]
        emitted_ops:mut$body_builder::Builder
        function_opt:mut$std::Option[common::Function]
    {
        body.into_nodes = nodes
        nodes.reverse
        while nodes.is_empty ! do
            if self.path_continues then
                function_opt emitted_ops pending_ops nodes.pop self.check_source_node
            else
                body_builder::Builder::new = unreachable
                function_opt unreachable pending_ops nodes.pop self.check_source_node
                if unreachable.is_empty ! then
                    unreachable body_builder::Part::Unreachable emitted_ops.push
                fi
            fi
        done
    }
}

impl TypeChecker {
    pub fn resolve_declared_return_borrow_capabilities
        self:mut$TypeChecker
        function:mut$common::Function
    {
        0 = index: u64
        while
            index self
                .stack
                .values
                .length <
            index function
                .stack_effect
                .return_types
                .length < &&
        do
            index function
                .stack_effect
                .return_types
                .get = declared
            index self
                .stack
                .values
                .get_mut = value
            declared value self.ownership.materialize_declared_return_borrow
            1 += index
        done
    }

    pub fn resolve_declared_return_literals checker:mut$TypeChecker function:mut$common::Function {
        function.stack_effect.return_types = declared_returns: $std::List[common::Type]
        if
            declared_returns.length checker
                .stack
                .values
                .length !=
        then
            return
        fi
        0 = return_index: u64
        while return_index declared_returns.length < do
            return_index checker
                .stack
                .values
                .get
                .clone = return_value
            if 0 return_value.literals.length != then
                return_index declared_returns.get.clone = declared_return
                checker.literal_resolutions checker.diagnostics declared_return return_value.resolve_literals drop
                false = return_value.is_literal_constant
                std::List[LiteralRef]::new = return_value.literals
                declared_return = return_value.type_value
                return_value return_index checker
                    .stack
                    .values
                    .set
            fi
            1 += return_index
        done
    }
}

pub fn checked_generic_body_type_matches inferred:$common::Type declared:$common::Type -> bool {
    if inferred common::Type::Generic(inferred_generic) is then
        if declared common::Type::Generic(declared_generic) is then
            if
                inferred_generic.base declared_generic.base ==
                0 inferred_generic.params.length == &&
