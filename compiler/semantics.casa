    pub fn stack_push_binding
        tc:mut$TypeChecker
        type_value:$common::Type
        name:$str
        op:mut$common::Op
        function_opt:mut$std::Option[common::Function]
    {
        type_value.clone std::Option::Some = op.type_hint
        std::Option[std::String]::None = binding
        std::Option[i64]::None = source
        type_value.clone = stack_type
        type_value type_capability = capability
        type_value.borrow_target = target_opt
        target_opt match
            std::Option::Some(target) => {
                if function_opt target tc.type_is_duplicable then
                    if target.has_unresolved_type_var tc.store target common::type_has_scalar_storage || ! then
                        target = stack_type
                    fi
                fi
            }
            std::Option::None => {
            }
        end
        if type_value.is_borrow ! then
            if function_opt type_value tc.type_is_duplicable ! then
                # A reported use pushes an unbound value so the consuming
                # operation does not report the same use again.
                if name.as_str tc.ownership.owner_is_moved then
                    name.as_str op.location tc.diagnostics tc.ownership.report_moved_owner
                else
                    name.to_str std::Option::Some = binding
                    op.id std::Option::Some = source
                fi
            elif type_value tc.uses_copy_storage then
                op.id std::Option::Some = source
            fi
        fi
        name Place::new std::Option::Some = place
        std::Option[std::List[Origin]]::None = origins
        std::Option[std::List[Origin]]::None = cleanup_origins
        std::Map[Origin std::Option[LoanSpan]]::new = loan_spans
        name tc.does_binding_own_callable_captures = owns_callable_captures
        if name tc.ownership.find_binding_loans std::Option::Some(loans) is then
            loans.origins.clone = origins
            loans.cleanup_origins.clone = cleanup_origins
            if type_value common::Type::Function(_) is cleanup_origins.is_some && then
                true = owns_callable_captures
            fi
            tc.current_location loans.collect_spans = loan_spans
            if loans.origins std::Option::Some(stored) is then
                if
                    stored do_origins_have_runtime_dependency
                    loans.capability ValueCapability::Owned is ! &&
                    tc.store type_value type_has_borrow !
                    type_value common::Type::Function(_) is owns_callable_captures && ! && &&
                then
                    stored resolve_loan_capability = capability
                    std::Option[std::String]::None = binding
                    std::Option[i64]::None = source
                fi
            fi
        fi
        std::Set[std::String]::new
        false loan_spans cleanup_origins origins source binding capability place
        std::List[LiteralRef]::new tc.current_location.clone stack_type
        std::Option[u64]::None TypedValue
        tc
            .stack
            .values
            .push
    }

