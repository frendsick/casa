import "std"
import "common"

# ============================================================================
# BlockScope — lexical bindings owned by one type checker
# ============================================================================

struct BlockScope {
    frames:            List[Map[String Type]]
    function_bindings: Map[String Type]
    expired:           Set[String]
}

impl BlockScope {
    fn new -> BlockScope {
        Set[String]::new
        Map[String Type]::new
        List[Map[String Type]]::new
        BlockScope
    }

    fn snapshot self:mut$BlockScope -> BlockScope {
        BlockScope::new = snapshot
        for pair in self.function_bindings.iter do
            pair.second clone_type pair.first.clone snapshot.function_bindings.set
        done
        for frame in self.frames.iter do
            Map[String Type]::new = frame_snapshot
            for pair in frame.iter do
                pair.second clone_type pair.first.clone frame_snapshot.set
            done
            frame_snapshot snapshot.frames.push
        done
        for name in self.expired.iter do
            name.clone snapshot.expired.add
        done
        snapshot
    }

    fn enter self:mut$BlockScope { Map[String Type]::new self.frames.push }

    fn exit self:mut$BlockScope {
        if 0 self.frames.length == then
            return
        fi
        self.frames.pop = frame
        for name in frame.keys.iter do
            name.clone self.expired.add
        done
    }

    fn lookup self:mut$BlockScope name:$str -> Option[Type] {
        self.frames.length = frame_index
        while 0 frame_index != do
            1 -= frame_index
            frame_index self.frames.get = frame
            if name frame.get_str Option::Some(binding_type) is then
                binding_type clone_type Option::Some return
            fi
        done
        if name self.function_bindings.get_str Option::Some(binding_type) is then
            binding_type clone_type Option::Some return
        fi
        Option[Type]::None
    }

    fn is_block_binding self:mut$BlockScope name:$str -> bool {
        self.frames.length = frame_index
        while 0 frame_index != do
            1 -= frame_index
            if
                name frame_index self
                    .frames
                    .get
                    .has_str
            then
                true return
            fi
        done
        false
    }

    fn current_names self:mut$BlockScope -> List[String] {
        if 0 self.frames.length == then
            List[String]::new return
        fi
        self.frames.length 1 - self
            .frames
            .get
            .keys
    }

    fn names_from self:mut$BlockScope depth:u64 -> List[String] {
        List[String]::new = names
        if 0 depth == then
            return
        fi
        depth 1 - = frame_index
        while frame_index self.frames.length > do
            for
                name in frame_index self
                    .frames
                    .get
                    .keys
                    .iter
            do
                name.clone names.push
            done
            1 += frame_index
        done
        names
    }

    fn set_type self:mut$BlockScope name:$str binding_type:$Type -> bool {
        self.frames.length = frame_index
        while 0 frame_index != do
            1 -= frame_index
            frame_index self.frames.get_mut = frame
            if name frame.has_str then
                binding_type clone_type name.clone frame.set_str
                true return
            fi
        done
        if name self.function_bindings.has_str then
            binding_type clone_type name.clone self.function_bindings.set_str
            true return
        fi
        false
    }

    # Explicit assignment mutates an accessible binding. Otherwise it declares
    # in the active block, or at function level when outside a block.
    fn assign self:mut$BlockScope name:$str is_global:bool {
        if name self.lookup.is_some is_global || then
            return
        fi
        if 0 self.frames.length == then
            Type::Unknown name.clone self.function_bindings.set_str
        else
            self.frames.length 1 - = frame_index
            frame_index self.frames.get_mut = frame
            Type::Unknown name.clone frame.set_str
        fi
        if name self.expired.has_str then
            name self.expired.remove_str
        fi
    }

    # Implicit bindings are local to the current branch and may not shadow an
    # accessible non-global binding. Returns false for a shadowing attempt.
    fn bind self:mut$BlockScope name:$str -> bool {
        if name self.lookup.is_some then
            false return
        fi
        if 0 self.frames.length == then
            false return
        fi
        self.frames.length 1 - = frame_index
        frame_index self.frames.get_mut = frame
        Type::Unknown name.clone frame.set_str
        if name self.expired.has_str then
            name self.expired.remove_str
        fi
        true
    }

    fn is_expired self:mut$BlockScope name:$str -> bool {
        name self.expired.has_str name self.lookup.is_none &&
    }
}
