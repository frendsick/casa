import "std" as std
import "common" as common

# ============================================================================
# BlockScope — lexical bindings owned by one type checker
# ============================================================================

pub struct ScopedBinding derives std::Clone {
    pub typ:             common::Type
    pub storage_name:    std::String
    pub source_identity: std::Option[u64]
}

pub struct BlockScope {
    pub frames:            std::List[std::Map[std::String ScopedBinding]]
    pub function_bindings: std::Map[std::String ScopedBinding]
    pub expired:           std::Set[std::String]
    current_identity:      i64
}

impl BlockScope {
    pub fn new -> BlockScope {
        0
        std::Set[std::String]::new
        std::Map[std::String ScopedBinding]::new
        std::List[std::Map[std::String ScopedBinding]]::new
        BlockScope
    }

    pub fn snapshot self:mut$BlockScope -> BlockScope {
        BlockScope::new = snapshot
        self.current_identity = snapshot.current_identity
        for pair in self.function_bindings.iter do
            pair.second.clone pair.first.clone snapshot.function_bindings.set
        done
        for frame in self.frames.iter do
            std::Map[std::String ScopedBinding]::new = frame_snapshot
            for pair in frame.iter do
                pair.second.clone pair.first.clone frame_snapshot.set
            done
            frame_snapshot snapshot.frames.push
        done
        for name in self.expired.iter do
            name.clone snapshot.expired.add
        done
        snapshot
    }

    pub fn enter self:mut$BlockScope { std::Map[std::String ScopedBinding]::new self.frames.push }

    pub fn exit self:mut$BlockScope {
        if 0 self.frames.length == then
            return
        fi
        self.frames.pop = frame
        for name in frame.keys.iter do
            name.clone self.expired.add
        done
    }

    pub fn lookup self:$BlockScope name:$str -> std::Option[common::Type] {
        self.frames.length = frame_index
        while 0 frame_index != do
            1 -= frame_index
            frame_index self.frames.get = frame
            if name frame.get_str std::Option::Some(binding_type) is then
                binding_type.typ.clone std::Option::Some return
            fi
        done
        if name self.function_bindings.get_str std::Option::Some(binding_type) is then
            binding_type.typ.clone std::Option::Some return
        fi
        std::Option[common::Type]::None
    }

    pub fn is_block_binding self:$BlockScope name:$str -> bool {
        self.frames.length = frame_index
        while 0 frame_index != do
            1 -= frame_index
            if
                name frame_index self
                    .frames
                    .get
                    .has_str
            then
                true return
            fi
        done
        false
    }

    pub fn current_names self:mut$BlockScope -> std::List[std::String] {
        if 0 self.frames.length == then
            std::List[std::String]::new return
        fi
        self.frames.length 1 - self
            .frames
            .get
            .keys
    }

    pub fn names_from self:mut$BlockScope depth:u64 -> std::List[std::String] {
        std::List[std::String]::new = names
        if 0 depth == then
            names return
        fi
        depth 1 - = frame_index
        while frame_index self.frames.length > do
            for
                name in frame_index self
                    .frames
                    .get
                    .keys
                    .iter
            do
                name.clone names.push
            done
            1 += frame_index
        done
        names
    }

    pub fn set_type self:mut$BlockScope name:$str binding_type:$common::Type -> bool {
        self.frames.length = frame_index
        while 0 frame_index != do
            1 -= frame_index
            frame_index self.frames.get_mut = frame
            if name frame.has_str then
                name frame.get_mut_str.unwrap = binding
                binding_type.clone = binding.typ
                true return
            fi
        done
        if name self.function_bindings.has_str then
            name self
                .function_bindings
                .get_mut_str
                .unwrap = binding
            binding_type.clone = binding.typ
            true return
        fi
        false
    }

    # Explicit assignment mutates an accessible binding. Otherwise it declares
    # in the active block, or at function level when outside a block.
    pub fn assign self:mut$BlockScope name:$str is_global:bool {
        if name self.lookup.is_some is_global || then
            return
        fi
        if 0 self.frames.length == then
            std::Option[u64]::None name.to_str common::Type::Unknown ScopedBinding
            name.clone self.function_bindings.set_str
        else
            self.frames.length 1 - = frame_index
            frame_index self.frames.get_mut = frame
            std::Option[u64]::None f"$binding_{self.current_identity}_{name}" common::Type::Unknown ScopedBinding name.clone frame.set_str
        fi
        if name self.expired.has_str then
            name self.expired.remove_str
        fi
    }

    # Implicit bindings are local to the current branch and may not shadow an
    # accessible non-global binding. Returns false for a shadowing attempt.
    pub fn bind self:mut$BlockScope name:$str -> bool {
        if name self.lookup.is_some then
            false return
        fi
        if 0 self.frames.length == then
            false return
        fi
        self.frames.length 1 - = frame_index
        frame_index self.frames.get_mut = frame
        std::Option[u64]::None f"$binding_{self.current_identity}_{name}" common::Type::Unknown ScopedBinding name.clone frame.set_str
        if name self.expired.has_str then
            name self.expired.remove_str
        fi
        true
    }

    pub fn begin_operation self:mut$BlockScope identity:i64 { identity = self.current_identity }

    pub fn find_scope_binding self:$BlockScope name:$str -> std::Option[$ScopedBinding] {
        self.frames.length = frame_index
        while 0 frame_index != do
            1 -= frame_index
            frame_index self.frames.get = frame
            if name frame.get_str std::Option::Some(binding) is then
                binding std::Option::Some return
            fi
        done
        name self.function_bindings.get_str
    }

    pub fn set_source_identity self:mut$BlockScope name:$str identity:u64 {
        self.frames.length = frame_index
        while 0 frame_index != do
            1 -= frame_index
            frame_index self.frames.get_mut = frame
            if name frame.get_mut_str std::Option::Some(binding) is then
                identity std::Option::Some = binding.source_identity
                return
            fi
        done
        if name self.function_bindings.get_mut_str std::Option::Some(binding) is then
            identity std::Option::Some = binding.source_identity
        fi
    }

    pub fn has_binding self:$BlockScope name:$str -> bool { name self.find_scope_binding.is_some }

    pub fn find_binding self:$BlockScope name:$str -> std::Option[common::CheckedBinding] {
        if name self.find_scope_binding std::Option::Some(binding) is then
            binding.typ.clone binding.storage_name.clone name.to_str
            common::CheckedBinding std::Option::Some return
        fi
        std::Option[common::CheckedBinding]::None
    }

    pub fn resolve_binding_reference
        self:$BlockScope
        name:$str
    -> std::Option[common::BindingReference] {
        if name self.find_scope_binding std::Option::Some(binding) is then
            binding.storage_name.clone name.to_str
            common::BindingReference std::Option::Some return
        fi
        std::Option[common::BindingReference]::None
    }

    pub fn is_expired self:mut$BlockScope name:$str -> bool {
        name self.expired.has_str name self.lookup.is_none &&
    }
}
