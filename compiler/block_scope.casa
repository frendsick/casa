import "std"
import "common"

# ============================================================================
# BlockScope — lexical bindings owned by one type checker
# ============================================================================

struct BlockScope {
    frames:            List[Map[str Type]]
    function_bindings: Map[str Type]
    expired:           Set[str]
}

impl BlockScope {
    fn new -> BlockScope {
        Set::new(Set[str])
        Map::new(Map[str Type])
        List::new(List[Map[str Type]])
        BlockScope
    }

    fn snapshot self:BlockScope -> BlockScope {
        BlockScope::new = snapshot
        for pair in self.function_bindings.iter do
            pair.second pair.first snapshot.function_bindings.set = snapshot.function_bindings
        done
        for frame in self.frames.iter do
            Map::new(Map[str Type]) = frame_snapshot
            for pair in frame.iter do
                pair.second pair.first frame_snapshot.set = frame_snapshot
            done
            frame_snapshot snapshot.frames.push
        done
        for name in self.expired.to_list.iter do
            name snapshot.expired.add = snapshot.expired
        done
        snapshot
    }

    fn enter self:BlockScope {
        Map::new(Map[str Type]) self.frames.push
    }

    fn exit self:BlockScope {
        if 0 self.frames.length == then return fi
        self.frames.pop = frame
        for name in frame.keys.iter do
            name self.expired.add = self.expired
        done
    }

    fn lookup self:BlockScope name:str -> Option[Type] {
        self.frames.length 1 - = frame_index
        while 0 frame_index >= do
            frame_index self.frames.get = frame
            if name frame.get Option::Some(binding_type) is then
                binding_type Option::Some return
            fi
            1 -= frame_index
        done
        name self.function_bindings.get
    }

    fn is_block_binding self:BlockScope name:str -> bool {
        self.frames.length 1 - = frame_index
        while 0 frame_index >= do
            if name frame_index self.frames.get.has then true return fi
            1 -= frame_index
        done
        false
    }

    fn set_type self:BlockScope name:str binding_type:Type -> bool {
        self.frames.length 1 - = frame_index
        while 0 frame_index >= do
            frame_index self.frames.get = frame
            if name frame.has then
                binding_type name frame.set = frame
                frame frame_index self.frames.set
                true return
            fi
            1 -= frame_index
        done
        if name self.function_bindings.has then
            binding_type name self.function_bindings.set = self.function_bindings
            true return
        fi
        false
    }

    # Explicit assignment mutates an accessible binding. Otherwise it declares
    # in the active block, or at function level when outside a block.
    fn assign self:BlockScope name:str is_global:bool {
        if name self.lookup.is_some is_global || then return fi
        if 0 self.frames.length == then
            Type::Unknown name self.function_bindings.set = self.function_bindings
        else
            self.frames.length 1 - = frame_index
            frame_index self.frames.get = frame
            Type::Unknown name frame.set = frame
            frame frame_index self.frames.set
        fi
        if name self.expired.has then
            name self.expired.remove = self.expired
        fi
    }

    # Implicit bindings are local to the current branch and may not shadow an
    # accessible non-global binding. Returns false for a shadowing attempt.
    fn bind self:BlockScope name:str -> bool {
        if name self.lookup.is_some then false return fi
        if 0 self.frames.length == then false return fi
        self.frames.length 1 - = frame_index
        frame_index self.frames.get = frame
        Type::Unknown name frame.set = frame
        frame frame_index self.frames.set
        if name self.expired.has then
            name self.expired.remove = self.expired
        fi
        true
    }

    fn is_expired self:BlockScope name:str -> bool {
        name self.expired.has name self.lookup.is_none &&
    }
}
