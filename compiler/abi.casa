# x86-64 System V classification for verified extern types.
import "std" as std
import "common" as common
import "error" as error
import "typechecker" as typechecker

pub fn classify_extern_scalar typ:$common::Type -> std::Option[common::BuiltinType] {
    if typ common::type_is_extern_scalar then
        if typ common::Type::Builtin(builtin) is then
            builtin copy std::Option::Some return
        fi
    fi
    std::Option[common::BuiltinType]::None
}

fn merge_class
    abi_class:common::ExternAbiClass
    offset:u64
    classes:mut$std::List[std::Option[common::ExternAbiClass]]
{
    offset common::WORD_SIZE / = index
    if classes.length index <= then
        return
    fi
    if index classes.get std::Option::Some(existing) is then
        if
            existing common::ExternAbiClass::Integer ==
            abi_class common::ExternAbiClass::Integer == ||
        then
            common::ExternAbiClass::Integer std::Option::Some index classes.set
        fi
    else
        abi_class std::Option::Some index classes.set
    fi
}

fn classify_fields
    typ:$common::Type
    store:$common::SymbolStore
    layouts:mut$common::LayoutPlanner
    base_offset:u64
    classes:mut$std::List[std::Option[common::ExternAbiClass]]
-> bool {
    if typ common::Type::Builtin(builtin) is then
        if typ classify_extern_scalar.is_none then
            false return
        fi
        if builtin.is_float then
            classes base_offset common::ExternAbiClass::Sse merge_class
        else
            classes base_offset common::ExternAbiClass::Integer merge_class
        fi
        true return
    fi
    if typ common::Type::Generic(generic) is then
        if common::ARRAY_TYPE generic.base.as_str == then
            if typ common::get_concrete_array_length std::Option::Some(length) is then
                0 generic.params.get = element_type
                if element_type layouts.inline_size std::Option::Some(element_size) is then
                    for index in length 0 std::Range::new do
                        classes index element_size * base_offset + layouts store element_type classify_fields !
                        if then
                            false return
                        fi
                    done
                    true return
                fi
            fi
            false return
        fi
        if generic.base store.structs.get std::Option::Some(casa_struct) is then
            if casa_struct.is_extern ! then
                false return
            fi
            for member_index in casa_struct.members.length 0 std::Range::new do
                if
                    member_index casa_struct layouts.plan_struct_member
                    std::Option::Some(plan) is
                then
                    member_index casa_struct.members.get = member
                    classes plan.offset base_offset + layouts store member.typ classify_fields !
                    if then
                        false return
                    fi
                else
                    false return
                fi
            done
            true return
        fi
    fi
    false
}

pub fn classify_extern_type
    typ:$common::Type
    store:$common::SymbolStore
    layouts:mut$common::LayoutPlanner
-> std::Option[common::ExternAbiType] {
    if typ.borrow_target std::Option::Some(target) is then
        if
            typ.is_shared_borrow target common::Type::Builtin(common::BuiltinType::Cstr) is &&
            target classify_extern_scalar.is_some ||
            store target common::type_is_extern_struct ||
        then
            common::BuiltinType::Ptr common::builtin_type_layout = layout
            layout.size common::BuiltinType::Ptr common::ExternAbiPassing::Scalar
            common::ExternAbiType::new std::Option::Some return
        fi
        std::Option[common::ExternAbiType]::None return
    fi
    if typ classify_extern_scalar std::Option::Some(builtin) is then
        builtin common::builtin_type_layout = layout
        layout.size builtin copy common::ExternAbiPassing::Scalar common::ExternAbiType::new
        std::Option::Some return
    fi
    if store typ common::type_is_extern_struct ! then
        std::Option[common::ExternAbiType]::None return
    fi
    if typ layouts.inline_size std::Option::Some(size) is then
        if 16 size < then
            size common::ExternAbiPassing::Memory common::ExternAbiType::new
            std::Option::Some return
        fi
        std::List[std::Option[common::ExternAbiClass]]::new = pending_classes
        size common::WORD_SIZE u64::try_from.unwrap 1 - +
        common::WORD_SIZE u64::try_from.unwrap / = class_count
        for index in class_count 0 std::Range::new do
            std::Option[common::ExternAbiClass]::None pending_classes.push
        done
        if pending_classes 0 layouts store typ classify_fields ! then
            std::Option[common::ExternAbiType]::None return
        fi
        std::List[common::ExternAbiClass]::new = classes
        for pending in pending_classes.iter do
            pending match
                std::Option::Some(abi_class) => abi_class copy classes.push
                std::Option::None => common::ExternAbiClass::Integer classes.push
            end
        done
        size classes common::ExternAbiPassing::Registers common::ExternAbiType::new
        std::Option::Some return
    fi
    std::Option[common::ExternAbiType]::None
}

struct ExternStackArgument {
    parameter_index: u64
    size:            u64
    is_aggregate:    bool
}

fn count_abi_class
    classes:$std::List[common::ExternAbiClass]
    target:$common::ExternAbiClass
-> u64 {
    0 = count: u64
    for abi_class in classes.iter do
        if target abi_class == then
            1 += count
        fi
    done
    count
}

# Arguments stay in value stack slots above rbx until the call returns.
struct NativePlanner {
    actions:         std::List[common::NativeAction]
    stack_arguments: std::List[ExternStackArgument]
    integer_index:   u64
    float_index:     u64
    argument_offset: u64
}

impl NativePlanner {
    fn new -> NativePlanner {
        0 0 0 std::List[ExternStackArgument]::new
        std::List[common::NativeAction]::new NativePlanner
    }

    fn argument_operand self:$NativePlanner parameter_index:u64 -> std::String {
        parameter_index common::WORD_SIZE * self.argument_offset + = offset
        f"{offset}(%rbx)"
    }

    fn append self:mut$NativePlanner instruction:std::String {
        instruction common::NativeAction::Instruction self.actions.push
    }

    fn append_literal self:mut$NativePlanner instruction:$str { instruction.to_str self.append }

    fn plan_scalar_parameter
        self:mut$NativePlanner
        builtin:$common::BuiltinType
        parameter_index:u64
    {
        ["%rdi", "%rsi", "%rdx", "%rcx", "%r8", "%r9"] = integer_registers
        ["%xmm0", "%xmm1", "%xmm2", "%xmm3", "%xmm4", "%xmm5", "%xmm6", "%xmm7"]
        = float_registers
        parameter_index self.argument_operand = operand
        if builtin.is_float then
            if self.float_index 8 < then
                self.float_index float_registers array::nth = register
                if builtin common::BuiltinType::F32 == then
                    f"movss {operand}, {register}" self.append
                else
                    f"movsd {operand}, {register}" self.append
                fi
                1 += self.float_index
            else
                false common::WORD_SIZE parameter_index ExternStackArgument
                self.stack_arguments.push
            fi
        else
            if self.integer_index 6 < then
                self.integer_index integer_registers array::nth = register
                f"movq {operand}, {register}" self.append
                1 += self.integer_index
            else
                false common::WORD_SIZE parameter_index ExternStackArgument
                self.stack_arguments.push
            fi
        fi
    }

    fn plan_register_parameter
        self:mut$NativePlanner
        classes:$std::List[common::ExternAbiClass]
        size:u64
        parameter_index:u64
    {
        ["%rdi", "%rsi", "%rdx", "%rcx", "%r8", "%r9"] = integer_registers
        ["%xmm0", "%xmm1", "%xmm2", "%xmm3", "%xmm4", "%xmm5", "%xmm6", "%xmm7"]
        = float_registers
        common::ExternAbiClass::Integer classes count_abi_class
        = required_integer_registers
        common::ExternAbiClass::Sse classes count_abi_class
        = required_float_registers
        if
            self.integer_index required_integer_registers + 6 <=
            self.float_index required_float_registers + 8 <= &&
        then
            f"movq {parameter_index self.argument_operand}, %rax" self.append
            0 = class_index: u64
            for abi_class in classes.iter do
                class_index common::WORD_SIZE * = class_offset
                if abi_class common::ExternAbiClass::Integer == then
                    self.integer_index integer_registers array::nth = register
                    f"movq {class_offset}(%rax), {register}" self.append
                    1 += self.integer_index
                else
                    self.float_index float_registers array::nth = register
                    f"movq {class_offset}(%rax), {register}" self.append
                    1 += self.float_index
                fi
                1 += class_index
            done
        else
            true size parameter_index ExternStackArgument self.stack_arguments.push
        fi
    }

    fn plan_parameter self:mut$NativePlanner parameter:$common::ExternAbiType parameter_index:u64 {
        parameter.passing match
            common::ExternAbiPassing::Scalar(builtin) => parameter_index builtin self.plan_scalar_parameter
            common::ExternAbiPassing::Registers(classes) => parameter_index parameter.size classes self.plan_register_parameter
            common::ExternAbiPassing::Memory => {
                true parameter.size parameter_index ExternStackArgument self.stack_arguments.push
            }
        end
    }

    fn count_stack_slots self:$NativePlanner -> u64 {
        0 = stack_slots: u64
        for stack_argument in self.stack_arguments.iter do
            if stack_argument.is_aggregate then
                stack_argument.size common::WORD_SIZE u64::try_from.unwrap 1 - +
                common::WORD_SIZE u64::try_from.unwrap / += stack_slots
            else
                1 += stack_slots
            fi
        done
        stack_slots
    }

    # r13 is callee-saved, so the unwinder finds the Casa frame through it while
    # rsp is realigned for the native call.
    fn plan_stack self:mut$NativePlanner {
        "movq %rsp, %r13" self.append_literal
        ".cfi_def_cfa_register %r13" self.append_literal
        "andq $-16, %rsp" self.append_literal
        self.count_stack_slots = stack_slots
        if 0 stack_slots 2 % != then
            "subq $8, %rsp" self.append_literal
        fi
        while self.stack_arguments.is_empty ! do
            self.stack_arguments.pop = argument
            argument.parameter_index self.argument_operand = operand
            if argument.is_aggregate then
                argument.size common::WORD_SIZE u64::try_from.unwrap 1 - +
                common::WORD_SIZE u64::try_from.unwrap / = argument_slots
                argument_slots common::WORD_SIZE * = argument_size
                f"subq ${argument_size}, %rsp" self.append
                f"movq {operand}, %rax" self.append
                for slot_index in argument_slots 0 std::Range::new do
                    slot_index common::WORD_SIZE * = slot_offset
                    f"movq {slot_offset}(%rax), %r11" self.append
                    f"movq %r11, {slot_offset}(%rsp)" self.append
                done
            else
                f"pushq {operand}" self.append
            fi
        done
    }

    fn store_register_result self:mut$NativePlanner classes:$std::List[common::ExternAbiClass] {
        0 = return_integer_index: u64
        0 = return_float_index: u64
        0 = offset: u64
        for abi_class in classes.iter do
            if abi_class common::ExternAbiClass::Integer == then
                if 0 return_integer_index == then "%rax" else "%rdx" fi = register
                f"movq {register}, {offset}(%r15)" self.append
                1 += return_integer_index
            else
                if 0 return_float_index == then "%xmm0" else "%xmm1" fi = register
                f"movq {register}, {offset}(%r15)" self.append
                1 += return_float_index
            fi
            common::WORD_SIZE += offset
        done
    }

    # Returns the register that holds the Casa result value.
    fn plan_result self:mut$NativePlanner return_type:$common::ExternAbiType -> str {
        return_type.passing match
            common::ExternAbiPassing::Scalar(builtin) => {
                builtin match
                    common::BuiltinType::I8 => "movsbq %al, %rax" self.append_literal
                    common::BuiltinType::I16 => "movswq %ax, %rax" self.append_literal
                    common::BuiltinType::I32 => "movslq %eax, %rax" self.append_literal
                    common::BuiltinType::Bool => "movzbq %al, %rax" self.append_literal
                    common::BuiltinType::U8 => "movzbq %al, %rax" self.append_literal
                    common::BuiltinType::U16 => "movzwq %ax, %rax" self.append_literal
                    common::BuiltinType::U32 => "movl %eax, %eax" self.append_literal
                    common::BuiltinType::F32 => "movd %xmm0, %eax" self.append_literal
                    common::BuiltinType::F64 => "movq %xmm0, %rax" self.append_literal
                    _ => {}
                end
                "%rax"
            }
            common::ExternAbiPassing::Registers(classes) => {
                classes self.store_register_result
                "%r15"
            }
            common::ExternAbiPassing::Memory => "%r15"
        end
    }

    fn plan_call
        self:mut$NativePlanner
        symbol:$str
        parameters:$std::List[common::ExternAbiType]
        result_type:$std::Option[common::ExternAbiType]
        caller_owned_result:bool
    {
        if caller_owned_result then
            "movq (%rbx), %r15" self.append_literal
            common::WORD_SIZE = self.argument_offset
        elif result_type std::Option::Some(return_type) is then
            if return_type.passing common::ExternAbiPassing::Scalar(_) is ! then
                return_type.size common::NativeAction::Allocate self.actions.push
                "movq %rax, %r15" self.append_literal
            fi
        fi
        if result_type std::Option::Some(return_type) is then
            if return_type.passing common::ExternAbiPassing::Memory is then
                "movq %r15, %rdi" self.append_literal
                1 += self.integer_index
            fi
        fi

        0 = parameter_index: u64
        for parameter in parameters.iter do
            parameter_index parameter self.plan_parameter
            1 += parameter_index
        done
        self.plan_stack

        f"call {symbol}" self.append
        "movq %r13, %rsp" self.append_literal
        ".cfi_def_cfa_register %rsp" self.append_literal

        parameters.length common::WORD_SIZE * self.argument_offset + i64::try_from.unwrap = consumed
        if result_type std::Option::Some(return_type) is then
            return_type self.plan_result = register
            common::WORD_SIZE -= consumed
            if 0 consumed != then
                f"leaq {consumed}(%rbx), %rbx" self.append
            fi
            f"movq {register}, (%rbx)" self.append
        elif 0 consumed != then
            f"leaq {consumed}(%rbx), %rbx" self.append
        fi
    }
}

# Classification is supplied once for a verified concrete signature. The plan
# fixes all placements and normalization before use. It reads arguments from a
# synchronized rbx and leaves rbx at the result. A caller-owned aggregate result
# consumes its destination address above the source arguments.
pub fn plan_native_call
    symbol:$str
    parameters:$std::List[common::ExternAbiType]
    return_type:$std::Option[common::ExternAbiType]
    caller_owned_result:bool
-> common::NativeCallPlan {
    NativePlanner::new = planner
    caller_owned_result return_type parameters symbol planner.plan_call
    planner match
        NativePlanner { actions: actions } => actions common::NativeCallPlan
    end
}

# Only concrete, source-checked signatures reach native classification.
pub fn plan_checked_extern
    signature:$typechecker::CheckedExtern
    store:$common::SymbolStore
    layouts:mut$common::LayoutPlanner
    diagnostics:mut$error::Diagnostics
    caller_owned_result:bool
-> std::Option[common::NativeCallPlan] {
    std::List[common::ExternAbiType]::new = parameters
    for
        parameter in signature
            .effect
            .parameters
            .iter
    do
        if layouts store parameter.typ classify_extern_type std::Option::Some(classification) is then
            classification.clone parameters.push
        else
            parameter.typ.format = type_name
            signature.location
            f"Extern parameter type `{type_name}` has no supported Linux x86-64 ABI layout"
            common::ErrorKind::TypeMismatch diagnostics.record_error_string
        fi
    done
    std::Option[common::ExternAbiType]::None = result_type
    for
        typ in signature
            .effect
            .return_types
            .iter
    do
        if layouts store typ classify_extern_type std::Option::Some(classification) is then
            classification.clone std::Option::Some = result_type
        else
            typ.format = type_name
            signature.location
            f"Extern return type `{type_name}` has no supported Linux x86-64 ABI layout"
            common::ErrorKind::TypeMismatch diagnostics.record_error_string
        fi
    done
    if diagnostics.has_errors then
        std::Option[common::NativeCallPlan]::None return
    fi
    caller_owned_result result_type parameters signature.symbol.as_str plan_native_call std::Option::Some
}
