# x86-64 GNU assembly emitter for the Casa compiler.
import "std" as std
import "common" as common

# ============================================================================
# Constants
# ============================================================================
pub const INT32_MAX 2147483647
pub const INT32_MIN -2147483648
pub const RETURN_STACK_SIZE 1048576
pub const SMALL_ALLOC_LIMIT 512
pub const HEAP_CHUNK_HEADER_SIZE 16
pub const HEAP_GROWTH_SIZE 67108864
pub const MMAP_SYSCALL 9
pub const MMAP_PROT_READ_WRITE 3
pub const MMAP_PRIVATE_ANONYMOUS 34

# ============================================================================
# Emitter state
# ============================================================================

pub struct Emitter {
    pub asm:           std::String
    pub label_counter: u64
    pub program:       common::Program
}

impl common::Program {
    # Keep global bytecode outside Emitter so emission can mutate its output
    # while it reads the instruction list.
    pub fn split_bytecode self:common::Program -> common::Program std::List[common::InstValue] {
        self match
            common::Program { bytecode: bytecode functions: functions strings: strings static_arrays: static_arrays static_structs: static_structs globals_count: globals_count constants_count: constants_count } => {
                constants_count globals_count static_structs static_arrays
                strings functions std::List[common::InstValue]::new common::Program
                bytecode
            }
        end
    }
}

impl Emitter {
    pub fn new program:common::Program -> Emitter {
        program
        0
        std::String::new
        Emitter
    }

    pub fn into_asm self:Emitter -> std::String {
        self match
            Emitter { asm: asm } => asm
        end
    }

    pub fn emit_uid self:mut$Emitter -> u64 {
        1 += self.label_counter
        self.label_counter
    }

    pub fn line self:mut$Emitter text:$str {
        text self.asm.append
        '\n' self.asm.push
    }

    pub fn indent self:mut$Emitter text:$str {
        "    " self.asm.append
        text self.asm.append
        '\n' self.asm.push
    }

    pub fn line_string self:mut$Emitter text:std::String { text.as_str self.line }

    pub fn indent_string self:mut$Emitter text:std::String { text.as_str self.indent }
}

# ============================================================================
# Convert a source-level function name to an assembler-safe label.
# ============================================================================

pub fn sanitize_name name:$str -> std::String {
    name "::" str::split = parts
    "__" parts.join_strings = namespaced
    std::String::new = result
    for character in namespaced.iter do
        if
            character.is_alpha
            character.is_digit ||
            '_' character == ||
            ':' character == ||
        then
            character result.push
        else
            '_' result.push
        fi
    done
    result
}

pub fn get_extern_abi_type typ:$common::Type -> common::BuiltinType {
    if typ.is_borrow then
        common::BuiltinType::Ptr return
    fi
    if typ common::Type::Builtin(builtin) is then
        builtin return
    fi
    "Internal error: non-ABI type reached extern emission\n" std::eprint
    1 std::exit
    common::BuiltinType::Ptr
}

# ============================================================================
# escape_string: escape special chars for assembly string literals
# ============================================================================

pub fn make_octal_digit value:u32 -> char { value '0'.codepoint + char::from_codepoint.unwrap }

pub fn escape_string s:$str -> std::String {
    std::String::new = builder
    0 = index: u64
    while index s.length > do
        index s.at = byte
        if '\\' byte == then
            "\\\\" builder.append
        elif '"' byte == then
            "\\\"" builder.append
        elif '\n' byte == then
            "\\n" builder.append
        elif '\t' byte == then
            "\\t" builder.append
        elif '\0' byte == then
            "\\0" builder.append
        elif '\r' byte == then
            "\\r" builder.append
        elif
            32 byte.codepoint i64::from <
            127 byte.codepoint i64::from >= ||
        then
            '\\' builder.push
            byte.codepoint 64 / make_octal_digit builder.push
            byte.codepoint 8 / 8 % make_octal_digit builder.push
            byte.codepoint 8 % make_octal_digit builder.push
        else
            byte builder.push
        fi
        1 += index
    done
    builder
}

# ============================================================================
# BSS section
# ============================================================================

impl Emitter {
    pub fn emit_bss self:mut$Emitter {
        ".section .bss" self.line
        if 0 self.program.globals_count > then
            f"globals: .skip {self.program.globals_count common::WORD_SIZE *}" self.line_string
        fi
        if 0 self.program.constants_count > then
            f"constants: .skip {self.program.constants_count common::WORD_SIZE *}" self.line_string
        fi
        f"return_stack: .skip {RETURN_STACK_SIZE}" self.line_string
        f"env_stack: .skip {RETURN_STACK_SIZE}" self.line_string
        "env_sp: .skip 8" self.line
        "current_env: .skip 8" self.line
        ".align 16" self.line
        "heap_chunks: .skip 8" self.line
        "heap_ptr: .skip 8" self.line
        "heap_end: .skip 8" self.line
        "free_list: .skip 8" self.line
        f"small_free_lists: .skip {SMALL_ALLOC_LIMIT}" self.line_string
        "__argc: .skip 8" self.line
        "__argv: .skip 8" self.line
        "__envp: .skip 8" self.line
        "print_buf: .skip 32" self.line
        "" self.line
    }

    # ============================================================================
    # DATA section
    # ============================================================================

    pub fn emit_data self:mut$Emitter {
        ".section .data" self.line
        0 = index: u64
        while
            index self
                .program
                .strings
                .length >
        do
            index self
                .program
                .strings
                .get = value
            value.as_str escape_string = escaped
            ".align 8" self.line
            f"str_{index}:" self.line_string
            f".quad {value.length}" self.line_string
            f".asciz \"{escaped}\"" self.line_string
            1 += index
        done
        "bool_true: .ascii \"true\"" self.line
        "bool_false: .ascii \"false\"" self.line
        "float_decimal_ten: .long 10" self.line
        "arithmetic_error_msg: .ascii \"error: integer arithmetic failed\\n\"" self.line
        ".equ arithmetic_error_msg_len, . - arithmetic_error_msg" self.line
        "env_stack_overflow_msg: .ascii \"error: env stack overflow\\n\"" self.line
        ".equ env_stack_overflow_msg_len, . - env_stack_overflow_msg" self.line
        "allocation_failure_msg: .ascii \"fatal: allocation failed\\n\"" self.line
        ".equ allocation_failure_msg_len, . - allocation_failure_msg" self.line
        # Static closure record per function
        for
            name in self
                .program
                .functions
                .keys
                .iter
        do
            name.as_str sanitize_name = label
            ".align 8" self.line
            f"closure_{label}: .quad fn_{label}" self.line_string
            ".quad 0" self.line
        done

        # Static array literals
        0 = sa_index: u64
        while
            sa_index self
                .program
                .static_arrays
                .length >
        do
            sa_index self
                .program
                .static_arrays
                .get
                .clone = sa
            sa common::StaticArray::elements = elems: $std::List[common::StaticArrayElement]
            ".align 8" self.line
            f"static_array_{sa_index}:" self.line_string
            # A zero-length array is inhabited, so its label owns storage of
            # its own rather than aliasing what follows (ADR-0155).
            if 0 elems.length == then
                ".quad 0" self.line
            fi
            for elem in elems.iter do
                elem match
                    common::StaticArrayElement::Imm(v) => {
                        f".quad {v}" self.line_string
                    }
                    common::StaticArrayElement::Label(lbl) => {
                        f".quad {lbl}" self.line_string
                    }
                end
            done
            1 += sa_index
        done

        # Static struct literals
        0 = ss_index: u64
        while
            ss_index self
                .program
                .static_structs
                .length >
        do
            ss_index self
                .program
                .static_structs
                .get
                .clone = ss
            ss common::StaticStruct::fields = fields: $std::List[common::StaticArrayElement]
            ".align 8" self.line
            f"static_struct_{ss_index}:" self.line_string
            for field in fields.iter do
                field match
                    common::StaticArrayElement::Imm(v) => {
                        f".quad {v}" self.line_string
                    }
                    common::StaticArrayElement::Label(lbl) => {
                        f".quad {lbl}" self.line_string
                    }
                end
            done
            1 += ss_index
        done

        "" self.line
    }

    # ============================================================================
    # TEXT section
    # ============================================================================

    pub fn emit_text self:mut$Emitter bytecode:$std::List[common::InstValue] {
        ".section .text" self.line
        self.emit_helpers
        self.emit_functions
        bytecode self.emit_start
    }

    # ============================================================================
    # Helper subroutines
    # ============================================================================

    # Each mmap chunk starts with the previous chunk and its end address.
    # Small blocks use exact-size bins. Larger blocks keep first-fit reuse.
    # ponytail: large blocks are not split or coalesced; add both if large-block
    # fragmentation becomes measurable.
    pub fn emit_heap_helpers self:mut$Emitter {
        # heap_alloc: requested byte count in %rdi, pushes an aligned pointer.
        "heap_alloc:" self.line
        "testq %rdi, %rdi" self.indent
        "jz .Lheap_alloc_null" self.indent
        "movq %rdi, %rax" self.indent
        "addq $7, %rax" self.indent
        "jc .Lheap_alloc_oom" self.indent
        "andq $-8, %rax" self.indent
        f"cmpq ${SMALL_ALLOC_LIMIT}, %rax" self.indent_string
        "ja .Lheap_alloc_large" self.indent
        "leaq small_free_lists(%rip), %r9" self.indent
        "leaq -8(%r9,%rax), %r9" self.indent
        "movq (%r9), %rcx" self.indent
        "testq %rcx, %rcx" self.indent
        "jz .Lheap_alloc_bump" self.indent
        "movq 8(%rcx), %r8" self.indent
        "movq %r8, (%r9)" self.indent
        "leaq 8(%rcx), %rax" self.indent
        "pushq %rax" self.indent
        "jmp .Lheap_alloc_return" self.indent
        ".Lheap_alloc_large:" self.line
        "movq free_list(%rip), %rcx" self.indent
        "xorq %rdx, %rdx" self.indent
        ".Lheap_alloc_search:" self.line
        "testq %rcx, %rcx" self.indent
        "jz .Lheap_alloc_bump" self.indent
        "cmpq %rax, (%rcx)" self.indent
        "jae .Lheap_alloc_reuse" self.indent
        "movq %rcx, %rdx" self.indent
        "movq 8(%rcx), %rcx" self.indent
        "jmp .Lheap_alloc_search" self.indent
        ".Lheap_alloc_reuse:" self.line
        "movq 8(%rcx), %r8" self.indent
        "testq %rdx, %rdx" self.indent
        "jz .Lheap_alloc_reuse_head" self.indent
        "movq %r8, 8(%rdx)" self.indent
        "jmp .Lheap_alloc_return_block" self.indent
        ".Lheap_alloc_reuse_head:" self.line
        "movq %r8, free_list(%rip)" self.indent
        ".Lheap_alloc_return_block:" self.line
        "leaq 8(%rcx), %rax" self.indent
        "pushq %rax" self.indent
        "jmp .Lheap_alloc_return" self.indent
        ".Lheap_alloc_bump:" self.line
        "movq heap_ptr(%rip), %rcx" self.indent
        "testq %rcx, %rcx" self.indent
        "jz .Lheap_alloc_map" self.indent
        "addq $7, %rcx" self.indent
        "andq $-8, %rcx" self.indent
        "movq %rax, %r8" self.indent
        "addq $8, %r8" self.indent
        "jc .Lheap_alloc_oom" self.indent
        "addq %rcx, %r8" self.indent
        "jc .Lheap_alloc_oom" self.indent
        "cmpq heap_end(%rip), %r8" self.indent
        "jbe .Lheap_alloc_commit" self.indent
        ".Lheap_alloc_map:" self.line
        "pushq %rsi" self.indent
        "pushq %r10" self.indent
        "pushq %r11" self.indent
        "pushq %rax" self.indent
        "movq %rax, %rsi" self.indent
        f"addq ${HEAP_CHUNK_HEADER_SIZE 8 +}, %rsi" self.indent_string
        "jc .Lheap_alloc_oom" self.indent
        f"cmpq ${HEAP_GROWTH_SIZE}, %rsi" self.indent_string
        "jae .Lheap_alloc_map_size_ready" self.indent
        f"movq ${HEAP_GROWTH_SIZE}, %rsi" self.indent_string
        ".Lheap_alloc_map_size_ready:" self.line
        "xorq %rdi, %rdi" self.indent
        f"movq ${MMAP_PROT_READ_WRITE}, %rdx" self.indent_string
        f"movq ${MMAP_PRIVATE_ANONYMOUS}, %r10" self.indent_string
        "movq $-1, %r8" self.indent
        "xorq %r9, %r9" self.indent
        f"movq ${MMAP_SYSCALL}, %rax" self.indent_string
        "syscall" self.indent
        "popq %rdx" self.indent
        "testq %rax, %rax" self.indent
        "jz .Lheap_alloc_oom" self.indent
        "cmpq $-4095, %rax" self.indent
        "jae .Lheap_alloc_oom" self.indent
        "movq heap_chunks(%rip), %r8" self.indent
        "movq %r8, (%rax)" self.indent
        "movq %rax, %rcx" self.indent
        "addq %rsi, %rcx" self.indent
        "jc .Lheap_alloc_oom" self.indent
        "movq %rcx, 8(%rax)" self.indent
        "movq %rax, heap_chunks(%rip)" self.indent
        "movq %rcx, heap_end(%rip)" self.indent
        f"leaq {HEAP_CHUNK_HEADER_SIZE}(%rax), %rcx" self.indent_string
        "movq %rdx, %rax" self.indent
        "popq %r11" self.indent
        "popq %r10" self.indent
        "popq %rsi" self.indent
        "movq %rax, %r8" self.indent
        "addq $8, %r8" self.indent
        "addq %rcx, %r8" self.indent
        ".Lheap_alloc_commit:" self.line
        "movq %rax, (%rcx)" self.indent
        "movq %r8, heap_ptr(%rip)" self.indent
        "leaq 8(%rcx), %rax" self.indent
        "pushq %rax" self.indent
        "jmp .Lheap_alloc_return" self.indent
        ".Lheap_alloc_null:" self.line
        "pushq $0" self.indent
        ".Lheap_alloc_return:" self.line
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        ".Lheap_alloc_oom:" self.line
        "movq $1, %rax" self.indent
        "movq $2, %rdi" self.indent
        "leaq allocation_failure_msg(%rip), %rsi" self.indent
        "movq $allocation_failure_msg_len, %rdx" self.indent
        "syscall" self.indent
        "movq $60, %rax" self.indent
        "movq $1, %rdi" self.indent
        "syscall" self.indent
        "" self.line

        # heap_free: pointer in %rdi, returns the complete allocation for reuse.
        "heap_free:" self.line
        "testq %rdi, %rdi" self.indent
        "jz .Lheap_free_return" self.indent
        "leaq -8(%rdi), %rax" self.indent
        "movq (%rax), %rdx" self.indent
        f"cmpq ${SMALL_ALLOC_LIMIT}, %rdx" self.indent_string
        "ja .Lheap_free_large" self.indent
        "leaq small_free_lists(%rip), %rcx" self.indent
        "leaq -8(%rcx,%rdx), %rcx" self.indent
        "movq (%rcx), %rdx" self.indent
        "movq %rdx, 8(%rax)" self.indent
        "movq %rax, (%rcx)" self.indent
        "jmp .Lheap_free_return" self.indent
        ".Lheap_free_large:" self.line
        "movq free_list(%rip), %rcx" self.indent
        "movq %rcx, 8(%rax)" self.indent
        "movq %rax, free_list(%rip)" self.indent
        ".Lheap_free_return:" self.line
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line
    }

    pub fn emit_helpers self:mut$Emitter {
        self.emit_heap_helpers

        # print_int: value in %rdi, returns via r14
        "print_int:" self.line
        "movq %rdi, %rax" self.indent
        "leaq print_buf+32(%rip), %rsi" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpi_nonzero" self.indent
        "decq %rsi" self.indent
        "movb $48, (%rsi)" self.indent
        "jmp .Lpi_write" self.indent
        ".Lpi_nonzero:" self.line
        "movq %rax, %r15" self.indent
        "jns .Lpi_abs" self.indent
        "negq %rax" self.indent
        ".Lpi_abs:" self.line
        "movq $10, %rcx" self.indent
        ".Lpi_digit_loop:" self.line
        "decq %rsi" self.indent
        "xorq %rdx, %rdx" self.indent
        "divq %rcx" self.indent
        "addb $48, %dl" self.indent
        "movb %dl, (%rsi)" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpi_digit_loop" self.indent
        "testq %r15, %r15" self.indent
        "jns .Lpi_write" self.indent
        "decq %rsi" self.indent
        "movb $45, (%rsi)" self.indent
        ".Lpi_write:" self.line
        "leaq print_buf+32(%rip), %rdx" self.indent
        "subq %rsi, %rdx" self.indent
        "movq $1, %rax" self.indent
        "movq $1, %rdi" self.indent
        "syscall" self.indent
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # print_uint: value in %rdi, returns via r14
        "print_uint:" self.line
        "movq %rdi, %rax" self.indent
        "leaq print_buf+32(%rip), %rsi" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpui_digit_loop" self.indent
        "decq %rsi" self.indent
        "movb $48, (%rsi)" self.indent
        "jmp .Lpui_write" self.indent
        ".Lpui_digit_loop:" self.line
        "decq %rsi" self.indent
        "xorq %rdx, %rdx" self.indent
        "movq $10, %rcx" self.indent
        "divq %rcx" self.indent
        "addb $48, %dl" self.indent
        "movb %dl, (%rsi)" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpui_digit_loop" self.indent
        ".Lpui_write:" self.line
        "leaq print_buf+32(%rip), %rdx" self.indent
        "subq %rsi, %rdx" self.indent
        "movq $1, %rax" self.indent
        "movq $1, %rdi" self.indent
        "syscall" self.indent
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # print_str: string pointer in %rdi (points to length prefix), returns via r14
        "print_str:" self.line
        "movq (%rdi), %rdx" self.indent
        "leaq 8(%rdi), %rsi" self.indent
        "movq $1, %rdi" self.indent
        "movq $1, %rax" self.indent
        "syscall" self.indent
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # encode_char: Unicode scalar in %rdi, UTF-8 bytes in print_buf.
        # Returns the buffer in %rsi and its byte length in %rdx via r14.
        "encode_char:" self.line
        "leaq print_buf(%rip), %rsi" self.indent
        "cmpq $127, %rdi" self.indent
        "ja .Lec_two" self.indent
        "movb %dil, (%rsi)" self.indent
        "movq $1, %rdx" self.indent
        "jmp .Lec_return" self.indent
        ".Lec_two:" self.line
        "cmpq $2047, %rdi" self.indent
        "ja .Lec_three" self.indent
        "movq %rdi, %rax" self.indent
        "shrq $6, %rax" self.indent
        "orb $192, %al" self.indent
        "movb %al, (%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 1(%rsi)" self.indent
        "movq $2, %rdx" self.indent
        "jmp .Lec_return" self.indent
        ".Lec_three:" self.line
        "cmpq $65535, %rdi" self.indent
        "ja .Lec_four" self.indent
        "movq %rdi, %rax" self.indent
        "shrq $12, %rax" self.indent
        "orb $224, %al" self.indent
        "movb %al, (%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "shrq $6, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 1(%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 2(%rsi)" self.indent
        "movq $3, %rdx" self.indent
        "jmp .Lec_return" self.indent
        ".Lec_four:" self.line
        "movq %rdi, %rax" self.indent
        "shrq $18, %rax" self.indent
        "orb $240, %al" self.indent
        "movb %al, (%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "shrq $12, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 1(%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "shrq $6, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 2(%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 3(%rsi)" self.indent
        "movq $4, %rdx" self.indent
        ".Lec_return:" self.line
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # primitive_to_str: value in %rdi, kind in %r8, pushes an owned String.
        # Kinds: 0 signed integer, 1 unsigned integer, 2 bool, 3 char, 4 cstr.
        "primitive_to_str:" self.line
        "cmpq $2, %r8" self.indent
        "je .Lpts_bool" self.indent
        "cmpq $3, %r8" self.indent
        "je .Lpts_char" self.indent
        "cmpq $4, %r8" self.indent
        "je .Lpts_cstr" self.indent
        "movq %rdi, %rax" self.indent
        "leaq print_buf+32(%rip), %rsi" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpts_integer_nonzero" self.indent
        "decq %rsi" self.indent
        "movb $48, (%rsi)" self.indent
        "jmp .Lpts_integer_done" self.indent
        ".Lpts_integer_nonzero:" self.line
        "testq %r8, %r8" self.indent
        "jnz .Lpts_integer_abs" self.indent
        "testq %rax, %rax" self.indent
        "jns .Lpts_integer_abs" self.indent
        "negq %rax" self.indent
        ".Lpts_integer_abs:" self.line
        "movq $10, %rcx" self.indent
        ".Lpts_integer_loop:" self.line
        "decq %rsi" self.indent
        "xorq %rdx, %rdx" self.indent
        "divq %rcx" self.indent
        "addb $48, %dl" self.indent
        "movb %dl, (%rsi)" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpts_integer_loop" self.indent
        "testq %r8, %r8" self.indent
        "jnz .Lpts_integer_done" self.indent
        "testq %rdi, %rdi" self.indent
        "jns .Lpts_integer_done" self.indent
        "decq %rsi" self.indent
        "movb $45, (%rsi)" self.indent
        ".Lpts_integer_done:" self.line
        "leaq print_buf+32(%rip), %rdx" self.indent
        "subq %rsi, %rdx" self.indent
        "jmp .Lpts_copy" self.indent
        ".Lpts_bool:" self.line
        "testq %rdi, %rdi" self.indent
        "jz .Lpts_bool_false" self.indent
        "leaq bool_true(%rip), %rsi" self.indent
        "movq $4, %rdx" self.indent
        "jmp .Lpts_copy" self.indent
        ".Lpts_bool_false:" self.line
        "leaq bool_false(%rip), %rsi" self.indent
        "movq $5, %rdx" self.indent
        "jmp .Lpts_copy" self.indent
        ".Lpts_char:" self.line
        "pts_char_encoded" "encode_char" self.emit_call_via_return_stack
        "jmp .Lpts_copy" self.indent
        ".Lpts_cstr:" self.line
        "movq %rdi, %rsi" self.indent
        "movq %rdi, %rax" self.indent
        ".Lpts_cstr_loop:" self.line
        "cmpb $0, (%rax)" self.indent
        "je .Lpts_cstr_done" self.indent
        "incq %rax" self.indent
        "jmp .Lpts_cstr_loop" self.indent
        ".Lpts_cstr_done:" self.line
        "movq %rax, %rdx" self.indent
        "subq %rsi, %rdx" self.indent
        ".Lpts_copy:" self.line
        "pushq %rsi" self.indent
        "pushq %rdx" self.indent
        "movq %rdx, %rdi" self.indent
        "addq $9, %rdi" self.indent
        "jc .Lheap_alloc_oom" self.indent
        "primitive_string_data_done" "heap_alloc" self.emit_call_via_return_stack
        "popq %r13" self.indent
        "popq %rdx" self.indent
        "popq %rsi" self.indent
        "movq %rdx, (%r13)" self.indent
        "leaq 8(%r13), %rdi" self.indent
        "movq %rdx, %rcx" self.indent
        "rep movsb" self.indent
        "movb $0, (%rdi)" self.indent
        "movq $8, %rdi" self.indent
        "primitive_string_wrapper_done" "heap_alloc" self.emit_call_via_return_stack
        "popq %rax" self.indent
        "movq %r13, (%rax)" self.indent
        "pushq %rax" self.indent
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # str_concat consumes N owned String wrappers and pushes one owned String.
        "str_concat:" self.line
        "movq %rdi, %r15" self.indent
        "movq %rsp, %r12" self.indent
        "xorq %r10, %r10" self.indent
        "xorq %rcx, %rcx" self.indent
        ".Lsc_len_loop:" self.line
        "cmpq %r15, %rcx" self.indent
        "jge .Lsc_len_done" self.indent
        "movq (%r12, %rcx, 8), %rax" self.indent
        "movq (%rax), %rax" self.indent
        "addq (%rax), %r10" self.indent
        "jc .Lheap_alloc_oom" self.indent
        "incq %rcx" self.indent
        "jmp .Lsc_len_loop" self.indent
        ".Lsc_len_done:" self.line
        "movq %r10, %rdi" self.indent
        "addq $9, %rdi" self.indent
        "jc .Lheap_alloc_oom" self.indent
        "concat_string_data_done" "heap_alloc" self.emit_call_via_return_stack
        "popq %r13" self.indent
        "movq %r10, (%r13)" self.indent
        "leaq 8(%r13), %rdi" self.indent
        "movq %r15, %rcx" self.indent
        "decq %rcx" self.indent
        ".Lsc_copy_loop:" self.line
        "cmpq $0, %rcx" self.indent
        "jl .Lsc_copy_done" self.indent
        "movq (%r12, %rcx, 8), %rsi" self.indent
        "movq (%rsi), %rsi" self.indent
        "movq (%rsi), %rdx" self.indent
        "addq $8, %rsi" self.indent
        "pushq %rcx" self.indent
        "movq %rdx, %rcx" self.indent
        "rep movsb" self.indent
        "popq %rcx" self.indent
        "decq %rcx" self.indent
        "jmp .Lsc_copy_loop" self.indent
        ".Lsc_copy_done:" self.line
        "movb $0, (%rdi)" self.indent
        "xorq %rcx, %rcx" self.indent
        ".Lsc_free_loop:" self.line
        "cmpq %r15, %rcx" self.indent
        "jge .Lsc_free_done" self.indent
        "movq (%r12, %rcx, 8), %rbx" self.indent
        "pushq %rcx" self.indent
        "movq (%rbx), %rdi" self.indent
        "concat_part_data_free_done" "heap_free" self.emit_call_via_return_stack
        "movq %rbx, %rdi" self.indent
        "concat_part_wrapper_free_done" "heap_free" self.emit_call_via_return_stack
        "popq %rcx" self.indent
        "incq %rcx" self.indent
        "jmp .Lsc_free_loop" self.indent
        ".Lsc_free_done:" self.line
        "movq $8, %rdi" self.indent
        "concat_string_wrapper_done" "heap_alloc" self.emit_call_via_return_stack
        "popq %rax" self.indent
        "movq %r13, (%rax)" self.indent
        "leaq (%r12, %r15, 8), %rsp" self.indent
        "pushq %rax" self.indent
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # Arithmetic failure handler: write error to fd 2 and exit(1).
        "arithmetic_error:" self.line
        "leaq arithmetic_error_msg(%rip), %rsi" self.indent
        "movq $arithmetic_error_msg_len, %rdx" self.indent
        "movq $2, %rdi" self.indent
        "movq $1, %rax" self.indent
        "syscall" self.indent
        "movq $1, %rdi" self.indent
        "movq $60, %rax" self.indent
        "syscall" self.indent
        "" self.line

        # env_stack overflow handler: write error to fd 2 and exit(1).
        "env_stack_overflow:" self.line
        "leaq env_stack_overflow_msg(%rip), %rsi" self.indent
        "movq $env_stack_overflow_msg_len, %rdx" self.indent
        "movq $2, %rdi" self.indent
        "movq $1, %rax" self.indent
        "syscall" self.indent
        "movq $1, %rdi" self.indent
        "movq $60, %rax" self.indent
        "syscall" self.indent
        "" self.line
    }

    # ============================================================================
    # Emit user functions
    # ============================================================================

    pub fn emit_functions self:mut$Emitter {
        self
            .program
            .functions
            .keys = function_names
        for name in function_names.iter do
            name self
                .program
                .functions
                .remove
                .unwrap = bytecode
            name.as_str sanitize_name = label
            f"fn_{label}:" self.line_string
            false bytecode self.emit_bytecode
            "" self.line
        done
    }

    # ============================================================================
    # Emit _start entry point
    # ============================================================================

    pub fn emit_start self:mut$Emitter bytecode:$std::List[common::InstValue] {
        ".globl _start" self.line
        "_start:" self.line
        "leaq return_stack(%rip), %r14" self.indent
        "movq (%rsp), %rax" self.indent
        "movq %rax, __argc(%rip)" self.indent
        "leaq 8(%rsp), %rax" self.indent
        "movq %rax, __argv(%rip)" self.indent
        "movq (%rsp), %rcx" self.indent
        "addq $1, %rcx" self.indent
        "leaq 8(%rsp,%rcx,8), %rax" self.indent
        "movq %rax, __envp(%rip)" self.indent
        true bytecode self.emit_bytecode
        "movq $60, %rax" self.indent
        "xorq %rdi, %rdi" self.indent
        "syscall" self.indent
        "" self.line
    }

    # ============================================================================
    # Emit bytecode sequence
    # ============================================================================

    pub fn emit_bytecode self:mut$Emitter bytecode:$std::List[common::InstValue] is_global:bool {
        for inst in bytecode.iter do
            is_global inst self.emit_inst
        done
    }

    # ============================================================================
    # Emit comparison helper
    # ============================================================================

    pub fn emit_comparison self:mut$Emitter setcc:str {
        "popq %rax" self.indent
        "cmpq (%rsp), %rax" self.indent
        f"{setcc} %al" self.indent_string
        "movzbq %al, %rax" self.indent
        "movq %rax, (%rsp)" self.indent
    }

    # ============================================================================
    # Emit syscall helper
    # ============================================================================

    pub fn emit_syscall self:mut$Emitter arg_count:u64 {
        "popq %rax" self.indent
        ["%rdi", "%rsi", "%rdx", "%r10", "%r8", "%r9"] = syscall_regs
        0 = index: u64
        while index arg_count > do
            f"popq {index syscall_regs array::nth}" self.indent_string
            1 += index
        done
        "syscall" self.indent
        "pushq %rax" self.indent
    }

    pub fn emit_extern_call self:mut$Emitter call:$common::ExternCall {
        ["%rdi", "%rsi", "%rdx", "%rcx", "%r8", "%r9"] = integer_registers
        ["%xmm0", "%xmm1", "%xmm2", "%xmm3", "%xmm4", "%xmm5", "%xmm6", "%xmm7"]
        = float_registers
        std::List[u64]::new = stack_arguments
        0 = integer_register_index: u64
        0 = float_register_index: u64

        "movq %rsp, %r13" self.indent
        0 = parameter_index: u64
        for
            parameter in call
                .stack_effect
                .parameters
                .iter
        do
            parameter_index common::WORD_SIZE * = offset
            parameter.typ get_extern_abi_type = abi_type
            if abi_type.is_float then
                if float_register_index 8 > then
                    float_register_index float_registers array::nth = register
                    if abi_type common::BuiltinType::F32 == then
                        f"movss {offset}(%r13), {register}" self.indent_string
                    else
                        f"movsd {offset}(%r13), {register}" self.indent_string
                    fi
                    1 += float_register_index
                else
                    parameter_index stack_arguments.push
                fi
            else
                if integer_register_index 6 > then
                    integer_register_index integer_registers array::nth = register
                    f"movq {offset}(%r13), {register}" self.indent_string
                    1 += integer_register_index
                else
                    parameter_index stack_arguments.push
                fi
            fi
            1 += parameter_index
        done

        f"leaq {call
            .stack_effect
            .parameters
            .length common::WORD_SIZE *}(%r13), %r12"
        self.indent_string
        "movq %r12, %rsp" self.indent
        "andq $-16, %rsp" self.indent
        if 0 stack_arguments.length 2 % != then
            "subq $8, %rsp" self.indent
        fi
        stack_arguments.length = stack_index
        while 0 stack_index != do
            1 -= stack_index
            stack_index stack_arguments.get.clone common::WORD_SIZE * = offset
            f"pushq {offset}(%r13)" self.indent_string
        done

        f"call {call.symbol}" self.indent_string
        "movq %r12, %rsp" self.indent

        if
            call
                .stack_effect
                .return_types
                .is_empty
        then
            return
        fi
        0 call
            .stack_effect
            .return_types
            .get get_extern_abi_type = return_type
        return_type match
            common::BuiltinType::I8 => "movsbq %al, %rax" self.indent
            common::BuiltinType::I16 => "movswq %ax, %rax" self.indent
            common::BuiltinType::I32 => "movslq %eax, %rax" self.indent
            common::BuiltinType::U8 => "movzbq %al, %rax" self.indent
            common::BuiltinType::U16 => "movzwq %ax, %rax" self.indent
            common::BuiltinType::U32 => "movl %eax, %eax" self.indent
            common::BuiltinType::F32 => {
                "movd %xmm0, %eax" self.indent
                "pushq %rax" self.indent
                return
            }
            common::BuiltinType::F64 => {
                "movq %xmm0, %rax" self.indent
                "pushq %rax" self.indent
                return
            }
            _ => {
            }
        end
        "pushq %rax" self.indent
    }

    # ============================================================================
    # Emit call-via-return-stack: push a return address onto r14, jump to target,
    # then emit the return label. Shared by FnCall, PrintInt, PrintStr, and
    # FstringConcat (all of which funnel into a shared asm subroutine).
    # ============================================================================

    pub fn emit_call_via_return_stack self:mut$Emitter jump_target:$str label_prefix:$str {
        self.emit_uid = uid
        f"leaq .L{label_prefix}_{uid}(%rip), %rax" self.indent_string
        "movq %rax, (%r14)" self.indent
        "addq $8, %r14" self.indent
        f"jmp {jump_target}" self.indent_string
        f".L{label_prefix}_{uid}:" self.line_string
    }

    # ============================================================================
    # Emit memory load/store shared helpers
    # ============================================================================

    pub fn emit_load self:mut$Emitter mov_op:str dst_reg:str {
        "popq %rax" self.indent
        f"{mov_op} (%rax), {dst_reg}" self.indent_string
        "pushq %rax" self.indent
    }

    pub fn emit_store self:mut$Emitter mov_op:str src_reg:str {
        "popq %rax" self.indent
        "popq %rbx" self.indent
        f"{mov_op} {src_reg}, (%rax)" self.indent_string
    }

    pub fn emit_move_bytes self:mut$Emitter size:u64 {
        "popq %rdi" self.indent
        "popq %rsi" self.indent
        f"movq ${size}, %rcx" self.indent_string
        "rep movsb" self.indent
    }

    pub fn emit_typed_read self:mut$Emitter {
        self.emit_uid = uid
        "popq %r8" self.indent
        "popq %rdx" self.indent
        "popq %rax" self.indent
        f"cmpq ${common::VALUE_REPR_INDIRECT}, %r8" self.indent_string
        f"je .Ltyped_read_indirect_{uid}" self.indent_string
        "cmpq $1, %rdx" self.indent
        f"je .Ltyped_read_1_{uid}" self.indent_string
        "cmpq $2, %rdx" self.indent
        f"je .Ltyped_read_2_{uid}" self.indent_string
        "cmpq $4, %rdx" self.indent
        f"je .Ltyped_read_4_{uid}" self.indent_string
        "movq (%rax), %rax" self.indent
        f"jmp .Ltyped_read_done_{uid}" self.indent_string
        f".Ltyped_read_1_{uid}:" self.line_string
        f"cmpq ${common::VALUE_REPR_SIGNED}, %r8" self.indent_string
        f"je .Ltyped_read_signed_1_{uid}" self.indent_string
        "movzbq (%rax), %rax" self.indent
        f"jmp .Ltyped_read_done_{uid}" self.indent_string
        f".Ltyped_read_signed_1_{uid}:" self.line_string
        "movsbq (%rax), %rax" self.indent
        f"jmp .Ltyped_read_done_{uid}" self.indent_string
        f".Ltyped_read_2_{uid}:" self.line_string
        f"cmpq ${common::VALUE_REPR_SIGNED}, %r8" self.indent_string
        f"je .Ltyped_read_signed_2_{uid}" self.indent_string
        "movzwq (%rax), %rax" self.indent
        f"jmp .Ltyped_read_done_{uid}" self.indent_string
        f".Ltyped_read_signed_2_{uid}:" self.line_string
        "movswq (%rax), %rax" self.indent
        f"jmp .Ltyped_read_done_{uid}" self.indent_string
        f".Ltyped_read_4_{uid}:" self.line_string
        f"cmpq ${common::VALUE_REPR_SIGNED}, %r8" self.indent_string
        f"je .Ltyped_read_signed_4_{uid}" self.indent_string
        "movl (%rax), %eax" self.indent
        f"jmp .Ltyped_read_done_{uid}" self.indent_string
        f".Ltyped_read_signed_4_{uid}:" self.line_string
        "movslq (%rax), %rax" self.indent
        f"jmp .Ltyped_read_done_{uid}" self.indent_string
        f".Ltyped_read_indirect_{uid}:" self.line_string
        "pushq %rax" self.indent
        "pushq %rdx" self.indent
        "movq %rdx, %rdi" self.indent
        "typed_read_alloc_done" "heap_alloc" self.emit_call_via_return_stack
        "popq %r10" self.indent
        "popq %rcx" self.indent
        "popq %rsi" self.indent
        "movq %r10, %rdi" self.indent
        "rep movsb" self.indent
        "movq %r10, %rax" self.indent
        f".Ltyped_read_done_{uid}:" self.line_string
        "pushq %rax" self.indent
    }

    pub fn emit_typed_write self:mut$Emitter {
        self.emit_uid = uid
        "popq %r8" self.indent
        "popq %rcx" self.indent
        "popq %rdi" self.indent
        "popq %rsi" self.indent
        f"cmpq ${common::VALUE_REPR_INDIRECT}, %r8" self.indent_string
        f"je .Ltyped_write_copy_{uid}" self.indent_string
        "cmpq $1, %rcx" self.indent
        f"je .Ltyped_write_1_{uid}" self.indent_string
        "cmpq $2, %rcx" self.indent
        f"je .Ltyped_write_2_{uid}" self.indent_string
        "cmpq $4, %rcx" self.indent
        f"je .Ltyped_write_4_{uid}" self.indent_string
        "movq %rsi, (%rdi)" self.indent
        f"jmp .Ltyped_write_done_{uid}" self.indent_string
        f".Ltyped_write_1_{uid}:" self.line_string
        "movb %sil, (%rdi)" self.indent
        f"jmp .Ltyped_write_done_{uid}" self.indent_string
        f".Ltyped_write_2_{uid}:" self.line_string
        "movw %si, (%rdi)" self.indent
        f"jmp .Ltyped_write_done_{uid}" self.indent_string
        f".Ltyped_write_4_{uid}:" self.line_string
        "movl %esi, (%rdi)" self.indent
        f"jmp .Ltyped_write_done_{uid}" self.indent_string
        f".Ltyped_write_copy_{uid}:" self.line_string
        "movq %rsi, %rdx" self.indent
        "rep movsb" self.indent
        "pushq %rdx" self.indent
        self.emit_heap_free_if_allocated
        f".Ltyped_write_done_{uid}:" self.line_string
    }

    pub fn emit_heap_free_if_allocated self:mut$Emitter {
        self.emit_uid = uid
        "popq %rdi" self.indent
        "movq heap_chunks(%rip), %rax" self.indent
        f".Lheap_free_if_allocated_search_{uid}:" self.line_string
        "testq %rax, %rax" self.indent
        f"jz .Lheap_free_if_allocated_done_{uid}" self.indent_string
        f"leaq {HEAP_CHUNK_HEADER_SIZE}(%rax), %rcx" self.indent_string
        "cmpq %rcx, %rdi" self.indent
        f"jb .Lheap_free_if_allocated_next_{uid}" self.indent_string
        "movq 8(%rax), %rcx" self.indent
        "cmpq %rcx, %rdi" self.indent
        f"jb .Lheap_free_if_allocated_found_{uid}" self.indent_string
        f".Lheap_free_if_allocated_next_{uid}:" self.line_string
        "movq (%rax), %rax" self.indent
        f"jmp .Lheap_free_if_allocated_search_{uid}" self.indent_string
        f".Lheap_free_if_allocated_found_{uid}:" self.line_string
        "heap_free_if_allocated_return" "heap_free" self.emit_call_via_return_stack
        f".Lheap_free_if_allocated_done_{uid}:" self.line_string
    }

    # ============================================================================
    # Emit stack operations
    # ============================================================================

    pub fn emit_stack_ops self:mut$Emitter inst:$common::InstValue {
        inst match
            common::InstValue::Push(value) => {
                if
                    INT32_MIN value >=
                    INT32_MAX value <= &&
                then
                    f"pushq ${value}" self.indent_string
                else
                    f"movabsq ${value}, %rax" self.indent_string
                    "pushq %rax" self.indent
                fi
            }
            common::InstValue::PushFloat32(value) => {
                "jmp 1f" self.indent
                ".align 4" self.line
                "0:" self.line
                f".float {value}" self.line_string
                "1:" self.line
                "movl 0b(%rip), %eax" self.indent
                "pushq %rax" self.indent
            }
            common::InstValue::PushFloat64(value) => {
                "jmp 1f" self.indent
                ".align 8" self.line
                "0:" self.line
                f".double {value}" self.line_string
                "1:" self.line
                "pushq 0b(%rip)" self.indent
            }
            common::InstValue::PushStr(str_index) => {
                f"leaq str_{str_index}(%rip), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            common::InstValue::PushStaticArray(array_index) => {
                array_index self
                    .program
                    .static_arrays
                    .get common::StaticArray::elements.length 8 * = byte_count
                if 0 byte_count == then
                    1 = byte_count: u64
                fi
                f"movq ${byte_count}, %rdi" self.indent_string
                "static_array_alloc_done" "heap_alloc" self.emit_call_via_return_stack
                "movq (%rsp), %rdi" self.indent
                f"leaq static_array_{array_index}(%rip), %rsi" self.indent_string
                f"movq ${byte_count}, %rcx" self.indent_string
                "rep movsb" self.indent
            }
            common::InstValue::PushChar(char_value) => f"pushq ${char_value}" self.indent_string
            common::InstValue::Drop => "addq $8, %rsp" self.indent
            common::InstValue::Dup => "pushq (%rsp)" self.indent
            common::InstValue::Swap => {
                "popq %rax" self.indent
                "popq %rbx" self.indent
                "pushq %rax" self.indent
                "pushq %rbx" self.indent
            }
            common::InstValue::Over => "pushq 8(%rsp)" self.indent
            common::InstValue::Rot => {
                "popq %rax" self.indent
                "popq %rbx" self.indent
                "popq %rcx" self.indent
                "pushq %rbx" self.indent
                "pushq %rax" self.indent
                "pushq %rcx" self.indent
            }
            _ => {
                "Internal error: emit_stack_ops called with non-stack InstValue\n" std::eprint
                1 std::exit
            }
        end
    }

    # ============================================================================
    # Emit arithmetic / bitwise / boolean / comparison operations
    # ============================================================================

    pub fn emit_arithmetic self:mut$Emitter inst:$common::InstValue {
        inst match
            common::InstValue::Add => {
                "popq %rax" self.indent
                "addq %rax, (%rsp)" self.indent
            }
            common::InstValue::Sub => {
                "popq %rax" self.indent
                "subq %rax, (%rsp)" self.indent
            }
            common::InstValue::Mul => {
                "popq %rax" self.indent
                "imulq (%rsp), %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            common::InstValue::Div => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "cqto" self.indent
                "idivq %rbx" self.indent
                "pushq %rax" self.indent
            }
            common::InstValue::Mod => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "cqto" self.indent
                "idivq %rbx" self.indent
                "pushq %rdx" self.indent
            }
            common::InstValue::UDiv => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "xorq %rdx, %rdx" self.indent
                "divq %rbx" self.indent
                "pushq %rax" self.indent
            }
            common::InstValue::UMod => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "xorq %rdx, %rdx" self.indent
                "divq %rbx" self.indent
                "pushq %rdx" self.indent
            }
            common::InstValue::Shl => {
                "popq %rcx" self.indent
                "shlq %cl, (%rsp)" self.indent
            }
            common::InstValue::Shr => {
                "popq %rcx" self.indent
                "sarq %cl, (%rsp)" self.indent
            }
            common::InstValue::UShr => {
                "popq %rcx" self.indent
                "shrq %cl, (%rsp)" self.indent
            }
            common::InstValue::BitAnd => {
                "popq %rax" self.indent
                "andq %rax, (%rsp)" self.indent
            }
            common::InstValue::BitOr => {
                "popq %rax" self.indent
                "orq %rax, (%rsp)" self.indent
            }
            common::InstValue::BitXor => {
                "popq %rax" self.indent
                "xorq %rax, (%rsp)" self.indent
            }
            common::InstValue::BitNot => "notq (%rsp)" self.indent
            common::InstValue::And => {
                "popq %rax" self.indent
                "testq %rax, %rax" self.indent
                "setne %al" self.indent
                "cmpq $0, (%rsp)" self.indent
                "setne %cl" self.indent
                "andb %cl, %al" self.indent
                "movzbq %al, %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            common::InstValue::Or => {
                "popq %rax" self.indent
                "orq %rax, (%rsp)" self.indent
                "setne %al" self.indent
                "movzbq %al, %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            common::InstValue::Not => {
                "cmpq $0, (%rsp)" self.indent
                "sete %al" self.indent
                "movzbq %al, %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            common::InstValue::Eq => "sete" self.emit_comparison
            common::InstValue::Ne => "setne" self.emit_comparison
            common::InstValue::Lt => "setl" self.emit_comparison
            common::InstValue::Le => "setle" self.emit_comparison
            common::InstValue::Gt => "setg" self.emit_comparison
            common::InstValue::Ge => "setge" self.emit_comparison
            common::InstValue::Ult => "setb" self.emit_comparison
            common::InstValue::Ule => "setbe" self.emit_comparison
            common::InstValue::Ugt => "seta" self.emit_comparison
            common::InstValue::Uge => "setae" self.emit_comparison
            common::InstValue::NormalizeInt(builtin) => {
                builtin match
                    common::BuiltinType::I8 => "movsbq (%rsp), %rax" self.indent
                    common::BuiltinType::I16 => "movswq (%rsp), %rax" self.indent
                    common::BuiltinType::I32 => "movslq (%rsp), %rax" self.indent
                    common::BuiltinType::U8 => "movzbq (%rsp), %rax" self.indent
                    common::BuiltinType::U16 => "movzwq (%rsp), %rax" self.indent
                    common::BuiltinType::U32 => "movl (%rsp), %eax" self.indent
                    _ => return
                end
                "movq %rax, (%rsp)" self.indent
            }
            common::InstValue::FloatAdd32 => "addss" self.emit_float_binary
            common::InstValue::FloatAdd64 => "addsd" self.emit_float_binary
            common::InstValue::FloatSub32 => "subss" self.emit_float_binary
            common::InstValue::FloatSub64 => "subsd" self.emit_float_binary
            common::InstValue::FloatMul32 => "mulss" self.emit_float_binary
            common::InstValue::FloatMul64 => "mulsd" self.emit_float_binary
            common::InstValue::FloatDiv32 => "divss" self.emit_float_binary
            common::InstValue::FloatDiv64 => "divsd" self.emit_float_binary
            common::InstValue::FloatEq32 => "ucomiss" "sete" self.emit_float_comparison
            common::InstValue::FloatEq64 => "ucomisd" "sete" self.emit_float_comparison
            common::InstValue::FloatNe32 => "ucomiss" "setne" self.emit_float_comparison
            common::InstValue::FloatNe64 => "ucomisd" "setne" self.emit_float_comparison
            common::InstValue::FloatLt32 => "ucomiss" "setb" self.emit_float_comparison
            common::InstValue::FloatLt64 => "ucomisd" "setb" self.emit_float_comparison
            common::InstValue::FloatLe32 => "ucomiss" "setbe" self.emit_float_comparison
            common::InstValue::FloatLe64 => "ucomisd" "setbe" self.emit_float_comparison
            common::InstValue::FloatGt32 => "ucomiss" "seta" self.emit_float_comparison
            common::InstValue::FloatGt64 => "ucomisd" "seta" self.emit_float_comparison
            common::InstValue::FloatGe32 => "ucomiss" "setae" self.emit_float_comparison
            common::InstValue::FloatGe64 => "ucomisd" "setae" self.emit_float_comparison
            common::InstValue::CheckedAdd(builtin) => "arithmetic_error" builtin self.emit_checked_add
            common::InstValue::CheckedSub(builtin) => "arithmetic_error" builtin self.emit_checked_sub
            common::InstValue::CheckedMul(builtin) => "arithmetic_error" builtin self.emit_checked_mul
            common::InstValue::CheckedDiv(builtin) => "arithmetic_error" builtin false self.emit_checked_division
            common::InstValue::CheckedMod(builtin) => "arithmetic_error" builtin true self.emit_checked_division
            common::InstValue::CheckedShl(builtin) => builtin false self.emit_checked_shift
            common::InstValue::CheckedShr(builtin) => builtin true self.emit_checked_shift
            common::InstValue::NumericConvert(conversion) => conversion self.emit_numeric_conversion
            common::InstValue::NumericTry(numeric_try) => numeric_try self.emit_numeric_try
            common::InstValue::IntegerTry(integer_try) => integer_try self.emit_integer_try
            common::InstValue::FloatRound(rounding) => rounding self.emit_float_round
            common::InstValue::FloatFromDecimal => self.emit_float_from_decimal
            common::InstValue::FloatSignificand => self.emit_float_significand
            _ => {
                "Internal error: emit_arithmetic called with non-arithmetic InstValue\n" std::eprint
                1 std::exit
            }
        end
    }

    pub fn emit_checked_range self:mut$Emitter builtin:mut$common::BuiltinType failure:$str {
        builtin match
            common::BuiltinType::I8 => "movsbq (%rsp), %rax" self.indent
            common::BuiltinType::I16 => "movswq (%rsp), %rax" self.indent
            common::BuiltinType::I32 => "movslq (%rsp), %rax" self.indent
            common::BuiltinType::U8 => "movzbq (%rsp), %rax" self.indent
            common::BuiltinType::U16 => "movzwq (%rsp), %rax" self.indent
            common::BuiltinType::U32 => "movl (%rsp), %eax" self.indent
            _ => return
        end
        "cmpq %rax, (%rsp)" self.indent
        f"jne {failure}" self.indent_string
    }

    pub fn emit_checked_add self:mut$Emitter builtin:mut$common::BuiltinType failure:$str {
        "popq %rax" self.indent
        "addq %rax, (%rsp)" self.indent
        if 64 builtin.bit_width == then
            if builtin.is_unsigned then f"jc {failure}" else f"jo {failure}" fi self.indent_string
        else
            failure builtin self.emit_checked_range
        fi
    }

    pub fn emit_checked_sub self:mut$Emitter builtin:mut$common::BuiltinType failure:$str {
        "popq %rax" self.indent
        "subq %rax, (%rsp)" self.indent
        if 64 builtin.bit_width == then
            if builtin.is_unsigned then f"jc {failure}" else f"jo {failure}" fi self.indent_string
        else
            failure builtin self.emit_checked_range
        fi
    }

    pub fn emit_checked_mul self:mut$Emitter builtin:mut$common::BuiltinType failure:$str {
        "popq %rax" self.indent
        if builtin common::BuiltinType::U64 == then
            "mulq (%rsp)" self.indent
            "testq %rdx, %rdx" self.indent
            f"jnz {failure}" self.indent_string
        else
            "imulq (%rsp), %rax" self.indent
            if builtin common::BuiltinType::I64 == then
                f"jo {failure}" self.indent_string
            fi
        fi
        "movq %rax, (%rsp)" self.indent
        if 64 builtin.bit_width != then
            failure builtin self.emit_checked_range
        fi
    }

    pub fn emit_checked_division
        self:mut$Emitter
        remainder:bool
        builtin:mut$common::BuiltinType
        failure:$str
    {
        "popq %rbx" self.indent
        "testq %rbx, %rbx" self.indent
        f"jz {failure}" self.indent_string
        "movq (%rsp), %rax" self.indent
        if builtin.is_unsigned then
            "xorq %rdx, %rdx" self.indent
            "divq %rbx" self.indent
        else
            builtin copy common::Type::Builtin = integer_type
            integer_type.get_integer_min = minimum
            self.emit_uid = uid
            "cmpq $-1, %rbx" self.indent
            f"jne .Ldiv_ready_{uid}" self.indent_string
            f"movabsq ${minimum}, %rcx" self.indent_string
            "cmpq %rcx, %rax" self.indent
            f"je {failure}" self.indent_string
            f".Ldiv_ready_{uid}:" self.line_string
            "cqto" self.indent
            "idivq %rbx" self.indent
        fi
        if remainder then "movq %rdx, (%rsp)" else "movq %rax, (%rsp)" fi self.indent
    }

    pub fn emit_checked_shift self:mut$Emitter right:bool builtin:mut$common::BuiltinType {
        "popq %rcx" self.indent
        f"cmpq ${builtin.bit_width}, %rcx" self.indent_string
        "jae arithmetic_error" self.indent
        if right then
            if builtin.is_unsigned then "shrq %cl, (%rsp)" else "sarq %cl, (%rsp)" fi self.indent
        else
            "shlq %cl, (%rsp)" self.indent
        fi
    }

    pub fn emit_normalize_numeric self:mut$Emitter builtin:mut$common::BuiltinType {
        builtin match
            common::BuiltinType::I8 => "movsbq (%rsp), %rax" self.indent
            common::BuiltinType::I16 => "movswq (%rsp), %rax" self.indent
            common::BuiltinType::I32 => "movslq (%rsp), %rax" self.indent
            common::BuiltinType::U8 => "movzbq (%rsp), %rax" self.indent
            common::BuiltinType::U16 => "movzwq (%rsp), %rax" self.indent
            common::BuiltinType::U32 => "movl (%rsp), %eax" self.indent
            _ => return
        end
        "movq %rax, (%rsp)" self.indent
    }

    pub fn emit_integer_to_float
        self:mut$Emitter
        source:mut$common::BuiltinType
        target:mut$common::BuiltinType
    {
        self.emit_uid = uid
        "movq (%rsp), %rax" self.indent
        if source common::BuiltinType::U64 == then
            "testq %rax, %rax" self.indent
            f"jns .Luint_float_ready_{uid}" self.indent_string
            "movq %rax, %rcx" self.indent
            "andq $1, %rcx" self.indent
            "shrq $1, %rax" self.indent
            "orq %rcx, %rax" self.indent
            if target common::BuiltinType::F32 == then
                "cvtsi2ssq %rax, %xmm0" self.indent
                "addss %xmm0, %xmm0" self.indent
            else
                "cvtsi2sdq %rax, %xmm0" self.indent
                "addsd %xmm0, %xmm0" self.indent
            fi
            f"jmp .Luint_float_done_{uid}" self.indent_string
            f".Luint_float_ready_{uid}:" self.line_string
        fi
        if target common::BuiltinType::F32 == then
            "cvtsi2ssq %rax, %xmm0" self.indent
        else
            "cvtsi2sdq %rax, %xmm0" self.indent
        fi
        f".Luint_float_done_{uid}:" self.line_string
        if target common::BuiltinType::F32 == then
            "movd %xmm0, %eax" self.indent
            "movq %rax, (%rsp)" self.indent
        else
            "movq %xmm0, (%rsp)" self.indent
        fi
    }

    pub fn emit_float_constant
        self:mut$Emitter
        value:str
        source:mut$common::BuiltinType
        register:str
    {
        self.emit_uid = uid
        f"jmp .Lfloat_constant_done_{uid}" self.indent_string
        if source common::BuiltinType::F32 == then ".align 4" else ".align 8" fi self.line
        f".Lfloat_constant_{uid}:" self.line_string
        if source common::BuiltinType::F32 == then
            f".float {value}"
        else
            f".double {value}"
        fi self.line_string
        f".Lfloat_constant_done_{uid}:" self.line_string
        if source common::BuiltinType::F32 == then
            f"movss .Lfloat_constant_{uid}(%rip), {register}" self.indent_string
        else
            f"movsd .Lfloat_constant_{uid}(%rip), {register}" self.indent_string
        fi
    }

    pub fn emit_truncate_to_u64 self:mut$Emitter source:mut$common::BuiltinType failure:$str {
        self.emit_uid = uid
        if source common::BuiltinType::F32 == then
            "xorps %xmm1, %xmm1" self.indent
            "ucomiss %xmm1, %xmm0" self.indent
        else
            "xorpd %xmm1, %xmm1" self.indent
            "ucomisd %xmm1, %xmm0" self.indent
        fi
        f"jp {failure}" self.indent_string
        f"jb {failure}" self.indent_string
        "%xmm1" source "18446744073709551616.0" self.emit_float_constant
        if source common::BuiltinType::F32 == then
            "ucomiss %xmm1, %xmm0" self.indent
        else
            "ucomisd %xmm1, %xmm0" self.indent
        fi
        f"jae {failure}" self.indent_string
        "%xmm1" source "9223372036854775808.0" self.emit_float_constant
        if source common::BuiltinType::F32 == then
            "ucomiss %xmm1, %xmm0" self.indent
            f"jb .Ltrunc_u64_low_{uid}" self.indent_string
            "subss %xmm1, %xmm0" self.indent
            "cvttss2siq %xmm0, %rax" self.indent
        else
            "ucomisd %xmm1, %xmm0" self.indent
            f"jb .Ltrunc_u64_low_{uid}" self.indent_string
            "subsd %xmm1, %xmm0" self.indent
            "cvttsd2siq %xmm0, %rax" self.indent
        fi
        "btc $63, %rax" self.indent
        f"jmp .Ltrunc_u64_done_{uid}" self.indent_string
        f".Ltrunc_u64_low_{uid}:" self.line_string
        if source common::BuiltinType::F32 == then
            "cvttss2siq %xmm0, %rax" self.indent
        else
            "cvttsd2siq %xmm0, %rax" self.indent
        fi
        f".Ltrunc_u64_done_{uid}:" self.line_string
        "movq %rax, (%rsp)" self.indent
    }

    pub fn emit_float_to_integer
        self:mut$Emitter
        source:mut$common::BuiltinType
        target:mut$common::BuiltinType
        failure:$str
    {
        if source common::BuiltinType::F32 == then
            "movss (%rsp), %xmm0" self.indent
        else
            "movsd (%rsp), %xmm0" self.indent
        fi
        if target common::BuiltinType::U64 == then
            failure source self.emit_truncate_to_u64 return
        fi
        if source common::BuiltinType::F32 == then
            "cvttss2siq %xmm0, %rax" self.indent
        else
            "cvttsd2siq %xmm0, %rax" self.indent
        fi
        "movq %rax, (%rsp)" self.indent
        if target common::BuiltinType::I64 == then
            self.emit_uid = uid
            "movabsq $-9223372036854775808, %rcx" self.indent
            "cmpq %rcx, %rax" self.indent
            f"jne .Ltrunc_i64_done_{uid}" self.indent_string
            if source common::BuiltinType::F32 == then
                "cvtsi2ssq %rax, %xmm1" self.indent
                "ucomiss %xmm1, %xmm0" self.indent
            else
                "cvtsi2sdq %rax, %xmm1" self.indent
                "ucomisd %xmm1, %xmm0" self.indent
            fi
            f"jp {failure}" self.indent_string
            f"jne {failure}" self.indent_string
            f".Ltrunc_i64_done_{uid}:" self.line_string
        else
            failure target self.emit_checked_range
            target self.emit_normalize_numeric
        fi
    }

    pub fn emit_numeric_conversion self:mut$Emitter conversion:$common::NumericConversion {
        if
            conversion.kind common::NumericConversionKind::FromBits ==
            conversion.kind common::NumericConversionKind::ToBits == ||
        then
            return
        fi
        if conversion.source.is_integer conversion.target.is_integer && then
            conversion.target self.emit_normalize_numeric
            return
        fi
        if conversion.source.is_integer conversion.target.is_float && then
            conversion.target conversion.source self.emit_integer_to_float
            return
        fi
        if
            conversion.source common::BuiltinType::F32 ==
            conversion.target common::BuiltinType::F64 == &&
        then
            "movss (%rsp), %xmm0" self.indent
            "cvtss2sd %xmm0, %xmm0" self.indent
            "movq %xmm0, (%rsp)" self.indent
            return
        fi
        if
            conversion.source common::BuiltinType::F64 ==
            conversion.target common::BuiltinType::F32 == &&
        then
            "movsd (%rsp), %xmm0" self.indent
            "cvtsd2ss %xmm0, %xmm0" self.indent
            "movd %xmm0, %eax" self.indent
            "movq %rax, (%rsp)" self.indent
            return
        fi
        if conversion.source.is_float conversion.target.is_integer && then
            "arithmetic_error" conversion.target conversion.source self.emit_float_to_integer
        fi
    }

    pub fn emit_numeric_try self:mut$Emitter numeric_try:$common::NumericTry {
        if numeric_try.source common::Type::Builtin(source) is then
            numeric_try.target = target
            self.emit_uid = uid
            f".Lnumeric_try_fail_{uid}" = failure
            f".Lnumeric_try_done_{uid}" = done_label
            "movq (%rsp), %r10" self.indent

            if source.is_integer target.is_integer && then
                target self.emit_normalize_numeric
                if source.is_unsigned ! target.is_unsigned && then
                    "testq %r10, %r10" self.indent
                    f"js {failure}" self.indent_string
                elif source.is_unsigned target.is_unsigned ! && then
                    "cmpq $0, (%rsp)" self.indent
                    f"jl {failure}" self.indent_string
                fi
                "cmpq %r10, (%rsp)" self.indent
                f"jne {failure}" self.indent_string
            elif source.is_integer target.is_float && then
                target source self.emit_integer_to_float
                if target common::BuiltinType::F32 == then
                    "movss (%rsp), %xmm0" self.indent
                else
                    "movsd (%rsp), %xmm0" self.indent
                fi
                if source common::BuiltinType::U64 == then
                    "%xmm1" target "18446744073709551616.0" self.emit_float_constant
                    if target common::BuiltinType::F32 == then
                        "ucomiss %xmm1, %xmm0" self.indent
                    else
                        "ucomisd %xmm1, %xmm0" self.indent
                    fi
                    f"jae {failure}" self.indent_string
                    "%xmm1" target "9223372036854775808.0" self.emit_float_constant
                    if target common::BuiltinType::F32 == then
                        "ucomiss %xmm1, %xmm0" self.indent
                        f"jb .Lnumeric_try_uint_low_{uid}" self.indent_string
                        "subss %xmm1, %xmm0" self.indent
                        "cvttss2siq %xmm0, %rax" self.indent
                    else
                        "ucomisd %xmm1, %xmm0" self.indent
                        f"jb .Lnumeric_try_uint_low_{uid}" self.indent_string
                        "subsd %xmm1, %xmm0" self.indent
                        "cvttsd2siq %xmm0, %rax" self.indent
                    fi
                    "btc $63, %rax" self.indent
                    f"jmp .Lnumeric_try_uint_done_{uid}" self.indent_string
                    f".Lnumeric_try_uint_low_{uid}:" self.line_string
                    if target common::BuiltinType::F32 == then
                        "cvttss2siq %xmm0, %rax" self.indent
                    else
                        "cvttsd2siq %xmm0, %rax" self.indent
                    fi
                    f".Lnumeric_try_uint_done_{uid}:" self.line_string
                elif target common::BuiltinType::F32 == then
                    "cvttss2siq %xmm0, %rax" self.indent
                else
                    "cvttsd2siq %xmm0, %rax" self.indent
                fi
                "cmpq %r10, %rax" self.indent
                f"jne {failure}" self.indent_string
            elif source.is_float target.is_integer && then
                failure.as_str target source self.emit_float_to_integer
                "movq (%rsp), %r11" self.indent
                source target self.emit_integer_to_float
                "movq %r10, %xmm1" self.indent
                if source common::BuiltinType::F32 == then
                    "movss (%rsp), %xmm0" self.indent
                    "ucomiss %xmm1, %xmm0" self.indent
                else
                    "movsd (%rsp), %xmm0" self.indent
                    "ucomisd %xmm1, %xmm0" self.indent
                fi
                f"jp {failure}" self.indent_string
                f"jne {failure}" self.indent_string
                "movq %r11, (%rsp)" self.indent
            elif source.is_float target.is_float && then
                false = check_narrowing
                if source target != then
                    source common::BuiltinType::F64 == target common::BuiltinType::F32 == && = check_narrowing
                    target source common::NumericConversionKind::Rounded common::NumericConversion = conversion
                    conversion self.emit_numeric_conversion
                fi
                if check_narrowing then
                    "movq (%rsp), %r11" self.indent
                    common::BuiltinType::F64 common::BuiltinType::F32 common::NumericConversionKind::Exact common::NumericConversion
                    self.emit_numeric_conversion
                    "movq %r10, %xmm1" self.indent
                    "movsd (%rsp), %xmm0" self.indent
                    "ucomisd %xmm1, %xmm0" self.indent
                    f"jp {failure}" self.indent_string
                    f"jne {failure}" self.indent_string
                    "movq %r11, (%rsp)" self.indent
                fi
            else
                f"jmp {failure}" self.indent_string
            fi
            "movq $1, %rax" self.indent
            f"jmp {done_label}" self.indent_string
            f"{failure}:" self.line_string
            "movq $0, (%rsp)" self.indent
            "xorq %rax, %rax" self.indent
            f"{done_label}:" self.line_string
            "pushq %rax" self.indent
        fi
    }

    pub fn emit_float_binary self:mut$Emitter instruction:str {
        "movq (%rsp), %xmm0" self.indent
        "addq $8, %rsp" self.indent
        "movq (%rsp), %xmm1" self.indent
        f"{instruction} %xmm0, %xmm1" self.indent_string
        "movq %xmm1, (%rsp)" self.indent
    }

    pub fn emit_float_comparison self:mut$Emitter setcc:str instruction:str {
        "movq (%rsp), %xmm0" self.indent
        "addq $8, %rsp" self.indent
        f"{instruction} (%rsp), %xmm0" self.indent_string
        f"{setcc} %al" self.indent_string
        if "setne" setcc == then
            "setp %cl" self.indent
            "orb %cl, %al" self.indent
        else
            "setnp %cl" self.indent
            "andb %cl, %al" self.indent
        fi
        "movzbq %al, %rax" self.indent
        "movq %rax, (%rsp)" self.indent
    }

    pub fn emit_float_round self:mut$Emitter rounding:$common::FloatRound {
        rounding.method.as_str match
            "__float_floor" => 1
            "__float_ceil" => 2
            "__float_trunc" => 3
            _ => 0
        end = mode
        if rounding.target common::BuiltinType::F32 == then
            "movss (%rsp), %xmm0" self.indent
            f"roundss ${mode}, %xmm0, %xmm0" self.indent_string
            "movd %xmm0, %eax" self.indent
            "movq %rax, (%rsp)" self.indent
        else
            "movsd (%rsp), %xmm0" self.indent
            f"roundsd ${mode}, %xmm0, %xmm0" self.indent_string
            "movq %xmm0, (%rsp)" self.indent
        fi
    }

    pub fn emit_integer_try self:mut$Emitter integer_try:$common::IntegerTry {
        self.emit_uid = uid
        f".Linteger_try_fail_{uid}" = failure
        f".Linteger_try_done_{uid}" = done_label
        integer_try.kind match
            common::IntegerTryKind::Add => {
                failure.as_str integer_try.target self.emit_checked_add
            }
            common::IntegerTryKind::Sub => {
                failure.as_str integer_try.target self.emit_checked_sub
            }
            common::IntegerTryKind::Mul => {
                failure.as_str integer_try.target self.emit_checked_mul
            }
            common::IntegerTryKind::Div => {
                failure.as_str integer_try.target false self.emit_checked_division
            }
            common::IntegerTryKind::Mod => {
                failure.as_str integer_try.target true self.emit_checked_division
            }
        end
        integer_try.target self.emit_normalize_numeric
        "pushq $1" self.indent
        f"jmp {done_label}" self.indent_string
        f"{failure}:" self.line_string
        "movq $0, (%rsp)" self.indent
        "pushq $0" self.indent
        f"{done_label}:" self.line_string
    }

    pub fn emit_float_from_decimal self:mut$Emitter {
        self.emit_uid = uid
        "fildq (%rsp)" self.indent
        "addq $8, %rsp" self.indent
        "popq %rcx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jz .Ldecimal_float_done_{uid}" self.indent_string
        "xorq %rdx, %rdx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jns .Ldecimal_float_abs_ready_{uid}" self.indent_string
        "negq %rcx" self.indent
        "movq $1, %rdx" self.indent
        f".Ldecimal_float_abs_ready_{uid}:" self.line_string
        "fld1" self.indent
        "fildl float_decimal_ten(%rip)" self.indent
        f".Ldecimal_float_power_loop_{uid}:" self.line_string
        "testq $1, %rcx" self.indent
        f"jz .Ldecimal_float_power_skip_{uid}" self.indent_string
        "fmul %st(0), %st(1)" self.indent
        f".Ldecimal_float_power_skip_{uid}:" self.line_string
        "shrq $1, %rcx" self.indent
        f"jz .Ldecimal_float_power_done_{uid}" self.indent_string
        "fmul %st(0), %st(0)" self.indent
        f"jmp .Ldecimal_float_power_loop_{uid}" self.indent_string
        f".Ldecimal_float_power_done_{uid}:" self.line_string
        "fstp %st(0)" self.indent
        "testq %rdx, %rdx" self.indent
        f"jnz .Ldecimal_float_divide_{uid}" self.indent_string
        "fmulp %st(0), %st(1)" self.indent
        f"jmp .Ldecimal_float_done_{uid}" self.indent_string
        f".Ldecimal_float_divide_{uid}:" self.line_string
        "fdivrp %st(0), %st(1)" self.indent
        f".Ldecimal_float_done_{uid}:" self.line_string
        "subq $8, %rsp" self.indent
        "fstpl (%rsp)" self.indent
    }

    pub fn emit_float_significand self:mut$Emitter {
        self.emit_uid = uid
        "fldl (%rsp)" self.indent
        "addq $8, %rsp" self.indent
        "popq %rcx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jz .Lfloat_significand_done_{uid}" self.indent_string
        "xorq %rdx, %rdx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jns .Lfloat_significand_abs_ready_{uid}" self.indent_string
        "negq %rcx" self.indent
        "movq $1, %rdx" self.indent
        f".Lfloat_significand_abs_ready_{uid}:" self.line_string
        "fld1" self.indent
        "fildl float_decimal_ten(%rip)" self.indent
        f".Lfloat_significand_power_loop_{uid}:" self.line_string
        "testq $1, %rcx" self.indent
        f"jz .Lfloat_significand_power_skip_{uid}" self.indent_string
        "fmul %st(0), %st(1)" self.indent
        f".Lfloat_significand_power_skip_{uid}:" self.line_string
        "shrq $1, %rcx" self.indent
        f"jz .Lfloat_significand_power_done_{uid}" self.indent_string
        "fmul %st(0), %st(0)" self.indent
        f"jmp .Lfloat_significand_power_loop_{uid}" self.indent_string
        f".Lfloat_significand_power_done_{uid}:" self.line_string
        "fstp %st(0)" self.indent
        "testq %rdx, %rdx" self.indent
        f"jnz .Lfloat_significand_divide_{uid}" self.indent_string
        "fmulp %st(0), %st(1)" self.indent
        f"jmp .Lfloat_significand_done_{uid}" self.indent_string
        f".Lfloat_significand_divide_{uid}:" self.line_string
        "fdivrp %st(0), %st(1)" self.indent
        f".Lfloat_significand_done_{uid}:" self.line_string
        "frndint" self.indent
        "subq $8, %rsp" self.indent
        "fistpq (%rsp)" self.indent
    }

    # ============================================================================
    # Emit control flow / variable / function operations
    # ============================================================================

    pub fn emit_control_flow self:mut$Emitter inst:$common::InstValue is_global:bool {
        inst match
            common::InstValue::Label(label) => f".L{label}:" self.line_string
            common::InstValue::Jump(label) => f"jmp .L{label}" self.indent_string
            common::InstValue::JumpNe(label) => {
                "popq %rax" self.indent
                "testq %rax, %rax" self.indent
                f"jz .L{label}" self.indent_string
            }
            common::InstValue::GlobalsInit => {
                # Nothing needed, BSS handles it
            }
            common::InstValue::GlobalGet(global_index) => {
                global_index common::WORD_SIZE * = offset
                f"movq globals+{offset}(%rip), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            common::InstValue::GlobalSet(global_index) => {
                global_index common::WORD_SIZE * = offset
                "popq %rax" self.indent
                f"movq %rax, globals+{offset}(%rip)" self.indent_string
            }
            common::InstValue::LocalsInit(count) => {
                if 0 count != then
                    "movq %r14, %rdi" self.indent
                    f"movq ${count}, %rcx" self.indent_string
                    "xorq %rax, %rax" self.indent
                    "rep stosq" self.indent
                    f"addq ${count common::WORD_SIZE *}, %r14" self.indent_string
                fi
            }
            common::InstValue::LocalsUninit(count) => {
                if 0 count != then
                    f"subq ${count common::WORD_SIZE *}, %r14" self.indent_string
                fi
            }
            common::InstValue::LocalAddress(local_index) => {
                local_index 1 + common::WORD_SIZE * = offset
                f"leaq -{offset}(%r14), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            common::InstValue::LocalGet(local_index) => {
                local_index 1 + common::WORD_SIZE * = offset
                f"movq -{offset}(%r14), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            common::InstValue::LocalSet(local_index) => {
                local_index 1 + common::WORD_SIZE * = offset
                "popq %rax" self.indent
                f"movq %rax, -{offset}(%r14)" self.indent_string
            }
            common::InstValue::ConstantLoad(constant_index) => {
                constant_index common::WORD_SIZE * = offset
                f"movq constants+{offset}(%rip), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            common::InstValue::ConstantStore(constant_index) => {
                constant_index common::WORD_SIZE * = offset
                "popq %rax" self.indent
                f"movq %rax, constants+{offset}(%rip)" self.indent_string
            }
            common::InstValue::FnCall(fn_name) => {
                fn_name.as_str sanitize_name = fn_label
                f"fn_{fn_label}" = jump_target
                "ret" jump_target.as_str self.emit_call_via_return_stack
            }
            common::InstValue::ExternCall(call) => call self.emit_extern_call
            common::InstValue::FnExec => {
                self.emit_uid = uid
                # Save the caller's active closure env on the env stack and switch
                # current_env to the popped closure record so its body can access
                # captured values via InstCaptureLoad. After the callee returns,
                # restore the previous env.
                "popq %rax" self.indent
                "movq current_env(%rip), %rbx" self.indent
                "movq env_sp(%rip), %rcx" self.indent
                f"cmpq ${RETURN_STACK_SIZE}, %rcx" self.indent_string
                "jge env_stack_overflow" self.indent
                "movq %rbx, env_stack(%rcx)" self.indent
                "addq $8, %rcx" self.indent
                "movq %rcx, env_sp(%rip)" self.indent
                "movq %rax, current_env(%rip)" self.indent
                f"leaq .Lret_{uid}(%rip), %rcx" self.indent_string
                "movq %rcx, (%r14)" self.indent
                "addq $8, %r14" self.indent
                "movq (%rax), %rax" self.indent
                "jmpq *%rax" self.indent
                f".Lret_{uid}:" self.line_string
                "movq env_sp(%rip), %rcx" self.indent
                "subq $8, %rcx" self.indent
                "movq %rcx, env_sp(%rip)" self.indent
                "movq env_stack(%rcx), %rax" self.indent
                "movq %rax, current_env(%rip)" self.indent
            }
            common::InstValue::DropFn(fn_name) => {
                fn_name.as_str sanitize_name = fn_label
                f"leaq fn_{fn_label}(%rip), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            common::InstValue::CaptureLoad(capture_index) => {
                capture_index 2 * 2 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq {offset}(%rax), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            common::InstValue::CaptureSet(capture_index) => {
                capture_index 2 * 2 + common::WORD_SIZE * = offset
                "popq %rax" self.indent
                "movq current_env(%rip), %rbx" self.indent
                f"movq %rax, {offset}(%rbx)" self.indent_string
            }
            common::InstValue::CaptureFlagLoad(capture_index) => {
                capture_index 2 * 3 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq {offset}(%rax), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            common::InstValue::CaptureFlagClear(capture_index) => {
                capture_index 2 * 3 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq $0, {offset}(%rax)" self.indent_string
            }
            common::InstValue::CaptureFlagMark(capture_index) => {
                capture_index 2 * 3 + common::WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq $1, {offset}(%rax)" self.indent_string
            }
            common::InstValue::ClosureRecord(capture_count) => {
                capture_count 2 * 2 + common::WORD_SIZE * = record_size
                f"movq ${record_size}, %rdi" self.indent_string
                "closure_alloc_done" "heap_alloc" self.emit_call_via_return_stack
                "popq %rdx" self.indent
                # Stack top is the destruction function, followed by the call function.
                "popq %rax" self.indent
                "movq %rax, 8(%rdx)" self.indent
                "popq %rax" self.indent
                "movq %rax, (%rdx)" self.indent
                capture_count 0 + = capture_remaining
                while 0 capture_remaining > do
                    capture_remaining 1 - 2 * 2 + common::WORD_SIZE * = field_offset
                    field_offset 8 + = flag_offset
                    "popq %rax" self.indent
                    f"movq %rax, {flag_offset}(%rdx)" self.indent_string
                    "popq %rax" self.indent
                    f"movq %rax, {field_offset}(%rdx)" self.indent_string
                    capture_remaining 1 - = capture_remaining
                done
                "pushq %rdx" self.indent
            }
            common::InstValue::ClosureDrop => {
                self.emit_uid = uid
                "popq %rax" self.indent
                "movq 8(%rax), %rdx" self.indent
                "testq %rdx, %rdx" self.indent
                f"jz .Lclosure_drop_done_{uid}" self.indent_string
                "movq current_env(%rip), %rbx" self.indent
                "movq env_sp(%rip), %rcx" self.indent
                f"cmpq ${RETURN_STACK_SIZE}, %rcx" self.indent_string
                "jge env_stack_overflow" self.indent
                "movq %rbx, env_stack(%rcx)" self.indent
                "addq $8, %rcx" self.indent
                "movq %rcx, env_sp(%rip)" self.indent
                "movq %rax, current_env(%rip)" self.indent
                "pushq %rax" self.indent
                f"leaq .Lclosure_drop_return_{uid}(%rip), %rcx" self.indent_string
                "movq %rcx, (%r14)" self.indent
                "addq $8, %r14" self.indent
                "jmpq *%rdx" self.indent
                f".Lclosure_drop_return_{uid}:" self.line_string
                "movq env_sp(%rip), %rcx" self.indent
                "subq $8, %rcx" self.indent
                "movq %rcx, env_sp(%rip)" self.indent
                "movq env_stack(%rcx), %rax" self.indent
                "movq %rax, current_env(%rip)" self.indent
                f".Lclosure_drop_done_{uid}:" self.line_string
            }
            common::InstValue::FnPush(fn_name) => {
                fn_name.as_str sanitize_name = fn_label
                f"leaq fn_{fn_label}(%rip), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            common::InstValue::FnPushStatic(fn_name) => {
                fn_name.as_str sanitize_name = fn_label
                f"leaq closure_{fn_label}(%rip), %rax" self.indent_string
                "pushq %rax" self.indent
            }
            common::InstValue::FnReturn => {
                if is_global then
                    "movq $60, %rax" self.indent
                    "xorq %rdi, %rdi" self.indent
                    "syscall" self.indent
                else
                    "subq $8, %r14" self.indent
                    "jmpq *(%r14)" self.indent
                fi
            }
            _ => {
                "Internal error: emit_control_flow called with non-control-flow InstValue\n" std::eprint
                1 std::exit
            }
        end
    }

    # ============================================================================
    # Emit memory operations
    # ============================================================================

    pub fn emit_memory self:mut$Emitter inst:$common::InstValue {
        inst match
            common::InstValue::HeapAlloc => {
                "popq %rdi" self.indent
                "heap_alloc_done" "heap_alloc" self.emit_call_via_return_stack
            }
            common::InstValue::HeapFree => {
                "popq %rdi" self.indent
                "heap_free_done" "heap_free" self.emit_call_via_return_stack
            }
            common::InstValue::HeapFreeIfAllocated => self.emit_heap_free_if_allocated
            common::InstValue::Load8 => "%eax" "movzbl" self.emit_load
            common::InstValue::Load16 => "%eax" "movzwl" self.emit_load
            common::InstValue::Load32 => "%eax" "movl" self.emit_load
            common::InstValue::Load64 => "%rax" "movq" self.emit_load
            common::InstValue::ReadTyped => self.emit_typed_read
            common::InstValue::Store8 => "%bl" "movb" self.emit_store
            common::InstValue::Store16 => "%bx" "movw" self.emit_store
            common::InstValue::Store32 => "%ebx" "movl" self.emit_store
            common::InstValue::Store64 => "%rbx" "movq" self.emit_store
            common::InstValue::WriteTyped => self.emit_typed_write
            common::InstValue::MoveBytes(size) => size self.emit_move_bytes
            _ => {
                "Internal error: emit_memory called with non-memory InstValue\n" std::eprint
                1 std::exit
            }
        end
    }

    # ============================================================================
    # Emit IO operations
    # ============================================================================

    pub fn emit_io_ops self:mut$Emitter inst:$common::InstValue {
        inst match
            common::InstValue::PrintInt => {
                "popq %rdi" self.indent
                "print_done" "print_int" self.emit_call_via_return_stack
            }
            common::InstValue::PrintUint => {
                "popq %rdi" self.indent
                "print_uint_done" "print_uint" self.emit_call_via_return_stack
            }
            common::InstValue::PrintBool => {
                self.emit_uid = uid
                "popq %rax" self.indent
                "testq %rax, %rax" self.indent
                f"jz .Lpb_false_{uid}" self.indent_string
                "leaq bool_true(%rip), %rsi" self.indent
                "movq $4, %rdx" self.indent
                f"jmp .Lpb_write_{uid}" self.indent_string
                f".Lpb_false_{uid}:" self.line_string
                "leaq bool_false(%rip), %rsi" self.indent
                "movq $5, %rdx" self.indent
                f".Lpb_write_{uid}:" self.line_string
                "movq $1, %rdi" self.indent
                "movq $1, %rax" self.indent
                "syscall" self.indent
            }
            common::InstValue::PrintStr => {
                "popq %rdi" self.indent
                "print_done" "print_str" self.emit_call_via_return_stack
            }
            common::InstValue::PrintString => {
                "popq %r12" self.indent
                "movq (%r12), %rdi" self.indent
                "print_string_done" "print_str" self.emit_call_via_return_stack
                "movq (%r12), %rdi" self.indent
                "print_string_data_free_done" "heap_free" self.emit_call_via_return_stack
                "movq %r12, %rdi" self.indent
                "print_string_wrapper_free_done" "heap_free" self.emit_call_via_return_stack
            }
            common::InstValue::PrintChar => {
                "popq %rdi" self.indent
                "print_char_encoded" "encode_char" self.emit_call_via_return_stack
                "movq $1, %rdi" self.indent
                "movq $1, %rax" self.indent
                "syscall" self.indent
            }
            common::InstValue::PrintCstr => {
                self.emit_uid = uid
                "popq %rsi" self.indent
                "movq %rsi, %rdi" self.indent
                f".Lpc_scan_{uid}:" self.line_string
                "cmpb $0, (%rsi)" self.indent
                f"je .Lpc_done_{uid}" self.indent_string
                "incq %rsi" self.indent
                f"jmp .Lpc_scan_{uid}" self.indent_string
                f".Lpc_done_{uid}:" self.line_string
                "movq %rsi, %rdx" self.indent
                "subq %rdi, %rdx" self.indent
                "movq %rdi, %rsi" self.indent
                "movq $1, %rdi" self.indent
                "movq $1, %rax" self.indent
                "syscall" self.indent
            }
            common::InstValue::FstringConcat(fstring_count) => {
                f"movq ${fstring_count}, %rdi" self.indent_string
                "concat_done" "str_concat" self.emit_call_via_return_stack
            }
            common::InstValue::PrimitiveToStr(builtin) => {
                "popq %rdi" self.indent
                0 = kind
                if builtin.is_unsigned then
                    1 = kind
                elif builtin common::BuiltinType::Bool == then
                    2 = kind
                elif builtin common::BuiltinType::Char == then
                    3 = kind
                elif builtin common::BuiltinType::Cstr == then
                    4 = kind
                fi
                f"movq ${kind}, %r8" self.indent_string
                f"to_str_{builtin.format}_done" = return_label
                return_label.as_str "primitive_to_str" self.emit_call_via_return_stack
            }
            _ => {
                "Internal error: emit_io_ops called with non-IO InstValue\n" std::eprint
                1 std::exit
            }
        end
    }

    # ============================================================================
    # Emit string equality
    # ============================================================================

    pub fn emit_str_eq self:mut$Emitter {
        self.emit_uid = uid
        "popq %rsi" self.indent
        "popq %rdi" self.indent
        "movq (%rdi), %rcx" self.indent
        "cmpq (%rsi), %rcx" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent_string
        "leaq 8(%rdi), %rdi" self.indent
        "leaq 8(%rsi), %rsi" self.indent
        "repe cmpsb" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent_string
        "pushq $1" self.indent
        f"jmp .Lstreq_done_{uid}" self.indent_string
        f".Lstreq_ne_{uid}:" self.line_string
        "pushq $0" self.indent
        f".Lstreq_done_{uid}:" self.line_string
    }

    pub fn emit_mixed_string_eq self:mut$Emitter owned_register:$str {
        self.emit_uid = uid
        "popq %rsi" self.indent
        "popq %rdi" self.indent
        f"movq ({owned_register}), {owned_register}" self.indent_string
        "movq (%rdi), %rcx" self.indent
        "cmpq (%rsi), %rcx" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent_string
        "leaq 8(%rdi), %rdi" self.indent
        "leaq 8(%rsi), %rsi" self.indent
        "repe cmpsb" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent_string
        "pushq $1" self.indent
        f"jmp .Lstreq_done_{uid}" self.indent_string
        f".Lstreq_ne_{uid}:" self.line_string
        "pushq $0" self.indent
        f".Lstreq_done_{uid}:" self.line_string
    }

    pub fn emit_string_str_eq self:mut$Emitter { "%rsi" self.emit_mixed_string_eq }

    pub fn emit_str_string_eq self:mut$Emitter { "%rdi" self.emit_mixed_string_eq }

    # ============================================================================
    # Emit single instruction (main dispatch)
    # ============================================================================

    pub fn emit_inst self:mut$Emitter inst:$common::InstValue is_global:bool {
        inst match
            # Stack operations
            common::InstValue::Drop => inst self.emit_stack_ops
            common::InstValue::Dup => inst self.emit_stack_ops
            common::InstValue::Over => inst self.emit_stack_ops
            common::InstValue::Push => inst self.emit_stack_ops
            common::InstValue::PushFloat32 => inst self.emit_stack_ops
            common::InstValue::PushFloat64 => inst self.emit_stack_ops
            common::InstValue::PushChar => inst self.emit_stack_ops
            common::InstValue::PushStr => inst self.emit_stack_ops
            common::InstValue::PushStaticArray => inst self.emit_stack_ops
            common::InstValue::Rot => inst self.emit_stack_ops
            common::InstValue::Swap => inst self.emit_stack_ops

            # Arithmetic / bitshift / bitwise / boolean / comparison
            common::InstValue::Add => inst self.emit_arithmetic
            common::InstValue::Sub => inst self.emit_arithmetic
            common::InstValue::Mul => inst self.emit_arithmetic
            common::InstValue::Div => inst self.emit_arithmetic
            common::InstValue::Mod => inst self.emit_arithmetic
            common::InstValue::Shl => inst self.emit_arithmetic
            common::InstValue::Shr => inst self.emit_arithmetic
            common::InstValue::BitAnd => inst self.emit_arithmetic
            common::InstValue::BitOr => inst self.emit_arithmetic
            common::InstValue::BitXor => inst self.emit_arithmetic
            common::InstValue::BitNot => inst self.emit_arithmetic
            common::InstValue::And => inst self.emit_arithmetic
            common::InstValue::Or => inst self.emit_arithmetic
            common::InstValue::Not => inst self.emit_arithmetic
            common::InstValue::Eq => inst self.emit_arithmetic
            common::InstValue::Ne => inst self.emit_arithmetic
            common::InstValue::Lt => inst self.emit_arithmetic
            common::InstValue::Le => inst self.emit_arithmetic
            common::InstValue::Gt => inst self.emit_arithmetic
            common::InstValue::Ge => inst self.emit_arithmetic
            common::InstValue::Ult => inst self.emit_arithmetic
            common::InstValue::Ule => inst self.emit_arithmetic
            common::InstValue::Ugt => inst self.emit_arithmetic
            common::InstValue::Uge => inst self.emit_arithmetic
            common::InstValue::UDiv => inst self.emit_arithmetic
            common::InstValue::UMod => inst self.emit_arithmetic
            common::InstValue::UShr => inst self.emit_arithmetic
            common::InstValue::NormalizeInt => inst self.emit_arithmetic
            common::InstValue::CheckedAdd => inst self.emit_arithmetic
            common::InstValue::CheckedSub => inst self.emit_arithmetic
            common::InstValue::CheckedMul => inst self.emit_arithmetic
            common::InstValue::CheckedDiv => inst self.emit_arithmetic
            common::InstValue::CheckedMod => inst self.emit_arithmetic
            common::InstValue::CheckedShl => inst self.emit_arithmetic
            common::InstValue::CheckedShr => inst self.emit_arithmetic
            common::InstValue::NumericConvert => inst self.emit_arithmetic
            common::InstValue::NumericTry => inst self.emit_arithmetic
            common::InstValue::IntegerTry => inst self.emit_arithmetic
            common::InstValue::FloatRound => inst self.emit_arithmetic
            common::InstValue::FloatFromDecimal => inst self.emit_arithmetic
            common::InstValue::FloatSignificand => inst self.emit_arithmetic
            common::InstValue::FloatAdd32 => inst self.emit_arithmetic
            common::InstValue::FloatAdd64 => inst self.emit_arithmetic
            common::InstValue::FloatSub32 => inst self.emit_arithmetic
            common::InstValue::FloatSub64 => inst self.emit_arithmetic
            common::InstValue::FloatMul32 => inst self.emit_arithmetic
            common::InstValue::FloatMul64 => inst self.emit_arithmetic
            common::InstValue::FloatDiv32 => inst self.emit_arithmetic
            common::InstValue::FloatDiv64 => inst self.emit_arithmetic
            common::InstValue::FloatEq32 => inst self.emit_arithmetic
            common::InstValue::FloatEq64 => inst self.emit_arithmetic
            common::InstValue::FloatNe32 => inst self.emit_arithmetic
            common::InstValue::FloatNe64 => inst self.emit_arithmetic
            common::InstValue::FloatLt32 => inst self.emit_arithmetic
            common::InstValue::FloatLt64 => inst self.emit_arithmetic
            common::InstValue::FloatLe32 => inst self.emit_arithmetic
            common::InstValue::FloatLe64 => inst self.emit_arithmetic
            common::InstValue::FloatGt32 => inst self.emit_arithmetic
            common::InstValue::FloatGt64 => inst self.emit_arithmetic
            common::InstValue::FloatGe32 => inst self.emit_arithmetic
            common::InstValue::FloatGe64 => inst self.emit_arithmetic

            # Control flow / variables / functions
            common::InstValue::Label => is_global inst self.emit_control_flow
            common::InstValue::Jump => is_global inst self.emit_control_flow
            common::InstValue::JumpNe => is_global inst self.emit_control_flow
            common::InstValue::GlobalsInit => is_global inst self.emit_control_flow
            common::InstValue::GlobalGet => is_global inst self.emit_control_flow
            common::InstValue::GlobalSet => is_global inst self.emit_control_flow
            common::InstValue::LocalsInit => is_global inst self.emit_control_flow
            common::InstValue::LocalsUninit => is_global inst self.emit_control_flow
            common::InstValue::LocalAddress => is_global inst self.emit_control_flow
            common::InstValue::LocalGet => is_global inst self.emit_control_flow
            common::InstValue::LocalSet => is_global inst self.emit_control_flow
            common::InstValue::ConstantLoad => is_global inst self.emit_control_flow
            common::InstValue::ConstantStore => is_global inst self.emit_control_flow
            common::InstValue::CaptureLoad => is_global inst self.emit_control_flow
            common::InstValue::CaptureSet => is_global inst self.emit_control_flow
            common::InstValue::CaptureFlagLoad => is_global inst self.emit_control_flow
            common::InstValue::CaptureFlagClear => is_global inst self.emit_control_flow
            common::InstValue::CaptureFlagMark => is_global inst self.emit_control_flow
            common::InstValue::ClosureDrop => is_global inst self.emit_control_flow
            common::InstValue::ClosureRecord => is_global inst self.emit_control_flow
            common::InstValue::FnCall => is_global inst self.emit_control_flow
            common::InstValue::ExternCall => is_global inst self.emit_control_flow
            common::InstValue::FnExec => is_global inst self.emit_control_flow
            common::InstValue::FnPush => is_global inst self.emit_control_flow
            common::InstValue::FnPushStatic => is_global inst self.emit_control_flow
            common::InstValue::FnReturn => is_global inst self.emit_control_flow
            common::InstValue::DropFn => is_global inst self.emit_control_flow

            # Memory operations
            common::InstValue::HeapAlloc => inst self.emit_memory
            common::InstValue::HeapFree => inst self.emit_memory
            common::InstValue::HeapFreeIfAllocated => inst self.emit_memory
            common::InstValue::Load8 => inst self.emit_memory
            common::InstValue::Load16 => inst self.emit_memory
            common::InstValue::Load32 => inst self.emit_memory
            common::InstValue::Load64 => inst self.emit_memory
            common::InstValue::ReadTyped => inst self.emit_memory
            common::InstValue::Store8 => inst self.emit_memory
            common::InstValue::Store16 => inst self.emit_memory
            common::InstValue::Store32 => inst self.emit_memory
            common::InstValue::Store64 => inst self.emit_memory
            common::InstValue::WriteTyped => inst self.emit_memory
            common::InstValue::MoveBytes => inst self.emit_memory

            # IO operations
            common::InstValue::PrintInt => inst self.emit_io_ops
            common::InstValue::PrintUint => inst self.emit_io_ops
            common::InstValue::PrintBool => inst self.emit_io_ops
            common::InstValue::PrintStr => inst self.emit_io_ops
            common::InstValue::PrintString => inst self.emit_io_ops
            common::InstValue::PrintChar => inst self.emit_io_ops
            common::InstValue::PrintCstr => inst self.emit_io_ops
            common::InstValue::FstringConcat => inst self.emit_io_ops
            common::InstValue::PrimitiveToStr => inst self.emit_io_ops

            # String equality
            common::InstValue::StrEq => self.emit_str_eq
            common::InstValue::StringStrEq => self.emit_string_str_eq
            common::InstValue::StrStringEq => self.emit_str_string_eq

            # Syscalls
            common::InstValue::Syscall0 => 0 self.emit_syscall
            common::InstValue::Syscall1 => 1 self.emit_syscall
            common::InstValue::Syscall2 => 2 self.emit_syscall
            common::InstValue::Syscall3 => 3 self.emit_syscall
            common::InstValue::Syscall4 => 4 self.emit_syscall
            common::InstValue::Syscall5 => 5 self.emit_syscall
            common::InstValue::Syscall6 => 6 self.emit_syscall

            # argc / argv
            common::InstValue::Argc => {
                "movq __argc(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            common::InstValue::Argv => {
                "movq __argv(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            common::InstValue::Envp => {
                "movq __envp(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
        end
    }

    # ============================================================================
    # Main emit function
    # ============================================================================
}

pub fn emit program:common::Program -> std::String {
    program.split_bytecode = bytecode = program
    program Emitter::new = emitter
    emitter.emit_bss
    emitter.emit_data
    bytecode emitter.emit_text
    emitter.into_asm
}
