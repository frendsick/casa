# Assembly symbol and string spelling.
import "std" as std

pub fn sanitize_name name:$str -> std::String {
    if name " " str::contains then
        # Source identifiers cannot contain whitespace or an emitted dot. Preserve the
        # complete generated identity without sharing the source-label namespace.
        ".generic_".to_str = generated
        for character in name.iter do
            if character.is_alpha character.is_digit || then
                character generated.push
            else
                f"_{character.codepoint}_" generated.append_string
            fi
        done
        generated return
    fi
    name "::" str::split = parts
    "__" parts.join_strings = namespaced
    std::String::new = result
    for character in namespaced.iter do
        if
            character.is_alpha
            character.is_digit ||
            '_' character == ||
            ':' character == ||
        then
            character result.push
        else
            '_' result.push
        fi
    done
    result
}

fn make_octal_digit value:u32 -> char { value '0'.codepoint + char::from_codepoint.unwrap }

pub fn escape_string s:$str -> std::String {
    std::String::new = builder
    0 = index: u64
    while index s.length > do
        index s.at = byte
        if '\\' byte == then
            "\\\\" builder.append
        elif '"' byte == then
            "\\\"" builder.append
        elif '\n' byte == then
            "\\n" builder.append
        elif '\t' byte == then
            "\\t" builder.append
        elif '\0' byte == then
            "\\000" builder.append
        elif '\r' byte == then
            "\\r" builder.append
        elif
            32 byte.codepoint i64::from <
            127 byte.codepoint i64::from >= ||
        then
            '\\' builder.push
            byte.codepoint 64 / make_octal_digit builder.push
            byte.codepoint 8 / 8 % make_octal_digit builder.push
            byte.codepoint 8 % make_octal_digit builder.push
        else
            byte builder.push
        fi
        1 += index
    done
    builder
}
