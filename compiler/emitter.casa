# x86-64 GNU assembly emitter for the Casa compiler.
import "std"
import "common"

# ============================================================================
# Constants
# ============================================================================
const INT32_MAX 2147483647
const INT32_MIN -2147483648
const RETURN_STACK_SIZE 65536
const HEAP_SIZE 2147483648

# ============================================================================
# Emitter state
# ============================================================================

struct Emitter {
    asm:           StringBuilder
    label_counter: u64
    program:       Program
}

impl Emitter {
    fn new program:Program -> Emitter {
        program
        0
        StringBuilder::new
        Emitter
    }

    fn emit_uid self:mut$Emitter -> u64 {
        1 += self.label_counter
        self.label_counter
    }

    fn line self:mut$Emitter text:str {
        text self.asm.append
        '\n' self.asm.append_char
    }

    fn indent self:mut$Emitter text:str {
        "    " self.asm.append
        text self.asm.append
        '\n' self.asm.append_char
    }
}

# ============================================================================
# Convert a source-level function name to an assembler-safe label.
# ============================================================================

fn sanitize_name name:$str -> str {
    name "::" str::split = parts
    "__" parts.join = namespaced
    StringBuilder::new = result
    for character in namespaced.iter do
        if
        character.is_alpha
        character.is_digit ||
        '_' character == ||
        ':' character == ||
        then
            character result.append_char
        else
            '_' result.append_char
        fi
    done
    result.build
}

# ============================================================================
# escape_string: escape special chars for assembly string literals
# ============================================================================

fn nibble_to_hex value:i64 -> char {
    if 10 value >= then
        value 10 - 'a'.codepoint i64::from + u32::try_from.unwrap char::from_codepoint.unwrap
    else
        value '0'.codepoint i64::from + u32::try_from.unwrap char::from_codepoint.unwrap
    fi
}

fn escape_string s:str -> str {
    StringBuilder::new = builder
    for ch in s.iter do
        if '\\' ch == then
            "\\\\" builder.append
        elif '"' ch == then
            "\\\"" builder.append
        elif '\n' ch == then
            "\\n" builder.append
        elif '\t' ch == then
            "\\t" builder.append
        elif '\0' ch == then
            "\\0" builder.append
        elif '\r' ch == then
            "\\r" builder.append
        elif
        32 ch.codepoint i64::from <
        127 ch.codepoint i64::from >= ||
        then
            "\\x" builder.append
            ch.codepoint i64::from 16 / nibble_to_hex builder.append_char
            ch.codepoint i64::from 16 % nibble_to_hex builder.append_char
        else
            ch builder.append_char
        fi
    done
    builder.build
}

# ============================================================================
# BSS section
# ============================================================================

impl Emitter {
    fn emit_bss self:mut$Emitter {
        ".section .bss" self.line
        if 0 self.program.globals_count > then
            f"globals: .skip {self.program.globals_count WORD_SIZE *}" self.line
        fi
        if 0 self.program.constants_count > then
            f"constants: .skip {self.program.constants_count WORD_SIZE *}" self.line
        fi
        f"return_stack: .skip {RETURN_STACK_SIZE}" self.line
        f"env_stack: .skip {RETURN_STACK_SIZE}" self.line
        "env_sp: .skip 8" self.line
        "current_env: .skip 8" self.line
        ".align 16" self.line
        "heap_ptr: .skip 8" self.line
        "free_list: .skip 8" self.line
        "__argc: .skip 8" self.line
        "__argv: .skip 8" self.line
        "__envp: .skip 8" self.line
        "print_buf: .skip 32" self.line
        f"heap: .skip {HEAP_SIZE}" self.line
        "" self.line
    }

    # ============================================================================
    # DATA section
    # ============================================================================

    fn emit_data self:mut$Emitter {
        ".section .data" self.line
        0 (u64) = index
        while index self.program.strings.length > do
            index self.program.strings.get = value
            value escape_string = escaped
            ".align 8" self.line
            f"str_{index}:" self.line
            f".quad {value.length}" self.line
            f".asciz \"{escaped}\"" self.line
            1 += index
        done
        "bool_true: .ascii \"true\"" self.line
        "bool_false: .ascii \"false\"" self.line
        "float_decimal_ten: .long 10" self.line
        "arithmetic_error_msg: .ascii \"error: integer arithmetic failed\\n\"" self.line
        ".equ arithmetic_error_msg_len, . - arithmetic_error_msg" self.line
        "env_stack_overflow_msg: .ascii \"error: env stack overflow\\n\"" self.line
        ".equ env_stack_overflow_msg_len, . - env_stack_overflow_msg" self.line
        "allocation_failure_msg: .ascii \"fatal: allocation failed\\n\"" self.line
        ".equ allocation_failure_msg_len, . - allocation_failure_msg" self.line
        # Static closure record per function
        for name in self.program.functions.keys.iter do
            name sanitize_name = label
            ".align 8" self.line
            f"closure_{label}: .quad fn_{label}" self.line
        done

        # Static array literals
        0 (u64) = sa_index
        while sa_index self.program.static_arrays.length > do
            sa_index self.program.static_arrays.get = sa
            sa StaticArray::elements = elems
            ".align 8" self.line
            f"static_array_{sa_index}:" self.line
            f".quad static_array_{sa_index} + 16" self.line
            f".quad {elems.length}" self.line
            for elem in elems.iter do
                elem match
                    StaticArrayElement::Imm(v) => { f".quad {v}" self.line }
                    StaticArrayElement::Label(lbl) => { f".quad {lbl}" self.line }
                end
            done
            1 += sa_index
        done

        # Static struct literals
        0 (u64) = ss_index
        while ss_index self.program.static_structs.length > do
            ss_index self.program.static_structs.get = ss
            ss StaticStruct::fields = fields
            ".align 8" self.line
            f"static_struct_{ss_index}:" self.line
            for field in fields.iter do
                field match
                    StaticArrayElement::Imm(v) => { f".quad {v}" self.line }
                    StaticArrayElement::Label(lbl) => { f".quad {lbl}" self.line }
                end
            done
            1 += ss_index
        done

        "" self.line
    }

    # ============================================================================
    # TEXT section
    # ============================================================================

    fn emit_text self:mut$Emitter {
        ".section .text" self.line
        self.emit_helpers
        self.emit_functions
        self.emit_start
    }

    # ============================================================================
    # Helper subroutines
    # ============================================================================

    # ponytail: first-fit reuse does not split or coalesce blocks; add both if
    # fragmentation becomes measurable before the fixed heap is exhausted.
    fn emit_heap_helpers self:mut$Emitter {
        # heap_alloc: requested byte count in %rdi, pushes an aligned pointer.
        "heap_alloc:" self.line
        "testq %rdi, %rdi" self.indent
        "jz .Lheap_alloc_null" self.indent
        "movq %rdi, %rax" self.indent
        "addq $7, %rax" self.indent
        "jc .Lheap_alloc_oom" self.indent
        "andq $-8, %rax" self.indent
        "movq free_list(%rip), %rcx" self.indent
        "xorq %rdx, %rdx" self.indent
        ".Lheap_alloc_search:" self.line
        "testq %rcx, %rcx" self.indent
        "jz .Lheap_alloc_bump" self.indent
        "cmpq %rax, (%rcx)" self.indent
        "jae .Lheap_alloc_reuse" self.indent
        "movq %rcx, %rdx" self.indent
        "movq 8(%rcx), %rcx" self.indent
        "jmp .Lheap_alloc_search" self.indent
        ".Lheap_alloc_reuse:" self.line
        "movq 8(%rcx), %r8" self.indent
        "testq %rdx, %rdx" self.indent
        "jz .Lheap_alloc_reuse_head" self.indent
        "movq %r8, 8(%rdx)" self.indent
        "jmp .Lheap_alloc_return_block" self.indent
        ".Lheap_alloc_reuse_head:" self.line
        "movq %r8, free_list(%rip)" self.indent
        ".Lheap_alloc_return_block:" self.line
        "leaq 8(%rcx), %rax" self.indent
        "pushq %rax" self.indent
        "jmp .Lheap_alloc_return" self.indent
        ".Lheap_alloc_bump:" self.line
        "movq heap_ptr(%rip), %rcx" self.indent
        "addq $7, %rcx" self.indent
        "andq $-8, %rcx" self.indent
        "movq %rax, %r8" self.indent
        "addq $8, %r8" self.indent
        "jc .Lheap_alloc_oom" self.indent
        "addq %rcx, %r8" self.indent
        "jc .Lheap_alloc_oom" self.indent
        f"movq ${HEAP_SIZE}, %r9" self.indent
        "cmpq %r9, %r8" self.indent
        "ja .Lheap_alloc_oom" self.indent
        "leaq heap(%rip), %r9" self.indent
        "leaq (%r9,%rcx), %rcx" self.indent
        "movq %rax, (%rcx)" self.indent
        "movq %r8, heap_ptr(%rip)" self.indent
        "leaq 8(%rcx), %rax" self.indent
        "pushq %rax" self.indent
        "jmp .Lheap_alloc_return" self.indent
        ".Lheap_alloc_null:" self.line
        "pushq $0" self.indent
        ".Lheap_alloc_return:" self.line
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        ".Lheap_alloc_oom:" self.line
        "movq $1, %rax" self.indent
        "movq $2, %rdi" self.indent
        "leaq allocation_failure_msg(%rip), %rsi" self.indent
        "movq $allocation_failure_msg_len, %rdx" self.indent
        "syscall" self.indent
        "movq $60, %rax" self.indent
        "movq $1, %rdi" self.indent
        "syscall" self.indent
        "" self.line

        # heap_free: pointer in %rdi, returns the complete allocation for reuse.
        "heap_free:" self.line
        "testq %rdi, %rdi" self.indent
        "jz .Lheap_free_return" self.indent
        "leaq -8(%rdi), %rax" self.indent
        "movq free_list(%rip), %rcx" self.indent
        "movq %rcx, 8(%rax)" self.indent
        "movq %rax, free_list(%rip)" self.indent
        ".Lheap_free_return:" self.line
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line
    }

    fn emit_helpers self:mut$Emitter {
        self.emit_heap_helpers

        # print_int: value in %rdi, returns via r14
        "print_int:" self.line
        "movq %rdi, %rax" self.indent
        "leaq print_buf+32(%rip), %rsi" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpi_nonzero" self.indent
        "decq %rsi" self.indent
        "movb $48, (%rsi)" self.indent
        "jmp .Lpi_write" self.indent
        ".Lpi_nonzero:" self.line
        "movq %rax, %r15" self.indent
        "jns .Lpi_abs" self.indent
        "negq %rax" self.indent
        ".Lpi_abs:" self.line
        "movq $10, %rcx" self.indent
        ".Lpi_digit_loop:" self.line
        "decq %rsi" self.indent
        "xorq %rdx, %rdx" self.indent
        "divq %rcx" self.indent
        "addb $48, %dl" self.indent
        "movb %dl, (%rsi)" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpi_digit_loop" self.indent
        "testq %r15, %r15" self.indent
        "jns .Lpi_write" self.indent
        "decq %rsi" self.indent
        "movb $45, (%rsi)" self.indent
        ".Lpi_write:" self.line
        "leaq print_buf+32(%rip), %rdx" self.indent
        "subq %rsi, %rdx" self.indent
        "movq $1, %rax" self.indent
        "movq $1, %rdi" self.indent
        "syscall" self.indent
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # print_uint: value in %rdi, returns via r14
        "print_uint:" self.line
        "movq %rdi, %rax" self.indent
        "leaq print_buf+32(%rip), %rsi" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpui_digit_loop" self.indent
        "decq %rsi" self.indent
        "movb $48, (%rsi)" self.indent
        "jmp .Lpui_write" self.indent
        ".Lpui_digit_loop:" self.line
        "decq %rsi" self.indent
        "xorq %rdx, %rdx" self.indent
        "movq $10, %rcx" self.indent
        "divq %rcx" self.indent
        "addb $48, %dl" self.indent
        "movb %dl, (%rsi)" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpui_digit_loop" self.indent
        ".Lpui_write:" self.line
        "leaq print_buf+32(%rip), %rdx" self.indent
        "subq %rsi, %rdx" self.indent
        "movq $1, %rax" self.indent
        "movq $1, %rdi" self.indent
        "syscall" self.indent
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # print_str: string pointer in %rdi (points to length prefix), returns via r14
        "print_str:" self.line
        "movq (%rdi), %rdx" self.indent
        "leaq 8(%rdi), %rsi" self.indent
        "movq $1, %rdi" self.indent
        "movq $1, %rax" self.indent
        "syscall" self.indent
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # encode_char: Unicode scalar in %rdi, UTF-8 bytes in print_buf.
        # Returns the buffer in %rsi and its byte length in %rdx via r14.
        "encode_char:" self.line
        "leaq print_buf(%rip), %rsi" self.indent
        "cmpq $127, %rdi" self.indent
        "ja .Lec_two" self.indent
        "movb %dil, (%rsi)" self.indent
        "movq $1, %rdx" self.indent
        "jmp .Lec_return" self.indent
        ".Lec_two:" self.line
        "cmpq $2047, %rdi" self.indent
        "ja .Lec_three" self.indent
        "movq %rdi, %rax" self.indent
        "shrq $6, %rax" self.indent
        "orb $192, %al" self.indent
        "movb %al, (%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 1(%rsi)" self.indent
        "movq $2, %rdx" self.indent
        "jmp .Lec_return" self.indent
        ".Lec_three:" self.line
        "cmpq $65535, %rdi" self.indent
        "ja .Lec_four" self.indent
        "movq %rdi, %rax" self.indent
        "shrq $12, %rax" self.indent
        "orb $224, %al" self.indent
        "movb %al, (%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "shrq $6, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 1(%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 2(%rsi)" self.indent
        "movq $3, %rdx" self.indent
        "jmp .Lec_return" self.indent
        ".Lec_four:" self.line
        "movq %rdi, %rax" self.indent
        "shrq $18, %rax" self.indent
        "orb $240, %al" self.indent
        "movb %al, (%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "shrq $12, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 1(%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "shrq $6, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 2(%rsi)" self.indent
        "movq %rdi, %rax" self.indent
        "andb $63, %al" self.indent
        "orb $128, %al" self.indent
        "movb %al, 3(%rsi)" self.indent
        "movq $4, %rdx" self.indent
        ".Lec_return:" self.line
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # primitive_to_str: value in %rdi, kind in %r8, pushes an owned str.
        # Kinds: 0 signed integer, 1 unsigned integer, 2 bool, 3 char, 4 cstr.
        "primitive_to_str:" self.line
        "cmpq $2, %r8" self.indent
        "je .Lpts_bool" self.indent
        "cmpq $3, %r8" self.indent
        "je .Lpts_char" self.indent
        "cmpq $4, %r8" self.indent
        "je .Lpts_cstr" self.indent
        "movq %rdi, %rax" self.indent
        "leaq print_buf+32(%rip), %rsi" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpts_integer_nonzero" self.indent
        "decq %rsi" self.indent
        "movb $48, (%rsi)" self.indent
        "jmp .Lpts_integer_done" self.indent
        ".Lpts_integer_nonzero:" self.line
        "testq %r8, %r8" self.indent
        "jnz .Lpts_integer_abs" self.indent
        "testq %rax, %rax" self.indent
        "jns .Lpts_integer_abs" self.indent
        "negq %rax" self.indent
        ".Lpts_integer_abs:" self.line
        "movq $10, %rcx" self.indent
        ".Lpts_integer_loop:" self.line
        "decq %rsi" self.indent
        "xorq %rdx, %rdx" self.indent
        "divq %rcx" self.indent
        "addb $48, %dl" self.indent
        "movb %dl, (%rsi)" self.indent
        "testq %rax, %rax" self.indent
        "jnz .Lpts_integer_loop" self.indent
        "testq %r8, %r8" self.indent
        "jnz .Lpts_integer_done" self.indent
        "testq %rdi, %rdi" self.indent
        "jns .Lpts_integer_done" self.indent
        "decq %rsi" self.indent
        "movb $45, (%rsi)" self.indent
        ".Lpts_integer_done:" self.line
        "leaq print_buf+32(%rip), %rdx" self.indent
        "subq %rsi, %rdx" self.indent
        "jmp .Lpts_copy" self.indent
        ".Lpts_bool:" self.line
        "testq %rdi, %rdi" self.indent
        "jz .Lpts_bool_false" self.indent
        "leaq bool_true(%rip), %rsi" self.indent
        "movq $4, %rdx" self.indent
        "jmp .Lpts_copy" self.indent
        ".Lpts_bool_false:" self.line
        "leaq bool_false(%rip), %rsi" self.indent
        "movq $5, %rdx" self.indent
        "jmp .Lpts_copy" self.indent
        ".Lpts_char:" self.line
        "pts_char_encoded" "encode_char" self.emit_call_via_return_stack
        "jmp .Lpts_copy" self.indent
        ".Lpts_cstr:" self.line
        "movq %rdi, %rsi" self.indent
        "movq %rdi, %rax" self.indent
        ".Lpts_cstr_loop:" self.line
        "cmpb $0, (%rax)" self.indent
        "je .Lpts_cstr_done" self.indent
        "incq %rax" self.indent
        "jmp .Lpts_cstr_loop" self.indent
        ".Lpts_cstr_done:" self.line
        "movq %rax, %rdx" self.indent
        "subq %rsi, %rdx" self.indent
        ".Lpts_copy:" self.line
        "leaq heap(%rip), %rbx" self.indent
        "movq heap_ptr(%rip), %rax" self.indent
        "leaq (%rbx,%rax), %r13" self.indent
        "movq %rdx, (%r13)" self.indent
        "leaq 8(%r13), %rdi" self.indent
        "movq %rdx, %rcx" self.indent
        "rep movsb" self.indent
        "movb $0, (%rdi)" self.indent
        "addq $9, %rdx" self.indent
        "addq %rdx, %rax" self.indent
        "movq %rax, heap_ptr(%rip)" self.indent
        "pushq %r13" self.indent
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # str_concat: %rdi = part count (N), N string pointers on data stack
        "str_concat:" self.line
        "movq %rdi, %r8" self.indent
        "movq %rsp, %r9" self.indent
        "xorq %r10, %r10" self.indent
        "xorq %rcx, %rcx" self.indent
        ".Lsc_len_loop:" self.line
        "cmpq %r8, %rcx" self.indent
        "jge .Lsc_len_done" self.indent
        "movq (%r9, %rcx, 8), %rax" self.indent
        "addq (%rax), %r10" self.indent
        "incq %rcx" self.indent
        "jmp .Lsc_len_loop" self.indent
        ".Lsc_len_done:" self.line
        "leaq heap(%rip), %r11" self.indent
        "movq heap_ptr(%rip), %r12" self.indent
        "leaq (%r11, %r12), %r13" self.indent
        "leaq 9(%r10, %r12), %rax" self.indent
        "movq %rax, heap_ptr(%rip)" self.indent
        "movq %r10, (%r13)" self.indent
        "leaq 8(%r13), %rdi" self.indent
        "movq %r8, %rcx" self.indent
        "decq %rcx" self.indent
        ".Lsc_copy_loop:" self.line
        "cmpq $0, %rcx" self.indent
        "jl .Lsc_copy_done" self.indent
        "movq (%r9, %rcx, 8), %rsi" self.indent
        "movq (%rsi), %rdx" self.indent
        "addq $8, %rsi" self.indent
        "pushq %rcx" self.indent
        "movq %rdx, %rcx" self.indent
        "rep movsb" self.indent
        "popq %rcx" self.indent
        "decq %rcx" self.indent
        "jmp .Lsc_copy_loop" self.indent
        ".Lsc_copy_done:" self.line
        "movb $0, (%rdi)" self.indent
        "leaq (%r9, %r8, 8), %rsp" self.indent
        "pushq %r13" self.indent
        "subq $8, %r14" self.indent
        "jmpq *(%r14)" self.indent
        "" self.line

        # Arithmetic failure handler: write error to fd 2 and exit(1).
        "arithmetic_error:" self.line
        "leaq arithmetic_error_msg(%rip), %rsi" self.indent
        "movq $arithmetic_error_msg_len, %rdx" self.indent
        "movq $2, %rdi" self.indent
        "movq $1, %rax" self.indent
        "syscall" self.indent
        "movq $1, %rdi" self.indent
        "movq $60, %rax" self.indent
        "syscall" self.indent
        "" self.line

        # env_stack overflow handler: write error to fd 2 and exit(1).
        "env_stack_overflow:" self.line
        "leaq env_stack_overflow_msg(%rip), %rsi" self.indent
        "movq $env_stack_overflow_msg_len, %rdx" self.indent
        "movq $2, %rdi" self.indent
        "movq $1, %rax" self.indent
        "syscall" self.indent
        "movq $1, %rdi" self.indent
        "movq $60, %rax" self.indent
        "syscall" self.indent
        "" self.line
    }

    # ============================================================================
    # Emit user functions
    # ============================================================================

    fn emit_functions self:mut$Emitter {
        for pair in self.program.functions.iter do
            pair.first = name
            pair.second = bytecode
            name sanitize_name = label
            f"fn_{label}:" self.line
            false bytecode self.emit_bytecode
            "" self.line
        done
    }

    # ============================================================================
    # Emit _start entry point
    # ============================================================================

    fn emit_start self:mut$Emitter {
        ".globl _start" self.line
        "_start:" self.line
        "leaq return_stack(%rip), %r14" self.indent
        "movq (%rsp), %rax" self.indent
        "movq %rax, __argc(%rip)" self.indent
        "leaq 8(%rsp), %rax" self.indent
        "movq %rax, __argv(%rip)" self.indent
        "movq (%rsp), %rcx" self.indent
        "addq $1, %rcx" self.indent
        "leaq 8(%rsp,%rcx,8), %rax" self.indent
        "movq %rax, __envp(%rip)" self.indent
        true self.program.bytecode self.emit_bytecode
        "movq $60, %rax" self.indent
        "xorq %rdi, %rdi" self.indent
        "syscall" self.indent
        "" self.line
    }

    # ============================================================================
    # Emit bytecode sequence
    # ============================================================================

    fn emit_bytecode self:mut$Emitter bytecode:List[InstValue] is_global:bool {
        for inst in bytecode.iter do
            is_global inst self.emit_inst
        done
    }

    # ============================================================================
    # Emit comparison helper
    # ============================================================================

    fn emit_comparison self:mut$Emitter setcc:str {
        "popq %rax" self.indent
        "cmpq (%rsp), %rax" self.indent
        f"{setcc} %al" self.indent
        "movzbq %al, %rax" self.indent
        "movq %rax, (%rsp)" self.indent
    }

    # ============================================================================
    # Emit syscall helper
    # ============================================================================

    fn emit_syscall self:mut$Emitter arg_count:u64 {
        "popq %rax" self.indent
        ["%rdi", "%rsi", "%rdx", "%r10", "%r8", "%r9"] = syscall_regs
        0 (u64) = index
        while index arg_count > do
            f"popq {index syscall_regs array::nth(str)}" self.indent
            1 += index
        done
        "syscall" self.indent
        "pushq %rax" self.indent
    }

    # ============================================================================
    # Emit call-via-return-stack: push a return address onto r14, jump to target,
    # then emit the return label. Shared by FnCall, PrintInt, PrintStr, and
    # FstringConcat (all of which funnel into a shared asm subroutine).
    # ============================================================================

    fn emit_call_via_return_stack self:mut$Emitter jump_target:str label_prefix:str {
        self.emit_uid = uid
        f"leaq .L{label_prefix}_{uid}(%rip), %rax" self.indent
        "movq %rax, (%r14)" self.indent
        "addq $8, %r14" self.indent
        f"jmp {jump_target}" self.indent
        f".L{label_prefix}_{uid}:" self.line
    }

    # ============================================================================
    # Emit memory load/store shared helpers
    # ============================================================================

    fn emit_load self:mut$Emitter mov_op:str dst_reg:str {
        "popq %rax" self.indent
        f"{mov_op} (%rax), {dst_reg}" self.indent
        "pushq %rax" self.indent
    }

    fn emit_store self:mut$Emitter mov_op:str src_reg:str {
        "popq %rax" self.indent
        "popq %rbx" self.indent
        f"{mov_op} {src_reg}, (%rax)" self.indent
    }

    # ============================================================================
    # Emit stack operations
    # ============================================================================

    fn emit_stack_ops self:mut$Emitter inst:mut$InstValue {
        inst match
            InstValue::Push(value) => {
                if
                INT32_MIN value >=
                INT32_MAX value <= &&
                then
                    f"pushq ${value}" self.indent
                else
                    f"movabsq ${value}, %rax" self.indent
                    "pushq %rax" self.indent
                fi
            }
            InstValue::PushFloat32(value) => {
                "jmp 1f" self.indent
                ".align 4" self.line
                "0:" self.line
                f".float {value}" self.line
                "1:" self.line
                "movl 0b(%rip), %eax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::PushFloat64(value) => {
                "jmp 1f" self.indent
                ".align 8" self.line
                "0:" self.line
                f".double {value}" self.line
                "1:" self.line
                "pushq 0b(%rip)" self.indent
            }
            InstValue::PushStr(str_index) => {
                f"leaq str_{str_index}(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::PushStaticArray(array_index) => {
                f"leaq static_array_{array_index}(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::PushChar(char_value) => f"pushq ${char_value}" self.indent
            InstValue::Drop => "addq $8, %rsp" self.indent
            InstValue::Dup => "pushq (%rsp)" self.indent
            InstValue::Swap => {
                "popq %rax" self.indent
                "popq %rbx" self.indent
                "pushq %rax" self.indent
                "pushq %rbx" self.indent
            }
            InstValue::Over => "pushq 8(%rsp)" self.indent
            InstValue::Rot => {
                "popq %rax" self.indent
                "popq %rbx" self.indent
                "popq %rcx" self.indent
                "pushq %rbx" self.indent
                "pushq %rax" self.indent
                "pushq %rcx" self.indent
            }
            _ => {
                "Internal error: emit_stack_ops called with non-stack InstValue\n" eprint
                1 exit
            }
        end
    }

    # ============================================================================
    # Emit arithmetic / bitwise / boolean / comparison operations
    # ============================================================================

    fn emit_arithmetic self:mut$Emitter inst:mut$InstValue {
        inst match
            InstValue::Add => {
                "popq %rax" self.indent
                "addq %rax, (%rsp)" self.indent
            }
            InstValue::Sub => {
                "popq %rax" self.indent
                "subq %rax, (%rsp)" self.indent
            }
            InstValue::Mul => {
                "popq %rax" self.indent
                "imulq (%rsp), %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            InstValue::Div => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "cqto" self.indent
                "idivq %rbx" self.indent
                "pushq %rax" self.indent
            }
            InstValue::Mod => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "cqto" self.indent
                "idivq %rbx" self.indent
                "pushq %rdx" self.indent
            }
            InstValue::UDiv => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "xorq %rdx, %rdx" self.indent
                "divq %rbx" self.indent
                "pushq %rax" self.indent
            }
            InstValue::UMod => {
                "popq %rbx" self.indent
                "popq %rax" self.indent
                "xorq %rdx, %rdx" self.indent
                "divq %rbx" self.indent
                "pushq %rdx" self.indent
            }
            InstValue::Shl => {
                "popq %rcx" self.indent
                "shlq %cl, (%rsp)" self.indent
            }
            InstValue::Shr => {
                "popq %rcx" self.indent
                "sarq %cl, (%rsp)" self.indent
            }
            InstValue::UShr => {
                "popq %rcx" self.indent
                "shrq %cl, (%rsp)" self.indent
            }
            InstValue::BitAnd => {
                "popq %rax" self.indent
                "andq %rax, (%rsp)" self.indent
            }
            InstValue::BitOr => {
                "popq %rax" self.indent
                "orq %rax, (%rsp)" self.indent
            }
            InstValue::BitXor => {
                "popq %rax" self.indent
                "xorq %rax, (%rsp)" self.indent
            }
            InstValue::BitNot => "notq (%rsp)" self.indent
            InstValue::And => {
                "popq %rax" self.indent
                "testq %rax, %rax" self.indent
                "setne %al" self.indent
                "cmpq $0, (%rsp)" self.indent
                "setne %cl" self.indent
                "andb %cl, %al" self.indent
                "movzbq %al, %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            InstValue::Or => {
                "popq %rax" self.indent
                "orq %rax, (%rsp)" self.indent
                "setne %al" self.indent
                "movzbq %al, %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            InstValue::Not => {
                "cmpq $0, (%rsp)" self.indent
                "sete %al" self.indent
                "movzbq %al, %rax" self.indent
                "movq %rax, (%rsp)" self.indent
            }
            InstValue::Eq => "sete" self.emit_comparison
            InstValue::Ne => "setne" self.emit_comparison
            InstValue::Lt => "setl" self.emit_comparison
            InstValue::Le => "setle" self.emit_comparison
            InstValue::Gt => "setg" self.emit_comparison
            InstValue::Ge => "setge" self.emit_comparison
            InstValue::Ult => "setb" self.emit_comparison
            InstValue::Ule => "setbe" self.emit_comparison
            InstValue::Ugt => "seta" self.emit_comparison
            InstValue::Uge => "setae" self.emit_comparison
            InstValue::NormalizeInt(builtin) => {
                builtin match
                    BuiltinType::I8 => "movsbq (%rsp), %rax" self.indent
                    BuiltinType::I16 => "movswq (%rsp), %rax" self.indent
                    BuiltinType::I32 => "movslq (%rsp), %rax" self.indent
                    BuiltinType::U8 => "movzbq (%rsp), %rax" self.indent
                    BuiltinType::U16 => "movzwq (%rsp), %rax" self.indent
                    BuiltinType::U32 => "movl (%rsp), %eax" self.indent
                    _ => return
                end
                "movq %rax, (%rsp)" self.indent
            }
            InstValue::FloatAdd32 => "addss" self.emit_float_binary
            InstValue::FloatAdd64 => "addsd" self.emit_float_binary
            InstValue::FloatSub32 => "subss" self.emit_float_binary
            InstValue::FloatSub64 => "subsd" self.emit_float_binary
            InstValue::FloatMul32 => "mulss" self.emit_float_binary
            InstValue::FloatMul64 => "mulsd" self.emit_float_binary
            InstValue::FloatDiv32 => "divss" self.emit_float_binary
            InstValue::FloatDiv64 => "divsd" self.emit_float_binary
            InstValue::FloatEq32 => "ucomiss" "sete" self.emit_float_comparison
            InstValue::FloatEq64 => "ucomisd" "sete" self.emit_float_comparison
            InstValue::FloatNe32 => "ucomiss" "setne" self.emit_float_comparison
            InstValue::FloatNe64 => "ucomisd" "setne" self.emit_float_comparison
            InstValue::FloatLt32 => "ucomiss" "setb" self.emit_float_comparison
            InstValue::FloatLt64 => "ucomisd" "setb" self.emit_float_comparison
            InstValue::FloatLe32 => "ucomiss" "setbe" self.emit_float_comparison
            InstValue::FloatLe64 => "ucomisd" "setbe" self.emit_float_comparison
            InstValue::FloatGt32 => "ucomiss" "seta" self.emit_float_comparison
            InstValue::FloatGt64 => "ucomisd" "seta" self.emit_float_comparison
            InstValue::FloatGe32 => "ucomiss" "setae" self.emit_float_comparison
            InstValue::FloatGe64 => "ucomisd" "setae" self.emit_float_comparison
            InstValue::CheckedAdd(builtin) => "arithmetic_error" builtin self.emit_checked_add
            InstValue::CheckedSub(builtin) => "arithmetic_error" builtin self.emit_checked_sub
            InstValue::CheckedMul(builtin) => "arithmetic_error" builtin self.emit_checked_mul
            InstValue::CheckedDiv(builtin) => "arithmetic_error" builtin false self.emit_checked_division
            InstValue::CheckedMod(builtin) => "arithmetic_error" builtin true self.emit_checked_division
            InstValue::CheckedShl(builtin) => builtin false self.emit_checked_shift
            InstValue::CheckedShr(builtin) => builtin true self.emit_checked_shift
            InstValue::NumericConvert(conversion) => conversion self.emit_numeric_conversion
            InstValue::NumericTry(numeric_try) => numeric_try self.emit_numeric_try
            InstValue::IntegerTry(integer_try) => integer_try self.emit_integer_try
            InstValue::FloatRound(rounding) => rounding self.emit_float_round
            InstValue::FloatFromDecimal => self.emit_float_from_decimal
            InstValue::FloatSignificand => self.emit_float_significand
            _ => {
                "Internal error: emit_arithmetic called with non-arithmetic InstValue\n" eprint
                1 exit
            }
        end
    }

    fn emit_checked_range self:mut$Emitter builtin:mut$BuiltinType failure:mut$str {
        builtin match
            BuiltinType::I8 => "movsbq (%rsp), %rax" self.indent
            BuiltinType::I16 => "movswq (%rsp), %rax" self.indent
            BuiltinType::I32 => "movslq (%rsp), %rax" self.indent
            BuiltinType::U8 => "movzbq (%rsp), %rax" self.indent
            BuiltinType::U16 => "movzwq (%rsp), %rax" self.indent
            BuiltinType::U32 => "movl (%rsp), %eax" self.indent
            _ => return
        end
        "cmpq %rax, (%rsp)" self.indent
        f"jne {failure}" self.indent
    }

    fn emit_checked_add self:mut$Emitter builtin:mut$BuiltinType failure:mut$str {
        "popq %rax" self.indent
        "addq %rax, (%rsp)" self.indent
        if 64 builtin.bit_width == then
            if builtin.is_unsigned then f"jc {failure}" else f"jo {failure}" fi self.indent
        else
            failure builtin self.emit_checked_range
        fi
    }

    fn emit_checked_sub self:mut$Emitter builtin:mut$BuiltinType failure:mut$str {
        "popq %rax" self.indent
        "subq %rax, (%rsp)" self.indent
        if 64 builtin.bit_width == then
            if builtin.is_unsigned then f"jc {failure}" else f"jo {failure}" fi self.indent
        else
            failure builtin self.emit_checked_range
        fi
    }

    fn emit_checked_mul self:mut$Emitter builtin:mut$BuiltinType failure:mut$str {
        "popq %rax" self.indent
        if builtin BuiltinType::U64 == then
            "mulq (%rsp)" self.indent
            "testq %rdx, %rdx" self.indent
            f"jnz {failure}" self.indent
        else
            "imulq (%rsp), %rax" self.indent
            if builtin BuiltinType::I64 == then f"jo {failure}" self.indent fi
        fi
        "movq %rax, (%rsp)" self.indent
        if 64 builtin.bit_width != then failure builtin self.emit_checked_range fi
    }

    fn emit_checked_division
        self:mut$Emitter
        remainder:bool
        builtin:mut$BuiltinType
        failure:mut$str
    {
        "popq %rbx" self.indent
        "testq %rbx, %rbx" self.indent
        f"jz {failure}" self.indent
        "movq (%rsp), %rax" self.indent
        if builtin.is_unsigned then
            "xorq %rdx, %rdx" self.indent
            "divq %rbx" self.indent
        else
            builtin (i64) (BuiltinType) Type::Builtin = integer_type
            integer_type.get_integer_min = minimum
            self.emit_uid = uid
            "cmpq $-1, %rbx" self.indent
            f"jne .Ldiv_ready_{uid}" self.indent
            f"movabsq ${minimum}, %rcx" self.indent
            "cmpq %rcx, %rax" self.indent
            f"je {failure}" self.indent
            f".Ldiv_ready_{uid}:" self.line
            "cqto" self.indent
            "idivq %rbx" self.indent
        fi
        if remainder then "movq %rdx, (%rsp)" else "movq %rax, (%rsp)" fi self.indent
    }

    fn emit_checked_shift self:mut$Emitter right:bool builtin:mut$BuiltinType {
        "popq %rcx" self.indent
        f"cmpq ${builtin.bit_width}, %rcx" self.indent
        "jae arithmetic_error" self.indent
        if right then
            if builtin.is_unsigned then "shrq %cl, (%rsp)" else "sarq %cl, (%rsp)" fi self.indent
        else
            "shlq %cl, (%rsp)" self.indent
        fi
    }

    fn emit_normalize_numeric self:mut$Emitter builtin:mut$BuiltinType {
        builtin match
            BuiltinType::I8 => "movsbq (%rsp), %rax" self.indent
            BuiltinType::I16 => "movswq (%rsp), %rax" self.indent
            BuiltinType::I32 => "movslq (%rsp), %rax" self.indent
            BuiltinType::U8 => "movzbq (%rsp), %rax" self.indent
            BuiltinType::U16 => "movzwq (%rsp), %rax" self.indent
            BuiltinType::U32 => "movl (%rsp), %eax" self.indent
            _ => return
        end
        "movq %rax, (%rsp)" self.indent
    }

    fn emit_integer_to_float self:mut$Emitter source:mut$BuiltinType target:mut$BuiltinType {
        self.emit_uid = uid
        "movq (%rsp), %rax" self.indent
        if source BuiltinType::U64 == then
            "testq %rax, %rax" self.indent
            f"jns .Luint_float_ready_{uid}" self.indent
            "movq %rax, %rcx" self.indent
            "andq $1, %rcx" self.indent
            "shrq $1, %rax" self.indent
            "orq %rcx, %rax" self.indent
            if target BuiltinType::F32 == then
                "cvtsi2ssq %rax, %xmm0" self.indent
                "addss %xmm0, %xmm0" self.indent
            else
                "cvtsi2sdq %rax, %xmm0" self.indent
                "addsd %xmm0, %xmm0" self.indent
            fi
            f"jmp .Luint_float_done_{uid}" self.indent
            f".Luint_float_ready_{uid}:" self.line
        fi
        if target BuiltinType::F32 == then
            "cvtsi2ssq %rax, %xmm0" self.indent
        else
            "cvtsi2sdq %rax, %xmm0" self.indent
        fi
        f".Luint_float_done_{uid}:" self.line
        if target BuiltinType::F32 == then
            "movd %xmm0, %eax" self.indent
            "movq %rax, (%rsp)" self.indent
        else
            "movq %xmm0, (%rsp)" self.indent
        fi
    }

    fn emit_float_constant self:mut$Emitter value:str source:mut$BuiltinType register:str {
        self.emit_uid = uid
        f"jmp .Lfloat_constant_done_{uid}" self.indent
        if source BuiltinType::F32 == then ".align 4" else ".align 8" fi self.line
        f".Lfloat_constant_{uid}:" self.line
        if source BuiltinType::F32 == then f".float {value}" else f".double {value}" fi self.line
        f".Lfloat_constant_done_{uid}:" self.line
        if source BuiltinType::F32 == then
            f"movss .Lfloat_constant_{uid}(%rip), {register}" self.indent
        else
            f"movsd .Lfloat_constant_{uid}(%rip), {register}" self.indent
        fi
    }

    fn emit_truncate_to_u64 self:mut$Emitter source:mut$BuiltinType failure:mut$str {
        self.emit_uid = uid
        if source BuiltinType::F32 == then
            "xorps %xmm1, %xmm1" self.indent
            "ucomiss %xmm1, %xmm0" self.indent
        else
            "xorpd %xmm1, %xmm1" self.indent
            "ucomisd %xmm1, %xmm0" self.indent
        fi
        f"jp {failure}" self.indent
        f"jb {failure}" self.indent
        "%xmm1" source "18446744073709551616.0" self.emit_float_constant
        if source BuiltinType::F32 == then
            "ucomiss %xmm1, %xmm0" self.indent
        else
            "ucomisd %xmm1, %xmm0" self.indent
        fi
        f"jae {failure}" self.indent
        "%xmm1" source "9223372036854775808.0" self.emit_float_constant
        if source BuiltinType::F32 == then
            "ucomiss %xmm1, %xmm0" self.indent
            f"jb .Ltrunc_u64_low_{uid}" self.indent
            "subss %xmm1, %xmm0" self.indent
            "cvttss2siq %xmm0, %rax" self.indent
        else
            "ucomisd %xmm1, %xmm0" self.indent
            f"jb .Ltrunc_u64_low_{uid}" self.indent
            "subsd %xmm1, %xmm0" self.indent
            "cvttsd2siq %xmm0, %rax" self.indent
        fi
        "btc $63, %rax" self.indent
        f"jmp .Ltrunc_u64_done_{uid}" self.indent
        f".Ltrunc_u64_low_{uid}:" self.line
        if source BuiltinType::F32 == then
            "cvttss2siq %xmm0, %rax" self.indent
        else
            "cvttsd2siq %xmm0, %rax" self.indent
        fi
        f".Ltrunc_u64_done_{uid}:" self.line
        "movq %rax, (%rsp)" self.indent
    }

    fn emit_float_to_integer
        self:mut$Emitter
        source:mut$BuiltinType
        target:mut$BuiltinType
        failure:mut$str
    {
        if source BuiltinType::F32 == then
            "movss (%rsp), %xmm0" self.indent
        else
            "movsd (%rsp), %xmm0" self.indent
        fi
        if target BuiltinType::U64 == then failure source self.emit_truncate_to_u64 return fi
        if source BuiltinType::F32 == then
            "cvttss2siq %xmm0, %rax" self.indent
        else
            "cvttsd2siq %xmm0, %rax" self.indent
        fi
        "movq %rax, (%rsp)" self.indent
        if target BuiltinType::I64 == then
            self.emit_uid = uid
            "movabsq $-9223372036854775808, %rcx" self.indent
            "cmpq %rcx, %rax" self.indent
            f"jne .Ltrunc_i64_done_{uid}" self.indent
            if source BuiltinType::F32 == then
                "cvtsi2ssq %rax, %xmm1" self.indent
                "ucomiss %xmm1, %xmm0" self.indent
            else
                "cvtsi2sdq %rax, %xmm1" self.indent
                "ucomisd %xmm1, %xmm0" self.indent
            fi
            f"jp {failure}" self.indent
            f"jne {failure}" self.indent
            f".Ltrunc_i64_done_{uid}:" self.line
        else
            failure target self.emit_checked_range
            target self.emit_normalize_numeric
        fi
    }

    fn emit_numeric_conversion self:mut$Emitter conversion:$NumericConversion {
        if
        conversion.kind NumericConversionKind::FromBits ==
        conversion.kind NumericConversionKind::ToBits == ||
        then
            return
        fi
        if conversion.source.is_integer conversion.target.is_integer && then
            conversion.target self.emit_normalize_numeric
            return
        fi
        if conversion.source.is_integer conversion.target.is_float && then
            conversion.target conversion.source self.emit_integer_to_float
            return
        fi
        if
        conversion.source BuiltinType::F32 ==
        conversion.target BuiltinType::F64 == &&
        then
            "movss (%rsp), %xmm0" self.indent
            "cvtss2sd %xmm0, %xmm0" self.indent
            "movq %xmm0, (%rsp)" self.indent
            return
        fi
        if
        conversion.source BuiltinType::F64 ==
        conversion.target BuiltinType::F32 == &&
        then
            "movsd (%rsp), %xmm0" self.indent
            "cvtsd2ss %xmm0, %xmm0" self.indent
            "movd %xmm0, %eax" self.indent
            "movq %rax, (%rsp)" self.indent
            return
        fi
        if conversion.source.is_float conversion.target.is_integer && then
            "arithmetic_error" conversion.target conversion.source self.emit_float_to_integer
        fi
    }

    fn emit_numeric_try self:mut$Emitter numeric_try:$NumericTry {
        if numeric_try.source Type::Builtin(source) is then
            numeric_try.target = target
            self.emit_uid = uid
            f".Lnumeric_try_fail_{uid}" = failure
            f".Lnumeric_try_done_{uid}" = done_label
            "movq (%rsp), %r10" self.indent

            if source.is_integer target.is_integer && then
                target self.emit_normalize_numeric
                if source.is_unsigned ! target.is_unsigned && then
                    "testq %r10, %r10" self.indent
                    f"js {failure}" self.indent
                elif source.is_unsigned target.is_unsigned ! && then
                    "cmpq $0, (%rsp)" self.indent
                    f"jl {failure}" self.indent
                fi
                "cmpq %r10, (%rsp)" self.indent
                f"jne {failure}" self.indent
            elif source.is_integer target.is_float && then
                target source self.emit_integer_to_float
                if target BuiltinType::F32 == then
                    "movss (%rsp), %xmm0" self.indent
                else
                    "movsd (%rsp), %xmm0" self.indent
                fi
                if source BuiltinType::U64 == then
                    "%xmm1" target "18446744073709551616.0" self.emit_float_constant
                    if target BuiltinType::F32 == then
                        "ucomiss %xmm1, %xmm0" self.indent
                    else
                        "ucomisd %xmm1, %xmm0" self.indent
                    fi
                    f"jae {failure}" self.indent
                    "%xmm1" target "9223372036854775808.0" self.emit_float_constant
                    if target BuiltinType::F32 == then
                        "ucomiss %xmm1, %xmm0" self.indent
                        f"jb .Lnumeric_try_uint_low_{uid}" self.indent
                        "subss %xmm1, %xmm0" self.indent
                        "cvttss2siq %xmm0, %rax" self.indent
                    else
                        "ucomisd %xmm1, %xmm0" self.indent
                        f"jb .Lnumeric_try_uint_low_{uid}" self.indent
                        "subsd %xmm1, %xmm0" self.indent
                        "cvttsd2siq %xmm0, %rax" self.indent
                    fi
                    "btc $63, %rax" self.indent
                    f"jmp .Lnumeric_try_uint_done_{uid}" self.indent
                    f".Lnumeric_try_uint_low_{uid}:" self.line
                    if target BuiltinType::F32 == then
                        "cvttss2siq %xmm0, %rax" self.indent
                    else
                        "cvttsd2siq %xmm0, %rax" self.indent
                    fi
                    f".Lnumeric_try_uint_done_{uid}:" self.line
                elif target BuiltinType::F32 == then
                    "cvttss2siq %xmm0, %rax" self.indent
                else
                    "cvttsd2siq %xmm0, %rax" self.indent
                fi
                "cmpq %r10, %rax" self.indent
                f"jne {failure}" self.indent
            elif source.is_float target.is_integer && then
                failure target source self.emit_float_to_integer
                "movq (%rsp), %r11" self.indent
                source target self.emit_integer_to_float
                "movq %r10, %xmm1" self.indent
                if source BuiltinType::F32 == then
                    "movss (%rsp), %xmm0" self.indent
                    "ucomiss %xmm1, %xmm0" self.indent
                else
                    "movsd (%rsp), %xmm0" self.indent
                    "ucomisd %xmm1, %xmm0" self.indent
                fi
                f"jp {failure}" self.indent
                f"jne {failure}" self.indent
                "movq %r11, (%rsp)" self.indent
            elif source.is_float target.is_float && then
                if source target != then
                    target source NumericConversionKind::Rounded NumericConversion = conversion
                    conversion self.emit_numeric_conversion
                fi
                if source BuiltinType::F64 == target BuiltinType::F32 == && then
                    "movq (%rsp), %r11" self.indent
                    BuiltinType::F64 BuiltinType::F32 NumericConversionKind::Exact NumericConversion
                    self.emit_numeric_conversion
                    "movq %r10, %xmm1" self.indent
                    "movsd (%rsp), %xmm0" self.indent
                    "ucomisd %xmm1, %xmm0" self.indent
                    f"jp {failure}" self.indent
                    f"jne {failure}" self.indent
                    "movq %r11, (%rsp)" self.indent
                fi
            else
                f"jmp {failure}" self.indent
            fi
            "movq $1, %rax" self.indent
            f"jmp {done_label}" self.indent
            f"{failure}:" self.line
            "movq $0, (%rsp)" self.indent
            "xorq %rax, %rax" self.indent
            f"{done_label}:" self.line
            "pushq %rax" self.indent
        fi
    }

    fn emit_float_binary self:mut$Emitter instruction:str {
        "movq (%rsp), %xmm0" self.indent
        "addq $8, %rsp" self.indent
        "movq (%rsp), %xmm1" self.indent
        f"{instruction} %xmm0, %xmm1" self.indent
        "movq %xmm1, (%rsp)" self.indent
    }

    fn emit_float_comparison self:mut$Emitter setcc:str instruction:str {
        "movq (%rsp), %xmm0" self.indent
        "addq $8, %rsp" self.indent
        f"{instruction} (%rsp), %xmm0" self.indent
        f"{setcc} %al" self.indent
        if "setne" setcc == then
            "setp %cl" self.indent
            "orb %cl, %al" self.indent
        else
            "setnp %cl" self.indent
            "andb %cl, %al" self.indent
        fi
        "movzbq %al, %rax" self.indent
        "movq %rax, (%rsp)" self.indent
    }

    fn emit_float_round self:mut$Emitter rounding:$FloatRound {
        rounding.method match
            "__float_floor" => 1
            "__float_ceil" => 2
            "__float_trunc" => 3
            _ => 0
        end = mode
        if rounding.target BuiltinType::F32 == then
            "movss (%rsp), %xmm0" self.indent
            f"roundss ${mode}, %xmm0, %xmm0" self.indent
            "movd %xmm0, %eax" self.indent
            "movq %rax, (%rsp)" self.indent
        else
            "movsd (%rsp), %xmm0" self.indent
            f"roundsd ${mode}, %xmm0, %xmm0" self.indent
            "movq %xmm0, (%rsp)" self.indent
        fi
    }

    fn emit_integer_try self:mut$Emitter integer_try:$IntegerTry {
        self.emit_uid = uid
        f".Linteger_try_fail_{uid}" = failure
        f".Linteger_try_done_{uid}" = done_label
        integer_try.kind match
            IntegerTryKind::Add => { failure integer_try.target self.emit_checked_add }
            IntegerTryKind::Sub => { failure integer_try.target self.emit_checked_sub }
            IntegerTryKind::Mul => { failure integer_try.target self.emit_checked_mul }
            IntegerTryKind::Div => { failure integer_try.target false self.emit_checked_division }
            IntegerTryKind::Mod => { failure integer_try.target true self.emit_checked_division }
        end
        integer_try.target self.emit_normalize_numeric
        "pushq $1" self.indent
        f"jmp {done_label}" self.indent
        f"{failure}:" self.line
        "movq $0, (%rsp)" self.indent
        "pushq $0" self.indent
        f"{done_label}:" self.line
    }

    fn emit_float_from_decimal self:mut$Emitter {
        self.emit_uid = uid
        "fildq (%rsp)" self.indent
        "addq $8, %rsp" self.indent
        "popq %rcx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jz .Ldecimal_float_done_{uid}" self.indent
        "xorq %rdx, %rdx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jns .Ldecimal_float_abs_ready_{uid}" self.indent
        "negq %rcx" self.indent
        "movq $1, %rdx" self.indent
        f".Ldecimal_float_abs_ready_{uid}:" self.line
        "fld1" self.indent
        "fildl float_decimal_ten(%rip)" self.indent
        f".Ldecimal_float_power_loop_{uid}:" self.line
        "testq $1, %rcx" self.indent
        f"jz .Ldecimal_float_power_skip_{uid}" self.indent
        "fmul %st(0), %st(1)" self.indent
        f".Ldecimal_float_power_skip_{uid}:" self.line
        "shrq $1, %rcx" self.indent
        f"jz .Ldecimal_float_power_done_{uid}" self.indent
        "fmul %st(0), %st(0)" self.indent
        f"jmp .Ldecimal_float_power_loop_{uid}" self.indent
        f".Ldecimal_float_power_done_{uid}:" self.line
        "fstp %st(0)" self.indent
        "testq %rdx, %rdx" self.indent
        f"jnz .Ldecimal_float_divide_{uid}" self.indent
        "fmulp %st(0), %st(1)" self.indent
        f"jmp .Ldecimal_float_done_{uid}" self.indent
        f".Ldecimal_float_divide_{uid}:" self.line
        "fdivrp %st(0), %st(1)" self.indent
        f".Ldecimal_float_done_{uid}:" self.line
        "subq $8, %rsp" self.indent
        "fstpl (%rsp)" self.indent
    }

    fn emit_float_significand self:mut$Emitter {
        self.emit_uid = uid
        "fldl (%rsp)" self.indent
        "addq $8, %rsp" self.indent
        "popq %rcx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jz .Lfloat_significand_done_{uid}" self.indent
        "xorq %rdx, %rdx" self.indent
        "testq %rcx, %rcx" self.indent
        f"jns .Lfloat_significand_abs_ready_{uid}" self.indent
        "negq %rcx" self.indent
        "movq $1, %rdx" self.indent
        f".Lfloat_significand_abs_ready_{uid}:" self.line
        "fld1" self.indent
        "fildl float_decimal_ten(%rip)" self.indent
        f".Lfloat_significand_power_loop_{uid}:" self.line
        "testq $1, %rcx" self.indent
        f"jz .Lfloat_significand_power_skip_{uid}" self.indent
        "fmul %st(0), %st(1)" self.indent
        f".Lfloat_significand_power_skip_{uid}:" self.line
        "shrq $1, %rcx" self.indent
        f"jz .Lfloat_significand_power_done_{uid}" self.indent
        "fmul %st(0), %st(0)" self.indent
        f"jmp .Lfloat_significand_power_loop_{uid}" self.indent
        f".Lfloat_significand_power_done_{uid}:" self.line
        "fstp %st(0)" self.indent
        "testq %rdx, %rdx" self.indent
        f"jnz .Lfloat_significand_divide_{uid}" self.indent
        "fmulp %st(0), %st(1)" self.indent
        f"jmp .Lfloat_significand_done_{uid}" self.indent
        f".Lfloat_significand_divide_{uid}:" self.line
        "fdivrp %st(0), %st(1)" self.indent
        f".Lfloat_significand_done_{uid}:" self.line
        "frndint" self.indent
        "subq $8, %rsp" self.indent
        "fistpq (%rsp)" self.indent
    }

    # ============================================================================
    # Emit control flow / variable / function operations
    # ============================================================================

    fn emit_control_flow self:mut$Emitter inst:mut$InstValue is_global:bool {
        inst match
            InstValue::Label(label) => f".L{label}:" self.line
            InstValue::Jump(label) => f"jmp .L{label}" self.indent
            InstValue::JumpNe(label) => {
                "popq %rax" self.indent
                "testq %rax, %rax" self.indent
                f"jz .L{label}" self.indent
            }
            InstValue::GlobalsInit => {
                # Nothing needed, BSS handles it
            }
            InstValue::GlobalGet(global_index) => {
                global_index WORD_SIZE * = offset
                f"movq globals+{offset}(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::GlobalSet(global_index) => {
                global_index WORD_SIZE * = offset
                "popq %rax" self.indent
                f"movq %rax, globals+{offset}(%rip)" self.indent
            }
            InstValue::LocalsInit(count) => {
                if 0 count != then
                    "movq %r14, %rdi" self.indent
                    f"movq ${count}, %rcx" self.indent
                    "xorq %rax, %rax" self.indent
                    "rep stosq" self.indent
                    f"addq ${count WORD_SIZE *}, %r14" self.indent
                fi
            }
            InstValue::LocalsUninit(count) => {
                if 0 count != then
                    f"subq ${count WORD_SIZE *}, %r14" self.indent
                fi
            }
            InstValue::LocalGet(local_index) => {
                local_index 1 + WORD_SIZE * = offset
                f"movq -{offset}(%r14), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::LocalSet(local_index) => {
                local_index 1 + WORD_SIZE * = offset
                "popq %rax" self.indent
                f"movq %rax, -{offset}(%r14)" self.indent
            }
            InstValue::ConstantLoad(constant_index) => {
                constant_index WORD_SIZE * = offset
                f"movq constants+{offset}(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::ConstantStore(constant_index) => {
                constant_index WORD_SIZE * = offset
                "popq %rax" self.indent
                f"movq %rax, constants+{offset}(%rip)" self.indent
            }
            InstValue::FnCall(fn_name) => {
                fn_name sanitize_name = fn_label
                "ret" f"fn_{fn_label}" self.emit_call_via_return_stack
            }
            InstValue::FnExec => {
                self.emit_uid = uid
                # Save the caller's active closure env on the env stack and switch
                # current_env to the popped closure record so its body can access
                # captured values via InstCaptureLoad. After the callee returns,
                # restore the previous env.
                "popq %rax" self.indent
                "movq current_env(%rip), %rbx" self.indent
                "movq env_sp(%rip), %rcx" self.indent
                f"cmpq ${RETURN_STACK_SIZE}, %rcx" self.indent
                "jge env_stack_overflow" self.indent
                "movq %rbx, env_stack(%rcx)" self.indent
                "addq $8, %rcx" self.indent
                "movq %rcx, env_sp(%rip)" self.indent
                "movq %rax, current_env(%rip)" self.indent
                f"leaq .Lret_{uid}(%rip), %rcx" self.indent
                "movq %rcx, (%r14)" self.indent
                "addq $8, %r14" self.indent
                "movq (%rax), %rax" self.indent
                "jmpq *%rax" self.indent
                f".Lret_{uid}:" self.line
                "movq env_sp(%rip), %rcx" self.indent
                "subq $8, %rcx" self.indent
                "movq %rcx, env_sp(%rip)" self.indent
                "movq env_stack(%rcx), %rax" self.indent
                "movq %rax, current_env(%rip)" self.indent
            }
            InstValue::CaptureLoad(capture_index) => {
                capture_index 1 + WORD_SIZE * = offset
                "movq current_env(%rip), %rax" self.indent
                f"movq {offset}(%rax), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::ClosureRecord(capture_count) => {
                capture_count 1 + WORD_SIZE * = record_size
                # Bump-allocate the record from the heap.
                "leaq heap(%rip), %rbx" self.indent
                "movq heap_ptr(%rip), %rcx" self.indent
                "leaq (%rbx,%rcx), %rdx" self.indent
                f"addq ${record_size}, %rcx" self.indent
                "movq %rcx, heap_ptr(%rip)" self.indent
                # Stack top is the function pointer; store it at offset 0.
                "popq %rax" self.indent
                "movq %rax, (%rdx)" self.indent
                # Captures were pushed in order 0..N-1, so the top of the stack is
                # capture N-1. Pop them in reverse to fill record[N], record[N-1],
                # ..., record[1].
                capture_count = capture_remaining
                while 0 capture_remaining > do
                    capture_remaining WORD_SIZE * = field_offset
                    "popq %rax" self.indent
                    f"movq %rax, {field_offset}(%rdx)" self.indent
                    capture_remaining 1 - = capture_remaining
                done
                "pushq %rdx" self.indent
            }
            InstValue::FnPush(fn_name) => {
                fn_name sanitize_name = fn_label
                f"leaq fn_{fn_label}(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::FnPushStatic(fn_name) => {
                fn_name sanitize_name = fn_label
                f"leaq closure_{fn_label}(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::FnReturn => {
                if is_global then
                    "movq $60, %rax" self.indent
                    "xorq %rdi, %rdi" self.indent
                    "syscall" self.indent
                else
                    "subq $8, %r14" self.indent
                    "jmpq *(%r14)" self.indent
                fi
            }
            _ => {
                "Internal error: emit_control_flow called with non-control-flow InstValue\n" eprint
                1 exit
            }
        end
    }

    # ============================================================================
    # Emit memory operations
    # ============================================================================

    fn emit_memory self:mut$Emitter inst:mut$InstValue {
        inst match
            InstValue::HeapAlloc => {
                "popq %rdi" self.indent
                "heap_alloc_done" "heap_alloc" self.emit_call_via_return_stack
            }
            InstValue::HeapFree => {
                "popq %rdi" self.indent
                "heap_free_done" "heap_free" self.emit_call_via_return_stack
            }
            InstValue::Load8 => "%eax" "movzbl" self.emit_load
            InstValue::Load16 => "%eax" "movzwl" self.emit_load
            InstValue::Load32 => "%eax" "movl" self.emit_load
            InstValue::Load64 => "%rax" "movq" self.emit_load
            InstValue::Store8 => "%bl" "movb" self.emit_store
            InstValue::Store16 => "%bx" "movw" self.emit_store
            InstValue::Store32 => "%ebx" "movl" self.emit_store
            InstValue::Store64 => "%rbx" "movq" self.emit_store
            _ => {
                "Internal error: emit_memory called with non-memory InstValue\n" eprint
                1 exit
            }
        end
    }

    # ============================================================================
    # Emit IO operations
    # ============================================================================

    fn emit_io_ops self:mut$Emitter inst:mut$InstValue {
        inst match
            InstValue::PrintInt => {
                "popq %rdi" self.indent
                "print_done" "print_int" self.emit_call_via_return_stack
            }
            InstValue::PrintUint => {
                "popq %rdi" self.indent
                "print_uint_done" "print_uint" self.emit_call_via_return_stack
            }
            InstValue::PrintBool => {
                self.emit_uid = uid
                "popq %rax" self.indent
                "testq %rax, %rax" self.indent
                f"jz .Lpb_false_{uid}" self.indent
                "leaq bool_true(%rip), %rsi" self.indent
                "movq $4, %rdx" self.indent
                f"jmp .Lpb_write_{uid}" self.indent
                f".Lpb_false_{uid}:" self.line
                "leaq bool_false(%rip), %rsi" self.indent
                "movq $5, %rdx" self.indent
                f".Lpb_write_{uid}:" self.line
                "movq $1, %rdi" self.indent
                "movq $1, %rax" self.indent
                "syscall" self.indent
            }
            InstValue::PrintStr => {
                "popq %rdi" self.indent
                "print_done" "print_str" self.emit_call_via_return_stack
            }
            InstValue::PrintChar => {
                "popq %rdi" self.indent
                "print_char_encoded" "encode_char" self.emit_call_via_return_stack
                "movq $1, %rdi" self.indent
                "movq $1, %rax" self.indent
                "syscall" self.indent
            }
            InstValue::PrintCstr => {
                self.emit_uid = uid
                "popq %rsi" self.indent
                "movq %rsi, %rdi" self.indent
                f".Lpc_scan_{uid}:" self.line
                "cmpb $0, (%rsi)" self.indent
                f"je .Lpc_done_{uid}" self.indent
                "incq %rsi" self.indent
                f"jmp .Lpc_scan_{uid}" self.indent
                f".Lpc_done_{uid}:" self.line
                "movq %rsi, %rdx" self.indent
                "subq %rdi, %rdx" self.indent
                "movq %rdi, %rsi" self.indent
                "movq $1, %rdi" self.indent
                "movq $1, %rax" self.indent
                "syscall" self.indent
            }
            InstValue::FstringConcat(fstring_count) => {
                f"movq ${fstring_count}, %rdi" self.indent
                "concat_done" "str_concat" self.emit_call_via_return_stack
            }
            InstValue::PrimitiveToStr(builtin) => {
                "popq %rdi" self.indent
                0 = kind
                if builtin.is_unsigned then
                    1 = kind
                elif builtin BuiltinType::Bool == then
                    2 = kind
                elif builtin BuiltinType::Char == then
                    3 = kind
                elif builtin BuiltinType::Cstr == then
                    4 = kind
                fi
                f"movq ${kind}, %r8" self.indent
                f"to_str_{builtin.format}_done" "primitive_to_str" self.emit_call_via_return_stack
            }
            _ => {
                "Internal error: emit_io_ops called with non-IO InstValue\n" eprint
                1 exit
            }
        end
    }

    # ============================================================================
    # Emit string equality
    # ============================================================================

    fn emit_str_eq self:mut$Emitter {
        self.emit_uid = uid
        "popq %rsi" self.indent
        "popq %rdi" self.indent
        "movq (%rdi), %rcx" self.indent
        "cmpq (%rsi), %rcx" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent
        "leaq 8(%rdi), %rdi" self.indent
        "leaq 8(%rsi), %rsi" self.indent
        "repe cmpsb" self.indent
        f"jne .Lstreq_ne_{uid}" self.indent
        "pushq $1" self.indent
        f"jmp .Lstreq_done_{uid}" self.indent
        f".Lstreq_ne_{uid}:" self.line
        "pushq $0" self.indent
        f".Lstreq_done_{uid}:" self.line
    }

    # ============================================================================
    # Emit single instruction (main dispatch)
    # ============================================================================

    fn emit_inst self:mut$Emitter inst:mut$InstValue is_global:bool {
        inst match
            # Stack operations
            InstValue::Drop => inst self.emit_stack_ops
            InstValue::Dup => inst self.emit_stack_ops
            InstValue::Over => inst self.emit_stack_ops
            InstValue::Push => inst self.emit_stack_ops
            InstValue::PushFloat32 => inst self.emit_stack_ops
            InstValue::PushFloat64 => inst self.emit_stack_ops
            InstValue::PushChar => inst self.emit_stack_ops
            InstValue::PushStr => inst self.emit_stack_ops
            InstValue::PushStaticArray => inst self.emit_stack_ops
            InstValue::Rot => inst self.emit_stack_ops
            InstValue::Swap => inst self.emit_stack_ops

            # Arithmetic / bitshift / bitwise / boolean / comparison
            InstValue::Add => inst self.emit_arithmetic
            InstValue::Sub => inst self.emit_arithmetic
            InstValue::Mul => inst self.emit_arithmetic
            InstValue::Div => inst self.emit_arithmetic
            InstValue::Mod => inst self.emit_arithmetic
            InstValue::Shl => inst self.emit_arithmetic
            InstValue::Shr => inst self.emit_arithmetic
            InstValue::BitAnd => inst self.emit_arithmetic
            InstValue::BitOr => inst self.emit_arithmetic
            InstValue::BitXor => inst self.emit_arithmetic
            InstValue::BitNot => inst self.emit_arithmetic
            InstValue::And => inst self.emit_arithmetic
            InstValue::Or => inst self.emit_arithmetic
            InstValue::Not => inst self.emit_arithmetic
            InstValue::Eq => inst self.emit_arithmetic
            InstValue::Ne => inst self.emit_arithmetic
            InstValue::Lt => inst self.emit_arithmetic
            InstValue::Le => inst self.emit_arithmetic
            InstValue::Gt => inst self.emit_arithmetic
            InstValue::Ge => inst self.emit_arithmetic
            InstValue::Ult => inst self.emit_arithmetic
            InstValue::Ule => inst self.emit_arithmetic
            InstValue::Ugt => inst self.emit_arithmetic
            InstValue::Uge => inst self.emit_arithmetic
            InstValue::UDiv => inst self.emit_arithmetic
            InstValue::UMod => inst self.emit_arithmetic
            InstValue::UShr => inst self.emit_arithmetic
            InstValue::NormalizeInt => inst self.emit_arithmetic
            InstValue::CheckedAdd => inst self.emit_arithmetic
            InstValue::CheckedSub => inst self.emit_arithmetic
            InstValue::CheckedMul => inst self.emit_arithmetic
            InstValue::CheckedDiv => inst self.emit_arithmetic
            InstValue::CheckedMod => inst self.emit_arithmetic
            InstValue::CheckedShl => inst self.emit_arithmetic
            InstValue::CheckedShr => inst self.emit_arithmetic
            InstValue::NumericConvert => inst self.emit_arithmetic
            InstValue::NumericTry => inst self.emit_arithmetic
            InstValue::IntegerTry => inst self.emit_arithmetic
            InstValue::FloatRound => inst self.emit_arithmetic
            InstValue::FloatFromDecimal => inst self.emit_arithmetic
            InstValue::FloatSignificand => inst self.emit_arithmetic
            InstValue::FloatAdd32 => inst self.emit_arithmetic
            InstValue::FloatAdd64 => inst self.emit_arithmetic
            InstValue::FloatSub32 => inst self.emit_arithmetic
            InstValue::FloatSub64 => inst self.emit_arithmetic
            InstValue::FloatMul32 => inst self.emit_arithmetic
            InstValue::FloatMul64 => inst self.emit_arithmetic
            InstValue::FloatDiv32 => inst self.emit_arithmetic
            InstValue::FloatDiv64 => inst self.emit_arithmetic
            InstValue::FloatEq32 => inst self.emit_arithmetic
            InstValue::FloatEq64 => inst self.emit_arithmetic
            InstValue::FloatNe32 => inst self.emit_arithmetic
            InstValue::FloatNe64 => inst self.emit_arithmetic
            InstValue::FloatLt32 => inst self.emit_arithmetic
            InstValue::FloatLt64 => inst self.emit_arithmetic
            InstValue::FloatLe32 => inst self.emit_arithmetic
            InstValue::FloatLe64 => inst self.emit_arithmetic
            InstValue::FloatGt32 => inst self.emit_arithmetic
            InstValue::FloatGt64 => inst self.emit_arithmetic
            InstValue::FloatGe32 => inst self.emit_arithmetic
            InstValue::FloatGe64 => inst self.emit_arithmetic

            # Control flow / variables / functions
            InstValue::Label => is_global inst self.emit_control_flow
            InstValue::Jump => is_global inst self.emit_control_flow
            InstValue::JumpNe => is_global inst self.emit_control_flow
            InstValue::GlobalsInit => is_global inst self.emit_control_flow
            InstValue::GlobalGet => is_global inst self.emit_control_flow
            InstValue::GlobalSet => is_global inst self.emit_control_flow
            InstValue::LocalsInit => is_global inst self.emit_control_flow
            InstValue::LocalsUninit => is_global inst self.emit_control_flow
            InstValue::LocalGet => is_global inst self.emit_control_flow
            InstValue::LocalSet => is_global inst self.emit_control_flow
            InstValue::ConstantLoad => is_global inst self.emit_control_flow
            InstValue::ConstantStore => is_global inst self.emit_control_flow
            InstValue::CaptureLoad => is_global inst self.emit_control_flow
            InstValue::ClosureRecord => is_global inst self.emit_control_flow
            InstValue::FnCall => is_global inst self.emit_control_flow
            InstValue::FnExec => is_global inst self.emit_control_flow
            InstValue::FnPush => is_global inst self.emit_control_flow
            InstValue::FnPushStatic => is_global inst self.emit_control_flow
            InstValue::FnReturn => is_global inst self.emit_control_flow

            # Memory operations
            InstValue::HeapAlloc => inst self.emit_memory
            InstValue::HeapFree => inst self.emit_memory
            InstValue::Load8 => inst self.emit_memory
            InstValue::Load16 => inst self.emit_memory
            InstValue::Load32 => inst self.emit_memory
            InstValue::Load64 => inst self.emit_memory
            InstValue::Store8 => inst self.emit_memory
            InstValue::Store16 => inst self.emit_memory
            InstValue::Store32 => inst self.emit_memory
            InstValue::Store64 => inst self.emit_memory

            # IO operations
            InstValue::PrintInt => inst self.emit_io_ops
            InstValue::PrintUint => inst self.emit_io_ops
            InstValue::PrintBool => inst self.emit_io_ops
            InstValue::PrintStr => inst self.emit_io_ops
            InstValue::PrintChar => inst self.emit_io_ops
            InstValue::PrintCstr => inst self.emit_io_ops
            InstValue::FstringConcat => inst self.emit_io_ops
            InstValue::PrimitiveToStr => inst self.emit_io_ops

            # String equality
            InstValue::StrEq => self.emit_str_eq

            # Syscalls
            InstValue::Syscall0 => 0 self.emit_syscall
            InstValue::Syscall1 => 1 self.emit_syscall
            InstValue::Syscall2 => 2 self.emit_syscall
            InstValue::Syscall3 => 3 self.emit_syscall
            InstValue::Syscall4 => 4 self.emit_syscall
            InstValue::Syscall5 => 5 self.emit_syscall
            InstValue::Syscall6 => 6 self.emit_syscall

            # argc / argv
            InstValue::Argc => {
                "movq __argc(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::Argv => {
                "movq __argv(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
            InstValue::Envp => {
                "movq __envp(%rip), %rax" self.indent
                "pushq %rax" self.indent
            }
        end
    }

    # ============================================================================
    # Main emit function
    # ============================================================================
}

fn emit program:Program -> str {
    program Emitter::new = emitter
    emitter.emit_bss
    emitter.emit_data
    emitter.emit_text
    emitter.asm.build
}
