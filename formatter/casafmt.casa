# Casa autoformatter
#
# Reads Casa source from stdin, writes formatted source to stdout.
# On parse error, echoes the original source unchanged and exits with code 1.
#
# Build with the configured release compiler:
#   ./casac -L lib formatter/casafmt.casa -o casafmt
import "../lib/std.casa" as std
import "../lib/io.casa" as io
import "../compiler/error.casa" as error
import "../compiler/products.casa" as products
import "format.casa" as format

pub fn read_all_stdin -> std::Bytes {
    io::StdinReader::new = reader
    std::Bytes::new = bytes
    while true do
        if reader.read_byte std::Option::Some(byte) is else
            break
        fi
        byte bytes.push
    done
    bytes
}

pub fn report_syntax_diagnostics report:$products::Report {
    for index in report.count_diagnostics 0 std::Range::new do
        index report.get_presentation = presentation
        if presentation.severity error::DiagnosticSeverity::Error == then
            presentation report.get_sources.format_diagnostic std::eprintln_string
        fi
    done
}

pub fn main {
    read_all_stdin = source_bytes
    source_bytes.to_str match
        std::Result::Error(utf8_error) => {
            f"error: formatter input is not valid UTF-8 at byte {utf8_error.index}" std::eprintln_string
            source_bytes io::stdout_write_bytes
            1 std::process::exit
        }
        std::Result::Ok(value) => value
    end
    = source

    source.as_str format::format_source match
        std::Result::Ok(formatted) => formatted print
        std::Result::Error(failure) => {
            failure match
                format::FormatFailure::InvalidInput(report) => report report_syntax_diagnostics
                format::FormatFailure::InvalidOutput(report) => {
                    "error: formatter produced invalid syntax" std::eprintln
                    report report_syntax_diagnostics
                }
                format::FormatFailure::MeaningChanged => "error: formatter changed source meaning" std::eprintln
            end
            source print
            1 std::process::exit
        }
    end
}
main
