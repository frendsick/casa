    # An `if` whose first marker is `else` has no consequent.
    fn find_early_exit
        self:$Formatter
        tokens:$std::List[common::Token]
        form:$syntax::SyntaxSpan
        start_index:u64
        close_index:u64
    -> std::Option[u64] {
        if "if" start_index tokens.get common::Token::value.as_str != then
            std::Option[u64]::None return
        fi
        for index in close_index start_index 1 + std::Range::new do
            index tokens.get = token
            if token token_offset form self.inside_nested_form ! then
                if "then" token.value.as_str == then
                    break
                fi
                if "else" token.value.as_str == then
                    token token_offset std::Option::Some return
                fi
            fi
        done
        std::Option[u64]::None
    }

    pub fn is_early_exit_marker self:$Formatter token:$common::Token -> bool {
        token token_offset self.early_exits offset_list_has
    }

    pub fn build_match_rules
        self:mut$Formatter
        tokens:$std::List[common::Token]
        form:$syntax::SyntaxSpan
    {
        form.close tokens self.token_index_at = close_opt
        if close_opt std::Option::Some(close_index) is then
            close_index tokens.get self.add_break
        fi

        0 = span_index: u64
        while span_index self.spans.length < do
            span_index self.spans.get = arm
            1 += span_index
            if syntax::SyntaxSpanKind::MatchArm arm.kind != then
                continue
            fi
            arm.start form.start > = starts_inside
            form.close arm.close > = closes_inside
            if starts_inside closes_inside && ! then
                continue
            fi
            arm.start tokens self.token_index_at = arm_start_opt
            arm.close tokens self.token_index_at = arm_close_opt
            if arm_start_opt.is_none arm_close_opt.is_none || then
                continue
            fi
            arm_start_opt.unwrap = arm_start
            arm_close_opt.unwrap = arm_close
            arm_start tokens.get self.add_break
            arm_close arm_start span_index 1 - tokens self.build_match_arm_rules
        done
    }

    pub fn wrapped_arm_at self:$Formatter offset:u64 -> std::Option[syntax::SyntaxSpan] {
        for arm in self.wrapped_arms.iter do
            if offset arm.start == then
                arm.clone std::Option::Some return
            fi
        done
        std::Option[syntax::SyntaxSpan]::None
    }

    # Join a wrapped arm's first output line when it fits within 100
    # characters at the current depth. A comment keeps the source lines.
    pub fn join_arm_line
        self:mut$Formatter
        tokens:$std::List[common::Token]
        arm:$syntax::SyntaxSpan
        start_index:u64
    {
        arm.close tokens self.token_index_at = close_opt
        if close_opt.is_none then
            return
        fi
        close_opt.unwrap = close_index
        start_index = line_close
        false = has_comment
        start_index 1 + = index
        while index close_index 1 + < do
            index tokens.get = token
            if common::TokenKind::Newline token.kind != then
                if token token_offset self.break_before offset_list_has then
                    break
                fi
                if common::TokenKind::Comment token.kind == then
                    true = has_comment
                fi
                index = line_close
            fi
            1 += index
        done
        if has_comment line_close 1 + start_index tokens self.measure_token_range 100 > || then
            return
        fi
        false = after_newline
        for index in line_close 1 + start_index 1 + std::Range::new do
            index tokens.get = token
            if common::TokenKind::Newline token.kind == then
                true = after_newline
            else
                after_newline token self.join_if_after_newline
                false = after_newline
            fi
        done
    }

    pub fn definition_contains_structure self:$Formatter definition:$syntax::SyntaxSpan -> bool {
        for span in self.spans.iter do
            syntax::SyntaxSpanKind::ControlForm span.kind ==
            syntax::SyntaxSpanKind::MatchForm span.kind == ||
            = structural
            if structural then
                span.start definition.start > = starts_inside
                definition.close span.close > = closes_inside
                if starts_inside closes_inside && then
                    true return
                fi
            fi
        done
        false
    }

    pub fn build_definition_rules
        self:mut$Formatter
        tokens:$std::List[common::Token]
        definition:$syntax::SyntaxSpan
    {
        definition.start tokens self.token_index_at = start_opt
        definition.close tokens self.token_index_at = close_opt
        if start_opt.is_none close_opt.is_none || then
            return
        fi
        start_opt.unwrap = index
        index = start_index
        close_opt.unwrap = close_index
        close_index = brace_index
        while index close_index < do
            if "{" index tokens.get common::Token::value.as_str == then
                index = brace_index
                break
            fi
            1 += index
        done
        if brace_index close_index == then
            return
        fi

        false = has_comment
        false = has_nested_block
        false = has_layout_break
        0 = nonblank_lines: u64
        false = line_has_token
        brace_index 1 + = index
        while index close_index < do
            index tokens.get = body_token
            if common::TokenKind::Newline body_token.kind == then
                if line_has_token then
                    1 += nonblank_lines
                fi
                false = line_has_token
            elif common::TokenKind::Comment body_token.kind == then
                true = has_comment
            else
                true = line_has_token
                if body_token token_offset self.break_before offset_list_has then
                    true = has_layout_break
                fi
