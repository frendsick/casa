# Casa autoformatter
#
# Reads Casa source from stdin, writes formatted source to stdout.
# On parse error, echoes the original source unchanged and exits with code 1.
#
# Build (requires two stages because TokenKind was extended):
#   ./casac casa.casa -o casac-stage1
#   ./casac-stage1 formatter/format.casa -o casafmt
import "../lib/std.casa"
import "../lib/io.casa"
import "../compiler/common.casa"
import "../compiler/error.casa"
import "../compiler/lexer.casa"
import "../compiler/syntax.casa"

# ============================================================================
# Read all stdin into a string
# ============================================================================

fn read_all_stdin -> str {
    StdinReader::new = reader
    StringBuilder::new = builder
    while true do
        reader stdin_read_byte = byte
        if 0 byte < then
            break
        fi
        unsafe { byte (u32) char::from_codepoint_unchecked } builder.append_char
    done
    builder.build
}

# ============================================================================
# Report compiler-owned syntax diagnostics
# ============================================================================

fn report_syntax_diagnostics source:$str diagnostics:$Diagnostics {
    SourceStore::new = sources
    source "<stdin>" sources.add
    for diagnostic in diagnostics.entries.iter do
        if diagnostic Diagnostic::Error(error) is then
            error sources.format_error eprintln
        fi
    done
}

# ============================================================================
# Indent helper
# ============================================================================

fn make_indent depth:i64 -> str {
    StringBuilder::new = builder
    0 = i
    while i depth > do
        "    " builder.append
        1 += i
    done
    builder.build
}

# ============================================================================
# Formatter state
# ============================================================================

struct Formatter {
    source:        $str
    output:        StringBuilder
    depth:         i64
    spans:         $List[SyntaxSpan]
    break_before:  List[u64]
    join_before:   List[u64]
    continuations: List[u64]
}

impl Formatter {
    fn new source:$str spans:$List[SyntaxSpan] -> Formatter {
        List[u64]::new
        List[u64]::new
        List[u64]::new
        spans
        0
        StringBuilder::new
        source
        Formatter
    }
}

# ============================================================================
# Token classification helpers
# ============================================================================

fn is_eof_token token:$Token -> bool {
    # Eof has empty value, but so can some f-string tokens
    if 0 token Token::value.length != then
        false return
    fi
    if TokenKind::FstringStart token Token::kind == then
        false return
    fi
    if TokenKind::FstringEnd token Token::kind == then
        false return
    fi
    if TokenKind::FstringText token Token::kind == then
        false return
    fi
    if TokenKind::FstringExprStart token Token::kind == then
        false return
    fi
    if TokenKind::FstringExprEnd token Token::kind == then
        false return
    fi
    true
}

fn is_block_open_token token:$Token -> bool {
    token Token::kind = kind
    token Token::value = value
    if TokenKind::Keyword kind == then
        if "then" value == then
            true return
        fi
        if "do" value == then
            true return
        fi
    fi
    if TokenKind::Delimiter kind == then
        if "{" value == then
            true return
        fi
    fi
    false
}

fn is_block_close_value value:$str -> bool {
    if "}" value == then
        true return
    fi
    if "fi" value == then
        true return
    fi
    if "done" value == then
        true return
    fi
    if "end" value == then
        true return
    fi
    false
}

fn is_dedent_keyword value:$str -> bool {
    if "else" value == then
        true return
    fi
    if "elif" value == then
        true return
    fi
    false
}

fn is_toplevel_definition value:$str -> bool {
    if "fn" value == then
        true return
    fi
    if "struct" value == then
        true return
    fi
    if "enum" value == then
        true return
    fi
    if "impl" value == then
        true return
    fi
    if "trait" value == then
        true return
    fi
    false
}

fn is_toplevel_definition_line line:$List[Token] -> bool {
    if 0 line.length == then
        false return
    fi
    if 0 line.get Token::value is_toplevel_definition then
        true return
    fi
    if 1 line.length == then
        false return
    fi
    "unsafe" 0 line.get Token::value == "fn" 1 line.get Token::value == &&
}

fn is_generic_bracket_prev tok_kind:$TokenKind value:$str -> bool {
    if TokenKind::Intrinsic tok_kind == "size_of" value == && then
        true return
    fi
    if TokenKind::Identifier tok_kind == then
        if "ptr::read" value == "ptr::write" value == || then
            true return
        fi
        if 0 value.length != then
            0 value.at = ch
            if 'A' ch >= 'Z' ch <= && then
                true return
            fi
        fi
        if value.length 1 < '$' 0 value.at == && then
            1 value.at = borrowed_ch
            if 'A' borrowed_ch >= 'Z' borrowed_ch <= && then
                true return
            fi
        fi
        if value.length 4 < value "mut$" str::starts_with && then
            4 value.at = borrowed_ch
            if 'A' borrowed_ch >= 'Z' borrowed_ch <= && then
                true return
            fi
        fi
        if value "array" str::ends_with then
            true return
        fi
    fi
    if value "fn" str::ends_with "impl" value == || then
        true return
    fi
    false
}

fn is_fstring_interior kind:$TokenKind -> bool {
    if TokenKind::FstringText kind == then
        true return
    fi
    if TokenKind::FstringExprStart kind == then
        true return
    fi
    if TokenKind::FstringExprEnd kind == then
        true return
    fi
    false
}

fn should_skip_space_before_tokens prev_kind:$TokenKind cur_val:$str cur_kind:$TokenKind -> bool {
    if "." cur_val == then
        true return
    fi
    if "::" cur_val == then
        true return
    fi
    if ")" cur_val == then
        true return
    fi
    if "]" cur_val == then
        true return
    fi
    if ":" cur_val == then
        true return
    fi
    # No spaces inside f-string components:
    # FstringStart + interior, interior + interior, interior + FstringEnd
    if TokenKind::FstringStart prev_kind == then
        true return
    fi
    if prev_kind is_fstring_interior then
        true return
    fi
    if cur_kind is_fstring_interior then
        true return
    fi
    if TokenKind::FstringEnd cur_kind == then
        true return
    fi
    false
}

fn should_skip_space_after value:$str -> bool {
    if "." value == then
        true return
    fi
    if "::" value == then
        true return
    fi
    if "(" value == then
        true return
    fi
    if "[" value == then
        true return
    fi
    false
}

fn is_fn_param_colon line:$List[Token] colon_idx:u64 -> bool {
    if line.length 0 == then
        false return
    fi
    0 line.get Token::value = first
    if "fn" first != then
        if
            "unsafe" first !=
            1 line.length == ||
            "fn" 1 line.get Token::value != ||
        then
            false return
        fi
    fi
    if 0 colon_idx == then
        false return
    fi
    colon_idx 1 - = prev_idx
    if TokenKind::Identifier prev_idx line.get Token::kind != then
        false return
    fi
    true
}

fn is_section_separator_comment token:$Token -> bool {
    if TokenKind::Comment token Token::kind != then
        false return
    fi
    token Token::value = value
    if 6 value.length < then
        false return
    fi
    if '#' 0 value.at != then
        false return
    fi
    if ' ' 1 value.at != then
        false return
    fi
    2 value.at = sep_char
    if '=' sep_char != '-' sep_char != && then
        false return
    fi
    3 (u64) = idx
    while idx value.length > do
        if sep_char idx value.at != then
            false return
        fi
        1 += idx
    done
    true
}

fn token_offset token:$Token -> u64 { token.location.span.offset }

fn offset_list_has values:$List[u64] wanted:u64 -> bool {
    0 (u64) = index
    while index values.length > do
        index values.get_ref = value
        if wanted value == then
            true return
        fi
        1 += index
    done
    false
}

fn offset_list_count values:$List[u64] wanted:u64 -> u64 {
    0 (u64) = count
    0 (u64) = index
    while index values.length > do
        if wanted index values.get_ref == then
            1 += count
        fi
        1 += index
    done
    count
}

fn add_offset_once values:mut$List[u64] value:u64 {
    if value values offset_list_has ! then
        value values.push
    fi
}

fn tokens_need_space line:$List[Token] previous_index:u64 next_index:u64 -> bool {
    previous_index line.get = previous
    next_index line.get = next
    previous.value = previous_value
    next.value = next_value
    true = needed
    if previous_value should_skip_space_after then
        false = needed
    fi
    if next.kind next_value previous.kind should_skip_space_before_tokens then
        false = needed
    fi
    if ":" previous_value == then
        if previous_index line is_fn_param_colon then
            false = needed
        fi
        if 0 previous_index != then
            if ":" previous_index 1 - line.get Token::value == then
                false = needed
            fi
        fi
    fi
    if ":" next_value == then
        if next_index line is_fn_param_colon then
            false = needed
        fi
    fi
    if "{" previous_value == previous.kind is_fstring_interior ! && then
        true = needed
    fi
    if "}" next_value == next.kind is_fstring_interior ! && then
        true = needed
    fi
    if
        "}" previous_value ==
        "[" next_value ==
        previous.kind is_fstring_interior !
        && &&
    then
        true = needed
    fi
    if "," next_value == then
        false = needed
    fi
    if "(" next_value == previous_value "::" str::contains && then
        false = needed
    fi
    if "[" next_value == previous_value previous.kind is_generic_bracket_prev && then
        false = needed
    fi
    needed
}

# ============================================================================
# Get original source text for a token
# ============================================================================

fn token_text token:$Token source:$str -> str {
    token Token::kind = kind
    # For literals, use original source to preserve escapes
    if TokenKind::Literal kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if TokenKind::FstringStart kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if TokenKind::FstringText kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if TokenKind::FstringEnd kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if TokenKind::FstringExprStart kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if TokenKind::FstringExprEnd kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    # Normalize comments: ensure space after #
    if TokenKind::Comment kind == then
        token Token::value = comment_val
        if 2 comment_val.length < then
            comment_val.clone return
        fi
        if ' ' 1 comment_val.at == then
            comment_val.clone return
        fi
        if '!' 1 comment_val.at == then
            comment_val.clone return
        fi
        if '#' 1 comment_val.at == then
            comment_val.clone return
        fi
        f"# {comment_val 1 comment_val.length 1 - str::substring}" return
    fi
    token Token::value.clone
}

# ============================================================================
# Struct/enum field helpers
# ============================================================================

fn is_field_line line:$List[Token] -> bool {
    if 3 line.length < then
        false return
    fi
    if TokenKind::Identifier 0 line.get Token::kind != then
        false return
    fi
    if ":" 1 line.get Token::value != then
        false return
    fi
    true
}

# ============================================================================
# Definition body shape: eligible for an inline body only when it has at most
# one nonblank composition line and no comment or nested block. `body` holds the
# tokens strictly between the definition braces, including newlines.
# ============================================================================

fn body_shape_inlineable body:$List[Token] -> bool {
    0 (u64) = i
    0 = tokens_on_line
    0 = nonblank_lines
    while i body.length > do
        i body.get = t
        if TokenKind::Newline t Token::kind == then
            if 0 tokens_on_line != then
                1 += nonblank_lines
            fi
            0 = tokens_on_line
        elif TokenKind::Comment t Token::kind == then
            false return
        elif t is_block_open_token then
            false return
        elif TokenKind::Keyword t Token::kind == "match" t Token::value == && then
            false return
        else
            1 += tokens_on_line
        fi
        1 += i
    done
    if 0 tokens_on_line != then
        1 += nonblank_lines
    fi
    # Eligible with zero (empty body) or one nonblank composition line.
    2 nonblank_lines <
}

# ============================================================================
# Delimited-form helpers
# ============================================================================
# True when the logical line carries a block or control token, in which case the
# delimited-form canonicalizer defers to the ordinary line path (it does not own
# lambdas or control flow that ride along with a delimited form).

fn line_has_block_or_control line:$List[Token] -> bool {
    for t in line.iter do
        t Token::value = v
        if "{" v == "}" v == || then
            true return
        fi
        if "=>" v == then
            true return
        fi
        if t is_block_open_token then
            true return
        fi
        if v is_block_close_value then
            true return
        fi
        if v is_dedent_keyword then
            true return
        fi
        if TokenKind::Keyword t Token::kind == "match" v == && then
            true return
        fi
    done
    false
}
# Split the tokens strictly between a delimited form's `[` and `]` into items.
# Array items are single values; commas are optional separators. At bracket
# depth 0 a comma ends an item, and two adjacent complete values (space
# separated, no comma) also split, while `::`, `.`, and openers continue the
# current value.
# ponytail: merges adjacent nested groups like [[1][2]] into one item; repo and
# spec inputs use single-value items, so this is sufficient.

fn split_delimited_items inner:$List[Token] -> List[List[Token]] {
    List[List[Token]]::new = items
    List[Token]::new = current
    0 = depth
    0 (u64) = i
    while i inner.length > do
        i inner.get = tok
        tok Token::value = v
        "[" v == "(" v == || "{" v == || = is_open
        "]" v == ")" v == || "}" v == || = is_close
        if depth 0 == "," v == && then
            if 0 current.length != then
                current items.push
                List[Token]::new = current
            fi
        else
            if depth 0 == 0 current.length != && then
                current.length 1 - current.get Token::value = prev_v
                "::" prev_v == "." prev_v == || = prev_cont
                "[" prev_v == "(" prev_v == || "{" prev_v == || = prev_open
                "::" v == "." v == || is_open || = cur_cont
                if prev_cont ! cur_cont ! && prev_open ! && then
                    current items.push
                    List[Token]::new = current
                fi
            fi
            tok current.push
            if is_open then
                1 += depth
            fi
            if is_close then
                1 -= depth
            fi
        fi
        1 += i
    done
    if 0 current.length != then
        current items.push
    fi
    items
}

# ============================================================================
# Structural line rules
# ============================================================================

impl Formatter {
    fn token_index_at self:$Formatter tokens:$List[Token] offset:u64 -> Option[u64] {
        0 (u64) = low
        tokens.length = high
        while low high > do
            high low - 2 / low + = middle
            middle tokens.get = token
            if offset token token_offset < then
                middle 1 + = low
            else
                middle = high
            fi
        done
        while low tokens.length > do
            low tokens.get = token
            if offset token token_offset != then
                break
            fi
            if TokenKind::Newline token.kind != then
                low Option::Some return
            fi
            1 += low
        done
        Option[u64]::None
    }

    fn next_token_index self:$Formatter tokens:$List[Token] index:u64 limit:u64 -> Option[u64] {
        index 1 + = next
        while next limit > do
            if TokenKind::Newline next tokens.get Token::kind != then
                next Option::Some return
            fi
            1 += next
        done
        Option[u64]::None
    }

    fn inside_nested_form self:$Formatter parent:$SyntaxSpan offset:u64 -> bool {
        0 (u64) = index
        while index self.spans.length > do
            index self.spans.get_ref = span
            SyntaxSpanKind::ControlForm span.kind ==
            SyntaxSpanKind::MatchForm span.kind == ||
            = structural
            if
                structural
                span.start parent.start <
                parent.close span.close <
                span.start offset < !
                offset span.close < !
                && && && &&
            then
                true return
            fi
            1 += index
        done
        false
    }

    fn add_break self:mut$Formatter token:$Token {
        token token_offset self.break_before add_offset_once
    }

    fn add_join self:mut$Formatter token:$Token {
        token token_offset self.join_before add_offset_once
    }

    fn add_continuation self:mut$Formatter token:$Token {
        token token_offset self.continuations.push
    }

    fn break_after_token self:mut$Formatter tokens:$List[Token] index:u64 limit:u64 {
        if limit index tokens self.next_token_index Option::Some(next_index) is then
            next_index tokens.get self.add_break
        fi
    }

    fn join_if_after_newline self:mut$Formatter token:$Token after_newline:bool {
        if after_newline then
            token self.add_join
        fi
    }

    fn measure_token_range self:mut$Formatter tokens:$List[Token] start:u64 stop:u64 -> u64 {
        self.depth 4 * (u64) = length
        false = has_previous
        0 (u64) = previous
        start = index
        while index stop > do
            index tokens.get = token
            if TokenKind::Newline token.kind != token is_eof_token ! && then
                if has_previous then
                    if index previous tokens tokens_need_space then
                        1 += length
                    fi
                fi
                self.source token token_text.length += length
                index = previous
                true = has_previous
            fi
            1 += index
        done
        length
    }

    # Join a short one-line control header. Preserve each source line and use a
    # continuation indent when its freeform condition already uses more than one
    # nonblank line.
    fn add_control_header_rules
        self:mut$Formatter
        tokens:$List[Token]
        form:$SyntaxSpan
        opener_index:u64
        marker_index:u64
    {
        true = at_line_start
        false = has_comment
        false = has_structural_break
        0 (u64) = line_count
        opener_index 1 + = index
        while index marker_index > do
            index tokens.get = token
            if TokenKind::Newline token.kind == then
                true = at_line_start
            elif token token_offset form self.inside_nested_form then
                true = has_comment
            else
                if token token_offset self.break_before offset_list_has then
                    true = has_structural_break
                fi
                if TokenKind::Comment token.kind == then
                    true = has_comment
                fi
                if at_line_start then
                    1 += line_count
                    false = at_line_start
                fi
            fi
            1 += index
        done

        marker_index 1 + opener_index tokens self.measure_token_range = header_width
        if 2 line_count < has_comment ! has_structural_break ! && header_width 100 < ! && && then
            true = after_newline
            opener_index 1 + = index
            while index marker_index > do
                index tokens.get = token
                if TokenKind::Newline token.kind == then
                    true = after_newline
                elif after_newline then
                    token self.add_join
                    false = after_newline
                fi
                1 += index
            done
            marker_index tokens.get self.add_join
            return
        fi

        true = after_newline
        true = first_condition
        opener_index 1 + = index
        while index marker_index > do
            index tokens.get = token
            if TokenKind::Newline token.kind == then
                true = after_newline
            else
                if token token_offset self.break_before offset_list_has then
                    true = after_newline
                fi
                if after_newline then
                    first_condition token self.add_control_continuation = first_condition
                    false = after_newline
                fi
            fi
            1 += index
        done
        marker_index tokens.get self.add_break
    }

    fn add_control_continuation self:mut$Formatter token:$Token first_condition:bool -> bool {
        if first_condition then
            token self.add_break
        fi
        token self.add_continuation
        false
    }

    fn match_arm_is_wide self:mut$Formatter tokens:$List[Token] arm:$SyntaxSpan -> bool {
        arm.start tokens self.token_index_at = start_opt
        arm.close tokens self.token_index_at = close_opt
        if start_opt.is_none close_opt.is_none || then
            false return
        fi
        close_opt.unwrap 1 + start_opt.unwrap tokens self.measure_token_range = width
        width 100 < !
    }

    fn control_is_inline_value
        self:mut$Formatter
        tokens:$List[Token]
        start_index:u64
        close_index:u64
    -> bool {
        if "if" start_index tokens.get Token::value != then
            false return
        fi

        # A value-form inside a compact match arm is measured against that arm's
        # canonical line, not against an inline source match that will expand.
        0 (u64) = span_index
        while span_index self.spans.length > do
            span_index self.spans.get = arm
            1 += span_index
            if SyntaxSpanKind::MatchArm arm.kind != then
                continue
            fi
            start_index tokens.get token_offset = start_offset
            close_index tokens.get token_offset = close_offset
            start_offset arm.start < = starts_inside
            arm.close close_offset < arm.close close_offset == || = closes_inside
            if starts_inside closes_inside && arm tokens self.match_arm_is_wide && then
                true return
            fi
        done

        start_index = line_start
        while 0 line_start != do
            if TokenKind::Newline line_start 1 - tokens.get Token::kind == then
                break
            fi
            1 -= line_start
        done
        close_index 1 + = line_end
        while line_end tokens.length > do
            if TokenKind::Newline line_end tokens.get Token::kind == then
                break
            fi
            if line_end tokens.get is_eof_token then
                break
            fi
            1 += line_end
        done
        if line_start start_index == line_end close_index 1 + == && then
            false return
        fi

        line_end line_start tokens self.measure_token_range = line_width
        line_width 100 < !
    }

    fn apply_control_marker
        self:mut$Formatter
        tokens:$List[Token]
        form:$SyntaxSpan
        token:$Token
        index:u64
        close_index:u64
        header_start:u64
    -> u64 {
        token.value = value
        if "then" value == "do" value == || then
            index header_start form tokens self.add_control_header_rules
            close_index index tokens self.break_after_token
        elif "elif" value == then
            token self.add_break
            index = header_start
        elif "else" value == then
            token self.add_break
            close_index index tokens self.break_after_token
        fi
        header_start
    }

    fn build_match_arm_rules self:mut$Formatter tokens:$List[Token] arm_start:u64 arm_close:u64 {
        false = block_arm
        false = saw_arrow
        false = after_newline
        arm_start = index
        while index arm_close 1 + > do
            index tokens.get = token
            if TokenKind::Newline token.kind == then
                true = after_newline
            else
                token.value = value
                if "=>" value == then
                    true = saw_arrow
                    after_newline token self.join_if_after_newline
                elif
                    "{" value ==
                    TokenKind::Delimiter token.kind ==
                    saw_arrow
                    && &&
                then
                    after_newline token self.join_if_after_newline
                    true = block_arm
                    arm_close 1 + index tokens self.break_after_token
                elif
                    "}" value ==
                    TokenKind::Delimiter token.kind ==
                    block_arm
                    && &&
                then
                    token self.add_break
                elif block_arm ! after_newline && then
                    token self.add_join
                fi
                false = after_newline
            fi
            1 += index
        done
    }

    fn build_control_rules self:mut$Formatter tokens:$List[Token] form:$SyntaxSpan {
        form.start tokens self.token_index_at = start_opt
        form.close tokens self.token_index_at = close_opt
        if start_opt.is_none close_opt.is_none || then
            return
        fi
        start_opt.unwrap = start_index
        close_opt.unwrap = close_index
        if close_index start_index tokens self.control_is_inline_value then
            return
        fi

        start_index tokens.get self.add_break

        start_index = header_start
        start_index 1 + = index
        while index close_index > do
            index tokens.get = token
            if
                TokenKind::Newline token.kind !=
                token token_offset form self.inside_nested_form !
                &&
