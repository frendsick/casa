    fn build_accessor_chain_rules self:mut$Formatter tokens:$List[Token] chain:$SyntaxSpan {
        chain.start tokens self.token_index_at = start_opt
        chain.close tokens self.token_index_at = close_opt
        if start_opt Option::Some(start_index) is close_opt Option::Some(close_index) is && then
