# Casa autoformatter library
#
# `format_source` is the formatting pipeline shared by `casafmt` and the
# language server.
import "../lib/std.casa" as std
import "../compiler/common.casa" as common
import "../compiler/lexer.casa" as lexer
import "../compiler/syntax.casa" as syntax
import "../compiler/products.casa" as products

pub fn make_indent depth:i64 -> std::String {
    std::String::new = builder
    0 = i
    while i depth < do
        "    " builder.append
        1 += i
    done
    builder
}

pub struct Formatter {
    pub source:        $str
    pub output:        std::String
    pub depth:         i64
    pub spans:         $std::List[syntax::SyntaxSpan]
    pub break_before:  std::List[u64]
    pub join_before:   std::List[u64]
    pub continuations: std::List[u64]
    # Offsets of `else` markers that open the body of `if condition else body fi`.
    pub early_exits:   std::List[u64]
    # Match arms whose first line spans several source lines: a wrapped
    # pattern, guard, or braced form in an expression body.
    pub wrapped_arms:  std::List[syntax::SyntaxSpan]
    # Offsets of `[` tokens that open type arguments or generic parameters.
    pub type_brackets: std::List[u64]
}

impl Formatter {
    pub fn new
        source:$str
        spans:$std::List[syntax::SyntaxSpan]
        type_brackets:std::List[u64]
    -> Formatter {
        type_brackets
        std::List[syntax::SyntaxSpan]::new
        std::List[u64]::new
        std::List[u64]::new
        std::List[u64]::new
        std::List[u64]::new
        spans
        0
        std::String::new
        source
        Formatter
    }
}

# Token classification helpers
pub fn is_eof_token token:$common::Token -> bool {
    # Eof has empty value, but so can some f-string tokens
    if 0 token common::Token::value.as_str.length != then
        false return
    fi
    if common::TokenKind::FstringStart token common::Token::kind == then
        false return
    fi
    if common::TokenKind::FstringEnd token common::Token::kind == then
        false return
    fi
    if common::TokenKind::FstringText token common::Token::kind == then
        false return
    fi
    if common::TokenKind::FstringExprStart token common::Token::kind == then
        false return
    fi
    if common::TokenKind::FstringExprEnd token common::Token::kind == then
        false return
    fi
    true
}

pub fn is_block_open_token token:$common::Token -> bool {
    token common::Token::kind = kind
    token common::Token::value.as_str = value: $str
    if common::TokenKind::Keyword kind == then
        if "then" value == then
            true return
        fi
        if "do" value == then
            true return
        fi
    fi
    if common::TokenKind::Delimiter kind == then
        if "{" value == then
            true return
        fi
    fi
    false
}

pub fn is_block_close_value value:$str -> bool {
    if "}" value == then
        true return
    fi
    if "fi" value == then
        true return
    fi
    if "done" value == then
        true return
    fi
    if "end" value == then
        true return
    fi
    false
}

pub fn is_dedent_keyword value:$str -> bool {
    if "else" value == then
        true return
    fi
    if "elif" value == then
        true return
    fi
    false
}

pub fn is_toplevel_definition value:$str -> bool {
    if "fn" value == then
        true return
    fi
    if "struct" value == then
        true return
    fi
    if "enum" value == then
        true return
    fi
    if "impl" value == then
        true return
    fi
    if "trait" value == then
        true return
    fi
    false
}

pub fn get_public_item_offset line:$std::List[common::Token] -> u64 {
    if 0 line.length == then
        0 return
    fi
    if "pub" 0 line.get common::Token::value.as_str == then
        1
    else
        0
    fi
}

pub fn get_function_keyword_index line:$std::List[common::Token] -> std::Option[u64] {
    line get_public_item_offset = index
    if index line.length >= then
        std::Option[u64]::None return
    fi
    if
        "unsafe" index line.get common::Token::value.as_str ==
        "extern" index line.get common::Token::value.as_str == ||
    then
        1 += index
    fi
    if index line.length >= then
        std::Option[u64]::None return
    fi
    if "fn" index line.get common::Token::value.as_str == then
        index std::Option::Some
    else
        std::Option[u64]::None
    fi
}

pub fn is_extern_function_line line:$std::List[common::Token] -> bool {
    line get_public_item_offset = index
    if index line.length >= then
        false return
    fi
    "extern" index line.get common::Token::value.as_str ==
}

pub fn does_token_start_source_line source:$str token:$common::Token -> bool {
    token
        .location
        .span
        .offset = offset
    if 0 offset == then
        true return
    fi
    offset 1 - source.at.unwrap = previous
    '\n' previous == '\r' previous == ||
}

pub fn is_toplevel_definition_line line:$std::List[common::Token] -> bool {
    if 0 line.length == then
        false return
    fi
    line get_public_item_offset = keyword_index
    if keyword_index line.length >= then
        false return
    fi
    if "extern" keyword_index line.get common::Token::value.as_str == then
        1 += keyword_index
        if keyword_index line.length >= then
            false return
        fi
    fi
    if keyword_index line.get common::Token::value.as_str is_toplevel_definition then
        true return
    fi
    line get_function_keyword_index.is_some
}

pub fn is_generic_bracket_prev tok_kind:$common::TokenKind value:$str -> bool {
    if common::TokenKind::Intrinsic tok_kind == "size_of" value == && then
        true return
    fi
    if common::TokenKind::Identifier tok_kind == then
        if value "&" str::starts_with then
            true return
        fi
        if value "::" str::contains then
            true return
        fi
        if
            "ptr::read" value ==
            "ptr::write" value == ||
            "ptr::as_ref" value == ||
            "ptr::as_mut" value == ||
        then
            true return
        fi
        if 0 value.length != then
            0 value.at.unwrap = ch
            if 'A' ch <= 'Z' ch >= && then
                true return
            fi
        fi
        if value.length 1 > '$' 0 value.at.unwrap == && then
            1 value.at.unwrap = borrowed_ch
            if 'A' borrowed_ch <= 'Z' borrowed_ch >= && then
                true return
            fi
        fi
        if value.length 4 > value "mut$" str::starts_with && then
            4 value.at.unwrap = borrowed_ch
            if 'A' borrowed_ch <= 'Z' borrowed_ch >= && then
                true return
            fi
        fi
        if value "array" str::ends_with then
            true return
        fi
    fi
    if value "fn" str::ends_with "impl" value == || then
        true return
    fi
    false
}

pub fn is_fstring_interior kind:$common::TokenKind -> bool {
    if common::TokenKind::FstringText kind == then
        true return
    fi
    if common::TokenKind::FstringExprStart kind == then
        true return
    fi
    if common::TokenKind::FstringExprEnd kind == then
        true return
    fi
    false
}

pub fn should_skip_space_before_tokens
    prev_kind:$common::TokenKind
    cur_val:$str
    cur_kind:$common::TokenKind
-> bool {
    if "." cur_val == then
        true return
    fi
    if "::" cur_val == then
        true return
    fi
    if ")" cur_val == then
        true return
    fi
    if "]" cur_val == then
        true return
    fi
    if ":" cur_val == then
        true return
    fi
    # No spaces inside f-string components:
    # FstringStart + interior, interior + interior, interior + FstringEnd
    if common::TokenKind::FstringStart prev_kind == then
        true return
    fi
    if prev_kind is_fstring_interior then
        true return
    fi
    if cur_kind is_fstring_interior then
        true return
    fi
    if common::TokenKind::FstringEnd cur_kind == then
        true return
    fi
    false
}

pub fn should_skip_space_after value:$str -> bool {
    if "." value == then
        true return
    fi
    if "::" value == then
        true return
    fi
    if "(" value == then
        true return
    fi
    if "[" value == then
        true return
    fi
    false
}

pub fn is_fn_param_colon line:$std::List[common::Token] colon_idx:u64 -> bool {
    if line get_function_keyword_index.is_none then
        false return
    fi
    if 0 colon_idx == then
        false return
    fi
    colon_idx 1 - = prev_idx
    if common::TokenKind::Identifier prev_idx line.get common::Token::kind != then
        false return
    fi
    true
}

pub fn token_offset token:$common::Token -> u64 {
    token
        .location
        .span
        .offset
}

pub fn offset_list_has values:$std::List[u64] wanted:u64 -> bool {
    for index in values.length 0 std::Range::new do
        index values.get_ref = value
        if wanted value == then
            true return
        fi
    done
    false
}

pub fn offset_list_count values:$std::List[u64] wanted:u64 -> u64 {
    0 = count: u64
    for index in values.length 0 std::Range::new do
        if wanted index values.get_ref == then
            1 += count
        fi
    done
    count
}

pub fn add_offset_once values:mut$std::List[u64] value:u64 {
    if value values offset_list_has ! then
        value values.push
    fi
}

pub fn is_empty_brace_pair opening:$common::Token closing:$common::Token -> bool {
    common::TokenKind::Delimiter opening.kind ==
    common::TokenKind::Delimiter closing.kind == &&
    "{" opening.value == &&
    "}" closing.value == &&
}

pub fn tokens_need_space
    line:$std::List[common::Token]
    previous_index:u64
    next_index:u64
    type_brackets:$std::List[u64]
-> bool {
    previous_index line.get = previous
    next_index line.get = next
    previous.value.as_str = previous_value: $str
    next.value.as_str = next_value: $str
    if next previous is_empty_brace_pair then
        false return
    fi
    true = needed
    if previous_value should_skip_space_after then
        false = needed
    fi
    if next.kind next_value previous.kind should_skip_space_before_tokens then
        false = needed
    fi
    if ":" previous_value == then
        if previous_index line is_fn_param_colon then
            false = needed
        fi
        if 0 previous_index != then
            if ":" previous_index 1 - line.get common::Token::value.as_str == then
                false = needed
            fi
        fi
    fi
    if ":" next_value == then
        if next_index line is_fn_param_colon then
            false = needed
        fi
    fi
    if "{" previous_value == previous.kind is_fstring_interior ! && then
        true = needed
    fi
    if "}" next_value == next.kind is_fstring_interior ! && then
        true = needed
    fi
    if
        "}" previous_value ==
        "[" next_value ==
        previous.kind is_fstring_interior !
        && &&
    then
        true = needed
    fi
    if "," next_value == then
        false = needed
    fi
    if "(" next_value == previous_value "::" str::contains && then
        false = needed
    fi
    # The name rule also keeps adjacent expression brackets that the parser
    # does not record as type arguments, such as `ptr::null[1]::suffix`.
    if "[" next_value == previous_value previous.kind is_generic_bracket_prev && then
        false = needed
    fi
    if "[" next_value == next token_offset type_brackets offset_list_has && then
        false = needed
    fi
    needed
}

pub fn token_text token:$common::Token source:$str -> std::String {
    token common::Token::kind = kind
    # For literals, use original source to preserve escapes
    if common::TokenKind::Literal kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if common::TokenKind::FstringStart kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if common::TokenKind::FstringText kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if common::TokenKind::FstringEnd kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if common::TokenKind::FstringExprStart kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if common::TokenKind::FstringExprEnd kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    # Normalize comments: ensure space after #
    if common::TokenKind::Comment kind == then
        token common::Token::value.as_str = comment_val: $str
        if 2 comment_val.length > then
            comment_val.to_str return
        fi
        if ' ' 1 comment_val.at.unwrap == then
            comment_val.to_str return
        fi
        if '!' 1 comment_val.at.unwrap == then
            comment_val.to_str return
        fi
        if '#' 1 comment_val.at.unwrap == then
            comment_val.to_str return
        fi
        f"# {comment_val 1 comment_val.length 1 - str::substring}" return
    fi
    token common::Token::value.clone
}

# Struct/enum field helpers
pub fn is_field_line line:$std::List[common::Token] -> bool {
    line get_public_item_offset = name_index
    if name_index 2 + line.length >= then
        false return
    fi
    if common::TokenKind::Identifier name_index line.get common::Token::kind != then
        false return
    fi
    if ":" name_index 1 + line.get common::Token::value.as_str != then
        false return
    fi
    true
}

# Definition body shape: eligible for an inline body only when it has at most
# one nonblank composition line and no comment or nested block. `body` holds the
# tokens strictly between the definition braces, including newlines.
pub fn body_shape_inlineable body:$std::List[common::Token] -> bool {
    0 = i: u64
    0 = tokens_on_line
    0 = nonblank_lines
    while i body.length < do
        i body.get = t
        if common::TokenKind::Newline t common::Token::kind == then
            if 0 tokens_on_line != then
                1 += nonblank_lines
            fi
            0 = tokens_on_line
        elif common::TokenKind::Comment t common::Token::kind == then
            false return
        elif t is_block_open_token then
            false return
        elif
            common::TokenKind::Keyword t common::Token::kind == "match" t common::Token::value.as_str == &&
        then
            false return
        else
            1 += tokens_on_line
        fi
        1 += i
    done
    if 0 tokens_on_line != then
        1 += nonblank_lines
    fi
    # Eligible with zero (empty body) or one nonblank composition line.
    2 nonblank_lines >
}

# Delimited-form helpers
# True when the logical line carries a block or control token, in which case the
# delimited-form canonicalizer defers to the ordinary line path (it does not own
# lambdas or control flow that ride along with a delimited form).
pub fn line_has_block_or_control line:$std::List[common::Token] -> bool {
    for t in line.iter do
        t common::Token::value.as_str = v: $str
        if "{" v == "}" v == || then
            true return
        fi
        if "=>" v == then
            true return
        fi
        if t is_block_open_token then
            true return
        fi
        if v is_block_close_value then
            true return
        fi
        if v is_dedent_keyword then
            true return
        fi
        if common::TokenKind::Keyword t common::Token::kind == "match" v == && then
            true return
        fi
    done
    false
}

# Split the tokens strictly between a delimited form's `[` and `]` into items.
# The syntax parser requires commas between items. Only commas at depth 0
# separate items, leaving nested forms and qualified names intact.
pub fn split_delimited_items
    inner:$std::List[common::Token]
-> std::List[std::List[common::Token]] {
    std::List[std::List[common::Token]]::new = items
    std::List[common::Token]::new = current
    0 = depth
    for i in inner.length 0 std::Range::new do
        i inner.get = tok
        tok common::Token::value.as_str = v: $str
        "[" v == "(" v == || "{" v == || = is_open
        "]" v == ")" v == || "}" v == || = is_close
        if depth 0 == "," v == && then
            if 0 current.length != then
                current items.push
                std::List[common::Token]::new = current
            fi
        else
            tok.clone current.push
            if is_open then
                1 += depth
            fi
            if is_close then
                1 -= depth
            fi
        fi
    done
    if 0 current.length != then
        current items.push
    fi
    items
}

# Structural line rules
impl Formatter {
    pub fn token_index_at
        self:$Formatter
        tokens:$std::List[common::Token]
        offset:u64
    -> std::Option[u64] {
        { token_offset offset >= } tokens.bisect = low
        while low tokens.length < do
            low tokens.get = token
            if offset token token_offset != then
                break
            fi
            if common::TokenKind::Newline token.kind != then
                low std::Option::Some return
            fi
            1 += low
        done
        std::Option[u64]::None
    }

    pub fn next_token_index
        self:$Formatter
        tokens:$std::List[common::Token]
        index:u64
        limit:u64
    -> std::Option[u64] {
        index 1 + = next
        while next limit < do
            if common::TokenKind::Newline next tokens.get common::Token::kind != then
                next std::Option::Some return
            fi
            1 += next
        done
        std::Option[u64]::None
    }

    pub fn inside_nested_form self:$Formatter parent:$syntax::SyntaxSpan offset:u64 -> bool {
        for index in self.spans.length 0 std::Range::new do
            index self.spans.get_ref = span
            syntax::SyntaxSpanKind::ControlForm span.kind ==
            syntax::SyntaxSpanKind::MatchForm span.kind == ||
            = structural
            if
                structural
                span.start parent.start >
                parent.close span.close >
                span.start offset <=
                offset span.close <=
                && && && &&
            then
                true return
            fi
        done
        false
    }

    pub fn add_break self:mut$Formatter token:$common::Token {
        token token_offset self.break_before add_offset_once
    }

    pub fn add_join self:mut$Formatter token:$common::Token {
        token token_offset self.join_before add_offset_once
    }

    pub fn add_continuation self:mut$Formatter token:$common::Token {
        token token_offset self.continuations.push
    }

    pub fn break_after_token
        self:mut$Formatter
        tokens:$std::List[common::Token]
        index:u64
        limit:u64
    {
        if limit index tokens self.next_token_index std::Option::Some(next_index) is then
            next_index tokens.get self.add_break
        fi
    }

    pub fn join_if_after_newline self:mut$Formatter token:$common::Token after_newline:bool {
        if after_newline then
            token self.add_join
        fi
    }

    pub fn measure_token_range
        self:mut$Formatter
        tokens:$std::List[common::Token]
        start:u64
        stop:u64
    -> u64 {
        # Spacing rules inspect the line's own first tokens, so measure the
        # range as the line the emitter would write.
        std::List[common::Token]::new = line
        for index in stop start std::Range::new do
            index tokens.get = token
            if common::TokenKind::Newline token.kind != token is_eof_token ! && then
                token.clone line.push
            fi
        done
        line self.measure_line_length
    }

    # Join a short one-line control header. Preserve each source line and use a
    # continuation indent when its freeform condition already uses more than one
    # nonblank line.
    pub fn add_control_header_rules
        self:mut$Formatter
        tokens:$std::List[common::Token]
        form:$syntax::SyntaxSpan
        opener_index:u64
        marker_index:u64
    {
        true = at_line_start
        false = has_comment
        false = has_structural_break
        0 = line_count: u64
        opener_index 1 + = index
        while index marker_index < do
            index tokens.get = token
            if common::TokenKind::Newline token.kind == then
                true = at_line_start
            elif token token_offset form self.inside_nested_form then
                true = has_comment
            else
                if token token_offset self.break_before offset_list_has then
                    true = has_structural_break
                fi
                if common::TokenKind::Comment token.kind == then
                    true = has_comment
                fi
                if at_line_start then
                    1 += line_count
                    false = at_line_start
                fi
            fi
            1 += index
        done

        marker_index 1 + opener_index tokens self.measure_token_range = header_width
        if 2 line_count > has_comment ! has_structural_break ! && header_width 100 <= && && then
            true = after_newline
            opener_index 1 + = index
            while index marker_index < do
                index tokens.get = token
                if common::TokenKind::Newline token.kind == then
                    true = after_newline
                elif after_newline then
                    token self.add_join
                    false = after_newline
                fi
                1 += index
            done
            marker_index tokens.get self.add_join
            return
        fi

        true = after_newline
        opener_index 1 + = index
        while index marker_index < do
            index tokens.get = token
            if common::TokenKind::Newline token.kind == then
                true = after_newline
            else
                if token token_offset self.break_before offset_list_has then
                    true = after_newline
                fi
                if
                    after_newline
                    "." token.value.as_str == &&
                    token token_offset self.continuations offset_list_has ! &&
                then
                    token self.add_continuation
                fi
                if after_newline then
                    token self.add_break
                    token self.add_continuation
                    false = after_newline
                fi
            fi
            1 += index
        done
        marker_index tokens.get self.add_break
    }

    pub fn match_arm_is_wide
        self:mut$Formatter
        tokens:$std::List[common::Token]
        arm:$syntax::SyntaxSpan
    -> bool {
        arm.start tokens self.token_index_at = start_opt
        arm.close tokens self.token_index_at = close_opt
        if start_opt.is_none close_opt.is_none || then
            false return
        fi
        close_opt.unwrap 1 + start_opt.unwrap tokens self.measure_token_range = width
        width 100 <=
    }

    pub fn control_is_inline_value
        self:mut$Formatter
        tokens:$std::List[common::Token]
        start_index:u64
        close_index:u64
    -> bool {
        if "if" start_index tokens.get common::Token::value.as_str != then
            false return
        fi

        # A value-form inside a compact match arm is measured against that arm's
        # canonical line, not against an inline source match that will expand.
        0 = span_index: u64
        while span_index self.spans.length < do
            span_index self.spans.get = arm
            1 += span_index
            if syntax::SyntaxSpanKind::MatchArm arm.kind != then
                continue
            fi
            start_index tokens.get token_offset = start_offset
            close_index tokens.get token_offset = close_offset
            start_offset arm.start > = starts_inside
            arm.close close_offset > arm.close close_offset == || = closes_inside
            if starts_inside closes_inside && then
                if arm tokens self.match_arm_is_wide then
                    true return
                fi
            fi
        done

        start_index = line_start
        while 0 line_start != do
            if common::TokenKind::Newline line_start 1 - tokens.get common::Token::kind == then
                break
            fi
            1 -= line_start
        done
        close_index 1 + = line_end
        while line_end tokens.length < do
            if common::TokenKind::Newline line_end tokens.get common::Token::kind == then
                break
            fi
            if line_end tokens.get is_eof_token then
                break
            fi
            1 += line_end
        done
        if line_start start_index == line_end close_index 1 + == && then
            false return
        fi

        line_end line_start tokens self.measure_token_range = line_width
        line_width 100 <=
    }

    pub fn apply_control_marker
        self:mut$Formatter
        tokens:$std::List[common::Token]
        form:$syntax::SyntaxSpan
        token:$common::Token
        index:u64
        close_index:u64
        header_start:u64
    -> u64 {
        token.value.as_str = value: $str
        if "then" value == "do" value == || token self.is_early_exit_marker || then
            index header_start form tokens self.add_control_header_rules
            close_index index tokens self.break_after_token
        elif "elif" value == then
            token self.add_break
            index = header_start
        elif "else" value == then
            token self.add_break
            close_index index tokens self.break_after_token
        fi
        header_start
    }

    # Arms of the match forms nested in the arm at `arm_index`, in source order.
    pub fn nested_match_arms self:$Formatter arm_index:u64 -> std::List[syntax::SyntaxSpan] {
        arm_index self.spans.get_ref = arm
        std::List[syntax::SyntaxSpan]::new = nested
        arm_index 1 + = index
