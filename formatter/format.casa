                    for mt in line_tokens.iter do
                        if common::TokenKind::Keyword mt common::Token::kind == then
                            if "match" mt common::Token::value.as_str == then
                                1 += self.depth
                                true = prev_was_open
                            fi
                        fi
                    done

                    common::TokenKind::Comment 0 line_tokens.get common::Token::kind ==
                    = prev_was_comment

                    if 0 self.depth == then
                        if line_tokens is_toplevel_definition_line "import" first_value == || then
                            true = prev_was_definition
                        else
                            false = prev_was_definition
                        fi
                        "import" first_value == = prev_was_import
                    else
                        false = prev_was_definition
                        false = prev_was_import
                    fi

                    # else keyword: restore self.depth for body
                    if "else" first_value == opens_early_exit ! && then
                        1 += self.depth
                        true = prev_was_open
                    fi
                else
                    # Completed a canonicalized definition or delimited-form line.
                    false = prev_was_open
                    false = prev_was_comment
                    false = prev_was_import
                    # A delimited-form line is never a top-level definition; a
                    # canonicalized definition at depth 0 is.
                    if 0 self.depth == handled_delim ! && then
                        true = prev_was_definition
                    else
                        false = prev_was_definition
                    fi
                fi
            fi
        done

        if 0 self.output.length == then
            "\n" self.output.append
        fi
        self.output.clone
    }
}

# Why `format_source` rejected its input. Callers keep the original source.
pub enum FormatFailure {
    # The input does not parse. The result holds its diagnostics.
    InvalidInput(products::SyntaxResult)
    # The formatted text does not parse. The result holds its diagnostics.
    InvalidOutput(products::SyntaxResult)
    # The formatted text has different syntax facts than the input.
    MeaningChanged
}

# Format `source` as `casafmt` does. The input and the output must both parse
# and have matching syntax facts.
pub fn format_source source:$str -> std::Result[std::String FormatFailure] {
    source.to_str "<stdin>".to_str products::SourceUnit products::syntax.unwrap = input
    input.get_facts = input_facts_opt
    if input_facts_opt std::Option::Some(input_facts) is then
        std::List[u64]::new = type_brackets
        for span in input_facts.spans.iter do
            if syntax::SyntaxSpanKind::TypeArguments span.kind == then
                span.start type_brackets.push
            fi
        done
        type_brackets input_facts.layout_spans source Formatter::new = formatter
        input.get_tokens formatter.format_tokens = formatted
        formatted.clone "<stdin>".to_str products::SourceUnit products::syntax.unwrap = candidate
        candidate.get_facts = candidate_facts_opt
        if candidate_facts_opt std::Option::Some(candidate_facts) is then
            if candidate_facts input_facts syntax::syntax_facts_match ! then
                FormatFailure::MeaningChanged std::Result::Error
            else
                formatted std::Result::Ok
            fi
        else
            candidate FormatFailure::InvalidOutput std::Result::Error
        fi
    else
        input FormatFailure::InvalidInput std::Result::Error
    fi
}
