    pub fn build_control_rules
        self:mut$Formatter
        tokens:$std::List[common::Token]
        form:$syntax::SyntaxSpan
    {
        form.start tokens self.token_index_at = start_opt
        form.close tokens self.token_index_at = close_opt
        if start_opt.is_none close_opt.is_none || then
            return
        fi
        start_opt.unwrap = start_index
        close_opt.unwrap = close_index
        if close_index start_index tokens self.control_is_inline_value then
            return
        fi

        start_index tokens.get self.add_break

        start_index = header_start
        start_index 1 + = index
        while index close_index > do
            index tokens.get = token
            if
                common::TokenKind::Newline token.kind !=
                token token_offset form self.inside_nested_form !
                &&
            then
                header_start close_index index token form tokens self.apply_control_marker = header_start
            fi
            1 += index
        done
        close_index tokens.get self.add_break
        if tokens.length close_index tokens self.next_token_index std::Option::Some(after_close) is then
            if "}" after_close tokens.get common::Token::value.as_str == then
                after_close tokens.get self.add_break
            fi
        fi
    }

    pub fn build_match_rules
        self:mut$Formatter
        tokens:$std::List[common::Token]
        form:$syntax::SyntaxSpan
    {
        form.close tokens self.token_index_at = close_opt
        if close_opt std::Option::Some(close_index) is then
            close_index tokens.get self.add_break
        fi

        0 (u64) = span_index
        while span_index self.spans.length > do
            span_index self.spans.get = arm
            1 += span_index
            if syntax::SyntaxSpanKind::MatchArm arm.kind != then
                continue
            fi
            arm.start form.start < = starts_inside
            form.close arm.close < = closes_inside
            if starts_inside closes_inside && ! then
                continue
            fi
            arm.start tokens self.token_index_at = arm_start_opt
            arm.close tokens self.token_index_at = arm_close_opt
            if arm_start_opt.is_none arm_close_opt.is_none || then
                continue
            fi
            arm_start_opt.unwrap = arm_start
            arm_close_opt.unwrap = arm_close
            arm_start tokens.get self.add_break
            arm_close arm_start tokens self.build_match_arm_rules
        done
    }

    pub fn definition_contains_structure self:$Formatter definition:$syntax::SyntaxSpan -> bool {
        for span in self.spans.iter do
            syntax::SyntaxSpanKind::ControlForm span.kind ==
            syntax::SyntaxSpanKind::MatchForm span.kind == ||
            = structural
            if structural then
                span.start definition.start < = starts_inside
                definition.close span.close < = closes_inside
                if starts_inside closes_inside && then
                    true return
                fi
            fi
        done
        false
    }

    pub fn build_definition_rules
        self:mut$Formatter
        tokens:$std::List[common::Token]
        definition:$syntax::SyntaxSpan
    {
        definition.start tokens self.token_index_at = start_opt
        definition.close tokens self.token_index_at = close_opt
        if start_opt.is_none close_opt.is_none || then
            return
        fi
        start_opt.unwrap = index
        index = start_index
        close_opt.unwrap = close_index
        close_index = brace_index
        while index close_index > do
            if "{" index tokens.get common::Token::value.as_str == then
                index = brace_index
                break
            fi
            1 += index
        done
        if brace_index close_index == then
            return
        fi

        false = has_comment
        false = has_nested_block
        false = has_layout_break
        0 (u64) = nonblank_lines
        false = line_has_token
        brace_index 1 + = index
        while index close_index > do
            index tokens.get = body_token
            if common::TokenKind::Newline body_token.kind == then
                if line_has_token then
                    1 += nonblank_lines
                fi
                false = line_has_token
            elif common::TokenKind::Comment body_token.kind == then
                true = has_comment
            else
                true = line_has_token
                if body_token token_offset self.break_before offset_list_has then
                    true = has_layout_break
                fi
                if body_token is_block_open_token then
                    true = has_nested_block
                fi
                if
                    common::TokenKind::Keyword body_token.kind ==
                    "match" body_token.value ==
                    &&
                then
                    true = has_nested_block
                fi
            fi
            1 += index
        done
        if line_has_token then
            1 += nonblank_lines
        fi
        definition self.definition_contains_structure = has_structure
        definition.close definition.start self.range_contains_delimited = has_delimited
        2 nonblank_lines < = one_line
        if
            one_line
            has_comment !
            has_nested_block !
            has_structure !
            has_delimited !
            has_layout_break !
            && && && && &&
        then
            return
        fi

        if close_index brace_index tokens self.next_token_index std::Option::Some(body_start) is then
            body_start tokens.get self.add_break
        fi
        close_index tokens.get self.add_break
    }

    pub fn build_accessor_chain_rules
        self:mut$Formatter
        tokens:$std::List[common::Token]
        chain:$syntax::SyntaxSpan
    {
        chain.start tokens self.token_index_at = start_opt
        chain.close tokens self.token_index_at = close_opt
        if start_opt std::Option::Some(start_index) is close_opt std::Option::Some(close_index) is && then
            0 (u64) = accessor_count
            start_index = token_index
            while token_index close_index 1 + > do
                token_index tokens.get = token
                if common::TokenKind::Delimiter token.kind == "." token.value == && then
                    1 += accessor_count
                fi
                1 += token_index
            done
            accessor_count 3 <= = multiline
            start_index = token_index
            while token_index close_index 1 + > do
                token_index tokens.get = token
                if common::TokenKind::Delimiter token.kind == "." token.value == && then
                    multiline token self.add_accessor_rule
                fi
                1 += token_index
            done
        fi
    }

    pub fn add_accessor_rule self:mut$Formatter token:$common::Token multiline:bool {
        if multiline then
            token self.add_break
            token self.add_continuation
        else
            token self.add_join
        fi
    }

    pub fn build_accessor_rules self:mut$Formatter tokens:$std::List[common::Token] {
        0 (u64) = span_index
        while span_index self.spans.length > do
            span_index self.spans.get = chain
            1 += span_index
            if syntax::SyntaxSpanKind::AccessorChain chain.kind == then
                chain tokens self.build_accessor_chain_rules
            fi
        done
    }

    pub fn build_structural_line_rules self:mut$Formatter tokens:$std::List[common::Token] {
        tokens self.build_accessor_rules
        0 (u64) = span_index
        while span_index self.spans.length > do
            span_index self
                .spans
                .get
                .clone = span
            1 += span_index
            if syntax::SyntaxSpanKind::ControlForm span.kind == then
                span tokens self.build_control_rules
            elif syntax::SyntaxSpanKind::MatchForm span.kind == then
                span tokens self.build_match_rules
            elif syntax::SyntaxSpanKind::Definition span.kind == then
                span tokens self.build_definition_rules
            fi
        done
        # A structural form nested in a continuation keeps that extra indent on
        # every line the formatter creates inside the form.
        self.spans.length = nested_index
        while 0 nested_index != do
            1 -= nested_index
            nested_index self.spans.get = nested
            nested self.propagate_structural_continuation
        done
    }

    pub fn propagate_structural_continuation self:mut$Formatter nested:$syntax::SyntaxSpan {
        syntax::SyntaxSpanKind::ControlForm nested.kind ==
        syntax::SyntaxSpanKind::MatchForm nested.kind == ||
        = structural
        if structural ! nested.start self.continuations offset_list_has ! || then
            return
        fi
        0 (u64) = break_index
        while break_index self.break_before.length > do
            break_index self.break_before.get = break_offset
            nested.start break_offset >= nested.close break_offset <= && = inside
            if inside then
                break_offset copy self.continuations.push
            fi
            1 += break_index
        done
    }
}

# ============================================================================
# Emit a line of tokens with proper spacing
# ============================================================================

impl Formatter {
    pub fn emit_line_tokens self:mut$Formatter line:$std::List[common::Token] {
        0 = continuation_depth
        if line.is_empty ! then
            0 line.get token_offset self.continuations offset_list_count (i64) = continuation_depth
        fi
        continuation_depth += self.depth
        self.depth make_indent self.output.append_string
        0 (u64) = ti
        while ti line.length > do
            ti line.get = lt
            self.source lt token_text self.output.append_string
            ti 1 + = next_ti
            if next_ti line.length > then
                if next_ti ti line tokens_need_space then
                    " " self.output.append
                fi
            fi
            1 += ti
        done
        "\n" self.output.append
        continuation_depth -= self.depth
    }

    # ============================================================================
    # Measure line length as it would be emitted
    # ============================================================================

    pub fn measure_line_length self:mut$Formatter line:$std::List[common::Token] -> u64 {
        self.depth = measure_depth
        if line.is_empty ! then
            0 line.get token_offset self.continuations offset_list_count (i64) += measure_depth
        fi
        measure_depth 4 * (u64) = len
        0 (u64) = mi
        while mi line.length > do
            mi line.get = m_tok
            self.source m_tok token_text.length len + = len
            mi 1 + = m_next
            if m_next line.length > then
                if m_next mi line tokens_need_space then
                    1 += len
                fi
            fi
            1 += mi
        done
        len
    }

    # ============================================================================
    # Emit a wrapped function declaration
    # ============================================================================

    pub fn emit_wrapped_fn_decl self:mut$Formatter line:$std::List[common::Token] {
        # Line 1: fn name (and optional generics)
        self.depth make_indent self.output.append_string
        line get_function_keyword_index.unwrap = function_keyword_index
        0 (u64) = prefix_index
        while prefix_index function_keyword_index 1 + > do
            self.source prefix_index line.get token_text self.output.append_string
            " " self.output.append
            1 += prefix_index
        done
        function_keyword_index 1 + = name_index
        self.source name_index line.get token_text self.output.append_string

        name_index 1 + = wi
        # Handle generics [T] or [T: Trait, V]
        if wi line.length > then
            if "[" wi line.get common::Token::value.as_str == then
                false = gen_done
                while wi line.length > gen_done ! && do
                    self.source wi line.get token_text self.output.append_string
                    if "]" wi line.get common::Token::value.as_str == then
                        1 += wi
                        "\n" self.output.append
                        true = gen_done
                    else
                        1 += wi
                    fi
                done
            else
                "\n" self.output.append
            fi
        else
            "\n" self.output.append
        fi

        # Emit parameters, one per line
        while wi line.length > do
            wi line.get common::Token::value.as_str = wv: $str

            # -> starts the return type line
            if "->" wv == then
                self.depth make_indent self.output.append_string
                while wi line.length > do
                    self.source wi line.get token_text self.output.append_string
                    wi 1 + = w_next
                    if w_next line.length > then
                        w_next line.get common::Token::value.as_str = ret_next_val: $str
                        true = ret_space
                        if wi line.get common::Token::value.as_str should_skip_space_after then
                            false = ret_space
                        fi
                        if ret_next_val "[" == ret_next_val "]" == || then
                            false = ret_space
                        fi
                        if ret_space then
                            " " self.output.append
                        fi
                    fi
                    1 += wi
                done
                "\n" self.output.append
            elif "{" wv == then
                # No return type, emit just {
                self.depth make_indent self.output.append_string
                "{\n" self.output.append
                line.length = wi
            else
                # Parameter: name:Type
                self.depth 1 + make_indent self.output.append_string
                self.source wi line.get token_text self.output.append_string
                1 += wi
                # Colon
                if wi line.length > then
                    if ":" wi line.get common::Token::value.as_str == then
                        ":" self.output.append
                        1 += wi
                        # Type tokens until next param or -> or {
                        false = param_done
                        while wi line.length > param_done ! && do
                            wi line.get common::Token::value.as_str = pv: $str
                            if "->" pv == then
                                true = param_done
                            elif "{" pv == then
                                true = param_done
                            else
                                # Check if this is a new param (Identifier followed by :)
                                false = is_new_param
                                if common::TokenKind::Identifier wi line.get common::Token::kind == then
                                    wi 1 + = check_col
                                    if check_col line.length > then
                                        if ":" check_col line.get common::Token::value.as_str == then
                                            true = is_new_param
                                        fi
                                    fi
                                fi
                                if is_new_param then
                                    true = param_done
                                else
                                    wi line.get common::Token::value.as_str = type_val: $str
                                    # Space before type token, respecting bracket and colon rules
                                    if "[" type_val != "]" type_val != && then
                                        wi 1 - line.get common::Token::value.as_str = prev_tok_val: $str
                                        if "[" prev_tok_val != ":" prev_tok_val != && then
                                            " " self.output.append
                                        fi
                                    fi
                                    self.source wi line.get token_text self.output.append_string
                                    1 += wi
                                fi
                            fi
                        done
                        "\n" self.output.append
                    else
                        "\n" self.output.append
                    fi
                else
                    "\n" self.output.append
                fi
            fi
        done
    }

    # ============================================================================
    # Format struct/enum body with field alignment
    # ============================================================================

    # Emit one struct field (with type alignment) or enum variant on its own line.
    pub fn emit_struct_item
        self:mut$Formatter
        max_name_len:u64
        is_enum:bool
        item:$std::List[common::Token]
    {
        if is_enum ! item is_field_line && then
            # Aligned field: name:  Type
            self.depth make_indent self.output.append_string
            item get_public_item_offset = name_index
            if 0 name_index != then
                "pub " self.output.append
            fi
            name_index item.get common::Token::value.as_str self.output.append
            ":" self.output.append
            name_index item.get common::Token::value.as_str.length name_index 4 * + = cur_name_len
            max_name_len cur_name_len - 1 + = padding
            0 (u64) = pad_i
            while pad_i padding > do
                " " self.output.append
                1 += pad_i
            done
            name_index 2 + = type_i
            while type_i item.length > do
                self.source type_i item.get token_text self.output.append_string
                type_i 1 + = next_type_i
                if next_type_i item.length > then
                    next_type_i item.get common::Token::value.as_str = field_next_val: $str
                    true = field_space
                    if type_i item.get common::Token::value.as_str should_skip_space_after then
                        false = field_space
                    fi
                    if field_next_val "[" == field_next_val "]" == || then
                        false = field_space
                    fi
                    if field_space then
                        " " self.output.append
                    fi
                fi
                1 += type_i
            done
            "\n" self.output.append
        else
            item self.emit_line_tokens
        fi
    }

    # Format a struct/enum body: header on one line, then every field or variant
    # on its own indented line regardless of the input grouping, with struct-field
    # type alignment. `line_tokens` is the header (holds the whole body when it fit
    # on one source line). Returns the resume position.
    pub fn emit_struct_body
        self:mut$Formatter
        line_tokens:$std::List[common::Token]
        body_span:$syntax::SyntaxSpan
        is_enum:bool
        tokens:$std::List[common::Token]
        pos:u64
    -> u64 {
        line_tokens.length = hn

        # Locate the body-opening brace and emit the header through it.
        hn = brace_idx
        false = have_brace
        0 (u64) = hi
        while hi hn > have_brace ! && do
            if "{" hi line_tokens.get common::Token::value.as_str == then
                hi = brace_idx
                true = have_brace
            fi
            1 += hi
        done
        std::List[common::Token]::new = header
        0 (u64) = ci
        while ci brace_idx 1 + > do
            ci line_tokens.get.clone header.push
            1 += ci
        done
        header self.emit_line_tokens

        # Gather body tokens (keep newlines so trailing comments can be told from
        # standalone ones) up to the close brace.
        std::List[common::Token]::new = body
        false = closed
        brace_idx 1 + = bi
        while bi hn > closed ! && do
            bi line_tokens.get = bt
            if
                "}" bt common::Token::value.as_str ==
                bt common::Token::location common::Location::span common::Span::offset body_span.close ==
                &&
            then
                true = closed
            else
                bt.clone body.push
                1 += bi
            fi
        done
        pos = out_pos
        if closed ! then
            pos = si
            false = mdone
            while si tokens.length > mdone ! && do
                si tokens.get = mt
                1 += si
                if mt is_eof_token then
                    true = mdone
                elif
                    "}" mt common::Token::value.as_str ==
                    mt common::Token::location common::Location::span common::Span::offset body_span.close ==
                    &&
                then
                    true = mdone
                else
                    mt.clone body.push
                fi
            done
            si = out_pos
        fi

        1 += self.depth

        # For structs, find the longest field name for type alignment.
        0 (u64) = max_name_len
        if is_enum ! then
            0 (u64) = fdi
            0 = fdepth
            while fdi body.length > do
                fdi body.get common::Token::value.as_str = fdv: $str
                if "[" fdv == "(" fdv == || then
                    1 += fdepth
                elif "]" fdv == ")" fdv == || then
                    1 -= fdepth
                elif
                    0 fdepth ==
                    common::TokenKind::Identifier fdi body.get common::Token::kind ==
                    &&
                then
                    fdi 1 + = fdnext
                    if fdnext body.length > then
                        if ":" fdnext body.get common::Token::value.as_str == then
                            fdi body.get common::Token::value.as_str.length = nlen
                            if 0 fdi != then
                                if "pub" fdi 1 - body.get common::Token::value.as_str == then
                                    4 += nlen
                                fi
                            fi
                            if max_name_len nlen > then
                                nlen = max_name_len
                            fi
                        fi
                    fi
                fi
                1 += fdi
            done
        fi

        # Split body into items (and standalone comments); emit each on its line.
        # A comment with no newline before it is a trailing comment and stays with
        # its item; one preceded by a newline is emitted on its own line.
        std::List[common::Token]::new = item
        0 = depth
        true = saw_newline
        0 (u64) = k
        while k body.length > do
            k body.get = t
            t common::Token::value.as_str = tv: $str
            if common::TokenKind::Newline t common::Token::kind == then
                true = saw_newline
            elif common::TokenKind::Comment t common::Token::kind == then
                if saw_newline then
                    if 0 item.length != then
                        item is_enum max_name_len self.emit_struct_item
                        std::List[common::Token]::new = item
                    fi
                    self.depth make_indent self.output.append_string
                    self.source t token_text self.output.append_string
                    "\n" self.output.append
                else
                    t.clone item.push
                fi
                false = saw_newline
            else
                false = is_start
                if 0 depth == is_enum ! "pub" tv == && && then
                    true = is_start
                fi
                if 0 depth == common::TokenKind::Identifier t common::Token::kind == && then
                    if is_enum then
                        true = is_start
                    else
                        k 1 + = nx
                        if nx body.length > then
                            if ":" nx body.get common::Token::value.as_str == then
                                true = is_start
                            fi
                        fi
                    fi
                fi
                if is_start 0 item.length != && then
                    if 1 item.length != "pub" 0 item.get common::Token::value.as_str != || then
                        item is_enum max_name_len self.emit_struct_item
                        std::List[common::Token]::new = item
                    fi
                fi
                t.clone item.push
                if "[" tv == "(" tv == || then
                    1 += depth
                elif "]" tv == ")" tv == || then
                    1 -= depth
                fi
                false = saw_newline
            fi
            1 += k
        done
        if 0 item.length != then
            item is_enum max_name_len self.emit_struct_item
        fi

        1 -= self.depth
        self.depth make_indent self.output.append_string
        "}\n" self.output.append
        out_pos
    }

    # ============================================================================
    # Definition span lookup: the parser records a Definition span for every
    # top-level function, method, and trait-default definition (never lambdas),
    # keyed by the byte offset of its `fn` keyword.
    # ============================================================================

    pub fn definition_span_at self:$Formatter offset:u64 -> std::Option[syntax::SyntaxSpan] {
        for s in self.spans.iter do
            if syntax::SyntaxSpanKind::Definition s.kind == offset s.start == && then
                s.clone std::Option::Some return
            fi
        done
        std::Option[syntax::SyntaxSpan]::None
    }

    # StructBody/EnumBody span whose opening brace is at `offset`.
    pub fn struct_or_enum_span_at self:$Formatter offset:u64 -> std::Option[syntax::SyntaxSpan] {
        for s in self.spans.iter do
            if
                offset s.start ==
                syntax::SyntaxSpanKind::StructBody s.kind == syntax::SyntaxSpanKind::EnumBody s.kind == ||
                &&
            then
                s.clone std::Option::Some return
            fi
        done
        std::Option[syntax::SyntaxSpan]::None
    }

    # DelimitedForm span whose opening `[` is at `offset`. Only array literals
    # record this span, so generic-type brackets never match.
    pub fn delimited_span_at self:$Formatter offset:u64 -> std::Option[syntax::SyntaxSpan] {
        for s in self.spans.iter do
            if syntax::SyntaxSpanKind::DelimitedForm s.kind == offset s.start == && then
                s.clone std::Option::Some return
            fi
        done
        std::Option[syntax::SyntaxSpan]::None
    }

    # True when a delimited form opens strictly inside the (start, close) byte
    # range. A definition body that holds one uses a multiline body so the array
    # routes through the delimited canonicalizer, which keeps compact and
    # expanded source layouts converging.
    pub fn range_contains_delimited self:$Formatter start:u64 close:u64 -> bool {
        for s in self.spans.iter do
            if
                syntax::SyntaxSpanKind::DelimitedForm s.kind ==
                s.start start < close s.start < &&
                &&
            then
                true return
            fi
        done
        false
    }

    # ============================================================================
    # Canonicalize a delimited form (array literal) from its recorded span.
    #
    # `line_tokens` holds the first physical line, which contains the opening
    # `[`. Assembles the whole logical line (gathering across newlines when the
    # form wraps in the source), then emits it compact when the canonical form
    # fits within 100 characters, or expanded (one item per indented line,
    # trailing comma, closing `]` aligned with the opener, composition suffix
    # kept with the `]`) otherwise. Returns the new token position when handled,
    # or -1 to defer to the ordinary line path (no array literal on the line, or
    # the line also carries a block or control token).
    # ============================================================================
    pub fn try_emit_delimited
        self:mut$Formatter
        line_tokens:$std::List[common::Token]
        tokens:$std::List[common::Token]
        pos:u64
    -> i64 {
        # Find the first `[` in line_tokens that opens an array literal.
        0 (u64) = open_idx
        std::Option[syntax::SyntaxSpan]::None = form_span
        false = found_open
        0 (u64) = oi
        while oi line_tokens.length > found_open ! && do
            oi line_tokens.get = ft
            if "[" ft common::Token::value.as_str == then
                ft common::Token::location common::Location::span common::Span::offset self.delimited_span_at = maybe
                if maybe std::Option::Some(sp) is then
                    oi = open_idx
                    sp.clone std::Option::Some = form_span
                    true = found_open
                fi
            fi
            1 += oi
        done
        if found_open ! then
            -1 (i64) return
        fi
        form_span.unwrap = span

        # Assemble the full logical line. When the closing `]` is on a later
        # source line, gather across newlines up to it and keep any suffix on the
        # same source line as the `]`.
        std::List[common::Token]::new = full_line
        0 (u64) = ci
        while ci line_tokens.length > do
            ci line_tokens.get.clone full_line.push
            1 += ci
        done
        pos = out_pos

        false = have_close
        0 (u64) = hci
        while hci line_tokens.length > have_close ! && do
            hci line_tokens.get = ht
            if
                "]" ht common::Token::value.as_str ==
                ht common::Token::location common::Location::span common::Span::offset span.close ==
                &&
            then
                true = have_close
            fi
            1 += hci
        done
        if have_close ! then
            pos = si
            false = closed
            false = line_done
            while si tokens.length > line_done ! && do
                si tokens.get = st
                if st is_eof_token then
                    true = line_done
                elif common::TokenKind::Newline st common::Token::kind == then
                    if closed then
                        true = line_done
                    else
                        1 += si
                    fi
                else
                    "]" st common::Token::value.as_str == = st_is_close
                    st common::Token::location common::Location::span common::Span::offset span.close == = st_at_close
                    st.clone full_line.push
                    1 += si
                    if st_is_close st_at_close && then
                        true = closed
                    fi
                fi
            done
            si = out_pos
        fi

        # Defer lines that also carry a block or control token.
        if full_line line_has_block_or_control then
            -1 (i64) return
        fi

        # Locate the close index within full_line.
        full_line.length = close_idx
        false = fc
        0 (u64) = fli
        while fli full_line.length > fc ! && do
            fli full_line.get = flt
            if
                "]" flt common::Token::value.as_str ==
                flt common::Token::location common::Location::span common::Span::offset span.close ==
                &&
            then
                fli = close_idx
                true = fc
            fi
            1 += fli
        done
        if fc ! then
            -1 (i64) return
        fi

        # prefix = [0, open_idx); inner = (open_idx, close_idx); suffix = (close_idx, end)
        std::List[common::Token]::new = prefix
        0 (u64) = pi
        while pi open_idx > do
            pi full_line.get.clone prefix.push
            1 += pi
        done
        std::List[common::Token]::new = inner
        open_idx 1 + = ii
        while ii close_idx > do
            ii full_line.get.clone inner.push
            1 += ii
        done
        std::List[common::Token]::new = suffix
        close_idx 1 + = xi
        while xi full_line.length > do
            xi full_line.get.clone suffix.push
            1 += xi
        done

        inner split_delimited_items = items

        # Canonical compact line: prefix [ i0, i1, ... ] suffix
        std::List[common::Token]::new = compact
        0 (u64) = cpi
        while cpi prefix.length > do
            cpi prefix.get.clone compact.push
            1 += cpi
        done
        open_idx full_line.get.clone compact.push
        0 (u64) = iti
        while iti items.length > do
            iti items.get = item
            0 (u64) = itj
            while itj item.length > do
                itj item.get.clone compact.push
                1 += itj
            done
            items.length iti 1 + < = not_last
            if not_last then
                open_idx full_line.get common::Token::location common::TokenKind::Delimiter ",".to_str common::Token::new compact.push
            fi
            1 += iti
        done
        close_idx full_line.get.clone compact.push
        0 (u64) = sfi
        while sfi suffix.length > do
            sfi suffix.get.clone compact.push
            1 += sfi
        done

        compact self.measure_line_length = width
        if width 100 < ! then
            compact self.emit_line_tokens
            out_pos (i64) return
        fi

        # Expand: prefix [ then one item per indented line with a trailing comma,
        # then ] with the suffix.
        std::List[common::Token]::new = head
        0 (u64) = hpi
        while hpi prefix.length > do
            hpi prefix.get.clone head.push
            1 += hpi
        done
        open_idx full_line.get.clone head.push
        head self.emit_line_tokens

        1 += self.depth
        0 (u64) = ei
        while ei items.length > do
            ei items.get = eitem
            std::List[common::Token]::new = item_line
            0 (u64) = eij
            while eij eitem.length > do
                eij eitem.get.clone item_line.push
                1 += eij
            done
            open_idx full_line.get common::Token::location common::TokenKind::Delimiter ",".to_str common::Token::new item_line.push
            item_line self.emit_line_tokens
            1 += ei
        done
        1 -= self.depth

        std::List[common::Token]::new = tail
        close_idx full_line.get.clone tail.push
        0 (u64) = tsi
        while tsi suffix.length > do
            tsi suffix.get.clone tail.push
            1 += tsi
        done
        tail self.emit_line_tokens

        out_pos (i64)
    }

    # ============================================================================
    # Canonicalize a definition from its recorded span.
    #
    # `line_tokens` holds the already-assembled declaration (through the body
    # `{`, or the whole definition when it fit on one source line). Returns the
    # new token position when handled, or -1 to defer to the ordinary multiline
    # path (used for multiline bodies and shapes this routine does not own).
    # ============================================================================

    pub fn try_emit_definition
        self:mut$Formatter
        line_tokens:$std::List[common::Token]
        def_span:$syntax::SyntaxSpan
        tokens:$std::List[common::Token]
        pos:u64
    -> i64 {
        line_tokens.length = n

        # Locate the body-opening brace (first `{`).
        n = brace_idx
        false = have_brace
        0 (u64) = i
        while i n > have_brace ! && do
            if "{" i line_tokens.get common::Token::value.as_str == then
                i = brace_idx
                true = have_brace
            fi
            1 += i
        done
        if have_brace ! then
            -1 return
        fi

        # A body holding a delimited form uses the multiline path so the array
        # routes through the delimited canonicalizer (compact and expanded source
        # layouts then converge).
        if def_span.close def_span.start self.range_contains_delimited then
            -1 return
        fi
        if def_span self.definition_contains_structure then
            -1 return
        fi

        # A single-source definition already holds its closing brace.
        false = single_source
        n = close_idx
        0 (u64) = j
        while j n > single_source ! && do
            j line_tokens.get = jt
            if
                "}" jt common::Token::value.as_str ==
                jt common::Token::location common::Location::span common::Span::offset def_span.close ==
                &&
            then
                true = single_source
                j = close_idx
            fi
            1 += j
        done

        # Only own clean shapes: single-source ending exactly at the close brace,
        # or multi-source whose collected line ends at the body `{`.
        n 1 - line_tokens.get = last_tok
        if single_source then
            if
                "}" last_tok common::Token::value.as_str ==
                last_tok common::Token::location common::Location::span common::Span::offset def_span.close ==
                &&
                !
            then
                -1 return
            fi
        else
            if "{" last_tok common::Token::value.as_str == ! then
                -1 return
            fi
        fi

        # Collect the body tokens (between the braces) and remember the closing
        # brace token. `out_pos` is where the caller resumes.
        std::List[common::Token]::new = body_between
        pos = out_pos
        syntax::fallback_token = close_brace_tok
        if single_source then
            close_idx line_tokens.get.clone = close_brace_tok
            brace_idx 1 + = bi
            while bi close_idx > do
                bi line_tokens.get.clone body_between.push
                1 += bi
            done
        else
            pos = scan_i
            false = bdone
            while scan_i tokens.length > bdone ! && do
                scan_i tokens.get = bt
                1 += scan_i
                if bt is_eof_token then
                    true = bdone
                elif
                    "}" bt common::Token::value.as_str ==
                    bt common::Token::location common::Location::span common::Span::offset def_span.close ==
                    &&
                then
                    bt.clone = close_brace_tok
                    true = bdone
                else
                    bt.clone body_between.push
                fi
            done
            scan_i = out_pos
        fi

        # Meaningful body tokens for inline assembly (drop newlines/comments).
        std::List[common::Token]::new = body_meaningful
        0 (u64) = k
        while k body_between.length > do
            k body_between.get = bmt
            if common::TokenKind::Newline bmt common::Token::kind == then
            elif common::TokenKind::Comment bmt common::Token::kind == then
            else
                bmt.clone body_meaningful.push
            fi
            1 += k
        done

        # Assemble the inline form: decl `{` body `}`.
        std::List[common::Token]::new = inline_tokens
        if single_source then
            0 (u64) = di
            while di brace_idx 1 + > do
                di line_tokens.get.clone inline_tokens.push
                1 += di
            done
        else
            0 (u64) = li
            while li line_tokens.length > do
                li line_tokens.get.clone inline_tokens.push
                1 += li
            done
        fi
        0 (u64) = mi
        while mi body_meaningful.length > do
            mi body_meaningful.get.clone inline_tokens.push
            1 += mi
        done
        close_brace_tok inline_tokens.push

        # Inline when the body shape allows and the whole form fits.
        inline_tokens self.measure_line_length = inline_len
        false = eligible
        if
            body_between body_shape_inlineable
            inline_len 100 < !
            &&
        then
            true = eligible
        fi

        if eligible then
            inline_tokens self.emit_line_tokens
            out_pos (i64) return
        fi

        # Multiline bodies that arrived across source lines are already handled by
        # the ordinary path; defer to it.
        if single_source ! then
            -1 return
        fi

        # Single-source but ineligible: break the body onto its own line.
        std::List[common::Token]::new = decl_line
        0 (u64) = ci
        while ci brace_idx 1 + > do
            ci line_tokens.get.clone decl_line.push
            1 += ci
        done
        decl_line self.measure_line_length = decl_len
        if decl_len 100 < then
            decl_line self.emit_wrapped_fn_decl
        else
            decl_line self.emit_line_tokens
        fi
        1 += self.depth
        if 0 body_meaningful.length != then
            body_meaningful self.emit_line_tokens
        fi
        1 -= self.depth
        self.depth make_indent self.output.append_string
        "}\n" self.output.append
        out_pos (i64) return
    }

    # ============================================================================
    # Format tokens into a string
    # ============================================================================

    pub fn format_tokens self:Formatter tokens:$std::List[common::Token] -> std::String {
        tokens self.build_structural_line_rules
        0 (u64) = pos
        0 = self.depth
        0 = consecutive_newlines
        false = prev_was_open
        false = prev_was_comment
        false = prev_was_safety_comment
        false = prev_was_section_comment
        false = prev_was_definition
        false = prev_was_import
        std::List[common::Token]::new = line_tokens

        while pos tokens.length > do
            pos tokens.get = token

            # End of file
            if token is_eof_token then
                if 0 self.output.length == then
                    "\n" self.output.append
                fi
                self.output.clone return
            fi

            # Handle newline token
            if common::TokenKind::Newline token common::Token::kind == then
                1 += consecutive_newlines
                1 += pos
                continue
            fi

            # We have a non-newline, non-Eof token. Collect the full line.
            while line_tokens.is_empty ! do
                line_tokens.pop drop
            done
            false = collect_done
            while pos tokens.length > collect_done ! && do
                pos tokens.get = cur
                if cur is_eof_token then
                    true = collect_done
                elif common::TokenKind::Newline cur common::Token::kind == then
                    pos = next_pos
                    while next_pos tokens.length > do
                        if common::TokenKind::Newline next_pos tokens.get common::Token::kind != then
                            break
                        fi
                        1 += next_pos
                    done
                    if next_pos tokens.length > then
                        next_pos tokens.get = next_token
                        next_token token_offset self.join_before offset_list_has = joins_line
                        next_token token_offset self.break_before offset_list_has = breaks_line
                        if joins_line breaks_line ! && then
                            next_pos = pos
                        else
                            true = collect_done
                        fi
                    else
                        true = collect_done
                    fi
                else
                    cur token_offset self.break_before offset_list_has = breaks_line
                    if breaks_line line_tokens.is_empty ! && then
                        true = collect_done
                    else
                        cur.clone line_tokens.push
                        1 += pos
                    fi
                fi
            done

            if line_tokens.length 0 == then
                continue
            fi

            # Get first token value for indent adjustments
            0 line_tokens.get common::Token::value.clone = first_value
            line_tokens get_public_item_offset = declaration_index
            declaration_index line_tokens.get common::Token::value.clone = declaration_value

            # Decrease self.depth for closing/dedent keywords
            if first_value.as_str is_block_close_value then
                if 0 self.depth != then
                    1 -= self.depth
                fi
            fi
            if first_value.as_str is_dedent_keyword then
                if 0 self.depth != then
                    1 -= self.depth
                fi
            fi

            # Blank line normalization
            if 0 self.output.length != then
                0 = blank_lines
                if 0 consecutive_newlines != then
                    consecutive_newlines 1 - = blank_lines
                fi
                0 = allowed_blanks

                if 0 blank_lines != then
                    if 0 line_tokens.get is_section_separator_comment then
                        if prev_was_section_comment then
                            0 = allowed_blanks
                        else
                            1 = allowed_blanks
                        fi
                    elif 0 self.depth == then
                        if line_tokens is_toplevel_definition_line prev_was_definition || then
                            if "import" first_value == prev_was_import && ! then
                                1 = allowed_blanks
                            fi
                        fi
                    else
                        1 = allowed_blanks
                    fi
                else
                    if 0 self.depth == then
                        if 0 line_tokens.get is_section_separator_comment then
                            if prev_was_section_comment ! then
                                1 = allowed_blanks
                            fi
                        elif line_tokens is_toplevel_definition_line prev_was_definition || then
                            if "import" first_value == prev_was_import && ! then
                                1 = allowed_blanks
                            fi
                        fi
                    fi
                fi

                if prev_was_open then
                    0 = allowed_blanks
                fi
                if first_value.as_str is_block_close_value then
                    0 = allowed_blanks
                fi
                if first_value.as_str is_dedent_keyword then
                    0 = allowed_blanks
                fi
                if prev_was_comment 0 blank_lines == && then
                    0 = allowed_blanks
                fi
                if prev_was_safety_comment line_tokens get_function_keyword_index.is_some && then
                    0 = allowed_blanks
                fi

                0 = nl_i
                while nl_i allowed_blanks > do
                    "\n" self.output.append
                    1 += nl_i
                done
            fi
            0 = consecutive_newlines

            # Struct/enum header: split each field/variant onto its own line.
            false = handled_struct
            if "struct" declaration_value == "enum" declaration_value == || then
                # Find the body-opening brace and its recorded body span.
                line_tokens.length = sn
                sn = sbrace
                false = shave
                0 (u64) = sfi
                while sfi sn > shave ! && do
                    if "{" sfi line_tokens.get common::Token::value.as_str == then
                        sfi = sbrace
                        true = shave
                    fi
                    1 += sfi
                done
                if shave then
                    sbrace line_tokens.get common::Token::location common::Location::span common::Span::offset = soff
                    soff self.struct_or_enum_span_at = maybe_body
                    if maybe_body std::Option::Some(body_span) is then
                        "enum" declaration_value == = is_enum_hdr
                        pos tokens is_enum_hdr body_span line_tokens self.emit_struct_body = pos
                        false = prev_was_open
                        false = prev_was_comment
                        false = prev_was_safety_comment
                        false = prev_was_section_comment
                        true = prev_was_definition
                        false = prev_was_import
                        true = handled_struct
                    fi
                fi
            fi

            if handled_struct ! then
                false = handled_def
                # Check if this is a fn declaration (possibly wrapped across lines)
                false = wrapped_fn
                if line_tokens get_function_keyword_index std::Option::Some(function_keyword_index) is then
                    # Check if this line contains { (complete declaration)
                    false = has_open_brace
                    0 (u64) = brace_index
                    while brace_index line_tokens.length > do
                        if "{" brace_index line_tokens.get_ref common::Token::value.as_str == then
                            true = has_open_brace
                        fi
                        1 += brace_index
                    done
                    if has_open_brace ! then
                        # Incomplete fn declaration: collect continuation lines
                        # until we find { or end of declaration
                        false = decl_complete
                        while pos tokens.length > decl_complete ! && do
                            pos tokens.get = decl_tok
                            if decl_tok is_eof_token then
                                true = decl_complete
                            elif common::TokenKind::Newline decl_tok common::Token::kind == then
                                1 += pos
                            elif "}" decl_tok common::Token::value.as_str == then
                                # Closing brace of enclosing block: stop, don't consume
                                true = decl_complete
                            elif common::TokenKind::Keyword decl_tok common::Token::kind == then
                                # New keyword (fn, struct, etc): this fn has no body
                                decl_tok common::Token::value.as_str = decl_kw: $str
                                if
                                    "fn" decl_kw == "struct" decl_kw == ||
                                    "enum" decl_kw == || "impl" decl_kw == ||
                                    "trait" decl_kw == ||
                                then
                                    true = decl_complete
                                else
                                    decl_tok.clone line_tokens.push
                                    1 += pos
                                fi
                            else
                                # Collect this continuation line
                                false = decl_line_done
                                while pos tokens.length > decl_line_done ! && do
                                    pos tokens.get = sl_tok
                                    if sl_tok is_eof_token then
                                        true = decl_line_done
                                    elif common::TokenKind::Newline sl_tok common::Token::kind == then
                                        true = decl_line_done
                                    else
                                        "{" sl_tok common::Token::value.as_str == = opens_body
                                        sl_tok.clone line_tokens.push
                                        1 += pos
                                        if opens_body then
                                            true = decl_complete
                                            true = decl_line_done
                                        fi
                                    fi
                                done
                            fi
                        done
                    fi

                    # Canonicalize real definitions from their recorded span.
                    # Lambdas carry no Definition span, so they fall through.
                    function_keyword_index line_tokens.get common::Token::location common::Location::span common::Span::offset = fn_offset
                    fn_offset self.definition_span_at = maybe_def
                    if maybe_def std::Option::Some(def_span) is then
                        pos tokens def_span line_tokens self.try_emit_definition = def_result
                        if 0 def_result >= then
                            def_result (u64) = pos
                            true = handled_def
                        fi
                    fi

                    if handled_def ! then
                        # Now line_tokens has the full declaration. Check length.
                        line_tokens self.measure_line_length = decl_len
                        if decl_len 100 < then
                            line_tokens self.emit_wrapped_fn_decl
                            true = wrapped_fn
                        fi
                    fi
                fi

                # Canonicalize a delimited form (array literal) on this line.
                # Lines with a block or control token defer (return -1).
                false = handled_delim
                if handled_def ! wrapped_fn ! && then
                    pos tokens line_tokens self.try_emit_delimited = delim_result
                    if 0 delim_result >= then
                        delim_result (u64) = pos
                        true = handled_delim
                    fi
                fi

                if handled_def ! handled_delim ! && then
                    if wrapped_fn ! then
                        line_tokens self.emit_line_tokens
                    fi

                    # Increase self.depth for block-opening tokens
                    false = prev_was_open
                    line_tokens.length 1 - line_tokens.get = last_token
                    if last_token is_block_open_token then
                        1 += self.depth
                        true = prev_was_open
                    fi

                    # Check if line contains match keyword
                    for mt in line_tokens.iter do
                        if common::TokenKind::Keyword mt common::Token::kind == then
                            if "match" mt common::Token::value.as_str == then
                                1 += self.depth
                                true = prev_was_open
                            fi
                        fi
                    done

                    # Track if this line was a comment
                    if common::TokenKind::Comment 0 line_tokens.get common::Token::kind == then
                        if 0 line_tokens.get common::Token::value.as_str "# SAFETY:" str::starts_with then
                            true = prev_was_safety_comment
                        elif prev_was_comment ! then
                            false = prev_was_safety_comment
                        fi
                        true = prev_was_comment
                        # Track section comment context (separator or comment between separators)
                        if 0 line_tokens.get is_section_separator_comment then
                            true = prev_was_section_comment
                        elif prev_was_section_comment then
                            # Comment between separators, keep the flag
                        fi
                    else
                        false = prev_was_comment
                        false = prev_was_safety_comment
                        false = prev_was_section_comment
                    fi

                    # Track if this was a top-level definition or import
                    if 0 self.depth == then
                        if line_tokens is_toplevel_definition_line "import" first_value == || then
                            true = prev_was_definition
                        else
                            false = prev_was_definition
                        fi
                        "import" first_value == = prev_was_import
                    else
                        false = prev_was_definition
                        false = prev_was_import
                    fi

                    # else keyword: restore self.depth for body
                    if "else" first_value == then
                        1 += self.depth
                        true = prev_was_open
                    fi
                else
                    # Completed a canonicalized definition or delimited-form line.
                    false = prev_was_open
                    false = prev_was_comment
                    false = prev_was_safety_comment
                    false = prev_was_section_comment
                    false = prev_was_import
                    # A delimited-form line is never a top-level definition; a
                    # canonicalized definition at depth 0 is.
                    if 0 self.depth == handled_delim ! && then
                        true = prev_was_definition
                    else
                        false = prev_was_definition
                    fi
                fi
            fi
        done

        if 0 self.output.length == then
            "\n" self.output.append
        fi
        self.output.clone
    }
}

# ============================================================================
# Entry point
# ============================================================================

pub fn main {
    read_all_stdin = source

    "<stdin>" source.as_str syntax::analyze_syntax.into_parts = input_diagnostics = input_facts_opt = input_tokens
    if input_facts_opt std::Option::Some(input_facts) is then
        input_facts.spans source.as_str Formatter::new = formatter
        input_tokens formatter.format_tokens = formatted
        "<stdin>" formatted.as_str syntax::analyze_syntax.into_parts
        = candidate_diagnostics = candidate_facts_opt = candidate_tokens
        if candidate_facts_opt std::Option::Some(candidate_facts) is then
            if candidate_facts input_facts syntax::syntax_facts_match ! then
                "error: formatter changed source meaning" std::eprintln
                source print
                1 std::exit
            fi
            formatted print
        else
            "error: formatter produced invalid syntax" std::eprintln
            candidate_diagnostics formatted.as_str report_syntax_diagnostics
            source print
            1 std::exit
        fi
    else
        input_diagnostics source.as_str report_syntax_diagnostics
        source print
        1 std::exit
    fi
}
main
