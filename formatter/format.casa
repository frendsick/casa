                    true = saw_arrow
                    after_newline token self.join_if_after_newline
                elif
                    "{" value ==
                    common::TokenKind::Delimiter token.kind ==
                    follows_arrow
                    && &&
                then
                    after_newline token self.join_if_after_newline
                    arm_close 1 + index tokens self.break_after_token
                    arm_close tokens.get self.add_break
                    return
                elif after_newline then
                    if saw_arrow 0 brace_depth == && then
                        token self.add_join
                    elif wrapped ! then
                        arm_index self.spans.get = arm
                        arm.clone self.wrapped_arms.push
                        true = wrapped
                    fi
                fi
                if saw_arrow common::TokenKind::Delimiter token.kind == && then
                    if "{" value == then
                        1 += brace_depth
                    elif "}" value == 0 brace_depth != && then
                        1 -= brace_depth
                    fi
                fi
                "=>" value == = follows_arrow
                false = after_newline
            fi
        done
