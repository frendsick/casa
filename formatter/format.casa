        self:mut$Formatter
        tokens:$std::List[common::Token]
        arm_index:u64
        arm_start:u64
        arm_close:u64
    {
        arm_index self.nested_match_arms = nested
        0 = nested_index: u64
        false = wrapped
        false = saw_arrow
        false = follows_arrow
        0 = brace_depth: u64
        false = after_newline
        for index in arm_close 1 + arm_start std::Range::new do
            index tokens.get = token
            token token_offset = offset
            # Nested arms build their own rules.
            while nested_index nested.length < do
                if nested_index nested.get_ref.close offset >= then
                    break
                fi
                1 += nested_index
            done
            if nested_index nested.length < then
                if nested_index nested.get_ref.start offset <= then
                    continue
                fi
            fi
