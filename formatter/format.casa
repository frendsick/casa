# Casa autoformatter library
#
# `format_source` is the formatting pipeline shared by `casafmt` and the
# language server.
import "../lib/std.casa" as std
import "../compiler/common.casa" as common
import "../compiler/lexer.casa" as lexer
import "../compiler/syntax.casa" as syntax
import "../compiler/products.casa" as products

const MAX_LINE_WIDTH 100

pub fn make_indent depth:i64 -> std::String {
    std::String::new = builder
    0 = level
    while level depth < do
        "    " builder.append
        1 += level
    done
    builder
}

pub struct Formatter {
    pub source:        $str
    pub output:        std::String
    pub depth:         i64
    pub spans:         $std::List[syntax::SyntaxSpan]
    pub break_before:  std::List[u64]
    pub join_before:   std::List[u64]
    pub continuations: std::List[u64]
    # Offsets of `else` markers that open the body of `if condition else body fi`.
    pub early_exits:   std::List[u64]
    # Match arms whose first line spans several source lines: a wrapped
    # pattern, guard, or braced form in an expression body.
    pub wrapped_arms:  std::List[syntax::SyntaxSpan]
    # Offsets of `[` tokens that open type arguments or generic parameters.
    pub type_brackets: std::List[u64]
}

impl Formatter {
    pub fn new
        source:$str
        spans:$std::List[syntax::SyntaxSpan]
        type_brackets:std::List[u64]
    -> Formatter {
        type_brackets
        std::List[syntax::SyntaxSpan]::new
        std::List[u64]::new
        std::List[u64]::new
        std::List[u64]::new
        std::List[u64]::new
        spans
        0
        std::String::new
        source
        Formatter
    }
}

# Token classification helpers
pub fn is_eof_token token:$common::Token -> bool {
    # Eof has empty value, but so can some f-string tokens
    if
        0 token
            .value
            .as_str
            .length !=
    then
        false return
    fi
    if common::TokenKind::FstringStart token.kind == then
        false return
    fi
    if common::TokenKind::FstringEnd token.kind == then
        false return
    fi
    if common::TokenKind::FstringText token.kind == then
        false return
    fi
    if common::TokenKind::FstringExprStart token.kind == then
        false return
    fi
    if common::TokenKind::FstringExprEnd token.kind == then
        false return
    fi
    true
}

pub fn is_block_open_token token:$common::Token -> bool {
    token.kind = kind
    token.value.as_str = value: $str
    if common::TokenKind::Keyword kind == then
        if "then" value == then
            true return
        fi
        if "do" value == then
            true return
        fi
    fi
    if common::TokenKind::Delimiter kind == then
        if "{" value == then
            true return
        fi
    fi
    false
}

pub fn is_block_close_value value:$str -> bool {
    if "}" value == then
        true return
    fi
    if "fi" value == then
        true return
    fi
    if "done" value == then
        true return
    fi
    if "end" value == then
        true return
    fi
    false
}

pub fn is_dedent_keyword value:$str -> bool {
    if "else" value == then
        true return
    fi
    if "elif" value == then
        true return
    fi
    false
}

pub fn is_toplevel_definition value:$str -> bool {
    if "fn" value == then
        true return
    fi
    if "struct" value == then
        true return
    fi
    if "enum" value == then
        true return
    fi
    if "impl" value == then
        true return
    fi
    if "trait" value == then
        true return
    fi
    false
}

pub fn get_public_item_offset line:$std::List[common::Token] -> u64 {
    if 0 line.length == then
        0 return
    fi
    if
        "pub" 0 line
            .get
            .value
            .as_str ==
    then
        1
    else
        0
    fi
}

pub fn get_function_keyword_index line:$std::List[common::Token] -> std::Option[u64] {
    line get_public_item_offset = index
    if index line.length >= then
        std::Option[u64]::None return
    fi
    if
        "unsafe" index line
            .get
            .value
            .as_str ==
        "extern" index line
            .get
            .value
            .as_str == ||
    then
        1 += index
    fi
    if index line.length >= then
        std::Option[u64]::None return
    fi
    if
        "fn" index line
            .get
            .value
            .as_str ==
    then
        index std::Option::Some
    else
        std::Option[u64]::None
    fi
}

pub fn is_extern_function_line line:$std::List[common::Token] -> bool {
    line get_public_item_offset = index
    if index line.length >= then
        false return
    fi
    "extern" index line
        .get
        .value
        .as_str ==
}

pub fn does_token_start_source_line source:$str token:$common::Token -> bool {
    token
        .location
        .span
        .offset = offset
    if 0 offset == then
        true return
    fi
    offset 1 - source.at.unwrap = previous
    '\n' previous == '\r' previous == ||
}

pub fn is_toplevel_definition_line line:$std::List[common::Token] -> bool {
    if 0 line.length == then
        false return
    fi
    line get_public_item_offset = keyword_index
    if keyword_index line.length >= then
        false return
    fi
    if
        "extern" keyword_index line
            .get
            .value
            .as_str ==
    then
        1 += keyword_index
        if keyword_index line.length >= then
            false return
        fi
    fi
    if
        keyword_index line
            .get
            .value
            .as_str is_toplevel_definition
    then
        true return
    fi
    line get_function_keyword_index.is_some
}

pub fn is_generic_bracket_prev tok_kind:$common::TokenKind value:$str -> bool {
    if common::TokenKind::Intrinsic tok_kind == "size_of" value == && then
        true return
    fi
    if common::TokenKind::Identifier tok_kind == then
        if value "&" str::starts_with then
            true return
        fi
        if value "::" str::contains then
            true return
        fi
        if
            "ptr::read" value ==
            "ptr::write" value == ||
            "ptr::as_ref" value == ||
            "ptr::as_mut" value == ||
        then
            true return
        fi
        if 0 value.length != then
            0 value.at.unwrap = character
            if 'A' character <= 'Z' character >= && then
                true return
            fi
        fi
        if value.length 1 > '$' 0 value.at.unwrap == && then
            1 value.at.unwrap = borrowed_ch
            if 'A' borrowed_ch <= 'Z' borrowed_ch >= && then
                true return
            fi
        fi
        if value.length 4 > value "mut$" str::starts_with && then
            4 value.at.unwrap = borrowed_ch
            if 'A' borrowed_ch <= 'Z' borrowed_ch >= && then
                true return
            fi
        fi
        if value "array" str::ends_with then
            true return
        fi
    fi
    if value "fn" str::ends_with "impl" value == || then
        true return
    fi
    false
}

pub fn is_fstring_interior kind:$common::TokenKind -> bool {
    if common::TokenKind::FstringText kind == then
        true return
    fi
    if common::TokenKind::FstringExprStart kind == then
        true return
    fi
    if common::TokenKind::FstringExprEnd kind == then
        true return
    fi
    false
}

pub fn should_skip_space_before_tokens
    prev_kind:$common::TokenKind
    cur_val:$str
    cur_kind:$common::TokenKind
-> bool {
    if "." cur_val == then
        true return
    fi
    if "::" cur_val == then
        true return
    fi
    if ")" cur_val == then
        true return
    fi
    if "]" cur_val == then
        true return
    fi
    if ":" cur_val == then
        true return
    fi
    # No spaces inside f-string components:
    # FstringStart + interior, interior + interior, interior + FstringEnd
    if common::TokenKind::FstringStart prev_kind == then
        true return
    fi
    if prev_kind is_fstring_interior then
        true return
    fi
    if cur_kind is_fstring_interior then
        true return
    fi
    if common::TokenKind::FstringEnd cur_kind == then
        true return
    fi
    false
}

pub fn should_skip_space_after value:$str -> bool {
    if "." value == then
        true return
    fi
    if "::" value == then
        true return
    fi
    if "(" value == then
        true return
    fi
    if "[" value == then
        true return
    fi
    false
}

pub fn is_fn_param_colon line:$std::List[common::Token] colon_idx:u64 -> bool {
    if line get_function_keyword_index.is_none then
        false return
    fi
    if 0 colon_idx == then
        false return
    fi
    colon_idx 1 - = prev_idx
    if common::TokenKind::Identifier prev_idx line.get.kind != then
        false return
    fi
    true
}

pub fn token_offset token:$common::Token -> u64 {
    token
        .location
        .span
        .offset
}

pub fn offset_list_has values:$std::List[u64] wanted:u64 -> bool {
    for value in values.iter do
        if wanted value == then
            true return
        fi
    done
    false
}

pub fn offset_list_count values:$std::List[u64] wanted:u64 -> u64 {
    0 = count: u64
    for value in values.iter do
        if wanted value == then
            1 += count
        fi
    done
    count
}

pub fn add_offset_once values:mut$std::List[u64] value:u64 {
    if value values offset_list_has ! then
        value values.push
    fi
}

pub fn is_empty_brace_pair opening:$common::Token closing:$common::Token -> bool {
    common::TokenKind::Delimiter opening.kind ==
    common::TokenKind::Delimiter closing.kind == &&
    "{" opening.value == &&
    "}" closing.value == &&
}

# Whether `token` closes an empty brace pair opened by the last token of `line`.
fn closes_empty_braces token:$common::Token line:$std::List[common::Token] -> bool {
    if line.is_empty then
        false return
    fi
    token line.length 1 - line.get is_empty_brace_pair
}

# Whether the token at `index` is an identifier directly followed by a colon.
fn is_name_before_colon index:u64 line:$std::List[common::Token] -> bool {
    if common::TokenKind::Identifier index line.get.kind != then
        false return
    fi
    index 1 + = next_index
    if line.length next_index <= then
        false return
    fi
    ":" next_index line
        .get
        .value
        .as_str ==
}

fn is_span_close token:$common::Token span:$syntax::SyntaxSpan value:$str -> bool {
    value token.value.as_str ==
    token
        .location
        .span
        .offset span.close ==
    &&
}

fn find_span_close
    line:$std::List[common::Token]
    span:$syntax::SyntaxSpan
    value:$str
-> std::Option[u64] {
    0 = index: u64
    for token in line.iter do
        if value span token is_span_close then
            index std::Option::Some return
        fi
        1 += index
    done
    std::Option[u64]::None
}

fn clone_token_range
    tokens:$std::List[common::Token]
    start:u64
    stop:u64
-> std::List[common::Token] {
    std::List[common::Token]::new = range
    for index in stop start std::Range::new do
        index tokens.get.clone range.push
    done
    range
}

fn get_meaningful_tokens tokens:$std::List[common::Token] -> std::List[common::Token] {
    std::List[common::Token]::new = meaningful
    for token in tokens.iter do
        if common::TokenKind::Newline token.kind != common::TokenKind::Comment token.kind != && then
            token.clone meaningful.push
        fi
    done
    meaningful
}

impl std::List[common::Token] {
    fn to_cloned self:$std::List[common::Token] -> std::List[common::Token] {
        self.length 0 self clone_token_range
    }

    fn append_cloned self:mut$std::List[common::Token] other:$std::List[common::Token] {
        for token in other.iter do
            token.clone self.push
        done
    }
}

# An array literal and the tokens around it on its logical line.
struct DelimitedForm {
    prefix: std::List[common::Token]
    open:   common::Token
    items:  std::List[std::List[common::Token]]
    close:  common::Token
    suffix: std::List[common::Token]
}

impl DelimitedForm {
    fn split line:$std::List[common::Token] open_index:u64 close_index:u64 -> DelimitedForm {
        line.length close_index 1 + line clone_token_range
        close_index line.get.clone
        close_index open_index 1 + line clone_token_range split_delimited_items
        open_index line.get.clone
        open_index 0 line clone_token_range
        DelimitedForm
    }

    fn make_comma self:$DelimitedForm -> common::Token {
        self
            .open
            .location
            .clone common::TokenKind::Delimiter ",".to_str common::Token::new
    }

    # The canonical compact line: prefix [ item, item ] suffix.
    fn to_compact_line self:$DelimitedForm -> std::List[common::Token] {
        self.prefix.to_cloned = compact
        self.open.clone compact.push
        0 = index: u64
        for item in self.items.iter do
            item compact.append_cloned
            1 += index
            if self.items.length index > then
                self.make_comma compact.push
            fi
        done
        self.close.clone compact.push
        self.suffix compact.append_cloned
        compact
    }
}

# Whether the token at `index` begins a new struct field or enum variant.
fn starts_aggregate_item body:$std::List[common::Token] index:u64 depth:i64 is_enum:bool -> bool {
    if 0 depth != then
        false return
    fi
    index body.get = token
    if is_enum ! "pub" token.value.as_str == && then
        true return
    fi
    if common::TokenKind::Identifier token.kind != then
        false return
    fi
    is_enum body index is_name_before_colon ||
}

fn follows_pub index:u64 body:$std::List[common::Token] -> bool {
    if 0 index == then
        false return
    fi
    "pub" index 1 - body
        .get
        .value
        .as_str ==
}

# The longest struct field name, counting a `pub ` prefix toward its width.
fn get_longest_field_name_length body:$std::List[common::Token] -> u64 {
    0 = longest: u64
    0 = depth
    for index in body.length 0 std::Range::new do
        index body.get = token
        token.value.as_str = value: $str
        if "[" value == "(" value == || then
            1 += depth
        elif "]" value == ")" value == || then
            1 -= depth
        elif 0 depth == body index is_name_before_colon && then
            value.length = width
            if body index follows_pub then
                4 += width
            fi
            if longest width < then
                width = longest
            fi
        fi
    done
    longest
}

fn find_token_value line:$std::List[common::Token] value:$str -> std::Option[u64] {
    0 = index: u64
    for token in line.iter do
        if value token.value.as_str == then
            index std::Option::Some return
        fi
        1 += index
    done
    std::Option[u64]::None
}

# The word that names a declaration line, after any `pub` and `extern`.
fn get_declaration_keyword line:$std::List[common::Token] -> $str {
    line get_public_item_offset = index
    if
        "extern" index line
            .get
            .value
            .as_str ==
    then
        1 += index
    fi
    index line
        .get
        .value
        .as_str
}

fn is_declaration_keyword value:$str -> bool {
    "fn" value == "struct" value == || "enum" value == || "impl" value == || "trait" value == ||
}

# What the previous output line means for the depth and spacing of the next one.
struct PreviousLine {
    opened_block: bool
    comment:      bool
    definition:   bool
    was_import:   bool
}

impl PreviousLine {
    fn new -> PreviousLine { false false false false PreviousLine }

    fn finish_definition self:mut$PreviousLine {
        false = self.opened_block
        false = self.comment
        true = self.definition
        false = self.was_import
    }

    fn finish_canonical_line self:mut$PreviousLine is_definition:bool {
        false = self.opened_block
        false = self.comment
        is_definition = self.definition
        false = self.was_import
    }
}

pub fn tokens_need_space
    line:$std::List[common::Token]
    previous_index:u64
    next_index:u64
    type_brackets:$std::List[u64]
-> bool {
    previous_index line.get = previous
    next_index line.get = next
    previous.value.as_str = previous_value: $str
    next.value.as_str = next_value: $str
    if next previous is_empty_brace_pair then
        false return
    fi
    true = needed
    if previous_value should_skip_space_after then
        false = needed
    fi
    if next.kind next_value previous.kind should_skip_space_before_tokens then
        false = needed
    fi
    if ":" previous_value == then
        if previous_index line is_fn_param_colon then
            false = needed
        fi
        if 0 previous_index != then
            if
                ":" previous_index 1 - line
                    .get
                    .value
                    .as_str ==
            then
                false = needed
            fi
        fi
    fi
    if ":" next_value == then
        if next_index line is_fn_param_colon then
            false = needed
        fi
    fi
    if "{" previous_value == previous.kind is_fstring_interior ! && then
        true = needed
    fi
    if "}" next_value == next.kind is_fstring_interior ! && then
        true = needed
    fi
    if
        "}" previous_value ==
        "[" next_value ==
        previous.kind is_fstring_interior !
        && &&
    then
        true = needed
    fi
    if "," next_value == then
        false = needed
    fi
    if "(" next_value == previous_value "::" str::contains && then
        false = needed
    fi
    # The name rule also keeps adjacent expression brackets that the parser
    # does not record as type arguments, such as `ptr::null[1]::suffix`.
    if "[" next_value == previous_value previous.kind is_generic_bracket_prev && then
        false = needed
    fi
    if "[" next_value == next token_offset type_brackets offset_list_has && then
        false = needed
    fi
    needed
}

pub fn token_text token:$common::Token source:$str -> std::String {
    token.kind = kind
    # For literals, use original source to preserve escapes
    if common::TokenKind::Literal kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if common::TokenKind::FstringStart kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if common::TokenKind::FstringText kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if common::TokenKind::FstringEnd kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if common::TokenKind::FstringExprStart kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    if common::TokenKind::FstringExprEnd kind == then
        source token
            .location
            .span
            .offset token
            .location
            .span
            .length str::substring return
    fi
    # Normalize comments: ensure space after #
    if common::TokenKind::Comment kind == then
        token.value.as_str = comment_val: $str
        if 2 comment_val.length > then
            comment_val.to_str return
        fi
        if ' ' 1 comment_val.at.unwrap == then
            comment_val.to_str return
        fi
        if '!' 1 comment_val.at.unwrap == then
            comment_val.to_str return
        fi
        if '#' 1 comment_val.at.unwrap == then
            comment_val.to_str return
        fi
        f"# {comment_val 1 comment_val.length 1 - str::substring}" return
    fi
    token.value.clone
}

# Struct/enum field helpers
pub fn is_field_line line:$std::List[common::Token] -> bool {
    line get_public_item_offset = name_index
    if name_index 2 + line.length >= then
        false return
    fi
    if common::TokenKind::Identifier name_index line.get.kind != then
        false return
    fi
    if
        ":" name_index 1 + line
            .get
            .value
            .as_str !=
    then
        false return
    fi
    true
}

# Definition body shape: eligible for an inline body only when it has at most
# one nonblank composition line and no comment or nested block. `body` holds the
# tokens strictly between the definition braces, including newlines.
pub fn body_shape_inlineable body:$std::List[common::Token] -> bool {
    0 = index: u64
    0 = tokens_on_line
    0 = nonblank_lines
    while index body.length < do
        index body.get = token
        if common::TokenKind::Newline token.kind == then
            if 0 tokens_on_line != then
                1 += nonblank_lines
            fi
            0 = tokens_on_line
        elif common::TokenKind::Comment token.kind == then
            false return
        elif token is_block_open_token then
            false return
        elif common::TokenKind::Keyword token.kind == "match" token.value.as_str == && then
            false return
        else
            1 += tokens_on_line
        fi
        1 += index
    done
    if 0 tokens_on_line != then
        1 += nonblank_lines
    fi
    # Eligible with zero (empty body) or one nonblank composition line.
    2 nonblank_lines >
}

# Delimited-form helpers
# True when the logical line carries a block or control token, in which case the
# delimited-form canonicalizer defers to the ordinary line path (it does not own
# lambdas or control flow that ride along with a delimited form).
pub fn line_has_block_or_control line:$std::List[common::Token] -> bool {
    for token in line.iter do
        token.value.as_str = spelling: $str
        if "{" spelling == "}" spelling == || then
            true return
        fi
        if "=>" spelling == then
            true return
        fi
        if token is_block_open_token then
            true return
        fi
        if spelling is_block_close_value then
            true return
        fi
        if spelling is_dedent_keyword then
            true return
        fi
        if common::TokenKind::Keyword token.kind == "match" spelling == && then
            true return
        fi
    done
    false
}

# Split the tokens strictly between a delimited form's `[` and `]` into items.
# The syntax parser requires commas between items. Only commas at depth 0
# separate items, leaving nested forms and qualified names intact.
pub fn split_delimited_items
    inner:$std::List[common::Token]
-> std::List[std::List[common::Token]] {
    std::List[std::List[common::Token]]::new = items
    std::List[common::Token]::new = current
    0 = depth
    for token in inner.iter do
        token.value.as_str = spelling: $str
        "[" spelling == "(" spelling == || "{" spelling == || = is_open
        "]" spelling == ")" spelling == || "}" spelling == || = is_close
        if depth 0 == "," spelling == && then
            if 0 current.length != then
                current items.push
                std::List[common::Token]::new = current
            fi
        else
            token.clone current.push
            if is_open then
                1 += depth
            fi
            if is_close then
                1 -= depth
            fi
        fi
    done
    if 0 current.length != then
        current items.push
    fi
    items
}

# Structural line rules
impl Formatter {
    pub fn token_index_at
        self:$Formatter
        tokens:$std::List[common::Token]
        offset:u64
    -> std::Option[u64] {
        { token_offset offset >= } tokens.bisect = low
        while low tokens.length < do
            low tokens.get = token
            if offset token token_offset != then
                break
            fi
            if common::TokenKind::Newline token.kind != then
                low std::Option::Some return
            fi
            1 += low
        done
        std::Option[u64]::None
    }

    pub fn next_token_index
        self:$Formatter
        tokens:$std::List[common::Token]
        index:u64
        limit:u64
    -> std::Option[u64] {
        index 1 + = next
        while next limit < do
            if common::TokenKind::Newline next tokens.get.kind != then
                next std::Option::Some return
            fi
            1 += next
        done
        std::Option[u64]::None
    }

    pub fn inside_nested_form self:$Formatter parent:$syntax::SyntaxSpan offset:u64 -> bool {
        for span in self.spans.iter do
            syntax::SyntaxSpanKind::ControlForm span.kind ==
            syntax::SyntaxSpanKind::MatchForm span.kind == ||
            = structural
            if
                structural
                span.start parent.start >
                parent.close span.close >
                span.start offset <=
                offset span.close <=
                && && && &&
            then
                true return
            fi
        done
        false
    }

    pub fn add_break self:mut$Formatter token:$common::Token {
        token token_offset self.break_before add_offset_once
    }

