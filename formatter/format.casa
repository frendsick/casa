    pub fn build_control_rules
        self:mut$Formatter
        tokens:$std::List[common::Token]
        form:$syntax::SyntaxSpan
    {
        form.start tokens self.token_index_at = start_opt
        form.close tokens self.token_index_at = close_opt
        if start_opt.is_none close_opt.is_none || then
            return
        fi
        start_opt.unwrap = start_index
        close_opt.unwrap = close_index
        # An early-exit body always ends the path, so the form is never a value.
        if close_index start_index form tokens self.find_early_exit std::Option::Some(marker) is then
            marker self.early_exits.push
        elif close_index start_index tokens self.control_is_inline_value then
            return
        fi

        start_index tokens.get self.add_break

        start_index = header_start
        start_index 1 + = index
        while index close_index < do
            index tokens.get = token
            if
                common::TokenKind::Newline token.kind !=
                token token_offset form self.inside_nested_form !
                &&
            then
                header_start close_index index token form tokens self.apply_control_marker = header_start
            fi
