# Buffered I/O for stdin/stdout
#
# Provides a buffered reader for stdin and a writer for stdout,
# used by the language server for JSON-RPC communication.
import "std"

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
const IO_BUFFER_SIZE 4096
const STDIN_FD 0
const STDOUT_FD 1

# ---------------------------------------------------------------------------
# StdinReader
# ---------------------------------------------------------------------------

struct StdinReader {
    buffer:   ptr
    size:     u64
    pos:      u64
    capacity: u64
}

impl StdinReader {
    fn new -> StdinReader {
        unsafe { IO_BUFFER_SIZE alloc = buffer }
        IO_BUFFER_SIZE 0 0 buffer StdinReader
    }
}

fn stdin_fill reader:mut$StdinReader {
    # read(fd=0, buf, capacity) = syscall 0
    unsafe { reader StdinReader::capacity reader StdinReader::buffer(ptr) STDIN_FD 0 syscall3 = bytes_read }
    if 0 bytes_read > then
        # Got data
        unsafe { bytes_read (u64) reader (ptr) 8 + store64 }
    else
        # EOF or error
        unsafe { 0 reader (ptr) 8 + store64 }
    fi
    unsafe { 0 reader (ptr) 16 + store64 }
}

fn stdin_read_byte reader:mut$StdinReader -> i64 {
    # Check if buffer has data (pos < size means data available)
    if reader StdinReader::size reader StdinReader::pos < ! then
        # Buffer exhausted (pos >= size), refill
        reader stdin_fill
        if reader StdinReader::size 0 >= then
            0 1 -
            return
        fi
    fi
    unsafe { reader StdinReader::buffer reader StdinReader::pos + load8 = byte_value }
    # Advance pos
    unsafe { reader StdinReader::pos 1 + reader (ptr) 16 + store64 }
    byte_value (i64)
}

fn stdin_read_line reader:mut$StdinReader -> String {
    String::new = line_builder
    while true do
        reader stdin_read_byte = line_byte
        if 0 line_byte < then
            break
        fi
        if '\n'.codepoint i64::from line_byte == then
            break
        fi
        # SAFETY: The JSON-RPC transport supplies UTF-8 text and this copies one protocol byte.
        unsafe { line_byte (u8) line_builder.push_byte_unchecked }
    done
    line_builder = line_string
    # Strip trailing \r if present
    if 0 line_string.length != then
        if '\r' line_string.length 1 - line_string.at == then
            line_string.as_str 0 line_string.length 1 - str::substring = line_string
        fi
    fi
    line_string
}

fn stdin_read_exact reader:mut$StdinReader count:u64 -> String {
    count String::with_capacity = read_buffer
    0 (u64) = read_index
    while read_index count > do
        reader stdin_read_byte = current_byte
        if 0 current_byte < then
            read_buffer return
        fi
        # SAFETY: The JSON-RPC transport supplies UTF-8 text and this copies one protocol byte.
        unsafe { current_byte (u8) read_buffer.push_byte_unchecked }
        1 += read_index
    done
    read_buffer
}

fn stdout_write text:str {
    # SAFETY: The text view contains `length` readable bytes after its header.
    unsafe { text.length text (ptr) 8 + STDOUT_FD 1 syscall3 drop }
}
