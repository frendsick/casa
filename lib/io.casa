# Buffered I/O for stdin/stdout
#
# Provides a buffered reader for stdin and a writer for stdout,
# used by the language server for JSON-RPC communication.
import "std" as std

# Constants
pub const IO_BUFFER_SIZE 4096
pub const STDIN_FD 0
pub const STDOUT_FD 1
const SYS_READ 0
const SYS_WRITE 1

pub struct StdinReader {
    storage:  std::RawBuffer
    size:     u64
    pos:      u64
    capacity: u64
}

impl StdinReader {
    pub fn buffer self:$StdinReader -> $std::RawBuffer { self.storage }

    pub fn has_buffered_input self:$StdinReader -> bool { self.size self.pos > }

    pub fn new -> StdinReader {
        IO_BUFFER_SIZE std::RawBuffer::new = buffer
        IO_BUFFER_SIZE 0 0 buffer StdinReader
    }

    fn fill self:mut$StdinReader {
        # SAFETY: self.storage.data points to self.capacity writable bytes.
        unsafe { self.capacity self.storage.data STDIN_FD SYS_READ syscall3 = bytes_read }
        if 0 bytes_read < then
            bytes_read u64::try_from.unwrap = self.size
        else
            0 = self.size: u64
        fi
        0 = self.pos: u64
    }

    pub fn read_byte self:mut$StdinReader -> std::Option[u8] {
        # Check if buffer has data (pos < size means data available)
        if self.size self.pos <= then
            # Buffer exhausted (pos >= size), refill
            self.fill
            if 0 self.size == then
                std::Option[u8]::None return
            fi
        fi
        # SAFETY: pos < size ensures the byte at pos is within the initialized buffer region.
        unsafe { self.storage.data self.pos + load8 = byte_value }
        1 += self.pos
        byte_value std::Option::Some
    }

    pub fn read_line self:mut$StdinReader -> std::Bytes {
        std::Bytes::new = line
        while true do
            if self.read_byte std::Option::Some(line_byte) is else
                break
            fi
            if '\n'.codepoint line_byte u32::from == then
                break
            fi
            line_byte line.push
        done
        line
    }

    pub fn read_exact self:mut$StdinReader count:u64 -> std::Bytes {
        std::Bytes::new = read_buffer
        0 = read_index: u64
        while read_index count < do
            if self.read_byte std::Option::Some(current_byte) is else
                read_buffer return
            fi
            current_byte read_buffer.push
            1 += read_index
        done
        read_buffer
    }
}

pub fn stdout_write text:str {
    # SAFETY: The text view contains `length` readable bytes after its header.
    unsafe { text.length text ptr::from_ref 8 + STDOUT_FD SYS_WRITE syscall3 drop }
}

pub fn stdout_write_bytes bytes:$std::Bytes {
    1 std::RawBuffer::new = buffer
    for byte in bytes.iter do
        # SAFETY: buffer owns one writable byte for this syscall.
        unsafe {
            byte buffer.data store8
            1 buffer.data STDOUT_FD SYS_WRITE syscall3 drop
        }
    done
}
