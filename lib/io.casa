# Buffered I/O for stdin/stdout
#
# Provides a buffered reader for stdin and a writer for stdout,
# used by the language server for JSON-RPC communication.
import "std" as std

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
pub const IO_BUFFER_SIZE 4096
pub const STDIN_FD 0
pub const STDOUT_FD 1

# ---------------------------------------------------------------------------
# StdinReader
# ---------------------------------------------------------------------------

pub struct StdinReader {
    pub buffer:   std::RawBuffer
    pub size:     u64
    pub pos:      u64
    pub capacity: u64
}

impl StdinReader {
    pub fn new -> StdinReader {
        IO_BUFFER_SIZE std::RawBuffer::new = buffer
        IO_BUFFER_SIZE 0 0 buffer StdinReader
    }
}

pub fn stdin_fill reader:mut$StdinReader {
    # SAFETY: reader.buffer.data points to reader.capacity writable bytes.
    unsafe { reader.capacity reader.buffer.data STDIN_FD 0 syscall3 = bytes_read }
    if 0 bytes_read > then
        bytes_read u64::try_from.unwrap = reader.size
    else
        0 = reader.size: u64
    fi
    0 = reader.pos: u64
}

pub fn stdin_read_byte reader:mut$StdinReader -> i64 {
    # Check if buffer has data (pos < size means data available)
    if reader StdinReader::size reader StdinReader::pos < ! then
        # Buffer exhausted (pos >= size), refill
        reader stdin_fill
        if reader StdinReader::size 0 >= then
            0 1 -
            return
        fi
    fi
    # SAFETY: pos < size ensures the byte at pos is within the initialized buffer region.
    unsafe { reader.buffer.data reader.pos + load8 = byte_value }
    reader.pos 1 + = reader.pos
    byte_value i64::try_from.unwrap
}

pub fn stdin_read_line reader:mut$StdinReader -> std::Bytes {
    std::Bytes::new = line
    while true do
        reader stdin_read_byte = line_byte
        if 0 line_byte < then
            break
        fi
        if '\n'.codepoint i64::from line_byte == then
            break
        fi
        line_byte u8::try_from.unwrap line.push
    done
    line
}

pub fn stdin_read_exact reader:mut$StdinReader count:u64 -> std::Bytes {
    std::Bytes::new = read_buffer
    0 = read_index: u64
    while read_index count > do
        reader stdin_read_byte = current_byte
        if 0 current_byte < then
            read_buffer return
        fi
        current_byte u8::try_from.unwrap read_buffer.push
        1 += read_index
    done
    read_buffer
}

pub fn stdout_write text:str {
    # SAFETY: The text view contains `length` readable bytes after its header.
    unsafe { text.length text ptr::from_ref 8 + STDOUT_FD 1 syscall3 drop }
}

pub fn stdout_write_bytes bytes:$std::Bytes {
    1 std::RawBuffer::new = buffer
    for byte in bytes.iter do
        # SAFETY: buffer owns one writable byte for this syscall.
        unsafe {
            byte buffer.data store8
            1 buffer.data STDOUT_FD 1 syscall3 drop
        }
    done
}
