# Curated raylib bindings for Linux x86-64, tested with raylib 6.0.
# Link raylib and its platform libraries. See examples/README.md.
import "std"

const MAX_RGBA_PIXELS 536870911
const PIXELFORMAT_UNCOMPRESSED_R8G8B8A8 7
const FLAG_WINDOW_RESIZABLE 4
pub const MOUSE_BUTTON_LEFT 0
pub const MOUSE_BUTTON_RIGHT 1

pub extern struct Color derives std::Copy {
    pub r: u8
    pub g: u8
    pub b: u8
    pub a: u8
}

pub extern struct Vector2 derives std::Copy {
    pub x: f32
    pub y: f32
}

extern struct NativeImage derives std::Copy {
    data:    ptr
    width:   i32
    height:  i32
    mipmaps: i32
    format:  i32
}

extern struct NativeTexture derives std::Copy {
    id:      u32
    width:   i32
    height:  i32
    mipmaps: i32
    format:  i32
}

extern fn InitWindow width:i32 height:i32 title:$cstr

extern fn CloseWindow

extern fn WindowShouldClose -> bool

extern fn SetTargetFPS fps:i32

extern fn BeginDrawing

extern fn EndDrawing

extern fn ClearBackground color:Color

extern fn GetMousePosition -> Vector2

extern fn ImageCopy image:NativeImage -> NativeImage

extern fn LoadTextureFromImage image:NativeImage -> NativeTexture

extern fn UnloadImage image:NativeImage

extern fn UnloadTexture texture:NativeTexture

extern fn DrawTextureV texture:NativeTexture position:Vector2 tint:Color

extern fn SetWindowState flags:u32

extern fn IsWindowMinimized -> bool

extern fn GetScreenWidth -> i32

extern fn GetScreenHeight -> i32

extern fn IsMouseButtonDown button:i32 -> bool

extern fn GetRandomValue minimum:i32 maximum:i32 -> i32

extern fn ImageClearBackground image:ptr color:Color

extern fn ImageDrawPixel image:ptr x:i32 y:i32 color:Color

extern fn UpdateTexture texture:NativeTexture pixels:ptr

extern fn DrawTextureEx texture:NativeTexture position:Vector2 rotation:f32 scale:f32 tint:Color

extern fn IsWindowReady -> bool

extern fn IsImageValid image:NativeImage -> bool

extern fn IsTextureValid texture:NativeTexture -> bool

pub struct Window {
    context: Context
    drawing: Drawing
}

pub struct Context {
    ready: bool
}

pub struct Drawing {
    active: bool
}

pub struct Image {
    native: NativeImage
}

pub struct Texture {
    context: $Context
    native:  NativeTexture
}

# A frame retains one texture through EndDrawing. Extend the retained resource
# set if a later example needs to draw several textures in the same frame.
pub struct Frame {
    drawing: mut$Drawing
    texture: $Texture
}

impl Window {
    pub fn new width:i32 height:i32 title:$cstr -> std::Option[Window] {
        if 0 width >= 0 height >= || then
            std::Option::None return
        fi
        # SAFETY: The module owns raylib's single window. No callbacks or threads
        # can race the readiness check through this API. The title lives for the call.
        unsafe {
            if IsWindowReady then
                std::Option::None return
            fi
            # Raylib retains its previous title pointer for empty input. Always
            # supply a nonempty title so reopening cannot reuse freed storage.
            if 0 title ptr::from_ref load8 == then
                "Casa".as_cstr.unwrap height width InitWindow
            else
                title height width InitWindow
            fi
            if IsWindowReady ! then
                std::Option::None return
            fi
        }
        Window { context: Context { ready: true } drawing: Drawing { active: false } }
        std::Option::Some
    }

    # Both capabilities keep the complete window loaned. Separating them lets
    # textures retain shared context access while frames borrow drawing exclusively.
    pub fn split self:mut$Window -> $Context mut$Drawing {
        self.context
        self.drawing
    }
}

impl Context {
    pub fn set_resizable self:$Context {
        # SAFETY: The context keeps the window open.
        unsafe { FLAG_WINDOW_RESIZABLE SetWindowState }
    }

    pub fn is_minimized self:$Context -> bool {
        # SAFETY: The context keeps the window open.
        unsafe { IsWindowMinimized }
    }

    pub fn screen_width self:$Context -> i32 {
        # SAFETY: The context keeps the window open.
        unsafe { GetScreenWidth }
    }

    pub fn screen_height self:$Context -> i32 {
        # SAFETY: The context keeps the window open.
        unsafe { GetScreenHeight }
    }

    pub fn mouse_button_down self:$Context button:i32 -> bool {
        # SAFETY: Raylib bounds-checks button indices. The context keeps input live.
        unsafe { button IsMouseButtonDown }
    }

    pub fn random_byte self:$Context -> u8 {
        # SAFETY: These inclusive bounds fit raylib's signed integer arithmetic.
        unsafe { 255 0 GetRandomValue } u8::try_from.unwrap
    }

    pub fn should_close self:$Context -> bool {
        # SAFETY: Only a live Window can lend this context.
        unsafe { WindowShouldClose }
    }

    pub fn set_target_fps self:$Context fps:i32 {
        # SAFETY: The context keeps the window open. Nonpositive FPS disables the limit.
        unsafe { fps SetTargetFPS }
    }

    pub fn mouse_position self:$Context -> Vector2 {
        # SAFETY: The context keeps the window and its input state live.
        unsafe { GetMousePosition }
    }

    fn drop self:mut$Context {
        # SAFETY: Window owns this context exactly once. All textures and drawing
        # capabilities must be released before the window can be destroyed.
        unsafe { CloseWindow }
    }
}

impl Image {
    pub fn new width:i32 height:i32 color:Color -> std::Option[Image] {
        if 0 width >= 0 height >= || then
            std::Option::None return
        fi
        # Raylib computes RGBA byte counts with signed C int arithmetic.
        if MAX_RGBA_PIXELS width i64::from height i64::from * < then
            std::Option::None return
        fi
        width u64::try_from.unwrap height u64::try_from.unwrap * = pixel_count
        pixel_count size_of[Color] * std::RawBuffer::new = pixels
        0 = index: u64
        while pixel_count index > do
            # SAFETY: Each C-layout Color initializes one disjoint pixel inside
            # the buffer. Color is Copy and has no owned storage to destroy.
            unsafe { color pixels.data index size_of[Color] * + ptr::write[Color] }
            1 += index
        done
        NativeImage {
            data: pixels.data
            width: width
            height: height
            mipmaps: 1
            format: PIXELFORMAT_UNCOMPRESSED_R8G8B8A8
        } = source
        # GenImageColor in raylib 6.0 writes through an unchecked allocation.
        # ImageCopy checks allocation failure. Keep this temporary buffer until
        # raylib provides a checked generator that can replace the extra copy.
        # SAFETY: The initialized RGBA buffer stays live through ImageCopy. Its
        # byte count fits C int. The returned allocation belongs to raylib.
        unsafe {
            source ImageCopy = native
            if native IsImageValid then
                native Image std::Option::Some
            else
                native UnloadImage
                std::Option::None
            fi
        }
    }

    pub fn clear self:mut$Image color:Color {
        # SAFETY: This exclusive owner contains a valid RGBA image.
        unsafe { color self.native ptr::from_ref ImageClearBackground }
    }

    pub fn set_pixel self:mut$Image x:i32 y:i32 color:Color -> bool {
        if 0 x > 0 y > || self.native.width x <= || self.native.height y <= || then
            false return
        fi
        # SAFETY: Coordinates are in bounds and the image is exclusively borrowed.
        unsafe { color y x self.native ptr::from_ref ImageDrawPixel }
        true
    }

    fn drop self:mut$Image {
        # SAFETY: The private handle belongs to this owner and is released once.
        unsafe { self.native.clone UnloadImage }
    }
}

impl Texture {
    # Return the image with the upload result so callers can edit it again.
    # Taking ownership avoids tying the texture to an opaque shared image loan.
    pub fn new image:Image context:$Context -> Image std::Option[Texture] {
        # SAFETY: Upload copies the pixels from a valid image into GPU storage.
        unsafe { image.native.clone LoadTextureFromImage = native }
        image
        # SAFETY: The returned handle belongs to this call. Context stays live.
        unsafe {
            if native IsTextureValid then
                Texture { context: context native: native } std::Option::Some
            else
                native UnloadTexture
                std::Option::None
            fi
        }
    }

    pub fn update_from self:mut$Texture image:$Image -> bool {
        if
            self.native.width image.native.width !=
            self.native.height image.native.height != ||
            self.native.format image.native.format != ||
        then
            false return
        fi
        # SAFETY: Both resources are valid with matching dimensions and format.
        # The exclusive texture borrow prevents updates while a Frame retains it.
        unsafe { image.native.data self.native.clone UpdateTexture }
        true
    }

    fn drop self:mut$Texture {
        # SAFETY: This unique owner retains its context borrow through cleanup.
        unsafe { self.native.clone UnloadTexture }
    }
}

impl Drawing {
    pub fn begin self:mut$Drawing texture:$Texture -> Frame {
        # SAFETY: The exclusive capability permits one frame at a time and keeps
        # the window live. Frame cleanup pairs this call with EndDrawing.
        unsafe { BeginDrawing }
        true = self.active
        Frame { drawing: self texture: texture }
    }
}

impl Frame {
    pub fn clear self:mut$Frame color:Color {
        # SAFETY: This guard represents the active drawing frame.
        unsafe { color ClearBackground }
    }

    pub fn draw_texture self:mut$Frame position:Vector2 tint:Color {
        self
            .texture
            .native
            .clone = native
        # SAFETY: The frame is active and the texture retains the only window's
        # context. All aggregate declarations match raylib's C layout.
        unsafe { tint position native DrawTextureV }
    }

    pub fn draw_texture_scaled self:mut$Frame position:Vector2 scale:f32 tint:Color {
        self
            .texture
            .native
            .clone = native
        # SAFETY: The active frame retains its texture until EndDrawing.
        unsafe { tint scale 0.0 position native DrawTextureEx }
    }

    fn drop self:mut$Frame {
        # SAFETY: This guard exclusively owns the active frame until this call.
        unsafe { EndDrawing }
        false = self.drawing.active
    }
}
