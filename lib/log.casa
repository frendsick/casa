# Logging library for Casa programs.
#
# Provides leveled logging to stderr with a configurable global log level.
# Messages above the current level (more verbose) are suppressed.
#
# Usage:
#   import "../lib/log.casa"
#   LogLevel::Info log_set_level
#   "starting up" log_info
#   "something odd" log_warning
import "std" as std

# ---------------------------------------------------------------------------
# Log levels (higher ordinal = more verbose)
# ---------------------------------------------------------------------------

pub enum LogLevel derives std::Ord std::Copy {
    Error
    Warning
    Info
    Debug
}

# ---------------------------------------------------------------------------
# Global state
# ---------------------------------------------------------------------------
LogLevel::Warning = LOG_LEVEL

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

pub fn log_set_level level:LogLevel {
    global LOG_LEVEL
    level = LOG_LEVEL
}

# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------

pub fn log_level_to_str level:$LogLevel -> str {
    level match
        LogLevel::Error => "ERROR"
        LogLevel::Warning => "WARNING"
        LogLevel::Info => "INFO"
        LogLevel::Debug => "DEBUG"
    end
}

pub fn log_print level:LogLevel message:$str {
    level log_level_to_str = level_str
    if level (i64) LOG_LEVEL (i64) >= then
        f"[{level_str}] {message}" std::eprintln_string
    fi
}

# ---------------------------------------------------------------------------
# Logging functions
# ---------------------------------------------------------------------------

pub fn log_error message:str { message LogLevel::Error log_print }

pub fn log_warning message:str { message LogLevel::Warning log_print }

pub fn log_info message:str { message LogLevel::Info log_print }

pub fn log_info_string message:std::String { message.as_str LogLevel::Info log_print }

pub fn log_debug message:str { message LogLevel::Debug log_print }
