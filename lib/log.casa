# Logging library for Casa programs.
#
# Provides leveled logging to stderr with an explicit log level.
# Messages above the current level (more verbose) are suppressed.
#
# Usage:
#   import "log"
#   log::Logger::new = logger
#   log::LogLevel::Info logger.configure
#   "starting up" logger.info
#   "something odd" logger.warning
import "std" as std

# Log levels (higher ordinal = more verbose)
pub enum LogLevel derives std::Ord std::Copy {
    Error
    Warning
    Info
    Debug
}

impl LogLevel {
    pub fn label self:$LogLevel -> str {
        self match
            LogLevel::Error => "ERROR"
            LogLevel::Warning => "WARNING"
            LogLevel::Info => "INFO"
            LogLevel::Debug => "DEBUG"
        end
    }
}

# Configuration
pub struct Logger {
    level: LogLevel
}

impl Logger {
    pub fn new -> Logger { LogLevel::Warning Logger }

    pub fn configure self:mut$Logger level:LogLevel { level = self.level }

    fn write self:$Logger level:LogLevel message:$str {
        level.label = level_label
        if self.level level >= then
            f"[{level_label}] {message}" std::eprintln_string
        fi
    }

    pub fn error self:$Logger message:str { message LogLevel::Error self.write }

    pub fn warning self:$Logger message:str { message LogLevel::Warning self.write }

    pub fn info self:$Logger message:str { message LogLevel::Info self.write }

    pub fn info_string self:$Logger message:std::String { message.as_str LogLevel::Info self.write }

    pub fn debug self:$Logger message:str { message LogLevel::Debug self.write }
}
