# Logging library for Casa programs.
#
# Provides leveled logging to stderr with an explicit log level.
# Messages above the current level (more verbose) are suppressed.
#
# Usage:
#   import "../lib/log.casa"
#   Logger::new = logger
#   LogLevel::Info logger.configure
#   logger "starting up" log_info
#   logger "something odd" log_warning
import "std" as std

# ---------------------------------------------------------------------------
# Log levels (higher ordinal = more verbose)
# ---------------------------------------------------------------------------

pub enum LogLevel derives std::Ord std::Copy {
    Error
    Warning
    Info
    Debug
}

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

pub struct Logger {
    level: LogLevel
}

impl Logger {
    pub fn new -> Logger { LogLevel::Warning Logger }

    pub fn configure self:mut$Logger level:LogLevel { level = self.level }
}

# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------

pub fn log_level_to_str level:$LogLevel -> str {
    level match
        LogLevel::Error => "ERROR"
        LogLevel::Warning => "WARNING"
        LogLevel::Info => "INFO"
        LogLevel::Debug => "DEBUG"
    end
}

pub fn log_print message:$str level:LogLevel logger:$Logger {
    level log_level_to_str = level_str
    if level logger.level >= then
        f"[{level_str}] {message}" std::eprintln_string
    fi
}

# ---------------------------------------------------------------------------
# Logging functions
# ---------------------------------------------------------------------------

pub fn log_error message:str logger:$Logger { logger LogLevel::Error message log_print }

pub fn log_warning message:str logger:$Logger { logger LogLevel::Warning message log_print }

pub fn log_info message:str logger:$Logger { logger LogLevel::Info message log_print }

pub fn log_info_string message:std::String logger:$Logger {
    logger LogLevel::Info message.as_str log_print
}

pub fn log_debug message:str logger:$Logger { logger LogLevel::Debug message log_print }
