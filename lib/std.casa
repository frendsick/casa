# ---------------------------------------------------------------------------
# Character classification
# ---------------------------------------------------------------------------

impl char {
    fn from_codepoint codepoint:u32 -> Option[char] {
        if
        1114111 codepoint <=
        55296 codepoint >= 57343 codepoint <= && ! &&
        then
            unsafe { codepoint char::from_codepoint_unchecked } Option::Some
        else
            Option[char]::None
        fi
    }

    fn is_digit c:char -> bool { '0' c >= '9' c <= && }

    fn is_upper c:char -> bool { 'A' c >= 'Z' c <= && }

    fn is_lower c:char -> bool { 'a' c >= 'z' c <= && }

    fn is_alpha c:char -> bool { c.is_upper c.is_lower || }

    fn is_space c:char -> bool { c ' ' == c '\t' == || c '\n' == || c '\r' == || }

    fn eq self:$char other:$char -> bool { self other == }
    fn lt self:$char other:$char -> bool { other self < }
}

impl ptr {
    fn to_str p:$ptr -> str {
        unsafe { p (i64).to_str }
    }

    fn eq self:$ptr other:$ptr -> bool { self other == }
}

# ---------------------------------------------------------------------------
# Option and Result enums
# ---------------------------------------------------------------------------
# None=0, Some=1 so is_some checks ordinal==1

enum Option[T] {
    None
    Some (T)
}

# Error=0, Ok=1 so is_ok checks ordinal==1

enum Result[T E] {
    Error (E)
    Ok (T)
}

impl Option {
    fn is_ok [T] self:$Option[T] -> bool {
        unsafe { self (ptr) load64 1 == }
    }
    fn is_some [T] self:$Option[T] -> bool {
        unsafe { self (ptr) load64 1 == }
    }
    fn is_none [T] self:$Option[T] -> bool {
        unsafe { self (ptr) load64 0 == }
    }
    fn unwrap [T] self:mut$Option[T] -> T {
        if self.is_none then
            "error: called unwrap on None\n" print
            60 exit
        fi
        unsafe { self (ptr) 8 + load64 (T) }
    }
    fn propagate [T U] self:mut$Option[T] -> Option[U] { Option[U]::None }
    fn unwrap_or [T] self:mut$Option[T] default:T -> T {
        if self.is_some then
            self.unwrap
        else
            default
        fi
    }
    fn map [T U] self:mut$Option[T] f:fn[T -> U] -> Option[U] {
        if self.is_some then
            self.unwrap f exec Option::Some
        else
            Option[U]::None
        fi
    }
    fn and_then [T U] self:mut$Option[T] f:fn[T -> Option[U]] -> Option[U] {
        if self.is_some then
            self.unwrap f exec
        else
            Option[U]::None
        fi
    }
    fn or_else [T] self:mut$Option[T] f:fn[-> Option[T]] -> Option[T] {
        if self.is_some then
            self
        else
            f exec
        fi
    }
    fn filter [T] self:mut$Option[T] f:fn[$T -> bool] -> Option[T] {
        if self.is_none then
            Option[T]::None return
        fi
        self.unwrap = val
        if val f exec then
            val Option::Some
        else
            Option[T]::None
        fi
    }
}

impl Result {
    fn is_ok [T E] self:$Result[T E] -> bool {
        unsafe { self (ptr) load64 1 == }
    }
    fn is_error [T E] self:$Result[T E] -> bool {
        unsafe { self (ptr) load64 0 == }
    }
    fn unwrap [T E] self:mut$Result[T E] -> T {
        if self.is_error then
            "error: called unwrap on error\n" print
            60 exit
        fi
        unsafe { self (ptr) 8 + load64 (T) }
    }
    fn unwrap_error [T E] self:mut$Result[T E] -> E {
        if self.is_ok then
            "error: called unwrap_error on ok\n" print
            60 exit
        fi
        unsafe { self (ptr) 8 + load64 (E) }
    }
    fn propagate [T U E] self:mut$Result[T E] -> Result[U E] { self.unwrap_error Result::Error }
    fn unwrap_or [T E] self:mut$Result[T E] default:T -> T {
        if self.is_ok then
            self.unwrap
        else
            default
        fi
    }
    fn map [T U E] self:mut$Result[T E] f:fn[T -> U] -> Result[U E] {
        if self.is_ok then
            self.unwrap f exec Result::Ok
        else
            self.unwrap_error Result::Error
        fi
    }
    fn map_error [T E F] self:mut$Result[T E] f:fn[E -> F] -> Result[T F] {
        if self.is_ok then
            self.unwrap Result::Ok
        else
            self.unwrap_error f exec Result::Error
        fi
    }
    fn and_then [T U E] self:mut$Result[T E] f:fn[T -> Result[U E]] -> Result[U E] {
        if self.is_ok then
            self.unwrap f exec
        else
            self.unwrap_error Result::Error
        fi
    }
    fn or_else [T E F] self:mut$Result[T E] f:fn[E -> Result[T F]] -> Result[T F] {
        if self.is_ok then
            self.unwrap Result::Ok
        else
            self.unwrap_error f exec
        fi
    }
}

# ---------------------------------------------------------------------------
# Traits
# ---------------------------------------------------------------------------

trait Clone {
    fn clone self:$self -> self
}

trait Copy: Clone { }

trait Eq {
    fn eq self:$self other:$self -> bool

    fn ne self:$self other:$self -> bool { other self.eq ! }
}

trait Ord {
    fn lt self:$self other:$self -> bool

    fn le self:$self other:$self -> bool { self other.lt ! }

    fn gt self:$self other:$self -> bool { self other.lt }

    fn ge self:$self other:$self -> bool { other self.lt ! }
}

trait Word { }

trait Hashable: Eq + Word {
    fn hash self:$self -> i64
}

trait Display: Word {
    fn to_str self:$self -> str
}

