    pub fn set self:mut$Map[K V] key:K value:V {
        size_of[K] = key_size
        size_of[V] = value_size
        key_size value_size + = next_offset
        key K::hash(u64) self.capacity % = bucket_index
        # SAFETY: Entry sizes define disjoint key, value, and link fields in every node.
        unsafe {
            self.buckets bucket_index 8 * + load64 = current_entry
