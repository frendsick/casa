# ---------------------------------------------------------------------------
# Hash helpers
# ---------------------------------------------------------------------------

fn str_hash s:$str -> i64 {
    5381 = hash
    for sh_char in s.iter do
        hash 5 << = shifted
        shifted hash.wrapping_add = hash
        sh_char.codepoint i64::from hash.wrapping_add = hash
    done
    if 0 hash < then
        hash 0.wrapping_sub = hash
        if 0 hash < then 0 = hash fi
    fi
    hash
}

fn int_hash n:i64 -> i64 {
    if 0 n < then
        n 0.wrapping_sub = absolute
        if 0 absolute < then 0 else absolute fi
    else n fi
    }

    impl str: Hashable + Display {
        fn hash self:$str -> i64 { self str_hash }
    }

    impl i64: Hashable + Ord + Display {
        fn hash self:$i64 -> i64 { self int_hash }
        fn eq self:$i64 other:$i64 -> bool { self other == }
        fn lt self:$i64 other:$i64 -> bool { other self < }
    }

    # ---------------------------------------------------------------------------
    # Map[K V] - Hash map with separate chaining
    # ---------------------------------------------------------------------------
    # Entry layout: 24 bytes per entry (key:8, value:8, next:8)
    # Bucket array: capacity * 8 bytes (each slot is a ptr to entry or 0)
    const MAP_INITIAL_CAP 16

    struct Map {
        buckets:  ptr
        size:     u64
        capacity: u64
    }

    impl[K: Hashable, V] Map[K V] {
        fn new -> Map[K V] {
            unsafe { MAP_INITIAL_CAP (u64) 8 * alloc = mb }
            0 (u64) = bucket_index
            while bucket_index MAP_INITIAL_CAP > do
                unsafe { 0 mb bucket_index 8 * + store64 }
                1 += bucket_index
            done
            MAP_INITIAL_CAP 0 mb Map (Map[K V])
        }

        fn length self:$Map[K V] -> u64 { self.size }

        fn get self:$Map[K V] key:$K -> Option[V] {
            key K::hash(u64) self.capacity % = bucket_index
            unsafe { self.buckets bucket_index 8 * + load64 = current_entry }
            while 0 current_entry != do
                unsafe { current_entry (ptr) load64 (K) = entry_key }
                if key entry_key K::eq then
                    unsafe { current_entry (ptr) 8 + load64 (V) Option::Some }
                    return
                fi
                unsafe { current_entry (ptr) 16 + load64 = current_entry }
            done
            Option[V]::None
        }

        fn has self:$Map[K V] key:$K -> bool { key self.get.is_some }

        fn set self:mut$Map[K V] key:mut$K value:V -> Map[K V] {
            key K::hash(u64) self.capacity % = bucket_index
            unsafe { self.buckets bucket_index 8 * + load64 = current_entry }
            while 0 current_entry != do
                unsafe { current_entry (ptr) load64 (K) = entry_key }
                if key entry_key K::eq then
                    unsafe { value (u64) current_entry (ptr) 8 + store64 }
                    self (Map[K V])
                    return
                fi
                unsafe { current_entry (ptr) 16 + load64 = current_entry }
            done
            # New entry
            unsafe { 24 alloc = new_node }
            unsafe { key (u64) new_node (ptr) store64 }
            unsafe { value (u64) new_node (ptr) 8 + store64 }
            unsafe { self.buckets bucket_index 8 * + load64 new_node (ptr) 16 + store64 }
            unsafe { new_node (u64) self.buckets bucket_index 8 * + store64 }
            1 += self.size
            # Resize at 75% load
            if self.capacity 3 * 4 / self.size >= then
                self.resize
            fi
            self (Map[K V])
        }

        fn delete self:mut$Map[K V] key:$K -> Map[K V] {
            key K::hash(u64) self.capacity % = bucket_index
            0 (u64) = prev_entry
            unsafe { self.buckets bucket_index 8 * + load64 = current_entry }
            while 0 current_entry != do
                unsafe { current_entry (ptr) load64 (K) = entry_key }
                if key entry_key K::eq ! then
                    current_entry = prev_entry
                    unsafe { current_entry (ptr) 16 + load64 = current_entry }
                    continue
                fi
                unsafe { current_entry (ptr) 16 + load64 = next_entry }
                if 0 prev_entry == then
                    unsafe { next_entry self.buckets bucket_index 8 * + store64 }
                else
                    unsafe { next_entry prev_entry (ptr) 16 + store64 }
                fi
                1 -= self.size
                self (Map[K V])
                return
            done
            self (Map[K V])
        }

        fn resize self:mut$Map[K V] {
            self.capacity 2 * = new_capacity
            unsafe { new_capacity 8 * alloc = new_buckets }
            0 (u64) = rehash_index
            while rehash_index new_capacity > do
                unsafe { 0 new_buckets rehash_index 8 * + store64 }
                1 += rehash_index
            done
            0 (u64) = rehash_index
            while rehash_index self.capacity > do
                unsafe { self.buckets rehash_index 8 * + load64 = current_entry }
                while 0 current_entry != do
                    unsafe { current_entry (ptr) 16 + load64 = next_entry }
                    unsafe { current_entry (ptr) load64 (K) K::hash(u64) new_capacity % = bucket_index }
                    unsafe { new_buckets bucket_index 8 * + load64 current_entry (ptr) 16 + store64 }
                    unsafe { current_entry new_buckets bucket_index 8 * + store64 }
                    next_entry = current_entry
                done
                1 += rehash_index
            done
            new_buckets = self.buckets
            new_capacity = self.capacity
        }

        fn iter self:$Map[K V] -> Iter[Pair[K V]] {
            unsafe { 16 alloc = st }
            unsafe { 0 st store64 }
            unsafe { 0 st 8 + store64 }
            Option[Pair[K V]]::None = none
            {
                unsafe { st 8 + load64 = current_entry }
                while 0 current_entry == do
                    unsafe { st load64 (u64) = bucket_index }
                    if self.capacity bucket_index >= then
                        none return
                    fi
                    unsafe { self.buckets bucket_index 8 * + load64 = current_entry }
                    unsafe { bucket_index 1 + st store64 }
                done
                unsafe { current_entry (ptr) 16 + load64 st 8 + store64 }
                unsafe { current_entry (ptr) 8 + load64 }
                unsafe { current_entry (ptr) load64 }
                Pair Option::Some
            } Iter
        }

        fn keys self:$Map[K V] -> List[K] {
            List[K]::new = key_list
            for pair in self.iter do
                pair.first key_list.push
            done
            key_list
        }

        fn values self:$Map[K V] -> List[V] {
            List[V]::new = value_list
            for pair in self.iter do
                pair.second value_list.push
            done
            value_list
        }
    }

    impl[K: Hashable + Clone, V: Clone] Map[K V]: Clone {
        fn clone self:$Map[K V] -> Map[K V] {
            Map[K V]::new = result
            for pair in self.iter do
                pair.second.clone pair.first.clone result.set = result
            done
            result
        }
    }

    # ---------------------------------------------------------------------------
    # Set[K] - Hash set backed by Map
    # ---------------------------------------------------------------------------

    struct Set[K] {
        map: Map[K i64]
    }

    impl[K: Hashable] Set[K] {
        fn new -> Set[K] { Map[K i64]::new Set }

        fn length self:$Set[K] -> u64 { self.map.length }

        fn has self:$Set[K] key:$K -> bool { key self.map.has }

        fn add self:mut$Set[K] key:mut$K -> Set[K] {
            0 key self.map.set = self.map
            self
        }

        fn remove self:mut$Set[K] key:$K -> Set[K] {
            key self.map.delete = self.map
            self
        }

        fn iter self:$Set[K] -> Iter[K] {
            self.map.iter = entries
            Option[K]::None = none
            {
                entries.next = entry
                if entry.is_none then none return fi
                entry.unwrap.first Option::Some
            } Iter
        }

        fn to_list self:$Set[K] -> List[K] { self.map.keys }
    }

    impl[K: Hashable + Clone] Set[K]: Clone {
        fn clone self:$Set[K] -> Set[K] {
            Set[K]::new = result
            for key in self.iter do
                key.clone result.add = result
            done
            result
        }
    }

    # ---------------------------------------------------------------------------
    # Command-line arguments
    # ---------------------------------------------------------------------------

    fn get_arg n:u64 -> str {
        if argc n >= then
            "error: argument index out of bounds\n" eprint
            unsafe { 1 60 syscall1 drop }
        fi
        unsafe { argv n 8 * + load64 (cstr) cstr::to_str }
    }

    # ---------------------------------------------------------------------------
    # Stdout output
    # ---------------------------------------------------------------------------

    fn println msg:str { msg print "\n" print }

    # ---------------------------------------------------------------------------
    # Stderr output
    # ---------------------------------------------------------------------------

    fn eprint msg:str {
        unsafe { msg.length msg.as_cstr (ptr) 2 1 syscall3 drop }
    }

    fn eprintln msg:str { f"{msg}\n" eprint }

    # ---------------------------------------------------------------------------
    # StringBuilder
    # ---------------------------------------------------------------------------

    fn chars_to_str chars:List[char] -> str {
        chars.length = length
        unsafe { length 9 + alloc (str) = buffer }
        unsafe { length buffer (ptr) store64 }
        0 (u64) = index
        while index length > do
            index chars.get copy index buffer.set
            1 += index
        done
        '\0' length buffer.set
        buffer
    }

    struct StringBuilder {
        chars: List[char]
    }

    impl StringBuilder {
        fn new -> StringBuilder { List[char]::new StringBuilder }

        fn append self:mut$StringBuilder s:$str {
            for sb_char in s.iter do
                sb_char self.chars.push
            done
        }

        fn append_char self:mut$StringBuilder c:char { c self.chars.push }

        fn build self:mut$StringBuilder -> str { self.chars chars_to_str }

        fn length self:mut$StringBuilder -> u64 { self.chars.length }
    }

    # ---------------------------------------------------------------------------
    # Process execution
    # ---------------------------------------------------------------------------

    fn run_command args:List[str] -> i64 {
        # fork()
        unsafe { 57 syscall0 = child_pid }
        if child_pid 0 > then
            "error: fork failed\n" eprint
            unsafe { 1 60 syscall1 drop }
        fi
        if 0 child_pid == then
            # Child process: build execve argv array
            unsafe { args.length 1 + 8 * alloc = argv_buf }
            0 (u64) = argv_index
            while argv_index args.length > do
                unsafe { argv_index args.get.as_cstr (ptr) (u64) argv_buf argv_index 8 * + store64 }
                1 += argv_index
            done
            # Null terminator
            unsafe { 0 argv_buf args.length 8 * + store64 }
            unsafe { envp argv_buf argv_buf load64 (ptr) 59 syscall3 drop }
            # If execve returns, it failed — exit directly via syscall
            unsafe { 1 60 syscall1 drop }
        fi
        # Parent: wait4(pid, &status, 0, 0)
        unsafe { 8 alloc = wait_status }
        unsafe { 0 (ptr) 0 wait_status child_pid 61 syscall4 drop }
        # Extract exit code: bits 8-15 of status word
        unsafe { wait_status load64 8 >> 255 & (i64) }
    }

    # ---------------------------------------------------------------------------
    # Display implementations for container and enum types
    # ---------------------------------------------------------------------------

    impl char: Eq + Ord + Hashable + Display {
        fn hash c:$char -> i64 { c.codepoint i64::from int_hash }

        fn to_str c:$char -> str {
            c.codepoint = codepoint
            4 (u64) = byte_length
            if 127 codepoint <= then
                1 (u64) = byte_length
            elif 2047 codepoint <= then
                2 (u64) = byte_length
            elif 65535 codepoint <= then
                3 (u64) = byte_length
            fi
            unsafe { byte_length 9 + alloc (str) = char_buf }
            unsafe { byte_length char_buf (ptr) store64 }
            if 1 byte_length == then
                unsafe { codepoint (u8) char_buf (ptr) 8 + store8 }
            elif 2 byte_length == then
                unsafe { codepoint 6 >> 192 | (u8) char_buf (ptr) 8 + store8 }
                unsafe { codepoint 63 & 128 | (u8) char_buf (ptr) 9 + store8 }
            elif 3 byte_length == then
                unsafe { codepoint 12 >> 224 | (u8) char_buf (ptr) 8 + store8 }
                unsafe { codepoint 6 >> 63 & 128 | (u8) char_buf (ptr) 9 + store8 }
                unsafe { codepoint 63 & 128 | (u8) char_buf (ptr) 10 + store8 }
            else
                unsafe { codepoint 18 >> 240 | (u8) char_buf (ptr) 8 + store8 }
                unsafe { codepoint 12 >> 63 & 128 | (u8) char_buf (ptr) 9 + store8 }
                unsafe { codepoint 6 >> 63 & 128 | (u8) char_buf (ptr) 10 + store8 }
                unsafe { codepoint 63 & 128 | (u8) char_buf (ptr) 11 + store8 }
            fi
            unsafe { 0 char_buf (ptr) 8 + byte_length + store8 }
            char_buf
        }
    }

    impl[T: Display const N: u64] array[T N]: Display {
        fn to_str self:$array[T N] -> str {
            StringBuilder::new = builder
            "[" builder.append
            0 (u64) = element_index
            N = element_count
            while element_index element_count > do
                if 0 element_index > then
                    ", " builder.append
                fi
                # Format through a borrow so the array keeps owning its elements.
                unsafe { self (ptr) element_index ARRAY_ELEMENT_WORD_SIZE * + load64 ($T) } = element
                element T::to_str builder.append
                1 += element_index
            done
            "]" builder.append
            builder.build
        }
    }

    impl[T: Display] List[T]: Display {
        fn to_str self:$List[T] -> str {
            StringBuilder::new = list_builder
            "[" list_builder.append
            0 (u64) = list_index
            self.size = list_length
            while list_index list_length > do
                if 0 list_index > then
                    ", " list_builder.append
                fi
                list_index self.get T::to_str list_builder.append
                1 += list_index
            done
            "]" list_builder.append
            list_builder.build
        }
    }

    impl[T: Display] Option[T]: Display {
        fn to_str self:$Option[T] -> str {
            if self.is_some then
                StringBuilder::new = option_builder
                "Some(" option_builder.append
                self.unwrap T::to_str option_builder.append
                ")" option_builder.append
                option_builder.build
                return
            fi
            "None"
        }
    }

    impl[T: Display, E: Display] Result[T E]: Display {
        fn to_str self:$Result[T E] -> str {
            StringBuilder::new = result_builder
            if self.is_ok then
                "Ok(" result_builder.append
                self.unwrap T::to_str result_builder.append
            else
                "Error(" result_builder.append
                self.unwrap_error E::to_str result_builder.append
            fi
            ")" result_builder.append
            result_builder.build
        }
    }
