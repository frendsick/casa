        if 0 absolute < then 0 else absolute fi
    else n fi
    }

    impl str {
        fn hash self:str -> i64 { self str_hash }
    }

    impl i64 {
        fn hash self:i64 -> i64 { self int_hash }
        fn eq self:i64 other:i64 -> bool { self other == }
        fn lt self:i64 other:i64 -> bool { other self < }
    }

    # ---------------------------------------------------------------------------
    # Map[K V] - Hash map with separate chaining
    # ---------------------------------------------------------------------------
    # Entry layout: 24 bytes per entry (key:8, value:8, next:8)
    # Bucket array: capacity * 8 bytes (each slot is a ptr to entry or 0)
    const MAP_INITIAL_CAP 16

    struct Map {
        buckets:  ptr
        size:     u64
        capacity: u64
    }

    impl[K: Hashable, V] Map[K V] {
        fn new -> Map[K V] {
            MAP_INITIAL_CAP (u64) 8 * alloc = mb
            0 (u64) = bucket_index
            while bucket_index MAP_INITIAL_CAP > do
                0 mb bucket_index 8 * (i64) + store64
                1 += bucket_index
            done
            MAP_INITIAL_CAP 0 mb Map (Map[K V])
        }

        fn length self:Map[K V] -> u64 {
            self.size
        }

        fn get self:Map[K V] key:K -> Option[V] {
            key K::hash(u64) self.capacity % = bucket_index
            self.buckets bucket_index 8 * (i64) + load64 = current_entry
            while 0 current_entry != do
                current_entry (ptr) load64 (K) = entry_key
                if key entry_key K::eq then
                    current_entry (ptr) 8 + load64 (V) Option::Some
                    return
                fi
                current_entry (ptr) 16 + load64 = current_entry
            done
            Option[V]::None
        }

        fn has self:Map[K V] key:K -> bool {
            key self.get.is_some
        }

        fn set self:Map[K V] key:K value:V -> Map[K V] {
            key K::hash(u64) self.capacity % = bucket_index
            self.buckets bucket_index 8 * (i64) + load64 = current_entry
            while 0 current_entry != do
                current_entry (ptr) load64 (K) = entry_key
                if key entry_key K::eq then
                    value current_entry (ptr) 8 + store64
                    self (Map[K V])
                    return
                fi
                current_entry (ptr) 16 + load64 = current_entry
            done
            # New entry
            24 alloc = new_node
            key new_node (ptr) store64
            value new_node (ptr) 8 + store64
            self.buckets bucket_index 8 * (i64) + load64 new_node (ptr) 16 + store64
            new_node self.buckets bucket_index 8 * (i64) + store64
            1 += self.size
            # Resize at 75% load
            if self.capacity 3 * 4 / self.size >= then
                self Map::resize
            fi
            self (Map[K V])
        }

        fn delete self:Map[K V] key:K -> Map[K V] {
            key K::hash(u64) self.capacity % = bucket_index
            0 = prev_entry: i64
            self.buckets bucket_index 8 * (i64) + load64 = current_entry
            while 0 current_entry != do
                current_entry (ptr) load64 (K) = entry_key
                if key entry_key K::eq ! then
                    current_entry = prev_entry
                    current_entry (ptr) 16 + load64 = current_entry
                    continue
                fi
                current_entry (ptr) 16 + load64 = next_entry
                if 0 prev_entry == then
                    next_entry self.buckets bucket_index 8 * (i64) + store64
                else
                    next_entry prev_entry (ptr) 16 + store64
                fi
                1 -= self.size
                self (Map[K V])
                return
            done
            self (Map[K V])
