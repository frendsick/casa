# ---------------------------------------------------------------------------
# Pair - generic two-element tuple
# ---------------------------------------------------------------------------

struct Pair[A B] {
    first:  A
    second: B
}

impl[A: Display, B: Display] Pair[A B]: Display {
    fn to_str self:$Pair[A B] -> str {
        self.first A::to_str = first_str
        self.second B::to_str = second_str
        f"({first_str}, {second_str})"
    }
}

# ---------------------------------------------------------------------------
# Iter - closure-based lazy iterator
# ---------------------------------------------------------------------------
# A `for` loop calls `<value>::next` repeatedly until it returns `None`. The
# `Iter` struct wraps a closure that yields elements lazily, enabling
# composition of iterator combinators without intermediate allocations.

struct Iter[T] {
    next_fn: fn[-> Option[T]]
}

impl[T] Iter[T]: Iterable[T] {
    fn next self:mut$Iter[T] -> Option[T] { self.next_fn exec }
}

impl[T: Ord] Iter[T] {
    fn min self:mut$Iter[T] -> Option[T] {
        self.next = first
        if first.is_none then
            first return
        fi
        first.unwrap = best
        for elem in self do
            if best elem < then
                elem = best
            fi
        done
        best Option::Some
    }

    fn max self:mut$Iter[T] -> Option[T] {
        self.next = first
        if first.is_none then
            first return
        fi
        first.unwrap = best
        for elem in self do
            if elem best < then
                elem = best
            fi
        done
        best Option::Some
    }
}

impl array {
    # Yields element borrows: the array keeps owning every element, so an
    # owned yield would destroy values the array still references.
    fn iter [T const N:u64] self:$array[T N] -> Iter[$T] {
        unsafe { 16 alloc = st }
        unsafe { N st store64 }
        unsafe { 0 (u64) st 8 + store64 }
        Option[$T]::None = none
        {
            unsafe { st 8 + load64 (u64) = idx }
            if unsafe { st load64 (u64) idx >= } then
                none return
            fi
            unsafe { idx 1 + st 8 + store64 }
            idx self.nth Option::Some
        } Iter = iterator
        # ADR-0112: the closure reads through `self`, but a closure capture
        # carries no origin of its own. Re-forming the iterator from its raw
        # address anchors the yielded borrows to this function's input.
        unsafe { iterator (ptr) (Iter[$T]) }
    }
}

impl[T] List[T] {
    # Yields element borrows: the list keeps owning every element, so an owned
    # yield would destroy values the list still references.
    fn iter self:$List[T] -> Iter[$T] {
        unsafe { 16 alloc = st }
        unsafe { self.length st store64 }
        unsafe { 0 (u64) st 8 + store64 }
        Option[$T]::None = none
        {
            unsafe { st 8 + load64 (u64) = idx }
            if unsafe { st load64 (u64) idx >= } then
                none return
