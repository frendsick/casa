        # SAFETY: source is initialized and ensure_capacity provides a disjoint destination.
        unsafe { source.size source.data self.data self.size + memcpy }
        source.size += self.size
    }

    pub fn get self:$Bytes index:u64 -> Option[u8] {
        if self.size index >= then
            Option[u8]::None
        else
            # SAFETY: The bounds check identifies one initialized byte.
            unsafe { self.data index + load8 } Option::Some
        fi
    }

    fn is_byte_in_range self:$Bytes index:u64 minimum:u8 maximum:u8 -> bool {
        index self.get match
            Option::Some(byte) => minimum byte >= maximum byte <= &&
            Option::None => false
        end
    }

    pub fn iter self:$Bytes -> Iter[u8] {
        0 (u64) = index
        {
            index self.get = byte
            if byte.is_some then
                1 += index
            fi
            byte
        } Iter
    }

    pub fn drop self:mut$Bytes {
        # SAFETY: Bytes exclusively owns data until drop releases the allocation.
        unsafe {
            self.data free
            0 (ptr) = self.data
            0 (u64) = self.size
            0 (u64) = self.storage_capacity
        }
