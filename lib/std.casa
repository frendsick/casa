            index self.at.codepoint = first
            if 127 first <= then
                1 += index
                # SAFETY: Valid str storage makes the decoded ASCII byte a Unicode scalar.
                unsafe { first char::from_codepoint_unchecked } Option::Some return
            fi
            if 224 first & 192 == then
                index 1 + self.at.codepoint = second
                2 += index
                # SAFETY: Valid str storage makes the decoded two-byte sequence a Unicode scalar.
                unsafe { first 31 & 6 << second 63 & | char::from_codepoint_unchecked }
                Option::Some return
            fi
            if 240 first & 224 == then
                index 1 + self.at.codepoint = second
                index 2 + self.at.codepoint = third
                3 += index
                # SAFETY: Valid str storage makes the decoded three-byte sequence a Unicode scalar.
                unsafe {
                    first 15 & 12 <<
                    second 63 & 6 << |
                    third 63 & |
                    char::from_codepoint_unchecked
                } Option::Some return
            fi
            index 1 + self.at.codepoint = second
            index 2 + self.at.codepoint = third
            index 3 + self.at.codepoint = fourth
            4 += index
            # SAFETY: Valid str storage makes the decoded four-byte sequence a Unicode scalar.
            unsafe {
                first 7 & 18 <<
                second 63 & 12 << |
                third 63 & 6 << |
                fourth 63 & |
                char::from_codepoint_unchecked
