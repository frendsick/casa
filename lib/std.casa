}

impl array {
    fn contains [const N:u64] self:$array[str N] needle:$str -> bool {
        0 (u64) = i
        while i N > do
            # Compare through a borrow so the array keeps owning its elements.
            unsafe { self (ptr) i ARRAY_ELEMENT_WORD_SIZE * + load64 ($str) } = element
