                while 0 current_entry != do
                    current_entry (ptr) next_offset + load64 = next_entry
                    current_entry (ptr) ptr::as_ref[K] K::hash(u64) new_capacity % = bucket_index
                    new_buckets bucket_index 8 * + load64 current_entry (ptr) next_offset + store64
                    current_entry new_buckets bucket_index 8 * + store64
                    next_entry = current_entry
                done
                1 += rehash_index
            done
            self.buckets = old_buckets
            new_buckets = self.buckets
            new_capacity = self.capacity
            old_buckets free
        }
