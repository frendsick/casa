    # Returns the first index where the predicate returns true.
    # The list must be partitioned so that the predicate is false
    # for a prefix and true for the rest.
    pub fn bisect [T] self:$List[T] predicate:fn[$T -> bool] -> u64 {
        0 (u64) = low
        self.length = high
        while low high > do
            high low - 2 / low + = mid
            if mid self.get predicate exec then
                mid = high
            else
                mid 1 + = low
            fi
        done
        low
    }

    pub fn sort_by self:mut$List[T] f:fn[$T $T -> bool] {
        if 1 self.size <= then
            return
        fi
        f self.size 1 - 0 self.sort_by_range
    }

    pub fn sort_by_range self:mut$List[T] low:u64 high:u64 f:$fn[$T $T -> bool] {
        if high low >= then
            return
        fi
        high low + 2 / high self.swap_at
        low = store_idx
        low = i
        while i high > do
            if high self.get i self.get f exec then
                store_idx i self.swap_at
                1 += store_idx
            fi
            1 += i
        done
        store_idx high self.swap_at
        if low store_idx > then
            f store_idx 1 - low self.sort_by_range
        fi
        if store_idx high > then
            f high store_idx 1 + self.sort_by_range
        fi
    }
}

