# ---------------------------------------------------------------------------
# Character classification
# ---------------------------------------------------------------------------

impl char {
    pub fn from_codepoint codepoint:u32 -> Option[char] {
        if
            1114111 codepoint <=
            55296 codepoint >= 57343 codepoint <= && ! &&
        then
            # SAFETY: The range checks exclude invalid Unicode scalar values.
            unsafe { codepoint char::from_codepoint_unchecked } Option::Some
        else
            Option[char]::None
        fi
    }

    pub fn is_digit c:char -> bool { '0' c >= '9' c <= && }

    pub fn is_upper c:char -> bool { 'A' c >= 'Z' c <= && }

    pub fn is_lower c:char -> bool { 'a' c >= 'z' c <= && }

    pub fn is_alpha c:char -> bool { c.is_upper c.is_lower || }

    pub fn is_space c:char -> bool { c ' ' == c '\t' == || c '\n' == || c '\r' == || }

    pub fn eq self:$char other:$char -> bool { self other == }
    pub fn lt self:$char other:$char -> bool { other self < }
}

impl ptr {
    pub fn to_str p:$ptr -> String {
        # SAFETY: Copying and formatting the pointer value does not dereference it.
        unsafe { p copy (i64).to_str }
    }

    pub fn eq self:$ptr other:$ptr -> bool { self other == }
}

# ---------------------------------------------------------------------------
# Option and Result enums
# ---------------------------------------------------------------------------
# None=0, Some=1 so is_some checks ordinal==1

pub enum Option[T] {
    None
    Some (T)
}

# Error=0, Ok=1 so is_ok checks ordinal==1

pub enum Result[T E] {
    Error (E)
    Ok (T)
}

pub enum Ordering derives Eq Copy {
    Less
    Equal
    Greater
}

impl Option {
    pub fn is_ok [T] self:$Option[T] -> bool {
        unsafe { self (ptr) load64 1 == }
    }
    pub fn is_some [T] self:$Option[T] -> bool {
        unsafe { self (ptr) load64 1 == }
    }
    pub fn is_none [T] self:$Option[T] -> bool {
        unsafe { self (ptr) load64 0 == }
    }
    pub fn unwrap [T] self:Option[T] -> T {
        self match
            Option::Some(value) => {
                value return
            }
            Option::None => {
                "error: called unwrap on None\n" print
                60 exit
            }
        end
    }
    pub fn propagate [T U] self:Option[T] -> Option[U] { Option[U]::None }
    pub fn unwrap_or [T] self:Option[T] default:T -> T {
        if self.is_some then
            self.unwrap
        else
            default
        fi
    }
    pub fn map [T U] self:Option[T] f:fn[T -> U] -> Option[U] {
        if self.is_some then
            self.unwrap f exec Option::Some
        else
            Option[U]::None
        fi
    }
    pub fn and_then [T U] self:Option[T] f:fn[T -> Option[U]] -> Option[U] {
        if self.is_some then
            self.unwrap f exec
        else
            Option[U]::None
        fi
    }
    pub fn or_else [T] self:Option[T] f:fn[-> Option[T]] -> Option[T] {
        if self.is_some then
            self
        else
            f exec
        fi
    }
    pub fn filter [T] self:Option[T] f:fn[$T -> bool] -> Option[T] {
        if self.is_none then
            Option[T]::None return
        fi
        self.unwrap = val
        if val f exec then
            val Option::Some
        else
            Option[T]::None
        fi
    }
}

impl Result {
    pub fn is_ok [T E] self:$Result[T E] -> bool {
        unsafe { self (ptr) load64 1 == }
    }
    pub fn is_error [T E] self:$Result[T E] -> bool {
        unsafe { self (ptr) load64 0 == }
    }
    pub fn unwrap [T E] self:Result[T E] -> T {
        self match
            Result::Ok(value) => {
                value return
            }
            Result::Error(_) => {
                "error: called unwrap on error\n" print
                60 exit
            }
        end
    }
    pub fn unwrap_error [T E] self:Result[T E] -> E {
        self match
            Result::Error(error) => {
                error return
            }
            Result::Ok(_) => {
                "error: called unwrap_error on ok\n" print
                60 exit
            }
        end
    }
    pub fn propagate [T U E] self:Result[T E] -> Result[U E] { self.unwrap_error Result::Error }
    pub fn unwrap_or [T E] self:Result[T E] default:T -> T {
        if self.is_ok then
            self.unwrap
        else
            default
        fi
    }
    pub fn map [T U E] self:Result[T E] f:fn[T -> U] -> Result[U E] {
        if self.is_ok then
            self.unwrap f exec Result::Ok
        else
            self.unwrap_error Result::Error
        fi
    }
    pub fn map_error [T E F] self:Result[T E] f:fn[E -> F] -> Result[T F] {
        if self.is_ok then
            self.unwrap Result::Ok
        else
            self.unwrap_error f exec Result::Error
        fi
    }
    pub fn and_then [T U E] self:Result[T E] f:fn[T -> Result[U E]] -> Result[U E] {
        if self.is_ok then
            self.unwrap f exec
        else
            self.unwrap_error Result::Error
        fi
    }
    pub fn or_else [T E F] self:Result[T E] f:fn[E -> Result[T F]] -> Result[T F] {
        if self.is_ok then
            self.unwrap Result::Ok
        else
            self.unwrap_error f exec
        fi
    }
}

# ---------------------------------------------------------------------------
# Traits
# ---------------------------------------------------------------------------

pub trait Clone {
    fn clone self:$self -> self
}

pub trait Copy: Clone { }

impl List {
    # Copy the inline representation of elements that cannot own resources.
    pub fn shallow_copy [T:Copy] self:$List[T] -> List[T] {
        size_of[T] = stride
        if 0 stride == then
            1 (u64) = stride
        fi
        self.capacity stride * = bytes
        # SAFETY: The copy uses distinct allocations and copies only initialized element bytes.
        unsafe {
            bytes alloc = data
            self.size stride * self.data data memcpy
            self.capacity self.size data List (List[T])
        }
    }
}

pub trait PartialEq {
    fn eq self:$self other:$self -> bool
    fn ne self:$self other:$self -> bool { other self.eq ! }
}

pub trait Eq: PartialEq { }

pub trait PartialOrd: PartialEq {
    fn partial_cmp self:$self other:$self -> Option[Ordering]
    fn lt self:$self other:$self -> bool {
        other self.partial_cmp = result
        if result Option::Some(ordering) is then
            ordering Ordering::Less ==
        else
            false
        fi
    }

    fn le self:$self other:$self -> bool {
        other self.partial_cmp = result
        if result Option::Some(ordering) is then
            ordering Ordering::Greater !=
        else
            false
        fi
    }

    fn gt self:$self other:$self -> bool {
        other self.partial_cmp = result
        if result Option::Some(ordering) is then
            ordering Ordering::Greater ==
        else
            false
        fi
    }

    fn ge self:$self other:$self -> bool {
        other self.partial_cmp = result
        if result Option::Some(ordering) is then
            ordering Ordering::Less !=
        else
            false
        fi
    }
}

pub trait Ord: PartialOrd + Eq {
    fn cmp self:$self other:$self -> Ordering
    fn partial_cmp self:$self other:$self -> Option[Ordering] { other self.cmp Option::Some }
}

pub trait Word { }

pub trait Hashable: Eq + Word {
    fn hash self:$self -> i64
}

pub trait Display: Word {
    fn to_str self:$self -> String
}

pub trait Iterable[T] {
    fn next self:mut$self -> Option[T]
    fn collect self:mut$self -> List[T] {
        List[T]::new = result
        for elem in self do
            elem result.push
        done
        result
    }

    fn map [U] self:self f:fn[T -> U] -> Iter[U] {
        move {
            self.next = opt
            if opt.is_none then
                Option[U]::None return
            fi
            opt.unwrap f exec Option::Some
        } Iter
    }

    fn filter self:self f:fn[$T -> bool] -> Iter[T] {
        move {
            while true do
                self.next = opt
                if opt.is_none then
                    Option[T]::None return
                fi
                opt.unwrap = elem
                if elem f exec then
                    elem Option::Some return
                fi
            done
            Option[T]::None
        } Iter
    }

    fn fold [U] self:mut$self acc:U f:fn[U T -> U] -> U {
        for elem in self do
            elem acc f exec = acc
        done
        acc
    }

    fn count self:mut$self -> u64 {
        0 (u64) = n
        for elem in self do
            1 += n
        done
        n
    }

    fn any self:mut$self f:fn[$T -> bool] -> bool {
        for elem in self do
            if elem f exec then
                true return
            fi
        done
        false
    }

    fn all self:mut$self f:fn[$T -> bool] -> bool {
        for elem in self do
            if elem f exec ! then
                false return
            fi
        done
        true
    }

    fn find self:mut$self f:fn[$T -> bool] -> Option[T] {
        for elem in self do
            if elem f exec then
                elem Option::Some return
            fi
        done
        Option[T]::None
    }

    fn take self:self n:u64 -> Iter[T] {
        n = remaining
        move {
            if remaining 0 >= then
                Option[T]::None return
            fi
            1 -= remaining
            self.next
        } Iter
    }

    fn skip self:self n:u64 -> Iter[T] {
        false = skipped
        move {
            if skipped ! then
                true = skipped
                0 (u64) = i
                while i n > do
                    self.next = opt
                    if opt.is_none then
                        Option[T]::None return
                    fi
                    1 += i
                done
            fi
            self.next
        } Iter
    }

