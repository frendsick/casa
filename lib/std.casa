    fn sort_by self:mut$List[T] f:fn[$T $T -> bool] {
        if 1 self.size <= then return fi
        f self.size 1 - 0 self.sort_by_range
    }

    fn sort_by_range self:mut$List[T] low:u64 high:u64 f:fn[$T $T -> bool] {
        if high low >= then return fi
        high low + 2 / high self.swap_at
        high self.get = pivot
        low = store_idx
        low = i
        while i high > do
            if pivot i self.get f exec then
                store_idx i self.swap_at
                1 += store_idx
            fi
            1 += i
        done
        store_idx high self.swap_at
        if low store_idx > then
            f store_idx 1 - low self.sort_by_range
        fi
        if store_idx high > then
            f high store_idx 1 + self.sort_by_range
        fi
    }
}

impl[T] Slice[T] {
    fn iter self:$Slice[T] -> Iter[$T] {
        unsafe { 8 alloc = state }
