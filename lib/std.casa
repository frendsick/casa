impl i64 {
    pub fn wrapping_add self:$i64 other:i64 -> i64 { self other + }
    pub fn wrapping_sub self:$i64 other:i64 -> i64 { self other - }
    pub fn wrapping_mul self:$i64 other:i64 -> i64 { self other * }

    pub fn to_str n:$i64 -> String {
        if 0 n < then
            n 0.wrapping_sub = absolute
            if 0 absolute < then
                "-9223372036854775808".to_str
