                "-".to_str = result
                absolute (u64) format_unsigned_decimal result.append_string
                result
            fi
        else
            n copy (u64) format_unsigned_decimal
        fi
    }

    pub fn abs self:$i64 -> i64 {
        if 0 self < then
            0 self -
        else
            self copy
        fi
    }

    pub fn min self:$i64 other:i64 -> i64 {
        if other self < then
            self copy
        else
            other
        fi
    }

    pub fn max self:$i64 other:i64 -> i64 {
        if self other < then
            self copy
        else
            other
        fi
    }

    pub fn clamp self:$i64 lo:i64 hi:i64 -> i64 {
        if lo self < then
            lo
        elif self hi < then
            hi
        else
            self copy
        fi
    }

    pub fn pow self:$i64 exp:i64 -> i64 {
        if 0 exp < then
            0 return
        fi
        1 = result
        0 = i
        while i exp > do
            self result * = result
            1 += i
        done
        result
    }
}

