impl Bytes {
    pub fn to_str self:$Bytes -> Result[String Utf8Error] {
        0 (u64) = index
        while index self.size > do
            index self.get.unwrap = first
            1 (u64) = width
            UTF8_CONTINUATION_MIN (u8) = second_minimum
            UTF8_CONTINUATION_MAX (u8) = second_maximum
            if UTF8_ASCII_MAX first <= then
                1 (u64) = width
            elif UTF8_TWO_BYTE_LEAD_MIN first >= UTF8_TWO_BYTE_LEAD_MAX first <= && then
                2 (u64) = width
            elif UTF8_THREE_BYTE_LEAD_MIN first >= UTF8_THREE_BYTE_LEAD_MAX first <= && then
                3 (u64) = width
                if UTF8_THREE_BYTE_LEAD_MIN first == then
                    UTF8_E0_SECOND_MIN (u8) = second_minimum
                elif UTF8_ED_LEAD first == then
                    UTF8_ED_SECOND_MAX (u8) = second_maximum
                fi
            elif UTF8_FOUR_BYTE_LEAD_MIN first >= UTF8_FOUR_BYTE_LEAD_MAX first <= && then
                4 (u64) = width
                if UTF8_FOUR_BYTE_LEAD_MIN first == then
                    UTF8_F0_SECOND_MIN (u8) = second_minimum
                elif UTF8_FOUR_BYTE_LEAD_MAX first == then
                    UTF8_F4_SECOND_MAX (u8) = second_maximum
                fi
            else
                index Utf8Error Result::Error return
            fi

            if 1 width > then
                if second_maximum second_minimum index 1 + self.is_byte_in_range ! then
                    index 1 + Utf8Error Result::Error return
                fi
            fi
            2 (u64) = offset
            while offset width > do
                if
                    UTF8_CONTINUATION_MAX UTF8_CONTINUATION_MIN
                    index offset + self.is_byte_in_range !
                then
                    index offset + Utf8Error Result::Error return
                fi
                1 += offset
            done
            width += index
        done

        self.size String::with_capacity = text
        # SAFETY: Validation established UTF-8, and text has matching capacity plus a NUL slot.
        unsafe {
            self.size text.data (ptr) store64
            self.size self.data text.data (ptr) 8 + memcpy
            0 text.data (ptr) 8 + self.size + store8
        }
        text Result::Ok
    }
}

# ---------------------------------------------------------------------------
# Process execution
# ---------------------------------------------------------------------------

pub fn run_command args:List[String] -> i64 {
    for argument in args.iter do
        if
            argument
                .as_str
                .as_cstr
                .is_none
        then
            0 22 - return
        fi
    done
    # fork()
    unsafe { 57 syscall0 = child_pid }
    if child_pid 0 > then
        "error: fork failed\n" eprint
        unsafe { 1 60 syscall1 drop }
    fi
    if 0 child_pid == then
        # Child process: build execve argv array
        args.length 1 + 8 * RawBuffer::new = argv_buf
        0 (u64) = argv_index
        while argv_index args.length > do
            # SAFETY: argv_buf has one pointer slot per argument and every argument passed
            # the interior-NUL check above.
            unsafe {
                argv_index args
                    .get
                    .as_str
                    .as_cstr
                    .unwrap (ptr) (u64)
                argv_buf.data argv_index 8 * + store64
            }
            1 += argv_index
        done
        # Null terminator
        unsafe { 0 argv_buf.data args.length 8 * + store64 }
        unsafe { envp argv_buf.data argv_buf.data load64 (ptr) 59 syscall3 drop }
        # If execve returns, it failed — exit directly via syscall
        argv_buf drop
        unsafe { 1 60 syscall1 drop }
    fi
    # Parent: wait4(pid, &status, 0, 0)
    8 RawBuffer::new = wait_status
    unsafe { 0 (ptr) 0 wait_status.data child_pid 61 syscall4 drop }
    # Extract exit code: bits 8-15 of status word
    unsafe { wait_status.data load64 8 >> 255 & (i64) }
}

# ---------------------------------------------------------------------------
# Display implementations for container and enum types
# ---------------------------------------------------------------------------

impl char: Eq + Ord + Hashable + Display {
    pub fn hash c:$char -> i64 { c.codepoint i64::from int_hash }

    pub fn cmp self:$char other:$char -> Ordering {
        if other self < then
            Ordering::Less
        elif other self > then
            Ordering::Greater
        else
            Ordering::Equal
        fi
    }

    pub fn to_str c:$char -> String {
        String::new = result
        c copy result.push
        result
    }
}

impl[T: Display const N: u64] array[T N]: Display {
    pub fn to_str self:$array[T N] -> String {
        String::new = builder
        "[" builder.append
        0 (u64) = element_index
        N = element_count
        while element_index element_count > do
            if 0 element_index > then
                ", " builder.append
            fi
            element_index self.nth = element
            element T::to_str = element_text
            element_text.as_str builder.append
            1 += element_index
        done
        "]" builder.append
        builder
    }
}

impl[T: Display] List[T]: Display {
    pub fn to_str self:$List[T] -> String {
        String::new = list_builder
        "[" list_builder.append
        0 (u64) = list_index
        self.size = list_length
        while list_index list_length > do
            if 0 list_index > then
                ", " list_builder.append
            fi
            list_index self.get T::to_str = element_text
            element_text.as_str list_builder.append
            1 += list_index
        done
        "]" list_builder.append
        list_builder
    }
}

impl[T: Display] Option[T]: Display {
    pub fn to_str self:$Option[T] -> String {
        if self Option::Some(value) is then
            String::new = option_builder
            "Some(" option_builder.append
            value T::to_str = value_text
            value_text.as_str option_builder.append
            ")" option_builder.append
            option_builder
            return
        fi
        "None".to_str
    }
}

impl[T: Display, E: Display] Result[T E]: Display {
    pub fn to_str self:$Result[T E] -> String {
        String::new = result_builder
        if self Result::Ok(value) is then
            "Ok(" result_builder.append
            value T::to_str = value_text
            value_text.as_str result_builder.append
        elif self Result::Error(error) is then
            "Error(" result_builder.append
            error E::to_str = error_text
            error_text.as_str result_builder.append
        else
            1 exit
        fi
        ")" result_builder.append
        result_builder
    }
}
