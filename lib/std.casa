                current_entry (ptr) ptr::as_ref[K] = entry_key
                if key entry_key K::eq then
                    current_entry (ptr) key_size + ptr::as_mut[V] Option::Some return
                fi
                current_entry (ptr) next_offset + load64 = current_entry
