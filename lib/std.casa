                    current_entry (ptr) load64 (K) K::hash(u64) new_capacity % = bucket_index
                    new_buckets bucket_index 8 * (i64) + load64 current_entry (ptr) 16 + store64
                    current_entry new_buckets bucket_index 8 * (i64) + store64
                    next_entry = current_entry
                done
                1 += rehash_index
