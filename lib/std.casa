# ---------------------------------------------------------------------------
# Hash helpers
# ---------------------------------------------------------------------------

fn str_hash s:str -> i64 {
    5381 = hash
    for sh_char in s.iter do
        hash 5 << = shifted
        shifted hash.wrapping_add = hash
        sh_char (i64) hash.wrapping_add = hash
    done
    if 0 hash < then
        hash 0.wrapping_sub = hash
        if 0 hash < then 0 = hash fi
    fi
    hash
}

fn int_hash n:i64 -> i64 {
