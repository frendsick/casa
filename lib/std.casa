# ---------------------------------------------------------------------------
# Hash helpers
# ---------------------------------------------------------------------------

pub fn str_hash s:$str -> i64 {
    5381 = hash
    for sh_char in s.iter do
        hash 5 << = shifted
        shifted hash.wrapping_add = hash
        sh_char.codepoint i64::from hash.wrapping_add = hash
    done
    if 0 hash < then
        hash 0.wrapping_sub = hash
        if 0 hash < then
            0 = hash
        fi
    fi
    hash
}

pub fn int_hash n:i64 -> i64 {
    if 0 n < then
        n 0.wrapping_sub = absolute
        if 0 absolute < then
            0
        else
            absolute
        fi
    else
        n
    fi
}

impl str: Hashable + Display {
    pub fn hash self:$str -> i64 { self str_hash }
}

impl String: Hashable + Display {
    pub fn hash self:$String -> i64 { self.as_str str_hash }

    pub fn eq self:$String other:$String -> bool { self.as_str other.as_str == }
}

impl i64: Hashable + Ord + Display {
    pub fn hash self:$i64 -> i64 { self copy int_hash }
    pub fn eq self:$i64 other:$i64 -> bool { self other == }
    pub fn cmp self:$i64 other:$i64 -> Ordering {
        if other self < then
            Ordering::Less
        elif other self > then
            Ordering::Greater
        else
            Ordering::Equal
        fi
    }
}

# ---------------------------------------------------------------------------
# Map[K V] - Hash map with separate chaining
# ---------------------------------------------------------------------------
# Entry layout is the key bytes, value bytes, then the next pointer.
# Bucket array: capacity * 8 bytes (each slot is a ptr to entry or 0)
pub const MAP_INITIAL_CAP 16

pub struct Map {
    pub buckets:  ptr
    pub size:     u64
    pub capacity: u64
}

impl[K V] Map[K V] {
    pub fn entry_key self:$Map[K V] address:ptr -> $K {
        # SAFETY: Callers pass an initialized entry address whose first field is K.
        unsafe { address ptr::as_ref[K] }
    }

    pub fn entry_value self:$Map[K V] address:ptr -> $V {
        # SAFETY: Callers add the key size to an initialized entry address.
        unsafe { address ptr::as_ref[V] }
    }

    pub fn drop self:mut$Map[K V] {
        size_of[K] = key_size
        size_of[V] = value_size
        key_size value_size + = next_offset
        # SAFETY: Every bucket link identifies one initialized node owned by this Map.
        unsafe {
            0 (u64) = bucket_index
            while bucket_index self.capacity > do
                self.buckets bucket_index 8 * + load64 = current_entry
                while 0 current_entry != do
                    current_entry (ptr) next_offset + load64 = next_entry
                    current_entry (ptr) ptr::read[K] drop
                    current_entry (ptr) key_size + ptr::read[V] drop
                    current_entry (ptr) free
                    next_entry = current_entry
                done
                1 += bucket_index
            done
            self.buckets free
            0 (ptr) = self.buckets
            0 = self.size
            0 = self.capacity
        }
    }
}

