    0 (u64) = index
    false = negative
    if '-' 0 text.at == then
        true = negative
        1 (u64) = index
        if index text.length == then
            Option::None return
        fi
    fi

    String::new = digits
    0 = fractional_digits
    false = decimal_seen
    false = digit_seen
    while index text.length > do
        index text.at = character
        if character.is_digit then
            true = digit_seen
            character digits.push
            if decimal_seen then
                1 += fractional_digits
            fi
            1 += index
            continue
        fi
        if '.' character == decimal_seen ! && then
            if digit_seen ! then
                Option::None return
            fi
            true = decimal_seen
            1 += index
            if index text.length == then
                Option::None return
            fi
            continue
        fi
        break
    done
    if digit_seen ! then
        Option::None return
    fi

    0 = explicit_exponent
    if index text.length > then
        index text.at = marker
        if 'e' marker != 'E' marker != && then
            Option::None return
        fi
        1 += index
        false = exponent_negative
        if index text.length > then
            index text.at = sign
            if '-' sign == '+' sign == || then
                '-' sign == = exponent_negative
                1 += index
            fi
        fi
        if index text.length == then
            Option::None return
        fi
        while index text.length > do
            index text.at = character
            if character.is_digit ! then
                Option::None return
            fi
            if explicit_exponent 1000 <= then
                Option::None return
            fi
            10 explicit_exponent * character.codepoint i64::from '0'.codepoint i64::from - + = explicit_exponent
            1 += index
        done
        if exponent_negative then
            0 explicit_exponent - = explicit_exponent
        fi
    fi
    explicit_exponent fractional_digits - = exponent
    negative exponent digits ParsedFloatText Option::Some
}

pub fn rounded_float_parts parsed:$ParsedFloatText precision:u64 -> RoundedFloatParts {
    0 (u64) = significand
    0 (u64) = significant_digits
    -1 = round_digit
    false = trailing_nonzero
    for character in parsed.digits.iter do
        character.codepoint i64::from '0'.codepoint i64::from - = digit
        if 0 significant_digits == 0 digit == && then
            continue
        fi
        if precision significant_digits < then
            10 significand * digit (u64) + = significand
        elif significant_digits precision == then
            digit = round_digit
        elif 0 digit != then
            true = trailing_nonzero
        fi
        1 += significant_digits
    done
    if
        round_digit 5 <
        5 round_digit == trailing_nonzero significand 2 % 0 != || && ||
    then
        1 += significand
    fi
    0 = skipped
    if significant_digits precision < then
        significant_digits (i64) precision (i64) - = skipped
    fi
    significand parsed.exponent skipped + RoundedFloatParts
}

pub fn format_unsigned_decimal value:u64 -> String {
    20 String::with_capacity = reversed
    value = remaining
    if 0 remaining == then
        '0' reversed.push
    fi
    while 0 remaining != do
        remaining 10 % '0'.codepoint (u64) + (u32)
        char::from_codepoint.unwrap reversed.push
        remaining 10 / = remaining
    done
    reversed.as_str.reverse
}

pub fn format_float_decimal significand:u64 exponent:i64 negative:bool -> String {
    significand.to_str = digits
    String::new = result
    exponent 1 + = integer_digits
    if 0 exponent >= digits.length (i64) integer_digits <= && then
        integer_digits (u64) = split
        if split digits.length == then
            f"{digits}.0" = result
        else
            digits.length = digits_length
            digits.as_str 0 split str::substring = whole
            digits.as_str split digits_length split - str::substring = fraction
            f"{whole}.{fraction}" = result
        fi
    elif 0 exponent < -4 exponent >= && then
        0 exponent - 1 - (u64) = zero_count
        f"0.{zero_count "0".repeat}{digits}" = result
    else
        if 1 digits.length == then
            f"{digits}e{exponent}" = result
        else
            digits.length = digits_length
            digits.as_str 0 1 str::substring = first
            digits.as_str 1 digits_length 1 - str::substring = rest
            f"{first}.{rest}e{exponent}" = result
        fi
    fi
    if negative then
        f"-{result}"
    else
        result
    fi
}

