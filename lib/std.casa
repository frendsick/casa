# ---------------------------------------------------------------------------
# Set[K] - Hash set backed by Map
# ---------------------------------------------------------------------------

pub struct Set[K] {
    pub map: Map[K i64]
}

impl[K: Hashable] Set[K] {
    pub fn new -> Set[K] { Map[K i64]::new Set }

    pub fn length self:$Set[K] -> u64 { self.map.length }

    pub fn is_empty self:$Set[K] -> bool { self.map.is_empty }

    pub fn has self:$Set[K] key:$K -> bool { key self.map.has }

    pub fn add self:mut$Set[K] key:K { 0 key self.map.set }

    pub fn remove self:mut$Set[K] key:$K { key self.map.delete }

    pub fn iter self:$Set[K] -> Iter[$K] { self.map.iter_keys }
}

impl Set[String] {
    pub fn add_str self:mut$Set[String] key:$str { key.to_str self.add }

    pub fn has_str self:$Set[String] key:$str -> bool { key self.map.has_str }

    pub fn remove_str self:mut$Set[String] key:$str { key self.map.delete_str }
}

impl List[String] {
    pub fn push_str self:mut$List[String] value:$str { value.to_str self.push }
}

impl[K: Hashable + Clone] Set[K] {
    pub fn to_list self:$Set[K] -> List[K] { self.map.keys }
}

impl[K: Hashable + Clone] Set[K]: Clone {
    pub fn clone self:$Set[K] -> Set[K] {
        Set[K]::new = result
        for key in self.iter do
            key K::clone result.add
        done
        result
    }
}

# ---------------------------------------------------------------------------
# Command-line arguments
# ---------------------------------------------------------------------------

pub fn get_arg n:u64 -> String {
    if argc n >= then
        "error: argument index out of bounds\n" eprint
        unsafe { 1 60 syscall1 drop }
    fi
    # SAFETY: argv contains argc accessible NUL-terminated process argument pointers.
    unsafe { argv n 8 * + load64 (ptr) ($cstr) }.to_str.unwrap
}

# ---------------------------------------------------------------------------
# Stdout output
# ---------------------------------------------------------------------------

pub fn println message:$str { message print "\n" print }

pub fn println_string message:String { message print "\n" print }

# ---------------------------------------------------------------------------
# Stderr output
# ---------------------------------------------------------------------------

pub fn eprint message:$str {
    # SAFETY: The borrowed text contains `length` readable bytes after its header.
    unsafe { message.length message (ptr) 8 + 2 1 syscall3 drop }
}

pub fn eprintln message:$str { f"{message}\n".as_str eprint }

pub fn eprintln_string message:String { message.as_str eprint "\n" eprint }

