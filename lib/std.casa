        while index text.length > do
            index text.at = character
            if character.is_digit ! then Option::None return fi
            if explicit_exponent 1000 <= then Option::None return fi
            10 explicit_exponent * character (i64) '0' (i64) - + = explicit_exponent
            1 += index
        done
        if exponent_negative then 0 explicit_exponent - = explicit_exponent fi
    fi
    explicit_exponent fractional_digits - = exponent
    negative exponent digits.build ParsedFloatText Option::Some
}

fn rounded_float_parts parsed:ParsedFloatText precision:u64 -> RoundedFloatParts {
    0 = significand
    0 (u64) = significant_digits
