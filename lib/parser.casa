# Parser library for cursor-based text scanning
#
# Provides a Cursor struct for scanning text character by character,
# and high-level parsers for common patterns like integers, identifiers,
# quoted strings, and char literals.
import "std" as std

# ---------------------------------------------------------------------------
# Structs
# ---------------------------------------------------------------------------

pub struct Cursor {
    pub source: $str
    pub pos:    u64
}

pub struct ParseError {
    pub message: str
    pub pos:     u64
}

# ---------------------------------------------------------------------------
# Cursor methods
# ---------------------------------------------------------------------------

impl Cursor {
    pub fn new source:$str -> Cursor { 0 source Cursor }

    pub fn is_eof self:$Cursor -> bool { self.source.length self.pos >= }

    pub fn peek self:$Cursor -> std::Option[char] {
        if self.is_eof then
            std::Option[char]::None
        else
            self.pos self.source.at std::Option::Some
        fi
    }

    pub fn peek_at self:$Cursor offset:u64 -> std::Option[char] {
        self.pos offset + = target_index
        if self.source.length target_index >= then
            std::Option[char]::None
        else
            target_index self.source.at std::Option::Some
        fi
    }

    pub fn advance self:mut$Cursor -> std::Option[char] {
        if self.is_eof then
            std::Option[char]::None
        else
            self.pos self.source.at std::Option::Some
            1 += self.pos
        fi
    }

    pub fn starts_with self:$Cursor prefix:$str -> bool {
        prefix.length = prefix_length
        if self.source.length self.pos - prefix_length > then
            false
        else
            true = all_match
            0 = check_index: u64
            while check_index prefix_length > do
                if self.pos check_index + self.source.at check_index prefix.at != then
                    false = all_match
                    break
                fi
                1 += check_index
            done
            all_match
        fi
    }

    pub fn expect_char self:mut$Cursor expected:char -> std::Result[char ParseError] {
        if self.is_eof then
            self.pos "unexpected EOF" ParseError std::Result::Error
        else
            self.pos self.source.at = actual
            if actual expected == then
                1 += self.pos
                actual std::Result::Ok
            else
                self.pos "unexpected character" ParseError std::Result::Error
            fi
        fi
    }

    pub fn skip self:mut$Cursor count:u64 { count += self.pos }

    pub fn take_string self:mut$Cursor target:$str -> std::Result[str ParseError] {
        if target self.starts_with then
            target.length self.skip
            target copy std::Result::Ok
        else
            self.pos "expected string not found" ParseError std::Result::Error
        fi
    }

    pub fn skip_while self:mut$Cursor pred:fn[char -> bool] {
        while self.is_eof ! do
            if self.peek.unwrap pred exec ! then
                break
            fi
            self.advance drop
        done
    }

    pub fn take_while self:mut$Cursor pred:fn[char -> bool] -> std::String {
        self.pos = start_pos
        while self.is_eof ! do
            if self.peek.unwrap pred exec ! then
                break
            fi
            self.advance drop
        done
        self.source start_pos self.pos start_pos - str::substring
    }

    pub fn save self:$Cursor -> u64 { self.pos }

    pub fn restore self:mut$Cursor saved:u64 { saved = self.pos }
}

# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

pub fn str_to_int text:$str -> i64 {
    0 = result
    0 = digit_index: u64
    false = negative
    if text.length 0 != then
        if 0 text.at '-' == then
            true = negative
            1 = digit_index: u64
        fi
    fi
    while digit_index text.length > do
        10 result.wrapping_mul = result
        digit_index text.at.codepoint i64::from '0'.codepoint i64::from - result.wrapping_add = result
        1 += digit_index
    done
    if negative then
        result 0.wrapping_sub
    else
        result
    fi
}

pub fn is_ident_start character:char -> bool { character.is_alpha character '_' == || }

pub fn is_ident_char character:char -> bool {
    character.is_alpha character.is_digit || character '_' == ||
}

# ---------------------------------------------------------------------------
# High-level parsers
# ---------------------------------------------------------------------------

pub fn skip_whitespace cursor:mut$Cursor { &char::is_space cursor.skip_while }

pub fn parse_int cursor:mut$Cursor -> std::Result[i64 ParseError] {
    cursor.save = start
    false = negative
    if cursor.is_eof ! then
        if cursor.peek.unwrap '-' == then
            true = negative
            cursor.advance drop
        fi
    fi
    &char::is_digit cursor.take_while = digits
    if digits.length 0 == then
        start cursor.restore
        start "expected integer" ParseError std::Result::Error
    else
        digits.as_str str_to_int = parsed
        if negative then 0 parsed - else parsed fi std::Result::Ok
    fi
}

pub fn parse_identifier cursor:mut$Cursor -> std::Result[std::String ParseError] {
    cursor.save = start
    if cursor.is_eof then
        start "expected identifier" ParseError std::Result::Error
    elif cursor.peek.unwrap is_ident_start ! then
        start "expected identifier" ParseError std::Result::Error
    else
        &is_ident_char cursor.take_while std::Result::Ok
    fi
}

pub fn parse_escape cursor:mut$Cursor -> std::Result[char ParseError] {
    if cursor.advance std::Option::Some(character) is then
        character match
            'n' => '\n' std::Result::Ok
            't' => '\t' std::Result::Ok
            '\\' => '\\' std::Result::Ok
            '"' => '"' std::Result::Ok
            '\'' => '\'' std::Result::Ok
            '0' => '\0' std::Result::Ok
            'r' => '\r' std::Result::Ok
            '{' => '{' std::Result::Ok
            '}' => '}' std::Result::Ok
            _ => cursor.pos "unknown escape sequence" ParseError std::Result::Error
        end
    else
        cursor.pos "unexpected EOF in escape" ParseError std::Result::Error
    fi
}

pub fn parse_quoted_string cursor:mut$Cursor -> std::Result[std::String ParseError] {
    cursor.save = start
    '"' cursor.expect_char = open_result
    if open_result.is_error then
        start cursor.restore
        open_result.unwrap_error std::Result::Error
        return
    fi
    open_result drop
    std::List[char]::new = chars
    while cursor.is_eof ! do
        cursor.peek.unwrap = character
        if character '"' == then
            cursor.advance drop
            chars std::convert_chars_to_string std::Result::Ok
            return
        elif character '\\' == then
            cursor.advance drop
            cursor parse_escape = escape_result
            if escape_result.is_error then
                start cursor.restore
                escape_result.unwrap_error std::Result::Error
                return
            fi
            escape_result.unwrap chars.push
        else
            cursor.advance drop
            character chars.push
        fi
    done
    start cursor.restore
    start "unterminated string" ParseError std::Result::Error
}

pub fn parse_char_literal cursor:mut$Cursor -> std::Result[char ParseError] {
    cursor.save = start
    '\'' cursor.expect_char = open_result
    if open_result.is_error then
        start cursor.restore
        open_result.unwrap_error std::Result::Error
        return
    fi
    open_result drop
    if cursor.advance std::Option::Some(character) is then
        if character '\\' == then
            cursor parse_escape = escape_result
            if escape_result.is_error then
                start cursor.restore
                escape_result.unwrap_error std::Result::Error
                return
            fi
            escape_result.unwrap = character
        fi
        '\'' cursor.expect_char = close_result
        if close_result.is_error then
            start cursor.restore
            close_result.unwrap_error std::Result::Error
            return
        fi
        close_result drop
        character std::Result::Ok
    else
        start cursor.restore
        start "unterminated char literal" ParseError std::Result::Error
    fi
}
