import "std"

# ---------------------------------------------------------------------------
# I/O error handling
# ---------------------------------------------------------------------------

enum IoError {
    NotFound
    PermissionDenied
    AlreadyExists
    IsDirectory
    NotDirectory
    NotEmpty
    BadFd
    Other (i64)
}

fn errno_to_io_error syscall_result:i64 -> IoError {
    0 syscall_result - = errno
    if 2 errno == then
        IoError::NotFound return
    fi
    if 13 errno == then
        IoError::PermissionDenied return
    fi
    if 1 errno == then
        IoError::PermissionDenied return
    fi
    if 17 errno == then
        IoError::AlreadyExists return
    fi
    if 21 errno == then
        IoError::IsDirectory return
    fi
    if 20 errno == then
        IoError::NotDirectory return
    fi
    if 39 errno == then
        IoError::NotEmpty return
    fi
    if 9 errno == then
        IoError::BadFd return
    fi
    errno IoError::Other
}

impl IoError: Display {
    fn to_str self:$IoError -> String {
        self match
            IoError::NotFound => "not found".to_str
            IoError::PermissionDenied => "permission denied".to_str
            IoError::AlreadyExists => "already exists".to_str
            IoError::IsDirectory => "is a directory".to_str
            IoError::NotDirectory => "not a directory".to_str
            IoError::NotEmpty => "directory not empty".to_str
            IoError::BadFd => "bad file descriptor".to_str
            IoError::Other(errno) => f"errno {errno.to_str}"
        end
    }

    fn format self:$IoError -> String { self.to_str }
}

# ---------------------------------------------------------------------------
# File I/O constants
# ---------------------------------------------------------------------------
const O_RDONLY 0
const O_WRONLY 1
const O_CREAT 64
const O_TRUNC 512

# ---------------------------------------------------------------------------
# FileStat
# ---------------------------------------------------------------------------

struct FileStat {
    size:  u64
    mode:  i64
    mtime: i64
    atime: i64
    ctime: i64
}

impl FileStat {
    fn is_dir self:$FileStat -> bool { self.mode 61440 & 16384 == }

    fn is_file self:$FileStat -> bool { self.mode 61440 & 32768 == }

    fn is_symlink self:$FileStat -> bool { self.mode 61440 & 40960 == }

    fn is_readable self:$FileStat -> bool { self.mode 256 & 0 != }

    fn is_writable self:$FileStat -> bool { self.mode 128 & 0 != }

    fn is_executable self:$FileStat -> bool { self.mode 64 & 0 != }
}

# ---------------------------------------------------------------------------
# File I/O
# ---------------------------------------------------------------------------

impl file {
    fn open path:$str flags:i64 mode:i64 -> i64 {
        path.as_cstr = path_cstr
        if path_cstr.is_none then
            0 22 - return
        fi
        # SAFETY: as_cstr validated the path and keeps its storage live for the syscall.
        unsafe { mode flags path_cstr.unwrap (ptr) 2 syscall3 }
    }

    fn read fd:i64 buf:ptr size:u64 -> i64 {
        # SAFETY: The caller supplies a writable buffer of at least size bytes.
        unsafe { size buf fd 0 syscall3 }
    }

    fn write fd:i64 data:$str -> i64 {
        # SAFETY: The text view contains `length` readable bytes after its header.
        unsafe { data.length data (ptr) 8 + fd 1 syscall3 }
    }

    fn close fd:i64 -> i64 {
        # SAFETY: close accepts any file descriptor and reports invalid values as an error.
        unsafe { fd 3 syscall1 }
    }

    fn read_all path:$str -> Result[String IoError] {
        0 O_RDONLY path file::open = file_fd
        if 0 file_fd < then
            file_fd errno_to_io_error Result::Error return
        fi
        # SAFETY: file_fd is open and lseek does not dereference user memory.
        unsafe { 2 0 file_fd 8 syscall3 = file_size }
        # SAFETY: file_fd remains open and lseek does not dereference user memory.
        unsafe { 0 0 file_fd 8 syscall3 drop }
        file_size (u64) = size
        size String::with_capacity = result
        # SAFETY: result has size writable bytes and file_fd remains open.
        unsafe { file_size result.data (ptr) 8 + file_fd 0 syscall3 = bytes_read }
        if 0 bytes_read < then
            file_fd file::close drop
            bytes_read errno_to_io_error Result::Error return
        fi
        # SAFETY: read initialized bytes_read bytes within result's allocated capacity.
        unsafe {
            bytes_read (u64) result.data (ptr) store64
            0 result.data (ptr) 8 + bytes_read (u64) + store8
        }
        file_fd file::close drop
        result Result::Ok
    }

    fn write_all path:$str content:$str -> Result[bool IoError] {
        420 O_WRONLY O_CREAT | O_TRUNC | path file::open = file_fd
        if 0 file_fd < then
            file_fd errno_to_io_error Result::Error return
        fi
        content file_fd file::write = bytes_written
        if 0 bytes_written < then
            file_fd file::close drop
            bytes_written errno_to_io_error Result::Error return
        fi
        file_fd file::close drop
        true Result::Ok
    }

    fn remove path:$str -> Result[bool IoError] {
        path.as_cstr = path_cstr
        if path_cstr.is_none then
            22 IoError::Other Result::Error return
        fi
        # SAFETY: as_cstr validated the path and keeps its storage live for the syscall.
        unsafe { path_cstr.unwrap (ptr) 87 syscall1 = remove_result }
        if 0 remove_result < then
            remove_result errno_to_io_error Result::Error return
        fi
        true Result::Ok
    }

    fn exists path:$str -> bool {
        path.as_cstr = path_cstr
        if path_cstr.is_none then
            false return
        fi
        144 RawBuffer::new = stat_buf
        # SAFETY: stat_buf has the required size and path_cstr remains live.
        unsafe { stat_buf.data path_cstr.unwrap (ptr) 4 syscall2 = stat_result }
        0 stat_result >=
    }

    fn stat path:$str -> Result[FileStat IoError] {
        path.as_cstr = path_cstr
        if path_cstr.is_none then
            22 IoError::Other Result::Error return
        fi
        144 RawBuffer::new = stat_buf
        # SAFETY: stat_buf has the required size and path_cstr remains live.
        unsafe { stat_buf.data path_cstr.unwrap (ptr) 4 syscall2 = stat_result }
        if 0 stat_result < then
            stat_result errno_to_io_error Result::Error return
        fi
        # SAFETY: A successful stat initialized every field read from the 144-byte buffer.
        unsafe { stat_buf.data 48 + load64 (i64) = size }
        # SAFETY: A successful stat initialized every field read from the 144-byte buffer.
        unsafe { stat_buf.data 24 + load32 (i64) = mode }
        # SAFETY: A successful stat initialized every field read from the 144-byte buffer.
        unsafe { stat_buf.data 72 + load64 (i64) = atime }
        # SAFETY: A successful stat initialized every field read from the 144-byte buffer.
        unsafe { stat_buf.data 88 + load64 (i64) = mtime }
        # SAFETY: A successful stat initialized every field read from the 144-byte buffer.
        unsafe { stat_buf.data 104 + load64 (i64) = ctime }
        FileStat { size: size (u64) mode: mode mtime: mtime atime: atime ctime: ctime } Result::Ok
    }
}

# ---------------------------------------------------------------------------
# Directory operations
# ---------------------------------------------------------------------------

impl dir {
    fn list path:$str -> Result[List[String] IoError] {
        path.as_cstr = path_cstr
        if path_cstr.is_none then
            22 IoError::Other Result::Error return
        fi
        # SAFETY: as_cstr validated the path and keeps its storage live for the syscall.
        unsafe { 0 65536 path_cstr.unwrap (ptr) 2 syscall3 = dir_fd }
        if 0 dir_fd < then
            dir_fd errno_to_io_error Result::Error return
        fi
        List[String]::new = entries
        1024 RawBuffer::new = buf
        true = reading
        while reading do
            # SAFETY: buf has 1024 writable bytes and dir_fd remains open.
            unsafe { 1024 buf.data dir_fd 217 syscall3 = nread }
            if 0 nread < then
                # SAFETY: dir_fd is an open descriptor owned by this function.
                unsafe { dir_fd 3 syscall1 drop }
                nread errno_to_io_error Result::Error return
            fi
            if 0 nread == then
                false = reading
            else
                0 = pos
                while pos nread > do
                    # SAFETY: pos identifies an entry within the initialized getdents buffer.
                    unsafe { buf.data pos (u64) + = entry_ptr }
                    # SAFETY: Linux dirent records store reclen at byte offset 16.
                    unsafe { entry_ptr 16 + load16 = rec_len }
                    # SAFETY: Linux dirent records store the NUL-terminated name at byte offset 19.
                    unsafe { entry_ptr 19 + = name_ptr }
                    # SAFETY: getdents returned a complete record with a NUL-terminated name.
                    unsafe { name_ptr (ptr) str::from_cstr = name }
                    if "." name.as_str str::eq ! ".." name.as_str str::eq ! && then
                        name entries.push
                    fi
                    rec_len (i64) += pos
                done
            fi
        done
        # SAFETY: dir_fd is an open descriptor owned by this function.
        unsafe { dir_fd 3 syscall1 drop }
        entries Result::Ok
    }

    fn create path:$str mode:i64 -> Result[bool IoError] {
        path.as_cstr = path_cstr
        if path_cstr.is_none then
            22 IoError::Other Result::Error return
        fi
        # SAFETY: as_cstr validated the path and keeps its storage live for the syscall.
        unsafe { mode path_cstr.unwrap (ptr) 83 syscall2 = result }
        if 0 result < then
            result errno_to_io_error Result::Error return
        fi
        true Result::Ok
    }

    fn remove path:$str -> Result[bool IoError] {
        path.as_cstr = path_cstr
        if path_cstr.is_none then
            22 IoError::Other Result::Error return
        fi
        # SAFETY: as_cstr validated the path and keeps its storage live for the syscall.
        unsafe { path_cstr.unwrap (ptr) 84 syscall1 = result }
        if 0 result < then
            result errno_to_io_error Result::Error return
        fi
        true Result::Ok
    }

    fn exists path:$str -> bool {
        path.as_cstr = path_cstr
        if path_cstr.is_none then
            false return
        fi
        144 RawBuffer::new = stat_buf
        # SAFETY: stat_buf has the required size and path_cstr remains live.
        unsafe { stat_buf.data path_cstr.unwrap (ptr) 4 syscall2 = stat_result }
        if 0 stat_result < then
            false return
        fi
        # SAFETY: A successful stat initialized the mode field at byte offset 24.
        unsafe { stat_buf.data 24 + load32 61440 & 16384 == }
    }

    fn current -> Result[String IoError] {
        4096 RawBuffer::new = buf
        # SAFETY: buf has 4096 writable bytes for getcwd.
        unsafe { 4096 buf.data 79 syscall2 = result }
        if 0 result < then
            result errno_to_io_error Result::Error return
        fi
        # SAFETY: A successful getcwd writes a NUL-terminated path into buf.
        unsafe { buf.data str::from_cstr Result::Ok }
    }

    fn change path:$str -> Result[bool IoError] {
        path.as_cstr = path_cstr
        if path_cstr.is_none then
            22 IoError::Other Result::Error return
        fi
        # SAFETY: as_cstr validated the path and keeps its storage live for the syscall.
        unsafe { path_cstr.unwrap (ptr) 80 syscall1 = result }
        if 0 result < then
            result errno_to_io_error Result::Error return
        fi
        true Result::Ok
    }
}

# ---------------------------------------------------------------------------
# Environment variables
# ---------------------------------------------------------------------------

impl env {
    fn get name:$str -> Option[String] {
        envp = env_ptr
        0 = offset
        unsafe { env_ptr offset (u64) + load64 = entry }
        while 0 entry (i64) != do
            unsafe { entry (ptr) str::from_cstr = entry_str }
            name "=" str::concat = prefix
            if entry_str.as_str prefix.as_str str::starts_with then
                name.length 1 + = val_start
                entry_str.length val_start - = val_len
                entry_str.as_str val_start val_len str::substring Option::Some return
            fi
            8 += offset
            unsafe { env_ptr offset (u64) + load64 = entry }
        done
        Option::None
    }
}

# ---------------------------------------------------------------------------
# Path utilities
# ---------------------------------------------------------------------------

impl path {
    fn join b:$str a:$str -> String {
        if 0 a.length == then
            b.to_str return
        fi
        if 0 b.length == then
            a.to_str return
        fi
        a.length 1 - a.at = a_last
        0 b.at = b_first
        if '/' a_last == '/' b_first == && then
            a.length b.length + 1 - String::with_capacity = result
            a result.append
            b 1 b.length 1 - str::substring = suffix
            suffix.as_str result.append
            result return
        fi
        if '/' a_last == '/' b_first == || then
            a b str::concat return
        fi
        a "/" str::concat = prefix
        prefix.as_str b str::concat
    }

    fn dirname p:$str -> String {
        if 0 p.length == then
            ".".to_str return
        fi
        p.length = len
        if 1 len > '/' len 1 - p.at == && then
            1 -= len
        fi
        len = i
        while 0 i != do
            1 -= i
            if '/' i p.at == then
                if 0 i == then
                    "/".to_str return
                fi
                p 0 i str::substring return
            fi
        done
        ".".to_str
    }

    fn basename p:$str -> String {
        if 0 p.length == then
            String::new return
        fi
        p.length = len
        if 1 len > '/' len 1 - p.at == && then
            1 -= len
        fi
        len = i
        while 0 i != do
            1 -= i
            if '/' i p.at == then
                p i 1 + len i - 1 - str::substring return
            fi
        done
        p 0 len str::substring
    }

    fn extension p:$str -> String {
        p path::basename = base
        base.length = i
        while 0 i > do
            1 -= i
            if '.' i base.at == then
                base.as_str i 1 + base.length i - 1 - str::substring return
            fi
        done
        String::new
    }
}
