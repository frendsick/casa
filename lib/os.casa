import "std" as std

# ---------------------------------------------------------------------------
# I/O error handling
# ---------------------------------------------------------------------------

pub enum IoError {
    NotFound
    PermissionDenied
    AlreadyExists
    IsDirectory
    NotDirectory
    NotEmpty
    BadFd
    Other (i64)
}

pub fn errno_to_io_error syscall_result:i64 -> IoError {
    0 syscall_result - = errno
    if 2 errno == then
        IoError::NotFound return
    fi
    if 13 errno == then
        IoError::PermissionDenied return
    fi
    if 1 errno == then
        IoError::PermissionDenied return
    fi
    if 17 errno == then
        IoError::AlreadyExists return
    fi
    if 21 errno == then
        IoError::IsDirectory return
    fi
    if 20 errno == then
        IoError::NotDirectory return
    fi
    if 39 errno == then
        IoError::NotEmpty return
    fi
    if 9 errno == then
        IoError::BadFd return
    fi
    errno IoError::Other
}

impl IoError: std::Display {
    pub fn to_str self:$IoError -> std::String {
        self match
            IoError::NotFound => "not found".to_str
            IoError::PermissionDenied => "permission denied".to_str
            IoError::AlreadyExists => "already exists".to_str
            IoError::IsDirectory => "is a directory".to_str
            IoError::NotDirectory => "not a directory".to_str
            IoError::NotEmpty => "directory not empty".to_str
            IoError::BadFd => "bad file descriptor".to_str
            IoError::Other(errno) => f"errno {errno.to_str}"
        end
    }

    pub fn format self:$IoError -> std::String { self.to_str }
}

# ---------------------------------------------------------------------------
# File I/O constants
# ---------------------------------------------------------------------------
pub const O_RDONLY 0
pub const O_WRONLY 1
pub const O_CREAT 64
pub const O_TRUNC 512

# ---------------------------------------------------------------------------
# FileStat
# ---------------------------------------------------------------------------

pub struct FileStat {
    pub size:  u64
    pub mode:  i64
    pub mtime: i64
    pub atime: i64
    pub ctime: i64
}

impl FileStat {
    pub fn is_dir self:$FileStat -> bool { self.mode 61440 & 16384 == }

    pub fn is_file self:$FileStat -> bool { self.mode 61440 & 32768 == }

    pub fn is_symlink self:$FileStat -> bool { self.mode 61440 & 40960 == }

    pub fn is_readable self:$FileStat -> bool { self.mode 256 & 0 != }

    pub fn is_writable self:$FileStat -> bool { self.mode 128 & 0 != }

    pub fn is_executable self:$FileStat -> bool { self.mode 64 & 0 != }
}

# ---------------------------------------------------------------------------
# File I/O
# ---------------------------------------------------------------------------

impl file {
    pub fn open path:$cstr flags:i64 mode:i64 -> i64 {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { mode flags path ptr::from_ref 2 syscall3 }
    }

    pub fn read fd:i64 buf:ptr size:u64 -> i64 {
        # SAFETY: The caller supplies a writable buffer of at least size bytes.
        unsafe { size buf fd 0 syscall3 }
    }

    pub fn write fd:i64 data:$std::Bytes -> i64 {
        data.length std::RawBuffer::new = buffer
        0 = index: u64
        while index data.length > do
            # SAFETY: index is within both the source Bytes and destination buffer.
            unsafe { index data.get.unwrap buffer.data index + store8 }
            1 += index
        done
        # SAFETY: buffer contains data.length initialized bytes.
        unsafe { data.length buffer.data fd 1 syscall3 }
    }

    pub fn close fd:i64 -> i64 {
        # SAFETY: close accepts any file descriptor and reports invalid values as an error.
        unsafe { fd 3 syscall1 }
    }

    pub fn read_all path:$cstr -> std::Result[std::Bytes IoError] {
        0 O_RDONLY path file::open = file_fd
        if 0 file_fd < then
            file_fd errno_to_io_error std::Result::Error return
        fi
        # SAFETY: file_fd is open and lseek does not dereference user memory.
        unsafe { 2 0 file_fd 8 syscall3 = file_size }
        if 0 file_size < then
            file_fd file::close drop
            file_size errno_to_io_error std::Result::Error return
        fi
        # SAFETY: file_fd remains open and lseek does not dereference user memory.
        unsafe { 0 0 file_fd 8 syscall3 drop }
        file_size u64::try_from.unwrap = size
        std::Bytes::new = result
        if 0 size != then
            size std::RawBuffer::new = read_buffer
            0 = total_read: u64
            while total_read size > do
                # SAFETY: total_read and size keep the destination inside read_buffer.
                unsafe { size total_read - read_buffer.data total_read + file_fd 0 syscall3 = bytes_read }
                if 0 bytes_read < then
                    file_fd file::close drop
                    bytes_read errno_to_io_error std::Result::Error return
                fi
                if 0 bytes_read == then
                    break
                fi
                bytes_read u64::try_from.unwrap += total_read
            done
            0 = index: u64
            while index total_read > do
                # SAFETY: read initialized total_read bytes in read_buffer.
                unsafe { read_buffer.data index + load8 } result.push
                1 += index
            done
        fi
        file_fd file::close drop
        result std::Result::Ok
    }

    pub fn write_all path:$cstr content:$std::Bytes -> std::Result[bool IoError] {
        420 O_WRONLY O_CREAT | O_TRUNC | path file::open = file_fd
        if 0 file_fd < then
            file_fd errno_to_io_error std::Result::Error return
        fi
        content file_fd file::write = bytes_written
        if 0 bytes_written < then
            file_fd file::close drop
            bytes_written errno_to_io_error std::Result::Error return
        fi
        file_fd file::close drop
        true std::Result::Ok
    }

    pub fn remove path:$cstr -> std::Result[bool IoError] {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { path ptr::from_ref 87 syscall1 = remove_result }
        if 0 remove_result < then
            remove_result errno_to_io_error std::Result::Error return
        fi
        true std::Result::Ok
    }

    pub fn exists path:$cstr -> bool {
        144 std::RawBuffer::new = stat_buf
        # SAFETY: stat_buf has the required size and path remains live.
        unsafe { stat_buf.data path ptr::from_ref 4 syscall2 = stat_result }
        0 stat_result >=
    }

    pub fn stat path:$cstr -> std::Result[FileStat IoError] {
        144 std::RawBuffer::new = stat_buf
        # SAFETY: stat_buf has the required size and path remains live.
        unsafe { stat_buf.data path ptr::from_ref 4 syscall2 = stat_result }
        if 0 stat_result < then
            stat_result errno_to_io_error std::Result::Error return
        fi
        # SAFETY: A successful stat initialized every field read from the 144-byte buffer.
        unsafe {
            stat_buf.data 48 + load64 i64::wrapping_from = size
            stat_buf.data 24 + load32 i64::from = mode
            stat_buf.data 72 + load64 i64::wrapping_from = atime
            stat_buf.data 88 + load64 i64::wrapping_from = mtime
            stat_buf.data 104 + load64 i64::wrapping_from = ctime
        }
        FileStat { size: size u64::try_from.unwrap mode: mode mtime: mtime atime: atime ctime: ctime } std::Result::Ok
    }
}

# ---------------------------------------------------------------------------
# Directory operations
# ---------------------------------------------------------------------------

impl dir {
    fn is_dot_entry name:$std::Bytes -> bool {
        if 1 name.length == then
            46 0 name.get.unwrap == return
        fi
        if 2 name.length == then
            46 0 name.get.unwrap == 46 1 name.get.unwrap == && return
        fi
        false
    }

    pub fn list path:$cstr -> std::Result[std::List[std::Bytes] IoError] {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { 0 65536 path ptr::from_ref 2 syscall3 = dir_fd }
        if 0 dir_fd < then
            dir_fd errno_to_io_error std::Result::Error return
        fi
        std::List[std::Bytes]::new = entries
        1024 std::RawBuffer::new = buf
        true = reading
        while reading do
            # SAFETY: buf has 1024 writable bytes and dir_fd remains open.
            unsafe { 1024 buf.data dir_fd 217 syscall3 = nread }
            if 0 nread < then
                # SAFETY: dir_fd is an open descriptor owned by this function.
                unsafe { dir_fd 3 syscall1 drop }
                nread errno_to_io_error std::Result::Error return
            fi
            if 0 nread == then
                false = reading
            else
                0 = pos
                while pos nread > do
                    # SAFETY: pos identifies an entry within the initialized getdents buffer.
                    # Linux dirent64 stores reclen at byte offset 16 and NUL-terminated name at 19.
                    unsafe {
                        buf.data pos u64::try_from.unwrap + = entry_ptr
                        entry_ptr 16 + load16 = rec_len
                        entry_ptr 19 + ptr::as_ref[cstr] cstr::to_bytes = name
                    }
                    if name dir::is_dot_entry ! then
                        name entries.push
                    fi
                    rec_len i64::from += pos
                done
            fi
        done
        # SAFETY: dir_fd is an open descriptor owned by this function.
        unsafe { dir_fd 3 syscall1 drop }
        entries std::Result::Ok
    }

    pub fn create path:$cstr mode:i64 -> std::Result[bool IoError] {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { mode path ptr::from_ref 83 syscall2 = result }
        if 0 result < then
            result errno_to_io_error std::Result::Error return
        fi
        true std::Result::Ok
    }

    pub fn remove path:$cstr -> std::Result[bool IoError] {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { path ptr::from_ref 84 syscall1 = result }
        if 0 result < then
            result errno_to_io_error std::Result::Error return
        fi
        true std::Result::Ok
    }

    pub fn exists path:$cstr -> bool {
        144 std::RawBuffer::new = stat_buf
        # SAFETY: stat_buf has the required size and path remains live.
        unsafe { stat_buf.data path ptr::from_ref 4 syscall2 = stat_result }
        if 0 stat_result < then
            false return
        fi
        # SAFETY: A successful stat initialized the mode field at byte offset 24.
        unsafe { stat_buf.data 24 + load32 61440 & 16384 == }
    }

    pub fn current -> std::Result[std::Bytes IoError] {
        4096 std::RawBuffer::new = buf
        # SAFETY: buf has 4096 writable bytes for getcwd.
        unsafe { 4096 buf.data 79 syscall2 = result }
        if 0 result < then
            result errno_to_io_error std::Result::Error return
        fi
        # SAFETY: A successful getcwd writes a NUL-terminated path into buf.
        unsafe { buf.data ptr::as_ref[cstr] }.to_bytes std::Result::Ok
    }

    pub fn change path:$cstr -> std::Result[bool IoError] {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { path ptr::from_ref 80 syscall1 = result }
        if 0 result < then
            result errno_to_io_error std::Result::Error return
        fi
        true std::Result::Ok
    }
}

# ---------------------------------------------------------------------------
# Environment variables
# ---------------------------------------------------------------------------

impl env {
    unsafe fn value_from_entry entry:ptr name:$str -> std::Option[std::Bytes] {
        0 = index: u64
        while index name.length > do
            unsafe { entry index + load8 = entry_byte }
            if 0 entry_byte == index name.at.codepoint u8::try_from.unwrap entry_byte != || then
                std::Option[std::Bytes]::None return
            fi
            1 += index
        done
        unsafe { entry index + load8 = delimiter }
        if '='.codepoint u8::try_from.unwrap delimiter != then
            std::Option[std::Bytes]::None return
        fi
        unsafe { entry index 1 + + ptr::as_ref[cstr] }.to_bytes std::Option::Some
    }

    pub fn get name:$str -> std::Option[std::Bytes] {
        envp = env_ptr
        0 = offset: u64
        # SAFETY: envp is a process-provided array of 8-byte-aligned pointers; offset steps in 8-byte increments within it.
        unsafe { env_ptr offset + ptr::as_ref[ptr] copy = entry }
        while ptr::null entry != do
            # SAFETY: a non-null envp entry points to a NUL-terminated environment entry.
            unsafe { name entry env::value_from_entry } = value
            if value.is_some then
                value return
            fi
            8 += offset
            # SAFETY: envp is a process-provided array of 8-byte-aligned pointers; offset steps in 8-byte increments within it.
            unsafe { env_ptr offset + ptr::as_ref[ptr] copy = entry }
        done
        std::Option::None
    }
}

# ---------------------------------------------------------------------------
# Path utilities
# ---------------------------------------------------------------------------

impl path {
    pub fn join b:$str a:$str -> std::String {
        if 0 a.length == then
            b.to_str return
        fi
        if 0 b.length == then
            a.to_str return
        fi
        a.length 1 - a.at = a_last
        0 b.at = b_first
        if '/' a_last == '/' b_first == && then
            a.length b.length + 1 - std::String::with_capacity = result
            a result.append
            b 1 b.length 1 - str::substring = suffix
            suffix.as_str result.append
            result return
        fi
        if '/' a_last == '/' b_first == || then
            a b str::concat return
        fi
        a "/" str::concat = prefix
        prefix.as_str b str::concat
    }

    pub fn dirname p:$str -> std::String {
        if 0 p.length == then
            ".".to_str return
        fi
        p.length = len
        if 1 len > '/' len 1 - p.at == && then
            1 -= len
        fi
        len = i
        while 0 i != do
            1 -= i
            if '/' i p.at == then
                if 0 i == then
                    "/".to_str return
                fi
                p 0 i str::substring return
            fi
        done
        ".".to_str
    }

    pub fn basename p:$str -> std::String {
        if 0 p.length == then
            std::String::new return
        fi
        p.length = len
        if 1 len > '/' len 1 - p.at == && then
            1 -= len
        fi
        len = i
        while 0 i != do
            1 -= i
            if '/' i p.at == then
                p i 1 + len i - 1 - str::substring return
            fi
        done
        p 0 len str::substring
    }

    pub fn extension p:$str -> std::String {
        p path::basename = base
        base.length = i
        while 0 i > do
            1 -= i
            if '.' i base.at == then
                base.as_str i 1 + base.length i - 1 - str::substring return
            fi
        done
        std::String::new
    }
}
