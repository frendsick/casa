import "std" as std

# Linux x86-64 system call numbers
const SYS_READ 0
const SYS_WRITE 1
const SYS_OPEN 2
const SYS_CLOSE 3
const SYS_STAT 4
const SYS_GETCWD 79
const SYS_CHDIR 80
const SYS_MKDIR 83
const SYS_RMDIR 84
const SYS_UNLINK 87
const SYS_GETDENTS64 217

# I/O error handling
const EPERM 1
const ENOENT 2
const EIO 5
const EBADF 9
const EACCES 13
const EEXIST 17
const ENOTDIR 20
const EISDIR 21
pub const EINVAL 22
const ENOTEMPTY 39

pub enum IoError {
    NotFound
    PermissionDenied
    AlreadyExists
    IsDirectory
    NotDirectory
    NotEmpty
    BadFd
    Other(i64)
}

pub fn errno_to_io_error syscall_result:i64 -> IoError {
    0 syscall_result - = errno
    if ENOENT errno == then
        IoError::NotFound return
    fi
    if EACCES errno == then
        IoError::PermissionDenied return
    fi
    if EPERM errno == then
        IoError::PermissionDenied return
    fi
    if EEXIST errno == then
        IoError::AlreadyExists return
    fi
    if EISDIR errno == then
        IoError::IsDirectory return
    fi
    if ENOTDIR errno == then
        IoError::NotDirectory return
    fi
    if ENOTEMPTY errno == then
        IoError::NotEmpty return
    fi
    if EBADF errno == then
        IoError::BadFd return
    fi
    errno IoError::Other
}

impl IoError: std::Display {
    pub fn to_str self:$IoError -> std::String {
        self match
            IoError::NotFound => "not found".to_str
            IoError::PermissionDenied => "permission denied".to_str
            IoError::AlreadyExists => "already exists".to_str
            IoError::IsDirectory => "is a directory".to_str
            IoError::NotDirectory => "not a directory".to_str
            IoError::NotEmpty => "directory not empty".to_str
            IoError::BadFd => "bad file descriptor".to_str
            IoError::Other(errno) => f"errno {errno.to_str}"
        end
    }

    pub fn format self:$IoError -> std::String { self.to_str }
}

# File I/O constants
pub const O_RDONLY 0
pub const O_WRONLY 0x01
pub const O_CREAT 0x40
pub const O_TRUNC 0x200
const O_DIRECTORY 0x10000
const READ_CHUNK_SIZE 65536
const WRITE_CHUNK_SIZE 65536

# File type and owner permission bits of FileStat.mode
const S_IFMT 0xF000
const S_IFDIR 0x4000
const S_IFREG 0x8000
const S_IFLNK 0xA000
const S_IRUSR 0x100
const S_IWUSR 0x80
const S_IXUSR 0x40

# Layout of the Linux x86-64 stat buffer
const STAT_BUFFER_SIZE 144
const STAT_MODE_OFFSET 24
const STAT_SIZE_OFFSET 48
const STAT_ATIME_OFFSET 72
const STAT_MTIME_OFFSET 88
const STAT_CTIME_OFFSET 104

# Layout of a Linux dirent64 record
const DIRENT_BUFFER_SIZE 1024
const DIRENT_RECORD_LENGTH_OFFSET 16
const DIRENT_NAME_OFFSET 19
const CURRENT_DIRECTORY_BUFFER_SIZE 4096
const DOT_BYTE: u8 46

pub struct FileStat {
    pub size:  u64
    pub mode:  i64
    pub mtime: i64
    pub atime: i64
    pub ctime: i64
}

impl FileStat {
    pub fn is_dir self:$FileStat -> bool { self.mode S_IFMT & S_IFDIR == }

    pub fn is_file self:$FileStat -> bool { self.mode S_IFMT & S_IFREG == }

    pub fn is_symlink self:$FileStat -> bool { self.mode S_IFMT & S_IFLNK == }

    pub fn is_readable self:$FileStat -> bool { self.mode S_IRUSR & 0 != }

    pub fn is_writable self:$FileStat -> bool { self.mode S_IWUSR & 0 != }

    pub fn is_executable self:$FileStat -> bool { self.mode S_IXUSR & 0 != }
}

# File I/O
impl file {
    pub fn open path:$cstr flags:i64 mode:i64 -> i64 {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { mode flags path ptr::from_ref SYS_OPEN syscall3 }
    }

    # SAFETY: buf points to size writable bytes with exclusive access for the call.
    pub unsafe fn read fd:i64 buf:ptr size:u64 -> i64 {
        # SAFETY: The caller supplies a writable buffer of at least size bytes.
        unsafe { size buf fd SYS_READ syscall3 }
    }

    # SAFETY: data points to size initialized bytes that remain readable for the call.
    unsafe fn write_buffer fd:i64 data:ptr size:u64 -> i64 {
        # SAFETY: The caller supplies size initialized bytes at data.
        unsafe { size data fd SYS_WRITE syscall3 }
    }

    pub fn write fd:i64 data:$std::Bytes -> i64 {
        data.to_raw_buffer = buffer
        # SAFETY: to_raw_buffer copied data.length initialized bytes into buffer.
        unsafe { data.length buffer.data fd file::write_buffer }
    }

    pub fn close fd:i64 -> i64 {
        # SAFETY: close accepts any file descriptor and reports invalid values as an error.
        unsafe { fd SYS_CLOSE syscall1 }
    }

    pub fn read_all path:$cstr -> std::Result[std::Bytes IoError] {
        0 O_RDONLY path file::open = file_fd
        if 0 file_fd > then
            file_fd errno_to_io_error std::Result::Error return
        fi
        std::Bytes::new = result
        READ_CHUNK_SIZE = chunk_size: u64
        chunk_size std::RawBuffer::new = read_buffer
        while true do
            # SAFETY: read_buffer owns chunk_size writable bytes for the call.
            unsafe { chunk_size read_buffer.data file_fd file::read = bytes_read }
            if 0 bytes_read > then
                file_fd file::close drop
                bytes_read errno_to_io_error std::Result::Error return
            fi
            if 0 bytes_read == then
                break
            fi
            bytes_read u64::try_from.unwrap = initialized_size
            0 = index: u64
            while index initialized_size < do
                # SAFETY: read initialized initialized_size bytes in read_buffer.
                unsafe { read_buffer.data index + load8 } result.push
                1 += index
            done
        done
        file_fd file::close drop
        result std::Result::Ok
    }

    pub fn write_all path:$cstr content:$std::Bytes -> std::Result[std::Unit IoError] {
        420 O_WRONLY O_CREAT | O_TRUNC | path file::open = file_fd
        if 0 file_fd > then
            file_fd errno_to_io_error std::Result::Error return
        fi
        content.to_raw_buffer = buffer
        # SAFETY: buffer owns content.length initialized bytes throughout the write.
        unsafe { content.length buffer.data file_fd file::write_all_buffer }
    }

    pub fn write_text path:$cstr content:$str -> std::Result[std::Unit IoError] {
        420 O_WRONLY O_CREAT | O_TRUNC | path file::open = file_fd
        if 0 file_fd > then
            file_fd errno_to_io_error std::Result::Error return
        fi
        # SAFETY: str stores its initialized UTF-8 bytes after its eight-byte length
        # header. The shared content borrow keeps them readable throughout the write.
        unsafe { content.length content ptr::from_ref 8 + file_fd file::write_all_buffer }
    }

    # Closes fd on success or write error. Callers transfer descriptor ownership.
    # SAFETY: data points to size initialized bytes that remain readable for the call.
    unsafe fn write_all_buffer file_fd:i64 data:ptr size:u64 -> std::Result[std::Unit IoError] {
        0 = total_written: u64
        WRITE_CHUNK_SIZE = max_chunk_size: u64
        while total_written size < do
            size total_written - = chunk_size
            if chunk_size max_chunk_size > then
                max_chunk_size = chunk_size
            fi
            # SAFETY: total_written remains within the caller's initialized bytes.
            unsafe { data total_written + } = chunk_data
            # SAFETY: chunk_size is bounded by the initialized bytes remaining at data.
            unsafe { chunk_size chunk_data file_fd file::write_buffer = bytes_written }
            if 0 bytes_written > then
                file_fd file::close drop
                bytes_written errno_to_io_error std::Result::Error return
            fi
            if 0 bytes_written == then
                file_fd file::close drop
                EIO IoError::Other std::Result::Error return
            fi
            bytes_written u64::try_from.unwrap += total_written
        done
        file_fd file::close drop
        std::Unit::Value std::Result::Ok
    }

    pub fn remove path:$cstr -> std::Result[std::Unit IoError] {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { path ptr::from_ref SYS_UNLINK syscall1 = remove_result }
        if 0 remove_result > then
            remove_result errno_to_io_error std::Result::Error return
        fi
        std::Unit::Value std::Result::Ok
    }

    pub fn exists path:$cstr -> bool {
        STAT_BUFFER_SIZE std::RawBuffer::new = stat_buf
        # SAFETY: stat_buf has the required size and path remains live.
        unsafe { stat_buf.data path ptr::from_ref SYS_STAT syscall2 = stat_result }
        0 stat_result <=
    }

    pub fn stat path:$cstr -> std::Result[FileStat IoError] {
        STAT_BUFFER_SIZE std::RawBuffer::new = stat_buf
        # SAFETY: stat_buf has the required size and path remains live.
        unsafe { stat_buf.data path ptr::from_ref SYS_STAT syscall2 = stat_result }
        if 0 stat_result > then
            stat_result errno_to_io_error std::Result::Error return
        fi
        # SAFETY: A successful stat initialized every field read from the buffer.
        unsafe {
            stat_buf.data STAT_SIZE_OFFSET + load64 i64::wrapping_from = size
            stat_buf.data STAT_MODE_OFFSET + load32 i64::from = mode
            stat_buf.data STAT_ATIME_OFFSET + load64 i64::wrapping_from = atime
            stat_buf.data STAT_MTIME_OFFSET + load64 i64::wrapping_from = mtime
            stat_buf.data STAT_CTIME_OFFSET + load64 i64::wrapping_from = ctime
        }
        FileStat { size: size u64::try_from.unwrap mode: mode mtime: mtime atime: atime ctime: ctime } std::Result::Ok
    }
}

# Directory operations
impl dir {
    fn is_dot_entry name:$std::Bytes -> bool {
        if 1 name.length == then
            DOT_BYTE 0 name.get.unwrap == return
        fi
        if 2 name.length == then
            DOT_BYTE 0 name.get.unwrap == DOT_BYTE 1 name.get.unwrap == && return
        fi
        false
    }

    pub fn list path:$cstr -> std::Result[std::List[std::Bytes] IoError] {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { 0 O_DIRECTORY path ptr::from_ref SYS_OPEN syscall3 = dir_fd }
        if 0 dir_fd > then
            dir_fd errno_to_io_error std::Result::Error return
        fi
        std::List[std::Bytes]::new = entries
        DIRENT_BUFFER_SIZE std::RawBuffer::new = buf
        true = reading
        while reading do
            # SAFETY: buf has DIRENT_BUFFER_SIZE writable bytes and dir_fd remains open.
            unsafe { DIRENT_BUFFER_SIZE buf.data dir_fd SYS_GETDENTS64 syscall3 = nread }
            if 0 nread > then
                # SAFETY: dir_fd is an open descriptor owned by this function.
                unsafe { dir_fd SYS_CLOSE syscall1 drop }
                nread errno_to_io_error std::Result::Error return
            fi
            if 0 nread == then
                false = reading
            else
                0 = pos
                while pos nread < do
                    # SAFETY: pos identifies an entry within the initialized getdents buffer.
                    # Linux dirent64 stores the record length and a NUL-terminated name.
                    unsafe {
                        buf.data pos u64::try_from.unwrap + = entry_ptr
                        entry_ptr DIRENT_RECORD_LENGTH_OFFSET + load16 = rec_len
                        entry_ptr DIRENT_NAME_OFFSET + ptr::as_ref[cstr] cstr::to_bytes = name
                    }
                    if name dir::is_dot_entry ! then
                        name entries.push
                    fi
                    rec_len i64::from += pos
                done
            fi
        done
        # SAFETY: dir_fd is an open descriptor owned by this function.
        unsafe { dir_fd SYS_CLOSE syscall1 drop }
        entries std::Result::Ok
    }

    pub fn create path:$cstr mode:i64 -> std::Result[std::Unit IoError] {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { mode path ptr::from_ref SYS_MKDIR syscall2 = result }
        if 0 result > then
            result errno_to_io_error std::Result::Error return
        fi
        std::Unit::Value std::Result::Ok
    }

    pub fn remove path:$cstr -> std::Result[std::Unit IoError] {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { path ptr::from_ref SYS_RMDIR syscall1 = result }
        if 0 result > then
            result errno_to_io_error std::Result::Error return
        fi
        std::Unit::Value std::Result::Ok
    }

    pub fn exists path:$cstr -> bool {
        STAT_BUFFER_SIZE std::RawBuffer::new = stat_buf
        # SAFETY: stat_buf has the required size and path remains live.
        unsafe { stat_buf.data path ptr::from_ref SYS_STAT syscall2 = stat_result }
        if 0 stat_result > then
            false return
        fi
        # SAFETY: A successful stat initialized the mode field.
        unsafe { stat_buf.data STAT_MODE_OFFSET + load32 S_IFMT & S_IFDIR == }
    }

    pub fn current -> std::Result[std::Bytes IoError] {
        CURRENT_DIRECTORY_BUFFER_SIZE std::RawBuffer::new = buf
        # SAFETY: buf has CURRENT_DIRECTORY_BUFFER_SIZE writable bytes for getcwd.
        unsafe { CURRENT_DIRECTORY_BUFFER_SIZE buf.data SYS_GETCWD syscall2 = result }
        if 0 result > then
            result errno_to_io_error std::Result::Error return
        fi
        # SAFETY: A successful getcwd writes a NUL-terminated path into buf.
        unsafe { buf.data ptr::as_ref[cstr] }.to_bytes std::Result::Ok
    }

    pub fn change path:$cstr -> std::Result[std::Unit IoError] {
        # SAFETY: path is a borrowed NUL-terminated byte string that remains live for the syscall.
        unsafe { path ptr::from_ref SYS_CHDIR syscall1 = result }
        if 0 result > then
            result errno_to_io_error std::Result::Error return
        fi
        std::Unit::Value std::Result::Ok
    }
}

# Environment variables
impl env {
    unsafe fn value_from_entry entry:ptr name:$str -> std::Option[std::Bytes] {
        0 = index: u64
        while index name.length < do
            unsafe { entry index + load8 = entry_byte }
            if
                0 entry_byte == index name
                    .at
                    .unwrap
                    .codepoint u8::try_from.unwrap entry_byte != ||
            then
                std::Option[std::Bytes]::None return
            fi
            1 += index
        done
        unsafe { entry index + load8 = delimiter }
        if '='.codepoint u8::try_from.unwrap delimiter != then
            std::Option[std::Bytes]::None return
        fi
        unsafe { entry index 1 + + ptr::as_ref[cstr] }.to_bytes std::Option::Some
    }

    pub fn get name:$str -> std::Option[std::Bytes] {
        envp = env_ptr
        0 = offset: u64
        # SAFETY: envp is a process-provided array of 8-byte-aligned pointers; offset steps in 8-byte increments within it.
        unsafe { env_ptr offset + ptr::as_ref[ptr] copy = entry }
        while ptr::null entry != do
            # SAFETY: a non-null envp entry points to a NUL-terminated environment entry.
            unsafe { name entry env::value_from_entry } = value
            if value.is_some then
                value return
            fi
            8 += offset
            # SAFETY: envp is a process-provided array of 8-byte-aligned pointers; offset steps in 8-byte increments within it.
            unsafe { env_ptr offset + ptr::as_ref[ptr] copy = entry }
        done
        std::Option::None
    }
}

# Path utilities
impl path {
    pub fn join b:$str a:$str -> std::String {
        if 0 a.length == then
            b.to_str return
        fi
        if 0 b.length == then
            a.to_str return
        fi
        a.length 1 - a.at.unwrap = a_last
        0 b.at.unwrap = b_first
        if '/' a_last == '/' b_first == && then
            a.length b.length + 1 - std::String::with_capacity = result
            a result.append
            b 1 b.length 1 - str::substring = suffix
            suffix.as_str result.append
            result return
        fi
        if '/' a_last == '/' b_first == || then
            a b str::concat return
        fi
        a "/" str::concat = prefix
        prefix.as_str b str::concat
    }

    pub fn dirname p:$str -> std::String {
        if 0 p.length == then
            ".".to_str return
        fi
        p.length = len
        if 1 len < '/' len 1 - p.at.unwrap == && then
            1 -= len
        fi
        len = i
        while 0 i != do
            1 -= i
            if '/' i p.at.unwrap == then
                if 0 i == then
                    "/".to_str return
                fi
                p 0 i str::substring return
            fi
        done
        ".".to_str
    }

    pub fn basename p:$str -> std::String {
        if 0 p.length == then
            std::String::new return
        fi
        p.length = len
        if 1 len < '/' len 1 - p.at.unwrap == && then
            1 -= len
        fi
        len = i
        while 0 i != do
            1 -= i
            if '/' i p.at.unwrap == then
                p i 1 + len i - 1 - str::substring return
            fi
        done
        p 0 len str::substring
    }

    pub fn extension p:$str -> std::String {
        p path::basename = base
        base.length = i
        while 0 i < do
            1 -= i
            if '.' i base.at.unwrap == then
                base.as_str i 1 + base.length i - 1 - str::substring return
            fi
        done
        std::String::new
    }
}
