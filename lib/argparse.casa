# Argument parser library
#
# Provides a declarative API for defining and parsing CLI arguments,
# with auto-generated help output similar to Python's argparse.
import "std"

# ---------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------

struct PositionalArg {
    name:      String
    help_text: String
}

struct FlaggedArg {
    name:       String
    short_flag: String
    long_flag:  String
    help_text:  String
}

enum ArgDef {
    Positional (PositionalArg)
    Flag (FlaggedArg)
    TerminalFlag (FlaggedArg)
    Option (FlaggedArg)
    MultiOption (FlaggedArg)
}

struct ArgParser {
    program_name: String
    definitions:  List[ArgDef]
}

struct ParsedArgs {
    values:       Map[String String]
    multi_values: Map[String List[String]]
}

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
const ARGPARSE_HELP_INDENT 22

# ---------------------------------------------------------------------------
# ArgParser
# ---------------------------------------------------------------------------

impl ArgParser {
    fn new -> ArgParser {
        # Derive program name from basename of argv[0] (like Python's argparse)
        0 get_arg = executable
        executable.as_str "/" str::split = path_parts
        path_parts.length 1 - path_parts.get.clone = program_name
        List[ArgDef]::new program_name ArgParser
    }

    fn add_positional self:mut$ArgParser name:str help_text:str {
        help_text.to_str name.to_str PositionalArg ArgDef::Positional self.definitions.push
    }

    fn add_flag self:mut$ArgParser name:str short_flag:str long_flag:str help_text:str {
        help_text.to_str long_flag.to_str short_flag.to_str name.to_str FlaggedArg ArgDef::Flag self.definitions.push
    }

    # Terminal flags let callers exit before using required positional arguments.
    fn add_terminal_flag self:mut$ArgParser name:str short_flag:str long_flag:str help_text:str {
        help_text.to_str long_flag.to_str short_flag.to_str name.to_str FlaggedArg ArgDef::TerminalFlag self.definitions.push
    }

    fn add_option self:mut$ArgParser name:str short_flag:str long_flag:str help_text:str {
        help_text.to_str long_flag.to_str short_flag.to_str name.to_str FlaggedArg ArgDef::Option self.definitions.push
    }

    fn add_multi_option self:mut$ArgParser name:str short_flag:str long_flag:str help_text:str {
        help_text.to_str long_flag.to_str short_flag.to_str name.to_str FlaggedArg ArgDef::MultiOption self.definitions.push
    }

    fn parse_args self:$ArgParser -> ParsedArgs {
        Map[String String]::new = values
        Map[String List[String]]::new = multi_values

        # Initialize flag defaults and multi-option lists
        0 (u64) = init_index
        while init_index self.definitions.length > do
            init_index self.definitions.get = init_def
            1 += init_index
            init_def match
                ArgDef::Flag(init_flag) => "0".to_str init_flag.name.clone values.set
                ArgDef::TerminalFlag(init_flag) => "0".to_str init_flag.name.clone values.set
                ArgDef::MultiOption(init_multi) => {
                    List[String]::new init_multi.name.clone multi_values.set
                }
                ArgDef::Positional => {
                }
                ArgDef::Option => {
                }
            end
        done

        0 (u64) = pos_index
        1 (u64) = arg_index
        while arg_index argc > do
            arg_index get_arg = arg_value
            if
                "-h" arg_value.as_str ==
                "--help" arg_value.as_str == ||
            then
                self.print_help
                0 exit
            fi
            if arg_value.as_str "-" str::starts_with then
                arg_value.as_str arg_index multi_values values self.handle_named = arg_index = multi_values = values
            else
                arg_value.as_str pos_index values self.assign_positional = pos_index = values
            fi
            1 += arg_index
        done

        false = terminal_flag_set
        for terminal_def in self.definitions.iter do
            if terminal_def ArgDef::TerminalFlag(terminal_flag) is then
                if
                    "1" terminal_flag.name.as_str values
                        .get_str
                        .unwrap
                        .as_str ==
                then
                    true = terminal_flag_set
                fi
            fi
        done
        if terminal_flag_set ! then
            pos_index self.verify_positionals
        fi
        multi_values values ParsedArgs
    }

    fn handle_named
        self:$ArgParser
        values:Map[String String]
        multi_values:Map[String List[String]]
        arg_index:u64
        arg_value:$str
    -> Map[String String] Map[String List[String]] u64 {
        if arg_value self.find_def Option::Some(matched_def) is then
            matched_def match
                ArgDef::Flag(flag_def) => "1".to_str flag_def.name.clone values.set
                ArgDef::TerminalFlag(flag_def) => "1".to_str flag_def.name.clone values.set
                ArgDef::Option(option_def) => {
                    1 += arg_index
                    if argc arg_index >= then
                        f"argument {arg_value}: expected one argument" self.print_usage_error
                    fi
                    arg_index get_arg option_def.name.clone values.set
                }
                ArgDef::MultiOption(multi_def) => {
                    1 += arg_index
                    if argc arg_index >= then
                        f"argument {arg_value}: expected one argument" self.print_usage_error
                    fi
                    multi_def.name.clone multi_values.get_mut.unwrap = multi_list
                    arg_index get_arg multi_list.push
                }
                ArgDef::Positional => {
                }
            end
        else
            f"unrecognized arguments: {arg_value}" self.print_usage_error
        fi
        values multi_values arg_index
    }

    fn find_def self:$ArgParser arg_value:$str -> Option[$ArgDef] {
        0 (u64) = index
        while index self.definitions.length > do
            index self.definitions.get = find_def
            if find_def.flagged Option::Some(found_flag) is then
                if
                    arg_value found_flag.short_flag.as_str ==
                    arg_value found_flag.long_flag.as_str == ||
                then
                    find_def Option::Some(Option[$ArgDef])
                    return
                fi
            fi
            1 += index
        done
        Option[$ArgDef]::None
    }

    fn assign_positional
        self:$ArgParser
        values:Map[String String]
        pos_index:u64
        arg_value:$str
    -> Map[String String] u64 {
        pos_index self.nth_positional_name = target_name
        if "" target_name.as_str == then
            f"unrecognized arguments: {arg_value}" self.print_usage_error
        fi
        arg_value.to_str target_name values.set
        values pos_index 1 +
    }

    fn count_positionals self:$ArgParser -> u64 {
        0 (u64) = count
        for count_def in self.definitions.iter do
            if count_def ArgDef::Positional is then
                1 += count
            fi
        done
        count
    }

    fn nth_positional_name self:$ArgParser target:u64 -> String {
        0 (u64) = nth_count
        for nth_def in self.definitions.iter do
            if nth_def ArgDef::Positional(nth_pos) is then
                if nth_count target == then
                    nth_pos.name.clone return
                fi
                1 += nth_count
            fi
        done
        String::new
    }

    fn verify_positionals self:$ArgParser pos_index:u64 {
        self.count_positionals = total_positionals
        if total_positionals pos_index != then
            pos_index self.nth_positional_name = missing_name
            f"the following arguments are required: {missing_name}" self.print_usage_error
        fi
    }

    fn build_usage_line self:$ArgParser -> String {
        String::new = usage_sb
        f"usage: {self.program_name}" usage_sb.append_string
        " [-h]" usage_sb.append
        # Optional arguments
        for usage_def in self.definitions.iter do
            if usage_def ArgDef::Positional is ! then
                usage_def usage_sb append_usage_optional
            fi
        done
        # Positional arguments
        for usage_def in self.definitions.iter do
            if usage_def ArgDef::Positional(usage_pos) is then
                f" {usage_pos.name}" usage_sb.append_string
            fi
        done
        usage_sb
    }

    fn print_help_positionals self:$ArgParser {
        for help_def in self.definitions.iter do
            if help_def ArgDef::Positional(help_pos) is then
                help_pos.help_text.as_str help_pos.name.as_str print_help_line
            fi
        done
    }

    fn print_help_options self:$ArgParser {
        "show this help message and exit" "-h, --help" print_help_line
        for help_def in self.definitions.iter do
            if help_def.flagged Option::Some(opt_flag) is then
                help_def build_flag_column = flag_column
                opt_flag.help_text.as_str flag_column.as_str print_help_line
            fi
        done
    }

    fn print_help self:$ArgParser {
        self.build_usage_line print "\n" print

        if 0 self.count_positionals != then
            "\npositional arguments:\n" print
            self.print_help_positionals
        fi

        "\noptions:\n" print
        self.print_help_options
    }

    fn print_usage_error self:$ArgParser message:String {
        self.build_usage_line eprintln_string
        f"{self.program_name}: error: {message}" eprintln_string
        2 exit
    }
}

# ---------------------------------------------------------------------------
# ArgDef helpers
# ---------------------------------------------------------------------------

impl ArgDef {
    fn flagged self:$ArgDef -> Option[$FlaggedArg] {
        if self ArgDef::Flag(flag_arg) is then
            flag_arg Option::Some(Option[$FlaggedArg]) return
        fi
        if self ArgDef::TerminalFlag(flag_arg) is then
            flag_arg Option::Some(Option[$FlaggedArg]) return
        fi
        if self ArgDef::Option(opt_arg) is then
            opt_arg Option::Some(Option[$FlaggedArg]) return
        fi
        if self ArgDef::MultiOption(multi_arg) is then
            multi_arg Option::Some(Option[$FlaggedArg]) return
        fi
        Option[$FlaggedArg]::None
    }

    fn takes_value self:$ArgDef -> bool {
        self ArgDef::Option is
        self ArgDef::MultiOption is ||
    }
}

# ---------------------------------------------------------------------------
# ParsedArgs
# ---------------------------------------------------------------------------

impl ParsedArgs {
    fn get self:$ParsedArgs name:$str -> Option[String] { name self.values.get_cloned_str }

    fn get_flag self:$ParsedArgs name:$str -> bool { name self.values.get_str.unwrap.as_str "1" == }

    fn get_multi self:$ParsedArgs name:$str -> Option[List[String]] {
        name self.multi_values.get_cloned_str
    }
}

# ---------------------------------------------------------------------------
# Free helpers
# ---------------------------------------------------------------------------

fn append_usage_optional usage_sb:mut$String definition:$ArgDef {
    if definition.flagged Option::Some(opt_flag) is then
        " [" usage_sb.append
        if "" opt_flag.short_flag.as_str != then
            opt_flag.short_flag.as_str usage_sb.append
        else
            opt_flag.long_flag.as_str usage_sb.append
        fi
        if definition.takes_value then
            " " usage_sb.append
            opt_flag.name.as_str metavar usage_sb.append_string
        fi
        "]" usage_sb.append
    fi
}

fn metavar name:$str -> String {
    String::new = meta_sb
    for meta_char in name.iter do
        if meta_char '-' == then
            '_' meta_sb.push
        elif meta_char.is_lower then
            meta_char.codepoint i64::from
            'a'.codepoint i64::from -
            'A'.codepoint i64::from +
            u32::try_from.unwrap char::from_codepoint.unwrap
            meta_sb.push
        else
            meta_char meta_sb.push
        fi
    done
    meta_sb
}

fn build_flag_column definition:$ArgDef -> String {
    String::new = col_sb
    if definition.flagged Option::Some(col_flag) is then
        if "" col_flag.short_flag.as_str != then
            col_flag.short_flag.as_str col_sb.append
            if "" col_flag.long_flag.as_str != then
                ", " col_sb.append
            fi
        fi
        if "" col_flag.long_flag.as_str != then
            col_flag.long_flag.as_str col_sb.append
        fi
        if definition.takes_value then
            " " col_sb.append
            col_flag.name.as_str metavar col_sb.append_string
        fi
    fi
    col_sb
}

fn print_help_line label:$str help_text:$str {
    "  " print
    label print
    label.length = label_len
    if label_len 2 + ARGPARSE_HELP_INDENT (u64) >= then
        # Label fits, pad with spaces
        ARGPARSE_HELP_INDENT (u64) label_len 2 + - = pad_count
        0 (u64) = pad_index
        while pad_index pad_count > do
            " " print
            1 += pad_index
        done
    else
        # Label too long, help on next line
        "\n" print
        0 (u64) = pad_index
        while pad_index ARGPARSE_HELP_INDENT (u64) 2 + > do
            " " print
            1 += pad_index
        done
    fi
    help_text print "\n" print
}
