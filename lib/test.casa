# Test assertion library for Casa unit tests.
#
# Usage:
#   "test_name" test_start
#   condition "message" assert_true
#   actual expected "message" assert_eq
#   test_summary
import "std"

0 = test_pass_count
0 = test_fail_count
"" = test_current_name

fn test_start name:str { name = test_current_name }

fn assert_true [M:Display] condition:bool message:$M {
    if condition then
        1 += test_pass_count
    else
        message M::to_str = message_text
        f"[FAIL] {test_current_name}: {message_text.as_str}\n".as_str eprint
        1 += test_fail_count
    fi
}

fn assert_false [M:Display] condition:bool message:$M { message condition ! assert_true }

fn assert_eq [T:Eq, M:Display] actual:T expected:T message:$M {
    if expected actual == then
        1 += test_pass_count
    else
        message M::to_str = message_text
        f"[FAIL] {test_current_name}: {message_text.as_str}\n".as_str eprint
        1 += test_fail_count
    fi
}

fn assert_str_eq [A:Display, B:Display, M:Display] actual:$A expected:$B message:$M {
    actual A::to_str = actual_text
    expected B::to_str = expected_text
    if expected_text.as_str actual_text.as_str == then
        1 += test_pass_count
    else
        message M::to_str = message_text
        f"[FAIL] {test_current_name}: {message_text.as_str} (expected '{expected_text.as_str}', got '{actual_text.as_str}')\n".as_str eprint
        1 += test_fail_count
    fi
}

fn test_summary {
    f"{test_pass_count} passed, {test_fail_count} failed\n" print
    if 0 test_fail_count > then
        1 exit
    fi
}
