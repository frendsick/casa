# Test assertion library for Casa unit tests.
#
# Usage:
#   "test_name" test_start
#   condition "message" assert_true
#   actual expected "message" assert_eq
#   test_summary
import "std" as std

pub fn test_start name:str { name drop }

pub fn assert_true [M:std::Display] condition:bool message:$M {
    if condition ! then
        message M::to_str = message_text
        f"[FAIL] {message_text.as_str}\n".as_str std::eprint
        1 process::exit
    fi
}

pub fn assert_false [M:std::Display] condition:bool message:$M { message condition ! assert_true }

pub fn assert_eq [T:std::Eq, M:std::Display] actual:T expected:T message:$M {
    if expected actual != then
        message M::to_str = message_text
        f"[FAIL] {message_text.as_str}\n".as_str std::eprint
        1 process::exit
    fi
}

pub fn assert_str_eq[A:std::Display,B:std::Display,M:std::Display]
    actual:$A
    expected:$B
    message:$M
{
    actual A::to_str = actual_text
    expected B::to_str = expected_text
    if expected_text.as_str actual_text.as_str != then
        message M::to_str = message_text
        f"[FAIL] {message_text.as_str} (expected '{expected_text.as_str}', got '{actual_text.as_str}')\n".as_str std::eprint
        1 process::exit
    fi
}

pub fn test_summary { "passed\n" print }
