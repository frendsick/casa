# Timer library for Casa programs.
#
# Provides high-resolution timing using clock_gettime (CLOCK_MONOTONIC).
#
# Usage:
#   import "../lib/timer.casa"
#   Timer::new = timer
#   # ... do work ...
#   timer .elapsed_ms println   # prints elapsed milliseconds
import "std" as std

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
pub const CLOCK_MONOTONIC 1
pub const SYS_CLOCK_GETTIME 228
pub const TIMESPEC_SIZE 16
pub const NS_PER_SEC 1000000000
pub const NS_PER_MS 1000000

# ---------------------------------------------------------------------------
# Timer struct
# ---------------------------------------------------------------------------

pub struct Timer {
    pub start_sec:  i64
    pub start_nsec: i64
    pub buffer:     std::RawBuffer
}

impl Timer: std::Display {
    pub fn new -> Timer {
        TIMESPEC_SIZE std::RawBuffer::new = timer_buffer
        unsafe { timer_buffer.data (i64) CLOCK_MONOTONIC (i64) SYS_CLOCK_GETTIME syscall2 drop }
        unsafe { timer_buffer.data load64 (i64) = timer_start_sec }
        unsafe { timer_buffer.data 8 + load64 (i64) = timer_start_nsec }
        timer_buffer timer_start_nsec timer_start_sec Timer
    }

    pub fn elapsed_ns self:$Timer -> i64 {
        unsafe { self.buffer.data (i64) CLOCK_MONOTONIC (i64) SYS_CLOCK_GETTIME syscall2 drop }
        unsafe { self.buffer.data load64 (i64) = now_sec }
        unsafe { self.buffer.data 8 + load64 (i64) = now_nsec }
        now_sec self.start_sec - NS_PER_SEC * now_nsec self.start_nsec - +
    }

    pub fn elapsed_ms self:$Timer -> i64 { self.elapsed_ns NS_PER_MS / }

    pub fn to_str self:$Timer -> std::String {
        self.elapsed_ms = total_ms
        total_ms 1000 / = total_seconds
        total_ms 1000 % = remaining_millis
        if 10 remaining_millis < then
            f"{total_seconds}.00{remaining_millis}s"
        elif 100 remaining_millis < then
            f"{total_seconds}.0{remaining_millis}s"
        else
            f"{total_seconds}.{remaining_millis}s"
        fi
    }
}
