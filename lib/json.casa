# JSON parser and serializer
#
# Provides parsing of JSON text into a JsonValue tree and serialization
# back to JSON text. Used by the language server for JSON-RPC communication.
import "std"
import "parser"

# ============================================================================
# JsonValue enum
# ============================================================================

enum JsonValue {
    JsonNull
    JsonBool (bool)
    JsonInt (i64)
    JsonString (String)
    JsonArray (List[JsonValue])
    JsonObject (Map[String JsonValue])
}

impl JsonValue: Clone {
    fn clone self:$JsonValue -> JsonValue {
        self match
            JsonValue::JsonNull => JsonValue::JsonNull
            JsonValue::JsonBool(value) => value JsonValue::JsonBool
            JsonValue::JsonInt(value) => value JsonValue::JsonInt
            JsonValue::JsonString(value) => value.clone JsonValue::JsonString
            JsonValue::JsonArray(value) => value.clone JsonValue::JsonArray
            JsonValue::JsonObject(value) => value.clone JsonValue::JsonObject
        end
    }
}

# ============================================================================
# JSON parsing
# ============================================================================

fn json_skip_whitespace cursor:mut$Cursor {
    while cursor.is_eof ! do
        cursor.peek.unwrap = character
        if
            ' ' character !=
            '\t' character != &&
            '\n' character != &&
            '\r' character != &&
        then
            break
        fi
        cursor.advance drop
    done
}

fn json_parse_string cursor:mut$Cursor -> Result[String ParseError] {
    cursor.save = start
    '"' cursor.expect_char = open_result
    if open_result.is_error then
        start cursor.restore
        open_result.unwrap_error Result::Error
        return
    fi
    open_result drop
    List[char]::new = chars
    while cursor.is_eof ! do
        cursor.peek.unwrap = character
        if character '"' == then
            cursor.advance drop
            chars convert_chars_to_string Result::Ok
            return
        elif character '\\' == then
            cursor.advance drop
            if cursor.is_eof then
                start cursor.restore
                start "unexpected EOF in string escape" ParseError Result::Error
                return
            fi
            cursor.peek.unwrap = escape
            cursor.advance drop
            escape match
                '"' => '"' chars.push
                '\\' => '\\' chars.push
                '/' => '/' chars.push
                'n' => '\n' chars.push
                't' => '\t' chars.push
                'r' => '\r' chars.push
                'b' => '\0' chars.push
                'f' => '\0' chars.push
                'u' => {
                    # \uXXXX: skip 4 hex digits, store as '?'
                    0 (u64) = unicode_index
                    while unicode_index 4 > do
                        if cursor.is_eof ! then
                            cursor.advance drop
                        fi
                        1 += unicode_index
                    done
                    '?' chars.push
                }
                _ => escape chars.push
            end
        else
            cursor.advance drop
            character chars.push
        fi
    done
    start cursor.restore
    start "unterminated JSON string" ParseError Result::Error
}

fn json_parse_number cursor:mut$Cursor -> Result[i64 ParseError] { cursor parse_int }

fn json_parse_bool cursor:mut$Cursor -> Result[bool ParseError] {
    if "true" cursor.starts_with then
        4 cursor.skip
        true Result::Ok
    elif "false" cursor.starts_with then
        5 cursor.skip
        false Result::Ok
    else
        cursor.pos "expected 'true' or 'false'" ParseError Result::Error
    fi
}

fn json_parse_null cursor:mut$Cursor -> Result[JsonValue ParseError] {
    if "null" cursor.starts_with then
        4 cursor.skip
        JsonValue::JsonNull Result::Ok
    else
        cursor.pos "expected 'null'" ParseError Result::Error
    fi
}

fn json_parse_array cursor:mut$Cursor -> Result[JsonValue ParseError] {
    cursor.save = start
    '[' cursor.expect_char = open_result
    if open_result.is_error then
        start cursor.restore
        open_result.unwrap_error Result::Error
        return
    fi
    open_result drop
    List[JsonValue]::new = items
    cursor json_skip_whitespace

    # Empty array
    if cursor.is_eof ! then
        if cursor.peek.unwrap ']' == then
            cursor.advance drop
            items JsonValue::JsonArray Result::Ok
            return
        fi
    fi

    while true do
        cursor json_skip_whitespace
        cursor json_parse = value_result
        if value_result.is_error then
            start cursor.restore
            value_result.unwrap_error Result::Error
            return
        fi
        value_result.unwrap items.push
        cursor json_skip_whitespace

        if cursor.is_eof then
            start cursor.restore
            start "unterminated JSON array" ParseError Result::Error
            return
        fi
        cursor.peek.unwrap = next_char
        if next_char ']' == then
            cursor.advance drop
            items JsonValue::JsonArray Result::Ok
            return
        elif next_char ',' == then
            cursor.advance drop
        else
            start cursor.restore
            cursor.pos "expected ',' or ']' in array" ParseError Result::Error
            return
        fi
    done
    start "unreachable" ParseError Result::Error
}

fn json_parse_object cursor:mut$Cursor -> Result[JsonValue ParseError] {
    cursor.save = start
    '{' cursor.expect_char = open_result
    if open_result.is_error then
        start cursor.restore
        open_result.unwrap_error Result::Error
        return
    fi
    open_result drop
    Map[String JsonValue]::new = entries
    cursor json_skip_whitespace

    # Empty object
    if cursor.is_eof ! then
        if cursor.peek.unwrap '}' == then
            cursor.advance drop
            entries JsonValue::JsonObject Result::Ok
            return
        fi
    fi

    while true do
        cursor json_skip_whitespace
        # Parse key
        cursor json_parse_string = key_result
        if key_result.is_error then
            start cursor.restore
            key_result.unwrap_error Result::Error
            return
        fi
        key_result.unwrap = key_str

        cursor json_skip_whitespace
        ':' cursor.expect_char = colon_result
        if colon_result.is_error then
            start cursor.restore
            colon_result.unwrap_error Result::Error
            return
        fi
        colon_result drop

        cursor json_skip_whitespace
        cursor json_parse = value_result
        if value_result.is_error then
            start cursor.restore
            value_result.unwrap_error Result::Error
            return
        fi
        value_result.unwrap key_str entries.set

        cursor json_skip_whitespace
        if cursor.is_eof then
            start cursor.restore
            start "unterminated JSON object" ParseError Result::Error
            return
        fi
        cursor.peek.unwrap = next_char
        if next_char '}' == then
            cursor.advance drop
            entries JsonValue::JsonObject Result::Ok
            return
        elif next_char ',' == then
            cursor.advance drop
        else
            start cursor.restore
            cursor.pos "expected ',' or '}' in object" ParseError Result::Error
            return
        fi
    done
    start "unreachable" ParseError Result::Error
}

fn json_parse cursor:mut$Cursor -> Result[JsonValue ParseError] {
    cursor json_skip_whitespace
    if cursor.is_eof then
        cursor.pos "unexpected EOF" ParseError Result::Error
        return
    fi
    cursor.peek.unwrap = character
    if character '"' == then
        { JsonValue::JsonString } cursor json_parse_string.map
    elif character '{' == then
        cursor json_parse_object
    elif character '[' == then
        cursor json_parse_array
    elif character 't' == character 'f' == || then
        { JsonValue::JsonBool } cursor json_parse_bool.map
    elif character 'n' == then
        cursor json_parse_null
    elif character.is_digit character '-' == || then
        { JsonValue::JsonInt } cursor json_parse_number.map
    else
        cursor.pos "unexpected character in JSON" ParseError Result::Error
    fi
}

# ============================================================================
# JSON serialization
# ============================================================================

fn json_escape_string text:$str -> String {
    String::new = builder
    for character in text.iter do
        character match
            '"' => "\\\"" builder.append
            '\\' => "\\\\" builder.append
            '\n' => "\\n" builder.append
            '\t' => "\\t" builder.append
            '\r' => "\\r" builder.append
            _ => character builder.push
        end
    done
    builder
}

fn json_serialize value:$JsonValue -> String {
    value match
        JsonValue::JsonNull => "null".to_str
        JsonValue::JsonBool(bool_value) => {
            if bool_value then "true".to_str else "false".to_str fi
        }
        JsonValue::JsonInt(int_value) => int_value.to_str
        JsonValue::JsonString(str_value) => {
            f"\"{str_value.as_str json_escape_string}\""
        }
        JsonValue::JsonArray(array_items) => {
            "," {
                json_serialize
            } array_items
                .iter
                .map
                .collect
                .join_strings = items_str
            f"[{items_str}]"
        }
        JsonValue::JsonObject(object_map) => {
            String::new = object_builder
            "{" object_builder.append
            false = has_prev
            for kv_pair in object_map.iter do
                if has_prev then
                    "," object_builder.append
                fi
                true = has_prev
                kv_pair.first = key
                f"\"{key.as_str json_escape_string}\":".as_str object_builder.append
                kv_pair.second json_serialize.as_str object_builder.append
            done
            "}" object_builder.append
            object_builder
        }
    end
}

# ============================================================================
# JSON helper accessors
# ============================================================================

fn json_get_str value:$JsonValue key:$str -> Option[String] {
    if key value json_get_value Option::Some(entry) is then
        if entry JsonValue::JsonString(string_value) is then
            string_value.clone Option::Some
            return
        fi
    fi
    Option[String]::None
}

fn json_get_int value:$JsonValue key:$str -> Option[i64] {
    if key value json_get_value Option::Some(entry) is then
        if entry JsonValue::JsonInt(int_value) is then
            int_value Option::Some
            return
        fi
    fi
    Option[i64]::None
}

fn json_get_bool value:$JsonValue key:$str -> Option[bool] {
    if key value json_get_value Option::Some(entry) is then
        if entry JsonValue::JsonBool(bool_value) is then
            bool_value Option::Some
            return
        fi
    fi
    Option[bool]::None
}

fn json_get_object value:$JsonValue key:$str -> Option[$JsonValue] {
    if key value json_get_value Option::Some(entry) is then
        if entry JsonValue::JsonObject(inner) is then
            entry Option::Some
            return
        fi
    fi
    Option[$JsonValue]::None
}

fn json_get_array value:$JsonValue key:$str -> Option[List[JsonValue]] {
    if key value json_get_value Option::Some(entry) is then
        if entry JsonValue::JsonArray(array_value) is then
            array_value.clone Option::Some
            return
        fi
    fi
    Option[List[JsonValue]]::None
}

fn json_get_value value:$JsonValue key:$str -> Option[$JsonValue] {
    if value JsonValue::JsonObject(entries) is then
        key entries (Map[String JsonValue]).get_str
    else
        Option[$JsonValue]::None
    fi
}

# ============================================================================
# JSON builder helpers
# ============================================================================

fn json_object -> Map[String JsonValue] { Map[String JsonValue]::new }

fn json_set value:JsonValue key:String map:Map[String JsonValue] -> Map[String JsonValue] {
    value key map.set
    map
}
