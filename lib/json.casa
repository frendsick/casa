# JSON parser and serializer
#
# Converts JSON text and application types through an owned JsonValue tree.
# Used by the language server for JSON-RPC communication.
import "std" as std
import "parser" as parser

pub enum JsonValue {
    JsonNull
    JsonBool(bool)
    JsonInt(i64)
    JsonNumber(JsonNumber)
    JsonString(std::String)
    JsonArray(std::List[JsonValue])
    JsonObject(std::Map[std::String JsonValue])
}

impl JsonValue: std::Clone {
    pub fn clone self:$JsonValue -> JsonValue {
        self match
            JsonValue::JsonNull => JsonValue::JsonNull
            JsonValue::JsonBool(value) => value JsonValue::JsonBool
            JsonValue::JsonInt(value) => value JsonValue::JsonInt
            JsonValue::JsonNumber(value) => value.clone JsonValue::JsonNumber
            JsonValue::JsonString(value) => value.clone JsonValue::JsonString
            JsonValue::JsonArray(value) => value.clone JsonValue::JsonArray
            JsonValue::JsonObject(value) => value.clone JsonValue::JsonObject
        end
    }
}

# JSON parsing
pub fn json_skip_whitespace cursor:mut$parser::Cursor {
    while cursor.is_eof ! do
        cursor.peek.unwrap = character
        if
            ' ' character !=
            '\t' character != &&
            '\n' character != &&
            '\r' character != &&
        then
            break
        fi
        cursor.advance drop
    done
}
const HIGH_SURROGATE_MIN: u32 55296
const HIGH_SURROGATE_MAX: u32 56319
const LOW_SURROGATE_MIN: u32 56320
const LOW_SURROGATE_MAX: u32 57343
const SUPPLEMENTARY_PLANE_START: u32 65536
const SURROGATE_RADIX: u32 1024
const POSITIVE_INTEGER_LIMIT: u64 9223372036854775807
const NEGATIVE_INTEGER_LIMIT: u64 9223372036854775808
const UNSIGNED_INTEGER_LIMIT: u64 18446744073709551615

fn parse_hex_quad cursor:mut$parser::Cursor -> std::Result[u32 parser::ParseError] {
    0 = value: u32
    0 = index: u64
    while 4 index > do
        if cursor.advance std::Option::Some(character) is then
            character.codepoint = digit
            if '0' character <= '9' character >= && then
                '0'.codepoint -= digit
            elif 'a' character <= 'f' character >= && then
                digit 'a'.codepoint - 10 + = digit
            elif 'A' character <= 'F' character >= && then
                digit 'A'.codepoint - 10 + = digit
            else
                cursor.pos 1 - "invalid Unicode escape" parser::ParseError std::Result::Error return
            fi
            value 16 * digit + = value
        else
            cursor.pos "incomplete Unicode escape" parser::ParseError std::Result::Error return
        fi
        1 += index
    done
    value std::Result::Ok
}

fn parse_unicode_escape cursor:mut$parser::Cursor -> std::Result[char parser::ParseError] {
    cursor parse_hex_quad ? = codepoint
    if HIGH_SURROGATE_MIN codepoint <= HIGH_SURROGATE_MAX codepoint >= && then
        '\\' cursor.expect_char ? drop
        'u' cursor.expect_char ? drop
        cursor parse_hex_quad ? = low
        if LOW_SURROGATE_MIN low > LOW_SURROGATE_MAX low < || then
            cursor.pos "expected low surrogate" parser::ParseError std::Result::Error return
        fi
        codepoint HIGH_SURROGATE_MIN - SURROGATE_RADIX *
        low LOW_SURROGATE_MIN - + SUPPLEMENTARY_PLANE_START + = codepoint
    fi
    if codepoint char::from_codepoint std::Option::Some(character) is then
        character std::Result::Ok
    else
        cursor.pos "invalid Unicode scalar" parser::ParseError std::Result::Error
    fi
}

fn parse_string_escape cursor:mut$parser::Cursor -> std::Result[char parser::ParseError] {
    if cursor.advance std::Option::Some(character) is then
        character match
            '"' => '"' std::Result::Ok
            '\\' => '\\' std::Result::Ok
            '/' => '/' std::Result::Ok
            'b' => '\u{8}' std::Result::Ok
            'f' => '\u{c}' std::Result::Ok
            'n' => '\n' std::Result::Ok
            'r' => '\r' std::Result::Ok
            't' => '\t' std::Result::Ok
            'u' => cursor parse_unicode_escape
            _ => cursor.pos 1 - "invalid string escape" parser::ParseError std::Result::Error
        end
    else
        cursor.pos "incomplete string escape" parser::ParseError std::Result::Error
    fi
}

fn parse_string_contents cursor:mut$parser::Cursor -> std::Result[std::String parser::ParseError] {
    '"' cursor.expect_char ? drop
    std::String::new = text
    cursor.pos = segment_start
    while cursor.is_eof ! do
        cursor.peek.unwrap = character
        if '"' character == '\\' character == || then
            # Cursor positions count bytes. Copy complete UTF-8 segments between escapes.
            cursor.source segment_start cursor.pos segment_start - str::substring.as_str text.append
            cursor.advance drop
            if '"' character == then
                text std::Result::Ok return
            fi
            cursor parse_string_escape ? text.push
            cursor.pos = segment_start
        elif ' ' character > then
            cursor.pos "unescaped control character" parser::ParseError std::Result::Error return
        else
            cursor.advance drop
        fi
    done
    cursor.pos "unterminated JSON string" parser::ParseError std::Result::Error
}

pub fn json_parse_string cursor:mut$parser::Cursor -> std::Result[std::String parser::ParseError] {
    cursor.save = start
    cursor parse_string_contents = result
    if result.is_error then
        start cursor.restore
    fi
    result
}

# The private field guarantees a valid JSON number token. Keeping its text avoids
# rounding before the caller selects a numeric type and preserves larger numbers.
pub struct JsonNumber derives std::Clone {
    text: std::String
}

impl JsonNumber {
    pub fn new text:$str -> std::Result[JsonNumber parser::ParseError] {
        text parser::Cursor::new = cursor
        cursor JsonNumber::parse ? = number
        if cursor.is_eof ! then
            cursor.pos "trailing content after JSON number" parser::ParseError std::Result::Error
        else
            number std::Result::Ok
        fi
    }

    pub fn as_str self:$JsonNumber -> $str { self.text.as_str }

    fn consume_digits cursor:mut$parser::Cursor -> std::Result[u64 parser::ParseError] {
        cursor.pos = start
        &char::is_digit cursor.skip_while
        if start cursor.pos == then
            cursor.pos "expected digit in JSON number" parser::ParseError std::Result::Error
        else
            cursor.pos start - std::Result::Ok
        fi
    }

    fn read cursor:mut$parser::Cursor -> std::Result[JsonNumber parser::ParseError] {
        cursor.pos = start
        if "-" cursor.starts_with then
            cursor.advance drop
        fi
        if "0" cursor.starts_with then
            cursor.advance drop
            if cursor.peek std::Option::Some(character) is then
                if character.is_digit then
                    cursor.pos "leading zero in JSON number" parser::ParseError std::Result::Error return
                fi
            fi
        else
            cursor JsonNumber::consume_digits ? drop
        fi
        if "." cursor.starts_with then
            cursor.advance drop
            cursor JsonNumber::consume_digits ? drop
        fi
        if "e" cursor.starts_with "E" cursor.starts_with || then
            cursor.advance drop
            if "+" cursor.starts_with "-" cursor.starts_with || then
                cursor.advance drop
            fi
            cursor JsonNumber::consume_digits ? drop
        fi
        cursor.source start cursor.pos start - str::substring JsonNumber std::Result::Ok
    }

    fn parse cursor:mut$parser::Cursor -> std::Result[JsonNumber parser::ParseError] {
        cursor.save = start
        cursor JsonNumber::read = result
        if result.is_error then
            start cursor.restore
        fi
        result
    }

    fn is_integer self:$JsonNumber -> bool {
        for character in self.text.iter do
            if '.' character == 'e' character == || 'E' character == || then
                false return
            fi
        done
        true
    }

    fn parse_magnitude self:$JsonNumber limit:u64 -> std::Option[u64] {
        0 = magnitude: u64
        for character in self.text.iter do
            if '-' character == then
                continue
            fi
            character.codepoint u64::from '0'.codepoint u64::from - = digit
            if limit digit - 10 / magnitude < then
                std::Option[u64]::None return
            fi
            magnitude 10 * digit + = magnitude
        done
        magnitude std::Option::Some
    }

    fn to_i64 self:$JsonNumber -> std::Result[i64 Error] {
        if self.is_integer ! then
            "integer" Error::TypeMismatch std::Result::Error return
        fi
        0 self
            .text
            .at
            .unwrap '-' == = negative
        if negative then NEGATIVE_INTEGER_LIMIT else POSITIVE_INTEGER_LIMIT fi = limit
        if limit self.parse_magnitude std::Option::Some(magnitude) is then
            if magnitude NEGATIVE_INTEGER_LIMIT == then
                -9223372036854775808
            elif negative then
                0 magnitude i64::try_from.unwrap -
            else
                magnitude i64::try_from.unwrap
            fi std::Result::Ok
        else
            "i64" Error::OutOfRange std::Result::Error
        fi
    }

    fn to_u64 self:$JsonNumber -> std::Result[u64 Error] {
        if self.is_integer ! then
            "integer" Error::TypeMismatch std::Result::Error return
        fi
        if UNSIGNED_INTEGER_LIMIT self.parse_magnitude std::Option::Some(magnitude) is then
            0 self
                .text
                .at
                .unwrap '-' == = negative
            if negative ! 0 magnitude == || then
                magnitude std::Result::Ok return
            fi
        fi
        "u64" Error::OutOfRange std::Result::Error
    }
}

fn parse_numeric_value cursor:mut$parser::Cursor -> std::Result[JsonValue parser::ParseError] {
    cursor JsonNumber::parse ? = number
    # Keep negative zero as text so floating-point conversions preserve its sign.
    if "-0" number.as_str != then
        if number.to_i64 std::Result::Ok(integer) is then
            integer JsonValue::JsonInt std::Result::Ok return
        fi
    fi
    number JsonValue::JsonNumber std::Result::Ok
}

pub fn json_parse_number cursor:mut$parser::Cursor -> std::Result[i64 parser::ParseError] {
    cursor.save = start
    cursor JsonNumber::parse ? = number
    if number.to_i64 std::Result::Ok(integer) is then
        integer std::Result::Ok
    else
        start cursor.restore
        start "expected JSON integer within i64 range" parser::ParseError std::Result::Error
    fi
}

pub fn json_parse_bool cursor:mut$parser::Cursor -> std::Result[bool parser::ParseError] {
    if "true" cursor.starts_with then
        4 cursor.skip
        true std::Result::Ok
    elif "false" cursor.starts_with then
        5 cursor.skip
        false std::Result::Ok
    else
        cursor.pos "expected 'true' or 'false'" parser::ParseError std::Result::Error
    fi
}

pub fn json_parse_null cursor:mut$parser::Cursor -> std::Result[JsonValue parser::ParseError] {
    if "null" cursor.starts_with then
        4 cursor.skip
        JsonValue::JsonNull std::Result::Ok
    else
        cursor.pos "expected 'null'" parser::ParseError std::Result::Error
    fi
}

pub fn json_parse_array cursor:mut$parser::Cursor -> std::Result[JsonValue parser::ParseError] {
    cursor.save = start
    '[' cursor.expect_char = open_result
    if open_result.is_error then
        start cursor.restore
        open_result.unwrap_error std::Result::Error
        return
    fi
    open_result drop
    std::List[JsonValue]::new = items
    cursor json_skip_whitespace

    # Empty array
    if cursor.is_eof ! then
        if cursor.peek.unwrap ']' == then
            cursor.advance drop
            items JsonValue::JsonArray std::Result::Ok
            return
        fi
    fi

    while true do
        cursor json_skip_whitespace
        cursor json_parse = value_result
        if value_result.is_error then
            start cursor.restore
            value_result.unwrap_error std::Result::Error
            return
        fi
        value_result.unwrap items.push
        cursor json_skip_whitespace

        if cursor.is_eof then
            start cursor.restore
            start "unterminated JSON array" parser::ParseError std::Result::Error
            return
        fi
        cursor.peek.unwrap = next_char
        if next_char ']' == then
            cursor.advance drop
            items JsonValue::JsonArray std::Result::Ok
            return
        elif next_char ',' == then
            cursor.advance drop
        else
            start cursor.restore
            cursor.pos "expected ',' or ']' in array" parser::ParseError std::Result::Error
            return
        fi
    done
    start "unreachable" parser::ParseError std::Result::Error
}

pub fn json_parse_object cursor:mut$parser::Cursor -> std::Result[JsonValue parser::ParseError] {
    cursor.save = start
    '{' cursor.expect_char = open_result
    if open_result.is_error then
        start cursor.restore
        open_result.unwrap_error std::Result::Error
        return
    fi
    open_result drop
    std::Map[std::String JsonValue]::new = entries
    cursor json_skip_whitespace

    # Empty object
    if cursor.is_eof ! then
        if cursor.peek.unwrap '}' == then
            cursor.advance drop
            entries JsonValue::JsonObject std::Result::Ok
            return
        fi
    fi

    while true do
        cursor json_skip_whitespace
        # Parse key
        cursor json_parse_string = key_result
        if key_result.is_error then
            start cursor.restore
            key_result.unwrap_error std::Result::Error
            return
        fi
        key_result.unwrap = key_str

        cursor json_skip_whitespace
        ':' cursor.expect_char = colon_result
        if colon_result.is_error then
            start cursor.restore
            colon_result.unwrap_error std::Result::Error
            return
        fi
        colon_result drop

        cursor json_skip_whitespace
        cursor json_parse = value_result
        if value_result.is_error then
            start cursor.restore
            value_result.unwrap_error std::Result::Error
            return
        fi
        value_result.unwrap key_str entries.set

        cursor json_skip_whitespace
        if cursor.is_eof then
            start cursor.restore
            start "unterminated JSON object" parser::ParseError std::Result::Error
            return
        fi
        cursor.peek.unwrap = next_char
        if next_char '}' == then
            cursor.advance drop
            entries JsonValue::JsonObject std::Result::Ok
            return
        elif next_char ',' == then
            cursor.advance drop
        else
            start cursor.restore
            cursor.pos "expected ',' or '}' in object" parser::ParseError std::Result::Error
            return
        fi
    done
    start "unreachable" parser::ParseError std::Result::Error
}

pub fn json_parse cursor:mut$parser::Cursor -> std::Result[JsonValue parser::ParseError] {
    cursor json_skip_whitespace
    if cursor.is_eof then
        cursor.pos "unexpected EOF" parser::ParseError std::Result::Error
        return
    fi
    cursor.peek.unwrap = character
    if character '"' == then
        { JsonValue::JsonString } cursor json_parse_string.map
    elif character '{' == then
        cursor json_parse_object
    elif character '[' == then
        cursor json_parse_array
    elif character 't' == character 'f' == || then
        { JsonValue::JsonBool } cursor json_parse_bool.map
    elif character 'n' == then
        cursor json_parse_null
    elif character.is_digit character '-' == || then
        cursor parse_numeric_value
    else
        cursor.pos "unexpected character in JSON" parser::ParseError std::Result::Error
    fi
}

# JSON serialization
pub fn json_escape_string text:$str -> std::String {
    std::String::new = builder
    for character in text.iter do
        character match
            '"' => "\\\"" builder.append
            '\\' => "\\\\" builder.append
            '\u{8}' => "\\b" builder.append
            '\u{c}' => "\\f" builder.append
            '\n' => "\\n" builder.append
            '\t' => "\\t" builder.append
            '\r' => "\\r" builder.append
            _ => {
                if ' ' character > then
                    "\\u00" builder.append
                    character.codepoint u64::from = codepoint
                    codepoint 16 / "0123456789abcdef".at.unwrap builder.push
                    codepoint 16 % "0123456789abcdef".at.unwrap builder.push
                else
                    character builder.push
                fi
            }
        end
    done
    builder
}

pub fn json_serialize value:$JsonValue -> std::String {
    value match
        JsonValue::JsonNull => "null".to_str
        JsonValue::JsonBool(bool_value) => {
            if bool_value then "true".to_str else "false".to_str fi
        }
        JsonValue::JsonInt(int_value) => int_value.to_str
        JsonValue::JsonNumber(number) => number.as_str.to_str
        JsonValue::JsonString(str_value) => {
            f"\"{str_value.as_str json_escape_string}\""
        }
        JsonValue::JsonArray(array_items) => {
            "," {
                json_serialize
            } array_items
                .iter
                .map
                .collect
                .join_strings = items_str
            f"[{items_str}]"
        }
        JsonValue::JsonObject(object_map) => {
            std::String::new = object_builder
            "{" object_builder.append
            false = has_prev
            for kv_pair in object_map.iter do
                if has_prev then
                    "," object_builder.append
                fi
                true = has_prev
                kv_pair.first = key
                f"\"{key.as_str json_escape_string}\":".as_str object_builder.append
                kv_pair.second json_serialize.as_str object_builder.append
            done
            "}" object_builder.append
            object_builder
        }
    end
}

# JSON helper accessors
pub fn json_get_str value:$JsonValue key:$str -> std::Option[std::String] {
    if key value json_get_value std::Option::Some(entry) is then
        if entry JsonValue::JsonString(string_value) is then
            string_value.clone std::Option::Some
            return
        fi
    fi
    std::Option[std::String]::None
}

pub fn json_get_int value:$JsonValue key:$str -> std::Option[i64] {
    if key value json_get_value std::Option::Some(entry) is then
        if entry i64::from_json std::Result::Ok(int_value) is then
            int_value std::Option::Some
            return
        fi
    fi
    std::Option[i64]::None
}

pub fn json_get_bool value:$JsonValue key:$str -> std::Option[bool] {
    if key value json_get_value std::Option::Some(entry) is then
        if entry JsonValue::JsonBool(bool_value) is then
            bool_value std::Option::Some
            return
        fi
    fi
    std::Option[bool]::None
}

pub fn json_get_object value:$JsonValue key:$str -> std::Option[$JsonValue] {
    if key value json_get_value std::Option::Some(entry) is then
        if entry JsonValue::JsonObject(inner) is then
            entry std::Option::Some
            return
        fi
    fi
    std::Option[$JsonValue]::None
}

pub fn json_get_array value:$JsonValue key:$str -> std::Option[std::List[JsonValue]] {
    if key value json_get_value std::Option::Some(entry) is then
        if entry JsonValue::JsonArray(array_value) is then
            array_value.clone std::Option::Some
            return
        fi
    fi
    std::Option[std::List[JsonValue]]::None
}

pub fn json_get_value value:$JsonValue key:$str -> std::Option[$JsonValue] {
    if value JsonValue::JsonObject(entries) is then
        entries = object: $std::Map[std::String JsonValue]
        key object.get_str
    else
        std::Option[$JsonValue]::None
    fi
}

# JSON builder helpers
pub fn json_object -> std::Map[std::String JsonValue] { std::Map[std::String JsonValue]::new }

pub fn json_set
    value:JsonValue
    key:std::String
    map:std::Map[std::String JsonValue]
-> std::Map[std::String JsonValue] {
    value key map.set
    map
}

# Typed conversion. Values returned by from_json own their data.
pub enum Error {
    Parse(parser::ParseError)
    TypeMismatch(str)
    MissingField(std::String)
    OutOfRange(str)
    InvalidValue(str)
}

pub trait Serialize {
    fn to_json self:$self -> std::Result[JsonValue Error]
}

pub trait Deserialize {
    fn from_json value:$JsonValue -> std::Result[self Error]
}

pub fn serialize [T:Serialize] value:$T -> std::Result[std::String Error] {
    value.to_json ? json_serialize std::Result::Ok
}

pub fn deserialize [T:Deserialize] text:$str -> std::Result[T Error] {
    text parser::Cursor::new = cursor
    cursor json_parse match
        std::Result::Ok(value) => {
            cursor json_skip_whitespace
            if cursor.is_eof ! then
                cursor.pos "trailing content after JSON value" parser::ParseError Error::Parse
                std::Result::Error return
            fi
            # Function references retain T for associated methods without a self argument.
            # Direct T::from_json dispatch currently selects the input type instead.
            # Use direct calls here and in containers once that compiler path is corrected.
            value &T::from_json exec
        }
        std::Result::Error(error) => error Error::Parse std::Result::Error
    end
}

impl JsonValue {
    pub fn require_field self:$JsonValue key:$str -> std::Result[$JsonValue Error] {
        if self JsonValue::JsonObject(entries) is then
            if key entries.get_str std::Option::Some(value) is then
                value std::Result::Ok
            else
                key.to_str Error::MissingField std::Result::Error
            fi
        else
            "object" Error::TypeMismatch std::Result::Error
        fi
    }
}

impl JsonValue: Serialize + Deserialize {
    pub fn to_json self:$JsonValue -> std::Result[JsonValue Error] { self.clone std::Result::Ok }
    pub fn from_json value:$JsonValue -> std::Result[JsonValue Error] {
        value.clone std::Result::Ok
    }
}

impl bool: Serialize + Deserialize {
    pub fn to_json self:$bool -> std::Result[JsonValue Error] {
        self copy JsonValue::JsonBool std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[bool Error] {
        if value JsonValue::JsonBool(inner) is then
            inner copy std::Result::Ok
        else
            "boolean" Error::TypeMismatch std::Result::Error
        fi
    }
}

impl i64: Serialize + Deserialize {
    pub fn to_json self:$i64 -> std::Result[JsonValue Error] {
        self copy JsonValue::JsonInt std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[i64 Error] {
        value match
            JsonValue::JsonInt(inner) => inner copy std::Result::Ok
            JsonValue::JsonNumber(number) => number.to_i64
            _ => "integer" Error::TypeMismatch std::Result::Error
        end
    }
}

impl i8: Serialize + Deserialize {
    pub fn to_json self:$i8 -> std::Result[JsonValue Error] {
        self copy i64::from JsonValue::JsonInt std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[i8 Error] {
        value i64::from_json ? = decoded
        if decoded i8::try_from std::Option::Some(integer) is then
            integer std::Result::Ok
        else
            "i8" Error::OutOfRange std::Result::Error
        fi
    }
}

impl i16: Serialize + Deserialize {
    pub fn to_json self:$i16 -> std::Result[JsonValue Error] {
        self copy i64::from JsonValue::JsonInt std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[i16 Error] {
        value i64::from_json ? = decoded
        if decoded i16::try_from std::Option::Some(integer) is then
            integer std::Result::Ok
        else
            "i16" Error::OutOfRange std::Result::Error
        fi
    }
}

impl i32: Serialize + Deserialize {
    pub fn to_json self:$i32 -> std::Result[JsonValue Error] {
        self copy i64::from JsonValue::JsonInt std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[i32 Error] {
        value i64::from_json ? = decoded
        if decoded i32::try_from std::Option::Some(integer) is then
            integer std::Result::Ok
        else
            "i32" Error::OutOfRange std::Result::Error
        fi
    }
}

impl u8: Serialize + Deserialize {
    pub fn to_json self:$u8 -> std::Result[JsonValue Error] {
        self copy i64::from JsonValue::JsonInt std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[u8 Error] {
        value i64::from_json ? = decoded
        if decoded u8::try_from std::Option::Some(integer) is then
            integer std::Result::Ok
        else
            "u8" Error::OutOfRange std::Result::Error
        fi
    }
}

impl u16: Serialize + Deserialize {
    pub fn to_json self:$u16 -> std::Result[JsonValue Error] {
        self copy i64::from JsonValue::JsonInt std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[u16 Error] {
        value i64::from_json ? = decoded
        if decoded u16::try_from std::Option::Some(integer) is then
            integer std::Result::Ok
        else
            "u16" Error::OutOfRange std::Result::Error
        fi
    }
}

impl u32: Serialize + Deserialize {
    pub fn to_json self:$u32 -> std::Result[JsonValue Error] {
        self copy i64::from JsonValue::JsonInt std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[u32 Error] {
        value i64::from_json ? = decoded
        if decoded u32::try_from std::Option::Some(integer) is then
            integer std::Result::Ok
        else
            "u32" Error::OutOfRange std::Result::Error
        fi
    }
}

impl u64: Serialize + Deserialize {
    pub fn to_json self:$u64 -> std::Result[JsonValue Error] {
        if self copy i64::try_from std::Option::Some(integer) is then
            integer JsonValue::JsonInt
        else
            self.to_str JsonNumber JsonValue::JsonNumber
        fi std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[u64 Error] {
        value match
            JsonValue::JsonInt(integer) => {
                if integer copy u64::try_from std::Option::Some(number) is then
                    number std::Result::Ok
                else
                    "u64" Error::OutOfRange std::Result::Error
                fi
            }
            JsonValue::JsonNumber(number) => number.to_u64
            _ => "integer" Error::TypeMismatch std::Result::Error
        end
    }
}

impl JsonNumber: Serialize + Deserialize {
    pub fn to_json self:$JsonNumber -> std::Result[JsonValue Error] {
        self.clone JsonValue::JsonNumber std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[JsonNumber Error] {
        value match
            JsonValue::JsonInt(integer) => integer.to_str JsonNumber std::Result::Ok
            JsonValue::JsonNumber(number) => number.clone std::Result::Ok
            _ => "number" Error::TypeMismatch std::Result::Error
        end
    }
}

impl f32: Serialize + Deserialize {
    pub fn to_json self:$f32 -> std::Result[JsonValue Error] {
        if self.is_finite ! then
            "JSON numbers must be finite" Error::InvalidValue std::Result::Error return
        fi
        self.to_str JsonNumber JsonValue::JsonNumber std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[f32 Error] {
        value match
            JsonValue::JsonInt(integer) => integer.to_str.to_f32
            JsonValue::JsonNumber(number) => number.as_str.to_f32
            _ => {
                "number" Error::TypeMismatch std::Result::Error return
            }
        end = parsed
        if parsed std::Option::Some(number) is then
            number std::Result::Ok
        else
            "f32" Error::OutOfRange std::Result::Error
        fi
    }
}

impl f64: Serialize + Deserialize {
    pub fn to_json self:$f64 -> std::Result[JsonValue Error] {
        if self.is_finite ! then
            "JSON numbers must be finite" Error::InvalidValue std::Result::Error return
        fi
        self.to_str JsonNumber JsonValue::JsonNumber std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[f64 Error] {
        value match
            JsonValue::JsonInt(integer) => integer.to_str.to_f64
            JsonValue::JsonNumber(number) => number.as_str.to_f64
            _ => {
                "number" Error::TypeMismatch std::Result::Error return
            }
        end = parsed
        if parsed std::Option::Some(number) is then
            number std::Result::Ok
        else
            "f64" Error::OutOfRange std::Result::Error
        fi
    }
}

impl str: Serialize {
    pub fn to_json self:$str -> std::Result[JsonValue Error] {
        self.to_str JsonValue::JsonString std::Result::Ok
    }
}

impl std::String: Serialize + Deserialize {
    pub fn to_json self:$std::String -> std::Result[JsonValue Error] {
        self.clone JsonValue::JsonString std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[std::String Error] {
        if value JsonValue::JsonString(inner) is then
            inner.clone std::Result::Ok
        else
            "string" Error::TypeMismatch std::Result::Error
        fi
    }
}

impl char: Serialize + Deserialize {
    pub fn to_json self:$char -> std::Result[JsonValue Error] {
        self.to_str JsonValue::JsonString std::Result::Ok
    }
    pub fn from_json value:$JsonValue -> std::Result[char Error] {
        if value JsonValue::JsonString(text) is then
            text.iter = characters
            if characters.next std::Option::Some(character) is then
                if characters.next.is_none then
                    character std::Result::Ok return
                fi
            fi
            "expected one Unicode scalar" Error::InvalidValue std::Result::Error
        else
            "string" Error::TypeMismatch std::Result::Error
        fi
    }
}

impl[T: Serialize] std::List[T]: Serialize {
    pub fn to_json self:$std::List[T] -> std::Result[JsonValue Error] {
        std::List[JsonValue]::new = values
        for item in self.iter do
            item.to_json ? values.push
        done
        values JsonValue::JsonArray std::Result::Ok
    }
}

impl[T: Deserialize] std::List[T]: Deserialize {
    pub fn from_json value:$JsonValue -> std::Result[std::List[T] Error] {
        if value JsonValue::JsonArray(items) is then
            std::List[T]::new = values
            for item in items.iter do
                item &T::from_json exec ? values.push
            done
            values std::Result::Ok
        else
            "array" Error::TypeMismatch std::Result::Error
        fi
    }
}

impl[T: Serialize] std::Option[T]: Serialize {
    pub fn to_json self:$std::Option[T] -> std::Result[JsonValue Error] {
        self match
            std::Option::None => JsonValue::JsonNull std::Result::Ok
            std::Option::Some(value) => value.to_json
        end
    }
}

impl[T: Deserialize] std::Option[T]: Deserialize {
    pub fn from_json value:$JsonValue -> std::Result[std::Option[T] Error] {
        if value JsonValue::JsonNull is then
            std::Option[T]::None std::Result::Ok
        else
            value &T::from_json exec ? std::Option::Some std::Result::Ok
        fi
    }
}

impl[T: Serialize] std::Map[std::String T]: Serialize {
    pub fn to_json self:$std::Map[std::String T] -> std::Result[JsonValue Error] {
        json_object = entries
        for entry in self.iter do
            entry.second.to_json ? entry.first.clone entries.set
        done
        entries JsonValue::JsonObject std::Result::Ok
    }
}

impl[T: Deserialize] std::Map[std::String T]: Deserialize {
    pub fn from_json value:$JsonValue -> std::Result[std::Map[std::String T] Error] {
        if value JsonValue::JsonObject(entries) is then
            std::Map[std::String T]::new = values
            for entry in entries.iter do
                entry.second &T::from_json exec ? entry.first.clone values.set
            done
            values std::Result::Ok
        else
            "object" Error::TypeMismatch std::Result::Error
        fi
    }
}
