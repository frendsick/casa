# Casa compiler
import "lib/std.casa"
import "lib/parser.casa"
import "lib/argparse.casa"
import "lib/log.casa"
import "compiler/common.casa"
import "compiler/error.casa"
import "compiler/lexer.casa"
import "compiler/syntax.casa"
import "compiler/typechecker.casa"
import "compiler/analysis.casa"
import "compiler/bytecode.casa"
import "compiler/emitter.casa"
import "compiler/build.casa"
import "lib/timer.casa"

# ============================================================================
# CLI argument parsing
# ============================================================================
const CASAC_VERSION "1.29.0"

fn parse_cli_args -> ParsedArgs {
    ArgParser::new = parser
    "input file" "input" parser.add_positional
    "output binary name" "--output" "-o" "output" parser.add_option
    "library search path (repeatable)" "--library-path" "-L" "library_path" parser.add_multi_option
    "keep the .s file after linking" "" "--keep-asm" "keep-asm" parser.add_flag
    "run after compiling" "--run" "-r" "run" parser.add_flag
    "print compiler version and exit" "--version" "-v" "version" parser.add_terminal_flag
    "print compiler progress" "--verbose" "" "verbose" parser.add_flag
    parser.parse_args
}

impl CasaWarning {
    fn format self:$CasaWarning -> str {
        self.kind match
            WarningKind::UnusedParameter => f"warning[UNUSED_PARAMETER]: {self.message}"
            WarningKind::LossyTypeAnnotation => f"warning[LOSSY_TYPE_ANNOTATION]: {self.message}"
        end
    }
}

fn report_diagnostics diagnostics:$Diagnostics sources:$SourceStore {
    0 = error_count
    for diagnostic in diagnostics.entries.iter do
        if diagnostic Diagnostic::Error(error) is then
            error sources.format_error eprintln
            "" eprintln
            1 += error_count
        elif diagnostic Diagnostic::Warning(warning) is then
            warning.format eprintln
        fi
    done
    if 0 error_count == then
        return
    fi
    f"Found {error_count} error(s)." eprintln
    1 exit
}

fn main {
    parse_cli_args = args
    if "version" args.get_flag then
        f"casac v{CASAC_VERSION}" print "\n" print
        0 exit
    fi

    "input" args.get = cli_input
    cli_input.unwrap = CLI_INPUT

    # Default output name: strip extension from input
    "output" args.get = cli_output_opt
    cli_output_opt match
        Option::Some(output) => output
        Option::None => {
            CLI_INPUT "." str::find = dot_pos
            if 0 dot_pos <= then
                CLI_INPUT.length
            else
                dot_pos (u64)
            fi
            = output_length
            CLI_INPUT 0 output_length str::substring
        }
    end
    = CLI_OUTPUT

    "keep-asm" args.get_flag = CLI_KEEP_ASM
    "run" args.get_flag = CLI_RUN
    "verbose" args.get_flag = CLI_VERBOSE

    "library_path" args.get_multi = cli_library_paths
    cli_library_paths.unwrap = CLI_LIBRARY_PATHS

    # Configure logging
    if CLI_VERBOSE then
        LogLevel::Info log_set_level
    fi

    Timer::new = timer

    CLI_INPUT.clone file::read_all = read_result
    if read_result Result::Error(read_error) is then
        f"error: cannot read {CLI_INPUT}: {read_error.to_str}" eprintln
        1 exit
    fi
    read_result.unwrap = source
    f"{timer} Analyzing {CLI_INPUT}" log_info
    source CLI_INPUT.clone AnalysisInput::new = analysis_input
    CLI_LIBRARY_PATHS.clone = analysis_input.library_paths
    analysis_input analyze = analysis
    analysis.into_parts = typechecked = sources = diagnostics
    sources diagnostics report_diagnostics
    diagnostics drop
    sources drop
    typechecked.unwrap = typecheck_result

    f"{timer} Compiling bytecode" log_info
    typecheck_result compile_typechecked = program_result
    if program_result Result::Error(failure) is then
        f"internal compiler error[BYTECODE]: {failure.message}" eprintln
        1 exit
    fi
    program_result.unwrap = program

    # Emit assembly
    f"{timer} Emitting assembly" log_info
    program emit = asm_source

    # Compile binary
    f"{timer} Compiling {CLI_OUTPUT}" log_info
    CLI_KEEP_ASM CLI_OUTPUT asm_source compile_binary

    # Optionally run
    if CLI_RUN then
        f"Running {CLI_OUTPUT}" log_info
        List[str]::new = run_args
        f"./{CLI_OUTPUT}" run_args.push
        run_args run_command = run_result
        run_result exit
    fi
}
main
