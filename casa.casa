# Casa compiler
import "lib/std.casa" as std
import "lib/parser.casa" as parser
import "lib/argparse.casa" as argparse
import "lib/log.casa" as log
import "compiler/common.casa" as common
import "compiler/error.casa" as error
import "compiler/lexer.casa" as lexer
import "compiler/syntax.casa" as syntax
import "compiler/typechecker.casa" as typechecker
import "compiler/analysis.casa" as analysis
import "compiler/bytecode.casa" as bytecode
import "compiler/emitter.casa" as emitter
import "compiler/build.casa" as build
import "lib/timer.casa" as timer

# ============================================================================
# CLI argument parsing
# ============================================================================
pub const CASAC_VERSION "1.39.0"

pub fn parse_cli_args -> argparse::ParsedArgs {
    argparse::ArgParser::new = parser
    "input file" "input" parser.add_positional
    "output binary name" "--output" "-o" "output" parser.add_option
    "library search path (repeatable)" "--library-path" "-L" "library_path" parser.add_multi_option
    "native library to link (repeatable)" "--link-library" "-l" "link_library" parser.add_multi_option
    "keep the .s file after linking" "" "--keep-asm" "keep-asm" parser.add_flag
    "run after compiling" "--run" "-r" "run" parser.add_flag
    "print compiler version and exit" "--version" "-v" "version" parser.add_terminal_flag
    "print compiler progress" "--verbose" "" "verbose" parser.add_flag
    parser.parse_args
}

impl error::CasaWarning {
    pub fn format self:$error::CasaWarning -> std::String {
        self.kind match
            common::WarningKind::UnusedParameter => f"warning[UNUSED_PARAMETER]: {self.message}"
            common::WarningKind::LossyTypeAnnotation => f"warning[LOSSY_TYPE_ANNOTATION]: {self.message}"
        end
    }
}

pub fn report_diagnostics diagnostics:$error::Diagnostics sources:$lexer::SourceStore {
    0 = error_count
    for diagnostic in diagnostics.entries.iter do
        if diagnostic error::Diagnostic::Error(error) is then
            error sources.format_error std::eprintln_string
            "" std::eprintln
            1 += error_count
        elif diagnostic error::Diagnostic::Warning(warning) is then
            warning.format std::eprintln_string
        fi
    done
    if 0 error_count == then
        return
    fi
    f"Found {error_count} error(s)." std::eprintln_string
    1 std::exit
}

pub fn main {
    parse_cli_args = args
    if "version" args.get_flag then
        f"casac v{CASAC_VERSION}" print "\n" print
        0 std::exit
    fi

    "input" args.get = cli_input
    cli_input.unwrap = CLI_INPUT

    # Default output name: strip extension from input
    "output" args.get = cli_output_opt
    cli_output_opt match
        std::Option::Some(output) => output
        std::Option::None => {
            CLI_INPUT.as_str "." str::find = dot_pos
            if 0 dot_pos <= then
                CLI_INPUT.length
            else
                dot_pos (u64)
            fi
            = output_length
            CLI_INPUT.as_str 0 output_length str::substring
        }
    end
    = CLI_OUTPUT

    "keep-asm" args.get_flag = CLI_KEEP_ASM
    "run" args.get_flag = CLI_RUN
    "verbose" args.get_flag = CLI_VERBOSE

    "library_path" args.get_multi = cli_library_paths
    cli_library_paths.unwrap = CLI_LIBRARY_PATHS
    "link_library" args.get_multi = cli_link_libraries
    cli_link_libraries.unwrap = CLI_LINK_LIBRARIES

    # Configure logging
    if CLI_VERBOSE then
        log::LogLevel::Info log::log_set_level
    fi

    timer::Timer::new = timer

    CLI_INPUT.as_str file::read_all = read_result
    if read_result std::Result::Error(read_error) is then
        f"error: cannot read {CLI_INPUT}: {read_error.to_str}" std::eprintln_string
        1 std::exit
    fi
    read_result.unwrap.to_str = source_result
    if source_result std::Result::Error(utf8_error) is then
        f"error: cannot read {CLI_INPUT}: invalid UTF-8 at byte {utf8_error.index}" std::eprintln_string
        1 std::exit
    fi
    source_result.unwrap = source
    f"{timer} Analyzing {CLI_INPUT}" log::log_info_string
    source CLI_INPUT.clone analysis::AnalysisInput::new = analysis_input
    CLI_LIBRARY_PATHS = analysis_input.library_paths
    analysis_input analysis::analyze = analysis
    analysis.into_parts = typechecked = sources = diagnostics
    sources diagnostics report_diagnostics
    diagnostics drop
    sources drop
    typechecked.unwrap = typecheck_result

    f"{timer} Compiling bytecode" log::log_info_string
    typecheck_result bytecode::compile_typechecked = program_result
    if program_result std::Result::Error(failure) is then
        f"internal compiler error[BYTECODE]: {failure.message}" std::eprintln_string
        1 std::exit
    fi
    program_result.unwrap = program

    # Emit assembly
    f"{timer} Emitting assembly" log::log_info_string
    program emitter::emit = asm_source

    # Compile binary
    f"{timer} Compiling {CLI_OUTPUT}" log::log_info_string
    CLI_LINK_LIBRARIES CLI_KEEP_ASM CLI_OUTPUT.as_str asm_source.as_str build::compile_binary

    # Optionally run
    if CLI_RUN then
        f"Running {CLI_OUTPUT}" log::log_info_string
        std::List[std::String]::new = run_args
        f"./{CLI_OUTPUT}" run_args.push
        run_args std::run_command = run_result
        run_result std::exit
    fi
}
main
