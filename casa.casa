# Casa compiler
import "lib/std.casa" as std
import "lib/os.casa" as os
import "lib/argparse.casa" as argparse
import "lib/log.casa" as log
import "compiler/common.casa" as common
import "compiler/error.casa" as error
import "compiler/lexer.casa" as lexer
import "compiler/build.casa" as build
import "compiler/products.casa" as products
import "lib/timer.casa" as timer

# CLI argument parsing
pub const CASAC_VERSION "1.39.0"

pub fn parse_cli_args -> argparse::ParsedArgs {
    argparse::ArgParser::new = parser
    "input file" "input" parser.add_positional
    "output binary name" "--output" "-o" "output" parser.add_option
    "library search path (repeatable)" "--library-path" "-L" "library_path" parser.add_multi_option
    "native library to link (repeatable)" "--link-library" "-l" "link_library" parser.add_multi_option
    "keep the .s file after linking" "" "--keep-asm" "keep-asm" parser.add_flag
    "run after compiling" "--run" "-r" "run" parser.add_flag
    "print compiler version and exit" "--version" "" "version" parser.add_terminal_flag
    "print compiler progress" "--verbose" "-v" "verbose" parser.add_flag
    parser.parse_args
}

pub fn report_diagnostics report:$products::Report {
    0 = error_count
    0 = index: u64
    while index report.count_diagnostics < do
        index report.get_presentation = presentation
        presentation report.get_sources.format_diagnostic std::eprintln_string
        if presentation.severity error::DiagnosticSeverity::Error == then
            "" std::eprintln
            1 += error_count
        fi
        1 += index
    done
    if 0 error_count == then
        return
    fi
    f"Found {error_count} error(s)." std::eprintln_string
    1 std::process::exit
}

pub fn main {
    parse_cli_args = args
    if "version" args.get_flag then
        f"casac v{CASAC_VERSION}" print "\n" print
        0 std::process::exit
    fi

    "input" args.get = cli_input
    cli_input.unwrap = CLI_INPUT

    # Default output name: strip extension from input
    "output" args.get = cli_output_opt
    cli_output_opt match
        std::Option::Some(output) => output
        std::Option::None => {
            CLI_INPUT.as_str "." str::find = dot_pos
            if 0 dot_pos >= then
                CLI_INPUT.length
            else
                dot_pos u64::try_from.unwrap
            fi
            = output_length
            CLI_INPUT.as_str 0 output_length str::substring
        }
    end
    = CLI_OUTPUT

    "keep-asm" args.get_flag = CLI_KEEP_ASM
    "run" args.get_flag = CLI_RUN
    "verbose" args.get_flag = CLI_VERBOSE

    "library_path" args.get_multi = cli_library_paths
    cli_library_paths.unwrap = CLI_LIBRARY_PATHS
    "link_library" args.get_multi = cli_link_libraries
    cli_link_libraries.unwrap = CLI_LINK_LIBRARIES

    log::Logger::new = logger
    if CLI_VERBOSE then
        log::LogLevel::Info logger.configure
    fi

    timer::Timer::new = timer
    {
        = stage: str
        timer.to_str = elapsed
        logger f"{elapsed} {stage}" log::log_info_string
    } = log_progress

    f"Reading {CLI_INPUT}".as_str log_progress exec
    CLI_INPUT
        .as_str
        .as_cstr
        .unwrap os::file::read_all = read_result
    if read_result std::Result::Error(read_error) is then
        f"error: cannot read {CLI_INPUT}: {read_error.to_str}" std::eprintln_string
        1 std::process::exit
    fi
    read_result.unwrap.to_str = source_result
    if source_result std::Result::Error(utf8_error) is then
        f"error: cannot read {CLI_INPUT}: invalid UTF-8 at byte {utf8_error.index}" std::eprintln_string
        1 std::process::exit
    fi
    source_result.unwrap = source
    source CLI_INPUT.clone products::SourceUnit
    "" lexer::absolute_normalize_path swap products::CompilationInput::new = input
    CLI_LIBRARY_PATHS = input.library_paths
    log_progress products::Target::LinuxX86_64 input products::assembly_with_progress = result
    if result std::Result::Error(failure) is then
        failure.get_report report_diagnostics
        failure.get_message = message
        f"internal compiler error: {message}" std::eprintln_string
        1 std::process::exit
    fi
    result.unwrap = product
    product.get_report report_diagnostics
    product match
        products::AssemblyResult::Produced(_ emitted) => emitted
        products::AssemblyResult::Rejected(_) => 1 std::process::exit
    end = assembly

    f"Assembling and linking {CLI_OUTPUT}".as_str log_progress exec
    CLI_KEEP_ASM CLI_LINK_LIBRARIES CLI_OUTPUT.as_str assembly
    build::NativeDriver::new.compile_binary = build_result
    if build_result std::Result::Error(failure) is then
        f"error: {failure.to_str}" std::eprintln_string
        1 std::process::exit
    fi
    f"Finished {CLI_OUTPUT}".as_str log_progress exec

    # Optionally run
    if CLI_RUN then
        f"Running {CLI_OUTPUT}".as_str log_progress exec
        std::List[std::Bytes]::new = run_args
        f"./{CLI_OUTPUT}".as_str run_args.push_str
        run_args std::run_command = run_result
        run_result u8::wrapping_from std::process::exit
    fi
}
main
