# Casa compiler
import "lib/std.casa"
import "lib/parser.casa"
import "lib/argparse.casa"
import "lib/log.casa"
import "compiler/common.casa"
import "compiler/error.casa"
import "compiler/lexer.casa"
import "compiler/syntax.casa"
import "compiler/typechecker.casa"
import "compiler/bytecode.casa"
import "compiler/emitter.casa"
import "compiler/build.casa"
import "lib/timer.casa"

# ============================================================================
# CLI argument parsing
# ============================================================================

fn parse_cli_args -> ParsedArgs {
    ArgParser::new = parser
    "input file" "input" parser.add_positional
    "output binary name" "--output" "-o" "output" parser.add_option
    "library search path (repeatable)" "--library-path" "-L" "library_path" parser.add_multi_option
    "keep the .s file after linking" "" "--keep-asm" "keep-asm" parser.add_flag
    "run after compiling" "--run" "-r" "run" parser.add_flag
    "verbose output" "--verbose" "-v" "verbose" parser.add_flag
    parser.parse_args
}

fn exit_on_errors diagnostics:Diagnostics sources:SourceStore {
    global SOURCE_CACHE
    if diagnostics.has_errors ! then return fi
    sources.sources = SOURCE_CACHE
    0 = error_count
    for diagnostic in diagnostics.entries.iter do
        if diagnostic Diagnostic::Error(error) is then
            error format_error eprintln
            "" eprintln
            1 += error_count
        fi
    done
    f"Found {error_count} error(s)." eprintln
    1 exit
}

fn main {
    global SOURCE_CACHE
    parse_cli_args = args

    "input" args.get.unwrap = CLI_INPUT

    # Default output name: strip extension from input
    "output" args.get = cli_output_opt
    if cli_output_opt Option::Some(cli_output_val) is then
        cli_output_val
    else
        CLI_INPUT "." str::find = dot_pos
        if 0 dot_pos <= then
            CLI_INPUT.length = dot_pos
        fi
        CLI_INPUT 0 dot_pos str::substring
    fi
    = CLI_OUTPUT

    "keep-asm" args.get_flag = CLI_KEEP_ASM
    "run" args.get_flag = CLI_RUN
    "verbose" args.get_flag = CLI_VERBOSE

    "library_path" args.get_multi.unwrap = CLI_LIBRARY_PATHS

    # Configure logging
    if CLI_VERBOSE then
        LogLevel::Info log_set_level
    fi

    Timer::new = timer

    SourceStore::new = sources

    # Read and lex
    f"{timer} Lexing {CLI_INPUT}" log_info
    CLI_INPUT file::read_all = read_result
    if read_result Result::Error(read_error) is then
        f"error: cannot read {CLI_INPUT}: {read_error.to_str}" eprintln
        1 exit
    fi
    read_result.unwrap = source
    source CLI_INPUT sources.add
    CLI_INPUT source lex_source = lex_result
    sources lex_result.diagnostics exit_on_errors
    lex_result.tokens = tokens

    # Parse
    f"{timer} Parsing ops" log_info
    sources lex_result.diagnostics CLI_LIBRARY_PATHS tokens parse_and_resolve = parse_result
    sources parse_result.diagnostics exit_on_errors
    sources.sources = SOURCE_CACHE
    parse_result ParseResolveResult::ops.unwrap = ops
    parse_result ParseResolveResult::store = store

    # Type check
    f"{timer} Type checking ops" log_info
    store ops type_check = typecheck_result

    sources typecheck_result.diagnostics exit_on_errors

    # Report warnings
    typecheck_result.diagnostics report_warnings

    f"{timer} Compiling bytecode" log_info
    typecheck_result compile_typechecked = program_result
    if program_result Result::Error(failure) is then
        f"internal compiler error[BYTECODE]: {failure.message}" eprintln
        1 exit
    fi
    program_result.unwrap = program

    # Emit assembly
    f"{timer} Emitting assembly" log_info
    program emit = asm_source

    # Compile binary
    f"{timer} Compiling {CLI_OUTPUT}" log_info
    CLI_KEEP_ASM CLI_OUTPUT asm_source compile_binary

    # Optionally run
    if CLI_RUN then
        f"Running {CLI_OUTPUT}" log_info
        List::new(List[str]) = run_args
        f"./{CLI_OUTPUT}" run_args.push
        run_args run_command = run_result
        run_result exit
    fi
}
main
